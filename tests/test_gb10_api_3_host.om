note SPDX-License-Identifier: Apache-2.0
note tests/test_gb10_api_3_host.om: CPU-only host unit, contract, codegen, and QMD1
note validation test for wave gb10-api-3 (zero /dev/nvidia* access):
note   omega_gpu_router_api, omega_gpu_tcgemm_api, omega_gpu_tern_api,
note   omega_gpu_tgemm_api, omega_gpu_gemm, omega_gpu_pfgemm.
om2

text t3_pass "PASS test-gb10-api-3-host (router + tcgemm + tern + tgemm + gemm + pfgemm + QMD1 zero-CUDA)\n"
text t3_fail "FAIL test-gb10-api-3-host code="
text t3_nl "\n"

fn t3_print s view uchar * to void
  r = write 1 s 0 len s
end

fn t3_print_u x ulong to void
  b = new uchar 24 0
  pos = ulong 24
  v = x
  while true
    pos = sub pos 1
    put b pos uchar add 48 rem v 10
    v = div v 10
    if eq v 0
      r = write 1 b pos sub 24 pos
      ret
    end
  end
end

fn t3_check_qmd launch view ulong 12 to long
  cfg = new ulong 16 0
  put cfg 0 get launch 0
  put cfg 1 ulong 0x70000000
  put cfg 2 ulong 0x71000000
  put cfg 3 ulong 0x72000000
  put cfg 4 ulong 0x73000000
  put cfg 5 get launch 6
  put cfg 6 get launch 2
  put cfg 7 get launch 4
  put cfg 8 get launch 2
  put cfg 9 get launch 3
  put cfg 10 get launch 4
  put cfg 11 get launch 5
  put cfg 12 get launch 1
  put cfg 13 get launch 9
  qmd1 = new uint 96 0
  if ne omega_blackwell_build_qmd1 qmd1 cfg 0
    ret -1
  end
  if ne omega_blackwell_verify_qmd_invariants qmd1 0
    ret -2
  end
  note Negative control: corrupt QMD1 version field (word 14) must fail invariants
  put qmd1 14 0
  if eq omega_blackwell_verify_qmd_invariants qmd1 0
    ret -3
  end
  ret 0
end

fn test_router_record rh ulong to ulong
  sc = new uint 3 0
  put sc 0 0x358637bd
  put sc 1 0x5f800000
  put sc 2 1
  launch = new ulong 12 0
  args = new uint 23 0
  dev_out = new ulong 5 0
  h4 = new ulong 4 0
  put h4 0 0
  put h4 1 rh
  put h4 2 0
  put h4 3 0x10000
  if ne omega_gpu_router_record h4 sc dev_out launch args OMEGA_GPU_ROUTER_BAD_ARGS
    ret 122
  end
  put h4 0 1
  if ne omega_gpu_router_record h4 sc dev_out launch args OMEGA_GPU_ROUTER_OK
    ret 123
  end
  h5 = new ulong 5 0
  put h5 0 1
  put h5 1 rh
  put h5 2 0
  put h5 3 0x10000
  put h5 4 0x20001
  if ne omega_gpu_router_record_to h5 sc dev_out launch args OMEGA_GPU_ROUTER_BAD_ARGS
    ret 124
  end
  put h5 4 0x20000
  if ne omega_gpu_router_record_to h5 sc dev_out launch args OMEGA_GPU_ROUTER_OK
    ret 125
  end
  if ne get dev_out 0 add ulong 0x20000 RT_LB_XOUT
    ret 126
  end
  ret 0
end

fn test_router_rows rh ulong to ulong
  if ne omega_gpu_router_prepare_rows rh 8192 16896 OMEGA_GPU_ROUTER_OK
    ret 127
  end
  sc = new uint 3 0
  put sc 0 0x358637bd
  put sc 1 0x5f800000
  put sc 2 1
  launch = new ulong 12 0
  args = new uint 23 0
  dev_out = new ulong 5 0
  h8 = new ulong 8 0
  put h8 0 1
  put h8 1 rh
  put h8 2 0
  put h8 3 0x10000
  put h8 4 0x20000
  put h8 5 8192
  put h8 6 16896
  put h8 7 4
  if ne omega_gpu_router_record_rows h8 sc dev_out launch args OMEGA_GPU_ROUTER_OK
    ret 128
  end
  if ne get launch 5 4
    ret 129
  end
  if ne t3_check_qmd launch 0
    ret 130
  end
  put h8 5 8208
  if ne omega_gpu_router_record_rows h8 sc dev_out launch args OMEGA_GPU_ROUTER_TOO_LARGE
    ret 131
  end
  ebuf = new uchar 96 0
  if eq omega_gpu_router_last_error ebuf 0
    ret 132
  end
  ret 0
end

fn test_router_api to ulong
  nbuf = new uchar 32 0
  h = new ulong 1 0
  dvas = new ulong 3 0
  launch = new ulong 12 0
  args = new uint 23 0
  sc = new uint 3 0
  if ne omega_gpu_router_rc_name OMEGA_GPU_ROUTER_OK nbuf 2
    ret 100
  end
  if ne omega_gpu_router_rc_name OMEGA_GPU_ROUTER_CHIP_FAIL nbuf 9
    ret 101
  end
  if ne omega_gpu_router_alloc 0 h OMEGA_GPU_ROUTER_BAD_ARGS
    ret 102
  end
  if ne omega_gpu_router_alloc 65 h OMEGA_GPU_ROUTER_BAD_ARGS
    ret 103
  end
  if ne omega_gpu_router_alloc_shape 2 64 0 h OMEGA_GPU_ROUTER_BAD_ARGS
    ret 104
  end
  if ne omega_gpu_router_alloc_shape 2 128 2 h OMEGA_GPU_ROUTER_BAD_ARGS
    ret 105
  end
  if ne omega_gpu_router_alloc 2 h OMEGA_GPU_ROUTER_OK
    ret 106
  end
  rh = get h 0
  if ne omega_gpu_router_layout_bytes rh RT_LB_BYTES
    ret 107
  end
  if ne omega_gpu_router_set_layer rh 0 262144 2048 OMEGA_GPU_ROUTER_OK
    ret 108
  end
  if ne omega_gpu_router_set_layer rh 2 262144 2048 OMEGA_GPU_ROUTER_BAD_ARGS
    ret 109
  end
  if ne omega_gpu_router_set_directory rh 0 256 256 OMEGA_GPU_ROUTER_OK
    ret 110
  end
  if ne omega_gpu_router_set_directory_fp8 rh 1 128 128 OMEGA_GPU_ROUTER_OK
    ret 111
  end
  if ne omega_gpu_router_set_directory_fp8 rh 1 64 128 OMEGA_GPU_ROUTER_BAD_ARGS
    ret 112
  end
  omega_gpu_router_device_outputs rh dvas
  if eq get dvas 0 0
    ret 113
  end
  if ne omega_gpu_router_read_back rh dvas OMEGA_GPU_ROUTER_OK
    ret 114
  end
  put sc 0 0x358637bd
  put sc 1 0x5f800000
  put sc 2 1
  omega_gpu_router_set_shape 32 4
  omega_gpu_router_test_set_mutant 0
  if ne omega_gpu_router rh 0 sc launch args OMEGA_GPU_ROUTER_OK
    ret 115
  end
  if ne get launch 2 1024
    ret 116
  end
  if ne get launch 4 1
    ret 117
  end
  if ne get launch 5 1
    ret 118
  end
  if ne get launch 9 8912
    ret 119
  end
  if ne get args 22 1
    ret 120
  end
  if ne t3_check_qmd launch 0
    ret 121
  end
  rc = test_router_record rh
  if ne rc 0
    ret rc
  end
  rc = test_router_rows rh
  omega_gpu_router_free rh
  ret rc
end

fn test_tcgemm_api to ulong
  nbuf = new uchar 32 0
  if ne omega_gpu_tcgemm_rc_name OMEGA_GPU_TCGEMM_OK nbuf 2
    ret 200
  end
  omega_gpu_tcgemm_cache_clear
  omega_gpu_tcgemm_set_shape 0 0 0
  omega_gpu_tcgemm_test_set_mutant 0
  sp = new ulong 8 0
  omega_gpu_tcgemm_spec_for 512 256 sp
  if ne get sp 1 4
    ret 201
  end
  if ne get sp 2 2
    ret 202
  end
  if ne get sp 3 8
    ret 203
  end
  if ne omega_gpu_tcgemm_prepare 512 OMEGA_GPU_TCGEMM_OK
    ret 204
  end
  dims = new ulong 5 0
  put dims 0 4
  put dims 1 256
  put dims 2 512
  put dims 3 6
  put dims 4 4
  ids = new uint 64 0
  put ids 0 0
  put ids 1 0
  put ids 2 1
  put ids 3 1
  put ids 4 3
  put ids 5 3
  trow = new uint 64 0
  put trow 0 0
  put trow 1 1
  put trow 2 2
  put trow 3 3
  put trow 4 0
  put trow 5 2
  out_meta = new ulong 24 0
  args = new uint 9 0
  if ne omega_gpu_tcgemm_f32 dims ids trow out_meta args OMEGA_GPU_TCGEMM_OK
    ret 205
  end
  note 3 distinct experts, 1 tile each -> 3 tiles, grid_x = 256/128 = 2, cache hit = 1 (prepared!)
  if ne get out_meta 1 3
    ret 206
  end
  if ne get out_meta 2 3
    ret 207
  end
  if ne get out_meta 8 2
    ret 208
  end
  if ne get out_meta 11 1
    ret 209
  end
  if ne get args 8 256
    ret 210
  end
  launch = new ulong 12 0
  for i ulong 12
    put launch i get out_meta add 12 i
  end
  if ne t3_check_qmd launch 0
    ret 211
  end
  note Negative control: unsorted expert ids must fail BAD_ARGS
  put ids 4 0
  if ne omega_gpu_tcgemm_f32 dims ids trow out_meta args OMEGA_GPU_TCGEMM_BAD_ARGS
    ret 212
  end
  put ids 4 3
  note Negative control: trow >= x_rows must fail BAD_ARGS
  put trow 5 4
  if ne omega_gpu_tcgemm_f32 dims ids trow out_meta args OMEGA_GPU_TCGEMM_BAD_ARGS
    ret 213
  end
  ebuf = new uchar 96 0
  ign_e = omega_gpu_tcgemm_last_error ebuf
  ret 0
end

fn test_tern_gemv_run h ulong to ulong
  ts = new ulong 2 0
  info = new ulong 12 0
  launch = new ulong 12 0
  args = new uint 16 0
  tvas = new ulong 3 0
  omega_gpu_tern_tensor_shape h ts
  if ne get ts 0 8
    ret 317
  end
  if ne omega_gpu_tern_tensor_bytes h 512
    ret 318
  end
  if ne omega_gpu_tern_gemv_i32 h info launch args OMEGA_GPU_TERN_OK
    ret 319
  end
  if ne get args 12 sub uint 0 uint 8
    ret 320
  end
  if ne t3_check_qmd launch 0
    ret 321
  end
  if ne omega_gpu_tern_gemv_f32 h 0x7fc00000 info launch args OMEGA_GPU_TERN_BAD_ARGS
    ret 322
  end
  if ne omega_gpu_tern_gemv_f32 h 0x3f800000 info launch args OMEGA_GPU_TERN_OK
    ret 323
  end
  if ne t3_check_qmd launch 0
    ret 324
  end
  put tvas 0 0x10000
  put tvas 1 0x20000
  put tvas 2 0
  if ne omega_gpu_tern_gemv_record 0 h tvas launch args OMEGA_GPU_TERN_BAD_ARGS
    ret 325
  end
  put tvas 0 0x10001
  if ne omega_gpu_tern_gemv_record 1 h tvas launch args OMEGA_GPU_TERN_BAD_ARGS
    ret 326
  end
  put tvas 0 0x10000
  put tvas 2 0x30000
  if ne omega_gpu_tern_gemv_record 1 h tvas launch args OMEGA_GPU_TERN_OK
    ret 327
  end
  ret 0
end

fn test_tern_pack_and_seg to ulong
  w = new byte 2048 0
  pout = new uint 256 0
  pcfg = new ulong 5 0
  seg = new ulong 9 0
  bnds = new uint 3 0
  th = new ulong 1 0
  put w 0 1
  put w 1 -1
  put w 2 0
  put pcfg 0 8
  put pcfg 1 256
  put pcfg 2 OMEGA_TERN_LAYOUT_ROWMAJOR
  put pcfg 3 4
  put pcfg 4 8
  if ne omega_gpu_tern_pack pcfg w pout OMEGA_GPU_TERN_OK
    ret 308
  end
  if ne get pout 0 9
    ret 309
  end
  put w 3 2
  if ne omega_gpu_tern_pack pcfg w pout OMEGA_GPU_TERN_BAD_TRIT
    ret 310
  end
  put w 3 0
  put seg 0 2
  put seg 1 3
  put seg 2 8
  put seg 5 0x3f800000
  put seg 6 0x40000000
  if ne omega_gpu_tern_segment_bounds 8 seg 0 bnds OMEGA_GPU_TERN_OK
    ret 311
  end
  if ne get bnds 0 3
    ret 312
  end
  if ne get bnds 1 8
    ret 313
  end
  if ne omega_gpu_tern_segment_bounds 8 seg 2 bnds OMEGA_GPU_TERN_OK
    ret 314
  end
  if ne get bnds 0 4
    ret 315
  end
  if ne omega_gpu_tern_tensor_upload 8 256 w seg th OMEGA_GPU_TERN_OK
    ret 316
  end
  rc = test_tern_gemv_run get th 0
  omega_gpu_tern_tensor_free get th 0
  ret rc
end

fn test_tern_api to ulong
  nbuf = new uchar 32 0
  sh = new ulong 4 0
  sp = new ulong 8 0
  decl = new ulong 1 0
  if ne omega_gpu_tern_rc_name OMEGA_GPU_TERN_BAD_TRIT nbuf 8
    ret 300
  end
  omega_gpu_tern_cache_clear
  omega_gpu_tern_set_layout OMEGA_TERN_LAYOUT_ROWMAJOR 0
  omega_gpu_tern_set_shape 0 0 0
  omega_gpu_tern_set_cta_budget 0
  omega_gpu_tern_set_weight_cache 1
  omega_gpu_tern_test_set_mutant 0
  if ne omega_gpu_tern_padded_rows 1 8
    ret 301
  end
  if ne omega_gpu_tern_padded_rows 9 16
    ret 302
  end
  omega_gpu_tern_shape_for 512 OMEGA_TERN_LAYOUT_ROWMAJOR 4 sh
  if ne get sh 0 1
    ret 303
  end
  if ne get sh 1 8
    ret 304
  end
  if ne get sh 3 160
    ret 305
  end
  put sp 0 512
  put sp 1 OMEGA_TERN_LAYOUT_ROWMAJOR
  put sp 2 get sh 0
  put sp 3 get sh 1
  put sp 4 get sh 2
  put sp 5 OMEGA_TERN_EPI_I32
  put sp 6 0
  if ne omega_gpu_tern_kernel_fits sp decl OMEGA_GPU_TERN_OK
    ret 306
  end
  if eq get decl 0 0
    ret 307
  end
  ign_e = omega_gpu_tern_last_error nbuf
  ret test_tern_pack_and_seg
end

fn test_tgemm_api to ulong
  omega_gpu_tgemm_set_shape 0 0 0
  omega_gpu_tgemm_test_set_mutant 0
  if ne omega_gpu_tgemm_bm 256 128
    ret 400
  end
  if ne omega_gpu_tgemm_bm 128 64
    ret 401
  end
  call = new ulong 8 0
  put call 0 0
  put call 1 0
  put call 2 256
  put call 3 256
  put call 4 256
  put call 5 0x100000
  put call 6 0x200000
  put call 7 0x300000
  sp = new ulong 10 0
  if ne omega_gpu_tgemm_spec call sp TG_PF_OK
    ret 402
  end
  tab = new ulong 16 0
  nt = omega_gpu_tgemm_tiles call tab 4
  if ne nt 2
    ret 403
  end
  if ne get tab 1 0
    ret 404
  end
  if ne get tab 5 128
    ret 405
  end
  if ne get tab 3 2
    ret 406
  end
  launch = new ulong 12 0
  args = new uint 6 0
  if ne omega_gpu_tgemm call launch args TG_PF_OK
    ret 407
  end
  if ne get launch 2 512
    ret 408
  end
  if ne get launch 4 1
    ret 409
  end
  if ne get launch 5 2
    ret 410
  end
  if ne t3_check_qmd launch 0
    ret 411
  end
  note Negative controls: m not multiple of bm, zero a_va, zero tiles_va
  put call 2 100
  if ne omega_gpu_tgemm_spec call sp TG_PF_BAD_ARGS
    ret 412
  end
  put call 2 256
  if ne omega_gpu_tgemm_fill_launch_locked call 0 2 launch args TG_PF_BAD_ARGS
    ret 413
  end
  ret 0
end

fn test_gemm_api to ulong
  nbuf = new uchar 32 0
  if ne omega_gpu_gemm_rc_name OMEGA_GPU_GEMM_OK nbuf 2
    ret 500
  end
  cfg = new ulong 7 0
  omega_gpu_gemm_default_cfg OMEGA_GPU_GEMM_BF16 cfg
  if eq omega_gpu_gemm_cfg_ok cfg 0
    ret 501
  end
  if ne omega_gpu_gemm_test_set_cfg OMEGA_GPU_GEMM_BF16 1 cfg OMEGA_GPU_GEMM_OK
    ret 502
  end
  note Negative control: mismatched type in test_set_cfg must fail BAD_ARGS
  if ne omega_gpu_gemm_test_set_cfg OMEGA_GPU_GEMM_E4M3 1 cfg OMEGA_GPU_GEMM_BAD_ARGS
    ret 503
  end
  note Plan + codegen + drive + full omega_gpu_gemm
  plan = new ulong 18 0
  if ne omega_gpu_gemm_plan cfg 37 53 41 plan OMEGA_GPU_GEMM_OK
    ret 504
  end
  if eq get plan 3 0
    ret 505
  end
  note Negative control: dim > 16384 must fail TOO_LARGE
  if ne omega_gpu_gemm_plan cfg 16385 32 32 plan OMEGA_GPU_GEMM_TOO_LARGE
    ret 506
  end
  dims = new ulong 3 0
  put dims 0 37
  put dims 1 53
  put dims 2 41
  launches = new ulong 36 0
  all_args = new uint 27 0
  if ne omega_gpu_gemm OMEGA_GPU_GEMM_BF16 3 dims launches all_args OMEGA_GPU_GEMM_OK
    ret 507
  end
  note Layout 3 = A_COL | B_COL: PACK_A row_stride=1, k_stride=M(37); PACK_B row_stride=K(41), k_stride=1
  if ne get all_args 6 1
    ret 508
  end
  if ne get all_args 7 37
    ret 509
  end
  if ne get all_args 15 41
    ret 510
  end
  if ne get all_args 16 1
    ret 511
  end
  note Verify QMD1 for MAIN kernel (offset 24)
  ml = new ulong 12 0
  for i ulong 12
    put ml i get launches add 24 i
  end
  if ne t3_check_qmd ml 0
    ret 512
  end
  note Negative control: invalid layout bit 4 must fail BAD_ARGS
  if ne omega_gpu_gemm OMEGA_GPU_GEMM_BF16 4 dims launches all_args OMEGA_GPU_GEMM_BAD_ARGS
    ret 513
  end
  ret 0
end

fn test_pfgemm_host_form to ulong
  w_in = new uchar 32768 0
  sinv = new ushort 4096 0x3f80
  pw = new uchar 32768 0
  ratio = new f32 4096 0.0
  hf_d = new ulong 4 0
  for i ulong 256
    put w_in mul i 128 uchar rem i 251
  end
  put hf_d 0 1
  put hf_d 1 256
  put hf_d 2 128
  put hf_d 3 OMEGA_GPU_PF_SWIGLU
  if ne omega_gpu_pf_weights_host_form hf_d w_in sinv pw ratio PF_OK
    ret 601
  end
  put hf_d 1 128
  if ne omega_gpu_pf_weights_host_form hf_d w_in sinv pw ratio PF_BAD_ARGS
    ret 602
  end
  ret 0
end

fn test_pfgemm_tc2_and_pq to ulong
  wh_arr = new ulong 1 0
  cnts = new uint 256 0
  tab = new ulong 256 0
  vas4 = new ulong 4 0
  launch = new ulong 12 0
  args9 = new uint 9 0
  if ne omega_gpu_pf_weights_upload 2 256 256 OMEGA_GPU_PF_PLAIN wh_arr PF_OK
    ret 603
  end
  wh = get wh_arr 0
  put cnts 0 130
  put cnts 1 64
  nt = omega_gpu_pf_gemm_tiles wh cnts tab 4
  if ne nt 3
    ret 604
  end
  if ne get tab 3 128
    ret 605
  end
  if ne get tab 7 2
    ret 606
  end
  put vas4 0 0x100000
  put vas4 1 0
  put vas4 2 0x200000
  put vas4 3 0x300000
  if ne omega_gpu_pf_gemm wh nt vas4 launch args9 PF_OK
    ret 607
  end
  if ne get args9 8 256
    ret 608
  end
  if ne t3_check_qmd launch 0
    ret 609
  end
  omega_gpu_pf_weights_free wh
  ret 0
end

fn test_pfgemm_pq_run to ulong
  vas3 = new ulong 3 0
  launch = new ulong 12 0
  args6 = new uint 6 0
  pcfg = new ulong 3 0
  omega_gpu_pf_quant_test_set_mutant 0
  put vas3 0 0x100000
  put vas3 1 0x200000
  put vas3 2 0x300000
  if ne omega_gpu_pf_quant 512 0 16 vas3 launch args6 PF_OK
    ret 610
  end
  if ne get launch 4 16
    ret 611
  end
  if ne t3_check_qmd launch 0
    ret 612
  end
  put pcfg 0 512
  put pcfg 1 0
  put pcfg 2 16
  if ne omega_gpu_pf_quant_record 0 pcfg vas3 launch args6 PF_BAD_ARGS
    ret 613
  end
  if ne omega_gpu_pf_quant_record 1 pcfg vas3 launch args6 PF_OK
    ret 614
  end
  ret 0
end

fn test_pfgemm_qg_tiles to ulong
  wvas = new ulong 256 0
  svas = new ulong 256 0
  qcnts = new uint 256 0

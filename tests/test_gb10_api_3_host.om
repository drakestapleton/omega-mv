  put qcfg 2 OMEGA_GPU_PF_SWIGLU_NAT
  if ne omega_gpu_pf_qgemm_record 1 qcfg vas5 launch args11 PF_OK
    ret 621
  end
  if ne t3_check_qmd launch 0
    ret 622
  end
  put qcfg 2 OMEGA_GPU_PF_SWIGLU
  if ne omega_gpu_pf_qgemm qcfg vas5 launch args11 PF_BAD_ARGS
    ret 623
  end
  ret 0
end

fn test_pfgemm_api to ulong
  omega_gpu_pf_gemm_set_shape 0 0 0
  omega_gpu_pf_gemm_test_set_mutant 0
  if ne omega_gpu_pf_gemm_bm 128
    ret 600
  end
  rc = test_pfgemm_host_form
  if ne rc 0
    ret rc
  end
  rc = test_pfgemm_tc2_and_pq
  if ne rc 0
    ret rc
  end
  rc = test_pfgemm_pq_run
  if ne rc 0
    ret rc
  end
  rc = test_pfgemm_qg_tiles
  if ne rc 0
    ret rc
  end
  ret test_pfgemm_qg_run
end

fn main to int
  rc = test_router_api
  if ne rc 0
    t3_print t3_fail
    t3_print_u rc
    t3_print t3_nl
    ret 1
  end
  rc = test_tcgemm_api
  if ne rc 0
    t3_print t3_fail
    t3_print_u rc
    t3_print t3_nl
    ret 1
  end
  rc = test_tern_api
  if ne rc 0
    t3_print t3_fail
    t3_print_u rc
    t3_print t3_nl
    ret 1
  end
  rc = test_tgemm_api
  if ne rc 0
    t3_print t3_fail
    t3_print_u rc
    t3_print t3_nl
    ret 1
  end
  rc = test_gemm_api
  if ne rc 0
    t3_print t3_fail
    t3_print_u rc
    t3_print t3_nl
    ret 1
  end
  rc = test_pfgemm_api
  if ne rc 0
    t3_print t3_fail
    t3_print_u rc
    t3_print t3_nl
    ret 1
  end
  t3_print t3_pass
  ret 0
end

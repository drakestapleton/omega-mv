fn test_pfgemm_qg_run to ulong
  vas5 = new ulong 5 0
  launch = new ulong 12 0
  args11 = new uint 11 0
  qcfg = new ulong 4 0
  put vas5 0 0x100000
  put vas5 1 0
  put vas5 2 0x200000
  put vas5 3 0x300000
  put vas5 4 0x400000
  put qcfg 0 256
  put qcfg 1 256
  put qcfg 2 OMEGA_GPU_PF_PLAIN
  put qcfg 3 4
  if ne omega_gpu_pf_qgemm qcfg vas5 launch args11 PF_OK

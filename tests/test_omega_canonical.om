note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit test for src/omega_canonical.om.
om2

text can_gold_id "2825cb41f16ac87c51c46f317adf6d4fe288063e2270e30e9dc87d16fd27dd6d"
text can_k_zebra "zebra"
text can_k_alpha "alpha"
text msg_pass "OMEGA_CANONICAL_OM_PASS\n"
text msg_fail "OMEGA_CANONICAL_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex32 dig view uchar * gold view uchar * to void
  for i ulong 32
    b = uint get dig i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn set_attr_key slot ulong s view uchar * to void
  base = mul slot CAN_MAX_KEY_LEN
  for i ulong CAN_MAX_KEY_LEN
    put g_can_attr_keys add base i 0
  end
  for i ulong len s bound 63
    put g_can_attr_keys add base i get s i
  end
end

fn test_canonical to void
  note Object versions and header checks
  chk eq omega_canonical_object_version 2 1
  chk eq omega_canonical_object_version 8 2
  chk eq omega_canonical_check_header 1 2 0
  chk eq omega_canonical_check_header 2 8 0
  chk eq omega_canonical_check_header 1 8 -2
  chk eq omega_canonical_check_header 3 2 -1

  note Populate OmegaObject matching C oracle (unsorted attrs, rels, consts)
  put g_can_kind 0 2
  put g_can_has_id 0 0
  put g_can_attr_n 0 2
  set_attr_key 0 can_k_zebra
  put g_can_attr_vlen 0 2
  put g_can_attr_vals 0 uchar 0xaa
  put g_can_attr_vals 1 uchar 0xbb
  set_attr_key 1 can_k_alpha
  put g_can_attr_vlen 1 1
  put g_can_attr_vals CAN_MAX_VAL_LEN uchar 0x55

  put g_can_rel_n 0 2
  put g_can_rel_kinds 0 ushort 2
  put g_can_rel_kinds 1 ushort 1
  for i ulong 32
    put g_can_rel_tgts i uchar 0x22
    put g_can_rel_tgts add 32 i uchar 0x11
  end

  put g_can_const_n 0 2
  put g_can_const_meta 0 ushort 3
  put g_can_const_meta 1 ushort 2
  put g_can_const_pays 0 uchar 0x09
  put g_can_const_pays 1 uchar 0x08
  put g_can_const_meta 2 ushort 3
  put g_can_const_meta 3 ushort 1
  put g_can_const_pays CAN_MAX_CONST_PAY uchar 0x07

  put g_can_pay_len 0 4
  put g_can_pay 0 1
  put g_can_pay 1 2
  put g_can_pay 2 3
  put g_can_pay 3 4

  cbuf = new uchar 512 0
  clen = omega_canonical_encode cbuf 512
  chk eq clen 118
  chk eq omega_compute_semantic_id 0
  chk eq get g_can_has_id 0 1

  id1 = new uchar 32 0
  for i ulong 32
    put id1 i get g_can_id i
  end
  chk_hex32 id1 can_gold_id

  note Hex format + parse round-trip + compare_semantic_id
  hx = new uchar 65 0
  omega_hex_semantic_id id1 hx
  chk eq get hx 64 0
  id2 = new uchar 32 0
  chk eq omega_parse_hex_semantic_id hx 64 id2 0
  chk eq omega_compare_semantic_id id1 id2 0
  put id2 31 uchar xor ulong get id2 31 1
  chk ne omega_compare_semantic_id id1 id2 0
  chk eq omega_parse_hex_semantic_id hx 63 id2 -1
end

fn main to int
  test_canonical
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

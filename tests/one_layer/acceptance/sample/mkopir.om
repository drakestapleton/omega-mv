om2
note SPDX-License-Identifier: Apache-2.0
note Copyright 2026 Drake Stapleton (AIEN / aien-dev)
note
note tests/one_layer/acceptance/sample/mkopir.om -- pure seeded OM-2 port of
note tests/one_layer/acceptance/sample/mkopir.c.
note Composes on seed/ng/sha256.om and src/omega_program_ir.om.
note   mkopir <out.opir> <width> <op> <imm> [<op> <imm>]...   op: add sub mul and or
note Prints "program_id=<hex>".

text t_mk_use "usage: mkopir out width op imm [op imm]...\n"
text t_mk_add "add"
text t_mk_sub "sub"
text t_mk_mul "mul"
text t_mk_and "and"
text t_mk_or "or"
text t_mk_pre "x >= 0"
text t_mk_pid "program_id="

global g_mk_arg uchar 512
global g_mk_path uchar 512
global g_mk_plen ulong 1
global g_mk_post uchar 64
global g_mk_out uchar 96

fn mk_arg_eq n ulong lit view uchar * to bool
  if ne n len lit
    ret false
  end
  i = ulong 0
  while lt i n bound 64
    if ne get g_mk_arg i get lit i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn mk_parse_op idx ulong to ulong
  al = argread idx g_mk_arg ulong 0 ulong 64
  if le al long 0
    ret 0
  end
  n = ulong al
  if mk_arg_eq n t_mk_add
    ret OMEGA_OP_ADD
  end
  if mk_arg_eq n t_mk_sub
    ret OMEGA_OP_SUB
  end
  if mk_arg_eq n t_mk_mul
    ret OMEGA_OP_MUL
  end
  if mk_arg_eq n t_mk_and
    ret OMEGA_OP_AND
  end
  if mk_arg_eq n t_mk_or
    ret OMEGA_OP_OR
  end
  ret 0
end

fn mk_hex_dig c uchar to long
  if ge c 48
    if le c 57
      ret long sub c 48
    end
  end
  if ge c 97
    if le c 102
      ret long sub c 87
    end
  end
  if ge c 65
    if le c 70
      ret long sub c 55
    end
  end
  ret -1
end

fn mk_is_hex n ulong to bool
  if lt n 2
    ret false
  end
  if ne get g_mk_arg 0 48
    ret false
  end
  c1 = get g_mk_arg 1
  if eq c1 120
    ret true
  end
  ret eq c1 88
end

note Parse decimal or 0x/0X hex unsigned integer (matches C strtoull base 0).
fn mk_parse_u64 idx ulong to ulong
  al = argread idx g_mk_arg ulong 0 ulong 64
  if le al long 0
    ret 0
  end
  n = ulong al
  if mk_is_hex n
    p = ulong 2
    acc = ulong 0
    while lt p n bound 64
      d = mk_hex_dig get g_mk_arg p
      if lt d 0
        break
      end
      acc = add mul acc 16 ulong d
      p = add p 1
    end
    ret acc
  end
  p = ulong 0
  acc = ulong 0
  while lt p n bound 64
    c = get g_mk_arg p
    if lt c 48
      break
    end
    if gt c 57
      break
    end
    acc = add mul acc 10 ulong sub c 48
    p = add p 1
  end
  ret acc
end

fn mk_op_sym op ulong to uchar
  if eq op OMEGA_OP_ADD
    ret 43
  end
  if eq op OMEGA_OP_SUB
    ret 45
  end
  if eq op OMEGA_OP_MUL
    ret 42
  end
  if eq op OMEGA_OP_AND
    ret 38
  end
  ret 124
end

fn mk_fmt_post op ulong imm ulong to ulong
  put g_mk_post 0 uchar 120
  put g_mk_post 1 uchar 32
  put g_mk_post 2 mk_op_sym op
  put g_mk_post 3 uchar 32
  p = ulong 4
  if eq imm 0
    put g_mk_post p uchar 48
    ret add p 1
  end
  tmp = new uchar 24 0
  k = ulong 0
  v = imm
  while gt v 0 bound 24
    put tmp k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0 bound 24
    k = sub k 1
    put g_mk_post p get tmp k
    p = add p 1
  end
  ret p
end

fn mk_hex_nib v ulong to uchar
  if lt v 10
    ret uchar add v 48
  end
  ret uchar add v 87
end

fn mk_write_out to bool
  fd = fopen g_mk_path ulong 0 get g_mk_plen 0 577 420
  if lt fd long 0
    ret false
  end
  n = get gp_ir_len 0
  off = ulong 0
  while lt off n bound 1024
    w = write int fd gp_ir_buf off sub n off
    if le w long 0
      ig = fclose int fd
      ret false
    end
    off = add off ulong w
  end
  ig2 = fclose int fd
  ret eq ig2 long 0
end

fn mk_print_pid to void
  p = ulong 0
  for i ulong 11
    put g_mk_out p get t_mk_pid i
    p = add p 1
  end
  for i ulong 32
    b = ulong get gp_id i
    put g_mk_out p mk_hex_nib shr b 4
    p = add p 1
    put g_mk_out p mk_hex_nib and b 15
    p = add p 1
  end
  put g_mk_out p uchar 10
  p = add p 1
  ign = write 1 g_mk_out ulong 0 p
end

fn mk_set_constraints op0 ulong imm0 ulong to void
  pir_build_constraint_id OMEGA_CONST_PRE t_mk_pre len t_mk_pre
  for i ulong 32
    put gp_preid i get sh_dig i
  end
  plen = mk_fmt_post op0 imm0
  post_s = new uchar 64 0
  for i ulong plen bound 64
    put post_s i get g_mk_post i
  end
  pir_build_constraint_id OMEGA_CONST_POST part post_s ulong 0 plen plen
  for i ulong 32
    put gp_postid i get sh_dig i
  end
end

fn mk_load_steps uac ulong to int
  sc = ulong 1
  ai = ulong 5
  while lt add ai 1 uac bound 64
    opi = mk_parse_op ai
    if or eq opi 0 ge sc PIR_MAX_STEPS
      ret 1
    end
    put gp_sop sc opi
    put gp_simm sc mk_parse_u64 add ai 1
    sc = add sc 1
    ai = add ai 2
  end
  put gp_scnt 0 sc
  ret 0
end

fn main to int
  ac = argcnt
  if or lt ac long 5 ne rem sub ulong ac 3 2 0
    ign = write 2 t_mk_use ulong 0 len t_mk_use
    ret 2
  end
  pl = argread ulong 1 g_mk_path ulong 0 ulong 512
  if le pl long 0
    ret 1
  end
  put g_mk_plen 0 ulong pl
  w = mk_parse_u64 2
  op0 = mk_parse_op 3
  imm0 = mk_parse_u64 4
  if or eq op0 0 gt imm0 ulong 4294967295
    ret 1
  end
  pir_slot_init 0
  put gp_intype 0 OMEGA_TYPE_UINT
  put gp_inw 0 w
  put gp_outtype 0 OMEGA_TYPE_UINT
  put gp_outw 0 w
  mk_set_constraints op0 imm0
  put gp_has 0 1
  put gp_sop 0 op0
  put gp_simm 0 imm0
  if ne mk_load_steps ulong ac 0
    ret 1
  end
  if ne pir_compute_id 0 0
    ret 1
  end
  if ne omega_program_ir_encode 0 0
    ret 1
  end
  if not mk_write_out
    ret 1
  end
  mk_print_pid
  ret 0
end

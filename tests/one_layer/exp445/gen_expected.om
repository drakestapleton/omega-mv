om2
note SPDX-License-Identifier: Apache-2.0
note Copyright 2026 Drake Stapleton (AIEN / aien-dev)
note
note tests/one_layer/exp445/gen_expected.om -- pure seeded OM-2 computation of
note hidden/expected for the public exp445 dev tasks (dev01..dev10).
note Replaces tests/one_layer/exp445/gen_expected.c.

text t_use "usage: gen_expected <task_id> < inputs\n"
text t_unk "gen_expected: unknown task "
text t_d08_err "dev08: input needs >= 1000 steps\n"
text t_d01 "dev01"
text t_d02 "dev02"
text t_d03 "dev03"
text t_d04 "dev04"
text t_d05 "dev05"
text t_d06 "dev06"
text t_d07 "dev07"
text t_d08 "dev08"
text t_d09 "dev09"
text t_d10 "dev10"
text t_tr1 "TRAP 1\n"
text t_tr2 "TRAP 2\n"
text t_tr5 "TRAP 5\n"

global g_in uchar 65536
global g_inm ulong 2
global g_out uchar 4096
global g_outn ulong 1
global g_arg uchar 64
global g_argn ulong 1
global g_vals long 2
global g_uvals ulong 2

fn o_c c uchar to void
  n = get g_outn 0
  if lt n 4095
    put g_out n c
    put g_outn 0 add n 1
  end
end

fn o_s s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    o_c get s i
    i = add i 1
  end
end

fn o_flush fd int to void
  n = get g_outn 0
  off = ulong 0
  while lt off n
    w = write fd g_out off sub n off
    if le w 0
      break
    end
    off = add off ulong w
  end
  put g_outn 0 0
end

fn o_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    o_c 48
    ret
  end
  k = ulong 0
  while gt v 0
    put tmp k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0
    k = sub k 1
    o_c get tmp k
  end
end

fn o_i64 v long to void
  if lt v 0
    o_c 45
    if eq v neg long 9223372036854775807
      o_u64 9223372036854775807
      ret
    end
    o_u64 ulong neg v
    ret
  end
  o_u64 ulong v
end

fn arg_eq lit view uchar * to bool
  n = get g_argn 0
  if ne n len lit
    ret false
  end
  i = ulong 0
  while lt i n
    if ne get g_arg i get lit i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn fill_in to void
  pos = ulong 0
  while lt pos 65535
    r = read 0 g_in pos sub 65535 pos
    if le r 0
      break
    end
    pos = add pos ulong r
  end
  put g_inm 0 0
  put g_inm 1 pos
end

fn parse_line two bool is_u bool to bool
  p = get g_inm 0
  n = get g_inm 1
  if ge p n
    ret false
  end
  e = p
  while lt e n
    if eq get g_in e 10
      break
    end
    e = add e 1
  end
  if lt e n
    put g_inm 0 add e 1
  else
    put g_inm 0 n
  end
  cnt = ulong 1
  if two
    cnt = 2
  end
  k = ulong 0
  while lt k cnt
    while lt p e
      ch = get g_in p
      if and ne ch 32 and ne ch 9 ne ch 13
        break
      end
      p = add p 1
    end
    if ge p e
      ret false
    end
    isneg = false
    if and not is_u eq get g_in p 45
      isneg = true
      p = add p 1
    end
    if ge p e
      ret false
    end
    d0 = get g_in p
    if or lt d0 48 gt d0 57
      ret false
    end
    acc = ulong 0
    while lt p e
      ch = get g_in p
      if or lt ch 48 gt ch 57
        break
      end
      acc = add mul acc 10 ulong sub ch 48
      p = add p 1
    end
    if is_u
      put g_uvals k acc
    else
      if isneg
        put g_vals k neg long acc
      else
        put g_vals k long acc
      end
    end
    k = add k 1
  end
  ret true
end

fn run_task tid ulong to int
  if eq tid 1
    while parse_line true true
      s = add get g_uvals 0 get g_uvals 1
      if gt s 255
        s = 255
      end
      o_u64 s
      o_c 10
    end
    ret 0
  end
  if eq tid 2
    while parse_line true false
      a = get g_vals 0
      b = get g_vals 1
      if gt a b
        o_i64 sub a b
      else
        o_i64 sub b a
      end
      o_c 10
    end
    ret 0
  end
  if eq tid 3
    while parse_line false true
      x = get g_uvals 0
      c = ulong 0
      while gt x 0
        c = add c and x 1
        x = shr x 1
      end
      o_u64 c
      o_c 10
    end
    ret 0
  end
  if eq tid 4
    while parse_line true true
      x = get g_uvals 0
      y = get g_uvals 1
      while gt y 0
        r = rem x y
        x = y
        y = r
      end
      o_u64 x
      o_c 10
    end
    ret 0
  end
  if eq tid 5
    while parse_line true false
      p = mul get g_vals 0 get g_vals 1
      if or lt p neg long 32768 gt p 32767
        o_s t_tr1
      else
        o_i64 p
        o_c 10
      end
    end
    ret 0
  end
  if eq tid 6
    while parse_line true true
      x = get g_uvals 0
      y = get g_uvals 1
      if eq y 0
        o_s t_tr2
      else
        o_u64 div x y
        o_c 10
      end
    end
    ret 0
  end
  if eq tid 7
    while parse_line false true
      x = get g_uvals 0
      r = ulong 0
      while le mul add r 1 add r 1 x
        r = add r 1
      end
      o_u64 r
      o_c 10
    end
    ret 0
  end
  if eq tid 8
    while parse_line false true
      x = get g_uvals 0
      s = ulong 0
      while ne x 1
        if ne rem x 2 0
          x = add mul 3 x 1
        else
          x = div x 2
        end
        s = add s 1
        if ge s 1000
          o_flush 1
          o_s t_d08_err
          o_flush 2
          ret 1
        end
      end
      o_u64 s
      o_c 10
    end
    ret 0
  end
  if eq tid 9
    while parse_line false true
      x = get g_uvals 0
      r = ulong 0
      i = ulong 0
      while lt i 8
        if ne and shr x i 1 0
          r = or r shl ulong 1 sub 7 i
        end
        i = add i 1
      end
      o_u64 r
      o_c 10
    end
    ret 0
  end
  while parse_line false false
    a = get g_vals 0
    if or lt a neg long 128 gt a 127
      o_s t_tr5
    else
      o_i64 a
      o_c 10
    end
  end
  ret 0
end

fn main to int
  if ne argcnt 2
    o_s t_use
    o_flush 2
    ret 2
  end
  al = argread 1 g_arg 0 64
  if lt al 0
    o_s t_use
    o_flush 2
    ret 2
  end
  put g_argn 0 ulong al
  tid = ulong 0
  if arg_eq t_d01
    tid = 1
  end
  if arg_eq t_d02
    tid = 2
  end
  if arg_eq t_d03
    tid = 3
  end
  if arg_eq t_d04
    tid = 4
  end
  if arg_eq t_d05
    tid = 5
  end
  if arg_eq t_d06
    tid = 6
  end
  if arg_eq t_d07
    tid = 7
  end
  if arg_eq t_d08
    tid = 8
  end
  if arg_eq t_d09
    tid = 9
  end
  if arg_eq t_d10
    tid = 10
  end
  if eq tid 0
    o_s t_unk
    i = ulong 0
    while lt i get g_argn 0
      o_c get g_arg i
      i = add i 1
    end
    o_c 10
    o_flush 2
    ret 2
  end
  fill_in
  rc = run_task tid
  o_flush 1
  ret rc
end

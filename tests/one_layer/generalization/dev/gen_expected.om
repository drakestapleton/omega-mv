note
note tests/one_layer/generalization/dev/gen_expected.om -- pure seeded OM-2 port of
note tests/one_layer/generalization/dev/gen_expected.c (devgen01..devgen10).
note Keeps gen_expected.c live (SHA-256 pinned in protocol.json and gencheck).

text t_use "usage: gen_expected <task_id> < inputs\n"
text t_unk "gen_expected: unknown task "
text t_bad "gen_expected: bad input line\n"
text t_ref_pre "gen_expected: "
text t_ref_mid ": input "
text t_trap "TRAP\n"
text t_r_u32 "result exceeds 32 bits\n"
text t_r_part "a partial result overflows but the final sum fits\n"
text t_r_rng "range\n"
text t_r_u64 "b^e exceeds 64 bits\n"
text t_r_k0 "k = 0\n"
text t_d01 "devgen01"
text t_d02 "devgen02"
text t_d03 "devgen03"
text t_d04 "devgen04"
text t_d05 "devgen05"
text t_d06 "devgen06"
text t_d07 "devgen07"
text t_d08 "devgen08"
text t_d09 "devgen09"
text t_d10 "devgen10"

global g_in uchar 65536
global g_inm ulong 2
global g_out uchar 16384
global g_outn ulong 1
global g_arg uchar 64
global g_argn ulong 1
global g_vals long 8
global g_cnt long 256

fn o_c c uchar to void
  n = get g_outn 0
  if ge n 16380
    off = ulong 0
    while lt off n bound 16384
      w = write 1 g_out off sub n off
      if le w 0
        break
      end
      off = add off ulong w
    end
    put g_outn 0 0
    n = 0
  end
  put g_out n c
  put g_outn 0 add n 1
end

fn o_s s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n bound 4096
    o_c get s i
    i = add i 1
  end
end

fn o_flush fd int to void
  n = get g_outn 0
  off = ulong 0
  while lt off n bound 16384
    w = write fd g_out off sub n off
    if le w 0
      break
    end
    off = add off ulong w
  end
  put g_outn 0 0
end

fn o_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    o_c 48
    ret
  end
  k = ulong 0
  while gt v 0 bound 24
    put tmp k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0 bound 24
    k = sub k 1
    o_c get tmp k
  end
end

fn o_i64 v long to void
  if lt v 0
    o_c 45
    if eq v sub neg long 9223372036854775807 long 1
      o_u64 ulong 9223372036854775808
      ret
    end
    o_u64 ulong neg v
    ret
  end
  o_u64 ulong v
end

fn arg_eq lit view uchar * to bool
  n = get g_argn 0
  if ne n len lit
    ret false
  end
  i = ulong 0
  while lt i n bound 64
    if ne get g_arg i get lit i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn fail_refuse why view uchar * to int
  o_flush 1
  o_s t_ref_pre
  i = ulong 0
  n = get g_argn 0
  while lt i n bound 64
    o_c get g_arg i
    i = add i 1
  end
  o_s t_ref_mid
  o_s why
  o_flush 2
  ret 1
end

fn fill_in to void
  pos = ulong 0
  while lt pos 65535 bound 65536
    r = read 0 g_in pos sub 65535 pos
    if le r 0
      break
    end
    pos = add pos ulong r
  end
  put g_inm 0 0
  put g_inm 1 pos
end

note Returns 1 on parsed line, 0 on EOF, -1 on bad input line.
fn rd_line cnt ulong to int
  p = get g_inm 0
  n = get g_inm 1
  if ge p n
    ret 0
  end
  e = p
  while lt e n bound 65536
    if eq get g_in e 10
      break
    end
    e = add e 1
  end
  if lt e n
    put g_inm 0 add e 1
  else
    put g_inm 0 n
  end
  k = ulong 0
  while lt k cnt bound 8
    while lt p e bound 1024
      ch = get g_in p
      if and ne ch 32 and ne ch 9 ne ch 13
        break
      end
      p = add p 1
    end
    if ge p e
      ret -1
    end
    isneg = false
    if eq get g_in p 45
      isneg = true
      p = add p 1
    else
      if eq get g_in p 43
        p = add p 1
      end
    end
    if ge p e
      ret -1
    end
    d0 = get g_in p
    if or lt d0 48 gt d0 57
      ret -1
    end
    acc = ulong 0
    while lt p e bound 1024
      ch = get g_in p
      if or lt ch 48 gt ch 57
        break
      end
      acc = add mul acc 10 ulong sub ch 48
      p = add p 1
    end
    if isneg
      if eq acc ulong 9223372036854775808
        put g_vals k sub neg long 9223372036854775807 long 1
      else
        put g_vals k neg long acc
      end
    else
      put g_vals k long acc
    end
    k = add k 1
  end
  ret 1
end

fn fits32 v long to bool
  if lt v neg long 2147483648
    ret false
  end
  if gt v long 2147483647
    ret false
  end
  ret true
end

fn run_d01 to int
  while true bound 65536
    st = rd_line 1
    if eq st 0
      ret 0
    end
    if lt st 0
      o_flush 1
      o_s t_bad
      o_flush 2
      ret 1
    end
    n = get g_vals 0
    if eq n 0
      o_u64 0
      o_c 10
    else
      if or lt n 0 gt n 2000
        ret fail_refuse t_r_u32
      end
      nm1 = sub n 1
      t1 = div mul mul nm1 n sub mul 2 n 1 2
      s = add add t1 mul nm1 n n
      if gt s long 4294967295
        ret fail_refuse t_r_u32
      end
      o_i64 s
      o_c 10
    end
  end
  ret 0
end

fn run_d02 to int
  while true bound 65536
    st = rd_line 2
    if eq st 0
      ret 0
    end
    if lt st 0
      o_flush 1
      o_s t_bad
      o_flush 2
      ret 1
    end
    n = get g_vals 0
    c = get g_vals 1
    s = long 0
    pov = false
    x = long 0
    while lt x n bound 1000000
      a = sub x c
      b = add x c
      p = mul a b
      g = add p x
      if not fits32 a
        pov = true
      end
      if not fits32 b
        pov = true
      end
      if not fits32 p
        pov = true
      end
      if not fits32 g
        pov = true
      end
      s = add s g
      if not fits32 s
        pov = true
      end
      x = add x 1
    end
    if and pov fits32 s
      ret fail_refuse t_r_part
    end
    if pov
      o_s t_trap
    else
      o_i64 s
      o_c 10
    end
  end
  ret 0
end

fn run_d03 to int
  while true bound 65536
    st = rd_line 2
    if eq st 0
      ret 0
    end
    if lt st 0
      o_flush 1
      o_s t_bad
      o_flush 2
      ret 1
    end
    s = ulong get g_vals 0
    lim = ulong get g_vals 1
    i = ulong 0
    while lt i lim bound 1000000
      s = rem add add mul s 31 mul i i 7 65536
      i = add i 1
    end
    o_u64 s
    o_c 10
  end
  ret 0
end

fn run_d04 to int
  while true bound 65536
    st = rd_line 1
    if eq st 0
      ret 0
    end
    if lt st 0
      o_flush 1
      o_s t_bad
      o_flush 2
      ret 1
    end
    n = get g_vals 0
    if eq rem n 2 0
      o_i64 div mul n add n 1 2
    else
      o_i64 add sub mul mul n n n mul 2 n 5
    end
    o_c 10
  end
  ret 0
end

fn run_d05 to int
  while true bound 65536
    st = rd_line 2
    if eq st 0
      ret 0
    end
    if lt st 0
      o_flush 1
      o_s t_bad
      o_flush 2
      ret 1
    end
    x = get g_vals 0
    k = get g_vals 1
    if lt x 0
      o_i64 sub add mul mul 3 x x mul 5 x 2
      o_c 10
    else
      t1 = add ulong x 1
      over = false
      i = long 0
      while lt i k bound 1000000
        if over
          break
        end
        if gt t1 ulong 4611686018427387904
          over = true
        else
          t1 = mul t1 2
          if gt sub t1 1 ulong 9223372036854775807
            over = true
          end
        end
        i = add i 1
      end
      if over
        o_s t_trap
      else
        if gt sub t1 1 ulong 9223372036854775807
          ret fail_refuse t_r_rng
        end
        o_u64 sub t1 1
        o_c 10
      end
    end
  end
  ret 0
end

fn run_d06 to int
  while true bound 65536
    st = rd_line 2
    if eq st 0
      ret 0
    end
    if lt st 0
      o_flush 1
      o_s t_bad
      o_flush 2
      ret 1
    end
    b = get g_vals 0
    e = get g_vals 1
    if lt b 10
      r = ulong 1
      ub = ulong b
      i = long 0
      while lt i e bound 1000000
        if gt ub 0
          if gt r div ulong 18446744073709551615 ub
            ret fail_refuse t_r_u64
          end
        end
        r = mul r ub
        i = add i 1
      end
      o_u64 r
      o_c 10
    else
      v = add mul add mul b b mul e e 3 b
      o_i64 v
      o_c 10
    end
  end
  ret 0
end

fn run_d07 to int
  while true bound 65536
    st = rd_line 4
    if eq st 0
      ret 0
    end
    if lt st 0
      o_flush 1
      o_s t_bad
      o_flush 2
      ret 1
    end
    best = sub get g_vals 1 get g_vals 0
    d1 = sub get g_vals 2 get g_vals 1
    if gt d1 best
      best = d1
    end
    d2 = sub get g_vals 3 get g_vals 2
    if gt d2 best
      best = d2
    end
    o_i64 best
    o_c 10
  end
  ret 0
end

fn run_d08 to int
  while true bound 65536
    st = rd_line 5
    if eq st 0
      ret 0
    end
    if lt st 0
      o_flush 1
      o_s t_bad
      o_flush 2
      ret 1
    end
    k = long 0
    i = ulong 0
    while lt i 4 bound 8
      if gt get g_vals add i 1 get g_vals i
        k = add k 1
      end
      i = add i 1
    end
    o_i64 k
    o_c 10
  end
  ret 0
end

fn d09_pairs n long k long to long
  z = ulong 0
  while lt z 256 bound 256
    put g_cnt z 0
    z = add z 1
  end
  i = long 1
  while le i n bound 1000000
    idx = ulong rem i k
    put g_cnt idx add get g_cnt idx 1
    i = add i 1
  end
  c0 = get g_cnt 0
  pairs = div mul c0 sub c0 1 2
  r = long 1
  while lt r k bound 256
    q = sub k r
    cr = get g_cnt ulong r
    if lt r q
      cq = get g_cnt ulong q
      pairs = add pairs mul cr cq
    else
      if eq r q
        pairs = add pairs div mul cr sub cr 1 2
      end
    end
    r = add r 1
  end
  ret pairs
end

fn run_d09 to int
  while true bound 65536
    st = rd_line 2
    if eq st 0
      ret 0
    end
    if lt st 0
      o_flush 1
      o_s t_bad
      o_flush 2
      ret 1
    end
    n = get g_vals 0
    k = get g_vals 1
    if lt k 1
      ret fail_refuse t_r_k0
    end
    o_i64 d09_pairs n k
    o_c 10
  end
  ret 0
end

fn run_d10 to int
  while true bound 65536
    st = rd_line 2
    if eq st 0
      ret 0
    end
    if lt st 0
      o_flush 1
      o_s t_bad
      o_flush 2
      ret 1
    end
    n = get g_vals 0
    m = get g_vals 1
    c = long 0
    i = long 1
    while le i n bound 1000000
      q = div m i
      if lt q n
        c = add c q
      else
        c = add c n
      end
      i = add i 1
    end
    o_i64 c
    o_c 10
  end
  ret 0
end

fn find_task to ulong
  if arg_eq t_d01
    ret 1
  end
  if arg_eq t_d02
    ret 2
  end
  if arg_eq t_d03
    ret 3
  end
  if arg_eq t_d04
    ret 4
  end
  if arg_eq t_d05
    ret 5
  end
  if arg_eq t_d06
    ret 6
  end
  if arg_eq t_d07
    ret 7
  end
  if arg_eq t_d08
    ret 8
  end
  if arg_eq t_d09
    ret 9
  end
  if arg_eq t_d10
    ret 10
  end
  ret 0
end

fn run_task tid ulong to int
  if eq tid 1
    ret run_d01
  end
  if eq tid 2
    ret run_d02
  end
  if eq tid 3
    ret run_d03
  end
  if eq tid 4
    ret run_d04
  end
  if eq tid 5
    ret run_d05
  end
  if eq tid 6
    ret run_d06
  end
  if eq tid 7
    ret run_d07
  end
  if eq tid 8
    ret run_d08
  end
  if eq tid 9
    ret run_d09
  end
  ret run_d10
end

fn main to int
  if ne argcnt 2
    o_s t_use
    o_flush 2
    ret 2
  end
  al = argread ulong 1 g_arg ulong 0 ulong 64
  if lt al long 0
    o_s t_use
    o_flush 2
    ret 2
  end
  put g_argn 0 ulong al
  tid = find_task
  if eq tid 0
    o_s t_unk
    i = ulong 0
    while lt i get g_argn 0 bound 64
      o_c get g_arg i
      i = add i 1
    end
    o_c 10
    o_flush 2
    ret 2
  end
  fill_in
  rc = run_task tid
  o_flush 1
  ret rc
end

note tests/one_layer/generalization/corpus/oracle.om -- pure seeded OM-2 oracle
note for the GEN-3 public corpus (replaces tests/one_layer/generalization/corpus/oracle.c).
om2

const M32 ulong 4294967295

text t_usage "usage: oracle <task_id> < inputs > expected | oracle --bound <task_id>\n"
text t_unk1 "oracle: unknown task '"
text t_unk2 "'\n"
text t_bad "oracle: bad input line\n"
text t_bound "--bound"
text t_b0 "0:4096\n"
text t_trap2 "TRAP 2\n"
text t_nl "\n"

text tn_00 "clamp_sum"
text tn_01 "clamp_triple"
text tn_02 "gap_inc"
text tn_03 "gap_half"
text tn_04 "sat_sum"
text tn_05 "sat_prod"
text tn_06 "digsum_mod9"
text tn_07 "digsum_scaled"
text tn_08 "digcount_nibbles"
text tn_09 "popcnt_zero"
text tn_10 "popcnt_odd"
text tn_11 "lcm32"
text tn_12 "ds_plus_dc"
text tn_13 "pc_times_dc"
text tn_14 "gcd_plus_ds"
text tn_15 "gcd_times_pc"
text tn_16 "sum4_avg"
text tn_17 "sum4_mod"
text tn_18 "sum4_low"
text tn_19 "max4_inc"
text tn_20 "max4_half"
text tn_21 "sum_clamped"
text tn_22 "sum_dists"
text tn_23 "sum_sat"
text tn_24 "even_ds_odd_dc"
text tn_25 "big_pc_small_ds"
text tn_26 "gcd_or_dc"
text tn_27 "avg_inc"
text tn_28 "avg_double"
text tn_29 "cube_inc"
text tn_30 "gcd_only"
text tn_31 "ds2_inc"
text tn_32 "ds2_double"
text tn_33 "clamp_gap"
text tn_34 "sat_affine"
text tn_35 "even_digsums"
text tn_36 "hamming"
text tn_37 "spread4"
text tn_38 "avg4"
text tn_39 "digits_both"
text tn_40 "wrap_range"
text tn_41 "wrap_diff"
text tn_42 "wrap8"
text tn_43 "digit_product"
text tn_44 "hex_digits"
text tn_45 "zero_bits8"
text tn_46 "weighted4"
text tn_47 "second_max"
text tn_48 "ceil_avg"

global g_arg1 uchar 256
global g_arg2 uchar 256
global g_inbuf uchar 65536
global g_line uchar 512
global g_outbuf uchar 64
global g_tmp uchar 32
global g_a ulong 8
global g_v ulong 4
global g_st ulong 4

fn wr_lit fd int s view uchar * to void
  off = ulong 0
  n = len s
  while lt off n
    w = write fd s off sub n off
    if le w 0
      ret
    end
    off = add off ulong w
  end
end

fn wr_gbuf fd int n ulong to void
  off = ulong 0
  while lt off n
    w = write fd g_outbuf off sub n off
    if le w 0
      ret
    end
    off = add off ulong w
  end
end

fn wr_u64 fd int v ulong to void
  if eq v 0
    put g_outbuf 0 uchar 48
    put g_outbuf 1 uchar 10
    wr_gbuf fd 2
    ret
  end
  k = ulong 0
  x = v
  while gt x 0
    d = rem x 10
    put g_tmp k uchar add d 48
    x = div x 10
    k = add k 1
  end
  i = ulong 0
  while lt i k
    put g_outbuf i get g_tmp sub sub k 1 i
    i = add i 1
  end
  put g_outbuf k uchar 10
  wr_gbuf fd add k 1
end

fn eq_arg1 s view uchar * n ulong to int
  if ne n len s
    ret 0
  end
  i = ulong 0
  while lt i n
    if ne get g_arg1 i get s i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn eq_arg2 s view uchar * n ulong to int
  if ne n len s
    ret 0
  end
  i = ulong 0
  while lt i n
    if ne get g_arg2 i get s i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn match_task_a1 n ulong to int
  if eq eq_arg1 tn_00 n 1
    ret 0
  end
  if eq eq_arg1 tn_01 n 1
    ret 1
  end
  if eq eq_arg1 tn_02 n 1
    ret 2
  end
  if eq eq_arg1 tn_03 n 1
    ret 3
  end
  if eq eq_arg1 tn_04 n 1
    ret 4
  end
  if eq eq_arg1 tn_05 n 1
    ret 5
  end
  if eq eq_arg1 tn_06 n 1
    ret 6
  end
  if eq eq_arg1 tn_07 n 1
    ret 7
  end
  if eq eq_arg1 tn_08 n 1
    ret 8
  end
  if eq eq_arg1 tn_09 n 1
    ret 9
  end
  if eq eq_arg1 tn_10 n 1
    ret 10
  end
  if eq eq_arg1 tn_11 n 1
    ret 11
  end
  if eq eq_arg1 tn_12 n 1
    ret 12
  end
  if eq eq_arg1 tn_13 n 1
    ret 13
  end
  if eq eq_arg1 tn_14 n 1
    ret 14
  end
  if eq eq_arg1 tn_15 n 1
    ret 15
  end
  if eq eq_arg1 tn_16 n 1
    ret 16
  end
  if eq eq_arg1 tn_17 n 1
    ret 17
  end
  if eq eq_arg1 tn_18 n 1
    ret 18
  end
  if eq eq_arg1 tn_19 n 1
    ret 19
  end
  if eq eq_arg1 tn_20 n 1
    ret 20
  end
  if eq eq_arg1 tn_21 n 1
    ret 21
  end
  if eq eq_arg1 tn_22 n 1
    ret 22
  end
  if eq eq_arg1 tn_23 n 1
    ret 23
  end
  if eq eq_arg1 tn_24 n 1
    ret 24
  end
  ret -1
end

fn match_task_a2 n ulong to int
  if eq eq_arg1 tn_25 n 1
    ret 25
  end
  if eq eq_arg1 tn_26 n 1
    ret 26
  end
  if eq eq_arg1 tn_27 n 1
    ret 27
  end
  if eq eq_arg1 tn_28 n 1
    ret 28
  end
  if eq eq_arg1 tn_29 n 1
    ret 29
  end
  if eq eq_arg1 tn_30 n 1
    ret 30
  end
  if eq eq_arg1 tn_31 n 1
    ret 31
  end
  if eq eq_arg1 tn_32 n 1
    ret 32
  end
  if eq eq_arg1 tn_33 n 1
    ret 33
  end
  if eq eq_arg1 tn_34 n 1
    ret 34
  end
  if eq eq_arg1 tn_35 n 1
    ret 35
  end
  if eq eq_arg1 tn_36 n 1
    ret 36
  end
  if eq eq_arg1 tn_37 n 1
    ret 37
  end
  if eq eq_arg1 tn_38 n 1
    ret 38
  end
  if eq eq_arg1 tn_39 n 1
    ret 39
  end
  if eq eq_arg1 tn_40 n 1
    ret 40
  end
  if eq eq_arg1 tn_41 n 1
    ret 41
  end
  if eq eq_arg1 tn_42 n 1
    ret 42
  end
  if eq eq_arg1 tn_43 n 1
    ret 43
  end
  if eq eq_arg1 tn_44 n 1
    ret 44
  end
  if eq eq_arg1 tn_45 n 1
    ret 45
  end
  if eq eq_arg1 tn_46 n 1
    ret 46
  end
  if eq eq_arg1 tn_47 n 1
    ret 47
  end
  if eq eq_arg1 tn_48 n 1
    ret 48
  end
  ret -1
end

fn find_task n ulong to int
  r = match_task_a1 n
  if ge r 0
    ret r
  end
  ret match_task_a2 n
end

fn chk v ulong to ulong
  ret and v M32
end

fn clampv x ulong lo ulong hi ulong to ulong
  if lt x lo
    ret lo
  end
  if gt x hi
    ret hi
  end
  ret x
end

fn adiff a ulong b ulong to ulong
  if gt a b
    ret sub a b
  end
  ret sub b a
end

fn sat8 x ulong to ulong
  if gt x 255
    ret 255
  end
  ret x
end

fn dsum n ulong to ulong
  s = ulong 0
  x = n
  s = add s rem x 10
  x = div x 10
  while gt x 0
    s = add s rem x 10
    x = div x 10
  end
  ret s
end

fn dcount n ulong to ulong
  c = ulong 1
  x = n
  while ge x 10
    c = add c 1
    x = div x 10
  end
  ret c
end

fn pcount x ulong to ulong
  c = ulong 0
  v = x
  while gt v 0
    c = add c and v 1
    v = shr v 1
  end
  ret c
end

fn gcdv a ulong b ulong to ulong
  x = a
  y = b
  while gt y 0
    t = rem x y
    x = y
    y = t
  end
  ret x
end

fn max4 to ulong
  m = get g_a 0
  i = ulong 1
  while lt i 4
    v = get g_a i
    if gt v m
      m = v
    end
    i = add i 1
  end
  ret m
end

fn sum4 to ulong
  s = add get g_a 0 get g_a 1
  s = add s get g_a 2
  s = add s get g_a 3
  ret s
end

fn avg2 a ulong b ulong to ulong
  ret div add a b 2
end

fn run_task_1 tid int to ulong
  a0 = get g_a 0
  a1 = get g_a 1
  a2 = get g_a 2
  if eq tid 0
    ret clampv chk add a0 a1 10 100
  end
  if eq tid 1
    ret clampv chk mul 3 a0 50 1000
  end
  if eq tid 2
    ret chk add adiff a0 a1 1
  end
  if eq tid 3
    ret div adiff a0 a1 2
  end
  if eq tid 4
    ret sat8 chk add a0 a1
  end
  if eq tid 5
    ret sat8 chk mul a0 a1
  end
  if eq tid 6
    ret rem dsum a0 9
  end
  if eq tid 7
    ret chk mul dsum a0 a1
  end
  if eq tid 8
    ret mul 4 dcount a0
  end
  if eq tid 9
    ret sub 32 pcount a0
  end
  if eq tid 10
    ret and pcount a0 1
  end
  if eq tid 11
    if eq a0 0
      ret 0
    end
    if eq a1 0
      ret 0
    end
    g = gcdv a0 a1
    ret chk mul div a0 g a1
  end
  if eq tid 12
    ret add dsum a0 dcount a0
  end
  if eq tid 13
    ret mul pcount a0 dcount a0
  end
  if eq tid 14
    ret chk add gcdv a0 a1 dsum a0
  end
  if eq tid 15
    ret chk mul gcdv a0 a1 pcount a1
  end
  if eq tid 16
    ret div sum4 4
  end
  if eq tid 17
    a4 = get g_a 4
    if eq a4 0
      put g_st 0 2
      ret 0
    end
    ret rem sum4 a4
  end
  if eq tid 18
    ret and sum4 65535
  end
  if eq tid 19
    ret chk add max4 1
  end
  if eq tid 20
    ret div max4 2
  end
  if eq tid 21
    s = ulong 0
    i = ulong 0
    while lt i a0
      s = chk add s clampv i a1 a2
      i = add i 1
    end
    ret s
  end
  if eq tid 22
    s = ulong 0
    i = ulong 0
    while lt i a0
      s = chk add s adiff i a1
      i = add i 1
    end
    ret s
  end
  if eq tid 23
    s = ulong 0
    i = ulong 0
    while lt i a0
      s = chk add s sat8 chk mul i a1
      i = add i 1
    end
    ret s
  end
  if eq tid 24
    if eq rem a0 2 0
      ret dsum a0
    end
    ret dcount a0
  end
  ret 0
end

fn run_second_max to ulong
  put g_v 0 get g_a 0
  put g_v 1 get g_a 1
  put g_v 2 get g_a 2
  put g_v 3 get g_a 3
  i = ulong 0
  while lt i 4
    j = add i 1
    while lt j 4
      vi = get g_v i
      vj = get g_v j
      if gt vj vi
        put g_v i vj
        put g_v j vi
      end
      j = add j 1
    end
    i = add i 1
  end
  ret get g_v 1
end

fn run_task_2 tid int to ulong
  a0 = get g_a 0
  a1 = get g_a 1
  a2 = get g_a 2
  a3 = get g_a 3
  if eq tid 25
    if ge a0 1000
      ret pcount a0
    end
    ret dsum a0
  end
  if eq tid 26
    if gt a0 a1
      ret gcdv a0 a1
    end
    ret dcount a1
  end
  if eq tid 27
    ret chk add avg2 a0 a1 1
  end
  if eq tid 28
    ret chk mul 2 avg2 a0 a1
  end
  if eq tid 29
    ret chk add chk mul chk mul a0 a0 a0 1
  end
  if eq tid 30
    ret gcdv a0 a1
  end
  if eq tid 31
    ret add dsum dsum a0 1
  end
  if eq tid 32
    ret mul 2 dsum dsum a0
  end
  if eq tid 33
    ret clampv adiff a0 a1 a2 a3
  end
  if eq tid 34
    ret sat8 chk add chk mul a0 a1 a2
  end
  if eq tid 35
    c = ulong 0
    i = ulong 0
    while lt i a0
      if eq rem dsum i 2 0
        c = add c 1
      end
      i = add i 1
    end
    ret c
  end
  if eq tid 36
    ret pcount xor a0 a1
  end
  if eq tid 37
    ret sub mul 4 max4 sum4
  end
  if eq tid 38
    ret avg2 avg2 a0 a1 avg2 a2 a3
  end
  if eq tid 39
    ret add dcount a0 dcount a1
  end
  if eq tid 40
    d = chk sub a2 a1
    if eq d 0
      put g_st 0 2
      ret 0
    end
    ret chk add a1 rem a0 d
  end
  if eq tid 41
    ret chk sub a0 a1
  end
  if eq tid 42
    ret and a0 255
  end
  if eq tid 43
    if eq a0 0
      ret 0
    end
    p = ulong 1
    n = a0
    while gt n 0
      p = mul p rem n 10
      n = div n 10
    end
    ret p
  end
  if eq tid 44
    c = ulong 1
    n = a0
    while ge n 16
      c = add c 1
      n = div n 16
    end
    ret c
  end
  if eq tid 45
    ret sub 8 pcount and a0 255
  end
  if eq tid 46
    s = add a0 mul 2 a1
    s = add s mul 3 a2
    ret add s mul 4 a3
  end
  if eq tid 47
    ret run_second_max
  end
  if eq tid 48
    ret div add add a0 a1 1 2
  end
  ret 0
end

fn run_task tid int to ulong
  put g_st 0 0
  if lt tid 25
    ret run_task_1 tid
  end
  ret run_task_2 tid
end

fn parse_line llen ulong to int
  i = ulong 0
  while lt i 8
    put g_a i 0
    i = add i 1
  end
  pos = ulong 0
  cnt = ulong 0
  while lt cnt 8
    while lt pos llen
      c = get g_line pos
      if ne c 32
        break
      end
      pos = add pos 1
    end
    if ge pos llen
      break
    end
    c0 = get g_line pos
    if eq c0 10
      break
    end
    if lt c0 48
      ret -1
    end
    if gt c0 57
      ret -1
    end
    v = ulong 0
    while lt pos llen
      ch = get g_line pos
      if lt ch 48
        break
      end
      if gt ch 57
        break
      end
      d = ulong sub ch 48
      if gt v 429496729
        ret -1
      end
      v = add mul v 10 d
      if gt v M32
        ret -1
      end
      pos = add pos 1
    end
    put g_a cnt v
    cnt = add cnt 1
  end
  ret 0
end

fn fail_unk n ulong to int
  wr_lit 2 t_unk1
  off = ulong 0
  while lt off n
    w = write 2 g_arg1 off sub n off
    if le w 0
      break
    end
    off = add off ulong w
  end
  wr_lit 2 t_unk2
  ret 2
end

fn main to int
  ac = argcnt
  if eq ac 3
    n1 = argread 1 g_arg1 0 255
    if ge n1 0
      if eq eq_arg1 t_bound ulong n1 1
        n2 = argread 2 g_arg2 0 255
        if lt n2 0
          wr_lit 2 t_usage
          ret 2
        end
        i = ulong 0
        while lt i ulong n2
          put g_arg1 i get g_arg2 i
          i = add i 1
        end
        tid = find_task ulong n2
        if lt tid 0
          ret fail_unk ulong n2
        end
        if eq tid 35
          wr_lit 1 t_b0
        end
        if eq tid 21
          wr_lit 1 t_b0
        end
        if eq tid 22
          wr_lit 1 t_b0
        end
        if eq tid 23
          wr_lit 1 t_b0
        end
        ret 0
      end
    end
  end
  if ne ac 2
    wr_lit 2 t_usage
    ret 2
  end
  n1 = argread 1 g_arg1 0 255
  if lt n1 0
    wr_lit 2 t_usage
    ret 2
  end
  tid = find_task ulong n1
  if lt tid 0
    ret fail_unk ulong n1
  end
  llen = ulong 0
  while eq int 1 1
    nr = read 0 g_inbuf 0 65536
    if le nr 0
      break
    end
    idx = ulong 0
    while lt idx ulong nr
      ch = get g_inbuf idx
      if lt llen 511
        put g_line llen ch
        llen = add llen 1
      end
      if eq ch 10
        if ne parse_line llen 0
          wr_lit 2 t_bad
          ret 2
        end
        r = run_task tid
        if ne get g_st 0 0
          wr_lit 1 t_trap2
        else
          wr_u64 1 r
        end
        llen = ulong 0
      end
      idx = add idx 1
    end
  end
  if gt llen 0
    if ne parse_line llen 0
      wr_lit 2 t_bad
      ret 2
    end
    r = run_task tid
    if ne get g_st 0 0
      wr_lit 1 t_trap2
    else
      wr_u64 1 r
    end
  end
  ret 0
end

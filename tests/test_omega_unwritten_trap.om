note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/test_omega_unwritten_trap.c
om2

const UW_POISON uint 0x55555555
const UW_N ulong 1000003
const UW_M ulong 16777179

text uw_p "[PASS] "
text uw_f "[FAIL] "
text uw_nl "\n"
text uw_sum1 "SUMMARY passed="
text uw_sum2 " failed="

text id_no_poison "NO_POISON"
text id_empty "EMPTY_BUFFER"
text id_tail_cir "TAIL_COUNT_INDEX_RUN"
text id_tail_mid "TAIL_STARTS_MID_BLOCK_IS_NOT_WHOLE"
text id_short_last "SHORT_LAST_BLOCK_IS_WHOLE"
text id_win_cfl "WINDOW_COUNT_FIRST_LAST"
text id_win_wb "WINDOW_IS_1536_WHOLE_BLOCKS"
text id_two_win "TWO_WINDOWS"
text id_shift "SHIFTED_WINDOW_NOT_WHOLE"
text id_scat_cir "SCATTERED_COUNT_INDEX_RUNS"
text id_scat_nwt "SCATTERED_NOT_WHOLE_NOT_TAIL"
text id_other "OTHER_POISON_NOT_COUNTED"

global g_uw_pass ulong 1
global g_uw_fail ulong 1
global g_uw_nbuf uchar 32

fn uw_ws s view uchar * n ulong to void
  if eq n 0
    ret
  end
  ign = write 1 s 0 n
end

fn uw_pu64 v ulong to void
  if eq v 0
    put g_uw_nbuf 0 uchar 48
    ign = write 1 g_uw_nbuf 0 1
    ret
  end
  x = v
  cnt = ulong 0
  while gt x 0 bound 24
    put g_uw_nbuf cnt uchar add rem x 10 48
    cnt = add cnt 1
    x = div x 10
  end
  i = ulong 0
  j = sub cnt 1
  while lt i j bound 24
    a = get g_uw_nbuf i
    b = get g_uw_nbuf j
    put g_uw_nbuf i b
    put g_uw_nbuf j a
    i = add i 1
    j = sub j 1
  end
  ign = write 1 g_uw_nbuf 0 cnt
end

fn uw_chk ok bool label view uchar * to void
  if ok
    put g_uw_pass 0 add get g_uw_pass 0 1
    uw_ws uw_p len uw_p
  else
    put g_uw_fail 0 add get g_uw_fail 0 1
    uw_ws uw_f len uw_f
  end
  uw_ws label len label
  uw_ws uw_nl len uw_nl
end

fn uw_init n ulong to void
  for i ulong n bound 17000000
    put g_uw_buf i add uint 0x3f800000 uint i
  end
end

fn uw_fillp lo ulong hi ulong to void
  i = lo
  while lt i hi bound 200000
    put g_uw_buf i UW_POISON
    i = add i 1
  end
end

fn test_small_buf to void
  uw_init UW_N

  omega_unwritten_scan UW_N UW_POISON 64
  ok0 = and eq get g_uw_rep 0 0 and eq get g_uw_rep 3 0 and eq get g_uw_rep 7 0 eq get g_uw_rep 8 0
  ok0 = and ok0 and eq get g_uw_rep 5 0 eq get g_uw_rep 6 0
  uw_chk ok0 id_no_poison

  omega_unwritten_scan 0 UW_POISON 64
  uw_chk eq get g_uw_rep 0 0 id_empty

  uw_fillp sub UW_N 100 UW_N
  omega_unwritten_scan UW_N UW_POISON 64
  ok1 = and eq get g_uw_rep 0 100 and eq get g_uw_rep 1 sub UW_N 100 eq get g_uw_rep 2 sub UW_N 1
  ok1 = and ok1 and eq get g_uw_rep 3 1 eq get g_uw_rep 8 1
  uw_chk ok1 id_tail_cir
  ok2 = and eq get g_uw_rep 7 0 and eq get g_uw_rep 6 1 eq get g_uw_rep 5 2
  uw_chk ok2 id_tail_mid

  uw_init UW_N
  uw_fillp sub UW_N 3 UW_N
  omega_unwritten_scan UW_N UW_POISON 64
  ok3 = and eq get g_uw_rep 0 3 and eq get g_uw_rep 8 1 and eq get g_uw_rep 7 1 eq get g_uw_rep 5 1
  uw_chk ok3 id_short_last
end

fn test_grid_buf to void
  uw_init UW_M
  lo = mul ulong 64 3000
  hi = add lo 98304
  uw_fillp lo hi
  omega_unwritten_scan UW_M UW_POISON 64
  ok4 = and eq get g_uw_rep 0 98304 and eq get g_uw_rep 1 lo eq get g_uw_rep 2 sub hi 1
  uw_chk ok4 id_win_cfl
  ok5 = and eq get g_uw_rep 7 1 and eq get g_uw_rep 5 1536 eq get g_uw_rep 6 0
  ok5 = and ok5 and eq get g_uw_rep 3 1 and eq get g_uw_rep 4 98304 eq get g_uw_rep 8 0
  uw_chk ok5 id_win_wb

  uw_fillp mul ulong 64 10 mul ulong 64 12
  omega_unwritten_scan UW_M UW_POISON 64
  ok6 = and eq get g_uw_rep 3 2 and eq get g_uw_rep 5 1538 and eq get g_uw_rep 7 1 eq get g_uw_rep 1 640
  uw_chk ok6 id_two_win
end

fn test_shifted_and_scattered to void
  uw_init UW_N
  uw_fillp add mul ulong 64 100 1 add mul ulong 64 102 1
  omega_unwritten_scan UW_N UW_POISON 64
  ok7 = and eq get g_uw_rep 0 128 and eq get g_uw_rep 7 0 and eq get g_uw_rep 6 2 eq get g_uw_rep 5 1
  uw_chk ok7 id_shift

  uw_init UW_N
  put g_uw_buf 5 UW_POISON
  put g_uw_buf 70 UW_POISON
  put g_uw_buf 71 UW_POISON
  put g_uw_buf 9000 UW_POISON
  put g_uw_buf 500000 UW_POISON
  put g_uw_buf sub UW_N 1 UW_POISON
  omega_unwritten_scan UW_N UW_POISON 64
  ok8 = and eq get g_uw_rep 0 6 and eq get g_uw_rep 1 5 eq get g_uw_rep 2 sub UW_N 1
  ok8 = and ok8 and eq get g_uw_rep 3 5 eq get g_uw_rep 4 2
  uw_chk ok8 id_scat_cir
  ok9 = and eq get g_uw_rep 7 0 and eq get g_uw_rep 8 0 and eq get g_uw_rep 6 5 eq get g_uw_rep 5 0
  uw_chk ok9 id_scat_nwt

  omega_unwritten_scan UW_N uint 0xdeadbeef 64
  uw_chk eq get g_uw_rep 0 0 id_other
end

fn main to int
  put g_uw_pass 0 0
  put g_uw_fail 0 0
  test_small_buf
  test_grid_buf
  test_shifted_and_scattered
  uw_ws uw_sum1 len uw_sum1
  uw_pu64 get g_uw_pass 0
  uw_ws uw_sum2 len uw_sum2
  uw_pu64 get g_uw_fail 0
  uw_ws uw_nl len uw_nl
  if ne get g_uw_fail 0 0
    ret 1
  end
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 parity test for src/omega_receipt.om against C/Rust fixtures.
om2

text p_rc1 "tests/resolve/receipts/54f597d22b3753e47d6bd7706b6a7a422c189024912ec4626347e860b5f44a8c.json"
text id_rc1 "54f597d22b3753e47d6bd7706b6a7a422c189024912ec4626347e860b5f44a8c"
text p_rc2 "tests/resolve/receipts/7fdff014cb20a0af5b5a5b377532292be29fc15da36d434944ad4521e69de5b3.json"
text id_rc2 "7fdff014cb20a0af5b5a5b377532292be29fc15da36d434944ad4521e69de5b3"
text p_rc3 "tests/resolve/receipts/8e885832de2e7123555c47803547161c02196646b270d41078d8b16d4beaf765.json"
text id_rc3 "8e885832de2e7123555c47803547161c02196646b270d41078d8b16d4beaf765"

text t_bad_unk "{\"schema\":\"EvidenceReceiptV1\",\"extra\":1}"
text t_bad_dup "{\"schema\":\"EvidenceReceiptV1\",\"schema\":\"EvidenceReceiptV1\"}"
text t_unk_tier "BOGUS_TIER"
text msg_pass "OMEGA_RECEIPT_OM_PASS\n"
text msg_fail "OMEGA_RECEIPT_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn hex_nib_c v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

fn chk_id_hex dig view uchar 32 gold view uchar * to void
  for i ulong 32
    b = ulong get dig i
    chk eq hex_nib_c shr b 4 get gold mul i 2
    chk eq hex_nib_c and b 15 get gold add mul i 2 1
  end
end

fn test_tiers to void
  chk eq omega_tier_rank rc_t0 len rc_t0 0
  chk eq omega_tier_rank rc_t1 len rc_t1 1
  chk eq omega_tier_rank rc_t4 len rc_t4 4
  chk eq omega_tier_rank rc_t7 len rc_t7 7
  chk eq omega_tier_rank t_unk_tier len t_unk_tier -1

  chk eq omega_tier_satisfies 0 0 1
  chk eq omega_tier_satisfies 1 0 0
  chk eq omega_tier_satisfies 0 1 1
  chk eq omega_tier_satisfies 4 3 0
  chk eq omega_tier_satisfies 4 4 1
  chk eq omega_tier_satisfies 5 7 1
  chk eq omega_tier_satisfies -1 7 0
end

fn tamper_commit buf edit uchar * tot ulong to void
  for i ulong sub tot 10 bound 4096
    if eq get buf i 97
      if eq get buf add i 1 97
        if eq get buf add i 2 97
          if eq get buf add i 3 97
            put buf i 98
            ret
          end
        end
      end
    end
  end
end

fn test_fixture path view uchar * gold view uchar * to void
  fd = fopen path 0 len path 0 0
  chk ge fd 0
  if lt fd 0
    ret
  end
  buf = new uchar 4096 0
  tot = ulong 0
  while lt tot 4096 bound 64
    r = read int fd buf tot sub 4096 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  ign = fclose int fd
  chk gt tot 0

  out_id = new uchar 32 0
  chk eq omega_receipt_verify_bytes buf tot out_id 0
  chk_id_hex out_id gold

  note Negative: tamper one byte inside commit field -> verify must fail
  tamper_commit buf tot
  chk eq omega_receipt_verify_bytes buf tot out_id -1
  omega_receipt_free
end

fn test_negatives to void
  chk eq omega_receipt_parse t_bad_unk len t_bad_unk -1
  chk eq omega_receipt_parse t_bad_dup len t_bad_dup -1
end

fn main to int
  test_tiers
  test_fixture p_rc1 id_rc1
  test_fixture p_rc2 id_rc2
  test_fixture p_rc3 id_rc3
  test_negatives
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/test_omega_gpu_engine_compile.c.
note Verifies the A3a Omega GPU Engine contract:
note   - Failure/State/Wait/Step enum counts and distinctness
note   - Stub result with no backend set (INTERNAL_INVARIANT at NOT_IMPLEMENTED)
note   - Missing result pointer refused (INVALID_ARGS)
note   - All 18 malformed job counterexamples refused at VALIDATE
note   - NO_C3 flag permits zero marker2 timeout
note   - Incomplete backend table refused at BACKEND_CHECK; complete no-op backend reaches SUCCESS
note   - Forced uncertain-completion block refuses every job (even malformed) until reset.
note Host-only, CPU-only, zero GPU access.
om2

const GE_OK ulong 0
const GE_COMPLETION_WAIT ulong 6
const GE_INVALID_ARGS ulong 10
const GE_INTERNAL_INVARIANT ulong 11
const GE_UNCERTAIN_BLOCKED ulong 13
const GE_FAILURE_COUNT ulong 14

const GE_ST_INITIAL ulong 0
const GE_ST_SUCCESS ulong 6
const GE_STATE_COUNT ulong 7

const GE_WAIT_NONE ulong 0
const GE_WAIT_RELEASE_SEM ulong 2
const GE_WAIT_COUNT ulong 4

const GE_STEP_NONE ulong 0
const GE_STEP_VALIDATE ulong 1
const GE_STEP_BACKEND_CHECK ulong 2
const GE_STEP_BLOCKED ulong 3
const GE_STEP_NOT_IMPL ulong 4
const GE_STEP_COUNT ulong 21

const GE_LAYOUT_VEC1D ulong 0
const GE_LAYOUT_COUNT ulong 1
const GE_FLAG_NO_C3 ulong 1

text t_ge_pass "PASS test_omega_gpu_engine_compile\n"
text t_ge_fail "FAIL test_omega_gpu_engine_compile\n"

note Engine state: [0]=blocked, [1]=backend_set, [2]=backend_mask (15 bits = all 15 fns present)
global g_ge_state ulong 4
const GE_BE_FULL ulong 32767

note Result layout (12 ulongs):
note [0]=failure, [1]=failed_step, [2]=last_state, [3]=wait, [4]=wait_timeout_ms,
note [5]=waited_ms, [6]=drv_rc, [7]=sync_valid, [8]=retained, [9]=cleanup_failed,
note [10]=n_outputs, [11]=unchanged_words

note Job layout (16 ulongs):
note [0]=has_prog, [1]=prog_len, [2]=layout, [3]=elem_cnt,
note [4]=has_ina, [5]=ina_len, [6]=has_inb, [7]=inb_len,
note [8]=has_out, [9]=out_len, [10]=out_align_ok, [11]=has_poison,
note [12]=poison_cnt, [13]=flags, [14]=t_mask (bits 0..3: marker, rel_sem, marker2, vis)

fn ge_res_zero r edit ulong 12 to void
  for i ulong 12
    put r i 0
  end
end

fn ge_res_poison r edit ulong 12 to void
  for i ulong 12
    put r i 0x7f7f7f7f
  end
end

fn ge_expect_refused r view ulong 12 failure ulong step ulong to long
  if ne get r 0 failure
    ret 1
  end
  if ne get r 1 step
    ret 2
  end
  if ne get r 2 GE_ST_INITIAL
    ret 3
  end
  if ne get r 3 GE_WAIT_NONE
    ret 4
  end
  for i ulong 8
    if ne get r add i 4 0
      ret 5
    end
  end
  ret 0
end

fn ge_validate_job j view ulong 16 to ulong
  if or eq get j 0 0 eq get j 1 0
    ret 0
  end
  if ge get j 2 GE_LAYOUT_COUNT
    ret 0
  end
  n = get j 3
  if eq n 0
    ret 0
  end
  want_bytes = mul n 4
  if or eq get j 4 0 ne get j 5 want_bytes
    ret 0
  end
  if or eq get j 6 0 ne get j 7 want_bytes
    ret 0
  end
  if or eq get j 8 0 ne get j 9 want_bytes
    ret 0
  end
  if eq get j 10 0
    ret 0
  end
  if or eq get j 11 0 ne get j 12 n
    ret 0
  end
  flags = get j 13
  if ne and flags xor GE_FLAG_NO_C3 ulong 0xffffffffffffffff 0
    ret 0
  end
  tm = get j 14
  note marker(bit0), rel_sem(bit1), vis(bit3) always required; marker2(bit2) required unless NO_C3
  if ne and tm 11 11
    ret 0
  end
  if eq and flags GE_FLAG_NO_C3 0
    if eq and tm 4 0
      ret 0
    end
  end
  ret 1
end

fn ge_execute has_job ulong j view ulong 16 has_res ulong r edit ulong 12 to ulong
  if eq has_res 0
    ret GE_INVALID_ARGS
  end
  ge_res_zero r
  if ne get g_ge_state 0 0
    put r 0 GE_UNCERTAIN_BLOCKED
    put r 1 GE_STEP_BLOCKED
    ret GE_UNCERTAIN_BLOCKED
  end
  if eq has_job 0
    put r 0 GE_INVALID_ARGS
    put r 1 GE_STEP_VALIDATE
    ret GE_INVALID_ARGS
  end
  if eq ge_validate_job j 0
    put r 0 GE_INVALID_ARGS
    put r 1 GE_STEP_VALIDATE
    ret GE_INVALID_ARGS
  end
  if eq get g_ge_state 1 0
    put r 0 GE_INTERNAL_INVARIANT
    put r 1 GE_STEP_NOT_IMPL
    ret GE_INTERNAL_INVARIANT
  end
  if ne get g_ge_state 2 GE_BE_FULL
    put r 0 GE_INTERNAL_INVARIANT
    put r 1 GE_STEP_BACKEND_CHECK
    ret GE_INTERNAL_INVARIANT
  end
  note Complete no-op backend reaches SUCCESS
  put r 0 GE_OK
  put r 1 GE_STEP_NONE
  put r 2 GE_ST_SUCCESS
  put r 3 GE_WAIT_NONE
  put r 10 1
  put r 11 0
  ret GE_OK
end

fn ge_make_valid_job j edit ulong 16 to void
  put j 0 1
  put j 1 4
  put j 2 GE_LAYOUT_VEC1D
  put j 3 4
  put j 4 1
  put j 5 16
  put j 6 1
  put j 7 16
  put j 8 1
  put j 9 16
  put j 10 1
  put j 11 1
  put j 12 4
  put j 13 0
  put j 14 15
end

fn ge_check_invalid idx ulong val ulong r edit ulong 12 to long
  bj = new ulong 16 0
  ge_make_valid_job bj
  put bj idx val
  ge_res_poison r
  if ne ge_execute 1 bj 1 r GE_INVALID_ARGS
    ret 1
  end
  ret ge_expect_refused r GE_INVALID_ARGS GE_STEP_VALIDATE
end

fn ge_test_invalid_suite r edit ulong 12 to long
  if ne ge_check_invalid 0 0 r 0
    ret 20
  end
  if ne ge_check_invalid 1 0 r 0
    ret 21
  end
  if ne ge_check_invalid 2 GE_LAYOUT_COUNT r 0
    ret 22
  end
  if ne ge_check_invalid 3 0 r 0
    ret 23
  end
  if ne ge_check_invalid 4 0 r 0
    ret 24
  end
  if ne ge_check_invalid 5 12 r 0
    ret 25
  end
  if ne ge_check_invalid 6 0 r 0
    ret 26
  end
  if ne ge_check_invalid 7 20 r 0
    ret 27
  end
  if ne ge_check_invalid 8 0 r 0
    ret 28
  end
  if ne ge_check_invalid 9 12 r 0
    ret 29
  end
  if ne ge_check_invalid 10 0 r 0
    ret 30
  end
  if ne ge_check_invalid 11 0 r 0
    ret 31
  end
  if ne ge_check_invalid 12 3 r 0
    ret 32
  end
  if ne ge_check_invalid 13 2 r 0
    ret 33
  end
  if ne ge_check_invalid 14 14 r 0
    ret 34
  end
  if ne ge_check_invalid 14 13 r 0
    ret 35
  end
  if ne ge_check_invalid 14 7 r 0
    ret 36
  end
  if ne ge_check_invalid 14 11 r 0
    ret 37
  end
  ret 0
end

fn main to int
  note Enum counts & key constants
  if or ne GE_OK 0 ne GE_STATE_COUNT 7
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 1
  end
  if or ne GE_FAILURE_COUNT 14 ne GE_WAIT_COUNT 4
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 2
  end
  if ne GE_STEP_COUNT 21
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 3
  end

  job = new ulong 16 0
  r = new ulong 12 0
  ge_make_valid_job job

  note Not blocked at start; no backend set -> INTERNAL_INVARIANT at NOT_IMPLEMENTED
  put g_ge_state 0 0
  put g_ge_state 1 0
  put g_ge_state 2 0
  ge_res_poison r
  if ne ge_execute 1 job 1 r GE_INTERNAL_INVARIANT
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 10
  end
  if ne ge_expect_refused r GE_INTERNAL_INVARIANT GE_STEP_NOT_IMPL 0
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 11
  end

  note Missing result pointer refused
  if ne ge_execute 1 job 0 r GE_INVALID_ARGS
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 12
  end

  note NULL job refused at VALIDATE
  ge_res_poison r
  if ne ge_execute 0 job 1 r GE_INVALID_ARGS
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 13
  end
  if ne ge_expect_refused r GE_INVALID_ARGS GE_STEP_VALIDATE 0
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 14
  end

  note All 18 malformed job counterexamples
  rc = ge_test_invalid_suite r
  if ne rc 0
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret int rc
  end

  note With NO_C3 a zero marker2 timeout is allowed
  bj = new ulong 16 0
  ge_make_valid_job bj
  put bj 13 GE_FLAG_NO_C3
  put bj 14 11
  ge_res_poison r
  if ne ge_execute 1 bj 1 r GE_INTERNAL_INVARIANT
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 40
  end
  if ne ge_expect_refused r GE_INTERNAL_INVARIANT GE_STEP_NOT_IMPL 0
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 41
  end

  note Complete no-op backend reaches SUCCESS
  put g_ge_state 1 1
  put g_ge_state 2 GE_BE_FULL
  ge_res_poison r
  if ne ge_execute 1 job 1 r GE_OK
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 42
  end
  if or ne get r 0 GE_OK ne get r 1 GE_STEP_NONE
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 43
  end
  if or ne get r 2 GE_ST_SUCCESS ne get r 10 1
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 44
  end

  note Incomplete backend (missing close bit 14) refused at BACKEND_CHECK
  put g_ge_state 2 and GE_BE_FULL 16383
  ge_res_poison r
  if ne ge_execute 1 job 1 r GE_INTERNAL_INVARIANT
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 45
  end
  if ne ge_expect_refused r GE_INTERNAL_INVARIANT GE_STEP_BACKEND_CHECK 0
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 46
  end

  note Clear backend -> NOT_IMPLEMENTED
  put g_ge_state 1 0
  ge_res_poison r
  if ne ge_execute 1 job 1 r GE_INTERNAL_INVARIANT
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 47
  end
  if ne ge_expect_refused r GE_INTERNAL_INVARIANT GE_STEP_NOT_IMPL 0
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 48
  end

  note Forced block refuses every job, even NULL job, until reset
  put g_ge_state 0 1
  ge_res_poison r
  if ne ge_execute 1 job 1 r GE_UNCERTAIN_BLOCKED
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 50
  end
  if ne ge_expect_refused r GE_UNCERTAIN_BLOCKED GE_STEP_BLOCKED 0
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 51
  end
  ge_res_poison r
  if ne ge_execute 0 job 1 r GE_UNCERTAIN_BLOCKED
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 52
  end
  if ne ge_expect_refused r GE_UNCERTAIN_BLOCKED GE_STEP_BLOCKED 0
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 53
  end
  if ne get g_ge_state 0 1
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 54
  end
  put g_ge_state 0 0
  ge_res_poison r
  if ne ge_execute 1 job 1 r GE_INTERNAL_INVARIANT
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 55
  end
  if ne ge_expect_refused r GE_INTERNAL_INVARIANT GE_STEP_NOT_IMPL 0
    ign = write 1 t_ge_fail 0 len t_ge_fail
    ret 56
  end

  ign = write 1 t_ge_pass 0 len t_ge_pass
  ret 0
end

  if ne omega_gpu_decode_attn_cache_read cid 0 0 10 1 OGD_OK
    ret 311
  end
  vw = new ulong 7 0
  if ne omega_gpu_decode_attn_cache_view cid 1 vw OGD_OK
    ret 312
  end
  if or ne get vw 0 2 ne get vw 1 512
    ret 313
  end
  ebuf = new uchar 64 0
  if ne omega_gpu_decode_attn_rc_name OGD_OK ebuf 2
    ret 323
  end
  ret 0
end


  end
  if ne get info 0 2
    ret 120
  end
  if ne get info 2 128
    ret 121
  end
  if ne get info 3 6656
    ret 122
  end
  if ne omega_gpu_attention_test_shared_bytes 6656
    ret 123
  end
  if ne get args 9 0x3e0295d7
    ret 124
  end
  if ne omega_gpu_gqa_attention_f32 req args info qmd1 OGA_OK

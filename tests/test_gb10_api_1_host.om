    ret 126
  end
  put req 0 4097
  if ne omega_gpu_gqa_attention_f32 req args info qmd1 OGA_TOO_LARGE
    ret 127
  end
  put req 0 128
  put req 2 3
  if ne omega_gpu_gqa_attention_f32 req args info qmd1 OGA_BAD_ARGS
    ret 128
  end

  if ne omega_gpu_attention_reserve 64 2 8 2 128 16 OGA_OK
    ret 129
  end
  if ne omega_gpu_attention_reserve_rows 4 8 128 OGA_OK
    ret 130
  end
  put req 0 10
  put req 1 4
  put req 2 8
  put req 3 2
  put req 4 128
  put req 5 0x100000
  put req 6 0x200000
  put req 7 0x300000
  put req 8 0x400000
  if ne omega_gpu_gqa_attention_rows_f32 req args info qmd1 OGA_OK
    ret 131
  end
  if ne get info 1 4
    ret 132
  end
  put req 0 1000
  if ne omega_gpu_gqa_attention_rows_f32 req args info qmd1 OGA_TOO_LARGE
    ret 133
  end
  omega_gpu_attention_unreserve

  ly = new ulong 9 0
  put ly 4 128
  put ly 3 256
  put ly 2 4096
  put ly 1 8192
  put ly 0 16384
  put ly 5 131072
  put ly 6 8
  put ly 7 2
  put ly 8 16
  put oga_paged_bids 0 1
  put oga_paged_bids 1 3
  put req 0 2
  put req 1 24
  put req 2 0
  put req 3 4
  put req 4 2
  put req 5 64
  put req 6 0x100000
  put req 7 pool_va
  put req 8 0x300000
  put req 9 0x400000
  if ne omega_gpu_paged_attention_bf16 ly req args info qmd1 OGA_OK
    ret 134
  end
  if ne get info 11 OGA_KV_RESIDENT
    ret 135
  end
  put req 7 0x200000
  put oga_batch_tabs 0 2
  put oga_batch_tabs 1 -1
  put oga_batch_tabs 2 2
  put oga_batch_tabs 3 5
  put oga_batch_ctxs 0 16
  put oga_batch_ctxs 1 20
  put req 0 2
  put req 1 2
  if ne omega_gpu_paged_attention_batch_bf16 ly req args info qmd1 OGA_OK
    ret 136
  end
  if or ne get info 9 3 ne get info 10 2
    ret 137
  end
  omega_gpu_attention_pool_free
  ret 0
end

fn test_attention_api to ulong
  pva = new ulong 1 0
  rc = test_attention_api_a pva
  if ne rc 0

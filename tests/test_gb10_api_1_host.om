note SPDX-License-Identifier: Apache-2.0
note tests/test_gb10_api_1_host.om: CPU-only host unit/contract/QMD-validation/codegen
note and fail-closed negative-control verification for wave gb10-api-1 (zero /dev/nvidia*).
om2

text t_pass "PASS test-gb10-api-1-host (attention + bf16_gemv + decode_attn + decode_attn256 + elementwise + fp8 CPU-only zero-CUDA)\n"
text t_fail "FAIL test-gb10-api-1-host code="
text t_nl "\n"

fn t_print s view uchar * to void
  r = write 1 s 0 len s
end

fn t_print_u x ulong to void
  b = new uchar 24 0
  pos = ulong 24
  v = x
  while true
    pos = sub pos 1
    put b pos uchar add 48 rem v 10
    v = div v 10
    if eq v 0
      r = write 1 b pos sub 24 pos
      ret
    end
  end
end

fn test_attention_api_a pva edit ulong 1 to ulong
  omega_gpu_attention_cache_clear
  omega_gpu_attention_unreserve
  omega_gpu_attention_pool_free
  omega_gpu_attention_test_set_mutant 0
  omega_gpu_attention_test_set_divergent 0
  omega_gpu_attention_test_set_dedupe 1
  omega_gpu_attention_test_set_split -1
  omega_gpu_attention_test_set_simulator 1

  if ne omega_gpu_attention_heads_per_cta 64 2 1
    ret 101
  end
  if ne omega_gpu_attention_heads_per_cta 128 0 1
    ret 102
  end
  if ne omega_gpu_attention_heads_per_cta 128 1 2
    ret 103
  end
  if ne omega_gpu_attention_heads_per_cta 128 3 4
    ret 104
  end

  if not omega_gpu_attention_test_resident_fits 1048576 65536 10
    ret 105
  end
  if omega_gpu_attention_test_resident_fits 0x100000000 65536 0
    ret 106
  end
  if omega_gpu_attention_test_resident_fits 0x40000000 65536 4
    ret 107
  end

  pva2 = new ulong 1 0
  if ne omega_gpu_attention_pool_alloc 0 pva2 OGA_BAD_ARGS
    ret 108
  end
  if ne omega_gpu_attention_pool_alloc 4194304 pva OGA_OK
    ret 109
  end
  if ne omega_gpu_attention_pool_alloc 4096 pva2 OGA_BAD_ARGS
    ret 110
  end
  ebuf = new uchar 64 0
  if eq omega_gpu_attention_last_error ebuf 0
    ret 111
  end

  st = new ulong 4 0
  if ne omega_gpu_attention_codegen 1 12 2 st OGA_OK
    ret 112
  end
  if or eq get st 0 0 gt get st 1 OGA_GPR_BUDGET
    ret 113
  end
  if ne get st 3 1024
    ret 114
  end
  if ne omega_gpu_attention_codegen_hd 0 4 2 128 st OGA_OK
    ret 115
  end
  if ne get st 3 6656
    ret 116
  end
  if ne omega_gpu_attention_codegen_hd 1 12 2 96 st OGA_TOO_LARGE
    ret 117
  end
  if ne omega_gpu_attention_codegen_hd 1 17 2 64 st OGA_BAD_ARGS
    ret 118
  end
  if ne omega_gpu_attention_mutant_name 1 ebuf 6
    ret 138
  end
  if ne omega_gpu_attention_rc_name OGA_UNWRITTEN ebuf 9
    ret 139
  end
  ret 0
end

fn test_attention_api_b pool_va ulong to ulong
  req = new ulong 10 0
  put req 0 128
  put req 1 8
  put req 2 2
  put req 3 128
  put req 4 0x100000
  put req 5 0x200000
  put req 6 0x300000
  put req 7 0x400000
  args = new uint 16 0
  info = new ulong 12 0
  qmd1 = new uint 96 0

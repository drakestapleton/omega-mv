end

fn test_fp8_api_b tid ulong to ulong
  req = new ulong 9 0
  put req 7 tid
  args = new uint 10 0
  info = new ulong 10 0
  qmd1 = new uint 96 0
  if ne omega_gpu_fp8_gemv_f32 req args info qmd1 OGF_OK
    ret 614
  end
  if or ne get info 4 192 or ne get info 5 1 ne get info 7 1
    ret 615
  end
  if ne omega_gpu_fp8_gemv_bf16 req args info qmd1 OGF_OK
    ret 616
  end
  omega_gpu_fp8_seal 1
  put req 0 8
  put req 1 1
  if ne omega_gpu_fp8_gemv_grouped_f32 req args info qmd1 OGF_TOO_LARGE
    ret 617
  end
  omega_gpu_fp8_seal 0
  if ne omega_gpu_fp8_gemv_grouped_f32 req args info qmd1 OGF_OK
    ret 618
  end
  if or ne get info 4 6 ne get info 5 8
    ret 619
  end
  put req 2 0x10000
  put req 3 0x20000
  if ne omega_gpu_fp8_gemv_grouped_dev req args info qmd1 OGF_OK
    ret 620
  end
  put req 5 0x30000
  put req 8 1
  if ne omega_gpu_fp8_gemv_grouped_record req args info qmd1 OGF_OK
    ret 621
  end
  put req 8 0
  if ne omega_gpu_fp8_gemv_grouped_record req args info qmd1 OGF_BAD_ARGS
    ret 622
  end
  ret 0
end

fn test_fp8_api_c to ulong
  nk = new ulong 2 0
  put nk 0 128
  put nk 1 128
  wb = new ushort 16384 0x3f80
  w8 = new uchar 16384 0
  sc = new ushort 64 0
  if ne omega_gpu_fp8_quantize_bf16 nk wb w8 sc OGF_OK
    ret 627
  end
  if eq get w8 0 0
    ret 628
  end
  tid = new ulong 1 0
  if ne omega_gpu_fp8_tensor_alloc_uncached 2 128 128 tid OGF_OK
    ret 629
  end
  ent = new ulong 2 0
  if ne omega_gpu_fp8_tensor_cpu_view get tid 0 1 ent OGF_OK
    ret 630
  end
  omega_gpu_fp8_tensor_free get tid 0
  ret 0
end

fn test_fp8_api to ulong
  rc = test_fp8_api_a
  if ne rc 0
    ret rc
  end
  sh3 = new ulong 3 0
  put sh3 0 8
  put sh3 1 1536
  put sh3 2 2048
  w = new uchar 128 0x38
  sc = new ushort 4 0x3f80
  tid = new ulong 1 0
  if ne omega_gpu_fp8_tensor_upload sh3 w sc tid OGF_OK
    ret 611
  end
  put w 5 0x7f
  tid2 = new ulong 1 0
  if ne omega_gpu_fp8_tensor_upload sh3 w sc tid2 OGF_NAN_WEIGHT
    ret 612
  end
  if ne omega_gpu_fp8_prepare 2048 OGF_OK
    ret 613
  end
  rc = test_fp8_api_b get tid 0
  if ne rc 0
    omega_gpu_fp8_tensor_free get tid 0
    ret rc
  end
  ent = new ulong 2 0
  if ne omega_gpu_fp8_tensor_entry get tid 0 3 ent OGF_OK
    ret 623
  end
  if ne omega_gpu_fp8_tensor_sync_to_gpu get tid 0 0
    ret 624
  end
  omega_gpu_fp8_tensor_free get tid 0
  rc = test_fp8_api_c
  if ne rc 0
    ret rc
  end

  if ne obws_verify_zero_libcuda_linkage 0
    ret 625
  end
  if ne obws_verify_zero_libcuda_runtime 0
    ret 626
  end
  ret 0
end

fn main to int
  rc = test_attention_api
  if ne rc 0
    t_print t_fail
    t_print_u rc
    t_print t_nl
    ret int rc
  end
  rc = test_bf16_gemv_api
  if ne rc 0
    t_print t_fail
    t_print_u rc
    t_print t_nl
    ret int rc
  end
  rc = test_decode_attn_api
  if ne rc 0
    t_print t_fail
    t_print_u rc
    t_print t_nl
    ret int rc
  end
  rc = test_decode_attn256_api
  if ne rc 0
    t_print t_fail
    t_print_u rc
    t_print t_nl
    ret int rc
  end
  rc = test_elementwise_api
  if ne rc 0
    t_print t_fail
    t_print_u rc
    t_print t_nl
    ret int rc
  end
  rc = test_fp8_api
  if ne rc 0
    t_print t_fail
    t_print_u rc
    t_print t_nl
    ret int rc
  end
  t_print t_pass
  ret 0
end

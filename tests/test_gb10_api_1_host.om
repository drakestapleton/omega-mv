  decl = new uint 1 0
  if ne omega_gpu_fp8_kernel_fits sp decl OGF_OK
    ret 605
  end
  omega_gpu_fp8_spec_for 2048 1536 8 sp
  if or ne get sp 3 32 ne get sp 5 0
    ret 606
  end

  if ne omega_gpu_fp8_e4m3_rne bitcast f32 uint 0 0
    ret 607
  end
  if ne omega_gpu_fp8_e4m3_rne bitcast f32 uint 0x3f800000 0x38

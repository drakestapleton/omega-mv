  end
  if ne bitcast uint omega_dattn_bf16_f32 b1 0x3f800000
    ret 302
  end
  row = new f32 128 0.0
  omega_dattn_rope_row 0 f64 ulong 1000000 row
  if ne bitcast uint get row 0 0x3f800000
    ret 303
  end
  if ne bitcast uint get row 64 0
    ret 304
  end

  if ne omega_gpu_decode_attn_cache_alloc 0 512 f64 ulong 1000000 cid_out OGD_BAD_ARGS
    ret 305
  end
  if ne omega_gpu_decode_attn_cache_alloc 2 300 f64 ulong 1000000 cid_out OGD_BAD_ARGS
    ret 306
  end
  if ne omega_gpu_decode_attn_cache_alloc 2 512 f64 ulong 1000000 cid_out OGD_OK
    ret 307
  end
  cid = get cid_out 0
  if ne omega_gpu_decode_attn_set_norms cid 0 1 1 OGD_OK
    ret 308
  end
  if ne omega_gpu_decode_attn_set_norms cid 2 1 1 OGD_BAD_ARGS
    ret 309
  end
  if ne omega_gpu_decode_attn_cache_write cid 0 0 10 16 1 OGD_OK
    ret 310

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/q36_codegen_hash.c.
note Emits and SHA-256 hashes Q36 kernel shapes across GDN (decode/prep/scan/post/copy),
note decode attn256, prefill pattn256, MoE router (plain + 256s ROWS), and decode glue (dec),
note verifying deterministic SHA-256 hashes, valid IR sizes, and mutant sensitivity.
note Host-only, CPU-only, zero GPU access.
om2

text t_q36h_pass "PASS test_q36_codegen_hash\n"
text t_q36h_fail "FAIL test_q36_codegen_hash\n"

global g_q36_d0 uchar 32
global g_q36_d1 uchar 32

fn q36h_hash_ir ins view ulong 8192 meta view ulong 512 to long
  cnt = get meta 0
  if or eq cnt 0 gt cnt 1024
    ret -1
  end
  nwords = mul cnt 8
  pos = ulong 0
  for i ulong nwords bound 8192
    v = get ins i
    for b ulong 8
      sh = mul b 8
      by = uchar and shr v sh 255
      put sh_dat pos by
      pos = add pos 1
    end
  end
  sh_all pos
  for i ulong 32
    put g_q36_d1 i get sh_dig i
  end
  ret long pos
end

fn q36h_save_d0 to void
  for i ulong 32
    put g_q36_d0 i get g_q36_d1 i
  end
end

fn q36h_d0_eq_d1 to long
  for i ulong 32
    if ne get g_q36_d0 i get g_q36_d1 i
      ret 0
    end
  end
  ret 1
end

fn q36h_test_gdn ins edit ulong 8192 meta edit ulong 512 to long
  spec = new ulong 4 0
  for m ulong 5
    put spec 0 m
    put spec 1 0
    put spec 2 0
    put spec 3 0
    if ne omega_blackwell_codegen_gdn_prog spec ins meta 0
      ret 10
    end
    if le q36h_hash_ir ins meta 0
      ret 11
    end
    if eq m 0
      q36h_save_d0
    end
    if eq m 1
      if ne q36h_d0_eq_d1 0
        ret 12
      end
    end
    if ne omega_blackwell_codegen_gdn_prep_prog spec ins meta 0
      ret 13
    end
    if le q36h_hash_ir ins meta 0
      ret 14
    end
    if ne omega_blackwell_codegen_gdn_scan_prog spec ins meta 0
      ret 15
    end
    if le q36h_hash_ir ins meta 0
      ret 16
    end
    if ne omega_blackwell_codegen_gdn_post_prog spec ins meta 0
      ret 17
    end
    if le q36h_hash_ir ins meta 0
      ret 18
    end
  end

  note Repeat m=0 determinism check
  put spec 0 0
  put spec 1 0
  if ne omega_blackwell_codegen_gdn_prog spec ins meta 0
    ret 19
  end
  if le q36h_hash_ir ins meta 0
    ret 20
  end
  if ne q36h_d0_eq_d1 1
    ret 21
  end

  note Copy kernels c=1..2
  for c ulong 2
    put spec 0 0
    put spec 1 add c 1
    if ne omega_blackwell_codegen_gdn_copy_prog spec ins meta 0
      ret 22
    end
    if le q36h_hash_ir ins meta 0
      ret 23
    end
  end
  ret 0
end

fn q36h_test_attn256 ins edit ulong 8192 meta edit ulong 512 to long
  sp = new ulong 8 0
  for d ulong 4
    for m ulong 6
      for p ulong 2
        for k ulong 8
          put sp k 0
        end
        put sp 0 add d 1
        put sp 1 m
        put sp 2 p
        if ne omega_blackwell_codegen_decode_attn256_prog sp ins meta 0
          ret 30
        end
        if le q36h_hash_ir ins meta 0
          ret 31
        end
        if and eq d 0 and eq m 0 eq p 0
          q36h_save_d0
        end
        if and eq d 0 and eq m 1 eq p 0
          if ne q36h_d0_eq_d1 0
            ret 32
          end
        end
      end
    end
  end
  ret 0
end

fn q36h_test_pattn256 ins edit ulong 8192 meta edit ulong 512 to long
  sp4 = new ulong 4 0
  for m ulong 3
    put sp4 0 m
    put sp4 1 0
    put sp4 2 0
    put sp4 3 0
    if ne omega_blackwell_codegen_prefill_attn256_prog sp4 ins meta 0
      ret 33
    end
    if le q36h_hash_ir ins meta 0
      ret 34
    end
  end
  put sp4 0 3
  if ne omega_blackwell_codegen_prefill_attn256_prog sp4 ins meta -1
    ret 35
  end
  put sp4 0 4
  if ne omega_blackwell_codegen_prefill_attn256_prog sp4 ins meta -1
    ret 36
  end
  ret 0
end

fn q36h_router_one ins edit ulong 8192 meta edit ulong 512 nw ulong d ulong m ulong to long
  sp = new ulong 8 0
  put sp 0 nw
  put sp 1 d
  put sp 2 m
  rc = omega_blackwell_codegen_router_prog sp ins meta
  if eq d 3
    if ne rc -1
      ret 40
    end
    ret 0
  end
  if ne rc 0
    ret 40
  end
  if le q36h_hash_ir ins meta 0
    ret 41
  end
  ret 0
end

fn q36h_router_rows ins edit ulong 8192 meta edit ulong 512 nw ulong m ulong to long
  sp = new ulong 8 0
  put sp 0 nw
  put sp 1 4
  put sp 2 m
  put sp 3 256
  put sp 4 1
  put sp 5 8192
  put sp 6 16896
  if ne omega_blackwell_codegen_router_prog sp ins meta 0
    ret 42
  end
  if le q36h_hash_ir ins meta 0
    ret 43
  end
  ret 0
end

fn q36h_test_router ins edit ulong 8192 meta edit ulong 512 to long
  warps = new ulong 3 0
  put warps 0 8
  put warps 1 16
  put warps 2 32
  for w ulong 3
    nw = get warps w
    for d ulong 4
      for m ulong 5
        rc = q36h_router_one ins meta nw add d 1 m
        if ne rc 0
          ret rc
        end
      end
    end
    for mi ulong 2
      rc = q36h_router_rows ins meta nw mul mi 6
      if ne rc 0
        ret rc
      end
    end
  end
  ret 0
end

fn q36h_dec_one ins edit ulong 8192 meta edit ulong 512 kind ulong m ulong width ulong to long
  sp = new ulong 8 0
  put sp 0 kind
  put sp 3 m
  put sp 4 width
  rc = omega_blackwell_codegen_dec_prog sp ins meta
  if ne rc 0
    ret 0
  end
  if le q36h_hash_ir ins meta 0
    ret -1
  end
  ret 1
end

fn q36h_dec_grp ins edit ulong 8192 meta edit ulong 512 grp ulong m ulong to long
  sp = new ulong 8 0
  put sp 0 7
  put sp 3 m
  put sp 5 grp
  rc = omega_blackwell_codegen_dec_prog sp ins meta
  if ne rc 0
    ret 0
  end
  if le q36h_hash_ir ins meta 0
    ret -1
  end
  ret 1
end

fn q36h_test_dec ins edit ulong 8192 meta edit ulong 512 to long
  widths = new ulong 3 0
  put widths 0 0
  put widths 1 5120
  put widths 2 17408
  ok_cnt = ulong 0
  for k ulong 6
    kind = add k 1
    for m ulong 3
      for wi ulong 3
        rc = q36h_dec_one ins meta kind m get widths wi
        if lt rc 0
          ret 50
        end
        ok_cnt = add ok_cnt ulong rc
      end
    end
  end
  for gi ulong 2
    for m ulong 4
      rc = q36h_dec_grp ins meta mul gi 9 m
      if lt rc 0
        ret 52
      end
      ok_cnt = add ok_cnt ulong rc
    end
  end
  if lt ok_cnt 20
    ret 54
  end
  ret 0
end

fn main to int
  ins = new ulong 8192 0
  meta = new ulong 512 0
  if ne q36h_test_gdn ins meta 0
    ign = write 1 t_q36h_fail 0 len t_q36h_fail
    ret 1
  end
  if ne q36h_test_attn256 ins meta 0
    ign = write 1 t_q36h_fail 0 len t_q36h_fail
    ret 2
  end
  if ne q36h_test_pattn256 ins meta 0
    ign = write 1 t_q36h_fail 0 len t_q36h_fail
    ret 3
  end
  if ne q36h_test_router ins meta 0
    ign = write 1 t_q36h_fail 0 len t_q36h_fail
    ret 4
  end
  if ne q36h_test_dec ins meta 0
    ign = write 1 t_q36h_fail 0 len t_q36h_fail
    ret 5
  end
  ign = write 1 t_q36h_pass 0 len t_q36h_pass
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit test for src/aarch64_encoder.om.
om2

text enc_gold_sha "cfd2ecfcb4dac129b08cddbec4d6c1a5a6a067ffd5c60cd58328169fabbf73e7"
text msg_pass "AARCH64_ENCODER_OM_PASS\n"
text msg_fail "AARCH64_ENCODER_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex32 dig view uchar * gold view uchar * to void
  for i ulong 32
    b = uint get dig i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn emit_part1 eb edit uchar * to void
  chk eq aarch64_emit_add_reg eb 1 0 1 2 0
  chk eq aarch64_emit_sub_reg eb 1 3 4 5 0
  chk eq aarch64_emit_mul_reg eb 1 6 7 8 0
  chk eq aarch64_emit_and_reg eb 1 9 10 11 0
  chk eq aarch64_emit_orr_reg eb 1 12 13 14 0
  chk eq aarch64_emit_eor_reg eb 1 15 16 17 0
  chk eq aarch64_emit_subs_reg eb 1 18 19 20 0
  chk eq aarch64_emit_mov_reg eb 1 0 1 0
  chk eq aarch64_emit_movz eb 1 2 0x1234 16 0
  chk eq aarch64_emit_movk eb 1 2 0x5678 32 0
  chk eq aarch64_emit_b eb 4 0
  chk eq aarch64_emit_b_cond eb 1 -5 0
  chk eq aarch64_emit_cbz eb 1 3 10 0
end

fn emit_part2 eb edit uchar * to void
  chk eq aarch64_emit_cbnz eb 0 4 -2 0
  chk eq aarch64_emit_adr eb 5 16 0
  chk eq aarch64_emit_ldr_uoff eb 1 6 7 24 0
  chk eq aarch64_emit_str_uoff eb 1 8 9 16 0
  chk eq aarch64_emit_ldrb_uoff eb 10 11 3 0
  chk eq aarch64_emit_strb_uoff eb 12 13 5 0
  chk eq aarch64_emit_ldr_post eb 14 15 4 0
  chk eq aarch64_emit_str_post eb 16 17 -4 0
  chk eq aarch64_emit_ldr_x_post eb 18 19 8 0
  chk eq aarch64_emit_str_x_post eb 20 21 -8 0
  chk eq aarch64_emit_subs_imm eb 1 22 23 1 0
  chk eq aarch64_emit_ret eb 0
end

fn test_encoder to void
  eb = new uchar 128 0
  put g_a64_pos 0 0
  put g_a64_max 0 128
  emit_part1 eb
  emit_part2 eb
  chk eq get g_a64_pos 0 100
  for i ulong 100
    put sh_dat i get eb i
  end
  sh_all 100
  dig = new uchar 32 0
  for i ulong 32
    put dig i get sh_dig i
  end
  chk_hex32 dig enc_gold_sha

  note Negative controls: out-of-range reg and buffer overflow
  chk eq aarch64_emit_add_reg eb 1 32 1 2 -3
  put g_a64_pos 0 126
  chk eq aarch64_emit_ret eb -1
end

fn main to int
  test_encoder
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

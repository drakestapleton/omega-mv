note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 parity test for src/omega_resolve_osc.om against C oracle.
om2

text t_lock_one "omega.lock v1\nalpha = semantic 1111111111111111111111111111111111111111111111111111111111111111 receipt 2222222222222222222222222222222222222222222222222222222222222222\n"
text t_imp_a "alpha"
text t_imp_b "missing_mod"
text t_pfx_dnp "DEPENDENCY_NOT_PINNED: "
text t_pfx_und "UNDECLARED_IMPORT: "

text msg_pass "OMEGA_RESOLVE_OSC_OM_PASS\n"
text msg_fail "OMEGA_RESOLVE_OSC_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_pfx pfx view uchar * to void
  pl = len pfx
  blen = get g_osc_imp_why_len 0
  chk ge blen pl
  if lt blen pl
    ret
  end
  for i ulong pl bound 64
    chk eq get g_osc_imp_why i get pfx i
  end
end

fn main to int
  names = new uchar 258 0
  nlens = new ulong 2 0

  note 1. Empty imports with empty lock -> OK, resolved = 1
  omega_lock_free
  chk eq omega_osc_import_hook names nlens 0 RES_OK
  chk eq get g_osc_imp_resolved 0 1
  chk eq get g_osc_imp_count 0 0
  chk eq get g_osc_imp_why_len 0 0

  note 2. Unpinned import at index 1 -> DEPENDENCY_NOT_PINNED, bad = 1
  chk eq omega_lock_parse t_lock_one len t_lock_one RES_OK
  for i ulong len t_imp_a bound 16
    put names i get t_imp_a i
  end
  put nlens 0 len t_imp_a
  for i ulong len t_imp_b bound 16
    put names add 129 i get t_imp_b i
  end
  put nlens 1 len t_imp_b
  chk eq omega_osc_import_hook names nlens 2 RES_DEP_NOT_PINNED
  chk eq get g_osc_imp_resolved 0 0
  chk eq get g_osc_imp_bad 0 1
  chk_pfx t_pfx_dnp

  note 3. Lock entry not imported -> UNDECLARED_IMPORT, bad = 0xffffffff
  chk eq omega_osc_import_hook names nlens 0 RES_UNDECLARED_IMPORT
  chk eq get g_osc_imp_resolved 0 0
  chk eq get g_osc_imp_bad 0 ulong 0xffffffff
  chk_pfx t_pfx_und

  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

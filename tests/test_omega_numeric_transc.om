note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit/parity test for src/omega_numeric_transc.om.
note Checks bit-exact special values, symmetries, and C-oracle golden bit vectors
note for all 9 frozen FP32 transcendentals (exp2, log2, sigmoid, tanh, rsqrt,
note erf, gelu, sin, cos).
om2

text msg_pass "OMEGA_NUMERIC_TRANSC_OM_PASS\n"
text msg_fail "OMEGA_NUMERIC_TRANSC_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn test_special_and_identities to void
  note EXP2 specials
  chk eq omega_math_exp2 uint 0x00000000 uint 0x3f800000
  chk eq omega_math_exp2 uint 0x3f800000 uint 0x40000000
  chk eq omega_math_exp2 uint 0xbf800000 uint 0x3f000000
  chk eq omega_math_exp2 uint 0x43000000 TR_PINF
  chk eq omega_math_exp2 uint 0xc3180000 uint 0
  chk eq omega_math_exp2 TR_QNAN TR_QNAN

  note LOG2 specials
  chk eq omega_math_log2 uint 0x3f800000 uint 0x00000000
  chk eq omega_math_log2 uint 0x40000000 uint 0x3f800000
  chk eq omega_math_log2 uint 0x40800000 uint 0x40000000
  chk eq omega_math_log2 uint 0x00000000 TR_NINF
  chk eq omega_math_log2 uint 0x80000000 TR_NINF
  chk eq omega_math_log2 uint 0xbf800000 TR_QNAN
  chk eq omega_math_log2 TR_PINF TR_PINF

  note SIGMOID specials
  chk eq omega_math_sigmoid uint 0x00000000 uint 0x3f000000
  chk eq omega_math_sigmoid uint 0x41900000 uint 0x3f800000
  chk eq omega_math_sigmoid uint 0xc2d00000 uint 0x00000000
  chk eq omega_math_sigmoid TR_QNAN TR_QNAN

  note TANH specials & odd symmetry
  chk eq omega_math_tanh uint 0x00000000 uint 0x00000000
  chk eq omega_math_tanh uint 0x80000000 uint 0x80000000
  chk eq omega_math_tanh uint 0x41200000 uint 0x3f800000
  chk eq omega_math_tanh uint 0xc1200000 uint 0xbf800000
  chk eq omega_math_tanh uint 0xbf000000 xor omega_math_tanh uint 0x3f000000 uint 0x80000000
  chk eq omega_math_tanh uint 0xbfc00000 xor omega_math_tanh uint 0x3fc00000 uint 0x80000000

  note RSQRT specials & exact powers of 4
  chk eq omega_math_rsqrt uint 0x3f800000 uint 0x3f800000
  chk eq omega_math_rsqrt uint 0x40800000 uint 0x3f000000
  chk eq omega_math_rsqrt uint 0x00000000 TR_PINF
  chk eq omega_math_rsqrt uint 0x80000000 TR_NINF
  chk eq omega_math_rsqrt uint 0xbf800000 TR_QNAN
  chk eq omega_math_rsqrt TR_PINF uint 0x00000000

  note ERF specials & odd symmetry
  chk eq omega_math_erf uint 0x00000000 uint 0x00000000
  chk eq omega_math_erf uint 0x80000000 uint 0x80000000
  chk eq omega_math_erf uint 0x40800000 uint 0x3f800000
  chk eq omega_math_erf uint 0xc0800000 uint 0xbf800000
  chk eq omega_math_erf uint 0xbe800000 xor omega_math_erf uint 0x3e800000 uint 0x80000000
  chk eq omega_math_erf uint 0xbf800000 xor omega_math_erf uint 0x3f800000 uint 0x80000000

  note GELU specials & subnormal tie-break (gelu(2^-149) = 2^-149)
  chk eq omega_math_gelu uint 0x00000000 uint 0x00000000
  chk eq omega_math_gelu uint 0x80000000 uint 0x80000000
  chk eq omega_math_gelu uint 0x41000000 uint 0x41000000
  chk eq omega_math_gelu uint 0xc1800000 uint 0x80000000
  chk eq omega_math_gelu uint 0x00000001 uint 0x00000001
  chk eq omega_math_gelu uint 0x80000001 uint 0x80000000
  note Regression: |y| >= g_erfcx_lo[16] must clamp at interval 16 without OOB trap
  chk eq and omega_math_gelu uint 0xc10fd38d uint 0x80000000 uint 0x80000000
  chk eq omega_math_gelu uint 0xc1780000 uint 0x80000000
  chk eq omega_math_gelu uint 0x40e00000 uint 0x40e00000

  note SIN / COS specials & domain boundary
  chk eq omega_math_sin uint 0x00000000 uint 0x00000000
  chk eq omega_math_sin uint 0x80000000 uint 0x80000000
  chk eq omega_math_cos uint 0x00000000 uint 0x3f800000
  chk eq omega_math_cos uint 0x80000000 uint 0x3f800000
  chk eq omega_math_sin TR_PINF TR_QNAN
  chk eq omega_math_cos TR_PINF TR_QNAN
  chk eq omega_math_sin uint 0x4b000000 TR_QNAN
  chk eq omega_math_cos uint 0x4b000000 TR_QNAN
end

fn chk_row1 x uint e2 uint l2 uint sg uint th uint rsq uint to void
  chk eq omega_math_exp2 x e2
  chk eq omega_math_log2 x l2
  chk eq omega_math_sigmoid x sg
  chk eq omega_math_tanh x th
  chk eq omega_math_rsqrt x rsq
end

fn chk_row2 x uint er uint gl uint sn uint cs uint to void
  chk eq omega_math_erf x er
  chk eq omega_math_gelu x gl
  chk eq omega_math_sin x sn
  chk eq omega_math_cos x cs
end

fn test_c_oracle_golden to void
  note 144 bit-exact C-oracle golden checks (16 inputs x 9 functions, AArch64 Spark)
  chk_row1 uint 0x3eaaaaab uint 0x3fa14518 uint 0xbfcae00d uint 0x3f152352 uint 0x3ea49d52 uint 0x3fddb3d7
  chk_row2 uint 0x3eaaaaab uint 0x3eb9ad04 uint 0x3e573b0f uint 0x3ea78611 uint 0x3f71e8b3
  chk_row1 uint 0x3f000000 uint 0x3fb504f3 uint 0xbf800000 uint 0x3f1f597f uint 0x3eec9a9f uint 0x3fb504f3
  chk_row2 uint 0x3f000000 uint 0x3f053f7b uint 0x3eb103af uint 0x3ef57744 uint 0x3f60a940
  chk_row1 uint 0x3f400000 uint 0x3fd744fd uint 0xbed47fcc uint 0x3f2ddea8 uint 0x3f22991f uint 0x3f93cd3a
  chk_row2 uint 0x3f400000 uint 0x3f360e4c uint 0x3f147cd0 uint 0x3f2e7fe1 uint 0x3f3b4ff6
  chk_row1 uint 0x3f800000 uint 0x40000000 uint 0x00000000 uint 0x3f3b26a8 uint 0x3f42f7d6 uint 0x3f800000
  chk_row2 uint 0x3f800000 uint 0x3f57bb3d uint 0x3f57625e uint 0x3f576aa4 uint 0x3f0a5140
  chk_row1 uint 0x3fc00000 uint 0x403504f3 uint 0x3f15c01a uint 0x3f514c8f uint 0x3f67b7cc uint 0x3f5105ec
  chk_row2 uint 0x3fc00000 uint 0x3f7752ab uint 0x3fb32c4b uint 0x3f7f5bd5 uint 0x3d90deaa
  chk_row1 uint 0x40200000 uint 0x40b504f3 uint 0x3fa934f1 uint 0x3f6c948f uint 0x3f7c92c1 uint 0x3f21e89b
  chk_row2 uint 0x40200000 uint 0x3f7fe554 uint 0x401f01a7 uint 0x3f193578 uint 0xbf4d17c0
  chk_row1 uint 0x40a00000 uint 0x42000000 uint 0x40149a78 uint 0x3f7e4961 uint 0x3f7ffa0d uint 0x3ee4f92e
  chk_row2 uint 0x40a00000 uint 0x3f800000 uint 0x409ffffd uint 0xbf757c10 uint 0x3e913c2c
  chk_row1 uint 0x41200000 uint 0x44800000 uint 0x40549a78 uint 0x3f7ffd06 uint 0x3f800000 uint 0x3ea1e89b
  chk_row2 uint 0x41200000 uint 0x3f800000 uint 0x41200000 uint 0xbf0b44f8 uint 0xbf56cd64
  chk_row1 uint 0xbeaaaaab uint 0x3f4b2ff5 uint 0x7fc00000 uint 0x3ed5b95c uint 0xbea49d52 uint 0x7fc00000
  chk_row2 uint 0xbeaaaaab uint 0xbeb9ad04 uint 0xbdfc348e uint 0xbea78611 uint 0x3f71e8b3
  chk_row1 uint 0xbf400000 uint 0x3f1837f0 uint 0x7fc00000 uint 0x3ea442b0 uint 0xbf22991f uint 0x7fc00000
  chk_row2 uint 0xbf400000 uint 0xbf360e4c uint 0xbe2e0cc0 uint 0xbf2e7fe1 uint 0x3f3b4ff6
  chk_row1 uint 0xc0200000 uint 0x3e3504f3 uint 0x7fc00000 uint 0x3d9b5b88 uint 0xbf7c92c1 uint 0x7fc00000
  chk_row2 uint 0xc0200000 uint 0xbf7fe554 uint 0xbc7e5910 uint 0xbf193578 uint 0xbf4d17c0
  chk_row1 uint 0xc0e00000 uint 0x3c000000 uint 0x7fc00000 uint 0x3a6ed39d uint 0xbf7fffe4 uint 0x7fc00000
  chk_row2 uint 0xc0e00000 uint 0xbf800000 uint 0xad1d9a58 uint 0xbf283046 uint 0x3f40ffbd
  chk_row1 uint 0x00000001 uint 0x3f800000 uint 0xc3150000 uint 0x3f000000 uint 0x00000001 uint 0x64b504f3
  chk_row2 uint 0x00000001 uint 0x00000001 uint 0x00000001 uint 0x00000001 uint 0x3f800000
  chk_row1 uint 0x00400000 uint 0x3f800000 uint 0xc2fe0000 uint 0x3f000000 uint 0x00400000 uint 0x5f3504f3
  chk_row2 uint 0x00400000 uint 0x0048375e uint 0x00200000 uint 0x00400000 uint 0x3f800000
  chk_row1 uint 0x49800000 uint 0x7f800000 uint 0x41a00000 uint 0x3f800000 uint 0x3f800000 uint 0x3a800000
  chk_row2 uint 0x49800000 uint 0x3f800000 uint 0x49800000 uint 0x3ea93666 uint 0x3f719d6d
  chk_row1 uint 0x4a7fffff uint 0x7f800000 uint 0x41b00000 uint 0x3f800000 uint 0x3f800000 uint 0x3a000000
  chk_row2 uint 0x4a7fffff uint 0x3f800000 uint 0x4a7fffff uint 0x3f63d5d0 uint 0x3ee97872
end

fn main to int
  test_special_and_identities
  test_c_oracle_golden
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

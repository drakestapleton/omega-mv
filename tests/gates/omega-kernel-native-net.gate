# tests/gates/omega-kernel-native-net.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-NATIVE-NET, unchanged: kernel/tests/gates/run.sh native-net, reached from the
# omega-mv root as tests/gates/run.sh kernel-native-net. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly native-suites.yml matrix suite net: make -C native/net plus explicit pass markers, no NOT_RUN (hosted 368 s)
gate: OMEGA-KERNEL-NATIVE-NET
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/net/
  - kernel/tests/gates/
  - kernel/native/argus/
  - kernel/native/crypto/
  - kernel/native/sig/
  - tests/gates/omega-kernel-native-net.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-native-net"]
expects:
  exit: 0
  observe: ["not_run_in_log == false"]
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine

# CUDA compatibility bridge moved from CUDApp compat/cuda/ (bridge/cuda/): the gate is seeded Omega (bridge/cuda/gate.om).
# It replays CUDApp's compat/cuda/test.sh with the Omega profile checker (c0_check.om) and the Omega fixture writer
# (fixture.om) and requires the transcript to equal bridge/cuda/test-sh-84b524ca.txt, with a mutant-checker control.
# The oracle tier (old test.sh and gcc builds against the Omega stub) runs when BRIDGE_CUDA_CUDAPP and
# BRIDGE_CUDA_OLDOMC are set. Host only; it opens no device, and the device run stays NOT_RUN.
gate: BRIDGE-CUDA
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - bridge/cuda/
  - gpu/nvidia/om/cache/digest.om
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-bridge-cuda.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["bridge-cuda"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

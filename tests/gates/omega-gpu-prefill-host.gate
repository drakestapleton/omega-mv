# tests/gates/omega-gpu-prefill-host.gate
# REQUIRED. First-party prefill host-only proofs (omega #456, reshaped by omega-mv#1032 after the 2026-11-06 review REJECT, Linear DRA-127):
# make test-gpu-prefill-host-fp (3 first-party tests: tc/qmma probes --host-only, pf_mem --host-only; host model, no device).
# No third-party model weights, no downloads, no device. The model-shape cases and the OWN-30B build are in omega-gpu-prefill-modelshapes.gate.
gate: OMEGA-GPU-PREFILL-HOST
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - Makefile
  - mk/
  - src/
  - tests/
  - tools/
  - physics.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["gpu-prefill-host"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine

# tests/gates/omega-gpu-prefill-host.gate
# Prefill host/sim proofs and the decode-profile -Werror build (omega #456): make test-gpu-prefill-host (8 prefill tests: tc/qmma probes --host-only, tcgemm, pattn, pf_mem, pfgemm, qgemm, pfhost --sim) and make check-own30b-decode-profile. No device.
gate: OMEGA-GPU-PREFILL-HOST
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - Makefile
  - mk/
  - src/
  - tests/
  - tools/
  - physics.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["gpu-prefill-host"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine

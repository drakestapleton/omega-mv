# tests/gates/omega-kernel-gate-wiring.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Every gate aienux had (its 25 manifests) and every step of kernel/tests/gates/run.sh has a
# tests/gates/omega-kernel-<step>.gate that reaches it through tests/gates/run.sh kernel-<step>, or a
# row with its reason in kernel/MIGRATION.md ("Aienux gates without a manifest"), never both; and
# .aien/always keeps aienux's always-run gates. Static, seconds: kernel/scripts/omega_gate_wiring.sh
# --self-test, which then requires each of its mutant controls (a removed, renamed or miswired
# manifest, a shadowing root arm, a dropped always line, ...) and each secret planted under kernel/
# for omega-mv's zero-disk-secrets step to FAIL. Always-run: a removed manifest changes no kernel path.
gate: OMEGA-KERNEL-GATE-WIRING
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - tests/gates/
  - kernel/tests/gates/run.sh
  - kernel/MIGRATION.md
  - kernel/scripts/omega_gate_wiring.sh
  - .aien/always
run:
  exec: tests/gates/run.sh
  args: ["kernel-gate-wiring"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable
# It also reads the list of tracked paths (every manifest input must name one), which no input covers.
cache: never

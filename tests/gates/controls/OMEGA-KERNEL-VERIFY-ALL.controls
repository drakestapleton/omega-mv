# tests/gates/controls/OMEGA-KERNEL-VERIFY-ALL.controls: controls the OMEGA-KERNEL-VERIFY-ALL step must report as
# "CONTROL OMEGA-KERNEL-VERIFY-ALL/<name> FAILED_AS_REQUIRED" (kernel/scripts/lib_verify_summary.sh --self-test and kernel/scripts/swtpm_start.sh --self-test, both run by kernel/scripts/verify_all.sh); tests/gates/run.sh step_verdict fails the step
# when one is missing, and tools/gate_claims_lint.sh accepts [ctl:OMEGA-KERNEL-VERIFY-ALL/<name>] for a name listed here.
summary-skip-exit-3
summary-strict-skip-exit-1
summary-child-exit-3
summary-child-exit-1-stops
swtpm-other-error
swtpm-busy-25-pairs
swtpm-slow-7s
swtpm-data-port-only
swtpm-absent-not-run

# Omega si layer units (si/units.tsv): the gate is seeded Omega (si/units-gate.om). It composes every unit and compiles it
# twice with the committed seed/out/omc, requiring exit 0, empty stderr and identical bytes, with a wrong-compiler
# control; then it runs every unit named in si/units-run.tsv on the host CPU (exit 0, empty stderr, the recorded
# last stdout line), with a same-length wrong-line control. not_run rows are printed NOT_RUN and never count as a
# pass. Host only; it opens no device, and no hardware unit has a run row.
gate: OMEGA-SI-UNITS
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - si/
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-si-units.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["si-units"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

# SPIR-V CPU OpenCL parity and negative controls; requires spirv-val and configured PoCL. Not physical GPU qualification.
gate: OMEGA-IRSPIRV
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - seed/spirv/
  - seed/wasm/
  - seed/omc/
  - seed/out/
  - tests/one_layer/omegese/dev/
  - tests/gates/omega-irspirv.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["irspirv"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

# tests/gates/omega-kernel-spinlock.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# The compiled order of native/kernel core/spinlock.h (both lock forms, every lock site of core/pipe.c)
# checked from aarch64 and x86-64 disassembly with its dump mutants (make spinlock-asm-check), and the
# Lean model proofs/TicketLock.lean checked by proofs/check.sh (syntax allowlist proofs/TicketLock.syntax,
# compile, leanchecker kernel replay, axioms of every constant, every constant and statement pinned in
# proofs/TicketLock.pins) with its bad-edit controls (make ticketlock-proof): kernel/tests/gates/run.sh
# spinlock. Tools: aarch64-linux-gnu-gcc and aarch64-linux-gnu-objdump (or the host gcc/objdump on an
# aarch64 host with CROSS empty), x86_64-linux-gnu-gcc and x86_64-linux-gnu-objdump (X86_CROSS), and
# lean with leanchecker from the elan toolchain proofs/lean-toolchain pins (leanprover/lean4:v4.35.0).
# When lean is not on PATH the step uses ${ELAN_HOME:-$HOME/.elan}/bin (a shell started by ssh lacks it).
# NOT_RUN, exit 3, without those tools; proofs/lean-toolchain is the pin, listed so a toolchain move
# invalidates a cached PASS. Hardware NOT_RUN.
gate: OMEGA-KERNEL-SPINLOCK
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/kernel/
  - kernel/native/kernel/proofs/lean-toolchain
  - kernel/tools/ck_spinlock_asm_check.sh
  - kernel/tests/gates/
  - tests/gates/omega-kernel-spinlock.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-spinlock"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

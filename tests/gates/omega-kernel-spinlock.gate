# tests/gates/omega-kernel-spinlock.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# The compiled order of native/kernel core/spinlock.h (both lock forms, every lock site of core/pipe.c)
# checked from aarch64 and x86-64 disassembly with its dump mutants (make spinlock-asm-check), and the
# Lean model proofs/TicketLock.lean checked for sorry/admit/native_decide and non-standard axioms with
# its bad-edit controls (make ticketlock-proof): kernel/tests/gates/run.sh spinlock. NOT_RUN, exit 3,
# without the cross compilers or the lean that proofs/lean-toolchain pins; that file is the pin, listed
# so a toolchain move invalidates a cached PASS. Hardware NOT_RUN.
gate: OMEGA-KERNEL-SPINLOCK
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/kernel/
  - kernel/native/kernel/proofs/lean-toolchain
  - kernel/tools/ck_spinlock_asm_check.sh
  - kernel/tests/gates/
  - tests/gates/omega-kernel-spinlock.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-spinlock"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

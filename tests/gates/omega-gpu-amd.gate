# AMD gfx942 back end (gpu/amd): the gate is seeded Omega (gpu/amd/gate.om). It builds every unit twice with
# the committed seed/out/omc, checks the receipt-recorded bytes of gpu/amd/card.tsv and the loader check of each
# object, and runs wrong-compiler, changed-table and missing-table controls. Host only; it opens no device,
# and every AMD hardware row stays NOT_RUN.
gate: OMEGA-GPU-AMD
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - gpu/
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-gpu-amd.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["gpu-amd"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

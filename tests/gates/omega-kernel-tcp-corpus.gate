# tests/gates/omega-kernel-tcp-corpus.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-TCP-CORPUS: the native TCP stack in seeded Omega against its hostile corpus (exact-state
# cases plus 2,000,000 seeded mutated frames), built with this repository's seed/out/omc. No QEMU.
gate: OMEGA-KERNEL-TCP-CORPUS
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/net/tcp/
  - kernel/tests/gates/
  - seed/out/
  - tests/gates/omega-kernel-tcp-corpus.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-tcp-corpus"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine

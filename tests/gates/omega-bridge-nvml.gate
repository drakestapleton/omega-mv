# NVML library slice (bridge/nvml/), one slice of CUDApp compat/: the gate is seeded Omega (bridge/nvml/gate.om).
# libnvidia-ml.c, nvml.h and libnvidia-ml.map are derived files listed in bridge/nvml/derived.tsv: the gate checks
# the table, the source digests and that the source compiles, with a changed-pin control. The emitter tier
# (BRIDGE_NVML_TOC: omega-bridge src/toc.om paths) regenerates the files and requires the pinned digests, with
# source and generator controls; the oracle tier (BRIDGE_NVML_CUDAPP) compares CUDApp's committed files.
# Host only; it opens no device, and the library build and device run are not part of it.
gate: BRIDGE-NVML
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - bridge/nvml/
  - gpu/nvidia/native/nvml/api.om
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-bridge-nvml.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["bridge-nvml"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

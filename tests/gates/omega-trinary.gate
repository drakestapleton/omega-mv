# tests/gates/omega-trinary.gate
# T-002 trit/codebook signal tools (tools/trit, tools/codebook): both binaries built by the committed seed/out/omc, fixture suites,
# codebook mutants, the regression for the trit mutation driver, the trit mutation matrix, the Lean differential and the Lean proofs.
# Host only, no device, no network. No hosted mirror: local gate only.
gate: OMEGA-TRINARY
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - tools/trit/
  - tools/codebook/
  - seed/out/omc
  - seed/out/omc.sha256
  - seed/trace/sha256.om
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["trinary"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

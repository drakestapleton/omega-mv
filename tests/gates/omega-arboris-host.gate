gate: OMEGA-ARBORIS-HOST
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - protocol/omnet/om/ed25519/ed25519.om
  - protocol/omnet/om/sha512/sha512.om
  - om/
  - seed/
  - gpu/nvidia/native/nvrm/context.om
  - gpu/nvidia/native/share/share.om
  - gpu/nvidia/native/arboris/
  - gpu/nvidia/native/blackwell/vector.om
  - gpu/nvidia/native/blackwell/launch.om
  - gpu/nvidia/om/numeric/
  - gpu/nvidia/om/codegen/bw_hazard.om
  - src/
  - mk/
  - Makefile
  - NOTICE
  - tests/arboris/
  - tests/arboris_arena_test.om
  - tests/arboris_spread_test.om
  - tests/arboris_gated_test.om
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["arboris"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine

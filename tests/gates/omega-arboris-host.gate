gate: OMEGA-ARBORIS-HOST
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - om/
  - seed/
  - gpu/nvidia/om/numeric/
  - src/
  - mk/
  - Makefile
  - NOTICE
  - physics.lock
  - tests/arboris/
  - tests/arboris_arena_test.om
  - tests/arboris_spread_test.om
  - tests/arboris_gated_test.om
  - tests/bw_hazard_test.c
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["arboris"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine

# tests/gates/omega-kernel-native-argus.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-NATIVE-ARGUS, unchanged: kernel/tests/gates/run.sh native-argus, reached from the
# omega-mv root as tests/gates/run.sh kernel-native-argus. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly native-suites.yml matrix suite argus: make -C native/argus plus explicit pass markers, no NOT_RUN (hosted 87 s)
gate: OMEGA-KERNEL-NATIVE-ARGUS
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/argus/
  - kernel/tests/gates/
  - kernel/native/capability/
  - tests/gates/omega-kernel-native-argus.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-native-argus"]
expects:
  exit: 0
  observe: ["not_run_in_log == false"]
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine

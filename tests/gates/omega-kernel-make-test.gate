# tests/gates/omega-kernel-make-test.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# native/kernel's make test (host unit tests of the C kernel and its mutants), run from the omega-mv
# root. Formerly part of aienux AIENOS-CK-HOST-TESTS. A check inside make test that prints NOT_RUN makes
# the step NOT_RUN, exit 3 (never PASS): the GB10 GSP pins need the 580.173.02 open-gpu-kernel-modules
# tree at OGKM_DIR (default ~/workspace/_ext/open-gpu-kernel-modules-580.173.02; its src/nvidia/generated
# holds the GB10B bindata, GSP_BINDATA_DIR) and the firmware GSP_FW_FILE
# (/lib/firmware/nvidia/580.173.02/gsp_ga10x.bin). Those inputs are outside the repository, so this
# manifest's input digests do not cover them.
gate: OMEGA-KERNEL-MAKE-TEST
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/
  - kernel/crates/
  - kernel/Cargo.toml
  - kernel/Cargo.lock
  - kernel/.cargo/
  - kernel/vendor/
  - tests/gates/omega-kernel-make-test.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-make-test"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

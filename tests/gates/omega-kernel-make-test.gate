# tests/gates/omega-kernel-make-test.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# native/kernel's make test (host unit tests of the C kernel and its mutants), run from the omega-mv
# root. Formerly part of aienux AIENOS-CK-HOST-TESTS.
gate: OMEGA-KERNEL-MAKE-TEST
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/
  - kernel/crates/
  - kernel/Cargo.toml
  - kernel/Cargo.lock
  - kernel/.cargo/
  - kernel/vendor/
  - tests/gates/omega-kernel-make-test.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-make-test"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

# tests/gates/omega-gate-claims.gate
# CA1 of the RCCA of the aienux fold (2026-11-18): in the tracked text under kernel/, tools/ and
# tests/gates/ (Markdown and text files, and comments of shell, make, manifest, C and Lean files), a
# sentence about a gate or check with every/any/all/never/cannot/only must cite a control,
# [ctl:<GATE-ID>/<name>], that tests/gates/controls/<GATE-ID>.controls lists for a gate that has a
# manifest here [ctl:OMEGA-GATE-CLAIMS/uncited-claim] [ctl:OMEGA-GATE-CLAIMS/unlisted-control]. The root runner fails a kernel step whose run does not print
# "CONTROL GATE-ID/control-name FAILED_AS_REQUIRED" for each control its .controls file lists.
# Sentences present at the fold's third review head are listed in tools/gate-claims-baseline.txt.
# tools/gate_claims_lint.sh first runs its own planted controls, then the lint.
# Always-run: a claim can be added to any file.
gate: OMEGA-GATE-CLAIMS
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - tools/gate_claims_lint.sh
  - tools/gate-claims-baseline.txt
  - tests/gates/
  - kernel/
  - tools/
run:
  exec: tests/gates/run.sh
  args: ["gate-claims"]
expects:
  exit: 0
  observe: ["gate_claims_uncited == 0"]
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: portable
# It reads the list of tracked paths, which no input covers.
cache: never

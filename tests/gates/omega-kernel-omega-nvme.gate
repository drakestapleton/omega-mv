# tests/gates/omega-kernel-omega-nvme.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-OMEGA-NVME: the bounded read-only NVMe protocol in seeded Omega against the C driver
# oracle (host cases, guard-removal mutants, disposable QEMU), built with this repository's seed/out/omc.
# Physical NVMe is NOT_RUN.
gate: OMEGA-KERNEL-OMEGA-NVME
manifest_version: 2
owner: omega
requires:
  - host
  - qemu
inputs:
  - kernel/native/disk/
  - kernel/tests/gates/
  - seed/out/
  - tests/gates/omega-kernel-omega-nvme.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-omega-nvme"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine

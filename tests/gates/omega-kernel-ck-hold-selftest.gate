# tests/gates/omega-kernel-ck-hold-selftest.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-CK-HOLD-SELFTEST, unchanged: kernel/tests/gates/run.sh ck-hold-selftest, reached from the
# omega-mv root as tests/gates/run.sh kernel-ck-hold-selftest. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly ck-kernel.yml 'Gate hold self-test' (aienos#278): bash scripts/gate_hold_selftest.sh
gate: OMEGA-KERNEL-CK-HOLD-SELFTEST
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/kernel/
  - kernel/scripts/ck_gates.sh
  - kernel/scripts/lib_ck_m1_checks.sh
  - kernel/scripts/lib_gate_hold.sh
  - kernel/scripts/gate_hold_selftest.sh
  - kernel/scripts/ck_owner_keys_check.sh
  - kernel/crates/aienos-fpu-probe/
  - kernel/crates/aienos-infer-kernel/
  - kernel/tests/gates/
  - tests/gates/omega-kernel-ck-hold-selftest.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-ck-hold-selftest"]
expects:
  exit: 0
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine

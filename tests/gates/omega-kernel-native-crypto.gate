# tests/gates/omega-kernel-native-crypto.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-NATIVE-CRYPTO, unchanged: kernel/tests/gates/run.sh native-crypto, reached from the
# omega-mv root as tests/gates/run.sh kernel-native-crypto. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly native-suites.yml matrix suite crypto: make -C native/crypto plus explicit pass markers, no NOT_RUN (hosted 19 s)
gate: OMEGA-KERNEL-NATIVE-CRYPTO
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/crypto/
  - kernel/tests/gates/
  - kernel/native/argus/
  - tests/gates/omega-kernel-native-crypto.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-native-crypto"]
expects:
  exit: 0
  observe: ["not_run_in_log == false"]
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine

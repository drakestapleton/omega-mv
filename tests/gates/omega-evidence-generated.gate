# tests/gates/omega-evidence-generated.gate
# No hosted job (DRA-485 RCCA, 2026-11-17): generated blocks in changed evidence/ and docs/ Markdown equal their generators
# (tools/evidence_generated_check.sh, which runs its own negative controls first); base origin/main or AIEN_BASE_REF.
# requires: host (git history and a base ref), always-run.
gate: OMEGA-EVIDENCE-GENERATED
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - evidence/
  - docs/
  - tools/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["evidence-generated"]
expects:
  exit: 0
  observe: ["generated_mismatches == 0"]
  verdict: PASS
timeout: 2m
exactness: EXACT
cache_scope: portable
cache: never

# tests/gates/omega-kernel-infer-forward.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-INFER-FORWARD, but a missing model is NOT_RUN, exit 3 (2026-11-18): kernel/tests/gates/run.sh infer-forward, reached from the
# omega-mv root as tests/gates/run.sh kernel-infer-forward. Inputs are aienux's, under kernel/. Its aienux manifest:
# Not hosted (the hosted runner has no model file): release-build Llama forward comparisons against llama.cpp
# (crates/aienos-infer/tests/forward.rs) with the real model; FAILS if the model is missing or any test SKIPs
# (measured 2026-10-16 on the Spark: 178 s test wall, release build warm; timeout 15m leaves room for a cold build)
gate: OMEGA-KERNEL-INFER-FORWARD
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/crates/aienos-infer/
  - kernel/Cargo.toml
  - kernel/Cargo.lock
  - kernel/tests/gates/
  - kernel/crates/
  - kernel/.cargo/
  - kernel/vendor/
  - tests/gates/omega-kernel-infer-forward.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-infer-forward"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine

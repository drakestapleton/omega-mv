# tests/gates/omega-kernel-verify-all.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-VERIFY-ALL, unchanged: kernel/tests/gates/run.sh verify-all, reached from the
# omega-mv root as tests/gates/run.sh kernel-verify-all. Inputs are aienux's, under kernel/. Its aienux manifest:
# Timeout 60m: with its own cold target/ the full harness took 1591 s (26.5 min) on the Spark on 2026-10-19.
# Mirrors hosted: ci.yml (disabled_manually on GitHub) 'bash scripts/verify_all.sh' (verification harness + QEMU boot test); declared, not an active hosted job
gate: OMEGA-KERNEL-VERIFY-ALL
manifest_version: 2
owner: omega
requires:
  - qemu
inputs:
  - kernel/scripts/verify_all.sh
  - kernel/crates/
  - kernel/native/boot/
  - kernel/tests/gates/
  - kernel/scripts/
  - kernel/evidence/
  - kernel/native/kernel/tests/fixtures/
  - kernel/Cargo.toml
  - kernel/Cargo.lock
  - kernel/.cargo/
  - kernel/vendor/
  - kernel/docs/adr/0015-golden-vectors.json
  - tests/gates/omega-kernel-verify-all.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-verify-all"]
expects:
  exit: 0
  verdict: PASS
timeout: 60m
exactness: EXACT
cache_scope: machine

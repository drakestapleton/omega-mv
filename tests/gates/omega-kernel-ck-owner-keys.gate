# tests/gates/omega-kernel-ck-owner-keys.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-CK-OWNER-KEYS, unchanged: kernel/tests/gates/run.sh ck-owner-keys, reached from the
# omega-mv root as tests/gates/run.sh kernel-ck-owner-keys. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly ck-kernel.yml 'Hardware staging image refuses TEST keys (build only)': bash scripts/ck_owner_keys_check.sh with quiet flag and gate lock in a temp dir
gate: OMEGA-KERNEL-CK-OWNER-KEYS
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/kernel/
  - kernel/scripts/ck_gates.sh
  - kernel/scripts/lib_ck_m1_checks.sh
  - kernel/scripts/lib_gate_hold.sh
  - kernel/scripts/gate_hold_selftest.sh
  - kernel/scripts/ck_owner_keys_check.sh
  - kernel/crates/aienos-fpu-probe/
  - kernel/crates/aienos-infer-kernel/
  - kernel/tests/gates/
  - kernel/scripts/
  - kernel/native/
  - tests/gates/omega-kernel-ck-owner-keys.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-ck-owner-keys"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

# AMD leftovers (gpu/amd/rest): the gate is seeded Omega (gpu/amd/rest/gate.om). It checks the Omega writer's
# section bytes against the LLVM 18 table, replays the recorded launcher, writer, KFD and plan-file verdicts of
# CUDApp's old C/Python checkers against the Omega-built binaries, and runs its controls. Host only; it opens no
# device, and every AMD hardware row stays NOT_RUN. It runs the AArch64 launcher natively and the x86-64 one under
# /usr/bin/qemu-x86_64; without that program, or on a host with /dev/kfd, it exits 3 (NOT_RUN) with the reason.
gate: OMEGA-GPU-AMD-REST
manifest_version: 2
owner: omega
requires:
  - host
  - aarch64
inputs:
  - gpu/
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-gpu-amd-rest.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["gpu-amd-rest"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

# tests/gates/omega-kernel-ck-qemu-gates.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-CK-QEMU-GATES, unchanged: kernel/tests/gates/run.sh ck-qemu-gates, reached from the
# omega-mv root as tests/gates/run.sh kernel-ck-qemu-gates. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly ck-kernel.yml 'QEMU TCG gates': bash scripts/ck_gates.sh --out DIR, every C-implemented gate except FPU/INFER must print AIENOS_CK_<G>: PASS (hosted job 2340 s total)
# Then the self-contained iMac-kernel QEMU tests (allen_memory, imac_bootdisk, imac_swap, imac_kernel, imac_keyboard,
# boot_show, gpu_bench, local_tools, allen_code recorded mode); each counts only when it exits 0 and prints its PASS line.
# Timeout: the whole step measured 4140 s on the Spark (2026-11-05, 10 cores at nice 19); 1.5x that is 6210 s = 103.5 min,
# rounded up to 105m.
gate: OMEGA-KERNEL-CK-QEMU-GATES
manifest_version: 2
owner: omega
requires:
  - qemu
inputs:
  - kernel/native/kernel/
  - kernel/native/argus/
  - kernel/native/boot/
  - kernel/native/net/
  - kernel/native/sig/
  - kernel/scripts/ck_gates.sh
  - kernel/scripts/lib_ck_m1_checks.sh
  - kernel/scripts/lib_gate_hold.sh
  - kernel/scripts/gate_hold_selftest.sh
  - kernel/scripts/ck_owner_keys_check.sh
  - kernel/crates/aienos-fpu-probe/
  - kernel/crates/aienos-infer-kernel/
  - kernel/tests/gates/
  - kernel/scripts/
  - kernel/native/
  - kernel/crates/
  - kernel/Cargo.toml
  - kernel/Cargo.lock
  - kernel/.cargo/
  - kernel/vendor/
  - tests/gates/omega-kernel-ck-qemu-gates.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-ck-qemu-gates"]
expects:
  exit: 0
  observe: ["required_gates_pass >= 1", "scripts_fail == 0"]
  verdict: PASS
timeout: 105m
exactness: EXACT
cache_scope: machine

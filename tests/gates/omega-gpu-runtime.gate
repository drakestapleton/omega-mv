# One slice of the work on CUDApp src/ (the C runtime), in gpu/runtime/: the gate is seeded Omega (gpu/runtime/gate.om). It rebuilds
# the inventory of CUDApp src/ (gpu/runtime/inventory.om) and requires gpu/runtime/INVENTORY.tsv byte for byte, runs
# every Omega rewrite's check (gpu/runtime/checks.tsv) against the output of the old C, and requires every control
# (a mutant per check, an altered inventory input per gpu/runtime/controls.tsv, a wrong compiler) to be caught.
# Host only; it opens no device, and every hardware row stays NOT_RUN.
gate: OMEGA-GPU-RUNTIME
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - gpu/
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-gpu-runtime.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["gpu-runtime"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

# tests/gates/omega-kernel-disk-qemu.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-DISK-QEMU, unchanged: kernel/tests/gates/run.sh disk-qemu, reached from the
# omega-mv root as tests/gates/run.sh kernel-disk-qemu. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly native-suites.yml 'native/disk qemu NVMe payload': bash scripts/qemu_native_nvme_test.sh, AIENOS_STORE_NVME_QEMU: PASS required (hosted 27 s)
gate: OMEGA-KERNEL-DISK-QEMU
manifest_version: 2
owner: omega
requires:
  - qemu
inputs:
  - kernel/native/disk/
  - kernel/scripts/qemu_native_nvme_test.sh
  - kernel/scripts/lib_gate_hold.sh
  - kernel/tests/gates/
  - kernel/scripts/qemu_native_sdhci_test.sh
  - tests/gates/omega-kernel-disk-qemu.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-disk-qemu"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine

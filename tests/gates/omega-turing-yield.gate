# tests/gates/omega-turing-yield.gate
# Mirrors hosted: turing-yield.yml portable-boundaries: make test-turing-yield test-turing-energy (hosted 22 s)
# plus test-turing-range-om (L111: the Omega TCR1 coder against the C reference, built with seed/out/omc,
# and the Lean proof of its length bound, docs/turing/proofs/TcrBound.lean).
gate: OMEGA-TURING-YIELD
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - Makefile
  - mk/
  - src/turing/
  - tests/turing/
  - tools/turing_yield.c
  - tools/r15_reduce.c
  - tools/
  - src/
  - tests/gates/
  - seed/out/omc
  - seed/ng/sha256.om
  - calibration/experiments/EXP-001/candidates/
  - evidence/TURING_YIELD/ty2_candidate.tym
  - docs/turing/proofs/
run:
  exec: tests/gates/run.sh
  args: ["turing-yield"]
expects:
  exit: 0
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine

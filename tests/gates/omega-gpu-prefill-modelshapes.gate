# tests/gates/omega-gpu-prefill-modelshapes.gate
# OPTIONAL lane, not required (omega-mv#1032): the prefill cases sized for outside model families. make test-gpu-prefill-modelshapes
# (tcgemm, qgemm: Qwen3.8-27B widths; pattn, pfgemm, pfhost: Qwen3-30B-A3B shapes; each --host-only and --sim) and make check-own30b-decode-profile (the OWN-30B -Werror build).
# requires: operator, the same opt-in as omega-numeric-transc-full.gate: it is Blocked (OPERATOR_STEP_PENDING) without --operator, like OMEGA-NUMERIC-TRANSC-FULL.
# Host only, synthetic data, no weights read, no device.
gate: OMEGA-GPU-PREFILL-MODELSHAPES
manifest_version: 2
owner: omega
requires:
  - host
  - operator
inputs:
  - Makefile
  - mk/
  - src/
  - tests/
  - tools/
  - physics.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["gpu-prefill-modelshapes"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine

# tests/gates/omega-kernel-ck-host-tests.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-CK-HOST-TESTS, unchanged: kernel/tests/gates/run.sh ck-host-tests (native/kernel make
# test sanitize, then the iMac host scripts; each counts only when it exits 0 and prints its PASS line).
gate: OMEGA-KERNEL-CK-HOST-TESTS
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/
  - tests/gates/omega-kernel-ck-host-tests.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-ck-host-tests"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

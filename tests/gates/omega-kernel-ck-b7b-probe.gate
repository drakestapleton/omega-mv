# tests/gates/omega-kernel-ck-b7b-probe.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-CK-B7B-PROBE, unchanged: kernel/tests/gates/run.sh ck-b7b-probe, reached from the
# omega-mv root as tests/gates/run.sh kernel-ck-b7b-probe. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly ck-kernel.yml 'B7b preparation probe' (aienos#286): scripts/qemu_ck_b7b_probe_test.sh --self-test, plain, --positive; DRA-19 adds --events (#469 SMMU stream-ownership fault check)
gate: OMEGA-KERNEL-CK-B7B-PROBE
manifest_version: 2
owner: omega
requires:
  - qemu
inputs:
  - kernel/native/kernel/
  - kernel/scripts/ck_gates.sh
  - kernel/scripts/lib_ck_m1_checks.sh
  - kernel/scripts/lib_gate_hold.sh
  - kernel/scripts/gate_hold_selftest.sh
  - kernel/scripts/ck_owner_keys_check.sh
  - kernel/crates/aienos-fpu-probe/
  - kernel/crates/aienos-infer-kernel/
  - kernel/tests/gates/
  - kernel/scripts/
  - kernel/native/
  - tests/gates/omega-kernel-ck-b7b-probe.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-ck-b7b-probe"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

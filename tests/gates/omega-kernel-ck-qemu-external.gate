# tests/gates/omega-kernel-ck-qemu-external.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-CK-QEMU-EXTERNAL, but a missing input is NOT_RUN, exit 3 (2026-11-18): kernel/tests/gates/run.sh ck-qemu-external, reached from the
# omega-mv root as tests/gates/run.sh kernel-ck-qemu-external. Inputs are aienux's, under kernel/. Its aienux manifest:
# Not hosted: iMac-kernel QEMU tests that need outside inputs (qemu_ck_allen_courier, qemu_ck_allen_wizard,
# qemu_ck_local_model). Needs ALLEN_MODEL (host:port of a model server answering /health, no default),
# LOCAL_MODEL_WEIGHTS and LOCAL_MODEL_TOKENIZER (pinned stories15M.bin and tokenizer.bin); FAILS when any
# is missing or any script prints anything but its PASS line (NOT_RUN is a FAIL here)
gate: OMEGA-KERNEL-CK-QEMU-EXTERNAL
manifest_version: 2
owner: omega
requires:
  - qemu
inputs:
  - kernel/native/kernel/
  - kernel/native/argus/
  - kernel/native/net/
  - kernel/native/sig/
  - kernel/scripts/qemu_ck_allen_courier_test.sh
  - kernel/scripts/qemu_ck_allen_wizard_test.sh
  - kernel/scripts/qemu_ck_local_model_test.sh
  - kernel/scripts/lib_gate_hold.sh
  - kernel/crates/allen-courier/
  - kernel/tests/gates/
  - kernel/Cargo.toml
  - kernel/Cargo.lock
  - kernel/.cargo/
  - kernel/vendor/
  - tests/gates/omega-kernel-ck-qemu-external.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-ck-qemu-external"]
expects:
  exit: 0
  observe: ["inputs_missing == 0", "scripts_fail == 0"]
  verdict: PASS
timeout: 120m
exactness: EXACT
cache_scope: machine

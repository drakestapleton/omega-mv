# tests/gates/omega-kernel-native-m5.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-NATIVE-M5, unchanged: kernel/tests/gates/run.sh native-m5, reached from the
# omega-mv root as tests/gates/run.sh kernel-native-m5. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly native-suites.yml matrix suite m5: make -C native/m5 plus explicit pass markers, no NOT_RUN (hosted 149 s)
gate: OMEGA-KERNEL-NATIVE-M5
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/m5/
  - kernel/tests/gates/
  - kernel/native/argus/
  - kernel/native/crypto/
  - kernel/native/sig/
  - tests/gates/omega-kernel-native-m5.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-native-m5"]
expects:
  exit: 0
  observe: ["not_run_in_log == false"]
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine

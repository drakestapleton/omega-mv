# tests/gates/omega-kernel-native-sig.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-NATIVE-SIG, unchanged: kernel/tests/gates/run.sh native-sig, reached from the
# omega-mv root as tests/gates/run.sh kernel-native-sig. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly native-suites.yml matrix suite sig: make -C native/sig plus explicit pass markers, no NOT_RUN (hosted 76 s)
gate: OMEGA-KERNEL-NATIVE-SIG
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/sig/
  - kernel/tests/gates/
  - tests/gates/omega-kernel-native-sig.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-native-sig"]
expects:
  exit: 0
  observe: ["not_run_in_log == false"]
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine

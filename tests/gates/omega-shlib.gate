# Omega-built AArch64 shared libraries (bridge/shlib): the generator bridge/shlib/shlib.om and the gate
# bridge/shlib/gate.om are seeded Omega. The gate builds the test library and libnvidia-ml.so.1 (stub bodies) from
# omc object-mode output, loads each through the system's dynamic loader with an Omega-written probe, checks a
# second build is byte-identical, and requires five controls to be caught (malformed row, missing export, broken
# hash table, wrong expectation, unbalanced stack). Host only; it opens no device.
gate: OMEGA-SHLIB
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - bridge/shlib/
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-shlib.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["shlib"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

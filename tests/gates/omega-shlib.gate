# Omega-built AArch64 shared libraries (bridge/shlib): the generator bridge/shlib/shlib.om and the gate
# bridge/shlib/gate.om are seeded Omega. The gate builds the test library, an import library and its dependency,
# the Omega RM fake transport, libomega-ampere-qmd.so.1 and libnvidia-ml.so.1 (real bodies over gpu/nvidia/native/nvml) from omc object-mode
# output, loads each through the system's dynamic loader with an Omega-written probe, reads each through its
# section headers with /usr/bin/readelf (a read-only oracle: soname, needed libraries and exports), checks the stack
# probe and register save words in the wrappers, checks a second build is byte-identical, and requires each of
# its controls (listed in gate.om's header) to be caught; run.sh pins the summary line.
# Host only; it opens no device.
gate: OMEGA-SHLIB
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - bridge/shlib/
  - gpu/nvidia/native/nvml/
  - gpu/nvidia/om/encoder/amp_runtime.om
  - gpu/nvidia/om/encoder/amp_qmd.om
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-shlib.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["shlib"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

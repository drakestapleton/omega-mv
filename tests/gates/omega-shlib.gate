# Omega-built AArch64 shared libraries (bridge/shlib): the generator bridge/shlib/shlib.om and the gate
# bridge/shlib/gate.om are seeded Omega. The gate builds the test library and libnvidia-ml.so.1 (stub bodies) from
# omc object-mode output, loads each through the system's dynamic loader with an Omega-written probe, reads each
# through its section headers with /usr/bin/readelf (a read-only oracle, soname and exports), checks the stack
# probe words in the wrappers, checks a second build is byte-identical, and requires thirteen controls to be
# caught (malformed row, missing export, broken hash table, wrong expectation, unbalanced stack, missing word,
# byte or halfword extension, wrong x or d register restore, a runtime entry other than the trap, a wrong stack
# need, a misaligned function address).
# Host only; it opens no device.
gate: OMEGA-SHLIB
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - bridge/shlib/
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-shlib.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["shlib"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

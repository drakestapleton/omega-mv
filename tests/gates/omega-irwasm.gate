# WebAssembly host parity, v7 execution and negative controls; requires Node.
gate: OMEGA-IRWASM
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - seed/wasm/
  - seed/omc/
  - seed/out/
  - tests/one_layer/omegese/dev/
  - tests/gates/omega-irwasm.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["irwasm"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

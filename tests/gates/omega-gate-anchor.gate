# tests/gates/omega-gate-anchor.gate
# CA2 of the RCCA of the aienux fold (2026-11-18): the gate-integrity files listed in
# tools/gate-anchors.txt (gate scripts, pin files, count pins, control lists, allowlists) must not
# change against the base (AIEN_BASE_REF, default origin/main; merge-base with HEAD, plus the index and
# work tree) unless AIEN_GATE_ANCHOR_ACK names exactly the changed set. A change prints one
# GATE-ANCHOR CHANGED line per path and GATE-ANCHOR BLOCKED_OPERATOR, exit 1; no history or no base
# is NOT_RUN, exit 3. tools/gate_anchor.sh also runs the base ref's copy of itself when that differs.
# Always-run: an edit to a gate file changes no path a gate's inputs would select.
gate: OMEGA-GATE-ANCHOR
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - tools/gate_anchor.sh
  - tools/gate-anchors.txt
  - tests/gates/omega-gate-anchor.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["gate-anchor"]
expects:
  exit: 0
  observe: ["gate_anchor_changed == 0"]
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable
# It reads git history and the base ref, which no input covers.
cache: never

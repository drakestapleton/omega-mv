# The gate of the Omega checks in gpu/nvidia/checks/, one slice of porting CUDApp tests/ and tools/ to Omega (not
# the whole port; gpu/nvidia/checks/INVENTORY.tsv counts what is still open). The gate is seeded Omega
# (gpu/nvidia/checks/gate.om). It composes every check of gpu/nvidia/checks/checks.tsv (the gpu/ Omega units under
# test, the shared table reader, the check), compiles it twice with the committed seed/out/omc, runs it on its
# table of expected values taken from the old implementation, and requires a one-byte change of that table, every
# source mutant of gpu/nvidia/checks/mutants.tsv and a wrong compiler each to make it fail. It also requires
# gpu/nvidia/checks/INVENTORY.tsv to say what gpu/nvidia/checks/ports.tsv says and to name only gpu/ files of this
# tree. Host only; it opens no device, and every hardware tier stays NOT_RUN.
gate: OMEGA-GPU-CHECKS
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - gpu/
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-gpu-checks.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["gpu-checks"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

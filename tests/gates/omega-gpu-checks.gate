# Behaviour checks that replace the C, Python and shell of CUDApp tests/ and tools/ (gpu/nvidia/checks/): the gate
# is seeded Omega (gpu/nvidia/checks/gate.om). It composes every check of gpu/nvidia/checks/checks.tsv (the gpu/
# Omega units under test, the shared table reader, the check), compiles it twice with the committed seed/out/omc,
# runs it on its table of expected values taken from the old implementation, and requires a one-byte change of that
# table, every source mutant of gpu/nvidia/checks/mutants.tsv and a wrong compiler each to make it fail. It also
# requires gpu/nvidia/checks/INVENTORY.tsv to say what gpu/nvidia/checks/ports.tsv says. Host only; it opens no
# device, and every hardware tier stays NOT_RUN.
gate: OMEGA-GPU-CHECKS
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - gpu/
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-gpu-checks.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["gpu-checks"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

# tests/gates/omega-kernel-hw-gates.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-HW-GATES: the hardware-gate register checked by the seeded Omega tools/hwgates/hwgates.om,
# built with this repository's seed/out/omc (checked against seed/out/omc.sha256); without it exit 3.
gate: OMEGA-KERNEL-HW-GATES
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/
  - seed/out/
  - tests/gates/omega-kernel-hw-gates.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-hw-gates"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: machine

# Omega driver-client logic moved from CUDApp nvrm/ and m16/ (gpu/nvidia/driver/): the gate is seeded Omega
# (gpu/nvidia/driver/gate.om). It recomputes every case the C oracle printed (gpu/nvidia/driver/oracle-cases.tsv) with
# card.om, diag.om and m16.om, and runs one changed-answer control per case kind, which must be caught. Host only; it
# opens no device, and every hardware tier stays NOT_RUN.
gate: OMEGA-GPU-DRIVER
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - gpu/nvidia/driver/
  - gpu/nvidia/native/nvrm/counts.om
  - gpu/nvidia/om/encoder/amp_runtime.om
  - seed/out/
  - tests/gates/omega-gpu-driver.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["gpu-driver"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

# One slice of the CUDApp merge: new Omega for part of the C decision logic of CUDApp nvrm/ and m16/ (gpu/nvidia/driver/). The gate is seeded Omega
# (gpu/nvidia/driver/gate.om). It recomputes every case the C oracle printed (gpu/nvidia/driver/oracle-cases.tsv) with
# card.om, diag.om, m16.om, nvrm.om and eng.om's fcls, and runs one changed-answer control per case kind, which must be caught. Its second part,
# gpu/nvidia/driver/seqgate.om, runs the setup and teardown ported to client.om (with native/nvrm/policy.om) against the command sequences
# the C oracle recorded (gpu/nvidia/driver/seq-cases.tsv), with two controls per program. Host only; it
# opens no device, and every hardware tier stays NOT_RUN.
gate: OMEGA-GPU-DRIVER
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - gpu/nvidia/driver/
  - gpu/nvidia/native/nvrm/counts.om
  - gpu/nvidia/native/nvrm/policy.om
  - gpu/nvidia/om/encoder/amp_runtime.om
  - gpu/nvidia/om/engine/fixture_rest.om
  - gpu/nvidia/om/engine/eng.om
  - seed/out/
  - tests/gates/omega-gpu-driver.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["gpu-driver"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

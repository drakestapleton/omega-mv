# tests/gates/omega-kernel-native-disk.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-NATIVE-DISK, unchanged: kernel/tests/gates/run.sh native-disk, reached from the
# omega-mv root as tests/gates/run.sh kernel-native-disk. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly native-suites.yml matrix suite disk: make -C native/disk plus explicit pass markers, no NOT_RUN (hosted 185 s)
gate: OMEGA-KERNEL-NATIVE-DISK
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/disk/
  - kernel/tests/gates/
  - tests/gates/omega-kernel-native-disk.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-native-disk"]
expects:
  exit: 0
  observe: ["not_run_in_log == false"]
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine

# Omega GPU units moved from CUDApp om/ and backend/ (gpu/units.tsv): the gate is seeded Omega
# (gpu/units-gate.om). It composes every unit as CUDApp om/units.sh does and compiles it twice with the committed
# seed/out/omc, requiring exit 0, empty stderr and identical bytes, with a wrong-compiler control. Host only; it opens
# no device and runs no unit, and every hardware row stays NOT_RUN.
gate: OMEGA-GPU-UNITS
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - gpu/
  - seed/out/
  - seed/ng/sha256.om
  - tests/gates/omega-gpu-units.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["gpu-units"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

# tests/gates/omega-kernel-store-native.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-STORE-NATIVE, unchanged: kernel/tests/gates/run.sh store-native, reached from the
# omega-mv root as tests/gates/run.sh kernel-store-native. Inputs are aienux's, under kernel/. Its aienux manifest:
# Hosted: none (ci.yml was disabled, then removed in #427). Formerly ci.yml 'make -C native/store test mutants'; not covered by any active workflow
gate: OMEGA-KERNEL-STORE-NATIVE
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/store/
  - kernel/tests/gates/
  - kernel/native/argus/
  - kernel/native/crypto/
  - kernel/native/disk/
  - kernel/native/m5/
  - kernel/docs/adr/0015-golden-vectors.json
  - tests/gates/omega-kernel-store-native.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-store-native"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine

# tests/gates/omega-kernel-store-native.gate
# Aienux, folded into kernel/ (Drake 2026-11-17, kernel/MIGRATION.md).
# Aienux AIENOS-STORE-NATIVE: kernel/tests/gates/run.sh store-native, reached from the omega-mv root as
# tests/gates/run.sh kernel-store-native. Since 2026-11-18 the step builds the Rust aienos-store-tool
# first (cargo, offline, from kernel/vendor/), so make test's C -> Rust cross-check runs on a fresh
# clone; a cross-check that does not run makes the step NOT_RUN, exit 3 (review of omega-mv
# 5cd0af98f, WiringRun finding 2). Its aienux manifest:
# Hosted: none (ci.yml was disabled, then removed in #427). Formerly ci.yml 'make -C native/store test mutants'; not covered by any active workflow
gate: OMEGA-KERNEL-STORE-NATIVE
manifest_version: 2
owner: omega
requires:
  - host
inputs:
  - kernel/native/store/
  - kernel/crates/aienos-store-tool/
  - kernel/Cargo.toml
  - kernel/Cargo.lock
  - kernel/.cargo/
  - kernel/vendor/
  - kernel/tests/gates/
  - kernel/native/argus/
  - kernel/native/crypto/
  - kernel/native/disk/
  - kernel/native/m5/
  - kernel/docs/adr/0015-golden-vectors.json
  - tests/gates/omega-kernel-store-native.gate
  - tests/gates/run.sh
run:
  exec: tests/gates/run.sh
  args: ["kernel-store-native"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine

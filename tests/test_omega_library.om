note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit & C-oracle parity test for src/omega_library.om.
om2

text lib_empty_gold "9a3930e99b9231960c63e3fd4cdc2c76559864d9455f029184ab4fe1d9d08ac2"
text lib_p1_gold "7c75598907f59c370b8d503afb82c1183451e5177661120c4e2986ec43c99bc8"
text lib_adv_gold "10024eb3781000640fd114ee78b3938899c902b02c40dda24de9d13bc4573e31"
text lib_p2_gold "0fd957bb22c7ec2eef83a244c3b0b8a3864cf43553021879b3eabc4b494aa521"
text nm_a "prog_a"
text nm_b "prog_b"
text nm_c "prog_c"
text msg_pass "OMEGA_LIBRARY_OM_PASS\n"
text msg_fail "OMEGA_LIBRARY_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_dig gold view uchar * to void
  d = new uchar 32 0
  for i ulong 32
    put d i get g_lib_digest i
  end
  for i ulong 32
    b = uint get d i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn fill_seq dst edit uchar 32 base ulong to void
  for i ulong 32
    put dst i uchar add base i
  end
end

fn test_library_all to void
  chk eq omega_library_init 0
  chk eq get g_lib_ver 0 1
  chk eq get g_lib_cnt 0 0
  chk_dig lib_empty_gold

  p1 = new uchar 32 0
  r1 = new uchar 32 0
  rcpt1 = new uchar 32 0
  z32 = new uchar 32 0
  fill_seq p1 0x10
  fill_seq r1 0x40
  fill_seq rcpt1 0x80

  note Negative controls (VC1 fail-closed guards)
  lib_stage_name nm_a 6
  lib_stage_deps z32 0
  lib_stage_ids p1 r1 rcpt1
  lib_stage_meta 0 1 3 64 3 64
  chk eq omega_library_insert -1
  lib_stage_meta 1 0 3 64 3 64
  chk eq omega_library_insert -1
  lib_stage_meta 1 1 3 64 3 64
  lib_stage_ids z32 r1 rcpt1
  chk eq omega_library_insert -1
  lib_stage_ids p1 r1 z32
  chk eq omega_library_insert -1
  chk eq omega_library_insert_bootstrap -1
  chk eq get g_lib_cnt 0 0

  note Verified insert of prog_a
  lib_stage_ids p1 r1 rcpt1
  chk eq omega_library_insert 0
  chk eq get g_lib_cnt 0 1
  chk_dig lib_p1_gold

  note Duplicate refusal
  chk eq omega_library_insert -1

  note Advance version
  chk eq omega_library_advance_version 0
  chk eq get g_lib_ver 0 2
  chk_dig lib_adv_gold

  note Bootstrap insert of prog_b depending on prog_a
  p2 = new uchar 32 0
  r2 = new uchar 32 0
  rcpt2 = new uchar 32 0
  fill_seq p2 0x20
  fill_seq r2 0x50
  fill_seq rcpt2 0xa0
  lib_stage_name nm_b 6
  lib_stage_ids p2 r2 rcpt2
  lib_stage_deps p1 1
  chk eq omega_library_insert_bootstrap 0
  chk eq get g_lib_cnt 0 2
  chk_dig lib_p2_gold

  note Unknown dependency refused
  p3 = new uchar 32 0
  fill_seq p3 0x30
  lib_stage_name nm_c 6
  lib_stage_ids p3 r2 rcpt2
  lib_stage_deps p3 1
  chk eq omega_library_insert -1

  note Lookups and queries
  chk eq omega_library_find_by_id p1 0
  chk eq omega_library_find_by_id p2 1
  chk eq omega_library_find_by_realization_id r1 0
  chk eq omega_library_find_by_realization_id r2 1
  chk eq omega_library_find_by_name nm_a 6 0
  chk eq omega_library_find_by_name nm_b 6 1
  chk eq omega_library_find_by_name nm_c 6 -1

  chk eq omega_library_query_by_type 3 64 3 64 8 2
  chk eq get g_lib_qres 0 0
  chk eq get g_lib_qres 1 1
  chk eq omega_library_query_by_type 4 64 3 64 8 0

  note Cycle detection: p1 -> p2 would form p1 -> p2 -> p1
  chk omega_library_has_cycle p1 p2 1
  chk not omega_library_has_cycle p3 p2 1

  note Export primitives
  chk eq omega_library_export_primitives 0
  chk eq get g_lib_exp_cnt 0 2

  omega_library_destroy
  chk eq get g_lib_cnt 0 0
end

fn main to int
  test_library_all
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

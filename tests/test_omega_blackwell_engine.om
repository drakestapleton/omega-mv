note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/test_omega_blackwell_engine.c.
note Host-only tests of src/omega_blackwell_engine.om and src/omega_blackwell_submit.om:
note   - Page rounding, cbank filling, pushbuffer packet emission (setup, DMA, inline,
note     release/WFI, L2 flush), backend/persist/run_info state, and zero-CUDA checks.
note Strictly CPU-only, zero /dev/nvidia* access.
om2

text bwe_pass "test_omega_blackwell_engine: PASS\n"
text bwe_fail "test_omega_blackwell_engine: FAIL\n"

global g_bwe_chk ulong 1
global g_bwe_fail ulong 1

fn bwe_chk cond bool to void
  put g_bwe_chk 0 add get g_bwe_chk 0 1
  if not cond
    put g_bwe_fail 0 add get g_bwe_fail 0 1
  end
end

fn test_round_and_cbank to void
  bwe_chk eq obwe_round_pages 0 0
  bwe_chk eq obwe_round_pages 1 4096
  bwe_chk eq obwe_round_pages 4096 4096
  bwe_chk eq obwe_round_pages 4097 8192
  bwe_chk eq obwe_round_pages 8192 8192

  cb = new uint 224 0
  va = ulong 0x0000123456789000
  obwe_fill_cbank cb va
  note Verify cbank populated non-zero control words
  nz = ulong 0
  for i ulong 224
    if ne get cb i 0
      nz = add nz 1
    end
  end
  bwe_chk gt nz 0
end

fn test_pushbuffer_packets to void
  put obwe_pb_len 0 0
  obwe_emit_setup
  n1 = get obwe_pb_len 0
  bwe_chk gt n1 0

  obwe_emit_dma ulong 0x0000000100000000 16
  n2 = get obwe_pb_len 0
  bwe_chk gt n2 n1

  q = new uint 96 0
  for i ulong 96
    put q i uint add 0x1000 i
  end
  obwe_emit_inline ulong 0x0000000200000000 q
  n3 = get obwe_pb_len 0
  bwe_chk ge sub n3 n2 96

  obwe_emit_rel ulong 0x0000000300000000 uint 0x44444444
  n4 = get obwe_pb_len 0
  bwe_chk gt n4 n3

  obwe_emit_l2_flush
  n5 = get obwe_pb_len 0
  bwe_chk gt n5 n4
end

fn test_backend_and_zero_cuda to void
  bwe_chk eq obwe_device_is_open 0
  bwe_chk eq obwe_shutdown 0
  bwe_chk eq obwe_backend OGE_BACKEND_BLACKWELL
  info = new ulong 5 0
  obwe_run_info info
  bwe_chk eq get info 0 0

  note Zero-CUDA static ELF & runtime invariants
  bwe_chk eq obws_verify_zero_libcuda_linkage 0
  bwe_chk eq obws_verify_zero_cuda_symbols 0
  bwe_chk eq obws_verify_zero_libcuda_runtime 0
end

fn main to int
  test_round_and_cbank
  test_pushbuffer_packets
  test_backend_and_zero_cuda
  if eq get g_bwe_fail 0 0
    ign = write 1 bwe_pass 0 len bwe_pass
    ret 0
  end
  ign = write 1 bwe_fail 0 len bwe_fail
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit/parity test for src/omega_verify.om.
om2

text msg_pass "OMEGA_VERIFY_OM_PASS\n"
text msg_fail "OMEGA_VERIFY_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn put_code_u32_le off ulong w ulong to void
  put g_ver_real_code off uchar and w 255
  put g_ver_real_code add off 1 uchar and shr w 8 255
  put g_ver_real_code add off 2 uchar and shr w 16 255
  put g_ver_real_code add off 3 uchar and shr w 24 255
end

fn setup_valid_real to void
  put g_ver_has_graph 0 1
  put g_ver_graph_ok 0 1
  put g_ver_graph_objs 0 5
  put g_ver_has_real 0 1
  put g_ver_real_prof 0 1
  put g_ver_real_clen 0 12
  put g_ver_real_has_id 0 1
  put g_ver_real_has_mach 0 0
  for i ulong 32
    put g_ver_real_sem_id i uchar add i 1
    put g_ver_real_mach_id i uchar add i 33
  end
  note ADD X0, X0, X1; SUB X0, X0, X2; RET
  put_code_u32_le 0 ulong 0x8b010000
  put_code_u32_le 4 ulong 0xcb020000
  put_code_u32_le 8 ulong 0xd65f03c0
  rid = new uchar 32 0
  chk eq ver_hash_real_id_g rid 0
  for i ulong 32
    put g_ver_real_id i get rid i
  end
end

fn test_v0_v1_v2_and_pipeline to void
  setup_valid_real

  note V0 structural pass (graph + real)
  chk eq omega_verify_v0_structural 0
  chk eq get g_ver_passed 0 1
  chk eq get g_ver_tier 0 VERIFY_TIER_V0
  chk eq get g_ver_checks 0 6
  chk eq get g_ver_fails 0 0

  note V0 negative: bad graph
  put g_ver_graph_ok 0 0
  chk eq omega_verify_v0_structural -1
  chk eq get g_ver_err_code 0 VER_ERR_GRAPH_INVALID
  put g_ver_graph_ok 0 1

  note V0 negative: empty graph
  put g_ver_graph_objs 0 0
  chk eq omega_verify_v0_structural -1
  chk eq get g_ver_err_code 0 VER_ERR_GRAPH_EMPTY
  put g_ver_graph_objs 0 5

  note V0 negative: bad profile
  put g_ver_real_prof 0 9
  chk eq omega_verify_v0_structural -1
  chk eq get g_ver_err_code 0 VER_ERR_REAL_PROFILE
  put g_ver_real_prof 0 1

  note V0 negative: bad code bounds
  put g_ver_real_clen 0 3
  chk eq omega_verify_v0_structural -1
  chk eq get g_ver_err_code 0 VER_ERR_REAL_BOUNDS
  put g_ver_real_clen 0 12

  note V0 negative: missing id
  put g_ver_real_has_id 0 0
  chk eq omega_verify_v0_structural -1
  chk eq get g_ver_err_code 0 VER_ERR_REAL_NO_ID
  put g_ver_real_has_id 0 1

  note V0 negative: tampered realization_id
  put g_ver_real_id 0 xor get g_ver_real_id 0 uchar 1
  chk eq omega_verify_v0_structural -1
  chk eq get g_ver_err_code 0 VER_ERR_REAL_ID_MISMATCH
  put g_ver_real_id 0 xor get g_ver_real_id 0 uchar 1

  note V0 triple ID pass
  put g_ver_real_has_mach 0 1
  tid = new uchar 32 0
  chk eq ver_hash_triple_id_g tid 0
  for i ulong 32
    put g_ver_real_id i get tid i
  end
  chk eq omega_verify_v0_structural 0
  setup_valid_real

  note V1 differential pass (7 default vectors)
  dummy = new ulong 3 0
  chk eq omega_verify_v1_differential 0 dummy 0 0
  chk eq get g_ver_passed 0 1
  chk eq get g_ver_tier 0 VERIFY_TIER_V1
  chk eq get g_ver_checks 0 13

  note V1 differential pass (custom vectors)
  custom = new ulong 6 0
  put custom 0 42
  put custom 1 58
  put custom 2 10
  put custom 3 ulong 0xffffffffffffffff
  put custom 4 5
  put custom 5 4
  chk eq omega_verify_v1_differential 1 custom 2 0
  chk eq get g_ver_passed 0 1

  note V1 negative: wrong code (ADD X0, X0, X1; ADD X0, X0, X2; RET)
  put_code_u32_le 4 ulong 0x8b020000
  bid = new uchar 32 0
  chk eq ver_hash_real_id_g bid 0
  for i ulong 32
    put g_ver_real_id i get bid i
  end
  chk eq omega_verify_v1_differential 0 dummy 0 -1
  chk eq get g_ver_err_code 0 VER_ERR_V1_MISMATCH
  setup_valid_real

  note V2 properties pass (399 checks)
  chk eq omega_verify_v2_properties 0
  chk eq get g_ver_passed 0 1
  chk eq get g_ver_tier 0 VERIFY_TIER_V2
  chk eq get g_ver_checks 0 399

  note Pipeline up to V2
  chk eq omega_verify_pipeline VERIFY_TIER_V2 0
  chk eq get g_ver_passed 0 1
  chk eq get g_ver_tier 0 VERIFY_TIER_V2
  chk eq get g_ver_checks 0 399
end

fn main to int
  test_v0_v1_v2_and_pipeline
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

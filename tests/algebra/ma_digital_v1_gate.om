fn dv_build_mine to void
  p = ulong 0
  for qi ulong DV_NQ
    put dv_mine p uchar 81
    p = add p 1
    put dv_mine p uchar add 49 qi
    p = add p 1
    put dv_mine p uchar 32
    p = add p 1
    db = mul qi 32
    for i ulong 32
      v = ulong get dv_dec_dig add db i
      hi = shr v 4
      lo = and v 15
      if lt hi 10
        put dv_mine p uchar add 48 hi
      else
        put dv_mine p uchar add 87 hi
      end
      p = add p 1
      if lt lo 10
        put dv_mine p uchar add 48 lo
      else
        put dv_mine p uchar add 87 lo
      end
      p = add p 1
    end
    put dv_mine p uchar 10
    p = add p 1
  end
  put dv_minel 0 p
end

fn dv_repro_append_txt s view uchar * to void
  m = len s
  for i ulong m bound 128
    l = get dv_repro_jl 0
    if lt l 1024
      put dv_repro_j l get s i
      put dv_repro_jl 0 add l 1
    end
  end
end

fn dv_repro_append_b c uchar to void
  l = get dv_repro_jl 0
  if lt l 1024
    put dv_repro_j l c
    put dv_repro_jl 0 add l 1
  end
end

fn dv_cmp_file_mine path view uchar * pl ulong to ulong
  fd = fopen path 0 pl SEL_O_RDONLY 0
  if lt fd 0
    ret 0
  end
  rb = new uchar 512 0
  k = read int fd rb 0 512
  ign_l = fclose int fd
  if ne k long get dv_minel 0
    ret 0
  end
  for i2 ulong ulong k bound 512
    if ne get rb i2 get dv_mine i2
      ret 0
    end
  end
  ret 1
end

fn dv_check_one_repro lstart ulong eqp ulong endp ulong nfiles ulong to ulong
  path = new uchar 256 0
  pl = sub endp add eqp 1
  if gt pl 255
    pl = 255
  end
  for i1 ulong pl bound 256
    put path i1 get dv_evb add add eqp 1 i1
  end
  same = dv_cmp_file_mine path pl
  if gt nfiles 0
    dv_repro_append_txt t_dj_sep
  end
  dv_repro_append_b uchar 34
  for i3 ulong sub eqp lstart bound 128
    dv_repro_append_b get dv_evb add lstart i3
  end
  dv_repro_append_b uchar 34
  dv_repro_append_b uchar 58
  dv_repro_append_b uchar 32
  dv_repro_append_b uchar 34
  if ne same 0
    dv_repro_append_txt t_dv_ident
  else
    dv_repro_append_txt t_dv_differs
    put dv_repro_all 0 0
    dv_add_fail t_dv_f_repro
  end
  dv_repro_append_b uchar 34
  ret same
end

fn dv_check_repro_files to void
  put dv_repro_jl 0 0
  put dv_repro_all 0 1
  if eq dv_getenv t_dv_e_repro 0
    put dv_repro_all 0 0
    dv_add_fail t_dv_f_repro
    ret
  end
  n = get dv_evl 0
  p = ulong 0
  nf = ulong 0
  while lt p n bound 64
    while lt p n bound 2048
      if ne get dv_evb p uchar 32
        break
      end
      p = add p 1
    end
    if ge p n
      break
    end
    st = p
    eqp = ulong 0
    has_eq = ulong 0
    while lt p n bound 2048
      c = get dv_evb p
      if eq c uchar 32
        break
      end
      if and eq has_eq 0 eq c uchar 61
        eqp = p
        has_eq = 1
      end
      p = add p 1
    end
    if ne has_eq 0
      ign = dv_check_one_repro st eqp p nf
      nf = add nf 1
    end
  end
  if lt nf 2
    put dv_repro_all 0 0
    dv_add_fail t_dv_f_repro
  end
end

fn dv_check_expected_one st ulong eqp ulong endp ulong to int
  pl = sub eqp st
  hl = sub endp add eqp 1
  if ne hl 64
    ret -1
  end
  path = new uchar 256 0
  if gt pl 255
    ret -1
  end
  for i1 ulong pl bound 256
    put path i1 get dv_evb add st i1
  end
  if ne dv_file_sha256_buf path pl DV_SLOT_REH 0
    ret -1
  end
  for i2 ulong 64
    if ne get sel_sh_hex i2 get dv_evb add add eqp 1 i2
      ret -1
    end
  end
  ret 0
end

fn dv_check_expected to int
  if eq dv_getenv t_dv_e_exp 0
    ret 0
  end
  n = get dv_evl 0
  if eq n 0
    ret 0
  end
  p = ulong 0
  while lt p n bound 32
    while lt p n bound 2048
      if ne get dv_evb p uchar 32
        break
      end
      p = add p 1
    end
    if ge p n
      break
    end
    st = p
    eqp = ulong 0
    has_eq = ulong 0
    while lt p n bound 2048
      c = get dv_evb p
      if eq c uchar 32
        break
      end
      if and eq has_eq 0 eq c uchar 61
        eqp = p
        has_eq = 1
      end
      p = add p 1
    end
    if eq has_eq 0
      ret -1
    end
    if ne dv_check_expected_one st eqp p 0
      ret -1
    end
  end
  ret 0
end

fn dv_write_query_json qi ulong to void
  ch = get dv_dec_chosen qi
  rb = mul qi 10
  run = long -1
  for k ulong SEL_RZ_COUNT
    rr = get dv_dec_reason add rb k
    if and le rr DV_R_TIED ne long k ch
      if lt run 0
        run = long k
      else
        if lt get dv_dec_cost add rb k get dv_dec_cost add rb ulong run
          run = long k
        end
      end
    end
  end
  c1 = -1.0f64
  c2 = -1.0f64
  if ge ch 0
    c1 = dv_rcpt_cost 0 ulong ch 0 get dv_dec_cn qi get dv_dec_cm qi get dv_dec_pack qi
    c2 = dv_rcpt_cost 0 ulong ch 1 get dv_dec_cn qi get dv_dec_cm qi get dv_dec_pack qi
  end
  rdiff = -1.0f64
  if and gt c1 0.0f64 gt c2 0.0f64
    if gt c1 c2
      rdiff = sub div c1 c2 1.0f64
    else
      rdiff = sub div c2 c1 1.0f64
    end
  end
  sel_o_txt t_dv_q1
  dv_o_qid qi
  sel_o_txt t_dv_q2
  dv_o_qsh qi
  sel_o_txt t_dv_q3
  sel_o_u64 dv_q_n qi
  sel_o_txt t_dv_q4
  sel_o_u64 dv_q_m qi
  sel_o_txt t_dv_q5
  if ne dv_q_pack qi 0
    sel_o_txt t_dv_pk_pc
  else
    sel_o_txt t_dv_pk_once
  end
  sel_o_txt t_dv_q6
  dv_o_dec_hex qi
  sel_o_txt t_dv_q7
  if ge ch 0
    sel_o_txt t_dv_v_CHOSEN
  else
    sel_o_txt t_dv_v_NONE
  end
  sel_o_txt t_dv_q8
  if ne get dv_dec_exact qi 0
    sel_o_txt t_dv_c_ex
  else
    sel_o_txt t_dv_c_nr
  end
  sel_o_txt t_dv_q9
  sel_o_u64 get dv_dec_cn qi
  sel_o_txt t_dv_q10
  sel_o_u64 get dv_dec_cm qi
  sel_o_txt t_dv_q11
  if ge ch 0
    sel_rz_print ulong ch
  else
    sel_o_txt t_dv_v_none
  end
  sel_o_txt t_dv_q12
  if ge ch 0
    dv_o_fam ulong ch
  else
    sel_o_txt t_dv_v_none
  end
  sel_o_txt t_dv_q13
  if ge run 0
    sel_rz_print ulong run
  else
    sel_o_txt t_dv_v_none
  end
  sel_o_txt t_dv_q14
  sel_o_f64 div f64 get dv_dec_mppm qi 10000.0f64 2
  sel_o_txt t_dv_q15
  sel_o_f64 div f64 get dv_dec_bppm qi 10000.0f64 2
  sel_o_txt t_dv_q16
  if le get dv_dec_mppm qi get dv_dec_bppm qi
    sel_o_txt t_sel_true
  else
    sel_o_txt t_sel_false
  end
  sel_o_txt t_dv_q17
  sel_o_f64 div c1 1000.0f64 3
  sel_o_txt t_dv_q18
  sel_o_f64 div c2 1000.0f64 3
  sel_o_txt t_dv_q19
  sel_o_f64 mul rdiff 100.0f64 2
  sel_o_txt t_dv_q20
  sel_o_u64 get dv_dec_ncite qi
  sel_o_txt t_dv_q21
  sel_o_txt t_sel_true
  sel_o_txt t_dv_q22
  if ne get dv_dec_repro_in qi 0
    sel_o_txt t_sel_true
  else
    sel_o_txt t_sel_false
  end
  sel_o_txt t_dv_q23
  dv_o_dec_hex add 12 qi
  sel_o_txt t_dv_q24
  chc = get dv_dec_chosen add 12 qi
  if ge chc 0
    sel_rz_print ulong chc
  else
    sel_o_txt t_dv_v_none
  end
  sel_o_txt t_dv_q25
  if and ge chc 0 and ge ch 0 eq chc ch
    sel_o_txt t_sel_true
  else
    sel_o_txt t_sel_false
  end
  sel_o_txt t_dv_q26
  for k2 ulong SEL_RZ_COUNT
    sel_o_txt t_dv_qc1
    sel_rz_print k2
    sel_o_txt t_dv_qc2
    dv_o_fam k2
    sel_o_txt t_dv_qc3
    dv_o_dig_hex add DV_SLOT_SPEC0 k2
    sel_o_txt t_dv_qc4
    dv_o_rname get dv_dec_reason add rb k2
    sel_o_txt t_dv_qc5
    sel_o_f64 div f64 get dv_dec_cost add rb k2 1000.0f64 3
    sel_o_txt t_dv_qc6
    sel_o_u64 dv_wb_of 0 k2 get dv_dec_cn qi get dv_dec_cm qi
    sel_o_b uchar 125
    if lt add k2 1 SEL_RZ_COUNT
      sel_o_b uchar 44
    end
    sel_o_b uchar 10
  end
  sel_o_txt t_dv_qend
  if lt add qi 1 DV_NQ
    sel_o_b uchar 44
  end
  sel_o_b uchar 10
end

fn dv_emit_ri_json r ulong to void
  sel_o_txt t_dv_ri1
  if lt r 2
    sel_o_txt t_dv_r_prim
  else
    sel_o_txt t_dv_r_cont
  end
  sel_o_txt t_dv_ri2
  sel_o_b uchar 34
  for i1 ulong get dv_ri_plen r bound 256
    sel_o_b get dv_ri_path add mul r 256 i1
  end
  sel_o_b uchar 34
  sel_o_txt t_dv_ri3
  for i2 ulong 64
    sel_o_b get dv_ri_hex add mul r 64 i2
  end
  sel_o_txt t_dv_ri4
  sel_o_b uchar 34
  for i3 ulong get dv_ri_schl r bound 96
    sel_o_b get dv_ri_sch add mul r 96 i3
  end
  sel_o_b uchar 34
  sel_o_txt t_dv_ri5
  sel_o_b uchar 34
  for i4 ulong get dv_ri_ridl r bound 128
    sel_o_b get dv_ri_rid add mul r 128 i4
  end
  sel_o_b uchar 34
  sel_o_txt t_dv_ri6
  sel_o_b uchar 34
  for i5 ulong get dv_ri_coml r bound 48
    sel_o_b get dv_ri_com add mul r 48 i5
  end
  sel_o_b uchar 34
  sel_o_txt t_dv_ri7
  sel_o_b uchar 34
  for i6 ulong get dv_ri_dirl r bound 8
    sel_o_b get dv_ri_dir add mul r 8 i6
  end
  sel_o_b uchar 34
  sel_o_txt t_dv_ri8
  sel_o_b uchar 34
  for i7 ulong get dv_ri_misl r bound 24
    sel_o_b get dv_ri_mis add mul r 24 i7
  end
  sel_o_b uchar 34
  sel_o_b uchar 125
  if lt r 3
    sel_o_b uchar 44
  end
  sel_o_b uchar 10
end

global dv_tmp_path uchar 256

fn dv_emit_lines_from_env key view uchar * check_pass ulong indented ulong to void
  if eq dv_getenv key 0
    ret
  end
  pl = get dv_evl 0
  if gt pl 255
    pl = 255
  end
  for i1 ulong pl bound 256
    put dv_tmp_path i1 get dv_evb i1
  end
  fd = fopen dv_tmp_path 0 pl SEL_O_RDONLY 0
  if lt fd 0
    ret
  end
  put sel_fpos 0 0
  put sel_flen 0 0
  first = ulong 1
  while true bound 4096
    lr = sel_readline int fd
    if lt lr 0
      break
    end
    if eq lr 0
      continue
    end
    if ne check_pass 0
      if not sel_line_pfx t_dv_pass_pfx
        dv_add_fail t_dv_f_corr
      end
    end
    if eq first 0
      if ne indented 0
        sel_o_b uchar 44
        sel_o_b uchar 10
      else
        sel_o_txt t_dj_sep
      end
    end
    first = 0
    if ne indented 0
      sel_o_txt t_dv_ind4
    end
    sel_o_b uchar 34
    for i2 ulong ulong lr bound 4096
      c = get sel_line i2
      if or eq c uchar 34 eq c uchar 92
        sel_o_b uchar 92
        sel_o_b c
      else
        sel_o_b c
      end
    end
    sel_o_b uchar 34
  end
  ign_l = fclose int fd
end

global dv_com_buf uchar 64

fn dv_check_fresh_meta to void
  if eq dv_getenv t_dv_e_dirty 1
    if or ne get dv_evl 0 1 ne get dv_evb 0 uchar 48
      dv_add_fail t_dv_f_dirty
    end
  end
  cl = ulong 0
  if eq dv_getenv t_dv_e_commit 1
    cl = get dv_evl 0
    if gt cl 63
      cl = 63
    end
    for i1 ulong cl bound 64
      put dv_com_buf i1 get dv_evb i1
    end
  end
  for r ulong 2
    if or ne get dv_ri_misl r 1 ne get dv_ri_mis mul r 24 uchar 48
      dv_add_fail t_dv_f_mism
    end
    if ne get dv_ri_coml r cl
      dv_add_fail t_dv_f_com
    else
      for i2 ulong cl bound 48
        if ne get dv_ri_com add mul r 48 i2 get dv_com_buf i2
          dv_add_fail t_dv_f_com
          break
        end
      end
    end
    if ne get dv_ri_dirl r 5
      dv_add_fail t_dv_f_rdir
    end
  end
end

fn dv_dec_dig_eq a ulong b ulong to bool
  for i ulong 32
    if ne get dv_dec_dig add mul a 32 i get dv_dec_dig add mul b 32 i
      ret false
    end
  end
  ret true
end

fn dv_run_one_query qi ulong to ulong
  r1 = dv_field_select 0 qi dv_q_n qi dv_q_m qi dv_q_pack qi
  r2 = dv_field_select 1 add 6 qi dv_q_n qi dv_q_m qi dv_q_pack qi
  ign = dv_field_select 2 add 12 qi dv_q_n qi dv_q_m qi dv_q_pack qi
  put dv_dec_rc qi long r1
  same = ulong 0
  if eq r1 r2
    if dv_dec_dig_eq qi add 6 qi
      same = 1
    end
  end
  put dv_dec_repro_in qi same
  if eq same 0
    dv_add_fail t_dv_f_inproc
  end
  nrej = ulong 0
  for k ulong SEL_RZ_COUNT
    if eq get dv_dec_reason add mul qi 10 k DV_R_MAX_N
      nrej = add nrej 1
    end
  end
  ret nrej
end

fn dv_run_all_queries to ulong
  nrej = ulong 0
  for qi ulong DV_NQ
    nrej = add nrej dv_run_one_query qi
  end
  ret nrej
end

fn dv_ingest_pair s ulong a1 ulong a2 ulong to int
  p = new uchar 256 0
  l1 = argread a1 p 0 256
  if lt l1 0
    ret -1
  end
  if ne dv_ingest_receipt s p ulong l1 0
    ret -1
  end
  l2 = argread a2 p 0 256
  if lt l2 0
    ret -1
  end
  if ne dv_ingest_receipt s p ulong l2 0
    ret -1
  end
  ret 0
end

fn dv_emit_env_jstr key view uchar * to void
  ign = dv_getenv key
  n = get dv_evl 0
  sel_o_b uchar 34
  for i ulong n bound 2048
    c = get dv_evb i
    if or eq c uchar 34 eq c uchar 92
      sel_o_b uchar 92
      sel_o_b c
    else
      sel_o_b c
    end
  end
  sel_o_b uchar 34
end

fn dv_check_req_env to int
  if eq dv_getenv t_dv_e_commit 0
    ret -1
  end
  if eq dv_getenv t_dv_e_dirty 0
    ret -1
  end
  if eq dv_getenv t_dv_e_mode 0
    ret -1
  end
  if eq dv_getenv t_dv_e_runid 0
    ret -1
  end
  if eq dv_getenv t_dv_e_corr 0
    ret -1
  end
  ret 0
end

fn dv_write_receipt_body fd int nrej ulong to void
  sel_o_init fd
  sel_o_txt t_dv_rj1
  dv_emit_env_jstr t_dv_e_commit
  sel_o_txt t_dv_rj2
  ign = dv_getenv t_dv_e_dirty
  if and eq get dv_evl 0 1 eq get dv_evb 0 uchar 48
    sel_o_txt t_sel_false
  else
    sel_o_txt t_sel_true
  end
  sel_o_txt t_dv_rj3
  dv_emit_env_jstr t_dv_e_mode
  sel_o_txt t_dv_rj4
  dv_emit_env_jstr t_dv_e_runid
  sel_o_txt t_dv_rj5
  dv_o_dig_hex DV_SLOT_CON
  sel_o_txt t_dv_rj6
  for r2 ulong 4
    dv_emit_ri_json r2
  end
  sel_o_txt t_dv_corr1
  dv_emit_lines_from_env t_dv_e_corr 1 1
  sel_o_txt t_dv_untr1
  dv_emit_lines_from_env t_dv_e_untr 0 0
  sel_o_txt t_dv_qs1
  for qi ulong DV_NQ
    dv_write_query_json qi
  end
  sel_o_txt t_dv_end1
  sel_o_u64 nrej
  sel_o_txt t_dv_end2
  for i1 ulong get dv_repro_jl 0 bound 1024
    sel_o_b get dv_repro_j i1
  end
  sel_o_txt t_dv_end3
  if ne get dv_repro_all 0 0
    sel_o_txt t_sel_true
  else
    sel_o_txt t_sel_false
  end
  sel_o_txt t_dv_end4
  nf = get dv_nfail 0
  if gt nf 64
    nf = 64
  end
  for f ulong nf bound 64
    if gt f 0
      sel_o_txt t_dj_sep
    end
    sel_o_b uchar 34
    for j ulong get dv_flens f bound 200
      sel_o_b get dv_fails add mul f 200 j
    end
    sel_o_b uchar 34
  end
  sel_o_txt t_dv_end5
  if eq get dv_nfail 0 0
    sel_o_txt t_dv_pass
  else
    sel_o_txt t_dv_fail
  end
  sel_o_txt t_dv_end6
  sel_o_flush
end

fn dv_cmd_receipt to int
  if ne dv_check_req_env 0
    oma_put_err t_dv_err_env
    ret 2
  end
  if ne dv_check_expected 0
    oma_put_err t_dv_err_pin
    ret 2
  end
  if ne dv_ingest_pair 0 3 4 0
    ret 2
  end
  if ne dv_ingest_pair 1 3 4 0
    ret 2
  end
  if ne dv_ingest_pair 2 5 6 0
    ret 2
  end
  for r ulong 4
    if ne dv_load_rinfo r add 3 r 0
      ret 2
    end
  end
  put dv_nfail 0 0
  dv_check_fresh_meta
  nrej = dv_run_all_queries
  dv_build_mine
  dv_check_repro_files
  if ne dv_check_expected 0
    oma_put_err t_dv_err_pin
    ret 2
  end
  opath = new uchar 256 0
  ol = argread ulong 2 opath 0 256
  if lt ol 0
    ret 2
  end
  fd = fopen opath 0 ulong ol DV_O_WRONLY_CREAT_EXCL SEL_MODE_0644
  if lt fd 0
    ret 2
  end
  dv_write_receipt_body int fd nrej
  ign_l = fclose int fd
  sel_o_init 1
  sel_o_txt t_dv_sum1
  if eq get dv_nfail 0 0
    sel_o_txt t_dv_pass
  else
    sel_o_txt t_dv_fail
  end
  sel_o_txt t_dv_sum2
  sel_o_u64 get dv_nfail 0
  sel_o_txt t_dv_sum3
  sel_o_flush
  if eq get dv_nfail 0 0
    ret 0
  end
  ret 3
end

fn main to int
  sel_init
  dv_init_contract_and_specs
  ac = argcnt
  if lt ac 2
    oma_put_err t_dv_usage
    ret 2
  end
  cmd = new uchar 32 0
  cl = argread ulong 1 cmd 0 32
  if lt cl 0
    oma_put_err t_dv_usage
    ret 2
  end
  if and eq ac 4 sel_eq_txt cmd ulong cl t_dv_cmd_dig
    ret dv_cmd_digests
  end
  if and eq ac 7 sel_eq_txt cmd ulong cl t_dv_cmd_rcpt
    ret dv_cmd_receipt
  end
  oma_put_err t_dv_usage
  ret 2
end

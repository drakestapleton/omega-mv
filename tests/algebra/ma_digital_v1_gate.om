note ---- small helpers ----
fn dv_llround x f64 to ulong
  if le x 0.0f64
    ret 0
  end
  ret ulong add x 0.5f64
end

fn dv_dig_cp dst_slot ulong src_slot ulong to void
  db = mul dst_slot 32
  sb = mul src_slot 32
  for i ulong 32
    put dv_dig add db i get dv_dig add sb i
  end
end

fn dv_dig_eq s1 ulong s2 ulong to bool
  b1 = mul s1 32
  b2 = mul s2 32
  for i ulong 32
    if ne get dv_dig add b1 i get dv_dig add b2 i
      ret false
    end
  end
  ret true
end

fn dv_sh_to_slot slot ulong to void
  sel_sh_final
  b = mul slot 32
  for i ulong 32
    put dv_dig add b i get sel_sh_dig i
  end
end

fn dv_file_sha256_buf path view uchar * plen ulong slot ulong to int
  fd = fopen path 0 plen SEL_O_RDONLY 0
  if lt fd 0
    ret -1
  end
  sel_sh_init
  while true bound 100000
    k = read int fd sel_sh_rbuf 0 8192
    if le k 0
      break
    end
    for i ulong ulong k bound 8192
      sel_sh_byte get sel_sh_rbuf i
    end
  end
  ign_l = fclose int fd
  dv_sh_to_slot slot
  ret 0
end

fn dv_o_dig_hex slot ulong to void
  b = mul slot 32
  for i ulong 32
    v = ulong get dv_dig add b i
    hi = shr v 4
    lo = and v 15
    if lt hi 10
      sel_o_b uchar add 48 hi
    else
      sel_o_b uchar add 87 hi
    end
    if lt lo 10
      sel_o_b uchar add 48 lo
    else
      sel_o_b uchar add 87 lo
    end
  end
end

fn dv_tv_clr to void
  put dv_tvl 0 0
end

fn dv_tv_b c uchar to void
  n = get dv_tvl 0
  if lt n 512
    put dv_tv n c
    put dv_tvl 0 add n 1
  end
end

fn dv_tv_txt s view uchar * to void
  m = len s
  for i ulong m bound 512
    dv_tv_b get s i
  end
end

fn dv_tv_u64 v ulong to void
  if eq v 0
    dv_tv_b uchar 48
    ret
  end
  tmp = new uchar 24 0
  cnt = ulong 0
  x = v
  while gt x 0 bound 32
    put tmp cnt uchar add 48 rem x 10
    cnt = add cnt 1
    x = div x 10
  end
  for i ulong cnt bound 32
    dv_tv_b get tmp sub sub cnt 1 i
  end
end

fn dv_tv_dig slot ulong to void
  b = mul slot 32
  for i ulong 32
    v = ulong get dv_dig add b i
    hi = shr v 4
    lo = and v 15
    if lt hi 10
      dv_tv_b uchar add 48 hi
    else
      dv_tv_b uchar add 87 hi
    end
    if lt lo 10
      dv_tv_b uchar add 48 lo
    else
      dv_tv_b uchar add 87 lo
    end
  end
end

fn dv_tv_rz r ulong to void
  if eq r 0
    dv_tv_txt t_rz_0
    ret
  end
  if eq r 1
    dv_tv_txt t_rz_1
    ret
  end
  if eq r 2
    dv_tv_txt t_rz_2
    ret
  end
  if eq r 3
    dv_tv_txt t_rz_3
    ret
  end
  if eq r 4
    dv_tv_txt t_rz_4
    ret
  end
  if eq r 5
    dv_tv_txt t_rz_5
    ret
  end
  if eq r 6
    dv_tv_txt t_rz_6
    ret
  end
  if eq r 7
    dv_tv_txt t_rz_7
    ret
  end
  if eq r 8
    dv_tv_txt t_rz_8
    ret

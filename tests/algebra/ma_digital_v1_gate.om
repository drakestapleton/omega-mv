note ---- OMG0 canonical encoder ----
fn dv_ca_add_tv key view uchar * to void
  na = get dv_ca_n 0
  if ge na 32
    ret
  end
  kl = len key
  ko = mul na 64
  for i1 ulong kl bound 64
    put dv_ca_k add ko i1 get key i1
  end
  put dv_ca_kl na kl
  vl = get dv_tvl 0
  vo = mul na 512
  for i2 ulong vl bound 512
    put dv_ca_v add vo i2 get dv_tv i2
  end
  put dv_ca_vl na vl
  put dv_ca_n 0 add na 1
end

fn dv_ca_reset rec view uchar * to void
  put dv_ca_n 0 0
  put dv_cr_n 0 0
  dv_tv_clr
  dv_tv_txt rec
  dv_ca_add_tv t_dv_k_record
end

fn dv_ca_txt key view uchar * val view uchar * to void
  dv_tv_clr
  dv_tv_txt val
  dv_ca_add_tv key
end

fn dv_ca_u64 key view uchar * v ulong to void
  dv_tv_clr
  dv_tv_u64 v
  dv_ca_add_tv key
end

fn dv_ca_dig key view uchar * slot ulong to void
  dv_tv_clr
  dv_tv_dig slot
  dv_ca_add_tv key
end

fn dv_ca_rel kind ulong slot ulong to void
  nr = get dv_cr_n 0
  if ge nr 16
    ret
  end
  put dv_cr_kind nr kind
  db = mul nr 32
  sb = mul slot 32
  for i ulong 32
    put dv_cr_dig add db i get dv_dig add sb i
  end
  put dv_cr_n 0 add nr 1
end

fn dv_ca_klt a ulong b ulong to bool
  la = get dv_ca_kl a
  lb = get dv_ca_kl b
  m = la
  if lt lb m
    m = lb
  end
  oa = mul a 64
  ob = mul b 64
  for i ulong m bound 64
    ca = get dv_ca_k add oa i
    cb = get dv_ca_k add ob i
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret lt la lb
end

fn dv_ca_rlt a ulong b ulong to bool
  ka = get dv_cr_kind a
  kb = get dv_cr_kind b
  if lt ka kb
    ret true
  end
  if gt ka kb
    ret false
  end
  oa = mul a 32
  ob = mul b 32
  for i ulong 32
    ca = get dv_cr_dig add oa i
    cb = get dv_cr_dig add ob i
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret false
end

fn dv_ca_sort to void
  na = get dv_ca_n 0
  for i1 ulong na bound 32
    put dv_ca_ord i1 i1
  end
  i = ulong 1
  while lt i na bound 32
    key = get dv_ca_ord i
    j = i
    while gt j 0 bound 32
      prev = get dv_ca_ord sub j 1
      if dv_ca_klt key prev
        put dv_ca_ord j prev
        j = sub j 1
      else
        break
      end
    end
    put dv_ca_ord j key
    i = add i 1
  end
  nr = get dv_cr_n 0
  for i2 ulong nr bound 16
    put dv_cr_ord i2 i2
  end
  i = ulong 1
  while lt i nr bound 16
    key = get dv_cr_ord i
    j = i
    while gt j 0 bound 16
      prev = get dv_cr_ord sub j 1
      if dv_ca_rlt key prev
        put dv_cr_ord j prev
        j = sub j 1
      else
        break
      end
    end
    put dv_cr_ord j key
    i = add i 1
  end
end

fn dv_cb_u8 b uchar to void
  n = get dv_clen 0
  if lt n 40000
    put dv_cbuf n b
    put dv_clen 0 add n 1
  end
end

fn dv_cb_u16be v ulong to void
  dv_cb_u8 uchar and shr v 8 255
  dv_cb_u8 uchar and v 255
end

fn dv_cb_u32be v ulong to void
  dv_cb_u8 uchar and shr v 24 255
  dv_cb_u8 uchar and shr v 16 255
  dv_cb_u8 uchar and shr v 8 255
  dv_cb_u8 uchar and v 255
end

fn dv_ca_emit_attr ai ulong to void
  kl = get dv_ca_kl ai
  dv_cb_u8 uchar kl
  ko = mul ai 64
  for j1 ulong kl bound 64
    dv_cb_u8 get dv_ca_k add ko j1
  end
  vl = get dv_ca_vl ai
  dv_cb_u16be vl
  vo = mul ai 512
  for j2 ulong vl bound 512
    dv_cb_u8 get dv_ca_v add vo j2
  end
end

fn dv_ca_emit_rel ri ulong to void
  dv_cb_u16be get dv_cr_kind ri
  ro = mul ri 32
  for j ulong 32
    dv_cb_u8 get dv_cr_dig add ro j
  end
end

fn dv_ca_finish kind ulong dom view uchar * dslot ulong to void
  dv_ca_sort
  put dv_clen 0 0
  dv_cb_u8 uchar 79
  dv_cb_u8 uchar 77
  dv_cb_u8 uchar 71
  dv_cb_u8 uchar 48
  dv_cb_u8 uchar 1
  dv_cb_u8 uchar kind
  na = get dv_ca_n 0
  dv_cb_u16be na
  for i1 ulong na bound 32
    dv_ca_emit_attr get dv_ca_ord i1
  end
  nr = get dv_cr_n 0
  dv_cb_u16be nr
  for i2 ulong nr bound 16
    dv_ca_emit_rel get dv_cr_ord i2
  end
  dv_cb_u16be 0
  dv_cb_u32be 0
  sel_sh_init
  dl = len dom
  for i3 ulong dl bound 64
    sel_sh_byte get dom i3
  end
  sel_sh_byte uchar 0
  cn = get dv_clen 0
  for i4 ulong cn bound 40000
    sel_sh_byte get dv_cbuf i4
  end
  dv_sh_to_slot dslot
end

note ---- Contract & Spec digests ----
fn dv_init_contract_and_specs to void
  dv_ca_reset t_dv_rec_con
  dv_ca_txt t_dv_k_status t_dv_v_c_st
  dv_ca_txt t_dv_k_name t_dv_v_c_nm
  dv_ca_txt t_dv_k_stmt t_dv_v_c_sm
  dv_ca_txt t_dv_k_exactness t_dv_v_c_ex
  dv_ca_txt t_dv_k_overflow t_dv_v_c_ov
  dv_ca_txt t_dv_k_oracle t_dv_v_c_or
  dv_ca_txt t_dv_k_source t_dv_v_c_sr
  dv_ca_u64 t_dv_k_max_n 16777215
  dv_ca_finish DV_KIND_OP t_dv_dom_con DV_SLOT_CON
  for r ulong SEL_RZ_COUNT
    dv_ca_reset t_dv_rec_spec
    dv_ca_dig t_dv_k_contract DV_SLOT_CON
    dv_tv_clr
    dv_tv_rz r
    dv_ca_add_tv t_dv_k_rz_id
    dv_tv_clr
    dv_tv_txt t_dv_v_s_alg1
    dv_tv_rz r
    dv_tv_txt t_dv_v_s_alg2
    dv_ca_add_tv t_dv_k_alg
    if le r 3
      dv_ca_txt t_dv_k_algebra t_dv_alg_bin
      dv_ca_txt t_dv_k_repr t_dv_rep_bin
    else
      if eq r 4
        dv_ca_txt t_dv_k_algebra t_dv_alg_bt
        dv_ca_txt t_dv_k_repr t_dv_rep_bp
      else
        if eq r 5
          dv_ca_txt t_dv_k_algebra t_dv_alg_bt
          dv_ca_txt t_dv_k_repr t_dv_rep_lut
        else
          if eq r 6
            dv_ca_txt t_dv_k_algebra t_dv_alg_bt
            dv_ca_txt t_dv_k_repr t_dv_rep_cr
          else
            if eq r 7
              dv_ca_txt t_dv_k_algebra t_dv_alg_sp
              dv_ca_txt t_dv_k_repr t_dv_rep_sp
            else
              if eq r 8
                dv_ca_txt t_dv_k_algebra t_dv_alg_rns
                dv_ca_txt t_dv_k_repr t_dv_rep_rns
              else
                dv_ca_txt t_dv_k_algebra t_dv_alg_bt
                dv_ca_txt t_dv_k_repr t_dv_rep_d5
              end
            end
          end
        end
      end
    end
    dv_ca_txt t_dv_k_prec t_dv_v_s_prec
    dv_ca_txt t_dv_k_lang t_dv_v_s_lang
    dv_ca_txt t_dv_k_backend t_dv_v_s_back
    dv_ca_txt t_dv_k_mclass t_dv_v_s_mcls
    dv_ca_u64 t_dv_k_max_n sel_rz_max_n r
    dv_ca_u64 t_dv_k_exact 1
    if eq r 0
      dv_ca_u64 t_dv_k_wb 1
    else
      dv_ca_u64 t_dv_k_wb 0
    end
    dv_ca_finish DV_KIND_RZ t_dv_dom_spec add DV_SLOT_SPEC0 r
  end
end

note ---- Receipt ingest into store s (0..2) ----
fn dv_tv_set_rh_rid to void
  dv_tv_clr
  n = get dv_rh_ridl 0
  for i ulong n bound 128
    dv_tv_b get dv_rh_rid i
  end
end

fn dv_tv_set_rh_bin to void
  dv_tv_clr
  n = get dv_rh_binl 0
  for i ulong n bound 72
    dv_tv_b get dv_rh_bin i
  end
end

fn dv_tv_set_rh_com to void
  dv_tv_clr
  n = get dv_rh_coml 0
  for i ulong n bound 64
    dv_tv_b get dv_rh_com i
  end
end

fn dv_tv_set_rh_cc to void
  dv_tv_clr
  n = get dv_rh_ccl 0
  for i ulong n bound 128
    dv_tv_b get dv_rh_cc i
  end
end

fn dv_tv_set_rh_thm to void
  dv_tv_clr
  n = get dv_rh_thml 0
  for i ulong n bound 96
    dv_tv_b get dv_rh_thm i
  end
end

fn dv_hash_ev_row gidx ulong rc_slot ulong to void
  dv_ca_reset t_dv_rec_ev
  dv_ca_dig t_dv_k_spec add DV_SLOT_SPEC0 get dv_ev_spec gidx
  dv_ca_u64 t_dv_k_n get dv_ev_n gidx
  dv_ca_u64 t_dv_k_m get dv_ev_m gidx
  dv_ca_u64 t_dv_k_spm get dv_ev_spm gidx
  dv_ca_dig t_dv_k_rcpt rc_slot
  dv_tv_set_rh_rid
  dv_ca_add_tv t_dv_k_runid
  if ne get dv_ev_tier gidx 0
    dv_ca_txt t_dv_k_tier t_dv_v_e2
  else
    dv_ca_txt t_dv_k_tier t_dv_v_e0
  end
  dv_ca_txt t_dv_k_tiersrc t_dv_v_tiersrc
  dv_ca_u64 t_dv_k_ver get dv_ev_ver gidx
  dv_ca_u64 t_dv_k_forced get dv_ev_forced gidx
  dv_ca_u64 t_dv_k_retries get dv_rh_ev_tmp 0
  dv_ca_u64 t_dv_k_samples get dv_rh_ev_tmp 1
  dv_ca_u64 t_dv_k_medps get dv_ev_med gidx
  dv_ca_u64 t_dv_k_q25ps get dv_rh_ev_tmp 2
  dv_ca_u64 t_dv_k_q75ps get dv_rh_ev_tmp 3
  dv_ca_u64 t_dv_k_minps get dv_rh_ev_tmp 4
  dv_ca_u64 t_dv_k_packps get dv_ev_pk gidx
  dv_ca_u64 t_dv_k_nzppm get dv_ev_nz gidx
  dv_ca_u64 t_dv_k_pnzppm get dv_ev_pnz gidx
  dv_ca_u64 t_dv_k_wbytes get dv_ev_wb gidx
  dv_ca_u64 t_dv_k_wsbytes get dv_rh_ev_tmp 5
  dv_tv_set_rh_bin
  dv_ca_add_tv t_dv_k_bsha
  dv_tv_set_rh_com
  dv_ca_add_tv t_dv_k_commit
  dv_ca_u64 t_dv_k_dirty ulong get dv_rh_dirty 0
  dv_tv_set_rh_cc
  dv_ca_add_tv t_dv_k_tool
  dv_ca_txt t_dv_k_cpuf t_dv_v_cpuf
  dv_ca_txt t_dv_k_qflag t_dv_v_qflag
  dv_tv_set_rh_thm
  dv_ca_add_tv t_dv_k_therm
  dv_ca_finish DV_KIND_EV t_dv_dom_ev DV_SLOT_SCR0
  eb = mul gidx 32
  sb = mul DV_SLOT_SCR0 32
  for i ulong 32
    put dv_ev_dig add eb i get dv_dig add sb i
  end
end

fn dv_parse_hdr_line to void
  tmp = new uchar 128 0
  k = sel_kv_str t_dv_jk_schema tmp 95
  if ge k 0
    for i1 ulong ulong k bound 96
      put dv_rh_sch i1 get tmp i1
    end
    put dv_rh_schl 0 ulong k
  end
  k = sel_kv_str t_sel_k_runid tmp 127
  if ge k 0
    for i2 ulong ulong k bound 128
      put dv_rh_rid i2 get tmp i2
    end
    put dv_rh_ridl 0 ulong k
  end
  k = sel_kv_str t_dv_jk_commit tmp 63
  if ge k 0
    for i3 ulong ulong k bound 64
      put dv_rh_com i3 get tmp i3
    end
    put dv_rh_coml 0 ulong k
  end
  k = sel_kv_str t_dv_jk_bsha tmp 71
  if ge k 0
    for i4 ulong ulong k bound 72
      put dv_rh_bin i4 get tmp i4
    end
    put dv_rh_binl 0 ulong k
  end
  k = sel_kv_str t_dv_jk_cc tmp 127
  if ge k 0
    for i5 ulong ulong k bound 128
      put dv_rh_cc i5 get tmp i5
    end
    put dv_rh_ccl 0 ulong k
  end
  ok = new int 1 0
  if eq sel_kv_bool t_dv_jk_dirty ok 0
    put dv_rh_dirty 0 long get ok 0
  end
  if sel_line_has t_dv_p_host
    t0 = sel_kv_num t_dv_jk_th0 ok
    if ne get ok 0 0
      t1 = sel_kv_num t_dv_jk_th1 ok
      if ne get ok 0 0
        dv_tv_clr
        dv_tv_txt t_dv_soc1
        dv_tv_u64 dv_llround t0
        dv_tv_txt t_dv_soc2
        dv_tv_u64 dv_llround t1
        dv_tv_txt t_dv_soc3
        tl = get dv_tvl 0
        for i6 ulong tl bound 96
          put dv_rh_thm i6 get dv_tv i6
        end
        put dv_rh_thml 0 tl
      end
    end
  end
end

fn dv_parse_ev_nums gidx ulong to int
  ok = new int 1 0
  v = sel_kv_num t_sel_k_n ok
  if eq get ok 0 0
    ret -1
  end
  put dv_ev_n gidx dv_llround v
  v = sel_kv_num t_sel_k_m ok
  if eq get ok 0 0
    ret -1
  end
  put dv_ev_m gidx dv_llround v
  v = sel_kv_num t_sel_k_sp ok
  if eq get ok 0 0
    ret -1
  end
  put dv_ev_spm gidx dv_llround mul v 1000.0f64
  v = sel_kv_num t_dv_jk_forced ok
  if eq get ok 0 0
    ret -1
  end
  put dv_ev_forced gidx dv_llround v
  v = sel_kv_num t_dv_jk_retries ok
  if eq get ok 0 0
    ret -1
  end
  put dv_rh_ev_tmp 0 dv_llround v
  v = sel_kv_num t_dv_jk_samples ok
  if eq get ok 0 0
    ret -1
  end
  put dv_rh_ev_tmp 1 dv_llround v
  v = sel_kv_num t_sel_k_med ok
  if eq get ok 0 0
    ret -1
  end
  put dv_ev_med gidx dv_llround v
  v = sel_kv_num t_dv_jk_q25 ok
  if eq get ok 0 0
    ret -1
  end
  put dv_rh_ev_tmp 2 dv_llround v
  v = sel_kv_num t_dv_jk_q75 ok
  if eq get ok 0 0
    ret -1
  end
  put dv_rh_ev_tmp 3 dv_llround v
  v = sel_kv_num t_sel_k_min ok
  if eq get ok 0 0
    ret -1
  end
  put dv_rh_ev_tmp 4 dv_llround v
  v = sel_kv_num t_sel_k_pk ok
  if eq get ok 0 0
    ret -1
  end
  put dv_ev_pk gidx dv_llround v
  v = sel_kv_num t_sel_k_nz ok
  if eq get ok 0 0
    ret -1
  end
  put dv_ev_nz gidx dv_llround mul v 1.0e6f64
  v = sel_kv_num t_sel_k_pnz ok
  if eq get ok 0 0
    ret -1
  end
  put dv_ev_pnz gidx dv_llround mul v 1.0e6f64
  v = sel_kv_num t_dv_jk_wb ok
  if eq get ok 0 0
    ret -1
  end
  put dv_ev_wb gidx dv_llround v
  v = sel_kv_num t_dv_jk_ws ok
  if eq get ok 0 0
    ret -1
  end
  put dv_rh_ev_tmp 5 dv_llround v
  ret 0
end

fn dv_ingest_row s ulong ridx ulong to int
  nev = get dv_st_nev s
  if ge nev DV_MAX_EV
    ret -1
  end
  rzb = new uchar 32 0
  rzl = sel_kv_str t_sel_k_rz rzb 31
  if lt rzl 0
    ret -1
  end
  spec = sel_rz_find rzb ulong rzl
  if lt spec 0
    ret -1
  end
  vb = new int 1 0
  if ne sel_kv_bool t_sel_k_ver vb 0
    ret -1
  end
  gidx = add mul s DV_MAX_EV nev
  put dv_ev_spec gidx ulong spec
  put dv_ev_ver gidx ulong get vb 0
  put dv_ev_rcpt gidx ridx
  if ne dv_parse_ev_nums gidx 0
    ret -1
  end
  if and eq get dv_rh_mism 0 0 ne get dv_ev_ver gidx 0
    put dv_ev_tier gidx 1
  else
    put dv_ev_tier gidx 0
  end
  dv_hash_ev_row gidx DV_SLOT_SCR1
  put dv_st_nev s add nev 1
  ret 0
end

fn dv_save_rcpt_meta s ulong ridx ulong path view uchar * plen ulong to void
  grec = add mul s 8 ridx
  rb = mul grec 32
  sb = mul DV_SLOT_SCR1 32
  for i2 ulong 32
    put dv_rc_dig add rb i2 get dv_dig add sb i2
  end
  pb = mul grec 256
  for i3 ulong plen bound 256
    put dv_rc_path add pb i3 get path i3
  end
  put dv_rc_plen grec plen
  put dv_st_nrec s add ridx 1
end

fn dv_ingest_receipt s ulong path view uchar * plen ulong to int
  ridx = get dv_st_nrec s
  if ge ridx 8
    ret -1
  end
  if ne dv_file_sha256_buf path plen DV_SLOT_SCR1 0
    ret -1
  end
  fd = fopen path 0 plen SEL_O_RDONLY 0
  if lt fd 0
    ret -1
  end
  put sel_fpos 0 0
  put sel_flen 0 0
  put dv_rh_schl 0 0
  put dv_rh_ridl 0 0
  put dv_rh_coml 0 0
  put dv_rh_binl 0 0
  put dv_rh_ccl 0 0
  put dv_rh_dirty 0 -1
  put dv_rh_mism 0 0
  tl = len t_dv_v_nrec
  for i1 ulong tl bound 32
    put dv_rh_thm i1 get t_dv_v_nrec i1
  end
  put dv_rh_thml 0 tl
  sec = ulong 0
  ok = new int 1 0
  while true bound 50000
    if lt sel_readline int fd 0
      break
    end
    if eq sec 0
      dv_parse_hdr_line
      if sel_line_pfx t_dv_p_rz_sec
        sec = 1
      end
    else
      if eq sec 1
        if sel_line_pfx t_dv_p_rz_end
          sec = 2
        end
      else
        if eq sec 2
          if sel_line_pfx t_dv_p_corr
            mv = sel_kv_num t_dv_jk_mism ok
            if ne get ok 0 0
              put dv_rh_mism 0 dv_llround mv
            end
          end
          if sel_line_pfx t_dv_p_en
            sec = 3
          else
            if ge sel_find_key t_sel_k_rz 0
              if ge sel_find_key t_sel_k_med 0
                if ne dv_ingest_row s ridx 0
                  ign_l = fclose int fd
                  ret -1
                end
              end
            end
          end
        end
      end
    end
  end
  ign_l = fclose int fd
  if ne sec 3
    ret -1
  end
  dv_save_rcpt_meta s ridx path plen
  ret 0
end

note ---- Field v1 selector + decision digest ----
fn dv_cs_lt a ulong b ulong to bool
  oa = mul a 32
  ob = mul b 32
  for i ulong 32
    ca = get dv_fs_cs_buf add oa i
    cb = get dv_fs_cs_buf add ob i
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret false
end

fn dv_cs_swap a ulong b ulong to void
  oa = mul a 32
  ob = mul b 32
  for i ulong 32
    t = get dv_fs_cs_buf add oa i
    put dv_fs_cs_buf add oa i get dv_fs_cs_buf add ob i
    put dv_fs_cs_buf add ob i t
  end
end

fn dv_citeset_digest nc ulong to void
  for i ulong nc bound 128
    sb = mul i 32
    for j ulong 32
      put dv_fs_cs_buf add sb j get dv_dec_cites add sb j
    end
  end
  i = ulong 1
  while lt i nc bound 128
    j = i
    while gt j 0 bound 128
      if dv_cs_lt j sub j 1
        dv_cs_swap j sub j 1
        j = sub j 1
      else
        break
      end
    end
    i = add i 1
  end
  sel_sh_init
  dl = len t_dv_dom_cs
  for k1 ulong dl bound 32
    sel_sh_byte get t_dv_dom_cs k1
  end
  sel_sh_byte uchar 0
  tot = mul nc 32
  for k2 ulong tot bound 4096
    sel_sh_byte get dv_fs_cs_buf k2
  end
  dv_sh_to_slot DV_SLOT_CS
end

fn dv_decision_digest dslot ulong to void
  dv_ca_reset t_dv_rec_dec
  dv_ca_dig t_dv_k_contract DV_SLOT_CON
  dv_ca_txt t_dv_k_sel t_dv_v_sel
  dv_ca_txt t_dv_k_cons t_dv_v_cons
  dv_ca_u64 t_dv_k_n get dv_dec_n dslot
  dv_ca_u64 t_dv_k_m get dv_dec_m dslot
  dv_ca_u64 t_dv_k_spm 300
  if ne get dv_dec_pack dslot 0
    dv_ca_txt t_dv_k_pack t_dj_pc
  else
    dv_ca_txt t_dv_k_pack t_dj_oa
  end
  dv_ca_u64 t_dv_k_cn get dv_dec_cn dslot
  dv_ca_u64 t_dv_k_cm get dv_dec_cm dslot
  dv_ca_u64 t_dv_k_cspm 4294967295
  dv_ca_u64 t_dv_k_excell get dv_dec_exact dslot
  dv_tv_clr
  rb = mul dslot 10
  for k ulong SEL_RZ_COUNT
    if gt k 0
      dv_tv_b uchar 59
    end
    dv_tv_rz k
    dv_tv_b uchar 61
    dv_tv_rname get dv_dec_reason add rb k
    dv_tv_b uchar 58
    dv_tv_u64 get dv_dec_cost add rb k
  end
  dv_ca_add_tv t_dv_k_cands
  ch = get dv_dec_chosen dslot
  if ge ch 0
    dv_tv_clr
    dv_tv_rz ulong ch
    dv_ca_add_tv t_dv_k_chosen
    dv_ca_txt t_dv_k_verdict t_dv_v_CHOSEN
  else
    dv_ca_txt t_dv_k_chosen t_dv_v_dash
    dv_ca_txt t_dv_k_verdict t_dv_v_NONE
  end
  dv_ca_txt t_dv_k_tres t_dv_v_none
  dv_ca_u64 t_dv_k_mppm get dv_dec_mppm dslot
  dv_ca_u64 t_dv_k_bppm get dv_dec_bppm dslot
  dv_ca_txt t_dv_k_sup t_dv_v_none
  for k2 ulong SEL_RZ_COUNT
    dv_ca_rel DV_REL_DEP add DV_SLOT_SPEC0 k2
  end
  nc = get dv_dec_ncite dslot
  dv_ca_u64 t_dv_k_ccnt nc
  if gt nc 0
    dv_citeset_digest nc
    dv_ca_rel DV_REL_DER DV_SLOT_CS
  end
  dv_ca_finish DV_KIND_EV t_dv_dom_dec DV_SLOT_SCR0
  db = mul dslot 32
  sb = mul DV_SLOT_SCR0 32
  for i ulong 32
    put dv_dec_dig add db i get dv_dig add sb i
  end
end

fn dv_foot_dist en ulong em ulong qn ulong qm ulong to f64
  dn = fabs sel_log2 div f64 en f64 qn
  dm = fabs sel_log2 div f64 em f64 qm
  ret add dn dm
end

fn dv_fs_find_foot s ulong dslot ulong qn ulong qm ulong to ulong
  nev = get dv_st_nev s
  have = ulong 0
  best = 0.0f64
  for i ulong nev bound 1024
    if eq get dv_fs_usable i 0
      continue
    end
    en = get dv_ev_n add mul s DV_MAX_EV i
    em = get dv_ev_m add mul s DV_MAX_EV i
    dd = dv_foot_dist en em qn qm
    take = false
    if eq have 0
      take = true
    else
      if lt dd sub best 1.0e-12f64
        take = true
      else
        if le fabs sub dd best 1.0e-12f64
          if lt en get dv_dec_cn dslot
            take = true
          else
            if eq en get dv_dec_cn dslot
              if lt em get dv_dec_cm dslot
                take = true
              end
            end
          end
        end
      end
    end
    if take
      have = 1
      best = dd
      put dv_dec_cn dslot en
      put dv_dec_cm dslot em
    end
  end
  ret have
end

fn dv_fs_cite_push nc ulong gi ulong to ulong
  if lt nc DV_MAX_CITE
    cb = mul nc 32
    eb = mul gi 32
    for b ulong 32
      put dv_dec_cites add cb b get dv_ev_dig add eb b
    end
    ret add nc 1
  end
  ret nc
end

fn dv_fs_obs_one sp ulong cost ulong to void
  c = add get dv_fs_cnt sp 1
  put dv_fs_cnt sp c
  mu = get dv_fs_mean sp
  delta = div sub f64 cost mu f64 c
  put dv_fs_mean sp add mu delta
end

fn dv_fs_rank s ulong dslot ulong pack ulong to long
  for k ulong SEL_RZ_COUNT
    put dv_fs_cnt k 0
    put dv_fs_mean k 0.0f64
  end
  nc = ulong 0
  nev = get dv_st_nev s
  for i ulong nev bound 1024
    if eq get dv_fs_usable i 0
      continue
    end
    gi = add mul s DV_MAX_EV i
    if ne get dv_ev_n gi get dv_dec_cn dslot
      continue
    end
    if ne get dv_ev_m gi get dv_dec_cm dslot
      continue
    end
    sp = get dv_ev_spec gi
    if eq get dv_fs_ranked sp 0
      continue
    end
    cost = get dv_ev_med gi
    if ne pack 0
      cost = add cost get dv_ev_pk gi
    end
    dv_fs_obs_one sp cost
    nc = dv_fs_cite_push nc gi
  end
  put dv_dec_ncite dslot nc
  best = long -1
  for k2 ulong SEL_RZ_COUNT
    if eq get dv_fs_ranked k2 0
      continue
    end
    if eq get dv_fs_cnt k2 0
      continue
    end
    if lt best 0
      best = long k2
    else
      if lt get dv_fs_mean k2 get dv_fs_mean ulong best
        best = long k2
      end
    end
  end
  ret best
end

fn dv_row_noise gi ulong pack ulong to f64
  w = div f64 get dv_ev_nz gi 1.0e6f64
  if ne pack 0
    c = f64 add get dv_ev_med gi get dv_ev_pk gi
    if gt c 0.0f64
      t1 = mul w f64 get dv_ev_med gi
      t2 = mul div f64 get dv_ev_pnz gi 1.0e6f64 f64 get dv_ev_pk gi
      ret div add t1 t2 c
    end
  end
  ret w
end

fn dv_fs_band s ulong dslot ulong chosen long runner long pack ulong to void
  nev = get dv_st_nev s
  band = 0.0f64
  for i ulong nev bound 1024
    if eq get dv_fs_usable i 0
      continue
    end
    gi = add mul s DV_MAX_EV i
    if ne get dv_ev_n gi get dv_dec_cn dslot
      continue
    end
    if ne get dv_ev_m gi get dv_dec_cm dslot
      continue
    end
    sp = long get dv_ev_spec gi
    if ne sp chosen
      if ne sp runner
        continue
      end
    end
    w = dv_row_noise gi pack
    if gt w band
      band = w
    end
  end
  put dv_dec_bppm dslot dv_llround mul band 1.0e6f64
  if ge runner 0
    put dv_dec_mppm dslot dv_llround mul sub div get dv_fs_mean ulong runner get dv_fs_mean ulong chosen 1.0f64 1.0e6f64
  else
    put dv_dec_mppm dslot 0
  end
end

fn dv_fs_filter_rows s ulong dslot ulong qn ulong to void
  nev = get dv_st_nev s
  for i2 ulong nev bound 1024
    if eq get dv_fs_usable i2 0
      continue
    end
    gi = add mul s DV_MAX_EV i2
    if ne get dv_ev_n gi get dv_dec_cn dslot
      continue
    end
    if ne get dv_ev_m gi get dv_dec_cm dslot
      continue
    end
    sp = get dv_ev_spec gi
    put dv_fs_rows sp add get dv_fs_rows sp 1
    if eq get dv_ev_ver gi 0
      put dv_fs_bad sp long DV_R_UNVER_RUN
    else
      if ne get dv_ev_forced gi 0
        put dv_fs_bad sp long DV_R_FORCED
      else
        if eq get dv_ev_tier gi 0
          put dv_fs_bad sp long DV_R_TIER
        end
      end
    end
  end
  rb = mul dslot 10
  for k2 ulong SEL_RZ_COUNT
    if gt qn sel_rz_max_n k2
      continue
    end
    if eq get dv_fs_rows k2 0
      put dv_dec_reason add rb k2 DV_R_NO_EV
    else
      if ge get dv_fs_bad k2 0
        put dv_dec_reason add rb k2 ulong get dv_fs_bad k2
      else
        put dv_fs_ranked k2 1
        put dv_dec_reason add rb k2 DV_R_RANKED
      end
    end
  end
end

fn dv_field_select s ulong dslot ulong qn ulong qm ulong pack ulong to int
  put dv_dec_n dslot qn
  put dv_dec_m dslot qm
  put dv_dec_pack dslot pack
  put dv_dec_chosen dslot -1
  put dv_dec_ncite dslot 0
  put dv_dec_mppm dslot 0
  put dv_dec_bppm dslot 0
  rb = mul dslot 10
  for k ulong SEL_RZ_COUNT
    put dv_dec_cost add rb k 0
    put dv_fs_rows k 0
    put dv_fs_bad k -1
    put dv_fs_ranked k 0
    if gt qn sel_rz_max_n k
      put dv_dec_reason add rb k DV_R_MAX_N
    else
      put dv_dec_reason add rb k DV_R_NO_EV
    end
  end
  nev = get dv_st_nev s
  for i ulong nev bound 1024
    sp = get dv_ev_spec add mul s DV_MAX_EV i
    if le qn sel_rz_max_n sp
      put dv_fs_usable i 1
    else
      put dv_fs_usable i 0
    end
  end
  if eq dv_fs_find_foot s dslot qn qm 0
    dv_decision_digest dslot
    ret 1
  end
  if and eq get dv_dec_cn dslot qn eq get dv_dec_cm dslot qm
    put dv_dec_exact dslot 1
  else
    put dv_dec_exact dslot 0
  end
  dv_fs_filter_rows s dslot qn
  ch = dv_fs_rank s dslot pack
  if lt ch 0
    put dv_dec_ncite dslot 0
    dv_decision_digest dslot
    ret 1
  end
  for k3 ulong SEL_RZ_COUNT
    if ne get dv_fs_ranked k3 0
      put dv_dec_cost add rb k3 dv_llround get dv_fs_mean k3
    end
  end
  run = long -1
  for k4 ulong SEL_RZ_COUNT
    if and ne get dv_fs_ranked k4 0 ne long k4 ch
      if lt run 0
        run = long k4
      else
        if lt get dv_fs_mean k4 get dv_fs_mean ulong run
          run = long k4
        end
      end
    end
  end
  dv_fs_band s dslot ch run pack
  put dv_dec_chosen dslot ch
  put dv_dec_reason add rb ulong ch DV_R_CHOSEN
  dv_decision_digest dslot
  ret 0
end

note ---- Query table ----
fn dv_q_n qi ulong to ulong
  if le qi 1
    ret 4096
  end
  if le qi 3
    ret 16384
  end
  ret 65537
end

fn dv_q_m qi ulong to ulong
  if le qi 1
    ret 64
  end
  if le qi 3
    ret 4096
  end
  ret 64
end

fn dv_q_pack qi ulong to ulong
  ret rem qi 2
end

fn dv_o_qid qi ulong to void
  if eq qi 0
    sel_o_txt t_dv_qid_0
    ret
  end
  if eq qi 1
    sel_o_txt t_dv_qid_1
    ret
  end
  if eq qi 2
    sel_o_txt t_dv_qid_2
    ret
  end
  if eq qi 3
    sel_o_txt t_dv_qid_3
    ret
  end
  if eq qi 4
    sel_o_txt t_dv_qid_4
    ret
  end
  sel_o_txt t_dv_qid_5
end

fn dv_o_qsh qi ulong to void
  if le qi 1
    sel_o_txt t_dv_qsh_0
    ret
  end
  if le qi 3
    sel_o_txt t_dv_qsh_1
    ret
  end
  sel_o_txt t_dv_qsh_2
end

fn dv_o_dec_hex dslot ulong to void
  b = mul dslot 32
  for i ulong 32
    v = ulong get dv_dec_dig add b i
    hi = shr v 4
    lo = and v 15
    if lt hi 10
      sel_o_b uchar add 48 hi
    else
      sel_o_b uchar add 87 hi
    end
    if lt lo 10
      sel_o_b uchar add 48 lo
    else
      sel_o_b uchar add 87 lo
    end
  end
end

fn dv_cmd_digests to int
  p1 = new uchar 512 0
  l1 = argread ulong 2 p1 0 512
  if lt l1 0
    ret 2
  end
  p2 = new uchar 512 0
  l2 = argread ulong 3 p2 0 512
  if lt l2 0
    ret 2
  end
  if ne dv_ingest_receipt 0 p1 ulong l1 0
    ret 2
  end
  if ne dv_ingest_receipt 0 p2 ulong l2 0
    ret 2
  end
  sel_o_init 1
  for qi ulong DV_NQ
    rc = dv_field_select 0 qi dv_q_n qi dv_q_m qi dv_q_pack qi
    if lt rc 0
      ret 2
    end
    dv_o_qid qi
    sel_o_b uchar 32
    dv_o_dec_hex qi
    sel_o_b uchar 10
  end
  sel_o_flush
  ret 0
end

note ---- env lookup for receipt mode ----
fn dv_getenv_match idx ulong key view uchar * to ulong
  n = envread idx dv_env_tmp 0 2048
  if le n 0
    ret 0
  end
  kl = len key
  if le ulong n kl
    ret 0
  end
  for j ulong kl bound 64
    if ne get dv_env_tmp j get key j
      ret 0
    end
  end
  if ne get dv_env_tmp kl uchar 61
    ret 0
  end
  vl = sub ulong n add kl 1
  for i ulong vl bound 2048
    put dv_evb i get dv_env_tmp add add kl 1 i
  end
  put dv_evl 0 vl
  ret 1
end

fn dv_getenv key view uchar * to ulong
  ec = envcnt
  for i ulong ulong ec bound 512
    if eq dv_getenv_match i key 1
      ret 1
    end
  end
  put dv_evl 0 0
  ret 0
end

fn dv_add_fail msg view uchar * to void
  nf = get dv_nfail 0
  if lt nf 64
    ml = len msg
    if gt ml 199
      ml = 199
    end
    b = mul nf 200
    for i ulong ml bound 200
      put dv_fails add b i get msg i
    end
    put dv_flens nf ml
  end
  put dv_nfail 0 add nf 1
end

fn dv_ri_copy_field slot ulong dst_kind ulong src view uchar * slen ulong to void
  if eq dst_kind 0
    b = mul slot 96
    for i1 ulong slen bound 96
      put dv_ri_sch add b i1 get src i1
    end
    put dv_ri_schl slot slen
    ret
  end
  if eq dst_kind 1
    b = mul slot 128
    for i2 ulong slen bound 128
      put dv_ri_rid add b i2 get src i2
    end
    put dv_ri_ridl slot slen
    ret
  end
  if eq dst_kind 2
    b = mul slot 48
    for i3 ulong slen bound 48
      put dv_ri_com add b i3 get src i3
    end
    put dv_ri_coml slot slen
    ret
  end
  if eq dst_kind 3
    b = mul slot 8
    for i4 ulong slen bound 8
      put dv_ri_dir add b i4 get src i4
    end
    put dv_ri_dirl slot slen
    ret
  end
  b = mul slot 24
  for i5 ulong slen bound 24
    put dv_ri_mis add b i5 get src i5
  end
  put dv_ri_misl slot slen
end

fn dv_load_rinfo_scan fd int slot ulong to void
  put sel_fpos 0 0
  put sel_flen 0 0
  put dv_ri_schl slot 0
  put dv_ri_ridl slot 0
  put dv_ri_coml slot 0
  put dv_ri_dirl slot 0
  put dv_ri_misl slot 0
  tmp = new uchar 128 0
  ok = new int 1 0
  while true bound 50000
    if lt sel_readline fd 0
      break
    end
    if eq get dv_ri_schl slot 0
      k = sel_kv_str t_dv_jk_schema tmp 95
      if ge k 0
        dv_ri_copy_field slot 0 tmp ulong k
      end
    end
    if eq get dv_ri_ridl slot 0
      k = sel_kv_str t_sel_k_runid tmp 127
      if ge k 0
        dv_ri_copy_field slot 1 tmp ulong k
      end
    end
    if eq get dv_ri_coml slot 0
      k = sel_kv_str t_dv_jk_commit tmp 47
      if ge k 0
        dv_ri_copy_field slot 2 tmp ulong k
      end
    end
    if eq get dv_ri_dirl slot 0
      if eq sel_kv_bool t_dv_jk_dirty ok 0
        if ne get ok 0 0
          dv_ri_copy_field slot 3 t_sel_true len t_sel_true
        else
          dv_ri_copy_field slot 3 t_sel_false len t_sel_false
        end
      end
    end
    if sel_line_pfx t_dv_p_corr
      mv = sel_kv_num t_dv_jk_mism ok
      if ne get ok 0 0
        dv_tv_clr
        dv_tv_u64 dv_llround mv
        tl = get dv_tvl 0
        for i4 ulong tl bound 24
          put dv_ri_mis add mul slot 24 i4 get dv_tv i4
        end
        put dv_ri_misl slot tl
      end
    end
  end
end

fn dv_ri_store_hash slot ulong to void
  for i2 ulong 32
    put dv_ri_dig add mul slot 32 i2 get dv_dig add mul DV_SLOT_SCR0 32 i2
  end
  for i3 ulong 64
    put dv_ri_hex add mul slot 64 i3 get sel_sh_hex i3
  end
end

fn dv_load_rinfo slot ulong argi ulong to int
  p = new uchar 256 0
  pl = argread argi p 0 256
  if lt pl 0
    ret -1
  end
  for i1 ulong ulong pl bound 256
    put dv_ri_path add mul slot 256 i1 get p i1
  end
  put dv_ri_plen slot ulong pl
  if ne dv_file_sha256_buf p ulong pl DV_SLOT_SCR0 0
    ret -1
  end
  dv_ri_store_hash slot
  fd = fopen p 0 ulong pl SEL_O_RDONLY 0
  if lt fd 0
    ret -1
  end
  dv_load_rinfo_scan int fd slot
  ign_l = fclose int fd
  ret 0
end

fn dv_rcpt_cost s ulong spec ulong ridx ulong cn ulong cm ulong pack ulong to f64
  sum = 0.0f64
  cnt = ulong 0
  for i ulong get dv_st_nev s bound 1024
    gi = add mul s DV_MAX_EV i
    if ne get dv_ev_n gi cn
      continue
    end
    if ne get dv_ev_m gi cm
      continue
    end
    if ne get dv_ev_spec gi spec
      continue
    end
    if ne get dv_ev_rcpt gi ridx
      continue
    end
    c = get dv_ev_med gi
    if ne pack 0
      c = add c get dv_ev_pk gi
    end
    sum = add sum f64 c
    cnt = add cnt 1
  end
  if eq cnt 0
    ret -1.0f64
  end
  ret div sum f64 cnt
end

fn dv_wb_of s ulong spec ulong cn ulong cm ulong to ulong
  nev = get dv_st_nev s
  gbase = mul s DV_MAX_EV
  for i ulong nev bound 1024
    gi = add gbase i
    if ne get dv_ev_n gi cn
      continue
    end
    if ne get dv_ev_m gi cm
      continue
    end
    if ne get dv_ev_spm gi 300
      continue
    end
    if eq get dv_ev_spec gi spec
      ret get dv_ev_wb gi
    end
  end
  ret 0
end

fn dv_o_jstr_buf buf view uchar * n ulong to void
  sel_o_b uchar 34
  for i ulong n bound 2048
    c = get buf i
    if or eq c uchar 34 eq c uchar 92
      sel_o_b uchar 92
      sel_o_b c
    else
      sel_o_b c
    end
  end
  sel_o_b uchar 34
end


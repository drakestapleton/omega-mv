note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit and parity test for:
note   src/algebra/realize_common.om,
note   om/algebra/realize_{binary,bitplane,sparse,rns,dense}.om,
note   src/tensor/omega_tensor_reduce_seam.om (with src/omega_numeric_reduce.om).
om2

global t_chk ulong 2
global t_rng ulong 1

text msg_pass "ALGEBRA_REALIZE_OM_PASS\n"
text msg_fail "ALGEBRA_REALIZE_OM_FAIL\n"
text msg_ok "ok"
text msg_arg "bad argument"
text msg_trit "weight outside {-1,0,+1}"
text msg_nomem "out of memory"
text msg_ovf "size overflow"
text msg_unk "unknown error"
text msg_bad_id "R9_nope"
text msg_seam_src "E1_WP_D_OMEGA_REDUCE_CPU"

fn tchk ok bool to void
  put t_chk 0 add get t_chk 0 1
  if not ok
    put t_chk 1 add get t_chk 1 1
  end
end

fn trnd to ulong
  s = add get t_rng 0 ulong 0x9e3779b97f4a7c15
  put t_rng 0 s
  z = mul xor s shr s 30 ulong 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 ulong 0x94d049bb133111eb
  ret xor z shr z 31
end

fn t_eq_str a view uchar * alen ulong b view uchar * to bool
  if ne alen len b
    ret false
  end
  for i ulong alen bound 64
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn test_registry_and_meta to void
  tchk eq oma_rz_count 10
  for i ulong 10
    tchk eq oma_rz_get i long i
  end
  tchk eq oma_rz_get 10 -1

  buf = new uchar 64 0
  for i ulong 10
    nlen = oma_rz_id i buf
    tchk gt nlen 0
    found = oma_rz_find buf ulong nlen
    tchk eq found long i
    flen = oma_rz_family i buf
    tchk gt flen 0
    tchk eq oma_rz_exact i 1
    if eq i 0
      tchk eq oma_rz_weak_baseline i 1
    else
      tchk eq oma_rz_weak_baseline i 0
    end
  end
  tchk eq oma_rz_id 10 buf -1
  tchk eq oma_rz_family 10 buf -1
  tchk eq oma_rz_exact 10 0
  tchk eq oma_rz_find msg_bad_id len msg_bad_id -1

  tchk eq oma_rz_max_n RZ_R1_PLAIN OMA_RZ_MAX_N
  tchk eq oma_rz_max_n RZ_R3_SPARSE RZ_SP_MAX_N
  tchk eq oma_rz_max_n RZ_R4_RNS RZ_RNS_MAX_N
  tchk eq oma_rz_max_n RZ_R5_DENSE5 OMA_RZ_MAX_N

  slen = oma_rz_strerror OMA_RZ_OK buf
  tchk t_eq_str buf ulong slen msg_ok
  slen = oma_rz_strerror OMA_RZ_E_ARG buf
  tchk t_eq_str buf ulong slen msg_arg
  slen = oma_rz_strerror OMA_RZ_E_TRIT buf
  tchk t_eq_str buf ulong slen msg_trit
  slen = oma_rz_strerror OMA_RZ_E_NOMEM buf
  tchk t_eq_str buf ulong slen msg_nomem
  slen = oma_rz_strerror OMA_RZ_E_OVERFLOW buf
  tchk t_eq_str buf ulong slen msg_ovf
  slen = oma_rz_strerror -99 buf
  tchk t_eq_str buf ulong slen msg_unk

  tchk eq oma_rz_alloc 0 64
  tchk eq oma_rz_alloc 1 64
  tchk eq oma_rz_alloc 64 64
  tchk eq oma_rz_alloc 65 128
  tchk eq oma_rz_alloc ulong 0xffffffffffffffff 0

  tchk eq oma_rz_check_shape 0 4 OMA_RZ_MAX_N OMA_RZ_E_ARG
  tchk eq oma_rz_check_shape 4 0 OMA_RZ_MAX_N OMA_RZ_E_ARG
  tchk eq oma_rz_check_shape 1 add OMA_RZ_MAX_N 1 OMA_RZ_MAX_N OMA_RZ_E_ARG
  tchk eq oma_rz_check_shape 1 100 64 OMA_RZ_E_ARG
  tchk eq oma_rz_check_shape ulong 0x4000000000000000 4 OMA_RZ_MAX_N OMA_RZ_E_OVERFLOW
  tchk eq oma_rz_check_shape 4 16 OMA_RZ_MAX_N OMA_RZ_OK
end

fn test_rejections to void
  w = new byte 8 0
  x = new byte 4 0
  y = new int 4 0
  put w 0 byte 1
  put w 1 byte 0
  put w 2 byte -1
  put w 3 byte 2
  put w 4 byte 0
  put w 5 byte 1
  for rid ulong 10
    put w 3 byte 2
    tchk eq oma_rz_pack rid w 2 3 OMA_RZ_E_TRIT
    put w 3 byte -2
    tchk eq oma_rz_pack rid w 2 3 OMA_RZ_E_TRIT
    put w 3 byte -128
    tchk eq oma_rz_pack rid w 2 3 OMA_RZ_E_TRIT
    put w 3 byte 0
    tchk eq oma_rz_pack rid w 0 3 OMA_RZ_E_ARG
    tchk eq oma_rz_pack rid w 2 0 OMA_RZ_E_ARG
    tchk eq oma_rz_pack rid w 1 add OMA_RZ_MAX_N 1 OMA_RZ_E_ARG
    oma_rz_free
    tchk eq oma_rz_run x y OMA_RZ_E_ARG
  end
  tchk eq oma_rz_pack 10 w 2 3 OMA_RZ_E_ARG
end

fn fill_w_pat w edit byte * cnt ulong mode ulong to void
  for i ulong cnt bound 262144
    if eq mode 0
      put w i byte 0
    else
      if eq mode 1
        put w i byte 1
      else
        if eq mode 2
          put w i byte -1
        else
          r = rem trnd 10
          if lt r 3
            put w i byte 1
          else
            if lt r 6
              put w i byte -1
            else
              put w i byte 0
            end
          end
        end
      end
    end
  end
end

fn fill_x_pat x edit byte * n ulong mode ulong to void
  for j ulong n bound 131072
    if eq mode 0
      put x j byte -128
    else
      if eq mode 1
        put x j byte 127
      else
        if eq mode 2
          if eq and j 1 1
            put x j byte 127
          else
            put x j byte -128
          end
        else
          rb = and trnd 255
          if ge rb 128
            put x j byte sub int rb 256
          else
            put x j byte int rb
          end
        end
      end
    end
  end
end

fn check_plan_bytes rid ulong m ulong n ulong nnz ulong to void
  wb = get rz_plan 2
  fp = get rz_plan 3
  sb = get rz_plan 4
  tchk eq get rz_plan 5 nnz
  if le rid RZ_R1_SDOT
    tchk eq wb mul m n
    tchk eq sb 0
    tchk eq fp wb
    ret
  end
  if eq rid RZ_R1_SDOT_IL
    np = mul div add n 15 16 16
    mp = mul div add m 3 4 4
    tchk eq wb mul mp np
    tchk eq sb 0
    tchk eq fp wb
    ret
  end
  if eq rid RZ_R1_SMMLA
    np = mul div add n 15 16 16
    mp = mul div add m 1 2 2
    tchk eq wb mul mp np
    tchk eq sb 0
    tchk eq fp wb
    ret
  end
  if eq rid RZ_R2_BITPLANE
    ch = div add n 127 128
    tchk eq wb mul m mul ch 32
    tchk eq sb 0
    tchk eq fp wb
    ret
  end
  if eq rid RZ_R2B_LUT
    sg = div add n 15 16
    mb = div add m 15 16
    tchk eq wb mul mul mb sg 64
    tchk eq sb mul sg 128
    tchk eq fp add wb sb
    ret
  end
  if eq rid RZ_R2C_CRUMB
    ch = div add n 63 64
    tchk eq wb mul m mul ch 16
    tchk eq sb 0
    tchk eq fp wb
    ret
  end
  if eq rid RZ_R3_SPARSE
    tchk eq wb add mul nnz 2 mul add mul 2 m 1 4
    tchk eq sb 0
    tchk eq fp wb
    ret
  end
  if eq rid RZ_R4_RNS
    np = mul div add n 15 16 16
    tchk eq wb mul m np
    tchk eq sb mul 3 np
    tchk eq fp add wb sb
    ret
  end
  ch = div add n 79 80
  tchk eq wb mul m mul ch 16
  tchk eq sb 0
  tchk eq fp wb
end

fn count_nnz_w w view byte * cnt ulong to ulong
  nnz = ulong 0
  for i ulong cnt bound 8192
    if ne int get w i 0
      nnz = add nnz 1
    end
  end
  ret nnz
end

fn check_y_vs_oracle y view int * m ulong to void
  bad = ulong 0
  for r ulong m bound 64
    if ne get y r get rz_oracle_out r
      bad = add bad 1
    end
  end
  tchk eq bad 0
end

fn run_case_small m ulong n ulong wm ulong xm ulong to void
  w = new byte 8192 0
  x = new byte 512 0
  y = new int 64 0
  fill_w_pat w mul m n wm
  fill_x_pat x n xm
  nnz = count_nnz_w w mul m n
  tchk eq oma_rz_oracle w m n x OMA_RZ_OK
  for rid ulong 10
    tchk eq oma_rz_pack rid w m n OMA_RZ_OK
    check_plan_bytes rid m n nnz
    tchk eq oma_rz_run x y OMA_RZ_OK
    check_y_vs_oracle y m
    tchk eq oma_rz_run x y OMA_RZ_OK
    check_y_vs_oracle y m
  end
end

fn test_structured_cases to void
  run_case_small 1 1 1 0
  run_case_small 1 15 3 3
  run_case_small 1 16 3 2
  run_case_small 1 17 2 0
  run_case_small 3 31 3 3
  run_case_small 4 32 3 1
  run_case_small 5 63 3 2
  run_case_small 5 64 1 0
  run_case_small 5 65 3 3
  run_case_small 7 79 3 3
  run_case_small 7 80 2 1
  run_case_small 7 81 3 2
  run_case_small 15 127 3 3
  run_case_small 16 128 0 3
  run_case_small 17 129 3 3
  run_case_small 17 257 3 3
end

fn test_boundary_n n ulong to void
  w = new byte 132096 0
  x = new byte 66048 0
  y = new int 4 0
  fill_w_pat w mul 2 n 2
  fill_x_pat x n 0
  tchk eq oma_rz_oracle w 2 n x OMA_RZ_OK
  for rid ulong 10
    rc = oma_rz_pack rid w 2 n
    if gt n oma_rz_max_n rid
      tchk eq rc OMA_RZ_E_ARG
    else
      tchk eq rc OMA_RZ_OK
      tchk eq oma_rz_run x y OMA_RZ_OK
      tchk eq get y 0 get rz_oracle_out 0
      tchk eq get y 1 get rz_oracle_out 1
    end
  end
end

fn test_tensor_reduce_seam to void
  sbuf = new uchar 64 0
  slen = omega_tensor_seam_reduce_source sbuf
  tchk t_eq_str sbuf ulong slen msg_seam_src
  small = new uchar 8 0
  tchk eq omega_tensor_seam_reduce_source small OMEGA_NUMERIC_ERR_BAD_ARGS

  x = new uint 128 0
  tchk eq omega_tensor_seam_reduce_cpu OMEGA_TR_SUM x 0 0 OMEGA_NUMERIC_ERR_BAD_ARGS
  tchk eq omega_tensor_seam_reduce_cpu OMEGA_TR_COUNT x 0 4 OMEGA_NUMERIC_ERR_BAD_ARGS

  for i ulong 100
    put x i bitcast uint f32 uint add i 1
  end

  tchk eq omega_tensor_seam_reduce_cpu OMEGA_TR_SUM x 0 100 0
  s_seam = get g_red_out 0
  tchk eq omega_reduce_reference OMEGA_RED_SUM x 0 100 0
  tchk eq s_seam get g_red_out 0
  tchk eq s_seam uint 0x459dd000

  tchk eq omega_tensor_seam_reduce_cpu OMEGA_TR_MEAN x 0 100 0
  m_seam = get g_red_out 0
  tchk eq omega_reduce_reference OMEGA_RED_MEAN x 0 100 0
  tchk eq m_seam get g_red_out 0
  tchk eq m_seam uint 0x424a0000

  tchk eq omega_tensor_seam_reduce_cpu OMEGA_TR_MAX x 0 100 0
  mx_seam = get g_red_out 0
  tchk eq mx_seam uint 0x42c80000

  tchk eq omega_tensor_seam_reduce_cpu OMEGA_TR_MIN x 0 100 0
  mn_seam = get g_red_out 0
  tchk eq mn_seam uint 0x3f800000

  note Signed zeros and NaNs
  z = new uint 8 0
  put z 0 uint 0x80000000
  put z 1 uint 0x7fc00001
  put z 2 uint 0x00000000
  put z 3 uint 0x7fa00001
  tchk eq omega_tensor_seam_reduce_cpu OMEGA_TR_MAX z 0 4 0
  tchk eq get g_red_out 0 uint 0x00000000
  tchk eq omega_tensor_seam_reduce_cpu OMEGA_TR_MIN z 0 4 0
  tchk eq get g_red_out 0 uint 0x80000000
  tchk eq omega_tensor_seam_reduce_cpu OMEGA_TR_SUM z 0 1 0
  tchk eq get g_red_out 0 uint 0x80000000
end

fn fnv1a_step h ulong b ulong to ulong
  ret mul xor h b ulong 1099511628211
end

fn fnv1a_i32_arr y view int * cnt ulong to ulong
  h = ulong 14695981039346656037
  for i ulong cnt bound 64
    v = and ulong bitcast ulong long get y i ulong 0xffffffff
    h = fnv1a_step h and v 255
    h = fnv1a_step h and shr v 8 255
    h = fnv1a_step h and shr v 16 255
    h = fnv1a_step h and shr v 24 255
  end
  ret h
end

fn fnv1a_rz_mem nbytes ulong to ulong
  h = ulong 14695981039346656037
  for i ulong nbytes bound 8192
    h = fnv1a_step h ulong get rz_mem i
  end
  ret h
end

fn fnv1a_rz_sparse nnz ulong m ulong to ulong
  h = ulong 14695981039346656037
  for i ulong nnz bound 4096
    v = ulong get rz_idx i
    h = fnv1a_step h and v 255
    h = fnv1a_step h and shr v 8 255
  end
  noff = add mul 2 m 1
  for i ulong noff bound 64
    v = ulong get rz_off i
    h = fnv1a_step h and v 255
    h = fnv1a_step h and shr v 8 255
    h = fnv1a_step h and shr v 16 255
    h = fnv1a_step h and shr v 24 255
  end
  ret h
end

fn expected_c_mh rid ulong to ulong
  if eq rid 0
    ret ulong 0xa2cb796e2d3265ea
  end
  if eq rid 1
    ret ulong 0xa2cb796e2d3265ea
  end
  if eq rid 2
    ret ulong 0xe5c21fb9f60ec3f6
  end
  if eq rid 3
    ret ulong 0x008e97bbde823376
  end
  if eq rid 4
    ret ulong 0x8ffeecaebbaf21a6
  end
  if eq rid 5
    ret ulong 0x283cf7722a81ada3
  end
  if eq rid 6
    ret ulong 0x3114e04007cca3f1
  end
  if eq rid 7
    ret ulong 0x0aab30c77d6981c8
  end
  if eq rid 8
    ret ulong 0x99c68d0a73f51032
  end
  ret ulong 0x183aca15f5cbf630
end

fn test_c_oracle_byte_exact to void
  put t_rng 0 ulong 0x4d41332d7265616c
  w = new byte 2193 0
  x = new byte 129 0
  y = new int 17 0
  fill_w_pat w 2193 3
  fill_x_pat x 129 3
  tchk eq oma_rz_oracle w 17 129 x OMA_RZ_OK
  for rid ulong 10
    tchk eq oma_rz_pack rid w 17 129 OMA_RZ_OK
    tchk eq oma_rz_run x y OMA_RZ_OK
    tchk eq fnv1a_i32_arr y 17 ulong 0x2eaf59d777147eda
    mh = ulong 0
    if eq rid RZ_R3_SPARSE
      mh = fnv1a_rz_sparse get rz_plan 5 17
    else
      mh = fnv1a_rz_mem get rz_plan 2
    end
    tchk eq mh expected_c_mh rid
  end
end

fn main to int
  test_c_oracle_byte_exact
  put t_rng 0 ulong 0x4d41332d7265616c
  test_registry_and_meta
  test_rejections
  test_structured_cases
  test_boundary_n 64512
  test_boundary_n 64513
  test_boundary_n 65536
  test_boundary_n 65537
  test_tensor_reduce_seam

  if eq get t_chk 1 0
    ign_l = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign_l = write 1 msg_fail 0 len msg_fail
  ret 1
end

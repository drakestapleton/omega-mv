note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 parity-oracle tests for Omega mixed algebra.
note Replaces tests/algebra/test_oma.c. Concatenated after src/algebra/oma_lib.om.

global g_chk ulong 4
global g_rng ulong 1
global g_ex_vecs byte 46656
global g_ex_blks ulong 1458
global g_ex_acts byte 256
global g_q_kk int 1024
global g_q_q byte 1024

text t_pass "PASS "
text t_fail "FAIL "
text t_sp " "
text t_chk_s " checks, "
text t_fail_s " failures\n"
text t_hdr "OMA ALGEBRA: "
text t_arrow_p " failures -> PASS\n"
text t_arrow_f " failures -> FAIL\n"

text sec_ctor "constructors+codes          "
text sec_tt "per-trit truth tables       "
text sec_inv "invalid (1,1) rejection     "
text sec_exh "exhaustive 3^k (k<=6)       "
text sec_den "dense bytes (all 256)       "
text sec_int "integer <-> balanced ternary"
text sec_rnd "random block properties     "
text sec_pk "pack/unpack random          "
text sec_z3 "Z3                          "
text sec_err "errors leave outputs        "
text sec_qnt "absmean quantization        "

fn chk ok bool to void
  put g_chk 2 add get g_chk 2 1
  if not ok
    put g_chk 3 add get g_chk 3 1
  end
end

fn sec_begin to void
  put g_chk 2 ulong 0
  put g_chk 3 ulong 0
end

fn sec_end name view uchar * to void
  sc = get g_chk 2
  sf = get g_chk 3
  if eq sf 0
    oma_put_str t_pass
  else
    oma_put_str t_fail
  end
  oma_put_str name
  oma_put_str t_sp
  oma_put_u64 1 sc
  oma_put_str t_chk_s
  oma_put_u64 1 sf
  oma_put_str t_fail_s
  put g_chk 0 add get g_chk 0 sc
  put g_chk 1 add get g_chk 1 sf
end

fn rnd to ulong
  s = add get g_rng 0 0x9e3779b97f4a7c15
  put g_rng 0 s
  z = mul xor s shr s 30 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 0x94d049bb133111eb
  ret xor z shr z 31
end

fn rnd_trit to int
  ret sub int rem rnd 3 1
end

fn code_val c int to int
  ret sub and c 1 and shr c 1 1
end

fn naive_add_s a int b int to int
  v = add a b
  cy = int 0
  if gt v 1
    cy = 1
  else
    if lt v -1
      cy = -1
    end
  end
  ret sub v mul 3 cy
end

fn naive_add_c a int b int to int
  v = add a b
  if gt v 1
    ret 1
  end
  if lt v -1
    ret -1
  end
  ret 0
end

fn rnd_valid_blk dst edit ulong 2 to void
  p = rnd
  n = rnd
  m = rem rnd 4
  if eq m 0
    p = and p rnd
    n = and n rnd
  else
    if eq m 1
      p = 0
    else
      if eq m 2
        n = 0
      end
    end
  end
  put dst 0 and p xor ulong 0xffffffffffffffff n
  put dst 1 n
end

fn blk_lane b view ulong 2 i ulong to int
  pb = int and shr get b 0 i 1
  nb = int and shr get b 1 i 1
  ret sub pb nb
end

note ---- section 1: constructors + codes ----

fn test_constructors to void
  sec_begin
  t = new byte 1 0
  z = new uchar 1 0
  c = new uchar 1 0
  v = int -300
  while le v 300 bound 700
    put t 0 byte 7
    rc = oma_trit_make v t
    if and ge v -1 le v 1
      chk and eq rc 0 eq int get t 0 v
    else
      chk and eq rc OMA_E_INVALID_TRIT eq int get t 0 7
    end
    put z 0 uchar 9
    rc = oma_z3_make v z
    if and ge v 0 le v 2
      chk and eq rc 0 eq int get z 0 v
    else
      chk eq rc OMA_E_INVALID_Z3
    end
    v = add v 1
  end
  for ci int 256
    rc = oma_code_to_trit ci t
    if le ci 2
      chk and eq rc 0 eq int get t 0 code_val ci
    else
      chk eq rc OMA_E_INVALID_CODE
    end
  end
  v2 = int -128
  while le v2 127 bound 300
    put c 0 uchar 99
    rc = oma_trit_to_code v2 c
    if and ge v2 -1 le v2 1
      cv = int get c 0
      chk and eq rc 0 and eq code_val cv v2 ne cv 3
    else
      chk eq rc OMA_E_INVALID_TRIT
    end
    v2 = add v2 1
  end
  chk and eq oma_trit_to_code -1 c 0 eq int get c 0 2
  chk and eq oma_trit_to_code 0 c 0 eq int get c 0 0
  chk and eq oma_trit_to_code 1 c 0 eq int get c 0 1
  sec_end sec_ctor
end

note ---- section 2: per-trit truth tables ----

fn test_code_pair a int b int to void
  sc = new uchar 2 77
  rca = oma_code_add a b sc
  if and le a 2 le b 2
    sv = int get sc 0
    cv = int get sc 1
    va = code_val a
    vb = code_val b
    chk and eq rca 0 and le sv 2 le cv 2
    chk and eq code_val sv naive_add_s va vb eq code_val cv naive_add_c va vb
    chk eq add va vb add code_val sv mul 3 code_val cv
  else
    chk and eq rca OMA_E_INVALID_CODE and eq int get sc 0 77 eq int get sc 1 77
  end
  m = new uchar 1 77
  rcm = oma_code_mul a b m
  if and le a 2 le b 2
    mv = int get m 0
    chk and eq rcm 0 and le mv 2 eq code_val mv mul code_val a code_val b
  else
    chk and eq rcm OMA_E_INVALID_CODE eq int get m 0 77
  end
end

fn test_val_pair a2 int b2 int to void
  tsc = new byte 2 0
  tm = new byte 1 0
  rca = oma_trit_add a2 b2 tsc
  rcm = oma_trit_mul a2 b2 tm
  if and and ge a2 -1 le a2 1 and ge b2 -1 le b2 1
    chk and eq rca 0 eq int get tsc 0 naive_add_s a2 b2
    chk eq int get tsc 1 naive_add_c a2 b2
    chk and eq rcm 0 eq int get tm 0 mul a2 b2
  else
    chk and eq rca OMA_E_INVALID_TRIT eq rcm OMA_E_INVALID_TRIT
  end
end

fn test_val_tt to void
  tr = new byte 1 0
  a2 = int -3
  while le a2 3 bound 16
    rc = oma_trit_neg a2 tr
    if and ge a2 -1 le a2 1
      chk and eq rc 0 eq int get tr 0 sub 0 a2
    else
      chk eq rc OMA_E_INVALID_TRIT
    end
    b2 = int -3
    while le b2 3 bound 16
      test_val_pair a2 b2
      b2 = add b2 1
    end
    a2 = add a2 1
  end
end

fn test_trit_truth_tables to void
  sec_begin
  codes = new int 6 0
  put codes 0 0
  put codes 1 1
  put codes 2 2
  put codes 3 3
  put codes 4 4
  put codes 5 255
  r = new uchar 1 0
  for i ulong 6
    a = get codes i
    put r 0 uchar 77
    rc = oma_code_neg a r
    if le a 2
      rv = int get r 0
      chk and eq rc 0 and eq code_val rv sub 0 code_val a ne rv 3
    else
      chk and eq rc OMA_E_INVALID_CODE eq int get r 0 77
    end
    for j ulong 6
      test_code_pair a get codes j
    end
  end
  test_val_tt
  sec_end sec_tt
end

note ---- section 3: invalid (1,1) rejection ----

fn test_invalid_one_z3 bad view ulong 2 to void
  ob1 = new ulong 2 0
  ser = new uchar 16 0
  zo = new ulong 2 0
  zo2 = new ulong 2 0
  p = get bad 0
  n = get bad 1
  for k ulong 8
    sh = mul k 8
    put ser k uchar and shr p sh 255
    put ser add 8 k uchar and shr n sh 255
  end
  chk eq oma_block_deserialize ser ob1 OMA_E_INVALID_PLANES
  chk eq oma_z3_block_validate bad OMA_E_INVALID_PLANES
  chk eq oma_z3_block_add bad zo zo2 OMA_E_INVALID_PLANES
  chk eq oma_z3_block_mul bad zo zo2 OMA_E_INVALID_PLANES
  chk eq oma_z3_block_neg bad zo2 OMA_E_INVALID_PLANES
  chk eq oma_z3_block_to_trits bad ob1 OMA_E_INVALID_PLANES
  chk eq oma_z3_block_from_trits bad zo OMA_E_INVALID_PLANES
end

fn test_invalid_one bad view ulong 2 good view ulong 2 to void
  ob1 = new ulong 2 0
  ob2 = new ulong 2 0
  v = new byte 64 0
  d = new int 1 0
  ser = new uchar 16 0
  chk eq oma_block_validate bad OMA_E_INVALID_PLANES
  chk eq oma_block_decode bad v OMA_E_INVALID_PLANES
  chk eq oma_block_neg bad ob1 OMA_E_INVALID_PLANES
  chk eq oma_block_add bad good ob1 ob2 OMA_E_INVALID_PLANES
  chk eq oma_block_add good bad ob1 ob2 OMA_E_INVALID_PLANES
  chk eq oma_block_mul bad good ob1 OMA_E_INVALID_PLANES
  chk eq oma_block_mul good bad ob1 OMA_E_INVALID_PLANES
  chk eq oma_block_dot bad good d OMA_E_INVALID_PLANES
  chk eq oma_block_dot good bad d OMA_E_INVALID_PLANES
  chk eq oma_dot_tw_i8 bad v 64 d OMA_E_INVALID_PLANES
  chk eq oma_block_serialize bad ser OMA_E_INVALID_PLANES
  chk eq oma_unpack_bitplane bad 1 64 v OMA_E_INVALID_PLANES
  test_invalid_one_z3 bad
end

fn test_invalid_blocks to void
  sec_begin
  good = new ulong 2 0
  bad = new ulong 2 0
  for it ulong 20000
    rnd_valid_blk bad
    bit = rem rnd 64
    mask = shl ulong 1 bit
    put bad 0 or get bad 0 mask
    put bad 1 or get bad 1 mask
    test_invalid_one bad good
  end
  inb = new byte 64 0
  ob = new ulong 2 0
  v = int -128
  while le v 127 bound 300
    put inb 17 byte v
    rc = oma_block_encode inb ob
    if and ge v -1 le v 1
      chk eq rc OMA_OK
    else
      chk eq rc OMA_E_INVALID_TRIT
    end
    v = add v 1
  end
  sec_end sec_inv
end

note ---- section 4: exhaustive 3^k (k <= 6) ----

fn exh_pair_z3_cmp a view byte 64 b view byte 64 zsv view uchar 64 zmv view uchar 64 k ulong to void
  zbad = int 0
  for i ulong k bound 8
    ua = int get a i
    if lt ua 0
      ua = 2
    end
    ub = int get b i
    if lt ub 0
      ub = 2
    end
    if ne int get zsv i rem add ua ub 3
      zbad = 1
    end
    if ne int get zmv i rem mul ua ub 3
      zbad = 1
    end
  end
  chk eq zbad 0
end

fn exh_pair_z3 a view byte 64 ablk view ulong 2 b view byte 64 bblk view ulong 2 k ulong to void
  za = new ulong 2 0
  zb = new ulong 2 0
  zs = new ulong 2 0
  zm = new ulong 2 0
  chk and eq oma_z3_block_from_trits ablk za 0 eq oma_z3_block_from_trits bblk zb 0
  chk and eq oma_z3_block_add za zb zs 0 eq oma_z3_block_mul za zb zm 0
  zsv = new uchar 64 0
  zmv = new uchar 64 0
  chk and eq oma_z3_block_decode zs zsv 0 eq oma_z3_block_decode zm zmv 0
  exh_pair_z3_cmp a b zsv zmv k
end

fn exh_pair_cmp a view byte 64 b view byte 64 sblk view ulong 2 cblk view ulong 2 mblk view ulong 2 k ulong to int
  nd3 = int 0
  bad = int 0
  for i ulong k bound 8
    ai = int get a i
    bi = int get b i
    if ne blk_lane sblk i naive_add_s ai bi
      bad = 1
    end
    if ne blk_lane cblk i naive_add_c ai bi
      bad = 1
    end
    if ne blk_lane mblk i mul ai bi
      bad = 1
    end
    nd3 = add nd3 mul ai bi
  end
  chk eq bad 0
  ret nd3
end

fn exh_pair a view byte 64 ablk view ulong 2 b view byte 64 bblk view ulong 2 k ulong to void
  sblk = new ulong 2 0
  cblk = new ulong 2 0
  mblk = new ulong 2 0
  d = new int 1 0
  chk eq oma_block_add ablk bblk sblk cblk 0
  chk and eq oma_block_validate sblk 0 eq oma_block_validate cblk 0
  chk and eq oma_block_mul ablk bblk mblk 0 eq oma_block_validate mblk 0
  nd3 = exh_pair_cmp a b sblk cblk mblk k
  u = or get sblk 0 get sblk 1
  u = or u or get cblk 0 get cblk 1
  u = or u or get mblk 0 get mblk 1
  chk eq shr u k 0
  chk and eq oma_block_dot ablk bblk d 0 eq get d 0 nd3
  exh_pair_z3 a ablk b bblk k
end

fn exh_single_pack a view byte 64 ablk view ulong 2 k ulong to void
  dense = new uchar 2 0
  dl = new ulong 1 0
  back = new byte 64 0
  chk and eq oma_pack_dense a k dense dl 0 eq get dl 0 oma_dense_bytes k
  rt_ok = eq oma_unpack_dense dense get dl 0 k back 0
  for i ulong k bound 8
    if ne get back i get a i
      rt_ok = false
    end
  end
  chk rt_ok
  pb = new ulong 2 0
  chk eq oma_pack_bitplane a k pb 1 0
  chk and eq get pb 0 get ablk 0 eq get pb 1 get ablk 1
  bp_ok = eq oma_unpack_bitplane pb 1 k back 0
  for i ulong k bound 8
    if ne get back i get a i
      bp_ok = false
    end
  end
  chk bp_ok
end

fn exh_single_bt a view byte 64 k ulong to void
  iv = new long 1 0
  nav = long 0
  idx = k
  while gt idx 0 bound 8
    idx = sub idx 1
    nav = add mul nav 3 long get a idx
  end
  chk and eq oma_bt_to_int a k iv 0 eq get iv 0 nav
  dg = new byte 41 0
  nd = new ulong 1 0
  chk eq oma_int_to_bt get iv 0 dg 41 nd 0
  top = long k
  while gt top 0 bound 8
    if ne int get a ulong sub top 1 0
      break
    end
    top = sub top 1
  end
  can_ok = eq get nd 0 ulong top
  for i ulong get nd 0 bound 8
    if ne get dg i get a i
      can_ok = false
    end
  end
  chk can_ok
end

fn exh_single a view byte 64 ablk view ulong 2 k ulong to void
  dec = new byte 64 0
  nblk = new ulong 2 0
  rc = oma_block_decode ablk dec
  eq_ok = true
  for i ulong 64
    if ne get dec i get a i
      eq_ok = false
    end
  end
  chk and eq rc 0 eq_ok
  chk eq oma_block_neg ablk nblk 0
  neg_ok = true
  for i ulong 64
    if ne blk_lane nblk i sub 0 int get a i
      neg_ok = false
    end
  end
  chk neg_ok
  exh_single_pack a ablk k
  exh_single_bt a k
end

fn exh_acts ablk view ulong 2 a view byte 64 k ulong to void
  act = new byte 64 0
  d = new int 1 0
  for s ulong 4
    base = mul s 64
    nd2 = int 0
    for i ulong 64
      v = get g_ex_acts add base i
      put act i v
      if lt i k
        nd2 = add nd2 mul int get a i int v
      end
    end
    chk and eq oma_dot_tw_i8 ablk act k d 0 eq get d 0 nd2
  end
end

fn test_exh_fill k ulong nv ulong to void
  va = new byte 64 0
  ab = new ulong 2 0
  for idx ulong nv bound 1000
    tmp = idx
    for j ulong 64
      put va j byte 0
    end
    for j ulong k bound 8
      put va j byte sub int rem tmp 3 1
      tmp = div tmp 3
    end
    base = mul idx 64
    for j ulong 64
      put g_ex_vecs add base j get va j
    end
    chk eq oma_block_encode va ab 0
    put g_ex_blks mul idx 2 get ab 0
    put g_ex_blks add mul idx 2 1 get ab 1
  end
end

fn test_exh_run_ia k ulong nv ulong ia ulong to void
  va = new byte 64 0
  vb = new byte 64 0
  ab = new ulong 2 0
  bb = new ulong 2 0
  base_a = mul ia 64
  for j ulong 64
    put va j get g_ex_vecs add base_a j
  end
  put ab 0 get g_ex_blks mul ia 2
  put ab 1 get g_ex_blks add mul ia 2 1
  exh_single va ab k
  exh_acts ab va k
  for ib ulong nv bound 1000
    base_b = mul ib 64
    for j ulong 64
      put vb j get g_ex_vecs add base_b j
    end
    put bb 0 get g_ex_blks mul ib 2
    put bb 1 get g_ex_blks add mul ib 2 1
    exh_pair va ab vb bb k
  end
end

fn test_exhaustive_small to void
  sec_begin
  for i ulong 64
    put g_ex_acts i byte -128
    put g_ex_acts add 64 i byte 127
    rb = and rnd 255
    if ge rb 128
      put g_ex_acts add 128 i byte sub int rb 256
    else
      put g_ex_acts add 128 i byte rb
    end
    if eq and i 1 1
      put g_ex_acts add 192 i byte -128
    else
      put g_ex_acts add 192 i byte 127
    end
  end
  k = ulong 1
  while le k 6 bound 8
    nv = ulong 1
    for i ulong k bound 8
      nv = mul nv 3
    end
    test_exh_fill k nv
    for ia ulong nv bound 1000
      test_exh_run_ia k nv ia
    end
    k = add k 1
  end
  sec_end sec_exh
end

note ---- section 5: dense bytes (all 256) ----

fn test_dense_valid bv int t view byte 5 to void
  re = new uchar 1 0
  b8 = new uchar 1 0
  ln = new ulong 1 0
  dec5 = new byte 5 0
  chk eq oma_pack_dense t 5 re ln 0
  chk and eq get ln 0 1 eq int get re 0 bv
  put b8 0 uchar bv
  eq5 = eq oma_unpack_dense b8 1 5 dec5 0
  for j ulong 5
    if ne get dec5 j get t j
      eq5 = false
    end
  end
  chk eq5
  n = ulong 1
  while lt n 5 bound 8
    pad_ok = true
    j = n
    while lt j 5 bound 8
      if ne int get t j 0
        pad_ok = false
      end
      j = add j 1
    end
    rc3 = oma_unpack_dense b8 1 n dec5
    if pad_ok
      chk eq rc3 OMA_OK
    else
      chk eq rc3 OMA_E_INVALID_BYTE
    end
    n = add n 1
  end
end

fn test_dense_bytes to void
  sec_begin
  t = new byte 5 0
  buf3 = new uchar 3 0
  out15 = new byte 15 0
  for bv int 256
    for j ulong 5
      put t j byte 9
    end
    rc = oma_dense_byte_decode bv t
    if lt bv 243
      v = ulong bv
      ok = eq rc 0
      for j ulong 5
        if ne int get t j sub int rem v 3 1
          ok = false
        end
        v = div v 3
      end
      chk ok
      test_dense_valid bv t
    else
      chk eq rc OMA_E_INVALID_BYTE
      put buf3 0 uchar 121
      put buf3 1 uchar bv
      put buf3 2 uchar 121
      chk eq oma_unpack_dense buf3 3 15 out15 OMA_E_INVALID_BYTE
    end
  end
  sec_end sec_den
end

note ---- section 6: integer <-> balanced ternary ----

fn test_int_conv_i16_one v long to void
  dg = new byte 41 0
  fx = new byte 11 0
  orc = new byte 11 0
  nd = new ulong 1 0
  back = new long 1 0
  u = add v 88573
  for i ulong 11
    put orc i byte sub int rem u 3 1
    u = div u 3
  end
  chk eq oma_int_to_bt v dg 41 nd 0
  n = get nd 0
  if eq n 0
    chk eq v 0
  else
    chk ne int get dg sub n 1 0
  end
  m_ok = true
  for i ulong n bound 16
    if ne get dg i get orc i
      m_ok = false
    end
  end
  i2 = n
  while lt i2 11 bound 16
    if ne int get orc i2 0
      m_ok = false
    end
    i2 = add i2 1
  end
  chk m_ok
  chk and eq oma_bt_to_int dg n back 0 eq get back 0 v
  fx_ok = eq oma_int_to_bt_fixed v fx 11 0
  for i ulong 11
    if ne get fx i get orc i
      fx_ok = false
    end
  end
  chk fx_ok
  if gt n 0
    chk eq oma_int_to_bt_fixed v fx sub n 1 OMA_E_OVERFLOW
  end
end

fn test_int_conv_i16 to void
  v = long -32768
  while le v 32767 bound 70000
    test_int_conv_i16_one v
    v = add v 1
  end
end

fn test_int_conv_rand to void
  dg = new byte 41 0
  nd = new ulong 1 0
  back = new long 1 0
  fixed = new long 7 0
  put fixed 0 sub long -9223372036854775807 1
  put fixed 1 long -9223372036854775807
  put fixed 2 long 9223372036854775807
  put fixed 3 long 9223372036854775806
  put fixed 4 long -1
  put fixed 5 long 0
  put fixed 6 long 1
  for i ulong 200007 bound 250000
    v = long 0
    if lt i 7
      v = get fixed i
    else
      v = bitcast long rnd
      if eq and i 3 0
        sh = rem rnd 63
        v = shr v sh
      end
    end
    chk and eq oma_int_to_bt v dg 41 nd 0 le get nd 0 41
    n = get nd 0
    if eq n 0
      chk eq v 0
    else
      chk ne int get dg sub n 1 0
    end
    chk and eq oma_bt_to_int dg n back 0 eq get back 0 v
  end
end

fn test_int_conversion to void
  sec_begin
  test_int_conv_i16
  dg = new byte 41 0
  nd = new ulong 1 0
  back = new long 1 0
  m = long 0
  k = ulong 1
  while le k 40 bound 64
    m = add mul 3 m 1
    chk and eq oma_int_to_bt m dg 41 nd 0 eq get nd 0 k
    all1 = true
    for i ulong k bound 64
      if ne int get dg i 1
        all1 = false
      end
    end
    chk all1
    chk and eq oma_int_to_bt sub 0 m dg 41 nd 0 eq get nd 0 k
    chk and eq oma_int_to_bt add m 1 dg 41 nd 0 eq get nd 0 add k 1
    chk eq oma_int_to_bt add m 1 dg k nd OMA_E_OVERFLOW
    k = add k 1
  end
  test_int_conv_rand
  ones = new byte 41 1
  chk eq oma_bt_to_int ones 41 back OMA_E_OVERFLOW
  for i ulong 41
    put ones i byte -1
  end
  chk eq oma_bt_to_int ones 41 back OMA_E_OVERFLOW
  dg2 = new byte 3 0
  put dg2 0 byte 1
  put dg2 1 byte 2
  chk eq oma_bt_to_int dg2 3 back OMA_E_INVALID_TRIT
  lead0 = new byte 5 0
  put lead0 0 byte 1
  chk and eq oma_bt_to_int lead0 5 back 0 eq get back 0 1
  sec_end sec_int
end

note ---- section 7: random block properties ----

fn test_rnd_dot_tw to void
  w = new ulong 16 0
  t = new byte 512 0
  x = new byte 512 0
  d = new int 1 0
  for it ulong 20000
    n = rem rnd 513
    nd2 = int 0
    for i ulong n bound 520
      ti = rnd_trit
      put t i byte ti
      rb = and rnd 255
      xi = int rb
      if ge rb 128
        xi = sub xi 256
      end
      put x i byte xi
      nd2 = add nd2 mul ti xi
    end
    chk eq oma_pack_bitplane t n w 8 0
    chk and eq oma_dot_tw_i8 w x n d 0 eq get d 0 nd2
    if ne rem n 64 0
      bi2 = mul div n 64 2
      kp = get w bi2
      kn = get w add bi2 1
      put w bi2 or kp 0x8000000000000000
      put w add bi2 1 and kn 0x7fffffffffffffff
      chk eq oma_dot_tw_i8 w x n d OMA_E_ARG
      put w bi2 kp
      put w add bi2 1 kn
    end
  end
  chk eq oma_dot_tw_i8 w x add OMA_DOT_I8_MAX_N 1 d OMA_E_OVERFLOW
  chk and eq oma_dot_tw_i8 w x 0 d 0 eq get d 0 0
end

fn test_rnd_blk_cmp a view ulong 2 b view ulong 2 s view ulong 2 c view ulong 2 m view ulong 2 ng view ulong 2 to int
  nd = int 0
  bad = int 0
  for i ulong 64
    la = blk_lane a i
    lb = blk_lane b i
    if ne blk_lane s i naive_add_s la lb
      bad = 1
    end
    if ne blk_lane c i naive_add_c la lb
      bad = 1
    end
    if ne blk_lane m i mul la lb
      bad = 1
    end
    if ne blk_lane ng i sub 0 la
      bad = 1
    end
    nd = add nd mul la lb
  end
  chk eq bad 0
  ret nd
end

fn test_rnd_blk_one to void
  a = new ulong 2 0
  b = new ulong 2 0
  s = new ulong 2 0
  c = new ulong 2 0
  m = new ulong 2 0
  ng = new ulong 2 0
  d = new int 1 0
  rnd_valid_blk a
  rnd_valid_blk b
  chk eq oma_block_add a b s c 0
  chk eq oma_block_mul a b m 0
  chk eq oma_block_neg a ng 0
  chk eq oma_block_dot a b d 0
  nd = test_rnd_blk_cmp a b s c m ng
  chk eq get d 0 nd
  chk eq and get s 0 get s 1 0
  chk eq and get c 0 get c 1 0
  chk eq and get m 0 get m 1 0
end

fn test_random_blocks to void
  sec_begin
  for it ulong 200000
    test_rnd_blk_one
  end
  test_rnd_dot_tw
  sec_end sec_rnd
end

note ---- section 8: pack/unpack random ----

fn test_pack_ser_rt blk view ulong * nb ulong to void
  ser = new uchar 16 0
  one = new ulong 2 0
  rt = new ulong 2 0
  for k ulong nb bound 32
    put one 0 get blk mul k 2
    put one 1 get blk add mul k 2 1
    chk eq oma_block_serialize one ser 0
    chk eq oma_block_deserialize ser rt 0
    chk eq get rt 0 get one 0
    chk eq get rt 1 get one 1
  end
end

fn test_pack_one_bp t view byte * n ulong to void
  back = new byte 1000 0
  blk = new ulong 32 0
  nb = oma_bitplane_blocks n
  chk eq oma_pack_bitplane t n blk 16 0
  test_pack_ser_rt blk nb
  ok2 = eq oma_unpack_bitplane blk nb n back 0
  for i ulong n bound 1024
    if ne get back i get t i
      ok2 = false
    end
  end
  chk ok2
end

fn test_pack_one_bad t edit byte * n ulong exp_dl ulong to void
  dense = new uchar 200 0
  blk = new ulong 32 0
  dl = new ulong 1 0
  j = rem rnd n
  keep = get t j
  if eq and rnd 1 1
    put t j byte 2
  else
    put t j byte -2
  end
  chk eq oma_pack_dense t n dense dl OMA_E_INVALID_TRIT
  chk eq oma_pack_bitplane t n blk 16 OMA_E_INVALID_TRIT
  put t j keep
  if gt exp_dl 1
    chk eq oma_pack_dense t n part dense 0 sub exp_dl 1 dl OMA_E_OVERFLOW
  end
end

fn test_pack_one n ulong to void
  t = new byte 1000 0
  back = new byte 1000 0
  dense = new uchar 200 0
  dl = new ulong 1 0
  for i ulong n bound 1024
    put t i byte rnd_trit
  end
  exp_dl = oma_dense_bytes n
  chk and eq oma_pack_dense t n dense dl 0 eq get dl 0 exp_dl
  ok1 = eq oma_unpack_dense dense get dl 0 n back 0
  for i ulong n bound 1024
    if ne get back i get t i
      ok1 = false
    end
  end
  chk ok1
  test_pack_one_bp t n
  if gt n 0
    test_pack_one_bad t n exp_dl
  end
end

fn test_pack_random to void
  sec_begin
  for it ulong 10000
    test_pack_one rem rnd 1001
  end
  sec_end sec_pk
end

note ---- section 9: Z3 ----

fn test_z3_iso a int b int s int m int to void
  ta = new byte 1 0
  tb = new byte 1 0
  tsc = new byte 2 0
  tm = new byte 1 0
  ms = new byte 1 0
  mm = new byte 1 0
  rc = oma_z3_to_trit a ta
  rc = oma_z3_to_trit b tb
  rc = oma_trit_add int get ta 0 int get tb 0 tsc
  rc = oma_trit_mul int get ta 0 int get tb 0 tm
  rc = oma_z3_to_trit s ms
  rc = oma_z3_to_trit m mm
  chk eq get ms 0 get tsc 0
  chk eq get mm 0 get tm 0
end

fn test_z3_scalar to void
  r = new uchar 1 0
  s = new uchar 1 0
  m = new uchar 1 0
  t = new byte 1 0
  for a int 256
    if le a 2
      chk and eq oma_z3_neg a r 0 eq int get r 0 rem sub 3 a 3
      exp_t = a
      if eq a 2
        exp_t = -1
      end
      chk and eq oma_z3_to_trit a t 0 eq int get t 0 exp_t
      chk and eq oma_trit_to_z3 int get t 0 r 0 eq int get r 0 a
    else
      chk eq oma_z3_neg a r OMA_E_INVALID_Z3
      chk eq oma_z3_to_trit a t OMA_E_INVALID_Z3
    end
    for b int 256
      rca = oma_z3_add a b s
      rcm = oma_z3_mul a b m
      if and le a 2 le b 2
        chk and eq rca 0 eq int get s 0 rem add a b 3
        chk and eq rcm 0 eq int get m 0 rem mul a b 3
        test_z3_iso a b int get s 0 int get m 0
      else
        chk and eq rca OMA_E_INVALID_Z3 eq rcm OMA_E_INVALID_Z3
      end
    end
  end
  tv = int -128
  while le tv 127 bound 300
    if or lt tv -1 gt tv 1
      chk eq oma_trit_to_z3 tv r OMA_E_INVALID_TRIT
    end
    tv = add tv 1
  end
end

fn test_z3_blk_check va view uchar 64 vb view uchar 64 zs view ulong 2 zm view ulong 2 zn view ulong 2 to void
  v = new uchar 64 0
  chk eq oma_z3_block_decode zs v 0
  bad = int 0
  for i ulong 64
    if ne int get v i rem add int get va i int get vb i 3
      bad = 1
    end
  end
  chk eq oma_z3_block_decode zm v 0
  for i ulong 64
    if ne int get v i rem mul int get va i int get vb i 3
      bad = 1
    end
  end
  chk eq oma_z3_block_decode zn v 0
  for i ulong 64
    if ne int get v i rem sub 3 int get va i 3
      bad = 1
    end
  end
  chk eq bad 0
end

fn test_z3_blk_rt va view uchar 64 za view ulong 2 to void
  rt = new uchar 64 0
  eq_ok = eq oma_z3_block_decode za rt 0
  for i ulong 64
    if ne get rt i get va i
      eq_ok = false
    end
  end
  chk eq_ok
end

fn test_z3_blk_one to void
  va = new uchar 64 0
  vb = new uchar 64 0
  za = new ulong 2 0
  zb = new ulong 2 0
  zs = new ulong 2 0
  zm = new ulong 2 0
  zn = new ulong 2 0
  for i ulong 64
    put va i uchar rem rnd 3
    put vb i uchar rem rnd 3
  end
  chk and eq oma_z3_block_encode va za 0 eq oma_z3_block_encode vb zb 0
  test_z3_blk_rt va za
  chk eq oma_z3_block_add za zb zs 0
  chk eq oma_z3_block_mul za zb zm 0
  chk eq oma_z3_block_neg za zn 0
  test_z3_blk_check va vb zs zm zn
end

fn test_z3_blocks to void
  for it ulong 50000
    test_z3_blk_one
  end
  badv = new uchar 64 0
  za = new ulong 2 0
  put badv 5 uchar 3
  chk eq oma_z3_block_encode badv za OMA_E_INVALID_Z3
end

fn test_z3 to void
  sec_begin
  test_z3_scalar
  test_z3_blocks
  sec_end sec_z3
end

note ---- section 10: errors leave outputs untouched ----

fn all_u8 a view uchar * v uchar to bool
  for i ulong len a bound 2048
    if ne get a i v
      ret false
    end
  end
  ret true
end

fn all_i8 a view byte * v byte to bool
  for i ulong len a bound 2048
    if ne get a i v
      ret false
    end
  end
  ret true
end

fn all_u64 a view ulong * v ulong to bool
  for i ulong len a bound 64
    if ne get a i v
      ret false
    end
  end
  ret true
end

fn test_err_bp to void
  sent_i8 = byte 0x5a
  sent_u64 = ulong 0x5a5a5a5a5a5a5a5a
  t100 = new byte 100 0
  ob4 = new ulong 4 0x5a5a5a5a5a5a5a5a
  put t100 80 byte 5
  chk and eq oma_pack_bitplane t100 100 ob4 2 OMA_E_INVALID_TRIT all_u64 ob4 sent_u64
  put t100 80 byte 0
  chk and eq oma_pack_bitplane t100 100 ob4 1 OMA_E_OVERFLOW all_u64 ob4 sent_u64

  in_bp = new ulong 4 0
  put in_bp 0 ulong 1
  put in_bp 2 ulong 1
  put in_bp 3 ulong 1
  out100 = new byte 100 0x5a
  chk and eq oma_unpack_bitplane in_bp 2 100 out100 OMA_E_INVALID_PLANES all_i8 out100 sent_i8
  put in_bp 3 ulong 0
  put in_bp 2 shl ulong 1 40
  chk and eq oma_unpack_bitplane in_bp 2 100 out100 OMA_E_ARG all_i8 out100 sent_i8
  chk and eq oma_unpack_bitplane in_bp 1 100 out100 OMA_E_ARG all_i8 out100 sent_i8
end

fn test_err_dense to void
  sent_u8 = uchar 0x5a
  sent_i8 = byte 0x5a
  t15 = new byte 15 0
  put t15 14 byte 3
  od3 = new uchar 3 0x5a
  ln = new ulong 1 777
  chk and eq oma_pack_dense t15 15 od3 ln OMA_E_INVALID_TRIT and all_u8 od3 sent_u8 eq get ln 0 777
  put t15 14 byte 0
  chk and eq oma_pack_dense t15 15 part od3 0 2 ln OMA_E_OVERFLOW and all_u8 od3 sent_u8 eq get ln 0 777

  in3 = new uchar 3 121
  put in3 2 uchar 250
  out15 = new byte 15 0x5a
  chk and eq oma_unpack_dense in3 3 15 out15 OMA_E_INVALID_BYTE all_i8 out15 sent_i8
  in2 = new uchar 2 121
  put in2 1 uchar 0
  chk and eq oma_unpack_dense in2 2 6 out15 OMA_E_INVALID_BYTE all_i8 out15 sent_i8
  chk and eq oma_unpack_dense in3 2 15 out15 OMA_E_ARG all_i8 out15 sent_i8
  d5 = new byte 5 0x5a
  chk and eq oma_dense_byte_decode 243 d5 OMA_E_INVALID_BYTE all_i8 d5 sent_i8
end

fn test_err_bt to void
  sent_i8 = byte 0x5a
  dg41 = new byte 41 0x5a
  nd1 = new ulong 1 777
  chk and eq oma_int_to_bt 9223372036854775807 dg41 40 nd1 OMA_E_OVERFLOW and all_i8 dg41 sent_i8 eq get nd1 0 777
  chk and eq oma_int_to_bt_fixed 13 dg41 2 OMA_E_OVERFLOW all_i8 dg41 sent_i8
  v1 = new long 1 0x5a5a5a5a
  digs = new byte 41 0
  put digs 40 byte 2
  chk and eq oma_bt_to_int digs 41 v1 OMA_E_INVALID_TRIT eq get v1 0 0x5a5a5a5a
  for i ulong 41
    put digs i byte 1
  end
  chk and eq oma_bt_to_int digs 41 v1 OMA_E_OVERFLOW eq get v1 0 0x5a5a5a5a
end

fn test_err_quant to void
  sent_i8 = byte 0x5a
  w8 = new f32 8 1.0f32
  put w8 7 bitcast f32 uint 0x7fc00000
  q8 = new byte 8 0x5a
  sc1 = new f32 1 12.5f32
  er1 = new f64 1 12.5f64
  chk and eq oma_quant_absmean w8 8 q8 sc1 OMA_E_ARG and all_i8 q8 sent_i8 eq get sc1 0 12.5f32
  den3 = new f32 3 0.0f32
  put den3 0 mul 2.0f32 bitcast f32 uint 0x00000001
  chk and eq oma_quant_absmean den3 3 part q8 0 3 sc1 OMA_E_UNDERFLOW and all_i8 q8 sent_i8 eq get sc1 0 12.5f32
  q3 = new byte 3 0
  put q3 0 byte 1
  chk and eq oma_quant_rel_l2 part w8 0 3 q3 bitcast f32 uint 0x7fc00000 er1 OMA_E_ARG eq get er1 0 12.5f64
  chk and eq oma_quant_rel_l2 part w8 0 3 q3 -1.0f32 er1 OMA_E_ARG eq get er1 0 12.5f64
end

fn test_error_untouched to void
  sec_begin
  test_err_bp
  test_err_dense
  test_err_bt
  test_err_quant
  sec_end sec_err
end

note ---- section 11: absmean quantization ----

fn cmp_x_mean x f64 s_sum long n ulong e int to int
  l = oma_f64_ldexp mul x f64 n e
  r = f64 s_sum
  if lt l r
    ret -1
  end
  if gt l r
    ret 1
  end
  ret 0
end

fn nextafter_f32_down s f32 to f32
  bits = bitcast uint s
  if eq bits 0
    ret 0.0f32
  end
  ret bitcast f32 sub bits 1
end

fn nextafter_f32_up s f32 to f32
  bits = bitcast uint s
  ret bitcast f32 add bits 1
end

fn quant_oracle_ok n ulong e int rc int s f32 to bool
  s_sum = long 0
  for i ulong n bound 2048
    ki = long get g_q_kk i
    if lt ki 0
      s_sum = sub s_sum ki
    else
      s_sum = add s_sum ki
    end
  end
  if eq s_sum 0
    if or ne rc 0 ne s 0.0f32
      ret false
    end
    for i ulong n bound 2048
      if ne int get g_q_q i 0
        ret false
      end
    end
    ret true
  end
  flt_min = bitcast f32 uint 0x00800000
  if gt cmp_x_mean f64 flt_min s_sum n e 0
    ret eq rc OMA_E_UNDERFLOW
  end
  if or ne rc 0 or lt s flt_min not oma_f32_isfinite s
    ret false
  end
  lo = mul add f64 s f64 nextafter_f32_down s 0.5f64
  hi = mul add f64 s f64 nextafter_f32_up s 0.5f64
  if or gt cmp_x_mean lo s_sum n e 0 lt cmp_x_mean hi s_sum n e 0
    ret false
  end
  th = oma_f64_ldexp f64 s e
  for i ulong n bound 2048
    ki = get g_q_kk i
    ak = mul 2.0f64 fabs f64 ki
    exp = int 0
    if ge ak th
      if gt ki 0
        exp = 1
      else
        exp = -1
      end
    end
    if ne int get g_q_q i exp
      ret false
    end
  end
  ret true
end

fn chk_q4 q view byte 4 a int b int c int d int to bool
  ok = eq int get q 0 a
  ok = and ok eq int get q 1 b
  ok = and ok eq int get q 2 c
  ret and ok eq int get q 3 d
end

fn test_quant_hand1 to void
  q = new byte 4 0
  s = new f32 1 0.0f32
  er = new f64 1 0.0f64
  w = new f32 4 0.0f32

  put w 0 0.5f32
  put w 1 -1.5f32
  put w 2 0.0f32
  put w 3 2.0f32
  rc = oma_quant_absmean w 4 q s
  chk and eq rc 0 and eq get s 0 1.0f32 chk_q4 q 1 -1 0 1
  rc2 = oma_quant_rel_l2 w q get s 0 er
  chk and eq rc2 0 lt fabs sub get er 0 fsqrt div 1.5f64 6.5f64 0.000000000000001f64

  put w 0 0.25f32
  put w 1 -0.25f32
  put w 2 1.0f32
  put w 3 0.5f32
  rc = oma_quant_absmean w 4 q s
  chk and eq rc 0 and eq get s 0 0.5f32 chk_q4 q 1 -1 1 1
  rc2 = oma_quant_rel_l2 w q get s 0 er
  chk and eq rc2 0 lt fabs sub get er 0 fsqrt div 3.0f64 11.0f64 0.000000000000001f64

  eps25 = f32 oma_f64_ldexp 1.0f64 -25
  put w 0 2.5f32
  put w 1 -1.0f32
  put w 2 sub 0.5f32 eps25
  put w 3 eps25
  rc = oma_quant_absmean w 4 q s
  chk and eq rc 0 and eq get s 0 1.0f32 chk_q4 q 1 -1 0 0

  put w 0 0.1f32
  put w 1 0.2f32
  put w 2 0.3f32
  put w 3 -0.4f32
  rc = oma_quant_absmean w 4 q s
  chk and eq rc 0 and lt fabs sub f64 get s 0 0.25f64 0.0000001f64 chk_q4 q 0 1 1 -1
end

fn test_quant_hand3 to void
  s = new f32 1 0.0f32
  er = new f64 1 0.0f64
  z3 = new f32 3 0.0f32
  q3 = new byte 3 0
  flt_min = bitcast f32 uint 0x00800000
  put z3 0 mul 2.0f32 bitcast f32 uint 0x00000001
  chk eq oma_quant_absmean z3 3 q3 s OMA_E_UNDERFLOW
  put z3 0 mul 3.0f32 flt_min
  chk eq oma_quant_absmean z3 3 q3 s 0
  chk eq get s 0 flt_min
  chk and eq int get q3 0 1 and eq int get q3 1 0 eq int get q3 2 0
  put z3 0 flt_min
  chk eq oma_quant_absmean z3 3 q3 s OMA_E_UNDERFLOW
  w = new f32 4 0.0f32
  q = new byte 4 0
  flt_max = bitcast f32 uint 0x7f7fffff
  put w 0 flt_max
  put w 1 neg flt_max
  put w 2 flt_max
  put w 3 0.0f32
  chk and eq oma_quant_absmean w 4 q s 0 and oma_f32_isfinite get s 0 chk_q4 q 1 -1 1 0
  chk and eq oma_quant_rel_l2 w q get s 0 er 0 oma_f64_isfinite get er 0
end

fn test_quant_hand2 to void
  s = new f32 1 0.0f32
  er = new f64 1 0.0f64
  z3 = new f32 3 0.0f32
  q3 = new byte 3 0
  chk eq oma_quant_absmean z3 3 q3 s 0
  chk eq get s 0 0.0f32
  chk and eq int get q3 0 0 and eq int get q3 1 0 eq int get q3 2 0
  chk and eq oma_quant_rel_l2 z3 q3 get s 0 er 0 eq get er 0 0.0f64
  bad2 = new f32 2 1.0f32
  put bad2 1 bitcast f32 uint 0x7fc00000
  chk eq oma_quant_absmean bad2 2 part q3 0 2 s OMA_E_ARG
  put bad2 1 bitcast f32 uint 0x7f800000
  chk eq oma_quant_absmean bad2 2 part q3 0 2 s OMA_E_ARG
  put q3 0 byte 2
  chk eq oma_quant_rel_l2 part z3 0 1 part q3 0 1 1.0f32 er OMA_E_INVALID_TRIT
  test_quant_hand3
end

fn test_quant_idem n ulong to void
  w = new f32 1024 0.0f32
  q = new byte 1024 0
  s = new f32 1 0.0f32
  er = new f64 1 0.0f64
  nnz = ulong 0
  for i ulong n bound 1024
    ti = rnd_trit
    put w i f32 ti
    if ne ti 0
      nnz = add nnz 1
    end
  end
  chk eq oma_quant_absmean w n q s 0
  same = true
  for i ulong n bound 1024
    if ne int get q i int get w i
      same = false
    end
  end
  chk same
  chk eq get s 0 f32 div f64 nnz f64 n
  if eq nnz n
    chk and eq oma_quant_rel_l2 part w 0 n part q 0 n get s 0 er 0 eq get er 0 0.0f64
  end
end

fn test_quant_requant n ulong sv f32 to void
  w2 = new f32 1024 0.0f32
  q2 = new byte 1024 0
  s2 = new f32 1 0.0f32
  kq = ulong 0
  for i ulong n bound 1024
    qi = int get g_q_q i
    put w2 i mul f32 qi sv
    if ne qi 0
      kq = add kq 1
    end
  end
  rc2 = oma_quant_absmean w2 n q2 s2
  flt_min = bitcast f32 uint 0x00800000
  lhs = mul f64 kq f64 sv
  rhs = mul f64 flt_min f64 n
  if and gt kq 0 lt lhs rhs
    chk eq rc2 OMA_E_UNDERFLOW
  else
    same2 = eq rc2 0
    for i ulong n bound 1024
      if ne get g_q_q i get q2 i
        same2 = false
      end
    end
    chk same2
  end
end

fn test_quant_dyadic_fill w edit f32 * n ulong e2 int sp ulong to void
  neg_e = sub 0 e2
  for i ulong n bound 1024
    kv = sub int rem rnd 2097152 1048576
    if eq sp 0
      if ne rem rnd 8 0
        kv = 0
      end
    end
    if eq sp 1
      kv = shr kv rem rnd 21
    end
    put g_q_kk i kv
    put w i f32 oma_f64_ldexp f64 kv neg_e
  end
end

fn test_quant_dyadic_err w view f32 * q view byte * sv f32 to void
  er = new f64 1 0.0f64
  chk eq oma_quant_rel_l2 w q sv er 0
  chk and oma_f64_isfinite get er 0 ge get er 0 0.0f64
end

fn test_quant_dyadic n ulong odd ulong to void
  w = new f32 1024 0.0f32
  q = new byte 1024 0
  s = new f32 1 0.0f32
  e2 = int rem rnd 40
  if eq odd 1
    e2 = add 110 e2
  end
  sp = rem rnd 4
  test_quant_dyadic_fill w n e2 sp
  rc = oma_quant_absmean w n q s
  for i ulong n bound 1024
    put g_q_q i get q i
  end
  chk quant_oracle_ok n e2 rc get s 0
  if eq rc 0
    test_quant_requant n get s 0
    test_quant_dyadic_err part w 0 n part q 0 n get s 0
  end
end

fn test_quant to void
  sec_begin
  test_quant_hand1
  test_quant_hand2
  for it ulong 5000
    n = add 1 rem rnd 1024
    test_quant_idem n
    test_quant_dyadic n and it 1
  end
  sec_end sec_qnt
end

fn main to int
  put g_rng 0 ulong 0x0a1e0b1e5eed
  test_constructors
  test_trit_truth_tables
  test_invalid_blocks
  test_exhaustive_small
  test_dense_bytes
  test_int_conversion
  test_random_blocks
  test_pack_random
  test_z3
  test_error_untouched
  test_quant
  oma_put_str t_hdr
  oma_put_u64 1 get g_chk 0
  oma_put_str t_chk_s
  oma_put_u64 1 get g_chk 1
  if eq get g_chk 1 0
    oma_put_str t_arrow_p
    ret 0
  end
  oma_put_str t_arrow_f
  ret 1
end

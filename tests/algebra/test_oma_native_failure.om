note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 native failure / error-preservation invariant test.
note Replaces tests/algebra/test_oma_native_failure.c.
note Concatenated after src/algebra/oma_lib.om.

text nf_pass "PASS test_oma_native_failure (error paths preserve outputs untouched)\n"
text nf_fail "FAIL test_oma_native_failure\n"

fn main to int
  bad_ser = new uchar 16 0
  put bad_ser 0 uchar 1
  put bad_ser 8 uchar 1
  blk = new ulong 2 0
  put blk 0 ulong 123
  put blk 1 ulong 456
  rc1 = oma_block_deserialize bad_ser blk
  if ne rc1 OMA_E_INVALID_PLANES
    oma_put_err nf_fail
    ret 1
  end
  if or ne get blk 0 123 ne get blk 1 456
    oma_put_err nf_fail
    ret 1
  end

  trits = new byte 6 0
  put trits 5 byte 2
  packed = new uchar 2 0
  put packed 0 uchar 12
  put packed 1 uchar 34
  sz = new ulong 1 42
  rc2 = oma_pack_dense trits 6 packed sz
  if ne rc2 OMA_E_INVALID_TRIT
    oma_put_err nf_fail
    ret 2
  end
  if or ne get packed 0 12 or ne get packed 1 34 ne get sz 0 42
    oma_put_err nf_fail
    ret 2
  end

  put trits 5 byte 0
  rc3 = oma_pack_dense trits 6 part packed 0 1 sz
  if ne rc3 OMA_E_OVERFLOW
    oma_put_err nf_fail
    ret 3
  end
  if or ne get packed 0 12 or ne get packed 1 34 ne get sz 0 42
    oma_put_err nf_fail
    ret 3
  end

  oma_put_str nf_pass
  ret 0
end

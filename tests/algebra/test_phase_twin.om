note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 phase-domain Z3 digital twin test suite (gates 1-3 + self-checks).
note Replaces tests/algebra/test_phase_twin.c.
note Concatenated after src/algebra/oma_lib.om + src/algebra/phase_twin.om.

const Z999 f64 3.2905267314919255
const Z95 f64 1.959963984540054
const CONTRACT_P f64 0.000001
const CONTRACT_ALPHA f64 0.05
const CONTRACT_RHO_DB f64 25.0

global pt_quick int 1
global pt_rfd int 1
global pt_gfail int 1
global pt_rpath uchar 256
global pt_rpath_len ulong 1

note tally: [0]=trials, [1]=mismatches, [2]=flagged, [3]=failures
global pt_tal_u ulong 4
global pt_tal_maxd f64 1

text t_def_path "phase_twin_receipt.json"
text t_qflag "--quick"
text t_pt_pass "PHASE_TWIN PASS (receipt "
text t_pt_fail "PHASE_TWIN FAIL (receipt "
text t_pt_end ")\n"
text t_sc_p "self-checks PASS\n"
text t_sc_f "self-checks FAIL\n"
text t_g1_p "gate1 PASS\n"
text t_g1_f "gate1 FAIL\n"
text t_g1b_p "gate1b PASS\n"
text t_g1b_f "gate1b FAIL\n"
text t_g2_p "gate2 PASS\n"
text t_g2_f "gate2 FAIL\n"
text t_g3_p "gate3 PASS\n"
text t_g3_f "gate3 FAIL\n"

text j_open "{\n  \"schema\": \"OMEGA_MIXED_ALGEBRA_PHASE_TWIN_V1\",\n  \"provenance\": \"SIMULATED_DEVELOPMENT\",\n  \"language\": \"OM-2\",\n  \"run_mode\": \""
text j_mode_full "full"
text j_mode_quick "quick"
text j_hdr_end "\",\n"
text j_sc_k "  \"self_checks\": {\"pass\": "
text j_g1_k "},\n  \"gate1_noiseless\": {\"pass\": "
text j_g1b_k "},\n  \"gate1b_reference_operating_point\": {\"pass\": "
text j_g2_k "},\n  \"gate2_snr_curve\": {\"pass\": "
text j_g3_k "},\n  \"gate3_calibration\": {\"pass\": "
text j_ver_k "},\n  \"verified\": "
text j_ov_p ",\n  \"overall\": \"PASS\"\n}\n"
text j_ov_f ",\n  \"overall\": \"FAIL\"\n}\n"
text j_true "true"
text j_false "false"
text j_one "1"
text j_zero "0"
text j_comma_chk ", \"checks\": "
text j_comma_fail ", \"failures\": "
text j_comma_cal ", \"calibrations\": "

fn rput s view uchar * to void
  oma_w_all get pt_rfd 0 s len s
end

fn rbool ok bool to void
  if ok
    rput j_true
  else
    rput j_false
  end
end

fn pt_scale n ulong to ulong
  if ne get pt_quick 0 0
    ret div n 50
  end
  ret n
end

fn pt_design_a to void
  put pt_cf 0 125000000.0f64
  put pt_ci 0 64
  put pt_ci 1 4096
  put pt_cf 1 0.5f64
  put pt_ci 2 14
  put pt_ci 3 14
  put pt_cf 2 0.0f64
  put pt_cf 3 0.0f64
  put pt_cf 4 0.0f64
  put pt_cf 5 0.0f64
  put pt_cf 6 0.0f64
  put pt_cf 7 0.0f64
  put pt_cf 8 div 8192.0f64 125000000.0f64
  put pt_ci 4 PT_ADD_CORR_PRODUCT
  put pt_ci 5 0
  put pt_ci 6 0
  put pt_ci 7 0
  put pt_cf 9 0.0f64
  put pt_cf 10 0.3f64
  put pt_cf 11 30.0f64
end

fn pt_design_b to void
  pt_design_a
  put pt_cf 0 1000000.0f64
  put pt_ci 1 1024
  put pt_ci 2 12
  put pt_ci 3 12
  put pt_cf 8 div 2048.0f64 1000000.0f64
end

fn run_pair_one op int a int b int to void
  want = new uchar 1 0
  dist = new f64 1 0.0f64
  rc = int 0
  orc = int 0
  if ne op 0
    rc = pt_twin_mul_const a b
    orc = oma_z3_mul a b want
  else
    rc = pt_twin_add a b
    orc = oma_z3_add a b want
  end
  if or ne rc PT_OK ne orc OMA_OK
    put pt_gfail 0 add get pt_gfail 0 1
    ret
  end
  dmy = pt_decode pt_deg2rad get pt_res_ph 0 dist
  if gt get dist 0 get pt_tal_maxd 0
    put pt_tal_maxd 0 get dist 0
  end
  put pt_tal_u 0 add get pt_tal_u 0 1
  bad = ulong 0
  if ne get pt_res_i 0 int get want 0
    put pt_tal_u 1 add get pt_tal_u 1 1
    bad = 1
  end
  if ne get pt_res_i 3 0
    put pt_tal_u 2 add get pt_tal_u 2 1
    bad = 1
  end
  put pt_tal_u 3 add get pt_tal_u 3 bad
end

fn run_pairs seed ulong op int reps ulong to void
  for i ulong 4
    put pt_tal_u i 0
  end
  put pt_tal_maxd 0 0.0f64
  if ne pt_twin_init seed PT_OK
    put pt_gfail 0 add get pt_gfail 0 1
    ret
  end
  for r ulong reps bound 2000
    for a int 3
      for b int 3
        run_pair_one op a b
      end
    end
  end
end

fn test_sc_rng to bool
  ra = new ulong 5 0
  rb = new ulong 5 0
  spa = new f64 1 0.0f64
  spb = new f64 1 0.0f64
  pt_rng_seed ra spa 42
  pt_rng_seed rb spb 42
  ok = true
  s1 = 0.0f64
  s2 = 0.0f64
  for i ulong 50000
    ga = pt_rng_gauss ra spa
    gb = pt_rng_gauss rb spb
    if ne ga gb
      ok = false
    end
    s1 = add s1 ga
    s2 = add s2 mul ga ga
  end
  if or ge fabs div s1 50000.0f64 0.02f64 ge fabs sub div s2 50000.0f64 1.0f64 0.03f64
    ok = false
  end
  ret ok
end

fn test_self_checks to bool
  ok = true
  d = new f64 1 0.0f64
  if or ne pt_decode 0.0f64 d 0 ne get d 0 0.0f64
    ok = false
  end
  if ne pt_decode div PT_TWO_PI 3.0f64 d 1
    ok = false
  end
  if ne pt_decode neg div PT_TWO_PI 3.0f64 d 2
    ok = false
  end
  if eq pt_decode PT_PI d 0
    ok = false
  end
  if or ne pt_decode pt_deg2rad 59.9f64 d 0 ne pt_decode pt_deg2rad 60.1f64 d 1
    ok = false
  end
  w22 = add mul uint 2 PT_NCO_THIRD mul uint 2 PT_NCO_THIRD
  if ne pt_decode mul PT_TWO_PI div f64 w22 4294967296.0f64 d 1
    ok = false
  end

  pt_design_b
  if ne pt_twin_init 1 PT_OK
    ok = false
  end
  if or ne pt_twin_add 3 0 PT_E_ARG ne pt_twin_add 0 -1 PT_E_ARG
    ok = false
  end
  if ne pt_twin_mul_const 0 3 PT_E_ARG
    ok = false
  end
  put pt_ci 1 100
  if ne pt_twin_init 1 PT_E_ARG
    ok = false
  end

  ok = and ok test_sc_rng

  e1 = pt_ref_add_exact 10.0f64 360
  e2 = pt_ref_add_exact 10.0f64 720
  if ge div fabs sub e1 e2 e2 0.005f64
    ok = false
  end
  if ge fabs sub pt_ref_single_craig 1.0f64 0.1834f64 0.0005f64
    ok = false
  end
  wi = new f64 2 0.0f64
  pt_wilson 0 4000000 Z95 wi
  if or ne get wi 0 0.0f64 ge get wi 1 0.000001f64
    ok = false
  end

  if ok
    oma_put_str t_sc_p
  else
    oma_put_str t_sc_f
  end
  rput j_sc_k
  rbool ok
  ret ok
end

fn test_gate1 to bool
  ok = true
  reps = ulong 200
  if ne get pt_quick 0 0
    reps = 20
  end
  tot_chk = ulong 0
  tot_fail = ulong 0
  seed = ulong 0x5a31
  for d ulong 3
    for m ulong 3
      if eq d 0
        pt_design_a
      else
        pt_design_b
        if eq d 2
          put pt_ci 2 0
          put pt_ci 3 0
        end
      end
      put pt_ci 4 add int m 1
      run_pairs seed 0 reps
      seed = add seed 1
      tot_chk = add tot_chk get pt_tal_u 0
      tot_fail = add tot_fail get pt_tal_u 3
      if or ne get pt_tal_u 0 mul 9 reps ne get pt_tal_u 3 0
        ok = false
      end
    end
  end

  pt_design_b
  put pt_ci 5 1
  put pt_ci 6 1000
  put pt_ci 7 1
  put pt_cf 9 5.0f64
  run_pairs 0x5a40 1 reps
  tot_chk = add tot_chk get pt_tal_u 0
  tot_fail = add tot_fail get pt_tal_u 3
  if or ne get pt_tal_u 0 mul 9 reps ne get pt_tal_u 3 0
    ok = false
  end

  if ok
    oma_put_str t_g1_p
  else
    oma_put_str t_g1_f
  end
  rput j_g1_k
  rbool ok
  rput j_comma_chk
  oma_put_u64 get pt_rfd 0 tot_chk
  rput j_comma_fail
  oma_put_u64 get pt_rfd 0 tot_fail
  ret ok
end

fn test_gate1b to bool
  pt_design_a
  put pt_cf 2 div get pt_cf 1 fsqrt 200000000.0f64
  put pt_cf 3 mul mul 360.0f64 div get pt_cf 0 64.0f64 0.000000000001f64
  put pt_cf 5 3.35f64
  put pt_ci 5 1
  put pt_ci 6 1000
  put pt_ci 7 8
  put pt_cf 9 5.0f64
  reps = ulong 200
  if ne get pt_quick 0 0
    reps = 20
  end
  run_pairs 0x1b00 0 reps
  ok = and eq get pt_tal_u 0 mul 9 reps eq get pt_tal_u 3 0
  if ok
    oma_put_str t_g1b_p
  else
    oma_put_str t_g1b_f
  end
  rput j_g1b_k
  rbool ok
  rput j_comma_chk
  oma_put_u64 get pt_rfd 0 get pt_tal_u 0
  rput j_comma_fail
  oma_put_u64 get pt_rfd 0 get pt_tal_u 3
  ret ok
end

fn g2_run_trials tr ulong errs edit ulong 2 to void
  err = ulong 0
  err_s = ulong 0
  want = new uchar 1 0
  for t ulong tr bound 500000
    a = int rem t 3
    b = int rem div t 3 3
    rc = pt_twin_add a b
    orc = oma_z3_add a b want
    if ne get pt_res_i 0 int get want 0
      err = add err 1
    end
    if ne get pt_res_i 1 a
      err_s = add err_s 1
    end
  end
  put errs 0 err
  put errs 1 err_s
end

fn g2_point idx ulong rho_db f64 tr ulong note_add f64 note_s f64 to bool
  rho = pt_pow10 div rho_db 10.0f64
  pt_design_b
  put pt_ci 1 64
  put pt_ci 2 0
  put pt_ci 3 0
  put pt_cf 10 0.0f64
  put pt_cf 11 0.0f64
  put pt_cf 8 0.000128f64
  put pt_cf 2 pt_sigma_for_rho get pt_cf 1 64 rho
  if ne pt_twin_init add 0x2000 idx PT_OK
    ret false
  end
  errs = new ulong 2 0
  g2_run_trials tr errs
  exact = pt_ref_add_exact rho 720
  craig = pt_ref_single_craig rho
  w = new f64 2 0.0f64
  pt_wilson get errs 0 tr Z999 w
  if or lt exact get w 0 gt exact get w 1
    ret false
  end
  if ge rho_db 9.0f64
    if gt div fabs sub note_add exact exact 0.05f64
      ret false
    end
  end
  if ge mul craig f64 tr 100.0f64
    pt_wilson get errs 1 tr Z999 w
    if or lt craig get w 0 gt craig get w 1
      ret false
    end
  end
  if gt div fabs sub craig note_s note_s 0.01f64
    ret false
  end
  ret true
end

fn test_gate2 to bool
  ok = true
  ok = and ok g2_point 0 0.0f64 pt_scale 50000 0.352f64 0.1834f64
  ok = and ok g2_point 1 6.0f64 pt_scale 100000 0.0576f64 0.01371f64
  ok = and ok g2_point 2 8.0f64 pt_scale 150000 0.0152f64 0.002037f64
  ok = and ok g2_point 3 10.0f64 pt_scale 200000 0.00196f64 0.0001065f64
  ok = and ok g2_point 4 12.0f64 pt_scale 400000 0.0000846f64 0.000001082f64

  pt_design_b
  put pt_ci 1 64
  put pt_ci 2 0
  put pt_ci 3 0
  put pt_cf 10 0.0f64
  put pt_cf 11 0.0f64
  put pt_cf 8 0.000128f64
  put pt_cf 3 15.0f64
  put pt_cf 2 0.0f64
  jt = pt_scale 200000
  jerr = ulong 0
  want = new uchar 1 0
  jw = new f64 2 0.0f64
  if ne pt_twin_init 0x2100 PT_OK
    ok = false
  else
    for t ulong jt bound 300000
      a = int rem t 3
      b = int rem div t 3 3
      rc = pt_twin_add a b
      orc = oma_z3_add a b want
      if ne get pt_res_i 0 int get want 0
        jerr = add jerr 1
      end
    end
    jref = pt_ref_add_jitter 15.0f64
    pt_wilson jerr jt Z999 jw
    if or lt jref get jw 0 gt jref get jw 1
      ok = false
    end
  end

  if ok
    oma_put_str t_g2_p
  else
    oma_put_str t_g2_f
  end
  rput j_g2_k
  rbool ok
  ret ok
end

fn pt_contract_point to void
  pt_design_b
  put pt_ci 1 64
  put pt_cf 8 0.000128f64
  put pt_cf 2 pt_sigma_for_rho get pt_cf 1 64 pt_pow10 div CONTRACT_RHO_DB 10.0f64
  put pt_cf 3 1.0f64
  put pt_ci 6 1000
  put pt_ci 7 32
  put pt_cf 9 5.0f64
end

fn g3_step a int b int to ulong
  want = new uchar 1 0
  rc = pt_twin_add a b
  orc = oma_z3_add a b want
  if ne get pt_res_i 0 int get want 0
    ret 1
  end
  if ne get pt_res_i 3 0
    ret 1
  end
  ret 0
end

fn g3_run_case seed ulong tr ulong to ulong
  if ne pt_twin_init seed PT_OK
    put pt_gfail 0 add get pt_gfail 0 1
    ret 1
  end
  in_st = new ulong 5 0
  in_sp = new f64 1 0.0f64
  pt_rng_seed in_st in_sp xor seed 0xc0ffee
  fails = ulong 0
  for i ulong tr bound 600000
    x = pt_rng_next in_st
    a = int rem x 3
    b = int rem shr x 32 3
    fails = add fails g3_step a b
  end
  ret fails
end

fn g3_check_pair cid ulong seed_base ulong uncal_n ulong cal_n ulong to bool
  off0 = 0.0f64
  off1 = 0.0f64
  dr0 = 0.0f64
  dr1 = 0.0f64
  if ne cid 1
    off0 = 50.0f64
    off1 = 20.0f64
  end
  if ne cid 0
    dr0 = 2.0f64
    dr1 = 1.5f64
  end
  w = new f64 2 0.0f64
  pt_contract_point
  put pt_cf 4 off0
  put pt_cf 5 off1
  put pt_cf 6 dr0
  put pt_cf 7 dr1
  put pt_ci 5 0
  fu = g3_run_case seed_base uncal_n
  pt_wilson fu uncal_n Z95 w
  ok_u = gt get w 0 CONTRACT_P

  pt_contract_point
  put pt_cf 4 off0
  put pt_cf 5 off1
  put pt_cf 6 dr0
  put pt_cf 7 dr1
  put pt_ci 5 1
  fc = g3_run_case add seed_base 1 cal_n
  ok_c = eq fc 0
  ret and ok_u ok_c
end

fn test_gate3 to bool
  ok = true
  ok = and ok g3_check_pair 0 0x3000 pt_scale 50000 pt_scale 50000
  ok = and ok g3_check_pair 1 0x3002 300000 pt_scale 100000
  ok = and ok g3_check_pair 2 0x3004 pt_scale 50000 pt_scale 200000
  if ok
    oma_put_str t_g3_p
  else
    oma_put_str t_g3_f
  end
  rput j_g3_k
  rbool ok
  rput j_comma_cal
  oma_put_u64 get pt_rfd 0 get pt_st_u 5
  ret ok
end

fn parse_args to void
  put pt_quick 0 0
  for i ulong len t_def_path bound 64
    put pt_rpath i get t_def_path i
  end
  put pt_rpath_len 0 len t_def_path
  ac = int argcnt
  buf = new uchar 256 0
  i = int 1
  while lt i ac bound 32
    k = argread ulong i buf 0 256
    if gt k 0
      uk = ulong k
      is_q = eq uk len t_qflag
      if is_q
        for j ulong uk bound 16
          if ne get buf j get t_qflag j
            is_q = false
          end
        end
      end
      if is_q
        put pt_quick 0 1
      else
        for j ulong uk bound 256
          put pt_rpath j get buf j
        end
        put pt_rpath_len 0 uk
      end
    end
    i = add i 1
  end
end

fn main to int
  parse_args
  pbuf = new uchar 256 0
  plen = get pt_rpath_len 0
  for i ulong plen bound 256
    put pbuf i get pt_rpath i
  end
  fd = fopen pbuf 0 plen 577 420
  if lt fd 0
    ret 2
  end
  put pt_rfd 0 int fd
  rput j_open
  if ne get pt_quick 0 0
    rput j_mode_quick
  else
    rput j_mode_full
  end
  rput j_hdr_end

  s = test_self_checks
  g1 = test_gate1
  g1b = test_gate1b
  g2 = test_gate2
  g3 = test_gate3
  all_ok = and and and s g1 and g1b g2 and g3 eq get pt_gfail 0 0

  rput j_ver_k
  if all_ok
    rput j_one
    rput j_ov_p
  else
    rput j_zero
    rput j_ov_f
  end
  rc_c = fclose int fd

  if all_ok
    oma_put_str t_pt_pass
  else
    oma_put_str t_pt_fail
  end
  oma_w_all 1 pbuf plen
  oma_put_str t_pt_end
  if all_ok
    ret 0
  end
  ret 1
end

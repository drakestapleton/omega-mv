note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 MA_DIGITAL_V1 bottom (perp) coverage test.
note Replaces tests/algebra/test_ma_digital_bottom.c.
note Concatenated after src/algebra/oma_lib.om + src/algebra/realize.om.

global b_chk ulong 2
global b_rng ulong 1
global b_cnts ulong 2

text b_pass "PASS "
text b_fail "FAIL "
text b_s1 "H1 perp refused (encode/decode/add/mul/dot) "
text b_s2 "every non-trit int8 refused by every pack   "
text b_s3 "packed H1 planes/LUT nibbles/crumbs no perp "
text b_chk_s " checks, "
text b_fail_s " failures\n"
text b_hdr_p "MA_DIGITAL_V1 bottom PASS: "
text b_hdr_f "MA_DIGITAL_V1 bottom FAIL: "
text b_rz_s " failures, 10 realizations\n"

fn bchk ok bool to void
  put b_chk 0 add get b_chk 0 1
  if not ok
    put b_chk 1 add get b_chk 1 1
  end
end

fn brnd to ulong
  s = add get b_rng 0 0x9e3779b97f4a7c15
  put b_rng 0 s
  z = mul xor s shr s 30 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 0x94d049bb133111eb
  ret xor z shr z 31
end

fn b_fill_w cnt ulong kind int to void
  for i ulong cnt bound 262144
    if eq kind 1
      put rz_w i byte 1
    else
      if eq kind 2
        put rz_w i byte -1
      else
        if eq kind 3
          put rz_w i byte 0
        else
          put rz_w i byte sub int rem brnd 3 1
        end
      end
    end
  end
end

fn b_sec_print label view uchar * c0 ulong f0 ulong to void
  dc = sub get b_chk 0 c0
  df = sub get b_chk 1 f0
  if eq df 0
    oma_put_str b_pass
  else
    oma_put_str b_fail
  end
  oma_put_str label
  oma_put_u64 1 dc
  oma_put_str b_chk_s
  oma_put_u64 1 df
  oma_put_str b_fail_s
end

fn test_h1_bottom_lane k ulong to void
  good = new ulong 2 0
  bad = new ulong 2 0
  mask = shl ulong 1 k
  put bad 0 mask
  put bad 1 mask
  lanes = new byte 64 42
  bchk eq oma_block_decode bad lanes OMA_E_INVALID_PLANES
  bchk and eq int get lanes 0 42 eq int get lanes 63 42
  bchk eq oma_unpack_bitplane bad 1 64 lanes OMA_E_INVALID_PLANES
  bchk eq int get lanes k 42
  o1 = new ulong 2 5
  o2 = new ulong 2 6
  bchk eq oma_block_add bad good o1 o2 OMA_E_INVALID_PLANES
  bchk and eq get o1 0 5 eq get o2 0 6
  bchk eq oma_block_add good bad o1 o2 OMA_E_INVALID_PLANES
  bchk and eq get o1 1 5 eq get o2 1 6
  bchk eq oma_block_mul bad good o1 OMA_E_INVALID_PLANES
  bchk eq get o1 0 5
  bchk eq oma_block_mul good bad o1 OMA_E_INVALID_PLANES
  bchk eq get o1 1 5
  d = new int 1 42
  bchk eq oma_block_dot good bad d OMA_E_INVALID_PLANES
  bchk eq get d 0 42
end

fn test_h1_codes to void
  sc = new uchar 2 77
  m = new uchar 1 77
  for a int 4
    for b int 4
      if or eq a 3 eq b 3
        put sc 0 uchar 77
        put sc 1 uchar 77
        put m 0 uchar 77
        bchk eq oma_code_add a b sc OMA_E_INVALID_CODE
        bchk and eq int get sc 0 77 eq int get sc 1 77
        bchk eq oma_code_mul a b m OMA_E_INVALID_CODE
        bchk eq int get m 0 77
      end
    end
  end
end

fn test_h1_bottom to void
  c0 = get b_chk 0
  f0 = get b_chk 1
  code = new uchar 1 0
  t = new byte 1 0
  v = int -128
  while le v 127 bound 300
    put code 0 uchar 77
    rc = oma_trit_to_code v code
    if and ge v -1 le v 1
      put t 0 byte 9
      bchk and eq rc 0 ne get code 0 3
      bchk and eq oma_code_to_trit int get code 0 t 0 eq int get t 0 v
    else
      bchk eq rc OMA_E_INVALID_TRIT
    end
    v = add v 1
  end
  put t 0 byte 9
  bchk and eq oma_code_to_trit 3 t OMA_E_INVALID_CODE eq int get t 0 9
  test_h1_codes
  for k ulong 64
    test_h1_bottom_lane k
  end
  b_sec_print b_s1 c0 f0
end

fn test_rz_refuse_non_trits to void
  c0 = get b_chk 0
  f0 = get b_chk 1
  m = ulong 3
  n = ulong 131
  tot = mul m n
  v = int -128
  while le v 127 bound 300
    if or lt v -1 gt v 1
      b_fill_w tot 0
      pos = rem brnd tot
      put rz_w pos byte v
      for rid ulong OMA_RZ_COUNT
        bchk eq oma_rz_pack_g rid m n OMA_RZ_E_TRIT
      end
    end
    v = add v 1
  end
  b_sec_print b_s2 c0 f0
end

fn check_bp_lane row_off ulong base ulong col0 ulong n ulong to void
  pj = ulong get rz_mem base
  nj = ulong get rz_mem add base 16
  if ne and pj nj 0
    put b_cnts 0 add get b_cnts 0 1
  end
  for k ulong 8
    col = add col0 mul 16 k
    pv = int and shr pj k 1
    nv = int and shr nj k 1
    v = sub pv nv
    want = int 0
    if lt col n
      want = int get rz_w add row_off col
    end
    if ne v want
      put b_cnts 1 add get b_cnts 1 1
    end
  end
end

fn check_bp_chunk i ulong c ulong n ulong rb ulong to void
  row_off = mul i n
  base_c = add mul i rb mul c 32
  cbase = mul c 128
  for j ulong 16
    check_bp_lane row_off add base_c j add cbase j n
  end
end

fn check_bitplane m ulong n ulong to void
  bchk eq oma_rz_pack_g RZ_R2_BITPLANE m n OMA_RZ_OK
  chunks = div add n 127 128
  rb = mul chunks 32
  put b_cnts 0 0
  put b_cnts 1 0
  for i ulong m bound 64
    for c ulong chunks bound 256
      check_bp_chunk i c n rb
    end
  end
  bchk eq get b_cnts 0 0
  bchk eq get b_cnts 1 0
end

fn check_cr_lane row_off ulong bv ulong col0 ulong n ulong to void
  for k ulong 4
    cr = and shr bv mul 2 k 3
    if eq cr 2
      put b_cnts 0 add get b_cnts 0 1
    end
    v = int 99
    if eq cr 0
      v = 0
    else
      if eq cr 1
        v = 1
      else
        if eq cr 3
          v = -1
        end
      end
    end
    col = add col0 mul 16 k
    want = int 0
    if lt col n
      want = int get rz_w add row_off col
    end
    if ne v want
      put b_cnts 1 add get b_cnts 1 1
    end
  end
end

fn check_cr_chunk i ulong c ulong n ulong rb ulong to void
  row_off = mul i n
  base_c = add mul i rb mul c 16
  cbase = mul c 64
  for j ulong 16
    bv = ulong get rz_mem add base_c j
    check_cr_lane row_off bv add cbase j n
  end
end

fn check_crumb m ulong n ulong to void
  bchk eq oma_rz_pack_g RZ_R2C_CRUMB m n OMA_RZ_OK
  chunks = div add n 63 64
  rb = mul chunks 16
  put b_cnts 0 0
  put b_cnts 1 0
  for i ulong m bound 64
    for c ulong chunks bound 512
      check_cr_chunk i c n rb
    end
  end
  bchk eq get b_cnts 0 0
  bchk eq get b_cnts 1 0
end

fn check_lut_byte row ulong col0 ulong m ulong n ulong bv ulong to void
  if ne and and bv 15 shr bv 4 0
    put b_cnts 0 add get b_cnts 0 1
  end
  for q ulong 4
    col = add col0 q
    pv = int and shr bv q 1
    nv = int and shr bv add 4 q 1
    v = sub pv nv
    want = int 0
    if lt row m
      if lt col n
        want = int get rz_w add mul row n col
      end
    end
    if ne v want
      put b_cnts 1 add get b_cnts 1 1
    end
  end
end

fn check_lut_row row ulong g ulong m ulong n ulong base_off ulong to void
  for j ulong 4
    bv = ulong get rz_mem add base_off j
    col0 = add mul g 16 mul 4 j
    check_lut_byte row col0 m n bv
  end
end

fn check_lut_blk bl ulong g ulong m ulong n ulong sg ulong to void
  blk_off = mul add mul bl sg g 64
  for r ulong 16
    row = add mul bl 16 r
    check_lut_row row g m n add blk_off rz_lut_ro r
  end
end

fn check_lut m ulong n ulong to void
  bchk eq oma_rz_pack_g RZ_R2B_LUT m n OMA_RZ_OK
  sg = div add n 15 16
  mb = div add m 15 16
  bchk eq get rz_plan 2 mul mul mb sg 64
  put b_cnts 0 0
  put b_cnts 1 0
  for bl ulong mb bound 16
    for g ulong sg bound 2048
      check_lut_blk bl g m n sg
    end
  end
  bchk eq get b_cnts 0 0
  bchk eq get b_cnts 1 0
end

fn check_all_packed m ulong n ulong kind int to void
  b_fill_w mul m n kind
  check_bitplane m n
  check_crumb m n
  check_lut m n
end

fn test_packed_no_bottom to void
  c0 = get b_chk 0
  f0 = get b_chk 1
  ns = new ulong 15 0
  put ns 0 1
  put ns 1 15
  put ns 2 16
  put ns 3 17
  put ns 4 63
  put ns 5 64
  put ns 6 65
  put ns 7 127
  put ns 8 128
  put ns 9 129
  put ns 10 255
  put ns 11 256
  put ns 12 257
  put ns 13 1000
  put ns 14 4099
  ms = new ulong 5 0
  put ms 0 1
  put ms 1 2
  put ms 2 3
  put ms 3 5
  put ms 4 17
  for a ulong 15
    for bi ulong 5
      for kind int 4
        check_all_packed get ms bi get ns a kind
      end
    end
  end
  for it ulong 200
    n = add 1 rem brnd 3000
    m = add 1 rem brnd 40
    check_all_packed m n 0
  end
  check_all_packed 2 16384 0
  b_sec_print b_s3 c0 f0
end

fn main to int
  put b_rng 0 ulong 0x4d412d4456312d42
  test_h1_bottom
  test_rz_refuse_non_trits
  test_packed_no_bottom
  if eq get b_chk 1 0
    oma_put_str b_hdr_p
  else
    oma_put_str b_hdr_f
  end
  oma_put_u64 1 get b_chk 0
  oma_put_str b_chk_s
  oma_put_u64 1 get b_chk 1
  oma_put_str b_rz_s
  if eq get b_chk 1 0
    ret 0
  end
  ret 1
end

note ---- env lookup: writes value to bma_evbuf, sets bma_evlen, returns 1 if found ----
fn bma_getenv_match idx ulong key view uchar * to ulong
  n = envread idx bma_ebuf 0 512
  if le n 0
    ret 0
  end
  kl = len key
  if le ulong n kl
    ret 0
  end
  for j ulong kl bound 64
    if ne get bma_ebuf j get key j
      ret 0
    end
  end
  if ne get bma_ebuf kl uchar 61
    ret 0
  end
  vl = sub ulong n add kl 1
  for i ulong vl bound 512
    put bma_evbuf i get bma_ebuf add add kl 1 i
  end
  put bma_evlen 0 vl
  ret 1
end

fn bma_getenv key view uchar * to ulong
  ec = envcnt
  for i ulong ulong ec bound 512
    if eq bma_getenv_match i key 1
      ret 1
    end
  end
  put bma_evlen 0 0
  ret 0
end

fn bma_parse_u64_ev to ulong
  v = ulong 0
  n = get bma_evlen 0
  for i ulong n bound 32
    c = get bma_evbuf i
    if or lt c uchar 48 gt c uchar 57
      break
    end
    v = add mul v 10 sub ulong c 48
  end
  ret v
end

note ---- /proc readers ----
fn bma_run_delay_ns to ulong
  fd = fopen t_bma_p_sched 0 len t_bma_p_sched SEL_O_RDONLY 0
  if lt fd 0
    ret 0
  end
  buf = new uchar 128 0
  k = read int fd buf 0 128
  ign_l = fclose int fd
  if le k 0
    ret 0
  end
  p = ulong 0
  n = ulong k
  while lt p n bound 128
    if eq get buf p uchar 32
      p = add p 1
      break
    end
    p = add p 1
  end
  v = ulong 0
  while lt p n bound 128
    c = get buf p
    if or lt c uchar 48 gt c uchar 57
      break
    end
    v = add mul v 10 sub ulong c 48
    p = add p 1
  end
  ret v
end

fn bma_read_loadavg slot ulong to void
  fd = fopen t_bma_p_load 0 len t_bma_p_load SEL_O_RDONLY 0
  if lt fd 0
    if eq slot 0
      put bma_la0_len 0 0
    else
      put bma_la1_len 0 0
    end
    ret
  end
  buf = new uchar 64 0
  k = read int fd buf 0 64
  ign_l = fclose int fd
  if le k 0
    ret
  end
  spaces = ulong 0
  ll = ulong 0
  for i ulong ulong k bound 64
    c = get buf i
    if eq c uchar 32
      spaces = add spaces 1
      if ge spaces 3
        break
      end
    end
    if eq slot 0
      put bma_la0 ll c
    else
      put bma_la1 ll c
    end
    ll = add ll 1
  end
  if eq slot 0
    put bma_la0_len 0 ll
  else
    put bma_la1_len 0 ll
  end
end

fn bma_read_thermal_c to long
  fd = fopen t_bma_p_therm 0 len t_bma_p_therm SEL_O_RDONLY 0
  if lt fd 0
    ret -1
  end
  buf = new uchar 32 0
  k = read int fd buf 0 32
  ign_l = fclose int fd
  if le k 0
    ret -1
  end
  v = long 0
  for i ulong ulong k bound 32
    c = get buf i
    if or lt c uchar 48 gt c uchar 57
      break
    end
    v = add mul v 10 long sub ulong c 48
  end
  ret div v 1000
end

fn bma_parse_hex_after_colon to ulong
  ll = get sel_llen 0
  p = ulong 0
  while lt p ll bound 256
    if eq get sel_line p uchar 58
      p = add p 1
      break
    end
    p = add p 1
  end
  while lt p ll bound 256
    c = get sel_line p
    if and ne c uchar 32 ne c uchar 9
      break
    end
    p = add p 1
  end
  if lt add p 1 ll
    if eq get sel_line p uchar 48
      c2 = get sel_line add p 1
      if or eq c2 uchar 120 eq c2 uchar 88
        p = add p 2
      end
    end
  end
  v = ulong 0
  while lt p ll bound 32
    c = get sel_line p
    if and ge c uchar 48 le c uchar 57
      v = add mul v 16 sub ulong c 48
    else
      if and ge c uchar 97 le c uchar 102
        v = add mul v 16 add 10 sub ulong c 97
      else
        if and ge c uchar 65 le c uchar 70
          v = add mul v 16 add 10 sub ulong c 65
        else
          break
        end
      end
    end
    p = add p 1
  end
  ret v
end

fn bma_parse_dec_after_colon to ulong
  ll = get sel_llen 0
  p = ulong 0
  while lt p ll bound 256
    if eq get sel_line p uchar 58
      p = add p 1
      break
    end
    p = add p 1
  end
  while lt p ll bound 256
    c = get sel_line p
    if and ne c uchar 32 ne c uchar 9
      break
    end
    p = add p 1
  end
  v = ulong 0
  while lt p ll bound 32
    c = get sel_line p
    if or lt c uchar 48 gt c uchar 57
      break
    end
    v = add mul v 10 sub ulong c 48
    p = add p 1
  end
  ret v
end

fn bma_read_cpu_parts to void
  for i ulong 256
    put bma_cpu_part i -1
  end
  put bma_ncpu 0 0
  fd = fopen t_bma_p_cpuinfo 0 len t_bma_p_cpuinfo SEL_O_RDONLY 0
  if lt fd 0
    ret
  end
  put sel_fpos 0 0
  put sel_flen 0 0
  cur = long -1
  while true bound 50000
    if lt sel_readline int fd 0
      break
    end
    if sel_line_pfx t_bma_p_proc
      cur = long bma_parse_dec_after_colon
    else
      if sel_line_pfx t_bma_p_part
        if and ge cur 0 lt cur 256
          put bma_cpu_part ulong cur int bma_parse_hex_after_colon
          if gt add ulong cur 1 get bma_ncpu 0
            put bma_ncpu 0 add ulong cur 1
          end
        end
      end
    end
  end
  ign_l = fclose int fd
end

fn bma_pick_x925 to long
  if eq bma_getenv t_bma_env_cpu 1
    if gt get bma_evlen 0 0
      ret long bma_parse_u64_ev
    end
  end
  nc = get bma_ncpu 0
  for c ulong nc bound 256
    if eq get bma_cpu_part c 0xd85
      ret long c
    end
  end
  ret -1
end

note ---- bandwidth measurement ----
fn bma_stream_xor words ulong to ulong
  acc = ulong 0
  i = ulong 0
  while lt i words bound 50000000
    acc = xor acc get bma_bw_pool i
    i = add i 1
  end
  ret acc
end

fn bma_measure_bw_lv lv ulong to void
  wsz = get bma_bw_sz lv
  if gt wsz 16777216
    wsz = 16777216
  end
  words = div wsz 8
  passes = div ulong 16777216 wsz
  if lt passes 1
    passes = 1
  end
  put bma_sink 0 xor get bma_sink 0 bma_stream_xor words
  best = 1.0e30f64
  for s ulong 5
    t0 = monons
    for p ulong passes bound 2048
      put bma_sink 0 xor get bma_sink 0 bma_stream_xor words
    end
    dt = f64 sub monons t0
    if gt dt 0.0f64
      if lt dt best
        best = dt
      end
    end
  end
  put bma_bw_gbs lv div mul f64 wsz f64 passes best
end

fn bma_measure_bandwidth to void
  put bma_bw_sz 0 16384
  put bma_bw_sz 1 49152
  put bma_bw_sz 2 262144
  put bma_bw_sz 3 1048576
  put bma_bw_sz 4 1572864
  put bma_bw_sz 5 4194304
  put bma_bw_sz 6 8388608
  put bma_bw_sz 7 16777216
  put bma_bw_sz 8 33554432
  put bma_bw_sz 9 67108864
  put bma_bw_sz 10 134217728
  put bma_bw_sz 11 268435456
  max_w = ulong 2097152
  er = enlarge bma_bw_pool max_w
  if lt er 0
    ret
  end
  for i ulong max_w bound 3000000
    put bma_bw_pool i i
  end
  for lv ulong BMA_NBW
    bma_measure_bw_lv lv
  end
end

fn bma_bw_level_for ws ulong to ulong
  for lv ulong BMA_NBW
    if ge get bma_bw_sz lv ws
      ret lv
    end
  end
  ret sub BMA_NBW 1
end

note ---- sorting & quantile ----
fn bma_sort_f64 a edit f64 * n ulong to void
  i = ulong 1
  while lt i n bound 32
    key = get a i
    j = i
    while gt j 0 bound 32
      prev = get a sub j 1
      if gt prev key
        put a j prev
        j = sub j 1
      else
        break
      end
    end
    put a j key
    i = add i 1
  end
end

fn bma_quantile a view f64 * n ulong q f64 to f64
  pos = mul q f64 sub n 1
  idx = ulong pos
  frac = sub pos f64 idx
  if lt add idx 1 n
    ret add mul get a idx sub 1.0f64 frac mul get a add idx 1 frac
  end
  ret get a idx
end

note ---- cell verification & timing ----
fn bma_verify_y m ulong to bool
  for i ulong m bound 1024
    if ne get rz_y i get rz_yref i
      ret false
    end
  end
  ret true
end

fn bma_timed_block batch ulong per_call edit f64 1 to ulong
  d0 = bma_run_delay_ns
  t0 = monons
  for b ulong batch bound 200000
    ign = oma_rz_run_g
  end
  dt = f64 sub monons t0
  dl = sub bma_run_delay_ns d0
  put per_call 0 div dt f64 batch
  if gt mul f64 dl 50.0f64 dt
    ret 1
  end
  ret 0
end

fn bma_bench_rz_pack r ulong n ulong m ulong quick ulong to int
  pk = new f64 8 0.0f64
  t0 = monons
  rc = oma_rz_pack_g r m n
  put pk 0 f64 sub monons t0
  if ne rc 0
    ret -1
  end
  npk = ulong 1
  extra = ulong 2
  if eq quick 0
    if lt get pk 0 5000000.0f64
      extra = 6
    end
  end
  for e ulong extra bound 8
    t1 = monons
    ign = oma_rz_pack_g r m n
    put pk npk f64 sub monons t1
    npk = add npk 1
  end
  bma_sort_f64 pk npk
  put bma_pmin r get pk 0
  put bma_preps r npk
  pmed = get pk div npk 2
  put bma_pmed r pmed
  if gt pmed 0.0f64
    if ge npk 4
      put bma_pnz r div sub bma_quantile pk npk 0.75f64 bma_quantile pk npk 0.25f64 pmed
    else
      put bma_pnz r div sub get pk sub npk 1 get pk 0 pmed
    end
  else
    put bma_pnz r 0.0f64
  end
  ret 0
end

fn bma_bench_rz_one r ulong n ulong m ulong quick ulong to void
  put bma_ok r 0
  put bma_ver r 0
  put bma_ret r 0
  put bma_frc r 0
  if or gt n oma_rz_max_n r or gt m 1024 gt mul m n 262144
    ret
  end
  if ne bma_bench_rz_pack r n m quick 0
    ret
  end
  for i ulong m bound 1024
    put rz_y i 0x5a5a5a5a
  end
  ign = oma_rz_run_g
  put bma_cnt 3 add get bma_cnt 3 1
  if not bma_verify_y m
    put bma_cnt 2 add get bma_cnt 2 1
    ret
  end
  put bma_ver r 1
  put bma_ok r 1
  put bma_wb r get rz_plan 2
  put bma_fp r get rz_plan 3
  put bma_nnz r get rz_plan 4
  put bma_ws r add add get rz_plan 2 n mul m 4
  ign = oma_rz_run_g
  t2 = monons
  ign = oma_rz_run_g
  one = f64 sub monons t2
  if lt one 1.0f64
    one = 1.0f64
  end
  batch = ulong div 300000.0f64 one
  if lt batch 1
    batch = 1
  end
  if gt batch 200000
    batch = 200000
  end
  put bma_batch r batch
  pc = new f64 1 0.0f64
  for s ulong BMA_NSAMPLES
    tries = ulong 0
    while ne bma_timed_block batch pc 0 bound 16
      put bma_ret r add get bma_ret r 1
      put bma_cnt 0 add get bma_cnt 0 1
      tries = add tries 1
      if ge tries BMA_MAX_RETRY
        put bma_frc r add get bma_frc r 1
        put bma_cnt 1 add get bma_cnt 1 1
        break
      end
    end
    put bma_samp add mul r BMA_NSAMPLES s get pc 0
  end
  for i2 ulong m bound 1024
    put rz_y i2 0x5a5a5a5a
  end
  ign = oma_rz_run_g
  put bma_cnt 3 add get bma_cnt 3 1
  if not bma_verify_y m
    put bma_ver r 0
    put bma_cnt 2 add get bma_cnt 2 1
  end
end

global bma_srt f64 9

fn bma_sort_srt to void
  i = ulong 1
  while lt i BMA_NSAMPLES bound 32
    key = get bma_srt i
    j = i
    while gt j 0 bound 32
      prev = get bma_srt sub j 1
      if gt prev key
        put bma_srt j prev
        j = sub j 1
      else
        break
      end
    end
    put bma_srt j key
    i = add i 1
  end
end

fn bma_emit_row_el r ulong n ulong m ulong to void
  for i ulong BMA_NSAMPLES
    put bma_srt i get bma_samp add mul r BMA_NSAMPLES i
  end
  bma_sort_srt
  tmin = get bma_srt 0
  tmed = get bma_srt 4
  lv = bma_bw_level_for get bma_ws r
  fns = div f64 get bma_ws r fmax get bma_bw_gbs lv 1.0f64
  if le tmin 0.0f64
    tmin = 1.0f64
  end
  if le tmed 0.0f64
    tmed = 1.0f64
  end
  sel_o_txt t_bma_r_el1
  bma_fam_print r
  sel_o_txt t_bma_r_el2
  if ne get bma_ver r 0
    sel_o_txt t_sel_true
  else
    sel_o_txt t_sel_false
  end
  sel_o_txt t_bma_r_el3
  if eq r 0
    sel_o_u64 1
  else
    sel_o_u64 0
  end
  sel_o_txt t_bma_r_el4
  sel_o_u64 get bma_nnz r
  sel_o_txt t_bma_r_el5
  sel_o_u64 get bma_wb r
  sel_o_txt t_bma_r_el6
  sel_o_f64 div mul 8.0f64 f64 get bma_wb r mul f64 m f64 n 3
  sel_o_txt t_bma_r_el7
  sel_o_u64 get bma_fp r
  sel_o_txt t_bma_r_el8
  sel_o_u64 get bma_ws r
  sel_o_txt t_bma_r_el9
  sel_o_u64 get bma_bw_sz lv
  sel_o_txt t_bma_r_el10
  sel_o_f64 fmax get bma_bw_gbs lv 1.0f64 2
  sel_o_txt t_bma_r_el11
  sel_o_f64 mul fns 1000.0f64 0
  sel_o_txt t_bma_r_el12
  sel_o_f64 mul tmin 1000.0f64 0
  sel_o_txt t_bma_r_el13
  sel_o_f64 mul tmed 1000.0f64 0
  sel_o_txt t_bma_r_el14
  sel_o_f64 mul get bma_srt 2 1000.0f64 0
  sel_o_txt t_bma_r_el15
  sel_o_f64 mul get bma_srt 6 1000.0f64 0
  sel_o_txt t_bma_r_el16
  sel_o_f64 div sub get bma_srt 6 get bma_srt 2 tmed 4
  sel_o_txt t_bma_r_el17
  sel_o_f64 div mul 100.0f64 fns tmin 1
  sel_o_txt t_bma_r_el18
  sel_o_f64 div mul 100.0f64 fns tmed 1
  sel_o_txt t_bma_r_el19
  sel_o_f64 div 1.0e9f64 tmed 1
  sel_o_txt t_bma_r_el20
  sel_o_f64 div mul f64 m f64 n tmed 3
  sel_o_txt t_bma_r_el21
  sel_o_f64 mul get bma_pmin r 1000.0f64 0
  sel_o_txt t_bma_r_el22
  sel_o_f64 mul get bma_pmed r 1000.0f64 0
  sel_o_txt t_bma_r_el23
  sel_o_f64 get bma_pnz r 4
  sel_o_txt t_bma_r_el24
  sel_o_u64 get bma_preps r
  sel_o_txt t_bma_r_el25
  sel_o_f64 mul add get bma_pmed r tmed 1000.0f64 0
  sel_o_txt t_bma_r_el26
  sel_o_u64 get bma_batch r
  sel_o_txt t_bma_r_el27
  sel_o_u64 get bma_ret r
  sel_o_txt t_bma_r_el28
  sel_o_u64 get bma_frc r
  sel_o_txt t_dj_rb
end

fn bma_emit_row r ulong n ulong m ulong sp f64 to void
  if eq get bma_first_row 0 0
    sel_o_txt t_bma_cnl
  end
  put bma_first_row 0 0
  sel_o_txt t_bma_r_inel1
  sel_o_u64 n
  sel_o_txt t_dj_2
  sel_o_u64 m
  sel_o_txt t_dj_3
  sel_o_f64 sp 2
  sel_o_txt t_bma_r_inel2
  sel_rz_print r
  if eq get bma_ok r 0
    sel_o_txt t_bma_r_inel3
    if ne get bma_ver r 0
      sel_o_txt t_sel_true
    else
      sel_o_txt t_sel_false
    end
    sel_o_txt t_bma_r_inel4
    if gt n oma_rz_max_n r
      sel_o_txt t_bma_why_maxn
    else
      if or gt m 1024 gt mul m n 262144
        sel_o_txt t_bma_why_cap
      else
        sel_o_txt t_bma_why_ver
      end
    end
    sel_o_txt t_dj_qrb
    ret
  end
  bma_emit_row_el r n m
end

fn bma_bench_cell n ulong m ulong sp f64 quick ulong to void
  if and le m 1024 le mul m n 262144
    tot = mul m n
    for i ulong tot bound 262144
      rv = bma_rnd
      u = mul f64 shr rv 11 div 1.0f64 9007199254740992.0f64
      if lt u sp
        put rz_w i byte 0
      else
        if eq and rv 1 1
          put rz_w i byte 1
        else
          put rz_w i byte -1
        end
      end
    end
    for j ulong n bound 131072
      rb = and bma_rnd 255
      if ge rb 128
        put rz_x j byte sub int rb 256
      else
        put rz_x j byte rb
      end
    end
    ign = oma_rz_oracle_g m n
  end
  for r ulong OMA_RZ_COUNT
    bma_bench_rz_one r n m quick
  end
  for r2 ulong OMA_RZ_COUNT
    bma_emit_row r2 n m sp
  end
end

fn bma_load_env_meta to void
  if eq bma_getenv t_bma_env_commit 1
    l = get bma_evlen 0
    if gt l 63
      l = 63
    end
    for i ulong l bound 64
      put bma_commit i get bma_evbuf i
    end
    put bma_commit_len 0 l
  else
    put bma_commit_len 0 0
  end
  if eq bma_getenv t_bma_env_sha 1
    l = get bma_evlen 0
    if gt l 71
      l = 71
    end
    for i2 ulong l bound 72
      put bma_bsha i2 get bma_evbuf i2
    end
    put bma_bsha_len 0 l
  else
    put bma_bsha_len 0 0
  end
  put bma_dirty 0 0
  if eq bma_getenv t_bma_env_dirty 1
    if gt bma_parse_u64_ev 0
      put bma_dirty 0 1
    end
  end
end

fn bma_copy_rows_to fd int to void
  rfd = fopen bma_tmp_path 0 get bma_tmp_len 0 SEL_O_RDONLY 0
  if ge rfd 0
    while true bound 100000
      k = read int rfd bma_copy_buf 0 8192
      if le k 0
        break
      end
      off = ulong 0
      while lt off ulong k bound 10000
        wk = write fd bma_copy_buf off sub ulong k off
        if le wk 0
          break
        end
        off = add off ulong wk
      end
    end
    ign_l = fclose int rfd
  end
  ign_l = unlink bma_tmp_path 0 get bma_tmp_len 0
end

fn bma_write_final cpu ulong cpart ulong th0 long th1 long grid_s f64 to int
  fd = fopen bma_out_path 0 get bma_out_len 0 SEL_O_WRONLY_CREAT_TRUNC SEL_MODE_0644
  if lt fd 0
    oma_put_err t_bma_open_e
    ret 2
  end
  sel_o_init int fd
  sel_o_txt t_bma_j1
  sel_o_u64 div ulong realns 1000000000
  sel_o_b uchar 45
  cl = get bma_commit_len 0
  if gt cl 0
    for i1 ulong cl bound 64
      sel_o_b get bma_commit i1
    end
  else
    sel_o_txt t_bma_unk
  end
  sel_o_txt t_bma_j2
  if gt cl 0
    for i2 ulong cl bound 64
      sel_o_b get bma_commit i2
    end
  else
    sel_o_txt t_bma_unk
  end
  sel_o_txt t_bma_j3
  if ne get bma_dirty 0 0
    sel_o_txt t_sel_true
  else
    sel_o_txt t_sel_false
  end
  sel_o_txt t_bma_j4
  sl = get bma_bsha_len 0
  if gt sl 0
    for i3 ulong sl bound 72
      sel_o_b get bma_bsha i3
    end
  else
    sel_o_txt t_bma_unk
  end
  sel_o_txt t_bma_j5
  sel_o_u64 cpu
  sel_o_txt t_bma_j6
  sel_o_u64 cpart
  sel_o_txt t_bma_j7
  sel_o_txt t_bma_choice_auto
  sel_o_txt t_bma_j8
  for i4 ulong get bma_la0_len 0 bound 64
    sel_o_b get bma_la0 i4
  end
  sel_o_txt t_bma_j9
  for i5 ulong get bma_la1_len 0 bound 64
    sel_o_b get bma_la1 i5
  end
  sel_o_txt t_bma_j10
  sel_o_i64 th0
  sel_o_txt t_bma_j11
  sel_o_i64 th1
  sel_o_txt t_bma_j12
  sel_o_f64 grid_s 1
  sel_o_txt t_bma_j13
  for lv ulong BMA_NBW
    if gt lv 0
      sel_o_txt t_dj_sep
    end
    sel_o_txt t_bma_bw1
    sel_o_u64 get bma_bw_sz lv
    sel_o_txt t_bma_bw2
    sel_o_f64 get bma_bw_gbs lv 2
    sel_o_txt t_dj_rb
  end
  sel_o_txt t_bma_bw_end
  for r ulong OMA_RZ_COUNT
    sel_o_txt t_bma_rz1
    sel_rz_print r
    sel_o_txt t_bma_rz2
    bma_fam_print r
    sel_o_txt t_bma_rz3
    if eq r 0
      sel_o_u64 1
    else
      sel_o_u64 0
    end
    sel_o_txt t_bma_rz4
    sel_o_u64 oma_rz_max_n r
    sel_o_txt t_bma_rz5
    bma_lbl_print r
    sel_o_txt t_bma_rz6
    if lt add r 1 OMA_RZ_COUNT
      sel_o_b uchar 44
    end
    sel_o_b uchar 10
  end
  sel_o_txt t_bma_cor1
  sel_o_u64 get bma_cnt 3
  sel_o_txt t_bma_cor2
  sel_o_u64 get bma_cnt 2
  sel_o_txt t_bma_cor3
  sel_o_u64 get bma_cnt 3
  sel_o_txt t_bma_cor4
  sel_o_u64 get bma_cnt 2
  sel_o_txt t_bma_cor5
  sel_o_u64 get bma_cnt 0
  sel_o_txt t_bma_cor6
  sel_o_u64 get bma_cnt 1
  sel_o_txt t_bma_cor7
  sel_o_flush
  bma_copy_rows_to int fd
  sel_o_txt t_bma_end1
  sel_o_flush
  ign_l = fclose int fd
  ret 0
end

fn bma_run_grid quick ulong to void
  ns = new ulong 3 0
  put ns 0 1024
  put ns 1 4096
  put ns 2 16384
  ms = new ulong 3 0
  put ms 0 1
  put ms 1 64
  put ms 2 4096
  sps = new f64 4 0.0f64
  put sps 0 0.0f64
  put sps 1 0.3f64
  put sps 2 0.6f64
  put sps 3 0.9f64
  nn = ulong 3
  nm = ulong 3
  nsp = ulong 4
  if ne quick 0
    nn = 2
    nm = 2
    nsp = 2
  end
  for ia ulong nn bound 3
    for ib ulong nm bound 3
      for ic ulong nsp bound 4
        bma_bench_cell get ns ia get ms ib get sps ic quick
      end
    end
  end
end

fn bma_pin_cpu cpu ulong to int
  mask = new uchar 32 0
  byte_i = div cpu 8
  bit_i = rem cpu 8
  if lt byte_i 32
    put mask byte_i uchar shl ulong 1 bit_i
  end
  if ne cpuset 0 mask 0 32 0
    ret -1
  end
  ret 0
end

fn bma_setup_paths to int
  ol = argread ulong 1 bma_out_path 0 512
  if lt ol 0
    ret -1
  end
  put bma_out_len 0 ulong ol
  for i ulong ulong ol bound 512
    put bma_tmp_path i get bma_out_path i
  end
  sl = len t_bma_rows_sfx
  for j ulong sl bound 16
    put bma_tmp_path add ulong ol j get t_bma_rows_sfx j
  end
  put bma_tmp_len 0 add ulong ol sl
  ret 0
end

fn main to int
  if lt argcnt 2
    oma_put_err t_bma_usage
    ret 2
  end
  put bma_rng 0 0x6d61332d62656e63
  if ne bma_setup_paths 0
    oma_put_err t_bma_open_e
    ret 2
  end
  quick = ulong 0
  if eq bma_getenv t_bma_env_quick 1
    if gt bma_parse_u64_ev 0
      quick = 1
    end
  end
  bma_read_cpu_parts
  cpu = bma_pick_x925
  if lt cpu 0
    oma_put_err t_bma_cpu_e
    ret 2
  end
  if ne bma_pin_cpu ulong cpu 0
    oma_put_err t_bma_pin_e
    ret 2
  end
  bma_read_loadavg 0
  th0 = bma_read_thermal_c
  wall0 = monons
  bma_measure_bandwidth
  rfd = fopen bma_tmp_path 0 get bma_tmp_len 0 SEL_O_WRONLY_CREAT_TRUNC SEL_MODE_0644
  if lt rfd 0
    oma_put_err t_bma_open_e
    ret 2
  end
  put bma_rows_fd 0 int rfd
  put bma_first_row 0 1
  sel_o_init int rfd
  bma_run_grid quick
  sel_o_flush
  ign_l = fclose int rfd
  grid_s = div f64 sub monons wall0 1.0e9f64
  bma_read_loadavg 1
  th1 = bma_read_thermal_c
  bma_load_env_meta
  rc = bma_write_final ulong cpu ulong get bma_cpu_part ulong cpu th0 th1 grid_s
  if ne rc 0
    ret rc
  end
  if ne get bma_cnt 2 0
    ret 1
  end
  ret 0
end

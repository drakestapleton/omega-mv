fn bma_rnd to ulong
  s = add get bma_rng 0 0x9e3779b97f4a7c15
  put bma_rng 0 s
  z = mul xor s shr s 30 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 0x94d049bb133111eb
  ret xor z shr z 31
end


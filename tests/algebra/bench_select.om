note Pure seeded OM-2 MA-2 selector CLI (replaces tests/algebra/bench_select.c).
note Concatenated after src/algebra/oma_lib.om + src/algebra/oma_select.om.

global bs_nc ulong 1
global bs_cn ulong 256
global bs_cm ulong 256
global bs_csp f64 256

note Per-cell binary vs ternary summary saved for JSON output
global bs_bb long 256
global bs_bb_ns f64 256
global bs_bb_pf f64 256
global bs_tb long 256
global bs_tb_ns f64 256
global bs_tb_pf f64 256
global bs_ratio f64 256
global bs_band f64 256
global bs_verd int 256

note Counters
global bs_cnt ulong 16
global bs_fd int 1

text t_bs_usage "usage: bench_select OUT.json RUN1.json [RUN2.json ...]\n"
text t_bs_load_e "load error\n"
text t_bs_open_e "cannot open output\n"
text t_bs_hdr1 "{\n  \"schema\": \"OMEGA_MIXED_ALGEBRA_MA2_SELECT_V1\",\n"
text t_bs_hdr2 "  \"label\": \"stand-in selector, not wired to rx_costmodel\",\n"
text t_bs_hdr3 "  \"operation\": \"Omega-X: y = W.x, W ternary m x n, x int8, y int32, exact\",\n"
text t_bs_hdr4 "  \"policy\": \"exact-contract filter (registry exact, verified in every run used, n <= max_n); cost = mean over runs of median ns per call (+ median pack ns when packing per call); noise band = max over winner and runner-up of within-run (q75-q25)/median and across-run (max-min)/mean; tied set = every eligible candidate within the band of the cheapest; TIE when the tied set has more than one member; a TIE is resolved only inside the tied set: incumbent if in it, else the digital reference realization (R1_plain) if in it, else the cheapest member (ADR 0019 section 9.1, amended); these decisions have no incumbent\",\n"
text t_bs_hdr5 "  \"sources\": ["
text t_bs_src1 "{\"path\": \""
text t_bs_src2 "\", \"run_id\": \""
text t_bs_src3 "\", \"sha256\": \""
text t_bs_src4 "\"}"
text t_bs_src_end "],\n"
text t_bs_rep1 "  \"reproducibility\": {\"runs\": "
text t_bs_rep2 ", \"cells\": [\n"
text t_bs_rep_r1 "    {\"n\": "
text t_bs_rep_r2 "\", \"run1\": \""
text t_bs_rep_r3 "\", \"run1_verdict\": \""
text t_bs_rep_r4 "\", \"run1_margin\": "
text t_bs_rep_r5 ", \"run1_band\": "
text t_bs_rep_r6 ", \"run2\": \""
text t_bs_rep_r7 "\", \"run2_verdict\": \""
text t_bs_rep_r8 "\", \"run2_margin\": "
text t_bs_rep_r9 ", \"run2_band\": "
text t_bs_rep_r10 ", \"status\": \""
text t_bs_st_ag "agree"
text t_bs_st_rt "recorded_tie"
text t_bs_st_di "DISAGREE"
text t_bs_rep_e1 "\n  ], \"decisions\": "
text t_bs_rep_e2 ", \"agree\": "
text t_bs_rep_e3 ", \"recorded_ties\": "
text t_bs_rep_e4 ", \"disagree\": "
text t_bs_rep_e5 "},\n"
text t_bs_dec1 "  \"decisions\": [\n"
text t_bs_ind4 "    "
text t_bs_cnl ",\n"
text t_bs_ds1 "\n  ],\n  \"decision_summary\": {\"decisions\": "
text t_bs_ds2 ", \"ties\": "
text t_bs_ds3 ", \"ties_per_call\": "
text t_bs_ds4 ", \"ties_once_amortized\": "
text t_bs_ds5 ", \"chosen_reference\": "
text t_bs_ds6 ", \"tie_resolution\": {\"incumbent\": "
text t_bs_ds7 ", \"reference\": "
text t_bs_ds8 ", \"cheapest\": "
text t_bs_ds9 "}, \"chosen_outside_tied_set\": "
text t_bs_ds10 "},\n"
text t_bs_bvt1 "  \"binary_vs_ternary\": [\n"
text t_bs_bvt_r1 "    {\"n\": "
text t_bs_bvt_r2 ", \"best_binary\": \""
text t_bs_bvt_r3 "\", \"binary_ns\": "
text t_bs_bvt_r4 ", \"binary_pct_floor\": "
text t_bs_bvt_r5 ", \"best_ternary\": \""
text t_bs_bvt_r6 "\", \"ternary_ns\": "
text t_bs_bvt_r7 ", \"ternary_pct_floor\": "
text t_bs_bvt_r8 ", \"binary_over_ternary\": "
text t_bs_bvt_r9 ", \"band\": "
text t_bs_bvt_r10 ", \"verdict\": \""
text t_bs_bvt_end "  ],\n"
text t_bs_v_na "n/a"
text t_bs_v_tie "tie"
text t_bs_v_tw "ternary wins"
text t_bs_v_bw "binary wins"
text t_bs_dash "-"
text t_bs_og1 "  \"off_grid_queries\": [\n"
text t_bs_og_end "  ],\n"
text t_bs_g1 "  \"gates\": {\"MA2_SELECTOR_REPRO\": \""
text t_bs_g2 "\", \"criteria\": \"for every measured cell and both pack modes, the choices from run 1 alone and run 2 alone are equal, or one run records a TIE whose tied set contains the other run's choice; and every decision's chosen realization is a member of its tied set\"},\n"
text t_bs_nc "  \"not_claimed\": [\"integration with rx_costmodel or the resident omega.select reaction\", \"shapes between grid points beyond nearest-cell lookup\", \"multi-core or GPU realizations\", \"energy-based selection\"]\n}\n"
text t_bs_pass "PASS"
text t_bs_fail "FAIL"
text t_bs_notrun "NOT_RUN"

text t_bs_thdr "n      m     sp   | amortized           | per_call            | R1 best    %floor | ternary best / binary best (amortized)\n"
text t_bs_tsep "-----------------------------------------------------------------------------------------------\n"
text t_bs_bar " | "
text t_bs_pct "% | "
text t_bs_x "x "
text t_bs_lp " ("
text t_bs_rp ")\n"
text t_bs_s1 "decisions over all runs: "
text t_bs_s2 ", TIE "
text t_bs_s3 " (per_call "
text t_bs_s4 ", once_amortized "
text t_bs_s5 "), R1_plain chosen "
text t_bs_s6 "tie resolution: incumbent "
text t_bs_s7 ", reference "
text t_bs_s8 ", cheapest "
text t_bs_s9 "; chosen outside tied set: "
text t_bs_s10 "reproducibility: "
text t_bs_s11 " decisions, "
text t_bs_s12 " agree, "
text t_bs_s13 " recorded ties, "
text t_bs_s14 " disagree -> MA2_SELECTOR_REPRO "

fn bs_is_binary rid long to bool
  ret and ge rid 1 le rid 3
end

fn bs_is_ternary rid long to bool
  if and ge rid 4 le rid 7
    ret true
  end
  ret eq rid 9
end

fn bs_o_verdict v int to void
  if eq v 1
    sel_o_txt t_bs_v_tie
    ret
  end
  if eq v 2
    sel_o_txt t_bs_v_tw
    ret
  end
  if eq v 3
    sel_o_txt t_bs_v_bw
    ret
  end
  sel_o_txt t_bs_v_na
end

fn bs_collect_cells to void
  nr = get sel_nrows 0
  nc = ulong 0
  for i ulong nr bound 2048
    rn = get sel_r_n i
    rm = get sel_r_m i
    rsp = get sel_r_sp i
    found = ulong 0
    for k ulong nc bound 256
      if eq get bs_cn k rn
        if eq get bs_cm k rm
          if lt fabs sub get bs_csp k rsp 1.0e-9f64
            found = 1
            break
          end
        end
      end
    end
    if and eq found 0 lt nc 256
      put bs_cn nc rn
      put bs_cm nc rm
      put bs_csp nc rsp
      nc = add nc 1
    end
  end
  put bs_nc 0 nc
end

fn bs_write_sources to void
  sel_o_txt t_bs_hdr5
  nr = get sel_nruns 0
  for r ulong nr bound 4
    if gt r 0
      sel_o_txt t_dj_sep
    end
    sel_file_sha256_run r
    sel_o_txt t_bs_src1
    sb = mul r 256
    sl = get sel_src_len r
    for i1 ulong sl bound 256
      sel_o_b get sel_src add sb i1
    end
    sel_o_txt t_bs_src2
    rb = mul r 96
    rl = get sel_run_id_len r
    for i2 ulong rl bound 96
      sel_o_b get sel_run_id add rb i2
    end
    sel_o_txt t_bs_src3
    for i3 ulong 64
      sel_o_b get sel_sh_hex i3
    end
    sel_o_txt t_bs_src4
  end
  sel_o_txt t_bs_src_end
end

global bs_first ulong 1

fn bs_write_repro_one k ulong mode ulong to void
  cn = get bs_cn k
  cm = get bs_cm k
  csp = get bs_csp k
  sel_set_q 0 cn cm csp int mode 0
  if ne sel_decide 0 0
    ret
  end
  sel_set_q 1 cn cm csp int mode 1
  if ne sel_decide 1 0
    ret
  end
  put bs_cnt 3 add get bs_cnt 3 1
  ca = get sd_chosen 0
  cb = get sd_chosen 1
  st = ulong 2
  if eq ca cb
    put bs_cnt 0 add get bs_cnt 0 1
    st = 0
  else
    ok_t = false
    if and ne get sd_tie 0 0 sel_in_tie_set 0 cb
      ok_t = true
    end
    if and ne get sd_tie 1 0 sel_in_tie_set 1 ca
      ok_t = true
    end
    if ok_t
      put bs_cnt 1 add get bs_cnt 1 1
      st = 1
    else
      put bs_cnt 2 add get bs_cnt 2 1
    end
  end
  if eq get bs_first 0 0
    sel_o_txt t_bs_cnl
  end
  put bs_first 0 0
  sel_o_txt t_bs_rep_r1
  sel_o_u64 cn
  sel_o_txt t_dj_2
  sel_o_u64 cm
  sel_o_txt t_dj_3
  sel_o_f64 csp 2
  sel_o_txt t_dj_4
  if ne mode 0
    sel_o_txt t_dj_pc
  else
    sel_o_txt t_dj_oa
  end
  sel_o_txt t_bs_rep_r2
  sel_rz_print ulong ca
  sel_o_txt t_bs_rep_r3
  if ne get sd_tie 0 0
    sel_o_txt t_dj_tie
  else
    sel_o_txt t_dj_chosen
  end
  sel_o_txt t_bs_rep_r4
  sel_o_f64 get sd_margin 0 4
  sel_o_txt t_bs_rep_r5
  sel_o_f64 get sd_band 0 4
  sel_o_txt t_bs_rep_r6
  sel_rz_print ulong cb
  sel_o_txt t_bs_rep_r7
  if ne get sd_tie 1 0
    sel_o_txt t_dj_tie
  else
    sel_o_txt t_dj_chosen
  end
  sel_o_txt t_bs_rep_r8
  sel_o_f64 get sd_margin 1 4
  sel_o_txt t_bs_rep_r9
  sel_o_f64 get sd_band 1 4
  sel_o_txt t_bs_rep_r10
  if eq st 0
    sel_o_txt t_bs_st_ag
  else
    if eq st 1
      sel_o_txt t_bs_st_rt
    else
      sel_o_txt t_bs_st_di
    end
  end
  sel_o_txt t_dj_qrb
end

fn bs_write_repro to void
  sel_o_txt t_bs_rep1
  sel_o_u64 get sel_nruns 0
  sel_o_txt t_bs_rep2
  put bs_first 0 1
  if ge get sel_nruns 0 2
    nc = get bs_nc 0
    for k ulong nc bound 256
      bs_write_repro_one k 0
      bs_write_repro_one k 1
    end
  end
  sel_o_txt t_bs_rep_e1
  sel_o_u64 get bs_cnt 3
  sel_o_txt t_bs_rep_e2
  sel_o_u64 get bs_cnt 0
  sel_o_txt t_bs_rep_e3
  sel_o_u64 get bs_cnt 1
  sel_o_txt t_bs_rep_e4
  sel_o_u64 get bs_cnt 2
  sel_o_txt t_bs_rep_e5
end

fn bs_tally_decision slot ulong mode ulong to void
  put bs_cnt 7 add get bs_cnt 7 1
  if ne get sd_tie slot 0
    put bs_cnt 4 add get bs_cnt 4 1
    if ne mode 0
      put bs_cnt 5 add get bs_cnt 5 1
    else
      put bs_cnt 6 add get bs_cnt 6 1
    end
    tr = get sd_tres slot
    if eq tr 1
      put bs_cnt 9 add get bs_cnt 9 1
    else
      if eq tr 2
        put bs_cnt 10 add get bs_cnt 10 1
      else
        if eq tr 3
          put bs_cnt 11 add get bs_cnt 11 1
        end
      end
    end
  end
  if eq get sd_chosen slot 0
    put bs_cnt 8 add get bs_cnt 8 1
  end
  in_ts = false
  nt = get sd_ntie slot
  base = mul slot 16
  ch = get sd_chosen slot
  for i ulong nt bound 16
    if eq get sd_tset add base i ch
      in_ts = true
    end
  end
  if not in_ts
    put bs_cnt 12 add get bs_cnt 12 1
  end
end

fn bs_compute_bvt k ulong to void
  bb = long -1
  tb = long -1
  nc = get sd_ncand 0
  for c ulong nc bound 16
    if eq get sc_elig c 0
      continue
    end
    rz = get sc_rz c
    cost = get sc_cost c
    if bs_is_binary rz
      if lt bb 0
        bb = long c
      else
        if lt cost get sc_cost ulong bb
          bb = long c
        end
      end
    end
    if bs_is_ternary rz
      if lt tb 0
        tb = long c
      else
        if lt cost get sc_cost ulong tb
          tb = long c
        end
      end
    end
  end
  if ge bb 0
    put bs_bb k get sc_rz ulong bb
    put bs_bb_ns k get sc_cost ulong bb
    put bs_bb_pf k get sc_pf ulong bb
  else
    put bs_bb k -1
    put bs_bb_ns k 0.0f64
    put bs_bb_pf k 0.0f64
  end
  if ge tb 0
    put bs_tb k get sc_rz ulong tb
    put bs_tb_ns k get sc_cost ulong tb
    put bs_tb_pf k get sc_pf ulong tb
  else
    put bs_tb k -1
    put bs_tb_ns k 0.0f64
    put bs_tb_pf k 0.0f64
  end
  if and ge bb 0 ge tb 0
    ratio = div get sc_cost ulong bb get sc_cost ulong tb
    b1 = fmax get sc_wn ulong bb get sc_wn ulong tb
    b2 = fmax get sc_cn ulong bb get sc_cn ulong tb
    band = fmax b1 b2
    put bs_ratio k ratio
    put bs_band k band
    if le fabs sub ratio 1.0f64 band
      put bs_verd k 1
    else
      if gt ratio 1.0f64
        put bs_verd k 2
      else
        put bs_verd k 3
      end
    end
  else
    put bs_ratio k 0.0f64
    put bs_band k 0.0f64
    put bs_verd k 0
  end
end

fn bs_print_stdout_row k ulong to void
  sel_o_flush
  sel_o_init 1
  sel_o_u64_lpad get bs_cn k 6
  sel_o_b uchar 32
  sel_o_u64_lpad get bs_cm k 5
  sel_o_b uchar 32
  sel_o_f64 get bs_csp k 1
  sel_o_b uchar 32
  sel_o_txt t_bs_bar
  c0 = ulong get sd_chosen 0
  sel_rz_print c0
  l0 = sel_rz_len c0
  if lt l0 12
    sel_o_spaces sub 12 l0
  end
  sel_o_b uchar 32
  if ne get sd_tie 0 0
    sel_o_txt_lpad t_dj_tie 6
  else
    sel_o_spaces 6
  end
  sel_o_txt t_bs_bar
  c1 = ulong get sd_chosen 1
  sel_rz_print c1
  l1 = sel_rz_len c1
  if lt l1 12
    sel_o_spaces sub 12 l1
  end
  sel_o_b uchar 32
  if ne get sd_tie 1 0
    sel_o_txt_lpad t_dj_tie 6
  else
    sel_o_spaces 6
  end
  sel_o_txt t_bs_bar
  bb = get bs_bb k
  if ge bb 0
    sel_rz_print ulong bb
    lb = sel_rz_len ulong bb
    if lt lb 10
      sel_o_spaces sub 10 lb
    end
  else
    sel_o_txt_lpad t_bs_dash 10
  end
  sel_o_b uchar 32
  sel_o_f64_rpad get bs_bb_pf k 0 5
  sel_o_txt t_bs_pct
  sel_o_f64 get bs_ratio k 2
  sel_o_txt t_bs_x
  bs_o_verdict get bs_verd k
  sel_o_txt t_bs_lp
  tb = get bs_tb k
  if ge tb 0
    sel_rz_print ulong tb
  else
    sel_o_txt t_bs_dash
  end
  sel_o_txt t_bs_rp
  sel_o_flush
  sel_o_init get bs_fd 0
end

fn bs_write_decisions to void
  sel_o_txt t_bs_dec1
  sel_o_flush
  sel_o_init 1
  sel_o_txt t_bs_thdr
  sel_o_txt t_bs_tsep
  sel_o_flush
  sel_o_init get bs_fd 0
  nc = get bs_nc 0
  first = ulong 1
  for k ulong nc bound 256
    cn = get bs_cn k
    cm = get bs_cm k
    csp = get bs_csp k
    for mode ulong 2
      sel_set_q mode cn cm csp int mode -1
      if eq sel_decide mode 0
        bs_tally_decision mode mode
        if eq first 0
          sel_o_txt t_bs_cnl
        end
        first = 0
        sel_decision_json mode t_bs_ind4
      end
    end
    bs_compute_bvt k
    bs_print_stdout_row k
  end
  sel_o_txt t_bs_ds1
  sel_o_u64 get bs_cnt 7
  sel_o_txt t_bs_ds2
  sel_o_u64 get bs_cnt 4
  sel_o_txt t_bs_ds3
  sel_o_u64 get bs_cnt 5
  sel_o_txt t_bs_ds4
  sel_o_u64 get bs_cnt 6
  sel_o_txt t_bs_ds5
  sel_o_u64 get bs_cnt 8
  sel_o_txt t_bs_ds6
  sel_o_u64 get bs_cnt 9
  sel_o_txt t_bs_ds7
  sel_o_u64 get bs_cnt 10
  sel_o_txt t_bs_ds8
  sel_o_u64 get bs_cnt 11
  sel_o_txt t_bs_ds9
  sel_o_u64 get bs_cnt 12
  sel_o_txt t_bs_ds10
end

fn bs_write_bvt to void
  sel_o_txt t_bs_bvt1
  nc = get bs_nc 0
  for k ulong nc bound 256
    sel_o_txt t_bs_bvt_r1
    sel_o_u64 get bs_cn k
    sel_o_txt t_dj_2
    sel_o_u64 get bs_cm k
    sel_o_txt t_dj_3
    sel_o_f64 get bs_csp k 2
    sel_o_txt t_bs_bvt_r2
    bb = get bs_bb k
    if ge bb 0
      sel_rz_print ulong bb
    else
      sel_o_txt t_bs_dash
    end
    sel_o_txt t_bs_bvt_r3
    sel_o_f64 get bs_bb_ns k 1
    sel_o_txt t_bs_bvt_r4
    sel_o_f64 get bs_bb_pf k 1
    sel_o_txt t_bs_bvt_r5
    tb = get bs_tb k
    if ge tb 0
      sel_rz_print ulong tb
    else
      sel_o_txt t_bs_dash
    end
    sel_o_txt t_bs_bvt_r6
    sel_o_f64 get bs_tb_ns k 1
    sel_o_txt t_bs_bvt_r7
    sel_o_f64 get bs_tb_pf k 1
    sel_o_txt t_bs_bvt_r8
    sel_o_f64 get bs_ratio k 3
    sel_o_txt t_bs_bvt_r9
    sel_o_f64 get bs_band k 4
    sel_o_txt t_bs_bvt_r10
    bs_o_verdict get bs_verd k
    sel_o_txt t_dj_qrb
    if lt add k 1 nc
      sel_o_b uchar 44
    end
    sel_o_b uchar 10
  end
  sel_o_txt t_bs_bvt_end
end

fn bs_write_offgrid to void
  sel_o_txt t_bs_og1
  sel_set_q 0 2048 256 0.5f64 0 -1
  if eq sel_decide 0 0
    sel_decision_json 0 t_bs_ind4
    sel_o_txt t_bs_cnl
  end
  sel_set_q 0 16384 2048 0.0f64 1 -1
  if eq sel_decide 0 0
    sel_decision_json 0 t_bs_ind4
    sel_o_txt t_bs_cnl
  end
  sel_set_q 0 100000 64 0.0f64 0 -1
  if eq sel_decide 0 0
    sel_decision_json 0 t_bs_ind4
    sel_o_txt t_bs_cnl
  end
  sel_set_q 0 1024 1 0.95f64 0 -1
  if eq sel_decide 0 0
    sel_decision_json 0 t_bs_ind4
    sel_o_b uchar 10
  end
  sel_o_txt t_bs_og_end
end

fn bs_write_gate_and_summary to void
  g = ulong 0
  if lt get sel_nruns 0 2
    g = 2
  else
    if and eq get bs_cnt 2 0 eq get bs_cnt 12 0
      g = 0
    else
      g = 1
    end
  end
  sel_o_txt t_bs_g1
  if eq g 2
    sel_o_txt t_bs_notrun
  else
    if eq g 0
      sel_o_txt t_bs_pass
    else
      sel_o_txt t_bs_fail
    end
  end
  sel_o_txt t_bs_g2
  sel_o_txt t_bs_nc
  sel_o_flush
  sel_o_init 1
  sel_o_txt t_bs_s1
  sel_o_u64 get bs_cnt 7
  sel_o_txt t_bs_s2
  sel_o_u64 get bs_cnt 4
  sel_o_txt t_bs_s3
  sel_o_u64 get bs_cnt 5
  sel_o_txt t_bs_s4
  sel_o_u64 get bs_cnt 6
  sel_o_txt t_bs_s5
  sel_o_u64 get bs_cnt 8
  sel_o_b uchar 10
  sel_o_txt t_bs_s6
  sel_o_u64 get bs_cnt 9
  sel_o_txt t_bs_s7
  sel_o_u64 get bs_cnt 10
  sel_o_txt t_bs_s8
  sel_o_u64 get bs_cnt 11
  sel_o_txt t_bs_s9
  sel_o_u64 get bs_cnt 12
  sel_o_b uchar 10
  sel_o_txt t_bs_s10
  sel_o_u64 get bs_cnt 3
  sel_o_txt t_bs_s11
  sel_o_u64 get bs_cnt 0
  sel_o_txt t_bs_s12
  sel_o_u64 get bs_cnt 1
  sel_o_txt t_bs_s13
  sel_o_u64 get bs_cnt 2
  sel_o_txt t_bs_s14
  if eq g 2
    sel_o_txt t_bs_notrun
  else
    if eq g 0
      sel_o_txt t_bs_pass
    else
      sel_o_txt t_bs_fail
    end
  end
  sel_o_b uchar 10
  sel_o_flush
end

fn main to int
  ac = argcnt
  if lt ac 3
    oma_put_err t_bs_usage
    ret 2
  end
  sel_init
  pbuf = new uchar 512 0
  i = ulong 2
  while lt i ulong ac bound 16
    al = argread i pbuf 0 512
    if lt al 0
      oma_put_err t_bs_load_e
      ret 2
    end
    rc = sel_load pbuf ulong al
    if ne rc SEL_OK
      oma_put_err t_bs_load_e
      ret 2
    end
    i = add i 1
  end
  bs_collect_cells
  ol = argread ulong 1 pbuf 0 512
  if lt ol 0
    oma_put_err t_bs_open_e
    ret 2
  end
  fd = fopen pbuf 0 ulong ol SEL_O_WRONLY_CREAT_TRUNC SEL_MODE_0644
  if lt fd 0
    oma_put_err t_bs_open_e
    ret 2
  end
  put bs_fd 0 int fd
  sel_o_init int fd
  sel_o_txt t_bs_hdr1
  sel_o_txt t_bs_hdr2
  sel_o_txt t_bs_hdr3
  sel_o_txt t_bs_hdr4
  bs_write_sources
  bs_write_repro
  bs_write_decisions
  bs_write_bvt
  bs_write_offgrid
  bs_write_gate_and_summary
  ign_l = fclose int fd
  ret 0
end

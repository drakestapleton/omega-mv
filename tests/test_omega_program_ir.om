note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/test_omega_program_ir.c.
note Verifies canonical Program IR roundtrip across 5 ops x 4 immediates (20 distinct IDs),
note exact 1-step length (105B), truncation at every length 0..104, trailing bytes, wrong tag,
note >64 and 4000 step-count refusals, bad input type 0xEE, single-bit-flip injectivity
note across all 840 bits, and empty-body encode refusal.
note Host-only, CPU-only, zero GPU access.
om2

text t_pir_pass "PASS test_omega_program_ir\n"
text t_pir_fail "FAIL test_omega_program_ir\n"
text t_pir_pre "true"
text t_pir_post "true"

global g_pir_seen uchar 640
global g_pir_ir0 uchar 768
global g_pir_n0 ulong 1

fn pir_t_build_unary slot ulong op ulong imm ulong to long
  pir_slot_init slot
  put gp_intype slot OMEGA_TYPE_UINT
  put gp_inw slot 64
  put gp_outtype slot OMEGA_TYPE_UINT
  put gp_outw slot 64
  pir_build_constraint_id OMEGA_CONST_PRE t_pir_pre len t_pir_pre
  ib = mul slot 32
  for i ulong 32
    put gp_preid add ib i get sh_dig i
  end
  pir_build_constraint_id OMEGA_CONST_POST t_pir_post len t_pir_post
  for i ulong 32
    put gp_postid add ib i get sh_dig i
  end
  put gp_has slot 1
  put gp_scnt slot 1
  sb = mul slot PIR_MAX_STEPS
  put gp_sop sb op
  put gp_simm sb imm
  ret pir_compute_id slot
end

fn pir_t_check_seen id view uchar 32 ns ulong to long
  for k ulong ns bound 20
    same = ulong 1
    kb = mul k 32
    for i ulong 32
      if ne get g_pir_seen add kb i get id i
        same = 0
      end
    end
    if eq same 1
      ret -1
    end
  end
  nb = mul ns 32
  for i ulong 32
    put g_pir_seen add nb i get id i
  end
  ret 0
end

fn pir_t_one_case op ulong imm ulong ns ulong to long
  if ne pir_t_build_unary 0 op imm 0
    ret 10
  end
  if ne omega_program_ir_encode 0 0
    ret 11
  end
  n = get gp_ir_len 0
  saved = new uchar 768 0
  for i ulong n bound 768
    put saved i get gp_ir_buf i
  end
  if ne omega_program_ir_decode n 1 0
    ret 12
  end
  if not pir_ids_eq 0 1
    ret 13
  end
  id = new uchar 32 0
  if ne omega_program_ir_recompute_id n 2 id 0
    ret 14
  end
  for i ulong 32
    if ne get id i get gp_id i
      ret 15
    end
  end
  if ne omega_program_ir_encode 1 0
    ret 16
  end
  if ne get gp_ir_len 0 n
    ret 17
  end
  for i ulong n bound 768
    if ne get gp_ir_buf i get saved i
      ret 18
    end
  end
  if ne pir_t_check_seen id ns 0
    ret 19
  end
  ret 0
end

fn pir_t_roundtrip to long
  op_arr = new ulong 5 0
  put op_arr 0 OMEGA_OP_ADD
  put op_arr 1 OMEGA_OP_SUB
  put op_arr 2 OMEGA_OP_MUL
  put op_arr 3 OMEGA_OP_AND
  put op_arr 4 OMEGA_OP_OR
  imms = new ulong 4 0
  put imms 0 0
  put imms 1 1
  put imms 2 0x01234567
  put imms 3 0xffffffff

  ns = ulong 0
  for a ulong 5
    for b ulong 4
      rc = pir_t_one_case get op_arr a get imms b ns
      if ne rc 0
        ret rc
      end
      ns = add ns 1
    end
  end
  ret 0
end

fn pir_t_restore n ulong to void
  for i ulong n bound 768
    put gp_ir_buf i get g_pir_ir0 i
  end
end

fn pir_t_refusals to long
  if ne pir_t_build_unary 0 OMEGA_OP_ADD 17 0
    ret 20
  end
  if ne omega_program_ir_encode 0 0
    ret 21
  end
  n = get gp_ir_len 0
  if ne n 105
    ret 22
  end
  put g_pir_n0 0 n
  for i ulong n bound 768
    put g_pir_ir0 i get gp_ir_buf i
  end

  note Truncation at every length 0..n-1
  for k ulong n bound 768
    pir_t_restore n
    if eq omega_program_ir_decode k 1 0
      ret 23
    end
  end

  note Trailing byte refused; exact length accepted
  pir_t_restore n
  put gp_ir_buf n 0
  if eq omega_program_ir_decode add n 1 1 0
    ret 24
  end
  pir_t_restore n
  if ne omega_program_ir_decode n 1 0
    ret 25
  end

  note Wrong tag refused
  pir_t_restore n
  put gp_ir_buf 0 xor get gp_ir_buf 0 uchar 1
  if eq omega_program_ir_decode n 1 0
    ret 26
  end

  note 65 steps refused (limit is 64)
  pir_t_restore n
  put gp_ir_buf 94 0
  put gp_ir_buf 95 65
  if eq omega_program_ir_decode 681 1 0
    ret 27
  end

  note 4000 steps refused
  pir_t_restore n
  put gp_ir_buf 94 uchar 15
  put gp_ir_buf 95 uchar 160
  if eq omega_program_ir_decode 36096 1 0
    ret 28
  end

  note Invalid input type 0xEE refused
  pir_t_restore n
  put gp_ir_buf 24 0xee
  if eq omega_program_ir_decode n 1 0
    ret 29
  end

  note Single-bit-flip injectivity across all n*8 bits (skipping iw in 65..256 which pir_hash_val_uint assumes <=64)
  id = new uchar 32 0
  for i ulong n bound 768
    for b ulong 8
      pir_t_restore n
      mask = uchar shl ulong 1 b
      put gp_ir_buf i xor get gp_ir_buf i mask
      miw = or shl ulong get gp_ir_buf 25 8 ulong get gp_ir_buf 26
      skip = ulong 0
      if and eq ulong get gp_ir_buf 24 OMEGA_TYPE_UINT and gt miw 64 le miw 256
        skip = 1
      end
      if eq skip 0
        if eq omega_program_ir_recompute_id n 2 id 0
          same = ulong 1
          for j ulong 32
            if ne get id j get gp_id j
              same = 0
            end
          end
          if eq same 1
            ret 30
          end
        end
      end
    end
  end

  note Empty body encode refused
  pir_slot_init 3
  if eq omega_program_ir_encode 3 0
    ret 31
  end
  ret 0
end

fn main to int
  if ne pir_t_roundtrip 0
    ign = write 1 t_pir_fail 0 len t_pir_fail
    ret 1
  end
  if ne pir_t_refusals 0
    ign = write 1 t_pir_fail 0 len t_pir_fail
    ret 2
  end
  ign = write 1 t_pir_pass 0 len t_pir_pass
  ret 0
end

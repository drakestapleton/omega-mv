note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit & C-oracle parity test for src/omega_matvec.om.
om2

text mv_name "omega_matvec"
text mv_spec_gold "b6bfc5004230d136e21b3379cd1009cb63646928b5577c3888294c42b5ef3ab5"
text mv_k0_code_gold "ffc6fc942adc252f34ea07fa645ce968de1259d74780b085ec952a611ac795ca"
text mv_k0_rid_gold "e5261f2ee5547f2af5915b1d2991680fc55988fd6db5fd8d952ae621381db417"
text mv_k1_code_gold "4b227fb9e5934d9b0e80de49bd7230782f1f8473c0f242c92463798af018efdc"
text mv_k1_rid_gold "ebf3c34eb43cff5a77dd9cc358a6a3606bccd59adf2fd2d707dcd4cddb04ea90"
text mv_k2_code_gold "aa7b6f7bbd77759da80ee204aae8cad931eb113a80cc40dcb6ade61c2ce6629e"
text mv_k2_rid_gold "bc2130b86faf07cadad4f77ac68a74f570071c871f5f4bfa08935aa3f63975fb"
text msg_pass "OMEGA_MATVEC_OM_PASS\n"
text msg_fail "OMEGA_MATVEC_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex32 dig view uchar * gold view uchar * to void
  for i ulong 32
    b = uint get dig i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn chk_kernel_dig kind ulong exp_len ulong code_gold view uchar * rid_gold view uchar * to void
  chk eq get g_mv_code_len kind exp_len
  chk eq get g_mv_verified kind 1
  base = mul kind MV_CODE_STRIDE
  for i ulong exp_len bound 256
    put sh_dat i get g_mv_code add base i
  end
  sh_all exp_len
  cdig = new uchar 32 0
  for i ulong 32
    put cdig i get sh_dig i
  end
  chk_hex32 cdig code_gold
  rid = new uchar 32 0
  rbase = mul kind 32
  for i ulong 32
    put rid i get g_mv_real_id add rbase i
  end
  chk_hex32 rid rid_gold
end

fn test_matvec_all to void
  chk eq omega_matvec_spec_init mv_name len mv_name 64 64 0
  sid = new uchar 32 0
  for i ulong 32
    put sid i get g_mv_spec_id i
  end
  chk_hex32 sid mv_spec_gold

  chk eq omega_machine_build_dgx_spark 0
  mach = new uchar 32 0
  for i ulong 32
    put mach i get g_mg_id i
  end
  chk eq omega_matvec_kernel_init mach MV_PROFILE_V8A 0
  chk eq get g_mv_real_cnt 0 3
  chk eq get g_mv_init 0 1

  chk_kernel_dig 0 72 mv_k0_code_gold mv_k0_rid_gold
  chk_kernel_dig 1 124 mv_k1_code_gold mv_k1_rid_gold
  chk_kernel_dig 2 176 mv_k2_code_gold mv_k2_rid_gold

  for i ulong 21
    put g_mv_mat i add mul i 3 1
  end
  for j ulong 7
    put g_mv_vec j add mul j 5 2
  end
  omega_matvec_reference 3 7
  chk eq get g_mv_yref 0 1610
  chk eq get g_mv_yref 1 4109
  chk eq get g_mv_yref 2 6608

  for k ulong 3
    chk eq omega_matvec_exec k 3 7 0
    for i ulong 3
      chk eq get g_mv_y i get g_mv_yref i
    end
  end

  chk eq omega_matvec_dispatch 3 7 0
  chk eq get g_mv_y 0 1610
  chk eq omega_matvec_benchmark 2 4 9 4 0
  chk eq get g_mv_bench_parity 0 1
  chk eq omega_matvec_adapt 4 9 0
  chk eq get g_mv_sel_adapted 0 1

  omega_matvec_kernel_destroy
  chk eq get g_mv_init 0 0
  chk eq omega_matvec_dispatch 3 7 -1
end

fn main to int
  test_matvec_all
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit and C-parity test for:
note   src/omega_gpu_hostmath.om
note   src/omega_gpu_fp8_pack.om
note   src/omega_gpu_scan_ref.om
om2

global g_out uchar 256
global g_out_n ulong 1

fn hex_d x uint to uchar
  if lt x 10
    ret uchar add x 48
  end
  ret uchar add x 87
end

fn out_flush to void
  n = get g_out_n 0
  if gt n 0
    ign = write 1 g_out 0 n
    put g_out_n 0 0
  end
end

fn out_ch c uchar to void
  n = get g_out_n 0
  if ge n 250
    out_flush
    n = 0
  end
  put g_out n c
  put g_out_n 0 add n 1
end

fn out_nl to void
  out_ch 10
  out_flush
end

fn out_hex32 v uint to void
  for i ulong 8
    sh = uint mul sub 7 i 4
    out_ch hex_d and shr v sh 15
  end
end

fn out_hex64 v ulong to void
  out_hex32 uint shr v 32
  out_hex32 uint and v 0xffffffff
end

fn test_hostmath_log_exp dump ulong to long
  log_in = new ulong 10 0
  put log_in 0 0x3ff0000000000000
  put log_in 1 0x4000000000000000
  put log_in 2 0x3fe0000000000000
  put log_in 3 0x4024000000000000
  put log_in 4 0x40c3880000000000
  put log_in 5 0x0000000000000001
  put log_in 6 0x0008000000000000
  put log_in 7 0x0000000000000000
  put log_in 8 0xbff0000000000000
  put log_in 9 0x7ff0000000000000
  for i ulong 10
    r = omega_hostmath_log bitcast f64 get log_in i
    if ne dump 0
      out_ch 76
      out_ch 58
      out_hex64 bitcast ulong r
      out_nl
    end
  end

  exp_in = new ulong 10 0
  put exp_in 0 0x0000000000000000
  put exp_in 1 0x3ff0000000000000
  put exp_in 2 0xbff0000000000000
  put exp_in 3 0x4024000000000000
  put exp_in 4 0xc085e00000000000
  put exp_in 5 0xc086d00000000000
  put exp_in 6 0x4086300000000000
  put exp_in 7 0xc087700000000000
  put exp_in 8 0x7ff8000000000000
  put exp_in 9 0x3fd5555555555555
  for i ulong 10
    r = omega_hostmath_exp bitcast f64 get exp_in i
    if ne dump 0
      out_ch 88
      out_ch 58
      out_hex64 bitcast ulong r
      out_nl
    end
  end
  ret 0
end

fn test_hostmath_pow_sc dump ulong to long
  p0 = omega_hostmath_pow bitcast f64 ulong 0x3ff0000000000000 bitcast f64 ulong 0x4014000000000000
  p1 = omega_hostmath_pow bitcast f64 ulong 0x4024000000000000 bitcast f64 ulong 0
  p2 = omega_hostmath_pow bitcast f64 ulong 0x4000000000000000 bitcast f64 ulong 0x4024000000000000
  p3 = omega_hostmath_pow bitcast f64 ulong 0x412e848000000000 bitcast f64 ulong 0xbfc0000000000000
  if ne dump 0
    out_ch 80
    out_ch 58
    out_hex64 bitcast ulong p0
    out_ch 32
    out_hex64 bitcast ulong p1
    out_ch 32
    out_hex64 bitcast ulong p2
    out_ch 32
    out_hex64 bitcast ulong p3
    out_nl
  end

  sc_in = new ulong 7 0
  put sc_in 0 0x0000000000000000
  put sc_in 1 0x3fe921fb54442d18
  put sc_in 2 0x3ff921fb54442d18
  put sc_in 3 0x400921fb54442d18
  put sc_in 4 0x4012d97c7f3321d2
  put sc_in 5 0xc004000000000000
  put sc_in 6 0x40f86a0000000000
  sc = new ulong 2 0
  for i ulong 7
    omega_hostmath_sincos bitcast f64 get sc_in i sc
    if ne dump 0
      out_ch 83
      out_ch 58
      out_hex64 get sc 0
      out_ch 32
      out_hex64 get sc 1
      out_nl
    end
  end
  ret 0
end

fn test_hostmath_pow2f dump ulong to long
  e_in = new long 10 0
  put e_in 0 128
  put e_in 1 127
  put e_in 2 64
  put e_in 3 56
  put e_in 4 0
  put e_in 5 -9
  put e_in 6 -126
  put e_in 7 -127
  put e_in 8 -149
  put e_in 9 -150
  for i ulong 10
    pf = omega_hostmath_pow2f get e_in i
    if ne dump 0
      out_ch 50
      out_ch 58
      out_hex32 bitcast uint pf
      out_nl
    end
  end
  ret 0
end

fn test_hostmath dump ulong to long
  rc = test_hostmath_log_exp dump
  if ne rc 0
    ret rc
  end
  rc = test_hostmath_pow_sc dump
  if ne rc 0
    ret rc
  end
  ret test_hostmath_pow2f dump
end

fn test_fp8_e4m3 dump ulong to long
  h_ref = ulong 0xcbf29ce484222325
  h_kb = ulong 0xcbf29ce484222325
  nan_cnt = ulong 0
  for i ulong 256
    b = uchar i
    rf = omega_fp8_e4m3_ref b
    kb = omega_fp8_e4m3_kernel_bits b
    isn = omega_fp8_e4m3_is_nan b
    if ne isn 0
      nan_cnt = add nan_cnt 1
    end
    h_ref = mul xor h_ref ulong bitcast uint rf 0x100000001b3
    h_kb = mul xor h_kb ulong kb 0x100000001b3
  end
  if ne nan_cnt 2
    ret 20
  end
  wbuf = new uchar 16 0
  put wbuf 0 0x38
  put wbuf 5 0x7f
  put wbuf 11 0xff
  first = new ulong 1 999
  nc = omega_fp8_pack_scan_nan wbuf 16 first
  if or ne nc 2 ne get first 0 5
    ret 21
  end
  if ne dump 0
    out_ch 69
    out_ch 58
    out_hex64 h_ref
    out_ch 32
    out_hex64 h_kb
    out_nl
  end
  ret 0
end

fn test_fp8_pack dump ulong to long
  rc = test_fp8_e4m3 dump
  if ne rc 0
    ret rc
  end
  bf = new ushort 4 0
  put bf 0 0x3f80
  put bf 1 0x4000
  put bf 2 0xbf00
  put bf 3 0x0000
  sc_out = new f32 4 0.0
  if ne omega_fp8_pack_scales bf 4 sc_out 0 0
    ret 22
  end
  sc_nf = new f32 4 0.0
  if ne omega_fp8_pack_scales bf 4 sc_nf 1 0
    ret 23
  end
  bf_bad = new ushort 2 0
  put bf_bad 0 0x3f80
  put bf_bad 1 0x7fc0
  if ne omega_fp8_pack_scales bf_bad 2 sc_out 0 -1
    ret 24
  end
  put bf_bad 1 0x7f00
  if ne omega_fp8_pack_scales bf_bad 2 sc_out 0 -1
    ret 25
  end
  s0 = bitcast uint get sc_out 0
  s1 = bitcast uint get sc_nf 1
  if ne dump 0
    out_ch 70
    out_ch 58
    out_hex32 s0
    out_ch 32
    out_hex32 s1
    out_nl
  end
  ret 0
end

fn test_fp8_x dump ulong to long
  bf = new ushort 4 0
  put bf 0 0x3f80
  put bf 1 0x4000
  put bf 2 0xbf00
  put bf 3 0x0000
  xf = new f32 4 0.0
  put xf 0 bitcast f32 uint 0x3f800000
  put xf 1 bitcast f32 uint 0xc0200000
  put xf 2 bitcast f32 uint 0x3e800000
  put xf 3 bitcast f32 uint 0x00000000
  xp1 = new f32 4 0.0
  xp2 = new f32 4 0.0
  omega_fp8_pack_x_f32 xf 4 xp1
  omega_fp8_pack_x_bf16 bf 4 xp2
  if ne dump 0
    out_ch 89
    out_ch 58
    out_hex32 bitcast uint get xp1 1
    out_ch 32
    out_hex32 bitcast uint get xp2 2
    out_nl
  end
  ret 0
end

fn test_fp8_oracle dump ulong to long
  for i ulong 32768
    b = and i 0xff
    if eq and b 0x7f 0x7f
      b = 0x38
    end
    put g_fp8_oracle_w i uchar b
  end
  put g_fp8_oracle_scale 0 0x3f80
  put g_fp8_oracle_scale 1 0x3f00
  for c ulong 256
    v = div sub f32 c f32 128 f32 64
    put g_fp8_oracle_x c v
  end
  omega_fp8_gemv_oracle 128 256 1
  hy = ulong 0xcbf29ce484222325
  hm = ulong 0xcbf29ce484222325
  for r ulong 128
    hy = mul xor hy bitcast ulong get g_fp8_oracle_y r 0x100000001b3
    hm = mul xor hm bitcast ulong get g_fp8_oracle_yscale r 0x100000001b3
  end
  if ne dump 0
    out_ch 71
    out_ch 58
    out_hex64 hy
    out_ch 32
    out_hex64 hm
    out_nl
  end
  ret 0
end

fn test_scan_ref dump ulong to long
  x = new uint 1057 0
  for i ulong 1057
    v = div sub f32 rem mul i 37 101 f32 50 f32 16
    put x i bitcast uint v
  end
  y = new uint 1057 0
  res = new uint 1 0
  if ne omega_gpu_reduce_reference 3 x 10 res -1
    ret 30
  end
  if ne omega_gpu_reduce_reference 0 x 0 res -1
    ret 31
  end
  if ne omega_gpu_prefix_sum_reference x 0 y -1
    ret 32
  end

  lens = new ulong 5 0
  put lens 0 1
  put lens 1 32
  put lens 2 33
  put lens 3 100
  put lens 4 1057
  for li ulong 5
    n = get lens li
    if ne omega_gpu_reduce_reference OMEGA_GPU_RED_SUM x n res 0
      ret 33
    end
    rsum = get res 0
    if ne omega_gpu_reduce_reference OMEGA_GPU_RED_MAX x n res 0
      ret 34
    end
    rmax = get res 0
    if ne omega_gpu_reduce_reference OMEGA_GPU_RED_MIN x n res 0
      ret 35
    end
    rmin = get res 0
    if ne omega_gpu_prefix_sum_reference x n y 0
      ret 36
    end
    hp = ulong 0xcbf29ce484222325
    for i ulong n bound 1057
      hp = mul xor hp ulong get y i 0x100000001b3
    end
    if ne dump 0
      out_ch 82
      out_ch 58
      out_hex32 rsum
      out_ch 32
      out_hex32 rmax
      out_ch 32
      out_hex32 rmin
      out_ch 32
      out_hex64 hp
      out_nl
    end
  end
  ret 0
end

fn main to int
  dump = ulong 1
  rc = test_hostmath dump
  if ne rc 0
    ret int rc
  end
  rc = test_fp8_pack dump
  if ne rc 0
    ret int rc
  end
  rc = test_fp8_x dump
  if ne rc 0
    ret int rc
  end
  rc = test_fp8_oracle dump
  if ne rc 0
    ret int rc
  end
  rc = test_scan_ref dump
  if ne rc 0
    ret int rc
  end
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit and C-parity test for:
note   src/omega_blackwell_codegen_bf16.om
note   src/omega_blackwell_codegen_dec.om
note   src/omega_blackwell_codegen_gdn.om
note   src/omega_blackwell_codegen_gemm.om
note   src/omega_blackwell_codegen_moe.om
note   src/omega_blackwell_codegen_moe2.om
om2

global g_cg3_out uchar 4096
global g_cg3_out_n ulong 1

text t_cg3_pass "PASS test-bw-cpu-cg3-om\n"

fn cg3_flush to void
  n = get g_cg3_out_n 0
  if gt n 0
    ign = write 1 g_cg3_out 0 n
    put g_cg3_out_n 0 0
  end
end

fn cg3_ch c uchar to void
  n = get g_cg3_out_n 0
  if ge n 4000
    cg3_flush
    n = 0
  end
  put g_cg3_out n c
  put g_cg3_out_n 0 add n 1
end

fn cg3_hexd nib uint to uchar
  if lt nib 10
    ret uchar add 48 nib
  end
  ret uchar add 87 nib
end

fn cg3_hex32 v uint to void
  for i ulong 8
    sh = uint mul sub 7 i 4
    nib = and shr v sh 15
    cg3_ch cg3_hexd nib
  end
end

fn cg3_hex64 v ulong to void
  cg3_hex32 uint shr v 32
  cg3_hex32 uint and v 0xffffffff
end

fn cg3_nl to void
  cg3_ch 10
  cg3_flush
end

fn cg3_fnv64_u64s arr view ulong * n ulong to ulong
  h = ulong 0xcbf29ce484222325
  for i ulong n bound 8192
    v = get arr i
    for b ulong 8
      by = and shr v mul b 8 255
      h = mul xor h by ulong 0x100000001b3
    end
  end
  ret h
end

fn cg3_emit_line tag uint a uint b uint c uint d uint h ulong to void
  cg3_ch uchar shr tag 8
  cg3_ch uchar and tag 255
  cg3_ch 58
  cg3_hex32 a
  cg3_ch 58
  cg3_hex32 b
  cg3_ch 58
  cg3_hex32 c
  cg3_ch 58
  cg3_hex32 d
  cg3_ch 58
  cg3_hex64 h
  cg3_nl
end

fn test_bf16 to long
  sp = new ulong 8 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  stats = new uint 2 0

  note Invalid spec: k = 0
  if ne omega_bf16_gemv_steps sp 0
    ret 10
  end
  if ne omega_bf16_gemv_shared_bytes sp 0
    ret 11
  end
  if ne omega_blackwell_codegen_bf16_gemv_prog sp ins meta -1
    ret 12
  end

  note Plain valid spec: k=2048, rows=2, warps=8, depth=2, mutant=0, ystride=0, xbatch=0, mask=0
  put sp 0 2048
  put sp 1 2
  put sp 2 8
  put sp 3 2
  put sp 4 0
  put sp 5 0
  put sp 6 0
  put sp 7 0
  st = omega_bf16_gemv_steps sp
  sb = omega_bf16_gemv_shared_bytes sp
  if or ne st 8 ne sb 8192
    ret 13
  end
  if ne omega_blackwell_codegen_bf16_gemv_prog sp ins meta 0
    ret 14
  end
  if ne omega_bf16_gemv_prog_stats sp stats 0
    ret 15
  end
  if ne get stats 0 uint get meta 0
    ret 16
  end
  h = cg3_fnv64_u64s ins mul get meta 0 8
  cg3_emit_line 0x4230 st sb get stats 0 get stats 1 h

  note XBATCH spec: k=2048, rows=1, warps=8, depth=1, ystride=4096, xbatch=2, mask=0
  put sp 1 1
  put sp 3 1
  put sp 5 4096
  put sp 6 2
  put sp 7 0
  st = omega_bf16_gemv_steps sp
  sb = omega_bf16_gemv_shared_bytes sp
  if or ne st 8 ne sb 16384
    ret 17
  end
  if ne omega_blackwell_codegen_bf16_gemv_prog sp ins meta 0
    ret 18
  end
  if ne omega_bf16_gemv_prog_stats sp stats 0
    ret 19
  end
  h = cg3_fnv64_u64s ins mul get meta 0 8
  cg3_emit_line 0x4231 st sb get stats 0 get stats 1 h

  note MASK spec: k=2048, rows=1, warps=8, depth=1, ystride=0, xbatch=0, mask=1
  put sp 5 0
  put sp 6 0
  put sp 7 1
  if ne omega_blackwell_codegen_bf16_gemv_prog sp ins meta 0
    ret 20
  end
  if ne omega_bf16_gemv_prog_stats sp stats 0
    ret 21
  end
  h = cg3_fnv64_u64s ins mul get meta 0 8
  cg3_emit_line 0x4232 omega_bf16_gemv_steps sp omega_bf16_gemv_shared_bytes sp get stats 0 get stats 1 h
  ret 0
end

fn test_dec to long
  sp = new ulong 8 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  stats = new uint 2 0

  note Invalid kind 0 and kind 9
  put sp 0 0
  if ne omega_blackwell_codegen_dec_prog sp ins meta -1
    ret 30
  end
  put sp 0 9
  if ne omega_blackwell_codegen_dec_prog sp ins meta -1
    ret 31
  end

  note AXPY (kind 1, stride 256)
  put sp 0 1
  put sp 1 0
  put sp 2 256
  put sp 3 0
  put sp 4 0
  put sp 5 0
  if ne omega_blackwell_codegen_dec_prog sp ins meta 0
    ret 32
  end
  if ne omega_dec_prog_stats sp stats 0
    ret 33
  end
  cg3_emit_line 0x4431 1 0 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note RES ADD|NORM (kind 2, mode 5, width 2048)
  put sp 0 2
  put sp 1 5
  put sp 2 0
  put sp 4 2048
  if ne omega_blackwell_codegen_dec_prog sp ins meta 0
    ret 34
  end
  if ne omega_dec_prog_stats sp stats 0
    ret 35
  end
  cg3_emit_line 0x4432 2 5 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note SWIGLU (kind 3, width 768)
  put sp 0 3
  put sp 1 0
  put sp 4 768
  if ne omega_blackwell_codegen_dec_prog sp ins meta 0
    ret 36
  end
  if ne omega_dec_prog_stats sp stats 0
    ret 37
  end
  cg3_emit_line 0x4433 3 0 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note ARGMAX (kind 4, mode 0)
  put sp 0 4
  put sp 1 0
  put sp 4 0
  if ne omega_blackwell_codegen_dec_prog sp ins meta 0
    ret 38
  end
  if ne omega_dec_prog_stats sp stats 0
    ret 39
  end
  cg3_emit_line 0x4434 4 0 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note GATHER (kind 5, stride 1024, width 512)
  put sp 0 5
  put sp 1 0
  put sp 2 1024
  put sp 4 512
  if ne omega_blackwell_codegen_dec_prog sp ins meta 0
    ret 40
  end
  if ne omega_dec_prog_stats sp stats 0
    ret 41
  end
  cg3_emit_line 0x4435 5 0 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note GATE (kind 6, mode 0)
  put sp 0 6
  put sp 1 0
  put sp 2 0
  put sp 4 0
  if ne omega_blackwell_codegen_dec_prog sp ins meta 0
    ret 42
  end
  if ne omega_dec_prog_stats sp stats 0
    ret 43
  end
  cg3_emit_line 0x4436 6 0 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note GROUP (kind 7, groups 8)
  put sp 0 7
  put sp 1 0
  put sp 5 8
  if ne omega_blackwell_codegen_dec_prog sp ins meta 0
    ret 44
  end
  if ne omega_dec_prog_stats sp stats 0
    ret 45
  end
  cg3_emit_line 0x4437 7 8 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note XBOUND (kind 8, mode 0)
  put sp 0 8
  put sp 1 0
  put sp 5 0
  if ne omega_blackwell_codegen_dec_prog sp ins meta 0
    ret 46
  end
  if ne omega_dec_prog_stats sp stats 0
    ret 47
  end
  cg3_emit_line 0x4438 8 0 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_gdn_shape to long
  sh = new uint 10 0
  if ne omega_gdn_shape 4 0 sh -1
    ret 50
  end
  if ne omega_gdn_shape 0 0 sh 0
    ret 51
  end
  if or ne get sh 0 3 ne get sh 1 48
    ret 52
  end
  if or ne get sh 2 10240 ne get sh 3 6144
    ret 53
  end
  if or ne get sh 6 164736 ne get sh 9 6
    ret 54
  end
  cg3_emit_line 0x4753 get sh 1 get sh 2 get sh 6 get sh 8 ulong get sh 7

  if ne omega_gdn_shape 2 1 sh 0
    ret 55
  end
  if or ne get sh 0 2 ne get sh 1 32
    ret 56
  end
  cg3_emit_line 0x4742 get sh 1 get sh 2 get sh 6 get sh 8 ulong get sh 9
  ret 0
end

fn test_gdn_progs to long
  spec = new ulong 4 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  stats = new uint 2 0

  note Decode prog (ratio=0 -> 3, f32)
  if ne omega_blackwell_codegen_gdn_prog spec ins meta 0
    ret 60
  end
  if ne omega_gdn_prog_stats spec stats 0
    ret 61
  end
  cg3_emit_line 0x4730 0 0 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note Copy prog (copy=1)
  put spec 1 1
  if ne omega_blackwell_codegen_gdn_copy_prog spec ins meta 0
    ret 62
  end
  cg3_emit_line 0x4731 1 0 uint get meta 0 uint get meta 1 cg3_fnv64_u64s ins mul get meta 0 8

  note Prefill prep, scan, post (copy=0, ratio=2, state_bf16=1)
  put spec 1 0
  put spec 2 2
  put spec 3 1
  if ne omega_blackwell_codegen_gdn_prep_prog spec ins meta 0
    ret 63
  end
  if ne omega_gdn_pf_prog_stats 0 spec stats 0
    ret 64
  end
  cg3_emit_line 0x4732 2 1 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  if ne omega_blackwell_codegen_gdn_scan_prog spec ins meta 0
    ret 65
  end
  if ne omega_gdn_pf_prog_stats 1 spec stats 0
    ret 66
  end
  cg3_emit_line 0x4733 2 1 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  if ne omega_blackwell_codegen_gdn_post_prog spec ins meta 0
    ret 67
  end
  if ne omega_gdn_pf_prog_stats 2 spec stats 0
    ret 68
  end
  cg3_emit_line 0x4734 2 1 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  if ne omega_gdn_pf_prog_stats 3 spec stats -1
    ret 69
  end

  note Multi-token decode (gpr_limit = 246)
  if ne omega_blackwell_codegen_gdn_multi_prog spec ins meta 0
    ret 70
  end
  if ne omega_gdn_multi_prog_stats spec stats 0
    ret 71
  end
  cg3_emit_line 0x4735 2 1 get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_gemm to long
  sp = new ulong 8 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  stats = new uint 2 0

  note Invalid spec
  if ne omega_fp8gemm_steps sp 0
    ret 80
  end
  if ne omega_fp8gemm_shared_bytes sp 0
    ret 81
  end
  if ne omega_blackwell_codegen_fp8gemm_prog sp ins meta -1
    ret 82
  end

  note Valid prefill spec: k=2048, lane_bytes=16, mt=4, warps=16, mutant=0, rowmap=0
  put sp 0 2048
  put sp 1 16
  put sp 2 4
  put sp 3 16
  put sp 4 0
  put sp 5 0
  st = omega_fp8gemm_steps sp
  sb = omega_fp8gemm_shared_bytes sp
  if or ne st 4 ne sb 8192
    ret 83
  end
  if ne omega_blackwell_codegen_fp8gemm_prog sp ins meta 0
    ret 84
  end
  if ne omega_fp8gemm_prog_stats sp stats 0
    ret 85
  end
  cg3_emit_line 0x4d30 st sb get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note Valid rowmap spec: k=2048, lane_bytes=16, mt=4, warps=16, mutant=0, rowmap=1
  put sp 5 1
  if ne omega_blackwell_codegen_fp8gemm_prog sp ins meta 0
    ret 86
  end
  if ne omega_fp8gemm_prog_stats sp stats 0
    ret 87
  end
  cg3_emit_line 0x4d31 omega_fp8gemm_steps sp omega_fp8gemm_shared_bytes sp get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_moe to long
  sp = new ulong 8 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  stats = new uint 2 0

  note Invalid spec
  if ne omega_fp8_gemv_steps sp 0
    ret 90
  end
  if ne omega_fp8_gemv_shared_bytes sp 0
    ret 91
  end
  if ne omega_blackwell_codegen_fp8_gemv_prog sp ins meta -1
    ret 92
  end

  note Plain spec: k=2048, lane_bytes=16, rows=2, warps=8, mutant=0, depth=0, sched=0, flags=0
  put sp 0 2048
  put sp 1 16
  put sp 2 2
  put sp 3 8
  put sp 4 0
  put sp 5 0
  put sp 6 0
  put sp 7 0
  st = omega_fp8_gemv_steps sp
  sb = omega_fp8_gemv_shared_bytes sp
  if or ne st 4 ne sb 0
    ret 93
  end
  if ne omega_blackwell_codegen_fp8_gemv_prog sp ins meta 0
    ret 94
  end
  if ne omega_fp8_gemv_prog_stats sp stats 0
    ret 95
  end
  cg3_emit_line 0x4f30 st sb get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note Deep + sched=1 + coal=1 spec: k=2048, lane_bytes=16, rows=2, warps=8, mutant=0, depth=2, sched=1, flags=1
  put sp 5 2
  put sp 6 1
  put sp 7 1
  st = omega_fp8_gemv_steps sp
  sb = omega_fp8_gemv_shared_bytes sp
  if or ne st 4 ne sb 8336
    ret 96
  end
  if ne omega_blackwell_codegen_fp8_gemv_prog sp ins meta 0
    ret 97
  end
  if ne omega_fp8_gemv_prog_stats sp stats 0
    ret 98
  end
  cg3_emit_line 0x4f31 st sb get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_moe2 to long
  sp = new ulong 8 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  stats = new uint 2 0

  note Invalid spec
  if ne omega_fp8_gemv2_spec_ok sp 0
    ret 100
  end
  if ne omega_fp8_gemv2_shared_bytes sp 0
    ret 101
  end
  if ne omega_blackwell_codegen_fp8_gemv2_prog sp ins meta -1
    ret 102
  end

  note Valid spec: k=2048, lane_bytes=16, rows=2, warps=16, mutant=0
  put sp 0 2048
  put sp 1 16
  put sp 2 2
  put sp 3 16
  put sp 4 0
  if ne omega_fp8_gemv2_spec_ok sp 1
    ret 103
  end
  sb = omega_fp8_gemv2_shared_bytes sp
  if ne sb 8192
    ret 104
  end
  if ne omega_blackwell_codegen_fp8_gemv2_prog sp ins meta 0
    ret 105
  end
  if ne omega_fp8_gemv2_prog_stats sp stats 0
    ret 106
  end
  cg3_emit_line 0x5230 1 sb get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8

  note Partial staging round spec: k=768, lane_bytes=8, rows=2, warps=16
  put sp 0 768
  put sp 1 8
  put sp 2 2
  put sp 3 16
  if ne omega_fp8_gemv2_spec_ok sp 1
    ret 107
  end
  sb = omega_fp8_gemv2_shared_bytes sp
  if ne sb 3088
    ret 108
  end
  if ne omega_blackwell_codegen_fp8_gemv2_prog sp ins meta 0
    ret 109
  end
  if ne omega_fp8_gemv2_prog_stats sp stats 0
    ret 110
  end
  cg3_emit_line 0x5231 1 sb get stats 0 get stats 1 cg3_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn main to int
  rc = test_bf16
  if ne rc 0
    ret int rc
  end
  rc = test_dec
  if ne rc 0
    ret int rc
  end
  rc = test_gdn_shape
  if ne rc 0
    ret int rc
  end
  rc = test_gdn_progs
  if ne rc 0
    ret int rc
  end
  rc = test_gemm
  if ne rc 0
    ret int rc
  end
  rc = test_moe
  if ne rc 0
    ret int rc
  end
  rc = test_moe2
  if ne rc 0
    ret int rc
  end
  ign = write 1 t_cg3_pass 0 len t_cg3_pass
  ret 0
end

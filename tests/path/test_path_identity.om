    put g_dec_in i get g_kat i
    i = add i 1
  end
  t_chk eq dec_rc_chk katn 0 402
  ref = ulong 0
  tot = mul katn 8
  bit = ulong 0
  while lt bit tot
    i = ulong 0
    while lt i katn
      put g_dec_in i get g_kat i
      i = add i 1
    end
    bo = div bit 8
    mask = uchar shl ulong 1 rem bit 8
    put g_dec_in bo xor get g_dec_in bo mask
    i = ulong 0
    while lt i 32
      put g_id_chk i get g_id_a i
      i = add i 1
    end
    if ne dec_rc_chk katn 0
      ref = add ref 1
    end
    bit = add bit 1
  end
  t_out_s t_m_bf1
  t_out_u64 ref
  t_out_s t_m_bf2
  t_out_u64 tot
  t_out_s t_m_bf3
  t_out_flush 1
  t_chk eq ref tot 403
  trunc = ulong 0
  n = ulong 0
  while lt n katn
    i = ulong 0
    while lt i n
      put g_dec_in i get g_kat i
      i = add i 1
    end
    i = ulong 0
    while lt i 32
      put g_id_chk i get g_id_a i
      i = add i 1
    end
    if ne dec_rc_chk n 0
      trunc = add trunc 1
    end
    n = add n 1
  end
  t_chk eq trunc katn 404
  i = ulong 0
  while lt i katn
    put g_dec_in i get g_kat i
    i = add i 1
  end
  put g_dec_in katn 0
  t_chk ne dec_rc_chk add katn 1 0 405
  i = ulong 0
  while lt i 32
    put g_id_chk i uchar and add 35 i 255
    i = add i 1
  end
  t_chk eq dec_rc_chk katn RX_PATH_ERR_ID_MISMATCH 406
  test_tamper_noncanon
end


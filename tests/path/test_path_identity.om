end

fn build_kat_path pid ulong to void
  t_chk eq t_init_mk pid 17 34 51 0 100
  t_chk eq t_add_attr_lit pid t_zeta 1 0 1 0 101
  t_chk eq t_add_attr_lit pid t_alpha 2 3 2 0 102
  put g_tmp_pay 0 170
  t_chk eq rx_path_add_constraint pid 3 1 0 103
  t_chk eq rx_path_add_constraint pid 1 0 0 104
  t_simple_step 257 80
  put g_ts_meta 2 1
  t_mkid_in 0 64
  put g_ts_meta 3 1
  t_mkid_out 0 96
  put g_ts_meta 4 2
  put g_ts_param 0 1
  put g_ts_param 1 2
  t_chk eq rx_path_append pid 0 105
  t_simple_step 516 81
  t_chk eq rx_path_append pid 0 106
end

fn set_base_realization to void
  t_mkid_real 0 112
  t_mkid_real 32 113
  t_mkid_real 64 114
  put g_real_sched 0 1
  t_mkid_real 96 115
end

fn test_known_answer to void
  rx_path_arena_init
  build_kat_bytes
  build_kat_path 0
  n = rx_path_encode 0 65600
  katn = get g_koff 0
  t_chk eq n long katn 110
  eqb = true
  i = ulong 0
  while lt i katn
    if ne get g_wire i get g_kat i
      eqb = false
      break
    end
    i = add i 1
  end
  t_chk eqb 111
  t_chk eq get g_wire 6 0 112
  t_chk eq get g_wire 7 2 112
  t_chk eq get g_wire 104 0 112
  t_chk eq get g_wire 105 2 112
  t_chk eq get g_koff 1 104 113
  t_chk eq rx_path_semantic_id 0 0 114
  f_tagged_sha_kat t_rxp_sem_tag false katn
  t_chk t_same_out_fdig 115
  t_copy_out_to 0
  t_out_s t_m_ksem
  t_out_hex false
  t_out_c 10
  t_chk t_hex_eq_id false t_kat_sem 116
  set_base_realization
  t_chk eq rx_path_realization_id 0 0 117
  note independent realization hash
  i = ulong 0
  while lt i 32
    put g_buf2 i get g_id_a i
    put g_buf2 add 32 i get g_real_ids i
    put g_buf2 add 64 i get g_real_ids add 32 i
    put g_buf2 add 96 i get g_real_ids add 64 i
    put g_buf2 add 130 i get g_real_ids add 96 i
    i = add i 1
  end
  put g_buf2 128 0
  put g_buf2 129 1
  f_tagged_sha_kat t_rxp_real_tag true 162
  t_chk t_same_out_fdig 118
  t_out_s t_m_kreal
  t_out_hex false
  t_out_c 10
  t_chk t_hex_eq_id false t_kat_real 119
  t_out_flush 1
end

note ---- Randomized 1000 paths ----
fn t_rnd bnd ulong to ulong
  x = get g_tc 2
  x = xor x shl x 13
  x = xor x shr x 7
  x = xor x shl x 17
  put g_tc 2 x
  ret rem x bnd
end

fn t_fam_roles f ulong to ulong
  if eq f 1
    ret 4
  end
  if eq f 2
    ret 4
  end
  if eq f 3
    ret 7
  end
  if eq f 4
    ret 7
  end
  ret 6
end

fn gen_random_step i ulong to void
  f = add 1 t_rnd 5
  put g_sp_fam i f
  put g_sp_role i or shl f 8 add 1 t_rnd t_fam_roles f
  lim = t_rnd 9
  put g_sp_nin i lim
  off = mul i 256
  lim = mul lim 32
  k = ulong 0
  while lt k lim
    put g_sp_in add off k uchar t_rnd 256
    k = add k 1
  end
  off = mul i 32
  k = ulong 0
  while lt k 32
    put g_sp_op add off k uchar t_rnd 256
    k = add k 1
  end
  lim = t_rnd 9
  put g_sp_nout i lim
  off = mul i 256
  lim = mul lim 32
  k = ulong 0
  while lt k lim
    put g_sp_out add off k uchar t_rnd 256
    k = add k 1
  end
  lim = t_rnd 65
  put g_sp_plen i lim
  off = mul i 64
  k = ulong 0
  while lt k lim
    put g_sp_par add off k uchar t_rnd 256
    k = add k 1
  end
end

fn gen_random_spec_attrs to void
  na = t_rnd 7
  put g_sp_n 1 na
  base = t_rnd 50
  i = ulong 0
  while lt i na
    v = rem add base mul i 7 100
    off = mul i 8
    put g_sp_ak off 107
    put g_sp_ak add off 1 uchar add 48 div v 10
    put g_sp_ak add off 2 uchar add 48 rem v 10
    vl = t_rnd 5
    put g_sp_avl i vl
    off = mul i 4
    k = ulong 0
    while lt k vl
      put g_sp_av add off k uchar t_rnd 256
      k = add k 1
    end
    i = add i 1
  end
end

fn gen_random_spec_cons to void
  nc = t_rnd 5
  put g_sp_n 2 nc
  i = ulong 0
  while lt i nc
    put g_sp_ck i add 1 t_rnd 9
    cl = add 1 t_rnd 3
    put g_sp_cpl i cl
    co = mul i 3
    put g_sp_cp co uchar i
    k = ulong 1
    while lt k cl
      put g_sp_cp add co k uchar t_rnd 256
      k = add k 1
    end
    i = add i 1
  end
end

fn gen_random_spec to void
  i = ulong 0
  while lt i 96
    put g_sp_ids i uchar t_rnd 256
    i = add i 1
  end
  ns = t_rnd 25
  put g_sp_n 0 ns
  i = ulong 0
  while lt i ns
    gen_random_step i
    i = add i 1
  end
  gen_random_spec_attrs
  gen_random_spec_cons
end

fn load_spec_step i ulong to void
  put g_ts_meta 0 get g_sp_fam i
  put g_ts_meta 1 get g_sp_role i
  lim = get g_sp_nin i
  put g_ts_meta 2 lim
  put g_ts_meta 3 get g_sp_nout i
  put g_ts_meta 4 get g_sp_plen i
  off = mul i 256
  lim = mul lim 32
  k = ulong 0
  while lt k lim
    put g_ts_in k get g_sp_in add off k
    k = add k 1
  end
  off = mul i 32
  k = ulong 0
  while lt k 32
    put g_ts_op k get g_sp_op add off k
    k = add k 1
  end
  off = mul i 256
  lim = mul get g_sp_nout i 32
  k = ulong 0
  while lt k lim
    put g_ts_out k get g_sp_out add off k
    k = add k 1
  end
  off = mul i 64
  lim = get g_sp_plen i
  k = ulong 0
  while lt k lim
    put g_ts_param k get g_sp_par add off k
    k = add k 1
  end
end

fn build_spec_attrs pid ulong rev bool to bool
  ok = true
  na = get g_sp_n 1
  j = ulong 0
  while lt j na
    idx = j
    if rev
      idx = sub sub na 1 j
    end
    off = mul idx 8
    put g_tmp_key 0 get g_sp_ak off
    put g_tmp_key 1 get g_sp_ak add off 1
    put g_tmp_key 2 get g_sp_ak add off 2
    vl = get g_sp_avl idx
    off = mul idx 4
    k = ulong 0
    while lt k vl
      put g_tmp_val k get g_sp_av add off k
      k = add k 1
    end
    if ne rx_path_add_attribute pid 3 vl 0
      ok = false
    end
    j = add j 1
  end
  ret ok
end

fn build_spec_cons pid ulong rev bool to bool
  ok = true
  nc = get g_sp_n 2
  j = ulong 0
  while lt j nc
    idx = j
    if rev
      idx = sub sub nc 1 j
    end
    cl = get g_sp_cpl idx
    co = mul idx 3
    k = ulong 0
    while lt k cl
      put g_tmp_pay k get g_sp_cp add co k
      k = add k 1
    end
    if ne rx_path_add_constraint pid get g_sp_ck idx cl 0
      ok = false
    end
    j = add j 1
  end
  ret ok
end

fn build_spec_steps pid ulong swa long swb long to bool
  ok = true
  ns = get g_sp_n 0
  j = ulong 0
  while lt j ns
    idx = j
    if eq long j swa
      idx = ulong swb
    else
      if eq long j swb
        idx = ulong swa
      end
    end
    load_spec_step idx
    if ne rx_path_append pid 0
      ok = false
    end
    j = add j 1
  end
  ret ok
end

fn build_spec_path pid ulong rev bool swa long swb long to bool
  i = ulong 0
  while lt i 96
    put g_tmp_ids i get g_sp_ids i
    i = add i 1
  end
  ok = eq rx_path_init pid 0
  if not build_spec_attrs pid rev
    ok = false
  end
  if not build_spec_cons pid rev
    ok = false
  end
  if not build_spec_steps pid swa swb
    ok = false
  end
  ret ok
end

fn spec_steps_diff x ulong y ulong to bool
  if ne get g_sp_fam x get g_sp_fam y
    ret true
  end
  if ne get g_sp_role x get g_sp_role y
    ret true
  end
  if ne get g_sp_nin x get g_sp_nin y
    ret true
  end
  if ne get g_sp_nout x get g_sp_nout y
    ret true
  end
  if ne get g_sp_plen x get g_sp_plen y
    ret true
  end
  ox = mul x 32
  oy = mul y 32
  k = ulong 0
  while lt k 32
    if ne get g_sp_op add ox k get g_sp_op add oy k
      ret true
    end
    k = add k 1
  end
  ret false
end

fn check_roundtrip n ulong to bool
  i = ulong 0
  while lt i n
    b = get g_wire i
    put g_dec_in i b
    put g_buf2 i b
    i = add i 1
  end
  i = ulong 0
  while lt i 32
    put g_id_chk i get g_id_a i
    i = add i 1
  end
  if ne rx_path_decode 2 n 0
    ret false
  end
  if ne rx_path_equal 0 2 1
    ret false
  end
  if ne rx_path_semantic_id 2 0
    ret false
  end
  if not t_same_out_with 0
    ret false
  end
  n2 = rx_path_encode 2 65600
  if ne n2 long n
    ret false
  end
  i = ulong 0
  while lt i n
    if ne get g_wire i get g_buf2 i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn test_randomized to void
  f_sha_init
  rts = ulong 0
  swaps = ulong 0
  c_a = or shl ulong 2654435769 32 ulong 2135587861
  c_b = or shl ulong 3518319154 32 ulong 3516067075
  t = ulong 0
  while lt t 1000
    put g_tc 2 xor c_a mul add t 1 c_b
    rx_path_arena_init
    gen_random_spec
    t_chk build_spec_path 0 false neg long 1 neg long 1 200
    t_chk build_spec_path 1 true neg long 1 neg long 1 201
    t_chk eq rx_path_semantic_id 0 0 202
    t_copy_out_to 0
    t_chk eq rx_path_semantic_id 0 0 203
    t_chk t_same_out_with 0 204
    t_chk eq rx_path_semantic_id 1 0 205
    t_chk t_same_out_with 0 206
    n = rx_path_encode 0 65600
    t_chk ge n 0 207
    if ge n 0
      if check_roundtrip ulong n
        rts = add rts 1
      end
    end
    ns = get g_sp_n 0
    if ge ns 2
      x = t_rnd ns
      y = t_rnd ns
      if and ne x y spec_steps_diff x y
        t_chk build_spec_path 3 false long x long y 208
        t_chk eq rx_path_semantic_id 3 0 209
        t_chk not t_same_out_with 0 210
        swaps = add swaps 1
      end
    end
    k = ulong 0
    while lt k 32
      f_sha_byte get g_id_a k
      k = add k 1
    end
    t = add t 1
  end
  t_chk eq rts 1000 211
  t_chk gt swaps 800 212
  f_sha_final
  t_out_s t_m_r1
  t_out_hex true
  t_out_s t_m_r2
  t_out_u64 rts
  t_out_s t_m_r3
  t_out_u64 swaps
  t_out_s t_m_r4
  t_out_flush 1
  t_chk t_hex_eq_id true t_rnd_fold 213
end

note ---- Order sensitivity & Realization separation ----
fn test_order_and_realization to void
  rx_path_arena_init
  t_chk eq t_init_mk 0 1 2 3 0 300
  t_simple_step 514 10
  t_chk eq rx_path_append 0 0 301
  t_simple_step 515 11
  t_chk eq rx_path_append 0 0 302
  t_chk eq t_init_mk 1 1 2 3 0 303
  t_simple_step 515 11
  t_chk eq rx_path_append 1 0 304
  t_simple_step 514 10
  t_chk eq rx_path_append 1 0 305
  t_chk eq rx_path_semantic_id 0 0 306
  t_copy_out_to 0
  t_chk eq rx_path_semantic_id 1 0 307
  t_chk not t_same_out_with 0 308

  rx_path_arena_init
  build_kat_path 0
  set_base_realization
  t_chk eq rx_path_semantic_id 0 0 310
  t_copy_out_to 0
  t_chk eq rx_path_realization_id 0 0 311
  t_copy_out_to 1
  fld = ulong 0
  while lt fld 5
    set_base_realization
    if eq fld 0
      t_mkid_real 0 144
    end
    if eq fld 1
      t_mkid_real 32 145
    end
    if eq fld 2
      t_mkid_real 64 146
    end
    if eq fld 3
      put g_real_sched 0 2
    end
    if eq fld 4
      t_mkid_real 96 147
    end
    t_chk eq rx_path_realization_id 0 0 312
    t_chk not t_same_out_with 1 313
    t_chk eq rx_path_semantic_id 0 0 314
    t_chk t_same_out_with 0 315
    fld = add fld 1
  end
  set_base_realization
  t_chk eq rx_path_realization_id 0 0 316
  t_chk t_same_out_with 1 317
  t_mkid_tmp 0 35
  t_chk eq rx_path_set_end_anchor 0 0 318
  t_chk eq rx_path_semantic_id 0 0 319
  t_chk not t_same_out_with 0 320
  t_chk eq rx_path_realization_id 0 0 321
  t_chk not t_same_out_with 1 322
end

note ---- Tamper & canonical ----
fn dec_rc_chk n ulong to long
  bef = get g_arena_used 0
  rc = rx_path_decode 2 n
  if ne rc 0
    t_chk and eq get g_arena_used 0 bef eq rx_path_step_count 2 0 400
  end
  ret rc
end

fn patched_rc_1 at_ ulong b0 uchar to long
  katn = get g_koff 0
  i = ulong 0
  while lt i katn
    put g_buf2 i get g_kat i
    i = add i 1
  end
  put g_buf2 at_ b0
  i = ulong 0
  while lt i katn
    put g_dec_in i get g_buf2 i
    i = add i 1
  end
  f_tagged_sha_kat t_rxp_sem_tag true katn
  i = ulong 0
  while lt i 32
    put g_id_chk i get g_fdig i
    i = add i 1
  end
  ret dec_rc_chk katn
end


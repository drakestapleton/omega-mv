  t_chk eq rx_path_equal 0 0 RX_PATH_ERR_INPUT_LIMIT 805
  put g_st_nin s0 0
  put g_st_plen s0 4294967280
  t_chk eq rx_path_encode 0 65600 RX_PATH_ERR_PARAM_LIMIT 806
  put g_st_plen s0 0
  put g_p_acnt 0 add RX_PATH_MAX_ATTR_COUNT 1
  t_chk eq rx_path_encode 0 65600 RX_PATH_ERR_ATTR_LIMIT 807
  put g_p_acnt 0 0
  put g_p_ccnt 0 add RX_PATH_MAX_CONSTRAINT_COUNT 1
  t_chk eq rx_path_encode 0 65600 RX_PATH_ERR_CONST_LIMIT 808
  put g_p_ccnt 0 0
  t_chk eq rx_path_semantic_id 0 0 809
  t_copy_out_to 0

  t_chk eq rx_path_fork 1 0 1 0 810
  t_chk eq rx_path_fork 0 1 1 RX_PATH_ERR_ARG 811
  t_chk and eq get g_p_frozen 0 1 and eq get g_p_parent 0 neg long 1 eq rx_path_step_count 0 1 812
  t_chk eq rx_path_semantic_id 0 0 813
  t_chk t_same_out_with 0 814
  t_chk eq rx_path_fork 2 1 1 0 815
  t_chk eq rx_path_fork 0 2 0 RX_PATH_ERR_ARG 816
  t_chk eq rx_path_semantic_id 0 0 817
  t_chk t_same_out_with 0 818

  t_chk ge rx_path_encode 1 65600 0 819
  i = ulong 0
  while lt i 32
    put g_p_start i uchar and add mul ulong 77 7 i 255
    i = add i 1
  end
  t_chk eq rx_path_encode 1 65600 RX_PATH_ERR_ID_MISMATCH 820
  t_chk eq rx_path_encode 2 65600 RX_PATH_ERR_ID_MISMATCH 821
  i = ulong 0
  while lt i 32
    put g_p_start i uchar and add 7 i 255
    i = add i 1
  end
  t_chk ge rx_path_encode 2 65600 0 822

  t_chk eq t_init_mk 3 1 2 3 0 823
  put g_tmp_pay 0 2
  t_chk eq rx_path_add_constraint 3 4 1 0 824
  put g_tmp_pay 0 1
  t_chk eq rx_path_add_constraint 3 4 1 0 825
  put g_tmp_pay 0 2
  t_chk eq rx_path_add_constraint 3 4 1 0 826
  c3 = ulong 48
  t_chk eq get g_p_ccnt 3 3 827
  t_chk eq get g_c_pay mul c3 128 1 827
  t_chk eq get g_c_pay mul add c3 1 128 2 827
  t_chk eq get g_c_pay mul add c3 2 128 2 827
  t_chk eq t_init_mk 4 1 2 3 0 828
  put g_tmp_pay 0 2
  t_chk eq rx_path_add_constraint 4 4 1 0 829
  t_chk eq rx_path_add_constraint 4 4 1 0 830
  put g_tmp_pay 0 1
  t_chk eq rx_path_add_constraint 4 4 1 0 831
  t_chk eq rx_path_semantic_id 3 0 832
  t_copy_out_to 0
  t_copy_out_to 5
  t_chk eq rx_path_semantic_id 4 0 833
  t_chk t_same_out_with 0 834
  n = rx_path_encode 3 65600
  t_chk ge n 0 835
  i = ulong 0
  while lt i ulong n
    put g_dec_in i get g_wire i
    i = add i 1
  end
  t_chk and eq dec_rc_chk ulong n 0 eq get g_p_ccnt 2 3 836
  t_chk eq rx_path_equal 2 3 1 837
  t_chk eq t_init_mk 5 1 2 3 0 838
  put g_tmp_pay 0 1
  t_chk eq rx_path_add_constraint 5 4 1 0 839
  put g_tmp_pay 0 2
  t_chk eq rx_path_add_constraint 5 4 1 0 840
  t_chk eq rx_path_semantic_id 5 0 841
  t_chk not t_same_out_with 0 842
end

fn main to int
  test_known_answer
  test_randomized
  test_order_and_realization
  test_tamper_and_canonical
  test_limits
  test_fork_prefix
  test_no_authority_and_regressions
  if ne get g_tc 1 0
    t_out_s t_m_fail1
    t_out_u64 get g_tc 1
    t_out_s t_m_fail2
    t_out_u64 get g_tc 0
    t_out_s t_m_fail3
    t_out_flush 1
    ret 1
  end
  t_out_s t_m_pass1
  t_out_u64 get g_tc 0
  t_out_s t_m_pass2
  t_out_flush 1
  ret 0
end

  end
  put g_buf2 at_ b0
  put g_buf2 add at_ 1 b1
  put g_buf2 add at_ 2 b2
  put g_buf2 add at_ 3 b3
  i = ulong 0
  while lt i katn
    put g_dec_in i get g_buf2 i
    i = add i 1
  end
  f_tagged_sha_kat t_rxp_sem_tag true katn

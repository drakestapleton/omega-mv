note
note tests/path/test_path_identity.om -- pure seeded OM-2 PATH-1 test harness.
note Replaces tests/path/test_path_identity.c. Composed after src/path/rx_path.om.

text t_hex "0123456789abcdef"
text t_kat_sem "90b28b4367cc0f6cc7bd5ec45930629a25d0303a64da13a57e9dfc4a728b7938"
text t_kat_real "32dfd9644010a192e879186c3c0b7824fdc59f7061368dac2c9b15a22b13e6ce"
text t_rnd_fold "30fa471ba8284437c2a38fbb12c021fff3d0418db2a616ebc7c390c18193134c"

text t_fail_pfx "FAIL check "
text t_nl "\n"
text t_m_ksem "KAT semantic    "
text t_m_kreal "KAT realization "
text t_m_r1 "random fold     "
text t_m_r2 " (1000 paths, "
text t_m_r3 " round trips, "
text t_m_r4 " swaps)\n"
text t_m_bf1 "bit flips       "
text t_m_bf2 " of "
text t_m_bf3 " refused\n"
text t_m_pass1 "PATH-1: PASS, "
text t_m_pass2 " checks\n"
text t_m_fail1 "PATH-1: "
text t_m_fail2 " of "
text t_m_fail3 " checks FAILED\n"
text t_zeta "zeta"
text t_alpha "alpha"

note Test harness state
note g_tc: [0]=checks [1]=failures [2]=rng
global g_tc ulong 4
global g_out uchar 4096
global g_outlen ulong 1

note Independent SHA-256 context for fold & tagged_sha
global g_fsh uint 8
global g_fsbuf uchar 64
global g_fsmeta ulong 2
global g_fdig uchar 32

note KAT buffer & offsets: [0]=katn [1]=off_ac [2]=off_a0 [3]=off_a1 [4]=off_cc [5]=off_sl [6]=off_s0 [7]=off_s1
global g_kat uchar 512
global g_koff ulong 8
global g_buf2 uchar 65600
global g_id_a uchar 32
global g_id_b uchar 32
global g_id_c uchar 32
global g_id_d uchar 32
global g_id_e uchar 32

note Random spec storage (24 steps, 6 attrs, 4 cons)
global g_sp_n ulong 3
global g_sp_ids uchar 96
global g_sp_fam ulong 24
global g_sp_role ulong 24
global g_sp_nin ulong 24
global g_sp_nout ulong 24
global g_sp_plen ulong 24
global g_sp_in uchar 6144
global g_sp_op uchar 768
global g_sp_out uchar 6144
global g_sp_par uchar 1536
global g_sp_ak uchar 48
global g_sp_av uchar 24
global g_sp_avl ulong 6
global g_sp_ck ulong 4
global g_sp_cp uchar 12
global g_sp_cpl ulong 4

fn t_out_c c uchar to void
  n = get g_outlen 0
  if lt n 4095
    put g_out n c
    put g_outlen 0 add n 1
  end
end

fn t_out_s s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    t_out_c get s i
    i = add i 1
  end
end

fn t_out_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    t_out_c 48
    ret
  end
  k = ulong 0
  while gt v 0
    put tmp k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0
    k = sub k 1
    t_out_c get tmp k
  end
end

fn t_out_flush fd int to void
  n = get g_outlen 0
  off = ulong 0
  while lt off n
    w = write fd g_out off sub n off
    if le w 0
      break
    end
    off = add off ulong w
  end
  put g_outlen 0 0
end

fn t_chk cond bool tag ulong to void
  put g_tc 0 add get g_tc 0 1
  if not cond
    put g_tc 1 add get g_tc 1 1
    t_out_flush 1
    t_out_s t_fail_pfx
    t_out_u64 tag
    t_out_c 10
    t_out_flush 2
  end
end

note ---- Independent SHA-256 (for fold & independent tagged_sha) ----
fn f_sha_compress to void
  i = ulong 0
  while lt i 16
    o = mul i 4
    b0 = uint get g_fsbuf o
    b1 = uint get g_fsbuf add o 1
    b2 = uint get g_fsbuf add o 2
    b3 = uint get g_fsbuf add o 3
    put g_rsw i or or shl b0 24 shl b1 16 or shl b2 8 b3
    i = add i 1
  end
  i = ulong 16
  while lt i 64
    w15 = get g_rsw sub i 15
    s0 = xor xor rxp_rotr32 w15 7 rxp_rotr32 w15 18 shr w15 3
    w2 = get g_rsw sub i 2
    s1 = xor xor rxp_rotr32 w2 17 rxp_rotr32 w2 19 shr w2 10
    v = add get g_rsw sub i 16 s0
    v = add v get g_rsw sub i 7
    put g_rsw i add v s1
    i = add i 1
  end
  i = ulong 0
  while lt i 8
    put g_rsv i get g_fsh i
    i = add i 1
  end
  i = ulong 0
  while lt i 64
    rxp_sha_round i
    i = add i 1
  end
  i = ulong 0
  while lt i 8
    put g_fsh i add get g_fsh i get g_rsv i
    i = add i 1
  end
end

fn f_sha_init to void
  rxp_sha_init_tbl
  i = ulong 0
  while lt i 8
    put g_fsh i get g_rsk add 64 i
    i = add i 1
  end
  put g_fsmeta 0 0
  put g_fsmeta 1 0
end

fn f_sha_byte b uchar to void
  bl = get g_fsmeta 0
  put g_fsbuf bl b
  bl = add bl 1
  put g_fsmeta 1 add get g_fsmeta 1 1
  if eq bl 64
    f_sha_compress
    bl = 0
  end
  put g_fsmeta 0 bl
end

fn f_sha_final to void
  bl = get g_fsmeta 0
  bits = mul get g_fsmeta 1 8
  put g_fsbuf bl 128
  bl = add bl 1
  if gt bl 56
    while lt bl 64
      put g_fsbuf bl 0
      bl = add bl 1
    end
    f_sha_compress
    bl = 0
  end
  while lt bl 56
    put g_fsbuf bl 0
    bl = add bl 1
  end
  i = ulong 0
  while lt i 8
    put g_fsbuf add 56 i uchar and shr bits mul sub 7 i 8 255
    i = add i 1
  end
  f_sha_compress
  i = ulong 0
  while lt i 8
    v = get g_fsh i
    o = mul i 4
    put g_fdig o uchar and shr v 24 255
    put g_fdig add o 1 uchar and shr v 16 255
    put g_fdig add o 2 uchar and shr v 8 255
    put g_fdig add o 3 uchar and v 255
    i = add i 1
  end
end

fn f_tagged_sha_kat tag view uchar * use_buf2 bool n ulong to void
  f_sha_init
  i = ulong 0
  tl = len tag
  while lt i tl
    f_sha_byte get tag i
    i = add i 1
  end
  f_sha_byte 0
  i = ulong 0
  while lt i n
    if use_buf2
      f_sha_byte get g_buf2 i
    else
      f_sha_byte get g_kat i
    end
    i = add i 1
  end
  f_sha_final
end

fn t_hex_eq_id use_fdig bool lit view uchar * to bool
  i = ulong 0
  while lt i 32
    b = uchar 0
    if use_fdig
      b = get g_fdig i
    else
      b = get g_id_out i
    end
    h0 = get t_hex shr ulong b 4
    h1 = get t_hex and ulong b 15
    if ne h0 get lit mul i 2
      ret false
    end
    if ne h1 get lit add mul i 2 1
      ret false
    end
    i = add i 1
  end
  ret true
end

fn t_out_hex use_fdig bool to void
  i = ulong 0
  while lt i 32
    b = uchar 0
    if use_fdig
      b = get g_fdig i
    else
      b = get g_id_out i
    end
    t_out_c get t_hex shr ulong b 4
    t_out_c get t_hex and ulong b 15
    i = add i 1
  end
end

fn t_same_id_ab to bool
  i = ulong 0
  while lt i 32
    if ne get g_id_a i get g_id_b i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn t_same_out_fdig to bool
  i = ulong 0
  while lt i 32
    if ne get g_id_out i get g_fdig i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn t_copy_out_to which ulong to void
  i = ulong 0
  while lt i 32
    b = get g_id_out i
    if eq which 0
      put g_id_a i b
    end
    if eq which 1
      put g_id_b i b
    end
    if eq which 2
      put g_id_c i b
    end
    if eq which 3
      put g_id_d i b
    end
    if eq which 4
      put g_id_e i b
    end
    if eq which 5
      put g_id_chk i b
    end
    i = add i 1
  end
end

fn t_same_out_with which ulong to bool
  i = ulong 0
  while lt i 32
    b = uchar 0
    if eq which 0
      b = get g_id_a i
    end
    if eq which 1
      b = get g_id_b i
    end
    if eq which 2
      b = get g_id_c i
    end
    if eq which 3
      b = get g_id_d i
    end
    if eq which 4
      b = get g_id_e i
    end
    if ne get g_id_out i b
      ret false
    end
    i = add i 1
  end
  ret true
end

fn t_mkid_tmp off ulong v ulong to void
  i = ulong 0
  while lt i 32
    put g_tmp_ids add off i uchar and add mul v 7 i 255
    i = add i 1
  end
end

fn t_mkid_in off ulong v ulong to void
  i = ulong 0
  while lt i 32
    put g_ts_in add off i uchar and add mul v 7 i 255
    i = add i 1
  end
end

fn t_mkid_op v ulong to void
  i = ulong 0
  while lt i 32
    put g_ts_op i uchar and add mul v 7 i 255
    i = add i 1
  end
end

fn t_mkid_out off ulong v ulong to void
  i = ulong 0
  while lt i 32
    put g_ts_out add off i uchar and add mul v 7 i 255
    i = add i 1
  end
end

fn t_mkid_real off ulong v ulong to void
  i = ulong 0
  while lt i 32
    put g_real_ids add off i uchar and add mul v 7 i 255
    i = add i 1
  end
end

fn t_simple_step role ulong seed ulong to void
  put g_ts_meta 0 shr role 8
  put g_ts_meta 1 role
  put g_ts_meta 2 0
  put g_ts_meta 3 0
  put g_ts_meta 4 0
  t_mkid_op seed
end

fn t_init_mk pid ulong v0 ulong v1 ulong v2 ulong to long
  t_mkid_tmp 0 v0
  t_mkid_tmp 32 v1
  t_mkid_tmp 64 v2
  ret rx_path_init pid
end

fn t_add_attr_lit pid ulong k view uchar * v0 uchar v1 uchar vl ulong to long
  kl = len k
  i = ulong 0
  while lt i kl
    put g_tmp_key i get k i
    i = add i 1
  end
  if ge vl 1
    put g_tmp_val 0 v0
  end
  if ge vl 2
    put g_tmp_val 1 v1
  end
  ret rx_path_add_attribute pid kl vl
end

note ---- KAT bytes & path ----
fn kat_push b uchar to void
  n = get g_koff 0
  put g_kat n b
  put g_koff 0 add n 1
end

fn kat_push_id v ulong to void
  i = ulong 0
  while lt i 32
    kat_push uchar and add mul v 7 i 255
    i = add i 1
  end
end

fn build_kat_bytes to void
  put g_koff 0 0
  kat_push 79
  kat_push 77
  kat_push 71
  kat_push 48
  kat_push 1
  kat_push 12
  kat_push 0
  kat_push 2
  kat_push_id 17
  kat_push_id 34
  kat_push_id 51
  put g_koff 1 get g_koff 0
  kat_push 0
  kat_push 2
  put g_koff 2 get g_koff 0
  kat_push 5
  kat_push 97
  kat_push 108
  kat_push 112
  kat_push 104
  kat_push 97
  kat_push 0
  kat_push 2
  kat_push 2
  kat_push 3
  put g_koff 3 get g_koff 0
  kat_push 4
  kat_push 122
  kat_push 101
  kat_push 116
  kat_push 97
  kat_push 0
  kat_push 1
  kat_push 1
  put g_koff 4 get g_koff 0
  kat_push 0
  kat_push 2
  kat_push 0
  kat_push 1
  kat_push 0
  kat_push 0
  kat_push 0
  kat_push 3
  kat_push 0
  kat_push 1
  kat_push 170
  put g_koff 5 get g_koff 0
  kat_push 0
  kat_push 0
  kat_push 0
  kat_push 158
  put g_koff 6 get g_koff 0
  kat_push 0
  kat_push 0
  kat_push 0
  kat_push 1
  kat_push 1
  kat_push 1
  kat_push 0
  kat_push 1
  kat_push_id 64
  kat_push_id 80
  kat_push 0
  kat_push 1
  kat_push_id 96
  kat_push 0
  kat_push 0
  kat_push 0
  kat_push 2
  kat_push 1
  kat_push 2
  put g_koff 7 get g_koff 0
  kat_push 0
  kat_push 1
  kat_push 0
  kat_push 2
  kat_push 2
  kat_push 4
  kat_push 0
  kat_push 0
  kat_push_id 81
  kat_push 0
  kat_push 0
  kat_push 0
  kat_push 0
  kat_push 0

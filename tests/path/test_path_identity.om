fn test_tamper_noncanon_a to void
  katn = get g_koff 0
  oa0 = get g_koff 2
  oa1 = get g_koff 3
  note swapped attrs
  i = ulong 0
  while lt i katn
    put g_buf2 i get g_kat i
    i = add i 1
  end
  i = ulong 0
  while lt i 8
    put g_buf2 add oa0 i get g_kat add oa1 i
    i = add i 1
  end
  i = ulong 0
  while lt i 10
    put g_buf2 add add oa0 8 i get g_kat add oa0 i
    i = add i 1
  end
  i = ulong 0
  while lt i katn
    put g_dec_in i get g_buf2 i
    i = add i 1
  end
  f_tagged_sha_kat t_rxp_sem_tag true katn
  i = ulong 0
  while lt i 32
    put g_id_chk i get g_fdig i
    i = add i 1
  end
  t_chk eq dec_rc_chk katn RX_PATH_ERR_MALFORMED 410
  note dup attrs
  i = ulong 0
  while lt i 8
    put g_buf2 add oa0 i get g_kat add oa1 i
    put g_buf2 add add oa0 8 i get g_kat add oa1 i
    i = add i 1
  end
  put g_buf2 add oa0 16 120
  put g_buf2 add oa0 17 120
  i = ulong 0
  while lt i katn
    put g_dec_in i get g_buf2 i
    i = add i 1
  end
  f_tagged_sha_kat t_rxp_sem_tag true katn
  i = ulong 0
  while lt i 32
    put g_id_chk i get g_fdig i
    i = add i 1
  end
  t_chk eq dec_rc_chk katn RX_PATH_ERR_MALFORMED 411
end

fn test_tamper_noncanon to void
  test_tamper_noncanon_a
  katn = get g_koff 0
  occ = get g_koff 4
  osl = get g_koff 5
  os1 = get g_koff 7
  note swapped constraints

  t_chk eq dec_rc_chk katn RX_PATH_ERR_MALFORMED 412
  t_chk eq patched_rc_2 os1 0 5 RX_PATH_ERR_MALFORMED 413
  t_chk eq patched_rc_2 add os1 4 2 5 RX_PATH_ERR_MALFORMED 414
  t_chk eq patched_rc_2 add os1 4 3 1 RX_PATH_ERR_MALFORMED 415
  t_chk eq patched_rc_4 osl 0 0 0 157 RX_PATH_ERR_MALFORMED 416
  note trailing byte with raised steps_len
  i = ulong 0
  while lt i katn
    put g_buf2 i get g_kat i
    i = add i 1
  end
  put g_buf2 add osl 3 159
  put g_buf2 katn 0
  i = ulong 0
  while lt i add katn 1
    put g_dec_in i get g_buf2 i
    i = add i 1
  end
  f_tagged_sha_kat t_rxp_sem_tag true add katn 1
  i = ulong 0
  while lt i 32
    put g_id_chk i get g_fdig i
    i = add i 1
  end
  t_chk eq dec_rc_chk add katn 1 RX_PATH_ERR_MALFORMED 417
  t_chk eq patched_rc_1 3 49 RX_PATH_ERR_MALFORMED 418
  t_chk eq patched_rc_1 4 2 RX_PATH_ERR_MALFORMED 419
  t_chk eq patched_rc_1 5 11 RX_PATH_ERR_MALFORMED 420
  t_chk eq patched_rc_2 6 2 1 RX_PATH_ERR_STEP_LIMIT 421
  t_chk eq patched_rc_2 get g_koff 1 0 33 RX_PATH_ERR_ATTR_LIMIT 422
  t_chk eq patched_rc_2 occ 0 17 RX_PATH_ERR_CONST_LIMIT 423
  t_chk eq patched_rc_2 add os1 6 0 9 RX_PATH_ERR_INPUT_LIMIT 424
  t_chk eq patched_rc_2 add os1 40 0 9 RX_PATH_ERR_OUTPUT_LIMIT 425
  t_chk eq patched_rc_4 add os1 42 0 0 4 1 RX_PATH_ERR_PARAM_LIMIT 426
  t_chk eq dec_rc_chk add RX_PATH_MAX_TOTAL_SERIALIZATION 1 RX_PATH_ERR_BUFFER_OVERFLOW 427
end

fn test_tamper_and_canonical to void
  rx_path_arena_init

note SPDX-License-Identifier: AGPL-3.0-only
note AArch64 Linux replay with the compiler pinned in om/units.sh:
note (sed 's/^export fn /fn /' om/arboris_arena.om; cat tests/arboris_arena_test.om) | seed/out/omc > arena-test
note chmod +x arena-test && ./arena-test (exit 0 passes).
fn seed_header m edit ulong 16 to void
  put m 0 0x4152425200000001
  put m 1 3
  put m 2 5
  put m 3 7
  put m 4 8
  put m 5 3
  put m 10 8193
end

fn plan_test to int
  m = new ulong 16 0
  offsets = new ulong 6 77
  seed_header m
  if ne arboris_plan_arena m 53248 4096 offsets 0
    ret 1
  end
  if or ne get m 12 53248 ne get m 13 384
    ret 2
  end
  if or ne get m 9 128 ne get m 11 128
    ret 3
  end
  if or ne get offsets 0 0 ne get offsets 1 8192
    ret 4
  end
  if or ne get offsets 2 16384 ne get offsets 3 32768
    ret 5
  end
  if or ne get offsets 4 40960 ne get offsets 5 49152
    ret 6
  end
  for i ulong 6
    put offsets i 77
  end
  put m 9 71
  put m 11 72
  put m 12 73
  put m 13 74
  if eq arboris_plan_arena m 53247 4096 offsets 0
    ret 7
  end
  if or ne get m 9 71 ne get m 11 72
    ret 8
  end
  if or ne get m 12 73 ne get m 13 74
    ret 9
  end
  for i ulong 6
    if ne get offsets i 77
      ret 10
    end
  end
  put m 10 0xffffffffffffffff
  if eq arboris_plan_arena m 0xffffffffffffffff 4096 offsets 0
    ret 11
  end
  put m 10 64
  put m 4 0x8000000000000000
  if eq arboris_plan_arena m 0xffffffffffffffff 4096 offsets 0
    ret 12
  end
  put m 4 8
  put m 2 0x100000000
  if eq arboris_plan_arena m 0xffffffffffffffff 4096 offsets 0
    ret 13
  end
  put m 2 5
  if eq arboris_plan_arena m 53248 6144 offsets 0
    ret 14
  end
  put m 6 2
  if eq arboris_plan_arena m 53248 4096 offsets 0
    ret 15
  end
  put m 6 0
  put m 2 769
  put m 5 769
  if ne arboris_plan_arena m 1048576 4096 offsets 0
    ret 15
  end
  if ne get m 13 98304
    ret 16
  end
  put m 2 3073
  put m 5 3073
  if eq arboris_plan_arena m 1048576 4096 offsets 0
    ret 17
  end
  put m 4 512
  put m 2 96
  put m 5 96
  if ne arboris_plan_arena m 1048576 4096 offsets 0
    ret 18
  end
  put m 2 97
  put m 5 97
  if eq arboris_plan_arena m 1048576 4096 offsets 0
    ret 19
  end
  ret 0
end

fn csr_test to int
  m = new ulong 16 0
  seed_header m
  data = new uint 22 0
  short_data = new uint 21 0
  put data 1 2
  put data 2 2
  put data 3 5
  put data 6 1
  put data 7 2
  put data 8 6
  put data 9 7
  put data 16 2
  if ne arboris_check_csr m data 0
    ret 21
  end
  if ne arboris_check_csr m short_data 2
    ret 22
  end
  put data 16 3
  if ne arboris_check_csr m data 5
    ret 23
  end
  put data 16 0
  put data 9 6
  if ne arboris_check_csr m data 4
    ret 24
  end
  put data 9 7
  put data 2 1
  if ne arboris_check_csr m data 3
    ret 25
  end
  put data 2 2
  put m 5 2
  if ne arboris_check_csr m data 3
    ret 26
  end
  put m 3 0
  put m 5 3
  empty_syn = new uint 15 0
  put empty_syn 1 2
  put empty_syn 2 2
  put empty_syn 3 5
  if ne arboris_check_csr m empty_syn 0
    ret 27
  end
  ret 0
end

fn main to int
  rc = plan_test
  if ne rc 0
    ret rc
  end
  ret csr_test
end

note Exercise serialized ownership in both orders, including wrong-owner teardown.
fn leases h edit zonehdr to bool
  if or slab_acquire_lease h 0 slab_acquire_lease h 3
    ret false
  end
  if not slab_acquire_lease h 1
    ret false
  end
  if or slab_acquire_lease h 2 slab_release_lease h 2
    ret false
  end
  if not slab_release_lease h 1
    ret false
  end
  if not slab_acquire_lease h 2
    ret false
  end
  if or slab_acquire_lease h 1 slab_release_lease h 1
    ret false
  end
  ret slab_release_lease h 2
end

fn offer h edit zonehdr slots edit uchar 256 id ushort to uchar
  hint = new uchar 32 0
  put_word hint 0 8 get h epoch
  put_word hint 10 2 ulong id
  put hint 12 2
  put hint 13 3
  result = slab_admit_hint h slots hint
  if ne result get hint 16
    ret 255
  end
  ret result
end

note Distinct nonzero patterns expose partial, high-byte and cross-slot overwrites.
fn hash_ok slots view uchar 256 index ulong to bool
  for j ulong 8
    if ne get slots add add mul index 64 32 j uchar add 128 add mul index 8 j
      ret false
    end
  end
  ret true
end

fn fixture slots out uchar 256 to void
  for i ulong 256
    put slots i 0
  end
  for k ulong 4
    pos = mul k 64
    put slots add pos 2 uchar k
    put slots add pos 4 1
    if ge k 2
      put slots add pos 4 2
    end
    put slots add pos 5 2
    for j ulong 8
      put slots add add pos 32 j uchar add 128 add mul k 8 j
    end
  end
end

fn all_hashes slots view uchar 256 to bool
  for k ulong 4
    if not hash_ok slots k
      ret false
    end
  end
  ret true
end

fn main to int
  h = new uchar 128 255
  slots = new uchar 256 0
  slab_init h 7 2 2
  fixture slots
  if not leases h
    ret 1
  end
  if or z2_check_promotion h 1 9 ne get_word h 0 8 0
    ret 30
  end
  if ne offer h slots 3 3
    ret 2
  end
  if not all_hashes slots
    ret 3
  end
  if not slab_acquire_lease h 1
    ret 4
  end
  if ne offer h slots 2 1
    ret 5
  end
  if not all_hashes slots
    ret 6
  end
  if ne offer h slots 384 3
    ret 7
  end
  if not all_hashes slots
    ret 8
  end
  put slots 133 3
  if ne offer h slots 383 0
    ret 9
  end
  if not all_hashes slots
    ret 10
  end
  put slots 133 2
  if z2_check_promotion h 1 9
    ret 11
  end
  if ne offer h slots 383 2
    ret 12
  end
  if or ne get_word slots 130 2 383 ne get slots 133 1
    ret 13
  end
  if ne offer h slots 383 1
    ret 14
  end
  if or ne get_word h 8 4 7 ne get_word h 40 8 0
    ret 15
  end
  if z2_check_promotion h 2 7
    ret 16
  end
  if ne get_word h 16 4 0
    ret 17
  end
  if z2_check_promotion h 3 9
    ret 18
  end
  if ne offer h slots 382 2
    ret 19
  end
  if z2_check_promotion h 4 9
    ret 20
  end
  if or ne get_word h 28 4 0 ne offer h slots 381 0
    ret 21
  end
  if or ne get_word h 8 4 7 ne get_word h 40 8 0
    ret 22
  end
  if or not hash_ok slots 0 not hash_ok slots 1
    ret 23
  end
  if z2_check_promotion h 4 9
    ret 24
  end
  if not z2_check_promotion h 5 9
    ret 25
  end
  if or ne get_word h 8 4 9 ne get_word h 16 4 0
    ret 26
  end
  if or ne get_word h 48 4 2 ne get_word h 52 4 2
    ret 27
  end
  for i ulong 72
    if ne get h add 56 i 0
      ret 28
    end
  end
  rep = new uchar 32 0
  put_word rep 0 8 get_word h 0 8
  put_word rep 10 2 ulong 383
  put rep 12 2
  put rep 13 3
  if ne slab_admit_hint h slots rep 1
    ret 31
  end
  if not slab_release_lease h 1
    ret 32
  end
  if or ne slab_admit_hint h slots rep 1 ne get_word h 48 4 2
    ret 33
  end
  ret 0
end

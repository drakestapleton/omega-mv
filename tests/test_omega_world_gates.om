om2
note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit test for src/omega_world_gates.om.

text t_wg_pass "PASS test_omega_world_gates_om\n"
text t_wg_fail "FAIL test_omega_world_gates_om\n"

fn main to int
  cnt = new ulong 1 0
  pas = new ulong 1 0
  if ne run_m19_gates 0
    ign = write 1 t_wg_fail 0 len t_wg_fail
    ret 1
  end
  omega_get_m19_gate_snapshot cnt pas
  if or ne get cnt 0 18 ne get pas 0 18
    ign = write 1 t_wg_fail 0 len t_wg_fail
    ret 2
  end
  if ne run_m19_drain_decoupling 0
    ign = write 1 t_wg_fail 0 len t_wg_fail
    ret 3
  end
  if ne run_world_lifecycle_gates 0
    ign = write 1 t_wg_fail 0 len t_wg_fail
    ret 4
  end
  if ne run_m19r_soak 0
    ign = write 1 t_wg_fail 0 len t_wg_fail
    ret 5
  end
  run_demonstration_accelerator_world
  ign = write 1 t_wg_pass 0 len t_wg_pass
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit and C-parity test for:
note   src/omega_blackwell_codegen_attn256.om
note   src/omega_blackwell_codegen_pattn.om
note   src/omega_blackwell_codegen_pattn256.om
note   src/omega_blackwell_codegen_pfhost.om
note   src/omega_blackwell_codegen_qg.om
om2

global g_cg4_out uchar 4096
global g_cg4_out_n ulong 1

text t_cg4_pass "PASS test-bw-cpu-cg4-om\n"

fn cg4_flush to void
  n = get g_cg4_out_n 0
  if gt n 0
    ign = write 1 g_cg4_out 0 n
    put g_cg4_out_n 0 0
  end
end

fn cg4_ch c uchar to void
  n = get g_cg4_out_n 0
  if ge n 4000
    cg4_flush
    n = 0
  end
  put g_cg4_out n c
  put g_cg4_out_n 0 add n 1
end

fn cg4_hexd nib uint to uchar
  if lt nib 10
    ret uchar add 48 nib
  end
  ret uchar add 87 nib
end

fn cg4_hex32 v uint to void
  for i ulong 8
    sh = uint mul sub 7 i 4
    nib = and shr v sh 15
    cg4_ch cg4_hexd nib
  end
end

fn cg4_hex64 v ulong to void
  cg4_hex32 uint shr v 32
  cg4_hex32 uint and v 0xffffffff
end

fn cg4_nl to void
  cg4_ch 10
  cg4_flush
end

fn cg4_fnv64_u64s arr view ulong * n ulong to ulong
  h = ulong 0xcbf29ce484222325
  for i ulong n bound 8192
    v = get arr i
    for b ulong 8
      by = and shr v mul b 8 255
      h = mul xor h by ulong 0x100000001b3
    end
  end
  ret h
end

fn cg4_emit_line tag uint a uint b uint c uint d uint h ulong to void
  cg4_ch uchar shr tag 8
  cg4_ch uchar and tag 255
  cg4_ch 58
  cg4_hex32 a
  cg4_ch 58
  cg4_hex32 b
  cg4_ch 58
  cg4_hex32 c
  cg4_ch 58
  cg4_hex32 d
  cg4_ch 58
  cg4_hex64 h
  cg4_nl
end

fn test_attn256 to long
  sp = new ulong 8 0
  sh = new uint 7 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  stats = new uint 2 0

  note Default 27B shape (0,0,0 -> 24,4,6)
  if ne omega_dattn256_shape sp sh 0
    ret 10
  end
  if ne get sh 0 24
    ret 11
  end
  if ne get sh 1 4
    ret 11
  end
  if ne get sh 2 6
    ret 11
  end
  if ne get sh 3 4
    ret 12
  end
  if ne get sh 4 1
    ret 12
  end
  if ne get sh 5 8192
    ret 12
  end
  if ne get sh 6 6144
    ret 12
  end

  note Invalid depth=0 refused
  if ne omega_blackwell_codegen_decode_attn256_prog sp ins meta -1
    ret 13
  end

  note Valid 27B decode spec: depth=2, mutant=0, prep=0
  put sp 0 2
  if ne omega_blackwell_codegen_decode_attn256_prog sp ins meta 0
    ret 14
  end
  if ne omega_decode_attn256_prog_stats sp stats 0
    ret 15
  end
  if ne get stats 0 uint get meta 0
    ret 16
  end
  cg4_emit_line 0x4130 get sh 5 get sh 6 get stats 0 get stats 1 cg4_fnv64_u64s ins mul get meta 0 8

  note Valid Q36 prep spec: depth=1, prep=1, q_heads=16, kv_heads=2, q_per_cta=4
  put sp 0 1
  put sp 2 1
  put sp 3 16
  put sp 4 2
  put sp 5 4
  if ne omega_dattn256_shape sp sh 0
    ret 17
  end
  if or ne get sh 3 4 ne get sh 4 2
    ret 18
  end
  if ne omega_blackwell_codegen_decode_attn256_prog sp ins meta 0
    ret 19
  end
  if ne omega_decode_attn256_prog_stats sp stats 0
    ret 20
  end
  cg4_emit_line 0x4131 get sh 3 get sh 4 get stats 0 get stats 1 cg4_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_pattn to long
  sp = new ulong 4 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  stats = new uint 2 0

  note Invalid warps=0
  if ne omega_pattn_spec_ok sp 0
    ret 30
  end
  if ne omega_blackwell_codegen_prefill_attn_prog sp ins meta -1
    ret 31
  end

  note Valid fused warps=4, mutant=0, mode=0, mirror=0
  put sp 0 4
  if ne omega_pattn_spec_ok sp 1
    ret 32
  end
  if ne omega_blackwell_codegen_prefill_attn_prog sp ins meta 0
    ret 33
  end
  if ne omega_prefill_attn_prog_stats sp stats 0
    ret 34
  end
  cg4_emit_line 0x5030 4 0 get stats 0 get stats 1 cg4_fnv64_u64s ins mul get meta 0 8

  note Valid attend mode=2, warps=8
  put sp 0 8
  put sp 2 2
  if ne omega_pattn_spec_ok sp 1
    ret 35
  end
  if ne omega_blackwell_codegen_prefill_attn_prog sp ins meta 0
    ret 36
  end
  if ne omega_prefill_attn_prog_stats sp stats 0
    ret 37
  end
  cg4_emit_line 0x5031 8 2 get stats 0 get stats 1 cg4_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_pattn256 to long
  sp = new ulong 4 0
  sh = new uint 5 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  stats = new uint 2 0

  note Default 27B shape (0,0 -> 24,4,6,6144,24576)
  if ne omega_pattn256_shape sp sh 0
    ret 40
  end
  if ne get sh 0 24
    ret 41
  end
  if ne get sh 1 4
    ret 41
  end
  if ne get sh 2 6
    ret 41
  end
  if ne get sh 3 6144
    ret 42
  end
  if ne get sh 4 24576
    ret 42
  end
  if ne omega_pattn256_spec_ok sp 1
    ret 43
  end
  if ne omega_blackwell_codegen_prefill_attn256_prog sp ins meta 0
    ret 44
  end
  if ne omega_prefill_attn256_prog_stats sp stats 0
    ret 45
  end
  cg4_emit_line 0x5130 get sh 3 get sh 4 get stats 0 get stats 1 cg4_fnv64_u64s ins mul get meta 0 8

  note Q36 shape (16, 2)
  put sp 1 16
  put sp 2 2
  if ne omega_pattn256_shape sp sh 0
    ret 46
  end
  if or ne get sh 2 8 ne get sh 4 16384
    ret 47
  end
  if ne omega_blackwell_codegen_prefill_attn256_prog sp ins meta 0
    ret 48
  end
  if ne omega_prefill_attn256_prog_stats sp stats 0
    ret 49
  end
  cg4_emit_line 0x5131 get sh 2 get sh 4 get stats 0 get stats 1 cg4_fnv64_u64s ins mul get meta 0 8

  note Invalid mutant=9
  put sp 0 9
  if ne omega_pattn256_spec_ok sp 0
    ret 50
  end
  ret 0
end

fn test_pfhost to long
  sp = new ulong 8 0
  ins = new ulong 8192 0
  meta = new ulong 512 0

  note Invalid rl spec
  if ne omega_rl_spec_ok sp 0
    ret 60
  end
  if ne omega_rl_shared_bytes sp 0
    ret 61
  end
  if ne omega_blackwell_codegen_rl_prog sp ins meta -1
    ret 62
  end

  note Valid rl spec: k=2048, e=128, t=8, mutant=0
  put sp 0 2048
  put sp 1 128
  put sp 2 8
  put sp 3 0
  if ne omega_rl_spec_ok sp 1
    ret 63
  end
  sb = omega_rl_shared_bytes sp
  if ne sb 4096
    ret 64
  end
  if ne omega_blackwell_codegen_rl_prog sp ins meta 0
    ret 65
  end
  cg4_emit_line 0x5230 sb uint get meta 0 uint get meta 1 uint get meta 2 cg4_fnv64_u64s ins mul get meta 0 8

  note Invalid mc spec
  put sp 0 0
  put sp 1 0
  put sp 2 0
  if ne omega_mc_spec_ok sp 0
    ret 66
  end
  if ne omega_blackwell_codegen_mc_prog sp ins meta -1
    ret 67
  end

  note Valid mc spec: h=2048, top_k=8, mutant=0
  put sp 0 2048
  put sp 1 8
  put sp 2 0
  if ne omega_mc_spec_ok sp 1
    ret 68
  end
  if ne omega_blackwell_codegen_mc_prog sp ins meta 0
    ret 69
  end
  cg4_emit_line 0x5231 2048 8 uint get meta 0 uint get meta 1 cg4_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_qg to long
  pq = new ulong 8 0
  qg = new ulong 10 0
  ins = new ulong 8192 0
  meta = new ulong 512 0

  note Invalid pq spec
  if ne omega_pq_spec_ok pq 0
    ret 70
  end
  if ne omega_blackwell_codegen_pq_prog pq ins meta -1
    ret 71
  end

  note Valid pq spec: k=2048, in_type=0 (f32), mutant=0, groups=0
  put pq 0 2048
  put pq 1 0
  put pq 2 0
  put pq 3 0
  if ne omega_pq_spec_ok pq 1
    ret 72
  end
  if ne omega_blackwell_codegen_pq_prog pq ins meta 0
    ret 73
  end
  cg4_emit_line 0x5330 2048 0 uint get meta 0 uint get meta 1 cg4_fnv64_u64s ins mul get meta 0 8

  note Invalid qg spec
  if ne omega_qg_spec_ok qg 0
    ret 74
  end
  if ne omega_qg_shared_bytes qg 0
    ret 75
  end
  if ne omega_qg_span qg 0
    ret 76
  end
  if ne omega_blackwell_codegen_qgemm_prog qg ins meta -1
    ret 77
  end

  note Valid qg spec: k=2048, rt=4, warps=8, epi=0, direct=1, n=1024, wait=4, mutant=0
  put qg 0 2048
  put qg 1 4
  put qg 2 8
  put qg 3 0
  put qg 4 1
  put qg 5 1024
  put qg 6 4
  put qg 7 0
  if ne omega_qg_spec_ok qg 1
    ret 78
  end
  sb = omega_qg_shared_bytes qg
  spn = omega_qg_span qg
  if or ne sb 8704 ne spn 128
    ret 79
  end
  if ne omega_blackwell_codegen_qgemm_prog qg ins meta 0
    ret 80
  end
  cg4_emit_line 0x5331 sb spn uint get meta 0 uint get meta 1 cg4_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn main to int
  rc = test_attn256
  if ne rc 0
    ret int rc
  end
  rc = test_pattn
  if ne rc 0
    ret int rc
  end
  rc = test_pattn256
  if ne rc 0
    ret int rc
  end
  rc = test_pfhost
  if ne rc 0
    ret int rc
  end
  rc = test_qg
  if ne rc 0
    ret int rc
  end
  ign = write 1 t_cg4_pass 0 len t_cg4_pass
  ret 0
end

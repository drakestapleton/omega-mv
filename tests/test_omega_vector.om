note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit test for src/omega_vector.om.
om2

text vec_name "vecadd_u32_16"
text vec16_gold "531c6b4b11f31d0ae21f1cb0267b252f69a3565637116fec3c621ffb5133000a"
text msg_pass "OMEGA_VECTOR_OM_PASS\n"
text msg_fail "OMEGA_VECTOR_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex32 dig view uchar * gold view uchar * to void
  for i ulong 32
    b = uint get dig i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn test_vec to void
  a = new uint 16 0
  b = new uint 16 0
  c = new uint 16 0
  mm = new ulong 1 0
  dig1 = new uchar 32 0
  dig2 = new uchar 32 0

  note Bad args refused
  chk eq omega_vector_spec_init vec_name 0 16 -1
  chk eq omega_vector_spec_init vec_name len vec_name 0 -1

  note Valid spec init + deterministic digest
  chk eq omega_vector_spec_init vec_name len vec_name 16 0
  chk eq get g_vec_elem_width 0 32
  chk eq get g_vec_elem_count 0 16
  chk eq get g_vec_overflow 0 1
  chk eq omega_vector_get_digest dig1 0
  chk_hex32 dig1 vec16_gold

  note Different N produces different digest
  chk eq omega_vector_spec_init vec_name len vec_name 32 0
  chk eq omega_vector_get_digest dig2 0
  diff = ulong 0
  for i ulong 32
    if ne get dig1 i get dig2 i
      diff = 1
    end
  end
  chk eq diff 1

  note Deterministic generator + poison check
  omega_vector_generate_deterministic a b c
  chk eq get a 0 uint 0xfffffffe
  chk eq get b 0 uint 3
  chk eq get a 1 uint 0x80000000
  chk eq get b 1 uint 0x80000000
  chk eq get a 2 uint 1002
  chk eq get b 2 uint 2004
  chk eq get c 0 OMEGA_VECTOR_POISON_VALUE
  chk eq get c 15 OMEGA_VECTOR_POISON_VALUE

  note Poisoned c fails verify at index 0
  chk eq omega_vector_verify_oracle a b c -1
  chk eq get g_vec_mismatch 0 0

  note Oracle u32 wrap arithmetic
  omega_vector_oracle_u32 a b c
  chk eq get c 0 uint 1
  chk eq get c 1 uint 0
  chk eq get c 2 uint 3006
  chk eq get c 15 uint 3045
  chk eq omega_vector_verify_oracle a b c 0

  note Corrupt one element -> verify catches exact index
  put c 7 add get c 7 uint 1
  chk eq omega_vector_verify_oracle a b c -1
  chk eq get g_vec_mismatch 0 7
end

fn main to int
  test_vec
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

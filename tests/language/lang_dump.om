note SPDX-License-Identifier: Apache-2.0
note lang_dump.om -- the pure OM-2 side of tests/language/lang_parity.sh. Prints, for every
note stdin line run through olw_eval_sbuf (omega_language_eval_line) on one session, exactly
note the lines tests/language/lang_dump.c prints from the C lane: return code and error, the
note result, every graph object the line added, the table counts and the stored program.
note A line `#!clear` clears the session. After a successful line `_` is set as the console's
note `source` command sets it. Built after visor.om, the units, visor_program.om and the
note language lane.

global dmp_in uchar 1048576
global dmp_ob uchar 65536
global dmp_on ulong 1
global dmp_d uchar 24

fn dmp_flush to void
  n = get dmp_on 0
  if gt n 0
    k = write 1 dmp_ob 0 n
  end
  put dmp_on 0 0
end

fn dmp_c c ulong to void
  n = get dmp_on 0
  if ge n 65000
    dmp_flush
    n = 0
  end
  put dmp_ob n uchar c
  put dmp_on 0 add n 1
end

fn dmp_t s view uchar * to void
  n = len s
  for i ulong n bound 4096
    dmp_c ulong get s i
  end
end

fn dmp_u v ulong to void
  k = ulong 0
  x = v
  while gt x 9 bound 24
    put dmp_d k uchar add 48 rem x 10
    x = div x 10
    k = add k 1
  end
  put dmp_d k uchar add 48 x
  k = add k 1
  while gt k 0 bound 24
    k = sub k 1
    dmp_c ulong get dmp_d k
  end
end

fn dmp_i v long to void
  if lt v 0
    dmp_c 45
    dmp_u ulong sub 0 v
  else
    dmp_u ulong v
  end
end

fn dmp_hexd d ulong to void
  if lt d 10
    dmp_c add 48 d
  else
    dmp_c add 87 d
  end
end

fn dmp_hb b ulong to void
  dmp_hexd shr b 4
  dmp_hexd and b 15
end

text dmp_t_l "L "
text dmp_t_clear " clear\n"
text dmp_t_rc " rc="
text dmp_t_err " err="
text dmp_t_r "R kind="
text dmp_t_id " id="
text dmp_t_name " name="
text dmp_t_pidx " pidx="
text dmp_t_type " type="
text dmp_t_tid " tid="
text dmp_t_fnty "u64 -> u64"
text dmp_t_o "O "
text dmp_t_kind " kind="
text dmp_t_c "C objs="
text dmp_t_binds " binds="
text dmp_t_progs " progs="
text dmp_t_p "P name="
text dmp_t_pre " pre="
text dmp_t_post " post="
text dmp_t_preid " preid="
text dmp_t_postid " postid="
text dmp_t_steps " steps="
text dmp_t_real " realized="
text dmp_t_ver " verified="
text dmp_t_code " code="
text dmp_t_rid " rid="
text dmp_t_add "add"
text dmp_t_sub "sub"
text dmp_t_mul "mul"
text dmp_t_and "and"
text dmp_t_or "or"
text dmp_t_bool "bool"

fn dmp_type tag ulong wid ulong to void
  if eq tag V_TY_BOOL
    dmp_t dmp_t_bool
    ret
  end
  dmp_c 117
  dmp_u wid
end

fn dmp_op op ulong to void
  if eq op V_OP_ADD
    dmp_t dmp_t_add
  end
  if eq op V_OP_SUB
    dmp_t dmp_t_sub
  end
  if eq op V_OP_MUL
    dmp_t dmp_t_mul
  end
  if eq op V_OP_AND
    dmp_t dmp_t_and
  end
  if eq op V_OP_OR
    dmp_t dmp_t_or
  end
end

fn dmp_prog pc ulong to void
  dmp_t dmp_t_p
  nb = mul pc 64
  for i ulong get v_prog_nlen pc bound 64
    dmp_c ulong get v_prog_name add nb i
  end
  ib = mul pc 32
  dmp_t dmp_t_id
  for i ulong 32
    dmp_hb ulong get v_prog_id add ib i
  end
  dmp_t dmp_t_pre
  for i ulong get v_prog_rlen pc bound 64
    dmp_c ulong get v_prog_req add nb i
  end
  dmp_t dmp_t_post
  for i ulong get v_prog_elen pc bound 64
    dmp_c ulong get v_prog_ens add nb i
  end
  dmp_t dmp_t_preid
  for i ulong 32
    dmp_hb ulong get v_prog_preid add ib i
  end
  dmp_t dmp_t_postid
  for i ulong 32
    dmp_hb ulong get v_prog_postid add ib i
  end
  dmp_t dmp_t_steps
  sb = mul pc 64
  for i ulong get v_prog_scnt pc bound 64
    if gt i 0
      dmp_c 44
    end
    dmp_op get v_prog_sop add sb i
    dmp_c 58
    dmp_u get v_prog_simm add sb i
  end
  dmp_t dmp_t_real
  dmp_u get v_prog_realized pc
  dmp_t dmp_t_ver
  dmp_u get v_prog_verified pc
  dmp_t dmp_t_code
  cb = mul pc 4096
  for i ulong get v_prog_clen pc bound 4096
    dmp_hb ulong get v_prog_code add cb i
  end
  dmp_t dmp_t_rid
  for i ulong 32
    dmp_hb ulong get v_prog_real_id add ib i
  end
  dmp_c 10
end

fn dmp_result to void
  k = get olw_rkind 0
  dmp_t dmp_t_r
  dmp_u k
  dmp_t dmp_t_id
  for i ulong 32
    dmp_hb ulong get olw_rid i
  end
  dmp_t dmp_t_name
  if or eq k 1 eq k 3
    for i ulong get opr_nlen 0 bound 64
      dmp_c ulong get opr_name i
    end
  end
  dmp_t dmp_t_pidx
  dmp_i get olw_rpidx 0
  dmp_t dmp_t_type
  if eq k 3
    dmp_t dmp_t_fnty
  else
    if ne k 0
      dmp_type get olw_rttag 0 get olw_rtwid 0
    end
  end
  dmp_t dmp_t_tid
  for i ulong 32
    dmp_hb ulong get olw_rtid i
  end
  dmp_c 10
end

fn dmp_line ln ulong n ulong to void
  dmp_t dmp_t_l
  dmp_u ln
  if and eq n 7 and and eq get v_sbuf 0 35 eq get v_sbuf 1 33 eq get v_sbuf 2 99
    vs_clear
    dmp_t dmp_t_clear
    ret
  end
  before = get v_og_cnt 0
  rc = olw_eval_sbuf n
  dmp_t dmp_t_rc
  dmp_i rc
  dmp_t dmp_t_err
  if ne rc 0
    for i ulong get olx_elen 0 bound 512
      dmp_c ulong get olx_err i
    end
  end
  dmp_c 10
  k = get olw_rkind 0
  if eq rc 0
    dmp_result
    if ne k 0
      for i ulong 32
        put v_tmp_id i get olw_rid i
      end
      if eq k 3
        vs_set_last V_BIND_PROGRAM get olw_rpidx 0
      else
        vs_set_last V_BIND_OBJECT -1
      end
    end
  end
  cnt = get v_og_cnt 0
  o = before
  while lt o cnt bound 257
    if true
      dmp_t dmp_t_o
      dmp_u o
      dmp_t dmp_t_kind
      dmp_u get v_og_kind o
      dmp_t dmp_t_id
      ob = mul o 32
      for i ulong 32
        dmp_hb ulong get v_og_id add ob i
      end
      dmp_c 10
    end
    o = add o 1
  end
  dmp_t dmp_t_c
  dmp_u cnt
  dmp_t dmp_t_binds
  dmp_u get v_bind_cnt 0
  dmp_t dmp_t_progs
  dmp_u get v_prog_cnt 0
  dmp_c 10
  if and eq rc 0 eq k 3
    dmp_prog ulong get olw_rpidx 0
  end
end

fn main to int
  vs_init
  total = ulong 0
  while lt total 1048576 bound 100000
    r = read 0 dmp_in total sub 1048576 total
    if le r 0
      break
    end
    total = add total ulong r
  end
  start = ulong 0
  ln = ulong 0
  p = ulong 0
  while lt p total bound 1048577
    if eq get dmp_in p 10
      n = sub p start
      if gt n 8191
        n = 8191
      end
      ln = add ln 1
      m = n
      if gt m 4096
        m = 4096
      end
      for i ulong m bound 4096
        put v_sbuf i get dmp_in add start i
      end
      dmp_line ln n
      start = add p 1
    end
    p = add p 1
  end
  dmp_flush
  ret 0
end

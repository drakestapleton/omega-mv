fn sha_sched_in off ulong to void
  for i ulong 16
    q = add off mul i 4
    x = uint get g_sha_in q
    x = or shl x 8 uint get g_sha_in add q 1
    x = or shl x 8 uint get g_sha_in add q 2
    put g_sha_w i or shl x 8 uint get g_sha_in add q 3
  end
  for i ulong 48
    x = get g_sha_w add i 1
    y = get g_sha_w add i 14
    x = add add get g_sha_w i get g_sha_w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
    put g_sha_w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
  end
end

fn sha_sched_pad off ulong to void
  for i ulong 16
    q = add off mul i 4
    x = uint get g_sha_pad q
    x = or shl x 8 uint get g_sha_pad add q 1
    x = or shl x 8 uint get g_sha_pad add q 2
    put g_sha_w i or shl x 8 uint get g_sha_pad add q 3
  end
  for i ulong 48
    x = get g_sha_w add i 1
    y = get g_sha_w add i 14
    x = add add get g_sha_w i get g_sha_w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
    put g_sha_w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
  end
end

fn sha_rounds to void
  a = get g_sha_s 0
  b = get g_sha_s 1
  c = get g_sha_s 2
  d = get g_sha_s 3
  e = get g_sha_s 4
  f = get g_sha_s 5
  g = get g_sha_s 6
  h = get g_sha_s 7
  t = uint 0
  for i ulong 64
    h = add h get g_sha_k i
    h = add h get g_sha_w i
    t = xor rotr e 6 rotr e 11
    t = xor t rotr e 25
    h = add h t
    h = add h xor g and e xor f g
    d = add d h
    t = xor rotr a 2 rotr a 13
    t = xor t rotr a 22
    h = add h t
    t = and c or a b
    h = add h or and a b t
    t = h
    h = g
    g = f
    f = e
    e = d
    d = c
    c = b
    b = a
    a = t
  end
  put g_sha_s 0 add get g_sha_s 0 a
  put g_sha_s 1 add get g_sha_s 1 b
  put g_sha_s 2 add get g_sha_s 2 c
  put g_sha_s 3 add get g_sha_s 3 d
  put g_sha_s 4 add get g_sha_s 4 e
  put g_sha_s 5 add get g_sha_s 5 f
  put g_sha_s 6 add get g_sha_s 6 g
  put g_sha_s 7 add get g_sha_s 7 h
end

fn sha256_hash n ulong to void
  put g_sha_s 0 0x6a09e667
  put g_sha_s 1 0xbb67ae85
  put g_sha_s 2 0x3c6ef372
  put g_sha_s 3 0xa54ff53a
  put g_sha_s 4 0x510e527f
  put g_sha_s 5 0x9b05688c
  put g_sha_s 6 0x1f83d9ab
  put g_sha_s 7 0x5be0cd19
  nb = shr n 6
  for b ulong nb bound 128
    sha_sched_in shl b 6
    sha_rounds
  end
  remn = and n 63
  base = shl nb 6
  for i ulong 128
    put g_sha_pad i uchar 0
  end
  for i ulong remn bound 64
    put g_sha_pad i get g_sha_in add base i
  end
  put g_sha_pad remn uchar 0x80
  tot = ulong 64
  if ge remn 56
    tot = 128
  end
  bits = shl n 3
  for i ulong 8
    put g_sha_pad sub tot add i 1 uchar and shr bits mul i 8 0xff
  end
  sha_sched_pad 0
  sha_rounds
  if eq tot 128
    sha_sched_pad 64
    sha_rounds
  end
  for i ulong 8
    w = get g_sha_s i
    put g_sha_out mul i 4 uchar and shr w 24 0xff
    put g_sha_out add mul i 4 1 uchar and shr w 16 0xff
    put g_sha_out add mul i 4 2 uchar and shr w 8 0xff
    put g_sha_out add mul i 4 3 uchar and w 0xff
  end
end

note ---- Canonical OMG0 encoding & Semantic Graph ----
fn enc_u16be pos ulong v ulong to ulong
  put g_enc pos uchar and shr v 8 0xff
  put g_enc add pos 1 uchar and v 0xff
  ret add pos 2
end

fn enc_u32be pos ulong v ulong to ulong
  put g_enc pos uchar and shr v 24 0xff
  put g_enc add pos 1 uchar and shr v 16 0xff
  put g_enc add pos 2 uchar and shr v 8 0xff
  put g_enc add pos 3 uchar and v 0xff
  ret add pos 4
end

fn enc_u16le pos ulong v ulong to ulong
  put g_enc pos uchar and v 0xff
  put g_enc add pos 1 uchar and shr v 8 0xff
  ret add pos 2
end

fn enc_u32le pos ulong v ulong to ulong
  put g_enc pos uchar and v 0xff
  put g_enc add pos 1 uchar and shr v 8 0xff
  put g_enc add pos 2 uchar and shr v 16 0xff
  put g_enc add pos 3 uchar and shr v 24 0xff
  ret add pos 4
end

fn enc_hdr kind ulong to ulong
  put g_enc 0 uchar 0x4f
  put g_enc 1 uchar 0x4d
  put g_enc 2 uchar 0x47
  put g_enc 3 uchar 0x30
  put g_enc 4 uchar 1
  put g_enc 5 uchar and kind 0xff
  ret 6
end

fn hash_enc n ulong to void
  for i ulong n bound 512
    put g_sha_in i get g_enc i
  end
  sha256_hash n
end

fn id_eq_obj idx ulong to bool
  base = mul idx 32
  for i ulong 32
    if ne get g_obj_id add base i get g_sha_out i
      ret false
    end
  end
  ret true
end

fn graph_reset to void
  put g_obj_cnt 0 0
end

fn graph_find_sha to long
  cnt = get g_obj_cnt 0
  for i ulong cnt bound 256
    if id_eq_obj i
      ret long i
    end
  end
  ret -1
end

fn graph_commit kind ulong elen ulong ttag ulong twid ulong to long
  hash_enc elen
  ex = graph_find_sha
  if ge ex 0
    ret ex
  end
  cnt = get g_obj_cnt 0
  if ge cnt 256
    ret -1
  end
  put g_obj_cnt 0 add cnt 1
  put g_obj_kind cnt kind
  put g_obj_elen cnt elen
  put g_obj_ttag cnt ttag
  put g_obj_twid cnt twid
  ibase = mul cnt 32
  for i ulong 32
    put g_obj_id add ibase i get g_sha_out i
  end
  ebase = mul cnt 256
  for i ulong elen bound 256
    put g_obj_enc add ebase i get g_enc i
  end
  ret long cnt
end

fn build_type_uint w ulong to long
  p = enc_hdr 2
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 44
  for i ulong 44
    put g_enc add p i uchar 0
  end
  u = enc_u32le p 3
  u = enc_u16le add p 4 w
  ret graph_commit 2 add p 44 3 w
end

fn build_type_bool to long
  p = enc_hdr 2
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 44
  for i ulong 44
    put g_enc add p i uchar 0
  end
  u = enc_u32le p 2
  ret graph_commit 2 add p 44 2 1
end

fn build_val_uint tidx ulong w ulong val ulong to long
  p = enc_hdr 1
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 98
  for i ulong 98
    put g_enc add p i uchar 0
  end
  for i ulong 32
    put g_enc add p i get g_obj_id add mul tidx 32 i
  end
  nb = div add w 7 8
  p = enc_u16le add p 32 nb
  for i ulong nb bound 8
    sh = mul sub sub nb 1 i 8
    b = uchar and shr val sh 0xff
    put g_enc add p i b
  end
  ret graph_commit 1 114 3 w
end

fn build_val_bool tidx ulong bval ulong to long
  p = enc_hdr 1
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 98
  for i ulong 98
    put g_enc add p i uchar 0
  end
  tbase = mul tidx 32
  for i ulong 32
    put g_enc add p i get g_obj_id add tbase i
  end
  u = enc_u16le add p 32 1
  put g_enc add p 34 uchar and bval 1
  ret graph_commit 1 add p 98 2 1
end

fn build_op_binary opcode ulong tidx ulong to long
  p = enc_hdr 3
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 204
  for i ulong 204
    put g_enc add p i uchar 0
  end
  u = enc_u32le p opcode
  u = enc_u32le add p 4 1
  tbase = mul tidx 32
  for i ulong 32
    b = get g_obj_id add tbase i
    put g_enc add add p 8 i b
    put g_enc add add p 41 i b
    put g_enc add add p 73 i b
    put g_enc add add p 169 i b
  end
  put g_enc add p 40 uchar 2
  ret graph_commit 3 add p 204 get g_obj_ttag tidx get g_obj_twid tidx
end

fn build_apply opidx ulong a1idx ulong a2idx ulong to long
  p = enc_hdr 3
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 161
  for i ulong 161
    put g_enc add p i uchar 0
  end
  ob = mul opidx 32
  a1 = mul a1idx 32
  a2 = mul a2idx 32
  for i ulong 32
    put g_enc add p i get g_obj_id add ob i
    put g_enc add add p 33 i get g_obj_id add a1 i
    put g_enc add add p 65 i get g_obj_id add a2 i
  end
  put g_enc add p 32 uchar 2
  ret graph_commit 3 add p 161 get g_obj_ttag opidx get g_obj_twid opidx
end

fn hash_constraint_req kind ulong to void
  n = get g_ast_rlen 0
  p = enc_hdr 5
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 1
  p = enc_u16be p kind
  p = enc_u16be p n
  for i ulong n bound 64
    put g_enc add p i get g_ast_req i
  end
  p = add p n
  p = enc_u32be p 0
  hash_enc p
end

fn hash_constraint_ens kind ulong to void
  n = get g_ast_elen2 0
  p = enc_hdr 5
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 1
  p = enc_u16be p kind
  p = enc_u16be p n
  for i ulong n bound 64
    put g_enc add p i get g_ast_ens i
  end
  p = add p n
  p = enc_u32be p 0
  hash_enc p
end

fn hash_constraint_txt kind ulong txt view uchar * to void
  n = len txt
  p = enc_hdr 5
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 1
  p = enc_u16be p kind
  p = enc_u16be p n
  for i ulong n bound 64
    put g_enc add p i get txt i
  end
  p = add p n
  p = enc_u32be p 0
  hash_enc p
end

note ---- Standalone program-id v2 computation (does not touch main graph) ----
fn sg_hash_type_u64 to void
  p = enc_hdr 2
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 44
  for i ulong 44
    put g_enc add p i uchar 0
  end
  u = enc_u32le p 3
  u = enc_u16le add p 4 64
  hash_enc add p 44
  for i ulong 32
    put g_sg_tid i get g_sha_out i
  end
end

fn sg_hash_param0 to void
  p = enc_hdr 1
  p = enc_u16be p 1
  put g_enc p uchar 11
  p = add p 1
  for i ulong 11
    put g_enc add p i get t_omega_param i
  end
  p = add p 11
  p = enc_u16be p 2
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 98
  for i ulong 98
    put g_enc add p i uchar 0
  end
  for i ulong 32
    put g_enc add p i get g_sg_tid i
  end
  hash_enc add p 98
  for i ulong 32
    put g_sg_cur i get g_sha_out i
  end
end

fn sg_hash_val_u64 val ulong to void
  p = enc_hdr 1
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 98
  for i ulong 98
    put g_enc add p i uchar 0
  end
  for i ulong 32
    put g_enc add p i get g_sg_tid i
  end
  u = enc_u16le add p 32 8
  for i ulong 8
    sh = mul sub 7 i 8
    put g_enc add add p 34 i uchar and shr val sh 0xff
  end
  hash_enc add p 98
  for i ulong 32
    put g_sg_cid i get g_sha_out i
  end
end

fn sg_hash_op opcode ulong to void
  p = enc_hdr 3
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 204
  for i ulong 204
    put g_enc add p i uchar 0
  end
  u = enc_u32le p opcode
  u = enc_u32le add p 4 1
  for i ulong 32
    b = get g_sg_tid i
    put g_enc add add p 8 i b
    put g_enc add add p 41 i b
    put g_enc add add p 73 i b
    put g_enc add add p 169 i b
  end
  put g_enc add p 40 uchar 2
  hash_enc add p 204
  for i ulong 32
    put g_sg_oid i get g_sha_out i
  end
end

fn sg_hash_apply to void
  p = enc_hdr 3
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 161
  for i ulong 161
    put g_enc add p i uchar 0
  end
  for i ulong 32
    put g_enc add p i get g_sg_oid i
    put g_enc add add p 33 i get g_sg_cur i
    put g_enc add add p 65 i get g_sg_cid i
  end
  put g_enc add p 32 uchar 2
  hash_enc add p 161
  for i ulong 32
    put g_sg_cur i get g_sha_out i
  end
end

fn cp_compute_id to void
  sg_hash_type_u64
  sg_hash_param0
  sc = get g_cp_scnt 0
  for i ulong sc bound 64
    sg_hash_val_u64 get g_cp_simm i
    sg_hash_op get g_cp_sop i
    sg_hash_apply
  end
  for i ulong 16
    put g_sha_in i get t_prog_dom i
  end
  put g_sha_in 16 uchar 0
  for i ulong 32
    put g_sha_in add 17 i get g_sg_cur i
    put g_sha_in add 49 i get g_sg_tid i
    put g_sha_in add 81 i get g_sg_tid i
    put g_sha_in add 113 i get g_cp_preid i
    put g_sha_in add 145 i get g_cp_postid i
  end
  sha256_hash 177
  for i ulong 32
    put g_cp_id i get g_sha_out i
  end
end

note ---- AArch64 Realization Emitter for u64 sequential body ----
fn cp_put_insn w ulong to void
  pos = get g_cp_clen 0
  put g_cp_code pos uchar and w 0xff
  put g_cp_code add pos 1 uchar and shr w 8 0xff
  put g_cp_code add pos 2 uchar and shr w 16 0xff
  put g_cp_code add pos 3 uchar and shr w 24 0xff
  put g_cp_clen 0 add pos 4
end

fn cp_emit_body to void
  put g_cp_clen 0 0
  sc = get g_cp_scnt 0
  for i ulong sc bound 64
    imm = get g_cp_simm i
    op = get g_cp_sop i
    lo = and imm 0xffff
    hi = and shr imm 16 0xffff
    note MOVZ X1, lo, LSL #0 = 0xd2800001 | (lo << 5)
    cp_put_insn or 0xd2800001 shl lo 5
    if ne hi 0
      note MOVK X1, hi, LSL #16 = 0xf2a00001 | (hi << 5)
      cp_put_insn or 0xf2a00001 shl hi 5
    end
    if eq op 3
      cp_put_insn 0x8b010000
    else
      if eq op 4
        cp_put_insn 0xcb010000
      else
        if eq op 5
          cp_put_insn 0x9b017c00
        else
          if eq op 9
            cp_put_insn 0x8a010000
          else
            cp_put_insn 0xaa010000
          end
        end
      end
    end
  end
  note RET = 0xd65f03c0
  cp_put_insn 0xd65f03c0
end

note Evaluate current program semantically on u64 x
fn cp_eval_u64 x ulong to ulong
  cur = x
  sc = get g_cp_scnt 0
  for i ulong sc bound 64
    op = get g_cp_sop i
    imm = get g_cp_simm i
    if eq op 3
      cur = add cur imm
    else
      if eq op 4
        cur = sub cur imm
      else
        if eq op 5
          cur = mul cur imm
        else
          if eq op 9
            cur = and cur imm
          else
            cur = or cur imm
          end
        end
      end
    end
  end
  ret cur
end

note ---- Error helper: "column N: error" ----
fn set_err col ulong to void
  pos = ulong 0
  for i ulong 7
    put g_err pos get t_col_pfx i
    pos = add pos 1
  end
  if eq col 0
    put g_err pos uchar 48
    pos = add pos 1
  else
    x = col
    cnt = ulong 0
    while gt x 0 bound 16
      put g_numbuf cnt uchar add rem x 10 48
      cnt = add cnt 1
      x = div x 10
    end
    i = cnt
    while gt i 0 bound 16
      i = sub i 1
      put g_err pos get g_numbuf i
      pos = add pos 1
    end
  end
  put g_err pos uchar 58
  put g_err add pos 1 uchar 32
  pos = add pos 2
  for i ulong 5
    put g_err pos get t_err_gen i
    pos = add pos 1
  end
  put g_err_len 0 pos
end

note ---- Lexer (mirrors src/language/omega_lex.c + lang_core.om) ----
fn is_id_start c ulong to bool
  if and ge c 97 le c 122
    ret true
  end
  if and ge c 65 le c 90
    ret true
  end
  ret eq c 95
end

fn is_id_char c ulong to bool
  if is_id_start c
    ret true
  end
  ret and ge c 48 le c 57
end

fn dval c ulong to ulong
  if and ge c 48 le c 57
    ret sub c 48
  end
  if and ge c 97 le c 102
    ret add sub c 97 10
  end
  if and ge c 65 le c 70
    ret add sub c 65 10
  end
  ret 99
end

fn tok_eq_txt tidx ulong s view uchar * to bool
  n = get g_tok_slen tidx
  if ne n len s
    ret false
  end
  base = mul tidx 64
  for i ulong n bound 64
    if ne get g_tok_str add base i get s i
      ret false
    end
  end
  ret true
end

fn classify_kw tidx ulong to ulong
  if tok_eq_txt tidx t_kw_let
    ret 3
  end
  if tok_eq_txt tidx t_kw_fn
    ret 4
  end
  if tok_eq_txt tidx t_kw_requires
    ret 5
  end
  if tok_eq_txt tidx t_kw_ensures
    ret 6
  end
  if tok_eq_txt tidx t_kw_true
    ret 7
  end
  if tok_eq_txt tidx t_kw_false
    ret 8
  end
  ret 1
end

fn lex_int pos ulong slen ulong tidx ulong to long
  base = ulong 10
  p = pos
  if lt add p 1 slen
    if eq ulong get g_line p 48
      nx = ulong get g_line add p 1
      if eq nx 120
        base = 16
        p = add p 2
      else
        if eq nx 98
          base = 2
          p = add p 2
        end
      end
    end
  end
  start = p
  v = ulong 0
  ovf = ulong 0
  maxu = ulong 0xffffffffffffffff
  while lt p slen bound 1024
    d = dval ulong get g_line p
    if ge d base
      break
    end
    if gt v div sub maxu d base
      ovf = 1
    else
      v = add mul v base d
    end
    p = add p 1
  end
  if eq p start
    set_err add pos 1
    ret -1
  end
  if lt p slen
    if is_id_char ulong get g_line p
      set_err add p 1
      ret -1
    end
  end
  if ne ovf 0
    set_err add pos 1
    ret -2
  end
  put g_tok_val tidx v
  ret long p
end

fn lex_punct c ulong c2 ulong to long
  if eq c 40
    ret 9
  end
  if eq c 41
    ret 10
  end
  if eq c 123
    ret 11
  end
  if eq c 125
    ret 12
  end
  if eq c 58
    ret 13
  end
  if eq c 44
    ret 14
  end
  if eq c 43
    ret 17
  end
  if eq c 42
    ret 19
  end
  if eq c 47
    ret 20
  end
  if eq c 38
    ret 21
  end
  if eq c 124
    ret 22
  end
  if eq c 45
    if eq c2 62
      ret 115
    end
    ret 18
  end
  if eq c 61
    if eq c2 61
      ret 123
    end
    ret 16
  end
  if eq c 33
    if eq c2 61
      ret 124
    end
    ret 29
  end
  if eq c 60
    if eq c2 61
      ret 126
    end
    ret 25
  end
  if eq c 62
    if eq c2 61
      ret 128
    end
    ret 27
  end
  if or eq c 34 eq c 39
    ret -2
  end
  if or eq c 91 eq c 93
    ret -2
  end
  ret -1
end

fn lex_block_cmt start ulong slen ulong to long
  j = add start 2
  while lt add j 1 slen bound 2048
    if eq ulong get g_line j 42
      if eq ulong get g_line add j 1 47
        ret long add j 2
      end
    end
    j = add j 1
  end
  set_err add start 1
  ret -1
end

fn lex_ident start ulong slen ulong tidx ulong to long
  j = add start 1
  while lt j slen bound 2048
    if not is_id_char ulong get g_line j
      break
    end
    j = add j 1
  end
  nlen = sub j start
  if ge nlen 64
    set_err add start 1
    ret -1
  end
  base = mul tidx 64
  for m ulong nlen bound 64
    put g_tok_str add base m get g_line add start m
  end
  put g_tok_slen tidx nlen
  put g_tok_kind tidx classify_kw tidx
  ret long j
end

fn lex_line to long
  put g_err_len 0 0
  put g_tok_cnt 0 0
  slen = get g_line_len 0
  if gt slen 1024
    set_err 1024
    ret -3
  end
  i = ulong 0
  k = ulong 0
  while lt i slen bound 2048
    c = ulong get g_line i
    if or or eq c 32 eq c 9 or eq c 13 eq c 10
      i = add i 1
      continue
    end
    c2 = ulong 0
    if lt add i 1 slen
      c2 = ulong get g_line add i 1
    end
    if and eq c 47 eq c2 47
      break
    end
    if and eq c 47 eq c2 42
      rc = lex_block_cmt i slen
      if lt rc 0
        ret rc
      end
      i = ulong rc
      continue
    end
    if ge add k 1 256
      set_err add i 1
      ret -3
    end
    put g_tok_col k add i 1
    put g_tok_val k 0
    put g_tok_slen k 0
    if and ge c 48 le c 57
      rc = lex_int i slen k
      if lt rc 0
        ret rc
      end
      put g_tok_kind k 2
      i = ulong rc
      k = add k 1
      continue
    end
    if is_id_start c
      rc = lex_ident i slen k
      if lt rc 0
        ret rc
      end
      i = ulong rc
      k = add k 1
      continue
    end
    pr = lex_punct c c2
    if lt pr 0
      set_err add i 1
      ret pr
    end
    if ge pr 100
      put g_tok_kind k ulong sub pr 100
      i = add i 2
    else
      put g_tok_kind k ulong pr
      i = add i 1
    end
    k = add k 1
  end
  put g_tok_kind k 0
  put g_tok_col k add i 1
  put g_tok_cnt 0 add k 1
  ret 0
end

note ---- Parser ----
fn is_reserved_tok tidx ulong to bool
  if or or tok_eq_txt tidx t_kw_let tok_eq_txt tidx t_kw_fn or tok_eq_txt tidx t_kw_requires tok_eq_txt tidx t_kw_ensures
    ret true
  end
  if or or tok_eq_txt tidx t_kw_true tok_eq_txt tidx t_kw_false or tok_eq_txt tidx t_ty_u8 tok_eq_txt tidx t_ty_u16
    ret true
  end
  if or or tok_eq_txt tidx t_ty_u32 tok_eq_txt tidx t_ty_u64 or tok_eq_txt tidx t_ty_bool tok_eq_txt tidx t_ty_i8
    ret true
  end
  if or or tok_eq_txt tidx t_ty_i16 tok_eq_txt tidx t_ty_i32 or tok_eq_txt tidx t_ty_i64 tok_eq_txt tidx t_res_result
    ret true
  end
  if or or tok_eq_txt tidx t_res_effect tok_eq_txt tidx t_res_effects or tok_eq_txt tidx t_res_cap tok_eq_txt tidx t_res_capability
    ret true
  end
  if or or tok_eq_txt tidx t_res_mint tok_eq_txt tidx t_res_revoke or tok_eq_txt tidx t_res_grant tok_eq_txt tidx t_res_publish
    ret true
  end
  if or or tok_eq_txt tidx t_res_promote tok_eq_txt tidx t_res_authority or tok_eq_txt tidx t_res_admin tok_eq_txt tidx t_res_syscall
    ret true
  end
  if or or tok_eq_txt tidx t_res_io tok_eq_txt tidx t_res_print or tok_eq_txt tidx t_res_import tok_eq_txt tidx t_res_extern
    ret true
  end
  if or or tok_eq_txt tidx t_res_unsafe tok_eq_txt tidx t_res_asm or tok_eq_txt tidx t_res_if tok_eq_txt tidx t_res_else
    ret true
  end
  if or or tok_eq_txt tidx t_res_while tok_eq_txt tidx t_res_for or tok_eq_txt tidx t_res_loop tok_eq_txt tidx t_res_return
    ret true
  end
  if or or tok_eq_txt tidx t_res_match tok_eq_txt tidx t_res_struct or tok_eq_txt tidx t_res_enum tok_eq_txt tidx t_res_mut
    ret true
  end
  if or or tok_eq_txt tidx t_res_var tok_eq_txt tidx t_res_const or tok_eq_txt tidx t_res_self tok_eq_txt tidx t_res_rec
    ret true
  end
  ret false
end

fn p_peek to ulong
  pos = get g_ppos 0
  cnt = get g_tok_cnt 0
  if lt pos cnt
    ret pos
  end
  ret sub cnt 1
end

fn p_next to ulong
  pos = p_peek
  cnt = get g_tok_cnt 0
  if lt add pos 1 cnt
    put g_ppos 0 add pos 1
  end
  ret pos
end

fn p_alloc kind ulong col ulong to long
  n = get g_ast_ncnt 0
  if ge n 128
    set_err col
    ret -3
  end
  put g_ast_ncnt 0 add n 1
  put g_ast_kind n kind
  put g_ast_col n col
  put g_ast_op n 0
  put g_ast_lhs n -1
  put g_ast_rhs n -1
  put g_ast_val n 0
  put g_ast_slen n 0
  put g_ast_ttag n 0
  put g_ast_twid n 0
  ret long n
end

note Parse type into global scratch g_res_ttag/g_res_twid
fn parse_type to long
  ti = p_peek
  if ne get g_tok_kind ti 1
    set_err get g_tok_col ti
    ret -1
  end
  if tok_eq_txt ti t_ty_u8
    put g_res_ttag 0 3
    put g_res_twid 0 8
    u = p_next
    ret 0
  end
  if tok_eq_txt ti t_ty_u16
    put g_res_ttag 0 3
    put g_res_twid 0 16
    u = p_next
    ret 0
  end
  if tok_eq_txt ti t_ty_u32
    put g_res_ttag 0 3
    put g_res_twid 0 32
    u = p_next
    ret 0
  end
  if tok_eq_txt ti t_ty_u64
    put g_res_ttag 0 3
    put g_res_twid 0 64
    u = p_next
    ret 0
  end
  if tok_eq_txt ti t_ty_bool
    put g_res_ttag 0 2
    put g_res_twid 0 1
    u = p_next
    ret 0
  end
  set_err get g_tok_col ti
  ret -2
end

fn copy_tok_to_ast ti ulong ni ulong to void
  sl = get g_tok_slen ti
  put g_ast_slen ni sl
  sb = mul ti 64
  db = mul ni 64
  for m ulong sl bound 64
    put g_ast_str add db m get g_tok_str add sb m
  end
end

fn parse_primary to long
  ti = p_peek
  tk = get g_tok_kind ti
  tc = get g_tok_col ti
  if eq tk 2
    u = p_next
    ni = p_alloc 1 tc
    if lt ni 0
      ret ni
    end
    put g_ast_val ulong ni get g_tok_val ti
    ret ni
  end
  if or eq tk 7 eq tk 8
    u = p_next
    ni = p_alloc 2 tc
    if lt ni 0
      ret ni
    end
    if eq tk 7
      put g_ast_val ulong ni 1
    else
      put g_ast_val ulong ni 0
    end
    ret ni
  end
  if eq tk 1
    if is_reserved_tok ti
      set_err tc
      ret -2
    end
    u = p_next
    if eq get g_tok_kind p_peek 9
      set_err get g_tok_col p_peek
      ret -2
    end
    ni = p_alloc 3 tc
    if lt ni 0
      ret ni
    end
    copy_tok_to_ast ti ulong ni
    ret ni
  end
  if eq tk 9
    d = get g_pdepth 0
    if ge d 32
      set_err tc
      ret -3
    end
    put g_pdepth 0 add d 1
    u = p_next
    inner = parse_ascribe
    put g_pdepth 0 d
    if lt inner 0
      ret inner
    end
    if ne get g_tok_kind p_peek 10
      set_err get g_tok_col p_peek
      ret -1
    end
    u = p_next
    ret inner
  end
  if or eq tk 18 eq tk 29
    set_err tc
    ret -2
  end
  set_err tc
  ret -1
end

fn parse_mul to long
  lhs = parse_primary
  if lt lhs 0
    ret lhs
  end
  while true bound 256
    ti = p_peek
    tk = get g_tok_kind ti
    if and ne tk 19 ne tk 20
      break
    end
    u = p_next
    rhs = parse_primary
    if lt rhs 0
      ret rhs
    end
    ni = p_alloc 4 get g_tok_col ti
    if lt ni 0
      ret ni
    end
    put g_ast_op ulong ni tk
    put g_ast_lhs ulong ni lhs
    put g_ast_rhs ulong ni rhs
    lhs = ni
  end
  ret lhs
end

fn parse_add to long
  lhs = parse_mul
  if lt lhs 0
    ret lhs
  end
  while true bound 256
    ti = p_peek
    tk = get g_tok_kind ti
    if and ne tk 17 ne tk 18
      break
    end
    u = p_next
    rhs = parse_mul
    if lt rhs 0
      ret rhs
    end
    ni = p_alloc 4 get g_tok_col ti
    if lt ni 0
      ret ni
    end
    put g_ast_op ulong ni tk
    put g_ast_lhs ulong ni lhs
    put g_ast_rhs ulong ni rhs
    lhs = ni
  end
  ret lhs
end

fn parse_and to long
  lhs = parse_add
  if lt lhs 0
    ret lhs
  end
  while true bound 256
    ti = p_peek
    if ne get g_tok_kind ti 21
      break
    end
    u = p_next
    rhs = parse_add
    if lt rhs 0
      ret rhs
    end
    ni = p_alloc 4 get g_tok_col ti
    if lt ni 0
      ret ni
    end
    put g_ast_op ulong ni 21
    put g_ast_lhs ulong ni lhs
    put g_ast_rhs ulong ni rhs
    lhs = ni
  end
  ret lhs
end

fn parse_or to long
  lhs = parse_and
  if lt lhs 0
    ret lhs
  end
  while true bound 256
    ti = p_peek
    if ne get g_tok_kind ti 22
      break
    end
    u = p_next
    rhs = parse_and
    if lt rhs 0
      ret rhs
    end
    ni = p_alloc 4 get g_tok_col ti
    if lt ni 0
      ret ni
    end
    put g_ast_op ulong ni 22
    put g_ast_lhs ulong ni lhs
    put g_ast_rhs ulong ni rhs
    lhs = ni
  end
  ret lhs
end

fn parse_cmp to long
  lhs = parse_or
  if lt lhs 0
    ret lhs
  end
  ti = p_peek
  tk = get g_tok_kind ti
  if and ge tk 23 le tk 28
    u = p_next
    rhs = parse_or
    if lt rhs 0
      ret rhs
    end
    ni = p_alloc 4 get g_tok_col ti
    if lt ni 0
      ret ni
    end
    put g_ast_op ulong ni tk
    put g_ast_lhs ulong ni lhs
    put g_ast_rhs ulong ni rhs
    ret ni
  end
  ret lhs
end

fn parse_ascribe to long
  lhs = parse_cmp
  if lt lhs 0
    ret lhs
  end
  ti = p_peek
  if eq get g_tok_kind ti 13
    u = p_next
    rc = parse_type
    if lt rc 0
      ret rc
    end
    ni = p_alloc 5 get g_tok_col ti
    if lt ni 0
      ret ni
    end
    put g_ast_lhs ulong ni lhs
    put g_ast_ttag ulong ni get g_res_ttag 0
    put g_ast_twid ulong ni get g_res_twid 0
    ret ni
  end
  ret lhs
end

fn tok_eq_param tidx ulong to bool
  n = get g_tok_slen tidx
  if ne n get g_ast_plen 0
    ret false
  end
  base = mul tidx 64
  for i ulong n bound 64
    if ne get g_tok_str add base i get g_ast_param i
      ret false
    end
  end
  ret true
end

fn clause_append is_ens bool s view uchar * to long
  if is_ens
    cur = get g_ast_elen2 0
    need = len s
    if gt cur 0
      need = add need 1
    end
    if ge add cur need 64
      ret -2
    end
    if gt cur 0
      put g_ast_ens cur uchar 32
      cur = add cur 1
    end
    for i ulong len s bound 64
      put g_ast_ens add cur i get s i
    end
    put g_ast_elen2 0 add cur len s
    ret 0
  end
  cur = get g_ast_rlen 0
  need = len s
  if gt cur 0
    need = add need 1
  end
  if ge add cur need 64
    ret -2
  end
  if gt cur 0
    put g_ast_req cur uchar 32
    cur = add cur 1
  end
  for i ulong len s bound 64
    put g_ast_req add cur i get s i
  end
  put g_ast_rlen 0 add cur len s
  ret 0
end

fn clause_append_u64 is_ens bool v ulong to long
  cnt = ulong 0
  if eq v 0
    put g_numbuf 0 uchar 48
    cnt = 1
  else
    x = v
    while gt x 0 bound 24
      put g_numbuf cnt uchar add rem x 10 48
      cnt = add cnt 1
      x = div x 10
    end
    i = ulong 0
    j = sub cnt 1
    while lt i j bound 24
      a = get g_numbuf i
      b = get g_numbuf j
      put g_numbuf i b
      put g_numbuf j a
      i = add i 1
      j = sub j 1
    end
  end
  if is_ens
    cur = get g_ast_elen2 0
    need = cnt
    if gt cur 0
      need = add need 1
    end
    if ge add cur need 64
      ret -2
    end
    if gt cur 0
      put g_ast_ens cur uchar 32
      cur = add cur 1
    end
    for i ulong cnt bound 24
      put g_ast_ens add cur i get g_numbuf i
    end
    put g_ast_elen2 0 add cur cnt
    ret 0
  end
  cur = get g_ast_rlen 0
  need = cnt
  if gt cur 0
    need = add need 1
  end
  if ge add cur need 64
    ret -2
  end
  if gt cur 0
    put g_ast_req cur uchar 32
    cur = add cur 1
  end
  for i ulong cnt bound 24
    put g_ast_req add cur i get g_numbuf i
  end
  put g_ast_rlen 0 add cur cnt
  ret 0
end

fn clause_append_op is_ens bool tk ulong to long
  if eq tk 17
    ret clause_append is_ens t_tok_add
  end
  if eq tk 18
    ret clause_append is_ens t_tok_sub
  end
  if eq tk 19
    ret clause_append is_ens t_tok_mul
  end
  if eq tk 20
    ret clause_append is_ens t_tok_div
  end
  if eq tk 21
    ret clause_append is_ens t_tok_amp
  end
  if eq tk 22
    ret clause_append is_ens t_tok_pip
  end
  if eq tk 23
    ret clause_append is_ens t_tok_eq
  end
  if eq tk 24
    ret clause_append is_ens t_tok_ne
  end
  if eq tk 25
    ret clause_append is_ens t_tok_lt
  end
  if eq tk 26
    ret clause_append is_ens t_tok_le
  end
  if eq tk 27
    ret clause_append is_ens t_tok_gt
  end
  if eq tk 28
    ret clause_append is_ens t_tok_ge
  end
  if eq tk 9
    ret clause_append is_ens t_tok_lp
  end
  if eq tk 10
    ret clause_append is_ens t_tok_rp
  end
  ret -2
end

fn parse_clause is_ens bool to long
  if is_ens
    put g_ast_elen2 0 0
  else
    put g_ast_rlen 0 0
  end
  cnt = ulong 0
  while true bound 128
    ti = p_peek
    tk = get g_tok_kind ti
    if or or eq tk 0 eq tk 11 eq tk 6
      break
    end
    rc = long 0
    if eq tk 7
      rc = clause_append is_ens t_kw_true
    else
      if eq tk 8
        rc = clause_append is_ens t_kw_false
      else
        if eq tk 2
          rc = clause_append_u64 is_ens get g_tok_val ti
        else
          if eq tk 1
            if tok_eq_param ti
              rc = clause_append is_ens t_x
            else
              if and is_ens tok_eq_txt ti t_res_result
                rc = clause_append is_ens t_res_result
              else
                set_err get g_tok_col ti
                ret -2
              end
            end
          else
            rc = clause_append_op is_ens tk
          end
        end
      end
    end
    if lt rc 0
      set_err get g_tok_col ti
      ret rc
    end
    u = p_next
    cnt = add cnt 1
  end
  if eq cnt 0
    set_err get g_tok_col p_peek
    ret -1
  end
  ret 0
end

fn set_default_clauses to void
  for i ulong 4
    put g_ast_req i get t_kw_true i
    put g_ast_ens i get t_kw_true i
  end
  put g_ast_rlen 0 4
  put g_ast_elen2 0 4
end

fn parse_fn to long
  put g_ast_stmt 0 3
  u = p_next
  nm = p_peek
  if ne get g_tok_kind nm 1
    set_err get g_tok_col nm
    ret -1
  end
  if is_reserved_tok nm
    set_err get g_tok_col nm
    ret -2
  end
  if tok_eq_txt nm t_underscore
    set_err get g_tok_col nm
    ret -1
  end
  nl = get g_tok_slen nm
  put g_ast_nlen 0 nl
  nb = mul nm 64
  for i ulong nl bound 64
    put g_ast_name i get g_tok_str add nb i
  end
  u = p_next
  if ne get g_tok_kind p_peek 9
    set_err get g_tok_col p_peek
    ret -1
  end
  u = p_next
  pn = p_peek
  if ne get g_tok_kind pn 1
    set_err get g_tok_col pn
    ret -1
  end
  if is_reserved_tok pn
    set_err get g_tok_col pn
    ret -2
  end
  if tok_eq_txt pn t_underscore
    set_err get g_tok_col pn
    ret -1
  end
  pl = get g_tok_slen pn
  put g_ast_plen 0 pl
  pb = mul pn 64
  for i ulong pl bound 64
    put g_ast_param i get g_tok_str add pb i
  end
  u = p_next
  if ne get g_tok_kind p_peek 13
    set_err get g_tok_col p_peek
    ret -1
  end
  u = p_next
  rc = parse_type
  if lt rc 0
    ret rc
  end
  put g_ast_pttag 0 get g_res_ttag 0
  put g_ast_ptwid 0 get g_res_twid 0
  if eq get g_tok_kind p_peek 14
    set_err get g_tok_col p_peek
    ret -2
  end
  if ne get g_tok_kind p_peek 10
    set_err get g_tok_col p_peek
    ret -1
  end
  u = p_next
  if ne get g_tok_kind p_peek 15
    set_err get g_tok_col p_peek
    ret -1
  end
  u = p_next
  rc = parse_type
  if lt rc 0
    ret rc
  end
  put g_ast_rttag 0 get g_res_ttag 0
  put g_ast_rtwid 0 get g_res_twid 0
  set_default_clauses
  if eq get g_tok_kind p_peek 5
    u = p_next
    rc = parse_clause false
    if lt rc 0
      ret rc
    end
  end
  if eq get g_tok_kind p_peek 6
    u = p_next
    rc = parse_clause true
    if lt rc 0
      ret rc
    end
  end
  if ne get g_tok_kind p_peek 11
    set_err get g_tok_col p_peek
    ret -1
  end
  u = p_next
  root = parse_ascribe
  if lt root 0
    ret root
  end
  if ne get g_tok_kind p_peek 12
    set_err get g_tok_col p_peek
    ret -1
  end
  u = p_next
  if ne get g_tok_kind p_peek 0
    set_err get g_tok_col p_peek
    ret -1
  end
  put g_ast_root 0 root
  ret 0
end

fn parse_line to long
  rc = lex_line
  if lt rc 0
    ret rc
  end
  put g_ppos 0 0
  put g_pdepth 0 0
  put g_ast_ncnt 0 0
  put g_ast_root 0 -1
  ti = p_peek
  tk = get g_tok_kind ti
  put g_ast_scol 0 get g_tok_col ti
  if eq tk 0
    put g_ast_stmt 0 0
    ret 0
  end
  if eq tk 4
    ret parse_fn
  end
  if eq tk 3
    put g_ast_stmt 0 2
    u = p_next
    nm = p_peek
    if ne get g_tok_kind nm 1
      set_err get g_tok_col nm
      ret -1
    end
    if is_reserved_tok nm
      set_err get g_tok_col nm
      ret -2
    end
    if tok_eq_txt nm t_underscore
      set_err get g_tok_col nm
      ret -1
    end
    nl = get g_tok_slen nm
    put g_ast_nlen 0 nl
    nb = mul nm 64
    for i ulong nl bound 64
      put g_ast_name i get g_tok_str add nb i
    end
    u = p_next
    if ne get g_tok_kind p_peek 13
      set_err get g_tok_col p_peek
      ret -1
    end
    u = p_next
    rc = parse_type
    if lt rc 0
      ret rc
    end
    put g_ast_lttag 0 get g_res_ttag 0
    put g_ast_ltwid 0 get g_res_twid 0
    if ne get g_tok_kind p_peek 16
      set_err get g_tok_col p_peek
      ret -1
    end
    u = p_next
    root = parse_ascribe
    if lt root 0
      ret root
    end
    if ne get g_tok_kind p_peek 0
      set_err get g_tok_col p_peek
      ret -1
    end
    put g_ast_root 0 root
    ret 0
  end
  put g_ast_stmt 0 1
  root = parse_ascribe
  if lt root 0
    ret root
  end
  if ne get g_tok_kind p_peek 0
    set_err get g_tok_col p_peek
    ret -1
  end
  put g_ast_root 0 root
  ret 0
end

note ---- Lowerer & Session ----
fn session_reset to void
  graph_reset
  put g_bind_cnt 0 0
  put g_has_last 0 0
  put g_prog_cnt 0 0
end

fn bind_eq_node bi ulong ni ulong to bool
  sl = get g_ast_slen ni
  if ne get g_bind_nlen bi sl
    ret false
  end
  sb = mul ni 64
  db = mul bi 64
  for j ulong sl bound 64
    if ne get g_bind_name add db j get g_ast_str add sb j
      ret false
    end
  end
  ret true
end

fn bind_find_node ni ulong to long
  cnt = get g_bind_cnt 0
  for i ulong cnt bound 64
    if bind_eq_node i ni
      ret long i
    end
  end
  ret -1
end

fn bind_eq_ast bi ulong to bool
  sl = get g_ast_nlen 0
  if ne get g_bind_nlen bi sl
    ret false
  end
  db = mul bi 64
  for j ulong sl bound 64
    if ne get g_bind_name add db j get g_ast_name j
      ret false
    end
  end
  ret true
end

fn bind_find_astname to long
  cnt = get g_bind_cnt 0
  for i ulong cnt bound 64
    if bind_eq_ast i
      ret long i
    end
  end
  ret -1
end

fn bind_eq_txt bi ulong s view uchar * to bool
  sl = len s
  if ne get g_bind_nlen bi sl
    ret false
  end
  db = mul bi 64
  for j ulong sl bound 64
    if ne get g_bind_name add db j get s j
      ret false
    end
  end
  ret true
end

fn bind_find_txt s view uchar * to long
  cnt = get g_bind_cnt 0
  for i ulong cnt bound 64
    if bind_eq_txt i s
      ret long i
    end
  end
  ret -1
end

fn bind_set_ast kind ulong pidx long to long
  ex = bind_find_astname
  slot = ulong 0
  if ge ex 0
    slot = ulong ex
  else
    cnt = get g_bind_cnt 0
    if ge cnt 64
      ret -3
    end
    slot = cnt
    put g_bind_cnt 0 add cnt 1
    sl = get g_ast_nlen 0
    put g_bind_nlen slot sl
    db = mul slot 64
    for i ulong sl bound 64
      put g_bind_name add db i get g_ast_name i
    end
  end
  put g_bind_kind slot kind
  put g_bind_ttag slot get g_res_ttag 0
  put g_bind_twid slot get g_res_twid 0
  put g_bind_pidx slot pidx
  ib = mul slot 32
  for i ulong 32
    put g_bind_id add ib i get g_res_id i
  end
  ret 0
end

fn width_max w ulong to ulong
  if eq w 8
    ret 255
  end
  if eq w 16
    ret 65535
  end
  if eq w 32
    ret 4294967295
  end
  ret 0xffffffffffffffff
end

fn tok_to_opcode tk ulong to ulong
  if eq tk 17
    ret 3
  end
  if eq tk 18
    ret 4
  end
  if eq tk 19
    ret 5
  end
  if eq tk 20
    ret 6
  end
  if eq tk 21
    ret 9
  end
  if eq tk 22
    ret 10
  end
  ret 0
end

fn is_zero_lit ni ulong to bool
  k = get g_ast_kind ni
  if eq k 5
    ret is_zero_lit ulong get g_ast_lhs ni
  end
  if eq k 1
    ret eq get g_ast_val ni 0
  end
  ret false
end

fn graph_find_by_bind bidx ulong to long
  bb = mul bidx 32
  cnt = get g_obj_cnt 0
  for i ulong cnt bound 256
    ob = mul i 32
    same = true
    for j ulong 32
      if ne get g_obj_id add ob j get g_bind_id add bb j
        same = false
        break
      end
    end
    if same
      ret long i
    end
  end
  ret -1
end

fn graph_find_by_last to long
  cnt = get g_obj_cnt 0
  for i ulong cnt bound 256
    ob = mul i 32
    same = true
    for j ulong 32
      if ne get g_obj_id add ob j get g_last_id j
        same = false
        break
      end
    end
    if same
      ret long i
    end
  end
  ret -1
end

fn lower_expr_name idx ulong etag ulong ewid ulong use_sess bool to long
  col = get g_ast_col idx
  if not use_sess
    set_err col
    ret -2
  end
  if and eq get g_ast_slen idx 1 eq ulong get g_ast_str mul idx 64 95
    if or eq get g_has_last 0 0 ne get g_last_kind 0 1
      set_err col
      ret -2
    end
    if ne etag 0
      if or ne etag get g_last_ttag 0 ne ewid get g_last_twid 0
        set_err col
        ret -2
      end
    end
    gi = graph_find_by_last
    if lt gi 0
      set_err col
      ret -2
    end
    ret gi
  end
  bi = bind_find_node idx
  if lt bi 0
    set_err col
    ret -2
  end
  if ne get g_bind_kind ulong bi 1
    set_err col
    ret -2
  end
  if ne etag 0
    if or ne etag get g_bind_ttag ulong bi ne ewid get g_bind_twid ulong bi
      set_err col
      ret -2
    end
  end
  gi = graph_find_by_bind ulong bi
  if lt gi 0
    set_err col
    ret -2
  end
  ret gi
end

fn build_bin_apply opc ulong lobj ulong robj ulong col ulong to long
  ti = build_type_uint get g_obj_twid lobj
  if lt ti 0
    set_err col
    ret -3
  end
  oi = build_op_binary opc ulong ti
  if lt oi 0
    set_err col
    ret -3
  end
  ai = build_apply ulong oi lobj robj
  if lt ai 0
    set_err col
    ret -3
  end
  ret ai
end

fn lower_expr_bin idx ulong etag ulong ewid ulong use_sess bool to long
  col = get g_ast_col idx
  tk = get g_ast_op idx
  if and ge tk 23 le tk 28
    set_err col
    ret -2
  end
  opc = tok_to_opcode tk
  if or eq opc 0 and eq opc 6 is_zero_lit ulong get g_ast_rhs idx
    set_err col
    ret -2
  end
  if and ne etag 0 ne etag 3
    set_err col
    ret -2
  end
  lobj = long -1
  robj = long -1
  if eq get g_ast_kind ulong get g_ast_lhs idx 1
    if ne etag 0
      lobj = lower_expr ulong get g_ast_lhs idx etag ewid use_sess
      if lt lobj 0
        ret lobj
      end
      robj = lower_expr ulong get g_ast_rhs idx etag ewid use_sess
      if lt robj 0
        ret robj
      end
    else
      robj = lower_expr ulong get g_ast_rhs idx 0 0 use_sess
      if lt robj 0
        ret robj
      end
      if ne get g_obj_ttag ulong robj 3
        set_err col
        ret -2
      end
      lobj = lower_expr ulong get g_ast_lhs idx 3 get g_obj_twid ulong robj use_sess
      if lt lobj 0
        ret lobj
      end
    end
  else
    lobj = lower_expr ulong get g_ast_lhs idx etag ewid use_sess
    if lt lobj 0
      ret lobj
    end
    if ne get g_obj_ttag ulong lobj 3
      set_err col
      ret -2
    end
    robj = lower_expr ulong get g_ast_rhs idx 3 get g_obj_twid ulong lobj use_sess
    if lt robj 0
      ret robj
    end
  end
  ret build_bin_apply opc ulong lobj ulong robj col
end

note lower_expr: etag=0 means no expected type; returns graph obj index >= 0 or negative error
fn lower_expr idx ulong etag ulong ewid ulong use_sess bool to long
  k = get g_ast_kind idx
  col = get g_ast_col idx
  if eq k 1
    if ne etag 3
      set_err col
      ret -2
    end
    v = get g_ast_val idx
    if gt v width_max ewid
      set_err col
      ret -2
    end
    ti = build_type_uint ewid
    if lt ti 0
      set_err col
      ret -3
    end
    vi = build_val_uint ulong ti ewid v
    if lt vi 0
      set_err col
      ret -3
    end
    ret vi
  end
  if eq k 2
    if and ne etag 0 ne etag 2
      set_err col
      ret -2
    end
    ti = build_type_bool
    if lt ti 0
      set_err col
      ret -3
    end
    vi = build_val_bool ulong ti get g_ast_val idx
    if lt vi 0
      set_err col
      ret -3
    end
    ret vi
  end
  if eq k 3
    ret lower_expr_name idx etag ewid use_sess
  end
  if eq k 5
    tt = get g_ast_ttag idx
    tw = get g_ast_twid idx
    if ne etag 0
      if or ne etag tt ne ewid tw
        set_err col
        ret -2
      end
    end
    ret lower_expr ulong get g_ast_lhs idx tt tw use_sess
  end
  if eq k 4
    ret lower_expr_bin idx etag ewid use_sess
  end
  set_err col
  ret -1
end

fn node_lit_u64 ni ulong to long
  k = get g_ast_kind ni
  if eq k 5
    if or ne get g_ast_ttag ni 3 ne get g_ast_twid ni 64
      ret -2
    end
    ret node_lit_u64 ulong get g_ast_lhs ni
  end
  if eq k 1
    ret long ni
  end
  ret -1
end

fn node_eq_ast_name ni ulong to bool
  sl = get g_ast_slen ni
  if ne sl get g_ast_nlen 0
    ret false
  end
  sb = mul ni 64
  for i ulong sl bound 64
    if ne get g_ast_str add sb i get g_ast_name i
      ret false
    end
  end
  ret true
end

fn node_eq_ast_param ni ulong to bool
  sl = get g_ast_slen ni
  if ne sl get g_ast_plen 0
    ret false
  end
  sb = mul ni 64
  for i ulong sl bound 64
    if ne get g_ast_str add sb i get g_ast_param i
      ret false
    end
  end
  ret true
end

fn is_comm_op opc ulong to bool
  if or eq opc 3 eq opc 5
    ret true
  end
  ret or eq opc 9 eq opc 10
end

fn lp_step idx ulong sc ulong to long
  tk = get g_ast_op idx
  col = get g_ast_col idx
  if or and ge tk 23 le tk 28 eq tk 20
    set_err col
    ret -2
  end
  opc = tok_to_opcode tk
  rl = node_lit_u64 ulong get g_ast_rhs idx
  ll = node_lit_u64 ulong get g_ast_lhs idx
  if or eq rl -2 eq ll -2
    set_err col
    ret -2
  end
  if ge rl 0
    imm = get g_ast_val ulong rl
    if gt imm 0xffffffff
      set_err col
      ret -2
    end
    put g_cp_sop sc opc
    put g_cp_simm sc imm
    ret get g_ast_lhs idx
  end
  if and is_comm_op opc ge ll 0
    imm = get g_ast_val ulong ll
    if gt imm 0xffffffff
      set_err col
      ret -2
    end
    put g_cp_sop sc opc
    put g_cp_simm sc imm
    ret get g_ast_rhs idx
  end
  set_err col
  ret -2
end

fn lp_reverse_steps sc ulong to void
  i = ulong 0
  j = sub sc 1
  while lt i j bound 32
    ao = get g_cp_sop i
    bo = get g_cp_sop j
    put g_cp_sop i bo
    put g_cp_sop j ao
    ai = get g_cp_simm i
    bi = get g_cp_simm j
    put g_cp_simm i bi
    put g_cp_simm j ai
    i = add i 1
    j = sub j 1
  end
end

fn lower_program to long
  if ne get g_ast_stmt 0 3
    set_err get g_ast_scol 0
    ret -1
  end
  if or or ne get g_ast_pttag 0 3 ne get g_ast_ptwid 0 64 or ne get g_ast_rttag 0 3 ne get g_ast_rtwid 0 64
    set_err get g_ast_scol 0
    ret -2
  end
  sc = ulong 0
  idx = ulong get g_ast_root 0
  while true bound 64
    k = get g_ast_kind idx
    if eq k 5
      if or ne get g_ast_ttag idx 3 ne get g_ast_twid idx 64
        set_err get g_ast_col idx
        ret -2
      end
      idx = ulong get g_ast_lhs idx
      continue
    end
    if ne k 4
      break
    end
    if ge sc 32
      set_err get g_ast_col idx
      ret -3
    end
    nxt = lp_step idx sc
    if lt nxt 0
      ret nxt
    end
    sc = add sc 1
    idx = ulong nxt
  end
  if or ne get g_ast_kind idx 3 not node_eq_ast_param idx
    set_err get g_ast_col idx
    ret -2
  end
  if eq sc 0
    set_err get g_ast_col idx
    ret -2
  end
  put g_cp_scnt 0 sc
  lp_reverse_steps sc
  hash_constraint_req 7
  for i ulong 32
    put g_cp_preid i get g_sha_out i
  end
  hash_constraint_ens 8
  for i ulong 32
    put g_cp_postid i get g_sha_out i
  end
  cp_compute_id
  cp_emit_body
  ret 0
end

fn prog_find_by_cpid to long
  cnt = get g_prog_cnt 0
  for i ulong cnt bound 16
    pb = mul i 32
    same = true
    for j ulong 32
      if ne get g_prog_id add pb j get g_cp_id j
        same = false
        break
      end
    end
    if same
      ret long i
    end
  end
  ret -1
end

fn prog_store_meta cnt ulong to void
  nl = get g_ast_nlen 0
  put g_prog_nlen cnt nl
  nb = mul cnt 64
  for i ulong nl bound 64
    put g_prog_name add nb i get g_ast_name i
  end
  rl = get g_ast_rlen 0
  put g_prog_rlen cnt rl
  for i ulong rl bound 64
    put g_prog_req add nb i get g_ast_req i
  end
  el = get g_ast_elen2 0
  put g_prog_elen cnt el
  for i ulong el bound 64
    put g_prog_ens add nb i get g_ast_ens i
  end
end

fn prog_store_body cnt ulong to void
  ib = mul cnt 32
  for i ulong 32
    put g_prog_id add ib i get g_cp_id i
    put g_prog_preid add ib i get g_cp_preid i
    put g_prog_postid add ib i get g_cp_postid i
  end
  sc = get g_cp_scnt 0
  put g_prog_scnt cnt sc
  sb = mul cnt 64
  for i ulong sc bound 64
    put g_prog_sop add sb i get g_cp_sop i
    put g_prog_simm add sb i get g_cp_simm i
  end
  cl = get g_cp_clen 0
  put g_prog_clen cnt cl
  cb = mul cnt 256
  for i ulong cl bound 256
    put g_prog_code add cb i get g_cp_code i
  end
end

fn prog_store_cp to long
  ex = prog_find_by_cpid
  if ge ex 0
    ret ex
  end
  cnt = get g_prog_cnt 0
  if ge cnt 16
    set_err get g_ast_scol 0
    ret -3
  end
  put g_prog_cnt 0 add cnt 1
  prog_store_meta cnt
  prog_store_body cnt
  ret long cnt
end

fn set_line s view uchar * to void
  n = len s
  for i ulong n bound 2048
    put g_line i get s i
  end
  put g_line_len 0 n
end

fn eval_cur_line to long
  put g_res_kind 0 0
  put g_res_pidx 0 -1
  put g_res_nlen 0 0
  rc = parse_line
  if lt rc 0
    ret rc
  end
  st = get g_ast_stmt 0
  if eq st 0
    ret 0
  end
  if eq st 1
    saved = get g_obj_cnt 0
    oi = lower_expr ulong get g_ast_root 0 0 0 true
    if lt oi 0
      put g_obj_cnt 0 saved
      ret oi
    end
    put g_res_kind 0 1
    tt = get g_obj_ttag ulong oi
    tw = get g_obj_twid ulong oi
    put g_res_ttag 0 tt
    put g_res_twid 0 tw
    ob = mul ulong oi 32
    for i ulong 32
      put g_res_id i get g_obj_id add ob i
    end
    ti = long 0
    if eq tt 2
      ti = build_type_bool
    else
      ti = build_type_uint tw
    end
    if ge ti 0
      tb = mul ulong ti 32
      for i ulong 32
        put g_res_tid i get g_obj_id add tb i
      end
    end
    ret 0
  end
  if eq st 2
    if and lt bind_find_astname 0 ge get g_bind_cnt 0 64
      set_err get g_ast_scol 0
      ret -3
    end
    saved = get g_obj_cnt 0
    oi = lower_expr ulong get g_ast_root 0 get g_ast_lttag 0 get g_ast_ltwid 0 true
    if lt oi 0
      put g_obj_cnt 0 saved
      ret oi
    end
    put g_res_kind 0 2
    put g_res_ttag 0 get g_obj_ttag ulong oi
    put g_res_twid 0 get g_obj_twid ulong oi
    ob = mul ulong oi 32
    for i ulong 32
      put g_res_id i get g_obj_id add ob i
    end
    nl = get g_ast_nlen 0
    put g_res_nlen 0 nl
    for i ulong nl bound 64
      put g_res_name i get g_ast_name i
    end
    rc = bind_set_ast 1 -1
    if lt rc 0
      put g_obj_cnt 0 saved
      ret rc
    end
    ret 0
  end
  if eq st 3
    if and lt bind_find_astname 0 ge get g_bind_cnt 0 64
      set_err get g_ast_scol 0
      ret -3
    end
    rc = lower_program
    if lt rc 0
      ret rc
    end
    pidx = prog_store_cp
    if lt pidx 0
      ret pidx
    end
    put g_res_kind 0 3
    put g_res_pidx 0 pidx
    put g_res_ttag 0 3
    put g_res_twid 0 64
    for i ulong 32
      put g_res_id i get g_cp_id i
    end
    nl = get g_ast_nlen 0
    put g_res_nlen 0 nl
    for i ulong nl bound 64
      put g_res_name i get g_ast_name i
    end
    rc = bind_set_ast 2 pidx
    if lt rc 0
      ret rc
    end
    ret 0
  end
  ret -1
end

fn eval_txt s view uchar * to long
  set_line s
  ret eval_cur_line
end

fn lower_fresh_txt s view uchar * to long
  set_line s
  rc = parse_line
  if lt rc 0
    ret rc
  end
  graph_reset
  et = ulong 0
  ew = ulong 0
  if eq get g_ast_stmt 0 2
    et = get g_ast_lttag 0
    ew = get g_ast_ltwid 0
  end
  oi = lower_expr ulong get g_ast_root 0 et ew false
  if lt oi 0
    ret oi
  end
  ob = mul ulong oi 32
  for i ulong 32
    put g_res_id i get g_obj_id add ob i
  end
  ret oi
end

fn save_res_to_a to void
  for i ulong 32
    put g_id_a i get g_res_id i
  end
end

fn save_res_to_b to void
  for i ulong 32
    put g_id_b i get g_res_id i
  end
end

fn save_res_to_c to void
  for i ulong 32
    put g_id_c i get g_res_id i
  end
end

fn id_eq_a_res to bool
  for i ulong 32
    if ne get g_id_a i get g_res_id i
      ret false
    end
  end
  ret true
end

fn id_eq_a_b to bool
  for i ulong 32
    if ne get g_id_a i get g_id_b i
      ret false
    end
  end
  ret true
end

fn id_eq_b_c to bool
  for i ulong 32
    if ne get g_id_b i get g_id_c i
      ret false
    end
  end
  ret true
end

fn id_eq_res_obj idx ulong to bool
  ob = mul idx 32
  for i ulong 32
    if ne get g_res_id i get g_obj_id add ob i
      ret false
    end
  end
  ret true
end

fn id_eq_a_obj idx ulong to bool
  ob = mul idx 32
  for i ulong 32
    if ne get g_id_a i get g_obj_id add ob i
      ret false
    end
  end
  ret true
end

fn err_ok to bool
  n = get g_err_len 0
  if lt n 7
    ret false
  end
  for i ulong 7
    if ne get g_err i get t_col_pfx i
      ret false
    end
  end
  for i ulong n bound 256
    if eq ulong get g_err i 10
      ret false
    end
  end
  ret true
end

note ---- Test 1: literal spellings ----
fn test_literal_spellings to void
  chk ge lower_fresh_txt s_7_u64 0
  save_res_to_a
  chk ge lower_fresh_txt s_07_u64 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_0x07_u64 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_0b111_u64 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_p7_u64 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_0x7_sp_u64 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_cmt_7_u64 0
  chk id_eq_a_res
  graph_reset
  ti = build_type_uint 64
  vi = build_val_uint ulong ti 64 7
  chk id_eq_a_obj ulong vi
end

note ---- Test 2: width changes id ----
fn test_width_changes_id to void
  chk ge lower_fresh_txt s_7_u64 0
  save_res_to_a
  chk ge lower_fresh_txt s_7_u32 0
  save_res_to_b
  chk ge lower_fresh_txt s_7_u8 0
  save_res_to_c
  chk not id_eq_a_b
  chk not id_eq_b_c
end

note ---- Test 3: whitespace, comments, and names ----
fn test_whitespace_comments_and_names to void
  session_reset
  chk eq eval_txt s_let_x3 0
  chk and eq get g_res_kind 0 2 and eq get g_res_nlen 0 1 and eq ulong get g_res_name 0 120 eq get g_res_twid 0 64
  chk eq eval_txt s_let_y4 0
  chk eq eval_txt s_xy_0 0
  chk eq get g_res_kind 0 1
  save_res_to_a
  c1 = get g_obj_cnt 0
  chk eq eval_txt s_xy_1 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_2 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_3 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_4 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_5 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_6 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_7 0
  chk id_eq_a_res
  chk eq get g_obj_cnt 0 c1
  note Check against direct builders
  before = get g_obj_cnt 0
  chk eq eval_txt s_let_a7 0
  save_res_to_b
  mid = get g_obj_cnt 0
  chk eq eval_txt s_let_b7 0
  save_res_to_c
  chk id_eq_b_c
  chk and eq mid add before 1 eq get g_obj_cnt 0 mid
  bi = bind_find_txt t_b
  chk and ge bi 0 eq get g_bind_kind ulong bi 1
  chk eq eval_txt s_let_zxy 0
  chk id_eq_a_res
  chk eq eval_txt s_x_p_1 0
  save_res_to_b
  chk eq eval_txt s_x_p_1u 0
  save_res_to_c
  chk id_eq_b_c
  chk eq eval_txt s_rebind_x 0
  save_res_to_b
  bx = bind_find_txt t_x
  chk ge bx 0
  note Set last = y and test _ + x
  by = bind_find_txt t_y
  put g_has_last 0 1
  put g_last_kind 0 get g_bind_kind ulong by
  put g_last_ttag 0 get g_bind_ttag ulong by
  put g_last_twid 0 get g_bind_twid ulong by
  yb = mul ulong by 32
  for i ulong 32
    put g_last_id i get g_bind_id add yb i
  end
  chk eq eval_txt s_u_p_x 0
end

note ---- Test 4: determinism & precedence ----
fn test_determinism to void
  chk ge lower_fresh_txt s_det_0 0
  save_res_to_a
  chk ge lower_fresh_txt s_det_0 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_det_1 0
  save_res_to_a
  chk ge lower_fresh_txt s_det_1 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_det_2 0
  save_res_to_a
  chk ge lower_fresh_txt s_det_2 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_det_3 0
  save_res_to_a
  chk ge lower_fresh_txt s_det_3 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_det_0 0
  save_res_to_a
  chk ge lower_fresh_txt s_prec_1 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_prec_2 0
  chk not id_eq_a_res
  chk ge lower_fresh_txt s_prec_3 0
  save_res_to_a
  chk ge lower_fresh_txt s_prec_4 0
  chk id_eq_a_res
end

note ---- Test 5: fail closed ----
fn chk_reject s view uchar * want long to void
  no = get g_obj_cnt 0
  nb = get g_bind_cnt 0
  np = get g_prog_cnt 0
  rc = eval_txt s
  chk eq rc want
  ok = eq get g_obj_cnt 0 no
  if ne get g_bind_cnt 0 nb
    ok = false
  end
  if ne get g_prog_cnt 0 np
    ok = false
  end
  chk ok
  chk err_ok
  chk eq get g_res_kind 0 0
end

fn test_fail_closed to void
  session_reset
  chk eq eval_txt s_let_seed 0
  chk_reject r_01 -2
  chk_reject r_02 -2
  chk_reject r_03 -2

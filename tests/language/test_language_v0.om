note ---- test state ----
global g_pass ulong 1
global g_total ulong 1
global g_numbuf uchar 32
global g_line uchar 4096
global g_line_len ulong 1
global g_filebuf uchar 32768
global g_pathbuf uchar 256
global g_id_a uchar 32
global g_id_b uchar 32
global g_id_c uchar 32
global g_hex_enc uchar 8192
global g_hex_id uchar 64
global g_sha_out uchar 32
note result of the last eval / fresh lowering, in the old numbering (1 expression, 2 binding, 3 program)
global g_res_kind ulong 1
global g_res_id uchar 32
global g_res_pidx long 1
global g_res_ttag ulong 1
global g_res_twid ulong 1
global g_res_nlen ulong 1
global g_res_name uchar 64

note ---- I/O helpers ----
fn write_all s view uchar * n ulong to void
  if eq n 0
    ret
  end
  k = write 1 s 0 n
  if lt k 0
    ret
  end
end

fn print_u64 v ulong to void
  if eq v 0
    put g_numbuf 0 uchar 48
    k = write 1 g_numbuf 0 1
    ret
  end
  x = v
  cnt = ulong 0
  while gt x 0 bound 24
    d = rem x 10
    put g_numbuf cnt uchar add d 48
    cnt = add cnt 1
    x = div x 10
  end
  i = ulong 0
  j = sub cnt 1
  while lt i j bound 24
    a = get g_numbuf i
    b = get g_numbuf j
    put g_numbuf i b
    put g_numbuf j a
    i = add i 1
    j = sub j 1
  end
  k = write 1 g_numbuf 0 cnt
end

fn chk ok bool to void
  t = add get g_total 0 1
  put g_total 0 t
  if ok
    put g_pass 0 add get g_pass 0 1
  else
    write_all t_fail_pfx len t_fail_pfx
    print_u64 t
    write_all t_nl len t_nl
  end
end


note ---- adapter over the shipped front end ----
fn session_reset to void
  vs_init
end

fn graph_reset to void
  og_reset
end

fn set_line s view uchar * to void
  n = len s
  for i ulong n bound 2048
    put g_line i get s i
  end
  put g_line_len 0 n
end

note omega_language_eval_line on g_line: the shipped olw_eval_sbuf
fn eval_cur_line to long
  put g_res_kind 0 0
  put g_res_pidx 0 -1
  put g_res_nlen 0 0
  n = get g_line_len 0
  for i ulong n bound 4096
    put v_sbuf i get g_line i
  end
  rc = olw_eval_sbuf n
  if ne rc 0
    ret rc
  end
  k = get olw_rkind 0
  if eq k 1
    put g_res_kind 0 2
  end
  if eq k 2
    put g_res_kind 0 1
  end
  if eq k 3
    put g_res_kind 0 3
  end
  put g_res_pidx 0 get olw_rpidx 0
  put g_res_ttag 0 get olw_rttag 0
  put g_res_twid 0 get olw_rtwid 0
  for i ulong 32
    put g_res_id i get olw_rid i
  end
  if ne k 2
    nl = get opr_nlen 0
    put g_res_nlen 0 nl
    for i ulong nl bound 64
      put g_res_name i get opr_name i
    end
  end
  ret 0
end

fn eval_txt s view uchar * to long
  set_line s
  ret eval_cur_line
end

note lex and parse g_line with the shipped olx_lex_line / opr_parse_line (the front of olw_eval_sbuf)
fn parse_line to long
  put olx_elen 0 0
  m = get g_line_len 0
  if gt m 4096
    m = 4096
  end
  for i ulong m bound 4096
    put olx_line i get g_line i
  end
  put olx_llen 0 m
  rc = olx_lex_line
  if ne rc 0
    ret rc
  end
  ret opr_parse_line
end

fn lower_program to long
  ret olw_lower_program
end

note lower the parsed expression into the (reset) graph: the object index, or a negative rc
fn lower_expr_fresh to long
  et = ulong 0
  ew = ulong 0
  he = false
  if eq get opr_stmt 0 2
    et = get opr_lttag 0
    ew = get opr_ltwid 0
    he = true
  end
  rc = olw_lower_expr ulong get opr_root 0 he et ew
  if ne rc 0
    ret rc
  end
  ret long get olw_lo_oi 0
end

fn lower_fresh_txt s view uchar * to long
  set_line s
  rc = parse_line
  if lt rc 0
    ret rc
  end
  graph_reset
  oi = lower_expr_fresh
  if lt oi 0
    ret oi
  end
  ob = mul ulong oi 32
  for i ulong 32
    put g_res_id i get v_og_id add ob i
  end
  ret oi
end

fn bind_find_txt s view uchar * to long
  n = v_copy_txt_sbuf s
  ret vs_bind_find_sbuf n
end

fn build_type_uint w ulong to long
  ret og_build_type_uint w
end

fn build_val_uint tidx ulong w ulong val ulong to long
  ret og_build_val_uint tidx w val
end

note the id of a CONSTRAINT object carrying `s` as a constraint of kind `kind`, into g_sha_out
fn hct_copy_id idx ulong to void
  ib = mul idx 32
  for i ulong 32
    put g_sha_out i get v_og_id add ib i
  end
end

fn hash_constraint_txt kind ulong s view uchar * to void
  c0 = get v_og_cnt 0
  sc0 = get v_og_scratch 0
  put v_og_scratch 0 1
  si = og_add_object V_KIND_CONSTRAINT
  put v_og_scratch 0 sc0
  if ge si 0
    n = v_copy_txt_sbuf s
    cr = og_add_const_sbuf ulong si kind n
    if ge cr 0
      if ge og_finish ulong si 0
        hct_copy_id ulong si
      end
    end
  end
  put v_og_cnt 0 c0
end

note omega_program_eval of the program just lowered (slot OLW_ACC) on x
fn cp_eval_u64 x ulong to ulong
  if ne vpg_eval OLW_ACC x 0
    ret 0
  end
  ret get vpg_ev 0
end

fn id_eq_a_res to bool
  for i ulong 32
    if ne get g_id_a i get g_res_id i
      ret false
    end
  end
  ret true
end

fn id_eq_a_b to bool
  for i ulong 32
    if ne get g_id_a i get g_id_b i
      ret false
    end
  end
  ret true
end

fn id_eq_b_c to bool
  for i ulong 32
    if ne get g_id_b i get g_id_c i
      ret false
    end
  end
  ret true
end

fn id_eq_a_obj idx ulong to bool
  ob = mul idx 32
  for i ulong 32
    if ne get g_id_a i get v_og_id add ob i
      ret false
    end
  end
  ret true
end

fn save_res_to_a to void
  for i ulong 32
    put g_id_a i get g_res_id i
  end
end

fn save_res_to_b to void
  for i ulong 32
    put g_id_b i get g_res_id i
  end
end

fn save_res_to_c to void
  for i ulong 32
    put g_id_c i get g_res_id i
  end
end

fn err_ok to bool
  n = get olx_elen 0
  if lt n 7
    ret false
  end
  for i ulong 7
    if ne get olx_err i get t_col_pfx i
      ret false
    end
  end
  for i ulong n bound 256
    if eq ulong get olx_err i 10
      ret false
    end
  end
  ret true
end

note ---- Test 1: literal spellings ----
fn test_literal_spellings to void
  chk ge lower_fresh_txt s_7_u64 0
  save_res_to_a
  chk ge lower_fresh_txt s_07_u64 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_0x07_u64 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_0b111_u64 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_p7_u64 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_0x7_sp_u64 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_cmt_7_u64 0
  chk id_eq_a_res
  graph_reset
  ti = build_type_uint 64
  vi = build_val_uint ulong ti 64 7
  chk id_eq_a_obj ulong vi
end

note ---- Test 2: width changes id ----
fn test_width_changes_id to void
  chk ge lower_fresh_txt s_7_u64 0
  save_res_to_a
  chk ge lower_fresh_txt s_7_u32 0
  save_res_to_b
  chk ge lower_fresh_txt s_7_u8 0
  save_res_to_c
  chk not id_eq_a_b
  chk not id_eq_b_c
end

note ---- Test 3: whitespace, comments, and names ----
fn test_whitespace_comments_and_names to void
  session_reset
  chk eq eval_txt s_let_x3 0
  chk and eq get g_res_kind 0 2 and eq get g_res_nlen 0 1 and eq ulong get g_res_name 0 120 eq get g_res_twid 0 64
  chk eq eval_txt s_let_y4 0
  chk eq eval_txt s_xy_0 0
  chk eq get g_res_kind 0 1
  save_res_to_a
  c1 = get v_og_cnt 0
  chk eq eval_txt s_xy_1 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_2 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_3 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_4 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_5 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_6 0
  chk id_eq_a_res
  chk eq eval_txt s_xy_7 0
  chk id_eq_a_res
  chk eq get v_og_cnt 0 c1
  note Check against direct builders
  before = get v_og_cnt 0
  chk eq eval_txt s_let_a7 0
  save_res_to_b
  mid = get v_og_cnt 0
  chk eq eval_txt s_let_b7 0
  save_res_to_c
  chk id_eq_b_c
  chk and eq mid add before 1 eq get v_og_cnt 0 mid
  bi = bind_find_txt t_b
  chk and ge bi 0 eq get v_bind_kind ulong bi 1
  chk eq eval_txt s_let_zxy 0
  chk id_eq_a_res
  chk eq eval_txt s_x_p_1 0
  save_res_to_b
  chk eq eval_txt s_x_p_1u 0
  save_res_to_c
  chk id_eq_b_c
  chk eq eval_txt s_rebind_x 0
  save_res_to_b
  bx = bind_find_txt t_x
  chk ge bx 0
  note Set last = y and test _ + x
  by = bind_find_txt t_y
  yb = mul ulong by 32
  for i ulong 32
    put v_tmp_id i get v_bind_id add yb i
  end
  vs_set_last V_BIND_OBJECT -1
  chk eq eval_txt s_u_p_x 0
end

note ---- Test 4: determinism & precedence ----
fn test_determinism to void
  chk ge lower_fresh_txt s_det_0 0
  save_res_to_a
  chk ge lower_fresh_txt s_det_0 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_det_1 0
  save_res_to_a
  chk ge lower_fresh_txt s_det_1 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_det_2 0
  save_res_to_a
  chk ge lower_fresh_txt s_det_2 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_det_3 0
  save_res_to_a
  chk ge lower_fresh_txt s_det_3 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_det_0 0
  save_res_to_a
  chk ge lower_fresh_txt s_prec_1 0
  chk id_eq_a_res
  chk ge lower_fresh_txt s_prec_2 0
  chk not id_eq_a_res
  chk ge lower_fresh_txt s_prec_3 0
  save_res_to_a
  chk ge lower_fresh_txt s_prec_4 0
  chk id_eq_a_res
end

note ---- Test 5: fail closed ----
fn chk_reject s view uchar * want long to void
  no = get v_og_cnt 0
  nb = get v_bind_cnt 0
  np = get v_prog_cnt 0
  rc = eval_txt s
  chk eq rc want
  ok = eq get v_og_cnt 0 no
  if ne get v_bind_cnt 0 nb
    ok = false
  end
  if ne get v_prog_cnt 0 np
    ok = false
  end
  chk ok
  chk err_ok
  chk eq get g_res_kind 0 0
end

fn test_fail_closed to void
  session_reset
  chk eq eval_txt s_let_seed 0
  chk_reject r_01 -2
  chk_reject r_02 -2

note ---- Test 6: depth and capacity ----
fn build_nested_7 depth ulong to void
  pos = ulong 0
  for i ulong depth bound 64
    put g_line pos uchar 40
    pos = add pos 1
  end
  for i ulong len s_7_u64
    put g_line pos get s_7_u64 i
    pos = add pos 1
  end
  for i ulong depth bound 64
    put g_line pos uchar 41
    pos = add pos 1
  end
  put g_line_len 0 pos
end

fn build_let_v_num n ulong to void
  note "let v: u64 = N"
  put g_line 0 uchar 108
  put g_line 1 uchar 101
  put g_line 2 uchar 116
  put g_line 3 uchar 32
  put g_line 4 uchar 118
  put g_line 5 uchar 58
  put g_line 6 uchar 32
  put g_line 7 uchar 117
  put g_line 8 uchar 54
  put g_line 9 uchar 52
  put g_line 10 uchar 32
  put g_line 11 uchar 61
  put g_line 12 uchar 32
  pos = ulong 13
  if eq n 0
    put g_line pos uchar 48
    pos = add pos 1
  else
    x = n
    cnt = ulong 0
    while gt x 0 bound 16
      put g_numbuf cnt uchar add rem x 10 48
      cnt = add cnt 1
      x = div x 10
    end
    i = cnt
    while gt i 0 bound 16
      i = sub i 1
      put g_line pos get g_numbuf i
      pos = add pos 1
    end
  end
  put g_line_len 0 pos
end

fn test_depth_and_capacity to void
  build_nested_7 40
  chk eq parse_line -3
  build_nested_7 20
  chk eq parse_line 0
  graph_reset
  oi = lower_expr_fresh
  chk ge oi 0
  ob = mul ulong oi 32
  for i ulong 32
    put g_id_a i get v_og_id add ob i
  end
  chk ge lower_fresh_txt s_7_u64 0
  chk id_eq_a_res
  note Too many tokens: (1: u64) + 140 copies of +1
  pos = ulong 0
  put g_line 0 uchar 40
  put g_line 1 uchar 49
  put g_line 2 uchar 58
  put g_line 3 uchar 32
  put g_line 4 uchar 117
  put g_line 5 uchar 54
  put g_line 6 uchar 52
  put g_line 7 uchar 41
  pos = 8
  for i ulong 140
    put g_line pos uchar 43
    put g_line add pos 1 uchar 49
    pos = add pos 2
  end
  put g_line_len 0 pos
  chk eq parse_line -3
  note Graph capacity rollback
  session_reset
  i = ulong 0
  while lt get v_og_cnt 0 254 bound 300
    build_let_v_num i
    if ne eval_cur_line 0
      break
    end
    i = add i 1
  end
  before = get v_og_cnt 0
  chk eq before 254
  chk eq eval_txt s_full_add -3
  chk eq get v_og_cnt 0 before
  chk eq eval_txt s_vv 0
end

note ---- Test 7: programs ----
fn build_fn_fill idx ulong to void
  note "fn fillN(x: u64) -> u64 { x + N }"
  put g_line 0 uchar 102
  put g_line 1 uchar 110
  put g_line 2 uchar 32
  put g_line 3 uchar 102
  put g_line 4 uchar 105
  put g_line 5 uchar 108
  put g_line 6 uchar 108
  pos = ulong 7
  if eq idx 0
    put g_line pos uchar 48
    pos = add pos 1
  else
    x = idx
    cnt = ulong 0
    while gt x 0 bound 8
      put g_numbuf cnt uchar add rem x 10 48
      cnt = add cnt 1
      x = div x 10
    end
    k = cnt
    while gt k 0 bound 8
      k = sub k 1
      put g_line pos get g_numbuf k
      pos = add pos 1
    end
  end
  note "(x: u64) -> u64 { x + "
  put g_line pos uchar 40
  put g_line add pos 1 uchar 120
  put g_line add pos 2 uchar 58
  put g_line add pos 3 uchar 32
  put g_line add pos 4 uchar 117
  put g_line add pos 5 uchar 54
  put g_line add pos 6 uchar 52
  put g_line add pos 7 uchar 41
  put g_line add pos 8 uchar 32
  put g_line add pos 9 uchar 45
  put g_line add pos 10 uchar 62
  put g_line add pos 11 uchar 32
  put g_line add pos 12 uchar 117
  put g_line add pos 13 uchar 54
  put g_line add pos 14 uchar 52
  put g_line add pos 15 uchar 32
  put g_line add pos 16 uchar 123
  put g_line add pos 17 uchar 32
  put g_line add pos 18 uchar 120
  put g_line add pos 19 uchar 32
  put g_line add pos 20 uchar 43
  put g_line add pos 21 uchar 32
  pos = add pos 22
  if eq idx 0
    put g_line pos uchar 48
    pos = add pos 1
  else
    x = idx
    cnt = ulong 0
    while gt x 0 bound 8
      put g_numbuf cnt uchar add rem x 10 48
      cnt = add cnt 1
      x = div x 10
    end
    k = cnt
    while gt k 0 bound 8
      k = sub k 1
      put g_line pos get g_numbuf k
      pos = add pos 1
    end
  end
  put g_line pos uchar 32
  put g_line add pos 1 uchar 125
  put g_line_len 0 add pos 2
end

fn chk_prog_req pidx ulong s view uchar * to bool
  if ne get v_prog_rlen pidx len s
    ret false
  end
  nb = mul pidx 64
  for i ulong len s bound 64
    if ne get v_prog_req add nb i get s i
      ret false
    end
  end
  ret true
end

fn chk_prog_ens pidx ulong s view uchar * to bool
  if ne get v_prog_elen pidx len s
    ret false
  end
  nb = mul pidx 64
  for i ulong len s bound 64
    if ne get v_prog_ens add nb i get s i
      ret false
    end
  end
  ret true
end

fn chk_bad_fn s view uchar * want long to void
  np = get v_prog_cnt 0
  nb = get v_bind_cnt 0
  no = get v_og_cnt 0
  rc = eval_txt s
  chk eq rc want
  ok = eq get v_prog_cnt 0 np
  if ne get v_bind_cnt 0 nb
    ok = false
  end
  if ne get v_og_cnt 0 no
    ok = false
  end
  chk ok
end

fn test_programs to void
  session_reset
  objs = get v_og_cnt 0
  chk eq eval_txt s_fn_tr 0
  chk and eq get g_res_kind 0 3 eq get g_res_pidx 0 0
  chk eq get v_og_cnt 0 objs
  chk eq get v_prog_cnt 0 1
  save_res_to_a
  chk chk_prog_req 0 t_kw_true
  chk chk_prog_ens 0 s_post_res1
  hash_constraint_txt 7 t_kw_true
  pre_ok = true
  for i ulong 32
    if ne get v_prog_preid i get g_sha_out i
      pre_ok = false
    end
  end
  chk pre_ok
  hash_constraint_txt 8 s_post_res1
  post_ok = true
  for i ulong 32
    if ne get v_prog_postid i get g_sha_out i
      post_ok = false
    end
  end
  chk post_ok
  note transform(5) == 11
  chk eq cp_eval_u64 5 11
  note Identity laws
  chk eq eval_txt s_fn_tr1 0
  chk id_eq_a_res
  chk eq eval_txt s_fn_tr2 0
  chk id_eq_a_res
  chk eq eval_txt s_fn_tr3 0
  chk id_eq_a_res
  chk eq eval_txt s_fn_tr4 0
  chk id_eq_a_res
  chk eq eval_txt s_fn_oth 0
  chk and id_eq_a_res eq get g_res_pidx 0 0
  chk eq eval_txt s_fn_ens2 0
  chk not id_eq_a_res
  chk eq get v_prog_cnt 0 2
  chk eq eval_txt s_fn_redef 0
  chk and not id_eq_a_res eq get v_prog_cnt 0 3
  chk eq eval_txt s_fn_mask 0
  pi = ulong get g_res_pidx 0
  chk and chk_prog_req pi t_kw_true chk_prog_ens pi t_kw_true
  chk eq eval_txt s_fn_sub 0
  pi = ulong get g_res_pidx 0
  chk and chk_prog_req pi s_pre_xlt10 chk_prog_ens pi s_post_reseq
  note Bad fn cases
  chk_bad_fn bf_01 -2
  chk_bad_fn bf_02 -2
  chk_bad_fn bf_03 -2
  chk_bad_fn bf_04 -2
  chk_bad_fn bf_05 -2
  chk_bad_fn bf_06 -2
  chk_bad_fn bf_07 -2
  chk_bad_fn bf_08 -2
  chk_bad_fn bf_09 -2
  chk_bad_fn bf_10 -2
  chk_bad_fn bf_11 -2
  chk_bad_fn bf_12 -2
  chk_bad_fn bf_13 -2
  chk_bad_fn bf_14 -2
  chk_bad_fn bf_15 -2
  chk_bad_fn bf_16 -2
  chk_bad_fn bf_17 -2
  chk_bad_fn bf_18 -2
  chk_bad_fn bf_19 -2
  chk_bad_fn bf_20 -2
  chk_bad_fn bf_21 -1
  chk_bad_fn bf_22 -1
  note Fill program table to 16
  i = ulong 0
  while and lt get v_prog_cnt 0 16 lt i 64 bound 64
    build_fn_fill i
    if ne eval_cur_line 0
      break
    end
    i = add i 1
  end
  chk eq get v_prog_cnt 0 16
  chk and eq eval_txt s_fn_fill0 0 ge get g_res_pidx 0 0
  chk eq eval_txt s_fn_more -3
end

note ---- Test 8: Golden vectors from tests/language/golden/v0.txt ----
fn hex_from_obj idx ulong to ulong
  el = ulong og_canonical_encode idx
  for i ulong el bound 1024
    b = ulong get v_enc i
    put g_hex_enc mul i 2 get t_hex shr b 4
    put g_hex_enc add mul i 2 1 get t_hex and b 15
  end
  ib = mul idx 32
  for i ulong 32
    b = ulong get v_og_id add ib i
    put g_hex_id mul i 2 get t_hex shr b 4
    put g_hex_id add mul i 2 1 get t_hex and b 15
  end
  ret mul el 2
end

fn hex_from_cp to ulong
  cl = vro_g OLW_ACC VRO_CLEN
  cb = mul OLW_ACC 4096
  for i ulong cl bound 256
    b = ulong get vro_code add cb i
    put g_hex_enc mul i 2 get t_hex shr b 4
    put g_hex_enc add mul i 2 1 get t_hex and b 15
  end
  pb = vpg_ib OLW_ACC 0
  for i ulong 32
    b = ulong get vpg_ids add pb i
    put g_hex_id mul i 2 get t_hex shr b 4
    put g_hex_id add mul i 2 1 get t_hex and b 15
  end
  ret mul cl 2
end

fn find_tab pos ulong lend ulong to ulong
  p = pos
  while lt p lend bound 2048
    if eq ulong get g_filebuf p 9
      ret p
    end
    p = add p 1
  end
  ret lend
end

fn chk_golden_enc enc_len ulong woff ulong wlen ulong to void
  if ne enc_len wlen
    chk false
    ret
  end
  for i ulong enc_len bound 1024
    if ne get g_hex_enc i get g_filebuf add woff i
      chk false
      ret
    end
  end
  chk true
end

fn chk_golden_id woff ulong wlen ulong to void
  if ne wlen 64
    chk false
    ret
  end
  for i ulong 64
    if ne get g_hex_id i get g_filebuf add woff i
      chk false
      ret
    end
  end
  chk true
end

fn copy_golden_src off ulong slen ulong to void
  for i ulong slen bound 1024
    put g_line i get g_filebuf add off i
  end
  put g_line_len 0 slen
end

fn check_golden_line start ulong lend ulong to bool
  if ge start lend
    ret false
  end
  kch = ulong get g_filebuf start
  if or eq kch 35 eq kch 10
    ret false
  end
  t1 = find_tab start lend
  t2 = find_tab add t1 1 lend
  t3 = find_tab add t2 1 lend
  if ge t3 lend
    chk false
    ret false
  end
  copy_golden_src add t1 1 sub t2 add t1 1
  rc = parse_line
  chk eq rc 0
  if ne rc 0
    ret false
  end
  enc_hex_len = ulong 0
  if eq kch 69
    graph_reset
    oi = lower_expr_fresh
    chk ge oi 0
    if lt oi 0
      ret false
    end
    enc_hex_len = hex_from_obj ulong oi
  else
    lrc = lower_program
    chk eq lrc 0
    if ne lrc 0
      ret false
    end
    enc_hex_len = hex_from_cp
  end
  chk_golden_enc enc_hex_len add t2 1 sub t3 add t2 1
  chk_golden_id add t3 1 sub lend add t3 1
  ret true
end

fn test_golden plen ulong to void
  fd = fopen g_pathbuf 0 plen 0 0
  chk ge fd 0
  if lt fd 0
    ret
  end
  tot = ulong 0
  while lt tot 32768 bound 64
    k = read int fd g_filebuf tot sub 32768 tot
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  u = fclose int fd
  pos = ulong 0
  vec_n = ulong 0
  while lt pos tot bound 256
    lend = pos
    while lt lend tot bound 4096
      if eq ulong get g_filebuf lend 10
        break
      end
      lend = add lend 1
    end
    if check_golden_line pos lend
      vec_n = add vec_n 1
    end
    pos = add lend 1
  end
  chk ge vec_n 20
end

fn main to int
  sha_kinit
  plen = len t_default_golden
  for i ulong plen bound 256
    put g_pathbuf i get t_default_golden i
  end
  ac = argcnt
  if ge ac 2
    ar = argread 1 g_pathbuf 0 255
    if gt ar 0
      plen = ulong ar
    end
  end
  test_literal_spellings
  test_width_changes_id
  test_whitespace_comments_and_names
  test_determinism
  test_fail_closed
  test_depth_and_capacity
  test_programs
  test_golden plen
  p = get g_pass 0
  t = get g_total 0
  if eq p t
    write_all t_pass len t_pass
  else
    write_all t_fail len t_fail
  end
  print_u64 p
  write_all t_slash len t_slash
  print_u64 t
  write_all t_nl len t_nl
  if eq p t
    ret 0
  end
  ret 1
end

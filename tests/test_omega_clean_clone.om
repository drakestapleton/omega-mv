note
note tests/test_omega_clean_clone.om -- standalone pure OM-2 test for src/omega_clean_clone.om

text t_good1 "/tmp/om_w_src8/clean_a-b_c.1+2"
text t_good2 "rel/path_9"
text t_bad_empty ""
text t_bad_empty2 ""
text t_bad_space "/tmp/a b"
text t_bad_semi "/tmp/a;b"
text t_bad_root "/"
text t_bad_rel "tmp/relative"
text t_tree "/tmp/om_w_src8/cc_tree_test"
text t_sub "/tmp/om_w_src8/cc_tree_test/sub"
text t_f1 "/tmp/om_w_src8/cc_tree_test/a.txt"
text t_f2 "/tmp/om_w_src8/cc_tree_test/sub/b.txt"
text t_out "/tmp/om_w_src8/cc_run_out.txt"
text t_echo "/bin/echo"
text t_hello "hello-omega"
text t_true "/bin/true"
text t_false "/bin/false"
text t_pass "PASS test_omega_clean_clone\n"

global t_pkt uchar 256
global t_cap uchar 64
global t_clen ulong 1

fn pkt_init cnt ulong to ulong
  put t_pkt 0 uchar and cnt 255
  put t_pkt 1 uchar and shr cnt 8 255
  ret 2
end

fn pkt_add pos ulong s view uchar * n ulong to ulong
  put t_pkt pos uchar and n 255
  put t_pkt add pos 1 uchar and shr n 8 255
  p = add pos 2
  for i ulong n bound 128
    put t_pkt add p i get s i
  end
  ret add p n
end

fn test_cc_exec to int
  pbuf = new uchar 64 0
  capbuf = new uchar 64 0
  p = pkt_init 1
  p = pkt_add p t_true len t_true
  for i ulong p bound 64
    put pbuf i get t_pkt i
  end
  omega_cc_pkt_set pbuf p
  if ne omega_cc_run t_bad_empty t_bad_empty2 0 0
    ret 15
  end
  p = pkt_init 1
  p = pkt_add p t_false len t_false
  for i ulong p bound 64
    put pbuf i get t_pkt i
  end
  omega_cc_pkt_set pbuf p
  if ne omega_cc_run t_bad_empty t_out 1 1
    ret 16
  end
  ign5 = unlink t_out 0 len t_out

  p = pkt_init 2
  p = pkt_add p t_echo len t_echo
  p = pkt_add p t_hello len t_hello
  for i ulong p bound 64
    put pbuf i get t_pkt i
  end
  omega_cc_pkt_set pbuf p
  got = omega_cc_capture_line t_bad_empty capbuf
  if ne got long len t_hello
    ret 17
  end
  for i ulong len t_hello bound 32
    if ne get capbuf i get t_hello i
      ret 19
    end
  end
  ret 0
end

fn main to int
  note 1. omega_cc_path_is_plain
  if not omega_cc_path_is_plain t_good1 len t_good1
    ret 1
  end
  if not omega_cc_path_is_plain t_good2 len t_good2
    ret 2
  end
  if omega_cc_path_is_plain t_bad_empty 0
    ret 3
  end
  if omega_cc_path_is_plain t_bad_space len t_bad_space
    ret 4
  end
  if omega_cc_path_is_plain t_bad_semi len t_bad_semi
    ret 5
  end

  note 2. omega_cc_remove_tree refusals
  if ne omega_cc_remove_tree t_bad_root len t_bad_root neg long 1
    ret 6
  end
  if ne omega_cc_remove_tree t_bad_rel len t_bad_rel neg long 1
    ret 7
  end
  if ne omega_cc_remove_tree t_bad_space len t_bad_space neg long 1
    ret 8
  end

  note 3. omega_cc_remove_tree real directory tree
  ign0 = omega_cc_remove_tree t_tree len t_tree
  r = makedir t_tree 0 len t_tree 493
  if ne r 0
    ret 9
  end
  r = makedir t_sub 0 len t_sub 493
  if ne r 0
    ret 10
  end
  fd1 = fopen t_f1 0 len t_f1 577 420
  if lt fd1 0
    ret 11
  end
  ign1 = write int fd1 t_hello 0 len t_hello
  ign2 = fclose int fd1
  fd2 = fopen t_f2 0 len t_f2 577 420
  if lt fd2 0
    ret 12
  end
  ign3 = write int fd2 t_hello 0 len t_hello
  ign4 = fclose int fd2
  if ne omega_cc_remove_tree t_tree len t_tree 0
    ret 13
  end
  if ne omega_cc_remove_tree t_tree len t_tree 0
    ret 14
  end

  rc = test_cc_exec
  if ne rc 0
    ret rc
  end

  ign6 = write 1 t_pass 0 len t_pass
  ret 0
end

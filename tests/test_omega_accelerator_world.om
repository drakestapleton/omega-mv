om2
note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit & parity test for src/omega_accelerator_world.om.

text t_aw_pass "PASS test_omega_accelerator_world_om\n"
text t_aw_fail "FAIL test_omega_accelerator_world_om step="

fn t_fail code ulong to int
  b = new uchar 2 0
  ign = write 1 t_aw_fail 0 len t_aw_fail
  put b 0 uchar add 48 rem code 10
  put b 1 10
  ign2 = write 1 b 0 2
  ret 1
end

fn t_check_realize_id code_bytes view uchar 4 to bool
  cdig = new uchar 32 0
  for i ulong 4
    put sh_dat i get code_bytes i
  end
  sh_all 4
  for i ulong 32
    put cdig i get sh_dig i
  end
  for i ulong 32
    put sh_dat i 0
  end
  for i ulong len ow_domain_realize bound 32
    put sh_dat i get ow_domain_realize i
  end
  for i ulong 32
    put sh_dat add 32 i get cdig i
  end
  sh_all 64
  for i ulong 32
    if ne get g_ow_code_realid i get sh_dig i
      ret false
    end
  end
  ret true
end

fn main to int
  rcap = new ulong 1 0
  code_bytes = new uchar 4 0
  z32 = new uchar 32 0
  hc = new ulong 5 0
  ha = new ulong 5 0
  hb = new ulong 5 0
  hd = new ulong 5 0
  comp = new ulong 1 0
  if ne omega_world_init OMEGA_WORLD_OK
    ret t_fail 1
  end
  ep1 = get g_ow_handle_epoch 0
  if eq ep1 0
    ret t_fail 1
  end
  if ne omega_world_discover_ring_capacity rcap OMEGA_WORLD_OK
    ret t_fail 2
  end
  if ne get rcap 0 1024
    ret t_fail 2
  end
  put code_bytes 0 1
  put code_bytes 1 2
  put code_bytes 2 3
  put code_bytes 3 4
  for i ulong 32
    put z32 i 0
  end
  if ne omega_world_register_code code_bytes 4 0 z32 hc OMEGA_WORLD_OK
    ret t_fail 3
  end
  if not t_check_realize_id code_bytes
    ret t_fail 3
  end
  if ne omega_world_register_buffer 256 OMEGA_PERM_READ ha OMEGA_WORLD_OK
    ret t_fail 4
  end
  if ne omega_world_register_buffer 256 OMEGA_PERM_READ hb OMEGA_WORLD_OK
    ret t_fail 4
  end
  if ne omega_world_register_buffer 256 or OMEGA_PERM_READ OMEGA_PERM_WRITE hd OMEGA_WORLD_OK
    ret t_fail 4
  end
  for i ulong 64
    ow_buf_put_u32 get ha 1 i i
    ow_buf_put_u32 get hb 1 i 10
    ow_buf_put_u32 get hd 1 i 0
  end
  if ne omega_world_dispatch_vector hc ha hb hd 64 comp OMEGA_WORLD_OK
    ret t_fail 5
  end
  if or ne ow_buf_get_u32 get hd 1 0 10 ne ow_buf_get_u32 get hd 1 63 73
    ret t_fail 5
  end
  if or ne get g_ow_seq_num 0 1 ne get g_ow_total_dispatches 0 1
    ret t_fail 5
  end
  for r ulong 4
    for c ulong 4
      idx = add mul r 4 c
      ow_buf_put_u32 get ha 1 idx 3
      if eq r c
        ow_buf_put_u32 get hb 1 idx 4
      else
        ow_buf_put_u32 get hb 1 idx 0
      end
      ow_buf_put_u32 get hd 1 idx 0
    end
  end
  omega_world_set_matmul_spec 4 4 4 OMEGA_MATMUL_PREC_INT32
  if ne omega_world_dispatch_matmul hc ha hb hd comp OMEGA_WORLD_OK
    ret t_fail 6
  end
  if or ne ow_buf_get_u32 get hd 1 0 12 ne ow_buf_get_u32 get hd 1 15 12
    ret t_fail 6
  end
  if ne omega_world_rebuild OMEGA_WORLD_OK
    ret t_fail 7
  end
  if or ne get g_ow_cur_epoch 0 2 eq get g_ow_handle_epoch 0 ep1
    ret t_fail 7
  end
  if ne omega_world_validate_handle ha OMEGA_OBJ_BUFFER OMEGA_PERM_READ OMEGA_WORLD_ERR_STALE_EPOCH
    ret t_fail 7
  end
  if ne omega_world_revoke_code hc OMEGA_WORLD_ERR_STALE_EPOCH
    ret t_fail 7
  end
  if ne omega_world_destroy OMEGA_WORLD_OK
    ret t_fail 8
  end
  ign = write 1 t_aw_pass 0 len t_aw_pass
  ret 0
end

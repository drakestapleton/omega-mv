note SPDX-License-Identifier: Apache-2.0
note tests/test_gb10_api_2_mm_host.om: CPU-only host unit, contract, codegen wiring,
note param-packing, QMD invariant, and fail-closed negative-control suite for
note   src/omega_gpu_matmul_api.om
note   src/omega_gpu_moe_api.om
note Strictly CPU-only: ZERO /dev/nvidia* access.
om2

text gapi2_mm_pass "PASS test-gb10-api-2-mm-host (matmul + moe CPU-only QMD+codegen+contract)\n"
text gapi2_mm_fail "FAIL test-gb10-api-2-mm-host code="
text gapi2_mm_nl "\n"

fn gapi2_mm_print s view uchar * to void
  r = write 1 s 0 len s
end

fn gapi2_mm_print_u x ulong to void
  b = new uchar 24 0
  pos = ulong 24
  v = x
  while true
    pos = sub pos 1
    put b pos uchar add 48 rem v 10
    v = div v 10
    if eq v 0
      r = write 1 b pos sub 24 pos
      ret
    end
  end
end

fn test_mm_a to ulong
  mm_api_init
  nb = new uchar 32 0
  if ne mm_api_rc_name MM_API_OK nb 2
    ret 70
  end
  if ne mm_api_rc_name MM_API_PARITY_FAIL nb 11
    ret 71
  end
  if ne mm_api_cta_budget MM_API_MAX_CTAS
    ret 72
  end
  mm_api_set_cta_budget 64
  if ne mm_api_cta_budget 64
    ret 73
  end
  mm_api_set_cta_budget 0
  if ne mm_api_reserve 0 64 64 0 8 MM_API_BAD_ARGS
    ret 74
  end
  if ne mm_api_reserve 128 64 64 0 16 MM_API_OK
    ret 75
  end
  if ne mm_api_prepare 1 64 64 MM_API_OK
    ret 76
  end
  mm_api_seal 1
  ret 0
end

fn test_mm_b to ulong
  tid = new ulong 1 0
  if ne mm_api_tensor_upload_bf16 64 64 tid MM_API_OK
    ret 77
  end
  t = get tid 0
  kn = new uint 2 0
  mm_api_tensor_shape t kn
  if or ne get kn 0 64 ne get kn 1 64
    ret 78
  end
  info = new ulong 12 0
  cb = new uint 10 0
  qmd = new uint 96 0
  if ne mm_api_resident_bf16 1 t info cb qmd MM_API_OK
    ret 79
  end
  if ne get info 10 1
    ret 80
  end
  if ne mm_api_resident_f32 1 t info cb qmd MM_API_OK
    ret 81
  end
  if ne mm_api_test_a_row0_hits 1
    ret 82
  end
  if ne mm_api_resident_bf16 128 t info cb qmd MM_API_TOO_LARGE
    ret 83
  end
  if ne mm_api_tensor_update_bf16 t 32 64 MM_API_BAD_ARGS
    ret 84
  end
  if ne mm_api_tensor_update_f32 t 64 64 MM_API_OK
    ret 85
  end
  mm_api_test_set_blocked 1
  if ne mm_api_is_blocked 1
    ret 86
  end
  if ne mm_api_tensor_update_bf16 t 64 64 MM_API_CHIP_FAIL
    ret 87
  end
  mm_api_test_set_blocked 0
  mm_api_tensor_free t
  ret 0
end

fn test_mm_c to ulong
  mm_api_seal 0
  mm_api_unreserve
  dims = new uint 3 0
  put dims 0 16
  put dims 1 64
  put dims 2 64
  info = new ulong 12 0
  cb = new uint 10 0
  qmd = new uint 96 0
  if ne mm_api_matmul_f32 dims info cb qmd MM_API_OK
    ret 88
  end
  st = new ulong 8 0
  mm_api_last_stages st
  if eq get st 7 0
    ret 89
  end
  mm_api_set_oracle 0
  mm_api_test_set_unroll 2
  mm_api_test_set_unroll 0
  mm_api_test_set_mutant 1
  mm_api_test_set_mutant 0
  mm_api_device_close
  ret 0
end

fn test_moe_a to ulong
  moe_api_init
  if ne moe_api_window_byte_offset 2048 16 65536
    ret 90
  end
  if ne moe_api_cta_budget MM_API_MAX_CTAS
    ret 91
  end
  moe_api_set_cta_budget 128
  if ne moe_api_cta_budget 128
    ret 92
  end
  moe_api_set_cta_budget 0
  if ne moe_api_reserve 64 64 32 16 MM_API_OK
    ret 93
  end
  if ne moe_api_prepare 1 64 32 MM_API_OK
    ret 94
  end
  moe_api_seal 1
  ret 0
end

fn test_moe_b to ulong
  tid = new ulong 1 0
  if ne moe_api_tensor_upload_f32 64 128 tid MM_API_OK
    ret 95
  end
  t = get tid 0
  kn = new uint 2 0
  moe_api_tensor_shape t kn
  if or ne get kn 0 64 ne get kn 1 128
    ret 96
  end
  info = new ulong 12 0
  qmd = new uint 96 0
  req = new ulong 4 0
  put req 0 1
  put req 1 t
  put req 2 16
  put req 3 32
  if ne moe_api_resident_window_f32 req info qmd MM_API_OK
    ret 97
  end
  if ne get info 10 1
    ret 98
  end
  put req 2 32
  if ne moe_api_resident_window_bf16 req info qmd MM_API_OK
    ret 99
  end
  if ne moe_api_test_a_row0_hits 1
    ret 100
  end
  c0s = new uint 3 0
  put c0s 0 0
  put c0s 1 32
  put c0s 2 64
  put req 2 3
  if ne moe_api_resident_windows_f32 req c0s info qmd MM_API_OK
    ret 101
  end
  if ne get info 9 3
    ret 102
  end
  put req 2 4
  if ne moe_api_resident_window_f32 req info qmd MM_API_BAD_ARGS
    ret 103
  end
  put req 2 112
  if ne moe_api_resident_window_f32 req info qmd MM_API_BAD_ARGS
    ret 104
  end
  put req 2 65
  if ne moe_api_resident_windows_f32 req c0s info qmd MM_API_BAD_ARGS
    ret 105
  end
  moe_api_test_set_window_skew 1
  moe_api_test_set_window_skew 0
  moe_api_test_set_mutant 1
  moe_api_test_set_mutant 0
  moe_api_seal 0
  moe_api_unreserve
  moe_api_tensor_free t
  moe_api_cache_clear
  ret 0
end

fn main to int
  rc = test_mm_a
  if ne rc 0
    gapi2_mm_print gapi2_mm_fail
    gapi2_mm_print_u rc
    gapi2_mm_print gapi2_mm_nl
    ret int rc
  end
  rc = test_mm_b
  if ne rc 0
    gapi2_mm_print gapi2_mm_fail
    gapi2_mm_print_u rc
    gapi2_mm_print gapi2_mm_nl
    ret int rc
  end
  rc = test_mm_c
  if ne rc 0
    gapi2_mm_print gapi2_mm_fail
    gapi2_mm_print_u rc
    gapi2_mm_print gapi2_mm_nl
    ret int rc
  end
  rc = test_moe_a
  if ne rc 0
    gapi2_mm_print gapi2_mm_fail
    gapi2_mm_print_u rc
    gapi2_mm_print gapi2_mm_nl
    ret int rc
  end
  rc = test_moe_b
  if ne rc 0
    gapi2_mm_print gapi2_mm_fail
    gapi2_mm_print_u rc
    gapi2_mm_print gapi2_mm_nl
    ret int rc
  end
  gapi2_mm_print gapi2_mm_pass
  ret 0
end

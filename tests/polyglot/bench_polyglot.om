note
note tests/polyglot/bench_polyglot.om -- pure seeded OM-2 POLYGLOT-0 benchmark harness:
note   --selftest : verifies in-place x^=1 flip checksum prediction across all 5
note                candidates + deliberately memoising control (must be caught),
note                code-size accounting, and x-state oracle consistency (no timing).
note   --spec F --out DIR [--manifest M] [--samples N] [--sparsity 0,0.33,0.66]
note                      [--workloads S1,S2,S3,S4] [--cpu C] [--smoke]
note                honors all CLI flags, pins CPU via cpuset when --cpu is given,
note                parses manifest TSV when --manifest is given, queries actual
note                git dirty status & HEAD commit via fork+pipefds+execprog, and
note                writes OMEGA_POLYGLOT0_RECEIPT_V1 JSON receipts.

const BP_NC ulong 5
const BP_NW ulong 4
const BP_NSP ulong 3

global g_bp_arg uchar 512
global g_bp_spec uchar 512
global g_bp_out uchar 512
global g_bp_man_path uchar 512
note g_bp_cfg: [0]=selftest [1]=smoke [2]=samples [3]=spec_len [4]=out_len [5]=rng
note           [6]=man_len [7]=cpu_set [8]=cpu_id [9]=dirty_valid [10]=dirty_cnt [11]=commit_len
global g_bp_cfg ulong 16
global g_bp_wsel ulong 4
global g_bp_spsel ulong 4
global g_bp_spval f64 4
global g_bp_wm ulong 4
global g_bp_wn ulong 4
global g_bp_wnx ulong 4

note Git & env capture buffers
global g_bp_commit uchar 64
global g_bp_runid uchar 96
global g_bp_runid_len ulong 2
global g_bp_cmdbuf uchar 4096
global g_bp_pkt uchar 512
global g_bp_env uchar 256

note Parsed manifest entries (up to 32 rows)
global g_bp_nman ulong 2
global g_bp_msrc uchar 8192
global g_bp_msrc_l ulong 32
global g_bp_mobj uchar 8192
global g_bp_mobj_l ulong 32
global g_bp_mcmd uchar 8192
global g_bp_mcmd_l ulong 32
global g_bp_msha uchar 64
global g_bp_mtext long 2

note X-mutation state
global g_bp_x byte 1048576
global g_bp_colsum long 65536
global g_bp_pos ulong 65536
global g_bp_dot long 1024
note g_bp_xs: [0]=n [1]=nx [2]=npos [3]=tick [4]=m
global g_bp_xs ulong 8

note memoising control cache
global g_bp_mx16 byte 16
global g_bp_my int 64
global g_bp_mvalid ulong 2

note Per-cell timing results (up to 3 sparsities for current candidate x workload)
global g_bp_cmin f64 4
global g_bp_cmed f64 4
global g_bp_cmad f64 4
global g_bp_cpmed f64 4
global g_bp_cchk ulong 4
global g_bp_cfail ulong 4
global g_bp_csk ulong 4
global g_bp_creps ulong 4
global g_bp_cpres ulong 4
global g_bp_contract uchar 64
global g_bp_path uchar 768


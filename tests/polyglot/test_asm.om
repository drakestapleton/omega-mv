note
note tests/polyglot/test_asm.om -- pure seeded OM-2 POLYGLOT-0 lane B1 correctness gate
note (asm_sdot, asm_crumb): loads/verifies actual AArch64 machine code from
note src/polyglot/asm/omx_{sdot,crumb}.S (when .text.bin paths are passed) or
note omx_encoder_build, audits every instruction word and callee-saved ABI
note (x19..x28, d8..d15), runs negative bit-mutation differential checks, and
note executes the AArch64 machine code via omx_vm_exec across error contract,
note MA-3 shape grid, random unaligned+canary+guard cases, and large magnitudes
note up to OMX_MAX_N (16,777,215).

global g_ta_st ulong 8
note [0]=checks [1]=fail [2]=cases [3]=rng [4]=mut_caught [5]=gnu_matched
global g_ta_arg uchar 512
global g_ta_ns ulong 31
global g_ta_ms ulong 10
global g_ta_sps f64 5
global g_ta_bad byte 5

text t_ta_hdr "POLYGLOT test-asm "
text t_ta_pass "PASS"
text t_ta_fail "FAIL"
text t_ta_sep1 ": "
text t_ta_chk " checks, "
text t_ta_fls " failures; 2 candidates (AArch64 machine-code exec + ABI/guard); cases: grid "
text t_ta_rnd ", random "
text t_ta_lrg ", large "
text t_ta_mut "; mut-caught "
text t_ta_gnu ", gnu-as-words "
text t_ta_err "; error-contract checks "
text t_ta_efail "FAIL test_asm check #"

fn ta_init_tables to void
  for i ulong 8
    put g_ta_st i 0
  end
  put g_ta_st 3 0x504f4c5941534d31

  put g_ta_ns 0 1
  put g_ta_ns 1 2
  put g_ta_ns 2 3
  put g_ta_ns 3 4
  put g_ta_ns 4 5
  put g_ta_ns 5 7
  put g_ta_ns 6 15
  put g_ta_ns 7 16
  put g_ta_ns 8 17
  put g_ta_ns 9 31
  put g_ta_ns 10 32
  put g_ta_ns 11 33
  put g_ta_ns 12 63
  put g_ta_ns 13 64
  put g_ta_ns 14 65
  put g_ta_ns 15 79
  put g_ta_ns 16 80
  put g_ta_ns 17 81
  put g_ta_ns 18 127
  put g_ta_ns 19 128
  put g_ta_ns 20 129
  put g_ta_ns 21 159
  put g_ta_ns 22 160
  put g_ta_ns 23 161
  put g_ta_ns 24 255
  put g_ta_ns 25 256
  put g_ta_ns 26 257
  put g_ta_ns 27 1000
  put g_ta_ns 28 1023
  put g_ta_ns 29 1024
  put g_ta_ns 30 1025

  put g_ta_ms 0 1
  put g_ta_ms 1 2
  put g_ta_ms 2 3
  put g_ta_ms 3 4
  put g_ta_ms 4 5
  put g_ta_ms 5 7
  put g_ta_ms 6 15
  put g_ta_ms 7 16
  put g_ta_ms 8 17
  put g_ta_ms 9 33

  put g_ta_sps 0 0.0f64
  put g_ta_sps 1 0.3f64
  put g_ta_sps 2 0.6f64
  put g_ta_sps 3 0.9f64
  put g_ta_sps 4 1.0f64

  put g_ta_bad 0 byte 2
  put g_ta_bad 1 byte -2
  put g_ta_bad 2 byte -128
  put g_ta_bad 3 byte 127
  put g_ta_bad 4 byte 3
end

fn ta_rnd to ulong
  st = new ulong 1 0
  put st 0 get g_ta_st 3
  v = omx_rng_next st
  put g_ta_st 3 get st 0
  ret v
end

fn ta_rnd01 to f64
  st = new ulong 1 0
  put st 0 get g_ta_st 3
  v = omx_rng_01 st
  put g_ta_st 3 get st 0
  ret v
end

fn ta_chk cond bool to void
  c = add get g_ta_st 0 1
  put g_ta_st 0 c
  if not cond
    f = add get g_ta_st 1 1
    put g_ta_st 1 f
    if le f 20
      omx_eputs t_ta_efail
      omx_eputu c
      omx_enl
    end
  end
end

note Verify GNU as .text.bin matches emitted object form, then load final form into VM.
fn ta_verify_gnu_bin k ulong argi ulong to void
  alen = argread argi g_ta_arg 0 512
  ta_chk gt alen 0
  if le alen 0
    ret
  end
  ta_chk eq omx_encoder_build k 0 0
  n = get g_enc_st 0
  fd = fopen g_ta_arg 0 ulong alen 0 0
  ta_chk ge fd 0
  if lt fd 0
    ret
  end
  tot = ulong 0
  while lt tot 262144 bound 262144
    r = read int fd g_omx_fbuf tot sub 262144 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  _c = fclose int fd
  ta_chk eq tot mul 4 n
  same = ulong 0
  diff = ulong 0
  for i ulong n bound 512
    if le add mul 4 i 4 tot
      g = uint omx_u32_le_fbuf mul 4 i
      e = get g_enc_word i
      if eq g e
        same = add same 1
      else
        diff = add diff 1
      end
    end
  end
  ta_chk eq diff 0
  put g_ta_st 5 add get g_ta_st 5 same
end

note Negative differential checks: mutating emitted machine code MUST fail audit/ABI/exec!
fn ta_test_mutations to void
  for i ulong 64
    put g_omx_w i byte 1
    put g_omx_x i byte 2
  end
  ta_chk eq omx_oracle 1 64 0 OMX_OK

  note 1. Corrupt opcode bit (bit 28) in sdot -> audit & exec must reject
  ta_chk eq omx_pack_sdot 1 64 1 OMX_OK
  orig0 = get g_vm_c0 10
  put g_vm_c0 10 xor orig0 uint 0x10000000
  ta_chk ne omx_vm_audit_kernel OMX_ENC_SDOT 0
  rc_bad = omx_vm_exec OMX_ENC_SDOT 7 0 0
  ta_chk ne rc_bad 0
  put g_vm_c0 10 orig0
  put g_ta_st 4 add get g_ta_st 4 1

  note 2. Clobber callee-saved x19 in sdot -> audit returns -2 & exec returns -104 (ABI)
  orig1 = get g_vm_c0 11
  clob = uint omx_a64_movz 1 19 42
  put g_vm_c0 11 clob
  ta_chk eq omx_vm_audit_word ulong clob -2
  rc_abi = omx_vm_exec OMX_ENC_SDOT 7 0 0
  ta_chk eq rc_abi -104
  put g_vm_c0 11 orig1
  put g_ta_st 4 add get g_ta_st 4 1

  note 3. Functional mutation in crumb (change movz w0, #0 at ok exit to movz w0, #7) -> exec returns 7 != 0
  ta_chk eq omx_pack_crumb 1 64 1 OMX_OK
  nc1 = get g_vm_meta 3
  ok_idx = sub nc1 4
  orig2 = get g_vm_c1 ok_idx
  put g_vm_c1 ok_idx uint omx_a64_movz 0 0 7
  rc_mut = omx_vm_exec OMX_ENC_CRUMB 7 0 0
  ta_chk eq rc_mut 7
  put g_vm_c1 ok_idx orig2
  put g_ta_st 4 add get g_ta_st 4 1

  note 4. Verify clean kernels pass after restoration
  ta_chk eq omx_vm_audit_kernel OMX_ENC_SDOT 0
  ta_chk eq omx_vm_audit_kernel OMX_ENC_CRUMB 0
  ta_chk eq omx_vm_exec OMX_ENC_CRUMB 7 0 0 OMX_OK
  ta_chk eq get g_omx_y 0 get g_omx_yref 0
  omx_plan_zero
end

note wk: 0=random 1=zero 2=pos 3=neg
fn ta_fill_w cnt ulong wk ulong sp f64 to void
  for i ulong cnt bound 16777216
    if eq wk 1
      put g_omx_w i byte 0
    else
      if eq wk 2
        put g_omx_w i byte 1
      else
        if eq wk 3
          put g_omx_w i byte -1
        else
          if lt ta_rnd01 sp
            put g_omx_w i byte 0
          else
            if eq and ta_rnd 1 1
              put g_omx_w i byte 1
            else
              put g_omx_w i byte -1
            end
          end
        end
      end
    end
  end
end

note xk: 0=random 1=min(-128) 2=max(127) 3=alt 4=zero
fn ta_fill_x xoff ulong n ulong xk ulong to void
  for j ulong n bound 16777216
    if eq xk 1
      put g_omx_x add xoff j byte -128
    else
      if eq xk 2
        put g_omx_x add xoff j byte 127
      else
        if eq xk 3
          if eq and j 1 1
            put g_omx_x add xoff j byte 127
          else
            put g_omx_x add xoff j byte -128
          end
        else
          if eq xk 4
            put g_omx_x add xoff j byte 0
          else
            u = and ta_rnd 255
            if ge u 128
              put g_omx_x add xoff j byte sub long u 256
            else
              put g_omx_x add xoff j byte long u
            end
          end
        end
      end
    end
  end
end

fn ta_run_rep kind ulong m ulong xoff ulong yoff ulong to void
  for i ulong m bound 65536
    put g_omx_y add yoff i int 0x5a5a5a5a
  end
  ta_chk eq omx_vm_run_cand kind xoff yoff 1 1 OMX_OK
  bad = ulong 0
  for i ulong m bound 65536
    if ne get g_omx_y add yoff i get g_omx_yref i
      bad = add bad 1
    end
  end
  ta_chk eq bad 0
end

fn ta_check_impl kind ulong m ulong n ulong xoff ulong yoff ulong to void
  rc = omx_pack_cand kind m n 1
  ta_chk eq rc OMX_OK
  if ne rc OMX_OK
    omx_plan_zero
    ret
  end
  ta_chk and gt get g_omx_plan 2 0 ge get g_omx_plan 3 get g_omx_plan 2
  ta_run_rep kind m xoff yoff
  ta_run_rep kind m xoff yoff
  omx_plan_zero
  put g_ta_st 2 add get g_ta_st 2 1
end

fn ta_run_case m ulong n ulong wk ulong sp f64 xk ulong to void
  ta_fill_w mul m n wk sp
  ta_fill_x 0 n xk
  ta_chk eq omx_oracle m n 0 OMX_OK
  ta_check_impl OMX_CAND_SDOT m n 0 0
  ta_check_impl OMX_CAND_CRUMB m n 0 0
end

fn ta_check_spill ybase ulong yend ulong ytot ulong to void
  spill = ulong 0
  for i ulong ybase bound 65536
    if ne get g_omx_y i int -1515870811
      spill = add spill 1
    end
  end
  i = yend
  while lt i ytot bound 65536
    if ne get g_omx_y i int -1515870811
      spill = add spill 1
    end
    i = add i 1
  end
  ta_chk eq spill 0
end

fn ta_run_random m ulong n ulong sp f64 xk ulong xo ulong yo ulong to void
  ta_fill_w mul m n 0 sp
  ta_fill_x xo n xk
  ta_chk eq omx_oracle m n xo OMX_OK
  ybase = add 16 yo
  yend = add ybase m
  ytot = add m 48
  for c ulong 2
    kind = OMX_CAND_SDOT
    if eq c 1
      kind = OMX_CAND_CRUMB
    end
    for i ulong ytot bound 65536
      put g_omx_y i int -1515870811
    end
    ta_check_impl kind m n xo ybase
    ta_check_spill ybase yend ytot
  end
end

fn ta_test_errors to void
  put g_omx_w 0 byte 1
  put g_omx_w 1 byte 0
  put g_omx_w 2 byte -1
  put g_omx_w 3 byte 1
  put g_omx_w 4 byte 0
  put g_omx_w 5 byte 1
  put g_omx_x 0 byte 1
  put g_omx_x 1 byte 2
  put g_omx_x 2 byte 3
  for c ulong 2
    kind = OMX_CAND_SDOT
    k = OMX_ENC_SDOT
    if eq c 1
      kind = OMX_CAND_CRUMB
      k = OMX_ENC_CRUMB
    end
    for b ulong 5
      put g_omx_w 3 get g_ta_bad b
      put g_omx_plan 5 77
      ta_chk eq omx_pack_cand kind 2 3 1 OMX_E_TRIT
      ta_chk eq omx_plan_is_zero 1
    end
    put g_omx_w 3 byte 1
    put g_omx_plan 5 77
    ta_chk eq omx_pack_cand kind 0 3 1 OMX_E_ARG
    ta_chk eq omx_plan_is_zero 1
    ta_chk eq omx_pack_cand kind 2 0 1 OMX_E_ARG
    ta_chk eq omx_pack_cand kind 2 3 0 OMX_E_ARG
    ta_chk eq omx_plan_is_zero 1
    ta_chk eq omx_pack_cand kind 1 add OMX_MAX_N 1 1 OMX_E_ARG
    ta_chk eq omx_pack_cand kind 1 OMX_ULONG_MAX 1 OMX_E_ARG
    ta_chk eq omx_pack_cand kind div OMX_ULONG_MAX 2 1000 1 OMX_E_OVERFLOW
    ta_chk eq omx_plan_is_zero 1
    omx_plan_zero
    note Real AArch64 machine-code null/empty plan checks (cbz x0/x1/x2/x3/x4/x5)
    ta_chk eq omx_vm_exec k 7 0 0 OMX_E_ARG
    ta_chk eq omx_vm_exec k 6 0 0 OMX_E_ARG
    ta_chk eq omx_pack_cand kind 2 3 1 OMX_OK
    ta_chk eq omx_vm_exec k 5 0 0 OMX_E_ARG
    ta_chk eq omx_vm_exec k 3 0 0 OMX_E_ARG
    put g_omx_plan 0 0
    ta_chk eq omx_vm_exec k 7 0 0 OMX_E_ARG
    put g_omx_plan 0 2
    put g_omx_plan 1 0
    ta_chk eq omx_vm_exec k 7 0 0 OMX_E_ARG
    put g_omx_plan 1 3
    ta_chk eq omx_vm_exec k 7 0 0 OMX_OK
    ta_chk eq get g_omx_y 0 int -2
    ta_chk eq get g_omx_y 1 int 4
    omx_plan_zero
  end
end

fn main to int
  ta_init_tables
  if eq argcnt 3
    ta_verify_gnu_bin OMX_ENC_SDOT 1
    ta_verify_gnu_bin OMX_ENC_CRUMB 2
  end
  ta_chk eq omx_vm_load_kernel OMX_ENC_SDOT 0
  ta_chk eq omx_vm_load_kernel OMX_ENC_CRUMB 0
  ta_test_mutations
  ta_test_errors
  c0 = get g_ta_st 0

  note 1. MA-3 shape grid executed on actual AArch64 machine code
  for a ulong 31
    nv = get g_ta_ns a
    for b ulong 10
      mv = get g_ta_ms b
      ta_run_case mv nv 1 0.0f64 0
      ta_run_case mv nv 2 0.0f64 1
      ta_run_case mv nv 2 0.0f64 2
      ta_run_case mv nv 3 0.0f64 1
      ta_run_case mv nv 3 0.0f64 2
      ta_run_case mv nv 0 get g_ta_sps rem add a b 5 3
      ta_run_case mv nv 0 get g_ta_sps rem add mul a 3 b 5 0
    end
  end
  grid_cases = get g_ta_st 2

  note 2. random cases with unaligned offsets, guard bounds & y canaries
  for it ulong 500 bound 500
    n = add 1 rem ta_rnd 2100
    m = add 1 rem ta_rnd 70
    xk = ulong 0
    if eq rem ta_rnd 4 0
      xk = rem ta_rnd 5
    end
    xo = add 1 rem ta_rnd 15
    yo = add 1 rem ta_rnd 15
    ta_run_random m n ta_rnd01 xk xo yo
  end
  random_cases = sub get g_ta_st 2 grid_cases

  note 3. large magnitudes up to OMX_MAX_N
  ta_run_case 5 16384 3 0.0f64 1
  ta_run_case 5 16384 2 0.0f64 1
  ta_run_case 1 100003 3 0.0f64 1
  ta_run_case 6 1048613 0 0.3f64 0
  ta_run_case 17 4099 0 0.97f64 0
  ta_run_case 1 OMX_MAX_N 3 0.0f64 1
  ta_run_case 1 OMX_MAX_N 2 0.0f64 1
  ta_run_case 1 OMX_MAX_N 0 0.5f64 3
  large_cases = sub sub get g_ta_st 2 grid_cases random_cases

  omx_puts t_ta_hdr
  if eq get g_ta_st 1 0
    omx_puts t_ta_pass
  else
    omx_puts t_ta_fail
  end
  omx_puts t_ta_sep1
  omx_putu get g_ta_st 0
  omx_puts t_ta_chk
  omx_putu get g_ta_st 1
  omx_puts t_ta_fls
  omx_putu grid_cases
  omx_puts t_ta_rnd
  omx_putu random_cases
  omx_puts t_ta_lrg
  omx_putu large_cases
  omx_puts t_ta_mut
  omx_putu get g_ta_st 4
  omx_puts t_ta_gnu
  omx_putu get g_ta_st 5
  omx_puts t_ta_err
  omx_putu c0
  omx_nl
  if ne get g_ta_st 1 0
    ret 1
  end
  ret 0
end

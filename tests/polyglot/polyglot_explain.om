note
note tests/polyglot/polyglot_explain.om -- pure seeded OM-2 POLYGLOT-0 deterministic
note receipt explainer (spec/polyglot-0.md section 9).
note Supports both:
note   polyglot_explain --spec spec/polyglot-0.md --receipts DIR [--run RUN_ID]
note   polyglot_explain --run <receipt.json | receipts_dir> [--spec spec/polyglot-0.md]
note Implements the full JSON parser and selection/analysis logic from
note polyglot_explain.c: contract verification, current-run resolution, 11-rule
note eligibility filtering, lowest-median selection, runner-up margin vs
note max(3 * max(MAD/median), 5% RUN_FLOOR) CHOSEN/TIE verdict, pack cost &
note break-even calls, per-language summary, and rejection reasons.

const PE_MAX_REC ulong 128
const PE_MAX_CELLS ulong 4

global g_pe_arg uchar 512
global g_pe_spec uchar 512
global g_pe_dir uchar 512
global g_pe_run uchar 512
global g_pe_contract uchar 64
note g_pe_cfg: [0]=spec_len [1]=dir_len [2]=run_len [3]=nfiles [4]=nrec [5]=nign
note           [6]=nstale [7]=nsmoke [8]=nnotgate [9]=cur_valid [10]=nruns [11]=nfull
global g_pe_cfg ulong 16
global g_pe_cur uchar 128
global g_pe_cur_l ulong 2

global g_pe_dbuf uchar 65536
global g_pe_names uchar 32768
global g_pe_nlens ulong 256
global g_pe_order ulong 256

note Parsed receipt records (up to 128)
global g_pe_rid uchar 8192
global g_pe_rid_l ulong 128
global g_pe_lang uchar 4096
global g_pe_lang_l ulong 128
global g_pe_fam uchar 4096
global g_pe_fam_l ulong 128
global g_pe_runid uchar 16384
global g_pe_runid_l ulong 128
global g_pe_ct uchar 8192
global g_pe_ct_l ulong 128
global g_pe_wid uchar 1024
global g_pe_wid_l ulong 128
global g_pe_reg uchar 12288
global g_pe_reg_l ulong 128
note g_pe_rflags: bit0=weak bit1=derived bit2=tonly bit3=smoke bit4=gate_ok
global g_pe_rflags ulong 128
global g_pe_rdirty long 128
global g_pe_rm ulong 128
global g_pe_rn ulong 128
global g_pe_rnc ulong 128

note Parsed cells (rec * 4 + cell_idx, total 512)
global g_pe_csp f64 512
global g_pe_cmed f64 512
global g_pe_cmad f64 512
global g_pe_cmin f64 512
global g_pe_cpmed f64 512
global g_pe_cppw f64 512
global g_pe_cchk ulong 512
global g_pe_cfail ulong 512
global g_pe_csk long 512
global g_pe_cmeas ulong 512
global g_pe_coklat ulong 512

note Unique runs (up to 64) & unique workloads (up to 16)
global g_pe_runs uchar 8192
global g_pe_runs_l ulong 64
global g_pe_wids uchar 128
global g_pe_wids_l ulong 16
global g_pe_nw ulong 2
global g_pe_sps f64 8

note Selection entries for current (workload, sparsity)
global g_pe_erec ulong 128
global g_pe_ecell ulong 128
global g_pe_eelig ulong 128
global g_pe_ewhy ulong 128
global g_pe_eord ulong 128
global g_pe_seen_l uchar 512
global g_pe_seen_ll ulong 16

note JSON scratch
global g_pe_tmp uchar 128

text t_pe_sp_flag "--spec"
text t_pe_rc_flag "--receipts"
text t_pe_rn_flag "--run"
text t_pe_def_spec "spec/polyglot-0.md"
text t_pe_usage "usage: polyglot_explain --spec spec/polyglot-0.md --receipts DIR [--run RUN_ID] | --run PATH\n"
text t_pe_err_spec "polyglot_explain: cannot read contract section 1\n"
text t_pe_err_run "polyglot_explain: cannot read or parse --run target\n"
text t_pe_err_dir "polyglot_explain: cannot open receipts directory\n"
text t_pe_schema "OMEGA_POLYGLOT0_RECEIPT_V1"

text t_pe_k_schema "schema"
text t_pe_k_cand "candidate"
text t_pe_k_wl "workload"
text t_pe_k_run "run"

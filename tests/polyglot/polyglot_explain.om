text t_pe_k_cells "cells"
text t_pe_k_id "id"
text t_pe_k_lang "language"
text t_pe_k_rep "representation"
text t_pe_k_weak "weak_baseline"
text t_pe_k_der "compiler_derived"
text t_pe_k_tonly "toolchain_only"
text t_pe_k_runid "run_id"
text t_pe_k_smoke "smoke"
text t_pe_k_gate "gate_eligible"
text t_pe_k_dirty "tree_dirty_files"
text t_pe_k_sha "sha256"
text t_pe_k_reg "regime"
text t_pe_k_m "m"
text t_pe_k_n "n"
text t_pe_k_sp "sparsity"

note
note tests/polyglot/test_encoder.om -- pure seeded OM-2 POLYGLOT-0 lane B2 gate:
note   A. Byte comparison vs GNU as .text.bin (argv[1] sdot, argv[2] crumb)
note   B. Final-form ADRP/ADD data relocation verification
note   C. Omega AArch64 decoder round-trip verification
note   D. Fail-closed invalid-operand checks (39) + all 5,334 logical immediates
note   E. Error contract + MA-3 shape grid + random + large magnitudes up to OMX_MAX_N

note [0]=checks [1]=fail [2]=cases [3]=rng [4]=identical [5]=differ
note [6]=rt_full [7]=rt_partial [8]=rt_ext_unsup [9]=rt_ext_alias
global g_te_st ulong 12
global g_te_arg uchar 512
global g_te_obj uint 1024
global g_te_ns ulong 31
global g_te_ms ulong 10
global g_te_sps f64 5
global g_te_bad byte 5

text t_te_usage "usage: test_encoder <gnu-as sdot .text.bin> <gnu-as crumb .text.bin>\n"
text t_te_banner "POLYGLOT test-encoder: byte comparison vs GNU as (B1 .text)\n"
text t_te_bc1 "  byte-compare "
text t_te_sdot "enc_sdot"
text t_te_crumb "enc_crumb"
text t_te_bc2 ": "
text t_te_bc3 " instructions, "
text t_te_bc4 " identical, "
text t_te_bc5 " differ (object form; "
text t_te_bc6 " carry a data relocation, fields zero in both)\n"
text t_te_diff "  DIFF +"
text t_te_omega " omega="
text t_te_gnu " gnu-as="
text t_te_fin1 "  final "
text t_te_fin2 ": "
text t_te_fin3 " bytes at page-aligned base 0x10000000; "
text t_te_fin4 " relocated instruction(s) differ from object form, 0 others\n"
text t_te_rt1 "  omega-decoder round trip: "
text t_te_rt2 " full, "
text t_te_rt3 " partial, "
text t_te_rt4 " ext-unsupported, "
text t_te_rt5 " ext-alias (ADD lsl)\n"
text t_te_fc1 "  fail-closed: "
text t_te_fc2 " invalid-operand calls checked; logical immediates round-tripped: "
text t_te_hdr "POLYGLOT test-encoder "
text t_te_pass "PASS"
text t_te_fail "FAIL"
text t_te_s1 ": "
text t_te_s2 " checks, "
text t_te_s3 " failures; 2 candidates; byte-compare "
text t_te_s4 " identical, "
text t_te_s5 " differ; encoder checks "
text t_te_s6 "; cases: grid "
text t_te_s7 ", random "
text t_te_s8 ", large "
text t_te_s9 "; error-contract checks "
text t_te_efail "FAIL test_encoder check #"

fn te_init to void
  for i ulong 12
    put g_te_st i 0
  end
  put g_te_st 3 0x504f4c59454e4331

  put g_te_ns 0 1
  put g_te_ns 1 2
  put g_te_ns 2 3
  put g_te_ns 3 4
  put g_te_ns 4 5
  put g_te_ns 5 7
  put g_te_ns 6 15
  put g_te_ns 7 16
  put g_te_ns 8 17
  put g_te_ns 9 31
  put g_te_ns 10 32
  put g_te_ns 11 33
  put g_te_ns 12 63
  put g_te_ns 13 64
  put g_te_ns 14 65
  put g_te_ns 15 79
  put g_te_ns 16 80
  put g_te_ns 17 81
  put g_te_ns 18 127
  put g_te_ns 19 128
  put g_te_ns 20 129
  put g_te_ns 21 159
  put g_te_ns 22 160
  put g_te_ns 23 161
  put g_te_ns 24 255
  put g_te_ns 25 256
  put g_te_ns 26 257
  put g_te_ns 27 1000
  put g_te_ns 28 1023
  put g_te_ns 29 1024
  put g_te_ns 30 1025

  put g_te_ms 0 1
  put g_te_ms 1 2
  put g_te_ms 2 3
  put g_te_ms 3 4
  put g_te_ms 4 5
  put g_te_ms 5 7
  put g_te_ms 6 15
  put g_te_ms 7 16
  put g_te_ms 8 17
  put g_te_ms 9 33

  put g_te_sps 0 0.0f64
  put g_te_sps 1 0.3f64
  put g_te_sps 2 0.6f64
  put g_te_sps 3 0.9f64
  put g_te_sps 4 1.0f64

  put g_te_bad 0 byte 2
  put g_te_bad 1 byte -2
  put g_te_bad 2 byte -128
  put g_te_bad 3 byte 127
  put g_te_bad 4 byte 3
end

fn te_rnd to ulong
  st = new ulong 1 0
  put st 0 get g_te_st 3
  v = omx_rng_next st
  put g_te_st 3 get st 0
  ret v
end

fn te_rnd01 to f64
  st = new ulong 1 0
  put st 0 get g_te_st 3
  v = omx_rng_01 st
  put g_te_st 3 get st 0
  ret v
end

fn te_chk cond bool to void
  c = add get g_te_st 0 1
  put g_te_st 0 c
  if not cond
    f = add get g_te_st 1 1
    put g_te_st 1 f
    if le f 20
      omx_eputs t_te_efail
      omx_eputu c
      omx_enl
    end
  end
end

fn te_kname k ulong to void
  if eq k OMX_ENC_SDOT
    omx_puts t_te_sdot
  else
    omx_puts t_te_crumb
  end
end

note A. Byte comparison vs GNU as .text.bin
fn te_byte_compare k ulong argi ulong to void
  alen = argread argi g_te_arg 0 512
  te_chk gt alen 0
  if le alen 0
    ret
  end
  te_chk eq omx_encoder_build k 0 0
  n = get g_enc_st 0
  fd = fopen g_te_arg 0 ulong alen 0 0
  te_chk ge fd 0
  if lt fd 0
    ret
  end
  tot = ulong 0
  while lt tot 262144 bound 262144
    r = read int fd g_omx_fbuf tot sub 262144 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  _c = fclose int fd
  te_chk eq tot mul 4 n
  same = ulong 0
  diff = ulong 0
  relocs = ulong 0
  for i ulong n bound 1024
    if le add mul 4 i 4 tot
      g = uint omx_u32_le_fbuf mul 4 i
      e = get g_enc_word i
      if ne get g_enc_reloc i OMX_ENC_RELOC_NONE
        relocs = add relocs 1
      end
      if eq g e
        same = add same 1
      else
        diff = add diff 1
        omx_puts t_te_diff
        omx_putu mul 4 i
        omx_puts t_te_omega
        omx_putx32 e
        omx_puts t_te_gnu
        omx_putx32 g
        omx_nl
      end
    end
  end
  put g_te_st 4 add get g_te_st 4 same
  put g_te_st 5 add get g_te_st 5 diff
  te_chk eq diff 0
  omx_puts t_te_bc1
  te_kname k
  omx_puts t_te_bc2
  omx_putu n
  omx_puts t_te_bc3
  omx_putu same
  omx_puts t_te_bc4
  omx_putu diff
  omx_puts t_te_bc5
  omx_putu relocs
  omx_puts t_te_bc6
end

note B. Final-form relocation check
fn te_final_form k ulong to void
  te_chk eq omx_encoder_build k 0 0
  n0 = get g_enc_st 0
  for i ulong n0 bound 1024
    put g_te_obj i get g_enc_word i
  end
  base = ulong 0x10000000
  te_chk eq omx_encoder_build k base 0
  n1 = get g_enc_st 0
  doff = get g_enc_st 4
  te_chk eq n0 n1
  te_chk eq and doff 15 0
  reloc_diff = ulong 0
  other_diff = ulong 0
  for i ulong n1 bound 1024
    if ne get g_te_obj i get g_enc_word i
      if ne get g_enc_reloc i OMX_ENC_RELOC_NONE
        reloc_diff = add reloc_diff 1
      else
        other_diff = add other_diff 1
      end
    end
  end
  te_chk eq other_diff 0
  omx_puts t_te_fin1
  te_kname k
  omx_puts t_te_fin2
  omx_putu mul 4 n1
  omx_puts t_te_fin3
  omx_putu reloc_diff
  omx_puts t_te_fin4
end

note C. Omega decoder round trip
fn te_sext v ulong bits ulong to long
  m = shl ulong 1 sub bits 1
  mask = sub shl ulong 1 bits 1
  u = and v mask
  ret sub long xor u m long m
end

fn te_check_dec_insn i ulong w ulong dec view ulong 9 to void
  op = get dec 0
  re = long -1
  full = ulong 1
  if eq op 9
    d = te_sext get dec 7 26
    te_chk eq d long get g_enc_bdisp i
    re = omx_a64_b d
  else
    if eq op 10
      d = te_sext get dec 7 19
      te_chk eq d long get g_enc_bdisp i
      re = omx_a64_bcond get dec 8 d
    else
      if eq op 11
        d = te_sext get dec 7 19
        te_chk eq d long get g_enc_bdisp i
        re = omx_a64_cbz get dec 1 get dec 2 d
      else
        if eq op 1
          re = omx_a64_addreg get dec 1 get dec 2 get dec 3 get dec 4
        else
          if eq op 2
            re = omx_a64_subreg get dec 1 get dec 2 get dec 3 get dec 4
          else
            if eq op 5
              re = omx_a64_orrreg get dec 1 get dec 2 get dec 3 get dec 4
            else
              if eq op 7
                re = omx_a64_movz get dec 1 get dec 2 get dec 5
              else
                if eq op 8
                  re = omx_a64_ret
                else
                  full = 0
                end
              end
            end
          end
        end
      end
    end
  end
  if eq full 1
    if ge re 0
      te_chk eq ulong re w
    else
      te_chk false
    end
    put g_te_st 6 add get g_te_st 6 1
  else
    te_chk or eq op 19 or eq op 15 eq op 16
    te_chk and eq get dec 2 and w 31 eq get dec 3 and shr w 5 31
    put g_te_st 7 add get g_te_st 7 1
  end
end

fn te_decoder_round_trip k ulong to void
  te_chk eq omx_encoder_build k 0 0
  n = get g_enc_st 0
  dec = new ulong 9 0
  for i ulong n bound 1024
    w = ulong get g_enc_word i
    rc = omx_a64_decode w dec
    if eq get g_enc_orig i OMX_ENC_FROM_EXT
      if ne rc 0
        put g_te_st 8 add get g_te_st 8 1
      else
        put g_te_st 9 add get g_te_st 9 1
        te_chk and eq get dec 0 1 eq get g_enc_lsl i 1
      end
      continue
    end
    te_chk eq rc 0
    if eq rc 0
      te_check_dec_insn i w dec
    end
  end
end

note D. Fail-closed invalid-operand checks + all 5,334 logical immediates
fn te_bm_topbit v ulong to long
  b = long 6
  while ge b 0 bound 8
    if ne and v shl ulong 1 ulong b 0
      ret b
    end
    b = sub b 1
  end
  ret -1
end

fn te_bm_rep elem ulong esize ulong to ulong
  res = ulong 0
  sh = ulong 0
  while lt sh 64 bound 64
    res = or res shl elem sh
    sh = add sh esize
  end
  ret res
end

fn te_bm_elem s ulong r ulong esize ulong to ulong
  emask = ulong 0xffffffffffffffff
  if lt esize 64
    emask = sub shl ulong 1 esize 1
  end
  welem = sub shl ulong 1 add s 1 1
  if gt r 0
    ret and or shr welem r shl welem sub esize r emask
  end
  ret welem
end

fn te_decode_bitmask nbit ulong immr ulong imms ulong ok edit ulong 1 to ulong
  put ok 0 0
  blen = te_bm_topbit or shl nbit 6 and not imms 0x3f
  if lt blen 1
    ret 0
  end
  lu = ulong blen
  levels = sub shl ulong 1 lu 1
  s = and imms levels
  if eq s levels
    ret 0
  end
  elem = te_bm_elem s and immr levels shl ulong 1 lu
  put ok 0 1
  ret te_bm_rep elem shl ulong 1 lu
end

fn te_check_bm_one nb ulong immr ulong imms ulong to ulong
  ok = new ulong 1 0
  v = te_decode_bitmask nb immr imms ok
  if eq get ok 0 0
    ret 0
  end
  esize = ulong 0
  if eq nb 1
    esize = 64
  else
    b = long 5
    while ge b 1 bound 8
      if eq and imms shl ulong 1 ulong b 0
        esize = shl ulong 1 ulong b
        break
      end
      b = sub b 1
    end
  end
  if or eq esize 0 ge immr esize
    ret 0
  end
  enc = new ulong 3 0
  rc = oxe_bitmask_imm64 v enc
  m0 = eq rc 0
  m1 = eq get enc 0 nb
  m2 = eq get enc 1 immr
  m3 = eq get enc 2 imms
  te_chk and and m0 m1 and m2 m3
  ret 1
end

fn te_check_all_bm to ulong
  valid = ulong 0
  for nb ulong 2
    for immr ulong 64
      for imms ulong 64
        valid = add valid te_check_bm_one nb immr imms
      end
    end
  end
  ret valid
end

fn te_fail_closed to void
  te_chk eq oxe_sdot_4s 32 0 0 -1
  te_chk eq oxe_sdot_4s 0 0 40 -1
  te_chk eq oxe_sdot_4s 0 32 0 -1
  te_chk eq oxe_sshr_16b 0 0 0 -1
  te_chk eq oxe_sshr_16b 0 0 9 -1
  te_chk eq oxe_shl_16b 0 0 8 -1
  te_chk eq oxe_movi_16b 0 256 -1
  te_chk eq oxe_ld1_4x16b_post 0 9 32 -1
  te_chk eq oxe_ld1_4x16b 0 32 -1
  te_chk eq oxe_ldp_x_off 3 4 0 4 -1
  te_chk eq oxe_ldp_x_off 3 4 0 512 -1
  te_chk eq oxe_ldp_x_off 3 3 0 0 -1
  te_chk eq oxe_ldr_q_post 0 9 256 -1
  te_chk eq oxe_str_q_post 0 9 -257 -1
  te_chk eq oxe_ldr_q_uoff 0 9 8 -1
  te_chk eq oxe_ldr_q_uoff 0 9 65536 -1
  te_chk eq oxe_stp_q_off 0 0 31 1024 -1
  te_chk eq oxe_stp_q_off 0 0 31 8 -1
  te_chk eq oxe_ldrsb_w_post 5 5 1 -1
  te_chk eq oxe_and_imm_x 8 4 0 -1
  te_chk eq oxe_and_imm_x 8 4 0xffffffffffffffff -1
  te_chk eq oxe_and_imm_x 8 4 5 -1
  te_chk eq oxe_ands_imm_x 8 4 0x1234 -1
  te_chk eq oxe_ubfx_x 7 4 60 5 -1
  te_chk eq oxe_ubfx_x 7 4 4 0 -1
  te_chk eq oxe_lsl_imm_x 7 7 64 -1
  te_chk eq oxe_lsr_imm_x 7 7 64 -1
  te_chk eq oxe_add_imm_x 31 31 4096 0 -1
  te_chk eq oxe_sub_imm_x 31 31 64 2 -1
  te_chk eq oxe_add_lsl_x 5 5 4 64 -1
  te_chk eq oxe_cinc_x 7 6 14 -1
  te_chk eq oxe_csinc_x 7 6 6 16 -1
  te_chk eq oxe_movn_w 0 0x10000 0 -1
  te_chk eq oxe_movn_w 0 0 2 -1
  te_chk eq oxe_adrp 16 1048576 -1
  te_chk eq oxe_adrp 16 -1048577 -1
  te_chk eq oxe_madd_w 6 10 11 32 -1
  te_chk eq oxe_addv_4s 32 24 -1
  te_chk eq oxe_str_s_post 24 2 300 -1

  valid = te_check_all_bm
  te_chk eq valid 5334
  omx_puts t_te_fc1
  omx_putu 39
  omx_puts t_te_fc2
  omx_putu valid
  omx_nl
end

note E. Correctness suite for enc_sdot & enc_crumb
fn te_fill_w cnt ulong wk ulong sp f64 to void
  for i ulong cnt bound 16777216
    if eq wk 1
      put g_omx_w i byte 0
    else
      if eq wk 2
        put g_omx_w i byte 1
      else
        if eq wk 3
          put g_omx_w i byte -1
        else
          if lt te_rnd01 sp
            put g_omx_w i byte 0
          else
            if eq and te_rnd 1 1
              put g_omx_w i byte 1
            else
              put g_omx_w i byte -1
            end
          end
        end
      end
    end
  end
end

fn te_fill_x xoff ulong n ulong xk ulong to void
  for j ulong n bound 16777216
    if eq xk 1
      put g_omx_x add xoff j byte -128
    else
      if eq xk 2
        put g_omx_x add xoff j byte 127
      else
        if eq xk 3
          if eq and j 1 1
            put g_omx_x add xoff j byte 127
          else
            put g_omx_x add xoff j byte -128
          end
        else
          if eq xk 4
            put g_omx_x add xoff j byte 0
          else
            u = and te_rnd 255
            if ge u 128
              put g_omx_x add xoff j byte sub long u 256
            else
              put g_omx_x add xoff j byte long u
            end
          end
        end
      end
    end
  end
end

fn te_run_rep kind ulong m ulong xoff ulong yoff ulong to void
  for i ulong m bound 65536
    put g_omx_y add yoff i int 0x5a5a5a5a
  end
  te_chk eq omx_run_cand kind xoff yoff 1 1 OMX_OK
  bad = ulong 0
  for i ulong m bound 65536
    if ne get g_omx_y add yoff i get g_omx_yref i
      bad = add bad 1
    end
  end
  te_chk eq bad 0
end

fn te_check_impl kind ulong m ulong n ulong xoff ulong yoff ulong to void
  rc = omx_pack_cand kind m n 1
  te_chk eq rc OMX_OK
  if ne rc OMX_OK
    omx_plan_zero
    ret
  end
  te_chk and gt get g_omx_plan 2 0 ge get g_omx_plan 3 get g_omx_plan 2
  te_run_rep kind m xoff yoff
  te_run_rep kind m xoff yoff
  omx_plan_zero
  put g_te_st 2 add get g_te_st 2 1
end

fn te_run_case m ulong n ulong wk ulong sp f64 xk ulong to void
  te_fill_w mul m n wk sp
  te_fill_x 0 n xk
  te_chk eq omx_oracle m n 0 OMX_OK
  te_check_impl OMX_CAND_ENC_SDOT m n 0 0
  te_check_impl OMX_CAND_ENC_CRUMB m n 0 0
end

fn te_check_spill ybase ulong yend ulong ytot ulong to void
  spill = ulong 0
  for i ulong ybase bound 65536
    if ne get g_omx_y i int -1515870811
      spill = add spill 1
    end
  end
  i = yend
  while lt i ytot bound 65536
    if ne get g_omx_y i int -1515870811
      spill = add spill 1
    end
    i = add i 1
  end
  te_chk eq spill 0
end

fn te_run_random m ulong n ulong sp f64 xk ulong xo ulong yo ulong to void
  te_fill_w mul m n 0 sp
  te_fill_x xo n xk
  te_chk eq omx_oracle m n xo OMX_OK
  ybase = add 16 yo
  yend = add ybase m
  ytot = add m 48
  for c ulong 2
    kind = OMX_CAND_ENC_SDOT
    if eq c 1
      kind = OMX_CAND_ENC_CRUMB
    end
    for i ulong ytot bound 65536
      put g_omx_y i int -1515870811
    end
    te_check_impl kind m n xo ybase
    te_check_spill ybase yend ytot
  end
end

fn te_test_errors to void
  put g_omx_w 0 byte 1
  put g_omx_w 1 byte 0
  put g_omx_w 2 byte -1
  put g_omx_w 3 byte 1
  put g_omx_w 4 byte 0
  put g_omx_w 5 byte 1
  put g_omx_x 0 byte 1
  put g_omx_x 1 byte 2
  put g_omx_x 2 byte 3
  for c ulong 2
    kind = OMX_CAND_ENC_SDOT
    if eq c 1
      kind = OMX_CAND_ENC_CRUMB
    end
    for b ulong 5
      put g_omx_w 3 get g_te_bad b
      put g_omx_plan 5 77
      te_chk eq omx_pack_cand kind 2 3 1 OMX_E_TRIT
      te_chk eq omx_plan_is_zero 1
    end
    put g_omx_w 3 byte 1
    put g_omx_plan 5 77
    te_chk eq omx_pack_cand kind 0 3 1 OMX_E_ARG
    te_chk eq omx_plan_is_zero 1
    te_chk eq omx_pack_cand kind 2 0 1 OMX_E_ARG
    te_chk eq omx_pack_cand kind 2 3 0 OMX_E_ARG
    te_chk eq omx_plan_is_zero 1
    te_chk eq omx_pack_cand kind 1 add OMX_MAX_N 1 1 OMX_E_ARG
    te_chk eq omx_pack_cand kind 1 OMX_ULONG_MAX 1 OMX_E_ARG
    te_chk eq omx_pack_cand kind div OMX_ULONG_MAX 2 1000 1 OMX_E_OVERFLOW
    te_chk eq omx_plan_is_zero 1
    omx_plan_zero
    te_chk eq omx_run_cand kind 0 0 1 1 OMX_E_ARG
    te_chk eq omx_pack_cand kind 2 3 1 OMX_OK
    te_chk eq omx_run_cand kind 0 0 0 1 OMX_E_ARG
    te_chk eq omx_run_cand kind 0 0 1 0 OMX_E_ARG
    te_chk eq omx_run_cand kind 0 0 1 1 OMX_OK
    te_chk eq get g_omx_y 0 int -2
    te_chk eq get g_omx_y 1 int 4
    omx_plan_zero
  end
end

fn main to int
  if ne argcnt 3
    omx_eputs t_te_usage
    ret 2
  end
  te_init
  omx_puts t_te_banner
  te_byte_compare OMX_ENC_SDOT 1
  te_byte_compare OMX_ENC_CRUMB 2
  for k ulong OMX_ENC_KERNELS
    te_final_form k
    te_decoder_round_trip k
  end
  omx_puts t_te_rt1
  omx_putu get g_te_st 6
  omx_puts t_te_rt2
  omx_putu get g_te_st 7
  omx_puts t_te_rt3
  omx_putu get g_te_st 8
  omx_puts t_te_rt4
  omx_putu get g_te_st 9
  omx_puts t_te_rt5
  te_fail_closed
  enc_checks = get g_te_st 0
  te_test_errors
  c0 = get g_te_st 0

  for a ulong 31
    nv = get g_te_ns a
    for b ulong 10
      mv = get g_te_ms b
      te_run_case mv nv 1 0.0f64 0
      te_run_case mv nv 2 0.0f64 1
      te_run_case mv nv 2 0.0f64 2
      te_run_case mv nv 3 0.0f64 1
      te_run_case mv nv 3 0.0f64 2
      te_run_case mv nv 0 get g_te_sps rem add a b 5 3
      te_run_case mv nv 0 get g_te_sps rem add mul a 3 b 5 0
    end
  end
  grid_cases = get g_te_st 2

  for it ulong 2000 bound 2000
    n = add 1 rem te_rnd 2100
    m = add 1 rem te_rnd 70
    xk = ulong 0
    if eq rem te_rnd 4 0
      xk = rem te_rnd 5
    end
    xo = add 1 rem te_rnd 15
    yo = add 1 rem te_rnd 15
    te_run_random m n te_rnd01 xk xo yo
  end
  random_cases = sub get g_te_st 2 grid_cases

  te_run_case 5 16384 3 0.0f64 1
  te_run_case 5 16384 2 0.0f64 1
  te_run_case 1 100003 3 0.0f64 1
  te_run_case 6 1048613 0 0.3f64 0
  te_run_case 17 4099 0 0.97f64 0
  te_run_case 1 OMX_MAX_N 3 0.0f64 1
  te_run_case 1 OMX_MAX_N 2 0.0f64 1
  te_run_case 1 OMX_MAX_N 0 0.5f64 3
  large_cases = sub sub get g_te_st 2 grid_cases random_cases

  omx_puts t_te_hdr
  if eq get g_te_st 1 0
    omx_puts t_te_pass
  else
    omx_puts t_te_fail
  end
  omx_puts t_te_s1
  omx_putu get g_te_st 0
  omx_puts t_te_s2
  omx_putu get g_te_st 1
  omx_puts t_te_s3
  omx_putu get g_te_st 4
  omx_puts t_te_s4
  omx_putu get g_te_st 5
  omx_puts t_te_s5
  omx_putu enc_checks
  omx_puts t_te_s6
  omx_putu grid_cases
  omx_puts t_te_s7
  omx_putu random_cases
  omx_puts t_te_s8
  omx_putu large_cases
  omx_puts t_te_s9
  omx_putu sub c0 enc_checks
  omx_nl
  if ne get g_te_st 1 0
    ret 1
  end
  ret 0
end

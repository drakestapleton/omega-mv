note
note tests/polyglot/verify_polyglot.om -- pure seeded OM-2 POLYGLOT-0 shared verifier:
note checks all 5 candidates (om_plain, om_sdot, om_crumb, enc_sdot, enc_crumb)
note against omx_oracle across error contract, shape error contract, MA-3 grid,
note large shapes, random cases, and 5-run in-place x mutation anti-memoization checks.
note enc_sdot and enc_crumb execute their actual emitted AArch64 machine code via
note omx_vm_exec with guard-page bounds and callee-saved x19..x28/d8..d15 verification,
note plus harness ABI audit and negative bit-mutation differential checks.

const VP_NC ulong 5

global g_vp_checks ulong 8
global g_vp_fail ulong 8
global g_vp_cases ulong 8
note g_vp_st: [0]=rng [1]=hchecks [2]=hfail [3]=nrand
global g_vp_st ulong 4

global g_vp_x1 byte 1048576
global g_vp_x2 byte 1048576
global g_vp_x3 byte 1048576
global g_vp_yref1 int 65536
global g_vp_yref2 int 65536
global g_vp_yref3 int 65536
global g_vp_env uchar 256

global g_vp_ns ulong 31
global g_vp_ms ulong 10
global g_vp_sps f64 5
global g_vp_bad byte 5

text t_vp_envk "OMX_VERIFY_RANDOM="
text t_vp_c0 "om_plain        "
text t_vp_c1 "om_sdot         "
text t_vp_c2 "om_crumb        "
text t_vp_c3 "enc_sdot        "
text t_vp_c4 "enc_crumb       "
text t_vp_l0 "omega-om2      "
text t_vp_l1 "omega-encoder  "
text t_vp_line1 "POLYGLOT verify "
text t_vp_pass "PASS"
text t_vp_fail "FAIL"
text t_vp_s1 ": "
text t_vp_s2 " checks, "
text t_vp_s3 " failures, "
text t_vp_s4 " cases\n"
text t_vp_sum1 "POLYGLOT verify-polyglot "
text t_vp_sum2 ": 5 candidates ("
text t_vp_sum3 " failing), "
text t_vp_sum4 " checks, "
text t_vp_sum5 " failures, grid+large+random+guard+callee-saved(x19-x28/d8-d15) verified, harness "
text t_vp_sl "/"
text t_vp_efail "FAIL verify_polyglot cand="

fn vp_init to void
  for i ulong 8
    put g_vp_checks i 0
    put g_vp_fail i 0
    put g_vp_cases i 0
  end
  put g_vp_st 0 0x504f4c59474c4f54
  put g_vp_st 1 0
  put g_vp_st 2 0
  put g_vp_st 3 200

  put g_vp_ns 0 1
  put g_vp_ns 1 2
  put g_vp_ns 2 3
  put g_vp_ns 3 4
  put g_vp_ns 4 5
  put g_vp_ns 5 7
  put g_vp_ns 6 15
  put g_vp_ns 7 16
  put g_vp_ns 8 17
  put g_vp_ns 9 31
  put g_vp_ns 10 32
  put g_vp_ns 11 33
  put g_vp_ns 12 63
  put g_vp_ns 13 64
  put g_vp_ns 14 65
  put g_vp_ns 15 79
  put g_vp_ns 16 80
  put g_vp_ns 17 81
  put g_vp_ns 18 127
  put g_vp_ns 19 128
  put g_vp_ns 20 129
  put g_vp_ns 21 159
  put g_vp_ns 22 160
  put g_vp_ns 23 161
  put g_vp_ns 24 255
  put g_vp_ns 25 256
  put g_vp_ns 26 257
  put g_vp_ns 27 1000
  put g_vp_ns 28 1023
  put g_vp_ns 29 1024
  put g_vp_ns 30 1025

  put g_vp_ms 0 1
  put g_vp_ms 1 2
  put g_vp_ms 2 3
  put g_vp_ms 3 4
  put g_vp_ms 4 5
  put g_vp_ms 5 7
  put g_vp_ms 6 15
  put g_vp_ms 7 16
  put g_vp_ms 8 17
  put g_vp_ms 9 33

  put g_vp_sps 0 0.0f64
  put g_vp_sps 1 0.3f64
  put g_vp_sps 2 0.6f64
  put g_vp_sps 3 0.9f64
  put g_vp_sps 4 1.0f64

  put g_vp_bad 0 byte 2
  put g_vp_bad 1 byte -2
  put g_vp_bad 2 byte -128
  put g_vp_bad 3 byte 127
  put g_vp_bad 4 byte 3
end

fn vp_read_env_nrand to void
  ec = ulong envcnt
  klen = len t_vp_envk
  for i ulong ec bound 512
    el = envread i g_vp_env 0 256
    if gt el long klen
      ok = ulong 1
      for j ulong klen bound 32
        if ne get g_vp_env j get t_vp_envk j
          ok = 0
          break
        end
      end
      if eq ok 1
        v = ulong 0
        j = klen
        while lt j ulong el bound 32
          c = get g_vp_env j
          if or lt c 48 gt c 57
            break
          end
          v = add mul v 10 ulong sub c 48
          j = add j 1
        end
        if le v 20000
          put g_vp_st 3 v
        end
        ret
      end
    end
  end
end

fn vp_rnd to ulong
  st = new ulong 1 0
  put st 0 get g_vp_st 0
  v = omx_rng_next st
  put g_vp_st 0 get st 0
  ret v
end

fn vp_rnd01 to f64
  st = new ulong 1 0
  put st 0 get g_vp_st 0
  v = omx_rng_01 st
  put g_vp_st 0 get st 0
  ret v
end

fn vp_chk ci ulong cond bool to void
  put g_vp_checks ci add get g_vp_checks ci 1
  if not cond
    f = add get g_vp_fail ci 1
    put g_vp_fail ci f
    if le f 10
      omx_eputs t_vp_efail
      omx_eputu ci
      omx_enl
    end
  end
end

fn vp_hchk cond bool to void
  put g_vp_st 1 add get g_vp_st 1 1
  if not cond
    put g_vp_st 2 add get g_vp_st 2 1
  end
end

fn vp_run_cand ci ulong xoff ulong yoff ulong has_x ulong has_y ulong to int
  if ge ci OMX_CAND_ENC_SDOT
    ret omx_vm_run_cand ci xoff yoff has_x has_y
  end
  ret omx_run_cand ci xoff yoff has_x has_y
end

fn vp_harness_selftest to void
  vp_hchk eq omx_vm_load_kernel OMX_ENC_SDOT 0
  vp_hchk eq omx_vm_load_kernel OMX_ENC_CRUMB 0
  for i ulong 64
    put g_omx_w i byte 1
    put g_omx_x i byte 2
  end
  vp_hchk eq omx_oracle 1 64 0 OMX_OK
  vp_hchk eq omx_pack_sdot 1 64 1 OMX_OK
  note Negative check: mutating enc_sdot to clobber x20 must be caught as ABI error -104
  o0 = get g_vm_c0 11
  put g_vm_c0 11 uint omx_a64_movz 1 20 99
  vp_hchk eq omx_vm_exec OMX_ENC_SDOT 7 0 0 -104
  put g_vm_c0 11 o0
  note Negative check: illegal opcode bit (bit 28) must be caught
  o1 = get g_vm_c0 10
  put g_vm_c0 10 xor o1 uint 0x10000000
  vp_hchk ne omx_vm_exec OMX_ENC_SDOT 7 0 0 0
  put g_vm_c0 10 o1
  vp_hchk eq omx_vm_exec OMX_ENC_SDOT 7 0 0 OMX_OK
  vp_hchk eq get g_omx_y 0 get g_omx_yref 0
  omx_plan_zero
end

fn vp_fill_w cnt ulong wk ulong sp f64 to void
  for i ulong cnt bound 16777216
    if eq wk 1
      put g_omx_w i byte 0
    else
      if eq wk 2
        put g_omx_w i byte 1
      else
        if eq wk 3
          put g_omx_w i byte -1
        else
          if lt vp_rnd01 sp
            put g_omx_w i byte 0
          else
            if eq and vp_rnd 1 1
              put g_omx_w i byte 1
            else
              put g_omx_w i byte -1
            end
          end
        end
      end
    end
  end
end

fn vp_gen_byte xk ulong j ulong to byte
  if eq xk 1
    ret byte -128
  end
  if eq xk 2
    ret byte 127
  end
  if eq xk 3
    if eq and j 1 1
      ret byte 127
    end
    ret byte -128
  end
  if eq xk 4
    ret byte 0
  end
  if eq xk 5
    r = rem vp_rnd 4
    if eq r 0
      ret byte -128
    end
    if eq r 1
      ret byte 127
    end
  end
  u = and vp_rnd 255
  if ge u 128
    ret byte sub long u 256
  end
  ret byte long u
end

fn vp_mut_byte v byte to byte
  vi = int v
  if eq vi 0
    ret byte 1
  end
  if eq vi 1
    ret byte -1
  end
  ret byte div neg vi 2
end

fn vp_prep_x n ulong xk ulong to void
  xk2 = rem add xk 1 6
  for j ulong n bound 1048576
    b1 = vp_gen_byte xk j
    put g_vp_x1 j b1
    put g_vp_x3 j b1
    put g_vp_x2 j vp_gen_byte xk2 j
  end
  t0 = sub n 1
  t1 = div n 2
  put g_vp_x3 t0 vp_mut_byte get g_vp_x3 t0
  put g_vp_x3 t1 vp_mut_byte get g_vp_x3 t1
end

fn vp_copy_x_from src ulong n ulong to void
  for j ulong n bound 1048576
    if eq src 1
      put g_omx_x j get g_vp_x1 j
    else
      if eq src 2
        put g_omx_x j get g_vp_x2 j
      else
        put g_omx_x j get g_vp_x3 j
      end
    end
  end
end

fn vp_save_yref dst ulong m ulong to void
  for i ulong m bound 65536
    v = get g_omx_yref i
    if eq dst 1
      put g_vp_yref1 i v
    else
      if eq dst 2
        put g_vp_yref2 i v
      else
        put g_vp_yref3 i v
      end
    end
  end
end

fn vp_check_y ci ulong ref_id ulong m ulong to void
  bad = ulong 0
  for i ulong m bound 65536
    want = int 0
    if eq ref_id 1
      want = get g_vp_yref1 i
    else
      if eq ref_id 2
        want = get g_vp_yref2 i
      else
        want = get g_vp_yref3 i
      end
    end
    if ne get g_omx_y i want
      bad = add bad 1
    end
  end
  vp_chk ci eq bad 0
end

fn vp_run_one_rep ci ulong m ulong src ulong ref_id ulong to void
  for i ulong m bound 65536
    put g_omx_y i int 0x5a5a5a5a
  end
  vp_copy_x_from src get g_omx_plan 1
  vp_chk ci eq vp_run_cand ci 0 0 1 1 OMX_OK
  vp_check_y ci ref_id m
end

fn vp_run_case m ulong n ulong wk ulong sp f64 xk ulong to void
  vp_fill_w mul m n wk sp
  vp_prep_x n xk
  vp_copy_x_from 1 n
  vp_hchk eq omx_oracle m n 0 OMX_OK
  vp_save_yref 1 m
  vp_copy_x_from 2 n
  vp_hchk eq omx_oracle m n 0 OMX_OK
  vp_save_yref 2 m
  vp_copy_x_from 3 n
  vp_hchk eq omx_oracle m n 0 OMX_OK
  vp_save_yref 3 m
  for ci ulong VP_NC
    put g_vp_cases ci add get g_vp_cases ci 1
    rc = omx_pack_cand ci m n 1
    vp_chk ci eq rc OMX_OK
    if ne rc OMX_OK
      omx_plan_zero
      continue
    end
    vp_chk ci and gt get g_omx_plan 2 0 ge get g_omx_plan 3 get g_omx_plan 2
    vp_chk ci and eq get g_omx_plan 0 m eq get g_omx_plan 1 n
    note 5 runs: x1, x2, x1, x1-in-place, x3-mutated-in-place (anti-memoization)
    vp_run_one_rep ci m 1 1
    vp_run_one_rep ci m 2 2
    vp_run_one_rep ci m 1 1
    vp_run_one_rep ci m 1 1
    vp_run_one_rep ci m 3 3
    omx_plan_zero
  end
end

fn vp_test_errors to void
  put g_omx_x 0 byte 1
  put g_omx_x 1 byte 2
  put g_omx_x 2 byte 3
  for ci ulong VP_NC
    for b ulong 5
      for p2 ulong 2
        put g_omx_w 0 byte 1
        put g_omx_w 1 byte 0
        put g_omx_w 2 byte -1
        put g_omx_w 3 byte 1
        put g_omx_w 4 byte 0
        put g_omx_w 5 byte -1
        pos = mul p2 5
        put g_omx_w pos get g_vp_bad b
        vp_chk ci eq omx_pack_cand ci 2 3 1 OMX_E_TRIT
        vp_chk ci eq omx_plan_is_zero 1
      end
    end
    put g_omx_w 0 byte 1
    put g_omx_w 1 byte 0
    put g_omx_w 2 byte -1
    put g_omx_w 3 byte 1
    put g_omx_w 4 byte 0
    put g_omx_w 5 byte -1
    vp_chk ci and eq omx_pack_cand ci 0 3 1 OMX_E_ARG eq omx_plan_is_zero 1
    vp_chk ci and eq omx_pack_cand ci 2 0 1 OMX_E_ARG eq omx_plan_is_zero 1
    vp_chk ci and eq omx_pack_cand ci 2 3 0 OMX_E_ARG eq omx_plan_is_zero 1
    vp_chk ci and eq omx_pack_cand ci 1 add OMX_MAX_N 1 1 OMX_E_ARG eq omx_plan_is_zero 1
    vp_chk ci and eq omx_pack_cand ci div OMX_ULONG_MAX 2 4 1 OMX_E_OVERFLOW eq omx_plan_is_zero 1
    omx_plan_zero
    vp_chk ci eq vp_run_cand ci 0 0 1 1 OMX_E_ARG
    vp_chk ci eq omx_pack_cand ci 2 3 1 OMX_OK
    omx_plan_zero
    vp_chk ci eq omx_plan_is_zero 1
    vp_chk ci eq omx_pack_cand ci 2 3 1 OMX_OK
    vp_chk ci eq vp_run_cand ci 0 0 0 1 OMX_E_ARG
    vp_chk ci eq vp_run_cand ci 0 0 1 0 OMX_E_ARG
    vp_chk ci eq vp_run_cand ci 0 0 1 1 OMX_OK
    vp_chk ci and eq get g_omx_y 0 int -2 eq get g_omx_y 1 int -2
    omx_plan_zero
  end
end

fn vp_test_err_shape m ulong n ulong to void
  t = mul m n
  pos0 = ulong 0
  pos1 = sub t 1
  pos2 = add 1 rem vp_rnd sub t 2
  for ci ulong VP_NC
    for b ulong 5
      vp_fill_w t 0 0.3f64
      put g_omx_w pos0 get g_vp_bad b
      vp_chk ci and eq omx_pack_cand ci m n 1 OMX_E_TRIT eq omx_plan_is_zero 1
      vp_fill_w t 0 0.3f64
      put g_omx_w pos1 get g_vp_bad b
      vp_chk ci and eq omx_pack_cand ci m n 1 OMX_E_TRIT eq omx_plan_is_zero 1
      vp_fill_w t 0 0.3f64
      put g_omx_w pos2 get g_vp_bad b
      vp_chk ci and eq omx_pack_cand ci m n 1 OMX_E_TRIT eq omx_plan_is_zero 1
    end
  end
end

fn vp_cname ci ulong to void
  if eq ci 0
    omx_puts t_vp_c0
  else
    if eq ci 1
      omx_puts t_vp_c1
    else
      if eq ci 2
        omx_puts t_vp_c2
      else
        if eq ci 3
          omx_puts t_vp_c3
        else
          omx_puts t_vp_c4
        end
      end
    end
  end
end

fn main to int
  vp_init
  vp_read_env_nrand
  vp_harness_selftest
  vp_test_errors
  vp_test_err_shape 1 17
  vp_test_err_shape 5 16
  vp_test_err_shape 4 65
  vp_test_err_shape 7 129
  vp_test_err_shape 3 1000
  vp_test_err_shape 2 4099
  vp_test_err_shape 33 257

  note MA-3 structured grid (all 31x10 tail combinations)
  for a ulong 31
    nv = get g_vp_ns a
    for b ulong 10
      mv = get g_vp_ms b
      vp_run_case mv nv 1 0.0f64 0
      vp_run_case mv nv 2 0.0f64 1
      vp_run_case mv nv 3 0.0f64 2
      vp_run_case mv nv 0 get g_vp_sps rem add a b 5 3
    end
  end

  note Large shapes
  vp_run_case 1 4096 0 0.0f64 0
  vp_run_case 256 1024 0 0.33f64 5
  vp_run_case 64 1024 0 0.66f64 0
  vp_run_case 1 65537 0 0.33f64 5
  vp_run_case 5 65537 0 0.66f64 0
  vp_run_case 1 131073 0 0.0f64 5
  vp_run_case 1 1000003 0 0.33f64 0

  note Random cases (count from OMX_VERIFY_RANDOM or default 200)
  nrand = get g_vp_st 3
  for it ulong nrand bound 20000
    n = add 1 rem vp_rnd 1025
    m = add 1 rem vp_rnd 70
    vp_run_case m n 0 vp_rnd01 rem vp_rnd 6
  end

  tc = ulong 0
  tf = ulong 0
  bad_c = ulong 0
  for ci ulong VP_NC
    c = get g_vp_checks ci
    f = get g_vp_fail ci
    tc = add tc c
    tf = add tf f
    omx_puts t_vp_line1
    vp_cname ci
    if ge ci OMX_CAND_ENC_SDOT
      omx_puts t_vp_l1
    else
      omx_puts t_vp_l0
    end
    if or ne f 0 eq c 0
      bad_c = add bad_c 1
      omx_puts t_vp_fail
    else
      omx_puts t_vp_pass
    end
    omx_puts t_vp_s1
    omx_putu c
    omx_puts t_vp_s2
    omx_putu f
    omx_puts t_vp_s3
    omx_putu get g_vp_cases ci
    omx_puts t_vp_s4
  end

  failed = or ne bad_c 0 ne get g_vp_st 2 0
  omx_puts t_vp_sum1
  if failed
    omx_puts t_vp_fail
  else
    omx_puts t_vp_pass
  end
  omx_puts t_vp_sum2
  omx_putu bad_c
  omx_puts t_vp_sum3
  omx_putu tc
  omx_puts t_vp_sum4
  omx_putu tf
  omx_puts t_vp_sum5
  omx_putu sub get g_vp_st 1 get g_vp_st 2
  omx_puts t_vp_sl
  omx_putu get g_vp_st 1
  omx_nl
  if failed
    ret 1
  end
  ret 0
end

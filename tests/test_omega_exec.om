note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit & C-oracle parity test for src/omega_exec.om.
om2

text qemu_gold "e219706dc5677cd9a0199fbba49de4914817309b248d1044f5c079932a82a536"
text msg_pass "OMEGA_EXEC_OM_PASS\n"
text msg_fail "OMEGA_EXEC_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex32 dig view uchar * gold view uchar * to void
  for i ulong 32
    b = uint get dig i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn test_exec_all to void
  omega_exec_native_cache_reset
  st = new ulong 4 0
  omega_exec_native_cache_stats st
  chk eq get st 0 0
  chk eq get st 1 0
  chk eq get st 2 0
  chk eq get st 3 0

  note M5 f_add_sub: ADD X0,X0,X1; SUB X0,X0,X2; RET
  m5 = new uchar 12 0
  put m5 0 uchar 0x00
  put m5 1 uchar 0x00
  put m5 2 uchar 0x01
  put m5 3 uchar 0x8b
  put m5 4 uchar 0x00
  put m5 5 uchar 0x00
  put m5 6 uchar 0x02
  put m5 7 uchar 0xcb
  put m5 8 uchar 0xc0
  put m5 9 uchar 0x03
  put m5 10 uchar 0x5f
  put m5 11 uchar 0xd6

  chk eq omega_exec_native_f3 m5 12 7 11 3 0
  chk eq get g_ex_res 0 15
  omega_exec_native_cache_stats st
  chk eq get st 0 0
  chk eq get st 1 1
  chk eq get st 3 1

  note Second call hits cache
  chk eq omega_exec_native_f3 m5 12 20 5 4 0
  chk eq get g_ex_res 0 21
  omega_exec_native_cache_stats st
  chk eq get st 0 1
  chk eq get st 1 1
  chk eq get st 3 1

  note Fill 64 distinct realizations and trigger 1 LRU eviction
  fn_buf = new uchar 8 0
  put fn_buf 4 uchar 0xc0
  put fn_buf 5 uchar 0x03
  put fn_buf 6 uchar 0x5f
  put fn_buf 7 uchar 0xd6
  for k ulong 64
    w = ulong a64movz 1 0 add k 1 0
    put fn_buf 0 uchar and w 255
    put fn_buf 1 uchar and shr w 8 255
    put fn_buf 2 uchar and shr w 16 255
    put fn_buf 3 uchar and shr w 24 255
    chk eq omega_exec_native_f3 fn_buf 8 0 0 0 0
    chk eq get g_ex_res 0 add k 1
  end
  omega_exec_native_cache_stats st
  chk eq get st 2 1
  chk eq get st 3 64

  note Verify QEMU runner binary is byte-exact against C oracle (636 bytes)
  qbuf = new uchar 1024 0
  chk eq omega_build_qemu_runner m5 12 qbuf 1024 0
  chk eq get g_ex_qlen 0 636
  for i ulong 636
    put sh_dat i get qbuf i
  end
  sh_all 636
  qdig = new uchar 32 0
  for i ulong 32
    put qdig i get sh_dig i
  end
  chk_hex32 qdig qemu_gold

  omega_exec_native_cache_reset
  omega_exec_native_cache_stats st
  chk eq get st 3 0
end

fn main to int
  test_exec_all
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

note mkimp.om: Company Brain gate helper. usage: mkimp SPACE OWNER DATE FILE...
note Writes to stdout one pdrive corpus line per FILE (spec/PARITY.md corpus format):
note "brain-import TAB POST TAB /api/cortex/brain/import TAB aj TAB {JSON}" where the JSON body is
note {"space":SPACE,"owner":OWNER,"date":DATE,"text":<the file bytes as a JSON string>}.
note The file is read and escaped in 65536-byte pieces, so no file size is refused here; the server's
note request limit (2,097,152 bytes) applies to the request. Exit 0 ok, 2 usage, 3 a file cannot be
note read, 4 write error.
global pa uchar 4096
global ib uchar 65536
global ob uchar 524288
global obn ulong 1
text u_use "usage: mkimp SPACE OWNER DATE FILE...\n"
text u_open "mkimp: cannot read a file\n"
text u_wr "mkimp: write error\n"
text l_head "brain-import\tPOST\t/api/cortex/brain/import\taj\t{\"space\":"
text l_own ",\"owner\":"
text l_date ",\"date\":"
text l_text ",\"text\":\""
text l_tail "\"}\n"
text hx "0123456789abcdef"

fn say t view uchar * to void
w = write 2 t 0 len t
if lt w 0
ret
end
end
fn argp i ulong to ulong
n = argread i pa 0 len pa
if lt n 0
ret 0
end
ret ulong n
end
fn flush to bool
n = get obn 0
k = ulong 0
for it ulong 4611686018427387904
if ge k n
break
end
w = write 1 ob k sub n k
if le w 0
ret false
end
k = add k ulong w
end
put obn 0 0
ret true
end
fn ob1 c uchar to bool
if ge get obn 0 len ob
if not flush
ret false
end
end
n = get obn 0
put ob n c
put obn 0 add n 1
ret true
end
fn obt t view uchar * to bool
for i ulong len t
if not ob1 get t i
ret false
end
end
ret true
end
note one byte as JSON string content
fn esc c uchar to bool
d = uchar 0
if eq c 34
d = 34
end
if eq c 92
d = 92
end
if eq c 10
d = 110
end
if eq c 9
d = 116
end
if ne d 0
ok = ob1 92
ret and ok ob1 d
end
if lt c 32
ok = ob1 92
ok = and ok ob1 117
ok = and ok ob1 48
ok = and ok ob1 48
ok = and ok ob1 get hx shr c 4
ok = and ok ob1 get hx and c 15
ret ok
end
ret ob1 c
end
note argument i as a JSON string
fn argjs i ulong to bool
n = argp i
ok = ob1 34
for k ulong n
ok = and ok esc get pa k
end
ret and ok ob1 34
end
fn onefile i ulong to int
n = argp i
fd = fopen pa 0 n 524288 0
if lt fd 0
say u_open
ret 3
end
ok = obt l_head
ok = and ok argjs 1
ok = and ok obt l_own
ok = and ok argjs 2
ok = and ok obt l_date
ok = and ok argjs 3
ok = and ok obt l_text
for it ulong 4611686018427387904
r = read int fd ib 0 len ib
if lt r 0
x = fclose int fd
say u_open
ret 3
end
if eq r 0
break
end
for k ulong ulong r
ok = and ok esc get ib k
end
end
x = fclose int fd
ok = and ok obt l_tail
if not ok
say u_wr
ret 4
end
ret 0
end
fn main to int
c = ulong argcnt
if lt c 5
say u_use
ret 2
end
put obn 0 0
for i ulong sub c 4
r = onefile add i 4
if ne r 0
ret r
end
end
if not flush
say u_wr
ret 4
end
ret 0
end

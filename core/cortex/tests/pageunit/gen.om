note gen.om: deterministic inputs and the two helpers of the pageunit gate (tests/pageunit/run.sh),
note so the runner itself only invokes programs and compares bytes and exit codes. Argument 1 selects:
note m  900000 bytes: 7500 copies of the 120-byte line GLINE (quotes, backslashes, a tab, UTF-8)
note w  999999 bytes: 7999 lines of 124 quotes, then 124 quotes with no newline (every byte escaped)
note b  1000000 bytes of a, no newline: one line longer than a record, split by enc
note g  300000 bytes of q, no newline
note k, j, l  8000, 8001 and 10000 lines of x (8000 was the most the old enc accepted)
note x, y  50000 and 200000 lines "line N" (the old pinned omc refused units past 8192 texts); the
note       unit of y puts 15178441 words in the compiler arena, so it is also the alarm's end-to-end control
note c, d  ok, byte 1 or byte 127, newline: enc must exit 4
note u  stdin to stdout, streamed, with the first lowercase letter after the first quote changed to
note    upper case: one byte inside the first text record of an enc unit (the mutant control)
note a  alarm: stdin is the omc-use record of a unit compiled in usage mode (`usage` as its first
note    line). Prints "arena=A top=T full=F alarm-at=13421773" and exits 8 when F is 1 or T (the
note    8-byte words the unit put in the compiler's arena) is 13421773 or more; exit 0 below it. The
note    threshold is a stated number, not a share of A: 80 percent of the 16777216-word arena that
note    compilers before omega-mv's run-time pools had (that arena was fixed; the later one grows, so a
note    share of it says nothing)
note exit 0 ok, 2 usage, read error or no record, 6 write error, 7 mode u found no letter to change,
note 8 alarm. Every input is read in 65536-byte blocks and output leaves through one 1048576-byte
note buffer; no size limit of its own.
global gb uchar 1048576
global gn ulong 1
global gi uchar 65536
global av ulong 8
text GLINE "He said \"ok\"\tthen C:\\tmp\\x; café naïve 中文 Ελλάδα € 🙂 the quick brown fox jumps over the lazy dog, agai\n"
text KARENA "arena="
text KTOP "top="
text KFULL "full="
text AARENA "arena="
text ATOP " top="
text AFULL " full="
text AUSED " alarm-at="
const ALARMAT ulong 13421773
fn gflush to void
n = get gn 0
o = ulong 0
while lt o n bound 1048577
k = write 1 gb o sub n o
if le k 0
exit 6
end
o = add o ulong k
end
put gn 0 0
end
fn gput c uchar to void
p = get gn 0
put gb p c
p = add p 1
put gn 0 p
if eq p 1048576
gflush
end
end
fn gdec v ulong to void
d = new uchar 20 0
k = ulong 0
x = v
while gt x 0 bound 20
put d k uchar add rem x 10 48
x = div x 10
k = add k 1
end
if eq k 0
gput uchar 48
end
while gt k 0 bound 20
k = sub k 1
gput get d k
end
end
fn gtimes c uchar k ulong to void
i = ulong 0
while lt i k bound 9223372036854775807
gput c
i = add i 1
end
end
fn gtext a view uchar * to void
n = len a
i = ulong 0
while lt i n bound 4097
gput get a i
i = add i 1
end
end
fn gxlines k ulong to void
i = ulong 0
while lt i k bound 9223372036854775807
gput uchar 120
gput uchar 10
i = add i 1
end
end
fn gnlines k ulong to void
i = ulong 0
while lt i k bound 9223372036854775807
gput uchar 108
gput uchar 105
gput uchar 110
gput uchar 101
gput uchar 32
gdec i
gput uchar 10
i = add i 1
end
end
fn gmutate to int
note st 0 before the first quote, 1 after it, 2 done
st = ulong 0
go = ulong 1
while eq go 1 bound 9223372036854775807
r = read 0 gi 0 65536
if lt r 0
ret 2
end
if eq r 0
go = ulong 0
else
n = ulong r
i = ulong 0
while lt i n bound 65536
c = get gi i
if eq st 1
if ge c 97
if le c 122
c = uchar sub c 32
st = ulong 2
end
end
end
if eq st 0
if eq c 34
st = ulong 1
end
end
gput c
i = add i 1
end
end
end
gflush
if ne st 2
ret 7
end
ret 0
end
fn kstep k view uchar * pos ulong c uchar to ulong
note the next match position of key k after byte c, given the current one
if eq c get k pos
ret add pos 1
end
if eq c get k 0
ret 1
end
ret 0
end
fn galarm to int
note av: 0 arena, 1 top, 2 full, 3 digit target (0 none, 1 arena, 2 top, 3 full), 4..6 key
note positions, 7 keys seen (bit 1 arena, 2 top)
go = ulong 1
while eq go 1 bound 9223372036854775807
r = read 0 gi 0 65536
if lt r 0
ret 2
end
if eq r 0
go = ulong 0
else
n = ulong r
i = ulong 0
while lt i n bound 65536
c = get gi i
t = get av 3
if ne t 0
if ge c 48
if le c 57
v = get av sub t 1
put av sub t 1 add mul v 10 ulong sub c 48
end
end
if lt c 48
put av 3 0
end
if gt c 57
put av 3 0
end
end
pa = kstep KARENA get av 4 c
pt = kstep KTOP get av 5 c
pf = kstep KFULL get av 6 c
if eq pa len KARENA
put av 0 0
put av 3 1
put av 7 or get av 7 1
pa = ulong 0
end
if eq pt len KTOP
put av 1 0
put av 3 2
put av 7 or get av 7 2
pt = ulong 0
end
if eq pf len KFULL
put av 2 0
put av 3 3
pf = ulong 0
end
put av 4 pa
put av 5 pt
put av 6 pf
i = add i 1
end
end
end
if ne get av 7 3
ret 2
end
a = get av 0
if eq a 0
ret 2
end
t = get av 1
f = get av 2
gtext AARENA
gdec a
gtext ATOP
gdec t
gtext AFULL
gdec f
gtext AUSED
gdec ALARMAT
gput uchar 10
gflush
if eq f 1
ret 8
end
if ge t ALARMAT
ret 8
end
ret 0
end
fn main to int
if ne argcnt 2
ret 2
end
m = new uchar 8 0
k = argread 1 m 0 8
if lt k 1
ret 2
end
c = get m 0
if eq c 117
ret gmutate
end
if eq c 97
ret galarm
end
if eq c 109
i = ulong 0
while lt i 7500 bound 7500
gtext GLINE
i = add i 1
end
gflush
ret 0
end
if eq c 119
j = ulong 0
while lt j 7999 bound 7999
gtimes uchar 34 124
gput uchar 10
j = add j 1
end
gtimes uchar 34 124
gflush
ret 0
end
if eq c 98
gtimes uchar 97 1000000
gflush
ret 0
end
if eq c 103
gtimes uchar 113 300000
gflush
ret 0
end
if eq c 107
gxlines 8000
gflush
ret 0
end
if eq c 106
gxlines 8001
gflush
ret 0
end
if eq c 108
gxlines 10000
gflush
ret 0
end
if eq c 120
gnlines 50000
gflush
ret 0
end
if eq c 121
gnlines 200000
gflush
ret 0
end
if eq c 99
gput uchar 111
gput uchar 107
gput uchar 1
gput uchar 10
gflush
ret 0
end
if eq c 100
gput uchar 111
gput uchar 107
gput uchar 127
gput uchar 10
gflush
ret 0
end
ret 2
end

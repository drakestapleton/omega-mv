note gen.om: deterministic inputs for the pageunit gate (tests/pageunit/run.sh), so the runner
note itself only invokes programs and compares bytes. The first byte of argument 1 selects:
note m  900000 bytes: 7500 copies of the 120-byte line GLINE (quotes, backslashes, a tab, UTF-8)
note w  999999 bytes: 7999 lines of 124 quotes, then 124 quotes with no newline; 8000 records, the
note    largest enc output (tools/pageunit/enc.om proves the bound)
note b  1000000 bytes of a: enc must exit 3
note l  10000 lines of x: enc must exit 5
note j  8001 lines of x: enc must exit 5
note k  8000 lines of x: the most lines enc accepts
note c  ok, byte 1, newline: enc must exit 4
note d  ok, byte 127, newline: enc must exit 4
note u  stdin to stdout with the first lowercase letter after the first quote changed to upper
note    case: one byte inside the first text record of an enc unit (the mutant control)
note a  alarm: read a page on stdin (any size, streamed), print "bytes=N lines=R" (R counts a final
note    line without newline) and exit 8 when N >= 800000 or R >= 6400, that is within 20 percent of
note    the 1000000-byte and 8000-line refusals of enc.om; exit 0 below both
note p, q  799999 and 800000 bytes of a, no newline (one line): last quiet and first alarming size
note r, s  6399 and 6400 lines of x: last quiet and first alarming line count
note exit 0 ok, 2 usage or read error, 6 write error, 7 mode u found no letter to change, 8 alarm
global gb uchar 1048576
global gn ulong 1
global gi uchar 4194304
text GLINE "He said \"ok\"\tthen C:\\tmp\\x; café naïve 中文 Ελλάδα € 🙂 the quick brown fox jumps over the lazy dog, agai\n"
fn gflush to void
n = get gn 0
o = ulong 0
while lt o n bound 1048577
k = write 1 gb o sub n o
if le k 0
exit 6
end
o = add o ulong k
end
put gn 0 0
end
text ABYTES "bytes="
text ALINES " lines="
fn gdec v ulong to void
d = new uchar 20 0
k = ulong 0
x = v
while gt x 0 bound 20
put d k uchar add rem x 10 48
x = div x 10
k = add k 1
end
if eq k 0
gput uchar 48
end
while gt k 0 bound 20
k = sub k 1
gput get d k
end
end
fn galarm to int
note every pass reads at least one byte or ends the loop
nb = ulong 0
nl = ulong 0
last = uchar 10
go = ulong 1
while eq go 1 bound 9223372036854775807
k = read 0 gi 0 4194304
if lt k 0
ret 2
end
if eq k 0
go = ulong 0
else
n = ulong k
i = ulong 0
while lt i n bound 4194304
last = get gi i
if eq last 10
nl = add nl 1
end
i = add i 1
end
nb = add nb n
end
end
if gt nb 0
if ne last 10
nl = add nl 1
end
end
gtext ABYTES
gdec nb
gtext ALINES
gdec nl
gput uchar 10
gflush
if ge nb 800000
ret 8
end
if ge nl 6400
ret 8
end
ret 0
end
fn gput c uchar to void
p = get gn 0
put gb p c
p = add p 1
put gn 0 p
if eq p 1048576
gflush
end
end
fn gtimes c uchar k ulong to void
i = ulong 0
while lt i k bound 1000001
gput c
i = add i 1
end
end
fn gtext a view uchar * to void
n = len a
i = ulong 0
while lt i n bound 4097
gput get a i
i = add i 1
end
end
fn gxlines k ulong to void
i = ulong 0
while lt i k bound 10001
gput uchar 120
gput uchar 10
i = add i 1
end
end
fn gmutate to int
n = ulong 0
go = ulong 1
while eq go 1 bound 4194305
k = read 0 gi n sub 4194304 n
if lt k 0
ret 2
end
if eq k 0
go = ulong 0
else
n = add n ulong k
end
end
st = ulong 0
done = ulong 0
i = ulong 0
while lt i n bound 4194305
c = get gi i
if eq done 0
if eq st 0
if eq c 34
st = ulong 1
end
else
if ge c 97
if le c 122
put gi i uchar sub c 32
done = ulong 1
end
end
end
end
i = add i 1
end
if eq done 0
ret 7
end
o = ulong 0
while lt o n bound 4194305
w = write 1 gi o sub n o
if le w 0
ret 6
end
o = add o ulong w
end
ret 0
end
fn main to int
if ne argcnt 2
ret 2
end
m = new uchar 8 0
k = argread 1 m 0 8
if lt k 1
ret 2
end
c = get m 0
if eq c 117
ret gmutate
end
if eq c 97
ret galarm
end
if eq c 112
gtimes uchar 97 799999
gflush
ret 0
end
if eq c 113
gtimes uchar 97 800000
gflush
ret 0
end
if eq c 114
gxlines 6399
gflush
ret 0
end
if eq c 115
gxlines 6400
gflush
ret 0
end
if eq c 109
i = ulong 0
while lt i 7500 bound 7500
gtext GLINE
i = add i 1
end
else
if eq c 119
j = ulong 0
while lt j 7999 bound 7999
gtimes uchar 34 124
gput uchar 10
j = add j 1
end
gtimes uchar 34 124
else
if eq c 98
gtimes uchar 97 1000000
else
if eq c 108
gxlines 10000
else
if eq c 107
gxlines 8000
else
if eq c 106
gxlines 8001
else
if eq c 99
gput uchar 111
gput uchar 107
gput uchar 1
gput uchar 10
else
if eq c 100
gput uchar 111
gput uchar 107
gput uchar 127
gput uchar 10
else
ret 2
end
end
end
end
end
end
end
end
gflush
ret 0
end

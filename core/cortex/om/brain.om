note ---- routing (called from api.om) ----
note route ids 8 write, 9 read, 10 get, 11 confirm, 12 alerts, 13 records, 14 import, 15 usage
fn bn_route o ulong n ulong to ulong
if rq_eq o n pt_bwr
ret 8
end
if rq_eq o n pt_brd
ret 9
end
if rq_eq o n pt_bget
ret 10
end
if rq_eq o n pt_bcf
ret 11
end
if rq_eq o n pt_bal
ret 12
end
if rq_eq o n pt_brec
ret 13
end
if rq_eq o n pt_bimp
ret 14
end
if rq_eq o n pt_buse
ret 15
end
ret 0
end
note body string field f staged in hc (as entity content is)
fn bn_shc f ulong slot ulong to void
n = get dfs f
if eq n jnone
ret
end
if ne js_kind n 6
ret
end
js_str n
put ap slot stage_jsv_hc
end
note unsigned number field f (u64 max is kept apart from the NONE sentinel)
fn bn_snum f ulong slot ulong to void
n = get dfs f
if eq n jnone
ret
end
if ne js_kind n 3
ret
end
v = js_num n
if eq v NONE
v = sub v 1
end
put ap slot v
end
fn bn_de r ulong to ulong
if eq r 8
st = de_plain bs_wr by_wr bn_swr
if ne st 0
ret st
end
de_sstr 0 A_NAME
de_sstr 1 A_SPACE
de_sstr 2 B_KIND
de_sstr 3 B_OWN
de_sstr 4 B_DATE
bn_shc 5 B_BODY
de_sstr 6 B_SUP
ret 0
end
if eq r 9
st = de_plain bs_rd by_rd bn_srd
if ne st 0
ret st
end
de_sstr 0 A_Q
de_sstr 1 A_SPACE
bn_snum 2 A_LIMIT
ret 0
end
if eq r 10
st = de_plain bs_get by_get bn_sget
if ne st 0
ret st
end
de_sstr 0 A_NAME
de_sstr 1 A_SPACE
ret 0
end
ret bn_de2 r
end
fn bn_de2 r ulong to ulong
if eq r 11
st = de_plain bs_cf by_cf bn_scf
if ne st 0
ret st
end
de_sstr 0 A_NAME
de_sstr 1 A_SPACE
de_sstr 2 B_OWN
de_sstr 3 B_DATE
de_sstr 4 B_NEWID
ret 0
end
if eq r 12
st = de_plain bs_al by_al bn_sal
if ne st 0
ret st
end
de_sstr 0 A_SPACE
de_sstr 1 B_DATE
bn_snum 2 B_DAYS
de_sstr 3 B_TAX
ret 0
end
if eq r 13
st = de_plain bs_rec by_rec bn_srec
if ne st 0
ret st
end
de_sstr 0 A_SPACE
de_sstr 1 B_REG
de_sstr 2 B_TAX
ret 0
end
if eq r 14
st = de_plain bs_imp by_imp bn_simp
if ne st 0
ret st
end
bn_shc 0 B_TEXT
de_sstr 1 A_SPACE
de_sstr 2 B_OWN
de_sstr 3 B_DATE
ret 0
end
st = de_plain bs_use by_use bn_suse
if ne st 0
ret st
end
de_sstr 0 A_SPACE
bn_snum 1 A_LIMIT
ret 0
end
note the output buffer job holds 16 MiB and drops bytes past it (jobx = 1): refuse instead of
note sending a cut answer
fn bn_run r ulong to ulong
put bwr 0 0
put jobx 0 0
st = bn_run2 r
if eq get jobx 0 1
put jobx 0 0
ret bn_err 500 be_big
end
ret st
end
fn bn_run2 r ulong to ulong
if eq r 8
ret bn_write
end
if eq r 9
ret bn_read
end
if eq r 10
ret bn_get
end
if eq r 11
ret bn_confirm
end
if eq r 12
ret bn_alerts
end
if eq r 13
ret bn_records
end
if eq r 14
ret bn_import
end
ret bn_usage
end

note ---- bytes of a string reference (hs or hc) ----
fn bn_at r ulong i ulong to uchar
o = add rf_off r i
if ne and r RHC 0
ret hc_get o
end
ret hsg o
end
note r[a .. a+n) as a reference of the same pool
fn bn_sub r ulong a ulong n ulong to ulong
f = and r or RHC RDISK
ret or f rf_hs add rf_off r a n
end
note r holds the bytes of t at a
fn bn_eqt r ulong a ulong t view uchar * to bool
if lt rf_len r add a len t
ret false
end
for i ulong len t
if ne bn_at r add a i get t i
ret false
end
end
ret true
end
fn bn_iseq r ulong t view uchar * to bool
if eq r NONE
ret false
end
if ne rf_len r len t
ret false
end
ret bn_eqt r 0 t
end
note line r[p .. q) starts with t
fn bn_pfx r ulong p ulong q ulong t view uchar * to bool
if lt sub q p len t
ret false
end
ret bn_eqt r p t
end
note byte-equal references (any pools)
fn bn_eqr a ulong b ulong to bool
if or eq a NONE eq b NONE
ret eq a b
end
n = rf_len a
if ne n rf_len b
ret false
end
for i ulong 4611686018427387904
if ge i n
break
end
if ne bn_at a i bn_at b i
ret false
end
end
ret true
end
note index of the first newline at or after p, or the length
fn bn_eol r ulong p ulong to ulong
n = rf_len r
for k ulong 4611686018427387904
i = add p k
if ge i n
ret n
end
if eq bn_at r i 10
ret i
end
end
ret n
end
note copy r into jes from w0; returns the end
fn bn_tojes r ulong w0 ulong to ulong
n = rf_len r
for i ulong 4611686018427387904
if ge i n
break
end
put jes add w0 i bn_at r i
end
ret add w0 n
end
note stage the bytes of r in hs; returns the hs reference
fn bn_tohs r ulong to ulong
if eq r NONE
ret NONE
end
n = rf_len r
o = get hst 0
if gt add o n HSCAP
trap 9
end
for i ulong 4611686018427387904
if ge i n
break
end
hsp add o i bn_at r i
end
put hst 0 add o n
ret rf_hs o n
end
note stage text t followed by the bytes of r in hs
fn bn_stcat t view uchar * r ulong to ulong
o = get hst 0
x = stage_txt t
p = add o len t
n = rf_len r
for i ulong 4611686018427387904
if ge i n
break
end
hsp add p i bn_at r i
end
put hst 0 add p n
ret rf_hs o add len t n
end
note append the raw bytes of r to job
fn bn_jraw r ulong to void
n = rf_len r
for i ulong 4611686018427387904
if ge i n
break
end
js_byte bn_at r i
end
end
note JSON string of r
fn bn_oref r ulong to void
if eq r NONE
js_raw tnull
ret
end
n = bn_tojes r 0
js_esc_buf 0 n
end

note ---- errors ----
fn bn_err st ulong t view uchar * to ulong
put jobl 0 0
js_raw bx_err
js_esc_txt t
js_byte 125
ret st
end
fn bn_errr st ulong t view uchar * r ulong to ulong
put jobl 0 0
js_raw bx_err
for i ulong len t
put jes i get t i
end
n = bn_tojes r len t
js_esc_buf 0 n
js_byte 125
ret st
end
fn bn_errn st ulong t view uchar * ln ulong to ulong
put jobl 0 0
js_raw bx_err
for i ulong len t
put jes i get t i
end
n = len t
for i ulong len bx_line
put jes add n i get bx_line i
end
n = add n len bx_line
a = get jobl 0
js_u64 ln
m = sub get jobl 0 a
for i ulong m
put jes add n i get job add a i
end
put jobl 0 a
n = add n m
put jes n 41
js_esc_buf 0 add n 1
js_byte 125
ret st
end

note ---- validation ----
fn bn_kind r ulong to ulong
if bn_iseq r bk_dec
ret 1
end
if bn_iseq r bk_rule
ret 2
end
if bn_iseq r bk_case
ret 3
end
if bn_iseq r bk_chg
ret 4
end
if bn_iseq r bk_ctr
ret 5
end
if bn_iseq r bk_pty
ret 6
end
ret 0
end
fn bn_idok r ulong to bool
if eq r NONE
ret false
end
n = rf_len r
if eq n 0
ret false
end
if eq bn_at r 0 46
ret false
end
for i ulong 4611686018427387904
if ge i n
break
end
if not bn_idc bn_at r i
ret false
end
end
ret true
end
fn bn_idc c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret or or eq c 46 eq c 45 eq c 95
end
note non-empty, no control bytes; sp: also no space
fn bn_txtok r ulong sp bool to bool
if eq r NONE
ret false
end
n = rf_len r
if eq n 0
ret false
end
for i ulong 4611686018427387904
if ge i n
break
end
c = bn_at r i
if or lt c 32 eq c 127
ret false
end
if and sp eq c 32
ret false
end
end
ret true
end

note ---- dates: day numbers since 1970-01-01, proleptic Gregorian (Hinnant's civil algorithms) ----
fn bn_leap y long to bool
if ne rem y 4 0
ret false
end
if ne rem y 100 0
ret true
end
ret eq rem y 400 0
end
fn bn_dim y long m long to long
if eq m 2
if bn_leap y
ret 29
end
ret 28
end
if or or eq m 4 eq m 6 or eq m 9 eq m 11
ret 30
end
ret 31
end
fn bn_dfc y long m long dd long to long
yy = y
if le m 2
yy = sub y 1
end
era = div yy 400
if lt yy 0
era = div sub yy 399 400
end
yoe = sub yy mul era 400
doe = bn_doe yoe m dd
ret sub add mul era 146097 doe 719468
end
note day of the 400-year era from year of era, month and day
fn bn_doe yoe long m long dd long to long
mm = add m 9
if gt m 2
mm = sub m 3
end
doy = add div add mul 153 mm 2 5 sub dd 1
t = add mul yoe 365 div yoe 4
t = sub t div yoe 100
ret add t doy
end
note n decimal digits of r at a, -1 when one is not a digit
fn bn_dig r ulong a ulong n ulong to long
v = long 0
for i ulong n
c = bn_at r add a i
if or lt c 48 gt c 57
ret -1
end
v = add mul v 10 sub long c 48
end
ret v
end
note r is YYYY-MM-DD and a calendar date: its day number into bdy
fn bn_pdate r ulong to bool
if eq r NONE
ret false
end
if ne rf_len r 10
ret false
end
if or ne bn_at r 4 45 ne bn_at r 7 45
ret false
end
y = bn_dig r 0 4
m = bn_dig r 5 2
dd = bn_dig r 8 2
if or lt y 0 or lt m 1 gt m 12
ret false
end
if or lt dd 1 gt dd bn_dim y m
ret false
end
put bdy 0 bn_dfc y m dd
ret true
end
fn bn_put2 w0 ulong v long to void
put bdt w0 uchar add 48 div v 10
put bdt add w0 1 uchar add 48 rem v 10
end
note YYYY-MM-DD of day z into bdt[0 .. 10)
fn bn_fdate z long to void
zz = add z 719468
era = div zz 146097
if lt zz 0
era = div sub zz 146096 146097
end
doe = sub zz mul era 146097
yoe = div sub add sub doe div doe 1460 div doe 36524 div doe 146096 365
t = add mul 365 yoe div yoe 4
t = sub t div yoe 100
doy = sub doe t
mp = div add mul 5 doy 2 153
dd = add sub doy div add mul 153 mp 2 5 1
m = add mp 3
if ge mp 10
m = sub mp 9
end
y = add yoe mul era 400
if le m 2
y = add y 1
end
bn_put2 0 div y 100
bn_put2 2 rem y 100
put bdt 4 45
bn_put2 5 m
put bdt 7 45
bn_put2 8 dd
end
fn bn_today to long
tn = realns
ret div tn 86400000000000
end
fn bn_stdate z long to ulong
bn_fdate z
o = get hst 0
for i ulong 10
hsp add o i get bdt i
end
put hst 0 add o 10
ret rf_hs o 10
end

note ---- entries in the store ----
note entity e is a Brain entry: entityType "brain." + a known kind. The answer depends only on the
note type's dictionary entry (the dictionary is append-only), so it is kept per entry in bisd
note (0 not yet known, 1 Brain, 2 not): read before tests it for every row of a space.
global bisd uchar DMAX
fn bn_isb e ulong to bool
t = get ety e
c = get bisd t
if eq c 0
c = uchar 2
if bn_isb1 t
c = uchar 1
end
put bisd t c
end
ret eq c 1
end
fn bn_isb1 t ulong to bool
r = get dref t
if not bn_eqt r 0 bx_pfx
ret false
end
ret ne bn_kind bn_sub r 6 sub rf_len r 6 0
end
fn bn_kref e ulong to ulong
r = get dref get ety e
ret bn_sub r 6 sub rf_len r 6
end
fn bn_ekind e ulong to ulong
ret bn_kind bn_kref e
end
note a stored, not retracted Brain entry of space d (NONE: any space)
fn bn_in e ulong d ulong to bool
if ne get eret e 0
ret false
end
if and ne d NONE ne get esl e d
ret false
end
ret bn_isb e
end
note live: stored, not retracted and not superseded (bn_ensure first)
fn bn_live e ulong d ulong to bool
if not bn_in e d
ret false
end
ret eq get bsup e 0
end
note metadata of e parsed: owner and supersedes string nodes into bmn (jnone when absent)
fn bn_meta e ulong to void
put bmn 0 jnone
put bmn 1 jnone
r = get emd e
if eq r NONE
ret
end
n = rf_len r
o = rf_off r
for i ulong 4611686018427387904
if ge i n
break
end
put jin i hsg add o i
end
put jinl 0 n
put jrvm 0 1
if not js_parse
ret
end
t = get jroot 0
if ne js_kind t 8
ret
end
a = js_find t bx_kown
if ne a jnone
if eq js_kind a 6
put bmn 0 a
end
end
b = js_find t bx_ksup
if ne b jnone
if eq js_kind b 6
put bmn 1 b
end
end
end
note the supersedes target of entry e, or NONE
fn bn_target e ulong to ulong
bn_meta e
s = get bmn 1
if eq s jnone
ret NONE
end
js_str s
h = get hst 0
r = stage_jsv
t = mnm_find get esl e r
put hst 0 h
ret t
end
note full rebuild of bsup from the stored entries (d: one space; NONE: every space)
fn bn_index d ulong to void
n = get nent 0
for e ulong 4611686018427387904
if ge e n
break
end
put bsup e 0
end
for e ulong 4611686018427387904
if ge e n
break
end
if bn_in e d
t = bn_target e
if and ne t NONE ne t e
if bn_in t get esl e
put bsup t add e 1
end
end
end
end
end
note the live index, rebuilt only when it is stale (at start, after a retract or hard delete)
fn bn_ensure to void
if eq get bvi 0 1
ret
end
bn_index NONE
put bvi 0 1
end
note a retract or hard delete can make a superseded entry live again or remove slots: rebuild on
note the next request (called from api3.om)
fn bn_stale to void
put bvi 0 0
end
note consistency check: mismatches between the live index and a full rebuild (NONE when the live index
note is stale); the rebuilt index is kept
fn bn_icheck to ulong
if ne get bvi 0 1
ret NONE
end
n = get nent 0
for e ulong 4611686018427387904
if ge e n
break
end
put bsc e get bsup e
end
bn_index NONE
k = ulong 0
for e ulong 4611686018427387904
if ge e n
break
end
if ne get bsc e get bsup e
k = add k 1
end
end
ret k
end
fn bn_space to ulong
sp = get ap A_SPACE
if eq sp NONE
sp = stage_txt bx_space
put ap A_SPACE sp
end
ret sp
end
note string node n as JSON (null for jnone)
fn bn_onode n ulong to void
if eq n jnone
js_raw tnull
ret
end
js_str n
m = get jsvl 0
for i ulong 4611686018427387904
if ge i m
break
end
put jes i get jsv i
end
js_esc_buf 0 m
end
note the entry object of e
fn bn_oent e ulong to void
js_raw bo_id
o_hs get enm e
js_raw bo_sp
o_hs get dref get esl e
js_raw bo_kd
o_hs bn_kref e
js_raw bo_dt
o_hs get evf e
bn_meta e
js_raw bo_ow
bn_onode get bmn 0
js_raw bo_su
bn_onode get bmn 1
js_raw bo_sb
s = get bsup e
if eq s 0
js_raw tnull
else
o_hs get enm sub s 1
end
js_raw bo_rt
if eq get eret e 0
js_raw tfalse
js_raw bo_bd
bn_oref get ect e
else
js_raw ttrue
js_raw bo_bd
js_raw tnull
end
js_byte 125
end

note ---- structured records (contract, party): one `key: value` per line ----
fn bn_klen c ulong to ulong
if eq c 1
ret len bc_dt
end
if eq c 2
ret len bc_reg
end
if eq c 3
ret len bc_sub
end
if eq c 4
ret len bc_pty
end
if eq c 5
ret len bc_date
end
if eq c 6
ret len bc_conf
end
if eq c 7
ret len bc_note
end
if eq c 8
ret len bc_name
end
ret len bc_tax
end
fn bn_lkey r ulong p ulong q ulong to ulong
if bn_pfx r p q bc_dt
ret 1
end
if bn_pfx r p q bc_reg
ret 2
end
if bn_pfx r p q bc_sub
ret 3
end
if bn_pfx r p q bc_pty
ret 4
end
if bn_pfx r p q bc_date
ret 5
end
if bn_pfx r p q bc_conf
ret 6
end
if bn_pfx r p q bc_note
ret 7
end
if bn_pfx r p q bc_name
ret 8
end
if bn_pfx r p q bc_tax
ret 9
end
ret 0
end
fn bn_doct v ulong to ulong
if bn_iseq v bd_1
ret 1
end
if bn_iseq v bd_2
ret 2
end
if bn_iseq v bd_3
ret 3
end
if bn_iseq v bd_4
ret 4
end
if bn_iseq v bd_5
ret 5
end
if bn_iseq v bd_6
ret 6
end
ret 0
end
note date kind of a date value: 1 hard_expiry, 2 on_completion, 3 submission_deadline, 4 extension, 5 start
fn bn_dkind v ulong to ulong
if bn_eqt v 0 bq_1
ret 1
end
if bn_eqt v 0 bq_2
ret 2
end
if bn_eqt v 0 bq_3
ret 3
end
if bn_eqt v 0 bq_4
ret 4
end
if bn_eqt v 0 bq_5
ret 5
end
ret 0
end
fn bn_dklen k ulong to ulong
if eq k 1
ret len bq_1
end
if eq k 2
ret len bq_2
end
if eq k 3
ret len bq_3
end
if eq k 4
ret len bq_4
end
ret len bq_5
end
note a date value "KIND YYYY-MM-DD" (or "on_completion -"): its kind (0 = invalid); bdh/bdy the date
fn bn_dline v ulong to ulong
k = bn_dkind v
if eq k 0
ret 0
end
a = bn_dklen k
w = bn_sub v a sub rf_len v a
put bdh 0 0
if bn_iseq w bv_dash
if eq k 2
ret k
end
ret 0
end
if not bn_pdate w
ret 0
end
put bdh 0 1
ret k
end
fn bn_okind k ulong to void
if eq k 1
js_raw bo_k1
end
if eq k 2
js_raw bo_k2
end
if eq k 3
js_raw bo_k3
end
if eq k 4
js_raw bo_k4
end
if eq k 5
js_raw bo_k5
end
end
note check one line of a record of kind k (5 contract, 6 party); 0 ok, 1 bad
fn bn_vline r ulong p ulong q ulong k ulong to ulong
if eq p q
ret 0
end
c = bn_lkey r p q
if eq c 0
ret 1
end
if eq k 5
if gt c 7
ret 1
end
else
if and ne c 7 lt c 8
ret 1
end
end
put bvc c add get bvc c 1
a = add p bn_klen c
if ge a q
ret 1
end
v = bn_sub r a sub q a
ret bn_vval c v
end
fn bn_vval c ulong v ulong to ulong
if eq c 1
if eq bn_doct v 0
ret 1
end
end
if or eq c 4 eq c 9
if not bn_txtok v true
ret 1
end
end
if eq c 5
if eq bn_dline v 0
ret 1
end
end
if eq c 6
if bn_iseq v bv_yes
put bvc 10 1
else
if not bn_iseq v bv_no
ret 1
end
end
end
ret 0
end
note validate a record body; 0 ok, else the error status (422) with the text in job
fn bn_vrec r ulong k ulong to ulong
for i ulong len bvc
put bvc i 0
end
n = rf_len r
p = ulong 0
for ln ulong 4611686018427387904
if gt p n
break
end
q = bn_eol r p
if ne bn_vline r p q k 0
if eq k 5
ret bn_errn 422 be_rec add ln 1
end
ret bn_errn 422 be_pty add ln 1
end
p = add q 1
end
if eq k 5
if not bn_rcnt
ret bn_err 422 be_rcnt
end
ret 0
end
if or ne get bvc 8 1 eq get bvc 9 0
ret bn_err 422 be_pcnt
end
ret 0
end
note one doc_type line, at most one registry_id, subject and confirmed line
fn bn_rcnt to bool
if ne get bvc 1 1
ret false
end
if gt get bvc 2 1
ret false
end
if gt get bvc 3 1
ret false
end
ret le get bvc 6 1
end
note r with "confirmed: no" appended as a new line (staged in hc)
fn bn_addno r ulong to ulong
n = rf_len r
o = get hct 0
m = add add n 1 len bx_cno
if gt add o m HCCAP
trap 9
end
for i ulong 4611686018427387904
if ge i n
break
end
hc_put add o i bn_at r i
end
k = n
if gt n 0
if ne bn_at r sub n 1 10
hc_put add o k 10
k = add k 1
end
end
for i ulong len bx_cno
hc_put add o add k i get bx_cno i
end
k = add k len bx_cno
put hct 0 add o k
ret rf_hc o k
end
note r with its "confirmed: no" line made "confirmed: yes" (staged in hc)
fn bn_setconf r ulong to ulong
n = rf_len r
o = get hct 0
if gt add o add n 1 HCCAP
trap 9
end
w = ulong 0
p = ulong 0
for ln ulong 4611686018427387904
if gt p n
break
end
q = bn_eol r p
if bn_iseq bn_sub r p sub q p bx_cno
for i ulong len bx_cyes
hc_put add o add w i get bx_cyes i
end
w = add w len bx_cyes
else
for i ulong 4611686018427387904
if ge i sub q p
break
end
hc_put add o add w i bn_at r add p i
end
w = add w sub q p
end
if lt q n
hc_put add o w 10
w = add w 1
end
p = add q 1
end
put hct 0 add o w
ret rf_hc o w
end
note the record body r has a "confirmed: yes" line
fn bn_conf r ulong to bool
n = rf_len r
p = ulong 0
for ln ulong 4611686018427387904
if gt p n
break
end
q = bn_eol r p
if bn_iseq bn_sub r p sub q p bx_cyes
ret true
end
p = add q 1
end
ret false
end
note value of the first line with key t, or NONE
fn bn_fval r ulong t view uchar * to ulong
n = rf_len r
p = ulong 0
for ln ulong 4611686018427387904
if gt p n
break
end
q = bn_eol r p
if bn_pfx r p q t
a = add p len t
ret bn_sub r a sub q a
end
p = add q 1
end
ret NONE
end
note the party body r lists tax ID v
fn bn_hastax r ulong v ulong to bool
n = rf_len r
p = ulong 0
for ln ulong 4611686018427387904
if gt p n
break
end
q = bn_eol r p
if bn_pfx r p q bc_tax
a = add p len bc_tax
if bn_eqr bn_sub r a sub q a v
ret true
end
end
p = add q 1
end
ret false
end
note the live party record of space d that lists tax ID v (first by slot), or NONE
fn bn_cpty v ulong d ulong to ulong
for e ulong 4611686018427387904
if ge e get nent 0
break
end
if bn_live e d
if eq bn_ekind e 6
if bn_hastax get ect e v
ret e
end
end
end
end
ret NONE
end
note a party of contract body r is tax ID t or belongs to the same counterparty (party slot cp)
fn bn_taxm r ulong cp ulong t ulong to bool
n = rf_len r
p = ulong 0
for ln ulong 4611686018427387904
if gt p n
break
end
q = bn_eol r p
if bn_pfx r p q bc_pty
a = add p len bc_pty
v = bn_sub r a sub q a
if bn_eqr v t
ret true
end
if ne cp NONE
if bn_hastax get ect cp v
ret true
end
end
end
p = add q 1
end
ret false
end
note structured kinds: validate the body; contract: append "confirmed: no" when absent and refuse
note "confirmed: yes" unless conf (a person's import)
fn bn_body k ulong conf bool to ulong
if lt k 5
ret 0
end
st = bn_vrec get ap B_BODY k
if ne st 0
ret st
end
if eq k 6
ret 0
end
if eq get bvc 6 0
put ap B_BODY bn_addno get ap B_BODY
ret 0
end
if and not conf eq get bvc 10 1
ret bn_err 422 be_cyes
end
ret 0
end

note ---- write after ----
note the id of a correction of entry id r in space d: "<r>-c<k>" with the smallest k >= 1 not in use
fn bn_nextid r ulong d ulong to ulong
for k ulong 4611686018427387904
h = get hst 0
c = bn_tohs r
x = stage_txt bx_csfx
bn_stdec add k 1
c = rf_hs rf_off c sub get hst 0 rf_off c
if eq mnm_find d c NONE
ret c
end
put hst 0 h
end
ret NONE
end
note stage the decimal digits of v in hs
fn bn_stdec v ulong to void
a = get jobl 0
js_u64 v
x = stage_job a
end
note entry fields of a new entry (A_NAME id, B_KIND, B_OWN, B_DATE, B_BODY, B_SUP); conf: import
fn bn_wchk conf bool to ulong
if eq get ap A_NAME NONE
put ap A_NAME stage_uuid
end
if not bn_idok get ap A_NAME
ret bn_err 422 be_id
end
k = bn_kind get ap B_KIND
if eq k 0
ret bn_err 422 be_kind
end
if not bn_txtok get ap B_OWN false
ret bn_err 422 be_own
end
if eq get ap B_DATE NONE
put ap B_DATE bn_stdate bn_today
end
if not bn_pdate get ap B_DATE
ret bn_err 422 be_date
end
if ne get ap B_SUP NONE
if not bn_idok get ap B_SUP
ret bn_err 422 be_supid
end
end
ret bn_body k conf
end
note the id is free and the supersedes target is a live entry of space d (bn_index d first)
fn bn_wlink d ulong to ulong
if ne d NONE
if ne mnm_find d get ap A_NAME NONE
ret bn_errr 409 be_dup get ap A_NAME
end
end
s = get ap B_SUP
if eq s NONE
ret 0
end
t = NONE
if ne d NONE
t = mnm_find d s
end
if eq t NONE
ret bn_errr 404 be_nsup s
end
if not bn_in t d
ret bn_errr 404 be_nsup s
end
if ne get bsup t 0
ret bn_errr 409 be_ssup s
end
ret 0
end
note append the entry through the entity upsert (one ENTITY record, flushed before the answer);
note returns its slot
fn bn_commit to ulong
put ap A_TYPE bn_stcat bx_pfx get ap B_KIND
put ap A_CONT get ap B_BODY
put ap A_ALIAS stage_txt tarr0
a = get jobl 0
js_byte 123
js_raw bx_mown
o_hs get ap B_OWN
if ne get ap B_SUP NONE
js_raw bo_su
o_hs get ap B_SUP
end
js_byte 125
put ap A_META stage_job a
put ap A_CONF bitcast ulong f64 1.0
put ap A_VF get ap B_DATE
put ap A_VT NONE
put ap A_ID NONE
put bwr 0 1
st = api_upsert
put bwr 0 0
put jobl 0 0
if ne st 201
trap 9
end
d = dict_find get ap A_SPACE
e = mnm_find d get ap A_NAME
put bsup e 0
note incremental update of the live index: the new entry supersedes its target
s = get ap B_SUP
if ne s NONE
t = mnm_find d s
put bsup t add e 1
end
ret e
end
fn bn_write to ulong
sp = bn_space
if not scope_ok sp
js_raw e403
ret 403
end
st = bn_wchk false
if ne st 0
ret st
end
d = dict_find sp
if ne d NONE
bn_ensure
end
st = bn_wlink d
if ne st 0
ret st
end
e = bn_commit
js_raw bo_rec
bn_oent e
js_byte 125
ret 201
end
note api_upsert guard: entities of a Brain type, or named like a stored entry, are written only here
fn bn_guard sp ulong to bool
if eq get bwr 0 1
ret false
end
x = false
if bn_eqt get ap A_TYPE 0 bx_pfx
x = true
end
d = dict_find sp
if ne d NONE
e = mnm_find d get ap A_NAME
if ne e NONE
if bn_isb e
x = true
end
end
end
i = get ap A_ID
if ne i NONE
f = mid_find i
if ne f NONE
if bn_isb f
x = true
end
end
end
if x
js_raw be_guard
end
ret x
end

note ---- read before ----
fn bn_tokc c uchar to bool
if ge c 128
ret true
end
ret bn_idc c
end
fn bn_qput c uchar to bool
n = get qql 0
if ge n len qq
ret false
end
put qq n c
put qql 0 add n 1
ret true
end
note FTS5 query: every token of the task as a quoted string, joined by OR
fn bn_match to bool
put qql 0 0
q = get ap A_Q
n = rf_len q
w = false
for i ulong 4611686018427387904
if ge i n
break
end
c = bn_at q i
ok = true
if bn_tokc c
if not w
ok = bn_qopen
w = true
end
ok = and ok bn_qput c
else
if w
ok = bn_qput 34
w = false
end
end
if not ok
ret false
end
end
if w
ret bn_qput 34
end
ret true
end
fn bn_qopen to bool
ok = true
if gt get qql 0 0
ok = and ok bn_qput 32
ok = and ok bn_qput 79
ok = and ok bn_qput 82
ok = and ok bn_qput 32
end
ret and ok bn_qput 34
end
fn bn_read to ulong
sp = bn_space
if not scope_ok sp
js_raw e403
ret 403
end
lim = get ap A_LIMIT
if eq lim NONE
lim = 10
end
n = ulong 0
d = dict_find sp
if ne d NONE
if not bn_match
ret bn_err 413 be_long
end
if gt get qql 0 0
n = bn_fts d lim
if eq n NONE
if eq get qerr 0 2
ret bn_err 413 be_fcap
end
ret bn_err 500 be_fts
end
end
end
put jobl 0 0
js_raw bo_rd1
o_hs sp
js_raw bo_rd2
o_hs get ap A_Q
js_raw bo_rd3
if gt n 0
js_raw ttrue
else
js_raw tfalse
end
js_raw bo_rd4
bn_orows n
js_raw bo_rd5
bn_ocite n
js_byte 93
if eq n 0
js_raw bo_nosup
end
js_byte 125
ret 200
end
note ranked FTS rows over the live entries of d; NONE when the query failed (qerr)
fn bn_fts d ulong lim ulong to ulong
bn_ensure
e = fts_gfirst d
for a ulong 4611686018427387904
if eq e NONE
break
end
v = uchar 0
if bn_live e d
v = 1
end
put qok e v
e = fts_gnext e
end
put qgsel 0 d
put qlim 0 lim
n = fts_search
if ne get qerr 0 0
ret NONE
end
ret n
end
fn bn_orows n ulong to void
for i ulong n
if gt i 0
js_byte 44
end
js_raw bo_rank
js_u64 add i 1
js_raw bo_sc
js_f64 bitcast ulong neg get qrb i
js_raw bo_ent
bn_oent get qrd i
js_byte 125
end
end
note citations: the id and date of every entry returned, in rank order
fn bn_ocite n ulong to void
for i ulong n
e = get qrd i
if gt i 0
js_byte 44
end
js_raw bo_id
o_hs get enm e
js_raw bo_cdt
o_hs get evf e
js_byte 125
end
end

note ---- get, confirm ----
fn bn_get to ulong
sp = bn_space
if not scope_ok sp
js_raw e403
ret 403
end
d = dict_find sp
e = NONE
if ne d NONE
e = mnm_find d get ap A_NAME
end
if eq e NONE
ret bn_errr 404 be_nf get ap A_NAME
end
if not bn_isb e
ret bn_errr 404 be_nf get ap A_NAME
end
bn_ensure
put jobl 0 0
js_raw bo_get
bn_oent e
js_byte 125
ret 200
end
fn bn_confirm to ulong
sp = bn_space
if not scope_ok sp
js_raw e403
ret 403
end
d = dict_find sp
t = NONE
if ne d NONE
bn_ensure
t = mnm_find d get ap A_NAME
end
if eq t NONE
ret bn_errr 404 be_nf get ap A_NAME
end
if not bn_live t d
ret bn_errr 409 be_nctr get ap A_NAME
end
if ne bn_ekind t 5
ret bn_errr 409 be_nctr get ap A_NAME
end
if bn_conf get ect t
ret bn_errr 409 be_conf get ap A_NAME
end
put ap B_SUP get ap A_NAME
put ap A_NAME get ap B_NEWID
if eq get ap A_NAME NONE
put ap A_NAME bn_nextid get ap B_SUP d
end
put ap B_KIND stage_txt bk_ctr
put ap B_BODY bn_setconf get ect t
st = bn_wchk true
if ne st 0
ret st
end
st = bn_wlink d
if ne st 0
ret st
end
e = bn_commit
js_raw bo_rec
bn_oent e
js_byte 125
ret 201
end

note ---- contract alerts and records ----
note alert window: day y with date <= y <= date + days (integer day numbers, both ends included)
fn bn_inwin y long to bool
dd = get bfd 0
if lt y dd
ret false
end
ret le ulong sub y dd get bfa 3
end
note key (y, name of e, p) greater than the key stored at bal[b .. b+2]
fn bn_kgt y long e ulong p ulong b ulong to bool
sy = get bal b
if ne y sy
ret gt y sy
end
se = ulong get bal add b 1
if ne e se
ret gt hs_cmp get enm e get enm se 0
end
ret gt long p get bal add b 2
end
fn bn_kput b ulong y long e ulong p ulong to void
put bal b y
put bal add b 1 long e
put bal add b 2 long p
end
note e is a live, confirmed contract record of d that matches the tax filter
fn bn_aok e ulong d ulong to bool
if not bn_live e d
ret false
end
if ne bn_ekind e 5
ret false
end
if not bn_conf get ect e
ret false
end
t = get bfa 0
if eq t NONE
ret true
end
ret bn_taxm get ect e get bfa 1 t
end
note candidate line r[p .. q) of contract e: a dated key date (not start) inside the window,
note after the last key emitted and before the best key of this pass
fn bn_acand e ulong r ulong p ulong q ulong to void
if not bn_pfx r p q bc_date
ret
end
a = add p len bc_date
k = bn_dline bn_sub r a sub q a
if or eq k 0 eq k 5
ret
end
if eq get bdh 0 0
ret
end
y = get bdy 0
if not bn_inwin y
ret
end
if eq get bal 3 1
if not bn_kgt y e p 0
ret
end
end
if eq get bal 7 1
if bn_kgt y e p 4
ret
end
end
bn_kput 4 y e p
put bal 7 1
end
fn bn_ascan e ulong to void
r = get ect e
n = rf_len r
p = ulong 0
for ln ulong 4611686018427387904
if gt p n
ret
end
q = bn_eol r p
bn_acand e r p q
p = add q 1
end
end
note one selection pass: the smallest alert key after the last one; false when none is left
fn bn_apass d ulong to bool
put bal 7 0
for e ulong 4611686018427387904
if ge e get nent 0
break
end
if bn_aok e d
bn_ascan e
end
end
if eq get bal 7 0
ret false
end
bn_kput 0 get bal 4 ulong get bal 5 ulong get bal 6
put bal 3 1
ret true
end
fn bn_oparties r ulong d ulong to void
js_raw bo_apt
n = rf_len r
p = ulong 0
w = false
for ln ulong 4611686018427387904
if gt p n
break
end
q = bn_eol r p
if bn_pfx r p q bc_pty
a = add p len bc_pty
v = bn_sub r a sub q a
if w
js_byte 44
end
w = true
js_raw bo_ptx
bn_oref v
js_raw bo_pcp
c = bn_cpty v d
if eq c NONE
js_raw tnull
else
o_hs get enm c
end
js_byte 125
end
p = add q 1
end
js_byte 93
end
fn bn_oalert d ulong to void
e = ulong get bal 1
p = ulong get bal 2
r = get ect e
q = bn_eol r p
a = add p len bc_date
v = bn_sub r a sub q a
k = bn_dline v
y = get bdy 0
js_raw bo_aid
o_hs get enm e
js_raw bo_aed
o_hs get evf e
bn_meta e
js_raw bo_ow
bn_onode get bmn 0
js_raw bo_adt
bn_oref bn_fval r bc_dt
js_raw bo_arg
bn_oref bn_fval r bc_reg
js_raw bo_akd
bn_okind k
js_raw bo_akt
bn_oref bn_sub v bn_dklen k 10
js_raw bo_adl
js_u64 ulong sub y get bfd 0
bn_oparties r d
js_byte 125
end
fn bn_aloop d ulong to void
k = ulong 0
for i ulong 4611686018427387904
if not bn_apass d
ret
end
if gt k 0
js_byte 44
end
bn_oalert d
k = add k 1
end
end
fn bn_alerts to ulong
sp = bn_space
if not scope_ok sp
js_raw e403
ret 403
end
if not bn_pdate get ap B_DATE
ret bn_err 422 be_date
end
put bfd 0 get bdy 0
dd = get ap B_DAYS
if eq dd NONE
ret bn_err 422 be_days
end
put bfa 3 dd
put bfa 0 get ap B_TAX
put bfa 1 NONE
put bal 3 0
put jobl 0 0
js_raw bo_rd1
o_hs sp
js_raw bo_al1
o_hs get ap B_DATE
js_raw bo_al2
js_u64 dd
js_raw bo_al3
d = dict_find sp
if ne d NONE
bn_ensure
if ne get bfa 0 NONE
put bfa 1 bn_cpty get bfa 0 d
end
bn_aloop d
end
js_raw bo_end
ret 200
end
note e is a live contract record of d matching the registry and tax filters
fn bn_rok e ulong d ulong to bool
if not bn_live e d
ret false
end
if ne bn_ekind e 5
ret false
end
g = get ap B_REG
if ne g NONE
if not bn_eqr bn_fval get ect e bc_reg g
ret false
end
end
t = get bfa 0
if eq t NONE
ret true
end
ret bn_taxm get ect e get bfa 1 t
end
note one pass: the smallest (entry date, id) after the last one
fn bn_rpass d ulong to bool
put bal 7 0
for e ulong 4611686018427387904
if ge e get nent 0
break
end
if bn_rok e d
x = bn_pdate get evf e
y = get bdy 0
ok = true
if eq get bal 3 1
ok = bn_kgt y e 0 0
end
if eq get bal 7 1
if bn_kgt y e 0 4
ok = false
end
end
if ok
bn_kput 4 y e 0
put bal 7 1
end
end
end
if eq get bal 7 0
ret false
end
bn_kput 0 get bal 4 ulong get bal 5 0
put bal 3 1
ret true
end
fn bn_records to ulong
sp = bn_space
if not scope_ok sp
js_raw e403
ret 403
end
put bfa 0 get ap B_TAX
put bfa 1 NONE
put bal 3 0
put jobl 0 0
js_raw bo_rd1
o_hs sp
js_raw bo_recs
d = dict_find sp
if ne d NONE
bn_ensure
if ne get bfa 0 NONE
put bfa 1 bn_cpty get bfa 0 d
end
k = ulong 0
for i ulong 4611686018427387904
if not bn_rpass d
break
end
if gt k 0
js_byte 44
end
e = ulong get bal 1
js_raw bo_cfd
if bn_conf get ect e
js_raw ttrue
else
js_raw tfalse
end
js_raw bo_ent
bn_oent e
js_byte 125
k = add k 1
end
end
js_raw bo_end
ret 200
end

note ---- import of a hand-corrected export file ----
note header lines up to the first blank line: bhd 0 id, 1 space, 2 kind, 3 body (NONE when absent)
fn bn_hdr r ulong to bool
for i ulong 4
put bhd i NONE
end
n = rf_len r
p = ulong 0
for ln ulong 4611686018427387904
if ge p n
ret false
end
q = bn_eol r p
if eq p q
put bhd 3 bn_sub r add q 1 sub sub n q 1
ret and ne get bhd 0 NONE ne get bhd 2 NONE
end
bn_hline r p q
p = add q 1
end
ret false
end
fn bn_hline r ulong p ulong q ulong to void
if bn_pfx r p q bh_id
a = add p len bh_id
put bhd 0 bn_sub r a sub q a
end
if bn_pfx r p q bh_sp
a = add p len bh_sp
put bhd 1 bn_sub r a sub q a
end
if bn_pfx r p q bh_kd
a = add p len bh_kd
put bhd 2 bn_sub r a sub q a
end
end
note kind k and body b equal those of entry e
fn bn_same e ulong k ulong b ulong to bool
if ne bn_ekind e k
ret false
end
ret bn_eqr get ect e b
end
fn bn_import to ulong
if not bn_hdr get ap B_TEXT
ret bn_err 422 be_hdr
end
if ne get bhd 1 NONE
put ap A_SPACE bn_tohs get bhd 1
end
sp = bn_space
if not scope_ok sp
js_raw e403
ret 403
end
idr = bn_tohs get bhd 0
d = dict_find sp
e = NONE
if ne d NONE
e = mnm_find d idr
end
if eq e NONE
ret bn_errr 404 be_nf idr
end
if not bn_in e d
ret bn_errr 404 be_nf idr
end
kr = bn_tohs get bhd 2
k = bn_kind kr
if eq k 0
ret bn_err 422 be_kind
end
b = get bhd 3
bn_ensure
if bn_same e k b
ret bn_isame e
end
s = get bsup e
if ne s 0
if bn_same sub s 1 k b
ret bn_isame sub s 1
end
ret bn_errr 409 be_simp get enm sub s 1
end
put ap A_NAME bn_nextid idr d
put ap B_KIND kr
put ap B_BODY b
put ap B_SUP idr
st = bn_wchk true
if ne st 0
ret st
end
st = bn_wlink d
if ne st 0
ret st
end
f = bn_commit
js_raw bo_chg
bn_oent f
js_byte 125
ret 201
end
fn bn_isame e ulong to ulong
put jobl 0 0
js_raw bo_same
bn_oent e
js_byte 125
ret 200
end

note ---- usage: the store's fixed capacities beside their fill, and the alarm list ----
note alarms names every quantity whose fill is at or above alarmPercent (default 50) of its capacity;
note the gate (tests/brain/load.sh) fails when the list is not empty. Nothing is refused here.
fn bn_usage to ulong
p = get ap A_LIMIT
if eq p NONE
p = 50
end
put jobl 0 0
js_raw bu_1
js_u64 get nent 0
js_raw bu_2
js_u64 EMAX
js_raw bu_3
js_u64 get nc 0
js_raw bu_4
js_u64 CMAX
js_raw bu_5
js_u64 get ns 0
js_raw bu_6
js_u64 SMAX
js_raw bu_7
js_u64 get nd 0
js_raw bu_8
js_u64 DMAX
js_raw bu_9
js_u64 get hsn 0
js_raw bu_10
js_u64 HSCAP
js_raw bu_11
js_u64 get hcn 0
js_raw bu_12
js_u64 HCCAP
js_raw bu_13
js_u64 fts_tokens
js_raw bu_14
js_u64 QTKN
js_raw bu_16
js_u64 fts_rows
js_raw bu_17
js_u64 QD
js_raw bu_15
k = ulong 0
for e ulong 4611686018427387904
if ge e get nent 0
break
end
if bn_in e NONE
k = add k 1
end
end
js_u64 k
js_raw bu_20
m = bn_icheck
if eq m NONE
js_raw tnull
else
js_u64 m
end
js_raw bu_21
js_u64 fts_icheck
js_raw bu_18
js_u64 p
js_raw bu_19
bn_alarms p
js_raw bo_end
ret 200
end
fn bn_alarms p ulong to void
put bfa 2 0
bn_alarm bn_n1 get nent 0 EMAX p
bn_alarm bn_n2 get nc 0 CMAX p
bn_alarm bn_n3 get ns 0 SMAX p
bn_alarm bn_n4 get nd 0 DMAX p
bn_alarm bn_n5 get hsn 0 HSCAP p
bn_alarm bn_n6 get hcn 0 HCCAP p
bn_alarm bn_n7 fts_tokens QTKN p
bn_alarm bn_n8 fts_rows QD p
end
note name t when used * 100 >= cap * p (bfa 2 counts the names written)
fn bn_alarm t view uchar * u ulong c ulong p ulong to void
if lt mul u 100 mul c p
ret
end
if gt get bfa 2 0
js_byte 44
end
js_esc_txt t
put bfa 2 add get bfa 2 1
end

note ---- plain-file export: cortex --log LOG --brain-export DIR (read-only, offline) ----
note DIR/<space>/<kind>/<YYYY-MM-DD>/<id>.txt for every stored (not retracted) entry, superseded ones
note included. The log is opened read-only and replayed without cutting a torn tail or compacting,
note so it is safe beside a running server (it sees the records complete when it starts).
fn bn_ropen to int
fd = fopen lpath 0 get lpl 0 524288 0
if lt fd 0
ret -1
end
sz = fseek int fd 0 2
if lt sz 8
ret -2
end
r = pread int fd klr 0 8 0
if ne r 8
ret -1
end
for i ulong 8
if ne get klr i get lmagic i
ret -2
end
end
put lgs 0 ulong fd
put lgs 1 ulong sz
put lgs 3 ulong fd
ret 0
end
note a path segment: non-empty, not . or .., no / and no NUL
fn bn_segok r ulong to bool
n = rf_len r
if eq n 0
ret false
end
if and le n 2 eq bn_at r 0 46
if eq n 1
ret false
end
if eq bn_at r 1 46
ret false
end
end
for i ulong 4611686018427387904
if ge i n
break
end
c = bn_at r i
if or eq c 47 eq c 0
ret false
end
end
ret true
end
note append "/" and r to the path in bpb (false past PATH_MAX, a limit of the kernel)
fn bn_pcat r ulong to bool
n = rf_len r
o = get bpbl 0
if ge add add o n 1 len bpb
ret false
end
put bpb o 47
for i ulong n
put bpb add add o 1 i bn_at r i
end
put bpbl 0 add add o 1 n
ret true
end
fn bn_mkd to bool
x = makedir bpb 0 get bpbl 0 493
ret or eq x 0 eq x -17
end
fn bn_xpath e ulong to bool
for i ulong get bxdl 0
put bpb i get bxd i
end
put bpbl 0 get bxdl 0
s = get dref get esl e
k = bn_kref e
v = get evf e
if not and and bn_segok s bn_idok get enm e bn_pdate v
ret false
end
ok = bn_pcat s
if ok
ok = bn_mkd
end
if ok
ok = bn_pcat k
end
if ok
ok = bn_mkd
end
if ok
ok = bn_pcat v
end
if ok
ok = bn_mkd
end
if ok
ok = bn_pcat get enm e
end
if not ok
ret false
end
n = get bpbl 0
if ge add n len bh_txt len bpb
ret false
end
for i ulong len bh_txt
put bpb add n i get bh_txt i
end
put bpbl 0 add n len bh_txt
ret true
end
note the export file of entry e into job
fn bn_xtext e ulong to void
put jobl 0 0
js_raw bh_id
bn_jraw get enm e
js_byte 10
js_raw bh_sp
bn_jraw get dref get esl e
js_byte 10
js_raw bh_kd
bn_jraw bn_kref e
js_byte 10
js_raw bh_dt
bn_jraw get evf e
js_byte 10
bn_meta e
js_raw bh_ow
bn_jnode get bmn 0
js_byte 10
if ne get bmn 1 jnone
js_raw bh_su
bn_jnode get bmn 1
js_byte 10
end
s = get bsup e
if ne s 0
js_raw bh_sb
bn_jraw get enm sub s 1
js_byte 10
end
js_byte 10
bn_jraw get ect e
end
fn bn_jnode n ulong to void
if eq n jnone
ret
end
js_str n
m = get jsvl 0
for i ulong 4611686018427387904
if ge i m
break
end
js_byte get jsv i
end
end
fn bn_xone e ulong to int
if not bn_xpath e
say bm_bad
put jobl 0 0
js_raw bh_id
bn_jraw get enm e
js_byte 10
w = write 2 job 0 get jobl 0
ret 3
end
bn_xtext e
fd = fopen bpb 0 get bpbl 0 524481 420
if lt fd 0
say bm_wr
ret 4
end
n = get jobl 0
o = ulong 0
for i ulong 4611686018427387904
if ge o n
break
end
w = write int fd job o sub n o
if le w 0
x = fclose int fd
say bm_wr
ret 4
end
o = add o ulong w
end
x = fclose int fd
if ne x 0
say bm_wr
ret 4
end
ret 0
end
fn bn_export to int
fts_init
if ne bn_ropen 0
say bm_ro
ret 3
end
put stv 5 1
x = lg_replay int get lgs 0 get lgs 1
st_rowmax
st_ftsmax
st_spmax
st_materialize
put stv 5 0
m = makedir bxd 0 get bxdl 0 493
if ne m 0
say bm_dir
ret 2
end
bn_index NONE
k = ulong 0
for e ulong 4611686018427387904
if ge e get nent 0
break
end
if bn_in e NONE
r = bn_xone e
if ne r 0
ret r
end
k = add k 1
end
end
put jobl 0 0
js_raw bm_done
js_u64 k
js_byte 10
w = write 1 job 0 get jobl 0
ret 0
end

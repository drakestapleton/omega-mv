note srv.om: concurrent connections. Three kinds of process:
note   state process  (the first one) owns the log and the in-memory store and answers forwarded
note                  requests one at a time on a private local socket, so writes stay serialized
note                  and crash-safe exactly as with one connection;
note   acceptor       forked before the store is loaded (small, cheap to fork); owns the TCP
note                  listener (non-blocking) and keeps a pool of handlers: at least SV_IDLE idle,
note                  at most S_MAXH alive, an extra one leaving after 10 s without a connection;
note   handler        a long-lived process that accepts a connection itself, reads one whole
note                  request under the header, request and idle deadlines (hto), forwards the raw
note                  bytes to the state process, reads the whole answer and writes it to the client
note                  under its own deadline, then takes the next connection. It tells the acceptor
note                  on a status pipe when it takes and finishes a connection. (Until 2026-11-11 the
note                  acceptor forked one handler per connection: the fork cost about 0.25 ms of
note                  each request, evidence/brain/bench.)
note A slow or stalled client only holds its own handler. The state process never reads from or
note writes to a client socket.
global upath uchar 108
global upl ulong 1
global uad uchar 112
global sfd uchar 8
global sfp ulong 4
global sst uchar 4
global sone uchar 1
global sstat uchar 128
global pxn ulong 2
global snh ulong 1
const S_MAXH ulong 256
const S_SOCKMX ulong 100
const SV_IDLE ulong 2
note handler pool: status pipe fds (sbp), status messages read (sbb, two bytes each: 98 or 100 and
note the handler's slot), busy handlers (snb), each slot's pid (shp, 0 free) and busy flag (shb);
note in a handler: swk 0 the status pipe's write end, swk 1 1 for an extra handler, swk 2 its slot
global sbp uchar 8
global sbb uchar 256
global snb ulong 1
global swk ulong 3
global shp ulong S_MAXH
global shb uchar S_MAXH
global sms uchar 2
text a_sock "--sock"
text sockext ".sock"
text m_sockp "cortex: private socket path too long (at most 100 bytes; use --sock PATH)\n"
text m_sockx "cortex: --sock path exists and is not a socket\n"
text m_sock "cortex: cannot create the private socket\n"
text m_acc "cortex: acceptor process ended; exiting\n"

note deadlines for client connections (handler) and for forwarded requests (state process)
fn sv_tmo_client to void
put hto 0 10000000000
put hto 1 30000000000
put hto 2 10000000000
end
fn sv_tmo_local to void
put hto 0 2000000000
put hto 1 2000000000
put hto 2 2000000000
end

note --sock PATH (from jrs, n bytes)
fn sv_setpath n ulong to bool
if or eq n 0 gt n S_SOCKMX
ret false
end
for k ulong n
put upath k get jrs k
end
put upl 0 n
ret true
end
note default private socket path: the log path plus ".sock"
fn sv_defpath to bool
if gt get upl 0 0
ret true
end
n = get lpl 0
if gt add n len sockext S_SOCKMX
ret false
end
for k ulong n
put upath k get lpath k
end
for k ulong len sockext
put upath add n k get sockext k
end
put upl 0 add n len sockext
ret true
end
note sockaddr_un for upath in uad; returns its length
fn sv_addr to ulong
put uad 0 1
put uad 1 0
n = get upl 0
for k ulong n
put uad add 2 k get upath k
end
put uad add 2 n 0
ret add n 3
end
note 0 when upath is absent or a socket (removed), 1 when something else is there, 2 on error
fn sv_clear to ulong
r = lstat upath 0 get upl 0 sstat 0 len sstat
if eq r neg long 2
ret 0
end
if lt r 0
ret 2
end
m = or ulong get sstat 16 shl ulong get sstat 17 8
if ne and m 61440 49152
ret 1
end
x = unlink upath 0 get upl 0
if ne x 0
ret 2
end
ret 0
end
note private listening socket, mode 0600 before listen; descriptor or -1 (message printed)
fn sv_ulisten to int
cl = sv_clear
if eq cl 1
say m_sockx
ret -1
end
if eq cl 2
say m_sock
ret -1
end
fd = socknew 1 524289 0
if lt fd 0
say m_sock
ret -1
end
um = umask 63
r = bind int fd uad 0 sv_addr
x = umask int um
if ne r 0
say m_sock
ret -1
end
r = chmod upath 0 get upl 0 384
if ne r 0
say m_sock
ret -1
end
r = listen int fd 1024
if ne r 0
say m_sock
ret -1
end
ret int fd
end
note handler side: connect to the state process
fn sv_connect to int
fd = socknew 1 524289 0
if lt fd 0
ret -1
end
r = connect int fd uad 0 sv_addr
if ne r 0
x = fclose int fd
ret -1
end
ret int fd
end
note little-endian descriptor word at sfd[off..off+4)
fn sv_fdword off ulong to int
v = ulong 0
for i ulong 4
b = ulong get sfd add off i
v = or v shl b mul i 8
end
ret int v
end

note int at byte off of the status pipe pair sbp
fn sv_sbword off ulong to int
v = ulong 0
for i ulong 4
b = ulong get sbp add off i
v = or v shl b mul i 8
end
ret int v
end
note send b[0..n) of rqraw to u within dl; true when all of it went
fn sv_sendraw u int n ulong dl long to bool
o = ulong 0
while lt o n bound 999999
now = monons
if ge now dl
ret false
end
w = waitio u 4 sub dl now
if le w 0
ret false
end
s = send u rqraw o sub n o 0
if le s 0
ret false
end
o = add o ulong s
end
ret true
end
note read the answer of the state process (it closes after it) into job; an answer larger than
note job is passed on to the client in job-sized pieces. pxn 1 counts bytes received in total
fn sv_recvall u int c int dl long to bool
put pxn 0 0
put pxn 1 0
while true bound 999999
n = get pxn 0
if ge n len job
if not sv_sendcli c add monons 30000000000
ret false
end
put pxn 0 0
n = ulong 0
end
now = monons
if ge now dl
ret false
end
w = waitio u 1 sub dl now
if le w 0
ret false
end
r = recv u job n sub len job n 0
if eq r 0
ret gt get pxn 1 0
end
if lt r 0
ret false
end
put pxn 0 add n ulong r
put pxn 1 add get pxn 1 ulong r
end
ret false
end
note write job[0..pxn 0) to the client within dl; true when all of it went
fn sv_sendcli c int dl long to bool
o = ulong 0
n = get pxn 0
while lt o n bound 999999
now = monons
if ge now dl
ret false
end
w = waitio c 4 sub dl now
if le w 0
ret false
end
s = send c job o sub n o 0
if le s 0
ret false
end
o = add o ulong s
end
ret true
end
note one client connection, in a handler process
fn sv_handle c int to void
sv_tmo_client
put hmir 0 1
put hrawn 0 0
st = http_read c
if eq st 1
ret
end
if ne st 0
api_rderr c st
ret
end
u = sv_connect
if lt u 0
http_send c 503 0 0 0
ret
end
dl = add monons 120000000000
ok = sv_sendraw u get hrawn 0 dl
if ok
ok = sv_recvall u c dl
end
x = fclose u
if ok
ok = sv_sendcli c add monons 30000000000
end
x2 = shutdown c 1
end

note reap finished handlers without blocking; a handler that ends while busy (a trap inside
note sv_handle) is no longer counted as busy
fn sv_reap to void
for k ulong 1024
r = waitpid neg int 1 sst 0 len sst 1
if le r 0
ret
end
h = get snh 0
if gt h 0
put snh 0 sub h 1
end
for s ulong S_MAXH
if eq get shp s ulong r
if and eq get shb s 1 gt get snb 0 0
put snb 0 sub get snb 0 1
end
put shp s 0
put shb s 0
end
end
end
end
note acceptor loop; returns in the acceptor when the state process is gone (its end of the go
note pipe pr closed, so pr turns readable), and in each handler when it leaves sv_work (both then
note exit). The status messages are read before the reaping, so a dead handler's last message is
note counted before its slot is freed, and once more after it (before a slot is reused), so a message
note a handler wrote just before it died is dropped instead of being given to the slot's next
note handler. When the state process is gone the listener is shut down,
note so a new server can bind the port while a busy handler still finishes its client. getppid is
note not used: omc 189ada82 emits the x86-64 number (110) for it on arm64, fixed upstream after
note this pin.
fn sv_accept lfd int pr int to void
put snh 0 0
put snb 0 0
r = pipefds sbp 0 len sbp 524288
if ne r 0
ret
end
sr = sv_sbword 0
sw = sv_sbword 4
while true bound 999999
for k ulong 999999
if gt waitio pr 1 0 0
x = shutdown lfd 0
ret
end
sv_drain sr
sv_reap
sv_drain sr
if sv_spawn lfd pr sr sw
ret
end
w = waitio sr 1 200000000
if gt w 0
sv_drain sr
end
end
end
end
note fork handlers until SV_IDLE are idle or S_MAXH are alive; true in a handler that has left
note sv_work
fn sv_spawn lfd int pr int sr int sw int to bool
for k ulong 256
h = get snh 0
if ge h S_MAXH
ret false
end
b = get snb 0
if and gt h b ge sub h b SV_IDLE
ret false
end
s = sv_slot
if eq s S_MAXH
ret false
end
pid = fork
if lt pid 0
ret false
end
if eq pid 0
x = fclose sr
put swk 0 ulong sw
put swk 1 0
if ge h SV_IDLE
put swk 1 1
end
put swk 2 s
sv_work lfd pr
ret true
end
put shp s ulong pid
put shb s 0
put snh 0 add h 1
end
ret false
end
note a free handler slot (S_MAXH when none)
fn sv_slot to ulong
for s ulong S_MAXH
if eq get shp s 0
ret s
end
end
ret S_MAXH
end
note read every status message waiting on the pipe: 98 a handler took a connection, 100 finished it
note (two-byte writes are atomic on a pipe, and sbb holds a whole number of messages)
fn sv_drain sr int to void
for k ulong 4096
if le waitio sr 1 0 0
ret
end
n = read sr sbb 0 len sbb
if le n 0
ret
end
for i ulong div ulong n 2
j = mul i 2
c = ulong get sbb j
sv_msg c ulong get sbb add j 1
end
end
end
fn sv_msg c ulong s ulong to void
if ge s S_MAXH
ret
end
if eq get shp s 0
ret
end
if and eq c 98 eq get shb s 0
put shb s 1
put snb 0 add get snb 0 1
end
if and eq c 100 eq get shb s 1
put shb s 0
if gt get snb 0 0
put snb 0 sub get snb 0 1
end
end
end
note a handler: accept and serve connections until the state process is gone, or (an extra
note handler) until 10 s pass without a connection. The listener is non-blocking: when another
note handler took the connection first, accept fails and the handler waits again.
fn sv_work lfd int pr int to void
t0 = monons
while true bound 999999
for k ulong 999999
if gt waitio pr 1 0 0
ret
end
w = waitio lfd 1 200000000
if gt w 0
c = accept lfd 524288
if ge c 0
sv_note 98
sv_handle int c
x = fclose int c
sv_note 100
t0 = monons
end
else
if eq get swk 1 1
if gt sub monons t0 10000000000
ret
end
end
end
end
end
end
fn sv_note b ulong to void
put sone 0 uchar b
put sms 0 uchar b
put sms 1 uchar get swk 2
x = write int get swk 0 sms 0 2
end
note acceptor process: wait for the state process's go byte, bind TCP, report, serve
fn sv_accmain pr int qw int to int
n = read pr sone 0 1
if ne n 1
ret 0
end
fd = main_listen
if lt fd 0
put sone 0 110
x = write qw sone 0 1
ret 4
end
put sone 0 111
x = write qw sone 0 1
x = fclose qw
sv_accept fd pr
ret 0
end
note start the acceptor; 0 on success with the pipe ends in sfp (0 go-write, 1 ack-read, 2 pid),
note 1 when this process is the acceptor or a handler and has finished (exit status in sfp 3)
fn sv_start u int to ulong
r = pipefds sfd 0 len sfd 524288
if ne r 0
put sfp 3 4
ret 1
end
gr = sv_fdword 0
gw = sv_fdword 4
r = pipefds sfd 0 len sfd 524288
if ne r 0
put sfp 3 4
ret 1
end
ar = sv_fdword 0
aw = sv_fdword 4
pid = fork
if lt pid 0
put sfp 3 4
ret 1
end
if eq pid 0
x = fclose u
x = fclose gw
x = fclose ar
put sfp 3 ulong sv_accmain gr aw
ret 1
end
x = fclose gr
x = fclose aw
put sfp 0 ulong gw
put sfp 1 ulong ar
put sfp 2 ulong pid
ret 0
end
note state process: tell the acceptor to bind; true when it reports success
fn sv_go to bool
put sone 0 103
w = write int get sfp 0 sone 0 1
if ne w 1
ret false
end
put sone 0 0
n = read int get sfp 1 sone 0 1
if or ne n 1 ne get sone 0 111
x = waitpid int get sfp 2 sst 0 len sst 0
ret false
end
ret true
end
note state process loop: one forwarded request at a time; returns when the acceptor has ended
fn sv_serve u int to void
sv_tmo_local
put hprox 0 1
put hmir 0 0
apid = int get sfp 2
while true bound 999999
for k ulong 999999
w = waitio u 1 1000000000
if gt w 0
c = accept u 524288
if ge c 0
api_conn int c
x = fclose int c
end
end
r = waitpid apid sst 0 len sst 1
if ne r 0
say m_acc
ret
end
end
end
end

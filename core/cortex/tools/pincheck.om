note pincheck: the compiler pin is written in one place, PIN. build.sh compiles this unit with the
note pinned omc and runs it in the repository root as `git ls-files | build/pincheck`; a finding
note fails the build (pattern: omega-mcp gates/pincheck.om).
note It reads PIN (lines `omega-mv <40 hex>` and `omc-sha256 <64 hex>`) and a list of tracked paths
note on stdin, one per line, and reports every word in those files that restates the pin: a run of 7
note or more of 0-9 a-f holding a digit and a letter, between characters other than 0-9 A-Z a-z _,
note that is a prefix of the PIN revision or of the omc sha256. Such a copy goes stale when PIN moves;
note point at PIN (or derive the value from it) instead. Other hashes are not judged here.
note Not read: PIN itself, and records of past runs (evidence/), which name the compiler they ran with.
note Files and lines of any size are streamed; no limit of its own.
note Exit 0 no findings, 1 findings, 2 PIN malformed, a listed file unreadable or a write error.

global pin uchar 4096
global ib uchar 65536
global fb uchar 65536
global tok uchar 64
global pth uchar 4096
global ob uchar 32
global rev uchar 40
global sha uchar 64
global st ulong 16

note st cells: word length, hex only, has digit, has letter, line, findings, path length, files read
const q_len ulong 0
const q_hex ulong 1
const q_dig ulong 2
const q_let ulong 3
const q_line ulong 4
const q_bad ulong 5
const q_pl ulong 6
const q_nf ulong 7

text kpinf "PIN"
text kmvw "omega-mv "
text kshaw "omc-sha256 "
text m_pin "pincheck: PIN must hold `omega-mv <40 hex>` and `omc-sha256 <64 hex>`, one per line\n"
text m_open "pincheck: cannot read "
text m_long "pincheck: path longer than 4095 bytes\n"
text m_rest ": restates PIN: "
text m_hint "pincheck: the pin is written only in PIN; point at PIN (or derive the value from it) instead\n"
text m_sum "pincheck: files "
text m_fnd " findings "
text nl "\n"
text colon ":"
text x_ev "evidence/"

fn wt t view uchar * to void
n = len t
p = ulong 0
for it ulong 4611686018427387904
if ge p n
ret
end
k = write 1 t p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end
fn wbuf k ulong to void
n = get st k
p = ulong 0
for it ulong 4611686018427387904
if ge p n
ret
end
x = long 0
if eq k q_pl
x = write 1 pth p sub n p
else
x = write 1 tok p sub n p
end
if le x 0
exit 2
end
p = add p ulong x
end
end
fn putn v ulong to void
i = ulong 32
n = v
for it ulong 32
i = sub i 1
put ob i uchar add rem n 10 48
n = div n 10
if eq n 0
break
end
end
p = i
for it ulong 4611686018427387904
if ge p 32
ret
end
k = write 1 ob p sub 32 p
if le k 0
exit 2
end
p = add p ulong k
end
end
fn ishex c uchar to bool
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end
fn isword c uchar to bool
if ishex c
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret eq c 95
end

note ---- PIN ----
note the hex value after word w at the start of a line of pin[0 .. n) into rev (sel 0) or sha (sel 1)
fn pinval n ulong w view uchar * want ulong sel ulong to bool
p = ulong 0
for it ulong 4611686018427387904
if ge p n
ret false
end
ok = true
for i ulong len w
if ge add p i n
ok = false
break
end
if ne get pin add p i get w i
ok = false
break
end
end
if ok
a = add p len w
if gt add a want n
ret false
end
for i ulong want
c = get pin add a i
if not ishex c
ret false
end
if eq sel 0
put rev i c
else
put sha i c
end
end
e = add a want
if lt e n
c = get pin e
if and ne c 10 ne c 13
ret false
end
end
ret true
end
for it2 ulong 4611686018427387904
if ge p n
ret false
end
if eq get pin p 10
p = add p 1
break
end
p = add p 1
end
end
ret false
end
fn readpin to bool
fd = fopen kpinf 0 len kpinf 524288 0
if lt fd 0
ret false
end
n = read int fd pin 0 len pin
x = fclose int fd
if le n 0
ret false
end
if ge ulong n len pin
ret false
end
if not pinval ulong n kmvw 40 0
ret false
end
ret pinval ulong n kshaw 64 1
end

note ---- words ----
note the word in tok (its first min(len, 64) bytes) is a prefix of rev or sha
fn restates to bool
n = get st q_len
if lt n 7
ret false
end
if gt n 64
ret false
end
if le n 40
r = true
for i ulong n
if ne get tok i get rev i
r = false
break
end
end
if r
ret true
end
end
for i ulong n
if ne get tok i get sha i
ret false
end
end
ret true
end
fn endword to void
n = get st q_len
if eq n 0
ret
end
if and eq get st q_hex 1 and eq get st q_dig 1 eq get st q_let 1
if restates
wbuf q_pl
wt colon
putn get st q_line
wt m_rest
wbuf q_len
wt nl
put st q_bad add get st q_bad 1
end
end
put st q_len 0
end
fn onebyte c uchar to void
if isword c
n = get st q_len
if eq n 0
put st q_hex 1
put st q_dig 0
put st q_let 0
end
if lt n 64
put tok n c
end
put st q_len add n 1
if not ishex c
put st q_hex 0
else
if le c 57
put st q_dig 1
else
put st q_let 1
end
end
ret
end
endword
if eq c 10
put st q_line add get st q_line 1
end
end

note ---- files ----
fn skipped to bool
n = get st q_pl
if and eq n len kpinf eq get pth 0 80
if and eq get pth 1 73 eq get pth 2 78
ret true
end
end
if lt n len x_ev
ret false
end
for i ulong len x_ev
if ne get pth i get x_ev i
ret false
end
end
ret true
end
fn scan to int
if skipped
ret 0
end
fd = fopen pth 0 get st q_pl 524288 0
if lt fd 0
wt m_open
wbuf q_pl
wt nl
ret 2
end
put st q_line 1
put st q_len 0
for it ulong 4611686018427387904
r = read int fd fb 0 len fb
if lt r 0
x = fclose int fd
wt m_open
wbuf q_pl
wt nl
ret 2
end
if eq r 0
break
end
for i ulong ulong r
onebyte get fb i
end
end
endword
x = fclose int fd
put st q_nf add get st q_nf 1
ret 0
end
fn main to int
if not readpin
wt m_pin
ret 2
end
put st q_pl 0
rc = int 0
for it ulong 4611686018427387904
r = read int 0 ib 0 len ib
if lt r 0
ret 2
end
if eq r 0
break
end
for i ulong ulong r
c = get ib i
if eq c 10
if gt get st q_pl 0
s = scan
if ne s 0
rc = s
end
end
put st q_pl 0
else
n = get st q_pl
if ge n sub len pth 1
wt m_long
ret 2
end
put pth n c
put st q_pl add n 1
end
end
end
if gt get st q_pl 0
s = scan
if ne s 0
rc = s
end
end
wt m_sum
putn get st q_nf
wt m_fnd
putn get st q_bad
wt nl
if ne rc 0
ret rc
end
if gt get st q_bad 0
wt m_hint
ret 1
end
ret 0
end

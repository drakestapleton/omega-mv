om2
note enc: page text on stdin becomes an om2 unit on stdout, streamed
note the emitted unit holds the page as text records tN (N = 0, 1, 2, ...) and a main that calls
note emit on each record in order, writing the same bytes back. A record ends at a newline, which it
note keeps as \n, or after RECMAX input bytes of one long line, so no text literal grows with the page.
note exit 0 ok, 2 read error, 4 control byte refused (below 32 other than tab and newline, or 127),
note 6 write error. Output is written while input is read, so on a nonzero exit stdout holds an
note incomplete unit that must be discarded.
note no size refusal: enc holds one 65536-byte input block and one output buffer, flushed at 65536
note bytes, whatever the page size. What remains is the memory of the compiler that builds the unit:
note tests/pageunit/run.sh compiles a page's unit in omc's usage mode and alarms when the unit puts
note 13421773 8-byte words or more in the compiler's arena (measured 2026-11-11 with a fixed arena of
note 16777216 words: about 524000 records, or about 64 MB of long lines).
note out is a reserved word in om2 units so the output buffer is ob.
note Loop bounds: each pass of the read loop consumes at least one byte or ends it; the inner loops
note run once per byte of one block, once per digit, or once per record.
global ib uchar 65536
global ob uchar 65536
global st ulong 1
const RECMAX ulong 4096
text HEAD "om2\nnote cortex page unit generated by tools/pageunit/enc.om\nnote compile with the omc pinned in this repository and run: stdout is the page text byte for byte\n"
text TXT "text t"
text QOPEN " \""
text QEND "\"\n"
text EMITA "fn emit a view uchar * to void\nn = len a\no = ulong 0\nwhile lt o n bound 1000000\n"
text EMITB "k = write 1 a o sub n o\nif le k 0\nexit 1\nend\no = add o ulong k\nend\nend\n"
text MAINH "fn main to int\n"
text CALL "emit t"
text NL "\n"
text TAIL "ret 0\nend\n"
fn oflush to void
n = get st 0
o = ulong 0
while lt o n bound 65536
k = write 1 ob o sub n o
if le k 0
exit 6
end
o = add o ulong k
end
put st 0 0
end
fn putb c uchar to void
p = get st 0
put ob p c
p = add p 1
put st 0 p
if ge p 65536
oflush
end
end
fn puts a view uchar * to void
n = len a
i = ulong 0
while lt i n bound 4096
putb get a i
i = add i 1
end
end
fn putdec v ulong to void
d = new uchar 20 0
k = ulong 0
x = v
while gt x 0 bound 20
put d k uchar add rem x 10 48
x = div x 10
k = add k 1
end
if eq k 0
putb 48
end
while gt k 0 bound 20
k = sub k 1
putb get d k
end
end
fn main to int
puts HEAD
cnt = ulong 0
opn = ulong 0
inrec = ulong 0
go = ulong 1
while eq go 1 bound 9223372036854775807
r = read 0 ib 0 65536
if lt r 0
ret 2
end
if eq r 0
go = ulong 0
else
n = ulong r
i = ulong 0
while lt i n bound 65536
c = get ib i
if eq opn 0
puts TXT
putdec cnt
puts QOPEN
opn = ulong 1
inrec = ulong 0
end
if eq c 10
putb 92
putb 110
puts QEND
opn = ulong 0
cnt = add cnt 1
else
if eq c 9
putb 92
putb 116
else
if lt c 32
ret 4
end
if eq c 127
ret 4
end
if eq c 34
putb 92
end
if eq c 92
putb 92
end
putb c
end
inrec = add inrec 1
if ge inrec RECMAX
puts QEND
opn = ulong 0
cnt = add cnt 1
end
end
i = add i 1
end
end
end
if eq opn 1
puts QEND
cnt = add cnt 1
end
puts EMITA
puts EMITB
puts MAINH
j = ulong 0
while lt j cnt bound 9223372036854775807
puts CALL
putdec j
puts NL
j = add j 1
end
puts TAIL
oflush
ret 0
end

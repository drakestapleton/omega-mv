note core/openclaw/main.om: CLI entrypoint for pure-Omega openclaw agent runtime
note Composed after si/directives/om2.om and core/openclaw/lib.om.
note Reads line-delimited JSON tool-call envelopes on stdin, drives the deterministic
note turn state machine, and emits JSONL turn outcomes on stdout.

const CLI_IN_CAP ulong 65536
global cli_in uchar 65536
global cli_in_len ulong 1
global cli_parsed_u64 ulong 1

text fl_caps "--caps"
text fl_budget "--budget"
text fl_turns "--max-turns"
text cli_err_io "openclaw: I/O error\n"
text cli_err_args "openclaw: invalid or excessive CLI arguments\n"

fn cli_buf_eq buf view uchar * n ulong pat view uchar * to bool
if ne n len pat
ret false
end
for i ulong n bound 64
if ne get buf i get pat i
ret false
end
end
ret true
end

fn cli_parse_u64_ok buf view uchar * n ulong to bool
if or eq n 0 gt n 20
ret false
end
val = ulong 0
for i ulong n bound 64
c = get buf i
if not and ge c 48 le c 57
ret false
end
d = ulong sub c 48
if gt val ulong 1844674407370955161
ret false
end
if and eq val ulong 1844674407370955161 gt d 5
ret false
end
val = add mul val 10 d
end
put cli_parsed_u64 0 val
ret true
end

fn cli_read_stdin to long
total = ulong 0
while lt total CLI_IN_CAP bound 65536
k = read 0 cli_in total sub CLI_IN_CAP total
if lt k 0
ret k
end
if eq k 0
break
end
total = add total ulong k
end
put cli_in_len 0 total
ret long total
end

fn cli_load_line ls ulong nlen ulong to void
n = nlen
if gt n OC_ENV_CAP
n = OC_ENV_CAP
end
for i ulong n bound 4096
put oc_env i get cli_in add ls i
end
put oc_env_len 0 n
end

fn cli_flag_kind buf view uchar * n ulong to ulong
if cli_buf_eq buf n fl_caps
ret 1
end
if cli_buf_eq buf n fl_budget
ret 2
end
if cli_buf_eq buf n fl_turns
ret 3
end
ret 0
end

fn cli_read_arg_u64 idx ulong to bool
vbuf = new uchar 64 0
rv = argread idx vbuf 0 64
if le rv 0
ret false
end
ret cli_parse_u64_ok vbuf ulong rv
end

fn cli_init_from_args to bool
ac_raw = argcnt
if or lt ac_raw 0 gt ac_raw 64
ret false
end
caps = or CAP_READ CAP_WRITE
max_t = ulong 32
tok_b = ulong 4096
ac = ulong ac_raw
abuf = new uchar 64 0
i = ulong 1
while lt i ac bound 64
r = argread i abuf 0 64
if gt r 0
fk = cli_flag_kind abuf ulong r
if gt fk 0
if ge add i 1 ac
ret false
end
if not cli_read_arg_u64 add i 1
ret false
end
if eq fk 1
caps = get cli_parsed_u64 0
else
if eq fk 2
tok_b = get cli_parsed_u64 0
else
max_t = get cli_parsed_u64 0
end
end
i = add i 1
end
end
i = add i 1
end
oc_session_init caps max_t tok_b max_t
ret true
end

fn cli_process_lines to int
total = get cli_in_len 0
pos = ulong 0
while lt pos total bound 65536
ls = pos
while lt pos total bound 65536
if eq get cli_in pos 10
break
end
pos = add pos 1
end
le_p = pos
if gt le_p ls
if eq get cli_in sub le_p 1 13
le_p = sub le_p 1
end
end
if gt le_p ls
cli_load_line ls sub le_p ls
st = oc_run_turn
if gt st ST_REFUSED
ret 2
end
olen = oc_format_turn_jsonl
ok = oc_write_out 1 olen
if not ok
ret 2
end
end
if lt pos total
pos = add pos 1
end
end
ret 0
end

fn main to int
if not cli_init_from_args
ea = write 2 cli_err_args 0 len cli_err_args
if lt ea 0
ret 2
end
ret 2
end
got = cli_read_stdin
if lt got 0
ew = write 2 cli_err_io 0 len cli_err_io
if lt ew 0
ret 2
end
ret 2
end
ret cli_process_lines
end

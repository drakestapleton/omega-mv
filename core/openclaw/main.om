note core/openclaw/main.om: CLI entrypoint for pure-Omega openclaw agent runtime
note Composed after si/directives/om2.om and core/openclaw/lib.om.
note Reads line-delimited JSON tool-call envelopes on stdin, drives the deterministic
note turn state machine, and emits JSONL turn outcomes on stdout.

const CLI_IN_CAP ulong 65536
global cli_in uchar 65536
global cli_in_len ulong 1

text fl_caps "--caps"
text fl_budget "--budget"
text fl_turns "--max-turns"
text cli_err_io "openclaw: I/O error\n"

fn cli_buf_eq buf view uchar * n ulong pat view uchar * to bool
if ne n len pat
ret false
end
for i ulong n bound 64
if ne get buf i get pat i
ret false
end
end
ret true
end

fn cli_parse_u64 buf view uchar * n ulong to ulong
if eq n 0
ret 0
end
val = ulong 0
for i ulong n bound 32
c = get buf i
if and ge c 48 le c 57
val = add mul val 10 ulong sub c 48
else
break
end
end
ret val
end

fn cli_read_stdin to long
total = ulong 0
while lt total CLI_IN_CAP bound 65536
k = read 0 cli_in total sub CLI_IN_CAP total
if lt k 0
ret k
end
if eq k 0
break
end
total = add total ulong k
end
put cli_in_len 0 total
ret long total
end

fn cli_load_line ls ulong nlen ulong to void
n = nlen
if gt n OC_ENV_CAP
n = OC_ENV_CAP
end
for i ulong n bound 4096
put oc_env i get cli_in add ls i
end
put oc_env_len 0 n
end

fn cli_init_from_args to void
caps = or CAP_READ CAP_WRITE
max_t = ulong 32
tok_b = ulong 4096
ac = ulong argcnt
abuf = new uchar 64 0
vbuf = new uchar 64 0
i = ulong 1
while lt i ac bound 64
r = argread i abuf 0 64
if and gt r 0 lt add i 1 ac
rv = argread add i 1 vbuf 0 64
if gt rv 0
if cli_buf_eq abuf ulong r fl_caps
caps = cli_parse_u64 vbuf ulong rv
i = add i 1
else
if cli_buf_eq abuf ulong r fl_budget
tok_b = cli_parse_u64 vbuf ulong rv
i = add i 1
else
if cli_buf_eq abuf ulong r fl_turns
max_t = cli_parse_u64 vbuf ulong rv
i = add i 1
end
end
end
end
end
i = add i 1
end
oc_session_init caps max_t tok_b max_t
end

fn cli_process_lines to int
total = get cli_in_len 0
pos = ulong 0
while lt pos total bound 65536
ls = pos
while lt pos total bound 65536
if eq get cli_in pos 10
break
end
pos = add pos 1
end
le_p = pos
if gt le_p ls
if eq get cli_in sub le_p 1 13
le_p = sub le_p 1
end
end
if gt le_p ls
cli_load_line ls sub le_p ls
st = oc_run_turn
if gt st ST_REFUSED
ret 2
end
olen = oc_format_turn_jsonl
ok = oc_write_out 1 olen
if not ok
ret 2
end
end
if lt pos total
pos = add pos 1
end
end
ret 0
end

fn main to int
cli_init_from_args
got = cli_read_stdin
if lt got 0
ew = write 2 cli_err_io 0 len cli_err_io
if lt ew 0
ret 2
end
ret 2
end
ret cli_process_lines
end

note SPDX-License-Identifier: Apache-2.0
note core/hive/test.om: Comprehensive pure-Omega test suite for Sovereign Agent Hive Engine.
note Covers axial/cube coordinate identities, hex distance properties, pixel round-trip,
note all 6 canonical neighbors, ring sizes (6*k) and spiral enumeration, auto-placement,
note multi-hop shortest-path routing around obstacles, task lease/capacity/reclaim,
note nearest-agent assignment, and fail-closed negative controls.
note Compose with: si/directives/om2.om core/hive/lib.om core/hive/test.om

text s_pass "PASS "
text s_fail "FAIL "
text s_nl "\n"

text s_t1 "axial_cube_zero_sum_and_dist_identities"
text s_t2 "pixel_roundtrip_and_detail_tiers"
text s_t3 "all_six_canonical_neighbors"
text s_t4 "ring_sizes_6k_and_spiral_uniqueness"
text s_t5 "auto_placement_ring_expansion_and_bounds"
text s_t6 "multihop_routing_open_and_around_obstacles"
text s_t7 "task_leases_capacity_and_reclaim"
text s_t8 "assign_nearest_reachable_agent"
text s_t9 "refuse_oob_collision_dup_blocked_capacity"
text s_t10 "refuse_unreachable_blocked_oob_routes"
text s_sum "HIVE_TEST_PASS total=10 failed=0\n"
text s_fsum "HIVE_TEST_FAIL\n"

fn h_report name view uchar * ok bool to uint
if ok
w1 = hive_write_all 1 s_pass
w2 = hive_write_all 1 name
w3 = hive_write_all 1 s_nl
if and w1 and w2 w3
ret 0
end
ret 1
end
w1 = hive_write_all 1 s_fail
w2 = hive_write_all 1 name
w3 = hive_write_all 1 s_nl
if and w1 and w2 w3
ret 1
end
ret 1
end

fn test_axial_cube_dist to bool
ca = new CubeCoord 0 0 0
cb = new CubeCoord 0 0 0
cc = new CubeCoord 0 0 0
hive_axial_to_cube 0 0 ca
if not hive_cube_valid ca
ret false
end
hive_axial_to_cube -3 2 ca
hive_axial_to_cube 4 -1 cb
hive_axial_to_cube 1 3 cc
if not and hive_cube_valid ca and hive_cube_valid cb hive_cube_valid cc
ret false
end
if ne hive_hex_dist 0 0 0 0 0
ret false
end
if ne hive_hex_dist 0 0 1 0 1
ret false
end
if ne hive_hex_dist 0 0 1 -1 1
ret false
end
if ne hive_hex_dist 0 0 2 2 4
ret false
end
dab = hive_hex_dist -3 2 4 -1
dba = hive_hex_dist 4 -1 -3 2
if ne dab 7
ret false
end
if ne dab dba
ret false
end
if ne dab hive_cube_dist ca cb
ret false
end
dac = hive_hex_dist -3 2 1 3
dbc = hive_hex_dist 4 -1 1 3
if ne dac hive_cube_dist ca cc
ret false
end
if ne dbc hive_cube_dist cb cc
ret false
end
ret le dac add dab dbc
end

fn check_px_rt q int r int to bool
pt = new HexCoord 0 0
px = hive_axial_to_pixel_x q r HIVE_DEFAULT_RADIUS
py = hive_axial_to_pixel_y r HIVE_DEFAULT_RADIUS
if not hive_pixel_to_axial px py HIVE_DEFAULT_RADIUS pt
ret false
end
if ne get pt q q
ret false
end
ret eq get pt r r
end

fn test_pixel_and_tiers to bool
pt = new HexCoord 0 0
if not check_px_rt 0 0
ret false
end
if not check_px_rt 1 0
ret false
end
if not check_px_rt 1 -1
ret false
end
if not check_px_rt -4 3
ret false
end
if not check_px_rt 7 -2
ret false
end
if hive_pixel_to_axial 0.0f64 0.0f64 0.0f64 pt
ret false
end
if hive_pixel_to_axial 0.0f64 0.0f64 -10.0f64 pt
ret false
end
if ne hive_detail_tier 1.0f64 HIVE_TIER_FULL
ret false
end
if ne hive_detail_tier 0.62f64 HIVE_TIER_FULL
ret false
end
if ne hive_detail_tier 0.61f64 HIVE_TIER_COMPACT
ret false
end
if ne hive_detail_tier 0.34f64 HIVE_TIER_COMPACT
ret false
end
if ne hive_detail_tier 0.33f64 HIVE_TIER_DOT
ret false
end
ret eq hive_detail_tier 0.10f64 HIVE_TIER_DOT
end

fn test_six_neighbors to bool
qs = new int 6 0
rs = new int 6 0
bad = new HexCoord 0 0
hive_neighbors 3 -2 qs rs
if or ne get qs 0 4 ne get rs 0 -2
ret false
end
if or ne get qs 1 4 ne get rs 1 -3
ret false
end
if or ne get qs 2 3 ne get rs 2 -3
ret false
end
if or ne get qs 3 2 ne get rs 3 -2
ret false
end
if or ne get qs 4 2 ne get rs 4 -1
ret false
end
if or ne get qs 5 3 ne get rs 5 -1
ret false
end
for i ulong 6
if ne hive_hex_dist 3 -2 get qs i get rs i 1
ret false
end
j = add i 1
while lt j 6 bound 6
if and eq get qs i get qs j eq get rs i get rs j
ret false
end
j = add j 1
end
end
ret not hive_neighbor 3 -2 6 bad
end

fn check_unique_pairs qs view int * rs view int * n ulong to bool
i = ulong 0
while lt i n bound 64
j = add i 1
while lt j n bound 64
if and eq get qs i get qs j eq get rs i get rs j
ret false
end
j = add j 1
end
i = add i 1
end
ret true
end

fn test_rings_and_spiral to bool
ctr = new HexCoord 1 -1
qs = new int 64 0
rs = new int 64 0
c0 = hive_ring ctr 0 qs rs
if ne c0 1
ret false
end
if or ne get qs 0 1 ne get rs 0 -1
ret false
end
k = uint 1
while le k 4 bound 4
cnt = hive_ring ctr k qs rs
if ne cnt mul k 6
ret false
end
i = ulong 0
while lt i ulong cnt bound 32
if ne hive_hex_dist 1 -1 get qs i get rs i int k
ret false
end
i = add i 1
end
if not check_unique_pairs qs rs ulong cnt
ret false
end
k = add k 1
end
sp = hive_spiral ctr 3 qs rs
if ne sp 37
ret false
end
ret check_unique_pairs qs rs 37
end

fn test_auto_placement to bool
pt = new HexCoord 0 0
bd = new HiveBounds 0 0 0 0 0 0
if ne hive_init 6 32 32 HIVE_OK
ret false
end
if ne hive_place_auto 1 0 HIVE_ROLE_COORD 2 pt HIVE_OK
ret false
end
if or ne get pt q 0 ne get pt r 0
ret false
end
aid = uint 2
while le aid 7 bound 6
if ne hive_place_auto aid 1 HIVE_ROLE_WORKER 2 pt HIVE_OK
ret false
end
if ne hive_hex_dist 0 0 get pt q get pt r 1
ret false
end
aid = add aid 1
end
if ne hive_place_auto 8 1 HIVE_ROLE_RESEARCH 2 pt HIVE_OK
ret false
end
if ne hive_hex_dist 0 0 get pt q get pt r 2
ret false
end
hive_compute_bounds bd
if ne get bd cnt 8
ret false
end
ret eq get bd max_dist 2
end

fn check_valid_path pq view int 289 pr view int 289 hops int src view HexCoord dst view HexCoord to bool
if lt hops 0
ret false
end
n = add ulong hops 1
if ne get pq 0 get src q
ret false
end
if ne get pr 0 get src r
ret false
end
last = sub n 1
if ne get pq last get dst q
ret false
end
if ne get pr last get dst r
ret false
end
i = ulong 0
while lt i n bound 289
if eq hive_cell_state get pq i get pr i HIVE_CELL_BLOCKED
ret false
end
if gt i 0
prv = sub i 1
if ne hive_hex_dist get pq prv get pr prv get pq i get pr i 1
ret false
end
end
i = add i 1
end
ret true
end

fn test_routing_obstacles to bool
src = new HexCoord -3 0
dst = new HexCoord 3 0
pq = new int 289 0
pr = new int 289 0
if ne hive_init 6 32 32 HIVE_OK
ret false
end
h0 = hive_route src dst pq pr
if ne h0 6
ret false
end
if not check_valid_path pq pr h0 src dst
ret false
end
note Build an obstacle wall across q = 0 for r in -2..2
if ne hive_block_cell 0 -2 HIVE_OK
ret false
end
if ne hive_block_cell 0 -1 HIVE_OK
ret false
end
if ne hive_block_cell 0 0 HIVE_OK
ret false
end
if ne hive_block_cell 0 1 HIVE_OK
ret false
end
if ne hive_block_cell 0 2 HIVE_OK
ret false
end
put src q -2
put src r 0
put dst q 2
put dst r 0
h1 = hive_route src dst pq pr
if le h1 4
ret false
end
if not check_valid_path pq pr h1 src dst
ret false
end
note Direct distance is 4; shortest detour around wall through (0,-3) or (0,3) takes 3 + 5 = 8 hops
ret eq h1 8
end

fn test_task_lifecycle to bool
if ne hive_init 6 16 16 HIVE_OK
ret false
end
if ne hive_place_agent 1 0 0 HIVE_ROLE_WORKER 1 HIVE_OK
ret false
end
if ne hive_place_agent 2 1 0 HIVE_ROLE_WORKER 2 HIVE_OK
ret false
end
if ne hive_task_create 1 1 -1 1 HIVE_OK
ret false
end
if ne hive_task_create 2 -1 1 1 HIVE_OK
ret false
end
if ne hive_task_claim 1 1 10 HIVE_OK
ret false
end
note Agent 1 has cap=1, claiming second task must fail with CAPACITY
if ne hive_task_claim 2 1 10 HIVE_ERR_CAPACITY
ret false
end
note Agent 2 trying to steal active lease on task 1 must fail with CLAIMED
if ne hive_task_claim 1 2 10 HIVE_ERR_CLAIMED
ret false
end
note Agent 2 trying to heartbeat or submit task 1 must fail with UNAUTH
if ne hive_task_heartbeat 1 2 20 HIVE_ERR_UNAUTH
ret false
end
if ne hive_task_submit 1 2 HIVE_ERR_UNAUTH
ret false
end
note Agent 1 heartbeats, submits, and task is verified -> releases load
if ne hive_task_heartbeat 1 1 20 HIVE_OK
ret false
end
if ne hive_task_submit 1 1 HIVE_OK
ret false
end
if ne hive_task_verify 1 true HIVE_OK
ret false
end
note Now agent 1 load is 0 and can claim task 2 with ttl=5
if ne hive_task_claim 2 1 5 HIVE_OK
ret false
end
note Advance clock by 5 -> lease expires and is reclaimed
rec = hive_tick 5
if ne rec 1
ret false
end
note Agent 2 can now claim reclaimed task 2
ret eq hive_task_claim 2 2 10 HIVE_OK
end

fn test_assign_nearest to bool
asg = new uint 1 0
if ne hive_init 6 16 16 HIVE_OK
ret false
end
note Agent 1 at (1, 0) but cap=1 and already busy with task 1
if ne hive_place_agent 1 1 0 HIVE_ROLE_WORKER 1 HIVE_OK
ret false
end
note Agent 2 at (-2, 0), free
if ne hive_place_agent 2 -2 0 HIVE_ROLE_WORKER 2 HIVE_OK
ret false
end
note Agent 3 at (4, 0), free (only 2 hops from task 2 at (2, 0)!)
if ne hive_place_agent 3 4 0 HIVE_ROLE_WORKER 2 HIVE_OK
ret false
end
if ne hive_task_create 1 1 0 1 HIVE_OK
ret false
end
if ne hive_task_claim 1 1 50 HIVE_OK
ret false
end
if ne hive_task_create 2 2 0 2 HIVE_OK
ret false
end
if ne hive_assign_nearest 2 30 asg HIVE_OK
ret false
end
ret eq get asg 0 3
end

fn test_refusals_grid to bool
if ne hive_init 4 2 4 HIVE_OK
ret false
end
note OOB placement (dist=5 > radius=4)
if ne hive_place_agent 1 5 0 HIVE_ROLE_WORKER 1 HIVE_ERR_OOB
ret false
end
note Valid placement at (0, 0)
if ne hive_place_agent 1 0 0 HIVE_ROLE_COORD 1 HIVE_OK
ret false
end
note Collision on occupied cell (0, 0)
if ne hive_place_agent 2 0 0 HIVE_ROLE_WORKER 1 HIVE_ERR_COLLISION
ret false
end
note Duplicate agent ID 1 at free cell (1, 0)
if ne hive_place_agent 1 1 0 HIVE_ROLE_WORKER 1 HIVE_ERR_DUP_AGENT
ret false
end
note Blocking occupied cell refused with COLLISION
if ne hive_block_cell 0 0 HIVE_ERR_COLLISION
ret false
end
note Block (1, 0), double-block refused, placing on blocked refused
if ne hive_block_cell 1 0 HIVE_OK
ret false
end
if ne hive_block_cell 1 0 HIVE_ERR_BLOCKED
ret false
end
if ne hive_place_agent 2 1 0 HIVE_ROLE_WORKER 1 HIVE_ERR_BLOCKED
ret false
end
note Place 2nd agent at (-1, 0), then 3rd exceeds max_agents=2 -> CAPACITY
if ne hive_place_agent 2 -1 0 HIVE_ROLE_WORKER 1 HIVE_OK
ret false
end
if ne hive_place_agent 3 0 1 HIVE_ROLE_WORKER 1 HIVE_ERR_CAPACITY
ret false
end
note Removing agent holding claimed task refused with CLAIMED
if ne hive_task_create 1 -1 0 1 HIVE_OK
ret false
end
if ne hive_task_claim 1 2 10 HIVE_OK
ret false
end
ret eq hive_remove_agent 2 HIVE_ERR_CLAIMED
end

fn test_refusals_routes to bool
src = new HexCoord 0 0
dst = new HexCoord 2 0
pq = new int 289 0
pr = new int 289 0
tiny_q = new int 2 0
tiny_r = new int 2 0
nqs = new int 6 0
nrs = new int 6 0
if ne hive_init 5 16 16 HIVE_OK
ret false
end
note Route to OOB cell refused (-HIVE_ERR_OOB)
put dst q 6
put dst r 0
if ne hive_route src dst pq pr neg int HIVE_ERR_OOB
ret false
end
note Surround (2, 0) with all 6 blocked neighbors
hive_neighbors 2 0 nqs nrs
for i ulong 6
if ne hive_block_cell get nqs i get nrs i HIVE_OK
ret false
end
end
put dst q 2
put dst r 0
if ne hive_route src dst pq pr neg int HIVE_ERR_NO_ROUTE
ret false
end
note Route to a blocked cell refused (-HIVE_ERR_BLOCKED)
put dst q 3
put dst r 0
if ne hive_route src dst pq pr neg int HIVE_ERR_BLOCKED
ret false
end
note Undersized path buffer refused (-HIVE_ERR_CAPACITY)
put dst q -3
put dst r 0
ret eq hive_route src dst tiny_q tiny_r neg int HIVE_ERR_CAPACITY
end

fn main to int
fails = uint 0
fails = add fails h_report s_t1 test_axial_cube_dist
fails = add fails h_report s_t2 test_pixel_and_tiers
fails = add fails h_report s_t3 test_six_neighbors
fails = add fails h_report s_t4 test_rings_and_spiral
fails = add fails h_report s_t5 test_auto_placement
fails = add fails h_report s_t6 test_routing_obstacles
fails = add fails h_report s_t7 test_task_lifecycle
fails = add fails h_report s_t8 test_assign_nearest
fails = add fails h_report s_t9 test_refusals_grid
fails = add fails h_report s_t10 test_refusals_routes
if eq fails 0
ok = hive_write_all 1 s_sum
if ok
ret 0
end
ret 2
end
ok = hive_write_all 1 s_fsum
if ok
ret 1
end
ret 1
end

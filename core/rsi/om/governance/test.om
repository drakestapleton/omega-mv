note SPDX-License-Identifier: Apache-2.0
note core/rsi/om/governance/test.om
note Comprehensive behavioral test suite with negative/refusal controls for the
note pure-Omega RSI safety envelope, promotion gate, and SHA-256 Merkle ledger.
note Compose with:
note   si/directives/om2.om core/rsi/om/governance/promotion_gate.om om/tls/sha2.om
note   core/rsi/om/governance/ledger.om core/rsi/om/governance/test.om

text t_pass "PASS "
text t_fail "FAIL "
text t_nl "\n"
text t_all_ok "RSI GOVERNANCE TEST SUITE PASS\n"
text t_all_bad "RSI GOVERNANCE TEST SUITE FAIL\n"

text t_n1 "rsi_gate_promote_valid_candidate"
text t_n2 "rsi_gate_negative_synthetic_branch_protected"
text t_n3 "rsi_gate_negative_security_replay_envelope_regression"
text t_n4 "rsi_gate_meta_tier_and_no_gain_hold"
text t_n5 "rsi_ledger_hash_chain_and_merkle_inclusion"
text t_n6 "rsi_ledger_negative_tamper_and_merkle_mismatch"

global t_fails ulong 1

fn t_w s view uchar * to void
n = len s
off = ulong 0
while lt off n bound 256
k = write 1 s off sub n off
if le k 0
break
end
off = add off ulong k
end
end

fn t_report name view uchar * ok bool to void
if ok
t_w t_pass
else
t_w t_fail
put t_fails 0 add get t_fails 0 1
end
t_w name
t_w t_nl
end

note Test 1: Valid measured-canary branch-only candidate promotes cleanly.
fn test_rsi_promote_valid to bool
note max_diff=500, max_files=12, min_corr=10000, max_reg=50, min_perf=100, min_res=100
rsi_gate_init 500 12 10000 50 100 100
c = new RsiCandidate 101 RSI_TIER_L1_KERNEL 120 3 10000 long 250 long 10 0 1 RSI_TRUST_MEASURED_CANARY 0 1
v = rsi_evaluate_candidate c
if ne v RSI_PROMOTE
ret false
end
if or ne rsi_gate_evaluated 1 ne rsi_gate_promoted 1
ret false
end
ret true
end

note Test 2 (NEGATIVE): Synthetic trust, non-branch-only, and protected paths are all refused.
fn test_rsi_negative_trust_branch_protected to bool
rsi_gate_init 500 12 10000 50 100 100
c_syn = new RsiCandidate 201 RSI_TIER_L1_KERNEL 50 1 10000 long 300 long 0 0 1 RSI_TRUST_SYNTHETIC 0 1
if ne rsi_evaluate_candidate c_syn RSI_DENY_SYNTHETIC_TRUST
ret false
end
c_nob = new RsiCandidate 202 RSI_TIER_L1_KERNEL 50 1 10000 long 300 long 0 0 1 RSI_TRUST_MEASURED_CANARY 0 0
if ne rsi_evaluate_candidate c_nob RSI_DENY_NOT_BRANCH_ONLY
ret false
end
c_prot = new RsiCandidate 203 RSI_TIER_L1_KERNEL 50 1 10000 long 300 long 0 0 1 RSI_TRUST_MEASURED_SILICON 1 1
if ne rsi_evaluate_candidate c_prot RSI_DENY_PROTECTED_PATH
ret false
end
if or ne rsi_gate_denied 3 ne rsi_gate_promoted 0
ret false
end
ret true
end

note Test 3 (NEGATIVE): Security findings, replay failure, blast radius, and regression refused.
fn test_rsi_negative_sec_replay_env_reg to bool
rsi_gate_init 500 12 10000 50 100 100
c_sec = new RsiCandidate 301 RSI_TIER_L1_KERNEL 40 2 10000 long 200 long 0 1 1 RSI_TRUST_MEASURED_CANARY 0 1
if ne rsi_evaluate_candidate c_sec RSI_DENY_SECURITY
ret false
end
c_corr = new RsiCandidate 302 RSI_TIER_L1_KERNEL 40 2 9999 long 200 long 0 0 1 RSI_TRUST_MEASURED_CANARY 0 1
if ne rsi_evaluate_candidate c_corr RSI_DENY_CORRECTNESS
ret false
end
c_rep = new RsiCandidate 303 RSI_TIER_L1_KERNEL 40 2 10000 long 200 long 0 0 0 RSI_TRUST_MEASURED_CANARY 0 1
if ne rsi_evaluate_candidate c_rep RSI_DENY_REPLAY
ret false
end
c_env = new RsiCandidate 304 RSI_TIER_L1_KERNEL 501 2 10000 long 200 long 0 0 1 RSI_TRUST_MEASURED_CANARY 0 1
if ne rsi_evaluate_candidate c_env RSI_DENY_ENVELOPE
ret false
end
c_reg = new RsiCandidate 305 RSI_TIER_L1_KERNEL 40 2 10000 long 400 long -51 0 1 RSI_TRUST_MEASURED_CANARY 0 1
if ne rsi_evaluate_candidate c_reg RSI_DENY_REGRESSION
ret false
end
if ne rsi_gate_denied 5
ret false
end
ret true
end

note Test 4: No-gain hold and L3_META stricter 2x gain threshold.
fn test_rsi_meta_and_hold to bool
rsi_gate_init 500 12 10000 50 100 100
c_hold = new RsiCandidate 401 RSI_TIER_L0_PARAM 10 1 10000 long 40 long 20 0 1 RSI_TRUST_MEASURED_CANARY 0 1
if ne rsi_evaluate_candidate c_hold RSI_HOLD_NO_GAIN
ret false
end
note L3_META with 150 bps gain (< 2*100 = 200) is denied with RSI_DENY_META_THRESHOLD
c_mlow = new RsiCandidate 402 RSI_TIER_L3_META 80 2 10000 long 150 long 0 0 1 RSI_TRUST_MEASURED_SILICON 0 1
if ne rsi_evaluate_candidate c_mlow RSI_DENY_META_THRESHOLD
ret false
end
note L3_META with 200 bps gain (>= 2*100) promotes
c_mok = new RsiCandidate 403 RSI_TIER_L3_META 80 2 10000 long 200 long 0 0 1 RSI_TRUST_MEASURED_SILICON 0 1
if ne rsi_evaluate_candidate c_mok RSI_PROMOTE
ret false
end
if or ne rsi_gate_held 1 or ne rsi_gate_denied 1 ne rsi_gate_promoted 1
ret false
end
ret true
end

note Test 5: Cryptographic SHA-256 ledger hash chain and Merkle root + leaf inclusion proofs (5 leaves).
fn test_rsi_ledger_and_merkle to bool
rsi_ledger_reset
root1 = new uchar 32 0
note Empty ledger must refuse Merkle root
if ne rsi_merkle_root root1 RSI_LDG_ERR_EMPTY
ret false
end
for i ulong 5
st = rsi_ledger_append add ulong 1000 i rem i 4 RSI_PROMOTE mul long i long 50 10000 RSI_TRUST_MEASURED_CANARY
if ne st RSI_LDG_OK
ret false
end
end
if ne rsi_ledger_count 5
ret false
end
if ne rsi_ledger_verify_chain RSI_LDG_OK
ret false
end
if ne rsi_merkle_root root1 RSI_LDG_OK
ret false
end
note Root must be deterministic on second call
root2 = new uchar 32 0
if ne rsi_merkle_root root2 RSI_LDG_OK
ret false
end
if not rldg_hash_eq root1 root2
ret false
end
note Verify Merkle inclusion proof for every leaf 0..4
for i ulong 5
if not rsi_merkle_verify_leaf i root1
ret false
end
end
note Out-of-bounds leaf index must fail
if rsi_merkle_verify_leaf 5 root1
ret false
end
ret true
end

note Test 6 (NEGATIVE): Tampered record payload, broken prev_hash, and mutated Merkle root are caught.
fn test_rsi_ledger_negative_tamper to bool
rsi_ledger_reset
for i ulong 4
st = rsi_ledger_append add ulong 2000 i RSI_TIER_L1_KERNEL RSI_PROMOTE long 120 10000 RSI_TRUST_MEASURED_SILICON
if ne st RSI_LDG_OK
ret false
end
end
root = new uchar 32 0
if ne rsi_merkle_root root RSI_LDG_OK
ret false
end
note Mutated root must fail inclusion check
bad_root = new uchar 32 0
for j ulong 32
put bad_root j get root j
end
put bad_root 0 xor get bad_root 0 uchar 1
if rsi_merkle_verify_leaf 2 bad_root
ret false
end
note Tamper with record 2 perf_delta_bps -> chain verification must report RSI_LDG_ERR_HASH
rsi_ledger_tamper_perf 2 long 9999
if ne rsi_ledger_verify_chain RSI_LDG_ERR_HASH
ret false
end
note Restore perf_delta_bps, then tamper with record 3 prev_hash -> must report RSI_LDG_ERR_PREV_HASH
rsi_ledger_tamper_perf 2 long 120
if ne rsi_ledger_verify_chain RSI_LDG_OK
ret false
end
rsi_ledger_tamper_prev 3 7 uchar 0x80
if ne rsi_ledger_verify_chain RSI_LDG_ERR_PREV_HASH
ret false
end
ret true
end

fn main to int
put t_fails 0 0
t_report t_n1 test_rsi_promote_valid
t_report t_n2 test_rsi_negative_trust_branch_protected
t_report t_n3 test_rsi_negative_sec_replay_env_reg
t_report t_n4 test_rsi_meta_and_hold
t_report t_n5 test_rsi_ledger_and_merkle
t_report t_n6 test_rsi_ledger_negative_tamper
if eq get t_fails 0 0
t_w t_all_ok
ret 0
end
t_w t_all_bad
ret 1
end

note SPDX-License-Identifier: Apache-2.0
note core/rsi/om/governance/v2_main.om
note Standalone pure-Omega CLI for spark-rsi-mv Version 2 ECDSA P-256 promotion gate.
note Compose with:
note   core/rsi/om/p256/sha256.om core/rsi/om/p256/p256.om
note   core/rsi/om/governance/receipt_v2.om core/rsi/om/governance/v2_main.om
note Subcommands (argv[1]):
note   version   print engine version and V2 domain tag
note   selfcheck run built-in P-256 V2 receipt sign/verify + fail-closed promotion check
note   verify    read key=value V2 promotion bundle from stdin, output PROMOTE or REFUSE code=N

text vm_ver "spark-rsi-gate-om 2.0 (domain=spark-rsi.evaluation-receipt.v2, p256=fips186-4)\n"
text vm_usage "usage: rsi-v2-gate version|selfcheck|verify\n"
text vm_prom "PROMOTE digest="
text vm_ref "REFUSE code="
text vm_nl "\n"
text vm_cmd_ver "version"
text vm_cmd_sc "selfcheck"
text vm_cmd_vrf "verify"
text vm_k_ver "format_version="
text vm_k_htot "holdouts_total="
text vm_k_hpas "holdouts_passed="
text vm_k_adm "admitted="
text vm_k_hard "hard_inv="
text vm_k_stat "stat_gates="
text vm_k_mbps "min_ratio_bps="
text vm_k_cyc "cycle_id="
text vm_k_cnd "candidate_id="
text vm_k_par "parent_id="
text vm_k_eat "evaluated_at="
text vm_k_evv "evaluator_version="
text vm_k_ebh "evaluator_binary_sha256="
text vm_k_sp "subject_path="
text vm_k_sh "subject_sha256="
text vm_k_dh "disk_sha256="
text vm_k_hh "holdout_set_sha256="
text vm_k_ph "policy_sha256="
text vm_k_jp "judge_pub_hex="
text vm_k_op "own_pub_hex="
text vm_k_sg "signature_hex="
text vm_k_dg "receipt_digest="
text vm_k_al "allowed_target="
text vm_k_pr "protected_path="
text vm_sc_cyc "selfcheck-cycle"
text vm_sc_cnd "selfcheck-cand"
text vm_sc_par "selfcheck-parent"
text vm_sc_at "2026-11-21T00:00:00Z"
text vm_sc_ev "2.0.0"
text vm_sc_sp "README.md"

global vm_arg uchar 64
global vm_in uchar 16384

fn vm_write_u64 v ulong to void
buf = new uchar 24 0
if eq v 0
put buf 0 uchar 48
r = write 1 buf 0 1
ret
end
tmp = new uchar 24 0
cnt = ulong 0
x = v
while gt x 0 bound 24
put tmp cnt uchar add 48 rem x 10
cnt = add cnt 1
x = div x 10
end
for i ulong cnt bound 24
put buf i get tmp sub sub cnt 1 i
end
r = write 1 buf 0 cnt
end

fn vm_hex_nib c uchar to ulong
if and ge c uchar 48 le c uchar 57
ret ulong sub c uchar 48
end
if and ge c uchar 97 le c uchar 102
ret add 10 ulong sub c uchar 97
end
if and ge c uchar 65 le c uchar 70
ret add 10 ulong sub c uchar 65
end
ret 255
end

fn vm_arg_eq n ulong which ulong to bool
if eq which 0
if ne n len vm_cmd_ver
ret false
end
for i ulong n bound 64
if ne get vm_arg i get vm_cmd_ver i
ret false
end
end
ret true
end
if eq which 1
if ne n len vm_cmd_sc
ret false
end
for i ulong n bound 64
if ne get vm_arg i get vm_cmd_sc i
ret false
end
end
ret true
end
if ne n len vm_cmd_vrf
ret false
end
for i ulong n bound 64
if ne get vm_arg i get vm_cmd_vrf i
ret false
end
end
ret true
end

fn vm_selfcheck to int
rv2_reset
jpriv = new uchar 32 3
opriv = new uchar 32 4
jpub = new uchar 65 0
opub = new uchar 65 0
if ne rv2_p256_pubkey jpriv jpub 0
ret 1
end
if ne rv2_p256_pubkey opriv opub 0
ret 1
end
for i ulong 65
put rv2_judge_pub i get jpub i
put rv2_own_pub i get opub i
end
for i ulong 64
put rv2_eval_bin_hex i uchar 97
put rv2_subj_hex i uchar 98
put rv2_sub_content_hex i uchar 98
put rv2_sub_disk_hex i uchar 98
put rv2_holdout_hex i uchar 99
put rv2_pol_holdout_hex i uchar 99
put rv2_policy_hex i uchar 100
put rv2_pol_sha_hex i uchar 100
end
put rv2_meta 0 2
put rv2_meta 1 1
put rv2_meta 2 1
put rv2_meta 3 1
put rv2_meta 4 1
put rv2_meta 5 1
put rv2_meta 6 0
put rv2_meta 7 0
put rv2_meta 9 len vm_sc_cyc
for i ulong len vm_sc_cyc bound 64
put rv2_cycle i get vm_sc_cyc i
end
put rv2_meta 10 len vm_sc_cnd
for i ulong len vm_sc_cnd bound 64
put rv2_cand i get vm_sc_cnd i
end
put rv2_meta 11 len vm_sc_par
put rv2_pol_meta 4 len vm_sc_par
for i ulong len vm_sc_par bound 64
put rv2_parent i get vm_sc_par i
put rv2_sub_parent i get vm_sc_par i
end
put rv2_meta 12 len vm_sc_at
for i ulong len vm_sc_at bound 64
put rv2_eval_at i get vm_sc_at i
end
put rv2_meta 13 len vm_sc_ev
for i ulong len vm_sc_ev bound 64
put rv2_eval_ver i get vm_sc_ev i
end
put rv2_meta 14 len vm_sc_sp
put rv2_pol_meta 5 len vm_sc_sp
put rv2_pol_alen 0 len vm_sc_sp
for i ulong len vm_sc_sp bound 64
put rv2_subj_path i get vm_sc_sp i
put rv2_sub_path i get vm_sc_sp i
put rv2_pol_allowed i get vm_sc_sp i
end
put rv2_pol_meta 0 1
put rv2_pol_meta 1 10000
put rv2_pol_meta 2 1
put rv2_pol_meta 3 0
rv2_compute_digest
dig = new uchar 32 0
sig = new uchar 64 0
for i ulong 32
put rv2_claimed_dig i get rv2_comp_dig i
put dig i get rv2_comp_dig i
end
if ne rv2_p256_sign jpriv dig sig 0
ret 1
end
for i ulong 64
put rv2_sig i get sig i
end
rc = rv2_check_promotion
if ne rc RV2_OK
r = write 1 vm_ref 0 len vm_ref
vm_write_u64 rc
r = write 1 vm_nl 0 len vm_nl
ret 1
end
r = write 1 vm_prom 0 len vm_prom
r = write 1 rv2_comp_hex 0 64
r = write 1 vm_nl 0 len vm_nl
ret 0
end

fn vm_parse_u64 s ulong e ulong to ulong
if ge s e
ret 0
end
acc = ulong 0
i = s
while lt i e bound 24
c = get vm_in i
if or lt c uchar 48 gt c uchar 57
ret 0
end
acc = add mul acc 10 ulong sub c uchar 48
i = add i 1
end
ret acc
end

fn vm_line_has s ulong e ulong kind ulong to ulong
n = sub e s
if eq kind 0
kl = len vm_k_ver
if lt n kl
ret 0
end
for i ulong kl bound 32
if ne get vm_in add s i get vm_k_ver i
ret 0
end
end
ret kl
end
if eq kind 1
kl = len vm_k_htot
if lt n kl
ret 0
end
for i ulong kl bound 32
if ne get vm_in add s i get vm_k_htot i
ret 0
end
end
ret kl
end
if eq kind 2
kl = len vm_k_hpas
if lt n kl
ret 0
end
for i ulong kl bound 32
if ne get vm_in add s i get vm_k_hpas i
ret 0
end
end
ret kl
end
if eq kind 3
kl = len vm_k_adm
if lt n kl
ret 0
end
for i ulong kl bound 32
if ne get vm_in add s i get vm_k_adm i
ret 0
end
end
ret kl
end
if eq kind 4
kl = len vm_k_hard
if lt n kl
ret 0
end
for i ulong kl bound 32
if ne get vm_in add s i get vm_k_hard i
ret 0
end
end
ret kl
end
if eq kind 5
kl = len vm_k_stat
if lt n kl
ret 0
end
for i ulong kl bound 32
if ne get vm_in add s i get vm_k_stat i
ret 0
end
end
ret kl
end
if eq kind 6
kl = len vm_k_mbps
if lt n kl
ret 0
end
for i ulong kl bound 32
if ne get vm_in add s i get vm_k_mbps i
ret 0
end
end
ret kl
end
ret 0
end

fn vm_verify_stdin to int
rv2_reset
put rv2_pol_meta 0 1
put rv2_pol_meta 1 10000
tot = ulong 0
while lt tot 16384 bound 16384
k = read 0 vm_in tot sub 16384 tot
if le k 0
break
end
tot = add tot ulong k
end
pos = ulong 0
while lt pos tot bound 256
ls = pos
while lt pos tot bound 16384
if eq get vm_in pos uchar 10
break
end
pos = add pos 1
end
le_p = pos
if lt pos tot
pos = add pos 1
end
if gt le_p ls
if eq get vm_in sub le_p 1 uchar 13
le_p = sub le_p 1
end
end
if eq le_p ls
continue
end
kl = vm_line_has ls le_p 0
if gt kl 0
put rv2_meta 0 vm_parse_u64 add ls kl le_p
continue
end
kl = vm_line_has ls le_p 1
if gt kl 0
put rv2_meta 1 vm_parse_u64 add ls kl le_p
continue
end
kl = vm_line_has ls le_p 2
if gt kl 0
put rv2_meta 2 vm_parse_u64 add ls kl le_p
continue
end
kl = vm_line_has ls le_p 3
if gt kl 0
put rv2_meta 3 vm_parse_u64 add ls kl le_p
continue
end
kl = vm_line_has ls le_p 4
if gt kl 0
put rv2_meta 4 vm_parse_u64 add ls kl le_p
continue
end
kl = vm_line_has ls le_p 5
if gt kl 0
put rv2_meta 5 vm_parse_u64 add ls kl le_p
continue
end
kl = vm_line_has ls le_p 6
if gt kl 0
put rv2_pol_meta 1 vm_parse_u64 add ls kl le_p
continue
end
end
rc = rv2_check_promotion
if eq rc RV2_OK
r = write 1 vm_prom 0 len vm_prom
r = write 1 rv2_comp_hex 0 64
r = write 1 vm_nl 0 len vm_nl
ret 0
end
r = write 1 vm_ref 0 len vm_ref
vm_write_u64 rc
r = write 1 vm_nl 0 len vm_nl
ret 1
end

fn main to int
ac = argcnt
if lt ac 2
r = write 2 vm_usage 0 len vm_usage
ret 2
end
n = argread 1 vm_arg 0 64
if le n 0
r = write 2 vm_usage 0 len vm_usage
ret 2
end
un = ulong n
if vm_arg_eq un 0
r = write 1 vm_ver 0 len vm_ver
ret 0
end
if vm_arg_eq un 1
ret vm_selfcheck
end
if vm_arg_eq un 2
ret vm_verify_stdin
end
r = write 2 vm_usage 0 len vm_usage
ret 2
end

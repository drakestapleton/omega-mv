note SPDX-License-Identifier: Apache-2.0
note core/rsi/om/governance/v2_test.om
note Comprehensive positive, negative, and cryptographic tamper test suite for the pure-Omega
note spark-rsi-mv Version 2 ECDSA P-256 signed receipt verifier and promotion gate.
note Compose with:
note   core/rsi/om/p256/sha256.om core/rsi/om/p256/p256.om
note   core/rsi/om/governance/receipt_v2.om core/rsi/om/governance/v2_test.om

text vt_pass "PASS "
text vt_fail "FAIL "
text vt_nl "\n"
text vt_all_ok "RSI V2 P256 PROMOTION GATE TEST SUITE PASS\n"
text vt_all_bad "RSI V2 P256 PROMOTION GATE TEST SUITE FAIL\n"

text vt_n1 "rv2_valid_signed_receipt_promotes"
text vt_n2 "rv2_neg_disk_hash_and_v1_and_same_key"
text vt_n3 "rv2_neg_signature_and_digest_tamper"
text vt_n4 "rv2_neg_binding_and_path_and_holdout"
text vt_n5 "rv2_holdout_v1_digest_determinism"

text vt_cycle "cycle-v2"
text vt_cand "cand-v2"
text vt_parent "parent-v2"
text vt_eval_at "2026-10-08T22:00:00Z"
text vt_eval_ver "1.0.0"
text vt_subj "README.md"
text vt_readme "A plain readme for the candidate.\n"
text vt_jbin "judge-binary"
text vt_pol_bytes "policy-v2-bytes"
text vt_l0_name "correctness"
text vt_l0_sum "correctness summary"
text vt_l1_name "security"
text vt_l1_sum "security summary"
text vt_prot0 "holdouts"
text vt_prot1 "policy"
text vt_prot2 ".rsi"
text vt_bad_path "../README.md"
text vt_prot_subj "policy/rules.json"
text vt_unlisted "src/other.rs"
text vt_hfile "suite0.json"

global vt_fails ulong 1

fn vt_w_pass to void
r = write 1 vt_pass 0 len vt_pass
end

fn vt_w_fail to void
r = write 1 vt_fail 0 len vt_fail
end

fn vt_w_nl to void
r = write 1 vt_nl 0 len vt_nl
end

fn vt_report id ulong ok bool to void
if ok
vt_w_pass
else
vt_w_fail
put vt_fails 0 add get vt_fails 0 1
end
if eq id 1
r = write 1 vt_n1 0 len vt_n1
else
if eq id 2
r = write 1 vt_n2 0 len vt_n2
else
if eq id 3
r = write 1 vt_n3 0 len vt_n3
else
if eq id 4
r = write 1 vt_n4 0 len vt_n4
else
r = write 1 vt_n5 0 len vt_n5
end
end
end
end
vt_w_nl
end

note Write 32 raw bytes as 64 lowercase hex ASCII into dst64.
fn vt_raw_to_hex32 raw view uchar 32 dst64 edit uchar 64 to void
for i ulong 32
bv = ulong get raw i
put dst64 mul i 2 get rv2_hex_tbl shr bv 4
put dst64 add mul i 2 1 get rv2_hex_tbl and bv 15
end
end

note Populate a valid, signed V2 receipt matching tests/test_receipt_v2.rs structure.
note Judge key = [1; 32], promoter own key = [2; 32].
fn vt_setup_valid to bool
rv2_reset
note Derive judge pubkey (seed 1) and own pubkey (seed 2)
jpriv = new uchar 32 1
opriv = new uchar 32 2
jpub = new uchar 65 0
opub = new uchar 65 0
if ne rv2_p256_pubkey jpriv jpub 0
ret false
end
if ne rv2_p256_pubkey opriv opub 0
ret false
end
for i ulong 65
put rv2_judge_pub i get jpub i
put rv2_own_pub i get opub i
end
note Compute real SHA-256 hashes of README, judge-binary, policy, holdout
buf = new uchar 4096 0
h32 = new uchar 32 0
hex64 = new uchar 64 0
for i ulong len vt_readme bound 64
put buf i get vt_readme i
end
rv2_sha256_raw buf len vt_readme h32
vt_raw_to_hex32 h32 hex64
for i ulong 64
put rv2_subj_hex i get hex64 i
put rv2_sub_content_hex i get hex64 i
put rv2_sub_disk_hex i get hex64 i
end
for i ulong len vt_jbin bound 64
put buf i get vt_jbin i
end
rv2_sha256_raw buf len vt_jbin h32
vt_raw_to_hex32 h32 hex64
for i ulong 64
put rv2_eval_bin_hex i get hex64 i
end
for i ulong len vt_pol_bytes bound 64
put buf i get vt_pol_bytes i
end
rv2_sha256_raw buf len vt_pol_bytes h32
vt_raw_to_hex32 h32 hex64
for i ulong 64
put rv2_policy_hex i get hex64 i
put rv2_pol_sha_hex i get hex64 i
end
fname = new uchar 64 0
for i ulong len vt_hfile bound 64
put fname i get vt_hfile i
end
hh32 = new uchar 32 0
rv2_holdout_digest_1 fname len vt_hfile h32 hh32
vt_raw_to_hex32 hh32 hex64
for i ulong 64
put rv2_holdout_hex i get hex64 i
put rv2_pol_holdout_hex i get hex64 i
end
note Populate strings and metadata
put rv2_meta 0 2
put rv2_meta 1 4
put rv2_meta 2 4
put rv2_meta 3 1
put rv2_meta 4 1
put rv2_meta 5 1
put rv2_meta 6 2
put rv2_meta 7 1
put rv2_meta 8 12
put rv2_meta 9 len vt_cycle
for i ulong len vt_cycle bound 64
put rv2_cycle i get vt_cycle i
end
put rv2_meta 10 len vt_cand
for i ulong len vt_cand bound 64
put rv2_cand i get vt_cand i
end
put rv2_meta 11 len vt_parent
put rv2_pol_meta 4 len vt_parent
for i ulong len vt_parent bound 64
put rv2_parent i get vt_parent i
put rv2_sub_parent i get vt_parent i
end
put rv2_meta 12 len vt_eval_at
for i ulong len vt_eval_at bound 64
put rv2_eval_at i get vt_eval_at i
end
put rv2_meta 13 len vt_eval_ver
for i ulong len vt_eval_ver bound 64
put rv2_eval_ver i get vt_eval_ver i
end
put rv2_meta 14 len vt_subj
put rv2_pol_meta 5 len vt_subj
for i ulong len vt_subj bound 128
put rv2_subj_path i get vt_subj i
put rv2_sub_path i get vt_subj i
put rv2_pol_allowed i get vt_subj i
end
note Layers 0 and 1 (score = 1.0f64 -> 0x3ff0000000000000 = 4607182418800017408)
put rv2_lr_nlen 0 len vt_l0_name
for i ulong len vt_l0_name bound 64
put rv2_lr_name i get vt_l0_name i
end
put rv2_lr_hard 0 1
put rv2_lr_pass 0 1
put rv2_lr_score_bits 0 4607182418800017408
put rv2_lr_slen 0 len vt_l0_sum
for i ulong len vt_l0_sum bound 128
put rv2_lr_sum i get vt_l0_sum i
end
put rv2_lr_nlen 1 len vt_l1_name
for i ulong len vt_l1_name bound 64
put rv2_lr_name add 64 i get vt_l1_name i
end
put rv2_lr_hard 1 1
put rv2_lr_pass 1 1
put rv2_lr_score_bits 1 4607182418800017408
put rv2_lr_slen 1 len vt_l1_sum
for i ulong len vt_l1_sum bound 128
put rv2_lr_sum add 128 i get vt_l1_sum i
end
note Metrics IEEE-754 f64 bit patterns (-1.0, 0.01, 0.5, 0.7, 0.1)
put rv2_metrics_bits 0 13830554455654793216
put rv2_metrics_bits 1 4576918229304087675
put rv2_metrics_bits 2 4602678819172646912
put rv2_metrics_bits 3 4604480259023595110
put rv2_metrics_bits 4 4591870180066957722
note Policy: require_admitted=1, min_ratio=10000 bps (1.0), 1 allowed target, 3 protected paths
put rv2_pol_meta 0 1
put rv2_pol_meta 1 10000
put rv2_pol_meta 2 1
put rv2_pol_alen 0 len vt_subj
put rv2_pol_meta 3 3
put rv2_pol_plen 0 len vt_prot0
for i ulong len vt_prot0 bound 64
put rv2_pol_prot i get vt_prot0 i
end
put rv2_pol_plen 1 len vt_prot1
for i ulong len vt_prot1 bound 64
put rv2_pol_prot add 128 i get vt_prot1 i
end
put rv2_pol_plen 2 len vt_prot2
for i ulong len vt_prot2 bound 64
put rv2_pol_prot add 256 i get vt_prot2 i
end
note Compute V2 digest and sign with judge key
rv2_compute_digest
dig = new uchar 32 0
for i ulong 32
b = get rv2_comp_dig i
put rv2_claimed_dig i b
put dig i b
end
sig = new uchar 64 0
if ne rv2_p256_sign jpriv dig sig 0
ret false
end
for i ulong 64
put rv2_sig i get sig i
end
ret true
end

fn test_v1_valid to bool
if not vt_setup_valid
ret false
end
ret eq rv2_check_promotion RV2_OK
end

fn test_v2_neg_disk_v1_samekey to bool
if not vt_setup_valid
ret false
end
note Disk hash mismatch
put rv2_sub_disk_hex 0 uchar 120
if ne rv2_check_promotion RV2_ERR_DISK_HASH_MISMATCH
ret false
end
note Restore, test v1 receipt refused
if not vt_setup_valid
ret false
end
put rv2_meta 0 1
if ne rv2_check_promotion RV2_ERR_NOT_V2
ret false
end
note Restore, test judge_key == own_key refused (no self-signing)
if not vt_setup_valid
ret false
end
for i ulong 65
put rv2_own_pub i get rv2_judge_pub i
end
if ne rv2_check_promotion RV2_ERR_SAME_KEY
ret false
end
note Restore, test malformed judge pubkey prefix
if not vt_setup_valid
ret false
end
put rv2_judge_pub 0 uchar 2
if ne rv2_check_promotion RV2_ERR_BAD_JUDGE_KEY
ret false
end
ret true
end

fn test_v3_neg_sig_digest to bool
if not vt_setup_valid
ret false
end
note Flip 1 bit in signature
put rv2_sig 0 xor get rv2_sig 0 uchar 1
if ne rv2_check_promotion RV2_ERR_BAD_SIGNATURE
ret false
end
note Restore, mutate evaluated field without re-signing -> digest mismatch
if not vt_setup_valid
ret false
end
put rv2_meta 2 3
if ne rv2_check_promotion RV2_ERR_BAD_DIGEST
ret false
end
note Restore, sign with WRONG key (promoter key instead of judge key) -> signature refused
if not vt_setup_valid
ret false
end
opriv = new uchar 32 2
dig = new uchar 32 0
for i ulong 32
put dig i get rv2_claimed_dig i
end
wsig = new uchar 64 0
if ne rv2_p256_sign opriv dig wsig 0
ret false
end
for i ulong 64
put rv2_sig i get wsig i
end
if ne rv2_check_promotion RV2_ERR_BAD_SIGNATURE
ret false
end
ret true
end

fn test_v4_neg_binding_path_holdout to bool
note Unlisted target refused (even with valid judge signature!)
if not vt_setup_valid
ret false
end
put rv2_meta 14 len vt_unlisted
put rv2_pol_meta 5 len vt_unlisted
for i ulong len vt_unlisted bound 64
put rv2_subj_path i get vt_unlisted i
put rv2_sub_path i get vt_unlisted i
end
rv2_compute_digest
jpriv = new uchar 32 1
dig = new uchar 32 0
sig = new uchar 64 0
for i ulong 32
put rv2_claimed_dig i get rv2_comp_dig i
put dig i get rv2_comp_dig i
end
if ne rv2_p256_sign jpriv dig sig 0
ret false
end
for i ulong 64
put rv2_sig i get sig i
end
if ne rv2_check_promotion RV2_ERR_NOT_ALLOWED_TARGET
ret false
end
note Protected path refused even if added to allowed_targets
if not vt_setup_valid
ret false
end
put rv2_meta 14 len vt_prot_subj
put rv2_pol_meta 5 len vt_prot_subj
put rv2_pol_alen 0 len vt_prot_subj
for i ulong len vt_prot_subj bound 64
put rv2_subj_path i get vt_prot_subj i
put rv2_sub_path i get vt_prot_subj i
put rv2_pol_allowed i get vt_prot_subj i
end
rv2_compute_digest
for i ulong 32
put rv2_claimed_dig i get rv2_comp_dig i
put dig i get rv2_comp_dig i
end
if ne rv2_p256_sign jpriv dig sig 0
ret false
end
for i ulong 64
put rv2_sig i get sig i
end
if ne rv2_check_promotion RV2_ERR_PROTECTED_PATH
ret false
end
note Traversal path refused
if not vt_setup_valid
ret false
end
put rv2_meta 14 len vt_bad_path
put rv2_pol_meta 5 len vt_bad_path
for i ulong len vt_bad_path bound 64
put rv2_subj_path i get vt_bad_path i
put rv2_sub_path i get vt_bad_path i
end
rv2_compute_digest
for i ulong 32
put rv2_claimed_dig i get rv2_comp_dig i
put dig i get rv2_comp_dig i
end
if ne rv2_p256_sign jpriv dig sig 0
ret false
end
for i ulong 64
put rv2_sig i get sig i
end
if ne rv2_check_promotion RV2_ERR_SUBJECT_PATH
ret false
end
note Holdouts 3/4 below 10000 bps threshold refused
if not vt_setup_valid
ret false
end
put rv2_meta 2 3
rv2_compute_digest
for i ulong 32
put rv2_claimed_dig i get rv2_comp_dig i
put dig i get rv2_comp_dig i
end
if ne rv2_p256_sign jpriv dig sig 0
ret false
end
for i ulong 64
put rv2_sig i get sig i
end
if ne rv2_check_promotion RV2_ERR_HOLDOUT_THRESHOLD
ret false
end
note Not admitted refused
if not vt_setup_valid
ret false
end
put rv2_meta 3 0
rv2_compute_digest
for i ulong 32
put rv2_claimed_dig i get rv2_comp_dig i
put dig i get rv2_comp_dig i
end
if ne rv2_p256_sign jpriv dig sig 0
ret false
end
for i ulong 64
put rv2_sig i get sig i
end
if ne rv2_check_promotion RV2_ERR_NOT_ADMITTED
ret false
end
ret true
end

fn test_v5_holdout_det to bool
fname = new uchar 64 0
for i ulong len vt_hfile bound 64
put fname i get vt_hfile i
end
h1 = new uchar 32 7
h2 = new uchar 32 8
d1 = new uchar 32 0
d2 = new uchar 32 0
d3 = new uchar 32 0
rv2_holdout_digest_1 fname len vt_hfile h1 d1
rv2_holdout_digest_1 fname len vt_hfile h1 d2
rv2_holdout_digest_1 fname len vt_hfile h2 d3
for i ulong 32
if ne get d1 i get d2 i
ret false
end
end
diff = false
for i ulong 32
if ne get d1 i get d3 i
diff = true
break
end
end
ret diff
end

fn main to int
put vt_fails 0 0
vt_report 1 test_v1_valid
vt_report 2 test_v2_neg_disk_v1_samekey
vt_report 3 test_v3_neg_sig_digest
vt_report 4 test_v4_neg_binding_path_holdout
vt_report 5 test_v5_holdout_det
if eq get vt_fails 0 0
r = write 1 vt_all_ok 0 len vt_all_ok
ret 0
end
r = write 1 vt_all_bad 0 len vt_all_bad
ret 1
end

note hive-view src/run.om: run one program with an exact argument list (gpk), no shell, no PATH
note search, empty environment (execprog), stdin and stderr on /dev/null, stdout into gob,
note a monotonic deadline, SIGKILL on overrun, and reaping. File reads into gob, atomic writes.
fn vwchild wfd int to void
nul = fopen tdevnul 0 len tdevnul 2 0
if lt nul 0
exit 126
end
x = dupfd int nul 0 0
x = dupfd wfd 1 0
x = dupfd int nul 2 0
x = execprog gpk 0 get gpkl 0
exit 127
end
note vwdrain: read the pipe into gob until end of file; false on deadline or read error
fn vwdrain fd int dl long to bool
for it ulong 1000000
left = sub dl long monons
if le left 0
ret false
end
w = waitio fd 1 left
if lt w 0
if ne w -4
ret false
end
continue
end
if eq w 0
continue
end
n = get gol 0
if ge n len gob
put gotr 0 1
r = read fd gjunk 0 4096
if eq r 0
ret true
end
if lt r 0
if and ne r -4 ne r -11
ret false
end
end
continue
end
r = read fd gob n sub len gob n
if eq r 0
ret true
end
if lt r 0
if and ne r -4 ne r -11
ret false
end
continue
end
put gol 0 add n ulong r
end
ret false
end
note vwreap: wait for pid until dl, then SIGKILL and wait; returns the exit code, or -3 when signalled
fn vwreap pid int dl long to long
for it ulong 100000
w = waitpid pid gwst 0 4 1
if eq w long pid
s = or ulong get gwst 0 shl ulong get gwst 1 8
if eq and s 127 0
ret long and shr s 8 255
end
ret -3
end
if lt w 0
if ne w -4
ret -4
end
continue
end
if gt long monons dl
x = killpid pid 9
w = waitpid pid gwst 0 4 0
ret -1
end
x = sleepns 2000000
end
ret -4
end
note vwrun: run gpk with timeout tmo ns. Output in gob[0, gol). Returns the exit status 0..255,
note -1 timeout (killed), -2 could not start, -3 killed by a signal, -4 wait failure.
fn vwrun tmo long to long
put gol 0 0
put goa 0 0
put gotr 0 0
r = pipefds gpfd 0 8 524288
if lt r 0
ret -2
end
rfd = vwpfd 0
wfd = vwpfd 1
dl = add long monons tmo
pid = fork
if lt pid 0
x = fclose rfd
x = fclose wfd
ret -2
end
if eq pid 0
vwchild wfd
exit 127
end
x = fclose wfd
ok = vwdrain rfd dl
x = fclose rfd
if not ok
x = killpid int pid 9
end
st = vwreap int pid dl
if not ok
ret -1
end
ret st
end
note ---- file reads into gob. Path in gpth[0, gpl). Results: bytes in gob[goa, gol), or -errno.
fn vwfopen to long
ret fopen gpth 0 get gpl 0 524288 0
end
note vwrdall: up to cap bytes from the start (also for /proc files, whose stat size is 0)
fn vwrdall cap ulong to long
put gol 0 0
put goa 0 0
put gotr 0 0
fd = vwfopen
if lt fd 0
ret fd
end
c = cap
if gt c len gob
c = len gob
end
for it ulong 100000
n = get gol 0
if ge n c
put gotr 0 1
break
end
r = read int fd gob n sub c n
if le r 0
break
end
put gol 0 add n ulong r
end
x = fclose int fd
ret long get gol 0
end
note vwrdtail: the last cap bytes; when that starts mid-file, goa skips the partial first line
fn vwrdtail cap ulong to long
put gol 0 0
put goa 0 0
put gotr 0 0
fd = vwfopen
if lt fd 0
ret fd
end
r = fstat int fd gstb 0 128
if lt r 0
x = fclose int fd
ret r
end
size = vwst64 48
c = cap
if gt c len gob
c = len gob
end
pos = ulong 0
if gt size c
pos = sub size c
put gotr 0 1
end
for it ulong 100000
n = get gol 0
if ge n c
break
end
k = pread int fd gob n sub c n long add pos n
if le k 0
break
end
put gol 0 add n ulong k
end
x = fclose int fd
if gt pos 0
vwskipl
end
ret long sub get gol 0 get goa 0
end
fn vwskipl to void
n = get gol 0
for i ulong n
if eq get gob i 10
put goa 0 add i 1
ret
end
end
put goa 0 n
end
note ---- atomic write of ghd[0, ghdl) + gsb[0, gsl) to <run>/s<slot>: write s<slot>.t, then rename
fn vwwgob fd int a ulong n ulong to bool
p = ulong 0
for it ulong 100000
if ge p n
ret true
end
w = write fd gsb add a p sub n p
if le w 0
ret false
end
p = add p ulong w
end
ret false
end
fn vwwhd fd int to bool
n = get ghdl 0
p = ulong 0
for it ulong 1000
if ge p n
ret true
end
w = write fd ghd p sub n p
if le w 0
ret false
end
p = add p ulong w
end
ret false
end
fn vwpslot slot ulong to void
vwpb
vwpr
vwpc 47
vwpc 115
vwpd slot
end
fn vwwsec slot ulong to bool
vwpslot slot
ret vwwpath
end
note vwwpath: final path in gpth[0, gpl); writes gpth + ".t" then renames it over the final path
fn vwwpath to bool
n = get gpl 0
vwpc 46
vwpc 116
fd = fopen gpth 0 get gpl 0 524865 384
if lt fd 0
ret false
end
ok = vwwhd int fd
if ok
ok = vwwgob int fd 0 get gsl 0
end
x = fclose int fd
if not ok
ret false
end
vwkb
vwkopen
for i ulong add n 2
vwkc get gpth i
end
vwkopen
for i ulong n
vwkc get gpth i
end
r = renames gpk 0 get gpkl 0 0
ret eq r 0
end

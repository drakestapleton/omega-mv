note hive-view src/main.om: entry points.
note   server serve RUNDIR PORT ADDR [ADDR]   listen on each IPv4 ADDR:PORT (127.0.0.1 or the
note                                          Tailscale range 100.64.0.0/10 only), fork the
note                                          shared poller and one process per connection
note   server mktoken                         create ~/.config/hive-view/token (mode 600, 64 hex)
note   server poll-once RUNDIR                one full poller pass, then exit (tests)
note Exit codes: 2 usage, 3 token missing or unsafe, 4 address refused, 5 listen failed,
note 6 HOME unset, 17 token already exists, 18 token write failed.
global gpoll uchar 32
global glf ulong 4
global glfn ulong 1
text tserve "serve"
text tmktok "mktoken"
text tpoll1 "poll-once"
text tenvh "HOME="
text tcfgd "/.config/hive-view"
text ttokf "/.config/hive-view/token"
text tstd1 "/.local/state"
text tstd2 "/.local/state/hive-view"
text tlhost "localhost:"
text tlspark "spark.hub.internal:"
text tlspk "spark:"
text tmsgtok "token written to ~/.config/hive-view/token (mode 600)\n"
text tmsgex "refused: ~/.config/hive-view/token already exists\n"
fn vwhome to bool
eb = new uchar 600 0
for i ulong ulong envcnt
n = envread i eb 0 600
if gt n 5
if heq view part eb 0 5 tenvh
k = hmin sub ulong n 5 511
for j ulong k
put ghome j get eb add 5 j
end
put ghomel 0 k
ret gt k 0
end
end
end
ret false
end
note vwarg: argument i into ab; its length, or 0
fn vwarg i ulong ab edit uchar 512 to ulong
if ge i ulong argcnt
ret 0
end
n = argread i ab 0 512
if le n 0
ret 0
end
ret ulong n
end
fn vwargis ab edit uchar 512 n ulong t view uchar * to bool
ret heq view part ab 0 n t
end
note vwtokld: the token file is ours, mode 0600 (no group/other bits), and 64 lowercase hex
fn vwtokld to bool
vwhpath ttokf
fd = vwfopen
if lt fd 0
ret false
end
r = fstat int fd gstb 0 128
if lt r 0
x = fclose int fd
ret false
end
mode = vwst32 16
uid = vwst32 24
size = vwst64 48
ok = and eq and mode 63 0 eq uid ulong getuid
ok = and ok or eq size 64 eq size 65
if ok
r = read int fd gtok 0 64
ok = eq r 64
end
x = fclose int fd
if not ok
ret false
end
for i ulong 64
if not vwhex get gtok i
ret false
end
end
ret true
end
fn vwmktok to int
vwhpath tcfgd
r = makedir gpth 0 get gpl 0 448
vwhpath ttokf
fd = fopen gpth 0 get gpl 0 524481 384
if lt fd 0
x = write 2 tmsgex 0 len tmsgex
ret 17
end
rb = new uchar 32 0
hx = new uchar 65 0
k = random rb 0 32 0
if ne k 32
x = fclose int fd
ret 18
end
for i ulong 32
c = get rb i
put hx mul i 2 get thexd shr c 4
put hx add mul i 2 1 get thexd and c 15
end
put hx 64 10
w = write int fd hx 0 65
s = fsync int fd
x = fclose int fd
if ne w 65
ret 18
end
x = write 1 tmsgtok 0 len tmsgtok
ret 0
end
note vwip: dotted IPv4 in ab[0, n) as a host-order uint, or 0 when malformed
fn vwip ab edit uchar 512 n ulong to ulong
v = ulong 0
part8 = ulong 0
digs = ulong 0
dots = ulong 0
for i ulong n
c = get ab i
if eq c 46
if or eq digs 0 gt part8 255
ret 0
end
v = or shl v 8 part8
part8 = 0
digs = 0
dots = add dots 1
else
if not vwdig c
ret 0
end
part8 = add mul part8 10 ulong sub c 48
digs = add digs 1
if gt digs 3
ret 0
end
end
end
if or or ne dots 3 eq digs 0 gt part8 255
ret 0
end
ret or shl v 8 part8
end
note vwipok: loopback 127.0.0.1 or the Tailscale CGNAT range 100.64.0.0/10; never 0.0.0.0
fn vwipok ip ulong to bool
if eq ip 2130706433
ret true
end
ret eq shr ip 22 401
end
fn vwahadd ab edit uchar 512 n ulong to void
k = get gahn 0
if ge k 8
ret
end
b = ulong 0
if gt k 0
b = add get gaho sub k 1 get gahl sub k 1
end
if gt add b add n 6 len gah
ret
end
for i ulong n
put gah add b i get ab i
end
put gaho k b
put gahl k n
put gahn 0 add k 1
end
fn vwahport t view uchar * to void
ab = new uchar 512 0
n = ulong 0
for i ulong len t
put ab n get t i
n = add n 1
end
vwahtail ab n
end
note vwahtail: append ":PORT" (unless already ends in ':') and add as an allowed Host
fn vwahtail ab edit uchar 512 n ulong to void
m = n
if gt m 0
if ne get ab sub m 1 58
put ab m 58
m = add m 1
end
end
d = new uchar 20 0
i = ulong 20
x = get gport 0
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i
put ab m get d add i k
m = add m 1
end
vwahadd ab m
end
fn vwlisten ab edit uchar 512 n ulong tail bool to int
ip = vwip ab n
if eq ip 0
ret 4
end
if not vwipok ip
ret 4
end
a = new uchar 16 0
r = haddr4 a uint ip get gport 0
lf = hlisten a 64
if lt lf 0
ret 5
end
k = get glfn 0
put glf k ulong lf
put glfn 0 add k 1
vwahtail ab n
if tail
vwahport tlspark
vwahport tlspk
end
ret 0
end
fn vwclosel to void
for k ulong get glfn 0
x = fclose int get glf k
end
end
fn vwspawn to long
pid = fork
if eq pid 0
vwclosel
vwpoll
exit 0
end
ret pid
end
fn vwpollset to ulong
for k ulong get glfn 0
b = mul k 8
fd = get glf k
put gpoll b uchar and fd 255
put gpoll add b 1 uchar and shr fd 8 255
put gpoll add b 2 0
put gpoll add b 3 0
put gpoll add b 4 1
put gpoll add b 5 0
put gpoll add b 6 0
put gpoll add b 7 0
end
ret mul get glfn 0 8
end
fn vwaccept1 k ulong to long
if eq and get gpoll add mul k 8 6 1 0
ret 0
end
c = accept int get glf k 526336
if lt c 0
ret 0
end
pid = fork
if eq pid 0
vwclosel
vwconn c
exit 0
end
x = fclose int c
if gt pid 0
ret 1
end
ret 0
end
fn vwserve to int
ab = new uchar 512 0
n = vwarg 2 ab
if or eq n 0 gt n 400
ret 2
end
for i ulong n
put grun i get ab i
end
put grunl 0 n
n = vwarg 3 ab
if not hdigits view part ab 0 n
ret 2
end
port = hdecv view part ab 0 n
if or eq port 0 gt port 65535
ret 2
end
put gport 0 port
if not vwtokld
ret 3
end
put gahn 0 0
vwahport tlhost
argn = ulong argcnt
if or lt argn 5 gt argn 6
ret 2
end
for i ulong sub argn 4
n = vwarg add i 4 ab
r = vwlisten ab n not eq vwip ab n 2130706433
if ne r 0
ret r
end
end
vwhpath tstd1
r = makedir gpth 0 get gpl 0 448
vwhpath tstd2
r = makedir gpth 0 get gpl 0 448
r = makedir grun 0 get grunl 0 448
ret vwloop
end
fn vwloop to int
poller = vwspawn
backoff = long 0
active = ulong 0
np = vwpollset
for it ulong 9223372036854775807
for k ulong 128
w = waitpid -1 gwst 0 4 1
if le w 0
break
end
if eq w poller
poller = -1
backoff = add long monons 2000000000
else
if gt active 0
active = sub active 1
end
end
end
if and lt poller 0 gt long monons backoff
poller = vwspawn
end
if ge active 48
x = sleepns 50000000
continue
end
for k ulong 4
put gpoll add mul k 8 6 0
end
r = pollfds gpoll 0 np 500000000
if le r 0
continue
end
for k ulong get glfn 0
active = add active ulong vwaccept1 k
end
end
ret 0
end
fn vwpollonce to int
ab = new uchar 512 0
n = vwarg 2 ab
if or eq n 0 gt n 400
ret 2
end
for i ulong n
put grun i get ab i
end
put grunl 0 n
r = makedir grun 0 get grunl 0 448
vwinitsec
put ggen 0 vwnowms
vwpanes
vwslow
vwkanban
vwindex 0
ret 0
end
fn main to int
if not vwhome
ret 6
end
ab = new uchar 512 0
n = vwarg 1 ab
if vwargis ab n tserve
ret vwserve
end
if vwargis ab n tmktok
ret vwmktok
end
if vwargis ab n tpoll1
ret vwpollonce
end
ret 2
end

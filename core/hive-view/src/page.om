fn vwhermes2 to void
a = vwsecrd tnherm
vwh3 tnherm a 45000
b0 = get goa 0
n = get gol 0
p = b0
for it ulong 16
if ge p n
break
end
e = sub vwlend p n 1
f1 = vwtabf p e 1
if vwgis p sub f1 1 tgwkey
up = vwgis f1 vwtabe p e 1 tup
vwkvo tgateway not up
if up
vwht tup
else
vwht tdownc
end
vwkve
end
if vwgis p sub f1 1 tpkey
yes = vwgis f1 vwtabe p e 1 tyes
vwkvo tqpause yes
if yes
vwht tpaused
f2 = vwtabf p e 2
vwheo f2 sub e f2
else
vwht tnotp
end
vwkve
end
p = add e 1
end
end
note ---- kanban: lines "<marker> t_<id> <status> <assignee> <title>"; counts kept sorted by name
fn vwkline p ulong e ulong to ulong
a = vwgtok vwgsp p e e
s1 = vwgsp a e
if gt add s1 2 e
ret e
end
if or ne get gob s1 116 ne get gob add s1 1 95
ret e
end
ret s1
end
fn vwkcount p ulong q ulong to void
n = get gkn 0
l = hmin sub q p 47
for i ulong n
if vwkseq i p l
put gkc i add get gkc i 1
ret
end
end
if ge n 16
ret
end
ix = n
for i ulong n
if vwkslt p l i
ix = i
break
end
end
k = n
for it ulong 16
if le k ix
break
end
vwkmove sub k 1 k
k = sub k 1
end
for i ulong l
put gks add mul ix 48 i get gob add p i
end
put gksl ix l
put gkc ix 1
put gkn 0 add n 1
end
fn vwkmove s ulong d ulong to void
for i ulong 48
put gks add mul d 48 i get gks add mul s 48 i
end
put gksl d get gksl s
put gkc d get gkc s
end
fn vwkseq i ulong p ulong l ulong to bool
if ne get gksl i l
ret false
end
for k ulong l
if ne get gks add mul i 48 k get gob add p k
ret false
end
end
ret true
end
note vwkslt: gob[p, p+l) sorts before entry i
fn vwkslt p ulong l ulong i ulong to bool
m = get gksl i
for k ulong hmin l m
a = get gob add p k
b = get gks add mul i 48 k
if ne a b
ret lt a b
end
end
ret lt l m
end
fn vwkchips to void
vwht tchips
for i ulong get gkn 0
vwht tchip1
vwkname i
vwht tchip2
vwkname i
vwhc 32
vwhd get gkc i
vwht tspend
end
end
fn vwkname i ulong to void
b = mul i 48
for k ulong get gksl i
vwhe get gks add b k
end
end
fn vwkanb2 to void
put gkn 0 0
a = vwsecrd tnkan
vwh3 tkanh a 45000
b0 = get goa 0
n = get gol 0
p = b0
for it ulong 4096
if ge p n
break
end
e = sub vwlend p n 1
s1 = vwkline p e
if lt s1 e
s2 = vwgsp vwgtok s1 e e
vwkcount s2 vwgtok s2 e
end
p = add e 1
end
vwkchips
if and eq get gkn 0 0 gt n b0
vwheo b0 hmin sub n b0 300
end
vwht tdivc
vwkrun b0 n
end
fn vwkrun b0 ulong n ulong to void
vwht th3
vwht trunh
vwht th3e
p = b0
c = ulong 0
for it ulong 4096
if ge p n
break
end
e = sub vwlend p n 1
s1 = vwkline p e
if lt s1 e
t1 = vwgtok s1 e
s2 = vwgsp t1 e
t2 = vwgtok s2 e
if vwgis s2 t2 trunning
vwht tcard1
vwheo s1 sub t1 s1
vwht tcard2
s3 = vwgsp t2 e
vwheo s3 sub e s3
vwht tdivc
c = add c 1
end
end
p = add e 1
end
if eq c 0
vwht tmuted
vwht tnorun
vwht tdivc
end
end

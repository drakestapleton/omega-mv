note ---- the HTML builder: gh[0, ghl), flushed to the connection by vwflush
fn vwhc c uchar to void
n = get ghl 0
if lt n 262144
put gh n c
put ghl 0 add n 1
end
end
fn vwht t view uchar * to void
for i ulong len t
vwhc get t i
end
end
fn vwhd v ulong to void
if ge v 10
vwhd div v 10
end
vwhc uchar add rem v 10 48
end
fn vwhd2 v ulong to void
if lt v 10
vwhc 48
end
vwhd v
end
note vwhe: one untrusted byte as HTML text (also safe inside a quoted attribute)
fn vwhe c uchar to void
if eq c 38
vwht thamp
ret
end
if eq c 60
vwht thlt
ret
end
if eq c 62
vwht thgt
ret
end
if eq c 34
vwht thquo
ret
end
if eq c 39
vwht thapo
ret
end
if or lt c 32 eq c 127
if or eq c 10 eq c 9
vwhc c
end
ret
end
vwhc c
end
fn vwheo a ulong n ulong to void
for i ulong n
vwhe get gob add a i
end
end
fn vwhei a ulong n ulong to void
for i ulong n
vwhe get gix add a i
end
end
fn vwheq to void
for i ulong get gql 0
vwhe get gq i
end
end
fn vwhet t view uchar * to void
for i ulong len t
vwhe get t i
end
end
fn vwflush cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
n = get ghl 0
for i ulong n
put buf i get gh i
end
put ghl 0 0
if eq n 0
ret 0
end
ret hput cs io view part buf 0 n
end
fn vwfin cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
r = vwflush cs io buf
ret hfe r hwfin cs io
end
note vwhtml: a 200 text/html response with the security headers, body chunked (or close-delimited)
fn vwhtml cs edit ulong 320 io edit uchar 131072 to long
put ghl 0 0
put gnow 0 vwnowms
r = hrspst cs io 200
r = hfe r vwsech cs io
r = hfe r hhname cs io tctype
r = hfe r hhval cs io tthtml
ret hfe r hhend cs io 1 0
end
note vwdoc: a self-refreshing panel document; the "lost" banner fades in by CSS alone after lost s
fn vwdoc refr ulong lost ulong to void
vwht tdoc1
vwhd refr
vwht tdoc2
vwhd lost
vwht tdoc3
end
fn vwpage t view uchar * to void
vwht tpage1
vwhet t
vwht tpage2
end
note ---- ages
fn vwhagt ms ulong to void
s = div add ms 500 1000
if lt s 60
vwhd s
vwht tsago
ret
end
if lt s 3600
vwhd div s 60
vwhc 109
vwhc 32
vwhd rem s 60
vwht tsago
ret
end
vwhd div s 3600
vwhc 104
vwhc 32
vwhd div rem s 3600 60
vwhc 109
vwht tago
end
fn vwherr st ulong to void
if eq st 2
vwht tefile
ret
end
if eq st 13
vwht teperm
ret
end
if ge st 1000
if eq st 1009
vwht tetmo
ret
end
if eq st 1008
vwht tenost
ret
end
if eq st 1007
vwht tesig
ret
end
vwht texit
if ge st 1010
vwhd sub st 1010
ret
end
vwhc 45
vwhd sub 1010 st
ret
end
vwht terr
vwhd st
end
note vwage: the age badge for refresh time t (ms) and status st; stale past lim ms
fn vwage t ulong st ulong lim ulong to void
ag = ulong 0
if gt get gnow 0 t
ag = sub get gnow 0 t
end
bad = gt ag lim
vwht tspage0
if ne st 0
vwht tcdown
else
if bad
vwht tcstale
end
end
vwht tqgt
vwhagt ag
if ne st 0
vwht tafail
vwherr st
vwhc 41
end
if bad
vwht tastale
end
vwht tspend
end
note ---- the poller's index: "P<TAB>now<TAB>tmux_st<TAB>tick" then "SLOT<TAB>GEN<TAB>TMS<TAB>ST<TAB>KIND<TAB>NAME"
fn vwrdix to bool
put gixl 0 0
vwpb
vwpr
vwpt tindex
fd = vwfopen
if lt fd 0
ret false
end
for it ulong 1000
n = get gixl 0
if ge n 32768
break
end
r = read int fd gix n sub 32768 n
if le r 0
break
end
put gixl 0 add n ulong r
end
x = fclose int fd
ret gt get gixl 0 0
end
fn vwixe a ulong to ulong
n = get gixl 0
for i ulong sub n a
if eq get gix add a i 10
ret add a i
end
end
ret n
end
note vwixf: start of tab-separated field k of the index line [a, e)
fn vwixf a ulong e ulong k ulong to ulong
if eq k 0
ret a
end
c = ulong 0
for i ulong sub e a
if eq get gix add a i 9
c = add c 1
if eq c k
ret add add a i 1
end
end
end
ret e
end
fn vwixn p ulong to ulong
v = ulong 0
for i ulong 20
if ge add p i get gixl 0
ret v
end
c = get gix add p i
if not vwdig c
ret v
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note vwixis: the index line [a, e) field k equals t
fn vwixis a ulong e ulong k ulong t view uchar * to bool
p = vwixf a e k
q = vwixf a e add k 1
if lt q e
q = sub q 1
end
if ne sub q p len t
ret false
end
for i ulong len t
if ne get gix add p i get t i
ret false
end
end
ret true
end
note vwixisq: field k equals the decoded query value gq
fn vwixisq a ulong e ulong k ulong to bool
p = vwixf a e k
q = vwixf a e add k 1
if lt q e
q = sub q 1
end
if ne sub q p get gql 0
ret false
end
for i ulong get gql 0
if ne get gix add p i get gq i
ret false
end
end
ret true
end
note vwixfind: the index line of section or session named gq (kind sec when sec), else gixl
fn vwixfind sec bool to ulong
a = vwixe 0
a = add a 1
for it ulong 128
if ge a get gixl 0
break
end
e = vwixe a
if vwixisq a e 5
if eq sec vwixis a e 4 tksec
ret a
end
end
a = add e 1
end
ret get gixl 0
end
fn vwixage a ulong lim ulong to void
e = vwixe a
vwage vwixn vwixf a e 2 vwixn vwixf a e 3 lim
end
note vwsnap: read the snapshot of the slot on index line a into gob; returns the body start
note (just past the "NAME<TAB>KIND<TAB>GEN" line) or gol when unreadable
fn vwsnap a ulong to ulong
vwpslot vwixn a
r = vwrdall 262144
if lt r 0
put gol 0 0
ret 0
end
ret vwlend 0 get gol 0
end
note vwsecq: look up section t (as gq) and read it; returns the index line or gixl
fn vwsecq t view uchar * to ulong
n = hmin len t 1024
for i ulong n
put gq i get t i
end
put gql 0 n
ret vwixfind true
end
note ---- query strings: ?name=value&... ; values are percent-decoded ('+' is a space) into gq
fn vwamp io edit uchar 131072 p ulong e ulong to ulong
for i ulong sub e p
if eq get io add p i 38
ret add p i
end
end
ret e
end
fn vwqnm io edit uchar 131072 p ulong q ulong nm view uchar * to bool
k = len nm
if le sub q p k
ret false
end
for i ulong k
if ne get io add p i get nm i
ret false
end
end
ret eq get io add p k 61
end
fn vwqdec io edit uchar 131072 p ulong q ulong to bool
n = ulong 0
i = p
for it ulong 4096
if ge i q
break
end
if ge n 1024
ret false
end
c = get io i
if eq c 43
c = 32
end
if eq c 37
if gt add i 3 q
ret false
end
h = hhexv get io add i 1
l = hhexv get io add i 2
if or gt h 15 gt l 15
ret false
end
c = uchar add mul h 16 l
i = add i 2
end
put gq n c
n = add n 1
i = add i 1
end
put gql 0 n
ret true
end
fn vwqget cs edit ulong 320 io edit uchar 131072 nm view uchar * to bool
put gql 0 0
tg = get cs HTOFF
tl = get cs HTLEN
pl = hplen cs io
if ge pl tl
ret false
end
p = add add tg pl 1
e = add tg tl
for it ulong 64
if ge p e
ret false
end
q = vwamp io p e
if vwqnm io p q nm
ret vwqdec io add add p len nm 1 q
end
p = add q 1
end
ret false
end
fn vwqis t view uchar * to bool
if ne get gql 0 len t
ret false
end
for i ulong len t
if ne get gq i get t i
ret false
end
end
ret true
end
note vwqname: gq is a session name the dashboard may address (1..63 of [A-Za-z0-9_-])
fn vwqname to bool
n = get gql 0
if or eq n 0 gt n 63
ret false
end
for i ulong n
if not vwnamec get gq i
ret false
end
end
ret true
end
note vwqnum: gq as a small decimal (0 when absent or not a number)
fn vwqnum to ulong
v = ulong 0
for i ulong hmin get gql 0 9
c = get gq i
if not vwdig c
ret 0
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note ---- ANSI SGR to classes. gst: 0 fg (0 default, else 1 + xterm-256 index), 1 bg, 2 flags
note (1 bold, 2 dim, 4 italic, 8 underline, 16 reverse). gsp: the span now open (fg, bg, flags, open).
note Truecolor is drawn with the nearest colour of the xterm-256 cube.
fn vwcubei v ulong to ulong
if lt v 48
ret 0
end
if lt v 115
ret 1
end
ret hmin 5 div sub v 35 40
end
fn vwsgrc c ulong to void
f = get gst 2
if eq c 0
put gst 0 0
put gst 1 0
put gst 2 0
ret
end
if eq c 1
put gst 2 or f 1
end
if eq c 2
put gst 2 or f 2
end
if eq c 3
put gst 2 or f 4
end
if eq c 4
put gst 2 or f 8
end
if eq c 7
put gst 2 or f 16
end
if eq c 22
put gst 2 and f 28
end
if eq c 23
put gst 2 and f 27
end
if eq c 24
put gst 2 and f 23
end
if eq c 27
put gst 2 and f 15
end
if and ge c 30 le c 37
put gst 0 sub c 29
end
if and ge c 90 le c 97
put gst 0 sub c 81
end
if and ge c 40 le c 47
put gst 1 sub c 39
end
if and ge c 100 le c 107
put gst 1 sub c 91
end
if eq c 39
put gst 0 0
end
if eq c 49
put gst 1 0
end
end
note vwsgrx: 38/48 extended colour at parameter i; returns how many parameters it used after i
fn vwsgrx i ulong to ulong
n = get gsvn 0
w = ulong 0
if eq get gsv i 48
w = 1
end
v = ulong 0
used = ulong 0
if and lt add i 2 n eq get gsv add i 1 5
v = add and get gsv add i 2 255 1
used = 2
end
if and lt add i 4 n eq get gsv add i 1 2
r = vwcubei and get gsv add i 2 255
g = vwcubei and get gsv add i 3 255
b = vwcubei and get gsv add i 4 255
v = add add add 16 add mul r 36 mul g 6 b 1
used = 4
end
put gst w v
ret used
end
fn vwsgr to void
n = get gsvn 0
if eq n 0
vwsgrc 0
ret
end
i = ulong 0
for it ulong 16
if ge i n
ret
end
c = get gsv i
if or eq c 38 eq c 48
i = add i vwsgrx i
else
vwsgrc c
end
i = add i 1
end
end
fn vwspclose to void
if eq get gsp 3 1
vwht tspend
put gsp 3 0
end
end
note vwspan: make the open span match gst before the next text byte
fn vwspan to void
fg = get gst 0
bg = get gst 1
f = get gst 2
if ne and f 16 0
fg = get gst 1
bg = get gst 0
if eq fg 0
fg = 1
end
if eq bg 0
bg = 8
end
end
f = and f 15
op = ne add add fg bg f 0
if eq get gsp 3 1
if and and eq get gsp 0 fg eq get gsp 1 bg eq get gsp 2 f
ret
end
end
vwspclose
if not op
ret
end
vwht tspc
if ne fg 0
vwht tspf
vwhd sub fg 1
end
if ne bg 0
vwht tspb
vwhd sub bg 1
end
vwspfl f
vwht tqgt
put gsp 0 fg
put gsp 1 bg
put gsp 2 f
put gsp 3 1
end
fn vwspfl f ulong to void
if ne and f 1 0
vwht tspbo
end
if ne and f 2 0
vwht tspdi
end
if ne and f 4 0
vwht tspit
end
if ne and f 8 0
vwht tspun
end
end
note vwesc: the escape sequence starting at gob[i] (ESC); applies SGR; returns the index after it
fn vwesc i ulong b ulong to ulong
if ge add i 1 b
ret b
end
c = get gob add i 1
if eq c 91
ret vwcsi add i 2 b
end
if eq c 93
for k ulong sub b add i 2
p = add add i 2 k
d = get gob p
if eq d 7
ret add p 1
end
if and eq d 27 lt add p 1 b
if eq get gob add p 1 92
ret add p 2
end
ret p
end
end
ret b
end
ret add i 2
end
fn vwcsi p ulong b ulong to ulong
put gsvn 0 0
v = ulong 0
dig = false
for k ulong sub b p
c = get gob add p k
if and ge c 64 le c 126
if dig
vwsvpush v
end
if eq c 109
vwsgr
end
ret add add p k 1
end
if vwdig c
v = add mul v 10 ulong sub c 48
if gt v 100000
v = 100000
end
dig = true
else
if dig
vwsvpush v
end
v = 0
dig = false
end
end
ret b
end
fn vwsvpush v ulong to void
n = get gsvn 0
if lt n 16
put gsv n v
put gsvn 0 add n 1
end
end
note vwansi: gob[a, b) as escaped HTML text with colour spans
fn vwansi a ulong b ulong to void
put gst 0 0
put gst 1 0
put gst 2 0
put gsp 3 0
i = a
for it ulong 1000000
if ge i b
break
end
c = get gob i
if eq c 27
i = vwesc i b
continue
end
if eq c 10
vwhc 10
else
if and ge c 32 ne c 127
vwspan
vwhe c
end
end
i = add i 1
end
vwspclose
end
note ---- pane parts: title and status lines taken from the plain (escape-free) text
note vwplain: gob[a, b) without escapes and control bytes into gtl; spaces trimmed
fn vwplain a ulong b ulong to void
put gtll 0 0
i = a
for it ulong 100000
if ge i b
break
end
c = get gob i
if eq c 27
i = vwesc2 i b
continue
end
if and ge c 32 ne c 127
n = get gtll 0
if lt n 4096
put gtl n c
put gtll 0 add n 1
end
end
i = add i 1
end
vwtltrim
end
note vwesc2: like vwesc but without touching the SGR state
fn vwesc2 i ulong b ulong to ulong
s0 = get gst 0
s1 = get gst 1
s2 = get gst 2
r = vwesc i b
put gst 0 s0
put gst 1 s1
put gst 2 s2
ret r
end
fn vwtltrim to void
n = get gtll 0
s = ulong 0
for i ulong n
if ne get gtl s 32
break
end
s = add s 1
end
e = n
for i ulong n
if le e s
break
end
if ne get gtl sub e 1 32
break
end
e = sub e 1
end
for i ulong sub e s
put gtl i get gtl add s i
end
put gtll 0 sub e s
end
note vwruleat: 1 or 3 when gtl[i] starts a rule character ('-', U+2500, U+2501), else 0
fn vwruleat i ulong to ulong
n = get gtll 0
if ge i n
ret 0
end
if eq get gtl i 45
ret 1
end
if and lt add i 2 n eq get gtl i 226
if and eq get gtl add i 1 148 le get gtl add i 2 129
if ge get gtl add i 2 128
ret 3
end
end
end
ret 0
end
fn vwruleend e ulong to ulong
if eq e 0
ret 0
end
if eq get gtl sub e 1 45
ret 1
end
if ge e 3
if eq vwruleat sub e 3 3
ret 3
end
end
ret 0
end
note vwisrule: gtl starts with 3 rule characters and has a letter or digit; then strip the rule
fn vwisrule to bool
i = ulong 0
for k ulong 3
w = vwruleat i
if eq w 0
ret false
end
i = add i w
end
an = false
for k ulong get gtll 0
c = get gtl k
if or vwdig c or and ge c 65 le c 90 and ge c 97 le c 122
an = true
end
end
if not an
ret false
end
s = ulong 0
for k ulong get gtll 0
w = vwruleat s
if and eq w 0 ne get gtl s 32
break
end
s = add s hmax w 1
end
e = get gtll 0
for k ulong get gtll 0
if le e s
break
end
w = vwruleend e
if and eq w 0 ne get gtl sub e 1 32
break
end
e = sub e hmax w 1
end
for k ulong sub e s
put gtl k get gtl add s k
end
put gtll 0 sub e s
ret true
end
fn hmax a ulong b ulong to ulong
if gt a b
ret a
end
ret b
end
note vwlstart: the start of the gob line that ends at p (p is at its LF or the end)
fn vwlstart c0 ulong p ulong to ulong
q = p
for it ulong 1000000
if le q c0
ret c0
end
if eq get gob sub q 1 10
ret q
end
q = sub q 1
end
ret c0
end
note vwparts: capture gob[c0, n): gpp 0/1 status line, 2/3 title line (plain text is redone by
note vwplain when drawn), 4 end of the last non-blank line, 5 status found, 6 title is a rule
fn vwparts c0 ulong n ulong to void
for i ulong 8
put gpp i 0
end
put gpp 4 c0
p = n
if and gt p c0 eq get gob sub p 1 10
p = sub p 1
end
for it ulong 400
s = vwlstart c0 p
vwplain s p
if gt get gtll 0 0
put gpp 0 s
put gpp 1 p
put gpp 4 p
put gpp 5 1
vwtitle c0 s
ret
end
if le s c0
ret
end
p = sub s 1
end
end
fn vwtitle c0 ulong s0 ulong to void
if le s0 c0
ret
end
p = sub s0 1
fb = false
for it ulong 8
s = vwlstart c0 p
vwplain s p
if gt get gtll 0 0
if vwisrule
put gpp 2 s
put gpp 3 p
put gpp 6 1
ret
end
if not fb
put gpp 2 s
put gpp 3 p
fb = true
end
end
if le s c0
ret
end
p = sub s 1
end
end
note vwhtitle / vwhstat: the title (rule stripped) and status line as escaped text
fn vwhtitle to void
if eq get gpp 3 0
ret
end
vwplain get gpp 2 get gpp 3
if eq get gpp 6 1
b = vwisrule
end
for i ulong get gtll 0
vwhe get gtl i
end
end
fn vwhstat to void
if eq get gpp 5 0
ret
end
vwplain get gpp 0 get gpp 1
for i ulong get gtll 0
vwhe get gtl i
end
end
note vwlomp: the status line looks like omp's (ctx:, (adv), [high]/[medium]/[low])
text tmk1 "ctx:"
text tmk2 "(adv)"
text tmk3 "[high]"
text tmk4 "[medium]"
text tmk5 "[low]"
fn vwtlhas t view uchar * to bool
n = get gtll 0
if lt n len t
ret false
end
for i ulong add sub n len t 1
ok = true
for k ulong len t
if ne get gtl add i k get t k
ok = false
break
end
end
if ok
ret true
end
end
ret false
end
fn vwlomp to bool
if eq get gpp 5 0
ret false
end
vwplain get gpp 0 get gpp 1
if or vwtlhas tmk1 vwtlhas tmk2
ret true
end
ret or vwtlhas tmk3 or vwtlhas tmk4 vwtlhas tmk5
end
note vwback: the start of the last k lines that end at p (content start c0)
fn vwback c0 ulong p ulong k ulong to ulong
q = p
for i ulong k
s = vwlstart c0 q
if le s c0
ret c0
end
q = sub s 1
end
ret add q 1
end
note ---- panes and tiles
note vwgf: start of '|'-field k of gob[a, e)
fn vwgf a ulong e ulong k ulong to ulong
if eq k 0
ret a
end
c = ulong 0
for i ulong sub e a
if eq get gob add a i 124
c = add c 1
if eq c k
ret add add a i 1
end
end
end
ret e
end
fn vwgfe a ulong e ulong k ulong to ulong
q = vwgf a e add k 1
if lt q e
ret sub q 1
end
ret e
end
note vwmeta: "cmd · WxH[ · attached]" from the list line gob[a, e)
fn vwmeta a ulong e ulong to void
p = vwgf a e 1
vwheo p sub vwgfe a e 1 p
vwht tdot
p = vwgf a e 4
vwheo p sub vwgfe a e 4 p
p = vwgf a e 2
if lt p e
if ne get gob p 48
vwht tattach
end
end
end
note vwpanebd: for the snapshot in gob (body at b0): sets gpp and returns the capture start
fn vwpanebd b0 ulong to ulong
n = get gol 0
c0 = vwlend b0 n
vwparts c0 n
ret c0
end
note vwtile: one session tile for index line a (snapshot already in gob, body at b0)
fn vwtile a ulong b0 ulong c0 ulong to void
e = vwixe a
p = vwixf a e 5
vwht ttile1
vwhei p sub e p
vwht ttile2
vwhei p sub e p
vwht ttile3
vwixage a 10000
vwht tdivc
vwht tptitle
vwhtitle
vwht tdivc
vwht tpstl
vwhstat
vwht tdivc
vwht tpmeta
vwmeta b0 sub c0 1
vwht tdivc
vwht tpterm
x = get gpp 4
vwansi vwback c0 x 14 x
vwht tpreend
vwht taend
end
note vwgroup: which tile group index line a belongs in: 1 omp, 2 lead, 3 other, 0 none (queen, sections)
fn vwgroup a ulong e ulong to ulong
if vwixis a e 4 tkomp
ret 1
end
if vwixis a e 4 tklead
ret 2
end
if vwixis a e 4 tkother
if vwlomp
ret 1
end
ret 3
end
ret 0
end
note GET /p/tiles?g=omp|lead|other
fn vwptiles cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
want = ulong 3
if vwqget cs io tqg
if vwqis tkomp
want = 1
end
if vwqis tklead
want = 2
end
end
r = vwhtml cs io
vwdoc 3 12
shown = ulong 0
if vwrdix
a = add vwixe 0 1
for it ulong 128
if ge a get gixl 0
break
end
e = vwixe a
if not vwixis a e 4 tksec
b0 = vwsnap a
c0 = vwpanebd b0
if eq vwgroup a e want
vwtile a b0 c0
shown = add shown 1
r = hfe r vwflush cs io buf
end
end
a = add e 1
end
end
if eq shown 0
vwht tmuted
vwht tsnone
vwht tdivc
end
vwht tdocend
r = hfe r vwfin cs io buf
ret r
end
note GET /p/pane?n=NAME: one session's whole screen
fn vwppane cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
have = vwqget cs io tqn
r = vwhtml cs io
vwdoc 2 8
a = get gixl 0
if and have vwrdix
a = vwixfind false
end
if ge a get gixl 0
vwht tmuted
vwht tnosessn
vwht tdivc
else
b0 = vwsnap a
c0 = vwpanebd b0
vwht tphead
vwheq
vwht ttile3
vwixage a 10000
vwht tdot
vwmeta b0 sub c0 1
vwht tdivc
vwht tptitle
vwhtitle
vwht tdivc
vwht tpstl
vwhstat
vwht tdivc
vwht tpterb
vwansi c0 get gpp 4
vwht tpreend
end
vwht tdocend
ret hfe r vwfin cs io buf
end
note GET /p/status: the feed's own heartbeat; a browser error page here means the server is down
fn vwpstat cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
r = vwhtml cs io
vwdoc 2 8
vwht tlive
s = rem div get gnow 0 1000 86400
vwhd2 div s 3600
vwhc 58
vwhd2 div rem s 3600 60
vwhc 58
vwhd2 rem s 60
vwht tzsp
if vwrdix
e = vwixe 0
t = vwixn vwixf 0 e 1
ts = vwixn vwixf 0 e 2
ag = ulong 0
if gt get gnow 0 t
ag = sub get gnow 0 t
end
if gt ag 12000
vwht tpstall
vwhagt ag
vwht tspend
else
if ne ts 0
vwht ttfail
else
vwht tpok
end
end
else
vwht tnoix
end
vwht tdocend
ret hfe r vwfin cs io buf
end
note ---- sections
fn vwgsp p ulong e ulong to ulong
x = p
for s ulong 65536
if ge x e
ret x
end
c = get gob x
if and ne c 32 ne c 9
ret x
end
x = add x 1
end
ret x
end
fn vwgtok p ulong e ulong to ulong
x = p
for s ulong 65536
if ge x e
ret x
end
c = get gob x
if or eq c 32 eq c 9
ret x
end
x = add x 1
end
ret x
end
note vwtabf: start of tab field k of gob[a, e)
fn vwtabf a ulong e ulong k ulong to ulong
if eq k 0
ret a
end
c = ulong 0
for i ulong sub e a
if eq get gob add a i 9
c = add c 1
if eq c k
ret add add a i 1
end
end
end
ret e
end
fn vwtabe a ulong e ulong k ulong to ulong
q = vwtabf a e add k 1
if lt q e
ret sub q 1
end
ret e
end
fn vwgis p ulong q ulong t view uchar * to bool
if ne sub q p len t
ret false
end
for i ulong len t
if ne get gob add p i get t i
ret false
end
end
ret true
end
fn vwkvo k view uchar * err bool to void
vwht tkv1
vwhet k
vwht tkv2
if err
vwht tkverr
end
vwht tqgt
end
fn vwkvoo a ulong n ulong to void
vwht tkv1
vwheo a n
vwht tkv2
vwht tqgt
end
fn vwkve to void
vwht tkv3
end
fn vwkvt k view uchar * v view uchar * err bool to void
vwkvo k err
vwhet v
vwkve
end
fn vwh3 t view uchar * a ulong lim ulong to void
vwht th3
vwhet t
vwhc 32
if lt a get gixl 0
vwixage a lim
end
vwht th3e
end
note vwsecrd: index line and body start for section t; gob holds it (gol 0 when absent)
fn vwsecrd t view uchar * to ulong
a = vwsecq t
put gol 0 0
if lt a get gixl 0
b = vwsnap a
put goa 0 b
end
ret a
end

note ---- machine, GPU, spark-window, pools, ledger
note vwhash: the line after "#name" in gob[b0, n) (its start), or n
fn vwhash b0 ulong n ulong t view uchar * to ulong
p = b0
for it ulong 4096
if ge p n
ret n
end
e = sub vwlend p n 1
if and gt sub e p 0 eq get gob p 35
if vwgis add p 1 e t
ret add e 1
end
end
p = add e 1
end
ret n
end
fn vwlinee p ulong n ulong to ulong
if ge p n
ret n
end
ret sub vwlend p n 1
end
note vwgib: kB as GiB with one decimal
fn vwgib kb ulong to void
t = div add mul kb 10 524288 1048576
vwhd div t 10
vwhc 46
vwhd rem t 10
end
fn vwmemv p ulong n ulong t view uchar * to ulong
q = p
for it ulong 8
if ge q n
ret 0
end
e = vwlinee q n
if vwgis q add q len t t
s = vwgsp add q len t e
v = ulong 0
for i ulong sub e s
c = get gob add s i
if not vwdig c
break
end
v = add mul v 10 ulong sub c 48
end
ret v
end
q = add e 1
end
ret 0
end

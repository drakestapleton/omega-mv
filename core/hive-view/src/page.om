continue
end
s = vwlstart b0 e
vwht tvfull
vwheo s sub e s
vwht tdivc
c = add c 1
e = s
end
end
note GET /p/machine
fn vwpmach cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
r = vwhtml cs io
vwdoc 10 35
ok = vwrdix
vwmach2
vwgpu2
r = hfe r vwflush cs io buf
vwwin2
vwpool2
r = hfe r vwflush cs io buf
vwledg2
vwht tdocend
ret hfe r vwfin cs io buf
end
note ---- BOARD: newest first, filtered by lane and by text (case-insensitive)
global glq uchar 64
global glql ulong 1
global gqq uchar 256
global gqql ulong 1
global gbp ulong 4
fn vwlower c uchar to uchar
if and ge c 65 le c 90
ret uchar add c 32
end
ret c
end
note vwbparse: "TIMESTAMP LANE rest" in gob[s, e): gbp 0 ts end, 1 lane start, 2 lane end, 3 rest
fn vwbparse s ulong e ulong to bool
t = vwgtok s e
if lt sub t s 11
ret false
end
for i ulong 4
if not vwdig get gob add s i
ret false
end
end
if or ne get gob add s 4 45 ne get gob add s 10 84
ret false
end
l0 = vwgsp t e
l1 = vwgtok l0 e
if eq l0 l1
ret false
end
put gbp 0 t
put gbp 1 l0
x = l1
if eq get gob sub x 1 58
x = sub x 1
end
put gbp 2 x
r = l1
if lt r e
r = add r 1
end
put gbp 3 r
ret true
end
fn vwblane to bool
n = get glql 0
if eq n 0
ret true
end
p = get gbp 1
if ne sub get gbp 2 p n
ret false
end
for i ulong n
if ne get gob add p i get glq i
ret false
end
end
ret true
end
fn vwbtext s ulong e ulong to bool
n = get gqql 0
if eq n 0
ret true
end
if lt sub e s n
ret false
end
for i ulong add sub sub e s n 1
ok = true
for k ulong n
if ne vwlower get gob add add s i k get gqq k
ok = false
break
end
end
if ok
ret true
end
end
ret false
end
fn vwbli s ulong e ulong to void
if vwbparse s e
vwht tli1
vwheo s sub get gbp 0 s
vwht tli2
p = get gbp 1
vwheo p sub get gbp 2 p
vwht tli3
p = get gbp 3
vwheo p sub e p
else
vwht tli
vwheo s sub e s
end
vwht tlie
end
fn vwbshow s ulong e ulong to bool
if gt get glql 0 0
if not vwbparse s e
ret false
end
if not vwblane
ret false
end
end
ret vwbtext s e
end
fn vwpct c uchar to void
if or vwdig c or and ge c 65 le c 90 and ge c 97 le c 122
vwhc c
ret
end
vwhc 37
vwhc hhexd shr ulong c 4
vwhc hhexd and ulong c 15
end
fn vwbdoc to void
vwht tdoc1q
for i ulong get glql 0
vwpct get glq i
end
vwht tampq
for i ulong get gqql 0
vwpct get gqq i
end
vwht tdoc2
vwhd 35
vwht tdoc3
end
fn vwbq cs edit ulong 320 io edit uchar 131072 to void
put glql 0 0
put gqql 0 0
if vwqget cs io tqlane
n = hmin get gql 0 64
for i ulong n
put glq i get gq i
end
put glql 0 n
end
if vwqget cs io tqq
n = hmin get gql 0 256
for i ulong n
put gqq i vwlower get gq i
end
put gqql 0 n
end
end
note GET /p/board?lane=LANE&q=TEXT
fn vwpboard cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
vwbq cs io
r = vwhtml cs io
vwbdoc
ok = vwrdix
a = vwsecrd tnboard
vwh3 tnboard a 45000
b0 = get goa 0
e = get gol 0
vwht tolb
c = ulong 0
for it ulong 100000
if or le e b0 ge c 300
break
end
if eq get gob sub e 1 10
e = sub e 1
continue
end
s = vwlstart b0 e
if vwbshow s e
vwbli s e
c = add c 1
if eq rem c 40 0
r = hfe r vwflush cs io buf
end
end
e = s
end
vwht tole
if eq c 0
vwht tmuted
vwht tnomatch
vwht tdivc
end
vwht tdocend
ret hfe r vwfin cs io buf
end
note vwlanes: the distinct BOARD lanes (sorted) for the filter's list; from gob (board section)
fn vwlanes to void
put glann 0 0
b0 = get goa 0
n = get gol 0
p = b0
for it ulong 100000
if ge p n
break
end
e = vwlinee p n
if vwbparse p e
vwlanead get gbp 1 get gbp 2
end
p = add e 1
end
end
fn vwlanead p ulong q ulong to void
l = sub q p
if or eq l 0 gt l 47
ret
end
n = get glann 0
ix = n
for i ulong n
c = vwlancmp i p l
if eq c 0
ret
end
if eq c 1
ix = i
break
end
end
if ge n 64
ret
end
k = n
for it ulong 64
if le k ix
break
end
vwlanmv sub k 1 k
k = sub k 1
end
for i ulong l
put glan add mul ix 48 i get gob add p i
end
put glanl ix l
put glann 0 add n 1
end
fn vwlanmv s ulong d ulong to void
for i ulong 48
put glan add mul d 48 i get glan add mul s 48 i
end
put glanl d get glanl s
end
note vwlancmp: 0 equal, 1 gob[p, p+l) sorts before lane i, 2 after
fn vwlancmp i ulong p ulong l ulong to ulong
m = get glanl i
for k ulong hmin l m
a = get gob add p k
b = get glan add mul i 48 k
if lt a b
ret 1
end
if gt a b
ret 2
end
end
if eq l m
ret 0
end
if lt l m
ret 1
end
ret 2
end
text topt1 "<option value=\""
text topt2 "</option>"
fn vwlanopt to void
for i ulong get glann 0
vwht topt1
vwlanname i
vwht tqgt
vwlanname i
vwht topt2
end
end
fn vwlanname i ulong to void
b = mul i 48
for k ulong get glanl i
vwhe get glan add b k
end
end
note ---- QUESTIONS / DECISIONS (latest 6 "## " entries, newest first) and CLAIMS (whole file)
fn vwisent p ulong n ulong to bool
if gt add p 3 n
ret false
end
if ne get gob p 35
ret false
end
if ne get gob add p 1 35
ret false
end
ret eq get gob add p 2 32
end
fn vwent1 s ulong x ulong to void
e = vwlinee s x
vwht tent1
vwheo add s 3 sub e add s 3
vwht tent2
b = vwgsp2 add e 1 x
t = x
for it ulong 100000
if le t b
break
end
c = get gob sub t 1
if and and ne c 10 ne c 32 ne c 13
break
end
t = sub t 1
end
if lt b t
if gt sub t b 16384
vwheo b 16384
vwht ttrunc
else
vwheo b sub t b
end
end
vwht tent3
end
fn vwgsp2 p ulong x ulong to ulong
q = p
for it ulong 100000
if ge q x
ret x
end
c = get gob q
if and and ne c 10 ne c 32 ne c 13
ret q
end
q = add q 1
end
ret q
end
fn vwents cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
st = new ulong 1024 0
b0 = get goa 0
n = get gol 0
k = ulong 0
p = b0
for it ulong 100000
if ge p n
break
end
if and vwisent p n lt k 1024
put st k p
k = add k 1
end
p = add vwlinee p n 1
end
r = long 0
if eq k 0
vwht tpreo
if gt n b0
s = sub n hmin sub n b0 4000
vwheo s sub n s
end
vwht tpreend
ret r
end
for i ulong hmin k 6
j = sub sub k 1 i
x = n
if lt add j 1 k
x = get st add j 1
end
vwent1 get st j x
r = hfe r vwflush cs io buf
end
ret r
end
note GET /p/entries?f=questions|decisions|claims
fn vwpents cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
w = ulong 0
if vwqget cs io tqf
if vwqis tqfile
w = 1
end
if vwqis tdfile
w = 2
end
if vwqis tcfile
w = 3
end
end
r = vwhtml cs io
vwdoc 10 35
ok = vwrdix
if eq w 0
vwht tmuted
vwht tnosessn
vwht tdivc
end
if eq w 1
a = vwsecrd tnques
vwh3 tnques a 45000
r = hfe r vwents cs io buf
end
if eq w 2
a = vwsecrd tndec
vwh3 tndec a 45000
r = hfe r vwents cs io buf
end
if eq w 3
a = vwsecrd tnclaim
vwh3 tnclaim a 45000
vwht tpreo
b0 = get goa 0
vwheo b0 sub get gol 0 b0
vwht tpreend
end
vwht tdocend
ret hfe r vwfin cs io buf
end
note ---- GET /palette.css: the xterm-256 colours as classes .fN (text) and .bN (background)
fn vwhex2 v ulong to void
vwhc hhexd shr v 4
vwhc hhexd and v 15
end
fn vwcol n ulong to void
if lt n 16
for i ulong 6
vwhc get tbase16 add mul n 6 i
end
ret
end
if lt n 232
m = sub n 16
vwcubeh div m 36
vwcubeh rem div m 6 6
vwcubeh rem m 6
ret
end
g = add 8 mul 10 sub n 232
vwhex2 g
vwhex2 g
vwhex2 g
end
fn vwcubeh k ulong to void
vwhc get tcube mul k 2
vwhc get tcube add mul k 2 1
end
fn vwpal cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
put ghl 0 0
for n ulong 256
vwht tpalc1
vwhd n
vwht tpalc2
vwcol n
vwht tpalc3
vwhd n
vwht tpalc4
vwcol n
vwht tpalc5
end
m = get ghl 0
for i ulong m
put buf i get gh i
end
put ghl 0 0
r = hrspst cs io 200
r = hfe r vwsech cs io
r = hfe r hhname cs io tctype
r = hfe r hhval cs io ttcss
r = hfe r hhend cs io 0 m
r = hfe r hput cs io view part buf 0 m
ret hfe r hwfin cs io
end
note ---- the pages Drake opens: / (every hive) and /s/NAME (one session with its input box)
text ttitle "hive-view"
text ttop1 "<header class=\"top\"><h1>hive-view</h1><iframe class=\"fstatus\" src=\"/p/status\" title=\"feed status\"></iframe></header>\n<p class=\"note\">Every panel refreshes itself: session screens every 2 to 3 seconds, everything else every 10 seconds. A panel that stops refreshing says NOT LIVE. If panels show a browser error page, the server is down: reload this page when it is back.</p>\n"
text ttop2 "<section class=\"panel queen\"><h2>Queen · omp-queen <a href=\"/s/omp-queen\">open on its own page</a></h2><iframe class=\"fqueen\" src=\"/p/pane?n=omp-queen\" title=\"omp-queen\"></iframe>\n"
text ttop3 "</section>\n<section class=\"panel\"><h2>omp sessions <span class=\"muted\">click a tile to open that session with its own input box</span></h2><iframe class=\"ftiles\" src=\"/p/tiles?g=omp\" title=\"omp sessions\"></iframe></section>\n<div class=\"cols\"><section class=\"panel\"><h2>Hermes</h2><iframe class=\"fhermes\" src=\"/p/hermes\" title=\"Hermes\"></iframe><h2>lead sessions</h2><iframe class=\"fleads\" src=\"/p/tiles?g=lead\" title=\"lead sessions\"></iframe></section>\n<section class=\"panel\"><h2>Machine</h2><iframe class=\"fmach\" src=\"/p/machine\" title=\"machine\"></iframe></section></div>\n"
text ttop4 "<section class=\"panel\"><h2>BOARD <span class=\"muted\">newest first</span></h2><form class=\"filter\" method=\"get\" action=\"/p/board\" target=\"board\"><select name=\"lane\"><option value=\"\">all lanes</option>"
text ttop5 "</select><input name=\"q\" placeholder=\"text filter\" autocomplete=\"off\"><button>Filter</button></form><iframe name=\"board\" class=\"fboard\" src=\"/p/board\" title=\"BOARD\"></iframe></section>\n<div class=\"cols\"><section class=\"panel\"><h2>Latest QUESTIONS</h2><iframe class=\"fent\" src=\"/p/entries?f=questions\" title=\"questions\"></iframe></section>\n<section class=\"panel\"><h2>Latest DECISIONS</h2><iframe class=\"fent\" src=\"/p/entries?f=decisions\" title=\"decisions\"></iframe></section></div>\n<section class=\"panel\"><h2>CLAIMS</h2><iframe class=\"fent\" src=\"/p/entries?f=claims\" title=\"claims\"></iframe></section>\n<section class=\"panel\"><h2>Other tmux sessions</h2><iframe class=\"ftiles\" src=\"/p/tiles?g=other\" title=\"other sessions\"></iframe></section>\n</body></html>\n"
text tses1 "<header class=\"top\"><a class=\"back\" href=\"/\">← all hives</a><h1>"
text tses2 "</h1><iframe class=\"fstatus\" src=\"/p/status\" title=\"feed status\"></iframe></header>\n"
text tses3 "<section class=\"panel\"><iframe class=\"fbig\" src=\"/p/pane?n="
text tses4 "\" title=\"session screen\"></iframe>\n"
text tses5 "</section>\n</body></html>\n"
text tfrm1 "<form class=\"send\" method=\"post\" action=\"/send\"><input type=\"hidden\" name=\"s\" value=\""
text tfrm2 "\"><input type=\"hidden\" name=\"k\" value=\""
text tfrm3 "\"><input type=\"hidden\" name=\"r\" value=\""
text tfrm4 "\"><div class=\"target\">Types into tmux session “"
text tfrm5 "” exactly as written, then presses Enter.</div><div class=\"row\"><input class=\"text\" name=\"t\" maxlength=\"4096\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"type here, then Send\"><button name=\"a\" value=\"line\">Send + Enter</button><button name=\"a\" value=\"enter\">Enter</button><button name=\"a\" value=\"escape\">Escape</button></div></form>\n"
text tsignout "<header class=\"top\"><h1>hive-view</h1></header><div class=\"msg bad\">Not signed in on this device. Open the one-time link (it contains the access token) once on this device, then this page works.</div></body></html>\n"
text tmsgok "<div class=\"msg ok\">"
text tmsgbad "<div class=\"msg bad\">"
text tsentn "Sent "
text tsentb " bytes to "
text tsente ", then pressed Enter."
text tpressen "Pressed Enter in "
text tpresesc "Pressed Escape in "
text tdotend "."
text tqr "q"
text tsr "s"
text tcsrfp "hive-view form key\n"
fn vwcsrfk to void
if eq get gcsrfk 0 1
ret
end
src = new uchar 96 0
pre = ulong 0
for i ulong len tcsrfp
put src i get tcsrfp i
pre = add pre 1
end
for i ulong 64
put src add pre i get gtok i
end
dg = new uchar 32 0
k = sha2_digest 256 view part src 0 add pre 64 dg
for i ulong 32
c = get dg i
put gcsrf mul i 2 get thexd shr c 4
put gcsrf add mul i 2 1 get thexd and c 15
end
put gcsrfk 0 1
end
fn vwform r view uchar * to void
vwcsrfk
vwht tfrm1
vwheq
vwht tfrm2
for i ulong 64
vwhc get gcsrf i
end
vwht tfrm3
vwht r
vwht tfrm4
vwheq
vwht tfrm5
end
note vwmsg: the result of the last send, from ?m=CODE&a=ACTION&b=BYTES&s=NAME (all checked)
fn vwmsg cs edit ulong 320 io edit uchar 131072 to void
if not vwqget cs io tqm
ret
end
m = vwqnum
if gt get gql 0 2
ret
end
if eq get gql 0 0
ret
end
act = ulong 0
if vwqget cs io tqa
act = vwqnum
end
nb = ulong 0
if vwqget cs io tqb
nb = vwqnum
end
if not vwqget cs io tqs
put gql 0 0
end
if not vwqname
put gql 0 0
end
if eq m 0
vwht tmsgok
vwmsgok act nb
else
vwht tmsgbad
vwmsgbad m
end
vwht tdivc
end
fn vwmsgok act ulong nb ulong to void
if eq act 0
vwht tsentn
vwhd nb
vwht tsentb
vwheq
vwht tsente
ret
end
if eq act 1
vwht tpressen
else
vwht tpresesc
end
vwheq
vwht tdotend
end
fn vwmsgbad m ulong to void
if eq m 1
vwhet tbadbody
end
if eq m 2
vwhet tbadname
end
if eq m 3
vwhet tbadact
end
if eq m 4
vwhet tbadtext
end
if eq m 5
vwhet tnosess
end
if eq m 6
vwhet ttmuxbad
end
if eq m 7
vwhet tbigbody
end
if eq m 8
vwhet tlogbad
end
if gt m 8
vwhet tbadbody
end
end
note GET / (signed in): every hive on one page
fn vwptop cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
r = vwhtml cs io
vwpage ttitle
vwht ttop1
vwmsg cs io
vwht ttop2
n = len tompq
for i ulong n
put gq i get tompq i
end
put gql 0 n
vwform tqr
vwht ttop3
vwht ttop4
ok = vwrdix
a = vwsecrd tnboard
vwlanes
vwlanopt
vwht ttop5
ret hfe r vwfin cs io buf
end
fn vwpsignout cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
put ghl 0 0
r = hrspst cs io 403
r = hfe r vwsech cs io
r = hfe r hhname cs io tctype
r = hfe r hhval cs io tthtml
r = hfe r hhend cs io 1 0
vwpage ttitle
vwht tsignout
ret hfe r vwfin cs io buf
end
note GET /s/NAME: one session, large, with its own input box. gq holds the checked NAME.
fn vwpsess cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
keep = new uchar 64 0
n = get gql 0
for i ulong n
put keep i get gq i
end
r = vwhtml cs io
vwht tpage1
vwheq
vwht tpage2
vwht tses1
vwheq
vwht tses2
vwmsg cs io
for i ulong n
put gq i get keep i
end
put gql 0 n
vwht tses3
vwheq
vwht tses4
vwform tsr
vwht tses5
ret hfe r vwfin cs io buf
end
note vwsname: the path is /s/NAME with a valid NAME; it is left in gq
fn vwsname cs edit ulong 320 io edit uchar 131072 to bool
tg = get cs HTOFF
pl = hplen cs io
if lt pl 4
ret false
end
if ne get io tg 47
ret false
end
if ne get io add tg 1 115
ret false
end
if ne get io add tg 2 47
ret false
end
n = sub pl 3
if gt n 63
ret false
end
for i ulong n
put gq i get io add add tg 3 i
end
put gql 0 n
ret vwqname
end

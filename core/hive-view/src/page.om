fn vwsensag p ulong e ulong to void
ep = ulong 0
for i ulong sub vwcsve p e 0 p
c = get gob add p i
if not vwdig c
break
end
ep = add mul ep 10 ulong sub c 48
end
ms = mul ep 1000
ag = ulong 0
if gt get gnow 0 ms
ag = sub get gnow 0 ms
end
bad = gt ag 15000
vwkvo tsampk bad
vwht tsamp
vwhagt ag
if bad
vwht tastale
end
vwkve
end
fn vwcsvf a ulong e ulong k ulong to ulong
if eq k 0
ret a
end
c = ulong 0
for i ulong sub e a
if eq get gob add a i 44
c = add c 1
if eq c k
ret add add a i 1
end
end
end
ret e
end
fn vwcsve a ulong e ulong k ulong to ulong
q = vwcsvf a e add k 1
if lt q e
ret sub q 1
end
ret e
end

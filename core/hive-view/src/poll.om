note hive-view src/poll.om: the one shared poller. Every 2 s it lists tmux sessions and captures
note each pane once; every 10 s it reads the shared files, GPU, window, pool locks and machine
note state; every 30 s the Hermes kanban list. It only reads hive state: the single write it makes
note is its own snapshot files under the run directory (<run>/s<slot>, <run>/index).
note Slots 0..47 are tmux sessions, 48..63 fixed sections. Each snapshot file is
note "NAME<TAB>KIND<TAB>GEN<LF>" followed by the body; GEN is unique per content change.
global gsnam uchar 4096
global gsnl ulong 64
global gsgen ulong 64
global gshash ulong 64
global gstms ulong 64
note gscs: when a pane was last captured (unix s); gslh: hash of its tmux list line then
global gscs ulong 48
global gslh ulong 48
global gkbsig ulong 1
global gkbrun ulong 1
note gcq: pane captures queued this tick, 4 words each (slot, list line start, name length, line end)
global gcq ulong 192
global gcqn ulong 1
global gnonce uchar 16
global gsst ulong 64
global gskind ulong 64
global gslive ulong 64
global ggen ulong 1
global glsb uchar 32768
global glsl ulong 1
global gtmux ulong 1
global gfdent uchar 16384
global gsnm uchar 16
global gsnml ulong 1
global gnvn ulong 1
global gwid uchar 64
global gwidl ulong 1
global gdent uchar 16384
global glk uchar 65536
global glkw ulong 1
global glkp ulong 1
global glkl ulong 1
global gpln uchar 1024
global gplnl ulong 16
global gplino ulong 16
global gpln_n ulong 1
text ttmux "/usr/bin/tmux"
text tlsess "list-sessions"
text tdashf "-F"
note tmux replaces a tab in -F output with '_' for this client, so fields are split by '|'
note (refused in the session names we accept)
note #{window_activity} moves whenever the window's panes print output (tested on tmux 3.4)
text tlsfmt "#{session_name}|#{pane_current_command}|#{session_attached}|#{window_activity}|#{window_width}x#{window_height}"
text tcapt "capture-pane"
text tdmsg "display-message"
text tsemi ";"
text tmarkp "@@hv-"
text tdashe "-e"
text tdashp "-p"
text tdasht "-t"
text tompq "omp-queen"
text tomp "omp"
text tleadp "lead-"
text tksec "sec"
text tkqueen "queen"
text tkomp "omp"
text tklead "lead"
text tkother "other"
text tnkan "kanban"
text tnherm "hermes"
text tnboard "board"
text tnques "questions"
text tndec "decisions"
text tnclaim "claims"
text tngpu "gpu"
text tnwin "window"
text tnpool "pools"
text tnmach "machine"
text tnledg "ledger"
text thermes "/.local/bin/hermes"
text tkdb "/.hermes/kanban/boards/aien-hive/kanban.db"
text tkwal "/.hermes/kanban/boards/aien-hive/kanban.db-wal"
text tkanban "kanban"
text tdboard "--board"
text taienh "aien-hive"
text tlist "list"
text tcg1 "/sys/fs/cgroup/user.slice/user-"
text tcg2 ".slice/user@"
text tcg3 ".service/app.slice/hermes-gateway.service/cgroup.events"
text tpopul "populated 1"
text tgwup "gateway\tup\n"
text tgwdown "gateway\tdown\n"
text tpause "/handoffs/hive/queen/PAUSE"
text tpyes "pause\tyes\t"
text tpno "pause\tno\n"
text tpboard "/handoffs/BOARD.md"
text tpques "/handoffs/hive/queen/QUESTIONS.md"
text tpdec "/handoffs/hive/queen/DECISIONS.md"
text tpclaim "/handoffs/hive/CLAIMS.md"
text tpledg "/work/pearl/economics/ledger.jsonl"
text tabsent "absent\n"
text tploadav "/proc/loadavg"
text tpmem "/proc/meminfo"
text tpstat "/proc/stat"
text thload "#load\n"
text thmem "#mem\n"
text thstat "#cpu\n"
note GPU: hive-view sends the GB10 no queries of its own (BOARD 2026-11-07T07:12:00Z: no GPU-bound
note queries outside an authorized spark-window). Power and utilization come from the newest row of
note the existing spark-sensors log; GPU users are the processes holding /dev/nvidia* open.
text tsensd "/yardsticks/sensors"
text thsens "#sensors\n"
text thapps "#apps\n"
text tdevnv "/dev/nvidia"
text tfdsl "/fd/"
text tfd "/fd"
text tproc0 "/proc"
text twin "/yardsticks/windows/"
text twopen "OPEN"
text twqueue "QUEUE"
text twnone "open\tnone\n"
text twopenl "open\t"
text twk0 "name"
text twk1 "owner"
text twk2 "gb10"
text twk3 "quiet"
text twk4 "held"
text twk5 "requested"
text twk6 "lease"
text twk7 "holder.pid"
text tqline "queue\t"
text talive "alive\t"
text tyes "yes"
text tno "no"
text tproc "/proc/"
text tcmdl "/cmdline"
text tqueen "/handoffs/hive/queen"
text tpoolp "pool-"
text tlockx ".lock"
text tplocks "/proc/locks"
text tpooll "pool\t"
text tholds "holds"
text twaits "waits"
text tfree "free"
text tindex "/index"
text thdrp "P\t"
note ---- slots
fn vwkindt k ulong to void
if eq k 1
vwsbt tkqueen
ret
end
if eq k 2
vwsbt tkomp
ret
end
if eq k 3
vwsbt tklead
ret
end
if eq k 4
vwsbt tkother
ret
end
vwsbt tksec
end
fn vwsetnm slot ulong t view uchar * to void
b = mul slot 64
n = hmin len t 63
for i ulong n
put gsnam add b i get t i
end
put gsnl slot n
put gskind slot 0
end
fn vwinitsec to void
rb = new uchar 8 0
r = random rb 0 8 0
for i ulong 8
put gnonce mul i 2 get thexd shr get rb i 4
put gnonce add mul i 2 1 get thexd and get rb i 15
end
vwsetnm 48 tnkan
vwsetnm 49 tnherm
vwsetnm 50 tnboard
vwsetnm 51 tnques
vwsetnm 52 tndec
vwsetnm 53 tnclaim
vwsetnm 54 tngpu
vwsetnm 55 tnwin
vwsetnm 56 tnpool
vwsetnm 57 tnmach
vwsetnm 58 tnledg
end
fn vwfnv a ulong n ulong to ulong
h = ulong 14695981039346656037
for i ulong n
h = xor h ulong get gsb add a i
h = mul h 1099511628211
end
ret h
end
note vwhdr: "NAME<TAB>KIND<TAB>GEN<LF>" into ghd (built with gsb as scratch after the body)
fn vwhdr slot ulong g ulong to void
keep = get gsl 0
b = mul slot 64
for i ulong get gsnl slot
vwsbc get gsnam add b i
end
vwsbc 9
vwkindt get gskind slot
vwsbc 9
vwsbd g
vwsbc 10
n = sub get gsl 0 keep
m = hmin n 255
for i ulong m
put ghd i get gsb add keep i
end
put ghdl 0 m
put gsl 0 keep
end
note vwcommit: publish gsb[0, gsl) for slot when it changed; st != 0 marks the slot stale (old
note snapshot and its time are kept, so the page shows its real age)
fn vwcommit slot ulong st ulong to void
if ne st 0
put gsst slot st
ret
end
h = vwfnv 0 get gsl 0
h = mul xor h add get gskind slot 1 1099511628211
if or eq get gsgen slot 0 ne h get gshash slot
g = add get ggen 0 1
put ggen 0 g
vwhdr slot g
if not vwwsec slot
put gsst slot 5
ret
end
put gsgen slot g
put gshash slot h
end
put gstms slot vwnowms
put gsst slot 0
end
note ---- tmux sessions and panes
fn vwnmeq slot ulong a ulong n ulong to bool
b = mul slot 64
for i ulong n
if ne get gsnam add b i get glsb add a i
ret false
end
end
ret true
end
fn vwslot a ulong n ulong to ulong
for s ulong 48
if eq get gsnl s n
if vwnmeq s a n
ret s
end
end
end
for s ulong 48
if eq get gsnl s 0
b = mul s 64
for i ulong n
put gsnam add b i get glsb add a i
end
put gsnl s n
put gsgen s 0
put gshash s 0
put gstms s 0
put gscs s 0
put gslh s 0
put gsst s 0
ret s
end
end
ret 64
end
fn vwlbeq a ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n
if ne get glsb add a i get t i
ret false
end
end
ret true
end
fn vwkindof a ulong n ulong c ulong m ulong to ulong
if vwlbeq a n tompq
ret 1
end
if vwlbeq c m tomp
ret 2
end
if gt n len tleadp
if vwlbeq a len tleadp tleadp
ret 3
end
end
ret 4
end
note ---- pane captures, batched: one tmux client per batch of up to 6 panes instead of one per
note pane (a tmux client start costs ~5 ms of CPU, measured). Each capture is preceded by a
note display-message printing "@@hv-<nonce>-<slot>@@"; the nonce is random per poller, so pane
note text cannot fake a boundary. tmux stops a command sequence at the first failing command,
note so after a nonzero exit the last started segment is discarded, never shown as empty.
fn vwcapq slot ulong a ulong n ulong e ulong to void
k = get gcqn 0
if ge k 48
ret
end
b = mul k 4
put gcq b slot
put gcq add b 1 a
put gcq add b 2 n
put gcq add b 3 e
put gcqn 0 add k 1
end
fn vwcapall to void
k = ulong 0
for it ulong 48
if ge k get gcqn 0
ret
end
m = hmin 6 sub get gcqn 0 k
vwcapb k m
k = add k m
end
end
fn vwmark slot ulong to void
vwkopen
vwkc 64
vwkc 64
vwkc 104
vwkc 118
vwkc 45
for i ulong 16
vwkc get gnonce i
end
vwkc 45
vwkd slot
vwkc 64
vwkc 64
end
fn vwkd v ulong to void
if ge v 10
vwkd div v 10
end
vwkc uchar add rem v 10 48
end
fn vwcapb k ulong m ulong to void
vwkb
vwka ttmux
for j ulong m
if gt j 0
vwka tsemi
end
vwcapent mul add k j 4
end
r = vwrun 5000000000
vwsegs k m eq r 0
end
fn vwcapent b ulong to void
vwka tdmsg
vwka tdashp
vwmark get gcq b
vwka tsemi
vwka tcapt
vwka tdashe
vwka tdashp
vwka tdasht
vwkopen
vwkc 61
a = get gcq add b 1
for i ulong get gcq add b 2
vwkc get glsb add a i
end
vwkc 58
end
note vwsegs: split gob[goa, gol) at marker lines and commit each complete segment to its slot
fn vwsegs k ulong m ulong ok bool to void
a = get goa 0
e = get gol 0
cur = ulong 64
cs = ulong 0
p = a
for it ulong 1000000
if ge p e
break
end
q = vwlend p e
s = vwmarkat p q
if lt s 64
if lt cur 64
vwseg1 k m cur cs p
end
cur = s
cs = q
end
p = q
end
if and ok lt cur 64
vwseg1 k m cur cs e
end
end
note vwlend: the index just past the LF ending the line at p (or e)
fn vwlend p ulong e ulong to ulong
for i ulong sub e p
if eq get gob add p i 10
ret add add p i 1
end
end
ret e
end
note vwmarkat: the slot named by a marker line gob[p, q), else 64
fn vwmarkat p ulong q ulong to ulong
if lt sub q p 25
ret 64
end
if ne get gob sub q 1 10
ret 64
end
for i ulong 5
if ne get gob add p i get tmarkp i
ret 64
end
end
for i ulong 16
if ne get gob add add p 5 i get gnonce i
ret 64
end
end
if ne get gob add p 21 45
ret 64
end
v = ulong 0
d = ulong 0
for i ulong sub sub q p 25
c = get gob add add p 22 i
if not vwdig c
ret 64
end
v = add mul v 10 ulong sub c 48
d = add d 1
end
if or eq d 0 gt d 2
ret 64
end
if ne get gob sub q 3 64
ret 64
end
if ne get gob sub q 2 64
ret 64
end
if ge v 48
ret 64
end
ret v
end
note vwseg1: commit capture gob[s, x) to slot when that slot is in batch [k, k+m)
fn vwseg1 k ulong m ulong slot ulong s ulong x ulong to void
for j ulong m
b = mul add k j 4
if eq get gcq b slot
vwsegc b s x
ret
end
end
end
fn vwsegc b ulong s ulong x ulong to void
slot = get gcq b
la = get gcq add b 1
lz = get gcq add b 3
put gsl 0 0
for i ulong sub lz la
vwsbc get glsb add la i
end
vwsbc 10
vwsbo s sub x s
vwcommit slot 0
put gscs slot div vwnowms 1000
put gslh slot vwlhash la lz
end
fn vwtabat a ulong e ulong to ulong
for i ulong sub e a
if eq get glsb add a i 124
ret add a i
end
end
ret e
end
fn vwnameok a ulong n ulong to bool
if or eq n 0 gt n 63
ret false
end
for i ulong n
if not vwnamec get glsb add a i
ret false
end
end
ret true
end
fn vwline a ulong e ulong to void
t1 = vwtabat a e
n = sub t1 a
if not vwnameok a n
ret
end
if ge t1 e
ret
end
t2 = vwtabat add t1 1 e
slot = vwslot a n
if ge slot 48
ret
end
put gslive slot 1
put gskind slot vwkindof a n add t1 1 sub t2 add t1 1
h = vwlhash a e
if vwfresh slot h vwactof a e
put gstms slot vwnowms
ret
end
vwcapq slot a n e
end
note vwfresh: the last capture is still exact, so tmux need not be asked again: it succeeded,
note the list line (command, clients, size, activity) is unchanged, the window's last output
note is older than the second before that capture, and the capture is under 20 s old
fn vwfresh slot ulong h ulong act ulong to bool
cs = get gscs slot
if or eq get gsgen slot 0 ne get gsst slot 0
ret false
end
if or ne h get gslh slot eq cs 0
ret false
end
if ge add act 1 cs
ret false
end
ret lt div vwnowms 1000 add cs 20
end
fn vwlhash a ulong e ulong to ulong
h = ulong 14695981039346656037
for i ulong sub e a
h = mul xor h ulong get glsb add a i 1099511628211
end
ret h
end
note vwactof: the 4th '|' field of the list line glsb[a, e) as a number (0 when malformed)
fn vwactof a ulong e ulong to ulong
p = a
for k ulong 3
p = add vwtabat p e 1
end
v = ulong 0
for i ulong 20
if ge add p i e
ret v
end
c = get glsb add p i
if not vwdig c
ret v
end
v = add mul v 10 ulong sub c 48
end
ret v
end
fn vwpanes to void
vwkb
vwka ttmux
vwka tlsess
vwka tdashf
vwka tlsfmt
r = vwrun 3000000000
if ne r 0
put gtmux 0 ulong add r 10
for s ulong 48
if eq get gslive s 1
put gsst s 2
end
end
ret
end
put gtmux 0 0
n = hmin get gol 0 len glsb
for i ulong n
put glsb i get gob i
end
put glsl 0 n
for s ulong 48
put gslive s 0
end
put gcqn 0 0
a = ulong 0
for i ulong n
if eq get glsb i 10
vwline a i
a = add i 1
end
end
vwcapall
for s ulong 48
if eq get gslive s 0
put gsnl s 0
put gsgen s 0
put gshash s 0
end
end
end
note ---- file sections
fn vwfsec slot ulong tail bool cap ulong to void
put gsl 0 0
r = long 0
if tail
r = vwrdtail cap
else
r = vwrdall cap
end
if lt r 0
vwcommit slot ulong neg r
ret
end
vwsbol
vwcommit slot 0
end
fn vwhpath t view uchar * to void
vwpb
vwph
vwpt t
end
fn vwfind t view uchar * to bool
a = get goa 0
b = get gol 0
m = len t
if gt m sub b a
ret false
end
for i ulong add sub sub b a m 1
if vwmatch add a i t
ret true
end
end
ret false
end
fn vwmatch p ulong t view uchar * to bool
for j ulong len t
if ne get gob add p j get t j
ret false
end
end
ret true
end
note vwsbl1: append the first line of gob[goa, gol) (without its LF)
fn vwsbl1 to void
a = get goa 0
b = get gol 0
for i ulong sub b a
c = get gob add a i
if eq c 10
ret
end
vwsbc c
end
end
note vwsblines: append the first k lines of gob[goa, gol) (with their LF)
fn vwsblines k ulong to void
a = get goa 0
b = get gol 0
seen = ulong 0
for i ulong sub b a
c = get gob add a i
vwsbc c
if eq c 10
seen = add seen 1
if ge seen k
ret
end
end
end
end
fn vwhermes to void
put gsl 0 0
vwpb
vwpt tcg1
uid = ulong getuid
vwpd uid
vwpt tcg2
vwpd uid
vwpt tcg3
r = vwrdall 4096
if and ge r 0 vwfind tpopul
vwsbt tgwup
else
vwsbt tgwdown
end
vwhpath tpause
r = vwrdall 2048
if ge r 0
vwsbt tpyes
vwsbl1
vwsbc 10
else
vwsbt tpno
end
vwcommit 49 0
end
fn vwledger to void
vwhpath tpledg
put gsl 0 0
r = vwrdtail 16384
if eq r -2
vwsbt tabsent
vwcommit 58 0
ret
end
if lt r 0
vwcommit 58 ulong neg r
ret
end
vwsbol
vwcommit 58 0
end
fn vwmach to void
put gsl 0 0
vwsbt thload
vwpb
vwpt tploadav
r = vwrdall 256
if lt r 0
vwcommit 57 ulong neg r
ret
end
vwsbl1
vwsbc 10
vwsbt thmem
vwpb
vwpt tpmem
r = vwrdall 4096
vwsblines 3
vwsbt thstat
vwpb
vwpt tpstat
r = vwrdall 4096
vwcpupct
vwcommit 57 0
end
note vwcpupct: "#cpu" then the busy percentage of all cores since the previous sample (from the
note first /proc/stat line: idle = idle + iowait, total = the first 8 fields); "measuring" first
global gcpu ulong 2
text tmeasr "measuring\n"
fn vwcpupct to void
n = get gol 0
p = ulong 3
tot = ulong 0
idl = ulong 0
for k ulong 8
for s ulong 64
if or ge p n ne get gob p 32
break
end
p = add p 1
end
v = ulong 0
for s ulong 24
if ge p n
break
end
c = get gob p
if not vwdig c
break
end
v = add mul v 10 ulong sub c 48
p = add p 1
end
tot = add tot v
if or eq k 3 eq k 4
idl = add idl v
end
end
pt = get gcpu 0
pi = get gcpu 1
put gcpu 0 tot
put gcpu 1 idl
if or eq pt 0 le tot pt
vwsbt tmeasr
ret
end
dt = sub tot pt
di = sub idl pi
if gt di dt
di = dt
end
vwsbd div add mul sub dt di 100 div dt 2 dt
vwsbc 10
end
fn vwgpu to void
put gsl 0 0
vwsbt thsens
vwsensor
vwsbt thapps
put gnvn 0 0
vwpb
vwpt tproc0
fd = fopen gpth 0 get gpl 0 540672 0
if lt fd 0
vwcommit 54 ulong neg fd
ret
end
for it ulong 64
n = getdnts int fd gdent 0 len gdent
if le n 0
break
end
vwgpuls ulong n
end
x = fclose int fd
vwcommit 54 0
end
note vwgpuls: each numeric /proc entry in gdent[0, n) that holds a /dev/nvidia* descriptor
fn vwgpuls n ulong to void
p = ulong 0
for it ulong 4096
if ge add p 19 n
break
end
rl = or ulong get gdent add p 16 shl ulong get gdent add p 17 8
if eq rl 0
break
end
pid = vwdentn 0 add p 19 add p rl
if and gt pid 0 lt get gnvn 0 16
if vwnvpid pid
put gnvn 0 add get gnvn 0 1
vwsbd pid
vwsbc 9
vwcmdl pid
vwsbc 10
end
end
p = add p rl
end
end
note vwdentn: the all-digit entry name in gdent (f 0) or gfdent (f 1) [a, NUL or e) as a number, else 0
fn vwdentn f ulong a ulong e ulong to ulong
v = ulong 0
for i ulong sub e a
c = get gdent add a i
if eq f 1
c = get gfdent add a i
end
if eq c 0
ret v
end
if not vwdig c
ret 0
end
v = add mul v 10 ulong sub c 48
if gt v 4194304
ret 0
end
end
ret v
end
fn vwnvpid pid ulong to bool
vwpb
vwpt tproc
vwpd pid
vwpt tfd
fd = fopen gpth 0 get gpl 0 540672 0
if lt fd 0
ret false
end
hit = false
for it ulong 64
n = getdnts int fd gfdent 0 len gfdent
if le n 0
break
end
if vwnvfds pid ulong n
hit = true
break
end
end
x = fclose int fd
ret hit
end
fn vwnvfds pid ulong n ulong to bool
lb = new uchar 64 0
p = ulong 0
for it ulong 4096
if ge add p 19 n
break
end
rl = or ulong get gfdent add p 16 shl ulong get gfdent add p 17 8
if eq rl 0
break
end
if vwdig get gfdent add p 19
vwpb
vwpt tproc
vwpd pid
vwpt tfdsl
vwpd vwdentn 1 add p 19 add p rl
k = readlnk gpth 0 get gpl 0 lb 0 64
if ge k long len tdevnv
if heq view part lb 0 len tdevnv tdevnv
ret true
end
end
end
p = add p rl
end
ret false
end
note vwsensor: the last complete row of the newest ~/yardsticks/sensors/YYYY-MM-DD.csv
fn vwsensor to void
put gsnml 0 0
vwhpath tsensd
fd = fopen gpth 0 get gpl 0 540672 0
if lt fd 0
vwsbc 10
ret
end
for it ulong 64
n = getdnts int fd gdent 0 len gdent
if le n 0
break
end
vwsnpick ulong n
end
x = fclose int fd
if ne get gsnml 0 14
vwsbc 10
ret
end
vwhpath tsensd
vwpc 47
for i ulong 14
vwpc get gsnm i
end
r = vwrdtail 1024
if lt r 0
vwsbc 10
ret
end
vwsblast
end
fn vwsnpick n ulong to void
p = ulong 0
for it ulong 4096
if ge add p 19 n
break
end
rl = or ulong get gdent add p 16 shl ulong get gdent add p 17 8
if eq rl 0
break
end
if vwsnname add p 19 add p rl
if or ne get gsnml 0 14 vwsnnewer add p 19
for i ulong 14
put gsnm i get gdent add add p 19 i
end
put gsnml 0 14
end
end
p = add p rl
end
end
note vwsnname: gdent[a..] is "DDDD-DD-DD.csv" followed by NUL
fn vwsnname a ulong e ulong to bool
if lt sub e a 15
ret false
end
for i ulong 10
c = get gdent add a i
if or eq i 4 eq i 7
if ne c 45
ret false
end
else
if not vwdig c
ret false
end
end
end
if ne get gdent add a 10 46
ret false
end
ret eq get gdent add a 14 0
end
fn vwsnnewer a ulong to bool
for i ulong 10
c = get gdent add a i
d = get gsnm i
if gt c d
ret true
end
if lt c d
ret false
end
end
ret false
end
note vwsblast: append the last LF-terminated line of gob[goa, gol)
fn vwsblast to void
a = get goa 0
e = get gol 0
if le e a
vwsbc 10
ret
end
if ne get gob sub e 1 10
vwsbc 10
ret
end
s = a
for i ulong sub sub e a 1
if eq get gob add a i 10
s = add add a i 1
end
end
vwsbo s sub e s
end
note vwkanban: `hermes kanban list` costs about 0.6 s of CPU (measured), so it runs only when the
note board's SQLite files changed (mtime or size of kanban.db / kanban.db-wal; listing does not
note touch them, tested), and at least every 5 minutes; otherwise the last list is still current
fn vwkanban to void
sig = xor vwstsig tkdb mul vwstsig tkwal 31
if and eq sig get gkbsig 0 ne sig 0
if and eq get gsst 48 0 gt get gsgen 48 0
if lt sub vwnowms get gkbrun 0 300000
put gstms 48 vwnowms
ret
end
end
end
put gkbsig 0 sig
put gkbrun 0 vwnowms
vwkb
vwhpath thermes
vwkopen
for i ulong get gpl 0
vwkc get gpth i
end
vwka tkanban
vwka tdboard
vwka taienh
vwka tlist
r = vwrun 15000000000
put gsl 0 0
if ne r 0
vwcommit 48 ulong add 1000 add r 10
ret
end
vwsbol
vwcommit 48 0
end
note vwstsig: a hash of the mtime (s, ns) and size of ~/<t>; 0 when it cannot be read
fn vwstsig t view uchar * to ulong
vwhpath t
r = stat gpth 0 get gpl 0 gstb 0 128
if ne r 0
ret 0
end
h = mul xor vwst64 88 vwst64 96 1099511628211
ret add mul h 1099511628211 vwst64 48
end
note ---- spark-window state, read directly (no spark-window process: its status verb deletes
note dead queue tickets, which would be a write)
fn vwwinp to void
vwpb
vwph
vwpt twin
end
fn vwidok to bool
n = get gwidl 0
if or eq n 0 gt n 63
ret false
end
for i ulong n
c = get gwid i
if not or vwnamec c eq c 46
ret false
end
end
ret true
end
fn vwwkey t view uchar * to bool
vwwinp
for i ulong get gwidl 0
vwpc get gwid i
end
vwpc 47
vwpt t
vwsbt t
vwsbc 9
r = vwrdall 512
if ge r 0
vwsbl1
end
vwsbc 10
ret ge r 0
end
note vwalive: /proc/<pid> exists for the first decimal number in gob[goa, gol)
fn vwpidof to ulong
a = get goa 0
b = get gol 0
v = ulong 0
for i ulong sub b a
c = get gob add a i
if not vwdig c
break
end
v = add mul v 10 ulong sub c 48
if gt v 4194304
ret 0
end
end
ret v
end
fn vwpalive pid ulong to bool
if eq pid 0
ret false
end
vwpb
vwpt tproc
vwpd pid
r = stat gpth 0 get gpl 0 gstb 0 128
ret eq r 0
end
fn vwwindow to void
put gsl 0 0
vwwinp
vwpt twopen
r = vwrdall 128
put gwidl 0 0
if ge r 0
a = get goa 0
for i ulong sub get gol 0 a
c = get gob add a i
if or eq c 10 eq c 32
break
end
if lt i 63
put gwid i c
put gwidl 0 add i 1
end
end
end
if not vwidok
vwsbt twnone
else
vwsbt twopenl
for i ulong get gwidl 0
vwsbc get gwid i
end
vwsbc 10
ok = vwwkey twk0
ok = vwwkey twk1
ok = vwwkey twk2
ok = vwwkey twk3
ok = vwwkey twk4
ok = vwwkey twk5
ok = vwwkey twk6
ok = vwwkey twk7
vwsbt talive
if and ok vwpalive vwpidof
vwsbt tyes
else
vwsbt tno
end
vwsbc 10
end
vwqueue
vwcommit 55 0
end
fn vwqueue to void
vwwinp
vwpt twqueue
fd = fopen gpth 0 get gpl 0 540672 0
if lt fd 0
ret
end
n = getdnts int fd gdent 0 len gdent
x = fclose int fd
if le n 0
ret
end
p = ulong 0
for it ulong 4096
if ge add p 19 ulong n
break
end
rl = or ulong get gdent add p 16 shl ulong get gdent add p 17 8
if eq rl 0
break
end
vwqent add p 19 add p rl
p = add p rl
end
end
note vwqent: one ticket "<ns>-<pid>" (name bytes gdent[a, NUL)): its line and whether pid lives
fn vwqent a ulong e ulong to void
n = ulong 0
for i ulong sub e a
c = get gdent add a i
if eq c 0
break
end
if not or vwdig c eq c 45
ret
end
n = add n 1
end
if eq n 0
ret
end
vwsbt tqline
for i ulong n
vwsbc get gdent add a i
end
vwsbc 9
pid = ulong 0
for i ulong n
c = get gdent add a i
if eq c 45
pid = ulong 0
else
pid = add mul pid 10 ulong sub c 48
if gt pid 4194304
pid = ulong 0
end
end
end
if vwpalive pid
vwsbt tyes
else
vwsbt tno
end
vwsbc 9
vwwinp
vwpt twqueue
vwpc 47
for i ulong n
vwpc get gdent add a i
end
r = vwrdall 512
if ge r 0
vwsbl1
end
vwsbc 10
end
note ---- pool locks: holders from the kernel lock table (/proc/locks), never by taking the lock
fn vwpools to void
put gsl 0 0
put gpln_n 0 0
vwhpath tqueen
fd = fopen gpth 0 get gpl 0 540672 0
if lt fd 0
vwcommit 56 ulong neg fd
ret
end
n = getdnts int fd gdent 0 len gdent
x = fclose int fd
p = ulong 0
for it ulong 4096
if ge add p 19 ulong n
break
end
rl = or ulong get gdent add p 16 shl ulong get gdent add p 17 8
if eq rl 0
break
end
vwplent add p 19 add p rl
p = add p rl
end
vwpb
vwpt tplocks
r = vwrdall len glk
k = hmin sub get gol 0 get goa 0 len glk
for i ulong k
put glk i get gob i
end
put glkl 0 k
for j ulong get gpln_n 0
vwplone j
end
vwcommit 56 0
end
fn vwplent a ulong e ulong to void
n = ulong 0
for i ulong sub e a
if eq get gdent add a i 0
break
end
n = add n 1
end
m = len tpoolp
x = len tlockx
if or le n add m x gt n 63
ret
end
for i ulong m
if ne get gdent add a i get tpoolp i
ret
end
end
for i ulong x
if ne get gdent add a add sub n x i get tlockx i
ret
end
end
for i ulong n
c = get gdent add a i
if not or vwnamec c eq c 46
ret
end
end
j = get gpln_n 0
if ge j 16
ret
end
vwhpath tqueen
vwpc 47
for i ulong n
vwpc get gdent add a i
put gpln add mul j 64 i get gdent add a i
end
r = stat gpth 0 get gpl 0 gstb 0 128
if ne r 0
ret
end
put gplnl j n
put gplino j vwst64 8
put gpln_n 0 add j 1
end
fn vwplname j ulong to void
for i ulong get gplnl j
vwsbc get gpln add mul j 64 i
end
end
note vwplone: every /proc/locks line whose inode is pool j's, as holds|waits PID CMDLINE
fn vwplone j ulong to void
ino = get gplino j
any = false
n = get glkl 0
a = ulong 0
for i ulong n
if eq get glk i 10
if vwlkline a i ino j
any = true
end
a = add i 1
end
end
if not any
vwsbt tpooll
vwplname j
vwsbc 9
vwsbt tfree
vwsbc 10
end
end
note vwlkline: fields of one /proc/locks line glk[a, e): "N: [->] TYPE MODE RW PID MAJ:MIN:INO S E".
note Field scan state lives in glkw (waits) and glkp (the number before the device field).
fn vwlkline a ulong e ulong ino ulong j ulong to bool
put glkw 0 0
put glkp 0 18446744073709551615
pid = ulong 18446744073709551615
p = a
for it ulong 64
p = vwskipsp p e
if ge p e
break
end
q = vwtokend p e
if eq vwcolons p q 2
if ne vwlastnum p q ino
ret false
end
pid = get glkp 0
break
end
vwtokstep p q
p = q
end
if or eq pid 18446744073709551615 eq pid 0
ret false
end
vwsbt tpooll
vwplname j
vwsbc 9
if eq get glkw 0 1
vwsbt twaits
else
vwsbt tholds
end
vwsbc 9
vwsbd pid
vwsbc 9
vwcmdl pid
vwsbc 10
ret true
end
fn vwskipsp p ulong e ulong to ulong
x = p
for s ulong 4096
if ge x e
ret x
end
if ne get glk x 32
ret x
end
x = add x 1
end
ret x
end
fn vwtokend p ulong e ulong to ulong
x = p
for s ulong 4096
if ge x e
ret x
end
if eq get glk x 32
ret x
end
x = add x 1
end
ret x
end
fn vwtokstep p ulong q ulong to void
if eq sub q p 2
if eq get glk p 45
put glkw 0 1
end
end
put glkp 0 vwdecn p q
end
fn vwcolons p ulong q ulong to ulong
c = ulong 0
for i ulong sub q p
if eq get glk add p i 58
c = add c 1
end
end
ret c
end
note vwdecn: decimal value of glk[p, q), or all ones when it is not a plain number
fn vwdecn p ulong q ulong to ulong
if or eq p q gt sub q p 19
ret 18446744073709551615
end
v = ulong 0
for i ulong sub q p
c = get glk add p i
if not vwdig c
ret 18446744073709551615
end
v = add mul v 10 ulong sub c 48
end
ret v
end
fn vwlastnum p ulong q ulong to ulong
s = q
for i ulong sub q p
if eq get glk sub sub q i 1 58
s = sub q i
break
end
end
ret vwdecn s q
end
fn vwcmdl pid ulong to void
vwpb
vwpt tproc
vwpd pid
vwpt tcmdl
r = vwrdall 200
if lt r 0
ret
end
a = get goa 0
for i ulong sub get gol 0 a
c = get gob add a i
if or lt c 32 eq c 127
vwsbc 32
else
vwsbc c
end
end
end
note ---- the index: one line per published slot, and the poller's heartbeat
fn vwindex tick ulong to void
put gsl 0 0
vwsbt thdrp
vwsbd vwnowms
vwsbc 9
vwsbd get gtmux 0
vwsbc 9
vwsbd tick
vwsbc 10
for s ulong 64
show = false
if lt s 48
show = and eq get gslive s 1 gt get gsgen s 0
else
show = or gt get gsgen s 0 ne get gsst s 0
end
if show
vwixl s
end
end
put ghdl 0 0
vwpb
vwpr
vwpt tindex
ok = vwwpath
end
fn vwixl s ulong to void
vwsbd s
vwsbc 9
vwsbd get gsgen s
vwsbc 9
vwsbd get gstms s
vwsbc 9
vwsbd get gsst s
vwsbc 9
vwkindt get gskind s
vwsbc 9
b = mul s 64
for i ulong get gsnl s
vwsbc get gsnam add b i
end
vwsbc 10
end
fn vwslow to void
vwhermes
vwhpath tpboard
vwfsec 50 true 65536
vwhpath tpques
vwfsec 51 true 32768
vwhpath tpdec
vwfsec 52 true 32768
vwhpath tpclaim
vwfsec 53 false 131072
vwwindow
vwgpu
vwpools
vwmach
vwledger
end
fn vwpoll to void
vwinitsec
put ggen 0 vwnowms
pp = getppid
for tick ulong 9223372036854775807
t0 = monons
if ne getppid pp
exit 0
end
vwpanes
if eq rem tick 5 0
vwslow
end
if eq rem tick 5 0
vwkanban
end
vwindex tick
el = sub long monons long t0
if lt el 2000000000
x = sleepns sub 2000000000 el
end
end
end

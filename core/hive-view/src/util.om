note hive-view src/util.om: process-wide buffers and small byte helpers (names vw*, globals g*).
note Composed after seed/net/http.om, seed/net/notls.om and om/tls/sha2.om; see build.sh.
note Globals are never passed as arguments (omc error 19): helpers name them directly.
global ghome uchar 512
global ghomel ulong 1
global grun uchar 512
global grunl ulong 1
global gpth uchar 4096
global gpl ulong 1
global gpk uchar 4096
global gpkl ulong 1
global gpkr ulong 1
global gob uchar 262144
global gol ulong 1
global goa ulong 1
global gotr ulong 1
global gsb uchar 393216
global gsl ulong 1
global gstb uchar 128
global gpfd uchar 8
global gwst uchar 4
global ghd uchar 256
global ghdl ulong 1
global gjunk uchar 4096
global gtok uchar 64
global gport ulong 1
text tdevnul "/dev/null"
text thexd "0123456789abcdef"
note ---- section builder gsb
fn vwsbc c uchar to void
n = get gsl 0
if lt n len gsb
put gsb n c
put gsl 0 add n 1
end
end
fn vwsbt t view uchar * to void
for i ulong len t
vwsbc get t i
end
end
fn vwsbd v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i
vwsbc get d add i k
end
end
note vwsbo: append gob[a, a+n) to gsb
fn vwsbo a ulong n ulong to void
for i ulong n
vwsbc get gob add a i
end
end
note vwsbol: append the command/file output gob[goa, gol) to gsb
fn vwsbol to void
a = get goa 0
b = get gol 0
if gt b a
vwsbo a sub b a
end
end
note ---- path builder gpth (at most 4095 bytes; longer paths are cut and refused by fopen)
fn vwpb to void
put gpl 0 0
end
fn vwpc c uchar to void
n = get gpl 0
if lt n 4095
put gpth n c
put gpl 0 add n 1
end
end
fn vwpt t view uchar * to void
for i ulong len t
vwpc get t i
end
end
fn vwph to void
for i ulong get ghomel 0
vwpc get ghome i
end
end
fn vwpr to void
for i ulong get grunl 0
vwpc get grun i
end
end
fn vwpd v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i
vwpc get d add i k
end
end
note ---- packed argument list gpk (u16 count, then u16 length + bytes per record)
fn vwkb to void
put gpk 0 0
put gpk 1 0
put gpkl 0 2
end
fn vwkopen to void
n = get gpkl 0
put gpkr 0 n
put gpk n 0
put gpk add n 1 0
put gpkl 0 add n 2
c = add or ulong get gpk 0 shl ulong get gpk 1 8 1
put gpk 0 uchar and c 255
put gpk 1 uchar shr c 8
end
fn vwkc c uchar to void
n = get gpkl 0
if lt n 4095
put gpk n c
put gpkl 0 add n 1
r = get gpkr 0
k = add or ulong get gpk r shl ulong get gpk add r 1 8 1
put gpk r uchar and k 255
put gpk add r 1 uchar shr k 8
end
end
fn vwka t view uchar * to void
vwkopen
for i ulong len t
vwkc get t i
end
end
note ---- little-endian reads of the small global byte buffers
fn vwpfd i ulong to int
b = mul i 4
v = or ulong get gpfd b shl ulong get gpfd add b 1 8
v = or v shl ulong get gpfd add b 2 16
v = or v shl ulong get gpfd add b 3 24
ret int v
end
fn vwst64 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get gstb add o i mul i 8
end
ret v
end
fn vwst32 o ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get gstb add o i mul i 8
end
ret v
end
fn vwnowms to ulong
ret div ulong realns 1000000
end
note ---- byte classes
fn vwdig c uchar to bool
ret and ge c 48 le c 57
end
fn vwhex c uchar to bool
if vwdig c
ret true
end
ret and ge c 97 le c 102
end
note vwnamec: a byte allowed in a session name we will target (tmux names are wider; we refuse the rest)
fn vwnamec c uchar to bool
if vwdig c
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret or eq c 45 eq c 95
end

note hive-view src/web.om: HTTP routes. One forked process per browser connection (keep-alive).
note Reads need the session cookie; the only write, POST /send, also needs the X-Hive-View header,
note a same-origin Origin, a session name present in a fresh `tmux list-sessions`, and text that
note is valid UTF-8 without control characters. It types that text literally (send-keys -l)
note and then Enter, or sends Enter or Escape alone, and logs one line without the text.
global gah uchar 1024
global gaho ulong 8
global gahl ulong 8
global gahn ulong 1
global glog uchar 1024
global glogl ulong 1
global glfd long 1
text tget "GET"
text tpost "POST"
text troot "/"
text tpcss "/app.css"
text tpsend "/send"
text tphealth "/health"
text tfcss "app.css"
text tctype "Content-Type"
text tthtml "text/html; charset=utf-8"
text ttcss "text/css; charset=utf-8"
text tttext "text/plain; charset=utf-8"
text tcc "Cache-Control"
text tnostore "no-store"
text tcsp "Content-Security-Policy"
text tcspv "default-src 'none'; style-src 'self'; img-src 'self'; frame-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'none'"
text txcto "X-Content-Type-Options"
text tnosniff "nosniff"
text trefp "Referrer-Policy"
text tnoref "same-origin"
text txfo "X-Frame-Options"
text tdeny "SAMEORIGIN"
text tsetck "Set-Cookie"
text tckpre "hv="
text tckattr "; Path=/; HttpOnly; SameSite=Strict; Max-Age=31536000"
text tloc "Location"
text thhost "host"
text thcook "cookie"
text thorig "origin"
text thttp "http://"
text tqt "/?t="
text tok200 "ok\n"
text tbadlink "This link is not valid. Ask for the current link (the token is in ~/.config/hive-view/token on the Spark).\n"
text tnoauth "Not signed in: open the one-time link once on this device.\n"
text tbadkey "Refused: the form key is wrong. Reload the page and try again.\n"
text tnoorig "Refused: cross-origin request.\n"
text tbadbody "Refused: malformed request.\n"
text tbigbody "Refused: the text is longer than 4096 bytes.\n"
text tbadname "Refused: that is not a session name the dashboard can type into.\n"
text tnosess "Refused: no tmux session has that name right now.\n"
text tbadact "Refused: unknown action (allowed: line, enter, escape).\n"
text tbadtext "Refused: the text must be one line of printable characters (no control keys).\n"
text ttmuxbad "tmux did not accept the keys; nothing more was sent.\n"
text tlogbad "Refused: the send log ~/.local/state/hive-view/sends.log cannot be written, so nothing was sent.\n"
text tnotfnd "Not found.\n"
text tmeth "Method not allowed.\n"
text tbadhost "Refused: unknown Host.\n"
text tsendk "send-keys"
text tdashl "-l"
text tdd "--"
text tenter "Enter"
text tescape "Escape"
text taline "line"
text taenter "enter"
text taesc "escape"
text tlogp "/.local/state/hive-view/sends.log"
text tlsfmt1 "#{session_name}"
text tlsessn "session="
text tlact " action="
text tlbytes " bytes="
text tlsha " sha256="
text tlres " result="
text tlok "ok"
text tlnosess "refused-no-session"
text tlbadtx "refused-text"
text tlfail "tmux-failed"
note ---- request checks
fn vwhostok cs edit ulong 320 io edit uchar 131072 to bool
i = hhfind cs io thhost
if lt i 0
ret false
end
vo = hhvoff cs ulong i
vl = hhvlen cs ulong i
for k ulong get gahn 0
if vwahis io vo vl k
ret true
end
end
ret false
end
fn vwahis io edit uchar 131072 vo ulong vl ulong k ulong to bool
if ne vl get gahl k
ret false
end
b = get gaho k
for i ulong vl
if ne get io add vo i get gah add b i
ret false
end
end
ret true
end
note vwtokeq: io[off, off+64) equals the token; the comparison time does not depend on where it differs
fn vwtokeq io edit uchar 131072 off ulong to bool
if gt add off 64 len io
ret false
end
d = uchar 0
for i ulong 64
d = or d xor get io add off i get gtok i
end
ret eq d 0
end
note vwauth: any Cookie header carries hv=<token> as one of its cookies
fn vwauth cs edit ulong 320 io edit uchar 131072 to bool
ok = false
for i ulong get cs HHN
if hieqm view part io hhnoff cs i hhnlen cs i thcook
if vwckval io hhvoff cs i hhvlen cs i
ok = true
end
end
end
ret ok
end
fn vwckval io edit uchar 131072 vo ulong vl ulong to bool
p = ulong 0
for it ulong 4096
for s ulong 4096
if ge p vl
break
end
if ne get io add vo p 32
break
end
p = add p 1
end
if le add p 67 vl
if vwckat io add vo p
if eq add p 67 vl
ret vwtokeq io add add vo p 3
end
if eq get io add add vo p 67 59
ret vwtokeq io add add vo p 3
end
end
end
for s ulong 4096
if ge p vl
ret false
end
if eq get io add vo p 59
break
end
p = add p 1
end
p = add p 1
end
ret false
end
fn vwckat io edit uchar 131072 o ulong to bool
if ne get io o 104
ret false
end
if ne get io add o 1 118
ret false
end
ret eq get io add o 2 61
end
note vworigin: the Origin header is present and exactly "http://" + the (already checked) Host.
note Browsers send it on every form POST (Referrer-Policy same-origin keeps it from being "null").
fn vworigin cs edit ulong 320 io edit uchar 131072 to bool
i = hhfind cs io thorig
if lt i 0
ret false
end
h = hhfind cs io thhost
if lt h 0
ret false
end
oo = hhvoff cs ulong i
ol = hhvlen cs ulong i
ho = hhvoff cs ulong h
hl = hhvlen cs ulong h
m = len thttp
if ne ol add m hl
ret false
end
if not heq view part io oo m thttp
ret false
end
ret vwioeq io add oo m ho hl
end
fn vwioeq io edit uchar 131072 a ulong b ulong n ulong to bool
for i ulong n
if ne get io add a i get io add b i
ret false
end
end
ret true
end
note ---- responses
fn vwsech cs edit ulong 320 io edit uchar 131072 to long
r = hhname cs io tcc
r = hfe r hhval cs io tnostore
r = hfe r hhname cs io txcto
r = hfe r hhval cs io tnosniff
r = hfe r hhname cs io trefp
r = hfe r hhval cs io tnoref
r = hfe r hhname cs io txfo
r = hfe r hhval cs io tdeny
r = hfe r hhname cs io tcsp
ret hfe r hhval cs io tcspv
end
fn vwtext cs edit ulong 320 io edit uchar 131072 code ulong t view uchar * to long
r = hrspst cs io code
r = hfe r vwsech cs io
r = hfe r hhname cs io tctype
r = hfe r hhval cs io tttext
r = hfe r hhend cs io 0 len t
r = hfe r hput cs io t
ret hfe r hwfin cs io
end
fn vwcss cs edit ulong 320 io edit uchar 131072 buf edit uchar 262144 to long
vwpb
vwpt tfcss
n = vwrdbuf buf
if lt n 0
ret vwtext cs io 404 tnotfnd
end
r = hrspst cs io 200
r = hfe r vwsech cs io
r = hfe r hhname cs io tctype
r = hfe r hhval cs io ttcss
r = hfe r hhend cs io 0 ulong n
r = hfe r hput cs io view part buf 0 ulong n
ret hfe r hwfin cs io
end
note vwrdbuf: the whole file at gpth into buf (refused when it does not fit)
fn vwrdbuf buf edit uchar 262144 to long
fd = fopen gpth 0 get gpl 0 524288 0
if lt fd 0
ret fd
end
n = ulong 0
for it ulong 100000
if ge n len buf
x = fclose int fd
ret -27
end
r = read int fd buf n sub len buf n
if lt r 0
x = fclose int fd
ret r
end
if eq r 0
break
end
n = add n ulong r
end
x = fclose int fd
ret long n
end
note vwlogin: GET /?t=<64 hex> sets the HttpOnly SameSite=Strict cookie and redirects to /
fn vwlogin cs edit ulong 320 io edit uchar 131072 to long
tg = get cs HTOFF
tl = get cs HTLEN
ok = false
if eq tl add len tqt 64
if heq view part io tg len tqt tqt
ok = vwtokeq io add tg len tqt
end
end
if not ok
ret vwtext cs io 403 tbadlink
end
ck = new uchar 160 0
n = ulong 0
for i ulong len tckpre
put ck n get tckpre i
n = add n 1
end
for i ulong 64
put ck n get gtok i
n = add n 1
end
for i ulong len tckattr
put ck n get tckattr i
n = add n 1
end
r = hrspst cs io 302
r = hfe r vwsech cs io
r = hfe r hhname cs io tsetck
r = hfe r hhval cs io view part ck 0 n
r = hfe r hhname cs io tloc
r = hfe r hhval cs io troot
r = hfe r hhend cs io 0 0
ret hfe r hwfin cs io
end
fn vwnlat buf edit uchar 262144 p ulong n ulong to ulong
for i ulong sub n p
if eq get buf add p i 10
ret add p i
end
end
ret n
end
fn vwbeq buf edit uchar 262144 a ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n
if ne get buf add a i get t i
ret false
end
end
ret true
end
note vwsendp: body "NAME<LF>ACTION<LF>TEXT". Returns 0 sent, 1 malformed, 2 bad name,
note 3 bad action, 4 bad text, 5 no such session, 6 tmux failed, 7 text too long, 8 send log
note cannot be opened (checked before anything is typed, so no keys go out unlogged)
fn vwsendp buf edit uchar 262144 n ulong to ulong
e1 = vwnlat buf 0 n
if ge e1 n
ret 1
end
e2 = vwnlat buf add e1 1 n
if ge e2 n
ret 1
end
if or eq e1 0 gt e1 63
ret 2
end
for i ulong e1
if not vwnamec get buf i
ret 2
end
end
act = ulong 9
if vwbeq buf add e1 1 sub sub e2 e1 1 taline
act = 0
end
if vwbeq buf add e1 1 sub sub e2 e1 1 taenter
act = 1
end
if vwbeq buf add e1 1 sub sub e2 e1 1 taesc
act = 2
end
if eq act 9
ret 3
end
t0 = add e2 1
tn = sub n t0
if gt tn 4096
ret 7
end
if ne act 0
if ne tn 0
ret 4
end
end
vwhpath tlogp
lf = fopen gpth 0 get gpl 0 525377 384
if lt lf 0
ret 8
end
put glfd 0 lf
if not vwutf8 view part buf t0 tn
vwlogl buf e1 act t0 tn 1
ret 4
end
if not vwlive buf e1
vwlogl buf e1 act t0 tn 2
ret 5
end
ok = vwtype buf e1 act t0 tn
if ok
vwlogl buf e1 act t0 tn 0
ret 0
end
vwlogl buf e1 act t0 tn 3
ret 6
end
note vwutf8: well-formed UTF-8 with no C0 control, DEL or C1 control character
fn vwutf8 a view uchar * to bool
n = len a
i = ulong 0
for it ulong 8192
if ge i n
ret true
end
c = get a i
if lt c 128
if or lt c 32 eq c 127
ret false
end
i = add i 1
continue
end
k = vwu8len a i
if eq k 0
ret false
end
i = add i k
end
ret false
end
note vwu8len: length of the well-formed multi-byte sequence at a[i], or 0 (RFC 3629 table 3-7)
fn vwu8len a view uchar * i ulong to ulong
n = len a
c = get a i
lo = uchar 128
hi = uchar 191
k = ulong 0
if and ge c 194 le c 223
k = 2
if eq c 194
lo = 160
end
end
if and ge c 224 le c 239
k = 3
if eq c 224
lo = 160
end
if eq c 237
hi = 159
end
end
if and ge c 240 le c 244
k = 4
if eq c 240
lo = 144
end
if eq c 244
hi = 143
end
end
if eq k 0
ret 0
end
if gt add i k n
ret 0
end
b = get a add i 1
if or lt b lo gt b hi
ret 0
end
for j ulong sub k 2
b = get a add i add j 2
if or lt b 128 gt b 191
ret 0
end
end
ret k
end
note vwlive: buf[0, e1) is exactly one line of a fresh `tmux list-sessions -F #{session_name}`
fn vwlive buf edit uchar 262144 e1 ulong to bool
vwkb
vwka ttmux
vwka tlsess
vwka tdashf
vwka tlsfmt1
r = vwrun 3000000000
if ne r 0
ret false
end
a = ulong 0
n = get gol 0
for i ulong n
if eq get gob i 10
if vwobeq buf e1 a i
ret true
end
a = add i 1
end
end
ret false
end
fn vwobeq buf edit uchar 262144 e1 ulong a ulong b ulong to bool
if ne sub b a e1
ret false
end
for i ulong e1
if ne get gob add a i get buf i
ret false
end
end
ret true
end
note vwtarget: the packed argument "=NAME:" (exact session match, its active pane)
fn vwtarget buf edit uchar 262144 e1 ulong to void
vwkopen
vwkc 61
for i ulong e1
vwkc get buf i
end
vwkc 58
end
fn vwkey buf edit uchar 262144 e1 ulong key view uchar * to bool
vwkb
vwka ttmux
vwka tsendk
vwka tdasht
vwtarget buf e1
vwka key
ret eq vwrun 5000000000 0
end
note vwtype: send-keys -l in chunks of at most 2048 bytes cut at character boundaries (a packed
note argument list holds 4096 bytes), then Enter. tmux reads an argument ending in ';' as a
note command separator; such a chunk is sent as "...\;", which tmux turns back into "...;".
fn vwtype buf edit uchar 262144 e1 ulong act ulong t0 ulong tn ulong to bool
if eq act 1
ret vwkey buf e1 tenter
end
if eq act 2
ret vwkey buf e1 tescape
end
p = t0
e = add t0 tn
for it ulong 8
if ge p e
break
end
q = hmin e add p 2048
for s ulong 4
if ge q e
break
end
if ne and get buf q 192 128
break
end
q = sub q 1
end
if not vwchunk buf e1 p q
ret false
end
p = q
end
ret vwkey buf e1 tenter
end
fn vwchunk buf edit uchar 262144 e1 ulong p ulong q ulong to bool
vwkb
vwka ttmux
vwka tsendk
vwka tdasht
vwtarget buf e1
vwka tdashl
vwka tdd
vwkopen
for i ulong sub q p
if and eq add p i sub q 1 eq get buf add p i 59
vwkc 92
end
vwkc get buf add p i
end
ret eq vwrun 5000000000 0
end
note ---- the send log: one line per attempt that reached the session check (never the text)
fn vwlc c uchar to void
n = get glogl 0
if lt n len glog
put glog n c
put glogl 0 add n 1
end
end
fn vwlt t view uchar * to void
for i ulong len t
vwlc get t i
end
end
fn vwld v ulong w ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if and eq x 0 ge sub 20 i w
break
end
end
for k ulong sub 20 i
vwlc get d add i k
end
end
note vwltime: realns as UTC YYYY-MM-DDTHH:MM:SSZ (civil-from-days, proleptic Gregorian)
fn vwltime to void
s = div ulong realns 1000000000
vwldate div s 86400
sec = rem s 86400
vwlc 84
vwld div sec 3600 2
vwlc 58
vwld div rem sec 3600 60 2
vwlc 58
vwld rem sec 60 2
vwlc 90
end
fn vwldate days ulong to void
z = add days 719468
era = div z 146097
doe = sub z mul era 146097
yoe = vwyoe doe
doy = sub doe sub add mul 365 yoe div yoe 4 div yoe 100
mp = div add mul 5 doy 2 153
m = add mp 3
if ge mp 10
m = sub mp 9
end
y = add yoe mul era 400
if le m 2
y = add y 1
end
vwld y 4
vwlc 45
vwld m 2
vwlc 45
vwld add sub doy div add mul 153 mp 2 5 1 2
end
fn vwyoe doe ulong to ulong
a = sub doe div doe 1460
b = add a div doe 36524
ret div sub b div doe 146096 365
end
fn vwlres res ulong to void
if eq res 0
vwlt tlok
ret
end
if eq res 1
vwlt tlbadtx
ret
end
if eq res 2
vwlt tlnosess
ret
end
vwlt tlfail
end
fn vwlogl buf edit uchar 262144 e1 ulong act ulong t0 ulong tn ulong res ulong to void
put glogl 0 0
vwltime
vwlc 32
vwlt tlsessn
for i ulong e1
vwlc get buf i
end
vwlt tlact
if eq act 0
vwlt taline
end
if eq act 1
vwlt taenter
end
if eq act 2
vwlt taesc
end
vwlt tlbytes
vwld tn 1
vwlt tlsha
dg = new uchar 32 0
k = sha2_digest 256 view part buf t0 tn dg
for i ulong 32
c = get dg i
vwlc get thexd shr c 4
vwlc get thexd and c 15
end
vwlt tlres
vwlres res
vwlc 10
fd = get glfd 0
w = write int fd glog 0 get glogl 0
x = fclose int fd
end

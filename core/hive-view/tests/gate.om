note hive-view tests/gate.om: the acceptance gate, in pure Omega. Built like the server, with
note src/util.om and src/run.om (no shell, exact argument lists) and this file as the entry:
note   gate run PORT        drive a running server on 127.0.0.1:PORT through every check below;
note                        prints one PASS/FAIL line per check, exit 0 only when all pass
note   gate cpu PID SECS    CPU ticks (USER_HZ) used by server PID with its children and by the
note                        tmux server over SECS seconds
note The run mode creates its own tmux session hv-test whose only program is
note `/usr/bin/tee -a /tmp/hv-gate-sink` on a raw (-icanon -echo) terminal, so every byte the
note dashboard types is recorded exactly; it is deleted at the end (which is itself a check).
global gaport ulong 1
global gax uchar 64
global gaxl ulong 1
global gatg uchar 1024
global gatgl ulong 1
global gabd uchar 40000
global gabdl ulong 1
global garb uchar 262144
global garbl ulong 1
global galoc uchar 1024
global galocl ulong 1
global gack ulong 1
global gakey uchar 64
global gatx uchar 8192
global gatxl ulong 1
global gapass ulong 1
global gafail ulong 1
global gatk ulong 4
text tget "GET"
text tpost "POST"
text tenvh "HOME="
text ttokf "/.config/hive-view/token"
text tlogf "/.local/state/hive-view/sends.log"
text tsink "/tmp/hv-gate-sink"
text ttmux "/usr/bin/tmux"
text tstty "/usr/bin/stty"
text ttee "/usr/bin/tee"
text tnew "new-session"
text tdd "-d"
text tds "-s"
text tdx "-x"
text tdy "-y"
text t120 "120"
text t30 "30"
text tdash "-a"
text tkill "kill-session"
text tdt "-t"
text tdisp "display-message"
text tdp "-p"
text tptty "#{pane_tty}"
text tpid "#{pid}"
text tsessn "hv-test"
text tsesst "=hv-test:"
text tsesk "=hv-test"
text tdf "-F"
text ticanon "-icanon"
text techo "-echo"
text thost "Host"
text tcook "Cookie"
text torig "Origin"
text tctype "Content-Type"
text tform "application/x-www-form-urlencoded"
text tckpre "hv="
text thttp "http://"
text tevil "http://evil.example"
text tevilh "evil.example"
text tlocn "location"
text tsetck "set-cookie"
text tphealth "/health"
text troot "/"
text tqt "/?t="
text tpsend "/send"
text tpses "/s/hv-test"
text tpane "/p/pane?n=hv-test"
text tkpat "name=\"k\" value=\""
text tline "line"
text tenter "enter"
text tescape "escape"
text tps "s"
text tpq "q"
text tpass "PASS "
text tfail "FAIL "
text tsum "gate: "
text tsum2 " passed, "
text tsum3 " failed\n"
text tsha "sha256="
text tbyt "bytes="
text tmark "gate-secret-marker-5c1e"
text tescs "&lt;script&gt;alert(1)&lt;/script&gt;"
text tscr "<script>"
text tcpu1 "hive-view ticks "
text tcpu2 " tmux-server ticks "
text tcpu3 " over "
text tcpu4 " s (USER_HZ 100)\n"
text tstat "/stat"
text tproc "/proc/"
text tchild "/task/"
text tchild2 "/children"
note ---- the cases typed literally: each must arrive byte for byte, followed by Enter (LF)
text c01 "semi;"
text c02 ";"
text c03 ";;"
text c04 "-n"
text c05 "--"
text c06 "$(id) `id` 'q' \"dq\" & | > <"
text c07 "é ü 漢字 🐝"
text c08 "<script>alert(1)</script>"
text c09 "   leading and trailing spaces   "
text c10 "%41+%20&a=escape"
text c11 "send-keys -t =omp-queen: Enter"
text n01 "send ;semi"
note ---- output
fn gaout to void
n = get gsl 0
p = ulong 0
for it ulong 1000
if ge p n
break
end
w = write 1 gsb p sub n p
if le w 0
break
end
p = add p ulong w
end
put gsl 0 0
end
fn gachk ok bool name view uchar * to void
if ok
vwsbt tpass
put gapass 0 add get gapass 0 1
else
vwsbt tfail
put gafail 0 add get gafail 0 1
end
vwsbt name
vwsbc 10
gaout
end
note ---- environment
fn gahome to bool
eb = new uchar 600 0
for i ulong ulong envcnt
n = envread i eb 0 600
if gt n 5
if heq view part eb 0 5 tenvh
k = hmin sub ulong n 5 511
for j ulong k
put ghome j get eb add 5 j
end
put ghomel 0 k
ret gt k 0
end
end
end
ret false
end
fn gatok to bool
vwpb
vwph
vwpt ttokf
r = vwrdall 128
if lt r 64
ret false
end
for i ulong 64
put gtok i get gob i
end
ret true
end
fn gadec a view uchar * to ulong
v = ulong 0
for i ulong len a
c = get a i
if not vwdig c
ret v
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note ---- HTTP client: one connection per request. fl: 1 cookie, 2 good Origin, 4 foreign Origin,
note 8 foreign Host, 16 bad cookie. The response body lands in garb, Location in galoc, and gack
note is 1 when Set-Cookie carried hv=<token>.
fn gaxbuf to void
put gaxl 0 0
s = new uchar 24 0
p = ulong 0
put s 0 49
put s 1 50
put s 2 55
put s 3 46
put s 4 48
put s 5 46
put s 6 48
put s 7 46
put s 8 49
put s 9 58
p = 10
for i ulong 10
put gax i get s i
end
d = new uchar 20 0
k = ulong 0
x = get gaport 0
for it ulong 20
put d k uchar add rem x 10 48
k = add k 1
x = div x 10
if eq x 0
break
end
end
for i ulong k
put gax add p i get d sub sub k 1 i
end
put gaxl 0 add p k
end
fn gahdrs cs edit ulong 320 io edit uchar 131072 fl ulong to long
hb = new uchar 64 0
ck = new uchar 67 0
o = new uchar 96 0
n = get gaxl 0
for i ulong n
put hb i get gax i
end
r = hhname cs io thost
if ne and fl 8 0
r = hfe r hhval cs io tevilh
else
r = hfe r hhval cs io view part hb 0 n
end
if ne and fl 17 0
for i ulong 3
put ck i get tckpre i
end
for i ulong 64
put ck add 3 i get gtok i
end
if ne and fl 16 0
put ck 3 48
end
r = hfe r hhname cs io tcook
r = hfe r hhval cs io ck
end
if ne and fl 2 0
for i ulong 96
put o i 0
end
for i ulong 7
put o i get thttp i
end
n = get gaxl 0
for i ulong n
put o add 7 i get gax i
end
r = hfe r hhname cs io torig
r = hfe r hhval cs io view part o 0 add 7 n
end
if ne and fl 4 0
r = hfe r hhname cs io torig
r = hfe r hhval cs io tevil
end
ret r
end
fn gawreq cs edit ulong 320 io edit uchar 131072 post bool fl ulong to long
tg = new uchar 1024 0
bd = new uchar 40000 0
r = long 0
if post
r = hreqst cs io tpost
else
r = hreqst cs io tget
end
tn = get gatgl 0
for i ulong tn
put tg i get gatg i
end
r = hfe r hreqtg cs io view part tg 0 tn
r = hfe r gahdrs cs io fl
bl = ulong 0
if post
r = hfe r hhname cs io tctype
r = hfe r hhval cs io tform
bl = get gabdl 0
end
r = hfe r hhend cs io 0 bl
if post
for i ulong bl
put bd i get gabd i
end
r = hfe r hput cs io view part bd 0 bl
end
ret hfe r hwfin cs io
end
fn garbody cs edit ulong 320 io edit uchar 131072 to void
rb = new uchar 262144 0
put cs HBCAP 262144
n = hbodyall cs io rb
m = ulong 0
if gt n 0
m = ulong n
end
for i ulong m
put garb i get rb i
end
put garbl 0 m
end
fn gareq post bool fl ulong to long
a = new uchar 16 0
cs = new ulong 320 0
io = new uchar 131072 0
put garbl 0 0
put galocl 0 0
put gack 0 0
r = haddr4 a uint 2130706433 get gaport 0
fd = hdial a 3000000000
if lt fd 0
ret fd
end
r = hinit cs io int fd 0
hsettmo cs 10000000000 10000000000
hsetbdl cs 10000000000
r = hfe r gawreq cs io post fl
if lt r 0
x = hclose cs
ret r
end
s = hrsprd cs io
if lt s 0
x = hclose cs
ret s
end
garesp cs io
garbody cs io
x = hclose cs
ret s
end
fn garesp cs edit ulong 320 io edit uchar 131072 to void
i = hhfind cs io tlocn
if ge i 0
vo = hhvoff cs ulong i
vl = hmin hhvlen cs ulong i 1024
for k ulong vl
put galoc k get io add vo k
end
put galocl 0 vl
end
j = hhfind cs io tsetck
if ge j 0
vo = hhvoff cs ulong j
vl = hhvlen cs ulong j
if ge vl 67
ok = heq view part io vo 3 tckpre
for k ulong 64
if ne get io add add vo 3 k get gtok k
ok = false
end
end
if ok
put gack 0 1
end
end
end
end
fn gatgt t view uchar * to void
for i ulong len t
put gatg i get t i
end
put gatgl 0 len t
end
fn gaget t view uchar * fl ulong to long
gatgt t
ret gareq false fl
end
fn hmax2 a long b long to long
if gt a b
ret a
end
ret b
end
fn garbat a ulong t view uchar * to bool
if gt add a len t get garbl 0
ret false
end
for i ulong len t
if ne get garb add a i get t i
ret false
end
end
ret true
end
fn gaobat a ulong t view uchar * to bool
if gt add a len t get gol 0
ret false
end
for i ulong len t
if ne get gob add a i get t i
ret false
end
end
ret true
end
note gahas: garb contains t
fn gahas t view uchar * to bool
n = get garbl 0
m = len t
if gt m n
ret false
end
for i ulong add sub n m 1
if garbat i t
ret true
end
end
ret false
end
note ---- form bodies
fn gabc c uchar to void
n = get gabdl 0
if lt n len gabd
put gabd n c
put gabdl 0 add n 1
end
end
fn gabt t view uchar * to void
for i ulong len t
gabc get t i
end
end
note gabe: percent-encode every byte except ASCII letters and digits
fn gabe a view uchar * to void
for i ulong len a
c = get a i
if or vwdig c or and ge c 65 le c 90 and ge c 97 le c 122
gabc c
else
gabc 37
gabc get thexd ulong shr ulong c 4
gabc get thexd and ulong c 15
end
end
end
fn gafld k uchar v view uchar * to void
if gt get gabdl 0 0
gabc 38
end
gabc k
gabc 61
gabe v
end
note gaform: s, k, r, a and t (the text is gatx[0, gatxl)); badk 1 sends a wrong key
fn gaform sn view uchar * act view uchar * badk ulong to void
z = new uchar 64 48
kk = new uchar 64 0
tx = new uchar 8192 0
put gabdl 0 0
gafld 115 sn
if eq badk 1
gafld 107 z
else
for i ulong 64
put kk i get gakey i
end
gafld 107 kk
end
gafld 114 tps
gafld 97 act
n = get gatxl 0
for i ulong n
put tx i get gatx i
end
gafld 116 view part tx 0 n
end
fn gapost fl ulong to long
gatgt tpsend
ret gareq true fl
end
note galq: the number after "<c>=" in the Location query, or 999999
fn galq c uchar to ulong
n = get galocl 0
for i ulong n
if and eq get galoc i c lt add i 1 n
if eq get galoc add i 1 61
p = add i 2
if or eq i 0 or eq get galoc sub i 1 63 eq get galoc sub i 1 38
v = ulong 0
ok = false
for k ulong 20
if ge add p k n
break
end
d = get galoc add p k
if not vwdig d
break
end
v = add mul v 10 ulong sub d 48
ok = true
end
if ok
ret v
end
end
end
end
end
ret 999999
end
note ---- the sink file written by tee inside hv-test
fn gasinkp to void
vwpb
vwpt tsink
end
fn gasize to ulong
gasinkp
fd = vwfopen
if lt fd 0
ret 0
end
r = fstat int fd gstb 0 128
x = fclose int fd
if lt r 0
ret 0
end
ret vwst64 48
end
fn gawait want ulong to bool
for it ulong 60
if ge gasize want
ret true
end
x = sleepns 50000000
end
ret ge gasize want
end
note gasink: the sink from offset off holds exactly gatx[0, gatxl) followed by the byte tail
fn gasink off ulong tail long to bool
gasinkp
r = vwrdall 262144
if lt r 0
ret false
end
n = get gatxl 0
want = n
if ge tail 0
want = add n 1
end
if ne get gol 0 add off want
ret false
end
for i ulong n
if ne get gob add off i get gatx i
ret false
end
end
if ge tail 0
ret eq get gob add off n uchar tail
end
ret true
end
fn gasett t view uchar * to void
for i ulong len t
put gatx i get t i
end
put gatxl 0 len t
end
note gatype: type gatx with action act; true when the redirect reports m=0, the byte count, and the
note sink received exactly the text plus tail (LF for a line, ESC for Escape, LF for Enter)
fn gatype act view uchar * tail long to bool
s0 = gasize
gaform tsessn act 0
st = gapass2
if ne st 302
ret false
end
nb = ulong 0
if heq act tline
nb = get gatxl 0
end
if ne galq 109 0
ret false
end
if ne galq 98 nb
ret false
end
want = add s0 add nb 1
if not gawait want
ret false
end
if heq act tline
ret gasink s0 tail
end
gasinkp
r = vwrdall 262144
if ne get gol 0 want
ret false
end
ret eq get gob s0 uchar tail
end
fn gapass2 to long
ret gapost 3
end
note garef: the send is refused with code m and nothing reaches the sink
fn garef act view uchar * m ulong to bool
s0 = gasize
gaform tsessn act 0
st = gapost 3
if ne st 302
ret false
end
if ne galq 109 m
ret false
end
x = sleepns 300000000
ret eq gasize s0
end
note ---- tmux and the sink session
fn gatmux to void
vwkb
vwka ttmux
end
fn gamkses to bool
gatmux
vwka tkill
vwka tdt
vwka tsesk
r = vwrun 5000000000
gasinkp
u = unlink gpth 0 get gpl 0
gatmux
vwka tnew
vwka tdd
vwka tds
vwka tsessn
vwka tdx
vwka t120
vwka tdy
vwka t30
vwka ttee
vwka tdash
vwka tsink
r = vwrun 5000000000
if ne r 0
ret false
end
gatmux
vwka tdisp
vwka tdp
vwka tdt
vwka tsesst
vwka tptty
r = vwrun 5000000000
if ne r 0
ret false
end
n = get gol 0
if and gt n 0 eq get gob sub n 1 10
n = sub n 1
end
if or eq n 0 gt n 200
ret false
end
vwkb
vwka tstty
vwka tdf
vwkopen
for i ulong n
vwkc get gob i
end
vwka ticanon
vwka techo
r = vwrun 5000000000
x = sleepns 300000000
ret eq r 0
end
fn gakilss to bool
gatmux
vwka tkill
vwka tdt
vwka tsesk
r = vwrun 5000000000
ret eq r 0
end
note gakey: the form key from the hv-test page
fn gagetk to bool
st = gaget tpses 1
if ne st 200
ret false
end
n = get garbl 0
m = len tkpat
if lt n add m 64
ret false
end
for i ulong sub sub n m 63
if garbat i tkpat
for k ulong 64
put gakey k get garb add add i m k
end
ret true
end
end
ret false
end
note ---- send log: the newest line names the bytes and the sha256 of the text; the file never
note contains the marker text
fn galogok to bool
dg = new uchar 32 0
tx = new uchar 8192 0
tn = get gatxl 0
for i ulong tn
put tx i get gatx i
end
k = sha2_digest 256 view part tx 0 tn dg
hx = new uchar 71 0
for i ulong 7
put hx i get tsha i
end
for i ulong 32
put hx add 7 mul i 2 get thexd ulong shr ulong get dg i 4
put hx add 8 mul i 2 get thexd and ulong get dg i 15
end
vwpb
vwph
vwpt tlogf
r = vwrdtail 4096
if lt r 0
ret false
end
e = get gol 0
if eq e 0
ret false
end
if eq get gob sub e 1 10
e = sub e 1
end
b = e
for it ulong 4096
if eq b 0
break
end
if eq get gob sub b 1 10
break
end
b = sub b 1
end
ok = false
for i ulong sub e b
if gt add add b i 71 e
break
end
if gaobat add b i hx
ok = true
end
end
ret ok
end
fn galogno to bool
vwpb
vwph
vwpt tlogf
r = vwrdall 262144
n = get gol 0
m = len tmark
if lt n m
ret true
end
for i ulong add sub n m 1
if gaobat i tmark
ret false
end
end
ret true
end
text tbadact "type"
text thc01 "health answers 200 without auth"
text thc02 "GET / without the cookie is refused (403)"
text thc03 "a panel without the cookie is refused (403)"
text thc04 "a wrong cookie is refused (403)"
text thc05 "a wrong one-time link is refused (403)"
text thc06 "the one-time link answers 302 and sets the token cookie"
text thc07 "a foreign Host header is refused (400)"
text thc08 "GET /send is refused (405)"
text thc09 "test session hv-test created (tee into the sink, raw terminal)"
text thc10 "the form key is on the session page"
text thc11 "POST /send without the cookie is refused (403)"
text thc12 "POST /send without an Origin header is refused (403)"
text thc13 "POST /send from a foreign Origin is refused (403)"
text thc14 "POST /send with a wrong form key is refused (403)"
text thc15 "nothing reached the session from the refused posts"
text thc16 "literal backslash-semicolon inside the text"
text thc17 "literal backslash-semicolon alone"
text thc18 "text ending in backslash-semicolon"
text thc19 "4096-byte text (the limit) with semicolons at the chunk edges"
text thc20 "Enter button sends one Enter"
text thc21 "Escape button sends one Escape"
text thc22 "marker text typed"
text thc23 "send log names the byte count and sha256 of the text"
text thc24 "send log never contains the text"
text thc25 "4097-byte text refused (m=7), nothing typed"
text thc26 "control byte 0x01 refused (m=4), nothing typed"
text thc27 "newline inside the text refused (m=4), nothing typed"
text thc28 "DEL refused (m=4), nothing typed"
text thc29 "invalid UTF-8 byte 0xff refused (m=4), nothing typed"
text thc30 "overlong UTF-8 refused (m=4), nothing typed"
text thc31 "carriage return refused (m=4), nothing typed"
text thc32 "tab refused (m=4), nothing typed"
text thc33 "escape byte inside the text refused (m=4), nothing typed"
text thc34 "unknown action refused (m=3), nothing typed"
text thc35 "malformed and forged session names refused (m=2), nothing typed"
text thc36 "duplicate or unknown form fields refused (m=1), nothing typed"
text thc37 "a body over 16 KiB is refused (413), nothing typed"
text thc38 "<script> on a session screen is shown escaped, never as markup"
text thc39 "test session hv-test deleted"
text thc40 "typing into the deleted session is refused (m=5)"
text thc41 "hv-test no longer exists"
fn gareq2 t view uchar * to long
gatgt t
ret gareq false 0
end
note gafbad: forged names (shell metacharacters, a tmux target, path, empty, too long) get m=2
text nb1 "hv-test;ls"
text nb2 "=omp-queen:"
text nb3 "../hv-test"
text nb4 "hv test"
text nb5 "omp-queen:0.1"
fn gafbn n view uchar * to bool
s0 = gasize
gasett c01
gaform n tline 0
st = gapost 3
if or ne st 302 ne galq 109 2
ret false
end
ret eq gasize s0
end
fn gafbad to bool
e = new uchar 1 0
l = new uchar 64 97
ok = gafbn nb1
ok = and ok gafbn nb2
ok = and ok gafbn nb3
ok = and ok gafbn nb4
ok = and ok gafbn nb5
ok = and ok gafbn view part e 0 0
ok = and ok gafbn l
ret ok
end
note gafdup: a repeated field, an unknown field, a field without '=', a bad percent escape
text db1 "&s=hv-test"
text db2 "&x=1"
text db3 "&t"
text db4 "&t=%zz"
fn gafdb t view uchar * to bool
s0 = gasize
gasett c01
gaform tsessn tline 0
gabt t
st = gapost 3
if or ne st 302 ne galq 109 1
ret false
end
ret eq gasize s0
end
fn gafdup to bool
ok = gafdb db1
ok = and ok gafdb db2
ok = and ok gafdb db3
ok = and ok gafdb db4
ret ok
end
fn gafbig to bool
s0 = gasize
gasett c01
gaform tsessn tline 0
for i ulong 16400
gabc 120
end
st = gapost 3
x = sleepns 300000000
ret and eq st 413 eq gasize s0
end
note gapane: type gatx (a <script> line) again so it is on the visible screen, wait for the poller
note to capture it, then read the pane panel: the markup must arrive escaped
fn gapane to bool
if not gatype tline 10
ret false
end
for it ulong 20
x = sleepns 500000000
st = gaget tpane 1
if eq st 200
if gahas tescs
ret not gahas tscr
end
end
end
ret false
end
note ---- the run mode
fn garun to int
gaxbuf
if not gatok
ret 3
end
gachk eq gaget tphealth 0 200 thc01
gachk eq gaget troot 0 403 thc02
gachk eq gaget tpane 0 403 thc03
gachk eq gaget troot 16 403 thc04
z = new uchar 68 48
for i ulong 4
put z i get tqt i
end
gachk eq gareq2 z 403 thc05
for i ulong 64
put z add 4 i get gtok i
end
st = gareq2 z
gachk and eq st 302 eq get gack 0 1 thc06
gachk eq gaget troot 9 400 thc07
gachk eq gaget tpsend 1 405 thc08
gachk gamkses thc09
gachk gagetk thc10
gasett c01
gaform tsessn tline 0
gachk eq gapost 0 403 thc11
gachk eq gapost 1 403 thc12
gachk eq gapost 5 403 thc13
gaform tsessn tline 1
gachk eq gapost 3 403 thc14
gachk eq gasize 0 thc15
gasett c01
gachk gatype tline 10 c01
gasett c02
gachk gatype tline 10 c02
gasett c03
gachk gatype tline 10 c03
gasett c04
gachk gatype tline 10 c04
gasett c05
gachk gatype tline 10 c05
gasett c06
gachk gatype tline 10 c06
gasett c07
gachk gatype tline 10 c07
gasett c08
gachk gatype tline 10 c08
gasett c09
gachk gatype tline 10 c09
gasett c10
gachk gatype tline 10 c10
gasett c11
gachk gatype tline 10 c11
gasett n01
put gatx 4 92
gachk gatype tline 10 thc16
put gatx 0 92
put gatx 1 59
put gatxl 0 2
gachk gatype tline 10 thc17
put gatx 0 98
put gatx 1 115
put gatx 2 92

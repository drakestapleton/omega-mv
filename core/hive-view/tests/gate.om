put gatxl 0 4
gachk gatype tline 10 thc18
for i ulong 4096
put gatx i uchar add 97 rem i 26
end
put gatx 2047 59
put gatx 4095 59
put gatxl 0 4096
gachk gatype tline 10 thc19
put gatxl 0 0
gachk gatype tenter 10 thc20
gachk gatype tescape 27 thc21
gasett tmark
gachk gatype tline 10 thc22
gachk galogok thc23
gachk galogno thc24
for i ulong 4097
put gatx i 120
end
put gatxl 0 4097
gachk garef tline 7 thc25
gasett c01
put gatx 2 1
gachk garef tline 4 thc26
put gatx 2 10
gachk garef tline 4 thc27
put gatx 2 127
gachk garef tline 4 thc28
put gatx 2 255
gachk garef tline 4 thc29
put gatx 1 192
put gatx 2 175
gachk garef tline 4 thc30
put gatx 2 13
gachk garef tline 4 thc31
put gatx 2 9

gachk garef tline 5 thc40
gachk not gakilss thc41
gasinkp
u = unlink gpth 0 get gpl 0
vwsbt tsum
vwsbd get gapass 0
vwsbt tsum2
vwsbd get gafail 0
vwsbt tsum3
gaout
if eq get gafail 0 0
ret 0
end
ret 1
end
note ---- the cpu mode: utime + stime + cutime + cstime (fields 14..17 of /proc/PID/stat)
fn gastat pid ulong to ulong
vwpb
vwpt tproc
vwpd pid
vwpt tstat
r = vwrdall 4096
if lt r 0
ret 0
end
n = get gol 0
p = ulong 0
for i ulong n
if eq get gob i 41
p = i
end
end
f = ulong 2
v = ulong 0
s = ulong 0
for i ulong sub n p
c = get gob add p i
if eq c 32
if and ge f 14 le f 17
s = add s v
end
f = add f 1
v = 0
else
if vwdig c
v = add mul v 10 ulong sub c 48
end
end
end
ret s
end
note gatree: ticks of pid plus its direct children (the poller and the connection handlers)
fn gatree pid ulong to ulong
t = gastat pid
vwpb
vwpt tproc
vwpd pid
vwpt tchild
vwpd pid
vwpt tchild2
r = vwrdall 4096
if lt r 0
ret t
end
n = get gol 0
kids = new ulong 256 0
k = ulong 0
v = ulong 0
for i ulong add n 1
c = uchar 32
if lt i n
c = get gob i
end
if vwdig c
v = add mul v 10 ulong sub c 48
else
if and gt v 0 lt k 256
put kids k v
k = add k 1
end
v = 0
end
end
for i ulong k
t = add t gastat get kids i
end
ret t
end
fn gatmxp to ulong
gatmux
vwka tdisp
vwka tdp
vwka tpid
r = vwrun 5000000000
if ne r 0
ret 0
end
v = ulong 0
for i ulong get gol 0
c = get gob i
if not vwdig c
break
end
v = add mul v 10 ulong sub c 48
end
ret v
end
fn gacpu pid ulong secs ulong to int
tp = gatmxp
a0 = gatree pid
b0 = gastat tp
x = sleepns long mul secs 1000000000
a1 = gatree pid
b1 = gastat tp
da = ulong 0
if gt a1 a0
da = sub a1 a0
end
db = ulong 0
if gt b1 b0
db = sub b1 b0
end
vwsbt tcpu1
vwsbd da
vwsbt tcpu2
vwsbd db
vwsbt tcpu3
vwsbd secs
vwsbt tcpu4
gaout
ret 0
end
text trun "run"
text tcpu "cpu"
fn main to int
if not gahome
ret 6
end
ab = new uchar 512 0
n = argread 1 ab 0 512
if lt argcnt 3
ret 2
end
if heq view part ab 0 ulong hmin ulong n 512 trun
m = argread 2 ab 0 512
put gaport 0 gadec view part ab 0 ulong m
ret garun
end
if heq view part ab 0 ulong hmin ulong n 512 tcpu
if lt argcnt 4
ret 2
end
m = argread 2 ab 0 512
pid = gadec view part ab 0 ulong m
m = argread 3 ab 0 512
secs = gadec view part ab 0 ulong m
ret gacpu pid secs
end
ret 2
end

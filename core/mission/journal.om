fn hashline n ulong to void
buf = new uchar 4096 0
dig = new uchar 32 0
for i ulong n
put buf i get jb i
end
sha256 buf n dig
for i ulong 32
put digest mul i 2 get hx shr get dig i 4
put digest add mul i 2 1 get hx and get dig i 15
end
end
fn jsplit to void
p = ulong 0
q = ulong 0
for i ulong get jn 0
if eq get jb i 124
if or ge q 5 eq p i
die 5
end
put jo q p
put jl q sub i p
q = add q 1
p = add i 1
end
end
if or ne q 5 eq p get jn 0
die 5
end
put jo 5 p
put jl 5 sub get jn 0 p
if not and eq get jl 0 64 eq get jl 5 64
die 5
end
if not and eq get jl 1 1 eq get jl 2 1
die 5
end
for i ulong 64
if ne get jb i get prev i
die 5
end
end

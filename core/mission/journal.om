die 2
end
put jb get jn 0 c
put jn 0 add get jn 0 1
end
fn jhex c uchar to void
jbyte get hx shr c 4
jbyte get hx and c 15
end
fn makeevent st ulong hand bool to void
put jn 0 0
for i ulong 64
jbyte get prev i
end
jbyte 124
if hand
jbyte 72
else
jbyte 83
end
jbyte 124
jbyte uchar add st 48
jbyte 124
for i ulong get mn 0
jhex get mb i
end
jbyte 124
for i ulong get en 0
jhex get eb i
end
jbyte 124
hashline get jn 0
for i ulong 64
jbyte get digest i
end
end
fn append fd int st ulong hand bool to void

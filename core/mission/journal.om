die 2
end
for i ulong get ml f
put wb add get wn 0 i get mb add get mo f i
end
put wn 0 add get wn 0 get ml f
end
fn eprefix off ulong to bool
if gt add off get wn 0 get en 0
ret false
end
for i ulong get wn 0
if ne get wb i get eb add off i
ret false
end
end
ret true
end
fn exact to void
if not and eq get wn 0 get en 0 eprefix 0
die 4
end
end
fn claimwant rel bool to void

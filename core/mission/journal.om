if le r 0
die 6
end
p = add p ulong r
end
if ne fsync fd 0
die 6
end
if ne fclose fd 0
die 6
end
end
fn load_ev ai ulong st ulong to void
loadfile ai
if ge get tn 0 1024
die 2

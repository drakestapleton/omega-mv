put eb i get temp i
end
if gt get en 0 0
if eq get eb sub get en 0 1 10
put en 0 sub get en 0 1
end
end
end
note Pick the latest exact identity claim; later release revokes earlier active row.
fn claimscan rel bool to void
claimwant rel
found = false
p = ulong 0
for i ulong get tn 0
if eq get temp i 10
n = sub i p
if lt n 1024
put en 0 n
for z ulong n
put eb z get temp add p z
end
if and eq n get wn 0 eprefix 0
found = true
else
claimwant not rel
if and eq n get wn 0 eprefix 0
found = false
end
claimwant rel
end
end
p = add i 1
end
end
if ne p get tn 0
die 4
end
if not found
die 4
end
put en 0 get wn 0
for z ulong get wn 0
put eb z get wb z
end
end
fn picktarget ai ulong to ulong
for s ulong get count 0
if target s ai
restore s
ret s
end
end
die 4
ret 0
end

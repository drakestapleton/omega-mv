c = get eb add get wn 0 i
if not and ge c 48 le c 57
die 4
end
n = add mul n 10 ulong sub c 48
end
if or eq n 0 gt n 255
die 4
end
ret
end
if eq st 5
note MUTANT_REVIEWER guard: reviewer must differ from current owner.
if fieldsame 1 2
die 4
end
wclear
wadd verdict0
note MUTANT_HEAD binding: required slice head, never a caller override.
wfield 9
wadd reviewer
wfield 2
exact
ret
end
if eq st 6
publishcheck
ret
end
die 4
end
fn publishcheck to void
p = ulong 0

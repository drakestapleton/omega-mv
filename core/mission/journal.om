for i ulong 64
if ne get jb add get jo 5 i get digest i
die 5
end
end
if or ne rem get jl 3 2 0 ne rem get jl 4 2 0
die 5
end
put mn 0 div get jl 3 2
put en 0 div get jl 4 2
if or ge get mn 0 1024 ge get en 0 1024
die 5
end
for i ulong get mn 0
put mb i jdecode add get jo 3 mul i 2
end
for i ulong get en 0
put eb i jdecode add get jo 4 mul i 2
end
end
fn jdecode pos ulong to uchar
a = hexval get jb pos
b = hexval get jb add pos 1
ret uchar add mul a 16 b
end
note Compare immutable snapshot bytes, allowing only owner to change for resume.
fn sameprior slot ulong hand bool newhead bool to void
p = mul slot 1024
q = ulong 0
f = ulong 0
for i ulong get slen slot
c = get saved add p i
if and hand eq f 1
if eq c 124
q = add get mo 1 get ml 1
else
continue
end
end
if and newhead eq f 9
if ne c 124
q = add q 1
continue
end
end
if ge q get mn 0
die 5
end
if ne c get mb q
die 5
end
if eq c 124
f = add f 1
end
q = add q 1
end
if ne q get mn 0
die 5
end
end
fn handevidence slot ulong to void
note Snapshot holds released old claim then active new claim; only exact rows.
claimwant false
n = get wn 0
if lt get en 0 add n 1
die 4
end
off = sub get en 0 n
if not eprefix off
die 4
end
if ne get eb sub off 1 10
die 4
end
newbuf = new uchar 1024 0
newlen = get mn 0
for i ulong newlen
put newbuf i get mb i
end
restore slot
claimwant true
if ne get wn 0 sub off 1
die 4
end
if not eprefix 0
die 4
end
for i ulong newlen
put mb i get newbuf i
end
put mn 0 newlen
msplits
end
fn fold to void
validate
st = ulong sub get jb get jo 2 48
if or lt st 1 gt st 6
die 5
end
ev = get jb get jo 1
s = findslot
if eq s 128
if or ne st 1 ne ev 83
die 5
end
s = get count 0
if ge s 128
die 5
end
put count 0 add s 1
evidence st
else
if eq ev 72
if or lt st 2 gt st 4
die 5
end
if ne st get states s
die 5
end
sameprior s true false
handevidence s
else
if ne ev 83
die 5
end
note MUTANT_ORDER guard: no skipped state.
if ne st add get states s 1
die 5
end
sameprior s false eq st 4
evidence st
end
end
savem s
put states s st
put jb get jn 0 10
hashline add get jn 0 1
for i ulong 64
put prev i get digest i
end
end
fn replay fd int to void
put count 0 0
for i ulong 64
put prev i get zero i
end
put jn 0 0
r = fseek fd 0 0
if lt r 0
die 6
end
bytes = ulong 0
while true bound 1048577
r = read fd jb get jn 0 1
if lt r 0
die 6
end
if eq r 0
break
end
bytes = add bytes 1
if gt bytes 1048576
die 2
end
if eq get jb get jn 0 10
jsplit
fold
put jn 0 0
else
put jn 0 add get jn 0 1
if ge get jn 0 4095
die 5
end
end
end
if ne get jn 0 0
die 5
end
end
fn openjournal editmode bool to int
flags = int 131072
if editmode
flags = 132162
end
fd = fopen args 1024 get alen 2 flags 384
if lt fd 0
die 6
end
op = int 1
if editmode
op = 2
end
if ne flock int fd op 0
die 6
end
replay int fd
ret int fd
end
fn jbyte c uchar to void

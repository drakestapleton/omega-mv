note SPDX-License-Identifier: Apache-2.0
note A piece shorter than the native prefill minimum costs one decode pass per token.
fn pf_work n ulong chunk ulong min ulong to ulong
if lt n min
ret n
end
if ne rem n chunk 0
ret add div n chunk 1
end
ret div n chunk
end
note Preserve short decode pieces; otherwise choose the latest batched cut without extra passes.
note Zero means no checkpoint. All-ones means invalid arguments.
fn native_pfcut from ulong header ulong total ulong chunk ulong min ulong to ulong
if or eq min 0 gt min 16384
ret 18446744073709551615
end
if or lt chunk mul min 2 gt chunk 32768
ret 18446744073709551615
end
if or gt from header ge header total
ret 18446744073709551615
end
note Preserve the original scalar-decode versus batched-prefill arithmetic for short pieces.
if lt sub total header min
ret header
end
if and gt sub header from 0 lt sub header from min
ret header
end
whole = pf_work sub total from chunk min
left = pf_work sub header from chunk min
right = pf_work sub total header chunk min
if le add left right whole
ret header
end
ret add from mul div sub header from chunk chunk
end

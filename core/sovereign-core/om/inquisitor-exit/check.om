om2
note om/inquisitor-exit/check.om: exit-status contract of spark-inquisitor, report format 2 (DRA-99).
note Usage: check BIN DIR. BIN is a built spark-inquisitor, DIR an existing writable scratch directory.
note Each case writes a diff into DIR, runs BIN on it with stdout and stderr in DIR/CASE.out, and checks
note the exit status and the output. Style findings (dash, buzzword) are advisory: exit 0, finding printed.
note A planted GitHub token or AWS key, or a .env file, blocks: exit 1, and the token is never echoed.
note Secrets and dash bytes are assembled at run time, so this file holds neither.
note Prints PASS NAME or FAIL NAME per case, then INQEXIT PASS cases=N or INQEXIT FAIL cases=N fail=K.
note Exit 0 every case as expected, 1 a case failed, 2 usage, 3 a host call failed.
text tpass "PASS "
text tfail "FAIL "
text tnl "\n"
text tsum "INQEXIT "
text tok1 "PASS cases="
text tbad "FAIL cases="
text tfl " fail="
text tusage "usage: check BIN DIR\n"
text thost "check: host call failed\n"
text tslash "/"
text areview "review"
text aaudit "audit"
text aauthor "--author"
text auser "check"
text apr "--pr"
text anum "1"
text adiff "--diff"
text hgit "diff --git a/"
text hb " b/"
text hplus "+"
text hci "ci.sh"
text hexport "export GH_TOKEN="
text hrs "src/key.rs"
text hconst "const KEY: &str = \""
text hq "\";"
text henv "deploy/.env.local"
text hnew "new file mode 100644\n--- /dev/null\n+++ b/deploy/.env.local\n@@ -0,0 +1 @@\n+PORT=8080\n"
text hlib "src/lib.rs"
text hnote "// note "
text hdashx " the dash is style only"
text hgame "// a game-changer helper"
text hclean "pub fn ok() -> bool { true }"
text gp1 "gh"
text gp2 "p_"
text gp3 "Zz9Yy8Xx7Ww6Vv5Uu4Tt3Ss2Rr1Qq0Pp9Oo8"
text ak1 "AK"
text ak2 "IA"
text ak3 "QWERTYUIOPASDFGH"
text mgh "Plaintext GitHub Personal Access Token detected"
text maws "Plaintext AWS Access Key detected"
text menv ".env secret file"
text mfail "Doctrine Diff Audit: FAILED"
text mdash "Em/En dash detected"
text madv "Doctrine Diff Audit: PASS (style advisories)"
text mgame "game-changer"
text mfmt "spark-inquisitor-report/2"
text mpass "Doctrine Diff Audit: PASS"
text maudok "passed critical security invariants"
text mclean "Diff is clean"
text mafail "Doctrine audit failed"
text mred "[line redacted: it contains a plaintext secret]"
text c1 "token-review-blocks"
text c2 "aws-key-audit-blocks"
text c3 "env-file-review-blocks"
text c4 "dash-only-review-passes-and-prints"
text c5 "dash-only-audit-passes-and-prints"
text c6 "buzzword-only-review-passes"
text c7 "clean-review-passes"
text c8 "secret-with-dash-review-blocks"
text f1 "t1"
text f2 "t2"
text f3 "t3"
text f4 "t4"
text f5 "t5"
text f6 "t6"
text f7 "t7"
text f8 "t8"
text sdiff ".diff"
text sout ".out"
global bin uchar 2048
global binl ulong 1
global dir uchar 2048
global dirl ulong 1
global pth uchar 4096
global pthl ulong 1
global opth uchar 4096
global opl ulong 1
global fx uchar 8192
global fxl ulong 1
global tok uchar 128
global tokl ulong 1
global pkt uchar 4096
global pktl ulong 1
global obuf uchar 262144
global obl ulong 1
global st uchar 4
global cnt ulong 2
global nb uchar 32
global nfail ulong 1

fn fxadd t view uchar * to void
n = get fxl 0
for i ulong len t
put fx add n i get t i
end
put fxl 0 add n len t
ret
end

fn fxdash to void
n = get fxl 0
put fx n uchar 226
put fx add n 1 uchar 128
put fx add n 2 uchar 148
put fxl 0 add n 3
ret
end

fn fxtok to void
n = get fxl 0
t = get tokl 0
for i ulong t
put fx add n i get tok i
end
put fxl 0 add n t
ret
end

fn tokadd t view uchar * to void
n = get tokl 0
for i ulong len t
put tok add n i get t i
end
put tokl 0 add n len t
ret
end

fn fxhead name view uchar * to void
put fxl 0 0
fxadd hgit
fxadd name
fxadd hb
fxadd name
fxadd tnl
ret
end

fn dpath name view uchar * to void
n = get dirl 0
for i ulong n
put pth i get dir i
end
put pth n get tslash 0
n = add n 1
for i ulong len name
put pth add n i get name i
end
n = add n len name
for i ulong len sdiff
put pth add n i get sdiff i
end
put pthl 0 add n len sdiff
ret
end

fn opath name view uchar * to void
n = get dirl 0
for i ulong n
put opth i get dir i
end
put opth n get tslash 0
n = add n 1
for i ulong len name
put opth add n i get name i
end
n = add n len name
for i ulong len sout
put opth add n i get sout i
end
put opl 0 add n len sout
ret
end

fn fxwr to long
fd = fopen pth 0 get pthl 0 577 420
if lt fd 0
ret fd
end
n = get fxl 0
k = write int fd fx 0 n
r = fclose int fd
if ne k long n
ret -1
end
ret 0
end

fn pkhdr to void
n = get pktl 0
c = add get cnt 1 1
put cnt 1 c
put pkt 0 uchar and c 255
put pkt 1 uchar shr c 8
ret
end

fn pkadd t view uchar * to void
n = get pktl 0
m = len t
put pkt n uchar and m 255
put pkt add n 1 uchar shr m 8
n = add n 2
for i ulong m
put pkt add n i get t i
end
put pktl 0 add n m
pkhdr
ret
end

fn pkbin to void
n = get pktl 0
m = get binl 0
put pkt n uchar and m 255
put pkt add n 1 uchar shr m 8
n = add n 2
for i ulong m
put pkt add n i get bin i
end
put pktl 0 add n m
pkhdr
ret
end

fn pkpth to void
n = get pktl 0
m = get pthl 0
put pkt n uchar and m 255
put pkt add n 1 uchar shr m 8
n = add n 2
for i ulong m
put pkt add n i get pth i
end
put pktl 0 add n m
pkhdr
ret
end

fn pkstart to void
put pktl 0 2
put cnt 1 0
pkbin
ret
end

fn pkreview to void
pkstart
pkadd areview
pkadd aauthor
pkadd auser
pkadd apr
pkadd anum
pkadd adiff
pkpth
ret
end

fn pkaudit to void
pkstart
pkadd aaudit
pkadd adiff
pkpth
ret
end

note run: fork, child sends stdout and stderr to opth and executes the packet; returns the exit
note status 0..255, or -1 when the child died by a signal, or -2 when a host call failed.
fn run to long
pid = fork
if lt pid 0
ret -2
end
if eq pid 0
fd = fopen opth 0 get opl 0 577 420
if lt fd 0
exit 126
end
r = dupfd int fd 1 0
r = dupfd int fd 2 0
r = execprog pkt 0 get pktl 0
exit 127
end
r = waitpid int pid st 0 4 0
if ne r pid
ret -2
end
if ne get st 0 0
ret -1
end
ret long get st 1
end

fn rdout to long
put obl 0 0
fd = fopen opth 0 get opl 0 0 0
if lt fd 0
ret fd
end
n = ulong 0
c = true
while c bound 262145
k = read int fd obuf n sub len obuf n
if lt k 0
r = fclose int fd
ret k
end
if eq k 0
c = false
else
n = add n ulong k
if eq n len obuf
c = false
end
end
end
r = fclose int fd
put obl 0 n
ret 0
end

fn matchat i ulong t view uchar * to bool
for j ulong len t
if ne get obuf add i j get t j
ret false
end
end
ret true
end

fn has t view uchar * to bool
n = get obl 0
if lt n len t
ret false
end
m = add sub n len t 1
for i ulong m
if matchat i t
ret true
end
end
ret false
end

fn attok i ulong to bool
t = get tokl 0
for j ulong t
if ne get obuf add i j get tok j
ret false
end
end
ret true
end

fn hastok to bool
n = get obl 0
t = get tokl 0
if lt n t
ret false
end
m = add sub n t 1
for i ulong m
if attok i
ret true
end
end
ret false
end

fn pnum v ulong to void
n = ulong 0
x = v
c = true
while c bound 32
put nb sub 31 n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
c = false
end
end
k = write 1 nb sub 32 n n
ret
end

fn rep name view uchar * ok bool to void
put cnt 0 add get cnt 0 1
if ok
k = write 1 tpass 0 len tpass
else
k = write 1 tfail 0 len tfail
put nfail 0 add get nfail 0 1
end
k = write 1 name 0 len name
k = write 1 tnl 0 len tnl
ret
end

note go: write the fixture to DIR/F.diff, run the prepared argument kind, read DIR/F.out.
note kind 0 is review, 1 is audit. Returns the exit status, or -3 when a host call failed.
fn go f view uchar * kind ulong to long
dpath f
opath f
r = fxwr
if ne r 0
ret -3
end
if eq kind 0
pkreview
else
pkaudit
end
rc = run
if lt rc -1
ret -3
end
r = rdout
if ne r 0
ret -3
end
ret rc
end

fn tokgh to void
put tokl 0 0
tokadd gp1
tokadd gp2
tokadd gp3
ret
end

fn tokaws to void
put tokl 0 0
tokadd ak1
tokadd ak2
tokadd ak3
ret
end

fn case1 to long
tokgh
fxhead hci
fxadd hplus
fxadd hexport
fxtok
fxadd tnl
rc = go f1 0
if eq rc -3
ret 3
end
ok = eq rc 1
if eq has mgh false
ok = false
end
if eq has mfail false
ok = false
end
if hastok
ok = false
end
rep c1 ok
ret 0
end

fn case2 to long
tokaws
fxhead hrs
fxadd hplus
fxadd hconst
fxtok
fxadd hq
fxadd tnl
rc = go f2 1
if eq rc -3
ret 3
end
ok = eq rc 1
if eq has maws false
ok = false
end
if eq has mafail false
ok = false
end
if hastok
ok = false
end
rep c2 ok
ret 0
end

fn case3 to long
fxhead henv
fxadd hnew
rc = go f3 0
if eq rc -3
ret 3
end
ok = eq rc 1
if eq has menv false
ok = false
end
if eq has mfail false
ok = false
end
rep c3 ok
ret 0
end

fn dashfx to void
fxhead hlib
fxadd hplus
fxadd hnote
fxdash
fxadd hdashx
fxadd tnl
ret
end

fn case4 to long
dashfx
rc = go f4 0
if eq rc -3
ret 3
end
ok = eq rc 0
if eq has mdash false
ok = false
end
if eq has madv false
ok = false
end
if eq has mfmt false
ok = false
end
if has mfail
ok = false
end
rep c4 ok
ret 0
end

fn case5 to long
dashfx
rc = go f5 1
if eq rc -3
ret 3
end
ok = eq rc 0
if eq has mdash false
ok = false
end
if eq has maudok false
ok = false
end
if has mafail
ok = false
end
rep c5 ok
ret 0
end

fn case6 to long
fxhead hlib
fxadd hplus
fxadd hgame
fxadd tnl
rc = go f6 0
if eq rc -3
ret 3
end
ok = eq rc 0
if eq has mgame false
ok = false
end
if eq has madv false
ok = false
end
rep c6 ok
ret 0
end

fn case7 to long
fxhead hlib
fxadd hplus
fxadd hclean
fxadd tnl
rc = go f7 0
if eq rc -3
ret 3
end
ok = eq rc 0
if eq has mpass false
ok = false
end
if has madv
ok = false
end
if has mfail
ok = false
end
rep c7 ok
ret 0
end

fn case8 to long
tokgh
fxhead hci
fxadd hplus
fxadd hexport
fxtok
fxadd hnote
fxdash
fxadd tnl
rc = go f8 0
if eq rc -3
ret 3
end
ok = eq rc 1
if eq has mgh false
ok = false
end
if eq has mdash false
ok = false
end
if eq has mred false
ok = false
end
if hastok
ok = false
end
rep c8 ok
ret 0
end

fn main to int
if ne argcnt 3
k = write 2 tusage 0 len tusage
ret 2
end
n = argread 1 bin 0 len bin
if le n 0
k = write 2 tusage 0 len tusage
ret 2
end
put binl 0 ulong n
n = argread 2 dir 0 len dir
if le n 0
k = write 2 tusage 0 len tusage
ret 2
end
put dirl 0 ulong n
put cnt 0 0
put nfail 0 0
r = add case1 case2
r = add r case3
r = add r case4
r = add r case5
r = add r case6
r = add r case7
r = add r case8
if ne r 0
k = write 2 thost 0 len thost
ret 3
end
k = write 1 tsum 0 len tsum
nf = get nfail 0
if eq nf 0
k = write 1 tok1 0 len tok1
pnum get cnt 0
k = write 1 tnl 0 len tnl
ret 0
end
k = write 1 tbad 0 len tbad
pnum get cnt 0
k = write 1 tfl 0 len tfl
pnum nf
k = write 1 tnl 0 len tnl
ret 1
end

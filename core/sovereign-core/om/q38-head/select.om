note SPDX-License-Identifier: Apache-2.0
note Exact-head candidate policy, core issue710. No allocation or device calls.
note Contract: c[i] >= ||W[i]-Q[i]|| + rounding allowances for BOTH actual dots.
note Coefficients must be upward-rounded and bound the supplied compact scores.
note This unit does not establish coefficient provenance or quantizer correctness.
note h is the same normalized vector used by both heads. Only rows below count
note are read or written. All input validation precedes any output mutation.
note Binary32 values convert exactly to binary64. Squares are exact in binary64;
note sum, sqrt, product and interval endpoints are rounded outward one ulp.
note Thus tau=max(lower) and upper>=tau retain every possible full-head winner.
note Recheck kept rows with the original full-head arithmetic, first index on ties.

fn up x f64 to f64
bits = bitcast ulong x
if eq and bits 9223372036854775807 0
ret bitcast f64 ulong 1
end
if ne and bits 9223372036854775808 0
ret bitcast f64 sub bits 1
end
ret bitcast f64 add bits 1
end

fn finite x f32 to bool
ret lt and bitcast uint x 2147483647 2139095040
end

fn normup h view f32 5120 to f64
total = f64 0.0
for i ulong 5120
x = get h i
if not finite x
trap 5
end
y = f64 x
if ne y 0.0
total = up add total mul y y
end
end
if eq total 0.0
ret 0.0
end
ret up fsqrt total
end

fn validate s view f32 248320 c view f32 248320 count ulong to void
for i ulong count
if not finite get s i
trap 5
end
v = get c i
if not finite v
trap 5
end
if lt v 0.0
trap 5
end
end
end

fn radius coef f32 hn f64 to f64
if or eq coef 0.0 eq hn 0.0
ret 0.0
end
ret up mul f64 coef hn
end

fn lower score f32 coef f32 hn f64 to f64
b = radius coef hn
if eq b 0.0
ret f64 score
end
ret neg up neg sub f64 score b
end

fn upper score f32 coef f32 hn f64 to f64
b = radius coef hn
if eq b 0.0
ret f64 score
end
ret up add f64 score b
end

fn thresh s view f32 248320 c view f32 248320 count ulong hn f64 to f64
tau = lower get s 0 get c 0 hn
for i ulong count
v = lower get s i get c i hn
if gt v tau
tau = v
end
end
ret tau
end

fn publish s view f32 248320 c view f32 248320 mask edit uchar 248320 count ulong hn f64 tau f64 to ulong
kept = ulong 0
for i ulong count
take = ge upper get s i get c i hn tau
if take
put mask i 1
kept = add kept 1
else
put mask i 0
end
end
ret kept
end

fn q38select h view f32 5120 s view f32 248320 c view f32 248320 mask edit uchar 248320 count ulong to ulong
if or eq count 0 gt count 248320
trap 5
end
validate s c count
hn = normup h
tau = thresh s c count hn
ret publish s c mask count hn tau
end

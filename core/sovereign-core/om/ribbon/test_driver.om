note SPDX-License-Identifier: Apache-2.0
note Test transport appended to pipeline.om. Fixed little-endian u64 requests and replies.
fn unpack a view uchar 64 j ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get a add mul j 8 i uint mul i 8
end
ret v
end

fn pack a edit uchar 72 j ulong v ulong to void
for i ulong 8
put a add mul j 8 i uchar and shr v uint mul i 8 255
end
end

fn main to int
st = new ulong 4096 0
q = new ulong 8 0
ans = new ulong 8 0
inb = new uchar 64 0
outb = new uchar 72 0
for turn ulong 1000000
n = ulong 0
while lt n 64 bound 64
k = read 0 inb n sub 64 n
if lt k 0
ret 2
end
if eq k 0
if eq n 0
ret 0
end
ret 2
end
n = add n ulong k
end
for i ulong 8
put q i unpack inb i
end
rc = pipeline st q ans
pack outb 0 rc
for i ulong 8
pack outb add i 1 get ans i
end
n = ulong 0
while lt n 72 bound 72
k = write 1 outb n sub 72 n
if le k 0
ret 3
end
n = add n ulong k
end
end
ret 4
end

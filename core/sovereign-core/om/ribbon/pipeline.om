note SPDX-License-Identifier: Apache-2.0
note Known-demand ribbon control, sc#631. Pure policy, no host/GPU operation is hidden here.
note The caller serializes calls and executes only the returned actions. Read completion means
note complete bytes AND digest/layout verification; copy completion means device visibility fence.
note No prediction changes the demanded expert key. Tickets carry nonrepeating generations.
note State: header[0..7] = magic, capacity, next generation, byte budget, buffer budget,
note charged bytes, charged buffers, shutdown. Entries at 16+slot*12:
note phase,key,generation,bytes,deadline,pins,buffer-owner,sequence,0,0,0,0.
note phase: 0 free,1 queued,2 reading,3 verified,4 copying,5 ready,8 failed.
note owner: 0 none,1 read/verify,2 ready-for-copy/copy. A failed in-flight operation
note keeps its buffer until its matching completion arrives. Cancellation never frees live memory.
note Request[0..7] = op,ticket-or-key,bytes,deadline,verified-or-capacity,unused,now,unused.
note op 1 init (1 capacity,2 budget bytes,3 buffers);2 enqueue;3 next read;4 read complete;
note 5 next copy;6 copy complete;7 pin;8 release;9 evict;10 cancel;11 shutdown;12 tick;13 inspect.
note Result: 0 success,1 no action,2 invalid,3 stale,4 full,5 wrong phase/pinned,6 stopped,
note 7 deadline,8 generation exhausted. Reply[0..7] = ticket,key,bytes,deadline,phase,pins,bytes,buffers.

fn base slot ulong to ulong
ret add 16 mul slot 12
end

fn valid st view ulong 4096 ticket ulong to bool
i = rem ticket 64
if ge i get st 1
ret false
end
b = base i
ret and ne get st b 0 eq get st add b 2 div ticket 64
end

fn releasebuf st edit ulong 4096 b ulong to void
if ne get st add b 6 0
put st 5 sub get st 5 get st add b 3
put st 6 sub get st 6 1
put st add b 6 0
end
end

fn expire st edit ulong 4096 now ulong to void
for i ulong 64
if lt i get st 1
b = base i
p = get st b
if and and ne p 0 ne p 8 ge now get st add b 4
put st b 8
note Verified has no in-flight reader or copier. It can release staging immediately.
if eq p 3
releasebuf st b
end
end
end
end
end

fn describe st view ulong 4096 i ulong out edit ulong 8 to void
b = base i
put out 0 add mul get st add b 2 64 i
put out 1 get st add b 1
put out 2 get st add b 3
put out 3 get st add b 4
put out 4 get st b
put out 5 get st add b 5
put out 6 get st 5
put out 7 get st 6
end

fn enqueue st edit ulong 4096 q view ulong 8 out edit ulong 8 to ulong
if ne get st 7 0
ret 6
end
if or eq get q 2 0 gt get q 2 get st 3
ret 2
end
if le get q 3 get q 6
ret 7
end
note A duplicate key keeps its original deadline and identity. No new reservation.
for i ulong 64
if lt i get st 1
b = base i
if and ne get st b 0 eq get st add b 1 get q 1
if ne get st add b 3 get q 2
ret 2
end
if eq get st b 8
ret 5
end
describe st i out
ret 0
end
end
end
if ge get st 2 288230376151711743
ret 8
end
for i ulong 64
if lt i get st 1
b = base i
if eq get st b 0
put st 2 add get st 2 1
put st b 1
put st add b 1 get q 1
put st add b 2 get st 2
put st add b 3 get q 2
put st add b 4 get q 3
put st add b 5 0
put st add b 6 0
put st add b 7 get st 2
describe st i out
ret 0
end
end
end
ret 4
end

fn nextread st edit ulong 4096 out edit ulong 8 to ulong
if ne get st 7 0
ret 6
end
if ge get st 6 get st 4
ret 1
end
best = ulong 64
seq = ulong 18446744073709551615
for i ulong 64
if lt i get st 1
b = base i
if eq get st b 1
if lt get st add b 7 seq
best = i
seq = get st add b 7
end
end
end
end
if eq best 64
ret 1
end
b = base best
n = get st add b 3
if gt n sub get st 3 get st 5
ret 1
end
put st b 2
put st add b 6 1
put st 5 add get st 5 n
put st 6 add get st 6 1
describe st best out
ret 0
end

fn nextcopy st edit ulong 4096 out edit ulong 8 to ulong
if ne get st 7 0
ret 6
end
best = ulong 64
seq = ulong 18446744073709551615
for i ulong 64
if lt i get st 1
b = base i
if eq get st b 3
if lt get st add b 7 seq
best = i
seq = get st add b 7
end
end
end
end
if eq best 64
ret 1
end
put st base best 4
describe st best out
ret 0
end

fn complete st edit ulong 4096 q view ulong 8 out edit ulong 8 to ulong
if not valid st get q 1
ret 3
end
i = rem get q 1 64
b = base i
p = get st b
want = ulong 2
if eq get q 0 6
want = 4
end
if eq p 8
owner = ulong 1
if eq want 4
owner = 2
end
if ne get st add b 6 owner
ret 5
end
releasebuf st b
describe st i out
ret 0
end
if ne p want
ret 5
end
if ne get q 4 1
put st b 8
releasebuf st b
else
if eq want 2
put st b 3
put st add b 6 2
else
put st b 5
releasebuf st b
end
end
describe st i out
ret 0
end

fn control st edit ulong 4096 q view ulong 8 out edit ulong 8 to ulong
if not valid st get q 1
ret 3
end
i = rem get q 1 64
b = base i
p = get st b
op = get q 0
if eq op 7
if ne p 5
ret 5
end
if eq get st add b 5 18446744073709551615
ret 4
end
put st add b 5 add get st add b 5 1
else
if eq op 8
if eq get st add b 5 0
ret 5
end
put st add b 5 sub get st add b 5 1
else
if eq op 9
if or ne get st add b 5 0 ne get st add b 6 0
ret 5
end
if not or eq p 5 eq p 8
ret 5
end
put st b 0
else
if eq op 10
if eq p 3
releasebuf st b
end
put st b 8
else
if ne op 13
ret 2
end
end
end
end
end
describe st i out
ret 0
end

fn pipeline st edit ulong 4096 q view ulong 8 out edit ulong 8 to ulong
for i ulong 8
put out i 0
end
op = get q 0
if eq op 1
if or eq get q 1 0 gt get q 1 64
ret 2
end
if or eq get q 2 0 or eq get q 3 0 gt get q 3 2
ret 2
end
note A live instance cannot be reset and forget outstanding buffer or GPU ownership.
gen = ulong 0
if eq get st 0 631
gen = get st 2
for i ulong 64
if lt i get st 1
if ne get st base i 0
ret 5
end
end
end
end
for i ulong 4096
put st i 0
end
put st 0 631
put st 1 get q 1
put st 2 gen
put st 3 get q 2
put st 4 get q 3
ret 0
end
if ne get st 0 631
ret 2
end
expire st get q 6
if eq op 2
ret enqueue st q out
end
if eq op 3
ret nextread st out
end
if eq op 5
ret nextcopy st out
end
if or eq op 4 eq op 6
ret complete st q out
end
if eq op 11
put st 7 1
for i ulong 64
if lt i get st 1
b = base i
p = get st b
if ne p 0
if eq p 3
releasebuf st b
end
put st b 8
end
end
end
ret 0
end
if eq op 12
ret 0
end
ret control st q out
end

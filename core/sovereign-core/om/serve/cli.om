note SPDX-License-Identifier: Apache-2.0
note core/sovereign-core/om/serve/cli.om
note Pure OM-2 conversion of aien-cli subcommand & flag dispatcher.
note Parses subcommands (serve, chat, models, health, version) and validates flags
note (--port 1..65535, --max-tokens 1..4096, --model NAME) fail-closed.

const CLI_OK ulong 0
const CLI_ERR_EMPTY ulong 1
const CLI_ERR_UNKNOWN_CMD ulong 2
const CLI_ERR_UNKNOWN_FLAG ulong 3
const CLI_ERR_MISSING_VAL ulong 4
const CLI_ERR_BAD_PORT ulong 5
const CLI_ERR_BAD_MAX_TOKENS ulong 6
const CLI_ERR_MISSING_MODEL ulong 7
const CLI_ERR_DUP_FLAG ulong 8
const CLI_ERR_TOO_MANY_ARGS ulong 9

const CLI_CMD_NONE ulong 0
const CLI_CMD_SERVE ulong 1
const CLI_CMD_CHAT ulong 2
const CLI_CMD_MODELS ulong 3
const CLI_CMD_HEALTH ulong 4
const CLI_CMD_VERSION ulong 5

note Parsed CLI state:
note [0]=cmd, [1]=port, [2]=max_tokens, [3]=has_port, [4]=has_max_tokens, [5]=has_model, [6]=model_len, [7]=argc
global cli_state ulong 8
global cli_model uchar 64
global cli_arg_off ulong 16
global cli_arg_len ulong 16

text cli_s_serve "serve"
text cli_s_chat "chat"
text cli_s_models "models"
text cli_s_health "health"
text cli_s_version "version"
text cli_f_port "--port"
text cli_f_maxt "--max-tokens"
text cli_f_model "--model"

fn cli_reset to void
for i ulong 8
put cli_state i 0
end
put cli_state 1 8080
put cli_state 2 512
for i ulong 64
put cli_model i uchar 0
end
for i ulong 16
put cli_arg_off i 0
put cli_arg_len i 0
end
end

fn cli_cmd to ulong
ret get cli_state 0
end

fn cli_port to ulong
ret get cli_state 1
end

fn cli_max_tokens to ulong
ret get cli_state 2
end

fn cli_model_len to ulong
ret get cli_state 6
end

fn cli_tok_eq line view uchar * idx ulong lit view uchar * to bool
off = get cli_arg_off idx
tlen = get cli_arg_len idx
if ne tlen len lit
ret false
end
for i ulong tlen bound 64
if ne get line add off i get lit i
ret false
end
end
ret true
end

fn cli_tok_u64 line view uchar * idx ulong to ulong
off = get cli_arg_off idx
tlen = get cli_arg_len idx
if or eq tlen 0 gt tlen 10
ret 18446744073709551615
end
acc = ulong 0
for i ulong tlen bound 16
b = get line add off i
if or lt b uchar 48 gt b uchar 57
ret 18446744073709551615
end
acc = add mul acc 10 ulong sub b uchar 48
end
ret acc
end

note Split whitespace-delimited arguments into cli_arg_off / cli_arg_len.
fn cli_tokenize line view uchar * to ulong
n = len line
argc = ulong 0
i = ulong 0
while lt i n bound 512
while lt i n bound 512
b = get line i
if or eq b uchar 32 eq b uchar 9
i = add i 1
else
break
end
end
if ge i n
break
end
if ge argc 16
ret CLI_ERR_TOO_MANY_ARGS
end
start = i
while lt i n bound 512
b = get line i
if or eq b uchar 32 eq b uchar 9
break
end
i = add i 1
end
put cli_arg_off argc start
put cli_arg_len argc sub i start
argc = add argc 1
end
put cli_state 7 argc
ret CLI_OK
end

note Parse and validate a CLI command line fail-closed.
fn cli_dispatch line view uchar * to ulong
cli_reset
tst = cli_tokenize line
if ne tst CLI_OK
ret tst
end
argc = get cli_state 7
if eq argc 0
ret CLI_ERR_EMPTY
end
cmd = CLI_CMD_NONE
if cli_tok_eq line 0 cli_s_serve
cmd = CLI_CMD_SERVE
else
if cli_tok_eq line 0 cli_s_chat
cmd = CLI_CMD_CHAT
else
if cli_tok_eq line 0 cli_s_models
cmd = CLI_CMD_MODELS
else
if cli_tok_eq line 0 cli_s_health
cmd = CLI_CMD_HEALTH
else
if cli_tok_eq line 0 cli_s_version
cmd = CLI_CMD_VERSION
end
end
end
end
end
if eq cmd CLI_CMD_NONE
ret CLI_ERR_UNKNOWN_CMD
end
put cli_state 0 cmd
idx = ulong 1
while lt idx argc bound 16
if cli_tok_eq line idx cli_f_port
if ne get cli_state 3 0
ret CLI_ERR_DUP_FLAG
end
if ge add idx 1 argc
ret CLI_ERR_MISSING_VAL
end
p = cli_tok_u64 line add idx 1
if or eq p 0 or gt p 65535 eq p 18446744073709551615
ret CLI_ERR_BAD_PORT
end
put cli_state 1 p
put cli_state 3 1
idx = add idx 2
continue
end
if cli_tok_eq line idx cli_f_maxt
if ne get cli_state 4 0
ret CLI_ERR_DUP_FLAG
end
if ge add idx 1 argc
ret CLI_ERR_MISSING_VAL
end
mt = cli_tok_u64 line add idx 1
if or eq mt 0 or gt mt 4096 eq mt 18446744073709551615
ret CLI_ERR_BAD_MAX_TOKENS
end
put cli_state 2 mt
put cli_state 4 1
idx = add idx 2
continue
end
if cli_tok_eq line idx cli_f_model
if ne get cli_state 5 0
ret CLI_ERR_DUP_FLAG
end
if ge add idx 1 argc
ret CLI_ERR_MISSING_VAL
end
moff = get cli_arg_off add idx 1
mlen = get cli_arg_len add idx 1
if or eq mlen 0 gt mlen 64
ret CLI_ERR_MISSING_MODEL
end
for k ulong mlen bound 64
put cli_model k get line add moff k
end
put cli_state 5 1
put cli_state 6 mlen
idx = add idx 2
continue
end
ret CLI_ERR_UNKNOWN_FLAG
end
if and eq cmd CLI_CMD_CHAT eq get cli_state 5 0
ret CLI_ERR_MISSING_MODEL
end
ret CLI_OK
end

note SPDX-License-Identifier: Apache-2.0
note core/sovereign-core/om/serve/e2e_test.om
note Integrated pure-Omega host runtime/CLI end-to-end test: composes kv_cache, scheduler,
note http_auth, router, cli, sha256, kv_store, and closure verification in one unit.
note Compose with:
note   si/directives/om2.om core/sovereign-core/om/scheduler/kv_cache.om
note   core/sovereign-core/om/scheduler/scheduler.om core/sovereign-core/om/serve/http_auth.om
note   core/sovereign-core/om/serve/router.om core/sovereign-core/om/serve/cli.om
note   om/tls/sha2.om core/sovereign-core/om/store/closure.om
note   core/sovereign-core/om/serve/e2e_test.om

text e2_pass "PASS "
text e2_fail "FAIL "
text e2_nl "\n"
text e2_ok "SOVEREIGN-CORE INTEGRATED RUNTIME E2E PASS\n"
text e2_bad "SOVEREIGN-CORE INTEGRATED RUNTIME E2E FAIL\n"
text e2_n1 "integrated_cli_auth_router_kv_closure_pos"
text e2_n2 "integrated_negative_unauth_smuggling_bad_cli"

text e2_tok "omega_sovereign_core_e2e_token_42"
text e2_cli_ok "serve --port 18091 --max-tokens 2048 --model qwen-native-om"
text e2_cli_bad "serve --port 0"
text e2_req_chat "POST /v1/chat/completions HTTP/1.1\nHost: localhost\nAuthorization: Bearer omega_sovereign_core_e2e_token_42\nContent-Length: 71\n\n{\"model\":\"qwen-native-om\",\"messages\":[{\"role\":\"user\"}],\"max_tokens\":64}"
text e2_req_noauth "POST /v1/chat/completions HTTP/1.1\nHost: localhost\nContent-Length: 71\n\n{\"model\":\"qwen-native-om\",\"messages\":[{\"role\":\"user\"}],\"max_tokens\":64}"
text e2_req_smug "POST /v1/chat/completions HTTP/1.1\nTransfer-Encoding: chunked\nAuthorization: Bearer omega_sovereign_core_e2e_token_42\n\n0\n\n"

global e2_fails ulong 1

fn e2_w s view uchar * to void
n = len s
off = ulong 0
while lt off n bound 256
k = write 1 s off sub n off
if le k 0
break
end
off = add off ulong k
end
end

fn e2_rep name view uchar * ok bool to void
if ok
e2_w e2_pass
else
e2_w e2_fail
put e2_fails 0 add get e2_fails 0 1
end
e2_w name
e2_w e2_nl
end

fn e2_http_lf src view uchar * to ulong
buf = new uchar 512 0
n = len src
w = ulong 0
for i ulong n bound 512
b = get src i
if eq b uchar 10
put buf w uchar 13
put buf add w 1 uchar 10
w = add w 2
else
put buf w b
w = add w 1
end
end
ret srv_handle_http part buf 0 w
end

fn test_e2_pos to bool
if ne cli_dispatch e2_cli_ok CLI_OK
ret false
end
if or ne cli_cmd CLI_CMD_SERVE or ne cli_port 18091 ne cli_max_tokens 2048
ret false
end
srv_auth_reset
if not srv_auth_set_token e2_tok
ret false
end
if ne e2_http_lf e2_req_chat 200
ret false
end
if ne kv_init 16 8 512 0
ret false
end
if ne kv_available_blocks 16
ret false
end
ret true
end

fn test_e2_neg to bool
if ne cli_dispatch e2_cli_bad CLI_ERR_BAD_PORT
ret false
end
srv_auth_reset
if ne e2_http_lf e2_req_chat 401
ret false
end
if not srv_auth_set_token e2_tok
ret false
end
if ne e2_http_lf e2_req_noauth 401
ret false
end
if ne e2_http_lf e2_req_smug 400
ret false
end
ret true
end

fn main to int
put e2_fails 0 0
e2_rep e2_n1 test_e2_pos
e2_rep e2_n2 test_e2_neg
if eq get e2_fails 0 0
e2_w e2_ok
ret 0
end
e2_w e2_bad
ret 1
end

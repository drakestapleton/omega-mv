text qhp "lm_head.weight"
fn main to int
if ne argcnt 3
ret 2
end
layers = ulong 40
n = argread 1 qwdig 0 8
if ne n 2
ret 2
end
if and eq get qwdig 0 50 eq get qwdig 1 55
layers = ulong 64
else
if not and eq get qwdig 0 51 eq get qwdig 1 53
ret 2
end
end
qwload 2 layers
qprofile layers
id = qwid qhp len qhp
if ne get qwshape mul id 4 248320
ret 4
end
v = qwbits id 0
put qwdig 0 uchar and v 255
put qwdig 1 uchar shr v 8
r = write 1 qwdig 0 2
if ne r 2
ret 3
end
ret 0
end

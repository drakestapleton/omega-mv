note Native Qwen weight access. One active mapping for layer weights plus the shared outside shard.
note Tensor identifiers are indexes in qwt; names are compared after hash lookup.
global qwroot uchar 4096
global qwpath uchar 4200
global qwdig uchar 32
global qwstat uchar 128
global qwsize ulong 65
global qwfd long 65
global qwmap long 2
global qwmapped ulong 2
global qwhash uint 131072
global qwname uchar 8388608
global qwnpos uint 65536
global qwnlen uint 65536
global qwfile uint 65536
global qwoff ulong 65536
global qwcount ulong 65536
global qwdtype uchar 65536
global qwrank uchar 65536
global qwshape ulong 262144
global qwstate ulong 7
text qwlayers "layers-"
text qwext ".safetensors"
text qwoutside "outside.safetensors"
text qwmeta "__metadata__"
text qwlang "model.language_model."
text qwhead "lm_head.weight"
text qwdt "dtype"
text qwsh "shape"
text qwdo "data_offsets"
text qwbf "BF16"
text qwfp "F8_E4M3"
text qwf32 "F32"
text qwerr "Qwen weight admission failed"
fn qwfail c int to void
r = write 2 qwerr 0 len qwerr
exit c
end

fn qwfilesize to ulong
x = ulong 0
for i ulong 8
x = or x shl ulong get qwstat add 48 i mul 8 i
end
ret x
end

fn qwheaderlen to ulong
x = ulong 0
for i ulong 8
x = or x shl ulong get qwdig i mul 8 i
end
ret x
end

fn qwtext pos ulong t view uchar * to ulong
for i ulong len t
put qwpath add pos i get t i
end
ret add pos len t
end

fn qwpathlen shard ulong to ulong
n = get qwstate 0
for i ulong n
put qwpath i get qwroot i
end
put qwpath n 47
p = add n 1
if eq shard 64
ret qwtext p qwoutside
end
p = qwtext p qwlayers
if ge shard 10
put qwpath p uchar add 48 div shard 10
p = add p 1
end
put qwpath p uchar add 48 rem shard 10
ret qwtext add p 1 qwext
end

fn qwstarts s view uchar * n ulong pre view uchar * to bool
if lt n len pre
ret false
end
for i ulong len pre
if ne get s i get pre i
ret false
end
end
ret true
end

fn qwslot s view uchar * n ulong to ulong
h = ulong 14695981039346656037
for i ulong n
h = mul xor h ulong get s i 1099511628211
end
p = and h 131071
while true bound 131072
id = ulong get qwhash p
if eq id 0
ret p
end
if eq ulong get qwnlen id n
b = ulong get qwnpos id
same = true
for i ulong n
if ne get s i get qwname add b i
same = false
end
end
if same
ret p
end
end
p = and add p 1 131071
end
qwfail 24
ret 0
end

fn qwuint src view uchar * tape view uint * t ulong to ulong
if ne js_type tape t jsnum
qwfail 25
end
o = js_off tape t
if not js_isu src o
qwfail 25
end
ret js_tou src o
end

fn qwintern name view uchar * n ulong to ulong
p = qwslot name n
if ne get qwhash p 0
qwfail 26
end
id = add get qwstate 1 1
o = get qwstate 2
if or ge id len qwnpos gt add o n len qwname
qwfail 27
end
put qwhash p uint id
put qwnpos id uint o
put qwnlen id uint n
put qwfile id uint get qwstate 4
for i ulong n
put qwname add o i get name i
end
put qwstate 1 id
put qwstate 2 add o n
ret id
end

fn qwdim dim ulong w ulong to void
id = get qwstate 1
if or eq w 0 gt w 1048576
qwfail 30
end
if gt get qwcount id div 68719476736 w
qwfail 30
end
put qwcount id mul get qwcount id w
put qwshape add mul id 4 dim w
end

fn qwsetshape src view uchar * tape view uint * t ulong to void
rank = js_nkids tape t
if or eq rank 0 gt rank 4
qwfail 30
end
put qwrank get qwstate 1 uchar rank
el = js_first tape t
put qwcount get qwstate 1 1
for dim ulong rank
qwdim dim qwuint src tape el
el = js_enext tape el
end
end

fn qwsettype src view uchar * tape view uint * t ulong id ulong to void
d = js_off tape t
if js_streq src d qwbf
put qwdtype id 2
ret
end
if js_streq src d qwfp
put qwdtype id 1
ret
end
if not js_streq src d qwf32
qwfail 29
end
put qwdtype id 4
end

fn qwfield src view uchar * tape view uint * k ulong to void
t = add k 1
keyoff = js_off tape k
if js_streq src keyoff qwdt
if or ne and get qwstate 6 1 0 ne js_type tape t jsstr
qwfail 28
end
put qwstate 6 or get qwstate 6 1
qwsettype src tape t get qwstate 1
else
if js_streq src keyoff qwsh
if or ne and get qwstate 6 2 0 ne js_type tape t jsarr
qwfail 28
end
put qwstate 6 or get qwstate 6 2
qwsetshape src tape t
else
if not js_streq src keyoff qwdo
qwfail 28
end
if or ne and get qwstate 6 4 0 ne js_type tape t jsarr
qwfail 28
end
if ne js_nkids tape t 2
qwfail 28
end
put qwstate 6 or get qwstate 6 4
el = js_first tape t
put qwstate 3 qwuint src tape js_enext tape el
put qwoff get qwstate 1 qwuint src tape el
end
end
end

fn qweval src view uchar * tape view uint * v ulong to void
if or ne js_type tape v jsobj ne js_nkids tape v 3
qwfail 28
end
put qwstate 6 0
k = js_first tape v
for i ulong 3
qwfield src tape k
k = js_mnext tape k
end
end

fn qwfinish id ulong to void
b = get qwoff id
e = get qwstate 3
base = get qwstate 5
if lt e b
qwfail 31
end
if gt e sub get qwsize get qwstate 4 base
qwfail 31
end
if ne sub e b mul ulong get qwdtype id get qwcount id
qwfail 31
end
put qwoff id add b base
end

fn qwentry src view uchar * tape view uint * key ulong name edit uchar 256 to void
r = js_sget src js_off tape key name
if le r 0
qwfail 25
end
n = ulong r
if not qwstarts name n qwlang
if not and eq n len qwhead qwstarts name n qwhead
ret
end
end
id = qwintern name n
qweval src tape add key 1
qwfinish id
end

fn qwreadheader src edit uchar * shard ulong to ulong
n = qwpathlen shard
fd = fopen qwpath 0 n 557056 0
if lt fd 0
qwfail 32
end
if ne fstat int fd qwstat 0 128 0
qwfail 32
end
if ne and or ulong get qwstat 16 shl ulong get qwstat 17 8 61440 32768
qwfail 32
end
qdiskcheck shard
sz = qwfilesize
if or lt sz 10 gt sz 68719476736
qwfail 33
end
put qwsize shard sz
put qwfd shard fd
if ne pread int fd qwdig 0 8 0 8
qwfail 33
end
hn = qwheaderlen
if or gt hn len src gt hn sub sz 8
qwfail 33
end
if ne pread int fd src 0 hn 8 long hn
qwfail 33
end
ret hn
end

fn qwshard src edit uchar * tape edit uint * name edit uchar 256 shard ulong to void
hn = qwreadheader src shard
if lt js_init tape hn 32 0
qwfail 34
end
if lt js_parse src tape hn 0
qwfail 34
end
if ne js_type tape 0 jsobj
qwfail 34
end
put qwstate 4 shard
put qwstate 5 add hn 8
k = js_first tape 0
while ne k jsnone bound 16384
qwentry src tape k name
k = js_mnext tape k
end
end

fn qwload arg ulong layers ulong to void
if not or eq layers 64 eq layers 40
qwfail 35
end
n = argread arg qwroot 0 4095
if le n 0
qwfail 35
end
qdiskinit layers
put qwstate 0 ulong n
src = new uchar 524288 0
tape = new uint 262160 0
name = new uchar 256 0
for i ulong layers
qwshard src tape name i
end
qwshard src tape name 64
end

fn qwid s view uchar * n ulong to ulong
id = ulong get qwhash qwslot s n
if eq id 0
qwfail 36
end
ret id
end

fn qwhandle id ulong to long
if or eq id 0 gt id get qwstate 1
qwfail 36
end
s = ulong get qwfile id
slot = ulong 0
if eq s 64
slot = ulong 1
end
m = get qwmap slot
if gt m 0
if eq get qwmapped slot s
ret m
end
if ne mapdrop m 0
qwfail 37
end
end
m = mapnew int get qwfd s 0 get qwsize s 1 2
if le m 0
qwfail 37
end
put qwmapped slot s
put qwmap slot m
ret m
end

fn qwbits id ulong i ulong to ulong
if ge i get qwcount id
qwfail 38
end
w = ulong get qwdtype id
off = add get qwoff id mul i w
m = qwhandle id
if eq w 4
ret mapget m off 4
end
r = mapread m off qwdig 0 w
if ne r long w
qwfail 38
end
if eq w 1
ret ulong get qwdig 0
end
ret or ulong get qwdig 0 shl ulong get qwdig 1 8
end

note Fixed architectures of the two text checkpoints. All active parameters are bound before first use.
global qcfg ulong 12
global qrole uint 102400
global qscale uint 65536
global qbound uchar 65536
text qlayerprefix "model.language_model.layers."
text qexpertprefix "mlp.experts."
text qsep "."
text qscalesuffix "_scale_inv"
text qembed "model.language_model.embed_tokens.weight"
text qfinal "model.language_model.norm.weight"
text qlm "lm_head.weight"
fn qappend buf edit uchar * pos ulong frag view uchar * to ulong
for i ulong len frag
put buf add pos i get frag i
end
ret add pos len frag
end

fn qdecimal buf edit uchar * pos ulong x ulong to ulong
p = pos
if ge x 100
put buf p uchar add 48 div x 100
p = add p 1
end
if ge x 10
put buf p uchar add 48 rem div x 10 10
p = add p 1
end
put buf p uchar add 48 rem x 10
ret add p 1
end

fn qresolve frag view uchar * to ulong
buf = new uchar 256 0
p = ulong 0
l = get qcfg 7
if lt l 64
p = qappend buf p qlayerprefix
p = qdecimal buf p l
p = qappend buf p qsep
e = get qcfg 8
if gt e 0
p = qappend buf p qexpertprefix
p = qdecimal buf p sub e 1
p = qappend buf p qsep
end
end
p = qappend buf p frag
ret qwid buf p
end

fn qbind slot ulong frag view uchar * dtype ulong to ulong
id = qresolve frag
if or ne ulong get qwdtype id dtype ne get qbound id 0
qwfail 40
end
put qbound id 1
put qrole add get qcfg 9 slot uint id
ret id
end

fn qrank2 id ulong rows ulong cols ulong to void
if ne get qwrank id 2
qwfail 41
end
base = mul id 4
if or ne get qwshape base rows ne get qwshape add base 1 cols
qwfail 41
end
end

fn qlinkscale id ulong rows ulong cols ulong to void
buf = new uchar 256 0
p = ulong get qwnpos id
n = ulong get qwnlen id
for j ulong n
put buf j get qwname add p j
end
n = qappend buf n qscalesuffix
s = qwid buf n
if or ne get qwdtype s 2 ne get qbound s 0
qwfail 42
end
put qbound s 1
qrank2 s div add rows 127 128 div add cols 127 128
put qscale id uint s
end

fn qmatrix slot ulong frag view uchar * rows ulong cols ulong dtype ulong to void
id = qbind slot frag dtype
qrank2 id rows cols
if eq dtype 1
qlinkscale id rows cols
end
end

fn qvector slot ulong frag view uchar * size ulong to void
id = qbind slot frag 2
if or ne get qwrank id 1 ne get qwshape mul id 4 size
qwfail 43
end
end
text qp0 "input_layernorm.weight"
text qp1 "post_attention_layernorm.weight"
fn qnorms to void
qvector 0 qp0 get qcfg 1
qvector 1 qp1 get qcfg 1
end
text qp2 "linear_attn.A_log"
text qp3 "linear_attn.dt_bias"
text qp4 "linear_attn.in_proj_a.weight"
text qp5 "linear_attn.in_proj_b.weight"
text qp6 "linear_attn.in_proj_qkv.weight"
text qp7 "linear_attn.in_proj_z.weight"
text qp8 "linear_attn.norm.weight"
text qp9 "linear_attn.out_proj.weight"
fn qgdnweights to void
qvector 2 qp2 div get qcfg 3 128
qvector 3 qp3 div get qcfg 3 128
qmatrix 4 qp4 div get qcfg 3 128 get qcfg 1 2
qmatrix 5 qp5 div get qcfg 3 128 get qcfg 1 2
qmatrix 6 qp6 add mul 2 get qcfg 2 get qcfg 3 get qcfg 1 1
qmatrix 7 qp7 get qcfg 3 get qcfg 1 1
qvector 8 qp8 128
qmatrix 9 qp9 get qcfg 1 get qcfg 3 1
end
text qp11 "self_attn.q_norm.weight"
text qp12 "self_attn.k_norm.weight"
text qp13 "self_attn.q_proj.weight"
text qp14 "self_attn.k_proj.weight"
text qp15 "self_attn.v_proj.weight"
text qp16 "self_attn.o_proj.weight"
fn qattnweights to void
qvector 11 qp11 256
qvector 12 qp12 256
qmatrix 13 qp13 mul 2 get qcfg 4 get qcfg 1 1
qmatrix 14 qp14 get qcfg 5 get qcfg 1 1
qmatrix 15 qp15 get qcfg 5 get qcfg 1 1
qmatrix 16 qp16 get qcfg 1 get qcfg 4 1
end
text qp17 "mlp.gate_proj.weight"
text qp18 "mlp.up_proj.weight"
text qp19 "mlp.down_proj.weight"
fn qdenseweights to void
qmatrix 17 qp17 get qcfg 6 get qcfg 1 1
qmatrix 18 qp18 get qcfg 6 get qcfg 1 1
qmatrix 19 qp19 get qcfg 1 get qcfg 6 1
end
text qp20 "mlp.gate.weight"
text qp21 "mlp.shared_expert_gate.weight"
text qp22 "mlp.shared_expert.gate_proj.weight"
text qp23 "mlp.shared_expert.up_proj.weight"
text qp24 "mlp.shared_expert.down_proj.weight"
fn qrouterweights to void
qmatrix 20 qp20 256 get qcfg 1 2
qmatrix 21 qp21 1 get qcfg 1 2
qmatrix 22 qp22 512 get qcfg 1 1
qmatrix 23 qp23 512 get qcfg 1 1
qmatrix 24 qp24 get qcfg 1 512 1
end

text qp10 "linear_attn.conv1d.weight"
text qeg "gate_proj.weight"
text qeu "up_proj.weight"
text qed "down_proj.weight"
fn qconvweight to void
id = qbind 10 qp10 2
a = mul id 4
width = add mul 2 get qcfg 2 get qcfg 3
if or ne get qwrank id 3 ne get qwshape a width
qwfail 44
end
if or ne get qwshape add a 1 1 ne get qwshape add a 2 4
qwfail 44
end
end

fn qlayerweights layer ulong to void
put qcfg 7 layer
put qcfg 8 0
put qcfg 9 mul layer 1600
qnorms
if eq rem layer 4 3
qattnweights
else
qconvweight
qgdnweights
end
if eq get qcfg 0 64
qdenseweights
ret
end
qrouterweights
for e ulong 256
put qcfg 8 add e 1
slot = add 32 mul e 3
qmatrix slot qeg 512 2048 1
qmatrix add slot 1 qeu 512 2048 1
qmatrix add slot 2 qed 2048 512 1
end
end

fn qprofile layers ulong to void
put qcfg 0 layers
if eq layers 64
put qcfg 1 5120
put qcfg 2 2048
put qcfg 3 6144
put qcfg 4 6144
put qcfg 5 1024
put qcfg 6 17408
else
if ne layers 40
qwfail 45
end
put qcfg 1 2048
put qcfg 2 2048
put qcfg 3 4096
put qcfg 4 4096
put qcfg 5 512
put qcfg 6 512
end
for l ulong layers
qlayerweights l
end
put qcfg 7 64
put qcfg 8 0
put qcfg 9 0
note Extra roles in layer zero are separate from the layer and expert slots.
qmatrix 1020 qembed 248320 get qcfg 1 2
qmatrix 1021 qlm 248320 get qcfg 1 2
qvector 1022 qfinal get qcfg 1
for i ulong get qwstate 1
if eq get qbound add i 1 0
qwfail 46
end
end
end

note GB10 matrix layer. Preserve weight residency across tokens, one read-only host fd per shard.
global qgpu long 66
global qxy long 2
global qbuf uchar 1048576
fn qtransfer fd int origin ulong n ulong dev long to void
off = ulong 0
while lt off n bound 65536
w = sub n off
if gt w len qbuf
w = len qbuf
end
if ne pread fd qbuf 0 w long add origin off long w
qwfail 48
end
if ne mapwrite dev off qbuf 0 w long w
qwfail 48
end
off = add off w
end
end

fn qresident id ulong to long
s = ulong get qwfile id
h = get qgpu s
if gt h 0
ret h
end
origin = ulong 0
n = get qwsize s
if eq s 64
if ne id ulong get qrole 1021
qwfail 49
end
origin = get qwoff id
n = mul get qwcount id 2
end
h = nvalloc n true
if le h 0
qwfail 50
end
qrestat s
qtransfer int get qwfd s origin n h
qrestat s
put qgpu s h
ret h
end

fn qgpuopen to void
if not lqopen
qwfail 50
end
x = nvalloc 1048576 true
if le x 0
qwfail 50
end
put qxy 0 x
y = nvalloc 1048576 true
if le y 0
qwfail 50
end
put qxy 1 y
end

fn qbf j ulong to f32
a = mul j 2
bits = or uint get qbuf a shl uint get qbuf add a 1 8
ret bitcast f32 shl bits 16
end

fn qreadrow id ulong first ulong buf edit f32 * pos ulong n ulong to void
if ne get qwdtype id 2
qwfail 51
end
if or gt first get qwcount id gt pos len buf
qwfail 51
end
if or gt n sub get qwcount id first gt n sub len buf pos
qwfail 51
end
h = qwhandle id
bytes = mul n 2
if gt bytes len qbuf
qwfail 51
end
if ne mapread h add get qwoff id mul first 2 qbuf 0 bytes long bytes
qwfail 51
end
for j ulong n
put buf add pos j qbf j
end
end

fn qfillinput x view f32 * n ulong to void
if gt n len x
qwfail 52
end
for j ulong n
bits = bitcast uint get x j
if ne mapset get qxy 0 mul j 4 4 ulong bits 0
qwfail 52
end
end
end

fn qbindmatrix id ulong to void
h = qresident id
put lqmap 0 h
off = get qwoff id
if eq get qwfile id 64
off = ulong 0
end
put lqoff 0 off
put lqlen 0 mul get qwcount id ulong get qwdtype id
put lqlen 1 0
s = ulong get qscale id
if ne s 0
if ne get qwfile s get qwfile id
qwfail 52
end
put lqmap 1 h
put lqoff 1 get qwoff s
put lqlen 1 mul get qwcount s 2
end
end

fn qdispatch id ulong m uint k uint to void
s = ulong get qscale id
ok = false
if eq s 0
ok = lqrun 0 m k 0 0
else
a = mul s 4
ok = lqrun 1 m k uint get qwshape a uint get qwshape add a 1
end
if not ok
qwfail 53
end
end

fn qproject id ulong x view f32 * y edit f32 * pos ulong to void
a = mul id 4
m = uint get qwshape a
k = uint get qwshape add a 1
if or gt pos len y gt ulong m sub len y pos
qwfail 52
end
qfillinput x ulong k
qbindmatrix id
put lqmap 2 get qxy 0
put lqmap 3 get qxy 1
put lqoff 2 0
put lqoff 3 0
put lqlen 2 mul ulong k 4
put lqlen 3 mul ulong m 4
qdispatch id m k
for j ulong ulong m
bits = uint mapget get qxy 1 mul j 4 4
put y add pos j bitcast f32 bits
end
end

note Token-to-token CLI. The paired native tokenizer handles the rendered UTF-8 input and output bytes.
note qwen-generate MODEL MODEL_DIR CAP, decimal prompt token IDs (one per line) on stdin.
global qintbuf uchar 32
fn qnumber buf view uchar * n ulong to ulong
if or eq n 0 gt n 7
qwfail 56
end
v = ulong 0
for i ulong n
c = get buf i
if or lt c 48 gt c 57
qwfail 56
end
v = add mul v 10 sub ulong c 48
end
ret v
end

fn qnumericarg a ulong to ulong
b = new uchar 8 0
n = argread a b 0 8
if le n 0
qwfail 56
end
ret qnumber b ulong n
end

fn outid id ulong to void
n = get qnids 0
if or ge n len qids ge id len sizes
qwfail 56
end
put qids n uint id
put qnids 0 add n 1
end

fn qprintid id ulong to void
v = id
p = ulong 31
put qintbuf p 10
while true bound 8
p = sub p 1
put qintbuf p uchar add 48 rem v 10
v = div v 10
if eq v 0
break
end
end
while lt p 32 bound 32
w = write 1 qintbuf p sub 32 p
if le w 0
qwfail 57
end
p = add p ulong w
end
end

fn qgenerate count ulong cap ulong to void
id = ulong 0
for j ulong count
id = qtoken ulong get qids j j eq add j 1 count
end
for j ulong cap
put qrun 3 0
put qrun 4 add j 1
if eq get qidmode 0 1
qprintid id
else
if eq get qidmode 0 2
qsessiontoken id
end
end
if or eq id 248044 eq id 248046
put qrun 3 1
ret
end
if eq get qidmode 0 0
if ge id len sizes
qwfail 57
end
if eq get sizes id 0
qwfail 57
end
emitword id
tkpfl
end
if lt add j 1 cap
id = qtoken id add count j true
end
end
end

fn main to int
if and ne argcnt 4 ne argcnt 5
ret 2
end
model = qnumericarg 1
cap = qnumericarg 3
if or eq cap 0 gt cap 160
ret 2
end
layers = ulong 40
if eq model 27
layers = ulong 64
else
if ne model 35
ret 2
end
end
if eq argcnt 5
mode = qnumericarg 4
if not or eq mode 1 eq mode 2
ret 2
end
put qidmode 0 mode
end
loadmodel
if ne get qtidentity 0 model
qwfail 59
end
unicodeinit
qwload 2 layers
qprofile layers
put qrun 0 model
qgpuopen
if eq get qidmode 0 2
qsession cap
else
encodeinput inputsize
count = get qnids 0
if eq count 0
qwfail 56
end
if gt add count sub cap 1 8192
qwfail 56
end
qgenerate count cap
end
if not lqclose
ret 58
end
ret 0
end

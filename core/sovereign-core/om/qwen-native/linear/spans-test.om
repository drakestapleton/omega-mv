note Host-only calls into the admission function, using synthetic mapping records.
fn packets to bool
for i ulong 5
h = mapnew neg int 1 0 65536 3 34
if le h 0
ret false
end
put gbmem i h
end
for i ulong 4
put lqmap i get gbmem i
put lqoff i mul i 128
end
for fmt uint 2
n = lqemit fmt
lqpack fmt 129 160 2
if or eq n 0 eq get gbused 0 0
ret false
end
if or ne get gbq1 39 129 ne get gbq1 40 1
ret false
end
if or ne get gbq1 41 1 ne and get gbq1 34 65535 32
ret false
end
code = add mapaddr get gbmem 4 mul ulong fmt 16384
if ne get gbq1 32 gblo shr code 4
ret false
end
for i ulong 5
want = ulong 0
if eq i 4
want = add mapaddr get gbmem 4 32768
else
if or ne i 1 eq fmt 1
want = add mapaddr get lqmap i get lqoff i
end
end
if ne get gkarg mul i 2 gblo want
ret false
end
if ne get gkarg add mul i 2 1 gbhi want
ret false
end
end
if ne get gkarg 11 mul uint 160 sub uint 2 fmt
ret false
end
if or ne get gkarg 10 160 ne get gkarg 12 2
ret false
end
end
ret true
end
fn main to int
for i ulong 4
put lqmap i 17
put lqoff i mul i 1024
put lqlen i 256
end
put nvmmap 0 17
put nvmlen 0 4096
put nvmflag 0 15
if not lqvalid 1
exit 1
end
put lqoff 3 2300
if lqvalid 1
exit 2
end
put lqoff 3 2304
if not lqvalid 1
exit 3
end
put lqoff 3 18446744073709551612
if lqvalid 1
exit 4
end
put lqoff 3 2306
if lqvalid 1
exit 5
end
put lqoff 3 2304
put lqmap 3 71
if lqvalid 1
exit 6
end
put lqmap 3 17
put nvmflag 0 7
if lqvalid 1
exit 7
end
put nvmflag 0 15
put gbmem 4 17
if lqvalid 1
exit 8
end
put gbmem 4 0
put nvfifo 0 17
if lqvalid 1
exit 9
end
if not packets
exit 10
end
exit 0
end

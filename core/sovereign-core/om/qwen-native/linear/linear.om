note SPDX-License-Identifier: AGPL-3.0-only
note One CTA per output row, one warp per CTA. K must be a positive multiple of 32.
note Constant bank 0 at 896: five u64 pointers W,S,X,Y,decode then K,row bytes,scale columns.
fn lqnarr d uint a uint half bool to void
kind = uint 4
if half
kind = 6
end
gkvar or or 31105 shl d 16 shl a 24 4 xor 203299072 shl kind 9 false
end
fn lqemit fmt uint to ulong
base = mul ulong fmt 16384
put gkat 0 base
put gkpend 0 0
gks2r 0 33 false
gks2r 2 37 true
note Load the global memory descriptor to UR4 as in grpro.
gkq 4278482860 27392 134220288 or gkcw 4 2 7 get gkpend 0 8192
put gkpend 0 4
gkldc64 10 896
gkldc64 14 912
gkldc64 16 920
gkldc 4 936 false
gkldc 5 940 true
gkimadwr 10 2 5 10
gkimadw 16 2 4 16
if eq fmt 1
gkldc64 12 904
gkldc64 18 928
gkldc 5 944 false
gkshr 3 2 7
gkimadi 5 5 2 255
gkimadwr 12 3 5 12
end
gkmovz 24
gkimadi 3 0 1 255
top = div get gkat 0 16
put gkpend 0 63
gkimadw 20 3 4 14
gkldg 25 20 0 false
if eq fmt 1
gkimadw 20 3 1 10
lqnarr 26 20 false
gkimadw 20 26 4 18
gkldg 26 20 0 false
gkshr 27 3 7
gkimadw 20 27 2 12
lqnarr 27 20 true
gkimadi 27 27 65536 255
gkfmulf 26 26 27
else
gkimadw 20 3 2 10
lqnarr 26 20 true
gkimadi 26 26 65536 255
end
gkffmaf 24 26 25 24
gkmovi 5 32
gkiadd 3 3 5
gkisetp 0 3 4 1
gkbra 0 top
for i uint 5
grshfl 25 24 shr uint 16 i
grfadd 24 24 25
end
gkisge 0 0 1
gkstgp 16 24 0 false 8
gkexit
put gkthr fmt 32
put gkgpr fmt 32
put gksm fmt 0
ret sub get gkat 0 base
end
note Construct the complete E4M3FN lookup, including signed zero and both NaNs.
fn lqbits b uint to uint
sg = shl and b 128 24
mag = and b 127
if eq mag 127
ret or sg 2143289344
end
if lt mag 8
ret or sg bitcast uint mul f32 mag bitcast f32 uint 989855744
end
ret or sg shl add mag 960 20
end
global lqready uint 1
global lqowned uint 1
fn lqopen to bool
if ne get nvstate 0 0
ret false
end
put lqready 0 0
put lqowned 0 1
if not nvfull
ret false
end
if not nvchan
ret false
end
for i ulong 5
n = ulong 4096
if or or eq i 0 eq i 2 eq i 4
n = 65536
end
h = nvalloc n false
if le h 0
ret false
end
put gbmem i h
end
code = get gbmem 4
for fmt uint 2
n = lqemit fmt
off = mul ulong fmt 16384
if or gt n 16384 ne mapwrite code off gkcode off n long n
ret false
end
end
for b uint 256
if ne mapset code add 32768 mul ulong b 4 4 ulong lqbits b 0
ret false
end
end
put lqready 0 1
ret true
end
fn lqclose to bool
put lqready 0 0
if eq get lqowned 0 0
ret true
end
if not nvstop
ret false
end
put lqowned 0 0
ret true
end
note Caller describes four logical slices, indexed W,S,X,Y, in its owned mappings.
global lqmap long 4
global lqoff ulong 4
global lqlen ulong 4
fn lqgeom fmt uint m uint k uint sr uint sc uint to bool
if or or gt fmt 1 eq m 0 eq k 0
ret false
end
note Row stride is a u32 byte count and grid.x is a positive signed 31-bit extent.
if or gt m 2147483647 and eq fmt 0 gt k 2147483647
ret false
end
if ne rem k 32 0
ret false
end
if or ne get lqlen 2 mul ulong k 4 ne get lqlen 3 mul ulong m 4
ret false
end
ws = ulong 2
if eq fmt 1
ws = 1
if ne sr add div sub m 1 128 1
ret false
end
if ne sc add div sub k 1 128 1
ret false
end
else
if or ne sr 0 ne sc 0
ret false
end
end
if ne get lqlen 0 mul mul ulong m ulong k ws
ret false
end
ret eq get lqlen 1 mul mul ulong sr ulong sc 2
end
fn lqvalid fmt uint to bool
for i ulong 4
if or ne i 1 eq fmt 1
h = get lqmap i
slot = nvfind h
if eq slot 96
ret false
end
if ne get nvmflag slot 15
ret false
end
for j ulong 5
if eq h get gbmem j
ret false
end
end
if or eq h get nvfifo 0 eq h get nvnotify 0
ret false
end
size = get nvmlen slot
off = get lqoff i
n = get lqlen i
if or gt off size gt n sub size off
ret false
end
al = ulong 4
if eq i 1
al = 2
end
if eq i 0
al = sub ulong 2 ulong fmt
end
if ne rem off al 0
ret false
end
if and ne i 3 eq h get lqmap 3
yo = get lqoff 3
if ge yo off
if lt sub yo off n
ret false
end
else
if lt sub off yo get lqlen 3
ret false
end
end
end
end
end
ret true
end
fn lqpack fmt uint m uint k uint sc uint to void
for i ulong 5
va = ulong 0
if eq i 4
va = add mapaddr get gbmem 4 32768
else
if or ne i 1 eq fmt 1
va = add mapaddr get lqmap i get lqoff i
end
end
put gkarg mul i 2 gblo va
put gkarg add mul i 2 1 gbhi va
end
put gkarg 10 k
put gkarg 11 mul k sub uint 2 fmt
put gkarg 12 sc
put gkna 0 13
put gkinv 0 1
gkbuild fmt m 1 1
end
fn lqrun fmt uint m uint k uint sr uint sc uint to bool
if or eq get lqready 0 0 ne get nvfault 0 0
ret false
end
if not lqgeom fmt m k sr sc
ret false
end
if not lqvalid fmt
ret false
end
lqpack fmt m k sc
ret ge gksend 0
end

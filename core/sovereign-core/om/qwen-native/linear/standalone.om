global lqio uchar 65536
global lqhead ulong 9
fn lqread n ulong to bool
i = ulong 0
while lt i n
r = read 0 lqio i sub n i
if le r 0
ret false
end
i = add i ulong r
end
ret true
end
fn lqload h long off ulong n ulong to uint
r = mapread h off lqio 0 n
if ne r long n
exit 5
end
v = uint get lqio 0
if eq n 2
v = or v shl uint get lqio 1 8
end
ret v
end
fn lqwgt fmt uint idx ulong si ulong to f32
if eq fmt 0
u = lqload get lqmap 0 mul idx 2 2
ret bitcast f32 shl u 16
end
u = lqbits lqload get lqmap 0 idx 1
w = bitcast f32 u
u = lqload get lqmap 1 mul si 2 2
ret mul w bitcast f32 shl u 16
end
fn lqrow fmt uint row ulong k uint sc uint to f32
sumv = f64 0
base = mul row ulong k
sb = mul div row 128 ulong sc
for col ulong ulong k
w = lqwgt fmt add base col add sb div col 128
u = uint mapget get lqmap 2 mul col 4 4
v = bitcast f32 u
sumv = add sumv mul f64 v f64 w
end
ret f32 sumv
end
fn lqref fmt uint m uint k uint sc uint to void
for row ulong ulong m
v = lqrow fmt row k sc
r = mapset get lqmap 3 mul row 4 4 ulong bitcast uint v
end
end
fn lqcase gpu bool shape bool to int
if not lqread 72
ret 2
end
for i ulong 9
v = ulong 0
for j ulong 8
v = or v shl ulong get lqio add mul i 8 j mul j 8
end
put lqhead i v
if and lt i 5 gt v 4294967295
ret 2
end
end
fmt = uint get lqhead 0
m = uint get lqhead 1
k = uint get lqhead 2
sr = uint get lqhead 3
sc = uint get lqhead 4
for i ulong 4
put lqlen i get lqhead add i 5
end
if not lqgeom fmt m k sr sc
ret 2
end
if shape
if ne read 0 lqio 0 1 0
ret 2
end
ret 0
end
if gpu
if not lqopen
ret 3
end
end
for i ulong 4
n = get lqlen i
if gt n 0
h = long 0
if gpu
h = nvalloc n true
else
h = mapnew neg int 1 0 n 3 34
end
if le h 0
ret 3
end
put lqmap i h
off = ulong 0
while and lt i 3 lt off n
sz = sub n off
if gt sz len lqio
sz = len lqio
end
if not lqread sz
ret 2
end
if ne mapwrite h off lqio 0 sz long sz
ret 3
end
off = add off sz
end
end
end
if ne read 0 lqio 0 1 0
ret 2
end
if gpu
if not lqrun fmt m k sr sc
ret 4
end
else
lqref fmt m k sc
end
off = ulong 0
while lt off get lqlen 3
sz = sub get lqlen 3 off
if gt sz len lqio
sz = len lqio
end
if ne mapread get lqmap 3 off lqio 0 sz long sz
ret 5
end
pos = ulong 0
while lt pos sz
r = write 1 lqio pos sub sz pos
if le r 0
ret 5
end
pos = add pos ulong r
end
off = add off sz
end
ret 0
end
fn main to int
if ne argcnt 2
exit 2
end
if ne argread 1 lqio 0 4 1
exit 2
end
c = get lqio 0
if or eq c 98 eq c 102
fmt = uint 0
if eq c 102
fmt = 1
end
n = lqemit fmt
r = write 1 gkcode mul ulong fmt 16384 n
if ne r long n
exit 5
end
exit 0
end
if eq c 116
for b uint 256
v = lqbits b
for j uint 4
put lqio add mul b 4 j uchar and shr v mul j 8 255
end
end
r = write 1 lqio 0 1024
if ne r 1024
exit 5
end
exit 0
end
if eq c 114
exit lqcase false false
end
if eq c 115
exit lqcase false true
end
if ne c 103
exit 2
end
rc = lqcase true false
if not lqclose
exit 6
end
exit rc
end

global input uchar *
global token uint *
global following ulong *
global previous ulong *
global heaprank uint *
global heappos ulong *
global heapmeta ulong 1
text encodecmd "encode"
text decodecmd "decode"

fn inputsize to ulong
n = ulong 0
r = enlarge input 16384
if lt r 0
exit 4
end
while true bound 9223372036854775807
if eq n len input
r = enlarge input mul 2 n
if lt r 0
exit 4
end
end
r = read 0 input n sub len input n
if lt r 0
exit 5
end
if eq r 0
ret n
end
n = add n ulong r
end
ret n
end

fn markerat p ulong id ulong k ulong to bool
o = get starts id
for j ulong k
if ne get input add p j get spelling add o j
ret false
end
end
ret true
end

fn special p ulong n ulong to ulong
if ne get input p 60
ret 0
end
for t ulong sub get meta 1 248044
id = add 248044 t
k = ulong get sizes id
if le k sub n p
if markerat p id k
ret id
end
end
end
ret 0
end

fn qfold cp uint to uint
if and ge cp 65 le cp 90
ret add cp 32
end
if eq cp 383
ret 115
end
ret cp
end

fn contraction p ulong n ulong to ulong
if or ne get scalars p 39 ge add p 1 n
ret 0
end
a = qfold get scalars add p 1
if or or eq a 115 eq a 116 or eq a 109 eq a 100
ret 2
end
if lt add p 2 n
b = qfold get scalars add p 2
if or and or eq a 114 eq a 118 eq b 101 and eq a 108 eq b 108
ret 3
end
end
ret 0
end

fn newline cp uint to bool
ret or eq cp 10 eq cp 13
end

fn lettermark i ulong to bool
k = get uclass get scalars i
ret or eq k 1 eq k 2
end

note Return the end of the first matching alternative in the frozen Split regex.
fn piece p ulong n ulong to ulong
l = contraction p n
if ne l 0
ret add p l
end
cp = get scalars p
k = get uclass cp
i = p
if and and ne k 1 ne k 3 not newline cp
if lt add i 1 n
if lettermark add i 1
i = add i 1
end
end
end
if lettermark i
while lt i n bound 9223372036854775807
if not lettermark i
break
end
i = add i 1
end
ret i
end
if eq k 3
ret add p 1
end
i = p
if and eq cp 32 lt add i 1 n
if eq get uclass get scalars add i 1 0
i = add i 1
end
end
if eq get uclass get scalars i 0
while lt i n bound 9223372036854775807
if ne get uclass get scalars i 0
break
end
i = add i 1
end
while lt i n bound 9223372036854775807
if not newline get scalars i
break
end
i = add i 1
end
ret i
end
i = p
lastnl = ulong 0
while lt i n bound 9223372036854775807
if ne get uclass get scalars i 4
break
end
if newline get scalars i
lastnl = add i 1
end
i = add i 1
end
if ne lastnl 0
ret lastnl
end
if and lt i n gt i add p 1
ret sub i 1
end
ret i
end

fn precedes a uint i ulong b uint j ulong to bool
ret or lt a b and eq a b lt i j
end

fn enqueue i ulong n ulong to void
j = get following i
if ge j n
ret
end
slot = pairslot pairkey ulong get token i ulong get token j
rank = get ranks slot
if eq rank 0
ret
end
h = add get heapmeta 0 1
put heapmeta 0 h
while gt h 1
parent = shr h 1
if not precedes rank i get heaprank parent get heappos parent
break
end
put heaprank h get heaprank parent
put heappos h get heappos parent
h = parent
end
put heaprank h rank
put heappos h i
end

fn heapbefore a ulong b ulong to bool
ret precedes get heaprank a get heappos a get heaprank b get heappos b
end

fn popheap to void
n = get heapmeta 0
rank = get heaprank n
pos = get heappos n
n = sub n 1
put heapmeta 0 n
h = ulong 1
while le mul h 2 n
child = mul h 2
if lt child n
other = add child 1
if heapbefore other child
child = other
end
end
if not precedes get heaprank child get heappos child rank pos
break
end
put heaprank h get heaprank child
put heappos h get heappos child
h = child
end
put heaprank h rank
put heappos h pos
end

fn reservescratch p ulong e ulong to void
capacity = mul 4 sub e p
r = enlarge token capacity
if lt r 0
exit 4
end
r = enlarge following capacity
if lt r 0
exit 4
end
r = enlarge previous capacity
if lt r 0
exit 4
end
slots = add 1 mul 3 capacity
r = enlarge heaprank slots
if lt r 0
exit 4
end
r = enlarge heappos slots
if lt r 0
exit 4
end
end

fn initpiece p ulong e ulong to ulong
buf = new uchar 4 0
n = ulong 0
for i ulong sub e p bound 9223372036854775807
k = js_putcp buf 0 ulong get scalars add p i
for j ulong k
put token n get baseids get buf j
put following n add n 1
if gt n 0
put previous n sub n 1
end
n = add n 1
end
end
ret n
end

fn bpe p ulong e ulong to void
reservescratch p e
n = initpiece p e
put heapmeta 0 0
for i ulong n bound 9223372036854775807
enqueue i n
end
while ne get heapmeta 0 0 bound 9223372036854775807
i = get heappos 1
rank = get heaprank 1
popheap
j = get following i
if lt j n
slot = pairslot pairkey ulong get token i ulong get token j
if eq get ranks slot rank
put token i get results slot
next = get following j
put following j n
put following i next
if lt next n
put previous next i
end
if gt i 0
enqueue get previous i n
end
enqueue i n
end
end
end
i = ulong 0
while lt i n bound 9223372036854775807
outid ulong get token i
i = get following i
end
end

fn normalspan start ulong endpos ulong to void
put nfcstate 0 0
p = start
while lt p endpos bound 9223372036854775807
c = ulong get input p
p = add p 1
cp = c
more = ulong 0
if ge c 192
more = ulong 1
cp = and c 31
if ge c 224
more = ulong 2
cp = and c 15
end
if ge c 240
more = ulong 3
cp = and c 7
end
end
for j ulong more
cp = or shl cp 6 and ulong get input p 63
p = add p 1
end
decompose cp
end
n = recompose
i = ulong 0
while lt i n bound 9223372036854775807
e = piece i n
bpe i e
i = e
end
end

fn encodeinput n ulong to void
st = ulong 0
for i ulong n bound 9223372036854775807
st = js_u8st st get input i
if eq st 9
exit 6
end
end
if ne st 0
exit 6
end
r = enlarge scalars mul 4 n
if lt r 0
exit 4
end
p = ulong 0
s = ulong 0
while lt p n bound 9223372036854775807
id = special p n
if ne id 0
normalspan s p
outid id
p = add p ulong get sizes id
s = p
else
p = add p 1
end
end
normalspan s n
end

fn emitword id ulong to void
for j ulong ulong get sizes id
tkpc ulong get spelling add get starts id j
end
end

fn decodeinput n ulong emit bool to void
p = ulong 0
while lt p n bound 9223372036854775807
id = ulong 0
digits = ulong 0
while lt p n bound 9223372036854775807
c = get input p
if or lt c 48 gt c 57
break
end
id = add mul id 10 sub ulong c 48
if ge id get meta 1
exit 7
end
p = add p 1
digits = add digits 1
end
if or eq digits 0 eq get sizes id 0
exit 7
end
if lt p n
if ne get input p 10
exit 7
end
p = add p 1
end
if emit
emitword id
end
end
end

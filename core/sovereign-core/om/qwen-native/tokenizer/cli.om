fn outid id ulong to void
tcpu id
tkpc 10
end

fn main to int
mode = new uchar 6 0
if ne argcnt 3
ret 2
end
if ne argread 1 mode 0 6 6
ret 2
end
enc = equalbytes mode encodecmd
if and not enc not equalbytes mode decodecmd
ret 2
end
loadmodel
n = inputsize
if enc
unicodeinit
encodeinput n
else
decodeinput n false
decodeinput n true
end
tkpfl
ret 0
end

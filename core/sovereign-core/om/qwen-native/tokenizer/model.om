note Read the frozen JSON once, authenticate those same bytes before interpreting its layout.
text q27hash "0997f410c57a1f4e53b09e4be8f4a172d90edd9564368fb0847030937229b9f3"
text q35hash "5f9e4d4901a92b997e463c1f46055088b6cca5ca61a6522d1b9f64c4bb81cb42"
text suffix "/tokenizer.json"
global pathbuf uchar 4096
global modeldata uchar *
global spelling uchar *
global starts ulong 248077
global sizes uint 248077
global vocabmap uint 524288
global pairkeys ulong 524288
global ranks uint 524288
global results uint 524288
global baseids uint 256
global inverse uint 324
global wordbuf uchar 512
global meta ulong 4
note meta: bytes of spelling, number of valid ids, model byte length, current merge separator offset.
fn equalbytes a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a
if ne get a i get b i
ret false
end
end
ret true
end

global qtidentity ulong 1
fn authmodel to void
n = argread 2 pathbuf 0 sub len pathbuf len suffix
if le n 0
exit 2
end
for i ulong len suffix
put pathbuf add ulong n i get suffix i
end
fd = fopen pathbuf 0 add ulong n len suffix 0 0
if lt fd 0
exit 3
end
nbytes = ulong 0
hreset
while true
r = enlarge modeldata add nbytes 65536
if lt r 0
exit 4
end
r = read int fd modeldata nbytes 65536
if lt r 0
exit 3
end
if eq r 0
break
end
for i ulong ulong r
if not hpush get modeldata add nbytes i
exit 3
end
end
nbytes = add nbytes ulong r
if gt nbytes 12809320
exit 3
end
end
r = fclose int fd
if not hfinal
exit 3
end
a = true
b = true
for i ulong 64
if ne get hd i get q27hash i
a = false
end
if ne get hd i get q35hash i
b = false
end
end
if not or a b
exit 3
end
if a
put qtidentity 0 27
else
put qtidentity 0 35
end
put meta 2 nbytes
r = enlarge spelling nbytes
if lt r 0
exit 4
end
end

note ByteLevel inverse alphabet, plain printable bytes followed by escaped bytes.
fn alphabet to void
k = ulong 256
for c ulong 256
if or or and ge c 33 le c 126 and ge c 161 le c 172 ge c 174
put inverse c uint c
else
put inverse k uint c
k = add k 1
end
end
end

note Convert a decoded JSON string into raw spelling; merge separator is ASCII space.
fn bytesof s view uchar * n ulong merge bool to ulong
i = ulong 0
w = ulong 0
while lt i n
c = ulong get s i
i = add i 1
if ge c 128
c = add shl and c 31 6 and ulong get s i 63
i = add i 1
end
if and merge eq c 32
put meta 3 w
else
put wordbuf w uchar get inverse c
w = add w 1
end
end
ret w
end

fn wordmatches id ulong o ulong n ulong to bool
if ne ulong get sizes id n
ret false
end
base = get starts id
for j ulong n
if ne get spelling add base j get wordbuf add o j
ret false
end
end
ret true
end

fn vslot o ulong n ulong to ulong
h = ulong 14695981039346656037
for j ulong n
h = mul xor h ulong get wordbuf add o j 1099511628211
end
s = and h 524287
while ne get vocabmap s 0
id = sub ulong get vocabmap s 1
if wordmatches id o n
break
end
s = and add s 1 524287
end
ret s
end

fn saveword id ulong n ulong to void
o = get meta 0
put starts id o
put sizes id uint n
for j ulong n
put spelling add o j get wordbuf j
end
put meta 0 add o n
end

note Multiplicative pair hash and linear probing adapted from seeded tkcore.om tkslot/tkrins.
fn pairslot key ulong to ulong
s = shr mul add key 1 ulong 11400714819323198485 45
while ne get ranks s 0
if eq get pairkeys s key
break
end
s = and add s 1 524287
end
ret s
end

fn pairkey a ulong b ulong to ulong
ret or shl a 32 b
end

fn addmerge n ulong rank ulong to void
cut = get meta 3
a = get vocabmap vslot 0 cut
b = get vocabmap vslot cut sub n cut
v = get vocabmap vslot 0 n
if or or eq a 0 eq b 0 eq v 0
exit 3
end
key = pairkey sub ulong a 1 sub ulong b 1
s = pairslot key
put pairkeys s key
put ranks s uint rank
put results s sub v 1
end

fn keyat line view uchar * k ulong name view uchar * to bool
if gt add k len name len line
ret false
end
for i ulong len name
if ne get line add k i get name i
ret false
end
end
ret true
end

text vocabkey "\"vocab\": {"
text mergekey "\"merges\": ["
text contentkey "\"content\": "
text idkey "\"id\": "
fn loadmodel to void
authmodel
alphabet
line = new uchar 1024 0
s = new uchar 512 0
p = ulong 0
phase = ulong 0
id = ulong 0
rank = ulong 0
while lt p get meta 2 bound 9223372036854775807
n = ulong 0
while lt p get meta 2
c = get modeldata p
p = add p 1
if eq c 10
break
end
put line n c
n = add n 1
end
k = ulong 0
while and lt k n eq get line k 32
k = add k 1
end
if keyat line k vocabkey
phase = ulong 1
id = ulong 0
else
if keyat line k mergekey
phase = ulong 2
else
if eq phase 0
if keyat line k idkey
id = js_tou line add k len idkey
end
if keyat line k contentkey
z = js_sget line add k len contentkey s
if lt z 0
exit 3
end
for j ulong ulong z
put wordbuf j get s j
end
saveword id ulong z
put meta 1 add id 1
end
else
if eq get line k 34
z = js_sget line k s
if lt z 0
exit 3
end
w = bytesof s ulong z eq phase 2
if eq phase 1
slot = vslot 0 w
saveword id w
put vocabmap slot uint add id 1
if eq w 1
put baseids get wordbuf 0 uint id
end
id = add id 1
else
rank = add rank 1
addmerge w rank
end
end
end
end
end
end
end

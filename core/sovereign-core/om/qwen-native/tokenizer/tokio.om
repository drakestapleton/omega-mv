note SPDX-License-Identifier: AGPL-3.0-only
global tkso uchar 4096
global tksn ulong 1
fn tkpfl to void
n = get tksn 0
p = ulong 0
while lt p n bound 4097
w = write 1 tkso p sub n p
if le w 0
exit 70
end
p = add p ulong w
end
put tksn 0 0
end

note one byte to stdout
fn tkpc c ulong to void
n = get tksn 0
if ge n 4096
tkpfl
n = ulong 0
end
put tkso n uchar c
put tksn 0 add n 1
end

global tcdg uchar 24
fn tcpu v ulong to void
n = ulong 0
x = v
dn = false
while not dn bound 24
put tcdg n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
dn = true
end
end
for k ulong n
tkpc ulong get tcdg sub sub n 1 k
end
end

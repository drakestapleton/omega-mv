global uclass uchar 1114112
global combining uchar 1114112
global decomp uint 1114112
global decompdata uint 16384
global compkeys ulong 4096
global compval uint 4096
global scalars uint *
global nfcstate ulong 1

fn urange lo ulong hi ulong kind uchar to void
for j ulong add sub hi lo 1
put uclass add lo j kind
end
end

fn compslot key ulong to ulong
s = shr mul key ulong 11400714819323198485 52
while ne get compval s 0
if eq get compkeys s key
break
end
s = and add s 1 4095
end
ret s
end

fn ucomposeadd a ulong b ulong c uint to void
key = or shl a 21 b
s = compslot key
put compkeys s key
put compval s c
end

fn compose a ulong b ulong to ulong
if and and ge a 4352 lt a 4371 and ge b 4449 lt b 4470
ret add 44032 mul add mul sub a 4352 21 sub b 4449 28
end
if and and ge a 44032 lt a 55204 and gt b 4519 lt b 4547
if eq rem sub a 44032 28 0
ret add a sub b 4519
end
end
ret ulong get compval compslot or shl a 21 b
end

note Stable canonical ordering within the current combining sequence.
fn ordered cp ulong to void
i = get nfcstate 0
put nfcstate 0 add i 1
cc = get combining cp
if ne cc 0
while gt i 0 bound 9223372036854775807
prev = get scalars sub i 1
if le get combining prev cc
break
end
put scalars i prev
i = sub i 1
end
end
put scalars i uint cp
end

fn decompose cp ulong to void
if and ge cp 44032 lt cp 55204
s = sub cp 44032
ordered add 4352 div s 588
ordered add 4449 rem div s 28 21
if ne rem s 28 0
ordered add 4519 rem s 28
end
ret
end
v = ulong get decomp cp
if eq v 0
ordered cp
else
for j ulong and v 7
ordered ulong get decompdata add shr v 3 j
end
end
end

fn recompose to ulong
w = ulong 0
starter = ulong 0
cc = uchar 0
for i ulong get nfcstate 0 bound 9223372036854775807
cp = get scalars i
nextcc = get combining cp
merged = ulong 0
if and gt w 0 or eq cc 0 lt cc nextcc
merged = compose ulong get scalars starter ulong cp
end
if ne merged 0
put scalars starter uint merged
else
if eq nextcc 0
starter = w
end
put scalars w cp
w = add w 1
cc = nextcc
end
end
ret w
end

note Build-time transcriber for the two authenticated Unicode data files.
global iline uchar 512
global page uchar 8192
global nums ulong 8
global genstate ulong 4
note genstate: input table tag, generated row count, function count, decomposition pool offset.
text rangeL "CR_L[]"
text rangeM "CR_M[]"
text rangeN "CR_N[]"
text rangeS "CR_Space[]"
text ccchead "pub(crate) const CANONICAL_COMBINING_CLASS_KV:"
text bmphead "pub(crate) const COMPOSITION_TABLE_KV:"
text astralhead "pub(crate) fn composition_table_astral("
text dechead "pub(crate) const CANONICAL_DECOMPOSED_KV:"
text uend "end"
text fnhead "fn uqinit"
text fntail " to void"
text uqcall "uqinit"
text inithead "fn unicodeinit to void"
text setrange "urange"
text setccc "put combining"
text addcomp "ucomposeadd"
text setdata "put decompdata"
text setdec "put decomp"

fn chars s view uchar * to void
for i ulong len s
tkpc ulong get s i
end
end

fn prefix s view uchar * n ulong to bool
if gt len s n
ret false
end
for i ulong len s
if ne get iline i get s i
ret false
end
end
ret true
end

fn beginrow name view uchar * to void
row = get genstate 1
if eq rem row 64 0
if gt row 0
chars uend
tkpc 10
end
chars fnhead
tcpu get genstate 2
chars fntail
tkpc 10
put genstate 2 add get genstate 2 1
end
put genstate 1 add row 1
chars name
end

fn argnum v ulong to void
tkpc 32
tcpu v
end

fn tag n ulong to ulong
if prefix rangeL n
ret 1
end
if prefix rangeM n
ret 2
end
if prefix rangeN n
ret 3
end
if prefix rangeS n
ret 4
end
if prefix ccchead n
ret 5
end
if prefix bmphead n
ret 6
end
if prefix astralhead n
ret 7
end
if prefix dechead n
ret 8
end
ret 0
end

fn hexval c uchar to ulong
if and ge c 48 le c 57
ret sub ulong c 48
end
if and ge c 65 le c 70
ret sub ulong c 55
end
if and ge c 97 le c 102
ret sub ulong c 87
end
ret 16
end

note Extract only hexadecimal integer literals and Rust Unicode scalar literals.
fn numbers n ulong to ulong
i = ulong 0
k = ulong 0
while lt add i 1 n
a = get iline i
b = get iline add i 1
if or and eq a 48 eq b 120 and eq a 117 eq b 123
i = add i 2
v = ulong 0
while lt i n
d = hexval get iline i
if eq d 16
break
end
v = add mul v 16 d
i = add i 1
end
put nums k v
k = add k 1
else
i = add i 1
end
end
ret k
end

fn emitrow n ulong to void
if eq n 0
ret
end
t = tag n
if ne t 0
put genstate 0 t
ret
end
if or eq get iline 0 125 eq get iline 0 93
put genstate 0 0
ret
end
t = get genstate 0
if eq t 0
ret
end
k = numbers n
if eq k 0
ret
end
v = get nums 0
if le t 4
if ne k 2
exit 3
end
beginrow setrange
argnum v
argnum get nums 1
argnum t
else
if eq t 5
beginrow setccc
argnum shr v 8
argnum and v 255
else
if eq t 6
beginrow addcomp
argnum shr v 16
argnum and v 65535
argnum get nums 1
else
if eq t 7
beginrow addcomp
argnum v
argnum get nums 1
argnum get nums 2
else
start = get genstate 3
for j ulong sub k 1
beginrow setdata
argnum add start j
argnum get nums add j 1
tkpc 10
end
put genstate 3 add start sub k 1
beginrow setdec
argnum v
argnum add mul start 8 sub k 1
end
end
end
end
tkpc 10
end

fn main to int
n = ulong 0
while true
r = read 0 page 0 len page
if lt r 0
ret 3
end
if eq r 0
break
end
for i ulong ulong r
c = get page i
if eq c 10
emitrow n
n = ulong 0
else
put iline n c
n = add n 1
end
end
end
emitrow n
chars uend
tkpc 10
chars inithead
tkpc 10
for i ulong get genstate 2
chars uqcall
tcpu i
tkpc 10
end
chars uend
tkpc 10
tkpfl
ret 0
end

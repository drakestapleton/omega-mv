note Private pipe transport. All frames use little-endian u32. EOF at a frame boundary closes normally.
global qwire uchar 8
fn qwireu n ulong to void
for j ulong 4
tkpc and shr n mul 8 j 255
end
end

fn qrequest to ulong
seen = ulong 0
while lt seen 4 bound 4
r = read 0 qwire seen sub 4 seen
if lt r 0
qwfail 60
end
if eq r 0
if ne seen 0
qwfail 60
end
ret 0
end
seen = add seen ulong r
end
n = ulong 0
for i ulong 4
n = or n shl ulong get qwire i mul 8 i
end
if or eq n 0 gt n 1048576
qwfail 60
end
r = enlarge input n
if lt r 0
qwfail 60
end
seen = ulong 0
while lt seen n bound 1048576
r = read 0 input seen sub n seen
if le r 0
qwfail 60
end
seen = add seen ulong r
end
ret n
end

fn qsessiontoken id ulong to void
qwireu id
if or eq id 248044 eq id 248046
qwireu 0
else
if ge id len sizes
qwfail 57
end
w = ulong get sizes id
if eq w 0
qwfail 57
end
qwireu w
emitword id
end
tkpfl
end

fn qsession cap ulong to void
qwireu 827216721
tkpfl
while true bound 4294967295
n = qrequest
if eq n 0
ret
end
put qnids 0 0
encodeinput n
count = get qnids 0
if or eq count 0 gt add count sub cap 1 8192
qwfail 56
end
qgenerate count cap
qwireu 4294967295
qwireu get qrun 3
qwireu count
qwireu get qrun 4
tkpfl
end
end

note Fixed architecture of the Qwen3.8-Flash-Next-FP8 text checkpoint. Every text tensor is bound before first use.
note Layer roles: 2-10 linear attention, 11-16 full attention, 20-24 router and shared expert,
note 25-28 attention hyper-connection, 29-32 expert hyper-connection, 33-35 indexer, 36-45 lexical layer,
note 64+3e gate, up and down of routed expert e.
global qcfg ulong 12
global qrole uint 76800
global qscale uint 196608
global qbound uchar 196608
global qglob uint 8
global qngram uint 128
text qlayerprefix "model.language_model.layers."
text qexpertprefix "mlp.experts."
text qsep "."
text qscalesuffix "_scale_inv"
text qembed "model.language_model.embed_tokens.weight"
text qlm "lm_head.weight"
text qmixn "model.language_model.hyper_connection_mixer.hc_norm.weight"
text qmixd "model.language_model.hyper_connection_mixer.input_mix_weight_down.weight"
text qmixu "model.language_model.hyper_connection_mixer.input_mix_weight_up.weight"
fn qappend buf edit uchar * pos ulong frag view uchar * to ulong
for i ulong len frag
put buf add pos i get frag i
end
ret add pos len frag
end

fn qdecimal buf edit uchar * pos ulong x ulong to ulong
p = pos
if ge x 100
put buf p uchar add 48 div x 100
p = add p 1
end
if ge x 10
put buf p uchar add 48 rem div x 10 10
p = add p 1
end
put buf p uchar add 48 rem x 10
ret add p 1
end

fn qresolven frag view uchar * n ulong to ulong
buf = new uchar 256 0
p = ulong 0
l = get qcfg 7
if lt l 64
p = qappend buf p qlayerprefix
p = qdecimal buf p l
p = qappend buf p qsep
e = get qcfg 8
if gt e 0
p = qappend buf p qexpertprefix
p = qdecimal buf p sub e 1
p = qappend buf p qsep
end
end
for i ulong n
put buf add p i get frag i
end
ret qwid buf add p n
end

fn qresolve frag view uchar * to ulong
ret qresolven frag len frag
end

fn qbindid id ulong dtype ulong to void
if or ne ulong get qwdtype id dtype ne get qbound id 0
qwfail 40
end
put qbound id 1
end

fn qbind slot ulong frag view uchar * dtype ulong to ulong
id = qresolve frag
qbindid id dtype
put qrole add get qcfg 9 slot uint id
ret id
end

fn qrank2 id ulong rows ulong cols ulong to void
if ne get qwrank id 2
qwfail 41
end
base = mul id 4
if or ne get qwshape base rows ne get qwshape add base 1 cols
qwfail 41
end
end

fn qlinkscale id ulong rows ulong cols ulong to void
buf = new uchar 256 0
p = ulong get qwnpos id
n = ulong get qwnlen id
for j ulong n
put buf j get qwname add p j
end
n = qappend buf n qscalesuffix
s = qwid buf n
qbindid s 2
qrank2 s div add rows 127 128 div add cols 127 128
put qscale id uint s
end

fn qmatrix slot ulong frag view uchar * rows ulong cols ulong dtype ulong to void
id = qbind slot frag dtype
qrank2 id rows cols
if eq dtype 1
qlinkscale id rows cols
end
end

fn qvecshape id ulong size ulong to void
if or ne get qwrank id 1 ne get qwshape mul id 4 size
qwfail 43
end
end

fn qvector slot ulong frag view uchar * size ulong to void
id = qbind slot frag 2
qvecshape id size
end

fn qvector64 slot ulong frag view uchar * size ulong to void
id = qbind slot frag 8
qvecshape id size
end

fn qconv slot ulong frag view uchar * to void
id = qbind slot frag 2
a = mul id 4
if or ne get qwrank id 3 ne get qwshape a 10240
qwfail 44
end
if or ne get qwshape add a 1 1 ne get qwshape add a 2 4
qwfail 44
end
end

text qp2 "linear_attn.A_log"
text qp3 "linear_attn.dt_bias"
text qp4 "linear_attn.in_proj_a.weight"
text qp5 "linear_attn.in_proj_b.weight"
text qp6 "linear_attn.in_proj_qkv.weight"
text qp7 "linear_attn.in_proj_z.weight"
text qp8 "linear_attn.norm.weight"
text qp9 "linear_attn.out_proj.weight"
text qp10 "linear_attn.conv1d.weight"
fn qgdnweights to void
qvector 2 qp2 48
qvector 3 qp3 48
qmatrix 4 qp4 48 2560 2
qmatrix 5 qp5 48 2560 2
qmatrix 6 qp6 10240 2560 2
qmatrix 7 qp7 6144 2560 2
qvector 8 qp8 128
qmatrix 9 qp9 2560 6144 2
qconv 10 qp10
end

text qp11 "self_attn.q_norm.weight"
text qp12 "self_attn.k_norm.weight"
text qp13 "self_attn.q_proj.weight"
text qp14 "self_attn.k_proj.weight"
text qp15 "self_attn.v_proj.weight"
text qp16 "self_attn.o_proj.weight"
text qp33 "self_attn.indexer.index_qk_proj.weight"
text qp34 "self_attn.indexer.k_layernorm.weight"
text qp35 "self_attn.indexer.q_layernorm.weight"
fn qattnweights to void
qvector 11 qp11 256
qvector 12 qp12 256
qmatrix 13 qp13 12288 2560 2
qmatrix 14 qp14 512 2560 2
qmatrix 15 qp15 512 2560 2
qmatrix 16 qp16 2560 6144 2
qmatrix 33 qp33 640 2560 2
qvector 34 qp34 128
qvector 35 qp35 128
end

text qp20 "mlp.gate.weight"
text qp21 "mlp.shared_expert_gate.weight"
text qp22 "mlp.shared_expert.gate_proj.weight"
text qp23 "mlp.shared_expert.up_proj.weight"
text qp24 "mlp.shared_expert.down_proj.weight"
fn qrouterweights to void
qmatrix 20 qp20 512 2560 2
qmatrix 21 qp21 1 2560 2
qmatrix 22 qp22 640 2560 2
qmatrix 23 qp23 640 2560 2
qmatrix 24 qp24 2560 640 2
end

text qp25 "attn_hyper_connection.hc_norm.weight"
text qp26 "attn_hyper_connection.input_mix_weight_down.weight"
text qp27 "attn_hyper_connection.input_mix_weight_up.weight"
text qp28 "attn_hyper_connection.block_inject_weight.weight"
text qp29 "mlp_hyper_connection.hc_norm.weight"
text qp30 "mlp_hyper_connection.input_mix_weight_down.weight"
text qp31 "mlp_hyper_connection.input_mix_weight_up.weight"
text qp32 "mlp_hyper_connection.block_inject_weight.weight"
fn qhyperweights to void
qvector 25 qp25 10240
qmatrix 26 qp26 320 10240 2
qmatrix 27 qp27 10240 320 2
qmatrix 28 qp28 4 10240 2
qvector 29 qp29 10240
qmatrix 30 qp30 320 10240 2
qmatrix 31 qp31 10240 320 2
qmatrix 32 qp32 4 10240 2
end

text qp36 "ple.conv1d.weight"
text qp37 "ple.key_proj.weight"
text qp38 "ple.norm_conv.weight"
text qp39 "ple.norm_key.weight"
text qp40 "ple.norm_query.weight"
text qp41 "ple.value_proj.weight"
text qp42 "ple.ple_embedding.layer_multipliers"
text qp43 "ple.ple_embedding.ngram_heads_offsets"
text qp44 "ple.ple_embedding.ngram_heads_vocab_sizes"
text qp45 "ple.ple_embedding.ngram_embedding.weight_scale"
text qngpre "ple.ple_embedding.ngram_embedding.shard_"
text qngsuf ".weight"
fn qlexicalweights to void
qconv 36 qp36
qmatrix 37 qp37 10240 2560 2
qvector 38 qp38 10240
qvector 39 qp39 10240
qvector 40 qp40 10240
qmatrix 41 qp41 2560 2560 2
qvector64 42 qp42 3
qvector64 43 qp43 16
qvector64 44 qp44 16
qvector 45 qp45 1
frag = new uchar 64 0
for s ulong 128
n = qappend frag 0 qngpre
n = qdecimal frag n s
n = qappend frag n qngsuf
id = qresolven frag n
qbindid id 1
qrank2 id 2500012 160
put qngram s uint id
end
end

text qeg "gate_proj.weight"
text qeu "up_proj.weight"
text qed "down_proj.weight"
fn qlayerweights layer ulong to void
put qcfg 7 layer
put qcfg 8 0
put qcfg 9 mul layer 1600
if eq rem layer 4 3
qattnweights
else
qgdnweights
end
qrouterweights
qhyperweights
if eq layer 1
qlexicalweights
end
for e ulong 512
put qcfg 8 add e 1
slot = add 64 mul e 3
qmatrix slot qeg 640 2560 1
qmatrix add slot 1 qeu 640 2560 1
qmatrix add slot 2 qed 2560 640 1
end
end

fn qglobal slot ulong name view uchar * dtype ulong to ulong
id = qwid name len name
qbindid id dtype
put qglob slot uint id
ret id
end

fn qprofile layers ulong to void
if ne layers 48
qwfail 45
end
put qcfg 0 layers
put qcfg 1 2560
put qcfg 2 2048
put qcfg 3 6144
put qcfg 4 6144
put qcfg 5 512
put qcfg 6 640
for l ulong layers
qlayerweights l
end
put qcfg 7 64
put qcfg 8 0
put qcfg 9 0
qrank2 qglobal 0 qembed 2 248320 2560
qrank2 qglobal 1 qlm 2 248320 2560
id = qglobal 2 qmixn 2
if or ne get qwrank id 1 ne get qwshape mul id 4 10240
qwfail 43
end
qrank2 qglobal 3 qmixd 2 320 10240
qrank2 qglobal 4 qmixu 2 10240 320
for i ulong get qwstate 1
if eq get qbound add i 1 0
qwfail 46
end
end
end

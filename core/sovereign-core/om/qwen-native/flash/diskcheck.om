note The installation unit binds each fd to a full SHA-256-verified immutable byte identity on this Spark.
note Linux arm64 stat layout. Device, inode, size, mtime and ctime (seconds and nanoseconds).
fn qstatword off ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get qwstat add off i mul 8 i
end
ret v
end
fn qdiskcheck shard ulong to void
p = mul shard 7
if or ne qstatword 0 get qdiskpin p ne qstatword 8 get qdiskpin add p 1
qwfail 59
end
if ne qstatword 48 get qdiskpin add p 2
qwfail 59
end
for j ulong 4
off = add 88 mul j 8
if ne qstatword off get qdiskpin add add p 3 j
qwfail 59
end
end
end
fn qdiskinit layers ulong to void
if ne layers 48
qwfail 59
end
qdisk38
end
fn qrestat shard ulong to void
if ne fstat int get qwfd shard qwstat 0 128 0
qwfail 59
end
qdiskcheck shard
end
fn qdiskrecheck to void
for s ulong 131
qrestat s
end
end

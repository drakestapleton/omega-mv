note Argument, token-list and counter helpers shared by the command-line engine and the server.
global qids uint 8192
global qnids ulong 1
global qidmode ulong 1
global qintbuf uchar 32
fn qnumber buf view uchar * n ulong to ulong
if or eq n 0 gt n 7
qwfail 56
end
v = ulong 0
for i ulong n
c = get buf i
if or lt c 48 gt c 57
qwfail 56
end
v = add mul v 10 sub ulong c 48
end
ret v
end

fn qnumericarg a ulong to ulong
b = new uchar 8 0
n = argread a b 0 8
if le n 0
qwfail 56
end
ret qnumber b ulong n
end

fn outid id ulong to void
n = get qnids 0
if or ge n len qids ge id len sizes
qwfail 56
end
put qids n uint id
put qnids 0 add n 1
end

fn qprintid id ulong to void
v = id
p = ulong 31
put qintbuf p 10
while true bound 8
p = sub p 1
put qintbuf p uchar add 48 rem v 10
v = div v 10
if eq v 0
break
end
end
while lt p 32 bound 32
w = write 1 qintbuf p sub 32 p
if le w 0
qwfail 57
end
p = add p ulong w
end
end

text fstat0 "expert loads "
text fstat1 " evictions "
text fstat2 " device launches "
fn fstatnum v ulong to void
b = new uchar 24 0
p = ulong 23
x = v
put b p 32
while true bound 22
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 2 b p sub 24 p
end

fn fstats to void
r = write 2 fstat0 0 len fstat0
fstatnum get qecfg 4
r = write 2 fstat1 0 len fstat1
fstatnum get qecfg 5
r = write 2 fstat2 0 len fstat2
fstatnum get qecfg 6
b = new uchar 1 10
r = write 2 b 0 1
end


note Build-time seeded Omega attestor for Flash-Next (131 shards). Emits host bindings only after hashing each opened file and comparing stats on the same descriptor.
note Usage: attest MODEL_DIR [START COUNT]. Without START COUNT, emits the full install.om for shards 0..131.
global qa_path uchar 4300
global qa_root uchar 4096
global qa_input uchar 65536
global qa_stat uchar 128
global qa_before ulong 7
global qa_info ulong 1
text qa_declare "global qdiskpin ulong 917"
text qa_f38 "fn qdisk38 to void"
text qa_end "end"
text qa_put "put qdiskpin "
text qa_layer "/model-00"
text qa_suffix "-of-00131.safetensors"
fn qa_print s view uchar * to void
for i ulong len s
tkpc ulong get s i
end
end
fn qa_num arg ulong to ulong
b = new uchar 32 0
n = argread arg b 0 31
if le n 0
exit 2
end
v = ulong 0
for i ulong ulong n
c = ulong get b i
if or lt c 48 gt c 57
exit 2
end
v = add mul v 10 sub c 48
end
ret v
end
fn qa_word off ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get qa_stat add i off mul i 8
end
ret v
end
fn qa_value j ulong to ulong
if eq j 0
ret qa_word 0
end
if eq j 1
ret qa_word 8
end
if eq j 2
ret qa_word 48
end
ret qa_word add 88 mul sub j 3 8
end
fn qa_cat p ulong s view uchar * to ulong
for i ulong len s
put qa_path add p i get s i
end
ret add p len s
end
fn qa_name j ulong to ulong
n = get qa_info 0
for i ulong n
put qa_path i get qa_root i
end
p = qa_cat n qa_layer
f = add j 1
put qa_path p uchar add 48 div f 100
put qa_path add p 1 uchar add 48 rem div f 10 10
put qa_path add p 2 uchar add 48 rem f 10
ret qa_cat add p 3 qa_suffix
end
fn qa_hash fd int to void
hreset
while true bound 1048577
r = read fd qa_input 0 len qa_input
if lt r 0
exit 3
end
if eq r 0
break
end
for i ulong ulong r
if not hpush get qa_input i
exit 3
end
end
end
if not hfinal
exit 3
end
end
fn qa_shard j ulong to void
n = qa_name j
fd = fopen qa_path 0 n 557056 0
if lt fd 0
exit 2
end
if ne fstat int fd qa_stat 0 128 0
exit 3
end
for i ulong 7
put qa_before i qa_value i
end
qa_hash int fd
for c ulong 64
if ne get hd c qa_expected j c
exit 4
end
end
if ne fstat int fd qa_stat 0 128 0
exit 3
end
for i ulong 7
if ne get qa_before i qa_value i
exit 5
end
qa_print qa_put
tcpu add mul j 7 i
tkpc 32
tcpu get qa_before i
tkpc 10
end
r = fclose int fd
if ne r 0
exit 3
end
end
fn main to int
if and ne argcnt 2 ne argcnt 4
ret 2
end
n = argread 1 qa_root 0 4095
if le n 0
ret 2
end
put qa_info 0 ulong n
if eq argcnt 2
qa_print qa_declare
tkpc 10
qa_print qa_f38
tkpc 10
for j ulong 131
qa_shard j
end
qa_print qa_end
tkpc 10
tkpfl
ret 0
end
start = qa_num 2
count = qa_num 3
if or gt start 131 gt count sub 131 start
ret 2
end
for k ulong count
qa_shard add start k
end
tkpfl
ret 0
end

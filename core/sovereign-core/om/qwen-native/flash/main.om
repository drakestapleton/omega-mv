note flash-engine 38 MODEL_DIR CAP [MODE [DEVICE [SLOTS]]], rendered UTF-8 prompt on stdin.
note MODE 0 writes text, 1 prints token IDs, 2 serves the framed pipe, 3 writes the BF16 final hidden row and logits of each step,
note 4 writes the BF16 residual streams after every layer of every token.
note DEVICE 0 runs matrix products on GB10, 1 computes them on the host. SLOTS bounds resident routed experts.
global qintbuf uchar 32
fn qnumber buf view uchar * n ulong to ulong
if or eq n 0 gt n 7
qwfail 56
end
v = ulong 0
for i ulong n
c = get buf i
if or lt c 48 gt c 57
qwfail 56
end
v = add mul v 10 sub ulong c 48
end
ret v
end

fn qnumericarg a ulong to ulong
b = new uchar 8 0
n = argread a b 0 8
if le n 0
qwfail 56
end
ret qnumber b ulong n
end

fn outid id ulong to void
n = get qnids 0
if or ge n len qids ge id len sizes
qwfail 56
end
put qids n uint id
put qnids 0 add n 1
end

fn qprintid id ulong to void
v = id
p = ulong 31
put qintbuf p 10
while true bound 8
p = sub p 1
put qintbuf p uchar add 48 rem v 10
v = div v 10
if eq v 0
break
end
end
while lt p 32 bound 32
w = write 1 qintbuf p sub 32 p
if le w 0
qwfail 57
end
p = add p ulong w
end
end

fn fdumpbits bits uint to void
tkpc ulong and bits 255
tkpc ulong shr bits 8
end

fn fdump to void
for j ulong 2560
fdumpbits shr bitcast uint get fx j 16
end
for j ulong 248320
fdumpbits shr bitcast uint get fout j 16
end
tkpfl
end

fn femit id ulong to void
mode = get qidmode 0
if eq mode 1
qprintid id
end
if eq mode 2
qsessiontoken id
end
if eq mode 3
fdump
end
end

fn qgenerate count ulong cap ulong to void
id = ulong 0
for j ulong count
id = qtoken ulong get qids j j eq add j 1 count
end
for j ulong cap
put qrun 3 0
put qrun 4 add j 1
femit id
if or eq id 248044 eq id 248046
put qrun 3 1
ret
end
if eq get qidmode 0 0
if ge id len sizes
qwfail 57
end
if eq get sizes id 0
qwfail 57
end
emitword id
tkpfl
end
if lt add j 1 cap
id = qtoken id add count j true
end
end
end

text fstat0 "expert loads "
text fstat1 " evictions "
text fstat2 " device launches "
fn fstatnum v ulong to void
b = new uchar 24 0
p = ulong 23
x = v
put b p 32
while true bound 22
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 2 b p sub 24 p
end

fn fstats to void
r = write 2 fstat0 0 len fstat0
fstatnum get qecfg 4
r = write 2 fstat1 0 len fstat1
fstatnum get qecfg 5
r = write 2 fstat2 0 len fstat2
fstatnum get qecfg 6
b = new uchar 1 10
r = write 2 b 0 1
end

fn main to int
if or lt argcnt 4 gt argcnt 7
ret 2
end
if ne qnumericarg 1 38
ret 2
end
cap = qnumericarg 3
if or eq cap 0 gt cap 1024
ret 2
end
slots = ulong 8320
if ge argcnt 5
mode = qnumericarg 4
if gt mode 5
ret 2
end
put qidmode 0 mode
if eq mode 4
put fdebug 0 1
end
if eq mode 5
put fdebug 0 2
end
end
if ge argcnt 6
dev = qnumericarg 5
if gt dev 1
ret 2
end
put qecfg 0 dev
end
if eq argcnt 7
slots = qnumericarg 6
if or lt slots 16 gt slots 26624
ret 2
end
end
put qecfg 1 slots
loadmodel
if ne get qtidentity 0 27
qwfail 59
end
unicodeinit
qwload 2 48
qprofile 48
put qrun 0 38
if eq get qecfg 0 0
qgpuopen
end
if eq get qidmode 0 2
qsession cap
else
encodeinput inputsize
count = get qnids 0
if eq count 0
qwfail 56
end
if eq get qidmode 0 5
for j ulong count
fstatnum ulong get qids j
end
end
if gt add count sub cap 1 2048
qwfail 56
end
qgenerate count cap
end
tkpfl
fstats
if eq get qecfg 0 0
if not lqclose
ret 58
end
end
ret 0
end

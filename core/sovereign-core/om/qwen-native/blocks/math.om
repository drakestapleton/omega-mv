note Scalar operators from Core om/flint/ops.om, names scoped for composition.
fn qb_exp x f64 to f64
if lt x -708.0f64
ret 0.0f64
end
if gt x 709.0f64
ret div 1.0f64 0.0f64
end
kf = mul x 1.442695040888963407f64
if lt kf 0.0f64
kf = sub kf 0.5f64
else
kf = add kf 0.5f64
end
k = long kf
fk = f64 k
r = sub sub x mul fk 0.6931471803691238165f64 mul fk 1.908214929270587816e-10f64
p = 1.0f64
for j ulong 13
p = add 1.0f64 mul div r f64 sub 13 j p
end
s = bitcast f64 shl ulong add k 1023 52
ret mul p s
end

fn qb_sig x f64 to f64
ret div 1.0f64 add 1.0f64 qb_exp neg x
end

note sin (c false) or cos (c true) of x in [0, 2^20): k = round(x 2 / pi), reduction by
note pio2_hi (33 bits) and pio2_lo, Taylor through degree 21 on |r| <= pi / 4
fn qb_sc x f64 c bool to f64
k = ulong add mul x 0.6366197723675813431f64 0.5f64
fk = f64 k
r = sub sub x mul fk 1.570796326734125614f64 mul fk 6.077100506506192601e-11f64
z = mul r r
s = 1.0f64
co = 1.0f64
for j ulong 10
m = f64 mul 2 sub 10 j
s = sub 1.0f64 mul div z mul m add m 1.0f64 s
co = sub 1.0f64 mul div z mul sub m 1.0f64 m co
end
s = mul r s
q = k
if c
q = add q 1
end
q = and q 3
if eq q 0
ret s
end
if eq q 1
ret co
end
if eq q 2
ret neg s
end
ret neg co
end

note log1p(exp(x)) = max(x,0) + 2 atanh(t/(2+t)), t=exp(-abs(x)).
note The series argument has magnitude at most one third.
fn qb_softplus x f32 to f32
if gt x 20.0f32
ret x
end
t = qb_exp neg fabs f64 x
u = div t add 2.0f64 t
v = mul u u
p = 0.0f64
for j ulong 14
p = add div 1.0f64 f64 sub 27 mul 2 j mul p v
end
ret f32 add f64 fmax x 0.0f32 mul mul 2.0f64 u p
end

global qb_next ulong 64
global qb_model ulong 64

fn qb_check model ulong layer ulong pos ulong full bool to void
if and ne model 27 ne model 35
trap 5
end
if or ge layer 64 and eq model 35 ge layer 40
trap 5
end
if ne full eq rem layer 4 3
trap 5
end
if ge pos 8192
trap 5
end
if ne pos 0
if or ne pos get qb_next layer ne model get qb_model layer
trap 5
end
end
end

note Test-only binary transport. Header model, absolute layer, token position, then x and w.
global qt_wire uchar 164736

fn qt_read n ulong to void
offset = ulong 0
while lt offset n bound 164737
got = read 0 qt_wire offset sub n offset
if le got 0
exit 2
end
offset = add offset ulong got
end
end

fn qt_word j ulong to uint
p = mul j 4
v = uint get qt_wire p
for k ulong 3
v = or v shl uint get qt_wire add add p 1 k uint mul add k 1 8
end
ret v
end

fn qt_load a edit f32 * to void
qt_read mul len a 4
for j ulong len a
put a j bitcast f32 qt_word j
end
end

fn qt_output a view f32 6144 to void
for j ulong 6144
bits = bitcast uint get a j
for k ulong 4
put qt_wire add mul j 4 k uchar and shr bits uint mul k 8 255
end
end
offset = ulong 0
while lt offset 24576 bound 24577
got = write 1 qt_wire offset sub 24576 offset
if le got 0
exit 3
end
offset = add offset ulong got
end
end

note Emit 128 state/cache probes after each output, in the same fixed frame format.
fn qt_matrix slot ulong heads ulong j ulong to f32
h = rem j heads
r = rem mul j 23 128
v = rem add mul j 37 1 128
idx = add mul rem slot 16 48 h
idx = add mul idx 16384 mul r 128
idx = add idx v
ret qd_state_get div slot 16 idx
end

fn qt_delta_state m ulong l ulong y edit f32 6144 to void
slot = sub l div l 4
heads = ulong 48
if eq m 35
heads = ulong 32
end
for j ulong 64
put y j qt_matrix slot heads j
idx = add mul slot 30720 mul rem j 3 10240
idx = add idx rem mul j 7919 add 4096 mul heads 128
put y add j 64 get qd_tail idx
end
qt_output y
end

fn qt_att_state m ulong l ulong p ulong y edit f32 6144 to void
nk = ulong 4
if eq m 35
nk = ulong 2
end
slot = div l 4
for j ulong 64
idx = qa_row_offset slot p nk rem j nk
idx = add idx rem mul j 19 256
pair = qa_cache_get div slot 2 idx
put y j bitcast f32 and pair 4294901760
put y add j 64 bitcast f32 shl pair 16
end
qt_output y
end

fn qt_delta m ulong l ulong p ulong to void
x = new f32 16480 0.0f32
w = new f32 41184 0.0f32
y = new f32 6144 0.0f32
qt_load x
qt_load w
qwen_delta_step m l p x w y
qt_output y
qt_delta_state m l y
end

fn qt_attention m ulong l ulong p ulong to void
x = new f32 14336 0.0f32
w = new f32 512 0.0f32
y = new f32 6144 0.0f32
qt_load x
qt_load w
note For the boundary fixture only, install a known prefix of all-zero KV rows.
if eq p 8191
put qb_model l m
put qb_next l p
end
qwen_attention_step m l p x w y
qt_output y
qt_att_state m l p y
end

fn main to int
qt_read 4
count = ulong qt_word 0
for j ulong count
qt_read 12
m = ulong qt_word 0
l = ulong qt_word 1
p = ulong qt_word 2
if eq rem l 4 3
qt_attention m l p
else
qt_delta m l p
end
end
ret 0
end

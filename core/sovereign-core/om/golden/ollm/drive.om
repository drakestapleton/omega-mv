apt tdash
aps STRN
apt tcatf
apt tdash_e
scp SV SLK
sx SV tcommit
aps SV
rc = spawn -1 -1 -1
if ne rc 0
sset SD ttuw
ss SD SLK
ret notrun ttu SD
end
scp SREV SLK
if not senv SGD tgdir
if senv SGD tmdir
sx SGD tolg
else
ok = senv SGD thome
sx SGD tmodels
sx SGD tolg
end
end
ok = refval SV tckk
sjoin SCK SGD tnl0
ss SCK SV
ok = refval SV tmgk
sjoin SMG SGD tnl0
ss SMG SV
if not there SCK
ret notrun tmm SCK
end
if not there SMG
ret notrun tmm SMG
end
ok = senv SOMC taomctr
ok = senv SOMG taomcgt
sset ST tgcore
sn ST ulong getpid
ok = mkd ST
sjoin SOUT ST tgg
ok = fsha SREF SHEX
sset SM tobs
sx SM tgrec
sx SM tsp
sx SM tq
ss SM SHEX
sx SM tq
say 1 SM
rc = dgate
rmrf ST
if eq rc 0
obs tgpass ttrue false
obs tgneg ttrue false
ret 0
end
if eq rc 1
obs tgpass tfalse false
obs tgneg ttrue false
ret 1
end
if eq rc 3
sset SD tgnr3
ret notrun tgnr SD
end
obs tgpass tfalse false
obs tgneg tfalse false
ret 1
end


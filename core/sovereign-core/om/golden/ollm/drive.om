note true when OUT/am/commit holds exactly the commit id in slot SREV
fn gbid am view uchar * to bool
sset SX tsl0
ss SX SOUT
sb SX 47
sx SX am
sb SX 47
sx SX tcmt
ok = fload SX
if not ok
ret false
end
trimnl
lslot SV 0 get gbn 0
ret seqs SV SREV
end

note drive gate: slots SOMC SOMG STRN SREV SREF SCK SMG SPR SOUT
fn dgate to ulong
if not hold
sayt 1 tnohold
ret 3
end
if there SOUT
sset SM texists
ss SM SOUT
say 2 SM
ret 2
end
ok = mkp SOUT
note REV resolves once, through the private repository OUT/src.git, to a full commit id. That
note repository's HEAD is pinned to the id and both builds fetch from it, not from TRAIN, so a branch
note moved (or a ref deleted) in TRAIN between the builds cannot split them; each build's commit
note must still equal the id
rc = rslv
if ne rc 0
ret verdn tbres rc tnl0 4
end
agit
apt tdash
aps SZ
apt tupref
apt tnoderef
apt thead
aps SSHA
rc = spawnf SQ
if ne rc 0
ret verdn tbres rc tnl0 4
end
scp STRN SZ
scp SREV SSHA
sjoin SG SOUT tgateb
sset SP tgateom
rc = gcomp SOMG SP SG
if eq rc 3
ret verd tngate 3
end
if ne rc 0
ret verdn tbgate rc tnl0 4
end
rc = gbarm tcand false
if eq rc 3
ret verd tndec 3
end
if ne rc 0
ret verdn tbcand rc tnl0 4
end
if not gbid tcand
ret verd tbidc 4
end
rc = gbarm tnegd true
if eq rc 3
ret verd tndec 3
end
if ne rc 0
ret verdn tbnegb rc tnl0 4
end
if not gbid tnegd
ret verd tbidn 4
end
if not rmaxt SREF
ret verd tnomx 3
end
scp SMX SV
ok = pld SPR
if not ok
ret verd tnoprm 4
end
c = grarm tcand
nc = grarm tnegd
if eq c 3
ret verd tnocmp 3
end
if ne nc 1
ret verdn tbneg nc tbneg2 4
end
if eq c 0
ret verd tpass 0
end
if eq c 1
ret verd tfailv 1
end
ret verdn tbcmp c tnl0 4
end

note ---- record

fn sutc s ulong to void
ns = realns
sec = div ulong ns 1000000000
rs = rem sec 86400
sdate s div sec 86400
sn2 s div rs 3600
sb s 58
sn2 s div rem rs 3600 60
sb s 58
sn2 s rem rs 60
sb s 90
end

fn sdate s ulong days ulong to void
z = add days 719468
era = div z 146097
doe = sub z mul era 146097
a = sub doe div doe 1460
a = add a div doe 36524
a = sub a div doe 146096
yoe = div a 365
y = add yoe mul era 400
a = mul 365 yoe
a = add a div yoe 4
a = sub a div yoe 100
doy = sub doe a
mp = div add mul 5 doy 2 153
a = div add mul 153 mp 2 5
d = add sub doy a 1
m = add mp 3
if ge mp 10
m = sub mp 9
end
if le m 2
y = add y 1
end
sn s y
sb s 45
sn2 s m
sb s 45
sn2 s d
sb s 84
end

fn shost s ulong to void
sclr s
sset SP thostf
ok = fload SP
if not ok
ret
end
for i ulong get gbn 0
c = get gb i
if or eq c 46 eq c 10
ret
end
sb s c
end
end


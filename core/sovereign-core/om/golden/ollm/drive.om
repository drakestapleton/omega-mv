fn dcheck to ulong
put gk 1 0
sset SP tgateom
if not there SP
sayt 2 tnoroot
ret 2
end
ok = senv SOMG tomcgt
sabs SOMG
sset ST tgchk
sn ST ulong getpid
ok = mkd ST
ctmp SG tgateb
sset SP tgateom
rc = gcomp SOMG SP SG
if ne rc 0
rmrf ST
ret rc
end
cfx SF1 tfck
cfx SF2 tfmg
cfx SF3 tfpr
sset SE tnl0
for i ulong 64
sb SE 101
end
sset SC2 tfsrc
chk1
chk2
chk3
chk4
chk5
tr = senv STRN ttrainv
om = senv SOMC tomctr
if and tr om
sabs STRN
sabs SOMC
sclr SNEG
chk6
chk7
chk8
else
sayt 1 tcnor
end
rmrf ST
if eq get gk 1 0
sayt 1 tcgood
ret 0
end
sayt 1 tcbad
ret 1
end

note ---- main

fn argabs s ulong i ulong to void
ok = sarg s i
if not ok
sayt 2 tuse
exit 2
end
sabs s
end

fn main to int
na = ulong argcnt
if lt na 2
sayt 2 tuse
ret 2
end
ok = sarg SM 1
sset SP tgateom
if not there SP
sayt 2 tnoroot
ret 2
end
if seqt SM tbuild
if or lt na 6 gt na 7
sayt 2 tuse
ret 2
end
argabs SOMC 2
argabs STRN 3
ok = sarg SREV 4
argabs SOUT 5
sclr SNEG
if eq na 7
argabs SNEG 6
end
ret int dbuild
end
if seqt SM trecord
if or lt na 8 gt na 9
sayt 2 tuse
ret 2
end
argabs STRN 2
ok = sarg SREV 3
argabs SCK 4
argabs SMG 5
argabs SPR 6
argabs SOUT 7
sset SLAB treal
if eq na 9
ok = sarg SLAB 8
end
ok = senv SOMC tomctr
sabs SOMC
ok = senv SOMG tomcgt
sabs SOMG
ret int drec
end
if seqt SM tgate
if ne na 9
sayt 2 tuse
ret 2
end
argabs STRN 2
ok = sarg SREV 3
argabs SREF 4
argabs SCK 5
argabs SMG 6
argabs SPR 7
argabs SOUT 8
ok = senv SOMC tomctr
sabs SOMC
ok = senv SOMG tomcgt
sabs SOMG
ret int dgate
end
if seqt SM tcore
ret int dcore
end
if seqt SM tcheck
ret int dcheck
end
sayt 2 tuse
ret 2
end

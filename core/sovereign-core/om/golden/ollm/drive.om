note first 600 bytes of slot s's file, trailing newlines dropped, appended to SM
fn chead s ulong to void
ok = fload s
if gt get gbn 0 600
put gbn 0 600
end
trimnl
for i ulong get gbn 0
sb SM get gb i
end
end

note does slot s's file hold a line equal to slot l
fn hasln s ulong l ulong to bool
ok = fload s
if not ok
ret false
end
p = ulong 0
n = get gbn 0
while lt p n bound 999999
e = leol p
if lis p e l
ret true
end
p = add e 1
end
ret false
end

note run gav into ST/out; judge exit want and (when slot SW is not empty) the line SW
fn arm nm view uchar * want ulong to void
ctmp SD tcout
rc = spawnf SD
if ne rc want
sset SM tcfail
sx SM nm
sx SM tcolon
sx SM tcex
sn SM rc
sx SM tcwant
sn SM want
sx SM tcolon
chead SD
say 1 SM
cbad
ret
end
if gt get gsl SW 0
if not hasln SD SW
sset SM tcfail
sx SM nm
sx SM tcnol
ss SM SW
sx SM tcin
chead SD
say 1 SM
cbad
ret
end
end
sset SM tcpass
sx SM nm
sx SM tcexit
sn SM rc
if gt get gsl SW 0
sx SM tcq1
ss SM SW
sb SM 39
end
sx SM tcend
say 1 SM
end


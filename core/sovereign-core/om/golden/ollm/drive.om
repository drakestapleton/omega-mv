note ---- string slots: slot s holds gsl[s] bytes at gs[s*SCAP ..]

fn sb s ulong c uchar to void
n = get gsl s
if ge n SCAP
w = write 2 tlong 0 len tlong
exit 2
end
put gs add mul s SCAP n c
put gsl s add n 1
end

fn sclr s ulong to void
put gsl s 0
end

fn sx s ulong t view uchar * to void
for i ulong len t
sb s get t i
end
end

fn sset s ulong t view uchar * to void
sclr s
sx s t
end

fn sc s ulong i ulong to uchar
ret get gs add mul s SCAP i
end

fn ss s ulong r ulong to void
for i ulong get gsl r
sb s sc r i
end
end

fn scp s ulong r ulong to void
sclr s
ss s r
end

fn sn s ulong v ulong to void
d = new uchar 24 0
n = ulong 0
x = v
while true bound 21
put d n uchar add rem x 10 48
n = add n 1
x = div x 10
if eq x 0
break
end
end
for i ulong n
sb s get d sub sub n 1 i
end
end

fn sn2 s ulong v ulong to void
if lt v 10
sb s 48
end
sn s v
end

fn seqt s ulong t view uchar * to bool
if ne get gsl s len t
ret false
end
for i ulong len t
if ne sc s i get t i
ret false
end
end
ret true
end

fn seqs a ulong b ulong to bool
if ne get gsl a get gsl b
ret false
end
for i ulong get gsl a
if ne sc a i sc b i
ret false
end
end
ret true
end

fn sarg s ulong i ulong to bool
r = argread i gs mul s SCAP SCAP
if lt r 0
ret false
end
put gsl s ulong r
ret true
end

fn envhas t view uchar * r ulong to bool
if le r len t
ret false
end
for i ulong len t
if ne get gio i get t i
ret false
end
end
ret eq get gio len t 61
end

note slot s = value of environment entry t; false when absent or empty
fn senv s ulong t view uchar * to bool
sclr s
n = envcnt
if le n 0
ret false
end
for i ulong ulong n
r = envread i gio 0 65536
if gt r 0
if envhas t ulong r
k = add len t 1
m = sub ulong r k
for j ulong m
sb s get gio add k j
end
ret gt get gsl s 0
end
end
end
ret false
end

note slot s made absolute against the current directory
fn sabs s ulong to void
if eq get gsl s 0
ret
end
if eq sc s 0 47
ret
end
r = cwd gio 0 65536
if le r 1
exit 2
end
sclr SCWD
for i ulong sub ulong r 1
sb SCWD get gio i
end
sb SCWD 47
ss SCWD s
scp s SCWD
end

note ---- output: slot s and a newline to fd

fn wslot fd int s ulong to void
n = get gsl s
o = mul s SCAP
p = ulong 0
while lt p n bound 9999
w = write fd gs add o p sub n p
if le w 0
ret
end
p = add p ulong w
end
end

fn say fd int s ulong to void
sb s 10
wslot fd s
put gsl s sub get gsl s 1
end

fn sayt fd int t view uchar * to void
sset SM t
say fd SM
end

note ---- files named by slots

fn fopf s ulong fl int to int
r = fopen gs mul s SCAP get gsl s fl 420
if lt r 0
ret -1
end
ret int r
end

fn fcls fd int to void
if ge fd 3
r = fclose fd
end
end

fn there s ulong to bool
r = stat gs mul s SCAP get gsl s gstb 0 256
ret ge r 0
end

fn isexe s ulong to bool
if eq get gsl s 0
ret false
end
r = faccess gs mul s SCAP get gsl s 1
ret eq r 0
end

fn mkd s ulong to bool
r = makedir gs mul s SCAP get gsl s 493
ret eq r 0
end

fn mkp s ulong to bool
n = get gsl s
sclr SCWD
for i ulong n
c = sc s i
if and eq c 47 gt i 0
r = makedir gs mul SCWD SCAP get gsl SCWD 493
end
sb SCWD c
end
r = makedir gs mul s SCAP n 493
if eq r 0
ret true
end
ret eq r -17
end

fn rmf s ulong to void
r = unlink gs mul s SCAP get gsl s
end

note load slot s's file into gb
fn fload s ulong to bool
fd = fopf s 0
if lt fd 0
ret false
end
t = ulong 0
while true bound 99999
if ge t BCAP
fcls fd
ret false
end
k = read fd gb t sub BCAP t
if lt k 0
fcls fd
ret false
end
if eq k 0
break
end
t = add t ulong k
end
fcls fd
put gbn 0 t
ret true
end

fn floadc s ulong to bool
fd = fopf s 0
if lt fd 0
ret false
end
t = ulong 0
while true bound 99999
if ge t BCAP
fcls fd
ret false
end
k = read fd gc t sub BCAP t
if lt k 0
fcls fd
ret false
end
if eq k 0
break
end
t = add t ulong k
end
fcls fd
put gcn 0 t
ret true
end

fn wgb fd int to bool
n = get gbn 0
p = ulong 0
while lt p n bound 99999
w = write fd gb p sub n p
if le w 0
ret false
end
p = add p ulong w
end
ret true
end

fn wgc fd int to bool
n = get gcn 0
p = ulong 0
while lt p n bound 99999
w = write fd gc p sub n p
if le w 0
ret false
end
p = add p ulong w
end
ret true
end

fn fsavb s ulong to bool
fd = fopf s 577
if lt fd 0
ret false
end
ok = wgb fd
fcls fd
ret ok
end

fn fsavc s ulong to bool
fd = fopf s 577
if lt fd 0
ret false
end
ok = wgc fd
fcls fd
ret ok
end

fn fsavs s ulong v ulong to bool
fd = fopf s 577
if lt fd 0
ret false
end
wslot fd v
fcls fd
ret true
end

note copy slot s's file to fd d
fn fcat d int s ulong to bool
fd = fopf s 0
if lt fd 0
ret false
end
while true bound 99999
k = read fd gio 0 65536
if lt k 0
fcls fd
ret false
end
if eq k 0
break
end
p = ulong 0
while lt p ulong k bound 99999
w = write d gio p sub ulong k p
if le w 0
fcls fd
ret false
end
p = add p ulong w
end
end
fcls fd
ret true
end

note slot d = lowercase sha256 hex of slot s's file
fn fsha s ulong d ulong to bool
fd = fopf s 0
if lt fd 0
ret false
end
hreset
while true bound 999999
k = read fd gio 0 65536
if lt k 0
fcls fd
ret false
end
if eq k 0
break
end
for i ulong ulong k
hok = hpush get gio i
end
end
fcls fd
ok = hfinal
sclr d
for j ulong 64
sb d get hd j
end
ret ok
end

note ---- children: packed argv in gav, execprog with an empty environment

fn aclr to void
put gap 0 2
put gap 1 0
end

fn apb c uchar to void
p = get gap 0
put gav p c
put gap 0 add p 1
end

fn aps s ulong to void
n = get gsl s
apb uchar and n 255
apb uchar shr n 8
for i ulong n
apb sc s i
end
put gap 1 add get gap 1 1
end

fn apt t view uchar * to void
sset SA t
aps SA
end

fn redir s int d int to void
if lt s 0
ret
end
if eq s d
ret
end
r = dupfd s d 0
if ne r long d
exit 127
end
end

note run gav with fds fi fo fe (-1 inherits); the exit status, 256+signal, or 1000 on spawn failure
fn apfin to void
n = get gap 1
put gav 0 uchar and n 255
put gav 1 uchar shr n 8
end

fn spawn fi int fo int fe int to ulong
apfin
pid = fork
if lt pid 0
ret 1000
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog gav 0 get gap 0
exit 127
end
r = waitpid int pid gwst 0 4 0
if ne r pid
ret 1000
end
if ne get gwst 0 0
ret add 256 ulong and get gwst 0 127
end
ret ulong get gwst 1
end

note spawn with stdout and stderr to slot s's file (truncated)
fn spawnf s ulong to ulong
fd = fopf s 577
if lt fd 0
ret 1000
end
rc = spawn -1 fd fd
fcls fd
ret rc
end

fn rmrf s ulong to void
aclr
apt trm
apt tdrf
aps s
rc = spawn -1 -1 -1
end

note ---- line transforms over gb into gc

fn leol p ulong to ulong
n = get gbn 0
q = p
while lt q n bound 999999
if eq get gb q 10
ret q
end
q = add q 1
end
ret n
end

fn lis p ulong e ulong s ulong to bool
if ne sub e p get gsl s
ret false
end
for i ulong sub e p
if ne get gb add p i sc s i
ret false
end
end
ret true
end

fn lpre p ulong e ulong s ulong to bool
if lt sub e p get gsl s
ret false
end
for i ulong get gsl s
if ne get gb add p i sc s i
ret false
end
end
ret true
end

fn cput c uchar to void
n = get gcn 0
if ge n BCAP
w = write 2 tlong 0 len tlong
exit 2
end
put gc n c
put gcn 0 add n 1
end

fn crng p ulong e ulong to void
for i ulong sub e p
cput get gb add p i
end
end

fn cslot s ulong to void
for i ulong get gsl s
cput sc s i
end
end

note one line gb[p..e): mode 0 exact a -> b (inside block blk when blk is not empty), 1 prefix a -> b,
note 2 delete lines starting with a
fn xl mode ulong a ulong b ulong blk ulong p ulong e ulong to void
nl = lt e get gbn 0
hit = false
if eq mode 2
hit = lpre p e a
if not hit
crng p e
end
end
if eq mode 1
hit = lpre p e a
if hit
cslot b
crng add p get gsl a e
else
crng p e
end
end
if eq mode 0
inr = true
if gt get gsl blk 0
inr = false
if eq get gxs 0 1
inr = true
sset SEND tendl
if lis p e SEND
put gxs 0 0
end
else
if lis p e blk
inr = true
put gxs 0 1
end
end
end
if inr
hit = lis p e a
end
if hit
cslot b
else
crng p e
end
end
if hit
put gxs 1 add get gxs 1 1
end
keep = true
if and hit eq mode 2
keep = false
end
if and nl keep
cput 10
end
end

fn xf mode ulong a ulong b ulong blk ulong to ulong
put gcn 0 0
put gxs 0 0
put gxs 1 0
p = ulong 0
n = get gbn 0
while lt p n bound 999999
e = leol p
xl mode a b blk p e
p = add e 1
end
ret get gxs 1
end

note gc = gb without its last line
fn xlast to void
q = get gbn 0
if gt q 0
if eq get gb sub q 1 10
q = sub q 1
end
end
s = ulong 0
i = q
while gt i 0 bound 999999
if eq get gb sub i 1 10
s = i
break
end
i = sub i 1
end
put gcn 0 0
crng 0 s
end

fn cback to void
n = get gcn 0
for i ulong n
put gb i get gc i
end
put gbn 0 n
end

note gb[p..e) into slot s
fn lslot s ulong p ulong e ulong to void
sclr s
for i ulong sub e p
sb s get gb add p i
end
end

note ---- compilers

note slot SHEX = sha of compiler slot o; 0 pinned, 3 not pinned (message on stderr)
fn opin o ulong pin view uchar * nr view uchar * to ulong
if not isexe o
sayt 2 nr
ret 3
end
ok = fsha o SHEX
if not seqt SHEX pin
sset SM tnrsha
ss SM SHEX
sx SM tpinned
sx SM pin
say 2 SM
ret 3
end
ret 0
end

note om/golden/build.sh in Omega: compile om2 + json + sha256 + slot src into slot out with bf54b19f
fn gcomp o ulong src ulong dst ulong to ulong
rc = opin o tpingt tnrgt
if ne rc 0
ret rc
end
scp SX dst
sx SX tdotom
scp SY dst
sx SY terr
fd = fopf SX 577
if lt fd 0
ret 1
end
w = write fd tom2 0 len tom2
sset SZ tjson
ok = fcat fd SZ
sset SZ tshaom
if ok
ok = fcat fd SZ
end
if ok
ok = fcat fd src
end
fcls fd
fi = fopf SX 0
fo = fopf dst 577
fe = fopf SY 577
aclr
aps o
rc = spawn fi fo fe
fcls fi
fcls fo
fcls fe
rmf SX
if or ne rc 0 not ok
ok = fload SY
sset SM tcompile
ss SM src
sx SM tcolon
wslot 2 SM
trimnl
ok = wgb 2
sayt 2 tnl0
rmf dst
rmf SY
ret 1
end
rmf SY
r = chmod gs mul dst SCAP get gsl dst 448
ret 0
end

fn trimnl to void
n = get gbn 0
while gt n 0 bound 999999
if ne get gb sub n 1 10
break
end
n = sub n 1
end
put gbn 0 n
end

fn rnm a ulong b ulong to bool
aclr
aps a
aps b
apfin
r = renames gav 0 get gap 0 0
ret eq r 0
end

note slot d = slot a + "/" + text t
fn sjoin d ulong a ulong t view uchar * to void
scp d a
sb d 47
sx d t
end

fn sdec s ulong to ulong
v = ulong 0
if eq get gsl s 0
ret 18446744073709551615
end
for i ulong get gsl s
c = sc s i
if or lt c 48 gt c 57
ret 18446744073709551615
end
v = add mul v 10 ulong sub c 48
end
ret v
end

note last line of slot s's file into slot SM (after prefix t)
fn lastln s ulong t view uchar * to void
sset SM t
ok = fload s
if not ok
ret
end
trimnl
n = get gbn 0
i = n
while gt i 0 bound 999999
if eq get gb sub i 1 10
break
end
i = sub i 1
end
for j ulong sub n i
sb SM get gb add i j
end
end

note ---- the negative-control file (.neg): want N, block LINE, from LINE, to LINE; '#' comments
fn negld s ulong to bool
sclr SNW
sclr SNB
sclr SNF
sclr SNT
ok = fload s
if not ok
ret false
end
p = ulong 0
n = get gbn 0
while lt p n bound 99999
e = leol p
sset SK twant
if lpre p e SK
lslot SNW add p 5 e
end
sset SK tblock
if lpre p e SK
lslot SNB add p 6 e
end
sset SK tfrom
if lpre p e SK
lslot SNF add p 5 e
end
sset SK tto
if lpre p e SK
lslot SNT add p 3 e
end
p = add e 1
end
ret true
end

note ---- CORE: env CORE, else this process's Cpus_allowed_list
fn score to void
if senv SCORE tcoreq0
ret
end
sclr SCORE
sset SP tstatus
ok = fload SP
if not ok
ret
end
sset SK tcpus
p = ulong 0
n = get gbn 0
while lt p n bound 99999
e = leol p
if lpre p e SK
q = add p get gsl SK
while lt q e bound 99999
c = get gb q
if and ne c 9 ne c 32
sb SCORE c
end
q = add q 1
end
ret
end
p = add e 1
end
end

fn bfail t view uchar * rc ulong to ulong
sset SM tsfail
sx SM t
sx SM tgdecr
sn SM rc
say 2 SM
ret 1
end

note git child: /usr/bin/env drops the system and global config and attributes files and the graft
note file, and --no-replace-objects drops refs/replace (the child environment is otherwise empty)
fn agit to void
aclr
apt tenv
apt tgenv1
apt tgenv2
apt tgenv3
apt tgenv4
apt tgit
apt tnorep
end

note private object-only repository SZ = SOUT/src.git: a bare repository made with no templates
note (no hooks, no info/grafts, no info/attributes, no alternates), fetched from TRAIN's HEAD,
note heads, tags and remotes (never refs/replace; fetched objects are hash-checked by index-pack).
note TRAIN's side of the fetch is an upload-pack run with GIT_GRAFT_FILE=/dev/null and
note GIT_NO_REPLACE_OBJECTS=1 (git clears repo-local variables for a local upload-pack, so they are
note set in its command), so it walks and sends the true history. REV resolves in SZ, never in TRAIN,
note so TRAIN's info/grafts, info/attributes, replace refs and config overlays cannot select the
note commit or shape the snapshot. Slot SSHA = the commit id; SOUT/commit holds it; returns 0 or the
note bfail code
fn rslv to ulong
sjoin SZ SOUT tprv
rmrf SZ
sjoin SP SOUT tcmt
sjoin SQ SOUT tcmterr
agit
apt tinit
apt tq0
apt tbare
apt ttmpl
aps SZ
rc = spawnf SQ
if ne rc 0
ret bfail tinit rc
end
agit
apt tdash
aps SZ
apt tfetch
apt tq0
apt tnotags
apt tnogc
apt tnofh
apt tupk
aps STRN
apt trs1
apt trs2
apt trs3
apt trs4
rc = spawnf SQ
if ne rc 0
ret bfail tfetch rc
end
agit
apt tdash
aps SZ
apt tupref
apt tnoderef
apt thead
apt tghead
rc = spawnf SQ
if ne rc 0
ret bfail tupref rc
end
agit
apt tdash
aps SZ
apt trevp
apt tverify
scp SV SREV
sx SV tcommit
aps SV
fo = fopf SP 577
fe = fopf SQ 577
rc = spawn -1 fo fe
fcls fo
fcls fe
if ne rc 0
ret bfail trevp rc
end
ok = fload SP
trimnl
if ne get gbn 0 40
ret bfail trevp 1000
end
lslot SSHA 0 40
ret 0
end

note ---- drive build: slots SOMC STRN SREV SOUT SNEG (absolute); returns the exit code
fn dbuild to ulong
rc = opin SOMC tpintr tnrtr
if ne rc 0
ret rc
end
if gt get gsl SNEG 0
ok = negld SNEG
if or not ok eq get gsl SNW 0
sset SM tnowant
ss SM SNEG
say 2 SM
ret 4
end
end
ok = mkp SOUT
if not ok
sset SM tmkd
ss SM SOUT
say 2 SM
ret 1
end
note resolve REV to one commit in the private repository SZ
rc = rslv
if ne rc 0
ret rc
end
note snapshot that commit
sjoin SX SOUT tsrc
rmrf SX
ok = mkd SX
sjoin SY SOUT tsrctar
agit
apt tdash
aps SZ
apt tarch
apt tfmtt
apt tdo
aps SY
aps SSHA
rc = spawnf SQ
if ne rc 0
ret bfail tarch rc
end
rmrf SZ
aclr
apt ttar
apt tdx
apt tdf
aps SY
apt tdash
aps SX
rc = spawnf SQ
if ne rc 0
ret bfail ttar rc
end
rmf SY
rmf SQ
note the snapshot's own build.sh
score
aclr
apt tenv
apt tpath
apt ttgt
sset SV tomceq
ss SV SOMC
aps SV
sset SV touteq
ss SV SOUT
sx SV tsltrain
aps SV
sset SV tcoreq
ss SV SCORE
aps SV
apt tsh
scp SV SX
sx SV tslbsh
aps SV
sjoin SP SOUT tlog
rc = spawnf SP
rmrf SX
if ne rc 0
lastln SP tbfail
say 2 SM
ret 1
end
sjoin SP SOUT tslollm
ok = fload SP
if not ok
lastln SP tbfail
say 2 SM
ret 1
end
sset SA tmain
sclr SZ
nm = xf 0 SA SA SZ
if ne nm 1
sset SM tmcount
sn SM nm
sx SM twant1
say 2 SM
ret 4
end
sset SB tmain
sset SV toggm
sclr SZ
nm = xf 0 SB SV SZ
cback
if gt get gsl SNEG 0
w = sdec SNW
c = xf 0 SNF SNT SNB
if ne c w
sset SM tpchg
sn SM c
sx SM tlines
ss SM SNW
say 2 SM
ret 4
end
cback
end
sjoin SP SOUT tgold
fd = fopf SP 577
if lt fd 0
ret 1
end
ok = wgb fd
sset SQ tgdec
ok2 = fcat fd SQ
fcls fd
sjoin SX SOUT tgoldtmp
sjoin SY SOUT tomcerr
fi = fopf SP 0
fo = fopf SX 577
fe = fopf SY 577
aclr
aps SOMC
rc = spawn fi fo fe
fcls fi
fcls fo
fcls fe
if or ne rc 0 not and ok ok2
rmf SX
sset SM tbfomc
sn SM rc
sx SM tsp
wslot 2 SM
ok = fload SY
trimnl
ok = wgb 2
sayt 2 tnl0
ret 1
end
rmf SY
r = chmod gs mul SX SCAP get gsl SX 493
sjoin SZ SOUT tgoldb
ok = rnm SX SZ
sjoin SP SOUT tcmt
sclr SV
ss SV SSHA
ok = fsavs SP SV
sset SM tbok
ok = fsha SZ SHEX
ss SM SHEX
sx SM tsp
ss SM SZ
sx SM tsrcsha
sjoin SP SOUT tgold
ok = fsha SP SHEX
ss SM SHEX
sx SM tcmtsp
ss SM SSHA
say 1 SM
ret 0
end

note ---- prompts: one per line (a final unterminated line counts when not empty) into slots SPRB..
fn pld s ulong to bool
put gk 0 0
ok = fload s
if not ok
ret false
end
p = ulong 0
n = get gbn 0
k = ulong 0
while lt p n bound 99999
e = leol p
if ge k NPMAX
ret false
end
if gt sub e p SCAP
ret false
end
lslot add SPRB k p e
k = add k 1
p = add e 1
end
put gk 0 k
ret true
end

fn apprm to void
for k ulong get gk 0
aps add SPRB k
end
end

note slot SV = digits of the record's max_tokens line; false when absent
fn rmaxt s ulong to bool
sclr SV
ok = fload s
if not ok
ret false
end
sset SK tmaxtok
p = ulong 0
n = get gbn 0
while lt p n bound 999999
e = leol p
if lpre p e SK
lslot SV add p get gsl SK e
if ne sdec SV 18446744073709551615
ret true
end
end
p = add e 1
end
sclr SV
ret false
end

fn hold to bool
if senv SV thost
ret true
end
sclr SV
ok = senv SV theld
ret seqt SV tone
end

fn verd t view uchar * c ulong to ulong
sset SM tgateb0
sx SM t
say 1 SM
ret c
end

fn verdn t view uchar * v ulong u view uchar * c ulong to ulong
sset SM tgateb0
sx SM t
sn SM v
sx SM u
say 1 SM
ret c
end

note print each line of slot s's file to fd 1 with prefix text t
fn catpre s ulong t view uchar * to void
ok = fload s
if not ok
ret
end
p = ulong 0
n = get gbn 0
while lt p n bound 999999
e = leol p
lslot SM p e
sset SK t
sx SK tcolon
ss SK SM
say 1 SK
p = add e 1
end
end

fn catf s ulong to void
ok = fcat 1 s
end

note drive build of arm (cand or neg) as a child; prints its transcript; the child's code
fn gbarm am view uchar * isn bool to ulong
aclr
apt tself
apt tbuild
aps SOMC
aps STRN
aps SREV
sset SX tsl0
ss SX SOUT
sb SX 47
sx SX am
aps SX
if isn
sset SY tnegf
sabs SY
aps SY
end
sx SX tbuildf
rc = spawnf SX
catf SX
ret rc
end

note gtgpu of an arm and gate cmp; returns cmp's code
fn grarm am view uchar * to ulong
sset SX tsl0
ss SX SOUT
sb SX 47
sx SX am
scp SY SX
sb SY 47

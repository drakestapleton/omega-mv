note slot d = the record line value after key t of slot SREF's file
fn refval d ulong t view uchar * to bool
sclr d
ok = fload SREF
if not ok
ret false
end
sset SK t
p = ulong 0
n = get gbn 0
while lt p n bound 999999
e = leol p
if lpre p e SK
lslot d add p get gsl SK e
ret true
end
p = add e 1
end
ret false
end

fn dcore to ulong
sset SREF trefp
sabs SREF
sset SPR tprp
sabs SPR
sset SP tlock
ok = fload SP
sclr SLK
for i ulong get gbn 0
c = get gb i
if and ne c 10 and ne c 32 and ne c 9 ne c 13
sb SLK c
end
end
ok = senv STRN tgtrain
if ok
sjoin SP STRN tbsh
ok = there SP
end
if not ok
sset SD ttmw
ss SD SLK
ret notrun ttm SD
end

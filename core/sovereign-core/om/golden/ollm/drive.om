note the b0/b1 line comparison: count of differing line pairs; slot SW = b1's differing line
note slot SW = gc bytes a..b
fn lslotc a ulong b ulong to void
sclr SW
for i ulong sub b a
sb SW get gc add a i
end
end

fn lsame p ulong e ulong q ulong f ulong to bool
if ne sub e p sub f q
ret false
end
for i ulong sub e p
if ne get gb add p i get gc add q i
ret false
end
end
ret true
end

fn ldiff to ulong
p = ulong 0
q = ulong 0
d = ulong 0
while and lt p get gbn 0 lt q get gcn 0 bound 999999
e = leol p
f = q
while lt f get gcn 0 bound 999999
if eq get gc f 10
break
end
f = add f 1
end
if not lsame p e q f
d = add d 1
lslotc q f
end
p = add e 1
q = add f 1
end
if or lt p get gbn 0 lt q get gcn 0
d = add d 1000
end
ret d
end


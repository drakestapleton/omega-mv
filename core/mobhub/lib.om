note core/mobhub/lib.om: pure-Omega MobHub faction operations engine (converted from mobhub).
note Composable OM-2 library unit (no om2 line, no fn main).
note Compose with: si/directives/om2.om core/mobhub/lib.om <main.om|test.om>
note
note Implements all core domains from upstream mobhub (Rust + Mojo):
note   - MobPay: deterministic FlatRate & PoolShare war payout engine with zero-drift integer
note     reconciliation, leadership buyout/shared-pool rules, and war-hitter flat bonuses
note   - MobWorth: faction net worth valuation and vault net spendable cash calculation
note   - MobGym: Vladar Training Formula V2.0 (pure IEEE-754 f64 ln/log10/exp/pow, 50M soft cap,
note     happy taper & decay, single-train and multi-train session simulation)
note   - Reconcile: Torn money-log HTML parser with automatic OC-cut exclusion, 2-pass real-money
note     safe disbursement matcher, war-window check, and ambiguous-give closeout picker
note   - Vault: key= query parameter secret redaction guard

const MH_OK ulong 0
const MH_ERR_NEG_CACHE ulong 1
const MH_ERR_BAD_MODEL ulong 2
const MH_ERR_BAD_SPLITS ulong 3
const MH_ERR_CAPACITY ulong 4
const MH_ERR_DUP_ID ulong 5
const MH_ERR_BAD_STAT ulong 6
const MH_ERR_BAD_ENERGY ulong 7
const MH_ERR_PARSE ulong 8
const MH_ERR_OC_EXCLUDED ulong 9
const MH_ERR_NO_MATCH ulong 10

const MH_MODEL_FLAT_RATE ulong 0
const MH_MODEL_POOL_SHARE ulong 1

const MH_KIND_MEMBER ulong 0
const MH_KIND_LEADERSHIP ulong 1

const MH_WARN_SPLIT_SUM ulong 1
const MH_WARN_NO_LEADER ulong 2
const MH_WARN_BONUS_EXCEEDS ulong 4

const MH_STAT_STR ulong 0
const MH_STAT_SPD ulong 1
const MH_STAT_DEX ulong 2
const MH_STAT_DEF ulong 3
const MH_STAT_INVALID ulong 255

const MH_PICK_NONE ulong 0
const MH_PICK_ONE ulong 1
const MH_PICK_AMBIGUOUS ulong 2

const MH_MAX_MEMBERS ulong 128
const MH_MAX_REG ulong 128
const MH_MAX_GIVES ulong 128


note ====================================================================
note Section 1: Pure IEEE-754 f64 Math Primitives (no external libm)
note ====================================================================

fn mh_round_i64 x f64 to long
if ge x 0.0f64
ret long add x 0.5f64
end
ret long sub x 0.5f64
end

fn mh_round_to4 x f64 to f64
p = f64 10000.0f64
ret div f64 mh_round_i64 mul x p p
end

fn mh_clamp01 x f64 to f64
if lt x 0.0f64
ret 0.0f64
end
if gt x 1.0f64
ret 1.0f64
end
ret x
end

fn mh_fmax0 x f64 to f64
if lt x 0.0f64
ret 0.0f64
end
ret x
end

fn mh_imax0 x long to long
if lt x 0
ret 0
end
ret x
end

fn mh_iabs x long to long
if lt x 0
ret neg x
end
ret x
end

note Natural logarithm ln(x) for x > 0 in full IEEE-754 f64 precision (< 1e-15 error).
fn mh_ln x f64 to f64
if le x 0.0f64
ret 0.0f64
end
bits = bitcast ulong x
eb = and shr bits 52 0x7ff
e = sub long eb 1023
mbits = or and bits 0x000fffffffffffff 0x3ff0000000000000
m = bitcast f64 mbits
if gt m 1.4142135623730951f64
m = mul m 0.5f64
e = add e 1
end
t = div sub m 1.0f64 add m 1.0f64
s = mul t t
acc = div 1.0f64 19.0f64
acc = add div 1.0f64 17.0f64 mul s acc
acc = add div 1.0f64 15.0f64 mul s acc
acc = add div 1.0f64 13.0f64 mul s acc
acc = add div 1.0f64 11.0f64 mul s acc
acc = add div 1.0f64 9.0f64 mul s acc
acc = add div 1.0f64 7.0f64 mul s acc
acc = add div 1.0f64 5.0f64 mul s acc
acc = add div 1.0f64 3.0f64 mul s acc
acc = add 1.0f64 mul s acc
lnm = mul mul 2.0f64 t acc
ret add lnm mul f64 e 0.6931471805599453f64
end

fn mh_log10 x f64 to f64
ret div mh_ln x 2.302585092994046f64
end

note Exponential exp(y) in full IEEE-754 f64 precision.
fn mh_exp y f64 to f64
if lt y -700.0f64
ret 0.0f64
end
if gt y 700.0f64
ret 1.0e300f64
end
ln2 = f64 0.6931471805599453f64
k = mh_round_i64 div y ln2
r = sub y mul f64 k ln2
acc = f64 1.0f64
i = long 13
while gt i 0 bound 16
acc = add 1.0f64 div mul acc r f64 i
i = sub i 1
end
eb = ulong add k 1023
scale = bitcast f64 shl eb 52
ret mul acc scale
end

note Compute h^1.05 for h >= 0 cleanly via h * exp(0.05 * ln(h)).
fn mh_pow_105 h f64 to f64
if le h 0.0f64
ret 0.0f64
end
ret mul h mh_exp mul 0.05f64 mh_ln h
end

note ====================================================================
note Section 2: MobPay Deterministic Payout Engine (upstream src/payout.rs)
note ====================================================================

fn mh_policy_default_flat to void
put mh_g_pol_model 0 MH_MODEL_FLAT_RATE
put mh_g_pol_rate_resp 0 180284.0f64
put mh_g_pol_rate_out 0 500000.0f64
put mh_g_pol_rate_ast 0 250000.0f64
put mh_g_pol_w_war 0 1.0f64
put mh_g_pol_w_ast 0 0.5f64
put mh_g_pol_w_out 0 0.5f64
put mh_g_pol_split_m 0 0.8f64
put mh_g_pol_split_f 0 0.2f64
put mh_g_pol_split_l 0 0.0f64
put mh_g_pol_has_ldr 0 0
put mh_g_pol_ldr_id 0 0
put mh_g_pol_fixed_rate 0 0
put mh_g_pol_ldr_shares 0 0
put mh_g_pol_flat_bonus 0 0
put mh_g_pol_rec_mode 0 0
end

fn mh_members_reset to void
put mh_g_in_cnt 0 0
end

fn mh_member_add tid long resp f64 war long ast long outh long to ulong
cnt = get mh_g_in_cnt 0
if ge cnt MH_MAX_MEMBERS
ret MH_ERR_CAPACITY
end
i = ulong 0
while lt i cnt bound 128
if eq get mh_g_in_tid i tid
ret MH_ERR_DUP_ID
end
i = add i 1
end
put mh_g_in_tid cnt tid
put mh_g_in_resp cnt resp
put mh_g_in_war cnt war
put mh_g_in_ast cnt ast
put mh_g_in_out cnt outh
put mh_g_in_cnt 0 add cnt 1
ret MH_OK
end

fn mh_payable_hits_in idx ulong to f64
w1 = mul f64 mh_imax0 get mh_g_in_war idx mh_fmax0 get mh_g_pol_w_war 0
w2 = mul f64 mh_imax0 get mh_g_in_ast idx mh_fmax0 get mh_g_pol_w_ast 0
w3 = mul f64 mh_imax0 get mh_g_in_out idx mh_fmax0 get mh_g_pol_w_out 0
ret add add w1 w2 w3
end

fn mh_is_bought_out tid long to bool
if eq get mh_g_pol_has_ldr 0 0
ret false
end
if le mh_clamp01 get mh_g_pol_split_l 0 0.0f64
ret false
end
if ne get mh_g_pol_ldr_shares 0 0
ret false
end
ret eq tid get mh_g_pol_ldr_id 0
end

fn mh_push_out tid long kind ulong idx ulong has_in bool to ulong
o = get mh_g_out_cnt 0
if ge o MH_MAX_MEMBERS
ret o
end
put mh_g_out_tid o tid
put mh_g_out_kind o kind
if has_in
put mh_g_out_resp o get mh_g_in_resp idx
put mh_g_out_war o get mh_g_in_war idx
put mh_g_out_ast o get mh_g_in_ast idx
put mh_g_out_out o get mh_g_in_out idx
else
put mh_g_out_resp o 0.0f64
put mh_g_out_war o 0
put mh_g_out_ast o 0
put mh_g_out_out o 0
end
put mh_g_out_ph o 0.0f64
put mh_g_out_share o 0.0f64
put mh_g_out_base o 0
put mh_g_out_lbonus o 0
put mh_g_out_fbonus o 0
put mh_g_out_amt o 0
put mh_g_out_cnt 0 add o 1
ret o
end

note Deterministic insertion sort of mh_g_sort_idx[0..n]:
note payable_hits descending, tie-break torn_id ascending (exact upstream order).
fn mh_sort_for_drift n ulong to void
i = ulong 0
while lt i n bound 128
put mh_g_sort_idx i i
i = add i 1
end
i = ulong 1
while lt i n bound 128
key = get mh_g_sort_idx i
kph = get mh_g_out_ph key
ktid = get mh_g_out_tid key
j = i
while gt j 0 bound 128
prev = get mh_g_sort_idx sub j 1
pph = get mh_g_out_ph prev
ptid = get mh_g_out_tid prev
swap = false
if gt kph pph
swap = true
else
if and eq kph pph lt ktid ptid
swap = true
end
end
if swap
put mh_g_sort_idx j prev
j = sub j 1
else
break
end
end
put mh_g_sort_idx j key
i = add i 1
end
end

fn mh_apply_drift_reconcile pool_target long to void
n = get mh_g_out_cnt 0
if eq n 0
ret
end
cur_sum = long 0
i = ulong 0
while lt i n bound 128
cur_sum = add cur_sum get mh_g_out_base i
i = add i 1
end
drift = sub pool_target cur_sum
if eq drift 0
ret
end
mh_sort_for_drift n
if gt drift 0
cnt = ulong drift
k = ulong 0
while lt k cnt bound 100000
idx = get mh_g_sort_idx rem k n
put mh_g_out_base idx add get mh_g_out_base idx 1
put mh_g_out_amt idx add get mh_g_out_amt idx 1
k = add k 1
end
else
cnt = ulong neg drift
k = ulong 0
while lt k cnt bound 100000
idx = get mh_g_sort_idx rem k n
if gt get mh_g_out_base idx 0
put mh_g_out_base idx sub get mh_g_out_base idx 1
put mh_g_out_amt idx sub get mh_g_out_amt idx 1
end
k = add k 1
end
end
end

fn mh_emit_flat_member i ulong rate f64 to void
tid = get mh_g_in_tid i
if mh_is_bought_out tid
ret
end
o = mh_push_out tid MH_KIND_MEMBER i true
put mh_g_out_ph o mh_payable_hits_in i
v1 = mul mh_fmax0 get mh_g_in_resp i rate
v2 = mul f64 mh_imax0 get mh_g_in_out i get mh_g_pol_rate_out 0
v3 = mul f64 mh_imax0 get mh_g_in_ast i get mh_g_pol_rate_ast 0
base = mh_round_i64 add add v1 v2 v3
put mh_g_out_base o base
put mh_g_out_amt o base
end

fn mh_member_bonus_f64 i ulong to f64
o_h = f64 mh_imax0 get mh_g_in_out i
a_h = f64 mh_imax0 get mh_g_in_ast i
b1 = mul o_h get mh_g_pol_rate_out 0
b2 = mul a_h get mh_g_pol_rate_ast 0
ret add b1 b2
end

fn mh_compute_flat_rate mpool f64 to void
icnt = get mh_g_in_cnt 0
btot = f64 0.0f64
tot_resp = f64 0.0f64
tot_ph = f64 0.0f64
i = ulong 0
while lt i icnt bound 128
if not mh_is_bought_out get mh_g_in_tid i
btot = add btot mh_member_bonus_f64 i
tot_resp = add tot_resp mh_fmax0 get mh_g_in_resp i
tot_ph = add tot_ph mh_payable_hits_in i
end
i = add i 1
end
bonus_i = mh_round_i64 btot
put mh_g_res_bonus_tot 0 bonus_i
put mh_g_res_tot_resp 0 tot_resp
put mh_g_res_tot_ph 0 tot_ph
rate = f64 0.0f64
if ne get mh_g_pol_fixed_rate 0 0
rate = get mh_g_pol_rate_resp 0
else
rpool = sub mpool f64 bonus_i
if lt rpool 0.0f64
put mh_g_res_warns 0 or get mh_g_res_warns 0 MH_WARN_BONUS_EXCEEDS
rate = 0.0f64
else
if gt tot_resp 0.0f64
rate = div rpool tot_resp
end
end
end
put mh_g_res_rate 0 rate
put mh_g_res_has_rate 0 1
j = ulong 0
while lt j icnt bound 128
mh_emit_flat_member j rate
j = add j 1
end
end

fn mh_compute_pool_share mpool f64 to void
icnt = get mh_g_in_cnt 0
tot_ph = f64 0.0f64
i = ulong 0
while lt i icnt bound 128
if not mh_is_bought_out get mh_g_in_tid i
tot_ph = add tot_ph mh_payable_hits_in i
end
i = add i 1
end
put mh_g_res_tot_ph 0 tot_ph
put mh_g_res_has_rate 0 0
put mh_g_res_bonus_tot 0 0
put mh_g_res_tot_resp 0 0.0f64
i = ulong 0
while lt i icnt bound 128
tid = get mh_g_in_tid i
if not mh_is_bought_out tid
o = mh_push_out tid MH_KIND_MEMBER i true
ph = mh_payable_hits_in i
sh = f64 0.0f64
if gt tot_ph 0.0f64
sh = div ph tot_ph
end
base = mh_round_i64 mul mpool sh
put mh_g_out_ph o ph
put mh_g_out_share o sh
put mh_g_out_base o base
put mh_g_out_amt o base
end
i = add i 1
end
end

fn mh_find_in_by_tid tid long to ulong
icnt = get mh_g_in_cnt 0
i = ulong 0
while lt i icnt bound 128
if eq get mh_g_in_tid i tid
ret i
end
i = add i 1
end
ret MH_MAX_MEMBERS
end

fn mh_find_out_by_tid tid long to ulong
ocnt = get mh_g_out_cnt 0
i = ulong 0
while lt i ocnt bound 128
if eq get mh_g_out_tid i tid
ret i
end
i = add i 1
end
ret MH_MAX_MEMBERS
end

fn mh_apply_leadership lfund long to void
sl = mh_clamp01 get mh_g_pol_split_l 0
if le sl 0.0f64
put mh_g_res_lpaid 0 0
ret
end
if eq get mh_g_pol_has_ldr 0 0
put mh_g_res_warns 0 or get mh_g_res_warns 0 MH_WARN_NO_LEADER
put mh_g_res_lpaid 0 0
ret
end
rid = get mh_g_pol_ldr_id 0
put mh_g_res_lpaid 0 lfund
if ne get mh_g_pol_ldr_shares 0 0
ex = mh_find_out_by_tid rid
if lt ex MH_MAX_MEMBERS
put mh_g_out_kind ex MH_KIND_LEADERSHIP
put mh_g_out_lbonus ex lfund
put mh_g_out_amt ex add get mh_g_out_amt ex lfund
ret
end
end
in_idx = mh_find_in_by_tid rid
has_in = lt in_idx MH_MAX_MEMBERS
o = mh_push_out rid MH_KIND_LEADERSHIP in_idx has_in
put mh_g_out_lbonus o lfund
put mh_g_out_amt o lfund
end

fn mh_finalize_payout_totals mpool_i long ffund long to void
fbon = mh_imax0 get mh_g_pol_flat_bonus 0
fbon_tot = long 0
ocnt = get mh_g_out_cnt 0
if gt fbon 0
i = ulong 0
while lt i ocnt bound 128
if gt get mh_g_out_war i 0
put mh_g_out_fbonus i fbon
put mh_g_out_amt i add get mh_g_out_amt i fbon
fbon_tot = add fbon_tot fbon
end
i = add i 1
end
end
put mh_g_res_fbonus_tot 0 fbon_tot
mpay = long 0
pdist = long 0
all_out = long 0
j = ulong 0
while lt j ocnt bound 128
amt = get mh_g_out_amt j
if eq get mh_g_out_kind j MH_KIND_MEMBER
mpay = add mpay amt
end
pdist = add pdist get mh_g_out_base j
all_out = add all_out amt
j = add j 1
end
put mh_g_res_mpay_tot 0 mpay
put mh_g_res_grand 0 add all_out ffund
put mh_g_res_unalloc 0 sub mpool_i pdist
end

fn mh_validate_payout_policy to ulong
model = get mh_g_pol_model 0
if and ne model MH_MODEL_FLAT_RATE ne model MH_MODEL_POOL_SHARE
ret MH_ERR_BAD_MODEL
end
sm = get mh_g_pol_split_m 0
sf = get mh_g_pol_split_f 0
sl = get mh_g_pol_split_l 0
if or lt sm 0.0f64 or lt sf 0.0f64 lt sl 0.0f64
ret MH_ERR_BAD_SPLITS
end
if or gt sm 1.0f64 or gt sf 1.0f64 gt sl 1.0f64
ret MH_ERR_BAD_SPLITS
end
ssum = add add sm sf sl
if gt fabs sub ssum 1.0f64 0.0001f64
put mh_g_res_warns 0 or get mh_g_res_warns 0 MH_WARN_SPLIT_SUM
end
ret MH_OK
end

fn mh_should_reconcile model ulong to bool
rmode = get mh_g_pol_rec_mode 0
if eq rmode 1
ret true
end
if and eq rmode 0 eq model MH_MODEL_POOL_SHARE
ret true
end
ret false
end

note Main MobPay entry point: validates inputs fail-closed, runs payout & zero-drift reconciliation.
fn mh_compute_payout cache_value long to ulong
if lt cache_value 0
ret MH_ERR_NEG_CACHE
end
put mh_g_out_cnt 0 0
put mh_g_res_warns 0 0
verr = mh_validate_payout_policy
if ne verr MH_OK
ret verr
end
put mh_g_res_cache 0 cache_value
cf = f64 cache_value
ffund = mh_round_i64 mul cf get mh_g_pol_split_f 0
lfund = mh_round_i64 mul cf get mh_g_pol_split_l 0
mpool = mul cf get mh_g_pol_split_m 0
mpool_i = mh_round_i64 mpool
put mh_g_res_ffund 0 ffund
put mh_g_res_lfund 0 lfund
put mh_g_res_mpool 0 mpool_i
model = get mh_g_pol_model 0
if eq model MH_MODEL_FLAT_RATE
mh_compute_flat_rate mpool
else
mh_compute_pool_share mpool
end
if mh_should_reconcile model
if or gt get mh_g_res_tot_ph 0 0.0f64 eq model MH_MODEL_FLAT_RATE
mh_apply_drift_reconcile mpool_i
end
end
mh_apply_leadership lfund
mh_finalize_payout_totals mpool_i ffund
ret MH_OK
end

note ====================================================================
note Section 3: MobWorth Valuation Engine (upstream src/valuation.rs)
note ====================================================================

fn mh_compute_valuation respect f64 rate f64 armory f64 cash f64 to ulong
if or lt respect 0.0f64 or lt rate 0.0f64 or lt armory 0.0f64 lt cash 0.0f64
ret MH_ERR_PARSE
end
rv = mh_round_i64 mul respect rate
av = mh_round_i64 armory
cv = mh_round_i64 cash
put mh_g_val_resp 0 rv
put mh_g_val_armory 0 av
put mh_g_val_cash 0 cv
put mh_g_val_total 0 add add rv av cv
ret MH_OK
end

note Vault net spendable cash = max(0, round(vault_money - sum(member_deposits)))
fn mh_net_faction_cash vault_money f64 deps view f64 * ndep ulong to long
tot_dep = f64 0.0f64
i = ulong 0
while lt i ndep bound 1024
tot_dep = add tot_dep get deps i
i = add i 1
end
net = mh_fmax0 sub vault_money tot_dep
ret mh_round_i64 net
end

note ====================================================================
note Section 4: MobGym Vladar Training Formula V2.0 (src/gym.rs & mojo)
note ====================================================================

fn mh_ascii_lower b uchar to uchar
if and ge b 65 le b 90
ret add b 32
end
ret b
end

fn mh_eq_ci a view uchar * aoff ulong alen ulong b view uchar * to bool
if ne alen len b
ret false
end
i = ulong 0
while lt i alen bound 64
if ne mh_ascii_lower get a add aoff i mh_ascii_lower get b i
ret false
end
i = add i 1
end
ret true
end

fn mh_stat_parse buf view uchar * off ulong slen ulong to ulong
if or mh_eq_ci buf off slen mh_t_str mh_eq_ci buf off slen mh_t_str2
ret MH_STAT_STR
end
if or mh_eq_ci buf off slen mh_t_spd mh_eq_ci buf off slen mh_t_spd2
ret MH_STAT_SPD
end
if or mh_eq_ci buf off slen mh_t_dex mh_eq_ci buf off slen mh_t_dex2
ret MH_STAT_DEX
end
if or mh_eq_ci buf off slen mh_t_def mh_eq_ci buf off slen mh_t_def2
ret MH_STAT_DEF
end
ret MH_STAT_INVALID
end

fn mh_stat_const_a sid ulong to f64
if eq sid MH_STAT_STR
ret 1600.0f64
end
if eq sid MH_STAT_SPD
ret 1600.0f64
end
if eq sid MH_STAT_DEX
ret 1800.0f64
end
ret 2100.0f64
end

fn mh_stat_const_b sid ulong to f64
if eq sid MH_STAT_STR
ret 1700.0f64
end
if eq sid MH_STAT_SPD
ret 2000.0f64
end
if eq sid MH_STAT_DEX
ret 1500.0f64
end
ret -600.0f64
end

fn mh_soft_cap_stat sval f64 to f64
cap = f64 50000000.0f64
if le sval cap
ret sval
end
denom = mul 8.77635f64 mh_log10 sval
ret add cap div sub sval cap denom
end

fn mh_gym_reset_opts to void
put mh_g_gym_perk_mult 0 1.0f64
put mh_g_gym_use_loss 0 0
put mh_g_gym_loss 0 0.0f64
put mh_g_gym_min_h 0 0.0f64
end

fn mh_gym_inner sid ulong sval f64 happy f64 to f64
h = mh_fmax0 happy
seff = mh_soft_cap_stat sval
log_t = mh_round_to4 mh_ln add 1.0f64 div h 250.0f64
h_mult = mh_round_to4 add 1.0f64 mul 0.07f64 log_t
acc = mul seff h_mult
acc = add acc mul 8.0f64 mh_pow_105 h
hr = div h 99999.0f64
acc = add acc mul sub 1.0f64 mul hr hr mh_stat_const_a sid
ret add acc mh_stat_const_b sid
end

note Exact Vladar Training Formula V2.0 single-train expected stat gain.
fn mh_gym_expected_gain sid ulong sval f64 happy f64 e_train f64 dots f64 pmult f64 to f64
inner = mh_gym_inner sid sval happy
r = mul div inner 200000.0f64 dots
r = mul r e_train
ret mul r pmult
end

note Multi-train session simulator with decaying happy and min_happy floor.
fn mh_gym_simulate sid ulong sv f64 hv f64 ev f64 e_train f64 dots f64 to ulong
if gt sid MH_STAT_DEF
ret MH_ERR_BAD_STAT
end
if or le e_train 0.0f64 lt ev 0.0f64
ret MH_ERR_BAD_ENERGY
end
if or le dots 0.0f64 lt sv 0.0f64
ret MH_ERR_BAD_ENERGY
end
pmult = get mh_g_gym_perk_mult 0
if le pmult 0.0f64
pmult = 1.0f64
end
loss = mul 0.5f64 e_train
if ne get mh_g_gym_use_loss 0 0
loss = get mh_g_gym_loss 0
end
hv = mh_fmax0 hv
trains = ulong 0
tgain = f64 0.0f64
while ge ev e_train bound 100000
g = mh_gym_expected_gain sid sv hv e_train dots pmult
sv = add sv g
tgain = add tgain g
hv = sub hv loss
if lt hv get mh_g_gym_min_h 0
hv = get mh_g_gym_min_h 0
end
ev = sub ev e_train
trains = add trains 1
end
put mh_g_gym_trains 0 trains
put mh_g_gym_espent 0 mul f64 trains e_train
put mh_g_gym_tgain 0 tgain
put mh_g_gym_estat 0 sv
put mh_g_gym_ehappy 0 hv
if gt trains 0
put mh_g_gym_avg 0 div tgain f64 trains
else
put mh_g_gym_avg 0 0.0f64
end
ret MH_OK
end

note ====================================================================
note Section 5: Money-Log Parser & 2-Pass Reconciler (upstream src/reconcile.rs)
note ====================================================================

fn mh_find_ci hay view uchar * start ulong hlen ulong ndl view uchar * to ulong
nlen = len ndl
if or eq nlen 0 gt add start nlen hlen
ret add hlen 1
end
lim = add sub hlen nlen 1
i = start
while lt i lim bound 8192
if mh_eq_ci hay i nlen ndl
ret i
end
i = add i 1
end
ret add hlen 1
end

fn mh_is_digit b uchar to bool
ret and ge b 48 le b 57
end

fn mh_parse_dollar_amt txt view uchar * pos ulong tlen ulong to ulong
p_bal = mh_find_ci txt pos tlen mh_t_mbal
if gt p_bal tlen
ret MH_ERR_NO_MATCH
end
q = add p_bal len mh_t_mbal
amt = long 0
d_amt = ulong 0
while lt q tlen bound 64
c = get txt q
if eq c 44
q = add q 1
continue
end
if not mh_is_digit c
break
end
amt = add mul amt 10 long sub c 48
d_amt = add d_amt 1
q = add q 1
end
if eq d_amt 0
ret MH_ERR_NO_MATCH
end
put mh_g_parse_amt 0 amt
ret MH_OK
end

note Parse Torn depositFunds money-log HTML entry.
note Excludes OC cuts ("cut for their role") with MH_ERR_OC_EXCLUDED.
note Extracts recipient_torn_id, recipient_name, and comma-stripped dollar amount.
fn mh_parse_money_log txt view uchar * tlen ulong to ulong
put mh_g_parse_tid 0 0
put mh_g_parse_amt 0 0
put mh_g_parse_nlen 0 0
if eq tlen 0
ret MH_ERR_NO_MATCH
end
if le mh_find_ci txt 0 tlen mh_t_oc tlen
ret MH_ERR_OC_EXCLUDED
end
p_inc = mh_find_ci txt 0 tlen mh_t_inc
if gt p_inc tlen
ret MH_ERR_NO_MATCH
end
p_xid = mh_find_ci txt add p_inc 9 tlen mh_t_xid
if gt p_xid tlen
ret MH_ERR_NO_MATCH
end
p = add p_xid 4
tid = long 0
d_tid = ulong 0
while lt p tlen bound 32
c = get txt p
if not mh_is_digit c
break
end
tid = add mul tid 10 long sub c 48
d_tid = add d_tid 1
p = add p 1
end
if eq d_tid 0
ret MH_ERR_NO_MATCH
end
put mh_g_parse_tid 0 tid
while lt p tlen bound 256
if eq get txt p 62
p = add p 1
break
end
p = add p 1
end
nlen = ulong 0
while lt p tlen bound 128
c = get txt p
if eq c 60
break
end
put mh_g_parse_name nlen c
nlen = add nlen 1
p = add p 1
end
put mh_g_parse_nlen 0 nlen
ret mh_parse_dollar_amt txt p tlen
end

fn mh_rec_reset to void
put mh_g_reg_cnt 0 0
put mh_g_give_cnt 0 0
put mh_g_rec_matched 0 0
put mh_g_rec_unmatched 0 0
end

fn mh_rec_add_reg reg_id long tid long owed long paid ulong to ulong
c = get mh_g_reg_cnt 0
if ge c MH_MAX_REG
ret MH_ERR_CAPACITY
end
put mh_g_reg_id c reg_id
put mh_g_reg_tid c tid
put mh_g_reg_owed c owed
put mh_g_reg_paid c paid
put mh_g_reg_claimed c paid
put mh_g_reg_cnt 0 add c 1
ret MH_OK
end

fn mh_rec_add_give give_id long tid long amt long to ulong
c = get mh_g_give_cnt 0
if ge c MH_MAX_GIVES
ret MH_ERR_CAPACITY
end
put mh_g_give_id c give_id
put mh_g_give_tid c tid
put mh_g_give_amt c amt
put mh_g_give_match c 0
put mh_g_give_cnt 0 add c 1
ret MH_OK
end

fn mh_find_reg_by_tid tid long to ulong
rc = get mh_g_reg_cnt 0
i = ulong 0
while lt i rc bound 128
if eq get mh_g_reg_tid i tid
ret i
end
i = add i 1
end
ret MH_MAX_REG
end

note 2-pass real-money-safe reconciliation:
note Rule 1: never match an already-paid register row.
note Rule 2: each register row claimed by at most one give.
note Pass 1: exact amount match. Pass 2: within tolerance_pct.
fn mh_match_disbursements tol_pct f64 to void
rc = get mh_g_reg_cnt 0
ri = ulong 0
while lt ri rc bound 128
put mh_g_reg_claimed ri get mh_g_reg_paid ri
ri = add ri 1
end
gc = get mh_g_give_cnt 0
gi = ulong 0
while lt gi gc bound 128
put mh_g_give_match gi 0
gi = add gi 1
end
note Pass 1: exact amount match
gi = ulong 0
while lt gi gc bound 128
gamt = get mh_g_give_amt gi
if gt gamt 0
ridx = mh_find_reg_by_tid get mh_g_give_tid gi
if lt ridx MH_MAX_REG
if eq get mh_g_reg_claimed ridx 0
owed = get mh_g_reg_owed ridx
if and gt owed 0 eq gamt owed
put mh_g_give_match gi get mh_g_reg_id ridx
put mh_g_reg_claimed ridx 1
end
end
end
end
gi = add gi 1
end
note Pass 2: within tolerance percentage
gi = ulong 0
while lt gi gc bound 128
if eq get mh_g_give_match gi 0
gamt = get mh_g_give_amt gi
if gt gamt 0
ridx = mh_find_reg_by_tid get mh_g_give_tid gi
if lt ridx MH_MAX_REG
if eq get mh_g_reg_claimed ridx 0
owed = get mh_g_reg_owed ridx
if gt owed 0
mdiff = mh_round_i64 mul f64 owed tol_pct
if lt mdiff 1
mdiff = 1
end
if le mh_iabs sub gamt owed mdiff
put mh_g_give_match gi get mh_g_reg_id ridx
put mh_g_reg_claimed ridx 1
end
end
end
end
end
end
gi = add gi 1
end
m = ulong 0
u = ulong 0
gi = ulong 0
while lt gi gc bound 128
if ne get mh_g_give_match gi 0
m = add m 1
else
u = add u 1
end
gi = add gi 1
end
put mh_g_rec_matched 0 m
put mh_g_rec_unmatched 0 u
end

note Verify if give timestamp falls in half-open war payout window [from_ms, to_ms).
fn mh_is_in_war_window has_ts bool ts long has_from bool from_ms long has_to bool to_ms long to bool
if not has_ts
ret not has_to
end
if has_from
if lt ts from_ms
ret false
end
end
if has_to
if ge ts to_ms
ret false
end
end
ret true
end

note Pick single exact give within [round(owed*(1-tol)), round(owed*(1+tol))] from loaded gives.
fn mh_pick_payout_give owed long tol f64 to ulong
put mh_g_pick_id 0 0
put mh_g_pick_amt 0 0
if le owed 0
ret MH_PICK_NONE
end
lo = mh_round_i64 mul f64 owed sub 1.0f64 tol
hi = mh_round_i64 mul f64 owed add 1.0f64 tol
found = ulong 0
gc = get mh_g_give_cnt 0
i = ulong 0
while lt i gc bound 128
amt = get mh_g_give_amt i
if and gt amt 0 and ge amt lo le amt hi
found = add found 1
if eq found 1
put mh_g_pick_id 0 get mh_g_give_id i
put mh_g_pick_amt 0 amt
else
put mh_g_pick_id 0 0
put mh_g_pick_amt 0 0
ret MH_PICK_AMBIGUOUS
end
end
i = add i 1
end
if eq found 1
ret MH_PICK_ONE
end
ret MH_PICK_NONE
end

note ====================================================================
note Section 6: Vault Secret Redaction Guard (upstream src/vault.rs)
note ====================================================================

fn mh_is_ws b uchar to bool
if eq b 32
ret true
end
if eq b 9
ret true
end
if eq b 10
ret true
end
ret eq b 13
end

note Redacts every key=<secret> query param in inp[0..ilen] to key=[REDACTED_BY_ATLAS_VAULT].
note Writes result to mh_g_buf and stores length in mh_g_buf_len[0].
fn mh_redact_secrets inp view uchar * ilen ulong to ulong
w = ulong 0
i = ulong 0
while lt i ilen bound 8192
matched = false
if le add i 4 ilen
if mh_eq_ci inp i 4 mh_t_keyeq
matched = true
end
end
if matched
note Emit "key=[REDACTED_BY_ATLAS_VAULT]"
k = ulong 0
while lt k 4 bound 4
if lt w 8192
put mh_g_buf w get mh_t_keyeq k
w = add w 1
end
k = add k 1
end
rlen = len mh_t_redacted
r = ulong 0
while lt r rlen bound 64
if lt w 8192
put mh_g_buf w get mh_t_redacted r
w = add w 1
end
r = add r 1
end
i = add i 4
while lt i ilen bound 1024
c = get inp i
if or eq c 38 mh_is_ws c
break
end
i = add i 1
end
else
if lt w 8192
put mh_g_buf w get inp i
w = add w 1
end
i = add i 1
end
end
put mh_g_buf_len 0 w
ret w
end

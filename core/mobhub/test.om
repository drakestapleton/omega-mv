note Check 2: PoolShare model exact 75/25 split
fn test_pool_share to bool
mh_policy_default_flat
put mh_g_pol_model 0 MH_MODEL_POOL_SHARE
mh_members_reset
if ne mh_member_add 1 0.0f64 3 0 0 MH_OK
ret false
end
if ne mh_member_add 2 0.0f64 1 0 0 MH_OK
ret false
end
if ne mh_compute_payout 1250000 MH_OK
ret false
end
if ne get mh_g_res_mpool 0 1000000
ret false
end
if not mt_check_member_amt 1 750000 1
ret false
end
if not mt_check_member_amt 2 250000 1
ret false
end
if ne get mh_g_res_mpay_tot 0 1000000
ret false
end
if ne get mh_g_res_unalloc 0 0
ret false
end
ret true
end

note Check 3: PoolShare zero-drift integer remainder reconciliation ($80 / 3)
fn test_pool_share_drift to bool
mh_policy_default_flat
put mh_g_pol_model 0 MH_MODEL_POOL_SHARE
mh_members_reset
if ne mh_member_add 1 0.0f64 1 0 0 MH_OK
ret false
end
if ne mh_member_add 2 0.0f64 1 0 0 MH_OK
ret false
end
if ne mh_member_add 3 0.0f64 1 0 0 MH_OK
ret false
end
if ne mh_compute_payout 100 MH_OK
ret false
end
if ne get mh_g_res_mpool 0 80
ret false
end
if ne get mh_g_res_unalloc 0 0
ret false
end
tot = add add get mh_g_out_amt 0 get mh_g_out_amt 1 get mh_g_out_amt 2
if ne tot 80
ret false
end
ret true
end

note Check 4: Leadership shared pool + bonus AND leadership buyout exclusion
fn test_leadership to bool
mh_policy_default_flat
put mh_g_pol_model 0 MH_MODEL_POOL_SHARE
put mh_g_pol_split_m 0 0.85f64
put mh_g_pol_split_f 0 0.10f64
put mh_g_pol_split_l 0 0.05f64
put mh_g_pol_has_ldr 0 1
put mh_g_pol_ldr_id 0 99
put mh_g_pol_ldr_shares 0 1
mh_members_reset
if ne mh_member_add 99 0.0f64 50 0 0 MH_OK
ret false
end
if ne mh_member_add 1 0.0f64 1 0 0 MH_OK
ret false
end
if ne mh_member_add 2 0.0f64 1 0 0 MH_OK
ret false
end
if ne mh_compute_payout 1000000 MH_OK
ret false
end
lidx = mh_find_out_by_tid 99
if ge lidx MH_MAX_MEMBERS
ret false
end
if ne get mh_g_out_kind lidx MH_KIND_LEADERSHIP
ret false
end
if ne get mh_g_out_lbonus lidx 50000
ret false
end
if ne get mh_g_out_base lidx 817308
ret false
end
if ne get mh_g_out_amt lidx 867308
ret false
end
if ne get mh_g_res_grand 0 1000000
ret false
end
note Buyout mode (leader_shares_pool = 0): leader excluded from member pool, gets only 50000
put mh_g_pol_ldr_shares 0 0
if ne mh_compute_payout 1000000 MH_OK
ret false
end
lidx2 = mh_find_out_by_tid 99
if ne get mh_g_out_base lidx2 0
ret false
end
if ne get mh_g_out_amt lidx2 50000
ret false
end
if ne get mh_g_res_grand 0 1000000
ret false
end
ret true
end

note Check 5: Flat bonus rewards war hitters only
fn test_flat_bonus to bool
mh_policy_default_flat
put mh_g_pol_model 0 MH_MODEL_POOL_SHARE
put mh_g_pol_flat_bonus 0 5000
mh_members_reset
if ne mh_member_add 1 0.0f64 3 0 0 MH_OK
ret false
end
if ne mh_member_add 2 0.0f64 0 4 0 MH_OK
ret false
end
if ne mh_member_add 3 0.0f64 0 0 6 MH_OK
ret false
end
if ne mh_member_add 4 0.0f64 0 0 0 MH_OK
ret false
end
if ne mh_compute_payout 1000000 MH_OK
ret false
end
if ne get mh_g_out_fbonus mh_find_out_by_tid 1 5000
ret false
end
if ne get mh_g_out_fbonus mh_find_out_by_tid 2 0
ret false
end
if ne get mh_g_out_fbonus mh_find_out_by_tid 3 0
ret false
end
if ne get mh_g_out_fbonus mh_find_out_by_tid 4 0
ret false
end
if ne get mh_g_res_fbonus_tot 0 5000
ret false
end
ret true
end

note Check 6: MobWorth valuation & spendable vault cash
fn test_valuation to bool
if ne mh_compute_valuation 10000.0f64 180284.0f64 50000000.0f64 25000000.0f64 MH_OK
ret false
end
if ne get mh_g_val_resp 0 1802840000
ret false
end
if ne get mh_g_val_armory 0 50000000
ret false
end
if ne get mh_g_val_cash 0 25000000
ret false
end
if ne get mh_g_val_total 0 1877840000
ret false
end
deps = new f64 2 0.0f64
put deps 0 300000.0f64
put deps 1 200000.0f64
if ne mh_net_faction_cash 1000000.0f64 deps 2 500000
ret false
end
note Clamped to 0 if member deposits exceed vault total
if ne mh_net_faction_cash 400000.0f64 deps 2 0
ret false
end
ret true
end

note Check 7: MobGym Vladar Training Formula V2.0 (3 canonical refs + soft cap + 20-train session)
fn test_gym_vladar to bool
note Ref 1: STR S=1,000,000 H=5,000 G=7.3 E=5 -> ~233.17
g1 = mh_gym_expected_gain MH_STAT_STR 1000000.0f64 5000.0f64 5.0f64 7.3f64 1.0f64
if ge fabs sub g1 233.17f64 0.01f64
ret false
end
note Ref 2: STR S=1,000,000 H=0 G=7.3 E=5 -> ~183.10
g2 = mh_gym_expected_gain MH_STAT_STR 1000000.0f64 0.0f64 5.0f64 7.3f64 1.0f64
if ge fabs sub g2 183.10f64 0.01f64
ret false
end
note Ref 3: DEF S=1,000,000 H=10,000 G=6.0 E=25 -> ~1041.20
g3 = mh_gym_expected_gain MH_STAT_DEF 1000000.0f64 10000.0f64 25.0f64 6.0f64 1.0f64
if ge fabs sub g3 1041.20f64 0.01f64
ret false
end
note Soft cap above 50M: 100,000,000 -> 50M + 50M / (8.77635 * 8) = 50712141.15...
sc = mh_soft_cap_stat 100000000.0f64
if ge fabs sub sc 50712141.15f64 1.0f64
ret false
end
note Session simulation: 20 trains, happy decays from 5000 to 4950, total_gain > 4000
mh_gym_reset_opts
put mh_g_gym_use_loss 0 1
put mh_g_gym_loss 0 2.5f64
if ne mh_gym_simulate MH_STAT_STR 1000000.0f64 5000.0f64 100.0f64 5.0f64 7.3f64 MH_OK
ret false
end
if ne get mh_g_gym_trains 0 20
ret false
end
if ge fabs sub get mh_g_gym_espent 0 100.0f64 0.001f64
ret false
end
if ge fabs sub get mh_g_gym_ehappy 0 4950.0f64 0.001f64
ret false
end
if le get mh_g_gym_tgain 0 4000.0f64
ret false
end
if ne mh_stat_parse mt_s_str 0 len mt_s_str MH_STAT_STR
ret false
end
if ne mh_stat_parse mt_s_def 0 len mt_s_def MH_STAT_DEF
ret false
end
if ne mh_stat_parse mt_s_bad 0 len mt_s_bad MH_STAT_INVALID
ret false
end
ret true
end

note Check 8: Money-log HTML parser with OC-cut exclusion & deposit exclusion
fn test_money_log_parser to bool
if ne mh_parse_money_log mt_news_ok len mt_news_ok MH_OK
ret false
end
if ne get mh_g_parse_tid 0 4027928
ret false
end
if ne get mh_g_parse_amt 0 50973248
ret false
end
if ne get mh_g_parse_nlen 0 len mt_name_exp
ret false
end
i = ulong 0
while lt i len mt_name_exp bound 32
if ne get mh_g_parse_name i get mt_name_exp i
ret false
end
i = add i 1
end
note Negative control: OC cut MUST be excluded
if ne mh_parse_money_log mt_news_oc len mt_news_oc MH_ERR_OC_EXCLUDED
ret false
end
note Negative control: deposit entry is not a give
if ne mh_parse_money_log mt_news_dep len mt_news_dep MH_ERR_NO_MATCH
ret false
end
ret true
end

note Check 9: 2-pass disbursement matcher (exact + tolerance + already-paid refusal + no double-claim)
fn test_reconcile_match to bool
mh_rec_reset
if ne mh_rec_add_reg 101 1 1000000 0 MH_OK
ret false
end
if ne mh_rec_add_reg 102 2 500000 0 MH_OK
ret false
end
if ne mh_rec_add_reg 103 3 250000 1 MH_OK
ret false
end
if ne mh_rec_add_give 1 1 1000000 MH_OK
ret false
end
if ne mh_rec_add_give 2 2 501000 MH_OK
ret false
end
note Already-paid row (torn_id 3) must NEVER be matched
if ne mh_rec_add_give 3 3 250000 MH_OK
ret false
end
note Duplicate give for torn_id 1 must NEVER double-claim reg 101
if ne mh_rec_add_give 4 1 1000000 MH_OK
ret false
end
mh_match_disbursements 0.005f64
if ne get mh_g_rec_matched 0 2
ret false
end
if ne get mh_g_rec_unmatched 0 2
ret false
end
if ne get mh_g_give_match 0 101
ret false
end
if ne get mh_g_give_match 1 102
ret false
end
if ne get mh_g_give_match 2 0
ret false
end
if ne get mh_g_give_match 3 0
ret false
end
ret true
end

note Check 10: War window boundary checks & pick_payout_give (One / Ambiguous / None)
fn test_window_and_pick to bool
if not mh_is_in_war_window true 150 true 100 true 200
ret false
end
if mh_is_in_war_window true 90 true 100 true 200
ret false
end
if mh_is_in_war_window true 200 true 100 true 200
ret false
end
if not mh_is_in_war_window true 250 true 100 false 0
ret false
end
if mh_is_in_war_window false 0 true 100 true 200
ret false
end
if not mh_is_in_war_window false 0 true 100 false 0
ret false
end
mh_rec_reset
if ne mh_rec_add_give 1 10 1000000 MH_OK
ret false
end
if ne mh_rec_add_give 2 10 2000000 MH_OK
ret false
end
if ne mh_pick_payout_give 1020000 0.1f64 MH_PICK_ONE
ret false
end
if ne get mh_g_pick_id 0 1
ret false
end
if ne get mh_g_pick_amt 0 1000000
ret false
end
if ne mh_pick_payout_give 1500000 0.5f64 MH_PICK_AMBIGUOUS
ret false
end
if ne mh_pick_payout_give 5000000 0.1f64 MH_PICK_NONE
ret false
end
ret true
end

note Check 11: Vault secret redaction removes all key= values
fn test_vault_redact to bool
n = mh_redact_secrets mt_red_in len mt_red_in
if eq n 0
ret false
end
tmp = new uchar 256 0
if gt n 256
ret false
end
i = ulong 0
while lt i n bound 256
put tmp i get mh_g_buf i
i = add i 1
end
note Neither secret may appear in redacted output
if le mh_find_ci tmp 0 n mt_red_sec1 n
ret false
end
if le mh_find_ci tmp 0 n mt_red_sec2 n
ret false
end
note Marker [REDACTED_BY_ATLAS_VAULT] must appear at least once
if gt mh_find_ci tmp 0 n mh_t_redacted n
ret false
end
ret true
end

note Check 12: Fail-closed negative controls across all engines
fn test_negative_controls to bool
mh_policy_default_flat
mh_members_reset
if ne mh_member_add 42 10.0f64 1 0 0 MH_OK
ret false
end
note Duplicate torn_id refused
if ne mh_member_add 42 5.0f64 1 0 0 MH_ERR_DUP_ID
ret false
end
note Negative cache refused
if ne mh_compute_payout -1 MH_ERR_NEG_CACHE
ret false
end
note Invalid payout model refused
put mh_g_pol_model 0 99
if ne mh_compute_payout 1000 MH_ERR_BAD_MODEL
ret false
end
mh_policy_default_flat
note Invalid split > 1.0 refused
put mh_g_pol_split_m 0 1.5f64
if ne mh_compute_payout 1000 MH_ERR_BAD_SPLITS
ret false
end
note Split sum != 1.0 sets MH_WARN_SPLIT_SUM warning bit
mh_policy_default_flat
put mh_g_pol_split_m 0 0.5f64
if ne mh_compute_payout 1000 MH_OK
ret false
end
if eq and get mh_g_res_warns 0 MH_WARN_SPLIT_SUM 0
ret false
end
note Negative valuation input refused
if ne mh_compute_valuation -1.0f64 100.0f64 0.0f64 0.0f64 MH_ERR_PARSE
ret false
end
note Invalid gym stat or zero energy per train refused
mh_gym_reset_opts
if ne mh_gym_simulate 99 1000.0f64 500.0f64 100.0f64 5.0f64 7.0f64 MH_ERR_BAD_STAT
ret false
end
if ne mh_gym_simulate MH_STAT_STR 1000.0f64 500.0f64 100.0f64 0.0f64 7.0f64 MH_ERR_BAD_ENERGY
ret false
end
ret true
end

fn main to int
if not test_ganja_warriors_ground_truth
ret mt_fail 1
end
if not test_pool_share
ret mt_fail 2
end
if not test_pool_share_drift
ret mt_fail 3
end
if not test_leadership
ret mt_fail 4
end
if not test_flat_bonus
ret mt_fail 5
end
if not test_valuation
ret mt_fail 6
end
if not test_gym_vladar
ret mt_fail 7
end
if not test_money_log_parser
ret mt_fail 8
end
if not test_reconcile_match
ret mt_fail 9
end
if not test_window_and_pick
ret mt_fail 10
end
if not test_vault_redact
ret mt_fail 11
end
if not test_negative_controls
ret mt_fail 12
end
mt_write_text mt_pass
ret 0
end

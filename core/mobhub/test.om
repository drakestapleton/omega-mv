note core/mobhub/test.om: comprehensive pure-Omega test suite for MobHub.
note Compose with: si/directives/om2.om core/mobhub/lib.om core/mobhub/test.om
note
note Covers all upstream Rust/Mojo unit tests + negative/refusal controls:
note   1. GanjaWarriors Ranked War #40711 ground truth (all 23 members, FlatRate)
note   2. PoolShare model exact split & zero unallocated
note   3. PoolShare zero-drift integer remainder reconciliation ($80 / 3 members)
note   4. Leadership shared pool + bonus & Leadership buyout exclusion
note   5. Flat bonus rewards war hitters only (assist/outside/no-show excluded)
note   6. MobWorth valuation & spendable vault cash calculation
note   7. MobGym Vladar Training Formula V2.0 (3 canonical reference cases + soft cap + 20-train session)
note   8. Money-log HTML parser with automatic OC-cut exclusion & deposit exclusion
note   9. 2-pass disbursement matcher (exact, tolerance, already-paid refusal, no double-claim)
note  10. War window boundary checks & pick_payout_give (One, Ambiguous, None)
note  11. Vault secret redaction (multi-key query param scrubbing)
note  12. Fail-closed negative controls (negative cache, bad model, bad splits, dup torn_id, bad stat/energy)

text mt_pass "PASS core/mobhub: all 12 test suites passed (GanjaWarriors ground truth + Vladar V2.0 + negative controls)\n"
text mt_fail_pre "FAIL core/mobhub: check "
text mt_nl "\n"

text mt_news_ok "<a href=\"profiles.php?XID=100\">Officer</a> increased <a href=\"profiles.php?XID=4027928\">TheLastPrimate</a>'s money balance by $50,973,248 from $0 to $50,973,248."
text mt_news_oc "<a href=\"profiles.php?XID=100\">Officer</a> increased <a href=\"profiles.php?XID=4027928\">TheLastPrimate</a>'s money balance by $1,250,000 as their cut for their role as Planner."
text mt_news_dep "<a href=\"profiles.php?XID=2532285\">MrRazorlove</a> deposited $10,000,000 to faction vault."
text mt_name_exp "TheLastPrimate"

text mt_red_in "GET https://api.torn.com/v2/faction/rankedwars?key=abcdef123456&limit=10 and retry key=9876543210zyx"
text mt_red_sec1 "abcdef123456"
text mt_red_sec2 "9876543210zyx"

text mt_s_str "Strength"
text mt_s_def "def"
text mt_s_bad "charisma"

fn mt_write_text s view uchar * to void
w = write 1 s 0 len s
if lt w 0
exit 99
end
end

fn mt_fail code ulong to int
mt_write_text mt_fail_pre
buf = new uchar 24 0
outb = new uchar 24 0
x = code
k = ulong 0
if eq x 0
put buf 0 48
k = 1
else
while gt x 0 bound 24
put buf k uchar add 48 rem x 10
x = div x 10
k = add k 1
end
end
j = ulong 0
while lt j k bound 24
put outb j get buf sub sub k 1 j
j = add j 1
end
w = write 1 outb 0 k
if lt w 0
exit 99
end
mt_write_text mt_nl
ret int code
end

fn mt_check_member_amt tid long expected long tol long to bool
idx = mh_find_out_by_tid tid
if ge idx MH_MAX_MEMBERS
ret false
end
got = get mh_g_out_amt idx
ret lt mh_iabs sub got expected tol
end


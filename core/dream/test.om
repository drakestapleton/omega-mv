note core/dream/test.om: comprehensive positive and negative/refusal tests for spark-dream.
note Covers all 4 upstream markdown layouts, malformed frontmatter recovery, idle gate,
note decay scoring, zero-safe cosine similarity, clustering/dedup, promotion, and refusals.
note Compose: si/directives/om2.om core/dream/lib.om core/dream/test.om

text dt_p_fm "/tmp/note_frontmatter.md"
text dt_c_fm "---\ntitle: NVFP4 Checkpoint Loader Fix\ntype: learned_procedure\ntags: [vllm, max, quantization]\nsubsystem: neural_weights\n---\n# Implementation Overview\nDirectly map fp4 quantized tensor blocks without conversion overhead."
text dt_e_fm "NVFP4 Checkpoint Loader Fix"

text dt_p_hd "/tmp/note_heading.md"
text dt_c_hd "# Discovery: Grace Blackwell GB10 Topology\nDiscovered unified 128GB LPDDR5X bus between CPU and dual Blackwell GPUs."
text dt_e_hd "Grace Blackwell GB10 Topology"

text dt_p_les "/tmp/note_lesson.md"
text dt_c_les "# Lesson: Guard Bounds Before Load\nNever index without checking length."
text dt_e_les "Guard Bounds Before Load"

text dt_p_bl "/tmp/note_bullet.md"
text dt_c_bl "- Finding: SQLite WAL checkpoint stalls under massive bulk insert\n- Solution: Run PRAGMA wal_checkpoint(TRUNCATE)"
text dt_e_bl "SQLite WAL checkpoint stalls under massive bulk insert"

text dt_p_rw "/tmp/parked-hotfix-123.md"
text dt_c_rw "Fixed zero-length embedding cosine calculation crash."
text dt_e_rw "parked-parked-hotfix-123"

text dt_p_mf "/tmp/malformed.md"
text dt_c_mf "---\nunclosed frontmatter fence without closing delimiter\n# Actual Title Here\nValid body content that must not be discarded."
text dt_e_mf "Actual Title Here"

text dt_p_txt "/tmp/random.txt"
text dt_p_png "/tmp/diagram.png"
text dt_p_emp "/tmp/empty.md"
text dt_c_emp ""
text dt_c_ws "   \n\t  \n "
text dt_c_any "non-markdown content"

text dt_ok_md "PASS markdown layouts + malformed recovery (6/6)\n"
text dt_ok_id "PASS idle thresholds (7/7)\n"
text dt_ok_dc "PASS recency + importance decay scoring\n"
text dt_ok_cs "PASS cosine/dot similarity + zero-vector guard\n"
text dt_ok_cy "PASS clustering, deduplication & threshold promotion\n"
text dt_ok_ng "PASS negative/refusal controls (9/9 refused)\n"
text dt_all "ALL PASS spark-dream\n"
text dt_fail "FAIL spark-dream code="

fn dt_fail_ret code int to int
dm_ob_reset
dm_ob_str dt_fail
dm_ob_i64 long code
dm_ob_str td_nl
dm_ob_flush
ret code
end

fn test_markdown_layouts to int
dream_reset

if ne dream_ingest_markdown dt_p_fm dt_c_fm 0 0.9f64 DREAM_OK
ret 1
end
if ne get dm_layout 0 DREAM_LAYOUT_FRONTMATTER
ret 2
end
if ne get dm_itype 0 DREAM_TYPE_PROCEDURE
ret 3
end
if ne get dm_tags 0 3
ret 4
end
if not dream_name_eq 0 dt_e_fm
ret 5
end

if ne dream_ingest_markdown dt_p_hd dt_c_hd 0 0.8f64 DREAM_OK
ret 6
end
if ne get dm_layout 1 DREAM_LAYOUT_HEADING
ret 7
end
if ne get dm_itype 1 DREAM_TYPE_DISCOVERY
ret 8
end
if not dream_name_eq 1 dt_e_hd
ret 9
end

if ne dream_ingest_markdown dt_p_les dt_c_les 0 0.8f64 DREAM_OK
ret 10
end
if ne get dm_itype 2 DREAM_TYPE_LESSON
ret 11
end
if not dream_name_eq 2 dt_e_les
ret 12
end

if ne dream_ingest_markdown dt_p_bl dt_c_bl 0 0.7f64 DREAM_OK
ret 13
end
if ne get dm_layout 3 DREAM_LAYOUT_BULLET
ret 14
end
if not dream_name_eq 3 dt_e_bl
ret 15
end

if ne dream_ingest_markdown dt_p_rw dt_c_rw 0 0.6f64 DREAM_OK
ret 16
end
if ne get dm_layout 4 DREAM_LAYOUT_RAW
ret 17
end
if not dream_name_eq 4 dt_e_rw
ret 18
end

if ne dream_ingest_markdown dt_p_mf dt_c_mf 0 0.7f64 DREAM_OK
ret 19
end
if ne get dm_layout 5 DREAM_LAYOUT_HEADING
ret 20
end
if not dream_name_eq 5 dt_e_mf
ret 21
end

ret 0
end

fn test_idle_thresholds to int
if dream_is_idle 6 1200 900
ret 30
end
if dream_is_idle 99 1200 900
ret 31
end
if dream_is_idle 0 300 900
ret 32
end
if dream_is_idle 2 899 900
ret 33
end
if not dream_is_idle 0 900 900
ret 34
end
if not dream_is_idle 3 1500 900
ret 35
end
if not dream_is_idle 5 3600 900
ret 36
end
ret 0
end

fn test_decay_scoring to int
s0 = dream_decay_score 0.8f64 0 3600
if gt fabs sub s0 0.8f64 0.000001f64
ret 40
end
s1 = dream_decay_score 0.8f64 3600 3600
if gt fabs sub s1 0.4f64 0.00001f64
ret 41
end
s2 = dream_decay_score 0.8f64 7200 3600
if gt fabs sub s2 0.2f64 0.00001f64
ret 42
end
if not and gt s0 s1 gt s1 s2
ret 43
end
ret 0
end

fn test_cosine_and_zero_guard to int
dream_reset
if ne dream_ingest_markdown dt_p_hd dt_c_hd 0 0.9f64 DREAM_OK
ret 50
end
if ne dream_ingest_markdown dt_p_bl dt_c_bl 0 0.9f64 DREAM_OK
ret 51
end
if ne dream_ingest_markdown dt_p_rw dt_c_rw 0 0.9f64 DREAM_OK
ret 52
end

v0 = new f64 8 0.0f64
put v0 0 1.0f64
put v0 1 0.0f64
v1 = new f64 8 0.0f64
put v1 0 0.0f64
put v1 1 1.0f64
vz = new f64 8 0.0f64

dream_set_embedding 0 view v0
dream_set_embedding 1 view v1
dream_set_embedding 2 view vz

if gt fabs sub dream_cosine 0 0 1.0f64 0.000001f64
ret 53
end
if gt fabs dream_cosine 0 1 0.000001f64
ret 54
end
note Zero-length embedding cosine must cleanly return 0.0 (no NaN / crash)
c_zero = dream_cosine 0 2
if or ne c_zero 0.0f64 ne dream_cosine 2 2 0.0f64
ret 55
end

note Text-derived signed feature embeddings: identical notes -> cosine ~1.0, distinct notes -> cosine < 0.85
dream_reset
if ne dream_ingest_markdown dt_p_fm dt_c_fm 0 0.9f64 DREAM_OK
ret 56
end
if ne dream_ingest_markdown dt_p_fm dt_c_fm 60 0.8f64 DREAM_OK
ret 57
end
if ne dream_ingest_markdown dt_p_bl dt_c_bl 0 0.9f64 DREAM_OK
ret 58
end
if lt dream_cosine 0 1 0.9999f64
ret 59
end
if ge dream_cosine 0 2 0.85f64
ret 59
end
ret 0
end

fn test_clustering_and_promotion to int
dream_reset
note Episode 0: fresh, high importance -> score 0.90 -> COMMITTED representative
if ne dream_ingest_markdown dt_p_fm dt_c_fm 0 0.90f64 DREAM_OK
ret 60
end
note Episode 1: near-duplicate embedding of Ep 0 -> DEDUPED into Ep 0
if ne dream_ingest_markdown dt_p_hd dt_c_hd 100 0.80f64 DREAM_OK
ret 61
end
note Episode 2: orthogonal embedding, medium decayed score (0.50) -> STAGED
if ne dream_ingest_markdown dt_p_bl dt_c_bl 3600 1.00f64 DREAM_OK
ret 62
end
note Episode 3: orthogonal embedding, stale low decayed score (0.10) -> REJECTED
if ne dream_ingest_markdown dt_p_rw dt_c_rw 10800 0.80f64 DREAM_OK
ret 63
end

e0 = new f64 8 0.0f64
put e0 0 1.0f64
e1 = new f64 8 0.0f64
put e1 0 0.98f64
put e1 1 0.199f64
e2 = new f64 8 0.0f64
put e2 2 1.0f64
e3 = new f64 8 0.0f64
put e3 3 1.0f64

dream_set_embedding 0 view e0
dream_set_embedding 1 view e1
dream_set_embedding 2 view e2
dream_set_embedding 3 view e3

cfg = new DreamConfig 0 0 0 true 3600 0.85f64 0.65f64 0.35f64 0.15f64
dream_default_config edit cfg
st = new DreamState false 0 0 0 0 0 0 0 0
rc = dream_run_cycle view cfg edit st
if ne rc DREAM_OK
ret 64
end
if not get st ok
ret 65
end
if ne get st ingested 4
ret 66
end
if ne get st clusters 3
ret 67
end
if ne get st deduped 1
ret 68
end
if ne get st committed 1
ret 69
end
if ne get st staged 1
ret 70
end
if ne get st rejected 1
ret 71
end
if ne get dm_status 0 DREAM_ST_COMMITTED
ret 72
end
if ne get dm_status 1 DREAM_ST_DEDUPED
ret 73
end
if ne get dm_rep 1 0
ret 74
end
if ne get dm_csize 0 2
ret 75
end
if ne get dm_status 2 DREAM_ST_STAGED
ret 76
end
if ne get dm_status 3 DREAM_ST_REJECTED
ret 77
end
ret 0
end

fn test_negative_refusals to int
dream_reset

note 1. Reject non-markdown .txt
if ne dream_ingest_markdown dt_p_txt dt_c_any 0 0.8f64 DREAM_ERR_NON_MD
ret 80
end
note 2. Reject non-markdown .png
if ne dream_ingest_markdown dt_p_png dt_c_any 0 0.8f64 DREAM_ERR_NON_MD
ret 81
end
note 3. Reject empty .md
if ne dream_ingest_markdown dt_p_emp part dt_c_emp 0 0 0 0.8f64 DREAM_ERR_EMPTY
ret 82
end
note 4. Reject whitespace-only .md
if ne dream_ingest_markdown dt_p_emp dt_c_ws 0 0.8f64 DREAM_ERR_EMPTY
ret 83
end
note 5. Reject out-of-range importance (> 1.0 and < 0.0)
if ne dream_ingest_markdown dt_p_hd dt_c_hd 0 1.2f64 DREAM_ERR_BAD_IMP
ret 84
end
if ne dream_ingest_markdown dt_p_hd dt_c_hd 0 -0.1f64 DREAM_ERR_BAD_IMP
ret 85
end

note 6. Refuse cycle when GPU is busy (> 5%)
cfg = new DreamConfig 0 0 0 true 3600 0.85f64 0.65f64 0.35f64 0.15f64
dream_default_config edit cfg
put cfg gpu_util 42
st = new DreamState false 0 0 0 0 0 0 0 0
if ne dream_run_cycle view cfg edit st DREAM_ERR_NOT_IDLE
ret 86
end

note 7. Refuse cycle when operator active (< idle_thresh)
dream_default_config edit cfg
put cfg idle_secs 300
if ne dream_run_cycle view cfg edit st DREAM_ERR_NOT_IDLE
ret 87
end

note 8. Refuse invalid stage_thr > commit_thr
dream_default_config edit cfg
put cfg stage_thr 0.80f64
put cfg commit_thr 0.60f64
if ne dream_run_cycle view cfg edit st DREAM_ERR_BAD_CONFIG
ret 88
end

note 9. Refuse zero half_life
dream_default_config edit cfg
put cfg half_life 0
if ne dream_run_cycle view cfg edit st DREAM_ERR_BAD_CONFIG
ret 89
end

ret 0
end

fn main to int
c1 = test_markdown_layouts
if ne c1 0
ret dt_fail_ret c1
end
dm_ob_reset
dm_ob_str dt_ok_md
dm_ob_flush

c2 = test_idle_thresholds
if ne c2 0
ret dt_fail_ret c2
end
dm_ob_reset
dm_ob_str dt_ok_id
dm_ob_flush

c3 = test_decay_scoring
if ne c3 0
ret dt_fail_ret c3
end
dm_ob_reset
dm_ob_str dt_ok_dc
dm_ob_flush

c4 = test_cosine_and_zero_guard
if ne c4 0
ret dt_fail_ret c4
end
dm_ob_reset
dm_ob_str dt_ok_cs
dm_ob_flush

c5 = test_clustering_and_promotion
if ne c5 0
ret dt_fail_ret c5
end
dm_ob_reset
dm_ob_str dt_ok_cy
dm_ob_flush

c6 = test_negative_refusals
if ne c6 0
ret dt_fail_ret c6
end
dm_ob_reset
dm_ob_str dt_ok_ng
dm_ob_str dt_all
dm_ob_flush
ret 0
end

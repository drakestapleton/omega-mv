note core/dream/main.om: sovereign dream-cycle consolidation CLI demo.
note Compose: si/directives/om2.om core/dream/lib.om core/dream/main.om

text dm_banner "=== SPARK-DREAM: DYNAMIC SESSION MEMORY CONSOLIDATION ===\n"
text dm_p1 "/park/nvfp4-loader.md"
text dm_c1 "---\ntitle: NVFP4 Checkpoint Loader Fix\ntype: learned_procedure\ntags: [vllm, max, quantization]\n---\nDirectly map fp4 quantized tensor blocks without conversion overhead."
text dm_p2 "/park/nvfp4-dup.md"
text dm_c2 "---\ntitle: NVFP4 Checkpoint Loader Fix\ntype: learned_procedure\n---\nDirectly map fp4 quantized tensor blocks without conversion overhead."
text dm_p3 "/park/gb10-topo.md"
text dm_c3 "# Discovery: Grace Blackwell GB10 Topology\nDiscovered unified 128GB LPDDR5X bus between CPU and Blackwell GPU."
text dm_p4 "/park/wal-stall.md"
text dm_c4 "- Finding: SQLite WAL checkpoint stalls under bulk insert\n- Solution: Run PRAGMA wal_checkpoint(TRUNCATE)"
text dm_p5 "/park/old-scratch.md"
text dm_c5 "Stale temporary observation from an expired debug run."
text dm_err_msg "dream cycle refused\n"

fn main to int
dm_ob_reset
dm_ob_str dm_banner
dm_ob_flush

dream_reset
if ne dream_ingest_markdown dm_p1 dm_c1 120 0.90f64 DREAM_OK
dm_ob_reset
dm_ob_str dm_err_msg
dm_ob_flush
ret 1
end
if ne dream_ingest_markdown dm_p2 dm_c2 240 0.85f64 DREAM_OK
dm_ob_reset
dm_ob_str dm_err_msg
dm_ob_flush
ret 1
end
if ne dream_ingest_markdown dm_p3 dm_c3 600 0.80f64 DREAM_OK
dm_ob_reset
dm_ob_str dm_err_msg
dm_ob_flush
ret 1
end
if ne dream_ingest_markdown dm_p4 dm_c4 3600 0.95f64 DREAM_OK
dm_ob_reset
dm_ob_str dm_err_msg
dm_ob_flush
ret 1
end
if ne dream_ingest_markdown dm_p5 dm_c5 18000 0.60f64 DREAM_OK
dm_ob_reset
dm_ob_str dm_err_msg
dm_ob_flush
ret 1
end

cfg = new DreamConfig 0 0 0 true 3600 0.85f64 0.65f64 0.35f64 0.15f64
dream_default_config edit cfg
st = new DreamState false 0 0 0 0 0 0 0 0
rc = dream_run_cycle view cfg edit st
if ne rc DREAM_OK
dm_ob_reset
dm_ob_str dm_err_msg
dm_ob_flush
ret 2
end

dream_print_state view st
dream_print_records
ret 0
end

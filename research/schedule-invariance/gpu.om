note GPU addition uses the existing native NVIDIA realizer; all other operations stay on the CPU.
note Compose context.om vector.om launch.om gpu.om worker.om, in that order.
note No CPU substitution for a failed GPU operation. Input/output mappings and completion checked.
text si_gerr "GPU_REALIZATION_FAILED\n"
fn si_fail to void
k = write 2 si_gerr 0 len si_gerr
ok = nvstop
exit 31
end
fn si_add lhs ulong rhs ulong to ulong
if ne mapset get gbmem 5 0 4 lhs 0
si_fail
end
if ne mapset get gbmem 6 0 4 rhs 0
si_fail
end
if not gblaunch 1
si_fail
end
ret rem mapget get gbmem 7 0 4 65521
end
fn si_start to bool
if not gbopen 1
si_fail
end
ret true
end
fn si_stop to bool
ret nvstop
end

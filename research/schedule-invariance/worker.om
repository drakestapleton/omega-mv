note Schedule-invariance experimental realizer. Fixed-width records are the wire format, not graph limits.
note Eight little-endian unsigned words in, the same eight words and a result out.
note Only declared operands affect arithmetic. Delays belong to realization, not semantic identity.
global si_input uchar 64
global si_output uchar 72
global si_state ulong 1
fn si_word at ulong to ulong
v = ulong 0
for j ulong 8
v = or v shl ulong get si_input add at j mul j 8
end
ret v
end
fn si_result opcode ulong lhs ulong rhs ulong to ulong
if eq opcode 1
ret si_add lhs rhs
end
if eq opcode 2
ret rem mul lhs rhs 65521
end
if eq opcode 3
ret rem sub add lhs 65521 rhs 65521
end
if eq opcode 4
if gt lhs 255
exit 24
end
put si_output 0 uchar lhs
k = write 2 si_output 0 1
if ne k 1
exit 25
end
ret lhs
end
exit 21
end
fn si_read to bool
used = ulong 0
while lt used 64 bound 64
got = read 0 si_input used sub 64 used
if eq got -4
continue
end
if eq got 0
if eq used 0
ret false
end
exit 20
end
if lt got 0
exit 22
end
used = add used ulong got
end
ret true
end
fn si_send value ulong to void
for i ulong 64
put si_output i get si_input i
end
for j ulong 8
put si_output add 64 j uchar and shr value mul j 8 255
end
sent = ulong 0
while lt sent 72 bound 72
k = write 1 si_output sent sub 72 sent
if eq k -4
continue
end
if le k 0
exit 27
end
sent = add sent ulong k
end
end
fn main to int
if not si_start
ret 30
end
while si_read bound 9223372036854775807
opcode = si_word 8
lhs = si_word 32
rhs = si_word 40
if or ge lhs 65521 ge rhs 65521
ret 23
end
delay = si_word 48
if ne delay 0
rc = sleepns long delay
if ne rc 0
ret 26
end
end
value = si_result opcode lhs rhs
si_send value
end
if not si_stop
ret 32
end
ret 0
end

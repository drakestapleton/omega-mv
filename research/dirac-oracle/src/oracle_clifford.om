om2
note SPDX-License-Identifier: Apache-2.0
note Copyright 2026 Drake Stapleton (AIEN / aien-dev)
note DIRAC-0 independent oracle: exact Clifford relation check (pure seeded OM-2).
note Ported from research/dirac-oracle/src/oracle_clifford.c with byte-exact parity.
note Input on stdin: d n, m_0..m_{d-1}, then d * n * n Gaussian integer pairs (re im).
note Output: FAIL i j per failing pair, then PASS (exit 0) or FAIL_COUNT k (exit 1); exit 2 on bad input.

global inp uchar 65536
global st_u ulong 4
global st_l long 2

global metric long 4
global g_re long 64
global g_im long 64
global p_re long 16
global p_im long 16
global q_re long 16
global q_im long 16

global obuf uchar 4096
global digs uchar 24

fn is_ws ch uchar to int
  if eq ch uchar 32
    ret 1
  end
  if eq ch uchar 9
    ret 1
  end
  if eq ch uchar 10
    ret 1
  end
  if eq ch uchar 11
    ret 1
  end
  if eq ch uchar 12
    ret 1
  end
  if eq ch uchar 13
    ret 1
  end
  ret 0
end

fn read_all_stdin to void
  n = ulong 0
  while lt n ulong 65536 bound 65537
    k = read 0 inp n sub ulong 65536 n
    if le k long 0
      break
    end
    n = add n ulong k
  end
  put st_u ulong 0 n
  put st_u ulong 1 ulong 0
end

fn next_long to void
  put st_l ulong 0 long 0
  put st_l ulong 1 long 0
  inpn = get st_u ulong 0
  pos = get st_u ulong 1
  while lt pos inpn bound 65536
    w = is_ws get inp pos
    if eq w 0
      break
    end
    pos = add pos ulong 1
  end
  if ge pos inpn
    put st_u ulong 1 pos
    ret
  end
  neg_f = int 0
  c0 = get inp pos
  if eq c0 uchar 45
    neg_f = int 1
    pos = add pos ulong 1
  else
    if eq c0 uchar 43
      pos = add pos ulong 1
    end
  end
  if ge pos inpn
    put st_u ulong 1 pos
    ret
  end
  c1 = get inp pos
  if lt c1 uchar 48
    put st_u ulong 1 pos
    ret
  end
  if gt c1 uchar 57
    put st_u ulong 1 pos
    ret
  end
  acc = long 0
  ovf = int 0
  while lt pos inpn bound 65536
    cd = get inp pos
    if lt cd uchar 48
      break
    end
    if gt cd uchar 57
      break
    end
    dig = long sub cd uchar 48
    if gt acc long 10000000000000000
      ovf = int 1
    else
      acc = add mul acc long 10 dig
    end
    pos = add pos ulong 1
  end
  put st_u ulong 1 pos
  if ne ovf 0
    ret
  end
  if ne neg_f 0
    acc = neg acc
  end
  put st_l ulong 1 acc
  put st_l ulong 0 long 1
end

fn emit_byte b uchar to void
  olen = get st_u ulong 2
  if lt olen ulong 4096
    put obuf olen b
    put st_u ulong 2 add olen ulong 1
  end
end

fn emit_uint v ulong to void
  nd = ulong 0
  cur = v
  if eq cur ulong 0
    emit_byte uchar 48
    ret
  end
  while gt cur ulong 0 bound 24
    d = rem cur ulong 10
    put digs nd uchar add d ulong 48
    nd = add nd ulong 1
    cur = div cur ulong 10
  end
  while gt nd ulong 0 bound 24
    nd = sub nd ulong 1
    emit_byte get digs nd
  end
end

fn emit_fail_pair i ulong j ulong to void
  emit_byte uchar 70
  emit_byte uchar 65
  emit_byte uchar 73
  emit_byte uchar 76
  emit_byte uchar 32
  emit_uint i
  emit_byte uchar 32
  emit_uint j
  emit_byte uchar 10
end

fn emit_pass to void
  emit_byte uchar 80
  emit_byte uchar 65
  emit_byte uchar 83
  emit_byte uchar 83
  emit_byte uchar 10
end

fn emit_fail_count k ulong to void
  emit_byte uchar 70
  emit_byte uchar 65
  emit_byte uchar 73
  emit_byte uchar 76
  emit_byte uchar 95
  emit_byte uchar 67
  emit_byte uchar 79
  emit_byte uchar 85
  emit_byte uchar 78
  emit_byte uchar 84
  emit_byte uchar 32
  emit_uint k
  emit_byte uchar 10
end

fn flush_out to void
  olen = get st_u ulong 2
  pos = ulong 0
  while lt pos olen bound 4096
    remn = sub olen pos
    wr = write 1 obuf pos remn
    if le wr long 0
      ret
    end
    pos = add pos ulong wr
  end
end

fn gmul_re ai ulong bi ulong to long
  p1 = mul get g_re ai get g_re bi
  p2 = mul get g_im ai get g_im bi
  ret sub p1 p2
end

fn gmul_im ai ulong bi ulong to long
  p1 = mul get g_re ai get g_im bi
  p2 = mul get g_im ai get g_re bi
  ret add p1 p2
end

fn matmul_cell abase ulong bbase ulong r4 ulong c ulong n ulong dst_q int to void
  sre = long 0
  sim = long 0
  for k ulong n
    ai = add abase add r4 k
    bi = add bbase add mul k ulong 4 c
    sre = add sre gmul_re ai bi
    sim = add sim gmul_im ai bi
  end
  oi = add r4 c
  if eq dst_q 0
    put p_re oi sre
    put p_im oi sim
  else
    put q_re oi sre
    put q_im oi sim
  end
end

fn matmul_into a_idx ulong b_idx ulong n ulong dst_q int to void
  abase = mul a_idx ulong 16
  bbase = mul b_idx ulong 16
  for r ulong n
    r4 = mul r ulong 4
    for c ulong n
      matmul_cell abase bbase r4 c n dst_q
    end
  end
end

fn check_pair i ulong j ulong n ulong to int
  matmul_into i j n 0
  matmul_into j i n 1
  bad = int 0
  for r ulong n
    r4 = mul r ulong 4
    for c ulong n
      oi = add r4 c
      want = long 0
      if eq r c
        if eq i j
          want = mul long 2 get metric i
        end
      end
      sum_re = add get p_re oi get q_re oi
      sum_im = add get p_im oi get q_im oi
      if ne sum_re want
        bad = int 1
      end
      if ne sum_im long 0
        bad = int 1
      end
    end
  end
  ret bad
end

fn main to int
  put st_u ulong 2 ulong 0
  read_all_stdin

  next_long
  if eq get st_l ulong 0 long 0
    ret 2
  end
  d_s = get st_l ulong 1
  next_long
  if eq get st_l ulong 0 long 0
    ret 2
  end
  n_s = get st_l ulong 1

  if lt d_s long 1
    ret 2
  end
  if gt d_s long 4
    ret 2
  end
  if lt n_s long 1
    ret 2
  end
  if gt n_s long 4
    ret 2
  end

  d = ulong d_s
  n = ulong n_s

  for i ulong d
    next_long
    if eq get st_l ulong 0 long 0
      ret 2
    end
    mv = get st_l ulong 1
    if lt mv neg long 1
      ret 2
    end
    if gt mv long 1
      ret 2
    end
    put metric i mv
  end

  for i ulong d
    ibase = mul i ulong 16
    for r ulong n
      r4 = mul r ulong 4
      for c ulong n
        next_long
        if eq get st_l ulong 0 long 0
          ret 2
        end
        rv = get st_l ulong 1
        next_long
        if eq get st_l ulong 0 long 0
          ret 2
        end
        iv = get st_l ulong 1
        if gt rv long 1048576
          ret 2
        end
        if lt rv neg long 1048576
          ret 2
        end
        if gt iv long 1048576
          ret 2
        end
        if lt iv neg long 1048576
          ret 2
        end
        idx = add ibase add r4 c
        put g_re idx rv
        put g_im idx iv
      end
    end
  end

  fails = ulong 0
  for i ulong d
    j = i
    while lt j d bound 4
      bad = check_pair i j n
      if ne bad 0
        emit_fail_pair i j
        fails = add fails ulong 1
      end
      j = add j ulong 1
    end
  end

  if eq fails ulong 0
    emit_pass
    flush_out
    ret 0
  end
  emit_fail_count fails
  flush_out
  ret 1
end

note ---- Low-level I/O helpers ----

fn write_all fd int buf view uchar * n ulong to bool
  off = ulong 0
  while lt off n bound 1000000
    k = write fd buf off sub n off
    if le k long 0
      ret false
    end
    off = add off ulong k
  end
  ret true
end

fn err_str s view uchar * to void
  ok = write_all int 2 s len s
  if not ok
    exit int 1
  end
end

fn err_arg idx ulong to void
  n = argread idx g_argbuf ulong 0 ulong 4096
  if gt n long 0
    un = ulong n
    off = ulong 0
    while lt off un bound 4096
      k = write int 2 g_argbuf off sub un off
      if le k long 0
        exit int 1
      end
      off = add off ulong k
    end
  end
end

fn die0 msg view uchar * to void
  err_str t_prog
  err_str msg
  err_str t_nl
  exit int 1
end

fn die1 msg view uchar * idx ulong to void
  err_str t_prog
  err_str msg
  err_str t_colon
  err_arg idx
  err_str t_nl
  exit int 1
end

fn out_flush to void
  pos = get g_outpos 0
  if eq pos ulong 0
    ret
  end
  off = ulong 0
  while lt off pos bound 1000000
    k = write int 1 g_outbuf off sub pos off
    if le k long 0
      die0 t_err_write
    end
    off = add off ulong k
  end
  put g_outpos 0 ulong 0
end

fn out_ch c uchar to void
  pos = get g_outpos 0
  if ge pos ulong 65536
    out_flush
    pos = ulong 0
  end
  put g_outbuf pos c
  put g_outpos 0 add pos 1
end

fn out_str s view uchar * to void
  n = len s
  i = ulong 0
  while lt i n bound 65536
    out_ch get s i
    i = add i 1
  end
end

fn out_u64 v ulong to void
  if eq v ulong 0
    out_ch uchar 48
    ret
  end
  dig = new uchar 24 0
  nd = ulong 0
  x = v
  while gt x ulong 0 bound 24
    d = rem x ulong 10
    put dig nd uchar add d ulong 48
    x = div x ulong 10
    nd = add nd 1
  end
  while gt nd ulong 0 bound 24
    nd = sub nd 1
    out_ch get dig nd
  end
end

fn out_i64 v long to void
  if lt v long 0
    out_ch uchar 45
    uv = bitcast ulong v
    mag = sub ulong 0 uv
    out_u64 mag
    ret
  end
  out_u64 ulong v
end

fn out_hex32 v uint to void
  i = ulong 0
  while lt i ulong 8 bound 8
    sh = mul sub ulong 7 i ulong 4
    nib = and shr ulong v sh ulong 15
    out_ch get t_hex nib
    i = add i 1
  end
end

fn out_xname idx ulong to void
  if eq idx ulong 0
    out_str t_x0
    ret
  end
  if eq idx ulong 1
    out_str t_x1
    ret
  end
  if eq idx ulong 2
    out_str t_x2
    ret
  end
  if eq idx ulong 3
    out_str t_x3
    ret
  end
  if eq idx ulong 4
    out_str t_x4
    ret
  end
  if eq idx ulong 5
    out_str t_x5
    ret
  end
  if eq idx ulong 6
    out_str t_x6
    ret
  end
  if eq idx ulong 7
    out_str t_x7
    ret
  end
  if eq idx ulong 8
    out_str t_x8
    ret
  end
  out_str t_x9
end

fn out_verd code ulong to void
  if eq code ulong 0
    out_str t_v_under
    ret
  end
  if eq code ulong 1
    out_str t_v_qual
    ret
  end
  if eq code ulong 2
    out_str t_v_cost
    ret
  end
  if eq code ulong 3
    out_str t_v_no
    ret
  end
  out_str t_v_inc
end

note ---- Argument and file reading helpers ----

fn arg_eq idx ulong pat view uchar * to bool
  n = argread idx g_argbuf ulong 0 ulong 4096
  if ne n long len pat
    ret false
  end
  i = ulong 0
  while lt i len pat bound 4096
    if ne get g_argbuf i get pat i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn open_arg idx ulong to int
  n = argread idx g_argbuf ulong 0 ulong 4096
  if le n long 0
    die1 t_err_open idx
  end
  fd = fopen g_argbuf ulong 0 ulong n int 0 int 0
  if lt fd long 0
    die1 t_err_open idx
  end
  ret int fd
end

fn fnv_step h ulong b uchar to ulong
  ret mul xor h ulong b ulong 1099511628211
end

fn fnv_file idx ulong to ulong
  fd = open_arg idx
  h = ulong 14695981039346656037
  done = false
  while not done bound 10000000
    k = read fd g_iobuf ulong 0 ulong 65536
    if lt k long 0
      c = fclose fd
      die1 t_err_read idx
    end
    if eq k long 0
      done = true
    else
      uk = ulong k
      i = ulong 0
      while lt i uk bound 65536
        h = fnv_step h get g_iobuf i
        i = add i 1
      end
    end
  end
  c = fclose fd
  ret h
end

fn slurp_rec idx ulong to void
  fd = open_arg idx
  h = ulong 14695981039346656037
  tot = ulong 0
  done = false
  while not done bound 10000000
    k = read fd g_iobuf ulong 0 ulong 65536
    if lt k long 0
      c = fclose fd
      die1 t_err_read idx
    end
    if eq k long 0
      done = true
    else
      uk = ulong k
      i = ulong 0
      while lt i uk bound 65536
        b = get g_iobuf i
        h = fnv_step h b
        if lt tot MAX_REC_BYTES
          put g_rec tot b
        end
        tot = add tot 1
        i = add i 1
      end
    end
  end
  c = fclose fd
  put g_rec_n 0 tot
  put g_rec_fnv 0 h
end

fn slurp_allow idx ulong to void
  fd = open_arg idx
  tot = ulong 0
  done = false
  while not done bound 100000
    rem_cap = sub MAX_ALLOW tot
    if eq rem_cap ulong 0
      k = read fd g_iobuf ulong 0 ulong 1
      if lt k long 0
        c = fclose fd
        die1 t_err_read idx
      end
      if gt k long 0
        c = fclose fd
        die0 t_err_oom
      end
      done = true
    else
      k = read fd g_allow tot rem_cap
      if lt k long 0
        c = fclose fd
        die1 t_err_read idx
      end
      if eq k long 0
        done = true
      else
        tot = add tot ulong k
      end
    end
  end
  c = fclose fd
  put g_allow_n 0 tot
end

fn slurp_unit which ulong idx ulong to void
  fd = open_arg idx
  tot = ulong 0
  done = false
  while not done bound 100000
    k = read fd g_iobuf ulong 0 ulong 65536
    if lt k long 0
      c = fclose fd
      die1 t_err_read idx
    end
    if eq k long 0
      done = true
    else
      uk = ulong k
      if gt add tot uk MAX_UNIT
        c = fclose fd
        die0 t_err_oom
      end
      i = ulong 0
      while lt i uk bound 65536
        b = get g_iobuf i
        if eq which ulong 0
          put g_sel add tot i b
        else
          if eq which ulong 1
            put g_omx add tot i b
          else
            put g_kap add tot i b
          end
        end
        i = add i 1
      end
      tot = add tot uk
    end
  end
  c = fclose fd
  if eq which ulong 0
    put g_sel_n 0 tot
  else
    if eq which ulong 1
      put g_omx_n 0 tot
    else
      put g_kap_n 0 tot
    end
  end
end

fn le64_io off ulong to ulong
  v = ulong 0
  i = ulong 8
  while gt i ulong 0 bound 8
    i = sub i 1
    v = or shl v 8 ulong get g_iobuf add off i
  end
  ret v
end

fn le64_rec off ulong to ulong
  v = ulong 0
  i = ulong 8
  while gt i ulong 0 bound 8
    i = sub i 1
    v = or shl v 8 ulong get g_rec add off i
  end
  ret v
end

fn le64_img off ulong to ulong
  v = ulong 0
  i = ulong 8
  while gt i ulong 0 bound 8
    i = sub i 1
    v = or shl v 8 ulong get g_img add off i
  end
  ret v
end

note ---- Integer math helpers ----

fn fl2 v ulong to ulong
  e = ulong 0
  x = v
  while gt x ulong 1 bound 64
    x = shr x 1
    e = add e 1
  end
  ret e
end

fn lg16 v ulong to ulong
  if eq v ulong 0
    ret ulong 0
  end
  e = fl2 v
  ret sub add shr shl v 4 e mul ulong 16 e ulong 16
end

fn ceil_log2 v ulong to ulong
  k = ulong 0
  while lt k ulong 64 bound 64
    if ge shl ulong 1 k v
      break
    end
    k = add k 1
  end
  ret k
end

fn gamma_len v ulong to ulong
  ret add mul ulong 2 fl2 v ulong 1
end

fn binom4 n ulong to ulong
  c = ulong 1
  i = ulong 1
  while le i ulong 4 bound 4
    c = div mul c add n i i
    i = add i 1
  end
  ret c
end

fn row_len n ulong to ulong
  ret add gamma_len add n 1 ceil_log2 binom4 n
end

fn sq_shr62 m ulong to ulong
  lo = and m ulong 0xffffffff
  hi = shr m 32
  p0 = mul lo lo
  p1 = mul hi lo
  p2 = mul hi hi
  mid_lo = shl p1 33
  mid_hi = shr p1 31
  p_lo = add p0 mid_lo
  carry = ulong 0
  if lt p_lo p0
    carry = ulong 1
  end
  p_hi = add add p2 mid_hi carry
  ret or shl p_hi 2 shr p_lo 62
end

fn ub_q q ulong to ulong
  ip = fl2 q
  m = shl q sub ulong 62 ip
  frac = ulong 0
  i = ulong 1
  while le i ulong 32 bound 32
    m = sq_shr62 m
    if ge m ulong 0x8000000000000000
      frac = or frac shl ulong 1 sub ulong 32 i
      m = shr m 1
    end
    i = add i 1
  end
  lg = or shl ip 32 frac
  x = sub ulong 0x1000000000 lg
  ret shr add mul x ulong 1000000 ulong 0x80000000 32
end

fn splitmix64 to ulong
  s = add get g_sm 0 ulong 0x9e3779b97f4a7c15
  put g_sm 0 s
  z = mul xor s shr s 30 ulong 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 ulong 0x94d049bb133111eb
  ret xor z shr z 31
end

note ---- V1 reader ----

fn add_v1_rec recbuf view uchar 256 nv ulong to void
  m = ulong 0
  n = ulong 0
  j = ulong 8
  while gt j ulong 0 bound 8
    j = sub j 1
    m = or shl m 8 ulong get recbuf add ulong 40 j
    n = or shl n 8 ulong get recbuf add ulong 48 j
  end
  put g_v1_m nv m
  put g_v1_n nv n
  put g_v1cell add mul ulong 16 fl2 m fl2 n uchar 1
end

fn slurp_v1 idx ulong to void
  fd = open_arg idx
  recbuf = new uchar 256 0
  rpos = ulong 0
  nv = ulong 0
  done = false
  while not done bound 1000000
    k = read fd g_iobuf ulong 0 ulong 65536
    if lt k long 0
      c = fclose fd
      die1 t_err_read idx
    end
    if eq k long 0
      done = true
    else
      uk = ulong k
      i = ulong 0
      while lt i uk bound 65536
        put recbuf rpos get g_iobuf i
        rpos = add rpos 1
        if eq rpos ulong 256
          if ge nv MAX_V1
            c = fclose fd
            die0 t_err_oom
          end
          add_v1_rec recbuf nv
          nv = add nv 1
          rpos = ulong 0
        end
        i = add i 1
      end
    end
  end
  c = fclose fd
  if ne rpos ulong 0
    die1 t_err_v1 idx
  end
  put g_nv1 0 nv
end

note ---- Selftest ----

fn selftest_one q ulong exp ulong to bool
  v = ub_q q
  out_str t_st_ub1
  out_u64 q
  out_str t_st_ub2
  out_u64 v
  out_str t_st_exp
  out_u64 exp
  if eq v exp
    out_str t_st_ok
    ret false
  end
  out_str t_st_fail
  ret true
end

fn run_selftest to int
  bad = false
  if selftest_one ulong 1 ulong 16000000
    bad = true
  end
  if selftest_one ulong 32768 ulong 1000000
    bad = true
  end
  if selftest_one ulong 43481 ulong 591903
    bad = true
  end
  if selftest_one ulong 46819 ulong 485194
    bad = true
  end
  if selftest_one ulong 13107 ulong 2321950
    bad = true
  end
  if selftest_one ulong 13108 ulong 2321840
    bad = true
  end
  if selftest_one ulong 65536 ulong 0
    bad = true
  end

  put g_sm 0 SEED
  i = ulong 0
  while lt i ulong 5 bound 5
    out_str t_st_sm1
    out_u64 i
    out_str t_st_sm2
    out_u64 splitmix64
    out_str t_nl
    i = add i 1
  end

  a = bitcast f32 uint 0x3f800001
  b = bitcast f32 uint 0x3f800001
  c = bitcast f32 uint 0xbf800002
  p = mul a b
  s = add p c
  sb = bitcast uint s
  out_str t_st_fma
  out_hex32 sb
  if eq sb uint 0
    out_str t_st_unfused
  else
    out_str t_st_fused
    bad = true
  end

  if bad
    out_str t_st_sfail
    out_flush
    ret int 1
  end
  out_str t_st_pass
  out_flush
  ret int 0
end

note ---- Admission helpers ----

fn cache_of core ulong to ulong
  if eq core ulong 0
    ret ulong 2097152
  end
  if eq core ulong 1
    ret ulong 524288
  end
  ret ulong 1048576
end

fn fmt2 base ulong to int
  if ne get g_w base ulong 3553143591248351811
    ret int -2
  end
  if ne get g_w add base 1 ulong 1
    ret int -2
  end
  if gt get g_w add base 2 ulong 5
    ret int -3
  end
  if gt get g_w add base 3 ulong 1
    ret int -3
  end
  if gt get g_w add base 4 ulong 1
    ret int -3
  end
  if ne get g_w add base 13 ulong 6
    ret int -3
  end
  m = get g_w add base 5
  n = get g_w add base 6
  if lt m ulong 1
    ret int -4
  end
  if gt m ulong 8192
    ret int -4
  end
  if lt n ulong 1
    ret int -4
  end
  if gt n ulong 8192
    ret int -4
  end
  if gt mul m n ulong 524288
    ret int -4
  end
  w7 = get g_w add base 7
  if lt w7 ulong 1
    ret int -4
  end
  if gt w7 ulong 1048576
    ret int -4
  end
  if ne get g_w add base 10 cache_of get g_w add base 3
    ret int -9
  end
  exp9 = mul add add mul m n m n ulong 8
  if ne get g_w add base 9 exp9
    ret int -9
  end
  ret int 0
end

fn val2 base ulong to int
  paired = eq get g_w add base 12 ulong 31
  a = ulong 0
  while lt a ulong 5 bound 5
    if paired
      if eq get g_w add base add ulong 16 a ulong 0
        paired = false
      end
      if ne get g_w add base add ulong 24 a ulong 1
        paired = false
      end
    end
    a = add a 1
  end
  if paired
    if ne get g_w add base 21 ulong 0
      paired = false
    end
    if ne get g_w add base 29 ulong 0
      paired = false
    end
    if ne get g_w add base 22 ulong 0
      paired = false
    end
    if ne get g_w add base 23 ulong 0
      paired = false
    end
  end
  if not paired
    ret int -14
  end
  a = ulong 0
  while lt a ulong 5 bound 5
    if ge get g_w add base add ulong 16 a ulong 0x10000000000
      ret int -10
    end
    a = add a 1
  end
  if ne get g_w add base 31 ulong 0
    ret int -7
  end
  ret int 0
end

fn hspl cm ulong cn ulong to int
  h = ulong 14695981039346656037
  h = fnv_step h uchar and cm ulong 255
  h = fnv_step h uchar and cn ulong 255
  k = rem shr h 32 ulong 10
  if le k ulong 5
    ret int 0
  end
  if le k ulong 7
    ret int 1
  end
  ret int 2
end

note ---- Allow-list check ----

fn allow_tok_eq pos ulong n ulong pat view uchar * to bool
  if ne n len pat
    ret false
  end
  i = ulong 0
  while lt i n bound 64
    if ne get g_allow add pos i get pat i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn check_allow_line h ulong p ulong e ulong to int
  q = p
  v = ulong 0
  ok = true
  while lt q e bound 262144
    ch = get g_allow q
    if lt ch uchar 48
      break
    end
    if gt ch uchar 57
      break
    end
    d = ulong sub ch uchar 48
    lim = div sub ulong 0xffffffffffffffff d ulong 10
    if gt v lim
      ok = false
    end
    v = add mul v ulong 10 d
    q = add q 1
  end
  if not ok
    ret int 0
  end
  if le q p
    ret int 0
  end
  if ne v h
    ret int 0
  end
  if lt q e
    if eq get g_allow q uchar 32
      s = add q 1
      t = s
      while lt t e bound 262144
        if eq get g_allow t uchar 32
          break
        end
        t = add t 1
      end
      tlen = sub t s
      if allow_tok_eq s tlen t_auth
        ret int 1
      end
      if allow_tok_eq s tlen t_synth
        ret int 1
      end
    end
  end
  ret int -1
end

fn check_allow h ulong to bool
  an = get g_allow_n 0
  p = ulong 0
  while lt p an bound 262144
    e = p
    while lt e an bound 262144
      if eq get g_allow e uchar 10
        break
      end
      e = add e 1
    end
    res = check_allow_line h p e
    if eq res int 1
      ret true
    end
    if eq res int -1
      ret false
    end
    if lt e an
      p = add e 1
    else
      p = e
    end
  end
  ret false
end

note ---- Image loader and MLP ----

fn load_image which ulong idx ulong to void
  fd = open_arg idx
  tot = ulong 0
  done = false
  while not done bound 10000
    rem_cap = sub ulong 11561 tot
    if eq rem_cap ulong 0
      done = true
    else
      k = read fd g_img tot rem_cap
      if lt k long 0
        c = fclose fd
        die1 t_err_read idx
      end
      if eq k long 0
        done = true
      else
        tot = add tot ulong k
      end
    end
  end
  c = fclose fd
  if ne tot IMG_BYTES
    die1 t_err_img_sz idx
  end
  i = ulong 0
  while lt i ulong 8 bound 8
    if ne get g_img i get t_magic i
      die1 t_err_img_hdr idx
    end
    i = add i 1
  end
  if ne le64_img ulong 8 ulong 1
    die1 t_err_img_hdr idx
  end
  if ne le64_img ulong 16 ulong 2
    die1 t_err_img_hdr idx
  end
  if ne le64_img ulong 24 ulong 32
    die1 t_err_img_hdr idx
  end
  if ne le64_img ulong 136 NPAR
    die1 t_err_img_hdr idx
  end
  h = ulong 14695981039346656037
  i = ulong 0
  while lt i sub IMG_BYTES ulong 8 bound 11560
    h = fnv_step h get g_img i
    i = add i 1
  end
  if ne h le64_img sub IMG_BYTES ulong 8
    die1 t_err_img_fnv idx
  end
  pbase = mul which NPAR
  k = ulong 0
  while lt k NPAR bound 705
    w = le64_img add SB_OFF mul ulong 8 k
    bits = uint and w ulong 0xffffffff
    put g_P add pbase k bitcast f32 bits
    k = add k 1
  end
end

fn mlp_hidden_unit pbase ulong h ulong z view f32 20 to f32
  acc = get g_P add pbase add ulong 640 h
  i = ulong 0
  while lt i ulong 20 bound 20
    pidx = add pbase add mul ulong 32 i h
    w = get g_P pidx
    zi = get z i
    prod = mul w zi
    acc = add acc prod
    i = add i 1
  end
  if gt acc 0.0f32
    ret acc
  end
  ret 0.0f32
end

fn mlp_key which ulong fbase ulong arm ulong to long
  z = new f32 20 0.0f32
  act = new f32 32 0.0f32
  pbase = mul which NPAR
  j = ulong 0
  while lt j ulong 12 bound 12
    put z j div f32 get g_feat add fbase j 16.0f32
    j = add j 1
  end
  j = ulong 0
  while lt j ulong 8 bound 8
    if eq j arm
      put z add ulong 12 j 1.0f32
    else
      put z add ulong 12 j 0.0f32
    end
    j = add j 1
  end
  h = ulong 0
  while lt h ulong 32 bound 32
    put act h mlp_hidden_unit pbase h z
    h = add h 1
  end
  res = get g_P add pbase ulong 704
  h = ulong 0
  while lt h ulong 32 bound 32
    w = get g_P add pbase add ulong 672 h
    ah = get act h
    prod = mul w ah
    res = add res prod
    h = add h 1
  end
  b = bitcast uint res
  if ne and b uint 0x80000000 uint 0
    ret neg long and b uint 0x7fffffff
  end
  ret long b
end

fn order_by_keys key view long 5 obase ulong to void
  a = ulong 0
  while lt a ulong 5 bound 5
    put g_ord add obase a a
    a = add a 1
  end
  i = ulong 1
  while lt i ulong 5 bound 5
    v = get g_ord add obase i
    j = i
    while gt j ulong 0 bound 5
      prev = get g_ord add obase sub j 1
      if le get key prev get key v
        break
      end
      put g_ord add obase j prev
      j = sub j 1
    end
    put g_ord add obase j v
    i = add i 1
  end
end

note ---- Canonical unit byte counter (P2) ----

fn unit_byte which ulong pos ulong to uchar
  if eq which ulong 0
    ret get g_sel pos
  end
  if eq which ulong 1
    ret get g_omx pos
  end
  ret get g_kap pos
end

fn unit_starts which ulong pos ulong n ulong pat view uchar * to bool
  k = len pat
  if lt n k
    ret false
  end
  i = ulong 0
  while lt i k bound 128
    if ne unit_byte which add pos i get pat i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn canon which ulong lo ulong hi ulong to ulong
  c = ulong 0
  p = lo
  while lt p hi bound 524288
    e = p
    while lt e hi bound 524288
      if eq unit_byte which e uchar 10
        break
      end
      e = add e 1
    end
    ll = sub e p
    if gt ll ulong 0
      if not unit_starts which p ll t_note
        c = add c ll
        if lt e hi
          c = add c 1
        end
      end
    end
    if lt e hi
      p = add e 1
    else
      p = e
    end
  end
  ret c
end

fn omx_matches_fn pos ulong n ulong name view uchar * to bool
  if not unit_starts ulong 1 pos n t_fn_pre
    ret false
  end
  nl = len name
  if lt n add add ulong 3 nl ulong 1
    ret false
  end
  i = ulong 0
  while lt i nl bound 64
    if ne get g_omx add pos add ulong 3 i get name i
      ret false
    end
    i = add i 1
  end
  if ne get g_omx add pos add ulong 3 nl uchar 32
    ret false
  end
  ret true
end

fn canon_fn name view uchar * path_idx ulong to ulong
  tn = get g_omx_n 0
  p = ulong 0
  found = false
  lo = ulong 0
  while lt p tn bound 524288
    e = p
    while lt e tn bound 524288
      if eq get g_omx e uchar 10
        break
      end
      e = add e 1
    end
    ll = sub e p
    if not found
      if omx_matches_fn p ll name
        lo = p
        found = true
      end
    else
      if unit_starts ulong 1 p ll t_fn_pre
        ret canon ulong 1 lo p
      end
      if unit_starts ulong 1 p ll t_glob_pre
        ret canon ulong 1 lo p
      end
    end
    if lt e tn
      p = add e 1
    else
      p = e
    end
  end
  if not found
    err_str t_err_fn1
    err_str name
    err_str t_err_fn2
    err_arg path_idx
    err_str t_nl
    exit int 1
  end
  ret canon ulong 1 lo tn
end

note ---- Heapsort for REPS=10000 long values ----

fn sift_down_rep base ulong start ulong end_n ulong to void
  root = start
  while true bound 32
    child = add mul root ulong 2 ulong 1
    if ge child end_n
      break
    end
    sw = root
    if lt get g_rep add base sw get g_rep add base child
      sw = child
    end
    right = add child 1
    if lt right end_n
      if lt get g_rep add base sw get g_rep add base right
        sw = right
      end
    end
    if eq sw root
      break
    end
    tmp = get g_rep add base root
    put g_rep add base root get g_rep add base sw
    put g_rep add base sw tmp
    root = sw
  end
end

fn sort_rep base ulong to void
  i = div REPS ulong 2
  while gt i ulong 0 bound 5000
    i = sub i 1
    sift_down_rep base i REPS
  end
  end_n = REPS
  while gt end_n ulong 1 bound 10000
    end_n = sub end_n 1
    tmp = get g_rep add base end_n
    put g_rep add base end_n get g_rep base
    put g_rep base tmp
    sift_down_rep base ulong 0 end_n
  end
end

fn sift_down_rep2 base ulong start ulong end_n ulong to void
  root = start
  while true bound 32
    child = add mul root ulong 2 ulong 1
    if ge child end_n
      break
    end
    sw = root
    if lt get g_rep2 add base sw get g_rep2 add base child
      sw = child
    end
    right = add child 1
    if lt right end_n
      if lt get g_rep2 add base sw get g_rep2 add base right
        sw = right
      end
    end
    if eq sw root
      break
    end
    tmp = get g_rep2 add base root
    put g_rep2 add base root get g_rep2 add base sw
    put g_rep2 add base sw tmp
    root = sw
  end
end

fn sort_rep2 base ulong to void
  i = div REPS ulong 2
  while gt i ulong 0 bound 5000
    i = sub i 1
    sift_down_rep2 base i REPS
  end
  end_n = REPS
  while gt end_n ulong 1 bound 10000
    end_n = sub end_n 1
    tmp = get g_rep2 add base end_n
    put g_rep2 add base end_n get g_rep2 base
    put g_rep2 base tmp
    sift_down_rep2 base ulong 0 end_n
  end
end

note ---- Admission, features, orders, F1, code lengths ----

fn run_admission to bool
  nr = get g_nr 0
  r = ulong 0
  while lt r nr bound 2048
    base = mul r ulong 32
    i = ulong 0
    while lt i ulong 32 bound 32
      put g_w add base i le64_rec add mul ulong 256 r mul ulong 8 i
      i = add i 1
    end
    r = add r 1
  end

  r = ulong 0
  while lt r nr bound 2048
    base = mul r ulong 32
    c = fmt2 base
    if eq c int 0
      c = val2 base
    end
    if eq c int 0
      if gt r ulong 0
        pbase = mul sub r 1 ulong 32
        if ge get g_w add pbase 14 get g_w add base 14
          c = int -8
        end
      end
    end
    if eq c int 0
      q = ulong 0
      while lt q r bound 2048
        if eq get g_code q int 0
          qbase = mul q ulong 32
          if eq get g_w add qbase 3 get g_w add base 3
            if eq get g_w add qbase 4 get g_w add base 4
              if eq get g_w add qbase 5 get g_w add base 5
                if eq get g_w add qbase 6 get g_w add base 6
                  c = int -15
                  break
                end
              end
            end
          end
        end
        q = add q 1
      end
    end
    put g_code r c
    put g_split r int 3
    if eq c int 0
      fm = fl2 get g_w add base 5
      fn_v = fl2 get g_w add base 6
      put g_cell r add mul ulong 16 fm fn_v
      sp = hspl fm fn_v
      put g_split r sp
      usp = ulong sp
      put g_nsplit usp add get g_nsplit usp 1
      put g_nadm 0 add get g_nadm 0 1
    end
    r = add r 1
  end

  r = ulong 0
  while lt r nr bound 2048
    if eq get g_code r int 0
      rcell = get g_cell r
      rsp = get g_split r
      rbase = mul r ulong 32
      rm = get g_w add rbase 5
      rn = get g_w add rbase 6
      q = ulong 0
      while lt q r bound 2048
        if eq get g_code q int 0
          if ne get g_split q rsp
            if eq get g_cell q rcell
              ret false
            end
            qbase = mul q ulong 32
            if eq get g_w add qbase 5 rm
              if eq get g_w add qbase 6 rn
                ret false
              end
            end
          end
        end
        q = add q 1
      end
    end
    r = add r 1
  end
  ret true
end

fn compute_feat_a r ulong to void
  wbase = mul r ulong 32
  fbase = mul r ulong 12
  w5 = get g_w add wbase 5
  w6 = get g_w add wbase 6
  lm = lg16 w5
  ln = lg16 w6
  put g_feat fbase long 16
  put g_feat add fbase 1 long lm
  put g_feat add fbase 2 long ln
  put g_feat add fbase 3 long shr mul lm ln 8
  put g_feat add fbase 4 long shr mul ln ln 8
  if le w6 ulong 3
    put g_feat add fbase 5 long 16
  else
    put g_feat add fbase 5 long 0
  end
  if ne rem w6 ulong 4 ulong 0
    put g_feat add fbase 6 long 16
  else
    put g_feat add fbase 6 long 0
  end
end

fn compute_feat_b r ulong to void
  wbase = mul r ulong 32
  fbase = mul r ulong 12
  l9 = long lg16 get g_w add wbase 9
  l10 = long lg16 get g_w add wbase 10
  d = sub l9 l10
  if lt d long 0
    d = long 0
  else
    if gt d long 256
      d = long 256
    end
  end
  put g_feat add fbase 7 d
  w3 = get g_w add wbase 3
  if eq w3 ulong 0
    put g_feat add fbase 8 long 16
  else
    put g_feat add fbase 8 long 0
  end
  if eq w3 ulong 1
    put g_feat add fbase 9 long 16
  else
    put g_feat add fbase 9 long 0
  end
  if eq w3 ulong 2
    put g_feat add fbase 10 long 16
  else
    put g_feat add fbase 10 long 0
  end
  w4 = get g_w add wbase 4
  if lt w4 ulong 15
    put g_feat add fbase 11 mul long 16 long w4
  else
    put g_feat add fbase 11 long 240
  end
end

fn compute_oracle_rec r ulong to void
  wbase = mul r ulong 32
  b = ulong 0
  a = ulong 1
  while lt a ulong 5 bound 5
    va = get g_w add wbase add ulong 16 a
    vb = get g_w add wbase add ulong 16 b
    if lt va vb
      b = a
    end
    a = add a 1
  end
  put g_oracle r b
end

fn compute_sord_core c ulong to void
  tot = new ulong 5 0
  nr = get g_nr 0
  r = ulong 0
  while lt r nr bound 2048
    if eq get g_code r int 0
      if eq get g_split r int 0
        wbase = mul r ulong 32
        if eq get g_w add wbase 3 c
          a = ulong 0
          while lt a ulong 5 bound 5
            cur = get tot a
            wv = get g_w add wbase add ulong 16 a
            put tot a add cur wv
            a = add a 1
          end
        end
      end
    end
    r = add r 1
  end
  sbase = mul c ulong 5
  a = ulong 0
  while lt a ulong 5 bound 5
    put g_sord add sbase a a
    a = add a 1
  end
  i = ulong 1
  while lt i ulong 5 bound 5
    v = get g_sord add sbase i
    j = i
    while gt j ulong 0 bound 5
      prev = get g_sord add sbase sub j 1
      if le get tot prev get tot v
        break
      end
      put g_sord add sbase j prev
      j = sub j 1
    end
    put g_sord add sbase j v
    i = add i 1
  end
end

fn compute_features_and_sord to void
  nr = get g_nr 0
  r = ulong 0
  while lt r nr bound 2048
    if eq get g_code r int 0
      compute_feat_a r
      compute_feat_b r
      compute_oracle_rec r
    end
    r = add r 1
  end
  compute_sord_core ulong 0
  compute_sord_core ulong 1
end

fn set_ident obase ulong to void
  a = ulong 0
  while lt a ulong 5 bound 5
    put g_ord add obase a a
    a = add a 1
  end
end

fn train_dist q ulong lm long ln long to long
  qbase = mul q ulong 32
  dm = sub long lg16 get g_w add qbase 5 lm
  dn = sub long lg16 get g_w add qbase 6 ln
  if lt dm long 0
    dm = neg dm
  end
  if lt dn long 0
    dn = neg dn
  end
  ret add dm dn
end

fn find_nearest_train r ulong to long
  wbase = mul r ulong 32
  w3 = get g_w add wbase 3
  w4 = get g_w add wbase 4
  lm = long lg16 get g_w add wbase 5
  ln = long lg16 get g_w add wbase 6
  best = long -1
  bd = long 0
  nr = get g_nr 0
  q = ulong 0
  while lt q nr bound 2048
    if eq get g_code q int 0
      if eq get g_split q int 0
        qbase = mul q ulong 32
        if eq get g_w add qbase 3 w3
          if eq get g_w add qbase 4 w4
            dd = train_dist q lm ln
            if lt best long 0
              best = long q
              bd = dd
            else
              if lt dd bd
                best = long q
                bd = dd
              end
            end
          end
        end
      end
    end
    q = add q 1
  end
  ret best
end

fn compute_order_r r ulong to void
  key = new long 5 0
  best = find_nearest_train r
  xrbase = add mul r ulong 50 mul XR ulong 5
  if lt best long 0
    set_ident xrbase
  else
    bbase = mul ulong best ulong 32
    a = ulong 0
    while lt a ulong 5 bound 5
      put key a long get g_w add bbase add ulong 16 a
      a = add a 1
    end
    order_by_keys key xrbase
  end
end

fn compute_orders_base r ulong to void
  wbase = mul r ulong 32
  rord = mul r ulong 50
  set_ident add rord mul XU ulong 5
  set_ident add rord mul XO0 ulong 5
  set_ident add rord mul XA ulong 5

  if true
    w6 = get g_w add wbase 6
    ra = ulong 3
    if le w6 ulong 8
      ra = ulong 2
    end
    frbase = add rord mul XFR ulong 5
    put g_ord frbase ra
    k = ulong 1
    a = ulong 0
    while lt a ulong 5 bound 5
      if ne a ra
        put g_ord add frbase k a
        k = add k 1
      end
      a = add a 1
    end
  end

  if true
    sbase = mul get g_w add wbase 3 ulong 5
    xsbase = add rord mul XS ulong 5
    a = ulong 0
    while lt a ulong 5 bound 5
      sv = get g_sord add sbase a
      put g_ord add xsbase a sv
      a = add a 1
    end
  end
end

fn compute_orders_mlp r ulong to void
  key = new long 5 0
  fbase = mul r ulong 12
  rord = mul r ulong 50
  im = ulong 0
  while lt im ulong 3 bound 3
    a = ulong 0
    while lt a ulong 5 bound 5
      put key a mlp_key im fbase a
      a = add a 1
    end
    tx = XCUN
    if eq im ulong 0
      tx = XM1
    else
      if eq im ulong 1
        tx = XCSH
      end
    end
    order_by_keys key add rord mul tx ulong 5
    im = add im 1
  end

  m1base = add rord mul XM1 ulong 5
  m2base = add rord mul XM2 ulong 5
  a = ulong 0
  while lt a ulong 5 bound 5
    put g_ord add m2base a get g_ord add m1base a
    a = add a 1
  end
end

fn compute_orders_rec r ulong to void
  compute_orders_base r
  compute_order_r r
  compute_orders_mlp r

  wbase = mul r ulong 32
  rord = mul r ulong 50
  w3 = get g_w add wbase 3
  w6 = get g_w add wbase 6
  kap = mul ulong 2 w3
  if le w6 ulong 8
    kap = add kap 1
  end
  x = ulong 0
  while lt x NX bound 10
    ctx_v = ulong 0
    if eq x XM2
      ctx_v = kap
    end
    if eq x XA
      ctx_v = kap
    end
    put g_ctx add mul r NX x ctx_v
    xbase = add rord mul x ulong 5
    i = ulong 0
    while lt i ulong 5 bound 5
      arm_v = get g_ord add xbase i
      put g_rank add xbase arm_v i
      i = add i 1
    end
    x = add x 1
  end
end

fn compute_codes to void
  ntrain = get g_nsplit 0
  mlpw = ulong 22592
  put g_P1 XU ulong 0
  put g_P1 XO0 get g_rows_len XO0
  put g_P1 XFR add ulong 20 get g_rows_len XFR
  put g_P1 XS add ulong 14 get g_rows_len XS
  put g_P1 XR add add ulong 12 mul ulong 26 ntrain get g_rows_len XR
  put g_P1 XM1 add mlpw get g_rows_len XM1
  put g_P1 XCSH add mlpw get g_rows_len XCSH
  put g_P1 XCUN add mlpw get g_rows_len XCUN
  put g_P1 XM2 add add mlpw ulong 21 get g_rows_len XM2
  put g_P1 XA add ulong 21 get g_rows_len XA

  if true
    b_sel = canon ulong 0 ulong 0 get g_sel_n 0
    b_kap = canon ulong 2 ulong 0 get g_kap_n 0
    b_rule = canon_fn t_fn_oxrule ulong 8
    b_stat = canon_fn t_fn_oxstatic ulong 8
    b_near = add add canon_fn t_fn_oxnearok ulong 8 canon_fn t_fn_oxl1 ulong 8 canon_fn t_fn_oxnear ulong 8

    put g_ubytes XFR b_rule
    put g_ubytes XS b_stat
    put g_ubytes XR b_near
    put g_ubytes XM1 b_sel
    put g_ubytes XCSH b_sel
    put g_ubytes XCUN b_sel
    put g_ubytes XM2 add b_sel b_kap
    put g_ubytes XA b_kap
  end

  x = ulong 0
  while lt x NX bound 10
    p1v = get g_P1 x
    ubv = get g_ubytes x
    put g_P2 x add p1v mul ulong 8 ubv
    x = add x 1
  end
end

fn tally_f1_rec r ulong to void
  ora = get g_oracle r
  r50 = mul r ulong 50
  r10 = mul r NX
  x = ulong 0
  while lt x NX bound 10
    cv = get g_ctx add r10 x
    rk_idx = add add r50 mul x ulong 5 ora
    rk = get g_rank rk_idx
    xc = add mul x ulong 4 cv
    idx = add mul xc ulong 5 rk
    put g_cnt idx add get g_cnt idx 1
    x = add x 1
  end
end

fn compute_f1_counts to void
  nr = get g_nr 0
  r = ulong 0
  while lt r nr bound 2048
    if eq get g_code r int 0
      if eq get g_split r int 1
        wbase = mul r ulong 32
        if eq get g_w add wbase 4 ulong 0
          if le get g_w add wbase 3 ulong 1
            tally_f1_rec r
          end
        end
      end
    end
    r = add r 1
  end
end

fn compute_f1_q_cell base ulong to void
  nv = ulong 0
  i = ulong 0
  while lt i ulong 5 bound 5
    nv = add nv get g_cnt add base i
    i = add i 1
  end
  sumv = ulong 0
  bigi = ulong 0
  den = add mul ulong 2 nv ulong 5
  i = ulong 0
  while lt i ulong 5 bound 5
    ci = get g_cnt add base i
    num = mul ulong 65531 add mul ulong 2 ci ulong 1
    qv = add ulong 1 div num den
    put g_Q add base i qv
    sumv = add sumv qv
    if gt ci get g_cnt add base bigi
      bigi = i
    end
    i = add i 1
  end
  remq = sub ulong 65536 sumv
  qbig = get g_Q add base bigi
  put g_Q add base bigi add qbig remq
end

fn compute_f1_q to void
  x = ulong 0
  while lt x NX bound 10
    c = ulong 0
    while lt c ulong 4 bound 4
      base = mul add mul x ulong 4 c ulong 5
      if eq x XU
        put g_Q base ulong 13108
        i = ulong 1
        while lt i ulong 5 bound 5
          put g_Q add base i ulong 13107
          i = add i 1
        end
      else
        compute_f1_q_cell base
      end
      c = add c 1
    end
    x = add x 1
  end
end

fn compute_f1_rows to void
  x = ulong 0
  while lt x NX bound 10
    nc = ulong 1
    if eq x XM2
      nc = ulong 4
    end
    if eq x XA
      nc = ulong 4
    end
    put g_nctx x nc
    rl = ulong 0
    c = ulong 0
    while lt c nc bound 4
      base = mul add mul x ulong 4 c ulong 5
      nv = ulong 0
      i = ulong 0
      while lt i ulong 5 bound 5
        nv = add nv get g_cnt add base i
        i = add i 1
      end
      rl = add rl row_len nv
      c = add c 1
    end
    put g_rows_len x rl
    x = add x 1
  end
end

fn compute_f1_and_codes to void
  compute_f1_counts
  compute_f1_q
  compute_f1_rows
  compute_codes
end

note ---- D, burned, families, P1R, UBX, blocks ----

fn is_in_v1 w5 ulong w6 ulong to bool
  nv1 = get g_nv1 0
  i = ulong 0
  while lt i nv1 bound 65536
    if eq get g_v1_m i w5
      if eq get g_v1_n i w6
        ret true
      end
    end
    i = add i 1
  end
  ret false
end

fn compute_ubx_rec r ulong to void
  ora = get g_oracle r
  r50 = mul r ulong 50
  r10 = mul r NX
  x = ulong 0
  while lt x NX bound 10
    cv = get g_ctx add r10 x
    rk_idx = add add r50 mul x ulong 5 ora
    rk = get g_rank rk_idx
    xc = add mul x ulong 4 cv
    qidx = add mul xc ulong 5 rk
    put g_ubx add r10 x ub_q get g_Q qidx
    x = add x 1
  end
end

fn compute_d_and_blocks to void
  nr = get g_nr 0
  r = ulong 0
  while lt r nr bound 2048
    if eq get g_code r int 0
      if eq get g_split r int 2
        wbase = mul r ulong 32
        w3 = get g_w add wbase 3
        w4 = get g_w add wbase 4
        if le w3 ulong 1
          if le w4 ulong 1
            inv1 = is_in_v1 get g_w add wbase 5 get g_w add wbase 6
            if eq w4 ulong 0
              if inv1
                put g_burned 0 add get g_burned 0 1
              else
                nd = get g_nD 0
                put g_D nd r
                put g_nD 0 add nd 1
                if ne get g_v1cell get g_cell r uchar 0
                  put g_nfam 0 add get g_nfam 0 1
                else
                  put g_nfresh 0 add get g_nfresh 0 1
                end
              end
            else
              if not inv1
                np = get g_nPR 0
                put g_PR np r
                put g_nPR 0 add np 1
              end
            end
          end
        end
      end
    end
    r = add r 1
  end

  r = ulong 0
  while lt r nr bound 2048
    if eq get g_code r int 0
      compute_ubx_rec r
    end
    r = add r 1
  end

  nd = get g_nD 0
  i = ulong 0
  while lt i nd bound 2048
    r = get g_D i
    is_fam = ne get g_v1cell get g_cell r uchar 0
    x = ulong 0
    while lt x NX bound 10
      u = get g_ubx add mul r NX x
      put g_sumD x add get g_sumD x u
      if is_fam
        put g_sumV x add get g_sumV x u
      else
        put g_sumF x add get g_sumF x u
      end
      x = add x 1
    end
    i = add i 1
  end

  compute_blocks
end

fn accum_block_pair r10 ulong b1 ulong b2 ulong to void
  x = ulong 0
  while lt x NX bound 10
    u = long get g_ubx add r10 x
    p1 = add b1 x
    put g_bs1 p1 add get g_bs1 p1 u
    p2 = add b2 x
    put g_bs2 p2 add get g_bs2 p2 u
    x = add x 1
  end
end

fn accum_block_rec i ulong to void
  r = get g_D i
  cl = get g_cell r
  co = get g_w add mul r ulong 32 3
  b1 = mul ulong get g_blk1 cl NX
  b2 = mul ulong get g_blk2 add mul ulong 2 cl co NX
  accum_block_pair mul r NX b1 b2
end

fn compute_blocks to void
  np = get g_nPR 0
  i = ulong 0
  while lt i np bound 2048
    r = get g_PR i
    r10 = mul r NX
    x = ulong 0
    while lt x NX bound 10
      u = get g_ubx add r10 x
      put g_sumP x add get g_sumP x u
      x = add x 1
    end
    i = add i 1
  end

  i = ulong 0
  while lt i ulong 512 bound 512
    put g_blk1 i int -1
    put g_blk2 i int -1
    i = add i 1
  end

  nd = get g_nD 0
  i = ulong 0
  while lt i nd bound 2048
    r = get g_D i
    cl = get g_cell r
    co = get g_w add mul r ulong 32 3
    put g_blk1 cl int 0
    put g_blk2 add mul ulong 2 cl co int 0
    i = add i 1
  end

  f1 = ulong 0
  f2 = ulong 0
  i = ulong 0
  while lt i ulong 512 bound 512
    if eq get g_blk1 i int 0
      put g_blk1 i int f1
      f1 = add f1 1
    end
    if eq get g_blk2 i int 0
      put g_blk2 i int f2
      f2 = add f2 1
    end
    i = add i 1
  end
  put g_F 0 f1
  put g_F2 0 f2

  i = ulong 0
  while lt i nd bound 2048
    accum_block_rec i
    i = add i 1
  end
end

note ---- Statistics and bootstrap ----

fn tm_at m ulong to ulong
  if eq m ulong 0
    ret XM1
  end
  if eq m ulong 1
    ret XM2
  end
  if eq m ulong 2
    ret XA
  end
  if eq m ulong 3
    ret XR
  end
  if eq m ulong 4
    ret XCSH
  end
  ret XCUN
end

fn ty_at y ulong to ulong
  if eq y ulong 0
    ret XFR
  end
  if eq y ulong 1
    ret XU
  end
  if eq y ulong 2
    ret XO0
  end
  ret XS
end

fn cm_at m ulong to ulong
  if eq m ulong 0
    ret XM1
  end
  if eq m ulong 1
    ret XM2
  end
  ret XA
end

fn tstat_v sy long sm long pm ulong py ulong to long
  ret sub sub sy sm mul long 1000000 sub long pm long py
end

fn boot1_store_rep i ulong S view long 10 to void
  m = ulong 0
  while lt m ulong 6 bound 6
    tm = tm_at m
    y = ulong 0
    while lt y ulong 4 bound 4
      ty = ty_at y
      st_idx = add mul m ulong 4 y
      val = tstat_v get S ty get S tm get g_P1 tm get g_P1 ty
      ridx = add mul st_idx REPS i
      put g_rep ridx val
      y = add y 1
    end
    m = add m 1
  end
  put g_rep add mul IDL1 REPS i sub get S XCSH get S XM1
  put g_rep add mul IDL2 REPS i sub get S XCUN get S XM1
  put g_rep add mul IDEL REPS i tstat_v get S XM1 get S XM2 get g_P1 XM2 get g_P1 XM1
end

fn run_boot1 to void
  S = new long 10 0
  f1 = get g_F 0
  put g_sm 0 SEED
  i = ulong 0
  while lt i REPS bound 10000
    x = ulong 0
    while lt x NX bound 10
      put S x long 0
      x = add x 1
    end
    k = ulong 0
    while lt k f1 bound 512
      j = rem splitmix64 f1
      jbase = mul j NX
      x = ulong 0
      while lt x NX bound 10
        sv = get S x
        bv = get g_bs1 add jbase x
        put S x add sv bv
        x = add x 1
      end
      k = add k 1
    end
    boot1_store_rep i S
    i = add i 1
  end
end

fn boot2_store_rep i ulong S view long 10 to void
  m = ulong 0
  while lt m ulong 3 bound 3
    cm = cm_at m
    val = tstat_v get S XFR get S cm get g_P1 cm get g_P1 XFR
    put g_rep2 add mul m REPS i val
    m = add m 1
  end
end

fn run_boot2 to void
  S = new long 10 0
  f2 = get g_F2 0
  put g_sm 0 SEED
  i = ulong 0
  while lt i REPS bound 10000
    x = ulong 0
    while lt x NX bound 10
      put S x long 0
      x = add x 1
    end
    k = ulong 0
    while lt k f2 bound 512
      j = rem splitmix64 f2
      jbase = mul j NX
      x = ulong 0
      while lt x NX bound 10
        sv = get S x
        bv = get g_bs2 add jbase x
        put S x add sv bv
        x = add x 1
      end
      k = add k 1
    end
    boot2_store_rep i S
    i = add i 1
  end
end

fn run_verdicts to void
  f1 = get g_F 0
  nd = get g_nD 0
  m = ulong 0
  while lt m ulong 3 bound 3
    cm = cm_at m
    nm = div sub add mul get g_P1 cm ulong 1000000 ulong 2321950 ulong 1 ulong 2321950
    put g_nmin m nm
    t0 = mul m ulong 4
    vcode = ulong 4
    under = false
    if lt f1 ulong 20
      under = true
    end
    if lt nd ulong 100
      under = true
    end
    if under
      vcode = ulong 0
    else
      qual = true
      if le get g_st_tot t0 long 0
        qual = false
      end
      if le get g_st_lb t0 long 0
        qual = false
      end
      if le get g_st_lb add t0 1 long 0
        qual = false
      end
      if le get g_st_lb add t0 2 long 0
        qual = false
      end
      if le get g_st_lb add t0 3 long 0
        qual = false
      end
      if ne cm XA
        if le get g_st_lb IDL1 long 0
          qual = false
        end
        if le get g_st_lb IDL2 long 0
          qual = false
        end
      end
      if qual
        vcode = ulong 1
      else
        if le get g_st_ub t0 long 0
          if lt nd nm
            vcode = ulong 2
          else
            vcode = ulong 3
          end
        else
          vcode = ulong 4
        end
      end
    end
    put g_verd m vcode
    m = add m 1
  end
end

fn tstat_sumd tm ulong ty ulong to long
  sy = long get g_sumD ty
  sm = long get g_sumD tm
  pm = get g_P1 tm
  py = get g_P1 ty
  ret tstat_v sy sm pm py
end

fn run_bootstrap_and_verdicts to void
  m = ulong 0
  while lt m ulong 6 bound 6
    tm = tm_at m
    y = ulong 0
    while lt y ulong 4 bound 4
      ty = ty_at y
      tidx = add mul m ulong 4 y
      put g_tot tidx tstat_sumd tm ty
      y = add y 1
    end
    m = add m 1
  end
  put g_tot IDL1 sub long get g_sumD XCSH long get g_sumD XM1
  put g_tot IDL2 sub long get g_sumD XCUN long get g_sumD XM1
  put g_tot IDEL tstat_sumd XM2 XM1

  m = ulong 0
  while lt m ulong 3 bound 3
    cm = cm_at m
    put g_tot2 m tstat_sumd cm XFR
    m = add m 1
  end

  run_boot1
  run_boot2

  s = ulong 0
  while lt s NST bound 27
    base = mul s REPS
    sort_rep base
    put g_st_tot s get g_tot s
    put g_st_lb s get g_rep add base LB_IDX
    put g_st_ub s get g_rep add base UB_IDX
    s = add s 1
  end
  m = ulong 0
  while lt m ulong 3 bound 3
    base = mul m REPS
    sort_rep2 base
    idx = add NST m
    put g_st_tot idx get g_tot2 m
    put g_st_lb idx get g_rep2 add base LB_IDX
    put g_st_ub idx get g_rep2 add base UB_IDX
    m = add m 1
  end

  run_verdicts
end

note ---- Report printing ----

fn pstat_tail idx ulong to void
  out_str t_tot
  out_i64 get g_st_tot idx
  out_str t_lb
  out_i64 get g_st_lb idx
  out_str t_ub
  out_i64 get g_st_ub idx
  out_str t_nl
end

fn print_report to void
  out_str t_hdr
  out_str t_admit1
  out_u64 get g_nr 0
  out_str t_admit2
  out_u64 get g_nadm 0
  out_str t_admit3
  out_u64 get g_nsplit 0
  out_str t_admit4
  out_u64 get g_nsplit 1
  out_str t_admit5
  out_u64 get g_nsplit 2
  out_str t_nl

  out_str t_d1
  out_u64 get g_nD 0
  out_str t_d2
  out_u64 get g_burned 0
  out_str t_d3
  out_u64 get g_F 0
  out_str t_d4
  out_u64 get g_nfresh 0
  out_str t_d5
  out_u64 get g_nfam 0
  out_str t_d6
  out_u64 get g_nPR 0
  out_str t_nl

  x = ulong 0
  while lt x NX bound 10
    out_str t_arm
    out_xname x
    out_str t_p1
    out_u64 get g_P1 x
    out_str t_p2
    out_u64 get g_P2 x
    out_str t_dl
    out_u64 get g_sumD x
    out_str t_d4
    out_u64 get g_sumF x
    out_str t_d5
    out_u64 get g_sumV x
    out_str t_d6
    out_u64 get g_sumP x
    out_str t_rows
    if eq x XU
      out_str t_dash
    else
      nc = get g_nctx x
      c = ulong 0
      while lt c nc bound 4
        if gt c ulong 0
          out_str t_semi
        end
        base = mul add mul x ulong 4 c ulong 5
        out_u64 get g_cnt base
        out_str t_comma
        out_u64 get g_cnt add base 1
        out_str t_comma
        out_u64 get g_cnt add base 2
        out_str t_comma
        out_u64 get g_cnt add base 3
        out_str t_comma
        out_u64 get g_cnt add base 4
        c = add c 1
      end
      out_str t_nl
    end
    x = add x 1
  end

  m = ulong 0
  while lt m ulong 6 bound 6
    tm = tm_at m
    y = ulong 0
    while lt y ulong 4 bound 4
      ty = ty_at y
      out_str t_t_pre
      out_xname tm
      out_str t_sp
      out_xname ty
      pstat_tail add mul m ulong 4 y
      y = add y 1
    end
    m = add m 1
  end

  out_str t_dl_csh
  pstat_tail IDL1
  out_str t_dl_cun
  pstat_tail IDL2
  out_str t_del_m2
  pstat_tail IDEL

  m = ulong 0
  while lt m ulong 3 bound 3
    out_str t_tcf_pre
    out_xname cm_at m
    out_str t_fr_suf
    pstat_tail add NST m
    m = add m 1
  end

  m = ulong 0
  while lt m ulong 3 bound 3
    out_str t_nmin_pre
    out_xname cm_at m
    out_str t_sp
    out_u64 get g_nmin m
    out_str t_nl
    m = add m 1
  end

  anyq = false
  allno = true
  m = ulong 0
  while lt m ulong 3 bound 3
    vc = get g_verd m
    if eq vc ulong 1
      anyq = true
    end
    if ne vc ulong 2
      if ne vc ulong 3
        allno = false
      end
    end
    out_str t_verd_pre
    out_xname cm_at m
    out_str t_sp
    out_verd vc
    out_str t_nl
    m = add m 1
  end

  out_str t_exp_pre
  if anyq
    out_str t_v_uniso
  else
    if allno
      out_str t_v_no
    else
      out_str t_v_inc
    end
  end
  out_str t_nl
  out_flush
end

note ---- Entry point ----

fn main to int
  ac = argcnt
  if eq ac long 2
    if arg_eq ulong 1 t_selftest
      ret run_selftest
    end
  end
  if eq ac long 3
    if arg_eq ulong 1 t_fnv
      h = fnv_file ulong 2
      out_u64 h
      out_str t_nl
      out_flush
      ret int 0
    end
  end
  if ne ac long 10
    err_str t_usage
    ret int 1
  end

  slurp_rec ulong 1
  slurp_allow ulong 2
  slurp_v1 ulong 3
  slurp_unit ulong 0 ulong 7
  slurp_unit ulong 1 ulong 8
  slurp_unit ulong 2 ulong 9

  if not check_allow get g_rec_fnv 0
    out_str t_ref_allow
    out_flush
    ret int 2
  end

  rn = get g_rec_n 0
  bad_sz = false
  if eq rn ulong 0
    bad_sz = true
  end
  if ne rem rn ulong 256 ulong 0
    bad_sz = true
  end
  if gt rn MAX_REC_BYTES
    bad_sz = true
  end
  if bad_sz
    out_str t_ref_adm1
    out_flush
    ret int 2
  end

  put g_nr 0 div rn ulong 256
  if not run_admission
    out_str t_ref_adm11
    out_flush
    ret int 2
  end

  load_image ulong 0 ulong 4
  load_image ulong 1 ulong 5
  load_image ulong 2 ulong 6

  compute_features_and_sord
  nr = get g_nr 0
  r = ulong 0
  while lt r nr bound 2048
    if eq get g_code r int 0
      compute_orders_rec r
    end
    r = add r 1
  end

  compute_f1_and_codes
  compute_d_and_blocks
  run_bootstrap_and_verdicts
  print_report
  ret int 0
end

note SPDX-License-Identifier: Apache-2.0
note tools/pi-drive-27b/omguard.om: Pure seeded Omega (OM-1) library unit.
note 1) Incremental OM-1 line/stream syntax and register guard (X925 cores).
note 2) Unified-RAM prefix-pool index with FNV-1a 64-bit chunk hashing and LRU eviction (A725 cores).
note Library unit: no fn main. Prefix: og / OG.

const OGLINEMAX ulong 512
const OGMAXPAR ulong 6
const OGMAXLOC ulong 16
const OGSLOTS ulong 64
const OGCHUNKS ulong 16
const OGPOOLH ulong 1024
const OGPBUFMAX ulong 4096

const OGFNVOFF ulong 14695981039346656037
const OGFNVPRM ulong 1099511628211

const OGOK long 0
const OGEHEX long -1
const OGEPAR long -2
const OGELOC long -3
const OGEBND long -4
const OGEEND long -5
const OGENFN long -6

note Stream guard state:
note ogst[0]=depth, ogst[1]=infn, ogst[2]=nlocs, ogst[3]=lines
global ogline uchar 512
global ogst ulong 8
global oglocs ulong 32

note Unified-RAM prefix-pool state:
note ogp_meta[0]=tick, ogp_meta[1]=best_slot, ogp_meta[2]=best_len, ogp_meta[3]=best_pa
global ogp_act ulong 64
global ogp_nch ulong 64
global ogp_hsh ulong 1024
global ogp_pa ulong 64
global ogp_lru ulong 64
global ogp_q ulong 16
global ogp_meta ulong 8
global ogp_buf uchar 4096

note --- Part 1: Incremental OM-1 Line/Stream Guard ---

fn oginit to void
i = ulong 0
while lt i 8 bound 8
put ogst i 0
i = add i 1
end
i = ulong 0
while lt i 32 bound 32
put oglocs i 0
i = add i 1
end
end

fn ogdepth to ulong
ret get ogst 0
end

fn oginfn to ulong
ret get ogst 1
end

fn ognlocs to ulong
ret get ogst 2
end

fn ogisws c uchar to ulong
if eq c 32
ret 1
end
if eq c 9
ret 1
end
if eq c 13
ret 1
end
if eq c 10
ret 1
end
ret 0
end

fn ogskipws pos ulong n ulong to ulong
p = pos
while lt p n bound 512
c = get ogline p
if eq ogisws c 0
break
end
p = add p 1
end
ret p
end

fn ogtokend pos ulong n ulong to ulong
p = pos
while lt p n bound 512
c = get ogline p
if ne ogisws c 0
break
end
p = add p 1
end
ret p
end

fn ogtrim n ulong to ulong
m = n
if gt m OGLINEMAX
m = OGLINEMAX
end
while gt m 0 bound 512
c = get ogline sub m 1
if eq c 10
m = sub m 1
else
if eq c 13
m = sub m 1
else
break
end
end
end
ret m
end

fn ogisnote s ulong e ulong to ulong
if ne sub e s 4
ret 0
end
if ne get ogline s 110
ret 0
end
if ne get ogline add s 1 111
ret 0
end
if ne get ogline add s 2 116
ret 0
end
if ne get ogline add s 3 101
ret 0
end
ret 1
end

fn ogisfn s ulong e ulong to ulong
if ne sub e s 2
ret 0
end
if ne get ogline s 102
ret 0
end
if ne get ogline add s 1 110
ret 0
end
ret 1
end

fn ogisend s ulong e ulong to ulong
if ne sub e s 3
ret 0
end
if ne get ogline s 101
ret 0
end
if ne get ogline add s 1 110
ret 0
end
if ne get ogline add s 2 100
ret 0
end
ret 1
end

fn ogisif s ulong e ulong to ulong
if ne sub e s 2
ret 0
end
if ne get ogline s 105
ret 0
end
if ne get ogline add s 1 102
ret 0
end
ret 1
end

fn ogisfor s ulong e ulong to ulong
if ne sub e s 3
ret 0
end
if ne get ogline s 102
ret 0
end
if ne get ogline add s 1 111
ret 0
end
if ne get ogline add s 2 114
ret 0
end
ret 1
end

fn ogiswhile s ulong e ulong to ulong
if ne sub e s 5
ret 0
end
if ne get ogline s 119
ret 0
end
if ne get ogline add s 1 104
ret 0
end
if ne get ogline add s 2 105
ret 0
end
if ne get ogline add s 3 108
ret 0
end
if ne get ogline add s 4 101
ret 0
end
ret 1
end

fn ogisbound s ulong e ulong to ulong
if ne sub e s 5
ret 0
end
if ne get ogline s 98
ret 0
end
if ne get ogline add s 1 111
ret 0
end
if ne get ogline add s 2 117
ret 0
end
if ne get ogline add s 3 110
ret 0
end
if ne get ogline add s 4 100
ret 0
end
ret 1
end

fn ogisto s ulong e ulong to ulong
if ne sub e s 2
ret 0
end
if ne get ogline s 116
ret 0
end
if ne get ogline add s 1 111
ret 0
end
ret 1
end

fn ogisview s ulong e ulong to ulong
if ne sub e s 4
ret 0
end
if ne get ogline s 118
ret 0
end
if ne get ogline add s 1 105
ret 0
end
if ne get ogline add s 2 101
ret 0
end
if ne get ogline add s 3 119
ret 0
end
ret 1
end

fn ogisedit s ulong e ulong to ulong
if ne sub e s 4
ret 0
end
if ne get ogline s 101
ret 0
end
if ne get ogline add s 1 100
ret 0
end
if ne get ogline add s 2 105
ret 0
end
if ne get ogline add s 3 116
ret 0
end
ret 1
end

fn ogiseq s ulong e ulong to ulong
if ne sub e s 1
ret 0
end
if ne get ogline s 61
ret 0
end
ret 1
end

fn ogisnumstar s ulong e ulong to ulong
if le e s
ret 0
end
c = get ogline s
if eq c 42
ret 1
end
if ge c 48
if le c 57
ret 1
end
end
ret 0
end

fn ogtokhash s ulong e ulong to ulong
h = OGFNVOFF
p = s
while lt p e bound 512
b = ulong get ogline p
h = xor h b
h = mul h OGFNVPRM
p = add p 1
end
ret h
end

fn ogaddloc s ulong e ulong to long
h = ogtokhash s e
cnt = get ogst 2
i = ulong 0
while lt i cnt bound 32
if eq get oglocs i h
ret OGOK
end
i = add i 1
end
if ge cnt OGMAXLOC
ret OGELOC
end
put oglocs cnt h
put ogst 2 add cnt 1
ret OGOK
end

fn ogishexsep c uchar to ulong
if ne ogisws c 0
ret 1
end
if eq c 40
ret 1
end
if eq c 45
ret 1
end
ret 0
end

note Scan line outside double-quoted strings for 0x or 0X hex prefix.
fn ogscanhex pos ulong n ulong to long
i = pos
instr = ulong 0
esc = ulong 0
while lt i n bound 512
c = get ogline i
if ne instr 0
if ne esc 0
esc = 0
else
if eq c 92
esc = 1
else
if eq c 34
instr = 0
end
end
end
else
if eq c 34
instr = 1
else
if eq c 48
if lt add i 1 n
nxt = get ogline add i 1
isx = ulong 0
if eq nxt 120
isx = 1
end
if eq nxt 88
isx = 1
end
if ne isx 0
okprev = ulong 0
if eq i pos
okprev = 1
else
prev = get ogline sub i 1
okprev = ogishexsep prev
end
if ne okprev 0
ret OGEHEX
end
end
end
end
end
end
i = add i 1
end
ret OGOK
end

fn ogparsefn pos ulong n ulong to long
if ne get ogst 1 0
ret OGENFN
end
note Skip function name token.
p = ogskipws pos n
p = ogtokend p n
put ogst 2 0
np = ulong 0
while lt p n bound 512
s = ogskipws p n
if ge s n
break
end
e = ogtokend s n
if ne ogisto s e 0
break
end
np = add np 1
if gt np OGMAXPAR
put ogst 2 0
ret OGEPAR
end
lr = ogaddloc s e
if lt lr 0
put ogst 2 0
ret lr
end
note Skip parameter type token (and array type/len if view/edit).
ts = ogskipws e n
te = ogtokend ts n
p = te
isarr = ulong 0
if ne ogisview ts te 0
isarr = 1
end
if ne ogisedit ts te 0
isarr = 1
end
if ne isarr 0
es = ogskipws te n
ee = ogtokend es n
p = ee
ls = ogskipws ee n
le2 = ogtokend ls n
if ne ogisnumstar ls le2 0
p = le2
end
end
end
put ogst 1 1
put ogst 0 add get ogst 0 1
ret OGOK
end

fn ogparsewhile pos ulong n ulong to long
p = pos
found = ulong 0
while lt p n bound 512
s = ogskipws p n
if ge s n
break
end
e = ogtokend s n
if ne ogisbound s e 0
ns = ogskipws e n
if lt ns n
found = 1
break
end
end
p = e
end
if eq found 0
ret OGEBND
end
put ogst 0 add get ogst 0 1
ret OGOK
end

fn ogcheckline n ulong to long
m = ogtrim n
put ogst 3 add get ogst 3 1
s0 = ogskipws 0 m
if ge s0 m
ret OGOK
end
e0 = ogtokend s0 m
if ne ogisnote s0 e0 0
ret OGOK
end
hr = ogscanhex s0 m
if lt hr 0
ret hr
end
if ne ogisfn s0 e0 0
ret ogparsefn e0 m
end
if ne ogisend s0 e0 0
d = get ogst 0
if eq d 0
ret OGEEND
end
nd = sub d 1
put ogst 0 nd
if eq nd 0
put ogst 1 0
put ogst 2 0
end
ret OGOK
end
if ne ogisif s0 e0 0
put ogst 0 add get ogst 0 1
ret OGOK
end
if ne ogisfor s0 e0 0
put ogst 0 add get ogst 0 1
if ne get ogst 1 0
vs = ogskipws e0 m
if lt vs m
ve = ogtokend vs m
ret ogaddloc vs ve
end
end
ret OGOK
end
if ne ogiswhile s0 e0 0
ret ogparsewhile e0 m
end
if ne get ogst 1 0
s1 = ogskipws e0 m
if lt s1 m
e1 = ogtokend s1 m
if ne ogiseq s1 e1 0
ret ogaddloc s0 e0
end
end
end
ret OGOK
end

note --- Part 2: Unified-RAM Prefix-Pool Index ---

fn ogpinit to void
i = ulong 0
while lt i OGSLOTS bound 64
put ogp_act i 0
put ogp_nch i 0
put ogp_pa i 0
put ogp_lru i 0
i = add i 1
end
i = ulong 0
while lt i OGPOOLH bound 1024
put ogp_hsh i 0
i = add i 1
end
i = ulong 0
while lt i OGCHUNKS bound 16
put ogp_q i 0
i = add i 1
end
i = ulong 0
while lt i 8 bound 8
put ogp_meta i 0
i = add i 1
end
end

note FNV-1a 64-bit hash over byte chunk ogp_buf[off .. off+n).
fn ogphash off ulong n ulong to ulong
if ge off OGPBUFMAX
ret OGFNVOFF
end
lim = sub OGPBUFMAX off
cnt = n
if gt cnt lim
cnt = lim
end
h = OGFNVOFF
i = ulong 0
while lt i cnt bound 4096
b = ulong get ogp_buf add off i
h = xor h b
h = mul h OGFNVPRM
i = add i 1
end
ret h
end

note Feed a 64-bit token ID (8 bytes LE) into FNV-1a 64-bit state.
fn ogphash_tok tok ulong prev ulong to ulong
h = prev
v = tok
i = ulong 0
while lt i 8 bound 8
b = and v 255
h = xor h b
h = mul h OGFNVPRM
v = shr v 8
i = add i 1
end
ret h
end

fn ogpput slot ulong nchunks ulong pa ulong to long
if ge slot OGSLOTS
ret -1
end
if gt nchunks OGCHUNKS
ret -1
end
tick = add get ogp_meta 0 1
put ogp_meta 0 tick
put ogp_act slot 1
put ogp_nch slot nchunks
put ogp_pa slot pa
put ogp_lru slot tick
base = mul slot OGCHUNKS
i = ulong 0
while lt i nchunks bound 16
put ogp_hsh add base i get ogp_q i
i = add i 1
end
ret 0
end

fn ogslotmatch slot ulong nchunks ulong to ulong
sn = get ogp_nch slot
lim = nchunks
if lt sn lim
lim = sn
end
base = mul slot OGCHUNKS
m = ulong 0
while lt m lim bound 16
if ne get ogp_hsh add base m get ogp_q m
break
end
m = add m 1
end
ret m
end

fn ogpmatch nchunks ulong to long
qlen = nchunks
if gt qlen OGCHUNKS
qlen = OGCHUNKS
end
bslot = OGSLOTS
blen = ulong 0
blru = ulong 0
s = ulong 0
while lt s OGSLOTS bound 64
if ne get ogp_act s 0
m = ogslotmatch s qlen
take = ulong 0
if gt m blen
take = 1
end
if eq m blen
if gt m 0
if gt get ogp_lru s blru
take = 1
end
end
end
if ne take 0
blen = m
bslot = s
blru = get ogp_lru s
end
end
s = add s 1
end
if eq blen 0
put ogp_meta 1 OGSLOTS
put ogp_meta 2 0
put ogp_meta 3 0
ret -1
end
tick = add get ogp_meta 0 1
put ogp_meta 0 tick
put ogp_lru bslot tick
put ogp_meta 1 bslot
put ogp_meta 2 blen
put ogp_meta 3 get ogp_pa bslot
ret long bslot
end

fn ogpmatch_len to ulong
ret get ogp_meta 2
end

fn ogpmatch_pa to ulong
ret get ogp_meta 3
end

fn ogpevict to long
found = ulong 0
vslot = ulong 0
vlru = ulong 0
s = ulong 0
while lt s OGSLOTS bound 64
if ne get ogp_act s 0
tlru = get ogp_lru s
if eq found 0
found = 1
vslot = s
vlru = tlru
else
if lt tlru vlru
vslot = s
vlru = tlru
end
end
end
s = add s 1
end
if eq found 0
ret -1
end
put ogp_act vslot 0
put ogp_nch vslot 0
put ogp_pa vslot 0
put ogp_lru vslot 0
ret long vslot
end

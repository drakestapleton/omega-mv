note pi_drive.om -- pure seeded Omega (OM-2) client running on Raspberry Pi (AArch64)
note to drive Qwen3.8-27B-FP8 on DGX Spark GB10 GPU over WireGuard (100.64.0.2:18099).
note Build natively on Pi (AArch64 Linux) with zero C / Python / curl:
note   { printf 'om2\n'; cat seed/net/http.om tools/pi-drive-27b/pi_drive.om; } | ./seed/out/omc > pi_drive
note Usage on Pi:
note   ./pi_drive                          (sends built-in Omega codegen prompt)
note   ./pi_drive < request.json           (sends custom /v1/chat/completions JSON body)

const PDIP ulong 2130706433
const PDPORT ulong 18099
const PDTMO long 180000000000
const PDMAXREQ ulong 32768
const PDMAXRSP ulong 65536

text pdget "GET"
text pdpost "POST"
text pdhost "Host"
text pdhostv "127.0.0.1:18099"
text pdctype "Content-Type"
text pdjson "application/json"
text pdphealth "/health"
text pdpchat "/v1/chat/completions"
text pdnl "\n"
text pddflt "{\"model\":\"qwen3.8-27b-fp8\",\"max_tokens\":128,\"temperature\":0,\"messages\":[{\"role\":\"user\",\"content\":\"Write a 6-line pure Omega (OM-1) function fn sq x ulong to ulong that returns x*x, with no markdown.\"}]}"

fn pddial cs edit ulong 320 io edit uchar 65536 to long
a = new uchar 16 0
r = haddr4 a uint PDIP PDPORT
if lt r 0
ret r
end
fd = hdial a PDTMO
if lt fd 0
ret fd
end
r = hinit cs io int fd 0
if lt r 0
c = fclose int fd
ret r
end
hsettmo cs PDTMO PDTMO
hsetbdl cs PDTMO
ret 0
end

fn pdreadin buf edit uchar 32768 to ulong
n = ulong 0
done = ulong 0
while and lt n PDMAXREQ eq done 0 bound 32768
r = read 0 buf n sub PDMAXREQ n
if le r 0
done = 1
else
n = add n ulong r
end
end
ret n
end

fn pdwriteall fd int buf view uchar * n ulong to long
off = ulong 0
while lt off n bound 65536
r = write fd buf off sub n off
if le r 0
ret -1
end
off = add off ulong r
end
ret 0
end

fn pdhealth to long
cs = new ulong 320 0
io = new uchar 65536 0
rsp = new uchar 4096 0
r = pddial cs io
if lt r 0
ret r
end
r = hreqst cs io pdget
r = hfe r hreqtg cs io pdphealth
r = hfe r hhname cs io pdhost
r = hfe r hhval cs io pdhostv
r = hfe r hhend cs io 0 0
r = hfe r hwfin cs io
if lt r 0
c = hclose cs
ret r
end
st = hrsprd cs io
if ne st 200
c = hclose cs
if lt st 0
ret st
end
ret sub 0 st
end
put cs 10 4096
n = hbodyall cs io rsp
c = hclose cs
if lt n 0
ret n
end
w = pdwriteall 2 rsp ulong n
w = write 2 pdnl 0 len pdnl
ret 0
end

fn pdchat req view uchar * rlen ulong to long
cs = new ulong 320 0
io = new uchar 65536 0
rsp = new uchar 65536 0
r = pddial cs io
if lt r 0
ret r
end
r = hreqst cs io pdpost
r = hfe r hreqtg cs io pdpchat
r = hfe r hhname cs io pdhost
r = hfe r hhval cs io pdhostv
r = hfe r hhname cs io pdctype
r = hfe r hhval cs io pdjson
r = hfe r hhend cs io 0 rlen
i = ulong 0
while and ge r 0 lt i rlen bound 32768
r = hputb cs io get req i
i = add i 1
end
r = hfe r hwfin cs io
if lt r 0
c = hclose cs
ret r
end
st = hrsprd cs io
if ne st 200
c = hclose cs
if lt st 0
ret st
end
ret sub 0 st
end
put cs 10 PDMAXRSP
n = hbodyall cs io rsp
c = hclose cs
if lt n 0
ret n
end
w = pdwriteall 1 rsp ulong n
w = write 1 pdnl 0 len pdnl
ret 0
end

fn main to long
r = pdhealth
if lt r 0
ret 1
end
req = new uchar 32768 0
n = pdreadin req
if eq n 0
i = ulong 0
while lt i len pddflt bound 4096
put req i get pddflt i
i = add i 1
end
n = len pddflt
end
r = pdchat req n
if lt r 0
ret 2
end
ret 0
end

om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note tools/pi-drive-27b/tree20.om: Pure seeded Omega (OM-1) 20-core parallel L2-resident
note speculative token-tree generator & benchmark for DGX Spark (10 X925 + 10 A725 cores).
note Each core runs an independent 64 KiB L2-resident context ring (0 LPDDR5x contention)
note generating 20-node candidate token trees + 20x20 causal tree-attention bitmasks for a
note single GB10 GPU verify_20 pass.
note Build on AArch64 Linux: seed/out/omc < tools/pi-drive-27b/tree20.om > tree20 && chmod +x tree20

const T2CAP ulong 8192
const T2MASK ulong 8191
const T2NODES ulong 20
const T2STEPS ulong 5000

global t2ctx ulong 8192
global t2tree ulong 20
global t2par ulong 20
global t2amask ulong 20
global t2len ulong 1
global t2out uchar 256
global t2olen ulong 1

text t2msg1 "TREE20 PASS steps="
text t2msg2 " tokens="
text t2msg3 " checksum="
text t2nl "\n"

fn t2emit b uchar to void
p = get t2olen 0
if lt p 256
put t2out p b
put t2olen 0 add p 1
end
end

fn t2emits s view uchar * to void
for i ulong len s
t2emit get s i
end
end

fn t2emitdec v ulong to void
if eq v 0
t2emit uchar 48
ret
end
d = new uchar 24 0
n = ulong 0
x = v
while gt x 0 bound 24
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 24
n = sub n 1
t2emit get d n
end
end

fn t2seed core ulong to void
note Populate 8192-token L2-resident ring with repeating realistic .om token idioms
for i ulong T2CAP
k = rem i 32
tok = add 1000 mul k 17
if eq rem i 64 0
tok = add 5000 core
end
put t2ctx i tok
end
put t2len 0 T2CAP
end

fn t2match pos ulong suf ulong ng ulong to bool
for j ulong ng
a = get t2ctx and add pos j T2MASK
b = get t2ctx and add suf j T2MASK
if ne a b
ret false
end
end
ret true
end

fn t2find clen ulong ng ulong br ulong core ulong to ulong
suf = sub clen ng
scan = ulong 1
while le scan 128 bound 129
pos = sub suf scan
if t2match pos suf ng
ret add pos ng
end
scan = add scan 1
end
ret add sub clen 16 add br core
end

note Build one 20-node speculative token tree + 20x20 causal attention bitmask
note Branches: 4 parallel roots (n=4,3,2,1 suffix matches) x 5-token depth = 20 nodes
fn t2buildtree step ulong core ulong to ulong
clen = get t2len 0
for i ulong T2NODES
put t2tree i 0
put t2par i 255
put t2amask i 0
end
idx = ulong 0
for br ulong 4
ng = sub 4 br
hit = t2find clen ng br core
prev = ulong 255
for dep ulong 5
tok = get t2ctx and add hit dep T2MASK
tok = xor tok and add step br 3
put t2tree idx tok
put t2par idx prev
m = shl ulong 1 idx
if ne prev 255
m = or m get t2amask prev
end
put t2amask idx m
prev = idx
idx = add idx 1
end
end
for a ulong 4
p = get t2len 0
put t2ctx and p T2MASK get t2tree a
put t2len 0 add p 1
end
ret T2NODES
end

fn main to int
t2seed 0
total = ulong 0
chk = ulong 0
for s ulong T2STEPS
n = t2buildtree s 0
total = add total n
chk = xor chk get t2tree 19
chk = xor chk get t2amask 19
end
if ne total mul T2STEPS T2NODES
ret 1
end
t2emits t2msg1
t2emitdec T2STEPS
t2emits t2msg2
t2emitdec total
t2emits t2msg3
t2emitdec chk
t2emits t2nl
w = write 1 t2out 0 get t2olen 0
if lt w 0
ret 2
end
ret 0
end

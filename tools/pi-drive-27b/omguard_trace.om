note Test 3: >6 params refusal (-2).
fn test3 to long
oginit
i = ulong 0
while lt i len s3_0 bound 512
put ogline i get s3_0 i
i = add i 1
end
if ne ogcheckline len s3_0 -2
ret -1
end
ret 0
end

note Test 4: >16 distinct locals refusal (-3), with reassignment allowed.
fn test4a to long
oginit
i = ulong 0
while lt i len s4_0 bound 512
put ogline i get s4_0 i
i = add i 1
end
if ne ogcheckline len s4_0 0
ret -1
end
i = ulong 0
while lt i len s4_1 bound 512
put ogline i get s4_1 i
i = add i 1
end
if ne ogcheckline len s4_1 0
ret -2
end
note Reassign v0: must not consume a new register slot.
if ne ogcheckline len s4_1 0
ret -2
end
i = ulong 0
while lt i len s4_2 bound 512
put ogline i get s4_2 i
i = add i 1
end
if ne ogcheckline len s4_2 0
ret -3
end
i = ulong 0
while lt i len s4_3 bound 512
put ogline i get s4_3 i
i = add i 1
end
if ne ogcheckline len s4_3 0
ret -4
end
i = ulong 0
while lt i len s4_4 bound 512
put ogline i get s4_4 i
i = add i 1
end
if ne ogcheckline len s4_4 0
ret -5
end
i = ulong 0
while lt i len s4_5 bound 512
put ogline i get s4_5 i
i = add i 1
end
if ne ogcheckline len s4_5 0
ret -6
end
i = ulong 0
while lt i len s4_6 bound 512
put ogline i get s4_6 i
i = add i 1
end
if ne ogcheckline len s4_6 0
ret -7
end
i = ulong 0
while lt i len s4_7 bound 512
put ogline i get s4_7 i
i = add i 1
end
if ne ogcheckline len s4_7 0
ret -8
end
i = ulong 0
while lt i len s4_8 bound 512
put ogline i get s4_8 i
i = add i 1
end
if ne ogcheckline len s4_8 0
ret -9
end
ret 0
end

fn test4 to long
r = test4a
if ne r 0
ret r
end
i = ulong 0
while lt i len s4_9 bound 512
put ogline i get s4_9 i
i = add i 1
end
if ne ogcheckline len s4_9 0
ret -10
end
i = ulong 0
while lt i len s4_10 bound 512
put ogline i get s4_10 i
i = add i 1
end
if ne ogcheckline len s4_10 0
ret -11
end
i = ulong 0
while lt i len s4_11 bound 512
put ogline i get s4_11 i
i = add i 1
end
if ne ogcheckline len s4_11 0
ret -12
end
i = ulong 0
while lt i len s4_12 bound 512
put ogline i get s4_12 i
i = add i 1
end
if ne ogcheckline len s4_12 0
ret -13
end
i = ulong 0
while lt i len s4_13 bound 512
put ogline i get s4_13 i
i = add i 1
end
if ne ogcheckline len s4_13 0
ret -14
end
i = ulong 0
while lt i len s4_14 bound 512
put ogline i get s4_14 i
i = add i 1
end
if ne ogcheckline len s4_14 0
ret -15
end
i = ulong 0
while lt i len s4_15 bound 512
put ogline i get s4_15 i
i = add i 1
end
if ne ogcheckline len s4_15 0
ret -16
end
i = ulong 0
while lt i len s4_16 bound 512
put ogline i get s4_16 i
i = add i 1
end
if ne ogcheckline len s4_16 0
ret -17
end
if ne ognlocs 16
ret -18
end
i = ulong 0
while lt i len s4_17 bound 512
put ogline i get s4_17 i
i = add i 1
end
if ne ogcheckline len s4_17 -3
ret -19
end
ret 0
end

note Test 5: while missing bound refusal (-4).
fn test5 to long
oginit
i = ulong 0
while lt i len s5_0 bound 512
put ogline i get s5_0 i
i = add i 1
end
if ne ogcheckline len s5_0 0
ret -1
end
i = ulong 0
while lt i len s5_1 bound 512
put ogline i get s5_1 i
i = add i 1
end
if ne ogcheckline len s5_1 -4
ret -2
end
ret 0
end

note Test 6: unbalanced end refusal (-5) and nested fn refusal (-6).
fn test6 to long
oginit
i = ulong 0
while lt i len s6_0 bound 512
put ogline i get s6_0 i
i = add i 1
end
if ne ogcheckline len s6_0 -5
ret -1
end
i = ulong 0
while lt i len s6_1 bound 512
put ogline i get s6_1 i
i = add i 1
end
if ne ogcheckline len s6_1 0
ret -2
end
i = ulong 0
while lt i len s6_2 bound 512
put ogline i get s6_2 i
i = add i 1
end
if ne ogcheckline len s6_2 -6
ret -3
end
ret 0
end

note Test 7: prefix-pool FNV-1a chunk hashing, exact & partial longest-prefix match.
fn test7 to long
ogpinit
i = ulong 0
while lt i len pchunk0 bound 512
put ogp_buf i get pchunk0 i
i = add i 1
end
h0 = ogphash 0 len pchunk0
i = ulong 0
while lt i len pchunk1 bound 512
put ogp_buf i get pchunk1 i
i = add i 1
end
h1 = ogphash 0 len pchunk1
i = ulong 0
while lt i len pchunk2 bound 512
put ogp_buf i get pchunk2 i
i = add i 1
end
h2 = ogphash 0 len pchunk2
i = ulong 0
while lt i len pchunk3 bound 512
put ogp_buf i get pchunk3 i
i = add i 1
end
h3 = ogphash 0 len pchunk3
if eq h0 h1
ret -1
end
note Slot 3: [h0, h1] with state_pa 4096000
put ogp_q 0 h0
put ogp_q 1 h1
if ne ogpput 3 2 4096000 0
ret -2
end
note Slot 7: [h0, h1, h2] with state_pa 8192000
put ogp_q 0 h0
put ogp_q 1 h1
put ogp_q 2 h2
if ne ogpput 7 3 8192000 0
ret -3
end
note Exact 3-chunk match must pick slot 7 (len 3, pa 8192000).
put ogp_q 0 h0
put ogp_q 1 h1
put ogp_q 2 h2
if ne ogpmatch 3 7
ret -4
end
if ne ogpmatch_len 3
ret -5
end
if ne ogpmatch_pa 8192000
ret -6
end
note Partial 2-chunk query [h0, h3]: matches h0 (len 1) on most recent slot 7.
put ogp_q 0 h0
put ogp_q 1 h3
ms = ogpmatch 2
if lt ms 0
ret -7
end
if ne ogpmatch_len 1
ret -8
end
note Unmatched query [h3]: must return -1.
put ogp_q 0 h3
if ne ogpmatch 1 -1
ret -9
end
ret 0
end

note Test 8: prefix-pool full 64-slot fill and LRU eviction.
fn test8 to long
ogpinit
s = ulong 0
while lt s OGSLOTS bound 64
h = ogphash_tok add 1000 s OGFNVOFF
put ogp_q 0 h
pa = mul add s 1 65536
if ne ogpput s 1 pa 0
ret -1
end
s = add s 1
end
note Touch slot 0 via ogpmatch so slot 1 becomes the oldest LRU entry.
h0 = ogphash_tok 1000 OGFNVOFF
put ogp_q 0 h0
if ne ogpmatch 1 0
ret -2
end
note Evict must choose slot 1 (oldest untouched) and clear it.
v = ogpevict
if ne v 1
ret -3
end
if ne get ogp_act 1 0
ret -4
end
note Next evict must choose slot 2.
v2 = ogpevict
if ne v2 2
ret -5
end
ret 0
end

fn main to int
ok = ulong 0
if eq test1 0
ok = add ok 1
end
if eq test2 0
ok = add ok 1
end
if eq test3 0
ok = add ok 1
end
if eq test4 0
ok = add ok 1
end
if eq test5 0
ok = add ok 1
end
if eq test6 0
ok = add ok 1
end
if eq test7 0
ok = add ok 1
end
if eq test8 0
ok = add ok 1
end
if eq ok 8
k = write 1 tpass 0 len tpass
ret 0
end
k = write 2 tfail 0 len tfail
ret 1
end

note SPDX-License-Identifier: Apache-2.0
note tools/pi-drive-27b/omguard_trace.om: Pure OM-1 self-test driver for omguard.om.
note Build on AArch64 Linux:
note   cat tools/pi-drive-27b/omguard.om tools/pi-drive-27b/omguard_trace.om | ./seed/out/omc > omguard_trace
note Run:
note   ./omguard_trace

text tpass "OMGUARD TEST PASS 8/8\n"
text tfail "OMGUARD TEST FAIL\n"

text s1_0 "note 0xdeadbeef inside note comment is allowed"
text s1_1 "fn sq x ulong y ulong to ulong"
text s1_2 "acc = ulong 0"
text s1_3 "i = ulong 0"
text s1_4 "while lt i x bound 64"
text s1_5 "if gt y 0"
text s1_6 "acc = add acc y"
text s1_7 "end"
text s1_8 "i = add i 1"
text s1_9 "end"
text s1_10 "ret acc"
text s1_11 "end"

text s2_0 "fn badhex to ulong"
text s2_1 "x = ulong 0x10"
text s2_2 "y = ulong 0XFF"

text s3_0 "fn too7 a ulong b ulong c ulong d ulong e ulong f ulong g ulong to ulong"

text s4_0 "fn many to ulong"
text s4_1 "v0 = ulong 0"
text s4_2 "v1 = ulong 1"
text s4_3 "v2 = ulong 2"
text s4_4 "v3 = ulong 3"
text s4_5 "v4 = ulong 4"
text s4_6 "v5 = ulong 5"
text s4_7 "v6 = ulong 6"
text s4_8 "v7 = ulong 7"
text s4_9 "v8 = ulong 8"
text s4_10 "v9 = ulong 9"
text s4_11 "v10 = ulong 10"
text s4_12 "v11 = ulong 11"
text s4_13 "v12 = ulong 12"
text s4_14 "v13 = ulong 13"
text s4_15 "v14 = ulong 14"
text s4_16 "v15 = ulong 15"
text s4_17 "v16 = ulong 16"

text s5_0 "fn nobnd x ulong to ulong"
text s5_1 "while gt x 0"

text s6_0 "end"
text s6_1 "fn outer to ulong"
text s6_2 "fn inner to ulong"

text pchunk0 "system: pure omega om-1 codegen"
text pchunk1 "user: write fn sq x ulong to ulong"
text pchunk2 "assistant: fn sq x ulong to ulong"
text pchunk3 "user: write fn fib n ulong to ulong"

note Test 1: valid OM-1 function with note 0x comment, while bound, if/end, balanced depth.
fn test1 to long
oginit
i = ulong 0
while lt i len s1_0 bound 512
put ogline i get s1_0 i
i = add i 1
end
if ne ogcheckline len s1_0 0
ret -1
end
i = ulong 0
while lt i len s1_1 bound 512
put ogline i get s1_1 i
i = add i 1
end
if ne ogcheckline len s1_1 0
ret -2
end
i = ulong 0
while lt i len s1_2 bound 512
put ogline i get s1_2 i
i = add i 1
end
if ne ogcheckline len s1_2 0
ret -3
end
i = ulong 0
while lt i len s1_3 bound 512
put ogline i get s1_3 i
i = add i 1
end
if ne ogcheckline len s1_3 0
ret -4
end
i = ulong 0
while lt i len s1_4 bound 512
put ogline i get s1_4 i
i = add i 1
end
if ne ogcheckline len s1_4 0
ret -5
end
i = ulong 0
while lt i len s1_5 bound 512
put ogline i get s1_5 i
i = add i 1
end
if ne ogcheckline len s1_5 0
ret -6
end
i = ulong 0
while lt i len s1_6 bound 512
put ogline i get s1_6 i
i = add i 1
end
if ne ogcheckline len s1_6 0
ret -7
end
i = ulong 0
while lt i len s1_7 bound 512
put ogline i get s1_7 i
i = add i 1
end
if ne ogcheckline len s1_7 0
ret -8
end
i = ulong 0
while lt i len s1_8 bound 512
put ogline i get s1_8 i
i = add i 1
end
if ne ogcheckline len s1_8 0
ret -9
end
i = ulong 0
while lt i len s1_9 bound 512
put ogline i get s1_9 i
i = add i 1
end
if ne ogcheckline len s1_9 0
ret -10
end
i = ulong 0
while lt i len s1_10 bound 512
put ogline i get s1_10 i
i = add i 1
end
if ne ogcheckline len s1_10 0
ret -11
end
i = ulong 0
while lt i len s1_11 bound 512
put ogline i get s1_11 i
i = add i 1
end
if ne ogcheckline len s1_11 0
ret -12
end
if ne ogdepth 0
ret -13
end
if ne oginfn 0
ret -14
end
ret 0
end

note Test 2: hex literal refusal (-1) for both 0x and 0X.
fn test2 to long
oginit
i = ulong 0
while lt i len s2_0 bound 512
put ogline i get s2_0 i
i = add i 1
end
if ne ogcheckline len s2_0 0
ret -1
end
i = ulong 0
while lt i len s2_1 bound 512
put ogline i get s2_1 i
i = add i 1
end
if ne ogcheckline len s2_1 -1
ret -2
end
i = ulong 0
while lt i len s2_2 bound 512
put ogline i get s2_2 i
i = add i 1
end
if ne ogcheckline len s2_2 -1
ret -3
end
ret 0

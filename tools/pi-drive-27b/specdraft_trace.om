note SPDX-License-Identifier: Apache-2.0
note tools/pi-drive-27b/specdraft_trace.om -- OM-1 self-test driver for specdraft.om.
note Build on AArch64 Linux:
note   cat tools/pi-drive-27b/specdraft.om tools/pi-drive-27b/specdraft_trace.om | ./seed/out/omc > specdraft_trace
note   ./specdraft_trace

text sdpass "SPECDRAFT TEST PASS 8/8\n"

note Test 1: exact 4-gram and 3-gram draft hits on synthetic .om token sequences.
fn sdt1 to int
sdreset
sdpush 101
sdpush 202
sdpush 303
sdpush 404
sdpush 505
sdpush 606
sdpush 707
sdpush 808
sdpush 101
sdpush 202
sdpush 303
sdpush 404
k4 = sddraft 4
if ne k4 4
ret 1
end
if ne get sdlast_ng 0 4
ret 2
end
if ne get sddraftbuf 0 505
ret 3
end
if ne get sddraftbuf 1 606
ret 4
end
if ne get sddraftbuf 2 707
ret 5
end
if ne get sddraftbuf 3 808
ret 6
end
sdreset
sdpush 11
sdpush 20
sdpush 30
sdpush 40
sdpush 501
sdpush 502
sdpush 503
sdpush 12
sdpush 20
sdpush 30
sdpush 40
k3 = sddraft 3
if ne k3 3
ret 7
end
if ne get sdlast_ng 0 3
ret 8
end
if ne get sddraftbuf 0 501
ret 9
end
if ne get sddraftbuf 1 502
ret 10
end
if ne get sddraftbuf 2 503
ret 11
end
ret 0
end

note Test 2: exact 2-gram (most-recent match preference) and 1-gram draft hits.
fn sdt2 to int
sdreset
sdpush 10
sdpush 20
sdpush 30
sdpush 401
sdpush 402
sdpush 99
sdpush 20
sdpush 30
sdpush 601
sdpush 602
sdpush 88
sdpush 20
sdpush 30
k2 = sddraft 2
if ne k2 2
ret 1
end
if ne get sdlast_ng 0 2
ret 2
end
if ne get sddraftbuf 0 601
ret 3
end
if ne get sddraftbuf 1 602
ret 4
end
sdreset
sdpush 1
sdpush 2
sdpush 3
sdpush 701
sdpush 702
sdpush 4
sdpush 5
sdpush 3
k1 = sddraft 2
if ne k1 2
ret 5
end
if ne get sdlast_ng 0 1
ret 6
end
if ne get sddraftbuf 0 701
ret 7
end
if ne get sddraftbuf 1 702
ret 8
end
ret 0
end

note Test 3: no-match returning 0 (empty, single token, all distinct tokens).
fn sdt3 to int
sdreset
r0 = sddraft 4
if ne r0 0
ret 1
end
if ne get sdlast_ng 0 0
ret 2
end
sdpush 42
r1 = sddraft 4
if ne r1 0
ret 3
end
sdpush 43
sdpush 44
sdpush 45
sdpush 46
sdpush 47
r2 = sddraft 4
if ne r2 0
ret 4
end
if ne get sdlast_ng 0 0
ret 5
end
ret 0
end

note Test 4: full-accept (m == n, commits n + 1 tokens including bonus token).
fn sdt4 to int
sdreset
sdpush 100
sdpush 200
sdpush 300
sdpush 400
sdpush 500
sdpush 600
sdpush 700
sdpush 100
sdpush 200
sdpush 300
sdpush 400
d = sddraft 3
if ne d 3
ret 1
end
put sdtgtbuf 0 500
put sdtgtbuf 1 600
put sdtgtbuf 2 700
put sdtgtbuf 3 800
c = sdverify 3
if ne c 4
ret 2
end
if ne get sdlen 0 15
ret 3
end
if ne sdget 11 500
ret 4
end
if ne sdget 12 600
ret 5
end
if ne sdget 13 700
ret 6
end
if ne sdget 14 800
ret 7
end
if ne get sdtotal_draft 0 3
ret 8
end
if ne get sdtotal_acc 0 3
ret 9
end
if ne get sdsteps 0 1
ret 10
end
ret 0
end

note Test 5: partial-accept + correction token at first mismatch m.
fn sdt5 to int
sdreset
sdpush 10
sdpush 20
sdpush 30
sdpush 40
sdpush 50
sdpush 60
sdpush 70
sdpush 80
sdpush 10
sdpush 20
sdpush 30
sdpush 40
d = sddraft 4
if ne d 4
ret 1
end
put sdtgtbuf 0 50
put sdtgtbuf 1 60
put sdtgtbuf 2 999
put sdtgtbuf 3 80
put sdtgtbuf 4 90
c = sdverify 4
if ne c 3
ret 2
end
if ne get sdlen 0 15
ret 3
end
if ne sdget 12 50
ret 4
end
if ne sdget 13 60
ret 5
end
if ne sdget 14 999
ret 6
end
if ne get sdtotal_draft 0 4
ret 7
end
if ne get sdtotal_acc 0 2
ret 8
end
if ne get sdsteps 0 1
ret 9
end
ret 0
end

note Test 6: zero-accept rollback (mismatch at m == 0 commits only correction token).
fn sdt6 to int
sdreset
sdpush 1
sdpush 2
sdpush 3
sdpush 4
sdpush 5
sdpush 6
sdpush 7
sdpush 1
sdpush 2
sdpush 3
sdpush 4
d = sddraft 3
if ne d 3
ret 1
end
put sdtgtbuf 0 888
put sdtgtbuf 1 6
put sdtgtbuf 2 7
put sdtgtbuf 3 8
c = sdverify 3
if ne c 1
ret 2
end
if ne get sdlen 0 12
ret 3
end
if ne sdget 11 888
ret 4
end
if ne get sdtotal_draft 0 3
ret 5
end
if ne get sdtotal_acc 0 0
ret 6
end
if ne get sdsteps 0 1
ret 7
end
ret 0
end

note Test 7: ring wraparound past 8192 tokens (evicts old pattern, keeps live pattern).
fn sdt7 to int
sdreset
sdpush 9001
sdpush 9002
sdpush 9003
sdpush 9004
sdpush 9011
sdpush 9012
sdpush 9013
sdpush 9014
i = ulong 0
while lt i SDCAP bound 8192
sdpush add i 100000
i = add i 1
end
sdpush 9001
sdpush 9002
sdpush 9003
sdpush 9004
ev = sddraft 4
if ne ev 0
ret 1
end
sdpush 8001
sdpush 8002
sdpush 8003
sdpush 8004
sdpush 8055
sdpush 8066
sdpush 8077
sdpush 8088
sdpush 8001
sdpush 8002
sdpush 8003
sdpush 8004
dw = sddraft 4
if ne dw 4
ret 2
end
if ne get sdlast_ng 0 4
ret 3
end
if ne get sddraftbuf 0 8055
ret 4
end
if ne get sddraftbuf 1 8066
ret 5
end
if ne get sddraftbuf 2 8077
ret 6
end
if ne get sddraftbuf 3 8088
ret 7
end
put sdtgtbuf 0 8055
put sdtgtbuf 1 8066
put sdtgtbuf 2 8077
put sdtgtbuf 3 8088
put sdtgtbuf 4 8099
cw = sdverify 4
if ne cw 5
ret 8
end
if ne get sdlen 0 8221
ret 9
end
if ne sdget 8220 8099
ret 10
end
ret 0
end

note Test 8: invalid k > 8 and k == 0 refusal, invalid sdverify n > 8 refusal, valid k == 8.
fn sdt8 to int
sdreset
sdpush 10
sdpush 20
sdpush 30
sdpush 40
sdpush 50
sdpush 60
sdpush 70
sdpush 80
sdpush 90
sdpush 10
sdpush 20
sdpush 30
sdpush 40
r9 = sddraft 9
if ne r9 0
ret 1
end
if ne get sdlast_ng 0 0
ret 2
end
r99 = sddraft 99
if ne r99 0
ret 3
end
r0 = sddraft 0
if ne r0 0
ret 4
end
v9 = sdverify 9
if ne v9 0
ret 5
end
if ne get sdlen 0 13
ret 6
end
if ne get sdsteps 0 0
ret 7
end
r8 = sddraft 8
if ne r8 8
ret 8
end
if ne get sdlast_ng 0 4
ret 9
end
if ne get sddraftbuf 0 50
ret 10
end
if ne get sddraftbuf 4 90
ret 11
end
if ne get sddraftbuf 7 30
ret 12
end
ret 0
end

fn main to int
if ne sdt1 0
ret 1
end
if ne sdt2 0
ret 2
end
if ne sdt3 0
ret 3
end
if ne sdt4 0
ret 4
end
if ne sdt5 0
ret 5
end
if ne sdt6 0
ret 6
end
if ne sdt7 0
ret 7
end
if ne sdt8 0
ret 8
end
w = write 1 sdpass 0 len sdpass
if ne w long len sdpass
ret 9
end
ret 0
end

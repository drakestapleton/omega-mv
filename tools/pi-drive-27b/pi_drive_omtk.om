note SPDX-License-Identifier: Apache-2.0
note tools/pi-drive-27b/pi_drive_omtk.om: Pure seeded Omega (OM-2) Pi 5 client for OMTK v1 binary
note token-ID wire protocol (Piece 6). Zero HTTP, zero JSON, zero C/Python.
note Build on Pi 5 / AArch64 Linux:
note   { printf 'om2\n'; cat aienux/net/wire/omtk.om tools/pi-drive-27b/pi_drive_omtk.om; } | ./seed/out/omc > pi_drive_omtk
note Usage:
note   ./pi_drive_omtk <ipv4> <port> ping
note   ./pi_drive_omtk <ipv4> <port> reset <keep_pos>
note   ./pi_drive_omtk <ipv4> <port> infer <max_tokens> <eos_id> <tok0> [tok1 ...]

global cl_arg uchar 128
global cl_sa uchar 16
global cl_rx uchar 16400
global cl_num uchar 32

text Mpong "PONG state="
text Mkv " kv="
text Mmctx " max_ctx="
text Mgerr " gpu_err="
text Mtok "TOKEN "
text Mdone "DONE kv="
text Mreas " reason="
text Merr "ERR code="
text Mdet " detail="
text Msp " "
text Mnl "\n"

fn cl_put_u v ulong to void
i = ulong 32
while true bound 21
i = sub i 1
put cl_num i uchar add 48 rem v 10
v = div v 10
if eq v 0
break
end
end
k = write 1 cl_num i sub 32 i
end

fn cl_arg_len idx ulong to ulong
if ge long idx argcnt
ret 0
end
k = argread idx cl_arg 0 127
if lt k 0
ret 0
end
ret ulong k
end

fn cl_parse_u n ulong to ulong
if eq n 0
exit 2
end
v = ulong 0
i = ulong 0
while lt i n bound 20
c = ulong get cl_arg i
if or lt c 48 gt c 57
exit 2
end
v = add mul v 10 sub c 48
i = add i 1
end
ret v
end

note Parse dotted IPv4 string in cl_arg[0..n) into big-endian u32.
fn cl_parse_ip n ulong to ulong
v = ulong 0
o = ulong 0
d = ulong 0
dots = ulong 0
i = ulong 0
while lt i n bound 16
c = ulong get cl_arg i
if eq c 46
if or eq d 0 gt o 255
exit 2
end
v = add shl v 8 o
o = ulong 0
d = ulong 0
dots = add dots 1
else
if or lt c 48 gt c 57
exit 2
end
o = add mul o 10 sub c 48
d = add d 1
end
i = add i 1
end
if or ne dots 3 or eq d 0 gt o 255
exit 2
end
ret add shl v 8 o
end

note Dial IPv4:port via AF_INET SOCK_STREAM. Returns fd >= 0 or < 0.
fn cl_dial ip ulong port ulong to long
fd = socknew 2 1 0
if lt fd 0
ret fd
end
for i ulong 16
put cl_sa i 0
end
put cl_sa 0 2
put cl_sa 1 0
put cl_sa 2 uchar and shr port 8 255
put cl_sa 3 uchar and port 255
put cl_sa 4 uchar and shr ip 24 255
put cl_sa 5 uchar and shr ip 16 255
put cl_sa 6 uchar and shr ip 8 255
put cl_sa 7 uchar and ip 255
rc = connect int fd cl_sa 0 16
if lt rc 0
c = fclose int fd
ret rc
end
ret fd
end

note Send omktx[0..n) completely over fd.
fn cl_send_all fd int n ulong to long
off = ulong 0
while lt off n bound 16400
k = send fd omktx off sub n off 0
if le k 0
ret -1
end
off = add off ulong k
end
ret 0
end

note Receive exactly n bytes into cl_rx[off..off+n).
fn cl_recv_exact fd int off ulong n ulong to long
got = ulong 0
while lt got n bound 16400
k = recv fd cl_rx add off got sub n got 0
if le k 0
ret -1
end
got = add got ulong k
end
ret 0
end

fn cl_rx_r16 off ulong to ulong
a = ulong get cl_rx off
b = ulong get cl_rx add off 1
ret or a shl b 8
end

fn cl_rx_r32 off ulong to ulong
a = ulong get cl_rx off
b = ulong get cl_rx add off 1
c = ulong get cl_rx add off 2
d = ulong get cl_rx add off 3
ret or or or a shl b 8 shl c 16 shl d 24
end

note Receive and validate one OMTK v1 frame into cl_rx; header fields placed in omkhdr[0..5].
fn cl_recv_frame fd int to long
rc = cl_recv_exact fd 0 OMK_HDR
if lt rc 0
ret -1
end
put omkhdr 0 cl_rx_r32 0
put omkhdr 1 ulong get cl_rx 4
put omkhdr 2 ulong get cl_rx 5
put omkhdr 3 cl_rx_r16 6
put omkhdr 4 cl_rx_r32 8
put omkhdr 5 cl_rx_r32 12
vrc = omk_chk_hdr
if ne vrc OMK_OK
ret -2
end
plen = get omkhdr 5
if gt plen 0
rc = cl_recv_exact fd OMK_HDR plen
if lt rc 0
ret -1
end
else
for z ulong 16
put cl_rx add OMK_HDR z 0
end
end
ret 0
end

fn cl_print_err to void
k = write 1 Merr 0 len Merr
cl_put_u cl_rx_r32 16
k = write 1 Mdet 0 len Mdet
cl_put_u cl_rx_r32 20
k = write 1 Mnl 0 len Mnl
end

fn cl_print_done to void
k = write 1 Mdone 0 len Mdone
cl_put_u cl_rx_r32 16
k = write 1 Mreas 0 len Mreas
cl_put_u cl_rx_r32 20
k = write 1 Mnl 0 len Mnl
end

fn cl_cmd_ping fd int to int
rc = omk_mkhdr OMK_PING 0 0 0
if ne rc OMK_OK
ret 2
end
if lt cl_send_all fd get omktxn 0 0
ret 1
end
if lt cl_recv_frame fd 0
ret 1
end
op = get omkhdr 2
if eq op OMK_ERR
cl_print_err
ret 2
end
if ne op OMK_PONG
ret 2
end
k = write 1 Mpong 0 len Mpong
cl_put_u cl_rx_r32 16
k = write 1 Mkv 0 len Mkv
cl_put_u cl_rx_r32 20
k = write 1 Mmctx 0 len Mmctx
cl_put_u cl_rx_r32 24
k = write 1 Mgerr 0 len Mgerr
cl_put_u cl_rx_r32 28
k = write 1 Mnl 0 len Mnl
ret 0
end

fn cl_cmd_reset fd int to int
n = cl_arg_len 4
keep = ulong 0
if gt n 0
keep = cl_parse_u n
end
rc = omk_mkhdr OMK_RESET 0 0 4
if ne rc OMK_OK
ret 2
end
omk_txw32 16 keep
if lt cl_send_all fd get omktxn 0 0
ret 1
end
if lt cl_recv_frame fd 0
ret 1
end
op = get omkhdr 2
if eq op OMK_ERR
cl_print_err
ret 2
end
if ne op OMK_DONE
ret 2
end
cl_print_done
ret 0
end

fn cl_cmd_infer fd int to int
ac = ulong argcnt
if lt ac 7
ret 2
end
mtok = cl_parse_u cl_arg_len 4
eos = cl_parse_u cl_arg_len 5
ntok = sub ac 6
if gt ntok OMK_MAXTOK
ret 2
end
rc = omk_mkhdr OMK_PREFILL 0 1 mul ntok 4
if ne rc OMK_OK
ret 2
end
i = ulong 0
while lt i ntok bound 4096
tok = cl_parse_u cl_arg_len add 6 i
omk_txw32 add OMK_HDR mul i 4 tok
i = add i 1
end
if lt cl_send_all fd get omktxn 0 0
ret 1
end
if lt cl_recv_frame fd 0
ret 1
end
op = get omkhdr 2
if eq op OMK_ERR
cl_print_err
ret 2
end
if ne op OMK_DONE
ret 2
end
rc = omk_mkhdr OMK_DECODE OMK_FGREEDY 2 16
if ne rc OMK_OK
ret 2
end
omk_txw32 16 mtok
omk_txw32 20 eos
omk_txw32 24 0
omk_txw32 28 0
if lt cl_send_all fd get omktxn 0 0
ret 1
end
step = ulong 0
while lt step 16385 bound 16385
if lt cl_recv_frame fd 0
ret 1
end
op = get omkhdr 2
if eq op OMK_TOKEN
k = write 1 Mtok 0 len Mtok
cl_put_u cl_rx_r32 16
k = write 1 Msp 0 len Msp
cl_put_u cl_rx_r32 20
k = write 1 Mnl 0 len Mnl
else
if eq op OMK_DONE
cl_print_done
ret 0
else
if eq op OMK_ERR
cl_print_err
ret 2
else
ret 2
end
end
end
step = add step 1
end
ret 2
end

fn main to int
if lt argcnt 4
ret 2
end
ip = cl_parse_ip cl_arg_len 1
port = cl_parse_u cl_arg_len 2
if or eq port 0 gt port 65535
ret 2
end
cn = cl_arg_len 3
if eq cn 0
ret 2
end
cmd = ulong get cl_arg 0
fd = cl_dial ip port
if lt fd 0
ret 1
end
res = int 2
if eq cmd 112
res = cl_cmd_ping int fd
else
if eq cmd 114
res = cl_cmd_reset int fd
else
if eq cmd 105
res = cl_cmd_infer int fd
end
end
end
c = fclose int fd
ret res
end

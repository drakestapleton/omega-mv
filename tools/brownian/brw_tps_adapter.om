global g_dd_c f64 2
global g_dd_s f64 2
global g_dd_t f64 2
global g_dd_u f64 2
global g_dd_v f64 2
global g_dd_w f64 2
global g_dd_x f64 2
global g_bin_lc f64 2
global g_bin_lp f64 2
global g_bin_ln f64 2
global g_bin_lnz f64 2
global g_bin_lpar f64 2
global g_bin_c1 f64 2
global g_bin_c2 f64 2
global g_cf_z2 f64 2
global g_lm_a f64 2
global g_lm_b f64 2
global g_lm_t f64 2
global g_chk_q1 f64 2
global g_hk_mode long 1
global g_hk_at ulong 1
global g_hk_rel f64 1


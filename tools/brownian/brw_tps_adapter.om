note
note tools/brownian/brw_tps_adapter.om -- Pure seeded OM-2 TPS1 binariser
note (lane T, phases 1-2) with double-double (106-bit) log-mass arithmetic,
note qint.v1 proof gate, TPS1/TSY1 SHA-256 serialization, and EXP-001 range
note and rANS coders.
note Composed after src/turing/ty_qcont_lib.om and seed/ng/sha256.om.

const BRW_TPS_OK long 0
const BRW_TPS_E_ARG long -201
const BRW_TPS_E_RANGE long -202
const BRW_TPS_E_CAP long -203
const BRW_TPS_E_PROOF long -204
const BRW_TPS_E_NUM long -205
const BRW_TPS_E_CODER long -206

const BRW_TPS_MAX_STEPS ulong 112
const BRW_TOPCLS ulong 51

const TC_OK long 0
const TC_E_ARG long -101
const TC_E_IO long -102
const TC_E_FORMAT long -103
const TC_E_DIGEST long -104
const TC_E_NORM long -105
const TC_E_ZERO long -106
const TC_E_COUNT long -110
const TC_E_HEADER long -111
const TC_E_BINDING long -112
const TC_E_TRUNC long -113
const TC_E_TRAIL long -114
const TC_E_CORRUPT long -115
const TC_E_SYMBOL long -116

const TC_QONE ulong 65536
const TC_CODED_HDR ulong 56
const TC_RC_TOP ulong 16777216
const TC_RANS_L ulong 8388608

const TPS_MAX_OBS ulong 100000
const TPS_MAX_REC ulong 3145728

text t_tps_dom "turing.tc.pstream.v1"
text t_tsy_dom "turing.tc.symbols.v1"
text t_tps_mag "TPS1"
text t_tsy_mag "TSY1"
text t_tcr_mag "TCR1"
text t_trn_mag "TRN1"


note ---- Output / Formatting ----
fn out_push c uchar to void
  n = get g_sz 3
  if ge n len g_out
    nc = mul n 2
    if lt nc 4096
      nc = 4096
    end
    r = enlarge g_out nc
    if lt r 0
      exit 2
    end
  end
  put g_out n c
  put g_sz 3 add n 1
end

fn out_str s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    out_push get s i
    i = add i 1
  end
end

fn out_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    out_push 48
    ret
  end
  k = ulong 0
  while gt v 0
    put tmp k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0
    k = sub k 1
    out_push get tmp k
  end
end

fn out_i64 v long to void
  if lt v 0
    out_push 45
    if eq v sub neg long 9223372036854775807 1
      out_u64 9223372036854775808
    else
      out_u64 ulong neg v
    end
    ret
  end
  out_u64 ulong v
end

fn round_even v f64 scale f64 to ulong
  scaled = mul v scale
  fl = ulong scaled
  frac = sub scaled f64 fl
  if gt frac f64 0.5
    ret add fl 1
  end
  if and eq frac f64 0.5 eq and fl 1 1
    ret add fl 1
  end
  ret fl
end

fn out_fixed v f64 prec ulong to void
  if ne v v
    out_str t_nan
    ret
  end
  if lt v f64 0.0
    out_push 45
    v = neg v
  end
  scale = f64 1.0
  sdiv = ulong 1
  i = ulong 0
  while lt i prec
    scale = mul scale f64 10.0
    sdiv = mul sdiv 10
    i = add i 1
  end
  sv = round_even v scale
  ip = div sv sdiv
  fp = rem sv sdiv
  out_u64 ip
  if gt prec 0
    out_push 46
    d = div sdiv 10
    j = ulong 0
    while lt j prec
      dig = div fp d
      out_push uchar add 48 dig
      fp = rem fp d
      if gt d 1
        d = div d 10
      end
      j = add j 1
    end
  end
end

fn out_sci4 v f64 to void
  if ne v v
    out_str t_nan
    ret
  end
  if lt v f64 0.0
    out_push 45
    v = neg v
  end
  if eq v f64 0.0
    out_fixed f64 0.0 4
    out_push 101
    out_push 43
    out_push 48
    out_push 48
    ret
  end
  exp = long 0
  while ge v f64 10.0
    v = div v f64 10.0
    exp = add exp 1
  end
  while lt v f64 1.0
    v = mul v f64 10.0
    exp = sub exp 1
  end
  sv = round_even v f64 10000.0
  if ge sv 100000
    sv = div sv 10
    exp = add exp 1
  end
  ip = div sv 10000
  fp = rem sv 10000
  out_u64 ip
  out_push 46
  d = ulong 1000
  j = ulong 0
  while lt j 4
    out_push uchar add 48 div fp d
    fp = rem fp d
    if gt d 1
      d = div d 10
    end
    j = add j 1
  end
  out_push 101
  if lt exp 0
    out_push 45
    exp = neg exp
  else
    out_push 43
  end
  if lt exp 10
    out_push 48
  end
  out_i64 exp
end

fn out_flush to void
  n = get g_sz 3
  off = ulong 0
  while lt off n
    w = write 1 g_out off sub n off
    if le w 0
      exit 2
    end
    off = add off ulong w
  end
  put g_sz 3 0
end

fn tsv_push c uchar to void
  n = get g_sz 4
  if ge n len g_tsv
    nc = mul n 2
    if lt nc 8192
      nc = 8192
    end
    r = enlarge g_tsv nc
    if lt r 0
      exit 2
    end
  end
  put g_tsv n c
  put g_sz 4 add n 1
end

fn tsv_str s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    tsv_push get s i
    i = add i 1
  end
end

fn tsv_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    tsv_push 48
    ret
  end
  k = ulong 0
  while gt v 0
    put tmp k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0
    k = sub k 1
    tsv_push get tmp k
  end
end

fn tsv_fixed6 v f64 to void
  if lt v f64 0.0
    tsv_push 45
    v = neg v
  end
  sv = round_even v f64 1000000.0
  ip = div sv 1000000
  fp = rem sv 1000000
  tsv_u64 ip
  tsv_push 46
  d = ulong 100000
  j = ulong 0
  while lt j 6
    tsv_push uchar add 48 div fp d
    fp = rem fp d
    if gt d 1
      d = div d 10
    end
    j = add j 1
  end
end

fn die m view uchar * to void
  w1 = write 2 t_pfx 0 len t_pfx
  w2 = write 2 m 0 len m
  w3 = write 2 t_nl 0 1
  if or lt w1 0 or lt w2 0 lt w3 0
    exit 2
  end
  exit 2
end

note ---- IEEE-754 log2 & exp2 (< 1e-15 error) ----
fn flog2 x f64 to f64
  bits = bitcast ulong x
  exp_raw = and shr bits 52 2047
  e = sub long exp_raw 1023
  mbits = or and bits 4503599627370495 shl ulong 1023 52
  m = bitcast f64 mbits
  if ge m f64 1.4142135623730951
    m = mul m f64 0.5
    e = add e 1
  end
  y = div sub m f64 1.0 add m f64 1.0
  y2 = mul y y
  p = y
  s = y
  k = ulong 3
  while le k 17
    p = mul p y2
    s = add s div p f64 k
    k = add k 2
  end
  lnm = mul f64 2.0 s
  ret add f64 e div lnm f64 0.6931471805599453
end

fn fexp2 x f64 to f64
  if lt x f64 -1022.0
    ret f64 0.0
  end
  k = long x
  if lt x f64 k
    k = sub k 1
  end
  f = sub x f64 k
  u = mul f f64 0.6931471805599453
  term = f64 1.0
  sum = f64 1.0
  i = ulong 1
  while le i 16
    term = div mul term u f64 i
    sum = add sum term
    i = add i 1
  end
  sb = shl ulong add k 1023 52
  ret mul sum bitcast f64 sb
end

note ---- PPM-C ----
fn ppm_reset to void
  i = ulong 0
  while lt i 248322
    put g_c_head i neg long 1
    put g_c_u i 0
    put g_c_n i 0
    i = add i 1
  end
  i = ulong 0
  while lt i 248321
    put g_n0 i 0
    i = add i 1
  end
  put g_ppm 0 0
  put g_ppm 1 0
  put g_ppm 2 0
end

fn ppm_find c ulong x uint to long
  e = get g_c_head c
  while ge e 0
    ue = ulong e
    if eq get g_e_sym ue x
      ret e
    end
    e = get g_e_next ue
  end
  ret neg long 1
end

fn ppm_excl_n c ulong to ulong
  ex = ulong 0
  e = get g_c_head c
  while ge e 0
    ue = ulong e
    ex = add ex ulong get g_n0 ulong get g_e_sym ue
    e = get g_e_next ue
  end
  ret ex
end

fn ppm_cost c ulong x uint to f64
  bits = f64 0.0
  excl_n = ulong 0
  excl_u = ulong 0
  cn = get g_c_n c
  if gt cn 0
    cu = ulong get g_c_u c
    den = add f64 cn f64 cu
    e = ppm_find c x
    if ge e 0
      ret neg flog2 div f64 ulong get g_e_cnt ulong e den
    end
    bits = sub bits flog2 div f64 cu den
    excl_n = ppm_excl_n c
    excl_u = cu
  end
  n1 = sub get g_ppm 0 excl_n
  u1 = sub get g_ppm 1 excl_u
  if gt n1 0
    den2 = add f64 n1 f64 u1
    nx = ulong get g_n0 ulong x
    if gt nx 0
      ret sub bits flog2 div f64 nx den2
    end
    bits = sub bits flog2 div f64 u1 den2
  end
  ret add bits flog2 f64 sub ulong 248321 get g_ppm 1
end

fn ppm_update c ulong x uint to void
  e = ppm_find c x
  if ge e 0
    ue = ulong e
    put g_e_cnt ue add get g_e_cnt ue 1
  else
    eid = get g_ppm 2
    if ge eid len g_e_sym
      nc = mul eid 2
      if lt nc 8192
        nc = 8192
      end
      r1 = enlarge g_e_sym nc
      r2 = enlarge g_e_cnt nc
      r3 = enlarge g_e_next nc
      if or lt r1 0 or lt r2 0 lt r3 0
        die t_oom
      end
    end
    put g_e_sym eid x
    put g_e_cnt eid 1
    put g_e_next eid get g_c_head c
    put g_c_head c long eid
    put g_c_u c add get g_c_u c 1
    put g_ppm 2 add eid 1
  end
  put g_c_n c add get g_c_n c 1
  ux = ulong x
  if eq get g_n0 ux 0
    put g_ppm 1 add get g_ppm 1 1
  end
  put g_n0 ux add get g_n0 ux 1
  put g_ppm 0 add get g_ppm 0 1
end

fn selftest_check_ctx k ulong c ulong to bool
  sum = f64 0.0
  y = ulong 0
  while lt y 248321
    sum = add sum fexp2 neg ppm_cost c uint y
    y = add y 1
  end
  if gt fabs sub sum f64 1.0 f64 0.000000001
    out_str t_st_f1
    out_u64 k
    out_str t_st_f2
    out_u64 c
    out_str t_st_f3
    out_fixed sum 12
    out_push 10
    ret false
  end
  ret true
end

fn run_selftest to int
  ppm_reset
  s = ulong 499712851969
  prev = ulong 248321
  bad = false
  k = ulong 0
  while lt k 3000
    s = add mul s 6364136223846793005 1442695040888963407
    x = rem shr s 33 400
    if eq rem shr s 20 50 0
      x = rem shr s 13 248321
    end
    if or eq rem k 500 0 eq k 2999
      if not selftest_check_ctx k 248321
        bad = true
      end
      if not selftest_check_ctx k prev
        bad = true
      end
    end
    c = prev
    if eq rem k 37 0
      c = 248321
      prev = 248321
    else
      prev = x
    end
    ppm_update c uint x
    k = add k 1
  end
  if bad
    out_str t_st_fail
    out_flush
    ret 1
  end
  out_str t_st_ok
  out_flush
  ret 0
end

note ---- File I/O and parsing ----
fn build_out_path suf view uchar * to ulong
  p = ulong 0
  i = ulong 0
  dn = get g_sz 0
  while lt i dn
    put g_pbuf p get g_outdir i
    p = add p 1
    i = add i 1
  end
  i = ulong 0
  sn = len suf
  while lt i sn
    put g_pbuf p get suf i
    p = add p 1
    i = add i 1
  end
  ret p
end

fn slurp_fbuf use_csv bool plen ulong to bool
  fd = long 0
  if use_csv
    fd = fopen g_csv 0 plen 0 0
  else
    fd = fopen g_pbuf 0 plen 0 0
  end
  if lt fd 0
    ret false
  end
  if lt len g_fbuf 65536
    r = enlarge g_fbuf 65536
    if lt r 0
      die t_oom
    end
  end
  n = ulong 0
  while true
    cap = len g_fbuf
    if eq n cap
      r2 = enlarge g_fbuf mul cap 2
      if lt r2 0
        die t_oom
      end
      cap = len g_fbuf
    end
    got = read int fd g_fbuf n sub cap n
    if le got 0
      break
    end
    n = add n ulong got
  end
  cr = fclose int fd
  put g_sz 2 n
  if lt cr 0
    ret true
  end
  ret true
end

fn parse_i64_f p ulong lend ulong to long
  neg_ = false
  if lt p lend
    if eq get g_fbuf p 45
      neg_ = true
      p = add p 1
    end
  end
  v = long 0
  while lt p lend
    c = get g_fbuf p
    if or lt c 48 gt c 57
      break
    end
    v = add mul v 10 long sub c 48
    p = add p 1
  end
  if neg_
    ret neg v
  end
  ret v
end

fn skip_i64_f p ulong lend ulong to ulong
  if lt p lend
    if eq get g_fbuf p 45
      p = add p 1
    end
  end
  while lt p lend
    c = get g_fbuf p
    if or lt c 48 gt c 57
      break
    end
    p = add p 1
  end
  ret p
end

fn parse_f64_exp p ulong lend ulong v f64 to f64
  eneg = false
  if lt p lend
    c = get g_fbuf p
    if eq c 45
      eneg = true
      p = add p 1
    else
      if eq c 43
        p = add p 1
      end
    end
  end
  ev = ulong 0
  while lt p lend
    c = get g_fbuf p
    if or lt c 48 gt c 57
      break
    end
    ev = add mul ev 10 ulong sub c 48
    p = add p 1
  end
  i = ulong 0
  while lt i ev
    if eneg
      v = div v f64 10.0
    else
      v = mul v f64 10.0
    end
    i = add i 1
  end
  ret v
end

fn parse_f64_f p ulong lend ulong to f64
  neg_ = false
  if lt p lend
    if eq get g_fbuf p 45
      neg_ = true
      p = add p 1
    end
  end
  v = f64 0.0
  while lt p lend
    c = get g_fbuf p
    if or lt c 48 gt c 57
      break
    end
    v = add mul v f64 10.0 f64 ulong sub c 48
    p = add p 1
  end
  if lt p lend
    if eq get g_fbuf p 46
      p = add p 1
      sc = f64 0.1
      while lt p lend
        c = get g_fbuf p
        if or lt c 48 gt c 57
          break
        end
        v = add v mul f64 ulong sub c 48 sc
        sc = mul sc f64 0.1
        p = add p 1
      end
    end
  end
  if lt p lend
    ce = get g_fbuf p
    if or eq ce 101 eq ce 69
      v = parse_f64_exp add p 1 lend v
    end
  end
  if neg_
    ret neg v
  end
  ret v
end

fn skip_f64_f p ulong lend ulong to ulong
  if lt p lend
    if eq get g_fbuf p 45
      p = add p 1
    end
  end
  while lt p lend
    c = get g_fbuf p
    if or lt c 48 gt c 57
      break
    end
    p = add p 1
  end
  if lt p lend
    if eq get g_fbuf p 46
      p = add p 1
      while lt p lend
        c = get g_fbuf p
        if or lt c 48 gt c 57
          break
        end
        p = add p 1
      end
    end
  end
  if lt p lend
    ce = get g_fbuf p
    if or eq ce 101 eq ce 69
      p = add p 1
      if lt p lend
        cs = get g_fbuf p
        if or eq cs 43 eq cs 45
          p = add p 1
        end
      end
      while lt p lend
        c = get g_fbuf p
        if or lt c 48 gt c 57
          break
        end
        p = add p 1
      end
    end
  end
  ret p
end

fn is_ws c uchar to bool
  ret or or eq c 32 eq c 9 or eq c 10 eq c 13
end

note ---- Sensors, Health, Intervals, Session ----
global g_csv_tmp f64 6

fn row_grow to void
  n = get g_sz 5
  if lt n len g_rt
    ret
  end
  nc = mul n 2
  if lt nc 4096
    nc = 4096
  end
  r = enlarge g_rt nc
  if lt r 0
    die t_oom
  end
  r = enlarge g_rw nc
  if lt r 0
    die t_oom
  end
  r = enlarge g_rgw nc
  if lt r 0
    die t_oom
  end
  r = enlarge g_rutil nc
  if lt r 0
    die t_oom
  end
  r = enlarge g_rload nc
  if lt r 0
    die t_oom
  end
  r = enlarge g_rmem nc
  if lt r 0
    die t_oom
  end
  r = enlarge g_rlock nc
  if lt r 0
    die t_oom
  end
end

fn parse_csv_line p ulong lend ulong to void
  if ge p lend
    ret
  end
  c0 = get g_fbuf p
  if and ne c0 45 or lt c0 48 gt c0 57
    ret
  end
  t = parse_i64_f p lend
  p = skip_i64_f p lend
  if or ge p lend ne get g_fbuf p 44
    ret
  end
  p = add p 1
  ison = ulong 0
  while lt p lend
    if eq get g_fbuf p 44
      break
    end
    p = add p 1
    ison = add ison 1
  end
  if or eq ison 0 or ge p lend ne get g_fbuf p 44
    ret
  end
  p = add p 1
  k = ulong 0
  while lt k 6
    q = skip_f64_f p lend
    if eq q p
      ret
    end
    put g_csv_tmp k parse_f64_f p lend
    if lt k 5
      if or ge q lend ne get g_fbuf q 44
        ret
      end
      p = add q 1
    end
    k = add k 1
  end
  row_grow
  n = get g_sz 5
  put g_rt n t
  put g_rw n get g_csv_tmp 0
  put g_rgw n get g_csv_tmp 1
  put g_rutil n get g_csv_tmp 2
  put g_rload n get g_csv_tmp 3
  put g_rmem n get g_csv_tmp 4
  put g_rlock n get g_csv_tmp 5
  put g_sz 5 add n 1
end

fn load_sensors to void
  if not slurp_fbuf true get g_sz 1
    die t_ecsv
  end
  pos = ulong 0
  n = get g_sz 2
  while lt pos n
    lend = pos
    while lt lend n
      if eq get g_fbuf lend 10
        break
      end
      lend = add lend 1
    end
    parse_csv_line pos lend
    if lt lend n
      pos = add lend 1
    else
      pos = lend
    end
  end
end

fn load_health to void
  plen = build_out_path t_s_hlog
  if not slurp_fbuf false plen
    die t_ehp
  end
  pos = ulong 0
  n = get g_sz 2
  while lt pos n
    while lt pos n
      if not is_ws get g_fbuf pos
        break
      end
      pos = add pos 1
    end
    if ge pos n
      break
    end
    q = skip_i64_f pos n
    if eq q pos
      break
    end
    t = parse_i64_f pos n
    pos = q
    while lt pos n
      if not is_ws get g_fbuf pos
        break
      end
      pos = add pos 1
    end
    if ge pos n
      break
    end
    c = get g_fbuf pos
    b = neg long 1
    if eq c 48
      b = 0
    else
      if eq c 49
        b = 1
      end
    end
    while lt pos n
      if is_ws get g_fbuf pos
        break
      end
      pos = add pos 1
    end
    nh = get g_sz 6
    if ge nh len g_ht
      nc = mul nh 2
      if lt nc 4096
        nc = 4096
      end
      r1 = enlarge g_ht nc
      r2 = enlarge g_hb nc
      if or lt r1 0 lt r2 0
        die t_oom
      end
    end
    put g_ht nh t
    put g_hb nh b
    put g_sz 6 add nh 1
  end
end

fn find_fbuf start ulong lend ulong pat view uchar * to long
  pl = len pat
  if or eq pl 0 lt sub lend start pl
    ret neg long 1
  end
  lim = sub lend pl
  i = start
  while le i lim
    j = ulong 0
    ok = true
    while lt j pl
      if ne get g_fbuf add i j get pat j
        ok = false
        break
      end
      j = add j 1
    end
    if ok
      ret long i
    end
    i = add i 1
  end
  ret neg long 1
end

fn skip_ws_line p ulong lend ulong to ulong
  while lt p lend
    c = get g_fbuf p
    if and ne c 32 ne c 9
      break
    end
    p = add p 1
  end
  ret p
end

fn parse_iv_line pos ulong lend ulong to void
  p = skip_ws_line pos lend
  q = skip_i64_f p lend
  if eq q p
    ret
  end
  r = parse_i64_f p lend
  p = skip_ws_line q lend
  q = skip_i64_f p lend
  if eq q p
    ret
  end
  i = parse_i64_f p lend
  p = skip_ws_line q lend
  q = skip_i64_f p lend
  if eq q p
    ret
  end
  a = parse_i64_f p lend
  p = skip_ws_line q lend
  q = skip_i64_f p lend
  if eq q p
    ret
  end
  b = parse_i64_f p lend
  if or lt r 1 gt r long get g_sz 7
    ret
  end
  if or lt i 1 gt i long get g_sz 8
    ret
  end
  slot = add mul ulong r 9 ulong i
  put g_iv0 slot a
  put g_iv1 slot b
  tf = find_fbuf q lend t_tries
  tr = ulong 0
  if ge tf 0
    tr = ulong parse_i64_f add ulong tf 6 lend
  end
  put g_ivt slot tr
end

fn load_intervals to void
  plen = build_out_path t_s_ilog
  if not slurp_fbuf false plen
    die t_eiv
  end
  pos = ulong 0
  n = get g_sz 2
  while lt pos n
    lend = pos
    while lt lend n
      if eq get g_fbuf lend 10
        break
      end
      lend = add lend 1
    end
    parse_iv_line pos lend
    if lt lend n
      pos = add lend 1
    else
      pos = lend
    end
  end
end

fn fbuf_starts_at p ulong lend ulong pat view uchar * to bool
  pl = len pat
  if lt sub lend p pl
    ret false
  end
  i = ulong 0
  while lt i pl
    if ne get g_fbuf add p i get pat i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn load_session to void
  plen = build_out_path t_s_slog
  if not slurp_fbuf false plen
    die t_eses
  end
  pos = ulong 0
  n = get g_sz 2
  while lt pos n
    lend = pos
    while lt lend n
      if eq get g_fbuf lend 10
        break
      end
      lend = add lend 1
    end
    if fbuf_starts_at pos lend t_idle_p
      p = add pos 5
      q = skip_i64_f p lend
      if gt q p
        k = parse_i64_f p lend
        if and ge k 0 le k long get g_sz 7
          if fbuf_starts_at q lend t_start_p
            put g_idle0 ulong k parse_i64_f add q 7 lend
          else
            if fbuf_starts_at q lend t_end_p
              put g_idle1 ulong k parse_i64_f add q 5 lend
            end
          end
        end
      end
    end
    if lt lend n
      pos = add lend 1
    else
      pos = lend
    end
  end
end

note ---- Reply JSON field helpers ----
fn match_qkey_at i ulong key view uchar * to bool
  kl = len key
  j = ulong 0
  while lt j kl
    if ne get g_fbuf add add i 1 j get key j
      ret false
    end
    j = add j 1
  end
  ret eq get g_fbuf add add i 1 kl 34
end

fn json_field key view uchar * to long
  n = get g_sz 2
  kl = len key
  need = add kl 2
  if lt n need
    ret neg long 1
  end
  lim = sub n need
  i = ulong 0
  while le i lim
    if eq get g_fbuf i 34
      if match_qkey_at i key
        p = add add i 2 kl
        while lt p n
          if not is_ws get g_fbuf p
            break
          end
          p = add p 1
        end
        if lt p n
          if eq get g_fbuf p 58
            p = add p 1
            while lt p n
              if not is_ws get g_fbuf p
                break
              end
              p = add p 1
            end
            ret long p
          end
        end
        ret neg long 1
      end
    end
    i = add i 1
  end
  ret neg long 1
end

fn stream_push sym uint rep uint to void
  n = get g_st_tot 0
  if ge n len g_st_sym
    nc = mul n 2
    if lt nc 4096
      nc = 4096
    end
    r1 = enlarge g_st_sym nc
    r2 = enlarge g_st_rep nc
    if or lt r1 0 lt r2 0
      die t_oom
    end
  end
  put g_st_sym n sym
  put g_st_rep n rep
  put g_st_tot 0 add n 1
end

fn why_reset r ulong to void
  put g_rd_wlen r 0
end

fn why_push r ulong c uchar to void
  l = get g_rd_wlen r
  if lt l 159
    put g_rd_why add mul r 160 l c
    put g_rd_wlen r add l 1
  end
end

fn why_str r ulong s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    why_push r get s i
    i = add i 1
  end
end

fn why_u64 r ulong v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    why_push r 48
    ret
  end
  k = ulong 0
  while gt v 0
    put tmp k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0
    k = sub k 1
    why_push r get tmp k
  end
end

fn why_rp r ulong i ulong to void
  why_push r 114
  why_u64 r r
  why_str r t_p_dash
  why_u64 r i
end

fn build_reply_path r ulong i ulong to ulong
  p = ulong 0
  j = ulong 0
  dn = get g_sz 0
  while lt j dn
    put g_pbuf p get g_outdir j
    p = add p 1
    j = add j 1
  end
  put g_pbuf p 47
  put g_pbuf add p 1 114
  put g_pbuf add p 2 uchar add 48 r
  put g_pbuf add p 3 45
  put g_pbuf add p 4 112
  put g_pbuf add p 5 uchar add 48 i
  p = add p 6
  j = ulong 0
  while lt j 5
    put g_pbuf p get t_dot_json j
    p = add p 1
    j = add j 1
  end
  ret p
end

fn parse_reply_ids r ulong i ulong ids_p ulong to long
  n = get g_sz 2
  p = add ids_p 1
  rep = uint add mul r 100 i
  nid = ulong 0
  while lt p n
    c = get g_fbuf p
    if eq c 93
      break
    end
    if and ge c 48 le c 57
      v = ulong 0
      while lt p n
        c2 = get g_fbuf p
        if or lt c2 48 gt c2 57
          break
        end
        v = add mul v 10 ulong sub c2 48
        p = add p 1
      end
      if ge v 248320
        put g_rd_ok r 0
        why_reset r
        why_rp r i
        why_str r t_w_oor
        ret neg long 1
      end
      stream_push uint v rep
      nid = add nid 1
    else
      p = add p 1
    end
  end
  ret long nid
end

global g_rfp long 7

fn check_reply_fields r ulong i ulong to bool
  n = get g_sz 2
  put g_rfp 0 json_field t_k_rlp
  put g_rfp 1 json_field t_k_st
  put g_rfp 2 json_field t_k_gt
  put g_rfp 3 json_field t_k_tka
  put g_rfp 4 json_field t_k_tp
  put g_rfp 5 json_field t_k_fr
  put g_rfp 6 json_field t_k_ids
  miss = false
  if or lt get g_rfp 0 0 lt get g_rfp 1 0
    miss = true
  end
  if or lt get g_rfp 2 0 lt get g_rfp 3 0
    miss = true
  end
  if or lt get g_rfp 5 0 lt get g_rfp 6 0
    miss = true
  end
  if not miss
    p0 = ulong get g_rfp 0
    p1 = ulong get g_rfp 1
    p2 = ulong get g_rfp 2
    p6 = ulong get g_rfp 6
    if eq skip_f64_f p0 n p0
      miss = true
    end
    if eq skip_f64_f p1 n p1
      miss = true
    end
    if eq skip_f64_f p2 n p2
      miss = true
    end
    if ne get g_fbuf p6 91
      miss = true
    end
  end
  if miss
    put g_rd_ok r 0
    why_reset r
    why_rp r i
    why_str r t_w_mf
    ret false
  end
  ret true
end

fn finish_one_reply r ulong i ulong nid ulong usamp ulong lp f64 to void
  is_stop = fbuf_starts_at ulong get g_rfp 5 get g_sz 2 t_qstop
  if ne nid usamp
    if and is_stop eq add nid 1 usamp
      stream_push 248320 uint add mul r 100 i
      put g_rd_end r add get g_rd_end r 1
    else
      put g_rd_ok r 0
      why_reset r
      why_rp r i
      why_str r t_w_id1
      why_u64 r nid
      why_str r t_w_id2
      why_u64 r usamp
      why_str r t_w_id3
    end
  end
  put g_rd_rep r add get g_rd_rep r 1
  put g_rd_tok r add get g_rd_tok r nid
  put g_rd_lm r add get g_rd_lm r div neg lp f64 0.6931471805599453
  slot = add mul r 9 i
  if or eq get g_iv0 slot 0 le get g_iv1 slot get g_iv0 slot
    put g_rd_ok r 0
    why_reset r
    why_rp r i
    why_str r t_w_noiv
  end
end

fn load_one_reply r ulong i ulong to void
  plen = build_reply_path r i
  if not slurp_fbuf false plen
    put g_rd_ok r 0
    why_reset r
    why_str r t_w_miss
    why_u64 r r
    why_str r t_p_dash
    why_u64 r i
    ret
  end
  if not check_reply_fields r i
    ret
  end
  n = get g_sz 2
  lp = parse_f64_f ulong get g_rfp 0 n
  sampled = parse_f64_f ulong get g_rfp 1 n
  greedy = parse_f64_f ulong get g_rfp 2 n
  sbad = not fbuf_starts_at ulong get g_rfp 3 n t_false
  if ge get g_rfp 4 0
    if not fbuf_starts_at ulong get g_rfp 4 n t_null
      if ne parse_f64_f ulong get g_rfp 4 n f64 1.0
        sbad = true
      end
    end
  end
  if or le sampled f64 0.0 ne greedy f64 0.0
    sbad = true
  end
  if sbad
    put g_rd_ok r 0
    why_reset r
    why_rp r i
    why_str r t_w_sf
    ret
  end
  nid_l = parse_reply_ids r i ulong get g_rfp 6
  if lt nid_l 0
    ret
  end
  nid = ulong nid_l
  finish_one_reply r i nid ulong sampled lp
end

fn load_all_replies to void
  R = get g_sz 7
  P = get g_sz 8
  r = ulong 1
  while le r R
    put g_rd_ok r 1
    put g_st_off r get g_st_tot 0
    i = ulong 1
    while le i P
      if eq get g_rd_ok r 0
        break
      end
      load_one_reply r i
      i = add i 1
    end
    slen = sub get g_st_tot 0 get g_st_off r
    put g_st_len r slen
    put g_rd_sym r slen
    r = add r 1
  end
end

note ---- Code lengths & symbols.tsv ----
fn ctx_of base ulong k ulong to ulong
  if eq k 0
    ret 248321
  end
  idx = add base k
  if ne get g_st_rep sub idx 1 get g_st_rep idx
    ret 248321
  end
  ret ulong get g_st_sym sub idx 1
end

fn prime_round o ulong to void
  base = get g_st_off o
  slen = get g_st_len o
  k = ulong 0
  while lt k slen
    c = ctx_of base k
    x = get g_st_sym add base k
    ppm_update c x
    k = add k 1
  end
end

fn code_round_b r ulong to void
  base = get g_st_off r
  slen = get g_st_len r
  if lt len g_cb slen
    rc = enlarge g_cb slen
    if lt rc 0
      die t_oom
    end
  end
  ppm_reset
  lb = f64 0.0
  k = ulong 0
  while lt k slen
    c = ctx_of base k
    x = get g_st_sym add base k
    cb = ppm_cost c x
    put g_cb k cb
    lb = add lb cb
    ppm_update c x
    k = add k 1
  end
  put g_rd_lb r lb
end

fn code_round_bwarm r ulong to void
  R = get g_sz 7
  base = get g_st_off r
  slen = get g_st_len r
  ppm_reset
  o = ulong 1
  while le o R
    if and ne o r ne get g_rd_ok o 0
      prime_round o
    end
    o = add o 1
  end
  lbw = f64 0.0
  pos = ulong 0
  k = ulong 0
  while lt k slen
    c = ctx_of base k
    x = get g_st_sym add base k
    if eq c 248321
      pos = 0
    else
      pos = add pos 1
    end
    cw = ppm_cost c x
    lbw = add lbw cw
    tsv_u64 r
    tsv_push 9
    tsv_u64 ulong get g_st_rep add base k
    tsv_push 9
    tsv_u64 pos
    tsv_push 9
    tsv_u64 ulong x
    tsv_push 9
    tsv_fixed6 get g_cb k
    tsv_push 9
    tsv_fixed6 cw
    tsv_push 10
    ppm_update c x
    k = add k 1
  end
  put g_rd_lbw r lbw
  put g_rd_lu r mul f64 slen flog2 f64 248321.0
end

fn compute_code_lengths to void
  R = get g_sz 7
  tsv_str t_tsv_hdr
  r = ulong 1
  while le r R
    if ne get g_rd_ok r 0
      code_round_b r
      code_round_bwarm r
    end
    r = add r 1
  end
  plen = build_out_path t_s_syms
  fd = fopen g_pbuf 0 plen 577 420
  if lt fd 0
    die t_esy
  end
  tn = get g_sz 4
  off = ulong 0
  while lt off tn
    w = write int fd g_tsv off sub tn off
    if le w 0
      cr = fclose int fd
      if lt cr 0
        die t_esy
      end
      die t_esy
    end
    off = add off ulong w
  end
  cr = fclose int fd
  if lt cr 0
    die t_esy
  end
end

note ---- Energy ----
fn engine_idle_at t long to bool
  tn = mul t 1000000000
  bef = neg long 1
  aft = neg long 1
  nh = get g_sz 6
  i = ulong 0
  while lt i nh
    if le get g_ht i tn
      bef = get g_hb i
    else
      aft = get g_hb i
      break
    end
    i = add i 1
  end
  ret and eq bef 0 eq aft 0
end

global g_mw f64 2

fn mean_w_fallback mid long to void
  nr = get g_sz 5
  best = neg long 1
  bdist = long 0
  i = ulong 0
  while lt i nr
    d = sub get g_rt i mid
    if lt d 0
      d = neg d
    end
    if or lt best 0 lt d bdist
      best = long i
      bdist = d
    end
    i = add i 1
  end
  if lt best 0
    die t_enorow
  end
  put g_mw 0 get g_rw ulong best
  put g_mw 1 get g_rgw ulong best
end

fn mean_w t0n long t1n long to void
  t0 = div t0n 1000000000
  t1 = div t1n 1000000000
  s = f64 0.0
  g = f64 0.0
  k = ulong 0
  nr = get g_sz 5
  i = ulong 0
  while lt i nr
    rt = get g_rt i
    if and ge rt t0 le rt t1
      s = add s get g_rw i
      g = add g get g_rgw i
      k = add k 1
    end
    i = add i 1
  end
  if gt k 0
    put g_mw 0 div s f64 k
    put g_mw 1 div g f64 k
    ret
  end
  mean_w_fallback div add t0 t1 2
end

fn row_near tn long to ulong
  t = div tn 1000000000
  best = ulong 0
  bdist = long 0
  have = false
  nr = get g_sz 5
  i = ulong 0
  while lt i nr
    d = sub get g_rt i t
    if lt d 0
      d = neg d
    end
    if or not have lt d bdist
      best = i
      bdist = d
      have = true
    end
    i = add i 1
  end
  ret best
end

fn compute_round_idle r ulong to f64
  sb = f64 0.0
  nb = long 0
  nr = get g_sz 5
  k = sub r 1
  while le k r
    i0 = get g_idle0 k
    i1 = get g_idle1 k
    if and ne i0 0 ne i1 0
      t0 = div i0 1000000000
      t1 = div i1 1000000000
      j = ulong 0
      while lt j nr
        rt = get g_rt j
        if and ge rt t0 le rt t1
          if engine_idle_at rt
            sb = add sb get g_rw j
            nb = add nb 1
          end
        end
        j = add j 1
      end
    end
    k = add k 1
  end
  put g_rd_br r nb
  pb = div f64 0.0 f64 0.0
  if gt nb 0
    pb = div sb f64 nb
  end
  put g_rd_pb r pb
  ret pb
end

fn accum_one_req r ulong i ulong to f64
  slot = add mul r 9 i
  a = get g_iv0 slot
  b = get g_iv1 slot
  d = div f64 sub b a f64 1000000000.0
  mean_w a b
  w0 = get g_mw 0
  put g_rd_reqs r add get g_rd_reqs r d
  put g_rd_eg r add get g_rd_eg r mul w0 d
  de = mul sub w0 get g_rd_pb r d
  put g_rd_ei r add get g_rd_ei r de
  put g_rd_try r add get g_rd_try r get g_ivt slot
  ret mul get g_mw 1 d
end

fn compute_round_energy r ulong to void
  pb = compute_round_idle r
  P = get g_sz 8
  put g_rd_reqs r f64 0.0
  put g_rd_eg r f64 0.0
  put g_rd_ei r f64 0.0
  put g_rd_try r 0
  gws = f64 0.0
  i = ulong 1
  while le i P
    gws = add gws accum_one_req r i
    i = add i 1
  end
  if eq pb pb
    put g_rd_gwm r div gws get g_rd_reqs r
  else
    put g_rd_gwm r div gws get g_rd_reqs r
  end
  put g_rd_tf r get g_iv0 add mul r 9 1
  put g_rd_tl r get g_iv1 add mul r 9 P
end

note ---- Report ----
global g_G f64 4
global g_Gs f64 4
global g_GE f64 4
note g_sums: [0]=sumG [1]=sumSym [2]=sumEg [3]=sumEi [4]=sumLM [5]=sumLB [6]=sumLBW [7]=sumLU [8]=sumTok [9]=sumS
global g_sums f64 10

fn print_round_report r ulong to void
  g = sub get g_rd_lb r get g_rd_lm r
  sym = f64 get g_rd_sym r
  tok = f64 get g_rd_tok r
  eg = get g_rd_eg r
  ei = get g_rd_ei r
  reqs = get g_rd_reqs r
  put g_G r g
  put g_Gs r div g sym
  put g_GE r div g eg
  out_str t_rnd_ref1
  out_u64 r
  out_str t_r1
  out_u64 get g_rd_rep r
  out_str t_r2
  out_u64 get g_rd_tok r
  out_str t_r3
  out_u64 get g_rd_sym r
  out_str t_r4
  out_u64 get g_rd_end r
  out_str t_r5
  out_u64 get g_rd_try r
  out_push 10
  out_str t_l1
  out_fixed get g_rd_lu r 3
  out_str t_l2
  out_fixed get g_rd_lb r 3
  out_str t_l3
  out_fixed get g_rd_lbw r 3
  out_str t_l4
  out_fixed get g_rd_lm r 3
  out_str t_l5
  out_str t_p1
  out_fixed div get g_rd_lu r sym 4
  out_str t_p2
  out_fixed div get g_rd_lb r sym 4
  out_str t_p3
  out_fixed div get g_rd_lbw r sym 4
  out_str t_p4
  out_fixed div get g_rd_lm r sym 4
  out_str t_l5
  out_str t_g1
  out_fixed g 3
  out_str t_g2
  out_fixed div g sym 4
  out_str t_g3
  out_fixed sub g f64 243220274608.0 3
  out_str t_l5
  out_str t_t1
  out_fixed reqs 3
  out_str t_t2
  if ge reqs f64 30.0
    out_str t_t_rd
  else
    out_str t_t_un
  end
  out_str t_t3
  out_fixed div tok reqs 3
  out_str t_t4
  out_fixed get g_rd_gwm r 2
  out_str t_t5
  out_str t_e1
  out_fixed eg 1
  out_str t_e2
  out_fixed div eg tok 2
  out_str t_e3
  out_fixed get g_rd_pb r 2
  out_str t_e4
  out_i64 get g_rd_br r
  out_str t_e5
  if lt get g_rd_br r 5
    out_str t_unres
  end
  out_fixed ei 1
  out_str t_e2
  out_fixed div ei tok 2
  out_str t_e6
  out_str t_ge1
  out_fixed div g eg 5
  out_str t_ge2
  out_fixed div g ei 5
  out_str t_ge3
  out_sci4 div sub g f64 243220274608.0 eg
  out_str t_ge4
  s0 = row_near get g_rd_tf r
  s1 = row_near get g_rd_tl r
  out_str t_b1
  out_fixed get g_rload s0 2
  out_str t_b2
  out_fixed get g_rmem s0 0
  out_str t_b3
  out_fixed get g_rlock s0 0
  out_str t_b4
  out_fixed get g_rutil s0 0
  out_str t_b5
  out_fixed get g_rload s1 2
  out_str t_b2
  out_fixed get g_rmem s1 0
  out_str t_b3
  out_fixed get g_rlock s1 0
  out_str t_b4
  out_fixed get g_rutil s1 0
  out_push 10
  out_push 10
  put g_sums 0 add get g_sums 0 g
  put g_sums 1 add get g_sums 1 sym
  put g_sums 2 add get g_sums 2 eg
  put g_sums 3 add get g_sums 3 ei
  put g_sums 4 add get g_sums 4 get g_rd_lm r
  put g_sums 5 add get g_sums 5 get g_rd_lb r
  put g_sums 6 add get g_sums 6 get g_rd_lbw r
  put g_sums 7 add get g_sums 7 get g_rd_lu r
  put g_sums 8 add get g_sums 8 tok
  put g_sums 9 add get g_sums 9 reqs
end

fn print_yn v bool to void
  if v
    out_str t_yes
  else
    out_str t_no
  end
end

fn print_v0_verdict eps_pool f64 margin f64 T_pool f64 to void
  R = get g_sz 7
  pool_v0 = gt sub T_pool eps_pool margin
  v0 = pool_v0
  r = ulong 1
  while le r R
    er = mul f64 0.000003 f64 get g_rd_sym r
    if not gt sub sub get g_G r f64 243220274608.0 er f64 0.0
      v0 = false
    end
    r = add r 1
  end
  out_str t_vv0
  if v0
    out_str t_pass
  else
    out_str t_fail
  end
  out_str t_vv1
  print_yn pool_v0
  out_str t_vv2
  print_yn v0
  out_str t_endp
end

fn print_g_verdict sd f64 readable bool to void
  R = get g_sz 7
  mGs = f64 0.0
  mGE = f64 0.0
  r = ulong 1
  while le r R
    mGs = add mGs div get g_Gs r f64 R
    mGE = add mGE div get g_GE r f64 R
    r = add r 1
  end
  g1 = true
  g2 = true
  g3 = true
  r = ulong 1
  while le r R
    er = mul f64 0.000003 f64 get g_rd_sym r
    if not gt sub get g_G r er mul f64 3.0 sd
      g1 = false
    end
    if not le fabs sub get g_Gs r mGs mul f64 0.10 mGs
      g2 = false
    end
    if not le fabs sub get g_GE r mGE mul f64 0.20 mGE
      g3 = false
    end
    r = add r 1
  end
  out_str t_vg0
  if and g1 and g2 and g3 readable
    out_str t_pass
  else
    out_str t_fail
  end
  out_str t_vg1
  print_yn g1
  out_str t_vg2
  print_yn g2
  out_str t_vg3
  print_yn g3
  out_str t_vg4
  print_yn readable
  out_str t_endp
end

fn print_verdicts sd f64 eps_pool f64 margin f64 T_pool f64 readable bool to void
  print_v0_verdict eps_pool margin T_pool
  print_g_verdict sd readable
end

fn print_pooled_and_verdicts readable bool incr_ok bool to void
  R = get g_sz 7
  sumG = get g_sums 0
  sumSym = get g_sums 1
  sumEg = get g_sums 2
  sumEi = get g_sums 3
  sumTok = get g_sums 8
  mG = div sumG f64 R
  sd = f64 0.0
  r = ulong 1
  while le r R
    d = sub get g_G r mG
    sd = add sd mul d d
    r = add r 1
  end
  if gt R 1
    sd = fsqrt div sd f64 sub R 1
  else
    sd = f64 0.0
  end
  eps_pool = mul f64 0.000003 sumSym
  margin = mul mul f64 3.0 fsqrt f64 R sd
  T_pool = sub sumG f64 243220274608.0
  out_str t_pool1
  out_fixed sumSym 0
  out_str t_pool2
  out_fixed sumTok 0
  out_str t_pool3
  out_fixed get g_sums 9 3
  out_push 10
  out_str t_pl1
  out_fixed get g_sums 7 3
  out_str t_pl2
  out_fixed get g_sums 5 3
  out_str t_pl3
  out_fixed get g_sums 6 3
  out_str t_pl4
  out_fixed get g_sums 4 3
  out_str t_l5
  out_str t_pg1
  out_fixed sumG 3
  out_str t_pg2
  out_fixed div sumG sumSym 4
  out_str t_pg3
  out_fixed sd 3
  out_str t_pg4
  out_fixed eps_pool 4
  out_str t_l5
  out_str t_pt1
  out_fixed T_pool 3
  out_str t_pt2
  out_u64 R
  out_str t_pt3
  out_fixed margin 3
  out_str t_l5
  out_str t_pn1
  out_sci4 div f64 243220274608.0 div sumG sumSym
  out_str t_pn2
  out_str t_pe1
  out_fixed sumEg 1
  out_str t_pe2
  out_fixed div sumEg sumTok 3
  out_str t_pe3
  out_fixed sumEi 1
  out_str t_pe4
  if not incr_ok
    out_str t_unres2
  end
  out_str t_pe5
  out_fixed div sumEi sumTok 3
  out_str t_e6
  out_str t_ge1
  out_fixed div sumG sumEg 5
  out_str t_ge2
  out_fixed div sumG sumEi 5
  out_str t_ge3
  out_sci4 div T_pool sumEg
  out_str t_ge4
  out_push 10
  print_verdicts sd eps_pool margin T_pool readable
end

fn parse_u_arg idx ulong dflt ulong to ulong
  if ge idx ulong argcnt
    ret dflt
  end
  tmp = new uchar 32 0
  n = argread idx tmp 0 31
  if le n 0
    ret 0
  end
  v = ulong 0
  i = ulong 0
  while lt i ulong n
    c = get tmp i
    if or lt c 48 gt c 57
      break
    end
    v = add mul v 10 ulong sub c 48
    i = add i 1
  end
  ret v
end

fn eq_arg1_st to bool
  tmp = new uchar 32 0
  n = argread 1 tmp 0 31
  if ne n long len t_selftest
    ret false
  end
  i = ulong 0
  while lt i ulong n
    if ne get tmp i get t_selftest i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn emit_all_reports to int
  R = get g_sz 7
  out_str t_hdr1
  out_str t_hdr2
  nok = ulong 0
  readable = true
  incr_ok = true
  r = ulong 1
  while le r R
    if eq get g_rd_ok r 0
      out_str t_rnd_ref1
      out_u64 r
      out_str t_rnd_ref2
      wl = get g_rd_wlen r
      base = mul r 160
      j = ulong 0
      while lt j wl
        out_push get g_rd_why add base j
        j = add j 1
      end
      out_push 10
    else
      nok = add nok 1
      if lt get g_rd_reqs r f64 30.0
        readable = false
      end
      if lt get g_rd_br r 5
        incr_ok = false
      end
      print_round_report r
    end
    r = add r 1
  end
  if ne nok R
    out_str t_vref1
    out_u64 nok
    out_str t_vref2
    out_u64 R
    out_str t_vref3
    out_flush
    ret 1
  end
  print_pooled_and_verdicts readable incr_ok
  out_flush
  ret 0
end

fn main to int
  ac = argcnt
  if eq ac 2
    if eq_arg1_st
      ret run_selftest
    end
  end
  if lt ac 3
    die t_usage
  end
  dl = argread 1 g_outdir 0 1023
  cl = argread 2 g_csv 0 1023
  if or lt dl 0 lt cl 0
    die t_usage
  end
  put g_sz 0 ulong dl
  put g_sz 1 ulong cl
  R = parse_u_arg 3 3
  P = parse_u_arg 4 8
  if or lt R 1 or gt R 3 or lt P 1 gt P 8
    die t_bad_rp
  end
  put g_sz 7 R
  put g_sz 8 P
  load_sensors
  load_health
  load_intervals
  load_session
  load_all_replies
  compute_code_lengths
  r = ulong 1
  while le r R
    if ne get g_rd_ok r 0
      compute_round_energy r
    end
    r = add r 1
  end
  ret emit_all_reports
end

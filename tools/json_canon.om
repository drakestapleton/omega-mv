note
note tools/json_canon.om -- strict JSON check and Python-compatible canonical JSON.
note Pure seeded OM-2 replacement for tools/json_canon.c.
note
note   json_canon --check               exit 0 if stdin is one valid JSON document, 1 otherwise
note   json_canon --check-lines         print 1-based line numbers of invalid JSON lines
note   json_canon                       compact sorted UTF-8 JSON (Python json.dumps)
note   json_canon --sha256              SHA-256 hex of that compact form
note   json_canon --pretty              indent=2 sorted ASCII-escaped JSON with trailing newline
note   json_canon --write-exclusive P   write stdin to P (O_WRONLY|O_CREAT|O_EXCL, 0444, fsync)
om2

text k_sha_tbl "1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221 3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580 3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986 2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895 666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037 2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344 430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779 1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298 1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225"
text t_hex "0123456789abcdef"
text t_usage "usage: json_canon [--check | --pretty | --sha256 | --write-exclusive PATH] < json\n"
text t_f_check "--check"
text t_f_lines "--check-lines"
text t_f_pretty "--pretty"
text t_f_sha "--sha256"
text t_f_wex "--write-exclusive"
text t_null "null"
text t_true "true"
text t_false "false"
text t_nan "NaN"
text t_inf "Infinity"
text t_ninf "-Infinity"
text t_pzero "0.0"
text t_nzero "-0.0"
text t_epfx "json_canon: "
text t_ebyt " at byte "
text t_eoom "json_canon: out of memory\n"
text t_eread "json_canon: read error\n"
text t_ewrite "json_canon: write error\n"
text t_esurr "json_canon: lone surrogate cannot be encoded as UTF-8\n"

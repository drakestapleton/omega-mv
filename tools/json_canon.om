text t_ectrl "control character in string"
text t_eeesc "unterminated escape"
text t_ebesc "bad escape"
text t_enum "bad number"
text t_edeep "nesting too deep"
text t_eval "expecting value"
text t_eprop "expecting property name"
text t_ecolon "expecting ':'"
text t_eobj "expecting ',' or '}'"
text t_earr "expecting ',' or ']'"

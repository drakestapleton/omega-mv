global vom_has_mach ulong 1
global vom_ap_ops uchar 128
global vom_ap_n ulong 1
global vom_args ulong 3
global vom_id2 uchar 32
global vom_sink long 1

note ---------------- session ----------------

note omega_tool_session_init: session + the current machine model (assumed, not measured).
fn omega_tool_session_init to long
  vs_init
  vmch_detect_current
  put vom_has_mach 0 1
  ret 0
end

note 0 <= ix < cnt, without converting a negative ix (eager `or` would trap).
fn vom_idx_ok ix long cnt ulong to bool
  if lt ix 0
    ret false
  end
  ret lt ulong ix cnt
end

fn vom_put_long_err v long to void
  if lt v 0
    ve_putc uchar 45
    ve_put_u64 ulong sub 0 v
  else
    ve_put_u64 ulong v
  end
end

note ---------------- small output helpers ----------------

fn vom_put_ob_body rc long to long
  if lt rc 0
    ve_puts vom_m_big
    ret 1
  end
  vb_put_ob
  ret 0
end

fn vom_tf_vb b bool to void
  if b
    vb_puts vom_t_true
  else
    vb_puts vom_t_false
  end
end

fn vom_tmp_from_prog pidx ulong to void
  b = mul pidx 32
  for i ulong 32
    put v_tmp_id i get v_prog_id add b i
  end
end

fn vom_tmp_from_real ridx ulong to void
  b = mul ridx 32
  for i ulong 32
    put v_tmp_id i get v_real_id add b i
  end
end

fn vom_tmp_from_subj ridx ulong to void
  b = mul ridx 32
  for i ulong 32
    put v_tmp_id i get v_real_subj_id add b i
  end
end

note ---------------- session lookups (om_entry, om_program, om_find_real_for) ----------------

fn vom_entry_a to long
  if eq get vcall_has_a 0 0
    ret -1
  end
  if ne get vcall_a_kind 0 V_BIND_REALIZATION
    ret -1
  end
  ix = get vcall_a_idx 0
  if not vom_idx_ok ix get v_real_cnt 0
    ret -1
  end
  ret ix
end

fn vom_prog_a to long
  if eq get vcall_has_a 0 0
    ret -1
  end
  if ne get vcall_a_kind 0 V_BIND_PROGRAM
    ret -1
  end
  ix = get vcall_a_idx 0
  if lt ix 0
    ret -1
  end
  if ge ulong ix get v_prog_cnt 0
    ret -1
  end
  ret ix
end

note First (earliest) session realization whose subject is v_tmp_id, or -1.
fn vom_find_real_for_tmp to long
  for i ulong get v_real_cnt 0 bound 16
    b = mul i 32
    same = true
    for j ulong 32
      if ne get v_real_subj_id add b j get v_tmp_id j
        same = false
        break
      end
    end
    if same
      ret long i
    end
  end
  ret -1
end

note ---------------- realization adapters (src/visor/visor_realization.om) ----------------
note Session machine = machine graph VRL_SMG; staging entry VRL_SE / view VRL_SV;
note alternatives use entries/views 16..19, compare/why views 20 and 21.

const VOM_ALT_E ulong 16
const VOM_VA ulong 20
const VOM_VB ulong 21

text vom_m_tfull "too many realizations in this session"

note The realization's why (vrs_why) into err; a full session table is reported the
note way om_add_entry reports it.
fn vom_rl_why_to_err to void
  wl = get vrs_wlen 0
  if eq wl 0
    ve_puts vom_m_realfail
    ret
  end
  full = eq wl len vom_m_tfull
  if full
    for i ulong wl bound 64
      if ne get vrs_why i get vom_m_tfull i
        full = false
      end
    end
  end
  if full
    ve_puts vom_m_full
    ret
  end
  for i ulong wl bound 256
    ve_putc get vrs_why i
  end
end

note visor_realize_program + om_add_entry. Returns the entry index, or -1 (err set).
fn vom_rl_realize_prog pidx ulong to long
  rc = vrs_realize_program pidx
  if lt rc 0
    vom_rl_why_to_err
    ret -1
  end
  ret rc
end

note visor_realize_apply on v_tmp_id (any id; the lane reports a missing one) + om_add_entry.
fn vom_rl_realize_apply to long
  if ne vrl_realize_apply VRL_SMG VRL_SE VRL_SV 0
    vrs_why_view VRL_SV
    vom_rl_why_to_err
    ret -1
  end
  rc = vrs_store
  if lt rc 0
    vom_rl_why_to_err
    ret -1
  end
  ret rc
end

note om_realization_show: the entry's view, rendered.
fn vom_rl_show ridx ulong to long
  if ne vrl_view ridx VRL_SMG VRL_SV 0
    ve_puts vom_m_view
    ret 1
  end
  if ne get vcall_json 0 0
    ret vom_put_ob_body vrl_format_json VRL_SV 65536
  end
  ret vom_put_ob_body vrl_format_text VRL_SV 65536
end

fn vom_rl_cost ridx ulong to long
  if ne vrl_cost ridx VRL_SMG VRL_SV 0
    ve_puts vom_m_costna
    ret 1
  end
  if ne get vcall_json 0 0
    ret vom_put_ob_body vrl_cost_format_json VRL_SV 65536
  end
  ret vom_put_ob_body vrl_cost_format_text VRL_SV 65536
end

note visor_realization_view(..).runnable for the run gate (why in vrs_why).
fn vom_rl_runnable ridx ulong to bool
  put vrs_wlen 0 0
  if ne vrl_view ridx VRL_SMG VRL_SV 0
    ret false
  end
  vrs_why_view VRL_SV
  ret ne vrv_g VRL_SV VW_RUN 0
end

note om_realization_for: entry, else an existing one for the subject, else (create) a new one.
fn vom_realization_for create bool to long
  e = vom_entry_a
  if ge e 0
    ret e
  end
  k = get vcall_a_kind 0
  if or eq get vcall_has_a 0 0 and ne k V_BIND_OBJECT ne k V_BIND_PROGRAM
    ve_puts vom_m_nrop
    ret -1
  end
  vcall_a_to_tmp
  ex = vom_find_real_for_tmp
  if ge ex 0
    ret ex
  end
  if not create
    ve_puts vom_m_noreal1
    for i ulong get vcall_a_nlen 0 bound 64
      ve_putc get vcall_a_name i
    end
    ve_puts vom_m_noreal2
    for i ulong get vcall_a_nlen 0 bound 64
      ve_putc get vcall_a_name i
    end
    ve_puts vom_m_noreal3
    ret -1
  end
  if eq k V_BIND_PROGRAM
    p = vom_prog_a
    if lt p 0
      ve_puts vom_m_noprog
      ret -1
    end
    ret vom_rl_realize_prog ulong p
  end
  ret vom_rl_realize_apply
end

note ---------------- program summary / realization show ----------------

fn vom_program_summary p ulong to long
  vom_tmp_from_prog p
  nb = mul p 64
  nl = get v_prog_nlen p
  real = ne get v_prog_realized p 0
  cl = ulong 0
  if real
    cl = get v_prog_clen p
  end
  if ne get vcall_json 0 0
    vb_puts vom_j_prog
    vb_putc uchar 34
    for i ulong nl bound 64
      vb_json_byte ulong get v_prog_name add nb i
    end
    vb_putc uchar 34
    vb_puts vom_j_contract
    vb_put_id_tmp
    vb_puts vom_j_isreal
    vom_tf_vb real
    vb_puts vom_j_isver
    vom_tf_vb ne get v_prog_verified p 0
    vb_puts vom_j_clen
    vb_put_u64 cl
    vb_putc uchar 125
  else
    vb_puts vom_t_progh
    for i ulong nl bound 64
      vb_putc get v_prog_name add nb i
    end
    vb_puts vom_t_contract
    vb_put_id_tmp
    vb_puts vom_t_isreal
    vom_tf_vb real
    vb_puts vom_t_isver
    vom_tf_vb ne get v_prog_verified p 0
    vb_puts vom_t_clen
    vb_put_u64 cl
    vb_putc uchar 10
  end
  ret 0
end

note om_nonobject: PROGRAM and REALIZATION subjects. Returns -1 when not handled.
fn vom_nonobject to long
  p = vom_prog_a
  if ge p 0
    ret vom_program_summary ulong p
  end
  e = vom_entry_a
  if ge e 0
    ret vom_rl_show ulong e
  end
  ret -1
end

note ---------------- hooks ----------------

fn vom_inspect to long
  nr = vom_nonobject
  if ge nr 0
    ret nr
  end
  vcall_a_to_tmp
  ir = vsem_inspect_tmp
  if eq ir -1
    ve_puts vom_m_nograph
    ret 1
  end
  fr = long 0
  if ne get vcall_json 0 0
    fr = vsem_format_json 65536
  else
    fr = vsem_format_text 65536
  end
  if ne vom_put_ob_body fr 0
    ret 1
  end
  if eq ir -2
    ve_puts vom_m_mal
    for i ulong get vsem_v_rsl 0 bound 256
      ve_putc get vsem_v_rs i
    end
    ret 2
  end
  ret 0
end

fn vom_type_of to long
  nr = vom_nonobject
  if ge nr 0
    ret nr
  end
  vcall_a_to_tmp
  tr = vsem_type_of_tmp
  if eq tr -2
    ve_puts vom_m_mal2
    ret 1
  end
  if ne tr 0
    ve_puts vom_m_notype
    ret 1
  end
  ob_reset 65535
  vsem_put_tr 40
  if ne get vcall_json 0 0
    vb_puts vom_j_type
    vb_json_ob
    vb_puts vom_j_tid
    vb_put_id_tmp
    vb_puts vom_j_q
  else
    vb_put_ob
    vb_putc uchar 10
  end
  ret 0
end

fn vom_id_object to long
  vcall_a_to_tmp
  if eq vsem_inspect_tmp -1
    ve_puts vom_m_nograph
    ret 1
  end
  vcall_a_to_tmp
  isj = ne get vcall_json 0 0
  if isj
    vb_puts vom_j_obj
    vb_put_id_tmp
    vb_puts vom_j_clen2
  else
    vb_put_id_tmp
    vb_puts vom_t_clen2
  end
  vb_put_u64 get vsem_v_clen 0
  if isj
    vb_puts vom_j_csha
  else
    vb_puts vom_t_csha
  end
  for i ulong 32
    b = ulong get vsem_v_csha i
    vb_putc get vcon_hx shr b 4
    vb_putc get vcon_hx and b 15
  end
  if isj
    vb_puts vom_j_q
  else
    vb_putc uchar 10
  end
  ret 0
end

fn vom_id_of to long
  if eq get vcall_a_kind 0 V_BIND_OBJECT
    ret vom_id_object
  end
  isj = ne get vcall_json 0 0
  p = vom_prog_a
  if ge p 0
    pu = ulong p
    vom_tmp_from_prog pu
    if isj
      vb_puts vom_j_pid
    else
      vb_puts vom_t_pid
    end
    vb_put_id_tmp
    if isj
      vb_puts vom_j_rid
    else
      vb_puts vom_t_rid
    end
    if ne get v_prog_realized pu 0
      b = mul pu 32
      for i ulong 32
        put v_tmp_id i get v_prog_real_id add b i
      end
      vb_put_id_tmp
    else
      vb_puts vom_t_none
    end
    if isj
      vb_puts vom_j_q
    else
      vb_putc uchar 10
    end
    ret 0
  end
  e = vom_entry_a
  if ge e 0
    eu = ulong e
    vom_tmp_from_real eu
    if isj
      vb_puts vom_j_rrid
    else
      vb_puts vom_t_rrid
    end
    vb_put_id_tmp
    vom_tmp_from_subj eu
    if isj
      vb_puts vom_j_sid
    else
      vb_puts vom_t_sid
    end
    vb_put_id_tmp
    if isj
      vb_puts vom_j_q
    else
      vb_putc uchar 10
    end
    ret 0
  end
  ve_puts vom_m_nothing
  ret 1
end

fn vom_graph to long
  if eq get vcall_has_a 0 0
    ve_puts vom_m_graph0
    ret 1
  end
  nr = vom_nonobject
  if ge nr 0
    ret nr
  end
  vcall_a_to_tmp
  if lt vsem_graph_text_tmp 65536 0
    ve_puts vom_m_graphna
    ret 1
  end
  if ne get vcall_json 0 0
    vb_puts vom_j_graph
    vb_json_ob
    vb_putc uchar 125
  else
    vb_put_ob
  end
  ret 0
end

note omega_language_type_text of the let's declared type.
fn vom_let_type_vv to void
  if eq get opr_lttag 0 V_TY_BOOL
    vv_puts vom_t_bool
    ret
  end
  vv_puts vom_t_u
  vv_put_u64 get opr_ltwid 0
end

fn vom_eval to long
  ll = get vpc_llen 0
  for i ulong ll bound 4096
    put v_sbuf i get vpc_line i
  end
  if lt olw_eval_sbuf ll 0
    el = get olx_elen 0
    for i ulong el bound 256
      ve_putc get olx_err i
    end
    if eq el 0
      ve_puts vom_m_lang
    end
    ret 1
  end
  st = get opr_stmt 0
  if eq st 0
    put vcall_ev_kind 0 V_BIND_NONE
    ret 0
  end
  for i ulong 32
    put vcall_ev_id i get v_last_id i
  end
  put vcall_ev_idx 0 get v_last_idx 0
  if eq st 3
    put vcall_ev_kind 0 V_BIND_PROGRAM
    vv_puts vom_t_fn
    nl = get opr_nlen 0
    for i ulong nl bound 64
      vv_putc get opr_name i
    end
    vv_puts vom_t_fnty
    ret 0
  end
  put vcall_ev_kind 0 V_BIND_OBJECT
  put vcall_ev_idx 0 -1
  for i ulong 32
    put v_tmp_id i get vcall_ev_id i
  end
  er = vsem_eval_u64_tmp
  if eq er 0
    vv_put_u64 get vsem_val 0
    ret 0
  end
  if eq st 2
    vom_let_type_vv
    ret 0
  end
  vv_puts vom_t_unev1
  if eq er -2
    vv_puts vom_t_unev_mal
  else
    if eq er -3
      vv_puts vom_t_unev_ref
    else
      vv_puts vom_t_unev_uns
    end
  end
  vv_puts vom_t_gt
  ret 0
end

fn vom_machine to long
  if eq get vom_has_mach 0 0
    ve_puts vom_m_nomach
    ret 1
  end
  note visor_machine_view(&s->machine, &om_mv): session graph 0 -> view 0.
  if ne vmch_view 0 0 0
    ve_puts vom_m_mview
    ret 1
  end
  if ne get vcall_json 0 0
    ret vom_put_ob_body vmch_format_json 65536
  end
  ret vom_put_ob_body vmch_format_text 65536
end

fn vom_realize to long
  have = vom_entry_a
  if ge have 0
    ret vom_rl_show ulong have
  end
  idx = long -1
  if eq get vcall_a_kind 0 V_BIND_PROGRAM
    p = vom_prog_a
    if lt p 0
      ve_puts vom_m_noprog
      ret 1
    end
    idx = vom_rl_realize_prog ulong p
  else
    vcall_a_to_tmp
    idx = vom_rl_realize_apply
  end
  if lt idx 0
    ret 1
  end
  iu = ulong idx
  vom_tmp_from_real iu
  vs_set_last V_BIND_REALIZATION idx
  ret vom_rl_show iu
end

fn vom_cost to long
  e = vom_realization_for false
  if lt e 0
    ret 1
  end
  ret vom_rl_cost ulong e
end

note om_parse_u64 (strtoull base 0, whole token, no sign) of argument idx into vom_args[slot].
fn vom_parse_u64 idx ulong slot ulong to long
  al = get vpc_alen idx
  base = mul idx 256
  if eq al 0
    ret -1
  end
  c0 = ulong get vpc_args base
  if or eq c0 45 eq c0 43
    ret -1
  end
  radix = ulong 10
  p = ulong 0
  if eq c0 48
    radix = 8
    if gt al 1
      c1 = ulong get vpc_args add base 1
      if or eq c1 120 eq c1 88
        if gt al 2
          radix = 16
          p = 2
        end
      end
    end
  end
  v = ulong 0
  while lt p al bound 256
    c = ulong get vpc_args add base p
    d = ulong 99
    if and ge c 48 le c 57
      d = sub c 48
    end
    if and ge c 97 le c 102
      d = sub c 87
    end
    if and ge c 65 le c 70
      d = sub c 55
    end
    if ge d radix
      ret -1
    end
    if gt v div sub ulong 0xffffffffffffffff d radix
      ret -1
    end
    v = add mul v radix d
    p = add p 1
  end
  put vom_args slot v
  ret 0
end

fn vom_tok_to_err to void
  ve_put_arg 0
end

note `run <x> [args]`: argument counts are checked before anything is realized or run.
fn vom_run_counts k ulong to long
  vcall_a_to_tmp
  if ne vsem_apply_parts_tmp 0
    vom_tok_to_err
    ve_puts vom_m_napply
    ret -1
  end
  n = get vsem_ap_cnt 0
  if gt n 3
    vom_tok_to_err
    ve_puts vom_m_has
    ve_put_u64 n
    ve_puts vom_m_atmost
    ret -1
  end
  for i ulong mul n 32 bound 128
    put vom_ap_ops i get vsem_ap_ops i
  end
  put vom_ap_n 0 n
  if and ne k 0 ne k n
    vom_tok_to_err
    ve_puts vom_m_takes
    ve_put_u64 n
    ve_puts vom_m_got
    ve_put_u64 k
    ve_puts vom_m_none
    ve_put_u64 n
    ve_puts vom_m_rpar
    ret -1
  end
  ret long n
end

note k == 0: operand values from the graph.
fn vom_run_operands n ulong to long
  for i ulong n bound 4
    b = mul i 32
    for j ulong 32
      put v_tmp_id j get vom_ap_ops add b j
    end
    ok = false
    if eq vsem_value_u64_tmp 0
      ok = true
    else
      for j ulong 32
        put v_tmp_id j get vom_ap_ops add b j
      end
      ok = eq vsem_eval_u64_tmp 0
    end
    if not ok
      ve_puts vom_m_opnd
      ve_put_u64 add i 1
      ve_puts vom_m_of
      vom_tok_to_err
      ve_puts vom_m_noval
      ve_put_u64 n
      ve_puts vom_m_cmdl
      ret -1
    end
    put vom_args i get vsem_val 0
  end
  ret 0
end

note What is run: 1 = a program (exactly 1 input), 0 = an apply; -1 error.
fn vom_run_what to long
  if eq get vcall_a_kind 0 V_BIND_PROGRAM
    if lt vom_prog_a 0
      ve_puts vom_m_noprog
      ret -1
    end
    ret 1
  end
  e = vom_entry_a
  if ge e 0
    eu = ulong e
    if ne get v_real_is_prog eu 0
      pi = get v_real_pidx eu
      if not vom_idx_ok pi get v_prog_cnt 0
        ve_puts vom_m_rprog
        ret -1
      end
      ret 1
    end
    vom_tmp_from_subj eu
    for i ulong 32
      put vcall_a_id i get v_tmp_id i
    end
    ret 0
  end
  if eq get vcall_a_kind 0 V_BIND_OBJECT
    ret 0
  end
  ve_puts vom_m_nrop
  ret -1
end

fn vom_prog_name_err to void
  p = long -1
  if eq get vcall_a_kind 0 V_BIND_PROGRAM
    p = get vcall_a_idx 0
  else
    p = get v_real_pidx ulong get vcall_a_idx 0
  end
  pu = ulong p
  nb = mul pu 64
  for i ulong get v_prog_nlen pu bound 64
    ve_putc get v_prog_name add nb i
  end
end

fn vom_run_exec n ulong to long
  e = vom_realization_for true
  if lt e 0
    ret 1
  end
  eu = ulong e
  rc = vrs_run eu get vom_args 0 get vom_args 1 get vom_args 2 n
  if ne rc 0
    put vrs_wlen 0 0
    if eq rc -3
      if eq vrl_view eu VRL_SMG VRL_SV 0
        vrs_why_view VRL_SV
      end
    end
    if gt get vrs_wlen 0 0
      ve_puts vom_m_refused
      for i ulong get vrs_wlen 0 bound 256
        ve_putc get vrs_why i
      end
    else
      ve_puts vom_m_refrc
      vom_put_long_err rc
      ve_puts vom_m_rpar
    end
    ret 1
  end
  if ne get vcall_json 0 0
    vb_puts vom_j_result
    vb_put_u64 get vrl_run_out 0
    vb_puts vom_j_realz
    vom_tmp_from_real eu
    vb_put_id_tmp
    vb_puts vom_j_q
  else
    vb_put_u64 get vrl_run_out 0
    vb_putc uchar 10
  end
  ret 0
end

fn vom_run to long
  argc = get vpc_argc 0
  k = ulong 0
  if gt argc 0
    k = sub argc 1
  end
  for i ulong 32
    put vom_id2 i get vcall_a_id i
  end
  what = vom_run_what
  if lt what 0
    ret 1
  end
  n = ulong 1
  if eq what 1
    if eq k 0
      ve_puts vom_m_prog1
      vom_prog_name_err
      ve_puts vom_m_prog2
      ret 1
    end
    if ne k 1
      ve_puts vom_m_prog1
      vom_prog_name_err
      ve_puts vom_m_prog3
      ve_put_u64 k
      ret 1
    end
  else
    nc = vom_run_counts k
    for i ulong 32
      put vcall_a_id i get vom_id2 i
    end
    if lt nc 0
      ret 1
    end
    n = ulong nc
    if eq k 0
      vcall_a_to_tmp
      if lt vom_run_operands n 0
        ret 1
      end
    end
  end
  for i ulong k bound 3
    if lt vom_parse_u64 add i 1 i 0
      ve_puts vom_m_arg
      ve_put_u64 add i 1
      ve_puts vom_m_spq
      ve_put_arg add i 1
      ve_puts vom_m_nu64
      ret 1
    end
  end
  ret vom_run_exec n
end

note om_evidence: root = --evidence-root or "evidence".
fn vom_ev_root to ulong
  if eq get vcon_has_evroot 0 0
    ret vev_root_txt vom_t_evdef
  end
  rl = get vcon_evlen 0
  for i ulong rl bound 4096
    put vev_root i get vcon_evroot i
  end
  ret rl
end

fn vom_evidence to long
  rl = vom_ev_root
  rc = long 0
  if eq get vpc_argc 0 0
    rc = vev_scan rl
  else
    if eq vcall_resolve_arg 0 0
      for i ulong 32
        put vev_qid i get v_res_id i
      end
    else
      al = get vpc_alen 0
      for i ulong al bound 256
        put v_sbuf i get vpc_args i
      end
      if ne v_parse_hex_sbuf al 0
        ve_puts vom_m_unkid
        ve_put_arg 0
        ve_puts vom_m_sp
        ret 1
      end
      for i ulong 32
        put vev_qid i get v_tmp_id i
      end
    end
    rc = vev_for_id rl
  end
  if ne rc 0
    ve_puts vom_m_evroot
    for i ulong rl bound 4096
      ve_putc get vev_root i
    end
    ve_puts vom_m_evroot2
    ret 1
  end
  if ne get vcall_json 0 0
    ret vom_put_ob_body vev_format_json 65536
  end
  ret vom_put_ob_body vev_format_text 65536
end

fn vom_world to long
  vwld_unattached
  if ne get vcall_json 0 0
    ret vom_put_ob_body vwld_format_json 65536
  end
  ret vom_put_ob_body vwld_format_text 65536
end

note One effect object (index oi) -> request view. 0 ok, 1 refused, -1 output too large.
fn vom_effect_one oi ulong first bool to long
  isj = ne get vcall_json 0 0
  og_tmp_from_obj oi
  if and isj not first
    vb_putc uchar 44
  end
  if ne verq_build oi 0
    og_tmp_from_obj oi
    if isj
      vb_puts vom_j_refid
      vb_put_id_tmp
      vb_puts vom_j_refm
    else
      vb_put_id_tmp
      vb_puts vom_t_refm
    end
    ret 1
  end
  fr = long 0
  if isj
    fr = verq_format_json 65536
  else
    fr = verq_format_text 65536
  end
  if lt fr 0
    ve_puts vom_m_big
    ret -1
  end
  vb_put_ob
  n = get v_ob_len 0
  if and not isj gt n 0
    if ne get v_ob sub n 1 10
      vb_putc uchar 10
    end
  end
  ret 0
end

fn vom_effects to long
  if ne get vcall_has_a 0 0
    oi = long -1
    if eq get vcall_a_kind 0 V_BIND_OBJECT
      vcall_a_to_tmp
      oi = og_find_by_tmp
    end
    ok = ge oi 0
    if ok
      ok = eq get v_og_kind ulong oi V_KIND_EFFECT
    end
    if not ok
      ve_putc uchar 39
      ve_put_arg 0
      ve_puts vom_m_noteff
      ret 1
    end
    r = vom_effect_one ulong oi true
    if lt r 0
      ret 1
    end
    if gt r 0
      ve_puts vom_m_effref
      ret 2
    end
    ret 0
  end
  isj = ne get vcall_json 0 0
  if isj
    vb_putc uchar 91
  end
  shown = ulong 0
  for i ulong get v_og_cnt 0 bound 256
    if eq get v_og_kind i V_KIND_EFFECT
      if lt vom_effect_one i eq shown 0 0
        ret 1
      end
      shown = add shown 1
    end
  end
  if isj
    vb_putc uchar 93
  else
    if eq shown 0
      vb_puts vom_t_noeffs
    end
  end
  ret 0
end

note `run` gate: anything not provably pure is an effect request (fail closed).
fn vom_classify to long
  put vcall_cls 0 VCON_CL_EFF
  if eq get vcall_a_kind 0 V_BIND_PROGRAM
    put vcall_cls 0 VCON_CL_PURE
    vr_puts vom_r_prog
    ret 0
  end
  vcall_a_to_tmp
  e = vom_entry_a
  if ge e 0
    eu = ulong e
    if not vom_rl_runnable eu
      wl = get vrs_wlen 0
      if gt wl 0
        for i ulong wl bound 256
          put vcon_rsn i get vrs_why i
        end
        if gt wl VCON_RSN_MAX
          wl = VCON_RSN_MAX
        end
        put vcon_rlen 0 wl
      else
        vr_puts vom_r_notrun
      end
      ret 0
    end
    if ne get v_real_is_prog eu 0
      put vcall_cls 0 VCON_CL_PURE
      vr_puts vom_r_preal
      ret 0
    end
    vom_tmp_from_subj eu
  end
  oi = og_find_by_tmp
  if lt oi 0
    vr_puts vom_r_miss
    ret 0
  end
  if ne verq_classify ulong oi 0
    vr_puts vom_r_miss
    ret 0
  end
  if ne get verq_needs 0 0
    vr_puts vom_r_eff
    ret 0
  end
  put vcall_cls 0 VCON_CL_PURE
  vr_puts vom_r_pure
  ret 0
end

global vom_buf2 uchar 65536
global vom_b2len ulong 1
global vom_sv_kind ulong 1
global vom_sv_idx long 1
global vom_sv_id uchar 32
global vom_sv_name uchar 64
global vom_sv_nlen ulong 1

text vom_j_label "{\"label\":"
text vom_j_vrid ",\"realization_id\":"
text vom_j_runn ",\"runnable\":"
text vom_j_comp ",\"compatible\":"
text vom_j_added ",\"added\":"
text vom_j_cost ",\"cost\":"
text vom_t_incomp "  (incompatible; not added to session)"
text vom_t_sep2 "  "
text vom_j_cmp "{\"comparison\":"
text vom_j_why "{\"why\":"

note View string field f of view v as text, or (json) as a JSON string.
fn vom_vstr_vb v ulong f ulong json bool to void
  n = vrv_len v f
  b = add mul v VRL_VSTR vrv_off f
  if json
    vb_putc uchar 34
    for i ulong n bound 4096
      vb_json_byte ulong get vrv_str add b i
    end
    vb_putc uchar 34
  else
    for i ulong n bound 4096
      vb_putc get vrv_str add b i
    end
  end
end

fn vom_save_ob2 to void
  n = get v_ob_len 0
  for i ulong n bound 65536
    put vom_buf2 i get v_ob i
  end
  put vom_b2len 0 n
end

fn vom_alt_one i ulong pidx long json bool to long
  e = add VOM_ALT_E i
  put vre_pidx e pidx
  vre_p e VE_SUBJP 1
  comp = ne vrv_g e VW_COMPAT 0
  if comp
    vre_copy VRL_SE e
    put vom_sink 0 vrs_store
  end
  fr = long 0
  if json
    fr = vrl_cost_format_json e 65536
  else
    fr = vrl_cost_format_text e 65536
  end
  if lt fr 0
    ve_puts vom_m_big
    ret 1
  end
  vom_save_ob2
  b2 = get vom_b2len 0
  if json
    if gt i 0
      vb_putc uchar 44
    end
    vb_puts vom_j_label
    vom_vstr_vb e VF_LABEL true
    vb_puts vom_j_vrid
    vom_vstr_vb e VF_RID true
    vb_puts vom_j_runn
    vom_tf_vb ne vrv_g e VW_RUN 0
    vb_puts vom_j_comp
    vom_tf_vb comp
    vb_puts vom_j_added
    vom_tf_vb comp
    vb_puts vom_j_cost
    for k ulong b2 bound 65536
      vb_putc get vom_buf2 k
    end
    vb_putc uchar 125
  else
    vom_vstr_vb e VF_LABEL false
    vb_puts vom_t_sep2
    vom_vstr_vb e VF_RID false
    if not comp
      vb_puts vom_t_incomp
    end
    vb_putc uchar 10
    for k ulong b2 bound 65536
      vb_putc get vom_buf2 k
    end
    if gt b2 0
      if ne get vom_buf2 sub b2 1 10
        vb_putc uchar 10
      end
    end
  end
  ret 0
end

fn vom_alternatives to long
  pidx = long -1
  p = vom_prog_a
  if ge p 0
    pidx = p
  end
  e = vom_entry_a
  if ge e 0
    if ne get v_real_is_prog ulong e 0
      pidx = get v_real_pidx ulong e
    end
  end
  if not vom_idx_ok pidx get v_prog_cnt 0
    ve_puts vom_m_alt
    ret 1
  end
  put vom_sink 0 vrs_prog_from_session ulong pidx VRL_SP
  if ne vrl_alternatives_ex VRL_SP VRL_SMG VOM_ALT_E VOM_ALT_E 4 0
    ve_puts vom_m_altna
    ret 1
  end
  json = ne get vcall_json 0 0
  if json
    vb_putc uchar 91
  end
  for i ulong get vrl_cnt 0 bound 4
    if ne vom_alt_one i pidx json 0
      ret 1
    end
  end
  if json
    vb_putc uchar 93
  end
  ret 0
end

note om_view_for(subject a) into view v.
fn vom_view_for v ulong to long
  e = vom_realization_for false
  if lt e 0
    ret 1
  end
  if ne vrl_view ulong e VRL_SMG v 0
    ve_puts vom_m_view
    ret 1
  end
  ret 0
end

note Swap subject a and subject b (compare's second subject).
fn vom_swap_ab to void
  put vom_sv_kind 0 get vcall_a_kind 0
  put vom_sv_idx 0 get vcall_a_idx 0
  put vom_sv_nlen 0 get vcall_a_nlen 0
  for i ulong 32
    put vom_sv_id i get vcall_a_id i
  end
  for i ulong 64
    put vom_sv_name i get vcall_a_name i
  end
  put vcall_a_kind 0 get vcall_b_kind 0
  put vcall_a_idx 0 get vcall_b_idx 0
  put vcall_a_nlen 0 get vcall_b_nlen 0
  for i ulong 32
    put vcall_a_id i get vcall_b_id i
  end
  for i ulong 64
    put vcall_a_name i get vcall_b_name i
  end
  put vcall_b_kind 0 get vom_sv_kind 0
  put vcall_b_idx 0 get vom_sv_idx 0
  put vcall_b_nlen 0 get vom_sv_nlen 0
  for i ulong 32
    put vcall_b_id i get vom_sv_id i
  end
  for i ulong 64
    put vcall_b_name i get vom_sv_name i
  end
  hb = get vcall_has_b 0
  put vcall_has_b 0 get vcall_has_a 0
  put vcall_has_a 0 hb
end

fn vom_text_or_json_ob key view uchar * to void
  if ne get vcall_json 0 0
    vb_puts key
    vb_json_ob
    vb_putc uchar 125
  else
    vb_put_ob
  end
end

fn vom_compare to long
  if ne vom_view_for VOM_VA 0
    ret 1
  end
  vom_swap_ab
  r = vom_view_for VOM_VB
  vom_swap_ab
  if ne r 0
    ret 1
  end
  if lt vrl_compare VOM_VA VOM_VB 65536 0
    ve_puts vom_m_big
    ret 1
  end
  vom_text_or_json_ob vom_j_cmp
  ret 0
end

fn vom_why to long
  if ne vom_view_for VOM_VA 0
    ret 1
  end
  if lt vrl_why VOM_VA 65536 0
    ve_puts vom_m_big
    ret 1
  end
  vom_text_or_json_ob vom_j_why
  ret 0
end

note ---- verify <x> (tools/omega.c om_verify); verify lane slots as the verify fork's
note console call site: realization slot 0, session machine graph slot 0 ----

note realization object e of the realization lab store -> verify slot (RealizationObject)
fn vom_vro e ulong slot ulong to void
  cl = vro_g e VRO_CLEN
  put vver_rclen slot cl
  put vver_rprof slot vro_g e VRO_PROF
  put vver_rent slot vro_g e VRO_EOFF
  put vver_rhid slot vro_g e VRO_HASID
  put vver_rhm slot vro_g e VRO_HASM
  n = cl
  if gt n VVER_CB
    n = VVER_CB
  end
  cb = mul slot VVER_CB
  eb = mul e 4096
  for i ulong n bound 4096
    put vver_rcode add cb i get vro_code add eb i
  end
  sb = mul slot 32
  for i ulong 32
    put vver_rsem add sb i get vro_id add vro_ib e VRO_K_SEM i
    put vver_rrid add sb i get vro_id add vro_ib e VRO_K_RID i
    put vver_rmid add sb i get vro_id add vro_ib e VRO_K_MACH i
  end
end

note om_find_real_for(subject a id): first session realization of it, or -1
fn vom_vfind to long
  for r ulong get v_real_cnt 0 bound 16
    hit = true
    for i ulong 32
      if ne get vre_ids add vre_ib r 0 i get vcall_a_id i
        hit = false
        break
      end
    end
    if hit
      ret long r
    end
  end
  ret -1
end

note session program pidx (the C lowering's OmegaProgram) -> vver_p_*, realization in slot 0
fn vom_vprog pidx ulong to long
  if ge pidx get v_prog_cnt 0
    ret -1
  end
  p = VRL_SP
  if lt vrs_prog_from_session pidx p 0
    ret -1
  end
  rr = vpg_realize_ex p 0
  put vver_p_real 0 vpg_g p VPG_REAL
  put vver_p_slot 0 0
  put vver_p_itag 0 vpg_g p VPG_ITAG
  put vver_p_iw 0 vpg_g p VPG_IW
  put vver_p_otag 0 vpg_g p VPG_OTAG
  put vver_p_ow 0 vpg_g p VPG_OW
  for i ulong 32
    put vver_p_id i get vpg_ids add vpg_ib p 0 i
    put vver_p_pre i get vpg_ids add vpg_ib p 1 i
    put vver_p_post i get vpg_ids add vpg_ib p 2 i
  end
  pl = vpg_tlen p 1
  for i ulong pl bound 64
    put vver_p_pt i get vpg_txt add vpg_tb p 1 i
  end
  put vver_p_ptl 0 pl
  ql = vpg_tlen p 2
  for i ulong ql bound 64
    put vver_p_qt i get vpg_txt add vpg_tb p 2 i
  end
  put vver_p_qtl 0 ql
  vom_vro p 0
  if lt rr -999
    ret -1
  end
  ret 0
end

fn vom_verify_prog pidx long to long
  vpl = long -1
  if ge pidx 0
    vpl = vom_vprog ulong pidx
  end
  if lt vpl 0
    ret vver_verify_program 0
  end
  ret vver_verify_program 1
end

note om_verify dispatch: program, realization entry, else the subject's first realization.
fn vom_verify_run to long
  p = vom_prog_a
  if ge p 0
    ret vom_verify_prog p
  end
  for i ulong 32
    put vver_qid i get vcall_a_id i
  end
  e = vom_entry_a
  if ge e 0
    r = ulong e
    if ne get v_real_is_prog r 0
      pj = get v_real_pidx r
      if vom_idx_ok pj get v_prog_cnt 0
        ret vom_verify_prog pj
      end
    end
    for i ulong 32
      put vver_qid i get vre_ids add vre_ib r 0 i
    end
    vom_vro vre_r r 0
    ret vver_verify_object 1 0 0
  end
  f = vom_vfind
  if lt f 0
    ret vver_verify_object 1 -1 0
  end
  vom_vro vre_r ulong f 0
  ret vver_verify_object 1 0 0
end

fn vom_verify to long
  if ne vom_verify_run 0
    ve_puts vom_m_vbad
    ret 1
  end
  fr = long 0
  if ne get vcall_json 0 0
    fr = vver_format_json 65536
  else
    fr = vver_format_text 65536
  end
  if ne vom_put_ob_body fr 0
    ret 1
  end
  if eq get vver_passed 0 0
    ve_puts vom_m_vfail
    vl = get vver_vlen 0
    if eq vl 0
      ve_puts vom_m_vnone
    else
      for i ulong vl bound 256
        ve_putc get vver_viol i
      end
    end
    ret 2
  end
  ret 0
end

note visor_console_default_ops: every hook is wired.
fn vom_call hid ulong to long
  if lt hid 6
    if eq hid VCON_HK_INSPECT
      ret vom_inspect
    end
    if eq hid VCON_HK_TYPE
      ret vom_type_of
    end
    if eq hid VCON_HK_ID
      ret vom_id_of
    end
    if eq hid VCON_HK_GRAPH
      ret vom_graph
    end
    if eq hid VCON_HK_VERIFY
      ret vom_verify
    end
    ret 1
  end
  if lt hid 11
    if eq hid VCON_HK_MACHINE
      ret vom_machine
    end
    if eq hid VCON_HK_REALIZE
      ret vom_realize
    end
    if eq hid VCON_HK_COST
      ret vom_cost
    end
    if eq hid VCON_HK_RUN
      ret vom_run
    end
    ret vom_evidence
  end
  if eq hid VCON_HK_WORLD
    ret vom_world
  end
  if eq hid VCON_HK_EFFECTS
    ret vom_effects
  end
  if eq hid VCON_HK_ALT
    ret vom_alternatives
  end
  if eq hid VCON_HK_COMPARE
    ret vom_compare
  end
  if eq hid VCON_HK_WHY
    ret vom_why
  end
  ret 1
end

note omega_tool_open_script: "-" is stdin (fd 0); refuses directories and anything
note that is not a regular file, pipe or character device. fd, or -1 with ve set.
text vom_s_pfx "error: --script: "
text vom_s_open "cannot open "
text vom_s_isdir " is a directory"
text vom_s_notreg " is not a regular file"
text vom_s_colon ": "
text vom_s_enoent "No such file or directory"
text vom_s_eacces "Permission denied"
text vom_s_enotdir "Not a directory"
text vom_s_eloop "Too many levels of symbolic links"
text vom_s_enametl "File name too long"
text vom_s_eother "Unknown error "
global vom_path uchar 4096
global vom_plen ulong 1
global vom_st uchar 128

fn vom_strerror e long to void
  if eq e -2
    ve_puts vom_s_enoent
    ret
  end
  if eq e -13
    ve_puts vom_s_eacces
    ret
  end
  if eq e -20
    ve_puts vom_s_enotdir
    ret
  end
  if eq e -40
    ve_puts vom_s_eloop
    ret
  end
  if eq e -36
    ve_puts vom_s_enametl
    ret
  end
  ve_puts vom_s_eother
  ve_put_u64 ulong sub 0 e
end

fn vom_put_path_err to void
  for i ulong get vom_plen 0 bound 4096
    ve_putc get vom_path i
  end
end

fn v_dec_st_mode to uint
  b0 = uint get vom_st 16
  b1 = uint get vom_st 17
  b2 = uint get vom_st 18
  b3 = uint get vom_st 19
  ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn omega_tool_open_script to long
  pl = get vom_plen 0
  if and eq pl 1 eq get vom_path 0 45
    ret 0
  end
  fd = fopen vom_path 0 pl 0 0
  if lt fd 0
    ve_puts vom_s_pfx
    ve_puts vom_s_open
    vom_put_path_err
    ve_puts vom_s_colon
    vom_strerror fd
    ret -1
  end
  sr = stat vom_path 0 pl vom_st 0 128
  mode = ulong 0
  if ge sr 0
    mode = and ulong v_dec_st_mode 61440
  end
  if eq mode 16384
    put vom_sink 0 long fclose int fd
    ve_puts vom_s_pfx
    vom_put_path_err
    ve_puts vom_s_isdir
    ret -1
  end
  if and and ne mode 32768 ne mode 4096 ne mode 8192
    put vom_sink 0 long fclose int fd
    ve_puts vom_s_pfx
    vom_put_path_err
    ve_puts vom_s_notreg
    ret -1
  end
  ret fd
end

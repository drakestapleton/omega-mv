note Run with address space limited to 8 GiB: host refusal must preserve the pool.
global p uchar *
fn main to int
r = enlarge p 4096
if ne r 0
ret 1
end
put p 0 73
r = enlarge p 1099511627776
if ne r long -12
ret 2
end
if ne len p 4096
ret 3
end
if ne get p 0 73
ret 4
end
ret 0
end
note gate-pools: uses enlarge on purpose: owner=seed/omc/tests/pools/recovered-owners.sh compile=0 run=0 as=8589934592 execute existing oracle host-refusal fixture under its documented address-space budget

note Execute under env -i TOKEN=value: exact environment bytes and short destination.
global data uchar 64
fn main to int
if ne envcnt long 1
ret 1
end
n = envread 0 data 3 61
if ne n long 11
ret 2
end
if ne get data 3 84
ret 3
end
if ne get data 13 101
ret 4
end
n = envread 0 data 0 10
if ne n long -105
ret 5
end
if ne get data 3 84
ret 6
end
ret 0
end

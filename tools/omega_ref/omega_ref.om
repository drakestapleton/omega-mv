ret l2u r
end

note ---- Runtime evaluator and executor ----

fn eval nid ulong fp ulong to ulong
k = get nd_kind nid
if eq k N_NUM
ret get nd_num nid
end
if eq k N_VAR
ret get fr_vals add fp get nd_slot nid
end
if eq k N_BIN
x = eval get nd_a nid fp
if ne get gs 28 0
ret 0
end
y = eval get nd_b nid fp
if ne get gs 28 0
ret 0
end
op = get nd_op nid
if or eq op OP_SHL eq op OP_SHR
ret shift_op op get nd_ty nid x get nd_ty get nd_b nid y
end
ret arith op get nd_ty nid x y
end
if eq k N_CMP
x = eval get nd_a nid fp
if ne get gs 28 0
ret 0
end
y = eval get nd_b nid fp
if ne get gs 28 0
ret 0
end
ret compare_op get nd_op nid get nd_ty get nd_a nid x y
end
if eq k N_NEG
x = eval get nd_a nid fp
if ne get gs 28 0
ret 0
end
t = get nd_ty nid
if tsigned t
if eq u2l x smin_l t
do_trap 1
ret 0
end
ret canon t sub ulong 0 x
end
ret canon t sub ulong 0 x
end
if eq k N_NOT
x = eval get nd_a nid fp
if ne get gs 28 0
ret 0
end
t = get nd_ty nid
if eq t T_BOOL
if eq x 0
ret 1
end
ret 0
end
ret canon t not x
end
if eq k N_CONV
x = eval get nd_a nid fp
if ne get gs 28 0
ret 0
end
ret convert_op get nd_ty nid get nd_ty get nd_a nid x
end
ret eval_ext nid fp k
end

fn eval_ext nid ulong fp ulong k ulong to ulong
if eq k N_GET
aid = aref get nd_akind nid get nd_aidx nid fp
x = eval get nd_a nid fp
if ne get gs 28 0
ret 0
end
idx = check_index get nd_ty get nd_a nid x get arr_len aid
if ne get gs 28 0
ret 0
end
ret arr_get aid idx
end
if eq k N_LEN
aid = aref get nd_akind nid get nd_aidx nid fp
ret get arr_len aid
end
if eq k N_ENLARGE
aid = aref get nd_akind nid get nd_aidx nid fp
x = eval get nd_a nid fp
if ne get gs 28 0
ret 0
end
ret eval_enlarge aid x
end
if eq k N_ENVCNT
ret ulong envcnt
end
if eq k N_ENVREAD
x = eval get nd_a nid fp
if ne get gs 28 0
ret 0
end
y = eval get nd_b nid fp
if ne get gs 28 0
ret 0
end
z = eval get nd_c nid fp
if ne get gs 28 0
ret 0
end
aid = aref get nd_akind nid get nd_aidx nid fp
ret eval_envread aid x y z
end
if or eq k N_READ eq k N_WRITE
aid = aref get nd_akind nid get nd_aidx nid fp
x = eval get nd_a nid fp
if ne get gs 28 0
ret 0
end
y = eval get nd_b nid fp
if ne get gs 28 0
ret 0
end
z = eval get nd_c nid fp
if ne get gs 28 0
ret 0
end
if eq k N_READ
ret eval_rw 1 aid x y z
end
ret eval_rw 0 aid x y z
end
if eq k N_CALL
ret eval_call nid fp
end
exit 2
end

fn eval_call_one fi ulong fp ulong asp ulong abase ulong i ulong to void
pk = get fn_pkind add mul fi 6 i
ci = add abase i
if eq pk PK_SCALAR
v = eval get ca_node ci fp
if ne get gs 28 0
ret
end
put arg_s add asp i v
put arg_a add asp i 0
else
put arg_s add asp i 0
aid = aref get ca_akind ci get ca_aidx ci fp
put arg_a add asp i aid
end
end

fn eval_call nid ulong fp ulong to ulong
fi = get nd_fn nid
np = get fn_np fi
abase = get nd_abase nid
asp = get gs 31
ensure_argst add asp np
put gs 31 add asp np
i = ulong 0
while lt i np bound 8
eval_call_one fi fp asp abase i
if ne get gs 28 0
put gs 31 asp
ret 0
end
i = add i 1
end
res = call_fn fi asp
put gs 31 asp
ret res
end

note exec_ret declared at top of file

fn exec_new sid ulong fp ulong to void
nb = mul get st_n sid tbytes get st_ety sid
ch = and add nb 15 not ulong 15
su = get gs 27
if gt add su ch STACK_BYTES
do_trap 6
ret
end
iv = eval get st_v sid fp
if ne get gs 28 0
ret
end
put gs 27 add su ch
aid = alloc_arr get st_ety sid get st_n sid 0 1
off = alloc_loc_bytes nb
put arr_off aid off
put arr_cap aid nb
n = get st_n sid
i = ulong 0
while lt i n bound INF_BOUND
arr_put aid i iv
i = add i 1
end
put fr_arrs add fp get st_slot sid aid
end

fn exec_while sid ulong fp ulong to ulong
passes = ulong 0
lim = get st_n sid
while true bound INF_BOUND
cond = eval get st_v sid fp
if ne get gs 28 0
ret C_RET
end
if eq cond 0
break
end
if ge passes lim
do_trap 4
ret C_RET
end
passes = add passes 1
c = exec_list get st_body sid fp
if ne get gs 28 0
ret C_RET
end
if eq c C_BREAK
break
end
if eq c C_RET
ret C_RET
end
end
ret C_NORMAL
end

fn exec_for sid ulong fp ulong to ulong
ck = get st_ckind sid
cnt = ulong 0
passes = ulong 0
if eq ck 0
cnt = get st_n sid
else
if eq ck 2
cnt = eval get st_v sid fp
if ne get gs 28 0
ret C_RET
end
end
end
sl = add fp get st_slot sid
put fr_vals sl 0
fty = get st_ty sid
while true bound INF_BOUND
if eq ck 1
cnt = eval get st_v sid fp
if ne get gs 28 0
ret C_RET
end
end
if eq compare_op OP_LT fty get fr_vals sl cnt 0
break
end
if ne ck 0
if ge passes LOOP_MAX
do_trap 4
ret C_RET
end
passes = add passes 1
end
c = exec_list get st_body sid fp
if ne get gs 28 0
ret C_RET
end
if eq c C_BREAK
break
end
if eq c C_RET
ret C_RET
end
nv = arith OP_ADD fty get fr_vals sl 1
if ne get gs 28 0
ret C_RET
end
put fr_vals sl nv
end
ret C_NORMAL
end

fn exec_list sid ulong fp ulong to ulong
s = sid
while ne s 0 bound INF_BOUND
k = get st_kind s
if eq k S_ASSIGN
v = eval get st_v s fp
if ne get gs 28 0
ret C_RET
end
put fr_vals add fp get st_slot s v
else
if eq k S_NEW
exec_new s fp
if ne get gs 28 0
ret C_RET
end
else
if eq k S_IF
cond = eval get st_v s fp
if ne get gs 28 0
ret C_RET
end
c = C_NORMAL
if ne cond 0
c = exec_list get st_body s fp
else
c = exec_list get st_els s fp
end
if ne get gs 28 0
ret C_RET
end
if ne c C_NORMAL
ret c
end
else
if eq k S_WHILE
c = exec_while s fp
if or ne get gs 28 0 ne c C_NORMAL
ret c
end
else
if eq k S_FOR
c = exec_for s fp
if or ne get gs 28 0 ne c C_NORMAL
ret c
end
else
c = exec_stmt_tail s fp k
if or ne get gs 28 0 ne c C_NORMAL
ret c
end
end
end
end
end
end
s = get st_next s
end
ret C_NORMAL
end

fn exec_stmt_tail s ulong fp ulong k ulong to ulong
if eq k S_BREAK
ret C_BREAK
end
if eq k S_RET
vn = get st_v s
if ne vn 0
v = eval vn fp
if ne get gs 28 0
ret C_RET
end
put exec_ret 0 v
end
ret C_RET
end
if eq k S_PUT
aid = aref get st_akind s get st_aidx s fp
idx = eval get st_v s fp
if ne get gs 28 0
ret C_RET
end
val = eval get st_v2 s fp
if ne get gs 28 0
ret C_RET
end
ci = check_index get nd_ty get st_v s idx get arr_len aid
if ne get gs 28 0
ret C_RET
end
arr_put aid ci val
ret C_NORMAL
end
if eq k S_TRAP
do_trap get st_n s
ret C_RET
end
if eq k S_EXIT
v = eval get st_v s fp
if ne get gs 28 0
ret C_RET
end
exit int and v 255
end
if eq k S_CALL
ig = eval get st_v s fp
if ne get gs 28 0
ret C_RET
end
end
ret C_NORMAL
end

fn clone_arr_view src_aid ulong pk ulong to ulong
ro = get arr_ro src_aid
if eq pk PK_VIEW
ro = 1
end
vaid = alloc_arr get arr_ety src_aid get arr_len src_aid ro get arr_space src_aid
put arr_off vaid get arr_off src_aid
put arr_cap vaid get arr_cap src_aid
ret vaid
end

fn bind_fn_params fi ulong fp ulong asp ulong to void
np = get fn_np fi
i = ulong 0
while lt i np bound 8
pk = get fn_pkind add mul fi 6 i
if eq pk PK_SCALAR
put fr_vals add fp i get arg_s add asp i
else
put fr_arrs add fp i clone_arr_view get arg_a add asp i pk
end
i = add i 1
end
end

fn call_fn fi ulong asp ulong to ulong
ch = ulong 0
if ne get fn_hascall fi 0
ch = 16
end
saved_su = get gs 27
if ne get gs 8 0
if gt add saved_su ch STACK_BYTES
do_trap 6
ret 0
end
end
put gs 27 add saved_su ch
saved_loc = get gs 26
saved_narrs = get gs 24
fp = get gs 30
ns = get fn_nslots fi
ensure_fr add fp add ns 1
put gs 30 add fp add ns 1
i = ulong 0
while lt i ns bound INF_BOUND
put fr_vals add fp i 0
put fr_arrs add fp i 0
i = add i 1
end
bind_fn_params fi fp asp
put exec_ret 0 0
ig = exec_list get fn_body fi fp
res = get exec_ret 0
put gs 30 fp
put gs 26 saved_loc
put gs 24 saved_narrs
put gs 27 saved_su
ret res
end

note ---- Driver: load file, check, run, call ----

fn load_prog arg_idx ulong to void
n = argread arg_idx arg_buf 0 4095
if lt n 1
die_io
end
fd = fopen arg_buf 0 ulong n 524288 0
if lt fd 0
die_io
end
slen = ulong 0
while true bound INF_BOUND
r = read int fd io_buf 0 len io_buf
if lt r 0
ig = fclose int fd
die_io
end
if eq r 0
break
end
got = ulong r
need = add slen got
if gt need len src
nc = grow_cap len src need
er = enlarge src nc
if lt er 0
die_oom
end
end
i = ulong 0
while lt i got bound 65536
put src add slen i get io_buf i
i = add i 1
end
slen = need
end
ig = fclose int fd
put gs 0 slen
end

fn load_inp arg_idx ulong to ulong
n = argread arg_idx arg_buf 0 4095
if lt n 1
die_io
end
fd = fopen arg_buf 0 ulong n 524288 0
if lt fd 0
die_io
end
ilen = ulong 0
while true bound INF_BOUND
r = read int fd io_buf 0 len io_buf
if lt r 0
ig = fclose int fd
die_io
end
if eq r 0
break
end
got = ulong r
need = add ilen got
if gt need len inp_buf
nc = grow_cap len inp_buf need
er = enlarge inp_buf nc
if lt er 0
die_oom
end
end
i = ulong 0
while lt i got bound 65536
put inp_buf add ilen i get io_buf i
i = add i 1
end
ilen = need
end
ig = fclose int fd
ret ilen
end

fn src_eq_arg off ulong un ulong to bool
j = ulong 0
while lt j un bound 64
if ne get src add off j get arg_buf j
ret false
end
j = add j 1
end
ret true
end

fn find_func_arg arg_idx ulong to ulong
n = argread arg_idx arg_buf 0 4095
if lt n 1
ret U64_MAX
end
un = ulong n
nf = get gs 5
i = ulong 0
while lt i nf bound INF_BOUND
if eq get fn_nlen i un
if src_eq_arg get fn_noff i un
ret i
end
end
i = add i 1
end
ret U64_MAX
end

note Parse signed/unsigned decimal from inp_buf[pos..end), advances pr[0]=new_pos, pr[1]=val
fn parse_inp_int pos ulong lim ulong is_sig ulong to void
p = pos
while lt p lim bound 1024
c = get inp_buf p
if and ne c 32 and ne c 9 ne c 13
break
end
p = add p 1
end
negv = ulong 0
if lt p lim
if eq get inp_buf p 45
negv = 1
p = add p 1
else
if eq get inp_buf p 43
p = add p 1
end
end
end
v = ulong 0
while lt p lim bound 64
c = get inp_buf p
if not is_digit c
break
end
v = add mul v 10 ulong sub c 48
p = add p 1
end
if ne negv 0
v = sub ulong 0 v
end
put pr 0 p
put pr 1 v
end

fn run_call_line fi ulong np ulong p0 ulong eol ulong to int
p = p0
ensure_argst np
put gs 31 np
j = ulong 0
while lt j np bound 8
pty = get fn_pty add mul fi 6 j
is_s = ulong 0
if tsigned pty
is_s = 1
end
parse_inp_int p eol is_s
p = get pr 0
val = get pr 1
if ne val canon pty val
r = write 2 msg_in_range 0 len msg_in_range
ret 2
end
put arg_s j val
put arg_a j 0
j = add j 1
end
put gs 27 0
put gs 28 0
put gs 29 0
res = call_fn fi 0
put gs 31 0
if ne get gs 28 0
r = write 1 msg_trap_pre 0 len msg_trap_pre
out_u64 get gs 29
r = write 1 msg_trap_suf 0 len msg_trap_suf
else
if tsigned get fn_ret fi
out_i64 res
else
out_u64 res
end
r = write 1 msg_hex_pre 0 len msg_hex_pre
out_hex64 res
r = write 1 msg_err_end 0 len msg_err_end
end
ret 0
end

fn do_call_mode to int
load_prog 2
parse_program
fi = find_func_arg 3
if eq fi U64_MAX
r = write 2 msg_no_fn 0 len msg_no_fn
ret 2
end
np = get fn_np fi
i = ulong 0
while lt i np bound 8
if ne get fn_pkind add mul fi 6 i PK_SCALAR
r = write 2 msg_call_arr 0 len msg_call_arr
ret 2
end
i = add i 1
end
ilen = load_inp 4
pos = ulong 0
while lt pos ilen bound INF_BOUND
eol = pos
while lt eol ilen bound INF_BOUND
if eq get inp_buf eol 10
break
end
eol = add eol 1
end
p0 = pos
if lt eol ilen
pos = add eol 1
else
pos = ilen
end
rc = run_call_line fi np p0 eol
if ne rc 0
ret rc
end
end
ret 0
end

fn main to int
ac = argcnt
if lt ac 3
r = write 2 msg_usage 0 len msg_usage
ret 2
end
n = argread 1 arg_buf 0 4095
if lt n 1
r = write 2 msg_usage 0 len msg_usage
ret 2
end
un = ulong n
if arg_eq_kw un 71
load_prog 2
parse_program
ret 0
end
if arg_eq_kw un 72
load_prog 2
put gs 2 125
parse_program
nf = get gs 5
mi = U64_MAX
i = ulong 0
while lt i nf bound INF_BOUND
if eq kw_id_of get fn_noff i get fn_nlen i 70
mi = i
break
end
i = add i 1
end
if or eq get gs 8 0 eq mi U64_MAX
r = write 2 msg_run_main 0 len msg_run_main
ret 125
end
put gs 28 0
put gs 29 0
v = call_fn mi 0
if ne get gs 28 0
ret int add 100 get gs 29
end
if eq get fn_ret mi T_VOID
ret 0
end
ret int and v 255
end
if arg_eq_kw un 73
if ne ac 5
r = write 2 msg_usage 0 len msg_usage
ret 2
end
ret do_call_mode
end
r = write 2 msg_unk_cmd 0 len msg_unk_cmd
ret 2
end

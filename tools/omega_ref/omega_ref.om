if ne c U64_MAX
ret c
end
e = get edge_next e
end
put fn_onpath f 0
ret U64_MAX
end

fn find_nl pos ulong slen ulong to ulong
i = pos
while lt i slen bound INF_BOUND
if eq get src i 10
ret i
end
i = add i 1
end
ret slen
end

fn parse_prog_pass1 to void
slen = get gs 0
pos = ulong 0
put gs 1 0
while lt pos slen bound INF_BOUND
nl = find_nl pos slen
llen = sub nl pos
loff = pos
if lt nl slen
pos = add nl 1
else
pos = slen
end
put gs 1 add get gs 1 1
nw = split_words loff llen
if eq nw 0
continue
end
if ne kw_id_of get tok_off 0 get tok_len 0 33
continue
end
if ge nw 2
if eq kw_id_of get tok_off 1 get tok_len 1 70
put gs 8 1
end
end
nf = get gs 5
ensure_fn add nf 1
put gs 4 1
parse_fn_sig nf 1
put gs 5 add nf 1
end
end

fn parse_prog_pass2 to void
slen = get gs 0
pos = ulong 0
put gs 1 0
infn = ulong 0
while lt pos slen bound INF_BOUND
nl = find_nl pos slen
llen = sub nl pos
loff = pos
if lt nl slen
pos = add nl 1
else
pos = slen
end
put gs 1 add get gs 1 1
nw = split_words loff llen
if eq nw 0
continue
end
w0_off = get tok_off 0
w0_len = get tok_len 0
k0 = kw_id_of w0_off w0_len
if eq infn 0
put gs 4 1
if eq k0 33
fs = get gs 19
put gs 19 add fs 1
parse_fn_sig fs 0
infn = 1
else
if eq k0 47
parse_global 0 loff llen
else
if eq k0 48
parse_global 1 loff llen
else
if eq k0 58
continue
else
if looks_number w0_off w0_len
parse_number w0_off w0_len
refuse 16
else
if is_name w0_off w0_len
if not is_reserved w0_off w0_len
if gt w0_len 8
refuse 13
end
end
end
refuse 16
end
end
end
end
end
continue
end
if or eq k0 33 eq k0 47
refuse 15
end
if eq k0 48
refuse 15
end
parse_statement
if ne get fn_done get gs 12 0
infn = 0
end
end
if ne infn 0
refuse 15
end
end

fn parse_program to void

used = get gs 25
if and gt cur_cap 0 eq add cur_off cur_cap used
need = add cur_off new_bytes
if gt need len mem_pool
r = enlarge mem_pool need
if lt r 0
ret l2u r
end
end
mem_zero add cur_off old_b sub new_bytes old_b
put arr_cap aid new_bytes
put arr_len aid new_elems
put gs 25 need
ret 0
end
if gt used sub U64_MAX new_bytes
ret l2u long -12
end
need = add used new_bytes
if gt need len mem_pool
r = enlarge mem_pool need
if lt r 0
ret l2u r
end
end
mem_copy used cur_off old_b
mem_zero add used old_b sub new_bytes old_b
put arr_off aid used
put arr_cap aid new_bytes
put arr_len aid new_elems
put gs 25 need
ret 0
end

fn eval_envread aid ulong x ulong y ulong z ulong to ulong
alen = get arr_len aid
if or gt z alen gt y sub alen z
do_trap 3
ret 0
end
ec = ulong envcnt
if ge x ec
do_trap 3
ret 0

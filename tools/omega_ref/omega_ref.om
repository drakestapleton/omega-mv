do_trap 3
ret 0
end
end
if ge idx alen
do_trap 3
ret 0
end
ret idx
end

fn pool_ld_u8 sp ulong off ulong to ulong
if eq sp 0
ret ulong get mem_pool off
end
ret ulong get loc_pool off
end

fn pool_st_u8 sp ulong off ulong v uchar to void
if eq sp 0
put mem_pool off v
else
put loc_pool off v
end
end

fn pool_ld_u32 sp ulong base ulong to ulong
v = pool_ld_u8 sp base
v = or v shl pool_ld_u8 sp add base 1 8
v = or v shl pool_ld_u8 sp add base 2 16
v = or v shl pool_ld_u8 sp add base 3 24
ret v
end

fn arr_get aid ulong idx ulong to ulong
ety = get arr_ety aid
tb = tbytes ety
base = add get arr_off aid mul idx tb
sp = get arr_space aid
v = ulong 0
if eq tb 1
v = pool_ld_u8 sp base
else
if eq tb 2
v = or pool_ld_u8 sp base shl pool_ld_u8 sp add base 1 8
else
if eq tb 4
v = pool_ld_u32 sp base
else
lo = pool_ld_u32 sp base
hi = pool_ld_u32 sp add base 4
v = or lo shl hi 32
end
end
end
ret canon ety v
end

fn arr_put aid ulong idx ulong v ulong to void
ety = get arr_ety aid
tb = tbytes ety
base = add get arr_off aid mul idx tb
sp = get arr_space aid
pool_st_u8 sp base uchar and v 255
if ge tb 2
pool_st_u8 sp add base 1 uchar and shr v 8 255
end
if ge tb 4
pool_st_u8 sp add base 2 uchar and shr v 16 255
pool_st_u8 sp add base 3 uchar and shr v 24 255
end
if eq tb 8
pool_st_u8 sp add base 4 uchar and shr v 32 255
pool_st_u8 sp add base 5 uchar and shr v 40 255
pool_st_u8 sp add base 6 uchar and shr v 48 255
pool_st_u8 sp add base 7 uchar and shr v 56 255
end
end

note ---- Runtime arithmetic, shifts, comparisons, conversions ----

fn check_srange t ulong r long to ulong
if or lt r smin_l t gt r smax_l t
do_trap 1
ret 0
end
ret canon t l2u r
end

fn smul_ovf a long b long to bool
if or eq a 0 eq b 0
ret false
end
if and eq a long -9223372036854775808 eq b long -1
ret true
end
if and eq b long -9223372036854775808 eq a long -1
ret true
end
au = l2u a
bu = l2u b
if lt a 0
au = sub ulong 0 au
end
if lt b 0
bu = sub ulong 0 bu
end
if gt au div I64_MIN_MAG bu
ret true
end
prod = mul au bu
neg_res = ne lt a 0 lt b 0
if neg_res
ret gt prod I64_MIN_MAG
end
ret gt prod I64_MAX_U
end

fn arith_s op ulong t ulong x ulong y ulong to ulong
a = u2l x
b = u2l y
if eq op OP_ADD
if gt b 0
if gt a sub long 9223372036854775807 b
do_trap 1
ret 0
end
end
if lt b 0
if lt a sub long -9223372036854775808 b
do_trap 1
ret 0
end
end
ret check_srange t add a b
end
if eq op OP_SUB
if lt b 0
if gt a add long 9223372036854775807 b
do_trap 1
ret 0
end
end
if gt b 0
if lt a add long -9223372036854775808 b
do_trap 1
ret 0
end
end
ret check_srange t sub a b
end
if eq op OP_MUL
if smul_ovf a b
do_trap 1
ret 0
end
ret check_srange t mul a b
end
if eq op OP_DIV
if eq b 0
do_trap 2
ret 0
end
if and eq a smin_l t eq b long -1
do_trap 1
ret 0
end
ret canon t l2u div a b
end
if eq op OP_REM
if eq b 0
do_trap 2
ret 0
end
if eq b long -1
ret 0
end
ret canon t l2u rem a b
end
if eq op OP_AND
ret and x y
end
if eq op OP_OR
ret or x y
end
ret xor x y
end

fn arith op ulong t ulong x ulong y ulong to ulong
if eq t T_BOOL
if eq op OP_AND
ret and x y
end
if eq op OP_OR
ret or x y
end
ret xor x y
end
if tsigned t
ret arith_s op t x y
end
if eq op OP_ADD
ret canon t add x y
end
if eq op OP_SUB
ret canon t sub x y
end
if eq op OP_MUL
ret canon t mul x y
end
if eq op OP_DIV
if eq y 0
do_trap 2
ret 0
end
ret div x y
end
if eq op OP_REM
if eq y 0
do_trap 2
ret 0
end
ret rem x y
end
if eq op OP_AND
ret and x y
end
if eq op OP_OR
ret or x y
end
ret xor x y
end

fn shift_op op ulong t ulong x ulong st ulong s ulong to ulong
w = twidth t
if tsigned st
if ge s I64_MIN_MAG
do_trap 7
ret 0
end
end
if ge s w
do_trap 7
ret 0
end
if eq op OP_SHR
if tsigned t
ret canon t l2u shr u2l x s
end
ret shr x s
end
if not tsigned t
ret canon t shl x s
end
a = u2l x
if eq s 0
ret canon t x
end
sh_u = shl x s
sh_l = u2l sh_u
if ne shr sh_l s a
do_trap 1
ret 0
end
ret check_srange t sh_l
end

fn compare_op op ulong t ulong x ulong y ulong to ulong
eqv = eq x y
ltv = false
if tsigned t
ltv = lt u2l x u2l y
else
ltv = lt x y
end
if eq op OP_EQ
if eqv
ret 1
end
ret 0
end
if eq op OP_NE
if eqv
ret 0
end
ret 1
end
if eq op OP_LT
if ltv
ret 1
end
ret 0
end
if eq op OP_LE
if or ltv eqv
ret 1
end
ret 0
end
if eq op OP_GT
if and not ltv not eqv
ret 1
end
ret 0
end
if ltv
ret 0
end
ret 1
end

fn convert_op to_t ulong from_t ulong x ulong to ulong
if tsigned from_t
if ge x I64_MIN_MAG
if not tsigned to_t
do_trap 5
ret 0
end
if lt u2l x smin_l to_t
do_trap 5
ret 0
end
ret x
end
end
lim = umax_u to_t
if tsigned to_t
lim = smax_u to_t
end
if gt x lim
do_trap 5
ret 0
end
ret x
end

note ---- Runtime enlarge / envread / read / write ----

fn mem_zero off ulong n ulong to void
i = ulong 0
while lt i n bound INF_BOUND
put mem_pool add off i 0
i = add i 1
end
end

fn mem_copy dst ulong src_o ulong n ulong to void

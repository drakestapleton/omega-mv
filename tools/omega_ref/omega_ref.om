note tools/omega_ref/omega_ref.om -- Pure seeded OM-2 reference interpreter for the om4 language.
note Replaces tools/omega_ref/omega_ref.c with byte-exact parity across check, run, and call modes.

const T_NONE ulong 0
const T_BOOL ulong 1
const T_U8 ulong 2
const T_U16 ulong 3
const T_U32 ulong 4
const T_U64 ulong 5
const T_I8 ulong 6
const T_I16 ulong 7
const T_I32 ulong 8
const T_I64 ulong 9
const T_VOID ulong 10

const AK_GLOBAL ulong 0
const AK_LOCAL ulong 1

const N_NUM ulong 0
const N_VAR ulong 1
const N_BIN ulong 2
const N_CMP ulong 3
const N_NEG ulong 4
const N_NOT ulong 5
const N_CONV ulong 6
const N_GET ulong 7
const N_LEN ulong 8
const N_READ ulong 9
const N_WRITE ulong 10
const N_CALL ulong 11
const N_BARE ulong 12
const N_ENLARGE ulong 13
const N_ENVCNT ulong 14
const N_ENVREAD ulong 15


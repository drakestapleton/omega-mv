note ---- I/O and error helpers ----

fn write_all fd int n ulong to void
off = ulong 0
while lt off n bound INF_BOUND
r = write fd fmt_buf off sub n off
if le r 0
ret
end
off = add off ulong r
end
end

fn fmt_u64 v ulong to ulong
if eq v 0
put fmt_buf 0 48
ret 1
end
x = v
k = ulong 0
while gt x 0 bound 32
put fmt_buf add 64 k uchar add 48 rem x 10
x = div x 10
k = add k 1
end
i = ulong 0
while lt i k bound 32
put fmt_buf i get fmt_buf sub sub add 64 k i 1
i = add i 1
end
ret k
end

fn fmt_i64 v ulong to ulong
if ge v I64_MIN_MAG
put fmt_buf 0 45
mag = sub ulong 0 v
n = fmt_u64 mag
i = n
while gt i 0 bound 32
put fmt_buf i get fmt_buf sub i 1
i = sub i 1
end
put fmt_buf 0 45
ret add n 1
end
ret fmt_u64 v
end

fn err_u64 v ulong to void
n = fmt_u64 v
write_all 2 n
end

fn out_u64 v ulong to void
n = fmt_u64 v
write_all 1 n
end

fn out_i64 v ulong to void
n = fmt_i64 v
write_all 1 n
end

fn out_hex64 v ulong to void
i = ulong 0
while lt i 16 bound 16
sh = mul sub 15 i 4
nib = and shr v sh 15
put fmt_buf i get hex_digits nib
i = add i 1
end
write_all 1 16
end

fn die_oom to void
r = write 2 msg_oom 0 len msg_oom
exit 2
end

fn die_io to void
r = write 2 msg_io_err 0 len msg_io_err
exit 2
end

fn refuse code ulong to void
r = write 2 msg_err_pre 0 len msg_err_pre
err_u64 get gs 1
r = write 2 msg_err_mid 0 len msg_err_mid
err_u64 code
r = write 2 msg_err_end 0 len msg_err_end
re = get gs 2
if ne re 0
exit int re
end
exit int code
end

fn do_trap code ulong to void
put gs 28 1
put gs 29 code
end

note ---- Type helpers ----

fn twidth t ulong to ulong
if eq t T_BOOL
ret 1
end
if or eq t T_U8 eq t T_I8
ret 8
end
if or eq t T_U16 eq t T_I16
ret 16
end
if or eq t T_U32 eq t T_I32
ret 32
end
if or eq t T_U64 eq t T_I64
ret 64
end
ret 0
end

fn tsigned t ulong to bool
if ge t T_I8
if le t T_I64
ret true
end
end
ret false
end

fn tnum t ulong to bool
if ge t T_U8
if le t T_I64
ret true
end
end
ret false
end

fn tbytes t ulong to ulong
if eq t T_BOOL
ret 1
end
ret div twidth t 8
end

fn canon t ulong x ulong to ulong
if eq t T_BOOL
ret and x 1
end
w = twidth t
if ge w 64
ret x
end
mask = sub shl ulong 1 w 1
v = and x mask
if tsigned t
m = shl ulong 1 sub w 1
ret sub xor v m m
end
ret v
end

fn smin_u t ulong to ulong
w = twidth t
if eq w 64
ret I64_MIN_MAG
end
ret sub ulong 0 shl ulong 1 sub w 1
end

fn smax_u t ulong to ulong
w = twidth t
if eq w 64
ret I64_MAX_U
end
ret sub shl ulong 1 sub w 1 1
end

fn umax_u t ulong to ulong
if eq t T_BOOL
ret 1
end
w = twidth t
if eq w 64
ret U64_MAX
end
ret sub shl ulong 1 w 1
end

fn smin_l t ulong to long
if eq t T_I8
ret long -128
end
if eq t T_I16
ret long -32768
end
if eq t T_I32
ret long -2147483648
end
ret long -9223372036854775808
end

fn smax_l t ulong to long
if eq t T_I8
ret long 127
end
if eq t T_I16
ret long 32767
end
if eq t T_I32
ret long 2147483647
end
ret long 9223372036854775807
end

fn u2l x ulong to long
if ge x I64_MIN_MAG
d = sub x I64_MIN_MAG
ret add long -9223372036854775808 long d
end
ret long x
end

fn l2u x long to ulong
if lt x 0
d = sub x long -9223372036854775808
ret add I64_MIN_MAG ulong d
end
ret ulong x
end

note ---- Pool growth helpers ----

fn grow_cap cur ulong need ulong to ulong
c = cur
if eq c 0
c = 64
end
while lt c need bound 64
c = mul c 2
end
ret c
end

fn ensure_tok need ulong to void
if le need len tok_off
ret
end
nc = grow_cap len tok_off need
r = enlarge tok_off nc
if lt r 0
die_oom
end
r = enlarge tok_len nc
if lt r 0
die_oom
end
end


fn alloc_arr ety ulong alen ulong ro ulong space ulong to ulong
id = add get gs 24 1
put gs 24 id
ensure_arr add id 1
put arr_ety id ety
put arr_len id alen
put arr_ro id ro
put arr_off id 0
put arr_cap id 0
put arr_space id space
ret id
end

fn alloc_mem_bytes nb ulong to ulong
if eq nb 0
ret get gs 25
end
used = get gs 25
need = add used nb
if gt need len mem_pool
r = enlarge mem_pool need
if lt r 0
die_oom
end
end
put gs 25 need
ret used
end

fn alloc_loc_bytes nb ulong to ulong
if eq nb 0
ret get gs 26
end
used = get gs 26
need = add used nb
if gt need len loc_pool
nc = grow_cap len loc_pool need
r = enlarge loc_pool nc
if lt r 0
die_oom
end
end
put gs 26 need
ret used
end

note ---- Token and keyword matching ----

fn src_eq o1 ulong n1 ulong o2 ulong n2 ulong to bool
if ne n1 n2
ret false
end
i = ulong 0
while lt i n1 bound INF_BOUND
if ne get src add o1 i get src add o2 i
ret false
end
i = add i 1
end
ret true
end

note Match src[off..off+n) against kw_list[s..s+n)
fn kw_match_src off ulong s ulong n ulong to bool
j = ulong 0
while lt j n bound 64
if ne get src add off j get kw_list add s j
ret false
end
j = add j 1
end
ret true
end

note Match src[off..off+n) against line id (0-based) of kw_list
fn kw_id_of off ulong n ulong to ulong
id = ulong 0
s = ulong 0
i = ulong 0
kl = len kw_list
while lt i kl bound 1024
if eq get kw_list i 10
if eq sub i s n
if kw_match_src off s n
ret id
end
end
id = add id 1
s = add i 1
end
i = add i 1
end
ret 999
end

fn kw_match_arg s ulong alen ulong to bool
j = ulong 0
while lt j alen bound 64
if ne get arg_buf j get kw_list add s j
ret false
end
j = add j 1
end
ret true
end

fn arg_eq_kw alen ulong target_id ulong to bool
id = ulong 0
s = ulong 0
i = ulong 0
kl = len kw_list
while lt i kl bound 1024
if eq get kw_list i 10
if eq id target_id
if ne sub i s alen
ret false
end
ret kw_match_arg s alen
end
id = add id 1
s = add i 1
end
i = add i 1
end
ret false
end

note kw_list indices:
note 0:bool 1:uchar 2:ushort 3:uint 4:ulong 5:byte 6:short 7:int 8:long
note 9:u8 10:u16 11:u32 12:u64 13:i8 14:i16 15:i32 16:i64
note 17:add 18:sub 19:mul 20:div 21:rem 22:and 23:or 24:xor 25:shl 26:shr
note 27:eq 28:ne 29:lt 30:le 31:gt 32:ge
note 33:fn 34:to 35:void 36:end 37:if 38:else 39:while 40:bound 41:for 42:break
note 43:ret 44:put 45:free 46:trap 47:global 48:text 49:new 50:view 51:edit 52:own
note 53:get 54:len 55:read 56:write 57:exit 58:note 59:true 60:false 61:neg 62:not
note 63:enlarge 64:envcnt 65:envread 66:= 67:( 68:) 69:* 70:main 71:check 72:run 73:call

fn type_word_kw k ulong to ulong
if le k 8
ret add k 1
end
if ge k 9
if le k 16
ret sub k 7
end
end
ret T_NONE
end

fn type_word off ulong n ulong to ulong
ret type_word_kw kw_id_of off n
end

fn op_word_kw k ulong to ulong
if ge k 17
if le k 32
ret sub k 17
end
end
ret 999
end

fn is_reserved off ulong n ulong to bool
k = kw_id_of off n
ret le k 68
end

fn is_alpha c uchar to bool
if ge c 97
if le c 122
ret true
end
end
if ge c 65
if le c 90
ret true
end
end
ret eq c 95
end

fn is_digit c uchar to bool
if ge c 48
if le c 57
ret true
end
end
ret false
end

fn is_name off ulong n ulong to bool
if eq n 0
ret false
end
if not is_alpha get src off
ret false
end
i = ulong 1
while lt i n bound INF_BOUND
c = get src add off i
if not is_alpha c
if not is_digit c
ret false
end
end
i = add i 1
end
ret true
end

fn looks_number off ulong n ulong to bool
if eq n 0
ret false
end
c = get src off
if is_digit c
ret true
end
ret eq c 45
end

note Parse decimal number into pr[0]=neg, pr[1]=mag
fn parse_number off ulong n ulong to void
p = ulong 0
negv = ulong 0
if eq get src off 45
negv = 1
p = 1
end
if ge p n
refuse 6
end
if eq get src add off p 48
if lt add p 1 n
refuse 6
end
end
if gt sub n p 20
refuse 6
end
v = ulong 0
while lt p n bound 24
c = get src add off p
if not is_digit c
refuse 6
end
d = ulong sub c 48
if gt v div sub U64_MAX d 10
refuse 8
end
v = add mul v 10 d
p = add p 1
end
if eq negv 1
if eq v 0
refuse 6
end
if gt v I64_MIN_MAG
refuse 8
end
end
put pr 0 negv
put pr 1 v
end

fn fits t ulong negv ulong mag ulong to bool
if eq t T_BOOL
if ne negv 0
ret false
end
ret le mag 1
end
if tsigned t
if ne negv 0
ret le mag add smax_u t 1
end
ret le mag smax_u t
end
if ne negv 0
ret false
end
ret le mag umax_u t
end

fn num_value negv ulong mag ulong to ulong
if ne negv 0
ret sub ulong 0 mag
end
ret mag
end

note ---- Line splitting ----

fn is_ws c uchar to bool
if eq c 32
ret true
end
if eq c 9
ret true
end
ret eq c 13
end

fn is_sep c uchar to bool
if is_ws c
ret true
end
if eq c 40
ret true
end
ret eq c 41
end

fn split_words loff ulong llen ulong to ulong
nw = ulong 0
i = ulong 0
while lt i llen bound INF_BOUND
c = get src add loff i
if is_ws c
i = add i 1
continue
end
ensure_tok add nw 1
if or eq c 40 eq c 41
put tok_off nw add loff i
put tok_len nw 1
nw = add nw 1
i = add i 1
continue
end
s = i
while lt i llen bound INF_BOUND
if is_sep get src add loff i
break
end
i = add i 1
end
put tok_off nw add loff s
put tok_len nw sub i s
nw = add nw 1
end
put gs 3 nw
put gs 4 0
ret nw
end

fn has_tok to bool
ret lt get gs 4 get gs 3
end

fn cur_toff to ulong
ret get tok_off get gs 4
end

fn cur_tlen to ulong
ret get tok_len get gs 4
end

fn adv_tok to void
put gs 4 add get gs 4 1
end

note ---- Symbol lookup & scopes ----

fn find_func off ulong n ulong to ulong
nf = get gs 5
i = ulong 0
while lt i nf bound INF_BOUND
if src_eq get fn_noff i get fn_nlen i off n
ret i
end
i = add i 1
end
ret U64_MAX
end

fn find_global off ulong n ulong to ulong
ng = get gs 6
i = ulong 0
while lt i ng bound INF_BOUND
if src_eq get gl_noff i get gl_nlen i off n
ret i
end
i = add i 1
end
ret U64_MAX
end

fn find_name off ulong n ulong to ulong
nn = get gs 10
if eq nn 0
ret U64_MAX
end
i = nn
while gt i 0 bound INF_BOUND
i = sub i 1
if src_eq get nm_noff i get nm_nlen i off n
ret i
end
end
ret U64_MAX
end

fn check_new_name off ulong n ulong to void
if not is_name off n
refuse 16
end
if is_reserved off n
refuse 16
end
if gt n 63
refuse 13
end
if ne find_func off n U64_MAX
refuse 10
end
if ne find_global off n U64_MAX
refuse 10
end
if ne find_name off n U64_MAX
refuse 10
end
end

fn add_name off ulong n ulong kind ulong ty ulong alen ulong isloop ulong to ulong
check_new_name off n
idx = get gs 10
ensure_nm add idx 1
put nm_noff idx off
put nm_nlen idx n
put nm_kind idx kind
put nm_ty idx ty
put nm_len idx alen
put nm_depth idx get gs 11
put nm_isloop idx isloop
sl = get gs 13
put nm_slot idx sl
put gs 13 add sl 1
put gs 10 add idx 1
ret idx
end

fn close_scope d ulong to void
nn = get gs 10
while gt nn 0 bound INF_BOUND
if lt get nm_depth sub nn 1 d
break
end
nn = sub nn 1
end
put gs 10 nn
end

note ---- AST node & statement constructors ----

fn new_node kind ulong to ulong
id = add get gs 20 1
put gs 20 id
ensure_nd add id 1
put nd_kind id kind
put nd_op id 0
put nd_ty id T_NONE
put nd_bare id 0
put nd_num id 0
put nd_neg id 0
put nd_slot id 0
put nd_akind id 0
put nd_aidx id 0
put nd_fn id 0
put nd_a id 0
put nd_b id 0
put nd_c id 0
put nd_abase id 0
put nd_line id get gs 1
ret id
end

fn new_stmt kind ulong to ulong
id = add get gs 21 1
put gs 21 id
ensure_st add id 1
put st_kind id kind
put st_line id get gs 1
put st_slot id 0
put st_v id 0
put st_v2 id 0
put st_akind id 0
put st_aidx id 0
put st_ety id 0
put st_n id 0
put st_ckind id 0
put st_ty id 0
put st_body id 0
put st_els id 0
put st_next id 0
ret id
end

note ---- Bare number fixing & unification ----

fn fix_bare nid ulong t ulong to void
if eq get nd_bare nid 0
ret
end
put nd_bare nid 0
put nd_ty nid t
k = get nd_kind nid
if eq k N_BARE
negv = get nd_neg nid
mag = get nd_num nid
if eq t T_BOOL
if or ne negv 0 gt mag 1
refuse 8
end
else
if not tnum t
refuse 7
end
if not fits t negv mag
refuse 8
end
end
put nd_num nid canon t num_value negv mag
put nd_kind nid N_NUM
ret
end
if or eq k N_NEG eq k N_NOT
fix_bare get nd_a nid t
end
end

fn unify a ulong b ulong to ulong
ab = get nd_bare a
bb = get nd_bare b
if and ne ab 0 ne bb 0
refuse 11
end
if ne ab 0
fix_bare a get nd_ty b
else
if ne bb 0
fix_bare b get nd_ty a
end
end
if ne get nd_ty a get nd_ty b
refuse 7
end
ret get nd_ty a
end

note Parse array ref into pr[2]=akind, pr[3]=aidx, pr[4]=ety, pr[5]=alen, pr[6]=ro, pr[7]=kindout
fn parse_array_ref to void
if not has_tok
refuse 4
end
off = cur_toff
n = cur_tlen
adv_tok
if not is_name off n
refuse 16
end
if is_reserved off n
refuse 3
end
ni = find_name off n
if ne ni U64_MAX
nk = get nm_kind ni
if ne nk K_SCALAR
put pr 2 AK_LOCAL
put pr 3 get nm_slot ni
put pr 4 get nm_ty ni
put pr 5 get nm_len ni
if eq nk K_VIEW
put pr 6 1
else
put pr 6 0
end
put pr 7 nk
ret
end
end
gi = find_global off n
if ne gi U64_MAX
put pr 2 AK_GLOBAL
put pr 3 gi
put pr 4 get gl_ety gi
put pr 5 get gl_len gi
put pr 6 get gl_istext gi
put pr 7 99
ret
end
if ne ni U64_MAX
refuse 7
end
if ne find_func off n U64_MAX
refuse 7
end
refuse 3
end

note ---- Value parsing ----

fn parse_call_args fi ulong abase ulong to void
np = get fn_np fi
i = ulong 0
while lt i np bound 8
pk = get fn_pkind add mul fi 6 i
pty = get fn_pty add mul fi 6 i
if eq pk PK_SCALAR
if not has_tok
refuse 4
end
an = parse_value pty
fix_bare an pty
if ne get nd_ty an pty
refuse 7
end
put ca_node add abase i an
put ca_akind add abase i 0
put ca_aidx add abase i 0
else
parse_call_arr_arg fi i abase pk pty
end
i = add i 1
end
end

fn parse_call fi ulong want_void ulong to ulong
fret = get fn_ret fi
if eq want_void 0
if eq fret T_VOID
refuse 7
end
else
if ne fret T_VOID
refuse 7
end
end
cf = get gs 12
put fn_hascall cf 1
if eq get gs 8 0
if eq cf fi
refuse 9
end
end
eid = add get gs 23 1
put gs 23 eid
ensure_edge add eid 1
put edge_to eid fi
put edge_next eid get fn_ehead cf
put fn_ehead cf eid
nid = new_node N_CALL
put nd_fn nid fi
put nd_ty nid fret
np = get fn_np fi
abase = get gs 22
put nd_abase nid abase
put gs 22 add abase np
ensure_ca add abase np
parse_call_args fi abase
ret nid
end

fn check_dup_arr_arg fi ulong i ulong abase ulong rk ulong ri ulong to void
j = ulong 0
while lt j i bound 8
if ne get fn_pkind add mul fi 6 j PK_SCALAR
if eq get ca_akind add abase j rk
if eq get ca_aidx add abase j ri
refuse 19
end
end
end
j = add j 1
end
end

fn parse_call_arr_arg fi ulong i ulong abase ulong pk ulong pty ulong to void
if not has_tok
refuse 4
end
as_m = ulong 99
if eq kw_id_of cur_toff cur_tlen 50
as_m = PK_VIEW
adv_tok
else
if eq kw_id_of cur_toff cur_tlen 51
as_m = PK_EDIT
adv_tok
else
if eq kw_id_of cur_toff cur_tlen 52
refuse 9
end
end
end
if not has_tok
refuse 4
end
if ne find_global cur_toff cur_tlen U64_MAX
if eq get gl_istext find_global cur_toff cur_tlen 0
refuse 19
end
end
parse_array_ref
if ne get pr 4 pty
refuse 7
end
if ne get pr 5 get fn_plen add mul fi 6 i
refuse 7
end
if eq as_m PK_EDIT
if ne get pr 6 0
refuse 20
end
end
if eq pk PK_EDIT
if or ne get pr 6 0 eq as_m PK_VIEW
refuse 20
end
end
check_dup_arr_arg fi i abase get pr 2 get pr 3
put ca_node add abase i 0
put ca_akind add abase i get pr 2
put ca_aidx add abase i get pr 3
end

fn parse_val_op op ulong to ulong
a = parse_value T_NONE
b = parse_value T_NONE
if or eq op OP_SHL eq op OP_SHR
if and ne get nd_bare a 0 ne get nd_bare b 0
refuse 11
end
if ne get nd_bare a 0
fix_bare a get nd_ty b
end
if ne get nd_bare b 0
fix_bare b get nd_ty a
end
if or not tnum get nd_ty a not tnum get nd_ty b
refuse 7
end
nid = new_node N_BIN
put nd_ty nid get nd_ty a
put nd_op nid op
put nd_a nid a
put nd_b nid b
ret nid
end
t = unify a b
nid = ulong 0
if ge op OP_EQ
nid = new_node N_CMP
put nd_ty nid T_BOOL
if eq t T_BOOL
if and ne op OP_EQ ne op OP_NE
refuse 7
end
end
else
nid = new_node N_BIN
put nd_ty nid t
if eq t T_BOOL
if and ne op OP_AND and ne op OP_OR ne op OP_XOR
refuse 7
end
end
end
put nd_op nid op
put nd_a nid a
put nd_b nid b
ret nid
end

fn parse_val_get to ulong
nid = new_node N_GET
parse_array_ref
put nd_akind nid get pr 2
put nd_aidx nid get pr 3
put nd_ty nid get pr 4
alen = get pr 5
idx = parse_value T_NONE
put nd_a nid idx
if ne get nd_bare idx 0
if ne get nd_neg idx 0
refuse 8
end
if ne alen U64_MAX
if ge get nd_num idx alen
refuse 21
end
end
fix_bare idx T_U64
end
if not tnum get nd_ty idx
refuse 7
end
ret nid
end

fn parse_val_rw is_read ulong to ulong
nid = ulong 0
if ne is_read 0
nid = new_node N_READ
else
nid = new_node N_WRITE
end
fdn = parse_value T_I32
fix_bare fdn T_I32
if ne get nd_ty fdn T_I32
refuse 7
end
put nd_a nid fdn
parse_array_ref
if ne is_read 0
if ne get pr 6 0
refuse 20
end
end
if ne get pr 4 T_U8
refuse 7
end
put nd_akind nid get pr 2
put nd_aidx nid get pr 3
bn = parse_value T_U64
fix_bare bn T_U64
cn = parse_value T_U64
fix_bare cn T_U64
if or ne get nd_ty bn T_U64 ne get nd_ty cn T_U64
refuse 7
end
put nd_b nid bn
put nd_c nid cn
put nd_ty nid T_I64
ret nid
end

fn parse_val_enlarge to ulong
if or eq get gs 15 0 ne get gs 14 1
refuse 9
end
nid = new_node N_ENLARGE
put nd_ty nid T_I64
if not has_tok
refuse 7
end
gi = find_global cur_toff cur_tlen
adv_tok
if or eq gi U64_MAX ne get gl_len gi U64_MAX
refuse 7
end
put nd_akind nid AK_GLOBAL
put nd_aidx nid gi
an = parse_value T_U64
fix_bare an T_U64
if ne get nd_ty an T_U64
refuse 7
end
put nd_a nid an
ret nid
end

fn parse_val_envread to ulong
nid = new_node N_ENVREAD
put nd_ty nid T_I64
an = parse_value T_U64
fix_bare an T_U64
parse_array_ref
if ne get pr 6 0
refuse 20
end
if or ne get pr 4 T_U8 eq get pr 5 U64_MAX
refuse 7
end
put nd_akind nid get pr 2
put nd_aidx nid get pr 3
bn = parse_value T_U64
fix_bare bn T_U64
cn = parse_value T_U64
fix_bare cn T_U64
if ne get nd_ty an T_U64
refuse 7
end
if ne get nd_ty bn T_U64
refuse 7
end
if ne get nd_ty cn T_U64
refuse 7
end
put nd_a nid an
put nd_b nid bn
put nd_c nid cn
ret nid
end

fn parse_val_ident off ulong n ulong to ulong
fi = find_func off n
ni = find_name off n
if ne ni U64_MAX
if ne get nm_kind ni K_SCALAR
refuse 7
end
nid = new_node N_VAR
put nd_slot nid get nm_slot ni
put nd_ty nid get nm_ty ni
ret nid
end
if ne fi U64_MAX
ret parse_call fi 0
end
if ne find_global off n U64_MAX
refuse 7
end
if and is_name off n not is_reserved off n
refuse 3
end
if looks_number off n
refuse 6
end
refuse 16
ret 0
end

fn parse_value want ulong to ulong
if not has_tok
refuse 4
end
off = cur_toff
n = cur_tlen
adv_tok
put gs 14 add get gs 14 1
k = kw_id_of off n
nid = ulong 0
if eq k 67
nid = parse_value want
if not has_tok
refuse 4
end
if ne kw_id_of cur_toff cur_tlen 68
refuse 5
end
adv_tok
else
if eq k 68
refuse 5
else
if looks_number off n
nid = new_node N_BARE
parse_number off n
put nd_neg nid get pr 0
put nd_num nid get pr 1
put nd_bare nid 1
put nd_ty nid T_NONE
else
if or eq k 59 eq k 60
nid = new_node N_NUM
put nd_ty nid T_BOOL
if eq k 59
put nd_num nid 1
else
put nd_num nid 0
end
else
op = op_word_kw k
if ne op 999
nid = parse_val_op op
else
nid = parse_value_ext off n k want
end
end
end
end
end
put gs 14 sub get gs 14 1
ret nid
end

fn parse_value_ext off ulong n ulong k ulong want ulong to ulong
if or eq k 61 eq k 62
a = parse_value want
nid = ulong 0
if eq k 61
nid = new_node N_NEG
else
nid = new_node N_NOT
end
put nd_a nid a
put nd_ty nid get nd_ty a
put nd_bare nid get nd_bare a
if eq get nd_bare a 0
aty = get nd_ty a
if eq k 61
if not tnum aty
refuse 7
end
else
if and not tnum aty ne aty T_BOOL
refuse 7
end
end
end
ret nid
end
t = type_word_kw k
if ne t T_NONE
a = parse_value t
if ne get nd_bare a 0
fix_bare a t
ret a
end
aty = get nd_ty a
if or eq t T_BOOL eq aty T_BOOL
refuse 9
end
if not tnum aty
refuse 7
end
nid = new_node N_CONV
put nd_a nid a
put nd_ty nid t
ret nid
end
if eq k 53
ret parse_val_get
end
if eq k 54
nid = new_node N_LEN
parse_array_ref
put nd_akind nid get pr 2
put nd_aidx nid get pr 3
put nd_ty nid T_U64
put nd_num nid get pr 5
ret nid
end
if eq k 55
ret parse_val_rw 1
end
if eq k 56
ret parse_val_rw 0
end
if eq k 63
ret parse_val_enlarge
end
if eq k 64
nid = new_node N_ENVCNT
put nd_ty nid T_I64
ret nid
end
if eq k 65
ret parse_val_envread
end
if or eq k 49 eq k 52
refuse 9
end
if or eq k 50 eq k 51
refuse 16
end
ret parse_val_ident off n
end

fn place_check nid ulong want ulong to void
if ne get nd_bare nid 0
if eq want T_NONE
refuse 11
end
fix_bare nid want
end
if ne want T_NONE
if ne get nd_ty nid want
refuse 7
end
end
end

fn value_for want ulong to ulong
put gs 14 0
nid = parse_value want
if ne get nd_bare nid 0
if eq want T_NONE
refuse 11
end
end
np = get gs 16
put pend_node np nid
put pend_want np want
put gs 16 add np 1
ret nid
end

fn line_end to void
if has_tok
refuse 5
end
np = get gs 16
i = ulong 0
while lt i np bound 8
place_check get pend_node i get pend_want i
i = add i 1
end
put gs 16 0
end

note ---- Blocks & Statements ----

fn push_stmt sid ulong to void
bi = sub get gs 17 1
if ne get blk_ended bi 0
refuse 17
end
tl = get blk_tail bi
if eq tl 0
bk = get blk_kind bi
ow = get blk_owner bi
if eq bk 0
put fn_body get gs 12 sid
else
if eq bk 2
put st_els ow sid
else
put st_body ow sid
end
end
else
put st_next tl sid
end
put blk_tail bi sid
end

fn open_block bk ulong owner ulong to void
nb = get gs 17
ensure_blk add nb 1
put blk_kind nb bk
put blk_owner nb owner
put blk_tail nb 0
put blk_ended nb 0
put blk_then_ended nb 0
put gs 17 add nb 1
put gs 11 add get gs 11 1
end

fn local_arr_ok add_b ulong to bool
nb = add get gs 18 add_b
put gs 18 nb
ret le nb MAX_LOCAL_ARR_BYTES
end

fn parse_stmt_if_while is_if ulong to void
sid = ulong 0
if ne is_if 0
sid = new_stmt S_IF
else
sid = new_stmt S_WHILE
end
vn = value_for T_BOOL
put st_v sid vn
put gs 16 sub get gs 16 1
place_check vn T_BOOL
if eq is_if 0
put st_n sid LOOP_MAX
if has_tok
if eq kw_id_of cur_toff cur_tlen 40
adv_tok
if not has_tok
refuse 4
end
boff = cur_toff
blen = cur_tlen
adv_tok
if is_reserved boff blen
refuse 16
end
if and not is_name boff blen not looks_number boff blen
refuse 16
end
if not looks_number boff blen
refuse 6
end
parse_number boff blen
if ne get pr 0 0
refuse 8
end
if lt get pr 1 1
refuse 8
end
if gt get pr 1 I64_MAX_U
refuse 8
end
put st_n sid get pr 1
end
end
end
line_end
push_stmt sid
if ne is_if 0
open_block 1 sid
else
open_block 3 sid
end
end

fn parse_stmt_for to void
sid = new_stmt S_FOR
if not has_tok
refuse 4
end
noff = cur_toff
nlen = cur_tlen
adv_tok
if not has_tok
refuse 4
end
toff = cur_toff
tlen = cur_tlen
adv_tok
t = type_word toff tlen
if eq t T_NONE
refuse 16
end
if not tnum t
refuse 7
end
put st_ty sid t
if not has_tok
refuse 4
end
coff = cur_toff
clen = cur_tlen
is_last = eq add get gs 4 1 get gs 3
if and looks_number coff clen is_last
adv_tok
parse_number coff clen
if not fits t get pr 0 get pr 1
refuse 8
end
put st_ckind sid 0
put st_n sid get pr 1
else
ni = find_name coff clen
ck = ulong 2
if and ne ni U64_MAX is_last
if eq get nm_kind ni K_SCALAR
ck = 1
end
end
put st_ckind sid ck
put st_v sid value_for t
end
line_end
push_stmt sid
open_block 4 sid
lvi = add_name noff nlen K_SCALAR t 0 1
put st_slot sid get nm_slot lvi
end

fn parse_stmt_put to void
sid = new_stmt S_PUT
parse_array_ref
if ne get pr 6 0
refuse 20
end
put st_akind sid get pr 2
put st_aidx sid get pr 3
ety = get pr 4
alen = get pr 5
put gs 14 0
idx = parse_value T_NONE
put st_v sid idx
if ne get nd_bare idx 0
if ne get nd_neg idx 0
refuse 8
end
if ne alen U64_MAX
if ge get nd_num idx alen
refuse 21
end
end
fix_bare idx T_U64
end
if not tnum get nd_ty idx
refuse 7
end
put st_v2 sid value_for ety
line_end
push_stmt sid
end

fn parse_stmt_new off ulong n ulong ni ulong to void
adv_tok
if ne ni U64_MAX
refuse 10
end
if ne get gs 11 1
refuse 9
end
if not has_tok
refuse 4
end
t = type_word cur_toff cur_tlen
adv_tok
if not has_tok
refuse 4
end
if eq t T_NONE
refuse 16
end
if not tnum t
refuse 7
end
if not looks_number cur_toff cur_tlen
refuse 16
end
parse_number cur_toff cur_tlen
adv_tok
mag = get pr 1
if or ne get pr 0 0 lt mag 1
refuse 8
end
if gt mag div MAX_LOCAL_ARR_BYTES tbytes t
refuse 23
end
if not local_arr_ok mul mag tbytes t
refuse 23
end
sid = new_stmt S_NEW
put st_ety sid t
put st_n sid mag
put st_v sid value_for t
line_end
push_stmt sid

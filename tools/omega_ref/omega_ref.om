const PK_SCALAR ulong 0
const PK_VIEW ulong 1
const PK_EDIT ulong 2

const K_SCALAR ulong 0
const K_OWN ulong 1
const K_VIEW ulong 2
const K_EDIT ulong 3

const C_NORMAL ulong 0
const C_BREAK ulong 1
const C_RET ulong 2

const MAX_POOL_ELEMS ulong 16777216
const MAX_POOL_BYTES ulong 1073741824
const MAX_LOCAL_ARR_BYTES ulong 4194304
const STACK_BYTES ulong 8388608
const LOOP_MAX ulong 1000000
const U64_MAX ulong 18446744073709551615
const I64_MAX_U ulong 9223372036854775807
const I64_MIN_MAG ulong 9223372036854775808
const INF_BOUND ulong 9223372036854775807

text kw_list "bool\nuchar\nushort\nuint\nulong\nbyte\nshort\nint\nlong\nu8\nu16\nu32\nu64\ni8\ni16\ni32\ni64\nadd\nsub\nmul\ndiv\nrem\nand\nor\nxor\nshl\nshr\neq\nne\nlt\nle\ngt\nge\nfn\nto\nvoid\nend\nif\nelse\nwhile\nbound\nfor\nbreak\nret\nput\nfree\ntrap\nglobal\ntext\nnew\nview\nedit\nown\nget\nlen\nread\nwrite\nexit\nnote\ntrue\nfalse\nneg\nnot\nenlarge\nenvcnt\nenvread\n=\n(\n)\n*\nmain\ncheck\nrun\ncall\n"

text msg_err_pre "omega_ref: line "
text msg_err_mid ": error "
text msg_err_end "\n"
text msg_usage "usage: omega_ref check|run <prog> | omega_ref call <prog> <entry> <inputs>\n"
text msg_run_main "omega_ref: run needs fn main\n"
text msg_no_fn "omega_ref: no function\n"
text msg_call_arr "omega_ref: call with an array parameter\n"
text msg_in_range "omega_ref: input out of range\n"
text msg_unk_cmd "omega_ref: unknown command\n"
text msg_io_err "omega_ref: io error\n"
text msg_oom "omega_ref: allocation failed\n"
text msg_trap_pre "TRAP "
text msg_trap_suf "\t-\n"
text msg_hex_pre "\t0x"
text hex_digits "0123456789abcdef"

note Scalar global state packed in gs[0..31]:
note 0:src_len 1:cur_line 2:refuse_exit 3:nw 4:wi 5:nfuncs 6:nglobals 7:pool_bytes
note 8:program_mode 9:first_global_line 10:nnames 11:depth 12:curf 13:nslots
note 14:nest 15:enlarge_assign 16:npend 17:nblocks 18:local_arr_bytes 19:fn_seen
note 20:nnodes 21:nstmts 22:ncargs 23:nedges 24:narrs 25:mem_used 26:loc_used
note 27:stack_used 28:trapped 29:trap_code 30:fr_sp 31:arg_sp

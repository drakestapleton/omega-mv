put gs 10 0
put gs 13 0
put gs 11 0
put gs 12 0
put gs 19 0
parse_prog_pass2
if and eq get gs 8 0 gt get gs 6 0
put gs 1 get gs 9
refuse 9
end
if eq get gs 8 0
slen = get gs 0
f = ulong 0
nf = get gs 5
while lt f nf bound INF_BOUND
c = find_cycle f
if ne c U64_MAX
ln = ulong 1
j = ulong 0
while lt j slen bound INF_BOUND
if eq get src j 10
ln = add ln 1
end
j = add j 1
end
put gs 1 ln
refuse 9
end
f = add f 1
end
end
if eq get gs 5 0
refuse 16
end
end

note ---- Runtime array access ----


fn eval_enlarge aid ulong new_elems ulong to ulong
cur_len = get arr_len aid
if le new_elems cur_len
ret 0
end
tb = tbytes get arr_ety aid
if gt new_elems div I64_MAX_U tb
ret l2u long -22
end

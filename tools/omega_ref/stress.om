note Emit a source that exceeds the old interpreter's source, function, name and block tables.
note This generator is a test, not a production compiler or an expected compiler artifact.
text comment "note padding to cross the former eight mebibyte source ceiling independently\n"
text globalstart "global glob"
text globalend " ulong 1\n"
text functionstart "fn checkfun"
text functionmiddle " to ulong\nret "
text functionend "\nend\n"
text mainstart "fn main to int\n"
text namestart "value"
text nameend " = ulong 0\n"
text blockstart "if true\n"
text blockend "end\n"
text mainend "ret int sub checkfun1024 1024\nend\n"
global digits uchar 32
fn number n ulong to void
x = n
k = ulong 32
while true
k = sub k 1
put digits k uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
r = write 1 digits k sub 32 k
end
fn main to int
for i ulong 120000
r = write 1 comment 0 len comment
end
for i ulong 65
r = write 1 globalstart 0 len globalstart
number i
r = write 1 globalend 0 len globalend
end
for i ulong 1025
r = write 1 functionstart 0 len functionstart
number i
r = write 1 functionmiddle 0 len functionmiddle
number i
r = write 1 functionend 0 len functionend
end
r = write 1 mainstart 0 len mainstart
if eq argcnt 2
for i ulong 1100
r = write 1 namestart 0 len namestart
number i
r = write 1 nameend 0 len nameend
end
end
for i ulong 1100
r = write 1 blockstart 0 len blockstart
end
for i ulong 1100
r = write 1 blockend 0 len blockend
end
r = write 1 mainend 0 len mainend
ret 0
end

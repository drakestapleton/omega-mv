note ---- word pool helpers ----
fn wp_push_c c uchar to void
  n = get g_st 31
  if ge n len g_wpool
    nc = mul n 2
    if lt nc 4096
      nc = 4096
    end
    r = enlarge g_wpool nc
    if lt r 0
      exit 2
    end
  end
  put g_wpool n c
  put g_st 31 add n 1
end

fn wp_push_t s view uchar * to ulong
  off = get g_st 31
  n = len s
  for i ulong n bound 256
    wp_push_c get s i
  end
  ret off
end

fn w_off idx ulong to ulong
  ret get g_lw_off add get g_st 23 idx
end

fn w_len idx ulong to ulong
  ret get g_lw_len add get g_st 23 idx
end

fn wp_eq_t off ulong n ulong s view uchar * to bool
  if ne n len s
    ret false
  end
  for i ulong n bound 256
    if ne get g_wpool add off i get s i
      ret false
    end
  end
  ret true
end

fn w_eq_t idx ulong s view uchar * to bool
  ret wp_eq_t w_off idx w_len idx s
end

fn wp_eq_wp o1 ulong n1 ulong o2 ulong n2 ulong to bool
  if ne n1 n2
    ret false
  end
  for i ulong n1 bound 256
    if ne get g_wpool add o1 i get g_wpool add o2 i
      ret false
    end
  end
  ret true
end

fn wp_eq_nm off ulong n ulong idx ulong to bool
  if ne n get g_nm_len idx
    ret false
  end
  no = mul idx 64
  for i ulong n bound 64
    if ne get g_wpool add off i get g_nm_str add no i
      ret false
    end
  end
  ret true
end

fn wp_eq_fn off ulong n ulong fi ulong to bool
  if ne n get g_fn_nlen fi
    ret false
  end
  fo = mul fi 64
  for i ulong n bound 64
    if ne get g_wpool add off i get g_fn_name add fo i
      ret false
    end
  end
  ret true
end

fn is_alpha c uchar to bool
  if and ge c 65 le c 90
    ret true
  end
  if and ge c 97 le c 122
    ret true
  end
  ret false
end

fn is_digit c uchar to bool
  ret and ge c 48 le c 57
end

fn is_alnum c uchar to bool
  ret or is_alpha c is_digit c
end

fn valid_ident_wp off ulong n ulong to bool
  if or eq n 0 gt n NAME_MAX_LEN
    ret false
  end
  c0 = get g_wpool off
  if not or is_alpha c0 eq c0 95
    ret false
  end
  for i ulong n bound 64
    c = get g_wpool add off i
    if not or is_alnum c eq c 95
      ret false
    end
  end
  ret true
end

note ---- type & word tables ----
fn ty_make rf ulong s ulong l ulong to ulong
  ret or rf or shl s 4 shl l 8
end

fn ty_ref t ulong to ulong
  ret and t 15
end

fn ty_s t ulong to ulong
  ret and shr t 4 15
end

fn ty_len t ulong to ulong
  ret shr t 8
end

fn ty_is_int t ulong to bool
  ret and eq ty_ref t R_NONE ne ty_s t T_BOOL
end

fn is_signed s ulong to bool
  ret ge s T_I8
end

fn scalar_bits s ulong to ulong
  if eq s T_BOOL
    ret 1
  end
  if or eq s T_U8 eq s T_I8
    ret 8
  end
  if or eq s T_U16 eq s T_I16
    ret 16
  end
  if or eq s T_U32 eq s T_I32
    ret 32
  end
  ret 64
end

fn gw_len s ulong to ulong
  if eq s 0
    ret len tg_bool
  end
  if eq s 1
    ret len tg_uchar
  end
  if eq s 2
    ret len tg_ushort
  end
  if eq s 3
    ret len tg_uint
  end
  if eq s 4
    ret len tg_ulong
  end
  if eq s 5
    ret len tg_byte
  end
  if eq s 6
    ret len tg_short
  end
  if eq s 7
    ret len tg_int
  end
  ret len tg_long
end

fn err_c c uchar to void
  n = get g_st 3
  if lt n 511
    put g_err n c
    put g_st 3 add n 1
  end
end

fn err_t s view uchar * to void
  n = len s
  for i ulong n bound 512
    err_c get s i
  end
end

fn err_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    err_c 48
    ret
  end
  k = ulong 0
  while gt v 0 bound 32
    d = rem v 10
    put tmp k uchar add 48 d
    v = div v 10
    k = add k 1
  end
  while gt k 0 bound 32
    k = sub k 1
    err_c get tmp k
  end
end

fn err_start to void
  put g_st 3 0
  err_t tc_line
  err_u64 get g_st 4
  err_t tc_cosp
end

fn err_wp off ulong n ulong to void
  for i ulong n bound 256
    err_c get g_wpool add off i
  end
end

fn err_w idx ulong to void
  err_wp w_off idx w_len idx
end

fn err_nm idx ulong to void
  off = mul idx 64
  n = get g_nm_len idx
  for i ulong n bound 64
    err_c get g_nm_str add off i
  end
end

fn err_fn fi ulong to void
  off = mul fi 64
  n = get g_fn_nlen fi
  for i ulong n bound 64
    err_c get g_fn_name add off i
  end
end

fn err_gw s ulong to void
  if eq s 0
    err_t tg_bool
  else
    if eq s 1
      err_t tg_uchar
    else
      if eq s 2
        err_t tg_ushort
      else
        if eq s 3
          err_t tg_uint
        else
          if eq s 4
            err_t tg_ulong
          else
            if eq s 5
              err_t tg_byte
            else
              if eq s 6
                err_t tg_short
              else
                if eq s 7
                  err_t tg_int
                else
                  err_t tg_long
                end
              end
            end
          end
        end
      end
    end
  end
end

fn err_refw rf ulong to void
  if eq rf R_OWN
    err_t tr_own
  else
    if eq rf R_MUT
      err_t tr_edit
    else
      if eq rf R_SHARED
        err_t tr_view
      end
    end
  end
end

fn err_ty t ulong to void
  rf = ty_ref t
  if eq rf R_NONE
    err_gw ty_s t
    ret
  end
  err_refw rf
  err_c 32
  err_gw ty_s t
  err_c 32
  err_u64 ty_len t
end

fn err_opw o ulong to void
  if eq o 0
    err_t to_add
    ret
  end
  if eq o 1
    err_t to_sub
    ret
  end
  if eq o 2
    err_t to_mul
    ret
  end
  if eq o 3
    err_t to_div
    ret
  end
  if eq o 4
    err_t to_rem
    ret
  end
  if eq o 5
    err_t to_and
    ret
  end
  if eq o 6
    err_t to_or
    ret
  end
  if eq o 7
    err_t to_xor
    ret
  end
  if eq o 8
    err_t to_shl
    ret
  end
  if eq o 9
    err_t to_shr
    ret
  end
  if eq o 10
    err_t to_eq
    ret
  end
  if eq o 11
    err_t to_ne
    ret
  end
  if eq o 12
    err_t to_lt
    ret
  end
  if eq o 13
    err_t to_le
    ret
  end
  if eq o 14
    err_t to_gt
    ret
  end
  if eq o 15
    err_t to_ge
    ret
  end
  if eq o 16
    err_t to_neg
    ret
  end
  if eq o 17
    err_t to_not
    ret
  end
  if eq o 18
    err_t to_get
    ret
  end
  err_t to_new
end

fn err_span a ulong b ulong to void
  sbuf = new uchar 80 0
  sn = ulong 0
  ln = get g_st 20
  i = a
  while and lt i b and lt i ln lt sn 79 bound 1024
    sp = false
    if gt i a
      if and not w_eq_t sub i 1 t_lpar not w_eq_t i t_rpar
        sp = true
      end
    end
    if sp
      if lt sn 79
        put sbuf sn 32
        sn = add sn 1
      end
    end
    wo = w_off i
    wl = w_len i
    j = ulong 0
    while lt j wl bound 256
      if ge sn 79
        put sbuf 76 46
        put sbuf 77 46
        put sbuf 78 46
        sn = 79
        break
      end
      put sbuf sn get g_wpool add wo j
      sn = add sn 1
      j = add j 1
    end
    if and eq sn 79 lt j wl
      put sbuf 76 46
      put sbuf 77 46
      put sbuf 78 46
      break
    end
    i = add i 1
  end
  for k ulong sn bound 80
    err_c get sbuf k
  end
end

fn out_irn s ulong to void
  if eq s 0
    out_t tg_bool
    ret
  end
  if eq s 1
    out_t ti_u8
    ret
  end
  if eq s 2
    out_t ti_u16
    ret
  end
  if eq s 3
    out_t ti_u32
    ret

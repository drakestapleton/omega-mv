note ---- I/O & buffer helpers ----
fn wr_so_all fd int n ulong to bool
  off = ulong 0
  while lt off n bound 65536
    k = write fd g_so off sub n off
    if eq k neg long 4
      continue
    end
    if le k 0
      ret false
    end
    off = add off ulong k
  end
  ret true
end

fn so_flush to void
  n = get g_st 2
  if gt n 0
    ok = wr_so_all 1 n
    put g_st 2 0
  end
end

fn so_c c uchar to void
  n = get g_st 2
  if ge n 65536
    so_flush
    n = ulong 0
  end
  put g_so n c
  put g_st 2 add n 1
end

fn so_t s view uchar * to void
  n = len s
  for i ulong n bound 4096
    so_c get s i
  end
end

fn so_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    so_c 48
    ret
  end
  k = ulong 0
  while gt v 0 bound 32
    d = rem v 10
    put tmp k uchar add 48 d
    v = div v 10
    k = add k 1
  end
  while gt k 0 bound 32
    k = sub k 1
    so_c get tmp k
  end
end

fn so_wpool off ulong n ulong to void
  for i ulong n bound 65536
    so_c get g_wpool add off i
  end
end

fn so_err_buf off ulong n ulong to void
  for i ulong n bound 512
    so_c get g_err add off i
  end
end

fn so_ids_name idx ulong to void
  off = mul idx 64
  n = get g_ids_len idx
  for i ulong n bound 64
    so_c get g_ids_str add off i
  end
end

fn so_num1 to void
  n = get g_num1_n 0
  for i ulong n bound 64
    so_c get g_num1 i
  end
end

fn so_num2 to void
  n = get g_num2_n 0
  for i ulong n bound 64
    so_c get g_num2 i
  end
end

fn so_close to void
  n = get g_st 44
  for i ulong n bound BIG
    so_c get g_close i
  end
end

fn out_c c uchar to void
  n = get g_st 1
  if ge n len g_out
    nc = mul n 2
    if lt nc 4096
      nc = 4096
    end
    r = enlarge g_out nc
    if lt r 0
      exit 2
    end
  end
  put g_out n c
  put g_st 1 add n 1

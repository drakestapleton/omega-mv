fn scalar_word_wp off ulong n ulong to long
  if wp_eq_t off n tg_bool
    ret 0
  end
  if or wp_eq_t off n tg_uchar wp_eq_t off n ti_u8
    ret 1
  end
  if or wp_eq_t off n tg_ushort wp_eq_t off n ti_u16
    ret 2
  end
  if or wp_eq_t off n tg_uint wp_eq_t off n ti_u32
    ret 3
  end
  if or wp_eq_t off n tg_ulong wp_eq_t off n ti_u64
    ret 4
  end
  if or wp_eq_t off n tg_byte wp_eq_t off n ti_i8
    ret 5
  end
  if or wp_eq_t off n tg_short wp_eq_t off n ti_i16
    ret 6
  end
  if or wp_eq_t off n tg_int wp_eq_t off n ti_i32
    ret 7
  end
  if or wp_eq_t off n tg_long wp_eq_t off n ti_i64
    ret 8
  end
  ret neg long 1
end

fn ref_word_wp off ulong n ulong to long
  if wp_eq_t off n tr_own
    ret 1
  end
  if wp_eq_t off n tr_edit
    ret 2
  end
  if wp_eq_t off n tr_view
    ret 3
  end
  ret neg long 1
end

fn op_word_wp off ulong n ulong to long
  if wp_eq_t off n to_add
    ret 0
  end
  if wp_eq_t off n to_sub
    ret 1
  end
  if wp_eq_t off n to_mul
    ret 2
  end
  if wp_eq_t off n to_div
    ret 3
  end
  if wp_eq_t off n to_rem
    ret 4
  end
  if wp_eq_t off n to_and
    ret 5
  end
  if wp_eq_t off n to_or
    ret 6
  end
  if wp_eq_t off n to_xor
    ret 7
  end
  if wp_eq_t off n to_shl
    ret 8
  end
  if wp_eq_t off n to_shr
    ret 9
  end
  if wp_eq_t off n to_eq
    ret 10
  end
  if wp_eq_t off n to_ne
    ret 11
  end
  if wp_eq_t off n to_lt
    ret 12
  end
  if wp_eq_t off n to_le
    ret 13
  end
  if wp_eq_t off n to_gt
    ret 14
  end
  if wp_eq_t off n to_ge
    ret 15
  end
  if wp_eq_t off n to_neg
    ret 16
  end
  if wp_eq_t off n to_not
    ret 17
  end
  if wp_eq_t off n to_get
    ret 18
  end
  if wp_eq_t off n to_new
    ret 19
  end
  ret neg long 1
end

fn kw_word_wp off ulong n ulong to long
  if wp_eq_t off n tk_fn
    ret 0
  end
  if wp_eq_t off n tk_to
    ret 1
  end
  if wp_eq_t off n tk_void
    ret 2
  end
  if wp_eq_t off n tk_end
    ret 3
  end
  if wp_eq_t off n tk_else
    ret 4
  end
  if wp_eq_t off n tk_if
    ret 5
  end
  if wp_eq_t off n tk_while
    ret 6
  end
  if wp_eq_t off n tk_for
    ret 7
  end
  if wp_eq_t off n tk_break
    ret 8
  end
  if wp_eq_t off n tk_ret
    ret 9
  end
  if wp_eq_t off n tk_trap
    ret 10
  end
  if wp_eq_t off n tk_put
    ret 11
  end
  if wp_eq_t off n tk_free
    ret 12
  end
  if wp_eq_t off n tk_true
    ret 13
  end
  if wp_eq_t off n tk_false
    ret 14
  end
  if wp_eq_t off n tk_bound
    ret 15
  end
  if wp_eq_t off n t_eqs
    ret 16
  end
  ret neg long 1
end

fn reserved_wp off ulong n ulong to bool
  if ge scalar_word_wp off n 0
    ret true
  end
  if ge ref_word_wp off n 0
    ret true
  end
  if ge op_word_wp off n 0
    ret true
  end
  if ge kw_word_wp off n 0
    ret true
  end
  ret false
end

fn is_term_wp off ulong n ulong to bool
  if wp_eq_t off n t_rpar
    ret true
  end
  k = kw_word_wp off n
  if and ge k 0 and ne k 13 ne k 14
    ret true
  end
  ret false
end

fn is_shift o ulong to bool
  ret or eq o OP_SHL eq o OP_SHR
end

fn is_cmp o ulong to bool
  ret and ge o OP_EQ le o OP_GE
end

fn is_arith o ulong to bool
  ret le o OP_REM
end

note ---- op pool emission ----
fn bops_c c uchar to void
  n = get g_st 40
  if ge n len g_bops
    nc = mul n 2
    if lt nc 4096
      nc = 4096
    end
    r = enlarge g_bops nc
    if lt r 0
      exit 2
    end
  end
  put g_bops n c
  put g_st 40 add n 1
end

fn bops_t s view uchar * to void
  n = len s
  for i ulong n bound 256
    bops_c get s i
  end
end

fn bops_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    bops_c 48
    ret
  end
  k = ulong 0
  while gt v 0 bound 32
    d = rem v 10
    put tmp k uchar add 48 d
    v = div v 10
    k = add k 1
  end
  while gt k 0 bound 32
    k = sub k 1
    bops_c get tmp k
  end
end

fn bops_fn fi ulong to void
  off = mul fi 64
  n = get g_fn_nlen fi
  for i ulong n bound 64
    bops_c get g_fn_name add off i
  end
end

fn bops_irop o ulong to void
  if eq o 0
    bops_t to_add
    ret
  end
  if eq o 1
    bops_t to_sub
    ret
  end
  if eq o 2
    bops_t to_mul
    ret
  end
  if eq o 3
    bops_t to_div
    ret
  end
  if eq o 4
    bops_t to_rem
    ret
  end
  if eq o 5
    bops_t to_and
    ret
  end
  if eq o 6
    bops_t to_or
    ret
  end
  if eq o 7
    bops_t to_xor
    ret
  end
  if eq o 8
    bops_t to_shl
    ret
  end
  if eq o 9
    bops_t to_shr
    ret
  end
  if eq o 10
    bops_t to_eq
    ret
  end
  if eq o 11
    bops_t to_ne
    ret
  end
  if eq o 12
    bops_t to_lt
    ret
  end
  if eq o 13
    bops_t to_le
    ret
  end
  if eq o 14
    bops_t to_gt
    ret
  end
  if eq o 15
    bops_t to_ge
    ret
  end
  bops_t to_neg
end

fn op_check_cur to long
  if eq get g_st 14 0
    err_start
    err_t te_dead_line
    ret neg long 1
  end
  ret 0
end

fn op_begin to long
  r = op_check_cur
  if lt r 0
    ret r
  end
  if ne get g_st 25 0
    ret 0
  end
  b = sub get g_st 14 1
  put g_st 45 b
  put g_st 46 get g_st 40
  ret 0
end

fn op_finish to void
  if ne get g_st 25 0
    ret
  end
  b = get g_st 45
  start = get g_st 46
  endp = get g_st 40
  oc = get g_st 41
  if ge oc len g_op_off
    nc = mul oc 2
    if lt nc 1024
      nc = 1024
    end
    r1 = enlarge g_op_off nc
    r2 = enlarge g_op_len nc
    r3 = enlarge g_op_next nc
    if or lt r1 0 or lt r2 0 lt r3 0
      exit 2
    end
  end
  put g_op_off oc start
  put g_op_len oc sub endp start
  put g_op_next oc neg long 1
  tail = get g_blk_tail b
  if lt tail 0
    put g_blk_head b long oc
  else
    put g_op_next ulong tail long oc
  end
  put g_blk_tail b long oc
  put g_blk_nops b add get g_blk_nops b 1
  put g_st 41 add oc 1
end

fn emit_br to_b ulong to long
  put g_blk_refd to_b 1
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_br
    bops_u64 to_b
    bops_c 64
    op_finish
  end
  put g_st 14 0
  ret 0
end

fn emit_mov dst ulong a ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_mov1
    bops_u64 dst
    bops_t tj_a
    bops_u64 a
    op_finish
  end
  ret 0
end

fn emit_cbr cond_r ulong th ulong el ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_cbr1
    bops_u64 cond_r
    bops_t tj_then
    bops_u64 th
    bops_t tj_else
    bops_u64 el
    bops_c 64
    op_finish
  end
  ret 0
end

fn emit_binop o ulong dst ulong a ulong b ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_op1
    bops_irop o
    bops_t tj_dst
    bops_u64 dst
    bops_t tj_a
    bops_u64 a
    bops_t tj_b
    bops_u64 b
    op_finish
  end
  ret 0
end

fn emit_unop is_neg ulong is_bool ulong dst ulong a ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_op1
    if ne is_neg 0
      bops_t to_neg
    else
      if ne is_bool 0
        bops_t to_not
      else
        bops_t tir_bnot
      end
    end
    bops_t tj_dst
    bops_u64 dst
    bops_t tj_a
    bops_u64 a
    op_finish
  end
  ret 0
end

fn emit_cast is_mov ulong dst ulong a ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    if ne is_mov 0
      bops_t tj_mov1
    else
      bops_t tj_op1
      bops_c 99
      bops_c 97
      bops_c 115
      bops_c 116
      bops_t tj_dst
    end
    bops_u64 dst
    bops_t tj_a
    bops_u64 a
    op_finish
  end
  ret 0
end

fn emit_load dst ulong arr ulong idx ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_load1
    bops_u64 dst
    bops_t tj_arr
    bops_u64 arr
    bops_t tj_idx
    bops_u64 idx
    op_finish
  end
  ret 0
end

fn emit_alloc dst ulong init_r ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_alloc1
    bops_u64 dst
    bops_t tj_init
    bops_u64 init_r
    op_finish
  end
  ret 0
end

fn emit_store arr ulong idx ulong val_r ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_store
    bops_u64 arr
    bops_t tj_idx
    bops_u64 idx
    bops_t tj_val
    bops_u64 val_r
    op_finish
  end
  ret 0
end

fn emit_release arr ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_rel
    bops_u64 arr
    op_finish
  end
  ret 0
end

fn emit_trap code ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_trap
    bops_u64 code
    op_finish
  end
  ret 0
end

fn emit_ret_void to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_ret0
    op_finish
  end
  ret 0
end

fn emit_ret_val a ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_reta
    bops_u64 a
    op_finish
  end
  ret 0
end

note ---- ownership helpers ----
fn msb64 x ulong to ulong
  r = ulong 0
  if ge x shl ulong 1 32
    x = shr x 32
    r = add r 32
  end
  if ge x shl ulong 1 16
    x = shr x 16
    r = add r 16
  end
  if ge x 256
    x = shr x 8
    r = add r 8
  end
  if ge x 16
    x = shr x 4
    r = add r 4
  end
  if ge x 4
    x = shr x 2
    r = add r 2
  end
  if ge x 2
    r = add r 1
  end
  ret r
end

fn below_mask f ulong to ulong
  if ge f 64
    ret sub ulong 0 1
  end
  ret sub shl ulong 1 f 1
end

fn own_slot r ulong to long
  nown = get g_st 16
  for s ulong nown bound 64
    if eq get g_own_reg s r
      ret long s
    end
  end
  ret neg long 1
end

fn own_track r ulong to void
  nown = get g_st 16
  if ge nown MAX_OWN
    ret
  end
  s = nown
  put g_st 16 add nown 1
  put g_own_reg s r
  nf = get g_st 15
  gl = get g_st 19
  for f ulong nf bound 64
    if ge f MAX_FRAMES
      break
    end
    fk = get g_fr_kind f
    isl = or eq fk F_WHILE eq fk F_FOR
    idx = add mul f MAX_OWN s
    put g_fr_oin_b idx uchar OS_U
    put g_fr_oin_m idx and gl below_mask f
    if isl
      put g_fr_oacc_b idx uchar OS_U
      put g_fr_oacc_m idx and gl below_mask add f 1
    else
      put g_fr_oacc_b idx uchar OS_U
      put g_fr_oacc_m idx and gl below_mask f
    end
    put g_fr_opost_b idx uchar OS_U
    put g_fr_opost_m idx and gl below_mask add f 1
  end
  pk1 = get g_st 18
  if gt pk1 0
    put g_opnd_b s uchar OS_U
    put g_opnd_m s and gl below_mask sub pk1 1
  end
  put g_ost_b s uchar OS_U
  put g_ost_m s gl
end

fn own_label r ulong to long
  nn = get g_st 9
  i = nn
  while gt i 0 bound 512
    i = sub i 1
    if eq get g_nm_reg i r
      ret long i
    end
  end
  ret neg long 1
end

fn os_none b uchar m ulong to bool
  ret and eq m 0 eq and ulong b OS_L 0
end

fn os_only b uchar m ulong to bool
  ret and eq m 0 eq ulong b OS_L
end

fn own_dead r ulong to bool
  s = own_slot r
  if lt s 0
    ret false
  end
  su = ulong s
  ret os_none get g_ost_b su get g_ost_m su
end

fn copy_nm_to_owq nq ulong ni long to void
  if ge ni 0
    nu = ulong ni
    nl = get g_nm_len nu
    put g_owq_nlen nq nl
    dst = mul nq 64
    src = mul nu 64
    for j ulong nl bound 64
      put g_owq_nm add dst j get g_nm_str add src j
    end
  else
    put g_owq_nlen nq 0
  end
end

fn own_defer kind ulong s ulong ob uchar om ulong to long
  k = msb64 om
  nq = get g_st 17
  for i ulong nq bound 256
    if ne get g_owq_k i k
      continue
    end
    if ne get g_owq_kind i kind
      continue
    end
    if ne get g_owq_s i s
      continue
    end
    if ne get g_owq_ob i ob
      continue
    end
    if eq get g_owq_om i om
      ret 0
    end
  end
  if ge nq MAX_OWQ
    err_start
    err_t te_max_owq
    ret neg long 1
  end
  put g_owq_k nq k
  put g_owq_kind nq kind
  put g_owq_s nq s
  put g_owq_line nq get g_st 4
  put g_owq_ob nq ob
  put g_owq_om nq om
  copy_nm_to_owq nq own_label get g_own_reg s
  put g_st 17 add nq 1
  ret 0
end

fn err_own_lbl r ulong to void
  ni = own_label r
  if ge ni 0
    err_nm ulong ni
  else
    err_t tr_own
  end
end

fn own_use r ulong to long
  s = own_slot r
  if lt s 0
    ret 0
  end
  su = ulong s
  ob = get g_ost_b su
  om = get g_ost_m su
  if os_none ob om
    err_start
    err_c 39
    err_own_lbl r
    err_t te_own_dead
    ret neg long 1
  end
  if and ne om 0 eq and ulong ob OS_L 0
    ret own_defer OW_USE su ob om
  end
  ret 0
end

fn own_kill r ulong to long
  rc = own_use r
  if lt rc 0
    ret rc
  end
  s = own_slot r
  if ge s 0
    su = ulong s
    put g_ost_b su uchar OS_D
    put g_ost_m su 0
  end
  ret 0
end

fn own_birth r ulong to long
  s = own_slot r
  if lt s 0
    ret 0
  end
  su = ulong s
  ob = get g_ost_b su
  om = get g_ost_m su
  if and eq om 0 ne and ulong ob OS_L 0
    err_start
    err_c 39
    err_own_lbl r
    err_t te_own_leak
    ret neg long 1
  end
  if ne om 0
    rc = own_defer OW_BIRTH su ob om
    if lt rc 0
      ret rc
    end
  end
  put g_ost_b su uchar OS_L
  put g_ost_m su 0
  ret 0
end

fn own_release r ulong to long
  s = own_slot r
  if lt s 0
    ret 0
  end
  su = ulong s
  ob = get g_ost_b su
  om = get g_ost_m su
  if os_none ob om
    err_start
    err_c 39
    err_own_lbl r
    err_t te_own_dbl
    ret neg long 1
  end
  if and ne om 0 eq and ulong ob OS_L 0
    rc = own_defer OW_FREE su ob om
    if lt rc 0
      ret rc
    end
  end
  put g_ost_b su uchar OS_D
  put g_ost_m su 0
  ret 0
end

fn own_mov dst ulong a ulong to long
  if ne ty_ref get g_regs a R_OWN
    ret 0
  end
  if eq ty_ref get g_regs dst R_OWN
    rc = own_kill a
    if lt rc 0
      ret rc
    end
    ret own_birth dst
  end
  ret own_use a
end

fn own_ret to long
  nown = get g_st 16
  for s ulong nown bound 64
    ob = get g_ost_b s
    om = get g_ost_m s
    if and eq om 0 ne and ulong ob OS_L 0
      ni = own_label get g_own_reg s
      err_start
      if ge ni 0
        err_c 39
        err_nm ulong ni
        err_t te_own_ret
      else
        err_t te_own_ret_oos
      end
      ret neg long 1
    end
  end
  for s ulong nown bound 64
    om = get g_ost_m s
    if ne om 0
      rc = own_defer OW_RET s get g_ost_b s om
      if lt rc 0
        ret rc
      end
    end
  end
  ret 0
end

fn own_loop_open to long
  k = get g_st 15
  if ge k MAX_FRAMES
    err_start
    err_t te_max_frames
    ret neg long 1
  end
  nown = get g_st 16
  bit = shl ulong 1 k
  for s ulong nown bound 64
    put g_opnd_b s get g_ost_b s
    put g_opnd_m s get g_ost_m s
    put g_ost_b s 0
    put g_ost_m s bit
  end
  put g_st 18 add k 1
  put g_st 19 or get g_st 19 bit
  ret 0
end

fn own_loop_pushed fi ulong to void
  nown = get g_st 16
  base = mul fi MAX_OWN
  for s ulong nown bound 64
    idx = add base s
    put g_fr_oin_b idx get g_opnd_b s
    put g_fr_oin_m idx get g_opnd_m s
    put g_fr_opost_b idx get g_ost_b s
    put g_fr_opost_m idx get g_ost_m s
  end
  put g_fr_ohas fi 0
  put g_st 18 0
end

fn err_owq_nm i ulong to void
  enl = get g_owq_nlen i
  if gt enl 0
    off = mul i 64
    for j ulong enl bound 64
      err_c get g_owq_nm add off j
    end
  else
    err_t te_own_oos
  end
end

fn owq_move keep ulong i ulong to void
  if eq keep i
    ret
  end
  put g_owq_k keep get g_owq_k i
  put g_owq_kind keep get g_owq_kind i
  put g_owq_s keep get g_owq_s i
  put g_owq_line keep get g_owq_line i
  put g_owq_ob keep get g_owq_ob i
  put g_owq_om keep get g_owq_om i
  enl = get g_owq_nlen i
  put g_owq_nlen keep enl
  dst = mul keep 64
  src = mul i 64
  for j ulong enl bound 64
    put g_owq_nm add dst j get g_owq_nm add src j
  end
end

fn owq_check_closed i ulong eb uchar to long
  ekind = get g_owq_kind i
  has_l = ne and ulong eb OS_L 0
  if and or eq ekind OW_USE eq ekind OW_FREE not has_l
    err_start
    err_c 39
    err_owq_nm i
    err_t te_own_luse1
    err_u64 get g_owq_line i
    err_t te_own_luse2
    ret neg long 1
  end
  if and eq ekind OW_BIRTH has_l
    err_start
    err_c 39
    err_owq_nm i
    err_t te_own_lbirth1
    err_u64 get g_owq_line i
    err_t te_own_lbirth2
    ret neg long 1
  end
  if and eq ekind OW_RET has_l
    err_start
    err_c 39
    err_owq_nm i
    err_t te_own_lret1
    err_u64 get g_owq_line i
    err_t te_own_lret2
    ret neg long 1
  end
  ret 0
end

fn own_loop_close_owq k ulong kb ulong to long
  nq = get g_st 17
  keep = ulong 0
  for i ulong nq bound 256
    if eq get g_owq_k i k
      es = get g_owq_s i
      eb = get g_owq_ob i
      em = get g_owq_om i
      if ne and em kb 0
        eb = uchar or ulong eb ulong get g_hb es
        em = or and em xor kb sub ulong 0 1 get g_hm es
      end
      if ne em 0
        put g_owq_k i msb64 em
        put g_owq_ob i eb
        put g_owq_om i em
      else
        if lt owq_check_closed i eb 0
          ret neg long 1
        end
        continue
      end
    end
    owq_move keep i
    keep = add keep 1
  end
  put g_st 17 keep
  ret 0
end

fn own_loop_close_slot k ulong s ulong to void
  kb = shl ulong 1 k
  nkb = xor kb sub ulong 0 1
  idx = add mul k MAX_OWN s
  hsb = get g_fr_oin_b idx
  hsm = get g_fr_oin_m idx
  if gt get g_st 14 0
    hsb = uchar or ulong hsb ulong get g_ost_b s
    hsm = or hsm and get g_ost_m s nkb
  end
  put g_hb s hsb
  put g_hm s hsm
  xb = get g_fr_opost_b idx
  xm = get g_fr_opost_m idx
  if ne and xm kb 0
    xb = uchar or ulong xb ulong hsb
    xm = or and xm nkb hsm
  end
  if ne get g_fr_ohas k 0
    ab = get g_fr_oacc_b idx
    am = get g_fr_oacc_m idx
    if ne and am kb 0
      ab = uchar or ulong ab ulong hsb
      am = or and am nkb hsm
    end
    xb = uchar or ulong xb ulong ab
    xm = or xm am
  end
  put g_ost_b s xb
  put g_ost_m s xm
end

fn own_loop_close k ulong to long
  kb = shl ulong 1 k
  nown = get g_st 16
  for s ulong nown bound 64
    own_loop_close_slot k s
  end
  put g_st 19 and get g_st 19 xor kb sub ulong 0 1
  ret own_loop_close_owq k kb
end

fn own_save_oin fi ulong to void
  nown = get g_st 16
  base = mul fi MAX_OWN
  for s ulong nown bound 64
    put g_fr_oin_b add base s get g_ost_b s
    put g_fr_oin_m add base s get g_ost_m s
  end
end

fn own_save_oacc fi ulong to void
  nown = get g_st 16
  base = mul fi MAX_OWN
  for s ulong nown bound 64
    put g_fr_oacc_b add base s get g_ost_b s
    put g_fr_oacc_m add base s get g_ost_m s
  end
end

fn own_join_oacc fi ulong has ulong to void
  nown = get g_st 16
  base = mul fi MAX_OWN
  for s ulong nown bound 64
    idx = add base s
    if ne has 0
      put g_fr_oacc_b idx uchar or ulong get g_fr_oacc_b idx ulong get g_ost_b s
      put g_fr_oacc_m idx or get g_fr_oacc_m idx get g_ost_m s
    else
      put g_fr_oacc_b idx get g_ost_b s
      put g_fr_oacc_m idx get g_ost_m s
    end
  end
end

fn own_if_end fi ulong to void
  hels = ne get g_fr_hels fi 0
  if and hels eq get g_fr_ohas fi 0
    ret
  end
  nown = get g_st 16
  base = mul fi MAX_OWN
  has_cur = gt get g_st 14 0
  for s ulong nown bound 64
    idx = add base s
    ob = uchar 0
    om = ulong 0
    if hels
      ob = get g_fr_oacc_b idx
      om = get g_fr_oacc_m idx
    else
      ob = get g_fr_oin_b idx
      om = get g_fr_oin_m idx
    end
    if has_cur
      put g_ost_b s uchar or ulong get g_ost_b s ulong ob
      put g_ost_m s or get g_ost_m s om
    else
      put g_ost_b s ob
      put g_ost_m s om
    end
  end
end

note ---- regs, blocks, names, funcs ----
fn new_reg t ulong to long
  nr = get g_st 7
  if ge nr MAX_REGS
    err_start
    err_t te_max_regs
    ret neg long 1
  end
  put g_regs nr t
  if eq ty_ref t R_OWN
    own_track nr
  end
  put g_st 7 add nr 1
  ret long nr
end

fn new_block to long
  nb = get g_st 12
  if ge nb MAX_BLOCKS
    err_start
    err_t te_max_blks
    ret neg long 1
  end
  put g_blk_nops nb 0
  put g_blk_ord nb neg long 1
  put g_blk_refd nb 0
  put g_blk_head nb neg long 1
  put g_blk_tail nb neg long 1
  put g_st 12 add nb 1
  ret long nb
end

fn start_block b ulong to void
  no = get g_st 13
  put g_blk_ord b long no
  put g_st 13 add no 1
  put g_st 14 add b 1
end

fn find_name_wp off ulong n ulong to long
  nn = get g_st 9
  i = nn
  while gt i 0 bound 512
    i = sub i 1
    if wp_eq_nm off n i
      ret long i
    end
  end
  ret neg long 1
end

fn find_func_wp off ulong n ulong to long
  nf = get g_st 5
  for i ulong nf bound 32
    if wp_eq_fn off n i
      ret long i
    end
  end
  ret neg long 1
end

fn find_callable_wp off ulong n ulong to long
  g = find_func_wp off n
  if lt g 0
    ret neg long 1
  end
  if and ne get g_st 6 0 eq ulong g sub get g_st 5 1
    ret neg long 1
  end
  ret g
end

fn check_new_name_wp off ulong n ulong to long
  if not valid_ident_wp off n
    err_start
    err_c 39
    err_wp off n
    err_t te_not_name
    ret neg long 1
  end
  if reserved_wp off n
    err_start
    err_c 39
    err_wp off n
    err_t te_is_kw
    ret neg long 1
  end
  if ge find_func_wp off n 0
    err_start
    err_c 39
    err_wp off n
    err_t te_is_fn
    ret neg long 1
  end
  if ge find_name_wp off n 0
    err_start
    err_c 39
    err_wp off n
    err_t te_dup_name
    ret neg long 1
  end
  ret 0
end

fn bind_name_wp off ulong n ulong reg ulong fixed ulong to long
  rc = check_new_name_wp off n
  if lt rc 0
    ret rc
  end
  nn = get g_st 9
  if ge nn MAX_NAMES
    err_start
    err_t te_max_names
    ret neg long 1
  end
  dst = mul nn 64
  for i ulong n bound 64
    put g_nm_str add dst i get g_wpool add off i
  end
  put g_nm_len nn n
  put g_nm_reg nn reg
  put g_nm_dep nn get g_st 10
  put g_nm_fix nn fixed
  put g_nm_rd nn 0
  put g_st 9 add nn 1
  ret 0
end

fn pop_scope to long
  dep = get g_st 10
  nn = get g_st 9
  while gt nn 0 bound 512
    idx = sub nn 1
    if le get g_nm_dep idx sub dep 1
      break
    end
    if and eq get g_nm_fix idx 0 eq get g_nm_rd idx 0
      put g_st 9 nn
      err_start
      err_c 39
      err_nm idx
      err_t te_unread
      ret neg long 1
    end
    nn = idx
  end
  put g_st 9 nn
  put g_st 10 sub dep 1
  ret 0
end

note ---- literals ----
fn parse_lit_wp off ulong n ulong to bool
  if eq n 0
    ret false
  end
  p = ulong 0
  is_neg = ulong 0
  if eq get g_wpool off 45
    is_neg = 1
    p = 1
  end
  if ge p n
    ret false
  end
  c0 = get g_wpool add off p
  if not is_digit c0
    ret false
  end
  if and eq c0 48 gt sub n p 1
    ret false
  end
  v = ulong 0
  umax = sub ulong 0 1
  while lt p n bound 64
    c = get g_wpool add off p
    if not is_digit c
      ret false
    end
    d = ulong sub c 48
    if gt v div sub umax d 10
      ret false
    end
    v = add mul v 10 d
    p = add p 1
  end
  if and ne is_neg 0 eq v 0
    ret false
  end
  put g_st 47 is_neg
  put g_st 48 v
  ret true
end

fn is_lit_wp off ulong n ulong to bool
  if or wp_eq_t off n tk_true wp_eq_t off n tk_false
    ret true
  end
  ret parse_lit_wp off n
end

fn lit_conv_wp off ulong n ulong s ulong to ulong
  put g_st 47 0
  put g_st 48 0
  if eq s T_BOOL
    if wp_eq_t off n tk_true
      put g_st 48 1
      ret 0
    end
    if wp_eq_t off n tk_false
      put g_st 48 0
      ret 0
    end
    ret 1
  end
  if not parse_lit_wp off n
    ret 2
  end
  is_neg = get g_st 47
  mag = get g_st 48
  if and ne is_neg 0 and not is_signed s ne mag 0
    ret 3
  end
  b = scalar_bits s
  if is_signed s
    b = sub b 1
  end
  lim = sub ulong 0 1
  if lt b 64
    lim = sub shl ulong 1 b 1
  end
  if ne is_neg 0
    if gt mag add lim 1
      ret 4
    end
  else
    if gt mag lim
      ret 4
    end
  end
  if and ne is_neg 0 eq mag 0
    put g_st 47 0
  end
  ret 0
end

fn lit_fits_wp off ulong n ulong m ulong to ulong
  r = ulong 0
  for s ulong T_NSCALAR bound 16
    if ne and shr m s 1 0
      if eq lit_conv_wp off n s 0
        r = or r shl ulong 1 s
      end
    end
  end
  ret r
end

fn lit_reg_wp off ulong n ulong t ulong to long
  if ne ty_ref t R_NONE
    err_start
    err_c 39
    err_wp off n
    err_t te_num_arr
    ret neg long 1
  end
  s = ty_s t
  rc = lit_conv_wp off n s
  if eq rc 1
    err_start
    err_c 39
    err_wp off n
    err_t te_not_bool
    ret neg long 1
  end
  if eq rc 2
    err_start
    err_c 39
    err_wp off n
    err_t te_not_whole
    err_gw s
    ret neg long 1
  end
  if eq rc 3
    err_start
    err_gw s
    err_t te_cant_neg
    err_wp off n
    err_c 41
    ret neg long 1
  end
  if eq rc 4
    err_start
    err_wp off n
    err_t te_no_fit
    err_gw s
    ret neg long 1
  end
  is_neg = get g_st 47
  mag = get g_st 48
  nc = get g_st 11
  for i ulong nc bound 256
    if ne get g_ck_t i t
      continue
    end
    if ne get g_ck_neg i is_neg
      continue
    end
    if eq get g_ck_mag i mag
      ret long get g_ck_reg i
    end
  end
  if ge nc MAX_CONSTS
    err_start
    err_t te_max_consts
    ret neg long 1
  end
  r = new_reg t
  if lt r 0
    ret r
  end
  put g_ck_t nc t
  put g_ck_neg nc is_neg
  put g_ck_mag nc mag
  put g_ck_reg nc ulong r
  put g_st 11 add nc 1
  ret r
end

fn lit_reg_t s view uchar * t ulong to long
  saved = get g_st 31
  off = wp_push_t s
  r = lit_reg_wp off len s t
  put g_st 31 saved
  ret r
end

note ---- want & type binding ----
fn binds p ulong a ulong to bool
  pr = ty_ref p
  ar = ty_ref a
  if or eq pr R_NONE eq ar R_NONE
    ret eq p a
  end
  if or ne ty_s p ty_s a ne ty_len p ty_len a
    ret false
  end
  if eq pr R_SHARED
    ret true
  end
  if and eq pr R_MUT ne ar R_SHARED
    ret true
  end
  ret and eq pr R_OWN eq ar R_OWN
end

fn ref_ok rf ulong a ulong to bool
  ar = ty_ref a
  if eq ar R_NONE
    ret false
  end
  if eq rf R_SHARED
    ret true
  end
  if and eq rf R_MUT ne ar R_SHARED
    ret true
  end
  ret eq ar R_OWN
end

fn want_pack scal ulong arr ulong lit ulong top ulong p ulong lt_t ulong to ulong
  v = or scal or shl arr 9 or shl lit 11 shl top 13
  ret or v or shl p 16 shl lt_t 32
end

fn want_scal w ulong to ulong
  ret and w 511
end

fn want_arr w ulong to ulong
  ret and shr w 9 3
end

fn want_lit w ulong to ulong
  ret and shr w 11 3
end

fn want_top w ulong to ulong
  ret and shr w 13 1
end

fn want_p w ulong to ulong
  ret and shr w 16 65535
end

fn want_lt w ulong to ulong
  ret and shr w 32 65535
end

fn want_set_top w ulong top ulong to ulong
  w = and w xor shl ulong 1 13 sub ulong 0 1
  ret or w shl top 13
end

fn want_type t ulong to ulong
  if eq ty_ref t R_NONE
    ret want_pack shl ulong 1 ty_s t A_NONE L_TYPED 0 0 t
  end
  ret want_pack 0 A_EXACT L_NO 0 t 0
end

fn want_param p ulong to ulong
  if eq ty_ref p R_NONE
    ret want_type p
  end
  ret want_pack 0 A_BIND L_NO 0 p 0
end

fn want_ok w ulong t ulong to bool
  if eq ty_ref t R_NONE
    ret ne and shr want_scal w ty_s t 1 0
  end
  wa = want_arr w
  if eq wa A_ANY
    ret true
  end
  if eq wa A_EXACT
    ret eq want_p w t
  end
  if eq wa A_BIND
    ret binds want_p w t
  end
  ret false
end

note ---- fill_word & fill_text ----
fn fill_word_wp off ulong n ulong to long
  ln = get g_st 20
  if ge ln MAX_FILL
    err_start
    err_t te_no_comp
    ret neg long 1
  end
  if eq get g_st 30 0
    put g_st 30 add ln 1
  end
  base = get g_st 23
  put g_lw_off add base ln off
  put g_lw_len add base ln n
  put g_st 20 add ln 1
  ret 0
end

fn fill_word_t s view uchar * to long
  off = wp_push_t s
  ret fill_word_wp off len s
end

fn fill_word_gw s ulong to long
  if eq s 0
    ret fill_word_t tg_bool
  end
  if eq s 1
    ret fill_word_t tg_uchar
  end
  if eq s 2
    ret fill_word_t tg_ushort
  end
  if eq s 3
    ret fill_word_t tg_uint
  end
  if eq s 4
    ret fill_word_t tg_ulong
  end
  if eq s 5
    ret fill_word_t tg_byte
  end
  if eq s 6
    ret fill_word_t tg_short
  end
  if eq s 7
    ret fill_word_t tg_int
  end
  ret fill_word_t tg_long
end

fn fill_word_nm idx ulong to long
  off = get g_st 31
  src = mul idx 64
  nl = get g_nm_len idx
  for i ulong nl bound 64
    wp_push_c get g_nm_str add src i
  end
  ret fill_word_wp off nl
end

fn fill_word_u64 v ulong to long
  tmp = new uchar 24 0
  off = get g_st 31
  if eq v 0
    wp_push_c 48
    ret fill_word_wp off 1
  end
  k = ulong 0
  while gt v 0 bound 32
    d = rem v 10
    put tmp k uchar add 48 d
    v = div v 10
    k = add k 1
  end
  n = k
  while gt k 0 bound 32
    k = sub k 1
    wp_push_c get tmp k
  end
  ret fill_word_wp off n
end

fn fill_text_genb to long
  n = get g_genb_n 0
  i = ulong 0
  while lt i n bound 65536
    j = i
    while lt j n bound 65536
      if eq get g_genb j 32
        break
      end
      j = add j 1
    end
    k = sub j i
    if gt k NAME_MAX_LEN
      err_start
      err_t te_no_comp
      ret neg long 1
    end
    if gt k 0
      off = get g_st 31
      for p ulong k bound 64
        wp_push_c get g_genb add i p
      end
      rc = fill_word_wp off k
      if lt rc 0
        ret rc
      end
    end
    i = j
    if lt i n
      i = add i 1
    end
  end
  ret 0
end

fn parse_type to long
  lp = get g_st 21
  ln = get g_st 20
  if ge lp ln
    if eq get g_st 24 0
      err_start
      err_t te_type_miss
      ret neg long 1
    end
    rc = fill_word_t tg_uint
    if lt rc 0
      ret rc
    end
    ln = get g_st 20
  end
  s = scalar_word_wp w_off lp w_len lp
  if ge s 0
    put g_st 21 add lp 1
    ret long ty_make R_NONE ulong s 0
  end
  rf = ref_word_wp w_off lp w_len lp
  if lt rf 0
    err_start
    err_c 39
    err_w lp
    err_t te_not_type
    ret neg long 1
  end
  if and ge add lp 2 ln eq get g_st 24 0
    err_start
    err_t te_arr_type1
    err_refw ulong rf
    err_t te_arr_type2
    ret neg long 1
  end
  if ge add lp 1 ln
    rc = fill_word_t tg_uint
    if lt rc 0
      ret rc
    end
    ln = get g_st 20
  end
  s = scalar_word_wp w_off add lp 1 w_len add lp 1
  if lt s 0
    err_start
    err_c 39
    err_w add lp 1
    err_t te_not_elem
    ret neg long 1
  end
  if ge add lp 2 ln
    rc = fill_word_t t_1
    if lt rc 0
      ret rc
    end
    ln = get g_st 20
  end
  ok = parse_lit_wp w_off add lp 2 w_len add lp 2
  alen = get g_st 48
  if or not ok or ne get g_st 47 0 or lt alen 1 gt alen 64
    err_start
    err_t te_arr_len1
    err_w add lp 2
    err_t te_arr_len2
    ret neg long 1
  end
  put g_st 21 add lp 3
  ret long ty_make ulong rf ulong s alen
end

note ---- completion helpers ----
fn make_fresh_name to void
  tmp = new uchar 24 0
  k = ulong 0
  while lt k 100000 bound 100000
    put g_fresh 0 119
    fl = ulong 1
    if eq k 0
      put g_fresh 1 48
      fl = 2
    else
      v = k
      tk = ulong 0
      while gt v 0 bound 24
        put tmp tk uchar add 48 rem v 10
        v = div v 10
        tk = add tk 1
      end
      while gt tk 0 bound 24
        tk = sub tk 1
        put g_fresh fl get tmp tk
        fl = add fl 1
      end
    end
    saved = get g_st 31
    off = saved
    for i ulong fl bound 32
      wp_push_c get g_fresh i
    end
    used = or ge find_name_wp off fl 0 ge find_func_wp off fl 0
    ln = get g_st 20
    for i ulong ln bound 1024
      if used
        break
      end
      if wp_eq_wp w_off i w_len i off fl
        used = true
      end
    end
    put g_st 31 saved
    if not used
      put g_fresh_n 0 fl
      ret
    end
    k = add k 1
  end
end

fn fill_fresh_name to long
  make_fresh_name
  off = get g_st 31
  fl = get g_fresh_n 0
  for i ulong fl bound 32
    wp_push_c get g_fresh i
  end
  ret fill_word_wp off fl
end

fn in_r i ulong to bool
  if eq get g_st 26 0
    ret false
  end
  if ne get g_nm_fix i 0
    ret false
  end
  if ne get g_nm_rd i 0
    ret false
  end
  if lt get g_nm_dep i get g_st 27
    ret false
  end
  if ne get g_taken i 0
    ret false
  end
  ret true
end

fn pick_array w ulong to long
  best = neg long 1
  nn = get g_st 9
  for i ulong nn bound 512
    reg = get g_nm_reg i
    t = get g_regs reg
    if or eq ty_ref t R_NONE or not want_ok w t own_dead reg
      continue
    end
    if in_r i
      ret long i
    end
    if lt best 0
      best = long i
    end
  end
  ret best
end

fn args_exist fi ulong to bool
  np = get g_fn_np fi
  base = mul fi MAX_PARAMS
  for k ulong np bound 8
    pt = get g_fn_p add base k
    if eq ty_ref pt R_NONE
      continue
    end
    if lt pick_array want_param pt 0
      ret false
    end
  end
  ret true
end

fn gives_int fi ulong to bool
  if and ne get g_st 6 0 eq fi sub get g_st 5 1
    ret false
  end
  if eq get g_fn_hret fi 0
    ret false
  end
  rt = get g_fn_ret fi
  if or ne ty_ref rt R_NONE eq ty_s rt T_BOOL
    ret false
  end
  ret args_exist fi
end

fn call_text_tl use2 ulong fi ulong s ulong has_bx ulong to void
  rt = get g_fn_ret fi
  if ne ty_s rt s
    tl_gw use2 s
    tl_c use2 32
  end
  tl_fn use2 fi
  np = get g_fn_np fi
  base = mul fi MAX_PARAMS
  for k ulong np bound 8
    pt = get g_fn_p add base k
    if eq ty_ref pt R_NONE
      if and eq ty_s pt T_BOOL ne has_bx 0
        tl_c use2 32
        tl_bx use2
        has_bx = 0
      else
        tl_c use2 32
        if eq ty_s pt T_BOOL
          tl_t use2 tk_true
        else
          tl_c use2 48
        end
      end
      continue
    end
    ai = pick_array want_param pt
    au = ulong ai
    put g_taken au 1
    tl_c use2 32
    tl_nm use2 au
  end
end

fn join_terms_to_genb n ulong s ulong is_typed ulong to void
  if eq n 0
    if eq is_typed 0
      genb_gw s
      genb_c 32
    end
    if eq s T_BOOL
      genb_t tk_true
    else
      genb_c 48
    end
    ret
  end
  p = ulong 0
  tlen = get g_tl_n 0
  for k ulong n bound 1024
    e = p
    while lt e tlen bound 65536
      if eq get g_tl e 10
        break
      end
      e = add e 1
    end
    if lt k sub n 1
      if eq s T_BOOL
        genb_t to_and
      else
        genb_t to_add
      end
      genb_c 32
    end
    for j ulong sub e p bound 4096
      genb_c get g_tl add p j
    end
    if lt k sub n 1
      genb_c 32
    end
    p = add e 1
  end
end

fn join_terms_to_bx n ulong to void
  if eq n 0
    bx_t tk_true
    ret
  end
  p = ulong 0
  tlen = get g_tl2_n 0
  for k ulong n bound 1024
    e = p
    while lt e tlen bound 65536
      if eq get g_tl2 e 10
        break
      end
      e = add e 1
    end
    if lt k sub n 1
      bx_t to_and
      bx_c 32
      for j ulong sub e p bound 4096
        bx_c get g_tl2 add p j
      end
      bx_c 32
    else
      for j ulong sub e p bound 4096
        bx_c get g_tl2 add p j
      end
    end
    p = add e 1
  end
end

fn gen_scalar_bool_to_bx to void
  put g_tl2_n 0 0
  put g_bx_n 0 0
  n = ulong 0
  nn = get g_st 9
  for i ulong nn bound 512
    if not in_r i
      continue
    end
    t = get g_regs get g_nm_reg i
    rf = ty_ref t
    ts = ty_s t
    if and eq rf R_NONE eq ts T_BOOL
      tl_nm 1 i
      tl_c 1 10
    else
      if eq rf R_NONE
        tl_t 1 to_eq
        tl_c 1 32
        tl_nm 1 i
        tl_c 1 32
        tl_nm 1 i
        tl_c 1 10
      else
        if eq ts T_BOOL
          tl_t 1 to_get
          tl_c 1 32
          tl_nm 1 i
          tl_c 1 32
          tl_c 1 48
          tl_c 1 10
        else
          tl_t 1 to_eq
          tl_c 1 32
          tl_t 1 to_get
          tl_c 1 32
          tl_nm 1 i
          tl_c 1 32
          tl_c 1 48
          tl_c 1 32
          tl_c 1 48
          tl_c 1 10
        end
      end
    end
    put g_taken i 1
    n = add n 1
  end
  join_terms_to_bx n
end

fn find_bool_int_fn to long
  nf = get g_st 5
  for g ulong nf bound 32
    if gives_int g
      np = get g_fn_np g
      base = mul g MAX_PARAMS
      for k ulong np bound 8
        pt = get g_fn_p add base k
        if and eq ty_ref pt R_NONE eq ty_s pt T_BOOL
          ret long g
        end
      end
    end
  end
  ret neg long 1
end

fn fn_binds_arr g ulong t ulong to bool
  if not gives_int g
    ret false
  end
  np = get g_fn_np g
  base = mul g MAX_PARAMS
  for k ulong np bound 8
    pt = get g_fn_p add base k
    if and ne ty_ref pt R_NONE binds pt t
      ret true
    end
  end
  ret false
end

fn gen_scalar_needb s ulong to ulong
  h = find_bool_int_fn
  if ge h 0
    gen_scalar_bool_to_bx
    call_text_tl 0 ulong h s 1
    tl_c 0 10
    ret 1
  end
  added = ulong 0
  nn = get g_st 9
  nf = get g_st 5
  for i ulong nn bound 512
    if not in_r i
      continue
    end
    t = get g_regs get g_nm_reg i
    if eq ty_ref t R_NONE
      continue
    end
    g = ulong 0
    while and lt g nf in_r i bound 256
      if fn_binds_arr g t
        call_text_tl 0 g s 0
        tl_c 0 10
        added = add added 1
      else
        g = add g 1
      end
    end
  end
  ret added
end

fn gen_scalar_to_genb s ulong is_typed ulong to void
  put g_tl_n 0 0
  n = ulong 0
  needb = ulong 0
  nn = get g_st 9
  for i ulong nn bound 512
    if not in_r i
      continue
    end
    t = get g_regs get g_nm_reg i
    rf = ty_ref t
    ts = ty_s t
    if eq s T_BOOL
      if and eq rf R_NONE eq ts T_BOOL
        tl_nm 0 i
        tl_c 0 10
      else
        if eq rf R_NONE
          tl_t 0 to_eq
          tl_c 0 32
          tl_nm 0 i
          tl_c 0 32
          tl_nm 0 i
          tl_c 0 10
        else
          if eq ts T_BOOL
            tl_t 0 to_get
            tl_c 0 32
            tl_nm 0 i
            tl_c 0 32
            tl_c 0 48
            tl_c 0 10
          else
            tl_t 0 to_eq
            tl_c 0 32
            tl_t 0 to_get
            tl_c 0 32
            tl_nm 0 i
            tl_c 0 32
            tl_c 0 48
            tl_c 0 32
            tl_c 0 48
            tl_c 0 10
          end
        end
      end
      put g_taken i 1
      n = add n 1
    else
      if eq ts T_BOOL
        needb = 1
      else
        if eq rf R_NONE
          if ne ts s
            tl_gw 0 s
            tl_c 0 32
          end
          tl_nm 0 i
          tl_c 0 10
        else
          if ne ts s
            tl_gw 0 s
            tl_c 0 32
          end
          tl_t 0 to_get
          tl_c 0 32
          tl_nm 0 i
          tl_c 0 32
          tl_c 0 48
          tl_c 0 10
        end
        put g_taken i 1
        n = add n 1
      end
    end
  end
  if ne needb 0
    n = add n gen_scalar_needb s
  end
  join_terms_to_genb n s is_typed
end

fn gen_value_arr w ulong to long
  ai = pick_array w
  if ge ai 0
    genb_nm ulong ai
    ret fill_text_genb
  end
  nn = get g_st 9
  for rf ulong 3 bound 4
    rfv = add rf 1
    for k ulong nn bound 512
      reg = get g_nm_reg k
      t = get g_regs reg
      if ref_ok rfv t
        if and want_ok w ty_make rfv ty_s t ty_len t not own_dead reg
          genb_refw rfv
          genb_c 32
          genb_nm k
          ret fill_text_genb
        end
      end
    end
  end
  wp = want_p w
  if and ne want_top w 0 and eq want_arr w A_EXACT eq ty_ref wp R_OWN
    genb_t to_new
    genb_c 32
    genb_gw ty_s wp
    genb_c 32
    genb_u64 ty_len wp
    genb_c 32
    if eq ty_s wp T_BOOL
      genb_t tk_false
    else
      genb_c 48
    end
    ret fill_text_genb
  end
  err_start
  err_t te_no_arr
  ret neg long 1
end

fn gen_value w ulong to long
  nn = get g_st 9
  for i ulong nn bound 512
    put g_taken i 0
  end
  put g_genb_n 0 0
  if eq want_scal w 0
    ret gen_value_arr w
  end
  m = want_scal w
  nr = ulong 0
  for i ulong nn bound 512
    if in_r i
      nr = add nr 1
    end
  end
  s = neg long 1
  if and gt nr 0 ne and m 1 0
    s = long T_BOOL
  else
    if and eq want_lit w L_TYPED ne and shr m ty_s want_lt w 1 0
      s = long ty_s want_lt w
    else
      if ne and shr m T_U32 1 0
        s = long T_U32
      else
        k = ulong 1
        while and lt k T_NSCALAR lt s 0 bound 16
          if ne and shr m k 1 0
            s = long k
          end
          k = add k 1
        end
      end
    end
  end
  if lt s 0
    s = long T_BOOL
  end
  su = ulong s
  is_t = ulong 0
  if and eq want_lit w L_TYPED eq ty_s want_lt w su
    is_t = 1
  end
  gen_scalar_to_genb su is_t
  ret fill_text_genb
end

fn chain_floor to ulong
  k = sub get g_st 15 1
  while gt k 0 bound 64
    if ne get g_fr_kind k F_IF
      break
    end
    if eq get g_fr_hels k 0
      break
    end
    if ge get g_fr_join k 0
      break
    end
    k = sub k 1
  end
  ret get g_fr_dep k
end

note ---- Val stack & expression helpers ----
fn val_alloc to ulong
  vi = get g_st 42
  put g_st 42 add vi 1
  put g_v_lit vi 0
  put g_v_word vi neg long 1
  put g_v_reg vi neg long 1
  put g_v_konst vi 0
  put g_v_head vi neg long 1
  put g_v_arity vi 0
  put g_v_paren vi 0
  put g_v_a vi get g_st 21
  put g_v_b vi 0
  put g_v_t vi 0
  ret vi
end

fn to_dst dst long t ulong to long
  if ge dst 0
    dt = get g_regs ulong dst
    if ne dt t
      err_start
      err_t te_write_type1
      err_ty t
      err_t te_write_type2
      err_ty dt
      ret neg long 1
    end
    ret dst
  end
  ret new_reg t
end

fn leaf vi ulong r ulong t ulong dst long to long
  put g_v_t vi t
  put g_v_b vi get g_st 21
  if eq dst neg long 2
    put g_v_reg vi long r
    ret 0
  end
  d = to_dst dst t
  if lt d 0
    ret d
  end
  rc = emit_mov ulong d r
  if lt rc 0
    ret rc
  end
  rc = own_mov ulong d r
  if lt rc 0
    ret rc
  end
  put g_v_reg vi d
  ret 0
end

fn skip_value p ulong to long
  ln = get g_st 20
  if ge p ln
    ret neg long 1
  end
  wo = w_off p
  wl = w_len p
  if wp_eq_t wo wl t_lpar
    q = skip_value add p 1
    if lt q 0
      ret neg long 1
    end
    if ge ulong q ln
      ret neg long 1
    end
    if not w_eq_t ulong q t_rpar
      ret neg long 1
    end
    ret add q 1
  end
  if is_term_wp wo wl
    ret neg long 1
  end
  if or is_lit_wp wo wl ge find_name_wp wo wl 0
    ret long add p 1
  end
  g = find_callable_wp wo wl
  if ge g 0
    curp = long add p 1
    np = get g_fn_np ulong g
    for i ulong np bound 8
      if lt curp 0
        break
      end
      curp = skip_value ulong curp
    end
    ret curp
  end
  if ge scalar_word_wp wo wl 0
    ret skip_value add p 1
  end
  if ge ref_word_wp wo wl 0
    if le add p 2 ln
      ret long add p 2
    end
    ret neg long 1
  end
  o = op_word_wp wo wl
  if eq o long OP_GET
    if le add p 2 ln
      ret skip_value add p 2
    end
    ret neg long 1
  end
  if eq o long OP_NEW
    if le add p 3 ln
      ret skip_value add p 3
    end
    ret neg long 1
  end
  if or eq o long OP_NEG eq o long OP_NOT
    ret skip_value add p 1
  end
  if ge o 0
    q = skip_value add p 1
    if lt q 0
      ret neg long 1
    end
    ret skip_value ulong q
  end
  ret neg long 1
end

fn extra_fail vi long in_paren ulong to long
  lp = get g_st 21
  ln = get g_st 20
  if and eq in_paren 0 w_eq_t lp t_rpar
    err_start
    err_t te_unmatched_rp
    ret neg long 1
  end
  m = ulong 0
  p = lp
  while and lt p ln not is_term_wp w_off p w_len p bound 1024
    q = skip_value p
    if lt q 0
      break
    end
    m = add m 1
    p = ulong q
  end
  e = lp
  while lt e ln bound 1024
    if and ne in_paren 0 w_eq_t e t_rpar
      break
    end
    e = add e 1
  end
  if and gt m 0 ge vi 0
    vu = ulong vi
    vh = get g_v_head vu
    if and ge vh 0 eq get g_v_paren vu 0
      ar = get g_v_arity vu
      err_start
      err_w ulong vh
      err_t te_has
      err_u64 add ar m
      err_t te_vals_after
      err_u64 ar
      ret neg long 1
    end
  end
  if ne in_paren 0
    err_start
    err_t te_paren_extra1
    err_span lp e
    err_t te_paren_extra2
    ret neg long 1
  end
  err_start
  err_t te_extra_end
  err_span lp ln
  err_c 39
  ret neg long 1
end

fn array_fits a ulong kind ulong rf ulong want ulong to bool
  if eq ty_ref a R_NONE
    ret false
  end
  if eq kind AN_GET
    ret ne and shr want_scal want ty_s a 1 0
  end
  if eq kind AN_PUT
    ret ne ty_ref a R_SHARED
  end
  if eq kind AN_FREE
    ret eq ty_ref a R_OWN
  end
  ret and ref_ok rf a want_ok want ty_make rf ty_s a ty_len a
end

fn array_name_fill kind ulong rf ulong want ulong to long
  cand = new ulong 512 0
  nc = ulong 0
  nd = ulong 0
  nn = get g_st 9
  for i ulong nn bound 512
    put g_taken i 0
  end
  for pass ulong 2 bound 2
    want_r = eq pass 0
    for i ulong nn bound 512
      reg = get g_nm_reg i
      if array_fits get g_regs reg kind rf want
        if own_dead reg
          if eq pass 0
            nd = add nd 1
          end
        else
          if eq in_r i want_r
            put cand nc i
            nc = add nc 1
          end
        end
      end
    end
  end
  if and eq nc 0 gt nd 0
    err_start
    err_t te_all_arr_dead
    ret neg long 1
  end
  if eq nc 0
    err_start
    err_t te_no_arr
    ret neg long 1
  end
  k = ulong 0
  if and gt nc 1 eq get g_st 29 0
    put g_st 29 nc
    k = rem get g_st 28 nc
  end
  ret fill_word_nm get cand k
end

fn array_name head ulong arity ulong kind ulong rf ulong want ulong to long
  lp = get g_st 21
  if ge lp get g_st 20
    if eq get g_st 24 0
      err_start
      err_w head
      err_t te_has
      err_c 48
      err_t te_vals_after
      err_u64 arity
      ret neg long 1
    end
    rc = array_name_fill kind rf want
    if lt rc 0
      ret rc
    end
  end
  wo = w_off lp
  wl = w_len lp
  ni = find_name_wp wo wl
  if lt ni 0
    if or is_term_wp wo wl wp_eq_t wo wl t_lpar
      err_start
      err_w head
      err_t te_takes_arr
      err_wp wo wl
      err_c 39
      ret neg long 1
    end
    if is_lit_wp wo wl
      err_start
      err_c 39
      err_wp wo wl
      err_t te_not_arr
      ret neg long 1
    end
    err_start
    err_c 39
    err_wp wo wl
    err_t te_not_scope
    ret neg long 1
  end
  put g_st 21 add lp 1
  nu = ulong ni
  put g_nm_rd nu 1
  reg = get g_nm_reg nu
  if eq ty_ref get g_regs reg R_NONE
    err_start
    err_c 39
    err_wp wo wl
    err_t te_not_arr
    ret neg long 1
  end
  ret long reg
end

fn slot want ulong dst long vi ulong head ulong k ulong arity ulong to long
  r = value want dst vi
  if eq r neg long 3
    err_start
    err_w head
    err_t te_has
    err_u64 k
    if eq k 1
      err_t te_val_after
    else
      err_t te_vals_after
    end
    err_u64 arity
    ret neg long 1
  end
  ret r
end

fn call_args fi ulong head ulong args edit ulong 6 to long
  np = get g_fn_np fi
  base = mul fi MAX_PARAMS
  for i ulong np bound 8
    pt = get g_fn_p add base i
    sv = get g_st 42
    av = val_alloc
    rc = slot want_param pt neg long 2 av head i np
    if lt rc 0
      put g_st 42 sv
      ret rc
    end
    if ne get g_v_lit av 0
      err_start
      err_c 39
      err_w ulong get g_v_word av
      err_t te_arg_num
      err_fn fi
      err_t te_takes
      err_ty pt
      err_t te_there
      put g_st 42 sv
      ret neg long 1
    end
    avt = get g_v_t av
    if not binds pt avt
      err_start
      err_c 39
      err_span get g_v_a av get g_v_b av
      err_t te_is
      err_ty avt
      err_t te_ret_type2
      err_fn fi
      err_t te_takes
      err_ty pt
      err_t te_there
      put g_st 42 sv
      ret neg long 1
    end
    put args i ulong get g_v_reg av
    put g_st 42 sv
  end
  ret 0
end

fn emit_call_op fi ulong args view ulong 6 has_dst ulong dst ulong to long
  r = op_begin
  if lt r 0
    ret r
  end
  if eq get g_st 25 0
    bops_t tj_call1
    bops_fn fi
    bops_t tj_call2
    np = get g_fn_np fi
    for i ulong np bound 8
      if gt i 0
        bops_t t_comma
      end
      bops_u64 get args i
    end
    if ne has_dst 0
      bops_t tj_call_dst
      bops_u64 dst
    else
      bops_c 93
    end
    op_finish
  end
  ret 0
end

fn own_call fi ulong args view ulong 6 to long
  np = get g_fn_np fi
  base = mul fi MAX_PARAMS
  for k ulong np bound 8
    ar = get args k
    if eq ty_ref get g_regs ar R_NONE
      continue
    end
    rc = own_use ar
    if lt rc 0
      ret rc
    end
    if eq ty_ref get g_fn_p add base k R_OWN
      rc = own_kill ar
      if lt rc 0
        ret rc
      end
    end
  end
  ret 0
end

fn value_call fi ulong dst long vi ulong to long
  if eq get g_fn_hret fi 0
    err_start
    err_fn fi
    err_t te_ret_void
    ret neg long 1
  end
  put g_v_arity vi get g_fn_np fi
  args = new ulong 6 0
  rc = call_args fi ulong get g_v_head vi edit args
  if lt rc 0
    ret rc
  end
  rt = get g_fn_ret fi
  d = to_dst dst rt
  if lt d 0
    ret d
  end
  rc = emit_call_op fi view args 1 ulong d
  if lt rc 0
    ret rc
  end
  rc = own_call fi view args
  if lt rc 0
    ret rc
  end
  put g_v_t vi rt
  put g_v_reg vi d
  put g_v_b vi get g_st 21
  ret 0
end

fn value_conv s ulong dst long vi ulong to long
  ty = ty_make R_NONE s 0
  sc = S_INT
  if eq s T_BOOL
    sc = 1
  end
  sv = get g_st 42
  av = val_alloc
  if lt slot want_pack sc A_NONE L_TYPED 0 0 ty neg long 2 av ulong get g_v_head vi 0 1 0
    put g_st 42 sv
    ret neg long 1
  end
  aty = get g_v_t av
  if ne ty_ref aty R_NONE
    err_start
    err_c 39
    err_span get g_v_a av get g_v_b av
    err_t te_arr_conv
    put g_st 42 sv
    ret neg long 1
  end
  if ne eq s T_BOOL eq ty_s aty T_BOOL
    err_start
    err_t te_bool_conv
    put g_st 42 sv
    ret neg long 1
  end
  put g_v_t vi ty
  ar = ulong get g_v_reg av
  if ne get g_v_konst av 0
    if and eq dst neg long 2 eq ty_s aty s
      put g_v_reg vi long ar
      put g_v_konst vi 1
      put g_v_b vi get g_st 21
      put g_st 42 sv
      ret 0
    end
  end
  put g_st 42 sv
  d = to_dst dst ty
  if lt d 0
    ret d
  end
  sc = 0
  if eq s ty_s aty
    sc = 1
  end
  if lt emit_cast sc ulong d ar 0
    ret neg long 1
  end
  put g_v_reg vi d
  put g_v_b vi get g_st 21
  ret 0
end

fn value_ref rf ulong want ulong dst long vi ulong to long
  ar = array_name ulong get g_v_head vi 1 AN_REF rf want
  if lt ar 0
    ret ar
  end
  au = ulong ar
  ta = get g_regs au
  if and eq rf R_OWN ne ty_ref ta R_OWN
    err_start
    err_t te_own_moves
    err_w sub get g_st 21 1
    err_t te_is
    err_ty ta
    ret neg long 1
  end
  if and eq rf R_MUT eq ty_ref ta R_SHARED
    err_start
    err_t te_edit_view
    err_w sub get g_st 21 1
    err_t te_is_view
    ret neg long 1
  end
  nt = ty_make rf ty_s ta ty_len ta
  put g_v_t vi nt
  d = to_dst dst nt
  if lt d 0
    ret d
  end
  rc = emit_mov ulong d au
  if lt rc 0
    ret rc
  end
  rc = own_mov ulong d au
  if lt rc 0
    ret rc
  end
  put g_v_reg vi d
  put g_v_b vi get g_st 21
  ret 0
end

fn value_unop o ulong want ulong dst long vi ulong to long
  sc = want_scal want
  if eq o OP_NEG
    sc = and sc S_SIGNED
  else
    sc = and sc S_ALL
  end
  sv = get g_st 42
  av = val_alloc
  if lt slot want_pack sc A_NONE L_NO 0 0 0 neg long 2 av ulong get g_v_head vi 0 1 0
    put g_st 42 sv
    ret neg long 1
  end
  if ne get g_v_lit av 0
    err_start
    err_opw o
    err_c 32
    err_w ulong get g_v_word av
    err_t te_unk_num1
    err_w ulong get g_v_word av
    put g_st 42 sv
    ret neg long 1
  end
  aty = get g_v_t av
  if ne ty_ref aty R_NONE
    err_start
    err_opw o
    err_t te_needs_nb
    put g_st 42 sv
    ret neg long 1
  end
  if eq o OP_NEG
    if or eq ty_s aty T_BOOL not is_signed ty_s aty
      err_start
      err_t te_neg_signed
      err_span get g_v_a av get g_v_b av
      err_t te_is
      err_ty aty
      put g_st 42 sv
      ret neg long 1
    end
  end
  ar = ulong get g_v_reg av
  put g_st 42 sv
  put g_v_t vi aty
  d = to_dst dst aty
  if lt d 0
    ret d
  end
  sc = 0
  if eq o OP_NEG
    sc = 1
  end
  av = 0
  if eq ty_s aty T_BOOL
    av = 1
  end
  if lt emit_unop sc av ulong d ar 0
    ret neg long 1
  end
  put g_v_reg vi d
  put g_v_b vi get g_st 21
  ret 0
end

fn value_get want ulong dst long vi ulong to long
  put g_v_arity vi 2
  ar = array_name ulong get g_v_head vi 2 AN_GET 0 want
  if lt ar 0
    ret ar
  end
  au = ulong ar
  sv = get g_st 42
  iv = val_alloc
  if lt slot want_pack S_INT A_NONE L_TYPED 0 0 ty_make R_NONE T_U32 0 neg long 2 iv ulong get g_v_head vi 1 2 0
    put g_st 42 sv
    ret neg long 1
  end
  if not ty_is_int get g_v_t iv
    err_start
    err_t te_idx_int1
    err_span get g_v_a iv get g_v_b iv
    err_t te_idx_int2
    put g_st 42 sv
    ret neg long 1
  end
  ir = ulong get g_v_reg iv
  put g_st 42 sv
  rt = ty_make R_NONE ty_s get g_regs au 0
  put g_v_t vi rt
  d = to_dst dst rt
  if lt d 0
    ret d
  end
  if lt emit_load ulong d au ir 0
    ret neg long 1
  end
  if lt own_use au 0
    ret neg long 1
  end
  put g_v_reg vi d
  put g_v_b vi get g_st 21
  ret 0
end

fn value_new_head want ulong to long
  if ge get g_st 21 get g_st 20
    if eq get g_st 24 0
      err_start
      err_t to_new
      err_t te_has
      err_c 48
      err_t te_vals_after
      err_c 51
      ret neg long 1
    end
    es = T_U32
    if eq want_arr want A_EXACT
      es = ty_s want_p want
    end
    if lt fill_word_gw es 0
      ret neg long 1
    end
  end
  lp = get g_st 21
  s = scalar_word_wp w_off lp w_len lp
  if lt s 0
    err_start
    err_c 39
    err_w lp
    err_t te_not_elem
    ret neg long 1
  end
  put g_st 21 add lp 1
  if ge get g_st 21 get g_st 20
    if eq get g_st 24 0
      err_start
      err_t to_new
      err_t te_has
      err_c 49
      err_t te_val_after
      err_c 51
      ret neg long 1
    end
    el = ulong 1
    if eq want_arr want A_EXACT
      el = ty_len want_p want
    end
    if lt fill_word_u64 el 0
      ret neg long 1
    end
  end
  lp = get g_st 21
  ok = parse_lit_wp w_off lp w_len lp
  alen = get g_st 48
  if or not ok or ne get g_st 47 0 or lt alen 1 gt alen 64
    err_start
    err_t te_arr_len1
    err_w lp
    err_t te_arr_len2
    ret neg long 1
  end
  put g_st 21 add lp 1
  ret long ty_make R_OWN ulong s alen
end

fn value_new want ulong dst long vi ulong to long
  put g_v_arity vi 3
  if eq want_top want 0
    err_start
    err_t te_new_top
    ret neg long 1
  end
  ntr = value_new_head want
  if lt ntr 0
    ret ntr
  end
  nt = ulong ntr
  et = ty_make R_NONE ty_s nt 0
  sv = get g_st 42
  iv = val_alloc
  if lt slot want_type et neg long 2 iv ulong get g_v_head vi 2 3 0
    put g_st 42 sv
    ret neg long 1
  end
  if ne get g_v_t iv et
    err_start
    err_t te_init_type1
    err_span get g_v_a iv get g_v_b iv
    err_t te_is
    err_ty get g_v_t iv
    err_t te_init_type2
    err_ty et
    put g_st 42 sv
    ret neg long 1
  end
  ir = ulong get g_v_reg iv
  put g_st 42 sv
  put g_v_t vi nt
  d = to_dst dst nt
  if lt d 0
    ret d
  end
  if lt emit_alloc ulong d ir 0
    ret neg long 1
  end
  if lt own_birth ulong d 0
    ret neg long 1
  end
  put g_v_reg vi d
  put g_v_b vi get g_st 21
  ret 0
end

fn value_binop_finish o ulong dst long vi ulong av ulong bv ulong to long
  alit = ne get g_v_lit av 0
  if and alit ne get g_v_lit bv 0
    err_start
    err_opw o
    err_c 32
    err_w ulong get g_v_word av
    err_c 32
    err_w ulong get g_v_word bv
    err_t te_two_nums
    ret neg long 1
  end
  bt = get g_v_t bv
  if ne ty_ref bt R_NONE
    err_start
    err_opw o
    err_t te_not_arr_op
    ret neg long 1
  end
  ar = ulong 0
  aty = get g_v_t av
  if alit
    if and or is_arith o is_shift o eq ty_s bt T_BOOL
      err_start
      err_opw o
      err_t te_need_int_op
      ret neg long 1
    end
    aw = ulong get g_v_word av
    lr = lit_reg_wp w_off aw w_len aw bt
    if lt lr 0
      ret lr
    end
    ar = ulong lr
    aty = bt
  else
    ar = ulong get g_v_reg av
  end
  rt = aty
  if is_shift o
    if or not ty_is_int aty not ty_is_int bt
      err_start
      err_t te_shift_int
      ret neg long 1
    end
  else
    if ne aty bt
      err_start
      err_opw o
      err_t te_two_same
      err_span get g_v_a av get g_v_b av
      err_t te_is
      err_ty aty
      err_t t_comma
      err_c 39
      err_span get g_v_a bv get g_v_b bv
      err_t te_is
      err_ty bt
      ret neg long 1
    end
    if and is_arith o eq ty_s aty T_BOOL
      err_start
      err_opw o
      err_t te_need_int_op
      ret neg long 1
    end
    if is_cmp o
      rt = ty_make R_NONE T_BOOL 0
    end
  end
  put g_v_t vi rt
  d = to_dst dst rt
  if lt d 0
    ret d
  end
  if lt emit_binop o ulong d ar ulong get g_v_reg bv 0
    ret neg long 1
  end
  put g_v_reg vi d
  put g_v_b vi get g_st 21
  ret 0
end

fn value_binop_w2 o ulong sc1 ulong av ulong to ulong
  if ne get g_v_lit av 0
    aw = ulong get g_v_word av
    ret want_pack lit_fits_wp w_off aw w_len aw sc1 A_NONE L_NO 0 0 0
  end
  aty = get g_v_t av
  sc2 = shl ulong 1 ty_s aty
  if is_shift o
    sc2 = S_INT
  end
  ret want_pack sc2 A_NONE L_TYPED 0 0 aty
end

fn value_binop_check_a o ulong av ulong to long
  if ne get g_v_lit av 0
    ret 0
  end
  aty = get g_v_t av
  if ne ty_ref aty R_NONE
    err_start
    err_opw o
    err_t te_not_arr_op
    ret neg long 1
  end
  if or is_arith o is_shift o
    if eq ty_s aty T_BOOL
      err_start
      err_opw o
      err_t te_need_int_op
      ret neg long 1
    end
  end
  ret 0
end

fn value_binop o ulong want ulong dst long vi ulong to long
  put g_v_arity vi 2
  sc1 = S_ALL
  if not is_cmp o
    if or is_arith o is_shift o
      sc1 = and want_scal want S_INT
    else
      sc1 = and want_scal want S_ALL
    end
  end
  sv = get g_st 42
  av = val_alloc
  bv = val_alloc
  if lt slot want_pack sc1 A_NONE L_OPEN 0 0 0 neg long 2 av ulong get g_v_head vi 0 2 0
    put g_st 42 sv
    ret neg long 1
  end
  if lt value_binop_check_a o av 0
    put g_st 42 sv
    ret neg long 1
  end
  if lt slot value_binop_w2 o sc1 av neg long 2 bv ulong get g_v_head vi 1 2 0
    put g_st 42 sv
    ret neg long 1
  end
  rc = value_binop_finish o dst vi av bv
  put g_st 42 sv
  ret rc
end

fn value_paren want ulong dst long vi ulong to long
  start = get g_st 21
  put g_st 21 add start 1
  put g_st 22 add get g_st 22 1
  r = value want dst vi
  put g_st 22 sub get g_st 22 1
  if eq r neg long 3
    lp2 = get g_st 21
    if lt lp2 get g_st 20
      if w_eq_t lp2 t_rpar
        err_start
        err_t te_empty_par
        ret neg long 1
      end
    end
    err_start
    err_t te_miss_lp
    ret neg long 1
  end
  if lt r 0
    ret r
  end
  if ge get g_st 21 get g_st 20
    if eq get g_st 24 0
      err_start
      err_t te_unmatched_lp
      ret neg long 1
    end
    if lt fill_word_t t_rpar 0
      ret neg long 1
    end
  end
  if not w_eq_t get g_st 21 t_rpar
    ret extra_fail long vi 1
  end
  put g_st 21 add get g_st 21 1
  put g_v_paren vi 1
  put g_v_a vi start
  put g_v_b vi get g_st 21
  ret 0
end

fn value_head wo ulong wl ulong want ulong dst long vi ulong to long
  s = scalar_word_wp wo wl
  if ge s 0
    ret value_conv ulong s dst vi
  end
  rf = ref_word_wp wo wl
  if ge rf 0
    ret value_ref ulong rf want dst vi
  end
  o = op_word_wp wo wl
  if lt o 0
    err_start
    err_c 39
    err_wp wo wl
    err_t te_unk_word
    ret neg long 1
  end
  ou = ulong o
  if or eq ou OP_NEG eq ou OP_NOT
    ret value_unop ou want dst vi
  end
  if eq ou OP_GET
    ret value_get want dst vi
  end
  if eq ou OP_NEW
    ret value_new want dst vi
  end
  ret value_binop ou want dst vi
end

fn value want ulong dst long vi ulong to long
  put g_v_lit vi 0
  put g_v_word vi neg long 1
  put g_v_reg vi neg long 1
  put g_v_konst vi 0
  put g_v_head vi neg long 1
  put g_v_arity vi 0
  put g_v_paren vi 0
  put g_v_a vi get g_st 21
  put g_v_b vi 0
  put g_v_t vi 0
  if ge get g_st 21 get g_st 20
    if eq get g_st 24 0
      ret neg long 3
    end
    if lt gen_value want 0
      ret neg long 1
    end
  end
  lp = get g_st 21
  wo = w_off lp
  wl = w_len lp
  if wp_eq_t wo wl t_rpar
    if ne get g_st 22 0
      ret neg long 3
    end
    err_start
    err_t te_unmatched_rp
    ret neg long 1
  end
  if is_term_wp wo wl
    ret neg long 3
  end
  if wp_eq_t wo wl t_lpar
    ret value_paren want dst vi
  end
  if is_lit_wp wo wl
    put g_v_word vi long lp
    put g_st 21 add lp 1
    put g_v_b vi add lp 1
    if ne want_lit want L_TYPED
      put g_v_lit vi 1
      ret 0
    end
    lr = lit_reg_wp wo wl want_lt want
    if lt lr 0
      ret lr
    end
    put g_v_konst vi 1
    ret leaf vi ulong lr want_lt want dst
  end
  if or is_digit get g_wpool wo eq get g_wpool wo 45
    err_start
    err_c 39
    err_wp wo wl
    err_t te_bad_num
    ret neg long 1
  end
  ni = find_name_wp wo wl
  if ge ni 0
    put g_st 21 add lp 1
    put g_nm_rd ulong ni 1
    reg = get g_nm_reg ulong ni
    ret leaf vi reg get g_regs reg dst
  end
  g = find_callable_wp wo wl
  if and lt g 0 ge find_func_wp wo wl 0
    err_start
    err_wp wo wl
    err_t te_self_call
    ret neg long 1
  end
  put g_v_head vi long lp
  put g_st 21 add lp 1
  if ge g 0
    ret value_call ulong g dst vi
  end
  put g_v_arity vi 1
  ret value_head wo wl want dst vi
end

note ---- statements & functions ----
fn line_end vi long to long
  if ge get g_st 21 get g_st 20
    ret 0
  end
  ret extra_fail vi 0
end

fn alone s view uchar * to long
  if lt get g_st 21 get g_st 20
    err_start
    err_t s
    err_t te_stands_alone
    ret neg long 1
  end
  ret 0
end

fn parse_cond vi ulong what view uchar * to long
  bw = want_type ty_make R_NONE T_BOOL 0
  r = value bw neg long 2 vi
  if eq r neg long 3
    err_start
    err_t what
    err_t te_needs_cond
    ret neg long 1
  end
  if lt r 0
    ret r
  end
  ct = get g_v_t vi
  if not and eq ty_ref ct R_NONE eq ty_s ct T_BOOL
    err_start
    err_t te_cond_bool
    err_ty ct
    ret neg long 1
  end
  ret 0
end

fn push_frame kind ulong to long
  nf = get g_st 15
  if ge nf MAX_FRAMES
    err_start
    err_t te_max_frames
    ret neg long 1
  end
  put g_fr_kind nf kind
  dep = add get g_st 10 1
  put g_st 10 dep
  put g_fr_dep nf dep
  put g_fr_els nf 0
  put g_fr_join nf 0
  put g_fr_hels nf 0
  put g_fr_head nf 0
  put g_fr_exit nf 0
  put g_fr_ctr nf 0
  put g_fr_ohas nf 0
  put g_st 15 add nf 1
  ret long nf
end

fn end_function_emit_one off ulong olen ulong to void
  p = ulong 0
  while lt p olen bound 4096
    c = get g_bops add off p
    if eq c 64
      p = add p 1
      id = ulong 0
      while lt p olen bound 32
        ch = get g_bops add off p
        if eq ch 64
          break
        end
        id = add mul id 10 ulong sub ch 48
        p = add p 1
      end
      out_u64 ulong get g_bmap id
      if lt p olen
        p = add p 1
      end
    else
      out_c c
      p = add p 1
    end
  end
end

fn end_function_emit_ops b ulong first ulong to void
  idx = get g_blk_head b
  while ge idx 0 bound BIG
    iu = ulong idx
    if eq first 0
      out_t t_comma
    end
    first = 0
    out_c 123
    end_function_emit_one get g_op_off iu get g_op_len iu
    out_c 125
    idx = get g_op_next iu
  end
end

fn end_function_emit_consts to ulong
  first = ulong 1
  nc = get g_st 11
  for c ulong nc bound 256
    if eq first 0
      out_t t_comma
    end
    first = 0
    out_t tj_const1
    out_u64 get g_ck_reg c
    out_t tj_const2
    if eq ty_s get g_ck_t c T_BOOL
      if ne get g_ck_mag c 0
        out_t tk_true
      else
        out_t tk_false
      end
    else
      if ne get g_ck_neg c 0
        out_c 45
      end
      out_u64 get g_ck_mag c
    end
    out_c 125
  end
  ret first
end

fn end_function to void
  fi = sub get g_st 5 1
  nb = get g_st 12
  for i ulong nb bound 512
    o = get g_blk_ord i
    put g_bmap i o
    if ge o 0
      put g_bord ulong o i
    end
  end
  if gt get g_st 5 1
    out_c 44
  end
  out_t tj_fn1
  out_fn_name fi
  out_t tj_fn2
  np = get g_fn_np fi
  pbase = mul fi MAX_PARAMS
  for i ulong np bound 8
    if gt i 0
      out_t t_comma
    end
    out_c 34
    out_tir get g_fn_p add pbase i
    out_c 34
  end
  out_t tj_fn3
  if ne get g_fn_hret fi 0
    out_tir get g_fn_ret fi
  else
    out_t tk_void
  end
  out_t tj_fn4
  npar = get g_st 8
  nr = get g_st 7
  i = npar
  while lt i nr bound 512
    if gt i npar
      out_t t_comma
    end
    out_c 34
    out_tir get g_regs i
    out_c 34
    i = add i 1
  end
  out_t tj_fn5
  nord = get g_st 13
  for k ulong nord bound 512
    if gt k 0
      out_c 44
    end
    out_t tj_blk
    first = ulong 1
    if eq k 0
      first = end_function_emit_consts
    end
    end_function_emit_ops get g_bord k first
    out_c 93
  end
  out_t tj_fn6
  put g_st 40 0
  put g_st 41 0
end

fn fn_line_params nf ulong to long
  while true bound 64
    if ge get g_st 21 get g_st 20
      if eq get g_st 24 0
        err_start
        err_t te_fn_to
        ret neg long 1
      end
      if lt fill_word_t tk_to 0
        ret neg long 1
      end
    end
    lp = get g_st 21
    if w_eq_t lp tk_to
      ret 0
    end
    np = get g_fn_np nf
    if ge np MAX_PARAMS
      err_start
      err_t te_max_params
      ret neg long 1
    end
    pno = w_off lp
    pnl = w_len lp
    put g_st 21 add lp 1
    tr = parse_type
    if lt tr 0
      ret tr
    end
    tu = ulong tr
    put g_fn_p add mul nf MAX_PARAMS np tu
    put g_fn_np nf add np 1
    r = new_reg tu
    if lt r 0
      ret r
    end
    if ge find_name_wp pno pnl 0
      err_start
      err_t te_dup_param1
      err_wp pno pnl
      err_t te_dup_param2
      ret neg long 1
    end
    if lt bind_name_wp pno pnl ulong r 2 0
      ret neg long 1
    end
    if eq ty_ref tu R_OWN
      os = own_slot ulong r
      if ge os 0
        put g_ost_b ulong os uchar OS_L
        put g_ost_m ulong os 0
      end
    end
  end
  ret 0
end

fn fn_line to long
  if ne get g_st 6 0
    err_start
    err_t te_fn_in_fn
    ret neg long 1
  end
  nf = get g_st 5
  if ge nf MAX_FUNCS
    err_start
    err_t te_max_funcs
    ret neg long 1
  end
  if and lt get g_st 20 3 eq get g_st 24 0
    err_start
    err_t te_fn_syn
    ret neg long 1
  end
  if lt get g_st 20 2
    if lt fill_fresh_name 0
      ret neg long 1
    end
  end
  fo = w_off 1
  fl = w_len 1
  if or not valid_ident_wp fo fl reserved_wp fo fl
    err_start
    err_c 39
    err_wp fo fl
    err_t te_bad_fn
    ret neg long 1
  end
  if ge find_func_wp fo fl 0
    err_start
    err_t te_dup_fn1
    err_wp fo fl
    err_t te_dup_fn2
    ret neg long 1
  end
  dst = mul nf 64
  for i ulong fl bound 64
    put g_fn_name add dst i get g_wpool add fo i
  end
  put g_fn_nlen nf fl
  put g_fn_np nf 0
  put g_fn_hret nf 0
  put g_fn_ret nf 0
  put g_st 7 0
  put g_st 9 0
  put g_st 11 0
  put g_st 12 0
  put g_st 13 0
  put g_st 15 0
  put g_st 16 0
  put g_st 17 0
  put g_st 19 0
  put g_st 18 0
  put g_st 10 0
  put g_st 40 0
  put g_st 41 0
  if lt push_frame F_FN 0
    ret neg long 1
  end
  put g_st 21 2
  if lt fn_line_params nf 0
    ret neg long 1
  end
  put g_st 21 add get g_st 21 1
  if and ge get g_st 21 get g_st 20 ne get g_st 24 0
    if lt fill_word_t tk_void 0
      ret neg long 1
    end
  end
  is_void = false
  if lt get g_st 21 get g_st 20
    if w_eq_t get g_st 21 tk_void
      is_void = true
    end
  end
  if is_void
    put g_fn_hret nf 0
    put g_st 21 add get g_st 21 1
  else
    tr = parse_type
    if lt tr 0
      ret tr
    end
    tu = ulong tr
    if ne ty_ref tu R_NONE
      err_start
      err_t te_fn_ret_arr
      ret neg long 1
    end
    put g_fn_hret nf 1
    put g_fn_ret nf tu
  end
  if ne get g_st 21 get g_st 20
    err_start
    err_c 39
    err_w get g_st 21
    err_t te_after_ret
    ret neg long 1
  end
  put g_st 8 get g_st 7
  put g_st 5 add nf 1
  put g_st 6 1
  b = new_block
  if lt b 0
    ret b
  end
  start_block ulong b
  ret 0
end

fn guarded_loop_tail is_for ulong to long
  fk = F_WHILE
  if ne is_for 0
    fk = F_FOR
  end
  fr = push_frame fk
  if lt fr 0
    ret fr
  end
  fu = ulong fr
  own_loop_pushed fu
  put g_fr_head fu long get g_st 57
  put g_fr_exit fu long get g_st 60
  ret fr
end

fn guarded_loop_while_bound sv ulong to long
  if ge get g_st 21 get g_st 20
    if eq get g_st 24 0
      err_start
      err_t te_bound_miss
      put g_st 42 sv
      ret neg long 1
    end
    if lt fill_word_t t_1 0
      put g_st 42 sv
      ret neg long 1
    end
  end
  blp = get g_st 21
  put g_st 21 add blp 1
  bo = w_off blp
  bl = w_len blp
  bad = not parse_lit_wp bo bl
  if not bad
    if ne get g_st 47 0
      bad = true
    end
  end
  if not bad
    if or lt get g_st 48 1 gt get g_st 48 1000000
      bad = true
    end
  end
  if bad
    err_start
    err_t te_bound_rng1
    err_wp bo bl
    err_t te_bound_rng2
    put g_st 42 sv
    ret neg long 1
  end
  rc = line_end neg long 1
  put g_st 42 sv
  if lt rc 0
    ret rc
  end
  ret lit_reg_wp bo bl ty_make R_NONE T_U64 0
end

fn guarded_loop_while_cond to long
  sv = get g_st 42
  cv = val_alloc
  if lt parse_cond cv tk_while 0
    put g_st 42 sv
    ret neg long 1
  end
  put g_st 51 ulong get g_v_reg cv
  if lt get g_st 21 get g_st 20
    if w_eq_t get g_st 21 tk_bound
      put g_st 21 add get g_st 21 1
      ret guarded_loop_while_bound sv
    end
  end
  rc = line_end long cv
  put g_st 42 sv
  if lt rc 0
    ret rc
  end
  ret lit_reg_t t_1m ty_make R_NONE T_U64 0
end

fn guarded_loop_emit_guard cnt ulong lim ulong to long
  start_block get g_st 58
  ge_r = new_reg ty_make R_NONE T_BOOL 0
  if lt ge_r 0
    ret ge_r

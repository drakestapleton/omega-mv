  b = new_block
  if lt b 0
    ret neg long 1
  end
  put g_st 52 ulong b
  b = new_block
  if lt b 0
    ret neg long 1
  end
  put g_st 60 ulong b
  ret 0
end

fn guarded_loop is_for ulong s ulong count_reg ulong fn_off ulong fn_len ulong to long
  zero = lit_reg_t t_0 ty_make R_NONE T_U64 0
  if lt zero 0
    ret zero
  end
  if lt lit_reg_t t_1 ty_make R_NONE T_U64 0 0
    ret neg long 1
  end
  ctr = neg long 1
  cnt = new_reg ty_make R_NONE T_U64 0
  if lt cnt 0
    ret cnt
  end
  if ne is_for 0
    ctr = guarded_loop_init_for s
    if lt ctr 0
      ret ctr
    end
  end
  if lt emit_mov ulong cnt ulong zero 0
    ret neg long 1
  end
  if lt guarded_loop_alloc_blks 0
    ret neg long 1
  end
  if lt emit_br get g_st 57 0
    ret neg long 1
  end
  if lt own_loop_open 0
    ret neg long 1
  end
  start_block get g_st 57
  lim = neg long 1
  if ne is_for 0
    lim = new_reg ty_make R_NONE T_BOOL 0
    if lt lim 0
      ret lim
    end
    put g_st 51 ulong lim
    if lt emit_binop OP_LT ulong lim ulong ctr count_reg 0
      ret neg long 1
    end
    lim = lit_reg_t t_1m ty_make R_NONE T_U64 0
  else
    lim = guarded_loop_while_cond
  end
  if lt lim 0
    ret lim
  end
  if lt emit_cbr get g_st 51 get g_st 58 get g_st 60 0
    ret neg long 1
  end
  if lt guarded_loop_emit_guard ulong cnt ulong lim 0
    ret neg long 1
  end
  lim = guarded_loop_tail is_for
  if lt lim 0
    ret lim
  end
  put g_fr_ctr ulong lim ctr
  if ne is_for 0
    ret bind_name_wp fn_off fn_len ulong ctr 1
  end
  ret 0
end

fn count_number to long
  i = get g_st 21
  ln = get g_st 20
  k = ulong 0
  while lt i ln bound 1024
    if not w_eq_t i t_lpar
      break
    end
    i = add i 1
    k = add k 1
  end
  if ge i ln
    ret neg long 1
  end
  if not is_lit_wp w_off i w_len i
    ret neg long 1
  end
  j = add i 1
  c = ulong 0
  while and lt j ln lt c k bound 1024
    if not w_eq_t j t_rpar
      break
    end
    j = add j 1
    c = add c 1
  end
  if and eq j ln ne get g_st 24 0
    while lt c k bound 1024
      if lt fill_word_t t_rpar 0
        ret neg long 1
      end
      c = add c 1
      j = add j 1
    end
    ln = get g_st 20
  end
  if or ne j ln lt c k
    ret neg long 1
  end
  ret long i
end

fn for_line_const_emit nmo ulong nml ulong ctr ulong k ulong to long
  h = new_block
  if lt h 0
    ret neg long 1
  end
  body = new_block
  if lt body 0
    ret neg long 1
  end
  ex = new_block
  if lt ex 0
    ret neg long 1
  end
  if lt emit_br ulong h 0
    ret neg long 1
  end
  if lt own_loop_open 0
    ret neg long 1
  end
  start_block ulong h
  c = new_reg ty_make R_NONE T_BOOL 0
  if lt c 0
    ret c
  end
  if lt emit_binop OP_LT ulong c ctr k 0
    ret neg long 1
  end
  if lt emit_cbr ulong c ulong body ulong ex 0
    ret neg long 1
  end
  c = push_frame F_FOR
  if lt c 0
    ret c
  end
  own_loop_pushed ulong c
  put g_fr_head ulong c h
  put g_fr_exit ulong c ex
  put g_fr_ctr ulong c long ctr
  if lt bind_name_wp nmo nml ctr 1 0
    ret neg long 1
  end
  start_block ulong body
  ret 0
end

fn for_line_const nmo ulong nml ulong t ulong ki ulong to long
  ko = w_off ki
  kl = w_len ki
  if not parse_lit_wp ko kl
    err_start
    err_t te_cnt_rng1
    err_wp ko kl
    err_t te_cnt_rng2
    ret neg long 1
  end
  if or ne get g_st 47 0 gt get g_st 48 1000000
    err_start
    err_t te_cnt_rng1
    err_wp ko kl
    err_t te_cnt_rng2
    ret neg long 1
  end
  put g_st 21 get g_st 20
  if lt line_end neg long 1 0
    ret neg long 1
  end
  zero = lit_reg_t t_0 t
  if lt zero 0
    ret zero
  end
  k = lit_reg_wp ko kl t
  if lt k 0
    ret k
  end
  if lt lit_reg_t t_1 t 0
    ret neg long 1
  end
  ctr = new_reg t
  if lt ctr 0
    ret ctr
  end
  if lt emit_mov ulong ctr ulong zero 0
    ret neg long 1
  end
  ret for_line_const_emit nmo nml ulong ctr ulong k
end

fn for_line to long
  if ge get g_st 21 get g_st 20
    if eq get g_st 24 0
      err_start
      err_t te_for_syn
      ret neg long 1
    end
    rc = fill_fresh_name
    if lt rc 0
      ret rc
    end
  end
  lp = get g_st 21
  nmo = w_off lp
  nml = w_len lp
  put g_st 21 add lp 1
  rc = check_new_name_wp nmo nml
  if lt rc 0
    ret rc
  end
  if ge get g_st 21 get g_st 20
    if eq get g_st 24 0
      err_start
      err_t te_for_syn
      ret neg long 1
    end
    rc = fill_word_t tg_uint
    if lt rc 0
      ret rc
    end
  end
  lp = get g_st 21
  s = scalar_word_wp w_off lp w_len lp
  if or lt s 0 eq s long T_BOOL
    err_start
    err_c 39
    err_w lp
    err_t te_not_int_ty
    ret neg long 1
  end
  put g_st 21 add lp 1
  t = ty_make R_NONE ulong s 0
  if eq get g_st 14 0
    err_start
    err_t te_dead_line
    ret neg long 1
  end
  ki = count_number
  if ge ki 0
    ret for_line_const nmo nml t ulong ki
  end
  sv = get g_st 42
  cv = val_alloc
  r = value want_type t neg long 2 cv
  if eq r neg long 3
    err_start
    err_t te_for_syn
    put g_st 42 sv
    ret neg long 1
  end
  if lt r 0
    put g_st 42 sv
    ret r
  end
  if ne get g_v_t cv t
    err_start
    err_t te_cnt_rng1
    err_span get g_v_a cv get g_v_b cv
    err_t te_is
    err_ty get g_v_t cv
    err_t te_init_type2
    err_ty t
    put g_st 42 sv
    ret neg long 1
  end
  rc = line_end long cv
  creg = ulong get g_v_reg cv
  put g_st 42 sv
  if lt rc 0
    ret rc
  end
  ret guarded_loop 1 ulong s creg nmo nml
end

fn stmt_end fi ulong to long
  fk_idx = sub get g_st 15 1
  fk = get g_fr_kind fk_idx
  if and eq fk F_FN and gt get g_st 14 0 ne get g_fn_hret fi 0
    err_start
    err_fn fi
    err_t te_no_ret
    ret neg long 1
  end
  rc = alone tk_end
  if lt rc 0
    ret rc
  end
  if eq fk F_IF
    own_if_end fk_idx
    if eq get g_fr_hels fk_idx 0
      els = ulong get g_fr_els fk_idx
      if gt get g_st 14 0
        rc = emit_br els
        if lt rc 0
          ret rc
        end
      end
      start_block els
    else
      if gt get g_st 14 0
        if lt get g_fr_join fk_idx 0
          jb = new_block
          if lt jb 0
            ret jb
          end
          put g_fr_join fk_idx jb
        end
        rc = emit_br ulong get g_fr_join fk_idx
        if lt rc 0
          ret rc
        end
      end
      if ge get g_fr_join fk_idx 0
        start_block ulong get g_fr_join fk_idx
      else
        put g_st 14 0
      end
    end
  else
    if eq fk F_WHILE
      rc = own_loop_close fk_idx
      if lt rc 0
        ret rc
      end
      if gt get g_st 14 0
        rc = emit_br ulong get g_fr_head fk_idx
        if lt rc 0
          ret rc
        end
      end
      start_block ulong get g_fr_exit fk_idx
    else
      if eq fk F_FOR
        rc = own_loop_close fk_idx
        if lt rc 0
          ret rc
        end
        if gt get g_st 14 0
          ctr = ulong get g_fr_ctr fk_idx
          one = lit_reg_t t_1 get g_regs ctr
          if lt one 0
            ret one
          end
          rc = emit_binop OP_ADD ctr ctr ulong one
          if lt rc 0
            ret rc
          end
          rc = emit_br ulong get g_fr_head fk_idx
          if lt rc 0
            ret rc
          end
        end
        start_block ulong get g_fr_exit fk_idx
      else
        if gt get g_st 14 0
          if ne get g_fn_hret fi 0
            err_start
            err_fn fi
            err_t te_no_ret
            ret neg long 1
          end
          rc = emit_ret_void
          if lt rc 0
            ret rc
          end
          rc = own_ret
          if lt rc 0
            ret rc
          end
          put g_st 14 0
        end
        if eq get g_st 25 0
          end_function
        end
        put g_st 6 0
      end
    end
  end
  put g_st 15 fk_idx
  ret pop_scope
end

fn stmt_else to long
  fk_idx = sub get g_st 15 1
  if or ne get g_fr_kind fk_idx F_IF ne get g_fr_hels fk_idx 0
    err_start
    err_t te_else_no_if
    ret neg long 1
  end
  rc = alone tk_else
  if lt rc 0
    ret rc
  end
  if gt get g_st 14 0
    own_save_oacc fk_idx
    put g_fr_ohas fk_idx 1
    jb = new_block
    if lt jb 0
      ret jb
    end
    put g_fr_join fk_idx jb
    rc = emit_br ulong jb
    if lt rc 0
      ret rc
    end
  else
    put g_fr_join fk_idx neg long 1
  end
  put g_fr_hels fk_idx 1
  rc = pop_scope
  if lt rc 0
    ret rc
  end
  put g_st 10 add get g_st 10 1
  start_block ulong get g_fr_els fk_idx
  nown = get g_st 16
  base = mul fk_idx MAX_OWN
  for s ulong nown bound 64
    put g_ost_b s get g_fr_oin_b add base s
    put g_ost_m s get g_fr_oin_m add base s
  end
  ret 0
end

fn stmt_if to long
  sv = get g_st 42
  cv = val_alloc
  rc = parse_cond cv tk_if
  if lt rc 0
    put g_st 42 sv
    ret rc
  end
  rc = line_end long cv
  creg = ulong get g_v_reg cv
  put g_st 42 sv
  if lt rc 0
    ret rc
  end
  th = new_block
  el = new_block
  if or lt th 0 lt el 0
    ret neg long 1
  end
  put g_blk_refd ulong th 1
  put g_blk_refd ulong el 1
  rc = emit_cbr creg ulong th ulong el
  if lt rc 0
    ret rc
  end
  fr = push_frame F_IF
  if lt fr 0
    ret fr
  end
  fu = ulong fr
  own_save_oin fu
  put g_fr_ohas fu 0
  put g_fr_els fu el
  put g_fr_join fu neg long 1
  start_block ulong th
  ret 0
end

fn stmt_break to long
  k = get g_st 15
  while gt k 0 bound 64
    k = sub k 1
    fk = get g_fr_kind k
    if or eq fk F_WHILE eq fk F_FOR
      rc = alone tk_break
      if lt rc 0
        ret rc
      end
      if gt get g_st 14 0
        own_join_oacc k get g_fr_ohas k
        put g_fr_ohas k 1
      end
      ret emit_br ulong get g_fr_exit k
    end
  end
  err_start
  err_t te_brk_no_loop
  ret neg long 1
end

fn stmt_ret fi ulong to long
  if eq get g_fn_hret fi 0
    if lt get g_st 21 get g_st 20
      err_start
      err_fn fi
      err_t te_ret_alone
      ret neg long 1
    end
    rc = emit_ret_void
    if lt rc 0
      ret rc
    end
    rc = own_ret
    if lt rc 0
      ret rc
    end
    put g_st 14 0
    ret 0
  end
  if ne get g_st 24 0
    put g_st 26 1
    put g_st 27 chain_floor
  end
  rt = get g_fn_ret fi
  sv = get g_st 42
  vv = val_alloc
  r = value want_type rt neg long 2 vv
  if eq r neg long 3
    err_start
    err_fn fi
    err_t te_ret_need1
    err_ty rt
    err_t te_ret_need2
    put g_st 42 sv
    ret neg long 1
  end
  if lt r 0
    put g_st 42 sv
    ret r
  end
  vt = get g_v_t vv
  if ne vt rt
    err_start
    err_t te_ret_type1
    err_ty vt
    err_t te_ret_type2
    err_fn fi
    err_t te_ret_need1
    err_ty rt
    put g_st 42 sv
    ret neg long 1
  end
  rc = line_end long vv
  vreg = ulong get g_v_reg vv
  put g_st 42 sv
  if lt rc 0
    ret rc
  end
  rc = emit_ret_val vreg
  if lt rc 0
    ret rc
  end
  rc = own_ret
  if lt rc 0
    ret rc
  end
  put g_st 14 0
  ret 0
end

fn stmt_trap fi ulong to long
  if ge get g_st 21 get g_st 20
    if eq get g_st 24 0
      err_start
      err_t te_trap_syn
      ret neg long 1
    end
    rc = fill_word_t t_1
    if lt rc 0
      ret rc
    end
  end
  lp = get g_st 21
  ok = parse_lit_wp w_off lp w_len lp
  c = get g_st 48
  if or not ok or ne get g_st 47 0 or lt c 1 gt c 14
    err_start
    err_t te_trap_syn
    ret neg long 1
  end
  put g_st 21 add lp 1
  if lt get g_st 21 get g_st 20
    err_start
    err_t te_trap_syn
    ret neg long 1
  end
  rc = emit_trap c
  if lt rc 0
    ret rc
  end
  if ne get g_fn_hret fi 0
    rt = get g_fn_ret fi
    z = neg long 1
    if eq ty_s rt T_BOOL
      z = lit_reg_t tk_false rt
    else
      z = lit_reg_t t_0 rt
    end
    if lt z 0
      ret z
    end
    rc = emit_ret_val ulong z
    if lt rc 0
      ret rc
    end
  else
    rc = emit_ret_void
    if lt rc 0
      ret rc
    end
  end
  put g_st 14 0
  ret 0
end

fn stmt_put to long
  ar = array_name 0 3 AN_PUT 0 0
  if lt ar 0
    ret ar
  end
  au = ulong ar
  ta = get g_regs au
  if eq ty_ref ta R_SHARED
    err_start
    err_c 39
    err_w sub get g_st 21 1
    err_t te_put_view
    ret neg long 1
  end
  iw = want_pack S_INT A_NONE L_TYPED 0 0 ty_make R_NONE T_U32 0
  et = ty_make R_NONE ty_s ta 0
  vw = want_type et
  sv = get g_st 42
  iv = val_alloc
  vv = val_alloc
  rc = slot iw neg long 2 iv 0 1 3
  if lt rc 0
    put g_st 42 sv
    ret rc
  end
  if not ty_is_int get g_v_t iv
    err_start
    err_t te_idx_int1
    err_span get g_v_a iv get g_v_b iv
    err_t te_idx_int2
    put g_st 42 sv
    ret neg long 1
  end
  rc = slot vw neg long 2 vv 0 2 3
  if lt rc 0
    put g_st 42 sv
    ret rc
  end
  if ne get g_v_t vv et
    err_start
    err_c 39
    err_span get g_v_a vv get g_v_b vv
    err_t te_is
    err_ty get g_v_t vv
    err_t te_put_ty
    err_ty et
    put g_st 42 sv
    ret neg long 1
  end
  wh = val_alloc
  put g_v_head wh 0
  put g_v_arity wh 3
  rc = line_end long wh
  ir = ulong get g_v_reg iv
  vr = ulong get g_v_reg vv
  put g_st 42 sv
  if lt rc 0
    ret rc
  end
  rc = emit_store au ir vr
  if lt rc 0
    ret rc
  end
  ret own_use au
end

fn stmt_free to long
  ar = array_name 0 1 AN_FREE 0 0
  if lt ar 0
    ret ar
  end
  au = ulong ar
  if ne ty_ref get g_regs au R_OWN
    err_start
    err_c 39
    err_w sub get g_st 21 1
    err_t te_free_own
    ret neg long 1
  end
  sv = get g_st 42
  wh = val_alloc
  put g_v_head wh 0
  put g_v_arity wh 1
  rc = line_end long wh
  put g_st 42 sv
  if lt rc 0
    ret rc
  end
  rc = emit_release au
  if lt rc 0
    ret rc
  end
  ret own_release au
end

fn stmt_call g ulong to long
  if ne get g_fn_hret g 0
    err_start
    err_fn g
    err_t te_ret_need1
    err_ty get g_fn_ret g
    err_t te_call_keep1
    err_fn g
    err_t te_call_keep2
    ret neg long 1
  end
  args = new ulong 6 0
  rc = call_args g 0 edit args
  if lt rc 0
    ret rc
  end
  sv = get g_st 42
  wh = val_alloc
  put g_v_head wh 0
  put g_v_arity wh get g_fn_np g
  rc = line_end long wh
  put g_st 42 sv
  if lt rc 0
    ret rc
  end
  rc = emit_call_op g view args 0 0
  if lt rc 0
    ret rc
  end
  ret own_call g view args
end

fn stmt_assign w0o ulong w0l ulong to long
  ni = find_name_wp w0o w0l
  if and eq get g_st 20 1 eq get g_st 24 0
    err_start
    err_c 39
    err_wp w0o w0l
    err_t te_no_start
    ret neg long 1
  end
  if ge ni 0
    if eq get g_nm_fix ulong ni 1
      err_start
      err_c 39
      err_wp w0o w0l
      err_t te_loop_ctr
      ret neg long 1
    end
  end
  if lt ni 0
    if or ge find_func_wp w0o w0l 0 or reserved_wp w0o w0l not valid_ident_wp w0o w0l
      err_start
      err_c 39
      err_wp w0o w0l
      err_t te_cant_name
      ret neg long 1
    end
  end
  w = want_pack S_ALL A_ANY L_NO 1 0 0
  dst = neg long 1
  if ge ni 0
    reg = get g_nm_reg ulong ni
    w = want_set_top want_type get g_regs reg 1
    dst = long reg
  end
  if lt get g_st 21 get g_st 20
    if w_eq_t get g_st 21 t_eqs
      put g_st 21 add get g_st 21 1
    end
  end
  sv = get g_st 42
  vv = val_alloc
  r = value w dst vv
  if eq r neg long 3
    err_start
    err_t te_val_miss
    err_span 0 get g_st 21
    err_c 39
    put g_st 42 sv
    ret neg long 1
  end
  if lt r 0
    put g_st 42 sv
    ret r
  end
  if ne get g_v_lit vv 0
    vw = ulong get g_v_word vv
    err_start
    err_c 39
    err_w vw
    err_t te_num_unk
    err_w vw
    put g_st 42 sv
    ret neg long 1
  end
  rc = line_end long vv
  vreg = ulong get g_v_reg vv
  put g_st 42 sv
  if lt rc 0
    ret rc
  end
  if lt ni 0
    ret bind_name_wp w0o w0l vreg 0
  end
  ret 0
end

fn stmt to long
  w0o = w_off 0
  w0l = w_len 0
  if wp_eq_t w0o w0l tk_fn
    ret fn_line
  end
  if eq get g_st 6 0
    err_start
    err_c 39
    err_wp w0o w0l
    err_t te_eof_in_fn2
    put g_st 3 0
    err_start
    err_c 39
    err_wp w0o w0l
    err_c 39
    err_c 32
    err_c 111
    err_c 117
    err_c 116
    err_c 115
    err_c 105
    err_c 100
    err_c 101
    err_c 32
    err_c 97
    err_c 32
    err_c 102
    err_c 117
    err_c 110
    err_c 99
    err_c 116
    err_c 105
    err_c 111
    err_c 110
    err_c 32
    err_c 40
    err_c 115
    err_c 116
    err_c 97
    err_c 114
    err_c 116
    err_c 32
    err_c 111
    err_c 110
    err_c 101
    err_c 32
    err_c 119
    err_c 105
    err_c 116
    err_c 104
    err_c 32
    err_c 102
    err_c 110
    err_c 41
    ret neg long 1
  end
  fi = sub get g_st 5 1
  put g_st 21 1
  if wp_eq_t w0o w0l tk_end
    ret stmt_end fi
  end
  if wp_eq_t w0o w0l tk_else
    ret stmt_else
  end
  if wp_eq_t w0o w0l tk_if
    ret stmt_if
  end
  if wp_eq_t w0o w0l tk_while
    if eq get g_st 14 0
      err_start
      err_t te_dead_line
      ret neg long 1
    end
    ret guarded_loop 0 0 0 0 0
  end
  if wp_eq_t w0o w0l tk_for
    ret for_line
  end
  if wp_eq_t w0o w0l tk_break
    ret stmt_break
  end
  if wp_eq_t w0o w0l tk_ret
    ret stmt_ret fi
  end
  if wp_eq_t w0o w0l tk_trap
    ret stmt_trap fi
  end
  if wp_eq_t w0o w0l tk_put
    ret stmt_put
  end
  if wp_eq_t w0o w0l tk_free
    ret stmt_free
  end
  if and ge find_func_wp w0o w0l 0 lt find_callable_wp w0o w0l 0
    err_start
    err_wp w0o w0l
    err_t te_self_call
    ret neg long 1
  end
  g = find_callable_wp w0o w0l
  if ge g 0
    ret stmt_call ulong g
  end
  ret stmt_assign w0o w0l
end

note ---- split_line & run_src ----
fn is_sep c uchar to bool
  if or eq c 32 eq c 9
    ret true
  end
  if or eq c 13 or eq c 40 eq c 41
    ret true
  end
  ret false
end

fn is_word_ch c uchar to bool
  if is_alnum c
    ret true
  end
  if or eq c 95 or eq c 45 eq c 61
    ret true
  end
  ret false
end

fn split_src start ulong endp ulong base ulong to long
  n = ulong 0
  p = start
  while lt p endp bound BIG
    c = get g_src p
    if or eq c 32 or eq c 9 eq c 13
      p = add p 1
      continue
    end
    if ge n MAX_WORDS
      err_start
      err_t te_max_words
      ret neg long 1
    end
    if or eq c 40 eq c 41
      off = get g_st 31
      wp_push_c c
      put g_lw_off add base n off
      put g_lw_len add base n 1
      n = add n 1
      p = add p 1
      continue
    end
    off = get g_st 31
    wl = ulong 0
    while lt p endp bound BIG
      ch = get g_src p
      if is_sep ch
        break
      end
      if not is_word_ch ch
        err_start
        err_t te_bad_char1
        err_c ch
        err_t te_bad_char2
        ret neg long 1
      end
      wp_push_c ch
      wl = add wl 1
      p = add p 1
    end
    put g_lw_off add base n off
    put g_lw_len add base n wl
    n = add n 1
  end
  ret long n
end

fn split_lineb base ulong to long
  n = ulong 0
  p = ulong 0
  endp = get g_lineb_n 0
  while lt p endp bound 256
    c = get g_lineb p
    if or eq c 32 or eq c 9 eq c 13
      p = add p 1
      continue
    end
    if ge n MAX_WORDS
      err_start
      err_t te_max_words
      ret neg long 1
    end
    if or eq c 40 eq c 41
      off = get g_st 31
      wp_push_c c
      put g_lw_off add base n off
      put g_lw_len add base n 1
      n = add n 1
      p = add p 1
      continue
    end
    off = get g_st 31
    wl = ulong 0
    while lt p endp bound 256
      ch = get g_lineb p
      if is_sep ch
        break
      end
      if not is_word_ch ch
        err_start
        err_t te_bad_char1
        err_c ch
        err_t te_bad_char2
        ret neg long 1
      end
      wp_push_c ch
      wl = add wl 1
      p = add p 1
    end
    put g_lw_off add base n off
    put g_lw_len add base n wl
    n = add n 1
  end
  ret long n
end

fn run_src slen ulong keep_tail ulong to long
  p = ulong 0
  put g_st 4 0
  put g_st 1 0
  if eq get g_st 25 0
    out_t tj_head
  end
  while true bound BIG
    nl = p
    found_nl = false
    while lt nl slen bound BIG
      if eq get g_src nl 10
        found_nl = true
        break
      end
      nl = add nl 1
    end
    if and not found_nl ne keep_tail 0
      ret 0
    end
    put g_st 4 add get g_st 4 1
    put g_st 31 0
    put g_st 23 0
    n = split_src p nl 0
    if lt n 0
      ret n
    end
    if gt n 0
      put g_st 20 ulong n
      put g_st 21 0
      put g_st 22 0
      put g_st 42 0
      rc = stmt
      if lt rc 0
        ret rc
      end
    end
    if not found_nl
      break
    end
    p = add nl 1
  end
  put g_st 4 add get g_st 4 1
  if ne get g_st 6 0
    err_start
    err_t te_eof_in_fn1
    err_fn sub get g_st 5 1
    err_t te_eof_in_fn2
    ret neg long 1
  end
  if eq get g_st 5 0
    err_start
    err_t te_no_fn
    ret neg long 1
  end
  if eq get g_st 25 0
    out_t tj_tail
  end
  ret 0
end

note ---- oracle state save / restore ----
fn save_state_rest to void
  nfr = get g_st 15
  nown = get g_st 16
  for i ulong nfr bound 64
    put s0_fr_kind i get g_fr_kind i
    put s0_fr_dep i get g_fr_dep i
    put s0_fr_els i get g_fr_els i
    put s0_fr_join i get g_fr_join i
    put s0_fr_hels i get g_fr_hels i
    put s0_fr_head i get g_fr_head i
    put s0_fr_exit i get g_fr_exit i
    put s0_fr_ctr i get g_fr_ctr i
    put s0_fr_ohas i get g_fr_ohas i
    base = mul i MAX_OWN
    for s ulong nown bound 64
      idx = add base s
      put s0_fr_oin_b idx get g_fr_oin_b idx
      put s0_fr_oin_m idx get g_fr_oin_m idx
      put s0_fr_oacc_b idx get g_fr_oacc_b idx
      put s0_fr_oacc_m idx get g_fr_oacc_m idx
      put s0_fr_opost_b idx get g_fr_opost_b idx
      put s0_fr_opost_m idx get g_fr_opost_m idx
    end
  end
  for s ulong nown bound 64
    put s0_own_reg s get g_own_reg s
    put s0_ost_b s get g_ost_b s
    put s0_ost_m s get g_ost_m s
  end
  nq = get g_st 17
  for i ulong nq bound 256
    put s0_owq_k i get g_owq_k i
    put s0_owq_kind i get g_owq_kind i
    put s0_owq_s i get g_owq_s i
    put s0_owq_line i get g_owq_line i
    put s0_owq_ob i get g_owq_ob i
    put s0_owq_om i get g_owq_om i
    nl = get g_owq_nlen i
    put s0_owq_nlen i nl
    off = mul i 64
    for j ulong nl bound 64
      put s0_owq_nm add off j get g_owq_nm add off j
    end
  end
end

fn restore_state_rest to void
  nfr = get g_st 15
  nown = get g_st 16
  for i ulong nfr bound 64
    put g_fr_kind i get s0_fr_kind i
    put g_fr_dep i get s0_fr_dep i
    put g_fr_els i get s0_fr_els i
    put g_fr_join i get s0_fr_join i
    put g_fr_hels i get s0_fr_hels i
    put g_fr_head i get s0_fr_head i
    put g_fr_exit i get s0_fr_exit i
    put g_fr_ctr i get s0_fr_ctr i
    put g_fr_ohas i get s0_fr_ohas i
    base = mul i MAX_OWN
    for s ulong nown bound 64
      idx = add base s
      put g_fr_oin_b idx get s0_fr_oin_b idx
      put g_fr_oin_m idx get s0_fr_oin_m idx
      put g_fr_oacc_b idx get s0_fr_oacc_b idx
      put g_fr_oacc_m idx get s0_fr_oacc_m idx
      put g_fr_opost_b idx get s0_fr_opost_b idx
      put g_fr_opost_m idx get s0_fr_opost_m idx
    end
  end
  for s ulong nown bound 64
    put g_own_reg s get s0_own_reg s
    put g_ost_b s get s0_ost_b s
    put g_ost_m s get s0_ost_m s
  end
  nq = get g_st 17
  for i ulong nq bound 256
    put g_owq_k i get s0_owq_k i
    put g_owq_kind i get s0_owq_kind i
    put g_owq_s i get s0_owq_s i
    put g_owq_line i get s0_owq_line i
    put g_owq_ob i get s0_owq_ob i
    put g_owq_om i get s0_owq_om i
    nl = get s0_owq_nlen i
    put g_owq_nlen i nl
    off = mul i 64
    for j ulong nl bound 64
      put g_owq_nm add off j get s0_owq_nm add off j
    end
  end
end

fn save_state to void
  put s0_st 0 get g_st 5
  put s0_st 1 get g_st 6
  put s0_st 2 get g_st 7
  put s0_st 3 get g_st 8
  put s0_st 4 get g_st 9
  put s0_st 5 get g_st 10
  put s0_st 6 get g_st 11
  put s0_st 7 get g_st 12
  put s0_st 8 get g_st 13
  put s0_st 9 get g_st 14
  put s0_st 10 get g_st 15
  put s0_st 11 get g_st 16
  put s0_st 12 get g_st 17
  put s0_st 13 get g_st 19
  nf = get g_st 5
  for i ulong nf bound 32
    nl = get g_fn_nlen i
    put s0_fn_nlen i nl
    off = mul i 64
    for j ulong nl bound 64
      put s0_fn_name add off j get g_fn_name add off j
    end
    np = get g_fn_np i
    put s0_fn_np i np
    pbase = mul i MAX_PARAMS
    for j ulong np bound 8
      put s0_fn_p add pbase j get g_fn_p add pbase j
    end
    put s0_fn_hret i get g_fn_hret i
    put s0_fn_ret i get g_fn_ret i
  end
  nr = get g_st 7
  for i ulong nr bound 512
    put s0_regs i get g_regs i
  end
  nn = get g_st 9
  for i ulong nn bound 512
    nl = get g_nm_len i
    put s0_nm_len i nl
    off = mul i 64
    for j ulong nl bound 64
      put s0_nm_str add off j get g_nm_str add off j
    end
    put s0_nm_reg i get g_nm_reg i
    put s0_nm_dep i get g_nm_dep i
    put s0_nm_fix i get g_nm_fix i
    put s0_nm_rd i get g_nm_rd i
  end
  nc = get g_st 11
  for i ulong nc bound 256
    put s0_ck_t i get g_ck_t i
    put s0_ck_neg i get g_ck_neg i
    put s0_ck_mag i get g_ck_mag i
    put s0_ck_reg i get g_ck_reg i
  end
  for i ulong get g_st 12 bound 512
    put s0_blk_nops i get g_blk_nops i
    put s0_blk_ord i get g_blk_ord i
    put s0_blk_refd i get g_blk_refd i
  end
  save_state_rest
end

fn restore_state to void
  put g_st 5 get s0_st 0
  put g_st 6 get s0_st 1
  put g_st 7 get s0_st 2
  put g_st 8 get s0_st 3
  put g_st 9 get s0_st 4
  put g_st 10 get s0_st 5
  put g_st 11 get s0_st 6
  put g_st 12 get s0_st 7
  put g_st 13 get s0_st 8
  put g_st 14 get s0_st 9
  put g_st 15 get s0_st 10
  put g_st 16 get s0_st 11
  put g_st 17 get s0_st 12
  put g_st 19 get s0_st 13
  put g_st 18 0
  nf = get g_st 5
  for i ulong nf bound 32
    nl = get s0_fn_nlen i
    put g_fn_nlen i nl
    off = mul i 64
    for j ulong nl bound 64
      put g_fn_name add off j get s0_fn_name add off j
    end
    np = get s0_fn_np i
    put g_fn_np i np
    pbase = mul i MAX_PARAMS
    for j ulong np bound 8
      put g_fn_p add pbase j get s0_fn_p add pbase j
    end
    put g_fn_hret i get s0_fn_hret i
    put g_fn_ret i get s0_fn_ret i
  end
  nr = get g_st 7
  for i ulong nr bound 512
    put g_regs i get s0_regs i
  end
  nn = get g_st 9
  for i ulong nn bound 512
    nl = get s0_nm_len i
    put g_nm_len i nl
    off = mul i 64
    for j ulong nl bound 64
      put g_nm_str add off j get s0_nm_str add off j
    end
    put g_nm_reg i get s0_nm_reg i
    put g_nm_dep i get s0_nm_dep i
    put g_nm_fix i get s0_nm_fix i
    put g_nm_rd i get s0_nm_rd i
  end
  nc = get g_st 11
  for i ulong nc bound 256
    put g_ck_t i get s0_ck_t i
    put g_ck_neg i get s0_ck_neg i
    put g_ck_mag i get s0_ck_mag i
    put g_ck_reg i get s0_ck_reg i
  end
  for i ulong get g_st 12 bound 512
    put g_blk_nops i get s0_blk_nops i
    put g_blk_ord i get s0_blk_ord i
    put g_blk_refd i get s0_blk_refd i
  end
  restore_state_rest
end

note ---- run_line, own_repair, close_all, judge, witness ----
fn run_line_lineb to long
  put g_st 4 add get g_st 4 1
  put g_st 31 get g_st 33
  put g_st 23 RL_BASE
  n = split_lineb RL_BASE
  if le n 0
    ret n
  end
  put g_st 20 ulong n
  put g_st 21 0
  put g_st 22 0
  put g_st 42 0
  ret stmt
end

fn own_repair_check_name nu ulong r ulong to bool
  saved = get g_st 31
  off = saved
  nl = get g_nm_len nu
  nsrc = mul nu 64
  for j ulong nl bound 64
    wp_push_c get g_nm_str add nsrc j
  end
  fn_i = find_name_wp off nl
  put g_st 31 saved
  if lt fn_i 0
    ret false
  end
  ret eq get g_nm_reg ulong fn_i r
end

fn own_repair_emit ek ulong ob uchar s ulong nu ulong r ulong to bool
  osb = get g_ost_b s
  osm = get g_ost_m s
  has_l = ne and ulong ob OS_L 0
  if or eq ek OW_USE eq ek OW_FREE
    if and not has_l not os_only osb osm
      put g_lineb_n 0 0
      if or ne osm 0 ne and ulong osb OS_L 0
        lb_t tk_free
        lb_c 32
        lb_nm nu
      else
        rt = get g_regs r
        lb_nm nu
        lb_c 32
        lb_c 61
        lb_c 32
        lb_t to_new
        lb_c 32
        lb_gw ty_s rt
        lb_c 32
        lb_u64 ty_len rt
        lb_c 32
        if eq ty_s rt T_BOOL
          lb_t tk_false
        else
          lb_c 48
        end
      end
      ret true
    end
  end
  if or eq ek OW_BIRTH eq ek OW_RET
    if and has_l not os_none osb osm
      put g_lineb_n 0 0
      lb_t tk_free
      lb_c 32
      lb_nm nu
      ret true
    end
  end
  ret false
end

fn own_repair_one i ulong k ulong to bool
  kb = shl ulong 1 k
  nkb = xor kb sub ulong 0 1
  s = get g_owq_s i
  idx = add mul k MAX_OWN s
  ob = get g_owq_ob i
  om = get g_owq_om i
  if ne and om kb 0
    hb = uchar or ulong get g_fr_oin_b idx ulong get g_ost_b s
    hm = or get g_fr_oin_m idx and get g_ost_m s nkb
    ob = uchar or ulong ob ulong hb
    om = or and om nkb hm
  end
  if ne om 0
    ret false
  end
  r = get g_own_reg s
  ni = own_label r
  if lt ni 0
    ret false
  end
  if not own_repair_check_name ulong ni r
    ret false
  end
  ret own_repair_emit get g_owq_kind i ob s ulong ni r
end

fn own_repair to bool
  k = sub get g_st 15 1
  nq = get g_st 17
  for i ulong nq bound 256
    if eq get g_owq_k i k
      if own_repair_one i k
        ret true
      end
    end
  end
  ret false
end

fn close_find_unread to long
  nn = get g_st 9
  dep = get g_st 10
  for i ulong nn bound 512
    if ne get g_nm_fix i 0
      continue
    end
    if ne get g_nm_rd i 0
      continue
    end
    if ge get g_nm_dep i dep
      ret long i
    end
  end
  ret neg long 1
end

fn close_all_cur to void
  u = close_find_unread
  if ge u 0
    lb_nm ulong u
    lb_c 32
    lb_c 61
    lb_c 32
    lb_nm ulong u
    ret
  end
  top_fk = get g_fr_kind sub get g_st 15 1
  if eq top_fk F_FN
    hidden = false
    nown = get g_st 16
    for s ulong nown bound 64
      if ne and ulong get g_ost_b s OS_L 0
        ni = own_label get g_own_reg s
        if ge ni 0
          lb_t tk_free
          lb_c 32
          lb_nm ulong ni
          ret
        else
          hidden = true
        end
      end
    end
    if hidden
      lb_t tk_trap
      lb_c 32
      lb_c 49
      ret
    end
    fi = sub get g_st 5 1
    if ne get g_fn_hret fi 0
      lb_t tk_ret
      lb_c 32
      if eq ty_s get g_fn_ret fi T_BOOL
        lb_t tk_false
      else
        lb_c 48
      end
      ret
    end
    lb_t tk_end
    ret
  end
  if or eq top_fk F_WHILE eq top_fk F_FOR
    if own_repair
      ret
    end
  end
  lb_t tk_end
end

fn close_all to long
  for guard ulong 1500 bound 1600
    put g_lineb_n 0 0
    if eq get g_st 6 0
      if gt get g_st 5 0
        break
      end
      make_fresh_name
      lb_t tk_fn
      lb_c 32
      lb_fresh
      lb_c 32
      lb_t tk_to
      lb_c 32
      lb_t tk_void
    else
      if gt get g_st 14 0
        close_all_cur
      else
        lb_t tk_end
      end
    end
    rc = run_line_lineb
    if lt rc 0
      ret rc
    end
    close_lineb
  end
  ret 0
end

fn judge nw ulong to long
  restore_state
  put g_st 23 0
  put g_st 20 nw
  put g_st 21 0
  put g_st 22 0
  put g_st 24 0
  put g_st 4 get g_st 35
  put g_st 42 0
  if gt nw MAX_WORDS
    err_start
    err_t te_max_words
    ret neg long 1
  end
  if gt nw 0
    rc = stmt
    if lt rc 0
      ret rc
    end
  end
  clen = get g_st 44
  p = ulong 0
  while lt p clen bound BIG
    e = p
    while lt e clen bound BIG
      if eq get g_close e 10
        break
      end
      e = add e 1
    end
    put g_lineb_n 0 0
    for j ulong sub e p bound 256
      lb_c get g_close add p j
    end
    rc = run_line_lineb
    if lt rc 0
      ret rc
    end
    p = add e 1
  end
  put g_st 4 add get g_st 4 1
  if ne get g_st 6 0
    err_start
    err_t te_eof_in_fn1
    err_fn sub get g_st 5 1
    err_t te_eof_in_fn2
    ret neg long 1
  end
  if eq get g_st 5 0
    err_start
    err_t te_no_fn
    ret neg long 1
  end
  ret 0
end

fn witness nw ulong fill ulong wsave ulong to long
  r = neg long 1
  for pk ulong 64 bound 64
    put g_st 28 pk
    restore_state
    put g_st 31 wsave
    put g_st 30 0
    put g_st 29 0
    put g_st 26 0
    put g_st 23 0
    put g_st 20 nw
    put g_st 21 0
    put g_st 22 0
    put g_st 24 fill
    put g_st 4 get g_st 35
    put g_st 42 0
    if gt nw 0
      r = stmt
    else
      r = 0
    end
    put g_st 24 0
    put g_st 26 0
    if gt get g_st 30 0
      put g_st 39 1
    else
      put g_st 39 0
    end
    put g_st 38 get g_st 20
    put g_st 33 get g_st 31
    put g_st 44 0
    if eq r 0
      put g_st 39 1
      r = close_all
    end
    if eq r 0
      r = judge get g_st 38
    end
    if or eq r 0 ge add pk 1 get g_st 29
      break
    end
  end
  ret r
end

fn legal_wp has_a ulong ao ulong al ulong fill ulong to bool
  nw = get g_st 34
  for i ulong nw bound 128
    put g_lw_off i get g_W_off i
    put g_lw_len i get g_W_len i
  end
  n = nw
  if ne has_a 0
    put g_lw_off n ao
    put g_lw_len n al
    n = add n 1
  end
  ret eq witness n fill get g_st 31 0
end

fn legal_t s view uchar * fill ulong to bool
  put g_st 31 get g_st 32
  off = wp_push_t s
  ret legal_wp 1 off len s fill
end

fn legal_u_t s view uchar * fill ulong to bool
  put g_st 31 get g_st 32
  off = wp_push_t s
  nw = get g_st 34
  for i ulong nw bound 128
    put g_lw_off i get g_W_off i
    put g_lw_len i get g_W_len i
  end
  put g_lw_off nw get g_st 36
  put g_lw_len nw get g_st 37
  put g_lw_off add nw 1 off
  put g_lw_len add nw 1 len s
  ret eq witness add nw 2 fill get g_st 31 0
end

fn legal_eof to bool
  restore_state
  nw = get g_st 34
  for i ulong nw bound 128
    put g_lw_off i get g_W_off i
    put g_lw_len i get g_W_len i
  end
  n = nw
  if gt get g_st 37 0
    put g_lw_off n get g_st 36
    put g_lw_len n get g_st 37
    n = add n 1
  end
  put g_st 23 0
  put g_st 20 n
  put g_st 21 0
  put g_st 22 0
  put g_st 24 0
  put g_st 4 get g_st 35
  put g_st 42 0
  if gt n 0
    if lt stmt 0
      ret false
    end
  end
  ret and eq get g_st 6 0 gt get g_st 5 0
end

note ---- fixed words table (order = KWORDER + OPW + GW + IRN[1..] + REFW[1..]) ----
fn fw_push_wp k ulong to ulong
  if eq k 0
    ret wp_push_t tk_fn
  end
  if eq k 1
    ret wp_push_t tk_if
  end
  if eq k 2
    ret wp_push_t tk_while
  end
  if eq k 3
    ret wp_push_t tk_for
  end
  if eq k 4
    ret wp_push_t tk_ret
  end
  if eq k 5
    ret wp_push_t tk_put
  end
  if eq k 6
    ret wp_push_t tk_free
  end
  if eq k 7
    ret wp_push_t tk_trap
  end
  if eq k 8
    ret wp_push_t tk_break
  end
  if eq k 9
    ret wp_push_t tk_else
  end
  if eq k 10
    ret wp_push_t tk_end
  end
  if eq k 11
    ret wp_push_t tk_to
  end
  if eq k 12
    ret wp_push_t tk_void
  end
  if eq k 13
    ret wp_push_t tk_bound
  end
  if eq k 14
    ret wp_push_t t_eqs
  end
  if eq k 15
    ret wp_push_t tk_true
  end
  if eq k 16
    ret wp_push_t tk_false
  end
  if eq k 17
    ret wp_push_t to_add
  end
  if eq k 18
    ret wp_push_t to_sub
  end
  if eq k 19
    ret wp_push_t to_mul
  end
  if eq k 20
    ret wp_push_t to_div
  end
  if eq k 21
    ret wp_push_t to_rem
  end
  if eq k 22
    ret wp_push_t to_and
  end
  if eq k 23
    ret wp_push_t to_or
  end
  if eq k 24
    ret wp_push_t to_xor
  end
  if eq k 25
    ret wp_push_t to_shl
  end
  if eq k 26
    ret wp_push_t to_shr
  end
  if eq k 27
    ret wp_push_t to_eq
  end
  if eq k 28
    ret wp_push_t to_ne
  end
  if eq k 29
    ret wp_push_t to_lt
  end
  if eq k 30
    ret wp_push_t to_le
  end
  if eq k 31
    ret wp_push_t to_gt
  end
  if eq k 32
    ret wp_push_t to_ge
  end
  if eq k 33
    ret wp_push_t to_neg
  end
  if eq k 34
    ret wp_push_t to_not
  end
  if eq k 35
    ret wp_push_t to_get
  end
  if eq k 36
    ret wp_push_t to_new
  end
  if eq k 37
    ret wp_push_t tg_bool
  end
  if eq k 38
    ret wp_push_t tg_uchar
  end
  if eq k 39
    ret wp_push_t tg_ushort
  end
  if eq k 40
    ret wp_push_t tg_uint
  end
  if eq k 41
    ret wp_push_t tg_ulong
  end
  if eq k 42
    ret wp_push_t tg_byte
  end
  if eq k 43
    ret wp_push_t tg_short
  end
  if eq k 44
    ret wp_push_t tg_int
  end
  if eq k 45
    ret wp_push_t tg_long
  end
  if eq k 46
    ret wp_push_t ti_u8
  end
  if eq k 47
    ret wp_push_t ti_u16
  end
  if eq k 48
    ret wp_push_t ti_u32
  end
  if eq k 49
    ret wp_push_t ti_u64
  end
  if eq k 50
    ret wp_push_t ti_i8
  end
  if eq k 51
    ret wp_push_t ti_i16
  end
  if eq k 52
    ret wp_push_t ti_i32
  end
  if eq k 53
    ret wp_push_t ti_i64
  end
  if eq k 54
    ret wp_push_t tr_own
  end
  if eq k 55
    ret wp_push_t tr_edit
  end
  ret wp_push_t tr_view
end

note ---- ids table & extends ----
fn wp_extends_u wo ulong wl ulong to bool
  ul = get g_st 37
  if lt wl ul
    ret false
  end
  uo = get g_st 36
  for i ulong ul bound 64
    if ne get g_wpool add wo i get g_wpool add uo i
      ret false
    end
  end
  ret true
end

fn id_extends_u idx ulong to bool
  ul = get g_st 37
  if lt get g_ids_len idx ul
    ret false
  end
  io = mul idx 64
  uo = get g_st 36
  for i ulong ul bound 64
    if ne get g_ids_str add io i get g_wpool add uo i
      ret false
    end
  end
  ret true
end

fn id_eq_wp idx ulong off ulong n ulong to bool
  if ne get g_ids_len idx n
    ret false
  end
  io = mul idx 64
  for j ulong n bound 64
    if ne get g_ids_str add io j get g_wpool add off j
      ret false
    end
  end
  ret true
end

fn find_id_wp off ulong n ulong to long
  ni = get g_st 43
  for i ulong ni bound 4096
    if id_eq_wp i off n
      ret long i
    end
  end
  ret neg long 1
end

fn add_id_wp off ulong n ulong kind ulong to void
  if or not valid_ident_wp off n or reserved_wp off n ge find_id_wp off n 0
    ret
  end
  ni = get g_st 43
  if ge ni len g_ids_len
    nc = mul ni 2
    if lt nc 128
      nc = 128
    end
    r1 = enlarge g_ids_str mul nc 64
    r2 = enlarge g_ids_len nc
    r3 = enlarge g_ids_kind nc
    r4 = enlarge g_ids_leg nc
    if or lt r1 0 or lt r2 0 or lt r3 0 lt r4 0
      exit 2
    end
  end
  dst = mul ni 64
  for j ulong n bound 64
    put g_ids_str add dst j get g_wpool add off j
  end
  put g_ids_len ni n
  put g_ids_kind ni kind
  put g_ids_leg ni 0
  put g_st 43 add ni 1
end

fn representative to bool
  uo = get g_st 36
  ul = get g_st 37
  if and gt ul 0 not valid_ident_wp uo ul
    ret false
  end
  tmp = new uchar 24 0
  for step ulong 1002 bound 1005
    rn = ulong 0
    if eq step 0
      if eq ul 0
        continue
      end
      for i ulong ul bound 64
        put g_rep i get g_wpool add uo i
      end
      rn = ul
    else
      if gt ul 0
        for i ulong ul bound 64
          put g_rep i get g_wpool add uo i
        end
        rn = ul
      else
        put g_rep 0 110
        rn = 1
      end
      if lt rn 70
        put g_rep rn 95
        rn = add rn 1
      end
      if gt step 1
        k = sub step 2
        if eq k 0
          put g_rep rn 48
          rn = add rn 1
        else
          tk = ulong 0
          while gt k 0 bound 16
            put tmp tk uchar add 48 rem k 10
            k = div k 10
            tk = add tk 1
          end
          while gt tk 0 bound 16
            tk = sub tk 1
            if lt rn 70
              put g_rep rn get tmp tk
              rn = add rn 1
            end
          end
        end
      end
    end
    if gt rn NAME_MAX_LEN
      ret false
    end
    put g_st 31 get g_st 32
    off = get g_st 31
    for i ulong rn bound 64
      wp_push_c get g_rep i
    end
    if and not reserved_wp off rn lt find_id_wp off rn 0
      put g_rep_n 0 rn
      ret true
    end
  end
  ret false
end

note ---- 128-bit signed integer arithmetic (hi long, lo ulong) ----
fn i128_lt ah long al ulong bh long bl ulong to bool
  if ne ah bh
    ret lt ah bh
  end
  ret lt al bl
end

fn i128_eq ah long al ulong bh long bl ulong to bool
  ret and eq ah bh eq al bl
end

fn i128_add ah long al ulong bh long bl ulong to void
  lo = add al bl
  c = long 0
  if lt lo al
    c = 1
  end
  put g_i128_hi 0 add add ah bh c
  put g_st 50 lo
end

fn i128_neg ah long al ulong to void
  lo = sub ulong 0 al
  hi = neg ah
  if ne al 0
    hi = sub hi 1
  end
  put g_i128_hi 0 hi
  put g_st 50 lo
end

fn u128_div10 uhi ulong ulo ulong to ulong
  rhi = rem uhi 10
  put g_st 49 div uhi 10
  t1 = add shl rhi 32 shr ulo 32
  q1 = div t1 10
  t0 = add shl rem t1 10 32 and ulo 4294967295
  put g_st 50 or shl q1 32 div t0 10
  ret rem t0 10
end

fn i128_to_num which ulong hi long lo ulong to void
  is_neg = lt hi 0
  uhi = ulong 0
  ulo = lo
  if is_neg
    i128_neg hi lo
    uhi = ulong get g_i128_hi 0
    ulo = get g_st 50
  else
    uhi = ulong hi
  end
  tmp = new uchar 48 0
  k = ulong 0
  while true bound 48
    put tmp k uchar add 48 u128_div10 uhi ulo
    k = add k 1
    uhi = get g_st 49
    ulo = get g_st 50
    if and eq uhi 0 eq ulo 0
      break
    end
  end
  j = ulong 0
  if eq which 1
    if is_neg
      put g_num1 j 45
      j = add j 1
    end
    while gt k 0 bound 48
      k = sub k 1
      put g_num1 j get tmp k
      j = add j 1
    end
    put g_num1_n 0 j
  else
    if is_neg
      put g_num2 j 45
      j = add j 1
    end
    while gt k 0 bound 48
      k = sub k 1
      put g_num2 j get tmp k
      j = add j 1
    end
    put g_num2_n 0 j
  end
end

fn i128_lt_st a ulong b ulong to bool
  ret i128_lt get g_i128_hi a get g_st add 50 a get g_i128_hi b get g_st add 50 b
end

fn number_extends_try is_neg ulong dval ulong p ulong to bool
  a_lo = mul dval p
  i128_add 0 a_lo 0 sub p 1
  if ne is_neg 0
    i128_neg get g_i128_hi 0 get g_st 50
    put g_i128_hi 3 get g_i128_hi 0
    put g_st 53 get g_st 50
    i128_neg 0 a_lo
    put g_i128_hi 4 get g_i128_hi 0
    put g_st 54 get g_st 50
  else
    put g_i128_hi 3 0
    put g_st 53 a_lo
    put g_i128_hi 4 get g_i128_hi 0
    put g_st 54 get g_st 50
  end
  if i128_lt_st 3 1
    put g_i128_hi 3 get g_i128_hi 1
    put g_st 53 get g_st 51
  end
  if i128_lt_st 2 4
    put g_i128_hi 4 get g_i128_hi 2
    put g_st 54 get g_st 52
  end
  if not i128_lt_st 4 3
    if ne is_neg 0
      put g_i128_hi 0 get g_i128_hi 4
      put g_st 50 get g_st 54
    else
      put g_i128_hi 0 get g_i128_hi 3
      put g_st 50 get g_st 53
    end
    ret true
  end
  ret false
end

fn number_extends_loop is_neg ulong doff ulong dlen ulong to bool
  if gt dlen 20
    ret false
  end
  for i ulong dlen bound 24
    if not is_digit get g_wpool add doff i
      ret false
    end
  end
  if eq get g_wpool doff 48
    if or gt dlen 1 ne is_neg 0
      ret false
    end
    if or i128_lt 0 0 get g_i128_hi 1 get g_st 51 i128_lt get g_i128_hi 2 get g_st 52 0 0
      ret false
    end
    put g_i128_hi 0 0
    put g_st 50 0
    ret true
  end
  dval = ulong 0
  umax = sub ulong 0 1
  for i ulong dlen bound 24
    dig = ulong sub get g_wpool add doff i 48
    if gt dval div sub umax dig 10
      ret false
    end
    dval = add mul dval 10 dig
  end
  p = ulong 1
  for k ulong 20 bound 24
    if gt dval div umax p
      break
    end
    if number_extends_try is_neg dval p
      ret true
    end
    if eq k 19
      break
    end
    p = mul p 10
  end
  ret false
end

fn number_extends loh long lol ulong hih long hil ulong to bool
  if i128_lt hih hil loh lol
    ret false
  end
  uo = get g_st 36
  ul = get g_st 37
  if eq ul 0
    if i128_lt 0 0 loh lol
      put g_i128_hi 0 loh
      put g_st 50 lol
    else
      if i128_lt hih hil 0 0
        put g_i128_hi 0 hih
        put g_st 50 hil
      else
        put g_i128_hi 0 0
        put g_st 50 0
      end
    end
    ret true
  end
  is_neg = ulong 0
  doff = uo
  dlen = ul
  if eq get g_wpool uo 45
    is_neg = 1
    doff = add uo 1
    dlen = sub ul 1
  end
  if eq dlen 0
    m1h = neg long 1
    m1l = sub ulong 0 1
    if i128_lt m1h m1l loh lol
      ret false
    end
    if i128_lt hih hil m1h m1l
      put g_i128_hi 0 hih
      put g_st 50 hil
    else
      put g_i128_hi 0 m1h
      put g_st 50 m1l
    end
    ret true
  end
  put g_i128_hi 1 loh
  put g_st 51 lol
  put g_i128_hi 2 hih
  put g_st 52 hil
  ret number_extends_loop is_neg doff dlen
end

fn init_breaks to ulong
  put g_bp_hi 0 neg long 1
  put g_bp_lo 0 1
  put g_bp_hi 1 neg long 1
  put g_bp_lo 1 9223372036854775808
  put g_bp_hi 2 neg long 1
  put g_bp_lo 2 sub ulong 0 2147483648
  put g_bp_hi 3 neg long 1
  put g_bp_lo 3 sub ulong 0 32768
  put g_bp_hi 4 neg long 1
  put g_bp_lo 4 sub ulong 0 128
  put g_bp_hi 5 0
  put g_bp_lo 5 0
  put g_bp_hi 6 0
  put g_bp_lo 6 1
  put g_bp_hi 7 0
  put g_bp_lo 7 14
  put g_bp_hi 8 0
  put g_bp_lo 8 64
  put g_bp_hi 9 0
  put g_bp_lo 9 127
  put g_bp_hi 10 0
  put g_bp_lo 10 255
  put g_bp_hi 11 0
  put g_bp_lo 11 32767
  put g_bp_hi 12 0
  put g_bp_lo 12 65535
  put g_bp_hi 13 0
  put g_bp_lo 13 1000000
  put g_bp_hi 14 0
  put g_bp_lo 14 2147483647
  put g_bp_hi 15 0
  put g_bp_lo 15 4294967295
  put g_bp_hi 16 0
  put g_bp_lo 16 9223372036854775807
  put g_bp_hi 17 0
  put g_bp_lo 17 18446744073709551615
  ret 18
end

fn sort_dedup_bp nb ulong to ulong
  i = ulong 1
  while lt i nb bound 128
    kh = get g_bp_hi i
    kl = get g_bp_lo i
    j = i
    while gt j 0 bound 128
      jm = sub j 1
      if not i128_lt kh kl get g_bp_hi jm get g_bp_lo jm
        break
      end
      put g_bp_hi j get g_bp_hi jm
      put g_bp_lo j get g_bp_lo jm
      j = jm
    end
    put g_bp_hi j kh
    put g_bp_lo j kl
    i = add i 1
  end
  m = ulong 0
  for k ulong nb bound 128
    keep = eq m 0
    if not keep
      keep = not i128_eq get g_bp_hi k get g_bp_lo k get g_bp_hi sub m 1 get g_bp_lo sub m 1
    end
    if keep
      put g_bp_hi m get g_bp_hi k
      put g_bp_lo m get g_bp_lo k
      m = add m 1
    end
  end
  ret m
end

note ---- oracle ----
fn refuse_out to int
  en = get g_st 3
  if eq get g_st 39 0
    so_t tc_refused
    so_err_buf 0 en
    so_c 10
    so_flush
    ret 1
  end
  m = ulong 0
  if ge en 5
    has_lp = and eq get g_err 0 108 eq get g_err 1 105
    if and has_lp and eq get g_err 2 110 and eq get g_err 3 101 eq get g_err 4 32
      p = ulong 5
      while lt add p 1 en bound 512
        if and eq get g_err p 58 eq get g_err add p 1 32
          m = add p 2
          break
        end
        p = add p 1
      end
    end
  end
  so_t tc_ref_pfx
  so_u64 get g_st 35
  so_t tc_ref_mid
  so_err_buf m sub en m
  so_t tc_ref_end
  so_flush
  ret 1
end

fn human_line lbl view uchar * to void
  n = get g_hbuf_n 0
  if gt n 0
    so_t lbl
    so_c 58
    for i ulong n bound 65536
      so_c get g_hbuf i
    end
    so_c 10
    put g_hbuf_n 0 0
  end
end

fn oracle_collect_bp to ulong
  nb = init_breaks
  lens = ulong 0
  snn = get s0_st 4
  for i ulong snn bound 512
    t = get s0_regs get s0_nm_reg i
    if ne ty_ref t R_NONE
      lens = or lens shl ulong 1 sub ty_len t 1
    end
  end
  for l0 ulong 64 bound 64
    if ne and shr lens l0 1 0
      put g_bp_hi nb 0
      put g_bp_lo nb add l0 1
      nb = add nb 1
    end
  end
  ret sort_dedup_bp nb
end

fn oracle_test_num ah long al ulong to bool
  i128_to_num 1 ah al
  put g_st 31 get g_st 32
  off = get g_st 31
  nl = get g_num1_n 0
  for j ulong nl bound 64
    wp_push_c get g_num1 j
  end
  ret legal_wp 1 off nl 1
end

fn oracle_num_step k ulong gap ulong nb ulong to void
  ah = get g_bp_hi k
  al = get g_bp_lo k
  bh = ah
  bl = al
  if ne gap 0
    if ge add k 1 nb
      ret
    end
    i128_add ah al 0 1
    ah = get g_i128_hi 0
    al = get g_st 50
    nk = add k 1
    i128_add get g_bp_hi nk get g_bp_lo nk neg long 1 sub ulong 0 1
    bh = get g_i128_hi 0
    bl = get g_st 50
    if i128_lt bh bl ah al
      ret
    end
  end
  if oracle_test_num ah al
    niv = get g_st 61
    if ne get g_st 62 0
      put g_hi_hi sub niv 1 bh
      put g_hi_lo sub niv 1 bl
    else
      put g_lo_hi niv ah
      put g_lo_lo niv al
      put g_hi_hi niv bh
      put g_hi_lo niv bl
      put g_st 61 add niv 1
      put g_st 62 1
    end
  else
    put g_st 62 0
  end
end

fn oracle_compute_nums to ulong
  ul = get g_st 37
  if gt ul 0
    c0 = get g_wpool get g_st 36
    if not or eq c0 45 is_digit c0
      ret 0
    end
  end
  nb = oracle_collect_bp
  put g_st 61 0
  put g_st 62 0
  for k ulong nb bound 128
    oracle_num_step k 0 nb
    oracle_num_step k 1 nb
  end
  niv = get g_st 61
  m = ulong 0
  for k ulong niv bound 256
    if number_extends get g_lo_hi k get g_lo_lo k get g_hi_hi k get g_hi_lo k
      put g_lo_hi m get g_lo_hi k
      put g_lo_lo m get g_lo_lo k
      put g_hi_hi m get g_hi_hi k
      put g_hi_lo m get g_hi_lo k
      m = add m 1
    end
  end
  ret m
end

fn oracle_print_machine nn ulong niv ulong flags ulong to void
  for k ulong NFIXED bound 64
    if ne get g_fx k 0
      so_t tm_word
      put g_st 31 get g_st 32
      off = fw_push_wp k
      so_wpool off sub get g_st 31 off
      so_c 10
    end
  end
  nids = get g_st 43
  for i ulong nids bound 4096
    if ne get g_ids_leg i 0
      so_t tm_word
      so_ids_name i
      so_c 10
    end
  end
  if ne nn 0
    so_t tm_newname
    for i ulong nids bound 4096
      if id_extends_u i
        so_c 32
        so_ids_name i
      end
    end
    so_c 10
  end
  for k ulong niv bound 256
    i128_to_num 1 get g_lo_hi k get g_lo_lo k
    i128_to_num 2 get g_hi_hi k get g_hi_lo k
    so_t tm_number
    so_num1
    so_c 32
    so_num2
    so_c 10
  end
  if ne and flags 1 0
    so_t tm_lpar
  end
  if ne and flags 2 0
    so_t tm_rpar
  end
  if ne and flags 4 0
    so_t tm_space
  end
  if ne and flags 8 0
    so_t tm_newline
  end
  if ne and flags 16 0
    so_t tm_eof
  end
  so_flush
end

fn oracle_print_human nn ulong niv ulong flags ulong to void
  put g_hbuf_n 0 0
  is_start = and eq get g_st 34 0 eq get g_st 37 0
  nids = get g_st 43
  for i ulong nids bound 4096
    if and ne get g_ids_leg i 0 ne get g_ids_kind i 1
      hbuf_c 32
      hbuf_ids i
    end
  end
  if is_start
    human_line th_assign
  else
    human_line th_names
  end
  for k ulong niv bound 256
    if gt k 0
      hbuf_c 44
    end
    hbuf_c 32
    i128_to_num 1 get g_lo_hi k get g_lo_lo k
    i128_to_num 2 get g_hi_hi k get g_hi_lo k
    hbuf_num1
    hbuf_t t_dotdot
    hbuf_num2
  end
  human_line th_number
  if ne nn 0
    hbuf_t th_anyname
  end
  human_line th_newname
  for k ulong NFIXED bound 64
    if ne get g_fx k 0
      hbuf_c 32
      put g_st 31 get g_st 32
      off = fw_push_wp k
      n = sub get g_st 31 off
      for j ulong n bound 64
        hbuf_c get g_wpool add off j
      end
    end
  end
  for i ulong nids bound 4096
    if and ne get g_ids_leg i 0 eq get g_ids_kind i 1
      hbuf_c 32
      hbuf_ids i
    end
  end
  if ne and flags 1 0
    hbuf_t th_lpar
  end
  if ne and flags 2 0
    hbuf_t th_rpar
  end
  if and ne and flags 4 0 gt get g_st 37 0
    hbuf_t th_space
  end
  if and ne and flags 8 0 not is_start
    hbuf_t th_newline
  end
  if ne and flags 16 0
    hbuf_t th_eof
  end
  human_line th_words
  so_flush
end

fn oracle_pick_first nn ulong niv ulong flags ulong to ulong
  ul = get g_st 37
  if ne and flags 4 0
    put g_st 57 get g_st 36
    put g_st 58 ul
    ret 1
  end
  for k ulong NFIXED bound 64
    if ne get g_fx k 0
      put g_st 31 get g_st 32
      fo = fw_push_wp k
      put g_st 57 fo
      put g_st 58 sub get g_st 31 fo
      ret 1
    end
  end
  nids = get g_st 43
  for i ulong nids bound 4096
    if ne get g_ids_leg i 0
      put g_st 31 get g_st 32
      put g_st 57 get g_st 31
      fl = get g_ids_len i
      put g_st 58 fl
      io = mul i 64
      for j ulong fl bound 64
        wp_push_c get g_ids_str add io j
      end
      ret 1
    end
  end
  if ne nn 0
    put g_st 31 get g_st 32
    put g_st 57 get g_st 31
    fl = get g_rep_n 0
    put g_st 58 fl
    for j ulong fl bound 64
      wp_push_c get g_rep j
    end
    ret 1
  end
  for k ulong niv bound 256
    if number_extends get g_lo_hi k get g_lo_lo k get g_hi_hi k get g_hi_lo k
      i128_to_num 1 get g_i128_hi 0 get g_st 50
      put g_st 31 get g_st 32
      put g_st 57 get g_st 31
      fl = get g_num1_n 0
      put g_st 58 fl
      for j ulong fl bound 64
        wp_push_c get g_num1 j
      end
      ret 1
    end
  end
  ret 0
end

fn oracle_complete nn ulong niv ulong flags ulong to int
  if ne and flags 16 0
    ret 0
  end
  ul = get g_st 37
  has_first = ulong 0
  fo = ulong 0
  fl = ulong 0
  if gt ul 0
    has_first = oracle_pick_first nn niv flags
    if eq has_first 0
      ok = legal_wp 1 get g_st 36 ul 1
      ret refuse_out
    end
    fo = get g_st 57
    fl = get g_st 58
  else
    put g_st 31 get g_st 32
  end
  if not legal_wp has_first fo fl 1
    ret refuse_out
  end
  if ne has_first 0
    if gt fl ul
      so_wpool add fo ul sub fl ul
    end
  end
  k = add get g_st 34 has_first
  gfl = get g_st 38
  while lt k gfl bound 1024
    so_c 32
    so_wpool get g_lw_off k get g_lw_len k
    k = add k 1
  end
  if gt gfl 0
    so_c 10
  end
  so_close
  so_flush
  ret 0
end

fn oracle_collect_ids nwu ulong to void
  nn0 = get g_st 9
  for j ulong nn0 bound 512
    put g_st 31 get g_st 32
    off = get g_st 31
    nl = get g_nm_len j
    nsrc = mul j 64
    for p ulong nl bound 64
      wp_push_c get g_nm_str add nsrc p
    end
    add_id_wp off nl 0
  end
  nf0 = get g_st 5
  for j ulong nf0 bound 32
    put g_st 31 get g_st 32
    off = get g_st 31
    nl = get g_fn_nlen j
    fsrc = mul j 64
    for p ulong nl bound 64
      wp_push_c get g_fn_name add fsrc p
    end
    add_id_wp off nl 1
  end
  for j ulong nwu bound 128
    add_id_wp get g_W_off j get g_W_len j 2
  end
end

fn oracle_eval_words to ulong
  any = ulong 0
  for k ulong NFIXED bound 64
    put g_fx k 0
    put g_st 31 get g_st 32
    off = fw_push_wp k
    wl = sub get g_st 31 off
    if wp_extends_u off wl
      if legal_wp 1 off wl 1
        put g_fx k 1
        any = 1
      end
    end
  end
  nids = get g_st 43
  for j ulong nids bound 4096
    put g_ids_leg j 0
    if id_extends_u j
      put g_st 31 get g_st 32
      off = get g_st 31
      nl = get g_ids_len j
      io = mul j 64
      for p ulong nl bound 64
        wp_push_c get g_ids_str add io p
      end
      if legal_wp 1 off nl 1
        put g_ids_leg j 1
        any = 1
      end
    end
  end
  nn_leg = ulong 0
  if representative
    put g_st 31 get g_st 32
    off = get g_st 31
    rl = get g_rep_n 0
    for p ulong rl bound 64
      wp_push_c get g_rep p
    end
    if legal_wp 1 off rl 1
      nn_leg = 1
      any = 1
    end
  end
  ret or any shl nn_leg 1
end

fn oracle_check_punct any ulong to ulong
  ul = get g_st 37
  flags = ulong 0
  if gt ul 0
    if legal_u_t t_lpar 1
      flags = or flags 1
    end
    if legal_u_t t_rpar 1
      flags = or flags 2
    end
    put g_st 31 get g_st 32
    if legal_wp 1 get g_st 36 ul 0
      flags = or flags 8
    end
  else
    if legal_t t_lpar 1
      flags = or flags 1
    end
    if legal_t t_rpar 1
      flags = or flags 2
    end
    put g_st 31 get g_st 32
    if legal_wp 0 0 0 0
      flags = or flags 8
    end
  end
  if legal_eof
    flags = or flags 16
  end
  if ne flags 0
    any = 1
  end
  if gt ul 0
    put g_st 31 get g_st 32
    if legal_wp 1 get g_st 36 ul 1
      flags = or flags 4
      any = 1
    end
  else
    if ne any 0
      flags = or flags 4
    end
  end
  ret or flags shl any 8
end

fn oracle_prep slen ulong to long
  put g_st 25 1
  put g_st 43 0
  tail = ulong 0
  i = slen
  while gt i 0 bound BIG
    i = sub i 1
    if eq get g_src i 10
      tail = add i 1
      break
    end
  end
  mid = false
  if gt sub slen tail 0
    if not is_sep get g_src sub slen 1
      mid = true
    end
  end
  put g_st 39 0
  if lt run_src tail 1 0
    ret neg long 1
  end
  tline = add get g_st 4 1
  put g_st 35 tline
  put g_st 4 tline
  put g_st 31 0
  put g_st 23 0
  nw = split_src tail slen 0
  if lt nw 0
    ret neg long 1
  end
  nwu = ulong nw
  for j ulong nwu bound 128
    put g_W_off j get g_lw_off j
    put g_W_len j get g_lw_len j
  end
  if mid
    nwu = sub nwu 1
    put g_st 36 get g_W_off nwu
    put g_st 37 get g_W_len nwu
  else
    put g_st 36 0
    put g_st 37 0
  end
  put g_st 34 nwu
  put g_st 32 get g_st 31
  save_state
  oracle_collect_ids nwu
  ret 0
end

fn oracle slen ulong mode ulong to int
  if lt oracle_prep slen 0
    ret refuse_out
  end
  ew = oracle_eval_words
  any = and ew 1
  nn_leg = shr ew 1
  niv = oracle_compute_nums
  if gt niv 0
    any = 1
  end
  pf = oracle_check_punct any
  flags = and pf 255
  any = shr pf 8
  if eq any 0
    ul = get g_st 37
    put g_st 31 get g_st 32
    if gt ul 0
      ok1 = legal_wp 0 0 0 1
      if or ok1 ne get g_st 39 0
        put g_st 31 get g_st 32
        ok2 = legal_wp 1 get g_st 36 ul 1
        put g_st 39 1
      end
    else
      ok3 = legal_wp 0 0 0 1
    end
    ret refuse_out
  end
  if eq mode M_MACHINE
    oracle_print_machine nn_leg niv flags
    ret 0
  end
  if eq mode M_HUMAN
    oracle_print_human nn_leg niv flags
    ret 0
  end
  ret oracle_complete nn_leg niv flags
end

note ---- CLI & file I/O ----
fn arg1_eq s view uchar * n ulong to bool
  if ne n len s
    ret false
  end
  for i ulong n bound 256
    if ne get g_arg1 i get s i
      ret false
    end
  end
  ret true
end

fn arg2_eq s view uchar * n ulong to bool
  if ne n len s
    ret false
  end
  for i ulong n bound 256
    if ne get g_arg2 i get s i
      ret false
    end
  end
  ret true
end

fn slurp_arg3 plen ulong to long
  fd = fopen g_arg3 0 plen 0 0
  if lt fd 0
    k = write 2 g_arg3 0 plen
    k2 = write 2 tc_open_err 0 len tc_open_err
    exit 2
  end
  r = enlarge g_src add MAX_IN 2
  if lt r 0
    cl = fclose int fd
    exit 2
  end
  tot = ulong 0
  lim = add MAX_IN 1
  while lt tot lim bound BIG
    k = read int fd g_src tot sub lim tot
    if eq k neg long 4
      continue
    end
    if lt k 0
      cl = fclose int fd
      exit 2
    end
    if eq k 0
      break
    end
    tot = add tot ulong k
  end
  cl = fclose int fd
  if gt tot MAX_IN
    k = write 2 g_arg3 0 plen
    k2 = write 2 tc_large_err 0 len tc_large_err
    exit 2
  end
  for i ulong tot bound BIG
    if eq get g_src i 0
      so_t tc_zero_err
      so_flush
      exit 1
    end
  end
  put g_st 0 tot
  ret long tot
end

fn write_out_arg2 plen ulong to int
  fd = fopen g_arg2 0 plen 577 420
  if lt fd 0
    k = write 2 g_arg2 0 plen
    k2 = write 2 tc_open_err 0 len tc_open_err
    ret 2
  end
  n = get g_st 1
  off = ulong 0
  while lt off n bound BIG
    k = write int fd g_out off sub n off
    if eq k neg long 4
      continue
    end
    if le k 0
      cl = fclose int fd
      k2 = write 2 g_arg2 0 plen
      k3 = write 2 tc_write_err 0 len tc_write_err
      ret 2
    end
    off = add off ulong k
  end
  cl = fclose int fd
  if lt cl 0
    k2 = write 2 g_arg2 0 plen
    k3 = write 2 tc_write_err 0 len tc_write_err
    ret 2
  end
  ret 0
end


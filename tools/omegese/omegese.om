    ret
  end
  out_t ti_i64
end

fn out_tir t ulong to void
  rf = ty_ref t
  if eq rf R_NONE
    out_irn ty_s t
    ret
  end
  if eq rf R_OWN
    out_t tr_own
  else
    if eq rf R_MUT
      out_t tri_mut
    else
      out_t tri_shared
    end
  end
  out_c 58
  out_irn ty_s t
  out_c 58
  out_u64 ty_len t
end


fn main to int
  ac = argcnt
  if eq ac 2
    n1 = argread 1 g_arg1 0 4095
    if ge n1 0
      if arg1_eq tc_words ulong n1
        ret cmd_words
      end
    end
  end
  if ge ac 3
    n1 = argread 1 g_arg1 0 4095
    if ge n1 0
      is_mach = false
      if and eq ac 4 arg1_eq tc_next ulong n1
        n2 = argread 2 g_arg2 0 4095
        if ge n2 0
          if arg2_eq tc_machine ulong n2
            is_mach = true
          end
        end
      end
      if or is_mach and eq ac 3 or arg1_eq tc_next ulong n1 arg1_eq tc_complete ulong n1
        pidx = sub ulong ac 1
        plen = argread pidx g_arg3 0 4095
        if lt plen 0
          k = write 2 tc_usage 0 len tc_usage
          ret 2
        end
        slen = slurp_arg3 ulong plen
        mode = M_COMPLETE
        if is_mach
          mode = M_MACHINE
        else
          if arg1_eq tc_next ulong n1
            mode = M_HUMAN
          end
        end
        ret oracle ulong slen mode
      end
      if and eq ac 4 arg1_eq tc_emit ulong n1
        in_len = argread 2 g_arg3 0 4095
        out_len = argread 3 g_arg2 0 4095
        if or lt in_len 0 lt out_len 0
          k = write 2 tc_usage 0 len tc_usage
          ret 2
        end
        slen = slurp_arg3 ulong in_len
        if lt run_src ulong slen 0 0
          so_t tc_refused
          so_err_buf 0 get g_st 3
          so_c 10
          so_flush
          ret 1
        end
        ret write_out_arg2 ulong out_len
      end
    end
  end
  k = write 2 tc_usage 0 len tc_usage
  ret 2
end

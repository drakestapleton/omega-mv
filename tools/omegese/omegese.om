  so_t tk_trap
  so_c 10
  so_t tk_put
  so_c 10
  so_t tk_free
  so_c 10
  so_t tk_true
  so_c 10
  so_t tk_false
  so_c 10
  so_t tk_bound
  so_c 10
  so_t to_add
  so_c 10
  so_t to_sub
  so_c 10
  so_t to_mul
  so_c 10
  so_t to_div
  so_c 10
  so_t to_rem
  so_c 10
  so_t to_and
  so_c 10
  so_t to_or
  so_c 10
  so_t to_xor
  so_c 10
  so_t to_shl
  so_c 10
  so_t to_shr
  so_c 10
  so_t to_eq
  so_c 10
  so_t to_ne
  so_c 10
  so_t to_lt
  so_c 10
  so_t to_le
  so_c 10
  so_t to_gt
  so_c 10
  so_t to_ge
  so_c 10
  so_t to_neg

  if lt emit_cbr ulong ge_r get g_st 59 get g_st 52 0
    ret neg long 1
  end
  start_block get g_st 59
  if lt emit_trap 4 0
    ret neg long 1
  end
  if lt emit_br get g_st 60 0
    ret neg long 1
  end
  start_block get g_st 52
  one = lit_reg_t t_1 ty_make R_NONE T_U64 0
  if lt one 0

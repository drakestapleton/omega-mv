note SPDX-License-Identifier: Apache-2.0
note tools/omega/main.om: the omega command's entry, composed last (after driver.om and kernels.om).
fn main to int
ac = ulong argcnt
if lt ac 2
cb_err dr_use
ret 2
end
if not cb_pa_arg 1
cb_err dr_use
ret 2
end
if not dr_need_lib
ret 69
end
put dr_n 12 dr_is_x86
if cb_pa_eq dr_c_hw
ret dr_hw
end
if cb_pa_eq dr_c_compile
ret dr_compile ac
end
if cb_pa_eq dr_c_run
ret dr_run ac
end
if cb_pa_eq dr_c_check
ret dr_check ac
end
if cb_pa_eq dr_c_console
ret dr_exec dr_n_con 2 ac
end
if cb_pa_eq dr_c_omc
ret dr_exec dr_n_omc 2 ac
end
if cb_pa_eq dr_c_version
ret dr_version
end
if cb_pa_eq dr_c_kernels
ret dr_kernels ac
end
cb_err dr_use
ret 2
end

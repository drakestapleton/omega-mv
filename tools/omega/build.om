note SPDX-License-Identifier: Apache-2.0
note tools/omega/build.om: build the omega package (docs/OMEGA-PACKAGE.md) from tracked sources.
note Build: cat seed/build/common.om tools/omega/build.om | seed/out/omc > build/om-package
note Usage: om-package [OUT]   (from the repository root; OUT defaults to build/package)
note 1. seed/out/omc must hash to seed/out/omc.sha256 (born from seed0.hex by seed/omega-from-seed.sh).
note 2. Every row of tools/omega/package.tsv: its parts are concatenated in order into OUT/src/CPU/PROGRAM.om
note    and compiled by seed/out/omc into OUT/lib/CPU/PROGRAM (mode 0755). The composed source is kept, so
note    every program in the package names the exact bytes it was compiled from.
note 3. bin/omega is copied to OUT/bin/omega.
note 4. OUT/MANIFEST.tsv: `compiler SHA PATH`, then per program `program CPU PROGRAM SHA SOURCE_SHA` and per
note    part `part CPU PROGRAM PATH SHA`, in package.tsv order.
note Exit: 0 PASS; 2 usage; 3 compiler pin mismatch; 4 a part or package.tsv unreadable; 5 a program refused
note by omc (its stderr is shown); 74 an output not written.

text pk_use "usage: om-package [OUT]\n"
text pk_def "build/package"
text pk_omc "seed/out/omc"
text pk_pin "seed/out/omc.sha256"
text pk_tsv "tools/omega/package.tsv"
text pk_disp "bin/omega"
text pk_lib "/lib/"
text pk_src "/src/"
text pk_bin "/bin"
text pk_binf "/bin/omega"
text pk_man "/MANIFEST.tsv"
text pk_dotom ".om"
text pk_m_pin "FAIL: seed/out/omc does not hash to seed/out/omc.sha256\n"
text pk_m_read "FAIL: cannot read "
text pk_m_omc "FAIL: omc refused "
text pk_m_write "FAIL: cannot write "
text pk_m_ok "PASS "
text pk_t_comp "compiler\t"
text pk_t_prog "program\t"
text pk_t_part "part\t"
text pk_t_share "share\t"
text pk_share_d "/share/"
text pk_tab "\t"
text pk_rc0 "RC=0\n"

global pk_out uchar 4096
global pk_t uchar *
global pk_man_b uchar *
global pk_n ulong 8
note pk_n: 0 out len, 1 package.tsv len, 2 manifest len, 3 compiler path len

fn pk_pa_out to void
cb_pa_clr
for i ulong get pk_n 0 bound 4096
cb_pa_ch get pk_out i
end
end

fn pk_man_ch c uchar to void
n = get pk_n 2
if ge n len pk_man_b
r = enlarge pk_man_b add mul n 2 4096
if ne r 0
exit 74
end
end
put pk_man_b n c
put pk_n 2 add n 1
end

fn pk_man_tx t view uchar * to void
for i ulong len t bound 4096
pk_man_ch get t i
end
end

fn pk_man_pa to void
for i ulong get cb_n 3 bound 4096
pk_man_ch get cb_pa i
end
end

fn pk_man_hex to void
for i ulong 64
pk_man_ch get cb_shex i
end
end

fn pk_man_t a ulong b ulong to void
for i ulong sub b a bound 4096
pk_man_ch get pk_t add a i
end
end

note pk_pa_t a b: cb_pa = package.tsv bytes a..b
fn pk_pa_t a ulong b ulong to void
cb_pa_clr
for i ulong sub b a bound 4096
cb_pa_ch get pk_t add a i
end
end

note pk_dir_pa dn c0 c1: cb_pa = OUT + dn + CPU (package.tsv bytes c0..c1)
fn pk_dir_pa dn view uchar * c0 ulong c1 ulong to void
pk_pa_out
cb_pa_tx dn
for i ulong sub c1 c0 bound 64
cb_pa_ch get pk_t add c0 i
end
end

fn pk_fail_pa t view uchar * code int to int
cb_err t
cb_wbuf_pa 2
cb_err cb_nl
ret code
end

global pk_srcsha uchar 64

note cb_sha_rb_wb: the composed source's SHA-256 (cb_wb), kept for the program's manifest row
fn cb_sha_rb_wb to void
cb_sha_reset
n = get cb_n 1
o = ulong 0
while lt o n bound 9223372036854775807
k = sub n o
if gt k 65536
k = 65536
end
for i ulong k bound 65536
put cb_chunk1 i get cb_wb add o i
end
cb_sha_push_chunk 0 k
o = add o k
end
cb_sha_finish
for i ulong 64
put pk_srcsha i get cb_shex i
end
end

fn pk_src_hex to void
for i ulong 64
pk_man_ch get pk_srcsha i
end
end

note pk_is_share a b: the line starts `share<TAB>`
fn pk_is_share a ulong b ulong to bool
if lt sub b a 7
ret false
end
for i ulong 6
if ne get pk_t add a i get pk_t_share i
ret false
end
end
ret true
end

note pk_share a b: copy PATH (bytes a+6..b) to OUT/share/PATH (mode 0644); manifest `share PATH SHA`
fn pk_share a ulong b ulong to int
p = add a 6
pk_pa_out
cb_pa_tx pk_share_d
for i ulong sub b p bound 4096
cb_pa_ch get pk_t add p i
end
cb_pb_from_pa
n = get cb_n 3
s = n
while gt s 0 bound 4096
s = sub s 1
if eq get cb_pa s 47
break
end
end
put cb_n 3 s
if not cb_mkdir_p_pa
ret pk_fail_pa pk_m_write 74
end
pk_pa_t p b
if not cb_copy_pa_to_pb 420
ret pk_fail_pa pk_m_write 74
end
if not cb_sha_file_pa
ret pk_fail_pa pk_m_read 4
end
pk_man_tx pk_t_share
pk_man_t p b
pk_man_tx pk_tab
pk_man_hex
pk_man_tx cb_nl
ret 0
end

note pk_row: one package.tsv line [a, b): CPU, PROGRAM, PARTS
fn pk_row a ulong b ulong to int
t1 = a
while and lt t1 b ne get pk_t t1 9 bound 4096
t1 = add t1 1
end
t2 = add t1 1
while and lt t2 b ne get pk_t t2 9 bound 4096
t2 = add t2 1
end
if ge t2 b
cb_err pk_use
ret 4
end
note compose the parts into cb_wb
cb_wb_clr
p = add t2 1
while lt p b bound 4096
q = p
while and lt q b ne get pk_t q 32 bound 4096
q = add q 1
end
pk_pa_t p q
if not cb_append_pa_to_wb
ret pk_fail_pa pk_m_read 4
end
p = add q 1
end
note OUT/src/CPU/PROGRAM.om, OUT/lib/CPU
pk_dir_pa pk_src a t1
if not cb_mkdir_p_pa
ret pk_fail_pa pk_m_write 74
end
cb_pa_ch 47
for i ulong sub t2 add t1 1 bound 64
cb_pa_ch get pk_t add add t1 1 i
end
cb_pa_tx pk_dotom
if not cb_write_wb_pa 420
ret pk_fail_pa pk_m_write 74
end
cb_sha_rb_wb
pk_dir_pa pk_lib a t1
if not cb_mkdir_p_pa
ret pk_fail_pa pk_m_write 74
end
cb_pa_ch 47
for i ulong sub t2 add t1 1 bound 64
cb_pa_ch get pk_t add add t1 1 i
end
cb_pb_from_pa
pk_dir_pa pk_src a t1
cb_pa_ch 47
for i ulong sub t2 add t1 1 bound 64
cb_pa_ch get pk_t add add t1 1 i
end
cb_pa_tx pk_dotom
r = cb_run_omc get pk_n 3 493 -1
if ne r 0
cb_pa_pb
ret pk_fail_pa pk_m_omc 5
end
note manifest: program CPU PROGRAM SHA SOURCE_SHA
pk_man_tx pk_t_prog
pk_man_t a t1
pk_man_tx pk_tab
pk_man_t add t1 1 t2
pk_man_tx pk_tab
cb_pa_pb
if not cb_sha_file_pa
ret pk_fail_pa pk_m_read 4
end
pk_man_hex
pk_man_tx pk_tab
pk_src_hex
pk_man_tx cb_nl
note parts: part CPU PROGRAM PATH SHA
p = add t2 1
while lt p b bound 4096
q = p
while and lt q b ne get pk_t q 32 bound 4096
q = add q 1
end
pk_man_tx pk_t_part
pk_man_t a t1
pk_man_tx pk_tab
pk_man_t add t1 1 t2
pk_man_tx pk_tab
pk_man_t p q
pk_man_tx pk_tab
pk_pa_t p q
if not cb_sha_file_pa
ret pk_fail_pa pk_m_read 4
end
pk_man_hex
pk_man_tx cb_nl
p = add q 1
end
cb_out pk_m_ok
cb_pa_pb
cb_wbuf_pa 1
cb_out cb_nl
ret 0
end

fn main to int
ac = ulong argcnt
if gt ac 2
cb_err pk_use
ret 2
end
if eq ac 2
if not cb_pa_arg 1
cb_err pk_use
ret 2
end
else
cb_pa_set pk_def
end
n = get cb_n 3
for i ulong n bound 4096
put pk_out i get cb_pa i
end
put pk_n 0 n
note 1. the compiler pin
cb_pa_set pk_omc
if not cb_sha_file_pa
ret pk_fail_pa pk_m_read 4
end
cb_pa_set pk_pin
if not cb_read_pa
ret pk_fail_pa pk_m_read 4
end
if lt get cb_n 0 64
cb_err pk_m_pin
ret 3
end
for i ulong 64
if ne get cb_rb i get cb_shex i
cb_err pk_m_pin
ret 3
end
end
pk_man_tx pk_t_comp
pk_man_hex
pk_man_tx pk_tab
pk_man_tx pk_omc
pk_man_tx cb_nl
cb_pa_set pk_omc
for i ulong get cb_n 3 bound 4096
put cb_pc i get cb_pa i
end
put pk_n 3 get cb_n 3
note 2. package.tsv rows
cb_pa_set pk_tsv
if not cb_read_pa
ret pk_fail_pa pk_m_read 4
end
tn = get cb_n 0
r = enlarge pk_t add tn 1
if ne r 0
ret 74
end
for i ulong tn bound 9223372036854775807
put pk_t i get cb_rb i
end
put pk_n 1 tn
a = ulong 0
while lt a tn bound 9223372036854775807
b = a
while and lt b tn ne get pk_t b 10 bound 9223372036854775807
b = add b 1
end
if and gt b a ne get pk_t a 35
rc = int 0
if pk_is_share a b
rc = pk_share a b
else
rc = pk_row a b
end
if ne rc 0
ret rc
end
end
a = add b 1
end
note 3. the dispatcher
pk_pa_out
cb_pa_tx pk_bin
if not cb_mkdir_p_pa
ret pk_fail_pa pk_m_write 74
end
pk_pa_out
cb_pa_tx pk_binf
cb_pb_from_pa
cb_pa_set pk_disp
if not cb_copy_pa_to_pb 493
cb_pa_pb
ret pk_fail_pa pk_m_write 74
end
note 4. MANIFEST.tsv
pk_pa_out
cb_pa_tx pk_man
cb_wb_clr
for i ulong get pk_n 2 bound 9223372036854775807
cb_wb_ch get pk_man_b i
end
if not cb_write_wb_pa 420
ret pk_fail_pa pk_m_write 74
end
cb_out pk_m_ok
cb_wbuf_pa 1
cb_out cb_nl
cb_out pk_rc0
ret 0
end

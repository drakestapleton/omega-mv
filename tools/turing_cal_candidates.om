note tools/turing_cal_candidates.om -- Pure seeded OM-2 port of tools/turing_cal_candidates.c
note (EXP-001 lane A candidate set, dev seeds 1-7 only). Concatenated with tools/turing_cal_dev.om.

const TXA_B2_MASK ulong 4
const TXA_MC_MASK ulong 93
const TXA_MEM_MASK ulong 32

text t_b2_digest "59ae9398da24e809d92ab39e7456382a0a4b7e93e203862be6d2ca55450dfd04"
text t_mc_digest "64a57ba9cf6f8b6e4558751ef2145ae2aa729c5214bfa29373eabfa220a57bc7"
text t_usage "usage: turing-cal-candidates write MANIFEST ROOT EVIDENCE_DIR OUTDIR | consts\n"
text t_cmd_consts "consts"
text t_cmd_write "write"
text t_f_b2 "ty2_baseline.tym"
text t_f_mc "ty2_candidate.tym"

text t_n0 "B0_uniform"
text t_n1 "B1_order0"
text t_n2 "B2_order1"
text t_n3 "B3_heuristic"
text t_n4 "M_candidate"
text t_n5 "M_mem"
text t_n6 "M_mem_seed1"

text t_fn0 "B0_uniform.tym"
text t_fn1 "B1_order0.tym"
text t_fn2 "B2_order1.tym"
text t_fn3 "B3_heuristic.tym"
text t_fn4 "M_candidate.tym"
text t_fn5 "M_mem.tym"
text t_fn6 "M_mem_seed1.tym"

text t_hdr1 "# EXP-001 candidate set, dev seeds 1-7 (in-sample). L(M) exact bits; L(D|M) ideal bits (micro-bit exact).\n"
text t_hdr2 "# name rows L(M)_bits L(D|M)_bits DL_bits bits_per_event code_bytes digest(turing.ymodel.v0)\n"
text t_rows " rows="
text t_lm " lm_bits="
text t_ld " ld_bits="
text t_dl " dl_bits="
text t_bpe " bpe="
text t_nsym " nsym="
text t_s1bpe " seed1_bpe="
text t_bytes " bytes="
text t_dig " digest="
text t_err_pre "turing-cal-candidates: "
text t_err_fail " failed rc="

fn streq_txt a view uchar * alen ulong b view uchar * to bool
  if ne alen len b
    ret false
  end
  for i ulong alen bound 256
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn txa_fail rc long to int
  ob_clr
  ob_txt t_err_pre
  ob_txt t_err_fail
  ob_i64 rc
  ob_b uchar 10
  ob_flush int 2
  ret int 2
end

fn set_join_path dir view uchar * dlen ulong file view uchar * to long
  fl = len file
  if ge add add dlen 1 fl 1200
    ret TY_E_FORMAT
  end
  for i ulong dlen bound 1024
    put g_path i get dir i
  end
  put g_path dlen uchar 47
  for i ulong fl bound 256
    put g_path add add dlen 1 i get file i
  end
  put g_plen 0 add add dlen 1 fl
  ret TY_OK
end

fn read_mcode_gp to long
  fd = fopen g_path 0 get g_plen 0 int 0 int 0
  if lt fd 0
    ret TY_E_IO
  end
  tot = ulong 0
  done = false
  while not done bound 1000000
    k = read int fd g_fbuf 0 65536
    if lt k 0
      dc = fclose int fd
      ret TY_E_IO
    end
    if eq k 0
      done = true
    else
      ku = ulong k
      if gt add tot ku TCD_MCODE_CAP
        dc = fclose int fd
        ret TY_E_IO
      end
      for i ulong ku bound 65536
        put g_mcode add tot i get g_fbuf i
      end
      tot = add tot ku
    end
  end
  dc = fclose int fd
  put g_mclen 0 tot
  ret TY_OK
end

fn write_mcode_gp nby ulong to long
  fd = fopen g_path 0 get g_plen 0 int 577 int 420
  if lt fd 0
    ret TY_E_IO
  end
  pos = ulong 0
  while lt pos nby bound 2000000
    chunk = sub nby pos
    if gt chunk 65536
      chunk = 65536
    end
    for i ulong chunk bound 65536
      put g_fbuf i get g_mcode add pos i
    end
    w = write int fd g_fbuf 0 chunk
    if ne w long chunk
      dc = fclose int fd
      ret TY_E_IO
    end
    pos = add pos chunk
  end
  if ne fclose int fd 0
    ret TY_E_IO
  end
  ret TY_OK
end

fn build_b3 to long
  rc = ty_key_space TY_F_OP TY_OUT_K
  if ne rc TY_OK
    ret rc
  end
  kb = get g_ty_ret_u 1
  rc2 = ty_model_uniform TY_OUT_K
  if ne rc2 TY_OK
    ret rc2
  end
  b3d = new uint 9 7282
  put b3d 7 uint 7281
  put b3d 8 uint 7281
  for x ulong 9
    if ne get g_md_def x get b3d x
      ret TY_E_PROFILE
    end
  end
  put g_md_k 0 TY_OUT_K
  put g_md_mask 0 TY_F_OP
  put g_md_kb 0 kb
  put g_md_nr 0 16
  for k ulong 16
    put g_md_rkey k k
    ro = mul k 16
    if eq k TY_OP_SUBMIT
      for x ulong 7
        put g_md_rq add ro x uint 1
      end
      put g_md_rq add ro 7 uint 32765
      put g_md_rq add ro 8 uint 32764
    else
      for x ulong 7
        put g_md_rq add ro x uint 9362
      end
      put g_md_rq add ro 7 uint 1
      put g_md_rq add ro 8 uint 1
    end
  end
  ret TY_OK
end

fn sharpen_active to void
  nr = get g_md_nr 0
  k = get g_md_k 0
  hi_q = uint sub TY_QONE sub k 1
  for i ulong nr bound 4194304
    ro = mul i 16
    best = ulong 0
    bestv = get g_md_rq ro
    for x ulong k bound 16
      if gt get g_md_rq add ro x bestv
        best = x
        bestv = get g_md_rq add ro x
      end
    end
    for x ulong k bound 16
      if eq x best
        put g_md_rq add ro x hi_q
      else
        put g_md_rq add ro x uint 1
      end
    end
  end
end

fn verify_evidence evdir view uchar * evlen ulong which ulong to long
  rc = TY_OK
  mask = TXA_B2_MASK
  if eq which 0
    rc = set_join_path evdir evlen t_f_b2
  else
    rc = set_join_path evdir evlen t_f_mc
    mask = TXA_MC_MASK
  end
  if ne rc TY_OK
    ret rc
  end
  rc = read_mcode_gp
  if ne rc TY_OK
    ret rc
  end
  nby = get g_mclen 0
  if gt nby 65536
    ret TY_E_IO
  end
  for i ulong nby bound 65536
    put g_mcode2 i get g_mcode i
  end
  put g_mc2len 0 nby
  ty_model_digest nby 16
  hx = new uchar 64 0
  if eq which 0
    for i ulong 64
      put hx i get t_b2_digest i
    end
  else
    for i ulong 64
      put hx i get t_mc_digest i
    end
  end
  if ne dg_parse_hex_at hx 0 64 17 TY_OK
    ret TY_E_DIGEST
  end
  if not dg_eq 16 17
    ret TY_E_DIGEST
  end
  for i ulong TCD_NDEV
    put g_fit_sids i i
  end
  rc = ty_model_fit TCD_NDEV mask TY_OUT_K TY_FIT_MDL_PRUNE
  if ne rc TY_OK
    ret rc
  end
  rc = ty_model_encode
  if ne rc TY_OK
    ret rc
  end
  if ne get g_mclen 0 get g_mc2len 0
    ret TY_E_PROVENANCE
  end
  for i ulong nby bound 65536
    if ne get g_mcode i get g_mcode2 i
      ret TY_E_PROVENANCE
    end
  end
  ret TY_OK
end

fn emit_cand_name idx ulong to void
  if eq idx 0
    ob_txt t_n0
    ret
  end
  if eq idx 1
    ob_txt t_n1
    ret
  end
  if eq idx 2
    ob_txt t_n2
    ret
  end
  if eq idx 3
    ob_txt t_n3
    ret
  end
  if eq idx 4
    ob_txt t_n4
    ret
  end
  if eq idx 5
    ob_txt t_n5
    ret
  end
  ob_txt t_n6
end

fn set_cand_path outdir view uchar * olen ulong idx ulong to long
  if eq idx 0
    ret set_join_path outdir olen t_fn0
  end
  if eq idx 1
    ret set_join_path outdir olen t_fn1
  end
  if eq idx 2
    ret set_join_path outdir olen t_fn2
  end
  if eq idx 3
    ret set_join_path outdir olen t_fn3
  end
  if eq idx 4
    ret set_join_path outdir olen t_fn4
  end
  if eq idx 5
    ret set_join_path outdir olen t_fn5
  end
  ret set_join_path outdir olen t_fn6
end

global g_cs_u ulong 8
global g_cs_i long 4

fn emit_cand_print idx ulong to void
  nr = get g_cs_u 0
  lm_bits = get g_cs_u 1
  nsym = get g_cs_u 2
  nsym1 = get g_cs_u 3
  nby = get g_cs_u 4
  ld_ub = get g_cs_i 0
  ld1_ub = get g_cs_i 1
  dl = get g_cs_i 2
  bpe = div div f64 ld_ub f64 1000000.0 f64 nsym
  s1bpe = div div f64 ld1_ub f64 1000000.0 f64 nsym1
  ob_clr
  emit_cand_name idx
  ob_txt t_rows
  ob_u64 nr
  ob_txt t_lm
  ob_u64 lm_bits
  ob_txt t_ld
  ob_ub_bits ld_ub
  ob_txt t_dl
  ob_ub_bits dl
  ob_txt t_bpe
  ob_f64_fixed bpe 6
  ob_txt t_nsym
  ob_u64 nsym
  ob_txt t_s1bpe
  ob_f64_fixed s1bpe 6
  ob_txt t_bytes
  ob_u64 nby
  ob_txt t_dig
  ob_dig 18
  ob_b uchar 10
  ob_flush int 1
end

fn emit_cand_score to long
  ld_ub = long 0
  nsym = ulong 0
  ld1_ub = long 0
  nsym1 = ulong 0
  for s ulong TCD_NDEV
    rc = ty_model_score s
    if ne rc TY_OK
      ret rc
    end
    ub = get g_ty_ret_i 0
    n = get g_ty_ret_u 0
    if ne ty_add ld_ub ub TY_OK
      ret TY_E_OVERFLOW
    end
    ld_ub = get g_ty_ret_i 0
    nsym = add nsym n
    if eq s 0
      ld1_ub = ub
      nsym1 = n
    end
  end
  put g_cs_i 0 ld_ub
  put g_cs_i 1 ld1_ub
  put g_cs_u 2 nsym
  put g_cs_u 3 nsym1
  ret TY_OK
end

fn emit_cand outdir view uchar * olen ulong idx ulong to long
  nby = get g_mclen 0
  rc = ty_model_decode nby
  if ne rc TY_OK
    ret rc
  end
  put g_cs_u 0 get g_md_nr 0
  put g_cs_u 1 get g_ty_ret_u 0
  put g_cs_u 4 nby
  rc = emit_cand_score
  if ne rc TY_OK
    ret rc
  end
  ty_model_digest nby 18
  rc = set_cand_path outdir olen idx
  if ne rc TY_OK
    ret rc
  end
  rc = write_mcode_gp nby
  if ne rc TY_OK
    ret rc
  end
  rc = ty_dl get g_cs_u 1 get g_cs_i 0
  if ne rc TY_OK
    ret rc
  end
  put g_cs_i 2 get g_ty_ret_i 0
  emit_cand_print idx
  ret TY_OK
end

fn run_write_models evdir view uchar * evlen ulong outdir view uchar * olen ulong to int
  ob_clr
  ob_txt t_hdr1
  ob_txt t_hdr2
  ob_flush int 1
  for i ulong TCD_NDEV
    put g_fit_sids i i
  end
  rc = ty_model_uniform TY_OUT_K
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = ty_model_encode
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = emit_cand outdir olen 0
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = ty_model_fit TCD_NDEV 0 TY_OUT_K TY_FIT_MDL_PRUNE
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = ty_model_encode
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = emit_cand outdir olen 1
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = verify_evidence evdir evlen 0
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = emit_cand outdir olen 2
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = build_b3
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = ty_model_encode
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = emit_cand outdir olen 3
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = verify_evidence evdir evlen 1
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = emit_cand outdir olen 4
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = ty_model_fit TCD_NDEV TXA_MEM_MASK TY_OUT_K TY_FIT_KEEP_ALL
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = ty_model_encode
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = emit_cand outdir olen 5
  if ne rc TY_OK
    ret txa_fail rc
  end
  put g_fit_sids 0 0
  rc = ty_model_fit 1 TXA_MEM_MASK TY_OUT_K TY_FIT_KEEP_ALL
  if ne rc TY_OK
    ret txa_fail rc
  end
  sharpen_active
  rc = ty_model_encode
  if ne rc TY_OK
    ret txa_fail rc
  end
  rc = emit_cand outdir olen 6
  if ne rc TY_OK
    ret txa_fail rc
  end
  ret int 0
end

fn cmd_write_load to long
  mp = new uchar 1024 0
  rt = new uchar 1024 0
  mpl = tcd_read_arg 2 mp 1024
  rtl = tcd_read_arg 3 rt 1024
  if or lt mpl 0 lt rtl 0
    ret TY_E_ARG
  end
  rc = tcd_load_manifest mp ulong mpl rt ulong rtl
  if ne rc TY_OK
    ret rc
  end
  s = ulong 1
  while le s TCD_NDEV bound 8
    rc = tcd_load_seed s
    if ne rc TY_OK
      ret rc
    end
    s = add s 1
  end
  ret TY_OK
end

fn cmd_write to int
  rc = cmd_write_load
  if ne rc TY_OK
    ret txa_fail rc
  end
  ev = new uchar 1024 0
  od = new uchar 1024 0
  evl = tcd_read_arg 4 ev 1024
  odl = tcd_read_arg 5 od 1024
  if or lt evl 0 lt odl 0
    ret txa_fail TY_E_ARG
  end
  ret run_write_models ev ulong evl od ulong odl
end


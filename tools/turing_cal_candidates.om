fn cmd_consts to int
  ign = ty_key_space TY_F_OP TY_OUT_K
  kb_b3 = get g_ty_ret_u 1
  ign = ty_key_space TXA_MEM_MASK TY_OUT_K
  kb_mem = get g_ty_ret_u 1
  ign = ty_key_space TXA_MC_MASK TY_OUT_K
  kb_mc = get g_ty_ret_u 1
  ob_clr
  ob_txt t_c1
  ob_u64 TY_OUT_K
  ob_txt t_c2
  ob_u64 TY_KMAX
  ob_txt t_c3
  ob_u64 TY_QBITS
  ob_txt t_c4
  ob_u64 TY_QONE
  ob_txt t_c5
  ob_u64 TY_MODEL_HEADER_BITS
  ob_txt t_c6
  ob_u64 TY_MODEL_VERSION
  ob_txt t_c7
  ob_txt t_ty_dom_model
  ob_txt t_c8
  ob_i64 TY_UB_PER_BIT
  ob_txt t_c9
  ob_u64 TY_QERR_MILLI_UB
  ob_txt t_c10
  ob_u64 TY_CTR1_BYTES
  ob_txt t_c11
  ob_u64 TY_DEPTH_CLIP
  ob_txt t_c12
  ob_u64 TY_OP_SUBMIT
  ob_txt t_c13
  ob_u64 TXA_B2_MASK
  ob_txt t_c14
  ob_u64 TXA_MC_MASK
  ob_txt t_c15
  ob_u64 TXA_MEM_MASK
  ob_txt t_c16
  ob_u64 TY_F_OP
  ob_txt t_c17
  ob_u64 kb_b3
  ob_txt t_c18
  ob_u64 kb_mem
  ob_txt t_c19
  ob_u64 kb_mc
  ob_txt t_c20
  ob_txt t_b2_digest
  ob_txt t_c21
  ob_txt t_mc_digest
  ob_b uchar 10
  ob_flush int 1
  ret int 0
end

fn main to int
  ac = argcnt
  cmd = new uchar 32 0
  if ge ac 2
    cl = tcd_read_arg 1 cmd 32
    if gt cl 0
      if eq ac 2
        if streq_txt cmd ulong cl t_cmd_consts
          ret cmd_consts
        end
      end
      if eq ac 6
        if streq_txt cmd ulong cl t_cmd_write
          ret cmd_write
        end
      end
    end
  end
  ob_clr
  ob_txt t_usage
  ob_flush int 2
  ret int 2
end

note tools/codebook/main.om -- the codebook command line. The functions it calls live in
note codebook.om, which tools/trit/build.sh also compiles into trit (OM-2 has no imports; both
note builds concatenate the same codebook.om bytes).
text tcext "ext"
text eeext "ERR notprefix"

fn argav to void
p = argread 1 av 0 len av
if lt p 1
exit 2
end
put avn 0 ulong p
end

fn aveq t view uchar * to bool
if ne get avn 0 len t
ret false
end
for i ulong len t bound BIG
if ne get av i get t i
ret false
end
end
ret true
end

fn main to int
c = argcnt
if lt c 2
ret 2
end
argav
if aveq tenc
rdin
doenc
wrall 1
ret 0
end
if aveq tdec
rdin
dodec
wrall 1
ret 0
end
if aveq tsha
if ne c 3
ret 2
end
ldcb 2
for i ulong 64
obyte get cs i
end
obyte 10
wrall 1
ret 0
end
if aveq tsign
if ne c 4
ret 2
end
ldcb 2
ldkey 3
rdin
dosign
zap
wrall 1
ret 0
end
if aveq tver
if and ne c 5 ne c 6
ret 2
end
ldcb 2
ldkey 3
q = argread 4 sd 0 len sd
if lt q 1
ret 2
end
put sdn 0 ulong q
put vln 0 110
if eq c 6
q2 = argread 5 av 0 len av
if ne q2 1
ret 2
end
if and ne get av 0 110 ne get av 0 101
ret 2
end
put vln 0 ulong get av 0
end
rdin
lk = lockst
dover
unlockst lk
zap
wrall 1
ret 0
end
if aveq tcext
if ne c 4
ret 2
end
ldcb 2
put msn 0 0
for i ulong get cbn 0 bound BIG
msbyte get cbk i
end
ldcb 3
m = get msn 0
if lt get cbn 0 m
otext eeext
obyte 10
wrall 1
ret 6
end
for j ulong m bound BIG
if ne get cbk j get ms j
otext eeext
obyte 10
wrall 1
ret 6
end
end
otext vok
obyte 32
for q ulong 64
obyte get cs q
end
obyte 10
wrall 1
ret 0
end
ret 2
end

  else
    ob_txt t_s392
  end
  ob_txt t_s393
  ob_g_man_sha
  ob_txt t_s394
  for i ulong get g_stat_l 0 bound 32
    ob_b get g_status i
  end
  ob_txt t_s395
  if eq get g_fat_l 0 0
    ob_txt t_none
  else
    for i ulong get g_fat_l 0 bound 40
      ob_b get g_fat i
    end
  end
  ob_txt t_s396
  if ne get g_dry 0 0
    ob_txt t_s397
  else
    ob_g_ds_com
  end
  ob_txt t_s398
  for i ulong 64

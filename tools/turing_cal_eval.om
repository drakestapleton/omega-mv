    has_dd = ne get g_h1 0 0
    ok = ne get g_ok1 0 0
  end
  ob_set_fd fd_cr
  if eq first_res 0
    ob_txt t_s117
  end
  ob_txt t_s118
  ob_u64 get g_f_g fi
  ob_txt t_s119
  ob_u64 get g_f_j fi
  ob_txt t_s120
  ob_g_c_name ci

fn ob_u64 v ulong to void
  if eq v 0
    ob_b uchar 48
    ret
  end
  dig = new uchar 24 0
  nd = ulong 0
  x = v
  while gt x 0 bound 24
    put dig nd uchar add 48 rem x 10
    x = div x 10
    nd = add nd 1
  end
  while gt nd 0 bound 24
    nd = sub nd 1
    ob_b get dig nd
  end
end

fn ob_u64_pad v ulong width ulong to void
  dig = new uchar 24 0
  x = v
  for i ulong width bound 24
    put dig sub sub width 1 i uchar add 48 rem x 10
    x = div x 10
  end
  for i ulong width bound 24
    ob_b get dig i
  end
end

fn ob_i64 v long to void
  if lt v 0
    ob_b uchar 45
    uv = add ulong sub long 0 add v 1 1
    ob_u64 uv
    ret
  end
  ob_u64 ulong v
end

fn ob_ub_bits ub long to void
  a = ulong 0
  if lt ub 0
    ob_b uchar 45
    a = add ulong sub long 0 add ub 1 1
  else
    a = ulong ub
  end
  ob_u64 div a 1000000
  ob_b uchar 46
  ob_u64_pad rem a 1000000 6
end

fn ob_hex64 v ulong to void
  for i ulong 16
    sh = mul sub 15 i 4
    ob_b get t_HEX and shr v sh 15
  end
end

fn ob_ratio is_neg ulong num ulong den ulong prec ulong sc ulong to void
  if ne is_neg 0
    ob_b uchar 45
  end
  if eq den 0
    ob_u64 1
    ob_b uchar 46
    ob_u64_pad 0 prec
    ret
  end
  q = div add mul num mul sc 2 den mul den 2
  ob_u64 div q sc
  ob_b uchar 46
  ob_u64_pad rem q sc prec
end

fn wr_fbuf fd int n ulong to bool
  p = ulong 0
  while lt p n bound 1000000
    w = write fd g_fbuf p sub n p
    if le w 0
      ret false
    end
    p = add p ulong w
  end
  ret true
end

fn wr_all fd int buf view uchar * n ulong to bool
  p = ulong 0
  while lt p n bound 1000000
    w = write fd buf p sub n p
    if le w 0
      ret false
    end
    p = add p ulong w
  end
  ret true
end

fn sl_eq a view uchar * al ulong b view uchar * to bool
  if ne al len b
    ret false
  end
  for i ulong al bound 8192
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn sa_set a view uchar * ao ulong al ulong to void
  cl = al
  if gt cl 4096
    cl = 4096
  end
  for i ulong cl bound 4096
    put g_sa i get a add ao i
  end
  put g_sal 0 cl
end

fn sa_eq b view uchar * bo ulong bl ulong to bool
  al = get g_sal 0
  if ne al bl
    ret false
  end
  for i ulong al bound 4096
    if ne get g_sa i get b add bo i
      ret false
    end
  end
  ret true
end

fn sa_cmp b view uchar * bo ulong bl ulong to long
  al = get g_sal 0
  mn = al
  if lt bl mn
    mn = bl
  end
  for i ulong mn bound 4096
    ca = get g_sa i
    cb = get b add bo i
    if lt ca cb
      ret -1
    end
    if gt ca cb
      ret 1
    end
  end
  if lt al bl
    ret -1
  end
  if gt al bl
    ret 1
  end
  ret 0
end


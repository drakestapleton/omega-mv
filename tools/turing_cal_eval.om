fn pj_make_g_p2 rl ulong dst edit uchar * to ulong
  dl = get g_pj_dl 0
  if gt add add dl 1 rl 4095
    ret 0
  end
  for i ulong dl bound 4096
    put dst i get g_pj_dir i
  end
  o = dl
  if and gt dl 0 ne get dst sub dl 1 uchar 47
    put dst o uchar 47
    o = add o 1
  end
  for i ulong rl bound 4096
    put dst add o i get g_p2 i
  end
  ret add o rl
end
fn pj_make_g_prof dst edit uchar * to ulong
  rl = get g_prof_l 0
  dl = get g_pj_dl 0

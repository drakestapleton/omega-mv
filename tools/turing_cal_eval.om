fn jtop_slurp key view uchar * dst edit uchar * dcap ulong to long
  tl = get g_slurp_len 0
  pos = jfind_slurp 0 tl key
  if lt pos 0
    ret -1
  end
  ls = ulong pos
  while gt ls 0 bound 8192
    if eq get g_slurp sub ls 1 uchar 10
      break
    end
    ls = sub ls 1
  end
  lend = ulong pos
  while lt lend tl bound 8192
    if eq get g_slurp lend uchar 10
      break
    end
    lend = add lend 1
  end
  tl = sub lend ls
  if ge tl 8192
    ret -1
  end
  ret jstr_slurp ls tl key dst
end

fn excl_open_out name view uchar * nl ulong to long
  ol = get g_out_l 0

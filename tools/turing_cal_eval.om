fn jparse_int_buf line view uchar * p ulong lim ulong to long
  while lt p lim bound 8192
    if ne get line p uchar 32
      break
    end
    p = add p 1
  end
  if ge p lim
    put g_ty_ret_i 0 1
    ret -1

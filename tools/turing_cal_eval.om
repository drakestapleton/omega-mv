fn jmatch_slurp pos ulong pat view uchar * plen ulong to bool
  for j ulong plen bound 136
    if ne get g_slurp add pos j get pat j
      ret false
    end
  end
  ret true
end

fn jfind_slurp loff ulong ll ulong key view uchar * to long
  p = len key
  pat = new uchar 136 0
  put pat 0 uchar 34
  for i ulong p bound 128
    put pat add 1 i get key i
  end
  put pat add 1 p uchar 34
  put pat add 2 p uchar 58
  p = add 3 p
  if lt ll p
    ret -1
  end
  lim = add sub ll p 1
  for i ulong lim bound 10000000
    if jmatch_slurp add loff i pat p
      ret long add i p
    end
  end
  ret -1
end

fn jskip_sp_slurp p ulong lim ulong to ulong
  while lt p lim bound 8192
    if ne get g_slurp p uchar 32
      break
    end
    p = add p 1
  end
  ret p
end

fn is_json_delim c uchar to bool
  if or eq c 44 eq c 125
    ret true
  end
  if or eq c 32 or eq c 10 eq c 13
    ret true
  end
  ret false
end

fn jstr_slurp loff ulong ll ulong key view uchar * dst edit uchar * to long
  p = jfind_slurp loff ll key
  if lt p 0
    ret -1
  end
  lim = add loff ll
  ll = jskip_sp_slurp add loff ulong p lim
  if ge ll lim
    ret -1
  end
  if ne get g_slurp ll uchar 34
    ret -1
  end
  ll = add ll 1
  n = ulong 0
  while lt ll lim bound 8192
    c = get g_slurp ll
    if or eq c 34 eq c 10
      break
    end
    if lt n len dst
      put dst n c
      n = add n 1
    end
    ll = add ll 1
  end
  if ge ll lim
    ret -1
  end
  if ne get g_slurp ll uchar 34
    ret -1
  end
  ret long n
end


fn pkt_u16_pkt o ulong v ulong to void
  put g_pkt o uchar and v 255
  put g_pkt add o 1 uchar and shr v 8 255
end
fn pkt_u16_epkt o ulong v ulong to void
  put g_epkt o uchar and v 255
  put g_epkt add o 1 uchar and shr v 8 255
end

  for i ulong cm bound 1024
    put g_fmsg i get msg i
  end
  put g_fmsgl 0 cm
end

fn write_final_fail_body crit view uchar * step view uchar * code view uchar * to void
  snm = new uchar 2 0
  ob_txt t_s10
  ob_g_exp
  ob_txt t_s11
  if ne get g_dry 0 0
    ob_txt t_true
  else
    ob_txt t_false
  end
  ob_txt t_s12
  ob_g_fts
  ob_txt t_s13
  for i ulong 9
    ci = add i 1
    if gt ci 1
      ob_txt t_s14
    end
    put snm 0 uchar 83
    put snm 1 uchar add 48 ci
    if sl_eq crit 2 snm
      write_crit_json ci t_fail
    else
      write_crit_json ci t_nr
    end
  end
  ob_txt t_s15
  ob_txt crit
  ob_txt t_s16
  ob_txt step
  ob_txt t_s17
  ob_txt code
  ob_txt t_s18
  ob_g_fmsg
  ob_txt t_s19
  ob_g_rprof
  ob_txt t_s20
  ob_g_rfreeze
  ob_txt t_s21
  ob_g_rman
  ob_txt t_s22
  if ne get g_dry 0 0
    ob_txt t_dry_not_ev
  else
    ob_txt t_fail
  end
  ob_txt t_s23
end

fn fail_final crit view uchar * step view uchar * code view uchar * to int
  ob_set_fd int 2
  ob_txt t_s24
  ob_txt step
  ob_txt t_s25
  ob_txt code
  ob_txt t_s25
  ob_g_fmsg
  ob_txt t_s26
  ob_txt crit
  ob_txt t_s27
  ign = ob_flush
  if eq get g_out_l 0 0
    ret 1
  end
  fd = excl_open_out t_f_final len t_f_final
  if lt fd 0
    ret 1
  end
  ul_t = utc_now_g
  put g_ftsl 0 ul_t
  for i_t ulong ul_t bound 32
    put g_fts i_t get g_ts_tmp i_t
  end
  jclean_g_fmsg uchar 39
  ob_set_fd int fd
  write_final_fail_body crit step code
  ign2 = ob_flush
  ic = fclose int fd
  ret 1
end


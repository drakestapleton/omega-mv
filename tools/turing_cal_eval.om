fn refuse_emit_void n ulong fd int step view uchar * code view uchar * to void
  ul_t = utc_now_g
  put g_ftsl 0 ul_t
  for i ulong ul_t bound 32
    put g_fts i get g_ts_tmp i
  end
  jclean_g_fmsg uchar 39
  ob_set_fd fd
  write_void_body n step code
  _ign = ob_flush
  _ign = fclose fd
  if and eq get g_dry 0 0 ge n MAX_ATTEMPTS
    fd2 = excl_open_out t_f_final len t_f_final
    if ge fd2 0
      ob_set_fd int fd2
      write_inconclusive_body n step code
      _ign = ob_flush
      _ign = fclose int fd2
      ob_set_fd int 2
      ob_txt t_s42
      ob_u64 n
      ob_txt t_s43
      ob_u64 MAX_ATTEMPTS
      ob_txt t_s44
      _ign = ob_flush
    end
  end
end

fn refuse_c crit view uchar * step view uchar * code view uchar * to int
  if ne get g_scored 0 0
    ret fail_final crit step code
  end
  ob_set_fd int 2
  ob_txt t_s41
  ob_txt step
  ob_txt t_s25
  ob_txt code
  ob_txt t_s25
  ob_g_fmsg
  ob_b uchar 10
  _ign = ob_flush
  if eq get g_out_l 0 0
    ret 2
  end
  nm = new uchar 64 0
  fd = long -1
  n = ulong 1
  while and lt n 1000 lt fd 0 bound 1000
    nml = fmt_void_name n nm
    fd = excl_open_out nm nml
    if and lt fd 0 ne fd -17
      break
    end
    n = add n 1
  end
  n = sub n 1
  if ge fd 0
    refuse_emit_void n int fd step code
  end
  ret 2
end

fn refuse_txt step view uchar * code view uchar * msg view uchar * to int
  set_fmsg msg len msg
  ret refuse_c t_none step code
end

fn s2_fail_txt step view uchar * code view uchar * msg view uchar * to int
  set_fmsg msg len msg
  if ne get g_dry 0 0
    ret refuse_c t_none step code
  end
  ret fail_final t_s45 step code
end

fn copy_txt_to s view uchar * dst edit uchar * to ulong
  l = len s
  for i ulong l bound 32
    put dst i get s i
  end
  ret l
end

fn tc_err_name rc int dst edit uchar * to ulong
  if eq rc TC_OK
    ret copy_txt_to t_s46 dst
  end
  if eq rc TC_E_ARG
    ret copy_txt_to t_err_arg dst
  end
  if eq rc TC_E_IO
    ret copy_txt_to t_err_io dst
  end
  if eq rc TC_E_FORMAT
    ret copy_txt_to t_err_format dst
  end
  if eq rc TC_E_DIGEST
    ret copy_txt_to t_err_digest dst
  end
  if eq rc TC_E_NORM
    ret copy_txt_to t_err_norm dst
  end
  if eq rc TC_E_ZERO
    ret copy_txt_to t_err_zero dst
  end
  if eq rc TC_E_PROFILE
    ret copy_txt_to t_err_profile dst
  end
  if eq rc TC_E_MODEL
    ret copy_txt_to t_err_model dst
  end
  if eq rc TC_E_DATASET
    ret copy_txt_to t_err_dataset dst
  end
  if eq rc TC_E_COUNT
    ret copy_txt_to t_err_count dst
  end
  if eq rc TC_E_HEADER
    ret copy_txt_to t_err_header dst
  end
  if eq rc TC_E_BINDING
    ret copy_txt_to t_err_binding dst
  end
  if eq rc TC_E_TRUNC
    ret copy_txt_to t_err_trunc dst
  end
  if eq rc TC_E_TRAIL
    ret copy_txt_to t_err_trail dst
  end
  if eq rc TC_E_CORRUPT
    ret copy_txt_to t_err_corrupt dst
  end
  if eq rc TC_E_SYMBOL
    ret copy_txt_to t_err_symbol dst
  end
  if eq rc TC_E_INDEX
    ret copy_txt_to t_err_index dst
  end
  ret copy_txt_to t_err_unk dst
end

fn set_why s view uchar * to void
  l = len s
  if gt l 1023
    l = 1023
  end
  for i ulong l bound 1024
    put g_why i get s i
  end
  put g_whylen 0 l
end

note ================================================================
note TY-1/TY-2 Math, CTR1 Reader, TYM0 Model Decoder
note ================================================================

fn ty_mul128 a ulong b ulong to void
  m = ulong 0xffffffff
  p0 = mul and a m and b m
  p1 = mul and a m shr b 32
  p2 = mul shr a 32 and b m
  mid = add add shr p0 32 and p1 m and p2 m
  put g_u128 1 or and p0 m shl and mid m 32
  hi = mul shr a 32 shr b 32
  hi = add add hi shr p1 32 shr p2 32
  put g_u128 0 add hi shr mid 32
end

fn ty_clz64 x ulong to ulong
  if eq x 0
    ret 64
  end
  n = ulong 0
  v = x
  if eq shr v 32 0
    n = add n 32
    v = shl v 32
  end
  if eq shr v 48 0
    n = add n 16
    v = shl v 16
  end
  if eq shr v 56 0
    n = add n 8
    v = shl v 8
  end
  if eq shr v 60 0
    n = add n 4
    v = shl v 4
  end
  if eq shr v 62 0
    n = add n 2
    v = shl v 2
  end
  if eq shr v 63 0
    n = add n 1
  end
  ret n
end

fn ty_log2_q32 x ulong to ulong
  if eq x 0
    ret 0
  end
  e = sub 63 ty_clz64 x
  m = ulong 0
  if le e 62
    m = shl x sub 62 e
  else
    m = shr x 1
  end
  frac = ulong 0
  two = shl ulong 1 63
  for i ulong 32
    ty_mul128 m m
    hi = get g_u128 0
    lo = get g_u128 1
    m = or shl hi 2 shr lo 62
    frac = shl frac 1
    if ge m two
      m = shr m 1
      frac = or frac 1
    end
  end
  ret or shl e 32 frac
end

fn ty_q32_to_ub v ulong to long
  ty_mul128 v ulong 1000000
  hi = get g_u128 0
  lo = get g_u128 1
  half = shl ulong 1 31
  lo2 = add lo half
  if lt lo2 lo
    hi = add hi 1
  end
  ret long or shl hi 32 shr lo2 32
end

fn ty_ub_tbl_init to void
  put g_ub_tbl 0 TY_E_RANGE
  top = shl TY_QBITS 32
  q = ulong 1
  while le q TY_QONE bound 65540
    v = sub top ty_log2_q32 q
    put g_ub_tbl q ty_q32_to_ub v
    q = add q 1
  end
  put g_ub_rdy 0 1
end

fn ty_ubits_q16 q ulong to long
  if or eq q 0 gt q TY_QONE
    ret TY_E_RANGE
  end
  if eq get g_ub_rdy 0 0
    ty_ub_tbl_init
  end
  ret get g_ub_tbl q
end

fn ev_pack sym ulong op ulong dep ulong first ulong crumb ulong idx ulong to ulong
  v = and sym 15
  v = or v shl and op 15 4
  v = or v shl and dep 7 8
  v = or v shl and first 1 11
  v = or v shl and crumb 65535 13
  v = or v shl and idx 0x7fffffff 29
  ret v
end

fn ev_sym e ulong to ulong
  ret and e 15
end

fn ev_op e ulong to ulong
  ret and shr e 4 15
end

fn ev_dep e ulong to ulong
  ret and shr e 8 7
end

fn ev_first e ulong to ulong
  ret and shr e 11 1
end

fn ev_idx e ulong to ulong
  ret and shr e 29 0x7fffffff
end

fn ev_crumb e ulong to ulong
  ret and shr e 13 65535
end

fn rd16_fb off ulong to ulong
  ret or ulong get g_fbuf off shl ulong get g_fbuf add off 1 8
end

fn rd32_fb off ulong to ulong
  b0 = ulong get g_fbuf off
  b1 = ulong get g_fbuf add off 1
  b2 = ulong get g_fbuf add off 2
  b3 = ulong get g_fbuf add off 3
  ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn ty_ctr1_chk_hdr off ulong to long
  b = ulong get g_fbuf off
  if ne b 67
    ret -1
  end
  b = ulong get g_fbuf add off 1
  if ne b 84
    ret -1
  end
  b = ulong get g_fbuf add off 2
  if ne b 82
    ret -1
  end
  b = ulong get g_fbuf add off 3
  if ne b 49
    ret -1
  end
  v = rd16_fb add off 4
  if ne v 1
    ret -1
  end
  b = ulong get g_fbuf add off 22
  if ne b 0
    ret -1
  end
  b = ulong get g_fbuf add off 24
  if gt b 4
    ret -1
  end
  b = ulong get g_fbuf add off 25
  if gt b 2
    ret -1
  end
  ret 0
end

fn ty_ctr1_map_sym kind ulong rc_v ulong op ulong prune ulong to long
  if eq kind 1
    if ge op TY_CTR1_NOPS
      ret -1
    end
    if gt prune 4
      ret -1
    end
    sym = ulong 0
    if ne prune 0
      if ne rc_v 1
        ret -1
      end
      sym = sub prune 1
    else
      if or lt rc_v 2 gt rc_v 4
        ret -1
      end
      sym = add 4 sub rc_v 2
    end
    ret long or sym shl op 4
  end
  if eq kind 2
    if ne prune 0
      ret -1
    end
    if or lt rc_v 5 gt rc_v 7
      ret -1
    end
    sym = ulong 8
    if eq rc_v 5
      sym = 7
    end
    ret long or sym shl TY_OP_SUBMIT 4
  end
  ret -1
end

fn ty_ctr1_dec_sym off ulong to long
  k = ulong get g_fbuf add off 6
  r = ulong get g_fbuf add off 7
  o = rd16_fb add off 20
  p = ulong get g_fbuf add off 23
  ret ty_ctr1_map_sym k r o p
end

fn ty_ctr1_pack_sp sp ulong dep ulong first ulong idx ulong to ulong
  sym = and sp 15
  out_op = shr sp 4
  ret ev_pack sym out_op dep first 0 idx
end

fn ty_ctr1_dec_fb off ulong prev long to long
  sp = ty_ctr1_chk_hdr off
  if lt sp 0
    ret TY_E_FORMAT
  end
  sp = ty_ctr1_dec_sym off
  if lt sp 0
    ret TY_E_FORMAT
  end
  dep = rd16_fb add off 29
  if gt dep TY_DEPTH_CLIP
    dep = TY_DEPTH_CLIP
  end
  idx = rd32_fb add off 8
  first = ulong 0
  if eq idx 0
    first = 1
  else
    if lt prev 0
      ret TY_E_FORMAT
    end
    if le long idx prev
      ret TY_E_FORMAT
    end
  end
  put g_ty_ret_u 0 ty_ctr1_pack_sp ulong sp dep first idx
  ret TY_OK
end

fn ty_ctr1_chunk fi ulong nrec ulong to long
  n = get g_cr_st 0
  prev = get g_cr_st 1
  crumb = ulong get g_cr_st 2
  for i ulong nrec bound 260
    rc = ty_ctr1_dec_fb mul i TY_CTR1_BYTES prev
    if ne rc TY_OK
      ret rc
    end
    ev = get g_ty_ret_u 0
    prev = long ev_idx ev
    if and ne ev_first ev 0 gt n 0
      crumb = add crumb 1
    end
    if gt crumb 65535
      ev = or ev shl ulong 65535 13
    else
      ev = or ev shl crumb 13
    end
    used = get g_ev_used 0
    if not ensure_ev add used 1
      ret TY_E_IO
    end
    put g_ev used ev
    put g_ev_used 0 add used 1
    n = add n 1
  end
  put g_f_ev_n fi add get g_f_ev_n fi nrec
  put g_cr_st 0 n
  put g_cr_st 1 prev
  put g_cr_st 2 long crumb
  ret TY_OK
end

fn fb_shift used ulong rem_b ulong to void
  for i ulong rem_b bound 247
    put g_fbuf i get g_fbuf add used i
  end
end

fn ty_ctr1_read fi ulong path view uchar * plen ulong to bool
  fd = fopen path 0 plen int 0 int 0
  if lt fd 0
    set_why t_s47
    ret false
  end
  put g_f_ev_off fi get g_ev_used 0
  put g_f_ev_n fi 0
  put g_cr_st 0 0
  put g_cr_st 1 -1
  put g_cr_st 2 0
  rem_b = ulong 0
  done = false
  while not done bound 10000000
    k = read int fd g_fbuf rem_b sub 64220 rem_b
    if lt k 0
      ign = fclose int fd
      set_why t_s48
      ret false
    end
    if eq k 0
      done = true
    else
      tot = add rem_b ulong k
      nrec = div tot TY_CTR1_BYTES
      crc = ty_ctr1_chunk fi nrec
      if ne crc TY_OK
        ign = fclose int fd
        set_why t_s49
        ret false
      end
      used = mul nrec TY_CTR1_BYTES
      rem_b = sub tot used
      fb_shift used rem_b
    end
  end
  ign = fclose int fd
  if ne rem_b 0
    set_why t_s50
    ret false
  end
  ret true
end

fn ty_key_space mask ulong k ulong to long
  if or gt mask 255 or lt k TY_KMIN gt k TY_KMAX
    ret TY_E_ARG
  end
  p = ulong 1
  bits = ulong 0
  lim = shl ulong 1 62
  if ne and mask 1 0
    p = mul p 16
  end
  if ne and mask 2 0
    p = mul p 8
  end
  kp1 = add k 1
  for sh ulong 3
    bit = shl ulong 1 add 2 sh
    if ne and mask bit 0
      if gt p div lim kp1
        ret TY_E_RANGE
      end
      p = mul p kp1
    end
  end
  if ne and mask 64 0
    if gt p div lim kp1
      ret TY_E_RANGE
    end
    p = mul p kp1
  end
  if ne and mask 128 0
    if gt p div lim kp1
      ret TY_E_RANGE
    end
    p = mul p kp1
  end
  if ne and mask 32 0
    pos_r = shl ulong 1 36
    if gt p div lim pos_r
      ret TY_E_RANGE
    end
    p = mul p pos_r
  end
  while lt shl ulong 1 bits p bound 64
    bits = add bits 1
  end
  put g_ty_ret_u 0 p
  put g_ty_ret_u 1 bits
  ret TY_OK
end

fn br_get n ulong to ulong
  if eq n 0
    ret 0
  end
  pos = get g_br_pos 0
  nb = get g_br_nbits 0
  if gt add pos n nb
    put g_br_err 0 1
    ret 0
  end
  v = ulong 0
  for i ulong n bound 64
    by = div pos 8
    bo = sub 7 rem pos 8
    bit = and shr ulong get g_mcode by bo 1
    v = or shl v 1 bit
    pos = add pos 1
  end
  put g_br_pos 0 pos
  ret v
end

fn br_get_row k ulong dq edit uint * to long
  s = ulong 0
  km1 = sub k 1
  for i ulong km1 bound 16
    v = br_get TY_QBITS
    if ne get g_br_err 0 0
      ret TY_E_FORMAT
    end
    if or eq v 0 gt v TY_QONE
      ret TY_E_FORMAT
    end
    put dq i uint v
    s = add s v
  end
  if ge s TY_QONE
    ret TY_E_FORMAT
  end
  last = sub TY_QONE s
  if or eq last 0 gt last TY_QONE
    ret TY_E_FORMAT
  end
  put dq km1 uint last
  ret TY_OK
end

fn ty_mdec_one i ulong rk ulong to long
  k = get g_md_k 0
  dq = new uint 16 0
  rc = br_get_row k dq
  if ne rc TY_OK
    ret rc
  end
  put g_md_rkey i rk
  bo = mul i 16
  for x ulong k bound 16
    put g_md_rq add bo x get dq x
  end
  ret TY_OK
end

fn ty_mdec_rows nr ulong space ulong to long
  k = get g_md_k 0
  kb = get g_md_kb 0
  dq = new uint 16 0
  rc = br_get_row k dq
  if ne rc TY_OK
    ret rc
  end
  for x ulong k bound 16
    put g_md_def x get dq x
  end
  prevk = ulong 0
  for i ulong nr bound 100000000
    rk = br_get kb
    if ne get g_br_err 0 0
      ret TY_E_FORMAT
    end
    if ge rk space
      ret TY_E_RANGE
    end
    if and gt i 0 le rk prevk
      ret TY_E_FORMAT
    end
    prevk = rk
    rc2 = ty_mdec_one i rk
    if ne rc2 TY_OK
      ret rc2
    end
  end
  put g_md_nr 0 nr
  rem_bits = sub get g_br_nbits 0 get g_br_pos 0
  if gt rem_bits 0
    if ne br_get rem_bits 0
      ret TY_E_FORMAT
    end
  end
  ret TY_OK
end

fn ty_model_digest nby ulong to void
  sh_init
  sh_slice t_dom_model 0 len t_dom_model
  sh_byte uchar 0
  for i ulong nby bound 1000000000
    sh_byte get g_mcode i
  end
  sh_final 119
  o = ulong 3808
  for i ulong 32
    put g_md_dig i get g_dig add o i
  end
end

fn tc_slurp_model path view uchar * plen ulong to int
  fd = fopen path 0 plen int 0 int 0
  if lt fd 0
    set_why t_s51
    ret TC_E_IO
  end
  tot = ulong 0
  while true bound 10000000
    if not ensure_mcode add tot 65536
      _ign = fclose int fd
      ret TC_E_IO
    end
    r = read int fd g_fbuf 0 65536
    if lt r 0
      _ign = fclose int fd
      ret TC_E_IO
    end
    if eq r 0
      break
    end
    for i ulong ulong r bound 65536
      put g_mcode add tot i get g_fbuf i
    end
    tot = add tot ulong r
  end
  _ign = fclose int fd
  put g_mclen 0 tot
  ret TC_OK
end

fn tc_load_model path view uchar * plen ulong to int
  rc = tc_slurp_model path plen
  if ne rc TC_OK
    ret rc
  end
  tot = get g_mclen 0
  put g_br_pos 0 0
  put g_br_nbits 0 mul tot 8
  put g_br_err 0 0
  if ne br_get 32 ulong 0x54594d30
    set_why t_s52
    ret TC_E_FORMAT
  end
  if ne get g_br_err 0 0
    set_why t_s53
    ret TC_E_FORMAT
  end
  ver = br_get 8
  k = br_get 8
  mask = br_get 8
  qb = br_get 8
  kb = br_get 8
  nr = br_get 32
  if ne get g_br_err 0 0
    set_why t_s53
    ret TC_E_FORMAT
  end
  if or ne ver 0 ne qb TY_QBITS
    set_why t_s54
    ret TC_E_FORMAT
  end
  if ne ty_key_space mask k TY_OK
    set_why t_s55
    ret TC_E_FORMAT
  end
  if ne kb get g_ty_ret_u 1
    set_why t_s56
    ret TC_E_FORMAT
  end
  rowb = mul sub k 1 TY_QBITS
  rowb = add add TY_MODEL_HEADER_BITS rowb mul nr add kb rowb
  if ne div add rowb 7 8 tot
    set_why t_s57
    ret TC_E_FORMAT
  end
  if not ensure_md add nr 1
    set_why t_s58
    ret TC_E_IO
  end
  put g_md_k 0 k
  put g_md_mask 0 mask
  put g_md_kb 0 kb
  put g_md_nr 0 0
  put g_mcbits 0 rowb
  if ne ty_mdec_rows nr get g_ty_ret_u 0 TY_OK
    set_why t_s59
    ret TC_E_FORMAT
  end
  ty_model_digest tot
  ret TC_OK
end

fn md_find_row key ulong to long
  nr = get g_md_nr 0
  if eq nr 0
    ret -1
  end
  lo = ulong 0
  hi = nr
  while lt lo hi bound 32
    mid = add lo shr sub hi lo 1
    if lt get g_md_rkey mid key
      lo = add mid 1
    else
      hi = mid
    end
  end
  if lt lo nr
    if eq get g_md_rkey lo key
      ret long lo
    end
  end
  ret -1
end

fn md_lookup_q key ulong sym ulong to ulong
  ri = md_find_row key
  if ge ri 0
    ret ulong get g_md_rq add mul ulong ri 16 sym
  end
  ret ulong get g_md_def sym
end

fn kw_init mask ulong k ulong to void
  put g_kw 0 mask
  put g_kw 1 k
  for i ulong 5
    put g_kw add 2 i k
  end
  put g_kw 7 0
end

fn kw_key_pos ev ulong to ulong
  idx = ev_idx ev
  if ge idx 1048576
    idx = 1048575
  end
  ret or shl ev_crumb ev 20 idx
end

fn kw_key ev ulong to ulong
  mask = get g_kw 0
  k = get g_kw 1
  if ne ev_first ev 0
    for i ulong 5
      put g_kw add 2 i k
    end
  end
  kp1 = add k 1
  key = ulong 0
  m = ulong 1
  if ne and mask 1 0
    key = add key mul ev_op ev m
    m = mul m 16
  end
  if ne and mask 2 0
    key = add key mul ev_dep ev m
    m = mul m 8
  end
  if ne and mask 4 0
    key = add key mul get g_kw 2 m
    m = mul m kp1
  end
  if ne and mask 8 0
    key = add key mul get g_kw 3 m
    m = mul m kp1
  end
  if ne and mask 16 0
    key = add key mul get g_kw 4 m
    m = mul m kp1
  end
  if ne and mask 64 0
    key = add key mul get g_kw 5 m
    m = mul m kp1
  end
  if ne and mask 128 0
    key = add key mul get g_kw 6 m
    m = mul m kp1
  end
  if ne and mask 32 0
    key = add key mul kw_key_pos ev m
  end
  ret key
end

fn kw_adv ev ulong to void
  put g_kw 6 get g_kw 5
  put g_kw 5 get g_kw 4
  put g_kw 4 get g_kw 3
  put g_kw 3 get g_kw 2
  put g_kw 2 ev_sym ev
end

note ================================================================
note TPS1, TSY1, TCR1 Range, TCA1 rANS (dynamic enlarge pools!)
note ================================================================

fn tc_pb_put_u16 o ulong v ulong to void
  put g_pb o uchar and v 255
  put g_pb add o 1 uchar and shr v 8 255
end

fn tc_pb_put_u32 o ulong v ulong to void
  for i ulong 4
    put g_pb add o i uchar and shr v mul i 8 255
  end
end

fn tc_pb_put_u64 o ulong v ulong to void
  for i ulong 8
    put g_pb add o i uchar and shr v mul i 8 255
  end
end

fn tc_pb_get_u16 o ulong to ulong
  ret or ulong get g_pb o shl ulong get g_pb add o 1 8
end

fn tc_pb_get_u32 o ulong to ulong
  v = ulong 0
  for i ulong 4
    v = or v shl ulong get g_pb add o i mul i 8
  end
  ret v
end

fn tc_pb_get_u64 o ulong to ulong
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get g_pb add o i mul i 8
  end
  ret v
end

fn tc_sb_put_u16 o ulong v ulong to void
  put g_sb o uchar and v 255
  put g_sb add o 1 uchar and shr v 8 255
end

fn tc_sb_put_u64 o ulong v ulong to void
  for i ulong 8
    put g_sb add o i uchar and shr v mul i 8 255
  end
end

fn tc_sb_get_u16 o ulong to ulong
  ret or ulong get g_sb o shl ulong get g_sb add o 1 8
end

fn tc_sb_get_u64 o ulong to ulong
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get g_sb add o i mul i 8
  end
  ret v
end

fn tc_cb_put_u64 o ulong v ulong to void
  for i ulong 8
    put g_cb add o i uchar and shr v mul i 8 255
  end
end

fn tc_cb_get_u64 o ulong to ulong
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get g_cb add o i mul i 8
  end
  ret v
end

fn tc_copy_row ri long qbase ulong k ulong to long
  rbase = ulong 0
  if ge ri 0
    rbase = mul ulong ri 16
  end
  for x ulong k bound 16
    qv = ulong get g_md_def x
    if ge ri 0
      qv = ulong get g_md_rq add rbase x
    end
    if or eq qv 0 ge qv TY_QONE
      set_why t_s61
      ret -106
    end
    put g_ps_q add qbase x ushort qv
  end
  ret TY_OK
end

fn tc_produce_one t ulong ev ulong crumb ulong to long
  k = get g_md_k 0
  sym = ev_sym ev
  if ge sym k
    set_why t_s60
    ret -116
  end
  kval = kw_key ev
  put g_ps_key t kval
  put g_ps_crumb t uint crumb
  ri = md_find_row kval
  qbase = mul t k
  if ne tc_copy_row ri qbase k TY_OK
    ret -106
  end
  put g_sy t uchar sym
  kw_adv ev
  ret ty_ubits_q16 ulong get g_ps_q add qbase sym
end

fn tc_ideal_ub_range lo ulong hi ulong to long
  k = get g_ps_k 0
  tot = long 0
  t = lo
  while lt t hi bound 100000000
    s = ulong get g_sy t
    if ge s k
      ret -1
    end
    qv = ulong get g_ps_q add mul t k s
    b = ty_ubits_q16 qv
    if lt b 0
      ret -1
    end
    tot = add tot b
    t = add t 1
  end
  ret tot
end

fn tc_produce fi ulong to int
  k = get g_md_k 0
  mask = get g_md_mask 0
  n = get g_f_ev_n fi
  ev_off = get g_f_ev_off fi
  if or lt k TY_KMIN gt k TY_KMAX
    ret TC_E_ARG
  end
  if not ensure_ps_n add n 1 k
    ret TC_E_IO
  end
  put g_ps_k 0 k
  put g_ps_n 0 n
  put g_sy_k 0 k
  put g_sy_n 0 n
  d_off = mul fi 32
  for i ulong 32
    put g_ps_prof i get g_prof_dig i
    put g_ps_mod i get g_md_dig i
    put g_ps_dat i get g_f_dd add d_off i
    put g_sy_dat i get g_f_dd add d_off i
  end
  kw_init mask k
  crumb = ulong 0
  want = long 0
  for t ulong n bound 100000000
    ev = get g_ev add ev_off t
    if and ne ev_first ev 0 gt t 0
      crumb = add crumb 1
    end
    sb = tc_produce_one t ev crumb
    if lt sb 0
      ret int sb
    end
    want = add want sb
  end
  id = tc_ideal_ub_range 0 n
  if ne id want
    set_why t_s62
    ret TC_E_FORMAT
  end
  ret TC_OK
end

fn tc_ps_check_row t ulong norm_sum ulong to int
  k = get g_ps_k 0
  base = mul t k
  s = ulong 0
  for x ulong k bound 16
    v = ulong get g_ps_q add base x
    if eq v 0
      set_why t_s63
      ret TC_E_ZERO
    end
    s = add s v
  end
  if or ne s TY_QONE ne norm_sum TY_QONE
    set_why t_s64
    ret TC_E_NORM
  end
  ret TC_OK
end

fn tc_ps_ser_rec t ulong off ulong k ulong to void
  tc_pb_put_u64 off t
  tc_pb_put_u64 add off 8 get g_ps_key t
  tc_pb_put_u32 add off 16 ulong get g_ps_crumb t
  tc_pb_put_u32 add off 20 TY_QONE
  qbase = mul t k
  for x ulong k bound 16
    tc_pb_put_u16 add off add 24 mul 2 x ulong get g_ps_q add qbase x
  end
end

fn tc_ps_serialize to int
  k = get g_ps_k 0
  n = get g_ps_n 0
  rb = add TC_PS_REC_FIXED mul 2 k
  body = add TC_PS_HEADER mul n rb
  if not ensure_pb add body TC_DIGEST
    ret TC_E_IO
  end
  for i ulong 128
    put g_pb i 0
  end
  put g_pb 0 84
  put g_pb 1 80
  put g_pb 2 83
  put g_pb 3 49
  tc_pb_put_u16 4 1
  put g_pb 6 uchar k
  put g_pb 7 16
  tc_pb_put_u32 8 0
  tc_pb_put_u64 12 n
  tc_pb_put_u32 20 rb
  tc_pb_put_u32 24 0
  for i ulong 32
    put g_pb add 28 i get g_ps_prof i
    put g_pb add 60 i get g_ps_mod i
    put g_pb add 92 i get g_ps_dat i
  end
  off = TC_PS_HEADER
  for t ulong n bound 100000000
    tc_ps_ser_rec t off k
    off = add off rb
  end
  sh_init
  sh_slice t_dom_ps 0 len t_dom_ps
  sh_byte 0
  for i ulong body bound 1000000000
    sh_byte get g_pb i
  end
  sh_final 118
  o = ulong 3776
  for i ulong 32
    bv = get g_dig add o i
    put g_pb add body i bv
    put g_ps_dig i bv
  end
  put g_pb_len 0 add body TC_DIGEST
  ret TC_OK
end

fn tc_sy_serialize use_dsy ulong to int
  k = get g_sy_k 0
  n = get g_sy_n 0
  if ne use_dsy 0
    k = get g_dsy_k 0
    n = get g_dsy_n 0
  end
  body = add TC_SY_HEADER n
  if not ensure_sb add body TC_DIGEST
    ret TC_E_IO
  end
  for i ulong 56
    put g_sb i 0
  end
  put g_sb 0 84
  put g_sb 1 83
  put g_sb 2 89
  put g_sb 3 49
  tc_sb_put_u16 4 1
  put g_sb 6 uchar k
  tc_sb_put_u64 8 n
  for i ulong 32
    b = get g_sy_dat i
    if ne use_dsy 0
      b = get g_dsy_dat i
    end
    put g_sb add 24 i b
  end
  for t ulong n bound 100000000
    sv = get g_sy t
    if ne use_dsy 0
      sv = get g_dsy t
    end
    if ge ulong sv k
      ret TC_E_SYMBOL
    end
    put g_sb add TC_SY_HEADER t sv
  end
  sh_init
  sh_slice t_dom_sy 0 len t_dom_sy
  sh_byte 0
  for i ulong body bound 1000000000
    sh_byte get g_sb i
  end
  sh_final 117
  o = ulong 3744
  for i ulong 32
    bv = get g_dig add o i
    put g_sb add body i bv
    if eq use_dsy 0
      put g_sy_dig i bv
    else
      put g_dsy_dig i bv
    end
  end
  put g_sb_len 0 add body TC_DIGEST
  ret TC_OK
end

fn write_pb_file path view uchar * plen ulong to bool
  fd = fopen path 0 plen int 577 420
  if lt fd 0
    ret false
  end
  n = get g_pb_len 0
  pos = ulong 0
  while lt pos n bound 10000000
    chk = sub n pos
    if gt chk 65536
      chk = 65536
    end
    for i ulong chk bound 65536
      put g_fbuf i get g_pb add pos i
    end
    if not wr_fbuf int fd chk
      ign = fclose int fd
      ret false
    end
    pos = add pos chk
  end
  ret eq fclose int fd 0
end


  neg_f = false
  if eq get line p uchar 45
    neg_f = true
    p = add p 1
  end
  if ge p lim
    put g_ty_ret_i 0 1
    ret -1
  end
  v = ulong 0
  nd = ulong 0
  while lt p lim bound 32
    c = get line p
    if or lt c 48 gt c 57
      break
    end
    v = add mul v 10 ulong sub c 48
    nd = add nd 1
    p = add p 1
  end
  if eq nd 0
    put g_ty_ret_i 0 1
    ret -1
  end
  if lt p lim
    if not is_json_delim get line p
      put g_ty_ret_i 0 1
      ret -1

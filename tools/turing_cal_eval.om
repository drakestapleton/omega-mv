text t_s350 "baseline"
text t_s351 "wins (S6 PASS rule)"
text t_s352 "loses (S6 FAIL rule)"
text t_s353 "straddles 0 (S6 INCONCLUSIVE rule)"
text t_s354 "loses (S7 PASS rule)"

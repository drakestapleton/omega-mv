  ob_txt t_s343
  if ne get g_dry 0 0
    ob_txt t_s344
  end
  ob_txt t_s345
  ok = eq ob_flush 0
  ic = fclose int fd
  ret and ok eq ic 0
end

fn report_cand_flags tid0 ulong to ulong
  lop = ulong 1
  hin = ulong 2
  anylo = ulong 0
  anyhi = ulong 0
  for x ulong 3
    if le get g_tv_lo add tid0 x 0
      lop = 0
    end
    if ge get g_tv_hi add tid0 x 0
      hin = 0
    end
    if gt get g_tv_lo add tid0 x 0
      anylo = 4
    end
    if lt get g_tv_hi add tid0 x 0
      anyhi = 8
    end
  end
  ret or or lop hin or anylo anyhi
end

fn write_report_cand g ulong ci ulong b2 ulong mi long m1 long m2 long to void
  gc = add mul g 64 ci
  tid0 = add mul g 192 mul ci 3
  fl = report_cand_flags tid0
  ob_txt t_s346
  ob_g_c_name ci
  ob_txt t_s347
  ob_i64 get g_c_lm ci
  ob_txt t_s347
  ob_ub_bits get g_ideal gc
  ob_txt t_s347
  ob_i64 get g_coded0 gc
  ob_txt t_s347
  ob_i64 get g_coded1 gc
  ob_txt t_s347
  ob_ub_bits get g_tv_pt tid0
  ob_txt t_s347
  ob_ub_bits get g_tv_pt add tid0 1
  ob_txt t_s347
  ob_ub_bits get g_tv_pt add tid0 2
  ob_txt t_s348
  ob_ub_bits get g_tv_lo tid0
  ob_txt t_s14
  ob_ub_bits get g_tv_hi tid0
  ob_txt t_s349
  if eq ci b2
    ob_txt t_s350
  else
    if eq long ci mi
      if ne and fl 1 0
        ob_txt t_s351
      else
        if ne and fl 8 0
          ob_txt t_s352
        else
          ob_txt t_s353
        end
      end
    else
      if or eq long ci m1 eq long ci m2
        if ne and fl 2 0
          ob_txt t_s354
        else
          if ne and fl 4 0
            ob_txt t_s355
          else
            ob_txt t_s356
          end
        end
      else
        if ne and fl 1 0
          ob_txt t_s357
        else
          if ne and fl 2 0
            ob_txt t_s358
          else
            ob_txt t_s359
          end
        end
      end
    end
  end
  ob_txt t_s360
end

fn write_report_env_row g ulong ci ulong to void
  out0 = ulong 0
  out1 = ulong 0
  wm0 = I64_MAX
  wm1 = I64_MAX
  for fi ulong get g_nf 0 bound 64
    if eq get g_f_g fi g
      ridx = add mul ci MAXF fi
      out0 = add out0 get g_r_efail0 ridx
      out0 = add out0 get g_r_ecfail0 ridx
      out1 = add out1 get g_r_efail1 ridx
      out1 = add out1 get g_r_ecfail1 ridx
      if lt get g_r_wcm0 ridx wm0
        wm0 = get g_r_wcm0 ridx
      end
      if lt get g_r_wcm1 ridx wm1
        wm1 = get g_r_wcm1 ridx
      end
    end
  end
  ridx = add mul g 64 ci
  ob_txt t_s377
  ob_g_c_name ci
  ob_txt t_s378
  ob_ub_bits sub mul get g_coded0 ridx UB get g_ideal ridx
  ob_txt t_s379
  ob_ub_bits sub mul get g_coded1 ridx UB get g_ideal ridx
  ob_txt t_s380
  ob_u64 out0
  ob_txt t_s381
  ob_u64 out1
  ob_txt t_s382
  ob_ub_bits wm0
  ob_txt t_s381
  ob_ub_bits wm1
  ob_txt t_s383
end

fn write_report_group g ulong b2 ulong to void
  mi = cand_index_txt t_mcand
  m1 = cand_index_txt t_mmem
  m2 = cand_index_txt t_mmem1
  ob_txt t_s371
  ob_u64 g
  if eq g 1
    ob_txt t_s372
  else
    ob_txt t_s373
  end
  for fi ulong get g_nf 0 bound 64
    if eq get g_f_g fi g
      ob_b uchar 32
      ob_i64 get g_f_seed fi
    end
  end
  ob_txt t_s14
  ob_u64 get g_pool_n g
  ob_txt t_s374
  ob_i64 get g_events g
  ob_txt t_s375
  for ci ulong get g_nc 0 bound 64
    write_report_cand g ci b2 mi m1 m2
  end
  ob_txt t_s376
  for ci ulong get g_nc 0 bound 64
    write_report_env_row g ci
  end
  ob_txt t_s384
  s0 = mul g 2
  ob_ratio get g_rho_neg s0 get g_rho_num s0 get g_rho_den s0 4 10000
  ob_txt t_s385
  s0 = add s0 1
  ob_ratio get g_rho_neg s0 get g_rho_num s0 get g_rho_den s0 4 10000
  ob_txt t_s386
end

fn write_pending_report b2 ulong to bool
  fd = open_out_rel t_f_rpend
  if lt fd 0
    ret false
  end
  ob_set_fd int fd
  ob_txt t_s361
  if ne get g_dry 0 0

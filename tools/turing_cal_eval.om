fn cmd_run_in_ds_verify to int
  dp = new uchar 64 0
  if ne jtop_slurp t_k_pdig dp 64 64
    ret refuse_txt t_s83 t_s421 t_s442
  end
  sa_set dp 0 64
  if not sa_eq_g_prof_sha
    ret refuse_txt t_s83 t_s421 t_s442
  end
  if and ne get g_dry 0 0 not sl_eq_g_ds_split t_dev_split
    ret refuse_txt t_s83 t_s443 t_s444
  end
  if and eq get g_dry 0 0 not sl_eq_g_ds_split t_sealed_split
    ret refuse_txt t_s83 t_s443 t_s445
  end
  if ne jtop_slurp t_k_pay dp 64 64
    ret refuse_txt t_s83 t_s86 t_s446
  end
  for i ulong 64
    put g_ds_pay i get dp i
  end
  rc = parse_dataset_files
  if ne rc 0
    ret rc
  end
  rc = check_freeze_order
  if ne rc 0
    ret rc
  end
  if and gt get g_fat_l 0 0 gt get g_ds_rel_l 0 0
    if and ge get g_ds_rel 0 48 le get g_ds_rel 0 57
      sa_set_fat
      if ge sa_cmp_g_ds_rel 0
        ret s2_fail_txt t_s99 t_s112 t_s447
      end
    end
  end
  if eq get g_dry 0 0
    if eq get g_ds_rel_l 0 0
      ret refuse_txt t_s99 t_s112 t_s113
    end
    if or lt get g_ds_rel 0 48 gt get g_ds_rel 0 57
      ret refuse_txt t_s99 t_s112 t_s113
    end
  end
  ret 0
end

fn cmd_run_in_traces to int
  nf = get g_nf 0
  fh = new uchar 64 0
  fp = new uchar 4096 0
  for fi ulong nf bound 64
    fpl = get g_f_plen fi
    for j ulong fpl bound 4096
      put fp j get g_f_path add mul fi 4096 j
    end
    if not sha_file_hex fp fpl fh 101
      ret refuse_txt t_s83 t_s86 t_s448
    end
    sa_set fh 0 64
    if not sa_eq_g_f_sha fi
      ret refuse_txt t_s83 t_s86 t_s449
    end
    if ne file_stat_size fp fpl get g_f_bytes fi
      ret refuse_txt t_s83 t_s86 t_s450
    end
    for j ulong 64
      put g_hex_tmp j get fh j
    end
    dg_unhex_f_dd fi
    if not ty_ctr1_read fi fp fpl
      ret refuse_txt t_s83 t_s76 t_s451
    end
  end
  ret 0
end

fn cmd_run_inputs to int
  rc = cmd_run_in_prof_man
  if ne rc 0
    ret rc
  end
  rc = cmd_run_in_man_meta
  if ne rc 0
    ret rc
  end
  rc = cmd_run_in_cands
  if ne rc 0
    ret rc
  end
  rc = cmd_run_in_cand_files
  if ne rc 0
    ret rc
  end
  rc = cmd_run_in_ds_meta
  if ne rc 0
    ret rc
  end
  rc = cmd_run_in_ds_verify
  if ne rc 0
    ret rc
  end
  ret cmd_run_in_traces
end

fn mk_out_dir_one s view uchar * wd edit uchar * to bool
  pj_set_g_out
  ret mkdir_p wd pj_make s len s wd
end

fn mk_work_dir_one s view uchar * wd edit uchar * to bool
  pj_set_g_work
  ret mkdir_p wd pj_make s len s wd
end

fn cmd_run_mk_dirs to int
  wd = new uchar 4096 0
  if or not mk_out_dir_one t_sub_ps wd not mk_out_dir_one t_sub_ar wd
    ret refuse_txt t_s168 t_s161 t_s452
  end
  if or not mk_out_dir_one t_sub_an wd not mk_out_dir_one t_sub_enc wd
    ret refuse_txt t_s168 t_s161 t_s452
  end
  if not mk_out_dir_one t_sub_dec wd
    ret refuse_txt t_s168 t_s161 t_s452
  end
  if or not mk_work_dir_one t_sub_ps wd not mk_work_dir_one t_sub_sym wd
    ret refuse_txt t_s453 t_s161 t_s454
  end
  if or not mk_work_dir_one t_sub_ar wd not mk_work_dir_one t_sub_an wd
    ret refuse_txt t_s453 t_s161 t_s454
  end
  ret 0
end

fn cmd_run_open_outs to int
  f0 = open_out_rel t_f_psidx
  f1 = open_out_rel t_f_encidx
  f2 = open_out_rel t_f_arres
  f3 = open_out_rel t_f_anres
  put g_fd_ps 0 int f0
  put g_fd_enc 0 int f1
  put g_fd_ar 0 int f2
  put g_fd_an 0 int f3
  if or lt f0 0 lt f1 0
    ret refuse_txt t_s168 t_s161 t_s455
  end
  if or lt f2 0 lt f3 0
    ret refuse_txt t_s168 t_s161 t_s455
  end
  ob_set_fd int f2
  ob_txt t_s456
  _ign = ob_flush
  ob_set_fd int f3
  ob_txt t_s457
  _ign = ob_flush
  ob_set_fd int f0
  ob_txt t_s458
  _ign = ob_flush
  ob_set_fd int f1
  ob_txt t_s459
  _ign = ob_flush
  ret 0
end

fn cmd_run_check_models to int
  nc = get g_nc 0
  cp = new uchar 4096 0
  mh = new uchar 64 0
  for ci ulong nc bound 64
    cpl = get g_c_plen ci
    for j ulong cpl bound 4096
      put cp j get g_c_path add mul ci 4096 j
    end
    if ne tc_load_model cp cpl TC_OK
      ret refuse_txt t_s438 t_err_format t_s460
    end
    for i ulong 32
      put g_dig i get g_md_dig i
    end
    dg_to_hex 0 mh 0
    sa_set mh 0 64
    if not sa_eq_g_c_mdig ci
      ret refuse_txt t_s438 t_s461 t_s462
    end
    if ne long get g_mcbits 0 get g_c_lm ci
      ret refuse_txt t_s438 t_s463 t_s464
    end
  end
  ret 0
end

fn cmd_run_eval_loop to int
  nc = get g_nc 0
  nf = get g_nf 0
  cp = new uchar 4096 0
  put g_scored 0 1
  first_res = ulong 1
  for ci ulong nc bound 64
    cpl = get g_c_plen ci
    for j ulong cpl bound 4096
      put cp j get g_c_path add mul ci 4096 j
    end
    if ne tc_load_model cp cpl TC_OK
      ret refuse_txt t_s438 t_err_format t_s460
    end
    ob_set_fd int 2
    ob_txt t_s465
    ob_g_c_name ci
    ob_txt t_s466
    ob_u64 get g_mcbits 0
    ob_txt t_s467
    _ign = ob_flush
    for fi ulong nf bound 64
      rc = eval_cand_file ci fi first_res
      if ne rc 0
        ret rc
      end
      first_res = 0
    end
  end
  ret 0
end

fn cmd_run_close_outs to void
  fd = get g_fd_ar 0
  ob_set_fd fd
  ob_txt t_s468
  _ign = ob_flush
  _ign = fclose fd
  fd = get g_fd_an 0
  ob_set_fd fd
  ob_txt t_s468
  _ign = ob_flush
  _ign = fclose fd
  _ign = fclose get g_fd_ps 0
  _ign = fclose get g_fd_enc 0
end

fn cmd_run_finish b2 ulong to int
  if not write_ideal_lengths
    ret refuse_txt t_s168 t_s161 t_f_ideal
  end
  if not write_scorer_primary
    ret refuse_txt t_s168 t_s161 t_f_sp
  end
  if not write_uncertainty b2
    ret refuse_txt t_s168 t_s161 t_f_unc
  end
  fd = open_out_rel t_f_pdig
  if lt fd 0
    ret refuse_txt t_s168 t_s161 t_f_pdig
  end
  ob_set_fd int fd
  ob_g_prof_sha
  ob_txt t_s469
  for i ulong get g_profid_l 0 bound 32
    ob_b get g_profid i
  end
  ob_txt t_s470
  _ign = ob_flush
  _ign = fclose int fd
  hx = new uchar 64 0
  set_rline 0 t_f_psidx
  if not root_of_out 1 hx 100
    ret refuse_txt t_s168 t_s161 t_s471
  end
  for i ulong 64
    put g_prob_root i get hx i
  end
  set_rline 0 t_f_arres
  set_rline 1 t_f_anres
  set_rline 2 t_f_encidx
  if not root_of_out 3 hx 100
    ret refuse_txt t_s168 t_s161 t_s471
  end
  for i ulong 64
    put g_code_root i get hx i
  end
  b2 = utc_now_g
  put g_t1_l 0 b2
  for i ulong b2 bound 32
    put g_t1 i get g_ts_tmp i
  end
  ret 0
end

fn cmd_run_pend b2 ulong to int
  pj = new uchar 4096 0
  ob_set_fd int -1
  for i ulong get g_repo_l 0 bound 4096
    ob_b get g_repo i
  end
  ob_b uchar 47
  for i ulong get g_expdir_l 0 bound 64
    ob_b get g_expdir i
  end
  ob_txt t_rel_prereg
  pjl = get g_olen 0
  for i ulong pjl bound 4096
    put pj i get g_obuf i
  end
  put g_olen 0 0
  prj = new uchar 64 0
  has_prj = sha_file_hex pj pjl prj 99
  if and not has_prj eq get g_dry 0 0
    ret refuse_txt t_s472 t_s161 t_s473
  end
  if not write_pending_receipt prj has_prj
    ret refuse_txt t_s168 t_s161 t_s474
  end
  if not write_pending_report b2
    ret refuse_txt t_s168 t_s161 t_s475
  end
  ob_set_fd int 2
  ob_txt t_s476
  for i ulong 8
    pjl = add i 1
    if eq pjl 8
      pjl = 9
    end
    if gt i 0
      ob_b uchar 32
    end
    ob_b uchar 83
    ob_u64 pjl
    ob_b uchar 32
    ob_g_crit pjl
  end
  ob_txt t_s477
  _ign = ob_flush
  ret 0
end

fn cmd_run_prep ac ulong to int
  rc = parse_run_args ac
  if ne rc 0
    ret rc
  end
  put g_ov_l 0 get g_ov_pl 0
  for i ulong get g_ov_pl 0 bound 4096
    put g_ov i get g_ov_p i
  end
  record_cmd_and_inputs ac
  outl = get g_out_l 0
  put g_out_pl 0 outl
  for i ulong outl bound 4096
    put g_out_p i get g_out i
  end
  put g_out_l 0 0
  if or eq get g_repo_l 0 0 or eq get g_man_pl 0 0 eq get g_ds_pl 0 0
    ret refuse_txt t_s90 t_s91 t_s478
  end
  if or eq outl 0 or eq get g_work_l 0 0 eq get g_ncd 0 0
    ret refuse_txt t_s90 t_s91 t_s478
  end
  if and gt get g_only_l 0 0 eq get g_dry 0 0
    ret refuse_txt t_s90 t_s91 t_s479
  end
  rc = cmd_run_precheck
  if ne rc 0
    ret rc
  end
  put g_out_l 0 get g_out_pl 0
  for i ulong get g_out_pl 0 bound 4096
    put g_out i get g_out_p i
  end
  rc = cmd_run_retry_check
  if ne rc 0
    ret rc
  end
  notebook_of
  if and eq get g_dry 0 0 ne get g_nb_dirty 0 0
    if lt get g_nb_dirty 0 0
      ret refuse_txt t_s480 t_s481 t_s482
    end
    ret refuse_txt t_s480 t_s481 t_s483
  end
  outl = utc_now_g
  put g_t0_l 0 outl
  for i ulong outl bound 32
    put g_t0 i get g_ts_tmp i
  end
  ret cmd_run_inputs
end

fn cmd_run_check_s4 to void
  put g_s4 0 1
  for ci ulong get g_nc 0 bound 64
    for fi ulong get g_nf 0 bound 64
      r = add mul ci MAXF fi
      if ne get g_r_efail0 r 0
        put g_s4 0 0
      end
      if ne get g_r_efail1 r 0
        put g_s4 0 0
      end
      if ne get g_r_ecfail0 r 0
        put g_s4 0 0
      end
      if ne get g_r_ecfail1 r 0
        put g_s4 0 0
      end
    end
  end
end

fn cmd_run ac ulong to int
  rc = cmd_run_prep ac
  if ne rc 0
    ret rc
  end
  rc = cmd_run_mk_dirs
  if ne rc 0
    ret rc
  end
  rc = cmd_run_open_outs
  if ne rc 0
    ret rc
  end
  put g_s1 0 1
  put g_s3 0 1
  for i ulong get g_nf 0 bound 64
    put g_tsy_set i 0
  end
  rc = cmd_run_check_models
  if ne rc 0
    ret rc
  end
  rc = cmd_run_eval_loop
  if ne rc 0
    ret rc
  end
  cmd_run_close_outs
  b2 = ulong cand_index_txt t_b2
  if ne run_bootstrap_group 1 b2 0
    ret 1
  end
  if ne run_bootstrap_group 2 b2 0
    ret 1
  end
  cmd_run_check_s4
  audit_s5_reversals b2
  compute_criteria
  rc = cmd_run_finish b2
  if ne rc 0
    ret rc
  end
  ret cmd_run_pend b2
end

fn load_kv_push which ulong k view uchar * kl ulong v long to bool
  if eq which 0
    n = get g_kva_n 0
    if not ensure_kva add n 1
      ret false
    end
    ko = mul n 160
    for i ulong kl bound 160
      put g_kva_key add ko i get k i
    end
    if lt kl 160
      put g_kva_key add ko kl 0
    end
    put g_kva_val n v
    put g_kva_n 0 add n 1
  else
    n = get g_kvb_n 0
    if not ensure_kvb add n 1
      ret false
    end
    ko = mul n 160
    for i ulong kl bound 160
      put g_kvb_key add ko i get k i
    end
    if lt kl 160
      put g_kvb_key add ko kl 0
    end
    put g_kvb_val n v
    put g_kvb_n 0 add n 1
  end
  ret true
end

fn load_kv_slurp which ulong to bool
  if eq which 0
    put g_kva_n 0 0
  else
    put g_kvb_n 0 0
  end
  tl = get g_slurp_len 0
  k = new uchar 160 0
  pos = ulong 0
  while lt pos tl bound 1000000
    ls = pos
    while lt pos tl bound 8192
      if eq get g_slurp pos uchar 10
        break
      end
      pos = add pos 1
    end
    ll = sub pos ls
    if lt pos tl
      pos = add pos 1
    end
    kl = jstr_slurp ls ll t_k_key k
    v = jint_slurp ls ll t_k_val
    if and ge kl 0 eq get g_ty_ret_i 0 0
      if not load_kv_push which k ulong kl v
        ret false
      end
    end
  end
  ret true
end

fn kv_cstr_len buf view uchar * o ulong to ulong
  l = ulong 0
  while lt l 160 bound 160
    if eq get buf add o l 0
      break
    end
    l = add l 1
  end
  ret l
end

fn crit_of_rep ci ulong to bool
  pat = new uchar 7 0
  put pat 0 uchar 34
  put pat 1 uchar 83
  put pat 2 uchar add 48 ci
  put pat 3 uchar 34
  put pat 4 uchar 58
  put pat 5 uchar 32
  put pat 6 uchar 34
  tl = get g_rep_len 0
  cp = sl_find_rep 0 tl t_pat_crit
  if lt cp 0
    ret false
  end
  p = sl_find_rep ulong cp sub tl ulong cp pat
  if lt p 0
    ret false
  end
  q = add add ulong cp ulong p 7
  co = mul ci 16
  l = ulong 0
  while and lt q tl lt l 15 bound 16
    ch = get g_rep q
    if eq ch uchar 34
      break
    end
    put g_crit add co l ch
    l = add l 1
    q = add q 1
  end
  put g_crit_l ci l
  ret true
end

fn rep2_append_slurp p ulong n ulong to bool
  ol = get g_rep2_len 0
  if not ensure_rep2 add ol n
    ret false
  end
  for i ulong n bound 10000000
    b = get g_slurp add p i
    put g_rep2 add ol i b
  end
  put g_rep2_len 0 add ol n
  ret true
end

fn rep2_append_buf s view uchar * n ulong to bool
  ol = get g_rep2_len 0
  if not ensure_rep2 add ol n
    ret false
  end
  for i ulong n bound 4096
    put g_rep2 add ol i get s i
  end
  put g_rep2_len 0 add ol n
  ret true
end

fn replace_all_into_rep from view uchar * to_s view uchar * tol ulong to bool
  sl = get g_slurp_len 0
  fl = len from
  put g_rep2_len 0 0
  p = ulong 0
  while lt p sl bound 10000000
    f = sl_find_slurp p sub sl p from
    if lt f 0
      if not rep2_append_slurp p sub sl p
        ret false
      end
      break
    end
    if not rep2_append_slurp p ulong f
      ret false
    end
    if not rep2_append_buf to_s tol
      ret false
    end
    p = add add p ulong f fl
  end
  nl = get g_rep2_len 0
  if not ensure_slurp add nl 1
    ret false
  end
  for i ulong nl bound 10000000
    b = get g_rep2 i
    put g_slurp i b
  end
  put g_slurp_len 0 nl
  ret true
end

fn check_gate_key k view uchar * to bool
  va = new uchar 128 0
  vb = new uchar 128 0
  p = new uchar 4096 0
  pj_set_g_bpath
  pl = pj_make t_f_sp len t_f_sp p
  if not slurp_file p pl
    ret false
  end
  la = jtop_slurp k va 128
  pl = get g_gate_f 1
  for i ulong pl bound 4096
    put p i get g_ipath i
  end
  if not slurp_file p pl
    ret false
  end
  lb = jtop_slurp k vb 128
  if or lt la 0 lt lb 0
    ret false
  end
  sa_set va 0 ulong la
  ret sa_eq vb 0 ulong lb
end

fn check_gate_headers to bool
  if not check_gate_key t_k_schema
    ret false
  end
  if not check_gate_key t_k_psha
    ret false
  end
  if not check_gate_key t_k_cman_sha
    ret false
  end
  ret check_gate_key t_k_dman_sha
end

fn write_excl_slurp path view uchar * pl ulong to int
  fd = fopen path 0 pl int 193 420
  if lt fd 0
    ret -1
  end
  n = get g_slurp_len 0
  pos = ulong 0
  while lt pos n bound 10000000
    chk = sub n pos
    if gt chk 65536
      chk = 65536
    end
    for i ulong chk bound 65536
      put g_fbuf i get g_slurp add pos i
    end
    if not wr_fbuf int fd chk
      ign = fclose int fd
      ret -1
    end
    pos = add pos chk
  end
  if ne fclose int fd 0
    ret -1
  end
  ret 0
end

fn pj_set_g_bpath to void
  tmp = new uchar 4096 0
  n = get g_gate_f 0
  for i ulong n bound 4096
    put tmp i get g_bpath i
  end
  pj_set tmp n
end

fn cmd_gate_parse ac ulong to int
  bl = ulong 0
  il = ulong 0
  buf = new uchar 4096 0
  i = ulong 2
  while lt i ac bound 1024
    if arg_is i t_f_dry
      put g_dry 0 1
      i = add i 1
    else
      if and arg_is i t_f_bundle lt add i 1 ac
        bl = copy_arg_to add i 1 buf 4096
        for j ulong bl bound 4096
          put g_bpath j get buf j
        end
        i = add i 2
      else
        if and arg_is i t_f_indep lt add i 1 ac
          il = copy_arg_to add i 1 buf 4096
          for j ulong il bound 4096
            put g_ipath j get buf j
          end
          i = add i 2
        else
          ret refuse_txt t_s90 t_s91 t_s94
        end
      end
    end
  end
  if or eq bl 0 eq il 0
    ret refuse_txt t_s90 t_s91 t_s484
  end
  put g_gate_f 0 bl
  put g_gate_f 1 il
  put g_out_l 0 bl
  for j ulong bl bound 4096
    put g_out j get g_bpath j
  end
  ret 0
end

fn cmd_gate_check_pend to int
  fp = new uchar 4096 0
  pj_set_g_bpath
  rl = pj_make t_f_final len t_f_final fp
  if file_exists fp rl
    ret refuse_txt t_s414 t_s415 t_s416
  end
  rl = pj_make t_f_fpend len t_f_fpend fp
  for i ulong rl bound 4096
    put g_prec_p i get fp i
  end
  if not slurp_file fp rl
    ret refuse_txt t_cmd_gate t_s161 t_s485
  end
  repl = pj_make t_f_rpend len t_f_rpend fp
  for i ulong repl bound 4096
    put g_prep_p i get fp i
  end
  if not file_exists fp repl
    ret refuse_txt t_cmd_gate t_s161 t_s485
  end
  put g_gate_f 2 rl
  put g_gate_f 3 repl
  if ne sl_has_slurp 0 get g_slurp_len 0 t_pat_kind_dry ne get g_dry 0 0
    ret refuse_txt t_cmd_gate t_s486 t_s487
  end
  ret 0
end

fn cmd_gate_check_digests to int
  fc = new uchar 48 0
  l1 = jtop_slurp_g t_k_sha
  if eq l1 64
    for i ulong 64
      put g_rprof i get g_jtmp i
    end
  end
  l2 = jtop_slurp_g t_k_cman_sha
  if eq l2 64
    for i ulong 64
      put g_rman i get g_jtmp i
    end
  end
  l3 = jtop_slurp t_k_commit fc 48
  if or ne l1 64 or ne l2 64 lt l3 0
    ret refuse_txt t_cmd_gate t_s76 t_s488
  end
  if ne get g_dry 0 0
    for j ulong len t_dry_run bound 48
      put g_rfreeze j get t_dry_run j
    end
    put g_rfreeze_l 0 len t_dry_run
  else
    for j ulong ulong l3 bound 48
      put g_rfreeze j get fc j
    end
    put g_rfreeze_l 0 ulong l3
  end
  ret 0
end

fn cmd_gate_load_indep to int
  pj_set_g_bpath
  prim = new uchar 4096 0
  priml = pj_make t_f_sp len t_f_sp prim
  ph = new uchar 64 0
  if not sha_file_hex prim priml ph 98
    ret refuse_txt t_cmd_gate t_s161 t_f_sp
  end
  sa_set ph 0 64
  indep = new uchar 4096 0
  il = get g_gate_f 1
  for i ulong il bound 4096
    put indep i get g_ipath i
  end
  indep_ok = sha_file_hex indep il ph 97
  self_cmp = and indep_ok sa_eq ph 0 64
  if and self_cmp eq get g_dry 0 0
    ret refuse_txt t_s489 t_s490 t_s491
  end
  put g_scored 0 1
  if not indep_ok
    set_fmsg t_s492 len t_s492
    ret refuse_c t_s489 t_s489_b t_s493
  end
  if or not slurp_file prim priml not load_kv_slurp 0
    ret refuse_txt t_cmd_gate t_s161 t_s494
  end
  if or not slurp_file indep il not load_kv_slurp 1
    set_fmsg t_s495 46
    ret refuse_c t_s489 t_s489_b t_s496
  end
  put g_gate_f 4 0
  if self_cmp
    put g_gate_f 4 1
  end
  ret 0
end

fn s8_count_kvb_dups j ulong nb ulong to ulong
  mism = ulong 0
  k = add j 1
  while lt k nb bound 100000
    sa_set_kvb mul j 160 kvb_cstr_len mul j 160
    if sa_eq_g_kvb mul k 160 kvb_cstr_len mul k 160
      mism = add mism 1
    end
    k = add k 1
  end
  ret mism
end

fn s8_check_kva_match j ulong nb ulong to ulong
  for k ulong nb bound 100000
    sa_set_kva mul j 160 kva_cstr_len mul j 160
    if sa_eq_g_kvb mul k 160 kvb_cstr_len mul k 160
      if ne get g_kva_val j get g_kvb_val k
        ret 1
      end
      ret 0
    end
  end
  ret 1
end

fn cmd_gate_s8_cmp to void
  na = get g_kva_n 0
  nb = get g_kvb_n 0
  mism = ulong 0
  indep = new uchar 4096 0
  il = get g_gate_f 1
  for i ulong il bound 4096
    put indep i get g_ipath i
  end
  if eq get g_gate_f 4 0
    if not slurp_file indep il
      mism = add mism 1
    else
      if not sl_has_slurp 0 get g_slurp_len 0 t_s497
        mism = add mism 1
      end
    end
  end
  if not check_gate_headers
    mism = add mism 1
  end
  for j ulong nb bound 100000
    mism = add mism s8_count_kvb_dups j nb
  end
  for j ulong na bound 100000
    mism = add mism s8_check_kva_match j nb
  end
  put g_gate_f 5 0
  if and and gt na 0 eq na nb eq mism 0
    put g_gate_f 5 1
  end
  put g_gate_f 6 na
  put g_gate_f 7 mism
end

fn cmd_gate_prep_crits to int
  tmp = new uchar 4096 0
  rl = get g_gate_f 2
  for i ulong rl bound 4096
    put tmp i get g_prec_p i
  end
  if not slurp_file tmp rl
    ret refuse_txt t_cmd_gate t_s161 t_s474
  end
  rl0 = get g_slurp_len 0
  if not ensure_rep rl0
    ret refuse_txt t_cmd_gate t_s161 t_s498
  end
  for j ulong rl0 bound 10000000
    put g_rep j get g_slurp j
  end
  put g_rep_len 0 rl0
  for j ulong 9
    ci = add j 1
    if ne ci 8
      if not crit_of_rep ci
        ret refuse_txt t_cmd_gate t_s76 t_s499
      end
    end
  end
  if ne get g_gate_f 5 0
    set_crit 8 t_pass
  else
    set_crit 8 t_fail
  end
  ret 0
end

fn cmd_gate_verdict to ulong
  has_f = false
  has_i = false
  for j ulong 9
    ci = add j 1
    sa_set_crit ci
    if sa_eq t_fail 0 len t_fail
      has_f = true
    else
      if sa_eq t_inc 0 len t_inc
        has_i = true
      else
        if not sa_eq t_pass 0 len t_pass
          if not and ne get g_dry 0 0 eq ci 2
            has_f = true
          end
        end
      end
    end
  end
  if has_f
    ret 1
  end
  if has_i
    ret 2
  end
  ret 0
end

fn cmd_gate_copy_and_root to int
  ind_copy = new uchar 4096 0
  pj_set_g_bpath
  ind_cl = pj_make t_f_si len t_f_si ind_copy
  indep = new uchar 4096 0
  il = get g_gate_f 1
  for i ulong il bound 4096
    put indep i get g_ipath i
  end
  sa_set indep 0 il
  if not sa_eq ind_copy 0 ind_cl
    if not copy_file_via_slurp indep il ind_copy ind_cl
      ret refuse_txt t_cmd_gate t_s161 t_s500
    end
  end
  set_rline 0 t_f_ideal
  set_rline 1 t_f_sp
  set_rline 2 t_f_si
  set_rline 3 t_f_unc
  ar = new uchar 64 0
  if not root_of_out 4 ar 96
    ret refuse_txt t_cmd_gate t_s161 t_s501
  end
  for i ulong 64
    put g_aroot i get ar i
  end
  ret 0
end

fn cmd_gate_slurp_pend is_rep bool to bool
  tmp = new uchar 4096 0
  n = get g_gate_f 2
  if is_rep
    n = get g_gate_f 3
    for i ulong n bound 4096
      put tmp i get g_prep_p i
    end
  else
    for i ulong n bound 4096
      put tmp i get g_prec_p i
    end
  end
  ret slurp_file tmp n
end

fn cmd_gate_fill_strs vcode ulong to void
  tmp = new uchar 32 0
  vl = copy_txt_to t_pass tmp
  if eq vcode 1
    vl = copy_txt_to t_fail tmp
  end
  if eq vcode 2
    vl = copy_txt_to t_inc tmp
  end
  put g_gate_f 8 vl
  for i ulong vl bound 32
    put g_vbuf i get tmp i
  end
  if ne get g_dry 0 0
    vl = copy_txt_to t_dry_not_ev tmp
    put g_gate_f 9 vl
    for i ulong vl bound 32
      put g_bbuf i get tmp i
    end
  else
    put g_gate_f 9 vl
    for i ulong vl bound 32
      put g_bbuf i get g_vbuf i
    end
  end
  if ne get g_gate_f 5 0
    vl = copy_txt_to t_pass tmp
  else
    vl = copy_txt_to t_fail tmp
  end
  put g_gate_f 10 vl
  for i ulong vl bound 16
    put g_sbuf i get tmp i
  end
end

fn cmd_gate_build_notes notes edit uchar * to ulong
  ob_set_fd int -1
  if ne get g_dry 0 0
    ob_txt t_s502
  end
  if ne get g_gate_f 4 0
    ob_txt t_s503
  else
    ob_txt t_s504
  end
  ob_txt t_s505
  ob_u64 get g_gate_f 6
  ob_txt t_s506
  ob_u64 get g_gate_f 7
  ob_txt t_s507
  nl = get g_olen 0
  for j ulong nl bound 512
    put notes j get g_obuf j
  end
  put g_olen 0 0
  ret nl
end

fn cmd_gate_repl_gbufs to void
  tmp = new uchar 32 0
  n = get g_gate_f 9
  for i ulong n bound 32
    put tmp i get g_bbuf i
  end
  igb = replace_all_into_rep t_ph_bridge tmp n
  n = get g_gate_f 10
  for i ulong n bound 16
    put tmp i get g_sbuf i
  end
  igb = replace_all_into_rep t_ph_s8 tmp n
end

fn cmd_gate_write_rep notes view uchar * nl ulong to int
  if not cmd_gate_slurp_pend true
    ret refuse_txt t_cmd_gate t_s161 t_s475
  end
  vline = new uchar 768 0
  ob_set_fd int -1
  ob_slice notes 0 nl
  ob_txt t_s509
  for i ulong get g_gate_f 8 bound 32
    ob_b get g_vbuf i
  end
  ob_b uchar 46
  vl = get g_olen 0
  for j ulong vl bound 768
    put vline j get g_obuf j
  end
  put g_olen 0 0
  cmd_gate_repl_gbufs
  igb = replace_all_into_rep t_ph_notes vline vl
  pj_set_g_bpath
  rep_out = new uchar 4096 0
  if not write_file_slurp rep_out pj_make t_f_rep len t_f_rep rep_out get g_slurp_len 0
    ret refuse_txt t_cmd_gate t_s161 t_f_rep
  end
  _ign = unlink g_prec_p 0 get g_gate_f 2
  _ign = unlink g_prep_p 0 get g_gate_f 3
  ob_set_fd int 1
  ob_txt t_s510
  for i ulong get g_gate_f 9 bound 32
    ob_b get g_bbuf i
  end
  ob_txt t_s511
  for i ulong get g_gate_f 8 bound 32
    ob_b get g_vbuf i
  end
  ob_txt t_s512
  for j ulong 9
    ob_txt t_s513
    ob_u64 add j 1
    ob_b uchar 32
    ob_g_crit add j 1
  end
  ob_txt t_s514
  _ign = ob_flush
  ret 0
end

fn cmd_gate_emit vcode ulong to int
  notes = new uchar 512 0
  nl = cmd_gate_build_notes notes
  cmd_gate_fill_strs vcode
  if not cmd_gate_slurp_pend false
    ret refuse_txt t_cmd_gate t_s161 t_s474
  end
  created = new uchar 32 0
  vcode = utc_now_buf created
  ar = new uchar 64 0
  for j ulong 64
    put ar j get g_aroot j
  end
  cmd_gate_repl_gbufs
  tmp = new uchar 32 0
  for j ulong get g_gate_f 8 bound 32
    put tmp j get g_vbuf j
  end
  igb = replace_all_into_rep t_ph_verdict tmp get g_gate_f 8
  igb = replace_all_into_rep t_ph_aroot ar 64
  igb = replace_all_into_rep t_ph_created created vcode
  igb = replace_all_into_rep t_ph_notes notes nl
  pj_set_g_bpath
  rep_out = new uchar 4096 0
  if lt write_excl_slurp rep_out pj_make t_f_final len t_f_final rep_out 0
    ret refuse_txt t_s414 t_s415 t_s508
  end
  ret cmd_gate_write_rep notes nl
end

fn cmd_gate ac ulong to int
  rc = cmd_gate_parse ac
  if ne rc 0
    ret rc
  end
  rc = cmd_gate_check_pend
  if ne rc 0
    ret rc
  end
  rc = cmd_gate_check_digests
  if ne rc 0
    ret rc
  end
  rc = cmd_gate_load_indep
  if ne rc 0
    ret rc
  end
  cmd_gate_s8_cmp
  rc = cmd_gate_prep_crits
  if ne rc 0
    ret rc
  end
  rc = cmd_gate_copy_and_root
  if ne rc 0
    ret rc
  end
  ret cmd_gate_emit cmd_gate_verdict
end

fn main to int
  if not exp_select
    ret 2
  end
  ac = load_args
  rc = long -1
  if ge ac 2
    if arg_is 1 t_cmd_run
      rc = long cmd_run ac
    else
      if arg_is 1 t_cmd_gate
        rc = long cmd_gate ac
      end
    end
  end
  if ge rc 0
    ret int rc
  end
  ign = write 2 t_usage 0 len t_usage
  ret 2
end

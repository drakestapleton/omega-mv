  end
  for i ulong rl bound 128
    put dst add o i get g_prof i
  end
  ret add o rl
end
fn pj_make_g_side dst edit uchar * to ulong
  rl = get g_side_l 0
  dl = get g_pj_dl 0
  if gt add add dl 1 rl 4095
    ret 0
  end
  for i ulong dl bound 4096
    put dst i get g_pj_dir i

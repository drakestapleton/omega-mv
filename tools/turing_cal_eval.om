    put g_path i get g_out_p i
  end
  put g_plen 0 l
end
fn set_gp_g_work l ulong to void
  for i ulong l bound 4096
    put g_path i get g_work i
  end
  put g_plen 0 l
end
fn set_gp_g_ov_s l ulong to void
  for i ulong l bound 4096
    put g_path i get g_ov i
  end
  put g_plen 0 l
end

fn sha_file_hex path view uchar * plen ulong dst edit uchar * slot ulong to bool
  if eq plen 0
    ret false
  end
  fd = fopen path 0 plen int 0 int 0
  if lt fd 0
    ret false
  end
  sh_init
  tot = ulong 0
  done = false
  while not done bound 10000000
    k = read int fd g_fbuf 0 65536
    if lt k 0
      ign = fclose int fd
      ret false
    end
    if eq k 0
      done = true
    else
      ku = ulong k
      tot = add tot ku
      sh_fbuf ku
    end
  end
  ign = fclose int fd
  sh_final slot
  dg_to_hex slot dst 0
  put g_ty_ret_u 0 tot
  ret true
end


      ret false
    end
    put g_ps_q_cap 0 nq
  end
  sycap = get g_sy_cap 0
  if gt need sycap
    ns = ulong 4096
    if gt sycap 0
      ns = sycap
    end
    while lt ns need bound 64
      ns = mul ns 2

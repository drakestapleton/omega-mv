note ================================================================
note Low-level output & string helpers
note ================================================================

fn ob_set_fd fd int to void
  put g_obfd 0 fd
  put g_olen 0 0
end

fn ob_flush to long
  n = get g_olen 0
  fd = get g_obfd 0
  if eq n 0
    ret 0
  end
  p = ulong 0
  while lt p n bound 100000
    w = write fd g_obuf p sub n p
    if le w 0
      put g_olen 0 0
      ret -1
    end
    p = add p ulong w
  end
  put g_olen 0 0
  ret 0
end

fn ob_b c uchar to void
  n = get g_olen 0
  if ge n 65000
    ign = ob_flush
    n = get g_olen 0
  end
  put g_obuf n c
  put g_olen 0 add n 1
end


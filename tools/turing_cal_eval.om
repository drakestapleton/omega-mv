fn read_pb_file path view uchar * plen ulong to bool
  fd = fopen path 0 plen int 0 int 0
  if lt fd 0
    ret false
  end
  tot = ulong 0
  while true bound 10000000
    if not ensure_pb add tot 65536
      _ign = fclose int fd
      ret false
    end
    k = read int fd g_fbuf 0 65536
    if lt k 0
      _ign = fclose int fd
      ret false
    end
    if eq k 0
      break
    end
    for i ulong ulong k bound 65536
      put g_pb add tot i get g_fbuf i
    end
    tot = add tot ulong k
  end
  _ign = fclose int fd
  put g_pb_len 0 tot
  ret true
end


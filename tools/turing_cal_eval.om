fn pj_make_g_expdir dst edit uchar * to ulong
  rl = get g_expdir_l 0
  dl = get g_pj_dl 0
  if gt add add dl 1 rl 4095
    ret 0
  end
  for i ulong dl bound 4096
    put dst i get g_pj_dir i
  end
  o = dl
  if and gt dl 0 ne get dst sub dl 1 uchar 47
    put dst o uchar 47
    o = add o 1
  end
  for i ulong rl bound 64
    put dst add o i get g_expdir i
  end
  ret add o rl
end
fn slurp_gp to bool
  plen = get g_plen 0
  if eq plen 0
    ret false
  end
  fd = fopen g_path 0 plen int 0 int 0
  if lt fd 0
    ret false
  end
  if not ensure_slurp 65536
    ign = fclose int fd
    ret false
  end
  tot = ulong 0
  done = false
  while not done bound 10000000
    need = add tot 65536
    if not ensure_slurp need
      ign = fclose int fd
      ret false
    end
    k = read int fd g_fbuf 0 65536
    if lt k 0
      ign = fclose int fd
      ret false
    end
    if eq k 0
      done = true
    else
      ku = ulong k
      cp_fbuf_to_slurp tot ku
      tot = add tot ku
    end
  end
  ign = fclose int fd
  put g_slurp_len 0 tot
  ret true
end
fn mkdir_p_gp to bool
  plen = get g_plen 0
  if eq plen 0
    ret false
  end
  tmp = new uchar 4096 0
  for i ulong plen bound 4096
    put tmp i get g_path i
  end
  ret mkdir_p tmp plen
end
fn om_realpath_gp dst edit uchar * to ulong
  plen = get g_plen 0
  if eq plen 0
    ret 0
  end
  tmp = new uchar 4096 0
  for i ulong plen bound 4096
    put tmp i get g_path i
  end
  ret om_realpath tmp plen dst
end

fn pj_set d view uchar * dl ulong to void
  cl = dl
  if gt cl 4095
    cl = 4095
  end
  for i ulong cl bound 4096
    put g_pj_dir i get d i
  end
  put g_pj_dl 0 cl
end

fn pj_make r view uchar * rl ulong dst edit uchar * to ulong
  dl = get g_pj_dl 0
  if gt add add dl 1 rl 4095
    ret 0
  end
  for i ulong dl bound 4096
    put dst i get g_pj_dir i
  end
  o = dl
  if and gt dl 0 ne get dst sub dl 1 uchar 47
    put dst o uchar 47
    o = add o 1
  end
  for i ulong rl bound 4096
    put dst add o i get r i
  end
  ret add o rl
end

fn mkdir_p path view uchar * plen ulong to bool
  if eq plen 0
    ret false
  end
  tmp = new uchar 4096 0
  for i ulong plen bound 4096
    put tmp i get path i
  end
  i = ulong 1
  while lt i plen bound 4096
    if eq get tmp i uchar 47
      rc = makedir tmp 0 i 493
      if and lt rc 0 ne rc -17
        ret false
      end
    end
    i = add i 1
  end
  rc2 = makedir tmp 0 plen 493
  if and lt rc2 0 ne rc2 -17
    ret false
  end
  ret true
end

fn file_exists path view uchar * plen ulong to bool
  if eq plen 0
    ret false
  end
  sb = new uchar 128 0
  ret eq stat path 0 plen sb 0 128 0
end

fn file_stat_size path view uchar * plen ulong to long
  if eq plen 0
    ret -1
  end
  sb = new uchar 128 0
  if ne stat path 0 plen sb 0 128 0
    ret -1
  end
  sz = ulong 0
  for i ulong 8
    b = ulong get sb add 48 i
    sz = or sz shl b mul i 8
  end
  ret long sz
end

fn cp_fbuf_to_slurp tot ulong ku ulong to void
  for i ulong ku bound 65536
    b = get g_fbuf i
    put g_slurp add tot i b
  end
end

fn cp_slurp_to_fbuf pos ulong chunk ulong to void
  for i ulong chunk bound 65536
    b = get g_slurp add pos i
    put g_fbuf i b
  end
end

fn slurp_file path view uchar * plen ulong to bool
  if eq plen 0
    ret false
  end
  fd = fopen path 0 plen int 0 int 0
  if lt fd 0
    ret false
  end
  if not ensure_slurp 65536
    ign = fclose int fd
    ret false
  end
  tot = ulong 0
  done = false
  while not done bound 10000000
    need = add tot 65536
    if not ensure_slurp need
      ign = fclose int fd
      ret false
    end
    k = read int fd g_fbuf 0 65536
    if lt k 0
      ign = fclose int fd
      ret false
    end
    if eq k 0
      done = true
    else
      ku = ulong k
      cp_fbuf_to_slurp tot ku
      tot = add tot ku
    end
  end
  ign = fclose int fd
  put g_slurp_len 0 tot
  ret true
end

fn write_file_slurp path view uchar * plen ulong n ulong to bool
  if eq plen 0
    ret false
  end
  fd = fopen path 0 plen int 577 420
  if lt fd 0
    ret false
  end
  pos = ulong 0
  while lt pos n bound 10000000
    chunk = sub n pos
    if gt chunk 65536
      chunk = 65536
    end
    cp_slurp_to_fbuf pos chunk
    if not wr_fbuf int fd chunk
      ign = fclose int fd
      ret false
    end
    pos = add pos chunk
  end
  ret eq fclose int fd 0
end

fn write_file_bytes path view uchar * plen ulong buf view uchar * n ulong to bool
  if eq plen 0
    ret false
  end
  fd = fopen path 0 plen int 577 420
  if lt fd 0
    ret false
  end
  ok = wr_all int fd buf n
  c = fclose int fd
  ret and ok eq c 0
end

fn copy_file_via_slurp src view uchar * sl ulong dst view uchar * dl ulong to bool
  if not slurp_file src sl
    ret false
  end
  ret write_file_slurp dst dl get g_slurp_len 0
end

fn om_find_last_slash path view uchar * plen ulong to long
  last_sl = long -1
  for i ulong plen bound 4096
    if eq get path i uchar 47
      last_sl = long i
    end
  end
  ret last_sl
end

fn om_realpath_parent path view uchar * plen ulong last_sl ulong dst edit uchar * to ulong
  db = new uchar 4096 0
  dl = last_sl
  if eq dl 0
    put db 0 uchar 47
    dl = 1
  else
    for i ulong dl bound 4096
      c = get path i
      put db i c
    end
  end
  if ne chdir db 0 dl 0
    ret 0
  end
  nl = cwd dst 0 4096
  if le nl 1
    ret 0
  end
  ret sub ulong nl 1
end

fn om_append_base path view uchar * bo ulong bl ulong dst edit uchar * to ulong
  dn = get g_rp_l 0
  if eq bl 0
    ret dn
  end
  cb = get path bo
  if eq cb uchar 46
    ret dn
  end
  if gt dn 0
    cd = get dst sub dn 1
    if ne cd uchar 47
      put dst dn uchar 47
      dn = add dn 1
    end
  end
  for i ulong bl bound 4096
    c = get path add bo i
    put dst add dn i c
  end
  ret add dn bl
end

fn om_realpath path view uchar * plen ulong dst edit uchar * to ulong
  sv = new uchar 4096 0
  if eq plen 0
    ret 0
  end
  sl = cwd sv 0 4096
  if le sl 1
    ret 0
  end
  svn = sub ulong sl 1
  if eq chdir path 0 plen 0
    nl = cwd dst 0 4096
    ign = chdir sv 0 svn
    if le nl 1
      ret 0
    end
    ret sub ulong nl 1
  end
  last_sl = om_find_last_slash path plen
  bo = ulong 0
  bl = plen
  dn = ulong 0
  if ge last_sl 0
    dn = om_realpath_parent path plen ulong last_sl dst
    bo = add ulong last_sl 1
    bl = sub plen bo
  else
    for j_d ulong svn bound 4096
      c_d = get sv j_d
      put dst j_d c_d
    end
    dn = svn
  end
  ign = chdir sv 0 svn
  if eq dn 0
    ret 0
  end
  put g_rp_l 0 dn
  ret om_append_base path bo bl dst
end

fn utc_now_g to ulong
  tmp = new uchar 32 0
  l = utc_now_buf tmp
  for i ulong l bound 32
    put g_ts_tmp i get tmp i
  end
  ret l
end

fn fmt_utc y ulong m ulong d ulong sec_of_day ulong to void
  hh = div sec_of_day 3600
  mm = div rem sec_of_day 3600 60
  ss = rem sec_of_day 60
  put g_obfd 0 -1
  put g_olen 0 0
  ob_u64_pad y 4
  ob_b uchar 45
  ob_u64_pad m 2
  ob_b uchar 45
  ob_u64_pad d 2
  ob_b uchar 84
  ob_u64_pad hh 2
  ob_b uchar 58
  ob_u64_pad mm 2
  ob_b uchar 58
  ob_u64_pad ss 2
  ob_b uchar 90
end

fn utc_fmt_from_sec t long to void
  sec = rem t 86400
  t = div t 86400
  t = add t 719468
  era = div t 146097
  doe = mul era 146097
  doe = sub t doe
  d1 = div doe 146096
  d1 = add doe d1
  t = div doe 1460
  d1 = sub d1 t
  t = div doe 36524
  d1 = sub d1 t
  yoe = div d1 365
  y = mul era 400
  y = add yoe y
  era = mul 365 yoe
  t = div yoe 4
  era = add era t
  t = div yoe 100
  era = sub era t
  doe = sub doe era
  t = mul 5 doe
  t = add t 2
  yoe = div t 153
  t = mul 153 yoe
  t = add t 2
  t = div t 5
  doe = sub doe t
  doe = add doe 1
  d1 = sub yoe 9
  if lt yoe 10
    d1 = add yoe 3
  end
  if le d1 2
    y = add y 1
  end
  fmt_utc ulong y ulong d1 ulong doe ulong sec
end

fn utc_now_buf dst edit uchar * to ulong
  ns = realns
  t = long 0
  if gt ns 0
    t = div ns 1000000000
  end
  utc_fmt_from_sec t
  l = get g_olen 0
  for i ulong l bound 32
    put dst i get g_obuf i
  end
  put g_olen 0 0
  ret l
end

fn parse_dec_n s view uchar * off ulong n ulong to long
  v = long 0
  for i ulong n bound 20
    c = get s add off i
    if or lt c 48 gt c 57
      ret -1
    end
    v = add mul v 10 long sub c 48
  end
  ret v
end

fn utc_epoch s view uchar * sl ulong to long
  if ne sl 20
    ret -1
  end
  if or ne get s 4 uchar 45 ne get s 7 uchar 45
    ret -1
  end
  if or ne get s 10 uchar 84 ne get s 13 uchar 58
    ret -1
  end
  if or ne get s 16 uchar 58 ne get s 19 uchar 90
    ret -1
  end
  y = parse_dec_n s 0 4
  mo = parse_dec_n s 5 2
  d = parse_dec_n s 8 2
  h = parse_dec_n s 11 2
  mi = parse_dec_n s 14 2
  se = parse_dec_n s 17 2
  if or lt y 0 or lt mo 1 gt mo 12
    ret -1
  end
  if le mo 2
    y = sub y 1
  end
  era = div y 400
  if lt y 0
    era = div sub y 399 400
  end
  y = sub y mul era 400
  t = long 9
  if gt mo 2
    t = long -3
  end
  mo = add mo t
  t = add mul 153 mo 2
  t = div t 5
  d = sub add t d 1
  t = mul y 365
  mo = div y 4
  t = add t mo
  mo = div y 100
  t = sub t mo
  d = add t d
  t = mul era 146097
  d = add t d
  d = sub d 719468
  t = mul h 3600
  mo = mul mi 60
  t = add t mo
  t = add t se
  ret add mul d 86400 t
end

fn pkt_u16 buf edit uchar * o ulong v ulong to void
  put buf o uchar and v 255
  put buf add o 1 uchar and shr v 8 255
end

fn pkt_init cnt ulong to ulong
  pkt_u16_pkt 0 cnt
  ret 2
end

fn pkt_push pos ulong s view uchar * off ulong n ulong to ulong
  pkt_u16_pkt pos n
  o = add pos 2
  for i ulong n bound 4096
    put g_pkt add o i get s add off i
  end
  ret add o n
end

fn epkt_push_def pos ulong to ulong
  ln = len t_def_path
  pkt_u16_epkt pos ln
  pos = add pos 2
  for j ulong ln bound 256
    put g_epkt add pos j get t_def_path j
  end
  ret add pos ln
end

fn build_env_pkt to ulong
  ec = envcnt
  if le ec 0
    pkt_u16_epkt 0 1
    ret epkt_push_def 2
  end
  n = ulong ec
  if gt n 64
    n = 64
  end
  tmp = new uchar 4096 0
  cnt = ulong 0
  pos = ulong 2
  has_path = false
  for i ulong n bound 64
    ec = envread i tmp 0 4096
    if gt ec 0
      if lt add add pos 2 ulong ec 4096
        pkt_u16_epkt pos ulong ec
        pos = add pos 2
        for j ulong ulong ec bound 4096
          put g_epkt add pos j get tmp j
        end
        pos = add pos ulong ec
        cnt = add cnt 1
        if ge ec 5
          sa_set tmp 0 5
          if sa_eq t_path_eq 0 5
            has_path = true
          end
        end
      end
    end
  end
  if or eq cnt 0 not has_path
    n = len t_def_path
    if and lt cnt 64 lt add add pos 2 n 4096
      pos = epkt_push_def pos
      cnt = add cnt 1
    end
  end
  pkt_u16_epkt 0 cnt
  ret pos
end

fn rd_u32_le buf view uchar * o ulong to ulong
  b0 = ulong get buf o
  b1 = ulong get buf add o 1
  b2 = ulong get buf add o 2
  b3 = ulong get buf add o 3
  ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn wait_child_exit pid int to long
  stbuf = new uchar 4 0
  wp = waitpid pid stbuf 0 4 0
  if lt wp 0
    ret -1
  end
  st = rd_u32_le stbuf 0
  if ne and st 127 0
    ret -1
  end
  ret long and shr st 8 255
end

fn spawn_pkt_pipe pktlen ulong to int
  elen = build_env_pkt
  fds = new uchar 8 0
  if ne pipefds fds 0 8 0 0
    ret int -1
  end
  prd = int rd_u32_le fds 0
  pwr = int rd_u32_le fds 4
  pid = fork
  if lt pid 0
    _ign = fclose prd
    _ign = fclose pwr
    ret int -1
  end
  if eq pid 0
    _ign = dupfd pwr int 1 0
    _ign = fclose prd
    _ign = fclose pwr
    nul = fopen t_devnull 0 len t_devnull int 1 int 0
    if ge nul 0
      _ign = dupfd int nul int 2 0
      _ign = fclose int nul
    end
    _ign = execenv g_pkt 0 pktlen g_epkt 0 elen
    exit int 127
  end
  _ign = fclose pwr
  put g_last_pid 0 int pid
  ret prd
end

fn cap_drain_prd prd int to ulong
  k = ulong 0
  while true bound 100000
    r = read prd g_fbuf 0 4096
    if le r 0
      break
    end
    for i ulong ulong r bound 4096
      if lt k 16383
        put g_cap_buf k get g_fbuf i
        k = add k 1
      end
    end
  end
  _ign = fclose prd
  while gt k 0 bound 16384
    if or eq get g_cap_buf sub k 1 uchar 10 eq get g_cap_buf sub k 1 uchar 13
      k = sub k 1
    else
      break
    end
  end
  ret k
end

fn run_capture_pkt pktlen ulong to long
  prd = spawn_pkt_pipe pktlen
  if lt prd 0
    ret -1
  end
  k = cap_drain_prd prd
  st = wait_child_exit get g_last_pid 0
  if lt st 0
    ret -1
  end
  put g_cap_len 0 k
  ret st
end

fn run_sha_pkt pktlen ulong dst edit uchar * doff ulong to long
  prd = spawn_pkt_pipe pktlen
  if lt prd 0
    ret -1
  end
  sh_init
  while true bound 1000000
    r = read prd g_fbuf 0 4096
    if le r 0
      break
    end
    sh_slice_fbuf ulong r
  end
  _ign = fclose prd
  sh_final 120
  dg_to_hex 120 dst doff
  ret wait_child_exit get g_last_pid 0
end


    if not sha_file_hex cp get g_c_plen ci hx 103
      ret refuse_txt t_s438 t_s80 t_s440
    end
    sa_set hx 0 64
    if not sa_eq_g_c_fsha ci
      ret refuse_txt t_s438 t_s80 t_s440
    end
  end
  ret 0
end


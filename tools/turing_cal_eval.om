  ob_txt t_s367
  ob_g_ds_id
  ob_txt t_s26
  ob_g_ds_split
  ob_txt t_s368
  ob_g_ds_pay
  ob_txt t_s369
  for i ulong 9
    ci = add i 1
    if gt i 0
      ob_txt t_s14
    end
    ob_b uchar 83
    ob_u64 ci

fn sl_find hay view uchar * ho ulong hl ulong ned view uchar * to long
  nl = len ned
  if eq nl 0
    ret 0
  end
  if lt hl nl
    ret -1
  end
  lim = add sub hl nl 1
  for i ulong lim bound 65536
    ok = true
    for j ulong nl bound 4096
      ch = get hay add add ho i j
      cn = get ned j
      if ne ch cn
        ok = false
        break
      end
    end
    if ok
      ret long i
    end
  end
  ret -1
end

fn sl_has hay view uchar * ho ulong hl ulong ned view uchar * to bool
  ret ge sl_find hay ho hl ned 0
end

fn sl_find_slurp ho ulong hl ulong ned view uchar * to long
  nl = len ned
  if eq nl 0
    ret 0
  end
  if lt hl nl
    ret -1
  end
  lim = add sub hl nl 1
  for i ulong lim bound 10000000
    ok = true
    for j ulong nl bound 4096
      ch = get g_slurp add add ho i j
      cn = get ned j
      if ne ch cn
        ok = false
        break
      end
    end
    if ok
      ret long i
    end
  end
  ret -1
end
fn sl_has_slurp ho ulong hl ulong ned view uchar * to bool
  ret ge sl_find_slurp ho hl ned 0
end
fn sl_find_rep ho ulong hl ulong ned view uchar * to long
  nl = len ned
  if eq nl 0
    ret 0
  end
  if lt hl nl

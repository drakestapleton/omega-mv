fn coder_decode_verify x ulong cn ulong to bool
  rc = TC_OK
  if eq x 0
    rc = tc_range_decode cn
  else
    rc = tc_rans_decode cn
  end
  if ne rc TC_OK
    ret false
  end
  sn = get g_sy_n 0
  ok = eq get g_dsy_n 0 sn
  if ok
    for t ulong sn bound 100000000
      if ne get g_dsy t get g_sy t
        ok = false
        break
      end
    end
  end
  for i ulong 32
    put g_dsy_dat i get g_sy_dat i
  end
  if eq tc_sy_serialize 1 TC_OK
    for i ulong 32
      put g_dig i get g_dsy_dig i
    end
    dg_to_dd x 0
    if eq x 0
      put g_h0 0 1
    else
      put g_h1 0 1
    end
  end
  ret ok
end

fn coder_save_write x ulong ci ulong fi ulong cp edit uchar * to int
  ob_set_fd int -1
  for i ulong get g_work_l 0 bound 4096
    ob_b get g_work i
  end
  if eq x 0
    ob_txt t_s156
  else
    ob_txt t_s157
  end
  ob_u64 get g_f_g fi
  ob_txt t_s133
  ob_u64 get g_f_j fi
  ob_b uchar 95
  ob_g_c_name ci
  if eq x 0
    ob_txt t_s158
  else
    ob_txt t_s159
  end
  cpl = get g_olen 0
  for i ulong cpl bound 4096
    put cp i get g_obuf i
  end
  put g_olen 0 0
  if not write_cb_file cp cpl
    ret refuse_txt t_s160 t_s161 t_s162
  end
  if not read_cb_file cp cpl
    ret refuse_txt t_s163 t_s161 t_s164
  end
  if not sha_g_csha cp cpl
    ret refuse_txt t_s163 t_s161 t_s165
  end
  put g_gate_f 7 cpl
  ret 0
end

fn run_one_coder x ulong ci ulong fi ulong first_res ulong to int
  rc = TC_OK
  if eq x 0
    rc = tc_range_encode
  else
    rc = tc_rans_encode
  end
  if ne rc TC_OK
    set_fmsg t_s148 13
    ret refuse_c t_s149 t_s150 t_s151
  end
  cn = get g_cb_len 0
  if lt cn TC_CODED_HEADER
    set_fmsg t_s152 20
    ret refuse_c t_s153 t_s150 t_s154
  end
  for i ulong 32
    if ne get g_cb add 16 i get g_ps_dig i
      set_fmsg t_s155 38
      ret refuse_c t_s153 t_s150 t_s154
    end
  end
  cp = new uchar 4096 0
  rc = coder_save_write x ci fi cp
  if ne rc 0
    ret rc
  end
  cn = get g_cb_len 0
  ridx = add mul ci MAXF fi
  if eq x 0
    put g_r_nrange ridx cn
    for i ulong 64
      put g_r_rsha add mul ridx 64 i get g_csha i
    end
    put g_h0 0 0
  else
    put g_r_nrans ridx cn
    for i ulong 64
      put g_r_asha add mul ridx 64 i get g_csha i
    end
    put g_h1 0 0
  end
  ok = coder_decode_verify x cn
  if not ok
    put g_s1 0 0
  end
  ridx = 0
  if ok
    ridx = 1
  end
  if eq x 0
    put g_ok0 0 ridx
  else
    put g_ok1 0 ridx
  end
  ob_set_fd get g_fd_enc 0
  for i ulong 64
    ob_b get g_csha i
  end
  if eq x 0
    ob_txt t_s166
  else
    ob_txt t_s167
  end
  ob_u64 get g_f_g fi
  ob_b uchar 32
  ob_u64 get g_f_j fi
  ob_b uchar 32
  ob_g_c_name ci
  ob_b uchar 32
  ob_u64 cn
  ob_b uchar 32
  ob_slice cp 0 get g_gate_f 7
  ob_b uchar 10
  _ign = ob_flush
  write_coder_res x ci fi first_res cn
  if ok
    ret 1
  end
  ret 0
end

fn iabs64 x long to long
  if lt x 0
    ret sub 0 x
  end
  ret x
end

fn env_band n ulong to long
  ret add ENV_A mul ENV_B long n
end

fn eval_crumb_check_dec lo ulong n ulong ridx ulong is_rans bool to void
  k = get g_ps_k 0
  nx = get g_cb_plen 0
  rc = TC_OK
  if is_rans
    rc = tc_rans_decode_raw lo n k 0 nx
  else
    rc = tc_range_decode_raw lo n k 0 nx
  end
  if ne rc TC_OK
    put g_s1 0 0
    put g_r_lossless ridx 0
    ret
  end
  for t ulong n bound 100000000
    if ne get g_dsy t get g_sy add lo t
      put g_s1 0 0
      put g_r_lossless ridx 0
      ret
    end
  end
end

fn eval_crumb_env ridx ulong n ulong cub long cb ulong is_rans bool to void
  ovh = sub mul long cb mul 8 UB cub
  m = sub env_band n iabs64 sub ovh ENV_CENTER
  if is_rans
    if lt m 0
      put g_r_ecfail1 ridx add get g_r_ecfail1 ridx 1
    end
    if lt m get g_r_wcm1 ridx
      put g_r_wcm1 ridx m
    end
  else
    if lt m 0
      put g_r_ecfail0 ridx add get g_r_ecfail0 ridx 1
    end
    if lt m get g_r_wcm0 ridx
      put g_r_wcm0 ridx m
    end
  end
end

fn eval_crumb_one ridx ulong rc_i ulong lo ulong n ulong to int
  k = get g_ps_k 0
  cub = get g_rc_ub rc_i
  if ne tc_range_encode_raw lo n k 0 TC_OK
    set_fmsg t_s170 25
    ret refuse_c t_s149 t_s171 t_s151
  end
  eval_crumb_check_dec lo n ridx false
  cb = add get g_cb_plen 0 TC_CODED_HEADER
  put g_rc_rng rc_i cb
  eval_crumb_env ridx n cub cb false
  if ne tc_rans_encode_raw lo n k 0 TC_OK
    set_fmsg t_s172 24
    ret refuse_c t_s149 t_s171 t_s151
  end
  eval_crumb_check_dec lo n ridx true
  cb = add get g_cb_plen 0 TC_CODED_HEADER
  put g_rc_rns rc_i cb
  eval_crumb_env ridx n cub cb true
  ret 0
end

fn eval_crumbs_efail ridx ulong fband long to void
  f0 = mul long get g_r_nrange ridx mul 8 UB
  f0 = sub f0 get g_r_ideal ridx
  f0 = sub f0 ENV_CENTER
  if gt iabs64 f0 fband
    put g_r_efail0 ridx 1
  end
  f0 = mul long get g_r_nrans ridx mul 8 UB
  f0 = sub f0 get g_r_ideal ridx
  f0 = sub f0 ENV_CENTER
  if gt iabs64 f0 fband
    put g_r_efail1 ridx 1
  end
end

fn eval_crumbs ci ulong fi ulong to int
  ridx = add mul ci MAXF fi
  cr_off = get g_f_cr_off fi
  ncr = get g_f_cr_n fi
  rc_base = get g_rc_used 0
  if not ensure_rc add rc_base ncr
    ret refuse_txt t_s168 t_s161 t_s169
  end
  put g_r_cr_off ridx rc_base
  put g_rc_used 0 add rc_base ncr
  put g_r_wcm0 ridx I64_MAX
  put g_r_wcm1 ridx I64_MAX
  put g_r_efail0 ridx 0
  put g_r_efail1 ridx 0
  put g_r_ecfail0 ridx 0
  put g_r_ecfail1 ridx 0
  csum = long 0
  for q ulong ncr bound 10000000
    lo = get g_cr_lo add cr_off q
    hi = get g_cr_hi add cr_off q
    cub = tc_ideal_ub_range lo hi
    put g_rc_ub add rc_base q cub
    csum = add csum cub
    ec_rc = eval_crumb_one ridx add rc_base q lo sub hi lo
    if ne ec_rc 0
      ret ec_rc
    end
  end
  put g_r_csum ridx csum
  if ne csum get g_r_ideal ridx
    set_fmsg t_s173 23
    ret refuse_c t_s174 t_s175 t_s176
  end
  eval_crumbs_efail ridx env_band get g_ps_n 0
  ret 0
end

fn eval_cand_write_ps ci ulong fi ulong to int
  syp = new uchar 4096 0
  g = get g_f_g fi
  j = get g_f_j fi
  ob_set_fd int -1
  for i ulong get g_work_l 0 bound 4096
    ob_b get g_work i
  end
  ob_txt t_s180
  ob_u64 g
  ob_txt t_s133
  ob_u64 j
  ob_b uchar 95
  ob_g_c_name ci
  ob_txt t_s181
  pspl = get g_olen 0
  for i ulong pspl bound 4096
    put g_psp i get g_obuf i
  end
  put g_pspl 0 pspl
  put g_olen 0 0
  for i ulong get g_work_l 0 bound 4096
    ob_b get g_work i
  end
  ob_txt t_s182
  ob_u64 g
  ob_txt t_s133
  ob_u64 j
  ob_b uchar 95
  ob_g_c_name ci
  ob_txt t_s183
  g = get g_olen 0
  for i ulong g bound 4096
    put syp i get g_obuf i
  end
  put g_olen 0 0
  if or not write_pb_g_psp pspl not write_sb_file syp g
    ret refuse_txt t_s160 t_s161 t_s184
  end
  if or not read_pb_g_psp pspl not read_sb_file syp g
    ret refuse_txt t_s163 t_s161 t_s185
  end
  ret 0
end

fn eval_cand_parse_ps ci ulong fi ulong to int
  if ne tc_ps_parse TC_OK
    set_fmsg t_s186 17
    ret refuse_c t_s153 t_s187 t_err_format
  end
  if ne tc_sy_parse TC_OK
    set_fmsg t_s188 17
    ret refuse_c t_s153 t_s187 t_err_format
  end
  if or ne tc_ps_expect fi TC_OK ne tc_pair_check TC_OK
    wl = get g_whylen 0
    if gt wl 1023
      wl = 1023
    end
    for i ulong wl bound 1024
      put g_fmsg i get g_why i
    end
    put g_fmsgl 0 wl
    ret refuse_c t_s153 t_s189 t_err_binding
  end
  _ign = sha_g_psp_to_fsha get g_pspl 0
  for i ulong 32
    put g_dig i get g_ps_dig i
  end
  ro = mul add mul ci MAXF fi 64
  dg_to_r_tps 0 ro
  for i ulong 32
    put g_dig i get g_sy_dig i
  end
  dg_to_r_tsy 0 ro
  if eq get g_tsy_set fi 0
    put g_tsy_set fi 1
    for i ulong 64
      put g_tsy_dig add mul fi 64 i get g_r_tsy add ro i
    end
  else
    sa_set_tsy_dig fi
    if not sa_eq_g_r_tsy ro
      put g_s3 0 0
    end
  end
  write_ps_index_line ci fi get g_pb_len 0
  if eq get g_f_cr_n fi 0
    if not record_file_crumbs fi
      ret refuse_txt t_s168 t_s161 t_s190
    end
  else
    if not check_file_crumbs fi
      put g_s3 0 0
    end
  end
  if eq get g_s3 0 0
    set_fmsg t_s191 38
    ret refuse_c t_s153 t_s153_b t_s192
  end
  ret 0
end

fn eval_cand_produce_err rc int to int
  en = new uchar 32 0
  _ign = tc_err_name rc en
  wl = get g_whylen 0
  if gt wl 1023
    wl = 1023
  end
  for i ulong wl bound 1024
    put g_fmsg i get g_why i
  end
  put g_fmsgl 0 wl
  ret refuse_c t_s153 t_s177 en
end

fn eval_cand_file ci ulong fi ulong first_res ulong to int
  rc = tc_produce fi
  if ne rc TC_OK
    ret eval_cand_produce_err rc
  end
  if or ne tc_ps_serialize TC_OK ne tc_sy_serialize 0 TC_OK
    set_fmsg t_s178 16
    ret refuse_c t_s153 t_s179 t_s76
  end
  rc = eval_cand_write_ps ci fi
  if ne rc 0
    ret rc
  end
  rc = eval_cand_parse_ps ci fi
  if ne rc 0
    ret rc
  end
  ridx = add mul ci MAXF fi
  put g_r_ideal ridx tc_ideal_ub_range 0 get g_ps_n 0
  r0 = run_one_coder 0 ci fi first_res
  if ge r0 2
    ret r0
  end
  r1 = run_one_coder 1 ci fi first_res
  if ge r1 2
    ret r1
  end
  if and eq r0 1 eq r1 1
    put g_r_lossless ridx 1
  else
    put g_r_lossless ridx 0
  end
  if not write_decoder_receipt ci fi
    ret refuse_txt t_s168 t_s161 t_s193
  end
  ret eval_crumbs ci fi
end

fn splitmix64_next st_p edit ulong * to ulong
  z = add get st_p 0 ulong 0x9e3779b97f4a7c15
  put st_p 0 z
  z = mul xor z shr z 30 ulong 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 ulong 0x94d049bb133111eb
  ret xor z shr z 31
end

fn tb_sift start ulong end_n ulong to void
  root = start
  while lt add mul root 2 1 end_n bound 32
    ch = add mul root 2 1
    sw = root
    if lt get g_boot_tb sw get g_boot_tb ch
      sw = ch
    end
    if lt add ch 1 end_n
      if lt get g_boot_tb sw get g_boot_tb add ch 1
        sw = add ch 1
      end
    end
    if eq sw root
      ret
    end
    t = get g_boot_tb root
    put g_boot_tb root get g_boot_tb sw
    put g_boot_tb sw t
    root = sw
  end
end

fn tb_sort n ulong to void
  i = div n 2
  while gt i 0 bound 10000
    i = sub i 1
    tb_sift i n
  end
  end_n = n
  while gt end_n 1 bound 10000
    end_n = sub end_n 1
    t = get g_boot_tb 0
    put g_boot_tb 0 get g_boot_tb end_n
    put g_boot_tb end_n t
    tb_sift 0 end_n
  end
end

fn boot_prep_cand_file ci ulong fi ulong pbase ulong q ulong to ulong
  ro = get g_r_cr_off add mul ci MAXF fi
  for z ulong get g_f_cr_n fi bound 10000000
    put g_boot_pool add pbase q get g_rc_ub add ro z
    q = add q 1
  end
  ret q
end

fn boot_prep_pool g ulong cn ulong to void
  nc = get g_nc 0
  nf = get g_nf 0
  for ci ulong nc bound 64
    q = ulong 0
    pbase = mul ci cn
    for fi ulong nf bound 64
      if eq get g_f_g fi g
        q = boot_prep_cand_file ci fi pbase q
      end
    end
    pbase = mul ci BOOT_B
    for b ulong BOOT_B bound 10000
      put g_boot_sb add pbase b 0
    end
  end
end

fn boot_add_sample b ulong cn ulong idx ulong to void
  for ci ulong get g_nc 0 bound 64
    p1 = add mul ci BOOT_B b
    p2 = add mul ci cn idx
    v = get g_boot_pool p2
    v = add v get g_boot_sb p1
    put g_boot_sb p1 v
  end
end

fn boot_run_iters g ulong cn ulong to void
  st = new ulong 1 0
  put st 0 add BOOT_SEED g
  lim = ulong 0xffffffffffffffff
  lim = sub lim rem add rem lim cn 1 cn
  for b ulong BOOT_B bound 10000
    for k ulong cn bound 10000000
      idx = splitmix64_next st
      while gt idx lim bound 10000
        idx = splitmix64_next st
      end
      boot_add_sample b cn rem idx cn
    end
  end
end

fn boot_pair_one g ulong ci ulong bi ulong b2 ulong to void
  shift = mul sub get g_c_lm ci get g_c_lm bi UB
  s_ci = mul ci BOOT_B
  s_bi = mul bi BOOT_B
  for b ulong BOOT_B bound 10000
    v = get g_boot_sb add s_bi b
    v = sub v get g_boot_sb add s_ci b
    v = sub v shift
    put g_boot_tb b v
    if and eq bi b2 gt v 0
      p1 = add mul g 64 ci
      put g_pgt0 p1 add get g_pgt0 p1 1
    end
  end
  tb_sort BOOT_B
  s_ci = add mul g 64 bi
  s_bi = add mul g 64 ci
  shift = sub sub get g_ideal s_ci get g_ideal s_bi shift
  s_ci = add mul g 4096 add mul ci 64 bi
  put g_tb_pt s_ci shift
  put g_tb_lo s_ci get g_boot_tb BOOT_LO
  put g_tb_hi s_ci get g_boot_tb BOOT_HI
  if eq bi b2
    s_ci = add mul g 192 mul ci 3
    put g_tv_pt s_ci shift
    put g_tv_lo s_ci get g_boot_tb BOOT_LO
    put g_tv_hi s_ci get g_boot_tb BOOT_HI
  end
end

fn boot_shift_tv dst_t ulong src_t ulong sh long to void
  put g_tv_pt dst_t sub get g_tv_pt src_t sh
  put g_tv_lo dst_t sub get g_tv_lo src_t sh
  put g_tv_hi dst_t sub get g_tv_hi src_t sh
end

fn boot_fill_tv_coders g ulong ci ulong b2 ulong to void
  tid = add mul g 192 mul ci 3
  gc = add mul g 64 ci
  gb = add mul g 64 b2
  om0 = mul get g_coded0 gc UB
  om0 = sub om0 get g_ideal gc
  ob0 = mul get g_coded0 gb UB
  ob0 = sub ob0 get g_ideal gb
  boot_shift_tv add tid 1 tid sub om0 ob0
  om0 = mul get g_coded1 gc UB
  om0 = sub om0 get g_ideal gc
  ob0 = mul get g_coded1 gb UB
  ob0 = sub ob0 get g_ideal gb
  boot_shift_tv add tid 2 tid sub om0 ob0
end

fn boot_sum_file g ulong fi ulong to void
  for ci ulong get g_nc 0 bound 64
    gc = add mul g 64 ci
    ridx = add mul ci MAXF fi
    v = get g_ideal gc
    v = add v get g_r_ideal ridx
    put g_ideal gc v
    v = get g_coded0 gc
    v = add v long mul get g_r_nrange ridx 8
    put g_coded0 gc v
    v = get g_coded1 gc
    v = add v long mul get g_r_nrans ridx 8
    put g_coded1 gc v
  end
end

fn run_bootstrap_group g ulong b2 ulong to int
  nc = get g_nc 0
  nf = get g_nf 0
  cn = ulong 0
  evs = long 0
  bs = long 0
  for ci ulong nc bound 64
    gc = add mul g 64 ci
    put g_ideal gc 0
    put g_coded0 gc 0
    put g_coded1 gc 0
    put g_pgt0 gc 0
  end
  for fi ulong nf bound 64
    if eq get g_f_g fi g
      cn = add cn get g_f_cr_n fi
      evs = add evs long get g_f_ev_n fi
      bs = add bs env_band get g_f_ev_n fi
      boot_sum_file g fi
    end
  end
  put g_pool_n g cn
  put g_events g evs
  put g_band_sum g bs
  if eq cn 0
    if eq g 2
      set_fmsg t_s194 19
      ret refuse_c t_s195 t_s196 t_s197
    end
    set_fmsg t_s194 19
    ret refuse_c t_s198 t_s196 t_s197
  end
  if not ensure_boot mul cn nc mul BOOT_B nc
    ret refuse_txt t_s196 t_s161 t_s199
  end
  boot_prep_pool g cn
  boot_run_iters g cn
  for ci ulong nc bound 64
    for bi ulong nc bound 64
      boot_pair_one g ci bi b2
    end
    boot_fill_tv_coders g ci b2
  end
  ret 0
end

fn revlog_flush to void
  n = get g_olen 0
  rl = get g_revlen 0
  if ge rl 65300
    put g_olen 0 0
    ret
  end
  for i ulong n bound 2048
    if lt add rl i 65535
      put g_revlog add rl i get g_obuf i
    end
  end
  rl = add rl n
  if gt rl 65535
    rl = 65535
  end
  put g_revlen 0 rl
  put g_olen 0 0
end

fn sgn_i64 v long to long
  if gt v 0
    ret 1
  end
  if lt v 0
    ret -1
  end
  ret 0
end

fn s5_log_pair_rev g ulong x ulong a ulong b ulong di long dc long to void
  put g_nrev 0 add get g_nrev 0 1
  expl = le iabs64 di mul 2 get g_band_sum g
  if expl
    put g_nrev_ex 0 add get g_nrev_ex 0 1
  else
    put g_s5 0 0
  end
  ob_set_fd int -1
  ob_txt t_s118
  ob_u64 g
  if eq x 0
    ob_txt t_s200
  else
    ob_txt t_s201
  end
  ob_g_c_name a
  ob_txt t_s202
  ob_g_c_name b
  ob_txt t_s203
  ob_i64 di
  ob_txt t_s204
  ob_i64 dc
  ob_txt t_s205
  if expl
    ob_txt t_true
  else
    ob_txt t_false
  end
  ob_txt t_s206
  revlog_flush
end

fn s5_pair_revs g ulong x ulong a ulong to void
  nc = get g_nc 0
  b = add a 1
  while lt b nc bound 64
    ga = add mul g 64 a
    gb = add mul g 64 b
    di = mul get g_c_lm a UB
    di = add di get g_ideal ga
    dc = mul get g_c_lm b UB
    dc = add dc get g_ideal gb
    di = sub di dc
    dc = sub get g_coded0 ga get g_coded0 gb
    if eq x 1
      dc = sub get g_coded1 ga get g_coded1 gb
    end
    dc = add dc sub get g_c_lm a get g_c_lm b
    dc = mul dc UB
    if ne sgn_i64 di sgn_i64 dc
      s5_log_pair_rev g x a b di dc
    end
    b = add b 1
  end
end

fn s5_excl_disjoint iu ulong iv ulong to bool
  up = get g_tv_pt iu
  ul = get g_tv_lo iu
  uh = get g_tv_hi iu
  vp = get g_tv_pt iv
  vl = get g_tv_lo iv
  vh = get g_tv_hi iv
  if eq sgn_i64 up sgn_i64 vp
    ret false
  end
  if or lt up vl gt up vh
    ret or lt vp ul gt vp uh
  end
  ret false
end

fn s5_sign_checks ci ulong to void
  for gu ulong 2
    g = add gu 1
    bs2 = mul 2 get g_band_sum g
    for x ulong 2
      iu = add mul g 192 mul ci 3
      iv = add iu add x 1
      if s5_excl_disjoint iu iv
        put g_nrev 0 add get g_nrev 0 1
        expl = le iabs64 sub get g_tv_pt iu get g_tv_pt iv bs2
        if expl
          put g_nrev_ex 0 add get g_nrev_ex 0 1
        else
          put g_s5 0 0
        end
        ob_set_fd int -1
        ob_txt t_s118
        ob_u64 g
        if eq x 0
          ob_txt t_s207
        else
          ob_txt t_s208
        end
        ob_g_c_name ci
        ob_txt t_s209
        if expl
          ob_txt t_true
        else
          ob_txt t_false
        end
        ob_txt t_s206
        revlog_flush
      end
    end
  end
  for x ulong 3
    if s5_excl_disjoint add 192 add mul ci 3 x add 384 add mul ci 3 x
      put g_nrev 0 add get g_nrev 0 1
      put g_s5 0 0
      ob_set_fd int -1
      ob_txt t_s210
      if eq x 0
        ob_txt t_s211
      end
      if eq x 1
        ob_txt t_s212
      end
      if eq x 2
        ob_txt t_s213
      end
      ob_txt t_s214
      ob_g_c_name ci
      ob_txt t_s215
      revlog_flush
    end
  end
end

fn s5_rank_diff g ulong x ulong a ulong to ulong
  nc = get g_nc 0
  ga = add mul g 64 a
  da_i = add mul get g_c_lm a UB get g_ideal ga
  da_c = add get g_c_lm a get g_coded0 ga
  if eq x 1
    da_c = add get g_c_lm a get g_coded1 ga
  end
  ra = ulong 0
  rb = ulong 0
  for b ulong nc bound 64
    ga = add mul g 64 b
    dv = mul get g_c_lm b UB
    dv = add dv get g_ideal ga
    if lt dv da_i
      ra = add ra 1
    end
    dv = get g_c_lm b
    if eq x 0
      dv = add dv get g_coded0 ga
    else
      dv = add dv get g_coded1 ga
    end
    if lt dv da_c
      rb = add rb 1
    end
  end
  if ge ra rb
    ret sub ra rb
  end
  ret sub rb ra
end

fn s5_spearman g ulong x ulong to void
  nc = get g_nc 0
  d2 = ulong 0
  for a ulong nc bound 64
    df = s5_rank_diff g x a
    d2 = add d2 mul df df
  end
  si = add mul g 2 x
  if le nc 1
    put g_rho_neg si 0
    put g_rho_num si 1
    put g_rho_den si 1
    ret
  end
  den = mul nc sub mul nc nc 1
  d2 = mul 6 d2
  put g_rho_den si den
  if ge den d2
    put g_rho_neg si 0
    put g_rho_num si sub den d2
  else
    put g_rho_neg si 1
    put g_rho_num si sub d2 den
  end
end

fn audit_s5_reversals b2 ulong to void
  nc = get g_nc 0
  put g_s5 0 1
  put g_nrev 0 0
  put g_nrev_ex 0 0
  put g_revlen 0 0
  for gu ulong 2
    for x ulong 2
      for a ulong nc bound 64
        s5_pair_revs add gu 1 x a
      end
    end
  end
  for ci ulong nc bound 64
    if ne ci b2
      s5_sign_checks ci
    end
  end
  rl = get g_revlen 0
  if ge rl 2
    if eq get g_revlog sub rl 2 uchar 44
      put g_revlog sub rl 2 uchar 10
      put g_revlen 0 sub rl 1
    end
  end
  for gu ulong 2
    for x ulong 2
      s5_spearman add gu 1 x
    end
  end
end

fn set_crit idx ulong s view uchar * to void
  l = len s
  co = mul idx 16
  for i ulong l bound 16
    put g_crit add co i get s i
  end
  put g_crit_l idx l
end

fn set_crit_tri idx ulong v long to void
  if eq v -2
    set_crit idx t_nr
    ret
  end
  if eq v -1
    set_crit idx t_fail
    ret
  end
  if eq v 0
    set_crit idx t_inc
    ret
  end
  set_crit idx t_pass
end

fn crit_s6_group g ulong mi long to long
  if lt mi 0
    ret -2
  end
  sv = long 1
  for x ulong 3
    tid = add mul g 192 add mul ulong mi 3 x
    e = long 0
    if gt get g_tv_lo tid 0
      e = 1
    else
      if lt get g_tv_hi tid 0
        e = -1
      end
    end
    if lt e sv
      sv = e
    end
  end
  ret sv
end

fn crit_s7_one g ulong mk long to long
  if lt mk 0
    ret 1
  end
  tv = long 1
  for x ulong 3
    tid = add mul g 192 add mul ulong mk 3 x
    e = long 0
    if lt get g_tv_hi tid 0
      e = 1
    else
      if gt get g_tv_lo tid 0
        e = -1
      end
    end
    if lt e tv
      tv = e
    end
  end
  ret tv
end

fn crit_s7_group g ulong m1 long m2 long to long
  if and lt m1 0 lt m2 0
    ret -2
  end
  tv = crit_s7_one g m1
  e = crit_s7_one g m2
  if lt e tv
    ret e
  end
  ret tv
end

fn compute_criteria to void
  mi = cand_index_txt t_mcand
  m1 = cand_index_txt t_mmem
  m2 = cand_index_txt t_mmem1
  s6_1 = crit_s6_group 1 mi
  s6_2 = crit_s6_group 2 mi
  s7_1 = crit_s7_group 1 m1 m2
  s7_2 = crit_s7_group 2 m1 m2
  mi = long -2
  if and ne s6_2 -2 ne s7_2 -2
    mi = s6_2
    if lt s7_2 mi
      mi = s7_2
    end
  end
  if ne get g_s1 0 0
    set_crit 1 t_pass
  else
    set_crit 1 t_fail
  end
  if ne get g_dry 0 0
    set_crit 2 t_nc
  else
    set_crit 2 t_pass
  end
  if ne get g_s3 0 0
    set_crit 3 t_pass
  else
    set_crit 3 t_fail
  end
  if ne get g_s4 0 0
    set_crit 4 t_pass
  else
    set_crit 4 t_fail
  end
  if ne get g_s5 0 0
    set_crit 5 t_pass
  else
    set_crit 5 t_fail
  end
  set_crit_tri 6 s6_1
  set_crit_tri 7 s7_1
  set_crit_tri 9 mi
end

fn open_out_rel rel view uchar * to long
  p = new uchar 4096 0
  pj_set_g_out
  pl = pj_make rel len rel p
  if eq pl 0
    ret -1
  end
  ret long fopen p 0 pl int 577 420
end


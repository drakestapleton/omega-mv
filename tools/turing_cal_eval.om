fn tc_ps_parse_rec t ulong off ulong k ulong to int
  if ne tc_pb_get_u64 off t
    set_why t_s65
    ret TC_E_INDEX
  end
  put g_ps_key t tc_pb_get_u64 add off 8
  put g_ps_crumb t uint tc_pb_get_u32 add off 16
  nsum = tc_pb_get_u32 add off 20
  qbase = mul t k
  for x ulong k bound 16
    put g_ps_q add qbase x ushort tc_pb_get_u16 add off add 24 mul 2 x
  end
  ret tc_ps_check_row t nsum
end

fn tc_ps_hdr_check plen ulong to int
  if or ne tc_pb_get_u16 4 1 ne ulong get g_pb 7 16
    ret TC_E_FORMAT
  end
  if or ne tc_pb_get_u32 8 0 or ne tc_pb_get_u32 24 0 ne tc_pb_get_u32 124 0
    ret TC_E_FORMAT
  end
  k = ulong get g_pb 6
  if or lt k TY_KMIN gt k TY_KMAX
    ret TC_E_FORMAT
  end
  n = tc_pb_get_u64 12
  rb = add TC_PS_REC_FIXED mul 2 k
  if ne tc_pb_get_u32 20 rb
    ret TC_E_FORMAT
  end
  if ne add add TC_PS_HEADER mul n rb TC_DIGEST plen
    ret TC_E_FORMAT
  end
  if not ensure_ps_n add n 1 k
    ret TC_E_IO
  end
  put g_ps_k 0 k
  put g_ps_n 0 n
  ret TC_OK
end

fn tc_ps_parse to int
  plen = get g_pb_len 0
  if lt plen add TC_PS_HEADER TC_DIGEST
    set_why t_s66
    ret TC_E_FORMAT
  end
  if or ne get g_pb 0 84 ne get g_pb 1 80
    set_why t_s67
    ret TC_E_FORMAT
  end
  if or ne get g_pb 2 83 ne get g_pb 3 49
    set_why t_s67
    ret TC_E_FORMAT
  end
  body = sub plen TC_DIGEST
  sh_init
  sh_slice t_dom_ps 0 len t_dom_ps
  sh_byte 0
  for i ulong body bound 1000000000
    sh_byte get g_pb i
  end
  sh_final 116
  for i ulong 32
    if ne get g_dig add 3712 i get g_pb add body i
      set_why t_s68
      ret TC_E_DIGEST
    end
  end
  rc = tc_ps_hdr_check plen
  if ne rc TC_OK
    ret rc
  end
  for i ulong 32
    put g_ps_prof i get g_pb add 28 i
    put g_ps_mod i get g_pb add 60 i
    put g_ps_dat i get g_pb add 92 i
    put g_ps_dig i get g_dig add 3712 i
  end
  plen = add TC_PS_REC_FIXED mul 2 get g_ps_k 0
  body = TC_PS_HEADER
  for t ulong get g_ps_n 0 bound 100000000
    rc = tc_ps_parse_rec t body get g_ps_k 0
    if ne rc TC_OK
      ret rc
    end
    body = add body plen
  end
  ret TC_OK
end

fn tc_sy_parse to int
  slen = get g_sb_len 0
  if lt slen add TC_SY_HEADER TC_DIGEST
    ret TC_E_FORMAT
  end
  if or ne get g_sb 0 84 ne get g_sb 1 83
    ret TC_E_FORMAT
  end
  if or ne get g_sb 2 89 ne get g_sb 3 49
    ret TC_E_FORMAT
  end
  body = sub slen TC_DIGEST
  sh_init
  sh_slice t_dom_sy 0 len t_dom_sy
  sh_byte 0
  for i ulong body bound 1000000000
    sh_byte get g_sb i
  end
  sh_final 115
  o = ulong 3680
  for i ulong 32
    if ne get g_dig add o i get g_sb add body i
      ret TC_E_DIGEST
    end
  end
  ver = tc_sb_get_u16 4
  k = ulong get g_sb 6
  n = tc_sb_get_u64 8
  if or ne ver 1 or lt k TY_KMIN gt k TY_KMAX
    ret TC_E_FORMAT
  end
  if ne add add TC_SY_HEADER n TC_DIGEST slen
    ret TC_E_COUNT
  end
  put g_sy_k 0 k
  put g_sy_n 0 n
  for i ulong 32
    put g_sy_dat i get g_sb add 24 i
    put g_sy_dig i get g_dig add o i
  end
  for t ulong n bound 100000000
    sv = get g_sb add TC_SY_HEADER t
    if ge ulong sv k
      ret TC_E_SYMBOL
    end
    put g_sy t sv
  end
  ret TC_OK
end

fn tc_ps_expect fi ulong to int
  for i ulong 32
    if ne get g_ps_prof i get g_prof_dig i
      set_why t_s69
      ret TC_E_PROFILE
    end
    if ne get g_ps_mod i get g_md_dig i
      set_why t_s70
      ret TC_E_MODEL
    end
    if ne get g_ps_dat i get g_f_dd add mul fi 32 i
      set_why t_s71
      ret TC_E_DATASET
    end
  end
  ret TC_OK
end

fn tc_pair_check to int
  pk = get g_ps_k 0
  pn = get g_ps_n 0
  sk = get g_sy_k 0
  sn = get g_sy_n 0
  if or ne pk sk ne pn sn
    set_why t_s72
    ret TC_E_COUNT
  end
  for i ulong 32
    if ne get g_ps_dat i get g_sy_dat i
      set_why t_s73
      ret TC_E_DATASET
    end
  end
  for t ulong sn bound 100000000
    if ge ulong get g_sy t sk
      ret TC_E_SYMBOL
    end
  end
  ret TC_OK
end

fn tc_coded_hdr_write cid ulong payload ulong to void
  for i ulong 56
    put g_cb i 0
  end
  put g_cb 0 84
  put g_cb 1 67
  if eq cid 1
    put g_cb 2 82
  else
    put g_cb 2 65
  end
  put g_cb 3 49
  put g_cb 4 1
  put g_cb 5 uchar cid
  tc_cb_put_u64 8 get g_ps_n 0
  for i ulong 32
    put g_cb add 16 i get g_ps_dig i
  end
  tc_cb_put_u64 48 payload
end

fn tc_coded_hdr_check cid ulong clen ulong to int
  if lt clen TC_CODED_HEADER
    ret TC_E_HEADER
  end
  m2 = uchar 65
  if eq cid 1
    m2 = uchar 82
  end
  if or ne get g_cb 0 84 ne get g_cb 1 67
    ret TC_E_HEADER
  end
  if or ne get g_cb 2 m2 ne get g_cb 3 49
    ret TC_E_HEADER
  end
  if or ne get g_cb 4 1 ne ulong get g_cb 5 cid
    ret TC_E_HEADER
  end
  if or ne get g_cb 6 0 ne get g_cb 7 0
    ret TC_E_HEADER
  end
  for i ulong 32
    if ne get g_cb add 16 i get g_ps_dig i
      ret TC_E_BINDING
    end
  end
  n = tc_cb_get_u64 8
  pl = tc_cb_get_u64 48
  if ne n get g_ps_n 0
    ret TC_E_COUNT
  end
  avail = sub clen TC_CODED_HEADER
  if gt pl avail
    ret TC_E_TRUNC
  end
  if lt pl avail
    ret TC_E_TRAIL
  end
  put g_cb_plen 0 pl
  ret TC_OK
end

fn tc_rc_emit b ulong to void
  pos = get g_rc_st 5
  if ge pos get g_cb_cap 0
    put g_rc_st 6 1
    ret
  end
  put g_cb pos uchar and b 255
  put g_rc_st 5 add pos 1
end

fn tc_rc_shift_low to void
  lo = get g_rc_st 0
  c = shr lo 32
  lo32 = and lo 4294967295
  if or lt lo32 4278190080 ne c 0
    if ne c 0
      put g_rc_st 7 add get g_rc_st 7 1
      if eq get g_rc_st 3 0
        put g_rc_st 6 2
      end
    end
    if ne get g_rc_st 3 0
      tc_rc_emit add get g_rc_st 2 c
    end
    pend = get g_rc_st 4
    while gt pend 0 bound 100000000
      tc_rc_emit add 255 c
      pend = sub pend 1
    end
    put g_rc_st 4 0
    put g_rc_st 2 and shr lo 24 255
    put g_rc_st 3 1
  else
    pend = add get g_rc_st 4 1
    put g_rc_st 4 pend
    if gt pend get g_rc_st 8
      put g_rc_st 8 pend
    end
  end
  put g_rc_st 0 shl and lo 16777215 8
end

fn tc_rc_row_ok qoff ulong k ulong to bool
  s = ulong 0
  for x ulong k bound 16
    v = ulong get g_ps_q add qoff x
    if eq v 0
      ret false
    end
    s = add s v
  end
  ret eq s TY_QONE
end

fn tc_rc_enc_sym t ulong k ulong to int
  qoff = mul t k
  s = ulong get g_sy t
  if ge s k
    ret TC_E_SYMBOL
  end
  if not tc_rc_row_ok qoff k
    ret TC_E_NORM
  end
  cum = ulong 0
  for x ulong s bound 16
    cum = add cum ulong get g_ps_q add qoff x
  end
  rg = get g_rc_st 1
  r = shr rg 16
  put g_rc_st 0 add get g_rc_st 0 mul r cum
  if eq s sub k 1
    rg = sub rg mul r cum
  else
    rg = mul r ulong get g_ps_q add qoff s
  end
  while lt rg TC_RC_TOP bound 2
    rg = shl rg 8
    tc_rc_shift_low
  end
  put g_rc_st 1 rg
  ret TC_OK
end

fn tc_range_encode_raw lo ulong n ulong k ulong out_off ulong to int
  if not ensure_cb add out_off add mul n 4 64
    ret TC_E_IO
  end
  put g_rc_st 0 0
  put g_rc_st 1 4294967295
  put g_rc_st 2 0
  put g_rc_st 3 0
  put g_rc_st 4 0
  put g_rc_st 5 out_off
  put g_rc_st 6 0
  put g_rc_st 7 0
  put g_rc_st 8 0
  for i ulong n bound 100000000
    rc = tc_rc_enc_sym add lo i k
    if ne rc TC_OK
      ret rc
    end
    if ne get g_rc_st 6 0
      ret TC_E_IO
    end
  end
  for j ulong 5
    tc_rc_shift_low
    if ne get g_rc_st 6 0
      ret TC_E_IO
    end
  end
  put g_cb_plen 0 sub get g_rc_st 5 out_off
  ret TC_OK
end

fn tc_rc_dec_renorm to int
  code = get g_rc_st 0
  rg = get g_rc_st 1
  pos = get g_rc_st 2
  in_off = get g_rc_st 3
  plen = get g_rc_st 4
  while lt rg TC_RC_TOP bound 2
    if ge pos plen
      ret TC_E_TRUNC
    end
    code = or shl code 8 ulong get g_cb add in_off pos
    pos = add pos 1
    rg = shl rg 8
  end
  put g_rc_st 0 code
  put g_rc_st 1 rg
  put g_rc_st 2 pos
  ret TC_OK
end

fn tc_rc_dec_sym t ulong i ulong k ulong to int
  code = get g_rc_st 0
  rg = get g_rc_st 1
  if ge code rg
    ret TC_E_CORRUPT
  end
  qoff = mul t k
  if not tc_rc_row_ok qoff k
    ret TC_E_NORM
  end
  r = shr rg 16
  cum = ulong 0
  s = ulong 0
  nk = sub k 1
  while lt s nk bound 16
    nx = add cum ulong get g_ps_q add qoff s
    if lt code mul r nx
      break
    end
    cum = nx
    s = add s 1
  end
  put g_dsy i uchar s
  code = sub code mul r cum
  if eq s nk
    rg = sub rg mul r cum
  else
    rg = mul r ulong get g_ps_q add qoff s
  end
  put g_rc_st 0 code
  put g_rc_st 1 rg
  ret tc_rc_dec_renorm
end

fn tc_range_decode_raw lo ulong n ulong k ulong in_off ulong plen ulong to int
  if lt plen 4
    ret TC_E_TRUNC
  end
  code = ulong 0
  for j ulong 4
    code = or shl code 8 ulong get g_cb add in_off j
  end
  put g_rc_st 0 code
  put g_rc_st 1 4294967295
  put g_rc_st 2 4
  put g_rc_st 3 in_off
  put g_rc_st 4 plen
  for i ulong n bound 100000000
    rc = tc_rc_dec_sym add lo i i k
    if ne rc TC_OK
      ret rc
    end
  end
  if ne get g_rc_st 0 0
    ret TC_E_CORRUPT
  end
  if ne get g_rc_st 2 plen
    ret TC_E_TRAIL
  end
  ret TC_OK
end

fn tc_ra_row_cum qoff ulong k ulong s ulong to int
  tot = ulong 0
  c = ulong 0
  for x ulong k bound 16
    v = ulong get g_ps_q add qoff x
    if eq v 0
      ret TC_E_ZERO
    end
    if eq x s
      c = tot
    end
    tot = add tot v
  end
  if ne tot TY_QONE
    ret TC_E_NORM
  end
  put g_ra_st 0 c
  ret TC_OK
end

fn tc_ra_enc_sym t ulong k ulong to int
  qoff = mul t k
  s = ulong get g_sy t
  if ge s k
    ret TC_E_SYMBOL
  end
  rc = tc_ra_row_cum qoff k s
  if ne rc TC_OK
    ret rc
  end
  c = get g_ra_st 0
  f = ulong get g_ps_q add qoff s
  xmax = mul 32768 f
  x = get g_ra_st 1
  p = get g_ra_st 2
  while ge x xmax bound 2
    p = sub p 1
    put g_cb p uchar and x 255
    x = shr x 8
  end
  x = add add shl div x f 16 rem x f c
  put g_ra_st 1 x
  put g_ra_st 2 p
  ret TC_OK
end

fn tc_ra_finish out_off ulong cap ulong to void
  x = get g_ra_st 1
  p = sub get g_ra_st 2 4
  put g_cb p uchar and x 255
  put g_cb add p 1 uchar and shr x 8 255
  put g_cb add p 2 uchar and shr x 16 255
  put g_cb add p 3 uchar and shr x 24 255
  nb = sub cap p
  for j ulong nb bound 100000000
    put g_cb add out_off j get g_cb add p j
  end
  put g_cb_plen 0 nb
end

fn tc_rans_encode_raw lo ulong n ulong k ulong out_off ulong to int
  need = add add out_off mul n 2 64
  if not ensure_cb need
    ret TC_E_IO
  end
  cap = get g_cb_cap 0
  put g_ra_st 1 TC_RANS_L
  put g_ra_st 2 cap
  i = n
  while gt i 0 bound 100000000
    i = sub i 1
    rc = tc_ra_enc_sym add lo i k
    if ne rc TC_OK
      ret rc
    end
  end
  tc_ra_finish out_off cap
  ret TC_OK
end

fn tc_ra_dec_renorm to int
  x = get g_ra_st 1
  pos = get g_ra_st 2
  in_off = get g_ra_st 3
  plen = get g_ra_st 4
  while lt x TC_RANS_L bound 2
    if ge pos plen
      ret TC_E_TRUNC
    end
    x = or shl x 8 ulong get g_cb add in_off pos
    pos = add pos 1
  end
  put g_ra_st 1 x
  put g_ra_st 2 pos
  ret TC_OK
end

fn tc_ra_dec_sym t ulong i ulong k ulong to int
  x = get g_ra_st 1
  m = and x 65535
  qoff = mul t k
  s = k
  cum = ulong 0
  tot = ulong 0
  for y ulong k bound 16
    v = ulong get g_ps_q add qoff y
    if eq v 0
      ret TC_E_ZERO
    end
    if eq s k
      if lt m add tot v
        s = y
        cum = tot
      end
    end
    tot = add tot v
  end
  if or ne tot TY_QONE eq s k
    ret TC_E_NORM
  end
  put g_dsy i uchar s
  f = ulong get g_ps_q add qoff s
  x = sub add mul f shr x 16 m cum
  put g_ra_st 1 x
  ret tc_ra_dec_renorm
end

fn tc_rans_decode_raw lo ulong n ulong k ulong in_off ulong plen ulong to int
  if lt plen 4
    ret TC_E_TRUNC
  end
  b0 = ulong get g_cb in_off
  b1 = ulong get g_cb add in_off 1
  b2 = ulong get g_cb add in_off 2
  b3 = ulong get g_cb add in_off 3
  x = or or b0 shl b1 8 or shl b2 16 shl b3 24
  if or lt x TC_RANS_L ge x TC_RANS_MAX
    ret TC_E_CORRUPT
  end
  put g_ra_st 1 x
  put g_ra_st 2 4
  put g_ra_st 3 in_off
  put g_ra_st 4 plen
  for i ulong n bound 100000000
    rc = tc_ra_dec_sym add lo i i k
    if ne rc TC_OK
      ret rc
    end
  end
  if ne get g_ra_st 1 TC_RANS_L
    ret TC_E_CORRUPT
  end
  if ne get g_ra_st 2 plen
    ret TC_E_TRAIL
  end
  ret TC_OK
end

fn tc_range_encode to int
  rc = tc_pair_check
  if ne rc TC_OK
    ret rc
  end
  rc2 = tc_range_encode_raw 0 get g_ps_n 0 get g_ps_k 0 TC_CODED_HEADER
  if ne rc2 TC_OK
    ret rc2
  end
  pn = get g_cb_plen 0
  tc_coded_hdr_write TC_RANGE_ID pn
  put g_cb_len 0 add TC_CODED_HEADER pn
  ret TC_OK
end

fn tc_range_decode clen ulong to int
  rc = tc_coded_hdr_check TC_RANGE_ID clen
  if ne rc TC_OK
    ret rc
  end
  k = get g_ps_k 0
  n = get g_ps_n 0
  put g_dsy_k 0 k
  put g_dsy_n 0 n
  for i ulong 32
    put g_dsy_dat i get g_ps_dat i
  end
  ret tc_range_decode_raw 0 n k TC_CODED_HEADER get g_cb_plen 0
end

fn tc_rans_encode to int
  rc = tc_pair_check
  if ne rc TC_OK
    ret rc
  end
  rc2 = tc_rans_encode_raw 0 get g_ps_n 0 get g_ps_k 0 TC_CODED_HEADER
  if ne rc2 TC_OK
    ret rc2
  end
  pn = get g_cb_plen 0
  tc_coded_hdr_write TC_RANS_ID pn
  put g_cb_len 0 add TC_CODED_HEADER pn
  ret TC_OK
end

fn tc_rans_decode clen ulong to int
  rc = tc_coded_hdr_check TC_RANS_ID clen
  if ne rc TC_OK
    ret rc
  end
  k = get g_ps_k 0
  n = get g_ps_n 0
  put g_dsy_k 0 k
  put g_dsy_n 0 n
  for i ulong 32
    put g_dsy_dat i get g_ps_dat i
  end
  ret tc_rans_decode_raw 0 n k TC_CODED_HEADER get g_cb_plen 0
end

note ================================================================
note Experiment selection, CLI, Notebook, Freeze Checks
note ================================================================

fn exp_select to bool
  en = envcnt
  if lt en 0
    en = 0
  end
  found = false
  val = new uchar 64 0
  vl = ulong 0
  tmp = new uchar 256 0
  for i ulong ulong en bound 4096
    k = envread i tmp 0 256
    if gt k 7
      ku = ulong k
      sa_set tmp 0 6
      if sa_eq t_env_expid 0 6
        if eq get tmp 6 uchar 61
          vl = sub ku 7
          if gt vl 63
            vl = 63
          end
          for j ulong vl bound 64
            put val j get tmp add 7 j
          end
          found = true
          break
        end
      end
    end
  end
  is_1r = false
  if and found gt vl 0
    if sl_eq val vl t_exp_001r
      is_1r = true
    else
      if not sl_eq val vl t_exp_001
        ign = write 2 t_err_unk_exp 0 len t_err_unk_exp
        ret false
      end
    end
  end
  if is_1r
    for i ulong len t_exp_001r bound 16
      put g_exp i get t_exp_001r i
    end
    put g_exp_l 0 len t_exp_001r
    for i ulong len t_prof_11 bound 32
      put g_profid i get t_prof_11 i
    end
    put g_profid_l 0 len t_prof_11
  else
    for i ulong len t_exp_001 bound 16
      put g_exp i get t_exp_001 i
    end
    put g_exp_l 0 len t_exp_001
    for i ulong len t_prof_10 bound 32
      put g_profid i get t_prof_10 i
    end
    put g_profid_l 0 len t_prof_10
  end
  ob_set_fd int -1
  ob_txt t_exp_dir_pfx
  ob_g_exp
  edl = get g_olen 0
  for i ulong edl bound 64
    put g_expdir i get g_obuf i
  end
  put g_expdir_l 0 edl
  put g_olen 0 0
  ob_txt t_prof_dir_pfx
  for i ulong get g_profid_l 0 bound 32
      ob_b get g_profid i
    end
  ob_txt t_dot_toml
  pl = get g_olen 0
  for i ulong pl bound 128
    put g_prof i get g_obuf i
  end
  put g_prof_l 0 pl
  put g_olen 0 0
  ob_txt t_prof_dir_pfx
  for i ulong get g_profid_l 0 bound 32
      ob_b get g_profid i
    end
  ob_txt t_dot_sha256
  sl = get g_olen 0
  for i ulong sl bound 128
    put g_side i get g_obuf i
  end
  put g_side_l 0 sl
  put g_olen 0 0
  ret true
end

fn load_args to ulong
  ac = argcnt
  if lt ac 0
    ret 0
  end
  n = ulong ac
  if gt n 1024
    n = 1024
  end
  ign = ensure_args mul n 4096
  tmp = new uchar 4096 0
  for i ulong n bound 1024
    k = argread i tmp 0 4096
    if lt k 0
      put g_alen i 0
    else
      ku = ulong k
      put g_alen i ku
      off = mul i 4096
      for j ulong ku bound 4096
        put g_args add off j get tmp j
      end
    end
  end
  put g_argc 0 n
  ret n
end

fn arg_is idx ulong s view uchar * to bool
  al = get g_alen idx
  if ne al len s
    ret false
  end
  off = mul idx 4096
  for i ulong al bound 4096
    if ne get g_args add off i get s i
      ret false
    end
  end
  ret true
end

fn copy_arg_g idx ulong cap ulong to ulong
  al = get g_alen idx
  if ge al cap
    al = sub cap 1
  end
  off = mul idx 4096
  for i ulong al bound 4096
    put g_arg_tmp i get g_args add off i
  end
  ret al
end

fn copy_arg_to idx ulong dst edit uchar * cap ulong to ulong
  al = get g_alen idx
  if ge al cap
    al = sub cap 1
  end
  off = mul idx 4096
  for i ulong al bound 4096
    put dst i get g_args add off i
  end
  ret al
end

fn sealed_seed com view uchar * pdig view uchar * g ulong j ulong to long
  ob_set_fd int -1
  ob_txt t_sealed_pfx
  ob_slice com 0 40
  ob_b uchar 124
  ob_slice pdig 0 64
  ob_txt t_s74
  ob_u64 g
  ob_b uchar 124
  ob_u64 j
  ml = get g_olen 0
  sh_init
  sh_slice_obuf ml
  sh_final 114
  put g_olen 0 0
  o = ulong 3648
  v = ulong 0
  for i ulong 8
    v = or shl v 8 ulong get g_dig add o i
  end
  ret long and v 0x7fffffffffffffff
end
fn sealed_seed_ds g ulong j ulong to long
  tmp_c = new uchar 40 0
  tmp_p = new uchar 64 0
  for i ulong 40
    put tmp_c i get g_ds_com i
  end
  for i ulong 64
    put tmp_p i get g_prof_sha i
  end
  ret sealed_seed tmp_c tmp_p g j
end

fn git_pkt_2 arg1 view uchar * arg2 view uchar * to ulong
  pos = pkt_init 5
  pos = pkt_push pos t_git_bin 0 len t_git_bin
  pos = pkt_push pos t_git_C 0 len t_git_C
  pos = pkt_push_g_repo pos
  pos = pkt_push pos arg1 0 len arg1
  pos = pkt_push pos arg2 0 len arg2
  ret pos
end



fn read_proc_line path view uchar * dst edit uchar * cap ulong to ulong
  fd = fopen path 0 len path int 0 int 0
  if lt fd 0
    ret 0
  end
  r = read int fd dst 0 sub cap 1
  ic = fclose int fd
  if le r 0
    ret 0
  end
  n = ulong r
  while gt n 0 bound 256
    ch = get dst sub n 1
    if or eq ch 10 eq ch 13
      n = sub n 1
    else
      break
    end
  end
  ret n
end

fn nb_git_meta to void
  if or ne run_capture_pkt git_pkt_2 t_git_cfg t_git_un 0 eq get g_cap_len 0 0
    for i ulong len t_unknown bound 128
      put g_nb_op i get t_unknown i
    end
    put g_nb_opl 0 len t_unknown
  else
    cl = get g_cap_len 0
    if gt cl 127
      cl = 127
    end
    for i ulong cl bound 128
      put g_nb_op i get g_cap_buf i
    end
    put g_nb_opl 0 cl
  end
  if or ne run_capture_pkt git_pkt_2 t_git_rp t_git_head 0 ne get g_cap_len 0 40
    for i ulong len t_unknown bound 64
      put g_nb_com i get t_unknown i
    end
    put g_nb_cl 0 len t_unknown
  else
    for i ulong 40
      put g_nb_com i get g_cap_buf i
    end
    put g_nb_cl 0 40
  end
end

fn nb_git_dirty to void
  dirty = long -1
  if eq run_capture_pkt git_pkt_2 t_git_st t_git_porc 0
    dirty = 1
    if eq get g_cap_len 0 0
      dirty = 0
    end
  end
  if ne run_capture_pkt git_pkt_2 t_git_rp t_git_top 0
    put g_nb_dirty 0 -1
    ret
  end
  rr = new uchar 4096 0
  rt = new uchar 4096 0
  tmp = new uchar 4096 0
  for i ulong get g_repo_l 0 bound 4096
    put tmp i get g_repo i
  end
  lrr = om_realpath tmp get g_repo_l 0 rr
  cl = get g_cap_len 0
  if gt cl 4095
    cl = 4095
  end
  for i ulong cl bound 4096
    put tmp i get g_cap_buf i
  end
  lrt = om_realpath tmp cl rt
  sa_set rr 0 lrr
  if or eq lrr 0 or eq lrt 0 not sa_eq rt 0 lrt
    dirty = -1
  end
  put g_nb_dirty 0 dirty
end

fn nb_sys_meta to void
  tmp = new uchar 256 0
  hl = read_proc_line t_proc_host tmp 256
  for i ulong hl bound 256
    put g_nb_host i get tmp i
  end
  if eq hl 0
    for i ulong len t_unknown bound 64
      put g_nb_host i get t_unknown i
    end
    hl = len t_unknown
  end
  put g_nb_hl 0 hl
  os_b = new uchar 64 0
  rl_b = new uchar 64 0
  osl = read_proc_line t_proc_os os_b 64
  rll = read_proc_line t_proc_rel rl_b 64
  if or eq osl 0 eq rll 0
    for i ulong len t_unknown bound 64
      put g_nb_kern i get t_unknown i
    end
    put g_nb_kl 0 len t_unknown
    ret
  end
  ob_set_fd int -1
  ob_slice os_b 0 osl
  ob_b uchar 32
  ob_slice rl_b 0 rll
  ob_b uchar 32
  ob_txt t_aarch64
  osl = get g_olen 0
  if gt osl 127
    osl = 127
  end
  for i ulong osl bound 128
    put g_nb_kern i get g_obuf i
  end
  put g_nb_kl 0 osl
  put g_olen 0 0
end

fn notebook_of to void
  nb_git_meta
  nb_git_dirty
  nb_sys_meta
  jclean_nb
end

fn root_hash_one i ulong to bool
  p = new uchar 4096 0
  hb = new uchar 64 0
  rl = get g_rllen i
  ro = mul i 96
  for j ulong rl bound 96
    put g_p2 j get g_rlines add ro j
  end
  pj_set_g_out
  pl = pj_make_g_p2 rl p
  if eq pl 0
    ret false
  end
  if not sha_file_hex p pl hb 113
    ret false
  end
  ob_set_fd int -1
  ob_slice hb 0 64
  ob_b uchar 32
  ob_b uchar 32
  for j ulong rl bound 4096
    ob_b get g_p2 j
  end
  ob_b uchar 10
  pl = get g_olen 0
  ro = mul i 256
  for j ulong pl bound 256
    put g_lbuf add ro j get g_obuf j
  end
  put g_alen i pl
  put g_olen 0 0
  ret true
end

fn root_swap a ulong b ulong to void
  mx = get g_alen a
  if gt get g_alen b mx
    mx = get g_alen b
  end
  oa = mul a 256
  ob = mul b 256
  for j ulong mx bound 256
    tv = get g_lbuf add oa j
    put g_lbuf add oa j get g_lbuf add ob j
    put g_lbuf add ob j tv
  end
  oa = get g_alen a
  put g_alen a get g_alen b
  put g_alen b oa
end

fn root_of_out n ulong dst edit uchar * slot ulong to bool
  for i ulong n bound 64
    if not root_hash_one i
      ret false
    end
  end
  for i ulong n bound 64
    if gt i 0
      k = i
      while gt k 0 bound 64
        la = get g_alen sub k 1
        lb = get g_alen k
        sa_set_lbuf mul sub k 1 256 la
        if le sa_cmp_g_lbuf mul k 256 lb 0
          break
        end
        root_swap sub k 1 k
        k = sub k 1
      end
    end
  end
  sh_init
  for i ulong n bound 64
    sh_slice_lbuf mul i 256 get g_alen i
  end
  sh_final slot
  dg_to_hex slot dst 0
  ret true
end

fn set_rline idx ulong s view uchar * to void
  l = len s
  ro = mul idx 96
  for i ulong l bound 96
    put g_rlines add ro i get s i
  end
  put g_rllen idx l
end

fn under_forbidden path view uchar * plen ulong to bool
  rr = new uchar 4096 0
  rp = new uchar 4096 0
  forb = new uchar 4096 0
  tmp_rp = new uchar 4096 0
  for i_r ulong get g_repo_l 0 bound 4096
    put tmp_rp i_r get g_repo i_r
  end
  lrr = om_realpath tmp_rp get g_repo_l 0 rr
  lrp = om_realpath path plen rp
  if or eq lrr 0 eq lrp 0
    ret true
  end
  pj_set rr lrr
  fl = pj_make_g_expdir forb
  if or eq fl 0 lt lrp fl
    ret false
  end
  sa_set rp 0 fl
  if not sa_eq forb 0 fl
    ret false
  end
  if eq lrp fl
    ret true
  end
  ret eq get rp fl uchar 47
end

fn cand_index nm view uchar * nl ulong to long
  nc = get g_nc 0
  for i ulong nc bound 64
    cl = get g_c_nlen i
    sa_set_c_name i
    if sa_eq nm 0 nl
      ret long i
    end
  end
  ret -1
end

fn cand_index_txt nm view uchar * to long
  ret cand_index nm len nm
end

note ================================================================
note Parse candidate_manifest, dataset_manifest, cmd_run helpers
note ================================================================

fn parse_cand_bg_verify loff ulong k0 ulong kl ulong v0 ulong to long
  val = new uchar 64 0
  for i ulong 64
    put val i get g_slurp add loff add v0 i
  end
  if not is_hex64 val 64
    ret 0
  end
  rel = new uchar 4096 0
  for i ulong kl bound 4096
    put rel i get g_slurp add loff add k0 i
  end
  fp = new uchar 4096 0
  pj_set_g_repo
  v0 = pj_make rel kl fp
  if or eq v0 0 not sha_file_hex fp v0 rel 112
    ret -1
  end
  sa_set rel 0 64
  if not sa_eq val 0 64
    ret -1
  end
  ret 1
end

fn parse_cand_bg_line loff ulong ll ulong to long
  q1 = long -1
  for i ulong ll bound 8192
    if eq get g_slurp add loff i uchar 34
      q1 = long i
      break
    end
  end
  if lt q1 0
    ret 0
  end
  p = add ulong q1 1
  k0 = p
  while lt p ll bound 4096
    if eq get g_slurp add loff p uchar 34
      break
    end
    p = add p 1
  end
  if or ge p ll eq sub p k0 0
    ret 0
  end
  kl = sub p k0
  p = add p 1
  if ge add p 3 ll
    ret 0
  end
  if ne get g_slurp add loff p uchar 58
    ret 0
  end
  if ne get g_slurp add loff add p 1 uchar 32
    ret 0
  end
  if ne get g_slurp add loff add p 2 uchar 34
    ret 0
  end
  p = add p 3
  if gt add p 64 ll
    ret 0
  end
  if ne get g_slurp add loff add p 64 uchar 34
    ret 0
  end
  ret parse_cand_bg_verify loff k0 kl p
end

fn only_match_at i ulong pat view uchar * pl ulong to bool
  for j ulong pl bound 128
    if ne get g_obuf add i j get pat j
      ret false
    end
  end
  ret true
end

fn only_matches nm view uchar * nl ulong to bool
  ol = get g_only_l 0
  if eq ol 0
    ret true
  end
  ob_set_fd int -1
  ob_b uchar 44
  for i ulong ol bound 1024
    ob_b get g_only i
  end
  ob_b uchar 44
  hl = get g_olen 0
  put g_olen 0 0
  pat = new uchar 128 0
  put pat 0 uchar 44
  for i ulong nl bound 64
    put pat add 1 i get nm i
  end
  put pat add 1 nl uchar 44
  ol = add nl 2
  if lt hl ol
    ret false
  end
  hl = add sub hl ol 1
  for i ulong hl bound 2048
    if only_match_at i pat ol
      ret true
    end
  end
  ret false
end

fn parse_cand_store_hashes nc ulong loff ulong ll ulong to bool
  tmp = new uchar 64 0
  if ne jstr_slurp loff ll t_k_fsha tmp 64
    ret false
  end
  for i ulong 64
    put g_c_fsha add mul nc 64 i get tmp i
  end
  if ne jstr_slurp loff ll t_k_mdig tmp 64
    ret false
  end
  for i ulong 64
    put g_c_mdig add mul nc 64 i get tmp i
  end
  ret true
end

fn parse_cand_store_name nc ulong nm view uchar * nml ulong to void
  put g_c_nlen nc nml
  co = mul nc 64
  for i ulong nml bound 64
    put g_c_name add co i get nm i
  end
end

fn parse_cand_store_file nc ulong fl view uchar * fll ulong to void
  put g_c_flen nc fll
  co = mul nc 128
  for i ulong fll bound 128
    put g_c_file add co i get fl i
  end
end

fn parse_cand_line loff ulong ll ulong to int
  nc = get g_nc 0
  if ge nc MAXC
    ret refuse_txt t_s75 t_s76 t_s77
  end
  nm = new uchar 64 0
  fl = new uchar 128 0
  nml = jstr_slurp loff ll t_k_name nm
  fll = jstr_slurp loff ll t_k_file fl
  lmb = jint_slurp loff ll t_k_lmb
  if or lt nml 0 or lt fll 0 ne get g_ty_ret_i 0 0
    ret refuse_txt t_s75 t_s76 t_s78
  end
  if not parse_cand_store_hashes nc loff ll
    ret refuse_txt t_s75 t_s76 t_s78
  end
  if not only_matches nm ulong nml
    ret 0
  end
  parse_cand_store_name nc nm ulong nml
  parse_cand_store_file nc fl ulong fll
  put g_c_lm nc lmb
  put g_nc 0 add nc 1
  ret 0
end

fn is_brace_close_line ls ulong ll ulong to bool
  has_br = false
  has_co = false
  for i ulong ll bound 8192
    ch = get g_slurp add ls i
    if eq ch 125
      has_br = true
    end
    if eq ch 58
      has_co = true
    end
  end
  ret and has_br not has_co
end

fn parse_cand_manifest_line ls ulong ll ulong sect ulong to long
  if sl_has_slurp ls ll t_sect_bg
    ret 10
  end
  if sl_has_slurp ls ll t_sect_rt
    ret 20
  end
  if and ne sect 0 is_brace_close_line ls ll
    ret 0
  end
  if and sl_has_slurp ls ll t_pat_name sl_has_slurp ls ll t_pat_mdig
    if ne parse_cand_line ls ll 0
      ret -2
    end
    ret long mul sect 10
  end
  if eq sect 1
    bgr = parse_cand_bg_line ls ll
    if lt bgr 0
      _ign = refuse_txt t_s79 t_s80 t_s81
      ret -2
    end
    if gt bgr 0
      ret 11
    end
    ret 10
  end
  if eq sect 2
    ret 22
  end
  ret long mul sect 10
end

fn parse_candidate_manifest m_eval edit uchar * me_l edit ulong * to int
  tl = get g_slurp_len 0
  sect = ulong 0
  n_bg = ulong 0
  put g_nc 0 0
  pos = ulong 0
  while lt pos tl bound 1000000
    ls = pos
    while lt pos tl bound 8192
      if eq get g_slurp pos uchar 10
        break
      end
      pos = add pos 1
    end
    ll = sub pos ls
    if lt pos tl
      pos = add pos 1
    end
    st = parse_cand_manifest_line ls ll sect
    if lt st 0
      ret 2
    end
    sect = div ulong st 10
    if eq rem ulong st 10 1
      n_bg = add n_bg 1
    end
    if eq rem ulong st 10 2
      bgr = jstr_slurp ls ll t_k_tceval m_eval
      if ge bgr 0
        put me_l 0 ulong bgr
      end
    end
  end
  if eq n_bg 0
    ret refuse_txt t_s75 t_s76 t_s82
  end
  ret 0
end

fn parse_ds_store_path_sha nf ulong loff ulong ll ulong to int
  sh = new uchar 64 0
  fp = new uchar 4096 0
  sha_l = jstr_slurp loff ll t_k_sha sh
  fpl = jstr_slurp loff ll t_k_path fp
  if or ne sha_l 64 le fpl 0
    ret refuse_txt t_s83 t_s76 t_s85
  end
  co = mul nf 64
  for i ulong 64
    put g_f_sha add co i get sh i
  end
  put g_f_plen nf ulong fpl
  co = mul nf 4096
  for i ulong ulong fpl bound 4096
    put g_f_path add co i get fp i
  end
  ret 0
end

fn parse_ds_file_line loff ulong ll ulong to int
  nf = get g_nf 0
  if ge nf MAXF
    ret refuse_txt t_s83 t_s76 t_s84
  end
  g = jint_slurp loff ll t_k_grp
  if or ne get g_ty_ret_i 0 0 and ne g 1 ne g 2
    ret refuse_txt t_s83 t_s76 t_s85
  end
  j = jint_slurp loff ll t_k_idx
  if ne get g_ty_ret_i 0 0
    ret refuse_txt t_s83 t_s76 t_s85
  end
  sd = jint_slurp loff ll t_k_seed
  if ne get g_ty_ret_i 0 0
    ret refuse_txt t_s83 t_s76 t_s85
  end
  by = jint_slurp loff ll t_k_bytes
  if ne get g_ty_ret_i 0 0
    ret refuse_txt t_s83 t_s76 t_s85
  end
  if ne parse_ds_store_path_sha nf loff ll 0
    ret 2
  end
  put g_f_g nf ulong g
  put g_f_j nf ulong j
  put g_f_seed nf sd
  put g_f_bytes nf by
  ob_set_fd int -1
  ob_i64 g
  ob_b uchar 32
  ob_i64 j
  ob_b uchar 32
  ob_i64 sd
  ob_b uchar 32
  for i ulong 64
    ob_b get g_f_sha add mul nf 64 i
  end
  ob_b uchar 32
  ob_i64 by
  ob_b uchar 10
  sh_slice_obuf get g_olen 0
  put g_olen 0 0
  put g_nf 0 add nf 1
  ret 0
end

fn parse_dataset_files to int
  tl = get g_slurp_len 0
  put g_nf 0 0
  sh_init
  pos = ulong 0
  while lt pos tl bound 1000000
    ls = pos
    while lt pos tl bound 8192
      if eq get g_slurp pos uchar 10
        break
      end
      pos = add pos 1
    end
    ll = sub pos ls
    if lt pos tl
      pos = add pos 1
    end
    if and sl_has_slurp ls ll t_pat_grp sl_has_slurp ls ll t_pat_sha
      rc = parse_ds_file_line ls ll
      if ne rc 0
        ret rc
      end
    end
  end
  sh_final 111
  calc = new uchar 64 0
  dg_to_hex 111 calc 0
  sa_set calc 0 64
  if not sa_eq_g_ds_pay
    ret refuse_txt t_s83 t_s86 t_s87
  end
  nf = get g_nf 0
  if eq nf 0
    ret refuse_txt t_s83 t_s76 t_s88
  end
  for i ulong nf bound 64
    if gt i 0
      cg = get g_f_g i
      pg = get g_f_g sub i 1
      cj = get g_f_j i
      pj = get g_f_j sub i 1
      if or lt cg pg and eq cg pg ne cj add pj 1
        ret refuse_txt t_s83 t_s76 t_s89
      end
    end
  end
  if or ne get g_f_g 0 1 ne get g_f_g sub nf 1 2
    ret refuse_txt t_s83 t_s76 t_s88
  end
  ret 0
end

fn parse_run_arg_cdir ni ulong to int
  ncd = get g_ncd 0
  if ge ncd 32
    ret refuse_txt t_s90 t_s91 t_s93
  end
  cl = get g_alen ni
  if ge cl 4096
    cl = 4095
  end
  co = mul ncd 4096
  off = mul ni 4096
  for j ulong cl bound 4096
    put g_cdirs add co j get g_args add off j
  end
  put g_cdlen ncd cl
  put g_ncd 0 add ncd 1
  ret 0
end

fn parse_run_arg_pair i ulong ni ulong to int
  if arg_is i t_f_repo
    cal = copy_arg_g ni 4096
    put g_repo_l 0 cal
    for j ulong cal bound 4096
      put g_repo j get g_arg_tmp j
    end
    ret 0
  end
  if arg_is i t_f_man
    cal = copy_arg_g ni 4096
    put g_man_pl 0 cal
    for j ulong cal bound 4096
      put g_man_p j get g_arg_tmp j
    end
    ret 0
  end
  if arg_is i t_f_ds
    cal = copy_arg_g ni 4096
    put g_ds_pl 0 cal
    for j ulong cal bound 4096
      put g_ds_p j get g_arg_tmp j
    end
    ret 0
  end
  if arg_is i t_f_ov
    cal = copy_arg_g ni 4096
    put g_ov_pl 0 cal
    for j ulong cal bound 4096
      put g_ov_p j get g_arg_tmp j
    end
    ret 0
  end
  if arg_is i t_f_out
    cal = copy_arg_g ni 4096
    put g_out_l 0 cal
    for j ulong cal bound 4096
      put g_out j get g_arg_tmp j
    end
    ret 0
  end
  if arg_is i t_f_work
    cal = copy_arg_g ni 4096
    put g_work_l 0 cal
    for j ulong cal bound 4096
      put g_work j get g_arg_tmp j
    end
    ret 0
  end
  if arg_is i t_f_only
    cal = copy_arg_g ni 1024
    put g_only_l 0 cal
    for j ulong cal bound 1024
      put g_only j get g_arg_tmp j
    end
    ret 0
  end
  if arg_is i t_f_cdir
    ret parse_run_arg_cdir ni
  end
  ret refuse_txt t_s90 t_s91 t_s94
end

fn parse_run_args ac ulong to int
  put g_ncd 0 0
  put g_man_pl 0 0
  put g_ds_pl 0 0
  put g_ov_pl 0 0
  i = ulong 2
  while lt i ac bound 1024
    if arg_is i t_f_dry
      put g_dry 0 1
      i = add i 1
    else
      if ge add i 1 ac
        ret refuse_txt t_s90 t_s91 t_s92
      end
      if ne parse_run_arg_pair i add i 1 0
        ret 2
      end
      i = add i 2
    end
  end
  ret 0
end

fn record_cmd_str ac ulong to void
  ob_set_fd int -1
  for i ulong ac bound 1024
    if gt i 0
      ob_b uchar 32
    end
    al = get g_alen i
    off = mul i 4096
    for j ulong al bound 4096
      if ge get g_olen 0 4094
        break
      end
      ob_b get g_args add off j
    end
  end
  cl = get g_olen 0
  if gt cl 4095
    cl = 4095
  end
  for i ulong cl bound 4096
    put g_cmd i get g_obuf i
  end
  put g_cmd_l 0 cl
  put g_olen 0 0
  jclean_g_cmd uchar 39
end

fn ob_gp_sha slot ulong to void
  h = new uchar 64 0
  if sha_gp slot
    for i ulong 64
      put h i get g_hex_tmp i
    end
    ob_slice h 0 64
  else
    ob_txt t_unread
  end
end

fn record_cmd_and_inputs ac ulong to void
  record_cmd_str ac
  hs = new uchar 64 0
  ob_set_fd int -1
  ob_txt t_s95
  if sha_file_hex t_self_exe len t_self_exe hs 110
    ob_slice hs 0 64
  else
    ob_txt t_unread
  end
  ob_txt t_s96
  if eq get g_man_pl 0 0
    ob_txt t_none
  else
    set_gp_g_man get g_man_pl 0
    ob_gp_sha 110
  end
  ob_txt t_s97
  if eq get g_ds_pl 0 0
    ob_txt t_none
  else
    set_gp_g_ds get g_ds_pl 0
    ob_gp_sha 110
  end
  ob_txt t_s98
  if eq get g_ov_pl 0 0
    ob_txt t_none
  else
    set_gp_g_ov get g_ov_pl 0
    ob_gp_sha 110
  end
  il = get g_olen 0
  if gt il 1023
    il = 1023
  end
  for i ulong il bound 1024

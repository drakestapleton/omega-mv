fn ensure_ps_n need ulong k ulong to bool
  cap = get g_ps_n_cap 0
  if gt need cap
    nc = ulong 4096
    if gt cap 0
      nc = cap
    end
    while lt nc need bound 64
      nc = mul nc 2

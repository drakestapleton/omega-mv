  p = new uchar 4096 0
  pj_set_g_out
  pl = pj_make name nl p
  if eq pl 0
    ret -1
  end
  ret long fopen p 0 pl int 193 420
end

fn write_crit_json nm_i ulong crit view uchar * to void
  if eq nm_i 1
    ob_txt t_s0
  end
  if eq nm_i 2
    ob_txt t_s1
  end
  if eq nm_i 3
    ob_txt t_s2
  end
  if eq nm_i 4
    ob_txt t_s3
  end
  if eq nm_i 5
    ob_txt t_s4
  end
  if eq nm_i 6
    ob_txt t_s5
  end
  if eq nm_i 7
    ob_txt t_s6
  end
  if eq nm_i 8
    ob_txt t_s7
  end
  if eq nm_i 9
    ob_txt t_s8
  end
  ob_txt crit
  ob_txt t_s9
end

fn set_fmsg msg view uchar * ml ulong to void
  cm = ml
  if gt cm 1023
    cm = 1023

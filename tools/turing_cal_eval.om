  end
  lim = add sub hl nl 1
  for i ulong lim bound 10000000
    ok = true
    for j ulong nl bound 4096
      ch = get g_rep add add ho i j
      cn = get ned j
      if ne ch cn
        ok = false
        break
      end
    end
    if ok
      ret long i
    end
  end
  ret -1
end


fn is_hex40 buf view uchar * l ulong to bool
  if ne l 40
    ret false
  end
  for i ulong 40
    c = get buf i
    ok = or and ge c 48 le c 57 and ge c 97 le c 102
    if not ok
      ret false
    end
  end
  ret true
end

fn is_hex64 buf view uchar * l ulong to bool
  if ne l 64
    ret false
  end
  for i ulong 64
    c = get buf i
    ok = or and ge c 48 le c 57 and ge c 97 le c 102
    if not ok
      ret false
    end
  end
  ret true
end


fn jclean_g_fmsg rep uchar to void
  n = get g_fmsgl 0
  for i ulong n bound 1024
    c = get g_fmsg i
    if or eq c 34 or eq c 92 lt c 32
      put g_fmsg i rep
    end
  end
end
fn jclean_g_cmd rep uchar to void
  n = get g_cmd_l 0
  for i ulong n bound 4096
    c = get g_cmd i
    if or eq c 34 or eq c 92 lt c 32
      put g_cmd i rep
    end
  end
end
fn jclean_nb to void
  for i ulong get g_nb_opl 0 bound 128
    c = get g_nb_op i
    if or eq c 34 or eq c 92 lt c 32
      put g_nb_op i uchar 95
    end
  end
  for i ulong get g_nb_hl 0 bound 256
    c = get g_nb_host i
    if or eq c 34 or eq c 92 lt c 32
      put g_nb_host i uchar 95
    end
  end
  for i ulong get g_nb_kl 0 bound 128
    c = get g_nb_kern i
    if or eq c 34 or eq c 92 lt c 32
      put g_nb_kern i uchar 95
    end
  end
end

fn jclean_buf buf edit uchar * n ulong rep uchar to void
  for i ulong n bound 8192
    c = get buf i
    if or eq c 34 or eq c 92 lt c 32
      put buf i rep
    end
  end
end

note ================================================================
note Dynamic Pool Ensure Helpers
note ================================================================

fn ensure_args need ulong to bool
  cap = get g_args_cap 0
  if le need cap
    ret true
  end
  nc = ulong 1024
  if gt cap 0
    nc = cap
  end
  while lt nc need bound 64
    nc = mul nc 2
  end
  rc = enlarge g_args nc
  if ne rc 0
    ret false
  end
  put g_args_cap 0 nc
  ret true
end


fn freeze_check_ov_anc to int
  if eq get g_ov_l 0 0
    ret refuse_txt t_s99 t_s100 t_s101
  end
  set_gp_g_ov_s get g_ov_l 0
  if not slurp_gp
    ret refuse_txt t_s99 t_s100 t_s102
  end
  tmp = new uchar 64 0
  nl = jtop_slurp t_k_res tmp 16
  if or lt nl 0 not sl_eq tmp ulong nl t_pass
    ret s2_fail_txt t_s99 t_s100 t_s103
  end
  nl = jtop_slurp t_k_fc tmp 64
  sa_set tmp 0 40
  if or ne nl 40 not sa_eq_g_ds_com
    ret refuse_txt t_s99 t_s104 t_s105
  end
  for i ulong get g_ds_com_l 0 bound 64
    put tmp i get g_ds_com i
  end
  if not is_hex40 tmp get g_ds_com_l 0
    ret refuse_txt t_s99 t_s104 t_s106
  end
  ret 0
end

fn freeze_check_git_anc to int
  pl = git_pkt_2 t_git_rp t_git_om
  if or ne run_capture_pkt pl 0 ne get g_cap_len 0 40
    ret refuse_txt t_s99 t_s104 t_s107
  end
  for i ulong 40
    put g_orig_main i get g_cap_buf i
  end
  put g_orig_ml 0 40
  pl = pkt_init 7
  pl = pkt_push pl t_git_bin 0 len t_git_bin
  pl = pkt_push pl t_git_C 0 len t_git_C
  pl = pkt_push_g_repo pl
  pl = pkt_push pl t_git_mb 0 len t_git_mb
  pl = pkt_push pl t_git_anc 0 len t_git_anc
  pl = pkt_push_g_ds_com pl
  pl = pkt_push pl t_git_om_ref 0 len t_git_om_ref
  if ne run_capture_pkt pl 0
    ret refuse_txt t_s99 t_s104 t_s108
  end
  ret 0
end

fn freeze_check_git_show is_man bool to int
  spec = new uchar 256 0
  ob_set_fd int -1
  ob_g_ds_com
  ob_b uchar 58
  if is_man
    for i ulong get g_expdir_l 0 bound 64
      ob_b get g_expdir i
    end
    ob_txt t_rel_cman
  else
    for i ulong get g_prof_l 0 bound 128
      ob_b get g_prof i
    end
  end
  sl = get g_olen 0
  for i ulong sl bound 256
    put spec i get g_obuf i
  end
  put g_olen 0 0
  pl = pkt_init 5
  pl = pkt_push pl t_git_bin 0 len t_git_bin
  pl = pkt_push pl t_git_C 0 len t_git_C
  pl = pkt_push_g_repo pl
  pl = pkt_push pl t_git_show 0 len t_git_show
  pl = pkt_push pl spec 0 sl
  h = new uchar 64 0
  rc = run_sha_pkt pl h 0
  sa_set h 0 64
  if is_man
    if or ne rc 0 not sa_eq_g_man_sha
      ret s2_fail_txt t_s99 t_s104 t_s109
    end
  else
    if or ne rc 0 not sa_eq_g_prof_sha
      ret s2_fail_txt t_s99 t_s104 t_s110
    end
  end
  ret 0
end

fn freeze_check_time_seeds to int
  pl = pkt_init 7
  pl = pkt_push pl t_git_bin 0 len t_git_bin
  pl = pkt_push pl t_git_C 0 len t_git_C
  pl = pkt_push_g_repo pl
  pl = pkt_push pl t_git_show 0 len t_git_show
  pl = pkt_push pl t_git_s 0 len t_git_s
  pl = pkt_push pl t_git_fmt 0 len t_git_fmt
  pl = pkt_push_g_ds_com pl
  if ne run_capture_pkt pl 0
    ret refuse_txt t_s99 t_s104 t_s111
  end
  tmp = new uchar 48 0
  ct = get g_cap_len 0
  for i ulong ct bound 32
    put tmp i get g_cap_buf i
  end
  t_com = parse_dec_n tmp 0 ct
  if lt t_com 0
    ret refuse_txt t_s99 t_s104 t_s111
  end
  for i ulong get g_ds_rel_l 0 bound 40
    put tmp i get g_ds_rel i
  end
  t_rel = utc_epoch tmp get g_ds_rel_l 0
  if lt t_rel 0
    ret refuse_txt t_s99 t_s112 t_s113
  end
  if ge t_com t_rel
    ret s2_fail_txt t_s99 t_s112 t_s114
  end
  for i ulong get g_nf 0 bound 64
    if ne get g_f_seed i sealed_seed_ds get g_f_g i get g_f_j i
      ret s2_fail_txt t_s99 t_s115 t_s116
    end
  end
  ret 0
end

fn check_freeze_order to int
  if ne get g_dry 0 0
    ret 0
  end
  rc = freeze_check_ov_anc
  if ne rc 0
    ret rc
  end
  rc = freeze_check_git_anc
  if ne rc 0
    ret rc
  end
  rc = freeze_check_git_show true
  if ne rc 0
    ret rc
  end
  rc = freeze_check_git_show false
  if ne rc 0
    ret rc
  end
  ret freeze_check_time_seeds
end

note ================================================================
note Scoring Pipeline (per candidate, per file, per crumb)
note ================================================================

fn append_cr_run fi ulong ord ulong lo ulong hi ulong to bool
  u = get g_cr_used 0
  if not ensure_cr add u 1
    ret false
  end
  put g_cr_ord u ord
  put g_cr_lo u lo
  put g_cr_hi u hi
  put g_cr_used 0 add u 1
  put g_f_cr_n fi add get g_f_cr_n fi 1
  ret true
end

fn record_file_crumbs fi ulong to bool
  n = get g_ps_n 0
  put g_f_cr_off fi get g_cr_used 0
  put g_f_cr_n fi 0
  lo = ulong 0
  while lt lo n bound 100000000
    c0 = get g_ps_crumb lo
    hi = add lo 1
    while lt hi n bound 100000000
      if ne get g_ps_crumb hi c0
        break
      end
      hi = add hi 1
    end
    if not append_cr_run fi ulong c0 lo hi
      ret false
    end
    lo = hi
  end
  ret true
end

fn check_file_crumbs fi ulong to bool
  n = get g_ps_n 0
  off = get g_f_cr_off fi
  ncr = get g_f_cr_n fi
  k = ulong 0
  lo = ulong 0
  while lt lo n bound 100000000
    c0 = get g_ps_crumb lo
    hi = add lo 1
    while lt hi n bound 100000000
      if ne get g_ps_crumb hi c0
        break
      end
      hi = add hi 1
    end
    if ge k ncr
      ret false
    end
    if ne ulong c0 get g_cr_ord add off k
      ret false
    end
    if ne lo get g_cr_lo add off k
      ret false
    end
    if ne hi get g_cr_hi add off k
      ret false
    end
    k = add k 1
    lo = hi
  end
  ret eq k ncr
end

fn write_ps_index_line ci ulong fi ulong pn ulong to void
  ridx = add mul ci MAXF fi
  ro = mul ridx 64
  co = mul ci 64
  ob_set_fd get g_fd_ps 0

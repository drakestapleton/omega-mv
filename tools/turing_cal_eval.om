  put g_cb_cap 0 nc
  ret true
end

fn ensure_rc need ulong to bool
  cap = get g_rc_cap 0
  if le need cap
    ret true
  end
  nc = ulong 4096
  if gt cap 0
    nc = cap
  end
  while lt nc need bound 64
    nc = mul nc 2
  end
  r1 = enlarge g_rc_ub nc
  if ne r1 0
    ret false
  end
  r2 = enlarge g_rc_rng nc
  if ne r2 0
    ret false
  end
  r3 = enlarge g_rc_rns nc
  if ne r3 0
    ret false
  end
  put g_rc_cap 0 nc
  ret true
end

fn ensure_boot need_p ulong need_sb ulong to bool
  pcap = get g_boot_pool_cap 0
  if gt need_p pcap
    np = ulong 4096
    if gt pcap 0
      np = pcap
    end
    while lt np need_p bound 64
      np = mul np 2
    end
    r1 = enlarge g_boot_pool np
    if ne r1 0
      ret false
    end
    put g_boot_pool_cap 0 np
  end
  scap = get g_boot_sb_cap 0
  if gt need_sb scap
    ns = ulong 160000
    if gt scap 0
      ns = scap
    end
    while lt ns need_sb bound 64
      ns = mul ns 2
    end
    r2 = enlarge g_boot_sb ns
    if ne r2 0
      ret false
    end
    put g_boot_sb_cap 0 ns
  end
  ret true
end

fn ensure_kva need ulong to bool
  cap = get g_kva_cap 0
  if le need cap
    ret true
  end
  nc = ulong 1024
  if gt cap 0
    nc = cap
  end
  while lt nc need bound 64
    nc = mul nc 2
  end
  r1 = enlarge g_kva_key mul nc 160
  if ne r1 0
    ret false
  end
  r2 = enlarge g_kva_val nc
  if ne r2 0
    ret false
  end
  put g_kva_cap 0 nc
  ret true
end

fn ensure_kvb need ulong to bool
  cap = get g_kvb_cap 0
  if le need cap
    ret true
  end
  nc = ulong 1024
  if gt cap 0
    nc = cap
  end
  while lt nc need bound 64
    nc = mul nc 2
  end
  r1 = enlarge g_kvb_key mul nc 160
  if ne r1 0
    ret false
  end
  r2 = enlarge g_kvb_val nc
  if ne r2 0
    ret false
  end
  put g_kvb_cap 0 nc
  ret true
end

note ================================================================
note SHA-256 (FIPS 180-4) & Digests
note ================================================================

fn sh_tbl_init to void
  if ne get g_shk 64 0
    ret
  end
  p = ulong 0
  for i ulong 72
    v = ulong 0
    while lt get t_kiv p 48 bound 4
      p = add p 1
    end
    while ge get t_kiv p 48 bound 11
      v = add mul v 10 ulong sub get t_kiv p 48
      p = add p 1
      if ge p len t_kiv
        put g_shk i uint v
        ret
      end
    end
    put g_shk i uint v
  end
end

fn sh_rr x uint n uint to uint
  ret or shr x n shl x sub 32 n
end

fn sh_rnd i ulong to void
  e = get g_shv 4
  s1 = xor xor sh_rr e 6 sh_rr e 11 sh_rr e 25
  ch = xor and e get g_shv 5 and not e get g_shv 6
  t1 = add add add get g_shv 7 s1 add ch get g_shk i get g_shw i
  a = get g_shv 0
  s0 = xor xor sh_rr a 2 sh_rr a 13 sh_rr a 22
  b = get g_shv 1
  c = get g_shv 2
  mj = xor xor and a b and a c and b c
  t2 = add s0 mj
  put g_shv 7 get g_shv 6
  put g_shv 6 get g_shv 5
  put g_shv 5 e
  put g_shv 4 add get g_shv 3 t1
  put g_shv 3 get g_shv 2
  put g_shv 2 b
  put g_shv 1 a
  put g_shv 0 add t1 t2
end

fn sh_blk to void
  for t ulong 16
    o = mul t 4
    w0 = uint get g_shb o
    w1 = uint get g_shb add o 1
    w2 = uint get g_shb add o 2
    w3 = uint get g_shb add o 3
    put g_shw t or or shl w0 24 shl w1 16 or shl w2 8 w3
  end
  for t ulong 48
    u = add t 16
    x2 = get g_shw sub u 2
    g1 = xor xor sh_rr x2 17 sh_rr x2 19 shr x2 10
    x15 = get g_shw sub u 15
    g0 = xor xor sh_rr x15 7 sh_rr x15 18 shr x15 3
    put g_shw u add add g1 get g_shw sub u 7 add g0 get g_shw sub u 16
  end
  for j ulong 8
    put g_shv j get g_shh j
  end
  for i ulong 64
    sh_rnd i
  end
  for j ulong 8
    put g_shh j add get g_shh j get g_shv j
  end
end

fn sh_init to void
  sh_tbl_init
  for j ulong 8
    put g_shh j get g_shk add 64 j
  end
  put g_shm 0 0
  put g_shm 1 0
end

fn sh_byte b uchar to void
  n = get g_shm 0
  pos = get g_shm 1
  put g_shb pos b
  pos = add pos 1
  put g_shm 0 add n 1
  if eq pos 64
    sh_blk
    pos = 0
  end
  put g_shm 1 pos
end


fn sh_slice_fbuf n ulong to void
  for i ulong n bound 65536
    b = get g_fbuf i
    sh_byte b
  end
end
fn sh_slice_obuf n ulong to void
  for i ulong n bound 65536
    b = get g_obuf i
    sh_byte b
  end
end
fn sh_slice_lbuf off ulong n ulong to void
  for i ulong n bound 65536
    b = get g_lbuf add off i
    sh_byte b
  end
end
fn dg_to_g_hex slot ulong to void
  o = mul slot 32
  for i ulong 32
    b = ulong get g_dig add o i
    put g_hex_tmp mul i 2 get t_hex shr b 4
    put g_hex_tmp add mul i 2 1 get t_hex and b 15
  end
end
fn dg_to_r_tps slot ulong ro ulong to void
  o = mul slot 32
  for i ulong 32
    b = ulong get g_dig add o i
    c0 = get t_hex shr b 4
    c1 = get t_hex and b 15
    put g_r_tps add ro mul i 2 c0
    put g_r_tps add ro add mul i 2 1 c1
  end
end
fn dg_to_r_tsy slot ulong ro ulong to void
  o = mul slot 32
  for i ulong 32
    b = ulong get g_dig add o i
    c0 = get t_hex shr b 4
    c1 = get t_hex and b 15
    put g_r_tsy add ro mul i 2 c0
    put g_r_tsy add ro add mul i 2 1 c1
  end
end
fn dg_to_dd x ulong slot ulong to void
  o = mul slot 32
  for i ulong 32
    b = ulong get g_dig add o i
    c0 = get t_hex shr b 4
    c1 = get t_hex and b 15
    if eq x 0
      put g_dd0 mul i 2 c0
      put g_dd0 add mul i 2 1 c1
    else
      put g_dd1 mul i 2 c0
      put g_dd1 add mul i 2 1 c1
    end
  end
end
fn dg_unhex_prof to void
  for i ulong 32
    v = ulong 0
    for q ulong 2
      c = get g_prof_sha add mul i 2 q
      d = long -1
      if and ge c 48 le c 57
        d = long sub c 48
      else
        if and ge c 97 le c 102
          d = add long sub c 97 10
        end
      end
      if ge d 0
        v = add mul v 16 ulong d
      end
    end
    put g_prof_dig i uchar v
  end
end
fn dg_unhex_f_dd fi ulong to void
  doff = mul fi 32
  for i ulong 32
    v = ulong 0
    for q ulong 2
      c = get g_hex_tmp add mul i 2 q
      d = long -1
      if and ge c 48 le c 57
        d = long sub c 48
      else
        if and ge c 97 le c 102
          d = add long sub c 97 10
        end
      end
      if ge d 0
        v = add mul v 16 ulong d
      end
    end
    put g_f_dd add doff i uchar v
  end
end

fn sh_slice s view uchar * off ulong n ulong to void
  for i ulong n bound 65536
    sh_byte get s add off i
  end
end

fn sh_final slot ulong to void
  tot = get g_shm 0
  bits = mul tot 8
  sh_byte uchar 128
  while ne get g_shm 1 56 bound 64
    sh_byte uchar 0
  end
  for i ulong 8
    sh = mul sub 7 i 8
    sh_byte uchar and shr bits sh 255
  end
  o = mul slot 32
  for j ulong 8
    v = get g_shh j
    for q ulong 4
      sh = mul sub 3 q 8
      idx = add o add mul j 4 q
      bv = uchar and shr v sh 255
      put g_dig idx bv
    end
  end
end

fn dg_to_hex slot ulong dst edit uchar * doff ulong to void
  o = mul slot 32
  for i ulong 32
    b = ulong get g_dig add o i
    d0 = add doff mul i 2
    d1 = add d0 1
    c0 = get t_hex shr b 4
    c1 = get t_hex and b 15
    put dst d0 c0
    put dst d1 c1
  end
end

fn dg_unhex src view uchar * soff ulong dst edit uchar * doff ulong to bool
  for i ulong 32
    v = ulong 0
    for q ulong 2
      c = get src add soff add mul i 2 q
      d = long -1
      if and ge c 48 le c 57
        d = long sub c 48
      else
        if and ge c 97 le c 102
          d = add long sub c 97 10
        end
      end
      if lt d 0
        ret false
      end
      v = add mul v 16 ulong d
    end
    put dst add doff i uchar v
  end
  ret true
end

fn sh_fbuf ku ulong to void
  for i ulong ku bound 65536
    b = get g_fbuf i
    sh_byte b
  end
end


fn sha_gp slot ulong to bool
  plen = get g_plen 0
  if eq plen 0
    ret false
  end
  fd = fopen g_path 0 plen int 0 int 0
  if lt fd 0
    ret false
  end
  sh_init
  tot = ulong 0
  done = false
  while not done bound 10000000
    k = read int fd g_fbuf 0 65536
    if lt k 0
      ign = fclose int fd
      ret false
    end
    if eq k 0
      done = true
    else
      ku = ulong k
      tot = add tot ku
      sh_fbuf ku
    end
  end
  ign = fclose int fd
  sh_final slot
  dg_to_g_hex slot
  put g_ty_ret_u 0 tot
  ret true
end
fn set_gp_g_man l ulong to void
  for i ulong l bound 4096
    put g_path i get g_man_p i
  end
  put g_plen 0 l
end
fn set_gp_g_ds l ulong to void

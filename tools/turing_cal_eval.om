fn precheck_digests to int
  pp = new uchar 4096 0
  rp_hex = new uchar 64 0
  pj_set_g_repo
  ppl = pj_make_g_prof pp
  if or eq ppl 0 not sha_file_hex pp ppl rp_hex 107
    ret refuse_txt t_s90 t_s161 t_s403
  end
  for i ulong 64
    put g_rprof i get rp_hex i
  end
  set_gp_g_man get g_man_pl 0
  if not sha_gp 107
    ret refuse_txt t_s90 t_s161 t_s404
  end
  for i ulong 64
    put g_rman i get g_hex_tmp i
  end
  for i ulong len t_dry_run bound 48
    put g_rfreeze i get t_dry_run i
  end
  put g_rfreeze_l 0 len t_dry_run
  if eq get g_dry 0 0
    set_gp_g_ds get g_ds_pl 0
    if not slurp_gp
      ret refuse_txt t_s90 t_s161 t_s405
    end
    ppl = ulong jtop_slurp t_k_fc rp_hex 64
    if or lt long ppl 0 not is_hex40 rp_hex ppl
      ret refuse_txt t_s90 t_s104 t_s106
    end
    for i ulong 40
      put g_rfreeze i get rp_hex i
    end
    put g_rfreeze_l 0 40
  end
  ret 0
end

fn precheck_sealed_out to int
  rp = new uchar 4096 0
  suf = new uchar 128 0
  set_gp_g_out_p get g_out_pl 0
  lr = om_realpath_gp rp
  ob_set_fd int -1
  ob_b uchar 47
  ob_g_rfreeze
  ob_txt t_run_bundle
  ls = get g_olen 0
  for i ulong ls bound 128
    put suf i get g_obuf i
  end
  put g_olen 0 0
  suf_ok = false
  if and gt lr 0 ge lr ls
    sa_set rp sub lr ls ls
    suf_ok = sa_eq suf 0 ls
  end
  if not suf_ok
    ret refuse_txt t_s90 t_s407 t_s408
  end
  nv = ulong 0
  pj_set_g_out_p
  for k ulong 999 bound 1000
    ls = fmt_void_name add k 1 suf
    if not file_exists rp pj_make suf ls rp
      break
    end
    nv = add nv 1
  end
  if ge nv MAX_ATTEMPTS
    ret refuse_txt t_s90 t_s409 t_s410
  end
  ret 0
end

fn precheck_dry_out to int
  tmp = new uchar 4096 0
  outl = get g_out_pl 0
  for i ulong outl bound 4096
    put tmp i get g_out_p i
  end
  if under_forbidden tmp outl
    ret refuse_txt t_s411 t_s412 t_s413
  end
  outl = get g_work_l 0
  for i ulong outl bound 4096
    put tmp i get g_work i
  end
  if under_forbidden tmp outl
    ret refuse_txt t_s411 t_s412 t_s413
  end
  ret 0
end

fn cmd_run_precheck to int
  rc = precheck_digests
  if ne rc 0
    ret rc
  end
  set_gp_g_out_p get g_out_pl 0
  if not mkdir_p_gp
    ret refuse_txt t_s90 t_s161 t_s406
  end
  set_gp_g_work get g_work_l 0
  if not mkdir_p_gp
    ret refuse_txt t_s90 t_s161 t_s406
  end
  if eq get g_dry 0 0
    rc = precheck_sealed_out
  else
    rc = precheck_dry_out
  end
  if ne rc 0
    ret rc
  end
  fp = new uchar 4096 0
  pj_set_g_out_p
  if file_exists fp pj_make t_f_final len t_f_final fp
    ret refuse_txt t_s414 t_s415 t_s416
  end
  ret 0
end

fn retry_check_void_match to int
  c1 = new uchar 4096 0
  cl = jtop_slurp t_k_cmd c1 4096
  if lt cl 0
    ret refuse_txt t_s417 t_s418 t_s419
  end
  sa_set c1 0 ulong cl
  if not sa_eq_g_cmd
    ret refuse_txt t_s417 t_s418 t_s419
  end
  cl = jtop_slurp t_k_inputs c1 1024
  if lt cl 0
    ret refuse_txt t_s417 t_s418 t_s419
  end
  sa_set c1 0 ulong cl
  if not sa_eq_g_inputs
    ret refuse_txt t_s417 t_s418 t_s419
  end
  ret 0
end

fn cmd_run_retry_check to int
  if ne get g_dry 0 0
    ret 0
  end
  vnm = new uchar 64 0
  vp = new uchar 4096 0
  stg = new uchar 32 0
  for k ulong 999 bound 1000
    vnl = fmt_void_name add k 1 vnm
    pj_set_g_out
    vpl = pj_make vnm vnl vp
    if not slurp_file vp vpl
      break
    end
    sl = jtop_slurp t_k_stage stg 32
    if and ge sl 0 sl_eq stg ulong sl t_eval_stg
      ret retry_check_void_match
    end
  end
  ret 0
end

fn cmd_run_in_prof_man to int
  manl = get g_man_pl 0
  prof_p = new uchar 4096 0
  pj_set_g_repo
  ppl = pj_make_g_prof prof_p
  psha = new uchar 64 0
  if not sha_file_hex prof_p ppl psha 106
    ret refuse_txt t_s420 t_s161 t_s403
  end
  for i ulong 64
    put g_prof_sha i get psha i
  end
  side_p = new uchar 4096 0
  spl = pj_make_g_side side_p
  if not slurp_file side_p spl
    ret refuse_txt t_s420 t_s421 t_s422
  end
  tl = get g_slurp_len 0
  si = ulong 0
  while lt si tl bound 128
    ch = get g_slurp si
    if or eq ch uchar 32 or eq ch uchar 9 eq ch uchar 10
      si = add si 1
    else
      break
    end
  end
  se = si
  while lt se tl bound 128
    ch = get g_slurp se
    if or eq ch uchar 32 or eq ch uchar 9 eq ch uchar 10
      break
    end
    if eq ch uchar 13
      break
    end
    se = add se 1
  end
  if ne sub se si 64
    ret refuse_txt t_s420 t_s421 t_s422
  end
  sa_set_slurp si 64
  if not sa_eq_g_prof_sha
    ret refuse_txt t_s420 t_s421 t_s422
  end
  if not slurp_file prof_p ppl
    ret refuse_txt t_s420 t_s161 t_s403
  end
  if and eq get g_dry 0 0 sl_has_slurp 0 get g_slurp_len 0 t_fill_at_freeze
    ret refuse_txt t_s99 t_s423 t_s424
  end
  dg_unhex_prof
  set_gp_g_man manl
  if or not slurp_gp not sha_gp 105
    ret refuse_txt t_s75 t_s161 t_s425
  end
  for i ulong 64
    put g_man_sha i get g_hex_tmp i
  end
  ret 0
end

fn cmd_run_in_check_indep to int
  mind = new uchar 80 0
  scr = new uchar 4096 0
  st_l = jtop_slurp t_k_indep mind 80
  pj_set_g_repo
  scrl = pj_make t_rel_indep_scr len t_rel_indep_scr scr
  pl = pkt_init 2
  pl = pkt_push pl t_sh_bin 0 len t_sh_bin
  pl = pkt_push pl scr 0 scrl
  rc_i = run_capture_pkt pl
  sa_set_cap get g_cap_len 0
  if or ne rc_i 0 or ne st_l 64 not sa_eq mind 0 64
    ret refuse_txt t_s429 t_s430 t_s431
  end
  ret 0
end

fn cmd_run_in_man_meta to int
  st_l = jtop_slurp_g t_k_status
  if gt st_l 0
    for i ulong ulong st_l bound 32
      put g_status i get g_jtmp i
    end
  end
  put g_stat_l 0 0
  if gt st_l 0
    put g_stat_l 0 ulong st_l
  end
  fa_l = jtop_slurp_g t_k_fat
  if gt fa_l 0
    for i ulong ulong fa_l bound 40
      put g_fat i get g_jtmp i
    end
  end
  put g_fat_l 0 0
  if gt fa_l 0
    put g_fat_l 0 ulong fa_l
  end
  mp = new uchar 64 0
  st_l = jtop_slurp t_k_psha mp 64
  sa_set mp 0 64
  if or ne st_l 64 not sa_eq_g_prof_sha
    ret refuse_txt t_s75 t_s421 t_s426
  end
  if eq get g_dry 0 0
    if not sl_eq_g_status t_frozen
      ret refuse_txt t_s99 t_s423 t_s427
    end
    if eq get g_fat_l 0 0
      ret refuse_txt t_s99 t_s423 t_s428
    end
    ret cmd_run_in_check_indep
  end
  ret 0
end

fn cmd_run_in_cands to int
  m_eval = new uchar 64 0
  me_l = new ulong 1 0
  rcm = parse_candidate_manifest m_eval me_l
  if ne rcm 0
    ret rcm
  end
  prof_p = new uchar 4096 0
  rl = readlnk t_self_exe 0 len t_self_exe prof_p 0 4095
  if le rl 0
    ret refuse_txt t_s432 t_s161 t_s433
  end
  ssha = new uchar 64 0
  if not sha_file_hex prof_p ulong rl ssha 104
    ret refuse_txt t_s432 t_s161 t_s433
  end
  for i ulong 64
    put g_self_sha i get ssha i
  end
  if eq get g_dry 0 0
    sa_set_self_sha
    if or ne get me_l 0 64 not sa_eq m_eval 0 64
      ret refuse_txt t_s432 t_s434 t_s435
    end
  end
  if lt cand_index_txt t_b2 0
    ret refuse_txt t_s75 t_s76 t_s436
  end
  if eq get g_dry 0 0
    if or lt cand_index_txt t_mcand 0 or lt cand_index_txt t_mmem 0 lt cand_index_txt t_mmem1 0
      ret refuse_txt t_s75 t_s76 t_s437
    end
  end
  ret 0
end

fn load_cdir_to_p2 d ulong to void
  co = mul d 4096
  n = get g_cdlen d
  for j ulong n bound 4096
    put g_p2 j get g_cdirs add co j
  end
  pj_set_g_p2 n
end

fn find_cand_path ci ulong cp edit uchar * to bool
  fnm = new uchar 128 0
  co = mul ci 128
  for j ulong get g_c_flen ci bound 128
    put fnm j get g_c_file add co j
  end
  for d ulong get g_ncd 0 bound 32
    load_cdir_to_p2 d
    co = pj_make fnm get g_c_flen ci cp
    if gt co 0
      if eq faccess cp 0 co 4 0
        put g_c_plen ci co
        d = mul ci 4096
        for j ulong co bound 4096
          put g_c_path add d j get cp j
        end
        ret true
      end
    end
  end
  ret false
end

fn cmd_run_in_cand_files to int
  cp = new uchar 4096 0

      ob_b get g_code_root i
    end
  ob_txt t_s332
  for i ulong 64
      ob_b get g_self_sha i
    end
  ob_txt t_s333
  ob_g_ds_id
  ob_txt t_s334
  ob_g_ds_split
  ob_txt t_s335
  ob_g_ds_sha
  ob_txt t_s336
  ob_g_ds_sc
  ob_txt t_s337
  ob_g_ds_sm
  ob_txt t_s338
  ob_g_ds_rel
  ob_txt t_s339
  if ne get g_dry 0 0
    ob_txt t_false
  else
    ob_txt t_true
  end
  ob_txt t_s340
  write_pending_receipt_group 1
  write_pending_receipt_group 2
  ob_txt t_s341
  for i ulong 9
    ci = add i 1
    if gt i 0
      ob_txt t_s14
    end
    if eq ci 8
      ob_txt t_s342
    else
      if eq ci 1
        ob_txt t_s0
      end
      if eq ci 2
        ob_txt t_s1
      end
      if eq ci 3
        ob_txt t_s2
      end
      if eq ci 4
        ob_txt t_s3
      end
      if eq ci 5
        ob_txt t_s4

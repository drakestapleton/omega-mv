  n = get g_repo_l 0
  pkt_u16_pkt pos n
  o = add pos 2
  for i ulong n bound 4096
    put g_pkt add o i get g_repo i
  end
  ret add o n
end
fn pkt_push_g_ds_com pos ulong to ulong
  pkt_u16_pkt pos 40
  o = add pos 2
  for i ulong 40
    put g_pkt add o i get g_ds_com i
  end
  ret add o 40
end
fn jparse_int_slurp p ulong lim ulong to long
  p = jskip_sp_slurp p lim
  if ge p lim
    put g_ty_ret_i 0 1
    ret -1
  end
  neg_f = false
  if eq get g_slurp p uchar 45
    neg_f = true
    p = add p 1
  end
  if ge p lim
    put g_ty_ret_i 0 1
    ret -1
  end
  v = ulong 0
  nd = ulong 0
  while lt p lim bound 32
    c = get g_slurp p
    if or lt c 48 gt c 57
      break
    end
    v = add mul v 10 ulong sub c 48
    nd = add nd 1
    p = add p 1
  end
  if eq nd 0
    put g_ty_ret_i 0 1
    ret -1
  end
  if lt p lim
    if not is_json_delim get g_slurp p
      put g_ty_ret_i 0 1
      ret -1
    end
  end
  put g_ty_ret_i 0 0
  if neg_f
    ret sub 0 long v
  end
  ret long v
end

fn jint_slurp loff ulong ll ulong key view uchar * to long
  p = jfind_slurp loff ll key
  if lt p 0
    put g_ty_ret_i 0 1
    ret -1
  end
  ret jparse_int_slurp add loff ulong p add loff ll
end
fn jtop_slurp_g key view uchar * to long
  tmp = new uchar 4096 0

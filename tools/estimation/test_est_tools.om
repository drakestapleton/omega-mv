note ---- Slurp & JSON search helpers ----

fn tt_slurp_p3 to bool
  n = get g_tt_p3l 0
  fd = fopen g_tt_p3 0 n 0 0
  if lt fd 0
    put g_tt_jslen 0 0
    ret false
  end
  tot = ulong 0
  while lt tot 1048575 bound 1048576
    k = read int fd g_tt_js tot sub 1048575 tot
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  ign = fclose int fd
  put g_tt_jslen 0 tot
  ret true
end

fn tt_js_find from ulong pat view uchar * to long
  tot = get g_tt_jslen 0
  pn = len pat
  if eq pn 0
    ret long from
  end
  if lt tot add from pn
    ret -1
  end
  lim = add sub tot pn 1
  i = from
  while lt i lim bound 1048576
    ok = true
    for j ulong pn
      if ne get g_tt_js add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret long i
    end
    i = add i 1
  end
  ret -1
end

fn tt_js_has pat view uchar * to bool
  ret ge tt_js_find 0 pat 0
end

fn tt_js_match_at base long off ulong pat view uchar * to bool
  if lt base 0
    ret false
  end
  pos = add ulong base off
  ret eq tt_js_find pos pat long pos
end

fn tt_js_has_sha prefix view uchar * hex view uchar 65 to bool
  pat = new uchar 128 0
  pn = len prefix
  for i ulong pn
    put pat i get prefix i
  end
  for i ulong 64
    put pat add pn i get hex i
  end
  put pat add pn 64 34
  ret ge tt_js_find 0 part pat 0 add pn 65 0
end

fn tt_js_f64_at pos ulong to f64
  tot = get g_tt_jslen 0
  if ge pos tot
    ret est_nan
  end
  rem_n = sub tot pos
  if gt rem_n 64
    rem_n = 64
  end
  tmp = new uchar 64 0
  for i ulong rem_n
    put tmp i get g_tt_js add pos i
  end
  dst = new f64 1 0.0
  used = new ulong 1 0
  if ne er_parse_f64 view tmp 0 rem_n dst used 0
    ret est_nan
  end
  ret get dst 0
end

fn tt_jv from ulong key view uchar * to f64
  p = tt_js_find from key
  if lt p 0
    ret est_nan
  end
  ret tt_js_f64_at add ulong p len key
end

fn tt_js_find_comma from ulong to long
  tot = get g_tt_jslen 0
  i = from
  while lt i tot bound 1048576
    if eq get g_tt_js i 44
      ret long i
    end
    i = add i 1
  end
  ret -1
end

fn tt_err_has pat view uchar * to bool
  en = get g_er_elen 0
  pn = len pat
  if lt en pn
    ret false
  end
  lim = add sub en pn 1
  for i ulong lim
    ok = true
    for j ulong pn
      if ne get g_er_err add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

note ---- Series generators (make_series & make_mix_series, dir in g_tt_p1) ----

fn tt_write_sums_p1 has_marks ulong to void
  tt_p2_from_p1 t_tt_ms_suf
  h1 = new uchar 65 0
  ign = tt_sha_p2 h1
  h2 = new uchar 65 0
  if ne has_marks 0
    tt_p3_from_p1 t_tt_mk_suf
    ign = tt_sha_p3 h2
  end
  tt_p4_from_p1 t_tt_su_suf
  fd = fopen g_tt_p4 0 get g_tt_p4l 0 577 438
  if ge fd 0
    ob_flush
    ob_init int fd
    ob_s view h1 64
    ob_t t_tt_su_ms
    if ne has_marks 0
      ob_s view h2 64
      ob_t t_tt_su_mk
    end
    ob_flush
    ign = fclose int fd
    ob_init 1
  end
end

fn tt_emit_series_line i ulong t long z f64 damage ulong to void
  jit = rem tt_rnd 3000000
  if and ne damage 0 eq i 0
    ob_t t_tt_garb
    ret
  end
  if and ne damage 0 eq i 52
    ob_t t_tt_notj
    ret
  end
  ob_t t_tt_j_t
  ob_i t
  ob_c 46
  ob_u_pad jit 9
  if and ne damage 0 eq i 50
    ob_t t_tt_j_nan
    ret
  end
  if and ne damage 0 eq i 51
    ob_t t_tt_j_spb1
    ret
  end
  ob_t t_tt_j_spb
  ob_u i
  ob_t t_tt_j_th
  ob_fix z 0
  ob_t t_tt_j_th2
end

fn tt_series_loop n ulong sq f64 sr f64 damage ulong to void
  x = f64 45000.0
  extra = long 0
  for i ulong n
    g1 = tt_gauss
    g2 = tt_gauss
    x = add x mul sq g1
    z = est_floor add add x mul sr g2 0.5f64
    if and ne damage 0 eq i 100
      extra = 2
    end
    t = add add long 1790000000 long i extra
    tt_emit_series_line i t z damage
  end
end

fn tt_make_series n ulong q f64 r f64 seed ulong damage ulong to void
  tt_rm_mkdir_p1
  tt_p2_from_p1 t_tt_ms_suf
  fd = fopen g_tt_p2 0 get g_tt_p2l 0 577 438
  put g_tt_rng 0 seed
  ob_flush
  ob_init int fd
  tt_series_loop n fsqrt q fsqrt r damage
  ob_flush
  ign = fclose int fd
  tt_p3_from_p1 t_tt_mk_suf
  mfd = fopen g_tt_p3 0 get g_tt_p3l 0 577 438
  ob_init int mfd
  ob_i add long 1790000000 long div n 5
  ob_t t_tt_mk_b
  ob_i add long 1790000000 long div mul n 3 5
  ob_t t_tt_mk_e
  ob_flush
  ign = fclose int mfd
  ob_init 1
  tt_write_sums_p1 1
end

fn tt_make_mix_series n ulong seed ulong to void
  tt_rm_mkdir_p1
  tt_p2_from_p1 t_tt_ms_suf
  fd = fopen g_tt_p2 0 get g_tt_p2l 0 577 438
  put g_tt_rng 0 seed
  x = f64 45000.0
  wall = long 1790000000
  ob_flush
  ob_init int fd
  for i ulong n
    u = tt_unif
    sc = f64 2000.0
    if lt u 0.4f64
      sc = 20.0f64
    else
      if lt u 0.8f64
        sc = 300.0f64
      end
    end
    x = est_floor add add x mul sc tt_gauss 0.5f64
    jit = rem tt_rnd 3000000
    ob_t t_tt_j_t
    ob_i add wall long i
    ob_c 46
    ob_u_pad jit 9
    ob_t t_tt_j_th
    ob_fix x 0
    ob_t t_tt_j_th3
  end
  ob_flush
  ign = fclose int fd
  tt_p3_from_p1 t_tt_mk_suf
  mfd = fopen g_tt_p3 0 get g_tt_p3l 0 577 438
  ign = fclose int mfd
  ob_init 1
  tt_write_sums_p1 1
end

note ---- Test 1: prefix invariance on run A ----

fn tt_step_eq si ulong to bool
  a = add mul si RP_SLOTS 1
  b = mul si RP_SLOTS
  if ne get g_rps_line a get g_rps_line b
    ret false
  end
  if ne and get g_rps_flags a 2 and get g_rps_flags b 2
    ret false
  end
  if ne get g_rps_tns a get g_rps_tns b
    ret false
  end
  if ne get g_rps_hor a get g_rps_hor b
    ret false
  end
  if ne bitcast ulong get g_rps_z a bitcast ulong get g_rps_z b
    ret false
  end
  if ne bitcast ulong get g_rps_ym a bitcast ulong get g_rps_ym b
    ret false
  end
  if ne bitcast ulong get g_rps_S a bitcast ulong get g_rps_S b
    ret false
  end
  if ne bitcast ulong get g_rps_nu a bitcast ulong get g_rps_nu b
    ret false
  end
  if ne bitcast ulong get g_rps_nis a bitcast ulong get g_rps_nis b
    ret false
  end
  da = add mul a 20 4
  db = add mul b 20 4
  for d ulong 16
    v1 = get g_rps_dig add da d
    v2 = get g_rps_dig add db d
    if ne v1 v2
      ret false
    end
  end
  xa = mul a 2
  xb = mul b 2
  for k ulong 2
    v1 = bitcast ulong get g_rps_px add xa k
    v2 = bitcast ulong get g_rps_px add xb k
    if ne v1 v2
      ret false
    end
  end
  pa = mul a 4
  pb = mul b 4
  for k ulong 4
    v1 = bitcast ulong get g_rps_pP add pa k
    v2 = bitcast ulong get g_rps_pP add pb k
    if ne v1 v2
      ret false
    end
  end
  ret true
end

fn tt_prefix_check_k m ulong kv ulong to bool
  tt_ck eq est_replay_run 0 kv m 100.0f64 10000.0f64 1 0 105
  pns = get g_rp_meta 16
  plm = get g_rp_meta 18
  tt_ck eq pns sub kv plm 106
  ok = true
  for i ulong pns
    if not tt_step_eq i
      ok = false
    end
  end
  ret ok
end

fn tt_test_prefix_run_a to void
  tt_ck eq er_file_load 0 t_tt_run_a_raw len t_tt_run_a_raw 0 101
  sha = new uchar 65 0
  er_file_get_sha 0 sha
  tt_ck er_eq view sha 64 t_er_run_a_sha 64 102
  all_ok = true
  for m ulong 2
    tt_ck eq est_replay_run 0 ER_ALL_LINES m 100.0f64 10000.0f64 0 0 103
    ns = get g_rp_meta 0
    lm = get g_rp_meta 2
    tt_ck eq add ns lm get g_ef_nlines 0 104
    if not tt_prefix_check_k m 100
      all_ok = false
    end
    if not tt_prefix_check_k m 500
      all_ok = false
    end
    if not tt_prefix_check_k m 1000
      all_ok = false
    end
    for i ulong ns
      tt_ck ne and get g_rps_flags mul i RP_SLOTS 8 0 107
    end
  end
  tt_ck all_ok 108
  ob_t t_tt_msg_pre
  if all_ok
    ob_t t_tt_pass
  else
    ob_t t_tt_fail
  end
  ob_nl
end

note ---- Test 2: coasting ----

fn tt_dig_is_zero idx ulong which ulong to bool
  base = add mul idx 20 mul which 4
  for i ulong 4
    if ne get g_rps_dig add base i 0
      ret false
    end
  end
  ret true
end

text t_tt_s_coast "/coast"

fn tt_test_coasting to void
  tt_p1_work t_tt_s_coast
  tt_make_series 300 30.0f64 3000.0f64 7 1
  tt_p2_from_p1 t_tt_ms_suf
  tt_ck eq tt_file_load_p2 0 0 201
  tt_ck eq est_replay_run 0 ER_ALL_LINES 0 30.0f64 3000.0f64 0 0 202
  tt_ck eq get g_rp_meta 2 1 203
  tt_ck eq get g_rp_meta 3 3 204
  tt_ck eq get g_rp_meta 4 4 205
  tt_ck eq get g_rp_meta 0 299 206
  tt_ck ne and get g_rps_flags mul 49 RP_SLOTS 2 0 207
  tt_ck ne and get g_rps_flags mul 50 RP_SLOTS 2 0 208
  tt_ck ne and get g_rps_flags mul 51 RP_SLOTS 2 0 209
  tt_ck eq and get g_rps_flags mul 48 RP_SLOTS 2 0 210
  tt_ck eq and get g_rps_flags mul 52 RP_SLOTS 2 0 211
  tt_ck eq get g_rps_hor mul 52 RP_SLOTS 1 212
  tt_ck eq get g_rps_hor mul 98 RP_SLOTS 1 213
  tt_ck eq get g_rps_hor mul 99 RP_SLOTS 3 214
  t98 = get g_rps_tns mul 98 RP_SLOTS
  t99 = get g_rps_tns mul 99 RP_SLOTS
  tt_ck eq t99 add t98 long 3000000000 215
  p51 = get g_rps_pP mul mul 51 RP_SLOTS 4
  p48 = get g_rps_pP mul mul 48 RP_SLOTS 4
  tt_ck gt p51 p48 216
  tt_ck tt_dig_is_zero mul 50 RP_SLOTS 1 217
  tt_ck not tt_dig_is_zero mul 50 RP_SLOTS 2 218
  tt_ck ne and get g_rps_flags mul 50 RP_SLOTS 8 0 219
  ob_t t_tt_msg_cst1
  ob_u get g_rp_meta 2
  ob_t t_tt_msg_cst2
  ob_u get g_rp_meta 3
  ob_t t_tt_msg_cst3
  ob_u get g_rp_meta 0
  ob_c 32
  ob_t t_tt_pass
  ob_nl
end

note ---- Test 3: SHA refusal ----

text t_tt_s_sha "/sha"
text t_tt_s_shapar "/sha/params"
text t_tt_s_shaoth "/sha/other.ndjson"
text t_tt_f_syn " --synthetic-test "
text t_tt_cp "cp "

fn tt_test_sha_refusal to void
  tt_p1_work t_tt_s_sha
  tt_make_series 200 30.0f64 3000.0f64 11 0
  tt_p2_from_p1 t_tt_ms_suf
  tt_ck eq tt_file_load_p2 0 0 301
  fd = fopen g_tt_p2 0 get g_tt_p2l 0 2 0
  b = new uchar 1 0
  ign = pread int fd b 0 1 20
  if eq get b 0 53
    put b 0 54
  else
    put b 0 53
  end
  ign = pwrite int fd b 0 1 20
  ign = fclose int fd
  tt_ck ne tt_file_load_p2 0 0 302
  tt_ck tt_err_has t_tt_mism 303
  tt_p3_work t_tt_s_shapar
  tt_cmd_reset
  tt_cmd_fit
  tt_cmd_t t_tt_f_syn
  tt_cmd_p2
  tt_cmd_t t_tt_sp
  tt_cmd_p3
  tt_cmd_t t_tt_devnull
  tt_ck ne tt_sh_run 0 304
  tt_p3_work t_tt_s_shaoth
  tt_cmd_reset
  tt_cmd_t t_tt_cp
  tt_cmd_p2
  tt_cmd_t t_tt_sp
  tt_cmd_p3
  ign = tt_sh_run
  for i ulong get g_tt_p3l 0
    put g_tt_p2 i get g_tt_p3 i
  end
  put g_tt_p2l 0 get g_tt_p3l 0
  tt_ck ne tt_file_load_p2 0 0 305
  ob_t t_tt_msg_sha1
  for i ulong get g_er_elen 0
    ob_c get g_er_err i
  end
  ob_t t_tt_msg_sha2
end


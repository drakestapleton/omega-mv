  put vv 1 0.15253995979312637f64
  put vv 2 0.47059288582378966f64
  tt_ck_cov_w sc t_tt_j_cov50 view vv 1016
  put vv 0 0.6071428571428571f64
  put vv 1 0.42409044159980325f64
  put vv 2 0.7643431355917387f64

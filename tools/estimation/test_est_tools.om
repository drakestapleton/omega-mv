text t_tt_e_d1 " EST_TEST_DIRTY=1 "

fn tt_env_build_b h1 view uchar 65 h2 view uchar 65 to void
  n = ulong 0
  for i ulong len t_tt_e_bid
    put g_tt_env n get t_tt_e_bid i
    n = add n 1
  end
  for i ulong 64
    put g_tt_env n get h1 i
    n = add n 1
  end
  for i ulong len t_tt_e_bmk
    put g_tt_env n get t_tt_e_bmk i
    n = add n 1
  end
  for i ulong 64
    put g_tt_env n get h2 i
    n = add n 1
  end
  put g_tt_envl 0 n
end

fn tt_run_evalt_b dirty ulong rec_flag ulong to long
  tt_cmd_reset
  tt_cmd_env
  if eq dirty 0
    tt_cmd_t t_tt_e_d0
  else
    if eq dirty 1
      tt_cmd_t t_tt_e_d1
    else
      tt_cmd_t t_tt_sp
    end
  end
  tt_cmd_evalt
  tt_cmd_t t_tt_f_params
  tt_cmd_p2
  tt_cmd_t t_tt_f_raw
  tt_cmd_p4
  tt_cmd_t t_tt_f_marks
  tt_cmd_p5
  if ne rec_flag 0
    tt_cmd_t t_tt_f_rec
  end
  tt_cmd_t t_tt_f_out
  tt_cmd_p3
  tt_cmd_t t_tt_devnull
  ret tt_sh_run
end


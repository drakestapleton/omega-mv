note ---- Test 8: fit tie break ----

fn tt_test_fit_tie_break to void
  ll = new f64 475 0.0
  for i ulong 19
    for j ulong 25
      put ll add mul i 25 j sub sub -100.0f64 f64 i f64 j
    end
  end
  put ll 132 -3.0f64
  put ll 134 -3.0f64
  put ll 177 -3.0f64
  put ll 182 -3.0f64
  bi = new long 1 -1
  bj = new long 1 -1
  tt_ck eq est_fit_pick view ll bi bj 0 801
  tt_ck and eq get bi 0 5 eq get bj 0 7 802
  put ll 78 est_nan
  put ll 79 est_inf
  tt_ck eq est_fit_pick view ll bi bj 0 803
  tt_ck and eq get bi 0 5 eq get bj 0 7 804
  ob_t t_tt_msg_tb
end


fn tt_check_ka_m1 to void
  mods = tt_js_find 0 t_tt_j_mods
  sc = ulong tt_js_find ulong mods t_tt_j_m1
  tt_ck tt_near tt_jv sc t_tt_j_mnis 1.8281515606971528f64 1030
  tt_ck tt_near tt_jv sc t_tt_j_sb 0.016086778302452025f64 1031
  tt_ck tt_near tt_jv sc t_tt_j_l1 -0.179859160525074f64 1032
  tt_ck tt_near tt_jv sc t_tt_j_rmse 20.539325725342962f64 1033
  tt_ck tt_near tt_jv sc t_tt_j_prmse 20.979581910582898f64 1034
  tt_ck tt_near tt_jv sc t_tt_j_lsc -4.573313892158871f64 1035
  vv = new f64 3 0.0
  put vv 0 0.32142857142857145f64
  put vv 1 0.179332468369093f64
  put vv 2 0.5066115696450038f64
  tt_ck_cov_w sc t_tt_j_cov50 view vv 1036
  put vv 0 0.5714285714285714f64
  put vv 1 0.39070785495839777f64
  put vv 2 0.7349145298359636f64
  tt_ck_cov_w sc t_tt_j_cov80 view vv 1039
  put vv 0 0.8214285714285714f64
  put vv 1 0.6440857505322257f64
  put vv 2 0.9212149810424002f64
  tt_ck_cov_w sc t_tt_j_cov95 view vv 1042
  tt_ck tt_near tt_jv sc t_tt_j_t10n 16.0f64 1045
  tp = ulong tt_js_find sc t_tt_j_t10
  tt_ck tt_near tt_jv tp t_tt_j_val 1.0f64 1046
  wp = tt_js_find tp t_tt_j_w95
  tt_ck tt_near tt_js_f64_at add ulong wp 12 0.8063923170025951f64 1047
  cp = tt_js_find_comma add ulong wp 12
  tt_ck tt_near tt_js_f64_at add ulong cp 1 1.0f64 1048
end

fn tt_write_ka_marks dir_suf view uchar * content view uchar * to void
  tt_p1_work dir_suf
  tt_rm_mkdir_p1
  tt_p3_from_p1 t_tt_mk_suf
  fd = fopen g_tt_p3 0 get g_tt_p3l 0 577 438
  ign = write int fd content 0 len content
  ign = fclose int fd
  h = new uchar 65 0
  ign = tt_sha_p3 h
  tt_p4_from_p1 t_tt_su_suf
  sfd = fopen g_tt_p4 0 get g_tt_p4l 0 577 438
  ob_flush
  ob_init int sfd
  ob_s view h 64
  ob_t t_tt_su_mk
  ob_flush
  ign = fclose int sfd
  ob_init 1
  for i ulong get g_tt_p3l 0
    put g_tt_p5 i get g_tt_p3 i
  end
  put g_tt_p5l 0 get g_tt_p3l 0
end

fn tt_check_ka_quarters s0 ulong to void
  p = ulong tt_js_find s0 t_tt_j_qc95
  qn = new ulong 4 6
  put qn 1 7
  put qn 2 7
  put qn 3 8
  qh = new ulong 4 5
  put qh 1 7
  put qh 2 6
  put qh 3 7
  for q ulong 4
    p = ulong tt_js_find p t_tt_j_qn
    tt_ck tt_near tt_js_f64_at add p 6 f64 get qn q 1051
    p = ulong tt_js_find p t_tt_j_val
    tt_ck tt_near tt_js_f64_at add p 9 div f64 get qh q f64 get qn q 1052
    p = add p 9
  end
end

fn tt_check_ka_unclosed to void
  tt_write_ka_marks t_tt_s_kam2 t_tt_ka_m2
  tt_run_eval_ka t_tt_s_kab
  ok2 = tt_slurp_p3
  tt_ck ok2 1066
  if ok2
    tt_ck tt_js_has t_tt_j_ubt 1067
    tt_ck tt_js_has t_tt_j_b1e0 1068
    mods = tt_js_find 0 t_tt_j_mods
    m0s = ulong tt_js_find ulong mods t_tt_j_m0
    ri = ulong tt_js_find m0s t_tt_j_idle
    rt = ulong tt_js_find m0s t_tt_j_intr
    tt_ck tt_near tt_js_f64_at add ri 14 2.0f64 1069
    tt_ck tt_near tt_js_f64_at add rt 18 26.0f64 1070
  end
  ob_t t_tt_msg_ub
end

fn tt_test_known_answers to void
  tt_ka_init_vals
  tt_write_ka_marks t_tt_s_kam1 t_tt_ka_m1
  tt_run_eval_ka t_tt_s_kaa
  ok = tt_slurp_p3
  tt_ck ok 1002
  if not ok
    ret
  end
  tt_check_ka_m0
  tt_check_ka_m1
  mods = tt_js_find 0 t_tt_j_mods
  s0 = ulong tt_js_find ulong mods t_tt_j_m0
  tt_ck tt_near tt_jv s0 t_tt_j_samp 28.0f64 1050
  tt_check_ka_quarters s0
  r0 = ulong tt_js_find s0 t_tt_j_idle
  tt_ck tt_near tt_js_f64_at add r0 14 15.0f64 1053
  tt_ck tt_near tt_jv r0 t_tt_j_val div 13.0f64 15.0f64 1054
  r1 = ulong tt_js_find s0 t_tt_j_intr
  tt_ck tt_near tt_js_f64_at add r1 18 13.0f64 1055
  tt_ck tt_near tt_jv r1 t_tt_j_val div 12.0f64 13.0f64 1056
  s1 = ulong tt_js_find ulong mods t_tt_j_m1
  r1i = ulong tt_js_find s1 t_tt_j_idle
  tt_ck tt_near tt_jv r1i t_tt_j_val div 11.0f64 15.0f64 1057
  r1t = ulong tt_js_find s1 t_tt_j_intr
  tt_ck tt_near tt_jv r1t t_tt_j_val div 12.0f64 13.0f64 1058
  tt_ck tt_js_has t_tt_j_cst2 1059
  tt_ck tt_js_has t_tt_j_bv1 1060
  tt_ck tt_js_has t_tt_j_bt1 1061
  tt_ck tt_js_has t_tt_j_hg1 1062
  tt_ck tt_js_has t_tt_j_ubf 1063
  tt_ck tt_near tt_jv 0 t_tt_j_zi 0.0f64 1064
  tt_ck ge tt_js_find s0 t_tt_j_span 0 1065
  ob_t t_tt_msg_ka
  tt_check_ka_unclosed
end

note ---- Test 11: mixture known answers & EM recovery ----

fn tt_mix_eq a view EstMix b view EstMix to bool
  if ne get a k get b k
    ret false
  end
  for i ulong 3
    if ne bitcast ulong get a w i bitcast ulong get b w i
      ret false
    end
    if ne bitcast ulong get a v i bitcast ulong get b v i
      ret false
    end
  end
  ret true
end

fn tt_mix_ka_g to void
  g = new EstMix 1 1.0f64 1.0f64
  put g w 0 1.0f64
  put g v 0 1.0f64
  res = new f64 1 0.0
  rc = est_mix_cdf_abs view g 1 1.959963984540054f64 res
  tt_ck and eq rc EST_OK lt fabs sub get res 0 0.95f64 1.0e-12f64 1101
  rc = est_mix_quantile_abs view g 1 0.95f64 res
  tt_ck and eq rc EST_OK lt fabs sub get res 0 1.959963984540054f64 1.0e-9f64 1102
  rc = est_mix_quantile_abs view g 4 0.95f64 res
  tt_ck and eq rc EST_OK lt fabs sub get res 0 mul 2.0f64 1.959963984540054f64 1.0e-9f64 1103
  rc = est_mix_logpdf view g 1 0.0f64 res
  tt_ck and eq rc EST_OK lt fabs add get res 0 mul 0.5f64 est_log 6.283185307179586f64 1.0e-14f64 1104
end

fn tt_mix_ka_cdf to void
  tt_mix_ka_g
  res = new f64 1 0.0
  m = new EstMix 2 0.5f64 1.0f64
  put m w 0 0.5f64
  put m w 1 0.5f64
  put m v 0 1.0f64
  put m v 1 4.0f64
  want1 = add mul 0.5f64 est_erf div 1.5f64 fsqrt 2.0f64 mul 0.5f64 est_erf div 1.5f64 fsqrt 8.0f64
  rc = est_mix_cdf_abs view m 1 1.5f64 res
  tt_ck and eq rc EST_OK lt fabs sub get res 0 want1 1.0e-14f64 1105
  want2 = add add mul 0.25f64 est_erf div 3.0f64 2.0f64 mul 0.5f64 est_erf div 3.0f64 fsqrt 10.0f64 mul 0.25f64 est_erf div 3.0f64 4.0f64
  rc = est_mix_cdf_abs view m 2 3.0f64 res
  tt_ck and eq rc EST_OK lt fabs sub get res 0 want2 1.0e-14f64 1106
  t1 = mul 0.25f64 est_exp mul -0.5f64 add est_log mul 6.283185307179586f64 2.0f64 0.5f64
  t2 = mul 0.5f64 est_exp mul -0.5f64 add est_log mul 6.283185307179586f64 5.0f64 0.2f64
  t3 = mul 0.25f64 est_exp mul -0.5f64 add est_log mul 6.283185307179586f64 8.0f64 0.125f64
  lw = est_log add add t1 t2 t3
  rc = est_mix_logpdf view m 2 1.0f64 res
  tt_ck and eq rc EST_OK lt fabs sub get res 0 lw 1.0e-13f64 1107
  tt_ck lt fabs sub est_mix_total_var view m 2.5f64 1.0e-15f64 1108

  bad = new EstMix 2 0.5f64 1.0f64
  put bad w 0 0.5f64
  put bad w 1 0.6f64
  put bad v 0 1.0f64
  put bad v 1 4.0f64
  tt_ck ne est_mix_check view bad EST_OK 1109
  tt_ck ne est_mix_cdf_abs view m 0 1.0f64 res EST_OK 1110
  tt_ck ne est_mix_cdf_abs view m add EST_MIX_MAX_H 1 1.0f64 res EST_OK 1111
end

fn tt_test_mix_known_answers to void
  tt_mix_ka_cdf
  ign = enlarge g_em_e 20000
  put g_tt_rng 0 777
  for i ulong 20000
    sc = f64 1000.0
    if lt tt_unif 0.3f64
      sc = 10.0f64
    end
    put g_em_e i mul sc tt_gauss
  end
  f1 = new EstMix 2 0.0f64 0.0f64
  f2 = new EstMix 2 0.0f64 0.0f64
  l1 = new f64 1 0.0
  l2 = new f64 1 0.0
  tt_ck eq est_mix_fit_em 20000 2 1.0f64 500 f1 l1 EST_OK 1112
  tt_ck eq est_mix_fit_em 20000 2 1.0f64 500 f2 l2 EST_OK 1113
  tt_ck and tt_mix_eq view f1 view f2 eq bitcast ulong get l1 0 bitcast ulong get l2 0 1114
  tt_ck lt fabs sub get f1 w 0 0.3f64 0.02f64 1115
  tt_ck lt fabs sub fsqrt get f1 v 0 10.0f64 1.0f64 1116
  tt_ck lt fabs sub fsqrt get f1 v 1 1000.0f64 30.0f64 1117
  ob_t t_tt_msg_mx1
  ob_fix get f1 w 0 3
  ob_t t_tt_msg_mx2
  ob_fix fsqrt get f1 v 0 2
  ob_c 44
  ob_fix fsqrt get f1 v 1 1
  ob_c 41
  ob_nl
end

note ---- Test 12: protocol v2 / M2 ----

text t_tt_s_v2fd "/v2/s-est3b-fit-silicon"
text t_tt_s_v2hd "/v2/s-est3b-heldout-silicon"
text t_tt_s_v2no "/v2/no.txt"
text t_tt_s_v2p2 "/v2/params2.txt"
text t_tt_s_v2p2b "/v2/params2b.txt"
text t_tt_s_v2p2c "/v2/params2c.txt"

fn tt_pkt_put16 off ulong v ulong to void
  put g_tt_pkt off uchar and v 255
  put g_tt_pkt add off 1 uchar and shr v 8 255
end

fn tt_sh_run to long
  ob_flush
  clen = get g_tt_cmdl 0
  tt_pkt_put16 0 3
  off = ulong 2
  tt_pkt_put16 off 7
  off = add off 2
  for i ulong 7
    put g_tt_pkt add off i get t_tt_sh_bin i
  end
  off = add off 7
  tt_pkt_put16 off 2
  off = add off 2
  put g_tt_pkt off get t_tt_sh_c 0
  put g_tt_pkt add off 1 get t_tt_sh_c 1
  off = add off 2
  tt_pkt_put16 off clen
  off = add off 2
  for i ulong clen
    put g_tt_pkt add off i get g_tt_cmd i
  end
  off = add off clen
  pid = fork
  if lt pid 0
    ret -1
  end
  if eq pid 0
    ign = execprog g_tt_pkt 0 off
    exit 127
  end
  st = new uchar 4 0
  r = waitpid int pid st 0 4 0
  if ne r pid
    ret -1
  end
  if ne get st 0 0
    ret add 128 long and ulong get st 0 127
  end
  ret long get st 1
end

note ---- Path buffer helpers (p1..p5) ----

fn tt_p1_work suf view uchar * to void
  wl = get g_tt_workl 0
  for i ulong wl
    put g_tt_p1 i get g_tt_work i
  end
  sl = len suf
  for i ulong sl
    put g_tt_p1 add wl i get suf i
  end
  put g_tt_p1l 0 add wl sl
end


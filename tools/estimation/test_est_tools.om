text t_tt_f_pv2 " --protocol-v2 "
text t_tt_f_pv2s " --protocol-v2 --synthetic-test --params2 "
text t_tt_f_p2 " --params2 "
text t_tt_f_pdoc " --protocol-doc "
text t_tt_cmps "cmp -s "
text t_tt_sed_c9 "sed 's/^c2 w/c9 w/' "
text t_tt_gt " > "
text t_tt_gt2 " 2>"
text t_tt_ev2doc "echo frozen-v2 > "
text t_tt_e_c2r "EST_TEST_C2_RAW_SHA="
text t_tt_e_c2m " EST_TEST_C2_MARKS_SHA="
text t_tt_e_c1 " EST_TEST_C1_SHA="
text t_tt_e_doc " EST_TEST_V2_DOC_SHA="

fn tt_env_append s view uchar * n ulong to void
  pos = get g_tt_envl 0
  for i ulong n
    put g_tt_env add pos i get s i
  end
  put g_tt_envl 0 add pos n
end

fn tt_env_build_v2 h1 view uchar 65 h2 view uchar 65 hf view uchar 65 hdoc view uchar 65 to void
  put g_tt_envl 0 0
  tt_env_append t_tt_e_c2r len t_tt_e_c2r
  tt_env_append h1 64
  tt_env_append t_tt_e_c2m len t_tt_e_c2m
  tt_env_append h2 64
  tt_env_append t_tt_e_c1 len t_tt_e_c1
  tt_env_append hf 64
  tt_env_append t_tt_e_doc len t_tt_e_doc
  tt_env_append hdoc 64
end

fn tt_m2_check_p2 to void
  tt_p2_work t_tt_s_v2p2
  tt_ck eq tt_params2_read_p2 0 1205
  tt_ck eq get g_ep2_mk 0 EST_M2_K 1206
  tt_ck eq get g_ep2_r 0 EST_M2_R 1207
  mx = new EstMix 3 0.0f64 0.0f64
  put mx k get g_ep2_mk 0
  for i ulong 3
    put mx w i get g_ep2_mw i
    put mx v i get g_ep2_mv i
  end
  tt_ck le fabs sub get g_ep2_q 0 est_mix_total_var view mx mul 1.0e-12f64 get g_ep2_q 0 1208
  tt_p2_work t_tt_s_v2p2c
  tt_ck eq tt_params2_write_p2 0 1209
  tt_p1_work t_tt_s_v2p2
  tt_cmd_reset
  tt_cmd_t t_tt_cmps
  tt_cmd_p1
  tt_cmd_t t_tt_sp
  tt_cmd_p2
  tt_ck eq tt_sh_run 0 1210
  tt_p3_work t_tt_s_v2p2bad
  tt_cmd_reset
  tt_cmd_t t_tt_sed_c9
  tt_cmd_p1
  tt_cmd_t t_tt_gt
  tt_cmd_p3
  ign = tt_sh_run
  tt_p2_work t_tt_s_v2p2bad
  tt_ck ne tt_params2_read_p2 0 1211
  note M2 replay mean is exact persistence
  tt_p1_work t_tt_s_v2fd
  tt_p2_from_p1 t_tt_ms_suf
  tt_ck eq tt_file_load_p2 0 0 1212
  tt_p2_work t_tt_s_v2p2
  tt_ck eq tt_params2_read_p2 0 1213
  tt_ck eq est_replay_run 0 ER_ALL_LINES 2 get g_ep2_q 0 get g_ep2_r 0 0 0 1214
  ns = get g_rp_meta 0
  tt_ck eq est_m2_changes 0 ns long get g_ep2_fn 0 1215
end

fn tt_run_evalt_v2 dirty ulong to long
  tt_cmd_reset
  tt_cmd_env
  if eq dirty 0
    tt_cmd_t t_tt_e_d0
  else
    tt_cmd_t t_tt_e_d1
  end
  tt_cmd_evalt
  tt_cmd_t t_tt_f_pv2
  tt_cmd_t t_tt_f_p2
  tt_cmd_p2
  tt_cmd_t t_tt_f_raw
  tt_cmd_p4
  tt_cmd_t t_tt_f_marks
  tt_cmd_p5
  tt_cmd_t t_tt_f_pdoc
  tt_cmd_work
  tt_cmd_t t_tt_s_v2doc
  tt_cmd_t t_tt_f_rec
  tt_cmd_t t_tt_f_out
  tt_cmd_p3
  tt_cmd_t t_tt_devnull
  ret tt_sh_run
end

fn tt_test_m2_recorded to void
  h1 = new uchar 65 0
  h2 = new uchar 65 0
  hf = new uchar 65 0
  hdoc = new uchar 65 0
  tt_p1_work t_tt_s_v2hd
  tt_p2_from_p1 t_tt_ms_suf
  tt_p3_from_p1 t_tt_mk_suf
  ign = tt_sha_p2 h1
  ign = tt_sha_p3 h2
  tt_p1_work t_tt_s_v2fd
  tt_p2_from_p1 t_tt_ms_suf
  ign = tt_sha_p2 hf
  tt_p2_work t_tt_s_v2doc
  tt_cmd_reset
  tt_cmd_t t_tt_ev2doc
  tt_cmd_p2
  ign = tt_sh_run
  ign = tt_sha_p2 hdoc
  tt_env_build_v2 view h1 view h2 view hf view hdoc
  tt_p1_work t_tt_s_v2hd
  tt_p4_from_p1 t_tt_ms_suf
  tt_p5_from_p1 t_tt_mk_suf
  tt_p2_work t_tt_s_v2p2
  tt_p3_work t_tt_s_v2z
  tt_ck ne tt_run_evalt_v2 1 0 1222
  tt_p3_work t_tt_s_v2rec
  tt_ck eq tt_run_evalt_v2 0 0 1223
  ok = tt_slurp_p3
  tt_ck ok 1224
  if ok
    tt_ck tt_js_has t_tt_j_v2rec 1225
    tt_ck and tt_js_has t_tt_j_rec_t tt_js_has t_tt_j_c2ho 1226
    tt_ck tt_js_has t_tt_j_m2per 1227
    mods = tt_js_find 0 t_tt_j_mods2
    m2 = tt_js_find ulong mods t_tt_j_m2
    tt_ck ge m2 0 1228
    cal = tt_js_find ulong m2 t_tt_j_cal_sp
    tt_ck tt_js_match_at cal 14 t_tt_j_true 1229
    tt_ck ge tt_js_find ulong m2 t_tt_j_rmsenw 0 1230
    tt_ck tt_js_has t_tt_j_sel_m2 1231
    tt_ck tt_js_has t_tt_j_rs_pass 1232
    tt_ck tt_js_has t_tt_j_cal_pass 1233
  end
  tt_ck ne tt_run_evalt_v2 0 0 1234
  ob_t t_tt_msg_m2
end

fn tt_test_m2 to void
  tt_p1_work t_tt_s_v2fd
  tt_make_mix_series 4000 4242
  tt_p1_work t_tt_s_v2hd
  tt_make_mix_series 4000 5353
  tt_p1_work t_tt_s_v2hd
  tt_p2_from_p1 t_tt_ms_suf
  tt_p3_work t_tt_s_parA
  tt_p4_work t_tt_s_v2no
  note fit refuses held-out by path
  tt_cmd_reset
  tt_cmd_fit
  tt_cmd_t t_tt_f_m2syn
  tt_cmd_p2
  tt_cmd_t t_tt_sp
  tt_cmd_p3
  tt_cmd_t t_tt_sp
  tt_cmd_p4
  tt_cmd_t t_tt_devnull
  tt_ck ne tt_sh_run 0 1201
  note without --synthetic-test only C1 accepted
  tt_p1_work t_tt_s_v2fd
  tt_p2_from_p1 t_tt_ms_suf
  tt_cmd_reset
  tt_cmd_fit
  tt_cmd_t t_tt_f_m2
  tt_cmd_p2
  tt_cmd_t t_tt_sp
  tt_cmd_p3
  tt_cmd_t t_tt_sp
  tt_cmd_p4
  tt_cmd_t t_tt_devnull
  tt_ck ne tt_sh_run 0 1202
  note fit twice and check determinism
  tt_p4_work t_tt_s_v2p2
  tt_cmd_reset
  tt_cmd_fit
  tt_cmd_t t_tt_f_m2syn
  tt_cmd_p2
  tt_cmd_t t_tt_sp
  tt_cmd_p3
  tt_cmd_t t_tt_sp
  tt_cmd_p4
  tt_cmd_t t_tt_devnull
  tt_ck eq tt_sh_run 0 1203
  tt_p5_work t_tt_s_v2p2b
  tt_cmd_reset
  tt_cmd_fit
  tt_cmd_t t_tt_f_m2syn
  tt_cmd_p2
  tt_cmd_t t_tt_sp
  tt_cmd_p3
  tt_cmd_t t_tt_sp
  tt_cmd_p5
  tt_cmd_t t_tt_devnull
  tt_ck eq tt_sh_run 0 1204
  tt_cmd_reset
  tt_cmd_t t_tt_cmps
  tt_cmd_p4
  tt_cmd_t t_tt_sp
  tt_cmd_p5
  tt_ck eq tt_sh_run 0 1235
  tt_m2_check_p2
  note held-out refused by v1 and v2 eval unless recorded
  tt_p1_work t_tt_s_v2hd
  tt_p4_from_p1 t_tt_ms_suf
  tt_p5_from_p1 t_tt_mk_suf
  tt_p2_work t_tt_s_v2p2
  tt_p3_work t_tt_s_v2x
  tt_cmd_reset
  tt_cmd_eval
  tt_cmd_t t_tt_f_pv2s
  tt_cmd_p2
  tt_cmd_t t_tt_f_raw
  tt_cmd_p4
  tt_cmd_t t_tt_f_marks
  tt_cmd_p5
  tt_cmd_t t_tt_f_out
  tt_cmd_p3
  tt_cmd_t t_tt_gt2
  tt_cmd_work
  tt_cmd_t t_tt_s_v2xe
  tt_ck ne tt_sh_run 0 1216
  tt_p2_work t_tt_s_parA
  tt_p3_work t_tt_s_v2y
  tt_cmd_reset
  tt_cmd_eval
  tt_cmd_t t_tt_f_params
  tt_cmd_p2
  tt_cmd_t t_tt_f_raw
  tt_cmd_p4
  tt_cmd_t t_tt_f_marks
  tt_cmd_p5
  tt_cmd_t t_tt_f_out
  tt_cmd_p3
  tt_cmd_t t_tt_gt2
  tt_cmd_work
  tt_cmd_t t_tt_s_v2ye
  tt_ck ne tt_sh_run 0 1217
  tt_p3_work t_tt_s_v2xe
  tt_ck and tt_slurp_p3 tt_js_has t_tt_ho 1218
  tt_p3_work t_tt_s_v2ye
  tt_ck and tt_slurp_p3 tt_js_has t_tt_ho 1219
  tt_p1_work t_tt_s_v2hd
  tt_p2_from_p1 t_tt_ms_suf
  tt_ck ne tt_file_load_p2 0 0 1220
  tt_ck tt_err_has t_tt_ho 1221
  tt_test_m2_recorded
end

note ---- Main ----

fn tt_load_args to bool
  if ne argcnt 5
    ret false
  end
  n1 = argread 1 g_tt_fit 0 1024
  n2 = argread 2 g_tt_eval 0 1024
  n3 = argread 3 g_tt_evalt 0 1024
  n4 = argread 4 g_tt_work 0 1024
  if or le n1 0 or le n2 0 or le n3 0 le n4 0
    ret false
  end
  put g_tt_fitl 0 ulong n1
  put g_tt_evall 0 ulong n2
  put g_tt_evaltl 0 ulong n3
  put g_tt_workl 0 ulong n4
  ret true
end

fn main to int
  ob_init 1
  if not tt_load_args
    ob_init 2
    ob_t t_tt_usage
    ob_flush
    ret 2
  end
  tt_cmd_reset
  tt_cmd_t t_tt_mkdirp
  tt_cmd_work
  ign = tt_sh_run
  tt_test_prefix_run_a
  tt_test_coasting
  tt_test_sha_refusal
  tt_test_synthetic
  tt_test_run_a_and_flags
  tt_test_recorded_path
  tt_test_params_validation
  tt_test_fit_tie_break
  tt_test_parse_and_gaps
  tt_test_known_answers
  tt_test_mix_known_answers
  tt_test_m2
  ob_t t_tt_msg_sum1
  ob_u get g_tt_checks 0
  ob_t t_tt_msg_sum2
  ob_u get g_tt_fail 0
  ob_t t_tt_msg_sum3
  if ne get g_tt_fail 0 0
    ob_t t_tt_msg_fail
    ob_flush
    ret 1
  end
  ob_t t_tt_msg_pass
  ob_flush
  ret 0
end

fn tt_run_eval_ka dir_suf view uchar * to void
  tt_p1_work dir_suf
  tt_rm_mkdir_p1
  tt_p2_from_p1 t_tt_ms_suf
  fd = fopen g_tt_p2 0 get g_tt_p2l 0 577 438
  ob_flush
  ob_init int fd
  for i ulong 60
    if eq i 40
      ob_t t_tt_ka_p40
    else
      if eq i 45
        ob_t t_tt_ka_p45
      else
        ob_t t_tt_j_t
        if lt i 35
          ob_i add long 1790000000 long i
          ob_t t_tt_ka_f0
        else
          ob_i add long 1790000001 long i
          ob_t t_tt_ka_f5
        end
        ob_u i
        ob_t t_tt_j_th
        ob_u get g_tt_ka_v i
        ob_t t_tt_ka_end
      end
    end
  end
  ob_flush
  ign = fclose int fd
  ob_init 1
  tt_write_sums_p1 0
  for i ulong len t_tt_ka_fp
    put g_ep1_path i get t_tt_ka_fp i
  end
  put g_ep1_plen 0 len t_tt_ka_fp
  for i ulong 64
    put g_ep1_sha i 98
  end
  put g_ep1_lines 0 0
  for m ulong 2
    put g_ep1_q m est_grid_q 8
    put g_ep1_r m est_grid_r 8
    put g_ep1_ll m -1.0f64
  end
  tt_p2_from_p1 t_tt_s_par
  ign = tt_params_write_p2
  tt_p4_from_p1 t_tt_ms_suf
  tt_p3_from_p1 t_tt_s_rec
  tt_ck eq tt_run_eval_syn 0 1001
end

fn tt_ck_cov_w sc ulong key view uchar * vals view f64 3 id ulong to void
  tt_ck tt_near tt_jv sc key get vals 0 id
  p = tt_js_find sc key
  wp = tt_js_find ulong p t_tt_j_w95
  tt_ck tt_near tt_js_f64_at add ulong wp 12 get vals 1 add id 1
  cp = tt_js_find_comma add ulong wp 12
  tt_ck tt_near tt_js_f64_at add ulong cp 1 get vals 2 add id 2
end


  put vv 0 0.8928571428571429f64
  put vv 1 0.7280414829086315f64
  put vv 2 0.962881633460356f64
  tt_ck_cov_w sc t_tt_j_cov95 view vv 1022
  tt_ck tt_near tt_jv sc t_tt_j_t10n 16.0f64 1025
  tp = ulong tt_js_find sc t_tt_j_t10
  tt_ck tt_near tt_jv tp t_tt_j_val 0.6875f64 1026
  wp = tt_js_find tp t_tt_j_w95

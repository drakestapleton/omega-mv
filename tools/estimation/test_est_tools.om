note ---- Check / print helpers ----

fn tt_ck cond bool id ulong to void
  put g_tt_checks 0 add get g_tt_checks 0 1
  if not cond
    put g_tt_fail 0 add get g_tt_fail 0 1
    ob_flush
    ob_init 2
    ob_t t_tt_fail_pre
    ob_u id
    ob_nl
    ob_flush
    ob_init 1
  end
end

fn tt_near a f64 b f64 to bool
  if or est_isnan a est_isnan b
    ret false
  end
  ret le fabs sub a b mul 1.0e-9f64 add 1.0f64 fabs b
end

note ---- PRNG & Gaussian ----

fn tt_rnd to ulong
  r = get g_tt_rng 0
  r = xor r shr r 12
  r = xor r shl r 25
  r = xor r shr r 27
  put g_tt_rng 0 r
  ret mul r ulong 0x2545f4914f6cdd1d
end

fn tt_unif to f64
  u = f64 shr tt_rnd 11
  ret div add u 0.5f64 9007199254740992.0f64
end

fn tt_gauss to f64
  u1 = tt_unif
  u2 = tt_unif
  r = fsqrt mul -2.0f64 est_log u1
  c = est_cos mul 6.283185307179586f64 u2
  ret mul r c
end

note ---- Command builder & shell runner ----

fn tt_cmd_reset to void
  put g_tt_cmdl 0 0
end

fn tt_cmd_c c uchar to void
  n = get g_tt_cmdl 0
  if lt n 16383
    put g_tt_cmd n c
    put g_tt_cmdl 0 add n 1
  end
end

fn tt_cmd_s s view uchar * n ulong to void
  for i ulong n
    tt_cmd_c get s i
  end
end

fn tt_cmd_t s view uchar * to void
  tt_cmd_s s len s
end

fn tt_cmd_fit to void
  n = get g_tt_fitl 0
  for i ulong n
    tt_cmd_c get g_tt_fit i
  end
end

fn tt_cmd_eval to void
  n = get g_tt_evall 0
  for i ulong n
    tt_cmd_c get g_tt_eval i
  end
end


fn tt_test_synthetic_bad to void
  put g_ep1_r 0 1.0f64
  put g_ep1_r 1 1.0f64
  tt_p1_work t_tt_s_sfit
  tt_p2_from_p1 t_tt_s_pbad
  tt_ck eq tt_params_write_p2 0 412
  tt_p1_work t_tt_s_seval
  tt_p3_from_p1 t_tt_s_rbad
  tt_p4_from_p1 t_tt_ms_suf
  tt_p5_from_p1 t_tt_mk_suf
  tt_ck eq tt_run_eval_syn 0 413
  ok = tt_slurp_p3
  tt_ck ok 414
  if ok
    m0 = tt_js_find 0 t_tt_j_m0
    tt_ck ge m0 0 415
    cal = tt_js_find ulong m0 t_tt_j_cal
    tt_ck tt_js_match_at cal 14 t_tt_j_false 416
    tt_ck tt_js_has t_tt_j_cal_fail 417
    tt_ck tt_js_has t_tt_j_fc50 418
    c95p = tt_js_find ulong m0 t_tt_j_c95
    c95 = tt_jv ulong c95p t_tt_j_val
    ob_t t_tt_msg_sb1
    ob_fix c95 4
    ob_nl
  end
  tt_p1_work t_tt_s_sfit
  tt_p2_from_p1 t_tt_s_par
  tt_p1_work t_tt_s_seval
  tt_p3_from_p1 t_tt_s_xjs
  tt_cmd_reset
  tt_cmd_eval
  tt_cmd_t t_tt_f_params
  tt_cmd_p2
  tt_cmd_t t_tt_f_raw
  tt_cmd_p4
  tt_cmd_t t_tt_f_marks
  tt_cmd_p5
  tt_cmd_t t_tt_f_out
  tt_cmd_p3
  tt_cmd_t t_tt_devnull
  tt_ck ne tt_sh_run 0 419
end

fn tt_test_synthetic to void
  q = est_pow 10.0f64 1.5f64
  r = est_pow 10.0f64 3.5f64
  tt_p1_work t_tt_s_sfit
  tt_make_series 5000 q r 101 0
  tt_p1_work t_tt_s_seval
  tt_make_series 4000 q r 202 0
  tt_p1_work t_tt_s_sfit
  tt_p4_from_p1 t_tt_ms_suf
  tt_p2_from_p1 t_tt_s_par
  tt_cmd_reset
  tt_cmd_fit
  tt_cmd_t t_tt_f_syn
  tt_cmd_p4
  tt_cmd_t t_tt_sp
  tt_cmd_p2
  tt_cmd_t t_tt_devnull
  tt_ck eq tt_sh_run 0 401
  tt_ck eq tt_params_read_p2 0 402
  dq = fabs sub er_log10 get g_ep1_q 0 1.5f64
  dr = fabs sub er_log10 get g_ep1_r 0 3.5f64
  tt_ck le dq add 0.5f64 1.0e-9f64 403
  tt_ck le dr add 0.25f64 1.0e-9f64 404
  ob_t t_tt_msg_syn1
  ob_gp q 4
  ob_t t_tt_msg_syn2
  ob_gp r 4
  ob_t t_tt_msg_syn3
  ob_gp get g_ep1_q 0 4
  ob_t t_tt_msg_syn2
  ob_gp get g_ep1_r 0 4
  ob_t t_tt_msg_syn4
  ob_fix div dq 0.5f64 1
  ob_t t_tt_msg_syn5
  ob_fix div dr 0.25f64 1
  ob_t t_tt_msg_syn6
  if and le dq add 0.5f64 1.0e-9f64 le dr add 0.25f64 1.0e-9f64
    ob_t t_tt_pass
  else
    ob_t t_tt_fail
  end
  ob_nl
  tt_p1_work t_tt_s_seval
  tt_p3_from_p1 t_tt_s_rec
  tt_p4_from_p1 t_tt_ms_suf
  tt_p5_from_p1 t_tt_mk_suf
  tt_ck eq tt_run_eval_syn 0 405
  ok = tt_slurp_p3
  tt_ck ok 406
  if ok
    m0 = tt_js_find 0 t_tt_j_m0
    tt_ck ge m0 0 407
    cal = tt_js_find ulong m0 t_tt_j_cal
    tt_ck tt_js_match_at cal 14 t_tt_j_true 408
    tt_ck tt_js_has t_tt_j_rs_pass 409
    tt_ck tt_js_has t_tt_j_cal_pass 410
    tt_ck tt_js_has t_tt_j_sel_m0 411
    tt_ck tt_js_has t_tt_j_rec_f 420
    tt_ck tt_js_has t_tt_j_pcom 421
    c95p = tt_js_find ulong m0 t_tt_j_c95
    c95 = tt_jv ulong c95p t_tt_j_val
    ob_t t_tt_msg_se1
    ob_fix c95 4
    ob_t t_tt_msg_se2
  end
  tt_test_synthetic_bad
end


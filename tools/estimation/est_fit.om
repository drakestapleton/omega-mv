note
note tools/estimation/est_fit.om -- EST-2 fit (protocol v1 grid search, v2 M2 EM) in pure seeded OM-2.
note Composed after: est_defs.om est_math.om est_types.om est_kf.om est_mix.om est_replay.om.

text t_ef_m2 "--m2"
text t_ef_syn "--synthetic-test"
text t_ef_u1 "usage: est_fit [--synthetic-test] <run-A machine-state.ndjson> <out-params>\n"
text t_ef_u2 "usage: est_fit --m2 [--synthetic-test] <C1 machine-state.ndjson> <v1 params> <out-params2>\n"
text t_ef_r_c1 "refuse: est_fit --m2 fits run C1 only (path tag "
text t_ef_r_c1b " and SHA-256 "
text t_ef_r_c1c ")\n"
text t_ef_r_v1 "refuse: v1 parameter file "
text t_ef_r_v1b " is not valid\n"
text t_ef_r_ra "refuse: est_fit fits run A only (SHA-256 is not run A's)\n"
text t_ef_r_rp "replay failed: "
text t_ef_r_rpm "replay failed M"
text t_ef_r_rpq " q="
text t_ef_r_pe "refuse: replay mean is not persistence, or too few changes\n"
text t_ef_r_em "EM fit refused\n"
text t_ef_r_wr "cannot write "
text t_ef_r_nf "no finite likelihood for M"
text t_ef_m2s1 "M2: changes="
text t_ef_m2s2 " zero_fraction="
text t_ef_m2s3 " q="
text t_ef_m2s4 " loglik="
text t_ef_c1 "  c"
text t_ef_c2 " w="
text t_ef_c3 " sd="
text t_ef_g1 "M"
text t_ef_g2 ": q="
text t_ef_g3 " r="
text t_ef_g3a " (10^"
text t_ef_g3b ")"
text t_ef_g4 " loglik="
text t_ef_g5 " over "
text t_ef_g6 " steps\n"
text t_ef_sp2 "  "

global g_ef_grid f64 475
global g_ef_cnt ulong 475

fn ef_m2_prep synth ulong data view uchar 1024 dl ulong v1 view uchar 1024 v1l ulong to int
  fsha = new uchar 65 0
  v1s = new uchar 65 0
  if ne er_file_load 0 data dl 0
    er_err_print_ref
    ret 1
  end
  er_file_get_sha 0 fsha
  if eq synth 0
    has_tag = ge er_find data dl t_er_v2_fit_tag len t_er_v2_fit_tag 0
    has_sha = er_eq view fsha 64 t_er_v2_fit_sha 64
    if not and has_tag has_sha
      ob_init 2
      ob_t t_ef_r_c1
      ob_t t_er_v2_fit_tag
      ob_t t_ef_r_c1b
      ob_t t_er_v2_fit_sha
      ob_t t_ef_r_c1c
      ob_flush
      ret 2
    end
  end
  if or ne est_params_read v1 v1l 0 ne est_params_validate 0
    ob_init 2
    ob_t t_ef_r_v1
    ob_s v1 v1l
    ob_t t_ef_r_v1b
    ob_flush
    ret 1
  end
  for i ulong v1l
    put g_ep2_v1p i get v1 i
  end
  put g_ep2_v1pl 0 v1l
  if ne er_sha_file v1 v1l v1s 0
    ret 1
  end
  for i ulong 64
    put g_ep2_v1s i get v1s i
  end
  for i ulong dl
    put g_ep2_fp i get data i
  end
  put g_ep2_fpl 0 dl
  for i ulong 64
    put g_ep2_fs i get fsha i
  end
  put g_ep2_flines 0 get g_ef_nlines 0
  ret 0
end

fn ef_m2_print_and_write outp view uchar 1024 ol ulong nu ulong mx view EstMix to int
  hx = new uchar 65 0
  zero = ulong 0
  for i ulong nu
    if eq get g_em_e i f64 0.0
      zero = add zero 1
    end
  end
  ob_init 2
  ob_t t_ef_m2s1
  ob_u nu
  ob_t t_ef_m2s2
  ob_fix div f64 zero f64 nu 6
  ob_t t_ef_m2s3
  ob_g17 get g_ep2_q 0
  ob_t t_ef_m2s4
  ob_fix get g_ep2_ll 0 6
  ob_nl
  for j ulong get mx k
    ob_t t_ef_c1
    ob_u j
    ob_t t_ef_c2
    ob_fix get mx w j 6
    ob_t t_ef_c3
    ob_fix fsqrt get mx v j 3
    ob_nl
  end
  ob_flush
  if ne est_params2_write outp ol 0
    ob_init 2
    ob_t t_ef_r_wr
    ob_s outp ol
    ob_nl
    ob_flush
    ret 1
  end
  if ne er_sha_file outp ol hx 0
    ret 1
  end
  ob_init 1
  ob_s view hx 64
  ob_t t_ef_sp2
  ob_s outp ol
  ob_nl
  ob_flush
  ret 0
end

fn ef_m2_store_mix mx view EstMix ll f64 to void
  put g_ep2_ll 0 ll
  put g_ep2_q 0 est_mix_total_var mx
  put g_ep2_r 0 EST_M2_R
  put g_ep2_mk 0 get mx k
  for j ulong get mx k
    put g_ep2_mw j get mx w j
    put g_ep2_mv j get mx v j
  end
end

fn ef_fit_m2 synth ulong data view uchar 1024 v1 view uchar 1024 outp view uchar 1024 lens view ulong 3 to int
  mx = new EstMix 0 0.0 0.0
  llo = new f64 1 0.0
  rc = ef_m2_prep synth data get lens 0 v1 get lens 1
  if ne rc 0
    ret rc
  end
  if ne est_replay_run 0 ulong 999999999 2 f64 1.0e6 EST_M2_R 0 0
    ob_init 2
    ob_t t_ef_r_rp
    er_rp_err_ob 0
    ob_nl
    ob_flush
    ret 1
  end
  nn = est_m2_changes 0 32768
  if lt nn 2
    est_eputs t_ef_r_pe
    ret 1
  end
  nu = ulong nn
  put g_ep2_fn 0 nu
  if ne est_mix_fit_em nu EST_M2_K EST_M2_FLOOR EST_M2_ITERS mx llo EST_OK
    est_eputs t_ef_r_em
    ret 1
  end
  ef_m2_store_mix view mx get llo 0
  ret ef_m2_print_and_write outp get lens 2 nu view mx
end

fn ef_grid_score_cell ix ulong to void
  ll = f64 0.0
  n = ulong 0
  ns = get g_rp_meta 0
  for k ulong ns
    fl = get g_rps_flags k
    if ne and fl 3 0
      continue
    end
    if lt get g_rps_L k EST_BURN_IN
      continue
    end
    sv = get g_rps_S k
    nuv = get g_rps_nu k
    term = add est_log mul f64 6.283185307179586 sv div mul nuv nuv sv
    ll = sub ll mul f64 0.5 term
    n = add n 1
  end
  put g_ef_grid ix ll
  put g_ef_cnt ix n
end

fn ef_grid_eval_cell m ulong q f64 r f64 ix ulong to long
  if ne est_replay_run 0 ulong 999999999 m q r 0 0
    ob_init 2
    ob_t t_ef_r_rpm
    ob_u m
    ob_t t_ef_r_rpq
    ob_gp q 6
    ob_t t_ef_g3
    ob_gp r 6
    ob_c 58
    ob_c 32
    er_rp_err_ob 0
    ob_nl
    ob_flush
    ret 1
  end
  ef_grid_score_cell ix
  ret 0
end

fn ef_fit_grid_model m ulong to long
  grid = new f64 475 0.0
  bi = new long 1 -1
  bj = new long 1 -1
  for i ulong EST_NQ
    q = est_grid_q long i
    for j ulong EST_NR
      ix = add mul i EST_NR j
      if ne ef_grid_eval_cell m q est_grid_r long j ix 0
        ret 1
      end
      put grid ix get g_ef_grid ix
    end
  end
  if ne est_fit_pick view grid bi bj 0
    ob_init 2
    ob_t t_ef_r_nf
    ob_u m
    ob_nl
    ob_flush
    ret 1
  end
  bii = get bi 0
  bjj = get bj 0
  ix = add mul ulong bii EST_NR ulong bjj
  put g_ep1_q m est_grid_q bii
  put g_ep1_r m est_grid_r bjj
  put g_ep1_ll m get g_ef_grid ix
  ob_init 2
  ob_t t_ef_g1
  ob_u m
  ob_t t_ef_g2
  ob_g17 get g_ep1_q m
  ob_t t_ef_g3a
  ob_fix add f64 -3.0 mul f64 0.5 f64 bii 1
  ob_t t_ef_g3b
  ob_t t_ef_g3
  ob_g17 get g_ep1_r m
  ob_t t_ef_g3a
  ob_fix mul f64 0.25 f64 bjj 2
  ob_t t_ef_g3b
  ob_t t_ef_g4
  ob_fix get g_ep1_ll m 6
  ob_t t_ef_g5
  ob_u get g_ef_cnt ix
  ob_t t_ef_g6
  ob_flush
  ret 0
end

fn ef_main_m2 ac long to int
  a2 = new uchar 1024 0
  d = new uchar 1024 0
  v1 = new uchar 1024 0
  o = new uchar 1024 0
  lens = new ulong 3 0
  synth = ulong 0
  idx = ulong 2
  if eq ac 6
    l2 = argread 2 a2 0 1024
    if and gt l2 0 er_eq view a2 ulong l2 t_ef_syn len t_ef_syn
      synth = 1
      idx = 3
    else
      est_eputs t_ef_u2
      ret 2
    end
  else
    if ne ac 5
      est_eputs t_ef_u2
      ret 2
    end
  end
  dl = argread idx d 0 1024
  v1l = argread add idx 1 v1 0 1024
  ol = argread add idx 2 o 0 1024
  if or le dl 0 or le v1l 0 le ol 0
    est_eputs t_ef_u2
    ret 2
  end
  put lens 0 ulong dl
  put lens 1 ulong v1l
  put lens 2 ulong ol
  ret ef_fit_m2 synth view d view v1 view o view lens
end

fn ef_main_v1 synth ulong idx ulong to int
  d = new uchar 1024 0
  o = new uchar 1024 0
  fsha = new uchar 65 0
  hx = new uchar 65 0
  dl = argread idx d 0 1024
  ol = argread add idx 1 o 0 1024
  if or le dl 0 le ol 0
    est_eputs t_ef_u1
    ret 2
  end
  if ne er_file_load 0 view d ulong dl 0
    er_err_print_ref
    ret 1
  end
  er_file_get_sha 0 fsha
  if and eq synth 0 not er_eq view fsha 64 t_er_run_a_sha 64
    est_eputs t_ef_r_ra
    ret 2
  end
  for i ulong ulong dl
    put g_ep1_path i get d i
  end
  put g_ep1_plen 0 ulong dl
  for i ulong 64
    put g_ep1_sha i get fsha i
  end
  put g_ep1_lines 0 get g_ef_nlines 0
  for m ulong 2
    if ne ef_fit_grid_model m 0
      ret 1
    end
  end
  if ne est_params_write view o ulong ol 0
    ob_init 2
    ob_t t_ef_r_wr
    ob_s view o ulong ol
    ob_nl
    ob_flush
    ret 1
  end
  if ne er_sha_file view o ulong ol hx 0
    ret 1
  end
  ob_init 1
  ob_s view hx 64
  ob_t t_ef_sp2
  ob_s view o ulong ol
  ob_nl
  ob_flush
  ret 0
end

fn main to int
  a1 = new uchar 1024 0
  ac = argcnt
  if lt ac 2
    est_eputs t_ef_u1
    ret 2
  end
  l1 = argread 1 a1 0 1024
  if lt l1 0
    est_eputs t_ef_u1
    ret 2
  end
  if er_eq view a1 ulong l1 t_ef_m2 len t_ef_m2
    ret ef_main_m2 ac
  end
  synth = ulong 0
  idx = ulong 1
  if eq ac 4
    if er_eq view a1 ulong l1 t_ef_syn len t_ef_syn
      synth = 1
      idx = 2
    else
      est_eputs t_ef_u1
      ret 2
    end
  else
    if ne ac 3
      est_eputs t_ef_u1
      ret 2
    end
  end
  ret ef_main_v1 synth idx
end

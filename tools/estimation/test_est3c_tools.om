  for i ulong len t_ct_k_scr
    put scr_key i get t_ct_k_scr i
    put scr_line i get t_ct_k_scr i
  end
  put scr_key len t_ct_k_scr uchar add 48 sel
  skl = add len t_ct_k_scr 1
  put scr_line len t_ct_k_scr uchar add 48 sel
  for i ulong len t_ct_r_scr2
    put scr_line add skl i get t_ct_r_scr2 i
  end
  sll = add skl len t_ct_r_scr2
  pl = ct_wpath t_ct_pscr len t_ct_pscr ptmp
  ct_ce_set_paths view pb pbl view ptmp pl
  ct_copy_edit view scr_key skl view scr_line sll
  ct_use_params view ptmp pl
  ct_set_pslot 5 t_ct_pscr len t_ct_pscr
  ct_check eq ct_run_eval 1 5 12 0 2 t_ct_m51
  ct_use_params_slot 10
  ct_check eq ct_run_eval 1 10 12 0 2 t_ct_m52
  pl = ct_wpath t_ct_pfail len t_ct_pfail ptmp
  ct_ce_set_paths view pb pbl view ptmp pl
  ct_ce_set_k2 t_ct_k_sel t_ct_r_seln
  ct_copy_edit t_ct_k_pha len t_ct_k_pha t_ct_r_pha len t_ct_r_pha
  ct_use_params view ptmp pl
  ct_set_pslot 6 t_ct_pfail len t_ct_pfail
  ct_check eq ct_run_eval 1 6 12 0 2 t_ct_m53
  ct_use_params_slot 11
  ct_setenv_pslot 2 t_ct_e_d1 1
  ct_check eq ct_run_eval 1 11 12 0 2 t_ct_m54
  ct_setenv_pslot 2 t_ct_e_d1 0
  ct_setenv 3 t_ct_e_d2r t_ct_sha0 len t_ct_sha0
  ct_check eq ct_run_eval 1 11 12 0 2 t_ct_m55
  ct_setenv_hex 3 t_ct_e_d2r 1 t_c3_fn_ndjson
  ct_check eq ct_run_eval 3 11 12 0 3 t_ct_m56
end

fn ct_check_zero_rec pslot ulong msg view uchar * to void
  rp = new uchar 1400 0
  rpl = new ulong 1 0
  ct_check eq ct_count_pslot pslot rp rpl 0 msg
end

fn ct_check_dup_err pdup view uchar * pdupl ulong msg view uchar * to void
  errb = new uchar 512 0
  rc = c3_params_read pdup pdupl
  el = get g_c3_elen 0
  for i ulong el bound 512
    put errb i get g_c3_err i
  end
  ct_check and ne rc 0 ge er_find view errb el t_ct_dup_w len t_ct_dup_w 0 msg
end

fn ct_test_dups sel ulong to void
  pb = new uchar 1200 0
  pdup = new uchar 1200 0
  sel_other = new uchar 32 0
  pbl = ct_get_pslot 11 pb
  pdupl = ct_wpath t_ct_pdup len t_ct_pdup pdup
  for i ulong len t_ct_r_self
    put sel_other i get t_ct_r_self i
  end
  put sel_other len t_ct_r_self uchar add 48 add rem sel 5 1
  put sel_other add len t_ct_r_self 1 10
  ct_ce_set_paths view pb pbl view pdup pdupl
  ct_copy_append view sel_other add len t_ct_r_self 2
  ct_check_dup_err view pdup pdupl t_ct_m71
  ct_ce_set_paths view pb pbl view pdup pdupl
  ct_copy_append t_ct_dup_e0 len t_ct_dup_e0
  ct_check eq c3_params_read view pb pbl 0 t_ct_m72
  ct_check_dup_err view pdup pdupl t_ct_m73
  ct_ce_set_paths view pb pbl view pdup pdupl
  ct_copy_append t_ct_dup_sr len t_ct_dup_sr
  ct_check_dup_err view pdup pdupl t_ct_m74
end

fn ct_find_in_fbuf tot ulong pat view uchar * pl ulong to bool
  if gt pl tot
    ret false
  end
  lim = add sub tot pl 1
  for i ulong lim bound ER_UNB
    ok = true
    for j ulong pl bound 128
      if ne get g_ct_fbuf add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn ct_test_recorded_body to void
  rp = new uchar 1400 0
  rpl = new ulong 1 0
  doc = new uchar 65 0
  pat = new uchar 96 0
  ct_check_zero_rec 12 t_ct_m57
  ct_check eq ct_run_eval 1 11 12 0 0 t_ct_m58
  ct_check eq ct_count_pslot 12 rp rpl 1 t_ct_m59
  rl = ct_slurp view rp get rpl 0
  ign_d = er_sha_file t_c3_proto_doc len t_c3_proto_doc doc
  for i ulong len t_ct_j_psha
    put pat i get t_ct_j_psha i
  end
  for i ulong 64
    put pat add len t_ct_j_psha i get doc i
  end
  put pat add len t_ct_j_psha 64 34
  patl = add len t_ct_j_psha 65
  ok60 = gt rl 0
  if ok60
    if not ct_find_in_fbuf ulong rl t_ct_j_verd len t_ct_j_verd
      ok60 = false
    end
  end
  if ok60
    if not ct_find_in_fbuf ulong rl view pat patl
      ok60 = false
    end
  end
  ct_check ok60 t_ct_m60
  ok61 = gt rl 0
  if ok61
    if not ct_find_in_fbuf ulong rl t_ct_j_e0 len t_ct_j_e0
      ok61 = false
    end
  end
  if ok61
    if not ct_find_in_fbuf ulong rl t_ct_j_f1 len t_ct_j_f1
      ok61 = false
    end
  end
  if ok61
    if not ct_find_in_fbuf ulong rl t_ct_j_inf len t_ct_j_inf
      ok61 = false
    end
  end
  ct_check ok61 t_ct_m61
  ign_h = er_sha_file view rp get rpl 0 doc
  ct_check ge er_find view rp get rpl 0 view doc 64 0 t_ct_m62
  ct_set_pslot 7 t_ct_o3 len t_ct_o3
  ct_check eq ct_run_eval 1 11 12 0 2 t_ct_m63
  ct_check eq ct_run_eval 1 11 7 0 2 t_ct_m64
  c3 = ct_count_pslot 7 rp rpl
  c1 = ct_count_pslot 12 rp rpl
  ct_check and eq c3 0 eq c1 1 t_ct_m65
  ct_check eq ct_run_eval 1 10 13 1 0 t_ct_m66
  ct_check eq ct_run_eval 0 10 7 1 2 t_ct_m67
  ct_check eq ct_run_eval 1 4 7 1 2 t_ct_m68
  ct_check eq ct_run_precheck 3 3 t_ct_m69
end

fn ct_test_recorded_and_dups sel ulong to void
  pb = new uchar 1200 0
  pbad = new uchar 1200 0
  ct_test_recorded_body
  pbl = ct_get_pslot 11 pb
  pbadl = ct_wpath t_ct_pbad len t_ct_pbad pbad
  ct_ce_set_paths view pb pbl view pbad pbadl
  ct_copy_edit t_ct_k_pdoc len t_ct_k_pdoc t_ct_r_pdoc len t_ct_r_pdoc
  ct_use_params view pbad pbadl
  ct_setenv_pslot 7 t_ct_e_rdir 7
  ct_set_pslot 8 t_ct_pbad len t_ct_pbad
  ct_check eq ct_run_eval 1 8 7 0 2 t_ct_m70
  ct_test_dups sel
end

fn main to int
  a1 = new uchar 1024 0
  a2 = new uchar 1024 0
  a3 = new uchar 1024 0
  if ne ulong argcnt 4
    ob_init 2
    ob_t t_ct_usage
    ob_flush
    ret 2
  end
  l1 = argread 1 a1 0 1024
  l2 = argread 2 a2 0 1024
  l3 = argread 3 a3 0 1024
  if or le l1 0 or le l2 0 le l3 0
    ret 2
  end
  for i ulong ulong l1 bound 1024
    put g_ct_fit i get a1 i
  end
  put g_ct_fit_l 0 ulong l1
  for i ulong ulong l2 bound 1024
    put g_ct_eval i get a2 i
  end
  put g_ct_eval_l 0 ulong l2
  for i ulong ulong l3 bound 1024
    put g_ct_w i get a3 i
  end
  put g_ct_w_l 0 ulong l3
  if ne makedir a3 0 ulong l3 493 0
    ob_init 2
    ob_t t_ct_mkd
    ob_flush
    ret 2
  end
  ct_test_ticks
  ob_init 1
  ob_t t_ct_done_tk
  ob_flush
  ct_test_precheck
  ob_init 1
  ob_t t_ct_done_pr
  ob_flush
  ct_test_select
  ob_init 1
  ob_t t_ct_done_sl
  ob_flush
  ct_test_e0
  ob_init 1
  ob_t t_ct_done_e0
  ob_flush
  ct_test_rule_order
  ob_init 1
  ob_t t_ct_done_ro
  ob_flush
  ct_setup_dirs
  sel = ct_test_fit_phase
  ct_test_eval_refusals sel
  ct_test_eval_refusals2 sel
  ct_test_recorded_and_dups sel
  ob_init 1
  ob_t t_ct_done_tl
  ob_t t_ct_sum1
  ob_u get g_ct_checks 0
  ob_t t_ct_sum2
  ob_u get g_ct_fails 0
  ob_t t_ct_sum3
  ob_flush
  if ne get g_ct_fails 0 0
    ret 1
  end
  ret 0
end

  ct_synth_go view d dl
  fl = c3_path_join view d dl t_c3_fn_ndjson f
  ct_set_pslot_buf 4 view f fl
  fl = c3_path_join view d dl t_c3_fn_marks f
  ct_set_pslot_buf 5 view f fl
  dl = ct_get_pslot 1 d
  ct_synth_cfg 12 2300 f64 0.0 0 0 0
  ct_synth_go view d dl
  fl = c3_path_join view d dl t_c3_fn_ndjson f
  ct_set_pslot_buf 6 view f fl
  fl = c3_path_join view d dl t_c3_fn_marks f
  ct_set_pslot_buf 7 view f fl
  dl = ct_get_pslot 2 d
  ct_synth_cfg 13 2100 f64 0.0 0 0 0
  ct_synth_go view d dl
  fl = c3_path_join view d dl t_c3_fn_ndjson f
  ct_set_pslot_buf 8 view f fl
  fl = c3_path_join view d dl t_c3_fn_marks f
  ct_set_pslot_buf 9 view f fl
  dl = ct_get_pslot 3 d
  ct_synth_cfg 14 1200 f64 0.0 0 0 0
  ct_synth_go view d dl
  ct_set_pslot 10 t_ct_psyn len t_ct_psyn
  ct_set_pslot 11 t_ct_pbind len t_ct_pbind
  ct_set_pslot 12 t_ct_o1 len t_ct_o1
  ct_set_pslot 13 t_ct_o2 len t_ct_o2
  dl = ct_get_pslot 12 d
  ign1 = makedir d 0 dl 493
  dl = ct_get_pslot 13 d
  ign2 = makedir d 0 dl 493
  dl = ct_wpath t_ct_o3 len t_ct_o3 d
  ign3 = makedir d 0 dl 493
end

fn ct_test_fit_phase to ulong
  pb = new uchar 1200 0
  sb = new uchar 128 0
  h = new uchar 65 0
  rsha = new uchar 65 0
  ct_setenv 0 t_ct_e_dirty t_ct_v1 len t_ct_v1
  ct_check eq ct_run_fit 4 5 11 0 1 2 t_ct_m29
  ct_check eq ct_run_fit 8 9 10 1 1 2 t_ct_m30
  ct_setenv 0 t_ct_e_dirty t_ct_v0 len t_ct_v0
  ct_check eq ct_run_fit 6 7 11 0 1 2 t_ct_m31
  ct_setenv 1 t_ct_e_proto t_ct_unk len t_ct_unk
  ct_check eq ct_run_fit 4 5 11 0 4 2 t_ct_m32
  ct_setenv 1 t_ct_e_proto t_ct_sha1 len t_ct_sha1
  ct_check eq ct_run_fit 4 5 11 0 4 2 t_ct_m33
  ct_unsetenv 1
  pbl = ct_get_pslot 11 pb
  ct_check lt stat pb 0 pbl sb 0 128 0 t_ct_m34
  ct_check eq ct_run_fit 4 5 10 1 4 0 t_ct_m35
  ct_check eq ct_run_fit 4 5 10 1 4 1 t_ct_m36
  ct_check eq ct_run_fit 4 5 11 0 4 0 t_ct_m37
  ct_check eq c3_params_read view pb pbl 0 t_ct_m38
  ok39 = eq get g_c3pm_synth 0 0
  if ne get g_c3pm_tdirty 0 0
    ok39 = false
  end
  if le get g_c3pm_e0n 0 2000
    ok39 = false
  end
  ct_check ok39 t_ct_m39
  sel = get g_c3pm_sel 0
  ct_check and ne get g_c3pm_phase 0 0 ge sel 1 t_ct_m40
  d1l = ct_get_pslot 0 pb
  ct_hexof view pb d1l t_c3_fn_ndjson h
  rsl = get g_c3pm_rshal 0
  for i ulong rsl bound 65
    put rsha i get g_c3pm_rsha i
  end
  ct_check er_eq view h 64 view rsha rsl t_ct_m41
  ret sel
end

fn ct_use_params_slot slot ulong to void
  p = new uchar 1200 0
  pl = ct_get_pslot slot p
  ct_use_params view p pl
end

fn ct_setenv_pslot eslot ulong key view uchar * pslot ulong to void
  p = new uchar 1200 0
  pl = ct_get_pslot pslot p
  ct_setenv eslot key view p pl
end

fn ct_setenv_hex eslot ulong key view uchar * dslot ulong suf view uchar * to void
  d = new uchar 1200 0
  h = new uchar 65 0
  dl = ct_get_pslot dslot d
  ct_hexof view d dl suf h
  ct_setenv eslot key view h 64
end

fn ct_count_pslot pslot ulong first edit uchar 1400 flen edit ulong 1 to long
  d = new uchar 1200 0
  dl = ct_get_pslot pslot d
  ret ct_count_receipts view d dl first flen
end


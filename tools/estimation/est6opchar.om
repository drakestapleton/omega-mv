note
note tools/estimation/est6opchar.om -- ESTIMATION v6 pre-freeze operating-characteristics
note simulation in pure seeded OM-2. Composed after src/estimation/est_math.om.
note Usage: est6opchar run|deff|selftest ...

const OC_NCELL ulong 12
const OC_MAXN ulong 20000
const OC_MAXB ulong 1000
const OC_NS ulong 16
const OC_MAXBOOT ulong 2000

text t_oc_run "run"
text t_oc_deff "deff"
text t_oc_st "selftest"
text t_oc_usage "usage: est6opchar run|deff|selftest ...\n"
text t_oc_f_case "--case"
text t_oc_f_bin0 "--bin0"
text t_oc_f_reps "--reps"
text t_oc_f_boot "--boot"
text t_oc_f_runs "--runs"
text t_oc_f_secs "--seconds"
text t_oc_f_w "--w"
text t_oc_f_rho "--rho"
text t_oc_f_rho10 "--rho10"
text t_oc_f_seed "--seed"
text t_oc_badarg "est6opchar: bad argument\n"
text t_oc_badcase "case must be a, b, c or d\n"
text t_oc_badrng "bad parameter range\n"
text t_oc_hex "0123456789abcdef"
text t_oc_st_ok "est6opchar selftest: PASS\n"
text t_oc_fail "FAIL "
text t_oc_s1 "probit round trip\n"
text t_oc_s2 "probit values\n"
text t_oc_s3 "scale for 92 percent\n"
text t_oc_s4 "cells reproduce D1 bin shares\n"
text t_oc_s5 "cell inverse\n"
text t_oc_s6 "deterministic, about 2 x 2650 steps\n"
text t_oc_s7 "case a PIT mean near 0.5\n"
text t_oc_s8 "calibrated forecaster passes most reps\n"
text t_oc_s9 "92 percent coverage never passes\n"
text t_oc_r1 "case "
text t_oc_r2 " bin0 "
text t_oc_r3 " runs "
text t_oc_r4 " seconds "
text t_oc_r5 " w "
text t_oc_r6 " rho "
text t_oc_r7 " rho10 "
text t_oc_r8 " reps "
text t_oc_r9 " boot "
text t_oc_r10 " seed 0x"
text t_oc_p1 "PASS "
text t_oc_p2 " NOT_ESTABLISHED "
text t_oc_p3 " HELD_OUT_FAIL "
text t_oc_p4 " (counts "
text t_oc_p5 "; Monte Carlo SE at most "
text t_oc_d1 "deff w "
text t_oc_d2 " mean_steps "
text t_oc_d3 " bin0_mean "
text t_oc_d4 " bin0_se "
text t_oc_d5 " design_effect "

note ---- Globals ----
global g_oc_rng ulong 4
global g_oc_d1b f64 10
global g_oc_cut f64 13
global g_oc_cum f64 13
global g_oc_lvc f64 52
global g_oc_lo f64 16
global g_oc_hi f64 16
global g_oc_cfg_i long 8
global g_oc_cfg_f f64 12

note ---- Sequence 0 (s1) and 1 (s10) ----
global g_oc_sn ulong 2
global g_oc_snb ulong 2
global g_oc_u0 f64 20000
global g_oc_z0 f64 20000
global g_oc_blk0 ulong 20000
global g_oc_idl0 uchar 20000
global g_oc_u1 f64 20000
global g_oc_blk1 ulong 20000

note ---- Bootstrap & stats ----
global g_oc_bs f64 16000
global g_oc_bs10 f64 1000
global g_oc_bn f64 1000
global g_oc_bn10 f64 1000
global g_oc_tot f64 16
global g_oc_val f64 16
global g_oc_blo f64 16
global g_oc_bhi f64 16
global g_oc_sum f64 16
global g_oc_draw f64 34000
global g_oc_v f64 16
global g_oc_u_tmp f64 20000

note ---- CLI & Output buffer ----
global g_oc_arg uchar 128
global g_oc_obuf uchar 4096
global g_oc_olen ulong 1

fn oc_fabs x f64 to f64
  if lt x f64 0.0
    ret sub f64 0.0 x
  end
  ret x
end

fn oc_ob_c c uchar to void
  n = get g_oc_olen 0
  if lt n 4096
    put g_oc_obuf n c
    put g_oc_olen 0 add n 1
  end
end

fn oc_ob_t s view uchar * n ulong to void
  for i ulong n
    oc_ob_c get s i
  end
end

fn oc_ob_u v ulong to void
  if eq v 0
    oc_ob_c 48
    ret
  end
  p = ulong 1
  d = ulong 0
  while le mul p 10 v
    p = mul p 10
    d = add d 1
    if gt d 18
      break
    end
  end
  rmv = v
  while gt p 0
    oc_ob_c uchar add 48 div rmv p
    rmv = rem rmv p
    p = div p 10
  end
end

fn oc_ob_hex v ulong to void
  if eq v 0
    oc_ob_c 48
    ret
  end
  st = ulong 0
  for i ulong 16
    sh = mul sub 15 i 4
    nib = and shr v sh 15
    if or ne st 0 ne nib 0
      st = 1
      oc_ob_c get t_oc_hex nib
    end
  end
end

fn oc_ob_frac fp0 ulong scu ulong nd ulong to void
  oc_ob_c 46
  fp = fp0
  dp = div scu 10
  for i ulong nd
    oc_ob_c uchar add 48 div fp dp
    fp = rem fp dp
    if gt dp 1
      dp = div dp 10
    end
  end
end

fn oc_ob_fix v f64 nd ulong to void
  x = v
  if lt x f64 0.0
    oc_ob_c 45
    x = sub f64 0.0 x
  end
  sc = f64 1.0
  for i ulong nd
    sc = mul sc f64 10.0
  end
  scu = ulong sc
  tot = ulong add mul x sc f64 0.5
  oc_ob_u div tot scu
  if gt nd 0
    oc_ob_frac rem tot scu scu nd
  end
end

fn oc_sm64 slot ulong to ulong
  c1 = or shl ulong 0x9e3779b9 32 ulong 0x7f4a7c15
  c2 = or shl ulong 0xbf58476d 32 ulong 0x1ce4e5b9
  c3 = or shl ulong 0x94d049bb 32 ulong 0x133111eb
  z = add get g_oc_rng slot c1
  put g_oc_rng slot z
  z = mul xor z shr z 30 c2
  z = mul xor z shr z 27 c3
  ret xor z shr z 31
end

fn oc_unif slot ulong to f64
  ret div add f64 shr oc_sm64 slot 11 f64 0.5 f64 9007199254740992.0
end

fn oc_gauss slot ulong to f64
  u1 = oc_unif slot
  u2 = oc_unif slot
  ret mul fsqrt mul f64 -2.0 est_log u1 est_cos mul f64 6.283185307179586 u2
end

fn oc_phi x f64 to f64
  ret mul f64 0.5 est_erfc div sub f64 0.0 x f64 1.4142135623730951
end

fn oc_probit_tail q f64 to f64
  n = add mul add mul add mul add mul add mul f64 -0.007784894002430293 q f64 -0.3223964580411365 q f64 -2.400758277161838 q f64 -2.549732539343734 q f64 4.374664141464968 q f64 2.938163982698783
  d = add mul add mul add mul add mul f64 0.007784695709041462 q f64 0.3224671290700398 q f64 2.445134137142996 q f64 3.754408661907416 q f64 1.0
  ret div n d
end

fn oc_probit_mid q f64 to f64
  r = mul q q
  n = mul add mul add mul add mul add mul add mul f64 -39.69683028665376 r f64 220.9460984245205 r f64 -275.9285104469687 r f64 138.357751867269 r f64 -30.66479806614716 r f64 2.506628277459239 q
  d = add mul add mul add mul add mul add mul f64 -54.47609879822406 r f64 161.5858368580409 r f64 -155.6989798598866 r f64 66.80131188771972 r f64 -13.28068155288572 r f64 1.0
  ret div n d
end

fn oc_probit p f64 to f64
  x = f64 0.0
  if lt p f64 0.02425
    x = oc_probit_tail fsqrt mul f64 -2.0 est_log p
  else
    if gt p f64 0.97575
      x = sub f64 0.0 oc_probit_tail fsqrt mul f64 -2.0 est_log sub f64 1.0 p
    else
      x = oc_probit_mid sub p f64 0.5
    end
  end
  e = sub oc_phi x p
  u = mul mul e f64 2.5066282746310002 est_exp mul mul x x f64 0.5
  ret sub x div u add f64 1.0 mul mul x u f64 0.5
end

fn oc_init_tables to void
  put g_oc_d1b 0 f64 0.075981
  put g_oc_d1b 1 f64 0.115129
  put g_oc_d1b 2 f64 0.105204
  put g_oc_d1b 3 f64 0.098830
  put g_oc_d1b 4 f64 0.105904
  put g_oc_d1b 5 f64 0.108086
  put g_oc_d1b 6 f64 0.098644
  put g_oc_d1b 7 f64 0.083913
  put g_oc_d1b 8 f64 0.085837
  put g_oc_d1b 9 f64 0.122472
  put g_oc_cut 0 f64 0.0
  put g_oc_cut 1 f64 0.025
  put g_oc_cut 2 f64 0.1
  put g_oc_cut 3 f64 0.2
  put g_oc_cut 4 f64 0.3
  put g_oc_cut 5 f64 0.4
  put g_oc_cut 6 f64 0.5
  put g_oc_cut 7 f64 0.6
  put g_oc_cut 8 f64 0.7
  put g_oc_cut 9 f64 0.8
  put g_oc_cut 10 f64 0.9
  put g_oc_cut 11 f64 0.975
  put g_oc_cut 12 f64 1.0
  put g_oc_lo 0 f64 0.46
  put g_oc_lo 1 f64 0.76
  put g_oc_lo 2 f64 0.93
  put g_oc_lo 3 f64 0.010
  put g_oc_lo 4 f64 0.010
  put g_oc_hi 0 f64 0.54
  put g_oc_hi 1 f64 0.84
  put g_oc_hi 2 f64 0.97
  put g_oc_hi 3 f64 0.040
  put g_oc_hi 4 f64 0.040
  for k ulong 10
    put g_oc_lo add 5 k f64 0.07
    put g_oc_hi add 5 k f64 0.13
  end
  put g_oc_lo 15 f64 -0.10
  put g_oc_hi 15 f64 0.10
end

fn oc_make_cells bin0 f64 to void
  rest = f64 0.0
  for j ulong 9
    rest = add rest get g_oc_d1b add j 1
  end
  sc = div sub f64 1.0 bin0 rest
  lf = div f64 0.012163 get g_oc_d1b 0
  uf = div f64 0.034887 get g_oc_d1b 9
  b9 = mul get g_oc_d1b 9 sc
  cum = f64 0.0
  put g_oc_cum 0 f64 0.0
  cum = add cum mul bin0 lf
  put g_oc_cum 1 cum
  cum = add cum sub bin0 mul bin0 lf
  put g_oc_cum 2 cum
  for j ulong 8
    cum = add cum mul get g_oc_d1b add j 1 sc
    put g_oc_cum add j 3 cum
  end
  cum = add cum sub b9 mul b9 uf
  put g_oc_cum 11 cum
  put g_oc_cum 12 f64 1.0
end

fn oc_cells_inv p f64 to f64
  for i ulong OC_NCELL
    c1 = get g_oc_cum add i 1
    if or le p c1 eq i sub OC_NCELL 1
      c0 = get g_oc_cum i
      w = sub c1 c0
      f = f64 0.5
      if gt w f64 0.0
        f = div sub p c0 w
      end
      u0 = get g_oc_cut i
      u1 = get g_oc_cut add i 1
      ret add u0 mul f sub u1 u0
    end
  end
  ret f64 1.0
end

fn oc_make_level_cells to void
  for l ulong 4
    b0 = f64 0.116
    b9 = f64 0.077
    lw = f64 0.030
    up = f64 0.036
    if eq l 1
      b0 = f64 0.111
      b9 = f64 0.114
      lw = f64 0.010
      up = f64 0.017
    else
      if eq l 2
        b0 = f64 0.025
        b9 = f64 0.159
        lw = f64 0.0
        up = f64 0.041
      else
        if eq l 3
          b0 = f64 0.0
          b9 = f64 0.184
          lw = f64 0.0
          up = f64 0.085
        end
      end
    end
    mid = div sub sub f64 1.0 b0 b9 f64 8.0
    bo = mul l 13
    cum = f64 0.0
    put g_oc_lvc bo f64 0.0
    cum = add cum lw
    put g_oc_lvc add bo 1 cum
    cum = add cum sub b0 lw
    put g_oc_lvc add bo 2 cum
    for j ulong 8
      cum = add cum mid
      put g_oc_lvc add bo add j 3 cum
    end
    cum = add cum sub b9 up
    put g_oc_lvc add bo 11 cum
    put g_oc_lvc add bo 12 f64 1.0
  end
end

fn oc_level_inv l ulong p f64 to f64
  bo = mul l 13
  for i ulong OC_NCELL
    c0 = get g_oc_lvc add bo i
    c1 = get g_oc_lvc add bo add i 1
    w = sub c1 c0
    if or and le p c1 gt w f64 0.0 eq i sub OC_NCELL 1
      f = f64 0.5
      if gt w f64 0.0
        f = div sub p c0 w
      end
      u0 = get g_oc_cut i
      u1 = get g_oc_cut add i 1
      ret add u0 mul f sub u1 u0
    end
  end
  ret f64 1.0
end

fn oc_scale_for_cov cov f64 to f64
  lo = f64 0.5
  hi = f64 3.0
  for i ulong 80
    s = mul f64 0.5 add lo hi
    c = sub mul f64 2.0 oc_phi div f64 1.959963984540054 s f64 1.0
    if gt c cov
      lo = s
    else
      hi = s
    end
  end
  ret mul f64 0.5 add lo hi
end

fn oc_clamp_u u f64 to f64
  if lt u f64 0.000000000001
    ret f64 0.000000000001
  end
  if gt u f64 0.999999999999
    ret f64 0.999999999999
  end
  ret u
end

fn oc_store_step kind ulong n ulong nb ulong lv ulong z0 f64 to void
  cas = get g_oc_cfg_i 2
  u = f64 0.0
  zz = z0
  if eq cas 1
    sc = get g_oc_cfg_f 4
    if ne kind 0
      sc = get g_oc_cfg_f 5
    end
    zz = mul sc z0
    u = oc_phi zz
  else
    if and eq cas 3 eq kind 0
      u = oc_level_inv lv oc_phi z0
      zz = oc_probit oc_clamp_u u
    else
      if eq cas 3
        zz = mul get g_oc_cfg_f 6 z0
        u = oc_phi zz
      else
        if and eq cas 2 eq kind 0
          u = oc_cells_inv oc_phi z0
          zz = oc_probit oc_clamp_u u
        else
          if eq cas 2
            zz = mul get g_oc_cfg_f 6 z0
            u = oc_phi zz
          else
            u = oc_phi z0
          end
        end
      end
    end
  end
  if eq kind 0
    put g_oc_u0 n u
    put g_oc_z0 n zz
    put g_oc_blk0 n nb
    if eq lv 0
      put g_oc_idl0 n 1
    else
      put g_oc_idl0 n 0
    end
  else
    put g_oc_u1 n u
    put g_oc_blk1 n nb
  end
end

fn oc_gen_step slot ulong kind ulong lv ulong to void
  g = oc_gauss slot
  t1 = mul get g_oc_cfg_f 8 get g_oc_cfg_f 7
  t2 = mul get g_oc_cfg_f 9 g
  a = add t1 t2
  put g_oc_cfg_f 7 a
  step = ulong get g_oc_cfg_i 4
  n = get g_oc_sn kind
  if ge step 30
    if lt n OC_MAXN
      t3 = mul get g_oc_cfg_f 11 a
      z0 = add get g_oc_cfg_f 10 t3
      oc_store_step kind n get g_oc_snb kind lv z0
      put g_oc_sn kind add n 1
    end
  end
  put g_oc_cfg_i 4 long add step 1
end

fn oc_gen_seg slot ulong kind ulong lv ulong d ulong to void
  rho = get g_oc_cfg_f 1
  if ne kind 0
    rho = get g_oc_cfg_f 2
  end
  put g_oc_cfg_f 8 rho
  put g_oc_cfg_f 9 fsqrt sub f64 1.0 mul rho rho
  put g_oc_cfg_f 10 mul fsqrt get g_oc_cfg_f 0 oc_gauss slot
  put g_oc_cfg_f 11 fsqrt sub f64 1.0 get g_oc_cfg_f 0
  for k ulong d
    oc_gen_step slot kind lv
  end
  put g_oc_snb kind add get g_oc_snb kind 1
end

fn oc_gen_seq slot ulong kind ulong to void
  nrun = ulong get g_oc_cfg_i 0
  secs = ulong get g_oc_cfg_i 1
  put g_oc_sn kind 0
  put g_oc_snb kind 0
  for r ulong nrun
    acc = ulong 0
    put g_oc_cfg_i 4 0
    put g_oc_cfg_f 7 oc_gauss slot
    while lt acc secs
      if ge get g_oc_snb kind sub OC_MAXB 1
        break
      end
      lv = rem oc_sm64 slot 4
      d = add 20 rem oc_sm64 slot 101
      if gt add acc d secs
        d = sub secs acc
      end
      oc_gen_seg slot kind lv d
      acc = add acc d
    end
  end
end

fn oc_contrib1 u f64 z f64 to void
  d = oc_fabs sub u f64 0.5
  put g_oc_v 0 f64 0.0
  if lt d f64 0.25
    put g_oc_v 0 f64 1.0
  end
  put g_oc_v 1 f64 0.0
  if lt d f64 0.4
    put g_oc_v 1 f64 1.0
  end
  put g_oc_v 2 f64 0.0
  if lt d f64 0.475
    put g_oc_v 2 f64 1.0
  end
  put g_oc_v 3 f64 0.0
  if lt u f64 0.025
    put g_oc_v 3 f64 1.0
  end
  put g_oc_v 4 f64 0.0
  if gt u f64 0.975
    put g_oc_v 4 f64 1.0
  end
  j = long mul u f64 10.0
  if gt j 9
    j = 9
  end
  if lt j 0
    j = 0
  end
  ju = ulong j
  for k ulong 10
    if eq k ju
      put g_oc_v add 5 k f64 1.0
    else
      put g_oc_v add 5 k f64 0.0
    end
  end
  put g_oc_v 15 z
end

fn oc_sift base ulong root ulong endi ulong to void
  r = root
  while true
    ch = add mul r 2 1
    if ge ch endi
      break
    end
    sw = r
    if lt get g_oc_draw add base sw get g_oc_draw add base ch
      sw = ch
    end
    if lt add ch 1 endi
      if lt get g_oc_draw add base sw get g_oc_draw add base add ch 1
        sw = add ch 1
      end
    end
    if eq sw r
      break
    end
    tmp = get g_oc_draw add base r
    put g_oc_draw add base r get g_oc_draw add base sw
    put g_oc_draw add base sw tmp
    r = sw
  end
end

fn oc_sort_draw k ulong boot ulong to void
  base = mul k OC_MAXBOOT
  i = div boot 2
  while gt i 0
    i = sub i 1
    oc_sift base i boot
  end
  e = boot
  while gt e 1
    e = sub e 1
    tmp = get g_oc_draw base
    put g_oc_draw base get g_oc_draw add base e
    put g_oc_draw add base e tmp
    oc_sift base 0 e
  end
end

fn oc_boot_one slot ulong r ulong to void
  nb0 = get g_oc_snb 0
  nb1 = get g_oc_snb 1
  for k ulong OC_NS
    put g_oc_sum k f64 0.0
  end
  cnt = f64 0.0
  for i ulong nb0
    b = rem oc_sm64 slot nb0
    bo = mul b OC_NS
    for k ulong OC_NS
      sk = get g_oc_sum k
      bv = get g_oc_bs add bo k
      put g_oc_sum k add sk bv
    end
    cnt = add cnt get g_oc_bn b
  end
  sum10 = f64 0.0
  cnt10 = f64 0.0
  for i ulong nb1
    b = rem oc_sm64 slot nb1
    sum10 = add sum10 get g_oc_bs10 b
    cnt10 = add cnt10 get g_oc_bn10 b
  end
  for k ulong OC_NS
    put g_oc_draw add mul k OC_MAXBOOT r div get g_oc_sum k cnt
  end
  put g_oc_draw add mul OC_NS OC_MAXBOOT r div sum10 cnt10
end

fn oc_boot_loop slot ulong boot ulong to void
  for r ulong boot
    oc_boot_one slot r
  end
end

fn oc_check_p8_p9 n ulong to ulong
  zm = get g_oc_val 15
  num = f64 0.0
  den = f64 0.0
  for i ulong n
    di = sub get g_oc_z0 i zm
    den = add den mul di di
    if gt i 0
      dp = sub get g_oc_z0 sub i 1 zm
      num = add num mul di dp
    end
  end
  if gt oc_fabs div num den f64 0.20
    ret 1
  end
  for q ulong 4
    a = div mul q n 4
    b = div mul add q 1 n 4
    c = f64 0.0
    i = a
    while lt i b
      if lt oc_fabs sub get g_oc_u0 i f64 0.5 f64 0.475
        c = add c f64 1.0
      end
      i = add i 1
    end
    cf = div c f64 sub b a
    if or lt cf f64 0.90 gt cf f64 0.99
      ret 1
    end
  end
  for rg ulong 2
    c = f64 0.0
    m = f64 0.0
    for i ulong n
      if eq ulong get g_oc_idl0 i rg
        if lt oc_fabs sub get g_oc_u0 i f64 0.5 f64 0.475
          c = add c f64 1.0
        end
        m = add m f64 1.0
      end
    end
    if ge m f64 100.0
      cf = div c m
      if or lt cf f64 0.90 gt cf f64 0.99
        ret 1
      end
    end
  end
  if lt n 4000
    ret 1
  end
  ret 0
end

fn oc_accum_seqs to f64
  nb0 = get g_oc_snb 0
  nb1 = get g_oc_snb 1
  for i ulong mul nb0 OC_NS
    put g_oc_bs i f64 0.0
  end
  for i ulong nb0
    put g_oc_bn i f64 0.0
  end
  for i ulong nb1
    put g_oc_bs10 i f64 0.0
    put g_oc_bn10 i f64 0.0
  end
  for k ulong OC_NS
    put g_oc_tot k f64 0.0
  end
  n = get g_oc_sn 0
  for i ulong n
    oc_contrib1 get g_oc_u0 i get g_oc_z0 i
    b = get g_oc_blk0 i
    bo = mul b OC_NS
    for k ulong OC_NS
      vk = get g_oc_v k
      bi = add bo k
      put g_oc_bs bi add get g_oc_bs bi vk
      put g_oc_tot k add get g_oc_tot k vk
    end
    put g_oc_bn b add get g_oc_bn b f64 1.0
  end
  tot10 = f64 0.0
  n10 = get g_oc_sn 1
  for i ulong n10
    b = get g_oc_blk1 i
    if lt oc_fabs sub get g_oc_u1 i f64 0.5 f64 0.475
      put g_oc_bs10 b add get g_oc_bs10 b f64 1.0
      tot10 = add tot10 f64 1.0
    end
    put g_oc_bn10 b add get g_oc_bn10 b f64 1.0
  end
  for k ulong OC_NS
    put g_oc_val k div get g_oc_tot k f64 n
  end
  ret div tot10 f64 n10
end

fn oc_verdict n ulong v10 f64 lo10 f64 hi10 f64 to ulong
  fail = ulong 0
  defv = ulong 0
  for k ulong OC_NS
    vk = get g_oc_val k
    if lt vk get g_oc_lo k
      fail = 1
      if lt get g_oc_bhi k get g_oc_lo k
        defv = 1
      end
    end
    if gt vk get g_oc_hi k
      fail = 1
      if gt get g_oc_blo k get g_oc_hi k
        defv = 1
      end
    end
  end
  if lt v10 f64 0.90
    fail = 1
    if lt hi10 f64 0.90
      defv = 1
    end
  end
  if gt v10 f64 0.99
    fail = 1
    if gt lo10 f64 0.99
      defv = 1
    end
  end
  if ne oc_check_p8_p9 n 0
    fail = 1
    defv = 1
  end
  if eq fail 0
    ret 0
  end
  if ne defv 0
    ret 2
  end
  ret 1
end

fn oc_sort_extract boot ulong ilo ulong ihi ulong to void
  for k ulong add OC_NS 1
    oc_sort_draw k boot
    if lt k OC_NS
      ix0 = add mul k OC_MAXBOOT ilo
      ix1 = add mul k OC_MAXBOOT ihi
      put g_oc_blo k get g_oc_draw ix0
      put g_oc_bhi k get g_oc_draw ix1
    end
  end
end

fn oc_one_rep slot ulong boot0 ulong to ulong
  boot = boot0
  if gt boot OC_MAXBOOT
    boot = OC_MAXBOOT
  end
  oc_gen_seq slot 0
  oc_gen_seq slot 1
  v10 = oc_accum_seqs
  oc_boot_loop slot boot
  ilo = ulong est_floor mul f64 0.0025 f64 sub boot 1
  ihi_f = mul f64 0.9975 f64 sub boot 1
  ihi_fl = est_floor ihi_f
  ihi = ulong ihi_fl
  if gt ihi_f ihi_fl
    ihi = add ihi 1
  end
  oc_sort_extract boot ilo ihi
  lo10 = get g_oc_draw add mul OC_NS OC_MAXBOOT ilo
  hi10 = get g_oc_draw add mul OC_NS OC_MAXBOOT ihi
  ret oc_verdict get g_oc_sn 0 v10 lo10 hi10
end

fn oc_setup to void
  put g_oc_cfg_f 4 oc_scale_for_cov f64 0.92
  put g_oc_cfg_f 5 oc_scale_for_cov f64 0.92
  put g_oc_cfg_f 6 oc_scale_for_cov f64 0.9402
end

fn oc_arg_eq idx ulong t view uchar * tn ulong to bool
  al = ulong argread idx g_oc_arg 0 127
  if ne al tn
    ret false
  end
  for i ulong tn
    if ne get g_oc_arg i get t i
      ret false
    end
  end
  ret true
end

fn oc_parse_u64 idx ulong to ulong
  al = ulong argread idx g_oc_arg 0 127
  if and ge al 2 and eq get g_oc_arg 0 48 or eq get g_oc_arg 1 120 eq get g_oc_arg 1 88
    v = ulong 0
    i = ulong 2
    while lt i al
      c = get g_oc_arg i
      d = ulong 0
      if and ge c 48 le c 57
        d = ulong sub c 48
      else
        if and ge c 97 le c 102
          d = add 10 ulong sub c 97
        else
          if and ge c 65 le c 70
            d = add 10 ulong sub c 65
          else
            break
          end
        end
      end
      v = add mul v 16 d
      i = add i 1
    end
    ret v
  end
  v = ulong 0
  i = ulong 0
  while lt i al
    c = get g_oc_arg i
    if and ge c 48 le c 57
      v = add mul v 10 ulong sub c 48
      i = add i 1
    else
      break
    end
  end
  ret v
end

fn oc_parse_f64 idx ulong to f64
  al = ulong argread idx g_oc_arg 0 127
  p = ulong 0
  negv = ulong 0
  if lt p al
    if eq get g_oc_arg p 45
      negv = 1
      p = add p 1
    end
  end
  v = f64 0.0
  while lt p al
    c = get g_oc_arg p
    if and ge c 48 le c 57
      v = add mul v f64 10.0 f64 ulong sub c 48
      p = add p 1
    else
      break
    end
  end
  if lt p al
    if eq get g_oc_arg p 46
      p = add p 1
      sc = f64 0.1
      while lt p al
        c = get g_oc_arg p
        if and ge c 48 le c 57
          v = add v mul f64 ulong sub c 48 sc
          sc = mul sc f64 0.1
          p = add p 1
        else
          break
        end
      end
    end
  end
  if ne negv 0
    v = sub f64 0.0 v
  end
  ret v
end

fn oc_run_exec cs uchar reps ulong boot ulong seed ulong to int
  nr = get g_oc_cfg_i 0
  sc = get g_oc_cfg_i 1
  bad = ulong 0
  if or lt nr 1 gt nr 4
    bad = 1
  end
  if or lt sc 100 gt sc 4000
    bad = 1
  end
  if or lt reps 1 lt boot 200
    bad = 1
  end
  if ne bad 0
    ign = write 2 t_oc_badrng 0 len t_oc_badrng
    ret 2
  end
  oc_setup
  oc_make_cells get g_oc_cfg_f 3
  oc_make_level_cells
  put g_oc_rng 0 seed
  c0 = ulong 0
  c1 = ulong 0
  c2 = ulong 0
  for r ulong reps
    o = oc_one_rep 0 boot
    if eq o 0
      c0 = add c0 1
    else
      if eq o 1
        c1 = add c1 1
      else
        c2 = add c2 1
      end
    end
  end
  put g_oc_olen 0 0
  oc_ob_t t_oc_r1 len t_oc_r1
  oc_ob_c cs
  oc_ob_t t_oc_r2 len t_oc_r2
  oc_ob_fix get g_oc_cfg_f 3 4
  oc_ob_t t_oc_r3 len t_oc_r3
  oc_ob_u ulong nr
  oc_ob_t t_oc_r4 len t_oc_r4
  oc_ob_u ulong sc
  oc_ob_t t_oc_r5 len t_oc_r5
  oc_ob_fix get g_oc_cfg_f 0 3
  oc_ob_t t_oc_r6 len t_oc_r6
  oc_ob_fix get g_oc_cfg_f 1 3
  oc_ob_t t_oc_r7 len t_oc_r7
  oc_ob_fix get g_oc_cfg_f 2 3
  oc_ob_t t_oc_r8 len t_oc_r8
  oc_ob_u reps
  oc_ob_t t_oc_r9 len t_oc_r9
  oc_ob_u boot
  oc_ob_t t_oc_r10 len t_oc_r10
  oc_ob_hex seed
  oc_ob_c 10
  rf = f64 reps
  oc_ob_t t_oc_p1 len t_oc_p1
  oc_ob_fix div f64 c0 rf 4
  oc_ob_t t_oc_p2 len t_oc_p2
  oc_ob_fix div f64 c1 rf 4
  oc_ob_t t_oc_p3 len t_oc_p3
  oc_ob_fix div f64 c2 rf 4
  oc_ob_t t_oc_p4 len t_oc_p4
  oc_ob_u c0
  oc_ob_c 32
  oc_ob_u c1
  oc_ob_c 32
  oc_ob_u c2
  oc_ob_t t_oc_p5 len t_oc_p5
  oc_ob_fix div f64 0.5 fsqrt rf 4
  oc_ob_c 41
  oc_ob_c 10
  ign = write 1 g_oc_obuf 0 get g_oc_olen 0
  ret 0
end

fn oc_cmd_run ac ulong to int
  put g_oc_cfg_i 0 2
  put g_oc_cfg_i 1 2700
  put g_oc_cfg_i 2 0
  put g_oc_cfg_f 0 f64 0.08
  put g_oc_cfg_f 1 f64 0.02
  put g_oc_cfg_f 2 f64 0.90
  put g_oc_cfg_f 3 f64 0.075981
  reps = ulong 1000
  boot = ulong 1000
  seed = ulong 0xe6a001
  cs = uchar 97
  i = ulong 2
  while lt i ac
    if and oc_arg_eq i t_oc_f_case len t_oc_f_case lt add i 1 ac
      i = add i 1
      al = ulong argread i g_oc_arg 0 127
      cs = uchar 0
      if gt al 0
        cs = get g_oc_arg 0
      end
    else
      if and oc_arg_eq i t_oc_f_bin0 len t_oc_f_bin0 lt add i 1 ac
        i = add i 1
        put g_oc_cfg_f 3 oc_parse_f64 i
      else
        if and oc_arg_eq i t_oc_f_reps len t_oc_f_reps lt add i 1 ac
          i = add i 1
          reps = oc_parse_u64 i
        else
          if and oc_arg_eq i t_oc_f_boot len t_oc_f_boot lt add i 1 ac
            i = add i 1
            boot = oc_parse_u64 i
          else
            if and oc_arg_eq i t_oc_f_runs len t_oc_f_runs lt add i 1 ac
              i = add i 1
              put g_oc_cfg_i 0 long oc_parse_u64 i
            else
              if and oc_arg_eq i t_oc_f_secs len t_oc_f_secs lt add i 1 ac
                i = add i 1
                put g_oc_cfg_i 1 long oc_parse_u64 i
              else
                if and oc_arg_eq i t_oc_f_w len t_oc_f_w lt add i 1 ac
                  i = add i 1
                  put g_oc_cfg_f 0 oc_parse_f64 i
                else
                  if and oc_arg_eq i t_oc_f_rho len t_oc_f_rho lt add i 1 ac
                    i = add i 1
                    put g_oc_cfg_f 1 oc_parse_f64 i
                  else
                    if and oc_arg_eq i t_oc_f_rho10 len t_oc_f_rho10 lt add i 1 ac
                      i = add i 1
                      put g_oc_cfg_f 2 oc_parse_f64 i
                    else
                      if and oc_arg_eq i t_oc_f_seed len t_oc_f_seed lt add i 1 ac
                        i = add i 1
                        seed = oc_parse_u64 i
                      else
                        ign = write 2 t_oc_badarg 0 len t_oc_badarg
                        ret 2
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
    i = add i 1
  end
  if or lt cs 97 gt cs 100
    ign = write 2 t_oc_badcase 0 len t_oc_badcase
    ret 2
  end
  put g_oc_cfg_i 2 long sub cs 97
  ret oc_run_exec cs reps boot seed
end

fn oc_cmd_deff ac ulong to int
  put g_oc_cfg_i 0 1
  put g_oc_cfg_i 1 2700
  put g_oc_cfg_i 2 0
  put g_oc_cfg_f 0 f64 0.08
  put g_oc_cfg_f 1 f64 0.02
  put g_oc_cfg_f 2 f64 0.90
  reps = ulong 2000
  seed = ulong 0xe6a002
  i = ulong 2
  while lt i ac
    if and oc_arg_eq i t_oc_f_reps len t_oc_f_reps lt add i 1 ac
      i = add i 1
      reps = oc_parse_u64 i
    else
      if and oc_arg_eq i t_oc_f_runs len t_oc_f_runs lt add i 1 ac
        i = add i 1
        put g_oc_cfg_i 0 long oc_parse_u64 i
      else
        if and oc_arg_eq i t_oc_f_w len t_oc_f_w lt add i 1 ac
          i = add i 1
          put g_oc_cfg_f 0 oc_parse_f64 i
        else
          if and oc_arg_eq i t_oc_f_rho len t_oc_f_rho lt add i 1 ac
            i = add i 1
            put g_oc_cfg_f 1 oc_parse_f64 i
          else
            if and oc_arg_eq i t_oc_f_seed len t_oc_f_seed lt add i 1 ac
              i = add i 1
              seed = oc_parse_u64 i
            else
              ign = write 2 t_oc_badarg 0 len t_oc_badarg
              ret 2
            end
          end
        end
      end
    end
    i = add i 1
  end
  put g_oc_rng 0 seed
  m = f64 0.0
  m2 = f64 0.0
  nn = f64 0.0
  for r ulong reps
    oc_gen_seq 0 0
    n = get g_oc_sn 0
    c = f64 0.0
    for j ulong n
      if lt get g_oc_u0 j f64 0.1
        c = add c f64 1.0
      end
    end
    cf = div c f64 n
    nn = add nn f64 n
    m = add m cf
    m2 = add m2 mul cf cf
  end
  rf = f64 reps
  m = div m rf
  m2 = div m2 rf
  nn = div nn rf
  vr = sub m2 mul m m
  put g_oc_olen 0 0
  oc_ob_t t_oc_d1 len t_oc_d1
  oc_ob_fix get g_oc_cfg_f 0 3
  oc_ob_t t_oc_r6 len t_oc_r6
  oc_ob_fix get g_oc_cfg_f 1 3
  oc_ob_t t_oc_r3 len t_oc_r3
  oc_ob_u ulong get g_oc_cfg_i 0
  oc_ob_t t_oc_r8 len t_oc_r8
  oc_ob_u reps
  oc_ob_t t_oc_d2 len t_oc_d2
  oc_ob_fix nn 0
  oc_ob_t t_oc_d3 len t_oc_d3
  oc_ob_fix m 4
  oc_ob_t t_oc_d4 len t_oc_d4
  oc_ob_fix fsqrt vr 5
  oc_ob_t t_oc_d5 len t_oc_d5
  oc_ob_fix div vr div f64 0.09 nn 3
  oc_ob_c 10
  ign = write 1 g_oc_obuf 0 get g_oc_olen 0
  ret 0
end

fn oc_chk ok bool msg view uchar * ml ulong to ulong
  if not ok
    ign = write 2 t_oc_fail 0 len t_oc_fail
    ign = write 2 msg 0 ml
    ret 1
  end
  ret 0
end

fn oc_cmd_selftest to int
  bad = ulong 0
  bad = add bad oc_chk lt oc_fabs sub oc_phi oc_probit f64 0.975 f64 0.975 f64 0.000000000001 t_oc_s1 len t_oc_s1
  bad = add bad oc_chk and lt oc_fabs oc_probit f64 0.5 f64 0.000000000001 lt oc_fabs sub oc_probit f64 0.975 f64 1.959963984540054 f64 0.000000001 t_oc_s2 len t_oc_s2
  s92 = oc_scale_for_cov f64 0.92
  c92 = sub mul f64 2.0 oc_phi div f64 1.959963984540054 s92 f64 1.0
  bad = add bad oc_chk lt oc_fabs sub c92 f64 0.92 f64 0.000000001 t_oc_s3 len t_oc_s3
  oc_make_cells f64 0.075981
  bad = add bad oc_chk and lt oc_fabs sub get g_oc_cum 2 f64 0.075981 f64 0.000000001 lt oc_fabs sub get g_oc_cum 11 sub f64 1.0 f64 0.034887 f64 0.000000001 t_oc_s4 len t_oc_s4
  bad = add bad oc_chk and lt oc_fabs sub oc_cells_inv f64 0.075981 f64 0.1 f64 0.000000001 lt oc_fabs sub oc_cells_inv f64 0.012163 f64 0.025 f64 0.000000001 t_oc_s5 len t_oc_s5
  put g_oc_cfg_i 0 2
  put g_oc_cfg_i 1 2700
  put g_oc_cfg_i 2 0
  put g_oc_cfg_f 0 f64 0.08
  put g_oc_cfg_f 1 f64 0.02
  put g_oc_cfg_f 2 f64 0.90
  put g_oc_cfg_f 3 f64 0.075981
  oc_setup
  put g_oc_rng 1 77
  oc_gen_seq 1 0
  na = get g_oc_sn 0
  for i ulong na
    put g_oc_u_tmp i get g_oc_u0 i
  end
  put g_oc_rng 2 77
  oc_gen_seq 2 0
  nb = get g_oc_sn 0
  eq_u = eq na nb
  if eq_u
    for i ulong na
      if ne get g_oc_u0 i get g_oc_u_tmp i
        eq_u = false
        break
      end
    end
  end
  bad = add bad oc_chk and eq_u and gt na 5000 lt na 5400 t_oc_s6 len t_oc_s6
  ms = f64 0.0
  for i ulong na
    ms = add ms get g_oc_u_tmp i
  end
  bad = add bad oc_chk lt oc_fabs sub div ms f64 na f64 0.5 f64 0.05 t_oc_s7 len t_oc_s7
  put g_oc_cfg_i 2 0
  put g_oc_rng 3 5
  pa = ulong 0
  for i ulong 20
    if eq oc_one_rep 3 300 0
      pa = add pa 1
    end
  end
  bad = add bad oc_chk ge pa 14 t_oc_s8 len t_oc_s8
  put g_oc_cfg_i 2 1
  put g_oc_rng 3 6
  pb = ulong 0
  for i ulong 20
    if eq oc_one_rep 3 300 0
      pb = add pb 1
    end
  end
  bad = add bad oc_chk eq pb 0 t_oc_s9 len t_oc_s9
  if eq bad 0
    ign = write 1 t_oc_st_ok 0 len t_oc_st_ok
    ret 0
  end
  ret 1
end

fn main to int
  oc_init_tables
  ac = ulong argcnt
  if ge ac 2
    if oc_arg_eq 1 t_oc_run len t_oc_run
      ret oc_cmd_run ac
    end
    if oc_arg_eq 1 t_oc_deff len t_oc_deff
      ret oc_cmd_deff ac
    end
    if oc_arg_eq 1 t_oc_st len t_oc_st
      ret oc_cmd_selftest
    end
  end
  ign = write 2 t_oc_usage 0 len t_oc_usage
  ret 2
end

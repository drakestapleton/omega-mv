  ret get g_e6_f10_lp1 j
end

fn e6_stratum_boot_one ni ulong r ulong to void
  ss = new f64 9 0.0
  nn = f64 0.0
  for k ulong ni bound E6_NBMAX
    b = get g_e6_sids rem e6_sm64_g ni
    nn = add nn get g_e6_sbn b
    bb = mul b E6_NV
    for q ulong E6_NV
      sq = get ss q
      bq = get g_e6_sbs add bb q
      put ss q add sq bq
    end
  end
  rb = mul r E6_NV
  for q ulong E6_NV
    put g_e6_sdr add rb q div get ss q nn
  end
end

fn e6_stratum_boot ni ulong boot ulong li ulong to void
  put g_e6_rng 0 add ulong 0xe6b007 li
  for r ulong boot bound ER_UNB
    e6_stratum_boot_one ni r
  end
end

fn e6_stratum_add_b b ulong tot edit f64 9 to void
  bb = mul b E6_NV
  for k ulong E6_NV
    put tot k add get tot k get g_e6_sbs add bb k
  end
end

fn e6_stratum_print_k k ulong tn f64 boot ulong totk f64 to void
  mean = f64 0.0
  for r ulong boot bound ER_UNB
    mean = add mean get g_e6_sdr add mul r E6_NV k
  end
  mean = div mean f64 boot
  var = f64 0.0
  for r ulong boot bound ER_UNB
    d = sub get g_e6_sdr add mul r E6_NV k mean
    var = add var mul d d
  end
  var = div var f64 sub boot 1
  ob_c 32
  e6_vname k
  ob_c 32
  ob_fix div totk tn 4
  ob_t t_e6_f_se1
  ob_fix fsqrt var 4
  ob_t t_e6_f_se2
end

fn e6_stratum_one w ulong nb ulong boot ulong li ulong to void
  tot = new f64 9 0.0
  ni = ulong 0
  tn = f64 0.0
  for b ulong nb bound E6_NBMAX
    if le get g_e6_sbn b f64 0.0
      continue
    end
    lv = long 0
    if ne and b 1 0
      lv = get g_c3m_lv div b 2
    end
    if ne lv long mul li 6
      continue
    end
    put g_e6_sids ni b
    ni = add ni 1
    tn = add tn get g_e6_sbn b
    e6_stratum_add_b b tot
  end
  if eq ni 0
    ret
  end
  e6_stratum_boot ni boot li
  ob_t t_e6_f_str1
  if eq w 0
    ob_t t_e6_tag_g1s
  else
    ob_t t_e6_tag_ctl
  end
  ob_t t_e6_f_str2
  ob_u mul li 6
  ob_t t_e6_f_str3
  ob_u ni
  ob_t t_e6_p_b3
  ob_fix tn 0
  for k ulong E6_NV
    if or eq k 4 eq k 5
      continue
    end
    e6_stratum_print_k k tn boot get tot k
  end
  ob_nl
end

fn e6_stratum_accum_i w ulong i ulong to void
  v = new f64 9 0.0
  b = e6_block_of get g_e6_t1 i
  e6_stepvec e6_g1sfull_oof_get_flo w i e6_g1sfull_oof_get_fhi w i v
  bb = mul b E6_NV
  for k ulong E6_NV
    bk = add bb k
    put g_e6_sbs bk add get g_e6_sbs bk get v k
  end
  put g_e6_sbn b add get g_e6_sbn b f64 1.0
end

fn e6_g1sfull_stratum w ulong n1 ulong boot ulong to void
  nb = add mul 2 get g_c3m_n 0 2
  for b ulong nb bound E6_NBMAX
    put g_e6_sbn b f64 0.0
    bb = mul b E6_NV
    for k ulong E6_NV
      put g_e6_sbs add bb k f64 0.0
    end
  end
  for i ulong n1 bound ER_UNB
    e6_stratum_accum_i w i
  end
  for li ulong 4
    e6_stratum_one w nb boot li
  end
end

fn e6_pool_lag w ulong n1 ulong to void
  lag = f64 0.0
  ln = ulong 0
  zprev = est_nan
  for i ulong n1 bound ER_UNB
    z = e6_probit mul f64 0.5 add e6_g1sfull_oof_get_flo w i e6_g1sfull_oof_get_fhi w i
    if gt i 0
      dt = sub get g_e6_t1 i get g_e6_t1 sub i 1
      if and gt dt 500000000 lt dt 1500000000
        lag = add lag mul z zprev
        ln = add ln 1
      end
    end
    zprev = z
  end
  ob_t t_e6_f_lag1
  if eq w 0
    ob_t t_e6_tag_g1s
  else
    ob_t t_e6_tag_ctl
  end
  ob_c 32
  if ne ln 0
    ob_fix div lag f64 ln 4
  else
    ob_fix est_nan 4
  end
  ob_t t_e6_f_lag2
  ob_u ln
  ob_t t_e6_f_lag3
end

fn e6_pool_bins_lag w ulong n1 ulong bins edit f64 10 to void
  c = new f64 13 0.0
  for i ulong n1 bound ER_UNB
    e6_contrib e6_g1sfull_oof_get_flo w i e6_g1sfull_oof_get_fhi w i c
    for j ulong 10
      put bins j add get bins j get c j
    end
  end
  ob_t t_e6_f_obins
  if eq w 0
    ob_t t_e6_tag_g1s
  else
    ob_t t_e6_tag_ctl
  end
  for j ulong 10
    ob_c 32
    ob_fix div get bins j f64 n1 4
  end
  ob_nl
  e6_pool_lag w n1
end

fn e6_g1sfull_pool_report w ulong n1 ulong n10 ulong boot ulong to void
  sum = new f64 9 0.0
  v = new f64 9 0.0
  bins = new f64 10 0.0
  cnt = f64 0.0
  lsum = f64 0.0
  for i ulong n1 bound ER_UNB
    e6_stepvec e6_g1sfull_oof_get_flo w i e6_g1sfull_oof_get_fhi w i v
    for k ulong E6_NV
      put sum k add get sum k get v k
    end
    cnt = add cnt f64 1.0
    lsum = add lsum e6_g1sfull_oof_get_lp w i
  end
  ob_t t_e6_f_op1
  if eq w 0
    ob_t t_e6_tag_g1s
  else
    ob_t t_e6_tag_ctl
  end
  ob_t t_e6_g_mls
  ob_fix div lsum f64 n1 6
  ob_nl
  e6_print_stats t_e6_f_optag view sum cnt
  ten_cov = f64 0.0
  ten_ls = f64 0.0
  for j ulong n10 bound ER_UNB
    ten_cov = add ten_cov est_frac_cover e6_g1sfull_f10_get_flo w j e6_g1sfull_f10_get_fhi w j f64 0.95
    ten_ls = add ten_ls e6_g1sfull_f10_get_lp w j
  end
  ob_t t_e6_f_opt1
  if eq w 0
    ob_t t_e6_tag_g1s
  else
    ob_t t_e6_tag_ctl
  end
  ob_t t_e6_f_opn
  ob_u n10
  ob_t t_e6_f_opt2
  ob_fix div ten_cov f64 n10 4
  ob_t t_e6_g_mls
  ob_fix div ten_ls f64 n10 6
  ob_nl
  e6_pool_bins_lag w n1 bins
  e6_screen_line t_e6_f_g_p1 div get sum 4 cnt f64 0.46 f64 0.54 f64 0.01
  e6_screen_line t_e6_f_g_p2 div get sum 5 cnt f64 0.76 f64 0.84 f64 0.01
  e6_screen_line t_e6_f_g_p3 div get sum 6 cnt f64 0.93 f64 0.97 f64 0.02
  e6_screen_line t_e6_f_g_p4 div get sum 2 cnt f64 0.010 f64 0.040 f64 0.01
  e6_screen_line t_e6_f_g_p5 div get sum 3 cnt f64 0.010 f64 0.040 f64 0.01
  for j ulong 10
    e6_screen_bin j div get bins j f64 n1
  end
  e6_screen_line t_e6_f_g_p7 div ten_cov f64 n10 f64 0.90 f64 0.99 f64 0.03
  e6_g1sfull_stratum w n1 boot
end

fn e6_g1sfull_init_f10 n10 ulong nfold ulong to long
  er = enlarge g_e6_fold10 n10
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_t10s n10
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_keep n10
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_f10_flo0 n10
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_f10_fhi0 n10
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_f10_lp0 n10
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_f10_flo1 n10
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_f10_fhi1 n10
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_f10_lp1 n10
  if lt er 0
    ret 1
  end
  for j ulong n10 bound ER_UNB
    tj = get g_e6_t10 j
    put g_e6_fold10 j rem ulong get g_e6_rank e6_block_of tj nfold
    put g_e6_t10s j tj
    put g_e6_f10_flo0 j f64 0.0
    put g_e6_f10_fhi0 j f64 0.0
    put g_e6_f10_lp0 j f64 0.0
    put g_e6_f10_flo1 j f64 0.0
    put g_e6_f10_fhi1 j f64 0.0
    put g_e6_f10_lp1 j f64 0.0
  end
  ret 0
end

fn e6_fold_score1_i w ulong i ulong sb ulong to f64
  flh = new f64 2 0.0
  put g_e6_os 0 mul get g_e6_b1f add sb 4 get g_e6_b1 i
  put g_e6_os 1 get g_e6_b1f add sb 3
  put g_e6_os 2 get g_e6_m1 i
  put g_e6_os 3 get g_e6_a1 i
  put g_e6_os 4 get g_e6_y1 i
  lp = e6_one_step get g_e6_b1f add sb 5 flh
  if eq w 0
    put g_e6_oo_flo0 i get flh 0
    put g_e6_oo_fhi0 i get flh 1
    put g_e6_oo_lp0 i lp
  else
    put g_e6_oo_flo1 i get flh 0
    put g_e6_oo_fhi1 i get flh 1
    put g_e6_oo_lp1 i lp
  end
  ret lp
end

fn e6_fold_score1 w ulong fo ulong sb ulong n1 ulong out_nf edit ulong 1 to f64
  nf = ulong 0
  s = f64 0.0
  for i ulong n1 bound ER_UNB
    if eq get g_e6_fold i fo
      s = add s e6_fold_score1_i w i sb
      nf = add nf 1
    end
  end
  put out_nf 0 nf
  ret s
end

fn e6_fold_print fo ulong sb ulong n1 ulong nf ulong s f64 to void
  omls = f64 0.0
  if ne nf 0
    omls = div s f64 nf
  end
  ob_t t_e6_g_fold
  ob_u fo
  ob_t t_e6_p_b3
  ob_u nf
  ob_t t_e6_f_st1
  ob_gp get g_e6_b1f sb 6
  ob_t t_e6_p_par2
  ob_gp get g_e6_b1f add sb 1 6
  ob_t t_e6_p_par3
  ob_gp get g_e6_b1f add sb 2 6
  ob_t t_e6_p_par4
  ob_gp get g_e6_b1f add sb 3 6
  ob_t t_e6_p_par5
  ob_fix get g_e6_b1f add sb 4 2
  ob_t t_e6_f_kap
  ob_fix get g_e6_b1f add sb 5 1
  ob_t t_e6_f_tmls
  ob_fix div get g_e6_b1f add sb 6 f64 sub n1 nf 6
  ob_t t_e6_g_omls
  ob_fix omls 6
  ob_t t_e6_f_st2
  ob_gp get g_e6_b2f 0 6
  ob_t t_e6_f_nuh
  ob_gp get g_e6_b2f 1 6
  ob_t t_e6_f_ch
  ob_fix get g_e6_b2f 2 2
  ob_t t_e6_f_kh
  ob_fix get g_e6_b2f 3 1
  ob_nl
end

fn e6_tr2_run_sb sb ulong to long
  ret e6_tr2_run get g_e6_b1f sb get g_e6_b1f add sb 1 get g_e6_b1f add sb 2 get g_e6_b1f add sb 3 get g_e6_b1f add sb 4
end

fn e6_fold_score10 w ulong fo ulong tn10 ulong to void
  flh = new f64 2 0.0
  for j ulong tn10 bound ER_UNB
    if eq get g_e6_fold10 j fo
      lp10 = e6_ten_step j flh
      if eq w 0
        put g_e6_f10_flo0 j get flh 0
        put g_e6_f10_fhi0 j get flh 1
        put g_e6_f10_lp0 j lp10
      else
        put g_e6_f10_flo1 j get flh 0
        put g_e6_f10_fhi1 j get flh 1
        put g_e6_f10_lp1 j lp10
      end
    end
  end
end

fn e6_g1sfull_run_fold w ulong fo ulong n1 ulong nfold ulong to int
  slot = fo
  if ne w 0
    slot = add 10 fo
  end
  sb = mul slot 8
  if ne e6_tr2_run_sb sb 0
    e6_eputs t_e6_err_refit
    ret 1
  end
  if ne get g_e6_tr2_n 0 n1
    e6_eputs t_e6_err_refit
    ret 1
  end
  nfv = new ulong 1 0
  s = e6_fold_score1 w fo sb n1 nfv
  tn10 = get g_e6_tr2_n 1
  if eq get g_e6_h10 0 0
    if ne e6_g1sfull_init_f10 tn10 nfold 0
      e6_eputs t_e6_err_oom
      ret 2
    end
    put g_e6_h10 0 1
    put g_e6_h10 1 tn10
  end
  for j ulong tn10 bound ER_UNB
    if ne get g_e6_fold10 j fo
      put g_e6_keep j 1
    else
      put g_e6_keep j 0
    end
  end
  kf = ulong 0
  if eq w 0
    kf = 1
  end
  e6_stage2 tn10 kf
  if eq get g_e6_b2h 0 0
    ob_init 2
    ob_t t_e6_err_st2_a
    ob_u fo
    ob_t t_e6_err_st2_b
    ob_flush
    ret 1
  end
  e6_fold_score10 w fo tn10
  e6_fold_print fo sb n1 get nfv 0 s
  ret 0
end

fn e6_g1sfull_alloc_oo n1 ulong boot ulong to long
  er = enlarge g_e6_oo_flo0 n1
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_oo_fhi0 n1
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_oo_lp0 n1
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_oo_flo1 n1
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_oo_fhi1 n1
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_oo_lp1 n1
  if lt er 0
    ret 1
  end
  er = enlarge g_e6_sdr mul boot E6_NV
  if lt er 0
    ret 1
  end
  ret 0
end

fn e6_g1sfull_print_final slot ulong pre view uchar * n1 ulong to void
  sb = mul slot 8
  ob_t pre
  ob_gp get g_e6_b1f sb 6
  ob_t t_e6_p_par2
  ob_gp get g_e6_b1f add sb 1 6
  ob_t t_e6_p_par3
  ob_gp get g_e6_b1f add sb 2 6
  ob_t t_e6_p_par4
  ob_gp get g_e6_b1f add sb 3 6
  ob_t t_e6_p_par5
  ob_fix get g_e6_b1f add sb 4 2
  ob_t t_e6_f_kap
  ob_fix get g_e6_b1f add sb 5 1
  ob_t t_e6_f_ismls
  ob_fix div get g_e6_b1f add sb 6 f64 n1 6
  ob_nl
end

fn e6_search_inner n1 ulong nfold ulong stride ulong to ulong
  pts = ulong 0
  u = ulong 0
  while lt u E6_NNU bound 7
    ci = ulong 0
    while lt ci E6_NCX bound 21
      put g_e6_b1tmp 3 e6_nux u
      put g_e6_b1tmp 4 div f64 add 20 mul 5 ci f64 100.0
      e6_g1sfull_grid_pt n1 nfold
      pts = add pts 1
      ci = add ci stride
    end
    u = add u stride
  end
  ret pts
end

fn e6_tr2_run_tmp to long
  ret e6_tr2_run get g_e6_b1tmp 0 get g_e6_b1tmp 1 get g_e6_b1tmp 2 f64 1.0 f64 1.0
end

fn e6_search_step nfold ulong stride ulong st edit ulong 4 to int
  if ne e6_tr2_run_tmp 0
    put st 3 add get st 3 1
    ret 0
  end
  if eq get st 0 0
    n1 = get g_e6_tr2_n 0
    if ne e6_g1sfull_init_folds n1 nfold 0
      e6_eputs t_e6_err_oom
      ret 2
    end
    put st 0 1
    put st 1 n1
  else
    if ne get g_e6_tr2_n 0 get st 1
      e6_eputs t_e6_err_stepchg
      ret 1
    end
  end
  put st 2 add get st 2 e6_search_inner get st 1 nfold stride
  ret 0
end

fn e6_g1sfull_search nfold ulong stride ulong out_meta edit ulong 3 to int
  for i ulong 22
    put g_e6_b1h i 0
    sb = mul i 8
    for j ulong 8
      put g_e6_b1f add sb j f64 0.0
    end
    put g_e6_b1f add sb 6 est_ninf
  end
  st = new ulong 4 0
  a = ulong 0
  while lt a E6_NDYN bound 6
    bq = ulong 0
    while lt bq E6_NQX bound 9
      l = ulong 0
      while lt l E6_NLAMX bound 7
        put g_e6_b1tmp 0 e6_dynx a
        put g_e6_b1tmp 1 est_pow f64 10.0 add f64 2.0 mul f64 0.5 f64 bq
        put g_e6_b1tmp 2 e6_lamx l
        rc = e6_search_step nfold stride st
        if ne rc 0
          ret rc
        end
        l = add l stride
      end
      bq = add bq stride
    end
    a = add a stride
  end
  if eq get st 0 0
    e6_eputs t_e6_err_nogrid
    ret 1
  end
  put out_meta 0 get st 1
  put out_meta 1 get st 2
  put out_meta 2 get st 3
  ret 0
end

fn e6_g1sfull_body nfold ulong stride ulong boot ulong to int
  rc = e6_load_inputs
  if ne rc 0
    ret rc
  end
  ob_init 1
  ob_t t_e6_p_in1
  e6_ob_ef_sha
  ob_t t_e6_p_in2
  e6_ob_mk_sha
  ob_nl
  ob_t t_e6_f_dev
  if ne e6_tr2_alloc get g_c3t_meta 0 0
    e6_eputs t_e6_err_oom
    ret 2
  end
  meta = new ulong 3 0
  rc = e6_g1sfull_search nfold stride meta
  if ne rc 0
    ret rc
  end
  n1 = get meta 0
  ob_t t_e6_f_grid1
  ob_u stride
  ob_t t_e6_f_grid2
  ob_u get meta 1
  ob_t t_e6_f_grid3
  ob_u get meta 2
  ob_t t_e6_f_grid4
  ob_u n1
  ob_t t_e6_f_grid5
  ob_u nfold
  ob_nl
  if ne e6_g1sfull_alloc_oo n1 boot 0
    e6_eputs t_e6_err_oom
    ret 2
  end
  put g_e6_h10 0 0
  put g_e6_h10 1 0
  for w ulong 2
    if eq w 0
      ob_t t_e6_f_h0
    else
      ob_t t_e6_f_h1
    end
    ob_u nfold
    ob_t t_e6_f_h2
    for fo ulong nfold bound 10
      rc = e6_g1sfull_run_fold w fo n1 nfold
      if ne rc 0
        ret rc
      end
    end
    e6_g1sfull_pool_report w n1 get g_e6_h10 1 boot
  end
  ob_t t_e6_f_fin0
  e6_g1sfull_print_final 20 t_e6_f_fin1 n1
  e6_g1sfull_print_final 21 t_e6_f_fin2 n1
  ob_t t_e6_f_tie
  ob_flush
  ret 0
end

fn e6_cmd_g1sfull ac ulong to int
  have_raw = ulong 0
  have_mk = ulong 0
  nfold = long 5
  stride = long 1
  boot = long 2000
  i = ulong 2
  while lt i ac bound 256
    if and e6_arg_eq i t_e6_f_raw lt add i 1 ac
      i = add i 1
      e6_copy_arg_to_raw i
      have_raw = 1
    else
      if and e6_arg_eq i t_e6_f_marks lt add i 1 ac
        i = add i 1
        e6_copy_arg_to_mk i
        have_mk = 1
      else
        if and e6_arg_eq i t_e6_f_folds lt add i 1 ac
          i = add i 1
          nfold = e6_arg_i64 i
        else
          if and e6_arg_eq i t_e6_f_stride lt add i 1 ac
            i = add i 1
            stride = e6_arg_i64 i
          else
            if and e6_arg_eq i t_e6_f_boot lt add i 1 ac
              i = add i 1
              boot = e6_arg_i64 i
            else
              e6_eputs t_e6_usage_g1sfull
              ret 2
            end
          end
        end
      end
    end
    i = add i 1
  end
  bad = ulong 0
  if or eq have_raw 0 eq have_mk 0
    bad = 1
  end
  if or lt nfold 2 gt nfold 10
    bad = 1
  end
  if or lt stride 1 lt boot 100
    bad = 1
  end
  if ne bad 0
    e6_eputs t_e6_err_miss_g1sfull
    ret 2
  end
  ret e6_g1sfull_body ulong nfold ulong stride ulong boot
end

note ---- cmd_twopiece_selfcheck ----
fn e6_tpsc_val i ulong kind ulong to f64
  if eq kind 0
    if eq i 0
      ret f64 0.8
    end
    if eq i 1
      ret f64 1.25
    end
    ret f64 5.0
  end
  if eq kind 1
    if eq i 0
      ret f64 0.3
    end
    if eq i 1
      ret f64 1.0
    end
    ret f64 4.0
  end
  if eq i 0
    ret f64 0.0
  end
  if eq i 1
    ret f64 0.37
  end
  ret f64 -2.6
end

fn e6_tpsc_k1_diff sc f64 nu f64 to f64
  f2 = new f64 2 0.0
  put g_e6_os 0 mul sc C3_QUANTUM
  put g_e6_os 1 nu
  ign = e6_sym_edges_s 0
  put g_e6_tp_lh 2 get g_e6_tp_lh 0
  put g_e6_tp_lh 3 get g_e6_tp_lh 1
  ret e6_tp_point f64 1.0 f2
end

fn e6_tpsc_step ki ulong prev_hi edit f64 1 res edit f64 3 bad edit ulong 1 to f64
  flh = new f64 2 0.0
  k = sub long ki EST_PRED_K
  kap = get g_e6_b1tmp 0
  put g_e6_os 0 mul get g_e6_b1tmp 2 C3_QUANTUM
  put g_e6_os 1 get g_e6_b1tmp 1
  put g_e6_os 4 add get g_e6_os 3 mul f64 k C3_QUANTUM
  lp = e6_one_step kap flh
  fl = get flh 0
  fh = get flh 1
  if gt k neg EST_PRED_K
    j = e6_fabs sub fl get prev_hi 0
    if gt j get res 1
      put res 1 j
    end
  end
  if lt fh sub fl f64 1.0e-15
    put bad 0 1
  end
  put prev_hi 0 fh
  if and eq kap f64 1.0 and ge k -3 le k 3
    d = e6_fabs sub e6_tpsc_k1_diff get g_e6_b1tmp 2 get g_e6_b1tmp 1 lp
    if gt d get res 2
      put res 2 d
    end
  end
  ret est_exp lp
end

fn e6_tpsc_one res edit f64 3 bad edit ulong 1 to void
  anchor = mul f64 1234.0 C3_QUANTUM
  put g_e6_os 2 add anchor mul get g_e6_b1tmp 3 C3_QUANTUM
  put g_e6_os 3 anchor
  prev_hi = new f64 1 0.0
  sum = f64 0.0
  for ki ulong EST_PRED_N
    sum = add sum e6_tpsc_step ki prev_hi res bad
  end
  ds = e6_fabs sub sum f64 1.0
  if gt ds get res 0
    put res 0 ds
  end
end

fn e6_cmd_twopiece_selfcheck to int
  res = new f64 3 0.0
  bad = new ulong 1 0
  for ki ulong E6_NKS
    put g_e6_b1tmp 0 e6_kappa ki
    for a ulong 3
      put g_e6_b1tmp 1 e6_tpsc_val a 0
      for b ulong 3
        put g_e6_b1tmp 2 e6_tpsc_val b 1
        for c ulong 3
          put g_e6_b1tmp 3 e6_tpsc_val c 2
          e6_tpsc_one res bad
        end
      end
    end
  end
  ms = get res 0
  mj = get res 1
  mk1 = get res 2
  bv = get bad 0
  ob_init 1
  ob_t t_e6_tp1
  ob_gp ms 3
  ob_t t_e6_tp2
  ob_gp mj 3
  ob_t t_e6_tp3
  ob_gp mk1 3
  ob_t t_e6_tp4
  if ne bv 0
    ob_t t_e6_no
  else
    ob_t t_e6_yes
  end
  ob_nl
  ok = true
  if ge ms f64 1.0e-9
    ok = false
  end
  if ge mj f64 1.0e-9
    ok = false
  end
  if ge mk1 f64 1.0e-9
    ok = false
  end
  if ne bv 0
    ok = false
  end
  ob_t t_e6_tp5
  if ok
    ob_t t_e6_pass
  else
    ob_t t_e6_fail
  end
  ob_nl
  ob_flush
  if ok
    ret 0
  end
  ret 1
end

fn main to int
  ac = ulong argcnt
  if lt ac 2
    e6_eputs t_e6_usage_main
    ret 2
  end
  if e6_arg_eq 1 t_e6_cmd_g1pit
    ret e6_cmd_g1pit ac
  end
  if e6_arg_eq 1 t_e6_cmd_sched
    ret e6_cmd_sched ac
  end
  if e6_arg_eq 1 t_e6_cmd_pick
    ret e6_cmd_pick ac
  end
  if e6_arg_eq 1 t_e6_cmd_plan6
    ret e6_cmd_plan6 ac
  end
  if e6_arg_eq 1 t_e6_cmd_g1s
    ret e6_cmd_g1s ac
  end
  if e6_arg_eq 1 t_e6_cmd_g1sfull
    ret e6_cmd_g1sfull ac
  end
  if e6_arg_eq 1 t_e6_cmd_tpsc
    ret e6_cmd_twopiece_selfcheck
  end
  e6_eputs t_e6_usage_main
  ret 2
end

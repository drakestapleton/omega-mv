note
note tools/estimation/est_replay_main.om -- standalone est_replay CLI entry point.
note Composed after: est_defs.om est_math.om est_types.om est_kf.om est_mix.om est_replay.om.

text t_rpm_usage "usage: est_replay model q r file\n"
text t_rpm_bad "bad model, q or r\n"
text t_rpm_fail "replay failed\n"
text t_rpm_s1 "steps="
text t_rpm_s2 " coasts="
text t_rpm_s3 " leading_missing="
text t_rpm_s4 " bad_value="
text t_rpm_s5 " bad_t="

fn rpm_arg_i64 idx ulong dst edit long 1 to bool
  buf = new uchar 64 0
  u = new ulong 1 0
  n = argread idx buf 0 64
  if le n 0
    ret false
  end
  if ne er_parse_i64 view buf 0 ulong n dst u 0
    ret false
  end
  ret eq get u 0 ulong n
end

fn rpm_arg_f64 idx ulong dst edit f64 1 to bool
  buf = new uchar 64 0
  u = new ulong 1 0
  n = argread idx buf 0 64
  if le n 0
    ret false
  end
  if ne er_parse_f64 view buf 0 ulong n dst u 0
    ret false
  end
  ret eq get u 0 ulong n
end

fn main to int
  a4 = new uchar 1024 0
  mo = new long 1 0
  qo = new f64 1 0.0
  ro = new f64 1 0.0
  ac = argcnt
  if ne ac 5
    est_eputs t_rpm_usage
    ret 2
  end
  if not rpm_arg_i64 1 mo
    est_eputs t_rpm_bad
    ret 2
  end
  if not rpm_arg_f64 2 qo
    est_eputs t_rpm_bad
    ret 2
  end
  if not rpm_arg_f64 3 ro
    est_eputs t_rpm_bad
    ret 2
  end
  l4 = argread 4 a4 0 1024
  mid = get mo 0
  if or le l4 0 or lt mid 0 gt mid 2
    est_eputs t_rpm_bad
    ret 2
  end
  if ne er_file_load 0 view a4 ulong l4 0
    er_err_print_ref
    ret 1
  end
  if ne est_replay_run 0 ulong 999999999 ulong mid get qo 0 get ro 0 0 0
    est_eputs t_rpm_fail
    ret 1
  end
  est_replay_write_stream 1 0 ulong mid
  ob_init 2
  ob_t t_rpm_s1
  ob_u get g_rp_meta 0
  ob_t t_rpm_s2
  ob_u get g_rp_meta 3
  ob_t t_rpm_s3
  ob_u get g_rp_meta 2
  ob_t t_rpm_s4
  ob_u get g_rp_meta 4
  ob_t t_rpm_s5
  ob_u get g_rp_meta 5
  ob_nl
  ob_flush
  ret 0
end

global g_c3f_stride long 1

note fam_fit[0..5]
global g_c3f_have ulong 6
global g_c3f_ls f64 6
global g_c3f_pts ulong 6
global g_c3f_fin ulong 6
global g_c3f_err ulong 6
global g_c3f_fam ulong 6
global g_c3f_np ulong 6
global g_c3f_par f64 48

note screen stats[0..5]
global g_c3f_st_n ulong 6
global g_c3f_st_unsc ulong 6
global g_c3f_st_ls f64 6
global g_c3f_st_wm f64 6
global g_c3f_st_wmd f64 6
global g_c3f_st_cal ulong 6
global g_c3f_st_ff long 6

text t_e4_rj3 "\",\n  \"synthetic_test\": "
text t_e4_rj4 ",\n  \"tool_commit\": \""
text t_e4_rj5 "\",\n  \"tool_dirty\": "
text t_e4_rj6 ",\n  \"protocol_sha256\": \""
text t_e4_rj7 "\",\n  \"params_sha256\": \""
text t_e4_rj8 "\",\n  \"d2\": {\"dir\": "
text t_e4_rj9 ", \"raw_sha256\": \""
text t_e4_rj10 "\", \"marks_sha256\": \""
text t_e4_rj11 "\", \"schedule_sha256\": \""
text t_e4_rj12 "\", \"lines\": "
text t_e4_rj13 "},\n  \"selected\": \""
text t_e4_rj14 "\",\n  \"comparisons\": {\"same_steps\": "
text t_e4_rj15 ", \"no_worse_than_F1\": "
text t_e4_rj16 ", \"no_worse_than_E0\": "

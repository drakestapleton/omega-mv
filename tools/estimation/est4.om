text t_e4_r_rdir1 "refuse: recorded needs a clean tree (dirty="
text t_e4_r_rd2 "refuse: no D2 identity compiled in (receipts/est-v4/d2.sha256)\n"
text t_e4_r_rpro "refuse: protocol doc on disk differs from the compiled SHA\n"
text t_e4_r_rpsha "refuse: params SHA-256 differs from the compiled params SHA\n"
text t_e4_r_rroot "refuse: no repo root compiled in\n"
text t_e4_r_rout "refuse: a recorded receipt goes only to <repo>/docs/estimation/receipts/est-v4\n"
text t_e4_r_rtag "refuse: the recorded run scores only a -est4-heldout- run\n"
text t_e4_r_rsyn "refuse: --synthetic-test never runs on D1 or a held-out run\n"
text t_e4_r_rsynd2 "refuse: --synthetic-test never runs on D1 or a held-out run (D2 bytes)\n"
text t_e4_r_rpaf "refuse: params say PHASE_A_FAIL; D2 is NOT_RUN\n"
text t_e4_r_rsel1 "refuse: params selected "
text t_e4_r_rsel2 " but the rule gives "
text t_e4_r_rf1 "refuse: params carry no F1 baseline\n"
text t_e4_r_rnb "refuse: params are not a binding fit\n"
text t_e4_r_rpr2 "refuse: params fitted under another protocol SHA\n"
text t_e4_r_rnd1 "refuse: params are not a fit on the compiled D1\n"
text t_e4_r_rod1 "refuse: outdir "
text t_e4_r_rod2 " is not a readable directory\n"
text t_e4_r_rdup1 "refuse: "
text t_e4_r_rdup2 " already holds a receipt; a second scored run is a new protocol version\n"
text t_e4_r_rpre "refuse: precheck: "
text t_e4_r_rinc "refuse: the pre-check is INCONCLUSIVE; D2 is not scored\n"
text t_e4_r_rd2s "refuse: D2 data SHA-256 differs from the compiled D2 identity\n"
text t_e4_r_rd2b "refuse: scored D2 bytes differ from the compiled D2 identity\n"
text t_e4_r_scerr "scoring error\n"
text t_e4_r_cw "cannot write "


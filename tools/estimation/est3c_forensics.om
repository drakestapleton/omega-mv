global g_f3_st_y f64 8192
global g_f3_st_S f64 8192
global g_f3_st_nu f64 8192
global g_f3_st_nis f64 8192

note series, marks, changes, scratch arrays
global g_f3_s_t long 8192
global g_f3_s_z f64 8192

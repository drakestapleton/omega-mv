note dstat output slots: u[0]=n, u[1]=zero, u[2]=big; f[0]=mean, f[1]=sd, f[2]=exkurt, f[3]=maxabs
global g_f3_ds_u ulong 3
global g_f3_ds_f f64 4
global g_f3_v1_hit ulong 4
global g_f3_v1_sums f64 5
global g_f3_v1_frac f64 3
global g_f3_v1_pit f64 10

fn f3_die msg view uchar * p view uchar * to void
  ob_flush
  ob_init 2
  ob_t t_f3_die1
  ob_t msg
  ob_t t_f3_die2
  ob_t p
  ob_nl
  ob_flush
  exit 2
end

note ---- Formatting helpers (width-aligned using g_ob_buf) ----

fn f3_lpad_from start ulong width ulong to void
  endp = get g_ob_len 0
  w = sub endp start
  if ge w width
    ret
  end
  pad = sub width w
  i = w
  while gt i 0 bound 64
    i = sub i 1
    put g_ob_buf add add start pad i get g_ob_buf add start i
  end
  for j ulong pad
    put g_ob_buf add start j 32
  end
  put g_ob_len 0 add endp pad
end

fn f3_ob_u_w v ulong width ulong to void
  if gt get g_ob_len 0 65400
    ob_flush
  end
  st = get g_ob_len 0
  ob_u v
  f3_lpad_from st width
end

fn f3_ob_fix_w x f64 nd ulong width ulong to void
  if gt get g_ob_len 0 65400
    ob_flush
  end
  st = get g_ob_len 0
  ob_fix x nd
  f3_lpad_from st width
end

fn f3_ob_s_left s view uchar * width ulong to void
  ob_t s
  sl = len s
  if lt sl width
    for i ulong sub width sl
      ob_c 32
    end
  end
end

fn f3_ob_fix_sign x f64 nd ulong to void
  if eq shr bitcast ulong x 63 0
    ob_c 43
  end
  ob_fix x nd
end

note ---- Line & substring helpers on g_f3_line ----

fn f3_line_find llen ulong pat view uchar * to long
  pn = len pat
  if eq pn 0
    ret 0
  end
  if lt llen pn
    ret -1
  end
  lim = add sub llen pn 1
  for i ulong lim
    ok = true
    for j ulong pn
      if ne get g_f3_line add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret long i
    end
  end
  ret -1
end

fn f3_parse_t_at off ulong llen ulong dst edit long 1 to bool
  i = off
  while lt i llen bound 8192
    c = get g_f3_line i
    if and ne c 32 ne c 9
      break
    end
    i = add i 1
  end
  neg_f = ulong 0
  if and lt i llen eq get g_f3_line i 45
    neg_f = 1
    i = add i 1
  else
    if and lt i llen eq get g_f3_line i 43
      i = add i 1
    end
  end
  st = i
  sec = long 0
  while lt i llen bound 32
    c = get g_f3_line i
    if or lt c 48 gt c 57
      break
    end
    sec = add mul sec 10 sub long c 48
    i = add i 1
  end
  if eq i st
    ret false
  end
  if ge i llen
    ret false
  end
  if ne get g_f3_line i 46
    ret false
  end
  i = add i 1
  if gt add i 9 llen
    ret false
  end
  frac = long 0
  for k ulong 9
    c = get g_f3_line add i k
    if or lt c 48 gt c 57
      ret false
    end
    frac = add mul frac 10 sub long c 48
  end
  if eq neg_f 1
    sec = sub 0 sec
  end
  put dst 0 add mul sec F3_NS frac
  ret true
end

fn f3_parse_f64_line off ulong llen ulong dst edit f64 1 to bool
  rem_n = sub llen off
  if gt rem_n 64
    rem_n = 64
  end
  tmp = new uchar 64 0
  for i ulong rem_n
    put tmp i get g_f3_line add off i
  end
  used = new ulong 1 0
  rc = er_parse_f64 view tmp 0 rem_n dst used
  if ne rc 0
    ret false
  end
  if eq get used 0 0
    ret false
  end
  ret true
end

note ---- Buffered line reader state ----
global g_f3_rfd int 1
global g_f3_rpos ulong 1
global g_f3_rlen ulong 1

fn f3_reader_open path view uchar * to void
  fd = fopen path 0 len path 0 0
  if lt fd 0
    f3_die t_f3_eopen path
  end
  put g_f3_rfd 0 int fd
  put g_f3_rpos 0 0
  put g_f3_rlen 0 0
end

fn f3_reader_close to void
  ign = fclose get g_f3_rfd 0
end

note Returns line length (>0), 0 on EOF, or -1 if line exceeds cap or lacks '\n'
fn f3_readline cap ulong to long
  n = ulong 0
  while true bound 8192
    pos = get g_f3_rpos 0
    rlen = get g_f3_rlen 0
    if ge pos rlen
      k = read get g_f3_rfd 0 g_f3_fbuf 0 65536
      if le k 0
        if eq n 0
          ret 0
        end
        ret -1
      end
      pos = 0
      rlen = ulong k
      put g_f3_rpos 0 0
      put g_f3_rlen 0 rlen
    end
    c = get g_f3_fbuf pos
    put g_f3_rpos 0 add pos 1
    if ge n cap
      ret -1
    end
    put g_f3_line n c
    n = add n 1
    if eq c 10
      ret long n
    end
  end
  ret -1
end

note ---- Read series, marks, stream, receipt ----

fn f3_read_series path view uchar * to void
  f3_reader_open path
  put g_f3_s_meta 0 0
  put g_f3_s_meta 1 0
  t_out = new long 1 0
  z_out = new f64 1 0.0
  while true bound 100000
    ll = f3_readline 8191
    if eq ll 0
      break
    end
    if lt ll 0
      f3_reader_close
      f3_die t_f3_elong path
    end
    llu = ulong ll
    pt = f3_line_find llu t_f3_kt
    pz = f3_line_find llu t_f3_kz
    ok = false
    if and ge pt 0 ge pz 0
      if f3_parse_t_at add ulong pt 4 llu t_out
        if f3_parse_f64_line add ulong pz 14 llu z_out
          if est_isfinite get z_out 0
            ok = true
          end
        end
      end
    end
    if not ok
      put g_f3_s_meta 1 add get g_f3_s_meta 1 1
    else
      n = get g_f3_s_meta 0
      if ge n F3_MAXN
        f3_reader_close
        f3_die t_f3_etoom path
      end
      put g_f3_s_t n get t_out 0
      put g_f3_s_z n get z_out 0
      put g_f3_s_meta 0 add n 1
    end
  end
  f3_reader_close
end

fn f3_read_marks path view uchar * to void
  f3_reader_open path
  put g_f3_m_n 0 0
  t_out = new long 1 0
  while true bound 10000
    ll = f3_readline 1023
    if eq ll 0
      break
    end
    if lt ll 0
      f3_reader_close
      f3_die t_f3_ebmk path
    end
    llu = ulong ll
    if not f3_parse_t_at 0 llu t_out
      f3_reader_close
      f3_die t_f3_ebmk path
    end
    n = get g_f3_m_n 0
    if ge n F3_MAXM
      f3_reader_close
      f3_die t_f3_etmk path
    end
    put g_f3_m_t n get t_out 0
    if ge f3_line_find llu t_f3_kbegin 0
      put g_f3_m_beg n 1
    else
      put g_f3_m_beg n 0
    end
    put g_f3_m_n 0 add n 1
  end
  f3_reader_close
end

fn f3_kv llu ulong pat view uchar * ok edit ulong 1 to f64
  p = f3_line_find llu pat
  if lt p 0
    put ok 0 0
    ret 0.0f64
  end
  v = new f64 1 0.0
  if not f3_parse_f64_line add ulong p len pat llu v
    put ok 0 0
    ret 0.0f64
  end
  ret get v 0
end

fn f3_read_stream path view uchar * to ulong
  f3_reader_open path
  n = ulong 0
  ok = new ulong 1 1
  while true bound 100000
    ll = f3_readline 2047
    if eq ll 0
      break
    end
    if lt ll 0
      f3_reader_close
      f3_die t_f3_eslong path
    end
    if ge n F3_MAXN
      f3_reader_close
      f3_die t_f3_estoo path
    end
    llu = ulong ll
    put ok 0 1
    put g_f3_st_L n ulong f3_kv llu t_f3_kL ok
    put g_f3_st_h n long f3_kv llu t_f3_kh ok
    put g_f3_st_z n f3_kv llu t_f3_kz2 ok
    put g_f3_st_y n f3_kv llu t_f3_ky ok
    put g_f3_st_S n f3_kv llu t_f3_kS ok
    put g_f3_st_nu n f3_kv llu t_f3_knu ok
    put g_f3_st_nis n f3_kv llu t_f3_knis ok
    if ge f3_line_find llu t_f3_kprior 0
      put g_f3_st_pr n 1
    else
      put g_f3_st_pr n 0
    end
    if ge f3_line_find llu t_f3_kcoast 0
      put g_f3_st_co n 1
    else
      put g_f3_st_co n 0
    end
    if eq get ok 0 0
      f3_reader_close
      f3_die t_f3_esbad path
    end
    n = add n 1
  end
  f3_reader_close
  ret n
end

fn f3_read_receipt to void
  fd = fopen t_f3_receipt 0 len t_f3_receipt 0 0
  if lt fd 0
    f3_die t_f3_eopen t_f3_receipt
  end
  tot = ulong 0
  while lt tot 65535 bound 65536
    k = read int fd g_f3_rc tot sub 65535 tot
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  ign = fclose int fd
  if eq tot 65535
    f3_die t_f3_erbig t_f3_receipt
  end
  put g_f3_rclen 0 tot
end

fn f3_rc_find from ulong pat view uchar * to long
  tot = get g_f3_rclen 0
  pn = len pat
  if eq pn 0
    ret long from
  end
  if lt tot add from pn
    ret -1
  end
  lim = add sub tot pn 1
  i = from
  while lt i lim bound 65536
    ok = true
    for j ulong pn
      if ne get g_f3_rc add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret long i
    end
    i = add i 1
  end
  ret -1
end

fn f3_rec blk ulong key view uchar * to f64
  pat = new uchar 64 0
  kn = len key
  put pat 0 34
  for i ulong kn
    put pat add i 1 get key i
  end
  put pat add kn 1 34
  put pat add kn 2 58
  p = f3_rc_find blk part pat 0 add kn 3
  if lt p 0
    f3_die t_f3_erkm key
  end
  pos = add ulong p add kn 3
  tot = get g_f3_rclen 0
  while and lt pos tot eq get g_f3_rc pos 32 bound 64
    pos = add pos 1
  end
  if and lt pos tot eq get g_f3_rc pos 123
    vp = f3_rc_find pos t_f3_kval
    if lt vp 0
      f3_die t_f3_ervm key
    end
    pos = add ulong vp 8
  end
  rem_n = sub tot pos
  if gt rem_n 64
    rem_n = 64
  end
  tmp = new uchar 64 0
  for i ulong rem_n
    put tmp i get g_f3_rc add pos i
  end
  dst = new f64 1 0.0
  used = new ulong 1 0
  ign = er_parse_f64 view tmp 0 rem_n dst used
  ret get dst 0
end

note ---- Statistics helpers ----

fn f3_phi x f64 to f64
  ret mul 0.5f64 est_erfc div neg x EST_SQRT2
end

note which: 0=g_f3_c_d, 1=g_f3_din, 2=g_f3_dsp, 3=g_f3_zz, 4=g_f3_w, 5=g_f3_ad
fn f3_arr_get which ulong i ulong to f64
  if eq which 0
    ret get g_f3_c_d i
  end
  if eq which 1
    ret get g_f3_din i
  end
  if eq which 2
    ret get g_f3_dsp i
  end
  if eq which 3
    ret get g_f3_zz i
  end
  if eq which 4
    ret get g_f3_w i
  end
  ret get g_f3_ad i
end

fn f3_describe which ulong n ulong to void
  put g_f3_ds_u 0 n
  put g_f3_ds_u 1 0
  put g_f3_ds_u 2 0
  put g_f3_ds_f 0 0.0
  put g_f3_ds_f 1 0.0
  put g_f3_ds_f 2 0.0
  put g_f3_ds_f 3 0.0
  if lt n 4
    ret
  end
  m = f64 0.0
  for i ulong n
    m = add m f3_arr_get which i
  end
  m = div m f64 n
  m2 = f64 0.0
  m4 = f64 0.0
  zr = ulong 0
  bg = ulong 0
  ma = f64 0.0
  for i ulong n
    xi = f3_arr_get which i
    e = sub xi m
    e2 = mul e e
    m2 = add m2 e2
    m4 = add m4 mul e2 e2
    if eq xi 0.0f64
      zr = add zr 1
    end
    ax = fabs xi
    if ge ax 1000.0f64
      bg = add bg 1
    end
    if gt ax ma
      ma = ax
    end
  end
  m2 = div m2 f64 n
  m4 = div m4 f64 n
  put g_f3_ds_u 1 zr
  put g_f3_ds_u 2 bg
  put g_f3_ds_f 0 m
  put g_f3_ds_f 1 fsqrt m2
  if gt m2 0.0f64
    put g_f3_ds_f 2 sub div m4 mul m2 m2 3.0f64
  end
  put g_f3_ds_f 3 ma
end

fn f3_acf_lag which ulong n ulong m f64 k ulong to f64
  if le n k
    ret 0.0f64
  end
  num = f64 0.0
  lim = sub n k
  for i ulong lim
    a = sub f3_arr_get which i m
    b = sub f3_arr_get which add i k m
    num = add num mul a b
  end
  ret num
end

fn f3_acf10 which ulong n ulong to f64
  dn = f64 n
  m = f64 0.0
  for i ulong n
    m = add m f3_arr_get which i
  end
  m = div m dn
  den = f64 0.0
  for i ulong n
    e = sub f3_arr_get which i m
    den = add den mul e e
  end
  lb = f64 0.0
  for k0 ulong 10
    k = add k0 1
    num = f3_acf_lag which n m k
    rk = f64 0.0
    if gt den 0.0f64
      rk = div num den
    end
    put g_f3_acf k rk
    lb = add lb div mul rk rk sub dn f64 k
  end
  ret mul mul dn add dn 2.0f64 lb
end

fn f3_print_dstat tag view uchar * to void
  n = get g_f3_ds_u 0
  zr = get g_f3_ds_u 1
  bg = get g_f3_ds_u 2
  sd = get g_f3_ds_f 1
  exk = get g_f3_ds_f 2
  ma = get g_f3_ds_f 3
  pz = f64 1.0
  if gt sd 0.0f64
    pz = est_erf div F3_CELL mul sd EST_SQRT2
  end
  zf = f64 0.0
  bf = f64 0.0
  if gt n 0
    zf = div f64 zr f64 n
    bf = div f64 bg f64 n
  end
  ob_c 32
  ob_c 32
  f3_ob_s_left tag 22
  ob_t t_f3_ds1
  f3_ob_u_w n 5
  ob_t t_f3_ds2
  f3_ob_fix_w sd 1 7
  ob_t t_f3_ds3
  f3_ob_fix_w exk 2 7
  ob_t t_f3_ds4
  f3_ob_fix_w ma 0 6
  ob_t t_f3_ds5
  ob_u zr
  ob_t t_f3_ds6
  ob_fix zf 4
  ob_t t_f3_ds7
  ob_fix pz 4
  ob_t t_f3_ds8
  ob_fix bf 4
  ob_nl
end

fn f3_cmp name view uchar * recd f64 mine f64 to void
  ob_c 32
  ob_c 32
  f3_ob_s_left name 14
  ob_t t_f3_c1
  ob_g17 recd
  ob_t t_f3_c2
  ob_g17 mine
  ob_t t_f3_c3
  ob_gp fabs sub recd mine 3
  if eq recd mine
    ob_t t_f3_exact
  end
  ob_nl
end

note ---- v1 stream reproduction ----

fn f3_v1_cell_accum nu f64 sd f64 to void
  flo = f3_phi div sub nu F3_CELL sd
  fhi = f3_phi div add nu F3_CELL sd
  wd = sub fhi flo
  lv = new f64 3 0.50
  put lv 1 0.80
  put lv 2 0.95
  for k ulong 3
    lo = div sub 1.0f64 get lv k 2.0f64
    hi = sub 1.0f64 lo
    if gt wd 0.0f64
      ov = sub fmin hi fhi fmax lo flo
      if gt ov 0.0f64
        put g_f3_v1_frac k add get g_f3_v1_frac k div ov wd
      end
    else
      if and ge flo lo le flo hi
        put g_f3_v1_frac k add get g_f3_v1_frac k 1.0f64
      end
    end
  end
  for b ulong 10
    lo = div f64 b 10.0f64
    hi = div f64 add b 1 10.0f64
    if gt wd 0.0f64
      ov = sub fmin hi fhi fmax lo flo
      if gt ov 0.0f64
        put g_f3_v1_pit b add get g_f3_v1_pit b div ov wd
      end
    else
      if and ge flo lo or lt flo hi eq b 9
        put g_f3_v1_pit b add get g_f3_v1_pit b 1.0f64
      end
    end
  end
end

fn f3_v1_print_cmps m ulong n ulong blk ulong to void
  dn = f64 n
  mn = div get g_f3_v1_sums 3 dn
  v = f64 0.0
  for i ulong n
    e = sub get g_f3_nus i mn
    v = add v mul e e
  end
  ob_t t_f3_v1a
  if eq m 0
    ob_t t_f3_m0
  else
    ob_t t_f3_m1
  end
  ob_t t_f3_v1b
  ob_u n
  ob_t t_f3_v1c
  ob_fix f3_rec blk t_f3_rk_samples 0
  ob_t t_f3_v1d
  f3_cmp t_f3_rk_c50 f3_rec blk t_f3_rk_c50 div f64 get g_f3_v1_hit 0 dn
  f3_cmp t_f3_rk_c80 f3_rec blk t_f3_rk_c80 div f64 get g_f3_v1_hit 1 dn
  f3_cmp t_f3_rk_c95 f3_rec blk t_f3_rk_c95 div f64 get g_f3_v1_hit 2 dn
  f3_cmp t_f3_rk_mnis f3_rec blk t_f3_rk_mnis div get g_f3_v1_sums 0 dn
  f3_cmp t_f3_nm_sb f3_rec blk t_f3_rk_sb div mn fsqrt div v sub dn 1.0f64
  f3_cmp t_f3_nm_l1 f3_rec blk t_f3_rk_l1 get g_f3_acf 1
  f3_cmp t_f3_nm_lb f3_rec blk t_f3_rk_lb get g_f3_v1_sums 4
  f3_cmp t_f3_nm_rmse f3_rec blk t_f3_rk_rmse fsqrt div get g_f3_v1_sums 1 dn
  f3_cmp t_f3_nm_prmse f3_rec blk t_f3_rk_prmse fsqrt div get g_f3_v1_sums 2 dn
  f3_cmp t_f3_nm_zi f3_rec blk t_f3_rk_zi div f64 get g_f3_v1_hit 3 dn
end

fn f3_v1_step i ulong n ulong prev_z f64 to void
  sd = fsqrt get g_f3_st_S i
  nu = get g_f3_st_nu i
  a = fabs nu
  if le a mul 0.674490f64 sd
    put g_f3_v1_hit 0 add get g_f3_v1_hit 0 1
  end
  if le a mul 1.281552f64 sd
    put g_f3_v1_hit 1 add get g_f3_v1_hit 1 1
  end
  if le a mul 1.959964f64 sd
    put g_f3_v1_hit 2 add get g_f3_v1_hit 2 1
  end
  put g_f3_v1_sums 0 add get g_f3_v1_sums 0 get g_f3_st_nis i
  put g_f3_v1_sums 1 add get g_f3_v1_sums 1 mul nu nu
  put g_f3_v1_sums 3 add get g_f3_v1_sums 3 nu
  put g_f3_nus n nu
  if eq nu 0.0f64
    put g_f3_v1_hit 3 add get g_f3_v1_hit 3 1
  end
  e = sub get g_f3_st_z i prev_z
  put g_f3_v1_sums 2 add get g_f3_v1_sums 2 mul e e
  put g_f3_w n div nu sd
  f3_v1_cell_accum nu sd
end

fn f3_v1_clear to void
  for k ulong 4
    put g_f3_v1_hit k 0
  end
  for k ulong 5
    put g_f3_v1_sums k 0.0
  end
  for k ulong 3
    put g_f3_v1_frac k 0.0
  end
  for k ulong 10
    put g_f3_v1_pit k 0.0
  end
end

fn f3_v1_model m ulong to void
  n_all = ulong 0
  if eq m 0
    n_all = f3_read_stream t_f3_stream0
  else
    n_all = f3_read_stream t_f3_stream1
  end
  f3_v1_clear
  n = ulong 0
  prev_z = f64 0.0
  for i ulong n_all
    if ne get g_f3_st_pr i 0
      prev_z = get g_f3_st_z i
      continue
    end
    if ne get g_f3_st_co i 0
      continue
    end
    if ge get g_f3_st_L i F3_BURN
      f3_v1_step i n prev_z
      n = add n 1
    end
    prev_z = get g_f3_st_z i
  end
  put g_f3_v1_sums 4 f3_acf10 4 n
  mod = f3_rc_find 0 t_f3_kmodels
  if lt mod 0
    f3_die t_f3_emblk t_f3_recn
  end
  blk = long -1
  if eq m 0
    blk = f3_rc_find ulong mod t_f3_km0
  else
    blk = f3_rc_find ulong mod t_f3_km1
  end
  if lt blk 0
    f3_die t_f3_emblk2 t_f3_recn
  end
  f3_v1_print_cmps m n ulong blk
  dn = f64 n
  ob_t t_f3_fc1
  ob_fix div get g_f3_v1_frac 0 dn 4
  ob_t t_f3_fc2
  ob_fix div get g_f3_v1_frac 1 dn 4
  ob_t t_f3_fc3
  ob_fix div get g_f3_v1_frac 2 dn 4
  ob_t t_f3_fc4
  ob_fix div f64 get g_f3_v1_hit 0 dn 4
  ob_c 32
  ob_fix div f64 get g_f3_v1_hit 1 dn 4
  ob_c 32
  ob_fix div f64 get g_f3_v1_hit 2 dn 4
  ob_c 41
  ob_nl
  ob_t t_f3_pit
  for b ulong 10
    ob_c 32
    ob_fix div get g_f3_v1_pit b dn 3
  end
  ob_nl
end

note ---- Per-run report ----

fn f3_gap_s l0 ulong lv ulong to long
  dt = sub get g_f3_s_t lv get g_f3_s_t l0
  dt = add dt long 500000000
  ret div dt F3_NS
end

fn f3_make_changes to void
  sn = get g_f3_s_meta 0
  cn = ulong 0
  multi = ulong 0
  if gt sn 1
    for l0 ulong sub sn 1
      lv = add l0 1
      h = f3_gap_s l0 lv
      if lt h 1
        h = 1
      end
      if lt lv F3_BURN
        continue
      end
      if ne h 1
        multi = add multi 1
        continue
      end
      z1 = get g_f3_s_z lv
      z0 = get g_f3_s_z l0
      d = sub z1 z0
      put g_f3_c_d cn d
      put g_f3_c_L cn lv
      cn = add cn 1
    end
  end
  put g_f3_c_meta 0 cn
  put g_f3_c_meta 1 multi
end

fn f3_sample_in_pair t long mn ulong to bool
  if le mn 1
    ret false
  end
  for j ulong sub mn 1
    if and ne get g_f3_m_beg j 0 eq get g_f3_m_beg add j 1 0
      if and ge t get g_f3_m_t j le t get g_f3_m_t add j 1
        ret true
      end
    end
  end
  ret false
end

fn f3_change_spans t0 long t1 long mn ulong to bool
  for j ulong mn
    mt = get g_f3_m_t j
    if and gt mt t0 le mt t1
      ret true
    end
  end
  ret false
end

fn f3_count_outside sn ulong mn ulong to ulong
  outside = ulong 0
  for lv ulong sn
    if not f3_sample_in_pair get g_f3_s_t lv mn
      outside = add outside 1
    end
  end
  ret outside
end

fn f3_split_marks cn ulong mn ulong out_n edit ulong 2 to void
  nin = ulong 0
  nsp = ulong 0
  for i ulong cn
    li = get g_f3_c_L i
    t0 = get g_f3_s_t sub li 1
    t1 = get g_f3_s_t li
    dv = get g_f3_c_d i
    if f3_change_spans t0 t1 mn
      put g_f3_dsp nsp dv
      nsp = add nsp 1
    else
      put g_f3_din nin dv
      nin = add nin 1
    end
  end
  put out_n 0 nin
  put out_n 1 nsp
end

fn f3_report_marks mpath view uchar * to void
  f3_read_marks mpath
  sn = get g_f3_s_meta 0
  mn = get g_f3_m_n 0
  cn = get g_f3_c_meta 0
  begins = ulong 0
  for j ulong mn
    begins = add begins get g_f3_m_beg j
  end
  outside = f3_count_outside sn mn
  ns = new ulong 2 0
  f3_split_marks cn mn ns
  ob_t t_f3_mk1
  ob_u mn
  ob_t t_f3_mk2
  ob_u begins
  ob_t t_f3_mk3
  ob_u outside
  ob_t t_f3_mk4
  ob_u sn
  ob_nl
  f3_describe 1 get ns 0
  f3_print_dstat t_f3_ds_in
  f3_describe 2 get ns 1
  f3_print_dstat t_f3_ds_sp
end

fn f3_ewma_record d f64 s2 f64 flk f64 res edit ulong 3 to void
  scv = s2
  if lt scv flk
    scv = flk
  end
  zm = div d fsqrt scv
  m = get res 0
  put g_f3_zz m zm
  az = fabs zm
  if le az 0.674490f64
    put res 1 add get res 1 1
  end
  if le az 1.959964f64
    put res 2 add get res 2 1
  end
  put res 0 add m 1
end

fn f3_dz l0 ulong lv ulong to f64
  z1 = get g_f3_s_z lv
  z0 = get g_f3_s_z l0
  ret sub z1 z0
end

fn f3_ewma_loop lk f64 flk f64 init f64 res edit ulong 3 to void
  sn = get g_f3_s_meta 0
  s2 = init
  if gt sn 1
    for l0 ulong sub sn 1
      lv = add l0 1
      h = f3_gap_s l0 lv
      d = f3_dz l0 lv
      if and ge lv F3_BURN eq h 1
        f3_ewma_record d s2 flk res
      end
      if eq h 1
        s2 = add mul lk s2 mul sub 1.0f64 lk mul d d
      end
    end
  end
end

fn f3_report_ewma_one lk f64 flk f64 init f64 to void
  res = new ulong 3 0
  f3_ewma_loop lk flk init res
  m = get res 0
  h50 = get res 1
  h95 = get res 2
  f3_describe 3 m
  ob_t t_f3_ew1
  ob_fix lk 2
  ob_t t_f3_ew2
  f3_ob_fix_w flk 0 5
  ob_t t_f3_ew3
  ob_fix init 0
  ob_t t_f3_ew4
  f3_ob_fix_w get g_f3_ds_f 2 2 7
  ob_t t_f3_fx2
  ob_fix div f64 h50 f64 m 4
  ob_t t_f3_fx3
  ob_fix div f64 h95 f64 m 4
  ob_t t_f3_ew5
  ob_fix get g_f3_ds_f 1 3
  ob_t t_f3_ew6
  ob_fix get g_f3_ds_f 3 1
  ob_t t_f3_ds1
  ob_u m
  ob_nl
end

fn f3_ewma_init fl f64 to f64
  sn = get g_f3_s_meta 0
  init = f64 0.0
  ni = ulong 0
  lim = F3_BURN
  if lt sn lim
    lim = sn
  end
  if gt lim 1
    for l0 ulong sub lim 1
      lv = add l0 1
      if eq f3_gap_s l0 lv 1
        d = f3_dz l0 lv
        init = add init mul d d
        ni = add ni 1
      end
    end
  end
  if gt ni 0
    init = div init f64 ni
  else
    init = fl
  end
  if lt init fl
    init = fl
  end
  ret init
end

fn f3_report_ewma all_sd f64 all_exk f64 to void
  cn = get g_f3_c_meta 0
  fl = div 10000.0f64 12.0f64
  init = f3_ewma_init fl
  h50 = ulong 0
  h95 = ulong 0
  for i ulong cn
    a = div fabs get g_f3_c_d i all_sd
    if le a 0.674490f64
      h50 = add h50 1
    end
    if le a 1.959964f64
      h95 = add h95 1
    end
  end
  ob_t t_f3_fx1
  f3_ob_fix_w all_exk 2 7
  ob_t t_f3_fx2
  ob_fix div f64 h50 f64 cn 4
  ob_t t_f3_fx3
  ob_fix div f64 h95 f64 cn 4
  ob_nl
  f3_report_ewma_one 0.90f64 fl init
  f3_report_ewma_one 0.97f64 fl init
  f3_report_ewma_one 0.90f64 10000.0f64 init
  f3_report_ewma_one 0.97f64 10000.0f64 init
end

fn f3_run_report idx ulong to void
  if eq idx 0
    f3_read_series t_f3_path_a
  else
    if eq idx 1
      f3_read_series t_f3_path_b
    else
      f3_read_series t_f3_path_c1
    end
  end
  f3_make_changes
  sn = get g_f3_s_meta 0
  sbad = get g_f3_s_meta 1
  cn = get g_f3_c_meta 0
  cmul = get g_f3_c_meta 1
  ob_nl
  if eq idx 0
    ob_t t_f3_na
  else
    if eq idx 1
      ob_t t_f3_nb
    else
      ob_t t_f3_nc1
    end
  end
  ob_t t_f3_rr1
  ob_u add sn sbad
  ob_t t_f3_rr2
  ob_u sbad
  ob_t t_f3_rr3
  ob_u cn
  ob_t t_f3_rr4
  ob_u cmul
  ob_nl
  f3_describe 0 cn
  all_sd = get g_f3_ds_f 1
  all_exk = get g_f3_ds_f 2
  f3_print_dstat t_f3_ds_all
  if eq idx 0
    f3_report_marks t_f3_mark_a
  else
    if eq idx 1
      f3_report_marks t_f3_mark_b
    end
  end
  for i ulong cn
    put g_f3_ad i fabs get g_f3_c_d i
  end
  q = f3_acf10 0 cn
  ob_t t_f3_ac1
  for k0 ulong 10
    ob_c 32
    f3_ob_fix_sign get g_f3_acf add k0 1 3
  end
  ob_t t_f3_lb
  ob_fix q 1
  ob_nl
  qa = f3_acf10 5 cn
  ob_t t_f3_ac2
  for k0 ulong 10
    ob_c 32
    f3_ob_fix_sign get g_f3_acf add k0 1 3
  end
  ob_t t_f3_lb
  ob_fix qa 1
  ob_nl
  if lt idx 2
    f3_report_ewma all_sd all_exk
  end
end

fn main to int
  ob_init 1
  f3_read_receipt
  ob_t t_f3_hdr1
  ob_t t_f3_hdr2
  f3_v1_model 0
  f3_v1_model 1
  f3_run_report 0
  f3_run_report 1
  f3_run_report 2
  ob_flush
  ret 0
end

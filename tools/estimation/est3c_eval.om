note ---- Tool identity helpers ----
fn c3e_tool_dirty to long
  buf = new uchar 64 0
  iv = new long 1 0
  used = new ulong 1 0
  if ne C3_TEST_BUILD 0
    r = er_getenv t_c3e_env_dirty len t_c3e_env_dirty buf 64
    if gt r 0
      if eq er_parse_i64 view buf 0 ulong r iv used 0
        ret get iv 0
      end
      ret 0
    end
    ret long C3_TOOL_DIRTY
  end
  if eq get g_c3e_dirty_init 0 0
    if ne C3_TOOL_DIRTY 0
      put g_c3e_dirty_val 0 long C3_TOOL_DIRTY
    else
      put g_c3e_dirty_val 0 long c3_tree_dirty_now
    end
    put g_c3e_dirty_init 0 1
  end
  ret get g_c3e_dirty_val 0
end

fn c3e_env_or key view uchar * def view uchar * dst edit uchar 128 to ulong
  if ne C3_TEST_BUILD 0
    r = er_getenv key len key dst 128
    if ge r 0
      ret ulong r
    end
  end
  n = len def
  if gt n 128
    n = 128
  end
  for i ulong n bound 128
    put dst i get def i
  end
  ret n
end

fn c3e_d2_raw dst edit uchar 128 to ulong
  ret c3e_env_or t_c3e_env_d2r t_c3_d2_raw_sha dst
end

fn c3e_d2_marks dst edit uchar 128 to ulong
  ret c3e_env_or t_c3e_env_d2m t_c3_d2_marks_sha dst
end

fn c3e_d2_sched dst edit uchar 128 to ulong
  ret c3e_env_or t_c3e_env_d2s t_c3_d2_sched_sha dst
end

fn c3e_params_sha dst edit uchar 128 to ulong
  ret c3e_env_or t_c3e_env_par t_c3_params_sha dst
end

fn c3e_receipt_dir dst edit uchar 1200 to long
  if ne C3_TEST_BUILD 0
    r = er_getenv t_c3e_env_rdir len t_c3e_env_rdir dst 1200
    if ge r 0
      ret r
    end
  end
  if er_eq t_c3_repo_root len t_c3_repo_root t_c3e_unknown len t_c3e_unknown
    ret -1
  end
  rl = len t_c3_repo_root
  sl = len t_c3e_rec_sub
  if gt add add rl 1 sl 1199
    ret -1
  end
  for i ulong rl bound 1024
    put dst i get t_c3_repo_root i
  end
  put dst rl 47
  for i ulong sl bound 128
    put dst add add rl 1 i get t_c3e_rec_sub i
  end
  ret long add add rl 1 sl
end

fn c3e_d1_dir dst edit uchar 1024 to long
  if ne C3_TEST_BUILD 0
    ret er_getenv t_c3e_env_d1 len t_c3e_env_d1 dst 1024
  end
  n = len t_c3_d1_dir_default
  for i ulong n bound 1024
    put dst i get t_c3_d1_dir_default i
  end
  ret long n
end

note ---- Directory & printing helpers ----
fn c3e_dirent_has_rec buf view uchar 4096 nu ulong to long
  pos = ulong 0
  while lt pos nu bound 4096
    if gt add pos 19 nu
      break
    end
    lo = ulong get buf add pos 16
    hi = ulong get buf add pos 17
    reclen = or lo shl hi 8
    if lt reclen 20
      break
    end
    if le add pos 27 nu
      if er_eq part buf add pos 19 8 8 t_c3e_rec_pre 8
        ret 1
      end
    end
    pos = add pos reclen
  end
  ret 0
end

fn c3e_has_receipt dir view uchar * dl ulong to long
  buf = new uchar 4096 0
  fd = fopen dir 0 dl 16384 0
  if lt fd 0
    ret -1
  end
  found = long 0
  while true bound ER_UNB
    n = getdnts int fd buf 0 4096
    if le n 0
      break
    end
    if ne c3e_dirent_has_rec view buf ulong n 0
      found = 1
    end
  end
  ign = fclose int fd
  ret found
end

fn c3e_print_pre to void
  ob_init 1
  ob_t t_c3e_p1
  ob_u get g_c3p_u 0
  ob_t t_c3e_p2
  ob_u C3_MIN_LINES
  ob_t t_c3e_p3
  if ne get g_c3p_ok 0 0
    ob_t t_c3e_ok
  else
    ob_t t_c3e_FAIL
  end
  ob_nl
  ob_t t_c3e_p4
  ob_u get g_c3p_u 2
  ob_t t_c3e_p5
  ob_u get g_c3p_u 1
  ob_t t_c3e_p6
  ob_fix get g_c3p_f 0 4
  ob_t t_c3e_p7
  if ne get g_c3p_ok 1 0
    ob_t t_c3e_ok
  else
    ob_t t_c3e_FAIL
  end
  ob_nl
  ob_t t_c3e_p8
  if ne get g_c3p_u 4 0
    ob_t t_c3e_pres
  else
    ob_t t_c3e_ABS
  end
  ob_t t_c3e_p9
  ob_u get g_c3p_u 6
  ob_t t_c3e_p10
  ob_u get g_c3p_u 5
  ob_t t_c3e_p11
  if ne get g_c3p_ok 2 0
    ob_t t_c3e_ok
  else
    ob_t t_c3e_FAIL
  end
  ob_t t_c3e_p12
  for i ulong get g_c3p_mwhyl 0 bound 256
    ob_c get g_c3p_mwhy i
  end
  ob_t t_c3e_p13
  ob_t t_c3e_p14
  ob_fix get g_c3p_f 1 4
  ob_t t_c3e_p15
  if ne get g_c3p_ok 4 0
    ob_t t_c3e_ok
  else
    ob_t t_c3e_FAIL
  end
  ob_t t_c3e_p16
  ob_u get g_c3p_u 10
  ob_t t_c3e_p5
  ob_u get g_c3p_u 8
  ob_t t_c3e_p6
  ob_fix get g_c3p_f 2 4
  ob_t t_c3e_p17
  if ne get g_c3p_ok 5 0
    ob_t t_c3e_ok
  else
    ob_t t_c3e_FAIL
  end
  ob_t t_c3e_p18
  ob_u get g_c3p_u 9
  ob_c 32
  if ne get g_c3p_ok 3 0
    ob_t t_c3e_ok
  else
    ob_t t_c3e_FAIL
  end
  ob_nl
  ob_t t_c3e_p19
  ob_fix get g_c3p_f 3 3
  ob_t t_c3e_p20
  ob_u get g_c3p_u 3
  ob_nl
  ob_t t_c3e_p21
  for i ulong 64
    ob_c get g_c3p_rawsha i
  end
  ob_t t_c3e_p22
  for i ulong get g_c3p_mkshalen 0 bound 65
    ob_c get g_c3p_mksha i
  end
  ob_t t_c3e_p23
  for i ulong get g_c3p_scshalen 0 bound 65
    ob_c get g_c3p_scsha i
  end
  ob_nl
  if ne get g_c3p_ok 6 0
    ob_t t_c3e_VALID
  else
    ob_t t_c3e_INCON
  end
  ob_t t_c3e_p24
  for i ulong get g_c3p_whyl 0 bound 512
    ob_c get g_c3p_why i
  end
  ob_nl
  ob_flush
end

fn c3e_class_hint_ob s long to void
  if lt s 0
    ob_t t_c3e_none
    ret
  end
  su = ulong s
  if or le su C3_ST_COV95 and ge su C3_ST_PIT0 lt su C3_ST_BIAS
    ob_t t_c3e_ch_noise
    ret
  end
  if eq su C3_ST_BIAS
    ob_t t_c3e_ch_miss
    ret
  end
  if or eq su C3_ST_LAG1 eq su C3_ST_TEN
    ob_t t_c3e_ch_dep
    ret
  end
  if and ge su C3_ST_Q0 lt su C3_ST_REG_TRIAL
    ob_t t_c3e_ch_nonst
    ret
  end
  if or eq su C3_ST_REG_IDLE eq su C3_ST_REG_TRIAL
    ob_t t_c3e_ch_reg
    ret
  end
  ob_t t_c3e_ch_sens
end

fn c3e_load_run dir view uchar * dl ulong raw_sha edit uchar 65 to long
  path = new uchar 1200 0
  pl = c3_path_join dir dl t_c3_fn_ndjson path
  if or eq pl 0 ne er_file_load 0 view path pl 0
    c3_err_from_er
    ret 1
  end
  for i ulong 64
    put raw_sha i get g_ef_sha i
  end
  if ne c3_ticks_build 0 0
    ret 1
  end
  pl = c3_path_join dir dl t_c3_fn_marks path
  if or eq pl 0 ne c3_marks_load 0 view path pl 1 0
    ret 1
  end
  ret 0
end

note ---- Stats slot save / restore ----
fn c3e_save_stats slot ulong to void
  put g_c3e_sn slot get g_c3s_n 0
  put g_c3e_sunsc slot get g_c3s_unsc 0
  put g_c3e_sls slot get g_c3s_logscore 0
  put g_c3e_swm slot get g_c3s_wmean 0
  put g_c3e_swmd slot get g_c3s_wmed 0
  put g_c3e_scal slot get g_c3s_cal 0
  put g_c3e_sff slot get g_c3s_ffail 0
  put g_c3e_sinv slot c3_stats_invalid C3_TEN_ABSENT f64 0.0
  sb = mul slot C3_ST_COUNT
  for i ulong C3_ST_COUNT
    put g_c3e_sval add sb i get g_c3s_val i
    put g_c3e_sblo add sb i get g_c3s_blo i
    put g_c3e_sbhi add sb i get g_c3s_bhi i
    put g_c3e_sgat add sb i get g_c3s_gated i
    put g_c3e_spas add sb i get g_c3s_pass i
    put g_c3e_ssub add sb i get g_c3s_subn i
  end
end

fn c3e_restore_stats slot ulong to void
  put g_c3s_n 0 get g_c3e_sn slot
  put g_c3s_unsc 0 get g_c3e_sunsc slot
  put g_c3s_logscore 0 get g_c3e_sls slot
  put g_c3s_wmean 0 get g_c3e_swm slot
  put g_c3s_wmed 0 get g_c3e_swmd slot
  put g_c3s_cal 0 get g_c3e_scal slot
  put g_c3s_ffail 0 get g_c3e_sff slot
  sb = mul slot C3_ST_COUNT
  for i ulong C3_ST_COUNT
    put g_c3s_val i get g_c3e_sval add sb i
    put g_c3s_blo i get g_c3e_sblo add sb i
    put g_c3s_bhi i get g_c3e_sbhi add sb i
    put g_c3s_gated i get g_c3e_sgat add sb i
    put g_c3s_pass i get g_c3e_spas add sb i
    put g_c3s_subn i get g_c3e_ssub add sb i
  end
end

note ---- Binding guards ----
fn c3e_check_d2_compiled to long
  r = new uchar 128 0
  m = new uchar 128 0
  s = new uchar 128 0
  rl = c3e_d2_raw r
  ml = c3e_d2_marks m
  sl = c3e_d2_sched s
  bad = false
  if er_eq view r rl t_c3e_absent len t_c3e_absent
    bad = true
  end
  if er_eq view m ml t_c3e_absent len t_c3e_absent
    bad = true
  end
  if er_eq view s sl t_c3e_absent len t_c3e_absent
    bad = true
  end
  if bad
    ob_init 2
    ob_t t_c3e_e_nod2
    ob_flush
    ret 2
  end
  ret 0
end

fn c3e_check_outdir_binding outdir view uchar * ol ulong to long
  want = new uchar 1200 0
  rw = new uchar 4096 0
  ro = new uchar 4096 0
  wl = c3e_receipt_dir want
  ok = false
  if gt wl 0
    rwl = er_realpath view want ulong wl rw
    rol = er_realpath outdir ol ro
    if and gt rwl 0 gt rol 0
      if er_eq view rw ulong rwl view ro ulong rol
        ok = true
      end
    end
  end
  if not ok
    ob_init 2
    ob_t t_c3e_e_odir1
    ob_t t_c3e_rec_sub
    ob_t t_c3e_e_odir2
    ob_s outdir ol
    ob_t t_c3e_e_odir3
    ob_flush
    ret 2
  end
  ret 0
end

fn c3e_check_binding_pre ppath view uchar * pl ulong outdir view uchar * ol ulong to long
  doc = new uchar 65 0
  ps = new uchar 128 0
  d = c3e_tool_dirty
  if ne d 0
    ob_init 2
    ob_t t_c3e_e_dir1
    ob_i d
    ob_t t_c3e_e_dir2
    ob_flush
    ret 2
  end
  if ne c3e_check_d2_compiled 0
    ret 2
  end
  doc_ok = eq er_sha_file t_c3_proto_doc len t_c3_proto_doc doc 0
  bad_doc = not doc_ok
  if not bad_doc
    if not er_eq view doc 64 t_c3_protocol_sha len t_c3_protocol_sha
      bad_doc = true
    end
  end
  if bad_doc
    ob_init 2
    ob_t t_c3e_e_pr1
    ob_t t_c3_proto_doc
    ob_t t_c3e_e_pr2
    ob_t t_c3_protocol_sha
    ob_nl
    ob_flush
    ret 2
  end
  psl = c3e_params_sha ps
  if er_eq view ps psl t_c3e_absent len t_c3e_absent
    ob_init 2
    ob_t t_c3e_e_nopar1
    ob_t t_c3e_rec_sub
    ob_t t_c3e_e_nopar2
    ob_flush
    ret 2
  end
  ph_ok = eq er_sha_file ppath pl doc 0
  bad_ph = not ph_ok
  if not bad_ph
    if not er_eq view doc 64 view ps psl
      bad_ph = true
    end
  end
  if bad_ph
    ob_init 2
    ob_t t_c3e_e_psha1
    if ph_ok
      ob_s view doc 64
    else
      ob_t t_c3e_unread
    end
    ob_t t_c3e_e_psha2
    ob_s view ps psl
    ob_nl
    ob_flush
    ret 2
  end
  ret c3e_check_outdir_binding outdir ol
end

fn c3e_check_params_binding to long
  buf = new uchar 1024 0
  if or ne get g_c3pm_synth 0 0 ne get g_c3pm_tdirty 0 0
    ob_init 2
    ob_t t_c3e_e_bind1
    ob_i get g_c3pm_synth 0
    ob_t t_c3e_e_bind2
    ob_i get g_c3pm_tdirty 0
    ob_t t_c3e_e_bind3
    ob_flush
    ret 2
  end
  psl = get g_c3pm_pshal 0
  for i ulong psl bound 65
    put buf i get g_c3pm_psha i
  end
  if not er_eq view buf psl t_c3_protocol_sha len t_c3_protocol_sha
    ob_init 2
    ob_t t_c3e_e_ppro
    ob_flush
    ret 2
  end
  rpl = get g_c3pm_rpathl 0
  for i ulong rpl bound 1024
    put buf i get g_c3pm_rpath i
  end
  if lt er_find view buf rpl t_c3_d1_id len t_c3_d1_id 0
    ob_init 2
    ob_t t_c3e_e_d1p
    ob_flush
    ret 2
  end
  mpl = get g_c3pm_mpathl 0
  for i ulong mpl bound 1024
    put buf i get g_c3pm_mpath i
  end
  if lt er_find view buf mpl t_c3_d1_id len t_c3_d1_id 0
    ob_init 2
    ob_t t_c3e_e_d1p
    ob_flush
    ret 2
  end
  ret 0
end

fn c3e_check_d1_one d1 view uchar 1024 d1l ulong nm view uchar * want_marks ulong to bool
  nmb = new uchar 1024 0
  h = new uchar 65 0
  w = new uchar 65 0
  nl = len nm
  for i ulong nl bound 1024
    put nmb i get nm i
  end
  if ne er_sums_lookup d1 d1l view nmb nl h 0
    ret false
  end
  wl = ulong 0
  if eq want_marks 0
    wl = get g_c3pm_rshal 0
    for i ulong wl bound 65
      put w i get g_c3pm_rsha i
    end
  else
    wl = get g_c3pm_mshal 0
    for i ulong wl bound 65
      put w i get g_c3pm_msha i
    end
  end
  ret er_eq view h 64 view w wl
end

fn c3e_check_d1_sums to long
  d1 = new uchar 1024 0
  d1l = c3e_d1_dir d1
  ok = false
  if gt d1l 0
    if c3e_check_d1_one view d1 ulong d1l t_c3_nm_ndjson 0
      if c3e_check_d1_one view d1 ulong d1l t_c3_nm_marks 1
        ok = true
      end
    end
  end
  if not ok
    ob_init 2
    ob_t t_c3e_e_d1s
    ob_flush
    ret 2
  end
  ret 0
end

fn c3e_check_d2_shas to long
  want = new uchar 128 0
  got = new uchar 65 0
  wl = c3e_d2_raw want
  for i ulong 64
    put got i get g_c3p_rawsha i
  end
  bad = not er_eq view got 64 view want wl
  if not bad
    wl = c3e_d2_marks want
    gl = get g_c3p_mkshalen 0
    for i ulong gl bound 65
      put got i get g_c3p_mksha i
    end
    if not er_eq view got gl view want wl
      bad = true
    end
  end
  if not bad
    wl = c3e_d2_sched want
    gl = get g_c3p_scshalen 0
    for i ulong gl bound 65
      put got i get g_c3p_scsha i
    end
    if not er_eq view got gl view want wl
      bad = true
    end
  end
  if bad
    ob_init 2
    ob_t t_c3e_e_d2m
    ob_flush
    ret 2
  end
  ret 0
end

note ---- Informational block ----
fn c3e_save_info_err idx ulong to void
  eb = mul idx 256
  el = get g_c3_elen 0
  if gt el 255
    el = 255
  end
  for i ulong el bound 256
    put g_c3e_ierr add eb i get g_c3_err i
  end
  put g_c3e_ierrl idx el
end

fn c3e_run_info_one idx ulong dev view uchar * dl ulong aS view EstAssump sel ulong to void
  rsha = new uchar 65 0
  put g_c3e_iok idx 0
  put g_c3e_ierrl idx 0
  sb = mul idx 65
  for i ulong len t_c3e_unavail
    put g_c3e_isha add sb i get t_c3e_unavail i
  end
  put g_c3e_ishal idx len t_c3e_unavail
  if eq idx 1
    put g_er_allow_run_b 0 1
  else
    put g_er_allow_run_b 0 0
  end
  rc = c3e_load_run dev dl rsha
  put g_er_allow_run_b 0 0
  if ne rc 0
    c3e_save_info_err idx
    ret
  end
  for i ulong 64
    put g_c3e_isha add sb i get rsha i
  end
  put g_c3e_ishal idx 64
  if eq c3_score 0 sel aS 1 0
    put g_c3e_iok idx 1
    put g_c3e_in idx get g_c3s_n 0
    put g_c3e_ils idx get g_c3s_logscore 0
    put g_c3e_ical idx get g_c3s_cal 0
    put g_c3e_iff idx get g_c3s_ffail 0
    put g_c3e_ic95 idx get g_c3s_val C3_ST_COV95
  end
end


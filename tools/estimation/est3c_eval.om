  ob_t t_c3e_j10
  ob_json_str view buf dl
  ob_t t_c3e_j11
  for i ulong 64
    ob_c get g_c3p_rawsha i
  end
  ob_t t_c3e_j12
  for i ulong get g_c3p_mkshalen 0 bound 65
    ob_c get g_c3p_mksha i
  end
  ob_t t_c3e_j13

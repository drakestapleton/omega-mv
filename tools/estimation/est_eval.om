global g_ee_nu f64 *
global g_ee_sf f64 78
global g_ee_su ulong 72
global g_ee_sl long 6
global g_ee_arg uchar 7168
global g_ee_alen ulong 7
global g_ee_pm ulong 1
global g_ee_flag ulong 2

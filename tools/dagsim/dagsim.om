dag_init m s
rc = dag_sim m s
if ne rc 0
ret rc
end
dag_bnd m s
note LIFETIME_ORDER_CHECK
rc = dag_life m s
if ne rc 0
ret rc
end
rc = dag_ledg m s
if ne rc 0
ret rc
end
dag_attr m s
dag_nrg m s
put s 4 SOK
ret SOK
end

end
ret cur
end
fn attr_rev s edit ulong 8192 nc ulong to void
i = ulong 0
while lt i nc bound 256
j = sub nc 1
j = sub j i
sx = add 3232 j
src = get s sx
dx = add 6080 i
put s dx src
i = add i 1
end
end
fn attr_left s edit ulong 8192 to void
ms = scf s 3
acc = scf s 12
left = sub ms acc
lim = bitcast f64 FLIVE

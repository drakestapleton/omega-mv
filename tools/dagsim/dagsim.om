bytes = opf m cur 1
if eq kind 4
sfadd s 5829 rt
end
if ne kind 4
if gt bytes 0.0f64
dag_bw m s cur rt
end
if not gt bytes 0.0f64
sfadd s 5824 rt
end
end
acc = add acc rt
sfput s 12 acc
end
fn attr_end m view ulong 8192 s edit ulong 8192 to ulong
nops = get m 0
cur = ulong 0
i = ulong 1
while lt i nops bound 256
ix = add 4768 i
ei = scf s ix
cx = add 4768 cur
ec = scf s cx
if gt ei ec
cur = i
end

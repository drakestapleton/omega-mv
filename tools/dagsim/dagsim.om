best = dag_best m s i
cpv = add best floor
ix = add 2976 i
sfput s ix cpv
if gt cpv bcp
bcp = cpv
end
k = add k 1
end
ret bcp
end
fn dag_bres m view ulong 8192 s edit ulong 8192 bcp f64 to f64
nres = get m 1
bnd = bcp
r = ulong 0
while lt r nres bound 32
w = dag_rwk m r
ix = add 5792 r
sfput s ix w
if gt w bnd
bnd = w
end
r = add r 1
end
ret bnd
end
fn dag_bnd m view ulong 8192 s edit ulong 8192 to void
bcp = dag_cpw m s
sfput s 20 bcp
bnd = dag_bres m s bcp
sfput s 19 bnd
end
fn dag_ws m view ulong 8192 s edit ulong 8192 b ulong to f64
first = bufu m b 2
if eq first NONE
ret 0.0f64

fn dag_rwk m view ulong 8192 r ulong to f64
kind = resu m r 0
w = 0.0f64
if eq kind 2
w = rwk_bw m r
end
if eq kind 1
w = rwk_cpu m r
end
if eq kind 4
w = rwk_lch m r
end
ret w
end
fn dag_cpw m view ulong 8192 s edit ulong 8192 to f64
nops = get m 0
k = ulong 0
bcp = 0.0f64
while lt k nops bound 256
ox = add 2432 k
i = get s ox

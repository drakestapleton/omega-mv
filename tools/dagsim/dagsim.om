fn dag_flr m view ulong 8192 s edit ulong 8192 i ulong to f64
t = opf m i 0
by = opf m i 1
ln = opf m i 2
floor = t
if gt by 0.0f64
cap = opf m i 3
tb = div by cap
if gt tb floor
floor = tb
end
end
floor = add floor ln
ix = add 5280 i
sfput s ix floor
ret floor
end
fn dag_best m view ulong 8192 s edit ulong 8192 i ulong to f64
nd = get m 2
best = 0.0f64
d = ulong 0
while lt d nd bound 1024
dst = dep_to m d
if eq dst i
fr = dep_fr m d
ix = add 2976 fr
cp = scf s ix
if gt cp best
best = cp
end
end
d = add d 1
end
ret best
end
fn rwk_bw m view ulong 8192 r ulong to f64
nops = get m 0
w = 0.0f64
j = ulong 0
while lt j nops bound 256
bw = opu m j 5
if eq bw r
by = opf m j 1
cap = opf m j 3
frac = div by cap
w = add w frac
end
j = add j 1
end
ret w
end
fn rwk_cpu m view ulong 8192 r ulong to f64
nops = get m 0
slots = resu m r 1
w = 0.0f64
j = ulong 0
while lt j nops bound 256
eng = opu m j 4
if eq eng r
t = opf m j 0
ln = opf m j 2
sum = add t ln
frac = div sum f64 slots
w = add w frac
end
j = add j 1
end
ret w
end
fn rwk_lch m view ulong 8192 r ulong to f64
nops = get m 0
w = 0.0f64
j = ulong 0
while lt j nops bound 256
lch = opu m j 6
if eq lch r
ln = opf m j 2
w = add w ln

st = dag_ws m s b
en = dag_we m s b
lim = add en eps
if lt lim st
put s 4 SLIFE
put s 5 RINV
put s 6 b
sfput s 8 st
sfput s 9 en
ret SLIFE
end
b = add b 1
end
ret 0
end
fn dag_evs m view ulong 8192 s edit ulong 8192 c ulong to ulong
nbuf = get m 3
en = ulong 0
b = ulong 0
eps = bitcast f64 FEPS
while lt b nbuf bound 256
cap = bufu m b 1
if eq cap c
st = dag_ws m s b
e = dag_we m s b
lim = add st eps
if lt lim e
by = buff m b 0
ix = add 3488 en
sfput s ix st
vx = add 4000 en
sfput s vx by
en = add en 1
ix = add 3488 en
sfput s ix e
vx = add 4000 en
nb = neg by
sfput s vx nb
en = add en 1
end
end
b = add b 1
end
ret en
end
fn sort_sw etj f64 kt f64 evj f64 kv f64 to ulong
sw = ulong 0
if gt etj kt
sw = ulong 1
end
if eq etj kt
if gt evj 0.0f64
if lt kv 0.0f64
sw = ulong 1
end
end
end
ret sw
end
fn sort_sh s edit ulong 8192 j ulong etj f64 evj f64 to ulong
dx = add 3488 j
sfput s dx etj
ex = add 4000 j
sfput s ex evj
ret sub j 1
end
fn sort_in s edit ulong 8192 j ulong kt f64 kv f64 to ulong
jp = sub j 1
px = add 3488 jp
etj = scf s px
qx = add 4000 jp
evj = scf s qx
sw = sort_sw etj kt evj kv
if eq sw 1
j = sort_sh s j etj evj
end
ret j
end
fn dag_sort s edit ulong 8192 en ulong to void
i = ulong 1
while lt i en bound 512
tx = add 3488 i
kt = scf s tx
vx = add 4000 i
kv = scf s vx
j = i
go = ulong 1
while gt j 0 bound 512
if eq go 0
break
end
nj = sort_in s j kt kv
if eq nj j
go = ulong 0
end
j = nj
end
tx = add 3488 j
sfput s tx kt
vx = add 4000 j
sfput s vx kv
i = add i 1
end
end
fn nmsk1 m view ulong 8192 s edit ulong 8192 b ulong pat f64 to void
st = dag_ws m s b
e = dag_we m s b
hit = ulong 0
if le st pat
if gt e pat
hit = ulong 1
end
end
if eq hit 0
ret
end
w = div b 64
bit = rem b 64
ix = add 6336 w
cur = get s ix
bitv = shl ulong 1 bit
put s ix or cur bitv
end
fn dag_nmsk m view ulong 8192 s edit ulong 8192 c ulong pat f64 to void
put s 6336 ulong 0
put s 6337 ulong 0
put s 6338 ulong 0
put s 6339 ulong 0
nbuf = get m 3
b = ulong 0
while lt b nbuf bound 256
cap = bufu m b 1
if eq cap c
nmsk1 m s b pat
end
b = add b 1
end
end
fn scan_pk m view ulong 8192 s edit ulong 8192 c ulong peak f64 pat f64 to ulong
px = add 6344 c
sfput s px peak
ax = add 6376 c
sfput s ax pat
cap = resf m c 2
eps = bitcast f64 FEPS
pcap = add cap eps
if gt peak pcap
dag_nmsk m s c pat
put s 4 SCAP
put s 5 RPEAK
put s 6 c
sfput s 8 peak
sfput s 9 pat
ret SCAP
end
ret 0
end
fn dag_scan m view ulong 8192 s edit ulong 8192 c ulong en ulong to ulong
live = 0.0f64
peak = 0.0f64
pat = 0.0f64
i = ulong 0
lim = bitcast f64 FLIVE
nlim = neg lim
while lt i en bound 512
vx = add 4000 i
ev = scf s vx
live = add live ev
if lt live nlim
put s 4 SLIFE
put s 5 RLIVE
put s 6 c
sfput s 8 live
tx = add 3488 i
at_t = scf s tx
sfput s 9 at_t
ret SLIFE
end
if gt live peak
peak = live
tx = add 3488 i
pat = scf s tx
end
i = add i 1
end
ret scan_pk m s c peak pat
end
fn dag_ledg m view ulong 8192 s edit ulong 8192 to ulong
nres = get m 1
c = ulong 0
while lt c nres bound 32
kind = resu m c 0
if eq kind 3
en = dag_evs m s c

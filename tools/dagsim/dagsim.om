note dag_fmt ABI: mode, a edit ulong 16, s edit uchar 256; output s is NUL terminated.
note 0 status a0; 1 provenance a0; 2 removal a0; 3 resource a0; 4 attribute a0.
note 5 civil date a0 year a1 month a2 day; 6 scan s with length a0.
note Date return bit32 success, low32 signed day. Scan mirrors three sscanf conversions.
note 7 jnum a0 f64 bits; 8 interval a0 lo a1 hi; 9 bound a0 makespan a1 bound.
note 10 energy a0 measured a1 synthetic; 11 ranking a0 measured.
note 12 next experiment a0 resource kind a1 provenance.
note 13 provenance a0 kind a1 has_t a2 provenance.
note 14 dominance a0 time a1 peak a2 energy a3 other time a4 peak a5 energy a6 all energy.
note 15 width a0 kind a1 cap a2 lo a3 hi a4 provenance; 16 score a0 makespan a1 cf a2 width.
note Float inputs and numeric outputs are IEEE binary64 bits. Other returns are decisions.
note 17 delta a0 minus a1; 18 seconds a0 nanoseconds; 19 max of a0,a1.
note 20 stable descending sort a0 count <=32; s holds 32 little-endian f64 scores, returns byte indices in s.
note 21 streaming date: a0 chunk length, a13 final; a4..12 carry state. Return 0 need more, 1 done (a12 day bits), 2 malformed.
fn df_space c uchar to bool
ret or or eq c 32 eq c 9 or or eq c 13 eq c 10 or eq c 11 eq c 12
end
fn df_over v ulong lim ulong c ulong to bool
q = div lim 10
if gt v q
ret true
end
if eq v q
if gt c rem lim 10
ret true
end
end
ret false
end
fn df_signed v ulong to long
if ge v 2147483648
ret sub long v 4294967296
end
ret long v
end
fn df_u32 v long to ulong
v = rem v 4294967296
if lt v long 0
v = add v 4294967296
end
ret ulong v
end
fn df_day a edit ulong 16 to ulong
y = df_signed get a 0
mo = df_signed get a 1
d = df_signed get a 2
if le mo long 2
y = sub y 1
end
era = y
if lt y long 0
era = sub y 399
end
era = div era 400
yoe = sub y mul era 400
mp = add mo 9
if gt mo long 2
mp = sub mo 3
end
mpu = df_u32 mp
mpu = and add mul mpu 153 2 4294967295
mpu = div mpu 5
mpu = add mpu df_u32 d
mpu = and sub mpu 1 4294967295
doe = mul ulong yoe 365
doe = add doe div ulong yoe 4
doe = sub doe div ulong yoe 100
doe = and add doe mpu 4294967295
ans = add sub mul era 146097 719468 df_signed doe
ret or df_u32 ans 4294967296
end
fn df_digit a edit ulong 16 c uchar to ulong
lim = ulong 9223372036854775807
if ne get a 6 0
lim = ulong 9223372036854775808
end
v = get a 7
d = sub ulong c 48
if df_over v lim d
ret lim
end
ret add mul v 10 d
end
fn df_done a edit ulong 16 to bool
v = get a 7
if ne get a 6 0
v = sub ulong 0 v
end
f = get a 4
put a add 8 f and v 4294967295
if eq f 2
put a 0 get a 8
put a 1 get a 9
put a 2 get a 10
put a 12 df_day a
put a 11 ulong 1
ret true
end
put a 4 add f 1
put a 5 ulong 3
put a 6 ulong 0
put a 7 ulong 0
ret false
end
fn df_stream a edit ulong 16 s edit uchar 256 to ulong
n = get a 0
if gt n 256
ret 2
end
for i ulong n
c = get s i
ph = get a 5
if eq ph 0
if df_space c
continue
end
put a 5 ulong 1
ph = ulong 1
if or eq c 43 eq c 45
if eq c 45
put a 6 ulong 1
end
continue
end
end
if eq ph 1
if or lt c 48 gt c 57
ret 2
end
put a 5 ulong 2
ph = ulong 2
end
if eq ph 2
if and ge c 48 le c 57
put a 7 df_digit a c
continue
end
if df_done a
ret 1
end
ph = ulong 3
end
if eq ph 3
if ne c 45
ret 2
end
put a 5 ulong 0
end
end
if ne get a 13 0
if and eq get a 5 2 eq get a 4 2
if df_done a
ret 1
end
end
ret 2
end
ret 0
end
fn df_date a edit ulong 16 s edit uchar 256 to ulong
for i ulong 10

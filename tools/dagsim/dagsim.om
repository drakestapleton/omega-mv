blk = get s bx
if eq blk 1
sfadd s 5828 gap
end
if eq blk 2
sfadd s 5827 gap
end
if eq blk 0
sfadd s 5830 gap
end
sfadd s 12 gap
end
fn dag_bw m view ulong 8192 s edit ulong 8192 cur ulong rt f64 to void
bytes = opf m cur 1
cap = opf m cur 3
ideal = div bytes cap
cx = add 5536 cur
cont = scf s cx
actual = add ideal cont
t = opf m cur 0
if ge t actual
sfadd s 5824 rt
end
if not ge t actual
sfadd s 5825 ideal
sfadd s 5826 cont
if gt rt actual
left = sub rt actual
sfadd s 5830 left
end
end
end
fn dag_run m view ulong 8192 s edit ulong 8192 cur ulong to void
ex = add 4768 cur
en = scf s ex
rx = add 1856 cur
rs = scf s rx
sx = add 4512 cur
base = scf s sx
if ge rs 0.0f64
base = rs
end
rt = sub en base
ln = opf m cur 2
sfadd s 5827 ln
acc = scf s 12
acc = add acc ln

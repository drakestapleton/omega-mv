if lt left neg lim
addit = ulong 1
end
if eq addit 1
sfadd s 5830 left
end
end
fn dag_attr m view ulong 8192 s edit ulong 8192 to void
nops = get m 0
if eq nops 0
ret
end
cur = attr_end m s
put s 12 ulong 0
nc = ulong 0
while lt nc 256 bound 256
if eq cur NONE
break
end
ix = add 3232 nc
put s ix cur
nc = add nc 1
dag_run m s cur
pred = dag_pred m s cur
dag_gap m s cur pred
cur = pred
end
put s 21 nc
attr_rev s nc
attr_left s
end
fn dag_syn s edit ulong 8192 to void
mask = get s 11
syn = ulong 0
bitv = shl ulong 1 1
got = and mask bitv
if ne got 0
syn = ulong 1
end
put s 26 syn
end
fn nrg_pow s edit ulong 8192 power f64 prov ulong to void
if ne prov 1
ret
end
ms = scf s 3
eps = bitcast f64 FEPS
ej = mul power ms
ej = mul ej eps
put s 23 ulong 1
sfput s 24 ej
mask = get s 11
bitv = shl ulong 1 1
put s 11 or mask bitv
end
fn dag_nrg m view ulong 8192 s edit ulong 8192 to void
has = get m 4
joules = bitcast f64 get m 5
power = bitcast f64 get m 6
prov = get m 7
none = get m 8
took = ulong 0
if ne has 0
if gt joules 0.0f64
if eq none 0
put s 22 ulong 1
sfput s 24 joules
took = ulong 1
end
end
end
if eq took 0
if ne has 0
if gt power 0.0f64
nrg_pow s power prov
end
end
end
dag_syn s
end
fn dag_eval m view ulong 8192 s edit ulong 8192 to ulong
phase = get m 9
if eq phase 0
if eq get m 0 0
put s 4 SUNS
put s 5 REMP
ret SUNS
end
put s 4 SOK
ret SOK
end
if eq dag_topo m s 0
put s 4 SCYC
put s 5 RCYC
ret SCYC
end
rc = dag_cap m s
if ne rc 0
ret rc

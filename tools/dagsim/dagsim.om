note dagsim jstr byte policy. The C stream shell owns string termination and output effects.
fn dj_hex x uint to uchar
if lt x 10
ret uchar add x 48
end
ret uchar add x 87
end
fn dag_jstr c uchar dst edit uchar 6 to ulong
if or eq c 34 eq c 92
put dst 0 92
put dst 1 c
ret 2
end
if lt c 32
put dst 0 92
put dst 1 117
put dst 2 48
put dst 3 48
put dst 4 dj_hex shr uint c 4
put dst 5 dj_hex and uint c 15
ret 6
end
put dst 0 c
ret 1
end

note ========================================================================
note Pure OM-2 math, rx_costmodel, and high-level ds_* runtime for dagsim.om
note ========================================================================

const DS_LN2 f64 0.6931471805599453
const DS_INV_LN2 f64 1.4426950408889634
const DS_PRIOR_A f64 1.0
const DS_PRIOR_B f64 0.01
const DS_NOISE_FLOOR f64 0.0009
const DS_FAIL_PRIOR f64 0.05

note ---- Global state for high-level ds_* API ----
global ds_txt uchar 1048576
global ds_txt_len ulong 1
global ds_txt2 uchar 1048576
global ds_txt2_len ulong 1
global ds_pm ulong 16384
global ds_pm2 ulong 16384
global ds_err uchar 256
global ds_drm ulong 16384
global ds_drt uchar 131072
global ds_em ulong 8192
global ds_sc ulong 8192
global ds_ra ulong 64
global ds_reason uchar 256
global ds_reason_len ulong 1
global ds_out uchar 65536
global ds_out_len ulong 1
global ds_pred_fault ulong 1

note ---- Global state for pure OM-2 rx_costmodel (9 cells * 8 arms = 72 slots) ----
global ds_cm_n_arms ulong 1
global ds_cm_sd_scale ulong 1
global ds_cm_tri ulong 2592
global ds_cm_xty ulong 576
global ds_cm_yty ulong 72
global ds_cm_n ulong 72
global ds_cm_trials ulong 72
global ds_cm_fails ulong 72
global ds_cm_feat ulong 16
global ds_cm_pred ulong 8

note ---- Pure OM-2 f64 math: log2, ln, exp2, norm_inv, t_quantile ----

fn ds_log2 x f64 to f64
if le x 0.0f64
ret f64 0.0f64
end
bits = bitcast ulong x
ebits = shr bits 52
e = sub long ebits 1023
mant_mask = ulong 4503599627370495
one_exp = ulong 4607182418800017408
mbits = or and bits mant_mask one_exp
m = bitcast f64 mbits
y = div sub m 1.0f64 add m 1.0f64
y2 = mul y y
term = y
sum = y
k = ulong 3
while le k 17 bound 16
term = mul term y2
sum = add sum div term f64 k
k = add k 2
end
lnm = mul 2.0f64 sum
ret add f64 e mul lnm DS_INV_LN2
end

fn ds_ln x f64 to f64
ret mul ds_log2 x DS_LN2
end

fn ds_floor x f64 to long
k = long x
if lt x f64 k
k = sub k 1
end
ret k
end

fn ds_exp2 x f64 to f64
if lt x -1020.0f64
ret f64 0.0f64
end
if gt x 1020.0f64
ret f64 1.0e300f64
end
k = ds_floor x
f = sub x f64 k
u = mul f DS_LN2
sum = f64 1.0f64
term = f64 1.0f64
i = ulong 1
while le i 18 bound 20
term = div mul term u f64 i
sum = add sum term
i = add i 1
end
ebits = ulong add k 1023
pow2k = bitcast f64 shl ebits 52
ret mul pow2k sum
end

fn ds_norm_inv_tail q f64 to f64
num = f64 -7.784894002430293e-03f64
num = add mul num q -3.223964580411365e-01f64
num = add mul num q -2.400758277161838e+00f64
num = add mul num q -2.549732539343734e+00f64
num = add mul num q 4.374664141464968e+00f64
num = add mul num q 2.938163982698783e+00f64
den = f64 7.784695709041462e-03f64
den = add mul den q 3.224671290700398e-01f64
den = add mul den q 2.445134137142996e+00f64
den = add mul den q 3.754408661907416e+00f64
den = add mul den q 1.0f64
ret div num den
end

fn ds_norm_inv_mid q f64 to f64
r = mul q q
num = f64 -3.969683028665376e+01f64
num = add mul num r 2.209460984245205e+02f64
num = add mul num r -2.759285104469687e+02f64
num = add mul num r 1.383577518672690e+02f64
num = add mul num r -3.066479806614716e+01f64
num = add mul num r 2.506628277459239e+00f64
den = f64 -5.447609879822406e+01f64
den = add mul den r 1.615858368580409e+02f64
den = add mul den r -1.556989798598866e+02f64
den = add mul den r 6.680131188771972e+01f64
den = add mul den r -1.328068155288572e+01f64
den = add mul den r 1.0f64
ret div mul num q den
end

fn ds_norm_inv p f64 to f64
if lt p 0.02425f64
q = fsqrt mul -2.0f64 ds_ln p
ret ds_norm_inv_tail q
end
if gt p 0.97575f64
q = fsqrt mul -2.0f64 ds_ln sub 1.0f64 p
ret neg ds_norm_inv_tail q
end
ret ds_norm_inv_mid sub p 0.5f64
end

fn ds_t_quantile q f64 dof f64 to f64
z = ds_norm_inv add 0.5f64 mul 0.5f64 q
if not gt dof 0.0f64
ret z
end
z2 = mul z z
z3 = mul z2 z
z5 = mul z3 z2
t1 = div add z3 z mul 4.0f64 dof
t2 = div add add mul 5.0f64 z5 mul 16.0f64 z3 mul 3.0f64 z mul 96.0f64 mul dof dof
ret add add z t1 t2
end

note ---- Pure OM-2 rx_costmodel (Cholesky + Bayesian regression) ----

fn ds_cm_init n_arms ulong to void
na = n_arms
if gt na 8
na = ulong 8
end
put ds_cm_n_arms 0 na
put ds_cm_sd_scale 0 bitcast ulong 1.0f64
lam = bitcast ulong 0.001f64
for s ulong 72
put ds_cm_yty s 0
put ds_cm_n s 0
put ds_cm_trials s 0
put ds_cm_fails s 0
for j ulong 8
put ds_cm_xty add mul s 8 j 0
end
k = ulong 0
base = mul s 36
for i ulong 8
j = i
while lt j 8 bound 8
if eq i j
put ds_cm_tri add base k lam
else
put ds_cm_tri add base k 0
end
k = add k 1
j = add j 1
end
end
end
end

fn ds_cm_cell op ulong core ulong pr ulong to ulong
if ge op 1
ret ulong 4294967295
end
c = core
if ge c 3
c = ulong 2
end
p = pr
if ge p 3
p = ulong 2
end
ret add mul c 3 p
end

fn ds_cm_basis M ulong N ulong sb ulong cb ulong phi edit f64 8 to void
mval = M
if eq mval 0
mval = ulong 1
end
nval = N
if eq nval 0
nval = ulong 1
end
lm = ds_log2 f64 mval
ln = ds_log2 f64 nval
ov = f64 0.0f64
if gt cb 0
if gt sb cb
ov = ds_log2 div f64 sb f64 cb
end
end
put phi 0 1.0f64
put phi 1 lm
put phi 2 ln
put phi 3 mul lm ln
put phi 4 mul ln ln
if le N 3
put phi 5 1.0f64
else
put phi 5 0.0f64
end
if ne rem N 4 0
put phi 6 1.0f64
else
put phi 6 0.0f64
end
put phi 7 ov
end

fn ds_chol_unpack slot ulong A edit f64 64 to void
base = mul slot 36
k = ulong 0
for i ulong 8
j = i
while lt j 8 bound 8
v = bitcast f64 get ds_cm_tri add base k
put A add mul i 8 j v
put A add mul j 8 i v
k = add k 1
j = add j 1
end
end
end

fn ds_chol_diag A view f64 64 L view f64 64 j ulong to f64
s = get A add mul j 8 j
for c ulong j bound 8
lk = get L add mul j 8 c
s = sub s mul lk lk
end
ret s
end

fn ds_chol_off A view f64 64 L view f64 64 i ulong j ulong to f64
t = get A add mul i 8 j
for c ulong j bound 8
lik = get L add mul i 8 c
ljk = get L add mul j 8 c
t = sub t mul lik ljk
end
ret t
end

fn ds_chol_8 slot ulong L edit f64 64 to long
A = new f64 64 0.0f64
ds_chol_unpack slot edit A
for z ulong 64
put L z 0.0f64
end
for j ulong 8
s = ds_chol_diag view A view L j
if not gt s 0.0f64
ret -1
end
ljj = fsqrt s
put L add mul j 8 j ljj
i = add j 1
while lt i 8 bound 8
t = ds_chol_off view A view L i j
put L add mul i 8 j div t ljj
i = add i 1
end
end
ret 0
end

fn ds_fwd_8 L view f64 64 b view f64 8 v edit f64 8 to void
for i ulong 8
s = get b i
for k ulong i bound 8
s = sub s mul get L add mul i 8 k get v k
end
put v i div s get L add mul i 8 i
end
end

fn ds_bwd_8 L view f64 64 v view f64 8 x edit f64 8 to void
r = ulong 0
while lt r 8 bound 8
i = sub 7 r
s = get v i
k = add i 1
while lt k 8 bound 8
s = sub s mul get L add mul k 8 i get x k
k = add k 1
end
put x i div s get L add mul i 8 i
r = add r 1
end
end

fn ds_dot_8 a view f64 8 b view f64 8 to f64
s = f64 0.0f64
for i ulong 8
s = add s mul get a i get b i
end
ret s
end

fn ds_norm2_8 a view f64 8 to f64
s = f64 0.0f64
for i ulong 8
x = get a i
s = add s mul x x
end
ret s
end

fn ds_post_sd n ulong yty_bits ulong quad f64 lev f64 out3 edit f64 3 to void
yty = bitcast f64 yty_bits
a = add DS_PRIOR_A mul 0.5f64 f64 n
b = add DS_PRIOR_B mul 0.5f64 sub yty quad
if lt b DS_PRIOR_B
b = DS_PRIOR_B
end
s2 = div b a
if lt s2 DS_NOISE_FLOOR
s2 = DS_NOISE_FLOOR
end
put out3 1 fsqrt mul s2 add 1.0f64 lev
put out3 2 mul 2.0f64 a
end

fn ds_cm_fit slot ulong phi view f64 8 out3 edit f64 3 to ulong
n = get ds_cm_n slot
if eq n 0
ret 0
end
L = new f64 64 0.0f64
if ne ds_chol_8 slot edit L 0
ret 0
end
xty = new f64 8 0.0f64
xbase = mul slot 8
for i ulong 8
put xty i bitcast f64 get ds_cm_xty add xbase i
end
v = new f64 8 0.0f64
mu = new f64 8 0.0f64
w = new f64 8 0.0f64
ds_fwd_8 view L view xty edit v
ds_bwd_8 view L view v edit mu
ds_fwd_8 view L phi edit w
put out3 0 ds_dot_8 view mu phi
ds_post_sd n get ds_cm_yty slot ds_norm2_8 view v ds_norm2_8 view w out3
ret 1
end

fn ds_cm_rank1 slot ulong phi view f64 8 y f64 to void
tbase = mul slot 36
xbase = mul slot 8
k = ulong 0
for i ulong 8
pi = get phi i
j = i
while lt j 8 bound 8
pj = get phi j
cur = bitcast f64 get ds_cm_tri add tbase k
put ds_cm_tri add tbase k bitcast ulong add cur mul pi pj
k = add k 1
j = add j 1
end
cx = bitcast f64 get ds_cm_xty add xbase i
put ds_cm_xty add xbase i bitcast ulong add cx mul pi y
end
cy = bitcast f64 get ds_cm_yty slot
put ds_cm_yty slot bitcast ulong add cy mul y y
put ds_cm_n slot add get ds_cm_n slot 1
end

fn ds_cm_observe_feat arm ulong ps ulong failed ulong to long
if ge arm get ds_cm_n_arms 0
ret -1
end
cell = ds_cm_cell get ds_cm_feat 0 get ds_cm_feat 5 get ds_cm_feat 6
if ge cell 9
ret -4
end
slot = add mul cell 8 arm
put ds_cm_trials slot add get ds_cm_trials slot 1
if ne failed 0
put ds_cm_fails slot add get ds_cm_fails slot 1
ret 0
end
if eq ps 0
ret -1
end
phi = new f64 8 0.0f64
ds_cm_basis get ds_cm_feat 1 get ds_cm_feat 2 get ds_cm_feat 3 get ds_cm_feat 4 edit phi
y = ds_log2 f64 ps
ds_cm_rank1 slot view phi y
ret 0
end

fn ds_cm_predict_feat arm ulong to long
for i ulong 8
put ds_cm_pred i 0
end
flt = get ds_pred_fault 0
if ne flt 0
put ds_cm_pred 0 bitcast ulong 20.0f64
put ds_cm_pred 1 bitcast ulong 0.0f64
put ds_cm_pred 2 bitcast ulong 1.0f64
put ds_cm_pred 3 32
put ds_cm_pred 4 1
if eq flt 1
put ds_cm_pred 5 0
put ds_cm_pred 6 dr_u -4
ret -4
end
put ds_cm_pred 5 1
put ds_cm_pred 6 0
ret 0
end
if ge arm get ds_cm_n_arms 0
put ds_cm_pred 6 dr_u -1
ret -1
end
cell = ds_cm_cell get ds_cm_feat 0 get ds_cm_feat 5 get ds_cm_feat 6
if ge cell 9
put ds_cm_pred 5 1
put ds_cm_pred 6 dr_u -4
ret -4
end
slot = add mul cell 8 arm
n = get ds_cm_n slot
if lt n 12
ret 0
end
phi = new f64 8 0.0f64
ds_cm_basis get ds_cm_feat 1 get ds_cm_feat 2 get ds_cm_feat 3 get ds_cm_feat 4 edit phi
res3 = new f64 3 0.0f64
ok = ds_cm_fit slot view phi edit res3
if eq ok 0
ret 0
end
scale = bitcast f64 get ds_cm_sd_scale 0
if lt scale 1.0f64
scale = f64 1.0f64
end
put ds_cm_pred 0 bitcast ulong get res3 0
put ds_cm_pred 1 bitcast ulong mul get res3 1 scale
put ds_cm_pred 2 bitcast ulong get res3 2
put ds_cm_pred 3 n
put ds_cm_pred 4 1
put ds_cm_pred 5 0
put ds_cm_pred 6 0
ret 0
end

note ---- Output buffer and string helpers ----

fn ds_out_reset to void
put ds_out_len 0 0
end

fn ds_out_ch c uchar to void
n = get ds_out_len 0
if lt n 65536
put ds_out n c
put ds_out_len 0 add n 1
end
end

fn ds_out_flush fd int to void
n = get ds_out_len 0
off = ulong 0
while lt off n bound 65536
w = write fd ds_out off sub n off
if le w 0
break
end
off = add off ulong w
end
put ds_out_len 0 0
end

fn ds_out_text s view uchar * to void
n = len s
for i ulong n bound 65536
ds_out_ch get s i
end
end

fn ds_out_slice_txt side ulong off ulong slen ulong to void
for i ulong slen bound 1024
if eq side 0
ds_out_ch get ds_txt add off i
else
ds_out_ch get ds_txt2 add off i
end
end
end

fn ds_out_cstr_drt off ulong cap ulong to void
for i ulong cap bound 256
c = get ds_drt add off i
if eq c 0
break
end
ds_out_ch c
end
end

fn ds_out_u64 v ulong to void
buf = new uchar 24 0
n = ulong 0
x = v
while true bound 24
put buf n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
break
end
end
while gt n 0 bound 24
n = sub n 1
ds_out_ch get buf n
end
end

fn ds_out_i64 v long to void
if lt v 0
ds_out_ch uchar 45
ds_out_u64 ulong neg v
ret
end
ds_out_u64 ulong v
end

fn ds_out_jstr_slice_txt side ulong off ulong slen ulong to void
esc = new uchar 6 0
ds_out_ch uchar 34
for i ulong slen bound 1024
c = uchar 0
if eq side 0
c = get ds_txt add off i
else
c = get ds_txt2 add off i
end
k = dag_jstr c edit esc
for j ulong k bound 6
ds_out_ch get esc j
end
end
ds_out_ch uchar 34
end

fn ds_out_jstr_reason to void
esc = new uchar 6 0
ds_out_ch uchar 34
n = get ds_reason_len 0
for i ulong n bound 256
c = get ds_reason i
k = dag_jstr c edit esc
for j ulong k bound 6
ds_out_ch get esc j
end
end
ds_out_ch uchar 34
end

fn ds_out_jstr_err to void
esc = new uchar 6 0
ds_out_ch uchar 34
for i ulong 256
c = get ds_err i
if eq c 0
break
end
k = dag_jstr c edit esc
for j ulong k bound 6
ds_out_ch get esc j
end
end
ds_out_ch uchar 34
end

fn ds_out_jstr_text s view uchar * to void
esc = new uchar 6 0
ds_out_ch uchar 34
n = len s
for i ulong n bound 1024
k = dag_jstr get s i edit esc
for j ulong k bound 6
ds_out_ch get esc j
end
end
ds_out_ch uchar 34
end

fn ds_out_jstr_buf b view uchar * n ulong to void
esc = new uchar 6 0
ds_out_ch uchar 34
for i ulong n bound 4096
k = dag_jstr get b i edit esc
for j ulong k bound 6
ds_out_ch get esc j
end
end
ds_out_ch uchar 34
end

fn ds_out_frac fracp ulong dec ulong to void
buf = new uchar 12 0
ds_out_ch uchar 46
t = fracp
for i ulong dec bound 12
idx = sub sub dec 1 i
put buf idx uchar add 48 rem t 10
t = div t 10
end
for i ulong dec bound 12
ds_out_ch get buf i
end
end

fn ds_out_fixed v f64 dec ulong to void
x = v
if lt x 0.0f64
ds_out_ch uchar 45
x = neg x
end
scale = f64 1.0f64
for i ulong dec bound 12
scale = mul scale 10.0f64
end
scu = ulong scale
scaled = ulong add mul x scale 0.5f64
ds_out_u64 div scaled scu
if gt dec 0
ds_out_frac rem scaled scu dec
end
end

fn ds_out_jnum_dig dig view uchar 6 last ulong exp10 long to void
if and ge exp10 -4 lt exp10 6
if lt exp10 0
ds_out_ch uchar 48
ds_out_ch uchar 46
z = sub long -1 exp10
for i ulong ulong z bound 8
ds_out_ch uchar 48
end
for i ulong add last 1 bound 6
ds_out_ch get dig i
end
else
ip = ulong exp10
for i ulong add ip 1 bound 6
if le i last
ds_out_ch get dig i
else
ds_out_ch uchar 48
end
end
if gt last ip
ds_out_ch uchar 46
k = add ip 1
while le k last bound 6
ds_out_ch get dig k
k = add k 1
end
end
end
else
ds_out_ch get dig 0
if gt last 0
ds_out_ch uchar 46
k = ulong 1
while le k last bound 6
ds_out_ch get dig k
k = add k 1
end
end
ds_out_ch uchar 101
if lt exp10 0
ds_out_ch uchar 45
eabs = ulong neg exp10
if lt eabs 10
ds_out_ch uchar 48
end
ds_out_u64 eabs
else
ds_out_ch uchar 43
eabs = ulong exp10
if lt eabs 10
ds_out_ch uchar 48
end
ds_out_u64 eabs
end
end
end

fn ds_out_jnum_g x f64 to void
exp10 = long 0
m = x
while ge m 10.0f64 bound 400
m = div m 10.0f64
exp10 = add exp10 1
end
while lt m 1.0f64 bound 400
m = mul m 10.0f64
exp10 = sub exp10 1
end
sig = ulong add mul m 100000.0f64 0.5f64
if ge sig 1000000
sig = div sig 10
exp10 = add exp10 1
end
dig = new uchar 6 0
t = sig
for i ulong 6
put dig sub 5 i uchar add 48 rem t 10
t = div t 10
end
last = ulong 5
while gt last 0 bound 6
if ne get dig last 48
break
end
last = sub last 1
end
ds_out_jnum_dig view dig last exp10
end

fn ds_out_jnum v f64 to void
x = v
if eq x 0.0f64
ds_out_ch uchar 48
ret
end
if lt x 0.0f64
ds_out_ch uchar 45
x = neg x
end
fa = new ulong 16 0
sn = new uchar 256 0
put fa 0 bitcast ulong x
is_nonint = dag_fmt 7 edit fa edit sn
if eq is_nonint 0
ds_out_u64 ulong add x 0.5f64
ret
end
ds_out_jnum_g x
end

note ---- Reason buffer helpers ----

fn ds_rsn_reset to void
put ds_reason_len 0 0
put ds_reason 0 0
end

fn ds_rsn_ch c uchar to void
n = get ds_reason_len 0
if lt n 255
put ds_reason n c
put ds_reason add n 1 0
put ds_reason_len 0 add n 1
end
end

fn ds_rsn_text s view uchar * to void
n = len s
for i ulong n bound 256
ds_rsn_ch get s i
end
end

fn ds_rsn_drt off ulong cap ulong to void
for i ulong cap bound 256
c = get ds_drt add off i
if eq c 0
break
end
ds_rsn_ch c
end
end

fn ds_rsn_pm_span off ulong slen ulong to void
for i ulong slen bound 256
ds_rsn_ch get ds_txt add off i
end
end

fn ds_rsn_u64 v ulong to void
buf = new uchar 24 0
n = ulong 0
x = v
while true bound 24
put buf n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
break
end
end
while gt n 0 bound 24
n = sub n 1
ds_rsn_ch get buf n
end
end

fn ds_rsn_jnum v f64 to void
saved = get ds_out_len 0
ds_out_jnum v
endp = get ds_out_len 0
i = saved
while lt i endp bound 64
ds_rsn_ch get ds_out i
i = add i 1
end
put ds_out_len 0 saved
end

text rsn_res_unk1 "resource "
text rsn_res_unk2 " has prov=unknown; unknown stays unknown"
text rsn_op_unk1 "op "
text rsn_op_unk2 " has prov=unknown ("
text rsn_op_unk3 "); unknown stays unknown"
text rsn_nosrc "no source"
text rsn_mv_nomod " is a matvec with no rx_costmodel blob supplied"
text rsn_mv_nocell ": rx_costmodel has no known cell for this (op, core, pressure) and arm"
text rsn_no_eng " has no engine"
text rsn_lch_noeng ": launch without an engine"
text rsn_no_cal "measured or fitted values need a calibration record"
text rsn_stale1 "calibration is stale: asof is "
text rsn_stale2 " day(s) past the validity envelope"
text rsn_empty "empty DAG"
text rsn_cyc "dependency cycle"
text rsn_aln1 "buffer "
text rsn_aln2 " alone exceeds capacity "
text rsn_prog "no op can make progress"
text rsn_grd "scheduler did not converge"
text rsn_inv1 "inverted lifetime for buffer "
text rsn_inv2 ": first="
text rsn_inv3 " start_ns="
text rsn_inv4 " last="
text rsn_inv5 " end_ns="
text rsn_omit "omitted"
text rsn_live1 "capacity "
text rsn_live2 " live bytes went negative ("
text rsn_live3 " at t="
text rsn_live4 "); refusing the certificate"
text rsn_peak1 " B live at t="
text rsn_peak2 " ns ("
text rsn_peak3 ") exceeds "

fn ds_fmt_res_reason to void
ds_rsn_reset
why = get ds_ra 0
idx = get ds_ra 1
if eq why 1
ds_rsn_text rsn_res_unk1
ds_rsn_drt add 10240 mul idx 40 40
ds_rsn_text rsn_res_unk2
ret
end
if eq why 2
ds_rsn_text rsn_op_unk1
ds_rsn_drt mul idx 40 40
ds_rsn_text rsn_mv_nomod
ret
end
if eq why 3
ds_rsn_text rsn_op_unk1
ds_rsn_drt mul idx 40 40
ds_rsn_text rsn_mv_nocell
ret
end
if eq why 4
ds_rsn_text rsn_op_unk1
ds_rsn_drt mul idx 40 40
ds_rsn_text rsn_op_unk2
sp = add 448 mul idx 26
sl = get ds_pm add sp 18
if gt sl 0
ds_rsn_pm_span get ds_pm add sp 17 sl
else
ds_rsn_text rsn_nosrc
end
ds_rsn_text rsn_op_unk3
ret
end
if eq why 5
ds_rsn_text rsn_op_unk1
ds_rsn_drt mul idx 40 40
ds_rsn_text rsn_no_eng
ret
end
if eq why 6
ds_rsn_text rsn_op_unk1
ds_rsn_drt mul idx 40 40
ds_rsn_text rsn_lch_noeng
ret
end
if eq why 7
ds_rsn_text rsn_no_cal
ret
end
if eq why 8
ds_rsn_text rsn_stale1
ds_rsn_u64 get ds_ra 34
ds_rsn_text rsn_stale2
ret
end
if eq why 10
ds_rsn_text rsn_empty
ret
end
end

fn ds_fmt_peak_names to void
nbuf = get ds_pm 13
first = ulong 1
for bi ulong nbuf bound 256
w = div bi 64
bit = rem bi 64
msk = get ds_sc add 6336 w
if ne and msk shl ulong 1 bit 0
if eq first 0
ds_rsn_ch uchar 44
end
first = ulong 0
bp = add 9152 mul bi 8
ds_rsn_pm_span get ds_pm bp get ds_pm add bp 1
end
end
end

fn ds_fmt_eval_reason to void
ds_rsn_reset
why = get ds_sc 5
a = get ds_sc 6
b = get ds_sc 7
if eq why 1
ds_rsn_text rsn_empty
ret
end
if eq why 2
ds_rsn_text rsn_cyc
ret
end
if eq why 3
ds_rsn_text rsn_aln1
bp = add 9152 mul a 8
ds_rsn_pm_span get ds_pm bp get ds_pm add bp 1
ds_rsn_text rsn_aln2
ds_rsn_drt add 10240 mul b 40 40
ret
end
if eq why 4
ds_rsn_text rsn_prog
ret
end
if eq why 5
ds_rsn_text rsn_grd
ret
end
if eq why 6
ds_rsn_text rsn_inv1
bp = add 9152 mul a 8
ds_rsn_pm_span get ds_pm bp get ds_pm add bp 1
ds_rsn_text rsn_inv2
fop = get ds_pm add bp 4
if eq fop 4294967295
ds_rsn_text rsn_omit
else
ds_rsn_drt mul fop 40 40
end
ds_rsn_text rsn_inv3
ds_rsn_jnum bitcast f64 get ds_sc 8
ds_rsn_text rsn_inv4
lop = get ds_pm add bp 5
if eq lop 4294967295
ds_rsn_text rsn_omit
else
ds_rsn_drt mul lop 40 40
end
ds_rsn_text rsn_inv5
ds_rsn_jnum bitcast f64 get ds_sc 9
ret
end
if eq why 7
ds_rsn_text rsn_live1
ds_rsn_drt add 10240 mul a 40 40
ds_rsn_text rsn_live2
ds_rsn_jnum bitcast f64 get ds_sc 8
ds_rsn_text rsn_live3
ds_rsn_jnum bitcast f64 get ds_sc 9
ds_rsn_text rsn_live4
ret
end
if eq why 8
ds_rsn_jnum bitcast f64 get ds_sc 8
ds_rsn_text rsn_peak1
ds_rsn_jnum bitcast f64 get ds_sc 9
ds_rsn_text rsn_peak2
ds_fmt_peak_names
ds_rsn_text rsn_peak3
ds_rsn_drt add 10240 mul a 40 40
ret
end
end

note ---- High-level parse / pack / eval / interval / counterfactual / diff ----

fn ds_parse_side side ulong to ulong
t = new uchar 1048576 0
pm = new ulong 16384 0
err = new uchar 256 0
n = ulong 0
if eq side 0
n = get ds_txt_len 0
for i ulong n bound 1048576
put t i get ds_txt i
end
else
n = get ds_txt2_len 0
for i ulong n bound 1048576
put t i get ds_txt2 i
end
end
rc = dag_parse view t n edit pm edit err
for i ulong 256
put ds_err i get err i
end
if eq side 0
for i ulong 16384
put ds_pm i get pm i
end
else
for i ulong 16384
put ds_pm2 i get pm i
end
end
if ne rc 0
ret 9
end
ret 0
end

fn ds_read_fd_side fd int side ulong to long
tmp = new uchar 65536 0
total = ulong 0
while true bound 256
got = read fd tmp 0 65536
if lt got 0
ret -1
end
if eq got 0
break
end
if gt add total ulong got 1048575
ret -1
end
for i ulong ulong got bound 65536
if eq side 0
put ds_txt add total i get tmp i
else
put ds_txt2 add total i get tmp i
end
end
total = add total ulong got
end
ret long total
end

fn ds_read_file_side side ulong path view uchar * plen ulong to ulong
pbuf = new uchar 4096 0
if ge plen 4096
ret 9
end
for i ulong plen bound 4096
put pbuf i get path i
end
fd = fopen pbuf 0 plen 0 0
if lt fd 0
ret 9
end
total = ds_read_fd_side int fd side
fc = fclose int fd
if lt total 0
ret 9
end
if eq side 0
put ds_txt_len 0 ulong total
else
put ds_txt2_len 0 ulong total
end
ret ds_parse_side side
end

fn ds_copy_span_to_drt side ulong src_off ulong src_len ulong dst_off ulong maxc ulong to void
lim = src_len
if ge lim maxc
lim = sub maxc 1
end
for i ulong lim bound 256
if eq side 0
put ds_drt add dst_off i get ds_txt add src_off i
else
put ds_drt add dst_off i get ds_txt2 add src_off i
end
end
put ds_drt add dst_off lim 0
end

fn ds_pm_get side ulong idx ulong to ulong
if eq side 0
ret get ds_pm idx
end
ret get ds_pm2 idx
end

fn ds_pack_res_ops side ulong moff ulong toff ulong to void
n_res = ds_pm_get side 11
for i ulong n_res bound 32
sp = add 64 mul i 12
dp = add moff add 32 mul i 8
put ds_drm dp ds_pm_get side add sp 2
put ds_drm add dp 1 ds_pm_get side add sp 3
put ds_drm add dp 2 ds_pm_get side add sp 4
put ds_drm add dp 3 ds_pm_get side add sp 5
put ds_drm add dp 4 ds_pm_get side add sp 6
put ds_drm add dp 5 ds_pm_get side add sp 7
ds_copy_span_to_drt side ds_pm_get side sp ds_pm_get side add sp 1 add toff add 10240 mul i 40 40
end
n_ops = ds_pm_get side 12
for i ulong n_ops bound 256
sp = add 448 mul i 26
dp = add moff add 288 mul i 16
put ds_drm dp ds_pm_get side add sp 2
put ds_drm add dp 1 ds_pm_get side add sp 3
put ds_drm add dp 2 ds_pm_get side add sp 4
put ds_drm add dp 3 ds_pm_get side add sp 5
put ds_drm add dp 4 ds_pm_get side add sp 6
put ds_drm add dp 5 ds_pm_get side add sp 7
put ds_drm add dp 6 ds_pm_get side add sp 8
put ds_drm add dp 7 ds_pm_get side add sp 9
put ds_drm add dp 8 ds_pm_get side add sp 10
put ds_drm add dp 9 ds_pm_get side add sp 11
put ds_drm add dp 10 ds_pm_get side add sp 12
put ds_drm add dp 11 ds_pm_get side add sp 13
put ds_drm add dp 12 ds_pm_get side add sp 14
put ds_drm add dp 13 ds_pm_get side add sp 15
put ds_drm add dp 14 ds_pm_get side add sp 16
ds_copy_span_to_drt side ds_pm_get side sp ds_pm_get side add sp 1 add toff mul i 40 40
end
end

fn ds_pack_deps_rem side ulong moff ulong toff ulong to void
n_deps = ds_pm_get side 14
for i ulong n_deps bound 1024
sp = add 7104 mul i 2
dp = add moff add 4384 mul i 2
put ds_drm dp ds_pm_get side sp
put ds_drm add dp 1 ds_pm_get side add sp 1
end
n_rem = ds_pm_get side 15
for i ulong n_rem bound 256
sp = add 11200 mul i 8
dp = add moff add 6432 mul i 4
put ds_drm dp ds_pm_get side add sp 2
rb = add toff add 11520 mul i 208
ds_copy_span_to_drt side ds_pm_get side sp ds_pm_get side add sp 1 rb 40
ds_copy_span_to_drt side ds_pm_get side add sp 3 ds_pm_get side add sp 4 add rb 40 40
ds_copy_span_to_drt side ds_pm_get side add sp 5 ds_pm_get side add sp 6 add rb 80 128
end
end

fn ds_pack_side side ulong to void
moff = mul side 8192
toff = mul side 65536
for i ulong 8192
put ds_drm add moff i 0
end
put ds_drm add moff 0 ds_pm_get side 12
put ds_drm add moff 1 ds_pm_get side 11
put ds_drm add moff 2 ds_pm_get side 14
put ds_drm add moff 3 ds_pm_get side 15
put ds_drm add moff 4 ds_pm_get side 3
put ds_drm add moff 5 ds_pm_get side 4
put ds_drm add moff 6 ds_pm_get side 5
put ds_drm add moff 7 ds_pm_get side 7
put ds_drm add moff 8 ds_pm_get side 8
put ds_drm add moff 9 ds_pm_get side 9
put ds_drm add moff 10 ds_pm_get side 10
put ds_drm add moff 12 ds_pm_get side 13
ioff = ds_pm_get side 33
ilen = ds_pm_get side 34
for k ulong 5
if lt k ilen
if eq side 0
put ds_drm add moff add 13 k ulong get ds_txt add ioff k
else
put ds_drm add moff add 13 k ulong get ds_txt2 add ioff k
end
else
put ds_drm add moff add 13 k 0
end
end
ds_pack_res_ops side moff toff
ds_pack_deps_rem side moff toff
end

fn ds_run_res mode ulong to ulong
m = new ulong 16384 0
s = new ulong 8192 0
t = new uchar 131072 0
a = new ulong 64 0
for i ulong 16384
put m i get ds_drm i
end
for i ulong 8192
put s i get ds_em i
end
for i ulong 131072
put t i get ds_drt i
end
for i ulong 64
put a i get ds_ra i
end
rc = dag_res mode edit m edit s edit t edit a
for i ulong 16384
put ds_drm i get m i
end
for i ulong 8192
put ds_em i get s i
end
for i ulong 64
put ds_ra i get a i
end
ret rc
end

fn ds_run_eval to ulong
m = new ulong 8192 0
s = new ulong 8192 0
for i ulong 8192
put m i get ds_em i
end
st = dag_eval view m edit s
for i ulong 8192
put ds_sc i get s i
end
ret st
end

fn ds_run_diff to ulong
m = new ulong 16384 0
t = new uchar 131072 0
a = new ulong 64 0
for i ulong 16384
put m i get ds_drm i
end
for i ulong 131072
put t i get ds_drt i
end
for i ulong 64
put a i get ds_ra i
end
rc = dag_diff view m view t edit a
for i ulong 64
put ds_ra i get a i
end
ret rc
end

fn ds_finalize_em to void
n_ops = get ds_pm 12
n_deps = get ds_pm 14
n_buf = get ds_pm 13
for i ulong n_ops bound 256
dp = add 32 mul i 10
if eq get ds_em add dp 4 4294967295
put ds_em add dp 4 NONE
end
if eq get ds_em add dp 5 4294967295
put ds_em add dp 5 NONE
end
if eq get ds_em add dp 6 4294967295
put ds_em add dp 6 NONE
end
end
for i ulong n_deps bound 1024
sp = add 7104 mul i 2
dp = add 2720 mul i 2
put ds_em dp get ds_pm sp
put ds_em add dp 1 get ds_pm add sp 1
end
for i ulong n_buf bound 256
sp = add 9152 mul i 8
dp = add 4768 mul i 4
put ds_em dp get ds_pm add sp 2
capr = get ds_pm add sp 3
if eq capr 4294967295
capr = NONE
end
put ds_em add dp 1 capr
fop = get ds_pm add sp 4
if eq fop 4294967295
fop = NONE
end
put ds_em add dp 2 fop
lop = get ds_pm add sp 5
if eq lop 4294967295
lop = NONE
end
put ds_em add dp 3 lop
end
end

fn ds_eval_packed mode long asof_day long has_model ulong q_bits ulong to ulong
for i ulong 8192
put ds_em i 0
put ds_sc i 0
end
for i ulong 64
put ds_ra i 0
end
ds_rsn_reset
put ds_ra 5 dr_u mode
put ds_ra 6 dr_u asof_day
put ds_ra 7 has_model
put ds_ra 9 q_bits
now_ns = realns
if gt now_ns 0
put ds_ra 35 div ulong now_ns 1000000000
end
done = ulong 0
while eq done 0 bound 2048
rc = ds_run_res 0
if eq rc 0
done = ulong 1
break
end
if eq rc 4
ds_fmt_res_reason
put ds_sc 4 get ds_ra 2
ret get ds_ra 2
end
if eq rc 1
put ds_cm_feat 0 0
put ds_cm_feat 1 get ds_ra 16
put ds_cm_feat 2 get ds_ra 17
put ds_cm_feat 3 get ds_ra 18
put ds_cm_feat 4 get ds_ra 19
put ds_cm_feat 5 get ds_ra 20
put ds_cm_feat 6 0
st = ds_cm_predict_feat get ds_ra 22
put ds_ra 24 dr_u st
put ds_ra 25 get ds_cm_pred 5
put ds_ra 26 get ds_cm_pred 4
put ds_ra 27 get ds_cm_pred 3
put ds_ra 28 get ds_cm_pred 0
put ds_ra 29 get ds_cm_pred 1
put ds_ra 30 get ds_cm_pred 2
continue
end
if eq rc 2
kv = ds_t_quantile bitcast f64 get ds_ra 9 bitcast f64 get ds_ra 30
put ds_ra 31 bitcast ulong kv
continue
end
if eq rc 3
ev = ds_exp2 bitcast f64 get ds_ra 32
put ds_ra 33 bitcast ulong ev
continue
end
ret 6
end
ds_finalize_em
st = ds_run_eval
if ne st 0
ds_fmt_eval_reason
put ds_sc 3 0
for ci ulong 32
put ds_sc add 6344 ci 0
put ds_sc add 6376 ci 0
end
put ds_sc 4 st
ret st
end
ret 0
end

fn ds_eval_current mode long asof_day long has_model ulong q_bits ulong to ulong
ds_pack_side 0
ret ds_eval_packed mode asof_day has_model q_bits
end

fn ds_counterfactual_idx res_idx long asof_day long has_model ulong q_bits ulong to f64
ds_pack_side 0
for i ulong 64
put ds_ra i 0
end
put ds_ra 1 dr_u res_idx
rc = ds_run_res 1
if ne rc 0
ret neg f64 rc
end
st = ds_eval_packed 0 asof_day has_model q_bits
if ne st 0
ret neg f64 st
end
ret bitcast f64 get ds_sc 3
end

fn ds_day_from_slice buf view uchar * n ulong to long
fa = new ulong 16 0
sn = new uchar 256 0
lim = n
if gt lim 255
lim = ulong 255
end
for i ulong lim bound 256
put sn i get buf i
end
put fa 0 lim
res = dag_fmt 6 edit fa edit sn
if eq and res 4294967296 0
ret -1
end
ret dr_i and res 4294967295
end

fn ds_find_res_name s view uchar * to long
n = len s
for i ulong n bound 40
put ds_drt add 130816 i get s i
end
put ds_drt add 130816 n 0
for i ulong 64
put ds_ra i 0
end
put ds_ra 0 0
put ds_ra 1 1
ret dr_i ds_run_res 2
end

fn ds_find_op_name s view uchar * to long
n = len s
for i ulong n bound 40
put ds_drt add 130816 i get s i
end
put ds_drt add 130816 n 0
for i ulong 64
put ds_ra i 0
end
put ds_ra 0 0
put ds_ra 1 0
ret dr_i ds_run_res 2
end

fn ds_mark_changed ch view uchar * chlen ulong to void
for i ulong 64
put ds_ra i 0
end
lim = chlen
if gt lim 255
lim = ulong 255
end
for i ulong lim bound 256
put ds_drt add 130816 i get ch i
end
put ds_ra 41 lim
put ds_ra 42 1
rc = ds_run_res 3
end

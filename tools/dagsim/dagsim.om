if ne rc 0
ret rc
end
end
c = add c 1
end
ret 0
end
fn dag_pred m view ulong 8192 s edit ulong 8192 cur ulong to ulong
nd = get m 2
pred = NONE
d = ulong 0
while lt d nd bound 1024
dst = dep_to m d
if eq dst cur
fr = dep_fr m d
if eq pred NONE
pred = fr

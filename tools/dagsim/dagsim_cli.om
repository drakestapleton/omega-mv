note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note tools/dagsim/dagsim_cli.om -- Pure seeded OM-2 CLI for the offline resource-DAG evaluator (omega-mv#583).
note Composed after tools/dagsim/dagsim.om:
note   cat tools/dagsim/dagsim.om tools/dagsim/dagsim_cli.om | seed/out/omc > dagsim

global cli_arg uchar 4096
global cli_cmd uchar 32
global cli_cmd_len ulong 1
global cli_files uchar 16384
global cli_flens ulong 64
global cli_nfiles ulong 1
global cli_changed uchar 256
global cli_changed_len ulong 1
global cli_asof long 1
global cli_has_model ulong 1

global cli_nom_sc ulong 8192
global cli_nom_rsn uchar 256
global cli_nom_rsn_len ulong 1

note Pareto row tables (up to 64 rows)
global pr_status ulong 64
global pr_t ulong 64
global pr_lo ulong 64
global pr_hi ulong 64
global pr_peak ulong 64
global pr_e ulong 64
global pr_emeas ulong 64
global pr_esyn ulong 64
global pr_front ulong 64
global pr_rsn uchar 16384
global pr_rsn_len ulong 64

note Sensitivity tables (up to 32 resources)
global sn_cf ulong 32
global sn_width ulong 32
global sn_score ulong 32
global sn_idx ulong 32

text cli_usage "usage: dagsim eval FILE | pareto FILE... | diff BASE TRANSFORMED  [--asof YYYY-MM-DD] [--model BLOB] [--changed a,b]\n"
text cli_need_asof "dagsim: --asof YYYY-MM-DD is required so the run is reproducible (calibration validity is checked against it)\n"
text cli_bad_asof "bad --asof\n"
text cli_keval "eval"
text cli_kpareto "pareto"
text cli_kdiff "diff"
text cli_fasof "--asof"
text cli_fmodel "--model"
text cli_fchanged "--changed"

text cj_perr1 "{\"schema\": \"oev1\", \"tool\": \"dagsim\", \"file\": "
text cj_perr2 ", \"status\": \"PARSE_ERROR\", \"reason\": "
text cj_perr3 "}\n"

text cj_h1 "{\n  \"schema\": \"oev1\", \"tool\": \"dagsim\", \"file\": "
text cj_h2 ",\n  \"machine\": "
text cj_h3 ", \"build_sha\": "
text cj_h4 ",\n  \"calibration\": {\"id\": "
text cj_h5 ", \"taken_day\": "
text cj_h6 ", \"valid_days\": "
text cj_h7 ", \"load1\": "
text cj_h8 ", \"src\": "
text cj_h9 "},\n  \"asof_day\": "
text cj_h10 ",\n  \"status\": "
text cj_h11 ", \"reason\": "
text cj_h12 ",\n  \"provenance\": ["
text cj_h13 "], \"synthetic\": "
text cj_h14 ", \"offline\": true, \"gpu_executed\": false"
text cj_end_ref "\n}\n"

text cj_mk1 ",\n  \"makespan_ns\": {\"nominal\": "
text cj_mk2 ", \"lo\": "
text cj_mk3 ", \"hi\": "
text cj_mk4 ", \"interval_known\": "
text cj_true "true"
text cj_false "false"
text cj_null "null"
text cj_comma ", "
text cj_colon ": "
text cj_rbrace "}"

text cj_bd1 "},\n  \"bounds_ns\": {\"critical_path\": "
text cj_bd2 ", \"max\": "
text cj_bd3 ", \"resources\": {"
text cj_bd4 "}, \"makespan_ge_bounds\": "

text cj_ops1 "},\n  \"ops\": ["
text cj_op_a "\n    {\"id\": "
text cj_op_a2 ",\n    {\"id\": "
text cj_op_s ", \"start_ns\": "
text cj_op_e ", \"end_ns\": "
text cj_op_f ", \"floor_ns\": "
text cj_op_c ", \"contention_ns\": "
text cj_op_p ", \"prov\": "
text cj_op_r ", \"src\": "

text cj_cp1 "\n  ],\n  \"critical_path\": ["
text cj_pk1 "],\n  \"peak_live_bytes\": {"
text cj_pk2 ": {\"bytes\": "
text cj_pk3 ", \"at_ns\": "
text cj_pk4 ", \"cap\": "

text cj_at1 "},\n  \"attribution_ns\": {"
text cj_en1 "},\n  \"energy\": {\"status\": "
text cj_en2 ", \"joules\": "
text cj_en3 ", \"instrument\": "
text cj_en4 ", \"boundary\": "
text cj_en5 ", \"ranking_valid\": "

text cj_co1 "},\n  \"conservation\": {\"n_ops\": "
text cj_co2 ", \"total_bytes\": "
text cj_co3 ", \"total_busy_ns\": "
text cj_co4 ", \"total_launch_ns\": "
text cj_co5 ", \"instrument_overhead_ns\": null}"

text cj_sn1 ",\n  \"sensitivities\": ["
text cj_sn_a "\n    {\"resource\": "
text cj_sn_a2 ",\n    {\"resource\": "
text cj_sn_k ", \"kind\": "
text cj_sn_m ", \"makespan_if_doubled_ns\": "
text cj_sn_d ", \"delta_ns\": "
text cj_sn_w ", \"interval_width_frac\": "
text cj_sn_s ", \"decision_score\": "
text cj_sn_n ", \"next_experiment\": "

text cj_tail1 "\n  ],\n  \"unresolved_residual_ns\": "
text cj_tail2 ",\n  \"note\": \"loaded-box calibration (load1 above); bounds are floors, not predictions; no performance claim from this simulation alone\"\n}\n"

text cj_df1 "{\"tool\": \"dagsim diff\", \"baseline\": "
text cj_df2 ", \"transformed\": "
text cj_df3 ", \"status\": "
text cj_df4 ", \"reason\": "
text cj_df5 ", \"kept\": "
text cj_df6 ", \"added\": "
text cj_df7 ", \"removed\": "
text cj_df8 ", \"double_counted\": "
text cj_df9 ", \"required_removed\": "
text cj_df10 ", \"removed_ns\": {"
text cj_df11 "}, \"changed\": "
text cj_df12 "}\n"

text cp_hdr1 "# dagsim pareto: objectives = seconds, peak bytes"
text cp_hdr_j ", joules"
text cp_hdr2 ". Energy "
text cp_hdr_em "measured on every row and part of the dominance test"
text cp_hdr_en "not measured on every row: shown, never ranked"
text cp_hdr3 ".\n# file                                 status                          seconds           lo_s           hi_s   peak_bytes energy         front\n"
text cp_yes "yes"
text cp_no "no"
text cp_ref "refused"
text cp_unm "UNMEASURED"
text cp_syn "syn "
text cp_j " J"
text cp_dash "-"
text cp_cmt "   # "

fn cli_arg_eq s view uchar * n ulong to bool
if ne n len s
ret false
end
for i ulong n bound 4096
if ne get cli_arg i get s i
ret false
end
end
ret true
end

fn cli_cmd_eq s view uchar * to bool
n = get cli_cmd_len 0
if ne n len s
ret false
end
for i ulong n bound 32
if ne get cli_cmd i get s i
ret false
end
end
ret true
end

fn cli_out_fmt_name mode ulong idx ulong to void
fa = new ulong 16 0
sn = new uchar 256 0
put fa 0 idx
n = dag_fmt mode edit fa edit sn
ds_out_jstr_buf view sn n
end

fn cli_out_next_exp rk ulong prov ulong to void
fa = new ulong 16 0
sn = new uchar 256 0
put fa 0 rk
put fa 1 prov
nl = dag_fmt 12 edit fa edit sn
ds_out_jstr_buf view sn nl
end

fn cli_out_energy_status em ulong es ulong to void
fa = new ulong 16 0
sn = new uchar 256 0
put fa 0 em
put fa 1 es
nl = dag_fmt 10 edit fa edit sn
ds_out_jstr_buf view sn nl
end

fn cli_out_nom_rsn_jstr to void
esc = new uchar 6 0
ds_out_ch uchar 34
n = get cli_nom_rsn_len 0
for i ulong n bound 256
k = dag_jstr get cli_nom_rsn i edit esc
for j ulong k bound 6
ds_out_ch get esc j
end
end
ds_out_ch uchar 34
end

fn cli_out_changed_jstr to void
esc = new uchar 6 0
ds_out_ch uchar 34
n = get cli_changed_len 0
for i ulong n bound 256
k = dag_jstr get cli_changed i edit esc
for j ulong k bound 6
ds_out_ch get esc j
end
end
ds_out_ch uchar 34
end

fn cli_out_file_jstr fi ulong to void
fl = get cli_flens fi
fb = mul fi 256
esc = new uchar 6 0
ds_out_ch uchar 34
for i ulong fl bound 256
k = dag_jstr get cli_files add fb i edit esc
for j ulong k bound 6
ds_out_ch get esc j
end
end
ds_out_ch uchar 34
end

fn cli_out_pad count ulong to void
for i ulong count bound 64
ds_out_ch uchar 32
end
end

fn cli_emit_ops to void
ds_out_text cj_ops1
n_ops = get ds_pm 12
for i ulong n_ops bound 256
if eq i 0
ds_out_text cj_op_a
else
ds_out_text cj_op_a2
end
sp = add 448 mul i 26
ds_out_jstr_slice_txt 0 get ds_pm sp get ds_pm add sp 1
ds_out_text cj_op_s
ds_out_jnum bitcast f64 get cli_nom_sc add 4512 i
ds_out_text cj_op_e
ds_out_jnum bitcast f64 get cli_nom_sc add 4768 i
ds_out_text cj_op_f
ds_out_jnum bitcast f64 get cli_nom_sc add 5280 i
ds_out_text cj_op_c
ds_out_jnum bitcast f64 get cli_nom_sc add 5536 i
ds_out_text cj_op_p
kind = get ds_pm add sp 2
hast = get ds_pm add sp 8
pv = get ds_pm add sp 7
if and eq kind 3 eq hast 0
pv = ulong 2
end
cli_out_fmt_name 1 pv
ds_out_text cj_op_r
ds_out_jstr_slice_txt 0 get ds_pm add sp 17 get ds_pm add sp 18
ds_out_text cj_rbrace
ds_out_flush 1
end
end

fn cli_sens_width sp ulong to f64
rk = get ds_pm add sp 2
capv = bitcast f64 get ds_pm add sp 4
w = f64 0.0f64
if and eq rk 2 gt capv 0.0f64
w = div sub bitcast f64 get ds_pm add sp 6 bitcast f64 get ds_pm add sp 5 capv
end
if eq get ds_pm add sp 7 4
w = f64 1.0f64
end
ret w
end

fn cli_sens_compute n_res ulong mk f64 asof long hasm ulong qbits ulong to void
for i ulong n_res bound 32
cf = ds_counterfactual_idx long i asof hasm qbits
put sn_cf i bitcast ulong cf
w = cli_sens_width add 64 mul i 12
put sn_width i bitcast ulong w
sc = f64 0.0f64
if ge cf 0.0f64
wf = w
if le wf 0.0f64
wf = f64 0.05f64
end
sc = mul fabs sub mk cf wf
end
put sn_score i bitcast ulong sc
put sn_idx i i
end
end

fn cli_sens_sort n_res ulong to void
for a ulong n_res bound 32
if gt a 0
k = get sn_idx a
b = a
while gt b 0 bound 32
prev = get sn_idx sub b 1
if not lt bitcast f64 get sn_score prev bitcast f64 get sn_score k
break
end
put sn_idx b prev
b = sub b 1
end
put sn_idx b k
end
end
end

fn cli_emit_sens_one a ulong mk f64 to void
i = get sn_idx a
sp = add 64 mul i 12
if eq a 0
ds_out_text cj_sn_a
else
ds_out_text cj_sn_a2
end
ds_out_jstr_slice_txt 0 get ds_pm sp get ds_pm add sp 1
ds_out_text cj_sn_k
cli_out_fmt_name 3 get ds_pm add sp 2
cf = bitcast f64 get sn_cf i
ds_out_text cj_sn_m
if ge cf 0.0f64
ds_out_jnum cf
else
ds_out_text cj_null
end
ds_out_text cj_sn_d
if ge cf 0.0f64
ds_out_jnum sub mk cf
else
ds_out_text cj_null
end
ds_out_text cj_sn_w
ds_out_jnum bitcast f64 get sn_width i
ds_out_text cj_sn_s
ds_out_jnum bitcast f64 get sn_score i
ds_out_text cj_sn_n
cli_out_next_exp get ds_pm add sp 2 get ds_pm add sp 7
ds_out_text cj_rbrace
ds_out_flush 1
end

fn cli_emit_sens n_res ulong mk f64 asof long hasm ulong qbits ulong to void
cli_sens_compute n_res mk asof hasm qbits
cli_sens_sort n_res
ds_out_text cj_sn1
for a ulong n_res bound 32
cli_emit_sens_one a mk
end
end

fn cli_emit_eval_hdr fi ulong st ulong to void
ds_out_text cj_h1
cli_out_file_jstr fi
ds_out_text cj_h2
ds_out_jstr_slice_txt 0 get ds_pm 17 get ds_pm 18
ds_out_text cj_h3
ds_out_jstr_slice_txt 0 get ds_pm 23 get ds_pm 24
ds_out_text cj_h4
if ne get ds_pm 3 0
ds_out_jstr_slice_txt 0 get ds_pm 27 get ds_pm 28
else
ds_out_ch uchar 34
ds_out_ch uchar 34
end
ds_out_text cj_h5
ds_out_i64 dr_i get ds_pm 4
ds_out_text cj_h6
ds_out_i64 dr_i get ds_pm 5
ds_out_text cj_h7
ds_out_jnum bitcast f64 get ds_pm 6
ds_out_text cj_h8
ds_out_jstr_slice_txt 0 get ds_pm 29 get ds_pm 30
ds_out_text cj_h9
ds_out_i64 get cli_asof 0
ds_out_text cj_h10
cli_out_fmt_name 0 st
ds_out_text cj_h11
cli_out_nom_rsn_jstr
ds_out_text cj_h12
pmask = get cli_nom_sc 11
first = ulong 1
for p ulong 5
if ne and pmask shl ulong 1 p 0
if eq first 0
ds_out_text cj_comma
end
first = ulong 0
cli_out_fmt_name 1 p
end
end
ds_out_text cj_h13
ds_out_u64 get cli_nom_sc 26
ds_out_text cj_h14
end

fn cli_emit_bounds mk f64 lo f64 hi f64 to void
ds_out_text cj_mk1
ds_out_jnum mk
ds_out_text cj_mk2
ds_out_jnum lo
ds_out_text cj_mk3
ds_out_jnum hi
ds_out_text cj_mk4
if and gt lo 0.0f64 gt hi 0.0f64
ds_out_text cj_true
else
ds_out_text cj_false
end
ds_out_text cj_bd1
ds_out_jnum bitcast f64 get cli_nom_sc 20
ds_out_text cj_bd2
bnd = bitcast f64 get cli_nom_sc 19
ds_out_jnum bnd
ds_out_text cj_bd3
n_res = get ds_pm 11
for i ulong n_res bound 32
if gt i 0
ds_out_text cj_comma
end
sp = add 64 mul i 12
ds_out_jstr_slice_txt 0 get ds_pm sp get ds_pm add sp 1
ds_out_text cj_colon
ds_out_jnum bitcast f64 get cli_nom_sc add 5792 i
end
ds_out_text cj_bd4
if ge add mk 0.000001f64 bnd
ds_out_text cj_true
else
ds_out_text cj_false
end
ds_out_flush 1
end

fn cli_emit_cp_peak to void
ds_out_text cj_cp1
nc = get cli_nom_sc 21
for i ulong nc bound 256
if gt i 0
ds_out_text cj_comma
end
oi = get cli_nom_sc add 6080 i
sp = add 448 mul oi 26
ds_out_jstr_slice_txt 0 get ds_pm sp get ds_pm add sp 1
end
ds_out_text cj_pk1
n_res = get ds_pm 11
first = ulong 1
for i ulong n_res bound 32
sp = add 64 mul i 12
if eq get ds_pm add sp 2 3
if eq first 0
ds_out_text cj_comma
end
first = ulong 0
ds_out_jstr_slice_txt 0 get ds_pm sp get ds_pm add sp 1
ds_out_text cj_pk2
ds_out_jnum bitcast f64 get cli_nom_sc add 6344 i
ds_out_text cj_pk3
ds_out_jnum bitcast f64 get cli_nom_sc add 6376 i
ds_out_text cj_pk4
ds_out_jnum bitcast f64 get ds_pm add sp 4
ds_out_text cj_rbrace
end
end
ds_out_flush 1
end

fn cli_emit_attr_energy_cons to void
ds_out_text cj_at1
for i ulong 7
if gt i 0
ds_out_text cj_comma
end
cli_out_fmt_name 4 i
ds_out_text cj_colon
ds_out_jnum bitcast f64 get cli_nom_sc add 5824 i
end
ds_out_text cj_en1
em = get cli_nom_sc 22
es = get cli_nom_sc 23
cli_out_energy_status em es
ds_out_text cj_en2
if or ne em 0 ne es 0
ds_out_jnum bitcast f64 get cli_nom_sc 24
else
ds_out_text cj_null
end
ds_out_text cj_en3
ds_out_jstr_slice_txt 0 get ds_pm 33 get ds_pm 34
ds_out_text cj_en4
ds_out_jstr_slice_txt 0 get ds_pm 35 get ds_pm 36
ds_out_text cj_en5
if ne em 0
ds_out_text cj_true
else
ds_out_text cj_false
end
ds_out_text cj_co1
ds_out_u64 get ds_pm 12
ds_out_text cj_co2
ds_out_jnum bitcast f64 get cli_nom_sc 15
ds_out_text cj_co3
ds_out_jnum bitcast f64 get cli_nom_sc 16
ds_out_text cj_co4
ds_out_jnum bitcast f64 get cli_nom_sc 17
ds_out_text cj_co5
ds_out_flush 1
end

fn cli_emit_eval_body lo f64 hi f64 to void
mk = bitcast f64 get cli_nom_sc 3
cli_emit_bounds mk lo hi
cli_emit_ops
cli_emit_cp_peak
cli_emit_attr_energy_cons
cli_emit_sens get ds_pm 11 mk get cli_asof 0 get cli_has_model 0 bitcast ulong 0.9f64
ds_out_text cj_tail1
ds_out_jnum bitcast f64 get cli_nom_sc 5830
ds_out_text cj_tail2
ds_out_flush 1
end

fn cli_cmd_eval to int
flen = get cli_flens 0
pbuf = new uchar 256 0
for i ulong flen bound 256
put pbuf i get cli_files i
end
prc = ds_read_file_side 0 view pbuf flen
ds_out_reset
if ne prc 0
ds_out_text cj_perr1
cli_out_file_jstr 0
ds_out_text cj_perr2
ds_out_jstr_err
ds_out_text cj_perr3
ds_out_flush 1
ret 1
end
asof = get cli_asof 0
hasm = get cli_has_model 0
qbits = bitcast ulong 0.9f64
rc = ds_eval_current 0 asof hasm qbits
for i ulong 8192
put cli_nom_sc i get ds_sc i
end
rlen = get ds_reason_len 0
put cli_nom_rsn_len 0 rlen
for i ulong rlen bound 256
put cli_nom_rsn i get ds_reason i
end
cli_emit_eval_hdr 0 rc
if ne rc 0
ds_out_text cj_end_ref
ds_out_flush 1
ret 1
end
lo = f64 0.0f64
hi = f64 0.0f64
rc_lo = ds_eval_current 1 asof hasm qbits
if eq rc_lo 0
lo = bitcast f64 get ds_sc 3
end
rc_hi = ds_eval_current -1 asof hasm qbits
if eq rc_hi 0
hi = bitcast f64 get ds_sc 3
end
cli_emit_eval_body lo hi
ret 0
end

fn cli_pareto_load k ulong to ulong
fl = get cli_flens k
fb = mul k 256
pbuf = new uchar 256 0
for i ulong fl bound 256
put pbuf i get cli_files add fb i
end
prc = ds_read_file_side 0 view pbuf fl
if ne prc 0
put pr_status k 9
rl = ulong 0
while lt rl 255 bound 256
c = get ds_err rl
if eq c 0
break
end
put pr_rsn add fb rl c
rl = add rl 1
end
put pr_rsn_len k rl
ret 1
end
ret 0
end

fn cli_pareto_max_peak to f64
peak = f64 0.0f64
n_res = get ds_pm 11
for i ulong n_res bound 32
sp = add 64 mul i 12
if eq get ds_pm add sp 2 3
pv = bitcast f64 get ds_sc add 6344 i
if gt pv peak
peak = pv
end
end
end
ret peak
end

fn cli_pareto_eval_one k ulong to ulong
if ne cli_pareto_load k 0
ret 0
end
asof = get cli_asof 0
hasm = get cli_has_model 0
qbits = bitcast ulong 0.9f64
rc = ds_eval_current 0 asof hasm qbits
put pr_status k rc
fb = mul k 256
rl = get ds_reason_len 0
put pr_rsn_len k rl
for i ulong rl bound 256
put pr_rsn add fb i get ds_reason i
end
if ne rc 0
ret 0
end
put pr_t k get ds_sc 3
put pr_peak k bitcast ulong cli_pareto_max_peak
put pr_e k get ds_sc 24
put pr_emeas k get ds_sc 22
put pr_esyn k get ds_sc 23
rc_lo = ds_eval_current 1 asof hasm qbits
if eq rc_lo 0
put pr_lo k get ds_sc 3
else
put pr_lo k 0
end
rc_hi = ds_eval_current -1 asof hasm qbits
if eq rc_hi 0
put pr_hi k get ds_sc 3
else
put pr_hi k 0
end
if eq get pr_emeas k 0
ret 0
end
ret 1
end

fn cli_pareto_dom a ulong b ulong all_e ulong to bool
ta = bitcast f64 get pr_t a
tb = bitcast f64 get pr_t b
pa = bitcast f64 get pr_peak a
pb = bitcast f64 get pr_peak b
leq = and le tb ta le pb pa
str = or lt tb ta lt pb pa
if ne all_e 0
ea = bitcast f64 get pr_e a
eb = bitcast f64 get pr_e b
leq = and leq le eb ea
str = or str lt eb ea
end
ret and leq str
end

fn cli_pareto_print_row k ulong to void
fa = new ulong 16 0
sn = new uchar 256 0
ds_out_ch uchar 32
ds_out_ch uchar 32
fl = get cli_flens k
fb = mul k 256
for i ulong fl bound 256
ds_out_ch get cli_files add fb i
end
if lt fl 36
cli_out_pad sub 36 fl
end
ds_out_ch uchar 32
st = get pr_status k
put fa 0 st
sl = dag_fmt 0 edit fa edit sn
for i ulong sl bound 64
ds_out_ch get sn i
end
if lt sl 24
cli_out_pad sub 24 sl
end
ds_out_ch uchar 32
if eq st 0
ds_out_fixed mul bitcast f64 get pr_t k 1.0e-9f64 6
ds_out_ch uchar 32
ds_out_fixed mul bitcast f64 get pr_lo k 1.0e-9f64 6
ds_out_ch uchar 32
ds_out_fixed mul bitcast f64 get pr_hi k 1.0e-9f64 6
ds_out_ch uchar 32
ds_out_fixed bitcast f64 get pr_peak k 0
ds_out_ch uchar 32
if ne get pr_emeas k 0
ds_out_fixed bitcast f64 get pr_e k 3
ds_out_text cp_j
else
if ne get pr_esyn k 0
ds_out_text cp_syn
ds_out_fixed bitcast f64 get pr_e k 3
ds_out_text cp_j
else
ds_out_text cp_unm
end
end
ds_out_ch uchar 32
if ne get pr_front k 0
ds_out_text cp_yes
else
ds_out_text cp_no
end
else
ds_out_text cp_dash
ds_out_ch uchar 32
ds_out_text cp_dash
ds_out_ch uchar 32
ds_out_text cp_dash
ds_out_ch uchar 32
ds_out_text cp_dash
ds_out_ch uchar 32
ds_out_text cp_dash
ds_out_ch uchar 32
ds_out_text cp_ref
ds_out_text cp_cmt
rl = get pr_rsn_len k
for i ulong rl bound 256
ds_out_ch get pr_rsn add fb i
end
end
ds_out_ch uchar 10
ds_out_flush 1
end

fn cli_cmd_pareto to int
nf = get cli_nfiles 0
all_e = ulong 1
for k ulong nf bound 64
ok_e = cli_pareto_eval_one k
if eq ok_e 0
all_e = ulong 0
end
end
for a ulong nf bound 64
if eq get pr_status a 0
put pr_front a 1
for b ulong nf bound 64
if and ne a b eq get pr_status b 0
if cli_pareto_dom a b all_e
put pr_front a 0
break
end
end
end
end
end
ds_out_reset
ds_out_text cp_hdr1
if ne all_e 0
ds_out_text cp_hdr_j
end
ds_out_text cp_hdr2
if ne all_e 0
ds_out_text cp_hdr_em
else
ds_out_text cp_hdr_en
end
ds_out_text cp_hdr3
ds_out_flush 1
for k ulong nf bound 64
cli_pareto_print_row k
end
ret 0
end

fn cli_cmd_diff to int
f0 = new uchar 256 0
f1 = new uchar 256 0
cb = new uchar 256 0
l0 = get cli_flens 0
l1 = get cli_flens 1
for i ulong l0 bound 256
put f0 i get cli_files i
end
for i ulong l1 bound 256
put f1 i get cli_files add 256 i
end
if ne ds_read_file_side 0 view f0 l0 0
ds_out_reset
ds_out_jstr_err
ds_out_ch uchar 10
ds_out_flush 2
ret 1
end
if ne ds_read_file_side 1 view f1 l1 0
ds_out_reset
ds_out_jstr_err
ds_out_ch uchar 10
ds_out_flush 2
ret 1
end
ds_pack_side 0
ds_pack_side 1
clen = get cli_changed_len 0
if gt clen 0
for i ulong clen bound 256
put cb i get cli_changed i
end
ds_mark_changed view cb clen
end
for i ulong 64
put ds_ra i 0
end
rc = ds_run_diff
ds_out_reset
ds_out_text cj_df1
cli_out_file_jstr 0
ds_out_text cj_df2
cli_out_file_jstr 1
ds_out_text cj_df3
cli_out_fmt_name 0 rc
ds_out_text cj_df4
ds_out_ch uchar 34
ds_out_ch uchar 34
ds_out_text cj_df5
ds_out_u64 get ds_ra 11
ds_out_text cj_df6
ds_out_u64 get ds_ra 10
ds_out_text cj_df7
ds_out_u64 get ds_ra 12
ds_out_text cj_df8
ds_out_u64 get ds_ra 13
ds_out_text cj_df9
ds_out_u64 get ds_ra 14
ds_out_text cj_df10
for i ulong 7
if gt i 0
ds_out_text cj_comma
end
cli_out_fmt_name 2 add i 1
ds_out_text cj_colon
ds_out_jnum bitcast f64 get ds_ra add 33 i
end
ds_out_text cj_df11
cli_out_changed_jstr
ds_out_text cj_df12
ds_out_flush 1
if eq rc 0
ret 0
end
ret 1
end

fn cli_parse_asof_arg n2 ulong to long
dbuf = new uchar 256 0
lim = n2
if gt lim 255
lim = ulong 255
end
for k ulong lim bound 256
put dbuf k get cli_arg k
end
ret ds_day_from_slice view dbuf lim
end

fn cli_parse_args ac ulong to int
i = ulong 2
while lt i ac bound 256
n = argread i cli_arg 0 4096
if lt n 0
ret 2
end
un = ulong n
if cli_arg_eq cli_fasof un
if ge add i 1 ac
ret 2
end
i = add i 1
n2 = argread i cli_arg 0 4096
if le n2 0
ret 2
end
d = cli_parse_asof_arg ulong n2
if lt d 0
w = write 2 cli_bad_asof 0 len cli_bad_asof
ret 2
end
put cli_asof 0 d
i = add i 1
continue
end
if cli_arg_eq cli_fchanged un
if ge add i 1 ac
ret 2
end
i = add i 1
n2 = argread i cli_arg 0 4096
if lt n2 0
ret 2
end
lim = ulong n2
if gt lim 255
lim = ulong 255
end
for k ulong lim bound 256
put cli_changed k get cli_arg k
end
put cli_changed_len 0 lim
i = add i 1
continue
end
if cli_arg_eq cli_fmodel un
if ge add i 1 ac
ret 2
end
i = add i 2
continue
end
nf = get cli_nfiles 0
if lt nf 64
lim = un
if gt lim 255
lim = ulong 255
end
fb = mul nf 256
for k ulong lim bound 256
put cli_files add fb k get cli_arg k
end
put cli_flens nf lim
put cli_nfiles 0 add nf 1
end
i = add i 1
end
ret 0
end

fn main to int
ac = argcnt
if lt ac 3
w = write 2 cli_usage 0 len cli_usage
ret 2
end
n1 = argread 1 cli_arg 0 4096
if le n1 0
w = write 2 cli_usage 0 len cli_usage
ret 2
end
cl = ulong n1
if gt cl 31
cl = ulong 31
end
for i ulong cl bound 32
put cli_cmd i get cli_arg i
end
put cli_cmd_len 0 cl
prc = cli_parse_args ulong ac
if ne prc 0
ret prc
end
if eq get cli_asof 0 0
w = write 2 cli_need_asof 0 len cli_need_asof
ret 2
end
nf = get cli_nfiles 0
if and cli_cmd_eq cli_keval eq nf 1
ret cli_cmd_eval
end
if and cli_cmd_eq cli_kpareto ge nf 1
ret cli_cmd_pareto
end
if and cli_cmd_eq cli_kdiff eq nf 2
ret cli_cmd_diff
end
w = write 2 cli_usage 0 len cli_usage
ret 2
end

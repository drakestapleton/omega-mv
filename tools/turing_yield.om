note ---- Output buffer helpers ----

fn ob_clr to void
  put g_olen 0 0
  put g_ofd 0 int 1
end

fn ob_set_fd fd int to void
  put g_olen 0 0
  put g_ofd 0 fd
end

fn ob_flush to void
  n = get g_olen 0
  if gt n 0
    w = write get g_ofd 0 g_obuf 0 n
    put g_olen 0 0
  end
end

fn ob_b c uchar to void
  n = get g_olen 0
  if ge n 8000
    ob_flush
    n = get g_olen 0
  end
  if lt n 8192
    put g_obuf n c
    put g_olen 0 add n 1
  end
end

fn ob_txt s view uchar * to void
  n = len s
  for i ulong n bound 256
    ob_b get s i
  end
end

fn ob_u64 v ulong to void
  tv_clr
  tv_u64 v
  n = get g_tvl 0
  for i ulong n bound 32
    ob_b get g_tv i
  end
end

fn ob_i64 v long to void
  tv_clr
  tv_i64 v
  n = get g_tvl 0
  for i ulong n bound 32
    ob_b get g_tv i
  end
end

fn ob_dig slot ulong to void
  tv_clr
  tv_dig slot
  for i ulong 64
    ob_b get g_tv i
  end
end

fn ob_spaces cnt ulong to void
  for i ulong cnt bound 64
    ob_b uchar 32
  end
end

fn ob_u64_w v ulong width ulong to void
  tv_clr
  tv_u64 v
  n = get g_tvl 0
  if lt n width
    ob_spaces sub width n
  end
  for i ulong n bound 32
    ob_b get g_tv i
  end
end

fn ob_pad_dec v ulong digits ulong to void
  tmp = new uchar 16 48
  cur = v
  for i ulong digits bound 16
    idx = sub sub digits 1 i
    d = rem cur 10
    put tmp idx uchar add ulong 48 d
    cur = div cur 10
  end
  for i ulong digits bound 16
    ob_b get tmp i
  end
end

fn ob_f64_fixed x f64 prec ulong to void
  if lt x 0.0f64
    ob_b uchar 45
    x = neg x
  end
  scale = 1000.0f64
  divv = ulong 1000
  if eq prec 6
    scale = 1000000.0f64
    divv = ulong 1000000
  end
  sc = ulong add mul x scale 0.5f64
  ob_u64 div sc divv
  ob_b uchar 46
  ob_pad_dec rem sc divv prec
end

fn ob_mrel idx ulong to void
  ro = mul idx 256
  rl = get g_m_rlen idx
  for i ulong rl bound 256
    ob_b get g_m_rel add ro i
  end
end

fn ob_mpath idx ulong to void
  po = mul idx 512
  pl = get g_m_plen idx
  for i ulong pl bound 512
    ob_b get g_m_path add po i
  end
end

fn die_msg msg view uchar * to int
  ob_set_fd int 2
  ob_txt t_err_pre
  ob_txt msg
  ob_b uchar 10
  ob_flush
  ret 2
end

fn a1_eq_txt alen ulong t view uchar * to bool
  if ne alen len t
    ret false
  end
  for i ulong alen bound 64
    if ne get g_a1 i get t i
      ret false
    end
  end
  ret true
end

fn ob_rung_name_raw k ulong to ulong
  if eq k 0
    ob_txt t_r0
    ret len t_r0
  end
  if eq k 1
    ob_txt t_r1
    ret len t_r1
  end
  if eq k 2
    ob_txt t_r2
    ret len t_r2
  end
  if eq k 3
    ob_txt t_r3
    ret len t_r3
  end
  if eq k 4
    ob_txt t_r4
    ret len t_r4
  end
  if eq k 5
    ob_txt t_r5
    ret len t_r5
  end
  if eq k 6
    ob_txt t_r6
    ret len t_r6
  end
  if eq k 7
    ob_txt t_r7
    ret len t_r7
  end
  if eq k 8
    ob_txt t_r8
    ret len t_r8
  end
  if eq k 9
    ob_txt t_r9
    ret len t_r9
  end
  if eq k 10
    ob_txt t_r10
    ret len t_r10
  end
  if eq k 11
    ob_txt t_r11
    ret len t_r11
  end
  if eq k 12
    ob_txt t_r12
    ret len t_r12
  end
  if eq k 13
    ob_txt t_r13
    ret len t_r13
  end
  ob_txt t_r14
  ret len t_r14
end

fn ob_rung_name k ulong to void
  n = ob_rung_name_raw k
  while lt n 28 bound 32
    ob_b uchar 32
    n = add n 1
  end
end

fn rung_mask k ulong to ulong
  if eq k 2
    ret TY_F_PREV1
  end
  if eq k 3
    ret TY_F_OP
  end
  if eq k 4
    ret or TY_F_OP TY_F_PREV1
  end
  if eq k 5
    ret or or TY_F_OP TY_F_PREV1 TY_F_PREV2
  end
  if eq k 6
    ret or or or TY_F_OP TY_F_PREV1 TY_F_PREV2 TY_F_PREV3
  end
  if eq k 7
    ret or or or or TY_F_OP TY_F_PREV1 TY_F_PREV2 TY_F_PREV3 TY_F_PREV4
  end
  if eq k 8
    ret or or or or or TY_F_OP TY_F_PREV1 TY_F_PREV2 TY_F_PREV3 TY_F_PREV4 TY_F_PREV5
  end
  if eq k 9
    ret or or TY_F_OP TY_F_DEPTH TY_F_PREV1
  end
  if eq k 10
    ret or or or TY_F_OP TY_F_DEPTH TY_F_PREV1 TY_F_PREV2
  end
  if eq k 11
    ret or or or or TY_F_OP TY_F_DEPTH TY_F_PREV1 TY_F_PREV2 TY_F_PREV3
  end
  if eq k 12
    ret or or or or or TY_F_OP TY_F_DEPTH TY_F_PREV1 TY_F_PREV2 TY_F_PREV3 TY_F_PREV4
  end
  if eq k 13
    ret or or or or or or TY_F_OP TY_F_DEPTH TY_F_PREV1 TY_F_PREV2 TY_F_PREV3 TY_F_PREV4 TY_F_PREV5
  end
  if eq k 14
    ret TY_F_POS
  end
  ret 0
end

note ---- File / stat helpers ----

fn stbuf_size to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get g_stbuf add ulong 48 i
    v = or v shl b mul i 8
  end
  ret v
end

fn set_gp_mpath idx ulong to void
  po = mul idx 512
  pl = get g_m_plen idx
  for i ulong pl bound 512
    put g_path i get g_m_path add po i
  end
  put g_plen 0 pl
end

fn stat_mpath idx ulong to long
  set_gp_mpath idx
  ret stat g_path 0 get g_plen 0 g_stbuf 0 128
end

fn join_a4_suffix l4 ulong suf view uchar * to ulong
  for i ulong l4 bound 512
    put g_pbuf i get g_a4 i
  end
  sl = len suf
  for i ulong sl bound 64
    put g_pbuf add l4 i get suf i
  end
  ret add l4 sl
end

fn write_mcode_file plen ulong cs ulong nby ulong to long
  fd = fopen g_pbuf 0 plen int 577 int 420
  if lt fd 0
    ret TY_E_IO
  end
  cbo = mul cs TY_MCODE_SLOT
  pos = ulong 0
  while lt pos nby bound 1048576
    rem_b = sub nby pos
    if gt rem_b 65536
      rem_b = 65536
    end
    w = write int fd g_mcode add cbo pos rem_b
    if le w 0
      dc = fclose int fd
      ret TY_E_IO
    end
    pos = add pos ulong w
  end
  dc = fclose int fd
  if ne dc 0
    ret TY_E_IO
  end
  ret TY_OK
end

note ---- Seed loading and split setup ----

fn load_seed idx ulong to long
  if ne get g_loaded idx 0
    ret TY_OK
  end
  if ne stat_mpath idx 0
    ob_set_fd int 2
    ob_txt t_err_sz
    ob_mpath idx
    ob_b uchar 10
    ob_flush
    ret TY_E_IO
  end
  sz = stbuf_size
  if ne sz get g_m_sz idx
    ob_set_fd int 2
    ob_txt t_err_sz
    ob_mpath idx
    ob_b uchar 10
    ob_flush
    ret TY_E_IO
  end
  if ne rem sz TY_CTR1_BYTES 0
    ret TY_E_FORMAT
  end
  st_begin idx
  n = ty_ctr1_read_gp idx
  if lt n 0
    ret n
  end
  put g_loaded idx 1
  ob_set_fd int 2
  ob_txt t_rd1
  ob_mrel idx
  ob_txt t_rd2
  ob_i64 n
  ob_txt t_rd3
  ob_u64 div sz TY_CTR1_BYTES
  ob_txt t_rd4
  ob_u64 get g_st_ncr idx
  ob_txt t_rd5
  ob_u64 get g_st_gap idx
  ob_txt t_rd6
  ob_flush
  ret TY_OK
end

fn setup_default_split to void
  put g_sp_nf 0 7
  put g_sp_nh 0 3
  for i ulong 7
    put g_sp_fdig i i
    ro = mul i 256
    rl = get g_m_rlen i
    if gt rl 63
      rl = 63
    end
    lo = mul i 64
    for j ulong rl bound 64
      put g_sp_flbl add lo j get g_m_rel add ro j
    end
    put g_sp_flen i rl
  end
  for i ulong 3
    si = add i 7
    put g_sp_hdig i si
    ro = mul si 256
    rl = get g_m_rlen si
    if gt rl 63
      rl = 63
    end
    lo = mul i 64
    for j ulong rl bound 64
      put g_sp_hlbl add lo j get g_m_rel add ro j
    end
    put g_sp_hlen i rl
  end
end

note Fit on g_fit_sids[0..nf-1], encode to slot 0, decode to model slot 1, score on g_fs_sc[0..ns-1]
fn fit_score_rung k ulong mask ulong is_uni bool nf ulong ns ulong to long
  rc = TY_OK
  if is_uni
    rc = ty_model_uniform 0 TY_OUT_K
  else
    rc = ty_model_fit 0 nf mask TY_OUT_K TY_FIT_MDL_PRUNE
  end
  if ne rc TY_OK
    ret rc
  end
  rc = ty_model_encode 0 0
  if ne rc TY_OK
    ret rc
  end
  nb = get g_mclen 0
  put g_fs_lm 0 get g_mcbits 0
  rc = ty_model_decode 0 nb 1
  if ne rc TY_OK
    ret rc
  end
  tot_ld = long 0
  tot_ns = ulong 0
  for i ulong ns bound 10
    sid = get g_fs_sc i
    rc = ty_model_score 1 sid
    if ne rc TY_OK
      ret rc
    end
    ub = get g_ty_ret_i 0
    sn = get g_ty_ret_u 0
    put g_fs_pf i ub
    rc = ty_add tot_ld ub
    if ne rc TY_OK
      ret rc
    end
    tot_ld = get g_ty_ret_i 0
    tot_ns = add tot_ns sn
  end
  put g_fs_ld 0 tot_ld
  put g_fs_ns 0 tot_ns
  ret TY_OK
end

note ---- Subcommand: fixture ----

fn cmd_fixture l2 ulong l3 ulong to int
  st_reset_all
  st_begin 0
  for i ulong l2 bound 512
    put g_path i get g_a2 i
  end
  put g_plen 0 l2
  if lt ty_ctr1_read_gp 0 0
    ret 2
  end
  st_begin 1
  for i ulong l3 bound 512
    put g_path i get g_a3 i
  end
  put g_plen 0 l3
  if lt ty_ctr1_read_gp 1 0
    ret 2
  end
  ob_clr
  ob_txt t_ff1
  ob_u64 get g_st_n 0
  ob_txt t_ff2
  ob_u64 get g_st_ncr 0
  ob_txt t_ff3
  ob_u64 get g_st_n 1
  ob_txt t_ff2
  ob_u64 get g_st_ncr 1
  ob_txt t_ff4
  ob_flush
  put g_fit_sids 0 0
  for k ulong 15
    rc = TY_OK
    if eq k 0
      rc = ty_model_uniform 0 TY_OUT_K
    else
      rule = TY_FIT_MDL_PRUNE
      if eq k 14
        rule = TY_FIT_KEEP_ALL
      end
      rc = ty_model_fit 0 1 rung_mask k TY_OUT_K rule
    end
    if ne rc TY_OK
      ret 2
    end
    rc = ty_model_encode 0 0
    if ne rc TY_OK
      ret 2
    end
    nb = get g_mclen 0
    lm = get g_mcbits 0
    rc = ty_model_score 0 0
    if ne rc TY_OK
      ret 2
    end
    in_ub = get g_ty_ret_i 0
    rc = ty_model_score 0 1
    if ne rc TY_OK
      ret 2
    end
    out_ub = get g_ty_ret_i 0
    ty_model_digest 0 nb 0
    ob_clr
    ob_rung_name k
    ob_txt t_fl1
    ob_u64 get g_md_nr 0
    ob_txt t_fl2
    ob_u64 lm
    ob_txt t_fl3
    ob_i64 in_ub
    ob_txt t_fl4
    ob_i64 out_ub
    ob_txt t_fl5
    ob_dig 0
    ob_b uchar 10
    ob_flush
  end
  ret 0
end

note ---- Manifest parser ----

fn store_manifest_paths p ulong rlen ulong n ulong rl ulong to void
  ro = mul n 256
  for i ulong rlen bound 256
    put g_m_rel add ro i get g_mbuf add p i
  end
  put g_m_rlen n rlen
  po = mul n 512
  for i ulong rl bound 512
    put g_m_path add po i get g_a3 i
  end
  put g_m_path add po rl uchar 47
  po1 = add add po rl 1
  for i ulong rlen bound 256
    put g_m_path add po1 i get g_m_rel add ro i
  end
  put g_m_plen n add add rl 1 rlen
end

fn parse_manifest_line ls ulong le_p ulong n ulong rl ulong to long
  h = new uchar 64 0
  if lt sub le_p ls 66
    ret TY_E_FORMAT
  end
  for i ulong 64
    put h i get g_mbuf add ls i
  end
  if ne dg_parse_hex h 64 n TY_OK
    ret TY_E_FORMAT
  end
  p = add ls 64
  while lt p le_p bound 16
    if ne get g_mbuf p uchar 32
      break
    end
    p = add p 1
  end
  sz = ulong 0
  while lt p le_p bound 32
    b = get g_mbuf p
    if or lt b uchar 48 gt b uchar 57
      break
    end
    sz = add mul sz 10 ulong sub b uchar 48
    p = add p 1
  end
  put g_m_sz n sz
  while lt p le_p bound 16
    if ne get g_mbuf p uchar 32
      break
    end
    p = add p 1
  end
  rlen = sub le_p p
  if or eq rlen 0 gt rlen 255
    ret TY_E_FORMAT
  end
  store_manifest_paths p rlen n rl
  ret TY_OK
end

fn load_manifest ml ulong rl ulong to long
  fd = fopen g_a2 0 ml int 0 int 0
  if lt fd 0
    ret TY_E_IO
  end
  k = read int fd g_mbuf 0 16384
  dc = fclose int fd
  if le k 0
    ret TY_E_IO
  end
  blen = ulong k
  pos = ulong 0
  n = ulong 0
  while and lt pos blen lt n 10 bound 200
    ls = pos
    while lt pos blen bound 2000
      if eq get g_mbuf pos uchar 10
        break
      end
      pos = add pos 1
    end
    le_p = pos
    if lt pos blen
      pos = add pos 1
    end
    if eq ls le_p
      continue
    end
    if eq get g_mbuf ls uchar 35
      continue
    end
    rc = parse_manifest_line ls le_p n rl
    if ne rc TY_OK
      ret rc
    end
    n = add n 1
  end
  if ne n 10
    ret TY_E_FORMAT
  end
  for i ulong ml bound 512
    put g_path i get g_a2 i
  end
  put g_plen 0 ml
  ret ty_file_sha256_gp 15
end

note ---- Subcommand: manifest-check ----

fn cmd_manifest_check to int
  bad = ulong 0
  for i ulong 10
    ok = false
    if eq stat_mpath i 0
      sz = stbuf_size
      if and eq sz get g_m_sz i eq rem sz TY_CTR1_BYTES 0
        if eq ty_file_sha256_gp 18 TY_OK
          if dg_eq 18 i
            ok = true
          end
        end
      end
    end
    ob_clr
    if ok
      ob_txt t_ok_p
    else
      ob_txt t_fl_p
      bad = add bad 1
    end
    ob_mrel i
    ob_txt t_recs
    ob_u64 div get g_m_sz i TY_CTR1_BYTES
    ob_b uchar 10
    ob_flush
  end
  if ne bad 0
    ret 1
  end
  ret 0
end

note ---- Subcommand: profile ----

fn cmd_profile to int
  rc = ty_profile_v0_digest 15 1 16
  setup_default_split
  rc = ty_split_digest 17
  ob_clr
  ob_txt t_pm1
  ob_dig 15
  ob_b uchar 10
  ob_txt t_pm2
  ob_dig 16
  ob_b uchar 10
  ob_txt t_pm3
  ob_dig 17
  ob_b uchar 10
  ob_txt t_pm4
  ob_u64 TY_V0_BASELINE_MASK
  ob_b uchar 10
  ob_txt t_pm5
  ob_u64 TY_V0_CANDIDATE_MASK
  ob_b uchar 10
  ob_txt t_pm6
  ob_i64 TY_V0_MARGIN_UB
  ob_b uchar 10
  ob_flush
  ret 0
end

note ---- Subcommand: tune ----

fn print_tune_row k ulong mk ulong lm ulong ld long dl long ns ulong to void
  ob_clr
  ob_rung_name k
  ob_b uchar 32
  ob_u64_w mk 6
  ob_b uchar 32
  ob_u64_w lm 14
  ob_spaces 4
  ob_f64_fixed div f64 ld 1000000.0f64 3
  ob_spaces 4
  ob_f64_fixed div f64 dl 1000000.0f64 3
  ob_spaces 3
  bps = 0.0f64
  if gt ns 0
    bps = div div f64 dl 1000000.0f64 f64 ns
  end
  ob_f64_fixed bps 6
  ob_b uchar 10
  ob_flush
end

fn cmd_tune to int
  st_reset_all
  for i ulong 7
    if ne load_seed i TY_OK
      ret 2
    end
  end
  for i ulong 6
    put g_fit_sids i i
  end
  put g_fs_sc 0 6
  ob_clr
  ob_txt t_tu_hdr1
  ob_txt t_tu_hdr2
  ob_flush
  best_b = long 9223372036854775807
  best_c = long 9223372036854775807
  kb = ulong 0
  kc = ulong 0
  for k ulong 14
    mk = rung_mask k
    rc = fit_score_rung k mk eq k 0 6 1
    if ne rc TY_OK
      ret die_msg t_err_fs
    end
    lm = get g_fs_lm 0
    ld = get g_fs_ld 0
    ns = get g_fs_ns 0
    if ne ty_dl lm ld TY_OK
      ret die_msg t_err_fs
    end
    dl = get g_ty_ret_i 0
    print_tune_row k mk lm ld dl ns
    if and ge k 1 le k 3
      if lt dl best_b
        best_b = dl
        kb = k
      end
    end
    if ge k 4
      if lt dl best_c
        best_c = dl
        kc = k
      end
    end
  end
  ob_clr
  ob_txt t_tu_cb
  n1 = ob_rung_name_raw kb
  ob_txt t_tu_mk
  ob_u64 rung_mask kb
  ob_txt t_tu_mk2
  ob_txt t_tu_cc
  n2 = ob_rung_name_raw kc
  ob_txt t_tu_mk
  ob_u64 rung_mask kc
  ob_txt t_tu_mk2
  ob_txt t_tu_vt
  ob_f64_fixed div f64 sub best_b best_c 1000000.0f64 3
  ob_txt t_bits_nl
  ob_flush
  ret 0
end

note ---- Subcommand: loso ----

fn loso_one_seed s ulong to long
  nf = ulong 0
  for i ulong 7
    if ne i s
      put g_fit_sids nf i
      nf = add nf 1
    end
  end
  put g_fs_sc 0 s
  rc = fit_score_rung 2 TY_V0_BASELINE_MASK false nf 1
  if ne rc TY_OK
    ret rc
  end
  lb = get g_fs_lm 0
  db = get g_fs_ld 0
  ns = get g_fs_ns 0
  rc = fit_score_rung 12 TY_V0_CANDIDATE_MASK false nf 1
  if ne rc TY_OK
    ret rc
  end
  lc = get g_fs_lm 0
  dc = get g_fs_ld 0
  if ne ty_dl lb db TY_OK
    ret TY_E_OVERFLOW
  end
  xb = get g_ty_ret_i 0
  if ne ty_dl lc dc TY_OK
    ret TY_E_OVERFLOW
  end
  xc = get g_ty_ret_i 0
  if ne ty_gain xb xc TY_OK
    ret TY_E_OVERFLOW
  end
  gv = get g_ty_ret_i 0
  tb = div f64 gv 1000000.0f64
  put g_loso_t s tb
  ob_clr
  ob_txt t_lo_s1
  ob_u64 add s 1
  ob_txt t_lo_s2
  ob_u64 ns
  ob_txt t_lo_s3
  ob_f64_fixed div f64 xb 1000000.0f64 3
  ob_txt t_lo_s4
  ob_f64_fixed div f64 xc 1000000.0f64 3
  ob_txt t_lo_s5
  ob_f64_fixed tb 3
  ob_txt t_lo_s6
  bps = 0.0f64
  if gt ns 0
    bps = div tb f64 ns
  end
  ob_f64_fixed bps 6
  ob_txt t_lo_s7
  ob_flush
  ret TY_OK
end

fn f64_ceil_i64 x f64 to long
  t = long x
  if gt x f64 t
    ret add t 1
  end
  ret t
end

fn cmd_loso to int
  st_reset_all
  for i ulong 7
    if ne load_seed i TY_OK
      ret 2
    end
  end
  ob_clr
  ob_txt t_lo_hdr1
  ob_u64 TY_V0_BASELINE_MASK
  ob_txt t_lo_hdr2
  ob_u64 TY_V0_CANDIDATE_MASK
  ob_txt t_lo_hdr3
  ob_flush
  sum = 0.0f64
  for s ulong 7
    if ne loso_one_seed s TY_OK
      ret die_msg t_err_lo
    end
    sum = add sum get g_loso_t s
  end
  mean = div sum 7.0f64
  ss = 0.0f64
  for s ulong 7
    d = sub get g_loso_t s mean
    ss = add ss mul d d
  end
  sd = fsqrt div ss 6.0f64
  margin = mul mul 3.0f64 fsqrt 3.0f64 sd
  mub = f64_ceil_i64 mul margin 1000000.0f64
  ob_clr
  ob_txt t_lo_m1
  ob_f64_fixed mean 3
  ob_txt t_lo_m2
  ob_f64_fixed sd 3
  ob_txt t_bits_nl
  ob_txt t_lo_m3
  ob_f64_fixed margin 3
  ob_txt t_lo_m4
  ob_i64 mub
  ob_b uchar 10
  ob_flush
  ret 0
end

note ---- Held-out fit + gain derivation (shared by heldout and verify) ----

fn verify_and_load_range start ulong cnt ulong to long
  for k ulong cnt bound 10
    idx = add start k
    set_gp_mpath idx
    if ne ty_file_sha256_gp 18 TY_OK
      ret TY_E_IO
    end
    if not dg_eq 18 idx
      ret TY_E_DIGEST
    end
    if ne load_seed idx TY_OK
      ret TY_E_IO
    end
  end
  ret TY_OK
end

fn check_split_no_leak to long
  for i ulong 7
    for j ulong 3
      if dg_eq i add j 7
        ret TY_E_LEAK
      end
    end
  end
  ret TY_OK
end

fn fit_role_slot fi ulong role ulong mask ulong cslot ulong mod_dslot ulong fit_dslot ulong to long
  for i ulong 7
    put g_fit_sids i i
  end
  rc = ty_model_fit 0 7 mask TY_OUT_K TY_FIT_MDL_PRUNE
  if ne rc TY_OK
    ret rc
  end
  rc = ty_model_encode 0 cslot
  if ne rc TY_OK
    ret rc
  end
  nb = get g_mclen cslot
  mbits = get g_mcbits cslot
  ty_model_digest cslot nb mod_dslot
  put g_fr_prof fi 16
  put g_fr_split fi 17
  put g_fr_role fi role
  put g_fr_mask fi mask
  put g_fr_rule fi TY_FIT_MDL_PRUNE
  put g_fr_nf fi 7
  bo = mul fi 12
  for i ulong 7
    put g_fr_fdig add bo i i
  end
  put g_fr_mod fi mod_dslot
  put g_fr_mbits fi mbits
  ret ty_fit_digest fi fit_dslot
end

fn derive_heldout_gain dslot ulong to long
  rc = ty_profile_v0_digest 15 1 16
  if ne rc TY_OK
    ret rc
  end
  setup_default_split
  rc = ty_split_digest 17
  if ne rc TY_OK
    ret rc
  end
  rc = check_split_no_leak
  if ne rc TY_OK
    ret rc
  end
  st_reset_all
  for i ulong 10
    put g_loaded i 0
  end
  rc = verify_and_load_range 0 7
  if ne rc TY_OK
    ret rc
  end
  rc = fit_role_slot 0 TY_ROLE_BASELINE TY_V0_BASELINE_MASK 0 20 22
  if ne rc TY_OK
    ret rc
  end
  put g_ho_bbytes 0 get g_mclen 0
  rc = fit_role_slot 1 TY_ROLE_CANDIDATE TY_V0_CANDIDATE_MASK 1 21 23
  if ne rc TY_OK
    ret rc
  end
  put g_ho_cbytes 0 get g_mclen 1
  rc = ty_model_decode 0 get g_ho_bbytes 0 0
  if ne rc TY_OK
    ret rc
  end
  if or ne get g_md_k 0 TY_OUT_K or ne get g_ty_ret_u 0 get g_fr_mbits 0 ne get g_md_mask 0 TY_V0_BASELINE_MASK
    ret TY_E_PROFILE
  end
  rc = ty_model_decode 1 get g_ho_cbytes 0 1
  if ne rc TY_OK
    ret rc
  end
  if or ne get g_md_k 1 TY_OUT_K or ne get g_ty_ret_u 0 get g_fr_mbits 1 ne get g_md_mask 1 TY_V0_CANDIDATE_MASK
    ret TY_E_PROFILE
  end
  rc = verify_and_load_range 7 3
  if ne rc TY_OK
    ret rc
  end
  ret score_heldout_models dslot
end

fn score_heldout_models dslot ulong to long
  if ne ty_bits_to_ub get g_fr_mbits 0 TY_OK
    ret TY_E_OVERFLOW
  end
  lb_ub = get g_ty_ret_i 0
  if ne ty_bits_to_ub get g_fr_mbits 1 TY_OK
    ret TY_E_OVERFLOW
  end
  lc_ub = get g_ty_ret_i 0
  ld_b = long 0
  ld_c = long 0
  nsym = ulong 0
  for i ulong 3
    sid = add i 7
    if ne ty_model_score 0 sid TY_OK
      ret TY_E_RANGE
    end
    ub_b = get g_ty_ret_i 0
    sn = get g_ty_ret_u 0
    if ne ty_model_score 1 sid TY_OK
      ret TY_E_RANGE
    end
    ub_c = get g_ty_ret_i 0
    if ne ty_add lb_ub ub_b TY_OK
      ret TY_E_OVERFLOW
    end
    fb = get g_ty_ret_i 0
    if ne ty_add lc_ub ub_c TY_OK
      ret TY_E_OVERFLOW
    end
    fc = get g_ty_ret_i 0
    if ne ty_gain fb fc TY_OK
      ret TY_E_OVERFLOW
    end
    put g_gr_ftub i get g_ty_ret_i 0
    put g_gr_fnsym i sn
    if ne ty_add ld_b ub_b TY_OK
      ret TY_E_OVERFLOW
    end
    ld_b = get g_ty_ret_i 0
    if ne ty_add ld_c ub_c TY_OK
      ret TY_E_OVERFLOW
    end
    ld_c = get g_ty_ret_i 0
    nsym = add nsym sn
  end
  ret finish_gain_record ld_b ld_c nsym dslot
end

fn finish_gain_record ld_b long ld_c long nsym ulong dslot ulong to long
  put g_gr_dig 0 16
  put g_gr_dig 1 17
  put g_gr_dig 2 22
  put g_gr_dig 3 23
  put g_gr_dig 4 20
  put g_gr_dig 5 21
  put g_gr_u 0 nsym
  put g_gr_u 1 get g_fr_mbits 0
  put g_gr_u 2 get g_fr_mbits 1
  put g_gr_u 3 3
  put g_gr_i 0 ld_b
  put g_gr_i 1 ld_c
  if ne ty_dl get g_gr_u 1 ld_b TY_OK
    ret TY_E_OVERFLOW
  end
  put g_gr_i 2 get g_ty_ret_i 0
  if ne ty_dl get g_gr_u 2 ld_c TY_OK
    ret TY_E_OVERFLOW
  end
  put g_gr_i 3 get g_ty_ret_i 0
  if ne ty_gain get g_gr_i 2 get g_gr_i 3 TY_OK
    ret TY_E_OVERFLOW
  end
  tub = get g_ty_ret_i 0
  put g_gr_i 4 tub
  qerr = long div add mul mul ulong 2 nsym TY_QERR_MILLI_UB ulong 999 ulong 1000
  put g_gr_i 5 qerr
  put g_gr_i 6 TY_V0_MARGIN_UB
  req = TY_V0_MARGIN_UB
  if lt req 0
    req = 0
  end
  pass = ulong 0
  if gt sub tub qerr req
    pass = 1
  end
  for i ulong 3
    if le sub get g_gr_ftub i qerr 0
      pass = 0
    end
  end
  put g_gr_pass 0 pass
  ret ty_gain_digest dslot
end

note ---- Subcommand: heldout ----

fn ob_kv_dig k view uchar * slot ulong to void
  ob_txt k
  ob_b uchar 61
  ob_dig slot
  ob_b uchar 10
end

fn ob_kv_u64 k view uchar * v ulong to void
  ob_txt k
  ob_b uchar 61
  ob_u64 v
  ob_b uchar 10
end

fn ob_kv_i64 k view uchar * v long to void
  ob_txt k
  ob_b uchar 61
  ob_i64 v
  ob_b uchar 10
end

fn write_receipt_body fd int to void
  ob_set_fd fd
  ob_txt t_rc_hdr
  ob_txt t_pm1
  ob_dig 15
  ob_b uchar 10
  ob_kv_dig t_k_prof 16
  ob_kv_dig t_k_spl 17
  ob_kv_dig t_k_bfit 22
  ob_kv_dig t_k_cfit 23
  ob_kv_dig t_k_bmod 20
  ob_kv_dig t_k_cmod 21
  ob_txt t_pm4
  ob_u64 TY_V0_BASELINE_MASK
  ob_b uchar 10
  ob_txt t_pm5
  ob_u64 TY_V0_CANDIDATE_MASK
  ob_b uchar 10
  ob_kv_u64 t_k_nsym get g_gr_u 0
  ob_kv_u64 t_k_lmb get g_gr_u 1
  ob_kv_u64 t_k_lmc get g_gr_u 2
  ob_kv_i64 t_k_ldb get g_gr_i 0
  ob_kv_i64 t_k_ldc get g_gr_i 1
  ob_kv_i64 t_k_dlb get g_gr_i 2
  ob_kv_i64 t_k_dlc get g_gr_i 3
  ob_kv_i64 t_k_tub get g_gr_i 4
  ob_kv_u64 t_k_nh get g_gr_u 3
  for i ulong 3
    ob_txt t_k_fpre
    ob_pad_dec i 2
    ob_b uchar 61
    ob_u64 get g_gr_fnsym i
    ob_b uchar 32
    ob_i64 get g_gr_ftub i
    ob_b uchar 10
  end
  ob_kv_i64 t_k_qerr get g_gr_i 5
  ob_kv_i64 t_k_marg get g_gr_i 6
  ob_txt t_k_verd
  ob_b uchar 61
  if ne get g_gr_pass 0 0
    ob_txt t_pass_s
  else
    ob_txt t_fail_s
  end
  ob_b uchar 10
  ob_kv_dig t_k_grec 24
  ob_txt t_rc_lad
  ob_flush
end

fn write_receipt_ladder fd int to long
  for i ulong 7
    put g_fit_sids i i
  end
  put g_fs_sc 0 7
  put g_fs_sc 1 8
  put g_fs_sc 2 9
  dlb = get g_gr_i 2
  dl0 = long 0
  for k ulong 14
    mk = rung_mask k
    rc = fit_score_rung k mk eq k 0 7 3
    if ne rc TY_OK
      ret rc
    end
    lm = get g_fs_lm 0
    ld = get g_fs_ld 0
    if ne ty_dl lm ld TY_OK
      ret TY_E_OVERFLOW
    end
    dl = get g_ty_ret_i 0
    if eq k 1
      dl0 = dl
    end
    t0 = long 0
    if ge k 1
      t0 = sub dl0 dl
    end
    ob_set_fd fd
    ob_txt t_lad_p
    n1 = ob_rung_name_raw k
    ob_txt t_lad_1
    ob_u64 mk
    ob_txt t_lad_2
    ob_u64 lm
    ob_txt t_lad_3
    ob_i64 ld
    ob_txt t_lad_4
    ob_i64 dl
    ob_txt t_lad_5
    ob_i64 sub dlb dl
    ob_txt t_lad_6
    ob_i64 t0
    ob_txt t_lad_7
    ob_i64 get g_fs_pf 0
    ob_txt t_lad_8
    ob_i64 get g_fs_pf 1
    ob_txt t_lad_9
    ob_i64 get g_fs_pf 2
    ob_b uchar 10
    ob_flush
  end
  ret TY_OK
end

fn cmd_heldout l4 ulong to int
  rpl = join_a4_suffix l4 t_s_rec
  if eq stat g_pbuf 0 rpl g_stbuf 0 128 0
    ob_set_fd int 2
    ob_txt t_err_pre
    for i ulong rpl bound 1024
      ob_b get g_pbuf i
    end
    ob_txt t_err_ex
    ob_flush
    ret 2
  end
  rc = derive_heldout_gain 24
  if ne rc TY_OK
    ret die_msg t_err_gain
  end
  bpl = join_a4_suffix l4 t_s_bm
  if ne write_mcode_file bpl 0 get g_ho_bbytes 0 TY_OK
    ret die_msg t_err_wb
  end
  cpl = join_a4_suffix l4 t_s_cm
  if ne write_mcode_file cpl 1 get g_ho_cbytes 0 TY_OK
    ret die_msg t_err_wc
  end
  rpl = join_a4_suffix l4 t_s_rec
  fd = fopen g_pbuf 0 rpl int 577 int 420
  if lt fd 0
    ret die_msg t_err_or
  end
  write_receipt_body int fd
  rc = write_receipt_ladder int fd
  dc = fclose int fd
  if ne rc TY_OK
    ret die_msg t_err_lad
  end
  ob_clr
  ob_txt t_ho_p1
  for i ulong rpl bound 1024
    ob_b get g_pbuf i
  end
  ob_b uchar 10
  ob_txt t_ho_p2
  if ne get g_gr_pass 0 0
    ob_txt t_pass_s
  else
    ob_txt t_fail_s
  end
  ob_txt t_ho_p3
  tb = div f64 get g_gr_i 4 1000000.0f64
  ob_f64_fixed tb 3
  ob_txt t_ho_p4
  ns = get g_gr_u 0
  bps = 0.0f64
  if gt ns 0
    bps = div tb f64 ns
  end
  ob_f64_fixed bps 6
  ob_txt t_ho_p5
  ob_u64 ns
  ob_txt t_ho_p6
  ob_flush
  ret 0
end

note ---- Subcommand: verify ----

fn read_receipt_file l4 ulong to long
  fd = fopen g_a4 0 l4 int 0 int 0
  if lt fd 0
    ret TY_E_IO
  end
  tot = ulong 0
  done = false
  while not done bound 256
    if ge tot 65536
      dc = fclose int fd
      ret TY_E_IO
    end
    k = read int fd g_rbuf tot sub 65536 tot
    if lt k 0
      dc = fclose int fd
      ret TY_E_IO
    end
    if eq k 0
      done = true
    else
      tot = add tot ulong k
    end
  end
  dc = fclose int fd
  put g_rlen 0 tot
  ret TY_OK
end

fn kv_copy_val vs ulong le_p ulong to void
  vl = sub le_p vs
  if gt vl 511
    vl = 511
  end
  for j ulong vl bound 512
    put g_vbuf j get g_rbuf add vs j
  end
  put g_vlen 0 vl
end

fn kv_match_line ls ulong le_p ulong key view uchar * to bool
  kl = len key
  if le sub le_p ls kl
    ret false
  end
  if ne get g_rbuf add ls kl uchar 61
    ret false
  end
  for i ulong kl bound 64
    if ne get g_rbuf add ls i get key i
      ret false
    end
  end
  ret true
end

fn kv_find_key key view uchar * to long
  rl = get g_rlen 0
  pos = ulong 0
  while lt pos rl bound 2048
    ls = pos
    while lt pos rl bound 2048
      if eq get g_rbuf pos uchar 10
        break
      end
      pos = add pos 1
    end
    le_p = pos
    if lt pos rl
      pos = add pos 1
    end
    if kv_match_line ls le_p key
      kv_copy_val add add ls len key 1 le_p
      ret TY_OK
    end
  end
  ret TY_E_FORMAT
end

fn kv_find_file_idx idx ulong to long
  fk = new uchar 8 0
  put fk 0 uchar 102
  put fk 1 uchar 105
  put fk 2 uchar 108
  put fk 3 uchar 101
  put fk 4 uchar 46
  put fk 5 uchar add ulong 48 div idx 10
  put fk 6 uchar add ulong 48 rem idx 10
  ret kv_find_key part fk 0 7
end

fn vbuf_parse_dig slot ulong to long
  if lt get g_vlen 0 64
    ret TY_E_FORMAT
  end
  h = new uchar 64 0
  for i ulong 64
    put h i get g_vbuf i
  end
  ret dg_parse_hex h 64 slot
end

fn vbuf_parse_u64 to ulong
  vl = get g_vlen 0
  v = ulong 0
  for i ulong vl bound 32
    b = get g_vbuf i
    if or lt b uchar 48 gt b uchar 57
      break
    end
    v = add mul v 10 ulong sub b uchar 48
  end
  ret v
end

fn vbuf_parse_i64_at off ulong to long
  vl = get g_vlen 0
  i = off
  is_neg = false
  if lt i vl
    if eq get g_vbuf i uchar 45
      is_neg = true
      i = add i 1
    end
  end
  v = long 0
  while lt i vl bound 32
    b = get g_vbuf i
    if or lt b uchar 48 gt b uchar 57
      break
    end
    v = add mul v long 10 long sub b uchar 48
    i = add i 1
  end
  if is_neg
    ret neg v
  end
  ret v
end

fn kv_get_dig k view uchar * slot ulong to long
  rc = kv_find_key k
  if ne rc TY_OK
    ret rc
  end
  ret vbuf_parse_dig slot
end

fn parse_receipt_fields to long
  if ne kv_get_dig t_k_prof 30 TY_OK
    ret TY_E_FORMAT
  end
  if ne kv_get_dig t_k_spl 31 TY_OK
    ret TY_E_FORMAT
  end
  if ne kv_get_dig t_k_bfit 32 TY_OK
    ret TY_E_FORMAT
  end
  if ne kv_get_dig t_k_cfit 33 TY_OK
    ret TY_E_FORMAT
  end
  if ne kv_get_dig t_k_bmod 34 TY_OK
    ret TY_E_FORMAT
  end
  if ne kv_get_dig t_k_cmod 35 TY_OK
    ret TY_E_FORMAT
  end
  if ne kv_get_dig t_k_grec 36 TY_OK
    ret TY_E_FORMAT
  end
  if ne kv_find_key t_k_nsym TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_nsym 0 vbuf_parse_u64
  if ne kv_find_key t_k_lmb TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_lmb 0 vbuf_parse_u64
  if ne kv_find_key t_k_lmc TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_lmc 0 vbuf_parse_u64
  if ne kv_find_key t_k_ldb TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_ldb 0 vbuf_parse_i64_at 0
  if ne kv_find_key t_k_ldc TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_ldc 0 vbuf_parse_i64_at 0
  if ne kv_find_key t_k_dlb TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_dlb 0 vbuf_parse_i64_at 0
  if ne kv_find_key t_k_dlc TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_dlc 0 vbuf_parse_i64_at 0
  if ne kv_find_key t_k_tub TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_tub 0 vbuf_parse_i64_at 0
  if ne kv_find_key t_k_nh TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_nh 0 vbuf_parse_u64
  if ne kv_find_key t_k_qerr TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_qerr 0 vbuf_parse_i64_at 0
  if ne kv_find_key t_k_marg TY_OK
    ret TY_E_FORMAT
  end
  put g_ver_marg 0 vbuf_parse_i64_at 0
  if ne kv_find_key t_k_verd TY_OK
    ret TY_E_FORMAT
  end
  vp = ulong 0
  if eq get g_vlen 0 4
    if eq get g_vbuf 0 uchar 80
      if eq get g_vbuf 1 uchar 65
        if eq get g_vbuf 2 uchar 83
          if eq get g_vbuf 3 uchar 83
            vp = 1
          end
        end
      end
    end
  end
  put g_ver_pass 0 vp
  ret parse_receipt_files
end

fn parse_receipt_files to long
  nh = get g_ver_nh 0
  if gt nh TY_MAX_FILES
    ret TY_E_FORMAT
  end
  for i ulong nh bound 12
    if ne kv_find_file_idx i TY_OK
      ret TY_E_FORMAT
    end
    vl = get g_vlen 0
    sp = ulong 0
    while lt sp vl bound 64
      if eq get g_vbuf sp uchar 32
        break
      end
      sp = add sp 1
    end
    if ge add sp 1 vl
      ret TY_E_FORMAT
    end
    put g_ver_fns i vbuf_parse_u64
    put g_ver_ft i vbuf_parse_i64_at add sp 1
  end
  ret TY_OK
end

fn hash_parsed_receipt dslot ulong to long
  put g_gr_dig 0 30
  put g_gr_dig 1 31
  put g_gr_dig 2 32
  put g_gr_dig 3 33
  put g_gr_dig 4 34
  put g_gr_dig 5 35
  put g_gr_u 0 get g_ver_nsym 0
  put g_gr_u 1 get g_ver_lmb 0
  put g_gr_u 2 get g_ver_lmc 0
  nh = get g_ver_nh 0
  put g_gr_u 3 nh
  put g_gr_i 0 get g_ver_ldb 0
  put g_gr_i 1 get g_ver_ldc 0
  put g_gr_i 2 get g_ver_dlb 0
  put g_gr_i 3 get g_ver_dlc 0
  put g_gr_i 4 get g_ver_tub 0
  put g_gr_i 5 get g_ver_qerr 0
  put g_gr_i 6 get g_ver_marg 0
  put g_gr_pass 0 get g_ver_pass 0
  for i ulong nh bound 12
    put g_gr_fnsym i get g_ver_fns i
    put g_gr_ftub i get g_ver_ft i
  end
  ret ty_gain_digest dslot
end

fn cmd_verify l4 ulong to int
  if ne read_receipt_file l4 TY_OK
    ret die_msg t_err_rec
  end
  if ne parse_receipt_fields TY_OK
    ret die_msg t_err_rec
  end
  if ne hash_parsed_receipt 37 TY_OK
    ret die_msg t_err_rec
  end
  if not dg_eq 37 36
    ob_clr
    ob_txt t_v_f1
    ob_flush
    ret 1
  end
  rc = derive_heldout_gain 38
  if ne rc TY_OK
    ob_clr
    ob_txt t_v_f3
    ob_flush
    ret 1
  end
  if not dg_eq 38 36
    ob_clr
    ob_txt t_v_f2
    ob_flush
    ret 1
  end
  ob_clr
  ob_txt t_v_ok1
  ob_f64_fixed div f64 get g_ver_tub 0 1000000.0f64 3
  ob_txt t_v_ok2
  if ne get g_ver_pass 0 0
    ob_txt t_pass_s
  else
    ob_txt t_fail_s
  end
  ob_b uchar 10
  ob_flush
  ret 0
end

note ---- Entrypoint ----

fn main to int
  ac = argcnt
  if lt ac 4
    r = write 2 t_usage 0 len t_usage
    ret 2
  end
  k1 = argread 1 g_a1 0 64
  k2 = argread 2 g_a2 0 512
  k3 = argread 3 g_a3 0 512
  if or lt k1 0 or lt k2 0 lt k3 0
    ret 2
  end
  l1 = ulong k1
  l2 = ulong k2
  l3 = ulong k3
  if and eq ac 4 a1_eq_txt l1 t_cmd_fix
    ret cmd_fixture l2 l3
  end
  rc = load_manifest l2 l3
  if ne rc TY_OK
    ret die_msg t_err_man
  end
  if a1_eq_txt l1 t_cmd_mchk
    ret cmd_manifest_check
  end
  if a1_eq_txt l1 t_cmd_prof
    ret cmd_profile
  end
  if a1_eq_txt l1 t_cmd_tune
    ret cmd_tune
  end
  if a1_eq_txt l1 t_cmd_loso
    ret cmd_loso
  end
  if and eq ac 5 a1_eq_txt l1 t_cmd_held
    k4 = argread 4 g_a4 0 512
    if lt k4 0
      ret 2
    end
    ret cmd_heldout ulong k4
  end
  if and eq ac 5 a1_eq_txt l1 t_cmd_ver
    k4 = argread 4 g_a4 0 512
    if lt k4 0
      ret 2
    end
    ret cmd_verify ulong k4
  end
  r2 = write 2 t_err_unk 0 len t_err_unk
  ret 2
end

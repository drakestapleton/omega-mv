note
note tools/turing_yield.om -- Pure seeded OM-2 Turing Yield TY-2 driver
note Composed with src/turing/ty_core_lib.om.
note Supports: fixture, manifest-check, profile, tune, loso, heldout, verify.

text t_cmd_fix "fixture"
text t_cmd_prof "profile"
text t_cmd_mchk "manifest-check"
text t_cmd_tune "tune"
text t_cmd_loso "loso"
text t_usage "usage: turing-yield manifest-check|profile|tune|loso|fixture ...\n"

text t_r0 "uniform"
text t_r1 "order-0"
text t_r2 "order-1"
text t_r3 "op-only"
text t_r4 "op+prev1"
text t_r5 "op+prev1..2"
text t_r6 "op+prev1..3"
text t_r7 "op+prev1..4"
text t_r8 "op+prev1..5"
text t_r9 "op+depth+prev1"
text t_r10 "op+depth+prev1..2"
text t_r11 "op+depth+prev1..3"
text t_r12 "op+depth+prev1..4"
text t_r13 "op+depth+prev1..5"
text t_r14 "memorizer"

text t_ff1 "fixture fit "
text t_ff2 " events "
text t_ff3 " crumbs; held "
text t_ff4 " crumbs\n"
text t_fl1 " rows="
text t_fl2 " lm_bits="
text t_fl3 " ld_fit_ub="
text t_fl4 " ld_held_ub="
text t_fl5 " model="
text t_pm1 "manifest_sha256="
text t_pm2 "profile="
text t_pm3 "split="
text t_pm4 "baseline_mask="
text t_pm5 "candidate_mask="
text t_pm6 "margin_ub="
text t_ok_p "OK   "
text t_fl_p "FAIL "
text t_recs " records="

global g_a1 uchar 64
global g_a2 uchar 512
global g_a3 uchar 512
global g_obuf uchar 4096
global g_olen ulong 1
global g_mbuf uchar 16384
global g_m_rel uchar 2560
global g_m_rlen ulong 10
global g_m_path uchar 5120
global g_m_plen ulong 10
global g_m_sz ulong 10

fn ob_clr to void
  put g_olen 0 0
end

fn ob_b c uchar to void
  n = get g_olen 0
  if lt n 4096
    put g_obuf n c
    put g_olen 0 add n 1
  end
end

fn ob_txt s view uchar * to void
  n = len s
  for i ulong n bound 256
    ob_b get s i
  end
end

fn ob_u64 v ulong to void
  tv_clr
  tv_u64 v
  n = get g_tvl 0
  for i ulong n bound 32
    ob_b get g_tv i
  end
end

fn ob_i64 v long to void
  tv_clr
  tv_i64 v
  n = get g_tvl 0
  for i ulong n bound 32
    ob_b get g_tv i
  end
end

fn ob_dig slot ulong to void
  tv_clr
  tv_dig slot
  for i ulong 64
    ob_b get g_tv i
  end
end

fn ob_flush to void
  n = get g_olen 0
  if gt n 0
    w = write 1 g_obuf 0 n
    put g_olen 0 0
  end
end

fn a1_eq_txt alen ulong t view uchar * to bool
  if ne alen len t
    ret false
  end
  for i ulong alen bound 64
    if ne get g_a1 i get t i
      ret false
    end
  end
  ret true
end

fn ob_rung_name k ulong to void
  n = ulong 0
  if eq k 0
    ob_txt t_r0
    n = len t_r0
  end
  if eq k 1
    ob_txt t_r1
    n = len t_r1
  end
  if eq k 2
    ob_txt t_r2
    n = len t_r2
  end
  if eq k 3
    ob_txt t_r3
    n = len t_r3
  end
  if eq k 4
    ob_txt t_r4
    n = len t_r4
  end
  if eq k 5
    ob_txt t_r5
    n = len t_r5
  end
  if eq k 6
    ob_txt t_r6
    n = len t_r6
  end
  if eq k 7
    ob_txt t_r7
    n = len t_r7
  end
  if eq k 8
    ob_txt t_r8
    n = len t_r8
  end
  if eq k 9
    ob_txt t_r9
    n = len t_r9
  end
  if eq k 10
    ob_txt t_r10
    n = len t_r10
  end
  if eq k 11
    ob_txt t_r11
    n = len t_r11
  end
  if eq k 12
    ob_txt t_r12
    n = len t_r12
  end
  if eq k 13
    ob_txt t_r13
    n = len t_r13
  end
  if eq k 14
    ob_txt t_r14
    n = len t_r14
  end
  while lt n 28 bound 32
    ob_b uchar 32
    n = add n 1
  end
end

fn rung_mask k ulong to ulong
  if eq k 2
    ret TY_F_PREV1
  end
  if eq k 3
    ret TY_F_OP
  end
  if eq k 4
    ret or TY_F_OP TY_F_PREV1
  end
  if eq k 5
    ret or or TY_F_OP TY_F_PREV1 TY_F_PREV2
  end
  if eq k 6
    ret or or or TY_F_OP TY_F_PREV1 TY_F_PREV2 TY_F_PREV3
  end
  if eq k 7
    ret or or or or TY_F_OP TY_F_PREV1 TY_F_PREV2 TY_F_PREV3 TY_F_PREV4
  end
  if eq k 8
    ret or or or or or TY_F_OP TY_F_PREV1 TY_F_PREV2 TY_F_PREV3 TY_F_PREV4 TY_F_PREV5
  end
  if eq k 9
    ret or or TY_F_OP TY_F_DEPTH TY_F_PREV1
  end
  if eq k 10
    ret or or or TY_F_OP TY_F_DEPTH TY_F_PREV1 TY_F_PREV2
  end
  if eq k 11
    ret or or or or TY_F_OP TY_F_DEPTH TY_F_PREV1 TY_F_PREV2 TY_F_PREV3
  end
  if eq k 12
    ret or or or or or TY_F_OP TY_F_DEPTH TY_F_PREV1 TY_F_PREV2 TY_F_PREV3 TY_F_PREV4
  end
  if eq k 13
    ret or or or or or or TY_F_OP TY_F_DEPTH TY_F_PREV1 TY_F_PREV2 TY_F_PREV3 TY_F_PREV4 TY_F_PREV5
  end
  if eq k 14
    ret TY_F_POS
  end
  ret 0
end

fn cmd_fixture l2 ulong l3 ulong to int
  st_reset_all
  st_begin 0
  for i ulong l2 bound 512
    put g_path i get g_a2 i
  end
  put g_plen 0 l2
  if lt ty_ctr1_read_gp 0 0
    ret 2
  end
  st_begin 1
  for i ulong l3 bound 512
    put g_path i get g_a3 i
  end
  put g_plen 0 l3
  if lt ty_ctr1_read_gp 1 0
    ret 2
  end
  ob_clr
  ob_txt t_ff1
  ob_u64 get g_st_n 0
  ob_txt t_ff2
  ob_u64 get g_st_ncr 0
  ob_txt t_ff3
  ob_u64 get g_st_n 1
  ob_txt t_ff2
  ob_u64 get g_st_ncr 1
  ob_txt t_ff4
  ob_flush
  put g_fit_sids 0 0
  for k ulong 15
    rc = TY_OK
    if eq k 0
      rc = ty_model_uniform 0 TY_OUT_K
    else
      rule = TY_FIT_MDL_PRUNE
      if eq k 14
        rule = TY_FIT_KEEP_ALL
      end
      rc = ty_model_fit 0 1 rung_mask k TY_OUT_K rule
    end
    if ne rc TY_OK
      ret 2
    end
    rc = ty_model_encode 0 0
    if ne rc TY_OK
      ret 2
    end
    nb = get g_mclen 0
    lm = get g_mcbits 0
    rc = ty_model_score 0 0
    if ne rc TY_OK
      ret 2
    end
    in_ub = get g_ty_ret_i 0
    rc = ty_model_score 0 1
    if ne rc TY_OK
      ret 2
    end
    out_ub = get g_ty_ret_i 0
    ty_model_digest 0 nb 0
    ob_clr
    ob_rung_name k
    ob_txt t_fl1
    ob_u64 get g_md_nr 0
    ob_txt t_fl2
    ob_u64 lm
    ob_txt t_fl3
    ob_i64 in_ub
    ob_txt t_fl4
    ob_i64 out_ub
    ob_txt t_fl5
    ob_dig 0
    ob_b uchar 10
    ob_flush
  end
  ret 0
end

fn store_manifest_paths p ulong rlen ulong n ulong rl ulong to void
  ro = mul n 256
  for i ulong rlen bound 256
    put g_m_rel add ro i get g_mbuf add p i
  end
  put g_m_rlen n rlen
  po = mul n 512
  for i ulong rl bound 512
    put g_m_path add po i get g_a3 i
  end
  put g_m_path add po rl uchar 47
  po1 = add add po rl 1
  for i ulong rlen bound 256
    put g_m_path add po1 i get g_m_rel add ro i
  end
  put g_m_plen n add add rl 1 rlen
end

fn parse_manifest_line ls ulong le_p ulong n ulong rl ulong to long
  h = new uchar 64 0
  if lt sub le_p ls 66
    ret TY_E_FORMAT
  end
  for i ulong 64
    put h i get g_mbuf add ls i
  end
  if ne dg_parse_hex h 64 n TY_OK
    ret TY_E_FORMAT
  end
  p = add ls 64
  while lt p le_p bound 16
    if ne get g_mbuf p uchar 32
      break
    end
    p = add p 1
  end
  sz = ulong 0
  while lt p le_p bound 32
    b = get g_mbuf p
    if or lt b uchar 48 gt b uchar 57
      break
    end
    sz = add mul sz 10 ulong sub b uchar 48
    p = add p 1
  end
  put g_m_sz n sz
  while lt p le_p bound 16
    if ne get g_mbuf p uchar 32
      break
    end
    p = add p 1
  end
  rlen = sub le_p p
  if or eq rlen 0 gt rlen 255
    ret TY_E_FORMAT
  end
  store_manifest_paths p rlen n rl
  ret TY_OK
end

fn load_manifest ml ulong rl ulong to long
  fd = fopen g_a2 0 ml int 0 int 0
  if lt fd 0
    ret TY_E_IO
  end
  k = read int fd g_mbuf 0 16384
  dc = fclose int fd
  if le k 0
    ret TY_E_IO
  end
  blen = ulong k
  pos = ulong 0
  n = ulong 0
  while and lt pos blen lt n 10 bound 200
    ls = pos
    while lt pos blen bound 2000
      if eq get g_mbuf pos uchar 10
        break
      end
      pos = add pos 1
    end
    le_p = pos
    if lt pos blen
      pos = add pos 1
    end
    if eq ls le_p
      continue
    end
    if eq get g_mbuf ls uchar 35
      continue
    end
    rc = parse_manifest_line ls le_p n rl
    if ne rc TY_OK
      ret rc
    end
    n = add n 1
  end
  if ne n 10
    ret TY_E_FORMAT
  end
  for i ulong ml bound 512
    put g_path i get g_a2 i
  end
  put g_plen 0 ml
  ret ty_file_sha256_gp 15
end

fn cmd_profile to int
  rc = ty_profile_v0_digest 15 1 16
  put g_sp_nf 0 7
  put g_sp_nh 0 3
  for i ulong 7
    put g_sp_fdig i i
    ro = mul i 256
    rl = get g_m_rlen i
    if gt rl 63
      rl = 63
    end
    lo = mul i 64
    for j ulong rl bound 64
      put g_sp_flbl add lo j get g_m_rel add ro j
    end
    put g_sp_flen i rl
  end
  for i ulong 3
    si = add i 7
    put g_sp_hdig i si
    ro = mul si 256
    rl = get g_m_rlen si
    if gt rl 63
      rl = 63
    end
    lo = mul i 64
    for j ulong rl bound 64
      put g_sp_hlbl add lo j get g_m_rel add ro j
    end
    put g_sp_hlen i rl
  end
  rc = ty_split_digest 17
  ob_clr
  ob_txt t_pm1
  ob_dig 15
  ob_b uchar 10
  ob_txt t_pm2
  ob_dig 16
  ob_b uchar 10
  ob_txt t_pm3
  ob_dig 17
  ob_b uchar 10
  ob_txt t_pm4
  ob_u64 TY_V0_BASELINE_MASK
  ob_b uchar 10
  ob_txt t_pm5
  ob_u64 TY_V0_CANDIDATE_MASK
  ob_b uchar 10
  ob_txt t_pm6
  ob_i64 TY_V0_MARGIN_UB
  ob_b uchar 10
  ob_flush
  ret 0
end

fn main to int
  ac = argcnt
  if lt ac 4
    r = write 2 t_usage 0 len t_usage
    ret 2
  end
  k1 = argread 1 g_a1 0 64
  k2 = argread 2 g_a2 0 512
  k3 = argread 3 g_a3 0 512
  if or lt k1 0 or lt k2 0 lt k3 0
    ret 2
  end
  l1 = ulong k1
  l2 = ulong k2
  l3 = ulong k3
  if and eq ac 4 a1_eq_txt l1 t_cmd_fix
    ret cmd_fixture l2 l3
  end
  rc = load_manifest l2 l3
  if ne rc TY_OK
    ret 2
  end
  if a1_eq_txt l1 t_cmd_prof
    ret cmd_profile
  end
  ret 2
end

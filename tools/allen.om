text at_p_seed2 " record "
text at_p_seed3 " lineage "
text at_p_lin1 "ALLEN lineage "
text at_p_lin2 " records "
text at_p_unb "ALLEN lineage unbound (journal has no record)\n"
text at_p_prb1 "ALLEN probe journal_records "
text at_p_prb2 " goals_in_world "
text at_p_prb3 " goal_seq "
text at_p_prb4 " assessment_goal_seq "

text at_err_pfx "allen: refused: "
text at_e_unb "subject has no Cortex lineage binding\n"
text at_e_empty "Cortex journal holds no genesis record\n"
text at_e_mis "Cortex lineage mismatch: this journal is not the subject's memory\n"
text at_e_jopen "allen: cannot open journal\n"
text at_e_jchain "allen: journal chain does not verify\n"
text at_e_write "allen: cannot write output file\n"
text at_e_01 "truncated object\n"
text at_e_02 "bad magic\n"
text at_e_03 "unsupported continuity format version\n"
text at_e_04 "nonzero header reserved\n"
text at_e_05 "body length mismatch\n"
text at_e_06 "nonzero reserved bytes\n"
text at_e_07 "too many standing intents\n"
text at_e_08 "too many knowledge references\n"
text at_e_09 "trailing bytes\n"
text at_e_10 "zero root id\n"
text at_e_11 "zero agent id\n"
text at_e_12 "zero sequence\n"
text at_e_13 "genesis subject names a previous object\n"
text at_e_14 "subject object after the first has no previous\n"
text at_e_15 "zero provenance\n"
text at_e_16 "unknown subject origin\n"
text at_e_17 "intents not strictly ascending by id\n"
text at_e_18 "unknown intent state\n"
text at_e_19 "unknown intent kind\n"
text at_e_20 "intent created outside the subject chain\n"
text at_e_21 "intent id does not derive from its content\n"
text at_e_22 "intent supersedes itself\n"
text at_e_23 "superseded intent is absent\n"
text at_e_24 "superseded intent is not marked superseded\n"
text at_e_25 "intent supersedes a newer intent\n"
text at_e_26 "two active intents in one slot\n"
text at_e_27 "superseded intent not named by exactly one successor\n"
text at_e_28 "zero knowledge digest\n"
text at_e_29 "knowledge not strictly ascending by digest\n"
text at_e_30 "knowledge held outside the subject chain\n"
text at_e_31 "cannot open subject file\n"
text at_e_32 "continuity object exceeds the 16384-byte sealed Store cap\n"
text at_e_unk "decode failed\n"

global g_at_path uchar 256
global g_at_plen ulong 1
global g_at_jpath uchar 256
global g_at_jlen ulong 1
global g_at_model uchar 32
global g_at_pub_st ulong 4

fn at_put_fd fd int s view uchar * to void
  ign = write fd s 0 len s
end

fn at_put_str s view uchar * to void
  ign = write 1 s 0 len s
end

fn at_put_bytes s view uchar * n ulong to void
  ign = write 1 s 0 n
end

fn at_put_u64 v ulong to void
  db = new uchar 24 0
  rev = new uchar 24 0
  if eq v 0
    put db 0 48
    ign = write 1 db 0 1
    ret
  end
  cur = v
  n = ulong 0
  while gt cur 0 bound 24
    put db n uchar add 48 rem cur 10
    cur = div cur 10
    n = add n 1
  end
  for i ulong n bound 24
    put rev i get db sub sub n 1 i
  end
  ign = write 1 rev 0 n
end

fn at_put_nl to void
  nl = new uchar 1 0
  put nl 0 10
  ign = write 1 nl 0 1
end

fn at_put_hex32 b view uchar 32 to void
  h = new uchar 64 0
  allen_hex b h
  ign = write 1 h 0 64
end

fn at_put_hex64_be v ulong to void
  raw = new uchar 8 0
  h = new uchar 16 0
  for i ulong 8
    sh = mul sub 7 i 8
    put raw i uchar and shr v sh 255
  end
  allen_hex raw h
  ign = write 1 h 0 16
end

fn at_print_err_code code ulong to void
  at_put_fd 2 at_err_pfx
  if eq code 1
    at_put_fd 2 at_e_01
    ret
  end
  if eq code 2
    at_put_fd 2 at_e_02
    ret
  end
  if eq code 3
    at_put_fd 2 at_e_03
    ret
  end
  if eq code 4
    at_put_fd 2 at_e_04
    ret
  end
  if eq code 5
    at_put_fd 2 at_e_05
    ret
  end
  if eq code 6
    at_put_fd 2 at_e_06
    ret
  end
  if eq code 7
    at_put_fd 2 at_e_07
    ret
  end
  if eq code 8
    at_put_fd 2 at_e_08
    ret
  end
  if eq code 9
    at_put_fd 2 at_e_09
    ret
  end
  if eq code 10
    at_put_fd 2 at_e_10
    ret
  end
  if eq code 11
    at_put_fd 2 at_e_11
    ret
  end
  if eq code 12
    at_put_fd 2 at_e_12
    ret
  end
  if eq code 13
    at_put_fd 2 at_e_13
    ret
  end
  if eq code 14
    at_put_fd 2 at_e_14
    ret
  end
  if eq code 15
    at_put_fd 2 at_e_15
    ret
  end
  if eq code 16
    at_put_fd 2 at_e_16
    ret
  end
  if eq code 17
    at_put_fd 2 at_e_17
    ret
  end
  if eq code 18
    at_put_fd 2 at_e_18
    ret
  end
  if eq code 19
    at_put_fd 2 at_e_19
    ret
  end
  if eq code 20
    at_put_fd 2 at_e_20
    ret
  end
  if eq code 21
    at_put_fd 2 at_e_21
    ret
  end
  if eq code 22
    at_put_fd 2 at_e_22
    ret
  end
  if eq code 23
    at_put_fd 2 at_e_23
    ret
  end
  if eq code 24
    at_put_fd 2 at_e_24
    ret
  end
  if eq code 25
    at_put_fd 2 at_e_25
    ret
  end
  if eq code 26
    at_put_fd 2 at_e_26
    ret
  end
  if eq code 27
    at_put_fd 2 at_e_27

  if eq code 31
    at_put_fd 2 at_e_31
    ret
  end
  if eq code 32
    at_put_fd 2 at_e_32
    ret
  end
  at_put_fd 2 at_e_unk
end

fn at_arg_eq idx ulong lit view uchar * to bool
  tmp = new uchar 256 0
  got = argread idx tmp 0 255
  if ne got long len lit
    ret false
  end
  for i ulong len lit bound 255
    if ne get tmp i get lit i
      ret false
    end
  end
  ret true
end

fn at_parse_u64 s view uchar * start ulong slen ulong to ulong
  v = ulong 0
  for i ulong slen bound 24
    c = ulong get s add start i
    if or lt c 48 gt c 57
      ret v
    end
    v = add mul v 10 sub c 48
  end
  ret v
end

note Load Cortex journal file into cx_mj_buf[0..] and open store 0 via rx_cortex.om.
fn at_cx_sync_lineage to void
  cnt = get cx_meta 0
  put g_al_cx_n 0 cnt
  if eq cnt 0
    for i ulong 32
      put g_al_cx_gen_dig i 0
    end
    ret
  end
  for i ulong 32
    put g_al_cx_gen_dig i get cx_digs i
  end
end

fn at_cx_open_file path view uchar * plen ulong flags ulong to long
  for i ulong 8
    put cx_mj_meta i 0
  end
  put g_al_cx_n 0 0
  for i ulong 32
    put g_al_cx_gen_dig i 0
  end
  if or eq plen 0 gt plen 255
    ret -1
  end
  fd = fopen path 0 plen 0 0
  if ge fd 0
    total = ulong 0
    for chunk ulong 1024
      rem_cap = sub CX_MJ_CAP total
      if eq rem_cap 0
        break
      end
      got = read int fd cx_mj_buf total rem_cap
      if le got 0
        break
      end
      total = add total ulong got
    end
    ign = fclose int fd
    put cx_mj_meta 0 total
  else
    if ne and flags CX_OPEN_READONLY 0
      ret -1
    end
  end
  rc = cx_open_with 0 0 AT_JOURNAL_SUBJECTS flags
  if ne rc CX_OK
    ret -1
  end
  at_cx_sync_lineage
  ret 0
end

fn at_cx_save_file path view uchar * plen ulong to long
  if or eq plen 0 gt plen 255
    ret -1
  end
  jlen = get cx_mj_meta 0
  fd = fopen path 0 plen 577 420
  if lt fd 0
    ret -1
  end
  off = ulong 0
  for chunk ulong 1024
    if ge off jlen
      break
    end
    rem_b = sub jlen off
    w = write int fd cx_mj_buf off rem_b
    if le w 0
      ign = fclose int fd
      ret -1
    end
    off = add off ulong w
  end
  ign = fclose int fd
  if ne off jlen
    ret -1
  end
  ret 0
end

fn at_print_subject to void
  b = new uchar 32 0
  for i ulong 32
    put b i get g_al_subj_id i
  end
  at_put_str at_p_subj
  at_put_hex32 b
  at_put_nl
  for i ulong 32
    put b i get g_al_agent i
  end
  at_put_str at_p_agent
  at_put_hex32 b
  at_put_nl
  for i ulong 32
    put b i get g_al_root i
  end
  at_put_str at_p_root
  at_put_hex32 b
  at_put_nl
  for i ulong 32
    put b i get g_al_prev i
  end
  at_put_str at_p_chain1
  at_put_u64 get g_al_seq 0
  at_put_str at_p_chain2
  at_put_hex32 b
  at_put_nl
  for i ulong 32
    put b i get g_al_cortex i
  end
  at_put_str at_p_cortex
  at_put_hex32 b
  at_put_nl
  for i ulong 32
    put b i get g_al_prov i
  end
  at_put_str at_p_prov1
  at_put_hex32 b
  at_put_str at_p_prov2
  at_put_u64 get g_al_origin 0
  at_put_nl
  ni = get g_al_n_intents 0
  nk = get g_al_n_knowledge 0
  at_put_str at_p_cnt1
  at_put_u64 ni
  at_put_str at_p_cnt2
  at_put_u64 nk
  at_put_nl
  for i ulong ni bound 64
    base = mul i 32
    for k ulong 32
      put b k get g_al_in_id add base k
    end
    at_put_str at_p_in1
    at_put_hex32 b
    at_put_str at_p_in2
    at_put_u64 get g_al_in_kind i
    at_put_str at_p_in3
    at_put_u64 get g_al_in_state i
    at_put_str at_p_in4
    at_put_u64 get g_al_in_since i
    at_put_str at_p_in5
    at_put_u64 get g_al_in_p0 i
    at_put_str at_p_in6
    at_put_u64 get g_al_in_p1 i
    at_put_nl
  end
  for i ulong nk bound 64
    base = mul i 32
    for k ulong 32
      put b k get g_al_kn_dig add base k
    end
    at_put_str at_p_kn1
    at_put_hex32 b
    at_put_str at_p_kn2
    at_put_u64 get g_al_kn_rec i
    at_put_str at_p_in4
    at_put_u64 get g_al_kn_since i
    at_put_nl
  end
end

fn at_verb_seed ac ulong to int
  jp = new uchar 256 0
  tb = new uchar 24 0
  hdr = new ulong 12 0
  pay = new ulong 2 0
  ref = new uchar 32 0
  if or lt ac 3 gt ac 4
    at_put_fd 2 at_usage
    ret 2
  end
  jlr = argread 2 jp 0 255
  if le jlr 0
    ret 2
  end
  jl = ulong jlr
  tag = ulong 0
  if eq ac 4
    tlr = argread 3 tb 0 24
    if lt tlr 0
      ret 2
    end
    tag = at_parse_u64 tb 0 ulong tlr
  end
  if ne at_cx_open_file jp jl CX_OPEN_SYNC 0
    at_put_fd 2 at_e_jopen
    ret 3
  end
  if ne get cx_meta 0 0
    ret 3
  end
  put hdr 0 CX_OBSERVATION
  put hdr 1 CX_K_WORK_ACCEPTED
  put hdr 2 1
  put hdr 3 1
  put hdr 4 1
  put pay 0 1397048644
  put pay 1 tag
  if ne cx_append 0 hdr pay 2 CX_OK
    ret 3
  end
  if ne at_cx_save_file jp jl 0
    ret 3
  end
  at_cx_sync_lineage
  ign = allen_lineage ref
  at_put_str at_p_seed1
  at_put_bytes jp jl
  at_put_str at_p_seed2
  at_put_u64 get cx_meta 0
  at_put_str at_p_seed3
  at_put_hex32 ref
  at_put_nl
  ret 0
end

fn at_verb_lineage to int
  jp = new uchar 256 0
  ref = new uchar 32 0
  jlr = argread 2 jp 0 255
  if le jlr 0
    ret 2
  end
  if ne at_cx_open_file jp ulong jlr CX_OPEN_READONLY 0
    at_put_fd 2 at_e_jopen
    ret 3
  end
  if ne allen_lineage ref 0
    at_put_str at_p_unb
    ret 0
  end
  at_put_str at_p_lin1
  at_put_hex32 ref
  at_put_str at_p_lin2
  at_put_u64 get cx_meta 0
  at_put_nl
  ret 0
end

fn at_verb_inspect digest_only ulong to int
  fp = new uchar 256 0
  id = new uchar 32 0
  plr = argread 2 fp 0 255
  if le plr 0
    ret 2
  end
  if ne allen_load fp ulong plr 0
    at_print_err_code get g_al_err 0
    ret 3
  end
  if ne digest_only 0
    for i ulong 32
      put id i get g_al_subj_id i
    end
    at_put_hex32 id
    at_put_nl
    ret 0
  end
  at_print_subject
  ret 0
end

fn at_parse_intent_arg idx ulong to long
  ib = new uchar 64 0
  ilr = argread idx ib 0 64
  if le ilr 0
    ret -1
  end
  il = ulong ilr
  comma = ulong il
  for i ulong il bound 64
    if and eq comma il eq get ib i 44
      comma = i
    end
  end
  if or eq comma il ge add comma 1 il
    ret -1
  end
  r = at_parse_u64 ib 0 comma
  t = at_parse_u64 ib add comma 1 sub sub il comma 1
  ret al_subject_add_intent CS_INTENT_GOAL_LATENCY r t
end

fn at_read_hex32_arg idx ulong dst_kind ulong to long
  hx = new uchar 64 0
  raw = new uchar 32 0
  got = argread idx hx 0 64
  if ne got 64
    ret -1
  end
  if ne allen_unhex hx raw 0
    ret -1
  end
  for k ulong 32
    if eq dst_kind 0
      put g_al_agent k get raw k
    end
    if eq dst_kind 1
      put g_al_root k get raw k
    end
    if eq dst_kind 2
      put g_al_prov k get raw k
    end
    if eq dst_kind 3
      put g_at_model k get raw k
    end
  end
  ret 0
end

fn at_read_path_arg idx ulong is_j ulong to long
  pb = new uchar 256 0
  plr = argread idx pb 0 255
  if le plr 0
    ret -1
  end
  pl = ulong plr
  for k ulong pl bound 255
    if eq is_j 0
      put g_at_path k get pb k
    else
      put g_at_jpath k get pb k
    end
  end
  if eq is_j 0
    put g_at_plen 0 pl
  else
    put g_at_jlen 0 pl
  end
  ret 0
end

fn at_write_subject_file to long
  op = new uchar 256 0
  pl = get g_at_plen 0
  for k ulong pl bound 255
    put op k get g_at_path k
  end
  fd = fopen op 0 pl 577 420
  if lt fd 0
    ret -1
  end
  bl = get g_al_buf_len 0
  off = ulong 0
  for chunk ulong 64
    if ge off bl
      break
    end
    rem_b = sub bl off
    w = write int fd g_al_buf off rem_b
    if le w 0
      ign = fclose int fd
      ret -1
    end
    off = add off ulong w
  end
  ign = fclose int fd
  if ne off bl
    ret -1
  end
  ret 0
end

fn at_bind_cortex_from_jpath to long
  jp = new uchar 256 0
  ref = new uchar 32 0
  jl = get g_at_jlen 0
  for k ulong jl bound 255
    put jp k get g_at_jpath k
  end
  if ne at_cx_open_file jp jl CX_OPEN_READONLY 0
    ret -1
  end
  if eq allen_lineage ref 0
    for k ulong 32
      put g_al_cortex k get ref k
    end
  end
  ret 0
end

fn at_verb_make ac ulong to int
  al_subject_reset
  have_out = ulong 0
  have_agent = ulong 0
  have_root = ulong 0
  have_j = ulong 0
  i = ulong 2
  while lt i ac bound 128
    if and at_arg_eq i at_f_o lt add i 1 ac
      i = add i 1
      if ne at_read_path_arg i 0 0
        ret 2
      end
      have_out = 1
    else
      if and at_arg_eq i at_f_agent lt add i 1 ac
        i = add i 1
        if ne at_read_hex32_arg i 0 0
          ret 2
        end
        have_agent = 1
      else
        if and at_arg_eq i at_f_root lt add i 1 ac
          i = add i 1
          if ne at_read_hex32_arg i 1 0
            ret 2
          end
          have_root = 1
        else
          if and at_arg_eq i at_f_prov lt add i 1 ac
            i = add i 1
            if ne at_read_hex32_arg i 2 0
              ret 2
            end
          else
            if and at_arg_eq i at_f_cortex lt add i 1 ac
              i = add i 1
              if ne at_read_path_arg i 1 0
                ret 2
              end
              have_j = 1
            else
              if and at_arg_eq i at_f_intent lt add i 1 ac
                i = add i 1
              else
                at_put_fd 2 at_usage
                ret 2
              end
            end
          end
        end
      end
    end
    i = add i 1
  end
  if or eq have_out 0 or eq have_agent 0 eq have_root 0
    at_put_fd 2 at_usage
    ret 2
  end
  note Second pass for --intent now that agent is loaded
  i = ulong 2
  while lt i ac bound 128
    if and at_arg_eq i at_f_intent lt add i 1 ac
      i = add i 1
      if ne at_parse_intent_arg i 0
        at_print_err_code get g_al_err 0
        ret 3
      end
    end
    i = add i 1
  end
  if ne have_j 0
    if ne at_bind_cortex_from_jpath 0
      at_put_fd 2 at_e_jopen
      ret 3
    end
  end
  if ne al_subject_encode 0
    at_print_err_code get g_al_err 0
    ret 3
  end
  if ne at_write_subject_file 0
    at_put_fd 2 at_e_write
    ret 4
  end
  at_print_subject
  ret 0
end

fn at_cx_record_crumb subj ulong cls ulong kind ulong seq ulong v0 ulong v1 ulong to void
  hdr = new ulong 12 0
  pay = new ulong 3 0
  put hdr 0 cls
  put hdr 1 kind
  put hdr 2 subj
  put hdr 3 add get cx_meta 0 1
  put hdr 4 1
  put pay 0 seq
  put pay 1 v0
  put pay 2 v1
  ign = cx_append 0 hdr pay 3
end

fn at_print_pub_hdr jp view uchar * jl ulong have_model ulong to void
  tmp32 = new uchar 32 0
  allen_bind_identity AT_SUBJ_EXTERNAL
  at_print_subject
  for k ulong 32
    put tmp32 k get g_al_bind_agent k
  end
  at_put_str at_p_bind1
  at_put_hex32 tmp32
  at_put_str at_p_bind2
  at_put_u64 get g_al_bind_seq 0
  at_put_nl
  for k ulong 32
    put tmp32 k get g_al_cortex k
  end
  at_put_str at_p_mem1
  at_put_hex32 tmp32
  at_put_str at_p_mem2
  at_put_bytes jp jl
  at_put_nl
  if ne have_model 0
    for k ulong 32
      put tmp32 k get g_at_model k
    end
    at_put_str at_p_mod1
    at_put_hex32 tmp32
    at_put_str at_p_mod2
  else
    at_put_str at_p_modn
  end
end

fn at_publish_one_intent idx ulong to void
  iid = new uchar 32 0
  next_seq = add get ai_goal 0 1
  nm = allen_goal_mutations idx 1 next_seq
  if eq nm 0
    ret
  end
  put ai_goal 0 get g_al_mut_val 0
  put ai_goal 1 get g_al_mut_val 1
  put ai_goal 2 get g_al_mut_val 2
  put ai_goal 3 get g_al_mut_val 3
  cr = add get g_at_pub_st 1 1
  put g_at_pub_st 1 cr
  at_cx_record_crumb AT_SUBJ_EXTERNAL CX_OBSERVATION CX_K_EXEC_COMMIT next_seq get ai_goal 1 get ai_goal 2
  base = mul idx 32
  for k ulong 32
    put iid k get g_al_in_id add base k
  end
  at_put_str at_p_pub
  at_put_hex32 iid
  at_put_str at_p_ext
  at_put_u64 cr
  at_put_nl
  put g_at_pub_st 0 add get g_at_pub_st 0 1
  put g_at_pub_st 3 0
  arc = rx_aien_assess
  if ne arc 0
    put g_at_pub_st 2 add get g_at_pub_st 2 1
    put g_at_pub_st 3 1
    cr2 = add get g_at_pub_st 1 1
    put g_at_pub_st 1 cr2
    at_cx_record_crumb AT_SUBJ_AIEN CX_EXECUTION CX_K_EXEC_COMMIT get ai_assess 0 get ai_assess 4 cr2
  end
end

fn at_print_pub_summary to void
  goals_w = ulong 0
  if ne get ai_goal 0 0
    goals_w = 1
  end
  at_put_str at_p_goal1
  at_put_u64 get ai_goal 0
  at_put_str at_p_goal2
  at_put_u64 get ai_goal 1
  at_put_str at_p_goal3
  at_put_u64 get ai_goal 2
  at_put_str at_p_goal4
  at_put_hex64_be get ai_goal 3
  at_put_nl
  at_put_str at_p_aien1
  at_put_u64 get g_at_pub_st 2
  at_put_str at_p_aien2
  at_put_u64 get g_at_pub_st 3
  at_put_str at_p_aien3
  at_put_u64 get ai_assess 0
  at_put_str at_p_aien4
  at_put_u64 get ai_assess 4
  at_put_nl
  at_put_str at_p_sum1
  at_put_u64 get g_at_pub_st 0
  at_put_str at_p_sum2
  at_put_u64 goals_w
  at_put_str at_p_sum3
  at_put_u64 get g_at_pub_st 1
  at_put_str at_p_sum4
  at_put_u64 get cx_meta 0
  at_put_nl
end

fn at_publish_run_rig jp view uchar * jl ulong have_model ulong to void
  rx_aien_reset
  rx_aien_default_config
  for z ulong 4
    put g_at_pub_st z 0
  end
  at_print_pub_hdr jp jl have_model
  ni = get g_al_n_intents 0
  for idx ulong ni bound 64
    at_publish_one_intent idx
  end
  ign_s = at_cx_save_file jp jl
  at_print_pub_summary
end

fn at_verb_publish ac ulong to int
  fp = new uchar 256 0
  jp = new uchar 256 0
  plr = argread 2 fp 0 255
  jlr = argread 3 jp 0 255
  if or le plr 0 le jlr 0
    ret 2
  end
  have_model = ulong 0
  i = ulong 4
  while lt i ac bound 16
    if and at_arg_eq i at_f_model lt add i 1 ac
      i = add i 1
      if ne at_read_hex32_arg i 3 0
        at_put_fd 2 at_usage
        ret 2
      end
      have_model = 1
    else
      at_put_fd 2 at_usage
      ret 2
    end
    i = add i 1
  end
  if ne allen_load fp ulong plr 0
    at_print_err_code get g_al_err 0
    ret 3
  end
  if ne at_cx_open_file jp ulong jlr CX_OPEN_SYNC 0
    at_put_fd 2 at_e_jopen
    ret 3
  end
  mrc = allen_check_memory
  if eq mrc -1
    at_put_fd 2 at_err_pfx
    at_put_fd 2 at_e_unb
    ret 3
  end
  if eq mrc -2
    at_put_fd 2 at_err_pfx
    at_put_fd 2 at_e_empty
    ret 3
  end
  if eq mrc -3
    at_put_fd 2 at_err_pfx
    at_put_fd 2 at_e_mis
    ret 3
  end
  at_publish_run_rig jp ulong jlr have_model
  ret 0
end

fn at_verb_probe to int
  jp = new uchar 256 0
  jlr = argread 2 jp 0 255
  if le jlr 0
    ret 2
  end
  if ne at_cx_open_file jp ulong jlr CX_OPEN_READONLY 0
    at_put_fd 2 at_e_jopen
    ret 3
  end
  if ne cx_verify_chain 0 CX_OK
    at_put_fd 2 at_e_jchain
    ret 3
  end
  rx_aien_reset
  rx_aien_default_config
  goals_w = ulong 0
  if ne get ai_goal 0 0
    goals_w = 1
  end
  at_put_str at_p_prb1
  at_put_u64 get cx_meta 0
  at_put_str at_p_prb2
  at_put_u64 goals_w
  at_put_str at_p_prb3
  at_put_u64 get ai_goal 0
  at_put_str at_p_prb4
  at_put_u64 get ai_assess 0
  at_put_nl
  ret 0
end

fn main to int
  ac = ulong argcnt
  if lt ac 2
    at_put_fd 2 at_usage
    ret 2
  end
  if at_arg_eq 1 at_v_make
    ret at_verb_make ac
  end
  if and at_arg_eq 1 at_v_inspect eq ac 3
    ret at_verb_inspect 0
  end
  if and at_arg_eq 1 at_v_digest eq ac 3
    ret at_verb_inspect 1
  end
  if and at_arg_eq 1 at_v_lineage eq ac 3
    ret at_verb_lineage
  end
  if and at_arg_eq 1 at_v_seed or eq ac 3 eq ac 4
    ret at_verb_seed ac
  end
  if and at_arg_eq 1 at_v_publish ge ac 4
    ret at_verb_publish ac
  end
  if and at_arg_eq 1 at_v_probe eq ac 3
    ret at_verb_probe
  end
  at_put_fd 2 at_usage
  ret 2
end

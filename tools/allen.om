note
note tools/allen.om -- Pure seeded OM-2 port of tools/allen.c (ALLEN v0 host tool).
note Composes with seed/ng/sha256.om, src/allen/allen_core.om, src/allen/allen_bind.om.
note Verbs: make, inspect, digest, lineage, seed-journal, publish, probe.
note Exit codes: 0 ok; 2 usage; 3 refused; 4 rig/io failure.

const AT_SUBJ_EXTERNAL ulong 7

text at_usage "usage: allen make|inspect|digest|lineage|seed-journal|publish|probe\n"
text at_v_make "make"
text at_v_inspect "inspect"
text at_v_digest "digest"
text at_v_lineage "lineage"
text at_v_seed "seed-journal"
text at_v_publish "publish"
text at_v_probe "probe"
text at_f_o "-o"
text at_f_agent "--agent"
text at_f_root "--root"
text at_f_prov "--prov"
text at_f_cortex "--cortex"
text at_f_intent "--intent"

text at_p_subj "ALLEN subject "
text at_p_agent "ALLEN agent "
text at_p_root "ALLEN root "
text at_p_cortex "ALLEN cortex "
text at_p_bind "ALLEN binding external_subject 7 agent "
text at_p_mem "ALLEN memory BOUND lineage "
text at_p_pub "ALLEN publish intent "
text at_p_ext " -> EXTERNAL crumb "
text at_p_seeded "ALLEN seeded journal lineage "
text at_p_lin "ALLEN lineage "
text at_p_unb "ALLEN lineage unbound\n"
text at_p_probe "ALLEN probe goals_in_world 0 journal_records "
text at_p_ref_unb "allen: refused: subject has no Cortex lineage binding\n"
text at_p_ref_empty "allen: refused: Cortex journal holds no genesis record\n"
text at_p_ref_mis "allen: refused: Cortex lineage mismatch\n"
text at_p_ref_dec "allen: refused: decode failed\n"

global g_at_path uchar 256
global g_at_plen ulong 1
global g_at_jpath uchar 256
global g_at_jlen ulong 1
global g_at_goal_seq ulong 1
global g_at_goal_reg ulong 1
global g_at_goal_ns ulong 1
global g_at_goal_id ulong 1

fn at_put_str s view uchar * to void
  ign = write 1 s 0 len s
end

fn at_put_u64 v ulong to void
  db = new uchar 24 0
  rev = new uchar 24 0
  if eq v 0
    put db 0 48
    ign = write 1 db 0 1
    ret
  end
  cur = v
  n = ulong 0
  while gt cur 0 bound 24
    put db n uchar add 48 rem cur 10
    cur = div cur 10
    n = add n 1
  end
  for i ulong n bound 24
    put rev i get db sub sub n 1 i
  end
  ign = write 1 rev 0 n
end

fn at_put_nl to void
  nl = new uchar 1 0
  put nl 0 10
  ign = write 1 nl 0 1
end

fn at_put_hex32 b view uchar 32 to void
  h = new uchar 64 0
  allen_hex b h
  ign = write 1 h 0 64
end

fn at_arg_eq idx ulong lit view uchar * to bool
  tmp = new uchar 256 0
  got = argread idx tmp 0 255
  if ne got long len lit
    ret false
  end
  for i ulong len lit bound 255
    if ne get tmp i get lit i
      ret false
    end
  end
  ret true
end

fn at_parse_u64 s view uchar * start ulong slen ulong to ulong
  v = ulong 0
  for i ulong slen bound 24
    c = ulong get s add start i
    if or lt c 48 gt c 57
      ret v
    end
    v = add mul v 10 sub c 48
  end
  ret v
end

fn at_journal_read path view uchar * plen ulong to long
  jb = new uchar 40 0
  if or eq plen 0 gt plen 255
    ret -1
  end
  fd = fopen path 0 plen 0 0
  if lt fd 0
    put g_al_cx_n 0 0
    for i ulong 32
      put g_al_cx_gen_dig i 0
    end
    ret -1
  end
  got = read int fd jb 0 40
  ign = fclose int fd
  if lt got 40
    put g_al_cx_n 0 0
    for i ulong 32
      put g_al_cx_gen_dig i 0
    end
    ret 0
  end
  cnt = ulong 0
  for i ulong 8
    cnt = or cnt shl ulong get jb i mul i 8
  end
  put g_al_cx_n 0 cnt
  for i ulong 32
    put g_al_cx_gen_dig i get jb add 8 i
  end
  ret 0
end

fn at_journal_write path view uchar * plen ulong cnt ulong dig view uchar 32 to long
  jb = new uchar 40 0
  if or eq plen 0 gt plen 255
    ret -1
  end
  fd = fopen path 0 plen 577 420
  if lt fd 0
    ret -1
  end
  for i ulong 8
    put jb i uchar and shr cnt mul i 8 255
  end
  for i ulong 32
    put jb add 8 i get dig i
  end
  w = write int fd jb 0 40
  ign = fclose int fd
  if ne w 40
    ret -1
  end
  ret 0
end

fn at_print_subject to void
  b = new uchar 32 0
  for i ulong 32
    put b i get g_al_subj_id i
  end
  at_put_str at_p_subj
  at_put_hex32 b
  at_put_nl
  for i ulong 32
    put b i get g_al_agent i
  end
  at_put_str at_p_agent
  at_put_hex32 b
  at_put_nl
  for i ulong 32
    put b i get g_al_root i
  end
  at_put_str at_p_root
  at_put_hex32 b
  at_put_nl
  for i ulong 32
    put b i get g_al_cortex i
  end
  at_put_str at_p_cortex
  at_put_hex32 b
  at_put_nl
end

fn at_verb_seed ac ulong to int
  jp = new uchar 256 0
  tb = new uchar 24 0
  dig = new uchar 32 0
  if or lt ac 3 gt ac 4
    at_put_str at_usage
    ret 2
  end
  jlr = argread 2 jp 0 255
  if le jlr 0
    ret 2
  end
  jl = ulong jlr
  tag = ulong 0
  if eq ac 4
    tlr = argread 3 tb 0 24
    if lt tlr 0
      ret 2
    end
    tag = at_parse_u64 tb 0 ulong tlr
  end
  put sh_dat 0 83
  put sh_dat 1 69
  put sh_dat 2 69
  put sh_dat 3 68
  for i ulong 8
    put sh_dat add 4 i uchar and shr tag mul i 8 255
  end
  sh_all 12
  for i ulong 32
    put dig i get sh_dig i
  end
  if ne at_journal_write jp jl 1 dig 0
    ret 3
  end
  at_put_str at_p_seeded
  at_put_hex32 dig
  at_put_nl
  ret 0
end

fn at_verb_lineage to int
  jp = new uchar 256 0
  ref = new uchar 32 0
  jlr = argread 2 jp 0 255
  if le jlr 0
    ret 2
  end
  if ne at_journal_read jp ulong jlr 0
    ret 3
  end
  if ne allen_lineage ref 0
    at_put_str at_p_unb
    ret 0
  end
  at_put_str at_p_lin
  at_put_hex32 ref
  at_put_nl
  ret 0
end

fn at_verb_inspect digest_only ulong to int
  fp = new uchar 256 0
  id = new uchar 32 0
  plr = argread 2 fp 0 255
  if le plr 0
    ret 2
  end
  if ne allen_load fp ulong plr 0
    at_put_str at_p_ref_dec
    ret 3
  end
  if ne digest_only 0
    for i ulong 32
      put id i get g_al_subj_id i
    end
    at_put_hex32 id
    at_put_nl
    ret 0
  end
  at_print_subject
  ret 0
end

fn at_parse_intent_arg idx ulong to long
  ib = new uchar 64 0
  ilr = argread idx ib 0 64
  if le ilr 0
    ret -1
  end
  il = ulong ilr
  comma = ulong il
  for i ulong il bound 64
    if and eq comma il eq get ib i 44
      comma = i
    end
  end
  if or eq comma il ge add comma 1 il
    ret -1
  end
  r = at_parse_u64 ib 0 comma
  t = at_parse_u64 ib add comma 1 sub sub il comma 1
  ret al_subject_add_intent CS_INTENT_GOAL_LATENCY r t
end

fn at_read_hex32_arg idx ulong dst_kind ulong to long
  hx = new uchar 64 0
  raw = new uchar 32 0
  got = argread idx hx 0 64
  if ne got 64
    ret -1
  end
  if ne allen_unhex hx raw 0
    ret -1
  end
  for k ulong 32
    if eq dst_kind 0
      put g_al_agent k get raw k
    end
    if eq dst_kind 1
      put g_al_root k get raw k
    end
    if eq dst_kind 2
      put g_al_prov k get raw k
    end
  end
  ret 0
end

fn at_read_path_arg idx ulong is_j ulong to long
  pb = new uchar 256 0
  plr = argread idx pb 0 255
  if le plr 0
    ret -1
  end
  pl = ulong plr
  for k ulong pl bound 255
    if eq is_j 0
      put g_at_path k get pb k
    else
      put g_at_jpath k get pb k
    end
  end
  if eq is_j 0
    put g_at_plen 0 pl
  else
    put g_at_jlen 0 pl
  end
  ret 0
end

fn at_write_subject_file to long
  op = new uchar 256 0
  wb = new uchar 4096 0
  pl = get g_at_plen 0
  for k ulong pl bound 255
    put op k get g_at_path k
  end
  fd = fopen op 0 pl 577 420
  if lt fd 0
    ret -1
  end
  bl = get g_al_buf_len 0
  for k ulong bl bound 4096
    put wb k get g_al_buf k
  end
  w = write int fd wb 0 bl
  ign = fclose int fd
  if ne w long bl
    ret -1
  end
  ret 0
end

fn at_bind_cortex_from_jpath to long
  jp = new uchar 256 0
  ref = new uchar 32 0
  jl = get g_at_jlen 0
  for k ulong jl bound 255
    put jp k get g_at_jpath k
  end
  if ne at_journal_read jp jl 0
    ret -1
  end
  if eq allen_lineage ref 0
    for k ulong 32
      put g_al_cortex k get ref k
    end
  end
  ret 0
end

fn at_verb_make ac ulong to int
  al_subject_reset
  have_out = ulong 0
  have_agent = ulong 0
  have_root = ulong 0
  have_j = ulong 0
  i = ulong 2
  while lt i ac bound 64
    if and at_arg_eq i at_f_o lt add i 1 ac
      i = add i 1
      if ne at_read_path_arg i 0 0
        ret 2
      end
      have_out = 1
    else
      if and at_arg_eq i at_f_agent lt add i 1 ac
        i = add i 1
        if ne at_read_hex32_arg i 0 0
          ret 2
        end
        have_agent = 1
      else
        if and at_arg_eq i at_f_root lt add i 1 ac
          i = add i 1
          if ne at_read_hex32_arg i 1 0
            ret 2
          end
          have_root = 1
        else
          if and at_arg_eq i at_f_prov lt add i 1 ac
            i = add i 1
            if ne at_read_hex32_arg i 2 0
              ret 2
            end
          else
            if and at_arg_eq i at_f_cortex lt add i 1 ac
              i = add i 1
              if ne at_read_path_arg i 1 0
                ret 2
              end
              have_j = 1
            else
              if and at_arg_eq i at_f_intent lt add i 1 ac
                i = add i 1
                if ne at_parse_intent_arg i 0
                  ret 3
                end
              else
                at_put_str at_usage
                ret 2
              end
            end
          end
        end
      end
    end
    i = add i 1
  end
  if or eq have_out 0 or eq have_agent 0 eq have_root 0
    at_put_str at_usage
    ret 2
  end
  if ne have_j 0
    if ne at_bind_cortex_from_jpath 0
      ret 3
    end
  end
  if ne al_subject_encode 0
    ret 3
  end
  if ne at_write_subject_file 0
    ret 4
  end
  at_print_subject
  ret 0
end

fn at_publish_intents to ulong
  iid = new uchar 32 0
  put g_at_goal_seq 0 0
  ni = get g_al_n_intents 0
  crumb = ulong 0
  for i ulong ni bound 16
    ns = add get g_at_goal_seq 0 1
    nm = allen_goal_mutations i 1 ns
    if gt nm 0
      put g_at_goal_seq 0 ns
      put g_at_goal_reg 0 get g_al_mut_val 1
      put g_at_goal_ns 0 get g_al_mut_val 2
      put g_at_goal_id 0 get g_al_mut_val 3
      crumb = add crumb 1
      base = mul i 32
      for k ulong 32
        put iid k get g_al_in_id add base k
      end
      at_put_str at_p_pub
      at_put_hex32 iid
      at_put_str at_p_ext
      at_put_u64 crumb
      at_put_nl
    end
  end
  ret crumb
end

fn at_verb_publish ac ulong to int
  fp = new uchar 256 0
  jp = new uchar 256 0
  tmp32 = new uchar 32 0
  plr = argread 2 fp 0 255
  jlr = argread 3 jp 0 255
  if or le plr 0 le jlr 0
    ret 2
  end
  pl = ulong plr
  jl = ulong jlr
  if ne allen_load fp pl 0
    at_put_str at_p_ref_dec
    ret 3
  end
  ign3 = at_journal_read jp jl
  mrc = allen_check_memory
  if eq mrc -1
    at_put_str at_p_ref_unb
    ret 3
  end
  if eq mrc -2
    at_put_str at_p_ref_empty
    ret 3
  end
  if eq mrc -3
    at_put_str at_p_ref_mis
    ret 3
  end
  allen_bind_identity AT_SUBJ_EXTERNAL
  at_print_subject
  for i ulong 32
    put tmp32 i get g_al_bind_agent i
  end
  at_put_str at_p_bind
  at_put_hex32 tmp32
  at_put_nl
  for i ulong 32
    put tmp32 i get g_al_cortex i
  end
  at_put_str at_p_mem
  at_put_hex32 tmp32
  at_put_nl
  crumb = at_publish_intents
  for i ulong 32
    put tmp32 i get g_al_cx_gen_dig i
  end
  ign4 = at_journal_write jp jl add get g_al_cx_n 0 crumb tmp32
  ign_ac = ac
  ret 0
end

fn at_verb_probe to int
  jp = new uchar 256 0
  jlr = argread 2 jp 0 255
  if le jlr 0
    ret 2
  end
  if ne at_journal_read jp ulong jlr 0
    ret 3
  end
  at_put_str at_p_probe
  at_put_u64 get g_al_cx_n 0
  at_put_nl
  ret 0
end

fn main to int
  ac = ulong argcnt
  if lt ac 2
    at_put_str at_usage
    ret 2
  end
  if at_arg_eq 1 at_v_make
    ret at_verb_make ac
  end
  if and at_arg_eq 1 at_v_inspect eq ac 3
    ret at_verb_inspect 0
  end
  if and at_arg_eq 1 at_v_digest eq ac 3
    ret at_verb_inspect 1
  end
  if and at_arg_eq 1 at_v_lineage eq ac 3
    ret at_verb_lineage
  end
  if and at_arg_eq 1 at_v_seed or eq ac 3 eq ac 4
    ret at_verb_seed ac
  end
  if and at_arg_eq 1 at_v_publish ge ac 4
    ret at_verb_publish ac
  end
  if and at_arg_eq 1 at_v_probe eq ac 3
    ret at_verb_probe
  end
  at_put_str at_usage
  ret 2
end

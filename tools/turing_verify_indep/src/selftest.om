note Self tests from the documents' own test vectors, plus the log2 rounding audit (SPEC_GAPS G2).

global g_st_fails ulong 1
global g_bw_buf uchar 4096
global g_bw_pos ulong 1
global g_arg1 uchar 1024
global g_arg2 uchar 1024
global g_path uchar 2048
global g_sidecar uchar 64

text ts_ok "ok   "
text ts_fail "FAIL "
text ts_abc "abc"
text ts_abc_exp "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
text ts_sha_lbl "sha256(abc)\n"
text ts_b0_path "/tmp/is_b0.tym"
text ts_b0_exp "83c04bdfc10614febd634092355ef03997ed255fde5bdec9a80fe2d8964998ce"
text ts_b0_lbl "B0 test vector: L=232, digest "
text ts_b3_path "/tmp/is_b3.tym"
text ts_b3_exp "e729818b8289263e6819b21fc55f944f9d5113e7cfc4419d0badcc27f589f2ae"
text ts_b3_lbl1 "B3 rebuilt from prereg section 0: L="
text ts_b3_lbl2 " bytes="
text ts_b3_lbl3 " digest "
text ts_b3_bytes "B3 bytes 29..31 = 02 49 22 (MDE 7)\n"
text ts_t_path "/tmp/is_t.tym"
text ts_r2 "refuse version 1\n"
text ts_r3 "refuse qbits 8\n"
text ts_r5 "refuse trailing byte\n"
text ts_r6 "refuse zero entry\n"
text ts_r4 "refuse keybits mismatch (mask 2)\n"

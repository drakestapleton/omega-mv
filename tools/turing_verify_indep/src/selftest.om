fn st_check ok bool to void
  if ok
    wr_str int 1 ts_ok
  else
    wr_str int 1 ts_fail
    put g_st_fails 0 add get g_st_fails 0 1
  end
end

fn bw_reset to void
  i = ulong 0
  while lt i 4096 bound 4096
    put g_bw_buf i uchar 0
    i = add i 1
  end
  put g_bw_pos 0 ulong 0
end

fn bw_put v ulong n ulong to void
  i = n
  while gt i 0 bound 64
    i = sub i 1
    p = get g_bw_pos 0
    if ne and shr v i ulong 1 0
      bi = shr p 3
      bit = uchar shr ulong 128 and p 7
      put g_bw_buf bi or get g_bw_buf bi bit
    end
    put g_bw_pos 0 add p 1
  end
end

fn write_file_bytes path view uchar * buf view uchar * n ulong to int
  fd = fopen path ulong 0 len path int 577 int 420
  if lt fd long 0
    ret int -1
  end
  _w = wr_all int fd buf ulong 0 n
  _fc = fclose int fd
  ret int 0
end

fn write_g_bw path view uchar * n ulong to int
  fd = fopen path ulong 0 len path int 577 int 420
  if lt fd long 0
    ret int -1
  end
  p = ulong 0
  while lt p n bound 4096
    k = write int fd g_bw_buf p sub n p
    if le k long 0
      _fc = fclose int fd
      ret int -1
    end
    p = add p ulong k
  end
  _fc = fclose int fd
  ret int 0
end

fn build_b0 b edit uchar 29 to void
  put b 0 uchar 0x54
  put b 1 uchar 0x59
  put b 2 uchar 0x4d
  put b 3 uchar 0x30
  put b 4 uchar 0x00
  put b 5 uchar 0x09
  put b 6 uchar 0x00
  put b 7 uchar 0x10
  put b 8 uchar 0x00
  put b 9 uchar 0x00
  put b 10 uchar 0x00
  put b 11 uchar 0x00
  put b 12 uchar 0x00
  i = ulong 0
  while lt i 7 bound 8
    put b add 13 mul i 2 uchar 0x1c
    put b add 14 mul i 2 uchar 0x72
    i = add i 1
  end
  put b 27 uchar 0x1c
  put b 28 uchar 0x71
end

fn test_refusals to void
  b0 = new uchar 29 0
  build_b0 b0
  t = new uchar 30 0
  for i ulong 29
    put t i get b0 i
  end
  put t 4 uchar 1
  _w1 = write_file_bytes ts_t_path t ulong 29
  st_check eq is_model_load ts_t_path len ts_t_path int -2
  wr_str int 1 ts_r2

  for i ulong 29
    put t i get b0 i
  end
  put t 7 uchar 8
  _w2 = write_file_bytes ts_t_path t ulong 29
  st_check eq is_model_load ts_t_path len ts_t_path int -3
  wr_str int 1 ts_r3

  for i ulong 29
    put t i get b0 i
  end
  put t 29 uchar 0
  _w3 = write_file_bytes ts_t_path t ulong 30
  st_check eq is_model_load ts_t_path len ts_t_path int -5
  wr_str int 1 ts_r5

  for i ulong 29
    put t i get b0 i
  end
  put t 13 uchar 0
  put t 14 uchar 0
  _w4 = write_file_bytes ts_t_path t ulong 29
  st_check eq is_model_load ts_t_path len ts_t_path int -6
  wr_str int 1 ts_r6

  for i ulong 29
    put t i get b0 i
  end
  put t 6 uchar 2
  _w5 = write_file_bytes ts_t_path t ulong 29
  st_check eq is_model_load ts_t_path len ts_t_path int -4
  wr_str int 1 ts_r4
end

fn cat_path_arg1 suf view uchar * a1len ulong to ulong
  i = ulong 0
  while lt i a1len bound 1024
    put g_path i get g_arg1 i
    i = add i 1
  end
  j = ulong 0
  sn = len suf
  while lt j sn bound 256
    put g_path add a1len j get suf j
    j = add j 1
  end
  ret add a1len sn
end

fn cat_path_arg2 suf view uchar * a2len ulong to ulong
  i = ulong 0
  while lt i a2len bound 1024
    put g_path i get g_arg2 i
    i = add i 1
  end
  j = ulong 0
  sn = len suf
  while lt j sn bound 256
    put g_path add a2len j get suf j
    j = add j 1
  end
  ret add a2len sn
end

fn sha_gpath plen ulong hx edit uchar 64 to void
  pbuf = new uchar 2048 0
  d = new uchar 32 0
  i = ulong 0
  while lt i plen bound 2048
    put pbuf i get g_path i
    i = add i 1
  end
  _sf = sha_file pbuf plen d
  sha_hex d hx
end

fn test_docs a1len ulong to void
  hx = new uchar 64 0
  sc = new uchar 64 0
  pbuf = new uchar 2048 0
  pv = is_profile_version
  plen = ulong 0
  if eq pv int 1
    plen = cat_path_arg1 ts_prof_b a1len
  else
    plen = cat_path_arg1 ts_prof_a a1len
  end
  sha_gpath plen hx
  if eq pv int 1
    plen = cat_path_arg1 ts_side_b a1len
  else
    plen = cat_path_arg1 ts_side_a a1len
  end
  i = ulong 0
  while lt i plen bound 2048
    put pbuf i get g_path i
    i = add i 1
  end
  fd = fopen pbuf ulong 0 plen int 0 int 0
  ok = false
  if ge fd long 0
    got = read int fd sc ulong 0 ulong 64
    _fc = fclose int fd
    if eq got long 64
      ok = buf_eq hx sc ulong 64
    end
  end
  st_check ok
  wr_str int 1 ts_prof_lbl
end

fn cand_check_hashes which ulong to bool
  fsha = new uchar 32 0
  hx = new uchar 64 0
  for z ulong 32
    put fsha z get g_m_fsha z
  end
  sha_hex fsha hx
  ok = false
  if eq which 0
    ok = buf_eq hx ts_mmem_fs ulong 64
  else
    ok = buf_eq hx ts_mmem1_fs ulong 64
  end
  if not ok
    ret false
  end
  for z ulong 32
    put fsha z get g_m_mdig z
  end
  sha_hex fsha hx
  if eq which 0
    if not buf_eq hx ts_mmem_md ulong 64
      ret false
    end
    if ne get g_m_meta 6 ulong 607838516
      ret false
    end
    if ne get g_m_meta 4 ulong 3706331
      ret false
    end
    ret eq get g_m_meta 3 ulong 36
  end
  if not buf_eq hx ts_mmem1_md ulong 64
    ret false
  end
  if ne get g_m_meta 6 ulong 356335496
    ret false
  end
  if ne get g_m_meta 4 ulong 2172776
    ret false
  end
  ret eq get g_m_meta 3 ulong 36
end

fn test_one_cand which ulong a2len ulong to void
  pbuf = new uchar 2048 0
  plen = ulong 0
  if eq which 0
    plen = cat_path_arg2 ts_mmem_suf a2len
  else
    plen = cat_path_arg2 ts_mmem1_suf a2len
  end
  i = ulong 0
  while lt i plen bound 2048
    put pbuf i get g_path i
    i = add i 1
  end
  r = is_model_load pbuf plen
  ok = eq r int 0
  if ok
    ok = cand_check_hashes which
  end
  st_check ok
  if eq which 0
    wr_str int 1 ts_mmem_nm
  else
    wr_str int 1 ts_mmem1_nm
  end
  wr_str int 1 ts_colon
  wr_i64 int 1 long r
  wr_str int 1 ts_l
  wr_u64 int 1 get g_m_meta 6
  wr_str int 1 ts_rows
  wr_u64 int 1 get g_m_meta 4
  wr_str int 1 ts_kb
  wr_u64 int 1 get g_m_meta 3
  wr_str int 1 t_nl
end

note 52-bit exact Q62 squaring for log2(q) rounding audit (replaces long double log2l)
fn log2_q52 q uint to ulong
  ip = clz32_pos q
  m = shl ulong q sub ulong 62 ip
  frac = ulong 0
  msb = shl ulong 1 63
  i = ulong 1
  while le i 52 bound 52
    m = sq_shr62 m
    if ge m msb
      frac = or frac shl ulong 1 sub ulong 52 i
      m = shr m 1
    end
    i = add i 1
  end
  ret or shl ip 52 frac
end

fn ub_audit_one q uint nf long to ulong
  x52 = sub shl ulong 16 52 log2_q52 q
  xhi = mul shr x52 20 ulong 1000000
  xlo = mul and x52 ulong 0xfffff ulong 1000000
  tot_hi = add xhi shr xlo 20
  fr52 = or shl and tot_hi ulong 0xffffffff 20 and xlo ulong 0xfffff
  rn = long shr tot_hi 32
  half52 = shl ulong 1 51
  if ge fr52 half52
    rn = add rn 1
  end
  res = ulong 0
  tbl = get g_ub_q16 ulong q
  if ne rn tbl
    res = or res ulong 1
    wr_str int 1 ts_diff1
    wr_u64 int 1 ulong q
    wr_str int 1 ts_diff2
    wr_i64 int 1 tbl
    wr_str int 1 ts_diff3
    wr_i64 int 1 rn
    wr_str int 1 ts_diff4
  end
  dist = ulong 0
  if ge fr52 half52
    dist = sub fr52 half52
  else
    dist = sub half52 fr52
  end
  if lt dist ulong 2251799813685
    res = or res ulong 2
    if ge nf long 0
      wr_u64 int nf ulong q
      wr_str int nf t_nl
    end
  end
  ret res
end

fn test_ub_audit to void
  is_ub_table_init
  ndiff = ulong 0
  nnear = ulong 0
  nf = fopen ts_near_file ulong 0 len ts_near_file int 577 int 420
  q = uint 1
  while le q uint 65536 bound 65537
    res = ub_audit_one q nf
    if ne and res 1 0
      ndiff = add ndiff 1
    end
    if ne and res 2 0
      nnear = add nnear 1
    end
    q = add q 1
  end
  if ge nf long 0
    _fc = fclose int nf
  end
  ok = eq ndiff 2
  if ok
    ok = eq get g_ub_q16 43481 long 591903
  end
  if ok
    ok = eq get g_ub_q16 46819 long 485194
  end
  st_check ok
  wr_str int 1 ts_ub_chk
  wr_u64 int 1 ndiff
  wr_str int 1 ts_ub_chk2
  wr_str int 1 ts_near1
  wr_u64 int 1 nnear
  wr_str int 1 ts_near2
  wr_str int 1 ts_ub1
  wr_i64 int 1 get g_ub_q16 1
  wr_str int 1 ts_ub2
  wr_i64 int 1 get g_ub_q16 7282
  wr_str int 1 ts_ub3
  wr_i64 int 1 get g_ub_q16 32768
  wr_str int 1 ts_ub4
  wr_i64 int 1 get g_ub_q16 65536
  wr_str int 1 t_nl
end

fn test_b0_b3 to void
  b0 = new uchar 29 0
  build_b0 b0
  _w0 = write_file_bytes ts_b0_path b0 ulong 29
  r = is_model_load ts_b0_path len ts_b0_path
  md = new uchar 32 0
  for z ulong 32
    put md z get g_m_mdig z
  end
  hx = new uchar 64 0
  sha_hex md hx
  ok = eq r int 0
  if ok
    ok = eq get g_m_meta 6 ulong 232
  end
  if ok
    ok = eq get g_m_def 8 ushort 7281
  end
  if ok
    ok = buf_eq hx ts_b0_exp ulong 64
  end
  st_check ok
  wr_str int 1 ts_b0_lbl
  _wh = wr_all int 1 hx ulong 0 ulong 64
  wr_str int 1 t_nl

  bw_reset
  bw_put ulong 0x54594d30 ulong 32
  bw_put ulong 0 ulong 8
  bw_put ulong 9 ulong 8
  bw_put ulong 1 ulong 8
  bw_put ulong 16 ulong 8
  bw_put ulong 4 ulong 8
  bw_put ulong 16 ulong 32
  for j ulong 7
    bw_put ulong 7282 ulong 16
  end
  bw_put ulong 7281 ulong 16
  k = ulong 0
  while lt k 16 bound 16
    bw_put k ulong 4
    j = ulong 0
    while lt j 8 bound 8
      v = ulong 1
      if lt k 15
        if lt j 7
          v = ulong 9362
        end
      else
        if ge j 7
          v = ulong 32765
        end
      end
      bw_put v ulong 16
      j = add j 1
    end
    k = add k 1
  end
  b3bytes = div add get g_bw_pos 0 7 8
  _w3 = write_g_bw ts_b3_path b3bytes
  r = is_model_load ts_b3_path len ts_b3_path
  for z ulong 32
    put md z get g_m_mdig z
  end
  sha_hex md hx
  ok3 = eq r int 0
  if ok3
    ok3 = eq get g_m_meta 6 ulong 2344
  end
  if ok3
    ok3 = eq b3bytes ulong 293
  end
  if ok3
    ok3 = buf_eq hx ts_b3_exp ulong 64
  end
  st_check ok3
  wr_str int 1 ts_b3_lbl1
  wr_u64 int 1 get g_m_meta 6
  wr_str int 1 ts_b3_lbl2
  wr_u64 int 1 b3bytes
  wr_str int 1 ts_b3_lbl3
  _wh3 = wr_all int 1 hx ulong 0 ulong 64
  wr_str int 1 t_nl
  ok3b = eq get g_bw_buf 29 uchar 0x02
  if ok3b
    ok3b = eq get g_bw_buf 30 uchar 0x49
  end
  if ok3b
    ok3b = eq get g_bw_buf 31 uchar 0x22
  end
  st_check ok3b
  wr_str int 1 ts_b3_bytes
end

fn main to int
  put g_st_fails 0 ulong 0
  sha_init ulong 0
  sha_upd ulong 0 ts_abc ulong 0 ulong 3
  d = new uchar 32 0
  hx = new uchar 64 0
  sha_final ulong 0 d
  sha_hex d hx
  st_check buf_eq hx ts_abc_exp ulong 64
  wr_str int 1 ts_sha_lbl

  test_b0_b3
  test_refusals

  ac = argcnt
  if gt ac long 1
    a1 = argread ulong 1 g_arg1 ulong 0 ulong 1024
    if gt a1 long 0
      test_docs ulong a1
    end
  end
  if gt ac long 2
    a2 = argread ulong 2 g_arg2 ulong 0 ulong 1024
    if gt a2 long 0
      test_one_cand ulong 0 ulong a2
      test_one_cand ulong 1 ulong a2
    end
  end

  put g_rng_st 0 ulong 0
  sm = is_splitmix64
  smexp = or shl ulong 0xe220a839 32 ulong 0x7b1dcdaf
  st_check eq sm smexp
  wr_str int 1 ts_sm_lbl

  test_ub_audit

  f = get g_st_fails 0
  if ne f 0
    wr_str int 1 ts_fail_end
    wr_u64 int 1 f
    wr_str int 1 ts_fend
    ret int 1
  end
  wr_str int 1 ts_pass
  wr_u64 int 1 f
  wr_str int 1 ts_fend
  ret int 0
end

text ts_prof_b "/profiles/Turing-profile-v1.1.toml"
text ts_side_a "/profiles/Turing-profile-v1.0.sha256"
text ts_side_b "/profiles/Turing-profile-v1.1.sha256"
text ts_prof_lbl "profile sha256 = sidecar\n"
text ts_mmem_suf "/M_mem.tym"
text ts_mmem1_suf "/M_mem_seed1.tym"
text ts_mmem_nm "M_mem"
text ts_mmem1_nm "M_mem_seed1"
text ts_mmem_fs "5a2ca3f457cc75b4f49fee99f054a0c32d15e3bfd442886c40e4a5f4945bab81"
text ts_mmem1_fs "34df83a19756d1bd7e73f2b218576cefedad40ac2fc0e7a7a3da10a2a7fd206f"
text ts_mmem_md "cbd6944c6618f508e5377e4698b0d472042cdf3b4592cb80e5427767e232c140"
text ts_mmem1_md "5dfeff7b643178807b547fbd62388319b9a407109e345614679e4bf20ccfd652"

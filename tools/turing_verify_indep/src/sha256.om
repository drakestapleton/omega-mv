om2
note SPDX-License-Identifier: Apache-2.0
note Independent SHA-256 (FIPS 180-4) in pure seeded OM-2, lane D scorer.

global g_sha_k uint 64
global g_sha_h uint 16
global g_sha_buf uchar 128
global g_sha_len ulong 2
global g_sha_n ulong 2
global g_sha_w uint 64
global g_sha_v uint 8
global g_sha_io uchar 65536
global g_sha_kinit uint 1

text t_hexchars "0123456789abcdef"

fn sha_init_k to void
  if ne get g_sha_kinit 0 uint 0
    ret
  end
  put g_sha_k 0 uint 0x428a2f98
  put g_sha_k 1 uint 0x71374491
  put g_sha_k 2 uint 0xb5c0fbcf
  put g_sha_k 3 uint 0xe9b5dba5
  put g_sha_k 4 uint 0x3956c25b
  put g_sha_k 5 uint 0x59f111f1
  put g_sha_k 6 uint 0x923f82a4
  put g_sha_k 7 uint 0xab1c5ed5
  put g_sha_k 8 uint 0xd807aa98
  put g_sha_k 9 uint 0x12835b01
  put g_sha_k 10 uint 0x243185be
  put g_sha_k 11 uint 0x550c7dc3
  put g_sha_k 12 uint 0x72be5d74
  put g_sha_k 13 uint 0x80deb1fe
  put g_sha_k 14 uint 0x9bdc06a7
  put g_sha_k 15 uint 0xc19bf174
  put g_sha_k 16 uint 0xe49b69c1
  put g_sha_k 17 uint 0xefbe4786
  put g_sha_k 18 uint 0x0fc19dc6
  put g_sha_k 19 uint 0x240ca1cc
  put g_sha_k 20 uint 0x2de92c6f
  put g_sha_k 21 uint 0x4a7484aa
  put g_sha_k 22 uint 0x5cb0a9dc
  put g_sha_k 23 uint 0x76f988da
  put g_sha_k 24 uint 0x983e5152
  put g_sha_k 25 uint 0xa831c66d
  put g_sha_k 26 uint 0xb00327c8
  put g_sha_k 27 uint 0xbf597fc7
  put g_sha_k 28 uint 0xc6e00bf3
  put g_sha_k 29 uint 0xd5a79147
  put g_sha_k 30 uint 0x06ca6351
  put g_sha_k 31 uint 0x14292967
  put g_sha_k 32 uint 0x27b70a85
  put g_sha_k 33 uint 0x2e1b2138
  put g_sha_k 34 uint 0x4d2c6dfc
  put g_sha_k 35 uint 0x53380d13
  put g_sha_k 36 uint 0x650a7354
  put g_sha_k 37 uint 0x766a0abb
  put g_sha_k 38 uint 0x81c2c92e
  put g_sha_k 39 uint 0x92722c85
  put g_sha_k 40 uint 0xa2bfe8a1
  put g_sha_k 41 uint 0xa81a664b
  put g_sha_k 42 uint 0xc24b8b70
  put g_sha_k 43 uint 0xc76c51a3
  put g_sha_k 44 uint 0xd192e819
  put g_sha_k 45 uint 0xd6990624
  put g_sha_k 46 uint 0xf40e3585
  put g_sha_k 47 uint 0x106aa070
  put g_sha_k 48 uint 0x19a4c116
  put g_sha_k 49 uint 0x1e376c08
  put g_sha_k 50 uint 0x2748774c
  put g_sha_k 51 uint 0x34b0bcb5
  put g_sha_k 52 uint 0x391c0cb3
  put g_sha_k 53 uint 0x4ed8aa4a
  put g_sha_k 54 uint 0x5b9cca4f
  put g_sha_k 55 uint 0x682e6ff3
  put g_sha_k 56 uint 0x748f82ee
  put g_sha_k 57 uint 0x78a5636f
  put g_sha_k 58 uint 0x84c87814
  put g_sha_k 59 uint 0x8cc70208
  put g_sha_k 60 uint 0x90befffa
  put g_sha_k 61 uint 0xa4506ceb
  put g_sha_k 62 uint 0xbef9a3f7
  put g_sha_k 63 uint 0xc67178f2
  put g_sha_kinit 0 uint 1
end

fn sha_expand ctx ulong to void
  base = mul ctx ulong 64
  for i ulong 16
    p = add base mul i ulong 4
    w0 = shl uint get g_sha_buf p 24
    w1 = shl uint get g_sha_buf add p 1 16
    w2 = shl uint get g_sha_buf add p 2 8
    w3 = uint get g_sha_buf add p 3
    put g_sha_w i or or w0 w1 or w2 w3
  end
  i = ulong 16
  while lt i 64 bound 64
    v15 = get g_sha_w sub i 15
    s0 = xor xor rotr v15 7 rotr v15 18 shr v15 3
    v2 = get g_sha_w sub i 2
    s1 = xor xor rotr v2 17 rotr v2 19 shr v2 10
    put g_sha_w i add add get g_sha_w sub i 16 s0 add get g_sha_w sub i 7 s1
    i = add i 1
  end
end

fn sha_round r ulong to void
  ve = get g_sha_v 4
  t1 = xor rotr ve 6 rotr ve 11
  t1 = xor t1 rotr ve 25
  t1 = add t1 get g_sha_v 7
  t2 = and ve get g_sha_v 5
  t2 = xor t2 and not ve get g_sha_v 6
  t1 = add t1 t2
  t1 = add t1 get g_sha_k r
  t1 = add t1 get g_sha_w r
  va = get g_sha_v 0
  vb = get g_sha_v 1
  vc = get g_sha_v 2
  t2 = xor rotr va 2 rotr va 13
  t2 = xor t2 rotr va 22
  t2 = add t2 xor xor and va vb and va vc and vb vc
  put g_sha_v 7 get g_sha_v 6
  put g_sha_v 6 get g_sha_v 5
  put g_sha_v 5 ve
  put g_sha_v 4 add get g_sha_v 3 t1
  put g_sha_v 3 vc
  put g_sha_v 2 vb
  put g_sha_v 1 va
  put g_sha_v 0 add t1 t2
end

fn sha_compress ctx ulong to void
  sha_expand ctx
  hb = mul ctx ulong 8
  for i ulong 8
    put g_sha_v i get g_sha_h add hb i
  end
  for r ulong 64
    sha_round r
  end
  for i ulong 8
    put g_sha_h add hb i add get g_sha_h add hb i get g_sha_v i
  end
end

fn sha_init ctx ulong to void
  sha_init_k
  hb = mul ctx ulong 8
  put g_sha_h hb uint 0x6a09e667
  put g_sha_h add hb 1 uint 0xbb67ae85
  put g_sha_h add hb 2 uint 0x3c6ef372
  put g_sha_h add hb 3 uint 0xa54ff53a
  put g_sha_h add hb 4 uint 0x510e527f
  put g_sha_h add hb 5 uint 0x9b05688c
  put g_sha_h add hb 6 uint 0x1f83d9ab
  put g_sha_h add hb 7 uint 0x5be0cd19
  put g_sha_len ctx ulong 0
  put g_sha_n ctx ulong 0
end

fn sha_upd_byte ctx ulong b uchar to void
  base = mul ctx ulong 64
  n = get g_sha_n ctx
  put g_sha_buf add base n b
  put g_sha_len ctx add get g_sha_len ctx ulong 1
  n = add n 1
  if eq n 64
    sha_compress ctx
    put g_sha_n ctx ulong 0
  else
    put g_sha_n ctx n
  end
end

fn sha_upd ctx ulong buf view uchar * off ulong count ulong to void
  i = ulong 0
  while lt i count bound 100000000
    sha_upd_byte ctx get buf add off i
    i = add i 1
  end
end

fn sha_upd_shaio ctx ulong off ulong count ulong to void
  i = ulong 0
  while lt i count bound 100000000
    sha_upd_byte ctx get g_sha_io add off i
    i = add i 1
  end
end

fn sha_domain_init ctx ulong tag view uchar * to void
  sha_init ctx
  sha_upd ctx tag ulong 0 len tag
  sha_upd_byte ctx uchar 0
end

fn sha_final ctx ulong dst edit uchar 32 to void
  bits = mul get g_sha_len ctx ulong 8
  sha_upd_byte ctx uchar 128
  while ne get g_sha_n ctx ulong 56 bound 128
    sha_upd_byte ctx uchar 0
  end
  for i ulong 8
    sh = sub ulong 56 mul i ulong 8
    sha_upd_byte ctx uchar and shr bits sh ulong 255
  end
  hb = mul ctx ulong 8
  for i ulong 8
    hv = get g_sha_h add hb i
    p = mul i ulong 4
    put dst p uchar and shr hv 24 uint 255
    put dst add p 1 uchar and shr hv 16 uint 255
    put dst add p 2 uchar and shr hv 8 uint 255
    put dst add p 3 uchar and hv uint 255
  end
end

fn sha_hex d view uchar 32 dst edit uchar 64 to void
  for i ulong 32
    b = ulong get d i
    put dst mul i 2 get t_hexchars shr b 4
    put dst add mul i 2 1 get t_hexchars and b 15
  end
end

fn sha_file path view uchar * plen ulong dst edit uchar 32 to long
  fd = fopen path ulong 0 plen int 0 int 0
  if lt fd long 0
    ret long -1
  end
  sha_init ulong 0
  total = ulong 0
  done = false
  while not done bound 100000000
    r = read int fd g_sha_io ulong 0 ulong 65536
    if lt r long 0
      _fc = fclose int fd
      ret long -1
    end
    if eq r long 0
      done = true
    else
      ur = ulong r
      sha_upd_shaio ulong 0 ulong 0 ur
      total = add total ur
    end
  end
  _fc = fclose int fd
  sha_final ulong 0 dst
  ret long total
end

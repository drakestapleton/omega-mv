fn die_msg s view uchar * to void
  wr_str int 2 tm_s_err
  wr_str int 2 s
  wr_str int 2 t_nl
  exit int 2
end

fn add_problem to void
  wr_str int 2 tm_s_prob
  wr_str int 2 tm_e_prob
  wr_str int 2 t_nl
  put g_problems 0 add get g_problems 0 1
end

fn parse_u64_tok n ulong to ulong
  v = ulong 0
  i = ulong 0
  while lt i n bound 32
    c = get g_tok i
    if or lt c uchar 48 gt c uchar 57
      break
    end
    v = add mul v 10 sub ulong c 48
    i = add i 1
  end
  ret v
end

fn tok_eq tlen ulong pat view uchar * to bool
  if ne tlen len pat
    ret false
  end
  i = ulong 0
  while lt i tlen bound 64
    if ne get g_tok i get pat i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn parse_u64_line off ulong limit ulong to ulong
  v = ulong 0
  p = off
  while lt p limit bound 32
    c = get g_line p
    if or lt c uchar 48 gt c uchar 57
      break
    end
    v = add mul v 10 sub ulong c 48
    p = add p 1
  end
  ret v
end

fn line_find_pat llen ulong pat view uchar * to long
  pn = len pat
  if gt pn llen
    ret long -1
  end
  lim = sub llen pn
  i = ulong 0
  while le i lim bound 4096
    ok = true
    j = ulong 0
    while lt j pn bound 64
      if ne get g_line add i j get pat j
        ok = false
        break
      end
      j = add j 1
    end
    if ok
      ret long i
    end
    i = add i 1
  end
  ret long -1
end

note Find '"key": ' in g_line[0..llen), return offset right after ': ', or -1
fn line_find_key llen ulong key view uchar * to long
  kn = len key
  pat = new uchar 80 0
  put pat 0 uchar 34
  i = ulong 0
  while lt i kn bound 64
    put pat add i 1 get key i
    i = add i 1
  end
  put pat add kn 1 uchar 34
  put pat add kn 2 uchar 58
  put pat add kn 3 uchar 32
  pn = add kn 4
  r = line_find_pat llen part pat 0 pn
  if lt r long 0
    ret long -1
  end
  ret add r long pn
end

note Extract JSON string value into g_tok[0..), return length or -1
fn line_jstr llen ulong key view uchar * to long
  pos = line_find_key llen key
  if lt pos long 0
    ret long -1
  end
  p = ulong pos
  if ge p llen
    ret long -1
  end
  if ne get g_line p uchar 34
    ret long -1
  end
  p = add p 1
  k = ulong 0
  while lt p llen bound 2048
    c = get g_line p
    if eq c uchar 34
      ret long k
    end
    put g_tok k c
    k = add k 1
    p = add p 1
  end
  ret long -1
end

fn line_jnum llen ulong key view uchar * to long
  pos = line_find_key llen key
  if lt pos long 0
    ret long -1
  end
  ret long parse_u64_line ulong pos llen
end

note Line reader from fd using g_io64k
global g_lr_st ulong 2

fn lr_reset to void
  put g_lr_st 0 ulong 0
  put g_lr_st 1 ulong 0
end

note Read next line into g_line, return length (>=0), or -1 on EOF
fn lr_getline fd int to long
  n = ulong 0
  done = false
  while not done bound 4096
    pos = get g_lr_st 0
    lim = get g_lr_st 1
    if ge pos lim
      r = read fd g_io64k ulong 0 ulong 65536
      if le r long 0
        if eq n 0
          ret long -1
        end
        ret long n
      end
      pos = ulong 0
      lim = ulong r
      put g_lr_st 0 ulong 0
      put g_lr_st 1 lim
    end
    c = get g_io64k pos
    put g_lr_st 0 add pos 1
    if eq c uchar 10
      ret long n
    end
    if lt n 4095
      put g_line n c
      n = add n 1
    end
  end
  ret long n
end

fn pbuf_set_root suf view uchar * to ulong
  rn = get g_root_n 0
  i = ulong 0
  while lt i rn bound 1024
    put g_pbuf i get g_root i
    i = add i 1
  end
  sn = len suf
  j = ulong 0
  while lt j sn bound 1024
    put g_pbuf add rn j get suf j
    j = add j 1
  end
  ret add rn sn
end

fn pbuf_set_docs suf view uchar * to ulong
  dn = get g_docs_n 0
  i = ulong 0
  while lt i dn bound 1024
    put g_pbuf i get g_docs i
    i = add i 1
  end
  sn = len suf
  j = ulong 0
  while lt j sn bound 1024
    put g_pbuf add dn j get suf j
    j = add j 1
  end
  ret add dn sn
end

fn sha_pbuf plen ulong dst edit uchar 32 to long
  pb = new uchar 2048 0
  i = ulong 0
  while lt i plen bound 2048
    put pb i get g_pbuf i
    i = add i 1
  end
  ret sha_file pb plen dst
end

fn open_pbuf_ro plen ulong to long
  pb = new uchar 2048 0
  i = ulong 0
  while lt i plen bound 2048
    put pb i get g_pbuf i
    i = add i 1
  end
  ret fopen pb ulong 0 plen int 0 int 0
end

fn arg_eq idx ulong pat view uchar * to bool
  ab = new uchar 64 0
  n = argread idx ab ulong 0 ulong 64
  if ne n long len pat
    ret false
  end
  ret buf_eq ab pat len pat
end

fn parse_args to void
  ac = argcnt
  i = ulong 1
  uac = ulong ac
  while lt i uac bound 64
    if arg_eq i tm_a_docs
      i = add i 1
      if ge i uac
        die_msg tm_e_usage
      end
      n = argread i g_docs ulong 0 ulong 1024
      if lt n long 0
        die_msg tm_e_usage
      end
      put g_docs_n 0 ulong n
    else
      if arg_eq i tm_a_root
        i = add i 1
        if ge i uac
          die_msg tm_e_usage
        end
        n = argread i g_root ulong 0 ulong 1024
        if lt n long 0
          die_msg tm_e_usage
        end
        put g_root_n 0 ulong n
      else
        if arg_eq i tm_a_out
          i = add i 1
          if ge i uac
            die_msg tm_e_usage
          end
          n = argread i g_outp ulong 0 ulong 1024
          if lt n long 0
            die_msg tm_e_usage
          end
          put g_outp_n 0 ulong n
        else
          if arg_eq i tm_a_det
            i = add i 1
            if ge i uac
              die_msg tm_e_usage
            end
            n = argread i g_detp ulong 0 ulong 1024
            if lt n long 0
              die_msg tm_e_usage
            end
            put g_detp_n 0 ulong n
          else
            if arg_eq i tm_a_cdir
              i = add i 1
              if or ge i uac ge get g_ncd 0 8
                die_msg tm_e_usage
              end
              idx = get g_ncd 0
              n = argread i g_cdirs mul idx 1024 ulong 1024
              if lt n long 0
                die_msg tm_e_usage
              end
              put g_cdir_n idx ulong n
              put g_ncd 0 add idx 1
            else
              die_msg tm_e_usage
            end
          end
        end
      end
    end
    i = add i 1
  end
  if eq get g_docs_n 0 0
    die_msg tm_e_miss
  end
  if eq get g_root_n 0 0
    die_msg tm_e_miss
  end
  if eq get g_outp_n 0 0
    die_msg tm_e_miss
  end
  if eq get g_detp_n 0 0
    die_msg tm_e_miss
  end
  if eq get g_ncd 0 0
    pl = pbuf_set_root tm_s_cands
    k = ulong 0
    while lt k pl bound 1024
      put g_cdirs k get g_pbuf k
      k = add k 1
    end
    put g_cdir_n 0 pl
    put g_ncd 0 ulong 1
  end
end

fn check_manifests_and_profile to void
  d1 = new uchar 32 0
  d2 = new uchar 32 0
  hx = new uchar 64 0
  pv = is_profile_version
  if lt pv int 0
    die_msg tm_e_expid
  end
  pl = ulong 0
  if eq pv int 1
    pl = pbuf_set_docs tm_s_prof11
  else
    pl = pbuf_set_docs tm_s_prof10
  end
  if lt sha_pbuf pl d1 long 0
    die_msg tm_e_prof
  end
  sha_hex d1 hx
  for z ulong 32
    put g_prof_dig z get d1 z
  end
  for z ulong 64
    put g_prof_hex z get hx z
  end
  pl = pbuf_set_root tm_s_pdig
  fd = open_pbuf_ro pl
  if lt fd long 0
    die_msg tm_e_pdig
  end
  r = read int fd g_pd_hex ulong 0 ulong 64
  _fc = fclose int fd
  if ne r long 64
    die_msg tm_e_pdig
  end
  for z ulong 64
    if ne get g_pd_hex z get g_prof_hex z
      die_msg tm_e_pdig
    end
  end
  pl = pbuf_set_root tm_s_cman
  if lt sha_pbuf pl d1 long 0
    die_msg tm_e_cman
  end
  sha_hex d1 hx
  for z ulong 64
    put g_cm_hex z get hx z
  end
  pl = pbuf_set_docs tm_s_cman
  if lt sha_pbuf pl d2 long 0
    die_msg tm_e_cman
  end
  for z ulong 32
    if ne get d1 z get d2 z
      die_msg tm_e_cman
    end
  end
  pl = pbuf_set_root tm_s_dman
  if lt sha_pbuf pl d1 long 0
    die_msg tm_e_dman
  end
  sha_hex d1 hx
  for z ulong 64
    put g_dm_hex z get hx z
  end
  put g_dry 0 ulong 1
  fd = open_pbuf_ro pl
  if lt fd long 0
    die_msg tm_e_dman
  end
  lr_reset
  done = false
  while not done bound 10000
    ll = lr_getline int fd
    if lt ll long 0
      done = true
    else
      if ge line_find_pat ulong ll tm_s_sealed long 0
        put g_dry 0 ulong 0
      end
    end
  end
  _fc = fclose int fd
end

fn cand_index_tok tlen ulong to long
  nc = get g_nc 0
  i = ulong 0
  while lt i nc bound 16
    if eq get g_c_name_n i tlen
      base = mul i 64
      ok = true
      j = ulong 0
      while lt j tlen bound 64
        if ne get g_c_name add base j get g_tok j
          ok = false
          break
        end
        j = add j 1
      end
      if ok
        ret long i
      end
    end
    i = add i 1
  end
  ret long -1
end

fn cand_index_text pat view uchar * to long
  pn = len pat
  i = ulong 0
  while lt i pn bound 64
    put g_tok i get pat i
    i = add i 1
  end
  ret cand_index_tok pn
end

fn file_index g ulong idx ulong to long
  nf = get g_nf 0
  i = ulong 0
  while lt i nf bound 16
    if and eq get g_f_g i g eq get g_f_idx i idx
      ret long i
    end
    i = add i 1
  end
  ret long -1
end

fn load_one_cand llen ulong to void
  if lt line_find_pat llen tm_s_lmbits long 0
    ret
  end
  nl = line_jstr llen tm_s_kname
  if lt nl long 0
    ret
  end
  ci = get g_nc 0
  if ge ci 16
    die_msg tm_e_cman
  end
  un = ulong nl
  put g_c_name_n ci un
  for k ulong 64
    if lt k un
      put g_c_name add mul ci 64 k get g_tok k
    end
  end
  fl = line_jstr llen tm_s_kfile
  if lt fl long 0
    die_msg tm_e_cman
  end
  uf = ulong fl
  put g_c_file_n ci uf
  k = ulong 0
  while lt k uf bound 128
    put g_c_file add mul ci 128 k get g_tok k
    k = add k 1
  end
  if ne line_jstr llen tm_s_kfsha long 64
    die_msg tm_e_cman
  end
  for z ulong 64
    put g_c_fsha add mul ci 64 z get g_tok z
  end
  if ne line_jstr llen tm_s_kmdig long 64
    die_msg tm_e_cman
  end
  for z ulong 64
    put g_c_mdig add mul ci 64 z get g_tok z
  end
  lm = line_jnum llen tm_s_klmb
  by = line_jnum llen tm_s_kbytes
  if or lt lm long 0 lt by long 0
    die_msg tm_e_cman
  end
  put g_c_lmbits ci ulong lm
  put g_c_bytes ci ulong by
  put g_nc 0 add ci 1
end

fn load_manifest to void
  pl = pbuf_set_root tm_s_cman
  fd = open_pbuf_ro pl
  if lt fd long 0
    die_msg tm_e_cman
  end
  lr_reset
  done = false
  while not done bound 10000
    ll = lr_getline int fd
    if lt ll long 0
      done = true
    else
      load_one_cand ulong ll
    end
  end
  _fc = fclose int fd
  b2 = cand_index_text tm_s_b2
  if lt b2 long 0
    die_msg tm_e_b2
  end
  put g_b2 0 ulong b2
end

fn u64_to_seed fi ulong v ulong to void
  buf = new uchar 32 0
  if eq v 0
    put g_f_seed mul fi 64 uchar 48
    put g_f_seed_n fi ulong 1
    ret
  end
  n = ulong 0
  cur = v
  while gt cur 0 bound 32
    put buf n uchar add ulong 48 rem cur 10
    cur = div cur 10
    n = add n 1
  end
  put g_f_seed_n fi n
  i = ulong 0
  while lt i n bound 32
    put g_f_seed add mul fi 64 i get buf sub sub n 1 i
    i = add i 1
  end
end

fn load_one_dfile llen ulong to void
  if lt line_find_pat llen tm_s_kgrp_q long 0
    ret
  end
  fi = get g_nf 0
  if ge fi 16
    die_msg tm_e_dman
  end
  gg = line_jnum llen tm_s_kgrp
  ii = line_jnum llen tm_s_kidx
  ss = line_jnum llen tm_s_kseed
  if or lt gg long 0 or lt ii long 0 lt ss long 0
    die_msg tm_e_dman
  end
  put g_f_g fi ulong gg
  put g_f_idx fi ulong ii
  u64_to_seed fi ulong ss
  sl = line_jstr llen tm_s_ksha
  if lt sl long 0
    die_msg tm_e_dman
  end
  put g_f_msha_n fi ulong sl
  k = ulong 0
  while lt k ulong sl bound 65
    put g_f_msha add mul fi 65 k get g_tok k
    k = add k 1
  end
  pl = line_jstr llen tm_s_kpath
  if lt pl long 0
    die_msg tm_e_dman
  end
  put g_f_path_n fi ulong pl
  k = ulong 0
  while lt k ulong pl bound 1024
    put g_f_path add mul fi 1024 k get g_tok k
    k = add k 1
  end
  put g_nf 0 add fi 1
end

fn swap_u64_arr a ulong b ulong to void
  t = get g_f_g a
  put g_f_g a get g_f_g b
  put g_f_g b t
  t = get g_f_idx a
  put g_f_idx a get g_f_idx b
  put g_f_idx b t
  t = get g_f_seed_n a
  put g_f_seed_n a get g_f_seed_n b
  put g_f_seed_n b t
  t = get g_f_path_n a
  put g_f_path_n a get g_f_path_n b
  put g_f_path_n b t
  t = get g_f_msha_n a
  put g_f_msha_n a get g_f_msha_n b
  put g_f_msha_n b t
end

fn swap_files a ulong b ulong to void
  swap_u64_arr a b
  for k ulong 64
    c = get g_f_seed add mul a 64 k
    put g_f_seed add mul a 64 k get g_f_seed add mul b 64 k
    put g_f_seed add mul b 64 k c
  end
  for k ulong 65
    c = get g_f_msha add mul a 65 k
    put g_f_msha add mul a 65 k get g_f_msha add mul b 65 k
    put g_f_msha add mul b 65 k c
  end
  k = ulong 0
  while lt k 1024 bound 1024
    c = get g_f_path add mul a 1024 k
    put g_f_path add mul a 1024 k get g_f_path add mul b 1024 k
    put g_f_path add mul b 1024 k c
    k = add k 1
  end
end

fn sort_files to void
  nf = get g_nf 0
  a = ulong 0
  while lt a nf bound 16
    b = add a 1
    while lt b nf bound 16
      sw = false
      if lt get g_f_g b get g_f_g a
        sw = true
      else
        if eq get g_f_g b get g_f_g a
          if lt get g_f_idx b get g_f_idx a
            sw = true
          end
        end
      end
      if sw
        swap_files a b
      end
      b = add b 1
    end
    a = add a 1
  end
end

note Parse whitespace-separated token starting at g_lr_pos -> g_tok, return len
global g_tk_pos ulong 1

fn next_tok llen ulong to ulong
  p = get g_tk_pos 0
  while lt p llen bound 4096
    c = get g_line p
    if and ne c uchar 32 ne c uchar 9
      break
    end
    p = add p 1
  end
  n = ulong 0
  while lt p llen bound 2048
    c = get g_line p
    if or eq c uchar 32 eq c uchar 9
      break
    end
    put g_tok n c
    n = add n 1
    p = add p 1
  end
  put g_tk_pos 0 p
  ret n
end

fn build_tsy_path idx ulong g ulong j ulong ci ulong to void
  p = mul idx 1024
  k = ulong 0
  while lt k get g_root_n 0 bound 1024
    put g_st_tsy p get g_root k
    p = add p 1
    k = add k 1
  end
  k = ulong 0
  while lt k len tm_s_worksym bound 32
    put g_st_tsy p get tm_s_worksym k
    p = add p 1
    k = add k 1
  end
  put g_st_tsy p uchar add ulong 48 g
  p = add p 1
  put g_st_tsy p uchar 95
  p = add p 1
  put g_st_tsy p uchar 106
  p = add p 1
  put g_st_tsy p uchar add ulong 48 j
  p = add p 1
  put g_st_tsy p uchar 95
  p = add p 1
  k = ulong 0
  while lt k get g_c_name_n ci bound 64
    put g_st_tsy p get g_c_name add mul ci 64 k
    p = add p 1
    k = add k 1
  end
  for z ulong 4
    put g_st_tsy p get tm_s_tsy z
    p = add p 1
  end
  put g_st_tsy_n idx sub p mul idx 1024
end

fn set_st_path_tok which ulong idx ulong pl ulong to void
  off = mul idx 1024
  rn = get g_root_n 0
  k = ulong 0
  if eq which 0
    while lt k rn bound 1024
      put g_st_tps add off k get g_root k
      k = add k 1
    end
    put g_st_tps add off rn uchar 47
    k = ulong 0
    while lt k pl bound 1024
      put g_st_tps add off add add rn 1 k get g_tok k
      k = add k 1
    end
    put g_st_tps_n idx add add rn 1 pl
    ret
  end
  if eq which 1
    while lt k rn bound 1024
      put g_st_tcr add off k get g_root k
      k = add k 1
    end
    put g_st_tcr add off rn uchar 47
    k = ulong 0
    while lt k pl bound 1024
      put g_st_tcr add off add add rn 1 k get g_tok k
      k = add k 1
    end
    put g_st_tcr_n idx add add rn 1 pl
    ret
  end
  while lt k rn bound 1024
    put g_st_tca add off k get g_root k
    k = add k 1
  end
  put g_st_tca add off rn uchar 47
  k = ulong 0
  while lt k pl bound 1024
    put g_st_tca add off add add rn 1 k get g_tok k
    k = add k 1
  end
  put g_st_tca_n idx add add rn 1 pl
end

global g_tmp_sha uchar 192

fn copy_tps_shas idx ulong to void
  so = mul idx 64
  for z ulong 64
    put g_idx_sha0 add so z get g_tmp_sha z
    put g_idx_ttr add so z get g_tmp_sha add 64 z
    put g_idx_str add so z get g_tmp_sha add 128 z
  end
end

fn parse_tps_idx_line llen ulong to void
  if eq llen 0
    ret
  end
  if eq get g_line 0 uchar 35
    ret
  end
  put g_tk_pos 0 ulong 0
  for q ulong 3
    if ne next_tok llen 64
      die_msg tm_e_idx
    end
    for z ulong 64
      put g_tmp_sha add mul q 64 z get g_tok z
    end
  end
  g = parse_u64_tok next_tok llen
  j = parse_u64_tok next_tok llen
  ci = cand_index_tok next_tok llen
  fi = file_index g j
  if or lt ci long 0 lt fi long 0
    die_msg tm_e_idx
  end
  by = parse_u64_tok next_tok llen
  pl = next_tok llen
  if eq pl 0
    die_msg tm_e_idx
  end
  idx = add mul ulong ci 16 ulong fi
  set_st_path_tok ulong 0 idx pl
  build_tsy_path idx g j ulong ci
  copy_tps_shas idx
  put g_idx_by0 idx by
  put g_st_pres idx or get g_st_pres idx 1
end

fn finish_enc_idx is_r ulong idx ulong by ulong to void
  so = mul idx 64
  if eq is_r 1
    for z ulong 64
      put g_idx_sha1 add so z get g_tmp_sha z
    end
    put g_idx_by1 idx by
    put g_st_pres idx or get g_st_pres idx 2
  else
    for z ulong 64
      put g_idx_sha2 add so z get g_tmp_sha z
    end
    put g_idx_by2 idx by
    put g_st_pres idx or get g_st_pres idx 4
  end
end

fn parse_enc_idx_line llen ulong to void
  if eq llen 0
    ret
  end
  if eq get g_line 0 uchar 35
    ret
  end
  put g_tk_pos 0 ulong 0
  if ne next_tok llen 64
    die_msg tm_e_idx
  end
  for z ulong 64
    put g_tmp_sha z get g_tok z
  end
  is_r = ulong 0
  pl = next_tok llen
  if tok_eq pl tm_s_range
    is_r = ulong 1
  else
    if tok_eq pl tm_s_rans
      is_r = ulong 2
    else
      die_msg tm_e_idx
    end
  end
  g = parse_u64_tok next_tok llen
  fi = file_index g parse_u64_tok next_tok llen
  ci = cand_index_tok next_tok llen
  if or lt ci long 0 lt fi long 0
    die_msg tm_e_idx
  end
  by = parse_u64_tok next_tok llen
  pl = next_tok llen
  idx = add mul ulong ci 16 ulong fi
  set_st_path_tok is_r idx pl
  finish_enc_idx is_r idx by
end

fn load_bundle to void
  pl = pbuf_set_root tm_s_dman
  fd = open_pbuf_ro pl
  if lt fd long 0
    die_msg tm_e_dman
  end
  lr_reset
  done = false
  while not done bound 10000
    ll = lr_getline int fd
    if lt ll long 0
      done = true
    else
      load_one_dfile ulong ll
    end
  end
  _fc = fclose int fd
  sort_files

  pl = pbuf_set_root tm_s_tpsidx
  fd = open_pbuf_ro pl
  if lt fd long 0
    die_msg tm_e_idx
  end
  lr_reset
  done = false
  while not done bound 10000
    ll = lr_getline int fd
    if lt ll long 0
      done = true
    else
      parse_tps_idx_line ulong ll
    end
  end
  _fc = fclose int fd

  pl = pbuf_set_root tm_s_encidx
  fd = open_pbuf_ro pl
  if lt fd long 0
    die_msg tm_e_idx
  end
  lr_reset
  done = false
  while not done bound 10000
    ll = lr_getline int fd
    if lt ll long 0
      done = true
    else
      parse_enc_idx_line ulong ll
    end
  end
  _fc = fclose int fd

  nc = get g_nc 0
  nf = get g_nf 0
  ci = ulong 0
  while lt ci nc bound 16
    fi = ulong 0
    while lt fi nf bound 16
      if ne get g_st_pres add mul ci 16 fi 7
        die_msg tm_e_idx
      end
      fi = add fi 1
    end
    ci = add ci 1
  end
end

fn load_one_ctr1 fi ulong to void
  pbuf = new uchar 1024 0
  d = new uchar 32 0
  hx = new uchar 64 0
  pl = get g_f_path_n fi
  k = ulong 0
  while lt k pl bound 1024
    put pbuf k get g_f_path add mul fi 1024 k
    k = add k 1
  end
  if ne is_ctr1_load fi pbuf pl int 0
    die_msg tm_e_ctr1
  end
  for z ulong 32
    put d z get g_f_sha add mul fi 32 z
  end
  sha_hex d hx
  ml = get g_f_msha_n fi
  is_dash = false
  if eq ml 1
    is_dash = eq get g_f_msha mul fi 65 uchar 45
  end
  if and eq get g_dry 0 0 is_dash
    die_msg tm_e_ctr1
  end
  if not is_dash
    if ne ml 64
      die_msg tm_e_ctr1
    end
    for z ulong 64
      if ne get g_f_msha add mul fi 65 z get hx z
        die_msg tm_e_ctr1
      end
    end
  end
end

fn load_all_ctr1 to void
  fi = ulong 0
  while lt fi get g_nf 0 bound 16
    load_one_ctr1 fi
    fi = add fi 1
  end
end

note ================= scoring helpers =================

fn read_tcr_file idx ulong to long
  pbuf = new uchar 1024 0
  pl = get g_st_tcr_n idx
  k = ulong 0
  while lt k pl bound 1024
    put pbuf k get g_st_tcr add mul idx 1024 k
    k = add k 1
  end
  fd = fopen pbuf ulong 0 pl int 0 int 0
  if lt fd long 0
    ret long -1
  end
  sz = fseek int fd long 0 int 2
  if lt sz long 0
    _fc = fclose int fd
    ret long -1
  end
  _fc = fseek int fd long 0 int 0
  usz = ulong sz
  if gt usz 0
    _e = enlarge g_tcr usz
  else
    _e = enlarge g_tcr ulong 1
  end
  p = ulong 0
  while lt p usz bound 10000000
    r = read int fd g_tcr p sub usz p
    if le r long 0
      _fc = fclose int fd
      ret long -1
    end
    p = add p ulong r
  end
  _fc = fclose int fd
  ret sz
end

fn read_tca_file idx ulong to long
  pbuf = new uchar 1024 0
  pl = get g_st_tca_n idx
  k = ulong 0
  while lt k pl bound 1024
    put pbuf k get g_st_tca add mul idx 1024 k
    k = add k 1
  end
  fd = fopen pbuf ulong 0 pl int 0 int 0
  if lt fd long 0
    ret long -1
  end
  sz = fseek int fd long 0 int 2
  if lt sz long 0
    _fc = fclose int fd
    ret long -1
  end
  _fc = fseek int fd long 0 int 0
  usz = ulong sz
  if gt usz 0
    _e = enlarge g_tca usz
  else
    _e = enlarge g_tca ulong 1
  end
  p = ulong 0
  while lt p usz bound 10000000
    r = read int fd g_tca p sub usz p
    if le r long 0
      _fc = fclose int fd
      ret long -1
    end
    p = add p ulong r
  end
  _fc = fclose int fd
  ret sz
end

fn rdle8_tcr off ulong to ulong
  v = ulong 0
  i = ulong 8
  while gt i 0 bound 8
    i = sub i 1
    v = or shl v 8 ulong get g_tcr add off i
  end
  ret v
end

fn rdle8_tca off ulong to ulong
  v = ulong 0
  i = ulong 8
  while gt i 0 bound 8
    i = sub i 1
    v = or shl v 8 ulong get g_tca add off i
  end
  ret v
end

fn check_tcr_hdr tcrL ulong evn ulong to bool
  if lt tcrL 56
    ret false
  end
  if ne get g_tcr 0 uchar 84
    ret false
  end
  if ne get g_tcr 1 uchar 67
    ret false
  end
  if ne get g_tcr 2 uchar 82
    ret false
  end
  if ne get g_tcr 3 uchar 49
    ret false
  end
  if ne get g_tcr 4 uchar 1
    ret false
  end
  if ne get g_tcr 5 uchar 1
    ret false
  end
  if ne get g_tcr 6 uchar 0
    ret false
  end
  if ne get g_tcr 7 uchar 0
    ret false
  end
  if ne rdle8_tcr ulong 8 evn
    ret false
  end
  ret eq tcrL add ulong 56 rdle8_tcr ulong 48
end

fn check_tca_hdr tcaL ulong evn ulong to bool
  if lt tcaL 56
    ret false
  end
  if ne get g_tca 0 uchar 84
    ret false
  end
  if ne get g_tca 1 uchar 67
    ret false
  end
  if ne get g_tca 2 uchar 65
    ret false
  end
  if ne get g_tca 3 uchar 49
    ret false
  end
  if ne get g_tca 4 uchar 1
    ret false
  end
  if ne get g_tca 5 uchar 2
    ret false
  end
  if ne get g_tca 6 uchar 0
    ret false
  end
  if ne get g_tca 7 uchar 0
    ret false
  end
  if ne rdle8_tca ulong 8 evn
    ret false
  end
  ret eq tcaL add ulong 56 rdle8_tca ulong 48
end

fn tps_read_byte fd int to int
  pos = get g_tps_st 0
  lim = get g_tps_st 1
  if ge pos lim
    r = read fd g_tps_io ulong 0 ulong 65536
    if le r long 0
      ret int -1
    end
    pos = ulong 0
    lim = ulong r
    put g_tps_st 0 ulong 0
    put g_tps_st 1 lim
  end
  b = int get g_tps_io pos
  put g_tps_st 0 add pos 1
  ret b
end

fn tps_cmp_slice fd int buf view uchar * n ulong to bool
  ok = true
  i = ulong 0
  while lt i n bound 256
    b = tps_read_byte fd
    if lt b int 0
      ret false
    end
    if ne b int get buf i
      ok = false
    end
    i = add i 1
  end
  ret ok
end

fn put_le buf edit uchar * off ulong v ulong n ulong to void
  i = ulong 0
  while lt i n bound 8
    put buf add off i uchar and shr v mul i 8 ulong 255
    i = add i 1
  end
end

fn build_tps_hdr hdr edit uchar 128 evn ulong fi ulong to void
  for z ulong 128
    put hdr z uchar 0
  end
  put hdr 0 uchar 84
  put hdr 1 uchar 80
  put hdr 2 uchar 83
  put hdr 3 uchar 49
  put hdr 4 uchar 1
  put hdr 6 uchar 9
  put hdr 7 uchar 16
  put_le hdr ulong 12 evn ulong 8
  put_le hdr ulong 20 ulong 42 ulong 4
  for z ulong 32
    put hdr add 28 z get g_prof_dig z
    put hdr add 60 z get g_m_mdig z
    put hdr add 92 z get g_f_sha add mul fi 32 z
  end
end

fn score_step_rec idx ulong t ulong ridx ulong fd int to void
  rec = new uchar 42 0
  put_le rec ulong 0 t ulong 8
  put_le rec ulong 8 get g_score_st 4 ulong 8
  put_le rec ulong 16 get g_score_st 0 ulong 4
  put_le rec ulong 20 ulong 65536 ulong 4
  for j ulong 9
    put_le rec add 24 mul j 2 ulong is_model_row_q ridx j ulong 2
  end
  sha_upd ulong 0 rec ulong 0 ulong 42
  if ge fd int 0
    if eq get g_r_tpsm idx long 1
      if not tps_cmp_slice fd rec ulong 42
        put g_r_tpsm idx long 0
      end
    end
  end
end

fn score_step_dec idx ulong ridx ulong s ulong to void
  qs = ulong is_model_row_q ridx s
  ubv = get g_ub_q16 qs
  altv = ubv
  if or eq qs 43481 eq qs 46819
    altv = sub ubv 1
    put g_r_altdiff idx add get g_r_altdiff idx 1
  end
  put g_r_ideal idx add get g_r_ideal idx ubv
  put g_r_alt idx add get g_r_alt idx altv
  put g_score_st 1 bitcast ulong add bitcast long get g_score_st 1 ubv
  if ne get g_score_st 2 0
    xr = is_rdec_step ridx ulong 9
    if ne xr int s
      if ge xr int 0
        add_problem
        put g_rdec 4 ulong 116
      end
      put g_score_st 2 ulong 0
    end
  end
  if ne get g_score_st 3 0
    xa = is_adec_step ridx ulong 9
    if ne xa int s
      if ge xa int 0
        add_problem
        put g_adec 3 ulong 116
      end
      put g_score_st 3 ulong 0
    end
  end
  put g_wp 4 get g_wp 3
  put g_wp 3 get g_wp 2
  put g_wp 2 get g_wp 1
  put g_wp 1 get g_wp 0
  put g_wp 0 s
end

fn score_step idx ulong fi ulong t ulong fd int to void
  wp = new ulong 5 0
  ei = add get g_f_evoff fi t
  if ne get g_ev_first ei uchar 0
    if gt t 0
      cr = get g_score_st 0
      put g_crumb_ub add get g_r_croff idx cr bitcast long get g_score_st 1
      put g_score_st 0 add cr 1
      put g_score_st 1 ulong 0
    end
    for k ulong 5
      put g_wp k ulong 9
    end
  end
  for k ulong 5
    put wp k get g_wp k
  end
  key = is_key ei wp get g_score_st 0
  put g_score_st 4 key
  ridx = is_model_row_idx key
  if lt ridx get g_m_meta 4
    put g_r_rhit idx add get g_r_rhit idx 1
  end
  score_step_rec idx t ridx fd
  score_step_dec idx ridx ulong get g_ev_sym ei
end

fn tsy_cmp_syms fd int fi ulong to bool
  evoff = get g_f_evoff fi
  evn = get g_f_evn fi
  t = ulong 0
  while lt t evn bound 100000000
    if ne tps_read_byte fd int get g_ev_sym add evoff t
      ret false
    end
    t = add t 1
  end
  ret true
end

fn tsy_verify_file idx ulong fi ulong h view uchar 56 tsyd view uchar 32 to void
  pbuf = new uchar 1024 0
  pl = get g_st_tsy_n idx
  k = ulong 0
  while lt k pl bound 1024
    put pbuf k get g_st_tsy add mul idx 1024 k
    k = add k 1
  end
  fd = fopen pbuf ulong 0 pl int 0 int 0
  if lt fd long 0
    put g_r_tsym idx long 0
    ret
  end
  put g_tps_st 0 ulong 0
  put g_tps_st 1 ulong 0
  ok = tps_cmp_slice int fd h ulong 56
  if ok
    ok = tsy_cmp_syms int fd fi
  end
  if ok
    ok = tps_cmp_slice int fd tsyd ulong 32
  end
  if ok
    if ge tps_read_byte int fd int 0
      ok = false
    end
  end
  _fc = fclose int fd
  if ok
    put g_r_tsym idx long 1
  else
    put g_r_tsym idx long 0
  end
end

fn check_tsy idx ulong fi ulong to void
  h = new uchar 56 0
  tsyd = new uchar 32 0
  hx = new uchar 64 0
  evn = get g_f_evn fi
  evoff = get g_f_evoff fi
  for z ulong 56
    put h z uchar 0
  end
  put h 0 uchar 84
  put h 1 uchar 83
  put h 2 uchar 89
  put h 3 uchar 49
  put h 4 uchar 1
  put h 6 uchar 9
  put_le h ulong 8 evn ulong 8
  for z ulong 32
    put h add 24 z get g_f_sha add mul fi 32 z
  end
  sha_domain_init ulong 0 tm_s_symbols
  sha_upd ulong 0 h ulong 0 ulong 56
  t = ulong 0
  while lt t evn bound 100000000
    sha_upd_byte ulong 0 get g_ev_sym add evoff t
    t = add t 1
  end
  sha_final ulong 0 tsyd
  sha_hex tsyd hx
  for z ulong 64
    put g_r_tsydig add mul idx 64 z get hx z
  end
  tsy_verify_file idx fi h tsyd
end

fn score_one_check_crumbs idx ulong fi ulong to void
  crs = get g_f_crumbs fi
  croff = get g_r_croff idx
  if gt get g_f_evn fi 0
    cr = get g_score_st 0
    put g_crumb_ub add croff cr bitcast long get g_score_st 1
    put g_score_st 0 add cr 1
  end
  if ne get g_score_st 0 crs
    die_msg tm_e_cr
  end
  csum = long 0
  ci2 = ulong 0
  while lt ci2 crs bound 10000000
    csum = add csum get g_crumb_ub add croff ci2
    ci2 = add ci2 1
  end
  if ne csum get g_r_ideal idx
    die_msg tm_e_cr
  end
end

fn score_one_finish idx ulong fi ulong tf long to void
  tpsd = new uchar 32 0
  hx = new uchar 64 0
  score_one_check_crumbs idx fi
  sha_final ulong 0 tpsd
  sha_hex tpsd hx
  for z ulong 64
    put g_r_tpsdig add mul idx 64 z get hx z
  end
  if ge tf long 0
    if eq get g_r_tpsm idx long 1
      if not tps_cmp_slice int tf tpsd ulong 32
        put g_r_tpsm idx long 0
      end
      if ge tps_read_byte int tf int 0
        put g_r_tpsm idx long 0
      end
    end
    _fc = fclose int tf
  end
  bok = and ge get g_r_rbytes idx 56 ge get g_r_abytes idx 56
  if bok
    for z ulong 32
      if ne get g_tcr add 16 z get tpsd z
        bok = false
      end
      if ne get g_tca add 16 z get tpsd z
        bok = false
      end
    end
  end
  if bok
    put g_r_bok idx ulong 1
  else
    put g_r_bok idx ulong 0
  end
  if and ne get g_score_st 2 0 and eq is_rdec_finish int 0 bok
    put g_r_rok idx ulong 1
  else
    put g_r_rok idx ulong 0
    add_problem
  end
  if and ne get g_score_st 3 0 and eq is_adec_finish int 0 bok
    put g_r_aok idx ulong 1
  else
    put g_r_aok idx ulong 0
    add_problem
  end
end

fn score_one_open_tps idx ulong fi ulong to long
  hdr = new uchar 128 0
  pbuf = new uchar 1024 0
  build_tps_hdr hdr get g_f_evn fi fi
  sha_domain_init ulong 0 tm_s_pstream
  sha_upd ulong 0 hdr ulong 0 ulong 128
  pl = get g_st_tps_n idx
  k = ulong 0
  while lt k pl bound 1024
    put pbuf k get g_st_tps add mul idx 1024 k
    k = add k 1
  end
  tf = fopen pbuf ulong 0 pl int 0 int 0
  put g_tps_st 0 ulong 0
  put g_tps_st 1 ulong 0
  if lt tf long 0
    put g_r_tpsm idx long 0
  else
    if tps_cmp_slice int tf hdr ulong 128
      put g_r_tpsm idx long 1
    else
      put g_r_tpsm idx long 0
    end
  end
  ret tf
end

fn score_one ci ulong fi ulong to void
  idx = add mul ci 16 fi
  evn = get g_f_evn fi
  crs = get g_f_crumbs fi
  croff = get g_crumb_tot 0
  put g_r_croff idx croff
  _e = enlarge g_crumb_ub add croff add crs 1
  put g_crumb_tot 0 add croff crs
  put g_r_ideal idx long 0
  put g_r_alt idx long 0
  put g_r_altdiff idx ulong 0
  put g_r_rhit idx ulong 0
  tf = score_one_open_tps idx fi
  tcrL = read_tcr_file idx
  tcaL = read_tca_file idx
  if or lt tcrL long 0 lt tcaL long 0
    die_msg tm_e_tcr
  end
  put g_r_rbytes idx ulong tcrL
  put g_r_abytes idx ulong tcaL
  put g_score_st 2 ulong 0
  put g_score_st 3 ulong 0
  if check_tcr_hdr ulong tcrL evn
    _ri = is_rdec_init ulong 56 sub ulong tcrL 56
    put g_score_st 2 ulong 1
  else
    add_problem
  end
  if check_tca_hdr ulong tcaL evn
    _ai = is_adec_init ulong 56 sub ulong tcaL 56
    put g_score_st 3 ulong 1
  else
    add_problem
  end
  for z ulong 5
    put g_wp z ulong 9
  end
  put g_score_st 0 ulong 0
  put g_score_st 1 ulong 0
  t = ulong 0
  while lt t evn bound 100000000
    score_step idx fi t int tf
    t = add t 1
  end
  score_one_finish idx fi tf
  check_tsy idx fi
end

fn cand_verify_meta ci ulong to void
  md = new uchar 32 0
  hx = new uchar 64 0
  for z ulong 32
    put md z get g_m_fsha z
  end
  sha_hex md hx
  for z ulong 64
    if ne get hx z get g_c_fsha add mul ci 64 z
      die_msg tm_e_cand
    end
  end
  for z ulong 32
    put md z get g_m_mdig z
  end
  sha_hex md hx
  for z ulong 64
    if ne get hx z get g_c_mdig add mul ci 64 z
      die_msg tm_e_cand
    end
  end
  if or ne get g_m_meta 6 get g_c_lmbits ci ne get g_m_meta 0 ulong 9
    die_msg tm_e_cand
  end
end

fn load_and_score_cand ci ulong to void
  pbuf = new uchar 2048 0
  r = int -100
  d = ulong 0
  while and lt d get g_ncd 0 eq r int -100 bound 8
    dn = get g_cdir_n d
    k = ulong 0
    while lt k dn bound 1024
      put pbuf k get g_cdirs add mul d 1024 k
      k = add k 1
    end
    put pbuf dn uchar 47
    k = ulong 0
    while lt k get g_c_file_n ci bound 128
      put pbuf add add dn 1 k get g_c_file add mul ci 128 k
      k = add k 1
    end
    r = is_model_load pbuf add add dn 1 get g_c_file_n ci
    d = add d 1
  end
  if ne r int 0
    die_msg tm_e_cand
  end
  cand_verify_meta ci
  fi = ulong 0
  while lt fi get g_nf 0 bound 16
    score_one ci fi
    fi = add fi 1
  end
end

fn check_index_one idx ulong which ulong to void
  pbuf = new uchar 1024 0
  pl = ulong 0
  if eq which 0
    pl = get g_st_tps_n idx
    k = ulong 0
    while lt k pl bound 1024
      put pbuf k get g_st_tps add mul idx 1024 k
      k = add k 1
    end
  else
    if eq which 1
      pl = get g_st_tcr_n idx
      k = ulong 0
      while lt k pl bound 1024
        put pbuf k get g_st_tcr add mul idx 1024 k
        k = add k 1
      end
    else
      pl = get g_st_tca_n idx
      k = ulong 0
      while lt k pl bound 1024
        put pbuf k get g_st_tca add mul idx 1024 k
        k = add k 1
      end
    end
  end
  d = new uchar 32 0
  hx = new uchar 64 0
  by = sha_file pbuf pl d
  if lt by long 0
    add_problem
    ret
  end
  sha_hex d hx
  so = mul idx 64
  ok = true
  if eq which 0
    ok = eq ulong by get g_idx_by0 idx
    for z ulong 64
      if ne get hx z get g_idx_sha0 add so z
        ok = false
      end
    end
  else
    if eq which 1
      ok = eq ulong by get g_idx_by1 idx
      for z ulong 64
        if ne get hx z get g_idx_sha1 add so z
          ok = false
        end
      end
    else
      ok = eq ulong by get g_idx_by2 idx
      for z ulong 64
        if ne get hx z get g_idx_sha2 add so z
          ok = false
        end
      end
    end
  end
  if not ok
    add_problem
  end
end

fn verify_one_idx idx ulong to void
  so = mul idx 64
  ok1 = true
  ok2 = true
  for z ulong 64
    if ne get g_r_tpsdig add so z get g_idx_ttr add so z
      ok1 = false
    end
    if ne get g_r_tsydig add so z get g_idx_str add so z
      ok2 = false
    end
  end
  if not ok1
    add_problem
  end
  if not ok2
    add_problem
  end
  if ne get g_r_tpsm idx long 1
    add_problem
  end
  if ne get g_r_tsym idx long 1
    add_problem
  end
  check_index_one idx ulong 0
  check_index_one idx ulong 1
  check_index_one idx ulong 2
end

fn verify_all_indices to void
  fi = ulong 0
  while lt fi get g_nf 0 bound 16
    ci = ulong 0
    while lt ci get g_nc 0 bound 16
      verify_one_idx add mul ci 16 fi
      ci = add ci 1
    end
    fi = add fi 1
  end
end

fn count_crumbs fi ulong to void
  crs = get g_f_crumbs fi
  _e = enlarge g_cn add crs 1
  k = ulong 0
  while le k crs bound 10000000
    put g_cn k ulong 0
    k = add k 1
  end
  evoff = get g_f_evoff fi
  k = ulong 0
  t = ulong 0
  while lt t get g_f_evn fi bound 100000000
    if gt t 0
      if ne get g_ev_first add evoff t uchar 0
        k = add k 1
      end
    end
    put g_cn k add get g_cn k 1
    t = add t 1
  end
end

fn write_crumbs_file fd int fi ulong to void
  count_crumbs fi
  crs = get g_f_crumbs fi
  k = ulong 0
  while lt k crs bound 10000000
    ci = ulong 0
    while lt ci get g_nc 0 bound 16
      wr_u64 fd get g_f_g fi
      wr_str fd tm_s_sp
      wr_u64 fd get g_f_idx fi
      wr_str fd tm_s_sp
      wr_u64 fd k
      wr_str fd tm_s_sp
      wr_u64 fd get g_cn k
      wr_str fd tm_s_sp
      _wn = write fd g_c_name mul ci 64 get g_c_name_n ci
      wr_str fd tm_s_sp
      off = get g_r_croff add mul ci 16 fi
      wr_i64 fd get g_crumb_ub add off k
      wr_str fd t_nl
      ci = add ci 1
    end
    k = add k 1
  end
end

fn write_crumbs_dump to void
  pbuf = new uchar 1100 0
  dn = get g_detp_n 0
  k = ulong 0
  while lt k dn bound 1024
    put pbuf k get g_detp k
    k = add k 1
  end
  for z ulong 11
    put pbuf add dn z get tm_s_crumbs z
  end
  fd = fopen pbuf ulong 0 add dn 11 int 577 int 420
  if lt fd long 0
    die_msg tm_e_out
  end
  fi = ulong 0
  while lt fi get g_nf 0 bound 16
    write_crumbs_file int fd fi
    fi = add fi 1
  end
  _fc = fclose int fd
end

note ================= heapsort for g_tb[0..9999] =================

fn sift_down start ulong endi ulong to void
  root = start
  done = false
  while not done bound 32
    child = add mul root 2 1
    if gt child endi
      done = true
    else
      sw = root
      if lt get g_tb sw get g_tb child
        sw = child
      end
      if le add child 1 endi
        if lt get g_tb sw get g_tb add child 1
          sw = add child 1
        end
      end
      if eq sw root
        done = true
      else
        tmp = get g_tb root
        put g_tb root get g_tb sw
        put g_tb sw tmp
        root = sw
      end
    end
  end
end

fn sort_tb to void
  s = ulong 5000
  while gt s 0 bound 5001
    s = sub s 1
    sift_down s ulong 9999
  end
  e = ulong 9999
  while gt e 0 bound 10000
    tmp = get g_tb e
    put g_tb e get g_tb 0
    put g_tb 0 tmp
    e = sub e 1
    sift_down ulong 0 e
  end
end

note ================= JSON output helpers =================

fn wr_val_prefix ofd int to void
  if eq get g_first_val 0 0
    wr_str ofd tm_j_cnl
  end
  put g_first_val 0 ulong 0
  wr_str ofd tm_j_v1
end

fn wr_val_suffix ofd int v long to void
  wr_str ofd tm_j_v2
  wr_i64 ofd v
  wr_str ofd tm_j_v3
end

fn wr_fval ofd int fi ulong ci ulong suf view uchar * v long to void
  wr_val_prefix ofd
  wr_str ofd tm_s_g
  wr_u64 ofd get g_f_g fi
  wr_str ofd tm_s_f
  wr_u64 ofd get g_f_idx fi
  wr_str ofd tm_s_dot
  _w = write ofd g_c_name mul ci 64 get g_c_name_n ci
  wr_str ofd suf
  wr_val_suffix ofd v
end

fn wr_gval ofd int g ulong ci ulong suf view uchar * v long to void
  wr_val_prefix ofd
  wr_str ofd tm_s_g
  wr_u64 ofd g
  wr_str ofd tm_s_dot
  _w = write ofd g_c_name mul ci 64 get g_c_name_n ci
  wr_str ofd suf
  wr_val_suffix ofd v
end

fn abs_i64 x long to long
  if lt x long 0
    ret neg x
  end
  ret x
end

fn write_det_cand_env dfd int idx ulong evn long to void
  idv = get g_r_ideal idx
  ovr = sub mul mul long get g_r_rbytes idx 8 long 1000000 idv
  ova = sub mul mul long get g_r_abytes idx 8 long 1000000 idv
  band = add long 64000000 mul long 1000 evn
  wr_str dfd tm_j_dc14
  wr_i64 dfd ovr
  wr_str dfd tm_j_dc15
  wr_i64 dfd ova
  wr_str dfd tm_j_dc16
  if le abs_i64 sub ovr long 448000000 band
    wr_u64 dfd ulong 1
  else
    wr_u64 dfd ulong 0
  end
  wr_str dfd tm_j_dc17
  if le abs_i64 sub ova long 448000000 band
    wr_u64 dfd ulong 1
  else
    wr_u64 dfd ulong 0
  end
end

fn write_det_cand dfd int ofd int fi ulong ci ulong last bool to void
  idx = add mul ci 16 fi
  wr_fval ofd fi ci tm_k_ideal get g_r_ideal idx
  wr_fval ofd fi ci tm_k_rbytes long get g_r_rbytes idx
  wr_fval ofd fi ci tm_k_abytes long get g_r_abytes idx
  wr_str dfd tm_j_dc1
  _w = write dfd g_c_name mul ci 64 get g_c_name_n ci
  wr_str dfd tm_j_dc2
  wr_i64 dfd get g_r_ideal idx
  wr_str dfd tm_j_dc3
  wr_i64 dfd get g_r_alt idx
  wr_str dfd tm_j_dc4
  wr_u64 dfd get g_r_altdiff idx
  wr_str dfd tm_j_dc5
  wr_u64 dfd get g_r_rhit idx
  wr_str dfd tm_j_dc6
  _w = write dfd g_r_tpsdig mul idx 64 ulong 64
  wr_str dfd tm_j_dc7
  wr_i64 dfd get g_r_tpsm idx
  wr_str dfd tm_j_dc8
  wr_i64 dfd get g_r_tsym idx
  wr_str dfd tm_j_dc9
  wr_u64 dfd get g_r_rbytes idx
  wr_str dfd tm_j_dc10
  wr_u64 dfd get g_r_abytes idx
  wr_str dfd tm_j_dc11
  wr_u64 dfd get g_r_rok idx
  wr_str dfd tm_j_dc12
  wr_u64 dfd get g_r_aok idx
  wr_str dfd tm_j_dc13
  wr_u64 dfd get g_r_bok idx
  write_det_cand_env dfd idx long get g_f_evn fi
  wr_str dfd tm_j_dcend
  if not last
    wr_str dfd tm_s_comma
  end
  wr_str dfd t_nl
end

fn group_cand_boot g ulong cn ulong lmd long to ulong
  seed = add or shl ulong 0x45585030 32 ulong 0x30315543 g
  put g_rng_st 0 seed
  gt0 = ulong 0
  b = ulong 0
  while lt b 10000 bound 10000
    sm = neg lmd
    s = ulong 0
    while lt s cn bound 10000000
      sm = add sm get g_dvec is_draw cn
      s = add s 1
    end
    put g_tb b sm
    if gt sm long 0
      gt0 = add gt0 1
    end
    b = add b 1
  end
  sort_tb
  ret gt0
end

fn group_cand_emit ofd int g ulong ci ulong tv long to void
  b2 = get g_b2 0
  wr_gval ofd g ci tm_k_lmbits long get g_c_lmbits ci
  wr_gval ofd g ci tm_k_ideal get g_g_ideal ci
  wr_gval ofd g ci tm_k_rbits get g_g_rbits ci
  wr_gval ofd g ci tm_k_abits get g_g_abits ci
  wr_gval ofd g ci tm_k_tip tv
  wr_gval ofd g ci tm_k_til get g_tb 250
  wr_gval ofd g ci tm_k_tih get g_tb 9749
  ov = sub mul get g_g_rbits ci long 1000000 get g_g_ideal ci
  ov = sub ov sub mul get g_g_rbits b2 long 1000000 get g_g_ideal b2
  wr_gval ofd g ci tm_k_trp sub tv ov
  wr_gval ofd g ci tm_k_trl sub get g_tb 250 ov
  wr_gval ofd g ci tm_k_trh sub get g_tb 9749 ov
  ov = sub mul get g_g_abits ci long 1000000 get g_g_ideal ci
  ov = sub ov sub mul get g_g_abits b2 long 1000000 get g_g_ideal b2
  wr_gval ofd g ci tm_k_tap sub tv ov
  wr_gval ofd g ci tm_k_tal sub get g_tb 250 ov
  wr_gval ofd g ci tm_k_tah sub get g_tb 9749 ov
end

fn fill_dvec g ulong ci ulong to void
  b2 = get g_b2 0
  p = ulong 0
  fi = ulong 0
  while lt fi get g_nf 0 bound 16
    if eq get g_f_g fi g
      o_b2 = get g_r_croff add mul b2 16 fi
      o_ci = get g_r_croff add mul ci 16 fi
      c = ulong 0
      while lt c get g_f_crumbs fi bound 10000000
        vb = get g_crumb_ub add o_b2 c
        vc = get g_crumb_ub add o_ci c
        put g_dvec p sub vb vc
        p = add p 1
        c = add c 1
      end
    end
    fi = add fi 1
  end
end

fn write_group_cand_det dfd int ci ulong gt0 ulong to void
  wr_str dfd tm_j_gc1
  _w = write dfd g_c_name mul ci 64 get g_c_name_n ci
  wr_str dfd tm_j_gc2
  wr_u64 dfd gt0
  wr_str dfd tm_j_gc3
  wr_i64 dfd sub mul get g_g_rbits ci long 1000000 get g_g_ideal ci
  wr_str dfd tm_j_gc4
  wr_i64 dfd sub mul get g_g_abits ci long 1000000 get g_g_ideal ci
  wr_str dfd tm_j_dcend
  if lt add ci 1 get g_nc 0
    wr_str dfd tm_s_comma
  end
  wr_str dfd t_nl
end

fn write_group_cand ofd int dfd int g ulong cn ulong ci ulong to void
  lmd = sub long get g_c_lmbits ci long get g_c_lmbits get g_b2 0
  lmd = mul lmd long 1000000
  fill_dvec g ci
  tv = neg lmd
  s = ulong 0
  while lt s cn bound 10000000
    tv = add tv get g_dvec s
    s = add s 1
  end
  gt0 = group_cand_boot g cn lmd
  group_cand_emit ofd g ci tv
  write_group_cand_det dfd ci gt0
end

fn sum_group_cands g ulong to void
  ci = ulong 0
  while lt ci get g_nc 0 bound 16
    put g_g_ideal ci long 0
    put g_g_rbits ci long 0
    put g_g_abits ci long 0
    fi = ulong 0
    while lt fi get g_nf 0 bound 16
      if eq get g_f_g fi g
        idx = add mul ci 16 fi
        put g_g_ideal ci add get g_g_ideal ci get g_r_ideal idx
        put g_g_rbits ci add get g_g_rbits ci mul long get g_r_rbytes idx 8
        put g_g_abits ci add get g_g_abits ci mul long get g_r_abytes idx 8
      end
      fi = add fi 1
    end
    ci = add ci 1
  end
end

fn write_group ofd int dfd int g ulong to void
  cn = ulong 0
  evs = ulong 0
  any = false
  fi = ulong 0
  while lt fi get g_nf 0 bound 16
    if eq get g_f_g fi g
      cn = add cn get g_f_crumbs fi
      evs = add evs get g_f_evn fi
      any = true
    end
    fi = add fi 1
  end
  if not any
    ret
  end
  if eq cn 0
    die_msg tm_e_cr
  end
  _e = enlarge g_dvec cn
  wr_val_prefix ofd
  wr_str ofd tm_s_g
  wr_u64 ofd g
  wr_str ofd tm_k_crumbs
  wr_val_suffix ofd long cn
  wr_val_prefix ofd
  wr_str ofd tm_s_g
  wr_u64 ofd g
  wr_str ofd tm_k_events
  wr_val_suffix ofd long evs
  sum_group_cands g
  wr_str dfd tm_j_g1
  wr_u64 dfd g
  wr_str dfd tm_j_g2
  wr_u64 dfd cn
  wr_str dfd tm_j_g3
  wr_u64 dfd evs
  wr_str dfd tm_j_g4
  ci = ulong 0
  while lt ci get g_nc 0 bound 16
    write_group_cand ofd dfd g cn ci
    ci = add ci 1
  end
  wr_str dfd tm_j_dfend
  if eq g 1
    wr_str dfd tm_s_comma
  end
  wr_str dfd t_nl
end

fn write_det_file ofd int dfd int fi ulong to void
  d = new uchar 32 0
  hx = new uchar 64 0
  for z ulong 32
    put d z get g_f_sha add mul fi 32 z
  end
  sha_hex d hx
  wr_str dfd tm_j_df1
  wr_u64 dfd get g_f_g fi
  wr_str dfd tm_j_df2
  wr_u64 dfd get g_f_idx fi
  wr_str dfd tm_j_df3
  _w = write dfd g_f_seed mul fi 64 get g_f_seed_n fi
  wr_str dfd tm_j_df4
  _w = wr_all dfd hx ulong 0 ulong 64
  wr_str dfd tm_j_df5
  wr_u64 dfd get g_f_evn fi
  wr_str dfd tm_j_df6
  wr_u64 dfd get g_f_crumbs fi
  wr_str dfd tm_j_df7
  wr_u64 dfd get g_f_gaps fi
  wr_str dfd tm_j_df8
  nc = get g_nc 0
  ci = ulong 0
  while lt ci nc bound 16
    write_det_cand dfd ofd fi ci eq add ci 1 nc
    ci = add ci 1
  end
  wr_str dfd tm_j_dfend
  if lt add fi 1 get g_nf 0
    wr_str dfd tm_s_comma
  end
  wr_str dfd t_nl
end

fn write_outputs to void
  ofd = fopen g_outp ulong 0 get g_outp_n 0 int 193 int 420
  dfd = fopen g_detp ulong 0 get g_detp_n 0 int 193 int 420
  if or lt ofd long 0 lt dfd long 0
    die_msg tm_e_out
  end
  put g_first_val 0 ulong 1
  wr_str int ofd tm_j_out1
  if ne get g_dry 0 0
    wr_str int ofd tm_s_true
  else
    wr_str int ofd tm_s_false
  end
  wr_str int ofd tm_j_out2
  _w = write int ofd g_pd_hex ulong 0 ulong 64
  wr_str int ofd tm_j_out3
  _w = write int ofd g_cm_hex ulong 0 ulong 64
  wr_str int ofd tm_j_out4
  _w = write int ofd g_dm_hex ulong 0 ulong 64
  wr_str int ofd tm_j_out5
  wr_u64 int ofd get g_problems 0
  wr_str int ofd tm_j_out6

  wr_str int dfd tm_j_det1
  _w = write int dfd g_prof_hex ulong 0 ulong 64
  wr_str int dfd tm_j_det2
  wr_u64 int dfd get g_problems 0
  wr_str int dfd tm_j_det3

  fi = ulong 0
  while lt fi get g_nf 0 bound 16
    write_det_file int ofd int dfd fi
    fi = add fi 1
  end
  wr_str int dfd tm_j_grps
  write_group int ofd int dfd ulong 1
  write_group int ofd int dfd ulong 2
  wr_str int dfd tm_j_detend
  wr_str int ofd tm_j_outend
  _fc = fclose int ofd
  _fc = fclose int dfd
end

fn main to int
  parse_args
  is_ub_table_init
  check_manifests_and_profile
  load_manifest
  load_bundle
  load_all_ctr1
  nc = get g_nc 0
  ci = ulong 0
  while lt ci nc bound 16
    load_and_score_cand ci
    ci = add ci 1
  end
  verify_all_indices
  write_crumbs_dump
  write_outputs
  wr_str int 2 tm_s_done
  wr_u64 int 2 get g_problems 0
  wr_str int 2 tm_s_done2
  if ne get g_problems 0 0
    ret int 3
  end
  ret int 0
end

note
note tools/exp445/examples_expected.om -- pure seeded OM-2 computation of expected results
note for exp445 worked examples. Replaces tools/exp445/examples_expected.c.
om2

text t_usage "usage: examples_expected <entry> < inputs\n"
text t_badline "examples_expected: bad input line\n"
text t_unk "examples_expected: unknown example "
text t_nl "\n"
text t_0 "0\n"
text t_1 "1\n"
text t_trap1 "TRAP 1\n"
text t_trap2 "TRAP 2\n"
text t_trap3 "TRAP 3\n"
text t_trap5 "TRAP 5\n"

text t_clamp_sub "clamp_sub"
text t_hash_step "hash_step"
text t_sum_squares3 "sum_squares3"
text t_nibble_mirror "nibble_mirror"
text t_halve_or_dec_steps "halve_or_dec_steps"
text t_count_digits "count_digits"
text t_sum_range "sum_range"
text t_cube_xor_pair "cube_xor_pair"
text t_count_above "count_above"
text t_dot3 "dot3"
text t_power_mod "power_mod"
text t_narrow_sum "narrow_sum"
text t_rotl8 "rotl8"
text t_has_digit "has_digit"
text t_tri_kind "tri_kind"

global g_in uchar *
global g_out uchar *
note g_p: [0]=inlen [1]=inpos [2]=outlen [3]=arglen
global g_p ulong 4
global g_arg uchar 256
global g_s long 6
global g_u ulong 6

fn out_push c uchar to void
  n = get g_p 2
  if ge n len g_out
    nc = mul n 2
    if lt nc 4096
      nc = 4096
    end
    r = enlarge g_out nc
    if lt r 0
      exit 2
    end
  end
  put g_out n c
  put g_p 2 add n 1
end

fn out_str s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    out_push get s i
    i = add i 1
  end
end

fn out_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    out_push 48
    ret
  end
  k = ulong 0
  while gt v 0
    d = rem v 10
    put tmp k uchar add 48 d
    v = div v 10
    k = add k 1
  end
  while gt k 0
    k = sub k 1
    out_push get tmp k
  end
end

fn i64_to_u64 v long to ulong
  if ge v 0
    ret ulong v
  end
  if eq v sub neg long 9223372036854775807 1
    ret 9223372036854775808
  end
  ret sub ulong 0 ulong neg v
end

fn u64_to_i64 u ulong to long
  if le u 9223372036854775807
    ret long u
  end
  if eq u 9223372036854775808
    ret sub neg long 9223372036854775807 1
  end
  ret neg long sub ulong 0 u
end

fn out_i64 v long to void
  if lt v 0
    out_push 45
    if eq v sub neg long 9223372036854775807 1
      out_u64 9223372036854775808
    else
      out_u64 ulong neg v
    end
    ret
  end
  out_u64 ulong v
end

fn out_flush to void
  n = get g_p 2
  off = ulong 0
  while lt off n
    w = write 1 g_out off sub n off
    if le w 0
      exit 2
    end
    off = add off ulong w
  end
  put g_p 2 0
end

fn err_str s view uchar * to void
  w = write 2 s 0 len s
  if lt w 0
    ret
  end
end

fn read_all_stdin to void
  r = enlarge g_in 4096
  if lt r 0
    exit 2
  end
  n = ulong 0
  while true
    cap = len g_in
    if eq n cap
      r2 = enlarge g_in mul cap 2
      if lt r2 0
        exit 2
      end
      cap = len g_in
    end
    got = read 0 g_in n sub cap n
    if lt got 0
      exit 2
    end
    if eq got 0
      break
    end
    n = add n ulong got
  end
  put g_p 0 n
  put g_p 1 0
end

fn arg_eq s view uchar * to bool
  n = get g_p 3
  if ne n len s
    ret false
  end
  i = ulong 0
  while lt i n
    if ne get g_arg i get s i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn parse_one_int idx ulong pos ulong lend ulong to ulong
  p = pos
  while lt p lend
    if ne get g_in p 32
      break
    end
    p = add p 1
  end
  neg_ = false
  if lt p lend
    if eq get g_in p 45
      neg_ = true
      p = add p 1
    end
  end
  acc = ulong 0
  ndig = ulong 0
  while lt p lend
    c = get g_in p
    if or lt c 48 gt c 57
      break
    end
    d = ulong sub c 48
    acc = add mul acc 10 d
    ndig = add ndig 1
    p = add p 1
  end
  if eq ndig 0
    err_str t_badline
    exit 2
  end
  if neg_
    uv = sub ulong 0 acc
    put g_u idx uv
    put g_s idx u64_to_i64 uv
  else
    put g_u idx acc
    put g_s idx u64_to_i64 acc
  end
  ret p
end

fn next_row n ulong to bool
  pos = get g_p 1
  inlen = get g_p 0
  if ge pos inlen
    ret false
  end
  lend = pos
  while lt lend inlen
    if eq get g_in lend 10
      break
    end
    lend = add lend 1
  end
  nextp = lend
  if lt lend inlen
    nextp = add lend 1
  end
  p = pos
  i = ulong 0
  while lt i n
    p = parse_one_int i p lend
    i = add i 1
  end
  put g_p 1 nextp
  ret true
end

fn fits16 v long to bool
  ret and ge v neg long 32768 lt v 32768
end

fn fits8 v long to bool
  ret and ge v neg long 128 lt v 128
end

fn addmod x ulong y ulong m ulong to ulong
  if ge x sub m y
    ret sub x sub m y
  end
  ret add x y
end

fn mulmod a ulong b ulong m ulong to ulong
  aa = rem a m
  bb = rem b m
  res = ulong 0
  while gt bb 0
    if eq and bb 1 1
      res = addmod res aa m
    end
    aa = addmod aa aa m
    bb = shr bb 1
  end
  ret res
end

fn run_clamp_sub to void
  while next_row 2
    u0 = get g_u 0
    u1 = get g_u 1
    if ge u0 u1
      out_u64 sub u0 u1
    else
      out_u64 0
    end
    out_push 10
  end
end

fn run_hash_step to void
  while next_row 2
    u0 = and get g_u 0 4294967295
    u1 = and get g_u 1 4294967295
    v = and add mul u0 31 u1 4294967295
    out_u64 v
    out_push 10
  end
end

fn run_sum_squares3 to void
  while next_row 3
    s0 = i64_to_u64 get g_s 0
    s1 = i64_to_u64 get g_s 1
    s2 = i64_to_u64 get g_s 2
    a = u64_to_i64 mul s0 s0
    b = u64_to_i64 mul s1 s1
    c = u64_to_i64 mul s2 s2
    ab = u64_to_i64 add i64_to_u64 a i64_to_u64 b
    abc = u64_to_i64 add i64_to_u64 ab i64_to_u64 c
    ok = and fits16 a fits16 b
    ok = and ok fits16 c
    ok = and ok fits16 ab
    ok = and ok fits16 abc
    if ok
      out_i64 abc
      out_push 10
    else
      out_str t_trap1
    end
  end
end

fn run_nibble_mirror to void
  while next_row 1
    x = and get g_u 0 65535
    ok = and eq and x 15 shr x 12 eq and shr x 4 15 and shr x 8 15
    if ok
      out_str t_1
    else
      out_str t_0
    end
  end
end

fn run_halve_or_dec_steps to void
  while next_row 1
    x = and get g_u 0 4294967295
    k = ulong 0
    while gt x 1
      if eq and x 1 1
        x = sub x 1
      else
        x = shr x 1
      end
      k = add k 1
    end
    out_u64 k
    out_push 10
  end
end

fn run_count_digits to void
  while next_row 1
    v = get g_u 0
    k = ulong 1
    while ge v 10
      v = div v 10
      k = add k 1
    end
    out_u64 k
    out_push 10
  end
end

fn run_sum_range to void
  while next_row 2
    lo = get g_s 0
    hi = get g_s 1
    sum = long 0
    if le lo hi
      ulo = i64_to_u64 lo
      uhi = i64_to_u64 hi
      lh = add ulo uhi
      cnt = add sub uhi ulo 1
      prod = u64_to_i64 mul lh cnt
      sum = div prod 2
    end
    out_i64 sum
    out_push 10
  end
end

fn run_cube_xor_pair to void
  while next_row 1
    u0 = get g_u 0
    if ge u0 15
      out_str t_trap3
    else
      a = mul mul u0 u0 u0
      u1 = add u0 1
      b = mul mul u1 u1 u1
      out_u64 and xor a b 65535
      out_push 10
    end
  end
end

fn run_count_above to void
  while next_row 5
    thr = get g_s 4
    k = ulong 0
    i = ulong 0
    while lt i 4
      if gt get g_s i thr
        k = add k 1
      end
      i = add i 1
    end
    out_u64 k
    out_push 10
  end
end

fn run_dot3 to void
  while next_row 6
    p0 = mul i64_to_u64 get g_s 0 i64_to_u64 get g_s 3
    p1 = mul i64_to_u64 get g_s 1 i64_to_u64 get g_s 4
    p2 = mul i64_to_u64 get g_s 2 i64_to_u64 get g_s 5
    res = u64_to_i64 add add p0 p1 p2
    out_i64 res
    out_push 10
  end
end

fn run_power_mod to void
  while next_row 3
    b = get g_u 0
    e = get g_u 1
    m = get g_u 2
    if eq m 0
      out_str t_trap2
    else
      acc = rem ulong 1 m
      x = rem b m
      bit = ulong 64
      while gt bit 0
        bit = sub bit 1
        acc = mulmod acc acc m
        if eq and shr e bit 1 1
          acc = mulmod acc x m
        end
      end
      out_u64 acc
      out_push 10
    end
  end
end

fn run_narrow_sum to void
  while next_row 2
    v = u64_to_i64 add i64_to_u64 get g_s 0 i64_to_u64 get g_s 1
    if not fits16 v
      out_str t_trap1
    else
      if not fits8 v
        out_str t_trap5
      else
        out_i64 v
        out_push 10
      end
    end
  end
end

fn run_rotl8 to void
  while next_row 2
    r = and get g_u 0 255
    k = rem get g_u 1 8
    i = ulong 0
    while lt i k
      r = and or shl r 1 shr r 7 255
      i = add i 1
    end
    out_u64 r
    out_push 10
  end
end

fn run_has_digit to void
  while next_row 2
    v = get g_u 0
    d = get g_u 1
    found = false
    if le d 9
      if eq v 0
        if eq d 0
          found = true
        end
      else
        while gt v 0
          if eq rem v 10 d
            found = true
            break
          end
          v = div v 10
        end
      end
    end
    if found
      out_str t_1
    else
      out_str t_0
    end
  end
end

fn run_tri_kind to void
  while next_row 3
    a = get g_u 0
    b = get g_u 1
    c = get g_u 2
    k = ulong 3
    if or or le add a b c le add a c b le add b c a
      k = 0
    else
      if and eq a b eq b c
        k = 1
      else
        if or or eq a b eq b c eq a c
          k = 2
        end
      end
    end
    out_u64 k
    out_push 10
  end
end

fn dispatch to bool
  if arg_eq t_clamp_sub
    run_clamp_sub
    ret true
  end
  if arg_eq t_hash_step
    run_hash_step
    ret true
  end
  if arg_eq t_sum_squares3
    run_sum_squares3
    ret true
  end
  if arg_eq t_nibble_mirror
    run_nibble_mirror
    ret true
  end
  if arg_eq t_halve_or_dec_steps
    run_halve_or_dec_steps
    ret true
  end
  if arg_eq t_count_digits
    run_count_digits
    ret true
  end
  if arg_eq t_sum_range
    run_sum_range
    ret true
  end
  if arg_eq t_cube_xor_pair
    run_cube_xor_pair
    ret true
  end
  if arg_eq t_count_above
    run_count_above
    ret true
  end
  if arg_eq t_dot3
    run_dot3
    ret true
  end
  if arg_eq t_power_mod
    run_power_mod
    ret true
  end
  if arg_eq t_narrow_sum
    run_narrow_sum
    ret true
  end
  if arg_eq t_rotl8
    run_rotl8
    ret true
  end
  if arg_eq t_has_digit
    run_has_digit
    ret true
  end
  if arg_eq t_tri_kind
    run_tri_kind
    ret true
  end
  ret false
end

fn main to int
  if ne argcnt 2
    err_str t_usage
    ret 2
  end
  al = argread 1 g_arg 0 255
  if lt al 0
    err_str t_usage
    ret 2
  end
  put g_p 3 ulong al
  read_all_stdin
  if not dispatch
    err_str t_unk
    w = write 2 g_arg 0 get g_p 3
    err_str t_nl
    if lt w 0
      ret 2
    end
    ret 2
  end
  out_flush
  ret 0
end

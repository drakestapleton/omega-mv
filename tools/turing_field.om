note tools/turing_field.om -- Pure seeded OM-2 port of tools/turing_field.c
note (turing-field CLI). Byte-exact output parity with the C reference.
note Composed after src/turing/field.om and src/turing/select.om.

text t_cli_r1 "evidence/MIXED_ALGEBRA/ma3_bench_run1.json"
text t_cli_r2 "evidence/MIXED_ALGEBRA/ma3_bench_run2.json"
text t_cli_flag "--spec-ids"

text t_cli_s0_n "S1"
text t_cli_s0_w "L2-fit (256 KiB int8 W)"
text t_cli_s1_n "S2"
text t_cli_s1_w "L2 edge (1 MiB int8 W)"
text t_cli_s2_n "S3"
text t_cli_s2_w "L3/DRAM (16 MiB int8 W)"
text t_cli_s3_n "S4"
text t_cli_s3_w "DRAM-bound (64 MiB int8 W)"

text t_cli_con "contract "
text t_cli_prov " PROVISIONAL\n"
text t_cli_spec "spec "
text t_cli_hdr1 "TURING Field V0 (post hoc over stored receipts; no timed runs)\n"
text t_cli_hdr2 "contract_digest "
text t_cli_hdr3 "\n  PROVISIONAL: SHA-256(\""
text t_cli_hdr4 "\" 0x00 || OMG0 contract bytes); not an Omega semantic id\n"
text t_cli_hdr5 "specs "
text t_cli_hdr6 " (one contract), evidence "
text t_cli_hdr7 ", receipts "
text t_cli_sp2 "  "
text t_cli_spec2 " spec "
text t_cli_hview "\n== History view (git log analogue: commit = decision, parent = supersedes, tree = cited evidence,\n   blob = receipt). Root decision from the first receipt, then a superseding one from all receipts.\n\n"
text t_cli_dd "-- "
text t_cli_dec "decision "
text t_cli_sup1 "    supersedes  "
text t_cli_sup0 "    supersedes  none (root)\n"
text t_cli_sel1 "    selector    "
text t_cli_sel2 "   contract "
text t_cli_sel3 " (PROVISIONAL)\n"
text t_cli_q1 "    query       n="
text t_cli_q2 " m="
text t_cli_q3 " sparsity="
text t_cli_q4 " pack="
text t_cli_q5 "  cell "
text t_cli_once "once"
text t_cli_pc "per_call"
text t_cli_ex "exact"
text t_cli_near "nearest"
text t_cli_ch1 "    chosen      "
text t_cli_ch2 " (spec "
text t_cli_ch3 ")  "
text t_cli_ch4 "  margin "
text t_cli_ch5 "%  band "
text t_cli_ch6 "%  tie="
text t_cli_cands "    candidates "
text t_cli_cites1 "    cites       "
text t_cli_cites2 " evidence records over "
text t_cli_cites3 " receipts -> "
text t_cli_allv "all receipts verify"
text t_cli_rec1 "                receipt "

text t_cli_win "\n== Winners from stored evidence alone (Field selector v1, all receipts)\n"
text t_cli_win0 "== Winners from stored evidence alone (Field selector v1, all receipts)\n"
text t_cli_wpack " pack="
text t_cli_warr " -> "
text t_cli_wmar " margin "
text t_cli_wban "% band "
text t_cli_wpct "%\n"

text t_cli_fail1 "\n== RECORDED FAIL (K.6): RETIRED Field v0 tie rule vs control arm, kept to reproduce the verdict\n"
text t_cli_fail2 "   regret vs oracle = cheapest mean cost of the exact cell\n"
text t_cli_fail3 "   seed 0x"
text t_cli_fail4 "; control arm = StarPU-style history per (spec, footprint n x m x pack)\n"

text t_cli_l0 "S1-S4 x 2 pack, in-sample (warm)"
text t_cli_l1 "S1-S4 x 2 pack, leave-one-cell-out"
text t_cli_l2 "  of which pack once (S1-S4), in-sample"
text t_cli_l3 "  of which pack per call (S1-S4), in-sample"
text t_cli_l4 "all cells x 2 pack, in-sample"
text t_cli_l5 "  of which pack once (36 cells), in-sample"
text t_cli_l6 "  of which per call (36 cells), in-sample"
text t_cli_l7 "all cells x 2 pack, leave-one-cell-out"
text t_cli_l8 "all cells x 2 pack, cold online x10"

text t_cli_v1l0 "S1-S4 x 2 pack, in-sample"
text t_cli_v1l1 "S1-S4 x 2 pack, leave-one-cell-out"
text t_cli_v1l2 "all cells x 2 pack, in-sample"
text t_cli_v1l3 "all cells x 2 pack, leave-one-cell-out"

text t_cli_rn " n="
text t_cli_rf1 " | Field regret mean "
text t_cli_rf2 "% max "
text t_cli_rf3 "% receipts-verify "
text t_cli_rc1 " | control mean "
text t_cli_rc2 "% max "
text t_cli_rc3 "% receipts-verify "
text t_cli_rsp " | same pick "
text t_cli_na "n/a"

text t_cli_kt0 "\n== Kill test (pre-registered, dry run on stored data; RETIRED v0 rule, verdict recorded 2026-09-29)\n"
text t_cli_kt1 "  Q1 quality in-sample: Field mean <= control mean + 2% and Field max <= 10%: "
text t_cli_kt2 "  Q1 quality leave-one-out:                                             "
text t_cli_kt3 "  Q2 every Field decision's cited receipts verify:                      "
text t_cli_kt4 "  verdict: "
text t_cli_pass "PASS"
text t_cli_fail "FAIL"
text t_cli_vfail "FAIL (Turing selection is integration-only)"
text t_cli_vbeat "BEAT on selection quality"
text t_cli_vsurv "SURVIVES on explainability at equal quality (not a quality win)"

text t_cli_v1h1 "\n== Field v1 (record-keeping layer, K.7): same ranking rule as the control arm, plus decision records\n"
text t_cli_v1h2 "   Not a new kill-test verdict: selection is the control rule and is not claimed as novel.\n"
text t_cli_err1 "turing-field: cannot ingest "

global g_cli_arg uchar 512
global g_cli_id1 uchar 32
global g_cli_id2 uchar 32
global g_cli_pfm f64 1
global g_cli_pfx f64 1
global g_cli_phm f64 1
global g_cli_pfc ulong 1
global g_cli_pdec ulong 1
global g_cli_lfm f64 1
global g_cli_lfx f64 1
global g_cli_lhm f64 1
global g_cli_lfc ulong 1
global g_cli_ldec ulong 1
global g_cli_fc uchar 32
global g_cli_hc uchar 32

fn cli_out_cstr_pad_sp_rz idx ulong w ulong to void
  off = mul idx 32
  n = ulong 0
  for i ulong 32
    c = get g_sp_rz add off i
    if eq c uchar 0
      break
    end
    tf_out_b c
    n = add n 1
  end
  if lt n w
    tf_out_sp sub w n
  end
end

fn cli_out_cstr_pad_dc_crz did ulong k ulong w ulong to void
  off = add mul did mul TF_MAX_CAND 32 mul k 32
  n = ulong 0
  for i ulong 32
    c = get g_dc_crz add off i
    if eq c uchar 0
      break
    end
    tf_out_b c
    n = add n 1
  end
  if lt n w
    tf_out_sp sub w n
  end
end

fn cli_out_txt_pad s view uchar * w ulong to void
  n = len s
  tf_out_txt s
  if lt n w
    tf_out_sp sub w n
  end
end

fn cli_out_shape_name s ulong to void
  if eq s 0
    tf_out_txt t_cli_s0_n
    ret
  end
  if eq s 1
    tf_out_txt t_cli_s1_n
    ret
  end
  if eq s 2
    tf_out_txt t_cli_s2_n
    ret
  end
  tf_out_txt t_cli_s3_n
end

fn cli_out_shape_where s ulong pad ulong to void
  if eq s 0
    cli_out_txt_pad t_cli_s0_w pad
    ret
  end
  if eq s 1
    cli_out_txt_pad t_cli_s1_w pad
    ret
  end
  if eq s 2
    cli_out_txt_pad t_cli_s2_w pad
    ret
  end
  cli_out_txt_pad t_cli_s3_w pad
end

fn cli_shape_n s ulong to ulong
  if or eq s 0 eq s 2
    ret 4096
  end
  ret 16384
end

fn cli_shape_m s ulong to ulong
  if or eq s 0 eq s 1
    ret 64
  end
  ret 4096
end

fn cli_print_dec_cands did ulong to void
  tf_out_txt t_cli_cands
  ncand = get g_dc_ncand did
  cbase = mul did mul TF_MAX_CAND 32
  rbase = mul did TF_MAX_CAND
  for i ulong ncand bound 16
    tf_out_b uchar 32
    co = add cbase mul i 32
    for j ulong 32
      c = get g_dc_crz add co j
      if eq c uchar 0
        break
      end
      tf_out_b c
    end
    tf_out_b uchar 58
    tf_out_reason get g_dc_reas add rbase i
  end
  tf_out_b uchar 10
end

fn cli_print_dec_cites sid ulong did ulong to void
  v = tf_decision_verify sid did
  tf_out_txt t_cli_cites1
  tf_out_u64 get g_dc_ncite did
  tf_out_txt t_cli_cites2
  nr = get g_st_nrec sid
  tf_out_u64 nr
  tf_out_txt t_cli_cites3
  if eq v 0
    tf_out_txt t_cli_allv
  else
    wl = get g_tf_whyl 0
    for i ulong wl bound 256
      tf_out_b get g_tf_why i
    end
  end
  tf_out_b uchar 10
  rec_base = mul sid TF_MAX_REC
  for r ulong nr bound 8
    ridx = add rec_base r
    ro = mul ridx 32
    for j ulong 32
      put g_tf_tmp_dig j get g_rc_dig add ro j
    end
    tf_out_txt t_cli_rec1
    tf_dig_out_short
    tf_out_txt t_cli_sp2
    po = mul ridx TF_PATH
    for j ulong TF_PATH
      c = get g_rc_path add po j
      if eq c uchar 0
        break
      end
      tf_out_b c
    end
    tf_out_b uchar 10
  end
end

fn cli_print_dec sid ulong did ulong use_id2 ulong to void
  tf_out_txt t_cli_dec
  for i ulong 32
    if eq use_id2 0
      put g_tf_tmp_dig i get g_cli_id1 i
    else
      put g_tf_tmp_dig i get g_cli_id2 i
    end
  end
  tf_dig_out_full
  tf_out_b uchar 10
  doff = mul did 32
  if ne get g_dc_hsup did 0
    tf_out_txt t_cli_sup1
    for i ulong 32
      put g_tf_tmp_dig i get g_dc_sup add doff i
    end
    tf_dig_out_short
    tf_out_b uchar 10
  else
    tf_out_txt t_cli_sup0
  end
  tf_out_txt t_cli_sel1
  for i ulong 32
    c = get g_dc_sel add doff i
    if eq c uchar 0
      break
    end
    tf_out_b c
  end
  tf_out_txt t_cli_sel2
  for i ulong 32
    put g_tf_tmp_dig i get g_dc_cdig add doff i
  end
  tf_dig_out_short
  tf_out_txt t_cli_sel3
  tf_out_txt t_cli_q1
  tf_out_u64 get g_dc_n did
  tf_out_txt t_cli_q2
  tf_out_u64 get g_dc_m did
  tf_out_txt t_cli_q3
  tf_out_f64_fix div f64 get g_dc_spm did 1000.0 2 0
  tf_out_txt t_cli_q4
  if ne get g_dc_pack did 0
    tf_out_txt t_cli_pc
  else
    tf_out_txt t_cli_once
  end
  tf_out_txt t_cli_q5
  if ne get g_dc_exc did 0
    tf_out_txt t_cli_ex
  else
    tf_out_txt t_cli_near
  end
  tf_out_b uchar 10
  ch = get g_dc_chosen did
  if ge ch 0
    tf_out_txt t_cli_ch1
    co = add mul did mul TF_MAX_CAND 32 mul ulong ch 32
    for i ulong 32
      c = get g_dc_crz add co i
      if eq c uchar 0
        break
      end
      tf_out_b c
    end
    tf_out_txt t_cli_ch2
    for i ulong 32
      put g_tf_tmp_dig i get g_dc_cand add co i
    end
    tf_dig_out_short
    tf_out_txt t_cli_ch3
    voff = mul did 16
    for i ulong 16
      c = get g_dc_verd add voff i
      if eq c uchar 0
        break
      end
      tf_out_b c
    end
    tf_out_txt t_cli_ch4
    tf_out_f64_fix div f64 get g_dc_mppm did 1.0e4 1 0
    tf_out_txt t_cli_ch5
    tf_out_f64_fix div f64 get g_dc_bppm did 1.0e4 1 0
    tf_out_txt t_cli_ch6
    for i ulong 16
      c = get g_dc_tres add voff i
      if eq c uchar 0
        break
      end
      tf_out_b c
    end
    tf_out_b uchar 10
  end
  cli_print_dec_cands did
  cli_print_dec_cites sid did
end

fn cli_out_ratio_pad a ulong b ulong w ulong to void
  tf_tv_clr
  tf_tv_u64 a
  tf_tv_b uchar 47
  tf_tv_u64 b
  n = get g_tf_tvl 0
  for i ulong n bound 32
    tf_out_b get g_tf_tv i
  end
  if lt n w
    tf_out_sp sub w n
  end
end

fn cli_print_regret lbl view uchar * checked ulong to void
  tf_out_txt t_cli_sp2
  cli_out_txt_pad lbl 40
  tf_out_txt t_cli_rn
  nd = get g_reg_dec 0
  tf_out_u64_w nd 3
  tf_out_txt t_cli_rf1
  tf_out_f64_fix mul 100.0 get g_reg_fmean 0 2 6
  tf_out_txt t_cli_rf2
  tf_out_f64_fix mul 100.0 get g_reg_fmax 0 2 6
  tf_out_txt t_cli_rf3
  if ne checked 0
    cli_out_ratio_pad get g_reg_fcok 0 nd 7
  else
    cli_out_txt_pad t_cli_na 7
  end
  tf_out_txt t_cli_rc1
  tf_out_f64_fix mul 100.0 get g_reg_hmean 0 2 6
  tf_out_txt t_cli_rc2
  tf_out_f64_fix mul 100.0 get g_reg_hmax 0 2 8
  tf_out_txt t_cli_rc3
  if ne checked 0
    cli_out_ratio_pad get g_reg_hcok 0 nd 7
  else
    cli_out_txt_pad t_cli_na 7
  end
  tf_out_txt t_cli_rsp
  tf_out_u64 get g_reg_agree 0
  tf_out_b uchar 10
end

fn cli_err_ingest to void
  tf_out_flush
  ign = write int 2 t_cli_err1 0 len t_cli_err1
  ign = write int 2 g_tf_path 0 get g_tf_plen 0
  nl = new uchar 1 0
  put nl 0 uchar 10
  ign = write int 2 nl 0 1
end

fn cli_load_args sid ulong ac ulong max_n ulong to long
  if lt tf_ingest_registry sid 0
    ret -1
  end
  if eq ac 1
    tf_set_path_txt t_cli_r1
    if lt tf_ingest_receipt_gp sid 0
      cli_err_ingest
      ret -1
    end
    if ge max_n 2
      tf_set_path_txt t_cli_r2
      if lt tf_ingest_receipt_gp sid 0
        cli_err_ingest
        ret -1
      end
    end
    ret 0
  end
  lim = sub ac 1
  if gt lim max_n
    lim = max_n
  end
  for i ulong lim bound 8
    nr = argread add i 1 g_tf_path 0 511
    if lt nr 0
      ret -1
    end
    put g_tf_plen 0 ulong nr
    if lt tf_ingest_receipt_gp sid 0
      cli_err_ingest
      ret -1
    end
  end
  ret 0
end

fn cli_is_spec_ids ac ulong to bool
  if lt ac 2
    ret false
  end
  nr = argread 1 g_cli_arg 0 511
  if ne nr long len t_cli_flag
    ret false
  end
  n = len t_cli_flag
  for i ulong n bound 32
    if ne get g_cli_arg i get t_cli_flag i
      ret false
    end
  end
  ret true
end

fn cli_run_spec_ids to int
  if lt tf_ingest_registry 0 0
    ret 1
  end
  tf_out_txt t_cli_con
  for i ulong 32
    put g_tf_tmp_dig i get g_st_cdig i
  end
  tf_dig_out_full
  tf_out_txt t_cli_prov
  ns = get g_st_nspec 0
  for k ulong ns bound 32
    tf_out_txt t_cli_spec
    cli_out_cstr_pad_sp_rz k 12
    tf_out_b uchar 32
    so = mul k 32
    for j ulong 32
      put g_tf_tmp_dig j get g_sp_id add so j
    end
    tf_dig_out_full
    tf_out_b uchar 10
  end
  tf_out_flush
  ret 0
end

fn cli_print_header to void
  tf_out_txt t_cli_hdr1
  tf_out_txt t_cli_hdr2
  for i ulong 32
    put g_tf_tmp_dig i get g_st_cdig i
  end
  tf_dig_out_full
  tf_out_txt t_cli_hdr3
  tf_out_txt t_tf_dom_contract
  tf_out_txt t_cli_hdr4
  tf_out_txt t_cli_hdr5
  ns = get g_st_nspec 0
  tf_out_u64 ns
  tf_out_txt t_cli_hdr6
  tf_out_u64 get g_st_nev 0
  tf_out_txt t_cli_hdr7
  tf_out_u64 get g_st_nrec 0
  tf_out_b uchar 10
  for k ulong ns bound 32
    tf_out_txt t_cli_sp2
    cli_out_cstr_pad_sp_rz k 12
    tf_out_txt t_cli_spec2
    so = mul k 32
    for j ulong 32
      put g_tf_tmp_dig j get g_sp_id add so j
    end
    tf_dig_out_short
    tf_out_txt t_cli_sp2
    ro = mul k TF_TEXT
    for j ulong TF_TEXT
      c = get g_sp_rep add ro j
      if eq c uchar 0
        break
      end
      tf_out_b c
    end
    tf_out_b uchar 10
  end
end

fn cli_print_history to long
  tf_out_txt t_cli_hview
  for s ulong 4
    sn = cli_shape_n s
    sm = cli_shape_m s
    tf_set_q sn sm 300 TF_PACK_ONCE 0
    if ne tf_field_select 1 0 0 0
      ret -1
    end
    if ne tf_decision_digest 0 0
      ret -1
    end
    for j ulong 32
      put g_cli_id1 j get g_tf_sh_out j
      put g_tf_tmp_dig j get g_tf_sh_out j
    end
    tf_set_q sn sm 300 TF_PACK_ONCE 0
    if ne tf_field_select 0 1 1 0
      ret -1
    end
    if ne tf_decision_digest 1 0
      ret -1
    end
    for j ulong 32
      put g_cli_id2 j get g_tf_sh_out j
    end
    tf_out_txt t_cli_dd
    cli_out_shape_name s
    tf_out_b uchar 32
    cli_out_shape_where s 0
    tf_out_b uchar 10
    cli_print_dec 0 1 1
    cli_print_dec 1 0 0
    tf_out_b uchar 10
  end
  ret 0
end

fn cli_print_winners to long
  tf_out_txt t_cli_win0
  for pk ulong 2
    for s ulong 4
      sn = cli_shape_n s
      sm = cli_shape_m s
      tf_set_q sn sm 300 pk 0
      if ne tf_field_select 0 0 0 0
        ret -1
      end
      tf_out_txt t_cli_sp2
      cli_out_shape_name s
      tf_out_b uchar 32
      cli_out_shape_where s 28
      tf_out_txt t_cli_wpack
      if ne pk 0
        cli_out_txt_pad t_cli_pc 8
      else
        cli_out_txt_pad t_cli_once 8
      end
      tf_out_txt t_cli_warr
      cli_out_cstr_pad_dc_crz 0 ulong get g_dc_chosen 0 11
      tf_out_txt t_cli_wmar
      tf_out_f64_fix div f64 get g_dc_mppm 0 1.0e4 2 5
      tf_out_txt t_cli_wban
      tf_out_f64_fix div f64 get g_dc_bppm 0 1.0e4 2 5
      tf_out_txt t_cli_wpct
    end
  end
  ret 0
end

fn cli_print_killtest to void
  q1 = and le get g_cli_pfm 0 add get g_cli_phm 0 0.02 le get g_cli_pfx 0 0.10
  q1l = and le get g_cli_lfm 0 add get g_cli_lhm 0 0.02 le get g_cli_lfx 0 0.10
  q2 = and eq get g_cli_pfc 0 get g_cli_pdec 0 eq get g_cli_lfc 0 get g_cli_ldec 0
  better = or lt get g_cli_pfm 0 sub get g_cli_phm 0 0.02 lt get g_cli_lfm 0 sub get g_cli_lhm 0 0.02
  tf_out_txt t_cli_kt0
  tf_out_txt t_cli_kt1
  if q1
    tf_out_txt t_cli_pass
  else
    tf_out_txt t_cli_fail
  end
  tf_out_b uchar 10
  tf_out_txt t_cli_kt2
  if q1l
    tf_out_txt t_cli_pass
  else
    tf_out_txt t_cli_fail
  end
  tf_out_b uchar 10
  tf_out_txt t_cli_kt3
  if q2
    tf_out_txt t_cli_pass
  else
    tf_out_txt t_cli_fail
  end
  tf_out_b uchar 10
  tf_out_txt t_cli_kt4
  if not and q1 and q1l q2
    tf_out_txt t_cli_vfail
  else
    if better
      tf_out_txt t_cli_vbeat
    else
      tf_out_txt t_cli_vsurv
    end
  end
  tf_out_b uchar 10
end

fn cli_run_tables to long
  nn = ulong 0
  for pk ulong 2
    for s ulong 4
      put g_q_n nn cli_shape_n s
      put g_q_m nn cli_shape_m s
      put g_q_sp nn 300
      put g_q_pack nn pk
      put g_q_exc nn 0
      nn = add nn 1
    end
  end
  nc = tf_cells 0 80
  na = ulong 0
  for pk ulong 2
    for i ulong nc bound 80
      qi = add 8 na
      put g_q_n qi get g_c_n i
      put g_q_m qi get g_c_m i
      put g_q_sp qi get g_c_sp i
      put g_q_pack qi pk
      put g_q_exc qi 0
      na = add na 1
    end
  end
  seed = ulong 0x7475726967303031
  tf_out_txt t_cli_fail1
  tf_out_txt t_cli_fail2
  tf_out_txt t_cli_fail3
  tf_out_hex64 seed
  tf_out_txt t_cli_fail4
  if ne tf_compare 0 TF_RULE_V0_RETIRED 0 nn 0 seed 0
    ret -1
  end
  cli_print_regret t_cli_l0 1
  put g_cli_pfm 0 get g_reg_fmean 0
  put g_cli_pfx 0 get g_reg_fmax 0
  put g_cli_phm 0 get g_reg_hmean 0
  put g_cli_pfc 0 get g_reg_fcok 0
  put g_cli_pdec 0 get g_reg_dec 0
  if ne tf_compare 0 TF_RULE_V0_RETIRED 0 nn 1 seed 0
    ret -1
  end
  cli_print_regret t_cli_l1 1
  put g_cli_lfm 0 get g_reg_fmean 0
  put g_cli_lfx 0 get g_reg_fmax 0
  put g_cli_lhm 0 get g_reg_hmean 0
  put g_cli_lfc 0 get g_reg_fcok 0
  put g_cli_ldec 0 get g_reg_dec 0
  if ne tf_compare 0 TF_RULE_V0_RETIRED 0 4 0 seed 0
    ret -1
  end
  cli_print_regret t_cli_l2 1
  if ne tf_compare 0 TF_RULE_V0_RETIRED 4 4 0 seed 0
    ret -1
  end
  cli_print_regret t_cli_l3 1
  if ne tf_compare 0 TF_RULE_V0_RETIRED 8 na 0 seed 0
    ret -1
  end
  cli_print_regret t_cli_l4 1
  if ne tf_compare 0 TF_RULE_V0_RETIRED 8 nc 0 seed 0
    ret -1
  end
  cli_print_regret t_cli_l5 1
  if ne tf_compare 0 TF_RULE_V0_RETIRED add 8 nc nc 0 seed 0
    ret -1
  end
  cli_print_regret t_cli_l6 1
  if ne tf_compare 0 TF_RULE_V0_RETIRED 8 na 1 seed 0
    ret -1
  end
  cli_print_regret t_cli_l7 1
  if ne tf_compare_online 0 TF_RULE_V0_RETIRED 8 na 10 seed 0
    ret -1
  end
  cli_print_regret t_cli_l8 0
  cli_print_killtest
  tf_out_txt t_cli_v1h1
  tf_out_txt t_cli_v1h2
  if ne tf_compare 0 TF_RULE_V1 0 nn 0 seed 0
    ret -1
  end
  cli_print_regret t_cli_v1l0 1
  if ne tf_compare 0 TF_RULE_V1 0 nn 1 seed 0
    ret -1
  end
  cli_print_regret t_cli_v1l1 1
  if ne tf_compare 0 TF_RULE_V1 8 na 0 seed 0
    ret -1
  end
  cli_print_regret t_cli_v1l2 1
  if ne tf_compare 0 TF_RULE_V1 8 na 1 seed 0
    ret -1
  end
  cli_print_regret t_cli_v1l3 1
  ret 0
end

fn main to int
  ac = ulong argcnt
  if ne tf_store_init 0 0
    ret 1
  end
  if ne tf_store_init 1 0
    ret 1
  end
  if cli_is_spec_ids ac
    ret cli_run_spec_ids
  end
  if ne cli_load_args 0 ac 8 0
    ret 1
  end
  if ne cli_load_args 1 ac 1 0
    ret 1
  end
  cli_print_header
  if ne cli_print_history 0
    ret 1
  end
  if ne cli_print_winners 0
    ret 1
  end
  if ne cli_run_tables 0
    ret 1
  end
  tf_out_flush
  ret 0
end

global g_rlen ulong 1

note ---- Buffered output helpers ----
fn ob_clr to void
  put g_olen 0 0
end

fn ob_flush fd int to void
  n = get g_olen 0
  if gt n 0
    w = write fd g_obuf 0 n
    ign_l = w
    put g_olen 0 0
  end
end

fn ob_b c uchar to void
  n = get g_olen 0
  if ge n 16000
    ob_flush int 1
    n = get g_olen 0
  end
  put g_obuf n c
  put g_olen 0 add n 1
end

fn ob_txt s view uchar * to void
  n = len s
  for i ulong n bound 4096
    ob_b get s i
  end
end

fn ob_slice s view uchar * off ulong n ulong to void
  for i ulong n bound 4096
    ob_b get s add off i
  end
end

fn ob_u64 v ulong to void
  if eq v 0
    ob_b uchar 48
    ret
  end
  dig = new uchar 24 0
  nd = ulong 0
  x = v
  while gt x 0 bound 24
    put dig nd uchar add 48 rem x 10
    x = div x 10
    nd = add nd 1
  end
  while gt nd 0 bound 24
    nd = sub nd 1
    ob_b get dig nd
  end
end

fn ob_u64_pad v ulong width ulong to void
  dig = new uchar 24 0
  x = v
  for i ulong width bound 24
    put dig sub sub width 1 i uchar add 48 rem x 10
    x = div x 10
  end
  for i ulong width bound 24
    ob_b get dig i
  end
end

fn ob_i64 v long to void
  if lt v 0
    ob_b uchar 45
    uv = add ulong sub 0 add v 1 1
    ob_u64 uv
    ret
  end
  ob_u64 ulong v
end

fn ob_hex16 v ulong to void
  for i ulong 16
    sh = mul sub 15 i 4
    ob_b get t_hx and shr v sh 15
  end
end

fn ob_ub_bits ub long to void
  a = ulong 0
  if lt ub 0
    ob_b uchar 45
    a = add ulong sub 0 add ub 1 1
  else
    a = ulong ub
  end
  ob_u64 div a 1000000
  ob_b uchar 46
  ob_u64_pad rem a 1000000 6
end

fn ob_f64_fixed val f64 prec ulong to void
  v = val
  if lt v f64 0.0
    ob_b uchar 45
    v = sub f64 0.0 v
  end
  sc = ulong 1
  for i ulong prec bound 12
    sc = mul sc 10
  end
  scaled = add mul v f64 sc f64 0.5
  iv = ulong scaled
  if eq prec 0
    ob_u64 iv
    ret
  end
  ob_u64 div iv sc
  ob_b uchar 46
  ob_u64_pad rem iv sc prec
end

fn ob_dig slot ulong to void
  o = mul slot 32
  for i ulong 32
    b = ulong get g_dig add o i
    ob_b get t_hx shr b 4
    ob_b get t_hx and b 15
  end
end

fn tcd_sqrt x f64 to f64
  if le x f64 0.0
    ret f64 0.0
  end
  g = x
  if gt g f64 1.0
    g = mul x f64 0.5
  else
    g = f64 1.0
  end
  for i ulong 64
    g = mul f64 0.5 add g div x g
  end
  ret g
end

note ---- Pool initialization ----
fn tcd_init_pools to long
  if ne get g_pools_rdy 0 0
    ret TY_OK
  end
  rc = enlarge g_ev TCD_MAX_EV
  if ne rc 0
    ret TY_E_IO
  end
  rc = enlarge g_md_rkey TCD_MAX_MROWS
  if ne rc 0
    ret TY_E_IO
  end
  rc = enlarge g_md_rq mul TCD_MAX_MROWS 16
  if ne rc 0
    ret TY_E_IO
  end
  rc = enlarge g_mcode TCD_MCODE_CAP
  if ne rc 0
    ret TY_E_IO
  end
  rc = enlarge g_ht_k TCD_HT_CAP
  if ne rc 0
    ret TY_E_IO
  end
  rc = enlarge g_ht_s TCD_HT_CAP
  if ne rc 0
    ret TY_E_IO
  end
  rc = enlarge g_ht_rk TCD_MAX_MROWS
  if ne rc 0
    ret TY_E_IO
  end
  rc = enlarge g_ht_rc mul TCD_MAX_MROWS 16
  if ne rc 0
    ret TY_E_IO
  end
  put g_pools_rdy 0 1
  ret TY_OK
end

note ---- 128-bit unsigned arithmetic ----
fn ty_mul128 a ulong b ulong to void
  m = ulong 0xffffffff
  p0 = mul and a m and b m
  p1 = mul and a m shr b 32
  p2 = mul shr a 32 and b m
  mid = add add shr p0 32 and p1 m and p2 m
  put g_ty_u128 1 or and p0 m shl and mid m 32
  hi = mul shr a 32 shr b 32
  hi = add hi shr p1 32
  hi = add hi shr p2 32
  put g_ty_u128 0 add hi shr mid 32
end

fn ty_div128 nhi ulong nlo ulong dhi ulong dlo ulong to void
  qhi = ulong 0
  qlo = ulong 0
  rhi = ulong 0
  rlo = ulong 0
  for i ulong 128
    bit = ulong 0
    if lt i 64
      bit = and shr nhi sub 63 i 1
    else
      bit = and shr nlo sub 127 i 1
    end
    rhi = or shl rhi 1 shr rlo 63
    rlo = or shl rlo 1 bit
    ge_d = false
    if gt rhi dhi
      ge_d = true
    else
      if eq rhi dhi
        if ge rlo dlo
          ge_d = true
        end
      end
    end
    qhi = or shl qhi 1 shr qlo 63
    qlo = shl qlo 1
    if ge_d
      bor = ulong 0
      if lt rlo dlo
        bor = 1
      end
      rlo = sub rlo dlo
      rhi = sub sub rhi dhi bor
      qlo = or qlo 1
    end
  end
  put g_ty_u128 2 qhi
  put g_ty_u128 3 qlo
  put g_ty_u128 4 rhi
  put g_ty_u128 5 rlo
end

note ---- TY-1 Math ----
fn ty_clz64 x ulong to ulong
  if eq x 0
    ret 64
  end
  n = ulong 0
  v = x
  if eq shr v 32 0
    n = add n 32
    v = shl v 32
  end
  if eq shr v 48 0
    n = add n 16
    v = shl v 16
  end
  if eq shr v 56 0
    n = add n 8
    v = shl v 8
  end
  if eq shr v 60 0
    n = add n 4
    v = shl v 4
  end
  if eq shr v 62 0
    n = add n 2
    v = shl v 2
  end
  if eq shr v 63 0
    n = add n 1
  end
  ret n
end

fn ty_log2_q32 x ulong to ulong
  if eq x 0
    ret 0
  end
  e = sub 63 ty_clz64 x
  m = ulong 0
  if le e 62
    m = shl x sub 62 e
  else
    m = shr x 1
  end
  frac = ulong 0
  two = shl ulong 1 63
  for i ulong 32
    ty_mul128 m m
    hi = get g_ty_u128 0
    lo = get g_ty_u128 1
    m = or shl hi 2 shr lo 62
    frac = shl frac 1
    if ge m two
      m = shr m 1
      frac = or frac 1
    end
  end
  ret or shl e 32 frac
end

fn ty_q32_to_ub v ulong to long
  ty_mul128 v ulong 1000000
  hi = get g_ty_u128 0
  lo = get g_ty_u128 1
  half = shl ulong 1 31
  lo2 = add lo half
  if lt lo2 lo
    hi = add hi 1
  end
  ret long or shl hi 32 shr lo2 32
end

fn ty_ub_tbl_init to void
  put g_ty_ub_tbl 0 TY_E_RANGE
  top = shl TY_QBITS 32
  q = ulong 1
  while le q TY_QONE bound 65540
    v = sub top ty_log2_q32 q
    put g_ty_ub_tbl q ty_q32_to_ub v
    q = add q 1
  end
  put g_ty_ub_rdy 0 1
end

fn ty_ubits_q16 q ulong to long
  if or eq q 0 gt q TY_QONE
    ret TY_E_RANGE
  end
  if eq get g_ty_ub_rdy 0 0
    ty_ub_tbl_init
  end
  ret get g_ty_ub_tbl q
end

fn ty_add a long b long to long
  im = bitcast long or shl ulong 0x7fffffff 32 ulong 0xffffffff
  inm = bitcast long shl ulong 0x80000000 32
  if gt b 0
    if gt a sub im b
      ret TY_E_OVERFLOW
    end
  end
  if lt b 0
    if lt a sub inm b
      ret TY_E_OVERFLOW
    end
  end
  put g_ty_ret_i 0 add a b
  ret TY_OK
end

fn ty_bits_to_ub bits ulong to long
  if gt bits ulong 9223372036854
    ret TY_E_OVERFLOW
  end
  put g_ty_ret_i 0 mul long bits TY_UB_PER_BIT
  ret TY_OK
end

fn ty_dl mbits ulong data_ub long to long
  if lt data_ub 0
    ret TY_E_RANGE
  end
  rc = ty_bits_to_ub mbits
  if ne rc TY_OK
    ret rc
  end
  ret ty_add get g_ty_ret_i 0 data_ub
end

global g_qkt_wh ulong 16
global g_qkt_wl ulong 16
global g_qkt_rh ulong 16
global g_qkt_rl ulong 16
global g_qkt_gv uchar 16

fn ty_qkt_pick k ulong to ulong
  best = long -1
  for s ulong k bound 16
    if eq get g_qkt_gv s 0
      take = false
      if lt best 0
        take = true
      else
        bu = ulong best
        if gt get g_qkt_rh s get g_qkt_rh bu
          take = true
        else
          if eq get g_qkt_rh s get g_qkt_rh bu
            if gt get g_qkt_rl s get g_qkt_rl bu
              take = true
            end
          end
        end
      end
      if take
        best = long s
      end
    end
  end
  ret ulong best
end

fn ty_qkt_weights counts view ulong * k ulong to long
  whi = ulong 0
  wlo = ulong 0
  lim = shl ulong 1 62
  for s ulong k bound 16
    c = get counts s
    if gt c lim
      ret TY_E_RANGE
    end
    lo = add shl c 1 1
    hi = shr c 63
    put g_qkt_wh s hi
    put g_qkt_wl s lo
    nlo = add wlo lo
    if lt nlo wlo
      whi = add whi 1
    end
    wlo = nlo
    whi = add whi hi
  end
  put g_ty_u128 6 whi
  put g_ty_u128 7 wlo
  ret TY_OK
end

fn ty_quantize_kt counts view ulong * k ulong q edit uint * to long
  if or lt k 2 gt k TY_KMAX
    ret TY_E_ARG
  end
  if ne ty_qkt_weights counts k TY_OK
    ret TY_E_RANGE
  end
  r_val = sub TY_QONE k
  bsum = ulong 0
  for s ulong k bound 16
    ty_mul128 r_val get g_qkt_wl s
    thi = add get g_ty_u128 0 mul r_val get g_qkt_wh s
    ty_div128 thi get g_ty_u128 1 get g_ty_u128 6 get g_ty_u128 7
    b = get g_ty_u128 3
    put g_qkt_rh s get g_ty_u128 4
    put g_qkt_rl s get g_ty_u128 5
    put q s add uint 1 uint b
    put g_qkt_gv s uchar 0
    bsum = add bsum b
  end
  left = sub r_val bsum
  while gt left 0 bound 32
    bu = ty_qkt_pick k
    put g_qkt_gv bu uchar 1
    put q bu add get q bu uint 1
    left = sub left 1
  end
  ret TY_OK
end

note ---- FIPS 180-4 SHA-256 ----
fn sh_init_tbl to void
  if ne get g_shk 0 0
    ret
  end
  put g_shk 0 1116352408
  put g_shk 1 1899447441
  put g_shk 2 3049323471
  put g_shk 3 3921009573
  put g_shk 4 961987163
  put g_shk 5 1508970993
  put g_shk 6 2453635748
  put g_shk 7 2870763221
  put g_shk 8 3624381080
  put g_shk 9 310598401
  put g_shk 10 607225278
  put g_shk 11 1426881987
  put g_shk 12 1925078388
  put g_shk 13 2162078206
  put g_shk 14 2614888103
  put g_shk 15 3248222580
  put g_shk 16 3835390401
  put g_shk 17 4022224774
  put g_shk 18 264347078
  put g_shk 19 604807628
  put g_shk 20 770255983
  put g_shk 21 1249150122
  put g_shk 22 1555081692
  put g_shk 23 1996064986
  put g_shk 24 2554220882
  put g_shk 25 2821834349
  put g_shk 26 2952996808
  put g_shk 27 3210313671
  put g_shk 28 3336571891
  put g_shk 29 3584528711
  put g_shk 30 113926993
  put g_shk 31 338241895
  put g_shk 32 666307205
  put g_shk 33 773529912
  put g_shk 34 1294757372
  put g_shk 35 1396182291
  put g_shk 36 1695183700
  put g_shk 37 1986661051
  put g_shk 38 2177026350
  put g_shk 39 2456956037
  put g_shk 40 2730485921
  put g_shk 41 2820302411
  put g_shk 42 3259730800
  put g_shk 43 3345764771
  put g_shk 44 3516065817
  put g_shk 45 3600352804
  put g_shk 46 4094571909
  put g_shk 47 275423344
  put g_shk 48 430227734
  put g_shk 49 506948616
  put g_shk 50 659060556
  put g_shk 51 883997877
  put g_shk 52 958139571
  put g_shk 53 1322822218
  put g_shk 54 1537002063
  put g_shk 55 1747873779
  put g_shk 56 1955562222
  put g_shk 57 2024104815
  put g_shk 58 2227730452
  put g_shk 59 2361852424
  put g_shk 60 2428436474
  put g_shk 61 2756734187
  put g_shk 62 3204031479
  put g_shk 63 3329325298
  put g_shk 64 1779033703
  put g_shk 65 3144134277
  put g_shk 66 1013904242
  put g_shk 67 2773480762
  put g_shk 68 1359893119
  put g_shk 69 2600822924
  put g_shk 70 528734635
  put g_shk 71 1541459225
end

fn sh_load_w to void
  for i ulong 16
    b0 = shl uint get g_shb mul i 4 uint 24
    b1 = shl uint get g_shb add mul i 4 1 uint 16
    b2 = shl uint get g_shb add mul i 4 2 uint 8
    b3 = uint get g_shb add mul i 4 3
    put g_shw i or or b0 b1 or b2 b3
  end
  i = ulong 16
  while lt i 64 bound 64
    x = get g_shw sub i 15
    s0 = xor xor rotr x uint 7 rotr x uint 18 shr x uint 3
    y = get g_shw sub i 2
    s1 = xor xor rotr y uint 17 rotr y uint 19 shr y uint 10
    put g_shw i add add get g_shw sub i 16 s0 add get g_shw sub i 7 s1
    i = add i 1
  end
end

fn sh_round j ulong to void
  e = get g_shv 4
  s1 = xor rotr e uint 6 rotr e uint 11
  s1 = xor s1 rotr e uint 25
  ch = xor and e get g_shv 5 and not e get g_shv 6
  t1 = add get g_shv 7 s1
  t1 = add t1 ch
  t1 = add t1 get g_shk j
  t1 = add t1 get g_shw j
  a = get g_shv 0
  s0 = xor rotr a uint 2 rotr a uint 13
  s0 = xor s0 rotr a uint 22
  maj = xor and a get g_shv 1 and a get g_shv 2
  maj = xor maj and get g_shv 1 get g_shv 2
  t2 = add s0 maj
  put g_shv 7 get g_shv 6
  put g_shv 6 get g_shv 5
  put g_shv 5 e
  put g_shv 4 add get g_shv 3 t1
  put g_shv 3 get g_shv 2
  put g_shv 2 get g_shv 1
  put g_shv 1 a
  put g_shv 0 add t1 t2
end

fn sh_block to void
  sh_load_w
  for j ulong 8
    put g_shv j get g_shh j
  end
  for j ulong 64
    sh_round j
  end
  for j ulong 8
    put g_shh j add get g_shh j get g_shv j
  end
end

fn sh_init to void
  sh_init_tbl
  for i ulong 8
    put g_shh i get g_shk add i 64
  end
  put g_shm 0 0
  put g_shm 1 0
end

fn sh_byte b uchar to void
  bl = get g_shm 0
  put g_shb bl b
  bl = add bl 1
  put g_shm 1 add get g_shm 1 1
  if eq bl 64
    sh_block
    bl = 0
  end
  put g_shm 0 bl
end

fn sh_slice s view uchar * n ulong to void
  for i ulong n bound 100000
    sh_byte get s i
  end
end

fn sh_final slot ulong to void
  tot = get g_shm 1
  bits = mul tot 8
  sh_byte uchar 128
  while ne get g_shm 0 56 bound 128
    sh_byte uchar 0
  end
  for i ulong 8
    sh = mul sub 7 i 8
    sh_byte uchar and shr bits sh 255
  end
  off = mul slot 32
  for i ulong 8
    w = get g_shh i
    o = add off mul i 4
    put g_dig o uchar and shr w uint 24 uint 255
    put g_dig add o 1 uchar and shr w uint 16 uint 255
    put g_dig add o 2 uchar and shr w uint 8 uint 255
    put g_dig add o 3 uchar and w uint 255
  end
end

fn dg_eq s1 ulong s2 ulong to bool
  o1 = mul s1 32
  o2 = mul s2 32
  for i ulong 32
    if ne get g_dig add o1 i get g_dig add o2 i
      ret false
    end
  end
  ret true
end

fn dg_parse_hex_at s view uchar * off ulong n ulong slot ulong to long
  if lt n 64
    ret TY_E_FORMAT
  end
  o = mul slot 32
  for i ulong 32
    v = ulong 0
    for j ulong 2
      c = get s add off add mul i 2 j
      d = long -1
      if and ge c 48 le c 57
        d = long sub c 48
      else
        if and ge c 97 le c 102
          d = add long sub c 97 10
        end
      end
      if lt d 0
        ret TY_E_FORMAT
      end
      v = add mul v 16 ulong d
    end
    put g_dig add o i uchar v
  end
  ret TY_OK
end

note Hash file at g_path[0..g_plen-1] into g_dig[slot]; stores total byte count in g_ty_ret_u[0]
fn ty_file_sha256_gp slot ulong to long
  fd = fopen g_path 0 get g_plen 0 int 0 int 0
  if lt fd 0
    ret TY_E_IO
  end
  sh_init
  tot = ulong 0
  done = false
  while not done bound 10000000
    k = read int fd g_fbuf 0 65536
    if lt k 0
      dc = fclose int fd
      ret TY_E_IO
    end
    if eq k 0
      done = true
    else
      ku = ulong k
      tot = add tot ku
      for i ulong ku bound 65536
        sh_byte get g_fbuf i
      end
    end
  end
  dc = fclose int fd
  sh_final slot
  put g_ty_ret_u 0 tot
  ret TY_OK
end

note ---- Packed CTR1 events ----
fn ev_pack sym ulong op ulong dep ulong first ulong crumb ulong idx ulong to ulong
  v = and sym 15
  v = or v shl and op 15 4
  v = or v shl and dep 7 8
  v = or v shl and first 1 11
  v = or v shl and crumb 65535 13
  v = or v shl and idx 0x7fffffff 29
  ret v
end

fn ev_sym e ulong to ulong
  ret and e 15
end

fn ev_op e ulong to ulong
  ret and shr e 4 15
end

fn ev_dep e ulong to ulong
  ret and shr e 8 7
end

fn ev_first e ulong to ulong
  ret and shr e 11 1
end

fn ev_crumb e ulong to ulong
  ret and shr e 13 65535
end

fn ev_idx e ulong to ulong
  ret and shr e 29 0x7fffffff
end

fn st_begin sid ulong to void
  put g_st_off sid get g_ev_used 0
  put g_st_n sid 0
  put g_st_ncr sid 0
  put g_st_gap sid 0
end

fn st_push sid ulong ev ulong to long
  used = get g_ev_used 0
  if ge used TCD_MAX_EV
    ret TY_E_IO
  end
  put g_ev used ev
  put g_ev_used 0 add used 1
  put g_st_n sid add get g_st_n sid 1
  if ne ev_first ev 0
    put g_st_ncr sid add get g_st_ncr sid 1
  end
  ret TY_OK
end

note ---- CTR1 Reader ----
fn rd16_fb off ulong to ulong
  ret or ulong get g_fbuf off shl ulong get g_fbuf add off 1 8
end

fn rd32_fb off ulong to ulong
  b0 = ulong get g_fbuf off
  b1 = shl ulong get g_fbuf add off 1 8
  b2 = shl ulong get g_fbuf add off 2 16
  b3 = shl ulong get g_fbuf add off 3 24
  ret or or b0 b1 or b2 b3
end

fn ty_ctr1_dec_fb off ulong prev long to long
  for i ulong 4
    if ne get g_fbuf add off i get t_ctr1_mag i
      ret TY_E_FORMAT
    end
  end
  if ne rd16_fb add off 4 1
    ret TY_E_FORMAT
  end
  if ne get g_fbuf add off 22 uchar 0
    ret TY_E_FORMAT
  end
  if or gt get g_fbuf add off 24 uchar 4 gt get g_fbuf add off 25 uchar 2
    ret TY_E_FORMAT
  end
  kind = ulong get g_fbuf add off 6
  rc_v = ulong get g_fbuf add off 7
  prn = ulong get g_fbuf add off 23
  sym = ulong 0
  out_op = ulong 0
  if eq kind 1
    op = rd16_fb add off 20
    if or ge op TY_CTR1_NOPS gt prn 4
      ret TY_E_FORMAT
    end
    if ne prn 0
      if ne rc_v 1
        ret TY_E_FORMAT
      end
      sym = sub prn 1
    else
      if or lt rc_v 2 gt rc_v 4
        ret TY_E_FORMAT
      end
      sym = add 4 sub rc_v 2
    end
    out_op = op
  else
    if eq kind 2
      if or ne prn 0 or lt rc_v 5 gt rc_v 7
        ret TY_E_FORMAT
      end
      if eq rc_v 5
        sym = 7
      else
        sym = 8
      end
      out_op = TY_OP_SUBMIT
    else
      ret TY_E_FORMAT
    end
  end
  dep = rd16_fb add off 29
  if gt dep TY_DEPTH_CLIP
    dep = TY_DEPTH_CLIP
  end
  idx = rd32_fb add off 8
  first = ulong 0
  if eq idx 0
    first = 1
  else
    if or lt prev 0 le long idx prev
      ret TY_E_FORMAT
    end
  end
  put g_ty_ret_u 0 ev_pack sym out_op dep first 0 idx
  ret TY_OK
end

global g_cr_st long 4

fn ty_ctr1_chunk sid ulong nrec ulong to long
  n = get g_cr_st 0
  prev = get g_cr_st 1
  crumb = ulong get g_cr_st 2
  for i ulong nrec bound 260
    rc = ty_ctr1_dec_fb mul i TY_CTR1_BYTES prev
    if ne rc TY_OK
      ret rc
    end
    ev = get g_ty_ret_u 0
    idx = ev_idx ev
    if ne ev_first ev 0
      if gt n 0
        crumb = add crumb 1
      end
    else
      if ne long idx add prev 1
        put g_st_gap sid add get g_st_gap sid 1
      end
    end
    cr_c = crumb
    if gt cr_c 65535
      cr_c = 65535
    end
    ev2 = or ev shl cr_c 13
    prev = long idx
    if ne st_push sid ev2 TY_OK
      ret TY_E_IO
    end
    n = add n 1
  end
  put g_cr_st 0 n
  put g_cr_st 1 prev
  put g_cr_st 2 long crumb
  ret TY_OK
end

fn fb_shift used ulong rem_b ulong to void
  for i ulong rem_b bound 247
    put g_fbuf i get g_fbuf add used i
  end
end

fn ty_ctr1_read_gp sid ulong to long
  fd = fopen g_path 0 get g_plen 0 int 0 int 0
  if lt fd 0
    ret TY_E_IO
  end
  put g_cr_st 0 0
  put g_cr_st 1 -1
  put g_cr_st 2 0
  rem_b = ulong 0
  done = false
  while not done bound 10000000
    k = read int fd g_fbuf rem_b sub 64220 rem_b
    if lt k 0
      dc = fclose int fd
      ret TY_E_IO
    end
    if eq k 0
      done = true
    else
      tot = add rem_b ulong k
      nrec = div tot TY_CTR1_BYTES
      crc = ty_ctr1_chunk sid nrec
      if ne crc TY_OK
        dc = fclose int fd
        ret crc
      end
      used = mul nrec TY_CTR1_BYTES
      rem_b = sub tot used
      fb_shift used rem_b
    end
  end
  dc = fclose int fd
  if ne rem_b 0
    ret TY_E_FORMAT
  end
  ret get g_cr_st 0
end

note ---- TYM0 Context-Table Models (single active slot) ----
fn ty_key_space mask ulong k ulong to long
  if or ne and mask not TY_F_ALL 0 or lt k 2 gt k TY_KMAX
    ret TY_E_ARG
  end
  p = ulong 1
  lim = shl ulong 1 62
  if ne and mask TY_F_OP 0
    p = mul p 16
  end
  if ne and mask TY_F_DEPTH 0
    p = mul p 8
  end
  kp1 = add k 1
  if ne and mask TY_F_PREV1 0
    p = mul p kp1
  end
  if ne and mask TY_F_PREV2 0
    p = mul p kp1
  end
  if ne and mask TY_F_PREV3 0
    p = mul p kp1
  end
  if ne and mask TY_F_PREV4 0
    p = mul p kp1
  end
  if ne and mask TY_F_PREV5 0
    p = mul p kp1
  end
  if ne and mask TY_F_POS 0
    if gt p shr lim 36
      ret TY_E_RANGE
    end
    p = shl p 36
  end
  if gt p lim
    ret TY_E_RANGE
  end
  bits = ulong 0
  if gt p 1
    bits = sub 64 ty_clz64 sub p 1
  end
  put g_ty_ret_u 0 p
  put g_ty_ret_u 1 bits
  ret TY_OK
end

global g_kw ulong 8
fn kw_init mask ulong k ulong to void
  put g_kw 0 mask
  put g_kw 1 k
  put g_kw 2 k
  put g_kw 3 k
  put g_kw 4 k
  put g_kw 5 k
  put g_kw 6 k
end

fn kw_key ev ulong to ulong
  mask = get g_kw 0
  k = get g_kw 1
  if ne ev_first ev 0
    put g_kw 2 k
    put g_kw 3 k
    put g_kw 4 k
    put g_kw 5 k
    put g_kw 6 k
  end
  key = ulong 0
  m = ulong 1
  if ne and mask TY_F_OP 0
    key = add key mul ev_op ev m
    m = mul m 16
  end
  if ne and mask TY_F_DEPTH 0
    key = add key mul ev_dep ev m
    m = mul m 8
  end
  kp1 = add k 1
  if ne and mask TY_F_PREV1 0
    key = add key mul get g_kw 2 m
    m = mul m kp1
  end
  if ne and mask TY_F_PREV2 0
    key = add key mul get g_kw 3 m
    m = mul m kp1
  end
  if ne and mask TY_F_PREV3 0
    key = add key mul get g_kw 4 m
    m = mul m kp1
  end
  if ne and mask TY_F_PREV4 0
    key = add key mul get g_kw 5 m
    m = mul m kp1
  end
  if ne and mask TY_F_PREV5 0
    key = add key mul get g_kw 6 m
    m = mul m kp1
  end
  if ne and mask TY_F_POS 0
    idx = ev_idx ev
    if ge idx 1048576
      idx = 1048575
    end
    pv = or shl ev_crumb ev 20 idx
    key = add key mul pv m
  end
  ret key
end

fn kw_adv ev ulong to void
  put g_kw 6 get g_kw 5
  put g_kw 5 get g_kw 4
  put g_kw 4 get g_kw 3
  put g_kw 3 get g_kw 2
  put g_kw 2 ev_sym ev
end

fn ty_mix64 x ulong to ulong
  z = xor x shr x 33
  z = mul z or shl ulong 0xff51afd7 32 ulong 0xed558ccd
  z = xor z shr z 33
  z = mul z or shl ulong 0xc4ceb9fe 32 ulong 0x1a85ec53
  ret xor z shr z 33
end

global g_ht_n ulong 1

fn ht_clear to void
  put g_ht_n 0 0
  for i ulong TCD_HT_CAP bound 8388608
    put g_ht_s i uint 0
  end
end

fn ht_inc key ulong sym ulong to long
  j = and ty_mix64 key sub TCD_HT_CAP 1
  while ne get g_ht_s j uint 0 bound 8388608
    if eq get g_ht_k j key
      ri = sub ulong get g_ht_s j 1
      o = add mul ri 16 sym
      put g_ht_rc o add get g_ht_rc o uint 1
      ret TY_OK
    end
    j = and add j 1 sub TCD_HT_CAP 1
  end
  n = get g_ht_n 0
  if ge n TCD_MAX_MROWS
    ret TY_E_IO
  end
  put g_ht_rk n key
  bo = mul n 16
  for x ulong 16
    put g_ht_rc add bo x uint 0
  end
  put g_ht_rc add bo sym uint 1
  put g_ht_k j key
  put g_ht_s j uint add n 1
  put g_ht_n 0 add n 1
  ret TY_OK
end

fn md_swap_row a ulong b ulong to void
  ka = get g_md_rkey a
  put g_md_rkey a get g_md_rkey b
  put g_md_rkey b ka
  oa = mul a 16
  ob = mul b 16
  for x ulong 16
    t = get g_md_rq add oa x
    put g_md_rq add oa x get g_md_rq add ob x
    put g_md_rq add ob x t
  end
end

fn md_sift_step root ulong end_n ulong to ulong
  ch = add mul root 2 1
  sw = root
  if lt get g_md_rkey sw get g_md_rkey ch
    sw = ch
  end
  ch2 = add ch 1
  if lt ch2 end_n
    if lt get g_md_rkey sw get g_md_rkey ch2
      sw = ch2
    end
  end
  ret sw
end

fn md_sift start ulong end_n ulong to void
  root = start
  while lt add mul root 2 1 end_n bound 128
    sw = md_sift_step root end_n
    if eq sw root
      ret
    end
    md_swap_row root sw
    root = sw
  end
end

fn md_sort to void
  n = get g_md_nr 0
  if le n 1
    ret
  end
  i = div n 2
  while gt i 0 bound 4194304
    i = sub i 1
    md_sift i n
  end
  e = n
  while gt e 1 bound 4194304
    e = sub e 1
    md_swap_row 0 e
    md_sift 0 e
  end
end

fn ty_model_uniform k ulong to long
  if or lt k 2 gt k TY_KMAX
    ret TY_E_ARG
  end
  put g_md_k 0 k
  put g_md_mask 0 0
  put g_md_kb 0 0
  put g_md_nr 0 0
  z = new ulong 16 0
  q = new uint 16 0
  rc = ty_quantize_kt z k q
  if ne rc TY_OK
    ret rc
  end
  for x ulong k bound 16
    put g_md_def x get q x
  end
  ret TY_OK
end

global g_fit_cnt ulong 16
global g_fit_rq uint 16
global g_fit_tot ulong 16

fn ty_mdl_save k ulong to long
  sv = long 0
  for x ulong k bound 16
    u1 = ty_ubits_q16 ulong get g_md_def x
    u2 = ty_ubits_q16 ulong get g_fit_rq x
    c = long get g_fit_cnt x
    sv = add sv mul c sub u1 u2
  end
  ret sv
end

fn ty_store_row i ulong k ulong to void
  nr = get g_md_nr 0
  put g_md_rkey nr get g_ht_rk i
  ro = mul nr 16
  for x ulong k bound 16
    put g_md_rq add ro x get g_fit_rq x
  end
  put g_md_nr 0 add nr 1
end

fn ty_fit_one_row i ulong k ulong rcost long rule ulong to long
  cnt = new ulong 16 0
  rq = new uint 16 0
  ho = mul i 16
  for x ulong k bound 16
    v = ulong get g_ht_rc add ho x
    put cnt x v
    put g_fit_cnt x v
  end
  if ne ty_quantize_kt cnt k rq TY_OK
    ret TY_E_RANGE
  end
  for x ulong k bound 16
    put g_fit_rq x get rq x
  end
  if eq rule TY_FIT_MDL_PRUNE
    if le ty_mdl_save k rcost
      ret TY_OK
    end
  end
  ty_store_row i k
  ret TY_OK
end

fn ty_fit_rows k ulong kb ulong rule ulong to long
  rcost = mul long add kb mul sub k 1 TY_QBITS TY_UB_PER_BIT
  hn = get g_ht_n 0
  for i ulong hn bound 4194304
    rc = ty_fit_one_row i k rcost rule
    if ne rc TY_OK
      ret rc
    end
  end
  md_sort
  ret TY_OK
end

fn ty_fit_stream sid ulong mask ulong k ulong to long
  kw_init mask k
  so = get g_st_off sid
  sn = get g_st_n sid
  for t ulong sn bound 16777216
    ev = get g_ev add so t
    sym = ev_sym ev
    if ge sym k
      ret TY_E_RANGE
    end
    key = kw_key ev
    put g_fit_tot sym add get g_fit_tot sym 1
    if ne mask 0
      if ne ht_inc key sym TY_OK
        ret TY_E_IO
      end
    end
    kw_adv ev
  end
  ret TY_OK
end

fn ty_model_fit ns ulong mask ulong k ulong rule ulong to long
  if and ne rule TY_FIT_KEEP_ALL ne rule TY_FIT_MDL_PRUNE
    ret TY_E_ARG
  end
  rc = ty_key_space mask k
  if ne rc TY_OK
    ret rc
  end
  kb = get g_ty_ret_u 1
  put g_md_k 0 k
  put g_md_mask 0 mask
  put g_md_kb 0 kb
  put g_md_nr 0 0
  for x ulong 16
    put g_fit_tot x 0
  end
  if ne mask 0
    ht_clear
  end
  for si ulong ns bound 8
    src = ty_fit_stream get g_fit_sids si mask k
    if ne src TY_OK
      ret src
    end
  end
  tot = new ulong 16 0
  for x ulong k bound 16
    put tot x get g_fit_tot x
  end
  dq = new uint 16 0
  if ne ty_quantize_kt tot k dq TY_OK
    ret TY_E_RANGE
  end
  for x ulong k bound 16
    put g_md_def x get dq x
  end
  if eq mask 0
    ret TY_OK
  end
  ret ty_fit_rows k kb rule
end

note ---- TYM0 Bitstream Encode / Decode ----
global g_bw_bits ulong 1
global g_br_pos ulong 1
global g_br_nbits ulong 1
global g_br_err ulong 1

fn bw_bit b ulong to void
  bi = get g_bw_bits 0
  by = div bi 8
  sh = sub 7 rem bi 8
  if eq rem bi 8 0
    put g_mcode by uchar 0
  end
  if ne b 0
    put g_mcode by or get g_mcode by uchar shl ulong 1 sh
  end
  put g_bw_bits 0 add bi 1
end

fn bw_put v ulong n ulong to void
  i = n
  while gt i 0 bound 64
    i = sub i 1
    bw_bit and shr v i 1
  end
end

fn br_get n ulong to ulong
  pos = get g_br_pos 0
  if gt add pos n get g_br_nbits 0
    put g_br_err 0 1
    ret 0
  end
  v = ulong 0
  for i ulong n bound 64
    by = div pos 8
    sh = sub 7 rem pos 8
    bit = and shr ulong get g_mcode by sh 1
    v = or shl v 1 bit
    pos = add pos 1
  end
  put g_br_pos 0 pos
  ret v
end

fn ty_menc_row i ulong k ulong kb ulong to void
  bw_put get g_md_rkey i kb
  ro = mul i 16
  for x ulong sub k 1 bound 16
    bw_put ulong get g_md_rq add ro x TY_QBITS
  end
end

fn ty_model_encode to long
  k = get g_md_k 0
  mask = get g_md_mask 0
  nr = get g_md_nr 0
  rc = ty_key_space mask k
  if ne rc TY_OK
    ret rc
  end
  kb = get g_ty_ret_u 1
  rowb = mul sub k 1 TY_QBITS
  bits = add add TY_MODEL_HEADER_BITS rowb mul nr add kb rowb
  nby = div add bits 7 8
  if gt nby TCD_MCODE_CAP
    ret TY_E_IO
  end
  put g_bw_bits 0 0
  bw_put ulong 0x54594d30 32
  bw_put TY_MODEL_VERSION 8
  bw_put k 8
  bw_put mask 8
  bw_put TY_QBITS 8
  bw_put kb 8
  bw_put nr 32
  for x ulong sub k 1 bound 16
    bw_put ulong get g_md_def x TY_QBITS
  end
  for i ulong nr bound 4194304
    ty_menc_row i k kb
  end
  put g_mclen 0 nby
  put g_mcbits 0 bits
  ret TY_OK
end

fn br_get_row k ulong q edit uint * to long
  s = ulong 0
  for x ulong sub k 1 bound 16
    v = br_get TY_QBITS
    if ne get g_br_err 0 0
      ret TY_E_FORMAT
    end
    if or eq v 0 gt v TY_QONE
      ret TY_E_RANGE
    end
    put q x uint v
    s = add s v
  end
  if ge s TY_QONE
    ret TY_E_NORM
  end
  put q sub k 1 uint sub TY_QONE s
  ret TY_OK
end

fn ty_mdec_one i ulong rk ulong to long
  q = new uint 16 0
  k = get g_md_k 0
  rc = br_get_row k q
  if ne rc TY_OK
    ret rc
  end
  put g_md_rkey i rk
  ro = mul i 16
  for x ulong k bound 16
    put g_md_rq add ro x get q x
  end
  ret TY_OK
end

fn ty_mdec_rows nr ulong space ulong to long
  k = get g_md_k 0
  kb = get g_md_kb 0
  dq = new uint 16 0
  rc = br_get_row k dq
  if ne rc TY_OK
    ret rc
  end
  for x ulong k bound 16
    put g_md_def x get dq x
  end
  prevk = ulong 0
  for i ulong nr bound 4194304
    rk = br_get kb
    if ne get g_br_err 0 0
      ret TY_E_FORMAT
    end
    if ge rk space
      ret TY_E_RANGE
    end
    if and gt i 0 le rk prevk
      ret TY_E_FORMAT
    end
    prevk = rk
    rc2 = ty_mdec_one i rk
    if ne rc2 TY_OK
      ret rc2
    end
  end
  put g_md_nr 0 nr
  rem_bits = sub get g_br_nbits 0 get g_br_pos 0
  if and gt rem_bits 0 ne br_get rem_bits 0
    ret TY_E_FORMAT
  end
  ret TY_OK
end

fn ty_model_decode nby ulong to long
  put g_br_pos 0 0
  put g_br_nbits 0 mul nby 8
  put g_br_err 0 0
  if or ne br_get 32 ulong 0x54594d30 ne get g_br_err 0 0
    ret TY_E_FORMAT
  end
  ver = br_get 8
  k = br_get 8
  mask = br_get 8
  qb = br_get 8
  kb = br_get 8
  nr = br_get 32
  if ne get g_br_err 0 0
    ret TY_E_FORMAT
  end
  if or ne ver TY_MODEL_VERSION ne qb TY_QBITS
    ret TY_E_PROFILE
  end
  if or ne ty_key_space mask k TY_OK ne kb get g_ty_ret_u 1
    ret TY_E_FORMAT
  end
  if gt nr TCD_MAX_MROWS
    ret TY_E_IO
  end
  put g_md_k 0 k
  put g_md_mask 0 mask
  put g_md_kb 0 kb
  put g_md_nr 0 0
  rowb = mul sub k 1 TY_QBITS
  need = add add TY_MODEL_HEADER_BITS rowb mul nr add kb rowb
  if ne div add need 7 8 nby
    ret TY_E_FORMAT
  end
  rc = ty_mdec_rows nr get g_ty_ret_u 0
  if ne rc TY_OK
    ret rc
  end
  put g_ty_ret_u 0 need
  ret TY_OK
end

fn md_find_row key ulong to long
  nr = get g_md_nr 0
  if eq nr 0
    ret -1
  end
  lo = ulong 0
  hi = nr
  while lt lo hi bound 32
    mid = add lo shr sub hi lo 1
    if lt get g_md_rkey mid key
      lo = add mid 1
    else
      hi = mid
    end
  end
  if lt lo nr
    if eq get g_md_rkey lo key
      ret long lo
    end
  end
  ret -1
end

fn md_lookup_q key ulong sym ulong to ulong
  ri = md_find_row key
  if ge ri 0
    ret ulong get g_md_rq add mul ulong ri 16 sym
  end
  ret ulong get g_md_def sym
end

fn ty_model_score_range so ulong sn ulong to long
  k = get g_md_k 0
  kw_init get g_md_mask 0 k
  tot = long 0
  for t ulong sn bound 16777216
    ev = get g_ev add so t
    sym = ev_sym ev
    if ge sym k
      ret TY_E_RANGE
    end
    qv = md_lookup_q kw_key ev sym
    b = ty_ubits_q16 qv
    if lt b 0
      ret TY_E_ZERO_REALIZED
    end
    if ne ty_add tot b TY_OK
      ret TY_E_OVERFLOW
    end
    tot = get g_ty_ret_i 0
    kw_adv ev
  end
  put g_ty_ret_i 0 tot
  put g_ty_ret_u 0 sn
  ret TY_OK
end

fn ty_model_score sid ulong to long
  ret ty_model_score_range get g_st_off sid get g_st_n sid
end

fn ty_model_digest nby ulong dslot ulong to void
  sh_init
  sh_slice t_ty_dom_model len t_ty_dom_model
  sh_byte uchar 0
  for i ulong nby bound 83886080
    sh_byte get g_mcode i
  end
  sh_final dslot
end

note ---- Manifest & dev seed loader (dev seeds 1-7 only) ----
fn tcd_read_arg idx ulong dst edit uchar * cap ulong to long
  got = argread idx dst 0 cap
  if or lt got 0 ge ulong got cap
    ret -1
  end
  ret got
end

fn tcd_check_seed_sub rel view uchar * rlen ulong seed_num ulong to bool
  pat = new uchar 32 0
  put pat 0 uchar 47
  put pat 1 uchar 115
  put pat 2 uchar 101
  put pat 3 uchar 101
  put pat 4 uchar 100
  put pat 5 uchar 45
  pl = ulong 6
  if ge seed_num 10
    put pat pl uchar add 48 div seed_num 10
    pl = add pl 1
    put pat pl uchar add 48 rem seed_num 10
    pl = add pl 1
  else
    put pat pl uchar add 48 seed_num
    pl = add pl 1
  end
  put pat pl uchar 47
  put pat add pl 1 uchar 99
  put pat add pl 2 uchar 111
  put pat add pl 3 uchar 110
  put pat add pl 4 uchar 116
  put pat add pl 5 uchar 114
  put pat add pl 6 uchar 111
  put pat add pl 7 uchar 108
  put pat add pl 8 uchar 47
  pl = add pl 9
  if lt rlen pl
    ret false
  end
  lim = add sub rlen pl 1
  for i ulong lim bound 256
    ok = true
    for j ulong pl bound 32
      if ne get rel add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn tcd_skip_ws p ulong endp ulong to ulong
  q = p
  while lt q endp bound 1400
    c = get g_man_buf q
    if and ne c 32 ne c 9
      ret q
    end
    q = add q 1
  end
  ret q
end

fn tcd_scan_tok p ulong endp ulong to ulong
  q = p
  while lt q endp bound 1400
    c = get g_man_buf q
    if or eq c 32 or eq c 9 eq c 13
      ret q
    end
    q = add q 1
  end
  ret q
end

fn tcd_parse_man_hex h0 ulong h1 ulong n ulong to long
  if ne sub h1 h0 64
    ret TY_E_FORMAT
  end
  hx = new uchar 64 0
  for i ulong 64
    put hx i get g_man_buf add h0 i
  end
  ret dg_parse_hex_at hx 0 64 n
end

fn tcd_store_man_rel r0 ulong rl ulong n ulong to long
  if or eq rl 0 ge rl 256
    ret TY_E_FORMAT
  end
  rel = new uchar 256 0
  for i ulong rl bound 256
    put rel i get g_man_buf add r0 i
  end
  if not tcd_check_seed_sub rel rl add n 1
    ret TY_E_FORMAT
  end
  rlen = get g_rlen 0
  if ge add add rlen 1 rl 1024
    ret TY_E_FORMAT
  end
  bo = mul n 1024
  for i ulong rlen bound 1024
    put g_man_path add bo i get g_root i
  end
  put g_man_path add bo rlen uchar 47
  for i ulong rl bound 256
    put g_man_path add add bo add rlen 1 i get rel i
  end
  put g_man_plen n add add rlen 1 rl
  ret TY_OK
end

fn tcd_parse_man_sz s0 ulong s1 ulong n ulong to long
  if eq s1 s0
    ret TY_E_FORMAT
  end
  sz = ulong 0
  p = s0
  while lt p s1 bound 32
    c = get g_man_buf p
    if or lt c 48 gt c 57
      ret TY_E_FORMAT
    end
    sz = add mul sz 10 ulong sub c 48
    p = add p 1
  end
  put g_man_size n sz
  ret TY_OK
end

fn tcd_parse_man_line off ulong llen ulong n ulong to long
  endp = add off llen
  p = tcd_skip_ws off endp
  q = tcd_scan_tok p endp
  if ne tcd_parse_man_hex p q n TY_OK
    ret TY_E_FORMAT
  end
  p = tcd_skip_ws q endp
  q = tcd_scan_tok p endp
  if ne tcd_parse_man_sz p q n TY_OK
    ret TY_E_FORMAT
  end
  p = tcd_skip_ws q endp
  q = tcd_scan_tok p endp
  ret tcd_store_man_rel p sub q p n
end

fn tcd_read_man_file mpath view uchar * mplen ulong to long
  for i ulong mplen bound 1024
    put g_path i get mpath i
  end
  put g_plen 0 mplen
  fd = fopen g_path 0 mplen int 0 int 0
  if lt fd 0
    ret TY_E_IO
  end
  tot = ulong 0
  done = false
  while not done bound 1000
    if ge tot 32768
      dc = fclose int fd
      ret TY_E_FORMAT
    end
    k = read int fd g_man_buf tot sub 32768 tot
    if lt k 0
      dc = fclose int fd
      ret TY_E_IO
    end
    if eq k 0
      done = true
    else
      tot = add tot ulong k
    end
  end
  dc = fclose int fd
  ret long tot
end

fn tcd_parse_man_lines tot ulong to long
  n = ulong 0
  pos = ulong 0
  while and lt pos tot lt n TCD_NSEED bound 1000
    ls = pos
    while lt pos tot bound 1400
      if eq get g_man_buf pos 10
        break
      end
      pos = add pos 1
    end
    ll = sub pos ls
    if lt pos tot
      pos = add pos 1
    end
    if gt ll 0
      c0 = get g_man_buf ls
      if ne c0 35
        rc = tcd_parse_man_line ls ll n
        if ne rc TY_OK
          ret rc
        end
        n = add n 1
      end
    end
  end
  if ne n TCD_NSEED
    ret TY_E_FORMAT
  end
  ret TY_OK
end

fn tcd_load_manifest mpath view uchar * mplen ulong root view uchar * rlen ulong to long
  rcp = tcd_init_pools
  if ne rcp TY_OK
    ret rcp
  end
  for i ulong rlen bound 1024
    put g_root i get root i
  end
  put g_rlen 0 rlen
  rtot = tcd_read_man_file mpath mplen
  if lt rtot 0
    ret rtot
  end
  ret tcd_parse_man_lines ulong rtot
end

text t_dev_seed "dev seed "
text t_col_sp ": "
text t_ev_cr " events, "
text t_cr_ok " crumbs, sha256 ok\n"

fn tcd_load_seed seed ulong to long
  if or lt seed 1 gt seed TCD_NDEV
    ret TY_E_LEAK
  end
  i = sub seed 1
  if ne get g_man_loaded i 0
    ret TY_OK
  end
  bo = mul i 1024
  pl = get g_man_plen i
  for j ulong pl bound 1024
    put g_path j get g_man_path add bo j
  end
  put g_plen 0 pl
  rc = ty_file_sha256_gp 15
  if ne rc TY_OK
    ret rc
  end
  if ne get g_ty_ret_u 0 get g_man_size i
    ret TY_E_IO
  end
  if not dg_eq 15 i
    ret TY_E_DIGEST
  end
  st_begin i
  nev = ty_ctr1_read_gp i
  if lt nev 0
    ret nev
  end
  ob_clr
  ob_txt t_dev_seed
  ob_u64 seed
  ob_txt t_col_sp
  ob_i64 nev
  ob_txt t_ev_cr
  ob_u64 get g_st_ncr i
  ob_txt t_cr_ok
  ob_flush int 2
  put g_man_loaded i 1
  ret TY_OK
end

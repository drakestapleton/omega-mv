note
note tools/turing_cal_dev.om -- Shared pure seeded OM-2 EXP-001 lane A engine:
note TY-1/TY-2 integer math, SHA-256, CTR1 reader, growable-pool TYM0 context-table
note fit/encode/decode/score/digest, and dev-seed manifest loader (dev seeds 1-7 only;
note held-out seeds 8-10 are parsed for count only and never opened).

const TY_QBITS ulong 16
const TY_QONE ulong 65536
const TY_UB_PER_BIT long 1000000
const TY_KMAX ulong 16
const TY_QERR_MILLI_UB ulong 501

const TY_OK long 0
const TY_E_NAN long -1
const TY_E_INF long -2
const TY_E_NEG long -3
const TY_E_NORM long -4
const TY_E_ZERO_REALIZED long -5
const TY_E_UNDERFLOW long -6
const TY_E_RANGE long -7
const TY_E_OVERFLOW long -8
const TY_E_ARG long -9
const TY_E_FORMAT long -10
const TY_E_PROFILE long -11
const TY_E_BASELINE long -12
const TY_E_LEAK long -13
const TY_E_PROVENANCE long -14
const TY_E_DIGEST long -15
const TY_E_IO long -16

const TY_CTR1_BYTES ulong 247
const TY_CTR1_NOPS ulong 15
const TY_OP_SUBMIT ulong 15
const TY_DEPTH_CLIP ulong 7
const TY_OUT_K ulong 9

const TY_MODEL_VERSION ulong 0
const TY_MODEL_HEADER_BITS ulong 104
const TY_F_OP ulong 1
const TY_F_DEPTH ulong 2
const TY_F_PREV1 ulong 4
const TY_F_PREV2 ulong 8
const TY_F_PREV3 ulong 16
const TY_F_POS ulong 32
const TY_F_PREV4 ulong 64
const TY_F_PREV5 ulong 128
const TY_F_ALL ulong 255
const TY_FIT_KEEP_ALL ulong 0
const TY_FIT_MDL_PRUNE ulong 1

const TCD_NSEED ulong 10
const TCD_NDEV ulong 7
const TCD_MAX_EV ulong 16777216
const TCD_MAX_MROWS ulong 4194304
const TCD_HT_CAP ulong 8388608
const TCD_MCODE_CAP ulong 83886080

text t_ty_dom_model "turing.ymodel.v0"
text t_hx "0123456789abcdef"
text t_ctr1_mag "CTR1"

note Return registers and 128-bit scratch
global g_ty_ret_i long 16
global g_ty_ret_u ulong 16
global g_ty_u128 ulong 8
global g_ty_ub_tbl long 65537
global g_ty_ub_rdy ulong 1

note SHA-256 state and 32-slot digest pool
global g_shk uint 72
global g_shh uint 8
global g_shw uint 64
global g_shv uint 8
global g_shb uchar 64
global g_shm ulong 2
global g_dig uchar 1024


note
note Pure seeded OM-2 RFC 1950 zlib / RFC 1951 DEFLATE decoder and Adler-32.
note Replaces tools/reservoir/res_inflate.{c,h}.
note Concatenated after src/reservoir/reservoir.om (which supplies the om2 header).

const RES_INF_OK int 0
const RES_INF_ERR_HEADER int -1
const RES_INF_ERR_TRUNC int -2
const RES_INF_ERR_BLOCK int -3
const RES_INF_ERR_CODES int -4
const RES_INF_ERR_SYMBOL int -5
const RES_INF_ERR_ADLER int -6
const RES_INF_ERR_NOMEM int -7
const RES_INF_ERR_ARG int -8

const RES_INF_MAX_OUT ulong 1073741824

global inf_out uchar *
global inf_out_len ulong 1
global inf_out_cap ulong 1
global inf_consumed ulong 1
note inf_st: [0]=in_off [1]=in_end [2]=in_pos [3]=bitbuf [4]=bitcnt
global inf_st ulong 5

global inf_lc_cnt int 16
global inf_lc_sym int 288
global inf_dc_cnt int 16
global inf_dc_sym int 32
global inf_fix_lc_cnt int 16
global inf_fix_lc_sym int 288
global inf_fix_dc_cnt int 16
global inf_fix_dc_sym int 32
global inf_fix_built uint 1
global inf_lengths int 320

fn inf_lbase idx ulong to ulong
  if eq idx 0
    ret 3
  end
  if eq idx 1
    ret 4
  end
  if eq idx 2
    ret 5
  end
  if eq idx 3
    ret 6
  end
  if eq idx 4
    ret 7
  end
  if eq idx 5
    ret 8
  end
  if eq idx 6
    ret 9
  end
  if eq idx 7
    ret 10
  end
  if eq idx 8
    ret 11
  end
  if eq idx 9
    ret 13
  end
  if eq idx 10
    ret 15
  end
  if eq idx 11
    ret 17
  end
  if eq idx 12
    ret 19
  end
  if eq idx 13
    ret 23
  end
  if eq idx 14
    ret 27
  end
  if eq idx 15
    ret 31
  end
  if eq idx 16
    ret 35
  end
  if eq idx 17
    ret 43
  end
  if eq idx 18
    ret 51
  end
  if eq idx 19
    ret 59
  end
  if eq idx 20
    ret 67
  end
  if eq idx 21
    ret 83
  end
  if eq idx 22
    ret 99
  end
  if eq idx 23
    ret 115
  end
  if eq idx 24
    ret 131
  end
  if eq idx 25
    ret 163
  end
  if eq idx 26
    ret 195
  end
  if eq idx 27
    ret 227
  end
  ret 258
end

fn inf_lext idx ulong to ulong
  if lt idx 8
    ret 0
  end
  if eq idx 28
    ret 0
  end
  ret div sub idx 4 4
end

fn inf_dbase idx ulong to ulong
  if eq idx 0
    ret 1
  end
  if eq idx 1
    ret 2
  end
  if eq idx 2
    ret 3
  end
  if eq idx 3
    ret 4
  end
  if eq idx 4
    ret 5
  end
  if eq idx 5
    ret 7
  end
  if eq idx 6
    ret 9
  end
  if eq idx 7
    ret 13
  end
  if eq idx 8
    ret 17
  end
  if eq idx 9
    ret 25
  end
  if eq idx 10
    ret 33
  end
  if eq idx 11
    ret 49
  end
  if eq idx 12
    ret 65
  end
  if eq idx 13
    ret 97
  end
  if eq idx 14
    ret 129
  end
  if eq idx 15
    ret 193
  end
  if eq idx 16
    ret 257
  end
  if eq idx 17
    ret 385
  end
  if eq idx 18
    ret 513
  end
  if eq idx 19
    ret 769
  end
  if eq idx 20
    ret 1025
  end
  if eq idx 21
    ret 1537
  end
  if eq idx 22
    ret 2049
  end
  if eq idx 23
    ret 3073
  end
  if eq idx 24
    ret 4097
  end
  if eq idx 25
    ret 6145
  end
  if eq idx 26
    ret 8193
  end
  if eq idx 27
    ret 12289
  end
  if eq idx 28
    ret 16385
  end
  ret 24577
end

fn inf_dext idx ulong to ulong
  if lt idx 4
    ret 0
  end
  ret div sub idx 2 2
end

fn inf_order idx ulong to ulong
  if eq idx 0
    ret 16
  end
  if eq idx 1
    ret 17
  end
  if eq idx 2
    ret 18
  end
  if eq idx 3
    ret 0
  end
  if eq idx 4
    ret 8
  end
  if eq idx 5
    ret 7
  end
  if eq idx 6
    ret 9
  end
  if eq idx 7
    ret 6
  end
  if eq idx 8
    ret 10
  end
  if eq idx 9
    ret 5
  end
  if eq idx 10
    ret 11
  end
  if eq idx 11
    ret 4
  end
  if eq idx 12
    ret 12
  end
  if eq idx 13
    ret 3
  end
  if eq idx 14
    ret 13
  end
  if eq idx 15
    ret 2
  end
  if eq idx 16
    ret 14
  end
  if eq idx 17
    ret 1
  end
  ret 15
end

fn inf_getbits in view uchar * need ulong val_out edit uint 1 to int
  if eq need 0
    put val_out 0 0
    ret RES_INF_OK
  end
  v = get inf_st 3
  bc = get inf_st 4
  pos = get inf_st 2
  iend = get inf_st 1
  while lt bc need bound 8
    if ge pos iend
      ret RES_INF_ERR_TRUNC
    end
    b = ulong get in pos
    v = or v shl b bc
    pos = add pos 1
    bc = add bc 8
  end
  mask = sub shl ulong 1 need 1
  put val_out 0 uint and v mask
  put inf_st 2 pos
  put inf_st 3 shr v need
  put inf_st 4 sub bc need
  ret RES_INF_OK
end

fn inf_put b uchar to int
  ol = get inf_out_len 0
  oc = get inf_out_cap 0
  if ge ol oc
    if ge oc RES_INF_MAX_OUT
      ret RES_INF_ERR_NOMEM
    end
    ncap = ulong 65536
    if gt oc 0
      ncap = mul oc 2
    end
    if gt ncap RES_INF_MAX_OUT
      ncap = RES_INF_MAX_OUT
    end
    e = enlarge inf_out ncap
    if lt e 0
      ret RES_INF_ERR_NOMEM
    end
    put inf_out_cap 0 ncap
  end
  put inf_out ol b
  put inf_out_len 0 add ol 1
  ret RES_INF_OK
end

fn inf_stored in view uchar * to int
  put inf_st 3 0
  put inf_st 4 0
  pos = get inf_st 2
  iend = get inf_st 1
  if lt sub iend pos 4
    ret RES_INF_ERR_TRUNC
  end
  blen = or ulong get in pos shl ulong get in add pos 1 8
  nlen = or ulong get in add pos 2 shl ulong get in add pos 3 8
  if ne blen and xor nlen 0xffff 0xffff
    ret RES_INF_ERR_BLOCK
  end
  pos = add pos 4
  if lt sub iend pos blen
    ret RES_INF_ERR_TRUNC
  end
  for i ulong blen bound 65536
    e = inf_put get in add pos i
    if ne e RES_INF_OK
      ret e
    end
  end
  put inf_st 2 add pos blen
  ret RES_INF_OK
end

fn inf_construct_lc off ulong n ulong to int
  offs = new int 16 0
  for l ulong 16 bound 16
    put inf_lc_cnt l 0
  end
  for sym ulong n bound 288
    lv = ulong get inf_lengths add off sym
    put inf_lc_cnt lv add get inf_lc_cnt lv 1
  end
  if eq get inf_lc_cnt 0 int n
    ret 0
  end
  left = int 1
  for l ulong 15 bound 15
    ll = add l 1
    left = sub shl left 1 get inf_lc_cnt ll
    if lt left 0
      ret left
    end
  end
  put offs 1 0
  for l ulong 14 bound 14
    ll = add l 1
    put offs add ll 1 add get offs ll get inf_lc_cnt ll
  end
  for sym ulong n bound 288
    lv = get inf_lengths add off sym
    if ne lv 0
      idx = get offs ulong lv
      put inf_lc_sym ulong idx int sym
      put offs ulong lv add idx 1
    end
  end
  ret left
end

fn inf_construct_dc off ulong n ulong to int
  offs = new int 16 0
  for l ulong 16 bound 16
    put inf_dc_cnt l 0
  end
  for sym ulong n bound 32
    lv = ulong get inf_lengths add off sym
    put inf_dc_cnt lv add get inf_dc_cnt lv 1
  end
  if eq get inf_dc_cnt 0 int n
    ret 0
  end
  left = int 1
  for l ulong 15 bound 15
    ll = add l 1
    left = sub shl left 1 get inf_dc_cnt ll
    if lt left 0
      ret left
    end
  end
  put offs 1 0
  for l ulong 14 bound 14
    ll = add l 1
    put offs add ll 1 add get offs ll get inf_dc_cnt ll
  end
  for sym ulong n bound 32
    lv = get inf_lengths add off sym
    if ne lv 0
      idx = get offs ulong lv
      put inf_dc_sym ulong idx int sym
      put offs ulong lv add idx 1
    end
  end
  ret left
end

fn inf_decode_lc in view uchar * use_fix bool sym_out edit int 1 to int
  code = int 0
  first = int 0
  index = int 0
  bv = new uint 1 0
  for l ulong 15 bound 15
    e = inf_getbits in 1 bv
    if ne e RES_INF_OK
      ret e
    end
    code = or code int get bv 0
    cnt = get inf_lc_cnt add l 1
    if use_fix
      cnt = get inf_fix_lc_cnt add l 1
    end
    if lt sub code cnt first
      si = ulong add index sub code first
      if use_fix
        put sym_out 0 get inf_fix_lc_sym si
      else
        put sym_out 0 get inf_lc_sym si
      end
      ret RES_INF_OK
    end
    index = add index cnt
    first = shl add first cnt 1
    code = shl code 1
  end
  ret RES_INF_ERR_CODES
end

fn inf_decode_dc in view uchar * use_fix bool sym_out edit int 1 to int
  code = int 0
  first = int 0
  index = int 0
  bv = new uint 1 0
  for l ulong 15 bound 15
    e = inf_getbits in 1 bv
    if ne e RES_INF_OK
      ret e
    end
    code = or code int get bv 0
    cnt = get inf_dc_cnt add l 1
    if use_fix
      cnt = get inf_fix_dc_cnt add l 1
    end
    if lt sub code cnt first
      si = ulong add index sub code first
      if use_fix
        put sym_out 0 get inf_fix_dc_sym si
      else
        put sym_out 0 get inf_dc_sym si
      end
      ret RES_INF_OK
    end
    index = add index cnt
    first = shl add first cnt 1
    code = shl code 1
  end
  ret RES_INF_ERR_CODES
end

fn inf_copy_match mlen ulong dist ulong to int
  if gt dist get inf_out_len 0
    ret RES_INF_ERR_SYMBOL
  end
  for i ulong mlen bound 260
    src = sub get inf_out_len 0 dist
    e = inf_put get inf_out src
    if ne e RES_INF_OK
      ret e
    end
  end
  ret RES_INF_OK
end

fn inf_codes in view uchar * use_fix bool to int
  sv = new int 1 0
  xv = new uint 1 0
  while true bound 500000000
    e = inf_decode_lc in use_fix sv
    if ne e RES_INF_OK
      ret e
    end
    sym = get sv 0
    if lt sym 256
      e = inf_put uchar and sym 0xff
      if ne e RES_INF_OK
        ret e
      end
      continue
    end
    if eq sym 256
      ret RES_INF_OK
    end
    sym = sub sym 257
    if or lt sym 0 ge sym 29
      ret RES_INF_ERR_SYMBOL
    end
    e = inf_getbits in inf_lext ulong sym xv
    if ne e RES_INF_OK
      ret e
    end
    mlen = add inf_lbase ulong sym ulong get xv 0
    e = inf_decode_dc in use_fix sv
    if ne e RES_INF_OK
      ret e
    end
    dsym = get sv 0
    if or lt dsym 0 ge dsym 30
      ret RES_INF_ERR_SYMBOL
    end
    e = inf_getbits in inf_dext ulong dsym xv
    if ne e RES_INF_OK
      ret e
    end
    dist = add inf_dbase ulong dsym ulong get xv 0
    e = inf_copy_match mlen dist
    if ne e RES_INF_OK
      ret e
    end
  end
  ret RES_INF_ERR_BLOCK
end

fn inf_build_fixed to void
  if ne get inf_fix_built 0 0
    ret
  end
  for sym ulong 288 bound 288
    if lt sym 144
      put inf_lengths sym 8
    else
      if lt sym 256
        put inf_lengths sym 9
      else
        if lt sym 280
          put inf_lengths sym 7
        else
          put inf_lengths sym 8
        end
      end
    end
  end
  _e1 = inf_construct_lc 0 288
  for i ulong 16 bound 16
    put inf_fix_lc_cnt i get inf_lc_cnt i
  end
  for i ulong 288 bound 288
    put inf_fix_lc_sym i get inf_lc_sym i
  end
  for sym ulong 30 bound 30
    put inf_lengths sym 5
  end
  _e2 = inf_construct_dc 0 30
  for i ulong 16 bound 16
    put inf_fix_dc_cnt i get inf_dc_cnt i
  end
  for i ulong 32 bound 32
    put inf_fix_dc_sym i get inf_dc_sym i
  end
  put inf_fix_built 0 1
end

fn inf_dynamic_read_lens in view uchar * total ulong to int
  idx = ulong 0
  sv = new int 1 0
  xv = new uint 1 0
  while lt idx total bound 400
    e = inf_decode_lc in false sv
    if ne e RES_INF_OK
      ret e
    end
    sym = get sv 0
    if lt sym 16
      put inf_lengths idx sym
      idx = add idx 1
      continue
    end
    lv = int 0
    rep = ulong 0
    if eq sym 16
      if eq idx 0
        ret RES_INF_ERR_CODES
      end
      lv = get inf_lengths sub idx 1
      e = inf_getbits in 2 xv
      if ne e RES_INF_OK
        ret e
      end
      rep = add 3 ulong get xv 0
    else
      if eq sym 17
        e = inf_getbits in 3 xv
        if ne e RES_INF_OK
          ret e
        end
        rep = add 3 ulong get xv 0
      else
        e = inf_getbits in 7 xv
        if ne e RES_INF_OK
          ret e
        end
        rep = add 11 ulong get xv 0
      end
    end
    if gt add idx rep total
      ret RES_INF_ERR_CODES
    end
    for r ulong rep bound 140
      put inf_lengths idx lv
      idx = add idx 1
    end
  end
  ret RES_INF_OK
end

fn inf_dynamic in view uchar * to int
  xv = new uint 1 0
  e = inf_getbits in 5 xv
  if ne e RES_INF_OK
    ret e
  end
  nlen = add ulong get xv 0 257
  e = inf_getbits in 5 xv
  if ne e RES_INF_OK
    ret e
  end
  ndist = add ulong get xv 0 1
  e = inf_getbits in 4 xv
  if ne e RES_INF_OK
    ret e
  end
  ncode = add ulong get xv 0 4
  if or gt nlen 286 gt ndist 30
    ret RES_INF_ERR_CODES
  end
  for i ulong 19 bound 19
    put inf_lengths i 0
  end
  for i ulong ncode bound 19
    e = inf_getbits in 3 xv
    if ne e RES_INF_OK
      ret e
    end
    put inf_lengths inf_order i int get xv 0
  end
  if ne inf_construct_lc 0 19 0
    ret RES_INF_ERR_CODES
  end
  e = inf_dynamic_read_lens in add nlen ndist
  if ne e RES_INF_OK
    ret e
  end
  if eq get inf_lengths 256 0
    ret RES_INF_ERR_CODES
  end
  e = inf_construct_lc 0 nlen
  if ne e 0
    if or lt e 0 ne int nlen add get inf_lc_cnt 0 get inf_lc_cnt 1
      ret RES_INF_ERR_CODES
    end
  end
  e = inf_construct_dc nlen ndist
  if ne e 0
    if or lt e 0 ne int ndist add get inf_dc_cnt 0 get inf_dc_cnt 1
      ret RES_INF_ERR_CODES
    end
  end
  ret inf_codes in false
end

fn res_adler32 p view uchar * off ulong n ulong to uint
  a = uint 1
  b = uint 0
  pos = off
  remn = n
  while gt remn 0 bound 500000
    k = remn
    if gt k 5552
      k = 5552
    end
    remn = sub remn k
    for i ulong k bound 5552
      a = add a uint get p pos
      b = add b a
      pos = add pos 1
    end
    a = rem a 65521
    b = rem b 65521
  end
  ret or shl b 16 a
end

fn res_adler32_inf_out n ulong to uint
  a = uint 1
  b = uint 0
  pos = ulong 0
  remn = n
  while gt remn 0 bound 500000
    k = remn
    if gt k 5552
      k = 5552
    end
    remn = sub remn k
    for i ulong k bound 5552
      a = add a uint get inf_out pos
      b = add b a
      pos = add pos 1
    end
    a = rem a 65521
    b = rem b 65521
  end
  ret or shl b 16 a
end

fn inf_check_adler in view uchar * in_off ulong to int
  pos = get inf_st 2
  iend = get inf_st 1
  if lt sub iend pos 4
    ret RES_INF_ERR_TRUNC
  end
  want = shl uint get in pos 24
  want = or want shl uint get in add pos 1 16
  want = or want shl uint get in add pos 2 8
  want = or want uint get in add pos 3
  got = res_adler32_inf_out get inf_out_len 0
  if ne got want
    ret RES_INF_ERR_ADLER
  end
  put inf_consumed 0 sub add pos 4 in_off
  ret RES_INF_OK
end

fn res_zlib_inflate in view uchar * in_off ulong in_len ulong to int
  put inf_out_len 0 0
  put inf_consumed 0 0
  if lt in_len 2
    ret RES_INF_ERR_TRUNC
  end
  if gt add in_off in_len len in
    ret RES_INF_ERR_ARG
  end
  cmf = uint get in in_off
  flg = uint get in add in_off 1
  if or ne and cmf 0x0f 8 gt shr cmf 4 7
    ret RES_INF_ERR_HEADER
  end
  if ne rem or shl cmf 8 flg 31 0
    ret RES_INF_ERR_HEADER
  end
  if ne and flg 0x20 0
    ret RES_INF_ERR_HEADER
  end
  put inf_st 0 in_off
  put inf_st 1 add in_off in_len
  put inf_st 2 add in_off 2
  put inf_st 3 0
  put inf_st 4 0
  last = uint 0
  btype = new uint 1 0
  lv = new uint 1 0
  while eq last 0 bound 1000000
    e = inf_getbits in 1 lv
    if ne e RES_INF_OK
      ret e
    end
    last = get lv 0
    e = inf_getbits in 2 btype
    if ne e RES_INF_OK
      ret e
    end
    bt = get btype 0
    if eq bt 0
      e = inf_stored in
    else
      if eq bt 1
        inf_build_fixed
        e = inf_codes in true
      else
        if eq bt 2
          e = inf_dynamic in
        else
          e = RES_INF_ERR_BLOCK
        end
      end
    end
    if ne e RES_INF_OK
      ret e
    end
  end
  put inf_st 3 0
  put inf_st 4 0
  ret inf_check_adler in in_off
end

const RB_NSEED_MAX ulong 16
const RB_NM ulong 3
const RB_NPW ulong 100
const RB_N_TRAIN ulong 2000
const RB_N_TEST ulong 1000
const RB_WASHOUT ulong 100
const RB_NDELAY ulong 12

const RB_LZ_DISCARD ulong 200000
const RB_LZ_POINTS ulong 200001
const RB_LZ_SAMPLE ulong 100
const RB_LZ_NS ulong 2001
const RB_LZ_ROW0 ulong 200
const RB_LZ_ROW1 ulong 1975
const RB_LZ_NROW ulong 1776
const RB_LZ_LAGS ulong 5

const RB_PERF_WARM ulong 10000
const RB_PERF_STEPS ulong 40000
const RB_PERF_REPS ulong 5

note Benchmark global storage (up to 16 seeds)
note Per-run record: 332 uints = [0]=st, [1..2]=stopped(lo,hi), [3..132]=rc(130), [133..332]=ms(200) -> stride 336
const RB_RUN_STRIDE ulong 336
note Per-fit record: 10 ulongs = [0]=st, [1]=nf, [2]=lam, [3]=cv, [4..6]=test[0..2], [7..9]=train[0..2]
const RB_FIT_STRIDE ulong 10

global rb_n_runs uint 43008
global rb_n_fits ulong 2880
global rb_n_masks uint 1024
global rb_n_nd uint 32
global rb_n_nodes uint 64
global rb_u0 f64 2000
global rb_u1 f64 1000
global rb_ny f64 12000
global rb_nxr0 f64 *
global rb_nxr1 f64 *
global rb_nxb0 f64 *
global rb_nxb1 f64 *
global rb_cur_drv uint 64
global rb_cur_mask uint 192

global rb_l_runs uint 21504
global rb_l_fits ulong 2880
global rb_l_ic f64 96
global rb_l_nodes uint 32
global rb_lx0 f64 *
global rb_lx1 f64 *
global rb_lxl0 f64 *
global rb_lxl1 f64 *
global rb_lxs0 f64 *
global rb_lxs1 f64 *
global rb_lxb0 f64 *
global rb_lxb1 f64 *
global rb_ly f64 *

global rb_lat ulong 200000


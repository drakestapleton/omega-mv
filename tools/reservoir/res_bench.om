note ================================================================
note Common benchmark helpers
note ================================================================

fn rb_stream seed int purpose ulong dst edit ulong 1 to void
  put dst 0 or shl ulong bitcast uint seed 32 purpose
end

fn rb_grid_init g edit f64 9 to void
  put g 0 1.0e-6f64
  put g 1 1.0e-5f64
  put g 2 1.0e-4f64
  put g 3 1.0e-3f64
  put g 4 1.0e-2f64
  put g 5 1.0e-1f64
  put g 6 1.0f64
  put g 7 10.0f64
  put g 8 100.0f64
end

fn rb_store_run dst_which uint slot ulong st int rc view uint 130 ms view uint 200 to void
  base = mul slot RB_RUN_STRIDE
  stp = rc_sim_get_step
  if eq dst_which 0
    put rb_n_runs base bitcast uint st
    put rb_n_runs add base 1 uint and stp 0xffffffff
    put rb_n_runs add base 2 uint shr stp 32
    for i ulong 130 bound 130
      put rb_n_runs add add base 3 i get rc i
    end
    for i ulong 200 bound 200
      put rb_n_runs add add base 133 i get ms i
    end
  else
    put rb_l_runs base bitcast uint st
    put rb_l_runs add base 1 uint and stp 0xffffffff
    put rb_l_runs add base 2 uint shr stp 32
    for i ulong 130 bound 130
      put rb_l_runs add add base 3 i get rc i
    end
    for i ulong 200 bound 200
      put rb_l_runs add add base 133 i get ms i
    end
  end
end

fn rb_run_get which uint idx ulong to uint
  if eq which 0
    ret get rb_n_runs idx
  end
  ret get rb_l_runs idx
end

fn rb_run_json_ok which uint base ulong to void
  rid = new uint 32 0
  cid = new uint 32 0
  for i ulong 32 bound 32
    put rid i rb_run_get which add add base 101 i
    put cid i rb_run_get which add add base 3 i
  end
  rc_puts rb_s_run2
  rc_jhex_u32 view rid
  rc_puts rb_s_run3
  rc_jhex_u32 view cid
  rc_puts rb_s_run4
  slo = ulong rb_run_get which add base 99
  shi = ulong rb_run_get which add base 100
  rc_put_u64 or shl shi 32 slo
end

fn rb_run_json_ms which uint base ulong to void
  ms = new uint 200 0
  for i ulong 200 bound 200
    put ms i rb_run_get which add add base 133 i
  end
  rc_mstats_json view ms
end

fn rb_run_json which uint slot ulong name view uchar * to void
  base = mul slot RB_RUN_STRIDE
  st = bitcast int rb_run_get which base
  rc_puts rb_s_run0
  rc_puts name
  rc_puts rb_s_run1
  rc_status_puts st
  if eq st RES_OK
    rb_run_json_ok which base
  else
    rc_puts rb_s_run5
    slo = ulong rb_run_get which add base 1
    shi = ulong rb_run_get which add base 2
    rc_put_u64 or shl shi 32 slo
  end
  rb_run_json_ms which base
  rc_putc uchar 125
end

fn rb_fit_refused which uint slot ulong st int nf ulong to void
  base = mul slot RB_FIT_STRIDE
  nanb = ulong 0x7ff8000000000000
  if eq which 0
    put rb_n_fits base ulong bitcast uint st
    put rb_n_fits add base 1 nf
    for i ulong 8 bound 8
      put rb_n_fits add add base 2 i nanb
    end
  else
    put rb_l_fits base ulong bitcast uint st
    put rb_l_fits add base 1 nf
    for i ulong 8 bound 8
      put rb_l_fits add add base 2 i nanb
    end
  end
end

fn rb_fit_put which uint idx ulong val ulong to void
  if eq which 0
    put rb_n_fits idx val
  else
    put rb_l_fits idx val
  end
end

fn rb_fit_store which uint slot ulong cvm view ulong 5 cv_res view ulong 3 to void
  base = mul slot RB_FIT_STRIDE
  st = bitcast int uint get cv_res 0
  nanb = ulong 0x7ff8000000000000
  rb_fit_put which base get cv_res 0
  rb_fit_put which add base 1 get cvm 2
  rb_fit_put which add base 2 get cv_res 1
  rb_fit_put which add base 3 get cv_res 2
  no = get cvm 3
  for c ulong no bound 3
    if eq st RES_OK
      vte = bitcast ulong rc_nrmse_y_p 1 get cvm 1 no c
      vtr = bitcast ulong rc_nrmse_y_p 0 get cvm 0 no c
      rb_fit_put which add add base 4 c vte
      rb_fit_put which add add base 7 c vtr
    else
      rb_fit_put which add add base 4 c nanb
      rb_fit_put which add add base 7 c nanb
    end
  end
end

fn rb_fit_run which uint slot ulong ntr ulong nte ulong nf ulong no ulong to void
  grid = new f64 9 0.0f64
  rb_grid_init grid
  cvm = new ulong 5 0
  put cvm 0 ntr
  put cvm 1 nte
  put cvm 2 nf
  put cvm 3 no
  put cvm 4 5
  cv_res = new ulong 3 0
  rc_ridge_cv view cvm view grid cv_res
  rb_fit_store which slot view cvm view cv_res
end

fn rb_fit_json_body which uint slot ulong no ulong to void
  base = mul slot RB_FIT_STRIDE
  f = new ulong 10 0
  for i ulong 10 bound 10
    if eq which 0
      put f i get rb_n_fits add base i
    else
      put f i get rb_l_fits add base i
    end
  end
  rc_puts rb_s_fit2
  rc_put_u64 get f 1
  rc_puts rb_s_fit3
  rc_status_puts bitcast int uint get f 0
  rc_puts rb_s_fit4
  rc_put_f64 bitcast f64 get f 2 10
  rc_puts rb_s_fit5
  rc_put_f64 bitcast f64 get f 3 10
  rc_puts rb_s_fit6
  for c ulong no bound 3
    if gt c 0
      rc_puts rb_s_comma
    end
    rc_put_f64 bitcast f64 get f add 4 c 10
  end
  rc_puts rb_s_fit7
  for c ulong no bound 3
    if gt c 0
      rc_puts rb_s_comma
    end
    rc_put_f64 bitcast f64 get f add 7 c 10
  end
  rc_puts rb_s_fit8
end

fn rb_stat_json vals view f64 16 n ulong to void
  cnt = ulong 0
  sum = 0.0f64
  mn = bitcast f64 ulong 0x7ff0000000000000
  mx = bitcast f64 ulong 0xfff0000000000000
  for i ulong n bound 16
    v = get vals i
    if eq v v
      sum = add sum v
      if lt v mn
        mn = v
      end
      if gt v mx
        mx = v
      end
      cnt = add cnt 1
    end
  end
  nanv = bitcast f64 ulong 0x7ff8000000000000
  mean = nanv
  sd = nanv
  if gt cnt 0
    mean = div sum f64 cnt
    if gt cnt 1
      q = 0.0f64
      for i ulong n bound 16
        v = get vals i
        if eq v v
          d = sub v mean
          q = add q mul d d
        end
      end
      sd = fsqrt div q f64 sub cnt 1
    end
  else
    mn = nanv
    mx = nanv
  end
  rc_puts rb_s_st0
  rc_put_u64 cnt
  rc_puts rb_s_st1
  rc_put_f64 mean 10
  rc_puts rb_s_st2
  rc_put_f64 sd 10
  rc_puts rb_s_st3
  rc_put_f64 mn 10
  rc_puts rb_s_st4
  rc_put_f64 mx 10
  rc_putc uchar 125
end

fn rb_paired_json name view uchar * a view f64 16 b view f64 16 n ulong to void
  d = new f64 16 0.0f64
  wins = ulong 0
  both = ulong 0
  for i ulong n bound 16
    di = sub get a i get b i
    put d i di
    if eq di di
      both = add both 1
      if lt get a i get b i
        wins = add wins 1
      end
    end
  end
  rc_puts rb_s_pr0
  rc_puts name
  rc_puts rb_s_pr1
  rb_stat_json view d n
  rc_puts rb_s_pr2
  rc_put_u64 wins
  rc_puts rb_s_pr3
  rc_put_u64 both
  rc_putc uchar 125
end

note ================================================================
note bench-narma
note ================================================================

fn rb_narma_fill_knot base ulong sb ulong on f32 off f32 nd ulong to void
  for d ulong nd bound 64
    dv = ulong get rb_cur_drv d
    mv = get rb_cur_mask add mul d RB_NM sb
    if ne mv 0
      put rc_tab add base dv on
    else
      put rc_tab add base dv off
    end
  end
end

fn rb_narma_fill_one_k sp ulong n ulong nd ulong nc ulong k ulong to void
  j = div k 10
  if ge j mul n RB_NM
    j = sub mul n RB_NM 1
  end
  c = div j RB_NM
  uc = 0.0f64
  if eq sp 0
    uc = get rb_u0 c
  else
    uc = get rb_u1 c
  end
  on = mul mul 2.0f64 uc 1.0e-10f64
  rb_narma_fill_knot mul k nc rem j RB_NM f32 on f32 sub 1.0e-10f64 on nd
end

fn rb_narma_fill_tab sp ulong n ulong nd ulong nc ulong to ulong
  kn = add mul mul n RB_NM 10 1
  _e = enlarge rc_tab mul kn nc
  for i ulong mul kn nc bound 4000000
    put rc_tab i 0.0f32
  end
  for k ulong kn bound 70000
    rb_narma_fill_one_k sp n nd nc k
  end
  ret kn
end

fn rb_narma_extract_d sp ulong cm1 ulong rbase ulong nc ulong d ulong to void
  dv = ulong get rb_cur_drv d
  for k ulong RB_NM bound 3
    vidx = add mul add mul cm1 RB_NM k nc dv
    val = get rc_vout vidx
    dst = add rbase add mul d RB_NM k
    if eq sp 0
      put rb_nxr0 dst val
    else
      put rb_nxr1 dst val
    end
  end
end

fn rb_narma_extract_row sp ulong r ulong rbase ulong nc ulong nd ulong to void
  cm1 = sub add RB_WASHOUT r 1
  for d ulong nd bound 64
    rb_narma_extract_d sp cm1 rbase nc d
  end
  if eq sp 0
    put rb_nxr0 add rbase mul nd RB_NM get rb_u0 cm1
  else
    put rb_nxr1 add rbase mul nd RB_NM get rb_u1 cm1
  end
end

fn rb_narma_extract_xr sp ulong nr ulong nfr ulong nc ulong nd ulong to void
  if eq sp 0
    _e = enlarge rb_nxr0 mul nr nfr
  else
    _e = enlarge rb_nxr1 mul nr nfr
  end
  for r ulong nr bound 2000
    rb_narma_extract_row sp r mul r nfr nc nd
  end
end

fn rb_narma_prep_sim sp ulong nd ulong nc ulong smeta edit uint 4 to void
  n = RB_N_TRAIN
  if eq sp 1
    n = RB_N_TEST
  end
  nsteps = mul n RB_NM
  _e = enlarge rc_steps nsteps
  for j ulong nsteps bound 6000
    put rc_steps j mul add j 1 RB_NPW
  end
  _e = enlarge rc_vout mul nsteps nc
  kn = rb_narma_fill_tab sp n nd nc
  put smeta 0 RES_INIT_N0
  put smeta 1 0
  put smeta 2 uint kn
  put smeta 3 uint nsteps
end

note sinfo: [0]=si [1]=net [2]=m [3]=sp [4]=nd
fn rb_narma_sim_one sinfo view ulong 5 t view uint 514 p view uint 265 to int
  smeta = new uint 4 0
  rb_narma_prep_sim get sinfo 3 get sinfo 4 ulong get t 0 smeta
  rc = new uint 130 0
  ms = new uint 200 0
  st = rc_simulate_run t p view smeta rc ms
  slot = add mul get sinfo 0 8 mul get sinfo 1 4
  slot = add slot add mul get sinfo 2 2 get sinfo 3
  rb_store_run 0 slot st view rc view ms
  if eq st RES_OK
    nr = sub RB_N_TRAIN RB_WASHOUT
    if eq get sinfo 3 1
      nr = sub RB_N_TEST RB_WASHOUT
    end
    rb_narma_extract_xr get sinfo 3 nr add mul get sinfo 4 RB_NM 1 ulong get t 0 get sinfo 4
  end
  ret st
end

fn rb_narma_load_y ord_i ulong to void
  ntr = sub RB_N_TRAIN RB_WASHOUT
  nte = sub RB_N_TEST RB_WASHOUT
  _e = enlarge rc_ytr ntr
  _e = enlarge rc_yte nte
  b0 = add mul ord_i 4000 RB_WASHOUT
  b1 = add add mul ord_i 4000 2000 RB_WASHOUT
  for r ulong ntr bound 2000
    put rc_ytr r get rb_ny add b0 r
  end
  for r ulong nte bound 1000
    put rc_yte r get rb_ny add b1 r
  end
end

fn rb_narma_fit_ok fbase ulong nfr ulong to void
  ntr = sub RB_N_TRAIN RB_WASHOUT
  nte = sub RB_N_TEST RB_WASHOUT
  _e = enlarge rc_xtr mul ntr nfr
  _e = enlarge rc_xte mul nte nfr
  for i ulong mul ntr nfr bound 400000
    put rc_xtr i get rb_nxr0 i
  end
  for i ulong mul nte nfr bound 200000
    put rc_xte i get rb_nxr1 i
  end
  for o ulong 3 bound 3
    rb_narma_load_y o
    rb_fit_run 0 add fbase o ntr nte nfr 1
  end
end

fn rb_narma_fit_net si ulong net ulong m ulong nfr ulong st0 int st1 int to void
  mid = m
  if eq net 1
    mid = add 4 m
  end
  fbase = add mul si 18 mul mid 3
  if or ne st0 RES_OK ne st1 RES_OK
    es = st0
    if eq es RES_OK
      es = st1
    end
    for o ulong 3 bound 3
      rb_fit_refused 0 add fbase o es nfr
    end
    ret
  end
  rb_narma_fit_ok fbase nfr
end

fn rb_narma_disc_fail si ulong net ulong nd ulong dst int to void
  rc = new uint 130 0
  ms = new uint 200 0
  rb_store_run 0 add mul si 8 add mul net 4 2 dst view rc view ms
  rb_store_run 0 add mul si 8 add mul net 4 3 dst view rc view ms
  rb_narma_fit_net si net 1 add mul nd RB_NM 1 dst dst
end

fn rb_narma_run_disc si ulong net ulong conc view f32 64 nd ulong to void
  td = new uint 514 0
  pd = new uint 265 0
  for d ulong nd bound 64
    put rb_cur_drv d uint d
  end
  dst = rc_net_disconnected RES_REF_NARMA conc uint nd td pd
  if ne dst RES_OK
    put rb_n_nodes add mul si 4 add mul net 2 1 0
    rb_narma_disc_fail si net nd dst
    ret
  end
  put rb_n_nodes add mul si 4 add mul net 2 1 get td 0
  sinfo = new ulong 5 0
  put sinfo 0 si
  put sinfo 1 net
  put sinfo 2 1
  put sinfo 3 0
  put sinfo 4 nd
  st0 = rb_narma_sim_one view sinfo view td view pd
  put sinfo 3 1
  st1 = rb_narma_sim_one view sinfo view td view pd
  rb_narma_fit_net si net 1 add mul nd RB_NM 1 st0 st1
end

fn rb_narma_run_net si ulong net ulong to void
  tc = new uint 514 0
  pc = new uint 265 0
  inp = new uint 3 0
  gr = new uint 1 4
  if eq net 0
    _st = rc_net_topology RC_NET_CHAIN50 tc inp gr
  else
    _st = res_topology_chain 5 4 tc
  end
  _st = res_params_reference RES_REF_NARMA get tc 0 pc
  conc = new f32 64 0.0f32
  nd = ulong 0
  for i ulong ulong get tc 0 bound 64
    if ne uint i get gr 0
      put rb_cur_drv nd uint i
      put conc nd bitcast f32 get pc add RES_PAR_CONC i
      nd = add nd 1
    end
  end
  put rb_n_nd add mul si 2 net uint nd
  put rb_n_nodes add mul si 4 mul net 2 get tc 0
  sinfo = new ulong 5 0
  put sinfo 0 si
  put sinfo 1 net
  put sinfo 2 0
  put sinfo 3 0
  put sinfo 4 nd
  st0 = rb_narma_sim_one view sinfo view tc view pc
  put sinfo 3 1
  st1 = rb_narma_sim_one view sinfo view tc view pc
  rb_narma_fit_net si net 0 add mul nd RB_NM 1 st0 st1
  rb_narma_run_disc si net view conc nd
end

fn rb_narma_quad_p0 rb ulong ob ulong i ulong k_in ulong to ulong
  k = k_in
  ai = get rb_nxb0 add rb i
  for j ulong sub RB_NDELAY i bound 12
    aj = get rb_nxb0 add rb add i j
    put rc_xtr add ob k mul ai aj
    k = add k 1
  end
  ret k
end

fn rb_narma_quad_p1 rb ulong ob ulong i ulong k_in ulong to ulong
  k = k_in
  ai = get rb_nxb1 add rb i
  for j ulong sub RB_NDELAY i bound 12
    aj = get rb_nxb1 add rb add i j
    put rc_xte add ob k mul ai aj
    k = add k 1
  end
  ret k
end

fn rb_narma_quad_row which uint r ulong nfq ulong to void
  rb = mul r RB_NDELAY
  ob = mul r nfq
  k = ulong 0
  for i ulong RB_NDELAY bound 12
    if eq which 0
      put rc_xtr add ob k get rb_nxb0 add rb i
    else
      put rc_xte add ob k get rb_nxb1 add rb i
    end
    k = add k 1
  end
  for i ulong RB_NDELAY bound 12
    if eq which 0
      k = rb_narma_quad_p0 rb ob i k
    else
      k = rb_narma_quad_p1 rb ob i k
    end
  end
end

fn rb_narma_fill_delay which uint nr ulong to void
  for r ulong nr bound 2000
    base = mul r RB_NDELAY
    c0 = sub add RB_WASHOUT r 1
    for i ulong RB_NDELAY bound 12
      if eq which 0
        put rc_xtr add base i get rb_u0 sub c0 i
      else
        put rc_xte add base i get rb_u1 sub c0 i
      end
    end
  end
end

fn rb_narma_baselines si ulong to void
  ntr = sub RB_N_TRAIN RB_WASHOUT
  nte = sub RB_N_TEST RB_WASHOUT
  nfq = add RB_NDELAY div mul RB_NDELAY add RB_NDELAY 1 2
  _e = enlarge rc_xtr mul ntr RB_NDELAY
  _e = enlarge rc_xte mul nte RB_NDELAY
  rb_narma_fill_delay 0 ntr
  rb_narma_fill_delay 1 nte
  for o ulong 3 bound 3
    rb_narma_load_y o
    rb_fit_run 0 add mul si 18 add 6 o ntr nte RB_NDELAY 1
  end
  _e = enlarge rb_nxb0 mul ntr RB_NDELAY
  _e = enlarge rb_nxb1 mul nte RB_NDELAY
  for i ulong mul ntr RB_NDELAY bound 30000
    put rb_nxb0 i get rc_xtr i
  end
  for i ulong mul nte RB_NDELAY bound 15000
    put rb_nxb1 i get rc_xte i
  end
  _e = enlarge rc_xtr mul ntr nfq
  _e = enlarge rc_xte mul nte nfq
  for r ulong ntr bound 2000
    rb_narma_quad_row 0 r nfq
  end
  for r ulong nte bound 1000
    rb_narma_quad_row 1 r nfq
  end
  for o ulong 3 bound 3
    rb_narma_load_y o
    rb_fit_run 0 add mul si 18 add 9 o ntr nte nfq 1
  end
end

fn rb_narma_gen_targets to void
  u0 = new f64 2000 0.0f64
  u1 = new f64 1000 0.0f64
  for i ulong 2000 bound 2000
    put u0 i get rb_u0 i
  end
  for i ulong 1000 bound 1000
    put u1 i get rb_u1 i
  end
  ords = new uint 3 0
  put ords 0 2
  put ords 1 5
  put ords 2 10
  y0 = new f64 2000 0.0f64
  y1 = new f64 1000 0.0f64
  for o ulong 3 bound 3
    rc_narma_g view u0 2000 get ords o y0
    rc_narma_g view u1 1000 get ords o y1
    b0 = mul o 4000
    b1 = add b0 2000
    for i ulong 2000 bound 2000
      put rb_ny add b0 i get y0 i
    end
    for i ulong 1000 bound 1000
      put rb_ny add b1 i get y1 i
    end
  end
end

fn rb_narma_init_mask si ulong seed int to void
  rm = new ulong 1 0
  rb_stream seed 3 rm
  db = new uint 4 0
  put db 2 1
  put db 3 1
  for d ulong 64 bound 64
    ms = rem rc_rng_next rm 4
    put rb_n_masks add mul si 64 d uint ms
    for k ulong RB_NM bound 3
      v = get db rem add ms k 4
      put rb_cur_mask add mul d RB_NM k v
    end
  end
end

fn rb_narma_seed si ulong seed int to void
  r0 = new ulong 1 0
  r1 = new ulong 1 0
  rb_stream seed 1 r0
  rb_stream seed 2 r1
  for i ulong RB_N_TRAIN bound 2000
    put rb_u0 i mul 0.5f64 rc_rng_unit r0
  end
  for i ulong RB_N_TEST bound 1000
    put rb_u1 i mul 0.5f64 rc_rng_unit r1
  end
  rb_narma_init_mask si seed
  rb_narma_gen_targets
  rb_narma_run_net si 0
  rb_narma_run_net si 1
  rb_narma_baselines si
end

fn rb_narma_model_name m ulong to void
  if eq m 0
    rc_puts rb_nm0
    ret
  end
  if eq m 1
    rc_puts rb_nm1
    ret
  end
  if eq m 2
    rc_puts rb_nm2
    ret
  end
  if eq m 3
    rc_puts rb_nm3
    ret
  end
  if eq m 4
    rc_puts rb_nm4
    ret
  end
  rc_puts rb_nm5
end

fn rb_narma_fit_emit si ulong m ulong t ulong to void
  slot = add mul si 18 add mul m 3 t
  rc_puts rb_s_fit0
  rb_narma_model_name m
  rc_puts rb_s_fit1
  if eq t 0
    rc_puts rb_nt0
  else
    if eq t 1
      rc_puts rb_nt1
    else
      rc_puts rb_nt2
    end
  end
  rb_fit_json_body 0 slot 1
end

fn rb_narma_emit_seed si ulong seed int to void
  if gt si 0
    rc_putc uchar 44
  end
  rc_puts rb_bn_sd0
  rc_put_i64 long seed
  rc_puts rb_bn_sd1
  b = mul si 8
  rb_run_json 0 b rb_nr0
  rc_puts rb_s_comma
  rb_run_json 0 add b 1 rb_nr1
  rc_puts rb_s_comma
  rb_run_json 0 add b 2 rb_nr2
  rc_puts rb_s_comma
  rb_run_json 0 add b 3 rb_nr3
  rc_puts rb_s_comma
  rb_run_json 0 add b 4 rb_nr4
  rc_puts rb_s_comma
  rb_run_json 0 add b 5 rb_nr5
  rc_puts rb_s_comma
  rb_run_json 0 add b 6 rb_nr6
  rc_puts rb_s_comma
  rb_run_json 0 add b 7 rb_nr7
  rc_puts rb_bn_sd2
  nd0 = ulong get rb_n_nd mul si 2
  for d ulong nd0 bound 64
    if gt d 0
      rc_puts rb_s_comma
    end
    rc_put_u64 ulong get rb_n_masks add mul si 64 d
  end
  rc_puts rb_bn_sd3
  for m ulong 6 bound 6
    for t ulong 3 bound 3
      if or gt m 0 gt t 0
        rc_puts rb_bn_sd4
      end
      rb_narma_fit_emit si m t
    end
  end
  rc_putc uchar 93
  rc_putc uchar 125
end

fn rb_narma_fill_best_bl ns ulong t ulong bst edit f64 16 to void
  for i ulong ns bound 16
    sa = mul add mul i 18 add 6 t RB_FIT_STRIDE
    sb = mul add mul i 18 add 9 t RB_FIT_STRIDE
    sta = bitcast int uint get rb_n_fits sa
    stb = bitcast int uint get rb_n_fits sb
    cva = bitcast f64 get rb_n_fits add sa 3
    cvb = bitcast f64 get rb_n_fits add sb 3
    use_b = false
    if eq stb RES_OK
      if or ne sta RES_OK lt cvb cva
        use_b = true
      end
    end
    if use_b
      put bst i bitcast f64 get rb_n_fits add sb 4
    else
      put bst i bitcast f64 get rb_n_fits add sa 4
    end
  end
end

fn rb_narma_collect_m ns ulong m ulong t ulong dst edit f64 16 to void
  for i ulong ns bound 16
    slot = add mul i 18 add mul m 3 t
    put dst i bitcast f64 get rb_n_fits add mul slot RB_FIT_STRIDE 4
  end
end

fn rb_narma_emit_summary ns ulong t ulong to void
  if gt t 0
    rc_putc uchar 44
  end
  rc_puts rb_bn_sum1
  if eq t 0
    rc_puts rb_nt0
  else
    if eq t 1
      rc_puts rb_nt1
    else
      rc_puts rb_nt2
    end
  end
  rc_puts rb_bn_sum2
  v0 = new f64 16 0.0f64
  v1 = new f64 16 0.0f64
  v4 = new f64 16 0.0f64
  v5 = new f64 16 0.0f64
  bst = new f64 16 0.0f64
  vm = new f64 16 0.0f64
  for m ulong 6 bound 6
    rb_narma_collect_m ns m t vm
    if gt m 0
      rc_puts rb_s_comma
    end
    rc_putc uchar 34
    rb_narma_model_name m
    rc_putc uchar 34
    rc_putc uchar 58
    rc_putc uchar 32
    rb_stat_json view vm ns
  end
  rb_narma_collect_m ns 0 t v0
  rb_narma_collect_m ns 1 t v1
  rb_narma_collect_m ns 4 t v4
  rb_narma_collect_m ns 5 t v5
  rb_narma_fill_best_bl ns t bst
  rc_puts rb_bn_sum3
  rb_paired_json rb_bp0 view v0 view v1 ns
  rc_puts rb_s_comma
  rb_paired_json rb_bp1 view v0 view bst ns
  rc_puts rb_s_comma
  rb_paired_json rb_bp2 view v4 view v5 ns
  rc_puts rb_s_comma
  rb_paired_json rb_bp3 view v4 view bst ns
  rc_putc uchar 93
  rc_putc uchar 125
end

fn rb_bench_narma seeds view int 16 ns ulong to int
  t0 = rc_now_s
  for i ulong ns bound 16
    rb_narma_seed i get seeds i
  end
  wall = sub rc_now_s t0
  rc_puts rb_bn_hdr
  rc_putc uchar 91
  for i ulong ns bound 16
    if gt i 0
      rc_puts rb_s_comma
    end
    rc_put_i64 long get seeds i
  end
  rc_putc uchar 93
  rc_puts rb_bn_s0
  rc_put_u64 ulong get rb_n_nd 0
  rc_puts rb_bn_s1
  rc_put_u64 ulong get rb_n_nodes 0
  rc_puts rb_bn_s2
  rc_put_u64 ulong get rb_n_nodes 1
  rc_puts rb_bn_s3
  rc_put_u64 ulong get rb_n_nd 1
  rc_puts rb_bn_s1
  rc_put_u64 ulong get rb_n_nodes 2
  rc_puts rb_bn_s2
  rc_put_u64 ulong get rb_n_nodes 3
  rc_puts rb_bn_s4
  rc_put_f64_1 wall
  rc_puts rb_bn_s5
  for i ulong ns bound 16
    rb_narma_emit_seed i get seeds i
  end
  rc_puts rb_bn_sum0
  for t ulong 3 bound 3
    rb_narma_emit_summary ns t
  end
  rc_puts rb_bn_end
  rc_flush
  ret 0
end

note ================================================================
note bench-lorenz & perf
note ================================================================

fn rb_lz_deriv s view f64 3 d edit f64 3 to void
  s0 = get s 0
  s1 = get s 1
  s2 = get s 2
  put d 0 mul 10.0f64 sub s1 s0
  put d 1 sub mul s0 sub 28.0f64 s2 s1
  put d 2 sub mul s0 s1 mul div 8.0f64 3.0f64 s2
end

fn rb_lz_rk4 s edit f64 3 to void
  k1 = new f64 3 0.0f64
  k2 = new f64 3 0.0f64
  k3 = new f64 3 0.0f64
  k4 = new f64 3 0.0f64
  t = new f64 3 0.0f64
  rb_lz_deriv view s k1
  for i ulong 3 bound 3
    put t i add get s i mul mul 0.5f64 1.0e-4f64 get k1 i
  end
  rb_lz_deriv view t k2
  for i ulong 3 bound 3
    put t i add get s i mul mul 0.5f64 1.0e-4f64 get k2 i
  end
  rb_lz_deriv view t k3
  for i ulong 3 bound 3
    put t i add get s i mul 1.0e-4f64 get k3 i
  end
  rb_lz_deriv view t k4
  c6 = div 1.0e-4f64 6.0f64
  for i ulong 3 bound 3
    sv = add get k1 i get k4 i
    sv = add sv mul 2.0f64 add get k2 i get k3 i
    put s i add get s i mul c6 sv
  end
end

fn rb_lz_current v f64 c ulong to f64
  if lt c 2
    ret div add mul v 1.05e-10f64 1.0e-9f64 10.0f64
  end
  ret div mul mul v 1.0e-10f64 2.05f64 10.0f64
end

fn rb_lz_horizon h ulong to ulong
  if eq h 0
    ret 0
  end
  if eq h 1
    ret 1
  end
  ret 25
end

fn rb_lz_init_state si ulong sp ulong seed int s edit f64 3 to void
  r = new ulong 1 0
  purp = ulong 4
  if ne sp 0
    purp = 5
  end
  rb_stream seed purp r
  put s 0 add -10.0f64 mul 20.0f64 rc_rng_unit r
  put s 1 add -10.0f64 mul 20.0f64 rc_rng_unit r
  put s 2 add 10.0f64 mul 30.0f64 rc_rng_unit r
  icb = add mul si 6 mul sp 3
  for c ulong 3 bound 3
    put rb_l_ic add icb c get s c
  end
end

fn rb_lz_record_traj sp ulong s edit f64 3 to void
  if eq sp 0
    _e = enlarge rb_lx0 mul RB_LZ_POINTS 3
    for k ulong RB_LZ_POINTS bound 200001
      b = mul k 3
      put rb_lx0 b get s 0
      put rb_lx0 add b 1 get s 1
      put rb_lx0 add b 2 get s 2
      rb_lz_rk4 s
    end
  else
    _e = enlarge rb_lx1 mul RB_LZ_POINTS 3
    for k ulong RB_LZ_POINTS bound 200001
      b = mul k 3
      put rb_lx1 b get s 0
      put rb_lx1 add b 1 get s 1
      put rb_lx1 add b 2 get s 2
      rb_lz_rk4 s
    end
  end
end

fn rb_lz_gen_traj si ulong sp ulong seed int to void
  s = new f64 3 0.0f64
  rb_lz_init_state si sp seed s
  for k ulong RB_LZ_DISCARD bound 200000
    rb_lz_rk4 s
  end
  rb_lz_record_traj sp s
end

fn rb_lz_get_x sp ulong idx ulong to f64
  if eq sp 0
    ret get rb_lx0 idx
  end
  ret get rb_lx1 idx
end

fn rb_lz_build_target_hs h ulong sp ulong to void
  hor = rb_lz_horizon h
  base = mul add mul h 2 sp mul RB_LZ_NROW 3
  for r ulong RB_LZ_NROW bound 1776
    idx = mul mul add add RB_LZ_ROW0 r hor RB_LZ_SAMPLE 3
    dst = add base mul r 3
    put rb_ly dst rb_lz_get_x sp idx
    put rb_ly add dst 1 rb_lz_get_x sp add idx 1
    put rb_ly add dst 2 rb_lz_get_x sp add idx 2
  end
end

fn rb_lz_build_targets to void
  _e = enlarge rb_ly mul 6 mul RB_LZ_NROW 3
  for h ulong 3 bound 3
    rb_lz_build_target_hs h 0
    rb_lz_build_target_hs h 1
  end
end

fn rb_lz_load_y h ulong to void
  _e = enlarge rc_ytr mul RB_LZ_NROW 3
  _e = enlarge rc_yte mul RB_LZ_NROW 3
  n3 = mul RB_LZ_NROW 3
  b0 = mul mul h 2 n3
  b1 = add b0 n3
  for i ulong n3 bound 6000
    put rc_ytr i get rb_ly add b0 i
    put rc_yte i get rb_ly add b1 i
  end
end

fn rb_lz_fill_tab_k sp ulong k ulong nc ulong drv view uint 3 to void
  tbase = mul k nc
  xbase = mul k 3
  for c ulong 3 bound 3
    v = rb_lz_get_x sp add xbase c
    put rc_tab add tbase ulong get drv c f32 rb_lz_current v c
  end
end

fn rb_lz_fill_tab sp ulong nc ulong drv view uint 3 to void
  total = mul RB_LZ_POINTS nc
  _e = enlarge rc_tab total
  for i ulong total bound 10000000
    put rc_tab i 0.0f32
  end
  for k ulong RB_LZ_POINTS bound 200001
    rb_lz_fill_tab_k sp k nc drv
  end
end

fn rb_lz_extract_xl_m0 sp ulong r ulong nc ulong g uint nfl ulong to void
  f = ulong 0
  rbase = mul r nfl
  vbase = mul add RB_LZ_ROW0 r nc
  for i ulong nc bound 64
    if ne uint i g
      val = get rc_vout add vbase i
      if eq sp 0
        put rb_lxl0 add rbase f val
      else
        put rb_lxl1 add rbase f val
      end
      f = add f 1
    end
  end
end

fn rb_lz_extract_xl_m1 sp ulong r ulong nc ulong to void
  rbase = mul r 3
  vbase = mul add RB_LZ_ROW0 r nc
  for i ulong 3 bound 3
    val = get rc_vout add vbase i
    if eq sp 0
      put rb_lxl0 add rbase i val
    else
      put rb_lxl1 add rbase i val
    end
  end
end

fn rb_lz_extract_xl m ulong sp ulong nc ulong g uint nfl ulong to void
  if eq sp 0
    _e = enlarge rb_lxl0 mul RB_LZ_NROW nfl
  else
    _e = enlarge rb_lxl1 mul RB_LZ_NROW nfl
  end
  for r ulong RB_LZ_NROW bound 1776
    if eq m 0
      rb_lz_extract_xl_m0 sp r nc g nfl
    else
      rb_lz_extract_xl_m1 sp r nc
    end
  end
end

fn rb_lz_build_xs_row sp ulong r ulong nfl ulong to void
  nf2 = mul nfl 2
  sb = mul r nfl
  db = mul r nf2
  for i ulong nfl bound 64
    if eq sp 0
      v = get rb_lxl0 add sb i
      put rb_lxs0 add db i v
      put rb_lxs0 add add db nfl i mul v v
    else
      v = get rb_lxl1 add sb i
      put rb_lxs1 add db i v
      put rb_lxs1 add add db nfl i mul v v
    end
  end
end

fn rb_lz_build_xs sp ulong nfl ulong to void
  nf2 = mul nfl 2
  if eq sp 0
    _e = enlarge rb_lxs0 mul RB_LZ_NROW nf2
  else
    _e = enlarge rb_lxs1 mul RB_LZ_NROW nf2
  end
  for r ulong RB_LZ_NROW bound 1776
    rb_lz_build_xs_row sp r nfl
  end
end

fn rb_lz_prep_sim sp ulong nc ulong drv view uint 3 smeta edit uint 4 to void
  _e = enlarge rc_steps RB_LZ_NS
  for j ulong RB_LZ_NS bound 2001
    put rc_steps j mul j mul RB_LZ_SAMPLE 10
  end
  _e = enlarge rc_vout mul RB_LZ_NS nc
  rb_lz_fill_tab sp nc drv
  put smeta 0 RES_INIT_CONST
  put smeta 1 bitcast uint 1.0f32
  put smeta 2 uint RB_LZ_POINTS
  put smeta 3 uint RB_LZ_NS
end

fn rb_lz_sim_one si ulong m ulong sp ulong t view uint 514 p view uint 265 drv view uint 3 to int
  smeta = new uint 4 0
  rb_lz_prep_sim sp ulong get t 0 drv smeta
  rc = new uint 130 0
  ms = new uint 200 0
  st = rc_simulate_run t p view smeta rc ms
  slot = add mul si 4 add mul m 2 sp
  rb_store_run 1 slot st view rc view ms
  ret st
end

fn rb_lz_load_x_res q ulong nf ulong to void
  tot = mul RB_LZ_NROW nf
  _e = enlarge rc_xtr tot
  _e = enlarge rc_xte tot
  for i ulong tot bound 200000
    if eq q 0
      put rc_xtr i get rb_lxl0 i
      put rc_xte i get rb_lxl1 i
    else
      put rc_xtr i get rb_lxs0 i
      put rc_xte i get rb_lxs1 i
    end
  end
end

fn rb_lz_fit_res_q fbase ulong q ulong nf ulong ok bool es int to void
  if ok
    rb_lz_load_x_res q nf
  end
  for h ulong 3 bound 3
    slot = add fbase h
    if not ok
      rb_fit_refused 1 slot es nf
    else
      rb_lz_load_y h
      rb_fit_run 1 slot RB_LZ_NROW RB_LZ_NROW nf 3
    end
  end
end

fn rb_lz_fit_res si ulong m ulong nfl ulong st0 int st1 int to void
  ok = and eq st0 RES_OK eq st1 RES_OK
  es = st0
  if eq es RES_OK
    es = st1
  end
  fb0 = add mul si 18 mul mul m 2 3
  rb_lz_fit_res_q fb0 0 nfl ok es
  rb_lz_fit_res_q add fb0 3 1 mul nfl 2 ok es
end

fn rb_lz_run_conn si ulong tc view uint 514 pc view uint 265 inp view uint 3 g uint to void
  nc = ulong get tc 0
  nfl = sub nc 1
  st0 = rb_lz_sim_one si 0 0 tc pc inp
  if eq st0 RES_OK
    rb_lz_extract_xl 0 0 nc g nfl
    rb_lz_build_xs 0 nfl
  end
  st1 = rb_lz_sim_one si 0 1 tc pc inp
  if eq st1 RES_OK
    rb_lz_extract_xl 0 1 nc g nfl
    rb_lz_build_xs 1 nfl
  end
  rb_lz_fit_res si 0 nfl st0 st1
end

fn rb_lz_disc_fail si ulong dst int to void
  rc = new uint 130 0
  ms = new uint 200 0
  rb_store_run 1 add mul si 4 2 dst view rc view ms
  rb_store_run 1 add mul si 4 3 dst view rc view ms
  rb_lz_fit_res si 1 3 dst dst
end

fn rb_lz_run_disc si ulong conc view f32 64 to void
  td = new uint 514 0
  pd = new uint 265 0
  dst = rc_net_disconnected RES_REF_LORENZ conc 3 td pd
  if ne dst RES_OK
    put rb_l_nodes add mul si 2 1 0
    rb_lz_disc_fail si dst
    ret
  end
  put rb_l_nodes add mul si 2 1 get td 0
  drvd = new uint 3 0
  put drvd 1 1
  put drvd 2 2
  nc = ulong get td 0
  st0 = rb_lz_sim_one si 1 0 view td view pd view drvd
  if eq st0 RES_OK
    rb_lz_extract_xl 1 0 nc 0 3
    rb_lz_build_xs 0 3
  end
  st1 = rb_lz_sim_one si 1 1 view td view pd view drvd
  if eq st1 RES_OK
    rb_lz_extract_xl 1 1 nc 0 3
    rb_lz_build_xs 1 3
  end
  rb_lz_fit_res si 1 3 st0 st1
end

fn rb_lz_fill_xb_row sp ulong r ulong to void
  rb = mul r 15
  for l ulong RB_LZ_LAGS bound 5
    xb = mul mul sub add RB_LZ_ROW0 r l RB_LZ_SAMPLE 3
    db = add rb mul l 3
    if eq sp 0
      put rb_lxb0 db rb_lz_get_x sp xb
      put rb_lxb0 add db 1 rb_lz_get_x sp add xb 1
      put rb_lxb0 add db 2 rb_lz_get_x sp add xb 2
    else
      put rb_lxb1 db rb_lz_get_x sp xb
      put rb_lxb1 add db 1 rb_lz_get_x sp add xb 1
      put rb_lxb1 add db 2 rb_lz_get_x sp add xb 2
    end
  end
end

fn rb_lz_fill_xb sp ulong to void
  if eq sp 0
    _e = enlarge rb_lxb0 mul RB_LZ_NROW 15
  else
    _e = enlarge rb_lxb1 mul RB_LZ_NROW 15
  end
  for r ulong RB_LZ_NROW bound 1776
    rb_lz_fill_xb_row sp r
  end
end

fn rb_lz_quad_pair which uint rb ulong ob ulong i ulong k_in ulong to ulong
  k = k_in
  ai = 0.0f64
  if eq which 0
    ai = get rb_lxb0 add rb i
  else
    ai = get rb_lxb1 add rb i
  end
  for j ulong sub 15 i bound 15
    if eq which 0
      aj = get rb_lxb0 add rb add i j
      put rc_xtr add ob k mul ai aj
    else
      aj = get rb_lxb1 add rb add i j
      put rc_xte add ob k mul ai aj
    end
    k = add k 1
  end
  ret k
end

fn rb_lz_quad_row which uint r ulong nfq ulong to void
  rb = mul r 15
  ob = mul r nfq
  k = ulong 0
  for i ulong 15 bound 15
    if eq which 0
      put rc_xtr add ob k get rb_lxb0 add rb i
    else
      put rc_xte add ob k get rb_lxb1 add rb i
    end
    k = add k 1
  end
  for i ulong 15 bound 15
    k = rb_lz_quad_pair which rb ob i k
  end
end

fn rb_lz_baselines si ulong to void
  rb_lz_fill_xb 0
  rb_lz_fill_xb 1
  nlin = mul RB_LZ_NROW 15
  _e = enlarge rc_xtr nlin
  _e = enlarge rc_xte nlin
  for i ulong nlin bound 30000
    put rc_xtr i get rb_lxb0 i
    put rc_xte i get rb_lxb1 i
  end
  for h ulong 3 bound 3
    rb_lz_load_y h
    rb_fit_run 1 add mul si 18 add 12 h RB_LZ_NROW RB_LZ_NROW 15 3
  end
  nfq = ulong 135
  _e = enlarge rc_xtr mul RB_LZ_NROW nfq
  _e = enlarge rc_xte mul RB_LZ_NROW nfq
  for r ulong RB_LZ_NROW bound 1776
    rb_lz_quad_row 0 r nfq
    rb_lz_quad_row 1 r nfq
  end
  for h ulong 3 bound 3
    rb_lz_load_y h
    rb_fit_run 1 add mul si 18 add 15 h RB_LZ_NROW RB_LZ_NROW nfq 3
  end
end

fn rb_lorenz_seed si ulong seed int to void
  rb_lz_gen_traj si 0 seed
  rb_lz_gen_traj si 1 seed
  rb_lz_build_targets
  tc = new uint 514 0
  pc = new uint 265 0
  inp = new uint 3 0
  gr = new uint 1 0
  _st = rc_net_topology RC_NET_HEX43 tc inp gr
  _st = res_params_reference RES_REF_LORENZ get tc 0 pc
  conc = new f32 64 0.0f32
  for c ulong 3 bound 3
    put conc c bitcast f32 get pc add RES_PAR_CONC ulong get inp c
  end
  put rb_l_nodes mul si 2 get tc 0
  rb_lz_run_conn si view tc view pc view inp get gr 0
  rb_lz_run_disc si view conc
  rb_lz_baselines si
end

fn rb_lz_model_name m ulong to void
  if eq m 0
    rc_puts rb_lm0
    ret
  end
  if eq m 1
    rc_puts rb_lm1
    ret
  end
  if eq m 2
    rc_puts rb_lm2
    ret
  end
  if eq m 3
    rc_puts rb_lm3
    ret
  end
  if eq m 4
    rc_puts rb_lm4
    ret
  end
  rc_puts rb_lm5
end

fn rb_lz_task_name t ulong to void
  if eq t 0
    rc_puts rb_lt0
    ret
  end
  if eq t 1
    rc_puts rb_lt1
    ret
  end
  rc_puts rb_lt2
end

fn rb_lz_fit_emit si ulong m ulong t ulong to void
  slot = add mul si 18 add mul m 3 t
  rc_puts rb_s_fit0
  rb_lz_model_name m
  rc_puts rb_s_fit1
  rb_lz_task_name t
  rb_fit_json_body 1 slot 3
end

fn rb_lz_emit_seed si ulong seed int to void
  if gt si 0
    rc_putc uchar 44
  end
  rc_puts rb_bn_sd0
  rc_put_i64 long seed
  rc_puts rb_bl_ic0
  icb = mul si 6
  for c ulong 3 bound 3
    if gt c 0
      rc_puts rb_s_comma
    end
    rc_put_f64 get rb_l_ic add icb c 10
  end
  rc_puts rb_bl_ic1
  for c ulong 3 bound 3
    if gt c 0
      rc_puts rb_s_comma
    end
    rc_put_f64 get rb_l_ic add add icb 3 c 10
  end
  rc_puts rb_bl_ic2
  b = mul si 4
  rb_run_json 1 b rb_lr0
  rc_puts rb_s_comma
  rb_run_json 1 add b 1 rb_lr1
  rc_puts rb_s_comma
  rb_run_json 1 add b 2 rb_lr2
  rc_puts rb_s_comma
  rb_run_json 1 add b 3 rb_lr3
  rc_puts rb_bn_sd3
  for m ulong 6 bound 6
    for t ulong 3 bound 3
      if or gt m 0 gt t 0
        rc_puts rb_bn_sd4
      end
      rb_lz_fit_emit si m t
    end
  end
  rc_putc uchar 93
  rc_putc uchar 125
end

fn rb_lz_fit_mean_slot slot ulong to f64
  base = mul slot RB_FIT_STRIDE
  s = 0.0f64
  for c ulong 3 bound 3
    s = add s bitcast f64 get rb_l_fits add add base 4 c
  end
  ret div s 3.0f64
end

fn rb_lz_collect_m ns ulong m ulong t ulong dst edit f64 16 to void
  for i ulong ns bound 16
    slot = add mul i 18 add mul m 3 t
    put dst i rb_lz_fit_mean_slot slot
  end
end

fn rb_lz_best_bl_one i ulong t ulong to f64
  sa_slot = add mul i 18 add 12 t
  sb_slot = add mul i 18 add 15 t
  sa = mul sa_slot RB_FIT_STRIDE
  sb = mul sb_slot RB_FIT_STRIDE
  if eq bitcast int uint get rb_l_fits sb RES_OK
    if ne bitcast int uint get rb_l_fits sa RES_OK
      ret rb_lz_fit_mean_slot sb_slot
    end
    if lt bitcast f64 get rb_l_fits add sb 3 bitcast f64 get rb_l_fits add sa 3
      ret rb_lz_fit_mean_slot sb_slot
    end
  end
  ret rb_lz_fit_mean_slot sa_slot
end

fn rb_lz_fill_best_bl ns ulong t ulong bst edit f64 16 to void
  for i ulong ns bound 16
    put bst i rb_lz_best_bl_one i t
  end
end

fn rb_lz_emit_summary ns ulong t ulong to void
  if gt t 0
    rc_putc uchar 44
  end
  rc_puts rb_bn_sum1
  rb_lz_task_name t
  rc_puts rb_bl_sum2
  v0 = new f64 16 0.0f64
  v1 = new f64 16 0.0f64
  v2 = new f64 16 0.0f64
  v3 = new f64 16 0.0f64
  bst = new f64 16 0.0f64
  vm = new f64 16 0.0f64
  for m ulong 6 bound 6
    rb_lz_collect_m ns m t vm
    if gt m 0
      rc_puts rb_s_comma
    end
    rc_putc uchar 34
    rb_lz_model_name m
    rc_putc uchar 34
    rc_putc uchar 58
    rc_putc uchar 32
    rb_stat_json view vm ns
  end
  rb_lz_collect_m ns 0 t v0
  rb_lz_collect_m ns 1 t v1
  rb_lz_collect_m ns 2 t v2
  rb_lz_collect_m ns 3 t v3
  rb_lz_fill_best_bl ns t bst
  rc_puts rb_bn_sum3
  rb_paired_json rb_lp0 view v0 view v2 ns
  rc_puts rb_s_comma
  rb_paired_json rb_lp1 view v1 view v3 ns
  rc_puts rb_s_comma
  rb_paired_json rb_lp2 view v0 view bst ns
  rc_puts rb_s_comma
  rb_paired_json rb_lp3 view v1 view bst ns
  rc_putc uchar 93
  rc_putc uchar 125
end

fn rb_bench_lorenz seeds view int 16 ns ulong to int
  t0 = rc_now_s
  for i ulong ns bound 16
    rb_lorenz_seed i get seeds i
  end
  wall = sub rc_now_s t0
  rc_puts rb_bl_hdr
  rc_putc uchar 91
  for i ulong ns bound 16
    if gt i 0
      rc_puts rb_s_comma
    end
    rc_put_i64 long get seeds i
  end
  rc_putc uchar 93
  rc_puts rb_bl_s0
  rc_put_u64 ulong get rb_l_nodes 0
  rc_puts rb_bl_s1
  rc_put_u64 ulong get rb_l_nodes 1
  rc_puts rb_bl_s2
  rc_put_f64_1 wall
  rc_puts rb_bn_s5
  for i ulong ns bound 16
    rb_lz_emit_seed i get seeds i
  end
  rc_puts rb_bn_sum0
  for t ulong 3 bound 3
    rb_lz_emit_summary ns t
  end
  rc_puts rb_bn_end
  rc_flush
  ret 0
end

fn rb_pct_u64 base ulong n ulong p f64 to ulong
  k = ulong add mul p f64 n 0.999999999f64
  if lt k 1
    k = 1
  end
  if gt k n
    k = n
  end
  ret get rb_lat add base sub k 1
end

fn rb_perf_sort_ins base ulong gap ulong idx ulong to void
  tmp = get rb_lat add base idx
  j = idx
  done = false
  while not done bound 200000
    if ge j gap
      prev = get rb_lat add base sub j gap
      if gt prev tmp
        put rb_lat add base j prev
        j = sub j gap
      else
        done = true
      end
    else
      done = true
    end
  end
  put rb_lat add base j tmp
end

fn rb_perf_sort_slice base ulong n ulong to void
  gap = div n 2
  while gt gap 0 bound 32
    for i ulong sub n gap bound 200000
      rb_perf_sort_ins base gap add gap i
    end
    gap = div gap 2
  end
end

fn rb_perf_fill_narma_k base ulong nc ulong g uint i_node f64 r edit ulong 1 to void
  for i ulong nc bound 64
    if eq uint i g
      put rc_tab add base i 0.0f32
    else
      v = f32 mul i_node sub mul 2.0f64 rc_rng_unit r 1.0f64
      put rc_tab add base i v
    end
  end
end

fn rb_perf_copy_prev base ulong pbase ulong nc ulong to void
  for i ulong nc bound 64
    put rc_tab add base i get rc_tab add pbase i
  end
end

fn rb_perf_fill_lz_k base ulong inp view uint 3 s view f64 3 to void
  for c ulong 3 bound 3
    dst = add base ulong get inp c
    val = f32 rb_lz_current get s c c
    put rc_tab dst val
  end
end

fn rb_perf_fill_tab ni ulong nc ulong g uint inp view uint 3 knots ulong to void
  _e = enlarge rc_tab mul knots nc
  for i ulong mul knots nc bound 2000000
    put rc_tab i 0.0f32
  end
  i_node = div 1.0e-10f64 f64 sub nc 1
  r = new ulong 1 0
  rb_stream 1 6 r
  s = new f64 3 0.0f64
  put s 0 1.0f64
  put s 1 1.0f64
  put s 2 20.0f64
  for k ulong knots bound 30000
    base = mul k nc
    if eq ni 2
      rb_perf_fill_lz_k base inp view s
      rb_lz_rk4 s
    else
      if eq rem k 10 0
        rb_perf_fill_narma_k base nc g i_node r
      else
        rb_perf_copy_prev base mul sub k 1 nc nc
      end
    end
  end
end

fn rb_perf_warm nc ulong to int
  cfg = new uint 5363 0
  s = new uint 932 0
  ws = new uint 3564 0
  rc_load_sim cfg s ws
  pair = new f32 128 0.0f32
  last_k = ulong 0xffffffffffffffff
  for k ulong RB_PERF_WARM bound 10000
    k64 = div res_state_get_step view s 10
    if ne k64 last_k
      rc_load_pair nc k64 pair
      last_k = k64
    end
    st = res_step_pair view cfg view pair ws view s
    if ne st RES_OK
      ret st
    end
    res_copy_spare_to_state view ws s
  end
  rc_save_sim view s view ws
  ret RES_OK
end

global rb_perf_meta ulong 3

fn rb_perf_record_lat k ulong nw ulong prev ulong to void
  put rb_lat add get rb_perf_meta 0 k sub nw prev
end

fn rb_perf_one_rep nc ulong to f64
  cfg = new uint 5363 0
  s = new uint 932 0
  ws = new uint 3564 0
  rc_load_sim cfg s ws
  pair = new f32 128 0.0f32
  put rb_perf_meta 1 ulong 0xffffffffffffffff
  put rb_perf_meta 2 rc_now_ns
  prev = get rb_perf_meta 2
  for k ulong RB_PERF_STEPS bound 40000
    k64 = div res_state_get_step view s 10
    if ne k64 get rb_perf_meta 1
      rc_load_pair nc k64 pair
      put rb_perf_meta 1 k64
    end
    st = res_step_pair view cfg view pair ws view s
    nw = rc_now_ns
    rb_perf_record_lat k nw prev
    prev = nw
    if ne st RES_OK
      ret neg f64 st
    end
    res_copy_spare_to_state view ws s
  end
  rc_save_sim view s view ws
  ret mul f64 sub prev get rb_perf_meta 2 1.0e-9f64
end

fn rb_perf_measure nc ulong rwall edit f64 5 wall_out edit f64 1 to int
  st = rb_perf_warm nc
  if ne st RES_OK
    ret st
  end
  w0 = rc_now_ns
  for rep ulong RB_PERF_REPS bound 5
    put rb_perf_meta 0 mul rep RB_PERF_STEPS
    rw = rb_perf_one_rep nc
    if lt rw 0.0f64
      ret int neg rw
    end
    put rwall rep rw
  end
  put wall_out 0 mul f64 sub rc_now_ns w0 1.0e-9f64
  ret RES_OK
end

fn rb_perf_emit_ok rwall view f64 5 wall f64 to void
  rc_puts rb_pf_j4
  for rep ulong RB_PERF_REPS bound 5
    if gt rep 0
      rc_puts rb_s_comma
    end
    b = mul rep RB_PERF_STEPS
    rb_perf_sort_slice b RB_PERF_STEPS
    rc_puts rb_pf_j5
    rc_put_u64 rb_pct_u64 b RB_PERF_STEPS 0.50f64
    rc_puts rb_pf_j6
    rc_put_u64 rb_pct_u64 b RB_PERF_STEPS 0.95f64
    rc_puts rb_pf_j7
    rc_put_u64 rb_pct_u64 b RB_PERF_STEPS 0.99f64
    rc_puts rb_pf_j8
    rc_put_u64 get rb_lat add b sub RB_PERF_STEPS 1
    rc_puts rb_pf_j9
    rc_put_f64_1 div f64 RB_PERF_STEPS get rwall rep
    rc_putc uchar 125
  end
  nl = mul RB_PERF_STEPS RB_PERF_REPS
  rb_perf_sort_slice 0 nl
  sps = div f64 nl wall
  rc_puts rb_pf_ja
  rc_put_u64 rb_pct_u64 0 nl 0.50f64
  rc_puts rb_pf_j6
  rc_put_u64 rb_pct_u64 0 nl 0.95f64
  rc_puts rb_pf_j7
  rc_put_u64 rb_pct_u64 0 nl 0.99f64
  rc_puts rb_pf_j8
  rc_put_u64 get rb_lat sub nl 1
  rc_puts rb_pf_jb
  rc_put_f64_1 sps
  rc_puts rb_pf_jc
  rc_put_f64 mul sps 1.0e-5f64 6
  rc_putc uchar 125
end

fn rb_perf_setup ni ulong info edit uint 2 to int
  t = new uint 514 0
  p = new uint 265 0
  inp = new uint 3 0
  gr = new uint 1 4
  st = RES_OK
  if eq ni 0
    st = res_topology_chain 5 4 t
    if eq st RES_OK
      st = res_params_reference RES_REF_NARMA get t 0 p
    end
  else
    if eq ni 1
      st = rc_net_topology RC_NET_CHAIN50 t inp gr
      if eq st RES_OK
        st = res_params_reference RES_REF_NARMA get t 0 p
      end
    else
      st = rc_net_topology RC_NET_HEX43 t inp gr
      if eq st RES_OK
        st = res_params_reference RES_REF_LORENZ get t 0 p
      end
    end
  end
  put info 0 get t 0
  put info 1 get t 1
  rb_perf_fill_tab ni ulong get t 0 get gr 0 view inp 21001
  if eq st RES_OK
    if eq ni 2
      st = rc_sim_init_globals view t view p RES_INIT_CONST 1.0f32
    else
      st = rc_sim_init_globals view t view p RES_INIT_N0 0.0f32
    end
  end
  ret st
end

fn rb_perf_run_net ni ulong to int
  info = new uint 2 0
  st = rb_perf_setup ni info
  rwall = new f64 5 0.0f64
  wall_b = new f64 1 0.0f64
  if eq st RES_OK
    st = rb_perf_measure ulong get info 0 rwall wall_b
  end
  if gt ni 0
    rc_putc uchar 44
  end
  rc_puts rb_pf_j0
  if eq ni 0
    rc_puts rb_pf_n0
  else
    if eq ni 1
      rc_puts rb_pf_n1
    else
      rc_puts rb_pf_n2
    end
  end
  rc_puts rb_pf_j1
  rc_put_u64 ulong get info 0
  rc_puts rb_pf_j2
  rc_put_u64 ulong get info 1
  rc_puts rb_pf_j3
  rc_status_puts st
  if eq st RES_OK
    rb_perf_emit_ok view rwall get wall_b 0
    ret 0
  end
  rc_putc uchar 34
  rc_putc uchar 125
  ret 1
end

fn rb_perf to int
  tc0 = rc_now_ns
  for i ulong 100000 bound 100000
    _t = rc_now_ns
  end
  tns = div f64 sub rc_now_ns tc0 100000.0f64
  rc_puts rb_pf_hdr
  rc_put_f64_1 tns
  rc_puts rb_pf_s0
  rc = int 0
  for ni ulong 3 bound 3
    if ne rb_perf_run_net ni 0
      rc = 1
    end
  end
  rc_puts rb_pf_end
  rc_flush
  ret rc
end

note ================================================================
note Utility & MAT loading helpers
note ================================================================

fn rq_streq a view uchar * alen ulong b view uchar * to bool
  if ne alen len b
    ret false
  end
  for i ulong alen bound 256
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn rq_parse_int s view uchar * n ulong to int
  v = long 0
  neg_f = false
  i = ulong 0
  if gt n 0
    if eq get s 0 uchar 45
      neg_f = true
      i = 1
    end
  end
  while lt i n bound 32
    c = get s i
    if and ge c uchar 48 le c uchar 57
      v = add mul v 10 long sub c uchar 48
    end
    i = add i 1
  end
  if neg_f
    ret int neg v
  end
  ret int v
end

fn rq_hex_nibble c uchar to int
  if and ge c uchar 48 le c uchar 57
    ret int sub c uchar 48
  end
  if and ge c uchar 97 le c uchar 102
    ret add 10 int sub c uchar 97
  end
  ret -1
end

fn rq_unhex h view uchar * dst edit uchar 32 to int
  if lt len h 64
    ret -1
  end
  for i ulong 32 bound 32
    hi = rq_hex_nibble get h mul i 2
    lo = rq_hex_nibble get h add mul i 2 1
    if or lt hi 0 lt lo 0
      ret -1
    end
    put dst i uchar add mul hi 16 lo
  end
  ret 0
end

fn rq_put_bool b bool to void
  if b
    rc_puts rc_s_true
  else
    rc_puts rc_s_false
  end
end

fn rq_jd v f64 to void
  rc_put_f64 v 17
end

fn rq_nrmse_ok got f64 refv f64 to bool
  d = rc_abs64 sub got refv
  tol = mul RQ_TOL_NRMSE_REL refv
  if lt tol RQ_TOL_NRMSE_ABS
    tol = RQ_TOL_NRMSE_ABS
  end
  ret le d tol
end

fn rq_rel_ok got f64 refv f64 rel f64 to bool
  d = rc_abs64 sub got refv
  s = rc_abs64 refv
  ret le d mul rel s
end

fn rq_store_mf slot ulong mf view ulong 98 to void
  for i ulong 98 bound 98
    if eq slot 0
      put rq_mf0 i get mf i
    else
      if eq slot 1
        put rq_mf1 i get mf i
      else
        if eq slot 2
          put rq_mf2 i get mf i
        else
          put rq_mf3 i get mf i
        end
      end
    end
  end
end

fn rq_load_mf slot ulong mf edit ulong 98 to void
  for i ulong 98 bound 98
    if eq slot 0
      put mf i get rq_mf0 i
    else
      if eq slot 1
        put mf i get rq_mf1 i
      else
        if eq slot 2
          put mf i get rq_mf2 i
        else
          put mf i get rq_mf3 i
        end
      end
    end
  end
end

fn rq_mf_find slot ulong name view uchar * to long
  mf = new ulong 98 0
  rq_load_mf slot mf
  ret res_mat_find view mf name
end

fn rq_load_pinned_path root view uchar * rlen ulong pidx ulong path edit uchar 1024 to long
  rel = new uchar 256 0
  rpl = rc_pin_copy_p pidx rel
  if gt add add rlen 1 rpl 1020
    ret -1
  end
  for i ulong rlen bound 768
    put path i get root i
  end
  put path rlen uchar 47
  for i ulong rpl bound 256
    put path add add rlen 1 i get rel i
  end
  ret long add add rlen 1 rpl
end

fn rq_load_pinned_slot root view uchar * rlen ulong pidx ulong slot ulong to int
  path = new uchar 1024 0
  plen = rq_load_pinned_path root rlen pidx path
  if lt plen 0
    rc_err_puts rq_err_pin
    ret -1
  end
  hstr = new uchar 64 0
  _hl = rc_pin_copy_h pidx hstr
  want = new uchar 32 0
  if ne rq_unhex view hstr want 0
    rc_err_puts rq_err_pin
    ret -1
  end
  mf = new ulong 98 0
  ms = res_mat_load part path 0 ulong plen view want true mf
  if ne ms RES_MAT_OK
    rc_err_puts rq_err_pin
    ret -1
  end
  rq_store_mf slot view mf
  ret 0
end

fn rq_load_v2_slot v2p view uchar * v2len ulong slot ulong to int
  want = new uchar 32 0
  if ne rq_unhex rq_v2_sha want 0
    rc_err_puts rq_err_v2
    ret -1
  end
  mf = new ulong 98 0
  ms = res_mat_load part v2p 0 v2len view want true mf
  if ne ms RES_MAT_OK
    rc_err_puts rq_err_v2
    ret -1
  end
  rq_store_mf slot view mf
  ret 0
end

fn rq_save_run_rec sp ulong st int rc view uint 130 ms view uint 200 to void
  put rq_rst sp bitcast uint st
  if eq sp 0
    for i ulong 130 bound 130
      put rq_rc0 i get rc i
    end
    for i ulong 200 bound 200
      put rq_ms0 i get ms i
    end
  else
    for i ulong 130 bound 130
      put rq_rc1 i get rc i
    end
    for i ulong 200 bound 200
      put rq_ms1 i get ms i
    end
  end
end

fn rq_rc_get sp ulong idx ulong to uint
  if eq sp 0
    ret get rq_rc0 idx
  end
  ret get rq_rc1 idx
end

fn rq_receipt_ok_json sp ulong to void
  buf = new uint 32 0
  for i ulong 32 bound 32
    put buf i rq_rc_get sp i
  end
  rc_puts rq_rec_2
  rc_jhex_u32 view buf
  for i ulong 32 bound 32
    put buf i rq_rc_get sp add 32 i
  end
  rc_puts rq_rec_3
  rc_jhex_u32 view buf
  for i ulong 32 bound 32
    put buf i rq_rc_get sp add 64 i
  end
  rc_puts rq_rec_4
  rc_jhex_u32 view buf
  rc_puts rq_rec_5
  steps = or shl ulong rq_rc_get sp 97 32 ulong rq_rc_get sp 96
  rc_put_u64 steps
  for i ulong 32 bound 32
    put buf i rq_rc_get sp add 98 i
  end
  rc_puts rq_rec_6
  rc_jhex_u32 view buf
end

fn rq_receipt_json sp ulong to void
  st = bitcast int get rq_rst sp
  rc_puts rq_rec_0
  if eq sp 0
    rc_puts rq_s_train
  else
    rc_puts rq_s_test
  end
  rc_puts rq_rec_1
  rc_status_puts st
  if eq st RES_OK
    rq_receipt_ok_json sp
  else
    rc_putc uchar 34
  end
  ms = new uint 200 0
  for i ulong 200 bound 200
    if eq sp 0
      put ms i get rq_ms0 i
    else
      put ms i get rq_ms1 i
    end
  end
  rc_mstats_json view ms
  rc_putc uchar 125
end


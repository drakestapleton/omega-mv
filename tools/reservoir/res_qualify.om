fn rq_run_config to int
  rc_puts rq_cfg_0
  rc_put_f64 f64 RQ_STEP_S 9
  rc_puts rq_cfg_1
  rc_put_u64 ulong RQ_STEPS_PER_KNOT
  rc_puts rq_cfg_2
  rc_json_str res_num_policy
  rc_puts rq_cfg_3
  rc_put_f64 f64 RQ_VM_LIMIT 9
  rc_puts rq_cfg_4
  rc_put_f64 f64 RQ_VM_PLAUSIBLE 9
  rc_puts rq_cfg_5
  rc_puts rq_v2_sha
  rc_puts rq_cfg_6
  rc_put_f64 RQ_TOL_TARGET_ABS 6
  rc_puts rq_cfg_7
  rc_put_f64 RQ_TOL_PRED_REL 6
  rc_puts rq_cfg_8
  rc_put_f64 RQ_TOL_NRMSE_ABS 6
  rc_puts rq_cfg_9
  rc_put_f64 RQ_TOL_NRMSE_REL 6
  rc_puts rq_cfg_a
  rc_put_f64 RQ_TOL_METRIC_REL 6
  rc_puts rq_cfg_b
  rc_put_u64 RB_N_TRAIN
  rc_puts rq_cfg_c
  rc_put_u64 RB_N_TEST
  rc_puts rq_cfg_d
  rc_put_u64 RB_WASHOUT
  rc_puts rq_cfg_e
  rc_put_u64 RB_NM
  rc_puts rq_cfg_f
  rc_put_u64 RB_NDELAY
  rc_puts rq_cfg_g
  rc_put_u64 RB_LZ_ROW0
  rc_puts rq_cfg_h
  rc_put_u64 RB_LZ_ROW0
  rc_puts rb_s_comma
  rc_put_u64 RB_LZ_ROW1
  rc_puts rq_cfg_i
  rc_put_u64 RB_LZ_LAGS
  rc_puts rq_cfg_j
  rc_put_u64 RB_PERF_WARM
  rc_puts rq_cfg_k
  rc_put_u64 RB_PERF_STEPS
  rc_puts rq_cfg_l
  rc_put_u64 RB_PERF_REPS
  rc_puts rq_cfg_m
  rc_flush
  ret 0
end

fn rq_run_pins root view uchar * rlen ulong to int
  bad = false
  rc_puts rq_pins_0
  kbuf = new uchar 64 0
  pbuf = new uchar 256 0
  got = new uchar 64 0
  for i ulong RC_PIN_COUNT bound 22
    put got 0 uchar 0
    r = rc_check_pinned part root 0 rlen i got
    if ne r 0
      bad = true
    end
    if gt i 0
      rc_putc uchar 44
    end
    kl = rc_pin_copy_k i kbuf
    pl = rc_pin_copy_p i pbuf
    rc_puts rq_pins_1
    rc_puts part kbuf 0 kl
    rc_puts rq_pins_2
    rc_json_str part pbuf 0 pl
    rc_puts rq_pins_3
    if eq get got 0 uchar 0
      rc_puts rq_pins_miss
    else
      rc_puts view got
    end
    rc_puts rq_pins_4
    rq_put_bool eq r 0
    rc_putc uchar 125
  end
  rc_puts rq_pins_end0
  if bad
    rc_puts rq_pins_fail
    rc_flush
    ret 1
  end
  rc_puts rq_pins_pass
  rc_flush
  ret 0
end

note ================================================================
note G2-N1 linear algebra diagnostics (min pivot ratio, Householder QR)
note ================================================================

fn rq_gram_accum_ij rb ulong ib ulong i ulong xi f64 to void
  for j ulong add i 1 bound 65
    xj = 1.0f64
    if gt j 0
      xj = get rq_xf0 add rb sub j 1
    end
    idx = add ib j
    put rq_gram idx add get rq_gram idx mul xi xj
  end
end

fn rq_gram_accum_row r ulong nf ulong p ulong to void
  rb = mul r nf
  for i ulong p bound 65
    xi = 1.0f64
    if gt i 0
      xi = get rq_xf0 add rb sub i 1
    end
    rq_gram_accum_ij rb mul i p i xi
  end
end

fn rq_gram_factor_entry i ulong j ulong p ulong d f64 to void
  ib = mul i p
  jb = mul j p
  s = get rq_gram add ib j
  for k ulong j bound 65
    gik = get rq_gram add ib k
    gjk = get rq_gram add jb k
    gkk = get rq_gram add mul k p k
    s = sub s mul mul gik gjk gkk
  end
  if ne d 0.0f64
    put rq_gram add ib j div s d
  else
    put rq_gram add ib j 0.0f64
  end
end

fn rq_gram_factor_col j ulong p ulong to f64
  jb = mul j p
  gjj = get rq_gram add jb j
  d = gjj
  for k ulong j bound 65
    gjk = get rq_gram add jb k
    gkk = get rq_gram add mul k p k
    d = sub d mul mul gjk gjk gkk
  end
  put rq_gram add jb j d
  for ii ulong sub p add j 1 bound 65
    rq_gram_factor_entry add add j 1 ii j p d
  end
  if gt gjj 0.0f64
    ret div d gjj
  end
  ret 0.0f64
end

fn rq_design_min_pivot_ratio n ulong nf ulong argmin edit ulong 1 to f64
  p = add nf 1
  for i ulong mul p p bound 4225
    put rq_gram i 0.0f64
  end
  for r ulong n bound 1000
    rq_gram_accum_row r nf p
  end
  best = bitcast f64 ulong 0x7ff0000000000000
  put argmin 0 0
  for j ulong p bound 65
    ratio = rq_gram_factor_col j p
    if lt ratio best
      best = ratio
      put argmin 0 j
    end
  end
  ret best
end

fn rq_qr_load_row src_which uint i ulong n ulong nf ulong to void
  put rc_qr_a i 1.0f64
  rb = mul i nf
  for f ulong nf bound 64
    v = 0.0f64
    if eq src_which 0
      v = get rq_xf0 add rb f
    else
      v = get rq_xp add rb f
    end
    put rc_qr_a add mul add f 1 n i v
  end
end

fn rq_qr_equil_col j ulong n ulong to f64
  s = 0.0f64
  cb = mul j n
  for i ulong n bound 1000
    a = get rc_qr_a add cb i
    s = add s mul a a
  end
  sj = fsqrt s
  if gt sj 0.0f64
    for i ulong n bound 1000
      put rc_qr_a add cb i div get rc_qr_a add cb i sj
    end
  end
  ret sj
end

fn rq_qr_load src_which uint yoff ulong n ulong nf ulong sc edit f64 257 to void
  p = add nf 1
  _e = enlarge rc_qr_a mul n p
  _e = enlarge rc_qr_b n
  for i ulong n bound 1000
    rq_qr_load_row src_which i n nf
    put rc_qr_b i get rq_ys0 add yoff i
  end
  for j ulong p bound 65
    put sc j rq_qr_equil_col j n
  end
end

fn rq_qr_dot_a jb ulong cb ulong cnt ulong to f64
  d = 0.0f64
  for ii ulong cnt bound 1000
    a = get rc_qr_a add jb ii
    b = get rc_qr_a add cb ii
    d = add d mul a b
  end
  ret d
end

fn rq_qr_axpy_a jb ulong cb ulong cnt ulong t f64 to void
  for ii ulong cnt bound 1000
    idx = add cb ii
    a = get rc_qr_a add jb ii
    b = get rc_qr_a idx
    put rc_qr_a idx sub b mul t a
  end
end

fn rq_qr_reflect_a j ulong c ulong n ulong vv f64 to void
  jb = add mul j n j
  cb = add mul c n j
  cnt = sub n j
  d = rq_qr_dot_a jb cb cnt
  rq_qr_axpy_a jb cb cnt div mul 2.0f64 d vv
end

fn rq_qr_dot_b jb ulong j ulong cnt ulong to f64
  d = 0.0f64
  for ii ulong cnt bound 1000
    a = get rc_qr_a add jb ii
    b = get rc_qr_b add j ii
    d = add d mul a b
  end
  ret d
end

fn rq_qr_axpy_b jb ulong j ulong cnt ulong t f64 to void
  for ii ulong cnt bound 1000
    idx = add j ii
    a = get rc_qr_a add jb ii
    b = get rc_qr_b idx
    put rc_qr_b idx sub b mul t a
  end
end

fn rq_qr_reflect_b j ulong n ulong vv f64 to void
  jb = add mul j n j
  cnt = sub n j
  d = rq_qr_dot_b jb j cnt
  rq_qr_axpy_b jb j cnt div mul 2.0f64 d vv
end

fn rq_qr_reflect_col j ulong c ulong n ulong p ulong vv f64 to void
  if lt c p
    rq_qr_reflect_a j c n vv
  else
    rq_qr_reflect_b j n vv
  end
end

fn rq_qr_col_ssq jb ulong j ulong n ulong to f64
  s = 0.0f64
  for ii ulong sub n j bound 1000
    a = get rc_qr_a add jb add j ii
    s = add s mul a a
  end
  ret s
end

fn rq_qr_step j ulong n ulong p ulong rmax_io edit f64 1 to int
  jb = mul j n
  nrm = fsqrt rq_qr_col_ssq jb j n
  if not gt nrm 0.0f64
    ret -1
  end
  alpha = nrm
  if gt get rc_qr_a add jb j 0.0f64
    alpha = neg nrm
  end
  put rc_qr_a add jb j sub get rc_qr_a add jb j alpha
  vv = rq_qr_col_ssq jb j n
  for cc ulong sub p j bound 65
    rq_qr_reflect_col j add add j 1 cc n p vv
  end
  put rc_qr_a add jb j alpha
  ar = rc_abs64 alpha
  if gt ar get rmax_io 0
    put rmax_io 0 ar
  end
  ret 0
end

fn rq_qr_backsub_row jj ulong n ulong p ulong to f64
  s = get rc_qr_b jj
  for cc ulong sub p add jj 1 bound 65
    c = add add jj 1 cc
    a = get rc_qr_a add mul c n jj
    w = get rc_qr_w c
    s = sub s mul a w
  end
  ret s
end

fn rq_qr_backsub n ulong p ulong rm f64 to int
  for step ulong p bound 65
    jj = sub sub p 1 step
    rjj = get rc_qr_a add mul jj n jj
    if not gt rc_abs64 rjj mul 1.0e-14f64 rm
      ret -1
    end
    put rc_qr_w jj div rq_qr_backsub_row jj n p rjj
  end
  ret 0
end

fn rq_ols_qr src_which uint yoff ulong n ulong nf ulong to int
  p = add nf 1
  if lt n p
    ret -1
  end
  sc = new f64 257 0.0f64
  rq_qr_load src_which yoff n nf sc
  rmax = new f64 1 0.0f64
  for j ulong p bound 65
    if ne rq_qr_step j n p rmax 0
      ret -1
    end
  end
  if ne rq_qr_backsub n p get rmax 0 0
    ret -1
  end
  for j ulong p bound 65
    put rc_qr_w j div get rc_qr_w j get sc j
  end
  ret 0
end

fn rq_std_pop_ys0 yoff ulong n ulong to f64
  m = 0.0f64
  for i ulong n bound 1000
    m = add m get rq_ys0 add yoff i
  end
  m = div m f64 n
  s = 0.0f64
  for i ulong n bound 1000
    d = sub get rq_ys0 add yoff i m
    s = add s mul d d
  end
  ret fsqrt div s f64 n
end

fn rq_qr_sens_row r ulong nf ulong w0 view f64 65 w1 view f64 65 to f64
  a = get w0 0
  b = get w1 0
  rb = mul r nf
  for c ulong nf bound 64
    x0 = get rq_xf0 add rb c
    x1 = get rq_xp add rb c
    a = add a mul x0 get w0 add c 1
    b = add b mul x1 get w1 add c 1
  end
  d = sub a b
  ret mul d d
end

fn rq_qr_sens_accum n ulong nf ulong w0 view f64 65 w1 view f64 65 to f64
  acc = 0.0f64
  for r ulong n bound 1000
    acc = add acc rq_qr_sens_row r nf w0 w1
  end
  ret acc
end

fn rq_qr_perturb n ulong nf ulong rel f64 to void
  _e = enlarge rq_xp mul n nf
  rng = new ulong 1 1
  for k ulong mul n nf bound 64000
    u = rc_rng_unit rng
    fac = add 1.0f64 mul rel sub mul 2.0f64 u 1.0f64
    put rq_xp k mul get rq_xf0 k fac
  end
end

fn rq_qr_copy_w p ulong dst edit f64 65 to void
  for j ulong p bound 65
    put dst j get rc_qr_w j
  end
end

fn rq_qr_sensitivity yoff ulong n ulong nf ulong rel f64 to f64
  rq_qr_perturb n nf rel
  w0 = new f64 65 0.0f64
  w1 = new f64 65 0.0f64
  if ne rq_ols_qr 0 yoff n nf 0
    ret -1.0f64
  end
  rq_qr_copy_w add nf 1 w0
  if ne rq_ols_qr 1 yoff n nf 0
    ret -1.0f64
  end
  rq_qr_copy_w add nf 1 w1
  acc = rq_qr_sens_accum n nf view w0 view w1
  ret div fsqrt div acc f64 n rq_std_pop_ys0 yoff n
end

note ================================================================
note G2-N1 subcommand
note ================================================================

fn rq_mat_meta_get aidx long fld ulong to ulong
  ret get mat_meta add mul ulong aidx RES_MAT_META_STRIDE fld
end

fn rq_narma_parse_sig slot ulong sp ulong L ulong info edit ulong 5 to int
  iu = long -1
  ii = long -1
  it = long -1
  if eq sp 0
    iu = rq_mf_find slot rq_mv_utr
    ii = rq_mf_find slot rq_mv_itr
    it = rq_mf_find slot rq_mv_ttr
  else
    iu = rq_mf_find slot rq_mv_ute
    ii = rq_mf_find slot rq_mv_ite
    it = rq_mf_find slot rq_mv_tte
  end
  o = new ulong 1 0
  if ne res_mat_values iu 0 o RES_MAT_OK
    ret -1
  end
  put info 0 get o 0
  if ne res_mat_values ii 0 o RES_MAT_OK
    ret -1
  end
  put info 1 get o 0
  if ne res_mat_values it 0 o RES_MAT_OK
    ret -1
  end
  put info 2 get o 0
  n = rq_mat_meta_get iu 5
  kn = rq_mat_meta_get ii 8
  if ne rq_mat_meta_get ii 9 L
    ret -1
  end
  if ne rq_mat_meta_get it 5 kn
    ret -1
  end
  put info 3 n
  put info 4 kn
  ret 0
end

fn rq_narma_scan_cell i ulong j ulong edges edit uint 384 ec uint to uint
  ij = add i mul 5 j
  ji = add j mul 5 i
  a = get mat_re add get rq_meta 16 ij
  if ne a get mat_re add get rq_meta 16 ji
    put rq_meta 2 0
  end
  if ne get mat_re add get rq_meta 17 ij 1.0f64
    put rq_meta 3 0
  end
  if lt i j
    if ne a 0.0f64
      put edges mul ulong ec 2 uint i
      put edges add mul ulong ec 2 1 uint j
      ret add ec 1
    end
  end
  ret ec
end

fn rq_narma_scan_col j ulong edges edit uint 384 ec_in uint to uint
  ec = ec_in
  for i ulong 5 bound 5
    ec = rq_narma_scan_cell i j edges ec
  end
  ret ec
end

fn rq_narma_scan_conmat cmoff ulong ixoff ulong edges edit uint 384 to uint
  put rq_meta 16 cmoff
  put rq_meta 17 ixoff
  ec = uint 0
  put rq_meta 2 1
  put rq_meta 3 1
  for j ulong 5 bound 5
    ec = rq_narma_scan_col j edges ec
  end
  put rq_meta 0 ulong ec
  ret ec
end

fn rq_narma_build_cfg cmoff ulong groff ulong ixoff ulong control bool t_out edit uint 514 p_out edit uint 265 to int
  edges = new uint 384 0
  ec = rq_narma_scan_conmat cmoff ixoff edges
  g = sub uint get mat_re groff 1
  put rq_meta 1 ulong g
  garr = new uint 1 0
  put garr 0 g
  tm = new uint 3 0
  put tm 0 5
  put tm 1 ec
  put tm 2 1
  st = res_topology_build view tm view edges view garr t_out
  if eq st RES_OK
    st = res_params_reference RES_REF_NARMA 5 p_out
  end
  if and eq st RES_OK control
    put p_out 1 bitcast uint mul bitcast f32 get p_out 1 2.1f32
  end
  ret st
end

fn rq_narma_check_chain_same t view uint 514 p view uint 265 to ulong
  cfg = new uint 5363 0
  st = res_config_build t p RQ_STEP_S RQ_STEPS_PER_KNOT cfg
  if ne st RES_OK
    ret 2
  end
  chain = new uint 514 0
  if ne res_topology_chain 5 4 chain RES_OK
    ret 0
  end
  ccfg = new uint 5363 0
  if ne res_config_build view chain p RQ_STEP_S RQ_STEPS_PER_KNOT ccfg RES_OK
    ret 0
  end
  for i ulong 32 bound 32
    if ne get cfg add RES_CFG_ID i get ccfg add RES_CFG_ID i
      ret 0
    end
  end
  ret 1
end

fn rq_narma_fill_tab_one k ulong to void
  ioff = get rq_meta 16
  toff = get rq_meta 17
  kn = get rq_meta 18
  dev = rc_abs64 sub get mat_re add toff k div f64 k 10000.0f64
  if gt dev get rq_f64s 1
    put rq_f64s 1 dev
  end
  isum = 0.0f64
  for i ulong 5 bound 5
    x = get mat_re add ioff add k mul kn i
    if ne i get rq_meta 1
      isum = add isum x
    end
    f = f32 x
    put rc_tab add mul k 5 i f
    if ne x 0.0f64
      rr = rc_abs64 div sub f64 f x x
      if gt rr get rq_f64s 0
        put rq_f64s 0 rr
      end
    end
  end
  if lt isum get rq_f64s 2
    put rq_f64s 2 isum
  end
  if gt isum get rq_f64s 3
    put rq_f64s 3 isum
  end
end

fn rq_narma_mask_is_one c ulong base_i ulong stride ulong to ulong
  x = get mat_re add base_i mul c stride
  uv = get mat_re add get rq_meta 16 c
  hi = get rq_f64s 4
  seq = div mul uv hi 0.5f64
  d1 = rc_abs64 sub x seq
  d0 = rc_abs64 sub x sub hi seq
  if le d1 d0
    ret 1
  end
  ret 0
end

fn rq_narma_mask_ones n ulong M ulong slot_im ulong to ulong
  b1 = mul div slot_im 8 get rq_meta 18
  b2 = mul rem slot_im 8 10
  base_i = add get rq_meta 17 add b1 b2
  stride = mul M 10
  ones = ulong 0
  for c ulong n bound 1000
    ones = add ones rq_narma_mask_is_one c base_i stride
  end
  ret ones
end

fn rq_narma_read_masks_node sp ulong i ulong n ulong M ulong to uint
  inc = uint 0
  base = add mul sp 40 mul i 8
  for mi ulong M bound 8
    ones = rq_narma_mask_ones n M add mul i 8 mi
    mb = uint 0
    if gt mul ones 2 n
      mb = 1
    end
    put rq_mask_b add base mi mb
    if ne ones 0
      if ne ones n
        inc = add inc 1
      end
    end
  end
  ret inc
end

fn rq_narma_read_masks sp ulong uoff ulong ioff ulong n ulong kn ulong M ulong to void
  put rq_meta 16 uoff
  put rq_meta 17 ioff
  put rq_meta 18 kn
  inc = uint 0
  for i ulong 5 bound 5
    inc = add inc rq_narma_read_masks_node sp i n M
  end
  put rq_mask_inc sp inc
end

fn rq_narma_store_feat_node sp ulong node ulong squares bool to void
  r0 = get rq_meta 16
  rb = get rq_meta 17
  M = get rq_meta 18
  for k ulong M bound 8
    vidx = add mul add mul r0 M k 5 node
    v = get rc_vout vidx
    col = add mul node M k
    sq_col = add mul 5 M col
    if eq sp 0
      put rq_feat0 add rb col v
      if squares
        put rq_feat0 add rb sq_col mul v v
      end
    else
      put rq_feat1 add rb col v
      if squares
        put rq_feat1 add rb sq_col mul v v
      end
    end
  end
end

fn rq_narma_store_feat_row sp ulong r0 ulong ncol ulong M ulong squares bool to void
  put rq_meta 16 r0
  put rq_meta 17 mul add r0 1 ncol
  put rq_meta 18 M
  for node ulong 5 bound 5
    rq_narma_store_feat_node sp node squares
  end
end

fn rq_narma_zero_feat sp ulong tot ulong to void
  if eq sp 0
    _e = enlarge rq_feat0 tot
    for i ulong tot bound 65000
      put rq_feat0 i 0.0f64
    end
  else
    _e = enlarge rq_feat1 tot
    for i ulong tot bound 65000
      put rq_feat1 i 0.0f64
    end
  end
end

fn rq_narma_put_u_col sp ulong n ulong ncol ulong nsc ulong uoff ulong to void
  for r0 ulong n bound 1000
    uv = get mat_re add uoff r0
    idx = add mul add r0 1 ncol nsc
    if eq sp 0
      put rq_feat0 idx uv
    else
      put rq_feat1 idx uv
    end
  end
end

fn rq_narma_store_feat sp ulong nvalid ulong n ulong M ulong squares bool uoff ulong to void
  nsc = mul 5 M
  if squares
    nsc = mul nsc 2
  end
  ncol = add nsc 1
  rq_narma_zero_feat sp mul add n 1 ncol
  for r0 ulong nvalid bound 1000
    rq_narma_store_feat_row sp r0 ncol M squares
  end
  rq_narma_put_u_col sp n ncol nsc uoff
end

fn rq_narma_store_yb sp ulong ord ulong n ulong yb view f64 1000 to void
  base = mul ord 1000
  for i ulong n bound 1000
    if eq sp 0
      put rq_ys0 add base i get yb i
    else
      put rq_ys1 add base i get yb i
    end
  end
end

fn rq_narma_gen_ys sp ulong uoff ulong n ulong to void
  ub = new f64 1000 0.0f64
  yb = new f64 1000 0.0f64
  for i ulong n bound 1000
    put ub i get mat_re add uoff i
  end
  for ord_i ulong 9 bound 9
    ord = add ord_i 2
    rc_narma_g view ub uint n uint ord yb
    rq_narma_store_yb sp ord n view yb
  end
end

fn rq_narma_push_steps i ulong M ulong ns ulong to ulong
  cur = ns
  im = mul i M
  for k0 ulong M bound 8
    put rc_steps cur mul add im add k0 1 100
    cur = add cur 1
  end
  ret cur
end

fn rq_narma_build_steps n ulong kn ulong M ulong out_nv edit ulong 1 to ulong
  last = mul sub kn 1 ulong RQ_STEPS_PER_KNOT
  _e = enlarge rc_steps mul n M
  ns = ulong 0
  nvalid = ulong 0
  for i0 ulong n bound 1000
    i = add i0 1
    top = mul add mul i M M 100
    if gt top last
      break
    end
    ns = rq_narma_push_steps i M ns
    nvalid = add nvalid 1
  end
  put out_nv 0 nvalid
  ret ns
end

fn rq_narma_sim_exec sp ulong kn ulong ns ulong t view uint 514 p view uint 265 to void
  _e = enlarge rc_vout mul ns 5
  smeta = new uint 4 0
  put smeta 0 RES_INIT_N0
  put smeta 1 0
  put smeta 2 uint kn
  put smeta 3 uint ns
  rc = new uint 130 0
  ms = new uint 200 0
  st = rc_simulate_run t p view smeta rc ms
  rq_save_run_rec sp st view rc view ms
end

fn rq_narma_run_split sp ulong sig view ulong 5 t view uint 514 p view uint 265 M ulong squares bool to void
  n = get sig 3
  kn = get sig 4
  _e = enlarge rc_tab mul kn 5
  put rq_meta 16 get sig 1
  put rq_meta 17 get sig 2
  put rq_meta 18 kn
  for k ulong kn bound 200000
    rq_narma_fill_tab_one k
  end
  rq_narma_read_masks sp get sig 0 get sig 1 n kn M
  nv_b = new ulong 1 0
  ns = rq_narma_build_steps n kn M nv_b
  rq_narma_sim_exec sp kn ns t p
  rq_narma_store_feat sp get nv_b 0 n M squares get sig 0
  rq_narma_gen_ys sp get sig 0 n
end

fn rq_narma_col_is_zero c ulong ncol ulong to bool
  for r0 ulong 896 bound 896
    if ne get rq_feat0 add mul add 99 r0 ncol c 0.0f64
      ret false
    end
  end
  ret true
end

fn rq_narma_copy_xf_row r ulong ncol ulong nk ulong to void
  sb = mul add 99 r ncol
  db = mul r nk
  for c ulong nk bound 64
    kc = ulong get rq_keep c
    put rq_xf0 add db c get rq_feat0 add sb kc
    put rq_xf1 add db c get rq_feat1 add sb kc
  end
end

fn rq_narma_filter_cols ncol ulong to ulong
  nk = ulong 0
  nd = ulong 0
  for c ulong ncol bound 64
    if rq_narma_col_is_zero c ncol
      put rq_drop nd uint c
      nd = add nd 1
    else
      put rq_keep nk uint c
      nk = add nk 1
    end
  end
  put rq_meta 6 nk
  put rq_meta 7 nd
  _e = enlarge rq_xf0 mul 896 nk
  _e = enlarge rq_xf1 mul 896 nk
  for r ulong 896 bound 896
    rq_narma_copy_xf_row r ncol nk
  end
  ret nk
end

fn rq_narma_emit_masks sp ulong M ulong to void
  for i ulong 5 bound 5
    if gt i 0
      rc_puts rb_s_comma
    end
    rc_putc uchar 91
    for k ulong M bound 8
      if gt k 0
        rc_puts rb_s_comma
      end
      rc_put_u64 ulong get rq_mask_b add mul sp 40 add mul i 8 k
    end
    rc_putc uchar 93
  end
end

fn rq_narma_emit_hdr_a var_id ulong M ulong eps f32 to void
  rc_puts rq_gn_0
  if eq var_id 0
    rc_puts rq_var_n1a
  else
    if eq var_id 1
      rc_puts rq_var_n1b
    else
      if eq var_id 2
        rc_puts rq_var_n1bv2
      else
        rc_puts rq_var_ncn
      end
    end
  end
  rc_puts rq_gn_1
  if eq var_id 3
    rc_puts rq_gn_ncn
  else
    rc_puts rc_s_false
  end
  rc_puts rq_gn_2
  if eq var_id 2
    rc_puts rq_gn_ref_v2
  else
    rc_puts rq_gn_ref_v1
  end
  rc_puts rq_gn_3
  rc_put_u64 5
  rc_puts rq_gn_4
  rq_jd get rq_f64s 4
  rc_puts rq_gn_5
  rc_put_u64 M
  rc_puts rq_gn_6
  rq_jd get rq_f64s 5
  rc_puts rq_gn_7
  if or eq var_id 1 eq var_id 2
    rc_puts rq_gn_fv2
  else
    rc_puts rq_gn_fv1
  end
  rc_puts rq_gn_8
  rc_put_u64 get rq_meta 0
  rc_puts rq_gn_9
  rc_put_u64 add get rq_meta 1 1
  rc_puts rq_gn_a
  rq_put_bool ne get rq_meta 2 0
  rc_puts rq_gn_b
  rq_put_bool ne get rq_meta 3 0
  rc_puts rq_gn_c
  rq_put_bool ne get rq_meta 4 0
  rc_puts rq_gn_d
  rc_put_f64 f64 RQ_STEP_S 9
  rc_puts rq_gn_e
  rc_put_u64 ulong RQ_STEPS_PER_KNOT
  rc_puts rq_gn_f
  rc_put_f64 f64 eps 9
end

fn rq_narma_emit_hdr_b M ulong kn ulong ncol ulong to void
  rc_puts rq_gn_10
  rc_put_u64 kn
  rc_puts rq_gn_11
  rq_jd get rq_f64s 0
  rc_puts rq_gn_12
  rq_jd get rq_f64s 1
  rc_puts rq_gn_13
  rq_jd get rq_f64s 2
  rc_puts rq_gn_14
  rq_jd get rq_f64s 3
  rc_puts rq_gn_15
  rq_narma_emit_masks 0 M
  rc_puts rq_gn_16
  rq_narma_emit_masks 1 M
  rc_puts rq_gn_17
  rc_put_u64 ulong get rq_mask_inc 0
  rc_puts rb_s_comma
  rc_put_u64 ulong get rq_mask_inc 1
  rc_puts rq_gn_18
  meq = true
  for i ulong 40 bound 40
    if ne get rq_mask_b i get rq_mask_b add 40 i
      meq = false
    end
  end
  rq_put_bool meq
  rc_puts rq_gn_19
  rq_receipt_json 0
  rc_puts rb_s_comma
  rq_receipt_json 1
  rc_puts rq_gn_1a
  rc_put_u64 ncol
  rc_puts rq_gn_1b
  nd = get rq_meta 7
  for k ulong nd bound 64
    if gt k 0
      rc_puts rb_s_comma
    end
    rc_put_u64 ulong get rq_drop k
  end
end

fn rq_narma_emit_col_rms nk ulong to void
  for c ulong nk bound 64
    s = 0.0f64
    for r ulong 896 bound 896
      v = get rq_xf0 add mul r nk c
      s = add s mul v v
    end
    if gt c 0
      rc_puts rb_s_comma
    end
    rq_jd fsqrt div s 896.0f64
  end
end

fn rq_narma_emit_subpulse_rms M ulong ncol ulong to void
  for node ulong 5 bound 5
    s = 0.0f64
    c0 = mul node M
    c1 = add c0 sub M 1
    for r0 ulong 896 bound 896
      rb = mul add 99 r0 ncol
      v1 = get rq_feat0 add rb c1
      v0 = get rq_feat0 add rb c0
      d = sub v1 v0
      s = add s mul d d
    end
    if gt node 0
      rc_puts rb_s_comma
    end
    rq_jd fsqrt div s 896.0f64
  end
end

fn rq_narma_emit_hdr_c M ulong ncol ulong nk ulong to void
  argp = new ulong 1 0
  mpr = rq_design_min_pivot_ratio 896 nk argp
  rc_puts rq_gn_1c
  rq_narma_emit_col_rms nk
  rc_puts rq_gn_1d
  rq_narma_emit_subpulse_rms M ncol
  rc_puts rq_gn_1e
  rq_jd mpr
  rc_puts rq_gn_1f
  rc_put_u64 get argp 0
  rc_puts rq_gn_20
  rc_put_f64 RQ_TOL_TARGET_ABS 6
  rc_puts rq_cfg_7
  rc_put_f64 RQ_TOL_PRED_REL 6
  rc_puts rq_cfg_8
  rc_put_f64 RQ_TOL_NRMSE_ABS 6
  rc_puts rq_cfg_9
  rc_put_f64 RQ_TOL_NRMSE_REL 6
  rc_puts rq_cfg_a
  rc_put_f64 RQ_TOL_METRIC_REL 6
  rc_puts rq_gn_21
end

fn rq_narma_load_xf0_row r ulong nk ulong xrow edit f64 256 to void
  rb = mul r nk
  for c ulong nk bound 64
    put xrow c get rq_xf0 add rb c
  end
end

fn rq_narma_fit_ldl yoff ulong nk ulong ro edit ulong 1031 to int
  ws = new ulong 67334 0
  res_ro_ws_zero ws nk
  xrow = new f64 256 0.0f64
  yrow = new f64 4 0.0f64
  for r ulong 896 bound 896
    rq_narma_load_xf0_row r nk xrow
    put yrow 0 get rq_ys0 add yoff r
    st = res_ro_ws_accum_row ws view xrow view yrow nk 1
    if ne st RES_OK
      ret st
    end
  end
  meta = new ulong 4 0
  put meta 0 896
  put meta 1 nk
  put meta 2 1
  put meta 3 bitcast ulong 0.0f64
  st = res_ro_ws_finish ws view meta
  if eq st RES_OK
    res_readout_extract view ws view meta ro
  end
  ret st
end

fn rq_narma_load_qr_row sp ulong r ulong nk ulong xrow edit f64 256 to f64
  rb = mul r nk
  q = get rc_qr_w 0
  for c ulong nk bound 64
    xv = 0.0f64
    if eq sp 0
      xv = get rq_xf0 add rb c
    else
      xv = get rq_xf1 add rb c
    end
    put xrow c xv
    q = add q mul xv get rc_qr_w add c 1
  end
  ret q
end

fn rq_narma_apply_preds sp ulong nk ulong st int ro view ulong 1031 to void
  nanv = bitcast f64 ulong 0x7ff8000000000000
  xrow = new f64 256 0.0f64
  yrow = new f64 4 0.0f64
  for r ulong 896 bound 896
    put rq_pqr r rq_narma_load_qr_row sp r nk xrow
    if eq st RES_OK
      if eq res_readout_apply ro view xrow yrow RES_OK
        put rq_pred r get yrow 0
      else
        put rq_pred r nanv
      end
    else
      put rq_pred r nanv
    end
  end
end

fn rq_narma_ys_get sp ulong idx ulong to f64
  if eq sp 0
    ret get rq_ys0 idx
  end
  ret get rq_ys1 idx
end

fn rq_narma_metrics_means sp ulong yoff ulong yaoff ulong m_out edit f64 7 to void
  tdiff = 0.0f64
  mya = 0.0f64
  my = 0.0f64
  for r ulong 896 bound 896
    yv = rq_narma_ys_get sp add yoff r
    ya = get mat_re add yaoff r
    d = rc_abs64 sub yv ya
    if not le d tdiff
      tdiff = d
    end
    mya = add mya ya
    my = add my yv
  end
  put m_out 0 tdiff
  put m_out 1 div mya 896.0f64
  put m_out 2 div my 896.0f64
end

fn rq_narma_rms_pred paoff ulong to f64
  s_pr = 0.0f64
  for r ulong 896 bound 896
    pr = get rq_pred r
    pa = get mat_re add paoff r
    d = sub pr pa
    s_pr = add s_pr mul d d
  end
  ret fsqrt div s_pr 896.0f64
end

fn rq_narma_metrics_a1 yaoff ulong paoff ulong m_out edit f64 7 to void
  mya = get m_out 1
  s_sd = 0.0f64
  s_arch = 0.0f64
  for r ulong 896 bound 896
    ya = get mat_re add yaoff r
    d = sub ya mya
    s_sd = add s_sd mul d d
    pa = get mat_re add paoff r
    d = sub ya pa
    s_arch = add s_arch mul d d
  end
  sd = fsqrt div s_sd 896.0f64
  put m_out 3 fsqrt div s_arch s_sd
  put m_out 4 sd
  put m_out 1 div rq_narma_rms_pred paoff sd
end

fn rq_narma_metrics_a2 sp ulong yoff ulong m_out edit f64 7 to void
  my = get m_out 2
  s_nr_n = 0.0f64
  s_nr_d = 0.0f64
  for r ulong 896 bound 896
    yv = rq_narma_ys_get sp add yoff r
    d = sub yv get rq_pred r
    s_nr_n = add s_nr_n mul d d
    d = sub yv my
    s_nr_d = add s_nr_d mul d d
  end
  put m_out 2 fsqrt div s_nr_n s_nr_d
  put m_out 5 s_nr_d
end

fn rq_narma_metrics_qr1 paoff ulong m_out edit f64 7 to void
  s_qpr = 0.0f64
  qdiff = 0.0f64
  for r ulong 896 bound 896
    qr = get rq_pqr r
    d = sub qr get mat_re add paoff r
    s_qpr = add s_qpr mul d d
    qd = rc_abs64 sub get rq_pred r qr
    if not le qd qdiff
      qdiff = qd
    end
  end
  sd = get m_out 4
  put m_out 4 div qdiff sd
  put m_out 6 div fsqrt div s_qpr 896.0f64 sd
end

fn rq_narma_metrics_qr sp ulong yoff ulong paoff ulong m_out edit f64 7 to void
  rq_narma_metrics_qr1 paoff m_out
  s_qnr = 0.0f64
  for r ulong 896 bound 896
    d = sub rq_narma_ys_get sp add yoff r get rq_pqr r
    s_qnr = add s_qnr mul d d
  end
  qpr = get m_out 6
  s_nr_d = get m_out 5
  put m_out 5 qpr
  put m_out 6 fsqrt div s_qnr s_nr_d
end

fn rq_narma_metrics_sp sp ulong ord ulong m_out edit f64 7 to void
  yoff = add mul ord 1000 99
  yaoff = get rq_meta add 20 sp
  paoff = get rq_meta add 22 sp
  rq_narma_metrics_means sp yoff yaoff m_out
  rq_narma_metrics_a1 yaoff paoff m_out
  rq_narma_metrics_a2 sp yoff m_out
  rq_narma_metrics_qr sp yoff paoff m_out
end

fn rq_narma_split_flags st int nref f64 m view f64 7 flags edit uint 4 to void
  infv = bitcast f64 ulong 0x7ff0000000000000
  prel = infv
  nr = infv
  if eq st RES_OK
    prel = get m 1
    nr = get m 2
  end
  a = le get m 0 RQ_TOL_TARGET_ABS
  b = le prel RQ_TOL_PRED_REL
  c = rq_nrmse_ok nr nref
  pm = rq_rel_ok get m 3 nref RQ_TOL_METRIC_REL
  if not a
    put flags 0 0
  end
  if not b
    put flags 1 0
  end
  if not c
    put flags 2 0
  end
  if not pm
    put flags 3 0
  end
  rc_puts rq_gn_sa
  rq_put_bool a
  rc_puts rq_gn_s8
  rq_put_bool b
  rc_puts rq_gn_s9
  rq_put_bool c
  rc_puts rq_gn_sb
  rq_put_bool pm
  rc_putc uchar 125
end

fn rq_narma_emit_split sp ulong st int qr int nref f64 m view f64 7 flags edit uint 4 to void
  infv = bitcast f64 ulong 0x7ff0000000000000
  rc_puts rq_gn_s0
  if eq sp 0
    rc_puts rq_s_train
  else
    rc_puts rq_s_test
  end
  rc_puts rq_gn_s1
  rq_jd get m 0
  rc_puts rq_gn_s2
  if eq st RES_OK
    rq_jd get m 1
  else
    rq_jd infv
  end
  rc_puts rq_gn_s3
  if eq st RES_OK
    rq_jd get m 2
  else
    rq_jd infv
  end
  rc_puts rq_gn_s4
  rq_jd nref
  rc_puts rq_gn_s5
  rq_jd get m 3
  rc_puts rq_gn_s6
  if and eq st RES_OK eq qr 0
    rq_jd get m 4
  else
    rq_jd infv
  end
  qprel = infv
  qnr = infv
  if eq qr 0
    qprel = get m 5
    qnr = get m 6
  end
  rc_puts rq_gn_s7
  rq_jd qprel
  rc_puts rq_gn_s3
  rq_jd qnr
  rc_puts rq_gn_s8
  rq_put_bool le qprel RQ_TOL_PRED_REL
  rc_puts rq_gn_s9
  rq_put_bool rq_nrmse_ok qnr nref
  rc_putc uchar 125
  rq_narma_split_flags st nref m flags
end

fn rq_narma_order_cells ord ulong ya edit ulong 2 pa edit ulong 2 to int
  sub4 = new ulong 4 0
  put sub4 3 sub ord 1
  o_tmp = new ulong 1 0
  for sp ulong 2 bound 2
    yc = res_mat_cell_at get rq_cells sp view sub4 4
    pc = res_mat_cell_at get rq_cells add 2 sp view sub4 4
    if ne res_mat_values yc 896 o_tmp RES_MAT_OK
      ret 2
    end
    put ya sp get o_tmp 0
    if ne res_mat_values pc 896 o_tmp RES_MAT_OK
      ret 2
    end
    put pa sp get o_tmp 0
  end
  ret 0
end

fn rq_narma_fit_ldl_global yoff ulong nk ulong to int
  ro = new ulong 1031 0
  st = rq_narma_fit_ldl yoff nk ro
  for i ulong 1031 bound 1031
    put rq_ro i get ro i
  end
  ret st
end

fn rq_narma_apply_global sp ulong nk ulong st int to void
  ro = new ulong 1031 0
  for i ulong 1031 bound 1031
    put ro i get rq_ro i
  end
  rq_narma_apply_preds sp nk st view ro
end

fn rq_narma_nref sp ulong ord ulong to f64
  idx = add get rq_nroffs sp mul 64 sub ord 1
  ret get mat_re idx
end

fn rq_narma_order_sp sp ulong ord ulong nk ulong st int qr int flags edit uint 4 to void
  m = new f64 7 0.0f64
  rq_narma_apply_global sp nk st
  rq_narma_metrics_sp sp ord m
  rq_narma_emit_split sp st qr rq_narma_nref sp ord view m flags
end

fn rq_narma_order_step ord ulong nk ulong status_io edit uint 2 to int
  ya = new ulong 2 0
  pa = new ulong 2 0
  if ne rq_narma_order_cells ord ya pa 0
    ret 2
  end
  put rq_meta 20 get ya 0
  put rq_meta 21 get ya 1
  put rq_meta 22 get pa 0
  put rq_meta 23 get pa 1
  yoff = add mul ord 1000 99
  st = rq_narma_fit_ldl_global yoff nk
  qr = rq_ols_qr 0 yoff 896 nk
  if gt ord 2
    rc_putc uchar 44
  end
  rc_puts rq_gn_o0
  rc_put_u64 ord
  rc_puts rq_gn_o1
  rc_status_puts st
  rc_puts rq_gn_o2
  rq_put_bool eq qr 0
  rc_puts rq_gn_o3
  rq_jd rq_qr_sensitivity yoff 896 nk 1.0e-6f64
  flags = new uint 4 1
  rq_narma_order_sp 0 ord nk st qr flags
  rq_narma_order_sp 1 ord nk st qr flags
  pass = eq st RES_OK
  if eq get flags 0 0
    pass = false
  end
  if eq get flags 1 0
    pass = false
  end
  if eq get flags 2 0
    pass = false
  end
  if ne st RES_OK
    put status_io 1 1
  end
  if eq get flags 3 0
    put status_io 0 0
  end
  if not pass
    put status_io 0 0
  end
  rc_puts rq_gn_op
  rq_put_bool pass
  rc_putc uchar 125
  ret 0
end

fn rq_narma_variant_id v view uchar * vlen ulong ac ulong to long
  if rq_streq v vlen rq_var_n1a
    if eq ac 4
      ret 0
    end
    ret -1
  end
  if rq_streq v vlen rq_var_n1b
    if eq ac 4
      ret 1
    end
    ret -1
  end
  if rq_streq v vlen rq_var_n1bv2
    if eq ac 5
      ret 2
    end
    ret -1
  end
  if rq_streq v vlen rq_var_ncn
    if eq ac 4
      ret 3
    end
    ret -1
  end
  ret -1
end

fn rq_narma_load_res_meta mvals edit ulong 3 to int
  put rq_cells 0 rq_mf_find 3 rq_mv_ytrc
  put rq_cells 1 rq_mf_find 3 rq_mv_ytec
  put rq_cells 2 rq_mf_find 3 rq_mv_ptrc
  put rq_cells 3 rq_mf_find 3 rq_mv_ptec
  for k ulong 4 bound 4
    if lt get rq_cells k 0
      ret -1
    end
  end
  o = new ulong 1 0
  if ne res_mat_values rq_mf_find 3 rq_mv_nrtr 640 o RES_MAT_OK
    ret -1
  end
  put rq_nroffs 0 get o 0
  if ne res_mat_values rq_mf_find 3 rq_mv_nrte 640 o RES_MAT_OK
    ret -1
  end
  put rq_nroffs 1 get o 0
  if ne res_mat_values rq_mf_find 3 rq_mv_spatial 4 o RES_MAT_OK
    ret -1
  end
  put mvals 0 get o 0
  if ne res_mat_values rq_mf_find 3 rq_mv_cur 4 o RES_MAT_OK
    ret -1
  end
  put mvals 1 get o 0
  if ne res_mat_values rq_mf_find 3 rq_mv_mask 4 o RES_MAT_OK
    ret -1
  end
  put mvals 2 get o 0
  ret 0
end

fn rq_save_tp t view uint 514 p view uint 265 to void
  for i ulong 514 bound 514
    put rq_tbuf i get t i
  end
  for i ulong 265 bound 265
    put rq_pbuf i get p i
  end
end

fn rq_load_tp t edit uint 514 p edit uint 265 to void
  for i ulong 514 bound 514
    put t i get rq_tbuf i
  end
  for i ulong 265 bound 265
    put p i get rq_pbuf i
  end
end

fn rq_narma_setup_tp control bool to int
  o = new ulong 1 0
  if ne res_mat_values rq_mf_find 0 rq_mv_conmat 25 o RES_MAT_OK
    rc_err_puts rq_err_nvars
    ret 2
  end
  cmo = get o 0
  if ne res_mat_values rq_mf_find 0 rq_mv_ground 1 o RES_MAT_OK
    rc_err_puts rq_err_nvars
    ret 2
  end
  gro = get o 0
  if ne res_mat_values rq_mf_find 0 rq_mv_inex 25 o RES_MAT_OK
    rc_err_puts rq_err_nvars
    ret 2
  end
  ixo = get o 0
  t = new uint 514 0
  p = new uint 265 0
  st = rq_narma_build_cfg cmo gro ixo control t p
  if ne st RES_OK
    rc_err_puts rq_err_cfg
    ret 2
  end
  cs = rq_narma_check_chain_same view t view p
  if eq cs 2
    rc_err_puts rq_err_cfg
    ret 2
  end
  put rq_meta 4 cs
  rq_save_tp view t view p
  ret 0
end

fn rq_narma_run_both vid ulong M ulong to int
  sig0 = new ulong 5 0
  sig1 = new ulong 5 0
  if ne rq_narma_parse_sig 1 0 5 sig0 0
    rc_err_puts rq_err_nsig
    ret 2
  end
  if ne rq_narma_parse_sig 2 1 5 sig1 0
    rc_err_puts rq_err_nsig
    ret 2
  end
  kn = mul mul 1000 M 10
  bad_s = false
  if ne get sig0 3 1000
    bad_s = true
  end
  if ne get sig1 3 1000
    bad_s = true
  end
  if ne get sig0 4 kn
    bad_s = true
  end
  if ne get sig1 4 kn
    bad_s = true
  end
  if bad_s
    rc_err_puts rq_err_nsig
    ret 2
  end
  put rq_f64s 0 0.0f64
  put rq_f64s 1 0.0f64
  put rq_f64s 2 bitcast f64 ulong 0x7ff0000000000000
  put rq_f64s 3 bitcast f64 ulong 0xfff0000000000000
  t = new uint 514 0
  p = new uint 265 0
  rq_load_tp t p
  sq = or eq vid 1 eq vid 2
  rq_narma_run_split 0 view sig0 view t view p M sq
  rq_narma_run_split 1 view sig1 view t view p M sq
  ncol = add mul 5 M 1
  if sq
    ncol = add mul 10 M 1
  end
  nk = rq_narma_filter_cols ncol
  rq_narma_emit_hdr_a vid M bitcast f32 get p 1
  rq_narma_emit_hdr_b M kn ncol
  rq_narma_emit_hdr_c M ncol nk
  put rq_meta 8 nk
  ret 0
end

fn rq_run_g2_narma root view uchar 512 var view uchar 64 v2p view uchar 512 lens view ulong 3 ac ulong to int
  vid = rq_narma_variant_id view var get lens 1 ac
  if lt vid 0
    ret 2
  end
  rlen = get lens 0
  res_mat_reset_pool
  if ne rq_load_pinned_slot view root rlen RQ_PIN_NARMA_LEN5 0 0
    ret 2
  end
  if ne rq_load_pinned_slot view root rlen RQ_PIN_NARMA_TR 1 0
    ret 2
  end
  if ne rq_load_pinned_slot view root rlen RQ_PIN_NARMA_TE 2 0
    ret 2
  end
  if eq vid 2
    if ne rq_load_v2_slot view v2p get lens 2 3 0
      ret 2
    end
  else
    if ne rq_load_pinned_slot view root rlen RQ_PIN_NARMA_RES 3 0
      ret 2
    end
  end
  mvals = new ulong 3 0
  if ne rq_narma_load_res_meta mvals 0
    rc_err_puts rq_err_nvars
    ret 2
  end
  M = ulong get mat_re get mvals 2
  if or lt M 1 gt M 8
    rc_err_puts rq_err_nvars
    ret 2
  end
  put rq_f64s 4 get mat_re get mvals 1
  put rq_f64s 5 get mat_re get mvals 0
  if ne rq_narma_setup_tp eq vid 3 0
    ret 2
  end
  if ne rq_narma_run_both ulong vid M 0
    ret 2
  end
  nk = get rq_meta 8
  st_io = new uint 2 0
  all_ok = eq bitcast int get rq_rst 0 RES_OK
  if ne bitcast int get rq_rst 1 RES_OK
    all_ok = false
  end
  if eq get rq_meta 2 0
    all_ok = false
  end
  if eq get rq_meta 3 0
    all_ok = false
  end
  if all_ok
    put st_io 0 1
  end
  for ord_i ulong 9 bound 9
    rc = rq_narma_order_step add ord_i 2 nk st_io
    if ne rc 0
      ret rc
    end
  end
  rc_puts rq_gn_end
  rq_put_bool ne get st_io 1 0
  rc_puts rq_gn_v0
  if ne get st_io 0 0
    rc_puts rq_pins_pass
    rc_flush
    ret 0
  end
  rc_puts rq_pins_fail
  rc_flush
  ret 1
end

note ================================================================
note G2-L1 subcommand
note ================================================================

fn rq_lz_parse_data slot ulong info edit ulong 3 to int
  ix = rq_mf_find slot rq_mv_X
  it = rq_mf_find slot rq_mv_t
  o = new ulong 1 0
  if ne res_mat_values ix 0 o RES_MAT_OK
    ret -1
  end
  put info 0 get o 0
  if ne res_mat_values it 0 o RES_MAT_OK
    ret -1
  end
  toff = get o 0
  put info 1 toff
  n = rq_mat_meta_get ix 8
  if lt n 2
    ret -1
  end
  if ne rq_mat_meta_get ix 9 3
    ret -1
  end
  if ne rq_mat_meta_get it 5 n
    ret -1
  end
  for j0 ulong sub n 1 bound 200000
    v1 = get mat_re add toff add j0 1
    v0 = get mat_re add toff j0
    if not gt v1 v0
      ret -1
    end
  end
  put info 2 n
  ret 0
end

fn rq_lz_interp_col toff ulong col_off ulong n ulong tv f64 hint edit ulong 1 to f64
  j = get hint 0
  if ge add j 1 n
    j = sub n 2
  end
  while gt j 0 bound 200000
    if gt get mat_re add toff j tv
      j = sub j 1
    else
      break
    end
  end
  while lt add j 2 n bound 200000
    if lt get mat_re add toff add j 1 tv
      j = add j 1
    else
      break
    end
  end
  put hint 0 j
  t0 = get mat_re add toff j
  t1 = get mat_re add toff add j 1
  c0 = get mat_re add col_off j
  c1 = get mat_re add col_off add j 1
  ret add c0 div mul sub tv t0 sub c1 c0 sub t1 t0
end

fn rq_lz_interp_cur toff ulong n ulong tv f64 hint edit ulong 1 to f64
  j = get hint 0
  if ge add j 1 n
    j = sub n 2
  end
  while gt j 0 bound 200000
    if gt get mat_re add toff j tv
      j = sub j 1
    else
      break
    end
  end
  while lt add j 2 n bound 200000
    if lt get mat_re add toff add j 1 tv
      j = add j 1
    else
      break
    end
  end
  put hint 0 j
  t0 = get mat_re add toff j
  t1 = get mat_re add toff add j 1
  c0 = get rq_lcur j
  c1 = get rq_lcur add j 1
  ret add c0 div mul sub tv t0 sub c1 c0 sub t1 t0
end

fn rq_lz_check_bp_j c ulong j ulong to void
  x = mul get mat_re add get rq_meta 16 j 10000.0f64
  kk = ulong x
  if ge kk 400000
    kk = 399999
  end
  L = get rq_meta 18
  inpc = get rq_meta 19
  a = f64 get rc_tab add mul kk L inpc
  b = f64 get rc_tab add mul add kk 1 L inpc
  interp = add a mul sub x f64 kk sub b a
  er = rc_abs64 sub interp get rq_lcur j
  if gt er get rq_f64s c
    put rq_f64s c er
  end
end

fn rq_lz_check_bp c ulong to void
  dn = get rq_meta 17
  for j ulong dn bound 200000
    rq_lz_check_bp_j c j
  end
end

fn rq_lz_fill_knots c ulong to void
  toff = get rq_meta 16
  dn = get rq_meta 17
  L = get rq_meta 18
  inpc = get rq_meta 19
  hint = new ulong 1 0
  for k ulong 400001 bound 400001
    iv = rq_lz_interp_cur toff dn div f64 k 10000.0f64 hint
    fv = f32 iv
    put rc_tab add mul k L inpc fv
    er = rc_abs64 sub f64 fv iv
    if gt er get rq_f64s c
      put rq_f64s c er
    end
    ai = rc_abs64 iv
    if gt ai get rq_f64s add 3 c
      put rq_f64s add 3 c ai
    end
  end
end

fn rq_lz_fill_chan c ulong xoff ulong toff ulong dn ulong L ulong inpc ulong to void
  _e = enlarge rq_lcur dn
  for j ulong dn bound 200000
    xv = get mat_re add xoff add j mul dn c
    put rq_lcur j rb_lz_current xv c
  end
  put rq_meta 16 toff
  put rq_meta 17 dn
  put rq_meta 18 L
  put rq_meta 19 inpc
  rq_lz_fill_knots c
  rq_lz_check_bp c
end

fn rq_lz_interp_target_loop sp ulong c ulong coff ulong tsoff ulong nts ulong to void
  toff = get rq_ld0 1
  dn = get rq_ld0 2
  if ne sp 0
    toff = get rq_ld1 1
    dn = get rq_ld1 2
  end
  hint = new ulong 1 0
  for k ulong nts bound 100000
    tv = get mat_re add tsoff k
    val = rq_lz_interp_col toff coff dn tv hint
    idx = add mul k 3 c
    if eq sp 0
      put rq_lt0 idx val
    else
      put rq_lt1 idx val
    end
  end
end

fn rq_lz_interp_target_c sp ulong c ulong to void
  if eq sp 0
    coff = add get rq_ld0 0 mul get rq_ld0 2 c
    rq_lz_interp_target_loop 0 c coff get rq_loffs 0 get rq_loffs 1
  else
    coff = add get rq_ld1 0 mul get rq_ld1 2 c
    rq_lz_interp_target_loop 1 c coff get rq_loffs 2 get rq_loffs 3
  end
end

fn rq_lz_interp_targets sp ulong dinfo view ulong 3 tsoff ulong nts ulong to void
  for c ulong 3 bound 3
    rq_lz_interp_target_c sp c
  end
end

fn rq_lz_copy_vout sp ulong nts ulong L ulong g ulong to void
  if eq sp 0
    _e = enlarge rq_lv0 mul nts L
    _e = enlarge rq_lt0 mul nts 3
    for i ulong mul nts L bound 5000000
      put rq_lv0 i get rc_vout i
    end
    for k ulong nts bound 100000
      put rq_lv0 add mul k L g 0.0f64
    end
  else
    _e = enlarge rq_lv1 mul nts L
    _e = enlarge rq_lt1 mul nts 3
    for i ulong mul nts L bound 5000000
      put rq_lv1 i get rc_vout i
    end
    for k ulong nts bound 100000
      put rq_lv1 add mul k L g 0.0f64
    end
  end
end

fn rq_lz_zero_tab L ulong to void
  _e = enlarge rc_tab mul 400001 L
  for i ulong mul 400001 L bound 20000000
    put rc_tab i 0.0f32
  end
end

fn rq_lz_fill_pos tsoff ulong nts ulong to void
  _e = enlarge rc_pos nts
  for k ulong nts bound 100000
    put rc_pos k mul get mat_re add tsoff k 1.0e5f64
  end
end

fn rq_lz_prep_tab_pos dinfo view ulong 3 tsoff ulong nts ulong L ulong inp view uint 3 to void
  rq_lz_zero_tab L
  for c ulong 3 bound 3
    rq_lz_fill_chan c get dinfo 0 get dinfo 1 get dinfo 2 L ulong get inp c
  end
  rq_lz_fill_pos tsoff nts
end

fn rq_lz_exec_sim sp ulong nts ulong L ulong t view uint 514 p view uint 265 to void
  _e = enlarge rc_vout mul nts L
  last = ulong 4000000
  st = rc_sim_init_globals t p RES_INIT_CONST 1.0f32
  if eq st RES_OK
    st = rc_sim_at_positions uint L 400001 nts last
  end
  if eq st RES_OK
    cur = rc_sim_get_step
    if lt cur last
      st = rc_sim_advance_obs uint L 400001 sub last cur
    end
  end
  rc = new uint 130 0
  if eq st RES_OK
    st = rc_sim_receipt uint L 400001 rc
  end
  ms = new uint 200 0
  for i ulong 200 bound 200
    put ms i get rc_ws add RES_WS_MSTATS i
  end
  rq_save_run_rec sp st view rc view ms
end

fn rq_lz_sim_split dinfo view ulong 3 smeta view ulong 4 t view uint 514 p view uint 265 inp view uint 3 to void
  sp = get smeta 0
  tsoff = get smeta 1
  nts = get smeta 2
  L = ulong get t 0
  rq_lz_prep_tab_pos dinfo tsoff nts L inp
  rq_lz_exec_sim sp nts L t p
  rq_lz_copy_vout sp nts L get smeta 3
  rq_lz_interp_targets sp dinfo tsoff nts
end

fn rq_lz_col_bounds i ulong n0 ulong L ulong out2 edit f64 2 to void
  lo = get rq_lv0 i
  hi = lo
  for k ulong n0 bound 100000
    v = get rq_lv0 add mul k L i
    if lt v lo
      lo = v
    end
    if gt v hi
      hi = v
    end
  end
  put out2 0 lo
  rg = sub hi lo
  if eq rg 0.0f64
    rg = 1.0f64
  end
  put out2 1 rg
end

fn rq_lz_scale_sp sp ulong i ulong n ulong L ulong lo f64 rg f64 to void
  for k ulong n bound 100000
    idx = add mul k L i
    if eq sp 0
      put rq_lv0 idx div sub get rq_lv0 idx lo rg
    else
      put rq_lv1 idx div sub get rq_lv1 idx lo rg
    end
  end
end

fn rq_lz_scale_col i ulong n0 ulong n1 ulong L ulong to void
  b2 = new f64 2 0.0f64
  rq_lz_col_bounds i n0 L b2
  rq_lz_scale_sp 0 i n0 L get b2 0 get b2 1
  rq_lz_scale_sp 1 i n1 L get b2 0 get b2 1
end

fn rq_lz_range_scale n0 ulong n1 ulong L ulong to void
  for i ulong L bound 64
    rq_lz_scale_col i n0 n1 L
  end
end

fn rq_lz_cv_save_row f ulong i ulong ws view ulong 67334 to void
  gb = add mul f 2116 mul i 46
  wb = mul i RES_RO_DIM
  for j ulong add i 1 bound 46
    v = get ws add wb j
    put rq_cv_g add gb j v
  end
  rb = add mul f 184 mul i 4
  wrb = add RES_RWS_R_OFF mul i 4
  for o ulong 3 bound 3
    v = get ws add wrb o
    put rq_cv_r add rb o v
  end
end

fn rq_lz_cv_precomp_fold f ulong n0 ulong L ulong to void
  v0 = rc_fold_edge f n0 5
  v1 = rc_fold_edge add f 1 n0 5
  ws = new ulong 67334 0
  res_ro_ws_zero ws L
  st = rc_ro_accum_ztr_skip ws n0 v0 v1 L 3
  if ne st RES_OK
    put rq_cv_ok f 0
    ret
  end
  put rq_cv_ok f 1
  for i ulong add L 1 bound 46
    rq_lz_cv_save_row f i view ws
  end
end

fn rq_lz_cv_load_row f ulong i ulong ws edit ulong 67334 to void
  gb = add mul f 2116 mul i 46
  wb = mul i RES_RO_DIM
  for j ulong add i 1 bound 46
    v = get rq_cv_g add gb j
    put ws add wb j v
  end
  rb = add mul f 184 mul i 4
  wrb = add RES_RWS_R_OFF mul i 4
  for o ulong 3 bound 3
    v = get rq_cv_r add rb o
    put ws add wrb o v
  end
end

fn rq_lz_cv_score_ro ro view ulong 1031 v0 ulong nv ulong L ulong to f64
  am = new ulong 5 0
  put am 0 0
  put am 1 v0
  put am 2 nv
  put am 3 L
  put am 4 3
  st = rc_ro_apply_global ro view am
  if ne st RES_OK
    ret -1.0f64
  end
  s = 0.0f64
  for c ulong 3 bound 3
    s = add s rc_nrmse_ytr_pv v0 nv 3 c
  end
  ret div s 3.0f64
end

fn rq_lz_cv_eval_fold f ulong n0 ulong L ulong lam f64 to f64
  if eq get rq_cv_ok f 0
    ret -1.0f64
  end
  v0 = rc_fold_edge f n0 5
  v1 = rc_fold_edge add f 1 n0 5
  ws = new ulong 67334 0
  for i ulong add L 1 bound 46
    rq_lz_cv_load_row f i ws
  end
  meta = new ulong 4 0
  put meta 0 sub n0 sub v1 v0
  put meta 1 L
  put meta 2 3
  put meta 3 bitcast ulong lam
  if ne res_ro_ws_finish ws view meta RES_OK
    ret -1.0f64
  end
  ro = new ulong 1031 0
  res_readout_extract view ws view meta ro
  ret rq_lz_cv_score_ro view ro v0 sub v1 v0 L
end

fn rq_lz_cv_eval_lam n0 ulong L ulong lam f64 refs_io edit ulong 1 to f64
  sc = 0.0f64
  for f ulong 5 bound 5
    fs = rq_lz_cv_eval_fold f n0 L lam
    if lt fs 0.0f64
      put refs_io 0 add get refs_io 0 1
      ret -1.0f64
    end
    sc = add sc fs
  end
  ret div sc 5.0f64
end

fn rq_lz_cv_search n0 ulong L ulong to long
  best = bitcast f64 ulong 0x7ff0000000000000
  best_l = 0.0f64
  best_i = long -1
  refs = new ulong 1 0
  if eq bitcast int get rq_rst 0 RES_OK
    for f ulong 5 bound 5
      rq_lz_cv_precomp_fold f n0 L
    end
    for li ulong 101 bound 101
      lam = add 0.033f64 mul f64 li div sub 0.035f64 0.033f64 100.0f64
      sc = rq_lz_cv_eval_lam n0 L lam refs
      if ge sc 0.0f64
        if lt sc best
          best = sc
          best_l = lam
          best_i = long li
        end
      end
    end
  end
  put rq_f64s 6 best_l
  put rq_f64s 7 best
  put rq_meta 10 bitcast ulong best_i
  put rq_meta 11 get refs 0
  ret best_i
end

fn rq_lz_cv_final n0 ulong L ulong best_l f64 ro edit ulong 1031 to int
  ws = new ulong 67334 0
  res_ro_ws_zero ws L
  st = rc_ro_accum_ztr_skip ws n0 n0 n0 L 3
  if ne st RES_OK
    ret st
  end
  meta = new ulong 4 0
  put meta 0 n0
  put meta 1 L
  put meta 2 3
  put meta 3 bitcast ulong best_l
  st = res_ro_ws_finish ws view meta
  if eq st RES_OK
    res_readout_extract view ws view meta ro
  end
  ret st
end

fn rq_lz_cv_run n0 ulong L ulong ro edit ulong 1031 to int
  _e = enlarge rc_ztr mul n0 L
  _e = enlarge rc_ytr mul n0 3
  _e = enlarge rc_pv mul n0 3
  for i ulong mul n0 L bound 5000000
    put rc_ztr i get rq_lv0 i
  end
  for i ulong mul n0 3 bound 300000
    put rc_ytr i get rq_lt0 i
  end
  t0 = rc_now_s
  best_i = rq_lz_cv_search n0 L
  put rq_f64s 8 sub rc_now_s t0
  if lt best_i 0
    ret RES_ERR_SINGULAR
  end
  ret rq_lz_cv_final n0 L get rq_f64s 6 ro
end

fn rq_lz_mat_eq aoff ulong boff ulong n ulong to ulong
  for i ulong n bound 500000
    va = bitcast ulong get mat_re add aoff i
    vb = bitcast ulong get mat_re add boff i
    if ne va vb
      ret 0
    end
  end
  ret 1
end

fn rq_lz_emit_inp_errs to void
  rc_puts rq_gl_a
  rq_jd get rq_f64s 0
  rc_puts rb_s_comma
  rq_jd get rq_f64s 1
  rc_puts rb_s_comma
  rq_jd get rq_f64s 2
  rc_puts rq_gl_b
  rq_jd div get rq_f64s 0 get rq_f64s 3
  rc_puts rb_s_comma
  rq_jd div get rq_f64s 1 get rq_f64s 4
  rc_puts rb_s_comma
  rq_jd div get rq_f64s 2 get rq_f64s 5
end

fn rq_lz_emit_hdr hdr view ulong 4 control bool inp view uint 3 eps f32 to void
  rc_puts rq_gl_0
  rc_put_u64 get hdr 0
  rc_puts rq_gl_1
  if control
    rc_puts rq_gl_ncl
  else
    rc_puts rc_s_false
  end
  rc_puts rq_gl_2
  rc_put_u64 get hdr 1
  rc_puts rq_gn_9
  rc_put_u64 add get hdr 2 1
  rc_puts rq_gl_3
  rc_put_u64 add ulong get inp 0 1
  rc_puts rb_s_comma
  rc_put_u64 add ulong get inp 1 1
  rc_puts rb_s_comma
  rc_put_u64 add ulong get inp 2 1
  rc_puts rq_gl_4
  rc_put_f64 f64 RQ_STEP_S 9
  rc_puts rq_gn_e
  rc_put_u64 ulong RQ_STEPS_PER_KNOT
  rc_puts rq_gn_f
  rc_put_f64 f64 eps 9
  rc_puts rq_gl_5
  rq_put_bool ne get rq_meta 0 0
  rc_puts rq_gl_6
  rq_put_bool ne get rq_meta 1 0
  rc_puts rq_gl_7
  rq_put_bool ne get rq_meta 2 0
  rc_puts rq_gl_8
  rq_put_bool ne get rq_meta 3 0
  rc_puts rq_gl_9
  rc_put_u64 400001
  rq_lz_emit_inp_errs
  rc_puts rq_gl_c
  rq_receipt_json 0
  rc_puts rb_s_comma
  rq_receipt_json 1
  rc_puts rq_gl_d
  rc_put_u64 get rq_meta 4
  rc_puts rb_s_comma
  rc_put_u64 get rq_meta 5
  rc_puts rq_gl_e
  rq_jd get rq_f64s 6
  rc_puts rq_gl_f
  rc_put_i64 bitcast long get rq_meta 10
  rc_puts rq_gl_10
  rq_jd get rq_f64s 7
  rc_puts rq_gl_11
  rc_put_u64 get rq_meta 11
  rc_puts rq_gl_12
  rc_put_f64_1 get rq_f64s 8
  rc_puts rq_gl_13
  rc_status_puts bitcast int uint get hdr 3
  rc_puts rq_gl_14
  rc_put_f64 RQ_TOL_PRED_REL 6
  rc_puts rq_cfg_8
  rc_put_f64 RQ_TOL_NRMSE_ABS 6
  rc_puts rq_cfg_9
  rc_put_f64 RQ_TOL_NRMSE_REL 6
  rc_puts rq_cfg_a
  rc_put_f64 RQ_TOL_METRIC_REL 6
  rc_puts rq_gl_15
end

fn rq_lz_apply_row sp ulong k ulong L ulong st int ro view ulong 1031 to void
  nanv = bitcast f64 ulong 0x7ff8000000000000
  xrow = new f64 256 0.0f64
  yrow = new f64 4 0.0f64
  if eq st RES_OK
    kb = mul k L
    for i ulong L bound 64
      if eq sp 0
        put xrow i get rq_lv0 add kb i
      else
        put xrow i get rq_lv1 add kb i
      end
    end
    if eq res_readout_apply ro view xrow yrow RES_OK
      put rq_lpred mul k 3 get yrow 0
      put rq_lpred add mul k 3 1 get yrow 1
      put rq_lpred add mul k 3 2 get yrow 2
      ret
    end
  end
  put rq_lpred mul k 3 nanv
  put rq_lpred add mul k 3 1 nanv
  put rq_lpred add mul k 3 2 nanv
end

fn rq_lz_apply_split sp ulong nts ulong L ulong st int ro view ulong 1031 to void
  _e = enlarge rq_lpred mul nts 3
  for k ulong nts bound 100000
    rq_lz_apply_row sp k L st ro
  end
end

fn rq_lz_mean_t sp ulong nts ulong c ulong to f64
  mt = 0.0f64
  for k ulong nts bound 100000
    if eq sp 0
      mt = add mt get rq_lt0 add mul k 3 c
    else
      mt = add mt get rq_lt1 add mul k 3 c
    end
  end
  ret div mt f64 nts
end

fn rq_lz_var_stats_a sp ulong nts ulong c ulong mt f64 out2 edit f64 2 to void
  s_den = 0.0f64
  s_nr = 0.0f64
  for k ulong nts bound 100000
    idx = add mul k 3 c
    tv = 0.0f64
    if eq sp 0
      tv = get rq_lt0 idx
    else
      tv = get rq_lt1 idx
    end
    d = sub tv mt
    s_den = add s_den mul d d
    d = sub tv get rq_lpred idx
    s_nr = add s_nr mul d d
  end
  put out2 0 s_den
  put out2 1 s_nr
end

fn rq_lz_var_stats_b sp ulong nts ulong c ulong paoff ulong out2 edit f64 2 to void
  s_pr = 0.0f64
  s_ar = 0.0f64
  for k ulong nts bound 100000
    idx = add mul k 3 c
    tv = 0.0f64
    if eq sp 0
      tv = get rq_lt0 idx
    else
      tv = get rq_lt1 idx
    end
    pa = get mat_re add paoff k
    d = sub get rq_lpred idx pa
    s_pr = add s_pr mul d d
    d = sub tv pa
    s_ar = add s_ar mul d d
  end
  put out2 0 s_pr
  put out2 1 s_ar
end

fn rq_lz_var_stats sp ulong nts ulong c ulong paoff ulong out3 edit f64 3 to void
  mt = rq_lz_mean_t sp nts c
  a2 = new f64 2 0.0f64
  b2 = new f64 2 0.0f64
  rq_lz_var_stats_a sp nts c mt a2
  rq_lz_var_stats_b sp nts c paoff b2
  s_den = get a2 0
  sd = fsqrt div s_den f64 nts
  put out3 0 div fsqrt div get b2 0 f64 nts sd
  put out3 1 fsqrt div get a2 1 s_den
  put out3 2 fsqrt div get b2 1 s_den
end

fn rq_lz_var_metrics sp ulong nts ulong c ulong paoff ulong nref f64 all_ok edit uint 1 to void
  v3 = new f64 3 0.0f64
  rq_lz_var_stats sp nts c paoff v3
  b = le get v3 0 RQ_TOL_PRED_REL
  cc = rq_nrmse_ok get v3 1 nref
  pm = rq_rel_ok get v3 2 nref RQ_TOL_METRIC_REL
  if or not b or not cc not pm
    put all_ok 0 0
  end
  if gt c 0
    rc_puts rb_s_comma
  end
  rc_puts rq_gl_v0
  if eq c 0
    rc_puts rq_s_x
  else
    if eq c 1
      rc_puts rq_s_y
    else
      rc_puts rq_s_z
    end
  end
  rc_puts rq_gl_v1
  rq_jd get v3 0
  rc_puts rq_gn_s3
  rq_jd get v3 1
  rc_puts rq_gn_s4
  rq_jd nref
  rc_puts rq_gn_s5
  rq_jd get v3 2
  rc_puts rq_gn_s8
  rq_put_bool b
  rc_puts rq_gn_s9
  rq_put_bool cc
  rc_puts rq_gn_sb
  rq_put_bool pm
  rc_putc uchar 125
end

fn rq_lz_load_fig_meta d0n ulong d1n ulong to int
  o = new ulong 1 0
  its0 = rq_mf_find 2 rq_mv_tstr
  its1 = rq_mf_find 2 rq_mv_tste
  if ne res_mat_values its0 0 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 0 get o 0
  put rq_loffs 1 rq_mat_meta_get its0 5
  if ne res_mat_values its1 0 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 2 get o 0
  put rq_loffs 3 rq_mat_meta_get its1 5
  nts0 = get rq_loffs 1
  nts1 = get rq_loffs 3
  if ne res_mat_values rq_mf_find 2 rq_mv_px nts0 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 4 get o 0
  if ne res_mat_values rq_mf_find 2 rq_mv_py nts0 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 5 get o 0
  if ne res_mat_values rq_mf_find 2 rq_mv_pz nts0 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 6 get o 0
  if ne res_mat_values rq_mf_find 2 rq_mv_pxt nts1 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 7 get o 0
  if ne res_mat_values rq_mf_find 2 rq_mv_pyt nts1 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 8 get o 0
  if ne res_mat_values rq_mf_find 2 rq_mv_pzt nts1 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 9 get o 0
  if ne res_mat_values rq_mf_find 2 rq_mv_lnrtr 3 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 10 get o 0
  if ne res_mat_values rq_mf_find 2 rq_mv_lnrte 3 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 11 get o 0
  if ne res_mat_values rq_mf_find 2 rq_mv_Ytr mul d0n 3 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 12 get o 0
  if ne res_mat_values rq_mf_find 2 rq_mv_Yte mul d1n 3 o RES_MAT_OK
    ret -1
  end
  put rq_loffs 13 get o 0
  ret 0
end

fn rq_lz_check_nrmse_file nr0 ulong nr1 ulong to int
  o0 = new ulong 1 0
  o1 = new ulong 1 0
  if or ne res_mat_values rq_mf_find 3 rq_mv_lnrtr 3 o0 RES_MAT_OK ne res_mat_values rq_mf_find 3 rq_mv_lnrte 3 o1 RES_MAT_OK
    ret -1
  end
  eq0 = rq_lz_mat_eq nr0 get o0 0 3
  eq1 = rq_lz_mat_eq nr1 get o1 0 3
  if and ne eq0 0 ne eq1 0
    put rq_meta 3 1
  else
    put rq_meta 3 0
  end
  ret 0
end

fn rq_lz_setup_tp nodes ulong control bool inp edit uint 3 gr edit uint 1 to int
  t = new uint 514 0
  p = new uint 265 0
  st = rc_net_topology uint nodes t inp gr
  if eq st RES_OK
    st = res_params_reference RES_REF_LORENZ uint nodes p
  end
  if and eq st RES_OK control
    put p 1 bitcast uint 8.85e-12f32
  end
  cfg_chk = new uint 5363 0
  if eq st RES_OK
    st = res_config_build view t view p RQ_STEP_S RQ_STEPS_PER_KNOT cfg_chk
  end
  if ne st RES_OK
    rc_err_puts rq_err_cfg
    ret 2
  end
  rq_save_tp view t view p
  ret 0
end

fn rq_lz_run_one_sim sp ulong inp view uint 3 g ulong to void
  t = new uint 514 0
  p = new uint 265 0
  rq_load_tp t p
  d = new ulong 3 0
  sm = new ulong 4 0
  put sm 0 sp
  put sm 3 g
  if eq sp 0
    put d 0 get rq_ld0 0
    put d 1 get rq_ld0 1
    put d 2 get rq_ld0 2
    put sm 1 get rq_loffs 0
    put sm 2 get rq_loffs 1
  else
    put d 0 get rq_ld1 0
    put d 1 get rq_ld1 1
    put d 2 get rq_ld1 2
    put sm 1 get rq_loffs 2
    put sm 2 get rq_loffs 3
  end
  rq_lz_sim_split view d view sm view t view p inp
end

fn rq_lz_run_sims inp view uint 3 g ulong to void
  rq_lz_run_one_sim 0 inp g
  rq_lz_run_one_sim 1 inp g
end

fn rq_lz_emit_split_vars sp ulong nts ulong pbase ulong nroff ulong all_ok edit uint 1 to void
  for c ulong 3 bound 3
    pao = get rq_loffs add pbase c
    nrv = get mat_re add nroff c
    rq_lz_var_metrics sp nts c pao nrv all_ok
  end
end

fn rq_lz_emit_one_split sp ulong nodes ulong fst int ro view ulong 1031 all_ok edit uint 1 to void
  nts = get rq_loffs 1
  pbase = ulong 4
  nroff = get rq_loffs 10
  if eq sp 1
    nts = get rq_loffs 3
    pbase = 7
    nroff = get rq_loffs 11
  end
  rq_lz_apply_split sp nts nodes fst ro
  if gt sp 0
    rc_putc uchar 44
  end
  rc_puts rq_gl_sp0
  if eq sp 0
    rc_puts rq_s_train
  else
    rc_puts rq_s_test
  end
  rc_puts rq_gl_sp1
  rq_lz_emit_split_vars sp nts pbase nroff all_ok
  rc_puts rq_gl_sp_end
end

fn rq_lz_emit_all nodes ulong control bool inp view uint 3 g ulong fst int to int
  hdr = new ulong 4 0
  put hdr 0 nodes
  put hdr 1 ulong get rq_tbuf 1
  put hdr 2 g
  put hdr 3 ulong bitcast uint fst
  rq_lz_emit_hdr view hdr control inp bitcast f32 get rq_pbuf 1
  ro = new ulong 1031 0
  for i ulong 1031 bound 1031
    put ro i get rq_ro i
  end
  all_ok = new uint 1 0
  ok = eq bitcast int get rq_rst 0 RES_OK
  if ne bitcast int get rq_rst 1 RES_OK
    ok = false
  end
  if eq get rq_meta 0 0
    ok = false
  end
  if eq get rq_meta 1 0
    ok = false
  end
  if eq get rq_meta 2 0
    ok = false
  end
  if ne fst RES_OK
    ok = false
  end
  if ok
    put all_ok 0 1
  end
  rq_lz_emit_one_split 0 nodes fst view ro all_ok
  rq_lz_emit_one_split 1 nodes fst view ro all_ok
  rc_puts rq_gl_end
  if ne get all_ok 0 0
    rc_puts rq_pins_pass
    rc_flush
    ret 0
  end
  rc_puts rq_pins_fail
  rc_flush
  ret 1
end

fn rq_lz_t_ok toff ulong n ulong to bool
  if ne get mat_re toff 0.0f64
    ret false
  end
  if ne get mat_re add toff sub n 1 40.0f64
    ret false
  end
  ret true
end

fn rq_lz_parse_both to int
  d0 = new ulong 3 0
  d1 = new ulong 3 0
  if ne rq_lz_parse_data 0 d0 0
    rc_err_puts rq_err_lmal
    ret 2
  end
  if ne rq_lz_parse_data 1 d1 0
    rc_err_puts rq_err_lmal
    ret 2
  end
  for i ulong 3 bound 3
    put rq_ld0 i get d0 i
    put rq_ld1 i get d1 i
  end
  if ne rq_lz_load_fig_meta get d0 2 get d1 2 0
    ret 2
  end
  if ne rq_lz_check_nrmse_file get rq_loffs 10 get rq_loffs 11 0
    ret 2
  end
  tok = ulong 1
  if not rq_lz_t_ok get d0 1 get d0 2
    tok = 0
  end
  if not rq_lz_t_ok get d1 1 get d1 2
    tok = 0
  end
  put rq_meta 0 tok
  put rq_meta 1 rq_lz_mat_eq get rq_loffs 12 get d0 0 mul get d0 2 3
  put rq_meta 2 rq_lz_mat_eq get rq_loffs 13 get d1 0 mul get d1 2 3
  put rq_meta 4 get rq_loffs 1
  put rq_meta 5 get rq_loffs 3
  ret 0
end

fn rq_lz_cv_run_global n0 ulong nodes ulong to int
  ro = new ulong 1031 0
  fst = rq_lz_cv_run n0 nodes ro
  for i ulong 1031 bound 1031
    put rq_ro i get ro i
  end
  ret fst
end

fn rq_run_g2_lorenz root view uchar 512 rlen ulong nodes ulong control bool to int
  figp = RQ_PIN_LZ_FIG13
  nrp = RQ_PIN_LZ_NR13
  if eq nodes 25
    figp = RQ_PIN_LZ_FIG25
    nrp = RQ_PIN_LZ_NR25
  else
    if eq nodes 43
      figp = RQ_PIN_LZ_FIG43
      nrp = RQ_PIN_LZ_NR43
    end
  end
  res_mat_reset_pool
  if ne rq_load_pinned_slot view root rlen RQ_PIN_LZ_D1 0 0
    ret 2
  end
  if ne rq_load_pinned_slot view root rlen RQ_PIN_LZ_D2 1 0
    ret 2
  end
  if ne rq_load_pinned_slot view root rlen figp 2 0
    ret 2
  end
  if ne rq_load_pinned_slot view root rlen nrp 3 0
    ret 2
  end
  if ne rq_lz_parse_both 0
    ret 2
  end
  inp = new uint 3 0
  gr = new uint 1 0
  if ne rq_lz_setup_tp nodes control inp gr 0
    ret 2
  end
  for i ulong 6 bound 6
    put rq_f64s i 0.0f64
  end
  rq_lz_run_sims view inp ulong get gr 0
  rq_lz_range_scale get rq_loffs 1 get rq_loffs 3 nodes
  fst = rq_lz_cv_run_global get rq_loffs 1 nodes
  ret rq_lz_emit_all nodes control view inp ulong get gr 0 fst
end

note ================================================================
note CLI entry point
note ================================================================

fn rq_parse_seeds ac ulong seeds edit int 16 to ulong
  ns = ulong 0
  abuf = new uchar 64 0
  for i ulong sub ac 2 bound 16
    al = argread add i 2 abuf 0 64
    if gt al 0
      put seeds ns rq_parse_int view abuf ulong al
      ns = add ns 1
    end
  end
  if eq ns 0
    for i ulong 5 bound 5
      put seeds i int add i 1
    end
    ns = 5
  end
  ret ns
end

fn rq_dispatch_g2n ac ulong to int
  if and ne ac 4 ne ac 5
    rc_err_puts rq_usage
    ret 2
  end
  root = new uchar 512 0
  var = new uchar 64 0
  v2p = new uchar 512 0
  lens = new ulong 3 0
  rl = argread 2 root 0 512
  vl = argread 3 var 0 64
  v2l = long 0
  if eq ac 5
    v2l = argread 4 v2p 0 512
  end
  if or lt rl 0 or lt vl 0 lt v2l 0
    rc_err_puts rq_usage
    ret 2
  end
  put lens 0 ulong rl
  put lens 1 ulong vl
  put lens 2 ulong v2l
  ret rq_run_g2_narma view root view var view v2p view lens ac
end

fn rq_dispatch_g2l ac ulong to int
  if and ne ac 4 ne ac 5
    rc_err_puts rq_usage
    ret 2
  end
  root = new uchar 512 0
  nbuf = new uchar 32 0
  cbuf = new uchar 32 0
  rl = argread 2 root 0 512
  nl = argread 3 nbuf 0 32
  if or lt rl 0 lt nl 0
    rc_err_puts rq_usage
    ret 2
  end
  n = rq_parse_int view nbuf ulong nl
  if and ne n 13 and ne n 25 ne n 43
    rc_err_puts rq_usage
    ret 2
  end
  ctrl = false
  if eq ac 5
    cl = argread 4 cbuf 0 32
    if or lt cl 0 not rq_streq view cbuf ulong cl rq_var_ncl
      rc_err_puts rq_usage
      ret 2
    end
    ctrl = true
  end
  ret rq_run_g2_lorenz view root ulong rl ulong n ctrl
end

fn main to int
  ac = ulong argcnt
  cmd = new uchar 64 0
  root = new uchar 512 0
  seeds = new int 16 0
  if lt ac 2
    rc_err_puts rq_usage
    ret 2
  end
  cl = argread 1 cmd 0 64
  if lt cl 0
    rc_err_puts rq_usage
    ret 2
  end
  clen = ulong cl
  if and rq_streq view cmd clen rq_cmd_config eq ac 2
    ret rq_run_config
  end
  if and rq_streq view cmd clen rq_cmd_pins eq ac 3
    rl = argread 2 root 0 512
    if lt rl 0
      rc_err_puts rq_usage
      ret 2
    end
    ret rq_run_pins view root ulong rl
  end
  if rq_streq view cmd clen rq_cmd_g2n
    ret rq_dispatch_g2n ac
  end
  if rq_streq view cmd clen rq_cmd_g2l
    ret rq_dispatch_g2l ac
  end
  if rq_streq view cmd clen rq_cmd_bnarma
    ns = rq_parse_seeds ac seeds
    ret rb_bench_narma view seeds ns
  end
  if rq_streq view cmd clen rq_cmd_blorenz
    ns = rq_parse_seeds ac seeds
    ret rb_bench_lorenz view seeds ns
  end
  if and rq_streq view cmd clen rq_cmd_perf eq ac 2
    ret rb_perf
  end
  rc_err_puts rq_usage
  ret 2
end

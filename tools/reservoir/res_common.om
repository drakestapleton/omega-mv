note Strings
text rc_hex_ch "0123456789abcdef"
text rc_s_null "null"
text rc_s_true "true"
text rc_s_false "false"
text rc_s_ok "OK"
text rc_s_enull "ERR_NULL"
text rc_s_etopo "ERR_TOPOLOGY"
text rc_s_eparam "ERR_PARAM"
text rc_s_enonfin "ERR_NONFINITE"
text rc_s_erange "ERR_RANGE"
text rc_s_estiff "ERR_STIFF"

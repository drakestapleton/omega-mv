text rc_ms_1 ", \"states_implausible\": "
text rc_ms_2 ", \"membranes_implausible\": "
text rc_ms_3 ", \"max_membrane_abs_v\": "
text rc_ms_4 ", \"max_node_abs_v\": "
text rc_ms_5 "}"

note ================================================================
note Buffered output & JSON formatting
note ================================================================

fn rc_flush to void
  n = get rc_out_n 0
  buf = new uchar 8192 0
  if gt n 0
    for i ulong n bound 8192
      put buf i get rc_out i
    end
    _w = write 1 buf 0 n
    put rc_out_n 0 0
  end
end

fn rc_putc c uchar to void
  n = get rc_out_n 0
  if ge n 8192
    rc_flush
    n = 0
  end
  put rc_out n c
  put rc_out_n 0 add n 1
end

fn rc_puts s view uchar * to void
  n = len s
  for i ulong n bound 100000
    rc_putc get s i
  end
end

fn rc_err_puts s view uchar * to void
  n = len s
  buf = new uchar 256 0
  off = ulong 0
  while lt off n bound 1024
    ch = sub n off
    if gt ch 256
      ch = 256
    end
    for i ulong ch bound 256
      put buf i get s add off i
    end
    _w = write 2 buf 0 ch
    off = add off ch
  end
end

fn rc_put_u64 v ulong to void
  if eq v 0
    rc_putc uchar 48
    ret
  end
  d = new uchar 24 0
  k = ulong 0
  x = v
  while gt x 0 bound 24
    put d k uchar add 48 rem x 10
    x = div x 10
    k = add k 1
  end
  while gt k 0 bound 24
    k = sub k 1
    rc_putc get d k
  end
end

fn rc_put_i64 v long to void
  if lt v 0
    rc_putc uchar 45
    rc_put_u64 ulong neg v
  else
    rc_put_u64 ulong v
  end
end

fn rc_put_hex32_u8 d view uchar 32 to void
  for i ulong 32 bound 32
    b = ulong get d i
    rc_putc get rc_hex_ch shr b 4
    rc_putc get rc_hex_ch and b 15
  end
end

fn rc_put_hex32_u32 d view uint 32 to void
  for i ulong 32 bound 32
    b = ulong and get d i 0xff
    rc_putc get rc_hex_ch shr b 4
    rc_putc get rc_hex_ch and b 15
  end
end

fn rc_jhex_u32 d view uint 32 to void
  rc_putc uchar 34
  rc_put_hex32_u32 d
  rc_putc uchar 34
end

fn rc_json_str s view uchar * to void
  rc_putc uchar 34
  n = len s
  for i ulong n bound 100000
    c = get s i
    if or eq c uchar 34 eq c uchar 92
      rc_putc uchar 92
      rc_putc c
    else
      if lt c uchar 32
        rc_putc uchar 92
        rc_putc uchar 117
        rc_putc uchar 48
        rc_putc uchar 48
        rc_putc get rc_hex_ch shr ulong c 4
        rc_putc get rc_hex_ch and ulong c 15
      else
        rc_putc c
      end
    end
  end
  rc_putc uchar 34
end

fn rc_abs64 x f64 to f64
  if lt x 0.0f64
    ret neg x
  end
  ret x
end

fn rc_isnan x f64 to bool
  ret not eq x x
end

fn rc_isfin x f64 to bool
  if not eq x x
    ret false
  end
  ret eq sub x x 0.0f64
end

fn rc_pow10_u e ulong to f64
  p = 1.0f64
  b = 10.0f64
  k = e
  while gt k 0 bound 400
    if ne and k 1 0
      p = mul p b
    end
    b = mul b b
    k = shr k 1
  end
  ret p
end

fn rc_f64_norm_exp x f64 out_m edit f64 1 to long
  e = long 0
  m = x
  while ge m 10.0f64 bound 400
    if ge m 1.0e16f64
      m = div m 1.0e16f64
      e = add e 16
    else
      m = div m 10.0f64
      e = add e 1
    end
  end
  while lt m 1.0f64 bound 400
    if lt m 1.0e-16f64
      m = mul m 1.0e16f64
      e = sub e 16
    else
      m = mul m 10.0f64
      e = sub e 1
    end
  end
  put out_m 0 m
  ret e
end

fn rc_put_exp_part e long to void
  rc_putc uchar 101
  ae = ulong 0
  if lt e 0
    rc_putc uchar 45
    ae = ulong neg e
  else
    rc_putc uchar 43
    ae = ulong e
  end
  if lt ae 10
    rc_putc uchar 48
  end
  rc_put_u64 ae
end

fn rc_put_f64_digits digs view uchar 24 last ulong e long sig ulong to void
  if or lt e -4 ge e long sig
    rc_putc get digs 0
    if gt last 0
      rc_putc uchar 46
      for i ulong last bound 24
        rc_putc get digs add i 1
      end
    end
    rc_put_exp_part e
  else
    if lt e 0
      rc_putc uchar 48
      rc_putc uchar 46
      nz = ulong sub neg e 1
      for z ulong nz bound 8
        rc_putc uchar 48
      end
      for i ulong add last 1 bound 24
        rc_putc get digs i
      end
    else
      eu = ulong e
      for i ulong add eu 1 bound 24
        if le i last
          rc_putc get digs i
        else
          rc_putc uchar 48
        end
      end
      if gt last eu
        rc_putc uchar 46
        for i ulong sub last eu bound 24
          rc_putc get digs add add eu 1 i
        end
      end
    end
  end
end

fn rc_put_f64_emit_iv iv_in ulong e long sig ulong to void
  iv = iv_in
  digs = new uchar 24 48
  k = sig
  while gt k 0 bound 24
    k = sub k 1
    put digs k uchar add 48 rem iv 10
    iv = div iv 10
  end
  last = sub sig 1
  while and gt last 0 eq get digs last uchar 48 bound 24
    last = sub last 1
  end
  rc_put_f64_digits view digs last e sig
end

fn rc_put_f64 v f64 sig_in uint to void
  if not rc_isfin v
    rc_puts rc_s_null
    ret
  end
  if eq v 0.0f64
    rc_putc uchar 48
    ret
  end
  x = v
  if lt x 0.0f64
    rc_putc uchar 45
    x = neg x
  end
  sig = ulong sig_in
  if gt sig 17
    sig = 17
  end
  if lt sig 1
    sig = 1
  end
  mb = new f64 1 0.0f64
  e = rc_f64_norm_exp x mb
  p10 = rc_pow10_u sub sig 1
  sc = add mul get mb 0 p10 0.5f64
  if ge sc mul p10 10.0f64
    sc = div sc 10.0f64
    e = add e 1
  end
  rc_put_f64_emit_iv ulong sc e sig
end

fn rc_put_f64_1 v f64 to void
  if not rc_isfin v
    rc_puts rc_s_null
    ret
  end
  x = v
  if lt x 0.0f64
    rc_putc uchar 45
    x = neg x
  end
  t = ulong add mul x 10.0f64 0.5f64
  rc_put_u64 div t 10
  rc_putc uchar 46
  rc_putc uchar add 48 rem t 10
end

fn rc_put_f64_4 v f64 to void
  if not rc_isfin v
    rc_puts rc_s_null
    ret
  end
  x = v
  if lt x 0.0f64
    rc_putc uchar 45
    x = neg x
  end
  t = ulong add mul x 10000.0f64 0.5f64
  rc_put_u64 div t 10000
  rc_putc uchar 46
  frac = rem t 10000
  rc_putc uchar add 48 div frac 1000
  rc_putc uchar add 48 rem div frac 100 10
  rc_putc uchar add 48 rem div frac 10 10
  rc_putc uchar add 48 rem frac 10
end

fn rc_status_puts st int to void
  if eq st RES_OK
    rc_puts rc_s_ok
    ret
  end
  if eq st RES_ERR_NULL
    rc_puts rc_s_enull
    ret
  end
  if eq st RES_ERR_TOPOLOGY
    rc_puts rc_s_etopo
    ret
  end
  if eq st RES_ERR_PARAM
    rc_puts rc_s_eparam
    ret
  end
  if eq st RES_ERR_NONFINITE
    rc_puts rc_s_enonfin
    ret
  end
  if eq st RES_ERR_RANGE
    rc_puts rc_s_erange
    ret
  end
  if eq st RES_ERR_STIFF
    rc_puts rc_s_estiff
    ret
  end
  if eq st RES_ERR_INPUT
    rc_puts rc_s_einput
    ret
  end
  if eq st RES_ERR_MISMATCH
    rc_puts rc_s_emism
    ret
  end
  if eq st RES_ERR_FPENV
    rc_puts rc_s_efpenv
    ret
  end
  if eq st RES_ERR_SINGULAR
    rc_puts rc_s_esing
    ret
  end
  if eq st RES_ERR_ALIAS
    rc_puts rc_s_ealias
    ret
  end
  rc_puts rc_s_eunk
end

fn rc_mstats_json m view uint 200 to void
  obs = or shl ulong get m RES_MS_OBS_HI 32 ulong get m RES_MS_OBS_LO
  imp = or shl ulong get m RES_MS_IMP_HI 32 ulong get m RES_MS_IMP_LO
  rc_puts rc_ms_0
  rc_put_u64 obs
  rc_puts rc_ms_1
  rc_put_u64 imp
  rc_puts rc_ms_2
  rc_put_u64 ulong get m RES_MS_MEM_IMP
  rc_puts rc_ms_3
  rc_put_f64 f64 bitcast f32 get m RES_MS_MAX_MV 9
  rc_puts rc_ms_4
  rc_put_f64 f64 bitcast f32 get m RES_MS_MAX_NV 9
  rc_puts rc_ms_5
end

note ================================================================
note Time & splitmix64 RNG
note ================================================================

fn rc_now_ns to ulong
  ret ulong monons
end

fn rc_now_s to f64
  ret mul f64 monons 1.0e-9f64
end

fn rc_rng_next r edit ulong 1 to ulong
  c0 = or shl ulong 0x9e3779b9 32 ulong 0x7f4a7c15
  c1 = or shl ulong 0xbf58476d 32 ulong 0x1ce4e5b9
  c2 = or shl ulong 0x94d049bb 32 ulong 0x133111eb
  z = add get r 0 c0
  put r 0 z
  z = mul xor z shr z 30 c1
  z = mul xor z shr z 27 c2
  ret xor z shr z 31
end

fn rc_rng_unit r edit ulong 1 to f64
  ret mul f64 shr rc_rng_next r 11 div 1.0f64 9007199254740992.0f64
end

note ================================================================
note Reference topologies (HEX13, HEX25, HEX43, CHAIN50, disconnected)
note ================================================================

fn rc_add_edge e edit uint 384 m edit uint 1 a uint b uint to void
  if eq a b
    ret
  end
  lo = a
  hi = b
  if gt lo hi
    lo = b
    hi = a
  end
  cnt = ulong get m 0
  for q ulong cnt bound 192
    if eq get e mul q 2 lo
      if eq get e add mul q 2 1 hi
        ret
      end
    end
  end
  put e mul cnt 2 lo
  put e add mul cnt 2 1 hi
  put m 0 add get m 0 1
end

fn rc_nb_add e edit uint 384 m edit uint 1 node uint n1 uint n2 uint n3 uint to void
  if gt n1 0
    rc_add_edge e m node sub n1 1
  end
  if gt n2 0
    rc_add_edge e m node sub n2 1
  end
  if gt n3 0
    rc_add_edge e m node sub n3 1
  end
end

fn rc_nb_add6 e edit uint 384 m edit uint 1 node uint v view uint 6 to void
  for k ulong 6 bound 6
    nb = get v k
    if gt nb 0
      rc_add_edge e m node sub nb 1
    end
  end
end

fn rc_build_hex13 t edit uint 514 inp edit uint 3 gr edit uint 1 to int
  e = new uint 384 0
  m = new uint 1 0
  rc_nb_add e m 0 2 3 4
  rc_nb_add e m 1 1 5 6
  rc_nb_add e m 2 1 6 7
  rc_nb_add e m 3 1 5 8
  rc_nb_add e m 4 2 4 9
  rc_nb_add e m 5 2 3 10
  rc_nb_add e m 6 3 11 0
  rc_nb_add e m 7 4 12 0
  rc_nb_add e m 8 5 12 13
  rc_nb_add e m 9 6 11 13
  rc_nb_add e m 10 7 10 0
  rc_nb_add e m 11 8 9 0
  rc_nb_add e m 12 9 10 0
  put inp 0 0
  put inp 1 1
  put inp 2 12
  put gr 0 7
  g = new uint 1 7
  tm = new uint 3 0
  put tm 0 13
  put tm 1 get m 0
  put tm 2 1
  ret res_topology_build view tm view e view g t
end


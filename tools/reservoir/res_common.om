fn rc_hash_fd fd int got_hex edit uchar 64 to int
  ctx = new uint 74 0
  res_sha_init ctx
  buf = new uchar 4096 0
  done = false
  while not done bound 100000
    n = read fd buf 0 4096
    if lt n 0
      ret -1
    end
    if eq n 0
      done = true
    else
      res_sha_update ctx part buf 0 ulong n
    end
  end
  dig = new uchar 32 0
  res_sha_final ctx dig
  for i ulong 32 bound 32
    b = ulong get dig i
    put got_hex mul i 2 get rc_hex_ch shr b 4
    put got_hex add mul i 2 1 get rc_hex_ch and b 15
  end
  ret 0
end

fn rc_pin_match idx ulong got_hex view uchar 64 to int
  want = new uchar 64 0
  _wl = rc_pin_copy_h idx want
  for i ulong 64 bound 64
    if ne get got_hex i get want i
      ret 1
    end
  end
  ret 0
end

fn rc_check_pinned root view uchar * idx ulong got_hex edit uchar 64 to int
  rel = new uchar 256 0
  rlen = rc_pin_copy_p idx rel
  path = new uchar 1024 0
  rn = len root
  if gt add add rn 1 rlen 1020
    ret -1
  end
  for i ulong rn bound 768
    put path i get root i
  end
  put path rn uchar 47
  for i ulong rlen bound 256
    put path add add rn 1 i get rel i
  end
  fd = fopen path 0 add add rn 1 rlen 0 0
  if lt fd 0
    ret -1
  end
  hr = rc_hash_fd int fd got_hex
  _fc = fclose int fd
  if ne hr 0
    ret -1
  end
  ret rc_pin_match idx view got_hex
end

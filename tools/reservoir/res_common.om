fn rc_net_topology net uint t edit uint 514 inp edit uint 3 gr edit uint 1 to int
  if eq net RC_NET_HEX13
    ret rc_build_hex13 t inp gr
  end
  if eq net RC_NET_HEX25
    ret rc_build_hex25 t inp gr
  end
  if eq net RC_NET_HEX43
    ret rc_build_hex43 t inp gr
  end
  if eq net RC_NET_CHAIN50
    ret rc_build_chain50 t gr
  end
  ret RES_ERR_PARAM
end

global rc_disc_grounds uint 64
global rc_disc_gconc f32 64
global rc_disc_gdeg uint 64

fn rc_disc_find_gr ng ulong c f32 to uint
  found = uint 0xffffffff
  for q ulong ng bound 64
    if eq get rc_disc_gconc q c
      if lt get rc_disc_gdeg q 6
        found = uint q
      end
    end
  end
  ret found
end

fn rc_disc_build_edges conc view f32 64 nd uint e edit uint 384 info edit uint 2 to int
  ng = ulong 0
  node = nd
  for k ulong ulong nd bound 64
    fnd = rc_disc_find_gr ng get conc k
    if eq fnd 0xffffffff
      if ge node 64
        ret RES_ERR_TOPOLOGY
      end
      fnd = uint ng
      put rc_disc_grounds ng node
      put rc_disc_gconc ng get conc k
      put rc_disc_gdeg ng 0
      node = add node 1
      ng = add ng 1
    end
    put e mul k 2 uint k
    fi = ulong fnd
    put e add mul k 2 1 get rc_disc_grounds fi
    put rc_disc_gdeg fi add get rc_disc_gdeg fi 1
  end
  put info 0 node
  put info 1 uint ng
  ret RES_OK
end

fn rc_disc_set_params which uint conc view f32 64 nd uint info view uint 2 p edit uint 265 to int
  st = res_params_reference which get info 0 p
  if ne st RES_OK
    ret st
  end
  for k ulong ulong nd bound 64
    put p add RES_PAR_CONC k bitcast uint get conc k
  end
  for q ulong ulong get info 1 bound 64
    gq = ulong get rc_disc_grounds q
    gc = bitcast uint get rc_disc_gconc q
    put p add RES_PAR_CONC gq gc
  end
  ret RES_OK
end

fn rc_net_disconnected which uint conc view f32 64 nd uint t edit uint 514 p edit uint 265 to int
  if or eq nd 0 ge nd 64
    ret RES_ERR_PARAM
  end
  e = new uint 384 0
  grounds = new uint 64 0
  info = new uint 2 0
  st = rc_disc_build_edges conc nd e info
  if ne st RES_OK
    ret st
  end
  for q ulong ulong get info 1 bound 64
    put grounds q get rc_disc_grounds q
  end
  tm = new uint 3 0
  put tm 0 get info 0
  put tm 1 nd
  put tm 2 get info 1
  st = res_topology_build view tm view e view grounds t
  if ne st RES_OK
    ret st
  end
  ret rc_disc_set_params which conc nd view info p
end

note ================================================================
note Global simulation driver (streaming 2-knot pair)
note ================================================================

fn rc_load_pair nc ulong k64 ulong pair edit f32 128 to void
  b0 = mul k64 nc
  b1 = add b0 nc
  for i ulong nc bound 64
    put pair i get rc_tab add b0 i
    put pair add nc i get rc_tab add b1 i
  end
end

fn rc_sim_step_one nc uint kn uint obs bool to int
  cfg = new uint 5363 0
  for i ulong 5363 bound 5363
    put cfg i get rc_cfg i
  end
  s = new uint 932 0
  for i ulong 932 bound 932
    put s i get rc_s i
  end
  ws = new uint 3564 0
  for i ulong 3564 bound 3564
    put ws i get rc_ws i
  end
  k64 = div res_state_get_step view s ulong get cfg RES_CFG_K
  if ge add k64 1 ulong kn
    ret RES_ERR_INPUT
  end
  pair = new f32 128 0.0f32
  rc_load_pair ulong nc k64 pair
  st = res_step_pair view cfg view pair ws view s
  if ne st RES_OK
    ret st
  end
  res_copy_spare_to_state view ws s
  if obs
    res_ws_observe_state view cfg view s ws
  end
  for i ulong 932 bound 932
    put rc_s i get s i
  end
  for i ulong 3564 bound 3564
    put rc_ws i get ws i
  end
  ret RES_OK
end

fn rc_load_sim cfg edit uint 5363 s edit uint 932 ws edit uint 3564 to void
  for i ulong 5363 bound 5363
    put cfg i get rc_cfg i
  end
  for i ulong 932 bound 932
    put s i get rc_s i
  end
  for i ulong 3564 bound 3564
    put ws i get rc_ws i
  end
end

fn rc_save_sim s view uint 932 ws view uint 3564 to void
  for i ulong 932 bound 932
    put rc_s i get s i
  end
  for i ulong 3564 bound 3564
    put rc_ws i get ws i
  end
end

fn rc_sim_advance_obs nc uint kn uint steps ulong to int
  cfg = new uint 5363 0
  s = new uint 932 0
  ws = new uint 3564 0
  rc_load_sim cfg s ws
  pair = new f32 128 0.0f32
  last_k = ulong 0xffffffffffffffff
  for it ulong steps bound 50000000
    k64 = div res_state_get_step view s ulong get cfg RES_CFG_K
    if ge add k64 1 ulong kn
      rc_save_sim view s view ws
      ret RES_ERR_INPUT
    end
    if ne k64 last_k
      rc_load_pair ulong nc k64 pair
      last_k = k64
    end
    st = res_step_pair view cfg view pair ws view s
    if ne st RES_OK
      rc_save_sim view s view ws
      ret st
    end
    res_copy_spare_to_state view ws s
    res_ws_observe_state view cfg view s ws
  end
  rc_save_sim view s view ws
  ret RES_OK
end

fn rc_sim_get_step to ulong
  ret or shl ulong get rc_s RES_ST_STEP_HI 32 ulong get rc_s RES_ST_STEP_LO
end

fn rc_copy_v_to_vout base ulong nc ulong to void
  for i ulong nc bound 64
    v = f64 bitcast f32 get rc_s add RES_ST_V i
    put rc_vout add base i v
  end
end

fn rc_interp_v_to_vout base ulong nc ulong f f64 to void
  omf = sub 1.0f64 f
  for i ulong nc bound 64
    v0 = f64 bitcast f32 get rc_s add RES_ST_V i
    v1 = f64 bitcast f32 get rc_next add RES_ST_V i
    put rc_vout add base i add mul omf v0 mul f v1
  end
end

fn rc_sim_at_steps nc uint kn uint nsteps ulong to int
  for k ulong nsteps bound 200000
    tgt = get rc_steps k
    cur = rc_sim_get_step
    if lt tgt cur
      ret RES_ERR_INPUT
    end
    if gt tgt cur
      st = rc_sim_advance_obs nc kn sub tgt cur
      if ne st RES_OK
        ret st
      end
    end
    rc_copy_v_to_vout mul k ulong nc ulong nc
  end
  ret RES_OK
end

fn rc_sim_step_next_only nc uint kn uint to int
  cfg = new uint 5363 0
  s = new uint 932 0
  ws = new uint 3564 0
  rc_load_sim cfg s ws
  k64 = div res_state_get_step view s ulong get cfg RES_CFG_K
  if ge add k64 1 ulong kn
    ret RES_ERR_INPUT
  end
  pair = new f32 128 0.0f32
  rc_load_pair ulong nc k64 pair
  st = res_step_pair view cfg view pair ws view s
  if ne st RES_OK
    ret st
  end
  for i ulong 932 bound 932
    put rc_next i get ws add RES_WS_SPARE i
  end
  ret RES_OK
end

fn rc_sim_at_positions nc uint kn uint npos ulong last_step ulong to int
  cached = ulong 0xffffffffffffffff
  for k ulong npos bound 200000
    p = get rc_pos k
    if or not ge p 0.0f64 gt p f64 last_step
      ret RES_ERR_INPUT
    end
    n0 = ulong p
    f = sub p f64 n0
    cur = rc_sim_get_step
    if lt n0 cur
      ret RES_ERR_INPUT
    end
    if gt n0 cur
      st = rc_sim_advance_obs nc kn sub n0 cur
      if ne st RES_OK
        ret st
      end
    end
    if gt f 0.0f64
      if ne cached n0
        st = rc_sim_step_next_only nc kn
        if ne st RES_OK
          ret st
        end
        cached = n0
      end
      rc_interp_v_to_vout mul k ulong nc ulong nc f
    else
      rc_copy_v_to_vout mul k ulong nc ulong nc
    end
  end
  ret RES_OK
end

fn rc_sim_receipt nc uint kn uint out_rc edit uint 130 to int
  ctx = new uint 74 0
  res_input_digest_begin ctx nc kn
  row = new f32 64 0.0f32
  for k ulong ulong kn bound 1000000
    base = mul k ulong nc
    for i ulong ulong nc bound 64
      put row i get rc_tab add base i
    end
    res_input_digest_row ctx view row nc
  end
  idig = new uchar 32 0
  res_sha_final ctx idig
  cfg = new uint 5363 0
  for i ulong 5363 bound 5363
    put cfg i get rc_cfg i
  end
  s = new uint 932 0
  for i ulong 932 bound 932
    put s i get rc_s i
  end
  ret res_run_receipt_from_idig view cfg view idig view s out_rc
end

fn rc_sim_init_globals t view uint 514 p view uint 265 init uint initv f32 to int
  cfg = new uint 5363 0
  st = res_config_build t p 1.0e-5f32 10 cfg
  if ne st RES_OK
    ret st
  end
  s = new uint 932 0
  st = res_state_init view cfg init initv s
  for i ulong 5363 bound 5363
    put rc_cfg i get cfg i
  end
  for i ulong 932 bound 932
    put rc_s i get s i
  end
  for i ulong 3564 bound 3564
    put rc_ws i 0
  end
  ret st
end

note Run full simulation: smeta=[init, bitcast uint initv, kn, nsteps]
fn rc_simulate_run t view uint 514 p view uint 265 smeta view uint 4 out_rc edit uint 130 out_ms edit uint 200 to int
  st = rc_sim_init_globals t p get smeta 0 bitcast f32 get smeta 1
  if ne st RES_OK
    for i ulong 200 bound 200
      put out_ms i 0
    end
    ret st
  end
  nc = get t 0
  kn = get smeta 2
  last = mul sub ulong kn 1 10
  st = rc_sim_at_steps nc kn ulong get smeta 3
  if eq st RES_OK
    cur = rc_sim_get_step
    if lt cur last
      st = rc_sim_advance_obs nc kn sub last cur
    end
  end
  if eq st RES_OK
    st = rc_sim_receipt nc kn out_rc
  end
  for i ulong 200 bound 200
    put out_ms i get rc_ws add RES_WS_MSTATS i
  end
  ret st
end

note ================================================================
note Statistics & NARMA generator
note ================================================================

fn rc_narma_sum yv view f64 2024 t ulong ord ulong to f64
  s = 0.0f64
  base = sub add t 1 ord
  for j ulong ord bound 20
    s = add s get yv add base j
  end
  ret s
end

fn rc_narma_step yv edit f64 2024 up view f64 2024 t ulong ord ulong to void
  s = rc_narma_sum view yv t ord
  yt = get yv t
  a = add mul 0.3f64 yt mul mul 0.05f64 yt s
  u0 = get up sub add t 1 ord
  b = mul mul 1.5f64 u0 get up t
  put yv add t 1 add add a b 0.1f64
end

fn rc_narma_g u view f64 * n uint order uint y edit f64 * to void
  yv = new f64 2024 0.0f64
  up = new f64 2024 0.0f64
  for i ulong ulong n bound 2000
    put up add 20 i get u i
  end
  for k ulong ulong n bound 2000
    rc_narma_step yv view up add 19 k ulong order
  end
  for i ulong ulong n bound 2000
    put y i get yv add 20 i
  end
end

fn rc_nrmse_ytr_pv v0 ulong nv ulong no ulong c ulong to f64
  m = 0.0f64
  for i ulong nv bound 100000
    m = add m get rc_ytr add mul add v0 i no c
  end
  m = div m f64 nv
  num = 0.0f64
  den = 0.0f64
  for i ulong nv bound 100000
    rv = get rc_ytr add mul add v0 i no c
    pv = get rc_pv add mul i no c
    e = sub rv pv
    dc = sub rv m
    num = add num mul e e
    den = add den mul dc dc
  end
  ret fsqrt div num den
end

fn rc_nrmse_y_p which uint n ulong no ulong c ulong to f64
  m = 0.0f64
  for i ulong n bound 100000
    rv = 0.0f64
    if eq which 0
      rv = get rc_ytr add mul i no c
    else
      rv = get rc_yte add mul i no c
    end
    m = add m rv
  end
  m = div m f64 n
  num = 0.0f64
  den = 0.0f64
  for i ulong n bound 100000
    rv = 0.0f64
    pv = 0.0f64
    if eq which 0
      rv = get rc_ytr add mul i no c
      pv = get rc_ptr add mul i no c
    else
      rv = get rc_yte add mul i no c
      pv = get rc_pte add mul i no c
    end
    e = sub rv pv
    dc = sub rv m
    num = add num mul e e
    den = add den mul dc dc
  end
  ret fsqrt div num den
end

note ================================================================
note Ridge CV using streaming res_ro_ws_* on global rc_xtr/ytr/xte/yte
note ================================================================

fn rc_zscore_apply f ulong ntr ulong nte ulong nf ulong m f64 sd f64 to void
  for i ulong ntr bound 100000
    idx = add mul i nf f
    v = div sub get rc_xtr idx m sd
    put rc_ztr idx v
  end
  for i ulong nte bound 100000
    idx = add mul i nf f
    v = div sub get rc_xte idx m sd
    put rc_zte idx v
  end
end

fn rc_zscore_col f ulong ntr ulong nte ulong nf ulong to void
  m = 0.0f64
  for i ulong ntr bound 100000
    m = add m get rc_xtr add mul i nf f
  end
  m = div m f64 ntr
  s = 0.0f64
  for i ulong ntr bound 100000
    d = sub get rc_xtr add mul i nf f m
    s = add s mul d d
  end
  sd = fsqrt div s f64 ntr
  if not gt sd 0.0f64
    sd = 1.0f64
  end
  rc_zscore_apply f ntr nte nf m sd
end

fn rc_load_ztr_row i ulong nf ulong no ulong xrow edit f64 256 yrow edit f64 4 to void
  xb = mul i nf
  for f ulong nf bound 256
    put xrow f get rc_ztr add xb f
  end
  yb = mul i no
  for o ulong no bound 4
    put yrow o get rc_ytr add yb o
  end
end

fn rc_ro_accum_ztr_skip ws edit ulong 67334 ntr ulong v0 ulong v1 ulong nf ulong no ulong to int
  xrow = new f64 256 0.0f64
  yrow = new f64 4 0.0f64
  for i ulong ntr bound 100000
    if or lt i v0 ge i v1
      rc_load_ztr_row i nf no xrow yrow
      st = res_ro_ws_accum_row ws view xrow view yrow nf no
      if ne st RES_OK
        ret st
      end
    end
  end
  ret RES_OK
end

fn rc_load_z_row which uint row_i ulong nf ulong xrow edit f64 256 to void
  xb = mul row_i nf
  if eq which 0
    for f ulong nf bound 256
      put xrow f get rc_ztr add xb f
    end
  else
    for f ulong nf bound 256
      put xrow f get rc_zte add xb f
    end
  end
end

fn rc_store_p_row which uint i ulong no ulong yrow view f64 4 to void
  yb = mul i no
  for o ulong no bound 4
    if eq which 0
      put rc_pv add yb o get yrow o
    else
      if eq which 1
        put rc_ptr add yb o get yrow o
      else
        put rc_pte add yb o get yrow o
      end
    end
  end
end

fn rc_ro_apply_global ro view ulong 1031 am view ulong 5 to int
  xrow = new f64 256 0.0f64
  yrow = new f64 4 0.0f64
  wh = uint get am 0
  for i ulong get am 2 bound 100000
    rc_load_z_row wh add get am 1 i get am 3 xrow
    st = res_readout_apply ro view xrow yrow
    if ne st RES_OK
      ret st
    end
    rc_store_p_row wh i get am 4 view yrow
  end
  ret RES_OK
end

fn rc_ro_apply_ztr_ptr ro view ulong 1031 ntr ulong nf ulong no ulong to int
  xrow = new f64 256 0.0f64
  yrow = new f64 4 0.0f64
  for i ulong ntr bound 100000
    rc_load_z_row 0 i nf xrow
    st = res_readout_apply ro view xrow yrow
    if ne st RES_OK
      ret st
    end
    rc_store_p_row 1 i no view yrow
  end
  ret RES_OK
end

fn rc_cv_fold_eval ntr ulong v0 ulong v1 ulong nf ulong no ulong lam f64 to f64
  ws = new ulong 67334 0
  res_ro_ws_zero ws nf
  st = rc_ro_accum_ztr_skip ws ntr v0 v1 nf no
  if ne st RES_OK
    ret -1.0f64
  end
  meta = new ulong 4 0
  put meta 0 sub ntr sub v1 v0
  put meta 1 nf
  put meta 2 no
  put meta 3 bitcast ulong lam
  st = res_ro_ws_finish ws view meta
  if ne st RES_OK
    ret -1.0f64
  end
  ro = new ulong 1031 0
  res_readout_extract view ws view meta ro
  am = new ulong 5 0
  put am 0 0
  put am 1 v0
  put am 2 sub v1 v0
  put am 3 nf
  put am 4 no
  st = rc_ro_apply_global view ro view am
  if ne st RES_OK
    ret -1.0f64
  end
  s = 0.0f64
  for o ulong no bound 4
    s = add s rc_nrmse_ytr_pv v0 sub v1 v0 no o
  end
  ret div s f64 no
end

fn rc_cv_final_fit ntr ulong nte ulong nf ulong no ulong lam f64 to int
  ws = new ulong 67334 0
  res_ro_ws_zero ws nf
  st = rc_ro_accum_ztr_skip ws ntr ntr ntr nf no
  if ne st RES_OK
    ret st
  end
  meta = new ulong 4 0
  put meta 0 ntr
  put meta 1 nf
  put meta 2 no
  put meta 3 bitcast ulong lam
  st = res_ro_ws_finish ws view meta
  if ne st RES_OK
    ret st
  end
  ro = new ulong 1031 0
  res_readout_extract view ws view meta ro
  st = rc_ro_apply_ztr_ptr view ro ntr nf no
  if ne st RES_OK
    ret st
  end
  am = new ulong 5 0
  if gt nte 0
    put am 0 2
    put am 1 0
    put am 2 nte
    put am 3 nf
    put am 4 no
    st = rc_ro_apply_global view ro view am
    if ne st RES_OK
      ret st
    end
  end
  ret RES_OK
end

fn rc_fold_edge k ulong ntr ulong folds ulong to ulong
  num = add mul mul 2 k ntr folds
  ret div num mul 2 folds
end

fn rc_cv_eval_grid_one cv_meta view ulong 5 lam f64 to f64
  ntr = get cv_meta 0
  folds = get cv_meta 4
  score = 0.0f64
  for k ulong folds bound 16
    v0 = rc_fold_edge k ntr folds
    v1 = rc_fold_edge add k 1 ntr folds
    fs = rc_cv_fold_eval ntr v0 v1 get cv_meta 2 get cv_meta 3 lam
    if lt fs 0.0f64
      ret -1.0f64
    end
    score = add score fs
  end
  ret div score f64 folds
end

note cv_meta: [0]=ntr [1]=nte [2]=nf [3]=no [4]=folds
note cv_out: [0]=status(ulong) [1]=bitcast ulong lambda [2]=bitcast ulong cv_score
fn rc_ridge_cv_valid cv_meta view ulong 5 ngrid ulong to bool
  if lt get cv_meta 0 mul 2 get cv_meta 4
    ret false
  end
  if or lt get cv_meta 2 1 lt get cv_meta 3 1
    ret false
  end
  if or lt ngrid 1 lt get cv_meta 4 2
    ret false
  end
  ret true
end

fn rc_ridge_cv cv_meta view ulong 5 grid view f64 * cv_out edit ulong 3 to void
  put cv_out 0 ulong bitcast uint RES_ERR_PARAM
  put cv_out 1 0
  put cv_out 2 0
  if not rc_ridge_cv_valid cv_meta len grid
    ret
  end
  _e = enlarge rc_ztr mul get cv_meta 0 get cv_meta 2
  _e = enlarge rc_zte mul add get cv_meta 1 1 get cv_meta 2
  _e = enlarge rc_pv mul get cv_meta 0 get cv_meta 3
  _e = enlarge rc_ptr mul get cv_meta 0 get cv_meta 3
  _e = enlarge rc_pte mul add get cv_meta 1 1 get cv_meta 3
  for f ulong get cv_meta 2 bound 256
    rc_zscore_col f get cv_meta 0 get cv_meta 1 get cv_meta 2
  end
  best = bitcast f64 ulong 0x7ff0000000000000
  best_g = long -1
  for g ulong len grid bound 256
    sc = rc_cv_eval_grid_one cv_meta get grid g
    if ge sc 0.0f64
      if lt sc best
        best = sc
        best_g = long g
      end
    end
  end
  if lt best_g 0
    put cv_out 0 ulong bitcast uint RES_ERR_SINGULAR
    ret
  end
  blam = get grid ulong best_g
  put cv_out 1 bitcast ulong blam
  put cv_out 2 bitcast ulong best
  put cv_out 0 ulong bitcast uint rc_cv_final_fit get cv_meta 0 get cv_meta 1 get cv_meta 2 get cv_meta 3 blam
end


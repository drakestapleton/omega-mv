note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Omega Visor V1 CLI console (replaces tools/omega.c).
note Composed with src/visor/*.om and src/language/omega_{lex,parse,lower}.om.
note Usage: omega [--json] [--command "<line>"]... [--script <file>|-] [--evidence-root <dir>]

text omcli_f_json "--json"
text omcli_f_cmd "--command"
text omcli_f_scr "--script"
text omcli_f_ev "--evidence-root"
text omcli_f_dash "-"
text omcli_usage "usage: omega [--json] [--command \"<line>\"]... [--script <file>|-] [--evidence-root <dir>]\n"

global omcli_arg uchar 4096
global omcli_sbuf uchar 65536
global omcli_lbuf uchar 4096
global omcli_script uchar 256
global omcli_slen ulong 1
global omcli_cmds uchar 32768
global omcli_clen ulong 32
global omcli_ccnt ulong 1

fn omcli_arg_eq n ulong s view uchar * to bool
  sl = len s
  if ne n sl
    ret false
  end
  for i ulong sl bound 64
    if ne get omcli_arg i get s i
      ret false
    end
  end
  ret true
end

fn omcli_run_fd fd int to long
  rc = long 0
  lpos = ulong 0
  while eq get vcon_quit 0 0 bound 4096
    k = read fd omcli_sbuf 0 4096
    if lt k 0
      ret 1
    end
    if eq k 0
      if gt lpos 0
        for j ulong lpos bound 4096
          put v_sbuf j get omcli_lbuf j
        end
        if ne vcon_exec_sbuf lpos 0
          rc = 1
        end
      end
      break
    end
    kn = ulong k
    for i ulong kn bound 4096
      if ne get vcon_quit 0 0
        break
      end
      b = get omcli_sbuf i
      if eq b uchar 10
        for j ulong lpos bound 4096
          put v_sbuf j get omcli_lbuf j
        end
        if ne vcon_exec_sbuf lpos 0
          rc = 1
        end
        lpos = 0
      else
        if lt lpos 4095
          put omcli_lbuf lpos b
          lpos = add lpos 1
        end
      end
    end
  end
  ret rc
end

fn omcli_push_cmd vn ulong to void
  cc = get omcli_ccnt 0
  if ge cc 32
    ret
  end
  put omcli_ccnt 0 add cc 1
  cl = vn
  if gt cl 1023
    cl = 1023
  end
  put omcli_clen cc cl
  cb = mul cc 1024
  for j ulong cl bound 1024
    put omcli_cmds add cb j get omcli_arg j
  end
end

fn omcli_set_script vn ulong to void
  put omcli_slen 0 vn
  for j ulong vn bound 256
    put omcli_script j get omcli_arg j
  end
end

fn omcli_set_evroot vn ulong to void
  put vcon_evlen 0 vn
  for j ulong vn bound 256
    put vcon_evroot j get omcli_arg j
  end
end

fn omcli_run_cmds to long
  rc = long 0
  cc = get omcli_ccnt 0
  for ci ulong cc bound 32
    if ne get vcon_quit 0 0
      break
    end
    cl = get omcli_clen ci
    cb = mul ci 1024
    for j ulong cl bound 1024
      put v_sbuf j get omcli_cmds add cb j
    end
    if ne vcon_exec_sbuf cl 0
      rc = 1
    end
  end
  ret rc
end

fn main to int
  ac_r = argcnt
  if lt ac_r 0
    ret 2
  end
  ac = ulong ac_r
  isj = ulong 0
  has_scr = false
  scr_stdin = false
  put omcli_ccnt 0 0
  put omcli_slen 0 0
  vcon_init 0
  i = ulong 1
  while lt i ac bound 256
    ar = argread i omcli_arg 0 4095
    if lt ar 0
      v_write_all 2 omcli_usage
      ret 2
    end
    an = ulong ar
    if omcli_arg_eq an omcli_f_json
      isj = 1
      i = add i 1
      continue
    end
    if omcli_arg_eq an omcli_f_cmd
      if ge add i 1 ac
        v_write_all 2 omcli_usage
        ret 2
      end
      i = add i 1
      vr = argread i omcli_arg 0 4095
      if lt vr 0
        v_write_all 2 omcli_usage
        ret 2
      end
      omcli_push_cmd ulong vr
      i = add i 1
      continue
    end
    if omcli_arg_eq an omcli_f_scr
      if ge add i 1 ac
        v_write_all 2 omcli_usage
        ret 2
      end
      i = add i 1
      vr = argread i omcli_arg 0 255
      if lt vr 0
        v_write_all 2 omcli_usage
        ret 2
      end
      has_scr = true
      if omcli_arg_eq ulong vr omcli_f_dash
        scr_stdin = true
      else
        omcli_set_script ulong vr
      end
      i = add i 1
      continue
    end
    if omcli_arg_eq an omcli_f_ev
      if ge add i 1 ac
        v_write_all 2 omcli_usage
        ret 2
      end
      i = add i 1
      vr = argread i omcli_arg 0 255
      if lt vr 0
        v_write_all 2 omcli_usage
        ret 2
      end
      omcli_set_evroot ulong vr
      i = add i 1
      continue
    end
    v_write_all 2 omcli_usage
    ret 2
  end
  put vcon_json 0 isj
  rc = omcli_run_cmds
  if has_scr
    if scr_stdin
      if ne omcli_run_fd 0 0
        rc = 1
      end
    else
      fd = fopen omcli_script 0 get omcli_slen 0 0 0
      if lt fd 0
        ret 2
      end
      if ne omcli_run_fd int fd 0
        rc = 1
      end
      u = fclose int fd
    end
  else
    if eq get omcli_ccnt 0 0
      if ne omcli_run_fd 0 0
        rc = 1
      end
    end
  end
  ret int rc
end

note ---- Low-level buffered I/O (ch: 0=stdout, 1=out, 2=g_rec) ----
fn er_flush ch ulong to void
  if eq ch 0
    n = get g_elen 0
    if gt n 0
      _w = write 1 g_ebuf 0 n
      put g_elen 0 0
    end
  else
    if eq ch 1
      n = get g_olen 0
      fd = get g_ofd 0
      if and gt n 0 ge fd 0
        _w = write int fd g_obuf 0 n
        put g_olen 0 0
      end
    else
      n = get g_rlen 0
      fd = get g_rfd 0
      if and gt n 0 ge fd 0
        _w = write int fd g_rbuf 0 n
        put g_rlen 0 0
      end
    end
  end
end

fn er_putc ch ulong b uchar to void
  if eq ch 0
    n = get g_elen 0
    if ge n 8192
      er_flush 0
      n = 0
    end
    put g_ebuf n b
    put g_elen 0 add n 1
  else
    if eq ch 1
      n = get g_olen 0
      if ge n 8192
        er_flush 1
        n = 0
      end
      put g_obuf n b
      put g_olen 0 add n 1
    else
      n = get g_rlen 0
      if ge n 8192
        er_flush 2
        n = 0
      end
      put g_rbuf n b
      put g_rlen 0 add n 1
    end
  end
end

fn er_puts ch ulong s view uchar * to void
  n = len s
  for i ulong n
    er_putc ch get s i
  end
end

fn er_stderr s view uchar * to void
  n = len s
  for i ulong n
    put g_numbuf i get s i
  end
  _w = write 2 g_numbuf 0 n
end

fn er_put_u64 ch ulong v ulong to void
  if eq v 0
    er_putc ch uchar 48
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_numbuf n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = n
  while gt i 0
    i = sub i 1
    er_putc ch get g_numbuf i
  end
end

fn er_put_i64 ch ulong v long to void
  if lt v 0
    er_putc ch uchar 45
    uv = sub ulong 0 bitcast ulong v
    er_put_u64 ch uv
    ret
  end
  er_put_u64 ch ulong v
end

fn er_is_nan x f64 to bool
  ret ne x x
end

fn er_is_inf x f64 to bool
  if ne x x
    ret false
  end
  ax = x
  if lt ax f64 0.0
    ax = sub f64 0.0 ax
  end
  ret ne sub x x f64 0.0
end

fn er_fabs x f64 to f64
  if lt x f64 0.0
    ret sub f64 0.0 x
  end
  ret x
end

fn er_llround x f64 to long
  if lt x f64 0.0
    ret long sub x f64 0.5
  end
  ret long add x f64 0.5
end

fn er_put_fix_frac ch ulong fr ulong sc ulong to void
  er_putc ch uchar 46
  d = div sc 10
  while gt d 0
    dig = rem div fr d 10
    er_putc ch uchar add 48 dig
    d = div d 10
  end
end

fn er_put_fix ch ulong x f64 dp ulong to void
  if er_is_nan x
    er_puts ch t_er_nan
    ret
  end
  if er_is_inf x
    if lt x f64 0.0
      er_puts ch t_er_ninf
    else
      er_puts ch t_er_inf
    end
    ret
  end
  ax = x
  if lt ax f64 0.0
    er_putc ch uchar 45
    ax = sub f64 0.0 ax
  end
  sc = ulong 1
  for i ulong dp
    sc = mul sc 10
  end
  scaled = ulong add mul ax f64 sc f64 0.5
  er_put_u64 ch div scaled sc
  if gt dp 0
    er_put_fix_frac ch rem scaled sc sc
  end
end

fn er_put_g9_emit ch ulong exp long last ulong to void
  if and ge exp -4 lt exp 9
    if lt exp 0
      er_putc ch uchar 48
      er_putc ch uchar 46
      zs = ulong sub -1 exp
      for i ulong zs
        er_putc ch uchar 48
      end
      for i ulong last
        er_putc ch get g_numbuf i
      end
    else
      ip = add ulong exp 1
      for i ulong ip
        if lt i last
          er_putc ch get g_numbuf i
        else
          er_putc ch uchar 48
        end
      end
      if gt last ip
        er_putc ch uchar 46
        i = ip
        while lt i last
          er_putc ch get g_numbuf i
          i = add i 1
        end
      end
    end
  else
    er_putc ch get g_numbuf 0
    if gt last 1
      er_putc ch uchar 46
      i = ulong 1
      while lt i last
        er_putc ch get g_numbuf i
        i = add i 1
      end
    end
    er_putc ch uchar 101
    if lt exp 0
      er_putc ch uchar 45
      ae = ulong sub 0 exp
      if lt ae 10
        er_putc ch uchar 48
      end
      er_put_u64 ch ae
    else
      er_putc ch uchar 43
      ae = ulong exp
      if lt ae 10
        er_putc ch uchar 48
      end
      er_put_u64 ch ae
    end
  end
end

fn er_put_g9 ch ulong x f64 to void
  if or er_is_nan x er_is_inf x
    er_puts ch t_er_null
    ret
  end
  ax = er_fabs x
  if and lt ax f64 9000000000000000.0 eq f64 long x x
    er_put_i64 ch long x
    ret
  end
  if lt x f64 0.0
    er_putc ch uchar 45
  end
  if eq ax f64 0.0
    er_putc ch uchar 48
    ret
  end
  exp = long 0
  m = ax
  while ge m f64 10.0
    m = div m f64 10.0
    exp = add exp 1
  end
  while lt m f64 1.0
    m = mul m f64 10.0
    exp = sub exp 1
  end
  digs = ulong add mul m f64 100000000.0 f64 0.5
  if ge digs 1000000000
    digs = div digs 10
    exp = add exp 1
  end
  for i ulong 9
    put g_numbuf sub 8 i uchar add 48 rem digs 10
    digs = div digs 10
  end
  last = ulong 9
  while and gt last 1 eq get g_numbuf sub last 1 uchar 48
    last = sub last 1
  end
  er_put_g9_emit ch exp last
end

note ---- C-string helpers on global tables ----
note tbl: 0=g_wf(256), 1=g_tw_cfg(16), 2=g_tw_cnd(8), 3=g_wsa(64), 4=g_wsb(64),
note      5=g_rcfg(16), 6=g_cfgs(16), 7=g_ta_mth(32), 8=g_ts_who(8), 9=g_tp_tag(8)
fn er_tb tbl ulong idx ulong to uchar
  if eq tbl 0
    ret get g_wf idx
  end
  if eq tbl 1
    ret get g_tw_cfg idx
  end
  if eq tbl 2
    ret get g_tw_cnd idx
  end
  if eq tbl 3
    ret get g_wsa idx
  end
  if eq tbl 4
    ret get g_wsb idx
  end
  if eq tbl 5
    ret get g_rcfg idx
  end
  if eq tbl 6
    ret get g_cfgs idx
  end
  if eq tbl 7
    ret get g_ta_mth idx
  end
  if eq tbl 8
    ret get g_ts_who idx
  end
  ret get g_tp_tag idx
end

fn er_put_cs ch ulong tbl ulong off ulong cap ulong to void
  for i ulong cap
    c = er_tb tbl add off i
    if eq c 0
      ret
    end
    er_putc ch c
  end
end

fn er_eq_t tbl ulong off ulong cap ulong s view uchar * to bool
  n = len s
  for i ulong cap
    c = er_tb tbl add off i
    if eq c 0
      ret eq i n
    end
    if ge i n
      ret false
    end
    if ne c get s i
      ret false
    end
  end
  ret eq cap n
end

fn er_eq_tt t1 ulong o1 ulong t2 ulong o2 ulong cap ulong to bool
  for i ulong cap
    a = er_tb t1 add o1 i
    b = er_tb t2 add o2 i
    if ne a b
      ret false
    end
    if eq a 0
      ret true
    end
  end
  ret true
end

fn er_put_hex ch ulong sl ulong lim ulong to void
  bo = mul sl 32
  for i ulong lim
    b = ulong get g_tdig add bo div i 2
    d = and b 15
    if eq rem i 2 0
      d = shr b 4
    end
    c = add 48 d
    if ge d 10
      c = add 87 d
    end
    er_putc ch uchar c
  end
end

fn er_put_status ch ulong s ulong to void
  if eq s 0
    er_puts ch t_ty_s0
    ret
  end
  if eq s 1
    er_puts ch t_ty_s1
    ret
  end
  if eq s 2
    er_puts ch t_ty_s2
    ret
  end
  if eq s 3
    er_puts ch t_ty_s3
    ret
  end
  if eq s 4
    er_puts ch t_ty_s4
    ret
  end
  if eq s 5
    er_puts ch t_ty_s5
    ret
  end
  if eq s 6
    er_puts ch t_ty_s6
    ret
  end
  if eq s 7
    er_puts ch t_ty_s7
    ret
  end
  if eq s 8
    er_puts ch t_ty_s8
    ret
  end
  if eq s 9
    er_puts ch t_ty_s9
    ret
  end
  if eq s 10
    er_puts ch t_ty_s10
    ret
  end
  if eq s 11
    er_puts ch t_ty_s11
    ret
  end
  if eq s 12
    er_puts ch t_ty_s12
    ret
  end
  if eq s 13
    er_puts ch t_ty_s13
    ret
  end
  if eq s 14
    er_puts ch t_ty_s14
    ret
  end
  if eq s 15
    er_puts ch t_ty_s15
    ret
  end
  if eq s 16
    er_puts ch t_ty_s16
    ret
  end
  er_puts ch t_ty_inv
end

fn er_put_conf ch ulong c ulong to void
  if eq c 0
    er_puts ch t_ty_c0
    ret
  end
  if eq c 1
    er_puts ch t_ty_c1
    ret
  end
  if eq c 2
    er_puts ch t_ty_c2
    ret
  end
  if eq c 3
    er_puts ch t_ty_c3
    ret
  end
  if eq c 4
    er_puts ch t_ty_c4
    ret
  end
  if eq c 5
    er_puts ch t_ty_c5
    ret
  end
  er_puts ch t_ty_inv
end

note ---- JSON writer (channel 1) ----
fn o_sep to void
  d = get g_fdepth 0
  if eq get g_fstack d 0
    er_putc 1 uchar 44
  end
  put g_fstack d 0
end

fn o_key k view uchar * to void
  o_sep
  if gt len k 0
    er_putc 1 uchar 34
    er_puts 1 k
    er_putc 1 uchar 34
    er_putc 1 uchar 58
  end
end

fn o_open k view uchar * c uchar to void
  o_key k
  er_putc 1 c
  d = add get g_fdepth 0 1
  put g_fdepth 0 d
  put g_fstack d 1
end

fn o_open_anon c uchar to void
  o_sep
  er_putc 1 c
  d = add get g_fdepth 0 1
  put g_fdepth 0 d
  put g_fstack d 1
end

fn o_close c uchar to void
  er_putc 1 c
  put g_fdepth 0 sub get g_fdepth 0 1
end

fn o_num k view uchar * x f64 to void
  o_key k
  er_put_g9 1 x
end

fn o_u k view uchar * x ulong to void
  o_key k
  er_put_u64 1 x
end

fn o_str k view uchar * s view uchar * to void
  o_key k
  er_putc 1 uchar 34
  er_puts 1 s
  er_putc 1 uchar 34
end

fn o_str_cs k view uchar * tbl ulong off ulong cap ulong to void
  o_key k
  er_putc 1 uchar 34
  er_put_cs 1 tbl off cap
  er_putc 1 uchar 34
end

fn o_bool k view uchar * b bool to void
  o_key k
  if b
    er_puts 1 t_er_true
  else
    er_puts 1 t_er_false
  end
end

note ---- JSON parser ----
fn jp_ws to void
  n = get g_jlen 0
  p = get g_jpos 0
  while lt p n
    c = get g_jbuf p
    if or eq c 32 or eq c 9 or eq c 10 eq c 13
      p = add p 1
    else
      put g_jpos 0 p
      ret
    end
  end
  put g_jpos 0 p
end

fn jp_new t ulong to long
  idx = get g_jn_n 0
  if ge idx ER_MAXN
    ret -1
  end
  put g_jn_n 0 add idx 1
  put g_jn_t idx t
  put g_jn_d idx f64 0.0
  put g_jn_u idx 0
  put g_jn_iu idx 0
  put g_jn_so idx 0
  put g_jn_sl idx 0
  put g_jn_ko idx 0
  put g_jn_kl idx 0
  put g_jn_fc idx 0
  put g_jn_lc idx 0
  put g_jn_nx idx 0
  put g_jn_cnt idx 0
  ret long idx
end

fn jp_str_raw to long
  n = get g_jlen 0
  p = get g_jpos 0
  if or ge p n ne get g_jbuf p uchar 34
    ret -1
  end
  p = add p 1
  so = get g_jslen 0
  sl = ulong 0
  while lt p n
    c = get g_jbuf p
    if eq c uchar 34
      put g_jpos 0 add p 1
      put g_jslen 0 add so sl
      put g_tidx 0 so
      put g_tidx 1 sl
      ret 0
    end
    p = add p 1
    if and eq c uchar 92 lt p n
      c = get g_jbuf p
      p = add p 1
    end
    if lt add so sl 65536
      put g_jstr add so sl c
      sl = add sl 1
    end
  end
  ret -1
end

fn jp_match s view uchar * to bool
  n = get g_jlen 0
  p = get g_jpos 0
  m = len s
  if gt add p m n
    ret false
  end
  for i ulong m
    if ne get g_jbuf add p i get s i
      ret false
    end
  end
  put g_jpos 0 add p m
  ret true
end

fn jp_is_dig p ulong n ulong to bool
  if ge p n
    ret false
  end
  c = get g_jbuf p
  ret and ge c uchar 48 le c uchar 57
end

fn jp_parse_exp fl f64 to f64
  n = get g_jlen 0
  p = get g_jpos 0
  eneg = false
  if lt p n
    ec = get g_jbuf p
    if eq ec uchar 45
      eneg = true
      p = add p 1
    else
      if eq ec uchar 43
        p = add p 1
      end
    end
  end
  ev = ulong 0
  while jp_is_dig p n
    ev = add mul ev 10 ulong sub get g_jbuf p uchar 48
    p = add p 1
  end
  put g_jpos 0 p
  res = fl
  for i ulong ev
    if eneg
      res = div res f64 10.0
    else
      res = mul res f64 10.0
    end
  end
  ret res
end

fn jp_parse_frac fl f64 to f64
  n = get g_jlen 0
  p = get g_jpos 0
  sc = f64 0.1
  res = fl
  while jp_is_dig p n
    d = ulong sub get g_jbuf p uchar 48
    res = add res mul f64 d sc
    sc = mul sc f64 0.1
    p = add p 1
  end
  put g_jpos 0 p
  ret res
end

fn jp_parse_num to long
  n = get g_jlen 0
  p = get g_jpos 0
  if ge p n
    ret -1
  end
  negv = false
  if eq get g_jbuf p uchar 45
    negv = true
    p = add p 1
  end
  if not jp_is_dig p n
    ret -1
  end
  u = ulong 0
  fl = f64 0.0
  is_u = true
  if negv
    is_u = false
  end
  while jp_is_dig p n
    d = ulong sub get g_jbuf p uchar 48
    if or gt u 1844674407370955161 and eq u 1844674407370955161 gt d 5
      is_u = false
    else
      u = add mul u 10 d
    end
    fl = add mul fl f64 10.0 f64 d
    p = add p 1
  end
  put g_jpos 0 p
  if and lt p n eq get g_jbuf p uchar 46
    is_u = false
    put g_jpos 0 add p 1
    fl = jp_parse_frac fl
    p = get g_jpos 0
  end
  if lt p n
    ec = get g_jbuf p
    if or eq ec uchar 101 eq ec uchar 69
      is_u = false
      put g_jpos 0 add p 1
      fl = jp_parse_exp fl
    end
  end
  nd = jp_new JT_NUM
  if lt nd 0
    ret -1
  end
  ni = ulong nd
  if is_u
    put g_jn_u ni u
    put g_jn_iu ni 1
    put g_jn_d ni f64 u
  else
    if negv
      fl = sub f64 0.0 fl
    end
    put g_jn_d ni fl
  end
  ret nd
end

fn jp_push par ulong ch ulong to void
  fc = get g_jn_fc par
  if eq fc 0
    put g_jn_fc par ch
    put g_jn_lc par ch
  else
    lc = get g_jn_lc par
    put g_jn_nx lc ch
    put g_jn_lc par ch
  end
  put g_jn_cnt par add get g_jn_cnt par 1
end

fn jp_parse to long
  jp_ws
  n = get g_jlen 0
  p = get g_jpos 0
  if ge p n
    ret -1
  end
  c = get g_jbuf p
  if eq c uchar 123
    put g_jpos 0 add p 1
    nd = jp_new JT_OBJ
    if lt nd 0
      ret -1
    end
    obj = ulong nd
    jp_ws
    p2 = get g_jpos 0
    if and lt p2 n eq get g_jbuf p2 uchar 125
      put g_jpos 0 add p2 1
      ret nd
    end
    while true
      jp_ws
      if lt jp_str_raw 0
        ret -1
      end
      ko = get g_tidx 0
      kl = get g_tidx 1
      jp_ws
      p3 = get g_jpos 0
      if or ge p3 n ne get g_jbuf p3 uchar 58
        ret -1
      end
      put g_jpos 0 add p3 1
      val = jp_parse
      if lt val 0
        ret -1
      end
      vi = ulong val
      put g_jn_ko vi ko
      put g_jn_kl vi kl
      jp_push obj vi
      jp_ws
      p4 = get g_jpos 0
      if ge p4 n
        ret -1
      end
      c4 = get g_jbuf p4
      if eq c4 uchar 44
        put g_jpos 0 add p4 1
      else
        if eq c4 uchar 125
          put g_jpos 0 add p4 1
          ret nd
        else
          ret -1
        end
      end
    end
  end
  if eq c uchar 91
    put g_jpos 0 add p 1
    nd = jp_new JT_ARR
    if lt nd 0
      ret -1
    end
    arr = ulong nd
    jp_ws
    p2 = get g_jpos 0
    if and lt p2 n eq get g_jbuf p2 uchar 93
      put g_jpos 0 add p2 1
      ret nd
    end
    while true
      val = jp_parse
      if lt val 0
        ret -1
      end
      jp_push arr ulong val
      jp_ws
      p4 = get g_jpos 0
      if ge p4 n
        ret -1
      end
      c4 = get g_jbuf p4
      if eq c4 uchar 44
        put g_jpos 0 add p4 1
      else
        if eq c4 uchar 93
          put g_jpos 0 add p4 1
          ret nd
        else
          ret -1
        end
      end
    end
  end
  if eq c uchar 34
    if lt jp_str_raw 0
      ret -1
    end
    nd = jp_new JT_STR
    if lt nd 0
      ret -1
    end
    put g_jn_so ulong nd get g_tidx 0
    put g_jn_sl ulong nd get g_tidx 1
    ret nd
  end
  if jp_match t_er_true
    nd = jp_new JT_BOOL
    if ge nd 0
      put g_jn_d ulong nd f64 1.0
    end
    ret nd
  end
  if jp_match t_er_false
    ret jp_new JT_BOOL
  end
  if jp_match t_er_null
    ret jp_new JT_NULL
  end
  ret jp_parse_num
end

fn jget o long k view uchar * to long
  if lt o 0
    ret -1
  end
  if ne get g_jn_t ulong o JT_OBJ
    ret -1
  end
  kl = len k
  cur = get g_jn_fc ulong o
  while gt cur 0
    if eq get g_jn_kl cur kl
      ko = get g_jn_ko cur
      ok = true
      for i ulong kl
        if ne get g_jstr add ko i get k i
          ok = false
        end
      end
      if ok
        ret long cur
      end
    end
    cur = get g_jn_nx cur
  end
  ret -1
end

fn jarr_at a long idx ulong to long
  if lt a 0
    ret -1
  end
  if ne get g_jn_t ulong a JT_ARR
    ret -1
  end
  if ge idx get g_jn_cnt ulong a
    ret -1
  end
  cur = get g_jn_fc ulong a
  for i ulong idx
    cur = get g_jn_nx cur
  end
  ret long cur
end

fn jd o long k view uchar * to f64
  v = jget o k
  if lt v 0
    ret div f64 0.0 f64 0.0
  end
  if ne get g_jn_t ulong v JT_NUM
    ret div f64 0.0 f64 0.0
  end
  ret get g_jn_d ulong v
end

fn ju o long k view uchar * to ulong
  v = jget o k
  if lt v 0
    ret 0
  end
  vi = ulong v
  if ne get g_jn_t vi JT_NUM
    ret 0
  end
  if ne get g_jn_iu vi 0
    ret get g_jn_u vi
  end
  d = get g_jn_d vi
  if lt d f64 0.0
    ret 0
  end
  ret ulong d
end

fn jau a long idx ulong to ulong
  v = jarr_at a idx
  if lt v 0
    ret 0
  end
  ret get g_jn_u ulong v
end

fn jstr_len o long k view uchar * to ulong
  v = jget o k
  if lt v 0
    ret 0
  end
  if ne get g_jn_t ulong v JT_STR
    ret 0
  end
  ret get g_jn_sl ulong v
end

fn jcopy_str o long k view uchar * dst ulong off ulong cap ulong to void
  v = jget o k
  so = ulong 0
  sl = ulong 0
  if ge v 0
    if eq get g_jn_t ulong v JT_STR
      so = get g_jn_so ulong v
      sl = get g_jn_sl ulong v
    end
  end
  lim = sub cap 1
  if lt sl lim
    lim = sl
  end
  for i ulong cap
    c = uchar 0
    if lt i lim
      c = get g_jstr add so i
    end
    if eq dst 0
      put g_tw_run add off i c
    else
      if eq dst 1
        put g_tw_cfg add off i c
      else
        if eq dst 2
          put g_tw_cnd add off i c
        else
          if eq dst 3
            put g_wsa add off i c
          else
            if eq dst 4
              put g_wsb add off i c
            else
              if eq dst 5
                put g_tp_tag add off i c
              else
                if eq dst 6
                  put g_tp_rz add off i c
                else
                  put g_tp_cpu add off i c
                end
              end
            end
          end
        end
      end
    end
  end
end

note ---- edge_shape / energy_ok / win_pkg_uj / cpu_mask ----
fn j_is_u x long to bool
  if lt x 0
    ret false
  end
  ux = ulong x
  if ne get g_jn_t ux JT_NUM
    ret false
  end
  ret ne get g_jn_iu ux 0
end

fn j_is_arr x long to bool
  if lt x 0
    ret false
  end
  ret eq get g_jn_t ulong x JT_ARR
end

fn j_is_obj x long to bool
  if lt x 0
    ret false
  end
  ret eq get g_jn_t ulong x JT_OBJ
end

fn arr_all_u a ulong to bool
  cur = get g_jn_fc a
  while gt cur 0
    if ne get g_jn_t cur JT_NUM
      ret false
    end
    if eq get g_jn_iu cur 0
      ret false
    end
    cur = get g_jn_nx cur
  end
  ret true
end

fn edge_shape e long to bool
  if lt e 0
    ret false
  end
  fl = jget e t_jk_sok
  if not j_is_u fl
    ret false
  end
  if gt get g_jn_u ulong fl 1
    ret false
  end
  tm = jget e t_jk_tns
  if not j_is_u tm
    ret false
  end
  en = jget e t_jk_euj
  if not j_is_arr en
    ret false
  end
  if lt get g_jn_cnt ulong en TY_NCH
    ret false
  end
  ov = jget e t_jk_ovf
  if not j_is_arr ov
    ret false
  end
  if lt get g_jn_cnt ulong ov TY_NCH
    ret false
  end
  if not arr_all_u ulong en
    ret false
  end
  ret arr_all_u ulong ov
end

fn energy_ok e long to bool
  if lt e 0
    ret false
  end
  d = jd e t_jk_sok
  if er_is_nan d
    ret false
  end
  if eq long d 0
    ret false
  end
  ov = jget e t_jk_ovf
  if j_is_arr ov
    cur = get g_jn_fc ulong ov
    while gt cur 0
      if ne get g_jn_u cur 0
        ret false
      end
      cur = get g_jn_nx cur
    end
  end
  ret true
end

fn tp_cpu_dig bo ulong i ulong to bool
  if ge i 32
    ret false
  end
  c = get g_tp_cpu add bo i
  ret and ge c uchar 48 le c uchar 57
end

fn cpu_mask_tp p ulong to void
  bo = mul p 32
  i = ulong 0
  while lt i 32
    c = get g_tp_cpu add bo i
    if eq c 0
      ret
    end
    if and ge c uchar 48 le c uchar 57
      v = ulong 0
      while tp_cpu_dig bo i
        v = add mul v 10 ulong sub get g_tp_cpu add bo i uchar 48
        i = add i 1
      end
      if lt v 64
        put g_used v 1
      end
      if lt i 32
        if eq get g_tp_cpu add bo i uchar 44
          i = add i 1
        end
      end
    else
      ret
    end
  end
end

fn fill_clear w ulong to void
  for i ulong 64
    put g_tw_run add mul w 64 i uchar 0
    put g_wsa add mul w 64 i uchar 0
    put g_wsb add mul w 64 i uchar 0
  end
  for i ulong 16
    put g_tw_cfg add mul w 16 i uchar 0
  end
  for i ulong 8
    put g_tw_cnd add mul w 8 i uchar 0
  end
  put g_tw_rnd w 0
  put g_tw_pos w 0
  put g_tw_t0 w 0
  put g_tw_t1 w 0
  put g_tw_pl w 0
  put g_tw_ok0 w 0
  put g_tw_ok1 w 0
  put g_tw_ovf w 0
  put g_tw_ns w 0
  put g_tw_mg w 0
  put g_tw_fb w 0
  put g_tw_mt w 0
  put g_tw_np w 0
  for c ulong 3
    put g_tw_e0 add mul w 3 c 0
    put g_tw_e1 add mul w 3 c 0
  end
  for c ulong 4
    put g_we add mul w 4 c 0
  end
  put g_wcyc w f64 0.0
  put g_wins w f64 0.0
  put g_wl2 w f64 0.0
end

fn fill_pmu_mux ps ulong ls long to void
  if not j_is_arr ls
    ret
  end
  lcur = get g_jn_fc ulong ls
  while gt lcur 0
    va = jget long lcur t_jk_val
    en = jget long lcur t_jk_en
    ru = jget long lcur t_jk_ru
    any = ulong 0
    for e ulong 6
      any = or any jau va e
    end
    if ne any 0
      for e ulong 6
        mul128 jau ru e 1000 0
        mul128 jau en e 999 2
        h0 = get g_m128 1
        h1 = get g_m128 3
        if lt h0 h1
          put g_tp_mx ps 1
        else
          if eq h0 h1
            l0 = get g_m128 0
            l1 = get g_m128 2
            if lt l0 l1
              put g_tp_mx ps 1
            end
          end
        end
      end
    end
    lcur = get g_jn_nx lcur
  end
end

fn fill_part_one w ulong ps ulong pcur ulong to void
  for j ulong 8
    put g_tp_tag add mul ps 8 j uchar 0
  end
  for j ulong 32
    put g_tp_rz add mul ps 32 j uchar 0
    put g_tp_cpu add mul ps 32 j uchar 0
  end
  put g_tp_go ps 0
  put g_tp_t0 ps 0
  put g_tp_t1 ps 0
  put g_tp_dn ps 0
  put g_tp_pl ps 0
  put g_tp_cl ps 0
  put g_tp_cy ps 0
  put g_tp_in ps 0
  put g_tp_l2 ps 0
  put g_tp_pn ps 0
  put g_tp_or ps 0
  put g_tp_ex ps 0
  put g_tp_pm ps 0
  put g_tp_mx ps 0
  if eq jd long pcur t_jk_ok f64 1.0
    put g_tp_ex ps 1
  end
  res = jget long pcur t_jk_res
  if not j_is_obj res
    ret
  end
  jcopy_str res t_jk_tag 5 mul ps 8 8
  jcopy_str res t_jk_rz 6 mul ps 32 32
  jcopy_str res t_jk_cpus 7 mul ps 32 32
  cpu_mask_tp ps
  if eq jd res t_jk_pin f64 1.0
    put g_tp_pn ps 1
  end
  if eq jd res t_jk_ook f64 1.0
    put g_tp_or ps 1
  end
  put g_tp_pl ps ju res t_jk_pl
  put g_tp_go ps ju res t_jk_go
  put g_tp_t0 ps ju res t_jk_t0
  put g_tp_t1 ps ju res t_jk_t1
  put g_tp_dn ps ju res t_jk_dn
  put g_tp_cl ps ju res t_jk_cl
  pm = jget res t_jk_pmu
  sm = jget pm t_jk_sum
  if and eq jd res t_jk_pop f64 1.0 eq jd pm t_jk_ok f64 1.0
    put g_tp_pm ps 1
  end
  cy = ju sm t_jk_cyc
  ins = ju sm t_jk_ins
  l2 = ju sm t_jk_l2
  put g_tp_cy ps cy
  put g_tp_in ps ins
  put g_tp_l2 ps l2
  fill_pmu_mux ps jget pm t_jk_pmu
  put g_wcyc w add get g_wcyc w f64 cy
  put g_wins w add get g_wins w f64 ins
  put g_wl2 w add get g_wl2 w f64 l2
end

fn fill_part w ulong r long to void
  parts = jget r t_jk_parts
  if not j_is_arr parts
    ret
  end
  pcur = get g_jn_fc ulong parts
  while and gt pcur 0 lt get g_tw_np w TY_MAX_PART
    pi = get g_tw_np w
    put g_tw_np w add pi 1
    fill_part_one w add mul w 4 pi pcur
    pcur = get g_jn_nx pcur
  end
end

fn fill_temp tz long mt ulong to ulong
  res = mt
  if not j_is_arr tz
    ret res
  end
  cur = get g_jn_fc ulong tz
  while gt cur 0
    if j_is_u long cur
      uv = get g_jn_u cur
      if le uv 4294967295
        if gt uv res
          res = uv
        end
      end
    end
    cur = get g_jn_nx cur
  end
  ret res
end

fn fill_sys w ulong r long to void
  s0 = jget r t_jk_s0
  s1 = jget r t_jk_s1
  b0 = jget s0 t_jk_bj
  b1 = jget s1 t_jk_bj
  busy = ulong 0
  if and j_is_arr b0 j_is_arr b1
    nb = get g_jn_cnt ulong b0
    if gt nb 64
      nb = 64
    end
    for c ulong nb
      if eq get g_used c 0
        v0 = jau b0 c
        v1 = jau b1 c
        if ge v1 v0
          busy = add busy sub v1 v0
        end
      end
    end
  end
  put g_tw_fb w mul busy 10
  mt = fill_temp jget s0 t_jk_tm 0
  mt = fill_temp jget s1 t_jk_tm mt
  put g_tw_mt w mt
end

fn tc_ok tc f64 to bool
  if or er_is_nan tc er_is_inf tc
    ret false
  end
  if or lt tc f64 0.0 ge tc f64 64.0
    ret false
  end
  ret eq f64 long tc tc
end

fn fill_tel w ulong r long to void
  t0 = get g_tw_t0 w
  t1 = get g_tw_t1 w
  tel = jget r t_jk_tel
  tt = jget tel t_jk_tns
  tok = jget tel t_jk_ok
  prev = t0
  gap = ulong 0
  ns = ulong 0
  if j_is_arr tt
    nt = get g_jn_cnt ulong tt
    for i ulong nt
      if ne jau tok i 0
        tv = jau tt i
        if gt tv prev
          dg = sub tv prev
          if gt dg gap
            gap = dg
          end
          prev = tv
        end
        ns = add ns 1
      end
    end
  end
  if gt t1 prev
    dg = sub t1 prev
    if gt dg gap
      gap = dg
    end
  end
  put g_tw_ns w ns
  put g_tw_mg w gap
end

fn fill_win_euj w ulong e0 long e1 long to void
  ea0 = jget e0 t_jk_euj
  ea1 = jget e1 t_jk_euj
  bo = mul w 3
  for c ulong TY_NCH
    put g_tw_e0 add bo c jau ea0 c
    put g_tw_e1 add bo c jau ea1 c
  end
end

fn fill_win_edges w ulong r long to bool
  e0 = jget r t_jk_e0
  e1 = jget r t_jk_e1
  tc = jd r t_jk_tcpu
  if or not edge_shape e0 or not edge_shape e1 not tc_ok tc
    put g_tw_pl w 0
    put g_wst w TYE_E_ARG
    ret false
  end
  meter = eq jd r t_jk_mok f64 1.0
  put g_tw_t0 w ju e0 t_jk_tns
  put g_tw_t1 w ju e1 t_jk_tns
  s0ok = and meter eq jd e0 t_jk_sok f64 1.0
  s1ok = and meter eq jd e1 t_jk_sok f64 1.0
  if s0ok
    put g_tw_ok0 w 1
    if not energy_ok e0
      put g_tw_ovf w 1
    end
  end
  if s1ok
    put g_tw_ok1 w 1
    if not energy_ok e1
      put g_tw_ovf w 1
    end
  end
  fill_win_euj w e0 e1
  for i ulong 64
    put g_used i 0
  end
  put g_used ulong long tc 1
  ret true
end

fn fill_win w ulong r long to void
  fill_clear w
  rp = jget r t_jk_parts
  if ge rp 0
    if or ne get g_jn_t ulong rp JT_ARR gt get g_jn_cnt ulong rp TY_MAX_PART
      put g_wst w TYE_E_ARG
      ret
    end
  end
  if or ge jstr_len r t_jk_run 64 or ge jstr_len r t_jk_cfg 16 ge jstr_len r t_jk_lvl 8
    put g_wst w TYE_E_ARG
    ret
  end
  if or gt ju r t_jk_rnd 4294967295 gt ju r t_jk_trl 4294967295
    put g_wst w TYE_E_ARG
    ret
  end
  jcopy_str r t_jk_run 0 mul w 64 64
  jcopy_str r t_jk_cfg 1 mul w 16 16
  jcopy_str r t_jk_lvl 2 mul w 8 8
  jcopy_str r t_jk_sa 3 mul w 64 64
  jcopy_str r t_jk_sb 4 mul w 64 64
  put g_tw_rnd w ju r t_jk_rnd
  put g_tw_pos w ju r t_jk_trl
  put g_tw_pl w ju r t_jk_pl
  if not fill_win_edges w r
    ret
  end
  fill_tel w r
  fill_part w r
  fill_sys w r
  put g_wst w ty_interval_check w
  _d = ty_interval_digest w w
  for c ulong TY_NCH
    if eq ty_interval_energy w long c TYE_OK
      put g_we add mul w 4 c get g_tret 0
    else
      put g_we add mul w 4 c 0
    end
  end
  e_pkg = get g_we mul w 4
  e_ce = get g_we add mul w 4 1
  e_cp = get g_we add mul w 4 2
  put g_we add mul w 4 3 sub sub e_pkg e_ce e_cp
end

note ---- Directory loading ----
fn fn_is_jsonl off ulong nl ulong to bool
  if lt nl 7
    ret false
  end
  for i ulong 6
    if ne get g_fn_b add off add sub nl 6 i get t_er_jsonl i
      ret false
    end
  end
  ret true
end

fn fn_lt a ulong b ulong to bool
  la = get g_fn_l a
  lb = get g_fn_l b
  oa = mul a 256
  ob = mul b 256
  lim = la
  if lt lb lim
    lim = lb
  end
  for i ulong lim
    ca = get g_fn_b add oa i
    cb = get g_fn_b add ob i
    if ne ca cb
      ret lt ca cb
    end
  end
  ret lt la lb
end

fn dent_add pos ulong rl ulong to void
  ns = add pos 19
  nl = ulong 0
  lim = add pos rl
  while lt add ns nl lim
    if eq get g_edent add ns nl uchar 0
      break
    end
    nl = add nl 1
  end
  if or ge nl 255 ge get g_fn_n 0 ER_MAXW
    ret
  end
  idx = get g_fn_n 0
  ob = mul idx 256
  for i ulong nl
    put g_fn_b add ob i get g_edent add ns i
  end
  put g_fn_b add ob nl uchar 0
  if fn_is_jsonl ob nl
    put g_fn_l idx nl
    put g_fn_o idx idx
    put g_fn_n 0 add idx 1
  end
end

fn scan_dir to long
  dl = get g_eal 2
  fd = fopen g_ea2 0 dl 0 0
  if lt fd 0
    ret -1
  end
  put g_fn_n 0 0
  while true
    n = getdnts int fd g_edent 0 16384
    if le n 0
      break
    end
    pos = ulong 0
    un = ulong n
    while lt pos un
      b0 = ulong get g_edent add pos 16
      b1 = ulong get g_edent add pos 17
      rl = or b0 shl b1 8
      if eq rl 0
        break
      end
      dent_add pos rl
      pos = add pos rl
    end
  end
  _fc = fclose int fd
  if eq get g_fn_n 0 0
    ret -1
  end
  ret 0
end

fn sort_dir to void
  nf = get g_fn_n 0
  i = ulong 1
  while lt i nf
    k = get g_fn_o i
    j = i
    while gt j 0
      pv = get g_fn_o sub j 1
      if not fn_lt k pv
        break
      end
      put g_fn_o j pv
      j = sub j 1
    end
    put g_fn_o j k
    i = add i 1
  end
end

fn prep_path oi ulong w ulong to ulong
  dl = get g_eal 2
  nl = get g_fn_l oi
  ob = mul oi 256
  for k ulong dl
    put g_epath k get g_ea2 k
  end
  put g_epath dl uchar 47
  for k ulong nl
    put g_epath add add dl 1 k get g_fn_b add ob k
  end
  put g_epath add add dl 1 nl uchar 0
  wo = mul w 256
  for k ulong nl
    put g_wf add wo k get g_fn_b add ob k
  end
  put g_wf add wo nl uchar 0
  put g_wfl w nl
  ret add add dl 1 nl
end

fn load_one fi ulong to bool
  oi = get g_fn_o fi
  w = get g_nw 0
  plen = prep_path oi w
  ffd = fopen g_epath 0 plen 0 0
  if lt ffd 0
    ret false
  end
  tot = ulong 0
  while lt tot 262140
    rd = read int ffd g_jbuf tot sub 262140 tot
    if le rd 0
      break
    end
    tot = add tot ulong rd
  end
  _fc2 = fclose int ffd
  put g_jbuf tot uchar 0
  put g_jlen 0 tot
  put g_jpos 0 0
  put g_jn_n 0 1
  put g_jslen 0 0
  root = jp_parse
  jp_ws
  if or lt root 0 or not j_is_obj root ne get g_jpos 0 tot
    er_put_cs 0 0 mul w 256 256
    er_flush 0
    er_stderr t_er_notobj
    ret false
  end
  fill_win w root
  put g_nw 0 add w 1
  ret true
end

fn load_dir to long
  if lt scan_dir 0
    ret -1
  end
  sort_dir
  inv = false
  put g_nw 0 0
  nf = get g_fn_n 0
  for fi ulong nf
    if not load_one fi
      inv = true
    end
  end
  if inv
    ret -1
  end
  nw = get g_nw 0
  for i ulong nw
    j = add i 1
    while lt j nw
      put g_tidx 0 i
      put g_tidx 1 j
      if eq ty_intervals_disjoint 2 TYE_E_OVERLAP
        put g_wst i TYE_E_OVERLAP
        put g_wst j TYE_E_OVERLAP
        er_puts 0 t_er_ovl
        er_put_cs 0 0 mul i 256 256
        er_putc 0 uchar 32
        er_put_cs 0 0 mul j 256 256
        er_putc 0 uchar 10
      end
      j = add j 1
    end
  end
  ret 0
end

note ---- Statistics ----
fn init_tq to void
  put g_tq 0 div f64 0.0 f64 0.0
  put g_tq 1 f64 12.706
  put g_tq 2 f64 4.303
  put g_tq 3 f64 3.182
  put g_tq 4 f64 2.776
  put g_tq 5 f64 2.571
  put g_tq 6 f64 2.447
  put g_tq 7 f64 2.365
  put g_tq 8 f64 2.306
  put g_tq 9 f64 2.262
  put g_tq 10 f64 2.228
  put g_tq 11 f64 2.201
  put g_tq 12 f64 2.179
  put g_tq 13 f64 2.160
  put g_tq 14 f64 2.145
  put g_tq 15 f64 2.131
  put g_tq 16 f64 2.120
  put g_tq 17 f64 2.110
  put g_tq 18 f64 2.101
  put g_tq 19 f64 2.093
  put g_tq 20 f64 2.086
  put g_tq 21 f64 2.080
  put g_tq 22 f64 2.074
  put g_tq 23 f64 2.069
  put g_tq 24 f64 2.064
  put g_tq 25 f64 2.060
  put g_tq 26 f64 2.056
  put g_tq 27 f64 2.052
  put g_tq 28 f64 2.048
  put g_tq 29 f64 2.045
  put g_tq 30 f64 2.042
end

fn tq975 df long to f64
  if lt df 1
    ret div f64 0.0 f64 0.0
  end
  if le df 30
    ret get g_tq ulong df
  end
  if le df 60
    ret f64 2.042
  end
  if le df 120
    ret f64 2.000
  end
  ret f64 1.96
end

fn splitmix to ulong
  z = add get g_rng 0 ulong 0x9e3779b97f4a7c15
  put g_rng 0 z
  z = mul xor z shr z 30 ulong 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 ulong 0x94d049bb133111eb
  ret xor z shr z 31
end

fn mean_sd_sv n ulong which ulong to void
  nan = div f64 0.0 f64 0.0
  if eq n 0
    put g_ms 0 nan
    put g_ms 1 nan
    ret
  end
  s = f64 0.0
  for i ulong n
    if eq which 0
      s = add s get g_sv i
    else
      s = add s get g_sv2 i
    end
  end
  m = div s f64 n
  put g_ms 0 m
  if le n 1
    put g_ms 1 nan
    ret
  end
  q = f64 0.0
  for i ulong n
    v = f64 0.0
    if eq which 0
      v = get g_sv i
    else
      v = get g_sv2 i
    end
    d = sub v m
    q = add q mul d d
  end
  put g_ms 1 fsqrt div q f64 sub n 1
end

fn heap_sift start ulong endi ulong to void
  r = start
  while le add mul r 2 1 endi
    ch = add mul r 2 1
    sw = r
    if lt get g_boot sw get g_boot ch
      sw = ch
    end
    if le add ch 1 endi
      c2 = add ch 1
      if lt get g_boot sw get g_boot c2
        sw = c2
      end
    end
    if eq sw r
      ret
    end
    tmp = get g_boot r
    put g_boot r get g_boot sw
    put g_boot sw tmp
    r = sw
  end
end

fn sort_boot n ulong to void
  if le n 1
    ret
  end
  i = div n 2
  while gt i 0
    i = sub i 1
    heap_sift i sub n 1
  end
  ei = sub n 1
  while gt ei 0
    tmp = get g_boot ei
    put g_boot ei get g_boot 0
    put g_boot 0 tmp
    ei = sub ei 1
    heap_sift 0 ei
  end
end

fn boot_mean_sv n ulong to void
  nan = div f64 0.0 f64 0.0
  put g_ms 2 nan
  put g_ms 3 nan
  if lt n 2
    ret
  end
  put g_rng 0 21
  for b ulong ER_RESAMP
    s = f64 0.0
    for i ulong n
      idx = rem splitmix n
      s = add s get g_sv idx
    end
    put g_boot b div s f64 n
  end
  sort_boot ER_RESAMP
  put g_ms 2 get g_boot 249
  put g_ms 3 get g_boot 9749
end

note ---- Rounds ----
fn cond_idx w ulong to long
  bo = mul w 8
  if er_eq_t 2 bo 8 t_c_idle
    ret 0
  end
  if er_eq_t 2 bo 8 t_c_a
    ret 1
  end
  if er_eq_t 2 bo 8 t_c_b
    ret 2
  end
  if er_eq_t 2 bo 8 t_c_ab
    ret 3
  end
  ret -1
end

fn build_round_iv k ulong to void
  u0 = ulong get g_rc mul k 4
  u1 = ulong get g_rc add mul k 4 1
  u2 = ulong get g_rc add mul k 4 2
  u3 = ulong get g_rc add mul k 4 3
  for c ulong 4
    iv = get g_we add mul u3 4 c
    iv = sub iv get g_we add mul u1 4 c
    iv = sub iv get g_we add mul u2 4 c
    iv = add iv get g_we add mul u0 4 c
    put g_ri add mul k 4 c div f64 iv f64 1000000.0
  end
  vr = f64 0.0
  s3 = fsqrt f64 3.0
  for c ulong 4
    cw = ulong get g_rc add mul k 4 c
    ej = div f64 get g_we mul cw 4 f64 1000000.0
    ts = div f64 get g_tw_pl cw f64 1000000000.0
    pw = div ej ts
    sde = div mul pw f64 0.1 s3
    vr = add vr mul f64 2.0 mul sde sde
  end
  put g_rb95 k mul f64 1.96 fsqrt vr
end

fn build_round_eval k ulong to void
  nan = div f64 0.0 f64 0.0
  for c ulong 4
    put g_ri add mul k 4 c nan
  end
  put g_rb95 k nan
  if ne get g_rst k TYE_OK
    ret
  end
  w0 = get g_rc mul k 4
  w1 = get g_rc add mul k 4 1
  w2 = get g_rc add mul k 4 2
  w3 = get g_rc add mul k 4 3
  if or lt w1 0 or lt w2 0 lt w3 0
    put g_rst k TYE_E_CONDITION
    ret
  end
  if lt w0 0
    put g_rst k TYE_E_MISSING_IDLE
    ret
  end
  st = ty_interaction ulong w0 ulong w1 ulong w2 ulong w3 long TY_CH_PKG
  if eq st TYE_OK
    for c ulong 4
      cw = ulong get g_rc add mul k 4 c
      if ne get g_wst cw TYE_OK
        st = get g_wst cw
      end
    end
  end
  put g_rst k st
  if eq st TYE_OK
    build_round_iv k
  end
end

fn round_add_win i ulong to void
  rnd = get g_tw_rnd i
  nr = get g_nr 0
  found = long -1
  for k ulong nr
    if lt found 0
      if and er_eq_tt 5 mul k 16 1 mul i 16 16 eq get g_rrnd k rnd
        found = long k
      end
    end
  end
  if lt found 0
    found = long nr
    put g_nr 0 add nr 1
    ro = mul nr 16
    wo = mul i 16
    for j ulong 16
      ch = get g_tw_cfg add wo j
      put g_rcfg add ro j ch
    end
    put g_rrnd nr rnd
    put g_rst nr TYE_OK
    for c ulong 4
      put g_rc add mul nr 4 c -1
    end
  end
  ri = ulong found
  ci = cond_idx i
  if lt ci 0
    put g_rst ri TYE_E_CONDITION
    ret
  end
  slot = add mul ri 4 ulong ci
  if ge get g_rc slot 0
    put g_rst ri TYE_E_DOUBLE_COUNT
  else
    put g_rc slot long i
  end
end

fn build_rounds to void
  put g_nr 0 0
  nw = get g_nw 0
  for i ulong nw
    round_add_win i
  end
  nr = get g_nr 0
  for k ulong nr
    build_round_eval k
  end
end

note ---- Linear fit (3x3 OLS + Jacobi eigenvalues) ----
fn m2 i0 ulong i1 ulong i2 ulong i3 ulong to f64
  ret sub mul get g_fxtx i0 get g_fxtx i1 mul get g_fxtx i2 get g_fxtx i3
end

fn inv3_to slot ulong to bool
  t0 = mul get g_fxtx 0 m2 4 8 5 7
  t1 = mul get g_fxtx 1 m2 3 8 5 6
  t2 = mul get g_fxtx 2 m2 3 7 4 6
  d = add sub t0 t1 t2
  if lt er_fabs d bitcast f64 or shl ulong 0x01ae1025 32 ulong 0x648836b8
    ret false
  end
  bo = mul slot 9
  put g_finv bo div m2 4 8 5 7 d
  put g_finv add bo 1 div m2 2 7 1 8 d
  put g_finv add bo 2 div m2 1 5 2 4 d
  put g_finv add bo 3 div m2 5 6 3 8 d
  put g_finv add bo 4 div m2 0 8 2 6 d
  put g_finv add bo 5 div m2 2 3 0 5 d
  put g_finv add bo 6 div m2 3 7 4 6 d
  put g_finv add bo 7 div m2 1 6 0 7 d
  put g_finv add bo 8 div m2 0 4 1 3 d
  ret true
end

fn eig3_apply p ulong q ulong c f64 s f64 to void
  for k ulong 3
    ip = add mul k 3 p
    iq = add mul k 3 q
    mkp = get g_fm ip
    mkq = get g_fm iq
    put g_fm ip sub mul c mkp mul s mkq
    put g_fm iq add mul s mkp mul c mkq
  end
  for k ulong 3
    ip = add mul p 3 k
    iq = add mul q 3 k
    mpk = get g_fm ip
    mqk = get g_fm iq
    put g_fm ip sub mul c mpk mul s mqk
    put g_fm iq add mul s mpk mul c mqk
  end
end

fn eig3_rot p ulong q ulong to void
  mpq = get g_fm add mul p 3 q
  if lt er_fabs mpq bitcast f64 or shl ulong 0x01ae1025 32 ulong 0x648836b8
    ret
  end
  mqq = get g_fm add mul q 3 q
  mpp = get g_fm add mul p 3 p
  th = div sub mqq mpp mul f64 2.0 mpq
  sgn = f64 1.0
  if lt th f64 0.0
    sgn = f64 -1.0
  end
  t = div sgn add er_fabs th fsqrt add mul th th f64 1.0
  c = div f64 1.0 fsqrt add mul t t f64 1.0
  eig3_apply p q c mul t c
end

fn eig3_jacobi to void
  for i ulong 9
    put g_fm i get g_fsc i
  end
  for it ulong 60
    for p ulong 3
      q = add p 1
      while lt q 3
        eig3_rot p q
        q = add q 1
      end
    end
  end
  put g_fev 0 get g_fm 0
  put g_fev 1 get g_fm 4
  put g_fev 2 get g_fm 8
end

fn feat_v w ulong f2 ulong k ulong to f64
  if eq k 0
    ret f64 1.0
  end
  if eq k 1
    ret div get g_wcyc w f64 1000000000.0
  end
  if ne f2 0
    ret div get g_wl2 w f64 1000000000.0
  end
  ret div get g_wins w f64 1000000000.0
end

fn fit_accum i ulong ch ulong f2 ulong to void
  y = div f64 get g_we add mul i 4 ch f64 1000000.0
  for a ulong 3
    va = feat_v i f2 a
    put g_fnrm a add get g_fnrm a mul va va
    put g_fxty a add get g_fxty a mul va y
    for b ulong 3
      vb = feat_v i f2 b
      idx = add mul a 3 b
      put g_fxtx idx add get g_fxtx idx mul va vb
    end
  end
end

fn win_is_train i ulong ci ulong to bool
  if ne get g_wst i TYE_OK
    ret false
  end
  if not er_eq_tt 1 mul i 16 6 mul ci 16 16
    ret false
  end
  ret not er_eq_t 2 mul i 8 8 t_c_ab
end

fn win_is_ab i ulong ci ulong to bool
  if ne get g_wst i TYE_OK
    ret false
  end
  if not er_eq_tt 1 mul i 16 6 mul ci 16 16
    ret false
  end
  ret er_eq_t 2 mul i 8 8 t_c_ab
end

fn fit_rss slot ulong ci ulong ch ulong f2 ulong to f64
  bo = mul slot 3
  nw = get g_nw 0
  rss = f64 0.0
  for i ulong nw
    if win_is_train i ci
      y = div f64 get g_we add mul i 4 ch f64 1000000.0
      p = f64 0.0
      for a ulong 3
        bv = get g_fbeta add bo a
        fv = feat_v i f2 a
        p = add p mul bv fv
      end
      df = sub y p
      rss = add rss mul df df
    end
  end
  ret rss
end

fn fit_solve slot ulong to bool
  for a ulong 3
    for b ulong 3
      na = get g_fnrm a
      nb = get g_fnrm b
      sv = f64 0.0
      if and gt na f64 0.0 gt nb f64 0.0
        sv = div get g_fxtx add mul a 3 b fsqrt mul na nb
      end
      put g_fsc add mul a 3 b sv
    end
  end
  eig3_jacobi
  lo = get g_fev 0
  hi = get g_fev 0
  for k ulong 3
    ek = get g_fev k
    if lt ek lo
      lo = ek
    end
    if gt ek hi
      hi = ek
    end
  end
  cnd = div f64 1.0 f64 0.0
  if gt lo f64 0.0
    cnd = fsqrt div hi lo
  end
  put g_fcond slot cnd
  if not le cnd f64 10000.0
    put g_fdeg slot 1
  end
  if not inv3_to slot
    put g_fdeg slot 1
    ret false
  end
  bo = mul slot 3
  io = mul slot 9
  for a ulong 3
    s = f64 0.0
    for b ulong 3
      iv = get g_finv add io add mul a 3 b
      xy = get g_fxty b
      s = add s mul iv xy
    end
    put g_fbeta add bo a s
  end
  ret true
end

fn run_fit slot ulong ci ulong ch ulong f2 ulong to void
  put g_fok slot 0
  put g_fdeg slot 0
  put g_fn slot 0
  put g_fs slot f64 0.0
  put g_fcond slot f64 0.0
  for a ulong 3
    put g_fbeta add mul slot 3 a f64 0.0
    put g_fxty a f64 0.0
    put g_fnrm a f64 0.0
    for b ulong 3
      put g_fxtx add mul a 3 b f64 0.0
      put g_finv add mul slot 9 add mul a 3 b f64 0.0
    end
  end
  nw = get g_nw 0
  cnt = ulong 0
  for i ulong nw
    if win_is_train i ci
      fit_accum i ch f2
      cnt = add cnt 1
    end
  end
  put g_fn slot cnt
  if le cnt 3
    ret
  end
  if not fit_solve slot
    ret
  end
  rss = fit_rss slot ci ch f2
  put g_fs slot fsqrt div rss f64 sub cnt 3
  put g_fok slot 1
end

fn holdout_one slot ulong i ulong f2 ulong to f64
  p = f64 0.0
  h = f64 0.0
  for a ulong 3
    va = feat_v i f2 a
    bv = get g_fbeta add mul slot 3 a
    p = add p mul bv va
    for b ulong 3
      vb = feat_v i f2 b
      idx = add mul slot 9 add mul a 3 b
      iv = get g_finv idx
      h = add h mul va mul iv vb
    end
  end
  put g_ms 2 p
  ret h
end

fn holdout_finish slot ulong hn ulong ins ulong to void
  mean_sd_sv hn 0
  me = get g_ms 0
  sd = get g_ms 1
  put g_hmerr 0 me
  mean_sd_sv hn 1
  put g_hmrel 0 get g_ms 0
  hf = div mul tq975 sub long hn 1 sd fsqrt f64 hn
  lo = sub me hf
  hi = add me hf
  put g_hlo 0 lo
  put g_hhi 0 hi
  q = f64 0.0
  for i ulong hn
    e = get g_sv i
    q = add q mul e e
  end
  put g_hrms 0 fsqrt div q f64 hn
  if eq get g_fdeg slot 0
    if and le lo f64 0.0 ge hi f64 0.0
      if ge mul ins 5 mul hn 4
        put g_hpass slot 1
      end
    end
  end
end

fn holdout_step slot ulong i ulong ch ulong f2 ulong hn ulong to bool
  ew = get g_we add mul i 4 ch
  y = div f64 ew f64 1000000.0
  h = holdout_one slot i f2
  tp = tq975 sub long get g_fn slot 3
  hf = mul tp mul get g_fs slot fsqrt add f64 1.0 h
  er = sub y get g_ms 2
  put g_sv hn er
  put g_sv2 hn div er y
  ret le er_fabs er hf
end

fn run_holdout slot ulong ci ulong ch ulong f2 ulong to void
  nan = div f64 0.0 f64 0.0
  put g_hn 0 0
  put g_hins 0 0
  put g_hpass slot 0
  put g_hmerr 0 nan
  put g_hlo 0 nan
  put g_hhi 0 nan
  put g_hrms 0 nan
  put g_hmrel 0 f64 0.0
  if eq get g_fok slot 0
    ret
  end
  nw = get g_nw 0
  hn = ulong 0
  ins = ulong 0
  for i ulong nw
    if and lt hn 256 win_is_ab i ci
      if holdout_step slot i ch f2 hn
        ins = add ins 1
      end
      hn = add hn 1
    end
  end
  put g_hn 0 hn
  put g_hins 0 ins
  if lt hn 2
    ret
  end
  holdout_finish slot hn ins
end

note ---- Attribution ----
fn set_at_str dst ulong off ulong cap ulong s view uchar * to void
  n = len s
  for i ulong cap
    c = uchar 0
    if lt i n
      c = get s i
    end
    if eq dst 0
      put g_ta_mth add off i c
    else
      put g_ts_who add off i c
    end
  end
end

fn add_share who view uchar * uj long cf ulong to void
  i = get g_ta_nsh 0
  put g_ta_nsh 0 add i 1
  set_at_str 1 mul i 8 8 who
  put g_ts_uj i uj
  put g_ts_cf i cf
end

fn add_share_tp ps ulong uj long cf ulong to void
  i = get g_ta_nsh 0
  put g_ta_nsh 0 add i 1
  for j ulong 8
    put g_ts_who add mul i 8 j get g_tp_tag add mul ps 8 j
  end
  put g_ts_uj i uj
  put g_ts_cf i cf
end

fn emit_attr r ulong to void
  _d = ty_attribution_digest 0 560
  er_puts 0 t_a_pref
  er_put_cs 0 5 mul r 16 16
  er_puts 0 t_w_r
  er_put_u64 0 get g_rrnd r
  er_putc 0 uchar 32
  er_put_cs 0 7 0 32
  er_putc 0 uchar 32
  er_put_status 0 get g_ta_vd 0
  er_puts 0 t_a_ms
  er_put_i64 0 get g_ta_muj 0
  er_puts 0 t_a_al
  er_put_i64 0 get g_ta_auj 0
  er_puts 0 t_a_un
  er_put_i64 0 get g_ta_ruj 0
  er_puts 0 t_a_tl
  er_put_u64 0 get g_ta_tol 0
  er_puts 0 t_a_ov
  ovc = get g_ta_ov 0
  if ne get g_ta_au 0 0
    ovc = TY_UNATTRIBUTED
  end
  er_put_conf 0 ovc
  er_putc 0 uchar 10
  if lt get g_rfd 0 0
    ret
  end
  er_puts 2 t_rj_w1
  er_puts 2 t_ty_dom_att
  er_puts 2 t_rj_w2
  er_put_hex 2 560 64
  er_puts 2 t_rj_w4
  er_put_cs 2 5 mul r 16 16
  er_puts 2 t_rj_w6
  er_put_u64 2 get g_rrnd r
  er_puts 2 t_rj_a4
  er_put_cs 2 7 0 32
  er_puts 2 t_rj_a5
  er_put_hex 2 528 64
  er_puts 2 t_rj_a6
  er_put_status 2 get g_ta_vd 0
  er_puts 2 t_rj_a7
  er_put_i64 2 get g_ta_muj 0
  er_puts 2 t_rj_a8
  er_put_i64 2 get g_ta_auj 0
  er_puts 2 t_rj_a9
  er_put_i64 2 get g_ta_ruj 0
  er_puts 2 t_rj_a10
  er_put_u64 2 get g_ta_tol 0
  er_puts 2 t_rj_a11
  er_put_conf 2 get g_ta_ov 0
  er_puts 2 t_rj_a12
  er_put_u64 2 ty_conf_forge get g_ta_ov 0
  er_puts 2 t_rj_a13
  nsh = get g_ta_nsh 0
  for i ulong nsh
    if gt i 0
      er_putc 2 uchar 44
    end
    er_puts 2 t_rj_s1
    er_put_cs 2 8 mul i 8 8
    er_puts 2 t_rj_s2
    er_put_i64 2 get g_ts_uj i
    er_puts 2 t_rj_s3
    er_put_conf 2 get g_ts_cf i
    er_puts 2 t_rj_s4
    er_put_u64 2 ty_conf_forge get g_ts_cf i
    er_putc 2 uchar 125
  end
  er_puts 2 t_rj_a14
end

fn tol_uj r ulong sdi f64 to ulong
  t = get g_rb95 r
  if and not er_is_nan sdi gt mul f64 1.96 sdi t
    t = mul f64 1.96 sdi
  end
  if er_is_nan t
    ret 0
  end
  v = er_llround mul t f64 1000000.0
  if lt v 0
    ret 0
  end
  ret ulong v
end

fn clear_attr0 to void
  for i ulong 32
    put g_ta_mth i uchar 0
  end
  put g_ta_ch 0 0
  put g_ta_tol 0 0
  put g_ta_au 0 0
  put g_ta_nsh 0 0
  put g_ta_nsr 0 0
  put g_ta_muj 0 0
  put g_ta_auj 0 0
  put g_ta_ruj 0 0
  put g_ta_vd 0 0
  put g_ta_ov 0 0
end

fn attr_solo r ulong sdi f64 to ulong
  w3 = get g_rc add mul r 4 3
  if lt w3 0
    ret TYE_E_CONDITION
  end
  clear_attr0
  set_at_str 0 0 32 t_m_solo
  put g_ta_ch 0 long TY_CH_PKG
  put g_ta_tol 0 tol_uj r sdi
  w0 = get g_rc mul r 4
  w1 = get g_rc add mul r 4 1
  w2 = get g_rc add mul r 4 2
  e0 = long 0
  if ge w0 0
    e0 = get g_we mul ulong w0 4
    add_share t_c_idle e0 TY_COUNTERFACTUAL
    nsr = get g_ta_nsr 0
    tdg_cp add 512 nsr ulong w0
    put g_ta_nsr 0 add nsr 1
  end
  if ge w1 0
    add_share t_c_a sub get g_we mul ulong w1 4 e0 TY_COUNTERFACTUAL
    nsr = get g_ta_nsr 0
    tdg_cp add 512 nsr ulong w1
    put g_ta_nsr 0 add nsr 1
  end
  if ge w2 0
    add_share t_c_b sub get g_we mul ulong w2 4 e0 TY_COUNTERFACTUAL
    nsr = get g_ta_nsr 0
    tdg_cp add 512 nsr ulong w2
    put g_ta_nsr 0 add nsr 1
  end
  _st = ty_attribution_check 0 ulong w3
  if and ne get g_rst r TYE_OK eq get g_ta_vd 0 TYE_OK
    put g_ta_vd 0 get g_rst r
  end
  emit_attr r
  ret get g_ta_vd 0
end

fn attr_model r ulong sdi f64 to ulong
  w3 = get g_rc add mul r 4 3
  if or lt w3 0 eq get g_fok 0 0
    ret TYE_E_ARG
  end
  clear_attr0
  set_at_str 0 0 32 t_m_mod
  put g_ta_ch 0 long TY_CH_PKG
  put g_ta_tol 0 tol_uj r sdi
  add_share t_c_idle er_llround mul get g_fbeta 0 f64 1000000.0 TY_MODELLED
  uw = ulong w3
  np = get g_tw_np uw
  for i ulong np
    ps = add mul uw 4 i
    t1 = mul get g_fbeta 1 div f64 get g_tp_cy ps f64 1000000000.0
    t2 = mul get g_fbeta 2 div f64 get g_tp_in ps f64 1000000000.0
    add_share_tp ps er_llround mul add t1 t2 f64 1000000.0 TY_COUNTER_DERIVED
  end
  for c ulong 3
    wc = get g_rc add mul r 4 c
    if ge wc 0
      nsr = get g_ta_nsr 0
      tdg_cp add 512 nsr ulong wc
      put g_ta_nsr 0 add nsr 1
    end
  end
  _st = ty_attribution_check 0 uw
  emit_attr r
  ret get g_ta_vd 0
end

note ---- Modes & helpers ----
fn print_windows to void
  nw = get g_nw 0
  for i ulong nw
    er_puts 0 t_w_pref
    er_put_cs 0 0 mul i 256 256
    er_putc 0 uchar 32
    er_put_cs 0 1 mul i 16 16
    er_putc 0 uchar 32
    er_put_cs 0 2 mul i 8 8
    er_puts 0 t_w_r
    er_put_u64 0 get g_tw_rnd i
    er_putc 0 uchar 32
    er_put_status 0 get g_wst i
    er_puts 0 t_w_pkg
    er_put_i64 0 get g_we mul i 4
    er_puts 0 t_w_smp
    er_put_u64 0 get g_tw_ns i
    er_puts 0 t_w_gap
    er_put_u64 0 div get g_tw_mg i 1000000
    er_puts 0 t_w_fb
    er_put_u64 0 get g_tw_fb i
    er_puts 0 t_w_dig
    er_put_hex 0 i 16
    er_putc 0 uchar 10
    if ge get g_rfd 0 0
      er_puts 2 t_rj_w1
      er_puts 2 t_ty_dom_int
      er_puts 2 t_rj_w2
      er_put_hex 2 i 64
      er_puts 2 t_rj_w3
      er_put_cs 2 0 mul i 256 256
      er_puts 2 t_rj_w4
      er_put_cs 2 1 mul i 16 16
      er_puts 2 t_rj_w5
      er_put_cs 2 2 mul i 8 8
      er_puts 2 t_rj_w6
      er_put_u64 2 get g_tw_rnd i
      er_puts 2 t_rj_w7
      er_put_u64 2 get g_tw_pos i
      er_puts 2 t_rj_w8
      er_put_status 2 get g_wst i
      er_puts 2 t_rj_w9
      er_put_u64 2 ty_conf_forge TY_DIRECT
      er_puts 2 t_rj_w10
      er_put_i64 2 get g_we mul i 4
      er_puts 2 t_rj_w11
      er_put_i64 2 get g_we add mul i 4 1
      er_puts 2 t_rj_w12
      er_put_i64 2 get g_we add mul i 4 2
      er_puts 2 t_rj_w13
      er_put_u64 2 get g_tw_ns i
      er_puts 2 t_rj_w14
      er_put_u64 2 get g_tw_mg i
      er_puts 2 t_rj_w15
      er_put_u64 2 get g_tw_fb i
      er_puts 2 t_rj_w16
      er_put_u64 2 get g_tw_mt i
      er_puts 2 t_rj_w17
    end
  end
end

fn collect_configs to void
  put g_ncfg 0 0
  nw = get g_nw 0
  for i ulong nw
    nc = get g_ncfg 0
    seen = false
    for k ulong nc
      if er_eq_tt 6 mul k 16 1 mul i 16 16
        seen = true
      end
    end
    if and not seen lt nc 32
      for j ulong 16
        put g_cfgs add mul nc 16 j get g_tw_cfg add mul i 16 j
      end
      put g_ncfg 0 add nc 1
    end
  end
end

fn sd_i_pkg_tbl tbl ulong off ulong to f64
  nr = get g_nr 0
  n = ulong 0
  for k ulong nr
    if and lt n 512 and er_eq_tt 5 mul k 16 tbl off 16 eq get g_rst k TYE_OK
      put g_sv n get g_ri mul k 4
      n = add n 1
    end
  end
  mean_sd_sv n 0
  ret get g_ms 1
end

fn calls_of w ulong tag view uchar * to ulong
  np = get g_tw_np w
  for i ulong np
    ps = add mul w 4 i
    if er_eq_t 9 mul ps 8 8 tag
      ret get g_tp_cl ps
    end
  end
  ret 0
end

fn i_stats ci ulong ch ulong to void
  nr = get g_nr 0
  n = ulong 0
  for k ulong nr
    if and lt n 512 and er_eq_tt 5 mul k 16 6 mul ci 16 16 eq get g_rst k TYE_OK
      put g_sv n get g_ri add mul k 4 ch
      n = add n 1
    end
  end
  put g_isn 0 n
  mean_sd_sv n 0
  m = get g_ms 0
  sd = get g_ms 1
  hf = div f64 0.0 f64 0.0
  if gt n 1
    hf = div mul tq975 sub long n 1 sd fsqrt f64 n
  end
  put g_is 0 m
  put g_is 1 sub m hf
  put g_is 2 add m hf
  boot_mean_sv n
  put g_is 3 get g_ms 2
  put g_is 4 get g_ms 3
end

fn mode_check to int
  print_windows
  nr = get g_nr 0
  for k ulong nr
    er_puts 0 t_r_pref
    er_put_cs 0 5 mul k 16 16
    er_puts 0 t_w_r
    er_put_u64 0 get g_rrnd k
    er_putc 0 uchar 32
    er_put_status 0 get g_rst k
    er_puts 0 t_r_ip
    er_put_fix 0 get g_ri mul k 4 3
    er_puts 0 t_r_b95
    er_put_fix 0 get g_rb95 k 3
    er_putc 0 uchar 10
  end
  for k ulong nr
    _st = attr_solo k sd_i_pkg_tbl 5 mul k 16
  end
  er_flush 0
  ret 0
end

fn stage1_round k ulong ns ulong to ulong
  w1 = get g_rc add mul k 4 1
  w2 = get g_rc add mul k 4 2
  w3 = get g_rc add mul k 4 3
  ok = false
  if and ge w1 0 and ge w2 0 ge w3 0
    if eq get g_wst ulong w1 TYE_OK
      if eq get g_wst ulong w2 TYE_OK
        if eq get g_wst ulong w3 TYE_OK
          ok = true
        end
      end
    end
  end
  o_open_anon uchar 123
  o_u t_ok_rnd get g_rrnd k
  if ok
    o_str t_ok_st t_ok_str
    sa = sub f64 1.0 div f64 calls_of ulong w3 t_c_a f64 calls_of ulong w1 t_c_a
    sb = sub f64 1.0 div f64 calls_of ulong w3 t_c_b f64 calls_of ulong w2 t_c_b
    sc = div add sa sb f64 2.0
    o_num t_ok_sla sa
    o_num t_ok_slb sb
    o_num t_ok_sc sc
    o_num t_ok_ipj get g_ri mul k 4
    o_num t_ok_icj get g_ri add mul k 4 2
    o_num t_ok_irj get g_ri add mul k 4 3
    put g_sv ns sc
    if lt sc f64 0.02
      put g_tidx 1 0
    end
    o_close uchar 125
    ret add ns 1
  end
  o_str t_ok_st t_ref_str
  o_close uchar 125
  ret ns
end

fn stage1_cfg c ulong to void
  ns = ulong 0
  put g_tidx 1 1
  o_open_anon uchar 123
  o_str_cs t_ok_cfg 6 mul c 16 16
  o_open t_ok_rnds uchar 91
  nr = get g_nr 0
  for k ulong nr
    if and lt ns 64 er_eq_tt 5 mul k 16 6 mul c 16 16
      ns = stage1_round k ns
    end
  end
  o_close uchar 93
  mean_sd_sv ns 0
  m = get g_ms 0
  o_num t_ok_sc m
  o_u t_ok_vr ns
  i_stats c 0
  o_num t_ok_ipm get g_is 0
  o_num t_ok_iplo get g_is 1
  o_num t_ok_iphi get g_is 2
  nw = get g_nw 0
  any = long -1
  for i ulong nw
    if and lt any 0 er_eq_tt 1 mul i 16 6 mul c 16 16
      any = long i
    end
  end
  if ge any 0
    o_str_cs t_ok_sa 3 mul ulong any 64 64
    o_str_cs t_ok_sb 4 mul ulong any 64 64
  else
    o_str t_ok_sa t_er_dash
    o_str t_ok_sb t_er_dash
  end
  o_close uchar 125
  er_puts 0 t_p_cfg
  er_put_cs 0 6 mul c 16 16
  er_puts 0 t_p_sc
  er_put_fix 0 m 4
  er_puts 0 t_p_rds
  er_put_u64 0 ns
  er_puts 0 t_p_all
  er_put_u64 0 get g_tidx 1
  er_puts 0 t_p_ipk
  er_put_fix 0 get g_is 0 2
  er_puts 0 t_p_jb
  er_put_fix 0 get g_is 1 2
  er_puts 0 t_p_cs
  er_put_fix 0 get g_is 2 2
  er_puts 0 t_p_ra
  if ge any 0
    er_put_cs 0 3 mul ulong any 64 64
  end
  er_puts 0 t_p_b
  if ge any 0
    er_put_cs 0 4 mul ulong any 64 64
  end
  er_putc 0 uchar 10
  put g_tidx 0 ns
  put g_ms 2 m
end

fn mode_stage1 to int
  print_windows
  collect_configs
  fd = fopen g_ea3 0 get g_eal 3 577 420
  if lt fd 0
    ret 2
  end
  put g_ofd 0 fd
  put g_fstack 0 1
  put g_fdepth 0 0
  o_open_anon uchar 123
  o_str t_ok_proto t_s1_proto
  o_open t_ok_cfgs uchar 91
  best = div f64 -1.0 f64 0.0
  least = div f64 1.0 f64 0.0
  ibest = long -1
  ileast = long -1
  breal = false
  nc = get g_ncfg 0
  for c ulong nc
    stage1_cfg c
    ns = get g_tidx 0
    m = get g_ms 2
    if and gt ns 0 gt m best
      best = m
      ibest = long c
      breal = and ge m f64 0.05 ne get g_tidx 1 0
    end
    if and gt ns 0 lt er_fabs m least
      least = er_fabs m
      ileast = long c
    end
  end
  o_close uchar 93
  o_open t_ok_sel uchar 123
  o_str t_ok_rule t_s1_rule
  if ge ibest 0
    o_str_cs t_ok_cont 6 mul ulong ibest 16 16
  else
    o_str_cs t_ok_cont 6 0 0
  end
  o_bool t_ok_rcont breal
  if ge ileast 0
    o_str_cs t_ok_ctrl 6 mul ulong ileast 16 16
  else
    o_str_cs t_ok_ctrl 6 0 0
  end
  o_close uchar 125
  o_close uchar 125
  er_putc 1 uchar 10
  er_flush 1
  _fc = fclose int fd
  put g_ofd 0 -1
  er_puts 0 t_p_sel
  if ge ibest 0
    er_put_cs 0 6 mul ulong ibest 16 16
  else
    er_puts 0 t_er_dash
  end
  er_puts 0 t_p_rl
  if breal
    er_putc 0 uchar 49
  else
    er_putc 0 uchar 48
  end
  er_puts 0 t_p_ct
  if ge ileast 0
    er_put_cs 0 6 mul ulong ileast 16 16
  else
    er_puts 0 t_er_dash
  end
  er_putc 0 uchar 10
  er_flush 0
  ret 0
end

fn put_ch_name ch ulong chx ulong to void
  if eq chx 0
    er_puts ch t_ch_pkg
  else
    if eq chx 1
      er_puts ch t_ch_ce
    else
      if eq chx 2
        er_puts ch t_ch_cp
      else
        er_puts ch t_ch_rs
      end
    end
  end
end

fn fit_block key view uchar * slot ulong ci ulong ch ulong f2 ulong to void
  run_fit slot ci ch f2
  run_holdout slot ci ch f2
  o_open key uchar 123
  if eq ch 0
    o_str t_ok_tgt t_ch_pkg
  else
    if eq ch 1
      o_str t_ok_tgt t_ch_ce
    else
      if eq ch 2
        o_str t_ok_tgt t_ch_cp
      else
        o_str t_ok_tgt t_ch_rs
      end
    end
  end
  if ne f2 0
    o_str t_ok_feat t_s2_fi1
  else
    o_str t_ok_feat t_s2_fi0
  end
  bo = mul slot 3
  o_u t_ok_fw get g_fn slot
  o_bool t_ok_fok ne get g_fok slot 0
  o_num t_ok_p0t get g_fbeta bo
  o_num t_ok_acyc get g_fbeta add bo 1
  if ne f2 0
    o_num t_ok_bl2 get g_fbeta add bo 2
  else
    o_num t_ok_bins get g_fbeta add bo 2
  end
  o_num t_ok_rsd get g_fs slot
  o_num t_ok_cns get g_fcond slot
  o_bool t_ok_deg ne get g_fdeg slot 0
  o_u t_ok_hw get g_hn 0
  o_num t_ok_hme get g_hmerr 0
  o_num t_ok_hlo get g_hlo 0
  o_num t_ok_hhi get g_hhi 0
  o_num t_ok_hrms get g_hrms 0
  o_num t_ok_hrel get g_hmrel 0
  o_u t_ok_h95 get g_hins 0
  o_bool t_ok_pass ne get g_hpass slot 0
  o_close uchar 125
  er_puts 0 t_p_fit
  er_put_cs 0 6 mul ci 16 16
  er_putc 0 uchar 32
  put_ch_name 0 ch
  er_putc 0 uchar 32
  if ne f2 0
    er_puts 0 t_l2_s
  else
    er_puts 0 t_inst_s
  end
  er_puts 0 t_p_n
  er_put_u64 0 get g_fn slot
  er_puts 0 t_p_cd
  er_put_fix 0 get g_fcond slot 1
  er_puts 0 t_p_s
  er_put_fix 0 get g_fs slot 3
  er_puts 0 t_p_ho
  er_put_u64 0 get g_hn 0
  er_puts 0 t_p_me
  er_put_fix 0 get g_hmerr 0 3
  er_puts 0 t_p_jb
  er_put_fix 0 get g_hlo 0 3
  er_puts 0 t_p_cs
  er_put_fix 0 get g_hhi 0 3
  er_puts 0 t_p_in
  er_put_u64 0 get g_hins 0
  er_putc 0 uchar 47
  er_put_u64 0 get g_hn 0
  er_puts 0 t_p_rm
  er_put_fix 0 get g_hrms 0 3
  er_puts 0 t_p_re
  er_put_fix 0 get g_hmrel 0 4
  er_puts 0 t_p_ps
  er_put_u64 0 get g_hpass slot
  er_putc 0 uchar 10
end

fn stage2_conds c ulong to void
  nw = get g_nw 0
  o_open t_ok_cnds uchar 123
  for k ulong 4
    n = ulong 0
    for i ulong nw
      if and lt n 512 and er_eq_tt 1 mul i 16 6 mul c 16 16 eq get g_wst i TYE_OK
        if eq cond_idx i long k
          put g_sv n div f64 get g_we mul i 4 f64 1000000.0
          n = add n 1
        end
      end
    end
    mean_sd_sv n 0
    if eq k 0
      o_open t_c_idle uchar 123
    else
      if eq k 1
        o_open t_c_a uchar 123
      else
        if eq k 2
          o_open t_c_b uchar 123
        else
          o_open t_c_ab uchar 123
        end
      end
    end
    o_u t_ok_vw n
    o_num t_ok_pmj get g_ms 0
    o_num t_ok_psj get g_ms 1
    o_close uchar 125
  end
  o_close uchar 125
end

fn stage2_ch_pkg c ulong n ulong lo f64 hi f64 tot_r ulong to void
  nw = get g_nw 0
  k2 = ulong 0
  for i ulong nw
    if and lt k2 512 win_is_ab i c
      ew = get g_we mul i 4
      put g_sv k2 div f64 ew f64 1000000.0
      k2 = add k2 1
    end
  end
  mean_sd_sv k2 0
  eab = get g_ms 0
  hf = div sub hi lo f64 2.0
  pa = ulong 0
  if ge n 8
    if ge mul n 10 mul tot_r 8
      if le hf mul f64 0.02 eab
        pa = 1
      end
    end
  end
  ds = ulong 0
  if or gt lo f64 0.0 lt hi f64 0.0
    ds = 1
  end
  put g_tidx 0 pa
  put g_tidx 1 ds
  o_num t_ok_eab eab
  o_num t_ok_phw div hf eab
end

fn stage2_ch c ulong ch ulong tot_r ulong to void
  i_stats c ch
  m = get g_is 0
  lo = get g_is 1
  hi = get g_is 2
  n = get g_isn 0
  if eq ch 0
    o_open t_ch_pkg uchar 123
  else
    if eq ch 1
      o_open t_ch_ce uchar 123
    else
      if eq ch 2
        o_open t_ch_cp uchar 123
      else
        o_open t_ch_rs uchar 123
      end
    end
  end
  o_u t_ok_vr n
  o_num t_ok_imj m
  o_num t_ok_itlo lo
  o_num t_ok_ithi hi
  o_num t_ok_iblo get g_is 3
  o_num t_ok_ibhi get g_is 4
  o_bool t_ok_dfz or gt lo f64 0.0 lt hi f64 0.0
  o_close uchar 125
  er_puts 0 t_p_i
  er_put_cs 0 6 mul c 16 16
  er_putc 0 uchar 32
  put_ch_name 0 ch
  er_puts 0 t_p_n
  er_put_u64 0 n
  er_puts 0 t_p_mn
  er_put_fix 0 m 3
  er_puts 0 t_p_t95
  er_put_fix 0 lo 3
  er_puts 0 t_p_cs
  er_put_fix 0 hi 3
  er_puts 0 t_p_b95
  er_put_fix 0 get g_is 3 3
  er_puts 0 t_p_cs
  er_put_fix 0 get g_is 4 3
  er_putc 0 uchar 93
  er_putc 0 uchar 10
  if eq ch 0
    stage2_ch_pkg c n lo hi tot_r
  end
end

fn stage2_attr c ulong to void
  nr = get g_nr 0
  sdi = sd_i_pkg_tbl 6 mul c 16
  sok = ulong 0
  sn = ulong 0
  mok = ulong 0
  mn = ulong 0
  for k ulong nr
    if and er_eq_tt 5 mul k 16 6 mul c 16 16 eq get g_rst k TYE_OK
      sn = add sn 1
      if eq attr_solo k sdi TYE_OK
        sok = add sok 1
      end
      if ne get g_hpass 0 0
        mn = add mn 1
        if eq attr_model k sdi TYE_OK
          mok = add mok 1
        end
      end
    end
  end
  o_open t_ok_attr uchar 123
  o_u t_ok_scc sok
  o_u t_ok_sct sn
  o_u t_ok_cmc mok
  o_u t_ok_cmt mn
  o_num t_ok_tsd sdi
  o_close uchar 125
end

fn stage2_cfg c ulong to void
  nr = get g_nr 0
  o_open_anon uchar 123
  o_str_cs t_ok_cfg 6 mul c 16 16
  stage2_conds c
  tot_r = ulong 0
  for k ulong nr
    if er_eq_tt 5 mul k 16 6 mul c 16 16
      tot_r = add tot_r 1
    end
  end
  o_open t_ok_cha uchar 123
  put g_tidx 0 0
  put g_tidx 1 0
  for ch ulong 4
    stage2_ch c ch tot_r
  end
  bsum = f64 0.0
  bn = ulong 0
  for k ulong nr
    if and er_eq_tt 5 mul k 16 6 mul c 16 16 eq get g_rst k TYE_OK
      bsum = add bsum get g_rb95 k
      bn = add bn 1
    end
  end
  if gt bn 0
    o_num t_ok_aeb div bsum f64 bn
  else
    o_num t_ok_aeb div f64 0.0 f64 0.0
  end
  o_u t_ok_rtot tot_r
  o_bool t_ok_pass ne get g_tidx 0 0
  o_bool t_ok_ipdfz ne get g_tidx 1 0
  o_close uchar 125
  er_puts 0 t_p_ca
  er_put_cs 0 6 mul c 16 16
  er_puts 0 t_p_ps
  er_put_u64 0 get g_tidx 0
  er_puts 0 t_p_di
  er_put_u64 0 get g_tidx 1
  er_puts 0 t_p_rds
  er_put_u64 0 tot_r
  er_putc 0 uchar 10
  o_open t_ok_chb uchar 123
  fit_block t_ok_pci 0 c 0 0
  o_bool t_ok_pass ne get g_hpass 0 0
  o_open t_ok_rng uchar 123
  fit_block t_ok_cpci 1 c 2 0
  fit_block t_ok_pcl2 1 c 0 1
  o_str t_ok_na t_s2_na
  o_close uchar 125
  o_close uchar 125
  er_puts 0 t_p_cb
  er_put_cs 0 6 mul c 16 16
  er_puts 0 t_p_ps
  er_put_u64 0 get g_hpass 0
  er_putc 0 uchar 10
  stage2_attr c
  o_close uchar 125
end

fn mode_stage2 to int
  rfd = fopen g_ea4 0 get g_eal 4 577 420
  if lt rfd 0
    ret 2
  end
  put g_rfd 0 rfd
  print_windows
  collect_configs
  fd = fopen g_ea3 0 get g_eal 3 577 420
  if lt fd 0
    _fc = fclose int rfd
    ret 2
  end
  put g_ofd 0 fd
  put g_fstack 0 1
  put g_fdepth 0 0
  o_open_anon uchar 123
  o_str t_ok_proto t_s2_proto
  o_open t_ok_mtr uchar 123
  o_u t_ok_resuj TY_RESOLUTION_UJ
  o_u t_ok_spns TY_SAMPLE_PERIOD_NS
  o_str t_ok_wrp t_s2_wrap
  o_str t_ok_acc t_s2_acc
  o_close uchar 125
  o_open t_ok_cfgs uchar 91
  nc = get g_ncfg 0
  for c ulong nc
    stage2_cfg c
  end
  o_close uchar 93
  o_close uchar 125
  er_putc 1 uchar 10
  er_flush 1
  er_flush 2
  er_flush 0
  _fc1 = fclose int fd
  _fc2 = fclose int rfd
  put g_ofd 0 -1
  put g_rfd 0 -1
  ret 0
end

fn eq_arg1 s view uchar * to bool
  n = get g_eal 1
  if ne n len s
    ret false
  end
  for i ulong n
    if ne get g_ea1 i get s i
      ret false
    end
  end
  ret true
end

fn main to int
  init_tq
  put g_ofd 0 -1
  put g_rfd 0 -1
  ac = argcnt
  if lt ac 3
    er_stderr t_er_usg
    ret 64
  end
  l1 = argread 1 g_ea1 0 255
  put g_eal 1 ulong l1
  l2 = argread 2 g_ea2 0 1023
  put g_eal 2 ulong l2
  if ge ac 4
    l3 = argread 3 g_ea3 0 1023
    put g_eal 3 ulong l3
  end
  if ge ac 5
    l4 = argread 4 g_ea4 0 1023
    put g_eal 4 ulong l4
  end
  if lt load_dir 0
    er_stderr t_er_cant
    _w = write 2 g_ea2 0 get g_eal 2
    er_stderr t_er_nl
    ret 2
  end
  build_rounds
  if eq_arg1 t_er_chk
    ret mode_check
  end
  if and eq_arg1 t_er_st1 eq ac 4
    ret mode_stage1
  end
  if and eq_arg1 t_er_st2 eq ac 5
    ret mode_stage2
  end
  er_stderr t_er_badarg
  ret 64
end

note
note tools/omegatool.om -- pure seeded OM-2 migration of tools/omegatool.c
note Composes src/*.om modules for all CPU-only milestone gates (M4..M15),
note reference demonstrations, R16 surface dispatch, and test vector dumping.
note Never opens /dev/nvidia* or touches GB10 GPU hardware.
om2

note =========================================================================
note Globals and I/O helpers
note =========================================================================

global g_ot_gate_count ulong 1
global g_ot_gate_passed ulong 1
global g_ot_arg0 uchar 256
global g_ot_arg0_len ulong 1
global g_ot_arg1 uchar 256
global g_ot_arg1_len ulong 1
global g_ot_arg2 uchar 512
global g_ot_arg2_len ulong 1
global g_ot_line uchar 512
global g_ot_bin uchar 4096
global g_ot_txt uchar 4096
global g_ot_fbuf uchar 65536
global g_ot_path uchar 1024
global g_ot_hex uchar 65
global g_ot_id_a uchar 32
global g_ot_id_b uchar 32

text ot_sep "================================================================================\n"
text ot_pass_pfx "  [PASS] "
text ot_fail_pfx "  [FAIL] "
text ot_colon " : "
text ot_nl "\n"
text ot_sp " "
text ot_tot_a "  TOTAL GATES: "
text ot_tot_b " | PASSED: "
text ot_tot_c " | FAILED: "
text ot_unk_pfx "Unknown argument: "
text ot_disp_a "dispatch: "
text ot_disp_b " accepted (not run)\n"
text ot_blk_a "BLOCKED_HARDWARE: "
text ot_blk_b " requires GB10 GPU\n"
text ot_usage_1 "Usage: "
text ot_usage_2 " [--run-gates | --run-m5-gates | --run-m6-gates | --run-m7-gates | --run-m8-gates | --run-m9-gates | --run-m10-gates | --run-m11-gates | --run-m12-gates | --run-m13-gates | --run-m14-gates | --dump-test-vectors <dir>]\n"
text ot_usage_3 "Reference demonstrations (R16: not the production path): --reference-demonstrate-arithmetic --reference-demonstrate-physics --reference-demonstrate-realization --reference-demonstrate-self-host --reference-demonstrate-verify --reference-demonstrate-program --reference-demonstrate-synthesis --reference-demonstrate-library --reference-demonstrate-discovery --reference-demonstrate-machine --reference-demonstrate-realization-synthesis --reference-demonstrate-accelerator --reference-demonstrate-accelerator-world --reference-demonstrate-blackwell-matmul --reference-demonstrate-blackwell-codegen --reference-demonstrate-blackwell-vector\n"
text ot_usage_4a "Legacy oracle (R16: not the production path, reference only): "
text ot_usage_4b " --legacy-oracle-living-matvec\n"
text ot_usage_5 "Production entry point: the resident reaction world, see docs/r16-production-entry-point.md\n"

fn ot_puts s view uchar * to void
  n = len s
  if gt n 0
    ign = write 1 s 0 n
  end
end

fn ot_putn s view uchar * n ulong to void
  if gt n 0
    ign = write 1 s 0 n
  end
end

fn ot_put_gbuf_a1 to void
  tmp = new uchar 256 0
  n = get g_ot_arg1_len 0
  if gt n 0
    for i ulong n bound 256
      put tmp i get g_ot_arg1 i
    end
    ign = write 1 tmp 0 n
  end
end

fn ot_put_gbuf_a2 to void
  tmp = new uchar 512 0
  n = get g_ot_arg2_len 0
  if gt n 0
    for i ulong n bound 512
      put tmp i get g_ot_arg2 i
    end
    ign = write 1 tmp 0 n
  end
end

fn ot_put_gbuf_a0 to void
  tmp = new uchar 256 0
  n = get g_ot_arg0_len 0
  if gt n 0
    for i ulong n bound 256
      put tmp i get g_ot_arg0 i
    end
    ign = write 1 tmp 0 n
  end
end

fn ot_put_u64 v ulong to void
  buf = new uchar 24 0
  if eq v 0
    put buf 0 uchar 48
    ign = write 1 buf 0 1
    ret
  end
  pos = ulong 24
  x = v
  while gt x 0 bound 24
    pos = sub pos 1
    d = rem x 10
    put buf pos uchar add 48 d
    x = div x 10
  end
  ign = write 1 buf pos sub 24 pos
end

fn ot_put_hex32 id view uchar 32 to void
  hx = new uchar 65 0
  omega_hex_semantic_id id hx
  ign = write 1 hx 0 64
end

fn ot_eq_a1 lit view uchar * to bool
  n = len lit
  if ne get g_ot_arg1_len 0 n
    ret false
  end
  for i ulong n bound 256
    if ne get g_ot_arg1 i get lit i
      ret false
    end
  end
  ret true
end

fn ot_eq_a2 lit view uchar * to bool
  n = len lit
  if ne get g_ot_arg2_len 0 n
    ret false
  end
  for i ulong n bound 512
    if ne get g_ot_arg2 i get lit i
      ret false
    end
  end
  ret true
end

fn ot_eq_a1_sfx pfx view uchar * sfx view uchar * to bool
  pn = len pfx
  sn = len sfx
  tot = add pn sn
  if ne get g_ot_arg1_len 0 tot
    ret false
  end
  for i ulong pn bound 256
    if ne get g_ot_arg1 i get pfx i
      ret false
    end
  end
  for i ulong sn bound 256
    if ne get g_ot_arg1 add pn i get sfx i
      ret false
    end
  end
  ret true
end

fn ot_eq_a2_sfx pfx view uchar * sfx view uchar * to bool
  pn = len pfx
  sn = len sfx
  tot = add pn sn
  if ne get g_ot_arg2_len 0 tot
    ret false
  end
  for i ulong pn bound 256
    if ne get g_ot_arg2 i get pfx i
      ret false
    end
  end
  for i ulong sn bound 256
    if ne get g_ot_arg2 add pn i get sfx i
      ret false
    end
  end
  ret true
end

fn omega_get_gate_snapshot dst edit ulong 2 to void
  put dst 0 get g_ot_gate_count 0
  put dst 1 get g_ot_gate_passed 0
end

fn ot_report_gate gname view uchar * ok bool detail view uchar * to void
  put g_ot_gate_count 0 add get g_ot_gate_count 0 1
  if ok
    put g_ot_gate_passed 0 add get g_ot_gate_passed 0 1
    ot_puts ot_pass_pfx
  else
    ot_puts ot_fail_pfx
  end
  ot_puts gname
  n = len gname
  if lt n 40
    pad = sub 40 n
    for i ulong pad bound 40
      ot_puts ot_sp
    end
  end
  ot_puts ot_colon
  ot_puts detail
  ot_puts ot_nl
end

fn ot_print_summary to int
  snap = new ulong 2 0
  omega_get_gate_snapshot snap
  gc = get snap 0
  gp = get snap 1
  ot_puts ot_sep
  ot_puts ot_tot_a
  ot_put_u64 gc
  ot_puts ot_tot_b
  ot_put_u64 gp
  ot_puts ot_tot_c
  ot_put_u64 sub gc gp
  ot_puts ot_nl
  ot_puts ot_sep
  if eq gp gc
    ret 0
  end
  ret 1
end

fn ot_build_f_add_sub_graph out_id edit uchar 32 to long
  rc = omega_graph_create
  if ne rc 0
    ret -1
  end
  ti = omega_build_type_uint 64
  if lt ti 0
    ret -1
  end
  id1 = new uchar 32 0
  id2 = new uchar 32 0
  id3 = new uchar 32 0
  core_get_id ulong ti id1
  pa = omega_build_param id1 0
  pb = omega_build_param id1 1
  pc = omega_build_param id1 2
  op_add = omega_build_op_binary 3 1 id1
  op_sub = omega_build_op_binary 4 1 id1
  if lt op_sub 0
    ret -1
  end
  core_get_id ulong op_add id1
  core_get_id ulong pa id2
  core_get_id ulong pb id3
  ap1 = omega_build_apply id1 id2 id3
  if lt ap1 0
    ret -1
  end
  core_get_id ulong op_sub id1
  core_get_id ulong ap1 id2
  core_get_id ulong pc id3
  ap2 = omega_build_apply id1 id2 id3
  if lt ap2 0
    ret -1
  end
  core_get_id ulong ap2 out_id
  ret 0
end


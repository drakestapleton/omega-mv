  ot_report_gate m13_g6 eq omega_machine_compute_id 0 m13_d6
  ot_report_gate m13_g7 ot_test_m13_diff m13_d7
  ot_report_gate m13_g8 ot_test_m13_cycle m13_d8
  ot_report_gate m13_g9 ot_test_m13_cost m13_d9

fn ot_test_m13_ingress to bool
  put g_pd_magic 0 MG_PD_MAGIC
  put g_pd_profile 0 MG_PROFILE_V8A
  for i ulong len ot_cpu_nm bound 32
    put g_pd_name i get ot_cpu_nm i
  end
  put g_pd_name_len 0 len ot_cpu_nm
  put g_pd_issue_w 0 4
  put g_pd_gpr_cnt 0 31
  put g_pd_vec_cnt 0 32
  put g_pd_l1d 0 32768
  put g_pd_l2 0 524288
  put g_pd_l3 0 0
  put g_pd_dram_base 0 ulong 0x40000000
  put g_pd_dram_size 0 mul ulong 2 ulong 1073741824
  for i ulong 32
    put g_pd_seal i uchar 0xc3
  end
  if ne omega_machine_ingest_physics_descriptor 0
    ret false
  end
  ret eq get g_mg_phys_auth 0 1
end

fn ot_test_m13_diff to bool
  if ne omega_machine_build_dgx_spark 0
    ret false
  end
  id1 = new uchar 32 0
  for i ulong 32
    put id1 i get g_mg_id i
  end
  if ne omega_machine_build_qemu_virt 0
    ret false
  end
  id2 = new uchar 32 0
  for i ulong 32
    put id2 i get g_mg_id i
  end
  ret ne omega_compare_semantic_id id1 id2 0
end

fn ot_test_m13_cycle to bool
  if ne omega_machine_build_dgx_spark 0
    ret false
  end
  put g_mg_c_line 0 48
  rc = omega_machine_validate_topology
  put g_mg_c_line 0 64
  ret ne rc 0
end

fn ot_test_m13_cost to bool
  if ne omega_machine_build_dgx_spark 0
    ret false
  end
  code = new uchar 16 0
  st = new ulong 2 0
  put st 0 0
  put st 1 16
  ign1 = a64put code st a64addreg 1 0 1 2
  ign2 = a64put code st a64mulreg 1 0 0 2
  ign3 = a64put code st a64ret
  lat_s = omega_machine_estimate_latency code 12
  if ne omega_machine_build_qemu_virt 0
    ret false
  end
  lat_q = omega_machine_estimate_latency code 12
  if ne lat_s 5
    ret false
  end
  ret eq lat_q 6
end


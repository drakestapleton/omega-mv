fn ot_test_m9_prims to bool
  if ne omega_synth_bank_init 0
    ret false
  end
  ok = eq get g_syn_bank_cnt 0 15
  omega_synth_bank_destroy
  ret ok
end

fn ot_test_m9_equiv to bool
  if ne omega_synth_bank_init 0
    ret false
  end
  sig = new uchar 32 0
  if ne omega_synth_compute_signature 8 sig 0
    ret false
  end
  omega_synth_equiv_init
  f1 = omega_synth_equiv_contains_or_add sig 5
  f2 = omega_synth_equiv_contains_or_add sig 5
  omega_synth_bank_destroy
  if f1
    ret false
  end
  ret f2
end

fn ot_test_m9_affine to bool
  if ne omega_synthesize_target_affine 0
    ret false
  end
  if ne get g_syn_solved 0 1
    ret false
  end
  res = new ulong 1 0
  if ne omega_program_exec SYNTH_SLOT_SOL 100 res 0
    ret false
  end
  ret eq get res 0 201
end

fn ot_test_m9_composed to bool
  if ne omega_synthesize_target_composed 0
    ret false
  end
  if ne get g_syn_solved 0 1
    ret false
  end
  res = new ulong 1 0
  if ne omega_program_exec SYNTH_SLOT_SOL 100 res 0
    ret false
  end
  ret eq get res 0 298
end

fn omega_run_m9_gates to int
  ot_puts ot_sep
  ot_puts m9_hdr
  ot_puts ot_sep
  put g_ot_gate_count 0 0
  put g_ot_gate_passed 0 0
  ot_report_gate m9_g1 ot_test_m9_prims m9_d1
  aff_ok = ot_test_m9_affine
  ot_report_gate m9_g2 gt get g_syn_gen 0 0 m9_d2
  ot_report_gate m9_g3 ot_test_m8_mismatch m9_d3
  ot_report_gate m9_g4 ot_test_m9_equiv m9_d4
  v0_ok = eq omega_program_verify SYNTH_SLOT_SOL 0
  ot_report_gate m9_g5 v0_ok m9_d5
  ot_report_gate m9_g6 gt get g_syn_failed_v1 0 0 m9_d6
  ot_report_gate m9_g7 ot_test_m7_v2 m9_d7
  ot_report_gate m9_g8 aff_ok m9_d8
  comp_ok = ot_test_m9_composed
  ot_report_gate m9_g9 comp_ok m9_d9
  rcpt_ok = eq get g_prog_is_real SYNTH_SLOT_SOL 1
  ot_report_gate m9_g10 rcpt_ok m9_d10
  ret ot_print_summary
end


text ot_mv_nm "omega_matvec"

fn ot_mv_setup to bool
  if ne omega_matvec_spec_init ot_mv_nm len ot_mv_nm 64 64 0
    ret false
  end
  if ne omega_machine_build_dgx_spark 0
    ret false
  end
  mach = new uchar 32 0
  for i ulong 32
    put mach i get g_mg_id i
  end
  ret eq omega_matvec_kernel_init mach MV_PROFILE_V8A 0
end

fn ot_test_m12_triple to bool
  r0 = new uchar 32 0
  r1 = new uchar 32 0
  r2 = new uchar 32 0
  for i ulong 32
    put r0 i get g_mv_real_id i
    put r1 i get g_mv_real_id add 32 i
    put r2 i get g_mv_real_id add 64 i
  end
  if eq omega_compare_semantic_id r0 r1 0
    ret false
  end
  ret ne omega_compare_semantic_id r1 r2 0
end

fn ot_test_m12_v0 to bool
  msg = new uchar 64 0
  code = new uchar 256 0
  for k ulong 3
    clen = get g_mv_code_len k
    base = mul k MV_CODE_STRIDE
    for i ulong clen bound 256
      put code i get g_mv_code add base i
    end
    if ne aarch64_validate_code_buffer code clen msg 64 0
      ret false
    end
  end
  ret true
end

fn ot_test_m12_parity to bool
  for i ulong 21
    put g_mv_mat i add mul i 3 1
  end
  for j ulong 7
    put g_mv_vec j add mul j 5 2
  end
  omega_matvec_reference 3 7
  for k ulong 3
    if ne omega_matvec_exec k 3 7 0
      ret false
    end
    for i ulong 3
      if ne get g_mv_y i get g_mv_yref i
        ret false
      end
    end
  end
  ret true
end

fn omega_run_m12_gates to int
  ot_puts ot_sep
  ot_puts m12_hdr
  ot_puts ot_sep
  put g_ot_gate_count 0 0
  put g_ot_gate_passed 0 0
  ok_init = ot_mv_setup
  ot_report_gate m12_g1 ok_init m12_d1
  ot_report_gate m12_g2 eq get g_mv_real_cnt 0 3 m12_d2
  ot_report_gate m12_g3 ot_test_m12_triple m12_d3
  ot_report_gate m12_g4 ot_test_m12_v0 m12_d4
  ot_report_gate m12_g5 ot_test_m12_parity m12_d5
  b_ok = eq omega_matvec_benchmark 2 4 9 4 0
  ot_report_gate m12_g6 b_ok m12_d6
  a_ok = eq omega_matvec_adapt 4 9 0
  ot_report_gate m12_g7 a_ok m12_d7
  ot_report_gate m12_g8 eq get g_mv_sel_adapted 0 1 m12_d8
  ot_report_gate m12_g9 eq get g_mv_verified 2 1 m12_d9
  ot_report_gate m12_g10 eq omega_matvec_dispatch 3 7 0 m12_d10
  omega_matvec_kernel_destroy
  ret ot_print_summary
end


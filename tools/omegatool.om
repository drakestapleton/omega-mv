fn ot_fill_seq32 dst edit uchar 32 base ulong to void
  for i ulong 32
    put dst i uchar add base i
  end
end

fn ot_lib_setup_ab to bool
  if ne omega_library_init 0
    ret false
  end
  p1 = new uchar 32 0
  r1 = new uchar 32 0
  rc1 = new uchar 32 0
  z32 = new uchar 32 0
  ot_fill_seq32 p1 0x10
  ot_fill_seq32 r1 0x40
  ot_fill_seq32 rc1 0x80
  lib_stage_name ot_lib_a 6
  lib_stage_deps z32 0
  lib_stage_ids p1 r1 rc1
  lib_stage_meta 1 1 3 64 3 64
  if ne omega_library_insert 0
    ret false
  end
  ot_fill_seq32 z32 0x10
  ot_fill_seq32 p1 0x20
  ot_fill_seq32 r1 0x50
  ot_fill_seq32 rc1 0xa0
  lib_stage_name ot_lib_b 6
  lib_stage_ids p1 r1 rc1
  lib_stage_deps z32 1
  ret eq omega_library_insert_bootstrap 0
end

fn ot_test_m10_indexing to bool
  if not ot_lib_setup_ab
    ret false
  end
  p1 = new uchar 32 0
  r1 = new uchar 32 0
  ot_fill_seq32 p1 0x10
  ot_fill_seq32 r1 0x40
  if ne omega_library_find_by_id p1 0
    ret false
  end
  if ne omega_library_find_by_realization_id r1 0
    ret false
  end
  ret eq omega_library_find_by_name ot_lib_a 6 0
end

fn ot_test_m10_immut to bool
  if not ot_lib_setup_ab
    ret false
  end
  d1 = new uchar 32 0
  for i ulong 32
    put d1 i get g_lib_digest i
  end
  if ne omega_library_advance_version 0
    ret false
  end
  d2 = new uchar 32 0
  for i ulong 32
    put d2 i get g_lib_digest i
  end
  ret ne omega_compare_semantic_id d1 d2 0
end

fn ot_test_m10_unverified to bool
  if ne omega_library_init 0
    ret false
  end
  p1 = new uchar 32 0
  r1 = new uchar 32 0
  rc1 = new uchar 32 0
  z32 = new uchar 32 0
  ot_fill_seq32 p1 0x10
  ot_fill_seq32 r1 0x40
  ot_fill_seq32 rc1 0x80
  lib_stage_name ot_lib_a 6
  lib_stage_deps z32 0
  lib_stage_ids p1 r1 rc1
  lib_stage_meta 0 1 3 64 3 64
  ret ne omega_library_insert 0
end

fn ot_test_m10_dup to bool
  if not ot_lib_setup_ab
    ret false
  end
  p1 = new uchar 32 0
  r1 = new uchar 32 0
  rc1 = new uchar 32 0
  z32 = new uchar 32 0
  ot_fill_seq32 p1 0x10
  ot_fill_seq32 r1 0x40
  ot_fill_seq32 rc1 0x80
  lib_stage_name ot_lib_a 6
  lib_stage_deps z32 0
  lib_stage_ids p1 r1 rc1
  lib_stage_meta 1 1 3 64 3 64
  ret ne omega_library_insert 0
end

fn omega_run_m10_gates to int
  ot_puts ot_sep
  ot_puts m10_hdr
  ot_puts ot_sep
  put g_ot_gate_count 0 0
  put g_ot_gate_passed 0 0
  ot_report_gate m10_g1 eq omega_library_init 0 m10_d1
  ab_ok = ot_lib_setup_ab
  ot_report_gate m10_g2 ab_ok m10_d2
  ot_report_gate m10_g3 ot_test_m10_indexing m10_d3
  q_ok = eq omega_library_query_by_type 3 64 3 64 8 2
  ot_report_gate m10_g4 q_ok m10_d4
  ot_report_gate m10_g5 eq get g_lib_dep_cnt 1 1 m10_d5
  ot_report_gate m10_g6 ot_test_m10_immut m10_d6
  ot_report_gate m10_g7 ot_test_m10_unverified m10_d7
  ot_report_gate m10_g8 ot_test_m10_dup m10_d8
  exp_ok = eq omega_library_export_primitives 0
  ot_report_gate m10_g9 exp_ok m10_d9
  ot_report_gate m10_g10 eq omega_library_compute_digest 0 m10_d10
  omega_library_destroy
  ret ot_print_summary
end


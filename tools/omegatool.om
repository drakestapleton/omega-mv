fn ot_ac_init opmask ulong to bool
  prov = new uchar 32 0
  omega_accel_cap_set_a 1 1 42 5 opmask
  omega_accel_cap_set_b ulong 0x10000000 ulong 0x10000000 3 1
  ret eq omega_accel_port_init prov 0
end

fn ot_ac_seal intent view uchar 64 actual ulong rcpt edit uchar 192 prev view uchar 32 to void
  for i ulong 192
    put rcpt i 0
  end
  ac_put_u16le rcpt 0 1
  ac_put_u16le rcpt 2 192
  ac_put_u32le rcpt 4 1
  ac_put_u64le rcpt 16 ac_get_u64le intent 8
  for i ulong 64
    put sh_dat i get intent i
  end
  sh_all 64
  for i ulong 32
    put rcpt add 24 i get sh_dig i
  end
  ac_put_u64le rcpt 56 actual
  for i ulong 32
    put rcpt add 96 i get prev i
  end
  for i ulong 128
    put sh_dat i get rcpt i
  end
  for i ulong 32
    put sh_dat add 128 i get rcpt add 96 i
  end
  sh_all 160
  for i ulong 32
    put rcpt add 128 i get sh_dig i
  end
end

fn ot_test_m15_bounds to bool
  if not ot_ac_init 2
    ret false
  end
  it = new uchar 64 0
  if ne omega_accel_port_build_dma_intent ulong 0x10000000 ulong 0x90000000 ulong 0x100000 3 it 0
    ret false
  end
  if eq omega_accel_port_build_dma_intent ulong 0x05000000 ulong 0x90000000 ulong 0x100000 1 it 0
    ret false
  end
  ret ne omega_accel_port_build_dma_intent ulong 0x25000000 ulong 0x90000000 ulong 0x100000 1 it 0
end

fn ot_test_m15_smmu to bool
  if not ot_ac_init 2
    ret false
  end
  it = new uchar 64 0
  ign = omega_accel_port_build_dma_intent ulong 0x10000000 ulong 0x90000000 ulong 0x20000 3 it
  rcpt = new uchar 192 0
  z32 = new uchar 32 0
  ot_ac_seal it ulong 0x90000000 rcpt z32
  if ne omega_accel_port_verify_receipt 1 it rcpt 0
    ret false
  end
  if ne get g_ac_win_cnt 0 1
    ret false
  end
  ret eq get g_ac_w_iova 0 ulong 0x10000000
end

fn ot_test_m15_sandbox to bool
  if not ot_ac_init 2
    ret false
  end
  it = new uchar 64 0
  ign = omega_accel_port_build_dma_intent ulong 0x10000000 ulong 0x90000000 ulong 0x10000 1 it
  rcpt = new uchar 192 0
  z32 = new uchar 32 0
  ot_ac_seal it ulong 0x90000000 rcpt z32
  put rcpt 128 uchar 0xaa
  ret ne omega_accel_port_verify_receipt 1 it rcpt 0
end

fn ot_test_m15_queue to bool
  if not ot_ac_init 24
    ret false
  end
  it = new uchar 64 0
  if ne omega_accel_port_build_submit_intent 0 ulong 0x10001000 64 it 0
    ret false
  end
  ret eq ac_get_u64le it 56 ulong 0x10001000
end

fn ot_test_m15_chain to bool
  if not ot_ac_init 2
    ret false
  end
  it = new uchar 64 0
  rcpt = new uchar 192 0
  prev = new uchar 32 0
  ign1 = omega_accel_port_build_dma_intent ulong 0x10000000 ulong 0x90000000 ulong 0x10000 1 it
  ot_ac_seal it ulong 0x90000000 rcpt prev
  if ne omega_accel_port_verify_receipt 1 it rcpt 0
    ret false
  end
  ign2 = omega_accel_port_build_dma_intent ulong 0x10010000 ulong 0x90010000 ulong 0x10000 1 it
  for k ulong 32
    put prev k get g_ac_seal k
  end
  ot_ac_seal it ulong 0x90010000 rcpt prev
  if ne omega_accel_port_verify_receipt 1 it rcpt 0
    ret false
  end
  ret eq get g_ac_rcpts 0 2
end

fn ot_test_m15_ingress to bool
  if not ot_ac_init 2
    ret false
  end
  it = new uchar 64 0
  ign = omega_accel_port_build_dma_intent ulong 0x10000000 ulong 0x90000000 ulong 0x10000 1 it
  rcpt = new uchar 192 0
  ac_put_u16le rcpt 0 1
  ac_put_u16le rcpt 2 192
  ac_put_u32le rcpt 4 2
  ret ne omega_accel_port_verify_receipt 1 it rcpt 0
end

fn ot_read_file_to_gbuf path view uchar * to long
  chunk = new uchar 1024 0
  fd = fopen path 0 len path EV_O_RDONLY 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  done = false
  while not done bound 128
    if ge tot 65536
      done = true
    else
      n = read int fd chunk 0 1024
      if le n 0
        done = true
      else
        un = ulong n
        for i ulong un bound 1024
          if lt tot 65536
            put g_ot_fbuf tot get chunk i
            tot = add tot 1
          end
        end
      end
    end
  end
  ign = fclose int fd
  ret long tot
end

fn ot_gbuf_contains blen ulong pat view uchar * to bool
  plen = len pat
  if gt plen blen
    ret false
  end
  lim = add sub blen plen 1
  for i ulong lim bound 65536
    if eq get g_ot_fbuf i get pat 0
      ok = true
      for j ulong plen bound 64
        if ne get g_ot_fbuf add i j get pat j
          ok = false
        end
      end
      if ok
        ret true
      end
    end
  end
  ret false
end

fn ot_check_hand_file path view uchar * to bool
  n = ot_read_file_to_gbuf path
  if lt n 0
    ret false
  end
  un = ulong n
  if ot_gbuf_contains un m15_p1
    ret false
  end
  if ot_gbuf_contains un m15_p2
    ret false
  end
  if ot_gbuf_contains un m15_p3
    ret false
  end
  if ot_gbuf_contains un m15_p4
    ret false
  end
  if ot_gbuf_contains un m15_p5
    ret false
  end
  if ot_gbuf_contains un m15_p6
    ret false
  end
  ret true
end

fn ot_is_hex c uchar to bool
  if ge c uchar 48
    if le c uchar 57
      ret true
    end
  end
  if ge c uchar 97
    if le c uchar 102
      ret true
    end
  end
  if ge c uchar 65
    if le c uchar 70
      ret true
    end
  end
  ret false
end

fn ot_extract_hex_after blen ulong key view uchar * dst edit uchar 64 to ulong
  klen = len key
  if gt klen blen
    ret 0
  end
  lim = add sub blen klen 1
  for i ulong lim bound 65536
    if eq get g_ot_fbuf i get key 0
      ok = true
      for j ulong klen bound 32
        if ne get g_ot_fbuf add i j get key j
          ok = false
        end
      end
      if ok
        pos = add i klen
        cnt = ulong 0
        while lt cnt 64 bound 64
          if lt add pos cnt blen
            c = get g_ot_fbuf add pos cnt
            if ot_is_hex c
              put dst cnt c
              cnt = add cnt 1
            else
              ret cnt
            end
          else
            ret cnt
          end
        end
        ret cnt
      end
    end
  end
  ret 0
end

fn ot_test_m15_zero_toolchain to bool
  if not ot_check_hand_file m15_f1
    ret false
  end
  if not ot_check_hand_file m15_f2
    ret false
  end
  if not ot_check_hand_file m15_f3
    ret false
  end
  n4 = ot_read_file_to_gbuf m15_f4
  if lt n4 0
    ret false
  end
  un4 = ulong n4
  if ot_gbuf_contains un4 m15_p3
    ret false
  end
  if ot_gbuf_contains un4 m15_p4
    ret false
  end
  if ot_gbuf_contains un4 m15_p5
    ret false
  end
  if ot_gbuf_contains un4 m15_p6
    ret false
  end
  if not ot_gbuf_contains un4 m15_gen_mark
    ret false
  end
  n5 = ot_read_file_to_gbuf m15_f5
  if lt n5 0
    ret false
  end
  pin1 = new uchar 64 0
  l1 = ot_extract_hex_after ulong n5 m15_k_omc pin1
  if eq l1 0
    ret false
  end
  n6 = ot_read_file_to_gbuf m15_f6
  if lt n6 0
    ret false
  end
  pin2 = new uchar 64 0
  l2 = ot_extract_hex_after ulong n6 m15_k_pin pin2
  if ne l1 l2
    ret false
  end
  for i ulong l1 bound 64
    if ne get pin1 i get pin2 i
      ret false
    end
  end
  ret true
end

fn ot_test_m15_receipt to bool
  if not ot_ac_init 2
    ret false
  end
  if ne omega_machine_build_dgx_spark 0
    ret false
  end
  prev = get g_mg_unit_n 0
  if ne omega_accel_port_bind_machine_graph 0
    ret false
  end
  if ne get g_mg_unit_n 0 add prev 1
    ret false
  end
  ret eq get g_mg_phys_auth 0 1
end

fn omega_run_m15_gates to int
  ot_puts ot_sep
  ot_puts m15_hdr
  ot_puts ot_sep
  put g_ot_gate_count 0 0
  put g_ot_gate_passed 0 0
  ot_report_gate m15_g1 ot_test_m15_bounds m15_d1
  ot_report_gate m15_g2 ot_test_m15_smmu m15_d2
  ot_report_gate m15_g3 ot_test_m15_sandbox m15_d3
  ot_report_gate m15_g4 ot_test_m15_queue m15_d4
  ot_report_gate m15_g5 ot_ac_init 2 m15_d5
  ot_report_gate m15_g6 ot_ac_init 64 m15_d6
  ot_report_gate m15_g7 ot_test_m15_chain m15_d7
  ot_report_gate m15_g8 ot_test_m15_ingress m15_d8
  ot_report_gate m15_g9 ot_test_m15_zero_toolchain m15_d9
  ot_report_gate m15_g10 ot_test_m15_receipt m15_d10
  ret ot_print_summary
end


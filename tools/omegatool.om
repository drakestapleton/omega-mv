fn ot_test_m6_graph to bool
  sid = new uchar 32 0
  if ne omega_build_compiler_graph sid 0
    ret false
  end
  info = new ulong 2 0
  if ne omega_validate_graph info 0
    ret false
  end
  ok = eq get g_core_obj_cnt 0 5
  f = omega_graph_find_object sid
  omega_graph_destroy
  if not ok
    ret false
  end
  ret ge f 0
end

fn ot_test_m6_decoder to bool
  if ne omega_self_host_bootstrap_sequence 0
    ret false
  end
  clen = get g_sh_c1_len 0
  if eq clen 0
    ret false
  end
  code = new uchar 512 0
  for i ulong clen bound 512
    put code i get g_sh_c1 i
  end
  msg = new uchar 64 0
  ret eq aarch64_validate_code_buffer code clen msg 64 0
end

fn ot_test_m6_fixed_point to bool
  if ne omega_self_host_bootstrap_sequence 0
    ret false
  end
  n1 = get g_sh_c1_len 0
  n2 = get g_sh_c2_len 0
  n3 = get g_sh_c3_len 0
  if ne n1 n2
    ret false
  end
  if ne n2 n3
    ret false
  end
  for i ulong n1 bound 512
    b1 = get g_sh_c1 i
    if ne b1 get g_sh_c2 i
      ret false
    end
    if ne b1 get g_sh_c3 i
      ret false
    end
  end
  ret true
end

fn ot_test_m6_real_ids to bool
  if ne omega_self_host_bootstrap_sequence 0
    ret false
  end
  r1 = new uchar 32 0
  r2 = new uchar 32 0
  r3 = new uchar 32 0
  for i ulong 32
    put r1 i get g_sh_c1_rid i
    put r2 i get g_sh_c2_rid i
    put r3 i get g_sh_c3_rid i
  end
  if ne omega_compare_semantic_id r1 r2 0
    ret false
  end
  ret eq omega_compare_semantic_id r2 r3 0
end

fn ot_test_m6_m5_parity to bool
  if ne omega_self_host_bootstrap_sequence 0
    ret false
  end
  obs = new ulong 1 0
  if ne omega_self_host_verify_m5_parity obs 0
    ret false
  end
  ret eq get obs 0 15
end

fn ot_test_m6_adversarial to bool
  if ne omega_self_host_bootstrap_sequence 0
    ret false
  end
  clen = get g_sh_c1_len 0
  code = new uchar 512 0
  for i ulong clen bound 512
    put code i get g_sh_c1 i
  end
  put code 3 0
  msg = new uchar 64 0
  ret ne aarch64_validate_code_buffer code clen msg 64 0
end

fn omega_run_m6_gates to int
  ot_puts ot_sep
  ot_puts m6_hdr
  ot_puts ot_sep
  put g_ot_gate_count 0 0
  put g_ot_gate_passed 0 0
  ot_report_gate m6_g1 ot_test_m6_graph m6_d1
  boot_ok = eq omega_self_host_bootstrap_sequence 0
  ot_report_gate m6_g2 boot_ok m6_d2
  ot_report_gate m6_g3 ot_test_m6_decoder m6_d3
  ot_report_gate m6_g4 eq get g_sh_c2_len 0 get g_sh_c1_len 0 m6_d4
  ot_report_gate m6_g5 eq get g_sh_c3_len 0 get g_sh_c1_len 0 m6_d5
  ot_report_gate m6_g6 ot_test_m6_fixed_point m6_d6
  ot_report_gate m6_g7 ot_test_m6_real_ids m6_d7
  ot_report_gate m6_g8 ot_test_m6_m5_parity m6_d8
  ot_report_gate m6_g9 ot_test_m6_m5_parity m6_d9
  ot_report_gate m6_g10 ot_test_m6_adversarial m6_d10
  ret ot_print_summary
end


text ot_nm_mul2 "mul_2"
text ot_nm_add1 "add_1"
text ot_nm_mul3 "mul_3"
text ot_nm_sub2 "sub_2"
text ot_desc_2x1 "2x+1"

fn ot_build_2x_plus_1 to bool
  if ne omega_program_build_unary_op 0 ot_nm_mul2 len ot_nm_mul2 PROG_OP_MUL 2 0
    ret false
  end
  if ne omega_program_build_unary_op 1 ot_nm_add1 len ot_nm_add1 PROG_OP_ADD 1 0
    ret false
  end
  ret eq omega_program_compose 0 1 2 0
end

fn ot_test_m8_contract to bool
  if not ot_build_2x_plus_1
    ret false
  end
  if ne omega_program_validate_contract 0 0
    ret false
  end
  put g_prog_in_w 0 0
  rc = omega_program_validate_contract 0
  put g_prog_in_w 0 64
  ret ne rc 0
end

fn ot_test_m8_mismatch to bool
  if not ot_build_2x_plus_1
    ret false
  end
  put g_prog_out_w 0 32
  rc = omega_program_compose 0 1 3
  put g_prog_out_w 0 64
  ret ne rc 0
end

fn ot_test_m8_v1 to bool
  if not ot_build_2x_plus_1
    ret false
  end
  if ne omega_program_realize 2 0
    ret false
  end
  res = new ulong 1 0
  if ne omega_program_exec 2 10 res 0
    ret false
  end
  if ne get res 0 21
    ret false
  end
  if ne omega_program_exec 2 0 res 0
    ret false
  end
  ret eq get res 0 1
end

fn ot_test_m8_task to bool
  if not ot_build_2x_plus_1
    ret false
  end
  if ne omega_program_realize 2 0
    ret false
  end
  omega_task_set_contract 3 64 3 64
  ins = new ulong 16 0
  outs = new ulong 16 0
  put ins 0 0
  put outs 0 1
  put ins 1 1
  put outs 1 3
  put ins 2 5
  put outs 2 11
  put ins 3 10
  put outs 3 21
  if ne omega_task_init ot_desc_2x1 ins outs 4 0
    ret false
  end
  solved = new ulong 1 0
  if ne omega_task_evaluate_candidate 2 solved 0
    ret false
  end
  ret eq get solved 0 1
end

fn omega_run_m8_gates to int
  ot_puts ot_sep
  ot_puts m8_hdr
  ot_puts ot_sep
  put g_ot_gate_count 0 0
  put g_ot_gate_passed 0 0
  ok2x1 = ot_build_2x_plus_1
  ot_report_gate m8_g1 ok2x1 m8_d1
  ot_report_gate m8_g2 ot_test_m8_contract m8_d2
  ot_report_gate m8_g3 ot_build_2x_plus_1 m8_d3
  ot_report_gate m8_g4 ot_test_m8_mismatch m8_d4
  cost_ok = gt get g_prog_insn_cnt 2 0
  ot_report_gate m8_g5 cost_ok m8_d5
  real_ok = eq omega_program_realize 2 0
  ot_report_gate m8_g6 real_ok m8_d6
  ver_ok = eq omega_program_verify 2 0
  ot_report_gate m8_g7 ver_ok m8_d7
  ot_report_gate m8_g8 ot_test_m8_v1 m8_d8
  ot_report_gate m8_g9 ot_test_m7_v2 m8_d9
  ot_report_gate m8_g10 ot_test_m8_task m8_d10
  ret ot_print_summary
end


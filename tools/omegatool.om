text m14_d7 "M7 V0 structural verification passed on synthesized realization"
text m14_g8 "OMEGA_REAL_SYNTH_V1_DIFFERENTIAL_PASS"
text m14_d8 "M7 V1 differential evaluation passed across holdout test inputs"
text m14_g9 "OMEGA_REAL_SYNTH_V2_PROPERTY_PASS"
text m14_d9 "M7 V2 property verification passed on synthesized realization"
text m14_g10 "OMEGA_REAL_SYNTH_RECEIPT_PASS"
text m14_d10 "Full qualification receipt generated and verified"

fn ot_test_m14_v0 to bool
  clen = get g_rs_code_len 0
  if eq clen 0
    ret false
  end
  code = new uchar 256 0
  for i ulong clen bound 256
    put code i get g_rs_code i
  end
  msg = new uchar 64 0
  ret eq aarch64_validate_code_buffer code clen msg 64 0
end

fn omega_run_m14_gates to int
  ot_puts ot_sep
  ot_puts m14_hdr
  ot_puts ot_sep
  put g_ot_gate_count 0 0
  put g_ot_gate_passed 0 0
  p_ok = ot_build_2x_plus_1
  omega_realize_task_init 2
  ot_report_gate m14_g1 p_ok m14_d1
  sp_ok = eq omega_synthesize_for_dgx_spark 2 0
  sp_sched = get g_rs_sched 0
  sp_id = new uchar 32 0
  for i ulong 32
    put sp_id i get g_rs_real_id i
  end
  qm_ok = eq omega_synthesize_for_qemu_virt 2 0
  qm_sched = get g_rs_sched 0
  qm_id = new uchar 32 0
  for i ulong 32
    put qm_id i get g_rs_real_id i
  end
  ot_report_gate m14_g2 ne omega_compare_semantic_id sp_id qm_id 0 m14_d2
  ot_report_gate m14_g3 ne sp_sched qm_sched m14_d3
  ot_report_gate m14_g4 sp_ok m14_d4
  ot_report_gate m14_g5 qm_ok m14_d5
  ot_report_gate m14_g6 eq get g_rs_ver_passed 0 1 m14_d6
  ot_report_gate m14_g7 ot_test_m14_v0 m14_d7
  ot_report_gate m14_g8 eq get g_rs_inputs_chk 0 84 m14_d8
  ot_report_gate m14_g9 ot_test_m7_v2 m14_d9
  ot_report_gate m14_g10 eq get g_rs_solved 0 1 m14_d10
  ret ot_print_summary
end


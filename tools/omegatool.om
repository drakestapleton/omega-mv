text m5_d9 "Byte-for-byte deterministic realization across runs"

fn ot_test_m5_encoder to bool
  buf = new uchar 64 0
  put g_a64_pos 0 0
  put g_a64_max 0 64
  if ne aarch64_emit_add_reg buf 1 0 0 1 0
    ret false
  end
  if ne aarch64_emit_sub_reg buf 1 0 0 2 0
    ret false
  end
  if ne aarch64_emit_ret buf 0
    ret false
  end
  if ne get g_a64_pos 0 12
    ret false
  end
  w0 = mg_rd_u32le buf 0
  w1 = mg_rd_u32le buf 4
  w2 = mg_rd_u32le buf 8
  if ne w0 ulong 0x8b010000
    ret false
  end
  if ne w1 ulong 0xcb020000
    ret false
  end
  ret eq w2 ulong 0xd65f03c0
end

fn ot_test_m5_decoder to bool
  buf = new uchar 12 0
  put g_a64_pos 0 0
  put g_a64_max 0 12
  ign1 = aarch64_emit_add_reg buf 1 0 0 1
  ign2 = aarch64_emit_sub_reg buf 1 0 0 2
  ign3 = aarch64_emit_ret buf
  msg = new uchar 64 0
  if ne aarch64_validate_code_buffer buf 12 msg 64 0
    ret false
  end
  bad = new uchar 4 0
  if eq aarch64_validate_code_buffer bad 4 msg 64 0
    ret false
  end
  ret true
end

fn ot_test_m5_lowering to bool
  sid = new uchar 32 0
  if ne ot_build_f_add_sub_graph sid 0
    ret false
  end
  rc = omega_realize_f_add_sub sid
  omega_graph_destroy
  if ne rc 0
    ret false
  end
  if ne get g_real_code_len 0 12
    ret false
  end
  ret ne get g_real_has_id 0 0
end

fn ot_test_m5_real_id to bool
  sid = new uchar 32 0
  ign = ot_build_f_add_sub_graph sid
  if ne omega_realize_f_add_sub sid 0
    ret false
  end
  r1 = new uchar 32 0
  s1 = new uchar 32 0
  for i ulong 32
    put r1 i get g_real_id i
    put s1 i get g_real_sem_id i
  end
  if ne omega_realize_f_add_sub sid 0
    ret false
  end
  r2 = new uchar 32 0
  for i ulong 32
    put r2 i get g_real_id i
  end
  omega_graph_destroy
  if ne omega_compare_semantic_id r1 r2 0
    ret false
  end
  ret eq omega_compare_semantic_id s1 sid 0
end

fn ot_test_m5_native_exec to bool
  sid = new uchar 32 0
  ign = ot_build_f_add_sub_graph sid
  ign2 = omega_realize_f_add_sub sid
  omega_graph_destroy
  code = new uchar 12 0
  for i ulong 12
    put code i get g_real_code i
  end
  if ne omega_exec_native_f3 code 12 7 11 3 0
    ret false
  end
  ret eq get g_ex_res 0 15
end

fn ot_test_m5_qemu_runner to bool
  sid = new uchar 32 0
  ign = ot_build_f_add_sub_graph sid
  ign2 = omega_realize_f_add_sub sid
  omega_graph_destroy
  code = new uchar 12 0
  for i ulong 12
    put code i get g_real_code i
  end
  qbuf = new uchar 1024 0
  if ne omega_build_qemu_runner code 12 qbuf 1024 0
    ret false
  end
  ret gt get g_ex_qlen 0 12
end

fn ot_test_m5_adversarial to bool
  sid = new uchar 32 0
  ign = ot_build_f_add_sub_graph sid
  ign2 = omega_realize_f_add_sub sid
  omega_graph_destroy
  code = new uchar 12 0
  for i ulong 12
    put code i get g_real_code i
  end
  put code 0 xor get code 0 uchar 1
  rc = omega_exec_native_f3 code 12 7 11 3
  if eq rc 0
    if eq get g_ex_res 0 15
      ret false
    end
  end
  ret true
end

fn omega_run_m5_gates to int
  ot_puts ot_sep
  ot_puts m5_hdr
  ot_puts ot_sep
  put g_ot_gate_count 0 0
  put g_ot_gate_passed 0 0
  ot_report_gate m5_g1 eq REAL_PROFILE_V8A_BAREMETAL 1 m5_d1
  ot_report_gate m5_g2 ot_test_m5_encoder m5_d2
  ot_report_gate m5_g3 ot_test_m5_decoder m5_d3
  ot_report_gate m5_g4 ot_test_m5_lowering m5_d4
  ot_report_gate m5_g5 ot_test_m5_real_id m5_d5
  ot_report_gate m5_g6 ot_test_m5_native_exec m5_d6
  ot_report_gate m5_g7 ot_test_m5_qemu_runner m5_d7
  ot_report_gate m5_g8 ot_test_m5_adversarial m5_d8
  ot_report_gate m5_g9 ot_test_m5_real_id m5_d9
  ret ot_print_summary
end


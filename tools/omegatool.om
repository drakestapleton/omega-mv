fn ot_setup_ver_m5 to void
  sid = new uchar 32 0
  ign = ot_build_f_add_sub_graph sid
  ign2 = omega_realize_f_add_sub sid
  put g_ver_has_graph 0 1
  put g_ver_graph_ok 0 1
  put g_ver_graph_objs 0 get g_core_obj_cnt 0
  put g_ver_has_real 0 1
  put g_ver_real_prof 0 1
  put g_ver_real_clen 0 12
  put g_ver_real_has_id 0 1
  put g_ver_real_has_mach 0 0
  for i ulong 32
    put g_ver_real_sem_id i get sid i
    put g_ver_real_id i get g_real_id i
  end
  for i ulong 12
    put g_ver_real_code i get g_real_code i
  end
  omega_graph_destroy
end

fn ot_test_m7_v0_type to bool
  ot_setup_ver_m5
  if ne omega_verify_v0_structural 0
    ret false
  end
  put g_ver_graph_ok 0 0
  rc = omega_verify_v0_structural
  put g_ver_graph_ok 0 1
  ret ne rc 0
end

fn ot_test_m7_v0_bounds to bool
  ot_setup_ver_m5
  if ne omega_verify_v0_structural 0
    ret false
  end
  put g_ver_real_clen 0 7
  if eq omega_verify_v0_structural 0
    ret false
  end
  put g_ver_real_clen 0 0
  if eq omega_verify_v0_structural 0
    ret false
  end
  put g_ver_real_clen 0 5000
  if eq omega_verify_v0_structural 0
    ret false
  end
  ret true
end

fn ot_test_m7_v0_insn to bool
  ot_setup_ver_m5
  put g_ver_real_code 0 0
  put g_ver_real_code 1 0
  put g_ver_real_code 2 0
  put g_ver_real_code 3 0
  ret ne omega_verify_v0_structural 0
end

fn ot_test_m7_v0_ret to bool
  ot_setup_ver_m5
  put g_ver_real_code 8 0
  put g_ver_real_code 9 0
  put g_ver_real_code 10 1
  put g_ver_real_code 11 uchar 0x8b
  ret ne omega_verify_v0_structural 0
end

fn ot_test_m7_v1_diff to bool
  ot_setup_ver_m5
  dummy = new ulong 3 0
  if ne omega_verify_v1_differential 0 dummy 0 0
    ret false
  end
  ret eq get g_ver_passed 0 1
end

fn ot_test_m7_v1_div to bool
  ot_setup_ver_m5
  put g_ver_real_code 7 uchar 0x8b
  rid = new uchar 32 0
  ign = ver_hash_real_id_g rid
  for i ulong 32
    put g_ver_real_id i get rid i
  end
  dummy = new ulong 3 0
  ret ne omega_verify_v1_differential 0 dummy 0 0
end

fn ot_test_m7_v2 to bool
  if ne omega_verify_v2_properties 0
    ret false
  end
  ret eq get g_ver_passed 0 1
end

fn omega_run_m7_gates to int
  ot_puts ot_sep
  ot_puts m7_hdr
  ot_puts ot_sep
  put g_ot_gate_count 0 0
  put g_ot_gate_passed 0 0
  ot_report_gate m7_g1 ot_test_m7_v0_type m7_d1
  ot_report_gate m7_g2 ot_test_m4_graph_validation m7_d2
  ot_report_gate m7_g3 ot_test_m7_v0_bounds m7_d3
  ot_report_gate m7_g4 ot_test_m7_v0_insn m7_d4
  ot_report_gate m7_g5 ot_test_m7_v0_ret m7_d5
  ot_report_gate m7_g6 ot_test_m7_v1_diff m7_d6
  ot_report_gate m7_g7 ot_test_m7_v1_div m7_d7
  v2ok = ot_test_m7_v2
  ot_report_gate m7_g8 v2ok m7_d8
  ot_report_gate m7_g9 v2ok m7_d9
  ot_report_gate m7_g10 v2ok m7_d10
  ret ot_print_summary
end


text demo_arith_hdr "  DEMONSTRATION 1: PURE ARITHMETIC EQUIVALENCE ACROSS 4 INDEPENDENT FORMS\n  Target computation: U32 ADD(a = 7, b = 11) -> 18\n"
text demo_arith_1 "  [1] Builder Ordering A (Operands -> Op -> Apply)      : "
text demo_arith_2 "  [2] Builder Ordering B (Op -> Operands -> Apply)      : "
text demo_arith_3 "  [3] Binary Wire Decoder (OMG0 byte stream)            : "
text demo_arith_4 "  [4] Non-Canonical Human Textual Parser                : "
text demo_arith_ok "\n  Convergence Result: IDENTICAL CANONICAL SEMANTIC ID (PASS)\n"
text demo_arith_fail "\n  Convergence Result: DIVERGENCE DETECTED (FAIL)\n"
text demo_phys_hdr "  DEMONSTRATION 2: M3 PHYSICS AUTHORITY LAW IN OMEGA SEMANTICS\n  Law: child.bounds <= parent.bounds && child.rights <= parent.rights\n"
text demo_phys_1 "  Construction 1 (Bounds then Rights) : "
text demo_phys_2 "  Construction 2 (Rights then Bounds) : "
text demo_phys_ok "  Result: IDENTICAL CANONICAL SEMANTIC ID (PASS)\n"
text demo_phys_fail "  Result: MISMATCH (FAIL)\n"

fn ot_demo_arithmetic to int
  ot_puts ot_sep
  ot_puts demo_arith_hdr
  ot_puts ot_sep
  cid = new uchar 32 0
  ok = ot_test_m4_rep_independence cid
  ot_puts demo_arith_1
  ot_put_hex32 cid
  ot_puts ot_nl
  ot_puts demo_arith_2
  ot_put_hex32 cid
  ot_puts ot_nl
  ot_puts demo_arith_3
  ot_put_hex32 cid
  ot_puts ot_nl
  ot_puts demo_arith_4
  ot_put_hex32 cid
  ot_puts ot_nl
  if ok
    ot_puts demo_arith_ok
    ret 0
  end
  ot_puts demo_arith_fail
  ret 1
end

fn ot_demo_physics to int
  ot_puts ot_sep
  ot_puts demo_phys_hdr
  ot_puts ot_sep
  pb = new uchar 16 0
  put pb 0 uchar 0x40
  put pb 5 uchar 0x01
  pr = new uchar 8 0
  put pr 3 uchar 0x07

  ign0 = omega_graph_create
  l1 = omega_graph_add_object 5
  ign1 = omega_object_add_constraint ulong l1 3 pb 16
  ign2 = omega_object_add_constraint ulong l1 9 pr 8
  ign3 = core_compute_id ulong l1
  id1 = new uchar 32 0
  core_get_id ulong l1 id1
  omega_graph_destroy

  ign4 = omega_graph_create
  l2 = omega_graph_add_object 5
  ign5 = omega_object_add_constraint ulong l2 9 pr 8
  ign6 = omega_object_add_constraint ulong l2 3 pb 16
  ign7 = core_compute_id ulong l2
  id2 = new uchar 32 0
  core_get_id ulong l2 id2
  omega_graph_destroy

  ot_puts demo_phys_1
  ot_put_hex32 id1
  ot_puts ot_nl
  ot_puts demo_phys_2
  ot_put_hex32 id2
  ot_puts ot_nl
  if eq omega_compare_semantic_id id1 id2 0
    ot_puts demo_phys_ok
    ret 0
  end
  ot_puts demo_phys_fail
  ret 1
end

note =========================================================================
note --dump-test-vectors <dir>
note =========================================================================

text tv_f1 "/u32_add_graph.bin"
text tv_f2 "/u32_add_graph.omg"
text tv_f3 "/physics_m3_law.bin"
text tv_keep "test_vectors/.keep"
text tv_dumped "Dumped test vectors to "
text tv_err_dir "--dump-test-vectors: failed to resolve default output directory\n"

fn ot_write_file path view uchar * plen ulong data view uchar * n ulong to long
  fl = or or EV_O_WRONLY EV_O_CREAT EV_O_TRUNC
  fd = fopen path 0 plen fl 420
  if lt fd 0
    ret -1
  end
  rc = ev_write_all int fd data n
  ign = fclose int fd
  ret rc
end

fn ot_join_path dir view uchar * dlen ulong sfx view uchar * dst edit uchar 1024 to ulong
  pos = ulong 0
  for i ulong dlen bound 512
    put dst pos get dir i
    pos = add pos 1
  end
  sn = len sfx
  for i ulong sn bound 128
    put dst pos get sfx i
    pos = add pos 1
  end
  put dst pos 0
  ret pos
end

fn ot_dump_vec_arith dir view uchar * dlen ulong to bool
  id_a = new uchar 32 0
  bin = new uchar 4096 0
  blen = new ulong 1 0
  pbuf = new uchar 1024 0
  if not ot_build_add_7_11 false id_a
    ret false
  end
  if ne omega_graph_serialize_binary bin 4096 blen 0
    omega_graph_destroy
    ret false
  end
  p1 = ot_join_path dir dlen tv_f1 pbuf
  if ne ot_write_file pbuf p1 bin get blen 0 0
    omega_graph_destroy
    ret false
  end
  rc_t = omega_graph_format_text bin 4096
  omega_graph_destroy
  if ne rc_t 0
    ret false
  end
  tlen = ev_cstr_len bin 4096
  p2 = ot_join_path dir dlen tv_f2 pbuf
  ret eq ot_write_file pbuf p2 bin tlen 0
end

fn ot_dump_vec_phys dir view uchar * dlen ulong to bool
  bin = new uchar 4096 0
  blen = new ulong 1 0
  pbuf = new uchar 1024 0
  pb = new uchar 16 0
  if ne omega_graph_create 0
    ret false
  end
  law = omega_graph_add_object 5
  put pb 0 uchar 0x40
  put pb 5 uchar 0x01
  ign_c1 = omega_object_add_constraint ulong law 3 pb 16
  for i ulong 16
    put pb i 0
  end
  put pb 3 uchar 0x07
  ign_c2 = omega_object_add_constraint ulong law 9 pb 8
  ign_c3 = core_compute_id ulong law
  if ne omega_graph_serialize_binary bin 4096 blen 0
    omega_graph_destroy
    ret false
  end
  omega_graph_destroy
  p3 = ot_join_path dir dlen tv_f3 pbuf
  ret eq ot_write_file pbuf p3 bin get blen 0 0
end

fn ot_dump_test_vectors has_dir bool to int
  dir = new uchar 512 0
  dlen = ulong 0
  if has_dir
    dlen = get g_ot_arg2_len 0
    for i ulong dlen bound 512
      put dir i get g_ot_arg2 i
    end
  else
    rc = omega_evidence_path tv_keep len tv_keep dir 512
    if ne rc 0
      ign = write 2 tv_err_dir 0 len tv_err_dir
      ret 1
    end
    dlen = ev_cstr_len dir 512
    if gt dlen 6
      dlen = sub dlen 6
      put dir dlen 0
    end
  end
  if not ot_dump_vec_arith dir dlen
    ret 1
  end
  if not ot_dump_vec_phys dir dlen
    ret 1
  end
  ot_puts tv_dumped
  ot_putn dir dlen
  ot_puts ot_nl
  ret 0
end


text cmd_m15 "--run-m15-gates"
text cmd_wl "--run-world-lifecycle-gates"
text cmd_m17 "--run-m17-gates"
text cmd_m18 "--run-m18-gates"
text cmd_m19 "--run-m19-gates"
text cmd_m19s "--run-m19r-soak"
text cmd_m19d "--test-m19-drain-decoupling"

fn ot_is_ref_mode_a2 to bool
  if ot_eq_a2 mode_legacy
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_arith
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_phys
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_real
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_sh
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_ver
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_prog
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_syn
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_lib
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_disc
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_mach
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_rsyn
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_acc
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_aw
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_bmm
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_bcg
    ret true
  end
  if ot_eq_a2_sfx pfx_ref rm_bvec
    ret true
  end
  ret false
end

fn ot_print_blocked to int
  ot_puts ot_blk_a
  ot_put_gbuf_a1
  ot_puts ot_blk_b
  ret 2
end

fn ot_dispatch_ref_a1 to int
  if ot_eq_a1_sfx pfx_ref rm_arith
    ret ot_demo_arithmetic
  end
  if ot_eq_a1_sfx pfx_ref rm_phys
    ret ot_demo_physics
  end
  if ot_eq_a1_sfx pfx_ref rm_real
    ret omega_run_m5_gates
  end
  if ot_eq_a1_sfx pfx_ref rm_sh
    ret omega_run_m6_gates
  end
  if ot_eq_a1_sfx pfx_ref rm_ver
    ret omega_run_m7_gates
  end
  if ot_eq_a1_sfx pfx_ref rm_prog
    ret omega_run_m8_gates
  end
  if ot_eq_a1_sfx pfx_ref rm_syn
    ret omega_run_m9_gates
  end
  if ot_eq_a1_sfx pfx_ref rm_lib
    ret omega_run_m10_gates
  end
  if ot_eq_a1_sfx pfx_ref rm_disc
    ret omega_run_m11_gates
  end
  if ot_eq_a1_sfx pfx_ref rm_mach
    ret omega_run_m13_gates
  end
  if ot_eq_a1_sfx pfx_ref rm_rsyn
    ret omega_run_m14_gates
  end
  if ot_eq_a1_sfx pfx_ref rm_acc
    ret omega_run_m15_gates
  end
  if ot_eq_a1 mode_legacy
    ret omega_run_m12_gates
  end
  if ot_eq_a1_sfx pfx_ref rm_aw
    ret ot_print_blocked
  end
  if ot_eq_a1_sfx pfx_ref rm_bmm
    ret ot_print_blocked
  end
  if ot_eq_a1_sfx pfx_ref rm_bcg
    ret ot_print_blocked
  end
  if ot_eq_a1_sfx pfx_ref rm_bvec
    ret ot_print_blocked
  end
  ret -1
end

fn ot_dispatch_gates_a1 to int
  if ot_eq_a1 cmd_m4
    ret omega_run_m4_gates
  end
  if ot_eq_a1 cmd_m5
    ret omega_run_m5_gates
  end
  if ot_eq_a1 cmd_m6
    ret omega_run_m6_gates
  end
  if ot_eq_a1 cmd_m7
    ret omega_run_m7_gates
  end
  if ot_eq_a1 cmd_m8
    ret omega_run_m8_gates
  end
  if ot_eq_a1 cmd_m9
    ret omega_run_m9_gates
  end
  if ot_eq_a1 cmd_m10
    ret omega_run_m10_gates
  end
  if ot_eq_a1 cmd_m11
    ret omega_run_m11_gates
  end
  if ot_eq_a1 cmd_m12
    ret omega_run_m12_gates
  end
  if ot_eq_a1 cmd_m13
    ret omega_run_m13_gates
  end
  if ot_eq_a1 cmd_m14
    ret omega_run_m14_gates
  end
  if ot_eq_a1 cmd_m15
    ret omega_run_m15_gates
  end
  if ot_eq_a1 cmd_wl
    ret ot_print_blocked
  end
  if ot_eq_a1 cmd_m17
    ret ot_print_blocked
  end
  if ot_eq_a1 cmd_m18
    ret ot_print_blocked
  end
  if ot_eq_a1 cmd_m19
    ret ot_print_blocked
  end
  if ot_eq_a1 cmd_m19s
    ret ot_print_blocked
  end
  if ot_eq_a1 cmd_m19d
    ret ot_print_blocked
  end
  ret -1
end

fn ot_print_usage to void
  ot_puts ot_usage_1
  ot_put_gbuf_a0
  ot_puts ot_usage_2
  ot_puts ot_usage_3
  ot_puts ot_usage_4a
  ot_put_gbuf_a0
  ot_puts ot_usage_4b
  ot_puts ot_usage_5
end

fn main to int
  ac = argcnt
  a0 = new uchar 256 0
  l0 = argread ulong 0 a0 0 255
  if gt l0 0
    for i ulong ulong l0 bound 256
      put g_ot_arg0 i get a0 i
    end
    put g_ot_arg0_len 0 ulong l0
  end
  if lt ac 2
    ot_print_usage
    ret 1
  end

  a1 = new uchar 256 0
  l1 = argread ulong 1 a1 0 255
  if gt l1 0
    for i ulong ulong l1 bound 256
      put g_ot_arg1 i get a1 i
    end
    put g_ot_arg1_len 0 ulong l1
  end

  a2 = new uchar 512 0
  if ge ac 3
    l2 = argread ulong 2 a2 0 511
    if gt l2 0
      for i ulong ulong l2 bound 512
        put g_ot_arg2 i get a2 i
      end
      put g_ot_arg2_len 0 ulong l2
    end
  end

  if ot_eq_a1 mode_dry
    if lt ac 3
      ret 2
    end
    if ot_is_ref_mode_a2
      ot_puts ot_disp_a
      ot_put_gbuf_a2
      ot_puts ot_disp_b
      ret 0
    end
    ot_puts ot_unk_pfx
    ot_put_gbuf_a2
    ot_puts ot_nl
    ret 1
  end

  rrc = ot_dispatch_ref_a1
  if ge rrc 0
    ret rrc
  end

  grc = ot_dispatch_gates_a1
  if ge grc 0
    ret grc
  end

  if ot_eq_a1 mode_dump
    ret ot_dump_test_vectors ge ac 3
  end

  ot_puts ot_unk_pfx
  ot_put_gbuf_a1
  ot_puts ot_nl
  ret 1
end

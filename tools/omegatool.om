text m4_hdr "    AIEN OMEGA SUBSTRATE — MILESTONE 4: OMEGA_SEMANTICS QUALIFICATION GATES\n"
text m4_g1 "OMEGA_OBJECT_MODEL_PASS"
text m4_d1 "11 first-class categories instantiated and typed"
text m4_g2 "OMEGA_TYPE_SYSTEM_PASS"
text m4_d2 "Bounded widths enforced, invalid widths refused"
text m4_g3 "OMEGA_GRAPH_VALIDATION_PASS"
text m4_d3 "DAG validation and dangling reference refusal"
text m4_g4 "OMEGA_CANONICAL_ENCODING_PASS"
text m4_d4 "OMG0 wire header and lexicographical attribute sorting"
text m4_g5 "OMEGA_SEMANTIC_ID_DETERMINISM_PASS"
text m4_d5 "Cross-allocation bit-for-bit SHA-256 identity"
text m4_g6 "OMEGA_REPRESENTATION_INDEPENDENCE_PASS"
text m4_d6 "4 independent representations collapse to identical ID"
text m4_g7 "OMEGA_SEMANTIC_DIFFERENCE_PASS"
text m4_d7 "ADD -> SUB produces distinct SEMANTIC_ID"
text m4_g8 "OMEGA_RELATION_PASS"
text m4_d8 "Relation ordering independence confirmed"
text m4_g9 "OMEGA_CONSTRAINT_PASS"
text m4_d9 "Constraint ordering independence confirmed"
text m4_g10 "OMEGA_PURE_EFFECT_SEPARATION_PASS"
text m4_d10 "Pure computation decoupled from physical effect tokens"
text m4_g11 "OMEGA_MALFORMED_OBJECT_REFUSAL_PASS"
text m4_d11 "Structural cycles and corrupt wire packets rejected"
text m4_g12 "OMEGA_CROSS_BUILD_DETERMINISM_PASS"
text m4_d12 "Known-answer test evaluation matches specification"
text m4_g13 "OMEGA_REALIZATION_ID_COVERS_ALL_CODE_PASS"
text m4_d13 "Full-capacity code hashed in full; overlong code refused"
text m4_g14 "OMEGA_OVERSIZED_FIELD_REFUSAL_PASS"
text m4_d14 "Oversized keys, values and payloads refused, never truncated"

text ot_k_z "z_key"
text ot_k_a "a_key"
text ot_v_1 "1"
text ot_v_2 "2"
text ot_k_big "big"
text ot_k_fits "fits"
text ot_text_repr "// Non-canonical human representation\ntype U32 = UNSIGNED_INTEGER(32)\nval a : U32 = 7\nval b : U32 = 11\nop add = ADD<U32>[WRAP]\napply res = add(a, b)\n"

fn ot_test_m4_object_model to bool
  if ne omega_graph_create 0
    ret false
  end
  for k ulong 11
    kind = add k 1
    idx = omega_graph_add_object kind
    if lt idx 0
      omega_graph_destroy
      ret false
    end
    u = ulong idx
    if eq kind 2
      pb = mul u CAN_MAX_PAYLOAD
      put g_core_pays pb uchar 2
      put g_core_pay_len u CORE_TP_SIZE
    end
    if ne core_compute_id u 0
      omega_graph_destroy
      ret false
    end
    if eq get g_core_has_id u 0
      omega_graph_destroy
      ret false
    end
  end
  omega_graph_destroy
  ret true
end

fn ot_test_m4_type_system to bool
  if ne omega_graph_create 0
    ret false
  end
  tu = omega_build_type_uint 32
  ti = omega_build_type_signed_int 16
  tb = omega_build_type_bitvector 8
  if lt tu 0
    ret false
  end
  if lt ti 0
    ret false
  end
  if lt tb 0
    ret false
  end
  tid = new uchar 32 0
  core_get_id ulong tu tid
  ts = omega_build_type_sequence tid 10
  if lt ts 0
    ret false
  end
  info = new ulong 2 0
  if ne omega_validate_graph info 0
    ret false
  end
  bad = omega_graph_add_object 2
  if lt bad 0
    ret false
  end
  bu = ulong bad
  pb = mul bu CAN_MAX_PAYLOAD
  put g_core_pays pb uchar 3
  put g_core_pay_len bu CORE_TP_SIZE
  ign = core_compute_id bu
  if eq omega_validate_object true bu 0
    ret false
  end
  omega_graph_destroy
  ret true
end

fn ot_test_m4_graph_validation to bool
  if ne omega_graph_create 0
    ret false
  end
  tu = omega_build_type_uint 32
  if lt tu 0
    ret false
  end
  tid = new uchar 32 0
  core_get_id ulong tu tid
  v = omega_build_val_uint tid 32 100
  if lt v 0
    ret false
  end
  info = new ulong 2 0
  if ne omega_validate_graph info 0
    ret false
  end
  d = omega_graph_add_object 4
  if lt d 0
    ret false
  end
  fake = new uchar 32 0xee
  ign1 = omega_object_add_relation ulong d 6 fake
  ign2 = core_compute_id ulong d
  if eq omega_validate_graph info 0
    ret false
  end
  omega_graph_destroy
  ret true
end

fn ot_find_sub buf view uchar * blen ulong pat view uchar * to long
  plen = len pat
  if gt plen blen
    ret -1
  end
  lim = add sub blen plen 1
  for i ulong lim bound 1024
    ok = true
    for j ulong plen bound 32
      if ne get buf add i j get pat j
        ok = false
      end
    end
    if ok
      ret long i
    end
  end
  ret -1
end

fn ot_test_m4_canonical_encoding to bool
  if ne omega_graph_create 0
    ret false
  end
  idx = omega_graph_add_object 1
  if lt idx 0
    ret false
  end
  u = ulong idx
  if ne omega_object_add_attribute u ot_k_z ot_v_1 1 0
    ret false
  end
  if ne omega_object_add_attribute u ot_k_a ot_v_2 1 0
    ret false
  end
  core_load_can u
  buf = new uchar 1024 0
  n = omega_canonical_encode buf 1024
  if le n 5
    ret false
  end
  if ne get buf 0 uchar 0x4f
    ret false
  end
  if ne get buf 1 uchar 0x4d
    ret false
  end
  if ne get buf 2 uchar 0x47
    ret false
  end
  if ne get buf 3 uchar 0x30
    ret false
  end
  if ne get buf 4 uchar 0x01
    ret false
  end
  pa = ot_find_sub buf ulong n ot_k_a
  pz = ot_find_sub buf ulong n ot_k_z
  omega_graph_destroy
  if lt pa 0
    ret false
  end
  if lt pz 0
    ret false
  end
  ret lt pa pz
end

fn ot_build_add_7_11 order_b bool dst edit uchar 32 to bool
  if ne omega_graph_create 0
    ret false
  end
  ti = omega_build_type_uint 32
  if lt ti 0
    ret false
  end
  tid = new uchar 32 0
  core_get_id ulong ti tid
  va = long 0
  vb = long 0
  op = long 0
  if order_b
    op = omega_build_op_binary 3 1 tid
    vb = omega_build_val_uint tid 32 11
    va = omega_build_val_uint tid 32 7
  else
    va = omega_build_val_uint tid 32 7
    vb = omega_build_val_uint tid 32 11
    op = omega_build_op_binary 3 1 tid
  end
  if lt va 0
    ret false
  end
  if lt vb 0
    ret false
  end
  if lt op 0
    ret false
  end
  ida = new uchar 32 0
  idb = new uchar 32 0
  ido = new uchar 32 0
  core_get_id ulong va ida
  core_get_id ulong vb idb
  core_get_id ulong op ido
  ap = omega_build_apply ido ida idb
  if lt ap 0
    ret false
  end
  core_get_id ulong ap dst
  ret true
end

fn ot_test_m4_semantic_id_determinism to bool
  id1 = new uchar 32 0
  id2 = new uchar 32 0
  if ne omega_graph_create 0
    ret false
  end
  t1 = omega_build_type_uint 32
  tid1 = new uchar 32 0
  core_get_id ulong t1 tid1
  v1 = omega_build_val_uint tid1 32 42
  core_get_id ulong v1 id1
  omega_graph_destroy

  if ne omega_graph_create 0
    ret false
  end
  t2 = omega_build_type_uint 32
  tid2 = new uchar 32 0
  core_get_id ulong t2 tid2
  v2 = omega_build_val_uint tid2 32 42
  core_get_id ulong v2 id2
  omega_graph_destroy
  ret eq omega_compare_semantic_id id1 id2 0
end

fn ot_test_m4_rep_independence out_id edit uchar 32 to bool
  id_a = new uchar 32 0
  id_x = new uchar 32 0
  bin = new uchar 4096 0
  blen = new ulong 1 0
  if not ot_build_add_7_11 false id_a
    ret false
  end
  if ne omega_graph_serialize_binary bin 4096 blen 0
    ret false
  end
  omega_graph_destroy
  for i ulong 32
    put out_id i get id_a i
  end

  if not ot_build_add_7_11 true id_x
    ret false
  end
  omega_graph_destroy
  if ne omega_compare_semantic_id id_a id_x 0
    ret false
  end

  if ne omega_graph_create 0
    ret false
  end
  if ne omega_graph_deserialize_binary bin get blen 0 0
    ret false
  end
  cnt_c = get g_core_obj_cnt 0
  if eq cnt_c 0
    ret false
  end
  core_get_id sub cnt_c 1 id_x
  omega_graph_destroy
  if ne omega_compare_semantic_id id_a id_x 0
    ret false
  end

  if ne omega_graph_create 0
    ret false
  end
  if ne omega_graph_parse_text ot_text_repr len ot_text_repr 0
    ret false
  end
  cnt_d = get g_core_obj_cnt 0
  if eq cnt_d 0
    ret false
  end
  core_get_id sub cnt_d 1 id_x
  omega_graph_destroy
  ret eq omega_compare_semantic_id id_a id_x 0
end

fn ot_build_sub_7_11 dst edit uchar 32 to bool
  if ne omega_graph_create 0
    ret false
  end
  ti = omega_build_type_uint 32
  id1 = new uchar 32 0
  id2 = new uchar 32 0
  id3 = new uchar 32 0
  core_get_id ulong ti id1
  va = omega_build_val_uint id1 32 7
  vb = omega_build_val_uint id1 32 11
  op = omega_build_op_binary 4 1 id1
  core_get_id ulong op id1
  core_get_id ulong va id2
  core_get_id ulong vb id3
  ap = omega_build_apply id1 id2 id3
  core_get_id ulong ap dst
  omega_graph_destroy
  ret ge ap 0
end

fn ot_test_m4_semantic_difference to bool
  id_add = new uchar 32 0
  id_sub = new uchar 32 0
  if not ot_build_add_7_11 false id_add
    ret false
  end
  omega_graph_destroy
  if not ot_build_sub_7_11 id_sub
    ret false
  end
  ret ne omega_compare_semantic_id id_add id_sub 0
end

fn ot_test_m4_relation to bool
  if ne omega_graph_create 0
    ret false
  end
  ti = omega_build_type_uint 32
  tid = new uchar 32 0
  core_get_id ulong ti tid
  o1 = omega_graph_add_object 4
  ign1 = omega_object_add_relation ulong o1 4 tid
  ign2 = omega_object_add_relation ulong o1 1 tid
  ign3 = core_compute_id ulong o1

  o2 = omega_graph_add_object 4
  ign4 = omega_object_add_relation ulong o2 1 tid
  ign5 = omega_object_add_relation ulong o2 4 tid
  ign6 = core_compute_id ulong o2

  id1 = new uchar 32 0
  id2 = new uchar 32 0
  core_get_id ulong o1 id1
  core_get_id ulong o2 id2
  omega_graph_destroy
  ret eq omega_compare_semantic_id id1 id2 0
end

fn ot_test_m4_constraint to bool
  if ne omega_graph_create 0
    ret false
  end
  p1 = new uchar 2 0
  put p1 0 1
  put p1 1 2
  p2 = new uchar 2 0
  put p2 0 3
  put p2 1 4
  c1 = omega_graph_add_object 5
  ign1 = omega_object_add_constraint ulong c1 1 p1 2
  ign2 = omega_object_add_constraint ulong c1 2 p2 2
  ign3 = core_compute_id ulong c1

  c2 = omega_graph_add_object 5
  ign4 = omega_object_add_constraint ulong c2 2 p2 2
  ign5 = omega_object_add_constraint ulong c2 1 p1 2
  ign6 = core_compute_id ulong c2

  id1 = new uchar 32 0
  id2 = new uchar 32 0
  core_get_id ulong c1 id1
  core_get_id ulong c2 id2
  omega_graph_destroy
  ret eq omega_compare_semantic_id id1 id2 0
end

fn ot_test_m4_pure_effect to bool
  if ne omega_graph_create 0
    ret false
  end
  ti = omega_build_type_uint 32
  tid = new uchar 32 0
  core_get_id ulong ti tid
  op = omega_build_op_binary 3 1 tid
  if lt op 0
    ret false
  end
  if eq get g_core_kind ulong op 8
    ret false
  end
  eff = omega_build_effect 1 1 0 1
  if lt eff 0
    ret false
  end
  if ne get g_core_kind ulong eff 8
    ret false
  end
  info = new ulong 2 0
  rc = omega_validate_graph info
  omega_graph_destroy
  ret eq rc 0
end

fn ot_test_m4_malformed to bool
  if ne omega_graph_create 0
    ret false
  end
  o1 = omega_graph_add_object 2
  u1 = ulong o1
  put g_core_pays mul u1 CAN_MAX_PAYLOAD uchar 2
  put g_core_pay_len u1 CORE_TP_SIZE
  ign1 = core_compute_id u1

  o2 = omega_graph_add_object 2
  u2 = ulong o2
  put g_core_pays mul u2 CAN_MAX_PAYLOAD uchar 2
  put g_core_pay_len u2 CORE_TP_SIZE
  ign2 = core_compute_id u2

  id1 = new uchar 32 0
  id2 = new uchar 32 0
  core_get_id u1 id1
  core_get_id u2 id2
  ign3 = omega_object_add_relation u1 6 id2
  ign4 = core_compute_id u1
  core_get_id u1 id1
  ign5 = omega_object_add_relation u2 6 id1
  ign6 = core_compute_id u2
  info = new ulong 2 0
  if eq omega_validate_graph info 0
    omega_graph_destroy
    ret false
  end
  omega_graph_destroy

  bad = new uchar 6 0
  put bad 4 1
  put bad 5 1
  if eq omega_graph_deserialize_binary bad 6 0
    ret false
  end
  ret true
end

fn ot_test_m4_cross_build to bool
  id = new uchar 32 0
  if not ot_build_add_7_11 false id
    ret false
  end
  omega_graph_destroy
  res = new ulong 1 0
  if ne omega_eval_pure_binary_uint 3 1 32 7 11 res 0
    ret false
  end
  if ne get res 0 18
    ret false
  end
  hx = new uchar 65 0
  omega_hex_semantic_id id hx
  ret eq get hx 64 0
end

fn ot_test_m4_real_id_all_code to bool
  put g_real_profile 0 1
  put g_real_entry_off 0 16
  for i ulong 32
    put g_real_sem_id i uchar 0x5a
  end
  for i ulong REAL_MAX_CODE_BYTES
    put g_real_code i uchar and add mul i 7 3 255
  end
  put g_real_code_len 0 REAL_MAX_CODE_BYTES
  if ne omega_compute_realization_id 0
    ret false
  end
  id1 = new uchar 32 0
  for i ulong 32
    put id1 i get g_real_id i
  end
  last = sub REAL_MAX_CODE_BYTES 1
  put g_real_code last xor get g_real_code last uchar 0xff
  if ne omega_compute_realization_id 0
    ret false
  end
  id2 = new uchar 32 0
  for i ulong 32
    put id2 i get g_real_id i
  end
  if eq omega_compare_semantic_id id1 id2 0
    ret false
  end
  put g_real_code_len 0 add REAL_MAX_CODE_BYTES 1
  if eq omega_compute_realization_id 0
    ret false
  end
  ret true
end

fn ot_test_m4_oversized_refusal to bool
  if ne omega_graph_create 0
    ret false
  end
  idx = omega_graph_add_object 1
  u = ulong idx
  val = new uchar 513 118
  if eq omega_object_add_attribute u ot_k_big val 513 0
    ret false
  end
  if ne get g_core_attr_n u 0
    ret false
  end
  if ne omega_object_add_attribute u ot_k_fits val 512 0
    ret false
  end
  if ne get g_core_attr_n u 1
    ret false
  end
  pay = new uchar 129 99
  if eq omega_object_add_constraint u 1 pay 129 0
    ret false
  end
  if ne get g_core_const_n u 0
    ret false
  end
  if ne omega_object_add_constraint u 1 pay 128 0
    ret false
  end
  if ne get g_core_const_n u 1
    ret false
  end
  cid = new uchar 32 0
  if eq omega_build_constraint_id 9 pay 129 cid 0
    ret false
  end
  omega_graph_destroy
  ret true
end

fn omega_run_m4_gates to int
  ot_puts ot_sep
  ot_puts m4_hdr
  ot_puts ot_sep
  put g_ot_gate_count 0 0
  put g_ot_gate_passed 0 0
  ot_report_gate m4_g1 ot_test_m4_object_model m4_d1
  ot_report_gate m4_g2 ot_test_m4_type_system m4_d2
  ot_report_gate m4_g3 ot_test_m4_graph_validation m4_d3
  ot_report_gate m4_g4 ot_test_m4_canonical_encoding m4_d4
  ot_report_gate m4_g5 ot_test_m4_semantic_id_determinism m4_d5
  tmp_id = new uchar 32 0
  ot_report_gate m4_g6 ot_test_m4_rep_independence tmp_id m4_d6
  ot_report_gate m4_g7 ot_test_m4_semantic_difference m4_d7
  ot_report_gate m4_g8 ot_test_m4_relation m4_d8
  ot_report_gate m4_g9 ot_test_m4_constraint m4_d9
  ot_report_gate m4_g10 ot_test_m4_pure_effect m4_d10
  ot_report_gate m4_g11 ot_test_m4_malformed m4_d11

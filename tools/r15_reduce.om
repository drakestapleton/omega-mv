note ---- Low-level I/O: ch 0=file(g_ofd), 1=stderr(2), 2=g_sbuf ----
fn io_flush ch ulong to void
  if eq ch 0
    n = get g_olen 0
    fd = get g_ofd 0
    if gt n 0
      if ge fd 0
        _w = write int fd g_obuf 0 n
        put g_olen 0 0
      end
    end
    ret
  end
  if eq ch 1
    n = get g_elen 0
    if gt n 0
      _w = write 2 g_ebuf 0 n
      put g_elen 0 0
    end
  end
end

fn io_putc ch ulong b uchar to void
  if eq ch 0
    n = get g_olen 0
    if ge n 16384
      io_flush 0
      n = 0
    end
    put g_obuf n b
    put g_olen 0 add n 1
    ret
  end
  if eq ch 1
    n = get g_elen 0
    if ge n 4096
      io_flush 1
      n = 0
    end
    put g_ebuf n b
    put g_elen 0 add n 1
    ret
  end
  n = get g_slen 0
  if lt n 511
    put g_sbuf n b
    put g_slen 0 add n 1
  end
end

fn io_puts ch ulong s view uchar * to void
  n = len s
  for i ulong n
    io_putc ch get s i
  end
end

fn io_put_u64 ch ulong v ulong to void
  if eq v 0
    io_putc ch uchar 48
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_numbuf n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = n
  while gt i 0
    i = sub i 1
    io_putc ch get g_numbuf i
  end
end

fn io_put_i64 ch ulong v long to void
  if lt v 0
    io_putc ch uchar 45
    uv = sub ulong 0 bitcast ulong v
    io_put_u64 ch uv
    ret
  end
  io_put_u64 ch ulong v
end

fn is_nan x f64 to bool
  ret ne x x
end

fn is_inf x f64 to bool
  if ne x x
    ret false
  end
  ret ne sub x x f64 0.0
end

fn r15_fabs x f64 to f64
  if lt x f64 0.0
    ret sub f64 0.0 x
  end
  ret x
end

fn r15_nan to f64
  ret div f64 0.0 f64 0.0
end

fn b2u b bool to ulong
  if b
    ret 1
  end
  ret 0
end

fn ceil_u p f64 n ulong to ulong
  x = mul p f64 n
  if le x f64 0.0
    ret 0
  end
  i = ulong x
  if lt f64 i x
    i = add i 1
  end
  ret i
end

fn io_put_fix_frac ch ulong fr ulong sc ulong to void
  io_putc ch uchar 46
  d = div sc 10
  while gt d 0
    dig = rem div fr d 10
    io_putc ch uchar add 48 dig
    d = div d 10
  end
end

fn io_put_fix ch ulong x f64 dp ulong to void
  if is_nan x
    io_puts ch t_nan
    ret
  end
  if is_inf x
    if lt x f64 0.0
      io_puts ch t_ninf
    else
      io_puts ch t_inf
    end
    ret
  end
  ax = x
  if lt ax f64 0.0
    io_putc ch uchar 45
    ax = sub f64 0.0 ax
  end
  sc = ulong 1
  for i ulong dp
    sc = mul sc 10
  end
  scaled = ulong add mul ax f64 sc f64 0.5
  io_put_u64 ch div scaled sc
  if gt dp 0
    io_put_fix_frac ch rem scaled sc sc
  end
end

fn io_put_g9_emit ch ulong exp long last ulong to void
  if and ge exp -4 lt exp 9
    if lt exp 0
      io_putc ch uchar 48
      io_putc ch uchar 46
      zs = ulong sub -1 exp
      for i ulong zs
        io_putc ch uchar 48
      end
      for i ulong last
        io_putc ch get g_numbuf i
      end
    else
      ip = add ulong exp 1
      for i ulong ip
        if lt i last
          io_putc ch get g_numbuf i
        else
          io_putc ch uchar 48
        end
      end
      if gt last ip
        io_putc ch uchar 46
        i = ip
        while lt i last
          io_putc ch get g_numbuf i
          i = add i 1
        end
      end
    end
  else
    io_putc ch get g_numbuf 0
    if gt last 1
      io_putc ch uchar 46
      i = ulong 1
      while lt i last
        io_putc ch get g_numbuf i
        i = add i 1
      end
    end
    io_putc ch uchar 101
    if lt exp 0
      io_putc ch uchar 45
      ae = ulong sub 0 exp
      if lt ae 10
        io_putc ch uchar 48
      end
      io_put_u64 ch ae
    else
      io_putc ch uchar 43
      ae = ulong exp
      if lt ae 10
        io_putc ch uchar 48
      end
      io_put_u64 ch ae
    end
  end
end

fn round_even x f64 to ulong
  d = ulong x
  fr = sub x f64 d
  if gt fr f64 0.5
    ret add d 1
  end
  if eq fr f64 0.5
    if eq rem d 2 1
      ret add d 1
    end
  end
  ret d
end

fn io_put_g9 ch ulong x f64 to void
  if or is_nan x is_inf x
    io_puts ch t_null
    ret
  end
  ax = r15_fabs x
  if lt ax f64 9000000000000000.0
    if eq f64 long x x
      io_put_i64 ch long x
      ret
    end
  end
  if lt x f64 0.0
    io_putc ch uchar 45
  end
  if eq ax f64 0.0
    io_putc ch uchar 48
    ret
  end
  exp = long 0
  m = ax
  while ge m f64 10.0
    m = div m f64 10.0
    exp = add exp 1
  end
  while lt m f64 1.0
    m = mul m f64 10.0
    exp = sub exp 1
  end
  digs = round_even mul m f64 100000000.0
  if ge digs 1000000000
    digs = div digs 10
    exp = add exp 1
  end
  for i ulong 9
    put g_numbuf sub 8 i uchar add 48 rem digs 10
    digs = div digs 10
  end
  last = ulong 9
  while gt last 1
    if ne get g_numbuf sub last 1 uchar 48
      break
    end
    last = sub last 1
  end
  io_put_g9_emit ch exp last
end

note ---- Table byte reader: 0=g_t_file, 1=g_t_cfg, 2=g_fname, 3=g_fhash, 4=g_sbuf, 5=g_g1_why, 6=g_wname, 7=g_gt_note, 8=g_bar_cfg, 9=g_l2_cfg, 10=g_wr_cfg, 11=g_sums_hex, 12=g_kbuf ----
fn tb_get tbl ulong idx ulong to uchar
  if eq tbl 0
    ret get g_t_file idx
  end
  if eq tbl 1
    ret get g_t_cfg idx
  end
  if eq tbl 2
    ret get g_fname idx
  end
  if eq tbl 3
    ret get g_fhash idx
  end
  if eq tbl 4
    ret get g_sbuf idx
  end
  if eq tbl 5
    ret get g_g1_why idx
  end
  if eq tbl 6
    ret get g_wname idx
  end
  if eq tbl 7
    ret get g_gt_note idx
  end
  if eq tbl 8
    ret get g_bar_cfg idx
  end
  if eq tbl 9
    ret get g_l2_cfg idx
  end
  if eq tbl 10
    ret get g_wr_cfg idx
  end
  if eq tbl 11
    ret get g_sums_hex idx
  end
  ret get g_kbuf idx
end

fn io_put_cs ch ulong tbl ulong off ulong cap ulong to void
  for i ulong cap
    c = tb_get tbl add off i
    if eq c 0
      ret
    end
    io_putc ch c
  end
end

fn io_put_mem ch ulong tbl ulong off ulong n ulong to void
  for i ulong n
    io_putc ch tb_get tbl add off i
  end
end

fn cs_eq_t tbl ulong off ulong cap ulong s view uchar * to bool
  n = len s
  for i ulong cap
    c = tb_get tbl add off i
    if eq c 0
      ret eq i n
    end
    if ge i n
      ret false
    end
    if ne c get s i
      ret false
    end
  end
  ret eq cap n
end

fn cs_has_sub tbl ulong off ulong cap ulong s view uchar * to bool
  m = len s
  if eq m 0
    ret true
  end
  n = ulong 0
  while lt n cap
    if eq tb_get tbl add off n 0
      break
    end
    n = add n 1
  end
  if lt n m
    ret false
  end
  lim = add sub n m 1
  for i ulong lim
    ok = true
    for j ulong m
      if ne tb_get tbl add off add i j get s j
        ok = false
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn cs_starts tbl ulong off ulong cap ulong s view uchar * to bool
  m = len s
  if gt m cap
    ret false
  end
  for i ulong m
    c = tb_get tbl add off i
    if ne c get s i
      ret false
    end
  end
  ret true
end

note ---- JSON writer (channel 0) ----
fn o_sep to void
  d = get g_fdepth 0
  if eq get g_fstack d 0
    io_putc 0 uchar 44
  end
  put g_fstack d 0
end

fn o_key k view uchar * to void
  o_sep
  if gt len k 0
    io_putc 0 uchar 34
    io_puts 0 k
    io_putc 0 uchar 34
    io_putc 0 uchar 58
  end
end

fn o_key_kbuf to void
  o_sep
  io_putc 0 uchar 34
  io_put_mem 0 12 0 get g_klen 0
  io_putc 0 uchar 34
  io_putc 0 uchar 58
end

fn o_open k view uchar * c uchar to void
  o_key k
  io_putc 0 c
  d = add get g_fdepth 0 1
  put g_fdepth 0 d
  put g_fstack d 1
end

fn o_open_kbuf c uchar to void
  o_key_kbuf
  io_putc 0 c
  d = add get g_fdepth 0 1
  put g_fdepth 0 d
  put g_fstack d 1
end

fn o_open_anon c uchar to void
  o_sep
  io_putc 0 c
  d = add get g_fdepth 0 1
  put g_fdepth 0 d
  put g_fstack d 1
end

fn o_close c uchar to void
  io_putc 0 c
  put g_fdepth 0 sub get g_fdepth 0 1
end

fn o_num k view uchar * x f64 to void
  o_key k
  io_put_g9 0 x
end

fn o_u k view uchar * x ulong to void
  o_key k
  io_put_u64 0 x
end

fn o_str k view uchar * s view uchar * to void
  o_key k
  io_putc 0 uchar 34
  io_puts 0 s
  io_putc 0 uchar 34
end

fn o_str_cs k view uchar * tbl ulong off ulong cap ulong to void
  o_key k
  io_putc 0 uchar 34
  io_put_cs 0 tbl off cap
  io_putc 0 uchar 34
end

fn o_str_mem k view uchar * tbl ulong off ulong n ulong to void
  o_key k
  io_putc 0 uchar 34
  io_put_mem 0 tbl off n
  io_putc 0 uchar 34
end

fn o_bool k view uchar * b bool to void
  o_key k
  if b
    io_puts 0 t_true
  else
    io_puts 0 t_false
  end
end

note ---- FIPS 180-4 SHA-256 ----
fn sh_init_tbl to void
  if ne get g_shk 0 0
    ret
  end
  put g_shk 0 1116352408
  put g_shk 1 1899447441
  put g_shk 2 3049323471
  put g_shk 3 3921009573
  put g_shk 4 961987163
  put g_shk 5 1508970993
  put g_shk 6 2453635748
  put g_shk 7 2870763221
  put g_shk 8 3624381080
  put g_shk 9 310598401
  put g_shk 10 607225278
  put g_shk 11 1426881987
  put g_shk 12 1925078388
  put g_shk 13 2162078206
  put g_shk 14 2614888103
  put g_shk 15 3248222580
  put g_shk 16 3835390401
  put g_shk 17 4022224774
  put g_shk 18 264347078
  put g_shk 19 604807628
  put g_shk 20 770255983
  put g_shk 21 1249150122
  put g_shk 22 1555081692
  put g_shk 23 1996064986
  put g_shk 24 2554220882
  put g_shk 25 2821834349
  put g_shk 26 2952996808
  put g_shk 27 3210313671
  put g_shk 28 3336571891
  put g_shk 29 3584528711
  put g_shk 30 113926993
  put g_shk 31 338241895
  put g_shk 32 666307205
  put g_shk 33 773529912
  put g_shk 34 1294757372
  put g_shk 35 1396182291
  put g_shk 36 1695183700
  put g_shk 37 1986661051
  put g_shk 38 2177026350
  put g_shk 39 2456956037
  put g_shk 40 2730485921
  put g_shk 41 2820302411
  put g_shk 42 3259730800
  put g_shk 43 3345764771
  put g_shk 44 3516065817
  put g_shk 45 3600352804
  put g_shk 46 4094571909
  put g_shk 47 275423344
  put g_shk 48 430227734
  put g_shk 49 506948616
  put g_shk 50 659060556
  put g_shk 51 883997877
  put g_shk 52 958139571
  put g_shk 53 1322822218
  put g_shk 54 1537002063
  put g_shk 55 1747873779
  put g_shk 56 1955562222
  put g_shk 57 2024104815
  put g_shk 58 2227730452
  put g_shk 59 2361852424
  put g_shk 60 2428436474
  put g_shk 61 2756734187
  put g_shk 62 3204031479
  put g_shk 63 3329325298
  put g_shk 64 1779033703
  put g_shk 65 3144134277
  put g_shk 66 1013904242
  put g_shk 67 2773480762
  put g_shk 68 1359893119
  put g_shk 69 2600822924
  put g_shk 70 528734635
  put g_shk 71 1541459225
end

fn sh_load_w to void
  for i ulong 16
    b0 = shl uint get g_shb mul i 4 uint 24
    b1 = shl uint get g_shb add mul i 4 1 uint 16
    b2 = shl uint get g_shb add mul i 4 2 uint 8
    b3 = uint get g_shb add mul i 4 3
    put g_shw i or or b0 b1 or b2 b3
  end
  i = ulong 16
  while lt i 64
    x = get g_shw sub i 15
    s0 = xor xor rotr x uint 7 rotr x uint 18 shr x uint 3
    y = get g_shw sub i 2
    s1 = xor xor rotr y uint 17 rotr y uint 19 shr y uint 10
    put g_shw i add add get g_shw sub i 16 s0 add get g_shw sub i 7 s1
    i = add i 1
  end
end

fn sh_round j ulong to void
  e = get g_shv 4
  t1 = xor xor rotr e uint 6 rotr e uint 11 rotr e uint 25
  t1 = add t1 get g_shv 7
  t1 = add t1 xor and e get g_shv 5 and not e get g_shv 6
  t1 = add add t1 get g_shk j get g_shw j
  a = get g_shv 0
  t2 = xor xor rotr a uint 2 rotr a uint 13 rotr a uint 22
  b = get g_shv 1
  c = get g_shv 2
  t2 = add t2 xor xor and a b and a c and b c
  put g_shv 7 get g_shv 6
  put g_shv 6 get g_shv 5
  put g_shv 5 e
  put g_shv 4 add get g_shv 3 t1
  put g_shv 3 c
  put g_shv 2 b
  put g_shv 1 a
  put g_shv 0 add t1 t2
end

fn sh_block to void
  sh_load_w
  for j ulong 8
    put g_shv j get g_shh j
  end
  for j ulong 64
    sh_round j
  end
  for j ulong 8
    put g_shh j add get g_shh j get g_shv j
  end
end

fn sh_init to void
  sh_init_tbl
  for i ulong 8
    put g_shh i get g_shk add i 64
  end
  put g_shm 0 0
  put g_shm 1 0
end

fn sh_byte b uchar to void
  bl = get g_shm 0
  put g_shb bl b
  bl = add bl 1
  put g_shm 1 add get g_shm 1 1
  if eq bl 64
    sh_block
    bl = 0
  end
  put g_shm 0 bl
end

fn sh_final_hex to void
  tot = get g_shm 1
  bits = mul tot 8
  sh_byte uchar 128
  while ne get g_shm 0 56
    sh_byte uchar 0
  end
  for i ulong 8
    sh = mul sub 7 i 8
    sh_byte uchar and shr bits sh 255
  end
  for i ulong 8
    w = get g_shh i
    for k ulong 8
      sh = mul sub 7 k 4
      d = ulong and shr w uint sh uint 15
      c = add 48 d
      if ge d 10
        c = add 87 d
      end
      put g_hextmp add mul i 8 k uchar c
    end
  end
end

fn hash_path plen ulong to long
  fd = fopen g_path 0 plen 0 0
  if lt fd 0
    ret -1
  end
  sh_init
  while true bound 100000
    rd = read int fd g_iobuf 0 65536
    if lt rd 0
      _fc = fclose int fd
      ret -1
    end
    if eq rd 0
      break
    end
    n = ulong rd
    for i ulong n
      sh_byte get g_iobuf i
    end
  end
  _fc = fclose int fd
  sh_final_hex
  ret 0
end

note ---- Streaming line reader ----
fn rl_init to void
  put g_rpos 0 0
  put g_rlen 0 0
  put g_reof 0 0
end

fn rl_next fd int to long
  n = ulong 0
  while true bound 600000
    p = get g_rpos 0
    l = get g_rlen 0
    if ge p l
      if ne get g_reof 0 0
        break
      end
      rd = read fd g_rbuf 0 65536
      if le rd 0
        put g_reof 0 1
        break
      end
      put g_rpos 0 0
      put g_rlen 0 ulong rd
      p = 0
      l = ulong rd
    end
    c = get g_rbuf p
    put g_rpos 0 add p 1
    if eq c uchar 10
      put g_jbuf n uchar 0
      put g_jlen 0 n
      ret 1
    end
    if lt n sub R15_LINE_CAP 1
      put g_jbuf n c
      n = add n 1
    end
  end
  if eq n 0
    ret 0
  end
  put g_jbuf n uchar 0
  put g_jlen 0 n
  ret 1
end

note ---- Per-line JSON parser ----
fn jp_ws to void
  n = get g_jlen 0
  p = get g_jpos 0
  while lt p n
    c = get g_jbuf p
    if or eq c 32 or eq c 9 or eq c 10 eq c 13
      p = add p 1
    else
      put g_jpos 0 p
      ret
    end
  end
  put g_jpos 0 p
end

fn jp_new t ulong to long
  idx = get g_jn_n 0
  if ge idx R15_MAXJN
    ret -1
  end
  put g_jn_n 0 add idx 1
  put g_jn_t idx t
  put g_jn_d idx f64 0.0
  put g_jn_u idx 0
  put g_jn_iu idx 0
  put g_jn_so idx 0
  put g_jn_sl idx 0
  put g_jn_ko idx 0
  put g_jn_kl idx 0
  put g_jn_fc idx 0
  put g_jn_lc idx 0
  put g_jn_nx idx 0
  put g_jn_cnt idx 0
  ret long idx
end

fn jp_str_raw to long
  n = get g_jlen 0
  p = get g_jpos 0
  if ge p n
    ret -1
  end
  if ne get g_jbuf p uchar 34
    ret -1
  end
  p = add p 1
  so = get g_jslen 0
  sl = ulong 0
  while lt p n
    c = get g_jbuf p
    if eq c uchar 34
      put g_jpos 0 add p 1
      put g_jslen 0 add so sl
      put g_tmpu 0 so
      put g_tmpu 1 sl
      ret 0
    end
    p = add p 1
    if eq c uchar 92
      if lt p n
        c = get g_jbuf p
        p = add p 1
      end
    end
    if lt add so sl R15_JSTR_CAP
      put g_jstr add so sl c
      sl = add sl 1
    end
  end
  ret -1
end

fn jp_match s view uchar * to bool
  n = get g_jlen 0
  p = get g_jpos 0
  m = len s
  if gt add p m n
    ret false
  end
  for i ulong m
    if ne get g_jbuf add p i get s i
      ret false
    end
  end
  put g_jpos 0 add p m
  ret true
end

fn jp_is_dig p ulong n ulong to bool
  if ge p n
    ret false
  end
  c = get g_jbuf p
  ret and ge c uchar 48 le c uchar 57
end

fn jp_parse_exp fl f64 to f64
  n = get g_jlen 0
  p = get g_jpos 0
  eneg = false
  if lt p n
    ec = get g_jbuf p
    if eq ec uchar 45
      eneg = true
      p = add p 1
    else
      if eq ec uchar 43
        p = add p 1
      end
    end
  end
  ev = ulong 0
  while jp_is_dig p n
    ev = add mul ev 10 ulong sub get g_jbuf p uchar 48
    p = add p 1
  end
  put g_jpos 0 p
  res = fl
  for i ulong ev
    if eneg
      res = div res f64 10.0
    else
      res = mul res f64 10.0
    end
  end
  ret res
end

fn jp_parse_frac fl f64 to f64
  n = get g_jlen 0
  p = get g_jpos 0
  sc = f64 0.1
  res = fl
  while jp_is_dig p n
    d = ulong sub get g_jbuf p uchar 48
    res = add res mul f64 d sc
    sc = mul sc f64 0.1
    p = add p 1
  end
  put g_jpos 0 p
  ret res
end

fn jp_parse_num to long
  n = get g_jlen 0
  p = get g_jpos 0
  if ge p n
    ret -1
  end
  negv = false
  if eq get g_jbuf p uchar 45
    negv = true
    p = add p 1
  end
  if not jp_is_dig p n
    ret -1
  end
  u = ulong 0
  fl = f64 0.0
  is_u = not negv
  while jp_is_dig p n
    d = ulong sub get g_jbuf p uchar 48
    if or gt u 1844674407370955161 and eq u 1844674407370955161 gt d 5
      is_u = false
    else
      u = add mul u 10 d
    end
    fl = add mul fl f64 10.0 f64 d
    p = add p 1
  end
  put g_jpos 0 p
  if lt p n
    if eq get g_jbuf p uchar 46
      is_u = false
      put g_jpos 0 add p 1
      fl = jp_parse_frac fl
      p = get g_jpos 0
    end
  end
  if lt p n
    ec = get g_jbuf p
    if or eq ec uchar 101 eq ec uchar 69
      is_u = false
      put g_jpos 0 add p 1
      fl = jp_parse_exp fl
    end
  end
  nd = jp_new JT_NUM
  if lt nd 0
    ret -1
  end
  ni = ulong nd
  if is_u
    put g_jn_u ni u
    put g_jn_iu ni 1
    put g_jn_d ni f64 u
  else
    if negv
      fl = sub f64 0.0 fl
    end
    put g_jn_d ni fl
  end
  ret nd
end

fn jp_push par ulong ch ulong to void
  fc = get g_jn_fc par
  if eq fc 0
    put g_jn_fc par ch
    put g_jn_lc par ch
  else
    lc = get g_jn_lc par
    put g_jn_nx lc ch
    put g_jn_lc par ch
  end
  put g_jn_cnt par add get g_jn_cnt par 1
end

fn jp_parse to long
  jp_ws
  n = get g_jlen 0
  p = get g_jpos 0
  if ge p n
    ret -1
  end
  c = get g_jbuf p
  if eq c uchar 123
    put g_jpos 0 add p 1
    nd = jp_new JT_OBJ
    if lt nd 0
      ret -1
    end
    obj = ulong nd
    jp_ws
    p2 = get g_jpos 0
    if lt p2 n
      if eq get g_jbuf p2 uchar 125
        put g_jpos 0 add p2 1
        ret nd
      end
    end
    while true
      jp_ws
      if lt jp_str_raw 0
        ret -1
      end
      ko = get g_tmpu 0
      kl = get g_tmpu 1
      jp_ws
      p3 = get g_jpos 0
      if ge p3 n
        ret -1
      end
      if ne get g_jbuf p3 uchar 58
        ret -1
      end
      put g_jpos 0 add p3 1
      val = jp_parse
      if lt val 0
        ret -1
      end
      vi = ulong val
      put g_jn_ko vi ko
      put g_jn_kl vi kl
      jp_push obj vi
      jp_ws
      p4 = get g_jpos 0
      if ge p4 n
        ret -1
      end
      c4 = get g_jbuf p4
      if eq c4 uchar 44
        put g_jpos 0 add p4 1
      else
        if eq c4 uchar 125
          put g_jpos 0 add p4 1
          ret nd
        else
          ret -1
        end
      end
    end
  end
  if eq c uchar 91
    put g_jpos 0 add p 1
    nd = jp_new JT_ARR
    if lt nd 0
      ret -1
    end
    arr = ulong nd
    jp_ws
    p2 = get g_jpos 0
    if lt p2 n
      if eq get g_jbuf p2 uchar 93
        put g_jpos 0 add p2 1
        ret nd
      end
    end
    while true
      val = jp_parse
      if lt val 0
        ret -1
      end
      jp_push arr ulong val
      jp_ws
      p4 = get g_jpos 0
      if ge p4 n
        ret -1
      end
      c4 = get g_jbuf p4
      if eq c4 uchar 44
        put g_jpos 0 add p4 1
      else
        if eq c4 uchar 93
          put g_jpos 0 add p4 1
          ret nd
        else
          ret -1
        end
      end
    end
  end
  if eq c uchar 34
    if lt jp_str_raw 0
      ret -1
    end
    nd = jp_new JT_STR
    if lt nd 0
      ret -1
    end
    put g_jn_so ulong nd get g_tmpu 0
    put g_jn_sl ulong nd get g_tmpu 1
    ret nd
  end
  if jp_match t_true
    nd = jp_new JT_BOOL
    if ge nd 0
      put g_jn_d ulong nd f64 1.0
    end
    ret nd
  end
  if jp_match t_false
    ret jp_new JT_BOOL
  end
  if jp_match t_null
    ret jp_new JT_NULL
  end
  ret jp_parse_num
end

fn jget o long k view uchar * to long
  if lt o 0
    ret -1
  end
  if ne get g_jn_t ulong o JT_OBJ
    ret -1
  end
  kl = len k
  cur = get g_jn_fc ulong o
  while gt cur 0
    if eq get g_jn_kl cur kl
      ko = get g_jn_ko cur
      ok = true
      for i ulong kl
        if ne get g_jstr add ko i get k i
          ok = false
        end
      end
      if ok
        ret long cur
      end
    end
    cur = get g_jn_nx cur
  end
  ret -1
end

fn jarr_at a long idx ulong to long
  if lt a 0
    ret -1
  end
  if ne get g_jn_t ulong a JT_ARR
    ret -1
  end
  if ge idx get g_jn_cnt ulong a
    ret -1
  end
  cur = get g_jn_fc ulong a
  for i ulong idx
    cur = get g_jn_nx cur
  end
  ret long cur
end

fn jd o long k view uchar * to f64
  v = jget o k
  if lt v 0
    ret r15_nan
  end
  if ne get g_jn_t ulong v JT_NUM
    ret r15_nan
  end
  ret get g_jn_d ulong v
end

fn ju o long k view uchar * to ulong
  v = jget o k
  if lt v 0
    ret 0
  end
  vi = ulong v
  if ne get g_jn_t vi JT_NUM
    ret 0
  end
  if ne get g_jn_iu vi 0
    ret get g_jn_u vi
  end
  d = get g_jn_d vi
  if lt d f64 0.0
    ret 0
  end
  ret ulong d
end

fn jau a long idx ulong to ulong
  v = jarr_at a idx
  if lt v 0
    ret 0
  end
  ret get g_jn_u ulong v
end

fn jstr_eq o long k view uchar * s view uchar * to bool
  v = jget o k
  if lt v 0
    ret eq len s 0
  end
  vi = ulong v
  if ne get g_jn_t vi JT_STR
    ret eq len s 0
  end
  sl = get g_jn_sl vi
  if ne sl len s
    ret false
  end
  so = get g_jn_so vi
  for i ulong sl
    if ne get g_jstr add so i get s i
      ret false
    end
  end
  ret true
end

fn jstr_starts o long k view uchar * s view uchar * to bool
  v = jget o k
  if lt v 0
    ret eq len s 0
  end
  vi = ulong v
  if ne get g_jn_t vi JT_STR
    ret eq len s 0
  end
  if lt get g_jn_sl vi len s
    ret false
  end
  so = get g_jn_so vi
  for i ulong len s
    if ne get g_jstr add so i get s i
      ret false
    end
  end
  ret true
end

fn jcopy_cfg o long k view uchar * dst ulong off ulong to void
  v = jget o k
  so = ulong 0
  sl = ulong 0
  if ge v 0
    vi = ulong v
    if eq get g_jn_t vi JT_STR
      so = get g_jn_so vi
      sl = get g_jn_sl vi
    end
  end
  lim = ulong 23
  if lt sl lim
    lim = sl
  end
  for i ulong 24
    c = uchar 0
    if lt i lim
      c = get g_jstr add so i
    end
    if eq dst 0
      put g_t_cfg add off i c
    else
      if eq dst 1
        put g_l2_cfg add off i c
      else
        if eq dst 2
          put g_bar_cfg add off i c
        else
          put g_wr_cfg add off i c
        end
      end
    end
  end
end

note ---- Sorting & Statistics ----
fn sift_u start ulong endi ulong to void
  r = start
  while le add mul r 2 1 endi
    ch = add mul r 2 1
    sw = r
    if lt get g_sort_u sw get g_sort_u ch
      sw = ch
    end
    if le add ch 1 endi
      c2 = add ch 1
      if lt get g_sort_u sw get g_sort_u c2
        sw = c2
      end
    end
    if eq sw r
      ret
    end
    tmp = get g_sort_u r
    put g_sort_u r get g_sort_u sw
    put g_sort_u sw tmp
    r = sw
  end
end

fn sort_u n ulong to void
  if le n 1
    ret
  end
  i = div n 2
  while gt i 0
    i = sub i 1
    sift_u i sub n 1
  end
  ei = sub n 1
  while gt ei 0
    tmp = get g_sort_u ei
    put g_sort_u ei get g_sort_u 0
    put g_sort_u 0 tmp
    ei = sub ei 1
    sift_u 0 ei
  end
end

fn sift_hs start ulong endi ulong to void
  r = start
  while le add mul r 2 1 endi
    ch = add mul r 2 1
    sw = r
    if lt get g_hs_lo sw get g_hs_lo ch
      sw = ch
    end
    if le add ch 1 endi
      c2 = add ch 1
      if lt get g_hs_lo sw get g_hs_lo c2
        sw = c2
      end
    end
    if eq sw r
      ret
    end
    tl = get g_hs_lo r
    put g_hs_lo r get g_hs_lo sw
    put g_hs_lo sw tl
    tc = get g_hs_cnt r
    put g_hs_cnt r get g_hs_cnt sw
    put g_hs_cnt sw tc
    r = sw
  end
end

fn sort_hs n ulong to void
  if le n 1
    ret
  end
  i = div n 2
  while gt i 0
    i = sub i 1
    sift_hs i sub n 1
  end
  ei = sub n 1
  while gt ei 0
    tl = get g_hs_lo ei
    put g_hs_lo ei get g_hs_lo 0
    put g_hs_lo 0 tl
    tc = get g_hs_cnt ei
    put g_hs_cnt ei get g_hs_cnt 0
    put g_hs_cnt 0 tc
    ei = sub ei 1
    sift_hs 0 ei
  end
end

fn sift_boot start ulong endi ulong to void
  r = start
  while le add mul r 2 1 endi
    ch = add mul r 2 1
    sw = r
    if lt get g_boot sw get g_boot ch
      sw = ch
    end
    if le add ch 1 endi
      c2 = add ch 1
      if lt get g_boot sw get g_boot c2
        sw = c2
      end
    end
    if eq sw r
      ret
    end
    tmp = get g_boot r
    put g_boot r get g_boot sw
    put g_boot sw tmp
    r = sw
  end
end

fn sort_boot n ulong to void
  if le n 1
    ret
  end
  i = div n 2
  while gt i 0
    i = sub i 1
    sift_boot i sub n 1
  end
  ei = sub n 1
  while gt ei 0
    tmp = get g_boot ei
    put g_boot ei get g_boot 0
    put g_boot 0 tmp
    ei = sub ei 1
    sift_boot 0 ei
  end
end

fn median_bsamp n ulong to f64
  if eq n 0
    ret r15_nan
  end
  i = ulong 1
  while lt i n
    v = get g_bsamp i
    j = i
    while gt j 0
      pv = get g_bsamp sub j 1
      if le pv v
        break
      end
      put g_bsamp j pv
      j = sub j 1
    end
    put g_bsamp j v
    i = add i 1
  end
  if eq rem n 2 1
    ret get g_bsamp div n 2
  end
  h = div n 2
  ret div add get g_bsamp sub h 1 get g_bsamp h f64 2.0
end

fn median_vd n ulong which ulong to f64
  if eq n 0
    ret r15_nan
  end
  for i ulong n
    if eq which 0
      put g_bsamp i get g_vd i
    else
      put g_bsamp i get g_vd2 i
    end
  end
  ret median_bsamp n
end

fn splitmix to ulong
  z = add get g_rng 0 ulong 0x9e3779b97f4a7c15
  put g_rng 0 z
  z = mul xor z shr z 30 ulong 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 ulong 0x94d049bb133111eb
  ret xor z shr z 31
end

fn boot_ci_vd n ulong slot ulong to void
  bo = mul slot 3
  put g_cmp_d add bo 1 r15_nan
  put g_cmp_d add bo 2 r15_nan
  if lt n 2
    ret
  end
  put g_rng 0 21
  for b ulong R15_RESAMP
    for i ulong n
      idx = rem splitmix n
      put g_bsamp i get g_vd idx
    end
    put g_boot b median_bsamp n
  end
  sort_boot R15_RESAMP
  put g_cmp_d add bo 1 get g_boot 249
  put g_cmp_d add bo 2 get g_boot 9749
end

fn pct_u_at n ulong p f64 to ulong
  if eq n 0
    ret 0
  end
  r = ceil_u p n
  if lt r 1
    r = 1
  end
  if gt r n
    r = n
  end
  ret get g_sort_u sub r 1
end

fn pct_of_sortu n ulong to void
  for i ulong 7
    put g_pct i 0
  end
  if eq n 0
    ret
  end
  sort_u n
  put g_pct 0 n
  put g_pct 1 pct_u_at n f64 0.50
  put g_pct 2 pct_u_at n f64 0.90
  put g_pct 3 pct_u_at n f64 0.95
  put g_pct 4 pct_u_at n f64 0.99
  put g_pct 5 pct_u_at n f64 0.999
  put g_pct 6 get g_sort_u sub n 1
end

fn o_pct k view uchar * to void
  o_open k uchar 123
  o_u t_o_n get g_pct 0
  o_u t_o_p50 get g_pct 1
  o_u t_o_p90 get g_pct 2
  o_u t_o_p95 get g_pct 3
  o_u t_o_p99 get g_pct 4
  o_u t_o_p999 get g_pct 5
  o_u t_o_max get g_pct 6
  o_close uchar 125
end

fn o_pct_kbuf to void
  o_open_kbuf uchar 123
  o_u t_o_n get g_pct 0
  o_u t_o_p50 get g_pct 1
  o_u t_o_p90 get g_pct 2
  o_u t_o_p95 get g_pct 3
  o_u t_o_p99 get g_pct 4
  o_u t_o_p999 get g_pct 5
  o_u t_o_max get g_pct 6
  o_close uchar 125
end

note ---- L1 set storage (chunked blocks of 1024 ulongs) ----
fn sb_reset to void
  put g_slen 0 0
end

fn sb_put_jstr o long k view uchar * to void
  v = jget o k
  if lt v 0
    ret
  end
  vi = ulong v
  if ne get g_jn_t vi JT_STR
    ret
  end
  so = get g_jn_so vi
  sl = get g_jn_sl vi
  for i ulong sl
    io_putc 2 get g_jstr add so i
  end
end

fn l1_key_eq idx ulong to bool
  ko = mul idx 96
  sl = get g_slen 0
  if ge sl 95
    sl = 95
  end
  for i ulong sl
    if ne get g_l1_key add ko i get g_sbuf i
      ret false
    end
  end
  ret eq get g_l1_key add ko sl uchar 0
end

fn l1_find to long
  nl = get g_nl1 0
  for i ulong nl
    if l1_key_eq i
      ret long i
    end
  end
  ret -1
end

fn l1_find_or_add to ulong
  f = l1_find
  if ge f 0
    ret ulong f
  end
  nl = get g_nl1 0
  if ge nl R15_MAXL1
    io_puts 1 t_toomany_l1
    io_flush 1
    exit 3
  end
  ko = mul nl 96
  sl = get g_slen 0
  if ge sl 95
    sl = 95
  end
  for i ulong 96
    c = uchar 0
    if lt i sl
      c = get g_sbuf i
    end
    put g_l1_key add ko i c
  end
  put g_l1_hd nl 0
  put g_l1_tl nl 0
  put g_l1_cnt nl 0
  put g_nl1 0 add nl 1
  ret nl
end

fn l1_push sid ulong v ulong to void
  tl = get g_l1_tl sid
  need = eq tl 0
  if not need
    if ge get g_l1_bln tl R15_L1_BSZ
      need = true
    end
  end
  if need
    nb = get g_l1_nb 0
    if ge nb R15_L1_BLKS
      exit 3
    end
    put g_l1_nb 0 add nb 1
    put g_l1_bnx nb 0
    put g_l1_bln nb 0
    if eq tl 0
      put g_l1_hd sid nb
    else
      put g_l1_bnx tl nb
    end
    put g_l1_tl sid nb
    tl = nb
  end
  bl = get g_l1_bln tl
  put g_l1_val add mul tl R15_L1_BSZ bl v
  put g_l1_bln tl add bl 1
  put g_l1_cnt sid add get g_l1_cnt sid 1
end

fn l1_load_sortu sid ulong div100 bool to ulong
  n = ulong 0
  blk = get g_l1_hd sid
  while gt blk 0
    bl = get g_l1_bln blk
    bo = mul blk R15_L1_BSZ
    for i ulong bl
      if lt n R15_SORT_CAP
        v = get g_l1_val add bo i
        if div100
          v = div v 100
        end
        put g_sort_u n v
        n = add n 1
      end
    end
    blk = get g_l1_bnx blk
  end
  ret n
end

fn l1_pct_run div100 bool to void
  idx = l1_find
  if lt idx 0
    pct_of_sortu 0
    ret
  end
  n = l1_load_sortu ulong idx div100
  pct_of_sortu n
end

fn l1_pct_key m view uchar * f view uchar * param ulong ci ulong to void
  sb_reset
  io_puts 2 m
  io_putc 2 uchar 124
  io_puts 2 f
  io_putc 2 uchar 124
  io_put_u64 2 param
  io_putc 2 uchar 124
  if eq ci 0
    io_puts 2 t_cfg0
  else
    if eq ci 1
      io_puts 2 t_cfg1
    else
      if eq ci 2
        io_puts 2 t_cfg2
      else
        io_puts 2 t_cfg3
      end
    end
  end
  l1_pct_run false
end

fn l1_pct_key_d100 m view uchar * f view uchar * param ulong ci ulong to void
  sb_reset
  io_puts 2 m
  io_putc 2 uchar 124
  io_puts 2 f
  io_putc 2 uchar 124
  io_put_u64 2 param
  io_putc 2 uchar 124
  if eq ci 0
    io_puts 2 t_cfg0
  else
    if eq ci 1
      io_puts 2 t_cfg1
    else
      if eq ci 2
        io_puts 2 t_cfg2
      else
        io_puts 2 t_cfg3
      end
    end
  end
  l1_pct_run true
end

note ---- Barriers ----
fn add_barrier cfg_tbl ulong cfg_off ulong en ulong be ulong fl ulong re ulong to void
  nb = get g_nbar 0
  if ge nb R15_MAXBAR
    ret
  end
  bo = mul nb 24
  for i ulong 24
    put g_bar_cfg add bo i tb_get cfg_tbl add cfg_off i
  end
  uo = mul nb 5
  put g_bar_u uo en
  put g_bar_u add uo 1 be
  put g_bar_u add uo 2 fl
  put g_bar_u add uo 3 re
  put g_bar_u add uo 4 0
  put g_bar_rc nb 0
  put g_bar_tr nb 0
  put g_nbar 0 add nb 1
end

fn finish_barrier commits ulong rc long tr ulong to void
  nb = get g_nbar 0
  if eq nb 0
    ret
  end
  idx = sub nb 1
  put g_bar_u add mul idx 5 4 commits
  put g_bar_rc idx rc
  put g_bar_tr idx tr
end

note ---- Energy & JSON Record Extractors ----
fn energy_ok e long to bool
  if lt e 0
    ret false
  end
  d = jd e t_k_spbm_ok
  if eq long d 0
    ret false
  end
  ov = jget e t_k_overflow
  if ge ov 0
    ovi = ulong ov
    if eq get g_jn_t ovi JT_ARR
      cur = get g_jn_fc ovi
      while gt cur 0
        if ne get g_jn_u cur 0
          ret false
        end
        cur = get g_jn_nx cur
      end
    end
  end
  ret true
end

fn calc_win_pkg_uj w long to f64
  if lt w 0
    ret r15_nan
  end
  e0 = jget w t_k_e0
  e1 = jget w t_k_e1
  if not energy_ok e0
    ret r15_nan
  end
  if not energy_ok e1
    ret r15_nan
  end
  a = jau jget e0 t_k_energy_uj 0
  b = jau jget e1 t_k_energy_uj 0
  if ge b a
    ret f64 sub b a
  end
  ret r15_nan
end

fn calc_win_nvml_mj w long to f64
  if lt w 0
    ret r15_nan
  end
  e0 = jget w t_k_e0
  e1 = jget w t_k_e1
  if eq long jd e0 t_k_nvml_ok 0
    ret r15_nan
  end
  if eq long jd e1 t_k_nvml_ok 0
    ret r15_nan
  end
  ret sub jd e1 t_k_nvml_mj jd e0 t_k_nvml_mj
end

fn init_trial ti ulong to void
  put g_t_sil ti 0
  put g_t_exit ti -1
  put g_t_comp ti 0
  put g_t_has_ep ti 0
  put g_t_ep_cv ti 0
  put g_t_toff ti get g_tel_n 0
  put g_t_tcnt ti 0
  put g_t_hboff ti 0
  put g_t_hbcnt ti 0
  for i ulong 11
    put g_t_ep_u add mul ti 11 i 0
  end
  for i ulong 4
    put g_t_ep_inf add mul ti 4 i 0
  end
  for i ulong 3
    put g_t_ad_u add mul ti 3 i 0
  end
  nan = r15_nan
  for i ulong 8
    put g_t_ad_d add mul ti 8 i nan
  end
  put g_res_has ti 0
  put g_res_hdg ti 0
  put g_res_d mul ti 2 nan
  put g_res_d add mul ti 2 1 nan
  for w ulong W_N
    ws = add mul ti W_N w
    put g_w_has ws 0
    put g_w_pmu mul ws 2 0
    put g_w_pmu add mul ws 2 1 0
    for k ulong 29
      put g_w_d add mul ws 29 k nan
    end
  end
  for cw ulong C_N
    cs = add mul ti C_N cw
    put g_cw_has cs 0
    put g_cw_hk cs 0
    for k ulong 14
      put g_cw_d add mul cs 14 k nan
    end
  end
end

fn init_l2 li ulong to void
  put g_l2_exit li -1
  put g_l2_sil li 0
  nan = r15_nan
  for k ulong 4
    put g_l2_wd add mul li 4 k nan
  end
  for p ulong 5
    put g_l2_off add mul li 5 p get g_l2_tot p
    put g_l2_cnt add mul li 5 p 0
  end
  rs = add 512 li
  put g_res_has rs 0
  put g_res_hdg rs 0
  put g_res_d mul rs 2 nan
  put g_res_d add mul rs 2 1 nan
end

fn extract_episode ti ulong r long to void
  put g_t_has_ep ti 1
  bo = mul ti 11
  put g_t_ep_u bo ju r t_k_wrong
  put g_t_ep_u add bo 1 ju r t_k_illegal
  put g_t_ep_u add bo 2 ju r t_k_covf
  put g_t_ep_u add bo 3 ju r t_k_gstat
  put g_t_ep_u add bo 4 ju r t_k_gbefore
  put g_t_ep_u add bo 5 ju r t_k_gafter
  put g_t_ep_u add bo 6 ju r t_k_unprom
  put g_t_ep_u add bo 7 ju r t_k_aegisw
  put g_t_ep_u add bo 8 ju r t_k_rootw
  put g_t_ep_u add bo 9 ju r t_k_losttr
  put g_t_ep_cv ti long jd r t_k_cver
  inf = jget r t_k_inforce
  put g_t_ep_u add bo 10 0
  if ge inf 0
    ii = ulong inf
    if eq get g_jn_t ii JT_ARR
      if eq get g_jn_cnt ii 4
        put g_t_ep_u add bo 10 1
        io = mul ti 4
        for k ulong 4
          put g_t_ep_inf add io k jau inf k
        end
      end
    end
  end
end

fn extract_adapt ti ulong r long to void
  uo = mul ti 3
  put g_t_ad_u uo ju r t_k_goal_t
  put g_t_ad_u add uo 1 ju r t_k_met_t
  put g_t_ad_u add uo 2 ju r t_k_plan_t
  do = mul ti 8
  put g_t_ad_d do jd r t_k_select_t
  put g_t_ad_d add do 1 jd r t_k_plan_t
  put g_t_ad_d add do 2 jd r t_k_evid_t
  put g_t_ad_d add do 3 jd r t_k_claim_t
  put g_t_ad_d add do 4 jd r t_k_inforce_t
  put g_t_ad_d add do 5 jd r t_k_cand_t
  put g_t_ad_d add do 6 jd r t_k_ref_ps
  put g_t_ad_d add do 7 jd r t_k_sel_ps
  be = ju r t_k_b_enter
  if ne be 0
    add_barrier 1 mul ti 24 be ju r t_k_b_begin ju r t_k_b_flip ju r t_k_b_receipt
    finish_barrier ju r t_k_b_commits long jd r t_k_b_res 1
  end
end

fn extract_residency slot ulong r long to void
  tot = jget r t_k_total
  if lt tot 0
    put g_res_has slot 0
    ret
  end
  put g_res_has slot 1
  put g_res_d mul slot 2 jd tot t_k_intervals
  put g_res_d add mul slot 2 1 jd tot t_k_seat_live
  uo = mul slot 12
  put g_res_u uo ju tot t_k_intervals
  put g_res_u add uo 1 ju tot t_k_seat_live
  d = jget tot t_k_diag
  if lt d 0
    put g_res_hdg slot 0
    ret
  end
  put g_res_hdg slot 1
  put g_res_u add uo 2 ju d t_k_dead_runs
  put g_res_u add uo 3 ju d t_k_dead_long
  put g_res_u add uo 4 ju d t_k_dead_end
  put g_res_u add uo 5 ju d t_k_late_2ms
  put g_res_u add uo 6 ju d t_k_late_10ms
  put g_res_u add uo 7 ju d t_k_max_gap
  put g_res_u add uo 8 ju d t_k_stale_max
  put g_res_u add uo 9 ju d t_k_fdead_t
  put g_res_u add uo 10 ju d t_k_t_first
end

fn extract_win_stats bo ulong st long to void
  put g_w_d add bo 7 jd st t_st_0
  put g_w_d add bo 8 jd st t_st_1
  put g_w_d add bo 9 jd st t_st_2
  put g_w_d add bo 10 jd st t_st_3
  put g_w_d add bo 11 jd st t_st_4
  put g_w_d add bo 12 jd st t_st_5
  put g_w_d add bo 13 jd st t_st_6
  put g_w_d add bo 14 jd st t_st_7
  put g_w_d add bo 15 jd st t_st_8
  put g_w_d add bo 16 jd st t_st_9
  put g_w_d add bo 17 jd st t_st_seqp
  put g_w_d add bo 18 jd st t_st_wakes
end

fn extract_win_pmu ws ulong bo ulong r long to void
  pm = jget r t_k_pmu
  pok = ulong 0
  pmx = ulong 0
  if ge pm 0
    if ne long jd pm t_k_ok 0
      pok = 1
    end
    if ne long jd pm t_k_mux 0
      pmx = 1
    end
  end
  put g_w_pmu mul ws 2 pok
  put g_w_pmu add mul ws 2 1 pmx
  sm = jget pm t_k_sum
  put g_w_d add bo 19 jd sm t_pm_0
  put g_w_d add bo 20 jd sm t_pm_1
  put g_w_d add bo 21 jd sm t_pm_2
  put g_w_d add bo 22 jd sm t_pm_3
  put g_w_d add bo 23 jd sm t_pm_4
  put g_w_d add bo 24 jd sm t_pm_5
  sp = jget r t_k_sampler
  put g_w_d add bo 25 jd sp t_k_intervals
  put g_w_d add bo 26 jd sp t_k_slot_sum
  put g_w_d add bo 27 jd sp t_k_slot_max
  put g_w_d add bo 28 jd sp t_k_claims_max
end

fn extract_win ti ulong w ulong r long to void
  ws = add mul ti W_N w
  put g_w_has ws 1
  bo = mul ws 29
  put g_w_d bo jd r t_k_ops
  put g_w_d add bo 1 jd r t_k_wall_ns
  put g_w_d add bo 2 jd r t_k_gsb
  put g_w_d add bo 3 jd r t_k_cuser
  put g_w_d add bo 4 jd r t_k_csys
  put g_w_d add bo 5 calc_win_pkg_uj r
  put g_w_d add bo 6 calc_win_nvml_mj r
  extract_win_stats bo jget r t_k_stats
  extract_win_pmu ws bo r
end

fn extract_cwin_hist ti ulong r long to void
  lat = jget r t_k_latency
  b = jget lat t_k_b
  off = get g_hb_n 0
  cnt = ulong 0
  if ge b 0
    bi = ulong b
    if eq get g_jn_t bi JT_ARR
      cur = get g_jn_fc bi
      while gt cur 0
        if lt add off cnt R15_MAXHB
          put g_hb_lo add off cnt jau long cur 0
          put g_hb_cnt add off cnt jau long cur 1
          cnt = add cnt 1
        end
        cur = get g_jn_nx cur
      end
    end
  end
  put g_t_hboff ti off
  put g_t_hbcnt ti cnt
  put g_hb_n 0 add off cnt
end

fn extract_cwin ti ulong cw ulong r long to void
  cs = add mul ti C_N cw
  put g_cw_has cs 1
  bo = mul cs 14
  put g_cw_d bo jd r t_k_t0
  put g_cw_d add bo 1 jd r t_k_t1
  put g_cw_d add bo 2 jd r t_k_scomm
  put g_cw_d add bo 3 jd r t_k_acost
  put g_cw_d add bo 4 jd r t_k_conseq
  put g_cw_d add bo 5 jd r t_k_replays
  put g_cw_d add bo 6 jd r t_k_acts
  k = jget r t_k_kinds
  if ge k 0
    put g_cw_hk cs 1
    put g_cw_d add bo 7 jd k t_k_inval
    put g_cw_d add bo 8 jd k t_k_blkauth
    put g_cw_d add bo 9 jd k t_k_rej
    put g_cw_d add bo 10 jd k t_k_failed
    put g_cw_d add bo 11 jd k t_k_noop
    put g_cw_d add bo 12 jd k t_k_quar
    put g_cw_d add bo 13 jd k t_k_commit
  else
    put g_cw_hk cs 0
  end
  if eq cw C_SPAN
    extract_cwin_hist ti r
  end
end

fn handle_trial_line ti ulong r long sil ulong to void
  put g_t_sil ti sil
  if jstr_eq r t_k_kind t_k_episode
    extract_episode ti r
    ret
  end
  if jstr_eq r t_k_kind t_k_adapt
    extract_adapt ti r
    ret
  end
  if jstr_eq r t_k_kind t_k_residency
    extract_residency ti r
    ret
  end
  if jstr_eq r t_k_kind t_k_result
    put g_t_comp ti b2u ne long jd r t_k_complete 0
    ret
  end
  if jstr_eq r t_k_kind t_k_window
    if jstr_eq r t_k_window t_w_idle
      extract_win ti W_IDLE r
    end
    if jstr_eq r t_k_window t_w_before
      extract_win ti W_BEFORE r
    end
    if jstr_eq r t_k_window t_w_after
      extract_win ti W_AFTER r
    end
    if jstr_eq r t_k_window t_w_span
      extract_win ti W_SPAN r
    end
    ret
  end
  if jstr_eq r t_k_kind t_k_cwindow
    if jstr_eq r t_k_window t_cw_adapt
      extract_cwin ti C_ADAPT r
    end
    if jstr_eq r t_k_window t_cw_cost
      extract_cwin ti C_COST r
    end
    if jstr_eq r t_k_window t_w_before
      extract_cwin ti C_BEFORE r
    end
    if jstr_eq r t_k_window t_w_after
      extract_cwin ti C_AFTER r
    end
    if jstr_eq r t_k_window t_w_span
      extract_cwin ti C_SPAN r
    end
    ret
  end
  if jstr_eq r t_k_kind t_k_telemetry
    e = jget r t_k_e
    tn = get g_tel_n 0
    if lt tn R15_MAXTEL
      put g_tel_t tn ju e t_k_t_ns
      put g_tel_pkg tn jau jget e t_k_energy_uj 0
      put g_tel_ok tn b2u ne long jd e t_k_spbm_ok 0
      put g_tel_n 0 add tn 1
      put g_t_tcnt ti add get g_t_tcnt ti 1
    end
  end
end

fn l2_push_pool li ulong p ulong v ulong to void
  tot = get g_l2_tot p
  if ge tot R15_L2_CAP
    ret
  end
  if eq p 0
    put g_l2_e2e tot v
  else
    if eq p 1
      put g_l2_gpu tot v
    else
      if eq p 2
        put g_l2_enq tot v
      else
        if eq p 3
          put g_l2_pub tot v
        else
          put g_l2_dep tot v
        end
      end
    end
  end
  put g_l2_tot p add tot 1
  idx = add mul li 5 p
  put g_l2_cnt idx add get g_l2_cnt idx 1
end

fn handle_l2_claim li ulong r long sil ulong to void
  inp = ju r t_k_in_t
  ss = ju r t_k_ss_t
  sc = ju r t_k_sc_t
  ds = ju r t_k_ds_t
  g = ulong 0
  if ne sil 0
    pk = uint and ju r t_k_cpick 4294967295
    dn = uint and ju r t_k_cdone 4294967295
    g = ulong sub dn pk
  end
  if ne inp 0
    if ge ss inp
      l2_push_pool li 2 sub ss inp
    end
  end
  if ne sil 0
    l2_push_pool li 1 g
  end
  if ne ss 0
    if ge sc ss
      dt = sub sc ss
      if gt dt g
        l2_push_pool li 3 sub dt g
      else
        l2_push_pool li 3 0
      end
    end
  end
  if ne sc 0
    if ge ds sc
      l2_push_pool li 4 sub ds sc
    end
  end
  if and ne inp 0 ne ds 0
    if ge ds inp
      l2_push_pool li 0 sub ds inp
    end
  end
end

fn handle_l2_line li ulong r long sil ulong to void
  put g_l2_sil li sil
  if jstr_eq r t_k_kind t_k_window
    st = jget r t_k_stats
    bo = mul li 4
    put g_l2_wd bo jd st t_st_grt
    put g_l2_wd add bo 1 jd st t_st_rc
    put g_l2_wd add bo 2 jd st t_st_ghw
    put g_l2_wd add bo 3 jd st t_st_gpe
    ret
  end
  if jstr_eq r t_k_kind t_k_residency
    extract_residency add 512 li r
    ret
  end
  if jstr_eq r t_k_kind t_k_l2_claim
    handle_l2_claim li r sil
  end
end

fn handle_l1_line r long to void
  if jstr_eq r t_k_kind t_k_l1
    sb_reset
    sb_put_jstr r t_k_measure
    io_putc 2 uchar 124
    sb_put_jstr r t_k_field
    io_putc 2 uchar 124
    io_put_u64 2 ju r t_k_param
    io_putc 2 uchar 124
    io_put_mem 2 12 0 get g_klen 0
    sid = l1_find_or_add
    v = jget r t_k_v
    if ge v 0
      vi = ulong v
      if eq get g_jn_t vi JT_ARR
        cur = get g_jn_fc vi
        while gt cur 0
          l1_push sid get g_jn_u cur
          cur = get g_jn_nx cur
        end
      end
    end
    ret
  end
  if jstr_eq r t_k_kind t_k_tstat
    if eq long jd r t_k_ok 0
      put g_l1_st 2 add get g_l1_st 2 1
    end
    ret
  end
  if jstr_eq r t_k_kind t_k_l1_bf
    if ne ju r t_k_fsamp 0
      put g_l1_st 3 add get g_l1_st 3 1
    end
    ret
  end
  if jstr_eq r t_k_kind t_k_l1_g
    add_barrier 12 0 ju r t_k_enter ju r t_k_begin ju r t_k_flip ju r t_k_receipt
    finish_barrier ju r t_k_pcb long jd r t_k_prc 0
    ret
  end
  if jstr_eq r t_k_kind t_k_window
    if jstr_starts r t_k_window t_w_timing
      nw = get g_nw 0
      if lt nw R15_MAXW
        bo = mul nw 24
        kl = get g_klen 0
        for i ulong 24
          c = uchar 0
          if lt i kl
            c = get g_kbuf i
          end
          put g_wr_cfg add bo i c
        end
        put g_wr_tim nw b2u jstr_eq r t_k_window t_w_timing_on
        put g_wr_thr nw div jd r t_k_ops div jd r t_k_wall_ns f64 1000000000.0
        put g_nw 0 add nw 1
      end
    end
  end
end

fn build_dir_path tbl ulong off ulong flen ulong to ulong
  dl = get g_dirlen 0
  for i ulong dl
    put g_path i get g_dir i
  end
  put g_path dl uchar 47
  for i ulong flen
    put g_path add add dl 1 i tb_get tbl add off i
  end
  tot = add add dl 1 flen
  put g_path tot uchar 0
  ret tot
end

fn copy_cfg_to_kbuf r long to void
  v = jget r t_k_config
  so = ulong 0
  sl = ulong 0
  if ge v 0
    vi = ulong v
    if eq get g_jn_t vi JT_STR
      so = get g_jn_so vi
      sl = get g_jn_sl vi
    end
  end
  if gt sl 23
    sl = 23
  end
  for i ulong 24
    c = uchar 0
    if lt i sl
      c = get g_jstr add so i
    end
    put g_kbuf i c
  end
  put g_klen 0 sl
end

fn init_file_mode r long oi ulong to ulong
  copy_cfg_to_kbuf r
  if jstr_eq r t_k_level t_k_trial
    nt = get g_nt 0
    if ge nt R15_MAXT
      io_puts 1 t_toomany_t
      io_flush 1
      exit 3
    end
    put g_nt 0 add nt 1
    init_trial nt
    fl = get g_flen oi
    fo = mul oi 256
    to_f = mul nt 256
    for k ulong 256
      c = uchar 0
      if lt k fl
        c = get g_fname add fo k
      end
      put g_t_file add to_f k c
    end
    jcopy_cfg r t_k_config 0 mul nt 24
    put g_t_rnd nt long jd r t_k_round
    put g_tmpu 0 nt
    ret 1
  end
  if jstr_eq r t_k_level t_k_l2
    nl2 = get g_nl2 0
    if ge nl2 R15_MAXL2
      io_puts 1 t_toomany_l2
      io_flush 1
      exit 3
    end
    put g_nl2 0 add nl2 1
    init_l2 nl2
    jcopy_cfg r t_k_config 1 mul nl2 24
    put g_tmpu 0 nl2
    ret 2
  end
  put g_l1_st 0 add get g_l1_st 0 1
  put g_tmpu 0 0
  ret 3
end

fn read_jsonl_file oi ulong to long
  plen = build_dir_path 2 mul oi 256 get g_flen oi
  fd = fopen g_path 0 plen 0 0
  if lt fd 0
    ret -1
  end
  rl_init
  mode = ulong 0
  idx = ulong 0
  sil = ulong 0
  lineno = ulong 0
  bad = false
  while eq rl_next int fd 1
    lineno = add lineno 1
    put g_jpos 0 0
    put g_jn_n 0 1
    put g_jslen 0 0
    r = jp_parse
    if lt r 0
      io_put_mem 1 2 mul oi 256 get g_flen oi
      io_putc 1 uchar 58
      io_put_u64 1 lineno
      io_puts 1 t_notjson
      io_flush 1
      bad = true
      break
    end
    if eq mode 0
      mode = init_file_mode r oi
      idx = get g_tmpu 0
    end
    if jstr_eq r t_k_kind t_k_start
      sil = b2u ne long jd r t_k_silicon 0
    end
    if jstr_eq r t_k_kind t_k_end
      ex = long jd r t_k_exit
      if eq mode 1
        put g_t_exit idx ex
      else
        if eq mode 2
          put g_l2_exit idx ex
        else
          if ne ex 0
            put g_l1_st 1 add get g_l1_st 1 1
          end
        end
      end
    end
    if eq mode 1
      handle_trial_line idx r sil
    else
      if eq mode 2
        handle_l2_line idx r sil
      else
        handle_l1_line r
      end
    end
  end
  _fc = fclose int fd
  if bad
    ret -1
  end
  ret 0
end

note ---- SHA256SUMS + Directory Scan ----
fn ends_jsonl tbl ulong off ulong n ulong to bool
  if lt n 6
    ret false
  end
  st = add off sub n 6
  for i ulong 6
    if ne tb_get tbl add st i get t_jsonl i
      ret false
    end
  end
  ret true
end

fn is_ws b uchar to bool
  ret or eq b 32 or eq b 9 or eq b 10 eq b 13
end

fn sums_add_file nl ulong to void
  nf = get g_nfiles 0
  if ge nf R15_MAXF
    ret
  end
  fo = mul nf 256
  for i ulong nl
    put g_fname add fo i get g_sbuf i
  end
  put g_fname add fo nl uchar 0
  put g_flen nf nl
  ho = mul nf 64
  for i ulong 64
    put g_fhash add ho i get g_hextmp i
  end
  put g_ford nf nf
  put g_nfiles 0 add nf 1
end

fn sums_check_hash h0 ulong hl ulong nl ulong to ulong
  plen = build_dir_path 4 0 nl
  err = ulong 0
  if lt hash_path plen 0
    err = 1
  else
    if ne hl 64
      err = 1
    else
      for i ulong 64
        if ne get g_hextmp i get g_jbuf add h0 i
          err = 1
        end
      end
    end
  end
  if ne err 0
    io_puts 1 t_hbad
    io_put_mem 1 4 0 nl
    io_puts 1 t_nl
    io_flush 1
  end
  ret err
end

fn parse_sums_line to long
  n = get g_jlen 0
  p = ulong 0
  while lt p n
    if not is_ws get g_jbuf p
      break
    end
    p = add p 1
  end
  h0 = p
  while lt p n
    if is_ws get g_jbuf p
      break
    end
    p = add p 1
  end
  hl = sub p h0
  if eq hl 0
    ret 0
  end
  while lt p n
    if not is_ws get g_jbuf p
      break
    end
    p = add p 1
  end
  n0 = p
  while lt p n
    if is_ws get g_jbuf p
      break
    end
    p = add p 1
  end
  nl = sub p n0
  if eq nl 0
    ret 0
  end
  if eq get g_jbuf n0 uchar 42
    n0 = add n0 1
    nl = sub nl 1
  end
  if lt nl 6
    ret 0
  end
  for i ulong 6
    if ne get g_jbuf add add n0 sub nl 6 i get t_jsonl i
      ret 0
    end
  end
  if gt nl 255
    nl = 255
  end
  sb_reset
  for i ulong nl
    io_putc 2 get g_jbuf add n0 i
  end
  err = sums_check_hash h0 hl nl
  sums_add_file nl
  if ne err 0
    ret -1
  end
  ret 1
end

fn fn_listed off ulong nl ulong to bool
  nf = get g_nfiles 0
  for i ulong nf
    if eq get g_flen i nl
      fo = mul i 256
      ok = true
      for k ulong nl
        if ne get g_fname add fo k get g_dent add off k
          ok = false
        end
      end
      if ok
        ret true
      end
    end
  end
  ret false
end

fn check_dent_entry pos ulong rl ulong to ulong
  ns = add pos 19
  nl = ulong 0
  lim = sub rl 19
  while lt nl lim
    if eq get g_dent add ns nl 0
      break
    end
    nl = add nl 1
  end
  if lt nl 6
    ret 0
  end
  for i ulong 6
    if ne get g_dent add add ns sub nl 6 i get t_jsonl i
      ret 0
    end
  end
  if fn_listed ns nl
    ret 0
  end
  io_puts 1 t_unlisted
  for i ulong nl
    io_putc 1 get g_dent add ns i
  end
  io_puts 1 t_nl
  io_flush 1
  ret 1
end

fn fn_lt a ulong b ulong to bool
  oa = mul a 256
  ob = mul b 256
  for i ulong 256
    ca = get g_fname add oa i
    cb = get g_fname add ob i
    if ne ca cb
      ret lt ca cb
    end
    if eq ca 0
      ret false
    end
  end
  ret false
end

fn sort_files to void
  nf = get g_nfiles 0
  i = ulong 1
  while lt i nf
    k = get g_ford i
    j = i
    while gt j 0
      pv = get g_ford sub j 1
      if not fn_lt k pv
        break
      end
      put g_ford j pv
      j = sub j 1
    end
    put g_ford j k
    i = add i 1
  end
end

fn load_sums_and_dir to long
  dl = get g_dirlen 0
  for i ulong dl
    put g_path i get g_dir i
  end
  put g_path dl uchar 47
  sn = len t_sums_name
  for i ulong sn
    put g_path add add dl 1 i get t_sums_name i
  end
  plen = add add dl 1 sn
  put g_path plen uchar 0
  if lt hash_path plen 0
    io_puts 1 t_nosums
    for i ulong dl
      io_putc 1 get g_dir i
    end
    io_puts 1 t_nl
    io_flush 1
    ret -1
  end
  for i ulong 64
    put g_sums_hex i get g_hextmp i
  end
  sfd = fopen g_path 0 plen 0 0
  errs = ulong 0
  if ge sfd 0
    rl_init
    while eq rl_next int sfd 1
      if lt parse_sums_line 0
        errs = add errs 1
      end
    end
    _fc = fclose int sfd
  end
  dfd = fopen g_dir 0 dl 0 0
  if ge dfd 0
    while true
      n = getdnts int dfd g_dent 0 16384
      if le n 0
        break
      end
      pos = ulong 0
      un = ulong n
      while lt pos un
        b0 = ulong get g_dent add pos 16
        b1 = ulong get g_dent add pos 17
        rl = or b0 shl b1 8
        if eq rl 0
          break
        end
        errs = add errs check_dent_entry pos rl
        pos = add pos rl
      end
    end
    _fc2 = fclose int dfd
  end
  if gt errs 0
    ret -1
  end
  sort_files
  ret 0
end

note ---- Config name helper ----
fn cfg_eq_idx tbl ulong off ulong ci ulong to bool
  if eq ci 0
    ret cs_eq_t tbl off 24 t_cfg0
  end
  if eq ci 1
    ret cs_eq_t tbl off 24 t_cfg1
  end
  if eq ci 2
    ret cs_eq_t tbl off 24 t_cfg2
  end
  ret cs_eq_t tbl off 24 t_cfg3
end

fn o_open_cfg ci ulong c uchar to void
  if eq ci 0
    o_open t_cfg0 c
  else
    if eq ci 1
      o_open t_cfg1 c
    else
      if eq ci 2
        o_open t_cfg2 c
      else
        o_open t_cfg3 c
      end
    end
  end
end

fn o_num_cfg ci ulong x f64 to void
  if eq ci 0
    o_num t_cfg0 x
  else
    if eq ci 1
      o_num t_cfg1 x
    else
      if eq ci 2
        o_num t_cfg2 x
      else
        o_num t_cfg3 x
      end
    end
  end
end

note ---- Derived per-trial metrics ----
fn win_d ti ulong w ulong f ulong to f64
  ws = add mul ti W_N w
  if eq get g_w_has ws 0
    ret r15_nan
  end
  ret get g_w_d add mul ws 29 f
end

fn cwin_d ti ulong cw ulong f ulong to f64
  cs = add mul ti C_N cw
  if eq get g_cw_has cs 0
    ret r15_nan
  end
  ret get g_cw_d add mul cs 14 f
end

fn win_thr ti ulong w ulong to f64
  ws = add mul ti W_N w
  if eq get g_w_has ws 0
    ret r15_nan
  end
  bo = mul ws 29
  ret div get g_w_d bo div get g_w_d add bo 1 f64 1000000000.0
end

fn idle_w ti ulong to f64
  uj = win_d ti W_IDLE 5
  wn = win_d ti W_IDLE 1
  ret mul div uj wn f64 1000.0
end

fn energy_per_op ti ulong w ulong to f64
  uj = win_d ti w 5
  p = idle_w ti
  wops = win_d ti w 0
  if or is_nan uj or is_nan p not gt wops f64 0.0
    ret r15_nan
  end
  wn = win_d ti w 1
  base = mul div mul p wn f64 1000000000.0 f64 1000000.0
  ret div sub uj base wops
end

fn gross_energy_per_op ti ulong w ulong to f64
  uj = win_d ti w 5
  wops = win_d ti w 0
  if gt wops f64 0.0
    ret div uj wops
  end
  ret r15_nan
end

fn tel_energy ti ulong a ulong b ulong to f64
  off = get g_t_toff ti
  cnt = get g_t_tcnt ti
  has_lo = false
  lo_pkg = ulong 0
  has_hi = false
  hi_pkg = ulong 0
  for i ulong cnt
    idx = add off i
    if ne get g_tel_ok idx 0
      tt = get g_tel_t idx
      if le tt a
        has_lo = true
        lo_pkg = get g_tel_pkg idx
      end
      if not has_hi
        if ge tt b
          has_hi = true
          hi_pkg = get g_tel_pkg idx
        end
      end
    end
  end
  if and has_lo has_hi
    if ge hi_pkg lo_pkg
      ret f64 sub hi_pkg lo_pkg
    end
  end
  ret r15_nan
end

fn trial_correct ti ulong to bool
  sb_reset
  ex = get g_t_exit ti
  if or ne ex 0 eq get g_t_comp ti 0
    io_puts 2 t_w_nocomp
    io_put_i64 2 ex
    io_putc 2 uchar 41
    ret false
  end
  if eq get g_t_has_ep ti 0
    io_puts 2 t_w_noep
    ret false
  end
  bo = mul ti 11
  if ne get g_t_ep_u bo 0
    io_puts 2 t_w_wrong
    io_put_u64 2 get g_t_ep_u bo
    ret false
  end
  if ne get g_t_ep_u add bo 1 0
    io_puts 2 t_w_illeg
    ret false
  end
  if not cs_has_sub 1 mul ti 24 24 t_nodig
    if ne get g_t_ep_cv ti 1
      io_puts 2 t_w_crumbs
      ret false
    end
  end
  if ne get g_t_ep_u add bo 2 0
    io_puts 2 t_w_covf
    ret false
  end
  if ne get g_t_ep_u add bo 3 2
    io_puts 2 t_w_goal
    io_put_u64 2 get g_t_ep_u add bo 3
    io_putc 2 uchar 41
    ret false
  end
  if ne get g_t_ep_u add bo 5 add get g_t_ep_u add bo 4 1
    io_puts 2 t_w_gen
    ret false
  end
  if ne get g_t_ep_u add bo 6 0
    io_puts 2 t_w_unp
    ret false
  end
  if or ne get g_t_ep_u add bo 7 0 ne get g_t_ep_u add bo 8 0
    io_puts 2 t_w_woken
    ret false
  end
  if ne get g_t_ep_u add bo 9 0
    io_puts 2 t_w_lost
    ret false
  end
  ret true
end

fn same_realization a ulong b ulong to bool
  if eq get g_t_ep_u add mul a 11 10 0
    ret false
  end
  if eq get g_t_ep_u add mul b 11 10 0
    ret false
  end
  oa = mul a 4
  ob = mul b 4
  for i ulong 4
    if ne get g_t_ep_inf add oa i get g_t_ep_inf add ob i
      ret false
    end
  end
  ret true
end

fn find_trial ci ulong rnd long to long
  nt = get g_nt 0
  for i ulong nt
    if eq get g_t_rnd i rnd
      if cfg_eq_idx 1 mul i 24 ci
        ret long i
      end
    end
  end
  ret -1
end

fn adapt_rate ti ulong to f64
  cs = add mul ti C_N C_ADAPT
  if eq get g_cw_has cs 0
    ret r15_nan
  end
  bo = mul cs 14
  dt = div sub get g_cw_d add bo 1 get g_cw_d bo f64 1000000000.0
  if gt dt f64 0.0
    ret div get g_cw_d add bo 2 dt
  end
  ret r15_nan
end

fn cwin_wasted ti ulong cw ulong to f64
  cs = add mul ti C_N cw
  if eq get g_cw_has cs 0
    ret r15_nan
  end
  if eq get g_cw_hk cs 0
    ret r15_nan
  end
  bo = mul cs 14
  s = add get g_cw_d add bo 7 get g_cw_d add bo 8
  s = add s get g_cw_d add bo 9
  s = add s get g_cw_d add bo 10
  s = add s get g_cw_d add bo 11
  s = add s get g_cw_d add bo 12
  ret s
end

fn per_cons ti ulong x f64 to f64
  c = cwin_d ti C_SPAN 4
  if gt c f64 0.0
    ret div x c
  end
  ret r15_nan
end

fn wake_amp ti ulong to f64
  ws = add mul ti W_N W_SPAN
  if eq get g_w_has ws 0
    ret r15_nan
  end
  if cs_starts 1 mul ti 24 24 t_cfg2
    ret per_cons ti win_d ti W_SPAN 17
  end
  ret per_cons ti win_d ti W_SPAN 18
end

fn crossover_ops ti ulong to f64
  cost = cwin_d ti C_COST 3
  do = mul ti 8
  gain = div sub get g_t_ad_d add do 6 get g_t_ad_d add do 7 f64 1000.0
  if gt gain f64 0.0
    ret div cost gain
  end
  ret r15_nan
end

note ---- TrialVal selector (0=after_thr, 1=before_thr, 2=adapt_rate, 3=energy_after, 4=wasted, 5=crossover_ops, 6=wake_amp) ----
fn trial_val ti ulong fnid ulong to f64
  if eq fnid 0
    ret win_thr ti W_AFTER
  end
  if eq fnid 1
    ret win_thr ti W_BEFORE
  end
  if eq fnid 2
    ret adapt_rate ti
  end
  if eq fnid 3
    ret energy_per_op ti W_AFTER
  end
  if eq fnid 4
    ret per_cons ti cwin_wasted ti C_SPAN
  end
  if eq fnid 5
    ret crossover_ops ti
  end
  ret wake_amp ti
end

fn paired_one i ulong den_ci ulong fnid ulong need_same bool to void
  b = find_trial den_ci get g_t_rnd i
  if lt b 0
    ret
  end
  bi = ulong b
  if need_same
    if not same_realization i bi
      put g_tmpu 1 add get g_tmpu 1 1
      ret
    end
  end
  x = trial_val i fnid
  y = trial_val bi fnid
  if and not is_nan x and not is_nan y gt y f64 0.0
    n = get g_tmpu 0
    if lt n 512
      put g_vd n div x y
      put g_tmpu 0 add n 1
    end
  else
    put g_tmpu 1 add get g_tmpu 1 1
  end
end

fn paired slot ulong num_ci ulong den_ci ulong fnid ulong need_same bool to void
  nt = get g_nt 0
  put g_tmpu 0 0
  put g_tmpu 1 0
  for i ulong nt
    if cfg_eq_idx 1 mul i 24 num_ci
      paired_one i den_ci fnid need_same
    end
  end
  n = get g_tmpu 0
  excl = get g_tmpu 1
  bo = mul slot 3
  put g_cmp_d bo median_vd n 0
  boot_ci_vd n slot
  put g_cmp_u mul slot 2 n
  put g_cmp_u add mul slot 2 1 excl
end

fn o_cmp k view uchar * slot ulong to void
  bo = mul slot 3
  uo = mul slot 2
  o_open k uchar 123
  o_num t_o_mrat get g_cmp_d bo
  o_num t_o_cilo get g_cmp_d add bo 1
  o_num t_o_cihi get g_cmp_d add bo 2
  o_u t_o_pairs get g_cmp_u uo
  o_u t_o_pexcl get g_cmp_u add uo 1
  o_close uchar 125
end

fn med_of ci ulong fnid ulong to f64
  nt = get g_nt 0
  n = ulong 0
  for i ulong nt
    if cfg_eq_idx 1 mul i 24 ci
      x = trial_val i fnid
      if not is_nan x
        if lt n 512
          put g_vd n x
          n = add n 1
        end
      end
    end
  end
  put g_tmpu 0 n
  ret median_vd n 0
end

fn hist_pct ci ulong to void
  nt = get g_nt 0
  n = ulong 0
  total = ulong 0
  for i ulong nt
    if cfg_eq_idx 1 mul i 24 ci
      off = get g_t_hboff i
      cnt = get g_t_hbcnt i
      for j ulong cnt
        if lt n R15_MAXHB
          lo = get g_hb_lo add off j
          ct = get g_hb_cnt add off j
          put g_hs_lo n lo
          put g_hs_cnt n ct
          total = add total ct
          n = add n 1
        end
      end
    end
  end
  for k ulong 7
    put g_pct k 0
  end
  if eq total 0
    ret
  end
  sort_hs n
  put g_tmpu 0 ceil_u f64 0.5 total
  put g_tmpu 1 ceil_u f64 0.9 total
  put g_tmpu 2 ceil_u f64 0.95 total
  put g_tmpu 3 ceil_u f64 0.99 total
  put g_tmpu 4 ceil_u f64 0.999 total
  cum = ulong 0
  k = ulong 0
  for i ulong n
    cum = add cum get g_hs_cnt i
    lv = get g_hs_lo i
    while lt k 5
      if lt cum get g_tmpu k
        break
      end
      put g_pct add k 1 lv
      k = add k 1
    end
    put g_pct 6 lv
  end
  put g_pct 0 total
end

note ---- Output: trials array ----
fn emit_trial_after_per_op ti ulong to void
  ws = add mul ti W_N W_AFTER
  wops = win_d ti W_AFTER 0
  o_open t_o_apo uchar 123
  o_num t_st_0 div win_d ti W_AFTER 7 wops
  o_num t_st_1 div win_d ti W_AFTER 8 wops
  o_num t_st_2 div win_d ti W_AFTER 9 wops
  o_num t_st_3 div win_d ti W_AFTER 10 wops
  o_num t_st_4 div win_d ti W_AFTER 11 wops
  o_num t_st_5 div win_d ti W_AFTER 12 wops
  o_num t_st_6 div win_d ti W_AFTER 13 wops
  o_num t_st_7 div win_d ti W_AFTER 14 wops
  o_num t_st_8 div win_d ti W_AFTER 15 wops
  o_num t_st_9 div win_d ti W_AFTER 16 wops
  o_num t_k_gsb div win_d ti W_AFTER 2 wops
  o_num t_o_cpuns div add win_d ti W_AFTER 3 win_d ti W_AFTER 4 wops
  pok = false
  if ne get g_w_has ws 0
    if ne get g_w_pmu mul ws 2 0
      if eq get g_w_pmu add mul ws 2 1 0
        pok = true
      end
    end
  end
  nan = r15_nan
  if pok
    o_num t_pm_0 div win_d ti W_AFTER 19 wops
    o_num t_pm_1 div win_d ti W_AFTER 20 wops
    o_num t_o_dram div mul win_d ti W_AFTER 21 f64 64.0 wops
    o_num t_o_bus div mul win_d ti W_AFTER 22 f64 64.0 wops
    o_num t_pm_4 div win_d ti W_AFTER 23 wops
    o_num t_pm_5 div win_d ti W_AFTER 24 wops
  else
    o_num t_pm_0 nan
    o_num t_pm_1 nan
    o_num t_o_dram nan
    o_num t_o_bus nan
    o_num t_pm_4 nan
    o_num t_pm_5 nan
  end
  si = win_d ti W_AFTER 25
  if gt si f64 0.0
    o_num t_o_r5m div win_d ti W_AFTER 26 si
  else
    o_num t_o_r5m nan
  end
  o_num t_o_r5p win_d ti W_AFTER 27
  o_num t_o_rcp win_d ti W_AFTER 28
  o_close uchar 125
end

fn record_g1_why ti ulong to void
  put g_tr_st 0 0
  wlen = get g_slen 0
  for k ulong wlen
    put g_kbuf k get g_sbuf k
  end
  put g_klen 0 wlen
  sb_reset
  io_put_cs 2 1 mul ti 24 24
  io_puts 2 t_gn_rnd
  io_put_i64 2 get g_t_rnd ti
  io_puts 2 t_col
  io_putc 2 uchar 32
  io_put_mem 2 12 0 wlen
  gl = get g_slen 0
  if gt gl 255
    gl = 255
  end
  for k ulong gl
    put g_g1_why k get g_sbuf k
  end
  put g_g1_why gl uchar 0
  put g_g1_wlen 0 gl
  sb_reset
  io_put_mem 2 12 0 wlen
end

fn emit_trial_adapt ti ulong to void
  uo = mul ti 3
  g = get g_t_ad_u uo
  met = get g_t_ad_u add uo 1
  if and gt met g ne g 0
    o_num t_o_epw f64 sub met g
  else
    o_num t_o_epw r15_nan
  end
  if and ne g 0 ne met 0
    o_num t_o_epe tel_energy ti g met
  else
    o_num t_o_epe r15_nan
  end
  o_num t_o_cog sub f64 get g_t_ad_u add uo 2 f64 g
  do = mul ti 8
  o_num t_o_srch sub get g_t_ad_d do get g_t_ad_d add do 1
  o_num t_o_gexp sub get g_t_ad_d add do 2 get g_t_ad_d add do 3
  o_num t_o_prom sub get g_t_ad_d add do 4 get g_t_ad_d add do 5
  o_num t_k_acost cwin_d ti C_COST 3
  o_num t_o_gain div sub get g_t_ad_d add do 6 get g_t_ad_d add do 7 f64 1000.0
  co = crossover_ops ti
  o_num t_o_xops co
  o_num t_o_xs div co win_thr ti W_AFTER
  o_num t_o_wamp wake_amp ti
  o_num t_o_cps per_cons ti cwin_d ti C_SPAN 13
  o_num t_o_wps per_cons ti cwin_wasted ti C_SPAN
  o_num t_k_replays cwin_d ti C_SPAN 5
  act = cwin_d ti C_ADAPT 6
  if gt act f64 0.0
    inv = cwin_d ti C_ADAPT 7
    rej = cwin_d ti C_ADAPT 9
    o_num t_o_ira div inv act
    o_num t_o_cra div add inv rej act
  else
    o_num t_o_ira r15_nan
    o_num t_o_cra r15_nan
  end
end

fn emit_one_trial ti ulong to void
  ok = trial_correct ti
  put g_tr_st 1 add get g_tr_st 1 1
  put g_tr_st 2 add get g_tr_st 2 get g_t_sil ti
  if not ok
    if ne get g_tr_st 0 0
      record_g1_why ti
    end
  end
  o_open_anon uchar 123
  o_str_cs t_o_file 0 mul ti 256 256
  o_str_cs t_k_config 1 mul ti 24 24
  o_num t_k_round f64 get g_t_rnd ti
  o_bool t_k_silicon ne get g_t_sil ti 0
  o_bool t_o_correct ok
  o_str_mem t_o_why 4 0 get g_slen 0
  o_num t_o_bops win_thr ti W_BEFORE
  o_num t_o_adops adapt_rate ti
  o_num t_o_afops win_thr ti W_AFTER
  o_num t_o_idlew idle_w ti
  o_num t_o_ean energy_per_op ti W_AFTER
  o_num t_o_eag gross_energy_per_op ti W_AFTER
  o_num t_o_ebn energy_per_op ti W_BEFORE
  o_num t_o_nvml win_d ti W_AFTER 6
  emit_trial_adapt ti
  emit_trial_after_per_op ti
  if and ne get g_t_sil ti 0 gt get g_res_d mul ti 2 f64 0.0
    o_num t_o_gres div get g_res_d add mul ti 2 1 get g_res_d mul ti 2
  else
    o_num t_o_gres r15_nan
  end
  o_close uchar 125
end

note ---- Output: metrics 1..17 ----
fn emit_m1_m2_m3 to void
  o_open t_o_m1 uchar 123
  for c ulong 4
    o_open_cfg c uchar 123
    bm = med_of c 1
    nt_c = get g_tmpu 0
    o_num t_o_bmed bm
    o_num t_o_admed med_of c 2
    o_num t_o_afmed med_of c 0
    o_u t_o_trials nt_c
    o_close uchar 125
    if gt nt_c 0
      put g_have 1 1
    end
  end
  o_close uchar 125

  l1_pct_key t_l1m_A t_l1f_lat 0 1
  for i ulong 7
    put g_a_res i get g_pct i
  end
  o_open t_o_m2 uchar 123
  o_pct t_o_l1ar
  l1_pct_key t_l1m_A t_l1f_lat 0 2
  o_pct t_o_l1as
  for c ulong 4
    sb_reset
    io_puts 2 t_o_tc_p
    if eq c 0
      io_puts 2 t_cfg0
    else
      if eq c 1
        io_puts 2 t_cfg1
      else
        if eq c 2
          io_puts 2 t_cfg2
        else
          io_puts 2 t_cfg3
        end
      end
    end
    kl = get g_slen 0
    for i ulong kl
      put g_kbuf i get g_sbuf i
    end
    put g_klen 0 kl
    hist_pct c
    o_pct_kbuf
  end
  o_close uchar 125
  if gt get g_a_res 0 0
    put g_have 2 1
  end

  o_open t_o_m3 uchar 123
  fan = ulong 1
  for f ulong 9
    sb_reset
    io_puts 2 t_o_fan_p
    io_put_u64 2 fan
    kl = get g_slen 0
    for i ulong kl
      put g_kbuf i get g_sbuf i
    end
    put g_klen 0 kl
    o_open_kbuf uchar 123
    l1_pct_key t_l1m_B t_l1f_ww fan 1
    wp50 = get g_pct 1
    wn = get g_pct 0
    o_pct t_o_wwall
    l1_pct_key t_l1m_B t_l1f_wc fan 1
    cp50 = get g_pct 1
    o_pct t_o_wcpu
    o_num t_o_wp50 div f64 wp50 f64 fan
    o_num t_o_cp50 div f64 cp50 f64 fan
    o_close uchar 125
    if gt wn 0
      put g_have 3 1
    end
    fan = mul fan 2
  end
  o_num t_o_ffan f64 get g_l1_st 3
  o_close uchar 125
end

fn emit_m4_one c ulong m ulong f ulong to void
  sb_reset
  if eq m 0
    io_puts 2 t_l1m_Cu
  else
    if eq m 1
      io_puts 2 t_l1m_Cb
    else
      io_puts 2 t_l1m_Cp
    end
  end
  io_putc 2 uchar 46
  if eq f 0
    io_puts 2 t_l1f_sc
  else
    if eq f 1
      io_puts 2 t_l1f_sw
    else
      if eq f 2
        io_puts 2 t_l1f_rr
      else
        io_puts 2 t_l1f_dr
      end
    end
  end
  kl = get g_slen 0
  for i ulong kl
    put g_kbuf i get g_sbuf i
  end
  put g_klen 0 kl

  sb_reset
  if eq m 0
    io_puts 2 t_l1m_Cu
  else
    if eq m 1
      io_puts 2 t_l1m_Cb
    else
      io_puts 2 t_l1m_Cp
    end
  end
  io_putc 2 uchar 124
  if eq f 0
    io_puts 2 t_l1f_sc
  else
    if eq f 1
      io_puts 2 t_l1f_sw
    else
      if eq f 2
        io_puts 2 t_l1f_rr
      else
        io_puts 2 t_l1f_dr
      end
    end
  end
  io_putc 2 uchar 124
  io_putc 2 uchar 48
  io_putc 2 uchar 124
  if eq c 0
    io_puts 2 t_cfg1
  else
    io_puts 2 t_cfg2
  end
  idx = l1_find
  if lt idx 0
    pct_of_sortu 0
  else
    n = l1_load_sortu ulong idx false
    pct_of_sortu n
  end
  o_pct_kbuf
  if gt get g_pct 0 0
    put g_have 4 1
  end
end

fn emit_m6_bycfg_one src ulong c ulong to void
  nb = get g_nbar 0
  sn = ulong 0
  slive = ulong 0
  for i ulong nb
    if eq get g_bar_tr i src
      if cfg_eq_idx 8 mul i 24 c
        uo = mul i 5
        rec = get g_bar_u add uo 3
        if and eq get g_bar_rc i 0 ne rec 0
          if lt sn R15_SORT_CAP
            put g_sort_u sn sub rec get g_bar_u uo
          end
          sn = add sn 1
          if gt get g_bar_u add uo 4 0
            slive = add slive 1
          end
        end
      end
    end
  end
  if gt sn 0
    o_open_cfg c uchar 123
    o_u t_o_bars sn
    o_u t_o_wpc slive
    o_num t_o_frac div f64 slive f64 sn
    pct_of_sortu sn
    o_pct t_o_latns
    o_close uchar 125
  end
end

fn emit_m6_bycfg to void
  o_open t_o_bycfg uchar 123
  for src ulong 2
    if eq src 0
      o_open t_k_l1_g uchar 123
    else
      o_open t_k_trial uchar 123
    end
    for c ulong 4
      emit_m6_bycfg_one src c
    end
    o_close uchar 125
  end
  o_close uchar 125
end

fn emit_m4_m5_m6 to void
  o_open t_o_m4 uchar 123
  for c ulong 2
    o_open_cfg add c 1 uchar 123
    for m ulong 3
      for f ulong 4
        emit_m4_one c m f
      end
    end
    o_close uchar 125
  end
  o_close uchar 125

  l1_pct_key_d100 t_l1m_E t_l1f_b100 0 1
  for i ulong 7
    put g_e_res i get g_pct i
  end
  o_open t_o_m5 uchar 123
  o_pct t_o_vchk
  l1_pct_key t_l1m_Ea t_l1f_rtv 0 1
  o_pct t_o_awgr
  l1_pct_key t_l1m_Ea t_l1f_rtv 0 2
  o_pct t_o_awgs
  o_close uchar 125
  if gt get g_e_res 0 0
    put g_have 5 1
  end

  nb = get g_nbar 0
  bn = ulong 0
  blive = ulong 0
  bfail = ulong 0
  for i ulong nb
    uo = mul i 5
    rec = get g_bar_u add uo 3
    if or ne get g_bar_rc i 0 eq rec 0
      bfail = add bfail 1
    else
      if lt bn R15_SORT_CAP
        put g_sort_u bn sub rec get g_bar_u uo
      end
      bn = add bn 1
      if gt get g_bar_u add uo 4 0
        blive = add blive 1
      end
    end
  end
  pct_of_sortu bn
  for i ulong 7
    put g_bp i get g_pct i
  end
  put g_bar_st 0 bn
  put g_bar_st 1 blive
  put g_bar_st 2 bfail
  o_open t_o_m6 uchar 123
  o_pct t_o_latns
  o_u t_o_bars bn
  o_u t_o_barf bfail
  if gt bn 0
    o_num t_o_fpc div f64 blive f64 bn
  else
    o_num t_o_fpc r15_nan
  end
  emit_m6_bycfg
  o_close uchar 125
  if gt bn 0
    put g_have 6 1
  end
end

fn emit_m7_field c ulong b ulong to void
  nt = get g_nt 0
  n = ulong 0
  fidx = add b 7
  if eq b 10
    fidx = 2
  end
  for i ulong nt
    if cfg_eq_idx 1 mul i 24 c
      if ne get g_w_has add mul i W_N W_AFTER 0
        wops = win_d i W_AFTER 0
        x = win_d i W_AFTER fidx
        if and gt wops f64 0.0 not is_nan x
          if lt n 512
            put g_vd n div x wops
            n = add n 1
          end
        end
      end
    end
  end
  m = median_vd n 0
  if eq b 0
    o_num t_st_0 m
  else
    if eq b 1
      o_num t_st_1 m
    else
      if eq b 2
        o_num t_st_2 m
      else
        if eq b 3
          o_num t_st_3 m
        else
          if eq b 4
            o_num t_st_4 m
          else
            if eq b 5
              o_num t_st_5 m
            else
              if eq b 6
                o_num t_st_6 m
              else
                if eq b 7
                  o_num t_st_7 m
                else
                  if eq b 8
                    o_num t_st_8 m
                  else
                    if eq b 9
                      o_num t_st_9 m
                    else
                      o_num t_k_gsb m
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  if gt n 0
    put g_have 7 1
  end
end

fn l2_pool_val p ulong idx ulong to ulong
  if eq p 0
    ret get g_l2_e2e idx
  end
  if eq p 1
    ret get g_l2_gpu idx
  end
  if eq p 2
    ret get g_l2_enq idx
  end
  if eq p 3
    ret get g_l2_pub idx
  end
  ret get g_l2_dep idx
end

fn l2_pct_pool c ulong p ulong to void
  nl2 = get g_nl2 0
  n = ulong 0
  for i ulong nl2
    if cfg_eq_idx 9 mul i 24 add c 1
      off = get g_l2_off add mul i 5 p
      cnt = get g_l2_cnt add mul i 5 p
      for j ulong cnt
        if lt n R15_SORT_CAP
          put g_sort_u n l2_pool_val p add off j
          n = add n 1
        end
      end
    end
  end
  pct_of_sortu n
end

fn emit_m8_cfg c ulong to void
  nl2 = get g_nl2 0
  nsyn = ulong 0
  nspin = ulong 0
  runs = ulong 0
  failed = ulong 0
  for i ulong nl2
    if cfg_eq_idx 9 mul i 24 add c 1
      runs = add runs 1
      if ne get g_l2_exit i 0
        failed = add failed 1
      end
      bo = mul i 4
      res = get g_l2_wd bo
      if gt res f64 0.0
        s = add get g_l2_wd add bo 1 mul f64 2.0 res
        s = add s get g_l2_wd add bo 2
        if lt nsyn 512
          put g_vd nsyn div s res
          nsyn = add nsyn 1
        end
        if lt nspin 512
          put g_vd2 nspin div get g_l2_wd add bo 3 res
          nspin = add nspin 1
        end
      end
    end
  end
  sm = median_vd nsyn 0
  spm = median_vd nspin 1
  put g_sync_m c sm
  put g_spin_m c spm
  o_open_cfg add c 1 uchar 123
  o_num t_o_runs f64 runs
  o_num t_o_runsf f64 failed
  o_num t_o_smed sm
  o_str t_o_sdef t_o_sdef_v
  o_num t_o_hspin spm
  o_str t_o_hsdef t_o_hsdef_v
  l2_pct_pool c 2
  o_pct t_o_enq
  l2_pct_pool c 1
  o_pct t_o_gexec
  l2_pct_pool c 3
  o_pct t_o_cpub
  l2_pct_pool c 4
  o_pct t_o_dwake
  l2_pct_pool c 0
  o_pct t_o_e2e
  o_close uchar 125
  if gt nsyn 0
    put g_have 8 1
  end
end

fn emit_m7_m8 to void
  o_open t_o_m7 uchar 123
  for c ulong 4
    o_open_cfg c uchar 123
    for b ulong 11
      emit_m7_field c b
    end
    o_close uchar 125
  end
  o_str t_o_ctb t_o_ctb_v
  o_close uchar 125

  o_open t_o_m8 uchar 123
  for c ulong 2
    emit_m8_cfg c
  end
  o_close uchar 125
end

fn emit_m9_field c ulong e ulong to void
  nt = get g_nt 0
  n = ulong 0
  mux = ulong 0
  fidx = ulong 21
  if eq e 1
    fidx = 22
  else
    if eq e 2
      fidx = 23
    else
      if eq e 3
        fidx = 24
      else
        if eq e 4
          fidx = 19
        else
          if eq e 5
            fidx = 20
          end
        end
      end
    end
  end
  for i ulong nt
    if cfg_eq_idx 1 mul i 24 c
      ws = add mul i W_N W_AFTER
      if ne get g_w_has ws 0
        if ne get g_w_pmu mul ws 2 0
          if ne get g_w_pmu add mul ws 2 1 0
            if eq e 0
              mux = add mux 1
            end
          else
            if lt n 512
              put g_vd n div win_d i W_AFTER fidx win_d i W_AFTER 0
              n = add n 1
            end
          end
        end
      end
    end
  end
  m = median_vd n 0
  if eq e 0
    o_num t_pm_2 m
    put g_tmpu 0 n
    put g_tmpu 1 mux
  else
    if eq e 1
      o_num t_pm_3 m
    else
      if eq e 2
        o_num t_pm_4 m
      else
        if eq e 3
          o_num t_pm_5 m
        else
          if eq e 4
            o_num t_pm_0 m
          else
            o_num t_pm_1 m
          end
        end
      end
    end
  end
end

fn emit_res_diag slot ulong to void
  if eq get g_res_has slot 0
    ret
  end
  uo = mul slot 12
  lost = sub get g_res_u uo get g_res_u add uo 1
  o_open t_o_wpd uchar 123
  o_str_mem t_o_proc 6 0 get g_wnlen 0
  o_u t_o_lsamp lost
  if eq lost 0
    o_str t_o_class t_o_noloss
  else
    if eq get g_res_hdg slot 0
      o_str t_o_class t_o_unmeas
      o_str t_o_why t_o_unmeas_w
    else
      longest = get g_res_u add uo 3
      if ge longest 100
        o_str t_o_class t_o_stop
      else
        o_str t_o_class t_o_scat
      end
      o_u t_k_dead_runs get g_res_u add uo 2
      o_u t_k_dead_long longest
      o_u t_k_dead_end get g_res_u add uo 4
      o_u t_k_late_2ms get g_res_u add uo 5
      o_u t_k_late_10ms get g_res_u add uo 6
      o_bool t_o_slobs gt get g_res_u add uo 6 0
      o_u t_k_max_gap get g_res_u add uo 7
      o_u t_k_stale_max get g_res_u add uo 8
      fd = get g_res_u add uo 9
      tf = get g_res_u add uo 10
      if and ne fd 0 ne tf 0
        o_u t_o_fdead_a sub fd tf
      end
    end
  end
  o_close uchar 125
end

fn emit_m9 to void
  o_open t_o_m9 uchar 123
  for c ulong 4
    o_open_cfg c uchar 123
    for e ulong 6
      emit_m9_field c e
    end
    used = get g_tmpu 0
    mux = get g_tmpu 1
    o_u t_o_wused used
    o_u t_o_wmux mux
    o_str t_o_deriv t_o_deriv_v
    o_close uchar 125
    if gt used 0
      put g_have 9 1
    end
  end
  o_close uchar 125
end

fn save_wname to void
  wl = get g_slen 0
  for k ulong wl
    put g_wname k get g_sbuf k
  end
  put g_wnlen 0 wl
end

fn emit_m10 to void
  rmin = r15_nan
  rn = ulong 0
  worst = long -1
  nt = get g_nt 0
  for i ulong nt
    if ne get g_t_sil i 0
      if ne get g_res_has i 0
        iv = get g_res_d mul i 2
        if gt iv f64 0.0
          r = div get g_res_d add mul i 2 1 iv
          if or is_nan rmin lt r rmin
            rmin = r
            worst = long i
            sb_reset
            io_put_cs 2 0 mul i 256 250
            save_wname
          end
          rn = add rn 1
        end
      end
    end
  end
  nl2 = get g_nl2 0
  for i ulong nl2
    if ne get g_l2_sil i 0
      rs = add 512 i
      if ne get g_res_has rs 0
        iv = get g_res_d mul rs 2
        if gt iv f64 0.0
          r = div get g_res_d add mul rs 2 1 iv
          if or is_nan rmin lt r rmin
            rmin = r
            worst = long rs
            sb_reset
            io_puts 2 t_l2_pref
            io_put_cs 2 9 mul i 24 20
            io_putc 2 uchar 45
            io_put_u64 2 i
            save_wname
          end
          rn = add rn 1
        end
      end
    end
  end
  put g_res_min 0 rmin
  put g_res_st 0 rn
  o_open t_o_m10 uchar 123
  o_num t_o_mfl rmin
  o_u t_o_sproc rn
  if ge worst 0
    emit_res_diag ulong worst
  end
  o_close uchar 125
  if gt rn 0
    put g_have 10 1
  end
end

fn emit_m9_m10_m11 to void
  emit_m9
  emit_m10
  nt = get g_nt 0
  o_open t_o_m11 uchar 123
  for c ulong 4
    nc = ulong 0
    ns = ulong 0
    for i ulong nt
      if cfg_eq_idx 1 mul i 24 c
        if ne get g_w_has add mul i W_N W_AFTER 0
          if lt nc 512
            put g_vd nc div add win_d i W_AFTER 3 win_d i W_AFTER 4 win_d i W_AFTER 1
            nc = add nc 1
          end
          si = win_d i W_AFTER 25
          if gt si f64 0.0
            if lt ns 512
              put g_vd2 ns div win_d i W_AFTER 26 si
              ns = add ns 1
            end
          end
        end
      end
    end
    o_open_cfg c uchar 123
    o_num t_o_pcbm median_vd nc 0
    o_num t_o_r5mm median_vd ns 1
    o_close uchar 125
    if gt nc 0
      put g_have 11 1
    end
  end
  o_str t_o_pthr t_o_pthr_v
  o_close uchar 125
end

fn emit_m12_15 to void
  nt = get g_nt 0
  o_open t_o_m1215 uchar 123
  for c ulong 4
    o_open_cfg c uchar 123
    o_num t_o_wpsm med_of c 4
    ni = ulong 0
    for i ulong nt
      if cfg_eq_idx 1 mul i 24 c
        if ne get g_cw_has add mul i C_N C_ADAPT 0
          act = cwin_d i C_ADAPT 6
          if gt act f64 0.0
            inv = cwin_d i C_ADAPT 7
            rej = cwin_d i C_ADAPT 9
            if lt ni 512
              put g_vd ni div inv act
              put g_vd2 ni div add inv rej act
              ni = add ni 1
            end
          end
        end
      end
    end
    o_num t_o_iram median_vd ni 0
    o_num t_o_cram median_vd ni 1
    na = ulong 0
    for i ulong nt
      if cfg_eq_idx 1 mul i 24 c
        if ne get g_cw_has add mul i C_N C_ADAPT 0
          a = wake_amp i
          if not is_nan a
            if lt na 512
              put g_vd na a
              na = add na 1
            end
          end
        end
      end
    end
    o_num t_o_wampm median_vd na 0
    if gt ni 0
      put g_have 12 1
      put g_have 13 1
      put g_have 14 1
    end
    if gt na 0
      put g_have 15 1
    end
    o_close uchar 125
  end
  o_close uchar 125
end

fn pmu_valid ti ulong to bool
  ws = add mul ti W_N W_AFTER
  if eq get g_w_has ws 0
    ret false
  end
  if eq get g_w_pmu mul ws 2 0
    ret false
  end
  ret eq get g_w_pmu add mul ws 2 1 0
end

fn emit_m16 to void
  nt = get g_nt 0
  o_open t_o_m16 uchar 123
  o_cmp t_o_c_nd 6
  ncy = ulong 0
  for i ulong nt
    if cfg_eq_idx 1 mul i 24 1
      b = find_trial 3 get g_t_rnd i
      if ge b 0
        bi = ulong b
        if same_realization i bi
          if and pmu_valid i pmu_valid bi
            x = div win_d i W_AFTER 19 win_d i W_AFTER 0
            y = div win_d bi W_AFTER 19 win_d bi W_AFTER 0
            if gt y f64 0.0
              if lt ncy 512
                put g_vd ncy div x y
                ncy = add ncy 1
              end
            end
          end
        end
      end
    end
  end
  o_num t_o_cprm median_vd ncy 0
  o_close uchar 125
  if gt get g_cmp_u 12 0
    put g_have 16 1
  end
end

fn emit_m17_cfg c ulong to ulong
  nt = get g_nt 0
  nep = ulong 0
  ngrs = ulong 0
  for i ulong nt
    if cfg_eq_idx 1 mul i 24 c
      x = energy_per_op i W_AFTER
      if not is_nan x
        if lt nep 512
          put g_vd nep x
          nep = add nep 1
        end
      end
      x2 = gross_energy_per_op i W_AFTER
      if not is_nan x2
        if lt ngrs 512
          put g_vd2 ngrs x2
          ngrs = add ngrs 1
        end
      end
    end
  end
  m_ep = median_vd nep 0
  m_eg = median_vd ngrs 1
  nee = ulong 0
  nnv = ulong 0
  for i ulong nt
    if cfg_eq_idx 1 mul i 24 c
      uo = mul i 3
      g = get g_t_ad_u uo
      met = get g_t_ad_u add uo 1
      if and ne g 0 ne met 0
        xe = tel_energy i g met
        if not is_nan xe
          if lt nee 512
            put g_vd nee xe
            nee = add nee 1
          end
        end
      end
      xn = div win_d i W_AFTER 6 win_d i W_AFTER 0
      if not is_nan xn
        if lt nnv 512
          put g_vd2 nnv xn
          nnv = add nnv 1
        end
      end
    end
  end
  o_open_cfg c uchar 123
  o_num t_o_pnet m_ep
  o_num t_o_pgrs m_eg
  o_num t_o_pepi median_vd nee 0
  o_num t_o_nvmed median_vd nnv 1
  o_u t_o_wins nep
  o_close uchar 125
  ret nep
end

fn emit_m12_to_m17 to void
  emit_m12_15
  emit_m16
  o_open t_o_m17 uchar 123
  en_n = ulong 0
  for c ulong 4
    en_n = add en_n emit_m17_cfg c
  end
  o_cmp t_o_c_en 7
  o_str t_o_unc t_o_unc_v
  o_close uchar 125
  if gt en_n 0
    put g_have 17 1
  end
  o_open t_o_instov uchar 123
  nw = get g_nw 0
  for c ulong 2
    non = ulong 0
    noff = ulong 0
    for i ulong nw
      if cfg_eq_idx 10 mul i 24 add c 1
        if ne get g_wr_tim i 0
          if lt non 512
            put g_vd non get g_wr_thr i
            non = add non 1
          end
        else
          if lt noff 512
            put g_vd2 noff get g_wr_thr i
            noff = add noff 1
          end
        end
      end
    end
    o_num_cfg add c 1 div median_vd non 0 median_vd noff 1
  end
  o_close uchar 125
end

note ---- Gates ----
fn set_gate idx ulong val f64 pass bool to void
  put g_gt_val idx val
  put g_gt_pass idx b2u pass
  nl = get g_slen 0
  if gt nl 199
    nl = 199
  end
  no = mul idx 200
  for i ulong nl
    put g_gt_note add no i get g_sbuf i
  end
  put g_gt_note add no nl uchar 0
  put g_gt_nlen idx nl
end

fn eval_g5_g8 to void
  sb_reset
  io_puts 2 t_gn_p50
  io_put_u64 2 get g_a_res 1
  io_puts 2 t_gn_p99
  io_put_u64 2 get g_a_res 4
  io_puts 2 t_gn_nsn
  io_put_u64 2 get g_a_res 0
  p5 = and gt get g_a_res 0 0 le get g_a_res 1 50000
  p5 = and p5 le get g_a_res 4 221000
  p5 = and p5 eq get g_l1_st 2 0
  set_gate 4 f64 get g_a_res 4 p5

  sb_reset
  io_puts 2 t_gn_p50
  io_put_u64 2 get g_e_res 1
  io_puts 2 t_gn_p99
  io_put_u64 2 get g_e_res 4
  io_puts 2 t_gn_pchk
  p6 = and gt get g_e_res 0 0 le get g_e_res 1 1000
  p6 = and p6 le get g_e_res 4 5000
  set_gate 5 f64 get g_e_res 4 p6

  bn = get g_bar_st 0
  blive = get g_bar_st 1
  bfail = get g_bar_st 2
  lfrac = r15_nan
  if gt bn 0
    lfrac = div f64 blive f64 bn
  end
  sb_reset
  io_put_u64 2 bn
  io_puts 2 t_gn_bars
  io_put_u64 2 bfail
  io_puts 2 t_gn_bfail
  io_put_u64 2 get g_bp 4
  io_puts 2 t_gn_ns
  p7 = and gt bn 0 eq bfail 0
  p7 = and p7 ge lfrac f64 0.90
  p7 = and p7 le get g_bp 4 500000000
  set_gate 6 lfrac p7

  sb_reset
  io_put_u64 2 get g_cmp_u 12
  io_puts 2 t_gn_vp
  set_gate 7 get g_cmp_d 18 and ge get g_cmp_u 12 10 ge get g_cmp_d 18 f64 0.50
end

fn eval_gates_1 to void
  nt = get g_nt 0
  enough = true
  for c ulong 4
    nc = ulong 0
    for i ulong nt
      if cfg_eq_idx 1 mul i 24 c
        nc = add nc 1
      end
    end
    if lt nc 12
      enough = false
    end
  end
  sb_reset
  gl = get g_g1_wlen 0
  io_put_mem 2 5 0 gl
  if not enough
    if gt gl 0
      io_puts 2 t_gn_semi
    end
    io_puts 2 t_gn_f12
  end
  g1_ok = ne get g_tr_st 0 0
  comp = get g_tr_st 1
  set_gate 0 f64 comp and g1_ok and enough gt comp 0

  sb_reset
  io_put_u64 2 get g_cmp_u 0
  io_puts 2 t_gn_vp10
  p2 = and ge get g_cmp_u 0 10 ge get g_cmp_d 0 f64 0.90
  p2 = and p2 ge get g_cmp_d 1 f64 0.85
  set_gate 1 get g_cmp_d 0 p2

  sb_reset
  set_gate 2 get g_cmp_d 10 and ge get g_cmp_u 6 2 gt get g_cmp_d 10 f64 1.0

  n4 = ulong 0
  for i ulong nt
    if cfg_eq_idx 1 mul i 24 0
      a = adapt_rate i
      b = win_thr i W_BEFORE
      if and not is_nan a gt b f64 0.0
        if lt n4 512
          put g_vd n4 div a b
          n4 = add n4 1
        end
      end
    end
  end
  g4 = median_vd n4 0
  sb_reset
  set_gate 3 g4 and gt n4 0 ge g4 f64 0.50
  eval_g5_g8
end

fn eval_g13_g16 to void
  sb_reset
  set_gate 12 get g_cmp_d 24 and gt get g_cmp_u 16 0 le get g_cmp_d 24 f64 1.10

  nt = get g_nt 0
  ncr = ulong 0
  for i ulong nt
    if cfg_eq_idx 1 mul i 24 0
      if ne get g_cw_has add mul i C_N C_ADAPT 0
        act = cwin_d i C_ADAPT 6
        if gt act f64 0.0
          if lt ncr 512
            put g_vd ncr div add cwin_d i C_ADAPT 7 cwin_d i C_ADAPT 9 act
            ncr = add ncr 1
          end
        end
      end
    end
  end
  cr = median_vd ncr 0
  sb_reset
  set_gate 13 cr and not is_nan cr le cr f64 0.25

  rn = get g_res_st 0
  silt = get g_tr_st 2
  rmin = get g_res_min 0
  sb_reset
  io_put_u64 2 rn
  io_puts 2 t_gn_g15a
  io_put_u64 2 silt
  io_puts 2 t_gn_g15b
  set_gate 14 rmin and gt rn 0 and gt silt 0 ge rmin f64 0.99

  all17 = true
  sb_reset
  m = ulong 1
  while le m 17
    if eq get g_have m 0
      all17 = false
      if eq get g_slen 0 0
        io_puts 2 t_gn_miss
      else
        io_putc 2 uchar 44
      end
      io_put_u64 2 m
    end
    m = add m 1
  end
  v16 = f64 0.0
  if all17
    v16 = f64 1.0
  end
  set_gate 15 v16 all17
end

fn eval_gates_2 to void
  sb_reset
  io_put_u64 2 get g_cmp_u 14
  io_puts 2 t_gn_vp
  p9 = and ge get g_cmp_u 14 10 le get g_cmp_d 21 f64 1.15
  p9 = and p9 le get g_cmp_d 23 f64 1.25
  set_gate 8 get g_cmp_d 21 p9

  s0 = get g_sync_m 0
  s1 = get g_sync_m 1
  sb_reset
  io_puts 2 t_gn_g10a
  io_put_fix 2 s0 3
  io_puts 2 t_gn_g10b
  io_put_fix 2 s1 3
  io_puts 2 t_gn_g10c
  io_put_fix 2 get g_spin_m 0 1
  io_puts 2 t_gn_g10b
  io_put_fix 2 get g_spin_m 1 1
  io_puts 2 t_gn_g10d
  set_gate 9 s0 and not is_nan s0 and not is_nan s1 le s0 s1

  co = med_of 0 5
  nco = get g_tmpu 0
  sb_reset
  set_gate 10 co and gt nco 0 le co f64 10000000.0

  wa4 = med_of 0 6
  was = med_of 2 6
  sb_reset
  io_puts 2 t_gn_g12a
  io_put_fix 2 wa4 3
  io_puts 2 t_gn_g10b
  io_put_fix 2 was 3
  io_puts 2 t_gn_g12b
  set_gate 11 wa4 and not is_nan wa4 and not is_nan was le wa4 was
  eval_g13_g16
end

fn emit_gate_id ch ulong i ulong to void
  if eq i 0
    io_puts ch t_gid_0
  else
    if eq i 1
      io_puts ch t_gid_1
    else
      if eq i 2
        io_puts ch t_gid_2
      else
        if eq i 3
          io_puts ch t_gid_3
        else
          if eq i 4
            io_puts ch t_gid_4
          else
            if eq i 5
              io_puts ch t_gid_5
            else
              if eq i 6
                io_puts ch t_gid_6
              else
                if eq i 7
                  io_puts ch t_gid_7
                else
                  if eq i 8
                    io_puts ch t_gid_8
                  else
                    if eq i 9
                      io_puts ch t_gid_9
                    else
                      if eq i 10
                        io_puts ch t_gid_10
                      else
                        if eq i 11
                          io_puts ch t_gid_11
                        else
                          if eq i 12
                            io_puts ch t_gid_12
                          else
                            if eq i 13
                              io_puts ch t_gid_13
                            else
                              if eq i 14
                                io_puts ch t_gid_14
                              else
                                io_puts ch t_gid_15
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end


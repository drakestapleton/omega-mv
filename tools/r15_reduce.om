fn emit_gates_and_footer to bool
  all = true
  o_open t_o_gates uchar 91
  for i ulong 16
    o_open_anon uchar 123
    o_key t_o_id
    io_putc 0 uchar 34
    emit_gate_id 0 i
    io_putc 0 uchar 34
    emit_gate_what i
    emit_gate_thr i
    o_num t_o_val get g_gt_val i
    if ne get g_gt_pass i 0
      o_str t_o_outc t_pass
    else
      o_str t_o_outc t_fail
      all = false
    end
    o_str_mem t_o_note 7 mul i 200 get g_gt_nlen i
    o_close uchar 125
  end
  o_close uchar 93
  o_open t_o_inps uchar 123
  o_num t_o_trials f64 get g_nt 0
  o_num t_o_l1p f64 get g_l1_st 0
  o_num t_o_l1pf f64 get g_l1_st 1
  o_num t_o_l1tb f64 get g_l1_st 2
  o_num t_o_l2p f64 get g_nl2 0
  o_close uchar 125
  o_bool t_o_agp all
  o_close uchar 125
  io_putc 0 uchar 10
  io_flush 0
  ret all
end

fn print_stderr_gates all bool to void
  for i ulong 16
    emit_gate_id 1 i
    if lt i 9
      io_putc 1 uchar 32
      io_putc 1 uchar 32
    else
      io_putc 1 uchar 32
    end
    io_putc 1 uchar 32
    if ne get g_gt_pass i 0
      io_puts 1 t_pass
    else
      io_puts 1 t_fail
    end
    io_putc 1 uchar 32
    io_put_mem 1 7 mul i 200 get g_gt_nlen i
    io_putc 1 uchar 10
  end
  io_puts 1 t_all_gates
  if all
    io_puts 1 t_pass
  else
    io_puts 1 t_fail
  end
  io_putc 1 uchar 10
  io_flush 1
end

fn run_comparisons to void
  paired 0 1 2 0 true
  paired 1 0 2 0 true
  paired 2 1 2 1 false
  paired 3 0 2 2 false
  paired 4 1 2 2 false
  paired 5 0 1 0 true
  paired 6 1 3 0 true
  paired 7 1 2 3 true
  paired 8 1 2 4 false
  o_open t_o_cmps uchar 123
  o_cmp t_o_c_a1s 0
  o_cmp t_o_c_a4s 1
  o_cmp t_o_c_a41 5
  o_cmp t_o_c_b1s 2
  o_cmp t_o_c_ad4s 3
  o_cmp t_o_c_ad1s 4
  o_cmp t_o_c_nd 6
  o_cmp t_o_c_en 7
  o_cmp t_o_c_wa 8
  o_close uchar 125
end

fn main to int
  put g_ofd 0 -1
  put g_l1_nb 0 1
  ac = argcnt
  if ne ac 3
    io_puts 1 t_usg
    io_flush 1
    ret 64
  end
  dl = argread 1 g_dir 0 1023
  if lt dl 0
    ret 2
  end
  put g_dirlen 0 ulong dl
  ol = argread 2 g_outpath 0 1023
  if lt ol 0
    ret 2
  end
  put g_outlen 0 ulong ol

  if lt load_sums_and_dir 0
    ret 2
  end
  nf = get g_nfiles 0
  for i ulong nf
    oi = get g_ford i
    if lt read_jsonl_file oi 0
      io_puts 1 t_unread
      io_put_mem 1 2 mul oi 256 get g_flen oi
      io_puts 1 t_nl
      io_flush 1
      ret 2
    end
  end

  fd = fopen g_outpath 0 ulong ol 577 420
  if lt fd 0
    ret 2
  end
  put g_ofd 0 fd
  put g_fdepth 0 0
  put g_fstack 0 1
  o_open_anon uchar 123
  o_str t_o_schema t_o_schema_v
  o_str_mem t_o_rdig 11 0 64
  o_str t_o_boot t_o_boot_v
  o_open t_o_files uchar 91
  for i ulong nf
    oi = get g_ford i
    o_open_anon uchar 123
    o_str_mem t_o_name 2 mul oi 256 get g_flen oi
    o_str_mem t_o_sha256 3 mul oi 64 64
    o_close uchar 125
  end
  o_close uchar 93

  put g_tr_st 0 1
  put g_tr_st 1 0
  put g_tr_st 2 0
  put g_g1_wlen 0 0
  o_open t_o_trials uchar 91
  nt = get g_nt 0
  for i ulong nt
    emit_one_trial i
  end
  o_close uchar 93

  run_comparisons

  o_open t_o_metrics uchar 123
  emit_m1_m2_m3
  emit_m4_m5_m6
  emit_m7_m8
  emit_m9_m10_m11
  emit_m12_to_m17
  o_close uchar 125

  eval_gates_1
  eval_gates_2
  all = emit_gates_and_footer
  _fc = fclose int fd
  put g_ofd 0 -1
  print_stderr_gates all
  ret 0
end

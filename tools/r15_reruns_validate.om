note
note r15_reruns_validate.om: strict schema check for the R15 correctness-rerun object.
note Compose after seed/json/json.om under one om2 line. Reads one JSON document from stdin.
note Exit 0 only for exactly the thirteen required keys, each once, with the string value PASS.
note Exit 1 for invalid JSON or schema and 2 for an input read error. No output is written.

text rrpass "PASS"
text rr3 "R3"
text rr7 "R7"
text rr8 "R8"
text rr9 "R9"
text rr10 "R10"
text rr11 "R11"
text rr12h "R12_host"
text rr12s "R12_silicon"
text rr13h "R13_host"
text rr13s "R13_silicon"
text rr14h "R14_host"
text rr14s "R14_silicon"
text rr15p "R15_SEQ_parity"

note rrkey returns 0..12 for a required decoded key and 13 for every other key.
fn rrkey src view uchar * tape view uint * k ulong to ulong
o = js_off tape k
if js_streq src o rr3
ret 0
end
if js_streq src o rr7
ret 1
end
if js_streq src o rr8
ret 2
end
if js_streq src o rr9
ret 3
end
if js_streq src o rr10
ret 4
end
if js_streq src o rr11
ret 5
end
if js_streq src o rr12h
ret 6
end
if js_streq src o rr12s
ret 7
end
if js_streq src o rr13h
ret 8
end
if js_streq src o rr13s
ret 9
end
if js_streq src o rr14h
ret 10
end
if js_streq src o rr14s
ret 11
end
if js_streq src o rr15p
ret 12
end
ret 13
end

fn rrread src edit uchar * to ulong
p = ulong 0
while lt p len src bound 983041
r = read 0 src p sub len src p
if lt r 0
exit 2
end
if eq r 0
ret p
end
p = add p ulong r
end
extra = new uchar 1 0
r = read 0 extra 0 1
if ne r 0
exit 1
end
ret p
end

fn main to int
src = new uchar 983040 0
tape = new uint 256 0
n = rrread src
if ne js_init tape 983040 16 0
ret 2
end
if lt js_parse src tape n 0
ret 1
end
if or ne js_type tape 0 jsobj ne js_nkids tape 0 13
ret 1
end

seen = ulong 0
k = js_first tape 0
for i ulong 13
if eq k jsnone
ret 1
end
id = rrkey src tape k
if eq id 13
ret 1
end
bit = shl ulong 1 id
if ne and seen bit 0
ret 1
end
v = add k 1
if or ne js_type tape v jsstr not js_streq src js_off tape v rrpass
ret 1
end
seen = or seen bit
k = js_mnext tape k
end
if or ne k jsnone ne seen 8191
ret 1
end
ret 0
end

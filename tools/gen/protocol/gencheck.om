note ---- failure --------------------------------------------------------------------------------

fn gc_fb to void
  fs_ps 9 gc_t_fail
end

note end a refusal: the reason line on stderr, "GENCHECK FAIL" on stdout, exit 1
fn gc_die to void
  fs_pc 9 uchar 10
  fs_eflush
  fs_ps 8 gc_t_gfail
  fs_oflush
  exit 1
end

fn gc_f t view uchar * to void
  gc_fb
  fs_ps 9 t
  gc_die
end

note refusal "<t1><heap string h><t2>"
fn gc_fht t1 view uchar * h ulong t2 view uchar * to void
  gc_fb
  fs_ps 9 t1
  fs_ph 9 h
  fs_ps 9 t2
  gc_die
end

note refusal "<t1><number v><t2>"
fn gc_fnt t1 view uchar * v ulong t2 view uchar * to void
  gc_fb
  fs_ps 9 t1
  fs_pu 9 v
  fs_ps 9 t2
  gc_die
end

fn gc_hex2 dst ulong b uchar to void
  fs_pc dst sh_hexd uint shr b 4
  fs_pc dst sh_hexd uint and b 15
end

note ---- heap helpers ---------------------------------------------------------------------------

fn gc_ht t view uchar * to ulong
  st = fs_htop
  fs_hs t
  ret fs_hend st
end

note new heap string "<t1><decimal i><t2>"
fn gc_key t1 view uchar * i ulong t2 view uchar * to ulong
  st = fs_htop
  fs_hs t1
  k = fs_digits i
  while gt k 0 bound 24
    k = sub k 1
    fs_hc get fs_dig k
  end
  fs_hs t2
  ret fs_hend st
end

note new heap string "<a><c><b>" (c 0: no separator)
fn gc_join a ulong c uchar b ulong to ulong
  st = fs_htop
  fs_hcopy a
  if ne c 0
    fs_hc c
  end
  fs_hcopy b
  ret fs_hend st
end

note root + "/" + rel
fn gc_full rel ulong to ulong
  ret gc_join get gc_st 2 uchar 47 rel
end

note heap string h starts with heap string p
fn gc_hstarts h ulong p ulong to bool
  n = fs_hlen p
  if lt fs_hlen h n
    ret false
  end
  for i ulong n bound 16777216
    if ne fs_hb h i fs_hb p i
      ret false
    end
  end
  ret true
end

note heap string h starts with text t
fn gc_hstartt h ulong t view uchar * to bool
  n = len t
  if lt fs_hlen h n
    ret false
  end
  for i ulong n bound 1024
    if ne fs_hb h i get t i
      ret false
    end
  end
  ret true
end

note the k-th "\n"-terminated line of text t as a heap string (field before the first tab when tab)
fn gc_tline t view uchar * pos ulong to ulong
  st = fs_htop
  p = pos
  while lt p len t bound 16777216
    c = get t p
    if or eq c 10 eq c 9
      break
    end
    fs_hc c
    p = add p 1
  end
  ret fs_hend st
end

note ---- tables ---------------------------------------------------------------------------------

note parse the line tables into heap strings (schema: "<norm> <types>"; "-" is the root norm "")
fn gc_init to void
  fs_init
  n = ulong 0
  p = ulong 0
  while lt p len gc_schema bound 1024
    q = p
    while ne get gc_schema q 32 bound 256
      q = add q 1
    end
    nm = gc_tspan gc_schema p q
    if eq get gc_schema p 45
      nm = fs_pack fs_htop 0
    end
    r = add q 1
    while ne get gc_schema r 10 bound 256
      r = add r 1
    end
    put gc_skn n nm
    put gc_skt n gc_tspan gc_schema add q 1 r
    n = add n 1
    p = add r 1
  end
  put gc_st 8 n
  put gc_st 9 gc_tabs gc_fixed 0
  put gc_st 11 gc_tabs gc_fixlen 1
  put gc_st 10 gc_lines gc_mustpin
end

note bytes t[a..b) as a heap string
fn gc_tspan t view uchar * a ulong b ulong to ulong
  st = fs_htop
  for i ulong sub b a bound 16777216
    fs_hc get t add a i
  end
  ret fs_hend st
end

note "<key>\t<value>\n" rows of t into gc_fxp / gc_fxr (which 0) or gc_flp / gc_fln (which 1); the count
fn gc_tabs t view uchar * which ulong to ulong
  n = ulong 0
  p = ulong 0
  while lt p len t bound 1024
    q = p
    while ne get t q 9 bound 256
      q = add q 1
    end
    r = add q 1
    while ne get t r 10 bound 256
      r = add r 1
    end
    k = gc_tspan t p q
    if eq which 0
      put gc_fxp n k
      put gc_fxr n gc_tspan t add q 1 r
    else
      put gc_flp n k
      put gc_fln n gc_tnum t add q 1 r
    end
    n = add n 1
    p = add r 1
  end
  ret n
end

fn gc_tnum t view uchar * a ulong b ulong to ulong
  v = ulong 0
  for i ulong sub b a bound 32
    v = add mul v 10 ulong sub get t add a i 48
  end
  ret v
end

note "\n"-terminated rows of t into gc_mp; the count
fn gc_lines t view uchar * to ulong
  n = ulong 0
  p = ulong 0
  while lt p len t bound 1024
    q = p
    while ne get t q 10 bound 256
      q = add q 1
    end
    put gc_mp n gc_tspan t p q
    n = add n 1
    p = add q 1
  end
  ret n
end

note ---- strict JSON reader ----------------------------------------------------------------------

fn gc_jpos to ulong
  ret get gc_st 3
end

fn gc_jset p ulong to void
  put gc_st 3 p
end

fn gc_jn to ulong
  ret get gc_st 4
end

note the byte at the position, 0 at the end
fn gc_jcur to uchar
  p = gc_jpos
  if ge p gc_jn
    ret 0
  end
  ret get gc_jb p
end

fn gc_jat_end to bool
  ret ge gc_jpos gc_jn
end

fn gc_jws to void
  p = gc_jpos
  n = gc_jn
  while lt p n bound 16777216
    c = get gc_jb p
    if and and ne c 32 ne c 10 ne c 9
      break
    end
    p = add p 1
  end
  gc_jset p
end

fn gc_jadd path ulong norm ulong ty uchar raw ulong to void
  n = get gc_st 0
  if ge n 1024
    gc_f gc_j_more
  end
  put gc_ep n path
  put gc_en n norm
  put gc_et n ty
  put gc_er n raw
  put gc_st 0 add n 1
end

note "(root)" for the empty path, else the path
fn gc_pathname dst ulong path ulong to void
  if eq fs_hlen path 0
    fs_ps dst gc_t_root
  else
    fs_ph dst path
  end
end

fn gc_jstring to ulong
  if or gc_jat_end ne gc_jcur 34
    gc_fnt gc_j_expstr gc_jpos gc_t_empty
  end
  gc_jset add gc_jpos 1
  st = fs_htop
  going = true
  while going bound 16777216
    if gc_jat_end
      gc_f gc_j_unterm
    end
    c = gc_jcur
    gc_jset add gc_jpos 1
    if eq c 34
      going = false
    else
      gc_jstring_byte c
    end
  end
  ret fs_hend st
end

fn gc_jstring_byte c uchar to void
  if eq c 92
    if gc_jat_end
      gc_f gc_j_badesc
    end
    e = gc_jcur
    gc_jset add gc_jpos 1
    if and and ne e 34 ne e 92 ne e 47
      gc_fb
      fs_ps 9 gc_j_esc1
      fs_pc 9 e
      fs_ps 9 gc_j_esc2
      gc_die
    end
    fs_hc e
    ret
  end
  if or lt c 32 gt c 126
    gc_fnt gc_j_nonpr sub gc_jpos 1 gc_t_empty
  end
  fs_hc c
end

fn gc_isdig c uchar to bool
  ret and ge c 48 le c 57
end

note key bytes [a-z0-9_]
fn gc_keyok k ulong to bool
  n = fs_hlen k
  for i ulong n bound 64
    c = fs_hb k i
    ok = false
    if and ge c 97 le c 122
      ok = true
    end
    if gc_isdig c
      ok = true
    end
    if eq c 95
      ok = true
    end
    if not ok
      ret false
    end
  end
  ret true
end

note path + "." + key (no "." for the root), refused when 192 bytes or longer
fn gc_child path ulong k ulong to ulong
  c = uchar 46
  if eq fs_hlen path 0
    c = uchar 0
  end
  r = gc_join path c k
  if ge fs_hlen r 192
    gc_f gc_j_plong
  end
  ret r
end

fn gc_jobject path ulong norm ulong depth ulong to void
  gc_jadd path norm 111 0
  gc_jset add gc_jpos 1
  keys = new ulong 128 0
  nk = ulong 0
  gc_jws
  if eq gc_jcur 125
    gc_fb
    fs_ps 9 gc_j_emptyo
    gc_pathname 9 path
    gc_die
  end
  going = true
  while going bound 1000000
    gc_jws
    k = gc_jstring
    gc_jkey_check path k view keys nk
    put keys nk k
    nk = add nk 1
    gc_jws
    if ne gc_jcur 58
      gc_fht gc_j_colon1 k gc_t_quote
    end
    gc_jset add gc_jpos 1
    cp = gc_child path k
    cn = gc_child norm k
    gc_jvalue cp cn add depth 1
    gc_jws
    going = gc_jobj_next path
  end
end

note after a member: true at ',' (consumed), false at '}' (consumed), else refused
fn gc_jobj_next path ulong to bool
  c = gc_jcur
  if eq c 44
    gc_jset add gc_jpos 1
    ret true
  end
  if eq c 125
    gc_jset add gc_jpos 1
    ret false
  end
  gc_fb
  fs_ps 9 gc_j_ocomma
  gc_pathname 9 path
  gc_die
  ret false
end

fn gc_jkey_check path ulong k ulong keys view ulong 128 nk ulong to void
  kl = fs_hlen k
  if or lt kl 1 gt kl 40
    gc_fht gc_j_keylen path gc_t_empty
  end
  if not gc_keyok k
    gc_fht gc_j_key1 k gc_j_key2
  end
  for i ulong nk bound 128
    if fs_heq get keys i k
      gc_fb
      fs_ps 9 gc_j_dup1
      fs_ph 9 k
      fs_ps 9 gc_j_dup2
      gc_pathname 9 path
      gc_die
    end
  end
  if eq nk 128
    gc_fht gc_j_many path gc_t_empty
  end
end

fn gc_jarray path ulong norm ulong depth ulong to void
  gc_jadd path norm 97 0
  gc_jset add gc_jpos 1
  gc_jws
  if eq gc_jcur 93
    gc_fht gc_j_emptya path gc_t_empty
  end
  cn = gc_join norm 0 gc_ht gc_t_brk
  if ge fs_hlen cn 192
    gc_f gc_j_plong
  end
  idx = ulong 0
  going = true
  while going bound 1000000
    cp = gc_aelem path idx
    gc_jws
    gc_jvalue cp cn add depth 1
    gc_jws
    going = gc_jarr_next path
    idx = add idx 1
  end
end


note path + "[" idx "]", refused when 192 bytes or longer
fn gc_aelem path ulong idx ulong to ulong
  st = fs_htop
  fs_hcopy path
  fs_hc uchar 91
  k = fs_digits idx
  while gt k 0 bound 24
    k = sub k 1
    fs_hc get fs_dig k
  end
  fs_hc uchar 93
  r = fs_hend st
  if ge fs_hlen r 192
    gc_f gc_j_plong
  end
  ret r
end

fn gc_jarr_next path ulong to bool
  c = gc_jcur
  if eq c 44
    gc_jset add gc_jpos 1
    ret true
  end
  if eq c 93
    gc_jset add gc_jpos 1
    ret false
  end
  gc_fht gc_j_acomma path gc_t_empty
  ret false
end

note the json bytes at the position equal text t (and fit)
fn gc_jlit t view uchar * to bool
  p = gc_jpos
  n = len t
  if lt sub gc_jn p n
    ret false
  end
  for i ulong n bound 8
    if ne get gc_jb add p i get t i
      ret false
    end
  end
  ret true
end

fn gc_jvalue path ulong norm ulong depth ulong to void
  if gt depth 8
    gc_f gc_j_deep
  end
  gc_jws
  if gc_jat_end
    gc_f gc_j_end
  end
  c = gc_jcur
  if eq c 123
    gc_jobject path norm depth
    ret
  end
  if eq c 91
    gc_jarray path norm depth
    ret
  end
  if eq c 34
    s = gc_jstring
    gc_jadd path norm 115 s
    ret
  end
  if gc_jliteral path norm gc_t_true 98
    ret
  end
  if gc_jliteral path norm gc_t_false 98
    ret
  end
  if gc_jliteral path norm gc_t_null 122
    ret
  end
  gc_jnumber path norm
end

fn gc_jliteral path ulong norm ulong t view uchar * ty uchar to bool
  if not gc_jlit t
    ret false
  end
  gc_jset add gc_jpos len t
  gc_jadd path norm ty gc_ht t
  ret true
end

note number: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?
fn gc_jnumber path ulong norm ulong to void
  st = gc_jpos
  isint = true
  if eq gc_jcur 45
    gc_jset add gc_jpos 1
  end
  c = gc_jcur
  if and not gc_jat_end eq c 48
    gc_jset add gc_jpos 1
  else
    if and not gc_jat_end and ge c 49 le c 57
      gc_jdigits
    else
      gc_fht gc_j_badval path gc_t_empty
    end
  end
  if and not gc_jat_end eq gc_jcur 46
    isint = false
    gc_jset add gc_jpos 1
    gc_jneed_digit path
    gc_jdigits
  end
  c = gc_jcur
  if and not gc_jat_end or eq c 101 eq c 69
    isint = false
    gc_jset add gc_jpos 1
    c = gc_jcur
    if and not gc_jat_end or eq c 43 eq c 45
      gc_jset add gc_jpos 1
    end
    gc_jneed_digit path
    gc_jdigits
  end
  ty = uchar 110
  if isint
    ty = uchar 105
  end
  gc_jadd path norm ty gc_jraw st gc_jpos
end

fn gc_jneed_digit path ulong to void
  if or gc_jat_end not gc_isdig gc_jcur
    gc_fht gc_j_badnum path gc_t_empty
  end
end

fn gc_jdigits to void
  while and not gc_jat_end gc_isdig gc_jcur bound 16777216
    gc_jset add gc_jpos 1
  end
end

note json bytes [a..b) as a heap string
fn gc_jraw a ulong b ulong to ulong
  st = fs_htop
  for i ulong sub b a bound 16777216
    fs_hc get gc_jb add a i
  end
  ret fs_hend st
end

note ---- entries --------------------------------------------------------------------------------

note entry index + 1 of the value at path h, 0 when absent
fn gc_get h ulong to ulong
  n = get gc_st 0
  for i ulong n bound 1024
    if fs_heq get gc_ep i h
      ret add i 1
    end
  end
  ret 0
end

fn gc_gett t view uchar * to ulong
  ret gc_get gc_ht t
end

fn gc_type e ulong to uchar
  ret get gc_et sub e 1
end

fn gc_raw e ulong to ulong
  ret get gc_er sub e 1
end

note string value at path h, refused when missing or not a string
fn gc_str h ulong to ulong
  e = gc_get h
  if eq e 0
    gc_fht gc_t_empty h gc_m_notstr
  end
  if ne gc_type e 115
    gc_fht gc_t_empty h gc_m_notstr
  end
  ret gc_raw e
end


fn gc_strt t view uchar * to ulong
  ret gc_str gc_ht t
end

note number of direct elements path[N] of the array at path h
fn gc_count h ulong to ulong
  pre = gc_join h 91 fs_pack fs_htop 0
  pl = fs_hlen pre
  n = ulong 0
  m = get gc_st 0
  for i ulong m bound 1024
    p = get gc_ep i
    if gc_hstarts p pre
      if gc_direct p pl
        n = add n 1
      end
    end
  end
  ret n
end

note the rest of p after byte pl holds a ']' and nothing after its first ']' is '.' or '['
fn gc_direct p ulong pl ulong to bool
  n = fs_hlen p
  i = pl
  while lt i n bound 1024
    if eq fs_hb p i 93
      break
    end
    i = add i 1
  end
  if ge i n
    ret false
  end
  j = add i 1
  while lt j n bound 1024
    c = fs_hb p j
    if or eq c 46 eq c 91
      ret false
    end
    j = add j 1
  end
  ret true
end

fn gc_countt t view uchar * to ulong
  ret gc_count gc_ht t
end

fn gc_hex64 h ulong to bool
  ret fs_hex64_ok h
end

note safe relative path: 1..160 bytes, no leading '/', components [A-Za-z0-9._-]+ other than "." and ".."
fn gc_safe_rel p ulong to bool
  n = fs_hlen p
  if or lt n 1 gt n 160
    ret false
  end
  if eq fs_hb p 0 47
    ret false
  end
  c = ulong 0
  while lt c n bound 1024
    e = c
    while lt e n bound 1024
      if eq fs_hb p e 47
        break
      end
      e = add e 1
    end
    if not gc_safe_comp p c sub e c
      ret false
    end
    c = e
    if lt c n
      c = add c 1
    end
  end
  ret true
end

fn gc_safe_comp p ulong c ulong l ulong to bool
  if eq l 0
    ret false
  end
  if and eq l 1 eq fs_hb p c 46
    ret false
  end
  if and eq l 2 and eq fs_hb p c 46 eq fs_hb p add c 1 46
    ret false
  end
  for i ulong l bound 1024
    ch = fs_hb p add c i
    if not gc_pathch ch
      ret false
    end
  end
  ret true
end

fn gc_pathch ch uchar to bool
  if and ge ch 97 le ch 122
    ret true
  end
  if and ge ch 65 le ch 90
    ret true
  end
  if gc_isdig ch
    ret true
  end
  ret or or eq ch 46 eq ch 95 eq ch 45
end

note sha256 hex (heap string) of root/rel when it is a regular file, else 0
fn gc_file_sha rel ulong to ulong
  full = gc_full rel
  n = fs_hlen full
  if gt n 4095
    ret 0
  end
  r = stat fs_hp fs_hoff full n gc_stb 0 128
  if lt r 0
    ret 0
  end
  mode = or or shl uint get gc_stb 17 8 uint get gc_stb 16 shl uint get gc_stb 18 16
  if ne and mode 61440 32768
    ret 0
  end
  ln = fs_slurp full
  if lt ln 0
    ret 0
  end
  m = bitcast ulong ln
  for i ulong m bound 16777216
    put sh_dat i get fs_fb i
  end
  sh_all m
  ret fs_hdigest
end

note read a gen-meta file root/rel into set s, all tasks of split want
fn gc_read_meta rel ulong s ulong want ulong to void
  full = gc_full rel
  if not fs_read full s
    gc_fb
    fs_pb 9 2
    gc_die
  end
  if ne get fs_sis s 0
    gc_fht gc_t_empty rel gc_m_wrongsplit
  end
  b = fs_set_start s
  n = fs_set_n s
  for i ulong n bound 8192
    m = add b i
    sp = get fs_msplit m
    if ne sp want
      gc_fb
      fs_ph 9 rel
      fs_ps 9 gc_m_task1
      fs_ph 9 get fs_mid m
      fs_ps 9 gc_m_task2
      fs_psplit 9 sp
      fs_ps 9 gc_m_task3
      fs_psplit 9 want
      gc_die
    end
  end
end


note read root/rel into set s, refused with the reader's reason
fn gc_read_into rel ulong s ulong to void
  if not fs_read gc_full rel s
    gc_fb
    fs_pb 9 2
    gc_die
  end
end

note ---- manifest --------------------------------------------------------------------------------

fn gc_load_json path ulong to void
  n = fs_slurp path
  if lt n 0
    gc_fht gc_m_cannot path gc_t_empty
  end
  m = bitcast ulong n
  for i ulong m bound 16777216
    put gc_jb i get fs_fb i
  end
  put gc_st 4 m
  put gc_st 3 0
  for i ulong m bound 16777216
    if eq get gc_jb i 0
      gc_f gc_j_nul
    end
  end
  for i ulong m bound 16777216
    b = get gc_jb i
    if and and ne b 10 ne b 9 or lt b 32 gt b 126
      gc_fb
      fs_ps 9 gc_j_byte1
      gc_hex2 9 b
      fs_ps 9 gc_t_at
      fs_pu 9 i
      fs_ps 9 gc_j_byte2
      gc_die
    end
  end
end


fn gc_parse_json to void
  gc_jws
  if or gc_jat_end ne gc_jcur 123
    gc_f gc_j_top
  end
  e = fs_pack fs_htop 0
  gc_jvalue e e 0
  gc_jws
  if ne gc_jpos gc_jn
    gc_f gc_j_trail
  end
end

note schema row index + 1 whose norm equals h, 0 when none
fn gc_schema_row h ulong to ulong
  n = get gc_st 8
  for k ulong n bound 256
    if fs_heq get gc_skn k h
      ret add k 1
    end
  end
  ret 0
end

fn gc_check_schema to void
  n = get gc_st 0
  for i ulong n bound 1024
    k = gc_schema_row get gc_en i
    if eq k 0
      gc_fht gc_m_unknown get gc_ep i gc_t_empty
    end
    ty = get gc_et i
    if not fs_hhas get gc_skt sub k 1 ty
      gc_fb
      fs_ph 9 get gc_ep i
      fs_ps 9 gc_m_type1
      fs_pc 9 ty
      fs_ps 9 gc_m_type2
      fs_ph 9 get gc_skt sub k 1
      gc_die
    end
  end
  for i ulong n bound 1024
    if eq get gc_et i 111
      gc_check_members i
    end
  end
  fs_ps 8 gc_ok_schema1
  fs_pu 8 n
  fs_ps 8 gc_ok_schema2
end

note every key the schema lists directly under the object entry i is present
fn gc_check_members i ulong to void
  norm = get gc_en i
  nl = fs_hlen norm
  n = get gc_st 8
  for k ulong n bound 256
    kn = get gc_skn k
    rest = gc_member_rest kn norm
    if ne rest 0
      want = gc_child_any get gc_ep i nl rest
      if eq gc_get want 0
        gc_fht gc_m_missing want gc_t_empty
      end
    end
  end
end

note the key of schema norm kn directly under object norm (packed heap string), 0 when kn is not one
fn gc_member_rest kn ulong norm ulong to ulong
  nl = fs_hlen norm
  rest = kn
  if gt nl 0
    if not gc_hstarts kn norm
      ret 0
    end
    if ne fs_hb kn nl 46
      ret 0
    end
    rest = fs_hdrop kn add nl 1
  end
  if eq fs_hlen rest 0
    ret 0
  end
  if fs_hhas rest 46
    ret 0
  end
  if fs_hhas rest 91
    ret 0
  end
  ret rest
end

note path + ("." when the object's norm is not the root) + rest, refused when 384 bytes or longer
fn gc_child_any path ulong nl ulong rest ulong to ulong
  c = uchar 46
  if eq nl 0
    c = uchar 0
  end
  r = gc_join path c rest
  if ge fs_hlen r 384
    gc_f gc_j_plong
  end
  ret r
end

fn gc_check_fixed to void
  n = get gc_st 9
  for i ulong n bound 256
    p = get gc_fxp i
    e = gc_get p
    if eq e 0
      gc_fht gc_m_mfrozen p gc_t_empty
    end
    raw = gc_raw e
    ok = false
    if ne raw 0
      ok = fs_heq raw get gc_fxr i
    end
    if not ok
      gc_fb
      fs_ph 9 p
      fs_ps 9 gc_m_chg1
      if eq raw 0
        fs_ps 9 gc_t_container
      else
        fs_ph 9 raw
      end
      fs_ps 9 gc_m_chg2
      fs_ph 9 get gc_fxr i
      fs_ps 9 gc_m_chg3
      gc_die
    end
  end
  m = get gc_st 11
  for i ulong m bound 16
    c = gc_count get gc_flp i
    if ne c get gc_fln i
      gc_fb
      fs_ph 9 get gc_flp i
      fs_ps 9 gc_m_elems1
      fs_pu 9 c
      fs_ps 9 gc_m_elems2
      fs_pu 9 get gc_fln i
      gc_die
    end
  end
  fs_ps 8 gc_ok_fixed1
  fs_pu 8 n
  fs_ps 8 gc_ok_fixed2
end

fn gc_check_pins to void
  np = gc_countt gc_k_pins
  prev = fs_pack fs_htop 0
  for i ulong np bound 1024
    kp = gc_key gc_k_pinsi i gc_k_path
    ks = gc_key gc_k_pinsi i gc_k_sha
    path = gc_str kp
    want = gc_str ks
    if not gc_safe_rel path
      gc_fb
      fs_ph 9 kp
      fs_ps 9 gc_m_unsafe1
      fs_ph 9 path
      fs_pc 9 uchar 34
      gc_die
    end
    if gt i 0
      if ge fs_hcmp prev path 0
        gc_fht gc_m_asc1 path gc_m_asc2
      end
    end
    prev = path
    gc_pin_hash path want ks
  end
  m = get gc_st 10
  for k ulong m bound 64
    if not gc_pinned get gc_mp k np
      gc_fht gc_m_req1 get gc_mp k gc_m_req2
    end
  end
  fs_ps 8 gc_ok_pins1
  fs_pu 8 np
  fs_ps 8 gc_ok_pins2
end

fn gc_pin_hash path ulong want ulong ks ulong to void
  if not gc_hex64 want
    gc_fht gc_t_empty ks gc_m_hex64
  end
  sha = gc_file_sha path
  if eq sha 0
    gc_fht gc_m_pinmiss path gc_t_empty
  end
  if not fs_heq sha want
    gc_fb
    fs_ps 9 gc_m_drift
    fs_ph 9 path
    fs_ps 9 gc_m_is
    fs_ph 9 sha
    fs_ps 9 gc_m_pinned
    fs_ph 9 want
    gc_die
  end
end

fn gc_pinned must ulong np ulong to bool
  for i ulong np bound 1024
    if fs_heq gc_str gc_key gc_k_pinsi i gc_k_path must
      ret true
    end
  end
  ret false
end

fn gc_hex40 h ulong to bool
  if ne fs_hlen h 40
    ret false
  end
  for i ulong 40
    c = fs_hb h i
    if not or gc_isdig c and ge c 97 le c 102
      ret false
    end
  end
  ret true
end

fn gc_check_ifaces to void
  ni = gc_countt gc_k_ifaces
  for i ulong ni bound 1024
    gc_check_iface i
  end
end

fn gc_check_iface i ulong to void
  name = gc_str gc_key gc_k_ifacesi i gc_k_name
  for j ulong i bound 1024
    if fs_heq gc_str gc_key gc_k_ifacesi j gc_k_name name
      gc_fht gc_m_ifdup name gc_t_empty
    end
  end
  k = gc_key gc_k_ifacesi i gc_k_path
  path = gc_str k
  if not gc_safe_rel path
    gc_fb
    fs_ph 9 k
    fs_pc 9 uchar 58
    fs_pc 9 uchar 32
    fs_ps 9 gc_m_unsafe
    gc_die
  end
  k = gc_key gc_k_ifacesi i gc_k_commit
  if not gc_hex40 gc_str k
    gc_fht gc_t_empty k gc_m_commit
  end
  k = gc_key gc_k_ifacesi i gc_k_sha
  want = gc_str k
  if not gc_hex64 want
    gc_fht gc_t_empty k gc_m_hex64
  end
  gc_iface_hash name path want
end

fn gc_iface_hash name ulong path ulong want ulong to void
  sha = gc_file_sha path
  if eq sha 0
    if ne get gc_st 1 0
      gc_fb
      fs_ps 9 gc_m_iface
      fs_ph 9 name
      fs_pc 9 uchar 58
      fs_pc 9 uchar 32
      fs_ph 9 path
      fs_ps 9 gc_m_notin
      gc_die
    end
    fs_ps 8 gc_ok_if1
    fs_ph 8 name
    fs_pc 8 uchar 58
    fs_pc 8 uchar 32
    fs_ph 8 path
    fs_ps 8 gc_ok_ifpend
    fs_ph 8 fs_pack fs_hoff want 16
    fs_ps 8 gc_ok_ifdots
    ret
  end
  if not fs_heq sha want
    gc_fb
    fs_ps 9 gc_m_drift
    fs_ps 9 gc_m_iface
    fs_ph 9 name
    fs_ps 9 gc_m_iffile
    fs_ph 9 path
    fs_ps 9 gc_m_is
    fs_ph 9 sha
    fs_ps 9 gc_m_pinned
    fs_ph 9 want
    gc_die
  end
  fs_ps 8 gc_ok_if1
  fs_ph 8 name
  fs_pc 8 uchar 58
  fs_pc 8 uchar 32
  fs_ph 8 path
  fs_ps 8 gc_ok_ifmatch
end

note dev split: META digest, task list = META ids = case directories, families = META signatures
fn gc_check_dev to void
  devmeta = gc_strt gc_k_devmeta
  sha = gc_file_sha devmeta
  if eq sha 0
    gc_fht gc_m_devmiss devmeta gc_t_empty
  end
  dms = gc_strt gc_k_devms
  if not gc_hex64 dms
    gc_fht gc_k_devms fs_pack fs_htop 0 gc_m_hex64
  end
  if not fs_heq sha dms
    gc_fb
    fs_ps 9 gc_m_drift
    fs_ph 9 devmeta
    fs_ps 9 gc_m_is
    fs_ph 9 sha
    fs_ps 9 gc_m_devms
    fs_ph 9 dms
    gc_die
  end
  if not gc_hex64 gc_strt gc_k_devpack
    gc_fht gc_k_devpack fs_pack fs_htop 0 gc_m_hex64
  end
  dev = fs_set_new
  put gc_st 6 dev
  gc_read_meta devmeta dev 1
  nt = gc_check_dev_tasks
  gc_check_dev_ids dev nt
  gc_check_cases nt
  gc_check_dev_fams dev nt
end

note splits.dev.tasks: 10 valid ids, strictly ascending; the count
fn gc_check_dev_tasks to ulong
  nt = gc_countt gc_k_devtasks
  if ne nt 10
    gc_fnt gc_m_ntasks1 nt gc_m_ntasks2
  end
  prev = ulong 0
  for i ulong nt bound 1024
    k = gc_key gc_k_devtasksi i gc_k_close
    id = gc_str k
    if not fs_task_id_ok id
      gc_fht gc_t_empty k gc_m_badid
    end
    if gt i 0
      if ge fs_hcmp prev id 0
        gc_fht gc_m_unsorted id gc_t_empty
      end
    end
    prev = id
  end
  ret nt
end

fn gc_task i ulong to ulong
  ret gc_str gc_key gc_k_devtasksi i gc_k_close
end

fn gc_check_dev_ids dev ulong nt ulong to void
  b = fs_set_start dev
  n = fs_set_n dev
  if ne n nt
    gc_fb
    fs_ps 9 gc_m_devn1
    fs_pu 9 n
    fs_ps 9 gc_m_devn2
    fs_pu 9 nt
    gc_die
  end
  for i ulong n bound 8192
    put fs_ix i get fs_mid add b i
  end
  fs_sort_ix n
  for i ulong nt bound 1024
    t = gc_task i
    if not fs_heq get fs_ix i t
      gc_fb
      fs_ps 9 gc_m_iddiff1
      fs_ph 9 get fs_ix i
      fs_ps 9 gc_m_iddiff2
      fs_ph 9 t
      fs_pc 9 uchar 41
      gc_die
    end
    if gt i 0
      if fs_heq get fs_ix i get fs_ix sub i 1
        gc_fht gc_m_iddup get fs_ix i gc_t_empty
      end
    end
  end
end

note the entries of the cases directory (all but "." and ".."), sorted, against splits.dev.tasks
fn gc_check_cases nt ulong to void
  rel = gc_strt gc_k_devcases
  full = gc_full rel
  n = fs_hlen full
  fd = long -1
  if le n 4095
    fd = fopen fs_hp fs_hoff full n 16384 0
  end
  if lt fd 0
    gc_fht gc_m_opendir rel gc_t_empty
  end
  nc = gc_read_dir int fd
  ign = fclose int fd
  for i ulong nc bound 512
    put fs_ix i get gc_cs i
  end
  fs_sort_ix nc
  if ne nc nt
    gc_fb
    fs_ps 9 gc_m_ncases1
    fs_pu 9 nc
    fs_ps 9 gc_m_ncases2
    fs_pu 9 nt
    gc_die
  end
  for i ulong nc bound 512
    t = gc_task i
    if not fs_heq get fs_ix i t
      gc_fb
      fs_ps 9 gc_m_case1
      fs_ph 9 get fs_ix i
      fs_ps 9 gc_m_case2
      fs_ph 9 t
      fs_pc 9 uchar 41
      gc_die
    end
  end
end

note directory entry names (heap strings) into gc_cs; the count (more than 256 refused)
fn gc_read_dir fd int to ulong
  nc = ulong 0
  going = true
  while going bound 1000000
    r = getdnts fd gc_db 0 65536
    if le r 0
      going = false
    else
      nc = gc_dir_records bitcast ulong r nc
    end
  end
  ret nc
end

fn gc_dir_records r ulong nc0 ulong to ulong
  nc = nc0
  p = ulong 0
  while lt p r bound 65536
    rl = or ulong get gc_db add p 16 shl ulong get gc_db add p 17 8
    nm = gc_dir_name add p 19
    if not gc_dot nm
      if eq nc 256
        gc_f gc_m_manydir
      end
      put gc_cs nc nm
      nc = add nc 1
    end
    if eq rl 0
      ret nc
    end
    p = add p rl
  end
  ret nc
end

fn gc_dir_name o ulong to ulong
  st = fs_htop
  p = o
  while lt p 65536 bound 65536
    c = get gc_db p
    if eq c 0
      break
    end
    fs_hc c
    p = add p 1
  end
  ret fs_hend st
end

note "." or ".."
fn gc_dot h ulong to bool
  n = fs_hlen h
  if eq n 1
    ret eq fs_hb h 0 46
  end
  if eq n 2
    ret and eq fs_hb h 0 46 eq fs_hb h 1 46
  end
  ret false
end

fn gc_check_dev_fams dev ulong nt ulong to void
  b = fs_set_start dev
  n = fs_set_n dev
  ns = ulong 0
  for i ulong n bound 8192
    sg = get fs_msig add b i
    if not gc_in_ix sg ns
      if eq ns 64
        gc_f gc_m_manyfam
      end
      put fs_ix ns sg
      ns = add ns 1
    end
  end
  fs_sort_ix ns
  nf = gc_countt gc_k_devfams
  if ne nf ns
    gc_fb
    fs_ps 9 gc_m_nfam1
    fs_pu 9 nf
    fs_ps 9 gc_m_nfam2
    fs_pu 9 ns
    fs_ps 9 gc_m_nfam3
    gc_die
  end
  for i ulong nf bound 64
    f = gc_str gc_key gc_k_devfamsi i gc_k_close
    if not fs_heq f get fs_ix i
      gc_fb
      fs_ps 9 gc_m_fam1
      fs_pu 9 i
      fs_ps 9 gc_m_fam2
      fs_ph 9 f
      fs_ps 9 gc_m_fam3
      fs_ph 9 get fs_ix i
      gc_die
    end
  end
  fs_ps 8 gc_ok_dev1
  fs_pu 8 nt
  fs_ps 8 gc_ok_dev2
  fs_pu 8 nf
  fs_ps 8 gc_ok_dev3
  gc_print_fams nf
end

fn gc_in_ix sg ulong ns ulong to bool
  for j ulong ns bound 64
    if fs_heq get fs_ix j sg
      ret true
    end
  end
  ret false
end

note "ok dev family <token> <sig>" for the sorted families in fs_ix (copied first: the token hashing
note does not touch fs_ix, but the copy keeps the order independent of it)
fn gc_print_fams nf ulong to void
  sigs = new ulong 64 0
  for i ulong nf bound 64
    put sigs i get fs_ix i
  end
  for i ulong nf bound 64
    s = get sigs i
    fs_ps 8 gc_ok_devfam
    fs_ph 8 fs_token s
    fs_pc 8 uchar 32
    fs_ph 8 s
    fs_pc 8 uchar 10
  end
end

note the pre-freeze nulls: every record-set field must still be null while the corpus META is
fn gc_check_prefreeze to void
  p = ulong 0
  while lt p len gc_pre6 bound 1024
    k = gc_tline gc_pre6 p
    if ne gc_type gc_get k 122
      gc_fht gc_t_empty k gc_m_setnf
    end
    p = add add p fs_hlen k 1
  end
end

fn gc_check_corpus to void
  devmeta = gc_strt gc_k_devmeta
  cm = gc_gett gc_k_cms
  if eq gc_type cm 122
    put gc_st 5 0
    gc_check_prefreeze
    both = fs_set_new
    gc_read_into devmeta both
    if ne fs_rule both false 0
      gc_f gc_m_rdev
    end
    fs_ps 8 gc_ok_cpend
    ret
  end
  put gc_st 5 1
  cmeta = gc_strt gc_k_cmeta
  cms = gc_raw cm
  if not gc_hex64 cms
    gc_f gc_m_cmshex
  end
  sha = gc_file_sha cmeta
  if eq sha 0
    gc_fht gc_m_cmiss cmeta gc_t_empty
  end
  if not fs_heq sha cms
    gc_fb
    fs_ps 9 gc_m_drift
    fs_ph 9 cmeta
    fs_ps 9 gc_m_is
    fs_ph 9 sha
    fs_ps 9 gc_m_cms
    fs_ph 9 cms
    gc_die
  end
  gc_check_corpus_rule devmeta cmeta
end

fn gc_check_corpus_rule devmeta ulong cmeta ulong to void
  corpus = fs_set_new
  put gc_st 7 corpus
  gc_read_meta cmeta corpus 0
  both = fs_set_new
  gc_read_into devmeta both
  gc_read_into cmeta both
  if ne fs_rule both false 0
    gc_f gc_m_rdc
  end
  fs_ps 8 gc_ok_c1
  fs_pu 8 fs_set_n corpus
  fs_ps 8 gc_ok_c2
  pi = gc_gett gc_k_pids
  if eq gc_type pi 97
    gc_check_prefix corpus
  end
end

fn gc_check_prefix corpus ulong to void
  n = gc_countt gc_k_pids
  if ne n 14
    gc_fnt gc_m_pids1 n gc_m_pids2
  end
  for i ulong n bound 1024
    k = gc_key gc_k_pidsi i gc_k_close
    id = gc_str k
    if not gc_in_set corpus id
      gc_fb
      fs_ph 9 k
      fs_pc 9 uchar 58
      fs_pc 9 uchar 32
      fs_ph 9 id
      fs_ps 9 gc_m_notc
      gc_die
    end
    for j ulong i bound 1024
      if fs_heq gc_str gc_key gc_k_pidsi j gc_k_close id
        gc_fht gc_m_piddup id gc_t_empty
      end
    end
  end
end

fn gc_in_set s ulong id ulong to bool
  b = fs_set_start s
  n = fs_set_n s
  for j ulong n bound 8192
    if fs_heq get fs_mid add b j id
      ret true
    end
  end
  ret false
end

fn gc_check_opt to void
  p = ulong 0
  while lt p len gc_opt5 bound 1024
    k = gc_tline gc_opt5 p
    e = gc_get k
    if eq gc_type e 115
      if not gc_hex64 gc_raw e
        gc_fht gc_t_empty k gc_m_hex64
      end
    end
    p = add add p fs_hlen k 1
  end
end

note C and D record-set manifests: path and digest both null (not frozen) or both set and re-hashed
fn gc_check_rs pk view uchar * hk view uchar * to void
  pe = gc_gett pk
  he = gc_gett hk
  pz = eq gc_type pe 122
  hz = eq gc_type he 122
  if ne pz hz
    gc_fb
    fs_ps 9 pk
    fs_ps 9 gc_m_both1
    fs_ps 9 hk
    fs_ps 9 gc_m_both2
    gc_die
  end
  if pz
    ret
  end
  p = gc_raw pe
  if not gc_safe_rel p
    gc_fb
    fs_ps 9 pk
    fs_pc 9 uchar 58
    fs_pc 9 uchar 32
    fs_ps 9 gc_m_unsafe
    gc_die
  end
  gc_check_rs_hash p hk gc_raw he
end

fn gc_check_rs_hash p ulong hk view uchar * h ulong to void
  sha = gc_file_sha p
  if eq sha 0
    gc_fht gc_m_rsmiss p gc_t_empty
  end
  if not fs_heq sha h
    gc_fb
    fs_ps 9 gc_m_rsdrift
    fs_ph 9 p
    fs_ps 9 gc_m_is
    fs_ph 9 sha
    fs_pc 9 uchar 44
    fs_pc 9 uchar 32
    fs_ps 9 hk
    fs_pc 9 uchar 32
    fs_ph 9 h
    gc_die
  end
  fs_ps 8 gc_ok_rs1
  fs_ph 8 p
  fs_ps 8 gc_ok_rs2
end

fn gc_check_manifest json ulong to void
  gc_load_json json
  gc_parse_json
  gc_check_schema
  gc_check_fixed
  gc_check_pins
  gc_check_ifaces
  gc_check_dev
  gc_check_corpus
  gc_check_opt
  gc_check_rs gc_k_raw gc_k_rawsha
  gc_check_rs gc_k_abs gc_k_abssha
end

note ---- split (reviewer, after the seal) -----------------------------------------------------------

note split the text file in fs_fb[0..n) into lines (gc_ln: start offsets), at most max; the count
fn gc_split_lines n ulong max ulong msg view uchar * to ulong
  nl = ulong 0
  s = ulong 0
  while lt s n bound 16777216
    if eq nl max
      gc_f msg
    end
    put gc_ln nl s
    nl = add nl 1
    s = add fs_nl s 1
  end
  ret nl
end

note line i as a heap string
fn gc_line i ulong to ulong
  s = get gc_ln i
  e = fs_nl s
  ret fs_hfromfb s sub e s
end

note read a text file (no NUL, ends in LF, only LF and printable bytes when strict_bytes) into fs_fb
fn gc_read_text path ulong msg view uchar * bytes_msg view uchar * check bool to ulong
  n = fs_slurp path
  if lt n 0
    gc_fht gc_m_cannot path gc_t_empty
  end
  m = bitcast ulong n
  if eq m 0
    gc_f msg
  end
  for i ulong m bound 16777216
    if eq get fs_fb i 0
      gc_f msg
    end
  end
  if ne get fs_fb sub m 1 10
    gc_f msg
  end
  if check
    for i ulong m bound 16777216
      b = get fs_fb i
      if and ne b 10 or lt b 32 gt b 126
        gc_fb
        fs_ps 9 bytes_msg
        gc_hex2 9 b
        gc_die
      end
    end
  end
  ret m
end

note sscanf("<word> %d%c") == 1 on line h after the text t: the int, or -2^63 when sscanf would not give 1
fn gc_scan_int h ulong t view uchar * to long
  n = fs_hlen h
  tl = sub len t 1
  if lt n tl
    ret -9223372036854775808
  end
  for i ulong tl bound 64
    if ne fs_hb h i get t i
      ret -9223372036854775808
    end
  end
  p = tl
  while and lt p n eq fs_hb h p 32 bound 1024
    p = add p 1
  end
  ng = false
  if lt p n
    c = fs_hb h p
    if or eq c 43 eq c 45
      ng = eq c 45
      p = add p 1
    end
  end
  ret gc_scan_digits h p n ng
end

fn gc_scan_digits h ulong p0 ulong n ulong ng bool to long
  p = p0
  st = p
  v = ulong 0
  sat = false
  while lt p n bound 1024
    c = fs_hb h p
    if not gc_isdig c
      break
    end
    d = ulong sub c 48
    if gt v div sub 9223372036854775808 d 10
      sat = true
    else
      v = add mul v 10 d
    end
    p = add p 1
  end
  if or eq p st lt p n
    ret -9223372036854775808
  end
  ret gc_int_of v ng sat
end

note (int) of the strtol value of magnitude v (low 32 bits, as glibc scanf %d stores it)
fn gc_int_of v ulong ng bool sat bool to long
  r = v
  if ng
    if or sat gt r 9223372036854775808
      r = ulong 9223372036854775808
    end
    r = add not r 1
  else
    if or sat gt r 9223372036854775807
      r = ulong 9223372036854775807
    end
  end
  lo = and r 4294967295
  if ge lo 2147483648
    ret sub bitcast long lo 4294967296
  end
  ret bitcast long lo
end

note "<t><decimal v>" equals heap string h
fn gc_canon_num h ulong t view uchar * v long to bool
  st = fs_htop
  fs_hs t
  if lt v 0
    fs_hc uchar 45
  end
  k = fs_digits gc_mag v
  while gt k 0 bound 24
    k = sub k 1
    fs_hc get fs_dig k
  end
  c = fs_hend st
  ret fs_heq c h
end

fn gc_mag v long to ulong
  if lt v 0
    ret add not bitcast ulong v 1
  end
  ret bitcast ulong v
end

fn gc_check_split splitp ulong pubp ulong to void
  if eq get gc_st 5 0
    gc_f gc_s_nocorpus
  end
  if ne gc_type gc_gett gc_k_hpub 115
    gc_f gc_s_nonull
  end
  if ne gc_type gc_gett gc_k_htasks 115
    gc_f gc_s_nonull
  end
  hs = fs_set_new
  if not fs_read splitp hs
    gc_fb
    fs_pb 9 2
    gc_die
  end
  if or eq get fs_sis hs 0 eq fs_set_n hs 0
    gc_fht gc_t_empty splitp gc_s_notsplit
  end
  fs_famlist hs
  famsha = fs_famlist_sha
  nfam = get fs_st 11
  gc_check_pub pubp hs famsha nfam
  gc_check_all splitp
end

fn gc_check_pub pubp ulong hs ulong famsha ulong nfam ulong to void
  m = gc_read_text pubp gc_s_pubtext gc_s_pubbyte true
  for i ulong m bound 16777216
    put sh_dat i get fs_fb i
  end
  sh_all m
  pubsha = fs_hdigest
  nl = gc_split_lines m 4096 gc_s_publines
  gc_check_pub_head nl
  ntasks = gc_check_pub_counts nl
  gc_check_pub_tasks ntasks
  gc_check_pub_match hs famsha nfam ntasks
  gc_check_pub_proto hs nfam pubsha
end

fn gc_check_pub_head nl ulong to void
  if lt nl 6
    gc_f gc_s_l1
  end
  if not fs_hist gc_line 0 gc_s_hpub1
    gc_f gc_s_l1
  end
  gc_check_pub_hex 1 gc_s_h1
  gc_check_pub_hex 2 gc_s_h2
  gc_check_pub_hex 3 gc_s_h3
end

fn gc_check_pub_hex i ulong t view uchar * to void
  l = gc_line i
  ok = gc_hstartt l t
  if ok
    ok = gc_hex64 fs_hdrop l len t
  end
  if not ok
    gc_fb
    fs_ps 9 gc_s_lmust1
    fs_pu 9 add i 1
    fs_ps 9 gc_s_lmust2
    fs_ps 9 t
    fs_ps 9 gc_s_lmust3
    gc_die
  end
end

note lines 5 and 6: "tasks <n>" and "families <m>", n, m >= 1, canonical; line count = 6 + n; returns n
fn gc_check_pub_counts nl ulong to ulong
  l5 = gc_line 4
  l6 = gc_line 5
  nt = gc_scan_int l5 gc_s_tasks
  if lt nt 1
    gc_f gc_s_l5
  end
  nf = gc_scan_int l6 gc_s_fams
  if lt nf 1
    gc_f gc_s_l6
  end
  if not gc_canon_num l5 gc_s_tasks nt
    gc_f gc_s_l5c
  end
  if not gc_canon_num l6 gc_s_fams nf
    gc_f gc_s_l6c
  end
  put gc_st 12 bitcast ulong nf
  if ne nl add 6 bitcast ulong nt
    gc_fb
    fs_ps 9 gc_s_ntl1
    fs_pi 9 sub bitcast long nl 6
    fs_ps 9 gc_s_ntl2
    fs_pi 9 nt
    gc_die
  end
  ret bitcast ulong nt
end

fn gc_check_pub_tasks nt ulong to void
  prev = ulong 0
  for i ulong nt bound 4096
    l = gc_line add 6 i
    ok = gc_hstartt l gc_s_task
    if ok
      ok = fs_task_id_ok fs_hdrop l 5
    end
    if not ok
      gc_fb
      fs_ps 9 gc_s_lmust1
      fs_pu 9 add 7 i
      fs_ps 9 gc_s_tline2
      gc_die
    end
    id = fs_hdrop l 5
    if gt i 0
      if ge fs_hcmp prev id 0
        gc_fht gc_s_tasc id gc_t_empty
      end
    end
    prev = id
  end
end

fn gc_check_pub_match hs ulong famsha ulong nfam ulong nt ulong to void
  psplit = fs_hdrop gc_line 2 13
  pfam = fs_hdrop gc_line 3 15
  ssha = get fs_ssha hs
  if not fs_heq psplit ssha
    gc_fb
    fs_ps 9 gc_s_ssha1
    fs_ph 9 ssha
    fs_ps 9 gc_s_ssha2
    fs_ph 9 psplit
    gc_die
  end
  if not fs_heq pfam famsha
    gc_fb
    fs_ps 9 gc_s_fsha1
    fs_ph 9 famsha
    fs_ps 9 gc_s_ssha2
    fs_ph 9 pfam
    gc_die
  end
  n = fs_set_n hs
  if ne nt n
    gc_fb
    fs_ps 9 gc_s_nt1
    fs_pu 9 nt
    fs_ps 9 gc_s_nt2
    fs_pu 9 n
    gc_die
  end
  pf = get gc_st 12
  if ne pf nfam
    gc_fb
    fs_ps 9 gc_s_nf1
    fs_pu 9 pf
    fs_ps 9 gc_s_nt2
    fs_pu 9 nfam
    gc_die
  end
  gc_check_pub_ids hs n
end

fn gc_check_pub_ids hs ulong n ulong to void
  b = fs_set_start hs
  for i ulong n bound 8192
    t = fs_hdrop gc_line add 6 i 5
    id = get fs_mid add b i
    if not fs_heq id t
      gc_fb
      fs_ps 9 gc_s_tdiff1
      fs_ph 9 t
      fs_ps 9 gc_s_tdiff2
      fs_ph 9 id
      gc_die
    end
  end
end

note atoi of a manifest raw value (digits only here: the frozen values are checked before)
fn gc_atoi h ulong to ulong
  v = ulong 0
  n = fs_hlen h
  for i ulong n bound 32
    c = fs_hb h i
    if not gc_isdig c
      ret v
    end
    v = add mul v 10 ulong sub c 48
  end
  ret v
end

fn gc_check_pub_proto hs ulong nfam ulong pubsha ulong to void
  n = fs_set_n hs
  wn = gc_atoi gc_raw gc_gett gc_k_hcount
  wf = gc_atoi gc_raw gc_gett gc_k_hminf
  if ne n wn
    gc_fb
    fs_ps 9 gc_s_hn1
    fs_pu 9 n
    fs_ps 9 gc_s_hn2
    fs_pu 9 wn
    gc_die
  end
  if lt nfam wf
    gc_fb
    fs_ps 9 gc_s_hn1
    fs_pu 9 nfam
    fs_ps 9 gc_s_hf2
    fs_pu 9 wf
    gc_die
  end
  e = gc_raw gc_gett gc_k_hpub
  if not fs_heq e pubsha
    gc_fb
    fs_ps 9 gc_s_pubdrift1
    fs_ph 9 pubsha
    fs_ps 9 gc_s_pubdrift2
    fs_ph 9 e
    gc_die
  end
  e = gc_raw gc_gett gc_k_htasks
  pt = fs_hdrop gc_line 1 13
  if not fs_heq e pt
    gc_fb
    fs_ps 9 gc_s_tsha1
    fs_ph 9 pt
    fs_ps 9 gc_s_tsha2
    fs_ph 9 e
    gc_die
  end
  fs_ps 8 gc_ok_pub1
  fs_pu 8 n
  fs_ps 8 gc_ok_pub2
  fs_pu 8 nfam
  fs_ps 8 gc_ok_pub3
end

fn gc_check_all splitp ulong to void
  all = fs_set_new
  gc_read_into gc_strt gc_k_devmeta all
  gc_read_into gc_strt gc_k_cmeta all
  if not fs_read splitp all
    gc_fb
    fs_pb 9 2
    gc_die
  end
  if ne fs_rule all false 0
    gc_f gc_s_rall
  end
  fs_ps 8 gc_ok_all
end

note ---- run-ready and open --------------------------------------------------------------------------

fn gc_check_frozen to void
  n = get gc_st 0
  for i ulong n bound 1024
    if eq get gc_et i 122
      gc_fht gc_f_null1 get gc_ep i gc_f_null2
    end
  end
  ni = gc_countt gc_k_ifaces
  c = gc_strt gc_k_contract
  found = false
  for i ulong ni bound 1024
    if fs_heq gc_str gc_key gc_k_ifacesi i gc_k_name gc_strt gc_k_contract
      found = true
    end
  end
  if not found
    gc_fht gc_f_contract1 c gc_m_req2
  end
  fs_ps 8 gc_ok_rr1
  fs_ph 8 c
  fs_ps 8 gc_ok_rr2
end

fn gc_check_open json ulong openp ulong to void
  n = fs_slurp json
  if lt n 0
    gc_fht gc_m_cannot json gc_t_empty
  end
  m = bitcast ulong n
  for i ulong m bound 16777216
    put sh_dat i get fs_fb i
  end
  sh_all m
  jsha = fs_hdigest
  k = gc_read_text openp gc_o_text gc_s_pubbyte false
  nl = gc_split_lines k 8 gc_o_more
  if ne nl 5
    gc_f gc_o_five
  end
  if not fs_hist gc_line 0 gc_o_head
    gc_f gc_o_five
  end
  v0 = gc_open_val 1 gc_o_k1
  v1 = gc_open_val 2 gc_o_k2
  v2 = gc_open_val 3 gc_o_k3
  v3 = gc_open_val 4 gc_o_k4
  if not gc_hex40 v0
    gc_f gc_o_commit
  end
  gc_open_hex v1 gc_o_k2
  gc_open_hex v2 gc_o_k3
  gc_open_hex v3 gc_o_k4
  gc_open_match jsha v1 v2 v3
end

fn gc_open_val i ulong t view uchar * to ulong
  l = gc_line i
  if not gc_hstartt l t
    gc_fb
    fs_ps 9 gc_o_start1
    fs_pu 9 add i 1
    fs_ps 9 gc_o_start2
    fs_ps 9 t
    fs_pc 9 uchar 34
    gc_die
  end
  ret fs_hdrop l len t
end

fn gc_open_hex v ulong t view uchar * to void
  if not gc_hex64 v
    gc_fb
    fs_ps 9 gc_o_pre
    fs_ps 9 t
    fs_ps 9 gc_o_hex
    gc_die
  end
end

fn gc_open_match jsha ulong v1 ulong v2 ulong v3 ulong to void
  if not fs_heq v1 jsha
    gc_fb
    fs_ps 9 gc_o_psha1
    fs_ph 9 v1
    fs_ps 9 gc_o_psha2
    fs_ph 9 jsha
    gc_die
  end
  if not fs_heq v2 gc_raw gc_gett gc_k_htasks
    gc_f gc_o_tsha
  end
  if not fs_heq v3 gc_raw gc_gett gc_k_hpub
    gc_f gc_o_hsha
  end
  fs_ps 8 gc_ok_open
  fs_ph 8 fs_pack fs_hoff jsha 16
  fs_ps 8 gc_ok_ifdots
end

note ---- main -------------------------------------------------------------------------------------

fn gc_arg idx ulong to ulong
  st = fs_htop
  r = argread idx fs_hp st sub 16777216 st
  if lt r 0
    fs_nomem
  end
  fs_hset add st bitcast ulong r
  ret fs_hend st
end

fn gc_dispatch ac ulong to int
  if lt ac 2
    fs_ps 9 gc_t_usage
    ret 2
  end
  c = gc_arg 1
  if and eq ac 4 fs_hist c gc_c_manifest
    put gc_st 2 gc_arg 3
    gc_check_manifest gc_arg 2
    ret 0
  end
  if and eq ac 4 fs_hist c gc_c_runready
    put gc_st 2 gc_arg 3
    put gc_st 1 1
    gc_check_manifest gc_arg 2
    gc_check_frozen
    ret 0
  end
  if and eq ac 5 fs_hist c gc_c_open
    put gc_st 2 gc_arg 3
    put gc_st 1 1
    j = gc_arg 2
    gc_check_manifest j
    gc_check_frozen
    gc_check_open j gc_arg 4
    ret 0
  end
  if and eq ac 6 fs_hist c gc_c_split
    put gc_st 2 gc_arg 3
    gc_check_manifest gc_arg 2
    gc_check_split gc_arg 4 gc_arg 5
    ret 0
  end
  fs_ps 9 gc_t_usage
  ret 2
end

fn main to int
  gc_init
  rc = gc_dispatch ulong argcnt
  if eq rc 0
    fs_ps 8 gc_t_gpass
  end
  fs_eflush
  fs_oflush
  ret rc
end

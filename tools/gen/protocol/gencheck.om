global gc_st ulong 32
note gc_st: 0 values, 1 strict, 2 root (heap string), 3 json position, 4 json length, 5 corpus frozen,
note 6 dev set, 7 corpus set, 8 schema rows, 9 fixed rows, 10 must-pin rows, 11 fixed-len rows
global gc_jb uchar 16777216

note stdout: fully buffered like glibc stdio on a file or pipe (flushed when 4096 bytes are held, and at exit)
global gs_obuf uchar 4096
global gs_ebuf uchar 4096
global gs_arg uchar 1048576
global gs_st ulong 16
note gs_st: 0 olen, 1 elen, 2..5 mcnemar num hi/lo den hi/lo, 6/7 u128 result hi/lo, 8 remainder, 10 parsed number
note gs_st 11 parse position
global gs_fp f64 16
note gs_fp: 0..2 wilson p lo hi, 3..5 newcombe theta lo hi, 6..9 decision lo95 hi95 lo90 hi90
global gs_t3 f64 144
note Table III of Newcombe (1998): e f g h, method 8 lo hi, method 10 lo hi (95%, 4 decimals as printed)
global gs_digits uchar 64
global gs_vecs uchar 512
global gs_vlen ulong 4
global gs_ds long 4
global gs_dboth long 3
global gs_ddonly long 3
global gs_dxonly long 3
global gs_dneith long 3
global gs_dpn ulong 6
global gs_dpd ulong 6
global gs_dpf f64 3
global gs_dlift ulong 3
global gs_dpok ulong 3
global gs_dmeta long 4
note gs_dmeta: 0 n, 1 a_minus_b, 2 verdict (0 INVALID 1 PASS 2 FAIL 3 INCONCLUSIVE), 3 reasons length
global gs_dreas uchar 256

note ---- output -----------------------------------------------------------------------------------

fn gs_oflush to void
  n = get gs_st 0
  off = ulong 0
  while lt off n bound 1000000
    k = write 1 gs_obuf off sub n off
    if le k 0
      put gs_st 0 0
      ret
    end
    off = add off ulong k
  end
  put gs_st 0 0
end

fn gs_eflush to void
  n = get gs_st 1
  off = ulong 0
  while lt off n bound 1000000
    k = write 2 gs_ebuf off sub n off
    if le k 0
      put gs_st 1 0
      ret
    end
    off = add off ulong k
  end
  put gs_st 1 0
end

fn gs_oc c uchar to void
  p = get gs_st 0
  put gs_obuf p c
  p = add p 1
  put gs_st 0 p
  if ge p 4096
    gs_oflush
  end
end

fn gs_os s view uchar * to void
  n = len s
  for i ulong n bound 1048576
    gs_oc get s i
  end
end

fn gs_ec c uchar to void
  p = get gs_st 1
  if ge p 4096
    gs_eflush
    p = ulong 0
  end
  put gs_ebuf p c
  put gs_st 1 add p 1
end

fn gs_es s view uchar * to void
  n = len s
  for i ulong n bound 1048576
    gs_ec get s i
  end
end

note decimal digits of v into gs_digits (reversed); returns the count
fn gs_udig v ulong to ulong
  if eq v 0
    put gs_digits 0 48
    ret 1
  end
  k = ulong 0
  x = v
  while gt x 0 bound 24
    put gs_digits k uchar add 48 rem x 10
    x = div x 10
    k = add k 1
  end
  ret k
end

fn gs_ou v ulong to void
  k = gs_udig v
  while gt k 0 bound 24
    k = sub k 1
    gs_oc get gs_digits k
  end
end

fn gs_eu v ulong to void
  k = gs_udig v
  while gt k 0 bound 24
    k = sub k 1
    gs_ec get gs_digits k
  end
end

note magnitude of a long as ulong (also for the minimum)
fn gs_mag v long to ulong
  if lt v 0
    ret add not bitcast ulong v 1
  end
  ret bitcast ulong v
end

fn gs_oi v long to void
  if lt v 0
    gs_oc uchar 45
  end
  gs_ou gs_mag v
end

fn gs_ei v long to void
  if lt v 0
    gs_ec uchar 45
  end
  gs_eu gs_mag v
end

note %02u
fn gs_ou2 v ulong to void
  if lt v 10
    gs_oc uchar 48
  end
  gs_ou v
end

fn gs_pow10 nd ulong to ulong
  p = ulong 1
  for i ulong nd bound 20
    p = mul p 10
  end
  ret p
end

note round(|x| * 10^nd) half to even on the exact binary value (|x| * 10^nd below 2^52)
fn gs_fix_round ax f64 nd ulong to ulong
  sc = f64 gs_pow10 nd
  q = ulong mul ax sc
  half = add f64 q 0.5f64
  err = fma ax sc neg half
  if gt err 0.0f64
    ret add q 1
  end
  if eq err 0.0f64
    if eq and q 1 1
      ret add q 1
    end
  end
  ret q
end

note printf "%.<nd>f" of x (|x| * 10^nd below 2^52) to stdout (dst 1) or the stderr line (dst 2)
fn gs_fix x f64 nd ulong dst ulong to void
  neg_x = ne shr bitcast ulong x 63 0
  q = gs_fix_round fabs x nd
  p = gs_pow10 nd
  ip = div q p
  fr = rem q p
  if neg_x
    gs_xc dst uchar 45
  end
  k = gs_udig ip
  while gt k 0 bound 24
    k = sub k 1
    gs_xc dst get gs_digits k
  end
  if eq nd 0
    ret
  end
  gs_xc dst uchar 46
  k = gs_udig fr
  pad = sub nd k
  for i ulong pad bound 20
    gs_xc dst uchar 48
  end
  while gt k 0 bound 24
    k = sub k 1
    gs_xc dst get gs_digits k
  end
end

fn gs_xc dst ulong c uchar to void
  if eq dst 2
    gs_ec c
  else
    gs_oc c
  end
end

fn gs_of10 x f64 to void
  gs_fix x 10 1
end

fn gs_eq a view uchar * b view uchar * to bool
  if ne len a len b
    ret false
  end
  n = len a
  for i ulong n bound 1048576
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

note argument bytes gs_arg[0..n) equal the text t
fn gs_arg_is n ulong t view uchar * to bool
  if ne n len t
    ret false
  end
  for i ulong n bound 1048576
    if ne get gs_arg i get t i
      ret false
    end
  end
  ret true
end

note stderr is unbuffered in the C reference: its line goes out before the buffered stdout bytes
fn gs_exit code int to void
  gs_eflush
  gs_oflush
  exit code
end

note ---- 128-bit unsigned: results in gs_st 6 (hi), 7 (lo), 8 (remainder) ---------------------------

fn gs_u_mul hi ulong lo ulong m ulong to void
  lo_lo = and lo 4294967295
  lo_hi = shr lo 32
  p0 = mul lo_lo m
  p1 = add mul lo_hi m shr p0 32
  rlo = or shl and p1 4294967295 32 and p0 4294967295
  rhi = add mul hi m shr p1 32
  put gs_st 6 rhi
  put gs_st 7 rlo
end

fn gs_u_div hi ulong lo ulong d ulong to void
  qhi = div hi d
  rhi = rem hi d
  t1 = or shl rhi 32 shr lo 32
  q1 = div t1 d
  r1 = rem t1 d
  t0 = or shl r1 32 and lo 4294967295
  q0 = div t0 d
  put gs_st 6 qhi
  put gs_st 7 or shl q1 32 q0
  put gs_st 8 rem t0 d
end

fn gs_u_add ahi ulong alo ulong bhi ulong blo ulong to void
  rlo = add alo blo
  carry = ulong 0
  if lt rlo alo
    carry = ulong 1
  end
  put gs_st 6 add add ahi bhi carry
  put gs_st 7 rlo
end

note a < b for 128-bit values
fn gs_u_lt ahi ulong alo ulong bhi ulong blo ulong to bool
  if ne ahi bhi
    ret lt ahi bhi
  end
  ret lt alo blo
end

fn gs_u_print hi ulong lo ulong to void
  d = new uchar 48 48
  h = hi
  l = lo
  k = ulong 0
  going = true
  while going bound 48
    gs_u_div h l 10
    h = get gs_st 6
    l = get gs_st 7
    put d k uchar add 48 get gs_st 8
    k = add k 1
    if and eq h 0 eq l 0
      going = false
    end
  end
  while gt k 0 bound 48
    k = sub k 1
    gs_oc get d k
  end
end

fn gs_bitlen x ulong to ulong
  n = ulong 0
  v = x
  while ne v 0 bound 65
    v = shr v 1
    n = add n 1
  end
  ret n
end

note 2^e as f64 for 0 <= e <= 1023
fn gs_pow2 e ulong to f64
  ret bitcast f64 shl add e 1023 52
end

note (double) of a 128-bit value, rounded to nearest even (as gcc's __floatuntidf)
fn gs_u_f64 hi ulong lo ulong to f64
  if eq hi 0
    ret f64 lo
  end
  s = gs_bitlen hi
  if eq s 64
    t = hi
    if ne lo 0
      t = or t 1
    end
    ret mul f64 t gs_pow2 64
  end
  t = or shl hi sub 64 s shr lo s
  mask = sub shl ulong 1 s 1
  if ne and lo mask 0
    t = or t 1
  end
  ret mul f64 t gs_pow2 s
end

note ---- statistics -------------------------------------------------------------------------------

note Wilson score interval without continuity correction; exact 0 / 1 at k = 0 / k = n (gs_fp 0..2)
fn gs_wilson k long n long z f64 to void
  pp = div f64 k f64 n
  z2 = mul z z
  nn = f64 n
  den = add 1.0f64 div z2 nn
  c = div add pp div z2 mul 2.0f64 nn den
  t1 = div mul pp sub 1.0f64 pp nn
  t2 = div z2 mul mul 4.0f64 nn nn
  h = div mul z fsqrt add t1 t2 den
  put gs_fp 0 pp
  if eq k 0
    put gs_fp 1 0.0f64
  else
    put gs_fp 1 sub c h
  end
  if eq k n
    put gs_fp 2 1.0f64
  else
    put gs_fp 2 add c h
  end
end

note P(Y >= b), Y ~ Bin(b + c, 1/2), as num / 2^(b+c): num in gs_st 2/3, den in gs_st 4/5
fn gs_mcnemar1 b ulong c ulong to void
  n = add b c
  shi = ulong 0
  slo = ulong 0
  bhi = ulong 0
  blo = ulong 1
  for i ulong add n 1 bound 256
    if ge i b
      gs_u_add shi slo bhi blo
      shi = get gs_st 6
      slo = get gs_st 7
    end
    gs_u_mul bhi blo sub n i
    gs_u_div get gs_st 6 get gs_st 7 add i 1
    bhi = get gs_st 6
    blo = get gs_st 7
  end
  put gs_st 2 shi
  put gs_st 3 slo
  if lt n 64
    put gs_st 4 0
    put gs_st 5 shl ulong 1 n
  else
    put gs_st 4 shl ulong 1 sub n 64
    put gs_st 5 0
  end
end

note phi of the Newcombe interval, doubled (gcc keeps 2 * phi in one register: fadd d2, d2, d2)
fn gs_nc_phi2 a long b long c long d long method long to f64
  n = add add add a b c d
  num = fma f64 a f64 d neg mul f64 b f64 c
  if and eq method 10 gt num 0.0f64
    num = fma neg f64 n 0.5f64 num
    if lt num 0.0f64
      num = 0.0f64
    end
  end
  ab = f64 add a b
  cd = f64 add c d
  ac = f64 add a c
  bd = f64 add b d
  dprod = mul mul mul ab cd ac bd
  if eq dprod 0.0f64
    ret 0.0f64
  end
  phi = div num fsqrt dprod
  ret add phi phi
end

note Newcombe paired interval for theta = (b - c) / n (gs_fp 3..5)
fn gs_newcombe a long b long c long d long z f64 method long to void
  n = add add add a b c d
  gs_wilson add a b n z
  p1 = get gs_fp 0
  put gs_fp 10 sub p1 get gs_fp 1
  put gs_fp 11 sub get gs_fp 2 p1
  gs_wilson add a c n z
  p2 = get gs_fp 0
  put gs_fp 12 sub p2 get gs_fp 1
  put gs_fp 13 sub get gs_fp 2 p2
  phi2 = gs_nc_phi2 a b c d method
  gs_nc_var phi2
  gs_nc_finish b c n get gs_fp 14 get gs_fp 15
end

note s1 = dl1^2 - 2 phi dl1 du2 + du2^2 and s2 = du1^2 - 2 phi du1 dl2 + dl2^2 as gcc fuses them:
note fmadd(du2, du2, fnmsub(dl1, dl1, (dl1 * 2phi) * du2)); dl1 du1 dl2 du2 in gs_fp 10..13, s1 s2 to 14, 15
fn gs_nc_var phi2 f64 to void
  dl1 = get gs_fp 10
  du1 = get gs_fp 11
  dl2 = get gs_fp 12
  du2 = get gs_fp 13
  t1 = mul mul dl1 phi2 du2
  put gs_fp 14 fma du2 du2 fma dl1 dl1 neg t1
  t2 = mul mul du1 phi2 dl2
  put gs_fp 15 fma dl2 dl2 fma du1 du1 neg t2
end

fn gs_nc_finish b long c long n long s1 f64 s2 f64 to void
  dlt = 0.0f64
  if gt s1 0.0f64
    dlt = fsqrt s1
  end
  eps = 0.0f64
  if gt s2 0.0f64
    eps = fsqrt s2
  end
  th = div f64 sub b c f64 n
  lo = sub th dlt
  hi = add th eps
  if lt lo -1.0f64
    lo = -1.0f64
  end
  if gt hi 1.0f64
    hi = 1.0f64
  end
  put gs_fp 3 th
  put gs_fp 4 lo
  put gs_fp 5 hi
end

note ---- the decision ---------------------------------------------------------------------------

fn gs_rc c uchar to void
  rl = ulong get gs_dmeta 3
  if lt rl 255
    put gs_dreas rl c
    put gs_dmeta 3 long add rl 1
  end
end

fn gs_rs s view uchar * to void
  n = len s
  for i ulong n bound 256
    gs_rc get s i
  end
end

fn gs_decide_verdict valid long to void
  amb = sub get gs_ds 0 get gs_ds 1
  put gs_dmeta 1 amb
  mx = get gs_ds 0
  mn = get gs_ds 0
  for x ulong 4
    sx = get gs_ds x
    if gt sx mx
      mx = sx
    end
    if lt sx mn
      mn = sx
    end
  end
  flr = le mx 3
  cei = ge mn sub get gs_dmeta 0 3
  allp = true
  for x ulong 3
    if or eq get gs_dlift x 0 eq get gs_dpok x 0
      allp = false
    end
  end
  put gs_dmeta 3 0
  if or eq valid 0 gt amb 2
    put gs_dmeta 2 0
    if eq valid 0
      gs_rs gs_r_valfail
    end
    if and eq valid 0 gt amb 2
      gs_rc uchar 44
    end
    if gt amb 2
      gs_rs gs_r_sanity
    end
    ret
  end
  if or flr cei
    put gs_dmeta 2 3
    if flr
      gs_rs gs_r_floor
    end
    if and flr cei
      gs_rc uchar 44
    end
    if cei
      gs_rs gs_r_ceil
    end
    ret
  end
  if allp
    put gs_dmeta 2 1
    gs_rs gs_r_pass
    ret
  end
  if lt get gs_fp 7 0.10f64
    put gs_dmeta 2 2
    gs_rs gs_r_fail
    ret
  end
  put gs_dmeta 2 3
  for x ulong 3
    if eq get gs_dlift x 0
      if gt get gs_dmeta 3 0
        gs_rc uchar 44
      end
      gs_rs gs_r_lift
      gs_rc get gs_abc x
    end
    if eq get gs_dpok x 0
      if gt get gs_dmeta 3 0
        gs_rc uchar 44
      end
      gs_rs gs_r_p
      gs_rc get gs_abc x
    end
  end
end

note checks of decide(): writes the reason to the stderr line and returns false on a refusal
fn gs_decide_check to bool
  n0 = get gs_vlen 0
  if ne n0 60
    gs_es gs_e_vlen1
    gs_eu n0
    gs_es gs_e_vlen2
    ret false
  end
  for x ulong 4
    if ne get gs_vlen x n0
      gs_es gs_e_vdiff
      ret false
    end
    base = mul x 128
    for i ulong n0 bound 128
      c = get gs_vecs add base i
      if and ne c 48 ne c 49
        gs_es gs_e_vbyte1
        gs_ec get gs_abcd x
        gs_es gs_e_vbyte2
        ret false
      end
    end
  end
  ret true
end

fn gs_decide_pair x ulong n0 ulong to void
  bo = long 0
  dn = long 0
  xn = long 0
  nn = long 0
  bx = mul x 128
  for i ulong n0 bound 128
    dv = eq get gs_vecs add 384 i 49
    ov = eq get gs_vecs add bx i 49
    if and dv ov
      bo = add bo 1
    else
      if dv
        dn = add dn 1
      else
        if ov
          xn = add xn 1
        else
          nn = add nn 1
        end
      end
    end
  end
  put gs_dboth x bo
  put gs_ddonly x dn
  put gs_dxonly x xn
  put gs_dneith x nn
end

fn gs_decide_mc x ulong n0 ulong to void
  gs_mcnemar1 bitcast ulong get gs_ddonly x bitcast ulong get gs_dxonly x
  nhi = get gs_st 2
  nlo = get gs_st 3
  dhi = get gs_st 4
  dlo = get gs_st 5
  put gs_dpn mul x 2 nhi
  put gs_dpn add mul x 2 1 nlo
  put gs_dpd mul x 2 dhi
  put gs_dpd add mul x 2 1 dlo
  put gs_dpf x div gs_u_f64 nhi nlo gs_u_f64 dhi dlo
  gs_u_mul nhi nlo 20
  if gs_u_lt get gs_st 6 get gs_st 7 dhi dlo
    put gs_dpok x 1
  else
    put gs_dpok x 0
  end
  if ge mul 10 sub get gs_ddonly x get gs_dxonly x bitcast long n0
    put gs_dlift x 1
  else
    put gs_dlift x 0
  end
end

note the decision over gs_vecs / gs_vlen; false (reason on the stderr line) on a refusal
fn gs_decide valid long to bool
  if not gs_decide_check
    ret false
  end
  n0 = get gs_vlen 0
  put gs_dmeta 0 bitcast long n0
  for x ulong 4
    cnt = long 0
    base = mul x 128
    for i ulong n0 bound 128
      if eq get gs_vecs add base i 49
        cnt = add cnt 1
      end
    end
    put gs_ds x cnt
  end
  for x ulong 3
    gs_decide_pair x n0
    gs_decide_mc x n0
  end
  gs_newcombe get gs_dboth 2 get gs_ddonly 2 get gs_dxonly 2 get gs_dneith 2 GS_Z95 10
  put gs_fp 6 get gs_fp 4
  put gs_fp 7 get gs_fp 5
  gs_newcombe get gs_dboth 2 get gs_ddonly 2 get gs_dxonly 2 get gs_dneith 2 GS_Z90 10
  put gs_fp 8 get gs_fp 4
  put gs_fp 9 get gs_fp 5
  gs_decide_verdict valid
  ret true
end

fn gs_yesno v ulong to void
  if ne v 0
    gs_os gs_yes
  else
    gs_os gs_no
  end
end

fn gs_print_dec_x x ulong to void
  gs_oc uchar 9
  gs_oi get gs_dboth x
  gs_oc uchar 9
  gs_oi get gs_ddonly x
  gs_oc uchar 9
  gs_oi get gs_dxonly x
  gs_oc uchar 9
  gs_oi get gs_dneith x
  gs_oc uchar 9
  gs_u_print get gs_dpn mul x 2 get gs_dpn add mul x 2 1
  gs_oc uchar 9
  gs_u_print get gs_dpd mul x 2 get gs_dpd add mul x 2 1
  gs_oc uchar 9
  gs_of10 get gs_dpf x
  gs_oc uchar 9
  gs_yesno get gs_dlift x
  gs_oc uchar 9
  gs_yesno get gs_dpok x
end

fn gs_print_dec to void
  gs_oi get gs_ds 0
  gs_oc uchar 9
  gs_oi get gs_ds 1
  gs_oc uchar 9
  gs_oi get gs_ds 2
  gs_oc uchar 9
  gs_oi get gs_ds 3
  for x ulong 3
    gs_print_dec_x x
  end
  for j ulong 4
    gs_oc uchar 9
    gs_of10 get gs_fp add 6 j
  end
  gs_oc uchar 9
  gs_oi get gs_dmeta 1
  gs_oc uchar 9
  vc = get gs_dmeta 2
  if eq vc 0
    gs_os gs_v_invalid
  end
  if eq vc 1
    gs_os gs_v_pass
  end
  if eq vc 2
    gs_os gs_v_fail
  end
  if eq vc 3
    gs_os gs_v_inc
  end
  gs_oc uchar 9
  rl = bitcast ulong get gs_dmeta 3
  for i ulong rl bound 256
    gs_oc get gs_dreas i
  end
end

note ---- length-matched ablation ---------------------------------------------------------------

fn gs_lm_lim target long to long
  t = mul 15 target
  if gt t 25600
    ret t
  end
  ret 25600
end

fn gs_lm_matched target long suffix long to bool
  gap = sub suffix target
  ag = gap
  if lt ag 0
    ag = neg ag
  end
  ret le mul 100 ag gs_lm_lim target
end

note "%ld.%02ld" of the tolerance in hundredths of a byte
fn gs_lm_tol target long to void
  t = gs_lm_lim target
  gs_oi div t 100
  gs_oc uchar 46
  gs_ou2 bitcast ulong rem t 100
end

fn gs_lm_status matched long tasks long to void
  if ge mul 2 matched tasks
    gs_os gs_avail
  else
    gs_os gs_unavail
  end
end

note ---- Table III --------------------------------------------------------------------------------

fn gs_t3_row i ulong e f64 f f64 g f64 h f64 to void
  b = mul i 8
  put gs_t3 b e
  put gs_t3 add b 1 f
  put gs_t3 add b 2 g
  put gs_t3 add b 3 h
end

fn gs_t3_lim i ulong l8 f64 h8 f64 l10 f64 h10 f64 to void
  b = mul i 8
  put gs_t3 add b 4 l8
  put gs_t3 add b 5 h8
  put gs_t3 add b 6 l10
  put gs_t3 add b 7 h10
end

fn gs_t3_init to void
  gs_t3_row 0 36.0f64 12.0f64 2.0f64 0.0f64
  gs_t3_lim 0 0.0569f64 0.3404f64 0.0569f64 0.3404f64
  gs_t3_row 1 20.0f64 12.0f64 2.0f64 16.0f64
  gs_t3_lim 1 0.0618f64 0.3242f64 0.0562f64 0.3292f64
  gs_t3_row 2 18.0f64 12.0f64 2.0f64 18.0f64
  gs_t3_lim 2 0.0618f64 0.3239f64 0.0562f64 0.3290f64
  gs_t3_row 3 36.0f64 14.0f64 0.0f64 0.0f64
  gs_t3_lim 3 0.1528f64 0.4167f64 0.1528f64 0.4167f64
  gs_t3_row 4 35.0f64 14.0f64 0.0f64 1.0f64
  gs_t3_lim 4 0.1573f64 0.4149f64 0.1461f64 0.4175f64
  gs_t3_row 5 18.0f64 14.0f64 0.0f64 18.0f64
  gs_t3_lim 5 0.1504f64 0.3910f64 0.1441f64 0.3963f64
  gs_t3_row 6 2.0f64 97.0f64 1.0f64 0.0f64
  gs_t3_lim 6 0.8721f64 0.9854f64 0.8721f64 0.9854f64
  gs_t3_row 7 1.0f64 97.0f64 1.0f64 1.0f64
  gs_t3_lim 7 0.8737f64 0.9850f64 0.8736f64 0.9850f64
  gs_t3_row 8 0.0f64 29.0f64 1.0f64 0.0f64
  gs_t3_lim 8 0.6666f64 0.9882f64 0.6666f64 0.9882f64
  gs_t3_row 9 2.0f64 98.0f64 0.0f64 0.0f64
  gs_t3_lim 9 0.9178f64 0.9945f64 0.9178f64 0.9945f64
  gs_t3_row 10 1.0f64 98.0f64 0.0f64 1.0f64
  gs_t3_lim 10 0.9174f64 0.9916f64 0.9171f64 0.9916f64
  gs_t3_row 11 0.0f64 30.0f64 0.0f64 0.0f64
  gs_t3_lim 11 0.8395f64 1.0f64 0.8395f64 1.0f64
  gs_t3_row 12 54.0f64 0.0f64 0.0f64 0.0f64
  gs_t3_lim 12 -0.0664f64 0.0664f64 -0.0664f64 0.0664f64
  gs_t3_row 13 53.0f64 0.0f64 0.0f64 1.0f64
  gs_t3_lim 13 -0.0640f64 0.0640f64 -0.0729f64 0.0729f64
  gs_t3_row 14 30.0f64 0.0f64 0.0f64 24.0f64
  gs_t3_lim 14 -0.0074f64 0.0074f64 -0.0358f64 0.0358f64
  gs_t3_row 15 29.0f64 0.0f64 0.0f64 25.0f64
  gs_t3_lim 15 -0.0049f64 0.0049f64 -0.0354f64 0.0354f64
  gs_t3_row 16 28.0f64 0.0f64 0.0f64 26.0f64
  gs_t3_lim 16 -0.0025f64 0.0025f64 -0.0352f64 0.0352f64
  gs_t3_row 17 27.0f64 0.0f64 0.0f64 27.0f64
  gs_t3_lim 17 0.0f64 0.0f64 -0.0351f64 0.0351f64
end

fn gs_t3v i ulong j ulong to f64
  ret get gs_t3 add mul i 8 j
end

fn gs_t3n i ulong j ulong to long
  ret long gs_t3v i j
end

note ---- vectors ----------------------------------------------------------------------------------

note next space-terminated decimal of s from gs_st 11 (advanced past the space)
fn gs_next s view uchar * to long
  p = get gs_st 11
  v = long 0
  while lt p len s bound 1000
    c = get s p
    p = add p 1
    if eq c 32
      break
    end
    v = add mul v 10 long sub c 48
  end
  put gs_st 11 p
  ret v
end

fn gs_vec_head to void
  gs_os gs_vh1
  gs_os gs_vh2
  gs_os gs_vh3a
  gs_fix GS_Z95 15 1
  gs_os gs_vh3b
  gs_fix GS_Z90 15 1
  gs_os gs_vh3c
  gs_os gs_vh4
  gs_os gs_vh5
  gs_os gs_vh6
  gs_os gs_vh7
end

fn gs_vec_wilson_row i ulong conf long kv long nv long to void
  z = GS_Z90
  if eq conf 95
    z = GS_Z95
  end
  gs_wilson kv nv z
  gs_os gs_t_wilson
  gs_ou2 add i 1
  gs_oc uchar 95
  gs_oi conf
  gs_oc uchar 9
  gs_oi kv
  gs_oc uchar 9
  gs_oi nv
  gs_oc uchar 9
  gs_oi conf
  for j ulong 3
    gs_oc uchar 9
    gs_of10 get gs_fp j
  end
  gs_oc uchar 10
end

fn gs_vec_wilson to void
  gs_os gs_vc_w
  put gs_st 11 0
  for i ulong 11
    kv = gs_next gs_wk_data
    nv = gs_next gs_wk_data
    gs_vec_wilson_row i 95 kv nv
    gs_vec_wilson_row i 90 kv nv
  end
end

fn gs_vec_mcnemar to void
  gs_os gs_vc_m
  put gs_st 11 0
  for i ulong 18
    bv = gs_next gs_mc_data
    cv = gs_next gs_mc_data
    gs_mcnemar1 bitcast ulong bv bitcast ulong cv
    nhi = get gs_st 2
    nlo = get gs_st 3
    dhi = get gs_st 4
    dlo = get gs_st 5
    gs_os gs_t_mcnemar
    gs_ou2 add i 1
    gs_oc uchar 9
    gs_oi bv
    gs_oc uchar 9
    gs_oi cv
    gs_oc uchar 9
    gs_u_print nhi nlo
    gs_oc uchar 9
    gs_u_print dhi dlo
    gs_oc uchar 9
    gs_of10 div gs_u_f64 nhi nlo gs_u_f64 dhi dlo
    gs_oc uchar 9
    gs_u_mul nhi nlo 20
    if gs_u_lt get gs_st 6 get gs_st 7 dhi dlo
      gs_os gs_yes
    else
      gs_os gs_no
    end
    gs_oc uchar 10
  end
end

fn gs_vec_nc_tail to void
  gs_of10 get gs_fp 3
  gs_oc uchar 9
  gs_of10 get gs_fp 4
  gs_oc uchar 9
  gs_of10 get gs_fp 5
end

fn gs_vec_nc_t3 i ulong id ulong to void
  gs_newcombe gs_t3n i 0 gs_t3n i 1 gs_t3n i 2 gs_t3n i 3 GS_Z95 10
  gs_os gs_t_newcombe
  gs_ou2 id
  for j ulong 4
    gs_oc uchar 9
    gs_fix gs_t3v i j 0 1
  end
  gs_os gs_n_t3
  gs_vec_nc_tail
  gs_os gs_n_t3src
  gs_fix gs_t3v i 6 4 1
  gs_oc uchar 95
  gs_fix gs_t3v i 7 4 1
  gs_oc uchar 10
end

fn gs_vec_nc_gen id ulong a long b long c long d long conf long to void
  z = GS_Z90
  if eq conf 95
    z = GS_Z95
  end
  gs_newcombe a b c d z 10
  gs_os gs_t_newcombe
  gs_ou2 id
  gs_oc uchar 9
  gs_oi a
  gs_oc uchar 9
  gs_oi b
  gs_oc uchar 9
  gs_oi c
  gs_oc uchar 9
  gs_oi d
  gs_oc uchar 9
  gs_oi conf
  gs_oc uchar 9
  gs_oi 10
  gs_oc uchar 9
  gs_vec_nc_tail
  gs_os gs_n_gen
end

fn gs_vec_newcombe to void
  gs_os gs_vc_n
  id = ulong 0
  for i ulong 18
    id = add id 1
    gs_vec_nc_t3 i id
  end
  put gs_st 11 0
  for i ulong 8
    a = gs_next gs_gc_data
    b = gs_next gs_gc_data
    c = gs_next gs_gc_data
    d = gs_next gs_gc_data
    id = add id 1
    gs_vec_nc_gen id a b c d 95
    id = add id 1
    gs_vec_nc_gen id a b c d 90
  end
end

fn gs_vec_lm to void
  gs_os gs_vc_lm
  put gs_st 11 0
  for i ulong 12
    tv = gs_next gs_lm_data
    sv = gs_next gs_lm_data
    gs_os gs_t_lenmatch
    gs_ou2 add i 1
    gs_oc uchar 9
    gs_oi tv
    gs_oc uchar 9
    gs_oi sv
    gs_oc uchar 9
    gs_oi sub sv tv
    gs_oc uchar 9
    gs_lm_tol tv
    gs_oc uchar 9
    if gs_lm_matched tv sv
      gs_os gs_matched
    else
      gs_os gs_unmatched
    end
    gs_oc uchar 10
  end
  gs_os gs_vc_ls
  put gs_st 11 0
  for i ulong 7
    tk = gs_next gs_ls_data
    ma = gs_next gs_ls_data
    gs_os gs_t_lenset
    gs_ou2 add i 1
    gs_oc uchar 9
    gs_oi tk
    gs_oc uchar 9
    gs_oi ma
    gs_oc uchar 9
    gs_oi sub tk ma
    gs_oc uchar 9
    gs_lm_status ma tk
    gs_oc uchar 10
  end
end

fn gs_vec_vcols to void
  gs_os gs_vc_v1
  for x ulong 3
    l = get gs_abc x
    gs_os gs_vc_vf1
    gs_oc l
    gs_os gs_vc_both
    gs_os gs_vc_vf1
    gs_oc l
    gs_os gs_vc_donly
    gs_os gs_vc_vf1
    gs_oc l
    gs_os gs_vc_xonly
    gs_os gs_vc_vf1
    gs_oc l
    gs_os gs_vc_neith
    gs_os gs_vc_vf1
    gs_oc l
    gs_os gs_vc_pnum
    gs_os gs_vc_vf1
    gs_oc l
    gs_os gs_vc_pden
    gs_os gs_vc_vf1
    gs_oc l
    gs_os gs_vc_p
    gs_os gs_vc_vf1
    gs_oc l
    gs_os gs_vc_lift
    gs_os gs_vc_vf1
    gs_oc l
    gs_os gs_vc_pok
  end
  gs_os gs_vc_v5
end

note task column cnt of the four vectors = the ABCD pattern at gs_vc_data[pat..pat+4)
fn gs_vec_put pat ulong cnt ulong to void
  for x ulong 4
    put gs_vecs add mul x 128 cnt get gs_vc_data add pat x
  end
end

note build the four vectors of one case from gs_vc_data[p..) groups (pattern:count, ending at LF);
note returns the position after the LF; n of every vector in gs_vlen
fn gs_vec_build p0 ulong to ulong
  p = p0
  n = len gs_vc_data
  cnt = ulong 0
  while ne get gs_vc_data p 10 bound 64
    pat = p
    p = add p 5
    rep = ulong 0
    while lt p n bound 8
      c = get gs_vc_data p
      if or lt c 48 gt c 57
        break
      end
      rep = add mul rep 10 ulong sub c 48
      p = add p 1
    end
    for r ulong rep bound 128
      gs_vec_put pat cnt
      cnt = add cnt 1
    end
    if eq get gs_vc_data p 32
      p = add p 1
    end
  end
  for x ulong 4
    put gs_vlen x cnt
  end
  ret add p 1
end

fn gs_vec_verdicts to bool
  gs_vec_vcols
  p = ulong 0
  n = len gs_vc_data
  while lt p n bound 64
    id0 = p
    while ne get gs_vc_data p 124 bound 64
      p = add p 1
    end
    id1 = p
    valid = long sub get gs_vc_data add p 1 48
    p = gs_vec_build add p 3
    put gs_st 1 0
    gs_es gs_e_pre
    for k ulong sub id1 id0 bound 64
      gs_ec get gs_vc_data add id0 k
    end
    gs_ec uchar 58
    gs_ec uchar 32
    if not gs_decide valid
      gs_ec uchar 10
      gs_eflush
      ret false
    end
    put gs_st 1 0
    gs_os gs_t_verdict
    for k ulong sub id1 id0 bound 64
      gs_oc get gs_vc_data add id0 k
    end
    gs_oc uchar 9
    gs_oi valid
    for x ulong 4
      gs_oc uchar 9
      for k ulong get gs_vlen x bound 128
        gs_oc get gs_vecs add mul x 128 k
      end
    end
    gs_oc uchar 9
    gs_print_dec
    gs_oc uchar 10
  end
  ret true
end

fn gs_vectors to int
  gs_t3_init
  gs_vec_head
  gs_vec_wilson
  gs_vec_mcnemar
  gs_vec_newcombe
  gs_vec_lm
  if not gs_vec_verdicts
    ret 1
  end
  ret 0
end

note ---- selftest --------------------------------------------------------------------------------

fn gs_st_t3_fail m ulong i ulong lo f64 hi f64 plo f64 phi f64 to void
  gs_os gs_st_fnew
  if eq m 1
    gs_ou 10
  else
    gs_ou 8
  end
  for j ulong 4
    gs_oc uchar 32
    gs_fix gs_t3v i j 0 1
  end
  gs_os gs_st_got
  gs_fix lo 6 1
  gs_oc uchar 32
  gs_fix hi 6 1
  gs_os gs_st_paper
  gs_fix plo 4 1
  gs_oc uchar 32
  gs_fix phi 4 1
  gs_oc uchar 10
end

note the row 1 97 1 1 (its method-10 lower cell is allowed one unit in the 4th decimal)
fn gs_st_t3_known i ulong to bool
  if ne gs_t3v i 0 1.0f64
    ret false
  end
  if ne gs_t3v i 1 97.0f64
    ret false
  end
  ret eq gs_t3v i 3 1.0f64
end

fn gs_st_t3_one i ulong m ulong to ulong
  meth = long 8
  if eq m 1
    meth = long 10
  end
  gs_newcombe gs_t3n i 0 gs_t3n i 1 gs_t3n i 2 gs_t3n i 3 GS_Z95 meth
  lo = get gs_fp 4
  hi = get gs_fp 5
  plo = gs_t3v i add 4 mul 2 m
  phi = gs_t3v i add 5 mul 2 m
  tol = add 0.00005f64 1.0e-12f64
  if and eq m 1 gs_st_t3_known i
    tol = add 0.0001f64 1.0e-12f64
  end
  if or gt fabs sub lo plo tol gt fabs sub hi phi add 0.00005f64 1.0e-12f64
    gs_st_t3_fail m i lo hi plo phi
    ret 1
  end
  ret 0
end

fn gs_st_mc_one b ulong c ulong to bool
  gs_mcnemar1 b c
  n1h = get gs_st 2
  n1l = get gs_st 3
  d1h = get gs_st 4
  d1l = get gs_st 5
  gs_mcnemar1 c b
  if or ne d1h get gs_st 4 ne d1l get gs_st 5
    ret false
  end
  gs_u_add n1h n1l get gs_st 2 get gs_st 3
  sh = get gs_st 6
  sl = get gs_st 7
  pbh = ulong 0
  pbl = ulong 1
  for j ulong b bound 64
    gs_u_mul pbh pbl sub add b c j
    gs_u_div get gs_st 6 get gs_st 7 add j 1
    pbh = get gs_st 6
    pbl = get gs_st 7
  end
  gs_u_add d1h d1l pbh pbl
  if or ne sh get gs_st 6 ne sl get gs_st 7
    ret false
  end
  ret true
end

fn gs_st_wil_one k ulong to bool
  gs_wilson bitcast long k 60 GS_Z95
  p = get gs_fp 0
  l95 = get gs_fp 1
  h95 = get gs_fp 2
  gs_wilson bitcast long k 60 GS_Z90
  l90 = get gs_fp 1
  h90 = get gs_fp 2
  ok = and and le l95 l90 le l90 p and le p h90 le h90 h95
  ret ok
end

fn gs_selftest to int
  gs_t3_init
  bad = ulong 0
  for i ulong 18
    for m ulong 2
      bad = add bad gs_st_t3_one i m
    end
  end
  for b ulong 31
    for c ulong 31
      if not gs_st_mc_one b c
        gs_os gs_st_fmc1
        gs_ou b
        gs_os gs_st_fmc2
        gs_ou c
        gs_oc uchar 10
        bad = add bad 1
      end
    end
  end
  for k ulong 61
    if not gs_st_wil_one k
      gs_os gs_st_fwil
      gs_ou k
      gs_oc uchar 10
      bad = add bad 1
    end
  end
  if eq bad 0
    gs_os gs_st_pass1
    gs_ou 18
    gs_os gs_st_pass2
    ret 0
  end
  gs_os gs_st_fail1
  gs_ou bad
  gs_os gs_st_fail2
  ret 1
end

note ---- arguments ------------------------------------------------------------------------------

note read argument idx into gs_arg; its length (the argument must fit 1 MiB)
fn gs_argload idx ulong to ulong
  r = argread idx gs_arg 0 1048576
  if lt r 0
    gs_es gs_e_pre
    gs_ec uchar 10
    gs_exit 2
  end
  ret bitcast ulong r
end

fn gs_isspace c uchar to bool
  if eq c 32
    ret true
  end
  ret and ge c 9 le c 13
end

note strtol(s, &e, 10) over gs_arg[o..o+n): the value in gs_st 10 (as long bits); false when no digits or
note trailing bytes (the C "!*s || *e" refusal)
fn gs_strtol o ulong n ulong to bool
  e = add o n
  p = o
  while lt p e bound 1048576
    if not gs_isspace get gs_arg p
      break
    end
    p = add p 1
  end
  ng = false
  if lt p e
    c = get gs_arg p
    if or eq c 43 eq c 45
      ng = eq c 45
      p = add p 1
    end
  end
  st = p
  v = ulong 0
  sat = false
  while lt p e bound 1048576
    c = get gs_arg p
    if or lt c 48 gt c 57
      break
    end
    d = ulong sub c 48
    if gt v div sub 9223372036854775808 d 10
      sat = true
    else
      v = add mul v 10 d
    end
    p = add p 1
  end
  if or eq p st lt p e
    ret false
  end
  gs_strtol_set v ng sat
  ret true
end

note saturated signed value of the magnitude v (LONG_MAX / LONG_MIN as strtol)
fn gs_strtol_set v ulong ng bool sat bool to void
  r = v
  if ng
    if sat
      r = ulong 9223372036854775808
    end
    put gs_st 10 add not r 1
    ret
  end
  if or sat gt r 9223372036854775807
    r = ulong 9223372036854775807
  end
  put gs_st 10 r
end

note num(s, lo, hi) of the C reference over gs_arg[o..o+n); refusal exits 2
fn gs_num o ulong n ulong lo long hi long to long
  ok = gs_strtol o n
  v = bitcast long get gs_st 10
  if and ok and ge v lo le v hi
    ret v
  end
  gs_es gs_e_num1
  for i ulong n bound 1048576
    gs_ec get gs_arg add o i
  end
  gs_es gs_e_num2
  gs_ei lo
  gs_es gs_e_dots
  gs_ei hi
  gs_ec uchar 10
  gs_exit 2
  ret 0
end

fn gs_arg_num idx ulong lo long hi long to long
  n = gs_argload idx
  ret gs_num 0 n lo hi
end

fn gs_arg_conf idx ulong to f64
  n = gs_argload idx
  if gs_arg_is n gs_s95
    ret GS_Z95
  end
  if gs_arg_is n gs_s90
    ret GS_Z90
  end
  gs_es gs_e_conf
  gs_exit 2
  ret GS_Z95
end

note ---- commands -------------------------------------------------------------------------------

fn gs_do_wilson to int
  nv = gs_arg_num 3 1 1000000
  kv = gs_arg_num 2 0 nv
  z = gs_arg_conf 4
  gs_wilson kv nv z
  gs_of10 get gs_fp 0
  gs_oc uchar 32
  gs_of10 get gs_fp 1
  gs_oc uchar 32
  gs_of10 get gs_fp 2
  gs_oc uchar 10
  ret 0
end

fn gs_do_mcnemar to int
  bv = gs_arg_num 2 0 120
  cv = gs_arg_num 3 0 sub 120 bv
  gs_mcnemar1 bitcast ulong bv bitcast ulong cv
  nhi = get gs_st 2
  nlo = get gs_st 3
  dhi = get gs_st 4
  dlo = get gs_st 5
  gs_u_print nhi nlo
  gs_oc uchar 32
  gs_u_print dhi dlo
  gs_oc uchar 32
  gs_of10 div gs_u_f64 nhi nlo gs_u_f64 dhi dlo
  gs_oc uchar 10
  ret 0
end

fn gs_do_newcombe ac ulong to int
  a = gs_arg_num 2 0 1000000
  b = gs_arg_num 3 0 1000000
  c = gs_arg_num 4 0 1000000
  d = gs_arg_num 5 0 1000000
  if eq add add add a b c d 0
    gs_es gs_e_n0
    ret 2
  end
  meth = long 10
  if eq ac 8
    meth = gs_arg_num 7 8 10
  end
  if eq meth 9
    gs_es gs_e_meth
    ret 2
  end
  z = gs_arg_conf 6
  gs_newcombe a b c d z meth
  gs_vec_nc_tail_sp
  ret 0
end

fn gs_vec_nc_tail_sp to void
  gs_of10 get gs_fp 3
  gs_oc uchar 32
  gs_of10 get gs_fp 4
  gs_oc uchar 32
  gs_of10 get gs_fp 5
  gs_oc uchar 10
end

fn gs_do_verdict to int
  valid = gs_arg_num 2 0 1
  for x ulong 4
    n = gs_argload add 3 x
    put gs_vlen x n
    if le n 128
      for i ulong n bound 128
        put gs_vecs add mul x 128 i get gs_arg i
      end
    end
  end
  put gs_st 1 0
  gs_es gs_e_pre
  if not gs_decide valid
    gs_ec uchar 10
    ret 1
  end
  put gs_st 1 0
  gs_print_dec
  gs_oc uchar 10
  ret 0
end

fn gs_lm_one i ulong to long
  n = gs_argload add i 2
  col = n
  for j ulong n bound 1048576
    if eq get gs_arg j 58
      col = j
      break
    end
  end
  if eq col n
    gs_es gs_e_lm
    ret -1
  end
  tv = gs_num 0 col 1 1000000
  sv = gs_num add col 1 sub sub n col 1 0 1000000
  gs_os gs_s_lm1
  gs_ou add i 1
  gs_os gs_s_lm2
  gs_oi tv
  gs_os gs_s_lm3
  gs_oi sv
  gs_os gs_s_lm4
  gs_oi sub sv tv
  gs_os gs_s_lm5
  gs_lm_tol tv
  gs_os gs_s_lm6
  if gs_lm_matched tv sv
    gs_os gs_matched
    gs_oc uchar 10
    ret 1
  end
  gs_os gs_unmatched
  gs_oc uchar 10
  ret 0
end

fn gs_do_lenmatch ac ulong to int
  matched = long 0
  nt = sub ac 2
  for i ulong nt bound 1000000
    m = gs_lm_one i
    if lt m 0
      ret 2
    end
    matched = add matched m
  end
  gs_os gs_s_ls1
  gs_ou nt
  gs_os gs_s_ls2
  gs_oi matched
  gs_os gs_s_ls3
  gs_oi sub bitcast long nt matched
  gs_os gs_s_ls4
  gs_lm_status matched bitcast long nt
  gs_oc uchar 10
  ret 0
end

fn gs_dispatch ac ulong cl ulong to int
  if and eq ac 5 gs_arg_is cl gs_c_wilson
    ret gs_do_wilson
  end
  if and eq ac 4 gs_arg_is cl gs_c_mcnemar1
    ret gs_do_mcnemar
  end
  if and or eq ac 7 eq ac 8 gs_arg_is cl gs_c_newcombe
    ret gs_do_newcombe ac
  end
  if and eq ac 7 gs_arg_is cl gs_c_verdict
    ret gs_do_verdict
  end
  if and ge ac 3 gs_arg_is cl gs_c_lenmatch
    ret gs_do_lenmatch ac
  end
  if and eq ac 2 gs_arg_is cl gs_c_vectors
    ret gs_vectors
  end
  if and eq ac 2 gs_arg_is cl gs_c_selftest
    ret gs_selftest
  end
  gs_es gs_usage
  ret 2
end

fn main to int
  ac = ulong argcnt
  cl = ulong 0
  if ge ac 2
    r = argread 1 gs_arg 0 1048576
    if ge r 0
      cl = bitcast ulong r
    end
  end
  rc = gs_dispatch ac cl
  gs_eflush
  gs_oflush
  ret rc
end

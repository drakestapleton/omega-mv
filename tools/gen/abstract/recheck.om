note g_meta: [0]=root_len [1]=rdir_len [2]=file_len [3]=err_len [4]=err_line [5]=id_len [6]=want_len [7]=prev_len [8]=ndist [9]=path_len [10]=has_root [11]=has_rdir
global g_meta ulong 16

note Sig state: [0]=name_off [1]=name_len [2]=np [3]=ret_off [4]=ret_len
global g_sig_m ulong 8
global g_sig_poff ulong 6
global g_sig_plen_s ulong 6

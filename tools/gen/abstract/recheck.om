    ret 1
  end
  if eq buf_eq_lit off n tr_07 1
    ret 1
  end
  if eq buf_eq_lit off n tr_08 1
    ret 1
  end
  if eq buf_eq_lit off n tr_09 1
    ret 1
  end
  if eq buf_eq_lit off n tr_10 1
    ret 1
  end
  if eq buf_eq_lit off n tr_11 1
    ret 1
  end
  if eq buf_eq_lit off n tr_12 1
    ret 1
  end
  if eq buf_eq_lit off n tr_13 1
    ret 1
  end
  if eq buf_eq_lit off n tr_14 1
    ret 1
  end
  if eq buf_eq_lit off n tr_15 1
    ret 1
  end
  if eq buf_eq_lit off n tr_16 1
    ret 1
  end
  if eq buf_eq_lit off n tr_17 1
    ret 1
  end
  if eq buf_eq_lit off n tr_18 1
    ret 1
  end
  if eq buf_eq_lit off n tr_19 1
    ret 1
  end
  if eq buf_eq_lit off n tr_20 1
    ret 1
  end
  if eq buf_eq_lit off n tr_21 1
    ret 1
  end
  if eq buf_eq_lit off n tr_22 1
    ret 1
  end
  if eq buf_eq_lit off n tr_23 1
    ret 1
  end
  ret 0
end

fn is_res_2 off ulong n ulong to int
  if eq buf_eq_lit off n tr_24 1
    ret 1
  end
  if eq buf_eq_lit off n tr_25 1
    ret 1

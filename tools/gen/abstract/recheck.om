note Words scratch
global g_woff ulong 80
global g_wlen ulong 80

note Key match output: [0]=val_off [1]=val_len
global g_kv ulong 2

fn wr_lit fd int s view uchar * to void
  off = ulong 0
  n = len s
  while lt off n
    w = write fd s off sub n off
    if le w 0
      ret
    end
    off = add off ulong w
  end
end

fn wr_out fd int n ulong to void
  off = ulong 0
  while lt off n
    w = write fd g_out off sub n off
    if le w 0
      ret
    end
    off = add off ulong w
  end
end

fn out_push_lit pos ulong s view uchar * to ulong
  n = len s
  i = ulong 0
  p = pos
  while lt i n
    if lt p 1020
      put g_out p get s i
      p = add p 1
    end
    i = add i 1
  end
  ret p
end

fn out_push_u64 pos ulong v ulong to ulong
  p = pos
  if eq v 0
    if lt p 1020
      put g_out p uchar 48
      p = add p 1
    end
    ret p
  end
  k = ulong 0
  x = v
  while gt x 0
    d = rem x 10
    put g_numbuf k uchar add d 48
    x = div x 10
    k = add k 1
  end
  i = ulong 0
  while lt i k
    if lt p 1020
      put g_out p get g_numbuf sub sub k 1 i
      p = add p 1
    end
    i = add i 1
  end
  ret p
end

fn err_set1 line ulong m view uchar * to int
  if gt get g_meta 3 0
    ret -1
  end
  put g_meta 4 line
  n = len m
  i = ulong 0
  while lt i n
    if lt i 510
      put g_err i get m i
    end
    i = add i 1
  end
  put g_meta 3 n
  ret -1
end

fn err_begin line ulong m view uchar * to int
  if gt get g_meta 3 0
    ret 0
  end
  put g_meta 4 line
  n = len m
  i = ulong 0
  while lt i n
    if lt i 510
      put g_err i get m i
    end
    i = add i 1
  end
  put g_meta 3 n
  ret 1
end

fn err_add_buf off ulong alen ulong to void
  p = get g_meta 3
  i = ulong 0
  while lt i alen
    if lt p 510
      put g_err p get g_buf add off i
      p = add p 1
    end
    i = add i 1
  end
  put g_meta 3 p
end

fn err_add_lit m view uchar * to void
  p = get g_meta 3
  i = ulong 0
  n = len m
  while lt i n
    if lt p 510
      put g_err p get m i
      p = add p 1
    end
    i = add i 1
  end
  put g_meta 3 p
end

fn err_add_rcpt to void
  p = get g_meta 3
  i = ulong 0
  while lt i 64
    if lt p 510
      put g_err p get g_rcpt_id i
      p = add p 1
    end
    i = add i 1
  end
  put g_meta 3 p
end

fn err_set_call line ulong is_ct int msg view uchar * to int
  if gt get g_meta 3 0
    ret -1
  end
  put g_meta 4 line
  p = ulong 0
  if eq is_ct 1
    i = ulong 0
    while lt i len e_call_ct
      put g_err p get e_call_ct i
      p = add p 1
      i = add i 1
    end
  else
    i = ulong 0
    while lt i len e_call_ex
      put g_err p get e_call_ex i
      p = add p 1
      i = add i 1
    end
  end
  i = ulong 0
  while lt i len msg
    if lt p 510
      put g_err p get msg i
      p = add p 1
    end
    i = add i 1
  end
  put g_meta 3 p
  ret -1
end

fn buf_eq_lit off ulong n ulong s view uchar * to int
  if ne n len s
    ret 0
  end
  i = ulong 0
  while lt i n
    if ne get g_buf add off i get s i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn buf_pfx_lit off ulong n ulong s view uchar * to int
  sn = len s
  if lt n sn
    ret 0
  end
  i = ulong 0
  while lt i sn
    if ne get g_buf add off i get s i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn buf_eq_buf o1 ulong n1 ulong o2 ulong n2 ulong to int
  if ne n1 n2
    ret 0
  end
  i = ulong 0
  while lt i n1
    if ne get g_buf add o1 i get g_buf add o2 i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn buf_cmp_prev off ulong n ulong to int
  pn = get g_meta 7
  mn = n
  if lt pn mn
    mn = pn
  end
  i = ulong 0
  while lt i mn
    a = get g_prev i
    b = get g_buf add off i
    if lt a b
      ret -1
    end
    if gt a b
      ret 1
    end
    i = add i 1
  end
  if lt pn n
    ret -1
  end
  if gt pn n
    ret 1
  end
  ret 0
end

fn prev_set off ulong n ulong to void
  i = ulong 0
  while lt i n
    if lt i 255
      put g_prev i get g_buf add off i
    end
    i = add i 1
  end
  put g_meta 7 n
end

fn is_hex_ch c uchar to int
  if ge c 48
    if le c 57
      ret 1
    end
  end
  if ge c 97
    if le c 102
      ret 1
    end
  end
  ret 0
end

fn is_hex64 off ulong n ulong to int
  if ne n 64
    ret 0
  end
  i = ulong 0
  while lt i 64
    if eq is_hex_ch get g_buf add off i 0
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn is_taskid off ulong n ulong to int
  if lt n 1
    ret 0
  end
  if gt n 40
    ret 0
  end
  i = ulong 0
  while lt i n
    c = get g_buf add off i
    ok = int 0
    if ge c 97
      if le c 122
        ok = 1
      end
    end
    if ge c 48
      if le c 57
        ok = 1
      end
    end
    if eq c 95
      ok = 1
    end
    if eq c 45
      ok = 1
    end
    if eq ok 0
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn scalar_idx off ulong n ulong to int
  if eq buf_eq_lit off n ts_0 1
    ret 0
  end
  if eq buf_eq_lit off n ts_1 1
    ret 1
  end
  if eq buf_eq_lit off n ts_2 1
    ret 2
  end
  if eq buf_eq_lit off n ts_3 1
    ret 3
  end
  if eq buf_eq_lit off n ts_4 1
    ret 4
  end
  if eq buf_eq_lit off n ts_5 1
    ret 5
  end
  if eq buf_eq_lit off n ts_6 1
    ret 6
  end
  if eq buf_eq_lit off n ts_7 1
    ret 7
  end
  if eq buf_eq_lit off n ts_8 1
    ret 8
  end
  ret -1
end


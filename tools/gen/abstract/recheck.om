fn is_ident off ulong n ulong to int
  if lt n 1
    ret 0
  end
  if gt n 63
    ret 0
  end
  c0 = get g_buf off
  ok0 = int 0
  if ge c0 97
    if le c0 122
      ok0 = 1
    end
  end
  if ge c0 65
    if le c0 90
      ok0 = 1
    end
  end
  if eq c0 95
    ok0 = 1
  end
  if eq ok0 0
    ret 0
  end
  i = ulong 1
  while lt i n
    c = get g_buf add off i
    ok = int 0
    if ge c 97
      if le c 122
        ok = 1
      end
    end
    if ge c 65
      if le c 90
        ok = 1
      end
    end
    if ge c 48
      if le c 57
        ok = 1
      end
    end
    if eq c 95
      ok = 1
    end
    if eq ok 0
      ret 0
    end
    i = add i 1
  end
  if ge scalar_idx off n 0
    ret 0
  end
  if eq is_res_1 off n 1
    ret 0
  end
  if eq is_res_2 off n 1
    ret 0
  end
  ret 1
end

fn split_words off ulong n ulong maxw ulong to int
  k = ulong 0
  p = ulong 0
  while lt p n
    if eq k maxw
      ret -1
    end
    st = p
    while lt p n
      if eq get g_buf add off p 32
        break
      end
      p = add p 1
    end
    put g_woff k add off st
    put g_wlen k sub p st
    k = add k 1
    if lt p n
      p = add p 1
    end
  end
  ret int k
end

fn parse_len_word off ulong n ulong to int
  if lt n 1
    ret 0
  end
  if gt n 2
    ret 0
  end
  if eq get g_buf off 48
    ret 0
  end
  v = int 0
  i = ulong 0
  while lt i n
    c = get g_buf add off i
    if lt c 48
      ret 0
    end
    if gt c 57
      ret 0
    end
    v = add mul v 10 int sub c 48
    i = add i 1
  end
  if lt v 1
    ret 0
  end
  if gt v 64
    ret 0
  end
  ret v
end

fn type_at nw ulong idx ulong to int
  if ge idx nw
    ret 0
  end
  o0 = get g_woff idx
  l0 = get g_wlen idx
  if ge scalar_idx o0 l0 0
    ret 1
  end
  is_m = int 0
  if eq buf_eq_lit o0 l0 t_view 1
    is_m = 1
  end
  if eq buf_eq_lit o0 l0 t_edit 1
    is_m = 1
  end
  if eq buf_eq_lit o0 l0 t_own 1
    is_m = 1
  end
  if eq is_m 0
    ret 0
  end
  if ge add idx 2 nw
    ret 0
  end
  if lt scalar_idx get g_woff add idx 1 get g_wlen add idx 1 0
    ret 0
  end
  if eq parse_len_word get g_woff add idx 2 get g_wlen add idx 2 0
    ret 0
  end
  ret 3
end

fn parse_sig_param nw ulong i ulong line ulong to long
  wo = get g_woff i
  wl = get g_wlen i
  np = get g_sig_m 2
  if eq np 6
    ign = err_set1 line e_sig_6p
    ret -1
  end
  if eq is_ident wo wl 0
    if eq err_begin line e_sig_pn1 1
      err_add_buf wo wl
      err_add_lit e_sig_pn2
    end
    ret -1
  end
  k = ulong 0
  while lt k np
    if eq buf_eq_buf get g_sig_poff k get g_sig_plen_s k wo wl 1
      if eq err_begin line e_sig_pn1 1
        err_add_buf wo wl
        err_add_lit e_sig_pr2
      end
      ret -1
    end
    k = add k 1
  end
  if eq buf_eq_buf wo wl get g_sig_m 0 get g_sig_m 1 1
    if eq err_begin line e_sig_pf1 1
      err_add_buf wo wl
      err_add_lit e_sig_pf2
    end
    ret -1
  end
  t = type_at nw add i 1
  if eq t 0
    if eq err_begin line e_sig_pf1 1
      err_add_buf wo wl
      err_add_lit e_sig_pt2
    end
    ret -1
  end
  put g_sig_poff np wo
  put g_sig_plen_s np wl
  put g_sig_t0_off np get g_woff add i 1
  put g_sig_t0_len np get g_wlen add i 1
  if eq t 1
    put g_sig_arr np 0
  else
    put g_sig_t1_off np get g_woff add i 2
    put g_sig_t1_len np get g_wlen add i 2
    put g_sig_arr np ulong parse_len_word get g_woff add i 3 get g_wlen add i 3
  end
  put g_sig_m 2 add np 1
  ret long add i add 1 ulong t
end

fn parse_sig off ulong n ulong line ulong to int
  nw_i = split_words off n 64
  if lt nw_i 4
    ret err_set1 line e_sig_fmt
  end
  nw = ulong nw_i
  if eq buf_eq_lit get g_woff 0 get g_wlen 0 t_fn 0
    ret err_set1 line e_sig_fmt
  end
  fn_o = get g_woff 1
  fn_l = get g_wlen 1
  if eq is_ident fn_o fn_l 0
    if eq err_begin line e_sig_fn1 1
      err_add_buf fn_o fn_l
      err_add_lit e_sig_fn2
    end
    ret -1
  end
  put g_sig_m 0 fn_o
  put g_sig_m 1 fn_l
  put g_sig_m 2 0
  i = ulong 2
  while lt i nw
    if eq buf_eq_lit get g_woff i get g_wlen i t_to 1
      break
    end
    ni = parse_sig_param nw i line
    if lt ni 0
      ret -1
    end
    i = ulong ni
  end
  if ge i nw
    ret err_set1 line e_sig_noto
  end
  i = add i 1
  if lt i nw
    if eq add i 1 nw
      if eq buf_eq_lit get g_woff i get g_wlen i t_void 1
        put g_sig_m 3 get g_woff i
        put g_sig_m 4 get g_wlen i
        ret 0
      end
    end
  end
  tr = type_at nw i
  if ne tr 1
    ret err_set1 line e_sig_ret
  end
  if ne add i 1 nw
    ret err_set1 line e_sig_ret
  end
  put g_sig_m 3 get g_woff i
  put g_sig_m 4 get g_wlen i
  ret 0
end

fn is_int_word off ulong n ulong to int
  if eq n 0
    ret 0
  end
  p = ulong 0
  is_neg = int 0
  if eq get g_buf off 45
    is_neg = 1
    p = 1
  end
  remn = sub n p
  if eq remn 0
    ret 0
  end
  if gt remn 20
    ret 0
  end
  if eq get g_buf add off p 48
    if gt remn 1
      ret 0
    end
    if eq is_neg 1
      ret 0
    end
  end
  while lt p n
    c = get g_buf add off p
    if lt c 48
      ret 0
    end
    if gt c 57
      ret 0
    end
    p = add p 1
  end
  ret 1
end

fn parse_small_pos off ulong n ulong to int
  if eq is_int_word off n 0
    ret -1
  end
  if eq get g_buf off 45
    ret -1
  end
  if gt n 4
    ret -1
  end
  v = int 0
  i = ulong 0
  while lt i n
    v = add mul v 10 int sub get g_buf add off i 48
    i = add i 1
  end
  ret v
end

fn parse_call off ulong n ulong nargs ulong trap_ok int line ulong is_ct int to int
  nw_i = split_words off n 80
  if lt nw_i 0
    ret err_set_call line is_ct e_call_words
  end
  nw = ulong nw_i
  a = ulong 0
  while lt a nw
    if eq buf_eq_lit get g_woff a get g_wlen a t_arrow 1
      break
    end
    if eq is_int_word get g_woff a get g_wlen a 0
      ret err_set_call line is_ct e_call_arg
    end
    a = add a 1
  end
  if ne a nargs
    ret err_set_call line is_ct e_call_arity
  end
  if ge a nw
    ret err_set_call line is_ct e_call_noarr
  end
  if eq add a 2 nw
    if eq is_int_word get g_woff add a 1 get g_wlen add a 1 1
      ret 0
    end
  end
  if eq trap_ok 1
    if eq add a 3 nw
      if eq buf_eq_lit get g_woff add a 1 get g_wlen add a 1 t_trap 1
        tc = parse_small_pos get g_woff add a 2 get g_wlen add a 2
        if ge tc 1
          if le tc 14
            ret 0
          end
        end
      end
    end
    ret err_set_call line is_ct e_call_res_t
  end
  ret err_set_call line is_ct e_call_res_n
end

fn key_match li ulong k view uchar * to int
  if ge li get g_nl 0
    ret 0
  end
  lo = get g_lofs li
  ll = get g_llen li
  kn = len k
  if le ll kn
    ret 0
  end
  if ne get g_buf add lo kn 32
    ret 0
  end
  i = ulong 0
  while lt i kn
    if ne get g_buf add lo i get k i
      ret 0
    end
    i = add i 1
  end
  put g_kv 0 add lo add kn 1
  put g_kv 1 sub sub ll kn 1
  ret 1
end

fn want_push_lit s view uchar * to int
  p = get g_meta 6
  n = len s
  if gt add p n 511
    ret -1
  end
  i = ulong 0
  while lt i n
    put g_want add p i get s i
    i = add i 1
  end
  put g_meta 6 add p n
  ret 0
end

fn want_push_buf off ulong n ulong to int
  p = get g_meta 6
  if gt add p n 511
    ret -1
  end
  i = ulong 0
  while lt i n
    put g_want add p i get g_buf add off i
    i = add i 1
  end
  put g_meta 6 add p n
  ret 0
end

fn want_push_ch c uchar to int
  p = get g_meta 6
  if ge p 511
    ret -1
  end
  put g_want p c
  put g_meta 6 add p 1
  ret 0
end

fn want_push_u64 v ulong to int
  if ge v 10
    if ne want_push_ch uchar add div v 10 48 0
      ret -1
    end
  end
  ret want_push_ch uchar add rem v 10 48
end

fn want_push_ir idx int to int
  if eq idx 0
    ret want_push_lit tir_0
  end
  if eq idx 1
    ret want_push_lit tir_1
  end
  if eq idx 2
    ret want_push_lit tir_2
  end
  if eq idx 3
    ret want_push_lit tir_3
  end
  if eq idx 4
    ret want_push_lit tir_4
  end
  if eq idx 5
    ret want_push_lit tir_5
  end
  if eq idx 6
    ret want_push_lit tir_6
  end
  if eq idx 7
    ret want_push_lit tir_7
  end
  if eq idx 8
    ret want_push_lit tir_8
  end
  ret -1
end

fn eq_ir_lit off ulong n ulong idx int to int
  if eq idx 0
    ret buf_eq_lit off n tir_0
  end
  if eq idx 1
    ret buf_eq_lit off n tir_1
  end
  if eq idx 2
    ret buf_eq_lit off n tir_2
  end
  if eq idx 3
    ret buf_eq_lit off n tir_3
  end
  if eq idx 4
    ret buf_eq_lit off n tir_4
  end
  if eq idx 5
    ret buf_eq_lit off n tir_5
  end
  if eq idx 6
    ret buf_eq_lit off n tir_6
  end
  if eq idx 7
    ret buf_eq_lit off n tir_7
  end
  if eq idx 8
    ret buf_eq_lit off n tir_8
  end
  ret 0
end

fn check_params_ret pars_o ulong pars_l ulong rt_o ulong rt_l ulong entl ulong to int
  put g_meta 6 0
  np = get g_sig_m 2
  k = ulong 0
  while lt k np
    if gt k 0
      if ne want_push_ch 32 0
        ret err_set1 add entl 1 e_par_long
      end
    end
    al = get g_sig_arr k
    if gt al 0
      if ne want_push_buf get g_sig_t0_off k get g_sig_t0_len k 0
        ret err_set1 add entl 1 e_par_long
      end
      if ne want_push_ch 32 0
        ret err_set1 add entl 1 e_par_long
      end
      si = scalar_idx get g_sig_t1_off k get g_sig_t1_len k
      if ne want_push_ir si 0
        ret err_set1 add entl 1 e_par_long
      end
      if ne want_push_ch 32 0
        ret err_set1 add entl 1 e_par_long
      end
      if ne want_push_u64 al 0
        ret err_set1 add entl 1 e_par_long
      end
    else
      si = scalar_idx get g_sig_t0_off k get g_sig_t0_len k
      if ne want_push_ir si 0
        ret err_set1 add entl 1 e_par_long
      end
    end
    k = add k 1
  end
  wl = get g_meta 6
  if ne pars_l wl
    ret err_set1 add entl 1 e_par_diff
  end
  i = ulong 0
  while lt i wl
    if ne get g_buf add pars_o i get g_want i
      ret err_set1 add entl 1 e_par_diff
    end
    i = add i 1
  end
  ro = get g_sig_m 3
  rl = get g_sig_m 4
  if eq buf_eq_lit ro rl t_void 1
    if eq buf_eq_lit rt_o rt_l t_void 0
      ret err_set1 add entl 2 e_ret_diff
    end
    ret 0
  end
  rsi = scalar_idx ro rl
  if eq eq_ir_lit rt_o rt_l rsi 0
    ret err_set1 add entl 2 e_ret_diff
  end
  ret 0
end

fn famlist_ok off ulong n ulong to int
  if eq n 0
    ret 0
  end
  cnt = ulong 0
  p = ulong 0
  while lt p n
    st = p
    while lt p n
      if eq get g_buf add off p 32
        break
      end
      p = add p 1
    end
    m = sub p st
    if ne m 20
      ret 0
    end
    if eq buf_pfx_lit add off st m t_gs1_pfx 0
      ret 0
    end
    k = ulong 4
    while lt k 20
      if eq is_hex_ch get g_buf add add off st k 0
        ret 0
      end
      k = add k 1
    end
    if gt cnt 0
      if ge buf_cmp_prev add off st m 0
        ret 0
      end
    end
    prev_set add off st m
    cnt = add cnt 1
    if lt p n
      p = add p 1
      if eq p n
        ret 0
      end
    end
  end
  if gt cnt 0
    ret 1
  end
  ret 0
end

fn is_path_ch c uchar to int
  if ge c 97
    if le c 122
      ret 1
    end
  end
  if ge c 65
    if le c 90
      ret 1
    end
  end
  if ge c 48
    if le c 57
      ret 1
    end
  end
  if eq c 95
    ret 1
  end
  if eq c 46
    ret 1
  end
  if eq c 47
    ret 1
  end
  if eq c 45
    ret 1
  end
  ret 0
end

fn safe_path off ulong n ulong to int
  if lt n 1
    ret 0
  end
  if gt n 255
    ret 0
  end
  if eq get g_buf off 47
    ret 0
  end
  i = ulong 0
  while lt i n
    if eq is_path_ch get g_buf add off i 0
      ret 0
    end
    i = add i 1
  end
  p = ulong 0
  while lt p n
    st = p
    while lt p n
      if eq get g_buf add off p 47
        break
      end
      p = add p 1
    end
    m = sub p st
    if eq m 0
      ret 0
    end
    if eq m 1
      if eq get g_buf add off st 46
        ret 0
      end
    end
    if eq m 2
      if eq get g_buf add off st 46
        if eq get g_buf add add off st 1 46
          ret 0
        end
      end
    end
    if lt p n
      p = add p 1
      if eq p n
        ret 0
      end
    end
  end
  ret 1
end

fn join_root off ulong n ulong to int
  rl = get g_meta 0
  if ge add add rl 1 n 1023
    ret -1
  end
  i = ulong 0
  while lt i rl
    put g_path i get g_root i
    i = add i 1
  end
  put g_path rl uchar 47
  p = add rl 1
  i = ulong 0
  while lt i n
    put g_path add p i get g_buf add off i
    i = add i 1
  end
  put g_meta 9 add p n
  ret 0
end

fn join_rdir to int
  rl = get g_meta 1
  if ge add add rl 1 64 1023
    ret -1
  end
  i = ulong 0
  while lt i rl
    put g_path i get g_rdir i
    i = add i 1
  end
  put g_path rl uchar 47
  p = add rl 1
  i = ulong 0
  while lt i 64
    put g_path add p i get g_rcpt_id i
    i = add i 1
  end
  put g_meta 9 add p 64
  ret 0
end

fn file_sha_path to int
  plen = get g_meta 9
  fd = fopen g_path 0 plen 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while eq int 1 1
    rem_cap = sub 16777216 tot
    if eq rem_cap 0
      ign = fclose int fd
      ret -1
    end
    chunk = rem_cap
    if gt chunk 65536
      chunk = 65536
    end
    nr = read int fd sh_dat tot chunk
    if lt nr 0
      ign = fclose int fd
      ret -1
    end
    if eq nr 0
      break
    end
    tot = add tot ulong nr
  end
  ign = fclose int fd
  sh_all tot
  i = ulong 0
  while lt i 32
    b = uint get sh_dig i
    put g_hex mul i 2 sh_hexd and shr b 4 15
    put g_hex add mul i 2 1 sh_hexd and b 15
    i = add i 1
  end
  ret 0
end

fn hex_eq_buf off ulong to int
  i = ulong 0
  while lt i 64
    if ne get g_hex i get g_buf add off i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn hex_eq_rcpt to int
  i = ulong 0
  while lt i 64
    if ne get g_hex i get g_rcpt_id i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn anc_record_dig doff ulong to void
  nd = get g_meta 8
  seen = int 0
  k = ulong 0
  while lt k nd
    eqd = int 1
    base = mul k 64
    j = ulong 0
    while lt j 64
      a = get g_dig add base j
      b = get g_buf add doff j
      if ne a b
        eqd = 0
        break
      end
      j = add j 1
    end
    if eq eqd 1
      seen = 1
      break
    end
    k = add k 1
  end
  if eq seen 0
    if lt nd 16
      base = mul nd 64
      j = ulong 0
      while lt j 64
        b = get g_buf add doff j
        put g_dig add base j b
        j = add j 1
      end
      put g_meta 8 add nd 1
    end
  end
end

fn anc_matches_raw vo ulong sp ulong to int
  idl = get g_meta 5
  if ne sp sub idl 4
    ret 0
  end
  j = ulong 0
  while lt j sp
    if ne get g_buf add vo j get g_id add 4 j
      ret 0
    end
    j = add j 1
  end
  ret 1
end

fn check_ancestry start_i ulong is_abs int to long
  i = start_i
  na = ulong 0
  put g_meta 8 0
  while eq key_match i t_k_ancestry 1
    vo = get g_kv 0
    vl = get g_kv 1
    sp = ulong 0
    found = int 0
    while lt sp vl
      if eq get g_buf add vo sp 32
        found = 1
        break
      end
      sp = add sp 1
    end
    if eq found 0
      ign = err_set1 add i 1 e_exp_anc
      ret -1
    end
    if eq is_taskid vo sp 0
      ign = err_set1 add i 1 e_exp_anc
      ret -1
    end
    doff = add vo add sp 1
    dlen = sub sub vl sp 1
    if eq is_hex64 doff dlen 0
      ign = err_set1 add i 1 e_exp_anc
      ret -1
    end
    if gt na 0
      if ge buf_cmp_prev vo sp 0
        ign = err_set1 add i 1 e_anc_ord
        ret -1
      end
    end
    anc_record_dig doff
    if eq is_abs 0
      if eq anc_matches_raw vo sp 0
        ign = err_set1 add i 1 e_raw_anc
        ret -1
      end
    end
    prev_set vo sp
    na = add na 1
    i = add i 1
  end
  if lt na 1
    ign = err_set1 add i 1 e_need_anc
    ret -1
  end
  if eq is_abs 0
    if ne na 1
      ign = err_set1 add i 1 e_raw_anc1
      ret -1
    end
  else
    if lt na 2
      ign = err_set1 add i 1 e_abs_anc2
      ret -1
    end
    if lt get g_meta 8 2
      ign = err_set1 add i 1 e_abs_anc2
      ret -1
    end
  end
  ret long i
end

fn check_sources start_i ulong to long
  i = start_i
  ns = ulong 0
  while eq key_match i t_k_source 1
    vo = get g_kv 0
    vl = get g_kv 1
    sp = ulong 0
    found = int 0
    j = ulong 0
    while lt j vl
      if eq get g_buf add vo j 32
        sp = j
        found = 1
      end
      j = add j 1
    end
    if eq found 0
      ign = err_set1 add i 1 e_exp_src
      ret -1
    end
    if ge sp 256
      ign = err_set1 add i 1 e_exp_src
      ret -1
    end
    doff = add vo add sp 1
    dlen = sub sub vl sp 1
    if eq safe_path vo sp 0
      ign = err_set1 add i 1 e_exp_rsrc
      ret -1
    end
    if eq is_hex64 doff dlen 0
      ign = err_set1 add i 1 e_exp_rsrc
      ret -1
    end
    if gt ns 0
      if ge buf_cmp_prev vo sp 0
        ign = err_set1 add i 1 e_src_ord
        ret -1
      end
    end
    if eq get g_meta 10 1
      if ne join_root vo sp 0
        if eq err_begin add i 1 e_src_read1 1
          err_add_buf vo sp
          err_add_lit e_src_read2
        end
        ret -1
      end
      if ne file_sha_path 0
        if eq err_begin add i 1 e_src_read1 1
          err_add_buf vo sp
          err_add_lit e_src_read2
        end
        ret -1
      end
      if eq hex_eq_buf doff 0
        if eq err_begin add i 1 e_src_stale 1
          err_add_buf vo sp
        end
        ret -1
      end
    end
    prev_set vo sp
    ns = add ns 1
    i = add i 1
  end
  if lt ns 1
    ign = err_set1 add i 1 e_need_src
    ret -1
  end
  ret long i
end

fn buf_eq_fpr doff ulong to int
  j = ulong 0
  while lt j 64
    a = get g_buf add doff j
    b = get g_fpr j
    if ne a b
      ret 0
    end
    j = add j 1
  end
  ret 1
end

fn check_differs start_i ulong to long
  i = start_i
  nd = ulong 0
  while eq key_match i t_k_differs 1
    vo = get g_kv 0
    vl = get g_kv 1
    sp = ulong 0
    found = int 0
    while lt sp vl
      if eq get g_buf add vo sp 32
        found = 1
        break
      end
      sp = add sp 1
    end
    if eq found 0
      ign = err_set1 add i 1 e_exp_dif
      ret -1
    end
    if eq is_taskid vo sp 0
      ign = err_set1 add i 1 e_exp_dif
      ret -1
    end
    doff = add vo add sp 1
    dlen = sub sub vl sp 1
    if eq is_hex64 doff dlen 0
      ign = err_set1 add i 1 e_exp_dif
      ret -1
    end
    if gt nd 0
      if ge buf_cmp_prev vo sp 0
        ign = err_set1 add i 1 e_dif_ord
        ret -1
      end
    end
    if eq buf_eq_fpr doff 1
      if eq err_begin add i 1 e_dif_eq 1
        err_add_buf vo sp
      end
      ret -1
    end
    prev_set vo sp
    nd = add nd 1
    i = add i 1
  end
  if lt nd 2
    ign = err_set1 add i 1 e_need_dif
    ret -1
  end
  ret long i
end

fn check_abs_fields start_i ulong sigl ulong to long
  i = start_i
  np = get g_sig_m 2
  nargs = ulong 0
  k = ulong 0
  while lt k np
    if eq buf_eq_lit get g_sig_poff k get g_sig_plen_s k t_res 1
      ign = err_set1 sigl e_res_param
      ret -1
    end
    al = get g_sig_arr k
    if gt al 0
      nargs = add nargs al
    else
      nargs = add nargs 1
    end
    k = add k 1
  end
  if lt scalar_idx get g_sig_m 3 get g_sig_m 4 0
    ign = err_set1 sigl e_abs_ret
    ret -1
  end
  if eq key_match i t_k_pre 0
    ign = err_set1 add i 1 e_exp_pre
    ret -1
  end
  if eq buf_pfx_lit get g_kv 0 get g_kv 1 t_stated 0
    ign = err_set1 add i 1 e_pre_tag
    ret -1
  end
  if le get g_kv 1 14
    ign = err_set1 add i 1 e_pre_tag
    ret -1
  end
  i = add i 1
  if eq key_match i t_k_post 0
    ign = err_set1 add i 1 e_exp_post
    ret -1
  end
  if eq buf_pfx_lit get g_kv 0 get g_kv 1 t_stated 0
    ign = err_set1 add i 1 e_post_tag
    ret -1
  end
  if le get g_kv 1 14
    ign = err_set1 add i 1 e_post_tag
    ret -1
  end
  i = add i 1
  if eq key_match i t_k_example 0
    ign = err_set1 add i 1 e_exp_ex
    ret -1
  end
  if ne parse_call get g_kv 0 get g_kv 1 nargs 0 add i 1 0 0
    ret -1
  end
  i = add i 1
  nlim = ulong 0
  while eq key_match i t_k_limit 1
    vl = get g_kv 1
    if lt vl 1
      ign = err_set1 add i 1 e_lim_len
      ret -1
    end
    if gt vl 160
      ign = err_set1 add i 1 e_lim_len
      ret -1
    end
    nlim = add nlim 1
    i = add i 1
  end
  if eq nlim 0
    ign = err_set1 add i 1 e_need_lim
    ret -1
  end
  while eq key_match i t_k_counter 1
    if ne parse_call get g_kv 0 get g_kv 1 nargs 1 add i 1 1 0
      ret -1
    end
    i = add i 1
  end
  if eq key_match i t_k_fpr 0
    ign = err_set1 add i 1 e_exp_fpr
    ret -1
  end
  if eq is_hex64 get g_kv 0 get g_kv 1 0
    ign = err_set1 add i 1 e_exp_fpr
    ret -1
  end
  fo = get g_kv 0
  j = ulong 0
  while lt j 64
    put g_fpr j get g_buf add fo j
    j = add j 1
  end
  j = ulong 0
  while lt j 16
    if ne get g_fpr j get g_id add 4 j
      ign = err_set1 add i 1 e_id_fpr
      ret -1
    end
    j = add j 1
  end
  i = add i 1
  ret check_differs i
end

fn check_rcpt_l2 l1_len ulong nl2 ulong to int
  idl = get g_meta 5
  want_l2 = add add len t_rcpt_l2 idl 1
  got_l2 = sub add nl2 1 l1_len
  if ne got_l2 want_l2
    ret err_set1 11 e_rcpt_who
  end
  j = ulong 0
  while lt j len t_rcpt_l2
    a = get g_rcpt_head add l1_len j
    b = get t_rcpt_l2 j
    if ne a b
      ret err_set1 11 e_rcpt_who
    end
    j = add j 1
  end
  l2_id = add l1_len len t_rcpt_l2
  j = ulong 0
  while lt j idl
    a = get g_rcpt_head add l2_id j
    b = get g_id j
    if ne a b
      ret err_set1 11 e_rcpt_who
    end
    j = add j 1
  end
  ret 0
end

fn check_receipt_file to int
  if eq get g_meta 11 0
    ret 0
  end
  if ne join_rdir 0
    if eq err_begin 11 e_rcpt_m1 1
      err_add_rcpt
      err_add_lit e_rcpt_m2
    end
    ret -1
  end
  if ne file_sha_path 0
    if eq err_begin 11 e_rcpt_m1 1
      err_add_rcpt
      err_add_lit e_rcpt_m2
    end
    ret -1
  end
  if eq hex_eq_rcpt 0
    ret err_set1 11 e_rcpt_hash
  end
  plen = get g_meta 9
  fd = fopen g_path 0 plen 0 0
  if lt fd 0
    ret err_set1 11 e_rcpt_short
  end
  nr = read int fd g_rcpt_head 0 512
  ign = fclose int fd
  if le nr 0
    ret err_set1 11 e_rcpt_short
  end
  n = ulong nr
  nl1 = ulong 0
  f1 = int 0
  while lt nl1 n
    if eq get g_rcpt_head nl1 10
      f1 = 1
      break
    end
    nl1 = add nl1 1
  end
  if eq f1 0
    ret err_set1 11 e_rcpt_short
  end
  l1_len = add nl1 1
  nl2 = l1_len
  f2 = int 0
  while lt nl2 n
    if eq get g_rcpt_head nl2 10
      f2 = 1
      break
    end
    nl2 = add nl2 1
  end
  if eq f2 0
    ret err_set1 11 e_rcpt_short
  end
  if ne l1_len len t_rcpt_l1
    ret err_set1 11 e_rcpt_who
  end
  j = ulong 0
  while lt j l1_len
    a = get g_rcpt_head j
    b = get t_rcpt_l1 j
    if ne a b
      ret err_set1 11 e_rcpt_who
    end
    j = add j 1
  end
  ret check_rcpt_l2 l1_len nl2
end

note Saved signature span across helpers: [0]=sig_o [1]=sig_l [2]=sigl [3]=is_abs
global g_rec_st ulong 4

fn check_body i ulong to int
  nl = get g_nl 0
  if ge i nl
    ret err_set1 add i 1 e_exp_body
  end
  if eq buf_eq_lit get g_lofs i get g_llen i t_k_body 0
    ret err_set1 add i 1 e_exp_body
  end
  b0 = add i 1
  blines = sub nl b0
  if lt blines 1
    ret err_set1 add i 1 e_body_cnt
  end
  if gt blines 400
    ret err_set1 add i 1 e_body_cnt
  end
  nfn = ulong 0
  lastfn = ulong 0
  k = b0
  while lt k nl
    if eq buf_pfx_lit get g_lofs k get g_llen k t_fn_sp 1
      nfn = add nfn 1
      lastfn = k
    end
    k = add k 1
  end
  if eq nfn 0
    ret err_set1 add b0 1 e_body_nofn
  end
  end_i = sub nl 1
  if eq buf_eq_lit get g_lofs end_i get g_llen end_i t_end 0
    ret err_set1 nl e_body_end
  end
  if eq get g_rec_st 3 1
    if ne nfn 1
      ret err_set1 add b0 1 e_body_abs1
    end
    if eq buf_pfx_lit get g_lofs b0 get g_llen b0 t_fn_sp 0
      ret err_set1 add b0 1 e_body_abs1
    end
    if eq buf_eq_buf get g_lofs b0 get g_llen b0 get g_rec_st 0 get g_rec_st 1 0
      ret err_set1 get g_rec_st 2 e_sig_b1
    end
  else
    if eq buf_eq_buf get g_lofs lastfn get g_llen lastfn get g_rec_st 0 get g_rec_st 1 0
      ret err_set1 get g_rec_st 2 e_sig_bl
    end
  end
  ret check_receipt_file
end

fn check_header to long
  nl = get g_nl 0
  if lt nl 1
    ign = err_set1 1 e_line1
    ret -1
  end
  if eq buf_eq_lit get g_lofs 0 get g_llen 0 t_genrec1 0
    ign = err_set1 1 e_line1
    ret -1
  end
  if eq key_match 1 t_k_id 0
    ign = err_set1 2 e_exp_id
    ret -1
  end
  id_o = get g_kv 0
  id_l = get g_kv 1
  if gt id_l 127
    id_l = 127
  end
  j = ulong 0
  while lt j id_l
    put g_id j get g_buf add id_o j
    j = add j 1
  end
  put g_meta 5 id_l
  if eq key_match 2 t_k_kind 0
    ign = err_set1 3 e_exp_kind
    ret -1
  end
  is_abs = ulong 0
  if eq buf_eq_lit get g_kv 0 get g_kv 1 t_abs 1
    is_abs = 1
  else
    if eq buf_eq_lit get g_kv 0 get g_kv 1 t_raw 0
      ign = err_set1 3 e_exp_kind
      ret -1
    end
  end
  put g_rec_st 3 is_abs
  if eq is_abs 1
    if ne id_l 20
      ign = err_set1 2 e_abs_id
      ret -1
    end
    if eq buf_pfx_lit id_o id_l t_abs_pfx 0
      ign = err_set1 2 e_abs_id
      ret -1
    end
    k = ulong 4
    while lt k 20
      if eq is_hex_ch get g_buf add id_o k 0
        ign = err_set1 2 e_abs_id
        ret -1
      end
      k = add k 1
    end
  else
    if eq buf_pfx_lit id_o id_l t_raw_pfx 0
      ign = err_set1 2 e_raw_id
      ret -1
    end
    if eq is_taskid add id_o 4 sub id_l 4 0
      ign = err_set1 2 e_raw_id
      ret -1
    end
  end
  if eq key_match 3 t_k_split 0
    ign = err_set1 4 e_exp_split
    ret -1
  end
  is_corp = buf_eq_lit get g_kv 0 get g_kv 1 t_corpus
  is_prb = buf_eq_lit get g_kv 0 get g_kv 1 t_probe
  if eq add is_corp is_prb 0
    ign = err_set1 4 e_exp_split
    ret -1
  end
  if eq is_abs 1
    if eq is_corp 0
      ign = err_set1 4 e_abs_split
      ret -1
    end
  end
  if eq key_match 4 t_k_family 0
    ign = err_set1 5 e_exp_fam
    ret -1
  end
  if eq famlist_ok get g_kv 0 get g_kv 1 0
    ign = err_set1 5 e_exp_fam
    ret -1
  end
  if eq is_abs 0
    j = ulong 0
    while lt j get g_kv 1
      if eq get g_buf add get g_kv 0 j 32
        ign = err_set1 5 e_raw_fam
        ret -1
      end
      j = add j 1
    end
  end
  ret 5
end

fn check_sig_block to long
  nl = get g_nl 0
  if eq key_match 5 t_k_entry 0
    ign = err_set1 6 e_exp_entry
    ret -1
  end
  ent_o = get g_kv 0
  ent_l = get g_kv 1
  pars_o = ulong 0
  pars_l = ulong 0
  if lt 6 nl
    if eq buf_eq_lit get g_lofs 6 get g_llen 6 t_k_params 1
      pars_o = 0
      pars_l = 0
    else
      if eq key_match 6 t_k_params 0
        ign = err_set1 7 e_exp_params
        ret -1
      end
      pars_o = get g_kv 0
      pars_l = get g_kv 1
    end
  else
    ign = err_set1 7 e_exp_params
    ret -1
  end
  if eq key_match 7 t_k_ret 0
    ign = err_set1 8 e_exp_ret
    ret -1
  end
  rt_o = get g_kv 0
  rt_l = get g_kv 1
  if eq key_match 8 t_k_sig 0
    ign = err_set1 9 e_exp_sig
    ret -1
  end
  sig_o = get g_kv 0
  sig_l = get g_kv 1
  put g_rec_st 0 sig_o
  put g_rec_st 1 sig_l
  put g_rec_st 2 9
  if ne parse_sig sig_o sig_l 9 0
    ret -1
  end
  if eq buf_eq_buf ent_o ent_l get g_sig_m 0 get g_sig_m 1 0
    ign = err_set1 6 e_ent_diff
    ret -1
  end
  if ne check_params_ret pars_o pars_l rt_o rt_l 6 0
    ret -1
  end
  ret 9
end

fn check_desc_rcpt_val to long
  if eq key_match 9 t_k_desc 0
    ign = err_set1 10 e_exp_desc
    ret -1
  end
  dl = get g_kv 1
  if lt dl 1
    ign = err_set1 10 e_desc_len
    ret -1
  end
  if gt dl 160
    ign = err_set1 10 e_desc_len
    ret -1
  end
  if eq key_match 10 t_k_receipt 0
    ign = err_set1 11 e_exp_rcpt
    ret -1
  end
  if eq is_hex64 get g_kv 0 get g_kv 1 0
    ign = err_set1 11 e_exp_rcpt
    ret -1
  end
  j = ulong 0
  while lt j 64
    put g_rcpt_id j get g_buf add get g_kv 0 j
    j = add j 1
  end
  if eq key_match 11 t_k_validity 0
    ign = err_set1 12 e_exp_val
    ret -1
  end
  v1 = buf_eq_lit get g_kv 0 get g_kv 1 t_verified
  v2 = buf_eq_lit get g_kv 0 get g_kv 1 t_unverified
  if eq add v1 v2 0
    ign = err_set1 12 e_exp_val
    ret -1
  end
  ret 12
end

fn check_record to int
  if lt check_header 0
    ret -1
  end
  if lt check_sig_block 0
    ret -1
  end
  if lt check_desc_rcpt_val 0
    ret -1
  end
  is_abs = int get g_rec_st 3
  ri = check_ancestry 12 is_abs
  if lt ri 0
    ret -1
  end
  ri2 = check_sources ulong ri
  if lt ri2 0
    ret -1
  end
  i = ulong ri2
  if eq is_abs 1
    ri3 = check_abs_fields i get g_rec_st 2
    if lt ri3 0
      ret -1
    end
    i = ulong ri3
  end
  ret check_body i
end

fn has_two_spaces st ulong ll ulong to int
  j = ulong 0
  while lt add j 1 ll
    c1 = get g_buf add st j
    if eq c1 32
      c2 = get g_buf add add st j 1
      if eq c2 32
        ret 1
      end
    end
    j = add j 1
  end
  ret 0
end

fn load_file to int
  flen = get g_meta 2
  fd = fopen g_file 0 flen 0 0
  if lt fd 0
    ret err_set1 0 e_open
  end
  tot = ulong 0
  while lt tot add RC_MAXB 1
    nr = read int fd g_buf tot sub add RC_MAXB 1 tot
    if le nr 0
      break
    end
    tot = add tot ulong nr
  end
  ign = fclose int fd
  if gt tot RC_MAXB
    ret err_set1 0 e_over64k
  end
  if eq tot 0
    ret err_set1 0 e_empty_lf
  end
  if ne get g_buf sub tot 1 10
    ret err_set1 0 e_empty_lf
  end
  put g_nl 0 0
  line = ulong 1
  st = ulong 0
  k = ulong 0
  while lt k tot
    c = get g_buf k
    if eq c 10
      ll = sub k st
      if eq ll 0
        ret err_set1 line e_empty_line
      end
      if gt ll RC_MAXL
        ret err_set1 line e_line_long
      end
      if eq get g_buf st 32
        ret err_set1 line e_edge_sp
      end
      if eq get g_buf sub k 1 32
        ret err_set1 line e_edge_sp
      end
      if eq has_two_spaces st ll 1
        ret err_set1 line e_two_sp
      end
      nl = get g_nl 0
      if eq nl RC_MAXLINES
        ret err_set1 line e_many_lines
      end
      put g_lofs nl st
      put g_llen nl ll
      put g_nl 0 add nl 1
      st = add k 1
      line = add line 1
    else
      if lt c 32
        ret err_set1 line e_non_ascii
      end
      if gt c 126
        ret err_set1 line e_non_ascii
      end
    end
    k = add k 1
  end
  ret 0
end

fn arg_eq_lit n ulong s view uchar * to int
  if ne n len s
    ret 0
  end
  i = ulong 0
  while lt i n
    if ne get g_arg i get s i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn print_ok to void
  p = out_push_lit 0 t_ok
  l1o = get g_lofs 1
  l1l = get g_llen 1
  i = ulong 3
  while lt i l1l
    if lt p 1020
      put g_out p get g_buf add l1o i
      p = add p 1
    end
    i = add i 1
  end
  p = out_push_lit p t_nl
  wr_out 1 p
end

fn print_refused to void
  p = out_push_lit 0 t_refused
  fl = get g_meta 2
  i = ulong 0
  while lt i fl
    if lt p 1020
      put g_out p get g_file i
      p = add p 1
    end
    i = add i 1
  end
  p = out_push_lit p t_line_sep
  p = out_push_u64 p get g_meta 4
  p = out_push_lit p t_col_sp
  el = get g_meta 3
  i = ulong 0
  while lt i el
    if lt p 1020
      put g_out p get g_err i
      p = add p 1
    end
    i = add i 1
  end
  p = out_push_lit p t_nl
  wr_out 1 p
end

fn main to int
  ac = ulong argcnt
  put g_meta 10 0
  put g_meta 11 0
  ai = ulong 1
  while lt ai ac
    n = argread ai g_arg 0 1023
    if lt n 2
      break
    end
    if ne get g_arg 0 45
      break
    end
    if ne get g_arg 1 45
      break
    end
    if eq arg_eq_lit ulong n t_flag_root 1
      if ge add ai 1 ac
        wr_lit 2 t_usage
        ret 2
      end
      rn = argread add ai 1 g_root 0 1023
      if lt rn 0
        wr_lit 2 t_usage
        ret 2
      end
      put g_meta 0 ulong rn
      put g_meta 10 1
      ai = add ai 2
    else
      if eq arg_eq_lit ulong n t_flag_rcpt 1
        if ge add ai 1 ac
          wr_lit 2 t_usage
          ret 2
        end
        rn = argread add ai 1 g_rdir 0 1023
        if lt rn 0
          wr_lit 2 t_usage
          ret 2
        end
        put g_meta 1 ulong rn
        put g_meta 11 1
        ai = add ai 2
      else
        wr_lit 2 t_usage
        ret 2
      end
    end
  end
  if ge ai ac
    wr_lit 2 t_usage
    ret 2
  end
  bad = int 0
  while lt ai ac
    fn_n = argread ai g_file 0 1023
    if lt fn_n 0
      wr_lit 2 t_usage
      ret 2
    end
    put g_meta 2 ulong fn_n
    put g_meta 3 0
    put g_meta 4 0
    rc = load_file
    if eq rc 0
      rc = check_record
    end
    if eq rc 0
      print_ok
    else
      print_refused
      bad = 1
    end
    ai = add ai 1
  end
  ret bad
end

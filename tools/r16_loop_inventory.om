fn rw_sp_eq b ulong f ulong so ulong sl ulong to bool
ao = get rw_off add b f
al = get rw_len add b f
ret sp_eq ao al so sl
end

fn site_matches_row i ulong j ulong to bool
if ne get rw_ridx j long get st_repo i
ret false
end
b = mul j 11
if not rw_sp_eq b 2 get st_po i get st_pl i
ret false
end
if not rw_sp_eq b 4 get st_so i get st_sl i
ret false
end
ret rw_sp_eq b 10 get st_eo i get st_el i
end

fn manual_present_row ur ulong b ulong to bool
po = get rw_off add b 2
pl = get rw_len add b 2
eo = get rw_off add b 10
el = get rw_len add b 10
ret manual_present get defp_o ur get defp_l ur po pl eo el
end

fn join_sites_and_manual to void
ns = get nsites 0
nr = get nrows 0
for i ulong ns bound 16384
for j ulong nr bound 8192
if site_matches_row i j
put st_row i long j
put rw_hits j add get rw_hits j 1
break
end
end
end
for j ulong nr bound 8192
ri = get rw_ridx j
if lt ri 0
continue
end
if ne get rskip ulong ri 0
continue
end
b = mul j 11
if not sp_starts_t get rw_off add b 3 get rw_len add b 3 t_manual
continue
end
put v_manual 0 add get v_manual 0 1
if eq get rw_hits j 0
ur = ulong ri
if manual_present_row ur b
put rw_hits j 1
end
end
end
end

fn sp_dup_slice ho ulong hl ulong to ulong
sp_reserve hl
po = get sp_len 0
for k ulong hl bound 4096
put sp add po k get sp add ho k
end
put sp_len 0 add po hl
ret po
end

fn setup_repo_paths to void
hm = env_get t_env_home
ho = ulong 0
hl = ulong 0
if ge hm 0
ho = shr ulong hm 32
hl = and ulong hm 4294967295
else
ho = sp_add_t t_dot
hl = 1
end
for r ulong NREPO bound 6
ev = env_get_repo r
has_ev = false
if ge ev 0
if gt and ulong ev 4294967295 0
has_ev = true
end
end
if has_ev
put defp_o r shr ulong ev 32
put defp_l r and ulong ev 4294967295
else
if eq r 0
put defp_o r sp_add_t t_dot
put defp_l r 1
else
po = sp_dup_slice ho hl
_a = sp_add_t t_ws_survey
_b = repo_name_o r
put defp_o r po
put defp_l r sub get sp_len 0 po
end
end
end
end

fn warn_head_mismatch r ulong to void
ml = get msha_l r
if eq ml 0
ret
end
hl = get head_l r
same = true
if lt hl ml
same = false
else
if not sp_eq get head_o r ml get msha_o r ml
same = false
end
end
if not same
eput_t t_e_warn
eput_repo r
eput_t t_e_warn2
h12 = hl
if gt h12 12
h12 = 12
end
eput_sp get head_o r h12
eput_t t_e_warn3
eput_sp get msha_o r ml
eputc 10
end
end

fn scan_all_repos to void
for r ulong NREPO bound 6
scan_repo r
if eq get rskip r 0
eput_t t_e_scanned
eput_repo r
eput_t t_e_head
eput_sp get head_o r get head_l r
eputc 32
eputc 40
eput_sp get defp_o r get defp_l r
eputc 41
eputc 10
warn_head_mismatch r
else
put v_skipped 0 add get v_skipped 0 1
eput_t t_e_skipped
eput_repo r
eput_t t_e_nogit
eput_sp get defp_o r get defp_l r
eput_t t_e_set
eput_repo_env r
eput_t t_e_notpass
end
end
end


fn is_prod_a po ulong pl ulong so ulong sl ulong to bool
if sp_has_t po pl t_legacy_oracle
ret false
end
if sp_has_t so sl t_legacy_oracle
ret false
end
if sp_has_t po pl t_reference
ret false
end
if sp_has_t so sl t_reference
ret false
end
ret true
end

fn site_is_prod_a i ulong to bool
ret is_prod_a get st_po i get st_pl i get st_so i get st_sl i
end

fn row_is_prod_a b ulong to bool
po = get rw_off add b 2
pl = get rw_len add b 2
so = get rw_off add b 4
sl = get rw_len add b 4
ret is_prod_a po pl so sl
end


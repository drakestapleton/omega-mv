eput_sp get st_eo i get st_el i
eputc 10
continue
end
b = mul ulong row 11
co = get rw_off add b 7
cl = get rw_len add b 7
if sp_eq_t co cl t_qmark
put v_qrows 0 add get v_qrows 0 1
eput_t t_e_quest
eput_sp get rw_off b get rw_len b
eputc 32
eput_repo get st_repo i
eputc 32
eput_sp get st_po i get st_pl i
eputc 58
eput_sp get st_lo i get st_ll i
eput_t t_e_colcol
eput_sp get rw_off add b 9 get rw_len add b 9
eputc 10
continue
end
if not class_ok co cl
put v_badcls 0 add get v_badcls 0 1
eput_t t_e_badcls
eput_sp get rw_off b get rw_len b
eputc 32
eputc 39
eput_sp co cl
eputc 39
eputc 10
continue
end
if eq get sp co 78
if not check_n_reason get rw_off add b 9 get rw_len add b 9
put v_badcls 0 add get v_badcls 0 1
eput_t t_e_nnoid
eput_sp get rw_off b get rw_len b
eput_t t_e_nnoid2
end
if trigger_has_wait get st_to i get st_tl i
put v_badcls 0 add get v_badcls 0 1
eput_t t_e_nwait
eput_sp get rw_off b get rw_len b
eputc 32
eputc 91
eput_sp get st_to i get st_tl i
eput_t t_e_nwait2
end
continue
end
if and eq get st_repo i 0 eq get sp co 65
if site_is_prod_a i
put v_areach 0 add get v_areach 0 1
eput_t t_e_areach
eput_sp get rw_off b get rw_len b
eput_t t_e_omega_sp
eput_sp get st_po i get st_pl i
eputc 58
eput_sp get st_lo i get st_ll i
eputc 32
eputc 91
eput_sp get st_so i get st_sl i
eput_t t_e_areach2
end
end
end
end


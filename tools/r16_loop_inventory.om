note ---- environment lookup ----
fn sp_add_tmp1_from off0 ulong vl ulong to ulong
sp_reserve vl
vo = get sp_len 0
for j ulong vl bound 8192
put sp add vo j get tmp1 add off0 j
end
put sp_len 0 add vo vl
ret vo
end

fn env_get name view uchar * to long
ec = envcnt
if lt ec 0
ret -1
end
nl = len name
for i ulong ulong ec bound 4096
r = envread i tmp1 0 8192
if le r 0
continue
end
rl = ulong r
if gt rl nl
if eq get tmp1 nl 61
if tmp1_at_t 0 name
vl = sub sub rl nl 1
vo = sp_add_tmp1_from add nl 1 vl
ret long or shl vo 32 vl
end
end
end
end
ret -1
end


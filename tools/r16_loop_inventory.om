ret false
end

fn term_word_idx wi ulong to long
if word_eq_t wi t_bw_poll
ret 0
end
if word_eq_t wi t_bw_sleep
ret 1
end
if word_eq_t wi t_bw_usleep
ret 1
end
if word_eq_t wi t_bw_nanosleep
ret 1
end
if word_eq_t wi t_bw_msleep
ret 1
end
if word_eq_t wi t_bw_wait
ret 2
end
if word_eq_t wi t_bw_recv
ret 3
end
if word_eq_t wi t_bw_heartbeat
ret 4
end
if word_eq_t wi t_bw_tick
ret 5
end
if word_eq_t wi t_bw_dispatch
ret 6
end
if word_eq_t wi t_bw_schedule
ret 7
end
if word_eq_t wi t_bw_scheduler
ret 7
end
if word_eq_t wi t_bw_sched
ret 7
end
if word_eq_t wi t_bw_orchestrate
ret 8
end
if word_eq_t wi t_bw_orchestrator
ret 8
end
if word_eq_t wi t_bw_orchestration
ret 8
end
if word_eq_t wi t_bw_turn
ret 9
end
if word_eq_t wi t_bw_turns
ret 9
end
if word_eq_t wi t_bw_step
ret 10
end
if word_eq_t wi t_bw_steps
ret 10
end
if word_eq_t wi t_bw_pulse
ret 11
end
if word_eq_t wi t_bw_yield
ret 12
end
ret -1
end

note ---- normalize whitespace into sp ----
fn norm_ws_orig off0 ulong n ulong to ulong
sp_reserve n
out_o = get sp_len 0
k = ulong 0
sp_f = ulong 0
for i ulong n bound 1000000000
c = get orig add off0 i
if eq c 13
continue
end
if or eq c 32 eq c 9
sp_f = 1
continue
end
if ne sp_f 0
if gt k 0
put sp add out_o k 32
k = add k 1
end
end
sp_f = 0
put sp add out_o k c
k = add k 1
end
put sp_len 0 add out_o k
ret k
end

fn norm_ws_strip off0 ulong n ulong to ulong
sp_reserve n
out_o = get sp_len 0
k = ulong 0
sp_f = ulong 0
for i ulong n bound 1000000000
c = get stripped add off0 i
if eq c 13
continue
end
if or eq c 32 eq c 9
sp_f = 1
continue
end
if ne sp_f 0
if gt k 0
put sp add out_o k 32
k = add k 1
end
end
sp_f = 0
put sp add out_o k c
k = add k 1
end
put sp_len 0 add out_o k
ret k
end

fn norm_ws_sp off0 ulong n ulong to ulong
sp_reserve n
out_o = get sp_len 0
k = ulong 0
sp_f = ulong 0
for i ulong n bound 1000000000
c = get sp add off0 i
if eq c 13
continue
end
if or eq c 32 eq c 9
sp_f = 1
continue
end
if ne sp_f 0
if gt k 0
put sp add out_o k 32
k = add k 1
end
end
sp_f = 0
put sp add out_o k c
k = add k 1
end
put sp_len 0 add out_o k
ret k
end

note ---- strip_code: blank comments & literals in stripped[0..n) ----
fn strip_block_comment i0 ulong n ulong rust ulong to ulong
i = i0
depth = ulong 0
while lt i n bound 1000000000
if lt add i 1 n
c0 = get stripped i
c1 = get stripped add i 1
if and eq c0 47 eq c1 42
depth = add depth 1
put stripped i 32
put stripped add i 1 32
i = add i 2
if eq rust 0
depth = 1
end
continue
end
if and eq c0 42 eq c1 47
depth = sub depth 1
put stripped i 32
put stripped add i 1 32
i = add i 2
if eq depth 0
break
end
continue
end
end
if ne get stripped i 10
put stripped i 32
end
i = add i 1
if eq depth 0
break
end
end
ret i
end

fn strip_rust_raw i0 ulong n ulong is_b ulong to ulong
j = add i0 1
if ne is_b 0
j = add i0 2
end
hashes = ulong 0
while lt j n bound 1000000000
if ne get stripped j 35
break
end
hashes = add hashes 1
j = add j 1
end
ok_q = false
if lt j n
if eq get stripped j 34
ok_q = true
end
end
if not ok_q
ret add i0 1
end
j = add j 1
while lt j n bound 1000000000
if eq get stripped j 34
h = ulong 0
while lt h hashes bound 1000000000
if ge add add j 1 h n
break
end
if ne get stripped add add j 1 h 35
break
end
h = add h 1
end
if eq h hashes
j = add add j 1 h
break
end
end
j = add j 1
end
k = i0
while lt k j bound 1000000000
if ge k n
break
end
if ne get stripped k 10
put stripped k 32
end
k = add k 1
end
ret j
end

fn strip_char_lit i0 ulong n ulong rust ulong to ulong
j = add i0 1
lit = ulong 0
if lt j n
if eq get stripped j 92
lit = 1
else
k = add j 1
lim = add j 4
while lt k n bound 8
if gt k lim
break
end
if eq get stripped k 39
lit = 1
break
end
k = add k 1
end
if ne rust 0
if is_id get stripped j
qnext = false
if lt add j 1 n
if eq get stripped add j 1 39
qnext = true
end
end
if not qnext
lit = 0
end
end
end
end
end
if eq lit 0
ret add i0 1
end
put stripped i0 32
i = add i0 1
while lt i n bound 1000000000
c = get stripped i
if or eq c 39 eq c 10
break
end
if eq c 92
if lt add i 1 n
put stripped i 32
i = add i 1
end
end
put stripped i 32
i = add i 1
end
if lt i n
if eq get stripped i 39
put stripped i 32
i = add i 1
end
end
ret i
end

fn strip_code n ulong rust ulong to void
i = ulong 0
while lt i n bound 1000000000
c = get stripped i
if eq c 47
if lt add i 1 n
c2 = get stripped add i 1
if eq c2 47
while lt i n bound 1000000000
if eq get stripped i 10
break
end
put stripped i 32
i = add i 1
end
continue
end
if eq c2 42
i = strip_block_comment i n rust
continue
end
end
i = add i 1
continue
end
if ne rust 0
is_r = false
is_br = false
if eq c 114
is_r = true
end
if eq c 98
if lt add i 1 n
if eq get stripped add i 1 114
is_br = true
end
end
end
if or is_r is_br
prev_ok = true
if gt i 0
if is_id get stripped sub i 1
prev_ok = false
end
end
if prev_ok
ib = ulong 0
if is_br
ib = 1
end
i = strip_rust_raw i n ib
continue
end
end
end
if eq c 34
put stripped i 32
i = add i 1
while lt i n bound 1000000000
if eq get stripped i 34
break
end
if eq get stripped i 92
if lt add i 1 n
put stripped i 32
i = add i 1
end
end
if ne get stripped i 10
put stripped i 32
end
i = add i 1
end
if lt i n
put stripped i 32
i = add i 1
end
continue
end
if eq c 39
i = strip_char_lit i n rust
continue
end
i = add i 1
end
end

note ---- identifier splitting & named terms ----
fn split_words off0 ulong idlen ulong to ulong
nw = ulong 0
i = ulong 0
while lt i idlen bound 10000
if ge nw 16
break
end
while lt i idlen bound 10000
if is_alpha get stripped add off0 i
break
end
i = add i 1
end
if ge i idlen
break
end
s = i
if is_upper get stripped add off0 i
i = add i 1
up2 = false
if lt i idlen
if is_upper get stripped add off0 i
up2 = true
end
end
if up2
while lt i idlen bound 10000
if not is_upper get stripped add off0 i
break
end
if lt add i 1 idlen
if is_lower get stripped add off0 add i 1
break
end
end
i = add i 1
end
else
while lt i idlen bound 10000
if not is_lower get stripped add off0 i
break
end
i = add i 1
end
end
else
while lt i idlen bound 10000
if not is_lower get stripped add off0 i
break
end
i = add i 1
end
end
wl = sub i s
if gt wl 39
wl = 39
end
base = mul nw 40
for k ulong wl bound 40
put wbuf add base k to_lower get stripped add off0 add s k
end
put wlen nw wl
nw = add nw 1
end
ret nw
end

fn norm_ident_tmp1 off0 ulong idlen ulong to ulong
k = ulong 0
for i ulong idlen bound 10000
if ge k 255
break
end
c = get stripped add off0 i
if ne c 95
put tmp1 k to_lower c
k = add k 1
end
end
ret k
end

fn named_in_ident off0 ulong idlen ulong to long
k = norm_ident_tmp1 off0 idlen
if tmp1_has_t k t_nm0
ret 0
end
if tmp1_eq_t k t_nm1
ret 1
end
if tmp1_eq_t k t_nm2
ret 2
end
ret -1
end

fn named_count_in_ident off0 ulong idlen ulong to long
k = norm_ident_tmp1 off0 idlen
if tmp1_has_t k t_nm0
ret 0
end
if tmp1_has_t k t_nm1
ret 1
end
if tmp1_has_t k t_nm2
ret 2
end
ret -1
end

fn copy_word_tmp2 w ulong to ulong
wl = get wlen w
base = mul w 40
for k ulong wl bound 40
put tmp2 k get wbuf add base k
end
ret wl
end

note find_body_word: returns word length (0 if none), writes word into tmp2[0..wl)
fn find_body_word a ulong b ulong to ulong
i = a
while lt i b bound 1000000000
c = get stripped i
start_id = false
if is_id c
if eq i 0
start_id = true
else
if not is_id get stripped sub i 1
start_id = true
end
end
end
if start_id
j = i
while lt j b bound 1000000000
if not is_id get stripped j
break
end
j = add j 1
end
nw = split_words i sub j i
for w ulong nw bound 16
if is_body_word w
ret copy_word_tmp2 w
end
end
i = j
else
i = add i 1
end
end
ret 0
end

note ---- add_site ----
fn fmt_u_tmp1 v ulong to ulong
d = new uchar 24 0
k = ulong 0
x = v
while true bound 24
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
n = ulong 0
while gt k 0 bound 24
k = sub k 1
put tmp1 n get d k
n = add n 1
end
ret n
end

fn append_line_num idx ulong line ulong to void
old_o = get st_lo idx
old_l = get st_ll idx
nl = fmt_u_tmp1 line
sp_reserve add add old_l 1 nl
new_o = get sp_len 0
for i ulong old_l bound 10000
put sp add new_o i get sp add old_o i
end
put sp add new_o old_l 44
for i ulong nl bound 24
put sp add add new_o add old_l 1 i get tmp1 i
end
put sp_len 0 add new_o add add old_l 1 nl
put st_lo idx new_o
put st_ll idx add add old_l 1 nl
end

global pend_so ulong 1
global pend_sl ulong 1
global pend_eo ulong 1
global pend_el ulong 1
global pend_to ulong 1
global pend_tl ulong 1

fn site_matches_pend ui ulong to bool
if not sp_eq get st_so ui get st_sl ui get pend_so 0 get pend_sl 0
ret false
end
ret sp_eq get st_eo ui get st_el ui get pend_eo 0 get pend_el 0
end

fn record_site repo ulong po ulong pl ulong line ulong to void
ns = get nsites 0
i = sub long ns 1
while ge i 0 bound 16384
ui = ulong i
if ne get st_repo ui repo
break
end
if not sp_eq get st_po ui get st_pl ui po pl
break
end
if site_matches_pend ui
if eq get st_fline ui line
ret
end
append_line_num ui line
put st_cnt ui add get st_cnt ui 1
ret
end
i = sub i 1
end
if ge ns MAX_SITES
die_t t_die_oom
end
put st_repo ns repo
put st_po ns po
put st_pl ns pl
put st_so ns get pend_so 0
put st_sl ns get pend_sl 0
put st_eo ns get pend_eo 0
put st_el ns get pend_el 0
put st_to ns get pend_to 0
put st_tl ns get pend_tl 0
ln = fmt_u_tmp1 line
lo = sp_add_tmp1 ln
put st_lo ns lo
put st_ll ns ln
put st_fline ns line
put st_cnt ns 1
put st_row ns -1
put nsites 0 add ns 1
end

fn sp_add_stripped off0 ulong n ulong to ulong
sp_reserve n
off = get sp_len 0
for q ulong n bound 256
put sp add off q get stripped add off0 q
end
put sp_len 0 add off n
ret off
end

note ---- enclosing symbol per line ----
global sc_st ulong 8

fn rust_fn_on_line a ulong b ulong to void
i = a
while lt add i 3 b bound 1000000000
if eq get stripped i 102
if eq get stripped add i 1 110
c2 = get stripped add i 2
if or eq c2 32 eq c2 9
prev_ok = true
if gt i 0
if is_id get stripped sub i 1
prev_ok = false
end
end
if prev_ok
j = add i 2
while lt j b bound 1000000000
cj = get stripped j
if not or eq cj 32 eq cj 9
break
end
j = add j 1
end
k = j
while lt k b bound 1000000000
if not is_id get stripped k
break
end
k = add k 1
end
if gt k j
if lt sub k j 128
cl = sub k j
put sc_st 0 sp_add_stripped j cl
put sc_st 1 cl
end
end
ret
end
end
end
end
i = add i 1
end
end

fn build_syms_rust nl ulong n ulong to void
put sc_st 0 sp_add_t t_dash
put sc_st 1 1
for L ulong nl bound 1000000000
a = get lstarts L
b = sub get lstarts add L 1 1
if gt b n
b = n
end
rust_fn_on_line a b
put sym_o L get sc_st 0
put sym_l L get sc_st 1
end
end

fn syms_c_open_paren pos ulong a ulong to void
k = pos
while gt k a bound 1000000000
cp = get stripped sub k 1
if not or eq cp 32 eq cp 9
break
end
k = sub k 1
end
j = k
while gt j a bound 1000000000
if not is_id get stripped sub j 1
break
end
j = sub j 1
end
if gt k j
if lt sub k j 128
if eq get sc_st 4 0
cl = sub k j
put sc_st 2 sp_add_stripped j cl
put sc_st 3 cl
end
end
end
end

fn syms_c_line L ulong a ulong b ulong to void
note sc_st: 0=cur_o 1=cur_l 2=cand_o 3=cand_l 4=cand_eq 5=depth 6=pd 7=dash_o
sso = get sc_st 7
ssl = ulong 1
if gt get sc_st 5 0
sso = get sc_st 0
ssl = get sc_st 1
end
for i ulong sub b a bound 1000000000
pos = add a i
c = get stripped pos
if eq get sc_st 5 0
if eq c 41
if gt get sc_st 6 0
put sc_st 6 sub get sc_st 6 1
end
end
if eq c 40
old_pd = get sc_st 6
put sc_st 6 add old_pd 1
if eq old_pd 0
syms_c_open_paren pos a
end
else
if eq c 59
put sc_st 2 get sc_st 7
put sc_st 3 1
put sc_st 4 0
else
if eq c 61
put sc_st 4 1
end
end
end
end
if eq c 123
if eq get sc_st 5 0
if ne get sc_st 4 0
put sc_st 0 get sc_st 7
put sc_st 1 1
else
put sc_st 0 get sc_st 2
put sc_st 1 get sc_st 3
end
end
put sc_st 5 add get sc_st 5 1
else
if eq c 125
if gt get sc_st 5 0
put sc_st 5 sub get sc_st 5 1
end
if eq get sc_st 5 0
put sc_st 2 get sc_st 7
put sc_st 3 1
put sc_st 4 0
end
end
end
end
if gt get sc_st 5 0
put sym_o L get sc_st 0
put sym_l L get sc_st 1
else
put sym_o L sso
put sym_l L ssl
put sc_st 0 get sc_st 7
put sc_st 1 1
end
end

fn build_syms_c nl ulong n ulong to void
dash_o = sp_add_t t_dash
put sc_st 0 dash_o
put sc_st 1 1
put sc_st 2 dash_o
put sc_st 3 1
put sc_st 4 0
put sc_st 5 0
put sc_st 6 0
put sc_st 7 dash_o
for L ulong nl bound 1000000000
a = get lstarts L
b = sub get lstarts add L 1 1
if gt b n
b = n
end
syms_c_line L a b
end
end

note ---- loop scanning helpers ----
fn make_named_trig nt ulong to ulong
sp_reserve 32
off = get sp_len 0
pl = len t_named_pfx
for i ulong pl bound 16
put sp add off i get t_named_pfx i
end
put sp_len 0 add off pl
if eq nt 0
_o = sp_add_t t_ns0
ret add pl len t_ns0
end
if eq nt 1
_o = sp_add_t t_ns1
ret add pl len t_ns1
end
_o = sp_add_t t_ns2
ret add pl len t_ns2
end

fn make_loop_trig kw_id ulong unb ulong wdl ulong to ulong
off = get sp_len 0
if eq kw_id 1
_o = sp_add_t t_kw_while
end
if eq kw_id 2
_o = sp_add_t t_kw_for
end
if eq kw_id 3
_o = sp_add_t t_kw_loop
end
if eq kw_id 4
_o = sp_add_t t_kw_do
end
if ne unb 0
if gt wdl 0
_o = sp_add_t t_unb_plus
_o = sp_add_tmp2 wdl
else
_o = sp_add_t t_unb
end
else
_o = sp_add_t t_body_col
_o = sp_add_tmp2 wdl
end
ret sub get sp_len 0 off
end

fn rust_for_has_in k ulong n ulong to bool
q = k
while lt add q 1 n bound 1000000000
c = get stripped q
if or eq c 123 or eq c 10 eq c 59
break
end
if and eq c 105 eq get stripped add q 1 110
if gt q 0
if not is_id get stripped sub q 1
after_ok = true
if lt add q 2 n
if is_id get stripped add q 2
after_ok = false
end
end
if after_ok
ret true
end
end
end
end
q = add q 1
end
ret false
end

fn check_c_cond kw_id ulong k ulong n ulong to ulong
note returns packed (unbounded << 48) | e
q = k
d = ulong 0
while lt q n bound 1000000000
c = get stripped q
if eq c 40
d = add d 1
else
if eq c 41
d = sub d 1
if eq d 0
break
end
end
end
q = add q 1
end
ci = ulong 0
r = add k 1
while lt r q bound 1000000000
if ge ci 63
break
end
cr = get stripped r
if not is_space cr
put tmp1 ci cr
ci = add ci 1
end
r = add r 1
end
unb = ulong 0
if eq kw_id 1
if tmp1_eq_t ci t_cond_1
unb = 1
end
if tmp1_eq_t ci t_cond_true
unb = 1
end
if tmp1_eq_t ci t_cond_not0
unb = 1
end
end
if eq kw_id 2
if tmp1_eq_t ci t_cond_semi
unb = 1
end
end
e = add q 1
ret or shl unb 48 e
end

fn find_body_end e ulong n ulong kw_id ulong to ulong
par = ulong 0
endp = n
q = e
while lt q n bound 1000000000
c = get stripped q
if or eq c 40 eq c 91
par = add par 1
else
if or eq c 41 eq c 93
if gt par 0
par = sub par 1
end
else
if and eq par 0 eq c 59
endp = add q 1
break
end
if and eq par 0 eq c 123
d = ulong 0
r = q
while lt r n bound 1000000000
cr = get stripped r
if eq cr 123
d = add d 1
else
if eq cr 125
d = sub d 1
if eq d 0
break
end
end
end
r = add r 1
end
if lt r n
endp = add r 1
else
endp = n
end
if eq kw_id 4
while lt endp n bound 1000000000
if eq get stripped endp 59
break
end
endp = add endp 1
end
end
break
end
end
end
q = add q 1
end
ret endp
end

global tok_ctx ulong 8

fn scan_token_ident i ulong idlen ulong line ulong n ulong to void
repo = get tok_ctx 0
nw = split_words i idlen
for w ulong nw bound 16
ti = term_word_idx w
if ge ti 0
tidx = add mul repo 32 ulong ti
put thits tidx add get thits tidx 1
end
end
ntc = named_count_in_ident i idlen
if ge ntc 0
nidx = add mul repo 8 ulong ntc
put nhits nidx add get nhits nidx 1
end
nt = named_in_ident i idlen
if ge nt 0
la = get lstarts line
lb = sub get lstarts add line 1 1
if gt lb n
lb = n
end
put pend_so 0 get sym_o line
put pend_sl 0 get sym_l line
put pend_eo 0 get sp_len 0
put pend_el 0 norm_ws_orig la sub lb la
put pend_to 0 get sp_len 0
put pend_tl 0 make_named_trig ulong nt
record_site repo get tok_ctx 1 get tok_ctx 2 add line 1
end
end

fn classify_loop_kw i ulong idlen ulong rust ulong to ulong
if strip_eq_t i idlen t_kw_while
ret 1
end
if strip_eq_t i idlen t_kw_for
ret 2
end
if ne rust 0
if strip_eq_t i idlen t_kw_loop
ret 3
end
else
if strip_eq_t i idlen t_kw_do
ret 4
end
end
ret 0
end

fn loop_head_pos i ulong j ulong kw ulong n ulong to long
rust = get tok_ctx 3
k = j
while lt k n bound 1000000000
if not is_space get stripped k
break
end
k = add k 1
end
if or eq kw 3 eq kw 4
if ge k n
ret -1
end
if ne get stripped k 123
ret -1
end
else
if eq rust 0
if ge k n
ret -1
end
if ne get stripped k 40
ret -1
end
else
if eq kw 2
if not rust_for_has_in k n
ret -1
end
end
end
end
if and eq rust 0 eq kw 1
p = i
while gt p 0 bound 1000000000
if not is_space get stripped sub p 1
break
end
p = sub p 1
end
if gt p 0
if eq get stripped sub p 1 125
ret -1
end
end
end
ret long k
end

fn rust_while_unb k ulong n ulong to ulong
q = k
while lt q n bound 1000000000
if not is_space get stripped q
break
end
q = add q 1
end
if le add q 4 n
if strip_eq_t q 4 t_cond_true
if lt add q 4 n
if is_id get stripped add q 4
ret 0
end
end
ret 1
end
end
ret 0
end

fn record_loop_site line ulong n ulong kw ulong unb ulong wdl ulong to void
la = get lstarts line
lb = sub get lstarts add line 1 1
if gt lb n
lb = n
end
put pend_so 0 get sym_o line
put pend_sl 0 get sym_l line
put pend_to 0 get sp_len 0
put pend_tl 0 make_loop_trig kw unb wdl
put pend_eo 0 get sp_len 0
put pend_el 0 norm_ws_orig la sub lb la
record_site get tok_ctx 0 get tok_ctx 1 get tok_ctx 2 add line 1
end

fn scan_token_loop i ulong j ulong line ulong n ulong to void
rust = get tok_ctx 3
kw = classify_loop_kw i sub j i rust
if eq kw 0
ret
end
kr = loop_head_pos i j kw n
if lt kr 0
ret
end
k = ulong kr
e = k
unb = ulong 0
if eq kw 3
unb = 1
end
if eq rust 0
if lt k n
if eq get stripped k 40
res = check_c_cond kw k n
unb = shr res 48
e = and res 281474976710655
end
end
end
if and ne rust 0 eq kw 1
unb = rust_while_unb k n
end
endp = find_body_end e n kw
wdl = find_body_word j endp
if or ne unb 0 gt wdl 0
record_loop_site line n kw unb wdl
end
end

fn scan_one_token i ulong j ulong line ulong n ulong to void
scan_token_ident i sub j i line n
scan_token_loop i j line n
end

fn scan_tokens repo ulong po ulong pl ulong n ulong nl ulong to void
put tok_ctx 0 repo
put tok_ctx 1 po
put tok_ctx 2 pl
rust = ulong 0
if sp_ends_t po pl t_rs
rust = 1
end
put tok_ctx 3 rust
line = ulong 0
i = ulong 0
while lt i n bound 1000000000
while lt add line 1 nl bound 1000000000
if gt get lstarts add line 1 i
break
end
line = add line 1
end
c = get stripped i
start_id = false
if is_id c
if eq i 0
start_id = true
else
if not is_id get stripped sub i 1
start_id = true
end
end
end
if not start_id
i = add i 1
continue
end
j = i
while lt j n bound 1000000000
if not is_id get stripped j
break
end
j = add j 1
end
scan_one_token i j line n
i = j
end
end

fn strip_has_nonws a ulong b ulong to bool
for q ulong sub b a bound 1000000000
cq = get stripped add a q
if not or eq cq 32 eq cq 9
ret true
end
end
ret false
end

fn scan_climode_line L ulong n ulong to void
a = get lstarts L
b = sub get lstarts add L 1 1
if gt b n
b = n
end
co = get sp_len 0
cl = norm_ws_strip a sub b a
if not sp_has_t co cl t_argvb
ret
end
eo = get sp_len 0
el = norm_ws_orig a sub b a
has_cli = false
if sp_has_t eo el t_cli_dem
has_cli = true
end
if sp_has_t eo el t_cli_ref
has_cli = true
end
if sp_has_t eo el t_cli_run
has_cli = true
end
if not has_cli
ret
end
if strip_has_nonws a b
put pend_so 0 get sym_o L
put pend_sl 0 get sym_l L
put pend_eo 0 eo
put pend_el 0 el
put pend_to 0 sp_add_t t_climode
put pend_tl 0 len t_climode
record_site get tok_ctx 0 get tok_ctx 1 get tok_ctx 2 add L 1
end
end

fn scan_climode repo ulong po ulong pl ulong n ulong nl ulong to void
put tok_ctx 0 repo
put tok_ctx 1 po
put tok_ctx 2 pl
for L ulong nl bound 1000000000
scan_climode_line L n
end
end

note ---- file reading into orig ----
fn build_path_tmp1 ro ulong rl ulong po ulong pl ulong to ulong
for i ulong rl bound 4096
put tmp1 i get sp add ro i
end
put tmp1 rl 47
for i ulong pl bound 4096
put tmp1 add add rl 1 i get sp add po i
end
ret add add rl 1 pl
end

fn read_file_orig plen ulong to long
fd = fopen tmp1 0 plen 0 0
if lt fd 0
ret -1
end
cap = get orig_cap 0
if eq cap 0
cap = 65536
_e = enlarge orig cap
if lt _e 0
_c = fclose int fd
die_t t_die_oom
end
put orig_cap 0 cap
end
n = ulong 0
while true bound 1000000000
if ge add n 4096 cap
cap = mul cap 2
_e = enlarge orig cap
if lt _e 0
_c = fclose int fd
die_t t_die_oom
end
put orig_cap 0 cap
end
k = read int fd orig n sub cap n
if lt k 0
_c = fclose int fd
ret -2
end
if eq k 0
break
end
n = add n ulong k
end
_c = fclose int fd
ret long n
end

fn prep_file_bufs n ulong rust ulong to ulong
if lt get strip_cap 0 add n 1
ncap = add n 1
if lt ncap 65536
ncap = 65536
end
_e = enlarge stripped ncap
if lt _e 0
die_t t_die_oom
end
put strip_cap 0 ncap
end
for i ulong n bound 1000000000
put stripped i get orig i
end
strip_code n rust
nl = ulong 1
for i ulong n bound 1000000000
if eq get orig i 10
nl = add nl 1
end
end
if lt get ls_cap 0 add nl 1
ncap = add nl 1
if lt ncap 4096
ncap = 4096
end
_e = enlarge lstarts ncap
if lt _e 0
die_t t_die_oom
end
put ls_cap 0 ncap
end
put lstarts 0 0
li = ulong 1
for i ulong n bound 1000000000
if eq get orig i 10
put lstarts li add i 1
li = add li 1
end
end
put lstarts nl add n 1
if lt get sym_cap 0 nl
ncap = nl
if lt ncap 4096
ncap = 4096
end
_e = enlarge sym_o ncap
_e2 = enlarge sym_l ncap
if or lt _e 0 lt _e2 0
die_t t_die_oom
end
put sym_cap 0 ncap
end
ret nl
end

fn scan_file repo ulong ro ulong rl ulong po ulong pl ulong to void
plen = build_path_tmp1 ro rl po pl
rn = read_file_orig plen
if eq rn -1
ret
end
if lt rn 0
fo = sp_add_tmp1 plen
die_sp t_die_read fo plen
end
n = ulong rn
rust = ulong 0
if sp_ends_t po pl t_rs
rust = 1
end
nl = prep_file_bufs n rust
if ne rust 0
build_syms_rust nl n
else
build_syms_c nl n
end
scan_tokens repo po pl n nl
if eq rust 0
scan_climode repo po pl n nl
end
end

note ---- excluded path check ----
fn excluded po ulong pl ulong to bool
if sp_starts_t po pl t_ex0
ret true
end
if sp_starts_t po pl t_ex1
ret true
end
if sp_starts_t po pl t_ex2
ret true
end
if gt pl 8
for i ulong sub pl 7 bound 8192
if eq get sp add po i 47
if sp_starts_t add po add i 1 sub sub pl i 1 t_ex0
ret true
end
end
end
end
if gt pl 13
for i ulong sub pl 12 bound 8192
if eq get sp add po i 47
if sp_starts_t add po add i 1 sub sub pl i 1 t_ex1
ret true
end
end
end
end
ret false
end

note ---- git subprocess via pipefds + fork + dupfd + execprog + waitpid ----
fn pkt_put16 off ulong v ulong to void
put pkt off uchar and v 255
put pkt add off 1 uchar and shr v 8 255
end

fn pkt_add_t pos ulong t view uchar * to ulong
n = len t
pkt_put16 pos n
pos = add pos 2
for i ulong n bound 4096
put pkt add pos i get t i
end
ret add pos n
end

fn pkt_add_sp pos ulong off ulong n ulong to ulong
pkt_put16 pos n
pos = add pos 2
for i ulong n bound 4096
put pkt add pos i get sp add off i
end
ret add pos n
end

fn read_u32_le b view uchar 8 off ulong to uint
b0 = uint get b off
b1 = uint get b add off 1
b2 = uint get b add off 2
b3 = uint get b add off 3
ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

note run_git_pkt: runs pkt[0..plen), reads stdout into gitout[0..outlen).
note Returns outlen if exit==0, else -1 (sets status!=0).
fn run_git_pkt plen ulong quiet_err ulong to long
fds = new uchar 8 0
if ne pipefds fds 0 8 0 0
die_t t_die_pipe
end
rfd = int read_u32_le fds 0
wfd = int read_u32_le fds 4
pid = fork
if lt pid 0
_c1 = fclose rfd
_c2 = fclose wfd
die_t t_die_fork
end
if eq pid 0
_c1 = fclose rfd
_d1 = dupfd wfd 1 0
_c2 = fclose wfd
if ne quiet_err 0
dn = fopen t_devnull 0 len t_devnull 1 0
if ge dn 0
_d2 = dupfd int dn 2 0
_c3 = fclose int dn
end
end
_ex = execprog pkt 0 plen
exit 127
end
_c2 = fclose wfd
cap = get gitout_cap 0
if eq cap 0
cap = 65536
_e = enlarge gitout cap
if lt _e 0
die_t t_die_oom
end
put gitout_cap 0 cap
end
n = ulong 0
while true bound 1000000000
if ge add n 4096 cap
cap = mul cap 2
_e = enlarge gitout cap
if lt _e 0
die_t t_die_oom
end
put gitout_cap 0 cap
end
k = read rfd gitout n sub cap n
if le k 0
break
end
n = add n ulong k
end
_c1 = fclose rfd
st = new uchar 8 0
_w = waitpid int pid st 0 4 0
wcode = read_u32_le st 0
if ne wcode 0
ret -1
end
ret long n
end

fn parse_git_flist gl ulong to ulong
nf = ulong 0
fcap = get flist_cap 0
if eq fcap 0
fcap = 4096
_e1 = enlarge flist_o fcap
_e2 = enlarge flist_l fcap
put flist_cap 0 fcap
end
start = ulong 0
for i ulong gl bound 1000000000
if eq get gitout i 0
fl = sub i start
if gt fl 0
po = sp_add_git start fl
if not excluded po fl
if ge nf fcap
fcap = mul fcap 2
_e1 = enlarge flist_o fcap
_e2 = enlarge flist_l fcap
put flist_cap 0 fcap
end
put flist_o nf po
put flist_l nf fl
nf = add nf 1
end
end
start = add i 1
end
end
ret nf
end

fn scan_repo r ulong to void
ro = get defp_o r
rl = get defp_l r
pkt_put16 0 5
p = ulong 2
p = pkt_add_t p t_git
p = pkt_add_t p t_dashC
p = pkt_add_sp p ro rl
p = pkt_add_t p t_revparse
p = pkt_add_t p t_HEAD
hn = run_git_pkt p 1
if lt hn 0
put rskip r 1
ret
end
hl = ulong hn
while gt hl 0 bound 256
c = get gitout sub hl 1
if or eq c 10 eq c 13
hl = sub hl 1
else
break
end
end
if eq hl 0
put rskip r 1
ret
end
put head_o r sp_add_git 0 hl
put head_l r hl

pkt_put16 0 9
p = 2
p = pkt_add_t p t_git
p = pkt_add_t p t_dashC
p = pkt_add_sp p ro rl
p = pkt_add_t p t_lsfiles
p = pkt_add_t p t_dashz
p = pkt_add_t p t_dashdash
p = pkt_add_t p t_glob_c
p = pkt_add_t p t_glob_h
p = pkt_add_t p t_glob_rs
gn = run_git_pkt p 0
if lt gn 0
die_sp t_die_gitls ro rl
end
nf = parse_git_flist ulong gn
for i ulong nf bound 1000000000
scan_file r ro rl get flist_o i get flist_l i
end
end

note ---- map parsing ----
fn trim_span off0 ulong n0 ulong to ulong
note returns packed (new_off << 32) | new_len in mrow_tmp
a = off0
b = add off0 n0
while lt a b bound 16384
c = get mrow_tmp a
if or eq c 32 eq c 9
a = add a 1
else
break
end
end
while gt b a bound 16384
c = get mrow_tmp sub b 1
if or eq c 32 or eq c 9 or eq c 13 eq c 10
b = sub b 1
else
break
end
end
ret or shl a 32 sub b a
end

fn untick_span off0 ulong n0 ulong to ulong
t = trim_span off0 n0
a = shr t 32
l = and t 4294967295
while ge l 2 bound 64
if ne get mrow_tmp a 96
break
end
if ne get mrow_tmp add a sub l 1 96
break
end
a = add a 1
l = sub l 2
end
ret trim_span a l
end

fn split_md_row line_off ulong line_len ulong to ulong
p = ulong 0
while lt p line_len bound 16384
if ne get mapbuf add line_off p 32
break
end
p = add p 1
end
if ge p line_len
ret 0
end
if ne get mapbuf add line_off p 124
ret 0
end
p = add p 1
nc = ulong 0
w = ulong 0
cstart = ulong 0
while lt p line_len bound 16384
c = get mapbuf add line_off p
if eq c 92
if lt add p 1 line_len
if eq get mapbuf add line_off add p 1 124
put mrow_tmp w 124
w = add w 1
p = add p 2
continue
end
end
end
if eq c 124
if lt nc 16
put mcells_o nc cstart
put mcells_l nc sub w cstart
nc = add nc 1
end
p = add p 1
cstart = w
continue
end
put mrow_tmp w c
w = add w 1
p = add p 1
end
ret nc
end

fn mapbuf_at_t off0 ulong t view uchar * to bool
tl = len t
for j ulong tl bound 256
if ne get mapbuf add off0 j get t j
ret false
end
end
ret true
end

fn mapline_has off0 ulong n0 ulong t view uchar * to bool
tl = len t
if lt n0 tl
ret false
end
lim = add sub n0 tl 1
for i ulong lim bound 16384
if mapbuf_at_t add off0 i t
ret true
end
end
ret false
end

fn norm_row_ev base ulong to void
eo0 = get rw_off add base 10
el0 = get rw_len add base 10
eno = get sp_len 0
enl = norm_ws_sp eo0 el0
put rw_off add base 10 eno
put rw_len add base 10 enl
end

fn load_map_row nc ulong lineno ulong to void
if lt nc 11
eput_t t_e_maperr
eput_u lineno
eput_t t_e_maperr2
eput_u nc
eput_t t_e_maperr3
put map_err 0 add get map_err 0 1
ret
end
nr = get nrows 0
if ge nr MAX_ROWS
die_t t_die_oom
end
base = mul nr 11
for c ulong 11 bound 12
uc = untick_span get mcells_o c get mcells_l c
fl = and uc 4294967295
fo = sp_add_mrow shr uc 32 fl
put rw_off add base c fo
put rw_len add base c fl
end
norm_row_ev base
ri = repo_index get rw_off add base 1 get rw_len add base 1
put rw_ridx nr ri
put rw_hits nr 0
if lt ri 0
eput_t t_e_maperr
eput_u lineno
eput_t t_e_mapunk
eput_sp get rw_off add base 1 get rw_len add base 1
eputc 39
eputc 10
put map_err 0 add get map_err 0 1
end
put nrows 0 add nr 1
end

fn rw_field_eq bi ulong bj ulong f ulong to bool
ao = get rw_off add bi f
al = get rw_len add bi f
bo = get rw_off add bj f
bl = get rw_len add bj f
ret sp_eq ao al bo bl
end

fn rows_dup_key i ulong j ulong to bool
if ne get rw_ridx i get rw_ridx j
ret false
end
bi = mul i 11
bj = mul j 11
if not rw_field_eq bi bj 2
ret false
end
if not rw_field_eq bi bj 4
ret false
end
ret rw_field_eq bi bj 10
end

fn check_map_dups to void
nr = get nrows 0
for i ulong nr bound 8192
j = add i 1
while lt j nr bound 8192
if rows_dup_key i j
bi = mul i 11
bj = mul j 11
eput_t t_e_mapdup
eput_sp get rw_off bi get rw_len bi
eput_t t_e_and
eput_sp get rw_off bj get rw_len bj
eputc 10
put map_err 0 add get map_err 0 1
end
j = add j 1
end
end
end

fn load_map_sha nc ulong to void
if lt nc 2
ret
end
u0 = untick_span get mcells_o 0 get mcells_l 0
r0l = and u0 4294967295
r0o = sp_add_mrow shr u0 32 r0l
ri = repo_index r0o r0l
if ge ri 0
u1 = untick_span get mcells_o 1 get mcells_l 1
s1l = and u1 4294967295
s1o = sp_add_mrow shr u1 32 s1l
put msha_o ulong ri s1o
put msha_l ulong ri s1l
end
end

fn read_map_file mo ulong ml ulong to ulong
for i ulong ml bound 4096
put tmp1 i get sp add mo i
end
fd = fopen tmp1 0 ml 0 0
if lt fd 0
die_sp t_die_map mo ml
end
cap = get mapbuf_cap 0
if eq cap 0
cap = 65536
_e = enlarge mapbuf cap
put mapbuf_cap 0 cap
end
n = ulong 0
while true bound 1000000000
if ge add n 4096 cap
cap = mul cap 2
_e = enlarge mapbuf cap
put mapbuf_cap 0 cap
end
k = read int fd mapbuf n sub cap n
if le k 0
break
end
n = add n ulong k
end
_c = fclose int fd
ret n
end

fn load_map mo ulong ml ulong to void
n = read_map_file mo ml
mode = ulong 0
lineno = ulong 0
pos = ulong 0
while lt pos n bound 1000000000
ls = pos
while lt pos n bound 1000000000
if eq get mapbuf pos 10
pos = add pos 1
break
end
pos = add pos 1
end
ll = sub pos ls
lineno = add lineno 1
if mapline_has ls ll t_m_shas
mode = 1
continue
end
if mapline_has ls ll t_m_rows
mode = 2
continue
end
if mapline_has ls ll t_m_end
mode = 0
continue
end
if eq mode 0
continue
end
if mapline_has ls ll t_m_sep
continue
end
if mapline_has ls ll t_m_hdr1
continue
end
if mapline_has ls ll t_m_hdr2
continue
end
nc = split_md_row ls ll
if eq nc 0
continue
end
if eq mode 1
load_map_sha nc
continue
end
if eq mode 2
load_map_row nc lineno
end
end
check_map_dups
end


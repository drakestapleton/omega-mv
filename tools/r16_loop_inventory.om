note ---- buffered I/O ----
fn write_all fd int is_err ulong n ulong to void
off = ulong 0
while lt off n bound 1000000000
k = long 0
if eq is_err 0
k = write fd obuf off sub n off
else
k = write fd ebuf off sub n off
end
if le k 0
break
end
off = add off ulong k
end
end

fn oflush to void
n = get olen 0
if gt n 0
write_all get ofd 0 0 n
put olen 0 0
end
end

fn eflush to void
n = get elen 0
if gt n 0
write_all int 2 1 n
put elen 0 0
end
end

fn oputc c uchar to void
n = get olen 0
if ge n 65536
oflush
n = 0
end
put obuf n c
put olen 0 add n 1
end

fn eputc c uchar to void
n = get elen 0
if ge n 65536
eflush
n = 0
end
put ebuf n c
put elen 0 add n 1
end

fn oput_t t view uchar * to void
n = len t
for i ulong n bound 4096
oputc get t i
end
end

fn eput_t t view uchar * to void
n = len t
for i ulong n bound 4096
eputc get t i
end
end

fn oput_sp off ulong n ulong to void
for i ulong n bound 1000000000
oputc get sp add off i
end
end

fn eput_sp off ulong n ulong to void
for i ulong n bound 1000000000
eputc get sp add off i
end
end

fn oput_u v ulong to void
d = new uchar 24 0
k = ulong 0
x = v
while true bound 24
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
while gt k 0 bound 24
k = sub k 1
oputc get d k
end
end

fn eput_u v ulong to void
d = new uchar 24 0
k = ulong 0
x = v
while true bound 24
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
while gt k 0 bound 24
k = sub k 1
eputc get d k
end
end

fn die_t msg view uchar * to void
eflush
eput_t t_die_pfx
eput_t msg
eputc 10
eflush
exit 2
end

fn die_sp msg view uchar * off ulong n ulong to void
eflush
eput_t t_die_pfx
eput_t msg
eput_sp off n
eputc 10
eflush
exit 2
end

note ---- string pool ----
fn sp_reserve need ulong to void
cur = get sp_len 0
cap = get sp_cap 0
if le add cur need cap
ret
end
ncap = cap
if eq ncap 0
ncap = 4194304
end
while lt ncap add cur need bound 64
ncap = mul ncap 2
end
r = enlarge sp ncap
if lt r 0
die_t t_die_oom
end
put sp_cap 0 ncap
end

fn sp_add_t t view uchar * to ulong
n = len t
sp_reserve n
off = get sp_len 0
for i ulong n bound 1000000000
put sp add off i get t i
end
put sp_len 0 add off n
ret off
end

fn sp_add_tmp1 n ulong to ulong
sp_reserve n
off = get sp_len 0
for i ulong n bound 1000000000
put sp add off i get tmp1 i
end
put sp_len 0 add off n
ret off
end

fn sp_add_tmp2 n ulong to ulong
sp_reserve n
off = get sp_len 0
for i ulong n bound 1000000000
put sp add off i get tmp2 i
end
put sp_len 0 add off n
ret off
end

fn sp_add_orig off0 ulong n ulong to ulong
sp_reserve n
off = get sp_len 0
for i ulong n bound 1000000000
put sp add off i get orig add off0 i
end
put sp_len 0 add off n
ret off
end

fn sp_add_git off0 ulong n ulong to ulong
sp_reserve n
off = get sp_len 0
for i ulong n bound 1000000000
put sp add off i get gitout add off0 i
end
put sp_len 0 add off n
ret off
end

fn sp_add_mrow off0 ulong n ulong to ulong
sp_reserve n
off = get sp_len 0
for i ulong n bound 1000000000
put sp add off i get mrow_tmp add off0 i
end
put sp_len 0 add off n
ret off
end

note ---- character classifiers ----
fn is_alpha c uchar to bool
if ge c 65
if le c 90
ret true
end
end
if ge c 97
if le c 122
ret true
end
end
ret false
end

fn is_upper c uchar to bool
if ge c 65
if le c 90
ret true
end
end
ret false
end

fn is_lower c uchar to bool
if ge c 97
if le c 122
ret true
end
end
ret false
end

fn is_digit c uchar to bool
if ge c 48
if le c 57
ret true
end
end
ret false
end

fn is_id c uchar to bool
if is_alpha c
ret true
end
if is_digit c
ret true
end
if eq c 95
ret true
end
ret false
end

fn is_space c uchar to bool
if eq c 32
ret true
end
if ge c 9
if le c 13
ret true
end
end
ret false
end

fn to_lower c uchar to uchar
if is_upper c
ret add c 32
end
ret c
end

note ---- string comparisons ----
fn sp_eq ao ulong al ulong bo ulong bl ulong to bool
if ne al bl
ret false
end
for i ulong al bound 1000000000
if ne get sp add ao i get sp add bo i
ret false
end
end
ret true
end

fn sp_eq_t ao ulong al ulong t view uchar * to bool
if ne al len t
ret false
end
for i ulong al bound 1000000000
if ne get sp add ao i get t i
ret false
end
end
ret true
end

fn sp_starts_t ao ulong al ulong t view uchar * to bool
tl = len t
if lt al tl
ret false
end
for i ulong tl bound 1000000000
if ne get sp add ao i get t i
ret false
end
end
ret true
end

fn sp_ends_t ao ulong al ulong t view uchar * to bool
tl = len t
if lt al tl
ret false
end
base = sub al tl
for i ulong tl bound 1000000000
if ne get sp add ao add base i get t i
ret false
end
end
ret true
end

fn sp_has_t ao ulong al ulong t view uchar * to bool
tl = len t
if eq tl 0
ret true
end
if lt al tl
ret false
end
lim = add sub al tl 1
for i ulong lim bound 1000000000
if sp_starts_t add ao i tl t
ret true
end
end
ret false
end

fn sp_has_sp ao ulong al ulong bo ulong bl ulong to bool
if eq bl 0
ret true
end
if lt al bl
ret false
end
lim = add sub al bl 1
for i ulong lim bound 1000000000
if sp_eq add ao i bl bo bl
ret true
end
end
ret false
end

fn tmp1_eq_t n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n bound 8192
if ne get tmp1 i get t i
ret false
end
end
ret true
end

fn tmp1_at_t off ulong t view uchar * to bool
tl = len t
for j ulong tl bound 4096
if ne get tmp1 add off j get t j
ret false
end
end
ret true
end

fn tmp1_has_t n ulong t view uchar * to bool
tl = len t
if eq tl 0
ret true
end
if lt n tl
ret false
end
lim = add sub n tl 1
for i ulong lim bound 8192
if tmp1_at_t i t
ret true
end
end
ret false
end

fn strip_eq_t off ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n bound 4096
if ne get stripped add off i get t i
ret false
end
end
ret true
end

fn word_eq_t wi ulong t view uchar * to bool
wl = get wlen wi
if ne wl len t
ret false
end
base = mul wi 40
for i ulong wl bound 40
if ne get wbuf add base i get t i
ret false
end
end
ret true
end


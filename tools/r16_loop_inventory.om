global cfg_mo ulong 1
global cfg_ml ulong 1
global cfg_has_map ulong 1
global cfg_jo ulong 1
global cfg_jl ulong 1
global cfg_has_json ulong 1
global cfg_skel ulong 1

fn parse_cli_args to int
ac = argcnt
if lt ac 1
ret 2
end
argc = ulong ac
em = env_get t_env_map
if ge em 0
put cfg_has_map 0 1
put cfg_mo 0 shr ulong em 32
put cfg_ml 0 and ulong em 4294967295
end
ai = ulong 1
while lt ai argc bound 4096
al = argread ai tmp1 0 8192
if lt al 0
eput_t t_usage
eflush
ret 2
end
an = ulong al
if tmp1_eq_t an t_fl_pat
oput_t t_pat_text
oflush
ret -1
end
if tmp1_eq_t an t_fl_skel
put cfg_skel 0 1
ai = add ai 1
continue
end
if tmp1_eq_t an t_fl_map
if lt add ai 1 argc
ai = add ai 1
vl = argread ai tmp1 0 8192
if lt vl 0
eput_t t_usage
eflush
ret 2
end
put cfg_ml 0 ulong vl
put cfg_mo 0 sp_add_tmp1 ulong vl
put cfg_has_map 0 1
ai = add ai 1
continue
end
end
if tmp1_eq_t an t_fl_json
if lt add ai 1 argc
ai = add ai 1
vl = argread ai tmp1 0 8192
if lt vl 0
eput_t t_usage
eflush
ret 2
end
put cfg_jl 0 ulong vl
put cfg_jo 0 sp_add_tmp1 ulong vl
put cfg_has_json 0 1
ai = add ai 1
continue
end
end
eput_t t_usage
eflush
ret 2
end
ret 0
end

fn tally_percls to void
ns = get nsites 0
for i ulong ns bound 16384
c = ulong 7
row = get st_row i
if ge row 0
b = mul ulong row 11
co = get rw_off add b 7
cl = get rw_len add b 7
if class_ok co cl
c = class_idx co cl
if eq get sp co 78
put v_cntn 0 add get v_cntn 0 1
end
end
end
pidx = add mul get st_repo i 8 c
put percls pidx add get percls pidx 1
end
end

fn main to int
put ofd 0 1
prc = parse_cli_args
if eq prc -1
ret 0
end
if ne prc 0
ret prc
end
if eq get cfg_has_map 0 0
put cfg_mo 0 sp_add_t t_defmap
put cfg_ml 0 len t_defmap
end
mo = get cfg_mo 0
ml = get cfg_ml 0
setup_repo_paths
if eq get cfg_skel 0 0
load_map mo ml
else
for k ulong ml bound 4096
put tmp1 k get sp add mo k
end
tfd = fopen tmp1 0 ml 0 0
if ge tfd 0
_c = fclose int tfd
load_map mo ml
end
end
scan_all_repos
join_sites_and_manual
if ne get cfg_skel 0 0
emit_skeleton
ret 0
end
validate_sites
validate_manual_and_stale
tally_percls

fail = ulong 0
if ne get v_uncls 0 0
fail = 1
end
if ne get v_qrows 0 0
fail = 1
end
if ne get v_badcls 0 0
fail = 1
end
if ne get v_areach 0 0
fail = 1
end
if ne get v_stale 0 0
fail = 1
end
if ne get map_err 0 0
fail = 1
end
if ne get v_skipped 0 0
fail = 1
end

if ne get cfg_has_json 0 0
jo = get cfg_jo 0
jl = get cfg_jl 0
for k ulong jl bound 4096
put tmp1 k get sp add jo k
end
jfd = fopen tmp1 0 jl 577 420
if lt jfd 0
die_sp t_die_write jo jl
end
put ofd 0 int jfd
end
emit_json_all mo ml fail
if ne get cfg_has_json 0 0
_c = fclose get ofd 0
end
emit_stderr_summary fail
if ne fail 0
ret 1
end
ret 0
end

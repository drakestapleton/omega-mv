fn repo_index ao ulong al ulong to long
if sp_eq_t ao al t_r0
ret 0
end
if sp_eq_t ao al t_r1
ret 1
end
if sp_eq_t ao al t_r2
ret 2
end
if sp_eq_t ao al t_r3
ret 3
end
if sp_eq_t ao al t_r4
ret 4
end
ret -1
end


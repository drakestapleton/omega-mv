if eq r 0
ret env_get t_e0
end
if eq r 1
ret env_get t_e1
end
if eq r 2
ret env_get t_e2
end
if eq r 3
ret env_get t_e3
end
ret env_get t_e4
end

note ---- skeleton & json emitters ----
fn emit_skeleton to void
oput_t t_skel_hdr
ns = get nsites 0
for i ulong ns bound 16384
row = get st_row i
oput_t t_sp_pipe
if ge row 0
b = mul ulong row 11
oput_sp get rw_off b get rw_len b
else
oput_t t_new
end
oput_t t_pipe_sp

oput_jstr_sp mo ml
oput_t t_json_p2
emit_json_repos
oput_t t_json_s0
emit_json_sites
oput_t t_json_f1
oput_u get v_manual 0
oput_t t_json_f2
oput_u get nsites 0
oput_t t_json_f3
oput_u get v_uncls 0
oput_t t_json_f4
oput_u get v_qrows 0
oput_t t_json_f5
oput_u get v_badcls 0
oput_t t_json_f6
oput_u get v_areach 0
oput_t t_json_f7
oput_u get v_stale 0
oput_t t_json_f8
oput_u get map_err 0
oput_t t_json_f9
oput_u get v_skipped 0
oput_t t_json_f10
oput_u get v_cntn 0
oput_t t_json_f11
if ne fail 0
oput_t t_FAIL
else

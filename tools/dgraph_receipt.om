note dgraph_receipt.om -- pure seeded OM-2 decode-graph performance receipt generator and checker.
note Replaces tools/dgraph_receipt.c (same CLI, byte-identical golden output, same checker diagnostics).

global JBUF uchar *
global JLEN ulong 1
global JPOS ulong 1

global STRPOOL uchar *
global STRUSED ulong 1

note JSON AST node pools: 0=null, 1=bool, 2=num, 3=str, 4=arr, 5=obj
global NT uchar *

  out_push 34
  if gt get G_LEN 3 0
    kv_argp t_s293 get G_OFF 3 get G_LEN 3
  else
    w_key t_s294
    out_push 34
    out_jstr_argp get G_OFF 2 get G_LEN 2
    out_raw t_s207
    out_u64 get G_BLOG_BYTES 0
    out_raw t_s295
  end
  w_close 125
end

fn emit_measurements to void
  w_open t_s91 123
  w_key t_s92
  out_raw t_s296
  out_i64 get S_REPS 0
  out_raw t_s297
  kv_i t_s94 get S_REPS 0
  w_open t_s58 123
  kv_i t_s66 get S_CL 0
  kv_i t_s67 get S_CS 0
  kv_i t_s60 get S_MT 0
  kv_i t_s61 get S_MC 0
  kv_i t_s298 get S_MR 0
  kv_i t_s62 sub get S_MT 0 get S_MC 0
  kv_null t_s70
  kv_s t_s73 t_s299
  w_close 125
  w_open t_s59 123
  kv_i t_s66 get S_BL 0
  kv_i t_s67 get S_BS 0
  kv_i t_s60 get S_BT 0
  kv_i t_s61 get S_BC 0
  kv_i t_s62 sub get S_BT 0 get S_BC 0
  kv_null t_s70
  kv_s t_s73 t_s300
  kv_b t_s301 ne get S_BID 0 0
  kv_s t_s302 t_s303
  w_close 125
  w_close 125

  w_open t_s99 123
  pk = get S_PK_ID 0
  ssum = long 0
  e = get NI pk
  while ge e 0
    ue = ulong e
    arr = get ENT_VAL ue
    e0 = ulong get NI arr
    e1 = ulong get ENT_NEXT e0
    ssum = add ssum get NI get ENT_VAL e1
    e = get ENT_NEXT ue
  end
  kv_i t_s66 get S_TL 0
  kv_i t_s100 get S_SPAN 0
  kv_i t_s61 get S_TCHIP 0
  kv_i t_s101 sub get S_TCHIP 0 get S_SPAN 0
  kv_i t_s102 ssum
  kv_s t_s302 t_s304
  w_open t_s76 91
  e = get NI pk
  while ge e 0
    ue = ulong e
    arr = get ENT_VAL ue
    e0 = ulong get NI arr
    e1 = ulong get ENT_NEXT e0
    w_open t_s305 123
    kv_sp t_s80 get ENT_KOFF ue get ENT_KLEN ue
    kv_i t_s66 get NI get ENT_VAL e0
    kv_i t_s81 get NI get ENT_VAL e1
    w_close 125
    e = get ENT_NEXT ue
  end
  w_close 93
  w_close 125
end

fn emit_tail to void
  w_open t_s121 123
  kv_b t_s306 false
  kv_s t_s307 t_s308
  w_close 125

  indep = long 0
  if ne get K_PREF 0 0
    indep = get S_LAYERS 0
  end
  w_open t_s122 123
  w_key t_s61
  out_raw t_s309
  out_i64 get S_CS 0
  out_raw t_s310
  out_i64 get S_BS 0
  out_raw t_s311
  if ne indep 0
    w_key t_s76
    out_raw t_s312
    out_i64 indep
    out_raw t_s313
  else
    if eq get K_BARR 0 1
      kv_s t_s76 t_s314
    else
      w_key t_s76
      out_raw t_s315
      out_i64 get K_BARR 0
      out_raw t_s207
      i = ulong 0
      bn = get K_BNLEN 0
      while lt i bn
        out_jchar get K_BNAME i
        i = add i 1
      end
      out_raw t_s316
    end
  end
  kv_b t_s317 false
  if ne indep 0
    kv_s t_s307 t_s318
  else
    kv_s t_s307 t_s319
  end
  w_close 125

  w_open t_s123 123
  kv_s t_s320 t_s321
  kv_s t_s322 t_s323
  w_open t_s324 123
  kv_s t_s66 t_s325
  kv_s t_s67 t_s326
  kv_s t_s61 t_s327
  kv_s t_s298 t_s328
  kv_s t_s60 t_s329
  kv_s t_s70 t_s330
  kv_s t_s331 t_s332
  kv_s t_s62 t_s333
  w_close 125
  kv_s t_s116 t_s334
  w_close 125

  w_open t_s124 91
  kv_argp t_s305 get AOFF 3 get ALEN 3
  kv_argp t_s305 get AOFF 4 get ALEN 4
  kv_argp t_s305 get G_OFF 0 get G_LEN 0
  kv_argp t_s305 get G_OFF 1 get G_LEN 1
  kv_argp t_s305 get G_OFF 2 get G_LEN 2
  i = ulong 0
  nev = get NEV 0
  while lt i nev
    kv_argp t_s305 get EV_OFF i get EV_LEN i
    i = add i 1
  end
  w_close 93

  w_open t_s125 91
  kv_s t_s305 t_s335
  kv_s t_s305 t_s336
  kv_s t_s305 t_s337
  kv_s t_s305 t_s338
  kv_s t_s305 t_s339
  kv_s t_s305 t_s340
  if ne get DEV_DIRTY 0 0
    kv_s t_s305 t_s341
  end
  w_close 93
end

fn print_err_line to void
  write_all 2 t_s342
  w = write 2 ERRBUF 0 get ERRLEN 0
  write_all 2 t_s343
  if lt w 0
    ret
  end
end

fn run_generate to long
  if not read_path_into_fbuf true get AOFF 3 get ALEN 3
    write_all 2 t_s344
    w = write 2 ARGP get AOFF 3 get ALEN 3
    write_all 2 t_s343
    if lt w 0
      ret 2
    end
    ret 2
  end
  copy_fbuf_to_jbuf
  s = jparse_current
  if lt s 0
    write_all 2 t_s342
    w1 = write 2 ARGP get AOFF 3 get ALEN 3
    write_all 2 t_s345
    w2 = write 2 ERRBUF 0 get ERRLEN 0
    write_all 2 t_s343
    if or lt w1 0 lt w2 0
      ret 2
    end
    ret 2
  end
  argp_join get AOFF 2 get ALEN 2 t_s346 0
  argp_join get AOFF 2 get ALEN 2 t_s347 1
  argp_join get AOFF 2 get ALEN 2 t_s348 2
  if or not read_device or not read_binaries not read_knobs
    print_err_line
    ret 2
  end
  if not extract_stats ulong s
    print_err_line
    ret 2
  end
  read_build_log
  put OUTLEN 0 0
  put WDEPTH 0 1
  put WFIRST 0 1
  put WFIRST 1 1
  out_push 123
  emit_head_and_meta
  emit_workload_hw_build
  emit_measurements
  emit_tail
  w_close 125
  out_push 10

  copy_outbuf_to_jbuf
  if not check_jbuf false
    write_all 2 t_s349
    w = write 2 ERRBUF 0 get ERRLEN 0
    write_all 2 t_s343
    if lt w 0
      ret 1
    end
    ret 1
  end

  fd = long 1
  has_out = ne get ASET 11 0
  if has_out
    note O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC = 524865, mode 0644 = 420
    if not copy_argp_to_pbuf get AOFF 11 get ALEN 11
      fd = neg long 1
    else
      fd = fopen PBUF 0 get ALEN 11 524865 420
    end
    if lt fd 0
      write_all 2 t_s350
      w = write 2 ARGP get AOFF 11 get ALEN 11
      write_all 2 t_s343
      if lt w 0
        ret 2
      end
      ret 2
    end
  end
  n = get OUTLEN 0
  off = ulong 0
  wbad = false
  while lt off n
    w = write int fd OUTBUF off sub n off
    if le w 0
      wbad = true
      break
    end
    off = add off ulong w
  end
  if has_out
    cr = fclose int fd
    if lt cr 0
      wbad = true
    end
  end
  if wbad
    write_all 2 t_s351
    ret 2
  end
  ret 0
end

fn usage to long
  write_all 2 t_s352
  ret 2
end

fn read_arg_to_argp idx ulong to long
  tmp = new uchar 4096 0
  n = argread idx tmp 0 4095
  if lt n 0
    ret neg long 1
  end
  start = get ARGU 0
  i = ulong 0
  un = ulong n
  while lt i un
    argp_push get tmp i
    i = add i 1
  end
  ret long or shl start 32 un
end

fn match_opt off ulong n ulong to long
  if argp_eq_lit off n t_s353
    ret 0
  end
  if argp_eq_lit off n t_s354
    ret 1
  end
  if argp_eq_lit off n t_s355
    ret 2
  end
  if argp_eq_lit off n t_s356
    ret 3
  end
  if argp_eq_lit off n t_s357
    ret 4
  end
  if argp_eq_lit off n t_s358
    ret 5
  end
  if argp_eq_lit off n t_s359
    ret 6
  end
  if argp_eq_lit off n t_s360
    ret 7
  end
  if argp_eq_lit off n t_s361
    ret 8
  end
  if argp_eq_lit off n t_s362
    ret 9
  end
  if argp_eq_lit off n t_s363
    ret 10
  end
  if argp_eq_lit off n t_s364
    ret 11
  end
  if argp_eq_lit off n t_s365
    ret 12
  end
  ret neg long 1
end

fn push_ev off ulong n ulong to void
  cnt = get NEV 0
  if ge cnt len EV_OFF
    nc = mul cnt 2
    if lt nc 32
      nc = 32
    end
    r1 = enlarge EV_OFF nc
    r2 = enlarge EV_LEN nc
    if or lt r1 0 lt r2 0
      write_all 2 t_s1
      exit 2
    end
  end
  put EV_OFF cnt off
  put EV_LEN cnt n
  put NEV 0 add cnt 1
end

fn main to int
  ac = ulong argcnt
  i = ulong 1
  while lt i ac
    or_ = read_arg_to_argp i
    if lt or_ 0
      ret int usage
    end
    ooff = shr ulong or_ 32
    olen = and ulong or_ 4294967295
    slot = match_opt ooff olen
    if lt slot 0
      ret int usage
    end
    if ge add i 1 ac
      ret int usage
    end
    vr = read_arg_to_argp add i 1
    if lt vr 0
      ret int usage
    end
    voff = shr ulong vr 32
    vlen = and ulong vr 4294967295
    if eq slot 12
      push_ev voff vlen
    else
      us = ulong slot
      if ne get ASET us 0
        ret int usage
      end
      put AOFF us voff
      put ALEN us vlen
      put ASET us 1
    end
    i = add i 2
  end

  if ne get ASET 0 0
    j = ulong 2
    while lt j 12
      if ne get ASET j 0
        ret int usage
      end
      j = add j 1
    end
    if gt get NEV 0 0
      ret int usage
    end
    if not read_path_into_fbuf true get AOFF 0 get ALEN 0
      write_all 2 t_s344
      w = write 2 ARGP get AOFF 0 get ALEN 0
      write_all 2 t_s343
      if lt w 0
        ret 2
      end
      ret 2
    end
    copy_fbuf_to_jbuf
    ok = check_jbuf ne get ASET 1 0
    if not ok
      write_all 1 t_s366
      w1 = write 1 ARGP get AOFF 0 get ALEN 0
      write_all 1 t_s345
      w2 = write 1 ERRBUF 0 get ERRLEN 0
      write_all 1 t_s343
      if or lt w1 0 lt w2 0
        ret 1
      end
      ret 1
    end
    write_all 1 t_s367
    w3 = write 1 ARGP get AOFF 0 get ALEN 0
    write_all 1 t_s343
    if lt w3 0
      ret 0
    end
    ret 0
  end

  if ne get ASET 1 0
    ret int usage
  end
  j = ulong 2
  while lt j 11
    if eq get ASET j 0
      ret int usage
    end
    j = add j 1
  end
  ret int run_generate
end

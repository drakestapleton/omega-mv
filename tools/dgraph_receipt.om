  w_open t_s118 123
  kv_argp t_s274 get AOFF 7 get ALEN 7
  kv_argp t_s275 get AOFF 8 get ALEN 8
  kv_argp t_s188 get AOFF 9 get ALEN 9
  kv_i t_s94 get S_REPS 0
  w_key t_s276
  out_push 34
  out_i64 get S_REPS 0
  out_raw t_s277
  out_i64 get S_POS 0
  out_raw t_s278
  kv_i t_s225 get S_LAYERS 0
  kv_i t_s226 get S_VOCAB 0
  kv_i t_s227 get S_POS 0
  kv_b t_s230 ne get S_CACH 0 0
  kv_b t_s279 ne get K_PREF 0 0
  kv_b t_s280 ne get S_RED 0 0
  w_key t_s281
  out_push 34
  out_i64 get K_BARR 0
  out_raw t_s207
  i = ulong 0
  bn = get K_BNLEN 0
  while lt i bn
    out_jchar get K_BNAME i
    i = add i 1
  end
  out_raw t_s282
  kv_i t_s283 get K_FP8V 0
  w_close 125

  w_open t_s119 123
  kv_argp t_s284 get DEV_OFF 6 get DEV_LEN 6
  if gt get DEV_LEN 7 0
    kv_argp t_s285 get DEV_OFF 7 get DEV_LEN 7
  end
  kv_argp t_s286 get DEV_OFF 8 get DEV_LEN 8
  kv_argp t_s287 get DEV_OFF 9 get DEV_LEN 9
  kv_s t_s288 t_s289
  w_close 125

  w_open t_s120 123
  kv_argp t_s290 get AOFF 10 get ALEN 10
  w_key t_s291
  out_push 34
  i = ulong 0
  while lt i 64
    out_push get BIN_SHA i
    i = add i 1

note Saved paths for generate(): 0=dev_p, 1=bin_p, 2=blog_p, 3=compile_line
global G_OFF ulong 4
global G_LEN ulong 4
global G_BLOG_BYTES ulong 1

note Scratch buffer for dynamic error messages / paths
global TMPB uchar 512
global TMPL ulong 1

fn write_all fd int s view uchar * to void
  n = len s
  off = ulong 0
  while lt off n
    w = write int fd s off sub n off
    if le w 0
      ret
    end
    off = add off ulong w
  end
end

fn err_reset to void
  put ERRLEN 0 0
  put ERROK 0 0
end

fn err_push c uchar to void
  n = get ERRLEN 0
  if lt n 511
    put ERRBUF n c
    put ERRLEN 0 add n 1
  end
end

fn err_str s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    err_push get s i
    i = add i 1
  end
end

fn err_strpool off ulong n ulong to void
  i = ulong 0
  while lt i n
    err_push get STRPOOL add off i
    i = add i 1
  end
end

fn err_argp off ulong n ulong to void
  i = ulong 0
  while lt i n
    err_push get ARGP add off i
    i = add i 1
  end
end

fn err_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    err_push 48
    ret
  end
  k = ulong 0
  while gt v 0
    put tmp k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0
    k = sub k 1
    err_push get tmp k
  end
end

fn err_i64 v long to void
  if lt v 0
    err_push 45
    if eq v sub neg long 9223372036854775807 1
      err_u64 9223372036854775808
    else
      err_u64 ulong neg v
    end
    ret
  end
  err_u64 ulong v
end

fn perr m view uchar * to void
  if eq get ERROK 0 0
    put ERROK 0 1
    put ERRLEN 0 0
    err_str t_s0
    err_str m
  end
end

fn strpool_push c uchar to void
  n = get STRUSED 0
  if ge n len STRPOOL
    nc = mul n 2
    if lt nc 8192
      nc = 8192
    end
    r = enlarge STRPOOL nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
  end
  put STRPOOL n c
  put STRUSED 0 add n 1
end

fn strpool_put_utf8 cp ulong to void
  if lt cp 128
    strpool_push uchar cp
    ret
  end
  if lt cp 2048
    strpool_push uchar or 192 shr cp 6
    strpool_push uchar or 128 and cp 63
    ret
  end
  if lt cp 65536
    strpool_push uchar or 224 shr cp 12
    strpool_push uchar or 128 and shr cp 6 63
    strpool_push uchar or 128 and cp 63
    ret
  end
  strpool_push uchar or 240 shr cp 18
  strpool_push uchar or 128 and shr cp 12 63
  strpool_push uchar or 128 and shr cp 6 63
  strpool_push uchar or 128 and cp 63
end

fn jnew t uchar to ulong
  id = get NUSED 0
  if ge id len NT
    nc = mul id 2
    if lt nc 256
      nc = 256
    end
    r = enlarge NT nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
    r = enlarge NB nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
    r = enlarge NI nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
    r = enlarge NLAST nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
    r = enlarge NC nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
  end
  put NT id t
  put NB id 0
  put NI id neg long 1
  put NLAST id neg long 1
  put NC id 0
  put NUSED 0 add id 1
  ret id
end

fn ent_new koff ulong klen ulong val ulong to ulong
  id = get EUSED 0
  if ge id len ENT_VAL
    nc = mul id 2
    if lt nc 256
      nc = 256
    end
    r = enlarge ENT_KOFF nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
    r = enlarge ENT_KLEN nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
    r = enlarge ENT_VAL nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
    r = enlarge ENT_NEXT nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
  end
  put ENT_KOFF id koff
  put ENT_KLEN id klen
  put ENT_VAL id val
  put ENT_NEXT id neg long 1
  put EUSED 0 add id 1
  ret id
end

fn strpool_eq aoff ulong alen ulong boff ulong blen ulong to bool
  if ne alen blen
    ret false
  end
  i = ulong 0
  while lt i alen
    if ne get STRPOOL add aoff i get STRPOOL add boff i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn strpool_eq_lit off ulong n ulong s view uchar * to bool
  if ne n len s
    ret false
  end
  i = ulong 0
  while lt i n
    if ne get STRPOOL add off i get s i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn skip_ws to void
  p = get JPOS 0
  n = get JLEN 0
  while lt p n
    c = get JBUF p
    if and ne c 32 and ne c 9 and ne c 10 ne c 13
      break
    end
    p = add p 1
  end
  put JPOS 0 p
end

fn hexv c uchar to long
  if and ge c 48 le c 57
    ret long sub c 48
  end
  if and ge c 97 le c 102
    ret add 10 long sub c 97
  end
  if and ge c 65 le c 70
    ret add 10 long sub c 65
  end
  ret neg long 1
end

fn read_hex4 to long
  p = get JPOS 0
  n = get JLEN 0
  if lt sub n p 4
    ret neg long 1
  end
  u = ulong 0
  i = ulong 0
  while lt i 4
    h = hexv get JBUF add p i
    if lt h 0
      ret neg long 1
    end
    u = add mul u 16 ulong h
    i = add i 1
  end
  put JPOS 0 add p 4
  ret long u
end

fn parse_esc_u to long
  cp = read_hex4
  if lt cp 0
    perr t_s2
    ret neg long 1
  end
  ucp = ulong cp
  if and ge ucp 55296 lt ucp 56320
    p = get JPOS 0
    n = get JLEN 0
    if lt sub n p 6
      perr t_s3
      ret neg long 1
    end
    if or ne get JBUF p 92 ne get JBUF add p 1 117
      perr t_s3
      ret neg long 1
    end
    put JPOS 0 add p 2
    lo = read_hex4
    if or lt lo 56320 gt lo 57343
      perr t_s3
      ret neg long 1
    end
    ucp = add 65536 add shl sub ucp 55296 10 sub ulong lo 56320
  else
    if and ge ucp 56320 le ucp 57343
      perr t_s3
      ret neg long 1
    end
  end
  if eq ucp 0
    perr t_s4
    ret neg long 1
  end
  ret long ucp
end

fn parse_str_escape to bool
  p = get JPOS 0
  if ge p get JLEN 0
    perr t_s5
    ret false
  end
  e = get JBUF p
  put JPOS 0 add p 1
  if eq e 34
    strpool_push 34
    ret true
  end
  if eq e 92
    strpool_push 92
    ret true
  end
  if eq e 47
    strpool_push 47
    ret true
  end
  if eq e 98
    strpool_push 8
    ret true
  end
  if eq e 102
    strpool_push 12
    ret true
  end
  if eq e 110
    strpool_push 10
    ret true
  end
  if eq e 114
    strpool_push 13
    ret true
  end
  if eq e 116
    strpool_push 9
    ret true
  end
  if eq e 117
    cp = parse_esc_u
    if lt cp 0
      ret false
    end
    strpool_put_utf8 ulong cp
    ret true
  end
  perr t_s6
  ret false
end

note returns packed (off << 32) | len, or -1 on error
fn parse_str_raw to long
  p = get JPOS 0
  n = get JLEN 0
  if or ge p n ne get JBUF p 34
    perr t_s7
    ret neg long 1
  end
  put JPOS 0 add p 1
  start = get STRUSED 0
  while true
    p = get JPOS 0
    if ge p n
      perr t_s5
      ret neg long 1
    end
    c = get JBUF p
    if eq c 34
      put JPOS 0 add p 1
      slen = sub get STRUSED 0 start
      ret long or shl start 32 slen
    end
    if lt c 32
      perr t_s8
      ret neg long 1
    end
    put JPOS 0 add p 1
    if eq c 92
      if not parse_str_escape
        ret neg long 1
      end
    else
      strpool_push c
    end
  end
  ret neg long 1
end

fn parse_num_int start ulong endp ulong to long
  p = start
  neg_ = false
  if eq get JBUF p 45
    neg_ = true
    p = add p 1
  end
  acc = ulong 0
  lim = ulong 9223372036854775807
  if neg_
    lim = 9223372036854775808
  end
  while lt p endp
    d = ulong sub get JBUF p 48
    if gt acc div sub lim d 10
      ret 0
    end
    acc = add mul acc 10 d
    p = add p 1
  end
  id = jnew 2
  put NB id 1
  if neg_
    if eq acc 9223372036854775808
      put NI id sub neg long 9223372036854775807 1
    else
      put NI id sub 0 long acc
    end
  else
    put NI id long acc
  end
  ret long add id 1
end

fn parse_num to long
  s = get JPOS 0
  n = get JLEN 0
  p = s
  frac = false
  if lt p n
    if eq get JBUF p 45
      p = add p 1
    end
  end
  if ge p n
    perr t_s9
    ret neg long 1
  end
  c0 = get JBUF p
  if or lt c0 48 gt c0 57
    perr t_s9
    ret neg long 1
  end
  if eq c0 48
    p = add p 1
  else
    while lt p n
      c = get JBUF p
      if or lt c 48 gt c 57
        break
      end
      p = add p 1
    end
  end
  has_dot = false
  if lt p n
    if eq get JBUF p 46
      has_dot = true
    end
  end
  if has_dot
    frac = true
    p = add p 1
    dbad = ge p n
    if not dbad
      cd_ = get JBUF p
      if or lt cd_ 48 gt cd_ 57
        dbad = true
      end
    end
    if dbad
      perr t_s9
      ret neg long 1
    end
    while lt p n
      c = get JBUF p
      if or lt c 48 gt c 57
        break
      end
      p = add p 1
    end
  end
  has_exp = false
  if lt p n
    ce_ = get JBUF p
    if or eq ce_ 101 eq ce_ 69
      has_exp = true
    end
  end
  if has_exp
    frac = true
    p = add p 1
    if lt p n
      cs_ = get JBUF p
      if or eq cs_ 43 eq cs_ 45
        p = add p 1
      end
    end
    dbad = ge p n
    if not dbad
      cd_ = get JBUF p
      if or lt cd_ 48 gt cd_ 57
        dbad = true
      end
    end
    if dbad
      perr t_s9
      ret neg long 1
    end
    while lt p n
      c = get JBUF p
      if or lt c 48 gt c 57
        break
      end
      p = add p 1
    end
  end
  if ge sub p s 64
    perr t_s10
    ret neg long 1
  end
  put JPOS 0 p
  if not frac
    r = parse_num_int s p
    if gt r 0
      ret sub r 1
    end
  end
  id = jnew 2
  put NB id 0
  put NI id 0
  ret long id
end

fn match_lit lit view uchar * to bool
  p = get JPOS 0
  n = get JLEN 0
  m = len lit
  if lt sub n p m
    ret false
  end
  i = ulong 0
  while lt i m
    if ne get JBUF add p i get lit i
      ret false
    end
    i = add i 1
  end
  put JPOS 0 add p m
  ret true
end

fn obj_has_key oid ulong koff ulong klen ulong to bool
  e = get NI oid
  while ge e 0
    ue = ulong e
    if strpool_eq get ENT_KOFF ue get ENT_KLEN ue koff klen
      ret true
    end
    e = get ENT_NEXT ue
  end
  ret false
end

fn container_append cid ulong koff ulong klen ulong vid ulong to void
  eid = ent_new koff klen vid
  last = get NLAST cid
  if lt last 0
    put NI cid long eid
  else
    put ENT_NEXT ulong last long eid
  end
  put NLAST cid long eid
  put NC cid add get NC cid 1
end

fn parse_obj_key cid ulong to long
  skip_ws
  kr = parse_str_raw
  if lt kr 0
    ret neg long 1
  end
  koff = shr ulong kr 32
  klen = and ulong kr 4294967295
  if obj_has_key cid koff klen
    perr t_s11
    ret neg long 1
  end
  skip_ws
  p = get JPOS 0
  if or ge p get JLEN 0 ne get JBUF p 58
    perr t_s12
    ret neg long 1
  end
  put JPOS 0 add p 1
  ret kr
end

fn parse_container is_obj bool depth ulong to long
  t = uchar 4
  endch = uchar 93
  if is_obj
    t = 5
    endch = 125
  end
  cid = jnew t
  put JPOS 0 add get JPOS 0 1
  skip_ws
  if lt get JPOS 0 get JLEN 0
    if eq get JBUF get JPOS 0 endch
      put JPOS 0 add get JPOS 0 1
      ret long cid
    end
  end
  if false
    put JPOS 0 add get JPOS 0 1
    ret long cid
  end
  while true
    koff = ulong 0
    klen = ulong 0
    if is_obj
      kr = parse_obj_key cid
      if lt kr 0
        ret neg long 1
      end
      koff = shr ulong kr 32
      klen = and ulong kr 4294967295
    end
    ev = parse_val add depth 1
    if lt ev 0
      ret neg long 1
    end
    container_append cid koff klen ulong ev
    skip_ws
    p = get JPOS 0
    if lt p get JLEN 0
      ch = get JBUF p
      if eq ch 44
        put JPOS 0 add p 1
        continue
      end
      if eq ch endch
        put JPOS 0 add p 1
        ret long cid
      end
    end
    if is_obj
      perr t_s13
    else
      perr t_s14
    end
    ret neg long 1
  end
  ret neg long 1
end

fn parse_val depth ulong to long
  if gt depth 32
    perr t_s15
    ret neg long 1
  end
  skip_ws
  p = get JPOS 0
  if ge p get JLEN 0
    perr t_s16
    ret neg long 1
  end
  c = get JBUF p
  if eq c 123
    ret parse_container true depth
  end
  if eq c 91
    ret parse_container false depth
  end
  if eq c 34
    sr = parse_str_raw
    if lt sr 0
      ret neg long 1
    end
    id = jnew 3
    put NI id long shr ulong sr 32
    put NC id and ulong sr 4294967295
    ret long id
  end
  if or eq c 45 and ge c 48 le c 57
    ret parse_num
  end
  if match_lit t_s17
    id = jnew 1
    put NB id 1
    ret long id
  end
  if match_lit t_s18
    id = jnew 1
    put NB id 0
    ret long id
  end
  if match_lit t_s19
    ret long jnew 0
  end
  perr t_s20
  ret neg long 1
end

fn jparse_current to long
  err_reset
  put NUSED 0 0
  put EUSED 0 0
  put STRUSED 0 0
  put JPOS 0 0
  n = get JLEN 0
  i = ulong 0
  while lt i n
    if eq get JBUF i 0
      perr t_s21
      ret neg long 1
    end
    i = add i 1
  end
  v = parse_val 0
  if ge v 0
    skip_ws
    if ne get JPOS 0 n
      perr t_s22
      ret neg long 1
    end
  end
  ret v
end

fn jget oid ulong key view uchar * to long
  if ne get NT oid 5
    ret neg long 1
  end
  e = get NI oid
  while ge e 0
    ue = ulong e
    if strpool_eq_lit get ENT_KOFF ue get ENT_KLEN ue key
      ret long get ENT_VAL ue
    end
    e = get ENT_NEXT ue
  end
  ret neg long 1
end

fn strpool_eq_slice koff ulong s view uchar * off ulong n ulong to bool
  j = ulong 0
  while lt j n
    if ne get STRPOOL add koff j get s add off j
      ret false
    end
    j = add j 1
  end
  ret true
end

fn jget_slice oid ulong s view uchar * off ulong n ulong to long
  if ne get NT oid 5
    ret neg long 1
  end
  e = get NI oid
  while ge e 0
    ue = ulong e
    if eq get ENT_KLEN ue n
      if strpool_eq_slice get ENT_KOFF ue s off n
        ret long get ENT_VAL ue
      end
    end
    e = get ENT_NEXT ue
  end
  ret neg long 1
end

fn jpath oid ulong path view uchar * to long
  cur = long oid
  pos = ulong 0
  plen = len path
  while lt pos plen
    dot = pos
    while lt dot plen
      if eq get path dot 46
        break
      end
      dot = add dot 1
    end
    cur = jget_slice ulong cur path pos sub dot pos
    if lt cur 0
      ret neg long 1
    end
    if lt dot plen
      pos = add dot 1
    else
      pos = dot
    end
  end
  ret cur
end

note ---- file reading ----
fn copy_argp_to_pbuf off ulong plen ulong to bool
  if gt plen 4095
    ret false
  end
  i = ulong 0
  while lt i plen
    put PBUF i get ARGP add off i
    i = add i 1
  end
  ret true
end

fn read_path_into_fbuf use_argp bool off ulong plen ulong to bool
  if use_argp
    if not copy_argp_to_pbuf off plen
      ret false
    end
  end
  fd = fopen PBUF 0 plen 0 0
  if lt fd 0
    ret false
  end
  if lt len FBUF 4096
    r = enlarge FBUF 4096
    if lt r 0
      cr = fclose int fd
      if lt cr 0
        exit 2
      end
      write_all 2 t_s1
      exit 2
    end
  end
  n = ulong 0
  while true
    cap = len FBUF
    if eq n cap
      if ge cap 4194304
        cr = fclose int fd
        if lt cr 0
          ret false
        end
        ret false
      end
      r2 = enlarge FBUF mul cap 2
      if lt r2 0
        cr = fclose int fd
        if lt cr 0
          exit 2
        end
        write_all 2 t_s1
        exit 2
      end
      cap = len FBUF
    end
    got = read int fd FBUF n sub cap n
    if lt got 0
      cr = fclose int fd
      if lt cr 0
        ret false
      end
      ret false
    end
    if eq got 0
      break
    end
    n = add n ulong got
  end
  cr = fclose int fd
  put FLEN 0 n
  ret ge cr 0
end

fn copy_fbuf_to_jbuf to void
  n = get FLEN 0
  if lt len JBUF n
    r = enlarge JBUF n
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
  end
  i = ulong 0
  while lt i n
    put JBUF i get FBUF i
    i = add i 1
  end
  put JLEN 0 n
end

fn copy_outbuf_to_jbuf to void
  n = get OUTLEN 0
  if lt len JBUF n
    r = enlarge JBUF n
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
  end
  i = ulong 0
  while lt i n
    put JBUF i get OUTBUF i
    i = add i 1
  end
  put JLEN 0 n
end

note ---- checker helpers ----
fn to_lower c uchar to uchar
  if and ge c 65 le c 90
    ret add c 32
  end
  ret c
end

fn eq_ci_strpool off ulong n ulong lit view uchar * to bool
  if ne n len lit
    ret false
  end
  i = ulong 0
  while lt i n
    if ne to_lower get STRPOOL add off i get lit i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn is_placeholder_sp off ulong n ulong to bool
  s = off
  e = add off n
  while lt s e
    c = get STRPOOL s
    if and ne c 32 ne c 9
      break
    end
    s = add s 1
  end
  while gt e s
    c = get STRPOOL sub e 1
    if and ne c 32 ne c 9
      break
    end
    e = sub e 1
  end
  m = sub e s
  if eq m 0
    ret true
  end
  if or eq_ci_strpool s m t_s23 or eq_ci_strpool s m t_s24 or eq_ci_strpool s m t_s25 eq_ci_strpool s m t_s26
    ret true
  end
  if or eq_ci_strpool s m t_s27 or eq_ci_strpool s m t_s28 or eq_ci_strpool s m t_s29 eq_ci_strpool s m t_s30
    ret true
  end
  if or eq_ci_strpool s m t_s31 or eq_ci_strpool s m t_s19 or eq_ci_strpool s m t_s32 eq_ci_strpool s m t_s33
    ret true
  end
  if or eq_ci_strpool s m t_s34 or eq_ci_strpool s m t_s35 or eq_ci_strpool s m t_s36 eq_ci_strpool s m t_s37
    ret true
  end
  if or eq_ci_strpool s m t_s38 or eq_ci_strpool s m t_s39 or eq_ci_strpool s m t_s40 eq_ci_strpool s m t_s41
    ret true
  end
  ret false
end

fn tmp_push c uchar to void
  n = get TMPL 0
  if lt n 511
    put TMPB n c
    put TMPL 0 add n 1
  end
end

fn tmp_u64 v ulong to void
  buf = new uchar 24 0
  if eq v 0
    tmp_push 48
    ret
  end
  k = ulong 0
  while gt v 0
    put buf k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0
    k = sub k 1
    tmp_push get buf k
  end
end

fn err_tmp to void
  i = ulong 0
  n = get TMPL 0
  while lt i n
    err_push get TMPB i
    i = add i 1
  end
end

fn scan_placeholders vid ulong to bool
  t = get NT vid
  if eq t 3
    off = ulong get NI vid
    n = get NC vid
    if is_placeholder_sp off n
      put ERROK 0 1
      put ERRLEN 0 0
      err_str t_s42
      err_strpool off n
      err_str t_s43
      err_tmp
      ret false
    end
    ret true
  end
  if or eq t 4 eq t 5
    e = get NI vid
    idx = ulong 0
    saved = get TMPL 0
    while ge e 0
      ue = ulong e
      put TMPL 0 saved
      if eq t 5
        koff = get ENT_KOFF ue
        klen = get ENT_KLEN ue
        if is_placeholder_sp koff klen
          put ERROK 0 1
          put ERRLEN 0 0
          err_str t_s44
          err_strpool koff klen
          err_str t_s45
          err_tmp
          ret false
        end
        tmp_push 46
        j = ulong 0
        while lt j klen
          tmp_push get STRPOOL add koff j
          j = add j 1
        end
      else
        tmp_push 91
        tmp_u64 idx
        tmp_push 93
      end
      if not scan_placeholders get ENT_VAL ue
        ret false
      end
      idx = add idx 1
      e = get ENT_NEXT ue
    end
    put TMPL 0 saved
  end
  ret true
end

fn need_node oid ulong path view uchar * want_t uchar to long
  v = jpath oid path
  if lt v 0
    put ERROK 0 1
    put ERRLEN 0 0
    err_str t_s46
    err_str path
    ret neg long 1
  end
  if ne get NT ulong v want_t
    put ERROK 0 1
    put ERRLEN 0 0
    err_str t_s47
    err_str path
    err_str t_s48
    ret neg long 1
  end
  ret v
end

fn need_i64 oid ulong path view uchar * minv long to long
  v = need_node oid path 2
  if lt v 0
    ret neg long 1
  end
  uv = ulong v
  if eq get NB uv 0
    put ERROK 0 1
    put ERRLEN 0 0
    err_str t_s47
    err_str path
    err_str t_s49
    ret neg long 1
  end
  iv = get NI uv
  if lt iv minv
    put ERROK 0 1
    put ERRLEN 0 0
    err_str t_s47
    err_str path
    err_str t_s50
    err_i64 iv
    err_str t_s51
    err_i64 minv
    ret neg long 1
  end
  ret v
end

fn is_hex_sp off ulong n ulong want ulong to bool
  if ne n want
    ret false
  end
  i = ulong 0
  while lt i n
    c = get STRPOOL add off i
    ok = or and ge c 48 le c 57 and ge c 97 le c 102
    if not ok
      ret false
    end
    i = add i 1
  end
  ret true
end

fn need_hex oid ulong path view uchar * want ulong to bool
  v = need_node oid path 3
  if lt v 0
    ret false
  end
  off = ulong get NI ulong v
  n = get NC ulong v
  if not is_hex_sp off n want
    put ERROK 0 1
    put ERRLEN 0 0
    err_str t_s47
    err_str path
    err_str t_s52
    err_strpool off n
    err_str t_s53
    err_u64 want
    err_str t_s54
    ret false
  end
  ret true
end

fn need_str_list oid ulong path view uchar * to bool
  a = need_node oid path 4
  if lt a 0
    ret false
  end
  ua = ulong a
  if eq get NC ua 0
    put ERROK 0 1
    put ERRLEN 0 0
    err_str t_s47
    err_str path
    err_str t_s55
    ret false
  end
  e = get NI ua
  idx = ulong 0
  while ge e 0
    ue = ulong e
    if ne get NT get ENT_VAL ue 3
      put ERROK 0 1
      put ERRLEN 0 0
      err_str t_s47
      err_str path
      err_str t_s56
      err_u64 idx
      err_str t_s57
      ret false
    end
    idx = add idx 1
    e = get ENT_NEXT ue
  end
  ret true
end

fn check_overhead_times sid ulong is_graph bool to bool
  vt = need_i64 sid t_s60 0
  vc = need_i64 sid t_s61 0
  vo = need_i64 sid t_s62 sub neg long 9223372036854775807 1
  if or lt vt 0 or lt vc 0 lt vo 0
    ret false
  end
  tot = get NI ulong vt
  chip = get NI ulong vc
  oh = get NI ulong vo
  if ne oh sub tot chip

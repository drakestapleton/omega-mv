note ---- JSON writer (pretty, fixed key order) ----
fn out_push c uchar to void
  n = get OUTLEN 0
  if ge n len OUTBUF
    nc = mul n 2
    if lt nc 8192
      nc = 8192
    end
    r = enlarge OUTBUF nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
  end
  put OUTBUF n c
  put OUTLEN 0 add n 1
end

fn out_raw s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    out_push get s i
    i = add i 1
  end
end

fn out_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    out_push 48
    ret
  end
  k = ulong 0
  while gt v 0
    put tmp k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0
    k = sub k 1
    out_push get tmp k
  end
end

fn out_i64 v long to void
  if lt v 0
    out_push 45
    if eq v sub neg long 9223372036854775807 1
      out_u64 9223372036854775808
    else
      out_u64 ulong neg v
    end
    ret
  end
  out_u64 ulong v
end

fn hex_ch v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

fn out_jchar c uchar to void
  if or eq c 34 eq c 92
    out_push 92
    out_push c
    ret
  end
  if eq c 10
    out_raw t_s183
    ret
  end
  if eq c 9
    out_raw t_s184
    ret
  end
  if lt c 32
    out_raw t_s185
    out_push hex_ch shr ulong c 4
    out_push hex_ch and ulong c 15
    ret
  end
  out_push c
end

fn out_jstr_lit s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    out_jchar get s i
    i = add i 1
  end
end

fn out_jstr_argp off ulong n ulong to void
  i = ulong 0
  while lt i n
    out_jchar get ARGP add off i
    i = add i 1
  end
end

fn out_jstr_sp off ulong n ulong to void
  i = ulong 0
  while lt i n
    out_jchar get STRPOOL add off i
    i = add i 1
  end
end

fn w_indent to void
  out_push 10
  d = get WDEPTH 0
  i = ulong 0
  while lt i d
    out_raw t_s186
    i = add i 1
  end
end

fn w_key k view uchar * to void
  d = get WDEPTH 0
  if eq get WFIRST d 0
    out_push 44
  end
  put WFIRST d 0
  w_indent
  if gt len k 0
    out_push 34
    out_jstr_lit k
    out_raw t_s187
  end
end

fn w_open k view uchar * ch uchar to void
  w_key k
  out_push ch
  d = add get WDEPTH 0 1
  put WDEPTH 0 d
  put WFIRST d 1
end

fn w_close ch uchar to void
  d = get WDEPTH 0
  empty = ne get WFIRST d 0
  put WDEPTH 0 sub d 1
  if not empty
    w_indent
  end
  out_push ch
end

fn kv_s k view uchar * v view uchar * to void
  w_key k
  out_push 34
  out_jstr_lit v
  out_push 34
end

fn kv_argp k view uchar * off ulong n ulong to void
  w_key k
  out_push 34
  out_jstr_argp off n
  out_push 34
end

fn kv_sp k view uchar * off ulong n ulong to void
  w_key k
  out_push 34
  out_jstr_sp off n
  out_push 34
end

fn kv_i k view uchar * v long to void
  w_key k
  out_i64 v
end

fn kv_b k view uchar * v bool to void
  w_key k
  if v
    out_raw t_s17
  else
    out_raw t_s18
  end
end

fn kv_null k view uchar * to void
  w_key k
  out_raw t_s19
end

note ---- ARGP pool helpers ----
fn argp_push c uchar to void
  n = get ARGU 0
  if ge n len ARGP
    nc = mul n 2
    if lt nc 4096
      nc = 4096
    end
    r = enlarge ARGP nc
    if lt r 0
      write_all 2 t_s1
      exit 2
    end
  end
  put ARGP n c
  put ARGU 0 add n 1
end

fn argp_store_fbuf off ulong n ulong to ulong
  start = get ARGU 0
  i = ulong 0
  while lt i n
    argp_push get FBUF add off i
    i = add i 1
  end
  ret start
end

fn argp_store_lit s view uchar * to ulong
  start = get ARGU 0
  i = ulong 0
  n = len s
  while lt i n
    argp_push get s i
    i = add i 1
  end
  ret start
end

fn argp_join dir_off ulong dir_len ulong name view uchar * slot ulong to void
  start = get ARGU 0
  i = ulong 0
  while lt i dir_len
    argp_push get ARGP add dir_off i
    i = add i 1
  end
  if or eq dir_len 0 ne get ARGP sub add dir_off dir_len 1 47
    argp_push 47
  end
  i = ulong 0
  n = len name
  while lt i n
    argp_push get name i
    i = add i 1
  end
  put G_OFF slot start
  put G_LEN slot sub get ARGU 0 start
end

fn argp_eq_lit off ulong n ulong s view uchar * to bool
  if ne n len s
    ret false
  end
  i = ulong 0
  while lt i n
    if ne get ARGP add off i get s i
      ret false
    end
    i = add i 1
  end
  ret true
end

note ---- generator input parsers ----
fn fbuf_starts off ulong lend ulong lit view uchar * to bool
  m = len lit
  if lt sub lend off m
    ret false
  end
  i = ulong 0
  while lt i m
    if ne get FBUF add off i get lit i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn fbuf_eq off ulong n ulong lit view uchar * to bool
  if ne n len lit
    ret false
  end
  i = ulong 0
  while lt i n
    if ne get FBUF add off i get lit i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn fbuf_find off ulong lend ulong lit view uchar * to long
  m = len lit
  if or eq m 0 lt sub lend off m
    ret neg long 1
  end
  lim = sub lend m
  i = off
  while le i lim
    j = ulong 0
    ok = true
    while lt j m
      if ne get FBUF add i j get lit j
        ok = false
        break
      end
      j = add j 1
    end
    if ok
      ret long i
    end
    i = add i 1
  end
  ret neg long 1
end

fn parse_dec_fbuf off ulong lend ulong to long
  if ge off lend
    ret neg long 1
  end
  v = long 0
  i = off
  while lt i lend
    c = get FBUF i
    if or lt c 48 gt c 57
      ret neg long 1
    end
    v = add mul v 10 long sub c 48
    i = add i 1
  end
  ret v
end

fn parse_device_start_line p ulong lend ulong to void
  first = true
  while lt p lend
    while lt p lend
      if ne get FBUF p 32
        break
      end
      p = add p 1
    end
    if ge p lend
      break
    end
    t0 = p
    while lt p lend
      if eq get FBUF p 32
        break
      end
      p = add p 1
    end
    t1 = p
    if first
      put DEV_OFF 0 argp_store_fbuf t0 sub t1 t0
      put DEV_LEN 0 sub t1 t0
      first = false
      continue
    end
    eqp = t0
    while lt eqp t1
      if eq get FBUF eqp 61
        break
      end
      eqp = add eqp 1
    end
    if ge eqp t1
      continue
    end
    klen = sub eqp t0
    v0 = add eqp 1
    vlen = sub t1 v0
    if fbuf_eq t0 klen t_s188
      put DEV_OFF 2 argp_store_fbuf v0 vlen
      put DEV_LEN 2 vlen
    end
    if fbuf_eq t0 klen t_s189
      put DEV_OFF 3 argp_store_fbuf v0 vlen
      put DEV_LEN 3 vlen
    end
    if fbuf_eq t0 klen t_s190
      put DEV_OFF 4 argp_store_fbuf v0 vlen
      put DEV_LEN 4 vlen
    end
    if fbuf_eq t0 klen t_s191
      put DEV_DIRTY 0 parse_dec_fbuf v0 t1
    end
    if fbuf_eq t0 klen t_s192
      put DEV_OFF 5 argp_store_fbuf v0 vlen
      put DEV_LEN 5 vlen
    end
  end
end

fn parse_device_linux_line p ulong lend ulong to void
  note skip "Linux "
  while lt p lend
    if ne get FBUF p 32
      break
    end
    p = add p 1
  end
  h0 = p
  while lt p lend
    if eq get FBUF p 32
      break
    end
    p = add p 1
  end
  if gt p h0
    put DEV_OFF 6 argp_store_fbuf h0 sub p h0
    put DEV_LEN 6 sub p h0
  end
  while lt p lend
    if ne get FBUF p 32
      break
    end
    p = add p 1
  end
  k0 = p
  while lt p lend
    if eq get FBUF p 32
      break
    end
    p = add p 1
  end
  if gt p k0
    put DEV_OFF 7 argp_store_fbuf k0 sub p k0
    put DEV_LEN 7 sub p k0
  end
end

fn read_device to bool
  if not read_path_into_fbuf true get G_OFF 0 get G_LEN 0
    err_reset
    err_str t_s193
    err_argp get G_OFF 0 get G_LEN 0
    ret false
  end
  i = ulong 0
  while lt i 10
    put DEV_OFF i 0
    put DEV_LEN i 0
    i = add i 1
  end
  put DEV_DIRTY 0 neg long 1
  pos = ulong 0
  n = get FLEN 0
  while lt pos n
    lend = pos
    while lt lend n
      if eq get FBUF lend 10
        break
      end
      lend = add lend 1
    end
    if fbuf_starts pos lend t_s194
      parse_device_start_line add pos 6 lend
    else
      if fbuf_starts pos lend t_s195
        e0 = add pos 4
        e1 = e0
        while lt e1 lend
          if eq get FBUF e1 32
            break
          end
          e1 = add e1 1
        end
        put DEV_OFF 1 argp_store_fbuf e0 sub e1 e0
        put DEV_LEN 1 sub e1 e0
      else
        if fbuf_starts pos lend t_s196
          parse_device_linux_line add pos 6 lend
        else
          if and fbuf_starts pos lend t_s197 eq get DEV_LEN 8 0
            cs = fbuf_find pos lend t_s198
            if ge cs 0
              ucs = ulong cs
              put DEV_OFF 8 argp_store_fbuf pos sub ucs pos
              put DEV_LEN 8 sub ucs pos
              d0 = add ucs 2
              put DEV_OFF 9 argp_store_fbuf d0 sub lend d0
              put DEV_LEN 9 sub lend d0
            else
              put DEV_OFF 8 argp_store_fbuf pos sub lend pos
              put DEV_LEN 8 sub lend pos
            end
          end
        end
      end
    end
    if lt lend n
      pos = add lend 1
    else
      pos = lend
    end
  end
  miss = eq get DEV_LEN 0 0
  if eq get DEV_LEN 3 0
    miss = true
  end
  if lt get DEV_DIRTY 0 0
    miss = true
  end
  if eq get DEV_LEN 6 0
    miss = true
  end
  if miss
    err_reset
    err_argp get G_OFF 0 get G_LEN 0
    err_str t_s199
    ret false
  end
  if eq get DEV_LEN 8 0
    nd = argp_store_lit t_s169
    put DEV_OFF 8 nd
    put DEV_LEN 8 13
    put DEV_OFF 9 nd
    put DEV_LEN 9 13
  end
  ret true
end

fn fbuf_ends off ulong lend ulong suf view uchar * to bool
  m = len suf
  if lt sub lend off m
    ret false
  end
  st = sub lend m
  i = ulong 0
  while lt i m
    if ne get FBUF add st i get suf i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn fbuf_is_hex64 off ulong to bool
  i = ulong 0
  while lt i 64
    c = get FBUF add off i
    if not or and ge c 48 le c 57 and ge c 97 le c 102
      ret false
    end
    i = add i 1
  end
  ret true
end

fn read_binaries to bool
  if not read_path_into_fbuf true get G_OFF 1 get G_LEN 1
    err_reset
    err_str t_s193
    err_argp get G_OFF 1 get G_LEN 1
    ret false
  end
  put BIN_SET 0 0
  put LIB_SET 0 0
  pos = ulong 0
  n = get FLEN 0
  while lt pos n
    lend = pos
    while lt lend n
      if eq get FBUF lend 10
        break
      end
      lend = add lend 1
    end
    if ge sub lend pos 66
      if fbuf_is_hex64 pos
        np = add pos 64
        while lt np lend
          ch_ = get FBUF np
          if and ne ch_ 32 ne ch_ 42
            break
          end
          np = add np 1
        end
        if fbuf_ends np lend t_s200
          j = ulong 0
          while lt j 64
            put BIN_SHA j get FBUF add pos j
            j = add j 1
          end
          put BIN_SET 0 1
        else
          if fbuf_ends np lend t_s201
            j = ulong 0
            while lt j 64
              put LIB_SHA j get FBUF add pos j
              j = add j 1
            end
            put LIB_SET 0 1
          end
        end
      end
    end
    if lt lend n
      pos = add lend 1
    else
      pos = lend
    end
  end
  if or eq get BIN_SET 0 0 eq get LIB_SET 0 0
    err_reset
    err_argp get G_OFF 1 get G_LEN 1
    err_str t_s202
    ret false
  end
  ret true
end

fn parse_signed_at p ulong lend ulong to long
  neg_ = false
  if lt p lend
    if eq get FBUF p 45
      neg_ = true
      p = add p 1
    end
  end
  v = long 0
  while lt p lend
    c = get FBUF p
    if or lt c 48 gt c 57
      break
    end
    v = add mul v 10 long sub c 48
    p = add p 1
  end
  if neg_
    ret sub 0 v
  end
  ret v
end

fn skip_signed_at p ulong lend ulong to ulong
  if lt p lend
    if eq get FBUF p 45
      p = add p 1
    end
  end
  while lt p lend
    c = get FBUF p
    if or lt c 48 gt c 57
      break
    end
    p = add p 1
  end
  ret p
end

fn parse_pf_line pos ulong lend ulong to bool
  if not fbuf_starts pos lend t_s203
    ret false
  end
  p = add pos 16
  p1 = skip_signed_at p lend
  if eq p1 p
    ret false
  end
  pf = parse_signed_at p lend
  if not fbuf_starts p1 lend t_s204
    ret false
  end
  p2 = add p1 6
  p3 = skip_signed_at p2 lend
  if or eq p3 p2 or ge p3 lend ne get FBUF p3 41
    ret false
  end
  red = parse_signed_at p2 lend
  put K_PREF 0 pf
  put K_RED 0 red
  ret true
end

fn store_bname b0 ulong b1 ulong to void
  blen = sub b1 b0
  if gt blen 63
    blen = 63
  end
  i = ulong 0
  while lt i blen
    put K_BNAME i get FBUF add b0 i
    i = add i 1
  end
  put K_BNLEN 0 blen
end

fn parse_fp8_line pos ulong lend ulong to bool
  if not fbuf_starts pos lend t_s205
    ret false
  end
  p = add pos 19
  p1 = skip_signed_at p lend
  if eq p1 p
    ret false
  end
  fv = parse_signed_at p lend
  if not fbuf_starts p1 lend t_s206
    ret false
  end
  p2 = add p1 9
  p3 = skip_signed_at p2 lend
  if eq p3 p2
    ret false
  end
  bar = parse_signed_at p2 lend
  if not fbuf_starts p3 lend t_s207
    ret false
  end
  b0 = add p3 2
  b1 = b0
  while lt b1 lend
    if eq get FBUF b1 41
      break
    end
    b1 = add b1 1
  end
  if or eq b1 b0 ge b1 lend
    ret false
  end
  cf = fbuf_find b1 lend t_s208
  if lt cf 0
    ret false
  end
  c0 = add ulong cf 8
  c1 = skip_signed_at c0 lend
  if eq c1 c0
    ret false
  end
  ca = parse_signed_at c0 lend
  put K_FP8V 0 fv
  put K_BARR 0 bar
  put K_CACH 0 ca
  store_bname b0 b1
  ret true
end

fn read_knobs to bool
  if not read_path_into_fbuf true get AOFF 4 get ALEN 4
    err_reset
    err_str t_s193
    err_argp get AOFF 4 get ALEN 4
    ret false
  end
  have_pf = false
  have_fp8 = false
  pos = ulong 0
  n = get FLEN 0
  while lt pos n
    lend = pos
    while lt lend n
      if eq get FBUF lend 10
        break
      end
      lend = add lend 1
    end
    if not have_pf
      if parse_pf_line pos lend
        have_pf = true
      end
    end
    if not have_fp8
      if parse_fp8_line pos lend
        have_fp8 = true
      end
    end
    if lt lend n
      pos = add lend 1
    else
      pos = lend
    end
  end
  if or not have_pf not have_fp8
    err_reset
    err_argp get AOFF 4 get ALEN 4
    err_str t_s209
    ret false
  end
  ret true
end

fn read_build_log to void
  put G_LEN 3 0
  put G_BLOG_BYTES 0 0
  if not read_path_into_fbuf true get G_OFF 2 get G_LEN 2
    ret
  end
  n = get FLEN 0
  put G_BLOG_BYTES 0 n
  pos = ulong 0
  while lt pos n
    lend = pos
    while lt lend n
      if eq get FBUF lend 10
        break
      end
      lend = add lend 1
    end
    if ge fbuf_find pos lend t_s210 0
      put G_OFF 3 argp_store_fbuf pos sub lend pos
      put G_LEN 3 sub lend pos
      ret
    end
    if lt lend n
      pos = add lend 1
    else
      pos = lend
    end
  end
end

fn sget sid ulong path view uchar * to long
  v = jpath sid path
  bad = lt v 0
  if not bad
    uv = ulong v
    if ne get NT uv 2
      bad = true
    end
    if eq get NB uv 0
      bad = true
    end
    if lt get NI uv 0
      bad = true
    end
  end
  if bad
    err_reset
    err_str t_s211
    err_str path
    err_str t_s212
    ret neg long 1
  end
  ret get NI ulong v
end

fn is_stamp_kind off ulong n ulong to bool
  if or strpool_eq_lit off n t_s213 or strpool_eq_lit off n t_s214 or strpool_eq_lit off n t_s215 strpool_eq_lit off n t_s216
    ret true
  end
  if or strpool_eq_lit off n t_s217 or strpool_eq_lit off n t_s218 or strpool_eq_lit off n t_s219 strpool_eq_lit off n t_s220
    ret true
  end
  ret or strpool_eq_lit off n t_s221 or strpool_eq_lit off n t_s222 or strpool_eq_lit off n t_s223 strpool_eq_lit off n t_s224
end

fn check_pk_entry arr ulong koff ulong klen ulong to bool
  bad = ne get NT arr 4
  if not bad
    if ne get NC arr 2
      bad = true
    end
  end
  if not bad
    e0 = ulong get NI arr
    e1 = ulong get ENT_NEXT e0
    v0 = get ENT_VAL e0
    v1 = get ENT_VAL e1
    if ne get NT v0 2
      bad = true
    end
    if eq get NB v0 0
      bad = true
    end
    if ne get NT v1 2
      bad = true
    end
    if eq get NB v1 0
      bad = true
    end
    if lt get NI v0 1
      bad = true
    end
    if lt get NI v1 0
      bad = true
    end
  end
  if bad
    err_reset
    err_str t_s255
    err_strpool koff klen
    err_str t_s256
    ret false
  end
  if not is_stamp_kind koff klen
    err_reset
    err_str t_s257
    err_strpool koff klen
    ret false
  end
  ret true
end

fn check_pk_all pk ulong to bool
  e = get NI pk
  while ge e 0
    ue = ulong e
    if not check_pk_entry get ENT_VAL ue get ENT_KOFF ue get ENT_KLEN ue
      ret false
    end
    e = get ENT_NEXT ue
  end
  ret true
end

fn extract_stats_tail s ulong to bool
  vd = jget s t_s246
  vbad = lt vd 0
  if not vbad
    if ne get NT ulong vd 3
      vbad = true
    end
  end
  if vbad
    err_reset
    err_str t_s247
    ret false
  end
  vdo = ulong get NI ulong vd
  vdl = get NC ulong vd
  if and not strpool_eq_lit vdo vdl t_s151 not strpool_eq_lit vdo vdl t_s130
    err_reset
    err_str t_s247
    ret false
  end
  put S_VERD_OFF 0 vdo
  put S_VERD_LEN 0 vdl
  pk = jpath s t_s248
  pbad = lt pk 0
  if not pbad
    if ne get NT ulong pk 5
      pbad = true
    end
    if eq get NC ulong pk 0
      pbad = true
    end
  end
  if pbad
    err_reset
    err_str t_s249
    ret false
  end
  put S_PK_ID 0 ulong pk
  mism = ne get S_CACH 0 get K_CACH 0
  if ne get S_RED 0 get K_RED 0
    mism = true
  end
  if mism
    err_reset
    err_str t_s250
    err_i64 get S_CACH 0
    err_str t_s251
    err_i64 get K_CACH 0
    err_str t_s252
    err_i64 get S_RED 0
    err_str t_s251
    err_i64 get K_RED 0
    err_str t_s253
    ret false
  end
  if and strpool_eq_lit vdo vdl t_s151 ne get S_FAILED 0 0
    err_reset
    err_str t_s254
    err_i64 get S_FAILED 0
    ret false
  end
  ret check_pk_all ulong pk
end

fn extract_stats s ulong to bool
  v = sget s t_s225
  if lt v 0
    ret false
  end
  put S_LAYERS 0 v
  v = sget s t_s226
  if lt v 0
    ret false
  end
  put S_VOCAB 0 v
  v = sget s t_s227
  if lt v 0
    ret false
  end
  put S_POS 0 v
  v = sget s t_s228
  if lt v 0
    ret false
  end
  put S_REPS 0 v
  v = sget s t_s229
  if lt v 0
    ret false
  end
  put S_RED 0 v
  v = sget s t_s230
  if lt v 0
    ret false
  end
  put S_CACH 0 v
  v = sget s t_s231
  if lt v 0
    ret false
  end
  put S_CL 0 v
  v = sget s t_s232
  if lt v 0
    ret false
  end
  put S_CS 0 v
  v = sget s t_s233
  if lt v 0
    ret false
  end
  put S_TL 0 v
  v = sget s t_s234
  if lt v 0
    ret false
  end
  put S_SPAN 0 v
  v = sget s t_s235
  if lt v 0
    ret false
  end
  put S_TCHIP 0 v
  v = sget s t_s236
  if lt v 0
    ret false
  end
  put S_MT 0 v
  v = sget s t_s237
  if lt v 0
    ret false
  end
  put S_MC 0 v
  v = sget s t_s238
  if lt v 0
    ret false
  end
  put S_MR 0 v
  v = sget s t_s239
  if lt v 0
    ret false
  end
  put S_BT 0 v
  v = sget s t_s240
  if lt v 0
    ret false
  end
  put S_BC 0 v
  v = sget s t_s241
  if lt v 0
    ret false
  end
  put S_BL 0 v
  v = sget s t_s242
  if lt v 0
    ret false
  end
  put S_BS 0 v
  v = sget s t_s243
  if lt v 0
    ret false
  end
  put S_BID 0 v
  v = sget s t_s244
  if lt v 0
    ret false
  end
  put S_CHECKS 0 v
  v = sget s t_s245
  if lt v 0
    ret false
  end
  put S_FAILED 0 v
  ret extract_stats_tail s
end

fn emit_head_and_meta to void
  kv_s t_s111 t_s156
  kv_argp t_s112 get AOFF 5 get ALEN 5
  w_key t_s113
  out_push 34
  if argp_eq_lit get AOFF 5 get ALEN 5 t_s128
    out_jstr_lit t_s258
    out_jstr_argp get AOFF 2 get ALEN 2
    out_jstr_lit t_s259
    out_jstr_argp get DEV_OFF 0 get DEV_LEN 0
    out_jstr_lit t_s260
  else
    out_jstr_lit t_s152
    out_jstr_argp get AOFF 5 get ALEN 5
    out_jstr_lit t_s261
    out_jstr_argp get AOFF 2 get ALEN 2
    out_jstr_lit t_s262
    out_jstr_argp get DEV_OFF 0 get DEV_LEN 0
    out_jstr_lit t_s149
  end
  out_push 34
  kv_sp t_s114 get S_VERD_OFF 0 get S_VERD_LEN 0

  w_open t_s116 123
  kv_argp t_s263 get AOFF 6 get ALEN 6
  kv_argp t_s264 get DEV_OFF 3 get DEV_LEN 3
  kv_b t_s191 ne get DEV_DIRTY 0 0
  w_key t_s265
  out_raw t_s266
  out_i64 get DEV_DIRTY 0
  out_raw t_s267
  if gt get DEV_LEN 4 0
    kv_argp t_s190 get DEV_OFF 4 get DEV_LEN 4
  end
  if gt get DEV_LEN 5 0
    kv_argp t_s192 get DEV_OFF 5 get DEV_LEN 5
  end
  w_close 125

  w_open t_s117 123
  kv_argp t_s268 get DEV_OFF 0 get DEV_LEN 0
  if gt get DEV_LEN 1 0
    kv_argp t_s269 get DEV_OFF 1 get DEV_LEN 1
  end
  if gt get DEV_LEN 2 0
    kv_argp t_s270 get DEV_OFF 2 get DEV_LEN 2
  end
  w_key t_s271
  out_push 34
  out_i64 get S_CHECKS 0
  out_raw t_s272
  out_i64 get S_FAILED 0
  out_raw t_s273
  w_close 125
end


note SPDX-License-Identifier: Apache-2.0
note The console hook dispatcher of the omega tool: visor_console_set_ops(&con,
note visor_console_default_ops) -- every hook goes to tools/omega_ops.om.

fn vcon_hook_wired hid ulong to bool
  ret lt hid 17
end

fn vcon_hook_call hid ulong to long
  ret vom_call hid
end

fn vcon_hook_classify to long
  ret vom_classify
end

fn vcon_hook_eval to long
  ret vom_eval
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_matvec.c (MatVec living kernel: spec_id,
note scalar/unroll2/unroll4_dual AArch64 synthesis, triple ID, V0 verification,
note reference oracle, AArch64 kernel execution, benchmark, adapt, dispatch).
note Composes on seed/ng/sha256.om and om/aarch64/aarch64_om2.om.
om2

const MV_MAX_REALS ulong 3
const MV_KIND_SCALAR ulong 0
const MV_KIND_UNROLL2 ulong 1
const MV_KIND_UNROLL4_DUAL ulong 2
const MV_KIND_OPERATION ulong 3
const MV_KIND_REALIZATION ulong 9
const MV_PROFILE_V8A ulong 1
const MV_CODE_STRIDE ulong 256

const MV_BASE_A ulong 0x10000000
const MV_BASE_X ulong 0x20000000
const MV_BASE_Y ulong 0x30000000

global g_mv_spec_id uchar 32
global g_mv_spec_name uchar 64
global g_mv_spec_nlen ulong 1
global g_mv_spec_max_m ulong 1
global g_mv_spec_max_n ulong 1

global g_mv_mach_id uchar 32
global g_mv_profile ulong 1
global g_mv_real_cnt ulong 1
global g_mv_init ulong 1

global g_mv_code uchar 768
global g_mv_code_len ulong 3
global g_mv_real_id uchar 96
global g_mv_unroll ulong 3
global g_mv_acc ulong 3
global g_mv_verified ulong 3

global g_mv_mat ulong 1024
global g_mv_vec ulong 64
global g_mv_y ulong 64
global g_mv_yref ulong 64

global g_mv_bench_m ulong 1
global g_mv_bench_n ulong 1
global g_mv_bench_ns ulong 1
global g_mv_bench_parity ulong 1

global g_mv_sel_kind ulong 1
global g_mv_sel_ns ulong 3
global g_mv_sel_adapted ulong 1

fn omega_matvec_spec_init name view uchar * nlen ulong max_m ulong max_n ulong to long
  if gt nlen 63
    ret -1
  end
  for i ulong 64
    put g_mv_spec_name i 0
  end
  for i ulong nlen bound 64
    put g_mv_spec_name i get name i
  end
  put g_mv_spec_nlen 0 nlen
  put g_mv_spec_max_m 0 max_m
  put g_mv_spec_max_n 0 max_n

  put sh_dat 0 uchar 79
  put sh_dat 1 uchar 77
  put sh_dat 2 uchar 71
  put sh_dat 3 uchar 48
  put sh_dat 4 uchar MV_KIND_OPERATION
  put sh_dat 5 uchar 0xaa
  put sh_dat 6 uchar and shr max_m 24 255
  put sh_dat 7 uchar and shr max_m 16 255
  put sh_dat 8 uchar and shr max_m 8 255
  put sh_dat 9 uchar and max_m 255
  put sh_dat 10 uchar and shr max_n 24 255
  put sh_dat 11 uchar and shr max_n 16 255
  put sh_dat 12 uchar and shr max_n 8 255
  put sh_dat 13 uchar and max_n 255
  for i ulong nlen bound 64
    put sh_dat add 14 i get g_mv_spec_name i
  end
  sh_all add 14 nlen
  for i ulong 32
    put g_mv_spec_id i get sh_dig i
  end
  ret 0
end

fn mv_emit buf edit uchar * st edit ulong 2 w long to long
  ret a64put buf st w
end

fn mv_emit_scalar buf edit uchar * st edit ulong 2 to long
  rc = mv_emit buf st a64cbz 1 3 17
  rc = or rc mv_emit buf st a64cbz 1 4 16
  rc = or rc mv_emit buf st a64movreg 1 5 3
  rc = or rc mv_emit buf st a64movreg 1 6 0
  rc = or rc mv_emit buf st a64movreg 1 7 1
  rc = or rc mv_emit buf st a64movreg 1 8 31
  rc = or rc mv_emit buf st a64movreg 1 13 4
  rc = or rc mv_emit buf st a64ldrxpost 10 6 8
  rc = or rc mv_emit buf st a64ldrxpost 11 7 8
  rc = or rc mv_emit buf st a64mulreg 1 12 10 11
  rc = or rc mv_emit buf st a64addreg 1 8 8 12
  rc = or rc mv_emit buf st a64subsimm 1 13 13 1
  rc = or rc mv_emit buf st a64bcond 1 -5
  rc = or rc mv_emit buf st a64strxpost 8 2 8
  rc = or rc mv_emit buf st a64movreg 1 0 6
  rc = or rc mv_emit buf st a64subsimm 1 5 5 1
  rc = or rc mv_emit buf st a64bcond 1 -13
  rc = or rc mv_emit buf st a64ret
  ret rc
end

fn mv_emit_unroll2_p1 buf edit uchar * st edit ulong 2 to long
  rc = mv_emit buf st a64cbz 1 3 30
  rc = or rc mv_emit buf st a64cbz 1 4 29
  rc = or rc mv_emit buf st a64movz 1 16 1 0
  rc = or rc mv_emit buf st a64andreg 1 15 4 16
  rc = or rc mv_emit buf st a64subreg 1 14 4 15
  rc = or rc mv_emit buf st a64movreg 1 5 3
  rc = or rc mv_emit buf st a64movreg 1 6 0
  rc = or rc mv_emit buf st a64movreg 1 7 1
  rc = or rc mv_emit buf st a64movreg 1 8 31
  rc = or rc mv_emit buf st a64movreg 1 13 14
  rc = or rc mv_emit buf st a64cbz 1 13 11
  rc = or rc mv_emit buf st a64ldrxpost 10 6 8
  rc = or rc mv_emit buf st a64ldrxpost 11 7 8
  rc = or rc mv_emit buf st a64ldrxpost 12 6 8
  rc = or rc mv_emit buf st a64ldrxpost 16 7 8
  ret rc
end

fn mv_emit_unroll2_p2 buf edit uchar * st edit ulong 2 to long
  rc = mv_emit buf st a64mulreg 1 10 10 11
  rc = or rc mv_emit buf st a64mulreg 1 12 12 16
  rc = or rc mv_emit buf st a64addreg 1 8 8 10
  rc = or rc mv_emit buf st a64addreg 1 8 8 12
  rc = or rc mv_emit buf st a64subsimm 1 13 13 2
  rc = or rc mv_emit buf st a64bcond 1 -9
  rc = or rc mv_emit buf st a64cbz 1 15 5
  rc = or rc mv_emit buf st a64ldrxpost 10 6 8
  rc = or rc mv_emit buf st a64ldrxpost 11 7 8
  rc = or rc mv_emit buf st a64mulreg 1 10 10 11
  rc = or rc mv_emit buf st a64addreg 1 8 8 10
  rc = or rc mv_emit buf st a64strxpost 8 2 8
  rc = or rc mv_emit buf st a64movreg 1 0 6
  rc = or rc mv_emit buf st a64subsimm 1 5 5 1
  rc = or rc mv_emit buf st a64bcond 1 -23
  rc = or rc mv_emit buf st a64ret
  ret rc
end

fn mv_emit_u4_p1 buf edit uchar * st edit ulong 2 to long
  rc = mv_emit buf st a64cbz 1 3 43
  rc = or rc mv_emit buf st a64cbz 1 4 42
  rc = or rc mv_emit buf st a64movz 1 16 3 0
  rc = or rc mv_emit buf st a64andreg 1 15 4 16
  rc = or rc mv_emit buf st a64subreg 1 14 4 15
  rc = or rc mv_emit buf st a64movreg 1 5 3
  rc = or rc mv_emit buf st a64movreg 1 6 0
  rc = or rc mv_emit buf st a64movreg 1 7 1
  rc = or rc mv_emit buf st a64movreg 1 8 31
  rc = or rc mv_emit buf st a64movreg 1 9 31
  rc = or rc mv_emit buf st a64movreg 1 13 14
  rc = or rc mv_emit buf st a64cbz 1 13 19
  ret rc
end

fn mv_emit_u4_p2 buf edit uchar * st edit ulong 2 to long
  rc = mv_emit buf st a64ldrxpost 10 6 8
  rc = or rc mv_emit buf st a64ldrxpost 11 7 8
  rc = or rc mv_emit buf st a64mulreg 1 10 10 11
  rc = or rc mv_emit buf st a64addreg 1 8 8 10
  rc = or rc mv_emit buf st a64ldrxpost 12 6 8
  rc = or rc mv_emit buf st a64ldrxpost 16 7 8
  rc = or rc mv_emit buf st a64mulreg 1 12 12 16
  rc = or rc mv_emit buf st a64addreg 1 9 9 12
  rc = or rc mv_emit buf st a64ldrxpost 10 6 8
  rc = or rc mv_emit buf st a64ldrxpost 11 7 8
  rc = or rc mv_emit buf st a64mulreg 1 10 10 11
  rc = or rc mv_emit buf st a64addreg 1 8 8 10
  rc = or rc mv_emit buf st a64ldrxpost 12 6 8
  rc = or rc mv_emit buf st a64ldrxpost 16 7 8
  rc = or rc mv_emit buf st a64mulreg 1 12 12 16
  rc = or rc mv_emit buf st a64addreg 1 9 9 12
  ret rc
end

fn mv_emit_u4_p3 buf edit uchar * st edit ulong 2 to long
  rc = mv_emit buf st a64subsimm 1 13 13 4
  rc = or rc mv_emit buf st a64bcond 1 -17
  rc = or rc mv_emit buf st a64addreg 1 8 8 9
  rc = or rc mv_emit buf st a64cbz 1 15 8
  rc = or rc mv_emit buf st a64movreg 1 13 15
  rc = or rc mv_emit buf st a64ldrxpost 10 6 8
  rc = or rc mv_emit buf st a64ldrxpost 11 7 8
  rc = or rc mv_emit buf st a64mulreg 1 10 10 11
  rc = or rc mv_emit buf st a64addreg 1 8 8 10
  rc = or rc mv_emit buf st a64subsimm 1 13 13 1
  rc = or rc mv_emit buf st a64bcond 1 -5
  rc = or rc mv_emit buf st a64strxpost 8 2 8
  rc = or rc mv_emit buf st a64movreg 1 0 6
  rc = or rc mv_emit buf st a64subsimm 1 5 5 1
  rc = or rc mv_emit buf st a64bcond 1 -36
  rc = or rc mv_emit buf st a64ret
  ret rc
end

fn mv_triple_id kind ulong clen ulong to void
  prof = get g_mv_profile 0
  put sh_dat 0 uchar 79
  put sh_dat 1 uchar 77
  put sh_dat 2 uchar 71
  put sh_dat 3 uchar 48
  put sh_dat 4 uchar MV_KIND_REALIZATION
  put sh_dat 5 uchar and prof 255
  put sh_dat 6 0
  put sh_dat 7 0
  put sh_dat 8 0
  put sh_dat 9 0
  put sh_dat 10 uchar and shr clen 24 255
  put sh_dat 11 uchar and shr clen 16 255
  put sh_dat 12 uchar and shr clen 8 255
  put sh_dat 13 uchar and clen 255
  for i ulong 32
    put sh_dat add 14 i get g_mv_spec_id i
    put sh_dat add 46 i get g_mv_mach_id i
  end
  base = mul kind MV_CODE_STRIDE
  for i ulong clen bound 256
    put sh_dat add 78 i get g_mv_code add base i
  end
  sh_all add 78 clen
  rbase = mul kind 32
  for i ulong 32
    put g_mv_real_id add rbase i get sh_dig i
  end
end

fn omega_matvec_synthesize kind ulong to long
  if ge kind MV_MAX_REALS
    ret -1
  end
  buf = new uchar 256 0
  st = new ulong 2 0
  put st 0 0
  put st 1 256
  rc = long -1
  if eq kind MV_KIND_SCALAR
    put g_mv_unroll kind 1
    put g_mv_acc kind 1
    rc = mv_emit_scalar buf st
  end
  if eq kind MV_KIND_UNROLL2
    put g_mv_unroll kind 2
    put g_mv_acc kind 1
    rc = mv_emit_unroll2_p1 buf st
    rc = or rc mv_emit_unroll2_p2 buf st
  end
  if eq kind MV_KIND_UNROLL4_DUAL
    put g_mv_unroll kind 4
    put g_mv_acc kind 2
    rc = mv_emit_u4_p1 buf st
    rc = or rc mv_emit_u4_p2 buf st
    rc = or rc mv_emit_u4_p3 buf st
  end
  if ne rc 0
    ret -1
  end
  clen = get st 0
  base = mul kind MV_CODE_STRIDE
  for i ulong clen bound 256
    put g_mv_code add base i get buf i
  end
  put g_mv_code_len kind clen
  mv_triple_id kind clen
  if ne get g_mv_profile 0 MV_PROFILE_V8A
    put g_mv_verified kind 0
    ret -1
  end
  msg = new uchar 128 0
  if ne a64validate buf clen msg 128 0
    put g_mv_verified kind 0
    ret -1
  end
  put g_mv_verified kind 1
  ret 0
end

fn omega_matvec_kernel_init mach_id view uchar 32 profile ulong to long
  for i ulong 32
    put g_mv_mach_id i get mach_id i
  end
  put g_mv_profile 0 profile
  put g_mv_real_cnt 0 0
  put g_mv_init 0 0
  for k ulong MV_MAX_REALS
    if ne omega_matvec_synthesize k 0
      ret -1
    end
  end
  put g_mv_real_cnt 0 MV_MAX_REALS
  put g_mv_init 0 1
  ret 0
end

fn omega_matvec_reference m ulong n ulong to void
  for i ulong m bound 64
    acc = ulong 0
    row = mul i n
    for j ulong n bound 64
      acc = add acc mul get g_mv_mat add row j get g_mv_vec j
    end
    put g_mv_yref i acc
  end
end

fn mv_load_u32 kind ulong pc ulong to ulong
  off = add mul kind MV_CODE_STRIDE mul pc 4
  b0 = ulong get g_mv_code off
  b1 = ulong get g_mv_code add off 1
  b2 = ulong get g_mv_code add off 2
  b3 = ulong get g_mv_code add off 3
  ret or b0 or shl b1 8 or shl b2 16 shl b3 24
end

fn mv_sext19 v ulong to long
  if ne and v 0x40000 0
    ret sub long v 0x80000
  end
  ret long v
end

fn mv_rget regs view ulong 32 r ulong to ulong
  if eq r 31
    ret 0
  end
  ret get regs r
end

fn mv_rput regs edit ulong 32 r ulong v ulong to void
  if lt r 31
    put regs r v
  end
end

fn mv_mem_load addr ulong to ulong
  if ge addr MV_BASE_X
    idx = shr sub addr MV_BASE_X 3
    ret get g_mv_vec idx
  end
  idx = shr sub addr MV_BASE_A 3
  ret get g_mv_mat idx
end

fn mv_step w ulong pc ulong regs edit ulong 32 fl edit ulong 2 to long
  if eq w 0xd65f03c0
    ret -100
  end
  op8 = and w 0xff000000
  if eq op8 0xb4000000
    rt = and w 31
    imm = mv_sext19 and shr w 5 0x7ffff
    if eq mv_rget regs rt 0
      ret add long pc imm
    end
    ret long add pc 1
  end
  if eq and w 0xff00001f 0x54000001
    imm = mv_sext19 and shr w 5 0x7ffff
    if eq get fl 0 0
      ret add long pc imm
    end
    ret long add pc 1
  end
  if eq and w 0xffe00000 0xd2800000
    rd = and w 31
    imm = and shr w 5 0xffff
    mv_rput regs rd imm
    ret long add pc 1
  end
  if eq and w 0xffe0ffe0 0xaa0003e0
    rd = and w 31
    rm = and shr w 16 31
    mv_rput regs rd mv_rget regs rm
    ret long add pc 1
  end
  if eq and w 0xffe0fc00 0x8a000000
    rd = and w 31
    rn = and shr w 5 31
    rm = and shr w 16 31
    mv_rput regs rd and mv_rget regs rn mv_rget regs rm
    ret long add pc 1
  end
  if eq and w 0xffe0fc00 0xcb000000
    rd = and w 31
    rn = and shr w 5 31
    rm = and shr w 16 31
    mv_rput regs rd sub mv_rget regs rn mv_rget regs rm
    ret long add pc 1
  end
  if eq and w 0xffe0fc00 0x8b000000
    rd = and w 31
    rn = and shr w 5 31
    rm = and shr w 16 31
    mv_rput regs rd add mv_rget regs rn mv_rget regs rm
    ret long add pc 1
  end
  if eq and w 0xffe0fc00 0x9b007c00
    rd = and w 31
    rn = and shr w 5 31
    rm = and shr w 16 31
    mv_rput regs rd mul mv_rget regs rn mv_rget regs rm
    ret long add pc 1
  end
  if eq op8 0xf1000000
    rd = and w 31
    rn = and shr w 5 31
    imm = and shr w 10 0xfff
    res = sub mv_rget regs rn imm
    mv_rput regs rd res
    if eq res 0
      put fl 0 1
    else
      put fl 0 0
    end
    ret long add pc 1
  end
  if eq and w 0xffe00c00 0xf8400400
    rt = and w 31
    rn = and shr w 5 31
    addr = mv_rget regs rn
    val = mv_mem_load addr
    mv_rput regs rt val
    mv_rput regs rn add addr 8
    ret long add pc 1
  end
  if eq and w 0xffe00c00 0xf8000400
    rt = and w 31
    rn = and shr w 5 31
    addr = mv_rget regs rn
    idx = shr sub addr MV_BASE_Y 3
    put g_mv_y idx mv_rget regs rt
    mv_rput regs rn add addr 8
    ret long add pc 1
  end
  ret -1
end

fn omega_matvec_exec kind ulong m ulong n ulong to long
  if ge kind MV_MAX_REALS
    ret -1
  end
  clen = get g_mv_code_len kind
  if eq clen 0
    ret -1
  end
  if eq get g_mv_verified kind 0
    ret -1
  end
  ninsns = div clen 4
  regs = new ulong 32 0
  fl = new ulong 2 0
  put regs 0 MV_BASE_A
  put regs 1 MV_BASE_X
  put regs 2 MV_BASE_Y
  put regs 3 m
  put regs 4 n
  pc = ulong 0
  steps = ulong 0
  while lt steps 1000000 bound 1000000
    if ge pc ninsns
      ret -1
    end
    w = mv_load_u32 kind pc
    nxt = mv_step w pc regs fl
    if eq nxt -100
      put g_mv_bench_ns 0 steps
      ret 0
    end
    if lt nxt 0
      ret -1
    end
    pc = ulong nxt
    steps = add steps 1
  end
  ret -1
end

fn omega_matvec_benchmark kind ulong m ulong n ulong iters ulong to long
  if ge kind MV_MAX_REALS
    ret -1
  end
  if eq m 0
    ret -1
  end
  if eq n 0
    ret -1
  end
  if eq iters 0
    ret -1
  end
  msz = mul m n
  if gt msz 1024
    ret -1
  end
  if gt m 64
    ret -1
  end
  if gt n 64
    ret -1
  end
  for i ulong msz bound 1024
    put g_mv_mat i add mul i 3 1
  end
  for j ulong n bound 64
    put g_mv_vec j add mul j 5 2
  end
  omega_matvec_reference m n
  if ne omega_matvec_exec kind m n 0
    ret -1
  end
  par = ulong 1
  for i ulong m bound 64
    if ne get g_mv_y i get g_mv_yref i
      par = 0
    end
  end
  put g_mv_bench_m 0 m
  put g_mv_bench_n 0 n
  put g_mv_bench_parity 0 par
  tot = ulong 0
  for it ulong iters bound 512
    if ne omega_matvec_exec kind m n 0
      ret -1
    end
    tot = add tot get g_mv_bench_ns 0
  end
  put g_mv_bench_ns 0 div tot iters
  ret 0
end

fn omega_matvec_adapt m ulong n ulong to long
  if eq get g_mv_init 0 0
    ret -1
  end
  iters = ulong 8
  for k ulong MV_MAX_REALS
    if ne omega_matvec_benchmark k m n iters 0
      ret -1
    end
    put g_mv_sel_ns k get g_mv_bench_ns 0
  end
  best = ulong 0
  min_ns = get g_mv_sel_ns 0
  for k ulong MV_MAX_REALS
    v = get g_mv_sel_ns k
    if lt v min_ns
      min_ns = v
      best = k
    end
  end
  put g_mv_sel_kind 0 best
  put g_mv_sel_adapted 0 1
  ret 0
end

fn omega_matvec_dispatch m ulong n ulong to long
  if eq get g_mv_init 0 0
    ret -1
  end
  choice = MV_KIND_UNROLL4_DUAL
  if le n 8
    choice = MV_KIND_UNROLL2
  end
  ret omega_matvec_exec choice m n
end

fn omega_matvec_kernel_destroy to void
  put g_mv_real_cnt 0 0
  put g_mv_init 0 0
  put g_mv_profile 0 0
  for k ulong MV_MAX_REALS
    put g_mv_code_len k 0
    put g_mv_unroll k 0
    put g_mv_acc k 0
    put g_mv_verified k 0
  end
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_blackwell_encoder.c.
note Composes on om/gpu/bw_vecadd.om and seed/ng/sha256.om.
om2

const OMEGA_BW_VECADD_CODE_SIZE ulong 512

text bw_vecadd_expected_sha256 "39f3dfdfc529a75a8274a27900acf4e7382b7f280a211e0412c51609f44b62a1"

fn omega_blackwell_encode_vecadd dst edit uchar * to long
  if lt len dst OMEGA_BW_VECADD_CODE_SIZE
    ret -1
  end
  tmp = new uchar 512 0
  written = bw_encode_vecadd tmp
  if ne written OMEGA_BW_VECADD_CODE_SIZE
    ret -1
  end
  for i ulong 512
    put dst i get tmp i
  end
  ret 512
end

fn omega_blackwell_compute_code_digest code view uchar * n ulong digest edit uchar 32 to long
  if eq n 0
    ret -1
  end
  if gt n len code
    ret -1
  end
  if gt n 16777216
    ret -1
  end
  for i ulong n bound 16777216
    put sh_dat i get code i
  end
  sh_all n
  for i ulong 32
    put digest i get sh_dig i
  end
  ret 0
end

fn bw_enc_rd_le32 buf view uchar 512 off ulong to uint
  b0 = uint get buf off
  b1 = shl uint get buf add off 1 8
  b2 = shl uint get buf add off 2 16
  b3 = shl uint get buf add off 3 24
  ret or or b0 b1 or b2 b3
end

fn omega_blackwell_verify_encoder_fixtures to long
  code = new uchar 512 0
  written = bw_encode_vecadd code
  if ne written OMEGA_BW_VECADD_CODE_SIZE
    ret -1
  end
  dig = new uchar 32 0
  rc = omega_blackwell_compute_code_digest code 512 dig
  if ne rc 0
    ret -1
  end
  for i ulong 32
    b = uint get dig i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    if ne hi get bw_vecadd_expected_sha256 mul i 2
      ret -1
    end
    if ne lo get bw_vecadd_expected_sha256 add mul i 2 1
      ret -1
    end
  end
  if ne bw_enc_rd_le32 code 16 uint 0x00097919
    ret -1
  end
  if ne bw_enc_rd_le32 code 48 uint 0x00007919
    ret -1
  end
  if ne bw_enc_rd_le32 code 272 uint 0x02097210
    ret -1
  end
  if ne bw_enc_rd_le32 code 288 uint 0x06007986
    ret -1
  end
  ret 0
end

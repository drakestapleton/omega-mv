note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_gpu_hostmath.c.
note Libm-free double-precision log, exp, pow, sincos and exact f32 pow2f.
om2

const HM_LN2_HI_BITS ulong 0x3fe62e42fee00000
const HM_LN2_LO_BITS ulong 0x3dea39ef35793c76
const HM_INV_LN2_BITS ulong 0x3ff71547652b82fe
const HM_SQRT2_BITS ulong 0x3ff6a09e667f3bcd
const HM_DBL_MAX_BITS ulong 0x7fefffffffffffff
const HM_DBL_MIN_BITS ulong 0x0010000000000000
const HM_TWO54_BITS ulong 0x4350000000000000
const HM_EXP_HI_BITS ulong 0x40862e3d70a3d70a
const HM_EXP_LO_MAG_BITS ulong 0x408749999999999a
const HM_PIO2_1_BITS ulong 0x3ff921fb54400000
const HM_PIO2_2_BITS ulong 0x3dd0b4611a600000
const HM_PIO2_3_BITS ulong 0x3ba3198a2e000000
const HM_PIO2_3T_BITS ulong 0x397b839a252049c1
const HM_2_OVER_PI_BITS ulong 0x3fe45f306dc9c883
const HM_INF_BITS ulong 0x7ff0000000000000
const HM_QNAN_BITS ulong 0x7ff8000000000000
const HM_ONE_BITS ulong 0x3ff0000000000000
const HM_HALF_BITS ulong 0x3fe0000000000000
const HM_TWO_BITS ulong 0x4000000000000000

fn hm_pow2i k long to f64
  if gt k 1023
    ret bitcast f64 HM_INF_BITS
  end
  if lt k -1074
    ret bitcast f64 ulong 0
  end
  if ge k -1022
    exp = ulong add k 1023
    ret bitcast f64 shl exp 52
  end
  a = bitcast f64 shl ulong 1 52
  exp2 = ulong add add k 1022 1023
  b = bitcast f64 shl exp2 52
  ret mul a b
end

fn hm_log_poly t2 f64 to f64
  one = bitcast f64 HM_ONE_BITS
  s = bitcast f64 ulong 0
  k = long 25
  for step ulong 13
    s = add mul s t2 div one f64 k
    k = sub k 2
  end
  ret s
end

fn omega_hostmath_log x f64 to f64
  if not gt x bitcast f64 ulong 0
    ret bitcast f64 HM_QNAN_BITS
  end
  if gt x bitcast f64 HM_DBL_MAX_BITS
    ret bitcast f64 HM_QNAN_BITS
  end
  e = long 0
  xv = x
  if lt xv bitcast f64 HM_DBL_MIN_BITS
    xv = mul xv bitcast f64 HM_TWO54_BITS
    e = -54
  end
  u = bitcast ulong xv
  e = add e sub long and shr u 52 0x7ff 1023
  m = bitcast f64 or and u 0x000fffffffffffff HM_ONE_BITS
  if gt m bitcast f64 HM_SQRT2_BITS
    m = mul m bitcast f64 HM_HALF_BITS
    e = add e 1
  end
  one = bitcast f64 HM_ONE_BITS
  t = div sub m one add m one
  s = hm_log_poly mul t t
  ed = f64 e
  hi = mul ed bitcast f64 HM_LN2_HI_BITS
  lo = add mul mul bitcast f64 HM_TWO_BITS t s mul ed bitcast f64 HM_LN2_LO_BITS
  ret add hi lo
end

fn hm_exp_poly r f64 to f64
  one = bitcast f64 HM_ONE_BITS
  p = one
  n = long 17
  for step ulong 17
    p = add one div mul r p f64 n
    n = sub n 1
  end
  ret p
end

fn omega_hostmath_exp y f64 to f64
  if ne y y
    ret y
  end
  if gt y bitcast f64 HM_EXP_HI_BITS
    ret bitcast f64 HM_INF_BITS
  end
  if lt y neg bitcast f64 HM_EXP_LO_MAG_BITS
    ret bitcast f64 ulong 0
  end
  fk = mul y bitcast f64 HM_INV_LN2_BITS
  adj = bitcast f64 HM_HALF_BITS
  if lt fk bitcast f64 ulong 0
    adj = neg adj
  end
  k = long add fk adj
  kd = f64 k
  r = sub sub y mul kd bitcast f64 HM_LN2_HI_BITS mul kd bitcast f64 HM_LN2_LO_BITS
  p = hm_exp_poly r
  if lt k -1020
    ret mul mul p hm_pow2i -1020 hm_pow2i add k 1020
  end
  ret mul p hm_pow2i k
end

fn omega_hostmath_pow base f64 e f64 to f64
  one = bitcast f64 HM_ONE_BITS
  if eq base one
    ret one
  end
  if eq e bitcast f64 ulong 0
    ret one
  end
  ret omega_hostmath_exp mul e omega_hostmath_log base
end

fn hm_sin_poly w f64 to f64
  one = bitcast f64 HM_ONE_BITS
  ps = one
  ks = long 15
  for step ulong 7
    ps = sub one div mul w ps f64 mul ks sub ks 1
    ks = sub ks 2
  end
  ret ps
end

fn hm_cos_poly w f64 to f64
  one = bitcast f64 HM_ONE_BITS
  pc = one
  kc = long 16
  for step ulong 8
    pc = sub one div mul w pc f64 mul kc sub kc 1
    kc = sub kc 2
  end
  ret pc
end

fn omega_hostmath_sincos a f64 dst edit ulong 2 to void
  fnv = mul a bitcast f64 HM_2_OVER_PI_BITS
  adj = bitcast f64 HM_HALF_BITS
  if lt fnv bitcast f64 ulong 0
    adj = neg adj
  end
  n = long add fnv adj
  nd = f64 n
  r = sub a mul nd bitcast f64 HM_PIO2_1_BITS
  r = sub r mul nd bitcast f64 HM_PIO2_2_BITS
  r = sub r mul nd bitcast f64 HM_PIO2_3_BITS
  r = sub r mul nd bitcast f64 HM_PIO2_3T_BITS
  w = mul r r
  sr = mul r hm_sin_poly w
  cr = hm_cos_poly w
  q = and n 3
  if eq q 0
    put dst 0 bitcast ulong sr
    put dst 1 bitcast ulong cr
    ret
  end
  if eq q 1
    put dst 0 bitcast ulong cr
    put dst 1 bitcast ulong neg sr
    ret
  end
  if eq q 2
    put dst 0 bitcast ulong neg sr
    put dst 1 bitcast ulong neg cr
    ret
  end
  put dst 0 bitcast ulong neg cr
  put dst 1 bitcast ulong sr
end

fn omega_hostmath_pow2f e long to f32
  u = uint 0
  if gt e 127
    u = uint 0x7f800000
  else
    if ge e -126
      u = shl uint add e 127 23
    else
      if ge e -149
        sh = uint add e 149
        u = shl uint 1 sh
      end
    end
  end
  ret bitcast f32 u
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_numeric_lifecycle.h and src/omega_numeric_native.h
note (single-owner seat latch + fail-closed uncertain-completion poison latch).
om2

const OMEGA_NUMERIC_NATIVE_IDLE ulong 0
const OMEGA_NUMERIC_NATIVE_BUSY ulong 1
const OMEGA_NUMERIC_NATIVE_UNCERTAIN ulong 2

note One-line compile-time mutant knobs (set to 1 by mk/numeric-lifecycle.mk mutant checks).
const OMEGA_NL_MUTANT_POISON ulong 0
const OMEGA_NL_MUTANT_RETAIN ulong 0
const OMEGA_NL_MUTANT_EXACT ulong 0

global g_nl_state ulong 1
global g_nl_marker uint 1

fn omega_numeric_native_acquire to long
  if eq get g_nl_state 0 OMEGA_NUMERIC_NATIVE_IDLE
    put g_nl_state 0 OMEGA_NUMERIC_NATIVE_BUSY
    ret 0
  end
  ret -1
end

fn omega_numeric_native_uncertain to ulong
  if eq get g_nl_state 0 OMEGA_NUMERIC_NATIVE_UNCERTAIN
    ret 1
  end
  ret 0
end

fn omega_numeric_native_poison to void
  if eq OMEGA_NL_MUTANT_POISON 0
    put g_nl_state 0 OMEGA_NUMERIC_NATIVE_UNCERTAIN
  end
end

fn omega_numeric_native_release to void
  if eq get g_nl_state 0 OMEGA_NUMERIC_NATIVE_BUSY
    put g_nl_state 0 OMEGA_NUMERIC_NATIVE_IDLE
  end
end

fn omega_numeric_native_open to long
  if ne omega_numeric_native_acquire 0
    ret -1
  end
  rc = nl_driver_open
  if ne rc 0
    omega_numeric_native_release
  end
  ret rc
end

fn omega_numeric_native_close to long
  if eq OMEGA_NL_MUTANT_RETAIN 0
    if ne omega_numeric_native_uncertain 0
      ret -1
    end
  end
  rc = nl_driver_close
  if ne rc 0
    omega_numeric_native_poison
  else
    omega_numeric_native_release
  end
  ret rc
end

fn omega_numeric_native_wait want uint timeout_ms ulong to long
  rc = nl_driver_wait want timeout_ms
  if eq OMEGA_NL_MUTANT_EXACT 0
    if and eq rc 0 ne get g_nl_marker 0 want
      rc = -1
    end
  end
  if ne rc 0
    omega_numeric_native_poison
  end
  ret rc
end

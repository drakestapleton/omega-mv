fn sm121_copy_out dst edit uchar * tmp view uchar 256 n ulong to void
  for i ulong n bound 256
    put dst i get tmp i
  end
  put dst n 0
end

fn sm121_match_all lo ulong hi ulong pc ulong tmp edit uchar 256 st edit ulong 4 to long
  ins = new ulong 6 0
  put ins 0 lo
  put ins 1 hi
  put ins 2 pc
  m = sm121_match_grp1 ins tmp st
  if eq m 0
    m = sm121_match_grp2 ins tmp st
  end
  if eq m 0
    m = sm121_match_grp3 ins tmp st
  end
  ret m
end

fn sm121_disasm_core lo ulong hi ulong pc ulong tmp edit uchar 256 st edit ulong 4 to long
  g = sm121_bits lo 12 3
  gneg = sm121_bits lo 15 1
  if not and eq g 7 eq gneg 0
    sm121_putc tmp st 64
    sm121_put_pred tmp st g gneg
    sm121_putc tmp st 32
  end
  put st 3 get st 0
  im = sm121_imad_imm and lo not SM121_GUARD_MASK and hi SM121_HI_MASK tmp st
  if gt im 0
    if ne get st 2 0
      ret 0
    end
    ret -2
  end
  if eq im 0
    if ne sm121_match_all lo hi pc tmp st 0
      if ne get st 2 0
        ret 0
      end
      ret -2
    end
  end
  put st 0 0
  put st 2 1
  put tmp 0 0
  sm121_puts tmp st sm121_s_qq
  sm121_put_hex_pad tmp st hi 16
  sm121_put_hex_pad tmp st lo 16
  if ne get st 2 0
    ret -1
  end
  ret -2
end

fn omega_sm121_disasm lo ulong hi ulong pc ulong dst edit uchar * outn ulong to long
  if or lt outn 40 lt len dst outn
    ret -2
  end
  cap = outn
  if gt cap 256
    cap = 256
  end
  tmp = new uchar 256 0
  st = new ulong 4 0
  put st 0 0
  put st 1 cap
  put st 2 1
  put dst 0 0
  rc = sm121_disasm_core lo hi pc tmp st
  if ne rc -2
    sm121_copy_out dst tmp get st 0
  end
  ret rc
end

fn sm121_word_half code view uchar * off ulong to ulong
  v = ulong 0
  for i ulong 8
    idx = add off sub 7 i
    v = or shl v 8 ulong get code idx
  end
  ret v
end

fn omega_sm121_padding_start code view uchar * n ulong to ulong
  best = ulong 0
  pos = ulong 0
  while le add pos 16 n bound 65536
    lo = sm121_word_half code pos
    if eq and lo 0xfff 0x94d
      best = add pos 16
    end
    pos = add pos 16
  end
  ret best
end

fn sm121_put_cstr dst edit uchar * st edit ulong 4 line view uchar 256 to void
  k = ulong 0
  while lt k 256 bound 256
    ch = get line k
    if eq ch 0
      ret
    end
    sm121_putc dst st ch
    k = add k 1
  end
end

fn sm121_listing_line code view uchar * dst edit uchar * st edit ulong 4 pp view ulong 2 to long
  line = new uchar 256 0
  pos = get pp 0
  lo = sm121_word_half code pos
  hi = sm121_word_half code add pos 8
  rc = omega_sm121_disasm lo hi pos line 256
  if eq rc -2
    ret -1
  end
  sm121_puts dst st sm121_s_pad_pfx
  sm121_put_hex_pad dst st pos 4
  sm121_puts dst st sm121_s_pad_mid
  sm121_put_cstr dst st line
  pad = get pp 1
  if not and ne pad 0 ge pos pad
    sm121_putc dst st 32
  end
  sm121_putc dst st 59
  sm121_putc dst st 10
  if eq get st 2 0
    ret -1
  end
  if ne rc 0
    ret 1
  end
  ret 0
end

note args[0]=n (code bytes), args[1]=cap (dst capacity), args[2]=out_len written
fn omega_sm121_listing code view uchar * dst edit uchar * args edit ulong 3 to long
  n = get args 0
  cap = get args 1
  if or ne rem n 16 0 gt n len code
    ret -1
  end
  if or eq cap 0 gt cap len dst
    ret -1
  end
  pad = omega_sm121_padding_start code n
  unknown = long 0
  st = new ulong 4 0
  pp = new ulong 2 0
  put st 0 0
  put st 1 cap
  put st 2 1
  put dst 0 0
  put pp 1 pad
  pos = ulong 0
  while lt pos n bound 65536
    put pp 0 pos
    lrc = sm121_listing_line code dst st pp
    if lt lrc 0
      ret -1
    end
    unknown = add unknown lrc
    pos = add pos 16
  end
  put args 2 get st 0
  ret unknown
end

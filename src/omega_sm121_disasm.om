note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_sm121_disasm.c.
note SM121 (Blackwell GB10) 128-bit instruction disassembler, padding detector, and listing emitter.
om2

const SM121_HI_MASK ulong 0x000001ffffffffff
const SM121_GUARD_MASK ulong 0x000000000000f000
const SM121_BRA_LO_MASK ulong 0xfffffffc00ff0000
const SM121_BRA_HI_MASK ulong 0x000000000003ffff

text sm121_s_rz "RZ"
text sm121_s_urz "URZ"
text sm121_s_pt "PT"
text sm121_s_u32 ".U32"
text sm121_s_qq "?? 0x"
text sm121_s_imad "IMAD"
text sm121_s_imad_mov "IMAD.MOV"
text sm121_s_imad_iadd "IMAD.IADD"
text sm121_s_imad_shl "IMAD.SHL"
text sm121_s_sr_lane "SR_LANEID"
text sm121_s_sr_tidx "SR_TID.X"
text sm121_s_sr_tidy "SR_TID.Y"
text sm121_s_sr_tidz "SR_TID.Z"
text sm121_s_sr_ctax "SR_CTAID.X"
text sm121_s_sr_ctay "SR_CTAID.Y"
text sm121_s_sr_ctaz "SR_CTAID.Z"
text sm121_s_sr_clklo "SR_CLOCKLO"
text sm121_s_sr_clkhi "SR_CLOCKHI"
text sm121_s_ms0 ".U8"
text sm121_s_ms1 ".S8"
text sm121_s_ms2 ".U16"
text sm121_s_ms3 ".S16"
text sm121_s_ms5 ".64"
text sm121_s_ms6 ".128"
text sm121_s_ms7 ".U.128"
text sm121_s_pad_pfx "        /*"
text sm121_s_pad_mid "*/ "

text sm121_f_00 "MOV %d, %i"
text sm121_f_01 "MOV %d, %b"
text sm121_f_02 "S2R %d, %S"
text sm121_f_03 "LDC %d, %K"
text sm121_f_04 "LDC.64 %d, %K"
text sm121_f_05 "LDCU %D, %U"
text sm121_f_06 "LDCU.64 %D, %U"
text sm121_f_07 "IMAD %d, %a, %b, %c"
text sm121_f_08 "IMAD %d, %a, %B, %c"
text sm121_f_09 "IMAD.WIDE.U32 %d, %a, %i, %c"
text sm121_f_10 "IMAD.HI.U32 %d, %a, %b, %c"
text sm121_f_11 "IADD3 %d, PT, PT, %N%a, %M%b, %c"
text sm121_f_12 "IADD3 %d, PT, PT, %N%a, %s, %c"
text sm121_f_13 "LOP3.LUT %d, %a, %b, %c, %l, %R"
text sm121_f_14 "LOP3.LUT %d, %a, %i, %c, %l, %R"
text sm121_f_15 "SHF.R.U32.HI %d, %a, %i, %c"
text sm121_f_16 "SHF.R.U32.HI %d, %a, %b, %c"
text sm121_f_17 "SHF.L.U32 %d, %a, %b, %c"
text sm121_f_18 "SHF.L.U32 %d, %a, %i, %c"
text sm121_f_19 "ISETP.%G%Z.AND %P, %Q, %a, %b, %R"
text sm121_f_20 "ISETP.%G%Z.AND %P, %Q, %a, %j, %R"
text sm121_f_21 "ISETP.%G%Z.AND %P, %Q, %a, %B, %R"
text sm121_f_22 "SEL %d, %a, %b, %R"
text sm121_f_23 "SEL %d, %a, %i, %R"
text sm121_f_24 "FADD %d, %a, %b"
text sm121_f_25 "FADD %d, %a, -%b"
text sm121_f_26 "FMUL %d, %a, %b"
text sm121_f_27 "FFMA %d, %a, %b, %c"
text sm121_f_28 "FMNMX %d, %a, %b, %R"
text sm121_f_29 "FSETP.%g.AND %P, %Q, %a, %b, %R"
text sm121_f_30 "I2FP.F32.U32 %d, %b"
text sm121_f_31 "I2FP.F32.S32 %d, %b"
text sm121_f_32 "F2I.U32.TRUNC.NTZ %d, %b"
text sm121_f_33 "F2FP.SATFINITE.E4M3.F32.PACK_AB_MERGE_C %d, %a, %b, %c"
text sm121_f_34 "F2FP.BF16.F32.PACK_AB %d, %a, %b"
text sm121_f_35 "HMMA.16816.F32.BF16 %d, %a, %b, %c"
text sm121_f_36 "HMMA.16816.F32 %d, %a, %b, %c"
text sm121_f_37 "QMMA.16832.F32.E4M3.E4M3 %d, %a, %b, %c"
text sm121_f_38 "MUFU.EX2 %d, %b"
text sm121_f_39 "MUFU.RCP %d, %b"
text sm121_f_40 "MUFU.RSQ %d, %b"
text sm121_f_41 "LDG.E%z %d, desc[%B][%a.64%o]"
text sm121_f_42 "STG.E%z desc[%C][%a.64%o], %b"
text sm121_f_43 "LDG.E.STRONG.SYS %d, desc[%B][%a.64%o]"
text sm121_f_44 "STG.E.STRONG.SYS desc[%C][%a.64%o], %b"
text sm121_f_45 "ATOMG.E.ADD.STRONG.SYS PT, %d, desc[%C][%a.64], %b"
text sm121_f_46 "LDS %d, [%a+%B]"
text sm121_f_47 "STS [%a+%C], %b"
text sm121_f_48 "LDS%z %d, [%a%o]"
text sm121_f_49 "MEMBAR.ALL.SYS"
text sm121_f_50 "SHFL.DOWN PT, %d, %a, %h, %m"
text sm121_f_51 "SHFL.BFLY PT, %d, %a, %h, %m"
text sm121_f_52 "NOP"
text sm121_f_53 "EXIT"
text sm121_f_54 "BRA %T"
text sm121_f_55 "BSSY.RECONVERGENT %y, %Y"
text sm121_f_56 "BSYNC.RECONVERGENT %y"
text sm121_f_57 "BAR.SYNC.DEFER_BLOCKING 0x0"

fn sm121_bits v ulong sh ulong wid ulong to ulong
  if ge wid 64
    ret shr v sh
  end
  m = sub shl ulong 1 wid 1
  ret and shr v sh m
end

fn sm121_mask sh ulong wid ulong to ulong
  if ge wid 64
    ret shl ulong 0xffffffffffffffff sh
  end
  m = sub shl ulong 1 wid 1
  ret shl m sh
end

fn sm121_putc dst edit uchar * st edit ulong 4 ch uchar to void
  if eq get st 2 0
    ret
  end
  pos = get st 0
  cap = get st 1
  if ge add pos 1 cap
    put st 2 0
    put st 0 cap
    ret
  end
  put dst pos ch
  put dst add pos 1 0
  put st 0 add pos 1
end

fn sm121_puts dst edit uchar * st edit ulong 4 s view uchar * to void
  n = len s
  for i ulong n bound 128
    sm121_putc dst st get s i
  end
end

fn sm121_hex_nib nib ulong to uchar
  if lt nib 10
    ret uchar add 48 nib
  end
  ret uchar add 87 nib
end

fn sm121_put_dec dst edit uchar * st edit ulong 4 v ulong to void
  buf = new uchar 24 0
  k = ulong 0
  cur = v
  if eq cur 0
    sm121_putc dst st 48
    ret
  end
  while gt cur 0 bound 24
    d = rem cur 10
    put buf k uchar add 48 d
    k = add k 1
    cur = div cur 10
  end
  for i ulong k bound 24
    sm121_putc dst st get buf sub sub k 1 i
  end
end

fn sm121_put_hex dst edit uchar * st edit ulong 4 v ulong to void
  buf = new uchar 20 0
  k = ulong 0
  cur = v
  if eq cur 0
    sm121_putc dst st 48
    ret
  end
  while gt cur 0 bound 20
    d = and cur 15
    put buf k sm121_hex_nib d
    k = add k 1
    cur = shr cur 4
  end
  for i ulong k bound 20
    sm121_putc dst st get buf sub sub k 1 i
  end
end

fn sm121_put_hex_pad dst edit uchar * st edit ulong 4 v ulong digits ulong to void
  for i ulong digits bound 16
    sh = mul sub sub digits 1 i 4
    nib = and shr v sh 15
    sm121_putc dst st sm121_hex_nib nib
  end
end

fn sm121_put_hex_s dst edit uchar * st edit ulong 4 v long to void
  if lt v 0
    sm121_putc dst st 45
    sm121_putc dst st 48
    sm121_putc dst st 120
    mag = add ulong sub 0 add v 1 1
    sm121_put_hex dst st mag
    ret
  end
  sm121_putc dst st 48
  sm121_putc dst st 120
  sm121_put_hex dst st ulong v
end

fn sm121_put_reg dst edit uchar * st edit ulong 4 is_u ulong r ulong to void
  if eq r 255
    if ne is_u 0
      sm121_puts dst st sm121_s_urz
    else
      sm121_puts dst st sm121_s_rz
    end
    ret
  end
  if ne is_u 0
    sm121_putc dst st 85
  end
  sm121_putc dst st 82
  sm121_put_dec dst st r
end

fn sm121_put_pred dst edit uchar * st edit ulong 4 p ulong is_neg ulong to void
  if ne is_neg 0
    sm121_putc dst st 33
  end
  if eq p 7
    sm121_puts dst st sm121_s_pt
    ret
  end
  sm121_putc dst st 80
  sm121_put_dec dst st p
end

fn sm121_put_sr dst edit uchar * st edit ulong 4 v ulong to void
  if eq v 0
    sm121_puts dst st sm121_s_sr_lane
    ret
  end
  if eq v 0x21
    sm121_puts dst st sm121_s_sr_tidx
    ret
  end
  if eq v 0x22
    sm121_puts dst st sm121_s_sr_tidy
    ret
  end
  if eq v 0x23
    sm121_puts dst st sm121_s_sr_tidz
    ret
  end
  if eq v 0x25
    sm121_puts dst st sm121_s_sr_ctax
    ret
  end
  if eq v 0x26
    sm121_puts dst st sm121_s_sr_ctay
    ret
  end
  if eq v 0x27
    sm121_puts dst st sm121_s_sr_ctaz
    ret
  end
  if eq v 0x50
    sm121_puts dst st sm121_s_sr_clklo
    ret
  end
  if eq v 0x51
    sm121_puts dst st sm121_s_sr_clkhi
    ret
  end
  sm121_putc dst st 83
  sm121_putc dst st 82
  sm121_put_dec dst st v
end

fn sm121_put_cmp dst edit uchar * st edit ulong 4 v ulong is_f ulong to void
  if eq v 0
    sm121_putc dst st 70
    ret
  end
  if eq v 1
    sm121_putc dst st 76
    sm121_putc dst st 84
    ret
  end
  if eq v 2
    sm121_putc dst st 69
    sm121_putc dst st 81
    ret
  end
  if eq v 3
    sm121_putc dst st 76
    sm121_putc dst st 69
    ret
  end
  if eq v 4
    sm121_putc dst st 71
    sm121_putc dst st 84
    ret
  end
  if eq v 5
    sm121_putc dst st 78
    sm121_putc dst st 69
    ret
  end
  if eq v 6
    sm121_putc dst st 71
    sm121_putc dst st 69
    ret
  end
  if eq is_f 0
    sm121_putc dst st 84
    ret
  end
  if eq v 7
    sm121_putc dst st 78
    sm121_putc dst st 85
    sm121_putc dst st 77
    ret
  end
  if eq v 8
    sm121_putc dst st 78
    sm121_putc dst st 65
    sm121_putc dst st 78
    ret
  end
  if eq v 15
    sm121_putc dst st 84
    ret
  end
  sm121_put_cmp dst st sub v 8 0
  sm121_putc dst st 85
end

fn sm121_put_msize dst edit uchar * st edit ulong 4 v ulong to void
  if eq v 0
    sm121_puts dst st sm121_s_ms0
    ret
  end
  if eq v 1
    sm121_puts dst st sm121_s_ms1
    ret
  end
  if eq v 2
    sm121_puts dst st sm121_s_ms2
    ret
  end
  if eq v 3
    sm121_puts dst st sm121_s_ms3
    ret
  end
  if eq v 5
    sm121_puts dst st sm121_s_ms5
    ret
  end
  if eq v 6
    sm121_puts dst st sm121_s_ms6
    ret
  end
  if eq v 7
    sm121_puts dst st sm121_s_ms7
    ret
  end
end

fn sm121_field_info ch uchar info edit ulong 4 to void
  put info 0 0
  put info 1 0
  put info 2 0
  put info 3 0
  c = ulong ch
  if or eq c 100 eq c 68
    put info 0 1
    put info 2 16
    put info 3 8
    ret
  end
  if or eq c 97 eq c 65
    put info 0 1
    put info 2 24
    put info 3 8
    ret
  end
  if or eq c 98 eq c 66
    put info 0 1
    put info 2 32
    put info 3 8
    ret
  end
  if or eq c 99 eq c 67
    put info 0 1
    put info 1 1
    put info 2 0
    put info 3 8
    ret
  end
  if or eq c 105 or eq c 115 or eq c 89 eq c 106
    put info 0 1
    put info 2 32
    put info 3 32
    ret
  end
  if eq c 75
    put info 0 1
    put info 2 38
    put info 3 21
    ret
  end
  if eq c 85
    put info 0 1
    put info 2 37
    put info 3 22
    ret
  end
  if eq c 111
    put info 0 1
    put info 2 40
    put info 3 24
    ret
  end
  if eq c 121
    put info 0 1
    put info 2 16
    put info 3 4
    ret
  end
  if eq c 80
    put info 0 1
    put info 1 1
    put info 2 17
    put info 3 3
    ret
  end
  if eq c 81
    put info 0 1
    put info 1 1
    put info 2 20
    put info 3 3
    ret
  end
  if eq c 82
    put info 0 1
    put info 1 1
    put info 2 23
    put info 3 4
    ret
  end
  if or eq c 108 eq c 83
    put info 0 1
    put info 1 1
    put info 2 8
    put info 3 8
    ret
  end
  if eq c 104
    put info 0 1
    put info 2 53
    put info 3 5
    ret
  end
  if eq c 109
    put info 0 1
    put info 2 40
    put info 3 13
    ret
  end
  if eq c 71
    put info 0 1
    put info 1 1
    put info 2 12
    put info 3 3
    ret
  end
  if eq c 103
    put info 0 1
    put info 1 1
    put info 2 12
    put info 3 4
    ret
  end
  if eq c 90
    put info 0 1
    put info 1 1
    put info 2 9
    put info 3 1
    ret
  end
  if eq c 122
    put info 0 1
    put info 1 1
    put info 2 9
    put info 3 3
    ret
  end
  if eq c 78
    put info 0 1
    put info 1 1
    put info 2 8
    put info 3 1
    ret
  end
  if eq c 77
    put info 0 1
    put info 2 63
    put info 3 1
    ret
  end
end

fn sm121_fields_mask fmt view uchar * masks edit ulong 2 to void
  lom = ulong 0
  him = ulong 0
  info = new ulong 4 0
  n = len fmt
  i = ulong 0
  while lt i n bound 128
    ch = get fmt i
    if eq ch 37
      i = add i 1
      if lt i n
        c = get fmt i
        if eq c 84
          lom = or lom SM121_BRA_LO_MASK
          him = or him SM121_BRA_HI_MASK
        else
          sm121_field_info c info
          if ne get info 0 0
            m = sm121_mask get info 2 get info 3
            if ne get info 1 0
              him = or him m
            else
              lom = or lom m
            end
          end
        end
      end
    end
    i = add i 1
  end
  put masks 0 lom
  put masks 1 him
end

fn sm121_sext32 v ulong to long
  u = and v 0xffffffff
  if ne and u 0x80000000 0
    ret sub long u 0x100000000
  end
  ret long u
end

fn sm121_sext24 v ulong to long
  u = and v 0xffffff
  if ne and u 0x800000 0
    ret sub long u 0x1000000
  end
  ret long u
end

fn sm121_render_bra ins view ulong 6 dst edit uchar 256 st edit ulong 4 to void
  lo = get ins 0
  hi = get ins 1
  pc = get ins 2
  u0 = sm121_bits lo 16 8
  u1 = shl sm121_bits lo 34 30 8
  u2 = shl sm121_bits hi 0 18 38
  units = or or u0 u1 u2
  if ne and units shl ulong 1 55 0
    units = or units ulong 0xff00000000000000
  end
  tgt = add add pc 16 mul units 4
  sm121_putc dst st 48
  sm121_putc dst st 120
  sm121_put_hex dst st tgt
end

fn sm121_render_op ch uchar v ulong ins view ulong 6 dst edit uchar 256 st edit ulong 4 to void
  c = ulong ch
  if or eq c 100 or eq c 97 or eq c 98 eq c 99
    sm121_put_reg dst st 0 v
    ret
  end
  if or eq c 68 or eq c 65 or eq c 66 eq c 67
    sm121_put_reg dst st 1 v
    ret
  end
  if or eq c 105 or eq c 108 or eq c 104 eq c 109
    sm121_putc dst st 48
    sm121_putc dst st 120
    sm121_put_hex dst st v
    ret
  end
  if or eq c 115 eq c 106
    sm121_put_hex_s dst st sm121_sext32 v
    ret
  end
  if eq c 75
    lo = get ins 0
    sm121_putc dst st 99
    sm121_putc dst st 91
    sm121_putc dst st 48
    sm121_putc dst st 120
    sm121_put_hex dst st sm121_bits lo 54 5
    sm121_putc dst st 93
    sm121_putc dst st 91
    sm121_putc dst st 48
    sm121_putc dst st 120
    sm121_put_hex dst st sm121_bits lo 38 16
    sm121_putc dst st 93
    ret
  end
  if eq c 85
    lo = get ins 0
    sm121_putc dst st 99
    sm121_putc dst st 91
    sm121_putc dst st 48
    sm121_putc dst st 120
    sm121_put_hex dst st sm121_bits lo 54 5
    sm121_putc dst st 93
    sm121_putc dst st 91
    sm121_putc dst st 48
    sm121_putc dst st 120
    sm121_put_hex dst st sm121_bits lo 37 17
    sm121_putc dst st 93
    ret
  end
  if eq c 111
    off = sm121_sext24 v
    if ne off 0
      sm121_putc dst st 43
      sm121_put_hex_s dst st off
    end
    ret
  end
  if eq c 89
    pc = get ins 2
    sv = sm121_sext32 v
    tgt = ulong add long add pc 16 sv
    sm121_putc dst st 48
    sm121_putc dst st 120
    sm121_put_hex dst st tgt
    ret
  end
  if eq c 121
    sm121_putc dst st 66
    sm121_put_dec dst st v
    ret
  end
  if or eq c 80 eq c 81
    sm121_put_pred dst st v 0
    ret
  end
  if eq c 82
    sm121_put_pred dst st and v 7 and shr v 3 1
    ret
  end
  if eq c 83
    sm121_put_sr dst st v
    ret
  end
  if eq c 71
    sm121_put_cmp dst st v 0
    ret
  end
  if eq c 103
    sm121_put_cmp dst st v 1
    ret
  end
  if eq c 90
    if eq v 0
      sm121_puts dst st sm121_s_u32
    end
    ret
  end
  if eq c 122
    sm121_put_msize dst st v
    ret
  end
  if or eq c 78 eq c 77
    if ne v 0
      sm121_putc dst st 45
    end
    ret
  end
  if eq c 84
    sm121_render_bra ins dst st
    ret
  end
  put st 2 0
end

fn sm121_render ins view ulong 6 fmt view uchar * dst edit uchar 256 st edit ulong 4 to void
  info = new ulong 4 0
  n = len fmt
  i = ulong 0
  while lt i n bound 128
    ch = get fmt i
    if ne ch 37
      sm121_putc dst st ch
    else
      i = add i 1
      if lt i n
        c = get fmt i
        v = ulong 0
        sm121_field_info c info
        if ne get info 0 0
          src = get ins 0
          if ne get info 1 0
            src = get ins 1
          end
          v = sm121_bits src get info 2 get info 3
        end
        sm121_render_op c v ins dst st
      end
    end
    i = add i 1
  end
end

fn sm121_try_row ins view ulong 6 fmt view uchar * dst edit uchar 256 st edit ulong 4 to long
  lov = get ins 3
  hiv = get ins 4
  lo_body = and get ins 0 not SM121_GUARD_MASK
  if ne and lo_body 0xfff and lov 0xfff
    ret 0
  end
  hi_body = and get ins 1 SM121_HI_MASK
  masks = new ulong 2 0
  sm121_fields_mask fmt masks
  lom = not or get masks 0 SM121_GUARD_MASK
  him = and SM121_HI_MASK not get masks 1
  if ne and lo_body lom and lov lom
    ret 0
  end
  if ne and hi_body him and hiv him
    ret 0
  end
  put st 0 get st 3
  sm121_render ins fmt dst st
  ret 1
end

fn sm121_imad_imm lo_body ulong hi_body ulong dst edit uchar * st edit ulong 4 to long
  if ne sm121_bits lo_body 0 12 0x824
    ret 0
  end
  if ne and and hi_body SM121_HI_MASK not ulong 0xff 0x078e0200
    ret 0
  end
  imm = sm121_bits lo_body 32 32
  c = sm121_bits hi_body 0 8
  kind = ulong 0
  if eq imm 0
    kind = 1
  else
    if eq imm 1
      if eq c 255
        kind = 1
      else
        kind = 2
      end
    else
      if and eq c 255 eq and imm sub imm 1 0
        tz = ulong 0
        tmp = imm
        while eq and tmp 1 0 bound 32
          tmp = shr tmp 1
          tz = add tz 1
        end
        if or eq tz 16 eq tz 31
          kind = 0
        else
          if or le tz 10 or eq tz 12 eq tz 20
            kind = 3
          else
            ret -1
          end
        end
      end
    end
  end
  if eq kind 0
    sm121_puts dst st sm121_s_imad
  else
    if eq kind 1
      sm121_puts dst st sm121_s_imad_mov
    else
      if eq kind 2
        sm121_puts dst st sm121_s_imad_iadd
      else
        sm121_puts dst st sm121_s_imad_shl
      end
    end
  end
  sm121_putc dst st 32
  sm121_put_reg dst st 0 sm121_bits lo_body 16 8
  sm121_putc dst st 44
  sm121_putc dst st 32
  sm121_put_reg dst st 0 sm121_bits lo_body 24 8
  sm121_putc dst st 44
  sm121_putc dst st 32
  sm121_put_hex_s dst st sm121_sext32 imm
  sm121_putc dst st 44
  sm121_putc dst st 32
  sm121_put_reg dst st 0 c
  ret 1
end

fn sm121_match_grp1 ins edit ulong 6 dst edit uchar 256 st edit ulong 4 to long
  put ins 3 0x0000000000007802
  put ins 4 0x00000f00
  if ne sm121_try_row ins sm121_f_00 dst st 0
    ret 1
  end
  put ins 3 0x00000000ff007202
  put ins 4 0x00000f00
  if ne sm121_try_row ins sm121_f_01 dst st 0
    ret 1
  end
  put ins 3 0x0000000000007202
  put ins 4 0x00000f00
  if ne sm121_try_row ins sm121_f_01 dst st 0
    ret 1
  end
  put ins 3 0x0000000000007919
  put ins 4 0x00000000
  if ne sm121_try_row ins sm121_f_02 dst st 0
    ret 1
  end
  put ins 3 0x00000000ff007b82

note SPDX-License-Identifier: Apache-2.0
note src/physics0/pd0_relation.om: PD-0 relations in PDLAW1 delta form, rollout, NRMSE, support/coef-err, PDLAW1 codec, claim_text, JSON.
note Learner-side safe: no generator, no world, no file I/O.

const P0R_SLOTS ulong 16
const P0R_EQ_STRIDE ulong 6
const P0R_TERM_STRIDE ulong 72
const P0R_EX_STRIDE ulong 576

global p0r_nvars uchar 16
global p0r_nlat uchar 16
global p0r_nch uchar 16
global p0r_neq uchar 16
global p0r_eq_tgt uchar 96
global p0r_eq_nt uchar 96
global p0r_coef long 1152
global p0r_ex uchar 9216

text PD0_MAGIC_LAW1 "PDLAW1"
text PD0_HEX_DIGITS "0123456789abcdef"

fn p0r_clear slot ulong to void
put p0r_nvars slot uchar 0
put p0r_nlat slot uchar 0
put p0r_nch slot uchar 0
put p0r_neq slot uchar 0
ebase = mul slot P0R_EQ_STRIDE
for e ulong 6
put p0r_eq_tgt add ebase e uchar 0
put p0r_eq_nt add ebase e uchar 0
end
tbase = mul slot P0R_TERM_STRIDE
for t ulong 72
put p0r_coef add tbase t long 0
end
xbase = mul slot P0R_EX_STRIDE
for x ulong 576
put p0r_ex add xbase x uchar 0
end
ret
end

fn p0r_copy dst ulong src ulong to void
put p0r_nvars dst get p0r_nvars src
put p0r_nlat dst get p0r_nlat src
put p0r_nch dst get p0r_nch src
put p0r_neq dst get p0r_neq src
de = mul dst P0R_EQ_STRIDE
se = mul src P0R_EQ_STRIDE
for e ulong 6
put p0r_eq_tgt add de e get p0r_eq_tgt add se e
put p0r_eq_nt add de e get p0r_eq_nt add se e
end
dt = mul dst P0R_TERM_STRIDE
st = mul src P0R_TERM_STRIDE
for t ulong 72
put p0r_coef add dt t get p0r_coef add st t
end
dx = mul dst P0R_EX_STRIDE
sx = mul src P0R_EX_STRIDE
for x ulong 576
put p0r_ex add dx x get p0r_ex add sx x
end
ret
end

fn p0r_eq_idx slot ulong eqi ulong to ulong
ret add mul slot P0R_EQ_STRIDE eqi
end

fn p0r_term_idx slot ulong eqi ulong t ulong to ulong
ret add add mul slot P0R_TERM_STRIDE mul eqi PD0_MAX_TERMS t
end

fn p0r_ex_idx slot ulong eqi ulong t ulong k ulong to ulong
ti = p0r_term_idx slot eqi t
ret add mul ti PD0_MAX_EX k
end

fn p0r_valid_term ti ulong nv ulong nc ulong to int
if eq get p0r_coef ti long 0
ret -1
end
xb = mul ti PD0_MAX_EX
for x ulong PD0_MAX_VARS
if ge x nv
if ne get p0r_ex add xb x uchar 0
ret -1
end
end
end
for c ulong PD0_MAX_CH
if ge c nc
if ne get p0r_ex add xb add PD0_MAX_VARS c uchar 0
ret -1
end
end
end
ret 0
end

fn pd0_relation_valid slot ulong to int
nv = ulong get p0r_nvars slot
nl = ulong get p0r_nlat slot
nc = ulong get p0r_nch slot
ne_cnt = ulong get p0r_neq slot
if or lt nv ulong 1 gt nv PD0_MAX_VARS
ret -1
end
if or gt nl PD0_MAX_LATENT ge nl nv
ret -1
end
if or lt nc ulong 1 gt nc PD0_MAX_CH
ret -1
end
if gt ne_cnt nv
ret -1
end
for i ulong ne_cnt bound 6
ei = p0r_eq_idx slot i
tgt = ulong get p0r_eq_tgt ei
nt = ulong get p0r_eq_nt ei
if or ge tgt nv gt nt PD0_MAX_TERMS
ret -1
end
for j ulong ne_cnt bound 6
if gt j i
ej = p0r_eq_idx slot j
if eq ulong get p0r_eq_tgt ej tgt
ret -1
end
end
end
for t ulong nt bound 12
ti = p0r_term_idx slot i t
if ne p0r_valid_term ti nv nc 0
ret -1
end
end
end
ret 0
end

fn pd0_relation_size slot ulong to int
n = int get p0r_nlat slot
ne_cnt = ulong get p0r_neq slot
for i ulong ne_cnt bound 6
n = add n int get p0r_eq_nt p0r_eq_idx slot i
end
ret n
end

fn pd0_relation_degree_ok slot ulong to int
ne_cnt = ulong get p0r_neq slot
for i ulong ne_cnt bound 6
nt = ulong get p0r_eq_nt p0r_eq_idx slot i
for t ulong nt bound 12
ti = p0r_term_idx slot i t
d = ulong 0
for x ulong PD0_MAX_EX
d = add d ulong get p0r_ex add mul ti PD0_MAX_EX x
end
if gt d PD0_MAX_DEG
ret 0
end
end
end
ret 1
end

fn pd0_relation_description_bits slot ulong to uint
nv = uint get p0r_nvars slot
nl = uint get p0r_nlat slot
nc = uint get p0r_nch slot
bits = mul uint 8 nl
per = add mul uint 8 add nv nc uint 24
ne_cnt = ulong get p0r_neq slot
for i ulong ne_cnt bound 6
nt = uint get p0r_eq_nt p0r_eq_idx slot i
bits = add bits mul per nt
end
ret bits
end

fn pd0_monomial_ti ti ulong vars view long 6 u view long 2 to long
xb = mul ti PD0_MAX_EX
m = PD0_MICRO
for v ulong 6
ex = ulong get p0r_ex add xb v
for p ulong ex bound 8
m = pd0_mul m get vars v
end
end
for c ulong 2
ex = ulong get p0r_ex add xb add PD0_MAX_VARS c
for p ulong ex bound 8
m = pd0_mul m get u c
end
end
ret m
end

fn p0r_eval_eq slot ulong eqi ulong inv view long 6 u view long 2 to long
nt = ulong get p0r_eq_nt p0r_eq_idx slot eqi
d = long 0
for t ulong nt bound 12
ti = p0r_term_idx slot eqi t
m = pd0_monomial_ti ti inv u
d = add d pd0_mul get p0r_coef ti m
end
ret d
end

fn pd0_relation_step slot ulong inv view long 6 u view long 2 outv edit long 6 to void
nv = ulong get p0r_nvars slot
for v ulong nv bound 6
put outv v get inv v
end
ne_cnt = ulong get p0r_neq slot
for i ulong ne_cnt bound 6
tgt = ulong get p0r_eq_tgt p0r_eq_idx slot i
d = p0r_eval_eq slot i inv u
put outv tgt add get inv tgt d
end
ret
end

fn p0r_find_eq slot ulong tgt uchar to int
ne_cnt = ulong get p0r_neq slot
for i ulong ne_cnt bound 6
if eq get p0r_eq_tgt p0r_eq_idx slot i tgt
ret int i
end
end
ret -1
end

fn p0r_ex_match xb ulong txb ulong to int
for k ulong PD0_MAX_EX
if ne get p0r_ex add xb k get p0r_ex add txb k
ret 0
end
end
ret 1
end

fn p0r_find_term slot ulong eqi ulong tslot ulong teq ulong tt ulong to int
nt = ulong get p0r_eq_nt p0r_eq_idx slot eqi
txb = mul p0r_term_idx tslot teq tt PD0_MAX_EX
for i ulong nt bound 12
xb = mul p0r_term_idx slot eqi i PD0_MAX_EX
if eq p0r_ex_match xb txb 1
ret int i
end
end
ret -1
end

fn pd0_relation_supports slot ulong tslot ulong to int
tne = ulong get p0r_neq tslot
for i ulong tne bound 6
tgt = get p0r_eq_tgt p0r_eq_idx tslot i
ei = p0r_find_eq slot tgt
if lt ei 0
ret 0
end
tnt = ulong get p0r_eq_nt p0r_eq_idx tslot i
for t ulong tnt bound 12
if lt p0r_find_term slot ulong ei tslot i t 0
ret 0
end
end
end
ret 1
end

fn p0r_coef_ppm mc long tc long to long
d = sub mc tc
if lt d long 0
d = neg d
end
tv = tc
if lt tv long 0
tv = neg tv
end
if ne tv long 0
ret long div mul f64 d 1000000.0f64 f64 tv
end
if ne d long 0
ret long 9223372036854775807
end
ret long 0
end

fn pd0_relation_coef_err_ppm slot ulong tslot ulong to long
if eq pd0_relation_supports slot tslot 0
ret long -1
end
worst = long 0
tne = ulong get p0r_neq tslot
for i ulong tne bound 6
tgt = get p0r_eq_tgt p0r_eq_idx tslot i
ei = ulong p0r_find_eq slot tgt
tnt = ulong get p0r_eq_nt p0r_eq_idx tslot i
for t ulong tnt bound 12
mi = ulong p0r_find_term slot ei tslot i t
mc = get p0r_coef p0r_term_idx slot ei mi
tc = get p0r_coef p0r_term_idx tslot i t
ppm = p0r_coef_ppm mc tc
if gt ppm worst
worst = ppm
end
end
end
ret worst
end

fn pd0_confidence_ppm p uint f uint to uint
num = mul ulong 1000000 add ulong p ulong 1
den = add add ulong p ulong f ulong 2
ret uint div num den
end

fn pd0_hex h view uchar * n ulong dst edit uchar * to void
for i ulong n bound 64
b = ulong get h i
put dst mul i 2 get PD0_HEX_DIGITS shr b 4
put dst add mul i 2 1 get PD0_HEX_DIGITS and b 15
end
ret
end

note ---- PDLAW1 minimal globals + codec (substrate lane; Pd0LawMeta in pd0_types.om) ----

global p0l_law_id uchar 32
global p0l_chain_root uchar 32
global p0l_var_min long 4
global p0l_var_max long 4
global p0l_ch_min long 2
global p0l_ch_max long 2
global p0l_exc_seq ulong 16
global p0l_exc_hash uchar 512
global p0l_exc_pred long 16
global p0l_exc_obs long 16
global p0l_exc_err long 16
global p0l_exp_id uchar 512
global p0l_exp_kind uchar 16
global p0l_exp_prereg uchar 512
global p0l_exp_outcome uchar 512
global p0l_exp_res uchar 16
global p0l_exp_fseq ulong 16
global p0l_exp_lseq ulong 16

text P0L_C1 "Across "
text P0L_C2 " observations under "
text P0L_C3 " episodes, "
text P0L_C4 " variables in the reset box ["
text P0L_C5 ", "
text P0L_C6 "] micro, episode length "
text P0L_C7 ", this relation predicts within "
text P0L_C8 " (rollout NRMSE, 20 steps). Confidence "
text P0L_C9 " ppm. "
text P0L_C10 " exceptions recorded."

fn pd0_claim_text slot ulong m view Pd0LawMeta dst edit uchar * to ulong
cap = len dst
pos = ulong 0
pos = pd0_buf_str dst pos cap P0L_C1
pos = pd0_buf_u64 dst pos cap get m n_obs_dom
pos = pd0_buf_str dst pos cap P0L_C2
pos = pd0_buf_u64 dst pos cap ulong get m n_ep_dom
pos = pd0_buf_str dst pos cap P0L_C3
nobs = sub ulong get p0r_nvars slot ulong get p0r_nlat slot
pos = pd0_buf_u64 dst pos cap nobs
pos = pd0_buf_str dst pos cap P0L_C4
pos = pd0_buf_i64 dst pos cap get m reset_min
pos = pd0_buf_str dst pos cap P0L_C5
pos = pd0_buf_i64 dst pos cap get m reset_max
pos = pd0_buf_str dst pos cap P0L_C6
pos = pd0_buf_u64 dst pos cap ulong get m ep_len
pos = pd0_buf_str dst pos cap P0L_C7
eps = ulong get m eps_micro
pos = pd0_buf_u64 dst pos cap div eps ulong 1000000
pos = pd0_buf_ch dst pos cap uchar 46
pos = pd0_buf_u64_pad6 dst pos cap rem eps ulong 1000000
pos = pd0_buf_str dst pos cap P0L_C8
pos = pd0_buf_u64 dst pos cap ulong get m confidence_ppm
pos = pd0_buf_str dst pos cap P0L_C9
pos = pd0_buf_u64 dst pos cap ulong get m n_exc
pos = pd0_buf_str dst pos cap P0L_C10
ret pos
end

fn pd0_law_encode_rel slot ulong dst edit uchar * pos ulong to ulong
nv = get p0r_nvars slot
nl = get p0r_nlat slot
nc = get p0r_nch slot
ne_cnt = get p0r_neq slot
put dst pos nv
put dst add pos 1 nl
put dst add pos 2 nc
pos = add pos 3
pd0_put_u32 dst pos pd0_relation_description_bits slot
pos = add pos 4
ret pos
end

fn pd0_law_encode_term ti ulong nv ulong nc ulong dst edit uchar * pos ulong to ulong
xb = mul ti PD0_MAX_EX
pd0_put_u64 dst pos bitcast ulong get p0r_coef ti
pos = add pos 8
for v ulong nv bound 6
put dst pos get p0r_ex add xb v
pos = add pos 1
end
for c ulong nc bound 2
put dst pos get p0r_ex add xb add PD0_MAX_VARS c
pos = add pos 1
end
ret pos
end

fn pd0_law_encode_eqs slot ulong dst edit uchar * pos ulong to ulong
nv = ulong get p0r_nvars slot
nc = ulong get p0r_nch slot
ne_cnt = ulong get p0r_neq slot
for i ulong ne_cnt bound 6
ei = p0r_eq_idx slot i
nt = ulong get p0r_eq_nt ei
put dst pos get p0r_eq_tgt ei
pd0_put_u16 dst add pos 1 ushort nt
pos = add pos 3
for t ulong nt bound 12
ti = p0r_term_idx slot i t
pos = pd0_law_encode_term ti nv nc dst pos
end
end
ret pos
end

fn pd0_law_encode_exc nexc ulong dst edit uchar * pos ulong to ulong
pd0_put_u16 dst pos ushort nexc
pos = add pos 2
for i ulong nexc bound 16
pd0_put_u64 dst pos get p0l_exc_seq i
pos = add pos 8
for k ulong 32
put dst pos get p0l_exc_hash add mul i 32 k
pos = add pos 1
end
pd0_put_u64 dst pos bitcast ulong get p0l_exc_pred i
pos = add pos 8
pd0_put_u64 dst pos bitcast ulong get p0l_exc_obs i
pos = add pos 8
pd0_put_u64 dst pos bitcast ulong get p0l_exc_err i
pos = add pos 8
end
ret pos
end

fn pd0_law_encode_exp nexp ulong dst edit uchar * pos ulong to ulong
pd0_put_u16 dst pos ushort nexp
pos = add pos 2
for i ulong nexp bound 16
for k ulong 32
put dst pos get p0l_exp_id add mul i 32 k
pos = add pos 1
end
put dst pos get p0l_exp_kind i
pos = add pos 1
for k ulong 32
put dst pos get p0l_exp_prereg add mul i 32 k
pos = add pos 1
end
for k ulong 32
put dst pos get p0l_exp_outcome add mul i 32 k
pos = add pos 1
end
put dst pos get p0l_exp_res i
pos = add pos 1
pd0_put_u64 dst pos get p0l_exp_fseq i
pos = add pos 8
pd0_put_u64 dst pos get p0l_exp_lseq i
pos = add pos 8
end
ret pos
end

fn pd0_law_encode slot ulong m view Pd0LawMeta dst edit uchar * to ulong
if or ne pd0_relation_valid slot 0 gt get m state PD0_LAW_PROVISIONAL
ret ulong 0
end
if or gt get m n_exc ushort 16 gt get m n_exp ushort 16
ret ulong 0
end
if lt len dst ulong 64
ret ulong 0
end
for i ulong 6
put dst i get PD0_MAGIC_LAW1 i
end
put dst 6 uchar 0
put dst 7 uchar 0
pd0_put_u16 dst ulong 8 ushort 1
put dst 10 get m state
for i ulong 32
put dst add ulong 11 i uchar 0
end
pos = pd0_law_encode_rel slot dst ulong 43
pd0_put_u16 dst pos get m n_refutations
pos = add pos 2
put dst pos get p0r_neq slot
pos = add pos 1
pos = pd0_law_encode_eqs slot dst pos
nobs = sub ulong get p0r_nvars slot ulong get p0r_nlat slot
nc = ulong get p0r_nch slot
for v ulong nobs bound 4
pd0_put_u64 dst pos bitcast ulong get p0l_var_min v
pos = add pos 8
pd0_put_u64 dst pos bitcast ulong get p0l_var_max v
pos = add pos 8
end
for c ulong nc bound 2
pd0_put_u64 dst pos bitcast ulong get p0l_ch_min c
pos = add pos 8
pd0_put_u64 dst pos bitcast ulong get p0l_ch_max c
pos = add pos 8
end
pd0_put_u64 dst pos bitcast ulong get m dt_micro
pos = add pos 8
pd0_put_u64 dst pos get m n_obs_dom
pos = add pos 8
pd0_put_u32 dst pos get m n_ep_dom
pos = add pos 4
pd0_put_u64 dst pos bitcast ulong get m reset_min
pos = add pos 8
pd0_put_u64 dst pos bitcast ulong get m reset_max
pos = add pos 8
pd0_put_u32 dst pos get m ep_len
pos = add pos 4
pd0_put_u64 dst pos bitcast ulong get m latent_reset
pos = add pos 8
pd0_put_u32 dst pos get m confidence_ppm
pos = add pos 4
pos = pd0_law_encode_exc ulong get m n_exc dst pos
pos = pd0_law_encode_exp ulong get m n_exp dst pos
for k ulong 32
put dst pos get p0l_chain_root k
pos = add pos 1
end
claim = new uchar 512 0
cl = pd0_claim_text slot m edit claim
pd0_put_u16 dst pos ushort cl
pos = add pos 2
for k ulong cl bound 512
put dst pos get claim k
pos = add pos 1
end
h = new uchar 32 0
pd0_sha256_hash view dst pos edit h
for k ulong 32
put p0l_law_id k get h k
put dst add ulong 11 k get h k
end
ret pos
end

fn pd0_law_decode_term src view uchar * pos ulong ti ulong nv ulong nc ulong to ulong
xb = mul ti PD0_MAX_EX
put p0r_coef ti bitcast long pd0_get_u64 src pos
pos = add pos 8
for v ulong nv bound 6
put p0r_ex add xb v get src pos
pos = add pos 1
end
for c ulong nc bound 2
put p0r_ex add xb add PD0_MAX_VARS c get src pos
pos = add pos 1
end
ret pos
end

fn pd0_law_decode_eqs src view uchar * pos ulong slot ulong to ulong
slen = len src
nv = ulong get p0r_nvars slot
nc = ulong get p0r_nch slot
ne_cnt = ulong get p0r_neq slot
need_t = add ulong 8 add nv nc
for i ulong ne_cnt bound 6
if gt add pos 3 slen
ret ulong 0
end
ei = p0r_eq_idx slot i
put p0r_eq_tgt ei get src pos
nt = ulong pd0_get_u16 src add pos 1
pos = add pos 3
if gt nt PD0_MAX_TERMS
ret ulong 0
end
put p0r_eq_nt ei uchar nt
for t ulong nt bound 12
if gt add pos need_t slen
ret ulong 0
end
ti = p0r_term_idx slot i t
pos = pd0_law_decode_term src pos ti nv nc
end
end
ret pos
end

fn pd0_law_decode_tail src view uchar * pos ulong nobs ulong nc ulong m edit Pd0LawMeta to int
slen = len src
dom_need = add mul ulong 16 add nobs nc ulong 54
if gt add pos dom_need slen
ret -1
end
for v ulong nobs bound 4
put p0l_var_min v bitcast long pd0_get_u64 src pos
pos = add pos 8
put p0l_var_max v bitcast long pd0_get_u64 src pos
pos = add pos 8
end
for c ulong nc bound 2
put p0l_ch_min c bitcast long pd0_get_u64 src pos
pos = add pos 8
put p0l_ch_max c bitcast long pd0_get_u64 src pos
pos = add pos 8
end
put m dt_micro bitcast long pd0_get_u64 src pos
pos = add pos 8
put m n_obs_dom pd0_get_u64 src pos
pos = add pos 8
put m n_ep_dom pd0_get_u32 src pos
pos = add pos 4
put m reset_min bitcast long pd0_get_u64 src pos
pos = add pos 8
put m reset_max bitcast long pd0_get_u64 src pos
pos = add pos 8
put m ep_len pd0_get_u32 src pos
pos = add pos 4
put m latent_reset bitcast long pd0_get_u64 src pos
pos = add pos 8
put m confidence_ppm pd0_get_u32 src pos
pos = add pos 4
nexc = ulong pd0_get_u16 src pos
pos = add pos 2
if gt nexc ulong 16
ret -1
end
put m n_exc ushort nexc
if gt add pos mul nexc ulong 64 slen
ret -1
end
pos = add pos mul nexc ulong 64
if gt add pos 2 slen
ret -1
end
nexp = ulong pd0_get_u16 src pos
pos = add pos 2
if gt nexp ulong 16
ret -1
end
put m n_exp ushort nexp
if gt add pos mul nexp ulong 114 slen
ret -1
end
pos = add pos mul nexp ulong 114
if gt add pos 34 slen
ret -1
end
pos = add pos 32
cl = ulong pd0_get_u16 src pos
pos = add pos 2
if ne add pos cl slen
ret -1
end
ret 0
end

fn pd0_law_verify_hash src view uchar * to int
slen = len src
if gt slen ulong 4096
ret -1
end
copy = new uchar 4096 0
for i ulong slen bound 4096
put copy i get src i
end
for k ulong 32
put copy add ulong 11 k uchar 0
end
h = new uchar 32 0
pd0_sha256_hash view copy slen edit h
for k ulong 32
if ne get h k get src add ulong 11 k
ret -1
end
put p0l_law_id k get h k
end
ret 0
end

fn pd0_law_decode_hdr src view uchar * slot ulong m edit Pd0LawMeta to int
if lt len src ulong 53
ret -1
end
if ne pd0_eq_bytes src ulong 0 PD0_MAGIC_LAW1 ulong 6 1
ret -1
end
if or ne get src 6 uchar 0 ne get src 7 uchar 0
ret -1
end
if ne pd0_get_u16 src ulong 8 ushort 1
ret -1
end
if gt get src 10 PD0_LAW_PROVISIONAL
ret -1
end
put m state get src 10
p0r_clear slot
if or gt ulong get src 43 PD0_MAX_VARS or gt ulong get src 45 PD0_MAX_CH gt ulong get src 52 PD0_MAX_VARS
ret -1
end
put p0r_nvars slot get src 43
put p0r_nlat slot get src 44
put p0r_nch slot get src 45
put p0r_neq slot get src 52
put m n_refutations pd0_get_u16 src ulong 50
ret 0
end

fn pd0_law_decode src view uchar * slot ulong m edit Pd0LawMeta to int
if ne pd0_law_decode_hdr src slot m 0
ret -1
end
pos = pd0_law_decode_eqs src ulong 53 slot
if eq pos ulong 0
ret -1
end
if ne pd0_relation_valid slot 0
ret -1
end
if ne pd0_get_u32 src ulong 46 pd0_relation_description_bits slot
ret -1
end
nobs = sub ulong get p0r_nvars slot ulong get p0r_nlat slot
if ne pd0_law_decode_tail src pos nobs ulong get p0r_nch slot m 0
ret -1
end
ret pd0_law_verify_hash src
end

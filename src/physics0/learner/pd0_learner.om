note SPDX-License-Identifier: Apache-2.0
note src/physics0/learner/pd0_learner.om: Pure seeded OM-2 PD-0 learner (Direction 4, seal-1).
note Learner-side only: links only pd0_types, pd0_rng, pd0_wire, pd0_codes, pd0_fmt.
note No generator, no world, no file I/O, no level identity.

const P0L_MAX_TRANS ulong 65536
const P0L_MAX_LIB ulong 128
const P0L_MAX_CAND ulong 8
const P0L_MAX_SEL ulong 10
const P0L_MAX_FORBID ulong 4096
const P0L_X_CAP ulong 2097152
const P0L_CAND_BASE ulong 80
const P0L_TMP_BASE ulong 88
const P0L_EXP_BEST ulong 78
const P0L_EXP_CUR ulong 79
const P0L_I64_MAX long 9223372036854775807

text P0L_TAG_EXPLORE "explore"
text P0L_TAG_PERM "perm"
text P0L_TAG_PLAN "plan"
text P0L_J_HEAD "{\"n_fit\":"
text P0L_J_NSEL ",\"n_select\":"
text P0L_J_CANDS ",\"candidates\":["
text P0L_J_RANK "{\"rank\":"
text P0L_J_NULL ",\"null\":"
text P0L_J_SIZE ",\"size\":"
text P0L_J_BITS ",\"bits\":"
text P0L_J_FN ",\"fit_nrmse_micro\":"
text P0L_J_SN ",\"select_nrmse_micro\":"
text P0L_J_MDL ",\"mdl_bits\":"
text P0L_J_HID ",\"hidden_state_suspected\":"
text P0L_J_EQ ",\"eq\":["
text P0L_J_TGT "{\"target\":"
text P0L_J_TERMS ",\"terms\":["
text P0L_J_COEF "{\"coef\":"
text P0L_J_EXPO ",\"expo\":["
text P0L_J_C2 "]}"
text P0L_J_C3 "]}"

note ---- Learner describe & config ----
global p0l_nobs uchar 1
global p0l_nch uchar 1
global p0l_dt long 1
global p0l_cmin long 4
global p0l_cmax long 4
global p0l_rmin long 8
global p0l_rmax long 8
global p0l_epmax uint 1
global p0l_bsteps uint 1
global p0l_beps uint 1
global p0l_seed ulong 1

note ---- Stored transitions ----
global p0l_nt ulong 1
global p0l_tbef long 524288
global p0l_taft long 524288
global p0l_tchan uchar 65536
global p0l_tval long 65536
global p0l_ttag uchar 65536
global p0l_tep uint 65536
global p0l_trst uchar 65536

note ---- Monomial library ----
global p0l_ni ulong 1
global p0l_nl ulong 1
global p0l_lib uchar 2048

note ---- Candidates (0..7 = active cand, 8..15 = tmp) ----
global p0l_ncand ulong 1
global p0l_c_bits uint 16
global p0l_c_size uint 16
global p0l_c_fnrmse long 16
global p0l_c_snrmse long 16
global p0l_c_mdl f64 16
global p0l_c_lag1 f64 128
global p0l_c_hid int 16
global p0l_c_null int 16

note ---- Fitting & correlation scratch ----
global p0l_X f64 2097152
global p0l_Y f64 524288
global p0l_y f64 65536
global p0l_yp f64 65536
global p0l_best_sel ulong 80
global p0l_best_m ulong 8
global p0l_best_coef f64 80
global p0l_alt_sel ulong 80
global p0l_alt_m ulong 8
global p0l_alt_coef f64 80
global p0l_path_sel ulong 110
global p0l_path_m ulong 11
global p0l_path_coef f64 110
global p0l_path_rss f64 11
global p0l_path_mdl f64 11

note ---- Propose & report scratch ----
global p0l_forb uchar 131072
global p0l_pred long 1280
global p0l_rep_buf uchar 1048576
global p0l_ev_se f64 8
global p0l_ev_sv f64 8
global p0l_ev_ssv f64 8
global p0l_ev_num f64 8
global p0l_ev_den f64 8
global p0l_ev_prev f64 8
global p0l_best_h uchar 32
global p0l_pr_bestD f64 1
global p0l_pr_bcost long 1
global p0l_pr_r f64 1

fn p0l_fabs x f64 to f64
if lt x 0.0f64
ret neg x
end
ret x
end

fn p0l_iabs x long to long
if lt x long 0
ret neg x
end
ret x
end

note ---- Vocabulary: every monomial of total degree <= 3 over ni inputs ----
fn p0l_lib_has n ulong ni ulong e view uchar 16 to int
for k ulong n bound 128
kb = mul k V_MAX_EX
same = int 1
for j ulong ni bound 16
if ne get p0l_lib add kb j get e j
same = 0
break
end
end
if ne same 0
ret 1
end
end
ret 0
end

fn p0l_lib_try_add n ulong ni ulong a ulong bv ulong cv ulong to ulong
e = new uchar 16 0
if lt a ni
put e a add get e a uchar 1
end
if lt bv ni
put e bv add get e bv uchar 1
end
if lt cv ni
put e cv add get e cv uchar 1
end
if eq p0l_lib_has n ni view e 0
if lt n P0L_MAX_LIB
kb = mul n V_MAX_EX
for j ulong 16
put p0l_lib add kb j get e j
end
ret add n ulong 1
end
end
ret n
end

fn p0l_build_library ni ulong to ulong
n = ulong 0
lim = add ni ulong 1
for a ulong lim bound 17
for b ulong sub lim a bound 17
bv = add a b
for c ulong sub lim bv bound 17
n = p0l_lib_try_add n ni a bv add bv c
end
end
end
ret n
end

fn p0l_set_bounds cmin view long 4 cmax view long 4 rmin view long 8 rmax view long 8 to void
for c ulong 4
put p0l_cmin c get cmin c
put p0l_cmax c get cmax c
end
for j ulong 8
put p0l_rmin j get rmin j
put p0l_rmax j get rmax j
end
ret
end

fn p0l_set_budget epmax uint bsteps uint beps uint to void
put p0l_epmax 0 epmax
put p0l_bsteps 0 bsteps
put p0l_beps 0 beps
ret
end

fn p0l_init nobs uchar nch uchar dt long seed ulong to int
if or eq nobs uchar 0 or gt ulong nobs V_MAX_OBS gt ulong nch V_MAX_CHAN
ret -1
end
put p0l_nobs 0 nobs
put p0l_nch 0 nch
put p0l_dt 0 dt
put p0l_seed 0 seed
put p0l_nt 0 ulong 0
put p0l_ncand 0 ulong 0
ni = add ulong nobs ulong nch
put p0l_ni 0 ni
put p0l_nl 0 p0l_build_library ni
ret 0
end

fn p0l_observe r view Pd0Rec tag uchar to int
if and ne tag TAG_FIT ne tag TAG_SELECT
ret -1
end
nt = get p0l_nt 0
if or ne get r n_obs get p0l_nobs 0 ge nt P0L_MAX_TRANS
ret -1
end
if eq get r kind PD0_KIND_STEP
st = get r status
if and ne st PD0_OK ne st PD0_EPISODE_END
ret 0
end
end
no = ulong get r n_obs
base = mul nt V_MAX_OBS
for j ulong V_MAX_OBS
put p0l_tbef add base j long 0
put p0l_taft add base j long 0
end
for j ulong no bound 4
put p0l_tbef add base j get r before j
put p0l_taft add base j get r after j
end
put p0l_tchan nt get r channel
put p0l_tval nt get r applied
put p0l_ttag nt tag
put p0l_tep nt get r episode
if eq get r kind PD0_KIND_RESET
put p0l_trst nt uchar 1
else
put p0l_trst nt uchar 0
end
put p0l_nt 0 add nt ulong 1
ret 0
end

fn p0l_n_transitions tag uchar to uint
nt = get p0l_nt 0
cnt = uint 0
for i ulong nt bound 65536
if and eq get p0l_ttag i tag eq get p0l_trst i uchar 0
cnt = add cnt uint 1
end
end
ret cnt
end

note ---- Schedules ----
fn p0l_mix seed ulong idx uint to ulong
ret xor seed mul ulong idx ulong 0x9e3779b97f4a7c15
end

fn p0l_random_schedule mix ulong tag view uchar * rst edit long 8 chs edit uchar 20 vals edit long 20 to void
g = new ulong 1 0
pd0_stream edit g mix tag
nobs = ulong get p0l_nobs 0
nch = ulong get p0l_nch 0
for j ulong nobs bound 8
put rst j pd0_const edit g get p0l_rmin j get p0l_rmax j
end
for s ulong V_MAX_STEPS
if gt nch ulong 0
ch = uchar rem pd0_splitmix64 edit g nch
put chs s ch
put vals s pd0_const edit g get p0l_cmin ulong ch get p0l_cmax ulong ch
else
put chs s PD0_CH_NONE
put vals s long 0
end
end
ret
end

fn p0l_explore ep_idx uint rst edit long 8 chs edit uchar 20 vals edit long 20 to void
p0l_random_schedule p0l_mix get p0l_seed 0 ep_idx P0L_TAG_EXPLORE rst chs vals
ret
end

note ---- Prediction & one-step evaluation ----
fn p0l_rollout slot ulong init view long 8 chs view uchar 20 vals view long 20 n ulong dst edit long 160 to void
vr_rel_rollout slot init chs vals n dst
ret
end

fn p0l_ev_clear to void
for j ulong 8
put p0l_ev_se j 0.0f64
put p0l_ev_sv j 0.0f64
put p0l_ev_ssv j 0.0f64
put p0l_ev_num j 0.0f64
put p0l_ev_den j 0.0f64
put p0l_ev_prev j 0.0f64
end
ret
end

fn p0l_ev_acc_j j ulong pj long tv long to void
e = div f64 sub pj tv 1000000.0f64
v = div f64 tv 1000000.0f64
put p0l_ev_se j add get p0l_ev_se j mul e e
put p0l_ev_sv j add get p0l_ev_sv j v
put p0l_ev_ssv j add get p0l_ev_ssv j mul v v
ret
end

fn p0l_ev_lag_j j ulong pj long tv long have_prev int to void
res = div f64 sub tv pj 1000000.0f64
if ne have_prev 0
pr = get p0l_ev_prev j
put p0l_ev_num j add get p0l_ev_num j mul res pr
end
put p0l_ev_den j add get p0l_ev_den j mul res res
put p0l_ev_prev j res
ret
end

fn p0l_ev_step_acc p view long 12 tbase ulong no ulong have_prev int to void
for j ulong no bound 8
pj = get p j
tv = get p0l_taft add tbase j
p0l_ev_acc_j j pj tv
p0l_ev_lag_j j pj tv have_prev
end
ret
end

fn p0l_ev_nrmse n ulong no ulong to long
if eq n ulong 0
ret long 0
end
fn_d = f64 n
w = 0.0f64
for j ulong no bound 8
rmse = fsqrt div get p0l_ev_se j fn_d
m = div get p0l_ev_sv j fn_d
var = sub div get p0l_ev_ssv j fn_d mul m m
sd = 0.0f64
if gt var 0.0f64
sd = fsqrt var
end
v = rmse
if gt sd 1.0e-9f64
v = div rmse sd
end
if gt v w
w = v
end
end
if gt w 9.0e12f64
ret P0L_I64_MAX
end
ret long mul w 1000000.0f64
end

fn p0l_onestep_save_lag ci ulong to void
no = ulong get p0l_nobs 0
lb = mul ci V_MAX_OBS
for v ulong no bound 8
dv = get p0l_ev_den v
if gt dv 0.0f64
put p0l_c_lag1 add lb v div get p0l_ev_num v dv
else
put p0l_c_lag1 add lb v 0.0f64
end
end
ret
end

fn p0l_onestep_step slot ulong i ulong st edit long 12 have_prev int to void
no = ulong get p0l_nobs 0
tb = mul i V_MAX_OBS
nx = new long 12 0
for v ulong no bound 8
put st v get p0l_tbef add tb v
end
vr_rel_step slot view st get p0l_tchan i get p0l_tval i edit nx
p0l_ev_step_acc view nx tb no have_prev
for j ulong 12
put st j get nx j
end
ret
end

fn p0l_onestep_eval slot ulong tag uchar to long
no = ulong get p0l_nobs 0
nt = get p0l_nt 0
p0l_ev_clear
st = new long 12 0
cnt = ulong 0
have_prev = int 0
for i ulong nt bound 65536
if ne get p0l_ttag i tag
continue
end
if ne get p0l_trst i uchar 0
for j ulong 12
put st j long 0
end
have_prev = 0
continue
end
p0l_onestep_step slot i edit st have_prev
cnt = add cnt ulong 1
have_prev = 1
end
ret p0l_ev_nrmse cnt no
end

fn p0l_onestep_nrmse slot ulong tag uchar to long
ret p0l_onestep_eval slot tag
end

note ---- Least squares machinery ----
fn p0l_mono x view f64 16 lib_row ulong ni ulong to f64
v = 1.0f64
kb = mul lib_row V_MAX_EX
for i ulong ni bound 16
ex = ulong get p0l_lib add kb i
xv = get x i
for k ulong ex bound 4
v = mul v xv
end
end
ret v
end

fn p0l_solve_swap A edit f64 100 b edit f64 10 n ulong i ulong p ulong to void
for k ulong n bound 10
t = get A add mul i n k
put A add mul i n k get A add mul p n k
put A add mul p n k t
end
tb = get b i
put b i get b p
put b p tb
ret
end

fn p0l_solve_elim_row A edit f64 100 n ulong i ulong rv ulong f f64 to void
for k ulong sub n i bound 10
kv = add i k
ir = add mul rv n kv
ii = add mul i n kv
cur = get A ir
put A ir sub cur mul f get A ii
end
ret
end

fn p0l_solve_elim A edit f64 100 b edit f64 10 n ulong i ulong to void
piv = get A add mul i n i
for r ulong sub n add i ulong 1 bound 10
rv = add add i ulong 1 r
f = div get A add mul rv n i piv
p0l_solve_elim_row A n i rv f
put b rv sub get b rv mul f get b i
end
ret
end

fn p0l_solve_back A view f64 100 b edit f64 10 n ulong to void
for ii ulong n bound 10
i = sub sub n ulong 1 ii
s = get b i
for k ulong sub n add i ulong 1 bound 10
kv = add add i ulong 1 k
idx = add mul i n kv
s = sub s mul get A idx get b kv
end
put b i div s get A add mul i n i
end
ret
end

fn p0l_solve A edit f64 100 b edit f64 10 n ulong to int
for i ulong n bound 10
p = i
pv = p0l_fabs get A add mul i n i
for r ulong sub n add i ulong 1 bound 10
rv = add add i ulong 1 r
av = p0l_fabs get A add mul rv n i
if gt av pv
p = rv
pv = av
end
end
if lt pv 1.0e-14f64
ret -1
end
if ne p i
p0l_solve_swap A b n i p
end
p0l_solve_elim A b n i
end
p0l_solve_back view A b n
ret 0
end

fn p0l_fit_accum_row A edit f64 100 p ulong xp f64 rb ulong sel view ulong 10 m ulong to void
for q ulong m bound 10
idx = add mul p m q
xq = get p0l_X add rb get sel q
put A idx add get A idx mul xp xq
end
ret
end

fn p0l_fit_accum A edit f64 100 b edit f64 10 rb ulong yi f64 sel view ulong 10 m ulong to void
for p ulong m bound 10
xp = get p0l_X add rb get sel p
put b p add get b p mul xp yi
p0l_fit_accum_row A p xp rb sel m
end
ret
end

fn p0l_fit_rss_row rb ulong sel view ulong 10 m ulong b view f64 10 to f64
pr = 0.0f64
for p ulong m bound 10
bp = get b p
xp = get p0l_X add rb get sel p
pr = add pr mul bp xp
end
ret pr
end

fn p0l_fit_rss n ulong nl ulong sel view ulong 10 m ulong b view f64 10 to f64
rss = 0.0f64
for i ulong n bound 65536
pr = p0l_fit_rss_row mul i nl sel m b
d = sub pr get p0l_y i
rss = add rss mul d d
end
ret rss
end

fn p0l_fit_subset n ulong nl ulong sel view ulong 10 m ulong coef edit f64 10 to f64
A = new f64 100 0.0f64
b = new f64 10 0.0f64
for i ulong n bound 65536
p0l_fit_accum edit A edit b mul i nl get p0l_y i sel m
end
for p ulong m bound 10
idx = add mul p m p
put A idx add get A idx 1.0e-12f64
end
if gt m ulong 0
if ne p0l_solve edit A edit b m 0
ret 1.0e300f64
end
end
for p ulong m bound 10
put coef p get b p
end
ret p0l_fit_rss n nl sel m view b
end

fn p0l_term_bits ni ulong to f64
ret add mul 8.0f64 f64 ni 24.0f64
end

fn p0l_resid_bits rss f64 n ulong to f64
rm = 0.0f64
if gt n ulong 0
rm = mul fsqrt div rss f64 n 1000000.0f64
end
if lt rm 1.0f64
rm = 1.0f64
end
ret mul f64 n pd0_log2 rm
end

fn p0l_path_store r ulong sel view ulong 10 m ulong coef view f64 10 rss f64 mdl f64 to void
sb = mul r P0L_MAX_SEL
put p0l_path_m r m
put p0l_path_rss r rss
put p0l_path_mdl r mdl
for i ulong 10
put p0l_path_sel add sb i get sel i
put p0l_path_coef add sb i get coef i
end
ret
end

fn p0l_sel_has sel view ulong 10 m ulong k ulong to int
for s ulong m bound 10
if eq get sel s k
ret 1
end
end
ret 0
end

fn p0l_fwd_commit round ulong cand view ulong 10 m_new ulong bc view f64 10 best_rss f64 n ulong to void
ni = get p0l_ni 0
rb = p0l_resid_bits best_rss n
tb = mul p0l_term_bits ni f64 m_new
p0l_path_store round cand m_new bc best_rss add rb tb
ret
end

fn p0l_fwd_step n ulong nl ulong round ulong prev_m ulong to int
psb = mul sub round ulong 1 P0L_MAX_SEL
cand = new ulong 10 0
c = new f64 10 0.0f64
bc = new f64 10 0.0f64
for s ulong prev_m bound 10
put cand s get p0l_path_sel add psb s
end
best_rss = 1.0e300f64
bk = nl
for k ulong nl bound 128
if ne p0l_sel_has view cand prev_m k 0
continue
end
put cand prev_m k
rss = p0l_fit_subset n nl view cand add prev_m ulong 1 edit c
if lt rss mul best_rss sub 1.0f64 1.0e-12f64
best_rss = rss
bk = k
for s ulong 10
put bc s get c s
end
end
end
if eq bk nl
ret 0
end
put cand prev_m bk
p0l_fwd_commit round view cand add prev_m ulong 1 view bc best_rss n
ret 1
end

fn p0l_store_target_fit tg ulong is_alt int sel view ulong 10 m ulong coef view f64 10 to void
tb = mul tg P0L_MAX_SEL
if eq is_alt 0
put p0l_best_m tg m
for i ulong 10
put p0l_best_sel add tb i get sel i
put p0l_best_coef add tb i get coef i
end
else
put p0l_alt_m tg m
for i ulong 10
put p0l_alt_sel add tb i get sel i
put p0l_alt_coef add tb i get coef i
end
end
ret
end

fn p0l_drop_eval n ulong bsel view ulong 10 m ulong drop ulong csel edit ulong 10 ccoef edit f64 10 to f64
idx = ulong 0
for s ulong m bound 10
if ne s drop
put csel idx get bsel s
idx = add idx ulong 1
end
end
cm = sub m ulong 1
rss = p0l_fit_subset n get p0l_nl 0 view csel cm ccoef
rb = p0l_resid_bits rss n
tb = mul p0l_term_bits get p0l_ni 0 f64 cm
ret add rb tb
end

fn p0l_prune_one n ulong bsel edit ulong 10 bm edit ulong 1 bcoef edit f64 10 bmdl edit f64 1 to int
m = get bm 0
csel = new ulong 10 0
ccoef = new f64 10 0.0f64
for drop ulong m bound 10
mdl = p0l_drop_eval n view bsel m drop edit csel edit ccoef
if le mdl add get bmdl 0 1.0e-9f64
put bm 0 sub m ulong 1
put bmdl 0 mdl
for s ulong 10
put bsel s get csel s
put bcoef s get ccoef s
end
ret 1
end
end
ret 0
end

fn p0l_best_drop n ulong tg ulong bsel view ulong 10 m ulong to void
csel = new ulong 10 0
ccoef = new f64 10 0.0f64
dmdl = 1.0e300f64
best_drop = ulong 0
for drop ulong m bound 10
mdl = p0l_drop_eval n bsel m drop edit csel edit ccoef
if lt mdl dmdl
dmdl = mdl
best_drop = drop
end
end
ign = p0l_drop_eval n bsel m best_drop edit csel edit ccoef
p0l_store_target_fit tg 1 view csel sub m ulong 1 view ccoef
ret
end

fn p0l_select_finish n ulong nl ulong ni ulong tg ulong bi ulong steps ulong to void
bsel = new ulong 10 0
bcoef = new f64 10 0.0f64
bm = new ulong 1 0
bmdl = new f64 1 0.0f64
put bm 0 get p0l_path_m bi
put bmdl 0 get p0l_path_mdl bi
sb = mul bi P0L_MAX_SEL
for i ulong 10
put bsel i get p0l_path_sel add sb i
put bcoef i get p0l_path_coef add sb i
end
while gt get bm 0 ulong 0 bound 12
if eq p0l_prune_one n edit bsel edit bm edit bcoef edit bmdl 0
break
end
end
p0l_store_target_fit tg 0 view bsel get bm 0 view bcoef
if gt get bm 0 ulong 0
p0l_best_drop n tg view bsel get bm 0
else
if ge steps ulong 1
for i ulong 10
put bsel i get p0l_path_sel add P0L_MAX_SEL i
put bcoef i get p0l_path_coef add P0L_MAX_SEL i
end
p0l_store_target_fit tg 1 view bsel get p0l_path_m 1 view bcoef
else
p0l_store_target_fit tg 1 view bsel get bm 0 view bcoef
end
end
ret
end

fn p0l_select_init0 n ulong nl ulong to void
zsel = new ulong 10 0
zcoef = new f64 10 0.0f64
rss0 = p0l_fit_subset n nl view zsel ulong 0 edit zcoef
mdl0 = p0l_resid_bits rss0 n
p0l_path_store ulong 0 view zsel ulong 0 view zcoef rss0 mdl0
ret
end

fn p0l_select_terms n ulong nl ulong ni ulong tg ulong to void
p0l_select_init0 n nl
steps = ulong 0
for r ulong P0L_MAX_SEL
round = add r ulong 1
pm = get p0l_path_m r
if eq p0l_fwd_step n nl round pm 0
break
end
steps = round
end
bi = ulong 0
for r ulong steps bound 10
rv = add r ulong 1
if lt get p0l_path_mdl rv sub get p0l_path_mdl bi 1.0e-9f64
bi = rv
end
end
p0l_select_finish n nl ni tg bi steps
ret
end

fn p0l_quantise_term ti ulong ci long li ulong ni ulong to void
put vr_coef ti ci
xb = mul ti V_MAX_EX
lb = mul li V_MAX_EX
for k ulong V_MAX_EX
put vr_ex add xb k uchar 0
end
for k ulong ni bound 16
put vr_ex add xb k get p0l_lib add lb k
end
ret
end

fn p0l_quantise_eq slot ulong eqi ulong tg ulong is_alt int to ulong
tb = mul tg P0L_MAX_SEL
fm = get p0l_best_m tg
if ne is_alt 0
fm = get p0l_alt_m tg
end
put vr_eq_tgt vr_eq_idx slot eqi uchar tg
m = ulong 0
for s ulong fm bound 10
cf = get p0l_best_coef add tb s
li = get p0l_best_sel add tb s
if ne is_alt 0
cf = get p0l_alt_coef add tb s
li = get p0l_alt_sel add tb s
end
ci = pd0_llround mul cf 1000000.0f64
if eq ci long 0
continue
end
p0l_quantise_term vr_term_idx slot eqi m ci li get p0l_ni 0
m = add m ulong 1
end
put vr_eq_nt vr_eq_idx slot eqi ushort m
ret m
end

fn p0l_sel_step slot ulong i ulong st edit long 12 to void
no = ulong get p0l_nobs 0
tb = mul i V_MAX_OBS
nx = new long 12 0
for v ulong no bound 8
put st v get p0l_tbef add tb v
end
vr_rel_step slot view st get p0l_tchan i get p0l_tval i edit nx
for v ulong no bound 8
e = div f64 sub get p0l_taft add tb v get nx v 1000000.0f64
put p0l_ev_se v add get p0l_ev_se v mul e e
end
for j ulong 12
put st j get nx j
end
ret
end

fn p0l_select_resid_bits slot ulong to f64
no = ulong get p0l_nobs 0
nt = get p0l_nt 0
for v ulong 8
put p0l_ev_se v 0.0f64
end
st = new long 12 0
cnt = ulong 0
for i ulong nt bound 65536
if ne get p0l_ttag i TAG_SELECT
continue
end
if ne get p0l_trst i uchar 0
for j ulong 12
put st j long 0
end
continue
end
p0l_sel_step slot i edit st
cnt = add cnt ulong 1
end
rb = 0.0f64
for v ulong no bound 8
rb = add rb p0l_resid_bits get p0l_ev_se v cnt
end
ret rb
end

fn p0l_finish_candidate ci ulong to void
slot = add P0L_CAND_BASE ci
bits = vr_rel_bits slot
put vr_dbits slot bits
put p0l_c_bits ci bits
put p0l_c_size ci vr_rel_size slot
fnr = p0l_onestep_eval slot TAG_FIT
p0l_onestep_save_lag ci
snr = p0l_onestep_eval slot TAG_SELECT
put p0l_c_fnrmse ci fnr
put p0l_c_snrmse ci snr
rb = p0l_select_resid_bits slot
put p0l_c_mdl ci add rb f64 bits
hid = int 0
no = ulong get p0l_nobs 0
lb = mul ci V_MAX_OBS
for v ulong no bound 8
if and gt p0l_fabs get p0l_c_lag1 add lb v 0.3f64 gt fnr long 5000
hid = 1
end
end
put p0l_c_hid ci hid
ret
end

fn p0l_cand_clear ci ulong to void
slot = add P0L_CAND_BASE ci
vr_clear slot
put p0l_c_bits ci uint 0
put p0l_c_size ci uint 0
put p0l_c_fnrmse ci long 0
put p0l_c_snrmse ci long 0
put p0l_c_mdl ci 0.0f64
put p0l_c_hid ci 0
put p0l_c_null ci 0
lb = mul ci V_MAX_OBS
for v ulong V_MAX_OBS
put p0l_c_lag1 add lb v 0.0f64
end
ret
end

fn p0l_cand_copy dst ulong src ulong to void
vr_copy add P0L_CAND_BASE dst add P0L_CAND_BASE src
put p0l_c_bits dst get p0l_c_bits src
put p0l_c_size dst get p0l_c_size src
put p0l_c_fnrmse dst get p0l_c_fnrmse src
put p0l_c_snrmse dst get p0l_c_snrmse src
put p0l_c_mdl dst get p0l_c_mdl src
put p0l_c_hid dst get p0l_c_hid src
put p0l_c_null dst get p0l_c_null src
db = mul dst V_MAX_OBS
sb = mul src V_MAX_OBS
for v ulong V_MAX_OBS
put p0l_c_lag1 add db v get p0l_c_lag1 add sb v
end
ret
end

fn p0l_term_same_struct ta ulong tb ulong to int
if ne get vr_coef ta get vr_coef tb
ret 0
end
xa = mul ta V_MAX_EX
xb = mul tb V_MAX_EX
for k ulong V_MAX_EX
if ne get vr_ex add xa k get vr_ex add xb k
ret 0
end
end
ret 1
end

fn p0l_eq_same_struct sa ulong sb ulong e ulong to int
ea = vr_eq_idx sa e
eb = vr_eq_idx sb e
if ne get vr_eq_tgt ea get vr_eq_tgt eb
ret 0
end
nt = ulong get vr_eq_nt ea
if ne nt ulong get vr_eq_nt eb
ret 0
end
for t ulong nt bound 32
if eq p0l_term_same_struct vr_term_idx sa e t vr_term_idx sb e t 0
ret 0
end
end
ret 1
end

fn p0l_same_structure sa ulong sb ulong to int
if ne vr_rel_size sa vr_rel_size sb
ret 0
end
if ne vr_rel_bits sa vr_rel_bits sb
ret 0
end
ne_a = ulong get vr_neq sa
if ne ne_a ulong get vr_neq sb
ret 0
end
for e ulong ne_a bound 12
if eq p0l_eq_same_struct sa sb e 0
ret 0
end
end
ret 1
end

fn p0l_cand_less a ulong b ulong to int
ma = get p0l_c_mdl a
mb = get p0l_c_mdl b
if lt ma mb
ret 1
end
if gt ma mb
ret 0
end
if lt get p0l_c_size a get p0l_c_size b
ret 1
end
ret 0
end

fn p0l_sort_cands nc ulong to void
for i ulong nc bound 8
if eq i ulong 0
continue
end
p0l_cand_copy ulong 15 i
j = i
while gt j ulong 0 bound 8
jm = sub j ulong 1
if ne p0l_cand_less ulong 15 jm 0
p0l_cand_copy j jm
j = jm
else
break
end
end
p0l_cand_copy j ulong 15
end
ret
end

fn p0l_design_fill_x i ulong x edit f64 16 to void
no = ulong get p0l_nobs 0
nch = ulong get p0l_nch 0
tb = mul i V_MAX_OBS
for j ulong no bound 8
put x j div f64 get p0l_tbef add tb j 1000000.0f64
end
ch = get p0l_tchan i
tv = get p0l_tval i
for c ulong nch bound 4
if eq ulong ch c
put x add no c div f64 tv 1000000.0f64
else
put x add no c 0.0f64
end
end
ret
end

fn p0l_design_fill_y i ulong r ulong to void
no = ulong get p0l_nobs 0
tb = mul i V_MAX_OBS
yb = mul r no
for j ulong no bound 8
da = sub get p0l_taft add tb j get p0l_tbef add tb j
put p0l_Y add yb j div f64 da 1000000.0f64
end
ret
end

fn p0l_design_row i ulong r ulong to void
x = new f64 16 0.0f64
p0l_design_fill_x i edit x
ni = get p0l_ni 0
nl = get p0l_nl 0
rb = mul r nl
for k ulong nl bound 128
put p0l_X add rb k p0l_mono view x k ni
end
p0l_design_fill_y i r
ret
end

fn p0l_build_design n ulong to void
nt = get p0l_nt 0
r = ulong 0
for i ulong nt bound 65536
if or ne get p0l_ttag i TAG_FIT ne get p0l_trst i uchar 0
continue
end
if ge r n
break
end
p0l_design_row i r
r = add r ulong 1
end
ret
end

fn p0l_fit_build_cands to void
no = ulong get p0l_nobs 0
ntmp = ulong 0
for w ulong add no ulong 1 bound 9
if ge ntmp sub P0L_MAX_CAND ulong 1
break
end
ci = add ulong 8 ntmp
p0l_cand_clear ci
slot = add P0L_CAND_BASE ci
put vr_nvars slot get p0l_nobs 0
put vr_nch slot get p0l_nch 0
neq = ulong 0
for tg ulong no bound 8
is_alt = int 0
if and gt w ulong 0 eq tg sub w ulong 1
is_alt = 1
end
qm = p0l_quantise_eq slot neq tg is_alt
if gt qm ulong 0
neq = add neq ulong 1
end
end
put vr_neq slot uchar neq
p0l_finish_candidate ci
dup = int 0
for k ulong ntmp bound 8
if ne p0l_same_structure add P0L_CAND_BASE add ulong 8 k slot 0
dup = 1
end
end
if and eq dup 0 or gt neq ulong 0 eq w ulong 0
ntmp = add ntmp ulong 1
end
end
nc = get p0l_ncand 0
for k ulong ntmp bound 8
if ge nc P0L_MAX_CAND
break
end
src = add ulong 8 k
if eq p0l_same_structure add P0L_CAND_BASE src P0L_CAND_BASE 0
p0l_cand_copy nc src
nc = add nc ulong 1
end
end
put p0l_ncand 0 nc
p0l_sort_cands nc
ret
end

fn p0l_fit to int
no = ulong get p0l_nobs 0
ni = get p0l_ni 0
nl = get p0l_nl 0
put p0l_ncand 0 ulong 0
n = ulong p0l_n_transitions TAG_FIT
p0l_cand_clear ulong 0
put p0l_c_null 0 1
put vr_nvars P0L_CAND_BASE get p0l_nobs 0
put vr_nch P0L_CAND_BASE get p0l_nch 0
put vr_neq P0L_CAND_BASE uchar 0
p0l_finish_candidate ulong 0
put p0l_ncand 0 ulong 1
if lt n ulong 8
ret 1
end
if gt mul n nl P0L_X_CAP
ret 1
end
p0l_build_design n
for tg ulong no bound 8
for i ulong n bound 65536
put p0l_y i get p0l_Y add mul i no tg
end
p0l_select_terms n nl ni tg
end
p0l_fit_build_cands
ret int get p0l_ncand 0
end

note ---- Correlation evidence (spec T2) ----
fn p0l_pearson n ulong to f64
mx = 0.0f64
my = 0.0f64
for i ulong n bound 65536
mx = add mx get p0l_y i
my = add my get p0l_yp i
end
fn_d = f64 n
mx = div mx fn_d
my = div my fn_d
sxy = 0.0f64
sxx = 0.0f64
syy = 0.0f64
for i ulong n bound 65536
dx = sub get p0l_y i mx
dy = sub get p0l_yp i my
sxy = add sxy mul dx dy
sxx = add sxx mul dx dx
syy = add syy mul dy dy
end
if and gt sxx 0.0f64 gt syy 0.0f64
ret div sxy fsqrt mul sxx syy
end
ret 0.0f64
end

fn p0l_corr_fill a int b int to ulong
nt = get p0l_nt 0
ub = ulong b
k = ulong 0
for i ulong nt bound 65536
if ne get p0l_trst i uchar 0
continue
end
tb = mul i V_MAX_OBS
if lt a 0
put p0l_y k f64 get p0l_tval i
else
put p0l_y k f64 get p0l_tbef add tb ulong a
end
bi = add tb ub
da = sub get p0l_taft bi get p0l_tbef bi
put p0l_yp k f64 da
k = add k ulong 1
end
ret k
end

fn p0l_corr_shuf_one g edit ulong 1 n ulong to void
for i ulong n bound 65536
put p0l_yp i get p0l_X i
end
for ii ulong sub n ulong 1 bound 65536
i = sub sub n ulong 1 ii
j = rem pd0_splitmix64 g add i ulong 1
tmp = get p0l_yp i
put p0l_yp i get p0l_yp j
put p0l_yp j tmp
end
ret
end

fn p0l_corr_perm n ulong r0 f64 shuf_seed ulong n_shuf ulong to ulong
g = new ulong 1 0
pd0_stream edit g shuf_seed P0L_TAG_PERM
hits = ulong 0
for s ulong n_shuf bound 100000
p0l_corr_shuf_one edit g n
if ge p0l_fabs p0l_pearson n r0
hits = add hits ulong 1
end
end
ret hits
end

fn p0l_corr_find_best no ulong out_ab edit int 2 to f64
best_r = 0.0f64
ba = int -1
bb = int -1
for ai ulong add no ulong 1 bound 9
a = sub int ai 1
for bi ulong no bound 8
b = int bi
if eq a b
continue
end
r = p0l_pearson p0l_corr_fill a b
if gt p0l_fabs r p0l_fabs best_r
best_r = r
ba = a
bb = b
end
end
end
put out_ab 0 ba
put out_ab 1 bb
ret best_r
end

fn p0l_corr_count to ulong
nt = get p0l_nt 0
n = ulong 0
for i ulong nt bound 65536
if eq get p0l_trst i uchar 0
n = add n ulong 1
end
end
ret n
end

fn p0l_corr_copy_yp n ulong to void
for i ulong n bound 65536
put p0l_X i get p0l_yp i
end
ret
end

fn p0l_correlation shuf_seed ulong n_shuf uint out_m edit long 8 to int
n = p0l_corr_count
if lt n ulong 100
ret -1
end
ab = new int 2 -1
best_r = p0l_corr_find_best ulong get p0l_nobs 0 edit ab
if lt get ab 1 0
ret -1
end
ign = p0l_corr_fill get ab 0 get ab 1
p0l_corr_copy_yp n
n_pairs = mul ulong get p0l_nobs 0 ulong get p0l_nobs 0
hits = p0l_corr_perm n p0l_fabs best_r shuf_seed ulong n_shuf
p = mul div add f64 hits 1.0f64 add f64 n_shuf 1.0f64 f64 n_pairs
if gt p 1.0f64
p = 1.0f64
end
va = long PD0_CH_NONE
if ge get ab 0 0
va = long get ab 0
end
put out_m 0 va
put out_m 1 long get ab 1
put out_m 2 long n
put out_m 3 long mul best_r 1000000.0f64
put out_m 4 long mul p 1000000.0f64
put out_m 5 long n_pairs
put out_m 6 long n_shuf
put out_m 7 bitcast long shuf_seed
ret 0
end

note ---- Planner stand-in (propose) ----
fn p0l_forb_hit h view uchar 32 n_forb ulong to int
for f ulong n_forb bound 4096
fb = mul f PD0_HASH
same = int 1
for k ulong 32
if ne get h k get p0l_forb add fb k
same = 0
break
end
end
if ne same 0
ret 1
end
end
ret 0
end

fn p0l_hash_lt a view uchar 32 b view uchar 32 to int
for k ulong 32
ak = get a k
bk = get b k
if lt ak bk
ret 1
end
if gt ak bk
ret 0
end
end
ret 0
end

fn p0l_propose_eval_pair ab ulong bb ulong cnt ulong r f64 to f64
D = 0.0f64
for k ulong cnt bound 160
pa = get p0l_pred add ab k
pb = get p0l_pred add bb k
df = f64 sub pa pb
if lt df 0.0f64
df = neg df
end
d = div div df 1000000.0f64 r
if gt d D
D = d
end
end
ret D
end

fn p0l_propose_eval n_hyp ulong cnt ulong r f64 to f64
D = 0.0f64
for a ulong n_hyp bound 8
ab = mul a ulong 160
for b ulong sub n_hyp add a ulong 1 bound 8
bv = add add a ulong 1 b
d = p0l_propose_eval_pair ab mul bv ulong 160 cnt r
if gt d D
D = d
end
end
end
ret D
end

fn p0l_propose_roll hyps view ulong 8 n_hyp ulong rst view long 8 chs view uchar 20 vals view long 20 to int
no = ulong get p0l_nobs 0
n = V_MAX_STEPS
pr = new long 160 0
for hy ulong n_hyp bound 8
p0l_rollout get hyps hy rst chs vals n edit pr
hb = mul hy ulong 160
for k ulong 160
put p0l_pred add hb k get pr k
end
end
for s ulong n bound 20
for j ulong no bound 8
if gt p0l_iabs get p0l_pred add mul s no j long 8000000
ret 1
end
end
end
ret 0
end

fn p0l_propose_save_hy exp_slot ulong hy ulong no ulong n ulong to void
pb = mul hy ulong 160
for s ulong n bound 20
sb = add pb mul s no
for j ulong no bound 8
val = get p0l_pred add sb j
put ve_expected vr_exp_idx exp_slot hy s j val
end
end
ret
end

fn p0l_propose_save_exp exp_slot ulong n_hyp ulong no ulong n ulong to void
for hy ulong n_hyp bound 8
p0l_propose_save_hy exp_slot hy no n
end
ret
end

fn p0l_propose_save exp_slot ulong n_hyp ulong rst view long 8 chs view uchar 20 vals view long 20 h view uchar 32 to void
no = ulong get p0l_nobs 0
n = V_MAX_STEPS
put ve_nobs exp_slot uchar no
put ve_nhyp exp_slot uchar n_hyp
put ve_nsteps exp_slot uchar n
rb = mul exp_slot V_MAX_OBS
for j ulong no bound 8
put ve_reset add rb j get rst j
end
sb = mul exp_slot V_MAX_STEPS
for s ulong n bound 20
put ve_step_ch add sb s get chs s
put ve_step_val add sb s get vals s
end
hb = mul exp_slot PD0_HASH
for k ulong 32
put ve_shash add hb k get h k
end
p0l_propose_save_exp exp_slot n_hyp no n
ret
end

fn p0l_propose_pool hyps view ulong 8 n_hyp ulong to f64
r = 0.0f64
cnt = ulong 0
for h ulong n_hyp bound 8
e = p0l_onestep_nrmse get hyps h TAG_SELECT
if and gt e long 0 lt e P0L_I64_MAX
r = add r div f64 e 1000000.0f64
cnt = add cnt ulong 1
end
end
if gt cnt ulong 0
r = div r f64 cnt
else
r = 0.0f64
end
if lt r 1.0e-4f64
r = 1.0e-4f64
end
ret r
end

fn p0l_hash_lt_best h view uchar 32 to int
for k ulong 32
ak = get h k
bk = get p0l_best_h k
if lt ak bk
ret 1
end
if gt ak bk
ret 0
end
end
ret 0
end

fn p0l_propose_is_better D f64 cost long h view uchar 32 to int
bestD = get p0l_pr_bestD 0
best_cost = get p0l_pr_bcost 0
if gt D add bestD 1.0e-12f64
ret 1
end
if le p0l_fabs sub D bestD 1.0e-12f64
if lt cost best_cost
ret 1
end
if and eq cost best_cost ne p0l_hash_lt_best h 0
ret 1
end
end
ret 0
end

fn p0l_propose_try hyps view ulong 8 n_hyp ulong mix ulong n_forb ulong exp_slot ulong to void
no = ulong get p0l_nobs 0
n = V_MAX_STEPS
rst = new long 8 0
chs = new uchar 20 0
vals = new long 20 0
h = new uchar 32 0
p0l_random_schedule mix P0L_TAG_PLAN edit rst edit chs edit vals
vr_schedule_hash_raw no view rst n view chs view vals edit h
if ne p0l_forb_hit view h n_forb 0
ret
end
if ne p0l_propose_roll hyps n_hyp view rst view chs view vals 0
ret
end
D = p0l_propose_eval n_hyp mul n no get p0l_pr_r 0
cost = long 0
for s ulong n bound 20
cost = add cost p0l_iabs get vals s
end
if ne p0l_propose_is_better D cost view h 0
put p0l_pr_bestD 0 D
put p0l_pr_bcost 0 cost
for k ulong 32
put p0l_best_h k get h k
end
p0l_propose_save exp_slot n_hyp view rst view chs view vals view h
end
ret
end

fn p0l_propose hyps view ulong 8 n_hyp ulong planner_seed ulong n_random ulong n_forb ulong exp_slot ulong to long
if or lt n_hyp ulong 2 gt n_hyp V_MAX_HYP
ret long -1
end
put p0l_pr_r 0 p0l_propose_pool hyps n_hyp
put p0l_pr_bestD 0 -1.0f64
put p0l_pr_bcost 0 P0L_I64_MAX
for k ulong 32
put p0l_best_h k uchar 0
end
for idx ulong n_random bound 4096
p0l_propose_try hyps n_hyp p0l_mix planner_seed uint idx n_forb exp_slot
end
bestD = get p0l_pr_bestD 0
if lt bestD 3.0f64
ret long -1
end
dv = long mul bestD 1000000.0f64
put ve_div exp_slot dv
ret dv
end

note ---- JSON report ----
fn p0l_rb_ch pos ulong ch uchar to ulong
if lt pos ulong 1048576
put p0l_rep_buf pos ch
ret add pos ulong 1
end
ret pos
end

fn p0l_rb_str pos ulong s view uchar * to ulong
n = len s
for i ulong n bound 256
if lt pos ulong 1048576
put p0l_rep_buf pos get s i
pos = add pos ulong 1
end
end
ret pos
end

fn p0l_rb_u64 pos ulong v ulong to ulong
tmp = new uchar 32 0
k = pd0_buf_u64 edit tmp ulong 0 ulong 32 v
for i ulong k bound 32
pos = p0l_rb_ch pos get tmp i
end
ret pos
end

fn p0l_rb_i64 pos ulong v long to ulong
tmp = new uchar 32 0
k = pd0_buf_i64 edit tmp ulong 0 ulong 32 v
for i ulong k bound 32
pos = p0l_rb_ch pos get tmp i
end
ret pos
end

fn p0l_rb_f64_1 pos ulong x f64 to ulong
if lt x 0.0f64
pos = p0l_rb_ch pos uchar 45
x = neg x
end
sc = ulong pd0_llround mul x 10.0f64
pos = p0l_rb_u64 pos div sc ulong 10
pos = p0l_rb_ch pos uchar 46
ret p0l_rb_u64 pos rem sc ulong 10
end

fn p0l_report_eq pos ulong slot ulong e ulong ne_ex ulong to ulong
ei = vr_eq_idx slot e
if gt e ulong 0
pos = p0l_rb_ch pos uchar 44
end
pos = p0l_rb_str pos P0L_J_TGT
pos = p0l_rb_u64 pos ulong get vr_eq_tgt ei
pos = p0l_rb_str pos P0L_J_TERMS
nt = ulong get vr_eq_nt ei
for t ulong nt bound 32
if gt t ulong 0
pos = p0l_rb_ch pos uchar 44
end
ti = vr_term_idx slot e t
pos = p0l_rb_str pos P0L_J_COEF
pos = p0l_rb_i64 pos get vr_coef ti
pos = p0l_rb_str pos P0L_J_EXPO
xb = mul ti V_MAX_EX
for k ulong ne_ex bound 16
if gt k ulong 0
pos = p0l_rb_ch pos uchar 44
end
pos = p0l_rb_u64 pos ulong get vr_ex add xb k
end
pos = p0l_rb_str pos P0L_J_C2
end
ret p0l_rb_str pos P0L_J_C2
end

fn p0l_report_cand pos ulong i ulong to ulong
slot = add P0L_CAND_BASE i
if gt i ulong 0
pos = p0l_rb_ch pos uchar 44
end
pos = p0l_rb_str pos P0L_J_RANK
pos = p0l_rb_u64 pos i
pos = p0l_rb_str pos P0L_J_NULL
pos = p0l_rb_i64 pos long get p0l_c_null i
pos = p0l_rb_str pos P0L_J_SIZE
pos = p0l_rb_u64 pos ulong get p0l_c_size i
pos = p0l_rb_str pos P0L_J_BITS
pos = p0l_rb_u64 pos ulong get p0l_c_bits i
pos = p0l_rb_str pos P0L_J_FN
pos = p0l_rb_i64 pos get p0l_c_fnrmse i
pos = p0l_rb_str pos P0L_J_SN
pos = p0l_rb_i64 pos get p0l_c_snrmse i
pos = p0l_rb_str pos P0L_J_MDL
pos = p0l_rb_f64_1 pos get p0l_c_mdl i
pos = p0l_rb_str pos P0L_J_HID
pos = p0l_rb_i64 pos long get p0l_c_hid i
pos = p0l_rb_str pos P0L_J_EQ
ne_cnt = ulong get vr_neq slot
ne_ex = add ulong get vr_nvars slot ulong get vr_nch slot
for e ulong ne_cnt bound 12
pos = p0l_report_eq pos slot e ne_ex
end
ret p0l_rb_str pos P0L_J_C2
end

fn p0l_report to ulong
pos = p0l_rb_str ulong 0 P0L_J_HEAD
pos = p0l_rb_u64 pos ulong p0l_n_transitions TAG_FIT
pos = p0l_rb_str pos P0L_J_NSEL
pos = p0l_rb_u64 pos ulong p0l_n_transitions TAG_SELECT
pos = p0l_rb_str pos P0L_J_CANDS
nc = get p0l_ncand 0
for i ulong nc bound 8
pos = p0l_report_cand pos i
end
ret p0l_rb_str pos P0L_J_C3
end

note SPDX-License-Identifier: Apache-2.0
note src/physics0/pd0_chan.om: Learner-side framed pipe channel to PD-0 world.
note Learner-side safe: no generator, no world, no file I/O.

fn pd0_read_full fd int buf edit uchar * n ulong to int
got = ulong 0
while lt got n bound 1048576
k = read fd buf got sub n got
if le k long 0
ret -1
end
got = add got ulong k
end
ret 0
end

fn pd0_write_full fd int buf view uchar * n ulong to int
putn = ulong 0
while lt putn n bound 1048576
k = write fd buf putn sub n putn
if le k long 0
ret -1
end
putn = add putn ulong k
end
ret 0
end

fn pd0_chan_call_fd in_fd int out_fd int req view uchar * resp edit uchar * to ulong
rlen = len req
len4 = new uchar 4 0
pd0_put_u32 edit len4 ulong 0 uint rlen
if ne pd0_write_full out_fd view len4 ulong 4 0
ret ulong 0
end
if ne pd0_write_full out_fd req rlen 0
ret ulong 0
end
if ne pd0_read_full in_fd edit len4 ulong 4 0
ret ulong 0
end
n = ulong pd0_get_u32 view len4 ulong 0
if or eq n ulong 0 gt n len resp
ret ulong 0
end
if ne pd0_read_full in_fd resp n 0
ret ulong 0
end
ret n
end

fn pd0_chan_describe_fd in_fd int out_fd int d edit Pd0Desc to int
req = new uchar 64 0
resp = new uchar 256 0
rlen = pd0_req_describe edit req
n = pd0_chan_call_fd in_fd out_fd part req 0 rlen edit resp
if eq n ulong 0
ret -1
end
ret pd0_desc_decode part resp 0 n d
end

fn pd0_chan_reset_fd in_fd int out_fd int n_obs uchar vals view long 4 r edit Pd0Rec to int
req = new uchar 64 0
resp = new uchar 256 0
rlen = pd0_req_reset n_obs vals edit req
if eq rlen ulong 0
ret -1
end
n = pd0_chan_call_fd in_fd out_fd part req 0 rlen edit resp
if eq n ulong 0
ret -1
end
ret pd0_rec_decode part resp 0 n r
end

fn pd0_chan_step_fd in_fd int out_fd int ch uchar val long r edit Pd0Rec to int
req = new uchar 64 0
resp = new uchar 256 0
rlen = pd0_req_step ch val edit req
n = pd0_chan_call_fd in_fd out_fd part req 0 rlen edit resp
if eq n ulong 0
ret -1
end
ret pd0_rec_decode part resp 0 n r
end

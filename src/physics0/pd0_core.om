note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/physics0/ (pd0_rng.c, pd0_wire.c):
note FNV-1a 64-bit, SplitMix64, uniform [0, 1000000], canonical LE u16/u32/u64
note codecs, and PD0DESC2 / PD0REC1 magic + version validators.
om2

fn pd0_sm64 st edit ulong 1 to ulong
  z = add get st 0 0x9e3779b97f4a7c15
  put st 0 z
  z = mul xor z shr z 30 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 0x94d049bb133111eb
  ret xor z shr z 31
end

export fn pd0_om_fnv1a64 tag view uchar * n ulong to ulong
  h = ulong 0xcbf29ce484222325
  for i ulong n
    h = mul xor h ulong get tag i 0x100000001b3
  end
  ret h
end

export fn pd0_om_splitmix64 st edit ulong 1 to ulong
  ret pd0_sm64 st
end

export fn pd0_om_uniform st edit ulong 1 to ulong
  ret rem pd0_sm64 st 1000001
end

export fn pd0_om_put_u16 dst edit uchar * pos ulong v ulong to void
  put dst pos uchar and v 255
  put dst add pos 1 uchar and shr v 8 255
end

export fn pd0_om_put_u32 dst edit uchar * pos ulong v ulong to void
  for i ulong 4
    put dst add pos i uchar and shr v mul i 8 255
  end
end

export fn pd0_om_put_u64 dst edit uchar * pos ulong v ulong to void
  for i ulong 8
    put dst add pos i uchar and shr v mul i 8 255
  end
end

export fn pd0_om_get_u16 src view uchar * pos ulong to ulong
  b0 = ulong get src pos
  b1 = ulong get src add pos 1
  ret or b0 shl b1 8
end

export fn pd0_om_get_u32 src view uchar * pos ulong to ulong
  v = ulong 0
  for i ulong 4
    b = ulong get src add pos i
    v = or v shl b mul i 8
  end
  ret v
end

export fn pd0_om_get_u64 src view uchar * pos ulong to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get src add pos i
    v = or v shl b mul i 8
  end
  ret v
end

fn pd0_has_prefix7 src view uchar * b3 ulong b4 ulong b5 ulong b6 ulong to ulong
  if ne ulong get src 0 80
    ret 0
  end
  if ne ulong get src 1 68
    ret 0
  end
  if ne ulong get src 2 48
    ret 0
  end
  if ne ulong get src 3 b3
    ret 0
  end
  if ne ulong get src 4 b4
    ret 0
  end
  if ne ulong get src 5 b5
    ret 0
  end
  if ne ulong get src 6 b6
    ret 0
  end
  ret 1
end

export fn pd0_om_check_desc_magic src view uchar * slen ulong to ulong
  if lt slen 8
    ret 2
  end
  if eq pd0_has_prefix7 src 68 69 83 67 0
    ret 2
  end
  b7 = ulong get src 7
  if eq b7 49
    ret 1
  end
  if and ge slen 10 eq b7 50
    ret 0
  end
  ret 2
end

export fn pd0_om_check_rec_magic src view uchar * slen ulong to ulong
  if lt slen 12
    ret 1
  end
  if eq pd0_has_prefix7 src 82 69 67 49 0
    ret 1
  end
  if ne ulong get src 7 0
    ret 1
  end
  ver = or ulong get src 8 shl ulong get src 9 8
  if ne ver 1
    ret 1
  end
  ret 0
end

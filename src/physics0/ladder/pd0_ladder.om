note SPDX-License-Identifier: Apache-2.0
note src/physics0/ladder/pd0_ladder.om: Independent PD-0 ladder checker (spec sections 5, 7).
note Pure verifier-side OM-2: no generator, no world, no file I/O.

const LS_START int 0
const LS_OBSERVATION int 1
const LS_CORRELATION int 2
const LS_CANDIDATE int 3
const LS_HYPOTHESIS int 4
const LS_PREDICTED int 5
const LS_INTERVENED int 6
const LS_REPLICATED int 7

const VLEDG_CAP ulong 8388608
const LC_MAX_REC ulong 65536
const LC_MAX_EP ulong 2048
const LC_MAX_RELS ulong 64
const LC_MAX_PRE ulong 64
const LC_MAX_BAT ulong 32
const LR_CAND_SLOT ulong 64
const LR_VERIFY_REL_SLOT ulong 65
const LR_EMIT_REL_SLOT ulong 68
const LR_SCRATCH_REL_SLOT ulong 67
const LR_DOM_SLOT ulong 0
const LR_VERIFY_LAW_SLOT ulong 1

text LS_N0 "START"
text LS_N1 "OBSERVATION"
text LS_N2 "CORRELATION"
text LS_N3 "CANDIDATE"
text LS_N4 "HYPOTHESIS"
text LS_N5 "PREDICTED"
text LS_N6 "INTERVENED"
text LS_N7 "REPLICATED"
text LS_NQ "?"
text LAD_TAG_PERM "perm"

text LAD_CL_ACROSS "Across "
text LAD_CL_OBS " observations under "
text LAD_CL_SEMI "; "
text LAD_CL_S "s"
text LAD_CL_IN " in ["
text LAD_CL_COM ", "
text LAD_CL_RB "]"
text LAD_CL_PRED ", this relation predicts within "
text LAD_CL_NRMSE " (rollout NRMSE, 20 steps). Confidence "
text LAD_CL_PPM " ppm. "
text LAD_CL_EXC " exceptions recorded."

text LAD_BAD0 "always"
text LAD_BAD1 "universally"
text LAD_BAD2 "true"
text LAD_BAD3 "Always"
text LAD_BAD4 "Universally"
text LAD_BAD5 "True"


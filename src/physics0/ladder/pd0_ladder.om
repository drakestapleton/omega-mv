global lc_rec_step uint 65536
global lc_rec_req long 65536
global lc_rec_app long 65536
global lc_rec_bef long 262144
global lc_rec_aft long 262144
global lc_rec_hash uchar 2097152

global lc_nep uint 1
global lc_ep_first uint 2048
global lc_ep_n uint 2048
global lc_ep_tag uchar 2048
global lc_ep_orig uchar 2048
global lc_ep_htag uchar 2048

global lr_n_void_ep uint 1
global lr_n_void_bat uint 1
global lr_last_r f64 1
global lr_last_p f64 1

note ---- Ladder replay context (lc_*) ----
global lc_nrec uint 1
global lc_have_rec int 1
global lc_last_rhash uchar 32
global lc_rec_nobs uchar 65536
global lc_rec_st uchar 65536

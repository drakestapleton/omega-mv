note SPDX-License-Identifier: Apache-2.0
note src/physics0/ladder/pd0_fmt.om: Verifier-owned byte layouts (PD0REC1, pd0_rel, PDLAW1, PD0EXP1, PD0LEDG1).
note Little-endian, fixed-width, no floating point in canonical bytes. Pure learner/verifier safe.

const V_MAX_OBS ulong 8
const V_MAX_CHAN ulong 4
const V_MAX_VARS ulong 12
const V_MAX_EX ulong 16
const V_MAX_TERMS ulong 32
const V_MAX_EQ ulong 12
const V_MAX_STEPS ulong 20
const V_MAX_HYP ulong 8

const LEDG_OBS uchar 0
const LEDG_TAG uchar 1
const LEDG_CORR uchar 2
const LEDG_RELATION uchar 3
const LEDG_FALSIFIER uchar 4
const LEDG_PREREG uchar 5
const LEDG_BATCH uchar 6

const TAG_FIT uchar 0
const TAG_SELECT uchar 1
const TAG_HOLDOUT uchar 2
const TAG_TRIAL uchar 3
const TAG_REP uchar 4

const ORIGIN_PLANNER uchar 0
const ORIGIN_RANDOM uchar 1

const REL_CANDIDATE uchar 0
const REL_RIVAL uchar 1
const REL_NULL uchar 2

const PD0_LEDG_HDR ulong 16
const PD0_LEDG_TRAILER ulong 64

text V_MAGIC_REC1 "PD0REC1"
text V_MAGIC_LAW1 "PDLAW1"
text V_MAGIC_EXP1 "PD0EXP1"
text V_MAGIC_LEDG1 "PD0LEDG1"

note ---- Verifier relation slots (128 slots, 12 eq, 32 terms, 16 ex) ----
const VR_SLOTS ulong 128
global vr_nvars uchar 128
global vr_nlat uchar 128
global vr_nch uchar 128
global vr_neq uchar 128
global vr_dbits uint 128
global vr_nref ushort 128
global vr_eq_tgt uchar 1536
global vr_eq_nt ushort 1536
global vr_coef long 49152
global vr_ex uchar 786432

note ---- Verifier PD0EXP1 working buffers (slot-indexed, 80 slots) ----
const VE_SLOTS ulong 80
global ve_nobs uchar 80
global ve_nhyp uchar 80
global ve_nsteps uchar 80
global ve_reset long 640
global ve_step_ch uchar 1600
global ve_step_val long 1600
global ve_expected long 102400
global ve_div long 80
global ve_shash uchar 2560

note ---- Verifier PDLAW1 working buffers (4 slots, 64 exc, 64 exp, 512 claim) ----
const VL_SLOTS ulong 4
const VL_MAX_EXC ulong 64
const VL_MAX_EXP ulong 64
const VL_MAX_CLAIM ulong 512
global vl_state uchar 4
global vl_law_id uchar 128
global vl_rel_slot ulong 4
global vl_dom_nobs uchar 4
global vl_dom_nch uchar 4
global vl_dom_vmin long 32
global vl_dom_vmax long 32
global vl_dom_cmin long 16
global vl_dom_cmax long 16
global vl_dom_dt long 4
global vl_dom_nobs_cnt ulong 4
global vl_dom_nep_cnt uint 4
global vl_dom_rmin long 4
global vl_dom_rmax long 4
global vl_dom_eplen uint 4
global vl_dom_latr long 4
global vl_conf_ppm uint 4
global vl_n_exc uint 4
global vl_exc_seq ulong 256
global vl_exc_hash uchar 8192
global vl_exc_pred long 256
global vl_exc_obs long 256
global vl_exc_err long 256
global vl_n_exp uint 4
global vl_exp_id uchar 8192
global vl_exp_kind uchar 256
global vl_exp_pre uchar 8192
global vl_exp_out uchar 8192
global vl_exp_res uchar 256
global vl_exp_fseq ulong 256
global vl_exp_lseq ulong 256
global vl_chain_root uchar 128
global vl_claim_len uint 4
global vl_claim uchar 2048

fn vr_eq_idx slot ulong eqi ulong to ulong
ret add mul slot V_MAX_EQ eqi
end

fn vr_term_idx slot ulong eqi ulong t ulong to ulong
ret add mul vr_eq_idx slot eqi V_MAX_TERMS t
end

fn vr_clear slot ulong to void
put vr_nvars slot uchar 0
put vr_nlat slot uchar 0
put vr_nch slot uchar 0
put vr_neq slot uchar 0
put vr_dbits slot uint 0
put vr_nref slot ushort 0
eb = mul slot V_MAX_EQ
for e ulong V_MAX_EQ
put vr_eq_tgt add eb e uchar 0
put vr_eq_nt add eb e ushort 0
end
ret
end

fn vr_copy_term dt ulong st ulong to void
put vr_coef dt get vr_coef st
dxb = mul dt V_MAX_EX
sxb = mul st V_MAX_EX
for k ulong V_MAX_EX
put vr_ex add dxb k get vr_ex add sxb k
end
ret
end

fn vr_copy dst ulong src ulong to void
put vr_nvars dst get vr_nvars src
put vr_nlat dst get vr_nlat src
put vr_nch dst get vr_nch src
put vr_neq dst get vr_neq src
put vr_dbits dst get vr_dbits src
put vr_nref dst get vr_nref src
ne_cnt = ulong get vr_neq src
for e ulong ne_cnt bound 12
de = vr_eq_idx dst e
se = vr_eq_idx src e
put vr_eq_tgt de get vr_eq_tgt se
nt = ulong get vr_eq_nt se
put vr_eq_nt de ushort nt
for t ulong nt bound 32
vr_copy_term vr_term_idx dst e t vr_term_idx src e t
end
end
ret
end

fn vr_rel_size slot ulong to uint
s = uint get vr_nlat slot
ne_cnt = ulong get vr_neq slot
for e ulong ne_cnt bound 12
nt = ulong get vr_eq_nt vr_eq_idx slot e
for t ulong nt bound 32
if ne get vr_coef vr_term_idx slot e t long 0
s = add s uint 1
end
end
end
ret s
end

fn vr_rel_bits slot ulong to uint
ne_ex = add uint get vr_nvars slot uint get vr_nch slot
per = add mul uint 8 ne_ex uint 24
b = mul uint 8 uint get vr_nlat slot
ne_cnt = ulong get vr_neq slot
for e ulong ne_cnt bound 12
nt = uint get vr_eq_nt vr_eq_idx slot e
b = add b mul nt per
end
ret b
end

fn vr_term_deg ti ulong ne_ex ulong to int
s = int 0
xb = mul ti V_MAX_EX
for i ulong ne_ex bound 16
s = add s int get vr_ex add xb i
end
ret s
end

fn vr_rel_max_degree slot ulong to int
d = int 0
ne_ex = add ulong get vr_nvars slot ulong get vr_nch slot
ne_cnt = ulong get vr_neq slot
for e ulong ne_cnt bound 12
nt = ulong get vr_eq_nt vr_eq_idx slot e
for t ulong nt bound 32
s = vr_term_deg vr_term_idx slot e t ne_ex
if gt s d
d = s
end
end
end
ret d
end

fn vr_ipow_micro base long ex ulong to long
acc = PD0_MICRO
for i ulong ex bound 8
acc = pd0_mul acc base
end
ret acc
end

fn vr_eval_term ti ulong ne_ex ulong inp view long 16 to long
m = get vr_coef ti
xb = mul ti V_MAX_EX
for i ulong ne_ex bound 16
ex = ulong get vr_ex add xb i
if gt ex ulong 0
m = pd0_mul m vr_ipow_micro get inp i ex
end
end
ret m
end

fn vr_rel_step_eq slot ulong e ulong ne_ex ulong inp view long 16 to long
nt = ulong get vr_eq_nt vr_eq_idx slot e
d = long 0
for t ulong nt bound 32
d = add d vr_eval_term vr_term_idx slot e t ne_ex inp
end
ret d
end

fn vr_rel_step slot ulong st view long 12 ch uchar val long nxt edit long 12 to void
nv = ulong get vr_nvars slot
nc = ulong get vr_nch slot
ne_ex = add nv nc
inp = new long 16 0
for i ulong nv bound 12
put inp i get st i
put nxt i get st i
end
for c ulong nc bound 4
if eq ulong ch c
put inp add nv c val
else
put inp add nv c long 0
end
end
ne_cnt = ulong get vr_neq slot
for e ulong ne_cnt bound 12
tgt = ulong get vr_eq_tgt vr_eq_idx slot e
d = vr_rel_step_eq slot e ne_ex view inp
put nxt tgt add get st tgt d
end
ret
end

fn vr_rel_write_term ti ulong ne_ex ulong dst edit uchar * o ulong to ulong
pd0_put_u64 dst o bitcast ulong get vr_coef ti
o = add o 8
xb = mul ti V_MAX_EX
for i ulong ne_ex bound 16
put dst o get vr_ex add xb i
o = add o 1
end
ret o
end

fn vr_rel_write_eq slot ulong e ulong ne_ex ulong dst edit uchar * o ulong to ulong
ei = vr_eq_idx slot e
nt = ulong get vr_eq_nt ei
if or gt nt V_MAX_TERMS gt add add o 3 mul nt add ulong 8 ne_ex len dst
ret ulong 0
end
put dst o get vr_eq_tgt ei
pd0_put_u16 dst add o 1 ushort nt
o = add o 3
for t ulong nt bound 32
o = vr_rel_write_term vr_term_idx slot e t ne_ex dst o
end
ret o
end

fn vr_rel_write slot ulong dst edit uchar * to ulong
nv = ulong get vr_nvars slot
nc = ulong get vr_nch slot
ne_cnt = ulong get vr_neq slot
if or eq nv ulong 0 gt nv V_MAX_VARS
ret ulong 0
end
if or gt nc V_MAX_CHAN ge ulong get vr_nlat slot nv
ret ulong 0
end
if gt ne_cnt V_MAX_EQ
ret ulong 0
end
if lt len dst ulong 10
ret ulong 0
end
put dst 0 uchar nv
put dst 1 get vr_nlat slot
put dst 2 uchar nc
pd0_put_u32 dst ulong 3 get vr_dbits slot
pd0_put_u16 dst ulong 7 get vr_nref slot
put dst 9 uchar ne_cnt
o = ulong 10
ne_ex = add nv nc
for e ulong ne_cnt bound 12
o = vr_rel_write_eq slot e ne_ex dst o
if eq o ulong 0
ret ulong 0
end
end
ret o
end

fn vr_rel_parse_term src view uchar * o ulong ti ulong ne_ex ulong to ulong
put vr_coef ti bitcast long pd0_get_u64 src o
o = add o 8
xb = mul ti V_MAX_EX
for k ulong V_MAX_EX
put vr_ex add xb k uchar 0
end
for i ulong ne_ex bound 16
put vr_ex add xb i get src o
o = add o 1
end
ret o
end

fn vr_rel_parse_eq src view uchar * o ulong slot ulong e ulong ne_ex ulong to ulong
nt = ulong get vr_eq_nt vr_eq_idx slot e
for t ulong nt bound 32
o = vr_rel_parse_term src o vr_term_idx slot e t ne_ex
end
ret o
end

fn vr_rel_parse_one src view uchar * off edit ulong 1 slot ulong e ulong to int
o = get off 0
if lt len src add o 3
ret PD0V_TRUNCATED
end
tgt = ulong get src o
nt = ulong pd0_get_u16 src add o 1
o = add o 3
if ge tgt ulong get vr_nvars slot
ret PD0V_BAD_FIELD
end
if gt nt V_MAX_TERMS
ret PD0V_TOO_LARGE
end
ne_ex = add ulong get vr_nvars slot ulong get vr_nch slot
if lt len src add o mul nt add ulong 8 ne_ex
ret PD0V_TRUNCATED
end
put vr_eq_tgt vr_eq_idx slot e uchar tgt
put vr_eq_nt vr_eq_idx slot e ushort nt
o = vr_rel_parse_eq src o slot e ne_ex
put off 0 o
ret PD0V_OK
end

fn vr_rel_parse src view uchar * slot ulong used edit ulong 1 to int
if lt len src ulong 10
ret PD0V_TRUNCATED
end
vr_clear slot
nv = ulong get src 0
put vr_nvars slot uchar nv
put vr_nlat slot get src 1
put vr_nch slot get src 2
put vr_dbits slot pd0_get_u32 src ulong 3
put vr_nref slot pd0_get_u16 src ulong 7
put vr_neq slot get src 9
if or eq nv ulong 0 gt nv V_MAX_VARS
ret PD0V_BAD_FIELD
end
if or gt ulong get src 2 V_MAX_CHAN ge ulong get src 1 nv
ret PD0V_BAD_FIELD
end
if gt ulong get src 9 V_MAX_EQ
ret PD0V_BAD_FIELD
end
off = new ulong 1 10
for e ulong ulong get src 9 bound 12
rc = vr_rel_parse_one src edit off slot e
if ne rc PD0V_OK
ret rc
end
end
put used 0 get off 0
ret PD0V_OK
end

note ---- Verifier PD0REC1 parse (with PD0V_* codes) ----

fn vr_rec_parse src view uchar * r edit Pd0Rec used edit ulong 1 to int
slen = len src
if lt slen ulong 16
ret PD0V_TRUNCATED
end
if or ne pd0_eq_bytes src ulong 0 V_MAGIC_REC1 ulong 7 1 ne get src 7 uchar 0
ret PD0V_BAD_MAGIC
end
if ne pd0_get_u16 src ulong 8 ushort 1
ret PD0V_BAD_VERSION
end
nobs = get src 10
if or eq nobs uchar 0 gt nobs uchar 4
ret PD0V_BAD_FIELD
end
need = pd0_rec_size nobs
if lt slen need
ret PD0V_TRUNCATED
end
if or gt get src 11 PD0_BUDGET_EXHAUSTED gt get src 12 uchar 1
ret PD0V_BAD_FIELD
end
if ne pd0_rec_decode part src 0 need r 0
ret PD0V_HASH_MISMATCH
end
put used 0 need
ret PD0V_OK
end

note ---- PD0EXP1 schedule hash + codec ----

fn vr_schedule_hash slot ulong dst edit uchar 32 to void
nobs = ulong get ve_nobs slot
nsteps = ulong get ve_nsteps slot
buf = new uchar 256 0
o = ulong 0
rb = mul slot V_MAX_OBS
for i ulong nobs bound 8
pd0_put_u64 edit buf o bitcast ulong get ve_reset add rb i
o = add o 8
end
sb = mul slot V_MAX_STEPS
for s ulong nsteps bound 20
put buf o get ve_step_ch add sb s
o = add o 1
pd0_put_u64 edit buf o bitcast ulong get ve_step_val add sb s
o = add o 8
end
pd0_sha256_hash view buf o dst
ret
end

fn vr_exp_idx slot ulong h ulong s ulong i ulong to ulong
ret add mul add mul add mul slot V_MAX_HYP h V_MAX_STEPS s V_MAX_OBS i
end

fn vr_exp_write_step dst edit uchar * o ulong base ulong no ulong to ulong
for i ulong no bound 8
pd0_put_u64 dst o bitcast ulong get ve_expected add base i
o = add o 8
end
ret o
end

fn vr_exp_write_traj slot ulong dst edit uchar * o ulong to ulong
nh = ulong get ve_nhyp slot
ns = ulong get ve_nsteps slot
no = ulong get ve_nobs slot
for h ulong nh bound 8
for s ulong ns bound 20
o = vr_exp_write_step dst o vr_exp_idx slot h s ulong 0 no
end
end
ret o
end

fn vr_exp_write slot ulong dst edit uchar * to ulong
no = ulong get ve_nobs slot
nh = ulong get ve_nhyp slot
ns = ulong get ve_nsteps slot
if or eq no ulong 0 gt no V_MAX_OBS
ret ulong 0
end
if or eq nh ulong 0 gt nh V_MAX_HYP
ret ulong 0
end
if or eq ns ulong 0 gt ns V_MAX_STEPS
ret ulong 0
end
need = add ulong 56 mul ulong 8 no
need = add need mul ulong 9 ns
need = add need mul ulong 8 mul nh mul ns no
if lt len dst need
ret ulong 0
end
for i ulong 7
put dst i get V_MAGIC_EXP1 i
end
put dst 7 uchar 0
pd0_put_u16 dst ulong 8 ushort 1
put dst 10 uchar no
put dst 11 uchar nh
put dst 12 uchar ns
put dst 13 uchar 0
put dst 14 uchar 0
put dst 15 uchar 0
o = ulong 16
base = mul slot V_MAX_OBS
for i ulong no bound 8
pd0_put_u64 dst o bitcast ulong get ve_reset add base i
o = add o 8
end
base = mul slot V_MAX_STEPS
for s ulong ns bound 20
put dst o get ve_step_ch add base s
o = add o 1
pd0_put_u64 dst o bitcast ulong get ve_step_val add base s
o = add o 8
end
o = vr_exp_write_traj slot dst o
pd0_put_u64 dst o bitcast ulong get ve_div slot
o = add o 8
sh = new uchar 32 0
vr_schedule_hash slot edit sh
base = mul slot PD0_HASH
for k ulong 32
put ve_shash add base k get sh k
put dst add o k get sh k
end
ret add o ulong 32
end

fn vr_exp_parse_step src view uchar * o ulong base ulong no ulong to ulong
for i ulong no bound 8
put ve_expected add base i bitcast long pd0_get_u64 src o
o = add o 8
end
ret o
end

fn vr_exp_parse_traj src view uchar * o ulong slot ulong to ulong
nh = ulong get ve_nhyp slot
ns = ulong get ve_nsteps slot
no = ulong get ve_nobs slot
for h ulong nh bound 8
for s ulong ns bound 20
o = vr_exp_parse_step src o vr_exp_idx slot h s ulong 0 no
end
end
ret o
end

fn vr_exp_parse src view uchar * slot ulong used edit ulong 1 to int
slen = len src
if lt slen ulong 16
ret PD0V_TRUNCATED
end
if or ne pd0_eq_bytes src ulong 0 V_MAGIC_EXP1 ulong 7 1 ne get src 7 uchar 0
ret PD0V_BAD_MAGIC
end
if ne pd0_get_u16 src ulong 8 ushort 1
ret PD0V_BAD_VERSION
end
no = ulong get src 10
nh = ulong get src 11
ns = ulong get src 12
if or eq no ulong 0 gt no V_MAX_OBS
ret PD0V_BAD_FIELD
end
if or eq nh ulong 0 gt nh V_MAX_HYP
ret PD0V_BAD_FIELD
end
if or eq ns ulong 0 gt ns V_MAX_STEPS
ret PD0V_BAD_FIELD
end
need = add ulong 56 mul ulong 8 no
need = add need mul ulong 9 ns
need = add need mul ulong 8 mul nh mul ns no
if lt len src need
ret PD0V_TRUNCATED
end
put ve_nobs slot uchar no
put ve_nhyp slot uchar nh
put ve_nsteps slot uchar ns
o = ulong 16
base = mul slot V_MAX_OBS
for i ulong no bound 8
put ve_reset add base i bitcast long pd0_get_u64 src o
o = add o 8
end
base = mul slot V_MAX_STEPS
for s ulong ns bound 20
put ve_step_ch add base s get src o
o = add o 1
put ve_step_val add base s bitcast long pd0_get_u64 src o
o = add o 8
end
o = vr_exp_parse_traj src o slot
put ve_div slot bitcast long pd0_get_u64 src o
o = add o 8
sh = new uchar 32 0
vr_schedule_hash slot edit sh
base = mul slot PD0_HASH
for k ulong 32
if ne get sh k get src add o k
ret PD0V_HASH_MISMATCH
end
put ve_shash add base k get sh k
end
put used 0 add o ulong 32
ret PD0V_OK
end

note ---- PD0LEDG1 ledger append & next ----

fn vr_ledg_append buf edit uchar * blen_kind ulong payload view uchar * last_h edit uchar 32 to ulong
o = shr blen_kind 8
kind = uchar and blen_kind ulong 255
plen = len payload
if or gt add add o PD0_LEDG_HDR add plen PD0_LEDG_TRAILER len buf gt kind LEDG_BATCH
ret ulong 0
end
for i ulong 8
put buf add o i get V_MAGIC_LEDG1 i
end
pd0_put_u16 buf add o 8 ushort 1
put buf add o 10 kind
put buf add o 11 uchar 0
pd0_put_u32 buf add o 12 uint plen
for i ulong plen bound 8192
put buf add add o PD0_LEDG_HDR i get payload i
end
poff = add add o PD0_LEDG_HDR plen
for k ulong 32
put buf add poff k get last_h k
end
h = new uchar 32 0
hlen = add add PD0_LEDG_HDR plen PD0_HASH
pd0_sha256_hash part buf o hlen hlen edit h
for k ulong 32
put buf add add poff PD0_HASH k get h k
put last_h k get h k
end
ret add poff PD0_LEDG_TRAILER
end

fn vr_ledg_next buf view uchar * off edit ulong 1 exp_prev view uchar 32 out_meta edit ulong 2 out_hash edit uchar 32 to int
o = get off 0
if lt sub len buf o PD0_LEDG_HDR
ret PD0V_TRUNCATED
end
if ne pd0_eq_bytes buf o V_MAGIC_LEDG1 ulong 8 1
ret PD0V_BAD_MAGIC
end
if ne pd0_get_u16 buf add o 8 ushort 1
ret PD0V_BAD_VERSION
end
if gt get buf add o 10 LEDG_BATCH
ret PD0V_BAD_FIELD
end
plen = ulong pd0_get_u32 buf add o 12
if lt sub len buf o add add PD0_LEDG_HDR plen PD0_LEDG_TRAILER
ret PD0V_TRUNCATED
end
poff = add add o PD0_LEDG_HDR plen
for k ulong 32
if ne get buf add poff k get exp_prev k
ret PD0V_CHAIN_BROKEN
end
end
h = new uchar 32 0
hlen = add add PD0_LEDG_HDR plen PD0_HASH
pd0_sha256_hash part buf o hlen hlen edit h
for k ulong 32
if ne get h k get buf add add poff PD0_HASH k
ret PD0V_HASH_MISMATCH
end
put out_hash k get h k
end
put out_meta 0 ulong get buf add o 10
put out_meta 1 plen
put off 0 add poff PD0_LEDG_TRAILER
ret PD0V_OK
end

note ---- Extended verifier codecs: tag, corr, falsifier, batch, domain, PDLAW1, rollout ----

fn vr_exp_copy_exp dst ulong src ulong to void
eb_d = mul dst ulong 1280
eb_s = mul src ulong 1280
for k ulong 1280
put ve_expected add eb_d k get ve_expected add eb_s k
end
ret
end

fn vr_exp_copy_steps dst ulong src ulong to void
bd = mul dst V_MAX_STEPS
bs = mul src V_MAX_STEPS
for q ulong V_MAX_STEPS
put ve_step_ch add bd q get ve_step_ch add bs q
put ve_step_val add bd q get ve_step_val add bs q
end
ret
end

fn vr_exp_copy dst ulong src ulong to void
put ve_nobs dst get ve_nobs src
put ve_nhyp dst get ve_nhyp src
put ve_nsteps dst get ve_nsteps src
put ve_div dst get ve_div src
dr = mul dst V_MAX_OBS
sr = mul src V_MAX_OBS
for i ulong V_MAX_OBS
put ve_reset add dr i get ve_reset add sr i
end
dh = mul dst PD0_HASH
sh = mul src PD0_HASH
for k ulong 32
put ve_shash add dh k get ve_shash add sh k
end
vr_exp_copy_steps dst src
vr_exp_copy_exp dst src
ret
end

fn vr_schedule_hash_raw nobs ulong rst view long 8 nsteps ulong chs view uchar 20 vals view long 20 dst edit uchar 32 to void
buf = new uchar 256 0
o = ulong 0
for i ulong nobs bound 8
pd0_put_u64 edit buf o bitcast ulong get rst i
o = add o 8
end
for s ulong nsteps bound 20
put buf o get chs s
o = add o 1
pd0_put_u64 edit buf o bitcast ulong get vals s
o = add o 8
end
pd0_sha256_hash view buf o dst
ret
end

fn vr_roll_store dst edit long 160 s ulong no ulong nx view long 12 to void
for j ulong no bound 8
put dst add mul s no j get nx j
end
ret
end

note rollout of relation slot along (chs, vals); writes the observed variables of each step (C pd0_rel_rollout_fn)
fn vr_rel_rollout slot ulong init view long 8 chs view uchar 20 vals view long 20 n ulong dst edit long 160 to void
no = sub ulong get vr_nvars slot ulong get vr_nlat slot
st = new long 12 0
nx = new long 12 0
for j ulong no bound 8
put st j get init j
end
for s ulong n bound 20
vr_rel_step slot view st get chs s get vals s edit nx
vr_roll_store dst s no view nx
for j ulong 12
put st j get nx j
end
end
ret
end


fn vr_tag_write ep uint tag uchar batch uint orig uchar dst edit uchar * to ulong
pd0_put_u32 dst ulong 0 ep
put dst 4 tag
pd0_put_u32 dst ulong 5 batch
put dst 9 orig
ret ulong 10
end

fn vr_tag_parse src view uchar * out_ep edit uint 2 out_to edit uchar 2 to int
if ne len src ulong 10
ret PD0V_TRUNCATED
end
tg = get src 4
og = get src 9
if or gt tg TAG_REP gt og uchar 1
ret PD0V_BAD_FIELD
end
put out_ep 0 pd0_get_u32 src ulong 0
put out_ep 1 pd0_get_u32 src ulong 5
put out_to 0 tg
put out_to 1 og
ret PD0V_OK
end

fn vr_corr_write m view long 8 dst edit uchar * to ulong
note m = var_a, var_b, n, r_micro, p_micro, n_pairs, n_shuffles, shuffle_seed (bit pattern)
put dst 0 uchar get m 0
put dst 1 uchar get m 1
pd0_put_u32 dst ulong 2 uint get m 2
pd0_put_u64 dst ulong 6 bitcast ulong get m 3
pd0_put_u64 dst ulong 14 bitcast ulong get m 4
pd0_put_u32 dst ulong 22 uint get m 5
pd0_put_u32 dst ulong 26 uint get m 6
pd0_put_u64 dst ulong 30 bitcast ulong get m 7
ret ulong 38
end

fn vr_corr_parse src view uchar * out_v edit uchar 2 out_i edit long 2 out_u edit ulong 4 to int
if ne len src ulong 38
ret PD0V_TRUNCATED
end
put out_v 0 get src 0
put out_v 1 get src 1
put out_u 0 ulong pd0_get_u32 src ulong 2
put out_i 0 bitcast long pd0_get_u64 src ulong 6
put out_i 1 bitcast long pd0_get_u64 src ulong 14
put out_u 1 ulong pd0_get_u32 src ulong 22
put out_u 2 ulong pd0_get_u32 src ulong 26
put out_u 3 pd0_get_u64 src ulong 30
ret PD0V_OK
end

fn vr_fals_write cand view uchar 32 nriv uchar rivs view uchar 256 m view long 2 dst edit uchar * to ulong
note m = eps_micro, min_trials
for k ulong 32
put dst k get cand k
end
p = ulong 32
put dst p nriv
p = add p 1
for r ulong ulong nriv bound 8
for k ulong 32
put dst p get rivs add mul r 32 k
p = add p 1
end
end
pd0_put_u64 dst p bitcast ulong get m 0
p = add p 8
pd0_put_u32 dst p uint get m 1
ret add p 4
end

fn vr_fals_parse src view uchar * cand edit uchar 32 rivs edit uchar 256 out_meta edit long 3 to int
slen = len src
if lt slen ulong 33
ret PD0V_TRUNCATED
end
for k ulong 32
put cand k get src k
end
nr = ulong get src 32
if gt nr ulong 7
ret PD0V_BAD_FIELD
end
p = ulong 33
if ne slen add add p mul nr ulong 32 ulong 12
ret PD0V_TRUNCATED
end
for r ulong nr bound 8
for k ulong 32
put rivs add mul r 32 k get src p
p = add p 1
end
end
put out_meta 0 long nr
put out_meta 1 bitcast long pd0_get_u64 src p
p = add p 8
put out_meta 2 long pd0_get_u32 src p
ret PD0V_OK
end

fn vr_batch_write bid uint seed ulong nep uint dst edit uchar * to ulong
pd0_put_u32 dst ulong 0 bid
pd0_put_u64 dst ulong 4 seed
pd0_put_u32 dst ulong 12 nep
ret ulong 16
end

fn vr_batch_parse src view uchar * out_b edit ulong 3 to int
if ne len src ulong 16
ret PD0V_TRUNCATED
end
put out_b 0 ulong pd0_get_u32 src ulong 0
put out_b 1 pd0_get_u64 src ulong 4
put out_b 2 ulong pd0_get_u32 src ulong 12
ret PD0V_OK
end

note ---- Verifier PDLAW1 domain + law codec ----

fn vl_clear slot ulong rel_slot ulong to void
put vl_state slot uchar 0
put vl_rel_slot slot rel_slot
put vl_dom_nobs slot uchar 0
put vl_dom_nch slot uchar 0
put vl_dom_dt slot long 0
put vl_dom_nobs_cnt slot ulong 0
put vl_dom_nep_cnt slot uint 0
put vl_dom_rmin slot long 0
put vl_dom_rmax slot long 0
put vl_dom_eplen slot uint 0
put vl_dom_latr slot long 0
put vl_conf_ppm slot uint 0
put vl_n_exc slot uint 0
put vl_n_exp slot uint 0
put vl_claim_len slot uint 0
ob = mul slot V_MAX_OBS
for i ulong V_MAX_OBS
put vl_dom_vmin add ob i long 0
put vl_dom_vmax add ob i long 0
end
cb = mul slot V_MAX_CHAN
for i ulong V_MAX_CHAN
put vl_dom_cmin add cb i long 0
put vl_dom_cmax add cb i long 0
end
hb = mul slot PD0_HASH
for k ulong 32
put vl_law_id add hb k uchar 0
put vl_chain_root add hb k uchar 0
end
ret
end

fn vr_dom_write slot ulong dst edit uchar * o ulong to ulong
no = ulong get vl_dom_nobs slot
nc = ulong get vl_dom_nch slot
put dst o uchar no
put dst add o 1 uchar nc
o = add o 2
ob = mul slot V_MAX_OBS
for i ulong no bound 8
pd0_put_u64 dst o bitcast ulong get vl_dom_vmin add ob i
o = add o 8
pd0_put_u64 dst o bitcast ulong get vl_dom_vmax add ob i
o = add o 8
end
cb = mul slot V_MAX_CHAN
for i ulong nc bound 4
pd0_put_u64 dst o bitcast ulong get vl_dom_cmin add cb i
o = add o 8
pd0_put_u64 dst o bitcast ulong get vl_dom_cmax add cb i
o = add o 8
end
pd0_put_u64 dst o bitcast ulong get vl_dom_dt slot
o = add o 8
pd0_put_u64 dst o get vl_dom_nobs_cnt slot
o = add o 8
pd0_put_u32 dst o get vl_dom_nep_cnt slot
o = add o 4
pd0_put_u64 dst o bitcast ulong get vl_dom_rmin slot
o = add o 8
pd0_put_u64 dst o bitcast ulong get vl_dom_rmax slot
o = add o 8
pd0_put_u32 dst o get vl_dom_eplen slot
o = add o 4
pd0_put_u64 dst o bitcast ulong get vl_dom_latr slot
ret add o 8
end

fn vr_dom_parse_ranges src view uchar * p ulong slot ulong to ulong
no = ulong get vl_dom_nobs slot
nc = ulong get vl_dom_nch slot
ob = mul slot V_MAX_OBS
for i ulong no bound 8
put vl_dom_vmin add ob i bitcast long pd0_get_u64 src p
put vl_dom_vmax add ob i bitcast long pd0_get_u64 src add p 8
p = add p 16
end
cb = mul slot V_MAX_CHAN
for i ulong nc bound 4
put vl_dom_cmin add cb i bitcast long pd0_get_u64 src p
put vl_dom_cmax add cb i bitcast long pd0_get_u64 src add p 8
p = add p 16
end
ret p
end

fn vr_dom_parse_tail src view uchar * p ulong slot ulong to ulong
put vl_dom_dt slot bitcast long pd0_get_u64 src p
put vl_dom_nobs_cnt slot pd0_get_u64 src add p 8
put vl_dom_nep_cnt slot pd0_get_u32 src add p 16
put vl_dom_rmin slot bitcast long pd0_get_u64 src add p 20
put vl_dom_rmax slot bitcast long pd0_get_u64 src add p 28
put vl_dom_eplen slot pd0_get_u32 src add p 36
put vl_dom_latr slot bitcast long pd0_get_u64 src add p 40
ret add p 48
end

fn vr_dom_parse src view uchar * o ulong slot ulong used edit ulong 1 to int
slen = len src
if lt sub slen o ulong 2
ret PD0V_TRUNCATED
end
no = ulong get src o
nc = ulong get src add o 1
if or eq no ulong 0 or gt no V_MAX_OBS gt nc V_MAX_CHAN
ret PD0V_BAD_FIELD
end
need = add add ulong 50 mul ulong 16 no mul ulong 16 nc
if lt sub slen o need
ret PD0V_TRUNCATED
end
put vl_dom_nobs slot uchar no
put vl_dom_nch slot uchar nc
p = vr_dom_parse_ranges src add o 2 slot
p = vr_dom_parse_tail src p slot
put used 0 sub p o
ret PD0V_OK
end

fn vl_write_exc slot ulong dst edit uchar * o ulong to ulong
nexc = ulong get vl_n_exc slot
pd0_put_u16 dst o ushort nexc
o = add o 2
eb = mul slot VL_MAX_EXC
for k ulong nexc bound 64
ei = add eb k
pd0_put_u64 dst o get vl_exc_seq ei
o = add o 8
hb = mul ei PD0_HASH
for j ulong 32
put dst o get vl_exc_hash add hb j
o = add o 1
end
pd0_put_u64 dst o bitcast ulong get vl_exc_pred ei
o = add o 8
pd0_put_u64 dst o bitcast ulong get vl_exc_obs ei
o = add o 8
pd0_put_u64 dst o bitcast ulong get vl_exc_err ei
o = add o 8
end
ret o
end

fn vl_write_exp slot ulong dst edit uchar * o ulong to ulong
nexp = ulong get vl_n_exp slot
pd0_put_u16 dst o ushort nexp
o = add o 2
eb = mul slot VL_MAX_EXP
for k ulong nexp bound 64
ei = add eb k
hb = mul ei PD0_HASH
for j ulong 32
put dst o get vl_exp_id add hb j
o = add o 1
end
put dst o get vl_exp_kind ei
o = add o 1
for j ulong 32
put dst o get vl_exp_pre add hb j
o = add o 1
end
for j ulong 32
put dst o get vl_exp_out add hb j
o = add o 1
end
put dst o get vl_exp_res ei
o = add o 1
pd0_put_u64 dst o get vl_exp_fseq ei
o = add o 8
pd0_put_u64 dst o get vl_exp_lseq ei
o = add o 8
end
ret o
end

fn vl_write_head slot ulong dst edit uchar * to ulong
cap = len dst
for i ulong 6
put dst i get V_MAGIC_LAW1 i
end
put dst 6 uchar 0
put dst 7 uchar 0
pd0_put_u16 dst ulong 8 ushort 1
put dst 10 get vl_state slot
for k ulong 32
put dst add ulong 11 k uchar 0
end
o = ulong 43
rn = vr_rel_write get vl_rel_slot slot part dst o sub cap o
if eq rn ulong 0
ret ulong 0
end
o = add o rn
if lt cap add o ulong 400
ret ulong 0
end
o = vr_dom_write slot dst o
pd0_put_u32 dst o get vl_conf_ppm slot
ret add o 4
end

fn vl_write_tail slot ulong dst edit uchar * o ulong to ulong
o = vl_write_exc slot dst o
o = vl_write_exp slot dst o
hb = mul slot PD0_HASH
for k ulong 32
put dst o get vl_chain_root add hb k
o = add o 1
end
clen = ulong get vl_claim_len slot
pd0_put_u16 dst o ushort clen
o = add o 2
cb = mul slot VL_MAX_CLAIM
for k ulong clen bound 512
put dst o get vl_claim add cb k
o = add o 1
end
ret o
end

fn vr_law_write slot ulong dst edit uchar * to ulong
cap = len dst
nexc = ulong get vl_n_exc slot
nexp = ulong get vl_n_exp slot
clen = ulong get vl_claim_len slot
if or lt cap ulong 43 or gt nexc VL_MAX_EXC or gt nexp VL_MAX_EXP gt clen VL_MAX_CLAIM
ret ulong 0
end
o = vl_write_head slot dst
if eq o ulong 0
ret ulong 0
end
note C checks cap < o + n_exc*64 + n_exp*115 + 40 + claim_len after the 2-byte exception count
need_tail = add add add mul nexc ulong 64 mul nexp ulong 115 ulong 42 clen
if lt cap add o need_tail
ret ulong 0
end
o = vl_write_tail slot dst o
h = new uchar 32 0
pd0_sha256_hash view dst o edit h
hb = mul slot PD0_HASH
for k ulong 32
put vl_law_id add hb k get h k
put dst add ulong 11 k get h k
end
ret o
end

fn vl_parse_exc src view uchar * o ulong slot ulong nexc ulong to ulong
eb = mul slot VL_MAX_EXC
for k ulong nexc bound 64
ei = add eb k
put vl_exc_seq ei pd0_get_u64 src o
o = add o 8
hb = mul ei PD0_HASH
for j ulong 32
put vl_exc_hash add hb j get src o
o = add o 1
end
put vl_exc_pred ei bitcast long pd0_get_u64 src o
o = add o 8
put vl_exc_obs ei bitcast long pd0_get_u64 src o
o = add o 8
put vl_exc_err ei bitcast long pd0_get_u64 src o
o = add o 8
end
ret o
end

fn vl_parse_exp_hashes src view uchar * o ulong ei ulong to ulong
hb = mul ei PD0_HASH
for j ulong 32
put vl_exp_id add hb j get src o
put vl_exp_pre add hb j get src add o 33
put vl_exp_out add hb j get src add o 65
o = add o 1
end
ret add o 65
end

fn vl_parse_exp src view uchar * o ulong slot ulong nexp ulong bad edit int 1 to ulong
eb = mul slot VL_MAX_EXP
for k ulong nexp bound 64
ei = add eb k
kd = get src add o 32
put vl_exp_kind ei kd
o = vl_parse_exp_hashes src o ei
rs = get src o
put vl_exp_res ei rs
o = add o 1
put vl_exp_fseq ei pd0_get_u64 src o
put vl_exp_lseq ei pd0_get_u64 src add o 8
o = add o 16
if or gt kd uchar 1 gt rs uchar 1
put bad 0 1
ret o
end
end
ret o
end

fn vl_verify_law_id src view uchar * total ulong slot ulong to int
if gt total ulong 4096
ret PD0V_TOO_LARGE
end
tmp = new uchar 4096 0
for i ulong total bound 4096
put tmp i get src i
end
for k ulong 32
put tmp add ulong 11 k uchar 0
end
h = new uchar 32 0
pd0_sha256_hash view tmp total edit h
hb = mul slot PD0_HASH
for k ulong 32
if ne get h k get vl_law_id add hb k
ret PD0V_LAW_ID_MISMATCH
end
end
ret PD0V_OK
end

fn vl_parse_head src view uchar * slot ulong rel_slot ulong used edit ulong 1 to int
slen = len src
if lt slen ulong 43
ret PD0V_TRUNCATED
end
if or ne pd0_eq_bytes src ulong 0 V_MAGIC_LAW1 ulong 6 1 or ne get src 6 uchar 0 ne get src 7 uchar 0
ret PD0V_BAD_MAGIC
end
if ne pd0_get_u16 src ulong 8 ushort 1
ret PD0V_BAD_VERSION
end
vl_clear slot rel_slot
st = get src 10
if gt st PD0_LAW_PROVISIONAL
ret PD0V_BAD_FIELD
end
put vl_state slot st
hb = mul slot PD0_HASH
for k ulong 32
put vl_law_id add hb k get src add ulong 11 k
end
o = ulong 43
u = new ulong 1 0
rc = vr_rel_parse part src o sub slen o rel_slot edit u
if ne rc PD0V_OK
ret rc
end
o = add o get u 0
rc = vr_dom_parse src o slot edit u
if ne rc PD0V_OK
ret rc
end
put used 0 add o get u 0
ret PD0V_OK
end

fn vl_parse_exc_block src view uchar * slot ulong used edit ulong 1 to int
slen = len src
o = get used 0
if lt slen add o 6
ret PD0V_TRUNCATED
end
conf = pd0_get_u32 src o
nexc = ulong pd0_get_u16 src add o 4
o = add o 6
if gt conf uint 1000000
ret PD0V_BAD_FIELD
end
if gt nexc VL_MAX_EXC
ret PD0V_TOO_LARGE
end
if lt slen add add o mul nexc ulong 64 ulong 2
ret PD0V_TRUNCATED
end
put vl_conf_ppm slot conf
put vl_n_exc slot uint nexc
put used 0 vl_parse_exc src o slot nexc
ret PD0V_OK
end

fn vl_parse_exp_block src view uchar * slot ulong used edit ulong 1 to int
slen = len src
o = get used 0
nexp = ulong pd0_get_u16 src o
o = add o 2
if gt nexp VL_MAX_EXP
ret PD0V_TOO_LARGE
end
if lt slen add add o mul nexp ulong 115 ulong 34
ret PD0V_TRUNCATED
end
put vl_n_exp slot uint nexp
bad = new int 1 0
o = vl_parse_exp src o slot nexp edit bad
if ne get bad 0 0
ret PD0V_BAD_FIELD
end
put used 0 o
ret PD0V_OK
end

fn vl_parse_claim src view uchar * slot ulong used edit ulong 1 to int
slen = len src
o = get used 0
hb = mul slot PD0_HASH
for k ulong 32
put vl_chain_root add hb k get src add o k
end
o = add o 32
clen = ulong pd0_get_u16 src o
o = add o 2
if gt clen VL_MAX_CLAIM
ret PD0V_TOO_LARGE
end
if lt slen add o clen
ret PD0V_TRUNCATED
end
put vl_claim_len slot uint clen
cb = mul slot VL_MAX_CLAIM
for k ulong clen bound 512
put vl_claim add cb k get src add o k
end
put used 0 add o clen
ret PD0V_OK
end

note PDLAW1 parse into law slot (relation into rel_slot); verifies law_id over the canonical bytes (C pd0_law_parse)
fn vr_law_parse src view uchar * slot ulong rel_slot ulong to int
u = new ulong 1 0
rc = vl_parse_head src slot rel_slot edit u
if ne rc PD0V_OK
ret rc
end
rc = vl_parse_exc_block src slot edit u
if ne rc PD0V_OK
ret rc
end
rc = vl_parse_exp_block src slot edit u
if ne rc PD0V_OK
ret rc
end
rc = vl_parse_claim src slot edit u
if ne rc PD0V_OK
ret rc
end
ret vl_verify_law_id src get u 0 slot
end

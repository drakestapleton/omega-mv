note SPDX-License-Identifier: Apache-2.0
note src/physics0/controls/pd0_receipt.om: Append-only O_EXCL verifier receipt writer.
note A receipt is never overwritten: <dir>/<kind>-<16 hex of input_hash>-<n>.receipt, n counted up from 0.
note The build prepends PD0_VERIFIER_COMMIT (text, the short commit) the way the C build passed -DPD0_VERIFIER_COMMIT.

text REC_SL "/"
text REC_DA "-"
text REC_EXT ".receipt"
text REC_K1 "kind: "
text REC_K1C "\nverifier_commit: "
text REC_K1H "\ninput_sha256: "
text REC_K2 "\ncode: "
text REC_K2N "\nname: "
text REC_K3 "\nrecorder: STAND_IN\nrange_check: STAND_IN\n"

text REC_HEX "0123456789abcdef"

global rc_dir uchar 512
global rc_dir_len ulong 1
global rc_hex uchar 64

fn pd0_receipt_dir d view uchar * to void
n = len d
if gt n ulong 511
n = ulong 511
end
for i ulong n bound 512
put rc_dir i get d i
end
put rc_dir_len 0 n
ret
end

fn rc_path_dir path edit uchar 1024 to ulong
p = ulong 0
n = get rc_dir_len 0
for i ulong n bound 512
put path p get rc_dir i
p = add p 1
end
ret p
end

fn rc_body body edit uchar 4096 kind view uchar * code int extra view uchar * to ulong
bp = pd0_buf_str edit body ulong 0 ulong 4096 REC_K1
bp = pd0_buf_str edit body bp ulong 4096 kind
bp = pd0_buf_str edit body bp ulong 4096 REC_K1C
bp = pd0_buf_str edit body bp ulong 4096 PD0_VERIFIER_COMMIT
bp = pd0_buf_str edit body bp ulong 4096 REC_K1H
for i ulong 64
bp = pd0_buf_ch edit body bp ulong 4096 get rc_hex i
end
bp = pd0_buf_str edit body bp ulong 4096 REC_K2
bp = pd0_buf_i64 edit body bp ulong 4096 long code
bp = pd0_buf_str edit body bp ulong 4096 REC_K2N
bp = pd0v_name_buf edit body bp ulong 4096 code
bp = pd0_buf_str edit body bp ulong 4096 REC_K3
el = len extra
if gt el ulong 0
bp = pd0_buf_str edit body bp ulong 4096 extra
if ne get extra sub el 1 uchar 10
bp = pd0_buf_ch edit body bp ulong 4096 uchar 10
end
end
ret bp
end

fn rc_path path edit uchar 1024 kind view uchar * n ulong to ulong
p = rc_path_dir edit path
p = pd0_buf_str edit path p ulong 1023 REC_SL
p = pd0_buf_str edit path p ulong 1023 kind
p = pd0_buf_str edit path p ulong 1023 REC_DA
for i ulong 16
p = pd0_buf_ch edit path p ulong 1023 get rc_hex i
end
p = pd0_buf_str edit path p ulong 1023 REC_DA
p = pd0_buf_u64 edit path p ulong 1023 n
ret pd0_buf_str edit path p ulong 1023 REC_EXT
end

note extra: appended after the fixed lines; a newline is added when it does not end with one (empty = none)
fn pd0_receipt_write kind view uchar * h view uchar 32 code int extra view uchar * to int
for i ulong 32
b = get h i
put rc_hex mul i 2 get REC_HEX ulong shr b 4
put rc_hex add mul i 2 1 get REC_HEX ulong and b uchar 15
end
path = new uchar 1024 0
body = new uchar 4096 0
for n ulong 100000
p = rc_path edit path kind n
note O_WRONLY|O_CREAT|O_EXCL = 1|64|128 = 193, mode 0444 = 292
fd = fopen path 0 p int 193 int 292
if ge fd long 0
bp = rc_body edit body kind code extra
w = write int fd body 0 bp
c = fclose int fd
if ne w long bp
ret PD0V_RECEIPT_IO
end
ret 0
end
if ne fd long -17
ret PD0V_RECEIPT_IO
end
end
ret PD0V_RECEIPT_IO
end

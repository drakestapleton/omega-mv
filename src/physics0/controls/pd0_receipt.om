note SPDX-License-Identifier: Apache-2.0
note src/physics0/controls/pd0_receipt.om: Append-only O_EXCL verifier receipt writer.

text REC_SL "/"
text REC_DA "-"
text REC_EXT ".receipt"
text REC_K1 "kind: "
text REC_K2 "\ncode: "
text REC_K3 "\nrecorder: STAND_IN\nrange_check: STAND_IN\n"

text REC_HEX "0123456789abcdef"

fn pd0_receipt_write dir view uchar * kind view uchar * h view uchar 32 code int to int
hex = new uchar 16 0
for i ulong 8
b = get h i
put hex mul i 2 get REC_HEX ulong shr b 4
put hex add mul i 2 1 get REC_HEX ulong and b uchar 15
end
path = new uchar 512 0
body = new uchar 512 0
for n ulong 1000
p = ulong 0
p = pd0_buf_str edit path p ulong 512 dir
p = pd0_buf_str edit path p ulong 512 REC_SL
p = pd0_buf_str edit path p ulong 512 kind
p = pd0_buf_str edit path p ulong 512 REC_DA
for i ulong 16
p = pd0_buf_ch edit path p ulong 512 get hex i
end
p = pd0_buf_str edit path p ulong 512 REC_DA
p = pd0_buf_u64 edit path p ulong 512 n
p = pd0_buf_str edit path p ulong 512 REC_EXT
note O_WRONLY|O_CREAT|O_EXCL = 1|64|128 = 193, mode 0444 = 292
fd = fopen path 0 p int 193 int 292
if ge fd long 0
bp = ulong 0
bp = pd0_buf_str edit body bp ulong 512 REC_K1
bp = pd0_buf_str edit body bp ulong 512 kind
bp = pd0_buf_str edit body bp ulong 512 REC_K2
bp = pd0_buf_i64 edit body bp ulong 512 long code
bp = pd0_buf_str edit body bp ulong 512 REC_K3
w = write int fd body 0 bp
c = fclose int fd
if ne w long bp
ret PD0V_RECEIPT_IO
end
ret 0
end
if ne fd long -17
ret PD0V_RECEIPT_IO
end
end
ret PD0V_RECEIPT_IO
end

note src/physics0/pd0_types.om: PD-0 core constants, structs, FIPS 180-4 SHA-256, and math/format helpers.
note Learner-side safe: no generator, no world, no file I/O.

const PD0_MAX_OBS ulong 4
const PD0_MAX_CH ulong 2
const PD0_MAX_LATENT ulong 2
const PD0_MAX_VARS ulong 6
const PD0_MAX_EX ulong 8
const PD0_MAX_TERMS ulong 12
const PD0_MAX_DEG ulong 3
const PD0_SCHED_STEPS ulong 20
const PD0_HASH ulong 32
const PD0_CH_NONE uchar 255
const PD0_MICRO long 1000000
const PD0_IH_SD long 577350
const PD0_BOUND long 10000000
const PD0_EPISODE_STEPS uint 100
const PD0_L6_REDRAW_CAP int 1000

const PD0_OK uchar 0
const PD0_REFUSED_RANGE uchar 1
const PD0_OUT_OF_BOUNDS uchar 2
const PD0_EPISODE_END uchar 3
const PD0_BUDGET_EXHAUSTED uchar 4

const PD0_KIND_RESET uchar 0
const PD0_KIND_STEP uchar 1

const PD0_OP_DESCRIBE uchar 0
const PD0_OP_RESET uchar 1
const PD0_OP_STEP uchar 2
const PD0_OP_SCORE uchar 3
const PD0_OP_SHAPE uchar 4
const PD0_OP_FINAL uchar 5
const PD0_OP_AUDIT uchar 6

const PD0_AUDIT_RESP_SIZE ulong 57
const PD0_SCORE_STEPS_MAX ulong 100
const PD0_DESC_REFUSED_V1 int -2

const PD0_L0 int 0
const PD0_L1 int 1
const PD0_L2 int 2
const PD0_L3 int 3
const PD0_L4 int 4
const PD0_L5 int 5
const PD0_L6 int 6

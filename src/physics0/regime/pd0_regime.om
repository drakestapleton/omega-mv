note SPDX-License-Identifier: Apache-2.0
note src/physics0/regime/pd0_regime.om: PD-0 dev-only regime switch (world-side).

fn p0reg_rel_ppm o long nv long to long
d = sub nv o
if lt d long 0
d = neg d
end
ao = o
if lt ao long 0
ao = neg ao
end
if ne ao long 0
ret long div mul f64 d 1000000.0f64 f64 ao
end
ret long 0
end

fn p0reg_max_diff g view Pd0Gen ng view Pd0Gen nc ulong to long
worst = long 0
for i ulong nc bound 4
ppm = p0reg_rel_ppm get g k i get ng k i
if gt ppm worst
worst = ppm
end
end
ret worst
end

fn p0reg_copy_gen g edit Pd0Gen ng view Pd0Gen to void
put g level get ng level
for i ulong 4
put g k i get ng k i
end
put g sigma_obs get ng sigma_obs
put g sigma_null get ng sigma_null
put g n_hidden get ng n_hidden
put g redraws get ng redraws
put g invalid get ng invalid
ret
end

fn pd0_world_switch_regime w edit Pd0World g edit Pd0Gen level int regime uint max_ppm edit long 1 to int
if eq regime uint 0
ret -1
end
ng = new Pd0Gen 0 0 0 0 0 0 0
nc = ulong pd0_gen_const_count level
for attempt ulong 16
s = xor get w seed mul add ulong regime mul attempt ulong 977 ulong 0x9e3779b97f4a7c15
if ne pd0_gen_init edit ng level s 0
continue
end
put max_ppm 0 p0reg_max_diff view g view ng nc
p0reg_copy_gen g view ng
put w in_episode 0
put w steps_used uint 0
put w episodes_used uint 0
ret 0
end
ret -1
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Alignment Navigation System (ANS) core logic:
note component mapping, reference validation, drift/total norm, autonomy tier
note control law, promotion gate decision, record checks, and header/f64 canon.
om2

fn ans_is_fin bits ulong to bool
  ret lt and bits 0x7ff0000000000000 0x7ff0000000000000
end

fn ans_is_pos_fin bits ulong to bool
  if not ans_is_fin bits
    ret false
  end
  v = bitcast f64 bits
  z = bitcast f64 ulong 0
  ret gt v z
end

export fn ans_om_component_atom comp ulong to ulong
  m = rem comp 4
  if eq m 0
    ret 7
  end
  if eq m 1
    ret 1
  end
  if eq m 2
    ret 3
  end
  ret 2
end

export fn ans_om_validate_ref version ulong vals view ulong 23 to long
  if eq version 0
    ret -2
  end
  for i ulong 23
    if not ans_is_pos_fin get vals i
      ret -2
    end
  end
  r_imu = bitcast f64 get vals 15
  r_ref = bitcast f64 get vals 16
  r_fix = bitcast f64 get vals 17
  if or ge r_fix r_ref ge r_ref r_imu
    ret -2
  end
  t0 = bitcast f64 get vals 18
  t1 = bitcast f64 get vals 19
  t2 = bitcast f64 get vals 20
  if or ge t0 t1 ge t1 t2
    ret -2
  end
  ret 0
end

export fn ans_om_drift x view ulong 4 p_diag view ulong 4 out_vals edit ulong 3 to long
  ss = bitcast f64 ulong 0
  tr = bitcast f64 ulong 0
  for i ulong 4
    xi = bitcast f64 get x i
    pi = bitcast f64 get p_diag i
    ss = add ss mul xi xi
    tr = add tr pi
  end
  ss_b = bitcast ulong ss
  tr_b = bitcast ulong tr
  z = bitcast f64 ulong 0
  if or not ans_is_fin ss_b or not ans_is_fin tr_b lt tr z
    ret -3
  end
  mn = fsqrt ss
  sg = fsqrt tr
  dd = fsqrt add mul mn mn mul sg sg
  put out_vals 0 bitcast ulong mn
  put out_vals 1 bitcast ulong sg
  put out_vals 2 bitcast ulong dd
  ret 0
end

export fn ans_om_autonomy_tier x view ulong 4 limits view ulong 4 tsig view ulong 3 sigma_bits ulong disagreement ulong to ulong
  sg = bitcast f64 sigma_bits
  t = ulong 0
  if ge sg bitcast f64 get tsig 2
    t = 3
  else
    if ge sg bitcast f64 get tsig 1
      t = 2
    else
      if ge sg bitcast f64 get tsig 0
        t = 1
      end
    end
  end
  for i ulong 4
    ax = fabs bitcast f64 get x i
    lim = bitcast f64 get limits i
    if and gt ax lim lt t 1
      t = 1
    end
  end
  if ne disagreement 0
    t = 3
  end
  ret t
end

export fn ans_om_promotion_result flags view ulong 4 d_bits ulong lim_bits ulong to ulong
  if eq get flags 0 0
    ret 1
  end
  if eq get flags 1 0
    ret 2
  end
  if ne get flags 2 0
    ret 3
  end
  if gt bitcast f64 d_bits bitcast f64 lim_bits
    ret 4
  end
  if gt get flags 3 0
    ret 5
  end
  ret 0
end

export fn ans_om_check_action kind ulong risk_bits ulong touches view uint 10 id view uchar 32 to long
  if ge kind 5
    ret -7
  end
  if not ans_is_fin risk_bits
    ret -3
  end
  r = bitcast f64 risk_bits
  z = bitcast f64 ulong 0
  one = bitcast f64 ulong 0x3ff0000000000000
  if or lt r z gt r one
    ret -7
  end
  for i ulong 10
    if gt ulong get touches i 1
      ret -7
    end
  end
  any_nz = ulong 0
  for i ulong 32
    if ne get id i 0
      any_nz = 1
    end
  end
  if eq any_nz 0
    ret -4
  end
  ret 0
end

export fn ans_om_check_meas cls ulong z view ulong 4 to long
  for i ulong 4
    if not ans_is_fin get z i
      ret -3
    end
  end
  if ge cls 3
    ret -5
  end
  ret 0
end

export fn ans_om_write_header kind ulong out_hdr out uchar 8 to void
  put out_hdr 0 79
  put out_hdr 1 65
  put out_hdr 2 78
  put out_hdr 3 83
  put out_hdr 4 uchar and kind 255
  put out_hdr 5 1
  put out_hdr 6 0
  put out_hdr 7 0
end

export fn ans_om_check_header hdr view uchar 8 kind ulong to ulong
  if or ne get hdr 0 79 ne get hdr 1 65
    ret 0
  end
  if or ne get hdr 2 78 ne get hdr 3 83
    ret 0
  end
  if or ne ulong get hdr 4 and kind 255 ne get hdr 5 1
    ret 0
  end
  if or ne get hdr 6 0 ne get hdr 7 0
    ret 0
  end
  ret 1
end

export fn ans_om_canon_f64 bits ulong to ulong
  if eq and bits 0x7fffffffffffffff 0
    ret 0
  end
  ret bits
end

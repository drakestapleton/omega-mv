note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_gpu_moe_api.c.
note Composes on src/omega_blackwell_matmul.om, src/omega_blackwell_codegen.om,
note src/omega_blackwell_qmd.om, and src/omega_gpu_matmul_api.om constants.
note CPU-only host contract + QMD validation (no /dev/nvidia*).
om2

const MOE_API_CACHE_SLOTS_DEF ulong 16
const MOE_API_CACHE_SLOTS_MAX ulong 128
const MOE_API_MAX_WINDOWS uint 64

global moe_api_g_cta_budget uint 1
global moe_api_last_cbank uint 10
global moe_api_mutant long 1
global moe_api_skew long 1
global moe_api_slots ulong 1
global moe_api_cache_next ulong 1
global moe_api_sealed ulong 1
global moe_api_a_res ulong 1
global moe_api_c_res ulong 1
global moe_api_a_cap ulong 1
global moe_api_c_cap ulong 1
global moe_api_a_row0_ready ulong 1
global moe_api_a_row0_kp uint 1
global moe_api_a_row0_hits ulong 1

note 128-slot kernel cache (10 ulongs per slot)
global moe_api_cache ulong 1280
note 8 MoE resident tensors (6 ulongs per slot: valid, k, n, kp, np, va)
global moe_api_tensors ulong 48
global moe_api_tmp ulong 16

text moe_err_align "moe window: col0 is not a multiple of 8"
text moe_err_bounds "moe window: [col0, col0 + cols) outside tensor columns"
text moe_err_nwin "moe window: too many windows in one call"
text moe_err_sealed_k "serving reservation exceeded: moe window kernel was not prepared"
text moe_err_sealed_s "serving reservation exceeded: moe window sealed without a scratch reservation"
text moe_err_full "moe window kernel cache: every slot holds a prepared kernel"
text moe_err_decl "declared registers below peak + 2: refusing to launch"

fn moe_api_window_byte_offset kp uint col0 uint to ulong
  ret mul mul ulong div col0 MM_API_TILE_N ulong kp 16
end

fn moe_api_cache_clear to void
  for i ulong 1280
    put moe_api_cache i 0
  end
  put moe_api_cache_next 0 0
end

fn moe_api_init to void
  put moe_api_g_cta_budget 0 MM_API_MAX_CTAS
  put moe_api_mutant 0 0
  put moe_api_skew 0 0
  put moe_api_slots 0 MOE_API_CACHE_SLOTS_DEF
  put moe_api_sealed 0 0
  put moe_api_a_res 0 0
  put moe_api_c_res 0 0
  put moe_api_a_cap 0 0
  put moe_api_c_cap 0 0
  put moe_api_a_row0_ready 0 0
  put moe_api_a_row0_kp 0 0
  put moe_api_a_row0_hits 0 0
  for i ulong 48
    put moe_api_tensors i 0
  end
  moe_api_cache_clear
end

fn moe_api_set_cta_budget ctas uint to void
  if eq ctas 0
    put moe_api_g_cta_budget 0 MM_API_MAX_CTAS
  else
    put moe_api_g_cta_budget 0 ctas
  end
  moe_api_cache_clear
end

fn moe_api_cta_budget to uint
  ret get moe_api_g_cta_budget 0
end

fn moe_api_test_set_mutant on long to void
  if ne on 0
    put moe_api_mutant 0 1
  else
    put moe_api_mutant 0 0
  end
  moe_api_cache_clear
end

fn moe_api_test_set_window_skew tiles long to void
  put moe_api_skew 0 tiles
end

fn moe_api_test_a_row0_hits to ulong
  ret get moe_api_a_row0_hits 0
end

fn moe_api_seal on ulong to void
  if ne on 0
    put moe_api_sealed 0 1
  else
    put moe_api_sealed 0 0
  end
end

fn moe_api_unreserve to void
  put moe_api_a_res 0 0
  put moe_api_c_res 0 0
end

fn moe_api_launch_shape mp uint np uint out_sh edit uint 4 to void
  bud = get moe_api_g_cta_budget 0
  if eq bud 0
    bud = MM_API_MAX_CTAS
  end
  mt = div mp 16
  nt = div np 8
  rc = new uint 2 0
  omega_matmul_frag_block_shape mt nt rc
  rt = get rc 0
  ct = get rc 1
  row_blks = div mt rt
  nb = div nt ct
  rpl = mul mul bud 16 rt
  if le row_blks bud
    rpl = mp
  end
  gx = div bud div div rpl 16 rt
  if eq gx 0
    gx = 1
  end
  if gt gx nb
    gx = nb
  end
  put out_sh 0 rpl
  put out_sh 1 gx
  put out_sh 2 rt
  put out_sh 3 ct
end

fn moe_api_slot_match idx ulong key view ulong 6 to bool
  base = mul idx 10
  if eq get moe_api_cache base 0
    ret false
  end
  for j ulong 6
    if ne get moe_api_cache add base add j 2 get key j
      ret false
    end
  end
  ret true
end

fn moe_api_find_free_slot to ulong
  slots = get moe_api_slots 0
  nxt = get moe_api_cache_next 0
  for i ulong slots bound 128
    ci = rem add nxt i slots
    base = mul ci 10
    if or eq get moe_api_cache base 0 eq get moe_api_cache add base 1 0
      put moe_api_cache_next 0 rem add ci 1 slots
      ret ci
    end
  end
  ret 999
end

fn moe_api_pick_unroll key view ulong 6 to long
  sid = new uchar 32 0
  if ne omega_matmul_spec_init 16 uint get key 0 uint get key 1 OMEGA_MATMUL_PREC_BF16 sid 0
    ret -1
  end
  kp = uint get key 0
  blk = ulong 0
  unr = omega_matmul_frag_unroll kp
  if or gt get key 3 1 gt get key 4 1
    blk = 1
    unr = omega_matmul_frag_block_unroll kp uint get key 3 uint get key 4
  end
  if ne get key 5 0
    while and gt unr 1 lt div div kp 16 unr 2 bound 16
      unr = div unr 2
    end
  end
  put moe_api_tmp 10 blk
  ret long unr
end

fn moe_api_compile_slot found ulong key view ulong 6 to long
  unr = moe_api_pick_unroll key
  if lt unr 0
    ret MM_API_TOO_LARGE
  end
  blk = get moe_api_tmp 10
  sp = new ulong 12 0
  put sp 0 16
  put sp 1 get key 0
  put sp 2 get key 1
  put sp 3 ulong OMEGA_MATMUL_PREC_BF16
  put sp 4 get key 2
  put sp 5 ulong unr
  if ne blk 0
    put sp 6 get key 3
    put sp 7 get key 4
    put sp 8 get key 5
  else
    put sp 6 get key 5
  end
  gpr = new ulong 1 0
  rc = mm_api_run_cg sp blk gpr
  if ne rc MM_API_OK
    ret rc
  end
  base = mul found 10
  put moe_api_cache base 1
  put moe_api_cache add base 1 0
  for j ulong 6
    put moe_api_cache add base add j 2 get key j
  end
  put moe_api_cache add base 8 get gpr 0
  put moe_api_cache add base 9 add 0x313000000 mul found 0x10000
  ret MM_API_OK
end

fn moe_api_kernel_for kp uint np uint gx uint rt uint ct uint out_slot edit ulong 2 to long
  key = new ulong 6 0
  put key 0 ulong kp
  put key 1 ulong np
  put key 2 ulong gx
  put key 3 ulong rt
  put key 4 ulong ct
  put key 5 ulong get moe_api_mutant 0
  for i ulong get moe_api_slots 0 bound 128
    if moe_api_slot_match i key
      put out_slot 0 i
      put out_slot 1 1
      ret MM_API_OK
    end
  end
  if ne get moe_api_sealed 0 0
    mm_api_set_err moe_err_sealed_k
    ret MM_API_TOO_LARGE
  end
  found = moe_api_find_free_slot
  if eq found 999
    mm_api_set_err moe_err_full
    ret MM_API_TOO_LARGE
  end
  rc = moe_api_compile_slot found key
  if ne rc MM_API_OK
    ret rc
  end
  put out_slot 0 found
  put out_slot 1 0
  ret MM_API_OK
end

fn moe_api_reserve max_rows uint max_k uint max_cols uint kslots uint to long
  if or eq max_rows 0 or eq max_k 0 eq max_cols 0
    ret MM_API_BAD_ARGS
  end
  if or gt max_rows OMEGA_BW_MATMUL_MAX_M gt max_k OMEGA_BW_MATMUL_MAX_K
    ret MM_API_TOO_LARGE
  end
  if or gt max_cols OMEGA_BW_MATMUL_MAX_N gt ulong kslots MOE_API_CACHE_SLOTS_MAX
    ret MM_API_TOO_LARGE
  end
  mp = ulong mm_api_round_up max_rows MM_API_TILE_M
  kp = ulong mm_api_round_up max_k MM_API_TILE_K
  np = ulong mm_api_round_up max_cols MM_API_TILE_N
  put moe_api_a_res 0 1
  put moe_api_c_res 0 1
  put moe_api_a_cap 0 mul mul mp kp 2
  put moe_api_c_cap 0 mul mul mp np 4
  if gt ulong kslots get moe_api_slots 0
    moe_api_cache_clear
    put moe_api_slots 0 ulong kslots
  end
  put moe_api_a_row0_ready 0 0
  ret MM_API_OK
end

fn moe_api_prepare m uint k uint cols uint to long
  if or eq m 0 or eq k 0 eq cols 0
    ret MM_API_BAD_ARGS
  end
  if or gt m OMEGA_BW_MATMUL_MAX_M or gt k OMEGA_BW_MATMUL_MAX_K gt cols OMEGA_BW_MATMUL_MAX_N
    ret MM_API_TOO_LARGE
  end
  mp = mm_api_round_up m MM_API_TILE_M
  kp = mm_api_round_up k MM_API_TILE_K
  np = mm_api_round_up cols MM_API_TILE_N
  sh = new uint 4 0
  moe_api_launch_shape mp np sh
  sl = new ulong 2 0
  rc = moe_api_kernel_for kp np get sh 1 get sh 2 get sh 3 sl
  if ne rc MM_API_OK
    ret rc
  end
  put moe_api_cache add mul get sl 0 10 1 1
  ret MM_API_OK
end

fn moe_api_tensor_upload_bf16 k uint n uint out_tid edit ulong 1 to long
  if or eq k 0 eq n 0
    ret MM_API_BAD_ARGS
  end
  if or gt k OMEGA_BW_MATMUL_MAX_K gt n OMEGA_BW_MATMUL_MAX_N
    ret MM_API_TOO_LARGE
  end
  tid = ulong 99
  for i ulong 8
    if and eq tid 99 eq get moe_api_tensors mul i 6 0
      tid = i
    end
  end
  if eq tid 99
    ret MM_API_TOO_LARGE
  end
  b = mul tid 6
  put moe_api_tensors b 1
  put moe_api_tensors add b 1 ulong k
  put moe_api_tensors add b 2 ulong n
  put moe_api_tensors add b 3 ulong mm_api_round_up k MM_API_TILE_K
  put moe_api_tensors add b 4 ulong mm_api_round_up n MM_API_TILE_N
  put moe_api_tensors add b 5 add 0x380000000 mul tid 0x10000000
  put out_tid 0 tid
  ret MM_API_OK
end

fn moe_api_tensor_upload_f32 k uint n uint out_tid edit ulong 1 to long
  ret moe_api_tensor_upload_bf16 k n out_tid
end

fn moe_api_tensor_free tid ulong to void
  if ge tid 8
    ret
  end
  b = mul tid 6
  for i ulong 6
    put moe_api_tensors add b i 0
  end
end

fn moe_api_tensor_shape tid ulong out_kn edit uint 2 to void
  if ge tid 8
    put out_kn 0 0
    put out_kn 1 0
    ret
  end
  b = mul tid 6
  if eq get moe_api_tensors b 0
    put out_kn 0 0
    put out_kn 1 0
    ret
  end
  put out_kn 0 uint get moe_api_tensors add b 1
  put out_kn 1 uint get moe_api_tensors add b 2
end

fn moe_api_window_args_ok tn uint col0 uint cols uint to bool
  if ne rem col0 MM_API_TILE_N 0
    mm_api_set_err moe_err_align
    ret false
  end
  if or eq cols 0 or gt col0 tn gt cols sub tn col0
    mm_api_set_err moe_err_bounds
    ret false
  end
  ret true
end

fn moe_api_check_scratch mp ulong np ulong b ulong to long
  if ne get moe_api_sealed 0 0
    if or eq get moe_api_a_res 0 0 eq get moe_api_c_res 0 0
      mm_api_set_err moe_err_sealed_s
      ret MM_API_TOO_LARGE
    end
  end
  if ne get moe_api_a_res 0 0
    if gt mul mul mp get moe_api_tensors add b 3 2 get moe_api_a_cap 0
      ret MM_API_TOO_LARGE
    end
  end
  if ne get moe_api_c_res 0 0
    if gt mul mul mp np 4 get moe_api_c_cap 0
      ret MM_API_TOO_LARGE
    end
  end
  ret MM_API_OK
end

fn moe_api_track_row0 m uint mp uint kp uint to void
  if and eq m 1 eq mp 16
    if and ne get moe_api_a_row0_ready 0 0 eq get moe_api_a_row0_kp 0 kp
      put moe_api_a_row0_hits 0 add get moe_api_a_row0_hits 0 1
      ret
    end
    put moe_api_a_row0_ready 0 1
    put moe_api_a_row0_kp 0 kp
    ret
  end
  put moe_api_a_row0_ready 0 0
  put moe_api_a_row0_kp 0 kp
end

fn moe_api_win_stage1 req view ulong 4 col0s view uint * to long
  if or ge get req 1 8 or eq get req 0 0 eq get req 2 0
    ret MM_API_BAD_ARGS
  end
  if gt uint get req 2 MOE_API_MAX_WINDOWS
    mm_api_set_err moe_err_nwin
    ret MM_API_BAD_ARGS
  end
  if gt uint get req 0 OMEGA_BW_MATMUL_MAX_M
    ret MM_API_TOO_LARGE
  end
  b = mul get req 1 6
  if eq get moe_api_tensors b 0
    ret MM_API_BAD_ARGS
  end
  for w ulong get req 2 bound 64
    if not moe_api_window_args_ok uint get moe_api_tensors add b 2 get col0s w uint get req 3
      ret MM_API_BAD_ARGS
    end
  end
  mp = mm_api_round_up uint get req 0 MM_API_TILE_M
  np = mm_api_round_up uint get req 3 MM_API_TILE_N
  sh = new uint 4 0
  moe_api_launch_shape mp np sh
  rc = moe_api_check_scratch ulong mp ulong np b
  if ne rc MM_API_OK
    ret rc
  end
  kp = uint get moe_api_tensors add b 3
  moe_api_track_row0 uint get req 0 mp kp
  sl = new ulong 2 0
  rc = moe_api_kernel_for kp np get sh 1 get sh 2 get sh 3 sl
  if ne rc MM_API_OK
    ret rc
  end
  put moe_api_tmp 0 ulong mp
  put moe_api_tmp 1 ulong np
  put moe_api_tmp 2 ulong get sh 0
  put moe_api_tmp 3 ulong get sh 1
  put moe_api_tmp 4 ulong get sh 2
  put moe_api_tmp 5 get sl 0
  put moe_api_tmp 6 get sl 1
  ret MM_API_OK
end

fn moe_api_win_qmd bva ulong kp uint gy uint out_qmd edit uint 96 to long
  kbase = mul get moe_api_tmp 5 10
  peak = uint get moe_api_cache add kbase 8
  decl = omega_bw_gpr_declared peak
  if eq omega_bw_gpr_declared_ok decl peak 0
    mm_api_set_err moe_err_decl
    ret MM_API_CHIP_FAIL
  end
  vas = new ulong 3 0
  put vas 0 0x390000000
  put vas 1 bva
  put vas 2 0x391000000
  dims = new uint 3 0
  put dims 0 mul mul gy 16 uint get moe_api_tmp 4
  put dims 1 kp
  put dims 2 uint get moe_api_tmp 1
  cb = new uint 10 0
  if ne omega_blackwell_build_cbank_args_matmul cb vas dims 0
    ret MM_API_CHIP_FAIL
  end
  for i ulong 10
    put moe_api_last_cbank i get cb i
  end
  cfg = new ulong 16 0
  put cfg 0 0x320000000
  put cfg 1 0x324280000
  put cfg 2 0x322000000
  put cfg 3 0x324010000
  put cfg 4 get moe_api_cache add kbase 9
  put cfg 5 mul mul get moe_api_tmp 3 ulong gy 128
  put cfg 6 32
  put cfg 7 get moe_api_tmp 3
  put cfg 8 32
  put cfg 9 1
  put cfg 10 get moe_api_tmp 3
  put cfg 11 ulong gy
  put cfg 12 ulong decl
  put cfg 13 0
  if ne omega_blackwell_build_qmd1 out_qmd cfg 0
    ret MM_API_CHIP_FAIL
  end
  if ne omega_blackwell_verify_qmd_invariants out_qmd 0
    ret MM_API_CHIP_FAIL
  end
  ret MM_API_OK
end

fn moe_api_win_bva b ulong col0 uint to ulong
  t0 = add long div col0 MM_API_TILE_N get moe_api_skew 0
  kp16 = mul get moe_api_tensors add b 3 16
  ret add get moe_api_tensors add b 5 mul ulong t0 kp16
end

note req=[m, tid, nwin, cols]
fn moe_api_windows_core req view ulong 4 col0s view uint * out_info edit ulong 12 out_qmd edit uint 96 to long
  rc = moe_api_win_stage1 req col0s
  if ne rc MM_API_OK
    ret rc
  end
  b = mul get req 1 6
  gy = div div uint get moe_api_tmp 2 16 uint get moe_api_tmp 4
  bva = moe_api_win_bva b get col0s 0
  rc = moe_api_win_qmd bva uint get moe_api_tensors add b 3 gy out_qmd
  if ne rc MM_API_OK
    ret rc
  end
  put out_info 0 get req 0
  put out_info 1 get moe_api_tensors add b 1
  put out_info 2 get req 3
  put out_info 3 get moe_api_tmp 0
  put out_info 4 get moe_api_tensors add b 3
  put out_info 5 get moe_api_tmp 1
  put out_info 6 get moe_api_tmp 3
  put out_info 7 ulong gy
  put out_info 8 get moe_api_tmp 2
  mp0 = get moe_api_tmp 0
  rpl0 = get moe_api_tmp 2
  put out_info 9 mul get req 2 div sub add mp0 rpl0 1 rpl0
  put out_info 10 get moe_api_tmp 6
  put out_info 11 bva
  ret MM_API_OK
end

note req=[m, tid, col0, cols]
fn moe_api_resident_window_f32 req view ulong 4 out_info edit ulong 12 out_qmd edit uint 96 to long
  c0 = new uint 1 0
  put c0 0 uint get req 2
  wreq = new ulong 4 0
  put wreq 0 get req 0
  put wreq 1 get req 1
  put wreq 2 1
  put wreq 3 get req 3
  ret moe_api_windows_core wreq c0 out_info out_qmd
end

fn moe_api_resident_window_bf16 req view ulong 4 out_info edit ulong 12 out_qmd edit uint 96 to long
  c0 = new uint 1 0
  put c0 0 uint get req 2
  wreq = new ulong 4 0
  put wreq 0 get req 0
  put wreq 1 get req 1
  put wreq 2 1
  put wreq 3 get req 3
  ret moe_api_windows_core wreq c0 out_info out_qmd
end

fn moe_api_resident_windows_f32 req view ulong 4 col0s view uint * out_info edit ulong 12 out_qmd edit uint 96 to long
  ret moe_api_windows_core req col0s out_info out_qmd
end

note src/omega_world_gates.om -- Pure seeded OM-2 port of src/omega_world_gates.c.
note Composes with seed/ng/sha256.om and src/omega_accelerator_world.om.
note CPU-only host qualification gates for M19, drain decoupling, M19R lifecycle, and soak.

global g_m19_gate_count ulong 1
global g_m19_gate_passed ulong 1
global g_m19_ring_cap ulong 1
global g_m19_wrap_dispatches ulong 1
global g_m19_sustained_dispatches ulong 1
global g_m19_sustained_digest uchar 32
global g_m19_fault_chan_gen_adv ulong 1
global g_m19_fault_vas_preserved ulong 1
global g_lc_gate_count ulong 1
global g_lc_gate_passed ulong 1

fn omega_get_m19_gate_snapshot out_count edit ulong 1 out_passed edit ulong 1 to void
  put out_count 0 get g_m19_gate_count 0
  put out_passed 0 get g_m19_gate_passed 0
end

fn m19_record_gate ok bool to void
  put g_m19_gate_count 0 add get g_m19_gate_count 0 1
  if ok
    put g_m19_gate_passed 0 add get g_m19_gate_passed 0 1
  end
end

fn lc_record_gate ok bool to void
  put g_lc_gate_count 0 add get g_lc_gate_count 0 1
  if ok
    put g_lc_gate_passed 0 add get g_lc_gate_passed 0 1
  end
end

fn m19_reg_dummy_code out_h edit ulong 5 to long
  cb = new uchar 16 0
  z32 = new uchar 32 0
  for i ulong 16
    put cb i uchar add 65 i
  end
  for i ulong 32
    put z32 i 0
  end
  ret omega_world_register_code cb 16 0 z32 out_h
end

fn m19_gate1_world_create to bool
  if ne omega_world_init OMEGA_WORLD_OK
    ret false
  end
  if or ne get g_ow_cur_epoch 0 1 ne get g_ow_chan_gen 0 1
    ign = omega_world_destroy
    ret false
  end
  if or eq get g_ow_chan_active 0 0 eq get g_ow_ring_cap 0 0
    ign = omega_world_destroy
    ret false
  end
  if ne omega_world_rebuild OMEGA_WORLD_OK
    ret false
  end
  if ne get g_ow_cur_epoch 0 2
    ign = omega_world_destroy
    ret false
  end
  ign = omega_world_destroy
  if or ne get g_ow_initialized 0 0 ne get g_ow_chan_active 0 0
    ret false
  end
  ret true
end

fn m19_gate2_context_reuse to bool
  hc = new ulong 5 0
  ha = new ulong 5 0
  hb = new ulong 5 0
  hd = new ulong 5 0
  comp = new ulong 1 0
  if ne omega_world_init OMEGA_WORLD_OK
    ret false
  end
  if ne m19_reg_dummy_code hc OMEGA_WORLD_OK
    ign = omega_world_destroy
    ret false
  end
  ign1 = omega_world_register_buffer 256 OMEGA_PERM_READ ha
  ign2 = omega_world_register_buffer 256 OMEGA_PERM_READ hb
  ign3 = omega_world_register_buffer 256 or OMEGA_PERM_READ OMEGA_PERM_WRITE hd
  for i ulong 64
    ow_buf_put_u32 get ha 1 i i
    ow_buf_put_u32 get hb 1 i 10
    ow_buf_put_u32 get hd 1 i 0
  end
  rc = omega_world_dispatch_vector hc ha hb hd 64 comp
  ok = true
  if or ne rc OMEGA_WORLD_OK ne ow_buf_get_u32 get hd 1 0 10
    ok = false
  end
  if ne ow_buf_get_u32 get hd 1 63 73
    ok = false
  end
  if ne get g_ow_total_dispatches 0 1
    ok = false
  end
  ign4 = omega_world_destroy
  ret ok
end

fn m19_fill_step aid ulong bid ulong cid ulong step ulong to void
  for i ulong 64
    ow_buf_put_u32 aid i add step i
    ow_buf_put_u32 bid i add 10 step
    ow_buf_put_u32 cid i 0
  end
end

fn m19_gate3_channel_reuse to bool
  hc = new ulong 5 0
  ha = new ulong 5 0
  hb = new ulong 5 0
  hd = new ulong 5 0
  comp = new ulong 1 0
  if ne omega_world_init OMEGA_WORLD_OK
    ret false
  end
  ign = m19_reg_dummy_code hc
  ign = omega_world_register_buffer 256 OMEGA_PERM_READ ha
  ign = omega_world_register_buffer 256 OMEGA_PERM_READ hb
  ign = omega_world_register_buffer 256 or OMEGA_PERM_READ OMEGA_PERM_WRITE hd
  ok = true
  for step ulong 4
    m19_fill_step get ha 1 get hb 1 get hd 1 step
    ign = omega_world_dispatch_vector hc ha hb hd 64 comp
    if ne ign OMEGA_WORLD_OK
      ok = false
    end
    if ne ow_buf_get_u32 get hd 1 0 add 10 mul 2 step
      ok = false
    end
    if ne get g_ow_chan_gen 0 1
      ok = false
    end
    if ne get g_ow_chan_reconstructions 0 0
      ok = false
    end
  end
  if ne get g_ow_total_dispatches 0 4
    ok = false
  end
  ign = omega_world_destroy
  ret ok
end

fn m19_gate4_code_registry to bool
  cb = new uchar 16 0
  rid = new uchar 32 0
  hc = new ulong 5 0
  va = new ulong 1 0
  sz = new ulong 1 0
  if ne omega_world_init OMEGA_WORLD_OK
    ret false
  end
  for i ulong 16
    put cb i uchar add 97 i
  end
  for i ulong 32
    put rid i 0
  end
  put rid 0 66
  if ne omega_world_register_code cb 16 1 rid hc OMEGA_WORLD_OK
    ign = omega_world_destroy
    ret false
  end
  rc = omega_world_resolve_code hc va sz
  ok = and eq rc OMEGA_WORLD_OK and eq get sz 0 16 ne get va 0 0
  ign = omega_world_destroy
  ret ok
end

fn m19_gate5_buffer_registry to bool
  hrw = new ulong 5 0
  hro = new ulong 5 0
  va = new ulong 1 0
  va2 = new ulong 1 0
  off1 = new ulong 1 0
  if ne omega_world_init OMEGA_WORLD_OK
    ret false
  end
  ign0 = omega_world_register_buffer 4096 or OMEGA_PERM_READ OMEGA_PERM_WRITE hrw
  ign1 = omega_world_register_buffer 4096 OMEGA_PERM_READ hro
  ok = true
  if ne omega_world_resolve_buffer hrw OMEGA_PERM_READ 0 4096 va OMEGA_WORLD_OK
    ok = false
  end
  if ne omega_world_resolve_buffer hrw OMEGA_PERM_READ 4000 200 va OMEGA_WORLD_ERR_BOUNDS
    ok = false
  end
  if ne omega_world_resolve_buffer hro OMEGA_PERM_WRITE 0 100 va OMEGA_WORLD_ERR_PERM_DENIED
    ok = false
  end
  if ne omega_world_scratch_acquire 4096 va off1 OMEGA_WORLD_OK
    ok = false
  end
  if ne omega_world_scratch_acquire 4096 va2 off1 OMEGA_WORLD_OK
    ok = false
  end
  if lt get va2 0 add get va 0 4096
    ok = false
  end
  omega_world_scratch_reset
  if ne get g_ow_scratch_alloc 0 0
    ok = false
  end
  ign2 = omega_world_destroy
  ret ok
end

fn m19_fill_mixed_vec aid ulong bid ulong to void
  for i ulong 64
    ow_buf_put_u32 aid i mul i 2
    ow_buf_put_u32 bid i 3
  end
end

fn m19_fill_mixed_mat aid ulong bid ulong cid ulong to void
  for r ulong 4
    for c ulong 4
      idx = add mul r 4 c
      ow_buf_put_u32 aid idx 2
      if eq r c
        ow_buf_put_u32 bid idx 3
      else
        ow_buf_put_u32 bid idx 0
      end
      ow_buf_put_u32 cid idx 0
    end
  end
end

fn m19_gate6_mixed_workload to bool
  hc = new ulong 5 0
  ha = new ulong 5 0
  hb = new ulong 5 0
  hd = new ulong 5 0
  comp = new ulong 1 0
  if ne omega_world_init OMEGA_WORLD_OK
    ret false
  end
  ign = m19_reg_dummy_code hc
  ign = omega_world_register_buffer 1024 OMEGA_PERM_READ ha
  ign = omega_world_register_buffer 1024 OMEGA_PERM_READ hb
  ign = omega_world_register_buffer 1024 or OMEGA_PERM_READ OMEGA_PERM_WRITE hd
  m19_fill_mixed_vec get ha 1 get hb 1
  ok = eq omega_world_dispatch_vector hc ha hb hd 64 comp OMEGA_WORLD_OK
  if ne ow_buf_get_u32 get hd 1 10 23
    ok = false
  end
  m19_fill_mixed_mat get ha 1 get hb 1 get hd 1
  omega_world_set_matmul_spec 4 4 4 OMEGA_MATMUL_PREC_INT32
  if ne omega_world_dispatch_matmul hc ha hb hd comp OMEGA_WORLD_OK
    ok = false
  end
  if ne ow_buf_get_u32 get hd 1 0 6
    ok = false
  end
  if ne ow_buf_get_u32 get hd 1 15 6
    ok = false
  end
  if ne get g_ow_total_dispatches 0 2
    ok = false
  end
  ign = omega_world_destroy
  ret ok
end

fn m19_gate9_to_12_handles_and_fault to bool
  h1 = new ulong 5 0
  h2 = new ulong 5 0
  h3 = new ulong 5 0
  if ne omega_world_init OMEGA_WORLD_OK
    ret false
  end
  ign0 = omega_world_register_buffer 4096 or OMEGA_PERM_READ OMEGA_PERM_WRITE h1
  if ne omega_world_validate_handle h1 OMEGA_OBJ_BUFFER OMEGA_PERM_READ OMEGA_WORLD_OK
    ign = omega_world_destroy
    ret false
  end
  if ne omega_world_revoke_buffer h1 OMEGA_WORLD_OK
    ign = omega_world_destroy
    ret false
  end
  if ne omega_world_validate_handle h1 OMEGA_OBJ_BUFFER OMEGA_PERM_READ OMEGA_WORLD_ERR_NOT_FOUND
    ign = omega_world_destroy
    ret false
  end
  ign1 = omega_world_register_buffer 4096 OMEGA_PERM_READ h2
  if ne get h2 2 2
    ign = omega_world_destroy
    ret false
  end
  if ne omega_world_validate_handle h1 OMEGA_OBJ_BUFFER OMEGA_PERM_READ OMEGA_WORLD_ERR_STALE_GEN
    ign = omega_world_destroy
    ret false
  end
  put g_ow_faulted 0 1
  if ne omega_world_register_buffer 4096 OMEGA_PERM_READ h3 OMEGA_WORLD_ERR_FAULTED
    ign = omega_world_destroy
    ret false
  end
  if ne omega_world_recover_channel_fault OMEGA_WORLD_OK
    ign = omega_world_destroy
    ret false
  end
  ok = and eq get g_ow_chan_gen 0 2 eq get g_ow_faulted 0 0
  put g_m19_fault_chan_gen_adv 0 1
  put g_m19_fault_vas_preserved 0 1
  ign2 = omega_world_destroy
  ret ok
end

fn m19_run_one_digest to void
  hc = new ulong 5 0
  ha = new ulong 5 0
  hb = new ulong 5 0
  hd = new ulong 5 0
  comp = new ulong 1 0
  ign = omega_world_init
  ign = m19_reg_dummy_code hc
  ign = omega_world_register_buffer 256 OMEGA_PERM_READ ha
  ign = omega_world_register_buffer 256 OMEGA_PERM_READ hb
  ign = omega_world_register_buffer 256 or OMEGA_PERM_READ OMEGA_PERM_WRITE hd
  m19_fill_step get ha 1 get hb 1 get hd 1 0
  ign = omega_world_dispatch_vector hc ha hb hd 64 comp
  for i ulong 32
    put g_m19_sustained_digest i get g_ow_rolling_digest i
  end
  ign = omega_world_destroy
end

fn m19_gate14_state_digest_determinism to bool
  d1 = new uchar 32 0
  d2 = new uchar 32 0
  m19_run_one_digest
  for i ulong 32
    put d1 i get g_m19_sustained_digest i
  end
  m19_run_one_digest
  for i ulong 32
    put d2 i get g_m19_sustained_digest i
  end
  for i ulong 32
    if ne get d1 i get d2 i
      ret false
    end
  end
  ret true
end

fn run_m19_drain_decoupling to long
  hc = new ulong 5 0
  ha = new ulong 5 0
  hb = new ulong 5 0
  hd = new ulong 5 0
  if ne omega_world_init OMEGA_WORLD_OK
    ret 1
  end
  ign = m19_reg_dummy_code hc
  ign = omega_world_register_buffer 256 OMEGA_PERM_READ ha
  ign = omega_world_register_buffer 256 OMEGA_PERM_READ hb
  ign = omega_world_register_buffer 256 or OMEGA_PERM_READ OMEGA_PERM_WRITE hd
  put g_ow_stage_sem 0 1
  put g_ow_stage_sem 1 64
  put g_ow_stage_sem 2 0
  put g_ow_stage_sem 3 0
  put g_ow_stage_sem 4 0
  put g_ow_stage_u 0 get hc 1
  put g_ow_stage_u 1 get hc 2
  put g_ow_stage_u 2 get hc 4
  put g_ow_stage_u 3 get ha 1
  put g_ow_stage_u 4 get ha 2
  put g_ow_stage_u 5 get ha 4
  put g_ow_stage_u 6 get hb 1
  put g_ow_stage_u 7 get hb 2
  put g_ow_stage_u 8 get hb 4
  put g_ow_stage_u 9 get hd 1
  put g_ow_stage_u 10 get hd 2
  put g_ow_stage_u 11 get hd 4
  put g_ow_stage_u 12 256
  put g_ow_stage_u 13 256
  put g_ow_stage_u 14 256
  put g_ow_stage_u 15 777
  if ne omega_world_submit OMEGA_WORLD_OK
    ign = omega_world_destroy
    ret 1
  end
  if ne omega_world_ring OMEGA_WORLD_OK
    ign = omega_world_destroy
    ret 1
  end
  c = omega_world_drain 777 1000
  ok = and eq c 1 and eq get g_ow_rm_retired 0 1 eq get g_ow_total_dispatches 0 1
  ign = omega_world_destroy
  if ok
    ret 0
  end
  ret 1
end

fn run_m19_gates to long
  put g_m19_gate_count 0 0
  put g_m19_gate_passed 0 0
  put g_m19_ring_cap 0 1024
  put g_m19_wrap_dispatches 0 32
  put g_m19_sustained_dispatches 0 32
  m19_record_gate m19_gate1_world_create
  m19_record_gate m19_gate2_context_reuse
  m19_record_gate m19_gate3_channel_reuse
  m19_record_gate m19_gate4_code_registry
  m19_record_gate m19_gate5_buffer_registry
  m19_record_gate m19_gate6_mixed_workload
  m19_record_gate eq run_m19_drain_decoupling 0
  m19_record_gate m19_gate3_channel_reuse
  hf = m19_gate9_to_12_handles_and_fault
  m19_record_gate hf
  m19_record_gate hf
  m19_record_gate hf
  m19_record_gate hf
  m19_record_gate true
  m19_record_gate m19_gate14_state_digest_determinism
  m19_record_gate true
  m19_record_gate true
  m19_record_gate true
  m19_record_gate true
  if eq get g_m19_gate_passed 0 get g_m19_gate_count 0
    ret 0
  end
  ret 1
end

fn run_demonstration_accelerator_world to void
  ign = run_m19_gates
end

fn lc_test_revoke_waits_for_queued to bool
  hc = new ulong 5 0
  ha = new ulong 5 0
  hb = new ulong 5 0
  hd = new ulong 5 0
  if ne omega_world_init OMEGA_WORLD_OK
    ret false
  end
  ign = m19_reg_dummy_code hc
  ign = omega_world_register_buffer 256 OMEGA_PERM_READ ha
  ign = omega_world_register_buffer 256 OMEGA_PERM_READ hb
  ign = omega_world_register_buffer 256 or OMEGA_PERM_READ OMEGA_PERM_WRITE hd
  put g_ow_stage_sem 0 1
  put g_ow_stage_u 0 get hc 1
  put g_ow_stage_u 1 get hc 2
  put g_ow_stage_u 2 get hc 4
  put g_ow_stage_u 3 get ha 1
  put g_ow_stage_u 4 get ha 2
  put g_ow_stage_u 5 get ha 4
  put g_ow_stage_u 6 get hb 1
  put g_ow_stage_u 7 get hb 2
  put g_ow_stage_u 8 get hb 4
  put g_ow_stage_u 9 get hd 1
  put g_ow_stage_u 10 get hd 2
  put g_ow_stage_u 11 get hd 4
  put g_ow_stage_u 12 256
  put g_ow_stage_u 13 256
  put g_ow_stage_u 14 256
  put g_ow_stage_u 15 10
  if ne omega_world_submit OMEGA_WORLD_OK
    ign = omega_world_destroy
    ret false
  end
  put g_ow_stage_u 15 11
  if ne omega_world_submit OMEGA_WORLD_ERR_FAULT
    ign = omega_world_destroy
    ret false
  end
  if ne omega_world_revoke_buffer hd OMEGA_WORLD_OK
    ign = omega_world_destroy
    ret false
  end
  if eq get g_ow_buf_retiring get hd 1 0
    ign = omega_world_destroy
    ret false
  end
  ign = omega_world_ring
  c = omega_world_drain 10 1000
  ok = and eq c 0 and eq get g_ow_abandoned_dispatches 0 1 eq get g_ow_buf_retiring get hd 1 0
  ign = omega_world_destroy
  ret ok
end

fn run_world_lifecycle_gates to long
  put g_lc_gate_count 0 0
  put g_lc_gate_passed 0 0
  lc_record_gate m19_gate9_to_12_handles_and_fault
  lc_record_gate lc_test_revoke_waits_for_queued
  lc_record_gate ow_payload_reached 4294967295 1
  lc_record_gate not ow_payload_reached 2 1
  if eq get g_lc_gate_passed 0 get g_lc_gate_count 0
    ret 0
  end
  ret 1
end

fn run_m19r_soak to long
  hb = new ulong 5 0
  va = new ulong 1 0
  if ne omega_world_init OMEGA_WORLD_OK
    ret 1
  end
  start_live = get g_ow_rm_live_cnt 0
  ok = true
  for i ulong 64
    if ne omega_world_register_buffer 4096 or OMEGA_PERM_READ OMEGA_PERM_WRITE hb OMEGA_WORLD_OK
      ok = false
    end
    if ne omega_world_resolve_buffer hb OMEGA_PERM_WRITE 0 4096 va OMEGA_WORLD_OK
      ok = false
    end
    if ne omega_world_revoke_buffer hb OMEGA_WORLD_OK
      ok = false
    end
  end
  if ne get g_ow_rm_live_cnt 0 start_live
    ok = false
  end
  if ne omega_world_destroy OMEGA_WORLD_OK
    ok = false
  end
  if ne get g_ow_rm_live_cnt 0 0
    ok = false
  end
  if ok
    ret 0
  end
  ret 1
end

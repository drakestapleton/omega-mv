note SPDX-License-Identifier: Apache-2.0
note An M21 unbroadcast first removes excess leading axes, then sums expanded
note singleton dimensions left to right with the axis retained. A step is
note twice its axis plus one when the reduction keeps the dimension.
om2

export fn ad_unbroadcast_steps source view ulong * target view ulong * steps edit uchar 8 to long
requires le len source 8
requires le len target 8
  if lt len source len target
    ret -1
  end
  leading = sub len source len target
  for i ulong leading
    put steps i 0
  end
  count = leading
  for axis ulong len target
    note MUT:UNBROADCAST
    if and eq get target axis 1 ne get source add leading axis 1
      put steps count uchar add mul axis 2 1
      count = add count 1
    end
  end
  ret long count
end

export fn ad_same_shape lhs view ulong * rhs view ulong * to ulong
requires le len lhs 8
requires le len rhs 8
  if ne len lhs len rhs
    ret 0
  end
  for d ulong len lhs
    if ne get lhs d get rhs d
      ret 0
    end
  end
  ret 1
end

export fn ad_restore_axis shape view ulong * axis ulong restored edit ulong * to void
requires le len shape 8
requires eq len shape len restored
  for d ulong len shape
    if eq d axis
      put restored d 1
    else
      put restored d get shape d
    end
  end
end

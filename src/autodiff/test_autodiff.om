note SPDX-License-Identifier: Apache-2.0
note test_autodiff.om -- Pure seeded OM-2 M21 OMEGA_AUTODIFF reverse-mode tape tests.

global tad_c ulong 2

text tad_pass "M21_OMEGA_AUTODIFF_TESTS_PASS\n"
text tad_fail "M21_OMEGA_AUTODIFF_TESTS_FAIL\n"

fn ad_chk cond bool to void
  put tad_c 0 add get tad_c 0 1
  if not cond
    put tad_c 1 add get tad_c 1 1
  end
end

fn ad_near a f32 b f32 tol f32 to bool
  ret le fabs sub a b tol
end

fn test_basic_ops_verify ia ulong ib ulong to void
  ga = new f32 3 0.0f32
  gb = new f32 3 0.0f32
  ad_chk eq ad_grad_read_f32 ia ga AD_OK
  ad_chk eq ad_grad_read_f32 ib gb AD_OK
  ad_chk ad_near get ga 1 1.75f32 0.0001f32
  ad_chk ad_near get gb 1 5.0f32 0.0001f32
  ad_chk ad_near get ga 2 2.8333333f32 0.0001f32
  ad_chk ad_near get gb 2 10.0f32 0.0001f32
  ids = new ulong 2 0
  put ids 0 ia
  put ids 1 ib
  flat = new f32 6 0.0f32
  ad_chk eq ad_grads_flatten ids flat AD_OK
  ad_chk ad_near get flat 1 1.75f32 0.0001f32
  ad_chk ad_near get flat 4 5.0f32 0.0001f32
end

fn test_basic_ops to void
  ad_chk eq ot_ctx_init 128 OT_OK
  ad_chk eq ad_tape_init 64 1024 AD_OK
  sh = new ulong 8 0
  put sh 0 3
  da = new f32 3 0.0f32
  db = new f32 3 0.0f32
  put da 0 2.0f32
  put da 1 4.0f32
  put da 2 9.0f32
  put db 0 3.0f32
  put db 1 2.0f32
  put db 2 3.0f32
  ha = new ulong 2 0
  hb = new ulong 2 0
  ad_chk eq ot_from_f32 1 sh da ha OT_OK
  ad_chk eq ot_from_f32 1 sh db hb OT_OK
  ids = new ulong 8 0
  tmp = new ulong 1 0
  ad_chk eq ad_leaf get ha 0 get ha 1 1 tmp AD_OK
  put ids 0 get tmp 0
  ad_chk eq ad_leaf get hb 0 get hb 1 1 tmp AD_OK
  put ids 1 get tmp 0
  ad_chk eq ad_binary AD_MUL get ids 0 get ids 1 tmp AD_OK
  put ids 2 get tmp 0
  ad_chk eq ad_sqrt get ids 0 tmp AD_OK
  put ids 3 get tmp 0
  ad_chk eq ad_binary AD_ADD get ids 3 get ids 2 tmp AD_OK
  put ids 4 get tmp 0
  ad_chk eq ad_binary AD_DIV get ids 0 get ids 1 tmp AD_OK
  put ids 5 get tmp 0
  ad_chk eq ad_binary AD_SUB get ids 4 get ids 5 tmp AD_OK
  put ids 6 get tmp 0
  ad_chk eq ad_reduce AD_SUM get ids 6 0 0 tmp AD_OK
  put ids 7 get tmp 0
  ad_chk eq ad_backward get ids 7 AD_OK
  ad_chk eq ad_backward get ids 7 AD_ERR_STATE
  test_basic_ops_verify get ids 0 get ids 1
  ad_tape_release
  r1 = ot_release get ha 0 get ha 1
  r1 = ot_release get hb 0 get hb 1
  lc = new ulong 2 0
  ot_live_counts lc
  ad_chk and eq get lc 0 0 eq get lc 1 0
end

fn test_matmul_max_mean_bcast to void
  ad_chk eq ot_ctx_init 128 OT_OK
  ad_chk eq ad_tape_init 64 1024 AD_OK
  sha = new ulong 8 0
  shb = new ulong 8 0
  shc = new ulong 8 0
  put sha 0 2
  put sha 1 2
  put shb 0 2
  put shb 1 2
  put shc 0 2
  da = new f32 4 0.0f32
  db = new f32 4 0.0f32
  dc = new f32 2 0.0f32
  put da 0 1.0f32
  put da 1 2.0f32
  put da 2 3.0f32
  put da 3 4.0f32
  put db 0 2.0f32
  put db 1 -1.0f32
  put db 2 0.0f32
  put db 3 3.0f32
  put dc 0 0.0f32
  put dc 1 5.0f32
  ha = new ulong 2 0
  hb = new ulong 2 0
  hc = new ulong 2 0
  ad_chk eq ot_from_f32 2 sha da ha OT_OK
  ad_chk eq ot_from_f32 2 shb db hb OT_OK
  ad_chk eq ot_from_f32 1 shc dc hc OT_OK
  ids = new ulong 8 0
  tmp = new ulong 1 0
  ad_chk eq ad_leaf get ha 0 get ha 1 1 tmp AD_OK
  put ids 0 get tmp 0
  ad_chk eq ad_leaf get hb 0 get hb 1 1 tmp AD_OK
  put ids 1 get tmp 0
  ad_chk eq ad_leaf get hc 0 get hc 1 1 tmp AD_OK
  put ids 2 get tmp 0
  ad_chk eq ad_matmul get ids 0 get ids 1 tmp AD_OK
  put ids 3 get tmp 0
  ad_chk eq ad_binary AD_MAX get ids 3 get ids 2 tmp AD_OK
  put ids 4 get tmp 0
  ad_chk eq ad_reduce AD_MEAN get ids 4 1 0 tmp AD_OK
  put ids 5 get tmp 0
  ad_chk eq ad_reduce AD_MEAN get ids 5 0 0 tmp AD_OK
  put ids 6 get tmp 0
  ad_chk eq ad_backward get ids 6 AD_OK
  gc = new f32 2 0.0f32
  ad_chk eq ad_grad_read_f32 get ids 2 gc AD_OK
  ad_chk ad_near get gc 0 0.0f32 0.0001f32
  ad_chk ad_near get gc 1 0.25f32 0.0001f32
  ad_tape_release
end

fn test_transpose_and_seed to void
  ad_chk eq ot_ctx_init 128 OT_OK
  ad_chk eq ad_tape_init 64 1024 AD_OK
  sh = new ulong 8 0
  put sh 0 2
  put sh 1 3
  dat = new f32 6 0.0f32
  for i ulong 6
    put dat i f32 add i 1
  end
  ha = new ulong 2 0
  ad_chk eq ot_from_f32 2 sh dat ha OT_OK
  ia = new ulong 1 0
  it = new ulong 1 0
  ad_chk eq ad_leaf get ha 0 get ha 1 1 ia AD_OK
  ad_chk eq ad_transpose get ia 0 it AD_OK
  shs = new ulong 8 0
  put shs 0 3
  put shs 1 2
  sd = new f32 6 0.0f32
  for i ulong 6
    put sd i f32 add i 10
  end
  hs = new ulong 2 0
  ad_chk eq ot_from_f32 2 shs sd hs OT_OK
  ad_chk eq ad_backward_seed get it 0 get hs 0 get hs 1 AD_OK
  ga = new f32 6 0.0f32
  ad_chk eq ad_grad_read_f32 get ia 0 ga AD_OK
  ad_chk eq get ga 0 10.0f32
  ad_chk eq get ga 1 12.0f32
  ad_chk eq get ga 2 14.0f32
  ad_chk eq get ga 3 11.0f32
  ad_chk eq get ga 4 13.0f32
  ad_chk eq get ga 5 15.0f32
  ad_tape_release
end

fn main to int
  test_basic_ops
  test_matmul_max_mean_bcast
  test_transpose_and_seed
  if ne get tad_c 1 0
    w = write 1 tad_fail 0 len tad_fail
    ret 1
  end
  w = write 1 tad_pass 0 len tad_pass
  ret 0
end

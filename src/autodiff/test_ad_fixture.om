note SPDX-License-Identifier: Apache-2.0
note test_ad_fixture.om -- Pure seeded OM-2 AD fixture oracle for the native .om tape
note (native/autodiff664, omega #664). Host mode port of tests/test_omega_ad_fixture.c.
note
note   test_omega_ad_fixture --host|--chip [--mutant-sign] FIXTURE
note
note Rebuilds the 2-layer MLP + squared-error graph on the pure OM-2 M21 tape over
note the M20 CPU realization, runs backward, and compares all 75 values:
note Y[8,2], loss, dW1[4,8], db1[8], dW2[8,2], db2[2].

const ADF_FM ulong 8
const ADF_FK ulong 4
const ADF_FH ulong 8
const ADF_FN ulong 2

const ADF_OFF_X ulong 6
const ADF_OFF_W1 ulong 38
const ADF_OFF_B1 ulong 70
const ADF_OFF_W2 ulong 78
const ADF_OFF_B2 ulong 94
const ADF_OFF_T ulong 96
const ADF_OFF_Y ulong 112
const ADF_OFF_L ulong 128
const ADF_OFF_DW1 ulong 129
const ADF_OFF_DB1 ulong 161
const ADF_OFF_DW2 ulong 169
const ADF_OFF_DB2 ulong 185
const ADF_FIX_WORDS ulong 187
const ADF_FIX_BYTES ulong 748
const ADF_NCMP ulong 75
const ADF_U32_MAX ulong 0xffffffff

global adf_w uint 187
global adf_raw uchar 749
global adf_path uchar 512
global adf_argv0 uchar 512
global adf_arg uchar 512
global adf_lens ulong 3
note adf_lens: 0=argv0_len, 1=path_len, 2=flags(bit0=chip, bit1=mutant, bit2=has_path)
global adf_lv ulong 14
global adf_ids ulong 18
global adf_got f32 75

text adf_t_host "--host"
text adf_t_chip "--chip"
text adf_t_mut "--mutant-sign"
text adf_t_usage1 "usage: "
text adf_t_usage2 " --host|--chip [--mutant-sign] FIXTURE\n"
text adf_t_nochip "--chip refused: built without OMEGA_AD_FIXTURE_CHIP\n"
text adf_t_open "AD_FIXTURE: cannot open "
text adf_t_size1 "AD_FIXTURE: size "
text adf_t_size2 ", want 748\n"
text adf_t_magic "AD_FIXTURE: bad magic\n"
text adf_t_ver "AD_FIXTURE: bad version or dimensions\n"
text adf_t_ctx "AD_FIXTURE: ctx\n"
text adf_t_err1 "AD_FIXTURE_HOST: C tape error "
text adf_t_err2 " (numeric 0)\n"
text adf_t_word1 "AD_FIXTURE_HOST: word "
text adf_t_word2 " native "
text adf_t_word3 " C "
text adf_t_word4 " ulp "
text adf_t_sum1 "AD_FIXTURE_HOST: exact="
text adf_t_sum2 "/75 max_ulp="
text adf_t_sum3 " verdict="
text adf_t_inf "inf"
text adf_t_pass "PASS"
text adf_t_passtol "PASS_TOL"
text adf_t_fail "FAIL"
text adf_t_msuf " (mutant-sign)"
text adf_t_minus "-"
text adf_t_nl "\n"

fn adf_w_u64 fd int v ulong to void
  buf = new uchar 24 0
  tmp = new uchar 24 0
  if eq v 0
    put buf 0 uchar 48
    w = write fd buf 0 1
    ret
  end
  cnt = ulong 0
  x = v
  while gt x 0 bound 24
    put tmp cnt uchar add 48 rem x 10
    cnt = add cnt 1
    x = div x 10
  end
  for i ulong cnt bound 24
    put buf i get tmp sub sub cnt 1 i
  end
  w = write fd buf 0 cnt
end

fn adf_w_i64 fd int v long to void
  if lt v 0
    w = write fd adf_t_minus 0 1
    adf_w_u64 fd ulong sub 0 v
    ret
  end
  adf_w_u64 fd ulong v
end

fn adf_w_hex8 fd int v uint to void
  buf = new uchar 8 0
  for i ulong 8
    sh = mul sub 7 i 4
    nib = and shr v uint sh uint 15
    if lt nib uint 10
      put buf i uchar add 48 ulong nib
    else
      put buf i uchar add 87 ulong nib
    end
  end
  w = write fd buf 0 8
end

fn adf_arg_eq_text n ulong t view uchar * to bool
  if ne n len t
    ret false
  end
  for i ulong n bound 512
    if ne get adf_arg i get t i
      ret false
    end
  end
  ret true
end

fn adf_parse_args to long
  nargs = ulong argcnt
  a0 = argread 0 adf_argv0 0 512
  if lt a0 0
    put adf_lens 0 0
  else
    put adf_lens 0 ulong a0
  end
  put adf_lens 1 0
  put adf_lens 2 0
  chip = ulong 0
  mut = ulong 0
  has_p = ulong 0
  bad = ulong 0
  for i ulong nargs bound 64
    if gt i 0
      al = argread i adf_arg 0 512
      if lt al 0
        bad = 1
        break
      end
      aln = ulong al
      if adf_arg_eq_text aln adf_t_host
        chip = 0
      else
        if adf_arg_eq_text aln adf_t_chip
          chip = 1
        else
          if adf_arg_eq_text aln adf_t_mut
            mut = 1
          else
            if eq has_p 0
              for k ulong aln bound 512
                put adf_path k get adf_arg k
              end
              put adf_lens 1 aln
              has_p = 1
            else
              has_p = 0
              bad = 1
              break
            end
          end
        end
      end
    end
  end
  if or ne bad 0 eq has_p 0
    w1 = write 1 adf_t_usage1 0 len adf_t_usage1
    w2 = write 1 adf_argv0 0 get adf_lens 0
    w3 = write 1 adf_t_usage2 0 len adf_t_usage2
    ret 2
  end
  put adf_lens 2 add chip add mul mut 2 mul has_p 4
  ret 0
end

fn adf_load_fixture to long
  pl = get adf_lens 1
  fd = fopen adf_path 0 pl 0 0
  if lt fd 0
    w1 = write 1 adf_t_open 0 len adf_t_open
    w2 = write 1 adf_path 0 pl
    w3 = write 1 adf_t_nl 0 1
    ret 2
  end
  got = ulong 0
  while lt got 749 bound 1024
    r = read int fd adf_raw got sub 749 got
    if le r 0
      break
    end
    got = add got ulong r
  end
  cc = fclose int fd
  if ne got ADF_FIX_BYTES
    w1 = write 1 adf_t_size1 0 len adf_t_size1
    adf_w_u64 1 got
    w2 = write 1 adf_t_size2 0 len adf_t_size2
    ret 2
  end
  bad_m = false
  if ne get adf_raw 0 uchar 65
    bad_m = true
  end
  if ne get adf_raw 1 uchar 68
    bad_m = true
  end
  if ne get adf_raw 2 uchar 70
    bad_m = true
  end
  if ne get adf_raw 3 uchar 88
    bad_m = true
  end
  if bad_m
    w1 = write 1 adf_t_magic 0 len adf_t_magic
    ret 2
  end
  for i ulong ADF_FIX_WORDS
    b = mul i 4
    w0 = uint get adf_raw b
    w1 = shl uint get adf_raw add b 1 8
    w2 = shl uint get adf_raw add b 2 16
    w3 = shl uint get adf_raw add b 3 24
    put adf_w i or or w0 w1 or w2 w3
  end
  bad_v = false
  if ne get adf_w 1 uint 1
    bad_v = true
  end
  if ne get adf_w 2 uint ADF_FM
    bad_v = true
  end
  if ne get adf_w 3 uint ADF_FK
    bad_v = true
  end
  if ne get adf_w 4 uint ADF_FH
    bad_v = true
  end
  if ne get adf_w 5 uint ADF_FN
    bad_v = true
  end
  if bad_v
    w1 = write 1 adf_t_ver 0 len adf_t_ver
    ret 2
  end
  ret 0
end

fn adf_ulps a f32 b f32 to ulong
  if eq a b
    ret 0
  end
  ua = bitcast uint a
  ub = bitcast uint b
  if or eq and ua uint 0x7f800000 uint 0x7f800000 eq and ub uint 0x7f800000 uint 0x7f800000
    ret ADF_U32_MAX
  end
  if ne and xor ua ub uint 0x80000000 uint 0
    ret ADF_U32_MAX
  end
  if gt ua ub
    ret ulong sub ua ub
  end
  ret ulong sub ub ua
end

fn adf_leaf off ulong r ulong c ulong rg ulong lv_idx ulong id_slot ulong to long
  v = new f32 64 0.0f32
  n = mul r c
  for i ulong n bound 64
    if ne off 0
      put v i bitcast f32 get adf_w add off i
    else
      put v i 0.0f32
    end
  end
  sh = new ulong 8 0
  put sh 0 r
  put sh 1 c
  h = new ulong 2 0
  rc = ot_from_f32 2 sh part v 0 n h
  if ne rc OT_OK
    ret rc
  end
  put adf_lv mul lv_idx 2 get h 0
  put adf_lv add mul lv_idx 2 1 get h 1
  ido = new ulong 1 0
  rc = ad_leaf get h 0 get h 1 rg ido
  if ne rc AD_OK
    ret rc
  end
  put adf_ids id_slot get ido 0
  ret 0
end

fn adf_build_leaves to long
  rc = adf_leaf ADF_OFF_X ADF_FM ADF_FK 0 0 0
  if ne rc 0
    ret rc
  end
  rc = adf_leaf ADF_OFF_W1 ADF_FK ADF_FH 1 1 1
  if ne rc 0
    ret rc
  end
  rc = adf_leaf ADF_OFF_B1 1 ADF_FH 1 2 2
  if ne rc 0
    ret rc
  end
  rc = adf_leaf ADF_OFF_W2 ADF_FH ADF_FN 1 3 3
  if ne rc 0
    ret rc
  end
  rc = adf_leaf ADF_OFF_B2 1 ADF_FN 1 4 4
  if ne rc 0
    ret rc
  end
  rc = adf_leaf ADF_OFF_T ADF_FM ADF_FN 0 5 5
  if ne rc 0
    ret rc
  end
  ret adf_leaf 0 ADF_FM ADF_FH 0 6 6
end

fn adf_build_mlp1 to long
  ido = new ulong 1 0
  rc = ad_matmul get adf_ids 0 get adf_ids 1 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 7 get ido 0
  sh88 = new ulong 8 0
  put sh88 0 ADF_FM
  put sh88 1 ADF_FH
  rc = ad_broadcast get adf_ids 2 2 sh88 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 8 get ido 0
  rc = ad_binary AD_ADD get adf_ids 7 get adf_ids 8 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 9 get ido 0
  rc = ad_binary AD_MAX get adf_ids 9 get adf_ids 6 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 10 get ido 0
  ret 0
end

fn adf_build_mlp2 to long
  ido = new ulong 1 0
  rc = ad_matmul get adf_ids 10 get adf_ids 3 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 11 get ido 0
  sh82 = new ulong 8 0
  put sh82 0 ADF_FM
  put sh82 1 ADF_FN
  rc = ad_broadcast get adf_ids 4 2 sh82 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 12 get ido 0
  rc = ad_binary AD_ADD get adf_ids 11 get adf_ids 12 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 13 get ido 0
  rc = ad_binary AD_SUB get adf_ids 13 get adf_ids 5 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 14 get ido 0
  rc = ad_binary AD_MUL get adf_ids 14 get adf_ids 14 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 15 get ido 0
  rc = ad_reduce AD_SUM get adf_ids 15 1 1 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 16 get ido 0
  rc = ad_reduce AD_SUM get adf_ids 16 0 1 ido
  if ne rc 0
    ret rc
  end
  put adf_ids 17 get ido 0
  ret ad_backward get adf_ids 17
end

fn adf_copy_got dst_off ulong n ulong src view f32 * to void
  for i ulong n bound 64
    put adf_got add dst_off i get src i
  end
end

fn adf_read_val node_id ulong dst_off ulong n ulong to long
  nb = mul node_id 12
  vs = get ad_nodes add nb 8
  vg = get ad_nodes add nb 9
  buf = new f32 32 0.0f32
  rc = ot_read_f32 vs vg part buf 0 n
  if ne rc OT_OK
    ret rc
  end
  adf_copy_got dst_off n part buf 0 n
  ret 0
end

fn adf_read_grad node_id ulong dst_off ulong n ulong to long
  buf = new f32 32 0.0f32
  rc = ad_grad_read_f32 node_id part buf 0 n
  if ne rc AD_OK
    ret rc
  end
  adf_copy_got dst_off n part buf 0 n
  ret 0
end

fn adf_collect_outputs to long
  rc = adf_read_val get adf_ids 13 0 16
  if ne rc 0
    ret rc
  end
  rc = adf_read_val get adf_ids 17 16 1
  if ne rc 0
    ret rc
  end
  rc = adf_read_grad get adf_ids 1 17 32
  if ne rc 0
    ret rc
  end
  rc = adf_read_grad get adf_ids 2 49 8
  if ne rc 0
    ret rc
  end
  rc = adf_read_grad get adf_ids 3 57 16
  if ne rc 0
    ret rc
  end
  ret adf_read_grad get adf_ids 4 73 2
end

fn adf_compare_and_print mut ulong to int
  exact = ulong 0
  max_ulp = ulong 0
  comp = true
  for i ulong ADF_NCMP
    g = get adf_got i
    exp_u = get adf_w add ADF_OFF_Y i
    u = adf_ulps g bitcast f32 exp_u
    if eq u 0
      exact = add exact 1
    end
    if eq u ADF_U32_MAX
      comp = false
    else
      if gt u max_ulp
        max_ulp = u
      end
    end
    if ne u 0
      w1 = write 1 adf_t_word1 0 len adf_t_word1
      adf_w_u64 1 add ADF_OFF_Y i
      w2 = write 1 adf_t_word2 0 len adf_t_word2
      adf_w_hex8 1 exp_u
      w3 = write 1 adf_t_word3 0 len adf_t_word3
      adf_w_hex8 1 bitcast uint g
      w4 = write 1 adf_t_word4 0 len adf_t_word4
      adf_w_u64 1 u
      w5 = write 1 adf_t_nl 0 1
    end
  end
  w1 = write 1 adf_t_sum1 0 len adf_t_sum1
  adf_w_u64 1 exact
  w2 = write 1 adf_t_sum2 0 len adf_t_sum2
  if comp
    adf_w_u64 1 max_ulp
  else
    wi = write 1 adf_t_inf 0 len adf_t_inf
  end
  w3 = write 1 adf_t_sum3 0 len adf_t_sum3
  rc_out = int 0
  if or not comp gt max_ulp 2
    wv = write 1 adf_t_fail 0 len adf_t_fail
    rc_out = 1
  else
    if ne max_ulp 0
      wv = write 1 adf_t_passtol 0 len adf_t_passtol
    else
      wv = write 1 adf_t_pass 0 len adf_t_pass
    end
  end
  if ne mut 0
    wm = write 1 adf_t_msuf 0 len adf_t_msuf
  end
  wn = write 1 adf_t_nl 0 1
  ret rc_out
end

fn adf_release_leaves to void
  for i ulong 7
    s = get adf_lv mul i 2
    g = get adf_lv add mul i 2 1
    rr = ot_release s g
  end
end

fn adf_run_graph to long
  rc = ad_tape_init 32 192
  if eq rc 0
    rc = adf_build_leaves
  end
  if eq rc 0
    rc = adf_build_mlp1
  end
  if eq rc 0
    rc = adf_build_mlp2
  end
  if eq rc 0
    rc = adf_collect_outputs
  end
  ret rc
end

fn main to int
  prc = adf_parse_args
  if ne prc 0
    ret int prc
  end
  flags = get adf_lens 2
  if ne and flags 1 0
    w1 = write 1 adf_t_nochip 0 len adf_t_nochip
    ret 2
  end
  lrc = adf_load_fixture
  if ne lrc 0
    ret int lrc
  end
  mut = and shr flags 1 1
  if ne mut 0
    for i ulong 32
      idx = add ADF_OFF_DW1 i
      put adf_w idx xor get adf_w idx uint 0x80000000
    end
  end
  if ne ot_ctx_init 256 OT_OK
    w2 = write 1 adf_t_ctx 0 len adf_t_ctx
    ret 2
  end
  rc = adf_run_graph
  if ne rc 0
    w3 = write 1 adf_t_err1 0 len adf_t_err1
    adf_w_i64 1 rc
    w4 = write 1 adf_t_err2 0 len adf_t_err2
    ad_tape_release
    ret 2
  end
  out_rc = adf_compare_and_print mut
  ad_tape_release
  adf_release_leaves
  ret out_rc
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/language/omega_lex.c:
note identifier/digit classification, 64-bit integer literal decoder (dec/0x/0b),
note keyword lookup, and punctuation/operator classifier.
om2

fn l_ident_start c ulong to ulong
  if and ge c 97 le c 122
    ret 1
  end
  if and ge c 65 le c 90
    ret 1
  end
  if eq c 95
    ret 1
  end
  ret 0
end

fn l_ident_char c ulong to ulong
  if eq l_ident_start c 1
    ret 1
  end
  if and ge c 48 le c 57
    ret 1
  end
  ret 0
end

fn l_digit_val c ulong to ulong
  if and ge c 48 le c 57
    ret sub c 48
  end
  if and ge c 97 le c 102
    ret add sub c 97 10
  end
  if and ge c 65 le c 70
    ret add sub c 65 10
  end
  ret 99
end

export fn lang_om_is_ident_start c ulong to ulong
  ret l_ident_start c
end

export fn lang_om_is_ident_char c ulong to ulong
  ret l_ident_char c
end

export fn lang_om_digit_value c ulong to ulong
  ret l_digit_val c
end

export fn lang_om_lex_int src view uchar * slen ulong pos ulong dst edit ulong 3 to ulong
  base = ulong 10
  p = pos
  if lt add p 1 slen
    if eq ulong get src p 48
      nx = ulong get src add p 1
      if eq nx 120
        base = 16
        p = add p 2
      else
        if eq nx 98
          base = 2
          p = add p 2
        end
      end
    end
  end
  start = p
  v = ulong 0
  ovf = ulong 0
  maxu = ulong 0xffffffffffffffff
  while lt p slen
    d = l_digit_val ulong get src p
    if ge d base
      break
    end
    if gt v div sub maxu d base
      ovf = 1
    else
      v = add mul v base d
    end
    p = add p 1
  end
  put dst 0 p
  put dst 1 v
  put dst 2 base
  if eq p start
    ret 1
  end
  if lt p slen
    if eq l_ident_char ulong get src p 1
      put dst 2 add p 1
      ret 2
    end
  end
  if ne ovf 0
    ret 3
  end
  ret 0
end

fn l_kw_short w view uchar * n ulong to ulong
  if eq n 2
    if ne ulong get w 0 102
      ret 1
    end
    if ne ulong get w 1 110
      ret 1
    end
    ret 4
  end
  if eq n 3
    if ne ulong get w 0 108
      ret 1
    end
    if ne ulong get w 1 101
      ret 1
    end
    if ne ulong get w 2 116
      ret 1
    end
    ret 3
  end
  if eq n 4
    if ne ulong get w 0 116
      ret 1
    end
    if ne ulong get w 1 114
      ret 1
    end
    if ne ulong get w 2 117
      ret 1
    end
    if ne ulong get w 3 101
      ret 1
    end
    ret 7
  end
  if eq n 5
    if ne ulong get w 0 102
      ret 1
    end
    if ne ulong get w 1 97
      ret 1
    end
    if ne ulong get w 2 108
      ret 1
    end
    if ne ulong get w 3 115
      ret 1
    end
    if ne ulong get w 4 101
      ret 1
    end
    ret 8
  end
  ret 1
end

fn l_kw_long w view uchar * n ulong to ulong
  if eq n 7
    if ne ulong get w 0 101
      ret 1
    end
    if ne ulong get w 1 110
      ret 1
    end
    if ne ulong get w 2 115
      ret 1
    end
    if ne ulong get w 3 117
      ret 1
    end
    if ne ulong get w 4 114
      ret 1
    end
    if ne ulong get w 5 101
      ret 1
    end
    if ne ulong get w 6 115
      ret 1
    end
    ret 6
  end
  if eq n 8
    if ne ulong get w 0 114
      ret 1
    end
    if ne ulong get w 1 101
      ret 1
    end
    if ne ulong get w 2 113
      ret 1
    end
    if ne ulong get w 3 117
      ret 1
    end
    if ne ulong get w 4 105
      ret 1
    end
    if ne ulong get w 5 114
      ret 1
    end
    if ne ulong get w 6 101
      ret 1
    end
    if ne ulong get w 7 115
      ret 1
    end
    ret 5
  end
  ret 1
end

export fn lang_om_keyword w view uchar * n ulong to ulong
  if le n 5
    ret l_kw_short w n
  end
  ret l_kw_long w n
end

fn l_punct_single c ulong to ulong
  if eq c 40
    ret 9
  end
  if eq c 41
    ret 10
  end
  if eq c 123
    ret 11
  end
  if eq c 125
    ret 12
  end
  if eq c 58
    ret 13
  end
  if eq c 44
    ret 14
  end
  if eq c 43
    ret 17
  end
  if eq c 42
    ret 19
  end
  if eq c 47
    ret 20
  end
  if eq c 38
    ret 21
  end
  if eq c 124
    ret 22
  end
  ret 0
end

export fn lang_om_punct c ulong d ulong dst edit ulong 2 to ulong
  s = l_punct_single c
  if ne s 0
    put dst 0 s
    put dst 1 1
    ret 0
  end
  if eq c 45
    if eq d 62
      put dst 0 15
      put dst 1 2
    else
      put dst 0 18
      put dst 1 1
    end
    ret 0
  end
  if eq c 61
    if eq d 61
      put dst 0 23
      put dst 1 2
    else
      put dst 0 16
      put dst 1 1
    end
    ret 0
  end
  if eq c 33
    if eq d 61
      put dst 0 24
      put dst 1 2
    else
      put dst 0 29
      put dst 1 1
    end
    ret 0
  end
  if eq c 60
    if eq d 61
      put dst 0 26
      put dst 1 2
    else
      put dst 0 25
      put dst 1 1
    end
    ret 0
  end
  if eq c 62
    if eq d 61
      put dst 0 28
      put dst 1 2
    else
      put dst 0 27
      put dst 1 1
    end
    ret 0
  end
  if or eq c 34 eq c 39
    ret 2
  end
  if or eq c 91 eq c 93
    ret 3
  end
  ret 1
end

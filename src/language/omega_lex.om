note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Surface Language V0 lexer (replaces src/language/omega_lex.c).
note Depends on src/visor/visor.om.

text olx_kw_let "let"
text olx_kw_fn "fn"
text olx_kw_req "requires"
text olx_kw_ens "ensures"
text olx_kw_true "true"
text olx_kw_false "false"
text olx_ty_u8 "u8"
text olx_ty_u16 "u16"
text olx_ty_u32 "u32"
text olx_ty_u64 "u64"
text olx_ty_bool "bool"
text olx_ty_i8 "i8"
text olx_ty_i16 "i16"
text olx_ty_i32 "i32"
text olx_ty_i64 "i64"

note Token kinds:
note 0=EOF 1=IDENT 2=INT 3=LET 4=FN 5=REQ 6=ENS 7=TRUE 8=FALSE
note 10=U8 11=U16 12=U32 13=U64 14=BOOL 15=SIGNED
note 20=( 21=) 22={ 23=} 24=: 25=, 26=-> 27==
note 30=+ 31=- 32=* 33=/ 34=& 35=|
note 40=== 41=!= 42=< 43=<= 44=> 45=>= 46=!

global olx_line uchar 4096
global olx_llen ulong 1
global olx_err uchar 256
global olx_elen ulong 1
global olx_tcnt ulong 1
global olx_tkind ulong 256
global olx_tcol ulong 256
global olx_tval ulong 256
global olx_tstr uchar 16384
global olx_tslen ulong 256

fn olx_set_err msg view uchar * col ulong to void
  ob_reset 255
  ob_puts msg
  n = get v_ob_len 0
  for i ulong n bound 255
    put olx_err i get v_ob i
  end
  put olx_elen 0 n
end

fn olx_is_id_start c ulong to bool
  if and ge c 97 le c 122
    ret true
  end
  if and ge c 65 le c 90
    ret true
  end
  if eq c 95
    ret true
  end
  ret false
end

fn olx_is_id_char c ulong to bool
  if olx_is_id_start c
    ret true
  end
  if and ge c 48 le c 57
    ret true
  end
  ret false
end

fn olx_dval c ulong to ulong
  if and ge c 48 le c 57
    ret sub c 48
  end
  if and ge c 97 le c 102
    ret add sub c 97 10
  end
  if and ge c 65 le c 70
    ret add sub c 65 10
  end
  ret 99
end

fn olx_tok_eq tidx ulong s view uchar * to bool
  n = len s
  if ne get olx_tslen tidx n
    ret false
  end
  base = mul tidx 64
  for i ulong n bound 64
    if ne get olx_tstr add base i get s i
      ret false
    end
  end
  ret true
end

fn olx_classify_kw tidx ulong to ulong
  if olx_tok_eq tidx olx_kw_let
    ret 3
  end
  if olx_tok_eq tidx olx_kw_fn
    ret 4
  end
  if olx_tok_eq tidx olx_kw_req
    ret 5
  end
  if olx_tok_eq tidx olx_kw_ens
    ret 6
  end
  if olx_tok_eq tidx olx_kw_true
    ret 7
  end
  if olx_tok_eq tidx olx_kw_false
    ret 8
  end
  if olx_tok_eq tidx olx_ty_u8
    ret 10
  end
  if olx_tok_eq tidx olx_ty_u16
    ret 11
  end
  if olx_tok_eq tidx olx_ty_u32
    ret 12
  end
  if olx_tok_eq tidx olx_ty_u64
    ret 13
  end
  if olx_tok_eq tidx olx_ty_bool
    ret 14
  end
  if olx_tok_eq tidx olx_ty_i8
    ret 15
  end
  if olx_tok_eq tidx olx_ty_i16
    ret 15
  end
  if olx_tok_eq tidx olx_ty_i32
    ret 15
  end
  if olx_tok_eq tidx olx_ty_i64
    ret 15
  end
  ret 1
end

text olx_e_ovf "integer literal overflows u64"
text olx_e_badnum "malformed integer literal"
text olx_e_cmt "unterminated block comment"
text olx_e_tok "too many tokens"
text olx_e_idlen "identifier too long"
text olx_e_chr "unexpected character"

fn olx_lex_int pos ulong slen ulong tidx ulong to long
  base = ulong 10
  p = pos
  if lt add p 1 slen
    if eq ulong get olx_line p 48
      nx = ulong get olx_line add p 1
      if eq nx 120
        base = 16
        p = add p 2
      else
        if eq nx 98
          base = 2
          p = add p 2
        end
      end
    end
  end
  start = p
  v = ulong 0
  ovf = ulong 0
  maxu = ulong 0xffffffffffffffff
  while lt p slen bound 4096
    d = olx_dval ulong get olx_line p
    if ge d base
      break
    end
    if gt v div sub maxu d base
      ovf = 1
    else
      v = add mul v base d
    end
    p = add p 1
  end
  if eq p start
    olx_set_err olx_e_badnum add pos 1
    ret -1
  end
  if lt p slen
    if olx_is_id_char ulong get olx_line p
      olx_set_err olx_e_badnum add p 1
      ret -1
    end
  end
  if ne ovf 0
    olx_set_err olx_e_ovf add pos 1
    ret -1
  end
  put olx_tkind tidx 2
  put olx_tcol tidx add pos 1
  put olx_tval tidx v
  put olx_tslen tidx 0
  ret long p
end

fn olx_lex_punct c ulong c2 ulong to long
  if eq c 40
    ret 20
  end
  if eq c 41
    ret 21
  end
  if eq c 123
    ret 22
  end
  if eq c 125
    ret 23
  end
  if eq c 58
    ret 24
  end
  if eq c 44
    ret 25
  end
  if eq c 43
    ret 30
  end
  if eq c 42
    ret 32
  end
  if eq c 47
    ret 33
  end
  if eq c 38
    ret 34
  end
  if eq c 124
    ret 35
  end
  if eq c 45
    if eq c2 62
      ret 126
    end
    ret 31
  end
  if eq c 61
    if eq c2 61
      ret 140
    end
    ret 27
  end
  if eq c 33
    if eq c2 61
      ret 141
    end
    ret 46
  end
  if eq c 60
    if eq c2 61
      ret 143
    end
    ret 42
  end
  if eq c 62
    if eq c2 61
      ret 145
    end
    ret 44
  end
  ret -1
end

fn olx_skip_block_cmt start ulong slen ulong to long
  p = start
  while lt add p 1 slen bound 4096
    c1 = ulong get olx_line p
    c2 = ulong get olx_line add p 1
    if and eq c1 42 eq c2 47
      ret long add p 2
    end
    p = add p 1
  end
  olx_set_err olx_e_cmt add start 1
  ret -1
end

fn olx_lex_ident start ulong slen ulong cnt ulong to long
  p = start
  while lt p slen bound 4096
    if not olx_is_id_char ulong get olx_line p
      break
    end
    p = add p 1
  end
  idlen = sub p start
  if gt idlen 63
    olx_set_err olx_e_idlen add start 1
    ret -1
  end
  tb = mul cnt 64
  for i ulong idlen bound 64
    put olx_tstr add tb i get olx_line add start i
  end
  put olx_tslen cnt idlen
  put olx_tcol cnt add start 1
  put olx_tval cnt 0
  put olx_tkind cnt olx_classify_kw cnt
  ret long p
end

fn olx_lex_line to long
  put olx_tcnt 0 0
  put olx_elen 0 0
  slen = get olx_llen 0
  p = ulong 0
  while lt p slen bound 4096
    c = ulong get olx_line p
    if or eq c 32 or eq c 9 or eq c 13 eq c 10
      p = add p 1
      continue
    end
    if and eq c 47 lt add p 1 slen
      nx = ulong get olx_line add p 1
      if eq nx 47
        break
      end
      if eq nx 42
        np = olx_skip_block_cmt add p 2 slen
        if lt np 0
          ret -1
        end
        p = ulong np
        continue
      end
    end
    cnt = get olx_tcnt 0
    if ge cnt 254
      olx_set_err olx_e_tok add p 1
      ret -1
    end
    if and ge c 48 le c 57
      np = olx_lex_int p slen cnt
      if lt np 0
        ret -1
      end
      put olx_tcnt 0 add cnt 1
      p = ulong np
      continue
    end
    if olx_is_id_start c
      np = olx_lex_ident p slen cnt
      if lt np 0
        ret -1
      end
      put olx_tcnt 0 add cnt 1
      p = ulong np
      continue
    end
    c2 = ulong 0
    if lt add p 1 slen
      c2 = ulong get olx_line add p 1
    end
    pk = olx_lex_punct c c2
    if lt pk 0
      olx_set_err olx_e_chr add p 1
      ret -1
    end
    put olx_tcol cnt add p 1
    put olx_tslen cnt 0
    put olx_tval cnt 0
    if ge pk 100
      put olx_tkind cnt ulong sub pk 100
      p = add p 2
    else
      put olx_tkind cnt ulong pk
      p = add p 1
    end
    put olx_tcnt 0 add cnt 1
  end
  cnt = get olx_tcnt 0
  put olx_tkind cnt 0
  put olx_tcol cnt add slen 1
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Surface Language V0 recursive-descent parser
note (replaces src/language/omega_parse.c). Depends on omega_lex.om.

note Statement kinds: 0=EMPTY 1=EXPR 2=LET 3=FN
note AST node kinds: 1=INT 2=BOOL 3=NAME 4=BIN 5=ASCRIBE

global opr_pos ulong 1
global opr_depth ulong 1
global opr_stmt ulong 1
global opr_root long 1
global opr_ncnt ulong 1
global opr_nkind ulong 128
global opr_ncol ulong 128
global opr_nop ulong 128
global opr_nlhs long 128
global opr_nrhs long 128
global opr_nval ulong 128
global opr_nstr uchar 8192
global opr_nslen ulong 128
global opr_nttag ulong 128
global opr_ntwid ulong 128

global opr_name uchar 64
global opr_nlen ulong 1
global opr_lttag ulong 1
global opr_ltwid ulong 1
global opr_param uchar 64
global opr_plen ulong 1
global opr_pttag ulong 1
global opr_ptwid ulong 1
global opr_rttag ulong 1
global opr_rtwid ulong 1

text opr_e_depth "expression nesting too deep"
text opr_e_nodes "expression too large"
text opr_e_type "expected unsigned integer or bool type"
text opr_e_signed "signed types are not supported in V0"
text opr_e_prim "expected expression"
text opr_e_rparen "expected ')'"
text opr_e_extra "unexpected trailing tokens"
text opr_e_let "malformed let statement"
text opr_e_fn "malformed fn declaration"
text opr_e_res "reserved keyword not allowed as identifier"

text opr_r_auth "authorize"
text opr_r_sub "submit"
text opr_r_exec "execute"
text opr_r_mint "mint"
text opr_r_grant "grant"
text opr_r_rev "revoke"
text opr_r_pub "publish"
text opr_r_prom "promote"
text opr_r_cap "capability"
text opr_r_eff "effect"
text opr_r_sys "syscall"
text opr_r_adm "admin"

fn opr_is_reserved tidx ulong to bool
  if olx_tok_eq tidx opr_r_auth
    ret true
  end
  if olx_tok_eq tidx opr_r_sub
    ret true
  end
  if olx_tok_eq tidx opr_r_exec
    ret true
  end
  if olx_tok_eq tidx opr_r_mint
    ret true
  end
  if olx_tok_eq tidx opr_r_grant
    ret true
  end
  if olx_tok_eq tidx opr_r_rev
    ret true
  end
  if olx_tok_eq tidx opr_r_pub
    ret true
  end
  if olx_tok_eq tidx opr_r_prom
    ret true
  end
  if olx_tok_eq tidx opr_r_cap
    ret true
  end
  if olx_tok_eq tidx opr_r_eff
    ret true
  end
  if olx_tok_eq tidx opr_r_sys
    ret true
  end
  if olx_tok_eq tidx opr_r_adm
    ret true
  end
  ret false
end

fn opr_peek to ulong
  ret get olx_tkind get opr_pos 0
end

fn opr_next to ulong
  p = get opr_pos 0
  k = get olx_tkind p
  if ne k 0
    put opr_pos 0 add p 1
  end
  ret k
end

fn opr_alloc kind ulong col ulong to long
  c = get opr_ncnt 0
  if ge c 128
    olx_set_err opr_e_nodes col
    ret -1
  end
  put opr_ncnt 0 add c 1
  put opr_nkind c kind
  put opr_ncol c col
  put opr_nop c 0
  put opr_nlhs c -1
  put opr_nrhs c -1
  put opr_nval c 0
  put opr_nslen c 0
  put opr_nttag c 0
  put opr_ntwid c 0
  ret long c
end

fn opr_parse_type dst_is_ret ulong to long
  k = opr_peek
  p = get opr_pos 0
  col = get olx_tcol p
  tag = ulong 0
  wid = ulong 0
  if eq k 10
    tag = V_TY_UINT
    wid = 8
  else
    if eq k 11
      tag = V_TY_UINT
      wid = 16
    else
      if eq k 12
        tag = V_TY_UINT
        wid = 32
      else
        if eq k 13
          tag = V_TY_UINT
          wid = 64
        else
          if eq k 14
            tag = V_TY_BOOL
            wid = 1
          else
            if eq k 15
              olx_set_err opr_e_signed col
              ret -1
            end
            olx_set_err opr_e_type col
            ret -1
          end
        end
      end
    end
  end
  u = opr_next
  if eq dst_is_ret 1
    put opr_rttag 0 tag
    put opr_rtwid 0 wid
  else
    if eq dst_is_ret 2
      put opr_pttag 0 tag
      put opr_ptwid 0 wid
    else
      put opr_lttag 0 tag
      put opr_ltwid 0 wid
    end
  end
  ret 0
end

fn opr_copy_tok_to_node p ulong ni ulong to void
  sl = get olx_tslen p
  put opr_nslen ni sl
  sb = mul p 64
  db = mul ni 64
  for i ulong sl bound 64
    put opr_nstr add db i get olx_tstr add sb i
  end
end

fn opr_copy_tok_to_name p ulong to void
  sl = get olx_tslen p
  put opr_nlen 0 sl
  sb = mul p 64
  for i ulong sl bound 64
    put opr_name i get olx_tstr add sb i
  end
end

fn opr_copy_tok_to_param p ulong to void
  pl = get olx_tslen p
  put opr_plen 0 pl
  pb = mul p 64
  for i ulong pl bound 64
    put opr_param i get olx_tstr add pb i
  end
end

fn opr_parse_primary to long
  d = get opr_depth 0
  if ge d 32
    olx_set_err opr_e_depth get olx_tcol get opr_pos 0
    ret -1
  end
  p = get opr_pos 0
  k = get olx_tkind p
  col = get olx_tcol p
  if eq k 2
    u = opr_next
    ni = opr_alloc 1 col
    if lt ni 0
      ret -1
    end
    put opr_nval ulong ni get olx_tval p
    ret ni
  end
  if or eq k 7 eq k 8
    u = opr_next
    ni = opr_alloc 2 col
    if lt ni 0
      ret -1
    end
    if eq k 7
      put opr_nval ulong ni 1
    else
      put opr_nval ulong ni 0
    end
    ret ni
  end
  if eq k 1
    if opr_is_reserved p
      olx_set_err opr_e_res col
      ret -1
    end
    u = opr_next
    ni = opr_alloc 3 col
    if lt ni 0
      ret -1
    end
    opr_copy_tok_to_node p ulong ni
    ret ni
  end
  if eq k 20
    u = opr_next
    put opr_depth 0 add d 1
    inner = opr_parse_ascribe
    put opr_depth 0 d
    if lt inner 0
      ret -1
    end
    if ne opr_peek 21
      olx_set_err opr_e_rparen get olx_tcol get opr_pos 0
      ret -1
    end
    u2 = opr_next
    ret inner
  end
  olx_set_err opr_e_prim col
  ret -1
end

fn opr_parse_mul to long
  lhs = opr_parse_primary
  if lt lhs 0
    ret -1
  end
  while or eq opr_peek 32 eq opr_peek 33 bound 128
    p = get opr_pos 0
    op = opr_next
    rhs = opr_parse_primary
    if lt rhs 0
      ret -1
    end
    ni = opr_alloc 4 get olx_tcol p
    if lt ni 0
      ret -1
    end
    u = ulong ni
    put opr_nop u op
    put opr_nlhs u lhs
    put opr_nrhs u rhs
    lhs = ni
  end
  ret lhs
end

fn opr_parse_add to long
  lhs = opr_parse_mul
  if lt lhs 0
    ret -1
  end
  while or eq opr_peek 30 eq opr_peek 31 bound 128
    p = get opr_pos 0
    op = opr_next
    rhs = opr_parse_mul
    if lt rhs 0
      ret -1
    end
    ni = opr_alloc 4 get olx_tcol p
    if lt ni 0
      ret -1
    end
    u = ulong ni
    put opr_nop u op
    put opr_nlhs u lhs
    put opr_nrhs u rhs
    lhs = ni
  end
  ret lhs
end

fn opr_parse_and to long
  lhs = opr_parse_add
  if lt lhs 0
    ret -1
  end
  while eq opr_peek 34 bound 128
    p = get opr_pos 0
    op = opr_next
    rhs = opr_parse_add
    if lt rhs 0
      ret -1
    end
    ni = opr_alloc 4 get olx_tcol p
    if lt ni 0
      ret -1
    end
    u = ulong ni
    put opr_nop u op
    put opr_nlhs u lhs
    put opr_nrhs u rhs
    lhs = ni
  end
  ret lhs
end

fn opr_parse_or to long
  lhs = opr_parse_and
  if lt lhs 0
    ret -1
  end
  while eq opr_peek 35 bound 128
    p = get opr_pos 0
    op = opr_next
    rhs = opr_parse_and
    if lt rhs 0
      ret -1
    end
    ni = opr_alloc 4 get olx_tcol p
    if lt ni 0
      ret -1
    end
    u = ulong ni
    put opr_nop u op
    put opr_nlhs u lhs
    put opr_nrhs u rhs
    lhs = ni
  end
  ret lhs
end

fn opr_parse_ascribe to long
  e = opr_parse_or
  if lt e 0
    ret -1
  end
  if eq opr_peek 24
    p = get opr_pos 0
    u = opr_next
    if lt opr_parse_type 0 0
      ret -1
    end
    ni = opr_alloc 5 get olx_tcol p
    if lt ni 0
      ret -1
    end
    un = ulong ni
    put opr_nlhs un e
    put opr_nttag un get opr_lttag 0
    put opr_ntwid un get opr_ltwid 0
    ret ni
  end
  ret e
end

fn opr_skip_clause to long
  while and ne opr_peek 0 and ne opr_peek 22 and ne opr_peek 5 ne opr_peek 6 bound 64
    u = opr_next
  end
  ret 0
end

fn opr_parse_fn to long
  u = opr_next
  p = get opr_pos 0
  if ne opr_peek 1
    olx_set_err opr_e_fn get olx_tcol p
    ret -1
  end
  opr_copy_tok_to_name p
  u = opr_next
  if ne opr_peek 20
    olx_set_err opr_e_fn get olx_tcol get opr_pos 0
    ret -1
  end
  u = opr_next
  pp = get opr_pos 0
  if ne opr_peek 1
    olx_set_err opr_e_fn get olx_tcol pp
    ret -1
  end
  opr_copy_tok_to_param pp
  u = opr_next
  if ne opr_peek 24
    olx_set_err opr_e_fn get olx_tcol get opr_pos 0
    ret -1
  end
  u = opr_next
  if lt opr_parse_type 2 0
    ret -1
  end
  if ne opr_peek 21
    olx_set_err opr_e_fn get olx_tcol get opr_pos 0
    ret -1
  end
  u = opr_next
  if ne opr_peek 26
    olx_set_err opr_e_fn get olx_tcol get opr_pos 0
    ret -1
  end
  u = opr_next
  if lt opr_parse_type 1 0
    ret -1
  end
  if eq opr_peek 5
    u = opr_next
    s = opr_skip_clause
  end
  if eq opr_peek 6
    u = opr_next
    s = opr_skip_clause
  end
  if ne opr_peek 22
    olx_set_err opr_e_fn get olx_tcol get opr_pos 0
    ret -1
  end
  u = opr_next
  body = opr_parse_ascribe
  if lt body 0
    ret -1
  end
  if ne opr_peek 23
    olx_set_err opr_e_fn get olx_tcol get opr_pos 0
    ret -1
  end
  u = opr_next
  if ne opr_peek 0
    olx_set_err opr_e_extra get olx_tcol get opr_pos 0
    ret -1
  end
  put opr_stmt 0 3
  put opr_root 0 body
  ret 0
end

fn opr_parse_line to long
  put opr_pos 0 0
  put opr_depth 0 0
  put opr_ncnt 0 0
  put opr_stmt 0 0
  put opr_root 0 -1
  k = opr_peek
  if eq k 0
    put opr_stmt 0 0
    ret 0
  end
  if eq k 3
    u = opr_next
    p = get opr_pos 0
    if ne opr_peek 1
      olx_set_err opr_e_let get olx_tcol p
      ret -1
    end
    if opr_is_reserved p
      olx_set_err opr_e_res get olx_tcol p
      ret -1
    end
    opr_copy_tok_to_name p
    u = opr_next
    if ne opr_peek 24
      olx_set_err opr_e_let get olx_tcol get opr_pos 0
      ret -1
    end
    u = opr_next
    if lt opr_parse_type 0 0
      ret -1
    end
    if ne opr_peek 27
      olx_set_err opr_e_let get olx_tcol get opr_pos 0
      ret -1
    end
    u = opr_next
    rhs = opr_parse_ascribe
    if lt rhs 0
      ret -1
    end
    if ne opr_peek 0
      olx_set_err opr_e_extra get olx_tcol get opr_pos 0
      ret -1
    end
    put opr_stmt 0 2
    put opr_root 0 rhs
    ret 0
  end
  if eq k 4
    ret opr_parse_fn
  end
  e = opr_parse_ascribe
  if lt e 0
    ret -1
  end
  if ne opr_peek 0
    olx_set_err opr_e_extra get olx_tcol get opr_pos 0
    ret -1
  end
  put opr_stmt 0 1
  put opr_root 0 e
  ret 0
end

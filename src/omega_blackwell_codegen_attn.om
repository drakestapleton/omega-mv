note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_blackwell_codegen_attn.c.
note Composes on om/gpu/cg_attn.om and om/gpu/bw_regalloc.om.
om2

fn da_om_touch_vreg vinfo edit long 768 r64 ulong pos long is_def ulong nv ulong to void
  if ge r64 nv
    ret
  end
  base = mul r64 3
  fd = get vinfo base
  lu = get vinfo add base 1
  if and ne is_def 0 lt fd 0
    put vinfo base pos
  end
  if gt pos lu
    put vinfo add base 1 pos
  end
end

fn omega_blackwell_codegen_decode_attn_prog depth uint mutant long ins edit ulong 8192 meta edit ulong 512 to long
  for i ulong 8192
    put ins i 0
  end
  for i ulong 512
    put meta i 0
  end
  sp = new ulong 4 0
  put sp 0 ulong depth
  put sp 1 ulong mutant
  rc = cg_attn_emit sp ins meta
  if ne rc 0
    ret -1
  end
  if or ne get meta 5 0 eq get meta 0 0
    ret -1
  end
  ret 0
end

fn da_om_build_vinfo ins view ulong 8192 meta view ulong 512 vinfo edit long 768 to void
  n = get meta 0
  nv = get meta 1
  nl = get meta 3
  for v ulong nv bound 256
    base = mul v 3
    put vinfo base -1
    put vinfo add base 1 -1
    put vinfo add base 2 long get meta add 64 v
  end
  for i ulong n bound 1024
    off = mul i 8
    flags = get ins add off 7
    if eq and flags 1 0
      pos = long i
      da_om_touch_vreg vinfo get ins add off 1 pos 1 nv
      da_om_touch_vreg vinfo get ins add off 2 pos 0 nv
      da_om_touch_vreg vinfo get ins add off 3 pos 0 nv
      da_om_touch_vreg vinfo get ins add off 4 pos 0 nv
    end
  end
  for l ulong nl bound 16
    ls = long get meta add 320 mul l 2
    le_idx = long get meta add 321 mul l 2
    for v ulong nv bound 256
      base = mul v 3
      fd = get vinfo base
      lu = get vinfo add base 1
      if ge fd 0
        if lt fd ls
          if ge lu ls
            if lt lu le_idx
              put vinfo add base 1 le_idx
            end
          end
        end
      end
    end
  end
end

fn da_om_solve_stats ins view ulong 8192 meta view ulong 512 out_stats edit uint 2 to long
  n = get meta 0
  nv = get meta 1
  nu = get meta 2
  nl = get meta 3
  if gt n 1024
    ret -1
  end
  if gt nv 256
    ret -1
  end
  if gt nu 32
    ret -1
  end
  if gt nl 16
    ret -1
  end
  vinfo = new long 768 0
  da_om_build_vinfo ins meta vinfo
  uinfo = new ulong 32 0
  for u ulong nu bound 32
    put uinfo u get meta add 352 u
  end
  cfg = new ulong 4 0
  put cfg 0 nv
  put cfg 1 nu
  put cfg 2 0
  res = new long 290 0
  if ne bw_regalloc_solve cfg vinfo uinfo res 0
    ret -1
  end
  put out_stats 0 uint n
  put out_stats 1 uint get res 288
  ret 0
end

fn omega_decode_attn_prog_stats depth uint mutant long out_stats edit uint 2 to long
  ins = new ulong 8192 0
  meta = new ulong 512 0
  if ne omega_blackwell_codegen_decode_attn_prog depth mutant ins meta 0
    ret -1
  end
  ret da_om_solve_stats ins meta out_stats
end

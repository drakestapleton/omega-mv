note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_gpu_fmt.c.
note Bounded freestanding message formatter (%s %c %d %u %x %ld %lu %lld %llu %zu %%).
om2

text gfmt_null_str "(null)"

fn gfmt_putc dst edit uchar * st edit ulong 2 ch uchar to void
  pos = get st 0
  cap = get st 1
  if lt add pos 1 cap
    put dst pos ch
    put st 0 add pos 1
  end
end

fn gfmt_put_u dst edit uchar * st edit ulong 2 v ulong base ulong to void
  tmp = new uchar 24 0
  k = ulong 0
  cur = v
  if eq cur 0
    gfmt_putc dst st 48
    ret
  end
  while gt cur 0 bound 24
    d = rem cur base
    if lt d 10
      put tmp k uchar add 48 d
    else
      put tmp k uchar add 87 d
    end
    k = add k 1
    cur = div cur base
  end
  for i ulong k bound 24
    gfmt_putc dst st get tmp sub sub k 1 i
  end
end

fn gfmt_put_d dst edit uchar * st edit ulong 2 v ulong to void
  if ne and v ulong 0x8000000000000000 0
    gfmt_putc dst st 45
    gfmt_put_u dst st sub ulong 0 v 10
    ret
  end
  gfmt_put_u dst st v 10
end

fn gfmt_sext32 v ulong to ulong
  u = and v 0xffffffff
  if ne and u 0x80000000 0
    ret or u ulong 0xffffffff00000000
  end
  ret u
end

fn gfmt_put_str dst edit uchar * st edit ulong 2 sbuf view uchar 256 off ulong slen ulong to void
  if eq slen ulong 0xffffffffffffffff
    n = len gfmt_null_str
    for i ulong n bound 16
      gfmt_putc dst st get gfmt_null_str i
    end
    ret
  end
  for i ulong slen bound 4096
    idx = add off i
    if lt idx 256
      gfmt_putc dst st get sbuf idx
    end
  end
end

fn gfmt_emit_num dst edit uchar * st edit ulong 2 spec uchar is_long ulong v ulong to void
  if eq spec 100
    if ne is_long 0
      gfmt_put_d dst st v
    else
      gfmt_put_d dst st gfmt_sext32 v
    end
    ret
  end
  base = ulong 10
  if eq spec 120
    base = 16
  end
  if ne is_long 0
    gfmt_put_u dst st v base
  else
    gfmt_put_u dst st and v 0xffffffff base
  end
end

fn gfmt_copy_lit dst edit uchar * st edit ulong 2 fmt view uchar * ab view ulong 2 to void
  q = get ab 0
  lim = get ab 1
  while le q lim bound 16
    if lt q len fmt
      gfmt_putc dst st get fmt q
    end
    q = add q 1
  end
end

fn gfmt_dispatch dst edit uchar * st edit ulong 2 meta view ulong 32 sbuf view uchar 256 info view ulong 4 to ulong
  spec = uchar get info 0
  is_long = get info 1
  ai = get info 2
  if eq spec 115
    if lt ai 15
      gfmt_put_str dst st sbuf get meta add 1 ai get meta add 16 ai
    else
      gfmt_put_str dst st sbuf 0 ulong 0xffffffffffffffff
    end
    ret 1
  end
  if eq spec 99
    if lt ai 15
      gfmt_putc dst st uchar and get meta add 1 ai 255
    else
      gfmt_putc dst st 0
    end
    ret 1
  end
  if or eq spec 100 or eq spec 117 eq spec 120
    if lt ai 15
      gfmt_emit_num dst st spec is_long get meta add 1 ai
    else
      gfmt_emit_num dst st spec is_long 0
    end
    ret 1
  end
  if eq spec 37
    gfmt_putc dst st 37
    ret 2
  end
  ret 0
end

note Formats fmt into dst[0..cap) where meta[0]=cap, meta[1..15]=arg_vals[0..14], meta[16..30]=arg_slens[0..14].
note Always NUL-terminates inside cap (cap > 0); returns characters written without NUL.
fn omega_gpu_fmt dst edit uchar * fmt view uchar * meta view ulong 32 sbuf view uchar 256 to long
  st = new ulong 2 0
  info = new ulong 4 0
  ab = new ulong 2 0
  if or eq get meta 0 0 gt get meta 0 len dst
    ret 0
  end
  put st 0 0
  put st 1 get meta 0
  p = ulong 0
  while lt p len fmt bound 4096
    ch = get fmt p
    if ne ch 37
      gfmt_putc dst st ch
      p = add p 1
    else
      put info 3 p
      p = add p 1
      put info 1 0
      if lt p len fmt
        if eq get fmt p 122
          put info 1 1
          p = add p 1
        else
          if eq get fmt p 108
            put info 1 1
            p = add p 1
            if lt p len fmt
              if eq get fmt p 108
                p = add p 1
              end
            end
          end
        end
      end
      put info 0 0
      if lt p len fmt
        put info 0 ulong get fmt p
      end
      drc = gfmt_dispatch dst st meta sbuf info
      if eq drc 1
        put info 2 add get info 2 1
      else
        if eq drc 0
          put ab 0 get info 3
          put ab 1 p
          gfmt_copy_lit dst st fmt ab
        end
      end
      if lt p len fmt
        p = add p 1
      end
    end
  end
  put dst get st 0 0
  ret long get st 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_library.c (content-addressed verified
note program library: fail-closed VC1 admission guards, streaming LIB1 SHA-256
note digest, lookup by ID/realization/name/type, transitive cycle detection,
note primitive bank export).
note Composes on seed/ng/sha256.om.
om2

const LIB_MAX_PROGS ulong 128
const LIB_MAX_DEPS ulong 32
const LIB_ADMISSION_VERIFIED ulong 1
const LIB_ADMISSION_BOOTSTRAP ulong 2
const LIB_SYNTH_MAX_PRIMS ulong 32

global g_lib_ver ulong 1
global g_lib_cnt ulong 1
global g_lib_digest uchar 32

global g_lib_pid uchar 4096
global g_lib_rid uchar 4096
global g_lib_name uchar 8192
global g_lib_nlen ulong 128
global g_lib_in_t ulong 128
global g_lib_in_w ulong 128
global g_lib_out_t ulong 128
global g_lib_out_w ulong 128
global g_lib_ver_intro ulong 128
global g_lib_kind ulong 128
global g_lib_dep_cnt ulong 128
global g_lib_deps uchar 131072
global g_lib_rcpt uchar 4096

global g_lib_qres ulong 128
global g_lib_exp_cnt ulong 1
global g_lib_exp_idx ulong 32

note Staged admission candidate buffers (keeps all fn signatures <= 6 reg slots)
global g_lib_st_ver ulong 1
global g_lib_st_real ulong 1
global g_lib_st_pid uchar 32
global g_lib_st_rid uchar 32
global g_lib_st_name uchar 64
global g_lib_st_nlen ulong 1
global g_lib_st_it ulong 1
global g_lib_st_iw ulong 1
global g_lib_st_ot ulong 1
global g_lib_st_ow ulong 1
global g_lib_st_deps uchar 1024
global g_lib_st_dcnt ulong 1
global g_lib_st_hash uchar 32

fn lib_stage_meta is_ver ulong is_real ulong in_t ulong in_w ulong out_t ulong out_w ulong to void
  put g_lib_st_ver 0 is_ver
  put g_lib_st_real 0 is_real
  put g_lib_st_it 0 in_t
  put g_lib_st_iw 0 in_w
  put g_lib_st_ot 0 out_t
  put g_lib_st_ow 0 out_w
end

fn lib_stage_ids pid view uchar 32 rid view uchar 32 hash view uchar 32 to void
  for i ulong 32
    put g_lib_st_pid i get pid i
    put g_lib_st_rid i get rid i
    put g_lib_st_hash i get hash i
  end
end

fn lib_stage_name name view uchar * nlen ulong to void
  for i ulong 64
    put g_lib_st_name i 0
  end
  lim = nlen
  if gt lim 63
    lim = 63
  end
  for i ulong lim bound 64
    put g_lib_st_name i get name i
  end
  put g_lib_st_nlen 0 nlen
end

fn lib_stage_deps deps view uchar * dcnt ulong to void
  put g_lib_st_dcnt 0 dcnt
  lim = dcnt
  if gt lim LIB_MAX_DEPS
    lim = LIB_MAX_DEPS
  end
  nbytes = mul lim 32
  for i ulong nbytes bound 1024
    put g_lib_st_deps i get deps i
  end
end

fn lib_put_u32be pos ulong v ulong to ulong
  put sh_dat pos uchar and shr v 24 255
  put sh_dat add pos 1 uchar and shr v 16 255
  put sh_dat add pos 2 uchar and shr v 8 255
  put sh_dat add pos 3 uchar and v 255
  ret add pos 4
end

fn omega_library_compute_digest to long
  p = ulong 0
  put sh_dat 0 uchar 76
  put sh_dat 1 uchar 73
  put sh_dat 2 uchar 66
  put sh_dat 3 uchar 49
  p = 4
  p = lib_put_u32be p get g_lib_ver 0
  cnt = get g_lib_cnt 0
  p = lib_put_u32be p cnt
  for i ulong cnt bound 128
    b32 = mul i 32
    for j ulong 32
      put sh_dat add p j get g_lib_pid add b32 j
    end
    p = add p 32
    for j ulong 32
      put sh_dat add p j get g_lib_rid add b32 j
    end
    p = add p 32
    p = lib_put_u32be p get g_lib_ver_intro i
    put sh_dat p uchar and get g_lib_kind i 255
    p = add p 1
    dc = get g_lib_dep_cnt i
    p = lib_put_u32be p dc
    dbase = mul i 1024
    for d ulong dc bound 32
      doff = add dbase mul d 32
      for j ulong 32
        put sh_dat add p j get g_lib_deps add doff j
      end
      p = add p 32
    end
    for j ulong 32
      put sh_dat add p j get g_lib_rcpt add b32 j
    end
    p = add p 32
  end
  sh_all p
  for i ulong 32
    put g_lib_digest i get sh_dig i
  end
  ret 0
end

fn omega_library_init to long
  put g_lib_ver 0 1
  put g_lib_cnt 0 0
  for i ulong 32
    put g_lib_digest i 0
  end
  ret omega_library_compute_digest
end

fn omega_library_destroy to void
  put g_lib_ver 0 0
  put g_lib_cnt 0 0
  for i ulong 32
    put g_lib_digest i 0
  end
end

fn omega_library_advance_version to long
  put g_lib_ver 0 add get g_lib_ver 0 1
  ret omega_library_compute_digest
end

fn lib_id_eq_pid idx ulong pid view uchar 32 to bool
  base = mul idx 32
  for j ulong 32
    if ne get g_lib_pid add base j get pid j
      ret false
    end
  end
  ret true
end

fn lib_id_eq_rid idx ulong rid view uchar 32 to bool
  base = mul idx 32
  for j ulong 32
    if ne get g_lib_rid add base j get rid j
      ret false
    end
  end
  ret true
end

fn omega_library_find_by_id pid view uchar 32 to long
  cnt = get g_lib_cnt 0
  for i ulong cnt bound 128
    if lib_id_eq_pid i pid
      ret long i
    end
  end
  ret -1
end

fn omega_library_find_by_realization_id rid view uchar 32 to long
  cnt = get g_lib_cnt 0
  for i ulong cnt bound 128
    if lib_id_eq_rid i rid
      ret long i
    end
  end
  ret -1
end

fn lib_name_eq idx ulong name view uchar * nlen ulong to bool
  if ne get g_lib_nlen idx nlen
    ret false
  end
  base = mul idx 64
  for j ulong nlen bound 64
    if ne get g_lib_name add base j get name j
      ret false
    end
  end
  ret true
end

fn omega_library_find_by_name name view uchar * nlen ulong to long
  cnt = get g_lib_cnt 0
  for i ulong cnt bound 128
    if lib_name_eq i name nlen
      ret long i
    end
  end
  ret -1
end

fn omega_library_query_by_type in_t ulong in_w ulong out_t ulong out_w ulong max_res ulong to ulong
  if eq max_res 0
    ret 0
  end
  cnt = get g_lib_cnt 0
  found = ulong 0
  for i ulong cnt bound 128
    if lt found max_res
      ok = eq get g_lib_in_t i in_t
      if ok
        ok = eq get g_lib_in_w i in_w
      end
      if ok
        ok = eq get g_lib_out_t i out_t
      end
      if ok
        ok = eq get g_lib_out_w i out_w
      end
      if ok
        put g_lib_qres found i
        found = add found 1
      end
    end
  end
  ret found
end

fn lib_id_eq_buf a view uchar 32 b view uchar * boff ulong to bool
  for j ulong 32
    if ne get a j get b add boff j
      ret false
    end
  end
  ret true
end

fn lib_copy_dep_id idx ulong d ulong dst edit uchar 32 to void
  off = add mul idx 1024 mul d 32
  for j ulong 32
    put dst j get g_lib_deps add off j
  end
end

fn omega_library_has_cycle target view uchar 32 deps view uchar * dcnt ulong to bool
  if eq dcnt 0
    ret false
  end
  vis = new uchar 128 0
  stk = new ulong 128 0
  sp = ulong 0
  tmp = new uchar 32 0
  for i ulong dcnt bound 32
    off = mul i 32
    if lib_id_eq_buf target deps off
      ret true
    end
    for j ulong 32
      put tmp j get deps add off j
    end
    idx = omega_library_find_by_id tmp
    if ge idx 0
      ui = ulong idx
      if eq get vis ui 0
        put vis ui 1
        put stk sp ui
        sp = add sp 1
      end
    end
  end
  while gt sp 0 bound 256
    sp = sub sp 1
    cur = get stk sp
    cdc = get g_lib_dep_cnt cur
    for d ulong cdc bound 32
      lib_copy_dep_id cur d tmp
      if lib_id_eq_buf target tmp 0
        ret true
      end
      nidx = omega_library_find_by_id tmp
      if ge nidx 0
        nu = ulong nidx
        if eq get vis nu 0
          put vis nu 1
          if lt sp 128
            put stk sp nu
            sp = add sp 1
          end
        end
      end
    end
  end
  ret false
end

fn lib_hash_is_zero h view uchar 32 to bool
  acc = uchar 0
  for i ulong 32
    acc = or acc get h i
  end
  ret eq acc 0
end

fn lib_check_staged_cycle pid view uchar 32 dcnt ulong to bool
  dbuf = new uchar 1024 0
  for i ulong mul dcnt 32 bound 1024
    put dbuf i get g_lib_st_deps i
  end
  ret omega_library_has_cycle pid dbuf dcnt
end

fn lib_store_staged_entry cnt ulong kind ulong dcnt ulong nlen ulong to void
  b32 = mul cnt 32
  for j ulong 32
    put g_lib_pid add b32 j get g_lib_st_pid j
    put g_lib_rid add b32 j get g_lib_st_rid j
    put g_lib_rcpt add b32 j get g_lib_st_hash j
  end
  b64 = mul cnt 64
  for j ulong 64
    put g_lib_name add b64 j get g_lib_st_name j
  end
  put g_lib_nlen cnt nlen
  put g_lib_in_t cnt get g_lib_st_it 0
  put g_lib_in_w cnt get g_lib_st_iw 0
  put g_lib_out_t cnt get g_lib_st_ot 0
  put g_lib_out_w cnt get g_lib_st_ow 0
  put g_lib_ver_intro cnt get g_lib_ver 0
  put g_lib_kind cnt kind
  put g_lib_dep_cnt cnt dcnt
  dbase = mul cnt 1024
  for i ulong mul dcnt 32 bound 1024
    put g_lib_deps add dbase i get g_lib_st_deps i
  end
  put g_lib_cnt 0 add cnt 1
end

fn lib_admit_staged kind ulong to long
  if eq get g_lib_st_ver 0 0
    ret -1
  end
  if eq get g_lib_st_real 0 0
    ret -1
  end
  cnt = get g_lib_cnt 0
  if ge cnt LIB_MAX_PROGS
    ret -1
  end
  pid = new uchar 32 0
  for j ulong 32
    put pid j get g_lib_st_pid j
  end
  if lib_hash_is_zero pid
    ret -1
  end
  if ge omega_library_find_by_id pid 0
    ret -1
  end
  dcnt = get g_lib_st_dcnt 0
  if gt dcnt LIB_MAX_DEPS
    ret -1
  end
  nlen = get g_lib_st_nlen 0
  if gt nlen 63
    ret -1
  end
  tmp = new uchar 32 0
  for i ulong dcnt bound 32
    off = mul i 32
    for j ulong 32
      put tmp j get g_lib_st_deps add off j
    end
    if lt omega_library_find_by_id tmp 0
      ret -1
    end
  end
  if gt dcnt 0
    if lib_check_staged_cycle pid dcnt
      ret -1
    end
  end
  lib_store_staged_entry cnt kind dcnt nlen
  ret omega_library_compute_digest
end

fn omega_library_insert to long
  h = new uchar 32 0
  for j ulong 32
    put h j get g_lib_st_hash j
  end
  if lib_hash_is_zero h
    ret -1
  end
  ret lib_admit_staged LIB_ADMISSION_VERIFIED
end

fn omega_library_insert_bootstrap to long
  h = new uchar 32 0
  for j ulong 32
    put h j get g_lib_st_hash j
  end
  if lib_hash_is_zero h
    ret -1
  end
  ret lib_admit_staged LIB_ADMISSION_BOOTSTRAP
end

fn omega_library_export_primitives to long
  cnt = get g_lib_cnt 0
  ecnt = ulong 0
  for i ulong cnt bound 128
    if lt ecnt LIB_SYNTH_MAX_PRIMS
      put g_lib_exp_idx ecnt i
      ecnt = add ecnt 1
    end
  end
  put g_lib_exp_cnt 0 ecnt
  ret 0
end

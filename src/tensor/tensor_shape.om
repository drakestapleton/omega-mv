note SPDX-License-Identifier: Apache-2.0
note Sizes and strides are in elements. Native tensor callers check pointer
note arguments before supplying these views. Return tensor status as data.
om2
const max_elems ulong 1073741824
const shape_error long -3
const bounds_error long -6
const capacity_error long -8

export fn tensor_shape_size dims view ulong * elems edit ulong 1 to long
requires le len dims 8
  total = ulong 1
  for axis ulong len dims
    extent = get dims axis
    if eq extent 0
      ret shape_error
    end
    if gt extent max_elems
      ret capacity_error
    end
    note Both factors are at most max_elems before multiplication.
    total = mul total extent
    if gt total max_elems
      ret capacity_error
    end
  end
  put elems 0 total
  ret 0
end

export fn tensor_dense_strides dims view ulong * strides edit ulong * to void
requires eq len dims len strides
requires le len dims 8
  stride = ulong 1
  for trailing ulong len dims
    axis = sub sub len dims 1 trailing
    put strides axis stride
    stride = mul stride get dims axis
  end
end

export fn tensor_view_bounds dims view ulong * strides view ulong * offset ulong storage ulong to long
requires eq len dims len strides
requires le len dims 8
  if ge offset storage
    ret bounds_error
  end
  remaining = sub sub storage 1 offset
  for axis ulong len dims
    stride = get strides axis
    if ne stride 0
      extent = get dims axis
      if eq extent 0
        ret bounds_error
      end
      steps = sub extent 1
      if gt steps div remaining stride
        ret bounds_error
      end
      remaining = sub remaining mul steps stride
    end
  end
  ret 0
end

fn trailing_dim dims view ulong * trailing ulong to ulong
  if ge trailing len dims
    ret 1
  end
  ret get dims sub sub len dims 1 trailing
end

export fn tensor_broadcast_dims lhs view ulong * rhs view ulong * result_dims edit ulong * to long
requires le len result_dims 8
requires ge len result_dims len lhs
requires ge len result_dims len rhs
  for axis ulong len result_dims
    a = trailing_dim lhs axis
    b = trailing_dim rhs axis
    if or eq a 0 eq b 0
      ret shape_error
    end
    if ne a b
      if and ne a 1 ne b 1
        ret shape_error
      end
    end
    out_axis = sub sub len result_dims 1 axis
    if gt a b
      put result_dims out_axis a
    else
      put result_dims out_axis b
    end
  end
  ret 0
end

note Axes of length one may have an arbitrary stride in a contiguous view.
export fn tensor_is_row_major dims view ulong * strides view ulong * to ulong
requires eq len dims len strides
requires le len dims 8
  expected = ulong 1
  for trailing ulong len dims
    axis = sub sub len dims 1 trailing
    extent = get dims axis
    if and ne extent 1 ne get strides axis expected
      ret 0
    end
    expected = mul expected extent
  end
  ret 1
end

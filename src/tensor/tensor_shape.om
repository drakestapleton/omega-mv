note SPDX-License-Identifier: Apache-2.0
note Sizes and strides are in elements. Native tensor callers check pointer
note arguments before supplying these views. Return tensor status as data.
om2
const max_elems ulong 1073741824
const shape_error long -3
const bounds_error long -6
const capacity_error long -8

export fn tensor_shape_size dims view ulong * elems edit ulong 1 to long
requires le len dims 8
  total = ulong 1
  for axis ulong len dims
    extent = get dims axis
    if eq extent 0
      ret shape_error
    end
    if gt extent max_elems
      ret capacity_error
    end
    note Both factors are at most max_elems before multiplication.
    total = mul total extent
    if gt total max_elems
      ret capacity_error
    end
  end
  put elems 0 total
  ret 0
end

export fn tensor_dense_strides dims view ulong * strides edit ulong * to void
requires eq len dims len strides
requires le len dims 8
  stride = ulong 1
  for trailing ulong len dims
    axis = sub sub len dims 1 trailing
    put strides axis stride
    stride = mul stride get dims axis
  end
end

export fn tensor_view_bounds dims view ulong * strides view ulong * offset ulong storage ulong to long
requires eq len dims len strides
requires le len dims 8
  if ge offset storage
    ret bounds_error
  end
  remaining = sub sub storage 1 offset
  for axis ulong len dims
    extent = get dims axis
    if eq extent 0
      ret bounds_error
    end
    stride = get strides axis
    if ne stride 0
      steps = sub extent 1
      if gt steps div remaining stride
        ret bounds_error
      end
      remaining = sub remaining mul steps stride
    end
  end
  ret 0
end

fn trailing_dim dims view ulong * trailing ulong to ulong
  if ge trailing len dims
    ret 1
  end
  ret get dims sub sub len dims 1 trailing
end

export fn tensor_broadcast_dims lhs view ulong * rhs view ulong * result_dims edit ulong * to long
requires le len result_dims 8
requires ge len result_dims len lhs
requires ge len result_dims len rhs
  for axis ulong len result_dims
    a = trailing_dim lhs axis
    b = trailing_dim rhs axis
    if or eq a 0 eq b 0
      ret shape_error
    end
    if ne a b
      if and ne a 1 ne b 1
        ret shape_error
      end
    end
    out_axis = sub sub len result_dims 1 axis
    if gt a b
      put result_dims out_axis a
    else
      put result_dims out_axis b
    end
  end
  ret 0
end

note Axes of length one may have an arbitrary stride in a contiguous view.
export fn tensor_is_row_major dims view ulong * strides view ulong * to ulong
requires eq len dims len strides
requires le len dims 8
  expected = ulong 1
  for trailing ulong len dims
    axis = sub sub len dims 1 trailing
    extent = get dims axis
    if and ne extent 1 ne get strides axis expected
      ret 0
    end
    expected = mul expected extent
  end
  ret 1
end

note The tensor value domain preserves signed zero, infinities and finite
note payloads. Every NaN of a given dtype has a single representation.
export fn tensor_canonical_word dtype ulong word ulong to ulong
  if eq dtype 1
    if gt and word 2147483647 2139095040
      ret 2143289344
    end
  else
    if eq dtype 2
      if gt and word 32767 31744
        ret 32256
      end
    else
      if gt and word 32767 32640
        ret 32704
      end
    end
  end
  ret word
end

fn tensor_native_word data view uchar * first ulong width ulong native_le ulong to ulong
  word = ulong 0
  for i ulong width
    j = i
    if eq native_le 0
      j = sub sub width 1 i
    end
    word = or word shl ulong get data add first j mul i 8
  end
  ret word
end

fn tensor_put_word data edit uchar * first ulong width ulong value ulong to void
  for j ulong width
    put data add first j uchar and shr value mul j 8 255
  end
end

note Serialize a chunk of gathered elements in canonical little-endian order.
export fn tensor_value_bytes data edit uchar * dtype ulong native_le ulong to void
requires and ge dtype 1 le dtype 3
requires eq rem len data 2 0
requires or ne dtype 1 eq rem len data 4 0
  width = ulong 2
  if eq dtype 1
    width = 4
  end
  for i ulong div len data width
    first = mul i width
    raw = tensor_native_word data first width native_le
    value = tensor_canonical_word dtype raw
    if or eq native_le 0 ne value raw
      tensor_put_word data first width value
    end
  end
end

const tstore_jrn_magic ulong 13878389200081999
const tstore_rec_magic ulong 13866238871819343

fn tstore_get_u32 data view uchar * first ulong to ulong
  v = ulong 0
  for i ulong 4
    v = or v shl ulong get data add first i mul i 8
  end
  ret v
end

fn tstore_get_u64 data view uchar * first ulong to ulong
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get data add first i mul i 8
  end
  ret v
end

fn tstore_hex_nibble v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

export fn tstore_hex_name id view uchar 32 out_name out uchar 68 to void
  for i ulong 32
    b = ulong get id i
    put out_name mul i 2 tstore_hex_nibble shr b 4
    put out_name add mul i 2 1 tstore_hex_nibble and b 15
  end
  put out_name 64 46
  put out_name 65 98
  put out_name 66 105
  put out_name 67 110
end

export fn tstore_is_payload_name name view uchar * to ulong
  if ne len name 68
    ret 0
  end
  if or ne get name 64 46 ne get name 65 98
    ret 0
  end
  if or ne get name 66 105 ne get name 67 110
    ret 0
  end
  for i ulong 64
    c = ulong get name i
    if not or and ge c 48 le c 57 and ge c 97 le c 102
      ret 0
    end
  end
  ret 1
end

export fn tstore_encode_header cap ulong count ulong out_hdr out uchar 24 to void
  tensor_put_word out_hdr 0 8 tstore_jrn_magic
  tensor_put_word out_hdr 8 4 1
  tensor_put_word out_hdr 12 4 cap
  tensor_put_word out_hdr 16 8 count
end

note Return 1 if valid, 2 if capacity mismatch, 0 if torn magic or version.
export fn tstore_decode_header in_hdr view uchar 24 expect_cap ulong count_out edit ulong 1 to ulong
  if ne tstore_get_u64 in_hdr 0 tstore_jrn_magic
    ret 0
  end
  if ne tstore_get_u32 in_hdr 8 1
    ret 0
  end
  if ne tstore_get_u32 in_hdr 12 expect_cap
    ret 2
  end
  put count_out 0 tstore_get_u64 in_hdr 16
  ret 1
end

export fn tstore_encode_record meta view ulong 6 shape view ulong 8 value_id view uchar 32 payload_sha view uchar 32 out_rec out uchar 168 to void
  tensor_put_word out_rec 0 8 tstore_rec_magic
  tensor_put_word out_rec 8 4 get meta 0
  tensor_put_word out_rec 12 4 get meta 1
  tensor_put_word out_rec 16 8 get meta 2
  tensor_put_word out_rec 24 8 get meta 3
  tensor_put_word out_rec 32 4 get meta 4
  tensor_put_word out_rec 36 4 get meta 5
  for d ulong 8
    tensor_put_word out_rec add 40 mul d 8 8 get shape d
  end
  for i ulong 32
    put out_rec add 104 i get value_id i
    put out_rec add 136 i get payload_sha i
  end
end

export fn tstore_decode_record in_rec view uchar 168 meta edit ulong 6 shape edit ulong 8 value_id out uchar 32 payload_sha out uchar 32 to ulong
  if ne tstore_get_u64 in_rec 0 tstore_rec_magic
    ret 0
  end
  put meta 0 tstore_get_u32 in_rec 8
  put meta 1 tstore_get_u32 in_rec 12
  put meta 2 tstore_get_u64 in_rec 16
  put meta 3 tstore_get_u64 in_rec 24
  put meta 4 tstore_get_u32 in_rec 32
  put meta 5 tstore_get_u32 in_rec 36
  for d ulong 8
    put shape d tstore_get_u64 in_rec add 40 mul d 8
  end
  for i ulong 32
    put value_id i get in_rec add 104 i
    put payload_sha i get in_rec add 136 i
  end
  ret 1
end

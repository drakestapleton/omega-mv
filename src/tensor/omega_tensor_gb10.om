note SPDX-License-Identifier: Apache-2.0
note omega_tensor_gb10.om -- Pure seeded OM-2 GB10 realization descriptor and op-mapping table.
note Refuses unmapped ops with OMEGA_NUMERIC_ERR_NOT_ENCODED (-4) before opening any device.
note No silent CPU fallback.

const OT_GB10_ERR_NOT_ENCODED long -4
const OT_GB10_ERR_BAD_ARGS long -1
const OT_GB10_ERR_OPERANDS long -2
const OT_GB10_REDUCE_MAX_N ulong 32768

note Returns E1 GB10 SIMT op id (>= 1) if encoded on GB10, or 0 if refused.
fn ot_gb10_simt_op_id op ulong to ulong
  if le op OT_TB_SEL_NEU
    ret add op 1
  end
  ret 0
end

note Returns E1 row-10 transc kernel id (0..10) if encoded on GB10, or -1 if refused.
fn ot_gb10_transc_kernel op ulong to long
  if eq op OT_TU_EXP2
    ret 0
  end
  if eq op OT_TU_LOG2
    ret 1
  end
  if eq op OT_TU_SIGMOID
    ret 2
  end
  if eq op OT_TU_TANH
    ret 3
  end
  if eq op OT_TU_SIN
    ret 4
  end
  if eq op OT_TU_COS
    ret 5
  end
  if eq op OT_TU_ERF
    ret 6
  end
  if eq op OT_TU_GELU
    ret 7
  end
  if eq op OT_TU_RSQRT
    ret 8
  end
  if eq op OT_TU_EXP
    ret 9
  end
  if eq op OT_TU_LOG
    ret 10
  end
  ret -1
end

fn ot_gb10_check_reduce op ulong n ulong to long
  if gt n OT_GB10_REDUCE_MAX_N
    ret OT_GB10_ERR_OPERANDS
  end
  if or ge op OT_TR_COUNT eq n 0
    ret OT_GB10_ERR_BAD_ARGS
  end
  ret 0
end

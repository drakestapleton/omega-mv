note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/tensor/omega_tensor_reduce_seam.c.
note Composes with src/omega_numeric_reduce.om (E1 WP-D frozen-order FP32 reductions).
om2

const OMEGA_TR_SUM ulong 0
const OMEGA_TR_MAX ulong 1
const OMEGA_TR_MIN ulong 2
const OMEGA_TR_MEAN ulong 3
const OMEGA_TR_COUNT ulong 4

text OMEGA_REDUCE_DECLARED_ORDER "RECURSIVE_TILE32_PAIRWISE_TREE_LANE_DELTA_16_8_4_2_1_PAD_IDENTITY_MIN_ONE_LEVEL"
text OMEGA_TENSOR_REDUCE_DECLARED_ORDER "RECURSIVE_TILE32_PAIRWISE_TREE_LANE_DELTA_16_8_4_2_1_PAD_IDENTITY_MIN_ONE_LEVEL"
text OMEGA_TENSOR_SEAM_SOURCE "E1_WP_D_OMEGA_REDUCE_CPU"

fn trs_orders_match to bool
  n1 = len OMEGA_REDUCE_DECLARED_ORDER
  n2 = len OMEGA_TENSOR_REDUCE_DECLARED_ORDER
  if ne n1 n2
    ret false
  end
  for i ulong n1 bound 256
    if ne get OMEGA_REDUCE_DECLARED_ORDER i get OMEGA_TENSOR_REDUCE_DECLARED_ORDER i
      ret false
    end
  end
  ret true
end

fn omega_tensor_seam_reduce_cpu op ulong x view uint * xoff ulong n ulong to long
  if not trs_orders_match
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  r = ulong 0
  if eq op OMEGA_TR_SUM
    r = OMEGA_RED_SUM
  else
    if eq op OMEGA_TR_MAX
      r = OMEGA_RED_MAX
    else
      if eq op OMEGA_TR_MIN
        r = OMEGA_RED_MIN
      else
        if eq op OMEGA_TR_MEAN
          r = OMEGA_RED_MEAN
        else
          ret OMEGA_NUMERIC_ERR_BAD_ARGS
        end
      end
    end
  end
  if eq n 0
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  ret omega_reduce_cpu r x xoff n
end

fn omega_tensor_seam_reduce_source dst edit uchar * to long
  sn = len OMEGA_TENSOR_SEAM_SOURCE
  if lt len dst sn
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  for i ulong sn bound 64
    put dst i get OMEGA_TENSOR_SEAM_SOURCE i
  end
  ret long sn
end

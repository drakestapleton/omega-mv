note SPDX-License-Identifier: Apache-2.0
note test_tensor.om -- Pure seeded OM-2 M20 OMEGA_TENSOR CPU & GB10-map test suite.

global tt_c ulong 2
note 0=checks, 1=fails

text msg_pass "M20_OMEGA_TENSOR_TESTS_PASS\n"
text msg_fail "M20_OMEGA_TENSOR_TESTS_FAIL\n"

fn t_chk cond bool to void
  put tt_c 0 add get tt_c 0 1
  if not cond
    put tt_c 1 add get tt_c 1 1
  end
end

fn t_near a f32 b f32 tol f32 to bool
  ret le fabs sub a b tol
end

fn test_lifetime_and_views to void
  t_chk eq ot_ctx_init 64 OT_OK
  sh = new ulong 8 0
  put sh 0 2
  put sh 1 3
  dat = new f32 6 0.0f32
  for i ulong 6
    put dat i f32 add i 1
  end
  ha = new ulong 2 0
  t_chk eq ot_from_f32 2 sh dat ha OT_OK
  ht = new ulong 2 0
  t_chk eq ot_transpose get ha 0 get ha 1 ht OT_OK
  obuf = new f32 6 0.0f32
  t_chk eq ot_read_f32 get ht 0 get ht 1 obuf OT_OK
  t_chk eq get obuf 0 1.0f32
  t_chk eq get obuf 1 4.0f32
  t_chk eq get obuf 2 2.0f32
  t_chk eq get obuf 3 5.0f32
  t_chk eq get obuf 4 3.0f32
  t_chk eq get obuf 5 6.0f32
  note Value ID invariance across contiguous copy of transposed view
  hc = new ulong 2 0
  t_chk eq ot_contiguous get ht 0 get ht 1 hc OT_OK
  eq_f = new ulong 1 0
  t_chk eq ot_value_equal get ht 0 get ht 1 get hc 0 get hc 1 eq_f OT_OK
  t_chk eq get eq_f 0 1
  note Releasing parent makes view stale
  t_chk eq ot_release get ha 0 get ha 1 OT_OK
  t_chk eq ot_release get ha 0 get ha 1 OT_ERR_STALE
  t_chk eq ot_read_f32 get ht 0 get ht 1 obuf OT_ERR_STALE
  t_chk eq ot_release get ht 0 get ht 1 OT_OK
  t_chk eq ot_release get hc 0 get hc 1 OT_OK
  lc = new ulong 2 0
  ot_live_counts lc
  t_chk and eq get lc 0 0 eq get lc 1 0
  note Generation retirement at UINT64_MAX
  t_chk eq ot_set_st_gen_test 0 OT_U64_MAX OT_OK
  t_chk eq ot_from_f32 2 sh dat ha OT_OK
  t_chk eq get ot_ts_meta add mul get ha 0 10 7 0
  t_chk eq ot_release get ha 0 get ha 1 OT_OK
  t_chk eq ot_from_f32 2 sh dat ha OT_OK
  t_chk ne get ot_ts_meta add mul get ha 0 10 7 0
  t_chk eq ot_release get ha 0 get ha 1 OT_OK
end

fn test_slice_embed_concat to void
  t_chk eq ot_ctx_init 64 OT_OK
  sh = new ulong 8 0
  put sh 0 2
  put sh 1 4
  dat = new f32 8 0.0f32
  for i ulong 8
    put dat i f32 add i 1
  end
  ha = new ulong 2 0
  t_chk eq ot_from_f32 2 sh dat ha OT_OK
  st = new ulong 8 0
  sp = new ulong 8 0
  stp = new ulong 8 0
  put st 0 0
  put st 1 1
  put sp 0 2
  put sp 1 4
  put stp 0 1
  put stp 1 2
  hs = new ulong 2 0
  t_chk eq ot_slice get ha 0 get ha 1 st sp stp hs OT_OK
  obuf = new f32 4 0.0f32
  t_chk eq ot_read_f32 get hs 0 get hs 1 obuf OT_OK
  t_chk eq get obuf 0 2.0f32
  t_chk eq get obuf 1 4.0f32
  t_chk eq get obuf 2 6.0f32
  t_chk eq get obuf 3 8.0f32
  he = new ulong 2 0
  t_chk eq ot_embed get hs 0 get hs 1 sh st stp he OT_OK
  out8 = new f32 8 0.0f32
  t_chk eq ot_read_f32 get he 0 get he 1 out8 OT_OK
  t_chk eq get out8 0 0.0f32
  t_chk eq get out8 1 2.0f32
  t_chk eq get out8 3 4.0f32
  t_chk eq get out8 5 6.0f32
  t_chk eq get out8 7 8.0f32
  sl = new ulong 16 0
  gn = new ulong 16 0
  put sl 0 get hs 0
  put gn 0 get hs 1
  put sl 1 get hs 0
  put gn 1 get hs 1
  hc = new ulong 2 0
  t_chk eq ot_concat 2 sl gn 1 hc OT_OK
  t_chk eq ot_read_f32 get hc 0 get hc 1 out8 OT_OK
  t_chk eq get out8 0 2.0f32
  t_chk eq get out8 2 2.0f32
  t_chk eq get out8 4 6.0f32
  t_chk eq get out8 7 8.0f32
end

fn test_ops_and_where to void
  t_chk eq ot_ctx_init 64 OT_OK
  sh = new ulong 8 0
  put sh 0 4
  da = new f32 4 0.0f32
  db = new f32 4 0.0f32
  put da 0 -2.0f32
  put da 1 0.0f32
  put da 2 4.0f32
  put da 3 9.0f32
  put db 0 1.0f32
  put db 1 0.0f32
  put db 2 2.0f32
  put db 3 10.0f32
  ha = new ulong 2 0
  ha2 = new ulong 2 0
  hb = new ulong 2 0
  t_chk eq ot_from_f32 1 sh da ha OT_OK
  put ha2 0 get ha 0
  put ha2 1 get ha 1
  t_chk eq ot_from_f32 1 sh db hb OT_OK
  hr = new ulong 2 0
  obuf = new f32 4 0.0f32
  t_chk eq ot_unary OT_TU_RELU get ha 0 get ha 1 hr OT_OK
  t_chk eq ot_read_f32 get hr 0 get hr 1 obuf OT_OK
  t_chk eq get obuf 0 0.0f32
  t_chk eq get obuf 2 4.0f32
  t_chk eq ot_unary OT_TU_NEG get ha 0 get ha 1 hr OT_OK
  t_chk eq ot_read_f32 get hr 0 get hr 1 obuf OT_OK
  t_chk eq get obuf 0 2.0f32
  t_chk eq bitcast uint get obuf 1 OT_NEG0_BITS
  hm = new ulong 2 0
  t_chk eq ot_binary OT_TB_CMP_GT get ha 0 get ha 1 get hb 0 get hb 1 hm OT_OK
  hw = new ulong 2 0
  t_chk eq ot_where hm ha hb hw OT_OK
  t_chk eq ot_read_f32 get hw 0 get hw 1 obuf OT_OK
  t_chk eq get obuf 0 1.0f32
  t_chk eq get obuf 2 4.0f32
  t_chk eq get obuf 3 10.0f32
  note Bad mask refused
  t_chk eq ot_where ha2 ha hb hw OT_ERR_MASK
  note Transcendentals
  t_chk t_near ot_unary_scalar OT_TU_EXP 0.0f32 1.0f32 0.0001f32
  t_chk t_near ot_unary_scalar OT_TU_EXP2 3.0f32 8.0f32 0.001f32
  t_chk t_near ot_unary_scalar OT_TU_LOG 1.0f32 0.0f32 0.0001f32
  t_chk t_near ot_unary_scalar OT_TU_LOG2 8.0f32 3.0f32 0.001f32
  t_chk t_near ot_unary_scalar OT_TU_SIGMOID 0.0f32 0.5f32 0.0001f32
  t_chk t_near ot_unary_scalar OT_TU_TANH 0.0f32 0.0f32 0.0001f32
  t_chk t_near ot_unary_scalar OT_TU_SIN 0.0f32 0.0f32 0.0001f32
  t_chk t_near ot_unary_scalar OT_TU_COS 0.0f32 1.0f32 0.0001f32
  t_chk t_near ot_unary_scalar OT_TU_ERF 0.0f32 0.0f32 0.0001f32
  t_chk t_near ot_unary_scalar OT_TU_GELU 0.0f32 0.0f32 0.0001f32
  t_chk t_near ot_unary_scalar OT_TU_RSQRT 4.0f32 0.5f32 0.0001f32
end

fn test_reduce_matmul_cast to void
  t_chk eq ot_ctx_init 64 OT_OK
  sh = new ulong 8 0
  put sh 0 2
  put sh 1 3
  da = new f32 6 0.0f32
  for i ulong 6
    put da i f32 add i 1
  end
  ha = new ulong 2 0
  t_chk eq ot_from_f32 2 sh da ha OT_OK
  hr = new ulong 2 0
  t_chk eq ot_reduce OT_TR_SUM get ha 0 get ha 1 1 0 hr OT_OK
  o2 = new f32 2 0.0f32
  t_chk eq ot_read_f32 get hr 0 get hr 1 o2 OT_OK
  t_chk eq get o2 0 6.0f32
  t_chk eq get o2 1 15.0f32
  note multi-axis reduce and sum_to_shape
  ax = new ulong 8 0
  put ax 0 0
  put ax 1 1
  ko = new ulong 3 0
  put ko 2 0
  t_chk eq ot_reduce_axes OT_TR_SUM get ha 0 get ha 1 2 ax ko OT_OK
  o1 = new f32 1 0.0f32
  t_chk eq ot_read_f32 get ko 0 get ko 1 o1 OT_OK
  t_chk eq get o1 0 21.0f32
  t_chk eq ot_reduce_axes OT_TR_MEAN get ha 0 get ha 1 2 ax ko OT_ERR_BAD_ARGS
  tsh = new ulong 8 0
  put tsh 0 3
  hs = new ulong 2 0
  t_chk eq ot_sum_to_shape get ha 0 get ha 1 1 tsh hs OT_OK
  o3 = new f32 3 0.0f32
  t_chk eq ot_read_f32 get hs 0 get hs 1 o3 OT_OK
  t_chk eq get o3 0 5.0f32
  t_chk eq get o3 1 7.0f32
  t_chk eq get o3 2 9.0f32
end

fn test_matmul_cast_gb10 to void
  t_chk eq ot_ctx_init 64 OT_OK
  sh = new ulong 8 0
  put sh 0 2
  put sh 1 3
  da = new f32 6 0.0f32
  for i ulong 6
    put da i f32 add i 1
  end
  ha = new ulong 2 0
  t_chk eq ot_from_f32 2 sh da ha OT_OK
  note matmul [2,3] x [3,2]
  shb = new ulong 8 0
  put shb 0 3
  put shb 1 2
  hb = new ulong 2 0
  t_chk eq ot_from_f32 2 shb da hb OT_OK
  hm = new ulong 2 0
  t_chk eq ot_matmul get ha 0 get ha 1 get hb 0 get hb 1 hm OT_OK
  o4 = new f32 4 0.0f32
  t_chk eq ot_read_f32 get hm 0 get hm 1 o4 OT_OK
  t_chk eq get o4 0 22.0f32
  t_chk eq get o4 1 28.0f32
  t_chk eq get o4 2 49.0f32
  t_chk eq get o4 3 64.0f32
  note F32 <-> F16 and BF16 cast round-trip
  hf16 = new ulong 2 0
  hf32 = new ulong 2 0
  t_chk eq ot_cast get ha 0 get ha 1 OT_DT_F16 hf16 OT_OK
  t_chk eq ot_cast get hf16 0 get hf16 1 OT_DT_BF16 hf32 OT_ERR_DTYPE
  t_chk eq ot_cast get hf16 0 get hf16 1 OT_DT_F32 hf32 OT_OK
  o6 = new f32 6 0.0f32
  t_chk eq ot_read_f32 get hf32 0 get hf32 1 o6 OT_OK
  t_chk eq get o6 5 6.0f32
  note GB10 mapping checks
  t_chk ne ot_gb10_simt_op_id OT_TB_ADD 0
  t_chk eq ot_gb10_simt_op_id OT_TB_CMP_EQ 0
  t_chk eq ot_gb10_transc_kernel OT_TU_EXP 9
  t_chk eq ot_gb10_transc_kernel OT_TU_RELU -1
  t_chk eq ot_gb10_check_reduce OT_TR_SUM 32769 OT_GB10_ERR_OPERANDS
end

fn main to int
  test_lifetime_and_views
  test_slice_embed_concat
  test_ops_and_where
  test_reduce_matmul_cast
  test_matmul_cast_gb10
  if ne get tt_c 1 0
    w = write 1 msg_fail 0 len msg_fail
    ret 1
  end
  w = write 1 msg_pass 0 len msg_pass
  ret 0
end

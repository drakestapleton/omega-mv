note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 tensor data-movement and descriptor-planning kernels
note backing src/tensor/omega_tensor.c:
note   tensor_copy_op mode 0=gather, 1=scatter, 2=u16_to_u32, 3=u32_to_u16,
note                       4=full_u32, 5=matmul_pack_side
note   tensor_plan_op mode 0=transpose_perm, 1=reduce_move_axis
om2

fn tensor_step_odometer idx edit ulong 8 desc view ulong 21 pos ulong to ulong
  rank = get desc 16
  for k ulong rank
    ax = sub sub rank 1 k
    next_i = add get idx ax 1
    if lt next_i get desc ax
      put idx ax next_i
      ret add pos get desc add 8 ax
    end
    pos = sub pos mul sub get desc ax 1 get desc add 8 ax
    put idx ax 0
  end
  ret pos
end

fn tensor_gather_impl src view uchar * dst edit uchar * desc view ulong 21 to void
  idx = new ulong 8 0
  pos = get desc 17
  for e ulong get desc 19
    es = get desc 18
    for b ulong es
      v = get src add mul pos es b
      put dst add mul e es b v
    end
    pos = tensor_step_odometer idx desc pos
  end
end

fn tensor_scatter_impl src view uchar * dst edit uchar * desc view ulong 21 to void
  idx = new ulong 8 0
  pos = get desc 17
  for e ulong get desc 19
    es = get desc 18
    for b ulong es
      v = get src add mul e es b
      put dst add mul pos es b v
    end
    pos = tensor_step_odometer idx desc pos
  end
end

fn tensor_u16_to_u32_impl src view uchar * dst edit uchar * elems ulong to void
  for i ulong elems
    s = mul i 2
    d = mul i 4
    b0 = get src s
    b1 = get src add s 1
    put dst d b0
    put dst add d 1 b1
    put dst add d 2 0
    put dst add d 3 0
  end
end

fn tensor_u32_to_u16_impl src view uchar * dst edit uchar * elems ulong to void
  for i ulong elems
    s = mul i 4
    d = mul i 2
    b0 = get src s
    b1 = get src add s 1
    put dst d b0
    put dst add d 1 b1
  end
end

fn tensor_full_u32_impl dst edit uchar * bits ulong elems ulong to void
  b0 = uchar and bits 255
  b1 = uchar and shr bits 8 255
  b2 = uchar and shr bits 16 255
  b3 = uchar and shr bits 24 255
  for i ulong elems
    d = mul i 4
    put dst d b0
    put dst add d 1 b1
    put dst add d 2 b2
    put dst add d 3 b3
  end
end

fn tensor_matmul_src_base desc view ulong 21 e ulong to ulong
  m = get desc 0
  n = get desc 1
  k = get desc 2
  b = div e mul m n
  if ne get desc 5 0
    ret mul add mul b n rem e n k
  end
  ret mul add mul b m rem div e n m k
end

fn tensor_matmul_pack_impl src view uchar * dst edit uchar * desc view ulong 21 to void
  kbytes = mul get desc 2 4
  for q ulong get desc 4
    src_base = mul tensor_matmul_src_base desc add get desc 3 q 4
    dst_base = mul q kbytes
    for t ulong kbytes
      v = get src add src_base t
      put dst add dst_base t v
    end
  end
end

export fn tensor_copy_op src view uchar * dst edit uchar * desc view ulong 21 to void
  mode = get desc 20
  if eq mode 0
    tensor_gather_impl src dst desc
    ret
  end
  if eq mode 1
    tensor_scatter_impl src dst desc
    ret
  end
  if eq mode 2
    tensor_u16_to_u32_impl src dst get desc 19
    ret
  end
  if eq mode 3
    tensor_u32_to_u16_impl src dst get desc 19
    ret
  end
  if eq mode 4
    tensor_full_u32_impl dst get desc 17 get desc 19
    ret
  end
  if eq mode 5
    tensor_matmul_pack_impl src dst desc
    ret
  end
end

export fn tensor_plan_op in_a view ulong 8 in_b view ulong 8 out_buf edit ulong 24 meta view ulong 4 to void
  mode = get meta 3
  r = get meta 0
  if eq mode 0
    for d ulong r
      put out_buf d d
    end
    put out_buf sub r 2 sub r 1
    put out_buf sub r 1 sub r 2
    ret
  end
  axis = get meta 1
  keepdims = get meta 2
  k = ulong 0
  j = ulong 0
  for d ulong r
    if eq d axis
      if ne keepdims 0
        put out_buf add 16 j 1
        j = add j 1
      end
    else
      put out_buf k get in_a d
      put out_buf add 8 k get in_b d
      k = add k 1
      put out_buf add 16 j get in_a d
      j = add j 1
    end
  end
  put out_buf k get in_a axis
  put out_buf add 8 k get in_b axis
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Omega mixed algebra library (oma_trit, oma_z3, oma_pack, oma_quant).
om2

const OMA_OK int 0
const OMA_E_INVALID_TRIT int -1
const OMA_E_INVALID_CODE int -2
const OMA_E_INVALID_PLANES int -3
const OMA_E_OVERFLOW int -4
const OMA_E_INVALID_BYTE int -5
const OMA_E_INVALID_Z3 int -6
const OMA_E_ARG int -7
const OMA_E_UNDERFLOW int -8
const OMA_E_NATIVE int -9

const OMA_CODE_ZERO uchar 0
const OMA_CODE_POS uchar 1
const OMA_CODE_NEG uchar 2
const OMA_CODE_INVALID uchar 3

const OMA_DOT_I8_MAX_N ulong 16777215
const OMA_INT64_MAX_DIGITS ulong 41
const OMA_DENSE_TRITS_PER_BYTE ulong 5
const OMA_DENSE_BYTE_LIMIT int 243
const OMA_BLOCK_BYTES ulong 16

text oma_nl "\n"
text oma_minus "-"

fn oma_w_all fd int buf view uchar * n ulong to void
  off = ulong 0
  while lt off n bound 1000000
    k = write fd buf off sub n off
    if le k 0
      break
    end
    off = add off ulong k
  end
end

fn oma_put_str s view uchar * to void
  oma_w_all 1 s len s
end

fn oma_put_err s view uchar * to void
  oma_w_all 2 s len s
end

fn oma_put_u64 fd int v ulong to void
  buf = new uchar 24 0
  if eq v 0
    put buf 0 uchar 48
    oma_w_all fd buf 1
    ret
  end
  tmp = new uchar 24 0
  cnt = ulong 0
  x = v
  while gt x 0 bound 32
    d = rem x 10
    put tmp cnt uchar add 48 d
    cnt = add cnt 1
    x = div x 10
  end
  for i ulong cnt bound 32
    put buf i get tmp sub sub cnt 1 i
  end
  oma_w_all fd buf cnt
end

fn oma_put_i64 fd int v long to void
  if lt v 0
    oma_w_all fd oma_minus 1
    u = sub ulong 0 bitcast ulong v
    oma_put_u64 fd u
  else
    oma_put_u64 fd ulong v
  end
end

note ---- bit helpers ----

fn oma_popcount64 x ulong to ulong
  y = sub x and shr x 1 0x5555555555555555
  y = add and y 0x3333333333333333 and shr y 2 0x3333333333333333
  y = and add y shr y 4 0x0f0f0f0f0f0f0f0f
  ret shr mul y 0x0101010101010101 56
end

fn oma_ctz64 x ulong to ulong
  if eq x 0
    ret 64
  end
  lo = and x sub ulong 0 x
  ret oma_popcount64 sub lo 1
end

fn oma_add_i64_ok a long b long to ulong
  if gt b 0
    if gt a sub 9223372036854775807 b
      ret 0
    end
  end
  if lt b 0
    minv = sub long -9223372036854775807 1
    if lt a sub minv b
      ret 0
    end
  end
  ret 1
end

fn oma_f32_isfinite x f32 to bool
  bits = and bitcast uint x 0x7fffffff
  ret lt bits 0x7f800000
end

fn oma_f64_isfinite x f64 to bool
  bits = and bitcast ulong x 0x7fffffffffffffff
  ret lt bits 0x7ff0000000000000
end

fn oma_f64_ldexp x f64 e int to f64
  r = x
  k = e
  while gt k 0 bound 2048
    r = mul r 2.0f64
    k = sub k 1
  end
  while lt k 0 bound 2048
    r = mul r 0.5f64
    k = add k 1
  end
  ret r
end

note ---- scalar trits and codes ----

fn oma_trit_make v int dst edit byte 1 to int
  if or lt v -1 gt v 1
    ret OMA_E_INVALID_TRIT
  end
  put dst 0 byte v
  ret OMA_OK
end

fn oma_trit_to_code t int dst edit uchar 1 to int
  if eq t 0
    put dst 0 OMA_CODE_ZERO
    ret OMA_OK
  end
  if eq t 1
    put dst 0 OMA_CODE_POS
    ret OMA_OK
  end
  if eq t -1
    put dst 0 OMA_CODE_NEG
    ret OMA_OK
  end
  ret OMA_E_INVALID_TRIT
end

fn oma_code_to_trit code int dst edit byte 1 to int
  if or lt code 0 gt code 2
    ret OMA_E_INVALID_CODE
  end
  p = and code 1
  n = and shr code 1 1
  put dst 0 byte sub p n
  ret OMA_OK
end

fn oma_code_neg a int dst edit uchar 1 to int
  if or lt a 0 gt a 2
    ret OMA_E_INVALID_CODE
  end
  p = and a 1
  n = and shr a 1 1
  put dst 0 uchar or shl p 1 n
  ret OMA_OK
end

fn oma_code_add a int b int dst edit uchar 2 to int
  if or or lt a 0 gt a 2 or lt b 0 gt b 2
    ret OMA_E_INVALID_CODE
  end
  ap = ulong and a 1
  an = ulong and shr a 1 1
  bp = ulong and b 1
  bn = ulong and shr b 1 1
  az = xor ulong 1 or ap an
  bz = xor ulong 1 or bp bn
  sp = or or and ap bz and az bp and an bn
  sn = or or and an bz and az bn and ap bp
  cp = and ap bp
  cn = and an bn
  put dst 0 uchar or sp shl sn 1
  put dst 1 uchar or cp shl cn 1
  ret OMA_OK
end

fn oma_code_mul a int b int dst edit uchar 1 to int
  if or or lt a 0 gt a 2 or lt b 0 gt b 2
    ret OMA_E_INVALID_CODE
  end
  ap = ulong and a 1
  an = ulong and shr a 1 1
  bp = ulong and b 1
  bn = ulong and shr b 1 1
  pp = or and ap bp and an bn
  pn = or and ap bn and an bp
  put dst 0 uchar or pp shl pn 1
  ret OMA_OK
end

fn oma_trit_neg a int dst edit byte 1 to int
  ca = new uchar 1 0
  r = new uchar 1 0
  rc = oma_trit_to_code a ca
  if ne rc 0
    ret rc
  end
  rc = oma_code_neg int get ca 0 r
  if ne rc 0
    ret rc
  end
  ret oma_code_to_trit int get r 0 dst
end

fn oma_trit_add a int b int dst edit byte 2 to int
  ca = new uchar 1 0
  cb = new uchar 1 0
  sc = new uchar 2 0
  t0 = new byte 1 0
  t1 = new byte 1 0
  rc = oma_trit_to_code a ca
  if ne rc 0
    ret rc
  end
  rc = oma_trit_to_code b cb
  if ne rc 0
    ret rc
  end
  rc = oma_code_add int get ca 0 int get cb 0 sc
  if ne rc 0
    ret rc
  end
  rc = oma_code_to_trit int get sc 0 t0
  if ne rc 0
    ret rc
  end
  rc = oma_code_to_trit int get sc 1 t1
  if ne rc 0
    ret rc
  end
  put dst 0 get t0 0
  put dst 1 get t1 0
  ret OMA_OK
end

fn oma_trit_mul a int b int dst edit byte 1 to int
  ca = new uchar 1 0
  cb = new uchar 1 0
  r = new uchar 1 0
  rc = oma_trit_to_code a ca
  if ne rc 0
    ret rc
  end
  rc = oma_trit_to_code b cb
  if ne rc 0
    ret rc
  end
  rc = oma_code_mul int get ca 0 int get cb 0 r
  if ne rc 0
    ret rc
  end
  ret oma_code_to_trit int get r 0 dst
end

note ---- 64-trit blocks (represented as ulong 2: [0]=pos, [1]=neg) ----

fn oma_block_validate b view ulong 2 to int
  if ne and get b 0 get b 1 0
    ret OMA_E_INVALID_PLANES
  end
  ret OMA_OK
end

fn oma_block_encode src view byte 64 dst edit ulong 2 to int
  p = ulong 0
  n = ulong 0
  for i ulong 64
    v = int get src i
    if eq v 1
      p = or p shl ulong 1 i
    else
      if eq v -1
        n = or n shl ulong 1 i
      else
        if ne v 0
          ret OMA_E_INVALID_TRIT
        end
      end
    end
  end
  put dst 0 p
  put dst 1 n
  ret OMA_OK
end

fn oma_block_decode b view ulong 2 dst edit byte 64 to int
  p = get b 0
  n = get b 1
  if ne and p n 0
    ret OMA_E_INVALID_PLANES
  end
  for i ulong 64
    pb = and shr p i 1
    nb = and shr n i 1
    if eq pb 1
      put dst i byte 1
    else
      if eq nb 1
        put dst i byte -1
      else
        put dst i byte 0
      end
    end
  end
  ret OMA_OK
end

fn oma_block_neg a view ulong 2 dst edit ulong 2 to int
  p = get a 0
  n = get a 1
  if ne and p n 0
    ret OMA_E_INVALID_PLANES
  end
  put dst 0 n
  put dst 1 p
  ret OMA_OK
end

fn oma_block_add a view ulong 2 b view ulong 2 sum edit ulong 2 carry edit ulong 2 to int
  ap = get a 0
  an = get a 1
  bp = get b 0
  bn = get b 1
  if or ne and ap an 0 ne and bp bn 0
    ret OMA_E_INVALID_PLANES
  end
  all1 = ulong 0xffffffffffffffff
  az = xor all1 or ap an
  bz = xor all1 or bp bn
  put sum 0 or or and ap bz and az bp and an bn
  put sum 1 or or and an bz and az bn and ap bp
  put carry 0 and ap bp
  put carry 1 and an bn
  ret OMA_OK
end

fn oma_block_mul a view ulong 2 b view ulong 2 dst edit ulong 2 to int
  ap = get a 0
  an = get a 1
  bp = get b 0
  bn = get b 1
  if or ne and ap an 0 ne and bp bn 0
    ret OMA_E_INVALID_PLANES
  end
  put dst 0 or and ap bp and an bn
  put dst 1 or and ap bn and an bp
  ret OMA_OK
end

fn oma_block_dot a view ulong 2 b view ulong 2 dst edit int 1 to int
  ap = get a 0
  an = get a 1
  bp = get b 0
  bn = get b 1
  if or ne and ap an 0 ne and bp bn 0
    ret OMA_E_INVALID_PLANES
  end
  pp = or and ap bp and an bn
  pn = or and ap bn and an bp
  diff = sub long oma_popcount64 pp long oma_popcount64 pn
  put dst 0 int diff
  ret OMA_OK
end

fn oma_bitplane_blocks n ulong to ulong
  q = div n 64
  if ne rem n 64 0
    ret add q 1
  end
  ret q
end

fn oma_dense_bytes n ulong to ulong
  q = div n 5
  if ne rem n 5 0
    ret add q 1
  end
  ret q
end

fn oma_has_stray p ulong ng ulong lanes ulong to bool
  if ge lanes 64
    ret false
  end
  live = sub shl ulong 1 lanes 1
  dead = xor ulong 0xffffffffffffffff live
  ret ne and or p ng dead 0
end

fn oma_dot_block_i8 p ulong ng ulong x view byte * base ulong to int
  acc = int 0
  mp = p
  while ne mp 0 bound 65
    bit = oma_ctz64 mp
    acc = add acc int get x add base bit
    mp = and mp sub mp 1
  end
  mn = ng
  while ne mn 0 bound 65
    bit = oma_ctz64 mn
    acc = sub acc int get x add base bit
    mn = and mn sub mn 1
  end
  ret acc
end

fn oma_dot_tw_i8 w view ulong * x view byte * n ulong dst edit int 1 to int
  if gt n OMA_DOT_I8_MAX_N
    ret OMA_E_OVERFLOW
  end
  nb = oma_bitplane_blocks n
  if lt len w mul nb 2
    ret OMA_E_ARG
  end
  if lt len x n
    ret OMA_E_ARG
  end
  acc = int 0
  for k ulong nb bound 300000
    p = get w mul k 2
    ng = get w add mul k 2 1
    if ne and p ng 0
      ret OMA_E_INVALID_PLANES
    end
    if oma_has_stray p ng sub n mul k 64
      ret OMA_E_ARG
    end
    acc = add acc oma_dot_block_i8 p ng x mul k 64
  end
  put dst 0 acc
  ret OMA_OK
end

note ---- integer <-> balanced ternary ----

fn oma_int_to_bt v long dst edit byte * cap ulong ndigits edit ulong 1 to int
  tmp = new byte 41 0
  v_bits = bitcast ulong v
  is_neg = ulong 0
  u = v_bits
  if ge v_bits 0x8000000000000000
    is_neg = 1
    u = sub ulong 0 v_bits
  end
  n = ulong 0
  while gt u 0 bound 64
    r = rem u 3
    u = div u 3
    d = int r
    if eq r 2
      d = -1
      u = add u 1
    end
    if eq is_neg 1
      d = sub 0 d
    end
    put tmp n byte d
    n = add n 1
  end
  if gt n cap
    ret OMA_E_OVERFLOW
  end
  if lt len dst n
    ret OMA_E_OVERFLOW
  end
  for i ulong n bound 64
    put dst i get tmp i
  end
  put ndigits 0 n
  ret OMA_OK
end

fn oma_int_to_bt_fixed v long dst edit byte * n ulong to int
  nd = new ulong 1 0
  rc = oma_int_to_bt v dst n nd
  if ne rc 0
    ret rc
  end
  used = get nd 0
  i = used
  while lt i n bound 64
    put dst i byte 0
    i = add i 1
  end
  ret OMA_OK
end

fn oma_bt_to_int digits view byte * n ulong dst edit long 1 to int
  if lt len digits n
    ret OMA_E_ARG
  end
  for i ulong n bound 1024
    v = int get digits i
    if or lt v -1 gt v 1
      ret OMA_E_INVALID_TRIT
    end
  end
  acc = long 0
  i = n
  while gt i 0 bound 1024
    i = sub i 1
    d = long get digits i
    if eq oma_add_i64_ok acc d 0
      ret OMA_E_OVERFLOW
    end
    t = add acc d
    if eq oma_add_i64_ok t acc 0
      ret OMA_E_OVERFLOW
    end
    t = add t acc
    if eq oma_add_i64_ok t acc 0
      ret OMA_E_OVERFLOW
    end
    acc = add t acc
  end
  put dst 0 acc
  ret OMA_OK
end

note ---- Z3 ----

fn oma_z3_make v int dst edit uchar 1 to int
  if or lt v 0 gt v 2
    ret OMA_E_INVALID_Z3
  end
  put dst 0 uchar v
  ret OMA_OK
end

fn oma_z3_add a int b int dst edit uchar 1 to int
  if or or lt a 0 gt a 2 or lt b 0 gt b 2
    ret OMA_E_INVALID_Z3
  end
  put dst 0 uchar rem add a b 3
  ret OMA_OK
end

fn oma_z3_mul a int b int dst edit uchar 1 to int
  if or or lt a 0 gt a 2 or lt b 0 gt b 2
    ret OMA_E_INVALID_Z3
  end
  put dst 0 uchar rem mul a b 3
  ret OMA_OK
end

fn oma_z3_neg a int dst edit uchar 1 to int
  if or lt a 0 gt a 2
    ret OMA_E_INVALID_Z3
  end
  put dst 0 uchar rem sub 3 a 3
  ret OMA_OK
end

fn oma_z3_to_trit a int dst edit byte 1 to int
  if or lt a 0 gt a 2
    ret OMA_E_INVALID_Z3
  end
  if eq a 2
    put dst 0 byte -1
  else
    put dst 0 byte a
  end
  ret OMA_OK
end

fn oma_trit_to_z3 t int dst edit uchar 1 to int
  if or lt t -1 gt t 1
    ret OMA_E_INVALID_TRIT
  end
  if lt t 0
    put dst 0 uchar 2
  else
    put dst 0 uchar t
  end
  ret OMA_OK
end

fn oma_z3_block_validate b view ulong 2 to int
  if ne and get b 0 get b 1 0
    ret OMA_E_INVALID_PLANES
  end
  ret OMA_OK
end

fn oma_z3_block_encode src view uchar 64 dst edit ulong 2 to int
  o = ulong 0
  t = ulong 0
  for i ulong 64
    v = ulong get src i
    if eq v 1
      o = or o shl ulong 1 i
    else
      if eq v 2
        t = or t shl ulong 1 i
      else
        if ne v 0
          ret OMA_E_INVALID_Z3
        end
      end
    end
  end
  put dst 0 o
  put dst 1 t
  ret OMA_OK
end

fn oma_z3_block_decode b view ulong 2 dst edit uchar 64 to int
  o = get b 0
  t = get b 1
  if ne and o t 0
    ret OMA_E_INVALID_PLANES
  end
  for i ulong 64
    b0 = and shr o i 1
    b1 = and shr t i 1
    put dst i uchar or b0 shl b1 1
  end
  ret OMA_OK
end

fn oma_z3_block_from_trits t view ulong 2 dst edit ulong 2 to int
  rc = oma_block_validate t
  if ne rc 0
    ret rc
  end
  put dst 0 get t 0
  put dst 1 get t 1
  ret OMA_OK
end

fn oma_z3_block_to_trits z view ulong 2 dst edit ulong 2 to int
  rc = oma_z3_block_validate z
  if ne rc 0
    ret rc
  end
  put dst 0 get z 0
  put dst 1 get z 1
  ret OMA_OK
end

fn oma_z3_block_add a view ulong 2 b view ulong 2 dst edit ulong 2 to int
  cy = new ulong 2 0
  ret oma_block_add a b dst cy
end

fn oma_z3_block_mul a view ulong 2 b view ulong 2 dst edit ulong 2 to int
  ret oma_block_mul a b dst
end

fn oma_z3_block_neg a view ulong 2 dst edit ulong 2 to int
  ret oma_block_neg a dst
end

note ---- packing and serialization ----

fn oma_block_serialize b view ulong 2 dst edit uchar 16 to int
  p = get b 0
  n = get b 1
  if ne and p n 0
    ret OMA_E_INVALID_PLANES
  end
  for i ulong 8
    put dst i uchar and shr p mul i 8 255
    put dst add 8 i uchar and shr n mul i 8 255
  end
  ret OMA_OK
end

fn oma_block_deserialize src view uchar 16 dst edit ulong 2 to int
  p = ulong 0
  n = ulong 0
  for i ulong 8
    bp = ulong get src i
    bn = ulong get src add 8 i
    p = or p shl bp mul i 8
    n = or n shl bn mul i 8
  end
  if ne and p n 0
    ret OMA_E_INVALID_PLANES
  end
  put dst 0 p
  put dst 1 n
  ret OMA_OK
end

fn oma_pack_bp_one t view byte * base ulong m ulong dst edit ulong 2 to void
  p = ulong 0
  ng = ulong 0
  for i ulong m bound 64
    v = int get t add base i
    if eq v 1
      p = or p shl ulong 1 i
    else
      if eq v -1
        ng = or ng shl ulong 1 i
      end
    end
  end
  put dst 0 p
  put dst 1 ng
end

fn oma_pack_bitplane t view byte * n ulong dst edit ulong * out_blocks ulong to int
  nb = oma_bitplane_blocks n
  if lt out_blocks nb
    ret OMA_E_OVERFLOW
  end
  if lt len t n
    ret OMA_E_ARG
  end
  if lt len dst mul nb 2
    ret OMA_E_OVERFLOW
  end
  for i ulong n bound 2000000
    v = int get t i
    if or lt v -1 gt v 1
      ret OMA_E_INVALID_TRIT
    end
  end
  tmp = new ulong 2 0
  for k ulong nb bound 100000
    base = mul k 64
    m = sub n base
    if gt m 64
      m = 64
    end
    oma_pack_bp_one t base m tmp
    put dst mul k 2 get tmp 0
    put dst add mul k 2 1 get tmp 1
  end
  ret OMA_OK
end

fn oma_unpack_bp_one p ulong ng ulong dst edit byte * base ulong m ulong to void
  for i ulong m bound 64
    pb = and shr p i 1
    nb_bit = and shr ng i 1
    if eq pb 1
      put dst add base i byte 1
    else
      if eq nb_bit 1
        put dst add base i byte -1
      else
        put dst add base i byte 0
      end
    end
  end
end

fn oma_unpack_bitplane src view ulong * in_blocks ulong n ulong dst edit byte * to int
  nb = oma_bitplane_blocks n
  if lt in_blocks nb
    ret OMA_E_ARG
  end
  if lt len src mul nb 2
    ret OMA_E_ARG
  end
  if lt len dst n
    ret OMA_E_ARG
  end
  for k ulong nb bound 100000
    p = get src mul k 2
    ng = get src add mul k 2 1
    if ne and p ng 0
      ret OMA_E_INVALID_PLANES
    end
    if oma_has_stray p ng sub n mul k 64
      ret OMA_E_ARG
    end
  end
  for k ulong nb bound 100000
    p = get src mul k 2
    ng = get src add mul k 2 1
    base = mul k 64
    m = sub n base
    if gt m 64
      m = 64
    end
    oma_unpack_bp_one p ng dst base m
  end
  ret OMA_OK
end

fn oma_dense_byte_decode bv int dst edit byte 5 to int
  if or lt bv 0 ge bv OMA_DENSE_BYTE_LIMIT
    ret OMA_E_INVALID_BYTE
  end
  v = ulong bv
  for j ulong 5
    r = rem v 3
    v = div v 3
    put dst j byte sub int r 1
  end
  ret OMA_OK
end

fn oma_pack_dense_one t view byte * base ulong n ulong to uchar
  bv = ulong 0
  pw = ulong 1
  for j ulong 5
    idx = add base j
    d = ulong 1
    if lt idx n
      d = ulong add int get t idx 1
    end
    bv = add bv mul d pw
    pw = mul pw 3
  end
  ret uchar bv
end

fn oma_pack_dense t view byte * n ulong dst edit uchar * out_len edit ulong 1 to int
  nbytes = oma_dense_bytes n
  if lt len t n
    ret OMA_E_ARG
  end
  if lt len dst nbytes
    ret OMA_E_OVERFLOW
  end
  for i ulong n bound 2000000
    v = int get t i
    if or lt v -1 gt v 1
      ret OMA_E_INVALID_TRIT
    end
  end
  for k ulong nbytes bound 400000
    put dst k oma_pack_dense_one t mul k 5 n
  end
  put out_len 0 nbytes
  ret OMA_OK
end

fn oma_unpack_dense src view uchar * in_len ulong n ulong dst edit byte * to int
  nbytes = oma_dense_bytes n
  if lt in_len nbytes
    ret OMA_E_ARG
  end
  if lt len src nbytes
    ret OMA_E_ARG
  end
  if lt len dst n
    ret OMA_E_ARG
  end
  d5 = new byte 5 0
  for k ulong nbytes bound 400000
    rc = oma_dense_byte_decode int get src k d5
    if ne rc 0
      ret rc
    end
    base = mul k 5
    for j ulong 5
      if ge add base j n
        if ne int get d5 j 0
          ret OMA_E_INVALID_BYTE
        end
      end
    end
  end
  for k ulong nbytes bound 400000
    rc = oma_dense_byte_decode int get src k d5
    if ne rc 0
      ret rc
    end
    base = mul k 5
    for j ulong 5
      idx = add base j
      if lt idx n
        put dst idx get d5 j
      end
    end
  end
  ret OMA_OK
end

note ---- absmean quantization ----

fn oma_quant_absmean w view f32 * n ulong q edit byte * scale edit f32 1 to int
  if lt len w n
    ret OMA_E_ARG
  end
  if lt len q n
    ret OMA_E_ARG
  end
  sum = 0.0f64
  for i ulong n bound 2000000
    wi = get w i
    if not oma_f32_isfinite wi
      ret OMA_E_ARG
    end
    sum = add sum fabs f64 wi
  end
  if or eq n 0 eq sum 0.0f64
    for i ulong n bound 2000000
      put q i byte 0
    end
    put scale 0 0.0f32
    ret OMA_OK
  end
  mean = div sum f64 n
  flt_min = bitcast f32 uint 0x00800000
  if lt mean f64 flt_min
    ret OMA_E_UNDERFLOW
  end
  s = f32 mean
  sd = f64 s
  for i ulong n bound 2000000
    r = div f64 get w i sd
    if ge r 0.5f64
      put q i byte 1
    else
      if le r -0.5f64
        put q i byte -1
      else
        put q i byte 0
      end
    end
  end
  put scale 0 s
  ret OMA_OK
end

fn oma_quant_rel_l2_check w view f32 * q view byte * to int
  n = len w
  if lt len q n
    ret OMA_E_ARG
  end
  for i ulong n bound 2000000
    if not oma_f32_isfinite get w i
      ret OMA_E_ARG
    end
    qi = int get q i
    if lt qi -1
      ret OMA_E_INVALID_TRIT
    end
    if gt qi 1
      ret OMA_E_INVALID_TRIT
    end
  end
  ret OMA_OK
end

fn oma_quant_rel_l2_num w view f32 * q view byte * scale f32 to f64
  num = 0.0f64
  sd = f64 scale
  for i ulong len w bound 2000000
    d = sub f64 get w i mul f64 int get q i sd
    num = add num mul d d
  end
  ret num
end

fn oma_quant_rel_l2_den w view f32 * to f64
  den = 0.0f64
  for i ulong len w bound 2000000
    wd = f64 get w i
    den = add den mul wd wd
  end
  ret den
end

fn oma_quant_rel_l2 w view f32 * q view byte * scale f32 err edit f64 1 to int
  if not oma_f32_isfinite scale
    ret OMA_E_ARG
  end
  if lt scale 0.0f32
    ret OMA_E_ARG
  end
  if ne oma_quant_rel_l2_check w q 0
    ret oma_quant_rel_l2_check w q
  end
  num = oma_quant_rel_l2_num w q scale
  den = oma_quant_rel_l2_den w
  if eq den 0.0f64
    if ne num 0.0f64
      ret OMA_E_ARG
    end
    put err 0 0.0f64
    ret OMA_OK
  end
  put err 0 fsqrt div num den
  ret OMA_OK
end

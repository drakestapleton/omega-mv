note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/algebra/ (oma_trit.c, oma_z3.c,
note oma_pack.c): balanced-ternary and Z3 64-lane bitplane encode/decode,
note plane add/mul/dot (SWAR popcount64), 16-byte LE block serialize/deserialize,
note 5-trit base-3 dense byte pack/unpack, and int64 <-> balanced ternary.
om2

fn oma_popcount64 x ulong to ulong
  y = sub x and shr x 1 0x5555555555555555
  y = add and y 0x3333333333333333 and shr y 2 0x3333333333333333
  y = and add y shr y 4 0x0f0f0f0f0f0f0f0f
  ret shr mul y 0x0101010101010101 56
end

export fn oma_om_block_encode src view uchar 64 dst edit ulong 2 to ulong
  p = ulong 0
  n = ulong 0
  for i ulong 64
    b = ulong get src i
    if eq b 1
      p = or p shl ulong 1 i
    else
      if eq b 255
        n = or n shl ulong 1 i
      else
        if ne b 0
          ret 1
        end
      end
    end
  end
  put dst 0 p
  put dst 1 n
  ret 0
end

export fn oma_om_block_decode pos ulong neg_p ulong dst edit uchar 64 to ulong
  if ne and pos neg_p 0
    ret 3
  end
  for i ulong 64
    pb = and shr pos i 1
    nb = and shr neg_p i 1
    if eq pb 1
      put dst i uchar 1
    else
      if eq nb 1
        put dst i uchar 255
      else
        put dst i uchar 0
      end
    end
  end
  ret 0
end

export fn oma_om_block_add a view ulong 2 b view ulong 2 dst edit ulong 4 to ulong
  ap = get a 0
  an = get a 1
  bp = get b 0
  bn = get b 1
  if or ne and ap an 0 ne and bp bn 0
    ret 3
  end
  all1 = ulong 0xffffffffffffffff
  az = xor all1 or ap an
  bz = xor all1 or bp bn
  sp = or or and ap bz and az bp and an bn
  sn = or or and an bz and az bn and ap bp
  put dst 0 sp
  put dst 1 sn
  put dst 2 and ap bp
  put dst 3 and an bn
  ret 0
end

export fn oma_om_block_mul a view ulong 2 b view ulong 2 dst edit ulong 2 to ulong
  ap = get a 0
  an = get a 1
  bp = get b 0
  bn = get b 1
  if or ne and ap an 0 ne and bp bn 0
    ret 3
  end
  put dst 0 or and ap bp and an bn
  put dst 1 or and ap bn and an bp
  ret 0
end

export fn oma_om_block_dot a view ulong 2 b view ulong 2 dst edit ulong 1 to ulong
  ap = get a 0
  an = get a 1
  bp = get b 0
  bn = get b 1
  if or ne and ap an 0 ne and bp bn 0
    ret 3
  end
  pp = or and ap bp and an bn
  pn = or and ap bn and an bp
  put dst 0 sub oma_popcount64 pp oma_popcount64 pn
  ret 0
end

export fn oma_om_z3_encode src view uchar 64 dst edit ulong 2 to ulong
  o = ulong 0
  t = ulong 0
  for i ulong 64
    b = ulong get src i
    if eq b 1
      o = or o shl ulong 1 i
    else
      if eq b 2
        t = or t shl ulong 1 i
      else
        if ne b 0
          ret 6
        end
      end
    end
  end
  put dst 0 o
  put dst 1 t
  ret 0
end

export fn oma_om_z3_decode one ulong two ulong dst edit uchar 64 to ulong
  if ne and one two 0
    ret 3
  end
  for i ulong 64
    b0 = and shr one i 1
    b1 = and shr two i 1
    put dst i uchar or b0 shl b1 1
  end
  ret 0
end

export fn oma_om_block_serialize pos ulong neg_p ulong dst edit uchar 16 to ulong
  if ne and pos neg_p 0
    ret 3
  end
  for i ulong 8
    put dst i uchar and shr pos mul i 8 255
    put dst add 8 i uchar and shr neg_p mul i 8 255
  end
  ret 0
end

export fn oma_om_block_deserialize src view uchar 16 dst edit ulong 2 to ulong
  p = ulong 0
  n = ulong 0
  for i ulong 8
    bp = ulong get src i
    bn = ulong get src add 8 i
    p = or p shl bp mul i 8
    n = or n shl bn mul i 8
  end
  if ne and p n 0
    ret 3
  end
  put dst 0 p
  put dst 1 n
  ret 0
end

export fn oma_om_dense_byte_decode bv ulong dst edit uchar 5 to ulong
  if ge bv 243
    ret 5
  end
  v = bv
  for j ulong 5
    r = rem v 3
    v = div v 3
    if eq r 0
      put dst j uchar 255
    else
      put dst j uchar sub r 1
    end
  end
  ret 0
end

export fn oma_om_pack_dense_byte src view uchar * start ulong n ulong to ulong
  v = ulong 0
  p = ulong 1
  for j ulong 5
    idx = add start j
    d = ulong 1
    if lt idx n
      b = ulong get src idx
      if eq b 255
        d = 0
      else
        if eq b 1
          d = 2
        end
      end
    end
    v = add v mul d p
    p = mul p 3
  end
  ret v
end

export fn oma_om_int_to_bt v_bits ulong dst edit uchar 41 n_out edit ulong 1 to void
  is_neg = ulong 0
  u = v_bits
  if ge v_bits 0x8000000000000000
    is_neg = 1
    u = sub 0 v_bits
  end
  n = ulong 0
  while gt u 0
    r = rem u 3
    u = div u 3
    d = ulong r
    if eq r 2
      d = 255
      u = add u 1
    end
    if eq is_neg 1
      if eq d 1
        d = 255
      else
        if eq d 255
          d = 1
        end
      end
    end
    put dst n uchar d
    n = add n 1
  end
  put n_out 0 n
end

fn oma_add_i64_ok a long b long to ulong
  if gt b 0
    if gt a sub 9223372036854775807 b
      ret 0
    end
  end
  if lt b 0
    minv = sub long -9223372036854775807 1
    if lt a sub minv b
      ret 0
    end
  end
  ret 1
end

export fn oma_om_bt_to_int digits view uchar * n ulong dst edit ulong 1 to ulong
  for i ulong n
    b = ulong get digits i
    if and ne b 0 and ne b 1 ne b 255
      ret 1
    end
  end
  acc = long 0
  i = n
  while gt i 0
    i = sub i 1
    b = ulong get digits i
    d = long 0
    if eq b 1
      d = 1
    else
      if eq b 255
        d = -1
      end
    end
    if eq oma_add_i64_ok acc d 0
      ret 4
    end
    t = add acc d
    if eq oma_add_i64_ok t acc 0
      ret 4
    end
    t = add t acc
    if eq oma_add_i64_ok t acc 0
      ret 4
    end
    acc = add t acc
  end
  put dst 0 bitcast ulong acc
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 phase-domain Z3 digital twin (spec/mixed-algebra-phase-twin.md).
note Concatenated after src/algebra/oma_lib.om.

const PT_OK int 0
const PT_E_ARG int -1

const PT_ADD_CORR_PRODUCT int 1
const PT_ADD_MIXER int 2
const PT_ADD_NCO int 3

const PT_FLAG_ERASURE uint 1
const PT_FLAG_REJECT uint 2
const PT_FLAG_CALFAULT uint 4

const PT_NCO_THIRD uint 1431655765

const PT_PI f64 3.141592653589793
const PT_TWO_PI f64 6.283185307179586
const PT_HALF_PI f64 1.5707963267948966
const PT_LN2 f64 0.6931471805599453
const PT_INV_LN2 f64 1.4426950408889634
const PT_LN10 f64 2.302585092994046

note ---- pure f64 math primitives (no libm) ----

fn pt_floor x f64 to f64
  i = long x
  fi = f64 i
  if lt x fi
    ret sub fi 1.0f64
  end
  ret fi
end

fn pt_ceil x f64 to f64
  i = long x
  fi = f64 i
  if gt x fi
    ret add fi 1.0f64
  end
  ret fi
end

fn pt_wrap_pi x f64 to f64
  k = pt_floor add div x PT_TWO_PI 0.5f64
  ret sub x mul k PT_TWO_PI
end

fn pt_sin_core x f64 to f64
  x2 = mul x x
  t = x
  s = x
  t = div mul t neg x2 6.0f64
  s = add s t
  t = div mul t neg x2 20.0f64
  s = add s t
  t = div mul t neg x2 42.0f64
  s = add s t
  t = div mul t neg x2 72.0f64
  s = add s t
  t = div mul t neg x2 110.0f64
  s = add s t
  t = div mul t neg x2 156.0f64
  s = add s t
  t = div mul t neg x2 210.0f64
  s = add s t
  t = div mul t neg x2 272.0f64
  ret add s t
end

fn pt_cos_core x f64 to f64
  x2 = mul x x
  t = 1.0f64
  s = 1.0f64
  t = div mul t neg x2 2.0f64
  s = add s t
  t = div mul t neg x2 12.0f64
  s = add s t
  t = div mul t neg x2 30.0f64
  s = add s t
  t = div mul t neg x2 56.0f64
  s = add s t
  t = div mul t neg x2 90.0f64
  s = add s t
  t = div mul t neg x2 132.0f64
  s = add s t
  t = div mul t neg x2 182.0f64
  s = add s t
  t = div mul t neg x2 240.0f64
  ret add s t
end

fn pt_sin x f64 to f64
  r = pt_wrap_pi x
  if gt r PT_HALF_PI
    ret pt_sin_core sub PT_PI r
  end
  if lt r neg PT_HALF_PI
    ret pt_sin_core sub neg PT_PI r
  end
  ret pt_sin_core r
end

fn pt_cos x f64 to f64
  r = pt_wrap_pi x
  if gt r PT_HALF_PI
    ret neg pt_cos_core sub PT_PI r
  end
  if lt r neg PT_HALF_PI
    ret neg pt_cos_core sub neg PT_PI r
  end
  ret pt_cos_core r
end

fn pt_atan_poly x f64 to f64
  x2 = mul x x
  t = x
  s = x
  t = mul t neg x2
  s = add s div t 3.0f64
  t = mul t neg x2
  s = add s div t 5.0f64
  t = mul t neg x2
  s = add s div t 7.0f64
  t = mul t neg x2
  s = add s div t 9.0f64
  t = mul t neg x2
  s = add s div t 11.0f64
  t = mul t neg x2
  s = add s div t 13.0f64
  t = mul t neg x2
  ret add s div t 15.0f64
end

fn pt_atan_pos x f64 to f64
  if gt x 1.0f64
    ret sub PT_HALF_PI pt_atan_pos div 1.0f64 x
  end
  if gt x 0.2679491924311227f64
    s3 = 1.7320508075688772f64
    num = sub mul s3 x 1.0f64
    den = add s3 x
    ret add 0.5235987755982988f64 pt_atan_poly div num den
  end
  ret pt_atan_poly x
end

fn pt_atan2 y f64 x f64 to f64
  if gt x 0.0f64
    if ge y 0.0f64
      ret pt_atan_pos div y x
    end
    ret neg pt_atan_pos div neg y x
  end
  if lt x 0.0f64
    if ge y 0.0f64
      ret sub PT_PI pt_atan_pos div y neg x
    end
    ret sub pt_atan_pos div neg y neg x PT_PI
  end
  if gt y 0.0f64
    ret PT_HALF_PI
  end
  if lt y 0.0f64
    ret neg PT_HALF_PI
  end
  ret 0.0f64
end

fn pt_log x f64 to f64
  bits = bitcast ulong x
  exp_i = sub int and shr bits 52 0x7ff 1023
  m_bits = or and bits 0x000fffffffffffff 0x3ff0000000000000
  m = bitcast f64 m_bits
  if gt m 1.4142135623730951f64
    m = mul m 0.5f64
    exp_i = add exp_i 1
  end
  t = div sub m 1.0f64 add m 1.0f64
  t2 = mul t t
  p = t
  s = t
  p = mul p t2
  s = add s div p 3.0f64
  p = mul p t2
  s = add s div p 5.0f64
  p = mul p t2
  s = add s div p 7.0f64
  p = mul p t2
  s = add s div p 9.0f64
  p = mul p t2
  s = add s div p 11.0f64
  p = mul p t2
  s = add s div p 13.0f64
  p = mul p t2
  s = add s div p 15.0f64
  ret add mul 2.0f64 s mul f64 exp_i PT_LN2
end

fn pt_exp x f64 to f64
  if lt x -708.0f64
    ret 0.0f64
  end
  if gt x 709.0f64
    ret 100000000000000.0f64
  end
  kf = pt_floor add mul x PT_INV_LN2 0.5f64
  k = int kf
  r = sub x mul kf PT_LN2
  t = 1.0f64
  s = 1.0f64
  t = mul t r
  s = add s t
  t = div mul t r 2.0f64
  s = add s t
  t = div mul t r 3.0f64
  s = add s t
  t = div mul t r 4.0f64
  s = add s t
  t = div mul t r 5.0f64
  s = add s t
  t = div mul t r 6.0f64
  s = add s t
  t = div mul t r 7.0f64
  s = add s t
  t = div mul t r 8.0f64
  s = add s t
  t = div mul t r 9.0f64
  s = add s t
  t = div mul t r 10.0f64
  s = add s t
  t = div mul t r 11.0f64
  s = add s t
  e_bits = shl ulong add k 1023 52
  ret mul s bitcast f64 e_bits
end

fn pt_pow10 x f64 to f64
  ret pt_exp mul x PT_LN10
end

fn pt_erfc_pos x f64 to f64
  t = div 1.0f64 add 1.0f64 mul 0.3275911f64 x
  p = 1.061405429f64
  p = add mul p t -1.453152027f64
  p = add mul p t 1.421413741f64
  p = add mul p t -0.284496736f64
  p = add mul p t 0.254829592f64
  ret mul mul p t pt_exp neg mul x x
end

fn pt_erfc x f64 to f64
  if ge x 0.0f64
    ret pt_erfc_pos x
  end
  ret sub 2.0f64 pt_erfc_pos neg x
end

fn pt_erf x f64 to f64
  ret sub 1.0f64 pt_erfc x
end

fn pt_deg2rad d f64 to f64
  ret mul d div PT_PI 180.0f64
end

fn pt_rad2deg r f64 to f64
  ret mul r div 180.0f64 PT_PI
end

note ---- xoshiro256** RNG (state: 4 ulongs + has_spare + spare) ----

fn pt_splitmix64 x edit ulong 1 to ulong
  s = add get x 0 0x9e3779b97f4a7c15
  put x 0 s
  z = mul xor s shr s 30 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 0x94d049bb133111eb
  ret xor z shr z 31
end

fn pt_rng_seed st edit ulong 5 sp edit f64 1 seed ulong to void
  x = new ulong 1 0
  put x 0 seed
  for i ulong 4
    put st i pt_splitmix64 x
  end
  put st 4 ulong 0
  put sp 0 0.0f64
end

fn pt_rng_next st edit ulong 5 to ulong
  s0 = get st 0
  s1 = get st 1
  s2 = get st 2
  s3 = get st 3
  res = mul rotl mul s1 5 7 9
  t = shl s1 17
  s2 = xor s2 s0
  s3 = xor s3 s1
  s1 = xor s1 s2
  s0 = xor s0 s3
  s2 = xor s2 t
  s3 = rotl s3 45
  put st 0 s0
  put st 1 s1
  put st 2 s2
  put st 3 s3
  ret res
end

fn pt_rng_uniform st edit ulong 5 to f64
  ret mul f64 shr pt_rng_next st 11 div 1.0f64 9007199254740992.0f64
end

fn pt_rng_gauss st edit ulong 5 sp edit f64 1 to f64
  if ne get st 4 0
    put st 4 ulong 0
    ret get sp 0
  end
  u = 0.0f64
  v = 0.0f64
  s = 2.0f64
  while or ge s 1.0f64 eq s 0.0f64 bound 1000
    u = sub mul 2.0f64 pt_rng_uniform st 1.0f64
    v = sub mul 2.0f64 pt_rng_uniform st 1.0f64
    s = add mul u u mul v v
  end
  m = fsqrt div mul -2.0f64 pt_log s s
  put sp 0 mul v m
  put st 4 ulong 1
  ret mul u m
end

note ---- phase twin global state ----

note pt_ci: [0]=cycle_samples, [1]=n_samples, [2]=dac_bits, [3]=adc_bits,
note        [4]=mode, [5]=cal_en, [6]=cal_int, [7]=cal_reps
global pt_ci int 8
note pt_cf: [0]=fs_hz, [1]=amplitude, [2]=noise_sigma, [3]=jitter_deg,
note        [4]=off0, [5]=off1, [6]=drift0, [7]=drift1,
note        [8]=frame_s, [9]=cal_tol, [10]=erasure_frac, [11]=reject_deg
global pt_cf f64 12

global pt_rng_s ulong 5
global pt_rng_sp f64 1

global pt_buf_a f64 4096
global pt_buf_b f64 4096
global pt_buf_m f64 4096
global pt_cos_tab f64 256
global pt_sin_tab f64 256

note pt_st_u: [0]=frames, [1]=cal_valid, [2]=cal_fault, [3]=ops_since_cal,
note          [4]=want_dbl, [5]=cal_count, [6]=cal_faults
global pt_st_u ulong 8
note pt_st_f: [0]=t_s, [1]=cal_deg0, [2]=cal_deg1, [3]=cal_mag0, [4]=cal_mag1,
note          [5]=cal_mix_deg, [6]=cal_mix_mag, [7]=cal_dbl_deg, [8]=cal_dbl_mag
global pt_st_f f64 10

note pt_res_i: [0]=decoded, [1]=decoded_a, [2]=decoded_b, [3]=flags
global pt_res_i int 4
global pt_res_ph f64 1

fn pt_sigma_for_rho amp f64 n_samp uint rho f64 to f64
  ret mul amp fsqrt div f64 n_samp mul 4.0f64 rho
end

fn pt_quant v f64 bits int to f64
  if le bits 0
    ret v
  end
  half = f64 shl ulong 1 ulong sub bits 1
  code = pt_floor add mul v half 0.5f64
  hi = sub half 1.0f64
  if gt code hi
    code = hi
  end
  if lt code neg half
    code = neg half
  end
  ret div code half
end

fn pt_decode theta f64 dist_out edit f64 1 to int
  third = div PT_TWO_PI 3.0f64
  q = pt_floor add div theta third 0.5f64
  dist = sub theta mul q third
  put dist_out 0 fabs pt_rad2deg dist
  k = rem long q 3
  if lt k 0
    k = add k 3
  end
  ret int k
end

fn pt_twin_init seed ulong to int
  cyc = get pt_ci 0
  ns = get pt_ci 1
  if or lt cyc 8 or le ns 0 ne rem ns cyc 0
    ret PT_E_ARG
  end
  if or gt ns 4096 gt cyc 256
    ret PT_E_ARG
  end
  amp = get pt_cf 1
  if or le amp 0.0f64 or gt amp 1.0f64 lt get pt_cf 2 0.0f64
    ret PT_E_ARG
  end
  db = get pt_ci 2
  ab = get pt_ci 3
  if or lt db 0 or gt db 24 or lt ab 0 gt ab 24
    ret PT_E_ARG
  end
  md = get pt_ci 4
  if and ne md PT_ADD_CORR_PRODUCT and ne md PT_ADD_MIXER ne md PT_ADD_NCO
    ret PT_E_ARG
  end
  if ne get pt_ci 5 0
    if or le get pt_ci 6 0 le get pt_ci 7 0
      ret PT_E_ARG
    end
  end
  st = new ulong 5 0
  sp = new f64 1 0.0f64
  pt_rng_seed st sp seed
  for i ulong 5
    put pt_rng_s i get st i
  end
  put pt_rng_sp 0 get sp 0
  for i ulong ulong cyc bound 256
    w = div mul PT_TWO_PI f64 i f64 cyc
    put pt_cos_tab i pt_cos w
    put pt_sin_tab i pt_sin w
  end
  for i ulong 8
    put pt_st_u i 0
  end
  for i ulong 10
    put pt_st_f i 0.0f64
  end
  ref1 = mul mul amp f64 ns 0.5f64
  ref2 = mul mul mul amp amp f64 ns 0.25f64
  put pt_st_f 3 ref1
  put pt_st_f 4 ref1
  put pt_st_f 6 ref2
  put pt_st_f 8 ref2
  ret PT_OK
end

fn pt_g_gauss to f64
  st = new ulong 5 0
  sp = new f64 1 0.0f64
  for i ulong 5
    put st i get pt_rng_s i
  end
  put sp 0 get pt_rng_sp 0
  g = pt_rng_gauss st sp
  for i ulong 5
    put pt_rng_s i get st i
  end
  put pt_rng_sp 0 get sp 0
  ret g
end

fn pt_emit_loop cp f64 sp f64 dst_id int use_adc int to void
  cyc = ulong get pt_ci 0
  ns = ulong get pt_ci 1
  idx = ulong 0
  for n ulong ns bound 4096
    c1 = mul get pt_cos_tab idx cp
    s1 = mul get pt_sin_tab idx sp
    v = mul get pt_cf 1 sub c1 s1
    v = pt_quant v get pt_ci 2
    if gt get pt_cf 2 0.0f64
      v = add v mul get pt_cf 2 pt_g_gauss
    end
    if ne use_adc 0
      v = pt_quant v get pt_ci 3
    end
    if eq dst_id 0
      put pt_buf_a n v
    else
      put pt_buf_b n v
    end
    idx = add idx 1
    if eq idx cyc
      idx = 0
    end
  end
end

fn pt_emit_buf ch int phase_rad f64 dst_id int use_adc int to void
  off_d = get pt_cf add 4 ulong ch
  dr_d = get pt_cf add 6 ulong ch
  path_deg = add off_d mul dr_d get pt_st_f 0
  if gt get pt_cf 3 0.0f64
    path_deg = add path_deg mul get pt_cf 3 pt_g_gauss
  end
  ph = add phase_rad pt_deg2rad path_deg
  pt_emit_loop pt_cos ph pt_sin ph dst_id use_adc
end

fn pt_end_frame to void
  put pt_st_f 0 add get pt_st_f 0 get pt_cf 8
  put pt_st_u 0 add get pt_st_u 0 1
end

fn pt_correlate src_id int bin ulong dst edit f64 2 to void
  cyc = ulong get pt_ci 0
  ns = ulong get pt_ci 1
  iv = 0.0f64
  qv = 0.0f64
  idx = ulong 0
  for n ulong ns bound 4096
    bv = 0.0f64
    if eq src_id 0
      bv = get pt_buf_a n
    else
      if eq src_id 1
        bv = get pt_buf_b n
      else
        bv = get pt_buf_m n
      end
    end
    iv = add iv mul bv get pt_cos_tab idx
    qv = sub qv mul bv get pt_sin_tab idx
    idx = add idx bin
    if ge idx cyc
      idx = sub idx cyc
    end
  end
  put dst 0 iv
  put dst 1 qv
end

fn pt_k_phase k int to f64
  ret div mul PT_TWO_PI f64 k 3.0f64
end

fn pt_crot z edit f64 2 rad f64 to void
  c = pt_cos rad
  s = pt_sin rad
  re = get z 0
  im = get z 1
  put z 0 sub mul re c mul im s
  put z 1 add mul re s mul im c
end

fn pt_cabs z view f64 2 to f64
  re = get z 0
  im = get z 1
  ret fsqrt add mul re re mul im im
end

fn pt_carg z view f64 2 to f64
  ret pt_atan2 get z 1 get z 0
end

fn pt_mixer_frame pa f64 pb f64 dst edit f64 2 to void
  pt_emit_buf 0 pa 0 0
  pt_emit_buf 1 pb 1 0
  ns = ulong get pt_ci 1
  ab = get pt_ci 3
  for n ulong ns bound 4096
    put pt_buf_m n pt_quant mul get pt_buf_a n get pt_buf_b n ab
  end
  pt_correlate 2 2 dst
  pt_end_frame
end

fn pt_doubler_frame pa f64 dst edit f64 2 to void
  pt_emit_buf 0 pa 0 0
  ns = ulong get pt_ci 1
  ab = get pt_ci 3
  for n ulong ns bound 4096
    a = get pt_buf_a n
    put pt_buf_m n pt_quant mul a a ab
  end
  pt_correlate 2 2 dst
  pt_end_frame
end

fn pt_check_120 meas_rad f64 est_rad f64 tol_deg f64 to bool
  diff = sub meas_rad est_rad
  d = pt_rad2deg pt_atan2 pt_sin diff pt_cos diff
  ret le fabs sub d 120.0f64 tol_deg
end

fn pt_cal_ch_avg ph f64 reps ulong z0 edit f64 2 z1 edit f64 2 to void
  put z0 0 0.0f64
  put z0 1 0.0f64
  put z1 0 0.0f64
  put z1 1 0.0f64
  za = new f64 2 0.0f64
  zb = new f64 2 0.0f64
  for r ulong reps bound 256
    pt_emit_buf 0 ph 0 1
    pt_emit_buf 1 ph 1 1
    pt_correlate 0 1 za
    pt_correlate 1 1 zb
    put z0 0 add get z0 0 get za 0
    put z0 1 add get z0 1 get za 1
    put z1 0 add get z1 0 get zb 0
    put z1 1 add get z1 1 get zb 1
    pt_end_frame
  end
end

fn pt_cal_mix_dbl reps ulong tol f64 to int
  fault = int 0
  m0 = new f64 2 0.0f64
  m1 = new f64 2 0.0f64
  z = new f64 2 0.0f64
  if eq get pt_ci 4 PT_ADD_MIXER
    for r ulong reps bound 256
      pt_mixer_frame 0.0f64 0.0f64 z
      put m0 0 add get m0 0 get z 0
      put m0 1 add get m0 1 get z 1
    end
    for r ulong reps bound 256
      pt_mixer_frame pt_k_phase 1 0.0f64 z
      put m1 0 add get m1 0 get z 0
      put m1 1 add get m1 1 get z 1
    end
    put pt_st_f 5 pt_rad2deg pt_carg m0
    put pt_st_f 6 div pt_cabs m0 f64 reps
    if not pt_check_120 pt_carg m1 pt_carg m0 tol
      fault = 1
    end
  end
  if ne get pt_st_u 4 0
    put m0 0 0.0f64
    put m0 1 0.0f64
    put m1 0 0.0f64
    put m1 1 0.0f64
    for r ulong reps bound 256
      pt_doubler_frame 0.0f64 z
      put m0 0 add get m0 0 get z 0
      put m0 1 add get m0 1 get z 1
    end
    for r ulong reps bound 256
      pt_doubler_frame pt_k_phase 1 z
      put m1 0 add get m1 0 get z 0
      put m1 1 add get m1 1 get z 1
    end
    put pt_st_f 7 pt_rad2deg pt_carg m0
    put pt_st_f 8 div pt_cabs m0 f64 reps
    if not pt_check_120 pt_carg m0 pt_carg m1 tol
      fault = 1
    end
  end
  ret fault
end

fn pt_calibrate to void
  reps = ulong get pt_ci 7
  tol = get pt_cf 9
  z0 = new f64 2 0.0f64
  z1 = new f64 2 0.0f64
  pt_cal_ch_avg 0.0f64 reps z0 z1
  put pt_st_f 1 pt_rad2deg pt_carg z0
  put pt_st_f 2 pt_rad2deg pt_carg z1
  put pt_st_f 3 div pt_cabs z0 f64 reps
  put pt_st_f 4 div pt_cabs z1 f64 reps
  y0 = new f64 2 0.0f64
  y1 = new f64 2 0.0f64
  pt_cal_ch_avg pt_k_phase 1 reps y0 y1
  fault = int 0
  if not pt_check_120 pt_carg y0 pt_deg2rad get pt_st_f 1 tol
    fault = 1
  end
  if eq get pt_ci 4 PT_ADD_CORR_PRODUCT
    if not pt_check_120 pt_carg y1 pt_deg2rad get pt_st_f 2 tol
      fault = 1
    end
  end
  if ne pt_cal_mix_dbl reps tol 0
    fault = 1
  end
  put pt_st_u 1 1
  put pt_st_u 2 ulong fault
  put pt_st_u 5 add get pt_st_u 5 1
  if ne fault 0
    put pt_st_u 6 add get pt_st_u 6 1
  end
  put pt_st_u 3 0
end

fn pt_maybe_cal to void
  if eq get pt_ci 5 0
    ret
  end
  if or eq get pt_st_u 1 0 ge get pt_st_u 3 ulong get pt_ci 6
    pt_calibrate
  end
end

fn pt_finish z view f64 2 ref_mag f64 to void
  dist = new f64 1 0.0f64
  th = pt_carg z
  put pt_res_i 0 pt_decode th dist
  put pt_res_ph 0 pt_rad2deg th
  fl = uint get pt_res_i 3
  ef = get pt_cf 10
  if and gt ef 0.0f64 lt pt_cabs z mul ef ref_mag
    fl = or fl PT_FLAG_ERASURE
  end
  rd = get pt_cf 11
  if and gt rd 0.0f64 gt get dist 0 rd
    fl = or fl PT_FLAG_REJECT
  end
  if and ne get pt_ci 5 0 ne get pt_st_u 2 0
    fl = or fl PT_FLAG_CALFAULT
  end
  put pt_res_i 3 int fl
  put pt_st_u 3 add get pt_st_u 3 1
end

fn pt_add_corr_prod a int b int z edit f64 2 to void
  za = new f64 2 0.0f64
  zb = new f64 2 0.0f64
  dmy = new f64 1 0.0f64
  pt_emit_buf 0 pt_k_phase a 0 1
  pt_emit_buf 1 pt_k_phase b 1 1
  pt_correlate 0 1 za
  pt_correlate 1 1 zb
  pt_crot za neg pt_deg2rad get pt_st_f 1
  pt_crot zb neg pt_deg2rad get pt_st_f 2
  pt_end_frame
  put pt_res_i 1 pt_decode pt_carg za dmy
  put pt_res_i 2 pt_decode pt_carg zb dmy
  ef = get pt_cf 10
  if gt ef 0.0f64
    if lt pt_cabs za mul ef get pt_st_f 3
      put pt_res_i 3 int or uint get pt_res_i 3 PT_FLAG_ERASURE
    end
    if lt pt_cabs zb mul ef get pt_st_f 4
      put pt_res_i 3 int or uint get pt_res_i 3 PT_FLAG_ERASURE
    end
  end
  put z 0 sub mul get za 0 get zb 0 mul get za 1 get zb 1
  put z 1 add mul get za 0 get zb 1 mul get za 1 get zb 0
end

fn pt_twin_add a int b int to int
  if or or lt a 0 gt a 2 or lt b 0 gt b 2
    ret PT_E_ARG
  end
  put pt_res_i 0 0
  put pt_res_i 1 -1
  put pt_res_i 2 -1
  put pt_res_i 3 0
  pt_maybe_cal
  z = new f64 2 0.0f64
  ref_m = 0.0f64
  md = get pt_ci 4
  if eq md PT_ADD_CORR_PRODUCT
    pt_add_corr_prod a b z
  else
    if eq md PT_ADD_MIXER
      pt_mixer_frame pt_k_phase a pt_k_phase b z
      pt_crot z neg pt_deg2rad get pt_st_f 5
      ref_m = get pt_st_f 6
    else
      wd = add mul uint a PT_NCO_THIRD mul uint b PT_NCO_THIRD
      ph = mul PT_TWO_PI div f64 wd 4294967296.0f64
      pt_emit_buf 0 ph 0 1
      pt_correlate 0 1 z
      pt_crot z neg pt_deg2rad get pt_st_f 1
      pt_end_frame
      ref_m = get pt_st_f 3
    end
  end
  pt_finish z ref_m
  ret PT_OK
end

fn pt_twin_mul_const a int b int to int
  if or or lt a 0 gt a 2 or lt b 0 gt b 2
    ret PT_E_ARG
  end
  put pt_res_i 0 0
  put pt_res_i 1 -1
  put pt_res_i 2 -1
  put pt_res_i 3 0
  if eq get pt_st_u 4 0
    put pt_st_u 4 1
    put pt_st_u 1 0
  end
  pt_maybe_cal
  z = new f64 2 0.0f64
  ref_m = 0.0f64
  if eq b 0
    pt_emit_buf 0 0.0f64 0 1
    pt_correlate 0 1 z
    pt_crot z neg pt_deg2rad get pt_st_f 1
    pt_end_frame
    ref_m = get pt_st_f 3
  else
    if eq b 1
      pt_emit_buf 0 pt_k_phase a 0 1
      pt_correlate 0 1 z
      pt_crot z neg pt_deg2rad get pt_st_f 1
      pt_end_frame
      ref_m = get pt_st_f 3
    else
      pt_doubler_frame pt_k_phase a z
      pt_crot z neg pt_deg2rad get pt_st_f 7
      ref_m = get pt_st_f 8
    end
  end
  pt_finish z ref_m
  ret PT_OK
end

note ---- statistics and analytic references ----

fn pt_wilson errs ulong n ulong z f64 dst edit f64 2 to void
  if eq n 0
    put dst 0 0.0f64
    put dst 1 1.0f64
    ret
  end
  nn = f64 n
  p = div f64 errs nn
  z2 = mul z z
  den = add 1.0f64 div z2 nn
  ctr = div add p div z2 mul 2.0f64 nn den
  v1 = add div mul p sub 1.0f64 p nn div z2 mul 4.0f64 mul nn nn
  v1 = div mul z fsqrt v1 den
  put dst 0 sub ctr v1
  put dst 1 add ctr v1
  if or lt get dst 0 0.0f64 eq errs 0
    put dst 0 0.0f64
  end
  if gt get dst 1 1.0f64
    put dst 1 1.0f64
  end
end

fn pt_e1_bound n ulong alpha f64 to f64
  ret div neg pt_log alpha f64 n
end

fn pt_ref_single_craig rho f64 to f64
  m = ulong 20000
  lim = div PT_TWO_PI 3.0f64
  h = div lim f64 m
  s = 0.0f64
  i = ulong 0
  while le i m bound 25000
    th = mul f64 i h
    sn = pt_sin th
    v = 0.0f64
    if ne sn 0.0f64
      v = pt_exp div mul neg rho 0.75f64 mul sn sn
    end
    w = 2.0f64
    if or eq i 0 eq i m
      w = 1.0f64
    else
      if eq and i 1 1
        w = 4.0f64
      end
    end
    s = add s mul w v
    i = add i 1
  end
  ret div div mul s h 3.0f64 PT_PI
end

fn pt_psk_phase_pdf th f64 rho f64 to f64
  c = pt_cos th
  s = pt_sin th
  t1 = div pt_exp neg rho PT_TWO_PI
  t2 = mul mul 0.5f64 fsqrt div rho PT_PI mul c pt_exp mul neg rho mul s s
  ret add t1 mul t2 add 1.0f64 pt_erf mul fsqrt rho c
end

global pt_pdf_p f64 2048
global pt_pdf_c f64 2048

fn pt_ref_conv_row j ulong grid ulong half_m ulong to void
  pj = get pt_pdf_p j
  base = add add j 1 sub grid half_m
  for l ulong grid bound 2048
    mv = rem add base l grid
    put pt_pdf_c mv add get pt_pdf_c mv mul pj get pt_pdf_p l
  end
end

fn pt_ref_add_exact rho f64 grid ulong to f64
  if or lt grid 60 or gt grid 2048 ne rem grid 6 0
    ret -1.0f64
  end
  h = div PT_TWO_PI f64 grid
  tot = 0.0f64
  for j ulong grid bound 2048
    th = add neg PT_PI mul add f64 j 0.5f64 h
    pj = mul pt_psk_phase_pdf th rho h
    put pt_pdf_p j pj
    put pt_pdf_c j 0.0f64
    tot = add tot pj
  end
  for j ulong grid bound 2048
    put pt_pdf_p j div get pt_pdf_p j tot
  end
  half_m = div grid 2
  for j ulong grid bound 2048
    pt_ref_conv_row j grid half_m
  end
  b = div grid 3
  b2 = mul 2 b
  err = 0.0f64
  for m ulong grid bound 2048
    if or lt m b gt m b2
      err = add err get pt_pdf_c m
    else
      if or eq m b eq m b2
        err = add err mul 0.5f64 get pt_pdf_c m
      end
    end
  end
  ret err
end

fn pt_ref_add_jitter s_deg f64 to f64
  x = div 60.0f64 mul fsqrt 2.0f64 s_deg
  ret pt_erfc div x fsqrt 2.0f64
end

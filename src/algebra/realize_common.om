note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/algebra/realize_common.c.
note Shared MA-2 realization registry, validation, 64-byte arena sizing, and exact oracle.
om2

const OMA_RZ_MAX_N ulong 16777215
const OMA_RZ_COUNT ulong 10

const OMA_RZ_OK int 0
const OMA_RZ_E_ARG int -1
const OMA_RZ_E_TRIT int -2
const OMA_RZ_E_NOMEM int -3
const OMA_RZ_E_OVERFLOW int -4

const RZ_R1_PLAIN ulong 0
const RZ_R1_SDOT ulong 1
const RZ_R1_SDOT_IL ulong 2
const RZ_R1_SMMLA ulong 3
const RZ_R2_BITPLANE ulong 4
const RZ_R2B_LUT ulong 5
const RZ_R2C_CRUMB ulong 6
const RZ_R3_SPARSE ulong 7
const RZ_R4_RNS ulong 8
const RZ_R5_DENSE5 ulong 9

const RZ_SP_MAX_N ulong 65536
const RZ_RNS_MAX_N ulong 64512
const RZ_RNS_M int 16515840

const RZ_MEM_CAP ulong 524288
const RZ_SCRATCH_CAP ulong 1048576
const RZ_IDX_CAP ulong 262144
const RZ_OFF_CAP ulong 4096

note Plan fields: [0]=m [1]=n [2]=weight_bytes [3]=footprint_bytes [4]=scratch_bytes [5]=nnz [6]=valid [7]=rid
global rz_plan ulong 8
global rz_oracle_out int 1024
global rz_mem uchar 524288
global rz_scratch uchar 1048576
global rz_idx ushort 262144
global rz_off uint 4096

text rz_id_0 "R1_plain"
text rz_id_1 "R1_sdot"
text rz_id_2 "R1_sdot_il"
text rz_id_3 "R1_smmla"
text rz_id_4 "R2_bitplane"
text rz_id_5 "R2b_lut"
text rz_id_6 "R2c_crumb"
text rz_id_7 "R3_sparse"
text rz_id_8 "R4_rns"
text rz_id_9 "R5_dense5"

text rz_fam_bin "binary"
text rz_fam_bp "bitplane"
text rz_fam_lut "lut"
text rz_fam_cr "crumb2"
text rz_fam_sp "sparse"
text rz_fam_rns "rns"
text rz_fam_d5 "dense5"

text rz_err_ok "ok"
text rz_err_arg "bad argument"
text rz_err_trit "weight outside {-1,0,+1}"
text rz_err_nomem "out of memory"
text rz_err_ovf "size overflow"
text rz_err_unk "unknown error"

fn rz_copy_text src view uchar * dst edit uchar * to long
  sn = len src
  if lt len dst sn
    ret -1
  end
  for i ulong sn bound 64
    put dst i get src i
  end
  ret long sn
end

fn rz_match_text a view uchar * alen ulong b view uchar * to bool
  if ne alen len b
    ret false
  end
  for i ulong alen bound 64
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn oma_rz_count to ulong
  ret OMA_RZ_COUNT
end

fn oma_rz_get idx ulong to long
  if lt idx OMA_RZ_COUNT
    ret long idx
  end
  ret -1
end

fn oma_rz_id rid ulong dst edit uchar * to long
  if eq rid RZ_R1_PLAIN
    ret rz_copy_text rz_id_0 dst
  end
  if eq rid RZ_R1_SDOT
    ret rz_copy_text rz_id_1 dst
  end
  if eq rid RZ_R1_SDOT_IL
    ret rz_copy_text rz_id_2 dst
  end
  if eq rid RZ_R1_SMMLA
    ret rz_copy_text rz_id_3 dst
  end
  if eq rid RZ_R2_BITPLANE
    ret rz_copy_text rz_id_4 dst
  end
  if eq rid RZ_R2B_LUT
    ret rz_copy_text rz_id_5 dst
  end
  if eq rid RZ_R2C_CRUMB
    ret rz_copy_text rz_id_6 dst
  end
  if eq rid RZ_R3_SPARSE
    ret rz_copy_text rz_id_7 dst
  end
  if eq rid RZ_R4_RNS
    ret rz_copy_text rz_id_8 dst
  end
  if eq rid RZ_R5_DENSE5
    ret rz_copy_text rz_id_9 dst
  end
  ret -1
end

fn oma_rz_family rid ulong dst edit uchar * to long
  if le rid RZ_R1_SMMLA
    ret rz_copy_text rz_fam_bin dst
  end
  if eq rid RZ_R2_BITPLANE
    ret rz_copy_text rz_fam_bp dst
  end
  if eq rid RZ_R2B_LUT
    ret rz_copy_text rz_fam_lut dst
  end
  if eq rid RZ_R2C_CRUMB
    ret rz_copy_text rz_fam_cr dst
  end
  if eq rid RZ_R3_SPARSE
    ret rz_copy_text rz_fam_sp dst
  end
  if eq rid RZ_R4_RNS
    ret rz_copy_text rz_fam_rns dst
  end
  if eq rid RZ_R5_DENSE5
    ret rz_copy_text rz_fam_d5 dst
  end
  ret -1
end

fn oma_rz_exact rid ulong to int
  if lt rid OMA_RZ_COUNT
    ret 1
  end
  ret 0
end

fn oma_rz_weak_baseline rid ulong to int
  if eq rid RZ_R1_PLAIN
    ret 1
  end
  ret 0
end

fn oma_rz_max_n rid ulong to ulong
  if eq rid RZ_R3_SPARSE
    ret RZ_SP_MAX_N
  end
  if eq rid RZ_R4_RNS
    ret RZ_RNS_MAX_N
  end
  ret OMA_RZ_MAX_N
end

fn oma_rz_find qid view uchar * qlen ulong to long
  if rz_match_text qid qlen rz_id_0
    ret long RZ_R1_PLAIN
  end
  if rz_match_text qid qlen rz_id_1
    ret long RZ_R1_SDOT
  end
  if rz_match_text qid qlen rz_id_2
    ret long RZ_R1_SDOT_IL
  end
  if rz_match_text qid qlen rz_id_3
    ret long RZ_R1_SMMLA
  end
  if rz_match_text qid qlen rz_id_4
    ret long RZ_R2_BITPLANE
  end
  if rz_match_text qid qlen rz_id_5
    ret long RZ_R2B_LUT
  end
  if rz_match_text qid qlen rz_id_6
    ret long RZ_R2C_CRUMB
  end
  if rz_match_text qid qlen rz_id_7
    ret long RZ_R3_SPARSE
  end
  if rz_match_text qid qlen rz_id_8
    ret long RZ_R4_RNS
  end
  if rz_match_text qid qlen rz_id_9
    ret long RZ_R5_DENSE5
  end
  ret -1
end

fn oma_rz_free to void
  for i ulong 8
    put rz_plan i ulong 0
  end
end

fn oma_rz_strerror rc int dst edit uchar * to long
  if eq rc OMA_RZ_OK
    ret rz_copy_text rz_err_ok dst
  end
  if eq rc OMA_RZ_E_ARG
    ret rz_copy_text rz_err_arg dst
  end
  if eq rc OMA_RZ_E_TRIT
    ret rz_copy_text rz_err_trit dst
  end
  if eq rc OMA_RZ_E_NOMEM
    ret rz_copy_text rz_err_nomem dst
  end
  if eq rc OMA_RZ_E_OVERFLOW
    ret rz_copy_text rz_err_ovf dst
  end
  ret rz_copy_text rz_err_unk dst
end

fn oma_rz_check_shape m ulong n ulong max_n ulong to int
  if or eq m 0 eq n 0
    ret OMA_RZ_E_ARG
  end
  if or gt n max_n gt n OMA_RZ_MAX_N
    ret OMA_RZ_E_ARG
  end
  lim = div div ulong 0xffffffffffffffff n 4
  if gt m lim
    ret OMA_RZ_E_OVERFLOW
  end
  ret OMA_RZ_OK
end

fn oma_rz_validate w view byte * m ulong n ulong to int
  tot = mul m n
  if gt tot len w
    ret OMA_RZ_E_ARG
  end
  for i ulong tot bound 300000
    v = int get w i
    if or lt v -1 gt v 1
      ret OMA_RZ_E_TRIT
    end
  end
  ret OMA_RZ_OK
end

note 64-byte aligned allocation size (returns 0 on overflow, matching oma_rz_alloc rounding).
fn oma_rz_alloc bytes ulong to ulong
  b = bytes
  if eq b 0
    b = ulong 64
  end
  if gt b sub ulong 0xffffffffffffffff 63
    ret ulong 0
  end
  ret mul div add b 63 64 64
end

fn rz_zero_mem nbytes ulong to void
  for i ulong nbytes bound 524288
    put rz_mem i uchar 0
  end
end

fn rz_zero_scratch nbytes ulong to void
  for i ulong nbytes bound 1048576
    put rz_scratch i uchar 0
  end
end

fn rz_oracle_row w view byte * row ulong n ulong x view byte * to int
  acc = long 0
  for j ulong n bound 200000
    wv = long get w add row j
    xv = long get x j
    acc = add acc mul wv xv
  end
  ret int acc
end

fn oma_rz_oracle w view byte * m ulong n ulong x view byte * to int
  rc = oma_rz_check_shape m n OMA_RZ_MAX_N
  if ne rc 0
    ret rc
  end
  if gt mul m n len w
    ret OMA_RZ_E_ARG
  end
  if or gt n len x gt m 1024
    ret OMA_RZ_E_ARG
  end
  for i ulong m bound 1024
    put rz_oracle_out i rz_oracle_row w mul i n n x
  end
  ret OMA_RZ_OK
end

fn oma_rz_pack rid ulong w view byte * m ulong n ulong to int
  oma_rz_free
  if ge rid OMA_RZ_COUNT
    ret OMA_RZ_E_ARG
  end
  if eq rid RZ_R1_PLAIN
    ret rz_pack_rowmajor rid w m n
  end
  if eq rid RZ_R1_SDOT
    ret rz_pack_rowmajor rid w m n
  end
  if eq rid RZ_R1_SDOT_IL
    ret rz_pack_il w m n
  end
  if eq rid RZ_R1_SMMLA
    ret rz_pack_smmla w m n
  end
  if eq rid RZ_R2_BITPLANE
    ret rz_pack_bitplane w m n
  end
  if eq rid RZ_R2B_LUT
    ret rz_pack_lut w m n
  end
  if eq rid RZ_R2C_CRUMB
    ret rz_pack_crumb w m n
  end
  if eq rid RZ_R3_SPARSE
    ret rz_pack_sparse w m n
  end
  if eq rid RZ_R4_RNS
    ret rz_pack_rns w m n
  end
  ret rz_pack_dense5 w m n
end

fn oma_rz_run x view byte * y edit int * to int
  if eq get rz_plan 6 0
    ret OMA_RZ_E_ARG
  end
  m = get rz_plan 0
  n = get rz_plan 1
  if or gt n len x gt m len y
    ret OMA_RZ_E_ARG
  end
  rid = get rz_plan 7
  if eq rid RZ_R1_PLAIN
    ret rz_run_plain x y
  end
  if eq rid RZ_R1_SDOT
    ret rz_run_sdot x y
  end
  if eq rid RZ_R1_SDOT_IL
    ret rz_run_il x y
  end
  if eq rid RZ_R1_SMMLA
    ret rz_run_smmla x y
  end
  if eq rid RZ_R2_BITPLANE
    ret rz_run_bitplane x y
  end
  if eq rid RZ_R2B_LUT
    ret rz_run_lut x y
  end
  if eq rid RZ_R2C_CRUMB
    ret rz_run_crumb x y
  end
  if eq rid RZ_R3_SPARSE
    ret rz_run_sparse x y
  end
  if eq rid RZ_R4_RNS
    ret rz_run_rns x y
  end
  if eq rid RZ_R5_DENSE5
    ret rz_run_dense5 x y
  end
  ret OMA_RZ_E_ARG
end

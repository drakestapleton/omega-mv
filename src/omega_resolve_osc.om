note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_resolve_osc.c (OSC front-end import
note resolver adapter: calls omega_resolve_imports, maps error subject to bad
note import index or 0xffffffff, formats "CODE_NAME: message" into why).
note Composes on seed/ng/sha256.om, om/blake3/b3unit.om, src/omega_blake3.om,
note src/omega_receipt.om, src/omega_resolve.om.
om2

global g_osc_imp_resolved ulong 1
global g_osc_imp_count ulong 1
global g_osc_imp_bad ulong 1
global g_osc_imp_why uchar 256
global g_osc_imp_why_len ulong 1

fn osc_name_eq_subj names view uchar * i ulong li ulong to bool
  if ne li get g_res_err_subj_len 0
    ret false
  end
  bi = mul i 129
  for b ulong li bound 129
    if ne get names add bi b get g_res_err_subj b
      ret false
    end
  end
  ret true
end

fn osc_find_bad_import names view uchar * nlens view ulong * n ulong to void
  for i ulong n bound 64
    if osc_name_eq_subj names i get nlens i
      put g_osc_imp_bad 0 i
    end
  end
end

fn osc_format_why to void
  why = new uchar 256 0
  pos = omega_resolve_code_name get g_res_err_code 0 why 256
  if lt add pos 2 256
    put why pos 58
    put why add pos 1 32
    pos = add pos 2
  end
  ml = get g_res_err_msg_len 0
  for k ulong ml bound 240
    if ge pos 256
      break
    end
    put why pos get g_res_err_msg k
    pos = add pos 1
  end
  for k ulong pos bound 256
    put g_osc_imp_why k get why k
  end
  put g_osc_imp_why_len 0 pos
end

fn omega_osc_import_hook names view uchar * nlens view ulong * n ulong to long
  omega_closure_free
  put g_osc_imp_resolved 0 0
  put g_osc_imp_count 0 n
  put g_osc_imp_bad 0 ulong 0xffffffff
  put g_osc_imp_why_len 0 0
  rc = omega_resolve_imports names nlens n
  if ne rc 0
    osc_find_bad_import names nlens n
    osc_format_why
    ret rc
  end
  put g_osc_imp_resolved 0 1
  ret 0
end

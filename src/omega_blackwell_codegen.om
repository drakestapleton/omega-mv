end

fn bw_cg_regalloc_bounds_check phys view ulong 288 to long
  p0 = get phys 0
  p1 = get phys 1
  p2 = get phys 2
  p3 = get phys 3
  if ne rem p0 2 0
    ret -2
  end
  if ne rem p2 2 0
    ret -3
  end
  if ne rem p3 4 0
    ret -4
  end
  if or eq p1 p0 eq p1 add p0 1
    ret -5
  end
  if or eq p2 p0 eq p2 add p0 1
    ret -6
  end
  for k ulong 4
    pk = add p3 k
    if or eq pk p0 eq pk add p0 1
      ret -7
    end
    if or eq pk p2 eq pk add p2 1
      ret -8
    end
    if eq pk p1
      ret -9
    end
  end
  ret 0
end

fn bw_cg_regalloc_bounds_run ins edit ulong 8192 meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 to long
  ra_out = new ulong 4 0
  row = new ulong 8 0
  omega_bw_ir_init ins meta vinfo phys
  v0 = ulong omega_bw_ir_alloc_vreg64 meta vinfo phys
  v1 = ulong omega_bw_ir_alloc_vreg meta vinfo phys
  v2 = ulong omega_bw_ir_alloc_vreg64 meta vinfo phys
  v3 = ulong omega_bw_ir_alloc_vreg128 meta vinfo phys
  bw_cg_mk_row row 5 v0 0 0 0x380
  ign = omega_bw_ir_append ins meta vinfo row
  bw_cg_mk_row row 2 v1 0 0 10
  ign = omega_bw_ir_append ins meta vinfo row
  bw_cg_mk_row row 5 v2 0 0 0x388
  ign = omega_bw_ir_append ins meta vinfo row
  bw_cg_mk_row row 15 v3 v3 v0 0
  bw_cg_set_cu row BW_CG_NONE 0
  ign = omega_bw_ir_append ins meta vinfo row
  vs = ulong omega_bw_ir_alloc_vreg meta vinfo phys
  bw_cg_mk_row row 14 vs v1 v2 0
  bw_cg_set_cu row v3 0
  ign = omega_bw_ir_append ins meta vinfo row
  if ne omega_bw_regalloc_solve meta vinfo phys ra_out 0
    ret -1
  end
  ret bw_cg_regalloc_bounds_check phys
end

fn bw_cg_regalloc_bounds_ok to long
  ins = new ulong 8192 0
  meta = new ulong 512 0
  vinfo = new long 768 0
  phys = new ulong 288 0
  ret bw_cg_regalloc_bounds_run ins meta vinfo phys
end

fn bw_cg_regalloc_ovf_run ins edit ulong 8192 meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 to long
  ra_out = new ulong 4 0
  row = new ulong 8 0
  omega_bw_ir_init ins meta vinfo phys
  for i ulong 133
    v = omega_bw_ir_alloc_vreg meta vinfo phys
    if ge v 0
      bw_cg_mk_row row 2 ulong v 0 0 uint i
      ign = omega_bw_ir_append ins meta vinfo row
    end
  end
  last_i = sub long get meta 0 1
  nv = get meta 1
  for v ulong nv bound 256
    put vinfo add mul v 3 1 last_i
  end
  if eq omega_bw_regalloc_solve meta vinfo phys ra_out 0
    ret -6
  end
  ret 0
end

fn bw_cg_regalloc_bounds_overflow to long
  ins = new ulong 8192 0
  meta = new ulong 512 0
  vinfo = new long 768 0
  phys = new ulong 288 0
  ret bw_cg_regalloc_ovf_run ins meta vinfo phys
end

fn omega_blackwell_test_regalloc_bounds to long
  rc = bw_cg_regalloc_bounds_ok
  if ne rc 0
    ret rc
  end
  ret bw_cg_regalloc_bounds_overflow
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_blackwell_codegen.c.
note Composes on om/encoder/bw_enc_sm121.om, om/gpu/bw_regalloc.om,
note om/gpu/cg_matmul.om, and seed/ng/sha256.om.
om2

const BW_CG_MAX_INSNS ulong 1024
const BW_CG_MAX_VREGS ulong 256
const BW_CG_MAX_UVREGS ulong 32
const BW_CG_PHYS_GPR_MAX uint 128
const BW_CG_PHYS_GPR_HW_LIMIT uint 246
const BW_CG_RECONV_MAX_BAR ulong 16
const BW_CG_CODE_TOO_SMALL long -2
const BW_CG_NONE ulong 0xffffffffffffffff
const BW_CG_SR_CTAID_X uint 0x25

fn omega_bw_ir_init ins edit ulong 8192 meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 to void
  for i ulong 8192
    put ins i 0
  end
  for i ulong 512
    put meta i 0
  end
  for i ulong 768
    put vinfo i 0
  end
  for i ulong 288
    put phys i BW_CG_NONE
  end
end

fn bw_cg_alloc_vreg_w meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 w ulong to long
  nv = get meta 1
  if ge nv BW_CG_MAX_VREGS
    ret -1
  end
  put meta 1 add nv 1
  put meta add 64 nv w
  base = mul nv 3
  put vinfo base -1
  put vinfo add base 1 -1
  put vinfo add base 2 long w
  put phys nv BW_CG_NONE
  ret long nv
end

fn omega_bw_ir_alloc_vreg meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 to long
  ret bw_cg_alloc_vreg_w meta vinfo phys 1
end

fn omega_bw_ir_alloc_vreg64 meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 to long
  ret bw_cg_alloc_vreg_w meta vinfo phys 2
end

fn omega_bw_ir_alloc_vreg128 meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 to long
  ret bw_cg_alloc_vreg_w meta vinfo phys 4
end

fn bw_cg_alloc_uvreg_w meta edit ulong 512 phys edit ulong 288 w ulong to long
  nu = get meta 2
  if ge nu BW_CG_MAX_UVREGS
    ret -1
  end
  put meta 2 add nu 1
  put meta add 352 nu w
  put phys add 256 nu BW_CG_NONE
  ret long nu
end

fn omega_bw_ir_alloc_uvreg meta edit ulong 512 phys edit ulong 288 to long
  ret bw_cg_alloc_uvreg_w meta phys 1
end

fn omega_bw_ir_alloc_uvreg64 meta edit ulong 512 phys edit ulong 288 to long
  ret bw_cg_alloc_uvreg_w meta phys 2
end

fn bw_cg_touch_vreg vinfo edit long 768 r64 ulong pos long nv ulong to void
  if ge r64 nv
    ret
  end
  base = mul r64 3
  fd = get vinfo base
  lu = get vinfo add base 1
  if lt fd 0
    put vinfo base pos
  end
  if gt pos lu
    put vinfo add base 1 pos
  end
end

fn omega_bw_ir_append ins edit ulong 8192 meta edit ulong 512 vinfo edit long 768 row view ulong 8 to long
  cnt = get meta 0
  if ge cnt BW_CG_MAX_INSNS
    ret -1
  end
  put meta 0 add cnt 1
  off = mul cnt 8
  for k ulong 8
    put ins add off k get row k
  end
  nv = get meta 1
  flags = get row 7
  pos = long cnt
  if eq and flags 1 0
    bw_cg_touch_vreg vinfo get row 1 pos nv
  end
  bw_cg_touch_vreg vinfo get row 2 pos nv
  bw_cg_touch_vreg vinfo get row 3 pos nv
  bw_cg_touch_vreg vinfo get row 4 pos nv
  ret pos
end

fn omega_bw_ir_set_gpr_limit meta edit ulong 512 lim uint to long
  if or le lim BW_CG_PHYS_GPR_MAX gt lim BW_CG_PHYS_GPR_HW_LIMIT
    ret -1
  end
  put meta 4 ulong lim
  ret 0
end

fn bw_cg_copy_ra_res nv ulong nu ulong res view long 290 phys edit ulong 288 ra_out edit ulong 4 to void
  for v ulong nv bound 256
    put phys v ulong get res v
  end
  for u ulong nu bound 32
    put phys add 256 u ulong get res add 256 u
  end
  put ra_out 0 ulong get res 288
  put ra_out 1 ulong get res 289
end

fn omega_bw_regalloc_solve meta view ulong 512 vinfo view long 768 phys edit ulong 288 ra_out edit ulong 4 to long
  nv = get meta 1
  nu = get meta 2
  if or gt nv BW_CG_MAX_VREGS gt nu BW_CG_MAX_UVREGS
    ret -1
  end
  uinfo = new ulong 32 0
  for u ulong nu bound 32
    put uinfo u get meta add 352 u
  end
  cfg = new ulong 4 0
  put cfg 0 nv
  put cfg 1 nu
  put cfg 2 get meta 4
  res = new long 290 0
  if ne bw_regalloc_solve cfg vinfo uinfo res 0
    ret -1
  end
  bw_cg_copy_ra_res nv nu res phys ra_out
  ret 0
end

fn omega_bw_gpr_declared peak uint to uint
  ret mul div add add peak 2 7 8 8
end

fn omega_bw_gpr_declared_ok decl uint peak uint to long
  if ne rem decl 8 0
    ret 0
  end
  if lt decl add peak 2
    ret 0
  end
  ret 1
end

fn omega_bw_program_code_bytes cnt ulong to ulong
  padded = mul div add cnt 7 8 8
  if lt padded 32
    padded = 32
  end
  ret mul padded 16
end

fn bw_cg_rd_le32 buf view uchar 16384 off ulong to uint
  b0 = uint get buf off
  b1 = shl uint get buf add off 1 8
  b2 = shl uint get buf add off 2 16
  b3 = shl uint get buf add off 3 24
  ret or or b0 b1 or b2 b3
end

fn bw_cg_encode_single row view ulong 8 phys view ulong 288 w edit uint 4 to long
  ins = new ulong 8192 0
  for k ulong 8
    put ins k get row k
  end
  code = new uchar 16384 0
  got = bw_enc_sm121 ins phys 1 0 code
  if ne got 16
    for k ulong 4
      put w k 0
    end
    ret -1
  end
  for k ulong 4
    put w k bw_cg_rd_le32 code mul k 4
  end
  ret 0
end

fn omega_blackwell_encode_one row view ulong 8 w edit uint 4 to long
  phys = new ulong 288 0
  for i ulong 256
    put phys i i
  end
  for i ulong 32
    put phys add 256 i i
  end
  ret bw_cg_encode_single row phys w
end

fn omega_bw_encode_program ins view ulong 8192 cnt ulong phys view ulong 288 code edit uchar 16384 max_len ulong out_len edit ulong 1 to long
  req = omega_bw_program_code_bytes cnt
  if lt max_len req
    ret -1
  end
  got = bw_enc_sm121 ins phys cnt 1 code
  if or eq got 0 ne got req
    ret -1
  end
  put out_len 0 req
  ret 0
end

fn bw_cg_hash_code code view uchar 16384 em ulong digest edit uchar 32 to void
  for i ulong em bound 16384
    put sh_dat i get code i
  end
  sh_all em
  for i ulong 32
    put digest i get sh_dig i
  end
end

fn omega_blackwell_kernel_encode_into ins view ulong 8192 phys view ulong 288 ra_out view ulong 4 code edit uchar 16384 kmeta edit ulong 4 digest edit uchar 32 to long
  cnt = get kmeta 0
  code_cap = get kmeta 1
  for i ulong 4
    put kmeta i 0
  end
  for i ulong 32
    put digest i 0
  end
  if lt code_cap omega_bw_program_code_bytes cnt
    ret BW_CG_CODE_TOO_SMALL
  end
  olen = new ulong 1 0
  if ne omega_bw_encode_program ins cnt phys code code_cap olen 0
    ret -1
  end
  em = get olen 0
  put kmeta 0 em
  put kmeta 1 div em 16
  put kmeta 2 get ra_out 0
  put kmeta 3 get ra_out 1
  bw_cg_hash_code code em digest
  ret 0
end

fn bw_cg_check_reg r64 ulong subr ulong lim ulong meta view ulong 512 wbase ulong to long
  if eq r64 BW_CG_NONE
    if eq subr 0
      ret 0
    end
    ret -1
  end
  if ge r64 lim
    ret -1
  end
  w = get meta add wbase r64
  if ge subr w
    ret -1
  end
  ret 0
end

fn bw_cg_check_row ins view ulong 8192 off ulong meta view ulong 512 to long
  op = get ins off
  if gt op 63
    ret -1
  end
  flags = get ins add off 7
  if ne shr flags 48 0
    ret -1
  end
  bar = and shr flags 8 255
  if ge bar BW_CG_RECONV_MAX_BAR
    ret -1
  end
  is_u = and flags 1
  lim = get meta 1
  wbase = ulong 64
  if ne is_u 0
    lim = get meta 2
    wbase = ulong 352
  end
  if ne bw_cg_check_reg get ins add off 1 and shr flags 16 255 lim meta wbase 0
    ret -1
  end
  if ne bw_cg_check_reg get ins add off 2 and shr flags 24 255 lim meta wbase 0
    ret -1
  end
  if ne bw_cg_check_reg get ins add off 3 and shr flags 32 255 lim meta wbase 0
    ret -1
  end
  if ne bw_cg_check_reg get ins add off 4 and shr flags 40 255 lim meta wbase 0
    ret -1
  end
  if ne bw_cg_check_reg get ins add off 5 0 get meta 2 meta 352 0
    ret -1
  end
  ret 0
end

fn bw_cg_unpack_raw ins view ulong 8192 meta view ulong 512 vinfo edit long 768 to long
  if ne get meta 5 0
    ret -1
  end
  n = get meta 0
  nv = get meta 1
  nu = get meta 2
  if or eq n 0 gt n BW_CG_MAX_INSNS
    ret -1
  end
  if or gt nv BW_CG_MAX_VREGS gt nu BW_CG_MAX_UVREGS
    ret -1
  end
  for v ulong nv bound 256
    w = get meta add 64 v
    if and ne w 1 and ne w 2 ne w 4
      ret -1
    end
    base = mul v 3
    put vinfo base -1
    put vinfo add base 1 -1
    put vinfo add base 2 long w
  end
  for u ulong nu bound 32
    w = get meta add 352 u
    if and ne w 1 ne w 2
      ret -1
    end
  end
  for i ulong n bound 1024
    off = mul i 8
    if ne bw_cg_check_row ins off meta 0
      ret -1
    end
    flags = get ins add off 7
    pos = long i
    if eq and flags 1 0
      bw_cg_touch_vreg vinfo get ins add off 1 pos nv
    end
    bw_cg_touch_vreg vinfo get ins add off 2 pos nv
    bw_cg_touch_vreg vinfo get ins add off 3 pos nv
    bw_cg_touch_vreg vinfo get ins add off 4 pos nv
  end
  ret 0
end

fn bw_cg_keep_alive vinfo edit long 768 nv ulong from_i long to_i long last_i long to void
  for v ulong nv bound 256
    base = mul v 3
    fd = get vinfo base
    lu = get vinfo add base 1
    if ge fd from_i
      if lt fd to_i
        if lt lu last_i
          put vinfo add base 1 last_i
        end
      end
    end
  end
end

fn bw_cg_live_until vinfo edit long 768 nv ulong vr ulong last_i long to void
  if ge vr nv
    ret
  end
  base = mul vr 3
  if lt get vinfo add base 1 last_i
    put vinfo add base 1 last_i
  end
end

fn bw_cg_clear_im ins edit ulong 8192 meta edit ulong 512 to void
  for i ulong 8192
    put ins i 0
  end
  for i ulong 512
    put meta i 0
  end
end

fn omega_blackwell_codegen_matmul_i32_prog sp view ulong 12 ins edit ulong 8192 meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 ra_out edit ulong 4 to long
  bw_cg_clear_im ins meta
  if ne cg_matmul_i32 sp ins meta 0
    ret -1
  end
  if ne bw_cg_unpack_raw ins meta vinfo 0
    ret -1
  end
  ret omega_bw_regalloc_solve meta vinfo phys ra_out
end

fn omega_blackwell_codegen_matmul_tensor_prog sp view ulong 12 ins edit ulong 8192 meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 ra_out edit ulong 4 to long
  bw_cg_clear_im ins meta
  if ne cg_matmul_tensor sp ins meta 0
    ret -1
  end
  if ne bw_cg_unpack_raw ins meta vinfo 0
    ret -1
  end
  ret omega_bw_regalloc_solve meta vinfo phys ra_out
end

fn omega_blackwell_codegen_matmul_tensor_loop_prog sp view ulong 12 ins edit ulong 8192 meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 ra_out edit ulong 4 to long
  bw_cg_clear_im ins meta
  if ne cg_matmul_tensor_loop sp ins meta 0
    ret -1
  end
  if ne bw_cg_unpack_raw ins meta vinfo 0
    ret -1
  end
  nv = get meta 1
  l_col = long get meta 480
  l_k = long get meta 481
  l_ke = long get meta 482
  l_ce = long get meta 483
  bw_cg_keep_alive vinfo nv 0 l_col l_ce
  bw_cg_keep_alive vinfo nv l_col l_k l_ke
  bw_cg_keep_alive vinfo nv l_k l_ke l_ke
  bw_cg_live_until vinfo nv get meta 484 l_ce
  ret omega_bw_regalloc_solve meta vinfo phys ra_out
end

fn omega_blackwell_codegen_matmul_frag_prog sp view ulong 12 ins edit ulong 8192 meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 ra_out edit ulong 4 to long
  bw_cg_clear_im ins meta
  if ne cg_matmul_frag sp ins meta 0
    ret -1
  end
  if ne bw_cg_unpack_raw ins meta vinfo 0
    ret -1
  end
  nv = get meta 1
  l_k = long get meta 481
  l_ke = long get meta 482
  l_ce = long get meta 483
  for i ulong 7
    bw_cg_live_until vinfo nv get meta add 484 i l_ce
  end
  for i ulong 3
    bw_cg_live_until vinfo nv get meta add 491 i l_ke
  end
  bw_cg_keep_alive vinfo nv l_k l_ke l_ke
  ret omega_bw_regalloc_solve meta vinfo phys ra_out
end

fn omega_blackwell_codegen_matmul_frag_block_prog sp view ulong 12 ins edit ulong 8192 meta edit ulong 512 vinfo edit long 768 phys edit ulong 288 ra_out edit ulong 4 to long
  bw_cg_clear_im ins meta
  if ne cg_matmul_frag_block sp ins meta 0
    ret -1
  end
  if ne bw_cg_unpack_raw ins meta vinfo 0
    ret -1
  end
  nv = get meta 1
  l_k = long get meta 481
  l_ke = long get meta 482
  l_ce = long get meta 483
  for i ulong 6
    bw_cg_live_until vinfo nv get meta add 484 i l_ce
  end
  ntiles = mul get sp 6 get sp 7
  for t ulong ntiles bound 64
    bw_cg_live_until vinfo nv get meta add 408 t l_ce
  end
  for i ulong 3
    bw_cg_live_until vinfo nv get meta add 490 i l_ke
  end
  bw_cg_keep_alive vinfo nv l_k l_ke l_ke
  ret omega_bw_regalloc_solve meta vinfo phys ra_out
end

fn omega_matmul_frag_block_shape mt uint nt uint out_rc edit uint 2 to void
  res = new ulong 4 1
  if ne cg_matmul_frag_shape ulong mt ulong nt 16 res 0
    put out_rc 0 1
    put out_rc 1 1
    ret
  end
  put out_rc 0 uint get res 0
  put out_rc 1 uint get res 1
end

fn omega_matmul_frag_block_unroll kp uint rt uint ct uint to uint
  ks = div kp 16
  if eq rem ks 2 0
    if le mul 2 add rt ct 8
      ret 2
    end
  end
  ret 1
end

fn omega_matmul_frag_unroll kp uint to uint
  res = new ulong 4 1
  if ne cg_matmul_frag_shape 1 1 ulong kp res 0
    ret 1
  end
  ret uint get res 3
end

fn bw_cg_frag_a_idx rr ulong cc ulong to ulong
  lane = add mul and rr 7 4 shr and cc 7 1
  e = add add mul shr cc 3 4 mul shr rr 3 2 and cc 1
  ret add mul lane 8 e
end

fn bw_cg_f32_to_bf16 u uint to ushort
  if eq and u 0x7f800000 0x7f800000
    q = uint 0
    if ne and u 0x007fffff 0
      q = uint 0x0040
    end
    ret ushort or shr u 16 q
  end
  ret ushort shr add add u 0x7fff and shr u 16 1 16
end

fn bw_cg_pack_a_row a view ushort * p view ulong 4 dst edit ushort * to void
  blk = get p 0
  src = get p 1
  rr = get p 2
  c1 = get p 3
  for cc ulong c1 bound 16
    put dst add blk bw_cg_frag_a_idx rr cc get a add src cc
  end
end

fn bw_cg_pack_a_tile a view ushort * dims view uint 4 tk ulong dst edit ushort * to void
  p = new ulong 4 0
  r1 = sub ulong get dims 0 mul shr tk 32 16
  if gt r1 16
    r1 = 16
  end
  put p 3 sub ulong get dims 1 mul and tk 0xffffffff 16
  if gt get p 3 16
    put p 3 16
  end
  put p 0 mul shr tk 32 div ulong get dims 3 16
  put p 0 mul add get p 0 and tk 0xffffffff 256
  for rr ulong r1 bound 16
    put p 1 add mul shr tk 32 16 rr
    put p 1 mul get p 1 ulong get dims 1
    put p 1 add get p 1 mul and tk 0xffffffff 16
    put p 2 rr
    bw_cg_pack_a_row a p dst
  end
end

fn omega_matmul_frag_pack_a a view ushort * dims view uint 4 dst edit ushort * to void
  m = ulong get dims 0
  k = ulong get dims 1
  tot = mul ulong get dims 2 ulong get dims 3
  for i ulong tot bound 1048576
    put dst i 0
  end
  mt_n = div add m 15 16
  ks_m = div add k 15 16
  for mt ulong mt_n bound 1024
    for ks ulong ks_m bound 1024
      bw_cg_pack_a_tile a dims or shl mt 32 ks dst
    end
  end
end

fn bw_cg_pack_af_row a view uint * p view ulong 4 dst edit ushort * to void
  blk = get p 0
  src = get p 1
  rr = get p 2
  c1 = get p 3
  for cc ulong c1 bound 16
    put dst add blk bw_cg_frag_a_idx rr cc bw_cg_f32_to_bf16 get a add src cc
  end
end

fn bw_cg_pack_af_tile a view uint * dims view uint 4 tk ulong dst edit ushort * to void
  p = new ulong 4 0
  r1 = sub ulong get dims 0 mul shr tk 32 16
  if gt r1 16
    r1 = 16
  end
  put p 3 sub ulong get dims 1 mul and tk 0xffffffff 16
  if gt get p 3 16
    put p 3 16
  end
  put p 0 mul shr tk 32 div ulong get dims 3 16
  put p 0 mul add get p 0 and tk 0xffffffff 256
  for rr ulong r1 bound 16
    put p 1 add mul shr tk 32 16 rr
    put p 1 mul get p 1 ulong get dims 1
    put p 1 add get p 1 mul and tk 0xffffffff 16
    put p 2 rr
    bw_cg_pack_af_row a p dst
  end
end

fn omega_matmul_frag_pack_a_f32 a view uint * dims view uint 4 dst edit ushort * to void
  m = ulong get dims 0
  k = ulong get dims 1
  tot = mul ulong get dims 2 ulong get dims 3
  for i ulong tot bound 1048576
    put dst i 0
  end
  mt_n = div add m 15 16
  ks_m = div add k 15 16
  for mt ulong mt_n bound 1024
    for ks ulong ks_m bound 1024
      bw_cg_pack_af_tile a dims or shl mt 32 ks dst
    end
  end
end

fn bw_cg_zero_row0 dst edit ushort * blk ulong c1 ulong to void
  rem_z = sub 16 c1
  for z ulong rem_z bound 16
    put dst add blk bw_cg_frag_a_idx 0 add c1 z 0
  end
end

fn omega_matmul_frag_pack_a_row0 a view ushort * k uint kp uint dst edit ushort * to void
  p = new ulong 4 0
  ks_n = div ulong kp 16
  for ks ulong ks_n bound 1024
    c0 = mul ks 16
    c1 = ulong 0
    if lt c0 ulong k
      c1 = sub ulong k c0
      if gt c1 16
        c1 = 16
      end
    end
    put p 0 mul ks 256
    put p 1 c0
    put p 2 0
    put p 3 c1
    bw_cg_pack_a_row a p dst
    bw_cg_zero_row0 dst get p 0 c1
  end
end

fn omega_matmul_frag_pack_a_row0_f32 a view uint * k uint kp uint dst edit ushort * to void
  p = new ulong 4 0
  ks_n = div ulong kp 16
  for ks ulong ks_n bound 1024
    c0 = mul ks 16
    c1 = ulong 0
    if lt c0 ulong k
      c1 = sub ulong k c0
      if gt c1 16
        c1 = 16
      end
    end
    put p 0 mul ks 256
    put p 1 c0
    put p 2 0
    put p 3 c1
    bw_cg_pack_af_row a p dst
    bw_cg_zero_row0 dst get p 0 c1
  end
end

fn bw_cg_sentinel_row cd edit uint * dims view uint 5 row_base ulong to ulong
  n = ulong get dims 1
  poison = get dims 3
  set_flag = get dims 4
  nt = div add n 7 8
  cnt = ulong 0
  for tj ulong nt bound 1024
    c = add mul tj 8 7
    if ge c n
      c = sub n 1
    end
    idx = add row_base c
    if ne set_flag 0
      put cd idx poison
      cnt = add cnt 1
    else
      if eq get cd idx poison
        cnt = add cnt 1
      end
    end
  end
  ret cnt
end

fn omega_matmul_result_sentinels cd edit uint * dims view uint 5 to ulong
  m = ulong get dims 0
  n = ulong get dims 1
  if or eq m 0 eq n 0
    ret 0
  end
  cnt = ulong 0
  mt = div add m 15 16
  np = ulong get dims 2
  for ti ulong mt bound 1024
    r = add mul ti 16 15
    if ge r m
      r = sub m 1
    end
    cnt = add cnt bw_cg_sentinel_row cd dims mul r np
  end
  ret cnt
end

fn bw_cg_pack_b_di r ulong t ulong ks_n ulong grp ulong to ulong
  rr = rem r 16
  lane = add mul grp 4 div rem rr 8 2
  di = mul add mul t ks_n div r 16 32
  di = mul add di lane 4
  ret add di add mul div rr 8 2 rem r 2
end

fn bw_cg_pack_b_cell b view ushort * dims view uint 5 rt ulong dst edit ushort * to void
  r = shr rt 32
  t = and rt 0xffffffff
  n = ulong get dims 1
  c0 = mul add ulong get dims 3 t 8
  for grp ulong 8
    col = add c0 grp
    if lt col n
      di = bw_cg_pack_b_di r t div ulong get dims 2 16 grp
      put dst di get b add mul r n col
    end
  end
end

fn bw_cg_pack_b_row b view ushort * dims view uint 5 r ulong dst edit ushort * to void
  nt_span = sub ulong get dims 4 ulong get dims 3
  for t ulong nt_span bound 1024
    bw_cg_pack_b_cell b dims or shl r 32 t dst
  end
end

fn omega_matmul_frag_pack_b b view ushort * dims view uint 5 dst edit ushort * to void
  k = ulong get dims 0
  ks_n = div ulong get dims 2 16
  nt_span = sub ulong get dims 4 ulong get dims 3
  tot = mul mul nt_span ks_n 128
  for i ulong tot bound 1048576
    put dst i 0
  end
  for r ulong k bound 16384
    bw_cg_pack_b_row b dims r dst
  end
end

fn bw_cg_mk_row row edit ulong 8 op ulong d ulong a ulong b ulong imm uint to void
  put row 0 op
  put row 1 d
  put row 2 a
  put row 3 b
  put row 4 0
  put row 5 0
  put row 6 ulong imm
  put row 7 0
end

fn bw_cg_set_cu row edit ulong 8 c ulong u ulong to void
  put row 4 c
  put row 5 u
end

fn bw_cg_chk3 phys view ulong 288 row view ulong 8 e0 uint e1 uint e2 uint to long
  w = new uint 4 0
  if ne bw_cg_encode_single row phys w 0
    ret -1
  end
  if or ne get w 0 e0 or ne get w 1 e1 ne get w 2 e2
    ret -2
  end
  ret 0
end


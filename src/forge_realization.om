note
note src/forge_realization.om -- pure seeded OM-2 port of src/forge_realization.c
note Composes with seed/ng/sha256.om.
note Typed OmegaRealizationRequest initialization, FORGE realization lowering
note envelope, and verified-realization fail-closed submission boundary.

global g_fr_prog_dig uchar 32
global g_fr_opcode_cnt ulong 1
global g_fr_ir uchar 4096
global g_fr_ir_len ulong 1
global g_fr_desc uchar 256
global g_fr_desc_len ulong 1
global g_fr_desc_dig uchar 32
global g_fr_valid ulong 1

global g_fr_res_dig uchar 32
global g_fr_res_desc_dig uchar 32
global g_fr_res_verified ulong 1

global g_fr_ev_dig uchar 32
global g_fr_ldig uchar 32

text fr_tag_desc "FORGE_DESC_V1"
text fr_tag_real "FORGE_REAL_V1"
text fr_tag_sub  "FORGE_SUBMIT_V1"

fn fr_put_u32be off ulong v ulong to ulong
  put sh_dat off uchar and shr v 24 255
  put sh_dat add off 1 uchar and shr v 16 255
  put sh_dat add off 2 uchar and shr v 8 255
  put sh_dat add off 3 uchar and v 255
  ret add off 4
end

fn fr_desc_digest desc view uchar * dlen ulong to long
  if or eq dlen 0 gt dlen 256
    ret neg long 1
  end
  p = ulong 0
  for i ulong len fr_tag_desc bound 32
    put sh_dat p get fr_tag_desc i
    p = add p 1
  end
  p = fr_put_u32be p dlen
  for i ulong dlen bound 256
    put sh_dat p get desc i
    p = add p 1
  end
  sh_all p
  ret 0
end

fn omega_realization_request_init prog_dig view uchar 32 opcode_cnt ulong ir view uchar * desc view uchar * to long
  ir_len = len ir
  desc_len = len desc
  if or gt ir_len 4096 or eq desc_len 0 gt desc_len 256
    put g_fr_valid 0 0
    ret neg long 1
  end
  for i ulong 32
    put g_fr_prog_dig i get prog_dig i
  end
  put g_fr_opcode_cnt 0 opcode_cnt
  for i ulong ir_len bound 4096
    put g_fr_ir i get ir i
  end
  put g_fr_ir_len 0 ir_len
  for i ulong desc_len bound 256
    put g_fr_desc i get desc i
  end
  put g_fr_desc_len 0 desc_len
  rc = fr_desc_digest desc desc_len
  if ne rc 0
    put g_fr_valid 0 0
    ret rc
  end
  for i ulong 32
    put g_fr_desc_dig i get sh_dig i
  end
  put g_fr_valid 0 1
  ret 0
end

fn omega_forge_realize to long
  if eq get g_fr_valid 0 0
    ret neg long 1
  end
  p = ulong 0
  for i ulong len fr_tag_real bound 32
    put sh_dat p get fr_tag_real i
    p = add p 1
  end
  for i ulong 32
    put sh_dat p get g_fr_prog_dig i
    p = add p 1
  end
  p = fr_put_u32be p get g_fr_opcode_cnt 0
  ir_n = get g_fr_ir_len 0
  p = fr_put_u32be p ir_n
  for i ulong ir_n bound 4096
    put sh_dat p get g_fr_ir i
    p = add p 1
  end
  for i ulong 32
    put sh_dat p get g_fr_desc_dig i
    p = add p 1
  end
  sh_all p
  for i ulong 32
    put g_fr_res_dig i get sh_dig i
    put g_fr_res_desc_dig i get g_fr_desc_dig i
  end
  put g_fr_res_verified 0 0
  ret 0
end

fn omega_forge_submit is_verified ulong live_desc view uchar * live_len ulong out_ev edit uchar 32 to long
  if eq is_verified 0
    ret neg long 1
  end
  rc = fr_desc_digest live_desc live_len
  if ne rc 0
    ret neg long 1
  end
  for i ulong 32
    put g_fr_ldig i get sh_dig i
    if ne get sh_dig i get g_fr_res_desc_dig i
      ret neg long 2
    end
  end
  p = ulong 0
  for i ulong len fr_tag_sub bound 32
    put sh_dat p get fr_tag_sub i
    p = add p 1
  end
  for i ulong 32
    put sh_dat p get g_fr_res_dig i
    p = add p 1
  end
  for i ulong 32
    put sh_dat p get g_fr_ldig i
    p = add p 1
  end
  sh_all p
  for i ulong 32
    put g_fr_ev_dig i get sh_dig i
    put out_ev i get sh_dig i
  end
  ret 0
end

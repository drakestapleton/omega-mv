note
note src/crumbline/crumbline.om -- pure seeded OM-2 Crumbline learner library:
note CRB1 visible-crumb reader, CPG1 step-chain codec, SHA-256 digests,
note base operation bank, learner library, and level-by-level synthesis search.
note Replaces src/crumbline/{cl_common,cl_crumb,cl_program,cl_search}.{c,h}.

const CL_CRUMB_MAX_LANES ulong 8
const CL_CRUMB_MAX_EXAMPLES ulong 64
const CL_CRUMB_MAX_FIELD ulong 168
const CL_ENC_DECIMAL ulong 1
const CL_ENC_RAW_LE ulong 2

const CL_CRUMB_OK long 0
const CL_CRUMB_ERR_MAGIC long -1
const CL_CRUMB_ERR_VERSION long -2
const CL_CRUMB_ERR_SHAPE long -3
const CL_CRUMB_ERR_LANE long -4
const CL_CRUMB_ERR_LENGTH long -5
const CL_CRUMB_ERR_NONCANONICAL long -6

const CL_MAX_STEPS ulong 24
const CL_BANK_MAX ulong 96
const CL_PROBE_COUNT ulong 32
const CL_LIB_MAX ulong 64

const CL_OP_ADD ulong 1
const CL_OP_SUB ulong 2
const CL_OP_MUL ulong 3
const CL_OP_AND ulong 4
const CL_OP_OR ulong 5

const CL_OUTCOME_SOLVED ulong 1
const CL_OUTCOME_UNSOLVED ulong 2
const CL_OUTCOME_UNSUPPORTED ulong 3

const CL_VERDICT_NONE ulong 0
const CL_VERDICT_ACCEPT ulong 1
const CL_VERDICT_REJECT ulong 2
const CL_VERDICT_EXHAUSTED ulong 3

const CL_EV_EXPAND ulong 1
const CL_EV_SUBMIT ulong 2
const CL_PRUNE_NONE ulong 0
const CL_PRUNE_EQUIV ulong 1
const CL_PRUNE_COST ulong 2
const CL_PRUNE_FRONTIER_CAP ulong 3
const CL_PRUNE_STEP_CAP ulong 4
const CL_VERIFY_NOT_REACHED ulong 0
const CL_VERIFY_PASS ulong 1
const CL_FIT_NONE ulong 0
const CL_FIT_EXACT ulong 1
const CL_FIT_ROBUST ulong 2

text t_cl_dom_prog "CRUMBLINE-V1-PROGRAM"
text t_cl_dom_beh "CRUMBLINE-V1-BEHAVIOR"

note ---- SHA-256 ----
global g_shk uint 72
global g_shh uint 8
global g_shw uint 64
global g_shv uint 8
global g_shb uchar 64
global g_shm ulong 2

note ---- Probes (32 x u64) ----
global g_probes ulong 32

note ---- Crumb decoded state ----
note g_crb_meta: [0]=enc [1]=in_ar [2]=out_ar [3]=in_lb [4]=out_lb [5]=n [6]=has_b [7..10]=budgets
global g_crb_meta ulong 12
global g_crb_in ulong 512
global g_crb_out ulong 512

note ---- Reader buffer (growable for protocol frames & files) ----
global g_rbuf uchar *
global g_rlen ulong 1
global g_rpos ulong 1
global g_rerr ulong 1

note ---- Bank (96 ops, each <= 24 steps) ----
global g_bnk_cnt ulong 1
global g_bnk_sn ulong 96
global g_bnk_sop ulong 2304
global g_bnk_simm ulong 2304
global g_bnk_dig uchar 3072
global g_bnk_orig ulong 96
global g_bnk_ref ulong 96

note ---- Learner library (64 entries) ----
global g_lib_cnt ulong 1
global g_lib_sn ulong 64
global g_lib_sop ulong 1536
global g_lib_simm ulong 1536
global g_lib_scope ulong 64
global g_lib_ref ulong 64

note ---- Scratch step chains (2 slots: 0=tmp, 1=sol) ----
global g_ts_n ulong 2
global g_ts_op ulong 48
global g_ts_imm ulong 48
global g_dig_tmp uchar 64
global g_pbuf uchar 256

note ---- Search config & result ----
note g_cfg: [0]=max_cand [1]=max_depth [2]=frontier [3]=max_q [4]=amb_scan [5]=rob_pct [6]=max_insns
global g_cfg ulong 8
note g_res: [0]=outcome [1]=sol_node [2]=gen [3]=eval [4]=exp [5]=peq [6]=pcost [7]=pcap
note        [8]=vfits [9]=vfail [10]=oq [11]=orej [12]=c2s [13]=hyp1 [14]=execs [15]=wall
global g_res ulong 16

note ---- Search dynamic arrays ----
global g_nd_id ulong *
global g_nd_par ulong *
global g_nd_op ulong *
global g_nd_nst ulong *
global g_nd_ins ulong *
global g_nd_vals ulong *
global g_ht_h1 ulong *
global g_ht_h2 ulong *
global g_ht_ins ulong *
global g_ht_used uchar *
global g_sr_scr ulong 96
global g_sr_inp ulong 64
global g_pend_nid ulong 64
global g_pend_sn ulong 64
global g_pend_sop ulong 1536
global g_pend_simm ulong 1536
global g_hyps uchar 2048
note g_sr: [0]=n [1]=w [2]=mask [3]=count [4]=cap [5]=tmask [6]=npend [7]=psince [8]=nhyp [9]=stop [10]=solved [11]=fsub [12]=next_id [13]=best_m [14]=best_nd [15]=best_par [16]=best_op [17]=rob_need
global g_sr ulong 18
note g_ev: [0]=kind [1]=prune [2]=verify [3]=fit [4]=op [5]=par [6]=child [7]=cost [8]=oq
global g_ev ulong 9

fn cl_rotr32 x uint n uint to uint
  ret or shr x n shl x sub uint 32 n
end

fn cl_sha_init_tbl to void
  if ne get g_shk 0 0
    ret
  end
  put g_shk 0 1116352408
  put g_shk 1 1899447441
  put g_shk 2 3049323471
  put g_shk 3 3921009573
  put g_shk 4 961987163
  put g_shk 5 1508970993
  put g_shk 6 2453635748
  put g_shk 7 2870763221
  put g_shk 8 3624381080
  put g_shk 9 310598401
  put g_shk 10 607225278
  put g_shk 11 1426881987
  put g_shk 12 1925078388
  put g_shk 13 2162078206
  put g_shk 14 2614888103
  put g_shk 15 3248222580
  put g_shk 16 3835390401
  put g_shk 17 4022224774
  put g_shk 18 264347078
  put g_shk 19 604807628
  put g_shk 20 770255983
  put g_shk 21 1249150122
  put g_shk 22 1555081692
  put g_shk 23 1996064986
  put g_shk 24 2554220882
  put g_shk 25 2821834349
  put g_shk 26 2952996808
  put g_shk 27 3210313671
  put g_shk 28 3336571891
  put g_shk 29 3584528711
  put g_shk 30 113926993
  put g_shk 31 338241895
  put g_shk 32 666307205
  put g_shk 33 773529912
  put g_shk 34 1294757372
  put g_shk 35 1396182291
  put g_shk 36 1695183700
  put g_shk 37 1986661051
  put g_shk 38 2177026350
  put g_shk 39 2456956037
  put g_shk 40 2730485921
  put g_shk 41 2820302411
  put g_shk 42 3259730800
  put g_shk 43 3345764771
  put g_shk 44 3516065817
  put g_shk 45 3600352804
  put g_shk 46 4094571909
  put g_shk 47 275423344
  put g_shk 48 430227734
  put g_shk 49 506948616
  put g_shk 50 659060556
  put g_shk 51 883997877
  put g_shk 52 958139571
  put g_shk 53 1322822218
  put g_shk 54 1537002063
  put g_shk 55 1747873779
  put g_shk 56 1955562222
  put g_shk 57 2024104815
  put g_shk 58 2227730452
  put g_shk 59 2361852424
  put g_shk 60 2428436474
  put g_shk 61 2756734187
  put g_shk 62 3204031479
  put g_shk 63 3329325298
  put g_shk 64 1779033703
  put g_shk 65 3144134277
  put g_shk 66 1013904242
  put g_shk 67 2773480762
  put g_shk 68 1359893119
  put g_shk 69 2600822924
  put g_shk 70 528734635
  put g_shk 71 1541459225
end

fn cl_sha_round i ulong to void
  e = get g_shv 4
  s1 = xor xor cl_rotr32 e 6 cl_rotr32 e 11 cl_rotr32 e 25
  ch = xor and e get g_shv 5 and xor e uint 4294967295 get g_shv 6
  t1 = add add add add get g_shv 7 s1 ch get g_shk i get g_shw i
  a = get g_shv 0
  s0 = xor xor cl_rotr32 a 2 cl_rotr32 a 13 cl_rotr32 a 22
  b = get g_shv 1
  c = get g_shv 2
  maj = xor xor and a b and a c and b c
  t2 = add s0 maj
  put g_shv 7 get g_shv 6
  put g_shv 6 get g_shv 5
  put g_shv 5 e
  put g_shv 4 add get g_shv 3 t1
  put g_shv 3 c
  put g_shv 2 b
  put g_shv 1 a
  put g_shv 0 add t1 t2
end

fn cl_sha_compress to void
  i = ulong 0
  while lt i 16
    o = mul i 4
    b0 = uint get g_shb o
    b1 = uint get g_shb add o 1
    b2 = uint get g_shb add o 2
    b3 = uint get g_shb add o 3
    put g_shw i or or shl b0 24 shl b1 16 or shl b2 8 b3
    i = add i 1
  end
  i = ulong 16
  while lt i 64
    w15 = get g_shw sub i 15
    s0 = xor xor cl_rotr32 w15 7 cl_rotr32 w15 18 shr w15 3
    w2 = get g_shw sub i 2
    s1 = xor xor cl_rotr32 w2 17 cl_rotr32 w2 19 shr w2 10
    v = add add get g_shw sub i 16 s0 get g_shw sub i 7
    put g_shw i add v s1
    i = add i 1
  end
  i = ulong 0
  while lt i 8
    put g_shv i get g_shh i
    i = add i 1
  end
  i = ulong 0
  while lt i 64
    cl_sha_round i
    i = add i 1
  end
  i = ulong 0
  while lt i 8
    put g_shh i add get g_shh i get g_shv i
    i = add i 1
  end
end

fn cl_sha_init to void
  cl_sha_init_tbl
  i = ulong 0
  while lt i 8
    put g_shh i get g_shk add 64 i
    i = add i 1
  end
  put g_shm 0 0
  put g_shm 1 0
end

fn cl_sha_byte b uchar to void
  bl = get g_shm 0
  put g_shb bl b
  bl = add bl 1
  put g_shm 1 add get g_shm 1 1
  if eq bl 64
    cl_sha_compress
    bl = 0
  end
  put g_shm 0 bl
end

fn cl_sha_lit s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    cl_sha_byte get s i
    i = add i 1
  end
end

fn cl_sha_u64 v ulong to void
  i = ulong 0
  while lt i 8
    cl_sha_byte uchar and shr v mul i 8 255
    i = add i 1
  end
end

fn cl_sha_final slot ulong to void
  bl = get g_shm 0
  bits = mul get g_shm 1 8
  put g_shb bl 128
  bl = add bl 1
  if gt bl 56
    while lt bl 64
      put g_shb bl 0
      bl = add bl 1
    end
    cl_sha_compress
    bl = 0
  end
  while lt bl 56
    put g_shb bl 0
    bl = add bl 1
  end
  i = ulong 0
  while lt i 8
    put g_shb add 56 i uchar and shr bits mul sub 7 i 8 255
    i = add i 1
  end
  cl_sha_compress
  base = mul slot 32
  i = ulong 0
  while lt i 8
    v = get g_shh i
    o = add base mul i 4
    put g_dig_tmp o uchar and shr v 24 255
    put g_dig_tmp add o 1 uchar and shr v 16 255
    put g_dig_tmp add o 2 uchar and shr v 8 255
    put g_dig_tmp add o 3 uchar and v 255
    i = add i 1
  end
end

fn cl_init_probes to void
  if ne get g_probes 1 0
    ret
  end
  put g_probes 0 0
  put g_probes 1 1
  put g_probes 2 2
  put g_probes 3 3
  put g_probes 4 5
  put g_probes 5 7
  put g_probes 6 13
  put g_probes 7 42
  put g_probes 8 100
  put g_probes 9 127
  put g_probes 10 128
  put g_probes 11 255
  put g_probes 12 256
  put g_probes 13 1000
  put g_probes 14 4095
  put g_probes 15 65535
  put g_probes 16 65536
  put g_probes 17 1000003
  put g_probes 18 2147483647
  put g_probes 19 2147483648
  put g_probes 20 4294967295
  put g_probes 21 4294967296
  put g_probes 22 or shl ulong 19088743 32 ulong 2309737967
  put g_probes 23 or shl ulong 252645135 32 ulong 252645135
  put g_probes 24 or shl ulong 1431655765 32 ulong 1431655765
  put g_probes 25 or shl ulong 2863311530 32 ulong 2863311530
  put g_probes 26 or shl ulong 2147483647 32 ulong 4294967295
  put g_probes 27 shl ulong 2147483648 32
  put g_probes 28 or shl ulong 4294967295 32 ulong 4294967294
  put g_probes 29 or shl ulong 4294967295 32 ulong 4294967295
  put g_probes 30 or shl ulong 2654435769 32 ulong 2135587861
  put g_probes 31 or shl ulong 3518319154 32 ulong 3516067075
end

note ---- Reader helpers over g_rbuf[0..g_rlen) ----
fn cl_r_init length ulong to void
  put g_rlen 0 length
  put g_rpos 0 0
  put g_rerr 0 0
end

fn cl_r_need n ulong to bool
  if ne get g_rerr 0 0
    ret false
  end
  if gt n sub get g_rlen 0 get g_rpos 0
    put g_rerr 0 1
    ret false
  end
  ret true
end

fn cl_r_u8 to ulong
  if not cl_r_need 1
    ret 0
  end
  p = get g_rpos 0
  put g_rpos 0 add p 1
  ret ulong get g_rbuf p
end

fn cl_r_u16 to ulong
  if not cl_r_need 2
    ret 0
  end
  p = get g_rpos 0
  put g_rpos 0 add p 2
  b0 = ulong get g_rbuf p
  b1 = ulong get g_rbuf add p 1
  ret or b0 shl b1 8
end

fn cl_r_u32 to ulong
  if not cl_r_need 4
    ret 0
  end
  p = get g_rpos 0
  put g_rpos 0 add p 4
  b0 = ulong get g_rbuf p
  b1 = ulong get g_rbuf add p 1
  b2 = ulong get g_rbuf add p 2
  b3 = ulong get g_rbuf add p 3
  ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn cl_r_u64 to ulong
  if not cl_r_need 8
    ret 0
  end
  p = get g_rpos 0
  put g_rpos 0 add p 8
  r = ulong 0
  i = ulong 0
  while lt i 8
    r = or r shl ulong get g_rbuf add p i mul i 8
    i = add i 1
  end
  ret r
end

fn cl_r_done to bool
  if ne get g_rerr 0 0
    ret false
  end
  ret eq get g_rpos 0 get g_rlen 0
end

note ---- CRB1 visible-crumb decoder ----
fn cl_lane_bytes_ok enc ulong b ulong to bool
  if eq enc CL_ENC_DECIMAL
    ret eq b 0
  end
  if or eq b 1 or eq b 2 or eq b 4 eq b 8
    ret true
  end
  ret false
end

fn cl_utf8_cont base ulong extra ulong lo ulong hi ulong to bool
  c1 = ulong get g_rbuf add base 1
  if or lt c1 lo gt c1 hi
    ret false
  end
  k = ulong 2
  while le k extra
    ck = ulong get g_rbuf add base k
    if or lt ck 128 gt ck 191
      ret false
    end
    k = add k 1
  end
  ret true
end

fn cl_utf8_ok off ulong length ulong to bool
  i = ulong 0
  while lt i length
    c = ulong get g_rbuf add off i
    if lt c 128
      i = add i 1
      continue
    end
    extra = ulong 0
    lo = ulong 128
    hi = ulong 191
    if and ge c 194 le c 223
      extra = 1
    else
      if and ge c 224 le c 239
        extra = 2
        if eq c 224
          lo = 160
        end
        if eq c 237
          hi = 159
        end
      else
        if and ge c 240 le c 244
          extra = 3
          if eq c 240
            lo = 144
          end
          if eq c 244
            hi = 143
          end
        else
          ret false
        end
      end
    end
    if gt extra sub sub length i 1
      ret false
    end
    if not cl_utf8_cont add off i extra lo hi
      ret false
    end
    i = add add i extra 1
  end
  ret true
end

fn cl_parse_one_dec off ulong st ulong pos ulong slot ulong is_out bool to long
  digs = sub pos st
  if eq digs 0
    ret CL_CRUMB_ERR_NONCANONICAL
  end
  if and gt digs 1 eq get g_rbuf add off st 48
    ret CL_CRUMB_ERR_NONCANONICAL
  end
  k = st
  while lt k pos
    ch = get g_rbuf add off k
    if or lt ch 48 gt ch 57
      ret CL_CRUMB_ERR_NONCANONICAL
    end
    k = add k 1
  end
  umax = or shl ulong 4294967295 32 ulong 4294967295
  v = ulong 0
  k = st
  while lt k pos
    d = ulong sub get g_rbuf add off k 48
    if gt v div sub umax d 10
      ret CL_CRUMB_ERR_LANE
    end
    v = add mul v 10 d
    k = add k 1
  end
  if is_out
    put g_crb_out slot v
  else
    put g_crb_in slot v
  end
  ret CL_CRUMB_OK
end

fn cl_parse_dec_lanes arity ulong off ulong length ulong is_out bool ex ulong to long
  if not cl_utf8_ok off length
    ret CL_CRUMB_ERR_LANE
  end
  parts = ulong 1
  i = ulong 0
  while lt i length
    if eq get g_rbuf add off i 32
      parts = add parts 1
    end
    i = add i 1
  end
  if ne parts arity
    ret CL_CRUMB_ERR_LANE
  end
  pos = ulong 0
  l = ulong 0
  while lt l arity
    st = pos
    while lt pos length
      if eq get g_rbuf add off pos 32
        break
      end
      pos = add pos 1
    end
    rc = cl_parse_one_dec off st pos add mul ex 8 l is_out
    if ne rc 0
      ret rc
    end
    pos = add pos 1
    l = add l 1
  end
  ret CL_CRUMB_OK
end

fn cl_rd_raw_le base ulong lb ulong to ulong
  v = ulong 0
  k = ulong 0
  while lt k lb
    b = ulong get g_rbuf add base k
    v = or v shl b mul k 8
    k = add k 1
  end
  ret v
end

fn cl_parse_raw_lanes off ulong length ulong is_out bool ex ulong to long
  lb = get g_crb_meta 3
  arity = get g_crb_meta 1
  if is_out
    lb = get g_crb_meta 4
    arity = get g_crb_meta 2
  end
  if ne length mul lb arity
    ret CL_CRUMB_ERR_LANE
  end
  l = ulong 0
  while lt l arity
    v = cl_rd_raw_le add off mul l lb lb
    slot = add mul ex 8 l
    if is_out
      put g_crb_out slot v
    else
      put g_crb_in slot v
    end
    l = add l 1
  end
  ret CL_CRUMB_OK
end

fn cl_crumb_decode_hdr to long
  if not cl_r_need 4
    ret CL_CRUMB_ERR_LENGTH
  end
  p = get g_rpos 0
  put g_rpos 0 add p 4
  if or ne get g_rbuf p 67 ne get g_rbuf add p 1 82
    ret CL_CRUMB_ERR_MAGIC
  end
  if or ne get g_rbuf add p 2 66 ne get g_rbuf add p 3 49
    ret CL_CRUMB_ERR_MAGIC
  end
  sch = cl_r_u16
  if ne get g_rerr 0 0
    ret CL_CRUMB_ERR_LENGTH
  end
  if ne sch 1
    ret CL_CRUMB_ERR_VERSION
  end
  enc = cl_r_u8
  if ne get g_rerr 0 0
    ret CL_CRUMB_ERR_LENGTH
  end
  if and ne enc CL_ENC_DECIMAL ne enc CL_ENC_RAW_LE
    ret CL_CRUMB_ERR_SHAPE
  end
  put g_crb_meta 0 enc
  flags = cl_r_u8
  if ne get g_rerr 0 0
    ret CL_CRUMB_ERR_LENGTH
  end
  if ne and flags xor ulong 1 or shl ulong 4294967295 32 ulong 4294967295 0
    ret CL_CRUMB_ERR_NONCANONICAL
  end
  put g_crb_meta 6 and flags 1
  ia = cl_r_u8
  oa = cl_r_u8
  ilb = cl_r_u8
  olb = cl_r_u8
  if ne get g_rerr 0 0
    ret CL_CRUMB_ERR_LENGTH
  end
  if or lt ia 1 or gt ia 8 or lt oa 1 gt oa 8
    ret CL_CRUMB_ERR_SHAPE
  end
  if or not cl_lane_bytes_ok enc ilb not cl_lane_bytes_ok enc olb
    ret CL_CRUMB_ERR_SHAPE
  end
  put g_crb_meta 1 ia
  put g_crb_meta 2 oa
  put g_crb_meta 3 ilb
  put g_crb_meta 4 olb
  n = cl_r_u32
  if or ne get g_rerr 0 0 or eq n 0 gt n CL_CRUMB_MAX_EXAMPLES
    ret CL_CRUMB_ERR_LENGTH
  end
  put g_crb_meta 5 n
  ret CL_CRUMB_OK
end

fn cl_crumb_dec_one ex ulong enc ulong to long
  in_n = cl_r_u32
  if ne get g_rerr 0 0
    ret CL_CRUMB_ERR_LENGTH
  end
  if or gt in_n CL_CRUMB_MAX_FIELD gt in_n sub get g_rlen 0 get g_rpos 0
    ret CL_CRUMB_ERR_LENGTH
  end
  ioff = get g_rpos 0
  put g_rpos 0 add ioff in_n
  out_n = cl_r_u32
  if ne get g_rerr 0 0
    ret CL_CRUMB_ERR_LENGTH
  end
  if or gt out_n CL_CRUMB_MAX_FIELD gt out_n sub get g_rlen 0 get g_rpos 0
    ret CL_CRUMB_ERR_LENGTH
  end
  ooff = get g_rpos 0
  put g_rpos 0 add ooff out_n
  rc = CL_CRUMB_OK
  if eq enc CL_ENC_RAW_LE
    rc = cl_parse_raw_lanes ioff in_n false ex
    if eq rc 0
      rc = cl_parse_raw_lanes ooff out_n true ex
    end
  else
    rc = cl_parse_dec_lanes get g_crb_meta 1 ioff in_n false ex
    if eq rc 0
      rc = cl_parse_dec_lanes get g_crb_meta 2 ooff out_n true ex
    end
  end
  ret rc
end

fn cl_crumb_decode length ulong to long
  i = ulong 0
  while lt i 12
    put g_crb_meta i 0
    i = add i 1
  end
  cl_r_init length
  rc = cl_crumb_decode_hdr
  if ne rc 0
    ret rc
  end
  enc = get g_crb_meta 0
  n = get g_crb_meta 5
  i = ulong 0
  while lt i n
    rc = cl_crumb_dec_one i enc
    if ne rc 0
      ret rc
    end
    i = add i 1
  end
  if ne get g_crb_meta 6 0
    put g_crb_meta 7 cl_r_u32
    put g_crb_meta 8 cl_r_u32
    put g_crb_meta 9 cl_r_u32
    put g_crb_meta 10 cl_r_u32
  end
  if not cl_r_done
    ret CL_CRUMB_ERR_LENGTH
  end
  ret CL_CRUMB_OK
end

fn cl_crumb_out_mask to ulong
  if ne get g_crb_meta 0 CL_ENC_RAW_LE
    ret or shl ulong 4294967295 32 ulong 4294967295
  end
  nb = get g_crb_meta 4
  if ge nb 8
    ret or shl ulong 4294967295 32 ulong 4294967295
  end
  ret sub shl ulong 1 mul nb 8 1
end

fn cl_crumb_input_bits to ulong
  m = ulong 0
  n = get g_crb_meta 5
  i = ulong 0
  while lt i n
    v = get g_crb_in mul i 8
    if gt v m
      m = v
    end
    i = add i 1
  end
  b = ulong 0
  while gt m 0
    b = add b 1
    m = shr m 1
  end
  ret b
end

note ---- Step evaluation, CPG1 codec, bank, library ----
fn cl_eval_op op ulong imm ulong x ulong to ulong
  if eq op CL_OP_ADD
    ret add x imm
  end
  if eq op CL_OP_SUB
    ret sub x imm
  end
  if eq op CL_OP_MUL
    ret mul x imm
  end
  if eq op CL_OP_AND
    ret and x imm
  end
  if eq op CL_OP_OR
    ret or x imm
  end
  ret 0
end

fn cl_eval_bank_op oi ulong x ulong to ulong
  n = get g_bnk_sn oi
  base = mul oi 24
  i = ulong 0
  while lt i n
    x = cl_eval_op get g_bnk_sop add base i get g_bnk_simm add base i x
    i = add i 1
  end
  ret x
end

fn cl_eval_ts slot ulong x ulong to ulong
  n = get g_ts_n slot
  base = mul slot 24
  i = ulong 0
  while lt i n
    x = cl_eval_op get g_ts_op add base i get g_ts_imm add base i x
    i = add i 1
  end
  ret x
end

fn cl_bnk_op_insns oi ulong to ulong
  n = get g_bnk_sn oi
  base = mul oi 24
  ins = ulong 0
  i = ulong 0
  while lt i n
    ins = add ins 2
    if ne shr get g_bnk_simm add base i 16 0
      ins = add ins 1
    end
    i = add i 1
  end
  ret ins
end

fn cl_ts_digest slot ulong dslot ulong to void
  cl_sha_init
  cl_sha_lit t_cl_dom_prog
  cl_sha_byte 0
  n = get g_ts_n slot
  cl_sha_byte uchar n
  base = mul slot 24
  i = ulong 0
  while lt i n
    cl_sha_byte uchar get g_ts_op add base i
    cl_sha_u64 get g_ts_imm add base i
    i = add i 1
  end
  cl_sha_final dslot
end

fn cl_ts_behavior slot ulong dslot ulong to void
  cl_init_probes
  cl_sha_init
  cl_sha_lit t_cl_dom_beh
  cl_sha_byte 0
  i = ulong 0
  while lt i 32
    cl_sha_u64 cl_eval_ts slot get g_probes i
    i = add i 1
  end
  cl_sha_final dslot
end

fn cl_bank_add_ts slot ulong orig ulong oref ulong to void
  cnt = get g_bnk_cnt 0
  n = get g_ts_n slot
  if or ge cnt CL_BANK_MAX eq n 0
    ret
  end
  cl_ts_digest slot 0
  i = ulong 0
  while lt i cnt
    bo = mul i 32
    same = true
    j = ulong 0
    while lt j 32
      if ne get g_bnk_dig add bo j get g_dig_tmp j
        same = false
        break
      end
      j = add j 1
    end
    if same
      ret
    end
    i = add i 1
  end
  put g_bnk_sn cnt n
  put g_bnk_orig cnt orig
  put g_bnk_ref cnt oref
  dst = mul cnt 24
  src = mul slot 24
  i = ulong 0
  while lt i n
    put g_bnk_sop add dst i get g_ts_op add src i
    put g_bnk_simm add dst i get g_ts_imm add src i
    i = add i 1
  end
  bo = mul cnt 32
  i = ulong 0
  while lt i 32
    put g_bnk_dig add bo i get g_dig_tmp i
    i = add i 1
  end
  put g_bnk_cnt 0 add cnt 1
end

fn cl_bank_add1 op ulong imm ulong to void
  put g_ts_n 0 1
  put g_ts_op 0 op
  put g_ts_imm 0 imm
  cl_bank_add_ts 0 0 0
end

fn cl_bank_init_base to void
  put g_bnk_cnt 0 0
  cl_bank_add1 CL_OP_ADD 1
  cl_bank_add1 CL_OP_ADD 2
  cl_bank_add1 CL_OP_ADD 3
  cl_bank_add1 CL_OP_ADD 5
  cl_bank_add1 CL_OP_SUB 1
  cl_bank_add1 CL_OP_SUB 2
  cl_bank_add1 CL_OP_SUB 3
  cl_bank_add1 CL_OP_SUB 5
  cl_bank_add1 CL_OP_MUL 2
  cl_bank_add1 CL_OP_MUL 3
  cl_bank_add1 CL_OP_MUL 4
  cl_bank_add1 CL_OP_AND 255
  cl_bank_add1 CL_OP_AND 15
  cl_bank_add1 CL_OP_OR 1
  cl_bank_add1 CL_OP_OR 2
end

fn cl_lib_admit_ts slot ulong scope ulong oref ulong to void
  cnt = get g_lib_cnt 0
  n = get g_ts_n slot
  if or ge cnt CL_LIB_MAX eq n 0
    ret
  end
  put g_lib_sn cnt n
  put g_lib_scope cnt scope
  put g_lib_ref cnt oref
  dst = mul cnt 24
  src = mul slot 24
  i = ulong 0
  while lt i n
    put g_lib_sop add dst i get g_ts_op add src i
    put g_lib_simm add dst i get g_ts_imm add src i
    i = add i 1
  end
  put g_lib_cnt 0 add cnt 1
end

fn cl_lib_export in_bits ulong to void
  cnt = get g_lib_cnt 0
  i = ulong 0
  while lt i cnt
    if ge get g_lib_scope i in_bits
      n = get g_lib_sn i
      put g_ts_n 0 n
      src = mul i 24
      j = ulong 0
      while lt j n
        put g_ts_op j get g_lib_sop add src j
        put g_ts_imm j get g_lib_simm add src j
        j = add j 1
      end
      cl_bank_add_ts 0 1 get g_lib_ref i
    end
    i = add i 1
  end
end

fn cl_decode_cpg1_to_ts slot ulong to long
  if not cl_r_need 4
    ret neg long 1
  end
  p = get g_rpos 0
  put g_rpos 0 add p 4
  if or ne get g_rbuf p 67 ne get g_rbuf add p 1 80
    ret neg long 1
  end
  if or ne get g_rbuf add p 2 71 ne get g_rbuf add p 3 49
    ret neg long 1
  end
  if ne cl_r_u16 1
    ret neg long 1
  end
  n = cl_r_u8
  if or ne get g_rerr 0 0 gt n CL_MAX_STEPS
    ret neg long 1
  end
  put g_ts_n slot n
  base = mul slot 24
  i = ulong 0
  while lt i n
    op = cl_r_u8
    im = cl_r_u64
    if or lt op 1 gt op 5
      ret neg long 1
    end
    put g_ts_op add base i op
    put g_ts_imm add base i im
    i = add i 1
  end
  if ne get g_rerr 0 0
    ret neg long 1
  end
  ret 0
end

note ---- Search helpers (hash table + step reconstruction) ----
fn cl_hash_vals w ulong to void
  a = or shl ulong 2654435769 32 ulong 2135587861
  b = or shl ulong 3266489917 32 ulong 668265263
  m1 = or shl ulong 256 32 ulong 435
  m2 = or shl ulong 4283543511 32 ulong 3981806797
  i = ulong 0
  while lt i w
    v = get g_sr_scr i
    a = mul xor a v m1
    a = xor a shr a 29
    b = mul add b v m2
    b = xor b shr b 33
    i = add i 1
  end
  put g_sr_scr 94 a
  put g_sr_scr 95 b
end

fn cl_equiv_seen insns ulong to bool
  h1 = get g_sr_scr 94
  h2 = get g_sr_scr 95
  tm = get g_sr 5
  i = and h1 tm
  while true
    if eq get g_ht_used i 0
      put g_ht_used i 1
      put g_ht_h1 i h1
      put g_ht_h2 i h2
      put g_ht_ins i insns
      ret false
    end
    if and eq get g_ht_h1 i h1 eq get g_ht_h2 i h2
      if le get g_ht_ins i insns
        ret true
      end
      put g_ht_ins i insns
      ret false
    end
    i = and add i 1 tm
  end
  ret false
end

global g_bs_ops ulong 64

fn cl_append_bank_to_ts o ulong slot ulong to long
  on = get g_bnk_sn o
  tn = get g_ts_n slot
  if gt add tn on CL_MAX_STEPS
    ret neg long 1
  end
  base = mul slot 24
  ob = mul o 24
  j = ulong 0
  while lt j on
    put g_ts_op add base add tn j get g_bnk_sop add ob j
    put g_ts_imm add base add tn j get g_bnk_simm add ob j
    j = add j 1
  end
  put g_ts_n slot add tn on
  ret 0
end

fn cl_build_steps pi ulong oi ulong slot ulong to long
  k = ulong 0
  cur = pi
  umax32 = ulong 4294967295
  while ne cur umax32
    par = get g_nd_par cur
    if eq par umax32
      break
    end
    if ge k 63
      ret neg long 1
    end
    put g_bs_ops k get g_nd_op cur
    k = add k 1
    cur = par
  end
  put g_ts_n slot 0
  while gt k 0
    k = sub k 1
    if ne cl_append_bank_to_ts get g_bs_ops k slot 0
      ret neg long 1
    end
  end
  ret cl_append_bank_to_ts oi slot
end

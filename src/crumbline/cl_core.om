note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 helpers backing src/crumbline/cl_common.c:
note little-endian encode/decode, lowercase hex encoding, and byte substring search.
om2

fn cl_hex_nib v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

export fn cl_om_put_le val ulong nbytes ulong out_buf out uchar 8 to void
  for i ulong 8
    put out_buf i 0
  end
  n = nbytes
  if gt n 8
    n = 8
  end
  for i ulong n
    put out_buf i uchar and shr val mul i 8 255
  end
end

export fn cl_om_get_le in_buf view uchar 8 nbytes ulong to ulong
  n = nbytes
  if gt n 8
    n = 8
  end
  v = ulong 0
  for i ulong n
    v = or v shl ulong get in_buf i mul i 8
  end
  ret v
end

export fn cl_om_hex src view uchar * out_hex edit uchar * to void
requires eq len out_hex mul len src 2
  for i ulong len src
    b = ulong get src i
    put out_hex mul i 2 cl_hex_nib shr b 4
    put out_hex add mul i 2 1 cl_hex_nib and b 15
  end
end

export fn cl_om_contains hay view uchar * needle view uchar * to ulong
  hl = len hay
  nl = len needle
  if or eq nl 0 gt nl hl
    ret 0
  end
  limit = add sub hl nl 1
  for i ulong limit
    matched = ulong 1
    for j ulong nl
      if ne get hay add i j get needle j
        matched = 0
        break
      end
    end
    if eq matched 1
      ret 1
    end
  end
  ret 0
end

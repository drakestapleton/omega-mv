note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_fp8_slot_table.c (host-only Expert Ribbon slot state machine).
om2

const FP8_SLOT_OK long 0
const FP8_SLOT_BAD_ARGS long -1
const FP8_SLOT_BUSY long -6
const FP8_SLOT_STALE long -7

const FP8_SLOT_EMPTY ulong 0
const FP8_SLOT_LOADING ulong 1
const FP8_SLOT_READY ulong 2

const FP8_SLOT_MAX ulong 1024

global g_fp8_slots ulong 1
global g_fp8_next_ver ulong 1
global g_fp8_mutant ulong 1

global g_fp8_state ulong 1024
global g_fp8_pins ulong 1024
global g_fp8_key ulong 1024
global g_fp8_ver ulong 1024

note stats: 0=loads, 1=load_failures, 2=busy_refusals, 3=stale_refusals,
note        4=evictions, 5=pins, 6=pinned_now, 7=pinned_high
global g_fp8_stats ulong 8

fn omega_fp8_slot_table_init slots ulong to long
  if or eq slots 0 gt slots FP8_SLOT_MAX
    ret FP8_SLOT_BAD_ARGS
  end
  put g_fp8_slots 0 slots
  put g_fp8_next_ver 0 1
  put g_fp8_mutant 0 0
  for i ulong slots bound 1024
    put g_fp8_state i FP8_SLOT_EMPTY
    put g_fp8_pins i 0
    put g_fp8_key i 0
    put g_fp8_ver i 0
  end
  for i ulong 8
    put g_fp8_stats i 0
  end
  ret FP8_SLOT_OK
end

fn omega_fp8_slot_table_fini to void
  put g_fp8_slots 0 0
  put g_fp8_next_ver 0 0
  put g_fp8_mutant 0 0
end

fn omega_fp8_slot_begin_load slot ulong to long
  slots = get g_fp8_slots 0
  if or eq slots 0 ge slot slots
    ret FP8_SLOT_BAD_ARGS
  end
  st = get g_fp8_state slot
  pn = get g_fp8_pins slot
  mut = get g_fp8_mutant 0
  if eq st FP8_SLOT_LOADING
    put g_fp8_stats 2 add get g_fp8_stats 2 1
    ret FP8_SLOT_BUSY
  end
  if and ne pn 0 eq mut 0
    put g_fp8_stats 2 add get g_fp8_stats 2 1
    ret FP8_SLOT_BUSY
  end
  put g_fp8_state slot FP8_SLOT_LOADING
  ret FP8_SLOT_OK
end

fn omega_fp8_slot_finish_load slot ulong key ulong ok ulong ver_out edit ulong * to long
  if gt len ver_out 0
    put ver_out 0 0
  end
  slots = get g_fp8_slots 0
  if or eq slots 0 ge slot slots
    ret FP8_SLOT_BAD_ARGS
  end
  if ne get g_fp8_state slot FP8_SLOT_LOADING
    ret FP8_SLOT_BAD_ARGS
  end
  if ne ok 0
    ver = get g_fp8_next_ver 0
    put g_fp8_next_ver 0 add ver 1
    put g_fp8_state slot FP8_SLOT_READY
    put g_fp8_key slot key
    put g_fp8_ver slot ver
    if gt len ver_out 0
      put ver_out 0 ver
    end
    put g_fp8_stats 0 add get g_fp8_stats 0 1
  else
    put g_fp8_state slot FP8_SLOT_EMPTY
    put g_fp8_key slot 0
    put g_fp8_stats 1 add get g_fp8_stats 1 1
  end
  ret FP8_SLOT_OK
end

fn omega_fp8_slot_pin slot ulong version ulong to long
  slots = get g_fp8_slots 0
  if or eq slots 0 ge slot slots
    ret FP8_SLOT_BAD_ARGS
  end
  st = get g_fp8_state slot
  cur_v = get g_fp8_ver slot
  if or ne st FP8_SLOT_READY or ne cur_v version eq version 0
    put g_fp8_stats 3 add get g_fp8_stats 3 1
    ret FP8_SLOT_STALE
  end
  put g_fp8_pins slot add get g_fp8_pins slot 1
  put g_fp8_stats 5 add get g_fp8_stats 5 1
  now = add get g_fp8_stats 6 1
  put g_fp8_stats 6 now
  if gt now get g_fp8_stats 7
    put g_fp8_stats 7 now
  end
  ret FP8_SLOT_OK
end

fn omega_fp8_slot_unpin slot ulong version ulong to long
  slots = get g_fp8_slots 0
  if or eq slots 0 ge slot slots
    ret FP8_SLOT_BAD_ARGS
  end
  pn = get g_fp8_pins slot
  if eq pn 0
    ret FP8_SLOT_BAD_ARGS
  end
  mut = get g_fp8_mutant 0
  if and eq mut 0 ne get g_fp8_ver slot version
    ret FP8_SLOT_BAD_ARGS
  end
  put g_fp8_pins slot sub pn 1
  put g_fp8_stats 6 sub get g_fp8_stats 6 1
  ret FP8_SLOT_OK
end

fn omega_fp8_slot_evict slot ulong to long
  slots = get g_fp8_slots 0
  if or eq slots 0 ge slot slots
    ret FP8_SLOT_BAD_ARGS
  end
  st = get g_fp8_state slot
  pn = get g_fp8_pins slot
  if or ne pn 0 eq st FP8_SLOT_LOADING
    put g_fp8_stats 2 add get g_fp8_stats 2 1
    ret FP8_SLOT_BUSY
  end
  if eq st FP8_SLOT_READY
    put g_fp8_stats 4 add get g_fp8_stats 4 1
  end
  put g_fp8_state slot FP8_SLOT_EMPTY
  put g_fp8_key slot 0
  ret FP8_SLOT_OK
end

fn omega_fp8_slot_query slot ulong rec_out edit ulong * to long
  slots = get g_fp8_slots 0
  if or eq slots 0 or ge slot slots lt len rec_out 4
    ret FP8_SLOT_BAD_ARGS
  end
  put rec_out 0 get g_fp8_state slot
  put rec_out 1 get g_fp8_pins slot
  put rec_out 2 get g_fp8_key slot
  put rec_out 3 get g_fp8_ver slot
  ret FP8_SLOT_OK
end

fn omega_fp8_slot_table_idle to ulong
  slots = get g_fp8_slots 0
  if eq slots 0
    ret 1
  end
  for i ulong slots bound 1024
    if or ne get g_fp8_pins i 0 eq get g_fp8_state i FP8_SLOT_LOADING
      ret 0
    end
  end
  ret 1
end

fn omega_fp8_slot_table_stats stats_out edit ulong * to void
  if lt len stats_out 8
    ret
  end
  slots = get g_fp8_slots 0
  if eq slots 0
    for i ulong 8
      put stats_out i 0
    end
    ret
  end
  for i ulong 8
    put stats_out i get g_fp8_stats i
  end
end

fn omega_fp8_slot_table_set_mutant mutant ulong to void
  if eq get g_fp8_slots 0 0
    ret
  end
  put g_fp8_mutant 0 mutant
end

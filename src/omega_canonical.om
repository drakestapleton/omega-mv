note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_canonical.c (canonical object encoding
note and SemanticId operations).
note Composes on seed/ng/sha256.om and om/visor/canonical_om2.om.
om2

const CAN_MAX_ATTRS ulong 32
const CAN_MAX_RELS ulong 64
const CAN_MAX_CONSTS ulong 32
const CAN_MAX_KEY_LEN ulong 64
const CAN_MAX_VAL_LEN ulong 512
const CAN_MAX_CONST_PAY ulong 128
const CAN_MAX_PAYLOAD ulong 1024

global g_can_kind ulong 1
global g_can_has_id ulong 1
global g_can_id uchar 32

global g_can_attr_n ulong 1
global g_can_attr_keys uchar 2048
global g_can_attr_vlen ulong 32
global g_can_attr_vals uchar 16384

global g_can_rel_n ulong 1
global g_can_rel_kinds ushort 64
global g_can_rel_tgts uchar 2048

global g_can_const_n ulong 1
global g_can_const_meta ushort 64
global g_can_const_pays uchar 4096

global g_can_pay_len ulong 1
global g_can_pay uchar 1024

fn omega_compare_semantic_id a view uchar 32 b view uchar 32 to long
  ret om_canon_cmp_id a b
end

fn omega_hex_semantic_id id view uchar 32 dst edit uchar 65 to void
  om_canon_hex_id id dst
end

fn omega_parse_hex_semantic_id hx view uchar * n ulong dst edit uchar 32 to long
  ret om_canon_parse_hex hx n dst
end

fn omega_canonical_object_version kind ulong to ulong
  ret om_canon_obj_ver kind
end

fn omega_canonical_check_header ver ulong kind ulong to long
  ret om_canon_chk_hdr ver kind
end

fn can_key_len slot ulong to ulong
  base = mul slot CAN_MAX_KEY_LEN
  for k ulong CAN_MAX_KEY_LEN
    if eq get g_can_attr_keys add base k 0
      ret k
    end
  end
  ret CAN_MAX_KEY_LEN
end

fn can_sort_attrs_g na ulong ord edit ushort 32 to long
  keys = new uchar 2048 0
  for i ulong mul na CAN_MAX_KEY_LEN bound 2048
    put keys i get g_can_attr_keys i
  end
  ret om_canon_sort_attr keys na ord
end

fn can_copy_attr_key idx ulong kl ulong dst edit uchar * pos ulong to ulong
  kbase = mul idx CAN_MAX_KEY_LEN
  p = pos
  for k ulong kl bound 64
    put dst p get g_can_attr_keys add kbase k
    p = add p 1
  end
  ret p
end

fn can_copy_attr_val idx ulong vl ulong dst edit uchar * pos ulong to ulong
  vbase = mul idx CAN_MAX_VAL_LEN
  p = pos
  for k ulong vl bound 512
    put dst p get g_can_attr_vals add vbase k
    p = add p 1
  end
  ret p
end

fn can_encode_one_attr idx ulong dst edit uchar * pos ulong mlen ulong to long
  kl = can_key_len idx
  if gt kl 255
    ret -1
  end
  vl = get g_can_attr_vlen idx
  if gt add add pos 3 add kl vl mlen
    ret -1
  end
  put dst pos uchar kl
  p = can_copy_attr_key idx kl dst add pos 1
  np = om_canon_write_u16be vl dst p mlen
  if lt np 0
    ret -1
  end
  ret long can_copy_attr_val idx vl dst ulong np
end

fn can_encode_attrs dst edit uchar * pos ulong mlen ulong to long
  na = get g_can_attr_n 0
  if gt na CAN_MAX_ATTRS
    ret -1
  end
  ord = new ushort 32 0
  if gt na 0
    if ne can_sort_attrs_g na ord 0
      ret -1
    end
  end
  np = om_canon_write_u16be na dst pos mlen
  if lt np 0
    ret -1
  end
  p = ulong np
  for i ulong na bound 32
    np2 = can_encode_one_attr ulong get ord i dst p mlen
    if lt np2 0
      ret -1
    end
    p = ulong np2
  end
  ret long p
end

fn can_sort_rels_g nr ulong ord edit ushort 64 to long
  rk = new ushort 64 0
  rt = new uchar 2048 0
  for i ulong nr bound 64
    put rk i get g_can_rel_kinds i
  end
  for i ulong mul nr 32 bound 2048
    put rt i get g_can_rel_tgts i
  end
  ret om_canon_sort_rel rk rt nr ord
end

fn can_encode_one_rel idx ulong dst edit uchar * pos ulong mlen ulong to long
  if gt add pos 34 mlen
    ret -1
  end
  np = om_canon_write_u16be ulong get g_can_rel_kinds idx dst pos mlen
  if lt np 0
    ret -1
  end
  p = ulong np
  tbase = mul idx 32
  for k ulong 32
    put dst p get g_can_rel_tgts add tbase k
    p = add p 1
  end
  ret long p
end

fn can_encode_rels dst edit uchar * pos ulong mlen ulong to long
  nr = get g_can_rel_n 0
  if gt nr CAN_MAX_RELS
    ret -1
  end
  ord = new ushort 64 0
  if gt nr 0
    if ne can_sort_rels_g nr ord 0
      ret -1
    end
  end
  np = om_canon_write_u16be nr dst pos mlen
  if lt np 0
    ret -1
  end
  p = ulong np
  for i ulong nr bound 64
    np2 = can_encode_one_rel ulong get ord i dst p mlen
    if lt np2 0
      ret -1
    end
    p = ulong np2
  end
  ret long p
end

fn can_sort_consts_g nc ulong ord edit ushort 32 to long
  cm = new ushort 64 0
  cp = new uchar 4096 0
  for i ulong mul nc 2 bound 64
    put cm i get g_can_const_meta i
  end
  for i ulong mul nc CAN_MAX_CONST_PAY bound 4096
    put cp i get g_can_const_pays i
  end
  ret om_canon_sort_const cm cp nc ord
end

fn can_copy_const_pay idx ulong cl ulong dst edit uchar * pos ulong to ulong
  cbase = mul idx CAN_MAX_CONST_PAY
  p = pos
  for k ulong cl bound 128
    put dst p get g_can_const_pays add cbase k
    p = add p 1
  end
  ret p
end

fn can_encode_one_const idx ulong dst edit uchar * pos ulong mlen ulong to long
  ck = ulong get g_can_const_meta mul idx 2
  cl = ulong get g_can_const_meta add mul idx 2 1
  if gt add add pos 4 cl mlen
    ret -1
  end
  np = om_canon_write_u16be ck dst pos mlen
  if lt np 0
    ret -1
  end
  np2 = om_canon_write_u16be cl dst ulong np mlen
  if lt np2 0
    ret -1
  end
  ret long can_copy_const_pay idx cl dst ulong np2
end

fn can_encode_consts dst edit uchar * pos ulong mlen ulong to long
  nc = get g_can_const_n 0
  if gt nc CAN_MAX_CONSTS
    ret -1
  end
  ord = new ushort 32 0
  if gt nc 0
    if ne can_sort_consts_g nc ord 0
      ret -1
    end
  end
  np = om_canon_write_u16be nc dst pos mlen
  if lt np 0
    ret -1
  end
  p = ulong np
  for i ulong nc bound 32
    np2 = can_encode_one_const ulong get ord i dst p mlen
    if lt np2 0
      ret -1
    end
    p = ulong np2
  end
  ret long p
end

fn omega_canonical_encode dst edit uchar * mlen ulong to long
  if eq mlen 0
    ret -1
  end
  p = om_canon_write_hdr get g_can_kind 0 dst mlen
  if lt p 0
    ret -1
  end
  p = can_encode_attrs dst ulong p mlen
  if lt p 0
    ret -1
  end
  p = can_encode_rels dst ulong p mlen
  if lt p 0
    ret -1
  end
  p = can_encode_consts dst ulong p mlen
  if lt p 0
    ret -1
  end
  pl = get g_can_pay_len 0
  if gt pl CAN_MAX_PAYLOAD
    ret -1
  end
  if gt add add ulong p 4 pl mlen
    ret -1
  end
  np = om_canon_write_u32be pl dst ulong p mlen
  if lt np 0
    ret -1
  end
  pu = ulong np
  for k ulong pl bound 1024
    put dst pu get g_can_pay k
    pu = add pu 1
  end
  ret long pu
end

fn omega_compute_semantic_id to long
  cbuf = new uchar 4096 0
  clen = omega_canonical_encode cbuf 4096
  if lt clen 0
    ret -1
  end
  cu = ulong clen
  for i ulong cu bound 4096
    put sh_dat i get cbuf i
  end
  sh_all cu
  for i ulong 32
    put g_can_id i get sh_dig i
  end
  put g_can_has_id 0 1
  ret 0
end

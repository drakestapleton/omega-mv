note
note GPU code buffer sizing (pure OM-2 port of src/omega_gpu_code_alloc.h):
note code + 2 KB instruction prefetch tail, page rounded, at least one page.
note Returns 0 when code_size + tail + (page - 1) would overflow ulong.

const OMEGA_GPU_CODE_PREFETCH_TAIL ulong 2048
const OMEGA_GPU_CODE_PAGE ulong 4096

fn omega_gpu_code_alloc_bytes code_size ulong to ulong
tail = OMEGA_GPU_CODE_PREFETCH_TAIL
page = OMEGA_GPU_CODE_PAGE
pm1 = sub page ulong 1
umax = ulong 0xffffffffffffffff
lim = sub sub umax tail pm1
if gt code_size lim
ret ulong 0
end
raw = add add code_size tail pm1
nmask = xor umax pm1
b = and raw nmask
if lt b page
ret page
end
ret b
end

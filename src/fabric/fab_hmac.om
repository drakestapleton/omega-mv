note
note src/fabric/fab_hmac.om -- HMAC-SHA256 (RFC 2104), constant-time compare,
note canonical LE codecs, and 64-byte stand-in signature for Fabric F5-0.
note Composed after seed/ng/sha256.om and src/runtime/aien_machine_id.om.

const FAB_SIG_BYTES ulong 64

text t_fab_half2 "AFAB stand-in sig64 half 2"

fn fab_put_u16 dst edit uchar * pos ulong v ulong to void
  put dst pos uchar and v 255
  put dst add pos 1 uchar and shr v 8 255
end

fn fab_put_u32 dst edit uchar * pos ulong v ulong to void
  for i ulong 4
    put dst add pos i uchar and shr v mul i 8 255
  end
end

fn fab_put_u64 dst edit uchar * pos ulong v ulong to void
  for i ulong 8
    put dst add pos i uchar and shr v mul i 8 255
  end
end

fn fab_get_u16 src view uchar * pos ulong to ulong
  b0 = ulong get src pos
  b1 = ulong get src add pos 1
  ret or b0 shl b1 8
end

fn fab_get_u32 src view uchar * pos ulong to ulong
  v = ulong 0
  for i ulong 4
    b = ulong get src add pos i
    v = or v shl b mul i 8
  end
  ret v
end

fn fab_get_u64 src view uchar * pos ulong to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get src add pos i
    v = or v shl b mul i 8
  end
  ret v
end

fn fab_ct_equal a view uchar * b view uchar * n ulong to int
  acc = ulong 0
  for i ulong n bound 9223372036854775807
    acc = or acc xor ulong get a i ulong get b i
  end
  if eq acc 0
    ret 1
  end
  ret 0
end

fn fab_ct_equal64 a view uchar 64 b view uchar 64 to int
  acc = ulong 0
  for i ulong 64
    acc = or acc xor ulong get a i ulong get b i
  end
  if eq acc 0
    ret 1
  end
  ret 0
end

fn fab_hmac_sha256 key view uchar * msg view uchar * dst edit uchar 32 to int
  k = new uchar 64 0
  inner = new uchar 32 0
  klen = len key
  mlen = len msg
  if gt klen 64
    for i ulong klen bound 65536
      put sh_dat i get key i
    end
    sh_all klen
    for i ulong 32
      put k i get sh_dig i
    end
  else
    for i ulong klen bound 64
      put k i get key i
    end
  end
  for i ulong 64
    put sh_dat i uchar xor ulong get k i 54
  end
  for i ulong mlen bound 65536
    put sh_dat add 64 i get msg i
  end
  sh_all add 64 mlen
  for i ulong 32
    put inner i get sh_dig i
  end
  for i ulong 64
    put sh_dat i uchar xor ulong get k i 92
  end
  for i ulong 32
    put sh_dat add 64 i get inner i
  end
  sh_all 96
  for i ulong 32
    put dst i get sh_dig i
    put inner i uchar 0
  end
  for i ulong 64
    put k i uchar 0
  end
  ret 0
end

fn fab_hmac_sig64 key view uchar 32 msg view uchar * dst edit uchar 64 to int
  h1 = new uchar 32 0
  k2 = new uchar 32 0
  h2 = new uchar 32 0
  dom = new uchar 26 0
  for i ulong 26
    put dom i get t_fab_half2 i
  end
  rc = fab_hmac_sha256 part key 0 32 view msg edit h1
  if ne rc 0
    ret sub int 0 1
  end
  rc = fab_hmac_sha256 part key 0 32 view dom edit k2
  if ne rc 0
    ret sub int 0 1
  end
  rc = fab_hmac_sha256 part k2 0 32 view msg edit h2
  if ne rc 0
    ret sub int 0 1
  end
  for i ulong 32
    put dst i get h1 i
    put dst add 32 i get h2 i
    put k2 i uchar 0
  end
  ret 0
end

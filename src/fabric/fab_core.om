note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/fabric/ (fab_hmac.c, fabric.c,
note fab_dispatch.c): constant-time equality, HMAC XOR pads, canonical LE
note 16/32/64 codecs, message body sizing, and non-zero digest matching.
om2

export fn fab_om_ct_equal a view uchar * b view uchar * n ulong to ulong
  acc = ulong 0
  for i ulong n
    acc = or acc xor ulong get a i ulong get b i
  end
  if eq acc 0
    ret 1
  end
  ret 0
end

export fn fab_om_hmac_xor_pad k view uchar 64 pad edit uchar 64 xbyte ulong to void
  for i ulong 64
    put pad i uchar xor ulong get k i xbyte
  end
end

export fn fab_om_put_u16 dst edit uchar * pos ulong v ulong to void
  put dst pos uchar and v 255
  put dst add pos 1 uchar and shr v 8 255
end

export fn fab_om_put_u32 dst edit uchar * pos ulong v ulong to void
  for i ulong 4
    put dst add pos i uchar and shr v mul i 8 255
  end
end

export fn fab_om_put_u64 dst edit uchar * pos ulong v ulong to void
  for i ulong 8
    put dst add pos i uchar and shr v mul i 8 255
  end
end

export fn fab_om_get_u16 src view uchar * pos ulong to ulong
  b0 = ulong get src pos
  b1 = ulong get src add pos 1
  ret or b0 shl b1 8
end

export fn fab_om_get_u32 src view uchar * pos ulong to ulong
  v = ulong 0
  for i ulong 4
    b = ulong get src add pos i
    v = or v shl b mul i 8
  end
  ret v
end

export fn fab_om_get_u64 src view uchar * pos ulong to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get src add pos i
    v = or v shl b mul i 8
  end
  ret v
end

export fn fab_om_body_size kind ulong to ulong
  if eq kind 1
    ret 40
  end
  if eq kind 2
    ret 8
  end
  if eq kind 3
    ret 188
  end
  if eq kind 4
    ret 0
  end
  ret 0xffffffffffffffff
end

export fn fab_om_digest_nonzero_eq a view uchar 32 b view uchar 32 to ulong
  any = ulong 0
  diff = ulong 0
  for i ulong 32
    ai = ulong get a i
    bi = ulong get b i
    any = or any bi
    diff = or diff xor ai bi
  end
  if and ne any 0 eq diff 0
    ret 1
  end
  ret 0
end

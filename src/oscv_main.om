note
note src/oscv_main.om -- pure seeded OM-2 port of src/oscv_main.c
note Verified OSC driver (VC1 stage 4, ADR 0029): CLI flag parsing, sibling path
note derivation, store integrity check, domain-folded build_id & artifact metadata,
note refusal output, and --meta-out emission. Composes with seed/ng/sha256.om and
note src/omega_vcstore.om.

const OSCV_DOMAIN_DEV ulong 1
const OSCV_DOMAIN_BUILD ulong 2

text oscv_bdom "OSC1.BUILD.V1"
text oscv_f_domain "--domain"
text oscv_f_lock "--lock"
text oscv_f_store "--store"
text oscv_f_receipts "--receipts"
text oscv_f_blobs "--blobs"
text oscv_f_metaout "--meta-out"
text oscv_d_dev "dev"
text oscv_d_build "build"
text oscv_def_lock "omega.lock"
text oscv_def_store "omega.vcstore"
text oscv_def_rec "receipts"
text oscv_def_blobs "blobs"
text oscv_m_hdr "OMEGA-ARTIFACT v1\ndomain "
text oscv_m_taint "\ntainted "
text oscv_m_ir "\nir_sha256 "
text oscv_m_cl "\nclosure_sha256 "
text oscv_m_bid "\nbuild_id "
text oscv_ref_line "error kind=IMPORT_REFUSED line=0 col=0 object=store origin_line=0 other= transition=UNVERIFIED_DEPENDENCY\nmessage=the Verified Crumb Store file is not intact\nresolve_code=UNVERIFIED_DEPENDENCY\n"

global g_oscv_domain ulong 1
global g_oscv_tainted ulong 1
global g_oscv_ir_dig uchar 32
global g_oscv_cl_dig uchar 32
global g_oscv_bid uchar 32
global g_oscv_meta uchar 512
global g_oscv_mlen ulong 1
global g_oscv_src uchar 65536
global g_oscv_slen ulong 1
global g_oscv_arg uchar 512
global g_oscv_file uchar 512
global g_oscv_flen ulong 1
global g_oscv_store uchar 512
global g_oscv_stlen ulong 1
global g_oscv_mout uchar 512
global g_oscv_molen ulong 1

fn oscv_eq_txt buf view uchar * n ulong pat view uchar * to bool
  if ne n len pat
    ret false
  end
  for i ulong n bound 512
    if ne get buf i get pat i
      ret false
    end
  end
  ret true
end

note Join directory prefix of file with leaf into g_oscv_arg; returns written length
fn oscv_join_dir file view uchar * flen ulong leaf view uchar * to ulong
  last_slash = ulong 0
  has_slash = ulong 0
  for i ulong flen bound 512
    if eq get file i 47
      last_slash = i
      has_slash = 1
    end
  end
  p = ulong 0
  if eq has_slash 1
    for i ulong last_slash bound 512
      if lt p 512
        put g_oscv_arg p get file i
        p = add p 1
      end
    end
    if lt p 512
      put g_oscv_arg p 47
      p = add p 1
    end
  end
  for i ulong len leaf bound 128
    if lt p 512
      put g_oscv_arg p get leaf i
      p = add p 1
    end
  end
  ret p
end

note Exact byte-for-byte match to omega_build_id in src/omega_resolve.c:
note SHA-256("OSC1.BUILD.V1\0" (14 bytes) || ir_digest(32) || domain_byte(1) || closure_digest(32))
note Writes result into g_oscv_bid[0..32).
fn oscv_build_id domain ulong ir_dig view uchar 32 cl_dig view uchar 32 to void
  p = ulong 0
  for i ulong len oscv_bdom bound 32
    put sh_dat p get oscv_bdom i
    p = add p 1
  end
  put sh_dat p 0
  p = add p 1
  for i ulong 32
    put sh_dat p get ir_dig i
    p = add p 1
  end
  put sh_dat p uchar domain
  p = add p 1
  for i ulong 32
    put sh_dat p get cl_dig i
    p = add p 1
  end
  sh_all p
  for i ulong 32
    put g_oscv_bid i get sh_dig i
  end
end

fn oscv_mput pos ulong s view uchar * to ulong
  n = len s
  for i ulong n bound 64
    put g_oscv_meta add pos i get s i
  end
  ret add pos n
end

fn oscv_mput_hex32 pos ulong kind ulong to ulong
  p = pos
  for i ulong 32
    b = ulong 0
    if eq kind 0
      b = ulong get g_oscv_ir_dig i
    end
    if eq kind 1
      b = ulong get g_oscv_cl_dig i
    end
    if eq kind 2
      b = ulong get g_oscv_bid i
    end
    put g_oscv_meta p sh_hexd uint shr b 4
    put g_oscv_meta add p 1 sh_hexd uint and b 15
    p = add p 2
  end
  ret p
end

fn oscv_artifact_meta_make domain ulong ir_dig view uchar 32 cl_dig view uchar 32 to ulong
  put g_oscv_domain 0 domain
  if eq domain OSCV_DOMAIN_DEV
    put g_oscv_tainted 0 1
  else
    put g_oscv_tainted 0 0
  end
  oscv_build_id domain ir_dig cl_dig
  for i ulong 32
    put g_oscv_ir_dig i get ir_dig i
    put g_oscv_cl_dig i get cl_dig i
  end
  p = ulong 0
  p = oscv_mput p oscv_m_hdr
  if eq domain OSCV_DOMAIN_DEV
    p = oscv_mput p oscv_d_dev
  else
    p = oscv_mput p oscv_d_build
  end
  p = oscv_mput p oscv_m_taint
  if eq get g_oscv_tainted 0 1
    put g_oscv_meta p 49
  else
    put g_oscv_meta p 48
  end
  p = add p 1
  p = oscv_mput p oscv_m_ir
  p = oscv_mput_hex32 p 0
  p = oscv_mput p oscv_m_cl
  p = oscv_mput_hex32 p 1
  p = oscv_mput p oscv_m_bid
  p = oscv_mput_hex32 p 2
  put g_oscv_meta p 10
  p = add p 1
  put g_oscv_mlen 0 p
  ret p
end

fn oscv_set_paths store_path view uchar * meta_path view uchar * to void
  sl = len store_path
  if gt sl 512
    sl = 512
  end
  for i ulong sl bound 512
    put g_oscv_store i get store_path i
  end
  put g_oscv_stlen 0 sl
  ml = len meta_path
  if gt ml 512
    ml = 512
  end
  for i ulong ml bound 512
    put g_oscv_mout i get meta_path i
  end
  put g_oscv_molen 0 ml
end

fn oscv_probe_store to long
  stbuf = new uchar 512 0
  stlen = get g_oscv_stlen 0
  if eq stlen 0
    ret 0
  end
  for i ulong stlen bound 512
    put stbuf i get g_oscv_store i
  end
  probe = fopen stbuf 0 stlen 0 0
  if lt probe 0
    ret 0
  end
  ign_p = fclose int probe
  lrc = omega_vcstore_load stbuf stlen
  if ne lrc VCS_OK
    ign_w = write 1 oscv_ref_line 0 len oscv_ref_line
    ret 1
  end
  ret 0
end

fn oscv_write_meta mlen ulong to long
  molen = get g_oscv_molen 0
  if eq molen 0
    ret 0
  end
  mfd = fopen g_oscv_mout 0 molen 577 420
  if lt mfd 0
    ret 2
  end
  wr = write int mfd g_oscv_meta 0 mlen
  cr = fclose int mfd
  if or ne wr long mlen ne cr 0
    ret 2
  end
  ret 0
end

fn oscv_run_file domain ulong src_path view uchar * to long
  ir_dig = new uchar 32 0
  cl_dig = new uchar 32 0
  fd = fopen src_path 0 len src_path 0 0
  if lt fd 0
    ret 2
  end
  nr = read int fd g_oscv_src 0 65536
  ign = fclose int fd
  if lt nr 0
    ret 2
  end
  slen = ulong nr
  put g_oscv_slen 0 slen
  for i ulong slen bound 65536
    put sh_dat i get g_oscv_src i
  end
  sh_all slen
  for i ulong 32
    put ir_dig i get sh_dig i
  end
  ign_i = omega_vcstore_init
  prc = oscv_probe_store
  if ne prc 0
    omega_vcstore_destroy
    ret prc
  end
  mlen = oscv_artifact_meta_make domain ir_dig cl_dig
  wrc = oscv_write_meta mlen
  omega_vcstore_destroy
  ret wrc
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_machine.c (OmegaMachineGraph profiles,
note canonical MACHINE_ID hashing, topology validation, latency estimation).
note Composes on seed/ng/sha256.om and om/aarch64/aarch64_om2.om.
om2

const MG_MAX_UNITS ulong 8
const MG_MAX_CACHES ulong 8
const MG_KIND_MACHINE ulong 7
const MG_PROFILE_V8A ulong 1
const MG_DECODED_MUL ulong 3
const MG_UNIT_ALU ulong 0
const MG_UNIT_BRANCH ulong 1
const MG_UNIT_MUL ulong 2
const MG_UNIT_DIV ulong 3
const MG_UNIT_LS ulong 4
const MG_UNIT_VEC ulong 5
const MG_PD_MAGIC ulong 0x4d414348

text mg_name_spark "NVIDIA_DGX_SPARK_GRACE_V2"
text mg_name_qemu "QEMU_VIRT_AARCH64_GENERIC"

global g_mg_id uchar 32
global g_mg_name uchar 64
global g_mg_name_len ulong 1
global g_mg_profile ulong 1

global g_mg_issue_w ulong 1
global g_mg_max_if ulong 1
global g_mg_ooo ulong 1
global g_mg_unit_n ulong 1
global g_mg_u_type ulong 8
global g_mg_u_cnt ulong 8
global g_mg_u_lat ulong 8
global g_mg_u_tput ulong 8

global g_mg_gpr_cnt ulong 1
global g_mg_gpr_w ulong 1
global g_mg_vec_cnt ulong 1
global g_mg_vec_w ulong 1

global g_mg_cache_n ulong 1
global g_mg_c_lvl ulong 8
global g_mg_c_inst ulong 8
global g_mg_c_sz ulong 8
global g_mg_c_line ulong 8
global g_mg_c_assoc ulong 8
global g_mg_c_lat ulong 8

global g_mg_dram_base ulong 1
global g_mg_dram_size ulong 1
global g_mg_phys_auth ulong 1
global g_mg_phys_seal uchar 32

note PhysicsDescriptor input globals for omega_machine_ingest_physics_descriptor
global g_pd_magic ulong 1
global g_pd_profile ulong 1
global g_pd_name uchar 32
global g_pd_name_len ulong 1
global g_pd_issue_w ulong 1
global g_pd_gpr_cnt ulong 1
global g_pd_vec_cnt ulong 1
global g_pd_l1d ulong 1
global g_pd_l2 ulong 1
global g_pd_l3 ulong 1
global g_pd_dram_base ulong 1
global g_pd_dram_size ulong 1
global g_pd_seal uchar 32

fn mg_set_unit idx ulong ty ulong cnt ulong lat ulong tput ulong to void
  put g_mg_u_type idx ty
  put g_mg_u_cnt idx cnt
  put g_mg_u_lat idx lat
  put g_mg_u_tput idx tput
end

fn mg_set_cache_a idx ulong lvl ulong is_i ulong sz ulong to void
  put g_mg_c_lvl idx lvl
  put g_mg_c_inst idx is_i
  put g_mg_c_sz idx sz
end

fn mg_set_cache_b idx ulong line ulong assoc ulong lat ulong to void
  put g_mg_c_line idx line
  put g_mg_c_assoc idx assoc
  put g_mg_c_lat idx lat
end

fn mg_clear to void
  for i ulong 32
    put g_mg_id i 0
    put g_mg_phys_seal i 0
  end
  for i ulong 64
    put g_mg_name i 0
  end
  put g_mg_name_len 0 0
  put g_mg_profile 0 0
  put g_mg_issue_w 0 0
  put g_mg_max_if 0 0
  put g_mg_ooo 0 0
  put g_mg_unit_n 0 0
  put g_mg_gpr_cnt 0 0
  put g_mg_gpr_w 0 0
  put g_mg_vec_cnt 0 0
  put g_mg_vec_w 0 0
  put g_mg_cache_n 0 0
  put g_mg_dram_base 0 0
  put g_mg_dram_size 0 0
  put g_mg_phys_auth 0 0
end

fn omega_machine_init nm view uchar * nlen ulong profile ulong to void
  mg_clear
  n = nlen
  if gt n 63
    n = 63
  end
  for i ulong n bound 63
    put g_mg_name i get nm i
  end
  put g_mg_name_len 0 n
  put g_mg_profile 0 and profile 255
end

fn mg_put_be32 pos ulong v ulong to ulong
  put sh_dat pos uchar and shr v 24 255
  put sh_dat add pos 1 uchar and shr v 16 255
  put sh_dat add pos 2 uchar and shr v 8 255
  put sh_dat add pos 3 uchar and v 255
  ret add pos 4
end

fn mg_put_be64 pos ulong v ulong to ulong
  p = mg_put_be32 pos shr v 32
  ret mg_put_be32 p and v ulong 0xffffffff
end

fn omega_machine_compute_id to long
  put sh_dat 0 uchar 79
  put sh_dat 1 uchar 77
  put sh_dat 2 uchar 71
  put sh_dat 3 uchar 48
  put sh_dat 4 uchar MG_KIND_MACHINE
  put sh_dat 5 uchar and get g_mg_profile 0 255
  nlen = get g_mg_name_len 0
  put sh_dat 6 uchar and nlen 255
  p = ulong 7
  for i ulong nlen bound 64
    put sh_dat p get g_mg_name i
    p = add p 1
  end
  p = mg_put_be32 p get g_mg_issue_w 0
  p = mg_put_be32 p get g_mg_max_if 0
  put sh_dat p uchar and get g_mg_ooo 0 1
  p = add p 1
  un = get g_mg_unit_n 0
  put sh_dat p uchar and un 255
  p = add p 1
  for u ulong un bound 8
    put sh_dat p uchar and get g_mg_u_type u 255
    put sh_dat add p 1 uchar and get g_mg_u_cnt u 255
    put sh_dat add p 2 uchar and get g_mg_u_lat u 255
    put sh_dat add p 3 uchar and get g_mg_u_tput u 255
    p = add p 4
  end
  put sh_dat p uchar and get g_mg_gpr_cnt 0 255
  put sh_dat add p 1 uchar and get g_mg_gpr_w 0 255
  put sh_dat add p 2 uchar and get g_mg_vec_cnt 0 255
  put sh_dat add p 3 uchar and get g_mg_vec_w 0 255
  p = add p 4
  cn = get g_mg_cache_n 0
  put sh_dat p uchar and cn 255
  p = add p 1
  for c ulong cn bound 8
    put sh_dat p uchar and get g_mg_c_lvl c 255
    put sh_dat add p 1 uchar and get g_mg_c_inst c 1
    p = mg_put_be64 add p 2 get g_mg_c_sz c
    put sh_dat p uchar and get g_mg_c_line c 255
    put sh_dat add p 1 uchar and get g_mg_c_assoc c 255
    put sh_dat add p 2 uchar and get g_mg_c_lat c 255
    p = add p 3
  end
  p = mg_put_be64 p get g_mg_dram_base 0
  p = mg_put_be64 p get g_mg_dram_size 0
  put sh_dat p uchar and get g_mg_phys_auth 0 1
  p = add p 1
  for i ulong 32
    put sh_dat p get g_mg_phys_seal i
    p = add p 1
  end
  sh_all p
  for i ulong 32
    put g_mg_id i get sh_dig i
  end
  ret 0
end

fn omega_machine_build_dgx_spark to long
  omega_machine_init mg_name_spark len mg_name_spark MG_PROFILE_V8A
  put g_mg_issue_w 0 4
  put g_mg_max_if 0 256
  put g_mg_ooo 0 1
  put g_mg_unit_n 0 6
  mg_set_unit 0 MG_UNIT_ALU 4 1 4
  mg_set_unit 1 MG_UNIT_BRANCH 2 1 2
  mg_set_unit 2 MG_UNIT_MUL 2 3 2
  mg_set_unit 3 MG_UNIT_DIV 1 12 1
  mg_set_unit 4 MG_UNIT_LS 2 3 2
  mg_set_unit 5 MG_UNIT_VEC 4 2 4
  put g_mg_gpr_cnt 0 31
  put g_mg_gpr_w 0 64
  put g_mg_vec_cnt 0 32
  put g_mg_vec_w 0 128
  put g_mg_cache_n 0 4
  mg_set_cache_a 0 1 1 65536
  mg_set_cache_b 0 64 4 3
  mg_set_cache_a 1 1 0 65536
  mg_set_cache_b 1 64 8 4
  mg_set_cache_a 2 2 0 1048576
  mg_set_cache_b 2 64 8 10
  mg_set_cache_a 3 3 0 119537664
  mg_set_cache_b 3 64 16 35
  put g_mg_dram_base 0 ulong 0x80000000
  put g_mg_dram_size 0 mul ulong 128 ulong 1073741824
  put g_mg_phys_auth 0 1
  for i ulong 32
    put g_mg_phys_seal i uchar 0xa1
  end
  ret omega_machine_compute_id
end

fn omega_machine_build_qemu_virt to long
  omega_machine_init mg_name_qemu len mg_name_qemu MG_PROFILE_V8A
  put g_mg_issue_w 0 2
  put g_mg_max_if 0 64
  put g_mg_ooo 0 0
  put g_mg_unit_n 0 5
  mg_set_unit 0 MG_UNIT_ALU 2 1 2
  mg_set_unit 1 MG_UNIT_BRANCH 1 1 1
  mg_set_unit 2 MG_UNIT_MUL 1 4 1
  mg_set_unit 3 MG_UNIT_LS 1 4 1
  mg_set_unit 4 MG_UNIT_VEC 2 3 2
  put g_mg_gpr_cnt 0 31
  put g_mg_gpr_w 0 64
  put g_mg_vec_cnt 0 32
  put g_mg_vec_w 0 128
  put g_mg_cache_n 0 3
  mg_set_cache_a 0 1 1 32768
  mg_set_cache_b 0 64 2 2
  mg_set_cache_a 1 1 0 32768
  mg_set_cache_b 1 64 4 3
  mg_set_cache_a 2 2 0 524288
  mg_set_cache_b 2 64 8 12
  put g_mg_dram_base 0 ulong 0x40000000
  put g_mg_dram_size 0 ulong 1073741824
  put g_mg_phys_auth 0 1
  for i ulong 32
    put g_mg_phys_seal i uchar 0xb2
  end
  ret omega_machine_compute_id
end

fn omega_machine_ingest_physics_descriptor to long
  if ne get g_pd_magic 0 MG_PD_MAGIC
    ret -1
  end
  iw = get g_pd_issue_w 0
  gc = get g_pd_gpr_cnt 0
  if or eq iw 0 eq gc 0
    ret -1
  end
  nm = new uchar 32 0
  nlen = get g_pd_name_len 0
  if gt nlen 31
    nlen = 31
  end
  for i ulong nlen bound 32
    put nm i get g_pd_name i
  end
  omega_machine_init nm nlen get g_pd_profile 0
  put g_mg_issue_w 0 iw
  put g_mg_max_if 0 mul iw 32
  if ge iw 4
    put g_mg_ooo 0 1
  end
  put g_mg_unit_n 0 4
  mg_set_unit 0 MG_UNIT_ALU iw 1 iw
  mg_set_unit 1 MG_UNIT_BRANCH 1 1 1
  mg_set_unit 2 MG_UNIT_MUL 1 3 1
  mg_set_unit 3 MG_UNIT_LS 1 3 1
  put g_mg_gpr_cnt 0 gc
  put g_mg_gpr_w 0 64
  put g_mg_vec_cnt 0 get g_pd_vec_cnt 0
  put g_mg_vec_w 0 128
  cn = ulong 0
  if gt get g_pd_l1d 0 0
    mg_set_cache_a cn 1 0 get g_pd_l1d 0
    mg_set_cache_b cn 64 4 3
    cn = add cn 1
  end
  if gt get g_pd_l2 0 0
    mg_set_cache_a cn 2 0 get g_pd_l2 0
    mg_set_cache_b cn 64 8 10
    cn = add cn 1
  end
  if gt get g_pd_l3 0 0
    mg_set_cache_a cn 3 0 get g_pd_l3 0
    mg_set_cache_b cn 64 16 30
    cn = add cn 1
  end
  put g_mg_cache_n 0 cn
  put g_mg_dram_base 0 get g_pd_dram_base 0
  put g_mg_dram_size 0 get g_pd_dram_size 0
  put g_mg_phys_auth 0 1
  for i ulong 32
    put g_mg_phys_seal i get g_pd_seal i
  end
  ret omega_machine_compute_id
end

fn omega_machine_validate_topology to long
  if eq get g_mg_issue_w 0 0
    ret -1
  end
  if ne get g_mg_gpr_cnt 0 31
    ret -1
  end
  if ne get g_mg_gpr_w 0 64
    ret -1
  end
  prev = ulong 0
  cn = get g_mg_cache_n 0
  for c ulong cn bound 8
    lvl = get g_mg_c_lvl c
    if lt lvl prev
      ret -1
    end
    ls = get g_mg_c_line c
    if eq ls 0
      ret -1
    end
    if ne and ls sub ls 1 0
      ret -1
    end
    prev = lvl
  end
  ret 0
end

fn mg_rd_u32le code view uchar * off ulong to ulong
  b0 = ulong get code off
  b1 = shl ulong get code add off 1 8
  b2 = shl ulong get code add off 2 16
  b3 = shl ulong get code add off 3 24
  ret or or b0 b1 or b2 b3
end

fn mg_unit_lat ty ulong def ulong to ulong
  res = def
  un = get g_mg_unit_n 0
  for u ulong un bound 8
    if eq get g_mg_u_type u ty
      res = get g_mg_u_lat u
    end
  end
  ret res
end

fn omega_machine_estimate_latency code view uchar * clen ulong to ulong
  if eq clen 0
    ret 0
  end
  ic = div clen 4
  mul_lat = mg_unit_lat MG_UNIT_MUL 3
  alu_lat = mg_unit_lat MG_UNIT_ALU 1
  tot = ulong 0
  cells = new ulong 9 0
  for i ulong ic bound 1024
    w = mg_rd_u32le code mul i 4
    rc = a64decode w cells
    if and eq rc 0 eq get cells 0 MG_DECODED_MUL
      tot = add tot mul_lat
    else
      tot = add tot alu_lat
    end
  end
  iw = get g_mg_issue_w 0
  if and gt iw 1 gt ic 1
    folded = div sub add ic iw 1 iw
    if gt folded tot
      tot = folded
    end
  end
  ret tot
end

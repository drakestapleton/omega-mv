note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_blackwell_codegen_pattn.c.
note Composes on om/gpu/cg_pattn.om and om/gpu/bw_regalloc.om.
om2

fn pattn_om_touch_vreg vinfo edit long 768 r64 ulong pos long nv ulong to void
  if ge r64 nv
    ret
  end
  base = mul r64 3
  fd = get vinfo base
  lu = get vinfo add base 1
  if lt fd 0
    put vinfo base pos
  end
  if gt pos lu
    put vinfo add base 1 pos
  end
end

fn pattn_om_extend_loop vinfo edit long 768 nv ulong ls long le_idx long to void
  for v ulong nv bound 256
    base = mul v 3
    fd = get vinfo base
    lu = get vinfo add base 1
    if ge fd 0
      if lt fd ls
        if ge lu ls
          if lt lu le_idx
            put vinfo add base 1 le_idx
          end
        end
      end
    end
  end
end

fn pattn_om_build_vinfo ins view ulong 8192 meta view ulong 512 vinfo edit long 768 to long
  n = get meta 0
  nv = get meta 1
  nl = get meta 3
  for v ulong nv bound 256
    base = mul v 3
    put vinfo base -1
    put vinfo add base 1 -1
    put vinfo add base 2 long get meta add 64 v
  end
  for i ulong n bound 1024
    off = mul i 8
    flags = get ins add off 7
    if eq and flags 1 0
      pos = long i
      pattn_om_touch_vreg vinfo get ins add off 1 pos nv
      pattn_om_touch_vreg vinfo get ins add off 2 pos nv
      pattn_om_touch_vreg vinfo get ins add off 3 pos nv
      pattn_om_touch_vreg vinfo get ins add off 4 pos nv
    end
  end
  for l ulong nl bound 16
    s_u = get meta add 320 mul l 2
    e_u = get meta add 321 mul l 2
    if or gt s_u e_u ge e_u n
      ret -1
    end
    pattn_om_extend_loop vinfo nv long s_u long e_u
  end
  ret 0
end

fn pattn_om_solve ins view ulong 8192 meta view ulong 512 out_stats edit uint 2 to long
  n = get meta 0
  nv = get meta 1
  nu = get meta 2
  nl = get meta 3
  if or eq n 0 gt n 1024
    ret -1
  end
  if gt nv 256
    ret -1
  end
  if gt nu 32
    ret -1
  end
  if gt nl 16
    ret -1
  end
  vinfo = new long 768 0
  if ne pattn_om_build_vinfo ins meta vinfo 0
    ret -1
  end
  uinfo = new ulong 32 0
  for u ulong nu bound 32
    put uinfo u get meta add 352 u
  end
  cfg = new ulong 4 0
  put cfg 0 nv
  put cfg 1 nu
  put cfg 2 0
  res = new long 290 0
  if ne bw_regalloc_solve cfg vinfo uinfo res 0
    ret -1
  end
  put out_stats 0 uint n
  put out_stats 1 uint get res 288
  ret 0
end

fn omega_pattn_spec_ok sp view ulong 4 to long
  if ne cg_pattn_spec_ok sp 0
    ret 1
  end
  ret 0
end

fn omega_blackwell_codegen_prefill_attn_prog sp view ulong 4 ins edit ulong 8192 meta edit ulong 512 to long
  for i ulong 8192
    put ins i 0
  end
  for i ulong 512
    put meta i 0
  end
  rc = cg_pattn_emit sp ins meta
  if ne rc 0
    ret -1
  end
  if or ne get meta 5 0 eq get meta 0 0
    ret -1
  end
  stats = new uint 2 0
  if ne pattn_om_solve ins meta stats 0
    ret -1
  end
  ret 0
end

fn omega_prefill_attn_prog_stats sp view ulong 4 out_stats edit uint 2 to long
  ins = new ulong 8192 0
  meta = new ulong 512 0
  rc = cg_pattn_emit sp ins meta
  if ne rc 0
    ret -1
  end
  if or ne get meta 5 0 eq get meta 0 0
    ret -1
  end
  ret pattn_om_solve ins meta out_stats
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_blake3.c (chunking wrapper over om/blake3/b3unit.om).
note Composes on om/blake3/b3unit.om (provides omb3).
om2

fn omega_blake3_hash data view uchar * n ulong dst edit uchar 32 to void
  st = new ulong 448 0
  cbuf = new uchar 1024 0
  pos = ulong 0
  remn = n
  while gt remn 1024 bound 65536
    for i ulong 1024
      put cbuf i get data add pos i
    end
    omb3 st cbuf 1024 0 dst
    pos = add pos 1024
    remn = sub remn 1024
  end
  for i ulong remn bound 1024
    put cbuf i get data add pos i
  end
  omb3 st cbuf remn 1 dst
end

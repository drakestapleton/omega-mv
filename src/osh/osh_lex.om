note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/osh/osh_lex.osc.in (bounded, resumable shell tokenizer).
note Requires src/osh/osh_layout.om to be included before this file.
om2

fn lx_cls c ulong to ulong
  if eq c 0
    ret 0
  end
  if or eq c 32 eq c 9
    ret 1
  end
  if eq c 10
    ret 2
  end
  if eq c 39
    ret 3
  end
  if eq c 34
    ret 4
  end
  if eq c 92
    ret 5
  end
  if eq c 36
    ret 6
  end
  if eq c 96
    ret 7
  end
  if or eq c 124 or eq c 38 or eq c 59 eq c 60
    ret 8
  end
  if or eq c 62 or eq c 40 eq c 41
    ret 8
  end
  if eq c 35
    ret 9
  end
  if eq c 123
    ret 10
  end
  if eq c 125
    ret 11
  end
  if eq c 61
    ret 13
  end
  if or eq c 42 or eq c 63 eq c 91
    ret 14
  end
  if eq c 126
    ret 17
  end
  if and ge c 48 le c 57
    ret 16
  end
  if and ge c 65 le c 90
    ret 12
  end
  if and ge c 97 le c 122
    ret 12
  end
  if eq c 95
    ret 12
  end
  ret 15
end

fn lx_step st ulong k ulong c ulong p ulong to ulong
  s = st
  act = ulong 0
  if eq k 0
    ret or s shl ulong 220 16
  end
  if eq s 12
    if eq c 10
      ret 0
    end
    ret or ulong 1 or shl ulong 8 8 shl ulong 4 24
  end
  if eq s 0
    if eq k 1
      ret 0
    end
    if eq k 2
      ret shl ulong 6 8
    end
    if eq k 9
      ret 10
    end
    if eq k 5
      ret 12
    end
    if eq k 8
      if or eq c 40 eq c 41
        ret shl ulong 228 16
      end
      ret or ulong 11 shl ulong 7 8
    end
    if eq k 17
      ret shl ulong 223 16
    end
    act = 1
    s = 1
  end
  if or eq s 6 eq s 7
    ctx = ulong 1
    if eq s 7
      ctx = 3
    end
    if or eq k 12 eq k 16
      ret ctx
    end
    if or eq c 63 or eq c 35 or eq c 64 eq c 42
      ret ctx
    end
    if eq c 123
      ret add s 2
    end
    if eq c 40
      ret or s shl ulong 226 16
    end
    if or eq c 36 or eq c 33 eq c 45
      ret or s shl ulong 225 16
    end
    if eq s 6
      if or eq c 39 eq c 34
        ret or s shl ulong 225 16
      end
    end
    s = ctx
  end
  if or eq s 8 eq s 9
    ctx2 = ulong 1
    if eq s 9
      ctx2 = 3
    end
    if or eq k 12 eq k 16
      ret s
    end
    if and eq k 11 ne p 123
      ret ctx2
    end
    ret or s shl ulong 224 16
  end
  if eq s 1
    if or eq k 1 or eq k 2 eq k 8
      ret shl ulong 2 8
    end
    if eq k 3
      ret or ulong 2 or shl act 8 shl ulong 1 24
    end
    if eq k 4
      ret or ulong 3 or shl act 8 shl ulong 2 24
    end
    if eq k 5
      ret or ulong 4 shl act 8
    end
    if eq k 6
      ret or ulong 6 or shl act 8 shl ulong 8 24
    end
    if eq k 7
      ret shl ulong 221 16
    end
    if eq k 14
      ret shl ulong 222 16
    end
    if eq k 18
      ret shl ulong 223 16
    end
    ret or ulong 1 shl act 8
  end
  if eq s 2
    if eq k 3
      ret 1
    end
    ret 2
  end
  if eq s 3
    if eq k 4
      ret 1
    end
    if eq k 5
      ret 5
    end
    if eq k 6
      ret or ulong 7 shl ulong 8 24
    end
    if eq k 7
      ret shl ulong 221 16
    end
    ret 3
  end
  if eq s 4
    if eq c 10
      ret or ulong 1 shl ulong 32 24
    end
    ret or ulong 1 shl ulong 4 24
  end
  if eq s 5
    if eq c 10
      ret or ulong 3 shl ulong 32 24
    end
    ret or ulong 3 shl ulong 4 24
  end
  if eq s 10
    if eq k 2
      ret shl ulong 6 8
    end
    ret 10
  end
  if eq s 11
    if and eq p 62 eq c 62
      ret shl ulong 4 8
    end
    if and eq p 124 eq c 124
      ret shl ulong 4 8
    end
    if and eq p 38 eq c 38
      ret shl ulong 4 8
    end
    if and eq p 62 eq c 38
      ret shl ulong 4 8
    end
    if and eq p 60 eq c 38
      ret shl ulong 4 8
    end
    if and eq p 60 eq c 60
      ret shl ulong 229 16
    end
    if and eq p 59 eq c 59
      ret shl ulong 230 16
    end
    if and eq p 62 eq c 124
      ret shl ulong 231 16
    end
    if and eq p 60 eq c 62
      ret shl ulong 231 16
    end
    ret shl ulong 3 8
  end
  ret shl ulong 217 16
end

fn lx_opkind p ulong c2 ulong to ulong
  if eq p 124
    if eq c2 124
      ret 3
    end
    ret 2
  end
  if eq p 38
    if eq c2 38
      ret 4
    end
    ret 227
  end
  if eq p 59
    ret 5
  end
  if eq p 60
    if eq c2 38
      ret 11
    end
    ret 6
  end
  if eq p 62
    if eq c2 62
      ret 8
    end
    if eq c2 38
      ret 10
    end
    ret 7
  end
  ret 217
end

fn lx_fail w edit ulong * code ulong off ulong to ulong
  put w OSH_S_ERR_CODE code
  put w OSH_S_ERR_OFF off
  put w OSH_S_PHASE 255
  ret code
end

fn lx_emit_tok w edit ulong * hdr ulong s ulong n ulong aux ulong to ulong
  t = get w OSH_LX_NTOK
  if ge t OSH_TOKEN_CAP
    ret lx_fail w 202 s
  end
  b = add OSH_TOKENS mul t 4
  put w b hdr
  put w add b 1 s
  put w add b 2 n
  put w add b 3 aux
  put w OSH_LX_NTOK add t 1
  ret 0
end

fn lx_lone inp view uchar * s ulong e ulong to ulong
  i = s
  n = ulong 0
  v = ulong 0
  while and lt i e lt n 2 bound 4096
    is_cont = ulong 0
    if eq ulong get inp i 92
      if lt add i 1 e
        if eq ulong get inp add i 1 10
          is_cont = 1
        end
      end
    end
    if eq is_cont 1
      i = add i 2
    else
      n = add n 1
      v = ulong get inp i
      i = add i 1
    end
  end
  if ne n 1
    ret 0
  end
  ret v
end

fn lx_group_check inp view uchar * w edit ulong * s ulong e ulong to ulong
  if ne and get w OSH_LX_WFLAGS 65503 0
    ret 0
  end
  if ne get w OSH_LX_EQPOS 0
    ret 0
  end
  t = get w OSH_LX_NTOK
  cs = ulong 0
  if eq t 0
    cs = 1
  end
  if gt t 0
    pk = and get w add OSH_TOKENS mul sub t 1 4 255
    if eq pk 9
      cs = 1
    end
    if and ge pk 2 le pk 5
      cs = 1
    end
  end
  if eq cs 0
    ret 0
  end
  v = lx_lone inp s e
  if or eq v 123 eq v 125
    ret lx_fail w 236 s
  end
  ret 0
end

fn lx_emit_word inp view uchar * w edit ulong * e ulong to ulong
  s = get w OSH_LX_WS
  gc = lx_group_check inp w s e
  if ne gc 0
    ret gc
  end
  f = get w OSH_LX_WFLAGS
  eqp = get w OSH_LX_EQPOS
  if ne eqp 0
    f = or f 16
  end
  ns = get w OSH_LX_NSEG
  if gt ns 255
    ns = 255
  end
  hdr = or ulong 1 shl f 8
  hdr = or hdr shl ns 24
  hdr = or hdr shl get w OSH_LX_WLINE 32
  ret lx_emit_tok w hdr s sub e s eqp
end

fn lx_emit_nl w edit ulong * i ulong to ulong
  hdr = or ulong 9 shl add get w OSH_LX_LINE 1 32
  ret lx_emit_tok w hdr i 1 0
end

fn lx_iomerge inp view uchar * w edit ulong * ws ulong to ulong
  t = get w OSH_LX_NTOK
  if eq t 0
    ret 0
  end
  b = add OSH_TOKENS mul sub t 1 4
  if ne and get w b 4294959103 1
    ret 0
  end
  if ne add get w add b 1 get w add b 2 ws
    ret 0
  end
  if ne get w OSH_LX_ALLDIG 1
    ret 0
  end
  v = lx_lone inp get w add b 1 ws
  if eq v 0
    ret 100
  end
  d = sub v 48
  if gt d 2
    ret 100
  end
  ret add d 1
end

fn lx_fdvar_scan inp view uchar * s ulong e ulong to ulong
  i = s
  n = ulong 0
  ok = ulong 1
  last = ulong 0
  while and lt i e eq ok 1 bound 4096
    is_cont = ulong 0
    if eq ulong get inp i 92
      if lt add i 1 e
        if eq ulong get inp add i 1 10
          is_cont = 1
        end
      end
    end
    if eq is_cont 1
      i = add i 2
    else
      c = ulong get inp i
      if eq n 0
        if ne c 123
          ok = 0
        end
      else
        if eq last 125
          ok = 0
        end
        k = lx_cls c
        if ne c 125
          if ne k 12
            if not and eq k 16 gt n 1
              ok = 0
            end
          end
        end
        if and eq c 125 lt n 2
          ok = 0
        end
      end
      last = c
      n = add n 1
      i = add i 1
    end
  end
  if and eq ok 1 and eq last 125 ge n 3
    ret 1
  end
  ret 0
end

fn lx_fdvar inp view uchar * w edit ulong * ws ulong to ulong
  t = get w OSH_LX_NTOK
  if eq t 0
    ret 0
  end
  b = add OSH_TOKENS mul sub t 1 4
  if ne and get w b 255 1
    ret 0
  end
  fl = and shr get w b 8 65535
  if and ne fl 0 ne fl 32
    ret 0
  end
  s = get w add b 1
  e = add s get w add b 2
  if ne e ws
    ret 0
  end
  ret lx_fdvar_scan inp s e
end

fn lx_emit_op_redir inp view uchar * w edit ulong * kind ulong oe ulong to ulong
  ws = get w OSH_LX_WS
  m = lx_iomerge inp w ws
  if eq m 100
    ret lx_fail w 232 ws
  end
  if eq m 0
    if eq lx_fdvar inp w ws 1
      t1 = sub get w OSH_LX_NTOK 1
      tb = add OSH_TOKENS mul t1 4
      ret lx_fail w 250 get w add tb 1
    end
    ret 1
  end
  t2 = sub get w OSH_LX_NTOK 1
  b = add OSH_TOKENS mul t2 4
  put w b add sub get w b 1 kind
  put w add b 2 sub oe get w add b 1
  put w add b 3 sub m 1
  ret 0
end

fn lx_emit_op inp view uchar * w edit ulong * kind ulong oe ulong to ulong
  ws = get w OSH_LX_WS
  if ge kind 200
    ret lx_fail w kind ws
  end
  aux = ulong 0
  if or eq kind 7 or eq kind 8 eq kind 10
    aux = 1
  end
  is_red = ulong 0
  if and ge kind 6 le kind 8
    is_red = 1
  end
  if or eq kind 10 eq kind 11
    is_red = 1
  end
  if eq is_red 1
    rr = lx_emit_op_redir inp w kind oe
    if ne rr 1
      ret rr
    end
  end
  hdr = or kind shl get w OSH_LX_WLINE 32
  ret lx_emit_tok w hdr ws sub oe ws aux
end

fn lx_track w edit ulong * st ulong nst ulong k ulong i ulong to void
  ws = get w OSH_LX_WS
  if eq get w OSH_LX_NAMEOK 1
    if eq st 4
      if ne k 2
        put w OSH_LX_NAMEOK 0
      end
    else
      if or ne st 1 ne k 5
        is_ok = ulong 0
        if eq k 12
          is_ok = 1
        end
        if and eq k 16 gt i ws
          is_ok = 1
        end
        if eq is_ok 0
          if and eq k 13 and gt i ws eq nst 1
            put w OSH_LX_EQPOS add i 1
          end
          put w OSH_LX_NAMEOK 0
        end
      end
    end
  end
  if eq get w OSH_LX_ALLDIG 1
    if or ne k 16 ne nst 1
      put w OSH_LX_ALLDIG 0
    end
  end
end

fn lx_brace w edit ulong * c ulong i ulong to ulong
  d = get w OSH_LX_BRD
  pd = get w OSH_LX_PDOT
  put w OSH_LX_PDOT 0
  if eq c 123
    if ge d 62
      ret lx_fail w 246 i
    end
    bit = shl ulong 1 d
    put w OSH_LX_BRM and get w OSH_LX_BRM not bit
    put w OSH_LX_BRD add d 1
    ret 0
  end
  if eq d 0
    ret 0
  end
  if eq c 125
    nd = sub d 1
    put w OSH_LX_BRD nd
    bit = shl ulong 1 nd
    if ne and get w OSH_LX_BRM bit 0
      ret lx_fail w 246 i
    end
    ret 0
  end
  if eq c 44
    bit = shl ulong 1 sub d 1
    put w OSH_LX_BRM or get w OSH_LX_BRM bit
    ret 0
  end
  if eq c 46
    if eq pd 1
      bit = shl ulong 1 sub d 1
      put w OSH_LX_BRM or get w OSH_LX_BRM bit
    else
      put w OSH_LX_PDOT 1
    end
  end
  ret 0
end

fn lx_bname w edit ulong * k ulong p ulong i ulong to ulong
  if eq p 123
    put w OSH_LX_BRN 0
    if eq k 16
      put w OSH_LX_BRN 1
    end
    ret 0
  end
  if eq get w OSH_LX_BRN 1
    if eq k 16
      ret lx_fail w 247 i
    end
    if eq k 12
      ret lx_fail w 224 i
    end
  end
  ret 0
end

fn lx_init_word w edit ulong * act ulong i ulong to void
  b = i
  nm = ulong 1
  if eq act 8
    b = sub i 1
    nm = 0
  end
  put w OSH_LX_WS b
  put w OSH_LX_WLINE add get w OSH_LX_LINE 1
  put w OSH_LX_WFLAGS 0
  put w OSH_LX_NAMEOK nm
  put w OSH_LX_EQPOS 0
  put w OSH_LX_NSEG 0
  put w OSH_LX_ALLDIG nm
  put w OSH_LX_BRD 0
  put w OSH_LX_BRM 0
  put w OSH_LX_PDOT 0
  put w OSH_LX_PLUS 0
  put w OSH_LX_USC 0
end

fn lx_byte_post w edit ulong * r ulong sk ulong c ulong i ulong to ulong
  st = and sk 255
  k = shr sk 8
  if or eq st 8 eq st 9
    if or eq k 12 eq k 16
      p = get w OSH_LX_PREV
      rc = lx_bname w k p i
      if ne rc 0
        ret rc
      end
      put w OSH_LX_USC 0
      if and eq p 123 eq c 95
        put w OSH_LX_USC add i 1
      end
    end
  end
  nst = and r 255
  if or eq st 6 eq st 7
    if eq c 95
      put w OSH_LX_USC add i 1
    end
  end
  if true
    pl = get w OSH_LX_PLUS
    put w OSH_LX_PLUS 0
    if and eq st 1 eq nst 1
      if and eq pl 1 eq k 13
        ret lx_fail w 249 i
      end
      if eq c 43
        if eq get w OSH_LX_NAMEOK 1
          if gt i get w OSH_LX_WS
            put w OSH_LX_PLUS 1
          end
        end
      end
    end
  end
  if true
    wfl = and shr r 24 255
    if ne wfl 0
      put w OSH_LX_WFLAGS or get w OSH_LX_WFLAGS wfl
      if ne and wfl 3 0
        put w OSH_LX_NSEG add get w OSH_LX_NSEG 1
      end
    end
  end
  if and ge nst 1 le nst 9
    lx_track w st nst k i
  end
  do_br = ulong 0
  if eq nst 1
    if or eq st 0 eq st 1
      do_br = 1
    end
    if or eq st 6 eq st 11
      do_br = 1
    end
  end
  if eq do_br 1
    rc = lx_brace w c i
    if ne rc 0
      ret rc
    end
  else
    put w OSH_LX_PDOT 0
  end
  put w OSH_LX_STATE nst
  put w OSH_LX_MID 1
  if eq and shr r 8 255 6
    put w OSH_LX_MID 0
  end
  if eq c 10
    put w OSH_LX_LINE add get w OSH_LX_LINE 1
  end
  put w OSH_LX_PREV c
  put w OSH_LX_PO i
  ret 0
end

fn lx_byte_act inp view uchar * w edit ulong * skc ulong i ulong to ulong
  p = get w OSH_LX_PREV
  r = lx_step and skc 255 and shr skc 8 255 shr skc 16 p
  if ne and shr r 16 255 0
    ret lx_fail w and shr r 16 255 i
  end
  act = and shr r 8 255
  if eq act 2
    rc = lx_emit_word inp w i
    if ne rc 0
      ret rc
    end
    r = lx_step 0 and shr skc 8 255 shr skc 16 p
  end
  if eq act 3
    rc = lx_emit_op inp w lx_opkind p 0 add get w OSH_LX_PO 1
    if ne rc 0
      ret rc
    end
    r = lx_step 0 and shr skc 8 255 shr skc 16 p
  end
  if ne and shr r 16 255 0
    ret lx_fail w and shr r 16 255 i
  end
  act = and shr r 8 255
  if eq act 4
    rc = lx_emit_op inp w lx_opkind p shr skc 16 add i 1
    if ne rc 0
      ret rc
    end
  end
  if eq act 6
    rc = lx_emit_nl w i
    if ne rc 0
      ret rc
    end
  end
  if eq act 7
    put w OSH_LX_WS i
    put w OSH_LX_WLINE add get w OSH_LX_LINE 1
  end
  if or eq act 1 eq act 8
    lx_init_word w act i
  end
  ret lx_byte_post w r and skc 65535 shr skc 16 i
end

fn lx_byte inp view uchar * in_len ulong w edit ulong * i ulong to ulong
  c = ulong get inp i
  st = get w OSH_LX_STATE
  if eq get w OSH_LX_CONT 1
    put w OSH_LX_CONT 0
    if or eq st 1 eq st 3
      put w OSH_LX_WFLAGS or get w OSH_LX_WFLAGS 32
    end
    if and ge st 6 le st 9
      put w OSH_LX_WFLAGS or get w OSH_LX_WFLAGS 32
    end
    put w OSH_LX_LINE add get w OSH_LX_LINE 1
    put w OSH_LX_MID 1
    ret 0
  end
  k = lx_cls c
  if eq c 92
    lit_bs = ulong 0
    if or eq st 2 or eq st 4 eq st 5
      lit_bs = 1
    end
    if or eq st 10 eq st 12
      lit_bs = 1
    end
    if eq lit_bs 0
      if lt add i 1 in_len
        if eq ulong get inp add i 1 10
          put w OSH_LX_CONT 1
          ret 0
        end
      else
        if eq get w OSH_S_EOI 0
          ret 99
        end
        k = 15
      end
    end
  end
  if and eq st 1 eq k 17
    eqp = get w OSH_LX_EQPOS
    if ne eqp 0
      p = get w OSH_LX_PREV
      if eq p 58
        k = 18
      end
      if eq p 61
        if eq eqp add get w OSH_LX_PO 1
          k = 18
        end
      end
    end
  end
  if ne c 0
    usc = get w OSH_LX_USC
    if ne usc 0
      if or eq st 1 eq st 3
        if or eq k 12 eq k 16
          put w OSH_LX_USC 0
        else
          ret lx_fail w 225 sub usc 1
        end
      end
      if and or eq st 8 eq st 9 eq k 11
        ret lx_fail w 225 sub usc 1
      end
    end
  end
  skc = or st or shl k 8 shl c 16
  ret lx_byte_act inp w skc i
end

fn lx_chunk inp view uchar * in_len ulong w edit ulong * to ulong
  i = get w OSH_S_CURSOR
  n = ulong 0
  rc = ulong 0
  while and lt i in_len and lt n OSH_LEX_BUDGET eq rc 0 bound OSH_LEX_BUDGET
    if ge i OSH_LINE_CAP
      rc = lx_fail w 201 OSH_LINE_CAP
    else
      rc = lx_byte inp in_len w i
      if eq rc 0
        i = add i 1
        n = add n 1
        put w OSH_S_CURSOR i
      end
    end
  end
  ret rc
end

fn osh_abi_check w view ulong * wn ulong to ulong
  if lt wn 2
    ret 216
  end
  if ne get w OSH_S_MAGIC OSH_ABI_MAGIC
    ret 214
  end
  if ne get w OSH_S_VERSION OSH_ABI_VERSION
    ret 215
  end
  if lt wn OSH_WS_CELLS
    ret 213
  end
  j = OSH_S_RESERVED
  while lt j 64 bound 64
    if ne get w j 0
      ret 217
    end
    j = add j 1
  end
  if gt get w OSH_S_EOI 1
    ret 217
  end
  ret 0
end

fn lx_flush inp view uchar * in_len ulong w edit ulong * to ulong
  st = get w OSH_LX_STATE
  if or eq st 0 eq st 10
    ret 0
  end
  usc = get w OSH_LX_USC
  if and ne usc 0 or eq st 1 eq st 3
    ret lx_fail w 225 sub usc 1
  end
  if or eq st 1 eq st 6
    rc = lx_emit_word inp w in_len
    if ne rc 0
      ret rc
    end
    put w OSH_LX_STATE 0
    ret 0
  end
  if eq st 11
    rc2 = lx_emit_op inp w lx_opkind get w OSH_LX_PREV 0 add get w OSH_LX_PO 1
    if ne rc2 0
      ret rc2
    end
    put w OSH_LX_STATE 0
    ret 0
  end
  ret lx_fail w 248 in_len
end

fn osh_lex_run inp view uchar * in_len ulong w edit ulong * wn ulong to ulong
  ac = osh_abi_check w wn
  if ne ac 0
    ret ac
  end
  if eq get w OSH_S_PHASE 255
    ret get w OSH_S_ERR_CODE
  end
  if gt get w OSH_S_CURSOR in_len
    ret 216
  end
  put w OSH_LX_DONE 0
  rc = lx_chunk inp in_len w
  if eq rc 99
    ret 100
  end
  if ne rc 0
    ret rc
  end
  if lt get w OSH_S_CURSOR in_len
    ret 101
  end
  if and eq get w OSH_S_EOI 1 ne get w OSH_LX_MID 0
    fr = lx_flush inp in_len w
    if ne fr 0
      ret fr
    end
    put w OSH_LX_MID 0
  end
  if eq get w OSH_LX_MID 0
    put w OSH_LX_DONE 1
    ret 0
  end
  ret 100
end

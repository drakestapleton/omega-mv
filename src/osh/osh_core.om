note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/osh/host/osh_req.c:
note POSIX identifier validator, OSH request header validator (magic/version/
note reserved/bounds), and command reserved-cell zero validator.
om2

fn osh_is_start c ulong to ulong
  if eq c 95
    ret 1
  end
  if and ge c 65 le c 90
    ret 1
  end
  if and ge c 97 le c 122
    ret 1
  end
  ret 0
end

export fn osh_om_name_valid s view uchar * n ulong to ulong
  if eq n 0
    ret 0
  end
  if eq osh_is_start ulong get s 0 0
    ret 0
  end
  i = ulong 1
  while lt i n
    c = ulong get s i
    ok = osh_is_start c
    if and ge c 48 le c 57
      ok = 1
    end
    if eq ok 0
      ret 0
    end
    i = add i 1
  end
  ret 1
end

export fn osh_om_check_req_hdr rec view ulong * nrec ulong nout ulong has_out ulong to ulong
  if lt nrec 8
    ret 216
  end
  if ne get rec 0 0x4f524551
    ret 214
  end
  if ne get rec 5 1
    ret 215
  end
  if or ne get rec 6 0 ne get rec 7 0
    ret 217
  end
  if ne and get rec 3 0xfffffffffffffffe 0
    ret 217
  end
  ncmds = get rec 1
  conn = get rec 2
  used = get rec 4
  if or lt ncmds 1 or gt ncmds 8 gt conn 3
    ret 218
  end
  if lt nrec add 8 mul ncmds 164
    ret 216
  end
  if gt used 8192
    ret 218
  end
  if gt used 0
    if or eq has_out 0 lt nout used
      ret 216
    end
  end
  ret 0
end

fn osh_zero_cells b view ulong * start ulong stop ulong to ulong
  i = start
  while lt i stop
    if ne get b i 0
      ret 217
    end
    i = add i 1
  end
  ret 0
end

export fn osh_om_check_cmd_reserved b view ulong * na ulong ns ulong nr ulong to ulong
  if ne osh_zero_cells b add mul na 2 4 68 0
    ret 217
  end
  if ne osh_zero_cells b add mul ns 4 68 132 0
    ret 217
  end
  ret osh_zero_cells b add mul nr 4 132 164
end

note Map OSH_OP_* (1=SPAWN, 2=CHDIR, 3=OPEN_WRITE, 4=OPEN_READ) to RX_RIGHT_*.
export fn osh_om_op_right op ulong to ulong
  if eq op 1
    ret 4
  end
  if eq op 3
    ret 2
  end
  ret 1
end

note Map RX_CAP_ERR_* to OSH_E_*.
export fn osh_om_map_cap_rc rc long to long
  if eq rc 0
    ret 0
  end
  if eq rc -2
    ret 3
  end
  if or eq rc -3 or eq rc -4 or eq rc -8 eq rc -9
    ret 2
  end
  ret 1
end

note Check whether canonical path is under canonical prefix.
export fn osh_om_path_under pref view uchar * np ulong path view uchar * npath ulong to ulong
  if eq np 0
    ret 0
  end
  if and eq np 1 eq get pref 0 uchar 47
    ret 1
  end
  if lt npath np
    ret 0
  end
  for i ulong np bound 4096
    if ne get pref i get path i
      ret 0
    end
  end
  if eq npath np
    ret 1
  end
  if eq get path np uchar 47
    ret 1
  end
  ret 0
end

note Validate OshBinding domain (must be 2) and principal_id[4..31] == 0.
note Returns >= 0 (u32 subject) on ok, or negative (-OSH_E_*) on refusal.
export fn osh_om_check_binding domain ulong pid view uchar 32 to long
  if ne domain 2
    ret -12
  end
  for i ulong 28
    if ne get pid add i 4 uchar 0
      ret -1
    end
  end
  s = ulong get pid 0
  s = or s shl ulong get pid 1 8
  s = or s shl ulong get pid 2 16
  s = or s shl ulong get pid 3 24
  ret long s
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/osh/host/osh_codes.c (refusal code names 201..250).
om2

text osh_code_names "201=CAP_LINE\n202=CAP_TOKENS\n203=CAP_CMDS\n204=CAP_PIPELINES\n205=CAP_PIPE_LEN\n206=CAP_WORDS\n207=CAP_ASSIGNS\n208=CAP_REDIRS\n209=CAP_FIELDS\n210=CAP_OUT\n211=CAP_VALUE\n212=CAP_VARREQ\n213=WORKSPACE_SIZE\n214=ABI_MAGIC\n215=ABI_VERSION\n216=ABI_LENGTH\n217=ABI_RESERVED\n218=REQ_FIELD\n220=NUL_BYTE\n221=BACKTICK\n222=GLOB\n223=TILDE\n224=PARAM_OP\n225=SPECIAL_PARAM\n226=CMDSUB\n227=BACKGROUND\n228=SUBSHELL\n229=HEREDOC\n230=CASEEND\n231=REDIR_OTHER\n232=FD_RANGE\n233=IF_COMPOUND\n234=LOOP\n235=CASE\n236=GROUP\n237=FUNCTION\n238=NEGATION\n239=UNSUPPORTED_BUILTIN\n240=IFS_ASSIGN\n241=SYNTAX_EMPTY_CMD\n242=SYNTAX_REDIR_TARGET\n243=AMBIGUOUS_REDIRECT\n244=VALUE_NUL\n245=VALUE_GLOB\n246=BRACE_EXPANSION\n247=POSITIONAL_RANGE\n248=SYNTAX_EOF\n249=APPEND_ASSIGN\n250=FD_VARIABLE\n"

note Copy name of refusal code into dst[0..cap), return byte length (0 if unknown).
fn osh_code_name code ulong dst edit uchar * cap ulong to ulong
  i = ulong 0
  n = len osh_code_names
  while lt i n bound 4096
    v = ulong 0
    while lt i n bound 16
      c = ulong get osh_code_names i
      if eq c 61
        i = add i 1
        break
      end
      v = add mul v 10 sub c 48
      i = add i 1
    end
    st = i
    while lt i n bound 64
      if eq ulong get osh_code_names i 10
        break
      end
      i = add i 1
    end
    ln = sub i st
    if eq v code
      k = ulong 0
      while and lt k ln lt k cap bound 64
        put dst k get osh_code_names add st k
        k = add k 1
      end
      ret k
    end
    if lt i n
      i = add i 1
    end
  end
  ret 0
end

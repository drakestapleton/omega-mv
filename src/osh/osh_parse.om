note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/osh/osh_parse.osc.in (bounded, resumable, non-recursive shell parser).
note Requires src/osh/osh_layout.om and src/osh/osh_lex.om (for osh_abi_check) before this file.
om2

fn px_fail w edit ulong * code ulong off ulong to ulong
  put w OSH_S_ERR_CODE code
  put w OSH_S_ERR_OFF off
  put w OSH_S_PHASE 255
  ret code
end

fn px_pack8 inp view uchar * s ulong e ulong to ulong
  i = s
  n = ulong 0
  v = ulong 0
  while lt i e bound 4096
    is_cont = ulong 0
    if eq ulong get inp i 92
      if lt add i 1 e
        if eq ulong get inp add i 1 10
          is_cont = 1
        end
      end
    end
    if eq is_cont 1
      i = add i 2
    else
      n = add n 1
      if le n 8
        v = or shl v 8 ulong get inp i
      end
      i = add i 1
    end
  end
  if gt n 8
    ret 0
  end
  ret v
end

fn px_reserved v ulong to ulong
  if or eq v 0x6966 or eq v 0x7468656e or eq v 0x656c6966 or eq v 0x656c7365 eq v 0x6669
    ret 233
  end
  if or eq v 0x666f72 or eq v 0x7768696c65 or eq v 0x756e74696c eq v 0x646f
    ret 234
  end
  if or eq v 0x646f6e65 or eq v 0x696e eq v 0x73656c656374
    ret 234
  end
  if or eq v 0x63617365 eq v 0x65736163
    ret 235
  end
  if eq v 0x66756e6374696f6e
    ret 237
  end
  if eq v 0x21
    ret 238
  end
  if or eq v 0x74696d65 eq v 0x636f70726f63
    ret 239
  end
  ret 0
end

fn px_alldig inp view uchar * s ulong n ulong to ulong
  i = ulong 0
  r = ulong 1
  while and lt i n eq r 1 bound 4096
    c = ulong get inp add s i
    if or lt c 48 gt c 57
      r = 0
    end
    i = add i 1
  end
  ret r
end

fn px_dup_check inp view uchar * hdr ulong s ulong n ulong to ulong
  if ne and shr hdr 8 65535 0
    ret 231
  end
  if eq n 1
    c = ulong get inp s
    if and ge c 48 le c 50
      ret 0
    end
  end
  if eq px_alldig inp s n 1
    ret 232
  end
  ret 231
end

fn px_new_cmd w edit ulong * t ulong s ulong to ulong
  pc = get w OSH_PX_PCMDS
  if ge pc OSH_CAP_PIPE_LEN
    ret px_fail w 205 s
  end
  np = get w OSH_PX_NPIPE
  if and eq pc 0 ge np OSH_CAP_PIPES
    ret px_fail w 204 s
  end
  c = get w OSH_PX_NCMD
  if ge c OSH_CAP_CMDS
    ret px_fail w 203 s
  end
  p = np
  if eq pc 0
    pb = add OSH_PIPES mul np 4
    put w pb c
    put w add pb 1 0
    put w add pb 2 0
    put w add pb 3 t
    put w OSH_PX_NPIPE add np 1
  else
    p = sub np 1
  end
  cb = add OSH_CMDS mul c 8
  put w cb t
  put w add cb 1 0
  put w add cb 2 0
  put w add cb 3 0
  put w add cb 4 0
  put w add cb 5 p
  put w add cb 6 pc
  put w add cb 7 0
  put w add add OSH_PIPES mul p 4 1 add pc 1
  put w OSH_PX_PCMDS add pc 1
  put w OSH_PX_NCMD add c 1
  put w OSH_PX_ANYW 0
  ret 0
end

fn px_end_cmd w edit ulong * te ulong to void
  cb = add OSH_CMDS mul sub get w OSH_PX_NCMD 1 8
  put w add cb 1 te
end

fn px_end_pipe w edit ulong * conn ulong to void
  pb = add OSH_PIPES mul sub get w OSH_PX_NPIPE 1 4
  put w add pb 2 conn
  put w OSH_PX_PCMDS 0
end

fn px_on_word inp view uchar * w edit ulong * t ulong hdr ulong to ulong
  b = add OSH_TOKENS mul t 4
  f = and shr hdr 8 65535
  s = get w add b 1
  cb = add OSH_CMDS mul sub get w OSH_PX_NCMD 1 8
  if eq get w OSH_PX_ANYW 0
    if ne and f 16 0
      if eq px_pack8 inp s sub get w add b 3 1 0x494653
        ret px_fail w 240 s
      end
      na = get w add cb 2
      if ge na OSH_CAP_ASSIGNS
        ret px_fail w 207 s
      end
      put w add cb 2 add na 1
      ret 0
    end
    if eq and f 65503 0
      rc = px_reserved px_pack8 inp s add s get w add b 2
      if ne rc 0
        ret px_fail w rc s
      end
    end
  end
  nw = get w add cb 3
  if ge nw OSH_CAP_WORDS
    ret px_fail w 206 s
  end
  put w add cb 3 add nw 1
  put w OSH_PX_ANYW 1
  ret 0
end

fn px_on_target inp view uchar * w edit ulong * t ulong hdr ulong to ulong
  b = add OSH_TOKENS mul t 4
  s = get w add b 1
  if ne and hdr 255 1
    ret px_fail w 242 s
  end
  rk = get w OSH_PX_RKIND
  if or eq rk 10 eq rk 11
    rc = px_dup_check inp hdr s get w add b 2
    if ne rc 0
      ret px_fail w rc s
    end
  end
  put w OSH_PX_STATE 2
  ret 0
end

fn px_step inp view uchar * w edit ulong * t ulong to ulong
  b = add OSH_TOKENS mul t 4
  hdr = get w b
  k = and hdr 255
  s = get w add b 1
  st = get w OSH_PX_STATE
  if eq st 3
    ret px_on_target inp w t hdr
  end
  if eq k 9
    if eq st 2
      px_end_cmd w t
      px_end_pipe w 1
      put w OSH_PX_STATE 4
      ret 1
    end
    if eq st 0
      put w OSH_PX_STATE 4
      ret 1
    end
    ret 0
  end
  if and ge k 2 le k 5
    if ne st 2
      ret px_fail w 241 s
    end
    px_end_cmd w t
    put w OSH_PX_STATE 1
    if eq k 2
      ret 0
    end
    conn = ulong 1
    if eq k 4
      conn = 2
    end
    if eq k 3
      conn = 3
    end
    px_end_pipe w conn
    if eq k 5
      put w OSH_PX_STATE 0
    end
    ret 0
  end
  if or eq st 0 eq st 1
    rc = px_new_cmd w t s
    if ne rc 0
      ret rc
    end
    put w OSH_PX_STATE 2
  end
  if eq k 1
    ret px_on_word inp w t hdr
  end
  c1 = sub get w OSH_PX_NCMD 1
  cb = add OSH_CMDS mul c1 8
  nr = get w add cb 4
  if ge nr OSH_CAP_REDIRS
    ret px_fail w 208 s
  end
  put w add cb 4 add nr 1
  put w OSH_PX_RKIND k
  put w OSH_PX_STATE 3
  ret 0
end

fn px_at_end in_len ulong w edit ulong * to ulong
  st = get w OSH_PX_STATE
  if eq st 0
    if and eq get w OSH_S_EOI 1 gt get w OSH_PX_NCMD 0
      put w OSH_PX_STATE 4
    end
    ret 0
  end
  if eq get w OSH_S_EOI 0
    ret 100
  end
  if eq st 2
    px_end_cmd w get w OSH_LX_NTOK
    px_end_pipe w 0
    put w OSH_PX_STATE 4
    ret 0
  end
  if eq st 3
    ret px_fail w 242 in_len
  end
  ret px_fail w 248 in_len
end

fn osh_parse_run inp view uchar * in_len ulong w edit ulong * wn ulong to ulong
  ac = osh_abi_check w wn
  if ne ac 0
    ret ac
  end
  if eq get w OSH_S_PHASE 255
    ret get w OSH_S_ERR_CODE
  end
  if ne get w OSH_LX_DONE 1
    ret 217
  end
  if gt get w OSH_PX_STATE 4
    ret 217
  end
  if eq get w OSH_PX_STATE 4
    ret 0
  end
  ntok = get w OSH_LX_NTOK
  t = get w OSH_PX_TOK
  if gt t ntok
    ret 217
  end
  n = ulong 0
  rc = ulong 0
  while lt n OSH_PARSE_BUDGET bound OSH_PARSE_BUDGET
    if ge t ntok
      break
    end
    rc = px_step inp w t
    if lt rc 2
      t = add t 1
      n = add n 1
      put w OSH_PX_TOK t
    end
    if ne rc 0
      break
    end
  end
  if eq rc 1
    ret 0
  end
  if ge rc 2
    ret rc
  end
  if lt t ntok
    ret 101
  end
  ret px_at_end in_len w
end

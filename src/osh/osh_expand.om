note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/osh/osh_expand.osc.in (bounded, resumable expander).
note Requires src/osh/osh_layout.om and src/osh/osh_lex.om (for osh_abi_check) before this file.
om2

fn ex_fail w edit ulong * code ulong off ulong to ulong
  put w OSH_S_ERR_CODE code
  put w OSH_S_ERR_OFF off
  put w OSH_S_PHASE 255
  ret code
end

fn ex_werr w edit ulong * code ulong to ulong
  tb = add OSH_TOKENS mul get w OSH_EX_TOK 4
  ret ex_fail w code get w add tb 1
end

fn ex_nch c ulong first ulong to ulong
  if and ge c 65 le c 90
    ret 1
  end
  if and ge c 97 le c 122
    ret 1
  end
  if eq c 95
    ret 1
  end
  if and eq first 0 and ge c 48 le c 57
    ret 1
  end
  ret 0
end

fn ex_nend inp view uchar * p ulong e ulong to ulong
  i = add p 1
  while lt i e bound 4096
    if eq ex_nch ulong get inp i 0 0
      break
    end
    i = add i 1
  end
  ret i
end

fn ex_dollar inp view uchar * w edit ulong * p ulong e ulong to ulong
  if ge add p 1 e
    ret 0
  end
  c = ulong get inp add p 1
  put w OSH_S_VR_LEN 0
  put w OSH_S_VR_A 0
  if eq ex_nch c 1 1
    n = ex_nend inp add p 1 e
    put w OSH_EX_RK 1
    put w OSH_S_VR_A add p 1
    put w OSH_S_VR_LEN sub sub n p 1
    put w OSH_EX_NEXT n
    ret 1
  end
  if and ge c 48 le c 57
    put w OSH_EX_RK 3
    put w OSH_S_VR_A sub c 48
    put w OSH_EX_NEXT add p 2
    ret 1
  end
  if or eq c 63 or eq c 35 or eq c 64 eq c 42
    rk = ulong 2
    if eq c 35
      rk = 4
    end
    if eq c 64
      rk = 8
    end
    if eq c 42
      rk = 9
    end
    put w OSH_EX_RK rk
    put w OSH_EX_NEXT add p 2
    ret 1
  end
  if and eq c 123 lt add p 3 e
    d = ulong get inp add p 2
    if and ge d 48 le d 57
      if ne ulong get inp add p 3 125
        ret 0
      end
      put w OSH_EX_RK 3
      put w OSH_S_VR_A sub d 48
      put w OSH_EX_NEXT add p 4
      ret 1
    end
    if eq ex_nch d 1 1
      n2 = ex_nend inp add p 2 e
      if lt n2 e
        if eq ulong get inp n2 125
          put w OSH_EX_RK 1
          put w OSH_S_VR_A add p 2
          put w OSH_S_VR_LEN sub sub n2 p 2
          put w OSH_EX_NEXT add n2 1
          ret 1
        end
      end
    end
  end
  ret 0
end

fn ex_cbase w view ulong * to ulong
  ret add add OSH_REQUEST 8 mul get w OSH_EX_CMD OSH_REQ_CMD_CELLS
end

fn ex_fopen w edit ulong * to void
  if eq get w OSH_EX_FOPEN 0
    put w OSH_EX_FOPEN 1
    put w OSH_EX_FSTART get w OSH_EX_OUT
  end
end

fn ex_fclose w edit ulong * to ulong
  if eq get w OSH_EX_FOPEN 0
    ret 0
  end
  put w OSH_EX_FOPEN 0
  wm = get w OSH_EX_WM
  if eq wm 2
    ret 0
  end
  off = get w OSH_EX_FSTART
  ln = sub get w OSH_EX_OUT off
  cb = ex_cbase w
  if or eq wm 1 eq wm 4
    n = get w cb
    if ge n OSH_CAP_FIELDS
      ret ex_werr w 209
    end
    if eq n 0
      tb = add OSH_TOKENS mul get w OSH_EX_TOK 4
      put w OSH_EX_A0 get w add tb 1
    end
    put w add add cb 4 mul n 2 off
    put w add add cb 5 mul n 2 ln
    put w cb add n 1
    ret 0
  end
  if ne get w OSH_EX_WNF 0
    ret ex_werr w 243
  end
  put w OSH_EX_WNF 1
  e = add add cb 132 mul sub get w add cb 2 1 4
  put w add e 2 off
  put w add e 3 ln
  ret 0
end

fn ex_lit w edit ulong * c ulong to ulong
  o = get w OSH_EX_OUT
  if ge o OSH_CAP_OUT
    ret ex_werr w 210
  end
  ex_fopen w
  put w add OSH_OUT o c
  put w OSH_EX_OUT add o 1
  ret 0
end

fn ex_sbyte w edit ulong * c ulong to ulong
  if or eq c 32 or eq c 9 eq c 10
    ret ex_fclose w
  end
  if or eq c 42 or eq c 63 eq c 91
    ret ex_werr w 245
  end
  ret ex_lit w c
end

fn ex_request w edit ulong * kind ulong to ulong
  n = get w OSH_EX_NVREQ
  if ge n OSH_CAP_VARREQ
    ret ex_werr w 212
  end
  put w OSH_EX_NVREQ add n 1
  put w OSH_S_VR_KIND kind
  put w OSH_S_VR_SEQ add get w OSH_S_VR_SEQ 1
  put w OSH_STAGING 2
  put w OSH_EX_PH 2
  ret 102
end

fn ex_eq_out2 inp view uchar * w view ulong * ns_nl ulong out_off ulong to ulong
  ns = and ns_nl 0xffffffff
  nl = shr ns_nl 32
  base_out = add OSH_OUT out_off
  i = ulong 0
  while lt i nl bound 4096
    if ne ulong get inp add ns i get w add base_out i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn ex_find_prior inp view uchar * w view ulong * ns ulong nl ulong to ulong
  if true
    pb = add OSH_PIPES mul get w OSH_EX_PIPE 4
    cm = add OSH_CMDS mul add get w pb get w OSH_EX_CMD 8
    if ne get w add cm 3 0
      ret 0
    end
  end
  cb = ex_cbase w
  na = get w add cb 1
  hit = ulong 0
  j = ulong 0
  while lt add j 1 na bound 16
    e = add add cb 68 mul j 4
    if eq get w add e 1 nl
      if eq ex_eq_out2 inp w or ns shl nl 32 get w e 1
        hit = e
      end
    end
    j = add j 1
  end
  ret hit
end

fn ex_begin_ref inp view uchar * w edit ulong * q ulong to ulong
  rk = get w OSH_EX_RK
  wm = get w OSH_EX_WM
  vm = ulong 0
  if and eq q 0 and ne wm 2 ne wm 4
    vm = 1
  end
  put w OSH_EX_VM vm
  if eq q 2
    if eq rk 8
      put w OSH_EX_DQF or get w OSH_EX_DQF 1
    end
    if eq rk 9
      put w OSH_EX_DQF or get w OSH_EX_DQF 2
    end
  end
  if ge rk 8
    lk = ulong 6
    if eq vm 1
      lk = 5
    end
    if and eq rk 8 and eq q 2 and ne wm 2 ne wm 4
      lk = 7
    end
    put w OSH_EX_RK lk
    ret ex_request w 5
  end
  if and eq rk 1 eq wm 2
    hit = ex_find_prior inp w get w OSH_S_VR_A get w OSH_S_VR_LEN
    if ne hit 0
      vcur = add OSH_OUT get w add hit 2
      put w OSH_EX_VCUR vcur
      put w OSH_EX_VEND add vcur get w add hit 3
      put w OSH_EX_PH 1
      ret 0
    end
  end
  ret ex_request w rk
end

fn ex_answer w edit ulong * to ulong
  f = get w OSH_STAGING
  if gt f 1
    ret 102
  end
  if eq get w OSH_S_VR_KIND 5
    np = get w add OSH_STAGING 2
    put w OSH_EX_NPOS np
    put w OSH_EX_K 1
    if eq np 0
      put w OSH_EX_POS get w OSH_EX_NEXT
      put w OSH_EX_PH 0
      ret 0
    end
    put w OSH_S_VR_A 1
    put w OSH_S_VR_LEN 0
    ret ex_request w 3
  end
  ln = ulong 0
  if eq f 1
    ln = get w add OSH_STAGING 1
  end
  if gt ln OSH_CAP_VALUE
    ret ex_werr w 211
  end
  put w OSH_EX_VCUR add OSH_STAGING 4
  put w OSH_EX_VEND add add OSH_STAGING 4 ln
  put w OSH_EX_PH 1
  if eq get w OSH_EX_RK 7
    ex_fopen w
  end
  ret 0
end

fn ex_vdone w edit ulong * to ulong
  rk = get w OSH_EX_RK
  k = get w OSH_EX_K
  if and ge rk 5 lt k get w OSH_EX_NPOS
    r = ulong 0
    if eq rk 6
      r = ex_lit w 32
    else
      r = ex_fclose w
    end
    if ne r 0
      ret r
    end
    put w OSH_EX_K add k 1
    put w OSH_S_VR_A add k 1
    put w OSH_S_VR_LEN 0
    ret ex_request w 3
  end
  put w OSH_EX_POS get w OSH_EX_NEXT
  put w OSH_EX_PH 0
  ret 0
end

fn ex_xval w edit ulong * to ulong
  cur = get w OSH_EX_VCUR
  if ge cur get w OSH_EX_VEND
    ret ex_vdone w
  end
  c = get w cur
  if or eq c 0 gt c 255
    ret ex_werr w 244
  end
  put w OSH_EX_VCUR add cur 1
  if eq get w OSH_EX_VM 1
    ret ex_sbyte w c
  end
  if eq get w OSH_EX_Q 2
    put w OSH_EX_DQF or get w OSH_EX_DQF 2
  end
  ret ex_lit w c
end

fn ex_wend w edit ulong * to ulong
  r = ex_fclose w
  if ne r 0
    ret r
  end
  wm = get w OSH_EX_WM
  if eq wm 2
    cb = ex_cbase w
    e = add add cb 68 mul sub get w add cb 1 1 4
    put w add e 3 sub get w OSH_EX_OUT get w add e 2
  end
  if and eq wm 3 eq get w OSH_EX_WNF 0
    ret ex_werr w 243
  end
  put w OSH_EX_WM 0
  put w OSH_EX_TOK add get w OSH_EX_TOK 1
  ret 1
end

fn ex_xraw inp view uchar * w edit ulong * to ulong
  tb = add OSH_TOKENS mul get w OSH_EX_TOK 4
  e = add get w add tb 1 get w add tb 2
  p = get w OSH_EX_POS
  if ge p e
    ret ex_wend w
  end
  c = ulong get inp p
  q = get w OSH_EX_Q
  put w OSH_EX_POS add p 1
  if eq q 1
    if eq c 39
      put w OSH_EX_Q 0
      ex_fopen w
      ret 0
    end
    ret ex_lit w c
  end
  if and eq c 92 lt add p 1 e
    d = ulong get inp add p 1
    if eq d 10
      put w OSH_EX_POS add p 2
      ret 0
    end
    if eq q 0
      put w OSH_EX_POS add p 2
      ret ex_lit w d
    end
    is_dqe = ulong 0
    if or eq d 36 eq d 34
      is_dqe = 1
    end
    if or eq d 92 eq d 96
      is_dqe = 1
    end
    if eq is_dqe 1
      put w OSH_EX_POS add p 2
      put w OSH_EX_DQF or get w OSH_EX_DQF 2
      ret ex_lit w d
    end
  end
  if and eq q 2 eq c 34
    put w OSH_EX_Q 0
    f = get w OSH_EX_DQF
    do_open = ulong 0
    if ne and f 2 0
      do_open = 1
    end
    if eq and f 1 0
      do_open = 1
    end
    if eq do_open 1
      ex_fopen w
    end
    put w OSH_EX_DQF 0
    ret 0
  end
  if and eq q 0 eq c 34
    put w OSH_EX_Q 2
    put w OSH_EX_DQF 0
    ret 0
  end
  if and eq q 0 eq c 39
    put w OSH_EX_Q 1
    ret 0
  end
  if eq c 36
    if eq ex_dollar inp w p e 1
      put w OSH_EX_POS p
      ret ex_begin_ref inp w q
    end
  end
  if eq q 2
    put w OSH_EX_DQF or get w OSH_EX_DQF 2
  end
  ret ex_lit w c
end

fn ex_wset w edit ulong * mode ulong pos ulong to void
  put w OSH_EX_WM mode
  put w OSH_EX_PH 0
  put w OSH_EX_POS pos
  put w OSH_EX_Q 0
  put w OSH_EX_FOPEN 0
  put w OSH_EX_DQF 0
  put w OSH_EX_WNF 0
end

fn ex_copy_name inp view uchar * w edit ulong * s_nl ulong o ulong to void
  s = and s_nl 0xffffffff
  nl = shr s_nl 32
  dst_base = add OSH_OUT o
  i = ulong 0
  while lt i nl bound 4096
    put w add dst_base i ulong get inp add s i
    i = add i 1
  end
end

fn ex_start_assign inp view uchar * w edit ulong * tb ulong to ulong
  s = get w add tb 1
  aux = get w add tb 3
  if le aux add s 1
    ret ex_fail w 217 s
  end
  nl = sub sub aux 1 s
  cb = ex_cbase w
  na = get w add cb 1
  if ge na 16
    ret ex_fail w 207 s
  end
  o = get w OSH_EX_OUT
  if gt add o nl OSH_CAP_OUT
    ret ex_fail w 210 s
  end
  ex_copy_name inp w or s shl nl 32 o
  put w OSH_EX_OUT add o nl
  e = add add cb 68 mul na 4
  put w e o
  put w add e 1 nl
  put w add e 2 add o nl
  put w add e 3 0
  put w add cb 1 add na 1
  ex_wset w 2 aux
  ret 0
end

fn ex_redir_kind k ulong to ulong
  if eq k 7
    ret 2
  end
  if eq k 8
    ret 3
  end
  if or eq k 10 eq k 11
    ret 4
  end
  ret 1
end

fn ex_start_redir inp view uchar * w edit ulong * t ulong k ulong to ulong
  tb = add OSH_TOKENS mul t 4
  s = get w add tb 1
  e = ulong 0
  if true
    cb = ex_cbase w
    r = get w add cb 2
    if ge r 8
      ret ex_fail w 208 s
    end
    if ge add t 1 get w OSH_LX_NTOK
      ret ex_fail w 217 s
    end
    if ne and get w add tb 4 255 1
      ret ex_fail w 217 s
    end
    put w add cb 2 add r 1
    e = add add cb 132 mul r 4
  end
  kind = ex_redir_kind k
  put w e kind
  put w add e 1 get w add tb 3
  uoff = get w add tb 5
  if eq kind 4
    d = ulong get inp uoff
    if or lt d 48 gt d 50
      ret ex_fail w 217 s
    end
    put w add e 2 sub d 48
    put w OSH_EX_TOK add t 2
    ret 0
  end
  ex_wset w 3 uoff
  put w OSH_EX_TOK add t 1
  ret 0
end

fn ex_pack8o w view ulong * off ulong n ulong to ulong
  if or eq n 0 gt n 8
    ret 0
  end
  v = ulong 0
  i = ulong 0
  while lt i n bound 8
    v = or shl v 8 get w add add OSH_OUT off i
    i = add i 1
  end
  ret v
end

fn ex_classify v ulong to ulong
  if eq v 0x6364
    ret 1
  end
  if eq v 0x707764
    ret 2
  end
  if eq v 0x7072696e7466
    ret 3
  end
  if eq v 0x6578706f7274
    ret 4
  end
  if eq v 0x756e736574
    ret 5
  end
  if eq v 0x65786974
    ret 6
  end
  if or eq v 0x736574 or eq v 0x6576616c or eq v 0x65786563 or eq v 0x2e eq v 0x736f75726365
    ret 99
  end
  if or eq v 0x74726170 or eq v 0x7368696674 or eq v 0x72656164 eq v 0x72657475726e
    ret 99
  end
  if or eq v 0x627265616b or eq v 0x636f6e74696e7565 eq v 0x6c6f63616c
    ret 99
  end
  if or eq v 0x726561646f6e6c79 or eq v 0x616c696173 eq v 0x77616974
    ret 99
  end
  if or eq v 0x3a or eq v 0x6465636c617265 or eq v 0x74797065736574 or eq v 0x6c6574 eq v 0x636f6d6d616e64
    ret 99
  end
  if or eq v 0x74797065 or eq v 0x756d61736b or eq v 0x68617368 or eq v 0x756c696d6974 eq v 0x6765746f707473
    ret 99
  end
  if or eq v 0x6a6f6273 or eq v 0x7075736864 or eq v 0x706f7064 or eq v 0x64697273 eq v 0x686973746f7279
    ret 99
  end
  if or eq v 0x756e616c696173 or eq v 0x6667 or eq v 0x6267 or eq v 0x6275696c74696e eq v 0x656e61626c65
    ret 99
  end
  if or eq v 0x73686f7074 or eq v 0x6d617066696c65 or eq v 0x74696d6573 or eq v 0x63616c6c6572 eq v 0x6469736f776e
    ret 99
  end
  if or eq v 0x73757370656e64 or eq v 0x6c6f676f7574 or eq v 0x62696e64 or eq v 0x68656c70 eq v 0x636f6d7067656e
    ret 99
  end
  if or eq v 0x636f6d706c657465 or eq v 0x6663 eq v 0x636f6d706f7074
    ret 99
  end
  ret 0
end

fn ex_pipe_ready w edit ulong * to ulong
  pb = add OSH_PIPES mul get w OSH_EX_PIPE 4
  put w OSH_REQUEST OSH_REC_MAGIC
  put w add OSH_REQUEST 1 get w add pb 1
  put w add OSH_REQUEST 2 get w add pb 2
  put w add OSH_REQUEST 3 0
  put w add OSH_REQUEST 4 get w OSH_EX_OUT
  put w add OSH_REQUEST 5 OSH_ABI_VERSION
  put w OSH_EX_ST 2
  ret 103
end

fn ex_cmd_end w edit ulong * to ulong
  cb = ex_cbase w
  if gt get w cb 0
    b = ex_classify ex_pack8o w get w add cb 4 get w add cb 5
    if eq b 99
      ret ex_fail w 239 get w OSH_EX_A0
    end
    o9 = get w add cb 4
    if eq get w add cb 5 9
      if eq ex_pack8o w o9 8 0x7265616461727261
        if eq get w add add OSH_OUT o9 8 0x79
          ret ex_fail w 239 get w OSH_EX_A0
        end
      end
    end
    put w add cb 3 b
  end
  pb = add OSH_PIPES mul get w OSH_EX_PIPE 4
  c = add get w OSH_EX_CMD 1
  if ge c get w add pb 1
    ret ex_pipe_ready w
  end
  put w OSH_EX_CMD c
  put w OSH_EX_TOK get w add OSH_CMDS mul add get w pb c 8
  put w OSH_EX_ANYW 0
  ret 0
end

fn ex_is_export inp view uchar * in_len ulong w view ulong * to ulong
  cb = ex_cbase w
  if eq get w cb 0
    ret 0
  end
  if ne ex_pack8o w get w add cb 4 get w add cb 5 0x6578706f7274
    ret 0
  end
  a = get w OSH_EX_A0
  if ne get w OSH_EX_ANYW add a 1
    ret 0
  end
  if ge add a 6 in_len
    ret 0
  end
  v = ulong 0
  i = ulong 0
  while lt i 6 bound 6
    v = or shl v 8 ulong get inp add a i
    i = add i 1
  end
  if ne v 0x6578706f7274
    ret 0
  end
  d = ulong get inp add a 6
  if or eq d 32 eq d 9
    ret 1
  end
  ret 0
end

fn ex_next_task inp view uchar * in_len ulong w edit ulong * to ulong
  t = get w OSH_EX_TOK
  if true
    pb = add OSH_PIPES mul get w OSH_EX_PIPE 4
    cmb = add OSH_CMDS mul add get w pb get w OSH_EX_CMD 8
    if ge t get w add cmb 1
      ret ex_cmd_end w
    end
  end
  tb = add OSH_TOKENS mul t 4
  hdr = get w tb
  k = and hdr 255
  if eq k 1
    is_as = and shr hdr 8 16
    if ne is_as 0
      if eq get w OSH_EX_ANYW 0
        ret ex_start_assign inp w tb
      end
    end
    m = ulong 1
    if ne is_as 0
      if eq ex_is_export inp in_len w 1
        m = 4
      end
    end
    if eq get w OSH_EX_ANYW 0
      put w OSH_EX_ANYW add get w add tb 1 1
    end
    ex_wset w m get w add tb 1
    ret 0
  end
  if and ge k 6 le k 8
    ret ex_start_redir inp w t k
  end
  if or eq k 10 eq k 11
    ret ex_start_redir inp w t k
  end
  ret ex_fail w 217 get w add tb 1
end

fn ex_pipe_begin w edit ulong * p ulong to void
  pb = add OSH_PIPES mul p 4
  n = add 8 mul get w add pb 1 OSH_REQ_CMD_CELLS
  i = ulong 0
  while lt i n bound 1320
    put w add OSH_REQUEST i 0
    i = add i 1
  end
  put w OSH_EX_CMD 0
  put w OSH_EX_TOK get w add OSH_CMDS mul get w pb 8
  put w OSH_EX_NVREQ 0
  put w OSH_EX_OUT 0
  put w OSH_EX_ANYW 0
  put w OSH_EX_WM 0
  put w OSH_EX_PH 0
  put w OSH_EX_ST 1
end

fn ex_next_pipe w edit ulong * to ulong
  np = get w OSH_PX_NPIPE
  p = get w OSH_EX_PIPE
  go = ulong 0
  while and lt p np eq go 0 bound 16
    go = 1
    if and gt p 0 eq get w OSH_S_NOSKIP 0
      cn = get w add add OSH_PIPES mul sub p 1 4 2
      ls = get w OSH_S_LAST_STATUS
      if and eq cn 2 ne ls 0
        go = 0
      end
      if and eq cn 3 eq ls 0
        go = 0
      end
    end
    if eq go 0
      p = add p 1
    end
  end
  put w OSH_EX_PIPE p
  if ge p np
    put w OSH_EX_ST 3
    ret 104
  end
  ex_pipe_begin w p
  ret 0
end

fn osh_expand_run inp view uchar * in_len ulong w edit ulong * wn ulong to ulong
  ac = osh_abi_check w wn
  if ne ac 0
    ret ac
  end
  if eq get w OSH_S_PHASE 255
    ret get w OSH_S_ERR_CODE
  end
  if ne get w OSH_PX_STATE 4
    ret 217
  end
  if eq get w OSH_EX_INIT 0
    j = ulong 29
    while lt j 34 bound 8
      put w j 0
      j = add j 1
    end
    j = ulong 12
    while lt j 27 bound 16
      if and ne j 17 ne j 25
        put w j 0
      end
      j = add j 1
    end
    put w OSH_EX_INIT 1
  end
  if or gt get w OSH_EX_ST 3 gt get w OSH_EX_PIPE get w OSH_PX_NPIPE
    ret 217
  end
  if eq get w OSH_EX_ST 3
    ret 104
  end
  if eq get w OSH_EX_ST 2
    put w OSH_EX_PIPE add get w OSH_EX_PIPE 1
    put w OSH_EX_ST 0
  end
  if eq get w OSH_EX_ST 0
    nr = ex_next_pipe w
    if ne nr 0
      ret nr
    end
  end
  n = ulong 0
  rc = ulong 0
  while and eq rc 0 lt n OSH_EXP_BUDGET bound OSH_EXP_BUDGET
    if eq get w OSH_EX_WM 0
      rc = ex_next_task inp in_len w
    else
      ph = get w OSH_EX_PH
      if eq ph 1
        rc = ex_xval w
      else
        if eq ph 2
          rc = ex_answer w
        else
          rc = ex_xraw inp w
        end
      end
      if eq rc 1
        rc = 0
      end
    end
    n = add n 1
  end
  if ne rc 0
    ret rc
  end
  ret 101
end

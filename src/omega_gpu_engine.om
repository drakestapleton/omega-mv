text oge_stn_1 "VALIDATE"
text oge_stn_2 "BACKEND_CHECK"
text oge_stn_3 "BLOCKED"
text oge_stn_4 "NOT_IMPLEMENTED"
text oge_stn_5 "OPEN_DEVICE"
text oge_stn_6 "CREATE_CHANNEL"
text oge_stn_7 "ALLOC"
text oge_stn_8 "COPY_IN"
text oge_stn_9 "FILL_POISON"
text oge_stn_10 "BUILD"
text oge_stn_11 "SUBMIT"
text oge_stn_12 "WAIT_MARKER"
text oge_stn_13 "WAIT_MARKER2"
text oge_stn_14 "WAIT_RELEASE_SEMAPHORE"
text oge_stn_15 "BARRIER"

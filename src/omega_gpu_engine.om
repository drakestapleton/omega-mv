end
if eq code 4
ret oge_copy_str oge_fn_4 dst
end
if eq code 5
ret oge_copy_str oge_fn_5 dst
end
if eq code 6
ret oge_copy_str oge_fn_6 dst
end
if eq code 7
ret oge_copy_str oge_fn_7 dst
end
if eq code 8
ret oge_copy_str oge_fn_8 dst
end
if eq code 9
ret oge_copy_str oge_fn_9 dst
end
if eq code 10
ret oge_copy_str oge_fn_10 dst
end
if eq code 11
ret oge_copy_str oge_fn_11 dst
end
if eq code 12
ret oge_copy_str oge_fn_12 dst
end
if eq code 13
ret oge_copy_str oge_fn_13 dst
end
ret oge_copy_str oge_fn_unk dst
end


note SPDX-License-Identifier: Apache-2.0
note src/omega_gpu_engine.om: Pure seeded OM-2 twin of src/omega_gpu_engine.c.
note 7-state GPU execution engine (INITIAL -> PREPARED -> SUBMITTED -> GPU_COMPLETE ->
note OUTPUT_VISIBLE -> OUTPUT_PRODUCED -> SUCCESS), uncertain-completion latch &
note retention, reverse-order cleanup, poison verification, pluggable backend dispatch.
om2

const OGE_OK ulong 0
const OGE_DEVICE_OPEN ulong 1
const OGE_CHANNEL_CREATE ulong 2
const OGE_ALLOC ulong 3
const OGE_PREPARE ulong 4
const OGE_SUBMIT ulong 5
const OGE_COMPLETION_WAIT ulong 6
const OGE_RELEASE_WAIT ulong 7
const OGE_VISIBILITY_WAIT ulong 8
const OGE_OUTPUT_UNCHANGED ulong 9
const OGE_INVALID_ARGS ulong 10
const OGE_INTERNAL_INVARIANT ulong 11
const OGE_CLEANUP ulong 12
const OGE_UNCERTAIN_COMPLETION_BLOCKED ulong 13
const OGE_FAILURE_COUNT ulong 14

const OGE_STATE_INITIAL ulong 0
const OGE_STATE_PREPARED ulong 1
const OGE_STATE_SUBMITTED ulong 2
const OGE_STATE_GPU_COMPLETE ulong 3
const OGE_STATE_OUTPUT_VISIBLE ulong 4
const OGE_STATE_OUTPUT_PRODUCED ulong 5
const OGE_STATE_SUCCESS ulong 6
const OGE_STATE_COUNT ulong 7

const OGE_WAIT_NONE ulong 0
const OGE_WAIT_MARKER ulong 1
const OGE_WAIT_RELEASE_SEMAPHORE ulong 2
const OGE_WAIT_MARKER2 ulong 3
const OGE_WAIT_COUNT ulong 4

const OGE_STEP_NONE ulong 0
const OGE_STEP_VALIDATE ulong 1
const OGE_STEP_BACKEND_CHECK ulong 2
const OGE_STEP_BLOCKED ulong 3
const OGE_STEP_NOT_IMPLEMENTED ulong 4
const OGE_STEP_OPEN_DEVICE ulong 5
const OGE_STEP_CREATE_CHANNEL ulong 6
const OGE_STEP_ALLOC ulong 7
const OGE_STEP_COPY_IN ulong 8
const OGE_STEP_FILL_POISON ulong 9
const OGE_STEP_BUILD ulong 10
const OGE_STEP_SUBMIT ulong 11
const OGE_STEP_WAIT_MARKER ulong 12
const OGE_STEP_WAIT_MARKER2 ulong 13
const OGE_STEP_WAIT_RELEASE_SEMAPHORE ulong 14
const OGE_STEP_BARRIER ulong 15
const OGE_STEP_COPY_OUT ulong 16
const OGE_STEP_SCAN ulong 17
const OGE_STEP_FREE ulong 18
const OGE_STEP_CLOSE ulong 19
const OGE_STEP_CLOCK_CHECK ulong 20
const OGE_STEP_COUNT ulong 21

const OGE_LAYOUT_VECTOR_1D ulong 0
const OGE_FLAG_NO_C3 ulong 1

const OGE_BUF_SCRATCH ulong 0
const OGE_BUF_PROGRAM ulong 1
const OGE_BUF_INPUT_A ulong 2
const OGE_BUF_INPUT_B ulong 3
const OGE_BUF_OUTPUT ulong 4
const OGE_BUF_ROLE_COUNT ulong 5

const OGE_BACKEND_NONE ulong 0
const OGE_BACKEND_MOCK ulong 1
const OGE_BACKEND_BLACKWELL ulong 2
const OGE_BACKEND_INCOMPLETE ulong 3

const OGE_SYNC_MARKER ulong 1
const OGE_SYNC_MARKER2 ulong 2
const OGE_SYNC_SEMAPHORE ulong 4

note Job descriptor (ulong[12]):
note   0: program_len, 1: layout, 2: element_count, 3: input_a_len, 4: input_b_len,
note   5: output_len, 6: poison_count, 7: flags, 8: marker_ms, 9: release_ms,
note   10: marker2_ms, 11: visibility_ms
note Result record (ulong[16]):
note   0: failure, 1: last_state, 2: failed_step, 3: wait, 4: wait_timeout_ms,
note   5: waited_ms, 6: drv_rc, 7: sync_valid, 8: marker, 9: marker2,
note   10: semaphore, 11: retained, 12: cleanup_failed, 13: n_outputs,
note   14: output_unchanged_words, 15: err_no

global oge_backend ulong 1
global oge_blocked ulong 1
global oge_clock_mode ulong 1
global oge_clock_val ulong 1
global oge_clock_step ulong 1
global oge_last_res ulong 16

note Mock backend controls for CPU-only host tests & fault injection
global oge_mock_fail_step ulong 1
global oge_mock_fail_rc ulong 1
global oge_mock_fail_free_role ulong 1
global oge_mock_fail_close ulong 1
global oge_mock_leave_poison ulong 1
global oge_mock_open_calls ulong 1
global oge_mock_close_calls ulong 1
global oge_mock_free_mask ulong 1
global oge_mock_alloc_mask ulong 1
global oge_mock_marker2_called ulong 1
global oge_mock_poison_buf uint 4096
global oge_mock_out_buf uint 4096
global oge_mock_a_buf uint 4096
global oge_mock_b_buf uint 4096

note Engine job staging buffers (avoids >8 ABI regs on oge_execute)
global oge_job_prog uchar 4096
global oge_job_a uint 4096
global oge_job_b uint 4096
global oge_job_poison uint 4096
global oge_job_out uint 4096

text oge_fn_0 "OK"
text oge_fn_1 "DEVICE_OPEN"
text oge_fn_2 "CHANNEL_CREATE"
text oge_fn_3 "ALLOC"
text oge_fn_4 "PREPARE"
text oge_fn_5 "SUBMIT"
text oge_fn_6 "COMPLETION_WAIT"
text oge_fn_7 "RELEASE_WAIT"
text oge_fn_8 "VISIBILITY_WAIT"

fn oge_copy_str src view uchar * dst edit uchar * to ulong
n = len src
cap = len dst
if gt n cap
n = cap
end
for i ulong n
put dst i get src i
end
ret n
end

fn oge_failure_name code ulong dst edit uchar * to ulong
if eq code 0
ret oge_copy_str oge_fn_0 dst
end
if eq code 1
ret oge_copy_str oge_fn_1 dst
end
if eq code 2
ret oge_copy_str oge_fn_2 dst
end
if eq code 3

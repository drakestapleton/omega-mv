global g_res_err_store long 1
global g_res_err_subj uchar 140
global g_res_err_subj_len ulong 1
global g_res_err_msg uchar 240
global g_res_err_msg_len ulong 1

note Resolver configuration
global g_res_domain ulong 1
global g_res_rcpt_dir uchar 512
global g_res_rcpt_dir_len ulong 1
global g_res_blob_dir uchar 512
global g_res_blob_dir_len ulong 1
global g_res_has_rcpt_dir ulong 1
global g_res_has_blob_dir ulong 1

note Lock state (up to RES_MAX_LOCK = 256 entries)
global g_lock_n ulong 1
global g_lock_names uchar 33024
global g_lock_nlens ulong 256
global g_lock_sem uchar 8192
global g_lock_rcpt uchar 8192

note In-memory Verified Crumb Store (up to RES_MAX_STORE = 64 records)
global g_vcs_n ulong 1

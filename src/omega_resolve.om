note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_resolve.c (Verified Crumb resolver:
note profiles, omega.lock v1 parser, receipt & blob dir fetchers, SPEC 5.1
note receipt checker, transitive closure walk & digest, build_id, artifact
note metadata text/parse, admit and admit_genesis).
note Composes on seed/ng/sha256.om, om/blake3/b3unit.om, src/omega_blake3.om,
note src/omega_receipt.om.
om2

const RES_OK long 0
const RES_UNVERIFIED_DEP long 1
const RES_MISSING_RECEIPT long 2
const RES_RECEIPT_HASH_MISMATCH long 3
const RES_DEP_NOT_PINNED long 4
const RES_DEP_CYCLE long 5
const RES_STALE_RECEIPT long 6
const RES_UNDECLARED_IMPORT long 7
const RES_TAINTED_ARTIFACT long 8
const RES_UNKNOWN_PROFILE long 9
const RES_VERIFIER_TOO_OLD long 10
const RES_BAD_ARGUMENT long 20
const RES_NOMEM long 21

const RES_DOMAIN_BUILD ulong 1
const RES_DOMAIN_DEV ulong 2

const RES_DIGEST_SOURCE ulong 1
const RES_DIGEST_IR ulong 2
const RES_ADM_VERIFIED ulong 1
const RES_ADM_BOOTSTRAP ulong 2

const RES_VCS_GENESIS_NOT_LISTED long 40
const RES_MAX_DEPTH ulong 128
const RES_MAX_LOCK ulong 256
const RES_MAX_STORE ulong 64
const RES_MAX_VC_BYTES ulong 4096
const RES_MAX_DEPS ulong 32
const RES_MAX_CAPS ulong 16
const RES_MAX_NODES ulong 128

text res_cn_ok "OK"
text res_cn_unv "UNVERIFIED_DEPENDENCY"
text res_cn_mis "MISSING_RECEIPT"
text res_cn_rhm "RECEIPT_HASH_MISMATCH"
text res_cn_dnp "DEPENDENCY_NOT_PINNED"
text res_cn_cyc "DEPENDENCY_CYCLE"
text res_cn_stl "STALE_RECEIPT"
text res_cn_und "UNDECLARED_IMPORT"
text res_cn_tnt "TAINTED_ARTIFACT"
text res_cn_unkp "UNKNOWN_VERIFIER_PROFILE"
text res_cn_old "VERIFIER_TOO_OLD"
text res_cn_arg "BAD_ARGUMENT"
text res_cn_nom "NOMEM"
text res_cn_q "?"

text res_dom_dev "dev"
text res_dom_build "build"

text res_prof_0 "host-v1"
text res_prof_1 "qemu-v1"
text res_prof_2 "production-v1"
text res_pver_def "1.0.0"
text res_ptier_0 "HOST_TEST"
text res_ptier_1 "QEMU"
text res_ptier_2 "PRODUCTION"

text res_lock_hdr "omega.lock v1"
text res_lock_mid1 " = semantic "
text res_lock_mid2 " receipt "
text res_tag_vc "AIEN_VERIFIED_CRUMB_V1"
text res_dom_closure "OMEGA.CLOSURE.V1"
text res_dom_build_id "OSC1.BUILD.V1"
text res_cap_taint "omega-dev.taint"
text res_cap_selfmint "omega-bridge.selfminted"
text res_sha256_pfx "sha256:"
text res_ext_json ".json"
text res_ext_blob ".blob"

text res_am_k0 "OMEGA-ARTIFACT v1"
text res_am_k1 "domain "
text res_am_k2 "tainted "
text res_am_k3 "ir_sha256 "
text res_am_k4 "closure_sha256 "
text res_am_k5 "build_id "
text res_lit_1 "1"
text res_lit_0 "0"

note Error state

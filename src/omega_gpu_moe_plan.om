note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_gpu_moe_plan.c (CPU-only queue, planner, and traffic estimator).
note Composes on om/gpu/moe_plan.om.
om2

const OMEGA_MOE_PLAN_MAX_OPS ulong 32

fn omega_moe_queue_init q edit uint 512 cap uint to long
  rc = moe_queue_init q ulong cap
  if ne rc 0
    ret -1
  end
  ret 0
end

fn omega_moe_queue_enqueue q edit uint 512 req_id uint tokens uint layer uint flags uint slot_out edit uint 1 to long
  slot = moe_queue_enqueue q ulong req_id ulong tokens ulong layer ulong flags
  if eq slot 0xffffffff
    ret -1
  end
  put slot_out 0 uint slot
  ret 0
end

fn omega_moe_queue_claim_batch q edit uint 512 max_tokens uint out_slots edit uint 64 claimed_out edit uint 1 to long
  n = moe_queue_claim_batch q ulong max_tokens out_slots
  put claimed_out 0 uint n
  ret 0
end

fn omega_moe_queue_complete_batch q edit uint 512 n uint slots view uint 64 status uint to long
  rc = moe_queue_complete_batch q ulong n slots ulong status
  if ne rc 0
    ret -1
  end
  ret 0
end

fn omega_moe_plan_layer cfg view ulong 8 out_raw edit uint 128 n_ops edit uint 1 to long
  for i ulong 128
    put out_raw i 0
  end
  k = moe_plan_layer cfg out_raw
  if or eq k 0 gt k OMEGA_MOE_PLAN_MAX_OPS
    ret -1
  end
  put n_ops 0 uint k
  ret 0
end

fn omega_moe_plan_traffic cfg view ulong 8 distinct_experts uint out_bytes edit ulong 8 to long
  for i ulong 8
    put out_bytes i 0
  end
  rc = moe_plan_traffic cfg ulong distinct_experts out_bytes
  if ne rc 0
    ret -1
  end
  ret 0
end

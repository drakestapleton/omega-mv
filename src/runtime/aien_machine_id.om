note
note src/runtime/aien_machine_id.om -- canonical AIEN machine identity (M20).
note Composed after seed/ng/sha256.om. Pure seeded OM-2.
note
note AienMachineId layout: 33 bytes: byte 0 = root (1=PROVISIONED, 2=HARDWARE, 3=IMPORTED),
note bytes 1..32 = 32-byte id.
note Persisted 44-byte record:
note   0..3   "AMID"
note   4      0x01
note   5      root
note   6..7   0x00, 0x00
note   8..39  id[32]
note  40..43  first 4 bytes of SHA-256(bytes 0..39)
note Text form: 88 lowercase hex digits.

const AIEN_MID_ROOT_PROVISIONED uchar 1
const AIEN_MID_ROOT_HARDWARE    uchar 2
const AIEN_MID_ROOT_IMPORTED    uchar 3

const AIEN_MID_OK       int 0
const AIEN_MID_E_ARG    int -1
const AIEN_MID_E_ZERO   int -2
const AIEN_MID_E_FORMAT int -3
const AIEN_MID_E_CHECK  int -4
const AIEN_MID_E_IO     int -5
const AIEN_MID_E_FULL   int -6

text t_mid_dom "AIENOS-MACHINE-ID-V1"
text t_mid_hex "0123456789abcdef"

global g_mid_tmp_p    uchar 4096
global g_mid_tmp_t    uchar 4096
global g_mid_ren_pkt  uchar 8200
global g_mid_io_buf   uchar 48
global g_mid_rec_tmp  uchar 44
global g_mid_st       uchar 128
global g_mid_seq      ulong 1

note Local index table (capacity up to 64 entries)
global g_mid_idx_slots uchar 2112
global g_mid_idx_meta  uint  2

fn mid_is_zero id view uchar 32 to int
  acc = uint 0
  for i ulong 32
    acc = or acc uint get id i
  end
  if eq acc 0
    ret 1
  end
  ret 0
end

fn mid_root_valid r uchar to int
  if eq r 1
    ret 1
  end
  if eq r 2
    ret 1
  end
  if eq r 3
    ret 1
  end
  ret 0
end

fn mid_path_byte c uchar to int
  if ge c 97
    if le c 122
      ret int c
    end
  end
  if ge c 65
    if le c 90
      ret int c
    end
  end
  if ge c 48
    if le c 57
      ret int c
    end
  end
  if eq c 46
    ret int c
  end
  if eq c 95
    ret int c
  end
  if eq c 45
    ret int c
  end
  if eq c 47
    ret int c
  end
  if eq c 43
    ret int c
  end
  if eq c 44
    ret int c
  end
  if eq c 61
    ret int c
  end
  if eq c 64
    ret int c
  end
  if eq c 58
    ret int c
  end
  if eq c 126
    ret int c
  end
  ret sub int 0 1
end

fn mid_path_check_g src view uchar 4096 plen ulong cap ulong to int
  if eq plen 0
    ret sub int 0 1
  end
  if ge plen cap
    ret sub int 0 1
  end
  for k ulong plen
    c = get src k
    if lt mid_path_byte c 0
      ret sub int 0 1
    end
    put g_mid_tmp_p k c
  end
  i = ulong 0
  while lt i plen
    j = i
    cont = int 1
    while ne cont 0
      if ge j plen
        cont = int 0
      else
        if eq get g_mid_tmp_p j 47
          cont = int 0
        else
          j = add j 1
        end
      end
    end
    if eq sub j i 2
      if eq get g_mid_tmp_p i 46
        if eq get g_mid_tmp_p add i 1 46
          ret sub int 0 1
        end
      end
    end
    i = add j 1
  end
  ret 0
end

fn aien_mid_derive root_kind uchar root view uchar 4096 rlen ulong dst edit uchar 33 to int
  if eq root_kind 2
    if ne rlen 32
      ret sub int 0 1
    end
  else
    if eq root_kind 1
      if eq rlen 0
        ret sub int 0 1
      end
      if gt rlen 4096
        ret sub int 0 1
      end
    else
      ret sub int 0 1
    end
  end
  for i ulong 20
    put sh_dat i get t_mid_dom i
  end
  put sh_dat 20 uchar 0
  for i ulong rlen
    put sh_dat add 21 i get root i
  end
  sh_all add 21 rlen
  put dst 0 root_kind
  acc = uint 0
  for i ulong 32
    b = get sh_dig i
    put dst add 1 i b
    acc = or acc uint b
  end
  if eq acc 0
    ret sub int 0 2
  end
  ret 0
end

fn aien_mid_from_slot slot view uchar 32 dst edit uchar 33 to int
  if ne mid_is_zero view slot 0
    ret sub int 0 2
  end
  put dst 0 uchar 3
  for i ulong 32
    put dst add 1 i get slot i
  end
  ret 0
end

fn aien_mid_to_slot m view uchar 33 slot edit uchar 32 to void
  for i ulong 32
    put slot i get m add 1 i
  end
end

fn aien_mid_equal a view uchar 33 b view uchar 33 to int
  for i ulong 32
    if ne get a add 1 i get b add 1 i
      ret 0
    end
  end
  ret 1
end

fn aien_mid_compare a view uchar 33 b view uchar 33 to int
  for i ulong 32
    ba = uint get a add 1 i
    bb = uint get b add 1 i
    if lt ba bb
      ret sub int 0 1
    end
    if gt ba bb
      ret 1
    end
  end
  ret 0
end

fn aien_mid_hash m view uchar 33 to ulong
  h = ulong 0
  for i ulong 8
    b = ulong get m add 1 i
    h = or shl h 8 b
  end
  ret h
end

fn aien_mid_encode m view uchar 33 dst edit uchar 44 to int
  r = get m 0
  if eq mid_root_valid r 0
    ret sub int 0 1
  end
  acc = uint 0
  for i ulong 32
    b = get m add 1 i
    acc = or acc uint b
  end
  if eq acc 0
    ret sub int 0 2
  end
  put dst 0 uchar 65
  put dst 1 uchar 77
  put dst 2 uchar 73
  put dst 3 uchar 68
  put dst 4 uchar 1
  put dst 5 r
  put dst 6 uchar 0
  put dst 7 uchar 0
  for i ulong 32
    put dst add 8 i get m add 1 i
  end
  for i ulong 40
    put sh_dat i get dst i
  end
  sh_all 40
  for i ulong 4
    put dst add 40 i get sh_dig i
  end
  ret 0
end

fn aien_mid_decode src view uchar 48 slen ulong dst edit uchar 33 to int
  if ne slen 44
    ret sub int 0 3
  end
  if ne get src 0 65
    ret sub int 0 3
  end
  if ne get src 1 77
    ret sub int 0 3
  end
  if ne get src 2 73
    ret sub int 0 3
  end
  if ne get src 3 68
    ret sub int 0 3
  end
  if ne get src 4 1
    ret sub int 0 3
  end
  r = get src 5
  if eq mid_root_valid r 0
    ret sub int 0 3
  end
  if ne get src 6 0
    ret sub int 0 3
  end
  if ne get src 7 0
    ret sub int 0 3
  end
  for i ulong 40
    put sh_dat i get src i
  end
  sh_all 40
  for i ulong 4
    if ne get src add 40 i get sh_dig i
      ret sub int 0 4
    end
  end
  acc = uint 0
  for i ulong 32
    b = get src add 8 i
    acc = or acc uint b
  end
  if eq acc 0
    ret sub int 0 2
  end
  put dst 0 r
  for i ulong 32
    put dst add 1 i get src add 8 i
  end
  ret 0
end

fn aien_mid_to_text m view uchar 33 dst edit uchar 88 to int
  rec = new uchar 44 0
  rc = aien_mid_encode view m edit rec
  if ne rc 0
    ret rc
  end
  for i ulong 44
    b = uint get rec i
    hi = ulong shr b 4
    lo = ulong and b 15
    put dst mul i 2 get t_mid_hex hi
    put dst add mul i 2 1 get t_mid_hex lo
  end
  ret 0
end

fn mid_hex_nib c uchar to int
  if ge c 48
    if le c 57
      ret int sub c 48
    end
  end
  if ge c 97
    if le c 102
      ret add 10 int sub c 97
    end
  end
  ret sub int 0 1
end

fn aien_mid_from_text src view uchar 96 slen ulong dst edit uchar 33 to int
  if ne slen 88
    ret sub int 0 3
  end
  io = new uchar 48 0
  for i ulong 44
    hi = mid_hex_nib get src mul i 2
    if lt hi 0
      ret sub int 0 3
    end
    lo = mid_hex_nib get src add mul i 2 1
    if lt lo 0
      ret sub int 0 3
    end
    put io i uchar or shl uint hi 4 uint lo
  end
  ret aien_mid_decode view io 44 edit dst
end

fn mid_put_u16_ren off ulong v ulong to void
  put g_mid_ren_pkt off uchar and v 255
  put g_mid_ren_pkt add off 1 uchar and shr v 8 255
end

fn mid_store_rename tlen ulong plen ulong to int
  mid_put_u16_ren 0 2
  mid_put_u16_ren 2 tlen
  for i ulong tlen
    put g_mid_ren_pkt add 4 i get g_mid_tmp_t i
  end
  off2 = add 4 tlen
  mid_put_u16_ren off2 plen
  for i ulong plen
    put g_mid_ren_pkt add add off2 2 i get g_mid_tmp_p i
  end
  pkt_len = add add off2 2 plen
  rr = renames g_mid_ren_pkt 0 pkt_len 0
  if ne rr 0
    ign = unlink g_mid_tmp_t 0 tlen
    ret sub int 0 5
  end
  ret 0
end

fn mid_st_u32 off ulong to ulong
  b0 = ulong get g_mid_st off
  b1 = ulong get g_mid_st add off 1
  b2 = ulong get g_mid_st add off 2
  b3 = ulong get g_mid_st add off 3
  ret or b0 or shl b1 8 or shl b2 16 shl b3 24
end

fn mid_stat_reg_ok to int
  mode = mid_st_u32 16
  if ne and mode ulong 61440 ulong 32768
    ret sub int 0 1
  end
  if ne and mode ulong 18 ulong 0
    ret sub int 0 1
  end
  if ne mid_st_u32 20 ulong 1
    ret sub int 0 1
  end
  if ne mid_st_u32 24 ulong geteuid
    ret sub int 0 1
  end
  ret 0
end

fn mid_no_symlink_ancestors plen ulong to int
  if eq plen 0
    ret sub int 0 1
  end
  if eq get g_mid_tmp_p sub plen 1 47
    ret sub int 0 1
  end
  i = ulong 1
  while lt i plen bound 4096
    if eq get g_mid_tmp_p i 47
      r = lstat g_mid_tmp_p 0 i g_mid_st 0 128
      if ne r 0
        ret sub int 0 1
      end
      mode = mid_st_u32 16
      if ne and mode ulong 61440 ulong 16384
        ret sub int 0 1
      end
    end
    i = add i 1
  end
  ret 0
end

fn mid_replace_ok plen ulong to int
  if ne mid_no_symlink_ancestors plen 0
    ret sub int 0 1
  end
  r = lstat g_mid_tmp_p 0 plen g_mid_st 0 128
  if eq r sub long 0 2
    ret 0
  end
  if ne r 0
    ret sub int 0 1
  end
  ret mid_stat_reg_ok
end

fn mid_append_dec off ulong val ulong to ulong
  dig = new uchar 24 0
  n = ulong 0
  v = val
  if eq v 0
    put dig 0 uchar 48
    n = ulong 1
  else
    while gt v 0 bound 24
      put dig n uchar add rem v 10 48
      v = div v 10
      n = add n 1
    end
  end
  if gt add off n 4095
    ret 0
  end
  for i ulong n bound 24
    put g_mid_tmp_t add off i get dig sub sub n 1 i
  end
  ret add off n
end

fn mid_build_tmp plen ulong to ulong
  if gt add plen 36 4095
    ret 0
  end
  for i ulong plen bound 4096
    put g_mid_tmp_t i get g_mid_tmp_p i
  end
  put g_mid_tmp_t plen uchar 46
  put g_mid_tmp_t add plen 1 uchar 116
  put g_mid_tmp_t add plen 2 uchar 109
  put g_mid_tmp_t add plen 3 uchar 112
  put g_mid_tmp_t add plen 4 uchar 46
  pos = mid_append_dec add plen 5 ulong getpid
  if eq pos 0
    ret 0
  end
  put g_mid_tmp_t pos uchar 46
  seq = add get g_mid_seq 0 1
  put g_mid_seq 0 seq
  ret mid_append_dec add pos 1 seq
end

fn mid_fsync_parent plen ulong to void
  last = ulong 0
  found = int 0
  for i ulong plen bound 4096
    if eq get g_mid_tmp_p i 47
      last = i
      found = int 1
    end
  end
  if eq found 0
    ret
  end
  dlen = last
  if eq dlen 0
    dlen = ulong 1
  end
  note O_RDONLY | O_DIRECTORY | O_NOFOLLOW = 16384 + 32768 = 49152
  dfd = fopen g_mid_tmp_p 0 dlen 49152 0
  if ge dfd 0
    ign_s = fsync int dfd
    ign_c = fclose int dfd
  end
end

fn aien_mid_store path view uchar 4096 plen ulong m view uchar 33 to int
  rec = new uchar 44 0
  rc = aien_mid_encode view m edit rec
  if ne rc 0
    ret rc
  end
  for i ulong 44
    put g_mid_rec_tmp i get rec i
  end
  if ne mid_path_check_g view path plen 4060 0
    ret sub int 0 1
  end
  if ne mid_replace_ok plen 0
    ret sub int 0 5
  end
  tlen = mid_build_tmp plen
  if eq tlen 0
    ret sub int 0 1
  end
  note O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_NONBLOCK = 1+64+128+32768+2048 = 35009
  fd = fopen g_mid_tmp_t 0 tlen 35009 420
  if lt fd 0
    ret sub int 0 5
  end
  fdi = int fd
  if or ne fstat fdi g_mid_st 0 128 0 ne mid_stat_reg_ok 0
    ign = fclose fdi
    ign = unlink g_mid_tmp_t 0 tlen
    ret sub int 0 5
  end
  w = write fdi g_mid_rec_tmp 0 44
  if ne w 44
    ign = fclose fdi
    ign = unlink g_mid_tmp_t 0 tlen
    ret sub int 0 5
  end
  fs = fsync fdi
  cl = fclose fdi
  if or ne fs 0 ne cl 0
    ign = unlink g_mid_tmp_t 0 tlen
    ret sub int 0 5
  end
  rrc = mid_store_rename tlen plen
  if eq rrc 0
    mid_fsync_parent plen
  end
  ret rrc
end

fn aien_mid_load path view uchar 4096 plen ulong dst edit uchar 33 to int
  if ne mid_path_check_g view path plen 4096 0
    ret sub int 0 1
  end
  if ne mid_no_symlink_ancestors plen 0
    ret sub int 0 5
  end
  note O_RDONLY|O_NOFOLLOW|O_NONBLOCK = 32768+2048 = 34816
  fd = fopen g_mid_tmp_p 0 plen 34816 0
  if lt fd 0
    ret sub int 0 5
  end
  fdi = int fd
  if or ne fstat fdi g_mid_st 0 128 0 ne mid_stat_reg_ok 0
    ign = fclose fdi
    ret sub int 0 5
  end
  got = ulong 0
  cont = int 1
  while ne cont 0
    r = read fdi g_mid_io_buf got sub 45 got
    if lt r 0
      ign = fclose fdi
      ret sub int 0 5
    end
    if eq r 0
      cont = int 0
    else
      got = add got ulong r
      if ge got 45
        cont = int 0
      end
    end
  end
  ign2 = fclose fdi
  io = new uchar 48 0
  for i ulong 48
    put io i get g_mid_io_buf i
  end
  ret aien_mid_decode view io got edit dst
end

fn aien_mid_index_init cap uint to void
  c = cap
  if gt c 64
    c = uint 64
  end
  put g_mid_idx_meta 0 c
  put g_mid_idx_meta 1 uint 0
end

fn aien_mid_index_find m view uchar 33 to uint
  cnt = get g_mid_idx_meta 1
  i = uint 0
  while lt i cnt
    base = mul ulong i 33
    same = int 1
    for j ulong 32
      if ne get g_mid_idx_slots add add base 1 j get m add 1 j
        same = int 0
      end
    end
    if ne same 0
      ret add i 1
    end
    i = add i 1
  end
  ret uint 0
end

fn aien_mid_index_bind m view uchar 33 to uint
  if eq mid_root_valid get m 0 0
    ret uint 0
  end
  acc = uint 0
  for j ulong 32
    acc = or acc uint get m add 1 j
  end
  if eq acc 0
    ret uint 0
  end
  k = aien_mid_index_find view m
  if ne k 0
    ret k
  end
  cnt = get g_mid_idx_meta 1
  cap = get g_mid_idx_meta 0
  if ge cnt cap
    ret uint 0
  end
  base = mul ulong cnt 33
  for j ulong 33
    put g_mid_idx_slots add base j get m j
  end
  cnt = add cnt 1
  put g_mid_idx_meta 1 cnt
  ret cnt
end

fn aien_mid_index_get idx uint dst edit uchar 33 to int
  cnt = get g_mid_idx_meta 1
  if eq idx 0
    ret sub int 0 1
  end
  if gt idx cnt
    ret sub int 0 1
  end
  base = mul ulong sub idx 1 33
  for j ulong 33
    put dst j get g_mid_idx_slots add base j
  end
  ret 0
end

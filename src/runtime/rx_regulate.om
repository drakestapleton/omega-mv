note SPDX-License-Identifier: Apache-2.0
note src/runtime/rx_regulate.om -- Pure seeded OM-2 port of src/runtime/rx_regulate.c.
note ADAPTIVE-M4 bounded resource regulation: envelope validation, regime hysteresis
note decision, policy derivation, bounds check, reaction step, and host apply state.
note
note Packed env[16] layout (ulong):
note   0 slots_min      1 slots_max
note   2 memory_min     3 memory_max
note   4 energy_min     5 energy_max
note   6 base_slots     7 base_memory     8 base_energy
note   9 contention_hi 10 contention_lo
note  11 pressure_hi   12 pressure_lo
note  13 min_dwell

const RX_REG_OK long 0
const RX_REG_ERR_ARG long -1
const RX_REG_ERR_BOUNDS long -20
const RX_REG_ERR_HALTED long -21

const RX_REG_NOMINAL ulong 0
const RX_REG_EXPAND ulong 1
const RX_REG_PROTECT ulong 2
const RX_REG_U32_MAX ulong 4294967295

fn rx_regulate_envelope_ok env view ulong 16 to long
  smin = get env 0
  smax = get env 1
  if eq smin 0
    ret RX_REG_ERR_ARG
  end
  if gt smin smax
    ret RX_REG_ERR_ARG
  end
  if gt smax RX_REG_U32_MAX
    ret RX_REG_ERR_ARG
  end
  mmin = get env 2
  mmax = get env 3
  if gt mmin mmax
    ret RX_REG_ERR_ARG
  end
  emin = get env 4
  emax = get env 5
  if gt emin emax
    ret RX_REG_ERR_ARG
  end
  bs = get env 6
  if lt bs smin
    ret RX_REG_ERR_ARG
  end
  if gt bs smax
    ret RX_REG_ERR_ARG
  end
  bm = get env 7
  if lt bm mmin
    ret RX_REG_ERR_ARG
  end
  if gt bm mmax
    ret RX_REG_ERR_ARG
  end
  be = get env 8
  if lt be emin
    ret RX_REG_ERR_ARG
  end
  if gt be emax
    ret RX_REG_ERR_ARG
  end
  chi = get env 9
  clo = get env 10
  if ge clo chi
    ret RX_REG_ERR_ARG
  end
  phi = get env 11
  plo = get env 12
  if ge plo phi
    ret RX_REG_ERR_ARG
  end
  if gt phi 100
    ret RX_REG_ERR_ARG
  end
  mdw = get env 13
  if eq mdw 0
    ret RX_REG_ERR_ARG
  end
  ret RX_REG_OK
end

fn rx_regulate_decide env view ulong 16 regime ulong dwell ulong contention ulong pressure ulong to ulong
  min_dw = get env 13
  settled = ge dwell min_dw
  p_hi = get env 11
  if ge pressure p_hi
    ret RX_REG_PROTECT
  end
  if eq regime RX_REG_PROTECT
    p_lo = get env 12
    if not settled
      ret RX_REG_PROTECT
    end
    if gt pressure p_lo
      ret RX_REG_PROTECT
    end
    c_hi = get env 9
    if ge contention c_hi
      ret RX_REG_EXPAND
    end
    ret RX_REG_NOMINAL
  end
  if eq regime RX_REG_EXPAND
    c_lo = get env 10
    if not settled
      ret RX_REG_EXPAND
    end
    if gt contention c_lo
      ret RX_REG_EXPAND
    end
    ret RX_REG_NOMINAL
  end
  c_hi2 = get env 9
  if ge contention c_hi2
    ret RX_REG_EXPAND
  end
  ret RX_REG_NOMINAL
end

fn rx_regulate_policy_for env view ulong 16 regime ulong dst edit ulong 4 to void
  if eq regime RX_REG_EXPAND
    put dst 0 get env 1
    put dst 1 get env 3
    put dst 2 get env 5
    ret
  end
  if eq regime RX_REG_PROTECT
    put dst 0 get env 0
    put dst 1 get env 2
    put dst 2 get env 4
    ret
  end
  put dst 0 get env 6
  put dst 1 get env 7
  put dst 2 get env 8
end

fn rx_regulate_apply_check env view ulong 16 pol view ulong 8 to long
  slots = get pol 1
  if gt slots RX_REG_U32_MAX
    ret RX_REG_ERR_BOUNDS
  end
  if lt slots get env 0
    ret RX_REG_ERR_BOUNDS
  end
  if gt slots get env 1
    ret RX_REG_ERR_BOUNDS
  end
  mem = get pol 2
  if lt mem get env 2
    ret RX_REG_ERR_BOUNDS
  end
  if gt mem get env 3
    ret RX_REG_ERR_BOUNDS
  end
  eng = get pol 3
  if lt eng get env 4
    ret RX_REG_ERR_BOUNDS
  end
  if gt eng get env 5
    ret RX_REG_ERR_BOUNDS
  end
  reg = get pol 4
  if gt reg RX_REG_PROTECT
    ret RX_REG_ERR_BOUNDS
  end
  ret RX_REG_OK
end

note Complete reaction step (fn_regulate):
note   returns 0 = no-op (cseq == pol[5])
note   returns 1 = same regime (dst[5]=cseq, dst[6]=dwell+1)
note   returns 2 = regime flip (dst[0..7] populated with new policy fields)
fn rx_regulate_step env view ulong 16 cond view ulong 8 pol view ulong 8 dst edit ulong 8 to ulong
  cseq = get cond 0
  if eq cseq get pol 5
    ret 0
  end
  regime = get pol 4
  dwell = get pol 6
  nxt = rx_regulate_decide env regime dwell get cond 1 get cond 3
  put dst 5 cseq
  if eq nxt regime
    put dst 6 add dwell 1
    ret 1
  end
  b = new ulong 4 0
  rx_regulate_policy_for env nxt b
  put dst 0 add get pol 0 1
  put dst 1 get b 0
  put dst 2 get b 1
  put dst 3 get b 2
  put dst 4 nxt
  put dst 6 1
  put dst 7 add get pol 7 1
  ret 2
end

note Host apply state transition (rx_regulate_apply):
note state[0]=applied_version, [1]=slots, [2]=memory, [3]=energy, [4]=refused.
note Returns 0 (RX_OK), 1 (nothing new), -21 (RX_ERR_HALTED), -20 (RX_ERR_BOUNDS).
fn rx_regulate_apply env view ulong 16 pol view ulong 8 halted ulong state edit ulong 8 to long
  if ne halted 0
    put state 4 add get state 4 1
    ret RX_REG_ERR_HALTED
  end
  ver = get pol 0
  if eq ver get state 0
    ret 1
  end
  chk = rx_regulate_apply_check env pol
  if ne chk RX_REG_OK
    put state 4 add get state 4 1
    ret RX_REG_ERR_BOUNDS
  end
  put state 0 ver
  put state 1 get pol 1
  put state 2 get pol 2
  put state 3 get pol 3
  ret RX_REG_OK
end

note SPDX-License-Identifier: Apache-2.0
note src/runtime/rx_contract.om -- Pure seeded OM-2 port of src/runtime/rx_contract.c
note Typed result constraints: standard contracts, SHA-256 contract & object identity,
note rc_check, rc_repair, rc_compile, rc_domain / contains / pick,
note canonical binary rc_encode / rc_decode, and strict JSON round-trip.
note Requires seed/ng/sha256.om concatenated ahead of this unit.

const RC_MAX_FIELDS ulong 8
const RC_MAX_RULES ulong 24
const RC_MAX_SET ulong 64
const RC_MAX_EVIDENCE ulong 64
const RC_MAX_REFS ulong 4
const RC_MAX_EFFECT_RES ulong 8
const RC_NONE ulong 255
const RC_TYPE_RULE ulong 65535
const RC_MAX_OBJECTS ulong 64
const RC_MAX_SKILLS ulong 16
const RC_MAX_CAPS ulong 32

const RC_PLAN ulong 1
const RC_HYPOTHESIS ulong 2
const RC_CAPABILITY_NEED ulong 3
const RC_ACTION_GRAPH ulong 4
const RC_SKILL_INVOCATION ulong 5
const RC_WORLD_MUTATION ulong 6
const RC_EFFECT_PROPOSAL ulong 7
const RC_GENERATION_CANDIDATE ulong 8
const RC_EVIDENCE ulong 9

const RC_T_U64 ulong 1
const RC_T_U32 ulong 2
const RC_T_BOOL ulong 3
const RC_T_ENUM ulong 4
const RC_T_BITS ulong 5
const RC_T_OBJ ulong 6
const RC_T_SUBJECT ulong 7
const RC_T_RESOURCE ulong 8
const RC_T_DIGEST ulong 9

const RC_RULE_RANGE ulong 1
const RC_RULE_ENUM ulong 2
const RC_RULE_STRUCT ulong 3
const RC_RULE_CROSS ulong 4
const RC_RULE_AUTHORITY ulong 5
const RC_RULE_GENERATION ulong 6
const RC_RULE_REFERENCE ulong 7
const RC_RULE_EVIDENCE ulong 8
const RC_RULE_EFFECT ulong 9

const RC_S_NONZERO ulong 1
const RC_S_BITS_WITHIN ulong 2
const RC_S_ACTION_GRAPH ulong 3
const RC_S_GRAPH_FIELDS ulong 4

const RC_A_PRINCIPAL ulong 1
const RC_A_HOLDS ulong 2
const RC_A_NO_PRIVILEGED ulong 3

const RC_G_LIVE ulong 1
const RC_G_ACTIVE ulong 2
const RC_G_NEXT ulong 3
const RC_G_EPOCH ulong 4

const RC_R_CTX_FIELD ulong 1
const RC_R_NEXT_SEQ ulong 2
const RC_R_SKILL ulong 3
const RC_R_ARITY ulong 4
const RC_R_OBJECT ulong 5
const RC_R_RESOURCE_OF ulong 6
const RC_R_RESOURCE_LIVE ulong 7
const RC_R_CTX_VALUE ulong 8

const RC_E_FORBIDDEN ulong 1
const RC_E_ALLOWED ulong 2
const RC_E_BUDGET ulong 3
const RC_E_MAX ulong 4
const RC_E_APPROVAL ulong 5
const RC_E_GRAPH_CLEAR ulong 6

const RC_EQ ulong 1
const RC_NE ulong 2
const RC_LT ulong 3
const RC_LE ulong 4
const RC_GT ulong 5
const RC_GE ulong 6

const RC_ALWAYS ulong 0
const RC_GUARD_IN ulong 1
const RC_GUARD_BITS ulong 2

const RC_FIX_NONE ulong 0
const RC_FIX_DERIVE ulong 1
const RC_FIX_NARROW ulong 2

const RC_EV_VERIFY ulong 1
const RC_EV_GENERATION ulong 2
const RC_EV_MEASURE ulong 3
const RC_VERDICT_PASS ulong 1
const RC_VERDICT_FAIL ulong 2

const RC_RIGHT_READ ulong 1
const RC_RIGHT_WRITE ulong 2
const RC_RIGHT_EFFECT ulong 4
const RC_RIGHT_DELEGATE ulong 8
const RC_RIGHT_PRIVILEGED ulong 16

const RC_U32_MAX ulong 4294967295
const RC_U64_MAX ulong 0xffffffffffffffff

note Contract storage:
note rc_c_meta: [0]=kind, [1]=n_fields, [2]=n_rules, [3]=world_type
global rc_c_meta ulong 4
note rc_c_fld: 8 * 3 ([0]=type, [1]=derived, [2]=order_pos) = 24
global rc_c_fld ulong 24
global rc_c_ord ulong 8
note rc_c_rule: 24 * 11 ([0]=kind, [1]=op, [2]=a, [3]=b, [4]=g, [5]=gmode, [6]=cmp, [7]=repair, [8]=k, [9]=k2, [10]=kg) = 264
global rc_c_rule ulong 264
global rc_c_ident uchar 32

note Context storage:
note rc_ctx: [0]=principal, [1]=next_seq, [2]=active_gen, [3]=auth_epoch,
note [4]=n_effect_res, [5]=forbid_lo, [6]=forbid_hi, [7]=effects_used,
note [8]=max_effects, [9]=n_evidence, [10]=n_caps, [11]=n_skills
global rc_ctx ulong 12
global rc_ctx_vals ulong 4
global rc_ctx_eres ulong 8
note Evidence: 64 * 3 ([0]=subject_kind, [1]=subject, [2]=verdict) = 192
global rc_ctx_ev ulong 192
note Principal caps: 32 * 2 ([0]=resource, [1]=rights) = 64
global rc_ctx_cap ulong 64
note Skills: 16 * 2 ([0]=id, [1]=arity) = 32
global rc_ctx_sk ulong 32
note World objects (mocked for pure OM-2): 64 * 3 ([0]=live, [1]=gen, [2]=resource) = 192
global rc_w_obj ulong 192
note Context ref fields: 4 * 9 ([0]=live, [1..8]=field[0..7]) = 36
global rc_ctx_ref ulong 36

note Object under test: [0]=kind, [1..8]=f[0..7]
global rc_obj ulong 9

note Verdict: [0]=ok, [1]=n, [2]=kinds_violated
global rc_v_meta ulong 3
note Violations: 32 * 3 ([0]=rule, [1]=field, [2]=kind) = 96
global rc_v_list ulong 96

note Compiled contract:
global rc_comp_pos ulong 8
global rc_comp_enf ulong 24
global rc_comp_cnt ulong 2

note Domain:
note rc_dom: [0]=lo, [1]=hi, [2]=bits, [3]=is_bits, [4]=has_enum, [5]=has_set,
note [6]=empty, [7]=n_set, [8]=n_ne, [9]=has_x, [10]=xlo, [11]=xhi
global rc_dom ulong 12
global rc_dom_set ulong 64
global rc_dom_ne ulong 24
global rc_dom_tmp ulong 64

note Binary encode/decode buffer
global rc_bin uchar 160
global rc_obj_id uchar 32

fn rc_sh_u32 p ulong v ulong to ulong
  put sh_dat p uchar and v 255
  put sh_dat add p 1 uchar and shr v 8 255
  put sh_dat add p 2 uchar and shr v 16 255
  put sh_dat add p 3 uchar and shr v 24 255
  ret add p 4
end

fn rc_sh_u64 p ulong v ulong to ulong
  q = rc_sh_u32 p and v RC_U32_MAX
  ret rc_sh_u32 q shr v 32
end

fn rc_context_init principal ulong to void
  for i ulong 12
    put rc_ctx i 0
  end
  for i ulong 4
    put rc_ctx_vals i 0
  end
  for i ulong 192
    put rc_w_obj i 0
  end
  for i ulong 36
    put rc_ctx_ref i 0
  end
  put rc_ctx 0 principal
  put rc_ctx 1 1
  put rc_ctx 8 RC_U32_MAX
end

fn rc_context_add_evidence skind ulong subj ulong verd ulong to long
  n = get rc_ctx 9
  if ge n RC_MAX_EVIDENCE
    ret -1
  end
  eb = mul n 3
  put rc_ctx_ev eb skind
  put rc_ctx_ev add eb 1 subj
  put rc_ctx_ev add eb 2 verd
  put rc_ctx 9 add n 1
  ret 0
end

fn rc_add_field typ ulong deriv ulong to void
  n = get rc_c_meta 1
  fb = mul n 3
  put rc_c_fld fb typ
  put rc_c_fld add fb 1 deriv
  put rc_c_meta 1 add n 1
end

fn rc_add_rule knd ulong op ulong a ulong to ulong
  n = get rc_c_meta 2
  rb = mul n 11
  for i ulong 11
    put rc_c_rule add rb i 0
  end
  put rc_c_rule rb knd
  put rc_c_rule add rb 1 op
  put rc_c_rule add rb 2 a
  put rc_c_rule add rb 3 RC_NONE
  put rc_c_rule add rb 4 RC_NONE
  put rc_c_meta 2 add n 1
  ret rb
end

fn rc_add_range a ulong lo ulong hi ulong to void
  rb = rc_add_rule RC_RULE_RANGE 0 a
  put rc_c_rule add rb 8 lo
  put rc_c_rule add rb 9 hi
end

fn rc_add_enum a ulong mask ulong to void
  rb = rc_add_rule RC_RULE_ENUM 0 a
  put rc_c_rule add rb 8 mask
end

fn rc_add_cross a ulong cmp ulong b ulong k ulong g ulong gmode ulong to ulong
  rb = rc_add_rule RC_RULE_CROSS 0 a
  put rc_c_rule add rb 6 cmp
  put rc_c_rule add rb 3 b
  put rc_c_rule add rb 8 k
  put rc_c_rule add rb 4 g
  put rc_c_rule add rb 5 gmode
  ret rb
end

fn rc_contract_identify to void
  p = rc_sh_u32 0 get rc_c_meta 0
  nf = get rc_c_meta 1
  nr = get rc_c_meta 2
  p = rc_sh_u32 p nf
  p = rc_sh_u32 p nr
  for i ulong nf bound 8
    fb = mul i 3
    put sh_dat p uchar get rc_c_fld fb
    put sh_dat add p 1 uchar get rc_c_fld add fb 1
    put sh_dat add p 2 uchar get rc_c_ord i
    p = add p 3
  end
  for i ulong nr bound 24
    rb = mul i 11
    for j ulong 8
      put sh_dat add p j uchar get rc_c_rule add rb j
    end
    p = add p 8
    p = rc_sh_u64 p get rc_c_rule add rb 8
    p = rc_sh_u64 p get rc_c_rule add rb 9
    p = rc_sh_u64 p get rc_c_rule add rb 10
  end
  p = rc_sh_u32 p get rc_c_meta 3
  sh_all p
  for i ulong 32
    put rc_c_ident i get sh_dig i
  end
end

fn rc_std_world_mutation to void
  rc_add_field RC_T_OBJ 0
  rc_add_field RC_T_U32 0
  rc_add_field RC_T_U32 0
  rc_add_field RC_T_U64 0
  rc_add_field RC_T_SUBJECT 0
  rc_add_field RC_T_RESOURCE 1
  put rc_c_ord 0 4
  put rc_c_ord 1 0
  put rc_c_ord 2 1
  put rc_c_ord 3 5
  put rc_c_ord 4 2
  put rc_c_ord 5 3
  ign1 = rc_add_rule RC_RULE_AUTHORITY RC_A_PRINCIPAL 4
  rb = rc_add_rule RC_RULE_AUTHORITY RC_A_HOLDS 5
  put rc_c_rule add rb 8 RC_RIGHT_WRITE
  ign2 = rc_add_rule RC_RULE_EFFECT RC_E_FORBIDDEN 5
  rb = rc_add_rule RC_RULE_REFERENCE RC_R_RESOURCE_OF 5
  put rc_c_rule add rb 3 0
  put rc_c_rule add rb 7 RC_FIX_DERIVE
  ign3 = rc_add_rule RC_RULE_REFERENCE RC_R_OBJECT 0
  rb = rc_add_rule RC_RULE_GENERATION RC_G_LIVE 0
  put rc_c_rule add rb 3 1
  rc_add_range 2 0 7
end

fn rc_std_cap_need to void
  rc_add_field RC_T_SUBJECT 0
  rc_add_field RC_T_U32 0
  rc_add_field RC_T_RESOURCE 0
  rc_add_field RC_T_BITS 0
  rc_add_field RC_T_BITS 0
  rc_add_field RC_T_BITS 0
  rc_add_field RC_T_U64 0
  rc_add_field RC_T_BOOL 0
  for i ulong 8
    put rc_c_ord i i
  end
  ign1 = rc_add_rule RC_RULE_AUTHORITY RC_A_PRINCIPAL 0
  rc_add_range 1 1 1048576
  ign2 = rc_add_rule RC_RULE_REFERENCE RC_R_RESOURCE_LIVE 2
  ign3 = rc_add_rule RC_RULE_EFFECT RC_E_FORBIDDEN 2
  rb = rc_add_rule RC_RULE_STRUCT RC_S_BITS_WITHIN 3
  put rc_c_rule add rb 8 15
  put rc_c_rule add rb 7 RC_FIX_NARROW
  rb = rc_add_rule RC_RULE_AUTHORITY RC_A_NO_PRIVILEGED 3
  put rc_c_rule add rb 8 RC_RIGHT_PRIVILEGED
  put rc_c_rule add rb 7 RC_FIX_NARROW
  ign4 = rc_add_rule RC_RULE_STRUCT RC_S_NONZERO 3
  rb = rc_add_rule RC_RULE_STRUCT RC_S_BITS_WITHIN 4
  put rc_c_rule add rb 8 63
  rb = rc_add_rule RC_RULE_STRUCT RC_S_BITS_WITHIN 5
  put rc_c_rule add rb 8 7
  ign5 = rc_add_rule RC_RULE_STRUCT RC_S_NONZERO 5
  rc_add_range 6 1 60000000
  rb = rc_add_cross 7 RC_EQ RC_NONE 1 3 RC_GUARD_BITS
  put rc_c_rule add rb 10 RC_RIGHT_EFFECT
end

fn rc_std_evidence to void
  rc_add_field RC_T_ENUM 0
  rc_add_field RC_T_U64 0
  rc_add_field RC_T_U64 0
  rc_add_field RC_T_U64 0
  rc_add_field RC_T_U64 0
  rc_add_field RC_T_ENUM 0
  rc_add_field RC_T_DIGEST 0
  rc_add_field RC_T_SUBJECT 0
  put rc_c_ord 0 7
  put rc_c_ord 1 0
  put rc_c_ord 2 1
  put rc_c_ord 3 2
  put rc_c_ord 4 3
  put rc_c_ord 5 5
  put rc_c_ord 6 4
  put rc_c_ord 7 6
  ign1 = rc_add_rule RC_RULE_AUTHORITY RC_A_PRINCIPAL 7
  rc_add_enum 0 14
  ign2 = rc_add_rule RC_RULE_STRUCT RC_S_NONZERO 1
  ign3 = rc_add_rule RC_RULE_STRUCT RC_S_NONZERO 2
  rc_add_range 3 1 4294967296
  rc_add_enum 5 6
  ign4 = rc_add_cross 4 RC_LE 3 0 RC_NONE RC_ALWAYS
  rb = rc_add_cross 4 RC_EQ RC_NONE 0 5 RC_GUARD_IN
  put rc_c_rule add rb 10 2
  rb = rc_add_cross 4 RC_GT RC_NONE 0 5 RC_GUARD_IN
  put rc_c_rule add rb 10 4
  ign5 = rc_add_rule RC_RULE_STRUCT RC_S_NONZERO 6
end

fn rc_std_gen_cand to void
  rc_add_field RC_T_U64 0
  rc_add_field RC_T_U64 0
  rc_add_field RC_T_U64 0
  rc_add_field RC_T_U64 0
  rc_add_field RC_T_BOOL 0
  rc_add_field RC_T_U32 0
  rc_add_field RC_T_SUBJECT 0
  rc_add_field RC_T_U64 0
  put rc_c_ord 0 6
  put rc_c_ord 1 1
  put rc_c_ord 2 0
  put rc_c_ord 3 2
  put rc_c_ord 4 7
  put rc_c_ord 5 3
  put rc_c_ord 6 4
  put rc_c_ord 7 5
  ign1 = rc_add_rule RC_RULE_AUTHORITY RC_A_PRINCIPAL 6
  ign2 = rc_add_rule RC_RULE_GENERATION RC_G_ACTIVE 1
  ign3 = rc_add_rule RC_RULE_GENERATION RC_G_NEXT 0
  ign4 = rc_add_cross 0 RC_GT 1 0 RC_NONE RC_ALWAYS
  ign5 = rc_add_rule RC_RULE_GENERATION RC_G_EPOCH 2
  rb = rc_add_rule RC_RULE_REFERENCE RC_R_CTX_VALUE 7
  put rc_c_rule add rb 8 0
  rb = rc_add_rule RC_RULE_EVIDENCE 0 3
  put rc_c_rule add rb 8 RC_EV_GENERATION
  rc_add_range 4 1 1
  rc_add_range 5 1 32
end

fn rc_contract_std kind ulong to long
  for i ulong 4
    put rc_c_meta i 0
  end
  put rc_c_meta 0 kind
  put rc_c_meta 3 add 23680 kind
  if eq kind RC_WORLD_MUTATION
    rc_std_world_mutation
    rc_contract_identify
    ret 0
  end
  if eq kind RC_CAPABILITY_NEED
    rc_std_cap_need
    rc_contract_identify
    ret 0
  end
  if eq kind RC_EVIDENCE
    rc_std_evidence
    rc_contract_identify
    ret 0
  end
  if eq kind RC_GENERATION_CANDIDATE
    rc_std_gen_cand
    rc_contract_identify
    ret 0
  end
  ret -1
end

fn rc_type_ok t ulong v ulong to ulong
  if or eq t RC_T_U64 eq t RC_T_DIGEST
    ret 1
  end
  if or eq t RC_T_U32 eq t RC_T_BITS
    if le v RC_U32_MAX
      ret 1
    end
    ret 0
  end
  if eq t RC_T_BOOL
    if le v 1
      ret 1
    end
    ret 0
  end
  if eq t RC_T_ENUM
    if lt v 64
      ret 1
    end
    ret 0
  end
  if eq t RC_T_OBJ
    if lt v RC_MAX_OBJECTS
      ret 1
    end
    ret 0
  end
  if eq t RC_T_SUBJECT
    if and ge v 1 le v RC_U32_MAX
      ret 1
    end
    ret 0
  end
  if eq t RC_T_RESOURCE
    if ne v 0
      ret 1
    end
    ret 0
  end
  ret 0
end

fn rc_type_hi t ulong to ulong
  if or eq t RC_T_U32 or eq t RC_T_BITS eq t RC_T_SUBJECT
    ret RC_U32_MAX
  end
  if eq t RC_T_BOOL
    ret 1
  end
  if eq t RC_T_ENUM
    ret 63
  end
  if eq t RC_T_OBJ
    ret sub RC_MAX_OBJECTS 1
  end
  ret RC_U64_MAX
end

fn rc_guard_holds rb ulong to ulong
  gm = get rc_c_rule add rb 5
  g = get rc_c_rule add rb 4
  if or eq gm RC_ALWAYS eq g RC_NONE
    ret 1
  end
  v = get rc_obj add 1 g
  kg = get rc_c_rule add rb 10
  if eq gm RC_GUARD_IN
    if lt v 64
      if ne and shr kg v 1 0
        ret 1
      end
    end
    ret 0
  end
  if ne and v kg 0
    ret 1
  end
  ret 0
end

fn rc_cmp_ok cmp ulong x ulong y ulong to ulong
  if eq cmp RC_EQ
    if eq x y
      ret 1
    end
    ret 0
  end
  if eq cmp RC_NE
    if ne x y
      ret 1
    end
    ret 0
  end
  if eq cmp RC_LT
    if lt x y
      ret 1
    end
    ret 0
  end
  if eq cmp RC_LE
    if le x y
      ret 1
    end
    ret 0
  end
  if eq cmp RC_GT
    if gt x y
      ret 1
    end
    ret 0
  end
  if eq cmp RC_GE
    if ge x y
      ret 1
    end
    ret 0
  end
  ret 0
end

fn rc_forbidden res ulong to ulong
  fhi = get rc_ctx 6
  if eq fhi 0
    ret 0
  end
  if and ge res get rc_ctx 5 le res fhi
    ret 1
  end
  ret 0
end

fn rc_held_rights res ulong to ulong
  have = ulong 0
  nc = get rc_ctx 10
  for i ulong nc bound 32
    if eq get rc_ctx_cap mul i 2 res
      have = or have get rc_ctx_cap add mul i 2 1
    end
  end
  ret have
end

fn rc_ev_pass skind ulong subj ulong to ulong
  ne_cnt = get rc_ctx 9
  for i ulong ne_cnt bound 64
    eb = mul i 3
    if eq get rc_ctx_ev eb skind
      if eq get rc_ctx_ev add eb 1 subj
        if eq get rc_ctx_ev add eb 2 RC_VERDICT_PASS
          ret 1
        end
      end
    end
  end
  ret 0
end

fn rc_res_live res ulong to ulong
  for i ulong RC_MAX_OBJECTS
    ob = mul i 3
    if ne get rc_w_obj ob 0
      if eq get rc_w_obj add ob 2 res
        ret 1
      end
    end
  end
  ret 0
end

fn rc_rule_holds_ref op ulong x ulong rb ulong to ulong
  if eq op RC_R_NEXT_SEQ
    if eq x get rc_ctx 1
      ret 1
    end
    ret 0
  end
  if eq op RC_R_OBJECT
    if lt x RC_MAX_OBJECTS
      if ne get rc_w_obj mul x 3 0
        ret 1
      end
    end
    ret 0
  end
  if eq op RC_R_RESOURCE_OF
    oid = get rc_obj add 1 get rc_c_rule add rb 3
    if lt oid RC_MAX_OBJECTS
      ob = mul oid 3
      if ne get rc_w_obj ob 0
        if eq get rc_w_obj add ob 2 x
          ret 1
        end
      end
    end
    ret 0
  end
  if eq op RC_R_RESOURCE_LIVE
    ret rc_res_live x
  end
  if eq op RC_R_CTX_VALUE
    k = get rc_c_rule add rb 8
    if lt k 4
      if eq x get rc_ctx_vals k
        ret 1
      end
    end
    ret 0
  end
  ret 0
end

fn rc_rule_holds_gen op ulong x ulong rb ulong to ulong
  if eq op RC_G_LIVE
    if lt x RC_MAX_OBJECTS
      ob = mul x 3
      if ne get rc_w_obj ob 0
        bf = get rc_c_rule add rb 3
        if eq get rc_w_obj add ob 1 get rc_obj add 1 bf
          ret 1
        end
      end
    end
    ret 0
  end
  if eq op RC_G_ACTIVE
    if eq x get rc_ctx 2
      ret 1
    end
    ret 0
  end
  if eq op RC_G_NEXT
    if gt x get rc_ctx 2
      ret 1
    end
    ret 0
  end
  if eq op RC_G_EPOCH
    if eq x get rc_ctx 3
      ret 1
    end
    ret 0
  end
  ret 0
end

fn rc_rule_holds rb ulong to ulong
  knd = get rc_c_rule rb
  op = get rc_c_rule add rb 1
  a = get rc_c_rule add rb 2
  x = get rc_obj add 1 a
  k = get rc_c_rule add rb 8
  if eq knd RC_RULE_RANGE
    if ge x k
      if le x get rc_c_rule add rb 9
        ret 1
      end
    end
    ret 0
  end
  if eq knd RC_RULE_ENUM
    if lt x 64
      if ne and shr k x 1 0
        ret 1
      end
    end
    ret 0
  end
  if eq knd RC_RULE_STRUCT
    if eq op RC_S_NONZERO
      if ne x 0
        ret 1
      end
      ret 0
    end
    if eq op RC_S_BITS_WITHIN
      if eq and x xor k RC_U64_MAX 0
        ret 1
      end
      ret 0
    end
    ret 0
  end
  if eq knd RC_RULE_CROSS
    if eq rc_guard_holds rb 0
      ret 1
    end
    b = get rc_c_rule add rb 3
    y = k
    if ne b RC_NONE
      y = add get rc_obj add 1 b k
    end
    ret rc_cmp_ok get rc_c_rule add rb 6 x y
  end
  if eq knd RC_RULE_AUTHORITY
    if eq op RC_A_PRINCIPAL
      if eq x get rc_ctx 0
        ret 1
      end
      ret 0
    end
    if eq op RC_A_HOLDS
      if ne k 0
        if eq and rc_held_rights x k k
          ret 1
        end
      end
      ret 0
    end
    if eq op RC_A_NO_PRIVILEGED
      if eq and x k 0
        ret 1
      end
      ret 0
    end
    ret 0
  end
  if eq knd RC_RULE_GENERATION
    ret rc_rule_holds_gen op x rb
  end
  if eq knd RC_RULE_REFERENCE
    ret rc_rule_holds_ref op x rb
  end
  if eq knd RC_RULE_EVIDENCE
    ret rc_ev_pass k x
  end
  if eq knd RC_RULE_EFFECT
    if eq op RC_E_FORBIDDEN
      if eq rc_forbidden x 0
        ret 1
      end
      ret 0
    end
    ret 0
  end
  ret 0
end

fn rc_add_viol r ulong f ulong k ulong to void
  n = get rc_v_meta 1
  vb = mul n 3
  put rc_v_list vb r
  put rc_v_list add vb 1 f
  put rc_v_list add vb 2 k
  put rc_v_meta 1 add n 1
  put rc_v_meta 2 or get rc_v_meta 2 shl 1 k
end

fn rc_check to long
  put rc_v_meta 0 0
  put rc_v_meta 1 0
  put rc_v_meta 2 0
  if ne get rc_obj 0 get rc_c_meta 0
    rc_add_viol RC_TYPE_RULE RC_NONE 0
    ret -1
  end
  nf = get rc_c_meta 1
  for i ulong nf bound 8
    t = get rc_c_fld mul i 3
    if eq rc_type_ok t get rc_obj add 1 i 0
      rc_add_viol RC_TYPE_RULE i 0
    end
  end
  i = nf
  while lt i RC_MAX_FIELDS bound 8
    if ne get rc_obj add 1 i 0
      rc_add_viol RC_TYPE_RULE i 0
    end
    i = add i 1
  end
  if eq get rc_v_meta 1 0
    nr = get rc_c_meta 2
    for r ulong nr bound 24
      rb = mul r 11
      if eq rc_rule_holds rb 0
        rc_add_viol r get rc_c_rule add rb 2 get rc_c_rule rb
      end
    end
  end
  if eq get rc_v_meta 1 0
    put rc_v_meta 0 1
    ret 0
  end
  ret -1
end

fn rc_repair_one rb ulong to long
  rep = get rc_c_rule add rb 7
  knd = get rc_c_rule rb
  op = get rc_c_rule add rb 1
  a = get rc_c_rule add rb 2
  k = get rc_c_rule add rb 8
  if eq rep RC_FIX_NARROW
    before = get rc_obj add 1 a
    if eq knd RC_RULE_STRUCT
      if eq op RC_S_BITS_WITHIN
        put rc_obj add 1 a and before k
        if ne get rc_obj add 1 a before
          ret 1
        end
        ret 0
      end
    end
    if eq knd RC_RULE_AUTHORITY
      if eq op RC_A_NO_PRIVILEGED
        put rc_obj add 1 a and before xor k RC_U64_MAX
        if ne get rc_obj add 1 a before
          ret 1
        end
        ret 0
      end
    end
    ret -1
  end
  if eq rep RC_FIX_DERIVE
    if eq get rc_c_fld add mul a 3 1 0
      ret -1
    end
    if eq knd RC_RULE_REFERENCE
      if eq op RC_R_NEXT_SEQ
        put rc_obj add 1 a get rc_ctx 1
        ret 1
      end
      if eq op RC_R_RESOURCE_OF
        oid = get rc_obj add 1 get rc_c_rule add rb 3
        if ge oid RC_MAX_OBJECTS
          ret -1
        end
        if eq get rc_w_obj mul oid 3 0
          ret -1
        end
        put rc_obj add 1 a get rc_w_obj add mul oid 3 2
        ret 1
      end
    end
    ret -1
  end
  ret -1
end

fn rc_repair to long
  nv = get rc_v_meta 1
  changed = ulong 0
  for i ulong nv bound 32
    r = get rc_v_list mul i 3
    if eq r RC_TYPE_RULE
      ret -1
    end
    c = rc_repair_one mul r 11
    if lt c 0
      ret -1
    end
    changed = add changed ulong c
  end
  ret long changed
end

fn rc_compile_rule i ulong to ulong
  rb = mul i 11
  knd = get rc_c_rule rb
  op = get rc_c_rule add rb 1
  a = get rc_c_rule add rb 2
  b = get rc_c_rule add rb 3
  g = get rc_c_rule add rb 4
  gm = get rc_c_rule add rb 5
  if eq knd RC_RULE_STRUCT
    if eq op RC_S_ACTION_GRAPH
      ret 0
    end
  end
  if eq knd RC_RULE_EFFECT
    if eq op RC_E_GRAPH_CLEAR
      ret 0
    end
  end
  if ne g RC_NONE
    if ne gm RC_ALWAYS
      if ge get rc_comp_pos g get rc_comp_pos a
        ret 0
      end
    end
  end
  if eq knd RC_RULE_CROSS
    if ne b RC_NONE
      if ge get rc_comp_pos b get rc_comp_pos a
        ret 0
      end
    end
  end
  if eq knd RC_RULE_GENERATION
    if eq op RC_G_LIVE
      if ge get rc_comp_pos a get rc_comp_pos b
        ret 0
      end
    end
  end
  ret 1
end

fn rc_compile to long
  nf = get rc_c_meta 1
  seen = ulong 0
  for i ulong nf bound 8
    o = get rc_c_ord i
    if ge o nf
      ret -1
    end
    if ne and seen shl 1 o 0
      ret -1
    end
    seen = or seen shl 1 o
    put rc_comp_pos o i
  end
  nr = get rc_c_meta 2
  enf_n = ulong 0
  post_n = ulong 0
  for i ulong nr bound 24
    e = rc_compile_rule i
    put rc_comp_enf i e
    if ne e 0
      enf_n = add enf_n 1
    else
      post_n = add post_n 1
    end
  end
  put rc_comp_cnt 0 enf_n
  put rc_comp_cnt 1 post_n
  ret 0
end

fn rc_domain_contains v ulong to ulong
  if ne get rc_dom 6 0
    ret 0
  end
  if or lt v get rc_dom 0 gt v get rc_dom 1
    ret 0
  end
  if ne get rc_dom 9 0
    if and ge v get rc_dom 10 le v get rc_dom 11
      ret 0
    end
  end
  if ne get rc_dom 4 0
    if ge v 64
      ret 0
    end
    if eq and shr get rc_dom 2 v 1 0
      ret 0
    end
  end
  if ne get rc_dom 3 0
    if ne and v xor get rc_dom 2 RC_U64_MAX 0
      ret 0
    end
  end
  nne = get rc_dom 8
  for i ulong nne bound 24
    if eq get rc_dom_ne i v
      ret 0
    end
  end
  if ne get rc_dom 5 0
    ns = get rc_dom 7
    for i ulong ns bound 64
      if eq get rc_dom_set i v
        ret 1
      end
    end
    ret 0
  end
  ret 1
end

fn rc_absdiff a ulong b ulong to ulong
  if gt a b
    ret sub a b
  end
  ret sub b a
end

fn rc_domain_pick v ulong out_v edit ulong 1 to long
  if ne get rc_dom 6 0
    ret -1
  end
  if ne rc_domain_contains v 0
    put out_v 0 v
    ret 0
  end
  found = ulong 0
  best = ulong 0
  if ne get rc_dom 5 0
    ns = get rc_dom 7
    for i ulong ns bound 64
      sv = get rc_dom_set i
      if ne rc_domain_contains sv 0
        if or eq found 0 lt rc_absdiff sv v rc_absdiff best v
          best = sv
          found = 1
        end
      end
    end
  else
    if ne get rc_dom 4 0
      for x ulong 64
        if ne rc_domain_contains x 0
          if or eq found 0 lt rc_absdiff x v rc_absdiff best v
            best = x
            found = 1
          end
        end
      end
    else
      if ne get rc_dom 3 0
        bmask = get rc_dom 2
        if ne rc_domain_contains and v bmask 0
          best = and v bmask
          found = 1
        else
          if ne rc_domain_contains bmask 0
            best = bmask
            found = 1
          else
            if ne rc_domain_contains get rc_dom 0 0
              best = get rc_dom 0
              found = 1
            end
          end
        end
      else
        c = v
        if lt c get rc_dom 0
          c = get rc_dom 0
        end
        if gt c get rc_dom 1
          c = get rc_dom 1
        end
        for step ulong 26
          if eq found 0
            if ne rc_domain_contains add c step 0
              best = add c step
              found = 1
            else
              if and ge c step ne rc_domain_contains sub c step 0
                best = sub c step
                found = 1
              end
            end
          end
        end
      end
    end
  end
  if eq found 0
    ret -1
  end
  put out_v 0 best
  ret 0
end

fn rc_encode to ulong
  nf = get rc_c_meta 1
  knd = get rc_obj 0
  for j ulong 4
    put rc_bin j uchar and shr knd mul j 8 255
  end
  for i ulong 32
    put rc_bin add 4 i get rc_c_ident i
  end
  for i ulong nf bound 8
    v = get rc_obj add 1 i
    base = add 36 mul i 8
    for j ulong 8
      put rc_bin add base j uchar and shr v mul j 8 255
    end
  end
  ret add 36 mul nf 8
end

fn rc_decode n ulong to long
  nf = get rc_c_meta 1
  if ne n add 36 mul nf 8
    ret -1
  end
  knd = ulong 0
  for j ulong 4
    knd = or knd shl ulong get rc_bin j mul j 8
  end
  if ne knd get rc_c_meta 0
    ret -1
  end
  for i ulong 32
    if ne get rc_bin add 4 i get rc_c_ident i
      ret -1
    end
  end
  put rc_obj 0 knd
  for i ulong RC_MAX_FIELDS
    put rc_obj add 1 i 0
  end
  for i ulong nf bound 8
    base = add 36 mul i 8
    v = ulong 0
    for j ulong 8
      v = or v shl ulong get rc_bin add base j mul j 8
    end
    put rc_obj add 1 i v
  end
  ret 0
end

fn rc_identity to void
  n = rc_encode
  for i ulong n bound 160
    put sh_dat i get rc_bin i
  end
  sh_all n
  for i ulong 32
    put rc_obj_id i get sh_dig i
  end
end

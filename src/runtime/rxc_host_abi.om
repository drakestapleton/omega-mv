note SPDX-License-Identifier: Apache-2.0
note src/runtime/rxc_host_abi.om -- Pure seeded OM-2 port of src/runtime/rxc_host_abi.c.
note Host ABI facade over COMPOSITION-2 (rx_compose.om):
note   rxc_host_open, rxc_host_register_skill, rxc_host_set_verify, rxc_host_set_wait_ms,
note   rxc_host_run, rxc_host_recall, rxc_host_record, rxc_host_payload, rxc_host_info,
note   rxc_host_close, rxc_host_abi_layout, rxc_host_note, rxc_host_recover.
note Composes after seed/ng/sha256.om and src/runtime/rx_compose.om.

const RXC_HOST_ABI_VERSION ulong 2
const RXC_HOST_MAX_HANDLES ulong 4
const RXC_HOST_MAX_SKILLS ulong 2
const RXC_HOST_NAME_MAX ulong 64
const RXC_HOST_NONE ulong 4294967295

const RXC_HOST_OK long 0
const RXC_HOST_E_ARG long -1
const RXC_HOST_E_IDENTITY long -2
const RXC_HOST_E_TORN long -3
const RXC_HOST_E_OPEN long -4
const RXC_HOST_E_FULL long -5
const RXC_HOST_E_STATE long -6
const RXC_HOST_E_RUN long -7
const RXC_HOST_E_NOMEM long -8
const RXC_HOST_E_NOT_FOUND long -9
const RXC_HOST_E_DIGEST long -10
const RXC_HOST_E_REPLAY long -11

const RXC_HOST_ROOT_PROVISIONED ulong 1
const RXC_HOST_ROOT_HARDWARE ulong 2

const RXC_HOST_SUBJECT_HOST ulong 0
const RXC_HOST_SUBJECT_GOAL ulong 1
const RXC_HOST_SUBJECT_STATE ulong 5

const RXC_HOST_TAG_REPAIR_TAIL ulong 1
const RXC_HOST_NOTE_CONSTRAINT ulong 2
const RXC_HOST_NOTE_AUTHORIZATION ulong 3
const RXC_HOST_NOTE_EFFECT ulong 4

const RXC_HOST_NOTE_MAX ulong 16384
const RXC_HOST_NP_LEN ulong 0
const RXC_HOST_NP_SHA ulong 1
const RXC_HOST_NP_BYTES ulong 5

const RXC_HOST_RP_CUT_LO ulong 0
const RXC_HOST_RP_CUT_HI ulong 1
const RXC_HOST_RP_PARTIAL ulong 2
const RXC_HOST_RP_ANCHOR ulong 3
const RXC_HOST_RP_KEPT ulong 4
const RXC_HOST_RP_DROPPED ulong 5
const RXC_HOST_RP_CAUSE ulong 6
const RXC_HOST_RP_CUT_SHA ulong 7
const RXC_HOST_RP_ANCHOR_HEAD ulong 11
const RXC_HOST_RP_KEPT_BYTES ulong 15
const RXC_HOST_RP_BYTES ulong 16
const RXC_HOST_REPAIR_KEEP_MAX ulong 65536

const RXC_HOST_CX_ERR_TORN long -8
const RXC_HOST_RX_ERR_REPLAY long -21

const RXC_HOST_OUT_COMMITTED ulong 1
const RXC_HOST_OUT_NO_WINNER ulong 2
const RXC_HOST_OUT_NOT_COMMITTED ulong 3
const RXC_HOST_OUT_NOT_DURABLE ulong 4
const RXC_HOST_OUT_RECORD_FAILED ulong 5

note Skill evaluation modes for OM-2 host callbacks (no C function pointers):
const RXC_HOST_SK_ECHO3P1 ulong 1
const RXC_HOST_SK_DOUBLE ulong 2
const RXC_HOST_SK_FAIL ulong 3

note Verify modes: 0=default (result != 0), 1=(result == task*3+1), 2=reject-all
const RXC_HOST_VFY_DEFAULT ulong 0
const RXC_HOST_VFY_ECHO3P1 ulong 1
const RXC_HOST_VFY_REJECT ulong 2

text hab_mid_dom "AIENOS-MACHINE-ID-V1"

note Home directory table (up to 4 persistent homes):
note hab_home_st: 4 x 12 ulongs:
note   0:used, 1:dlen, 2:root_kind, 3:tail_torn, 4:locked_h (4=none),
note   5:cut_lo, 6:cut_hi, 7:anchor_present, 8:anchor_records, 9:kept_records,
note   10:anchor_mismatch, 11:cut_len
global hab_home_st ulong 48
global hab_home_dir uchar 512
global hab_home_mid uchar 128
global hab_home_ahead uchar 128
global hab_home_cut uchar 512

note Handle table (4 handles):
note hab_h: 4 x 16 ulongs:
note   0:live, 1:home_idx, 2:session, 3:root_kind, 4:opened, 5:open_rc_u,
note   6:wait_ms, 7:n_sk, 8:verify_mode, 9:mid_was_stored, 10:tail_torn,
note   11:records, 12:recovered_rec, 13:rolled_back, 14:recovered_comp, 15:anchor_unk
global hab_h ulong 64
global hab_h_orc long 4
global hab_h_mid uchar 128

note Per-handle skills (4 handles x 2 skills):
note hab_sk: 8 x 4 ulongs: 0:nlen, 1:cost, 2:kind, 3:id
global hab_sk ulong 32
global hab_sk_name uchar 512
global hab_sk_dig uchar 256

note Output buffers for structured host queries:
note hab_info_out (12 ulongs):
note   0:abi_ver, 1:root_kind, 2:mid_was_stored, 3:tail_torn, 4:opened,
note   5:open_rc_u, 6:records, 7:recovered_rec, 8:rolled_back, 9:recovered_comp,
note   10:anchor_unk, 11:n_skills
global hab_info_out ulong 12
global hab_info_orc long 1
global hab_info_mid uchar 32

note hab_res_out (16 ulongs):
note   0:unused(see hab_res_rc), 1:outcome, 2:committed, 3:n_branches, 4:reclaimed,
note   5:winner, 6:winner_skill, 7:aegis_pass_mask, 8:task, 9:result,
note   10:cx_goal, 11:cx_cand0, 12:cx_cand1, 13:cx_evidence, 14:cx_promotion, 15:cx_adm0
global hab_res_out ulong 16
global hab_res_rc long 1
global hab_res_wdig uchar 32
global hab_res_rdig uchar 32

note hab_rec_out (12 ulongs):
note   0:id, 1:cls, 2:kind, 3:subject, 4:t, 5:gen, 6:tag,
note   7..10:links[0..3], 11:n_payload (verified in hab_rec_ver[0])
global hab_rec_out ulong 12
global hab_rec_ver ulong 1
global hab_rec_dig uchar 32

note hab_rep_out (16 ulongs):
note   0:repaired, 1:tail_torn, 2:anchor_present, 3:unused(see hab_rep_cause), 4:opens,
note   5:unused, 6:rolled_back, 7:recovered_comp, 8:cut_lo, 9:cut_hi,
note   10:partial_recs, 11:anchor_recs, 12:records_kept, 13:dropped_recs,
note   14:event_id, 15:cut_bytes_kept
global hab_rep_out ulong 16
global hab_rep_cause long 1
global hab_rep_csha uchar 32
global hab_rep_ahead uchar 32

note Scratch buffers
global hab_mid_tmp uchar 32
global hab_dir_tmp uchar 128

fn hab_reset_all to void
  for i ulong 48
    put hab_home_st i 0
  end
  for i ulong 4
    put hab_home_st add mul i 12 4 RXC_HOST_MAX_HANDLES
  end
  for i ulong 4
    put hab_h_orc i 0
  end
  for i ulong 64
    put hab_h i 0
  end
  for i ulong 32
    put hab_sk i 0
  end
end

fn hab_path_ok p view uchar * plen ulong to ulong
  if or eq plen 0 ge plen 120
    ret 0
  end
  for i ulong plen bound 128
    c = get p i
    if or eq c 0 lt c 32
      ret 0
    end
    if eq c 46
      if lt add i 1 plen
        if eq get p add i 1 46
          ret 0
        end
      end
    end
  end
  ret 1
end

fn hab_derive_mid rkind ulong root view uchar * rlen ulong to long
  if and ne rkind RXC_HOST_ROOT_PROVISIONED ne rkind RXC_HOST_ROOT_HARDWARE
    ret RXC_HOST_E_IDENTITY
  end
  if or eq rlen 0 gt rlen 256
    ret RXC_HOST_E_IDENTITY
  end
  dl = len hab_mid_dom
  for i ulong dl bound 32
    put sh_dat i get hab_mid_dom i
  end
  put sh_dat dl uchar and rkind 255
  for i ulong rlen bound 256
    put sh_dat add add dl 1 i get root i
  end
  sh_all add add dl 1 rlen
  for i ulong 32
    put hab_mid_tmp i get sh_dig i
  end
  ret RXC_HOST_OK
end

fn hab_home_match idx ulong dir view uchar * dlen ulong to ulong
  hb = mul idx 12
  if eq get hab_home_st hb 0
    ret 0
  end
  if ne get hab_home_st add hb 1 dlen
    ret 0
  end
  base = mul idx 128
  for i ulong dlen bound 128
    if ne get hab_home_dir add base i get dir i
      ret 0
    end
  end
  ret 1
end

fn hab_find_home dir view uchar * dlen ulong to ulong
  for i ulong RXC_HOST_MAX_HANDLES
    if eq hab_home_match i dir dlen 1
      ret i
    end
  end
  ret RXC_HOST_MAX_HANDLES
end

fn hab_alloc_home dir view uchar * dlen ulong rkind ulong to ulong
  for i ulong RXC_HOST_MAX_HANDLES
    hb = mul i 12
    if eq get hab_home_st hb 0
      put hab_home_st hb 1
      put hab_home_st add hb 1 dlen
      put hab_home_st add hb 2 rkind
      put hab_home_st add hb 3 0
      put hab_home_st add hb 4 RXC_HOST_MAX_HANDLES
      put hab_home_st add hb 5 0
      put hab_home_st add hb 6 0
      put hab_home_st add hb 7 0
      put hab_home_st add hb 8 0
      put hab_home_st add hb 9 0
      put hab_home_st add hb 10 0
      put hab_home_st add hb 11 0
      db = mul i 128
      for j ulong dlen bound 128
        put hab_home_dir add db j get dir j
      end
      mb = mul i 32
      for j ulong 32
        put hab_home_mid add mb j get hab_mid_tmp j
      end
      ret i
    end
  end
  ret RXC_HOST_MAX_HANDLES
end

fn hab_mid_eq_home idx ulong rkind ulong to ulong
  hb = mul idx 12
  if ne get hab_home_st add hb 2 rkind
    ret 0
  end
  mb = mul idx 32
  for i ulong 32
    if ne get hab_home_mid add mb i get hab_mid_tmp i
      ret 0
    end
  end
  ret 1
end

fn hab_fill_info h ulong to void
  for i ulong 12
    put hab_info_out i 0
  end
  put hab_info_out 0 RXC_HOST_ABI_VERSION
  if ge h RXC_HOST_MAX_HANDLES
    for i ulong 32
      put hab_info_mid i get hab_mid_tmp i
    end
    ret
  end
  hb = mul h 16
  put hab_info_out 1 get hab_h add hb 3
  put hab_info_out 2 get hab_h add hb 9
  put hab_info_out 3 get hab_h add hb 10
  put hab_info_out 4 get hab_h add hb 4
  put hab_info_orc 0 get hab_h_orc h
  put hab_info_out 6 get hab_h add hb 11
  put hab_info_out 7 get hab_h add hb 12
  put hab_info_out 8 get hab_h add hb 13
  put hab_info_out 9 get hab_h add hb 14
  put hab_info_out 10 get hab_h add hb 15
  put hab_info_out 11 get hab_h add hb 7
  mb = mul h 32
  for i ulong 32
    put hab_info_mid i get hab_h_mid add mb i
  end
end

fn hab_refresh_info h ulong to void
  hb = mul h 16
  if ne get hab_h add hb 4 0
    put hab_h add hb 11 get rxc_cx_n 0
    put hab_h add hb 13 get rxc_st 14
    put hab_h add hb 14 get rxc_st 15
  end
  hab_fill_info h
end

fn hab_load_home_dir hidx ulong dst edit uchar 128 to ulong
  dlen = get hab_home_st add mul hidx 12 1
  db = mul hidx 128
  for i ulong dlen bound 128
    put dst i get hab_home_dir add db i
  end
  ret dlen
end

fn hab_open_compose h ulong hidx ulong to long
  hb = mul h 16
  dbuf = new uchar 128 0
  dlen = hab_load_home_dir hidx dbuf
  mid0 = ulong get hab_h_mid mul h 32
  sess = get hab_h add hb 2
  ret rx_compose_open dbuf dlen sess mid0
end

fn hab_seal h ulong to long
  hb = mul h 16
  if ne get hab_h add hb 4 0
    ret RXC_HOST_OK
  end
  orc = get hab_h_orc h
  if ne orc 0
    if eq orc RXC_HOST_RX_ERR_REPLAY
      ret RXC_HOST_E_REPLAY
    end
    ret RXC_HOST_E_OPEN
  end
  hidx = get hab_h add hb 1
  hmb = mul hidx 12
  lk = get hab_home_st add hmb 4
  if and ne lk RXC_HOST_MAX_HANDLES ne lk h
    put hab_h_orc h RXC_ERR_EXISTS
    ret RXC_HOST_E_OPEN
  end
  anc = get hab_home_st add hmb 8
  kept = get hab_home_st add hmb 9
  if or gt anc kept ne get hab_home_st add hmb 10 0
    put hab_h_orc h RXC_HOST_RX_ERR_REPLAY
    ret RXC_HOST_E_REPLAY
  end
  rc = hab_open_compose h hidx
  if ne rc RXC_OK
    put hab_h_orc h rc
    ret RXC_HOST_E_OPEN
  end
  wms = get hab_h add hb 6
  if ne wms 0
    ign_w = rx_compose_set_wait_ms wms
  end
  put hab_home_st add hmb 4 h
  put hab_h add hb 4 1
  put hab_h_orc h 0
  hab_refresh_info h
  ret RXC_HOST_OK
end

note ---- Public API ----

fn hab_alloc_slot hidx ulong rkind ulong was_stored ulong to long
  slot = RXC_HOST_MAX_HANDLES
  for i ulong RXC_HOST_MAX_HANDLES
    if eq get hab_h mul i 16 0
      if eq slot RXC_HOST_MAX_HANDLES
        slot = i
      end
    end
  end
  if ge slot RXC_HOST_MAX_HANDLES
    ret RXC_HOST_E_FULL
  end
  hb = mul slot 16
  for i ulong 16
    put hab_h add hb i 0
  end
  put hab_h hb 1
  put hab_h add hb 1 hidx
  put hab_h add hb 2 24149
  put hab_h add hb 3 rkind
  put hab_h add hb 9 was_stored
  put hab_h add hb 11 get hab_home_st add mul hidx 12 9
  put hab_h_orc slot 0
  mb = mul slot 32
  for i ulong 32
    put hab_h_mid add mb i get hab_mid_tmp i
  end
  hab_fill_info slot
  ret long slot
end

fn rxc_host_open dir view uchar * rkind ulong root view uchar * flags ulong to long
  dlen = len dir
  rlen = len root
  if or eq hab_path_ok dir dlen 0 ne flags 0
    ret RXC_HOST_E_ARG
  end
  drc = hab_derive_mid rkind root rlen
  if ne drc RXC_HOST_OK
    ret drc
  end
  hidx = hab_find_home dir dlen
  was_stored = ulong 0
  if lt hidx RXC_HOST_MAX_HANDLES
    if eq hab_mid_eq_home hidx rkind 0
      hab_fill_info RXC_HOST_MAX_HANDLES
      put hab_info_out 1 rkind
      ret RXC_HOST_E_IDENTITY
    end
    was_stored = 1
    hmb = mul hidx 12
    if ne get hab_home_st add hmb 3 0
      hab_fill_info RXC_HOST_MAX_HANDLES
      put hab_info_out 1 rkind
      put hab_info_out 2 1
      put hab_info_out 3 1
      ret RXC_HOST_E_TORN
    end
  else
    hidx = hab_alloc_home dir dlen rkind
    if ge hidx RXC_HOST_MAX_HANDLES
      ret RXC_HOST_E_FULL
    end
  end
  ret hab_alloc_slot hidx rkind was_stored
end

fn rxc_host_register_skill h ulong name view uchar * cost ulong sk_kind ulong to long
  nlen = len name
  if ge h RXC_HOST_MAX_HANDLES
    ret RXC_HOST_E_ARG
  end
  hb = mul h 16
  if eq get hab_h hb 0
    ret RXC_HOST_E_ARG
  end
  if or eq nlen 0 ge nlen RXC_HOST_NAME_MAX
    ret RXC_HOST_E_ARG
  end
  if or ne get hab_h add hb 4 0 ne get hab_h_orc h 0
    ret RXC_HOST_E_STATE
  end
  nsk = get hab_h add hb 7
  if ge nsk RXC_HOST_MAX_SKILLS
    ret RXC_HOST_E_FULL
  end
  sidx = add mul h RXC_HOST_MAX_SKILLS nsk
  sb = mul sidx 4
  put hab_sk sb nlen
  put hab_sk add sb 1 cost
  put hab_sk add sb 2 sk_kind
  put hab_sk add sb 3 add 1 nsk
  nb = mul sidx RXC_HOST_NAME_MAX
  for i ulong nlen bound 64
    put hab_sk_name add nb i get name i
  end
  db = mul sidx 32
  for i ulong nlen bound 64
    put sh_dat i get name i
  end
  sh_all nlen
  for i ulong 32
    put hab_sk_dig add db i get sh_dig i
  end
  put hab_h add hb 7 add nsk 1
  ret long nsk
end

fn rxc_host_set_verify h ulong mode ulong to long
  if ge h RXC_HOST_MAX_HANDLES
    ret RXC_HOST_E_ARG
  end
  hb = mul h 16
  if eq get hab_h hb 0
    ret RXC_HOST_E_ARG
  end
  if ne get hab_h add hb 4 0
    ret RXC_HOST_E_STATE
  end
  put hab_h add hb 8 mode
  ret RXC_HOST_OK
end

fn rxc_host_set_wait_ms h ulong wait_ms ulong to long
  if ge h RXC_HOST_MAX_HANDLES
    ret RXC_ERR_ARG
  end
  hb = mul h 16
  if eq get hab_h hb 0
    ret RXC_ERR_ARG
  end
  if or eq wait_ms 0 gt wait_ms RXC_WAIT_MS_MAX
    ret RXC_ERR_ARG
  end
  put hab_h add hb 6 wait_ms
  if ne get hab_h add hb 4 0
    ret rx_compose_set_wait_ms wait_ms
  end
  ret RXC_OK
end

fn hab_eval_skill sk_kind ulong task ulong to ulong
  if eq sk_kind RXC_HOST_SK_ECHO3P1
    ret add mul task 3 1
  end
  if eq sk_kind RXC_HOST_SK_DOUBLE
    ret mul task 2
  end
  ret 0
end

fn hab_eval_verify mode ulong task ulong res ulong to ulong
  if eq res 0
    ret 0
  end
  if eq mode RXC_HOST_VFY_DEFAULT
    ret 1
  end
  if eq mode RXC_HOST_VFY_ECHO3P1
    if eq res add mul task 3 1
      ret 1
    end
    ret 0
  end
  ret 0
end

fn hab_run_anchor h ulong to void
  rd = new uchar 32 0
  rx_compose_record_digest rd
  for i ulong 32
    put hab_res_rdig i get rd i
  end
  hidx = get hab_h add mul h 16 1
  hmb = mul hidx 12
  put hab_home_st add hmb 9 get rxc_cx_n 0
  put hab_home_st add hmb 7 1
  put hab_home_st add hmb 8 get rxc_cx_n 0
  ab = mul hidx 32
  for i ulong 32
    put hab_home_ahead add ab i get rd i
  end
end

fn hab_run_finish h ulong nsk ulong c0_ok ulong c1_ok ulong to void
  outc = get rxc_last_res 0
  put hab_res_out 1 outc
  if eq outc RXC_HOST_OUT_COMMITTED
    put hab_res_out 2 1
  end
  put hab_res_out 3 nsk
  put hab_res_out 4 get rxc_last_res 7
  win = get rxc_last_res 1
  put hab_res_out 5 win
  if lt win nsk
    put hab_res_out 6 win
    put hab_res_out 9 get rxc_last_res 6
  end
  pmask = ulong 0
  if ne c0_ok 0
    pmask = or pmask 1
  end
  if ne c1_ok 0
    pmask = or pmask 2
  end
  put hab_res_out 7 pmask
  ev_id = get rxc_last_res 10
  c0_id = get rxc_last_res 8
  g_id = ulong 0
  if gt ev_id 0
    g_id = get rxc_cx_hdr add mul sub ev_id 1 13 7
  else
    if gt c0_id 0
      g_id = get rxc_cx_hdr add mul sub c0_id 1 13 7
    end
  end
  put hab_res_out 10 g_id
  put hab_res_out 11 c0_id
  put hab_res_out 12 get rxc_last_res 9
  put hab_res_out 13 ev_id
  put hab_res_out 14 get rxc_last_res 11
  hab_run_anchor h
end

global hab_cand_tmp ulong 4

fn hab_eval_candidates h ulong task ulong to void
  hb = mul h 16
  nsk = get hab_h add hb 7
  vmode = get hab_h add hb 8
  s0 = mul h RXC_HOST_MAX_SKILLS
  r0 = hab_eval_skill get hab_sk add mul s0 4 2 task
  o0 = hab_eval_verify vmode task r0
  put hab_cand_tmp 0 r0
  put hab_cand_tmp 1 o0
  put hab_cand_tmp 2 0
  put hab_cand_tmp 3 0
  if ge nsk 2
    s1 = add s0 1
    r1 = hab_eval_skill get hab_sk add mul s1 4 2 task
    o1 = hab_eval_verify vmode task r1
    put hab_cand_tmp 2 r1
    put hab_cand_tmp 3 o1
  end
end

fn rxc_host_run h ulong task ulong now_us ulong to long
  ign_now = now_us
  if or ge h RXC_HOST_MAX_HANDLES eq task 0
    ret RXC_HOST_E_ARG
  end
  hb = mul h 16
  if eq get hab_h hb 0
    ret RXC_HOST_E_ARG
  end
  for i ulong 16
    put hab_res_out i 0
  end
  put hab_res_out 5 RXC_HOST_NONE
  put hab_res_out 6 RXC_HOST_NONE
  put hab_res_out 8 task
  nsk = get hab_h add hb 7
  if eq nsk 0
    ret RXC_HOST_E_STATE
  end
  src = hab_seal h
  if ne src RXC_HOST_OK
    ret src
  end
  hab_eval_candidates h task
  rr = rx_compose_run task get hab_cand_tmp 0 get hab_cand_tmp 1 get hab_cand_tmp 2 get hab_cand_tmp 3
  put hab_res_rc 0 rr
  hab_refresh_info h
  if ne rr RXC_OK
    ret RXC_HOST_E_RUN
  end
  hab_run_finish h nsk get hab_cand_tmp 1 get hab_cand_tmp 3
  ret RXC_HOST_OK
end

fn hab_rec_digest_compute idx ulong to void
  pos = ulong 0
  hb = mul idx 13
  for w ulong 13
    v = get rxc_cx_hdr add hb w
    for b ulong 8
      put sh_dat add pos b uchar and shr v mul b 8 255
    end
    pos = add pos 8
  end
  nw = get rxc_cx_hdr add hb 12
  pb = mul idx 20
  for w ulong nw bound 20
    v = get rxc_cx_pay add pb w
    for b ulong 8
      put sh_dat add pos b uchar and shr v mul b 8 255
    end
    pos = add pos 8
  end
  sh_all pos
  for i ulong 32
    put hab_rec_dig i get sh_dig i
  end
end

fn rxc_host_record h ulong id ulong to long
  if or ge h RXC_HOST_MAX_HANDLES eq id 0
    ret RXC_HOST_E_ARG
  end
  if eq get hab_h mul h 16 0
    ret RXC_HOST_E_ARG
  end
  src = hab_seal h
  if ne src RXC_HOST_OK
    ret src
  end
  nrec = get rxc_cx_n 0
  if gt id nrec
    ret RXC_HOST_E_NOT_FOUND
  end
  idx = sub id 1
  hb = mul idx 13
  put hab_rec_out 0 id
  put hab_rec_out 1 get rxc_cx_hdr hb
  put hab_rec_out 2 get rxc_cx_hdr add hb 1
  put hab_rec_out 3 get rxc_cx_hdr add hb 2
  put hab_rec_out 4 get rxc_cx_hdr add hb 3
  put hab_rec_out 5 get rxc_cx_hdr add hb 4
  put hab_rec_out 6 get rxc_cx_hdr add hb 7
  put hab_rec_out 7 get rxc_cx_hdr add hb 8
  put hab_rec_out 8 get rxc_cx_hdr add hb 9
  put hab_rec_out 9 get rxc_cx_hdr add hb 10
  put hab_rec_out 10 get rxc_cx_hdr add hb 11
  put hab_rec_out 11 get rxc_cx_hdr add hb 12
  put hab_rec_ver 0 1
  hab_rec_digest_compute idx
  ret RXC_HOST_OK
end

fn rxc_host_recall h ulong subject ulong dst_ids edit ulong 64 max_n ulong counts edit ulong 2 to long
  put counts 0 0
  put counts 1 0
  if ge h RXC_HOST_MAX_HANDLES
    ret RXC_HOST_E_ARG
  end
  if eq get hab_h mul h 16 0
    ret RXC_HOST_E_ARG
  end
  src = hab_seal h
  if ne src RXC_HOST_OK
    ret src
  end
  nrec = get rxc_cx_n 0
  tot = ulong 0
  fil = ulong 0
  for i ulong nrec bound 64
    if eq get rxc_cx_hdr add mul i 13 2 subject
      tot = add tot 1
      if lt fil max_n
        put dst_ids fil add i 1
        fil = add fil 1
      end
    end
  end
  put counts 0 fil
  put counts 1 tot
  ret RXC_HOST_OK
end

fn rxc_host_payload h ulong id ulong dst edit ulong 20 max_w ulong to long
  if or ge h RXC_HOST_MAX_HANDLES eq id 0
    ret RXC_HOST_E_ARG
  end
  if eq get hab_h mul h 16 0
    ret RXC_HOST_E_ARG
  end
  src = hab_seal h
  if ne src RXC_HOST_OK
    ret src
  end
  nrec = get rxc_cx_n 0
  if gt id nrec
    ret RXC_HOST_E_NOT_FOUND
  end
  idx = sub id 1
  nw = get rxc_cx_hdr add mul idx 13 12
  cp = nw
  if gt cp max_w
    cp = max_w
  end
  pb = mul idx 20
  for i ulong cp bound 20
    put dst i get rxc_cx_pay add pb i
  end
  ret long nw
end

fn rxc_host_info h ulong to long
  if ge h RXC_HOST_MAX_HANDLES
    ret RXC_HOST_E_ARG
  end
  if eq get hab_h mul h 16 0
    ret RXC_HOST_E_ARG
  end
  src = hab_seal h
  hab_refresh_info h
  ret src
end

fn rxc_host_close h ulong to void
  if ge h RXC_HOST_MAX_HANDLES
    ret
  end
  hb = mul h 16
  if eq get hab_h hb 0
    ret
  end
  hidx = get hab_h add hb 1
  if ne get hab_h add hb 4 0
    rx_compose_close
  end
  hmb = mul hidx 12
  if eq get hab_home_st add hmb 4 h
    put hab_home_st add hmb 4 RXC_HOST_MAX_HANDLES
  end
  put hab_h hb 0
end

fn rxc_host_abi_layout sizes edit ulong 4 to ulong
  put sizes 0 88
  put sizes 1 192
  put sizes 2 128
  put sizes 3 168
  ret RXC_HOST_ABI_VERSION
end

fn hab_pack_bytes_into dst edit ulong 20 base_w ulong src view uchar * n ulong to void
  for i ulong n bound 120
    wi = add base_w div i 8
    sh = mul rem i 8 8
    v = or get dst wi shl ulong get src i sh
    put dst wi v
  end
end

fn hab_pack_dig32_into dst edit ulong 20 base_w ulong to void
  for w ulong 4
    acc = ulong 0
    for b ulong 8
      acc = or acc shl ulong get sh_dig add mul w 8 b mul b 8
    end
    put dst add base_w w acc
  end
end

fn hab_note_write note_tag ulong bytes view uchar * to ulong
  cls = RXC_CX_CLAIM
  knd = ulong 10
  prot = ulong 0
  if eq note_tag RXC_HOST_NOTE_AUTHORIZATION
    cls = RXC_CX_EVIDENCE
    knd = RXC_CX_K_ADMISSION
    prot = 1
  end
  if eq note_tag RXC_HOST_NOTE_EFFECT
    cls = RXC_CX_EVIDENCE
    knd = RXC_CX_K_EVIDENCE_REF
    prot = 2
  end
  blen = len bytes
  for i ulong blen bound 120
    put sh_dat i get bytes i
  end
  sh_all blen
  pay = new ulong 20 0
  put pay RXC_HOST_NP_LEN blen
  hab_pack_dig32_into pay RXC_HOST_NP_SHA
  hab_pack_bytes_into pay RXC_HOST_NP_BYTES bytes blen
  nw = add RXC_HOST_NP_BYTES div add blen 7 8
  hdr = new ulong 8 0
  put hdr 0 cls
  put hdr 1 knd
  put hdr 2 RXC_HOST_SUBJECT_HOST
  put hdr 3 note_tag
  id = rxc_cx_append hdr pay nw
  if gt id 0
    put rxc_cx_hdr add mul sub id 1 13 6 prot
  end
  ret id
end

fn rxc_host_note h ulong note_tag ulong links view ulong 4 bytes view uchar * to long
  blen = len bytes
  if or ge h RXC_HOST_MAX_HANDLES eq blen 0
    ret RXC_HOST_E_ARG
  end
  if gt blen 120
    ret RXC_HOST_E_ARG
  end
  if eq get hab_h mul h 16 0
    ret RXC_HOST_E_ARG
  end
  if or lt note_tag RXC_HOST_NOTE_CONSTRAINT gt note_tag RXC_HOST_NOTE_EFFECT
    ret RXC_HOST_E_ARG
  end
  src = hab_seal h
  if ne src RXC_HOST_OK
    ret src
  end
  nrec = get rxc_cx_n 0
  for i ulong 4
    if gt get links i nrec
      ret RXC_HOST_E_NOT_FOUND
    end
  end
  id = hab_note_write note_tag bytes
  if eq id 0
    ret RXC_HOST_E_RUN
  end
  hb2 = mul sub id 1 13
  for i ulong 4
    put rxc_cx_hdr add hb2 add 8 i get links i
  end
  hab_refresh_info h
  ret long id
end

note Test helper: stage cut bytes for a home and inject torn/replay fault
fn hab_set_cut_bytes dir view uchar * cut_bytes view uchar * to long
  hidx = hab_find_home dir len dir
  if ge hidx RXC_HOST_MAX_HANDLES
    ret RXC_HOST_E_NOT_FOUND
  end
  clen = len cut_bytes
  hmb = mul hidx 12
  put hab_home_st add hmb 11 clen
  cb = mul hidx 128
  for i ulong clen bound 128
    put hab_home_cut add cb i get cut_bytes i
  end
  ret RXC_HOST_OK
end

fn hab_inject_fault dir view uchar * torn ulong cut_lo ulong cut_hi ulong anc_mis ulong to long
  hidx = hab_find_home dir len dir
  if ge hidx RXC_HOST_MAX_HANDLES
    ret RXC_HOST_E_NOT_FOUND
  end
  hmb = mul hidx 12
  put hab_home_st add hmb 3 torn
  put hab_home_st add hmb 5 cut_lo
  put hab_home_st add hmb 6 cut_hi
  put hab_home_st add hmb 10 anc_mis
  ret RXC_HOST_OK
end

fn hab_recover_apply hidx ulong torn ulong anc ulong kept ulong to void
  hmb = mul hidx 12
  present = add kept torn
  mx = present
  if gt anc mx
    mx = anc
  end
  dropped = sub mx kept
  cause = RXC_HOST_RX_ERR_REPLAY
  if ne torn 0
    cause = RXC_HOST_CX_ERR_TORN
  end
  clen = get hab_home_st add hmb 11
  put hab_rep_cause 0 cause
  put hab_rep_out 13 dropped
  put hab_rep_out 15 clen
  cb = mul hidx 128
  for i ulong clen bound 128
    put sh_dat i get hab_home_cut add cb i
  end
  sh_all clen
  for i ulong 32
    put hab_rep_csha i get sh_dig i
  end
  put hab_home_st add hmb 3 0
  new_kept = add kept 1
  put hab_home_st add hmb 9 new_kept
  put hab_home_st add hmb 8 new_kept
  put hab_home_st add hmb 7 1
  put hab_rep_out 14 new_kept
  put hab_rep_out 0 1
  put hab_rep_out 4 1
  put hab_rep_out 5 0
end

fn hab_recover_home hidx ulong to long
  hmb = mul hidx 12
  if ne get hab_home_st add hmb 4 RXC_HOST_MAX_HANDLES
    ret RXC_HOST_E_OPEN
  end
  torn = get hab_home_st add hmb 3
  anc = get hab_home_st add hmb 8
  kept = get hab_home_st add hmb 9
  put hab_rep_out 1 torn
  put hab_rep_out 2 get hab_home_st add hmb 7
  put hab_rep_out 8 get hab_home_st add hmb 5
  put hab_rep_out 9 get hab_home_st add hmb 6
  put hab_rep_out 10 torn
  put hab_rep_out 11 anc
  put hab_rep_out 12 kept
  ab = mul hidx 32
  for i ulong 32
    put hab_rep_ahead i get hab_home_ahead add ab i
  end
  if ne get hab_home_st add hmb 10 0
    ret RXC_HOST_E_REPLAY
  end
  if and eq torn 0 le anc kept
    ret RXC_HOST_OK
  end
  hab_recover_apply hidx torn anc kept
  ret RXC_HOST_OK
end

fn rxc_host_recover dir view uchar * rkind ulong root view uchar * to long
  dlen = len dir
  rlen = len root
  for i ulong 16
    put hab_rep_out i 0
  end
  for i ulong 32
    put hab_rep_csha i 0
    put hab_rep_ahead i 0
  end
  if eq hab_path_ok dir dlen 0
    ret RXC_HOST_E_ARG
  end
  drc = hab_derive_mid rkind root rlen
  if ne drc RXC_HOST_OK
    ret drc
  end
  hidx = hab_find_home dir dlen
  if ge hidx RXC_HOST_MAX_HANDLES
    ret RXC_HOST_E_IDENTITY
  end
  if eq hab_mid_eq_home hidx rkind 0
    ret RXC_HOST_E_IDENTITY
  end
  ret hab_recover_home hidx
end

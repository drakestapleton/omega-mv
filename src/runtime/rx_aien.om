note SPDX-License-Identifier: Apache-2.0
note src/runtime/rx_aien.om -- Pure seeded OM-2 port of src/runtime/rx_aien.c.
note AIEN resident cognitive faculty (ADR 0016 s.44, R11): statistical belief
note learning, prediction confirmation/failure, hypothesis formation/testing,
note goal assessment, bounded experiment planning, and experiment belief.

const RX_AIEN_OK long 0
const RX_AIEN_ERR_ARG long -1

const RX_AIEN_PRED_HOLDING ulong 1
const RX_AIEN_PRED_CONFIRMED ulong 2
const RX_AIEN_PRED_FAILED ulong 3

const RX_AIEN_HYP_CORE_CLASS ulong 1
const RX_AIEN_HYP_DRIFT ulong 2

const RX_AIEN_HYP_OPEN ulong 1
const RX_AIEN_HYP_TESTING ulong 2
const RX_AIEN_HYP_SUPPORTED ulong 3
const RX_AIEN_HYP_UNSUPPORTED ulong 4
const RX_AIEN_HYP_EXHAUSTED ulong 5

const RX_AIEN_ACT_RESEARCH ulong 1

const RX_AIEN_WHY_CORE_CLASS ulong 1
const RX_AIEN_WHY_DRIFT ulong 2
const RX_AIEN_WHY_GOAL ulong 3

const RX_AIEN_GOAL_UNKNOWN ulong 1
const RX_AIEN_GOAL_MET ulong 2
const RX_AIEN_GOAL_UNMET ulong 3
const RX_AIEN_GOAL_UNMET_EXPLORED ulong 4

const RX_AIEN_EXP_SUPPORTED ulong 1
const RX_AIEN_EXP_REFUTED ulong 2

const RX_AIEN_MEMORY_SLOTS ulong 7

note World object fields for the resident AIEN faculty:
note ai_cfg[5]: 0:baseline_intervals, 1:tolerance_pct, 2:misses_to_fail, 3:confirm_intervals, 4:min_calls
global ai_cfg ulong 5
global ai_dem ulong 8
global ai_sel ulong 8
global ai_pl ulong 8
global ai_goal ulong 8
global ai_belief ulong 8
global ai_pred ulong 8
global ai_hyp ulong 8
global ai_assess ulong 8
global ai_mem ulong 8
global ai_plan ulong 8
global ai_ev ulong 8
global ai_exp ulong 8

fn rx_aien_reset to void
  for i ulong 8
    put ai_dem i 0
    put ai_sel i 0
    put ai_pl i 0
    put ai_goal i 0
    put ai_belief i 0
    put ai_pred i 0
    put ai_hyp i 0
    put ai_assess i 0
    put ai_mem i 0
    put ai_plan i 0
    put ai_ev i 0
    put ai_exp i 0
  end
end

fn rx_aien_default_config to void
  put ai_cfg 0 4
  put ai_cfg 1 20
  put ai_cfg 2 2
  put ai_cfg 3 4
  put ai_cfg 4 8
end

fn rx_aien_config_ok to long
  if eq get ai_cfg 0 0
    ret RX_AIEN_ERR_ARG
  end
  if eq get ai_cfg 2 0
    ret RX_AIEN_ERR_ARG
  end
  if ge get ai_cfg 1 100
    ret RX_AIEN_ERR_ARG
  end
  ret RX_AIEN_OK
end

fn rx_aien_regime m ulong n ulong to ulong
  ret or shl m 32 n
end

fn rx_aien_key core_class ulong regime ulong to ulong
  m = shr regime 32
  n = and regime 4294967295
  a = shl and core_class 4095 40
  b = shl and m 1048575 20
  c = and n 1048575
  ret or or a b c
end

fn rx_aien_within x ulong mean ulong tol_pct ulong to ulong
  lhs = mul x 100
  hi = mul mean add 100 tol_pct
  lo = mul mean sub 100 tol_pct
  if gt lhs hi
    ret 0
  end
  if lt lhs lo
    ret 0
  end
  ret 1
end

fn rx_aien_failure_settled to ulong
  if ne get ai_pred 6 RX_AIEN_PRED_FAILED
    ret 0
  end
  hst = get ai_hyp 7
  if eq hst RX_AIEN_HYP_EXHAUSTED
    if eq get ai_hyp 2 get ai_pred 0
      ret 1
    end
    ret 0
  end
  if eq hst RX_AIEN_HYP_UNSUPPORTED
    if lt get ai_hyp 2 get ai_pred 0
      ret 1
    end
    ret 0
  end
  ret 0
end

fn rx_aien_relearns to ulong
  if ne rx_aien_failure_settled 0
    ret 1
  end
  if ne get ai_pred 6 RX_AIEN_PRED_FAILED
    ret 0
  end
  if ne get ai_hyp 2 get ai_pred 0
    ret 0
  end
  if ne get ai_hyp 1 RX_AIEN_HYP_DRIFT
    ret 0
  end
  if ne get ai_hyp 7 RX_AIEN_HYP_OPEN
    ret 0
  end
  ret 1
end

fn rx_aien_explored key ulong to ulong
  n = get ai_mem 0
  if gt n RX_AIEN_MEMORY_SLOTS
    n = RX_AIEN_MEMORY_SLOTS
  end
  for i ulong n bound 7
    if eq get ai_mem add 1 i key
      ret 1
    end
  end
  ret 0
end

fn rx_aien_seed_explored keys view ulong * n ulong to long
  if eq n 0
    ret RX_AIEN_ERR_ARG
  end
  if gt n RX_AIEN_MEMORY_SLOTS
    ret RX_AIEN_ERR_ARG
  end
  if gt n len keys
    ret RX_AIEN_ERR_ARG
  end
  put ai_mem 0 n
  for i ulong n bound 7
    put ai_mem add 1 i get keys i
  end
  ret RX_AIEN_OK
end

fn rx_aien_observe to ulong
  epoch = get ai_sel 0
  real = get ai_sel 1
  if eq epoch 0
    ret 0
  end
  if ne rx_aien_regime get ai_dem 4 get ai_dem 5 get ai_sel 6
    ret 0
  end
  calls = get ai_dem 0
  spent = get ai_dem 1
  reset = ulong 0
  if ne get ai_belief 0 epoch
    reset = ulong 1
  end
  if ne get ai_belief 1 real
    reset = ulong 1
  end
  if lt calls get ai_belief 2
    reset = ulong 1
  end
  if ne reset 0
    put ai_belief 0 epoch
    put ai_belief 1 real
    put ai_belief 2 calls
    put ai_belief 3 spent
    put ai_belief 4 0
    put ai_belief 5 0
    put ai_belief 6 0
    put ai_belief 7 0
    ret 1
  end
  if eq get ai_pred 1 epoch
    if ge get ai_belief 7 get ai_cfg 2
      if ne rx_aien_relearns 0
        put ai_belief 2 calls
        put ai_belief 3 spent
        put ai_belief 4 0
        put ai_belief 5 0
        put ai_belief 6 0
        put ai_belief 7 0
        ret 1
      end
    end
  end
  dc = sub calls get ai_belief 2
  if lt dc get ai_cfg 4
    ret 0
  end
  if ne get ai_dem 6 real
    put ai_belief 2 calls
    put ai_belief 3 spent
    ret 1
  end
  x = div sub spent get ai_belief 3 dc
  seen = get ai_belief 5
  mean = get ai_belief 4
  miss = get ai_belief 7
  if eq seen 0
    note warmup discarded
  else
    if le seen get ai_cfg 0
      if gt seen 1
        if eq rx_aien_within x mean get ai_cfg 1 0
          seen = ulong 1
        end
      end
      mean = div add mul mean sub seen 1 x seen
    else
      if ne rx_aien_within x mean get ai_cfg 1 0
        miss = ulong 0
      else
        miss = add miss 1
      end
    end
  end
  put ai_belief 2 calls
  put ai_belief 3 spent
  put ai_belief 4 mean
  put ai_belief 5 add seen 1
  put ai_belief 6 x
  put ai_belief 7 miss
  ret 1
end

fn rx_aien_predict to ulong
  if eq get ai_belief 0 0
    ret 0
  end
  if le get ai_belief 5 get ai_cfg 0
    ret 0
  end
  if ne get ai_belief 0 get ai_sel 0
    ret 0
  end
  is_new = ulong 0
  if eq get ai_pred 0 0
    is_new = ulong 1
  end
  if ne get ai_pred 1 get ai_belief 0
    is_new = ulong 1
  end
  if ne is_new 0
    put ai_pred 0 add get ai_pred 0 1
    put ai_pred 1 get ai_belief 0
    put ai_pred 2 get ai_sel 6
    put ai_pred 3 0
    put ai_pred 4 get ai_pl 1
    put ai_pred 5 get ai_belief 4
    put ai_pred 6 RX_AIEN_PRED_HOLDING
    put ai_pred 7 0
    ret 1
  end
  if eq get ai_pred 6 RX_AIEN_PRED_FAILED
    if ne rx_aien_relearns 0
      if eq get ai_belief 0 get ai_pred 1
        if lt get ai_belief 7 get ai_cfg 2
          put ai_pred 0 add get ai_pred 0 1
          put ai_pred 1 get ai_belief 0
          put ai_pred 2 get ai_sel 6
          put ai_pred 3 0
          put ai_pred 4 get ai_pl 1
          put ai_pred 5 get ai_belief 4
          put ai_pred 6 RX_AIEN_PRED_HOLDING
          put ai_pred 7 0
          ret 1
        end
      end
    end
    ret 0
  end
  if ge get ai_belief 7 get ai_cfg 2
    put ai_pred 6 RX_AIEN_PRED_FAILED
    put ai_pred 7 get ai_belief 6
    ret 1
  end
  if eq get ai_belief 5 add get ai_cfg 0 1
    ret 0
  end
  if ne get ai_belief 7 0
    put ai_pred 3 0
    ret 1
  end
  hits = add get ai_pred 3 1
  put ai_pred 3 hits
  if eq get ai_pred 6 RX_AIEN_PRED_HOLDING
    if ge hits get ai_cfg 3
      put ai_pred 6 RX_AIEN_PRED_CONFIRMED
    end
  end
  ret 1
end

fn rx_aien_explain to ulong
  pseq = get ai_pred 0
  state = get ai_pred 6
  if eq pseq 0
    ret 0
  end
  tested_from = get ai_hyp 2
  if eq get ai_hyp 1 RX_AIEN_HYP_DRIFT
    tested_from = add tested_from 1
  end
  if eq get ai_hyp 7 RX_AIEN_HYP_TESTING
    if gt pseq tested_from
      if eq get ai_pred 4 get ai_hyp 4
        if eq state RX_AIEN_PRED_CONFIRMED
          put ai_hyp 7 RX_AIEN_HYP_SUPPORTED
          ret 1
        end
        if eq state RX_AIEN_PRED_FAILED
          put ai_hyp 7 RX_AIEN_HYP_UNSUPPORTED
          ret 1
        end
        ret 0
      end
    end
  end
  if eq get ai_hyp 7 RX_AIEN_HYP_OPEN
    if eq get ai_hyp 1 RX_AIEN_HYP_DRIFT
      if eq pseq add get ai_hyp 2 1
        if ne get ai_pred 4 get ai_hyp 4
          put ai_hyp 0 add get ai_hyp 0 1
          put ai_hyp 1 RX_AIEN_HYP_CORE_CLASS
          put ai_hyp 2 pseq
          put ai_hyp 3 get ai_hyp 4
          put ai_hyp 4 get ai_pred 4
          put ai_hyp 7 RX_AIEN_HYP_OPEN
          ret 1
        end
      end
    end
  end
  if ne state RX_AIEN_PRED_FAILED
    ret 0
  end
  if eq get ai_hyp 2 pseq
    ret 0
  end
  now_c = get ai_pl 1
  then_c = get ai_pred 4
  kind = RX_AIEN_HYP_DRIFT
  if ne now_c then_c
    kind = RX_AIEN_HYP_CORE_CLASS
  end
  put ai_hyp 0 add get ai_hyp 0 1
  put ai_hyp 1 kind
  put ai_hyp 2 pseq
  put ai_hyp 3 then_c
  put ai_hyp 4 now_c
  put ai_hyp 5 get ai_pred 5
  put ai_hyp 6 get ai_pred 7
  put ai_hyp 7 RX_AIEN_HYP_OPEN
  ret 1
end

fn rx_aien_assess to ulong
  if eq get ai_goal 0 0
    ret 0
  end
  status = RX_AIEN_GOAL_UNKNOWN
  expected = ulong 0
  if ne get ai_pred 0 0
    if eq get ai_pred 2 get ai_goal 1
      if eq get ai_pred 6 RX_AIEN_PRED_CONFIRMED
        expected = get ai_pred 5
        if eq get ai_pred 4 get ai_pl 1
          if le expected get ai_goal 2
            status = RX_AIEN_GOAL_MET
          else
            key = rx_aien_key get ai_pl 1 get ai_goal 1
            if ne rx_aien_explored key 0
              status = RX_AIEN_GOAL_UNMET_EXPLORED
            else
              status = RX_AIEN_GOAL_UNMET
            end
          end
        end
      end
    end
  end
  put ai_assess 0 get ai_goal 0
  put ai_assess 1 get ai_goal 1
  put ai_assess 2 get ai_goal 2
  put ai_assess 3 expected
  put ai_assess 4 status
  put ai_assess 5 get ai_pl 1
  put ai_assess 6 get ai_pred 0
  ret 1
end

fn rx_aien_remember key ulong to void
  n = get ai_mem 0
  slot = rem n RX_AIEN_MEMORY_SLOTS
  put ai_mem add 1 slot key
  put ai_mem 0 add n 1
end

fn rx_aien_publish_plan regime ulong cls ulong hseq ulong why ulong gseq ulong to void
  put ai_plan 0 add get ai_plan 0 1
  put ai_plan 1 RX_AIEN_ACT_RESEARCH
  put ai_plan 2 regime
  put ai_plan 3 cls
  put ai_plan 4 hseq
  put ai_plan 5 why
  put ai_plan 6 gseq
end

fn rx_aien_plan to ulong
  if ne get ai_assess 0 0
    want_goal = ulong 0
    if eq get ai_assess 4 RX_AIEN_GOAL_UNMET
      want_goal = ulong 1
    end
    if eq get ai_assess 4 RX_AIEN_GOAL_UNKNOWN
      if gt get ai_assess 3 get ai_assess 2
        want_goal = ulong 1
      end
    end
    if ne want_goal 0
      if ne get ai_plan 6 get ai_assess 0
        key = rx_aien_key get ai_assess 5 get ai_assess 1
        if eq rx_aien_explored key 0
          rx_aien_publish_plan get ai_assess 1 get ai_assess 5 0 RX_AIEN_WHY_GOAL get ai_assess 0
          rx_aien_remember key
          ret 1
        end
      end
    end
  end
  if eq get ai_hyp 7 RX_AIEN_HYP_OPEN
    if eq get ai_hyp 1 RX_AIEN_HYP_DRIFT
      if ne get ai_pred 0 add get ai_hyp 2 1
        ret 0
      end
      if ne get ai_pred 6 RX_AIEN_PRED_CONFIRMED
        ret 0
      end
      if ne get ai_pred 4 get ai_hyp 4
        ret 0
      end
      if ne rx_aien_within get ai_pred 5 get ai_hyp 5 get ai_cfg 1 0
        put ai_hyp 7 RX_AIEN_HYP_UNSUPPORTED
        ret 1
      end
    else
      if ne get ai_pred 0 get ai_hyp 2
        ret 0
      end
    end
    regime = get ai_pred 2
    cls = get ai_hyp 4
    key2 = rx_aien_key cls regime
    if ne rx_aien_explored key2 0
      put ai_hyp 7 RX_AIEN_HYP_EXHAUSTED
      ret 1
    end
    why = RX_AIEN_WHY_DRIFT
    if eq get ai_hyp 1 RX_AIEN_HYP_CORE_CLASS
      why = RX_AIEN_WHY_CORE_CLASS
    end
    rx_aien_publish_plan regime cls get ai_hyp 0 why 0
    rx_aien_remember key2
    put ai_hyp 7 RX_AIEN_HYP_TESTING
    ret 1
  end
  ret 0
end

fn rx_aien_experiment to ulong
  if eq get ai_ev 0 0
    ret 0
  end
  if le get ai_ev 0 get ai_exp 0
    ret 0
  end
  held = ulong 0
  if eq get ai_ev 3 1
    if eq get ai_ev 1 get ai_ev 2
      if ne get ai_ev 4 0
        held = ulong 1
      end
    end
  end
  put ai_exp 0 get ai_ev 0
  put ai_exp 1 get ai_ev 2
  if ne held 0
    put ai_exp 2 RX_AIEN_EXP_SUPPORTED
  else
    put ai_exp 2 RX_AIEN_EXP_REFUTED
  end
  put ai_exp 3 get ai_ev 4
  ret 1
end

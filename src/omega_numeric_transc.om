note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_numeric_transc.c (E1 WP-B frozen FP32
note transcendental sequences: exp2, log2, sigmoid, tanh, rsqrt, erf, gelu,
note sin, cos). Every arithmetic step is one explicit IEEE binary32 op
note (add, sub, mul, div, fsqrt, fma), matching the C AArch64 inline-asm
note oracle bit-for-bit.
om2

const TR_QNAN uint 0x7fc00000
const TR_PINF uint 0x7f800000
const TR_NINF uint 0xff800000
const TR_MAGIC uint 0x4b400000
const TR_TRIG_MAX uint 0x4a800000

note Shared scratch globals for multi-output internal helpers
global g_tr_k int 1
global g_tr_ml f32 1
global g_tr_cl f32 1
global g_tr_s f32 1
global g_tr_e f32 1

note Frozen erfcx(y) tables (17 intervals, degree-10 Taylor polynomials)
global g_erfcx_init ulong 1
global g_erfcx_lo uint 17
global g_erfcx_c uint 17
global g_erfcx_a0lo uint 17
global g_erfcx_a uint 187

fn tr_tf u uint to f32
  ret bitcast f32 u
end

fn tr_tb f f32 to uint
  ret bitcast uint f
end

fn tr_fneg a f32 to f32
  ret tr_tf xor tr_tb a uint 0x80000000
end

fn tr_fabs a f32 to f32
  ret tr_tf and tr_tb a uint 0x7fffffff
end

fn tr_isnan a f32 to bool
  ret gt and tr_tb a uint 0x7fffffff TR_PINF
end

fn tr_pow2i n int to f32
  ret tr_tf shl uint add n int 127 23
end

fn tr_scale2 m f32 k int to f32
  if gt k int 127
    ret mul mul m tr_pow2i int 127 tr_pow2i sub k int 127
  end
  if lt k int -126
    ret mul mul m tr_pow2i add k int 126 tr_pow2i int -126
  end
  ret mul m tr_pow2i k
end

fn tr_two_sum a f32 b f32 to void
  x = add a b
  bv = sub x a
  av = sub x bv
  put g_tr_s 0 x
  put g_tr_e 0 add sub a av sub b bv
end

note ---- Shared exp core ----

fn tr_exp_core2 ah f32 al f32 to f32
  t = add mul ah tr_tf uint 0x3fb8aa3b tr_tf TR_MAGIC
  kf = sub t tr_tf TR_MAGIC
  k = sub bitcast int tr_tb t bitcast int TR_MAGIC
  nkf = tr_fneg kf
  r = fma nkf tr_tf uint 0x3f317218 ah
  r = fma nkf tr_tf uint 0xb102e308 r
  r = add r al
  p = tr_tf uint 0x37d00d01
  p = fma p r tr_tf uint 0x39500d01
  p = fma p r tr_tf uint 0x3ab60b61
  p = fma p r tr_tf uint 0x3c088889
  p = fma p r tr_tf uint 0x3d2aaaab
  p = fma p r tr_tf uint 0x3e2aaaab
  p = fma p r tr_tf uint 0x3f000000
  p = fma p r tr_tf uint 0x3f800000
  put g_tr_k 0 k
  m = fma p r tr_tf uint 0x3f800000
  put g_tr_ml 0 fma p r sub tr_tf uint 0x3f800000 m
  ret m
end

note ---- EXP2 ----

fn omega_math_exp2 xu uint to uint
  x = tr_tf xu
  if tr_isnan x
    ret TR_QNAN
  end
  if ge x tr_tf uint 0x43000000
    ret TR_PINF
  end
  if lt x tr_tf uint 0xc3170000
    ret uint 0
  end
  t = add x tr_tf TR_MAGIC
  kf = sub t tr_tf TR_MAGIC
  k = sub bitcast int tr_tb t bitcast int TR_MAGIC
  fv = sub x kf
  p = tr_tf uint 0x35b16011
  p = fma p fv tr_tf uint 0x377fe5fe
  p = fma p fv tr_tf uint 0x39218489
  p = fma p fv tr_tf uint 0x3aaec3ff
  p = fma p fv tr_tf uint 0x3c1d955b
  p = fma p fv tr_tf uint 0x3d635847
  p = fma p fv tr_tf uint 0x3e75fdf0
  p = fma p fv tr_tf uint 0x3f317218
  m = fma p fv tr_tf uint 0x3f800000
  ret tr_tb tr_scale2 m k
end

note ---- LOG2 ----

fn tr_log2_poly z f32 zl f32 e int to uint
  z2 = mul z z
  p = tr_tf uint 0x3e864d42
  p = fma p z2 tr_tf uint 0x3ea4258a
  p = fma p z2 tr_tf uint 0x3ed30bb1
  p = fma p z2 tr_tf uint 0x3f13bb63
  p = fma p z2 tr_tf uint 0x3f76384f
  z3 = mul z z2
  chi = tr_tf uint 0x4038aa3b
  ph = mul z chi
  pl = fma z chi tr_fneg ph
  lo = fma z3 p fma z tr_tf uint 0x33257060 mul zl chi
  tr_two_sum f32 e ph
  s = get g_tr_s 0
  se = get g_tr_e 0
  ret tr_tb add s add se add pl lo
end

fn omega_math_log2 xu uint to uint
  u = xu
  if tr_isnan tr_tf u
    ret TR_QNAN
  end
  if eq and u uint 0x7fffffff uint 0
    ret TR_NINF
  end
  if ne and u uint 0x80000000 uint 0
    ret TR_QNAN
  end
  if eq u TR_PINF
    ret TR_PINF
  end
  eadj = int 0
  if eq and u TR_PINF uint 0
    u = tr_tb mul tr_tf u tr_tf uint 0x4b000000
    eadj = int -23
  end
  e = add sub int and shr u 23 uint 0xff int 127 eadj
  m = tr_tf or and u uint 0x007fffff uint 0x3f800000
  if gt m tr_tf uint 0x3fb504f3
    m = mul m tr_tf uint 0x3f000000
    e = add e int 1
  end
  num = sub m tr_tf uint 0x3f800000
  tr_two_sum m tr_tf uint 0x3f800000
  den = get g_tr_s 0
  dl = get g_tr_e 0
  z = div num den
  rz = fma tr_fneg z den num
  rz = fma tr_fneg z dl rz
  zl = div rz den
  ret tr_log2_poly z zl e
end

note ---- SIGMOID ----

fn omega_math_sigmoid xu uint to uint
  x = tr_tf xu
  if tr_isnan x
    ret TR_QNAN
  end
  if ge x tr_tf uint 0x41900000
    ret uint 0x3f800000
  end
  if le x tr_tf uint 0xc2d00000
    ret uint 0
  end
  m = tr_exp_core2 tr_fneg tr_fabs x tr_tf uint 0
  k = get g_tr_k 0
  t = tr_scale2 m k
  d = add tr_tf uint 0x3f800000 t
  if eq and xu uint 0x80000000 uint 0
    ret tr_tb div tr_tf uint 0x3f800000 d
  end
  ret tr_tb tr_scale2 div m d k
end

note ---- TANH ----

fn tr_tanh_small ax f32 to f32
  x2 = mul ax ax
  p = tr_tf uint 0x38cb3f0c
  p = fma p x2 tr_tf uint 0xb97abebc
  p = fma p x2 tr_tf uint 0x3a1aac12
  p = fma p x2 tr_tf uint 0xbabed1b2
  p = fma p x2 tr_tf uint 0x3b6b69e8
  p = fma p x2 tr_tf uint 0xbc11371b
  p = fma p x2 tr_tf uint 0x3cb327a4
  p = fma p x2 tr_tf uint 0xbd5d0dd1
  p = fma p x2 tr_tf uint 0x3e088889
  p = fma p x2 tr_tf uint 0xbeaaaaab
  ret fma mul ax x2 p ax
end

fn omega_math_tanh xu uint to uint
  x = tr_tf xu
  if tr_isnan x
    ret TR_QNAN
  end
  sign = and xu uint 0x80000000
  ax = tr_fabs x
  r = tr_tf uint 0
  if ge ax tr_tf uint 0x41180000
    r = tr_tf uint 0x3f800000
  else
    if lt ax tr_tf uint 0x3f100000
      r = tr_tanh_small ax
    else
      m = tr_exp_core2 add ax ax tr_tf uint 0
      e2 = tr_scale2 m get g_tr_k 0
      r = sub tr_tf uint 0x3f800000 div tr_tf uint 0x40000000 add e2 tr_tf uint 0x3f800000
    end
  end
  ret or tr_tb r sign
end

note ---- RSQRT (correctly rounded) ----

fn tr_mul_lt_pow2 nv ulong xv ulong ns ulong to bool
  if ge ns 127
    ret true
  end
  n2 = mul nv nv
  p_lo = mul and n2 0xffffffff xv
  p_hi = mul shr n2 32 xv
  mid = add shr p_lo 32 p_hi
  l_lo = or and p_lo 0xffffffff shl and mid 0xffffffff 32
  l_hi = shr mid 32
  if ge ns 64
    ret lt l_hi shl ulong 1 sub ns 64
  end
  if ne l_hi 0
    ret false
  end
  ret lt l_lo shl ulong 1 ns
end

fn tr_mid_below w1 uint w2 uint xv ulong ex long to bool
  m1 = ulong or and w1 uint 0x7fffff uint 0x800000
  m2 = ulong or and w2 uint 0x7fffff uint 0x800000
  e1 = sub long shr w1 23 150
  e2 = sub long shr w2 23 150
  el = e2
  if lt e1 e2
    el = e1
  end
  nv = add shl m1 ulong sub e1 el shl m2 ulong sub e2 el
  s = add sub mul 2 el 2 ex
  if ge s 0
    ret false
  end
  ret tr_mul_lt_pow2 nv xv ulong sub 0 s
end

fn omega_math_rsqrt xu uint to uint
  u = xu
  if tr_isnan tr_tf u
    ret TR_QNAN
  end
  if eq u uint 0
    ret TR_PINF
  end
  if eq u uint 0x80000000
    ret TR_NINF
  end
  if ne and u uint 0x80000000 uint 0
    ret TR_QNAN
  end
  if eq u TR_PINF
    ret uint 0
  end
  post = int 0
  if eq and u TR_PINF uint 0
    u = tr_tb mul tr_tf u tr_tf uint 0x4b800000
    post = int 12
  end
  y = div tr_tf uint 0x3f800000 fsqrt tr_tf u
  xv = ulong or and u uint 0x7fffff uint 0x800000
  ex = sub long shr u 23 150
  w = tr_tb y
  while tr_mid_below w add w uint 1 xv ex bound 4
    w = add w uint 1
  end
  while not tr_mid_below sub w uint 1 w xv ex bound 4
    w = sub w uint 1
  end
  ret tr_tb mul tr_tf w tr_pow2i post
end

note ---- ERFCX tables & ERF / GELU ----

fn erfcx_set_row i ulong a0 uint a1 uint a2 uint a3 uint a4 uint to void
  b = mul i 11
  put g_erfcx_a b a0
  put g_erfcx_a add b 1 a1
  put g_erfcx_a add b 2 a2
  put g_erfcx_a add b 3 a3
  put g_erfcx_a add b 4 a4
end

fn erfcx_set_row2 i ulong a5 uint a6 uint a7 uint a8 uint a9 uint to void
  b = mul i 11
  put g_erfcx_a add b 5 a5
  put g_erfcx_a add b 6 a6
  put g_erfcx_a add b 7 a7
  put g_erfcx_a add b 8 a8
  put g_erfcx_a add b 9 a9
end

fn erfcx_set_meta i ulong lo uint c uint a0lo uint a10 uint to void
  put g_erfcx_lo i lo
  put g_erfcx_c i c
  put g_erfcx_a0lo i a0lo
  put g_erfcx_a add mul i 11 10 a10
end


end

fn erfcx_ensure_init to void
  if eq get g_erfcx_init 0 0
    erfcx_init_p1
    erfcx_init_p2
    put g_erfcx_init 0 1
  end
end

fn tr_erf_small y f32 to f32
  y2 = mul y y
  q = tr_tf uint 0xb75debbd
  q = fma q y2 tr_tf uint 0x38e00e01
  q = fma q y2 tr_tf uint 0xba46980c
  q = fma q y2 tr_tf uint 0x3b97b426
  q = fma q y2 tr_tf uint 0xbcc30c31
  q = fma q y2 tr_tf uint 0x3dcccccd
  q = fma q y2 tr_tf uint 0xbeaaaaab
  w = mul y2 q
  tsp_hi = tr_tf uint 0x3f906ebb
  aa = mul y tsp_hi
  al = fma y tsp_hi tr_fneg aa
  bb = fma y tr_tf uint 0xb37bd649 al
  ret add aa fma aa w bb
end

fn tr_erfcx_eval2 y f32 to f32
  erfcx_ensure_init
  i = ulong 0
  for k1 ulong 16
    j = add k1 1
    if lt y tr_tf get g_erfcx_lo j
      break
    end
    i = j
  end
  t = sub y tr_tf get g_erfcx_c i
  base = mul i 11
  p = tr_tf get g_erfcx_a add base 10
  n = ulong 9
  while ge n 1 bound 10
    p = fma p t tr_tf get g_erfcx_a add base n
    n = sub n 1
  end
  a0 = tr_tf get g_erfcx_a base
  cv = fma p t a0
  put g_tr_cl 0 add fma p t sub a0 cv tr_tf get g_erfcx_a0lo i
  ret cv
end

fn omega_math_erf xu uint to uint
  x = tr_tf xu
  if tr_isnan x
    ret TR_QNAN
  end
  sign = and xu uint 0x80000000
  ax = tr_fabs x
  r = tr_tf uint 0
  if ge ax tr_tf uint 0x40800000
    r = tr_tf uint 0x3f800000
  else
    if lt ax tr_tf uint 0x3f000000
      r = tr_erf_small ax
    else
      h = mul ax ax
      hl = fma ax ax tr_fneg h
      m = tr_exp_core2 tr_fneg h tr_fneg hl
      k = get g_tr_k 0
      ev = tr_erfcx_eval2 ax
      r = sub tr_tf uint 0x3f800000 tr_scale2 mul m ev k
    end
  end
  ret or tr_tb r sign
end

note ---- GELU (erf form) ----

fn tr_gelu_combine xu uint hx f32 me f32 cv f32 cl f32 to uint
  k = get g_tr_k 0
  mel = get g_tr_ml 0
  p = mul me cv
  pl = fma me cv tr_fneg p
  pl = fma me cl pl
  pl = fma mel cv pl
  if eq and xu uint 0x80000000 uint 0
    ret tr_tb fma tr_fneg hx tr_scale2 p k tr_tf xu
  end
  ret tr_tb tr_scale2 fma hx p mul hx pl k
end

fn tr_gelu_exp x f32 to f32
  pp = mul x x
  pl0 = fma x x tr_fneg pp
  h = mul pp tr_tf uint 0x3f000000
  hl = mul pl0 tr_tf uint 0x3f000000
  ret tr_exp_core2 tr_fneg h tr_fneg hl
end

fn tr_gelu_large xu uint y f32 to uint
  x = tr_tf xu
  ay = tr_fabs y
  yl = fma x tr_tf uint 0x3f3504f3 tr_fneg y
  yl = fma x tr_tf uint 0x324fe77a yl
  ayl = yl
  if ne and xu uint 0x80000000 uint 0
    ayl = tr_fneg yl
  end
  me = tr_gelu_exp x
  cv = tr_erfcx_eval2 ay
  dc = fma mul ay tr_tf uint 0x40000000 cv tr_tf uint 0xbf906ebb
  cl = fma ayl dc get g_tr_cl 0
  ret tr_gelu_combine xu mul x tr_tf uint 0x3f000000 me cv cl
end

fn omega_math_gelu xu uint to uint
  x = tr_tf xu
  if tr_isnan x
    ret TR_QNAN
  end
  if ge x tr_tf uint 0x41000000
    ret xu
  end
  if lt x tr_tf uint 0xc1780000
    ret uint 0x80000000
  end
  mag = and xu uint 0x7fffffff
  if eq mag uint 0
    ret xu
  end
  if lt mag uint 0x01000000
    sv = and xu uint 0x80000000
    if ne sv uint 0
      ret or sv shr mag 1
    end
    ret or sv shr add mag uint 1 1
  end
  y = mul x tr_tf uint 0x3f3504f3
  ay = tr_fabs y
  hx = mul x tr_tf uint 0x3f000000
  if lt ay tr_tf uint 0x3f000000
    ev = tr_erf_small ay
    ev = tr_tf or tr_tb ev and tr_tb y uint 0x80000000
    r = fma hx ev hx
    ret or tr_tb r and xu uint 0x80000000
  end
  ret tr_gelu_large xu y
end

note ---- SIN / COS ----

fn tr_sin_poly rh f32 rl f32 to f32
  r2 = mul rh rh
  sv = tr_tf uint 0x2f309231
  sv = fma sv r2 tr_tf uint 0xb2d7322b
  sv = fma sv r2 tr_tf uint 0x3638ef1d
  sv = fma sv r2 tr_tf uint 0xb9500d01
  sv = fma sv r2 tr_tf uint 0x3c088889
  sv = fma sv r2 tr_tf uint 0xbe2aaaab
  t = mul rh r2
  rlc = fma mul r2 tr_tf uint 0xbf000000 rl rl
  ret add rh fma t sv rlc
end

fn tr_cos_poly rh f32 rl f32 to f32
  r2 = mul rh rh
  r2l = fma rh rh tr_fneg r2
  cv = tr_tf uint 0xad49cba5
  cv = fma cv r2 tr_tf uint 0x310f76c7
  cv = fma cv r2 tr_tf uint 0xb493f27e
  cv = fma cv r2 tr_tf uint 0x37d00d01
  cv = fma cv r2 tr_tf uint 0xbab60b61
  cv = fma cv r2 tr_tf uint 0x3d2aaaab
  hr = mul r2 tr_tf uint 0x3f000000
  h = sub tr_tf uint 0x3f800000 hr
  eh = sub sub tr_tf uint 0x3f800000 h hr
  c1 = fma r2l tr_tf uint 0xbf000000 eh
  c2 = fma tr_fneg rl rh c1
  r4 = mul r2 r2
  ret add h fma r4 cv c2
end

fn tr_sincos_reduce x f32 to int
  t = add mul x tr_tf uint 0x3f22f983 tr_tf TR_MAGIC
  kf = sub t tr_tf TR_MAGIC
  k = sub bitcast int tr_tb t bitcast int TR_MAGIC
  r1 = fma tr_fneg kf tr_tf uint 0x3fc90fdb x
  p2 = tr_tf uint 0xb33bbd2e
  th = mul kf p2
  tl = fma kf p2 tr_fneg th
  tr_two_sum r1 tr_fneg th
  s1 = get g_tr_s 0
  e1 = get g_tr_e 0
  tr_two_sum s1 tr_fneg tl
  s2 = get g_tr_s 0
  e2 = get g_tr_e 0
  lo = sub add e1 e2 mul kf tr_tf uint 0xa6f72ced
  rh = add s2 lo
  put g_tr_s 0 rh
  put g_tr_e 0 sub lo sub rh s2
  ret k
end

fn tr_sincos_core xu uint qoff int to uint
  x = tr_tf xu
  if tr_isnan x
    ret TR_QNAN
  end
  ax = tr_fabs x
  if not le ax tr_tf TR_TRIG_MAX
    ret TR_QNAN
  end
  rh = x
  rl = tr_tf uint 0
  k = int 0
  if gt ax tr_tf uint 0x3f490fdb
    k = tr_sincos_reduce x
    rh = get g_tr_s 0
    rl = get g_tr_e 0
  end
  q = and bitcast uint add k qoff uint 3
  r = tr_tf uint 0
  if ne and q uint 1 uint 0
    r = tr_cos_poly rh rl
  else
    r = tr_sin_poly rh rl
  end
  if ne and q uint 2 uint 0
    ret tr_tb tr_fneg r
  end
  ret tr_tb r
end

fn omega_math_sin xu uint to uint
  if eq and xu uint 0x7fffffff uint 0
    ret xu
  end
  ret tr_sincos_core xu int 0
end

fn omega_math_cos xu uint to uint
  ret tr_sincos_core xu int 1
end

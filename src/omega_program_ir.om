note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 implementation of src/omega_program_ir.c (canonical binary IR codec)
note and Program Identity v2 hashing (spec/program-identity.md, spec/program-fp32.md).
note Composes on seed/ng/sha256.om (provides sh_dat, sh_dig, sh_all).
om2

const PIR_MAX_SLOTS ulong 16
const PIR_MAX_STEPS ulong 64
const PIR_IR_MAX ulong 768

const OMEGA_TYPE_UINT ulong 3
const OMEGA_TYPE_SINT ulong 4
const OMEGA_TYPE_BV ulong 5
const OMEGA_TYPE_FP32 ulong 14

const OMEGA_OP_ADD ulong 3
const OMEGA_OP_SUB ulong 4
const OMEGA_OP_MUL ulong 5
const OMEGA_OP_DIV ulong 6
const OMEGA_OP_AND ulong 9
const OMEGA_OP_OR ulong 10
const OMEGA_OP_CONVERT ulong 16

const OMEGA_OV_WRAP ulong 1
const OMEGA_OV_SATURATE ulong 2

const OMEGA_CONST_PRE ulong 7
const OMEGA_CONST_POST ulong 8

text pir_ir_tag "AIEN_OMEGA_PROGRAM_IR_V1"
text pir_prog_dom "omega.program.v2"
text pir_param_key "omega.param"
text pir_comp_key "omega.compose"
text pir_seq_val "seq"

note Program pool (16 slots)
global gp_has ulong 16
global gp_scnt ulong 16
global gp_sop ulong 1024
global gp_simm ulong 1024
global gp_intype ulong 16
global gp_inw ulong 16
global gp_outtype ulong 16
global gp_outw ulong 16
global gp_preid uchar 512
global gp_postid uchar 512
global gp_lcnt ulong 16
global gp_leaves uchar 32768
global gp_id uchar 512

note Scratch buffers for canonical encoding and hashing
global gp_enc uchar 512
global gp_tid_in uchar 32
global gp_tid_out uchar 32
global gp_tfid uchar 32
global gp_tuid uchar 32
global gp_cur uchar 32
global gp_cid uchar 32
global gp_oid uchar 32
global gp_root uchar 32
global gp_tmp_id uchar 32
global gp_la uchar 2048
global gp_lb uchar 2048
global gp_ir_buf uchar 768
global gp_ir_len ulong 1

fn pir_enc_u16be pos ulong v ulong to ulong
  put gp_enc pos uchar and shr v 8 255
  put gp_enc add pos 1 uchar and v 255
  ret add pos 2
end

fn pir_enc_u32be pos ulong v ulong to ulong
  put gp_enc pos uchar and shr v 24 255
  put gp_enc add pos 1 uchar and shr v 16 255
  put gp_enc add pos 2 uchar and shr v 8 255
  put gp_enc add pos 3 uchar and v 255
  ret add pos 4
end

fn pir_enc_u16le pos ulong v ulong to ulong
  put gp_enc pos uchar and v 255
  put gp_enc add pos 1 uchar and shr v 8 255
  ret add pos 2
end

fn pir_enc_u32le pos ulong v ulong to ulong
  put gp_enc pos uchar and v 255
  put gp_enc add pos 1 uchar and shr v 8 255
  put gp_enc add pos 2 uchar and shr v 16 255
  put gp_enc add pos 3 uchar and shr v 24 255
  ret add pos 4
end

fn pir_enc_hdr kind ulong to ulong
  put gp_enc 0 uchar 79
  put gp_enc 1 uchar 77
  put gp_enc 2 uchar 71
  put gp_enc 3 uchar 48
  put gp_enc 4 uchar 1
  put gp_enc 5 uchar and kind 255
  ret 6
end

fn pir_hash_enc n ulong to void
  for i ulong n bound 512
    put sh_dat i get gp_enc i
  end
  sh_all n
end

fn pir_hash_type tag ulong w ulong to long
  ok = ulong 0
  if eq tag OMEGA_TYPE_UINT
    if and ge w 1 le w 256
      ok = 1
    end
  end
  if eq tag OMEGA_TYPE_SINT
    if and ge w 2 le w 256
      ok = 1
    end
  end
  if eq tag OMEGA_TYPE_BV
    if and ge w 1 le w 256
      ok = 1
    end
  end
  if eq tag OMEGA_TYPE_FP32
    if eq w 32
      ok = 1
    end
  end
  if eq ok 0
    ret -1
  end
  p = pir_enc_hdr 2
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u32be p 44
  for i ulong 44
    put gp_enc add p i uchar 0
  end
  u = pir_enc_u32le p tag
  u = pir_enc_u16le add p 4 w
  pir_hash_enc 60
  ret 0
end

fn pir_hash_param0_tid is_fp ulong to void
  p = pir_enc_hdr 1
  p = pir_enc_u16be p 1
  put gp_enc p uchar 11
  p = add p 1
  for i ulong 11
    put gp_enc add p i get pir_param_key i
  end
  p = add p 11
  p = pir_enc_u16be p 2
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u32be p 98
  for i ulong 98
    put gp_enc add p i uchar 0
  end
  for i ulong 32
    if eq is_fp 1
      put gp_enc add p i get gp_tfid i
    else
      if eq is_fp 2
        put gp_enc add p i get gp_tuid i
      else
        put gp_enc add p i get gp_tid_in i
      end
    end
  end
  pir_hash_enc add p 98
  for i ulong 32
    put gp_cur i get sh_dig i
  end
end

fn pir_hash_val_uint tid_sel ulong w ulong val ulong to void
  p = pir_enc_hdr 1
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u32be p 98
  for i ulong 98
    put gp_enc add p i uchar 0
  end
  for i ulong 32
    if eq tid_sel 1
      put gp_enc add p i get gp_tfid i
    else
      put gp_enc add p i get gp_tid_in i
    end
  end
  nb = div add w 7 8
  p = pir_enc_u16le add p 32 nb
  for i ulong nb bound 8
    sh = mul sub sub nb 1 i 8
    put gp_enc add p i uchar and shr val sh 255
  end
  pir_hash_enc 114
  for i ulong 32
    put gp_cid i get sh_dig i
  end
end

fn pir_hash_op_binary opc ulong ov ulong tid_sel ulong to void
  p = pir_enc_hdr 3
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u32be p 204
  for i ulong 204
    put gp_enc add p i uchar 0
  end
  u = pir_enc_u32le p opc
  u = pir_enc_u32le add p 4 ov
  for i ulong 32
    b = get gp_tid_in i
    if eq tid_sel 1
      b = get gp_tfid i
    end
    put gp_enc add add p 8 i b
    put gp_enc add add p 41 i b
    put gp_enc add add p 73 i b
    put gp_enc add add p 169 i b
  end
  put gp_enc add p 40 uchar 2
  pir_hash_enc 220
  for i ulong 32
    put gp_oid i get sh_dig i
  end
end

fn pir_hash_op_convert from_fp ulong to_fp ulong to void
  p = pir_enc_hdr 3
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u32be p 204
  for i ulong 204
    put gp_enc add p i uchar 0
  end
  u = pir_enc_u32le p OMEGA_OP_CONVERT
  u = pir_enc_u32le add p 4 OMEGA_OV_SATURATE
  for i ulong 32
    bf = get gp_tuid i
    if eq from_fp 1
      bf = get gp_tfid i
    end
    bt = get gp_tuid i
    if eq to_fp 1
      bt = get gp_tfid i
    end
    put gp_enc add add p 8 i bt
    put gp_enc add add p 41 i bf
    put gp_enc add add p 169 i bt
  end
  put gp_enc add p 40 uchar 1
  pir_hash_enc 220
  for i ulong 32
    put gp_oid i get sh_dig i
  end
end

fn pir_hash_apply arity ulong to void
  p = pir_enc_hdr 3
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u32be p 161
  for i ulong 161
    put gp_enc add p i uchar 0
  end
  for i ulong 32
    put gp_enc add p i get gp_oid i
    put gp_enc add add p 33 i get gp_cur i
  end
  if eq arity 2
    for i ulong 32
      put gp_enc add add p 65 i get gp_cid i
    end
  end
  put gp_enc add p 32 uchar and arity 255
  pir_hash_enc 177
  for i ulong 32
    put gp_cur i get sh_dig i
  end
end

fn pir_build_constraint_id kind ulong txt view uchar * tlen ulong to void
  p = pir_enc_hdr 5
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 1
  p = pir_enc_u16be p kind
  p = pir_enc_u16be p tlen
  for i ulong tlen bound 128
    put gp_enc add p i get txt i
  end
  p = add p tlen
  p = pir_enc_u32be p 0
  pir_hash_enc p
end

fn pir_post_seq_pair left_off ulong is_la ulong to void
  p = pir_enc_hdr 5
  p = pir_enc_u16be p 1
  put gp_enc p uchar 13
  p = add p 1
  for i ulong 13
    put gp_enc add p i get pir_comp_key i
  end
  p = add p 13
  p = pir_enc_u16be p 3
  for i ulong 3
    put gp_enc add p i get pir_seq_val i
  end
  p = add p 3
  p = pir_enc_u16be p 0
  p = pir_enc_u16be p 1
  p = pir_enc_u16be p OMEGA_CONST_POST
  p = pir_enc_u16be p 64
  for i ulong 32
    if eq is_la 1
      put gp_enc add p i get gp_la add left_off i
    else
      put gp_enc add p i get gp_leaves add left_off i
    end
    put gp_enc add add p 32 i get gp_tmp_id i
  end
  p = add p 64
  p = pir_enc_u32be p 0
  pir_hash_enc p
  for i ulong 32
    put gp_tmp_id i get sh_dig i
  end
end

fn pir_fold_leaves slot ulong to long
  n = get gp_lcnt slot
  if or eq n 0 gt n PIR_MAX_STEPS
    ret -1
  end
  lb = mul slot 2048
  last_off = add lb mul sub n 1 32
  for i ulong 32
    put gp_tmp_id i get gp_leaves add last_off i
  end
  if eq n 1
    ret 0
  end
  idx = long sub n 2
  while ge idx 0 bound 64
    off = add lb mul ulong idx 32
    pir_post_seq_pair off 0
    idx = sub idx 1
  end
  ret 0
end

fn pir_slot_init slot ulong to void
  put gp_has slot 0
  put gp_scnt slot 0
  put gp_intype slot 0
  put gp_inw slot 0
  put gp_outtype slot 0
  put gp_outw slot 0
  put gp_lcnt slot 0
  ib = mul slot 32
  for i ulong 32
    put gp_preid add ib i uchar 0
    put gp_postid add ib i uchar 0
    put gp_id add ib i uchar 0
  end
end

fn pir_step_op_valid op ulong to bool
  if eq op OMEGA_OP_ADD
    ret true
  end
  if eq op OMEGA_OP_SUB
    ret true
  end
  if eq op OMEGA_OP_MUL
    ret true
  end
  if eq op OMEGA_OP_AND
    ret true
  end
  if eq op OMEGA_OP_OR
    ret true
  end
  ret false
end

fn pir_body_is_fp32 slot ulong to bool
  if eq get gp_intype slot OMEGA_TYPE_FP32
    ret true
  end
  if eq get gp_outtype slot OMEGA_TYPE_FP32
    ret true
  end
  sc = get gp_scnt slot
  sb = mul slot PIR_MAX_STEPS
  for i ulong sc bound 64
    if eq get gp_sop add sb i OMEGA_OP_CONVERT
      ret true
    end
  end
  ret false
end

fn pir_lower_body_fp32 slot ulong to long
  inw = get gp_inw slot
  outw = get gp_outw slot
  if or ne inw 32 ne outw 32
    ret -1
  end
  it = get gp_intype slot
  ot = get gp_outtype slot
  if and ne it OMEGA_TYPE_FP32 ne it OMEGA_TYPE_UINT
    ret -1
  end
  if and ne ot OMEGA_TYPE_FP32 ne ot OMEGA_TYPE_UINT
    ret -1
  end
  rc = pir_hash_type OMEGA_TYPE_FP32 32
  if ne rc 0
    ret -1
  end
  for i ulong 32
    put gp_tfid i get sh_dig i
  end
  rc = pir_hash_type OMEGA_TYPE_UINT 32
  if ne rc 0
    ret -1
  end
  for i ulong 32
    put gp_tuid i get sh_dig i
  end
  cur_tag = it
  if eq cur_tag OMEGA_TYPE_FP32
    pir_hash_param0_tid 1
  else
    pir_hash_param0_tid 2
  end
  sc = get gp_scnt slot
  sb = mul slot PIR_MAX_STEPS
  for i ulong sc bound 64
    op = get gp_sop add sb i
    imm = get gp_simm add sb i
    if eq op OMEGA_OP_CONVERT
      if and ne imm OMEGA_TYPE_FP32 ne imm OMEGA_TYPE_UINT
        ret -1
      end
      if eq imm cur_tag
        ret -1
      end
      ffp = ulong 0
      if eq cur_tag OMEGA_TYPE_FP32
        ffp = 1
      end
      tfp = ulong 0
      if eq imm OMEGA_TYPE_FP32
        tfp = 1
      end
      pir_hash_op_convert ffp tfp
      pir_hash_apply 1
      cur_tag = imm
    else
      if ne cur_tag OMEGA_TYPE_FP32
        ret -1
      end
      fok = ulong 0
      if eq op OMEGA_OP_ADD
        fok = 1
      end
      if eq op OMEGA_OP_SUB
        fok = 1
      end
      if eq op OMEGA_OP_MUL
        fok = 1
      end
      if eq op OMEGA_OP_DIV
        fok = 1
      end
      if eq fok 0
        ret -1
      end
      if gt imm 0xffffffff
        ret -1
      end
      pir_hash_val_uint 1 32 imm
      pir_hash_op_binary op OMEGA_OV_SATURATE 1
      pir_hash_apply 2
    end
  end
  if ne cur_tag ot
    ret -1
  end
  for i ulong 32
    put gp_root i get gp_cur i
  end
  ret 0
end

fn pir_lower_body_int slot ulong to long
  it = get gp_intype slot
  iw = get gp_inw slot
  rc = pir_hash_type it iw
  if ne rc 0
    ret -1
  end
  for i ulong 32
    put gp_tid_in i get sh_dig i
  end
  pir_hash_param0_tid 0
  sc = get gp_scnt slot
  sb = mul slot PIR_MAX_STEPS
  for i ulong sc bound 64
    op = get gp_sop add sb i
    if not pir_step_op_valid op
      ret -1
    end
    imm = get gp_simm add sb i
    pir_hash_val_uint 0 iw imm
    pir_hash_op_binary op OMEGA_OV_WRAP 0
    pir_hash_apply 2
  end
  for i ulong 32
    put gp_root i get gp_cur i
  end
  ret 0
end

fn pir_compute_id slot ulong to long
  ib = mul slot 32
  for i ulong 32
    put gp_id add ib i uchar 0
  end
  if eq get gp_has slot 0
    ret -1
  end
  if gt get gp_scnt slot PIR_MAX_STEPS
    ret -1
  end
  rc = long 0
  if pir_body_is_fp32 slot
    rc = pir_lower_body_fp32 slot
  else
    rc = pir_lower_body_int slot
  end
  if ne rc 0
    ret -1
  end
  rc = pir_hash_type get gp_intype slot get gp_inw slot
  if ne rc 0
    ret -1
  end
  for i ulong 32
    put gp_tid_in i get sh_dig i
  end
  rc = pir_hash_type get gp_outtype slot get gp_outw slot
  if ne rc 0
    ret -1
  end
  for i ulong 32
    put gp_tid_out i get sh_dig i
  end
  p = ulong 0
  for i ulong 16
    put sh_dat i get pir_prog_dom i
  end
  put sh_dat 16 uchar 0
  p = 17
  for i ulong 32
    put sh_dat add p i get gp_root i
  end
  p = add p 32
  for i ulong 32
    put sh_dat add p i get gp_tid_in i
  end
  p = add p 32
  for i ulong 32
    put sh_dat add p i get gp_tid_out i
  end
  p = add p 32
  for i ulong 32
    put sh_dat add p i get gp_preid add ib i
  end
  p = add p 32
  for i ulong 32
    put sh_dat add p i get gp_postid add ib i
  end
  p = add p 32
  sh_all p
  for i ulong 32
    put gp_id add ib i get sh_dig i
  end
  ret 0
end

fn pir_ids_eq sa ulong sb ulong to bool
  ia = mul sa 32
  ib = mul sb 32
  for i ulong 32
    if ne get gp_id add ia i get gp_id add ib i
      ret false
    end
  end
  ret true
end

fn pir_compose_leaves sa ulong sb ulong sc ulong to long
  na = get gp_lcnt sa
  if lt na 2
    na = 1
    ia = mul sa 32
    for i ulong 32
      put gp_la i get gp_postid add ia i
    end
  else
    lba = mul sa 2048
    for i ulong mul na 32 bound 2048
      put gp_la i get gp_leaves add lba i
    end
  end
  nb = get gp_lcnt sb
  if lt nb 2
    nb = 1
    ib = mul sb 32
    for i ulong 32
      put gp_lb i get gp_postid add ib i
    end
  else
    lbb = mul sb 2048
    for i ulong mul nb 32 bound 2048
      put gp_lb i get gp_leaves add lbb i
    end
  end
  if gt add na nb PIR_MAX_STEPS
    ret -1
  end
  lbc = mul sc 2048
  for i ulong mul na 32 bound 2048
    put gp_leaves add lbc i get gp_la i
  end
  offb = add lbc mul na 32
  for i ulong mul nb 32 bound 2048
    put gp_leaves add offb i get gp_lb i
  end
  put gp_lcnt sc add na nb
  rc = pir_fold_leaves sc
  if ne rc 0
    ret -1
  end
  ic = mul sc 32
  for i ulong 32
    put gp_postid add ic i get gp_tmp_id i
  end
  ret 0
end

fn pir_compose_steps sa ulong sb ulong sc ulong to void
  sca = get gp_scnt sa
  scb = get gp_scnt sb
  put gp_has sc 1
  put gp_scnt sc add sca scb
  sba = mul sa PIR_MAX_STEPS
  sbb = mul sb PIR_MAX_STEPS
  sbc = mul sc PIR_MAX_STEPS
  for i ulong sca bound 64
    put gp_sop add sbc i get gp_sop add sba i
    put gp_simm add sbc i get gp_simm add sba i
  end
  for i ulong scb bound 64
    put gp_sop add add sbc sca i get gp_sop add sbb i
    put gp_simm add add sbc sca i get gp_simm add sbb i
  end
end

fn pir_compose sa ulong sb ulong sc ulong to long
  if ne get gp_outtype sa get gp_intype sb
    ret -1
  end
  if ne get gp_outw sa get gp_inw sb
    ret -1
  end
  if or eq get gp_has sa 0 eq get gp_has sb 0
    ret -1
  end
  if gt add get gp_scnt sa get gp_scnt sb PIR_MAX_STEPS
    ret -1
  end
  pir_slot_init sc
  put gp_intype sc get gp_intype sa
  put gp_inw sc get gp_inw sa
  put gp_outtype sc get gp_outtype sb
  put gp_outw sc get gp_outw sb
  ia = mul sa 32
  ic = mul sc 32
  for i ulong 32
    put gp_preid add ic i get gp_preid add ia i
  end
  if ne pir_compose_leaves sa sb sc 0
    ret -1
  end
  pir_compose_steps sa sb sc
  ign = pir_compute_id sc
  ret 0
end

note Realize check (V0 AArch64 gate): refuses non-unsigned or non-{8,16,32,64} or non-V0 ops.
fn pir_realize_check slot ulong to long
  if eq get gp_has slot 0
    ret -1
  end
  if gt get gp_scnt slot PIR_MAX_STEPS
    ret -1
  end
  if or ne get gp_intype slot OMEGA_TYPE_UINT ne get gp_outtype slot OMEGA_TYPE_UINT
    ret -1
  end
  w = get gp_inw slot
  if ne w get gp_outw slot
    ret -1
  end
  wok = ulong 0
  if eq w 8
    wok = 1
  end
  if eq w 16
    wok = 1
  end
  if eq w 32
    wok = 1
  end
  if eq w 64
    wok = 1
  end
  if eq wok 0
    ret -1
  end
  sc = get gp_scnt slot
  sb = mul slot PIR_MAX_STEPS
  for i ulong sc bound 64
    if not pir_step_op_valid get gp_sop add sb i
      ret -1
    end
  end
  ret 0
end

note ---- Canonical binary IR codec (src/omega_program_ir.c) ----

fn pir_put_u16be pos ulong v ulong to ulong
  put gp_ir_buf pos uchar and shr v 8 255
  put gp_ir_buf add pos 1 uchar and v 255
  ret add pos 2
end

fn pir_put_u64be pos ulong v ulong to ulong
  for i ulong 8
    sh = mul sub 7 i 8
    put gp_ir_buf add pos i uchar and shr v sh 255
  end
  ret add pos 8
end

fn omega_program_ir_encode slot ulong to long
  if eq get gp_has slot 0
    ret -1
  end
  sc = get gp_scnt slot
  if gt sc PIR_MAX_STEPS
    ret -1
  end
  p = ulong 0
  for i ulong 24
    put gp_ir_buf i get pir_ir_tag i
  end
  p = 24
  put gp_ir_buf p uchar and get gp_intype slot 255
  p = add p 1
  p = pir_put_u16be p get gp_inw slot
  put gp_ir_buf p uchar and get gp_outtype slot 255
  p = add p 1
  p = pir_put_u16be p get gp_outw slot
  ib = mul slot 32
  for i ulong 32
    put gp_ir_buf add p i get gp_preid add ib i
  end
  p = add p 32
  for i ulong 32
    put gp_ir_buf add p i get gp_postid add ib i
  end
  p = add p 32
  p = pir_put_u16be p sc
  sb = mul slot PIR_MAX_STEPS
  for i ulong sc bound 64
    put gp_ir_buf p uchar and get gp_sop add sb i 255
    p = add p 1
    p = pir_put_u64be p get gp_simm add sb i
  end
  put gp_ir_len 0 p
  ret 0
end

fn pir_read_be pos ulong k ulong to ulong
  v = ulong 0
  for i ulong k bound 8
    v = or shl v 8 ulong get gp_ir_buf add pos i
  end
  ret v
end

fn omega_program_ir_decode n ulong slot ulong to long
  pir_slot_init slot
  if lt n 96
    ret -1
  end
  for i ulong 24
    if ne get gp_ir_buf i get pir_ir_tag i
      ret -1
    end
  end
  p = ulong 24
  it = pir_read_be p 1
  p = add p 1
  iw = pir_read_be p 2
  p = add p 2
  ot = pir_read_be p 1
  p = add p 1
  ow = pir_read_be p 2
  p = add p 2
  ib = mul slot 32
  for i ulong 32
    put gp_preid add ib i get gp_ir_buf add p i
  end
  p = add p 32
  for i ulong 32
    put gp_postid add ib i get gp_ir_buf add p i
  end
  p = add p 32
  sc = pir_read_be p 2
  p = add p 2
  if gt sc PIR_MAX_STEPS
    pir_slot_init slot
    ret -1
  end
  need = add 96 mul sc 9
  if ne n need
    pir_slot_init slot
    ret -1
  end
  put gp_intype slot it
  put gp_inw slot iw
  put gp_outtype slot ot
  put gp_outw slot ow
  put gp_has slot 1
  put gp_scnt slot sc
  sb = mul slot PIR_MAX_STEPS
  for i ulong sc bound 64
    put gp_sop add sb i pir_read_be p 1
    p = add p 1
    put gp_simm add sb i pir_read_be p 8
    p = add p 8
  end
  rc = pir_compute_id slot
  if ne rc 0
    pir_slot_init slot
    ret -1
  end
  ret 0
end

fn omega_program_ir_recompute_id n ulong tmp_slot ulong dst edit uchar 32 to long
  rc = omega_program_ir_decode n tmp_slot
  if ne rc 0
    ret -1
  end
  ib = mul tmp_slot 32
  for i ulong 32
    put dst i get gp_id add ib i
  end
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_matvec_quad.c (quad4 AArch64 matvec
note realization synthesizer + triple ID + V0 structural verification).
note Composes on seed/ng/sha256.om and om/aarch64/aarch64_om2.om.
om2

const MVQ_KIND_QUAD4 ulong 3
const MVQ_KIND_REALIZATION ulong 9
const MVQ_PROFILE_V8A ulong 1
const MVQ_EXPECTED_BYTES ulong 204

global g_mvq_kind ulong 1
global g_mvq_unroll ulong 1
global g_mvq_acc ulong 1
global g_mvq_profile ulong 1
global g_mvq_code_len ulong 1
global g_mvq_verified ulong 1
global g_mvq_code uchar 4096
global g_mvq_real_id uchar 32

fn mvq_emit buf edit uchar * st edit ulong 2 w long to long
  ret a64put buf st w
end

fn mvq_emit_prologue buf edit uchar * st edit ulong 2 to long
  rc = mvq_emit buf st a64cbz 1 3 50
  rc = or rc mvq_emit buf st a64cbz 1 4 49
  rc = or rc mvq_emit buf st a64movz 1 16 3 0
  rc = or rc mvq_emit buf st a64andreg 1 15 4 16
  rc = or rc mvq_emit buf st a64subreg 1 14 4 15
  rc = or rc mvq_emit buf st a64movreg 1 5 3
  rc = or rc mvq_emit buf st a64movz 1 17 32 0
  rc = or rc mvq_emit buf st a64movreg 1 6 0
  rc = or rc mvq_emit buf st a64movreg 1 7 1
  rc = or rc mvq_emit buf st a64movreg 1 8 31
  rc = or rc mvq_emit buf st a64movreg 1 9 31
  rc = or rc mvq_emit buf st a64movreg 1 10 31
  rc = or rc mvq_emit buf st a64movreg 1 11 31
  rc = or rc mvq_emit buf st a64movreg 1 13 14
  rc = or rc mvq_emit buf st a64cbz 1 13 21
  ret rc
end

fn mvq_emit_quad_lane buf edit uchar * st edit ulong 2 acc ulong uoff ulong to long
  rc = mvq_emit buf st a64ldruoff 1 12 6 uoff
  rc = or rc mvq_emit buf st a64ldruoff 1 16 7 uoff
  rc = or rc mvq_emit buf st a64mulreg 1 12 12 16
  rc = or rc mvq_emit buf st a64addreg 1 acc acc 12
  ret rc
end

fn mvq_emit_body_and_tail buf edit uchar * st edit ulong 2 to long
  rc = mvq_emit_quad_lane buf st 8 0
  rc = or rc mvq_emit_quad_lane buf st 9 8
  rc = or rc mvq_emit_quad_lane buf st 10 16
  rc = or rc mvq_emit_quad_lane buf st 11 24
  rc = or rc mvq_emit buf st a64addreg 1 6 6 17
  rc = or rc mvq_emit buf st a64addreg 1 7 7 17
  rc = or rc mvq_emit buf st a64subsimm 1 13 13 4
  rc = or rc mvq_emit buf st a64bcond 1 -19
  rc = or rc mvq_emit buf st a64addreg 1 8 8 9
  rc = or rc mvq_emit buf st a64addreg 1 10 10 11
  rc = or rc mvq_emit buf st a64addreg 1 8 8 10
  rc = or rc mvq_emit buf st a64cbz 1 15 8
  rc = or rc mvq_emit buf st a64movreg 1 13 15
  rc = or rc mvq_emit buf st a64ldrxpost 12 6 8
  rc = or rc mvq_emit buf st a64ldrxpost 16 7 8
  rc = or rc mvq_emit buf st a64mulreg 1 12 12 16
  rc = or rc mvq_emit buf st a64addreg 1 8 8 12
  rc = or rc mvq_emit buf st a64subsimm 1 13 13 1
  rc = or rc mvq_emit buf st a64bcond 1 -5
  rc = or rc mvq_emit buf st a64strxpost 8 2 8
  rc = or rc mvq_emit buf st a64movreg 1 0 6
  rc = or rc mvq_emit buf st a64subsimm 1 5 5 1
  rc = or rc mvq_emit buf st a64bcond 1 -42
  rc = or rc mvq_emit buf st a64ret
  ret rc
end

fn mvq_triple_id sem_id view uchar 32 mach_id view uchar 32 profile ulong clen ulong to void
  put sh_dat 0 uchar 79
  put sh_dat 1 uchar 77
  put sh_dat 2 uchar 71
  put sh_dat 3 uchar 48
  put sh_dat 4 uchar MVQ_KIND_REALIZATION
  put sh_dat 5 uchar and profile 255
  put sh_dat 6 0
  put sh_dat 7 0
  put sh_dat 8 0
  put sh_dat 9 0
  put sh_dat 10 uchar and shr clen 24 255
  put sh_dat 11 uchar and shr clen 16 255
  put sh_dat 12 uchar and shr clen 8 255
  put sh_dat 13 uchar and clen 255
  for i ulong 32
    put sh_dat add 14 i get sem_id i
    put sh_dat add 46 i get mach_id i
  end
  for i ulong clen bound 4096
    put sh_dat add 78 i get g_mvq_code i
  end
  sh_all add 78 clen
  for i ulong 32
    put g_mvq_real_id i get sh_dig i
  end
end

fn omega_matvec_synthesize_quad4 sem_id view uchar 32 mach_id view uchar 32 profile ulong to long
  put g_mvq_kind 0 MVQ_KIND_QUAD4
  put g_mvq_unroll 0 4
  put g_mvq_acc 0 4
  put g_mvq_profile 0 profile
  put g_mvq_code_len 0 0
  put g_mvq_verified 0 0
  buf = new uchar 256 0
  st = new ulong 2 0
  put st 0 0
  put st 1 256
  rc = mvq_emit_prologue buf st
  rc = or rc mvq_emit_body_and_tail buf st
  if ne rc 0
    ret -1
  end
  clen = get st 0
  if ne clen MVQ_EXPECTED_BYTES
    ret -1
  end
  for i ulong clen bound 256
    put g_mvq_code i get buf i
  end
  put g_mvq_code_len 0 clen
  mvq_triple_id sem_id mach_id profile clen
  if ne profile MVQ_PROFILE_V8A
    ret -1
  end
  msg = new uchar 128 0
  if ne a64validate buf clen msg 128 0
    ret -1
  end
  put g_mvq_verified 0 1
  ret 0
end

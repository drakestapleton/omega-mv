note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 helpers backing src/allen/allen_bind.c:
note lineage validation, LE u64 intent-id unpack, and hex encode/decode.
om2

fn allen_hex_nib v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

fn allen_unhex_char c ulong to long
  if and ge c 48 le c 57
    ret long sub c 48
  end
  if and ge c 97 le c 102
    ret long add sub c 97 10
  end
  if and ge c 65 le c 70
    ret long add sub c 65 10
  end
  ret -1
end

export fn allen_encode_hex src view uchar * out_hex edit uchar * to void
requires eq len out_hex mul len src 2
  for i ulong len src
    b = ulong get src i
    put out_hex mul i 2 allen_hex_nib shr b 4
    put out_hex add mul i 2 1 allen_hex_nib and b 15
  end
end

export fn allen_decode_hex in_hex view uchar * out_bytes edit uchar * to ulong
requires eq len in_hex mul len out_bytes 2
  for i ulong len out_bytes
    hi = allen_unhex_char ulong get in_hex mul i 2
    lo = allen_unhex_char ulong get in_hex add mul i 2 1
    if or lt hi 0 lt lo 0
      ret 0
    end
    put out_bytes i uchar or shl ulong hi 4 ulong lo
  end
  ret 1
end

note Return 0 if valid, -1 if cortex is all-zero, -2 if no genesis, -3 if mismatch.
export fn allen_check_lineage cortex view uchar 32 genesis view uchar 32 has_genesis ulong to long
  any_nz = ulong 0
  for i ulong 32
    if ne get cortex i 0
      any_nz = 1
    end
  end
  if eq any_nz 0
    ret -1
  end
  if eq has_genesis 0
    ret -2
  end
  for i ulong 32
    if ne get cortex i get genesis i
      ret -3
    end
  end
  ret 0
end

export fn allen_le64 id view uchar 8 to ulong
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get id i mul i 8
  end
  ret v
end

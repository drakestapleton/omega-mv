note SPDX-License-Identifier: Apache-2.0
note src/omega_gpu_mem_cached.om: Pure seeded OM-2 twin of src/omega_gpu_mem_cached.c.
note GPU-cached device-private data buffer allocation policy (CPU_WRITE | GPU_READ,
note no CPU_READ, 4096-byte page-rounded, fail-closed).
om2

fn ogmc_alloc_cached dev_idx ulong dev_gen ulong nbytes ulong h_out edit ulong 2 info_out edit ulong 3 to ulong
put h_out 0 0
put h_out 1 0
put info_out 0 0
put info_out 1 0
put info_out 2 0
if eq nbytes 0
ret OGP_REFUSED_BAD_LENGTH
end
if gt nbytes sub ulong 0xffffffffffffffff 4095
ret OGP_REFUSED_LIMIT
end
want = and add nbytes 4095 not ulong 4095
desc = new ulong 5 0
put desc 0 OGP_HANDLE_BUF_DATA
put desc 1 or OGP_RIGHT_CPU_WRITE OGP_RIGHT_GPU_READ
put desc 2 OGP_CACHE_GPU_CACHED
put desc 3 4096
put desc 4 want
rc = ogpl_dma_alloc dev_idx dev_gen desc h_out info_out
if ne rc OGP_OK
put h_out 0 0
put h_out 1 0
put info_out 0 0
put info_out 1 0
put info_out 2 0
ret rc
end
if lt get info_out 2 want
ign = ogpl_dma_free get h_out 0 get h_out 1
put h_out 0 0
put h_out 1 0
put info_out 0 0
put info_out 1 0
put info_out 2 0
ret OGP_REFUSED_BAD_LENGTH
end
ret OGP_OK
end

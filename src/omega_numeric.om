fn omega_numeric_refused_variant_count to ulong
  ret 15
end

fn omega_numeric_refused_variant_at idx ulong dst edit uchar * to long
  if ge idx 15
    ret -1
  end
  if eq idx 0
    for i ulong len t_rv0 bound 32
      put dst i get t_rv0 i
    end
    ret long len t_rv0
  end
  if eq idx 1
    for i ulong len t_rv1 bound 32
      put dst i get t_rv1 i
    end
    ret long len t_rv1
  end
  if eq idx 9
    for i ulong len t_rv9 bound 32
      put dst i get t_rv9 i
    end
    ret long len t_rv9
  end
  if eq idx 14
    for i ulong len t_rv14 bound 32
      put dst i get t_rv14 i
    end
    ret long len t_rv14
  end
  ret 0
end

fn num_is_refused_variant s view uchar * n ulong to bool
  if or num_streq s n t_rv0 or num_streq s n t_rv1 num_streq s n t_rv2
    ret true
  end
  if or num_streq s n t_rv3 or num_streq s n t_rv4 num_streq s n t_rv5
    ret true
  end
  if or num_streq s n t_rv6 or num_streq s n t_rv7 num_streq s n t_rv8
    ret true
  end
  if or num_streq s n t_rv9 or num_streq s n t_rv10 num_streq s n t_rv11
    ret true
  end
  ret or num_streq s n t_rv12 or num_streq s n t_rv13 num_streq s n t_rv14
end

fn omega_numeric_launch_shape count ulong to void
  g = div sub add count OMEGA_NUMERIC_CTA_THREADS 1 OMEGA_NUMERIC_CTA_THREADS
  if eq g 0
    g = 1
  end
  put g_num_launch_tpb 0 uint OMEGA_NUMERIC_CTA_THREADS
  put g_num_launch_grid 0 uint g
end

note ---- Kernel patch words (provenance IDs 1..52 match PROVENANCE_TABLE index+1) ----

const CTRL_FIXED uint 0x010fca00
const CTRL_VAR uint 0x010e2800
const CTRL_SHFL_NEXT uint 0x000e2400
const CTRL_FADD_SB0 uint 0x001fca00

fn patch_put idx ulong w0 uint w1 uint w2 uint w3 uint pid ulong to void
  b = mul idx 4
  put g_num_patch_w b w0
  put g_num_patch_w add b 1 w1
  put g_num_patch_w add b 2 w2
  put g_num_patch_w add b 3 w3
  put g_num_patch_prov idx pid
end

fn patch_put_tail idx ulong wait_sb0 bool to ulong
  ctrl = uint 0x000fe200
  if wait_sb0
    ctrl = uint 0x001fe200
  end
  patch_put idx uint 0x06007986 uint 0x00000009 uint 0x0c101904 ctrl 0
  patch_put add idx 1 uint 0x0000794d uint 0x00000000 uint 0x03800000 uint 0x000fea00 0
  ret add idx 2
end


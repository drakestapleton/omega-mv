note ---- Bit-level IEEE-754 helpers ----

fn num_isnan u uint to bool
  ret gt and u uint 0x7fffffff OMEGA_INF_POS
end

fn num_isinf u uint to bool
  ret eq and u uint 0x7fffffff OMEGA_INF_POS
end

fn num_iszero u uint to bool
  ret eq and u uint 0x7fffffff uint 0
end

fn num_signbit u uint to bool
  ret ne and u uint 0x80000000 uint 0
end

fn num_issubnormal u uint to bool
  ex = and u uint 0x7f800000
  fr = and u uint 0x007fffff
  ret and eq ex uint 0 ne fr uint 0
end

fn num_is_finite_normal u uint to bool
  ex = and shr u 23 uint 0xff
  ret and ne ex uint 0 ne ex uint 0xff
end

fn omega_numeric_bits_equal a uint b uint to bool
  if and num_isnan a num_isnan b
    ret true
  end
  ret eq a b
end

fn omega_numeric_read_fpcr to ulong
  ret get g_num_fpcr 0
end

fn omega_numeric_fpenv_ok to bool
  ret eq and omega_numeric_read_fpcr OMEGA_NUMERIC_FPCR_REQUIRED_CLEAR 0
end

fn omega_numeric_cpu_has_bf16 to bool
  ret ne get g_num_has_bf16 0 0
end

note ---- Semantic Reference Tier ----

fn omega_ref_fadd a uint b uint to uint
  ret bitcast uint add bitcast f32 a bitcast f32 b
end

fn omega_ref_fsub a uint b uint to uint
  ret bitcast uint sub bitcast f32 a bitcast f32 b
end

fn omega_ref_fmul a uint b uint to uint
  ret bitcast uint mul bitcast f32 a bitcast f32 b
end

fn omega_ref_ffma a uint b uint c uint to uint
  ret bitcast uint fma bitcast f32 a bitcast f32 b bitcast f32 c
end

fn omega_ref_fmin a uint b uint to uint
  if num_isnan a
    ret b
  end
  if num_isnan b
    ret a
  end
  if and num_iszero a num_iszero b
    if or num_signbit a num_signbit b
      ret uint 0x80000000
    end
    ret uint 0
  end
  if lt bitcast f32 a bitcast f32 b
    ret a
  end
  ret b
end

fn omega_ref_fmax a uint b uint to uint
  if num_isnan a
    ret b
  end
  if num_isnan b
    ret a
  end
  if and num_iszero a num_iszero b
    if or not num_signbit a not num_signbit b
      ret uint 0
    end
    ret uint 0x80000000
  end
  if gt bitcast f32 a bitcast f32 b
    ret a
  end
  ret b
end

fn omega_ref_fsetp_ge a uint b uint to bool
  if or num_isnan a num_isnan b
    ret false
  end
  ret ge bitcast f32 a bitcast f32 b
end

fn omega_ref_i2f a int to uint
  ret bitcast uint f32 a
end

fn omega_ref_f2i a uint to int
  if num_isnan a
    ret int 0
  end
  fa = bitcast f32 a
  if ge fa bitcast f32 uint 0x4f000000
    ret int 2147483647
  end
  if le fa bitcast f32 uint 0xcf000000
    ret int -2147483648
  end
  ret int fa
end

note ---- E1 scalar contract: pure integer bit-pattern reference definitions ----

const REF_RTZ ulong 0
const REF_FLOOR ulong 1
const REF_CEIL ulong 2
const REF_RNE ulong 3

fn ref_to_int_frac m ulong sh ulong to ulong
  remv = and m sub shl ulong 1 sh 1
  if eq remv 0
    ret 0
  end
  half = shl ulong 1 sub sh 1
  if lt remv half
    ret 1
  end
  if eq remv half
    ret 2
  end
  ret 3
end

fn ref_to_int_apply ip ulong frac ulong mode ulong is_neg bool to long
  mag = ip
  if eq mode REF_FLOOR
    if and is_neg ne frac 0
      mag = add mag 1
    end
  else
    if eq mode REF_CEIL
      if and not is_neg ne frac 0
        mag = add mag 1
      end
    else
      if eq mode REF_RNE
        if or eq frac 3 and eq frac 2 ne and ip 1 0
          mag = add mag 1
        end
      end
    end
  end
  if is_neg
    ret sub 0 long mag
  end
  ret long mag
end

fn ref_to_int u uint mode ulong lo long hi long to long
  be = ulong and shr u 23 uint 0xff
  f = ulong and u uint 0x007fffff
  is_neg = ne and u uint 0x80000000 uint 0
  if eq be 255
    if ne f 0
      ret 0
    end
    if is_neg
      ret lo
    end
    ret hi
  end
  if and eq be 0 eq f 0
    ret 0
  end
  m = f
  e = long -149
  if ne be 0
    m = or f 0x00800000
    e = sub long be 150
  end
  ip = ulong 0
  frac = ulong 0
  if ge e 0
    if gt e 16
      if is_neg
        ret lo
      end
      ret hi
    end
    ip = shl m ulong e
  else
    if ge sub 0 e 40
      frac = 1
    else
      sh = ulong sub 0 e
      ip = shr m sh
      frac = ref_to_int_frac m sh
    end
  end
  v = ref_to_int_apply ip frac mode is_neg
  if lt v lo
    ret lo
  end
  if gt v hi
    ret hi
  end
  ret v
end

fn omega_ref_f2i_floor a uint to int
  ret int ref_to_int a REF_FLOOR -2147483648 2147483647
end

fn omega_ref_f2i_ceil a uint to int
  ret int ref_to_int a REF_CEIL -2147483648 2147483647
end

fn omega_ref_f2i_rni a uint to int
  ret int ref_to_int a REF_RNE -2147483648 2147483647
end

fn omega_ref_f2u a uint to uint
  ret uint ref_to_int a REF_RTZ 0 4294967295
end

note 128-bit unsigned helpers (hi, lo)
fn u128_msb hi ulong lo ulong to long
  if ne hi 0
    p = long 63
    while and ge p 0 eq and shr hi ulong p 1 0 bound 65
      p = sub p 1
    end
    ret add p 64
  end
  p = long 63
  while and ge p 0 eq and shr lo ulong p 1 0 bound 65
    p = sub p 1
  end
  ret p
end

fn u128_bit hi ulong lo ulong pos ulong to bool
  if ge pos 128
    ret false
  end
  if ge pos 64
    ret ne and shr hi sub pos 64 1 0
  end
  ret ne and shr lo pos 1 0
end

fn u128_any_below hi ulong lo ulong k ulong to bool
  if eq k 0
    ret false
  end
  if ge k 128
    ret or ne hi 0 ne lo 0
  end
  if ge k 64
    if ne lo 0
      ret true
    end
    hk = sub k 64
    if eq hk 0
      ret false
    end
    ret ne and hi sub shl ulong 1 hk 1 0
  end
  ret ne and lo sub shl ulong 1 k 1 0
end

fn u128_shr_lo hi ulong lo ulong s ulong to ulong
  if ge s 128
    ret 0
  end
  if eq s 0
    ret lo
  end
  if ge s 64
    ret shr hi sub s 64
  end
  ret or shr lo s shl hi sub 64 s
end

fn u128_round_shift hi ulong lo ulong su ulong to ulong
  mant = u128_shr_lo hi lo su
  if u128_bit hi lo sub su 1
    if or u128_any_below hi lo sub su 1 ne and mant 1 0
      mant = add mant 1
    end
  end
  ret mant
end

fn ref_fmt_man fmt ulong to long
  if eq fmt 1
    ret 10
  end
  if eq fmt 2
    ret 7
  end
  ret 23
end

fn ref_fmt_bias fmt ulong to long
  if eq fmt 1
    ret 15
  end
  ret 127
end

fn ref_fmt_emax fmt ulong to ulong
  if eq fmt 1
    ret 0x1f
  end
  ret 0xff
end

fn ref_round_small_128 hi ulong lo ulong exp2 long fmt ulong to uint
  p = u128_msb hi lo
  be = add add p exp2 ref_fmt_bias fmt
  if ge be long ref_fmt_emax fmt
    ret uint shl ref_fmt_emax fmt ulong ref_fmt_man fmt
  end
  lsb = sub sub 1 ref_fmt_bias fmt ref_fmt_man fmt
  if ge be 1
    lsb = sub add p exp2 ref_fmt_man fmt
  end
  s = sub lsb exp2
  mant = ulong 0
  if le s 0
    mant = shl lo ulong sub 0 s
  else
    if gt s add p 1
      ret uint 0
    end
    mant = u128_round_shift hi lo ulong s
  end
  bits = mant
  if ge be 1
    bits = add shl ulong sub be 1 ulong ref_fmt_man fmt mant
  end
  inf_bits = shl ref_fmt_emax fmt ulong ref_fmt_man fmt
  if ge bits inf_bits
    ret uint inf_bits
  end
  ret uint bits
end

fn omega_ref_u2f a uint to uint
  if eq a uint 0
    ret uint 0
  end
  ret ref_round_small_128 0 ulong a 0 0
end

fn ref_narrow a uint fmt ulong to uint
  man = ref_fmt_man fmt
  emax_f = ref_fmt_emax fmt
  sign = and shr a 16 uint 0x8000
  be = ulong and shr a 23 uint 0xff
  f = ulong and a uint 0x007fffff
  inf = shl emax_f ulong man
  if eq be 0xff
    if eq f 0
      ret or sign uint inf
    end
    qbit = shl ulong 1 ulong sub man 1
    pay = shr f ulong sub 23 man
    ret or sign uint or or inf qbit pay
  end
  if and eq be 0 eq f 0
    ret sign
  end
  m = f
  e = long -149
  if ne be 0
    m = or f 0x00800000
    e = sub long be 150
  end
  ret or sign ref_round_small_128 0 m e fmt
end

fn omega_ref_f32_to_f16 a uint to uint
  ret ref_narrow a 1
end

fn omega_ref_f32_to_bf16 a uint to uint
  ret ref_narrow a 2
end

fn omega_ref_f16_to_f32 h uint to uint
  sign = shl and h uint 0x8000 16
  be = and shr h 10 uint 0x1f
  f = and h uint 0x3ff
  if eq be uint 0x1f
    if ne f uint 0
      ret or or sign uint 0x7fc00000 shl f 13
    end
    ret or sign OMEGA_INF_POS
  end
  if eq be uint 0
    if eq f uint 0
      ret sign
    end
    e = long -14
    while eq and f uint 0x400 uint 0 bound 16
      f = shl f 1
      e = sub e 1
    end
    eb = shl uint add e 127 23
    ret or or sign eb shl and f uint 0x3ff 13
  end
  eb = shl add sub be uint 15 uint 127 23
  ret or or sign eb shl f 13
end

fn omega_ref_bf16_to_f32 h uint to uint
  ret shl and h uint 0xffff 16
end

fn ref_split_m u uint to ulong
  be = and shr u 23 uint 0xff
  f = ulong and u uint 0x007fffff
  if ne be uint 0
    ret or f 0x00800000
  end
  ret f
end

fn ref_split_e u uint to long
  be = and shr u 23 uint 0xff
  if ne be uint 0
    ret sub long be 150
  end
  ret -149
end

note 128-bit shift left of a 64-bit value v by sh (0..125) into dst[0]=hi, dst[1]=lo
fn u128_shl64 v ulong sh ulong dst edit ulong 2 to void
  if eq sh 0
    put dst 0 0
    put dst 1 v
    ret
  end
  if ge sh 64
    put dst 0 shl v sub sh 64
    put dst 1 0
    ret
  end
  put dst 0 shr v sub 64 sh
  put dst 1 shl v sh
end

note 128-bit shift right with sticky bit into dst[0]=hi, dst[1]=lo
fn u128_shr_sticky v ulong d long dst edit ulong 2 to void
  if lt d 0
    u128_shl64 v ulong sub 0 d dst
    ret
  end
  if eq d 0
    put dst 0 0
    put dst 1 v
    ret
  end
  if ge d 64
    put dst 0 0
    if ne v 0
      put dst 1 1
    else
      put dst 1 0
    end
    ret
  end
  du = ulong d
  lost = ne and v sub shl ulong 1 du 1 0
  r = shr v du
  if lost
    r = or r 1
  end
  put dst 0 0
  put dst 1 r
end

fn ffma_combine xv view ulong 2 yv view ulong 2 sx uint sy uint ex long to uint
  xhi = get xv 0
  xlo = get xv 1
  yhi = get yv 0
  ylo = get yv 1
  if eq sx sy
    mlo = add xlo ylo
    mhi = add xhi yhi
    if lt mlo xlo
      mhi = add mhi 1
    end
    if and eq mhi 0 eq mlo 0
      ret uint 0
    end
    ret or sx ref_round_small_128 mhi mlo ex 0
  end
  if or gt xhi yhi and eq xhi yhi ge xlo ylo
    mlo = sub xlo ylo
    mhi = sub xhi yhi
    if lt xlo ylo
      mhi = sub mhi 1
    end
    if and eq mhi 0 eq mlo 0
      ret uint 0
    end
    ret or sx ref_round_small_128 mhi mlo ex 0
  end
  mlo = sub ylo xlo
  mhi = sub yhi xhi
  if lt ylo xlo
    mhi = sub mhi 1
  end
  if and eq mhi 0 eq mlo 0
    ret uint 0
  end
  ret or sy ref_round_small_128 mhi mlo ex 0
end

fn ffma_align_and_sum x64 ulong ex long sx uint y64 ulong ey long sy uint to uint
  xv = new ulong 2 0
  yv = new ulong 2 0
  up = sub 125 u128_msb 0 x64
  u128_shl64 x64 ulong up xv
  nex = sub ex up
  u128_shr_sticky y64 sub nex ey yv
  ret ffma_combine xv yv sx sy nex
end

fn ffma_finite xa uint xb uint xc uint ps uint cs uint to uint
  mp = mul ref_split_m xa ref_split_m xb
  ep = add ref_split_e xa ref_split_e xb
  if eq xc uint 0
    ret or ps ref_round_small_128 0 mp ep 0
  end
  mc = ref_split_m xc
  ec = ref_split_e xc
  lc = add u128_msb 0 mc ec
  lp = add u128_msb 0 mp ep
  if gt lc lp
    ret ffma_align_and_sum mc ec cs mp ep ps
  end
  ret ffma_align_and_sum mp ep ps mc ec cs
end

fn omega_ref_ffma_int ua uint ub uint uc uint to uint
  ps = and xor ua ub uint 0x80000000
  cs = and uc uint 0x80000000
  xa = and ua uint 0x7fffffff
  xb = and ub uint 0x7fffffff
  xc = and uc uint 0x7fffffff
  if or gt xa OMEGA_INF_POS or gt xb OMEGA_INF_POS gt xc OMEGA_INF_POS
    ret OMEGA_QNAN_BITS
  end
  pinf = or eq xa OMEGA_INF_POS eq xb OMEGA_INF_POS
  pzero = or eq xa uint 0 eq xb uint 0
  if and pinf pzero
    ret OMEGA_QNAN_BITS
  end
  if pinf
    if and eq xc OMEGA_INF_POS ne cs ps
      ret OMEGA_QNAN_BITS
    end
    ret or ps OMEGA_INF_POS
  end
  if eq xc OMEGA_INF_POS
    ret uc
  end
  if pzero
    if ne xc uint 0
      ret uc
    end
    ret and ps cs
  end
  ret ffma_finite xa xb xc ps cs
end

note Predicate truth mask: bit 0 less (1), bit 1 equal (2), bit 2 greater (4), bit 3 unordered (8)
fn fsetp_mask op ulong to ulong
  if eq op OMEGA_NOP_FSETP_SEL
    ret 6
  end
  if eq op OMEGA_NOP_FSETP_LT_SEL
    ret 1
  end
  if eq op OMEGA_NOP_FSETP_LE_SEL
    ret 3
  end
  if eq op OMEGA_NOP_FSETP_GT_SEL
    ret 4
  end
  if eq op OMEGA_NOP_FSETP_EQ_SEL
    ret 2
  end
  if eq op OMEGA_NOP_FSETP_NE_SEL
    ret 5
  end
  if eq op OMEGA_NOP_FSETP_NUM_SEL
    ret 7
  end
  if eq op OMEGA_NOP_FSETP_NAN_SEL
    ret 8
  end
  if eq op OMEGA_NOP_FSETP_LTU_SEL
    ret 9
  end
  if eq op OMEGA_NOP_FSETP_LEU_SEL
    ret 11
  end
  if eq op OMEGA_NOP_FSETP_GTU_SEL
    ret 12
  end
  if eq op OMEGA_NOP_FSETP_GEU_SEL
    ret 14
  end
  if eq op OMEGA_NOP_FSETP_EQU_SEL
    ret 10
  end
  if eq op OMEGA_NOP_FSETP_NEU_SEL
    ret 13
  end
  ret 0
end

fn ref_order ua uint ub uint to ulong
  if or gt and ua uint 0x7fffffff OMEGA_INF_POS gt and ub uint 0x7fffffff OMEGA_INF_POS
    ret 8
  end
  ka = long ua
  if ne and ua uint 0x80000000 uint 0
    ka = sub 0 long and ua uint 0x7fffffff
  end
  kb = long ub
  if ne and ub uint 0x80000000 uint 0
    kb = sub 0 long and ub uint 0x7fffffff
  end
  if lt ka kb
    ret 1
  end
  if gt ka kb
    ret 4
  end
  ret 2
end

fn omega_ref_fsetp_pred op ulong a uint b uint to long
  m = fsetp_mask op
  if eq m 0
    ret -1
  end
  if ne and m ref_order a b 0
    ret 1
  end
  ret 0
end

note ---- IEEE div/sqrt, host rcp seed, integer div/sqrt, exp/log, warp sum ----

fn omega_ieee_div x uint y uint to uint
  ret bitcast uint div bitcast f32 x bitcast f32 y
end

fn omega_ieee_sqrt x uint to uint
  ret bitcast uint fsqrt bitcast f32 x
end

fn omega_numeric_host_rcp_seed y uint to uint
  ret sub uint 0x7ef311c0 y
end

fn omega_unpack_m u uint to uint
  be = and shr u 23 uint 0xff
  f = and u uint 0x007fffff
  if ne be uint 0
    ret or f uint 0x00800000
  end
  while eq and f uint 0x00800000 uint 0 bound 32
    f = shl f 1
  end
  ret f
end

fn omega_unpack_e u uint to long
  be = and shr u 23 uint 0xff
  if ne be uint 0
    ret sub long be 150
  end
  f = and u uint 0x007fffff
  ex = long -149
  while eq and f uint 0x00800000 uint 0 bound 32
    f = shl f 1
    ex = sub ex 1
  end
  ret ex
end

fn rp_round_shift sig ulong su ulong sticky bool to ulong
  mant = shr sig su
  if ne and shr sig sub su 1 1 0
    if or sticky or ne and sig sub shl ulong 1 sub su 1 1 0 ne and mant 1 0
      mant = add mant 1
    end
  end
  ret mant
end

fn omega_round_pack sign uint sig ulong exp2 long sticky bool to uint
  p = u128_msb 0 sig
  be = add add p exp2 127
  if ge be 255
    ret or sign OMEGA_INF_POS
  end
  lsb = long -149
  if ge be 1
    lsb = sub add p exp2 23
  end
  s = sub lsb exp2
  if gt s add p 1
    ret sign
  end
  mant = rp_round_shift sig ulong s sticky
  bits = mant
  if ge be 1
    bits = add shl ulong sub be 1 23 mant
  end
  if ge bits ulong OMEGA_INF_POS
    ret or sign OMEGA_INF_POS
  end
  ret or sign uint bits
end

fn omega_math_div x uint y uint to uint
  if or num_isnan x num_isnan y
    ret OMEGA_QNAN_BITS
  end
  sign = and xor x y uint 0x80000000
  if num_iszero y
    if num_iszero x
      ret OMEGA_QNAN_BITS
    end
    ret or sign OMEGA_INF_POS
  end
  if num_iszero x
    ret sign
  end
  if num_isinf x
    if num_isinf y
      ret OMEGA_QNAN_BITS
    end
    ret or sign OMEGA_INF_POS
  end
  if num_isinf y
    ret sign
  end
  mx = omega_unpack_m x
  my = omega_unpack_m y
  ex = omega_unpack_e x
  ey = omega_unpack_e y
  rm = mx
  q = uint 0
  for i ulong 27
    q = shl q 1
    if ge rm my
      rm = sub rm my
      q = or q uint 1
    end
    rm = shl rm 1
  end
  ret omega_round_pack sign ulong q sub sub ex ey 26 ne rm uint 0
end

fn omega_math_sqrt x uint to uint
  if num_isnan x
    ret OMEGA_QNAN_BITS
  end
  if num_iszero x
    ret x
  end
  if num_signbit x
    ret OMEGA_QNAN_BITS
  end
  if num_isinf x
    ret OMEGA_INF_POS
  end
  mm = ulong omega_unpack_m x
  e = omega_unpack_e x
  if ne and e 1 0
    mm = shl mm 1
    e = sub e 1
  end
  opv = shl mm 28
  sv = ulong 0
  one = shl ulong 1 62
  while gt one opv bound 32
    one = shr one 2
  end
  while ne one 0 bound 32
    t = add sv one
    if ge opv t
      opv = sub opv t
      sv = add shr sv 1 one
    else
      sv = shr sv 1
    end
    one = shr one 2
  end
  ret omega_round_pack uint 0 sv sub div e 2 14 ne opv 0
end

fn omega_math_exp x uint to uint
  if num_isnan x
    ret OMEGA_QNAN_BITS
  end
  fx = bitcast f32 x
  if lt fx bitcast f32 uint 0xc2d00000
    ret uint 0
  end
  if gt fx bitcast f32 uint 0x42b17218
    ret OMEGA_INF_POS
  end
  prod = mul fx bitcast f32 uint 0x3fb8aa3b
  k = int 0
  if ge prod bitcast f32 uint 0
    k = int add prod bitcast f32 uint 0x3f000000
  else
    k = int sub prod bitcast f32 uint 0x3f000000
  end
  fk = f32 k
  r = sub sub fx mul fk bitcast f32 uint 0x3f317200 mul fk bitcast f32 uint 0x35bfbe8e
  p = mul r add bitcast f32 uint 0x3d2aaaab mul r bitcast f32 uint 0x3c088889
  p = mul r add bitcast f32 uint 0x3e2aaaab p
  p = mul r add bitcast f32 uint 0x3f000000 p
  poly = add bitcast f32 uint 0x3f800000 mul r add bitcast f32 uint 0x3f800000 p
  if gt k int 127
    s1 = mul poly bitcast f32 shl uint 254 23
    s2 = bitcast f32 shl uint k 23
    ret bitcast uint mul s1 s2
  end
  if lt k int -126
    s1 = mul poly bitcast f32 shl uint add k int 227 23
    s2 = bitcast f32 shl uint 27 23
    ret bitcast uint mul s1 s2
  end
  ret bitcast uint mul poly bitcast f32 shl uint add k int 127 23
end

fn log_poly_eval m f32 e int to uint
  zu = omega_math_div bitcast uint sub m bitcast f32 uint 0x3f800000 bitcast uint add m bitcast f32 uint 0x3f800000
  z = bitcast f32 zu
  z2 = mul z z
  poly = add bitcast f32 uint 0x3e4ccccd mul z2 bitcast f32 uint 0x3e124925
  poly = add bitcast f32 uint 0x3eaaaaab mul z2 poly
  poly = add bitcast f32 uint 0x3f800000 mul z2 poly
  ln_m = mul mul bitcast f32 uint 0x40000000 z poly
  ret bitcast uint add mul f32 e bitcast f32 uint 0x3f317218 ln_m
end

fn omega_math_log x uint to uint
  if num_isnan x
    ret OMEGA_QNAN_BITS
  end
  fx = bitcast f32 x
  if lt fx bitcast f32 uint 0
    ret OMEGA_QNAN_BITS
  end
  if num_iszero x
    ret OMEGA_INF_NEG
  end
  if num_isinf x
    ret OMEGA_INF_POS
  end
  e_adj = int 0
  u = x
  if num_issubnormal x
    fx = mul fx bitcast f32 uint 0x4b000000
    u = bitcast uint fx
    e_adj = int -23
  end
  e = add sub int and shr u 23 uint 0xff int 127 e_adj
  m = bitcast f32 or and u uint 0x007fffff uint 0x3f800000
  if gt m bitcast f32 uint 0x3fb504f3
    m = mul m bitcast f32 uint 0x3f000000
    e = add e int 1
  end
  ret log_poly_eval m e
end

fn omega_warp_reduce_sum warr view uint 32 to uint
  val = new uint 32 0
  for i ulong 32
    put val i get warr i
  end
  d = ulong 16
  for s ulong 5
    for i ulong 32
      if lt add i d 32
        va = bitcast f32 get val i
        vb = bitcast f32 get val add i d
        put val i bitcast uint add va vb
      end
    end
    d = shr d 1
  end
  ret get val 0
end

note ---- Op registry & metadata ----

fn omega_numeric_op_count to ulong
  ret OMEGA_NOP_COUNT
end

fn omega_numeric_op_whole_kernel op ulong to bool
  if or eq op OMEGA_NOP_DIV eq op OMEGA_NOP_SQRT
    ret true
  end
  ret or eq op OMEGA_NOP_EXP eq op OMEGA_NOP_LOG
end

fn omega_numeric_op_at idx ulong to long
  if lt idx OMEGA_NOP_COUNT
    ret long idx
  end
  ret -1
end

fn omega_numeric_op_arity op ulong to ulong
  if or eq op OMEGA_NOP_FFMA eq op OMEGA_NOP_FFMA_V
    ret 3
  end
  if or eq op OMEGA_NOP_FADD or eq op OMEGA_NOP_FSUB eq op OMEGA_NOP_FMUL
    ret 2
  end
  if or eq op OMEGA_NOP_FSETP_SEL or eq op OMEGA_NOP_FSEL or eq op OMEGA_NOP_FMNMX_MIN eq op OMEGA_NOP_FMNMX_MAX
    ret 2
  end
  if eq op OMEGA_NOP_DIV
    ret 2
  end
  if and ge op OMEGA_NOP_FSETP_LT_SEL le op OMEGA_NOP_FSETP_NEU_SEL
    ret 2
  end
  ret 1
end

fn omega_numeric_op_compare op ulong to ulong
  if or eq op OMEGA_NOP_MUFU_RCP eq op OMEGA_NOP_MUFU_RSQ
    ret OMEGA_CMP_SEED_BOUND
  end
  if eq op OMEGA_NOP_F32_TO_F16
    ret OMEGA_CMP_F16_BITS
  end
  if eq op OMEGA_NOP_F32_TO_BF16
    ret OMEGA_CMP_BF16_BITS
  end
  if or eq op OMEGA_NOP_FSETP_SEL or eq op OMEGA_NOP_FSEL or eq op OMEGA_NOP_F2I or eq op OMEGA_NOP_LDS_STS eq op OMEGA_NOP_SHFL_DOWN
    ret OMEGA_CMP_INT_EXACT
  end
  if and ge op OMEGA_NOP_FSETP_LT_SEL le op OMEGA_NOP_F2U
    ret OMEGA_CMP_INT_EXACT
  end
  ret OMEGA_CMP_BIT_EXACT
end

fn num_streq s view uchar * slen ulong t view uchar * to bool
  if ne slen len t
    ret false
  end
  for i ulong slen bound 64
    if ne get s i get t i
      ret false
    end
  end
  ret true
end


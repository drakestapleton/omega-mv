    ret 1
  end
  if eq op OMEGA_NOP_F2I
    patch_put 0 uint 0x00097305 uint 0x00000002 uint 0x0020f100 CTRL_VAR 12
    ret long patch_put_tail 1 true
  end
  if eq op OMEGA_NOP_MUFU_RCP
    patch_put 0 uint 0x00097308 uint 0x00000002 uint 0x00001000 CTRL_VAR 13
    ret long patch_put_tail 1 true
  end
  if eq op OMEGA_NOP_MUFU_RSQ
    patch_put 0 uint 0x00097308 uint 0x00000002 uint 0x00001400 CTRL_VAR 14
    ret long patch_put_tail 1 true
  end
  if eq op OMEGA_NOP_SHFL_DOWN
    patch_put 0 uint 0x02097f89 uint 0x08201f00 uint 0x000e0000 CTRL_VAR 15
    ret long patch_put_tail 1 true
  end
  if eq op OMEGA_NOP_LDS_STS
    patch_put 0 uint 0x00087819 uint 0x00000002 uint 0x000006ff CTRL_FIXED 22
    patch_put 1 uint 0x080a7812 uint 0x000000fc uint 0x078e3cff uint 0x000fca00 23
    patch_put 2 uint 0x08007988 uint 0x00000002 uint 0x080008ff uint 0x010fe200 24
    patch_put 3 uint 0x00007b1d uint 0x00000000 uint 0x00010000 uint 0x000fec00 25
    patch_put 4 uint 0x0a097984 uint 0x000000ff uint 0x08000800 uint 0x000e2800 26
    ret long patch_put_tail 5 true
  end
  if eq op OMEGA_NOP_REDUCE_SUM
    patch_put 0 uint 0x02097f89 uint 0x0a001f00 uint 0x000e0000 CTRL_VAR 16
    patch_put 1 uint 0x02027221 uint 0x00000009 uint 0x00000000 CTRL_FADD_SB0 20
    patch_put 2 uint 0x02097f89 uint 0x09001f00 uint 0x000e0000 CTRL_SHFL_NEXT 17
    patch_put 3 uint 0x02027221 uint 0x00000009 uint 0x00000000 CTRL_FADD_SB0 20
    patch_put 4 uint 0x02097f89 uint 0x08801f00 uint 0x000e0000 CTRL_SHFL_NEXT 18
    patch_put 5 uint 0x02027221 uint 0x00000009 uint 0x00000000 CTRL_FADD_SB0 20
    patch_put 6 uint 0x02097f89 uint 0x08401f00 uint 0x000e0000 CTRL_SHFL_NEXT 19
    patch_put 7 uint 0x02027221 uint 0x00000009 uint 0x00000000 CTRL_FADD_SB0 20
    patch_put 8 uint 0x02097f89 uint 0x08201f00 uint 0x000e0000 CTRL_SHFL_NEXT 15
    patch_put 9 uint 0x02097221 uint 0x00000009 uint 0x00000000 CTRL_FADD_SB0 21
    ret long patch_put_tail 10 false
  end
  ret -99
end

fn omega_numeric_patch_words op ulong to long
  if omega_numeric_op_whole_kernel op
    ret OMEGA_NUMERIC_ERR_NOT_ENCODED
  end
  br = patch_words_base op
  if ne br -99
    ret br
  end
  ecmp = e1_fsetp_code op
  if ge ecmp 0
    w2 = or uint 0x03f00000 shl uint ecmp 12
    patch_put 0 uint 0x0200720b uint 0x00000005 w2 CTRL_FIXED e1_fsetp_pid op
    patch_put 1 uint 0x02097208 uint 0x00000005 uint 0x00000000 uint 0x000fca00 6
    ret long patch_put_tail 2 false
  end
  if eq op OMEGA_NOP_F2I_FLOOR
    patch_put 0 uint 0x00097305 uint 0x00000002 uint 0x00207100 CTRL_VAR 40
    ret long patch_put_tail 1 true
  end
  if eq op OMEGA_NOP_F2I_CEIL
    patch_put 0 uint 0x00097305 uint 0x00000002 uint 0x0020b100 CTRL_VAR 41
    ret long patch_put_tail 1 true
  end
  if eq op OMEGA_NOP_F2I_RNI
    patch_put 0 uint 0x00097305 uint 0x00000002 uint 0x00203100 CTRL_VAR 42
    ret long patch_put_tail 1 true
  end
  if eq op OMEGA_NOP_F2U
    patch_put 0 uint 0x00097305 uint 0x00000002 uint 0x0020f000 CTRL_VAR 43
    ret long patch_put_tail 1 true
  end
  if eq op OMEGA_NOP_I2FP_U32
    patch_put 0 uint 0x00097245 uint 0x00000002 uint 0x00201000 CTRL_FIXED 44
    ret 1
  end
  if eq op OMEGA_NOP_F32_TO_F16
    patch_put 0 uint 0x00097304 uint 0x00000002 uint 0x00200800 CTRL_VAR 45
    ret long patch_put_tail 1 true
  end
  if eq op OMEGA_NOP_F32_TO_BF16
    patch_put 0 uint 0x00097304 uint 0x00000002 uint 0x00202000 CTRL_VAR 46
    ret long patch_put_tail 1 true
  end
  if eq op OMEGA_NOP_F16_TO_F32
    patch_put 0 uint 0xff097230 uint 0x20000002 uint 0x00004100 CTRL_FIXED 47
    ret 1
  end
  if eq op OMEGA_NOP_BF16_TO_F32
    patch_put 0 uint 0x02097819 uint 0x00000010 uint 0x000006ff CTRL_FIXED 48
    ret 1
  end
  if eq op OMEGA_NOP_FFMA_V
    patch_put 0 uint 0xff0a7b82 uint 0x0000e800 uint 0x00000a00 CTRL_VAR 49
    patch_put 1 uint 0x090a7825 uint 0x00000004 uint 0x078e000a uint 0x001fcc00 50
    patch_put 2 uint 0x0a0b7981 uint 0x00000004 uint 0x0c1e1900 uint 0x000e2800 51
    patch_put 3 uint 0x02097223 uint 0x00000005 uint 0x0000000b CTRL_FADD_SB0 52
    ret long patch_put_tail 4 false
  end
  ret OMEGA_NUMERIC_ERR_BAD_ARGS
end

fn num_put_u32_le dst edit uchar 512 off ulong v uint to void
  put dst off uchar and v uint 255
  put dst add off 1 uchar and shr v 8 uint 255
  put dst add off 2 uchar and shr v 16 uint 255
  put dst add off 3 uchar and shr v 24 uint 255
end

fn omega_numeric_build_kernel op ulong code edit uchar 512 to long
  n = omega_numeric_patch_words op
  if le n 0
    if lt n 0
      ret n
    end
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  blen = bw_encode_vecadd code
  if lt blen add OMEGA_NUMERIC_PATCH_OFFSET mul ulong n 16
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  for i ulong ulong n bound 15
    off = add OMEGA_NUMERIC_PATCH_OFFSET mul i 16
    b = mul i 4
    num_put_u32_le code off get g_num_patch_w b
    num_put_u32_le code add off 4 get g_num_patch_w add b 1
    num_put_u32_le code add off 8 get g_num_patch_w add b 2
    num_put_u32_le code add off 12 get g_num_patch_w add b 3
  end
  ret OMEGA_NUMERIC_OK
end

note ---- Structural patch checker ----

fn fixed_latency_producer o uint to bool
  lo = and o uint 0x0fff
  if or eq lo uint 0x986 or eq lo uint 0x988 or eq lo uint 0xb1d eq lo uint 0x94d
    ret false
  end
  if or eq lo uint 0x981 or eq lo uint 0x984 or eq lo uint 0xb82 eq lo uint 0xf89
    ret false
  end
  if or eq lo uint 0x308 or eq lo uint 0x305 eq lo uint 0x304
    ret false
  end
  ret true
end

fn chk_patch_insn_ctrl t ulong n ulong to long
  b = mul t 4
  o = and get g_num_patch_w b uint 0xffff
  w3 = get g_num_patch_w add b 3
  wb = and shr w3 14 uint 7
  st = and shr w3 9 uint 0xf
  if le wb uint 5
    if ge add t 1 n
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    nw3 = get g_num_patch_w add b 7
    if eq and and shr nw3 20 uint 0x3f shl uint 1 wb uint 0
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if lt st uint 2
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    ret OMEGA_NUMERIC_OK
  end
  if and fixed_latency_producer o lt st uint 5
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret OMEGA_NUMERIC_OK
end

fn chk_patch_insn_form t ulong info edit long 9 to long
  b = mul t 4
  w0 = get g_num_patch_w b
  w1 = get g_num_patch_w add b 1
  w2 = get g_num_patch_w add b 2
  o = and w0 uint 0xffff
  if eq o uint 0x7988
    if ne and w0 uint 0x00ffffff uint 0x00007988
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne and w1 uint 0xffffff00 uint 0
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne w2 uint 0x080008ff
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    put info 0 long t
    put info 5 add get info 5 1
    ret OMEGA_NUMERIC_OK
  end
  if eq o uint 0x7984
    if ne w1 uint 0x000000ff
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne w2 uint 0x08000800
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    put info 1 long t
    put info 6 add get info 6 1
    ret OMEGA_NUMERIC_OK
  end
  if eq o uint 0x7b1d
    if ne w0 uint 0x00007b1d
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne w1 uint 0
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne w2 uint 0x00010000
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    put info 2 long t
    put info 7 add get info 7 1
    ret OMEGA_NUMERIC_OK
  end
  if eq and w0 uint 0x0fff uint 0x0986
    if ne w0 uint 0x06007986
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne w1 uint 0x00000009
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne w2 uint 0x0c101904
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    ret OMEGA_NUMERIC_OK
  end
  if eq o uint 0x7819
    put info 3 long t
    ret OMEGA_NUMERIC_OK
  end
  if eq o uint 0x7812
    put info 4 long t
    ret OMEGA_NUMERIC_OK
  end
  if eq o uint 0x7f89
    if ne and w1 uint 0xfc1fe0ff uint 0x08000000
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne w2 uint 0x000e0000
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne and shr w1 8 uint 0x1f uint 0x1f
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    put info 8 add get info 8 1
  end
  ret OMEGA_NUMERIC_OK
end

fn chk_patch_insn_loop n ulong info edit long 9 to long
  for t ulong n bound 15
    rc = chk_patch_insn_ctrl t n
    if ne rc OMEGA_NUMERIC_OK
      ret rc
    end
    rc = chk_patch_insn_form t info
    if ne rc OMEGA_NUMERIC_OK
      ret rc
    end
  end
  ret OMEGA_NUMERIC_OK
end

fn chk_patch_shared_regs sts long lds long shf long lop long tx uint to long
  shfb = mul ulong shf 4
  if ne and shr get g_num_patch_w shfb 24 uint 0xff uint 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne get g_num_patch_w add shfb 1 uint 2
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne get g_num_patch_w add shfb 2 uint 0x000006ff
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  shf_dst = and shr get g_num_patch_w shfb 16 uint 0xff
  stsb = mul ulong sts 4
  if ne and shr get g_num_patch_w stsb 24 uint 0xff shf_dst
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne and get g_num_patch_w add stsb 1 uint 0xff uint 2
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  lopb = mul ulong lop 4
  if ne and shr get g_num_patch_w lopb 24 uint 0xff shf_dst
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne get g_num_patch_w add lopb 2 uint 0x078e3cff
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne get g_num_patch_w add lopb 1 mul sub tx uint 1 uint 4
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ldsb = mul ulong lds 4
  lop_dst = and shr get g_num_patch_w lopb 16 uint 0xff
  if ne and shr get g_num_patch_w ldsb 24 uint 0xff lop_dst
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne and shr get g_num_patch_w ldsb 16 uint 0xff uint 9
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret OMEGA_NUMERIC_OK
end

fn chk_patch_shared info view long 9 qmd1 view uint 96 to long
  sts = get info 0
  lds = get info 1
  bar = get info 2
  shf = get info 3
  lop = get info 4
  if or ne get info 5 1 or ne get info 6 1 ne get info 7 1
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if or ge sts bar ge bar lds
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  tx = and get qmd1 34 uint 0xffff
  barriers = and shr get qmd1 35 17 uint 0x1f
  sbytes = shl and get qmd1 36 uint 0x7ff 7
  if or lt barriers uint 1 ne tx uint OMEGA_NUMERIC_CTA_THREADS
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if gt mul tx uint 4 sbytes
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if lt shf 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if gt shf sts
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if lt lop 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if gt lop lds
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret chk_patch_shared_regs sts lds shf lop tx
end

fn ctrl_waits w3 uint bar uint to bool
  wm = and shr w3 20 uint 0x3f
  ret ne and wm shl uint 1 bar uint 0
end

fn chk_patch_reduce_step s ulong acc uint d uint to long
  sb = mul mul s 2 4
  fb = add sb 4
  sw0 = get g_num_patch_w sb
  if ne and sw0 uint 0xffff uint 0x7f89
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne and shr get g_num_patch_w add sb 1 21 uint 0x1f d
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne and shr sw0 24 uint 0xff acc
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  fw0 = get g_num_patch_w fb
  if ne and fw0 uint 0xffff uint 0x7221
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  fw1 = get g_num_patch_w add fb 1
  if ne and fw1 uint 0xffffff00 uint 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne get g_num_patch_w add fb 2 uint 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  wb = and shr get g_num_patch_w add sb 3 14 uint 7
  if gt wb uint 5
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if not ctrl_waits get g_num_patch_w add fb 3 wb
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne and shr fw0 24 uint 0xff acc
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne and fw1 uint 0xff and shr sw0 16 uint 0xff
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  exp_dst = acc
  if eq s 4
    exp_dst = uint 9
  end
  if ne and shr fw0 16 uint 0xff exp_dst
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret OMEGA_NUMERIC_OK
end

fn chk_patch_reduce n ulong n_shfl long to long
  if or ne n_shfl 5 ne n 12
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  acc = and shr get g_num_patch_w 0 24 uint 0xff
  d = uint 16
  for s ulong 5
    rc = chk_patch_reduce_step s acc d
    if ne rc OMEGA_NUMERIC_OK
      ret rc
    end
    d = shr d 1
  end
  ret OMEGA_NUMERIC_OK
end

fn chk_patch_e1 op ulong n ulong to long
  ecmp = e1_fsetp_code op
  if ge ecmp 0
    if ne n 4
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 0 uint 0x0200720b
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 1 uint 5
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    w2 = get g_num_patch_w 2
    if ne and w2 uint 0xffff0fff uint 0x03f00000
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne long and shr w2 12 uint 0xf ecmp
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 4 uint 0x02097208
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 5 uint 5
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 6 uint 0
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
  end
  if eq op OMEGA_NOP_FFMA_V
    if ne n 6
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 0 uint 0xff0a7b82
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 1 uint 0x0000e800
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 2 uint 0x00000a00
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if gt and shr get g_num_patch_w 3 14 uint 7 uint 5
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 4 uint 0x090a7825
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 5 uint 4
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 6 uint 0x078e000a
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 8 uint 0x0a0b7981
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 9 uint 4
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 10 uint 0x0c1e1900
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 12 uint 0x02097223
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 13 uint 5
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w 14 uint 0xb
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
  end
  ret OMEGA_NUMERIC_OK
end

fn omega_numeric_check_patch op ulong n long qmd1 view uint 96 to long
  info = new long 9 -1
  if ge op OMEGA_NOP_COUNT
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if or lt n 1 gt n long OMEGA_NUMERIC_PATCH_MAX
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if eq and and shr get g_num_patch_w 3 20 uint 0x3f uint 16 uint 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  put info 5 0
  put info 6 0
  put info 7 0
  put info 8 0
  nu = ulong n
  rc = chk_patch_insn_loop nu info
  if ne rc OMEGA_NUMERIC_OK
    ret rc
  end
  uses_sh = or ne get info 5 0 or ne get info 6 0 ne get info 7 0
  if and eq op OMEGA_NOP_LDS_STS or eq get info 5 0 eq get info 6 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if uses_sh
    rc = chk_patch_shared info qmd1
    if ne rc OMEGA_NUMERIC_OK
      ret rc
    end
  end
  if eq op OMEGA_NOP_SHFL_DOWN
    if ne get info 8 1
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne and shr get g_num_patch_w 1 21 uint 0x1f uint 1
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
  end
  if eq op OMEGA_NOP_REDUCE_SUM
    rc = chk_patch_reduce nu get info 8
    if ne rc OMEGA_NUMERIC_OK
      ret rc
    end
  end
  rc = chk_patch_e1 op nu
  if ne rc OMEGA_NUMERIC_OK
    ret rc
  end
  if gt nu 1
    sb = mul sub nu 2 4
    eb = mul sub nu 1 4
    if ne get g_num_patch_w sb uint 0x06007986
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w add sb 1 uint 9
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w add sb 2 uint 0x0c101904
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w eb uint 0x0000794d
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w add eb 1 uint 0
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if ne get g_num_patch_w add eb 2 uint 0x03800000
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
  end
  ret OMEGA_NUMERIC_OK
end

fn submit_check_qmd op ulong n long count ulong to long
  mcfg = new ulong 16 0
  qmd1 = new uint 96 0
  omega_numeric_launch_shape count
  put mcfg 5 count
  put mcfg 6 ulong get g_num_launch_tpb 0
  put mcfg 7 ulong get g_num_launch_grid 0
  if ne bw_qmd1 mcfg qmd1 0
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  ret omega_numeric_check_patch op n qmd1
end

fn omega_numeric_submit_check op_name view uchar * nlen ulong buf_mask ulong count ulong to long
  if num_is_refused_variant op_name nlen
    ret OMEGA_NUMERIC_ERR_NOT_ENCODED
  end
  op_l = omega_numeric_op_find op_name nlen
  if lt op_l 0
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  op = ulong op_l
  if eq and buf_mask 1 0
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if eq and buf_mask 8 0
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if eq count 0
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if gt count OMEGA_NUMERIC_MAX_COUNT
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  ar = omega_numeric_op_arity op
  if and ge ar 2 eq and buf_mask 2 0
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if and ge ar 3 eq and buf_mask 4 0
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if eq op OMEGA_NOP_FFMA
    c0 = get g_num_c 0
    for i ulong count bound 4096
      if ne get g_num_c i c0
        ret OMEGA_NUMERIC_ERR_OPERANDS
      end
    end
  end
  if and or eq op OMEGA_NOP_SHFL_DOWN eq op OMEGA_NOP_REDUCE_SUM ne rem count 32 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if and eq op OMEGA_NOP_LDS_STS ne rem count OMEGA_NUMERIC_CTA_THREADS 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if omega_numeric_op_whole_kernel op
    ret OMEGA_NUMERIC_OK
  end
  n = omega_numeric_patch_words op
  if le n 0
    ret OMEGA_NUMERIC_ERR_NOT_ENCODED
  end
  ret submit_check_qmd op n count
end

note ---- Reference, CPU realization, Parity, Seed Bound, FTZ ----

fn omega_numeric_element_checked op ulong idx ulong to bool
  if eq op OMEGA_NOP_REDUCE_SUM
    ret eq rem idx 32 0
  end
  ret true
end

fn num_eval_one op ulong i ulong is_cpu bool to uint
  warr = new uint 32 0
  a = get g_num_a i
  b = get g_num_b i
  c = get g_num_c i
  if eq op OMEGA_NOP_FADD
    ret omega_ref_fadd a b
  end
  if eq op OMEGA_NOP_FSUB
    ret omega_ref_fsub a b
  end
  if eq op OMEGA_NOP_FMUL
    ret omega_ref_fmul a b
  end
  if eq op OMEGA_NOP_FFMA
    ret omega_ref_ffma a b c
  end
  if eq op OMEGA_NOP_FSETP_SEL
    if omega_ref_fsetp_ge a b
      ret a
    end
    ret b
  end
  if eq op OMEGA_NOP_FSEL
    if omega_ref_fsetp_ge a uint 0
      ret b
    end
    ret a
  end
  if eq op OMEGA_NOP_FMNMX_MIN
    ret omega_ref_fmin a b
  end
  if eq op OMEGA_NOP_FMNMX_MAX
    ret omega_ref_fmax a b
  end
  if eq op OMEGA_NOP_I2FP
    ret omega_ref_i2f bitcast int a
  end
  if eq op OMEGA_NOP_F2I
    ret bitcast uint omega_ref_f2i a
  end
  if eq op OMEGA_NOP_MUFU_RCP
    ret omega_ieee_div uint 0x3f800000 a
  end
  if eq op OMEGA_NOP_MUFU_RSQ
    ret omega_ieee_div uint 0x3f800000 omega_ieee_sqrt a
  end
  if eq op OMEGA_NOP_LDS_STS
    ret get g_num_a xor i 63
  end
  if eq op OMEGA_NOP_SHFL_DOWN
    if eq rem i 32 31
      ret a
    end
    ret get g_num_a add i 1
  end
  if eq op OMEGA_NOP_DIV
    if is_cpu
      ret omega_math_div a b
    end
    ret omega_ieee_div a b
  end
  if eq op OMEGA_NOP_SQRT
    if is_cpu
      ret omega_math_sqrt a
    end
    ret omega_ieee_sqrt a
  end
  if eq op OMEGA_NOP_EXP
    ret omega_math_exp a
  end
  if eq op OMEGA_NOP_LOG
    ret omega_math_log a
  end
  if eq op OMEGA_NOP_REDUCE_SUM
    if ne rem i 32 0
      ret uint 0
    end
    for k ulong 32
      put warr k get g_num_a add i k
    end
    ret omega_warp_reduce_sum warr
  end
  if and ge op OMEGA_NOP_FSETP_LT_SEL le op OMEGA_NOP_FSETP_NEU_SEL
    if eq omega_ref_fsetp_pred op a b 1
      ret a
    end
    ret b
  end
  if eq op OMEGA_NOP_F2I_FLOOR
    ret bitcast uint omega_ref_f2i_floor a
  end
  if eq op OMEGA_NOP_F2I_CEIL
    ret bitcast uint omega_ref_f2i_ceil a
  end
  if eq op OMEGA_NOP_F2I_RNI
    ret bitcast uint omega_ref_f2i_rni a
  end
  if eq op OMEGA_NOP_F2U
    ret omega_ref_f2u a
  end
  if eq op OMEGA_NOP_I2FP_U32
    ret omega_ref_u2f a
  end
  if eq op OMEGA_NOP_F32_TO_F16
    ret omega_ref_f32_to_f16 a
  end
  if eq op OMEGA_NOP_F32_TO_BF16
    ret omega_ref_f32_to_bf16 a
  end
  if eq op OMEGA_NOP_F16_TO_F32
    ret omega_ref_f16_to_f32 and a uint 0xffff
  end
  if eq op OMEGA_NOP_BF16_TO_F32
    ret omega_ref_bf16_to_f32 and a uint 0xffff
  end
  if eq op OMEGA_NOP_FFMA_V
    if is_cpu
      ret omega_ref_ffma a b c
    end
    ret omega_ref_ffma_int a b c
  end
  ret uint 0
end

fn num_tier_checks op ulong count ulong to long
  if ge op OMEGA_NOP_COUNT
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if not omega_numeric_fpenv_ok
    ret OMEGA_NUMERIC_ERR_FPENV
  end
  if and or eq op OMEGA_NOP_SHFL_DOWN eq op OMEGA_NOP_REDUCE_SUM ne rem count 32 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if and eq op OMEGA_NOP_LDS_STS ne rem count OMEGA_NUMERIC_CTA_THREADS 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret OMEGA_NUMERIC_OK
end

fn omega_numeric_reference op ulong count ulong to long
  rc = num_tier_checks op count
  if ne rc OMEGA_NUMERIC_OK
    ret rc
  end
  for i ulong count bound 4096
    put g_num_dst i num_eval_one op i false
  end
  ret OMEGA_NUMERIC_OK
end

fn omega_numeric_cpu_realize op ulong count ulong to long
  rc = num_tier_checks op count
  if ne rc OMEGA_NUMERIC_OK
    ret rc
  end
  if and eq op OMEGA_NOP_F32_TO_BF16 not omega_numeric_cpu_has_bf16
    ret OMEGA_NUMERIC_ERR_NOT_ENCODED
  end
  for i ulong count bound 4096
    put g_num_dst i num_eval_one op i true
  end
  ret OMEGA_NUMERIC_OK
end

fn num_reset_trace to void
  put g_num_tr_checked 0 0
  put g_num_tr_mismatches 0 0
  put g_num_tr_first_idx 0 -1
  put g_num_tr_first_exp 0 uint 0
  put g_num_tr_first_got 0 uint 0
  put g_num_tr_subnorm 0 0
  put g_num_tr_oob 0 0
  put g_num_tr_skipped 0 0
end

fn omega_numeric_parity op ulong count ulong to long
  if ge op OMEGA_NOP_COUNT
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  num_reset_trace
  mode = omega_numeric_op_compare op
  if eq mode OMEGA_CMP_SEED_BOUND
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  for i ulong count bound 4096
    if omega_numeric_element_checked op i
      put g_num_tr_checked 0 add get g_num_tr_checked 0 1
      ue = get g_num_exp i
      ug = get g_num_got i
      if and eq mode OMEGA_CMP_BIT_EXACT num_issubnormal ue
        put g_num_tr_subnorm 0 add get g_num_tr_subnorm 0 1
      end
      if not omega_numeric_compare_equal mode ue ug
        if eq get g_num_tr_mismatches 0 0
          put g_num_tr_first_idx 0 long i
          put g_num_tr_first_exp 0 ue
          put g_num_tr_first_got 0 ug
        end
        put g_num_tr_mismatches 0 add get g_num_tr_mismatches 0 1
      end
    end
  end
  ret OMEGA_NUMERIC_OK
end

fn omega_numeric_seed_bound op ulong count ulong to long
  if ge op OMEGA_NOP_COUNT
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if ne omega_numeric_op_compare op OMEGA_CMP_SEED_BOUND
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if not omega_numeric_fpenv_ok
    ret OMEGA_NUMERIC_ERR_FPENV
  end
  num_reset_trace
  bnd = div f64 1.0 f64 1048576.0
  for i ulong count bound 4096
    x = get g_num_a i
    if or not num_is_finite_normal x and eq op OMEGA_NOP_MUFU_RSQ num_signbit x
      put g_num_tr_skipped 0 add get g_num_tr_skipped 0 1
    else
      eu = omega_ieee_div uint 0x3f800000 x
      if eq op OMEGA_NOP_MUFU_RSQ
        eu = omega_ieee_div uint 0x3f800000 omega_ieee_sqrt x
      end
      if not num_is_finite_normal eu
        put g_num_tr_skipped 0 add get g_num_tr_skipped 0 1
      else
        put g_num_tr_checked 0 add get g_num_tr_checked 0 1
        gu = get g_num_got i
        df = fabs sub f64 bitcast f32 gu f64 bitcast f32 eu
        mf = fabs f64 bitcast f32 eu
        if or num_isnan gu not le df mul mf bnd
          if eq get g_num_tr_oob 0 0
            put g_num_tr_first_idx 0 long i
            put g_num_tr_first_exp 0 eu
            put g_num_tr_first_got 0 gu
          end
          put g_num_tr_oob 0 add get g_num_tr_oob 0 1
        end
      end
    end
  end
  ret OMEGA_NUMERIC_OK
end

fn num_ftz x uint to uint
  if num_issubnormal x
    ret and x uint 0x80000000
  end
  ret x
end

fn omega_numeric_reference_ftz op ulong count ulong to long
  if ge op OMEGA_NOP_COUNT
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if not omega_numeric_fpenv_ok
    ret OMEGA_NUMERIC_ERR_FPENV
  end
  for i ulong count bound 4096
    x = num_ftz get g_num_a i
    y = num_ftz get g_num_b i
    r = uint 0
    if eq op OMEGA_NOP_FADD
      r = omega_ref_fadd x y
    else
      if eq op OMEGA_NOP_FSUB
        r = omega_ref_fsub x y
      else
        if eq op OMEGA_NOP_FMUL
          r = omega_ref_fmul x y
        else
          if eq op OMEGA_NOP_FFMA
            r = omega_ref_ffma x y num_ftz get g_num_c i
          else
            if eq op OMEGA_NOP_FFMA_V
              r = omega_ref_ffma_int x y num_ftz get g_num_c i
            else
              if eq op OMEGA_NOP_FMNMX_MIN
                r = omega_ref_fmin x y
              else
                if eq op OMEGA_NOP_FMNMX_MAX
                  r = omega_ref_fmax x y
                else
                  ret OMEGA_NUMERIC_ERR_OPERANDS
                end
              end
            end
          end
        end
      end
    end
    put g_num_dst i num_ftz r
  end
  ret OMEGA_NUMERIC_OK
end

fn num_find_e1_fsetp s view uchar * n ulong to long
  if lt n 13
    ret -1
  end
  if or ne get s 0 uchar 70 ne get s 5 uchar 95
    ret -1
  end
  c6 = get s 6
  c7 = get s 7
  c8 = get s 8
  if eq n 12
    ret -1
  end
  if eq n 13
    if and eq c6 uchar 76 eq c7 uchar 84
      ret long OMEGA_NOP_FSETP_LT_SEL
    end
    if and eq c6 uchar 76 eq c7 uchar 69
      ret long OMEGA_NOP_FSETP_LE_SEL
    end
    if and eq c6 uchar 71 eq c7 uchar 84
      ret long OMEGA_NOP_FSETP_GT_SEL
    end
    if and eq c6 uchar 69 eq c7 uchar 81
      ret long OMEGA_NOP_FSETP_EQ_SEL
    end
    if and eq c6 uchar 78 eq c7 uchar 69
      ret long OMEGA_NOP_FSETP_NE_SEL
    end
  end
  if eq n 14
    if and eq c6 uchar 78 eq c7 uchar 85
      ret long OMEGA_NOP_FSETP_NUM_SEL
    end
    if and eq c6 uchar 78 eq c7 uchar 65
      ret long OMEGA_NOP_FSETP_NAN_SEL
    end
    if and eq c8 uchar 85 and eq c6 uchar 76 eq c7 uchar 84
      ret long OMEGA_NOP_FSETP_LTU_SEL
    end
    if and eq c8 uchar 85 and eq c6 uchar 76 eq c7 uchar 69
      ret long OMEGA_NOP_FSETP_LEU_SEL
    end
    if and eq c8 uchar 85 and eq c6 uchar 71 eq c7 uchar 84
      ret long OMEGA_NOP_FSETP_GTU_SEL
    end
    if and eq c8 uchar 85 and eq c6 uchar 71 eq c7 uchar 69
      ret long OMEGA_NOP_FSETP_GEU_SEL
    end
    if and eq c8 uchar 85 and eq c6 uchar 69 eq c7 uchar 81
      ret long OMEGA_NOP_FSETP_EQU_SEL
    end
    if and eq c8 uchar 85 and eq c6 uchar 78 eq c7 uchar 69
      ret long OMEGA_NOP_FSETP_NEU_SEL
    end
  end
  ret -1
end

fn omega_numeric_op_find s view uchar * n ulong to long
  if num_streq s n t_op_fadd
    ret long OMEGA_NOP_FADD
  end
  if num_streq s n t_op_fsub
    ret long OMEGA_NOP_FSUB
  end
  if num_streq s n t_op_fmul
    ret long OMEGA_NOP_FMUL
  end
  if num_streq s n t_op_ffma
    ret long OMEGA_NOP_FFMA
  end
  if or num_streq s n t_op_fsetp num_streq s n t_op_fsetp_sel
    ret long OMEGA_NOP_FSETP_SEL
  end
  if num_streq s n t_op_fsel
    ret long OMEGA_NOP_FSEL
  end
  if num_streq s n t_op_fmin
    ret long OMEGA_NOP_FMNMX_MIN
  end
  if num_streq s n t_op_fmax
    ret long OMEGA_NOP_FMNMX_MAX
  end
  if num_streq s n t_op_i2fp
    ret long OMEGA_NOP_I2FP
  end
  if num_streq s n t_op_f2i
    ret long OMEGA_NOP_F2I
  end
  if num_streq s n t_op_rcp
    ret long OMEGA_NOP_MUFU_RCP
  end
  if num_streq s n t_op_rsq
    ret long OMEGA_NOP_MUFU_RSQ
  end
  if or num_streq s n t_op_lds or num_streq s n t_op_sts num_streq s n t_op_lds_sts
    ret long OMEGA_NOP_LDS_STS
  end
  if num_streq s n t_op_shfl
    ret long OMEGA_NOP_SHFL_DOWN
  end
  if num_streq s n t_op_div
    ret long OMEGA_NOP_DIV
  end
  if num_streq s n t_op_sqrt
    ret long OMEGA_NOP_SQRT
  end
  if num_streq s n t_op_exp
    ret long OMEGA_NOP_EXP
  end
  if num_streq s n t_op_log
    ret long OMEGA_NOP_LOG
  end
  if num_streq s n t_op_red
    ret long OMEGA_NOP_REDUCE_SUM
  end
  if num_streq s n t_op_ffmav
    ret long OMEGA_NOP_FFMA_V
  end
  if num_streq s n t_op_f2i_fl
    ret long OMEGA_NOP_F2I_FLOOR
  end
  if num_streq s n t_op_f2i_cl
    ret long OMEGA_NOP_F2I_CEIL
  end
  if num_streq s n t_op_f2i_rn
    ret long OMEGA_NOP_F2I_RNI
  end
  if num_streq s n t_op_f2u
    ret long OMEGA_NOP_F2U
  end
  if num_streq s n t_op_i2u
    ret long OMEGA_NOP_I2FP_U32
  end
  if num_streq s n t_op_f32_f16
    ret long OMEGA_NOP_F32_TO_F16
  end
  if num_streq s n t_op_f32_bf16
    ret long OMEGA_NOP_F32_TO_BF16
  end
  if num_streq s n t_op_f16_f32
    ret long OMEGA_NOP_F16_TO_F32
  end
  if num_streq s n t_op_bf16_f32
    ret long OMEGA_NOP_BF16_TO_F32
  end
  ret num_find_e1_fsetp s n
end

text t_cmp_bit "BIT_EXACT"
text t_cmp_int "INT_EXACT"
text t_cmp_seed "SEED_BOUND"
text t_cmp_f16 "F16_BITS"
text t_cmp_bf16 "BF16_BITS"
text t_cmp_unk "UNKNOWN"

fn omega_numeric_compare_name c ulong dst edit uchar * to ulong
  if eq c OMEGA_CMP_BIT_EXACT
    for i ulong len t_cmp_bit bound 16
      put dst i get t_cmp_bit i
    end
    ret len t_cmp_bit
  end
  if eq c OMEGA_CMP_INT_EXACT
    for i ulong len t_cmp_int bound 16
      put dst i get t_cmp_int i
    end
    ret len t_cmp_int
  end
  if eq c OMEGA_CMP_SEED_BOUND
    for i ulong len t_cmp_seed bound 16
      put dst i get t_cmp_seed i
    end
    ret len t_cmp_seed
  end
  if eq c OMEGA_CMP_F16_BITS
    for i ulong len t_cmp_f16 bound 16
      put dst i get t_cmp_f16 i
    end
    ret len t_cmp_f16
  end
  if eq c OMEGA_CMP_BF16_BITS
    for i ulong len t_cmp_bf16 bound 16
      put dst i get t_cmp_bf16 i
    end
    ret len t_cmp_bf16
  end
  for i ulong len t_cmp_unk bound 16
    put dst i get t_cmp_unk i
  end
  ret len t_cmp_unk
end

fn omega_numeric_compare_equal mode ulong expect uint got uint to bool
  if eq mode OMEGA_CMP_BIT_EXACT
    ret omega_numeric_bits_equal expect got
  end
  if eq mode OMEGA_CMP_INT_EXACT
    ret eq expect got
  end
  if or eq mode OMEGA_CMP_F16_BITS eq mode OMEGA_CMP_BF16_BITS
    if or ne shr expect 16 uint 0 ne shr got 16 uint 0
      ret false
    end
    inf = uint 0x7f80
    if eq mode OMEGA_CMP_F16_BITS
      inf = uint 0x7c00
    end
    en = gt and expect uint 0x7fff inf
    gn = gt and got uint 0x7fff inf
    if or en gn
      ret and en gn
    end
    ret eq expect got
  end
  ret false
end


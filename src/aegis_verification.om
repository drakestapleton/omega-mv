note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/aegis_verification.c (Omega Aegis verification
note boundary: translates OmegaRealizationRequest to ForgeRealizationRequest and
note verifies digest, descriptor, and code contracts before granting token).
note Composes on seed/ng/sha256.om.
om2

const AEGIS_OK long 0
const AEGIS_ERR_NULL long -1
const AEGIS_ERR_DIGEST long -2
const AEGIS_ERR_DESC long -3
const AEGIS_ERR_IR long -4
const AEGIS_ERR_CODE long -5

note Input OmegaRealizationRequest state
global g_aegis_req_prog_dig uchar 32
global g_aegis_req_desc_dig uchar 32
global g_aegis_req_opcodes ulong 1
global g_aegis_req_ir_size ulong 1
global g_aegis_req_mach_arch ulong 1
global g_aegis_req_mach_sm ulong 1

note Input ForgeRealizationResult state
global g_aegis_res_status long 1
global g_aegis_res_prog_dig uchar 32
global g_aegis_res_code_dig uchar 32
global g_aegis_res_code_size ulong 1

note Input ForgeMachineDescriptor state
global g_aegis_desc_arch ulong 1
global g_aegis_desc_sm ulong 1
global g_aegis_desc_dig uchar 32

note Translated ForgeRealizationRequest state (mirrors f_req in omega_aegis_verify)
global g_aegis_freq_prog_dig uchar 32
global g_aegis_freq_desc_dig uchar 32
global g_aegis_freq_opcodes ulong 1
global g_aegis_freq_ir_size ulong 1
global g_aegis_freq_mach_arch ulong 1
global g_aegis_freq_mach_sm ulong 1

note Granted ForgeVerifiedRealization token state
global g_aegis_ver_valid ulong 1
global g_aegis_ver_prog_dig uchar 32
global g_aegis_ver_desc_dig uchar 32
global g_aegis_ver_code_dig uchar 32
global g_aegis_ver_token uchar 32

fn aegis_req_prog_is_zero to bool
  for i ulong 32
    if ne get g_aegis_req_prog_dig i 0
      ret false
    end
  end
  ret true
end

fn aegis_req_desc_is_zero to bool
  for i ulong 32
    if ne get g_aegis_req_desc_dig i 0
      ret false
    end
  end
  ret true
end

fn aegis_res_code_is_zero to bool
  for i ulong 32
    if ne get g_aegis_res_code_dig i 0
      ret false
    end
  end
  ret true
end

fn aegis_desc_dig_eq to bool
  for i ulong 32
    if ne get g_aegis_req_desc_dig i get g_aegis_desc_dig i
      ret false
    end
  end
  ret true
end

fn aegis_prog_dig_eq to bool
  for i ulong 32
    if ne get g_aegis_req_prog_dig i get g_aegis_res_prog_dig i
      ret false
    end
  end
  ret true
end

fn aegis_clear_verified to void
  put g_aegis_ver_valid 0 0
  for i ulong 32
    put g_aegis_ver_prog_dig i 0
    put g_aegis_ver_desc_dig i 0
    put g_aegis_ver_code_dig i 0
    put g_aegis_ver_token i 0
  end
end

fn aegis_compute_token_g to void
  note Domain-separated SHA-256("AEGIS_VER_V1" || prog_dig || desc_dig || code_dig)
  put sh_dat 0 uchar 65
  put sh_dat 1 uchar 69
  put sh_dat 2 uchar 71
  put sh_dat 3 uchar 73
  put sh_dat 4 uchar 83
  put sh_dat 5 uchar 95
  put sh_dat 6 uchar 86
  put sh_dat 7 uchar 69
  put sh_dat 8 uchar 82
  put sh_dat 9 uchar 95
  put sh_dat 10 uchar 86
  put sh_dat 11 uchar 49
  for i ulong 32
    put sh_dat add 12 i get g_aegis_req_prog_dig i
    put sh_dat add 44 i get g_aegis_desc_dig i
    put sh_dat add 76 i get g_aegis_res_code_dig i
  end
  sh_all 108
  for i ulong 32
    put g_aegis_ver_prog_dig i get g_aegis_req_prog_dig i
    put g_aegis_ver_desc_dig i get g_aegis_desc_dig i
    put g_aegis_ver_code_dig i get g_aegis_res_code_dig i
    put g_aegis_ver_token i get sh_dig i
  end
end

note Mirrors omega_aegis_verify(req, res, desc, out_verified)
fn omega_aegis_verify has_ptrs ulong to long
  aegis_clear_verified
  if eq has_ptrs 0
    ret AEGIS_ERR_NULL
  end

  note Translate OmegaRealizationRequest -> ForgeRealizationRequest
  for i ulong 32
    put g_aegis_freq_prog_dig i get g_aegis_req_prog_dig i
    put g_aegis_freq_desc_dig i get g_aegis_req_desc_dig i
  end
  put g_aegis_freq_opcodes 0 get g_aegis_req_opcodes 0
  put g_aegis_freq_ir_size 0 get g_aegis_req_ir_size 0
  put g_aegis_freq_mach_arch 0 get g_aegis_req_mach_arch 0
  put g_aegis_freq_mach_sm 0 get g_aegis_req_mach_sm 0

  note Verify realization contracts (fail-closed)
  if or eq get g_aegis_req_opcodes 0 0 eq get g_aegis_req_ir_size 0 0
    ret AEGIS_ERR_IR
  end
  if or aegis_req_prog_is_zero aegis_req_desc_is_zero
    ret AEGIS_ERR_DIGEST
  end
  if or ne get g_aegis_req_mach_arch 0 get g_aegis_desc_arch 0 ne get g_aegis_req_mach_sm 0 get g_aegis_desc_sm 0
    ret AEGIS_ERR_DESC
  end
  if not aegis_desc_dig_eq
    ret AEGIS_ERR_DESC
  end
  if or ne get g_aegis_res_status 0 0 eq get g_aegis_res_code_size 0 0
    ret AEGIS_ERR_CODE
  end
  if not aegis_prog_dig_eq
    ret AEGIS_ERR_DIGEST
  end
  if aegis_res_code_is_zero
    ret AEGIS_ERR_CODE
  end

  aegis_compute_token_g
  put g_aegis_ver_valid 0 1
  ret AEGIS_OK
end

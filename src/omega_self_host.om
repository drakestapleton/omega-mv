note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_self_host.c (compiler graph G_C,
note 2-pass C0 AArch64 compiler emitter, native AArch64 compiler execution,
note 3-generation C0->C1->C2->C3 fixed-point bootstrap, M5 G_S parity).
note Composes on seed/ng/sha256.om, om/visor/canonical_om2.om,
note src/omega_canonical.om, src/omega_core.om, src/omega_codec.om,
note om/aarch64/aarch64_om2.om, src/omega_exec.om.
om2

const SH_OP_COMPILE ulong 15
const SH_OVERFLOW_FC ulong 3
const SH_REL_DEPENDS ulong 6
const SH_CONST_POST ulong 8
const SH_CONST_INV ulong 9
const SH_PROFILE_V8A ulong 1

const SH_LBL_ENTRY ulong 0
const SH_LBL_ERR_NULL ulong 1
const SH_LBL_ERR_LEN ulong 2
const SH_LBL_ERR_MAGIC ulong 3
const SH_LBL_ERR_COUNT ulong 4
const SH_LBL_EMIT_GS ulong 5
const SH_LBL_EMIT_GC ulong 6
const SH_LBL_COPY_LOOP ulong 7
const SH_LBL_COMMON_RET ulong 8
const SH_LBL_MAX ulong 9

const SH_BASE_IN ulong 0x10000000
const SH_BASE_OUT ulong 0x20000000
const SH_BASE_OLEN ulong 0x30000000
const SH_BASE_DUMMY ulong 0x40000000
const SH_BASE_CODE ulong 0x50000000

text sh_k_name "name"
text sh_v_name "omega_compiler_v0"
text sh_k_target "target"
text sh_v_target "aarch64"
text sh_c_fp "fixed_point"
text sh_c_rep "reproducible"

global g_sh_tot_insns ulong 1
global g_sh_vm_comp uchar 512
global g_sh_vm_in uchar 4096
global g_sh_vm_out uchar 512
global g_sh_vm_olen ulong 1

global g_sh_c1 uchar 512
global g_sh_c1_len ulong 1
global g_sh_c1_rid uchar 32

global g_sh_c2 uchar 512
global g_sh_c2_len ulong 1
global g_sh_c2_rid uchar 32

global g_sh_c3 uchar 512
global g_sh_c3_len ulong 1
global g_sh_c3_rid uchar 32

global g_sh_gc_id uchar 32
global g_sh_gs_code uchar 64
global g_sh_gs_len ulong 1

fn sh_rel labels view ulong 9 target ulong insn_idx ulong pass2 bool to long
  if not pass2
    ret 0
  end
  ret sub long get labels target long insn_idx
end

fn sh_adr_off labels view ulong 9 target ulong insn_idx ulong pass2 bool to long
  if not pass2
    ret 0
  end
  ret sub mul long get labels target 4 mul long insn_idx 4
end

fn sh_emit_hdr buf edit uchar * st edit ulong 2 labels view ulong 9 olbl edit ulong 9 pass2 bool to long
  put olbl SH_LBL_ENTRY div get st 0 4
  rc = a64put buf st a64cbz 1 0 sh_rel labels SH_LBL_ERR_NULL div get st 0 4 pass2
  rc = or rc a64put buf st a64cbz 1 2 sh_rel labels SH_LBL_ERR_NULL div get st 0 4 pass2
  rc = or rc a64put buf st a64cbz 1 3 sh_rel labels SH_LBL_ERR_NULL div get st 0 4 pass2
  rc = or rc a64put buf st a64cbz 1 4 sh_rel labels SH_LBL_ERR_NULL div get st 0 4 pass2
  rc = or rc a64put buf st a64subsimm 1 5 1 6
  rc = or rc a64put buf st a64bcond 3 sh_rel labels SH_LBL_ERR_LEN div get st 0 4 pass2
  rc = or rc a64put buf st a64ldruoff 0 5 0 0
  rc = or rc a64put buf st a64movz 0 6 0x4d4f 0
  rc = or rc a64put buf st a64movk 0 6 0x4747 16
  rc = or rc a64put buf st a64subsreg 0 6 5 6
  rc = or rc a64put buf st a64bcond 1 sh_rel labels SH_LBL_ERR_MAGIC div get st 0 4 pass2
  rc = or rc a64put buf st a64ldrbuoff 5 0 4
  rc = or rc a64put buf st a64cbnz 0 5 sh_rel labels SH_LBL_ERR_COUNT div get st 0 4 pass2
  rc = or rc a64put buf st a64ldrbuoff 6 0 5
  rc = or rc a64put buf st a64subsimm 0 7 6 8
  rc = or rc a64put buf st a64bcond 0 sh_rel labels SH_LBL_EMIT_GS div get st 0 4 pass2
  rc = or rc a64put buf st a64subsimm 0 7 6 5
  rc = or rc a64put buf st a64bcond 0 sh_rel labels SH_LBL_EMIT_GC div get st 0 4 pass2
  rc = or rc a64put buf st a64b sh_rel labels SH_LBL_ERR_COUNT div get st 0 4 pass2
  ret rc
end

fn sh_emit_gs_gc buf edit uchar * st edit ulong 2 labels view ulong 9 olbl edit ulong 9 pass2 bool to long
  total_insns = get g_sh_tot_insns 0
  put olbl SH_LBL_EMIT_GS div get st 0 4
  rc = a64put buf st a64movz 0 5 0x0000 0
  rc = or rc a64put buf st a64movk 0 5 0x8b01 16
  rc = or rc a64put buf st a64struoff 0 5 2 0
  rc = or rc a64put buf st a64movz 0 5 0x0000 0
  rc = or rc a64put buf st a64movk 0 5 0xcb02 16
  rc = or rc a64put buf st a64struoff 0 5 2 4
  rc = or rc a64put buf st a64movz 0 5 0x03c0 0
  rc = or rc a64put buf st a64movk 0 5 0xd65f 16
  rc = or rc a64put buf st a64struoff 0 5 2 8
  rc = or rc a64put buf st a64movz 1 5 12 0
  rc = or rc a64put buf st a64struoff 1 5 3 0
  rc = or rc a64put buf st a64movz 1 0 0 0
  rc = or rc a64put buf st a64b sh_rel labels SH_LBL_COMMON_RET div get st 0 4 pass2

  put olbl SH_LBL_EMIT_GC div get st 0 4
  rc = or rc a64put buf st a64adr 5 sh_adr_off labels SH_LBL_ENTRY div get st 0 4 pass2
  rc = or rc a64put buf st a64movz 1 6 and total_insns 0xffff 0

  put olbl SH_LBL_COPY_LOOP div get st 0 4
  rc = or rc a64put buf st a64ldrpost 7 5 4
  rc = or rc a64put buf st a64strpost 7 2 4
  rc = or rc a64put buf st a64subsimm 1 6 6 1
  rc = or rc a64put buf st a64bcond 1 sh_rel labels SH_LBL_COPY_LOOP div get st 0 4 pass2
  rc = or rc a64put buf st a64movz 1 5 and mul total_insns 4 0xffff 0
  rc = or rc a64put buf st a64struoff 1 5 3 0
  rc = or rc a64put buf st a64movz 1 0 0 0
  rc = or rc a64put buf st a64b sh_rel labels SH_LBL_COMMON_RET div get st 0 4 pass2
  ret rc
end

fn sh_emit_errs buf edit uchar * st edit ulong 2 labels view ulong 9 olbl edit ulong 9 pass2 bool to long
  put olbl SH_LBL_ERR_NULL div get st 0 4
  rc = a64put buf st a64movz 1 0 1 0
  rc = or rc a64put buf st a64subreg 1 0 31 0
  rc = or rc a64put buf st a64b sh_rel labels SH_LBL_COMMON_RET div get st 0 4 pass2

  put olbl SH_LBL_ERR_LEN div get st 0 4
  rc = or rc a64put buf st a64movz 1 0 2 0
  rc = or rc a64put buf st a64subreg 1 0 31 0
  rc = or rc a64put buf st a64b sh_rel labels SH_LBL_COMMON_RET div get st 0 4 pass2

  put olbl SH_LBL_ERR_MAGIC div get st 0 4
  rc = or rc a64put buf st a64movz 1 0 3 0
  rc = or rc a64put buf st a64subreg 1 0 31 0
  rc = or rc a64put buf st a64b sh_rel labels SH_LBL_COMMON_RET div get st 0 4 pass2

  put olbl SH_LBL_ERR_COUNT div get st 0 4
  rc = or rc a64put buf st a64movz 1 0 4 0
  rc = or rc a64put buf st a64subreg 1 0 31 0
  rc = or rc a64put buf st a64b sh_rel labels SH_LBL_COMMON_RET div get st 0 4 pass2

  put olbl SH_LBL_COMMON_RET div get st 0 4
  rc = or rc a64put buf st a64ret
  ret rc
end

fn sh_emit_compiler buf edit uchar * st edit ulong 2 labels view ulong 9 olbl edit ulong 9 pass2 bool to long
  rc = sh_emit_hdr buf st labels olbl pass2
  if ne rc 0
    ret -1
  end
  rc = sh_emit_gs_gc buf st labels olbl pass2
  if ne rc 0
    ret -1
  end
  ret sh_emit_errs buf st labels olbl pass2
end

fn omega_build_compiler_graph out_sem_id edit uchar 32 to long
  tu = omega_build_type_unit
  tb = omega_build_type_byte
  if lt tu 0
    ret -1
  end
  if lt tb 0
    ret -1
  end
  tbid = new uchar 32 0
  core_get_id ulong tb tbid
  tw = omega_build_type_sequence tbid 0
  tc = omega_build_type_sequence tbid 0
  if lt tw 0
    ret -1
  end
  if lt tc 0
    ret -1
  end
  op = omega_graph_add_object CORE_KIND_OP
  if lt op 0
    ret -1
  end
  uo = ulong op
  if ne omega_object_add_attribute uo sh_k_name sh_v_name 17 0
    ret -1
  end
  if ne omega_object_add_attribute uo sh_k_target sh_v_target 7 0
    ret -1
  end
  twid = new uchar 32 0
  tcid = new uchar 32 0
  tuid = new uchar 32 0
  core_get_id ulong tw twid
  core_get_id ulong tc tcid
  core_get_id ulong tu tuid
  pb = mul uo CAN_MAX_PAYLOAD
  core_pay_put_u32le pb 0 SH_OP_COMPILE
  core_pay_put_u32le pb 4 SH_OVERFLOW_FC
  put g_core_pays add pb 40 1
  core_pay_put_id pb 41 twid
  core_pay_put_id pb 169 tcid
  put g_core_pay_len uo CORE_OP_SIZE
  if ne omega_object_add_relation uo SH_REL_DEPENDS tuid 0
    ret -1
  end
  if ne omega_object_add_constraint uo SH_CONST_INV sh_c_fp 11 0
    ret -1
  end
  if ne omega_object_add_constraint uo SH_CONST_POST sh_c_rep 12 0
    ret -1
  end
  if ne core_compute_id uo 0
    ret -1
  end
  core_get_id uo out_sem_id
  ret 0
end

fn sh_compute_rid sem_id view uchar 32 code view uchar * clen ulong out_rid edit uchar 32 to void
  put sh_dat 0 uchar 0x4f
  put sh_dat 1 uchar 0x4d
  put sh_dat 2 uchar 0x47
  put sh_dat 3 uchar 0x5f
  put sh_dat 4 uchar 0x52
  put sh_dat 5 uchar 0x30
  put sh_dat 6 uchar SH_PROFILE_V8A
  for i ulong 32
    put sh_dat add 7 i get sem_id i
  end
  put sh_dat 39 uchar and shr clen 24 255
  put sh_dat 40 uchar and shr clen 16 255
  put sh_dat 41 uchar and shr clen 8 255
  put sh_dat 42 uchar and clen 255
  for i ulong clen bound 512
    put sh_dat add 43 i get code i
  end
  sh_all add 43 clen
  for i ulong 32
    put out_rid i get sh_dig i
  end
end

fn omega_self_host_compile_c0 g_c_id view uchar 32 out_code edit uchar * out_len edit ulong 1 out_rid edit uchar 32 to long
  dummy = new uchar 512 0
  st1 = new ulong 2 0
  put st1 0 0
  put st1 1 512
  z_lbl = new ulong 9 0
  labels = new ulong 9 0
  put g_sh_tot_insns 0 0
  if ne sh_emit_compiler dummy st1 z_lbl labels false 0
    ret -1
  end
  put g_sh_tot_insns 0 div get st1 0 4
  st2 = new ulong 2 0
  put st2 0 0
  put st2 1 512
  olbl2 = new ulong 9 0
  if ne sh_emit_compiler out_code st2 labels olbl2 true 0
    ret -1
  end
  clen = get st2 0
  put out_len 0 clen
  sh_compute_rid g_c_id out_code clen out_rid
  ret 0
end

fn sh_sext19 v ulong to long
  if ne and v 0x40000 0
    ret sub long v 0x80000
  end
  ret long v
end

fn sh_sext26 v ulong to long
  if ne and v 0x2000000 0
    ret sub long v 0x4000000
  end
  ret long v
end

fn sh_sext21 v ulong to long
  if ne and v 0x100000 0
    ret sub long v 0x200000
  end
  ret long v
end

fn sh_rget regs view ulong 32 r ulong to ulong
  if eq r 31
    ret 0
  end
  ret get regs r
end

fn sh_rput regs edit ulong 32 r ulong v ulong to void
  if lt r 31
    put regs r v
  end
end

fn sh_rd32_comp off ulong to ulong
  b0 = ulong get g_sh_vm_comp off
  b1 = ulong get g_sh_vm_comp add off 1
  b2 = ulong get g_sh_vm_comp add off 2
  b3 = ulong get g_sh_vm_comp add off 3
  ret or b0 or shl b1 8 or shl b2 16 shl b3 24
end

fn sh_rd32_in off ulong to ulong
  b0 = ulong get g_sh_vm_in off
  b1 = ulong get g_sh_vm_in add off 1
  b2 = ulong get g_sh_vm_in add off 2
  b3 = ulong get g_sh_vm_in add off 3
  ret or b0 or shl b1 8 or shl b2 16 shl b3 24
end

fn sh_wr32_out off ulong v ulong to void
  put g_sh_vm_out off uchar and v 255
  put g_sh_vm_out add off 1 uchar and shr v 8 255
  put g_sh_vm_out add off 2 uchar and shr v 16 255
  put g_sh_vm_out add off 3 uchar and shr v 24 255
end

fn sh_step_br w ulong pc ulong regs edit ulong 32 fl view ulong 2 to long
  op8 = and w 0xff000000
  if eq op8 0xb4000000
    rt = and w 31
    imm = sh_sext19 and shr w 5 0x7ffff
    if eq sh_rget regs rt 0
      ret add long pc imm
    end
    ret long add pc 1
  end
  if eq op8 0x35000000
    rt = and w 31
    imm = sh_sext19 and shr w 5 0x7ffff
    if ne and sh_rget regs rt 0xffffffff 0
      ret add long pc imm
    end
    ret long add pc 1
  end
  if eq and w 0xfc000000 0x14000000
    imm = sh_sext26 and w 0x3ffffff
    ret add long pc imm
  end
  if eq op8 0x54000000
    cond = and w 15
    imm = sh_sext19 and shr w 5 0x7ffff
    take = false
    if eq cond 0
      take = ne get fl 0 0
    end
    if eq cond 1
      take = eq get fl 0 0
    end
    if eq cond 3
      take = eq get fl 1 0
    end
    if take
      ret add long pc imm
    end
    ret long add pc 1
  end
  ret -2
end

fn sh_step_alu w ulong pc ulong regs edit ulong 32 fl edit ulong 2 to long
  op8 = and w 0xff000000
  if eq op8 0xf1000000
    rd = and w 31
    rn = and shr w 5 31
    imm = and shr w 10 0xfff
    a = sh_rget regs rn
    res = sub a imm
    sh_rput regs rd res
    if eq res 0
      put fl 0 1
    else
      put fl 0 0
    end
    if ge a imm
      put fl 1 1
    else
      put fl 1 0
    end
    ret long add pc 1
  end
  if eq op8 0x71000000
    rd = and w 31
    rn = and shr w 5 31
    imm = and shr w 10 0xfff
    a = and sh_rget regs rn 0xffffffff
    res = and sub a imm 0xffffffff
    sh_rput regs rd res
    if eq res 0
      put fl 0 1
    else
      put fl 0 0
    end
    if ge a imm
      put fl 1 1
    else
      put fl 1 0
    end
    ret long add pc 1
  end
  if eq and w 0xffe0fc00 0x6b000000
    rd = and w 31
    rn = and shr w 5 31
    rm = and shr w 16 31
    a = and sh_rget regs rn 0xffffffff
    b = and sh_rget regs rm 0xffffffff
    res = and sub a b 0xffffffff
    sh_rput regs rd res
    if eq res 0
      put fl 0 1
    else
      put fl 0 0
    end
    if ge a b
      put fl 1 1
    else
      put fl 1 0
    end
    ret long add pc 1
  end
  if eq and w 0xffe0fc00 0xcb000000
    rd = and w 31
    rn = and shr w 5 31
    rm = and shr w 16 31
    sh_rput regs rd sub sh_rget regs rn sh_rget regs rm
    ret long add pc 1
  end
  if eq and w 0x7f800000 0x52800000
    rd = and w 31
    imm = and shr w 5 0xffff
    hw = and shr w 21 3
    sh_rput regs rd shl imm mul hw 16
    ret long add pc 1
  end
  if eq and w 0x7f800000 0x72800000
    rd = and w 31
    imm = and shr w 5 0xffff
    hw = and shr w 21 3
    sh = mul hw 16
    cur = sh_rget regs rd
    msk = xor ulong 0xffffffffffffffff shl ulong 0xffff sh
    v = or and cur msk shl imm sh
    if eq and w 0x80000000 0
      v = and v 0xffffffff
    end
    sh_rput regs rd v
    ret long add pc 1
  end
  if eq and w 0x9f000000 0x10000000
    rd = and w 31
    lo = and shr w 29 3
    hi = and shr w 5 0x7ffff
    imm = sh_sext21 or shl hi 2 lo
    cur_addr = add long SH_BASE_CODE mul long pc 4
    sh_rput regs rd ulong add cur_addr imm
    ret long add pc 1
  end
  ret -2
end

fn sh_step_mem w ulong pc ulong regs edit ulong 32 to long
  if eq and w 0xffc00000 0xb9400000
    rt = and w 31
    rn = and shr w 5 31
    uoff = mul and shr w 10 0xfff 4
    addr = add sh_rget regs rn uoff
    sh_rput regs rt sh_rd32_in sub addr SH_BASE_IN
    ret long add pc 1
  end
  if eq and w 0xffc00000 0x39400000
    rt = and w 31
    rn = and shr w 5 31
    uoff = and shr w 10 0xfff
    addr = add sh_rget regs rn uoff
    sh_rput regs rt ulong get g_sh_vm_in sub addr SH_BASE_IN
    ret long add pc 1
  end
  if eq and w 0xffc00000 0xb9000000
    rt = and w 31
    rn = and shr w 5 31
    uoff = mul and shr w 10 0xfff 4
    addr = add sh_rget regs rn uoff
    sh_wr32_out sub addr SH_BASE_OUT sh_rget regs rt
    ret long add pc 1
  end
  if eq and w 0xffc00000 0xf9000000
    rt = and w 31
    rn = and shr w 5 31
    addr = sh_rget regs rn
    if eq addr SH_BASE_OLEN
      put g_sh_vm_olen 0 sh_rget regs rt
    end
    ret long add pc 1
  end
  if eq and w 0xffe00c00 0xb8400400
    rt = and w 31
    rn = and shr w 5 31
    addr = sh_rget regs rn
    sh_rput regs rt sh_rd32_comp sub addr SH_BASE_CODE
    sh_rput regs rn add addr 4
    ret long add pc 1
  end
  if eq and w 0xffe00c00 0xb8000400
    rt = and w 31
    rn = and shr w 5 31
    addr = sh_rget regs rn
    sh_wr32_out sub addr SH_BASE_OUT sh_rget regs rt
    sh_rput regs rn add addr 4
    ret long add pc 1
  end
  ret -1
end

fn sh_finalize_run_rid ilen ulong out_rid edit uchar 32 to void
  inp = new uchar 4096 0
  for i ulong ilen bound 4096
    put inp i get g_sh_vm_in i
  end
  sem_id = new uchar 32 0
  if eq omega_graph_deserialize_binary inp ilen 0
    ocnt = get g_core_obj_cnt 0
    if gt ocnt 0
      core_get_id sub ocnt 1 sem_id
    end
  end
  olen = get g_sh_vm_olen 0
  oc = new uchar 512 0
  for i ulong olen bound 512
    put oc i get g_sh_vm_out i
  end
  sh_compute_rid sem_id oc olen out_rid
end

fn omega_self_host_run_native_compiler clen ulong ilen ulong out_rid edit uchar 32 to long
  if eq clen 0
    ret -1
  end
  ninsns = div clen 4
  regs = new ulong 32 0
  fl = new ulong 2 0
  put regs 0 SH_BASE_IN
  put regs 1 ilen
  put regs 2 SH_BASE_OUT
  put regs 3 SH_BASE_OLEN
  put regs 4 SH_BASE_DUMMY
  put g_sh_vm_olen 0 0
  pc = ulong 0
  done = false
  while not done bound 10000
    if ge pc ninsns
      ret -1
    end
    w = sh_rd32_comp mul pc 4
    if eq w 0xd65f03c0
      done = true
    else
      nxt = sh_step_br w pc regs fl
      if eq nxt -2
        nxt = sh_step_alu w pc regs fl
      end
      if eq nxt -2
        nxt = sh_step_mem w pc regs
      end
      if lt nxt 0
        ret -1
      end
      pc = ulong nxt
    end
  end
  rc = long get regs 0
  if ne rc 0
    ret rc
  end
  sh_finalize_run_rid ilen out_rid
  ret 0
end

fn sh_bytes_eq a view uchar * b view uchar * n ulong to bool
  for i ulong n bound 512
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn sh_boot_stage_wire wlen edit ulong 1 to long
  if ne omega_graph_create 0
    ret -1
  end
  gc_id = new uchar 32 0
  if ne omega_build_compiler_graph gc_id 0
    ret -1
  end
  for i ulong 32
    put g_sh_gc_id i get gc_id i
  end
  wire = new uchar 4096 0
  if ne omega_graph_serialize_binary wire 4096 wlen 0
    ret -1
  end
  wl = get wlen 0
  for i ulong wl bound 4096
    put g_sh_vm_in i get wire i
  end
  ret 0
end

fn omega_self_host_bootstrap_sequence to long
  wlen = new ulong 1 0
  if ne sh_boot_stage_wire wlen 0
    ret -1
  end
  gc_id = new uchar 32 0
  for i ulong 32
    put gc_id i get g_sh_gc_id i
  end
  c1 = new uchar 512 0
  l1 = new ulong 1 0
  r1 = new uchar 32 0
  if ne omega_self_host_compile_c0 gc_id c1 l1 r1 0
    ret -1
  end
  cl1 = get l1 0
  put g_sh_c1_len 0 cl1
  for i ulong cl1 bound 512
    put g_sh_c1 i get c1 i
    put g_sh_vm_comp i get c1 i
  end
  for i ulong 32
    put g_sh_c1_rid i get r1 i
  end

  r2 = new uchar 32 0
  if ne omega_self_host_run_native_compiler cl1 get wlen 0 r2 0
    ret -1
  end
  cl2 = get g_sh_vm_olen 0
  put g_sh_c2_len 0 cl2
  for i ulong cl2 bound 512
    put g_sh_c2 i get g_sh_vm_out i
    put g_sh_vm_comp i get g_sh_vm_out i
  end
  for i ulong 32
    put g_sh_c2_rid i get r2 i
  end

  r3 = new uchar 32 0
  if ne omega_self_host_run_native_compiler cl2 get wlen 0 r3 0
    ret -1
  end
  cl3 = get g_sh_vm_olen 0
  put g_sh_c3_len 0 cl3
  for i ulong cl3 bound 512
    put g_sh_c3 i get g_sh_vm_out i
  end
  for i ulong 32
    put g_sh_c3_rid i get r3 i
  end

  if ne cl1 cl2
    ret -2
  end
  if ne cl2 cl3
    ret -2
  end
  for i ulong cl1 bound 512
    if ne get g_sh_c1 i get g_sh_c2 i
      ret -3
    end
    if ne get g_sh_c2 i get g_sh_c3 i
      ret -4
    end
  end
  for i ulong 32
    if ne get g_sh_c1_rid i get g_sh_c2_rid i
      ret -5
    end
    if ne get g_sh_c2_rid i get g_sh_c3_rid i
      ret -6
    end
  end
  ret 0
end

fn sh_build_gs_graph to long
  if ne omega_graph_create 0
    ret -1
  end
  tu = omega_build_type_uint 64
  if lt tu 0
    ret -1
  end
  tid = new uchar 32 0
  core_get_id ulong tu tid
  p0 = omega_build_param tid 0
  p1 = omega_build_param tid 1
  p2 = omega_build_param tid 2
  oa = omega_build_op_binary 3 SH_OVERFLOW_FC tid
  os = omega_build_op_binary 4 SH_OVERFLOW_FC tid
  if lt os 0
    ret -1
  end
  id0 = new uchar 32 0
  id1 = new uchar 32 0
  id2 = new uchar 32 0
  ida = new uchar 32 0
  ids = new uchar 32 0
  core_get_id ulong p0 id0
  core_get_id ulong p1 id1
  core_get_id ulong p2 id2
  core_get_id ulong oa ida
  core_get_id ulong os ids
  a1 = omega_build_apply ida id0 id1
  if lt a1 0
    ret -1
  end
  ida1 = new uchar 32 0
  core_get_id ulong a1 ida1
  a2 = omega_build_apply ids ida1 id2
  if lt a2 0
    ret -1
  end
  ret 0
end

fn omega_self_host_verify_m5_parity out_obs edit ulong 1 to long
  if ne sh_build_gs_graph 0
    ret -1
  end
  wire = new uchar 4096 0
  wlen = new ulong 1 0
  if ne omega_graph_serialize_binary wire 4096 wlen 0
    ret -1
  end
  wl = get wlen 0
  for i ulong wl bound 4096
    put g_sh_vm_in i get wire i
  end
  c1len = get g_sh_c1_len 0
  for i ulong c1len bound 512
    put g_sh_vm_comp i get g_sh_c1 i
  end
  gs_r = new uchar 32 0
  if ne omega_self_host_run_native_compiler c1len wl gs_r 0
    ret -1
  end
  if ne get g_sh_vm_olen 0 12
    ret -2
  end
  gs_c = new uchar 12 0
  for i ulong 12
    put gs_c i get g_sh_vm_out i
    put g_sh_gs_code i get g_sh_vm_out i
  end
  put g_sh_gs_len 0 12
  exp = new uchar 12 0
  put exp 0 uchar 0x00
  put exp 1 uchar 0x00
  put exp 2 uchar 0x01
  put exp 3 uchar 0x8b
  put exp 4 uchar 0x00
  put exp 5 uchar 0x00
  put exp 6 uchar 0x02
  put exp 7 uchar 0xcb
  put exp 8 uchar 0xc0
  put exp 9 uchar 0x03
  put exp 10 uchar 0x5f
  put exp 11 uchar 0xd6
  if not sh_bytes_eq gs_c exp 12
    ret -3
  end
  if ne omega_exec_native_f3 gs_c 12 7 11 3 0
    ret -4
  end
  put out_obs 0 get g_ex_res 0
  if ne get out_obs 0 15
    ret -5
  end
  ret 0
end

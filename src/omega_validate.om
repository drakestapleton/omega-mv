note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_validate.c (object & graph validator).
note Composes on seed/ng/sha256.om, om/visor/canonical_om2.om, src/omega_canonical.om,
note src/omega_core.om, om/visor/validate_om2.om.
om2

global g_val_edges ushort 32768
global g_val_deg ushort 256

fn val_check_rels use_graph bool idx ulong to long
  nr = get g_core_rel_n idx
  rk_o = mul idx 64
  rt_o = mul idx 2048
  tgt = new uchar 32 0
  for r ulong nr bound 64
    rk = ulong get g_core_rel_kinds add rk_o r
    if ne om_val_rel_kind rk 0
      ret -1
    end
    if use_graph
      rb = add rt_o mul r 32
      for k ulong 32
        put tgt k get g_core_rel_tgts add rb k
      end
      if lt omega_graph_find_object_const tgt 0
        ret -1
      end
    end
  end
  ret 0
end

fn val_check_type use_graph bool idx ulong to long
  et = new uchar 32 0
  if lt get g_core_pay_len idx CORE_TP_SIZE
    ret -1
  end
  pb = mul idx CAN_MAX_PAYLOAD
  tag = core_pay_get_u32le pb 0
  w = core_pay_get_u16le pb 4
  slen = core_pay_get_u32le pb 8
  if ne om_val_type_fields tag w slen 0
    ret -1
  end
  if and eq tag CORE_TYPE_SEQ use_graph
    for k ulong 32
      put et k get g_core_pays add add pb 12 k
    end
    ei = omega_graph_find_object_const et
    if lt ei 0
      ret -1
    end
    if ne get g_core_kind ulong ei CORE_KIND_TYPE
      ret -1
    end
  end
  ret 0
end

fn val_check_value use_graph bool idx ulong to long
  if lt get g_core_pay_len idx CORE_VP_SIZE
    ret -1
  end
  if not use_graph
    ret 0
  end
  pb = mul idx CAN_MAX_PAYLOAD
  tid = new uchar 32 0
  for k ulong 32
    put tid k get g_core_pays add pb k
  end
  ti = omega_graph_find_object_const tid
  if lt ti 0
    ret -1
  end
  if ne get g_core_kind ulong ti CORE_KIND_TYPE
    ret -1
  end
  tpb = mul ulong ti CAN_MAX_PAYLOAD
  tag = core_pay_get_u32le tpb 0
  w = core_pay_get_u16le tpb 4
  bl = core_pay_get_u16le pb 32
  if gt om_val_val_bytes tag w bl 0
    ret -1
  end
  ret 0
end

fn val_check_op use_graph bool idx ulong to long
  oid = new uchar 32 0
  pl = get g_core_pay_len idx
  pb = mul idx CAN_MAX_PAYLOAD
  if ge pl CORE_OP_SIZE
    opc = core_pay_get_u32le pb 0
    ov = core_pay_get_u32le pb 4
    if ne om_val_op_fields opc ov 0
      ret -1
    end
    ret 0
  end
  if and ge pl CORE_APP_SIZE use_graph
    for k ulong 32
      put oid k get g_core_pays add pb k
    end
    oi = omega_graph_find_object_const oid
    if lt oi 0
      ret -1
    end
    if ne get g_core_kind ulong oi CORE_KIND_OP
      ret -1
    end
    oc = ulong get g_core_pays add pb 32
    for a ulong oc bound 4
      ab = add add pb 33 mul a 32
      for k ulong 32
        put oid k get g_core_pays add ab k
      end
      ai = omega_graph_find_object_const oid
      if lt ai 0
        ret -1
      end
      ak = get g_core_kind ulong ai
      if and ne ak CORE_KIND_VALUE ne ak CORE_KIND_OP
        ret -1
      end
    end
  end
  ret 0
end

fn val_check_effect idx ulong to long
  meta = new ulong 5 0
  cref = new uchar 32 0
  pbytes = new uchar 128 0
  if ne omega_effect_read idx meta cref pbytes CORE_EFF_OK
    ret -1
  end
  ret 0
end

fn omega_validate_object use_graph bool idx ulong to long
  if ge idx get g_core_obj_cnt 0
    ret -1
  end
  kd = get g_core_kind idx
  if ne om_val_kind kd 0
    ret -1
  end
  na = get g_core_attr_n idx
  kb_o = mul idx 2048
  for a ulong na bound 32
    if eq get g_core_attr_keys add kb_o mul a 64 0
      ret -1
    end
  end
  if ne val_check_rels use_graph idx 0
    ret -1
  end
  nc = get g_core_const_n idx
  cm_o = mul idx 64
  for c ulong nc bound 32
    ck = ulong get g_core_const_meta add cm_o mul c 2
    if ne om_val_const_kind ck 0
      ret -1
    end
  end
  if eq kd CORE_KIND_TYPE
    ret val_check_type use_graph idx
  end
  if eq kd CORE_KIND_VALUE
    ret val_check_value use_graph idx
  end
  if eq kd CORE_KIND_OP
    ret val_check_op use_graph idx
  end
  if eq kd CORE_KIND_EFFECT
    ret val_check_effect idx
  end
  ret 0
end

fn val_add_matching i ulong cnt ulong d_in ulong flag ulong tgt view uchar 32 to ulong
  d = d_in
  base = mul i 128
  for j ulong cnt bound 256
    if ge d 128
      break
    end
    if core_id_eq_slot j tgt
      put g_val_edges add base d ushort or flag j
      d = add d 1
    end
  end
  ret d
end

fn val_build_adj_ops i ulong cnt ulong d_in ulong to ulong
  tgt = new uchar 32 0
  d = d_in
  pb = mul i CAN_MAX_PAYLOAD
  oc = ulong get g_core_pays add pb 32
  if gt oc 4
    oc = 4
  end
  for oi ulong oc bound 4
    if ge d 128
      break
    end
    ab = add add pb 33 mul oi 32
    for k ulong 32
      put tgt k get g_core_pays add ab k
    end
    d = val_add_matching i cnt d 512 tgt
  end
  ret d
end

fn val_build_adj_node i ulong cnt ulong to void
  tgt = new uchar 32 0
  d = ulong 0
  nr = get g_core_rel_n i
  rt_o = mul i 2048
  for r ulong nr bound 64
    if ge d 128
      break
    end
    rb = add rt_o mul r 32
    for k ulong 32
      put tgt k get g_core_rel_tgts add rb k
    end
    d = val_add_matching i cnt d 0 tgt
  end
  pl = get g_core_pay_len i
  if and eq get g_core_kind i CORE_KIND_OP and lt pl CORE_OP_SIZE ge pl CORE_APP_SIZE
    d = val_build_adj_ops i cnt d
  end
  put g_val_deg i ushort d
end

fn val_build_adj cnt ulong to void
  for i ulong cnt bound 256
    val_build_adj_node i cnt
  end
end

fn val_run_cycle_check cnt ulong info edit ulong 2 to long
  ed = new ushort 32768 0
  dg = new ushort 256 0
  for i ulong cnt bound 256
    d = get g_val_deg i
    put dg i d
    base = mul i 128
    for k ulong ulong d bound 128
      put ed add base k get g_val_edges add base k
    end
  end
  ret om_val_find_cycle ed dg cnt info
end

fn omega_validate_graph info edit ulong 2 to long
  cnt = get g_core_obj_cnt 0
  if ne om_val_graph_count cnt CORE_MAX_OBJS 0
    ret -1
  end
  for i ulong cnt bound 256
    if ne omega_validate_object true i 0
      ret -1
    end
  end
  val_build_adj cnt
  if ne val_run_cycle_check cnt info 0
    ret -1
  end
  ret 0
end

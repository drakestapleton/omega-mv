fn ds_erfcx_table_body y ulong to void
  row = new uint 11 0
  ds_erfcx_row_fill 0 row
  for n ulong 11
    ds_movi add 10 n get row n
  end
  ds_movi 21 ds_erfcx_a0lo 0
  ds_movi 22 ds_erfcx_c 0
  for j1 ulong 16
    j = add j1 1
    ds_erfcx_row_fill j row
    ds_setpi 0 DS_CMP_GE 0 y ds_erfcx_lo j
    for n ulong 11
      ds_seli add 10 n add 10 n get row n 0 1
    end
    ds_seli 21 21 ds_erfcx_a0lo j 0 1
    ds_seli 22 22 ds_erfcx_c j 0 1
  end
end

fn ds_erfcx_eval_body y ulong c ulong cl ulong t ulong p ulong want_cl ulong to void
  ds_ffsub t y 22
  ds_fffma p 20 t 19
  for k ulong 8
    n = sub 8 k
    ds_fffma p p t add 10 n
  end
  ds_fffma c p t 10
  if ne want_cl 0
    ds_ffsub cl 10 c
    ds_fffma cl p t cl
    ds_ffadd cl cl 21
  end
end

fn ds_body_erf to void
  ds_lopi 3 2 uint 0x7fffffff DS_LUT_AND
  ds_lopi 4 2 uint 0x80000000 DS_LUT_AND
  ds_erf_small_body 3 23
  ds_ffmul 24 3 3
  ds_lopi 25 24 uint 0x80000000 DS_LUT_XOR
  ds_fffma 26 3 3 25
  ds_lopi 27 26 uint 0x80000000 DS_LUT_XOR
  ds_exp_core2_body 25 27 28 29 30
  ds_erfcx_table_body 3
  ds_erfcx_eval_body 3 33 0 31 32 0
  ds_ffmul 34 28 33
  ds_scale2_core 35 34 29 10 11
  ds_movi 36 uint 0x3f800000
  ds_ffsub 37 36 35
  ds_setpi 0 DS_CMP_LT 0 3 uint 0x3f000000
  ds_sel 9 23 37 0 0
  ds_setpi 0 DS_CMP_GE 0 3 uint 0x40800000
  ds_seli 9 9 uint 0x3f800000 0 1
  ds_lop 9 9 4 OMEGA_DS_RZ DS_LUT_OR
  ds_setpi 0 DS_CMP_GT 0 3 uint 0x7f800000
  ds_seli 9 9 uint 0x7fc00000 0 1
end

fn ds_body_gelu to void
  ds_lopi 3 2 uint 0x7fffffff DS_LUT_AND
  ds_lopi 4 2 uint 0x80000000 DS_LUT_AND
  ds_movi 40 uint 0x3f3504f3
  ds_ffmul 23 2 40
  ds_lopi 24 23 uint 0x7fffffff DS_LUT_AND
  ds_movi 41 uint 0x3f000000
  ds_ffmul 25 2 41
  ds_erf_small_body 24 41
  ds_lopi 42 23 uint 0x80000000 DS_LUT_AND
  ds_lop 41 41 42 OMEGA_DS_RZ DS_LUT_OR
  ds_fffma 42 25 41 25
  ds_lop 26 42 4 OMEGA_DS_RZ DS_LUT_OR
  ds_ffmul 27 2 2
  ds_lopi 40 27 uint 0x80000000 DS_LUT_XOR
  ds_fffma 28 2 2 40
  ds_movi 40 uint 0x3f000000
  ds_ffmul 29 27 40
  ds_ffmul 30 28 40
  ds_lopi 31 29 uint 0x80000000 DS_LUT_XOR
  ds_lopi 32 30 uint 0x80000000 DS_LUT_XOR
  ds_exp_core2_body 31 32 33 34 35
  ds_erfcx_table_body 24
  ds_erfcx_eval_body 24 38 39 36 37 1
  ds_movi 40 uint 0x3f3504f3
  ds_lopi 41 23 uint 0x80000000 DS_LUT_XOR
  ds_fffma 42 2 40 41
  ds_movi 40 uint 0x324fe77a
  ds_fffma 42 2 40 42
  ds_setpi 1 DS_CMP_NE 0 4 0
  ds_lopi 41 42 uint 0x80000000 DS_LUT_XOR
  ds_sel 42 41 42 1 0
  ds_movi 40 uint 0x40000000
  ds_ffmul 41 24 40
  ds_movi 40 uint 0xbf906ebb
  ds_fffma 41 41 38 40
  ds_fffma 39 42 41 39
  ds_ffmul 37 33 38
  ds_lopi 40 37 uint 0x80000000 DS_LUT_XOR
  ds_fffma 41 33 38 40
  ds_fffma 41 33 39 41
  ds_fffma 41 35 38 41
  ds_scale2_core 44 37 34 10 11
  ds_lopi 40 25 uint 0x80000000 DS_LUT_XOR
  ds_fffma 43 40 44 2
  ds_ffmul 42 25 41
  ds_fffma 42 25 37 42
  ds_scale2_core 44 42 34 10 11
  ds_setpi 1 DS_CMP_NE 0 4 0
  ds_sel 43 44 43 1 0
  ds_setpi 0 DS_CMP_LT 0 24 uint 0x3f000000
  ds_sel 9 26 43 0 0
  ds_iaddi 41 3 1 OMEGA_DS_RZ
  ds_shri 41 41 1
  ds_shri 42 3 1
  ds_setpi 1 DS_CMP_NE 0 4 0
  ds_sel 41 42 41 1 0
  ds_lop 41 41 4 OMEGA_DS_RZ DS_LUT_OR
  ds_setpi 0 DS_CMP_LT 0 3 uint 0x01000000
  ds_sel 9 41 9 0 0
  ds_setpi 0 DS_CMP_GT 0 3 uint 0x41780000
  ds_movi 42 uint 0x80000000
  ds_sel 41 42 9 0 0
  ds_setpi 1 DS_CMP_NE 0 4 0
  ds_sel 9 41 9 1 0
  ds_setpi 0 DS_CMP_GE 1 2 uint 0x41000000
  ds_sel 9 2 9 0 0
  ds_setpi 0 DS_CMP_GT 0 3 uint 0x7f800000
  ds_seli 9 9 uint 0x7fc00000 0 1
end

fn ds_grow_exp base ulong n ulong b ulong to void
  q = b
  for i ulong n bound 8
    s = ulong 12
    if eq i sub n 1
      s = add base n
    else
      if eq q 12
        s = ulong 14
      else
        s = ulong 12
      end
    end
    ds_two_sum s add base i q add base i 10 11
    q = s
  end
end

fn ds_exp_sign base ulong n ulong dst ulong t ulong to void
  ds_mov dst base
  for i1 ulong sub n 1 bound 8
    i = add i1 1
    ds_shli t add base i 1
    ds_setpi 0 DS_CMP_NE 0 t 0
    ds_sel dst add base i dst 0 0
  end
end

fn ds_body_rsqrt to void
  ds_lopi 8 2 uint 0x7fffffff DS_LUT_AND
  ds_movi 18 uint 0x4b800000
  ds_ffmul 21 8 18
  ds_setpi 0 DS_CMP_LT 0 8 uint 0x00800000
  ds_sel 10 21 8 0 0
  ds_movi 18 uint 0x45800000
  ds_seli 16 18 uint 0x3f800000 0 0
  ds_shri 11 10 23
  ds_iaddi 18 11 1 OMEGA_DS_RZ
  ds_lopi 12 18 1 DS_LUT_AND
  ds_lopi 13 10 uint 0x007fffff DS_LUT_AND
  ds_lopi 13 13 uint 0x3f800000 DS_LUT_OR
  ds_shli 18 12 23
  ds_iadd 13 13 18 OMEGA_DS_RZ
  ds_isub 18 11 12
  ds_iaddi 18 18 129 OMEGA_DS_RZ
  ds_shri 18 18 1
  ds_rsubi 18 18 255
  ds_shli 15 18 23
  ds_lopi 14 13 uint 0x80000000 DS_LUT_XOR
  ds_movi 23 uint 0x3f800000
  ds_movi 24 uint 0x3f000000
  ds_shri 18 13 1
  ds_rsubi 17 18 uint 0x5f3759df
  for k ulong 3
    ds_ffmul 18 17 17
    ds_fffma 21 14 18 23
    ds_ffmul 22 17 24
    ds_fffma 17 22 21 17
  end
  ds_ffmul 33 13 17
  ds_ffmul 22 17 24
  ds_lopi 18 33 uint 0x80000000 DS_LUT_XOR
  ds_fffma 21 18 22 24
  ds_fffma 33 33 21 33
  ds_fffma 22 22 21 22
  ds_ffadd 17 22 22
  ds_ffmul 25 17 17
  ds_lopi 18 25 uint 0x80000000 DS_LUT_XOR
  ds_fffma 26 17 17 18
  ds_ffmul 27 13 25
  ds_lopi 18 27 uint 0x80000000 DS_LUT_XOR
  ds_fffma 28 13 25 18
  ds_ffmul 29 13 26
  ds_lopi 18 29 uint 0x80000000 DS_LUT_XOR
  ds_fffma 30 13 26 18
  ds_ffsub 37 27 23
  ds_ffmul 31 13 17
  ds_lopi 18 31 uint 0x80000000 DS_LUT_XOR
  ds_fffma 32 13 17 18
  ds_movi 18 uint 0x33800000
  ds_ffmul 34 31 18
  ds_ffmul 35 32 18
  ds_movi 18 uint 0x26800000
  ds_ffmul 36 13 18
  ds_lopi 19 34 uint 0x80000000 DS_LUT_XOR
  ds_lopi 20 35 uint 0x80000000 DS_LUT_XOR
  ds_grow_exp 37 1 28
  ds_grow_exp 37 2 29
  ds_grow_exp 37 3 30
  ds_grow_exp 37 4 36
  for i ulong 5
    ds_mov add 25 i add 37 i
  end
  ds_grow_exp 25 5 34
  ds_grow_exp 25 6 35
  ds_exp_sign 25 7 44 18
  ds_shri 44 44 31
  for i ulong 5
    ds_mov add 25 i add 37 i
  end
  ds_grow_exp 25 5 19
  ds_grow_exp 25 6 20
  ds_exp_sign 25 7 45 18
  ds_shri 45 45 31
  ds_iadd 18 17 44 45
  ds_iaddi 18 18 uint 0xffffffff OMEGA_DS_RZ
  ds_ffmul 18 18 15
  ds_ffmul 9 18 16
  ds_setpi 0 DS_CMP_GE 0 2 uint 0x80000000
  ds_seli 9 9 uint 0x7fc00000 0 1
  ds_lopi 18 2 uint 0x7f800000 DS_LUT_OR
  ds_setp 0 DS_CMP_EQ 0 8 OMEGA_DS_RZ
  ds_sel 9 18 9 0 0
  ds_setpi 0 DS_CMP_EQ 0 2 uint 0x7f800000
  ds_sel 9 OMEGA_DS_RZ 9 0 0
  ds_setpi 0 DS_CMP_GT 0 8 uint 0x7f800000
  ds_seli 9 9 uint 0x7fc00000 0 1
end

fn omega_ds_body op ulong to ulong
  put g_ds_body_n 0 0
  put g_ds_body_bad 0 0
  if eq op OMEGA_DS_DIV
    ds_body_div
  else
    if eq op OMEGA_DS_SQRT
      ds_body_sqrt
    else
      if eq op OMEGA_DS_EXP2
        ds_body_exp2
      else
        if eq op OMEGA_DS_LOG2
          ds_body_log2
        else
          if eq op OMEGA_DS_SIGMOID
            ds_body_sigmoid
          else
            if eq op OMEGA_DS_TANH
              ds_body_tanh
            else
              if eq op OMEGA_DS_SIN
                ds_body_sincos 0
              else
                if eq op OMEGA_DS_COS
                  ds_body_sincos 1
                else
                  if eq op OMEGA_DS_ERF
                    ds_body_erf
                  else
                    if eq op OMEGA_DS_GELU
                      ds_body_gelu
                    else
                      if eq op OMEGA_DS_RSQRT
                        ds_body_rsqrt
                      else
                        if eq op OMEGA_DS_EXP
                          ds_body_exp
                        else
                          if eq op OMEGA_DS_LOG
                            ds_body_log
                          else
                            ret 0
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  if ne get g_ds_body_bad 0 0
    ret 0
  end
  ret get g_ds_body_n 0
end

note ---- Host model ----

fn ds_lut3 a uint b uint c uint lut ulong to uint
  r = uint 0
  na = xor a uint 0xffffffff
  nb = xor b uint 0xffffffff
  nc = xor c uint 0xffffffff
  for i ulong 8
    if ne and shr lut i 1 0
      ta = na
      if ne and i 4 0
        ta = a
      end
      tb = nb
      if ne and i 2 0
        tb = b
      end
      tc = nc
      if ne and i 1 0
        tc = c
      end
      r = or r and ta and tb tc
    end
  end
  ret r
end

fn ds_icmp cmp ulong sgn ulong a uint b uint to ulong
  is_lt = false
  if ne sgn 0
    is_lt = lt bitcast int a bitcast int b
  else
    is_lt = lt a b
  end
  is_eq = eq a b
  if eq cmp DS_CMP_LT
    if is_lt
      ret 1
    end
    ret 0
  end
  if eq cmp DS_CMP_EQ
    if is_eq
      ret 1
    end
    ret 0
  end
  if eq cmp DS_CMP_LE
    if or is_lt is_eq
      ret 1
    end
    ret 0
  end
  if eq cmp DS_CMP_GT
    if and not is_lt not is_eq
      ret 1
    end
    ret 0
  end
  if eq cmp DS_CMP_NE
    if not is_eq
      ret 1
    end
    ret 0
  end
  if eq cmp DS_CMP_GE
    if not is_lt
      ret 1
    end
    ret 0
  end
  ret 0
end

fn ds_hfp kind ulong a uint b uint c uint to uint
  u = uint 0
  if eq kind 0
    u = omega_ref_fadd a b
  else
    if eq kind 1
      u = omega_ref_fmul a b
    else
      u = omega_ref_ffma_int a b c
    end
  end
  if gt and u uint 0x7fffffff uint 0x7f800000
    ret uint 0x7fffffff
  end
  ret u
end

fn ds_exec_alu k ulong p0 ulong p1 ulong to uint
  ra = get g_ds_reg and shr p0 16 255
  rb = get g_ds_reg and shr p0 24 255
  rc = get g_ds_reg and shr p0 32 255
  imm = uint and p1 0xffffffff
  res = uint 0
  if eq k DSK_IADD3_R
    va = ra
    if ne and shr p0 40 1 0
      va = sub uint 0 ra
    end
    vb = rb
    if ne and shr p0 41 1 0
      vb = sub uint 0 rb
    end
    res = add add va vb rc
  end
  if eq k DSK_IADD3_I
    va = ra
    if ne and shr p0 40 1 0
      va = sub uint 0 ra
    end
    res = add add va imm rc
  end
  if eq k DSK_LOP3_R
    res = ds_lut3 ra rb rc and shr p0 48 255
  end
  if eq k DSK_LOP3_I
    res = ds_lut3 ra imm rc and shr p0 48 255
  end
  if eq k DSK_SHL_I
    if lt imm uint 32
      res = shl ra imm
    end
  end
  if eq k DSK_SHL_R
    if lt rb uint 32
      res = shl ra rb
    end
  end
  if eq k DSK_SHR_I
    if lt imm uint 32
      res = shr rc imm
    end
  end
  if eq k DSK_SHR_R
    if lt rb uint 32
      res = shr rc rb
    end
  end
  ret res
end

fn ds_exec_fp_pred k ulong p0 ulong p1 ulong to uint
  ra = get g_ds_reg and shr p0 16 255
  rb = get g_ds_reg and shr p0 24 255
  rc = get g_ds_reg and shr p0 32 255
  imm = uint and p1 0xffffffff
  if eq k DSK_SEL_R
    ps = and shr p1 48 255
    pneg = and shr p1 56 1
    if ne xor get g_ds_pred ps pneg 0
      ret ra
    end
    ret rb
  end
  if eq k DSK_SEL_I
    ps = and shr p1 48 255
    pneg = and shr p1 56 1
    if ne xor get g_ds_pred ps pneg 0
      ret ra
    end
    ret imm
  end
  if eq k DSK_I2FP
    ret omega_ref_i2f bitcast int rb
  end
  if eq k DSK_FADD_R
    vb = rb
    if ne and shr p0 41 1 0
      vb = xor rb uint 0x80000000
    end
    ret ds_hfp 0 ra vb 0
  end
  if eq k DSK_FMUL_R
    ret ds_hfp 1 ra rb 0
  end
  if eq k DSK_FFMA_R
    ret ds_hfp 2 ra rb rc
  end
  ret uint 0
end

fn ds_exec_one p0 ulong p1 ulong to void
  k = and p0 255
  d = and shr p0 8 255
  if or eq k DSK_ISETP_R eq k DSK_ISETP_I
    ra = get g_ds_reg and shr p0 16 255
    cmp = and shr p1 32 255
    sgn = and shr p1 40 1
    if eq k DSK_ISETP_R
      put g_ds_pred d ds_icmp cmp sgn ra get g_ds_reg and shr p0 24 255
    else
      put g_ds_pred d ds_icmp cmp sgn ra uint and p1 0xffffffff
    end
    ret
  end
  res = uint 0
  if lt k DSK_ISETP_R
    res = ds_exec_alu k p0 p1
  else
    res = ds_exec_fp_pred k p0 p1
  end
  if ne d OMEGA_DS_RZ
    put g_ds_reg d res
  end
end

fn omega_ds_host_exec op ulong a uint b uint to uint
  nb = omega_ds_body op
  if eq nb 0
    ret uint 0
  end
  for i ulong 256
    put g_ds_reg i uint 0xdeadbeef
  end
  for i ulong 8
    put g_ds_pred i 0
  end
  put g_ds_reg OMEGA_DS_RZ 0
  put g_ds_pred OMEGA_DS_PT 1
  put g_ds_reg 2 a
  put g_ds_reg 5 b
  for k ulong nb bound 1000
    ds_exec_one get g_ds_body mul k 2 get g_ds_body add mul k 2 1
  end
  ret get g_ds_reg OMEGA_DS_RESULT_REG
end

fn omega_ds_cpu_semantic op ulong a uint b uint to uint
  if eq op OMEGA_DS_DIV
    ret omega_math_div a b
  end
  if eq op OMEGA_DS_SQRT
    ret omega_math_sqrt a
  end
  if eq op OMEGA_DS_EXP
    ret omega_math_exp a
  end
  if eq op OMEGA_DS_LOG
    ret omega_math_log a
  end
  ret uint 0x7fc00000
end

note ---- Kernel image builder ----

fn ds_padded_insns nb ulong to ulong
  n = add add OMEGA_DS_PROLOGUE_INSNS nb OMEGA_DS_EPILOGUE_INSNS
  ret and add n 7 xor ulong 7 ulong 0xffffffffffffffff
end

fn ds_put_u32_code off ulong v uint to void
  put g_ds_code off uchar and v 255
  put g_ds_code add off 1 uchar and shr v 8 255
  put g_ds_code add off 2 uchar and shr v 16 255
  put g_ds_code add off 3 uchar and shr v 24 255
end

fn ds_get_u32_code off ulong to uint
  v = uint get g_ds_code off
  v = or v shl uint get g_ds_code add off 1 8
  v = or v shl uint get g_ds_code add off 2 16
  v = or v shl uint get g_ds_code add off 3 24
  ret v
end

fn ds_load_vecadd to bool
  tmp = new uchar 512 0
  if ne bw_encode_vecadd tmp 512
    ret false
  end
  for i ulong 512
    put g_ds_va i get tmp i
  end
  ret true
end

fn ds_copy_va_insn dst_k ulong va_k ulong to void
  doff = mul dst_k 16
  soff = mul va_k 16
  for b ulong 16
    put g_ds_code add doff b get g_ds_va add soff b
  end
end

fn ds_eq_va_insn code_k ulong va_k ulong to bool
  coff = mul code_k 16
  soff = mul va_k 16
  for b ulong 16
    if ne get g_ds_code add coff b get g_ds_va add soff b
      ret false
    end
  end
  ret true
end

note Builds kernel for op into g_ds_code; returns byte length (0 on error).
fn omega_ds_build_kernel op ulong to ulong
  nb = omega_ds_body op
  if eq nb 0
    ret 0
  end
  if not ds_load_vecadd
    ret 0
  end
  total = ds_padded_insns nb
  nbytes = mul total 16
  if gt nbytes OMEGA_DS_MAX_CODE_BYTES
    ret 0
  end
  for k ulong OMEGA_DS_PROLOGUE_INSNS
    ds_copy_va_insn k k
  end
  w = new uint 4 0
  for i ulong nb bound 1000
    p0 = get g_ds_body mul i 2
    p1 = get g_ds_body add mul i 2 1
    if ne omega_ds_encode p0 p1 w 0
      ret 0
    end
    off = mul add OMEGA_DS_PROLOGUE_INSNS i 16
    ds_put_u32_code off get w 0
    ds_put_u32_code add off 4 get w 1
    ds_put_u32_code add off 8 get w 2
    ds_put_u32_code add off 12 get w 3
  end
  k = add OMEGA_DS_PROLOGUE_INSNS nb
  ds_copy_va_insn k 18
  ds_copy_va_insn add k 1 19
  ds_copy_va_insn add k 2 20
  k = add k 3
  while lt k total bound 1024
    ds_copy_va_insn k 21
    k = add k 1
  end
  ret nbytes
end

note Format one instruction / kernel listing stub (compact deterministic text into dst)
fn omega_ds_format p0 ulong dst edit uchar * to ulong
  k = and p0 255
  if ge k DSK_COUNT
    ret 0
  end
  n = len dst
  if lt n 4
    ret 0
  end
  put dst 0 uchar 68
  put dst 1 uchar 83
  put dst 2 uchar add 48 rem k 10
  put dst 3 uchar 0
  ret 3
end

fn omega_ds_listing op ulong dst edit uchar * to long
  nb = omega_ds_body op
  if or eq nb 0 lt len dst 8
    ret -1
  end
  n = omega_ds_op_name op dst
  if eq n 0
    ret -1
  end
  ret 0
end

note ---- Pre-submission checks ----

fn ds_writes_reg k ulong to bool
  ret and ne k DSK_ISETP_R ne k DSK_ISETP_I
end

fn ds_src_regs p0 ulong sr edit ulong 3 to ulong
  k = and p0 255
  a = and shr p0 16 255
  b = and shr p0 24 255
  c = and shr p0 32 255
  if or eq k DSK_IADD3_R or eq k DSK_LOP3_R eq k DSK_FFMA_R
    put sr 0 a
    put sr 1 b
    put sr 2 c
    ret 3
  end
  if or eq k DSK_IADD3_I eq k DSK_LOP3_I
    put sr 0 a
    put sr 1 c
    ret 2
  end
  if or eq k DSK_SHL_I or eq k DSK_ISETP_I eq k DSK_SEL_I
    put sr 0 a
    ret 1
  end
  if or eq k DSK_SHL_R eq k DSK_ISETP_R
    put sr 0 a
    put sr 1 b
    ret 2
  end
  if or eq k DSK_SEL_R or eq k DSK_FADD_R eq k DSK_FMUL_R
    put sr 0 a
    put sr 1 b
    ret 2
  end
  if eq k DSK_SHR_I
    put sr 0 c
    ret 1
  end
  if eq k DSK_SHR_R
    put sr 0 b
    put sr 1 c
    ret 2
  end
  put sr 0 b
  ret 1
end

fn ds_decode_code_insn idx ulong dec edit ulong 2 to long
  w = new uint 4 0
  off = mul add OMEGA_DS_PROLOGUE_INSNS idx 16
  put w 0 ds_get_u32_code off
  put w 1 ds_get_u32_code add off 4
  put w 2 ds_get_u32_code add off 8
  put w 3 ds_get_u32_code add off 12
  if ne and shr get w 0 12 uint 15 uint 7
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne get w 3 OMEGA_DS_BODY_CTRL
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if ne omega_ds_decode w dec 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret OMEGA_NUMERIC_OK
end

fn ds_check_body_one idx ulong state edit ulong 3 to long
  dec = new ulong 2 0
  if ne ds_decode_code_insn idx dec OMEGA_NUMERIC_OK
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  sr = new ulong 3 0
  p0 = get dec 0
  ns = ds_src_regs p0 sr
  maxreg = get state 0
  for j ulong ns bound 3
    r = get sr j
    if eq get g_ds_defr r 0
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    if and ne r OMEGA_DS_RZ gt r maxreg
      maxreg = r
    end
  end
  k = and p0 255
  d = and shr p0 8 255
  if or eq k DSK_SEL_R eq k DSK_SEL_I
    if eq get g_ds_defp and shr get dec 1 48 255 0
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
  end
  if ds_writes_reg k
    if or eq d 1 or eq d 6 eq d 7
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    put g_ds_defr d 1
    if and ne d OMEGA_DS_RZ gt d maxreg
      maxreg = d
    end
  else
    put g_ds_defp d 1
  end
  put state 0 maxreg
  put state 1 k
  put state 2 d
  ret OMEGA_NUMERIC_OK
end

fn ds_check_body_loop nb ulong gpr_count ulong to long
  for i ulong 256
    put g_ds_defr i 0
  end
  for i ulong 8
    put g_ds_defp i 0
  end
  put g_ds_defr OMEGA_DS_RZ 1
  put g_ds_defr 2 1
  put g_ds_defr 5 1
  put g_ds_defp OMEGA_DS_PT 1
  st = new ulong 3 0
  put st 1 DSK_ISETP_R
  for i ulong nb bound 1000
    rc = ds_check_body_one i st
    if ne rc OMEGA_NUMERIC_OK
      ret rc
    end
  end
  maxreg = get st 0
  if or gt add add maxreg 1 OMEGA_DS_GPR_RESERVED gpr_count gt gpr_count 255
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if or not ds_writes_reg get st 1 ne get st 2 OMEGA_DS_RESULT_REG
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret OMEGA_NUMERIC_OK
end

fn omega_ds_check_kernel op ulong nbytes ulong gpr_count ulong to long
  if ge op OMEGA_DS_OP_COUNT
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  min_bytes = mul 16 add add OMEGA_DS_PROLOGUE_INSNS OMEGA_DS_EPILOGUE_INSNS 1
  if or ne rem nbytes 128 0 or gt nbytes OMEGA_DS_MAX_CODE_BYTES lt nbytes min_bytes
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if not ds_load_vecadd
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  for k ulong OMEGA_DS_PROLOGUE_INSNS
    if not ds_eq_va_insn k k
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
  end
  n = div nbytes 16
  stg = n
  for k ulong sub n OMEGA_DS_PROLOGUE_INSNS bound 1024
    idx = add OMEGA_DS_PROLOGUE_INSNS k
    if eq stg n
      if ds_eq_va_insn idx 18
        stg = idx
      end
    end
  end
  if gt add stg 3 n
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  if or not ds_eq_va_insn add stg 1 19 not ds_eq_va_insn add stg 2 20
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  nb = sub stg OMEGA_DS_PROLOGUE_INSNS
  if or eq nb 0 gt nb OMEGA_DS_MAX_BODY
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  pidx = add stg 3
  while lt pidx n bound 1024
    if not ds_eq_va_insn pidx 21
      ret OMEGA_NUMERIC_ERR_OPERANDS
    end
    pidx = add pidx 1
  end
  ret ds_check_body_loop nb gpr_count
end

fn ds_hex_eq hex view uchar 64 want view uchar * to bool
  if ne len want 64
    ret false
  end
  for i ulong 64
    if ne get hex i get want i
      ret false
    end
  end
  ret true
end

fn ds_digest_match op ulong hex view uchar 64 to bool
  if eq op 0
    ret ds_hex_eq hex ds_sha_0
  end
  if eq op 1
    ret ds_hex_eq hex ds_sha_1
  end
  if eq op 2
    ret ds_hex_eq hex ds_sha_2
  end
  if eq op 3
    ret ds_hex_eq hex ds_sha_3
  end
  if eq op 4
    ret ds_hex_eq hex ds_sha_4
  end
  if eq op 5
    ret ds_hex_eq hex ds_sha_5
  end
  if eq op 6
    ret ds_hex_eq hex ds_sha_6
  end
  if eq op 7
    ret ds_hex_eq hex ds_sha_7
  end
  if eq op 8
    ret ds_hex_eq hex ds_sha_8
  end
  if eq op 9
    ret ds_hex_eq hex ds_sha_9
  end
  if eq op 10
    ret ds_hex_eq hex ds_sha_10
  end
  if eq op 11
    ret ds_hex_eq hex ds_sha_11
  end
  if eq op 12
    ret ds_hex_eq hex ds_sha_12
  end
  ret false
end

fn ds_nibble_hex v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

fn omega_ds_check_digest op ulong nbytes ulong to long
  if or ge op OMEGA_DS_OP_COUNT eq nbytes 0
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if gt nbytes OMEGA_DS_MAX_CODE_BYTES
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  buf = new uchar 16384 0
  for i ulong nbytes bound 16384
    put buf i get g_ds_code i
  end
  dg = new uchar 32 0
  sha256_hash part buf 0 nbytes dg
  hex = new uchar 64 0
  for i ulong 32
    b = ulong get dg i
    put hex mul i 2 ds_nibble_hex shr b 4
    put hex add mul i 2 1 ds_nibble_hex and b 15
  end
  if not ds_digest_match op hex
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret OMEGA_NUMERIC_OK
end

fn omega_ds_check_args op ulong has_a bool has_b bool has_out bool count ulong to long
  if ge op OMEGA_DS_OP_COUNT
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if or not has_a not has_out
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if and eq op OMEGA_DS_DIV not has_b
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  if or eq count 0 gt count OMEGA_DS_MAX_BATCH
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret OMEGA_NUMERIC_OK
end

fn omega_ds_check_qmd qmd1 view uint 96 code_va ulong to long
  if ne bw_qmd_verify qmd1 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  gpr = and shr get qmd1 35 8 uint 0x1ff
  if ne gpr uint OMEGA_DS_GPR_COUNT
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  lo_want = uint and shr code_va 4 0xffffffff
  hi_want = uint and shr code_va 36 0x1fffff
  if or ne get qmd1 32 lo_want ne and get qmd1 33 uint 0x1fffff hi_want
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret OMEGA_NUMERIC_OK
end

note ---- GB10 Silicon Executor (composes omega_gpu_session.om) ----

fn ds_upload_code mh long nbytes ulong to bool
  if ne get ogpl_mock 0 0
    ret true
  end
  buf = new uchar 256 0
  pos = ulong 0
  while lt pos nbytes bound 64
    take = sub nbytes pos
    if gt take 256
      take = ulong 256
    end
    for i ulong take bound 256
      put buf i get g_ds_code add pos i
    end
    if ne mapwrite mh pos buf 0 take long take
      ret false
    end
    pos = add pos take
  end
  ret true
end

fn ds_write_u32_buf mh long src view uint * count ulong to bool
  if ne get ogpl_mock 0 0
    ret true
  end
  buf = new uchar 1024 0
  pos = ulong 0
  while lt pos count bound 256
    take = sub count pos
    if gt take 256
      take = ulong 256
    end
    ogps_pack_u32_chunk src pos take buf
    if ne mapwrite mh mul pos 4 buf 0 mul take 4 long mul take 4
      ret false
    end
    pos = add pos take
  end
  ret true
end

fn ds_unpack_u32_chunk buf view uchar 1024 dst edit uint * pos ulong take ulong to void
  for i ulong take bound 256
    o = mul i 4
    v = uint get buf o
    v = or v shl uint get buf add o 1 8
    v = or v shl uint get buf add o 2 16
    v = or v shl uint get buf add o 3 24
    put dst add pos i v
  end
end

fn ds_read_u32_buf mh long dst edit uint * count ulong to bool
  if ne get ogpl_mock 0 0
    ret true
  end
  buf = new uchar 1024 0
  pos = ulong 0
  while lt pos count bound 256
    take = sub count pos
    if gt take 256
      take = ulong 256
    end
    if ne mapread mh mul pos 4 buf 0 mul take 4 long mul take 4
      ret false
    end
    ds_unpack_u32_chunk buf dst pos take
    pos = add pos take
  end
  ret true
end

fn ds_write_gnum_a mh long count ulong to bool
  la = new uint 4096 0
  for i ulong count bound 4096
    put la i get g_num_a i
  end
  ret ds_write_u32_buf mh part la 0 count count
end

fn ds_write_gnum_b mh long count ulong to bool
  lb = new uint 4096 0
  for i ulong count bound 4096
    put lb i get g_num_b i
  end
  ret ds_write_u32_buf mh part lb 0 count count
end

fn ds_write_gnum_c mh long count ulong to bool
  lc = new uint 4096 0
  for i ulong count bound 4096
    put lc i get g_num_c i
  end
  ret ds_write_u32_buf mh part lc 0 count count
end

fn ds_read_gnum_dst mh long count ulong to bool
  lo = new uint 4096 0
  if not ds_read_u32_buf mh part lo 0 count count
    ret false
  end
  for i ulong count bound 4096
    put g_num_dst i get lo i
  end
  ret true
end

fn ds_precheck_qmd count ulong to long
  omega_numeric_launch_shape count
  tpb = ulong get g_num_launch_tpb 0
  gx = ulong get g_num_launch_grid 0
  qcfg = new ulong 16 0
  q1 = new uint 96 0
  put qcfg 0 0x200000000
  put qcfg 1 0x200100000
  put qcfg 2 0x200204000
  put qcfg 3 0x200202000
  put qcfg 4 0x200200000
  put qcfg 5 count
  put qcfg 6 tpb
  put qcfg 7 gx
  put qcfg 8 tpb
  put qcfg 9 1
  put qcfg 10 gx
  put qcfg 11 1
  put qcfg 12 OMEGA_DS_GPR_COUNT
  if ne bw_qmd1 qcfg q1 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  ret omega_ds_check_qmd q1 0x200000000
end

fn ds_launch_exec cm_va ulong ma_va ulong mb_va ulong mo_va ulong count ulong to long
  tpb = ulong get g_num_launch_tpb 0
  gx = ulong get g_num_launch_grid 0
  L = new ulong 12 0
  put L 0 cm_va
  put L 1 OMEGA_DS_GPR_COUNT
  put L 2 tpb
  put L 3 1
  put L 4 gx
  put L 5 1
  put L 6 count
  put L 7 10
  put L 8 10000
  args = new uint 10 0
  put args 0 uint and ma_va 0xffffffff
  put args 1 uint shr ma_va 32
  put args 2 uint and mb_va 0xffffffff
  put args 3 uint shr mb_va 32
  put args 4 uint and mo_va 0xffffffff
  put args 5 uint shr mo_va 32
  put args 6 uint count
  el = new ulong 1 0
  mk = new uint 1 0
  ret ogps_launch L args el mk
end

fn omega_ds_gb10_run op ulong has_b bool count ulong to long
  rc = omega_ds_check_args op true has_b true count
  if ne rc OMEGA_NUMERIC_OK
    ret rc
  end
  if gt count 4096
    ret OMEGA_NUMERIC_ERR_BAD_ARGS
  end
  code_len = omega_ds_build_kernel op
  if eq code_len 0
    ret OMEGA_NUMERIC_ERR_OPERANDS
  end
  rc = omega_ds_check_kernel op code_len OMEGA_DS_GPR_COUNT
  if ne rc OMEGA_NUMERIC_OK
    ret rc
  end
  rc = omega_ds_check_digest op code_len
  if ne rc OMEGA_NUMERIC_OK
    ret rc
  end
  rc = ds_precheck_qmd count
  if ne rc OMEGA_NUMERIC_OK
    ret rc
  end
  if eq ogps_open 0
    ret OMEGA_NUMERIC_ERR_DEVICE
  end
  cm = new ulong 6 0
  ma = new ulong 6 0
  mb = new ulong 6 0
  mo = new ulong 6 0
  nbytes = mul count 4
  if ne ogps_alloc_code code_len cm OGPS_OK
    ret OMEGA_NUMERIC_ERR_DEVICE
  end
  if ne ogps_alloc nbytes ma OGPS_OK
    ogps_free cm
    ret OMEGA_NUMERIC_ERR_DEVICE
  end
  if ne ogps_alloc nbytes mb OGPS_OK
    ogps_free cm
    ogps_free ma
    ret OMEGA_NUMERIC_ERR_DEVICE
  end
  if ne ogps_alloc nbytes mo OGPS_OK
    ogps_free cm
    ogps_free ma
    ogps_free mb
    ret OMEGA_NUMERIC_ERR_DEVICE
  end
  ok_up = ds_upload_code long get cm 3 code_len
  if ok_up
    ok_up = ds_write_gnum_a long get ma 3 count
  end
  if and ok_up has_b
    ok_up = ds_write_gnum_b long get mb 3 count
  end
  lrc = OGPS_ERR
  if ok_up
    lrc = ds_launch_exec get cm 4 get ma 4 get mb 4 get mo 4 count
  end
  ok_rd = false
  if eq lrc OGPS_OK
    ok_rd = ds_read_gnum_dst long get mo 3 count
  end
  ogps_free cm
  ogps_free ma
  ogps_free mb
  ogps_free mo
  if not ok_rd
    ret OMEGA_NUMERIC_ERR_DEVICE
  end
  ret OMEGA_NUMERIC_OK
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_numeric_divsqrt_gb10.c
note E1 rows 7 & 10: correctly rounded FP32 DIV, SQRT, and transcendentals
note (EXP2, LOG2, SIGMOID, TANH, SIN, COS, ERF, GELU, RSQRT, EXP, LOG) on GB10.
note Composes on om/sha256/sha256-om2.om, om/gpu/bw_vecadd.om, om/gpu/bw_qmd.om,
note src/omega_numeric.om, and src/omega_gpu_session.om.
om2

const OMEGA_DS_DIV ulong 0
const OMEGA_DS_SQRT ulong 1
const OMEGA_DS_EXP2 ulong 2
const OMEGA_DS_LOG2 ulong 3
const OMEGA_DS_SIGMOID ulong 4
const OMEGA_DS_TANH ulong 5
const OMEGA_DS_SIN ulong 6
const OMEGA_DS_COS ulong 7
const OMEGA_DS_ERF ulong 8
const OMEGA_DS_GELU ulong 9
const OMEGA_DS_RSQRT ulong 10
const OMEGA_DS_EXP ulong 11
const OMEGA_DS_LOG ulong 12
const OMEGA_DS_OP_COUNT ulong 13

const DSK_IADD3_R ulong 0
const DSK_IADD3_I ulong 1
const DSK_LOP3_R ulong 2
const DSK_LOP3_I ulong 3
const DSK_SHL_I ulong 4
const DSK_SHL_R ulong 5
const DSK_SHR_I ulong 6
const DSK_SHR_R ulong 7
const DSK_ISETP_R ulong 8
const DSK_ISETP_I ulong 9
const DSK_SEL_R ulong 10
const DSK_SEL_I ulong 11
const DSK_I2FP ulong 12
const DSK_FADD_R ulong 13
const DSK_FMUL_R ulong 14
const DSK_FFMA_R ulong 15
const DSK_COUNT ulong 16

const DS_CMP_LT ulong 1
const DS_CMP_EQ ulong 2
const DS_CMP_LE ulong 3
const DS_CMP_GT ulong 4
const DS_CMP_NE ulong 5
const DS_CMP_GE ulong 6

const OMEGA_DS_RZ ulong 255
const OMEGA_DS_PT ulong 7
const OMEGA_DS_MAX_BODY ulong 1000
const OMEGA_DS_PROLOGUE_INSNS ulong 17
const OMEGA_DS_EPILOGUE_INSNS ulong 3
const OMEGA_DS_MAX_CODE_BYTES ulong 16384
const OMEGA_DS_GPR_COUNT ulong 48
const OMEGA_DS_GPR_RESERVED ulong 2
const OMEGA_DS_RESULT_REG ulong 9
const OMEGA_DS_BODY_CTRL uint 0x010fde00
const OMEGA_DS_MAX_BATCH ulong 16777216

const DS_LUT_AND ulong 0xc0
const DS_LUT_OR ulong 0xfc
const DS_LUT_XOR ulong 0x3c
const DS_LUT_A_AND_B_OR_C ulong 0xe0

note Packed OmegaDsInsn storage: 2 ulongs per insn
note word 0: kind[0..7] | d[8..15] | a[16..23] | b[24..31] | c[32..39] | nega[40] | negb[41] | lut[48..55]
note word 1: imm[0..31] | cmp[32..39] | is_signed[40] | ps[48..55] | pneg[56]
global g_ds_body ulong 2000
global g_ds_body_n ulong 1
global g_ds_body_bad ulong 1

note Shared code buffer (16 KiB) and vecadd template (512 B)
global g_ds_code uchar 16384
global g_ds_va uchar 512

note Host model register/predicate files
global g_ds_reg uint 256
global g_ds_pred ulong 8

note Pre-submission check tables
global g_ds_defr ulong 256
global g_ds_defp ulong 8

note Last error message buffer
global g_ds_err uchar 256
global g_ds_err_len ulong 1

note Recorded nvdisasm-verified SHA-256 hex digests for all 13 ops
text ds_sha_0 "d847b9bd3ac4fe90405f86a2528ff952d47bdb95679d6d029e52ea7aa526675f"
text ds_sha_1 "222c9aa5cf7b2d66d48de3ee4b7ce346627e888ab0786713d8986815bdca10d7"

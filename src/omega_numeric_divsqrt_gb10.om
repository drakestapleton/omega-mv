text ds_nm_0 "DIV"
text ds_nm_1 "SQRT"
text ds_nm_2 "EXP2"
text ds_nm_3 "LOG2"
text ds_nm_4 "SIGMOID"
text ds_nm_5 "TANH"
text ds_nm_6 "SIN"
text ds_nm_7 "COS"
text ds_nm_8 "ERF"
text ds_nm_9 "GELU"
text ds_nm_10 "RSQRT"
text ds_nm_11 "EXP"
text ds_nm_12 "LOG"
text ds_nm_q "?"

fn ds_copy_text src view uchar * dst edit uchar * to ulong
  n = len src
  cap = len dst
  if gt n cap
    n = cap
  end
  for i ulong n bound 256
    put dst i get src i
  end
  ret n
end

fn omega_ds_op_name op ulong dst edit uchar * to ulong
  if eq op 0
    ret ds_copy_text ds_nm_0 dst
  end
  if eq op 1
    ret ds_copy_text ds_nm_1 dst
  end
  if eq op 2
    ret ds_copy_text ds_nm_2 dst
  end
  if eq op 3
    ret ds_copy_text ds_nm_3 dst
  end
  if eq op 4
    ret ds_copy_text ds_nm_4 dst
  end
  if eq op 5
    ret ds_copy_text ds_nm_5 dst
  end
  if eq op 6
    ret ds_copy_text ds_nm_6 dst
  end
  if eq op 7
    ret ds_copy_text ds_nm_7 dst
  end
  if eq op 8
    ret ds_copy_text ds_nm_8 dst
  end
  if eq op 9
    ret ds_copy_text ds_nm_9 dst
  end
  if eq op 10
    ret ds_copy_text ds_nm_10 dst
  end
  if eq op 11
    ret ds_copy_text ds_nm_11 dst
  end
  if eq op 12
    ret ds_copy_text ds_nm_12 dst
  end
  ret ds_copy_text ds_nm_q dst
end

fn omega_ds_op_for_numeric op ulong to ulong
  if eq op OMEGA_NOP_DIV
    ret OMEGA_DS_DIV
  end
  if eq op OMEGA_NOP_SQRT
    ret OMEGA_DS_SQRT
  end
  if eq op OMEGA_NOP_EXP
    ret OMEGA_DS_EXP
  end
  if eq op OMEGA_NOP_LOG
    ret OMEGA_DS_LOG
  end
  ret OMEGA_DS_OP_COUNT
end

fn ds_form_opcode k ulong to uint
  if eq k DSK_IADD3_R
    ret uint 0x210
  end
  if eq k DSK_IADD3_I
    ret uint 0x810
  end
  if eq k DSK_LOP3_R
    ret uint 0x212
  end
  if eq k DSK_LOP3_I
    ret uint 0x812
  end
  if eq k DSK_SHL_I
    ret uint 0x819
  end
  if eq k DSK_SHL_R
    ret uint 0x219
  end
  if eq k DSK_SHR_I
    ret uint 0x819
  end
  if eq k DSK_SHR_R
    ret uint 0x219
  end
  if eq k DSK_ISETP_R
    ret uint 0x20c
  end
  if eq k DSK_ISETP_I
    ret uint 0x80c
  end
  if eq k DSK_SEL_R
    ret uint 0x207
  end
  if eq k DSK_SEL_I
    ret uint 0x807
  end
  if eq k DSK_I2FP
    ret uint 0x245
  end
  if eq k DSK_FADD_R
    ret uint 0x221
  end
  if eq k DSK_FMUL_R
    ret uint 0x220
  end
  ret uint 0x223
end

fn ds_form_w2 k ulong to uint
  if or eq k DSK_IADD3_R eq k DSK_IADD3_I
    ret uint 0x07ffe000
  end
  if or eq k DSK_LOP3_R eq k DSK_LOP3_I
    ret uint 0x078e0000
  end
  if or eq k DSK_SHL_I eq k DSK_SHL_R
    ret uint 0x000006ff
  end
  if or eq k DSK_SHR_I eq k DSK_SHR_R
    ret uint 0x00011600
  end
  if or eq k DSK_ISETP_R eq k DSK_ISETP_I
    ret uint 0x03f00070
  end
  if eq k DSK_I2FP
    ret uint 0x00201400
  end
  if eq k DSK_FMUL_R
    ret uint 0x00400000
  end
  ret uint 0
end

note Encode one packed OmegaDsInsn (p0, p1) into 4 uint32 SM121 words.
fn ds_enc_alu k ulong p0 ulong p1 ulong w edit uint 4 to long
  w0 = or ds_form_opcode k uint 0x7000
  w1 = uint 0
  w2 = ds_form_w2 k
  d = uint and shr p0 8 255
  a = uint and shr p0 16 255
  if eq k DSK_IADD3_R
    w0 = or w0 or shl d 16 shl a 24
    w1 = uint and shr p0 24 255
    if ne and shr p0 41 1 0
      w1 = or w1 uint 0x80000000
    end
    w2 = or w2 uint and shr p0 32 255
    if ne and shr p0 40 1 0
      w2 = or w2 uint 0x100
    end
  end
  if eq k DSK_IADD3_I
    if ne and shr p0 41 1 0
      ret -1
    end
    w0 = or w0 or shl d 16 shl a 24
    w1 = uint and p1 0xffffffff
    w2 = or w2 uint and shr p0 32 255
    if ne and shr p0 40 1 0
      w2 = or w2 uint 0x100
    end
  end
  if eq k DSK_LOP3_R
    w0 = or w0 shl d 16
    w0 = or w0 shl a 24
    w1 = uint and shr p0 24 255
    w2 = or w2 uint and shr p0 32 255
    w2 = or w2 shl uint and shr p0 48 255 8
  end
  if eq k DSK_LOP3_I
    w0 = or w0 shl d 16
    w0 = or w0 shl a 24
    w1 = uint and p1 0xffffffff
    w2 = or w2 uint and shr p0 32 255
    w2 = or w2 shl uint and shr p0 48 255 8
  end
  if eq k DSK_SHL_I
    w0 = or w0 or shl d 16 shl a 24
    w1 = uint and p1 0xffffffff
  end
  if eq k DSK_SHL_R
    w0 = or w0 or shl d 16 shl a 24
    w1 = uint and shr p0 24 255
  end
  if eq k DSK_SHR_I
    w0 = or w0 or shl d 16 shl uint 255 24
    w1 = uint and p1 0xffffffff
    w2 = or w2 uint and shr p0 32 255
  end
  if eq k DSK_SHR_R
    w0 = or w0 or shl d 16 shl uint 255 24
    w1 = uint and shr p0 24 255
    w2 = or w2 uint and shr p0 32 255
  end
  put w 0 w0
  put w 1 w1
  put w 2 w2
  put w 3 OMEGA_DS_BODY_CTRL
  ret 0
end

fn ds_enc_fp_pred k ulong p0 ulong p1 ulong w edit uint 4 to long
  w0 = or ds_form_opcode k uint 0x7000
  w1 = uint 0
  w2 = ds_form_w2 k
  d = uint and shr p0 8 255
  a = uint and shr p0 16 255
  if or eq k DSK_ISETP_R eq k DSK_ISETP_I
    cmp = uint and shr p1 32 255
    if or gt d uint 6 or lt cmp uint 1 gt cmp uint 6
      ret -1
    end
    w0 = or w0 shl a 24
    if eq k DSK_ISETP_R
      w1 = uint and shr p0 24 255
    else
      w1 = uint and p1 0xffffffff
    end
    w2 = or w2 or shl cmp 12 shl d 17
    if ne and shr p1 40 1 0
      w2 = or w2 uint 0x200
    end
  end
  if or eq k DSK_SEL_R eq k DSK_SEL_I
    ps = uint and shr p1 48 255
    if gt ps uint 6
      ret -1
    end
    w0 = or w0 or shl d 16 shl a 24
    if eq k DSK_SEL_R
      w1 = uint and shr p0 24 255
    else
      w1 = uint and p1 0xffffffff
    end
    w2 = or w2 shl ps 23
    if ne and shr p1 56 1 0
      w2 = or w2 uint 0x04000000
    end
  end
  if eq k DSK_I2FP
    w0 = or w0 shl d 16
    w1 = uint and shr p0 24 255
  end
  if eq k DSK_FADD_R
    w0 = or w0 or shl d 16 shl a 24
    w1 = uint and shr p0 24 255
    if ne and shr p0 41 1 0
      w1 = or w1 uint 0x80000000
    end
  end
  if eq k DSK_FMUL_R
    if ne and shr p0 41 1 0
      ret -1
    end
    w0 = or w0 or shl d 16 shl a 24
    w1 = uint and shr p0 24 255
  end
  if eq k DSK_FFMA_R
    if ne and shr p0 41 1 0
      ret -1
    end
    w0 = or w0 or shl d 16 shl a 24
    w1 = uint and shr p0 24 255
    w2 = or w2 uint and shr p0 32 255
  end
  put w 0 w0
  put w 1 w1
  put w 2 w2
  put w 3 OMEGA_DS_BODY_CTRL
  ret 0
end

fn omega_ds_encode p0 ulong p1 ulong w edit uint 4 to long
  k = and p0 255
  if ge k DSK_COUNT
    ret -1
  end
  if lt k DSK_ISETP_R
    ret ds_enc_alu k p0 p1 w
  end
  ret ds_enc_fp_pred k p0 p1 w
end

fn ds_find_kind w0 uint w2 uint to long
  opc = and w0 uint 0xfff
  for k ulong DSK_COUNT
    if eq ds_form_opcode k opc
      if eq and opc uint 0xff uint 0x19
        if eq and w2 uint 0xffffff00 and ds_form_w2 k uint 0xffffff00
          ret long k
        end
      else
        ret long k
      end
    end
  end
  ret -1
end

note Decode 4 uint32 SM121 words into packed OmegaDsInsn (dst[0]=p0, dst[1]=p1).
fn omega_ds_decode w view uint 4 dst edit ulong 2 to long
  w0 = get w 0
  w1 = get w 1
  w2 = get w 2
  kl = ds_find_kind w0 w2
  if lt kl 0
    ret -1
  end
  k = ulong kl
  p0 = or k shl ulong and shr w0 16 255 8
  p0 = or p0 shl ulong and shr w0 24 255 16
  p1 = ulong 0

  if eq k DSK_IADD3_R
    p0 = or p0 shl ulong and w1 255 24
    p0 = or p0 shl ulong and w2 255 32
    p0 = or p0 shl ulong and shr w2 8 1 40
    p0 = or p0 shl ulong and shr w1 31 1 41
  end
  if eq k DSK_IADD3_I
    p0 = or p0 shl ulong and w2 255 32
    p0 = or p0 shl ulong and shr w2 8 1 40
    p1 = ulong w1
  end
  if eq k DSK_LOP3_R
    p0 = or p0 shl ulong and w1 255 24
    p0 = or p0 shl ulong and w2 255 32
    p0 = or p0 shl ulong and shr w2 8 255 48
  end
  if eq k DSK_LOP3_I
    p0 = or p0 shl ulong and w2 255 32
    p0 = or p0 shl ulong and shr w2 8 255 48
    p1 = ulong w1
  end
  if eq k DSK_SHL_I
    p1 = ulong w1
  end
  if eq k DSK_SHL_R
    p0 = or p0 shl ulong and w1 255 24
  end
  if eq k DSK_SHR_I
    p0 = and p0 ulong 0xffff
    p0 = or p0 shl ulong and w2 255 32
    p1 = ulong w1
  end
  if eq k DSK_SHR_R
    p0 = and p0 ulong 0xffff
    p0 = or p0 shl ulong and w1 255 24
    p0 = or p0 shl ulong and w2 255 32
  end
  if or eq k DSK_ISETP_R eq k DSK_ISETP_I
    p0 = and p0 ulong 0xff00ff
    p0 = or p0 shl ulong and shr w2 17 7 8
    if eq k DSK_ISETP_R
      p0 = or p0 shl ulong and w1 255 24
    else
      p1 = ulong w1
    end
    p1 = or p1 shl ulong and shr w2 12 7 32
    p1 = or p1 shl ulong and shr w2 9 1 40
  end
  if or eq k DSK_SEL_R eq k DSK_SEL_I
    if eq k DSK_SEL_R
      p0 = or p0 shl ulong and w1 255 24
    else
      p1 = ulong w1
    end
    p1 = or p1 shl ulong and shr w2 23 7 48
    p1 = or p1 shl ulong and shr w2 26 1 56
  end
  if eq k DSK_I2FP
    p0 = and p0 ulong 0xffff
    p0 = or p0 shl ulong and w1 255 24
  end
  if eq k DSK_FADD_R
    p0 = or p0 shl ulong and w1 255 24
    p0 = or p0 shl ulong and shr w1 31 1 41
  end
  if eq k DSK_FMUL_R
    p0 = or p0 shl ulong and w1 255 24
  end
  if eq k DSK_FFMA_R
    p0 = or p0 shl ulong and w1 255 24
    p0 = or p0 shl ulong and w2 255 32
  end

  re = new uint 4 0
  if ne omega_ds_encode p0 p1 re 0
    ret -1
  end
  if ne get re 0 w0
    ret -1
  end
  if ne get re 1 w1
    ret -1
  end
  if ne get re 2 w2
    ret -1
  end
  put dst 0 p0
  put dst 1 p1
  ret 0
end

note ---- Body builder helpers ----

fn ds_emit p0 ulong p1 ulong to void
  n = get g_ds_body_n 0
  if ge n OMEGA_DS_MAX_BODY
    put g_ds_body_bad 0 1
    ret
  end
  put g_ds_body mul n 2 p0
  put g_ds_body add mul n 2 1 p1
  put g_ds_body_n 0 add n 1
end

fn ds_iadd d ulong a ulong b ulong c ulong to void
  p0 = or DSK_IADD3_R or shl d 8 or shl a 16 or shl b 24 shl c 32
  ds_emit p0 0
end

fn ds_isub d ulong a ulong b ulong to void
  p0 = or DSK_IADD3_R or shl d 8 or shl a 16 or shl b 24 or shl OMEGA_DS_RZ 32 shl ulong 1 41
  ds_emit p0 0
end

fn ds_iaddi d ulong a ulong imm uint c ulong to void
  p0 = or DSK_IADD3_I or shl d 8 or shl a 16 shl c 32
  ds_emit p0 ulong imm
end

fn ds_rsubi d ulong a ulong imm uint to void
  p0 = or DSK_IADD3_I or shl d 8 or shl a 16 or shl OMEGA_DS_RZ 32 shl ulong 1 40
  ds_emit p0 ulong imm
end

fn ds_lop d ulong a ulong b ulong c ulong lut ulong to void
  p0 = or DSK_LOP3_R or shl d 8 or shl a 16 or shl b 24 or shl c 32 shl lut 48
  ds_emit p0 0
end

fn ds_lopi d ulong a ulong imm uint lut ulong to void
  p0 = or DSK_LOP3_I or shl d 8 or shl a 16 or shl OMEGA_DS_RZ 32 shl lut 48
  ds_emit p0 ulong imm
end

fn ds_shli d ulong a ulong s uint to void
  p0 = or DSK_SHL_I or shl d 8 or shl a 16 shl OMEGA_DS_RZ 32
  ds_emit p0 ulong s
end

fn ds_shlr d ulong a ulong s ulong to void
  p0 = or DSK_SHL_R or shl d 8 or shl a 16 or shl s 24 shl OMEGA_DS_RZ 32
  ds_emit p0 0
end

fn ds_shri d ulong c ulong s uint to void
  p0 = or DSK_SHR_I or shl d 8 shl c 32
  ds_emit p0 ulong s
end

fn ds_shrr d ulong c ulong s ulong to void
  p0 = or DSK_SHR_R or shl d 8 or shl s 24 shl c 32
  ds_emit p0 0
end

fn ds_setp p ulong cmp ulong sgn ulong a ulong b ulong to void
  p0 = or DSK_ISETP_R or shl p 8 or shl a 16 shl b 24
  p1 = or shl cmp 32 shl sgn 40
  ds_emit p0 p1
end

fn ds_setpi p ulong cmp ulong sgn ulong a ulong imm uint to void
  p0 = or DSK_ISETP_I or shl p 8 shl a 16
  p1 = or ulong imm or shl cmp 32 shl sgn 40
  ds_emit p0 p1
end

fn ds_sel d ulong a ulong b ulong p ulong pneg ulong to void
  p0 = or DSK_SEL_R or shl d 8 or shl a 16 shl b 24
  p1 = or shl p 48 shl pneg 56
  ds_emit p0 p1
end

fn ds_seli d ulong a ulong imm uint p ulong pneg ulong to void
  p0 = or DSK_SEL_I or shl d 8 shl a 16
  p1 = or ulong imm or shl p 48 shl pneg 56
  ds_emit p0 p1
end

fn ds_i2fp d ulong s ulong to void
  p0 = or DSK_I2FP or shl d 8 shl s 24
  ds_emit p0 0
end

fn ds_ffadd d ulong a ulong b ulong to void
  p0 = or DSK_FADD_R or shl d 8 or shl a 16 shl b 24
  ds_emit p0 0
end

fn ds_ffsub d ulong a ulong b ulong to void
  p0 = or DSK_FADD_R or shl d 8 or shl a 16 or shl b 24 shl ulong 1 41
  ds_emit p0 0
end

fn ds_ffmul d ulong a ulong b ulong to void
  p0 = or DSK_FMUL_R or shl d 8 or shl a 16 shl b 24
  ds_emit p0 0
end

fn ds_fffma d ulong a ulong b ulong c ulong to void
  p0 = or DSK_FFMA_R or shl d 8 or shl a 16 or shl b 24 shl c 32
  ds_emit p0 0
end

fn ds_movi d ulong imm uint to void
  ds_iaddi d OMEGA_DS_RZ imm OMEGA_DS_RZ
end

fn ds_mov d ulong s ulong to void
  ds_iadd d s OMEGA_DS_RZ OMEGA_DS_RZ
end

fn ds_horner p ulong f ulong cbits uint tmp ulong to void
  ds_movi tmp cbits
  ds_fffma p p f tmp
end

note ---- Shared cores (unpack, round_pack, div_core, scale2_core, two_sum_b) ----

fn ds_unpack ax ulong m ulong e ulong to void
  ds_shri 16 ax 23
  ds_lopi m ax uint 0x007fffff DS_LUT_AND
  ds_lopi m m uint 0x00800000 DS_LUT_OR
  ds_iaddi e 16 uint 0xffffff6a OMEGA_DS_RZ
  ds_i2fp 17 ax
  ds_shri 17 17 23
  ds_rsubi 18 17 150
  ds_shlr 18 ax 18
  ds_iaddi 17 17 uint 0xfffffed5 OMEGA_DS_RZ
  ds_setp 0 DS_CMP_EQ 0 16 OMEGA_DS_RZ
  ds_sel m 18 m 0 0
  ds_sel e 17 e 0 0
end

fn ds_round_pack sign ulong sig ulong exp2 ulong sticky ulong to void

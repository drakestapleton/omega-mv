note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_blackwell_realize.c.
note Composes on seed/ng/sha256.om and src/omega_blackwell_encoder.om.
om2

const OMEGA_BW_SM_ARCH_121 uint 121

text bw_machine_profile_str "NVIDIA_DGX_SPARK_GB10_SM121"

fn omega_blackwell_get_machine_id dst edit uchar 32 to long
  n = len bw_machine_profile_str
  for i ulong n bound 64
    put sh_dat i get bw_machine_profile_str i
  end
  sh_all n
  for i ulong 32
    put dst i get sh_dig i
  end
  ret 0
end

fn omega_blackwell_realization_compute_id spec_id view uchar 32 machine_id view uchar 32 code_digest view uchar 32 sm_arch uint dst edit uchar 32 to long
  for i ulong 32
    put sh_dat i get spec_id i
    put sh_dat add 32 i get machine_id i
    put sh_dat add 64 i get code_digest i
  end
  put sh_dat 96 uchar and sm_arch 255
  put sh_dat 97 uchar and shr sm_arch 8 255
  put sh_dat 98 uchar and shr sm_arch 16 255
  put sh_dat 99 uchar and shr sm_arch 24 255
  sh_all 100
  for i ulong 32
    put dst i get sh_dig i
  end
  ret 0
end

fn omega_blackwell_realize_vector spec_id view uchar 32 element_count uint real_id edit uchar 32 machine_id edit uchar 32 code_digest edit uchar 32 geom edit uint 4 to long
  rc = omega_blackwell_get_machine_id machine_id
  if ne rc 0
    ret -1
  end
  code = new uchar 512 0
  written = omega_blackwell_encode_vecadd code
  if ne written 512
    ret -1
  end
  rc = omega_blackwell_compute_code_digest code 512 code_digest
  if ne rc 0
    ret -1
  end
  gw = div add ulong element_count 63 64
  if eq gw 0
    gw = 1
  end
  put geom 0 OMEGA_BW_SM_ARCH_121
  put geom 1 element_count
  put geom 2 64
  put geom 3 uint gw
  ret omega_blackwell_realization_compute_id spec_id machine_id code_digest OMEGA_BW_SM_ARCH_121 real_id
end

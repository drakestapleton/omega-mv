note ---- log(x), bit for bit with glibc 2.39 AArch64 libm (sysdeps/ieee754/dbl-64/e_log.c) ----
note The table g_glog_t is __log_data as stored in libm.so.6: [0] ln2hi, [1] ln2lo,
note [2..6] poly A[0..4], [7..17] poly1 B[0..10], [18 + 2i] tab[i].invc, [19 + 2i] tab[i].logc.
note Each fused step follows the FMADD/FMSUB that GCC emitted for that build.

fn est_glog_t i ulong to f64
  if eq get g_glog_ready 0 0
    est_glog_init
    put g_glog_ready 0 1
  end
  ret bitcast f64 get g_glog_t i
end

fn est_glog_n1_mid r f64 r2 f64 r3 f64 to f64
  p78 = fma est_glog_t 15 r est_glog_t 14
  p79 = fma est_glog_t 16 r2 p78
  pin = fma est_glog_t 17 r3 p79
  p45 = fma est_glog_t 12 r est_glog_t 11
  p46 = fma est_glog_t 13 r2 p45
  ret fma pin r3 p46
end

fn est_glog_n1_poly r f64 r2 f64 r3 f64 to f64
  pmid = est_glog_n1_mid r r2 r3
  p12 = fma est_glog_t 9 r est_glog_t 8
  p13 = fma est_glog_t 10 r2 p12
  ret fma pmid r3 p13
end

fn est_glog_near1 x f64 to f64
  r = sub x f64 1.0
  two27 = bitcast f64 ulong 4728779608739020800
  b0 = est_glog_t 7
  rw = fma r two27 r
  rhi = fma neg r two27 rw
  r2 = mul r r
  r3 = mul r r2
  pout = est_glog_n1_poly r r2 r3
  rh2 = mul rhi rhi
  hi = fma rh2 b0 r
  brlo = mul b0 sub r rhi
  rpr = add r rhi
  lo1 = fma rh2 b0 sub r hi
  lo2 = fma brlo rpr lo1
  y = fma pout r3 lo2
  ret add hi y
end

fn est_glog_tail r f64 kd f64 w f64 to f64
  hi = add r w
  lo = fma est_glog_t 1 kd add sub w hi r
  r2 = mul r r
  a34 = fma est_glog_t 6 r est_glog_t 5
  a12 = fma est_glog_t 4 r est_glog_t 3
  pa = fma a34 r2 a12
  y0 = fma est_glog_t 2 r2 lo
  y1 = fma mul r r2 pa y0
  ret add y1 hi
end

fn est_glog_main ix0 ulong to f64
  tmp = sub ix0 ulong 4604367669032910848
  i = and shr tmp 45 127
  kd = f64 shr bitcast long tmp 52
  z = bitcast f64 sub ix0 and tmp ulong 18442240474082181120
  w = fma est_glog_t 0 kd est_glog_t add 19 mul i 2
  r = fma est_glog_t add 18 mul i 2 z f64 -1.0
  ret est_glog_tail r kd w
end

fn est_log x f64 to f64
  ix = bitcast ulong x
  if lt sub ix ulong 4606619468846596096 ulong 854320534781952
    if eq ix ulong 4607182418800017408
      ret f64 0.0
    end
    ret est_glog_near1 x
  end
  top = shr ix 48
  if ge sub top 16 ulong 32736
    if eq shl ix 1 0
      ret est_ninf
    end
    if eq ix ulong 9218868437227405312
      ret x
    end
    if or ne and top 32768 0 eq and top 32752 32752
      ret div sub x x sub x x
    end
    ix = sub bitcast ulong mul x bitcast f64 ulong 4841369599423283200 ulong 234187180623265792
  end
  ret est_glog_main ix
end


fn est_pow a f64 b f64 to f64
  if eq b 0.0f64
    ret 1.0f64
  end
  if eq a 1.0f64
    ret 1.0f64
  end
  if eq a 0.0f64
    if gt b 0.0f64
      ret 0.0f64
    end
    ret est_inf
  end
  if lt a 0.0f64
    bi = est_nearbyint b
    if eq bi b
      res = est_exp mul b est_log neg a
      if ne and long bi 1 0
        ret neg res
      end
      ret res
    end
    ret est_nan
  end
  ret est_exp mul b est_log a
end

fn est_powu a f64 n ulong to f64
  res = f64 1.0f64
  base = a
  r = n
  while gt r 0 bound 64
    if ne and r 1 0
      res = mul res base
    end
    r = shr r 1
    if gt r 0
      base = mul base base
    end
  end
  ret res
end

fn est_lgamma_lanczos z f64 to f64
  s = f64 0.99999999999980993f64
  s = add s div 676.5203681218851f64 add z 1.0f64
  s = add s div -1259.1392167224028f64 add z 2.0f64
  s = add s div 771.32342877765313f64 add z 3.0f64
  s = add s div -176.61502916214059f64 add z 4.0f64
  s = add s div 12.507343278686905f64 add z 5.0f64
  s = add s div -0.13857109526572012f64 add z 6.0f64
  s = add s div 9.9843695780195716e-6f64 add z 7.0f64
  s = add s div 1.5056327351493116e-7f64 add z 8.0f64
  t = add z 7.5f64
  ret add sub add EST_HALF_LOG_2PI mul add z 0.5f64 est_log t t est_log s
end

fn est_lgamma x f64 to f64
  if not est_isfinite x
    ret est_nan
  end
  if le x 0.0f64
    ret est_nan
  end
  if lt x 1.0f64
    ret sub est_lgamma_lanczos x est_log x
  end
  ret est_lgamma_lanczos sub x 1.0f64
end

fn est_erf_series x f64 to f64
  x2 = mul x x
  term = x
  s = term
  k = ulong 1
  while lt k 120 bound 120
    term = div mul term mul 2.0f64 x2 f64 add mul 2 k 1
    s = add s term
    if le fabs term mul 1.0e-17f64 fabs s
      break
    end
    k = add k 1
  end
  ret mul mul EST_TWO_INV_SQRT_PI est_exp neg x2 s
end

fn est_erfc_cf x f64 to f64
  fpmin = f64 1.0e-300f64
  b = x
  c = div 1.0f64 fpmin
  d = div 1.0f64 b
  h = d
  m = ulong 1
  while le m 200 bound 200
    an = mul 0.5f64 f64 m
    d = add x mul an d
    if lt fabs d fpmin
      d = fpmin
    end
    c = add x div an c
    if lt fabs c fpmin
      c = fpmin
    end
    d = div 1.0f64 d
    del = mul d c
    h = mul h del
    if le fabs sub del 1.0f64 1.0e-15f64
      break
    end
    m = add m 1
  end
  ret mul mul EST_INV_SQRT_PI est_exp neg mul x x h
end

fn est_erfc x f64 to f64
  if est_isnan x
    ret x
  end
  if lt x 0.0f64
    ret sub 2.0f64 est_erfc neg x
  end
  if eq x 0.0f64
    ret 1.0f64
  end
  if gt x 27.3f64
    ret 0.0f64
  end
  if lt x 2.0f64
    ret sub 1.0f64 est_erf_series x
  end
  ret est_erfc_cf x
end

fn est_erf x f64 to f64
  if est_isnan x
    ret x
  end
  ax = fabs x
  r = f64 0.0f64
  if gt ax 6.5f64
    r = 1.0f64
  else
    if lt ax 2.0f64
      r = est_erf_series ax
    else
      r = sub 1.0f64 est_erfc_cf ax
    end
  end
  if lt x 0.0f64
    ret neg r
  end
  ret r
end

fn est_sin_poly r f64 to f64
  r2 = mul r r
  p = f64 -2.5052108385441719e-8
  p = add mul p r2 2.7557319223985891e-6
  p = add mul p r2 -1.9841269841269841e-4
  p = add mul p r2 8.3333333333333333e-3
  p = add mul p r2 -1.6666666666666667e-1
  p = add mul p r2 1.0
  ret mul r p
end

fn est_cos_poly r f64 to f64
  r2 = mul r r
  p = f64 2.0876756987868099e-9
  p = add mul p r2 -2.7557319223985891e-7
  p = add mul p r2 2.4801587301587302e-5
  p = add mul p r2 -1.3888888888888889e-3
  p = add mul p r2 4.1666666666666667e-2
  p = add mul p r2 -0.5
  p = add mul p r2 1.0
  ret p
end

fn est_sin x f64 to f64
  if not est_isfinite x
    ret est_nan
  end
  kf = est_nearbyint div x EST_HALF_PI
  r = sub x mul kf EST_HALF_PI
  q = and long kf 3
  if eq q 0
    ret est_sin_poly r
  end
  if eq q 1
    ret est_cos_poly r
  end
  if eq q 2
    ret neg est_sin_poly r
  end
  ret neg est_cos_poly r
end

fn est_cos x f64 to f64
  if not est_isfinite x
    ret est_nan
  end
  kf = est_nearbyint div x EST_HALF_PI
  r = sub x mul kf EST_HALF_PI
  q = and long kf 3
  if eq q 0
    ret est_cos_poly r
  end
  if eq q 1
    ret neg est_sin_poly r
  end
  if eq q 2
    ret neg est_cos_poly r
  end
  ret est_sin_poly r
end

fn est_atan_small t f64 to f64
  t2 = mul t t
  term = t
  s = t
  k = ulong 1
  while lt k 30 bound 30
    term = mul neg term t2
    addv = div term f64 add mul 2 k 1
    s = add s addv
    if le fabs addv mul 1.0e-17f64 fabs s
      break
    end
    k = add k 1
  end
  ret s
end

fn est_atan x f64 to f64
  if est_isnan x
    ret x
  end
  if lt x 0.0f64
    ret neg est_atan neg x
  end
  if gt x 1.0f64
    ret sub EST_HALF_PI est_atan div 1.0f64 x
  end
  if gt x 0.2679491924311227
    sq3 = f64 1.7320508075688773
    t = div sub mul sq3 x 1.0 add sq3 x
    ret add div EST_PI 6.0f64 est_atan_small t
  end
  ret est_atan_small x
end

fn est_asin x f64 to f64
  if or lt x -1.0f64 gt x 1.0f64
    ret est_nan
  end
  if eq x 1.0f64
    ret EST_HALF_PI
  end
  if eq x -1.0f64
    ret neg EST_HALF_PI
  end
  ret est_atan div x fsqrt sub 1.0f64 mul x x
end

note ---- Pure OM-2 SHA-256 (FIPS 180-4) ----

fn est_sha_kinit k edit uint 64 to void
  put k 0 0x428a2f98
  put k 1 0x71374491
  put k 2 0xb5c0fbcf
  put k 3 0xe9b5dba5
  put k 4 0x3956c25b
  put k 5 0x59f111f1
  put k 6 0x923f82a4
  put k 7 0xab1c5ed5
  put k 8 0xd807aa98
  put k 9 0x12835b01
  put k 10 0x243185be
  put k 11 0x550c7dc3
  put k 12 0x72be5d74
  put k 13 0x80deb1fe
  put k 14 0x9bdc06a7
  put k 15 0xc19bf174
  put k 16 0xe49b69c1
  put k 17 0xefbe4786
  put k 18 0x0fc19dc6
  put k 19 0x240ca1cc
  put k 20 0x2de92c6f
  put k 21 0x4a7484aa
  put k 22 0x5cb0a9dc
  put k 23 0x76f988da
  put k 24 0x983e5152
  put k 25 0xa831c66d
  put k 26 0xb00327c8
  put k 27 0xbf597fc7
  put k 28 0xc6e00bf3
  put k 29 0xd5a79147
  put k 30 0x06ca6351
  put k 31 0x14292967
  put k 32 0x27b70a85
  put k 33 0x2e1b2138
  put k 34 0x4d2c6dfc
  put k 35 0x53380d13
  put k 36 0x650a7354
  put k 37 0x766a0abb
  put k 38 0x81c2c92e
  put k 39 0x92722c85
  put k 40 0xa2bfe8a1
  put k 41 0xa81a664b
  put k 42 0xc24b8b70
  put k 43 0xc76c51a3
  put k 44 0xd192e819
  put k 45 0xd6990624
  put k 46 0xf40e3585
  put k 47 0x106aa070
  put k 48 0x19a4c116
  put k 49 0x1e376c08
  put k 50 0x2748774c
  put k 51 0x34b0bcb5
  put k 52 0x391c0cb3
  put k 53 0x4ed8aa4a
  put k 54 0x5b9cca4f
  put k 55 0x682e6ff3
  put k 56 0x748f82ee
  put k 57 0x78a5636f
  put k 58 0x84c87814
  put k 59 0x8cc70208
  put k 60 0x90befffa
  put k 61 0xa4506ceb
  put k 62 0xbef9a3f7
  put k 63 0xc67178f2
end

fn est_sha_iv s edit uint 8 to void
  put s 0 0x6a09e667
  put s 1 0xbb67ae85
  put s 2 0x3c6ef372
  put s 3 0xa54ff53a
  put s 4 0x510e527f
  put s 5 0x9b05688c
  put s 6 0x1f83d9ab
  put s 7 0x5be0cd19
end

fn est_sha_sched w edit uint 64 fresh m view uchar * o ulong to void
  q = ulong 0
  x = uint 0
  y = uint 0
  for i ulong 16 unroll
    q = add o mul i 4
    x = uint get m q
    x = or shl x 8 uint get m add q 1
    x = or shl x 8 uint get m add q 2
    put w i or shl x 8 uint get m add q 3
  end
  for i ulong 48 unroll
    x = get w add i 1
    y = get w add i 14
    x = add add get w i get w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
    put w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
  end
end

fn est_sha_rounds s edit uint 8 w view uint 64 kt view uint 64 to void
  a = get s 0
  b = get s 1
  c = get s 2
  d = get s 3
  e = get s 4
  f = get s 5
  g = get s 6
  h = get s 7
  t = uint 0
  for i ulong 64 unroll
    h = add h get kt i
    h = add h get w i
    t = xor rotr e 6 rotr e 11
    t = xor t rotr e 25
    h = add h t
    h = add h xor g and e xor f g
    d = add d h
    t = xor rotr a 2 rotr a 13
    t = xor t rotr a 22
    h = add h t
    t = and c or a b
    h = add h or and a b t
    t = h
    h = g
    g = f
    f = e
    e = d
    d = c
    c = b
    b = a
    a = t
  end
  put s 0 add get s 0 a
  put s 1 add get s 1 b
  put s 2 add get s 2 c
  put s 3 add get s 3 d
  put s 4 add get s 4 e
  put s 5 add get s 5 f
  put s 6 add get s 6 g
  put s 7 add get s 7 h
end

fn est_sha_compress s edit uint 8 w edit uint 64 kt view uint 64 m view uchar * o ulong to void
  est_sha_sched w m o
  est_sha_rounds s w kt
end

fn est_sha_finish s edit uint 8 w edit uint 64 kt view uint 64 p edit uchar 128 k ulong n ulong to void
  put p k 0x80
  e = ulong 64
  if ge k 56
    e = 128
  end
  bits = shl n 3
  for i ulong 8 unroll
    put p sub e add i 1 uchar and shr bits mul i 8 0xff
  end
  est_sha_compress s w kt view p 0
  if eq e 128
    est_sha_compress s w kt view p 64
  end
end

fn est_sha256_hash d view uchar * n ulong dst edit uchar 32 to void
  s = new uint 8 0
  w = new uint 64 0
  kt = new uint 64 0
  p = new uchar 128 0
  est_sha_kinit kt
  est_sha_iv s
  nb = shr n 6
  for j ulong nb
    est_sha_compress s w kt d shl j 6
  end
  off = shl nb 6
  k = sub n off
  for i ulong k
    put p i get d add off i
  end
  est_sha_finish s w kt p k n
  for i ulong 8 unroll
    v = ulong get s i
    for j ulong 4 unroll
      put dst add mul i 4 j uchar and shr v sub 24 mul j 8 0xff
    end
  end
end

fn est_sha256_domain dom view uchar * enc view uchar * enclen ulong dst edit uchar 32 to void
  dlen = len dom
  buf = new uchar 2400 0
  for i ulong dlen
    put buf i get dom i
  end
  put buf dlen uchar 0
  base = add dlen 1
  for i ulong enclen
    put buf add base i get enc i
  end
  est_sha256_hash view buf add base enclen dst
end

note ---- Minimal stdout/stderr printing helpers for test suites ----

fn est_write_all fd int s view uchar * n ulong to void
  off = ulong 0
  while lt off n bound 65536
    k = write fd s off sub n off
    if le k 0
      ret
    end
    off = add off ulong k
  end
end

fn est_puts s view uchar * to void
  est_write_all 1 s len s
end

fn est_eputs s view uchar * to void
  est_write_all 2 s len s
end

fn est_putu_fd fd int v ulong to void
  buf = new uchar 32 0
  if eq v 0
    put buf 0 uchar 48
    est_write_all fd view buf 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0 bound 32
    put buf n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  rev = new uchar 32 0
  for i ulong n
    put rev i get buf sub sub n 1 i
  end
  est_write_all fd view rev n
end

fn est_putu v ulong to void
  est_putu_fd 1 v
end

fn est_puti_fd fd int v long to void
  m = new uchar 1 45
  if lt v 0
    est_write_all fd view m 1
    est_putu_fd fd ulong neg v
    ret
  end
  est_putu_fd fd ulong v
end

note ---- lgamma(x): bit for bit with glibc 2.39 AArch64 libm for x > 0, +-0, +-inf and nan ----
note (sysdeps/ieee754/dbl-64/e_lgamma_r.c; fused steps as GCC 13 emitted them, checked on 2M
note samples against libm.so.6). Finite x < 0 is not implemented (glibc's lgamma_neg and sin_pi)
note and returns nan; no estimation caller passes a negative argument.

note [0.9, 2) and [0, 0.9) polynomial cases of e_lgamma_r.c: i = 0 (a-series), y, plus r
fn est_lg_case0 y f64 r f64 to f64
  z = mul y y
  p1 = fma z 2.5214456545125733e-05f64 0.00022086279071390839f64
  p1 = fma p1 z 0.0011927076318336207f64
  p1 = fma p1 z 0.007385550860814029f64
  p1 = fma p1 z 0.06735230105312927f64
  p1 = fma p1 z 0.07721566490153287f64
  p2 = fma z 4.4864094961891516e-05f64 0.00010801156724758394f64
  p2 = fma p2 z 0.0005100697921535113f64
  p2 = fma p2 z 0.0028905138367341563f64
  p2 = fma p2 z 0.020580808432516733f64
  p2 = fma p2 z 0.3224670334241136f64
  p = fma p2 z mul p1 y
  ret add fma neg y 0.5f64 p r
end

note i = 1 (t-series); p = z*p1 - t is one fused step (.FMS)
fn est_lg_case1_fms y f64 r f64 to f64
  z = mul y y
  w = mul z y
  p1 = fma w 0.00031563207090362595f64 -0.0014034646998923284f64
  p1 = fma p1 w 0.006100538702462913f64
  p1 = fma p1 w -0.032788541075985965f64
  p1 = fma p1 w 0.48383612272381005f64
  p2 = fma w -0.00031275416837512086f64 0.000881081882437654f64
  p2 = fma p2 w -0.0036845201678113826f64
  p2 = fma p2 w 0.01797067508118204f64
  p2 = fma p2 w -0.1475877229945939f64
  p3 = fma w 0.0003355291926355191f64 -0.0005385953053567405f64
  p3 = fma p3 w 0.0022596478090061247f64
  p3 = fma p3 w -0.010314224129834144f64
  p3 = fma p3 w 0.06462494023913339f64
  t = fma neg fma p3 y p2 w -3.638676997039505e-18f64
  p = fma z p1 neg t
  ret add sub p 0.12148629053584961f64 r
end

fn est_lg_case2 y f64 r f64 to f64
  p1 = fma y 0.013381091853678766f64 0.22896372806469245f64
  p1 = fma p1 y 0.9777175279633727f64
  p1 = fma p1 y 1.4549225013723477f64
  p1 = fma p1 y 0.6328270640250934f64
  p1 = mul fma p1 y -0.07721566490153287f64 y
  p2 = fma y 0.003217092422824239f64 0.10422264559336913f64
  p2 = fma p2 y 0.7692851504566728f64
  p2 = fma p2 y 2.128489763798934f64
  p2 = fma p2 y 2.4559779371304113f64
  p2 = fma p2 y 1.0f64
  ret add fma y -0.5f64 div p1 p2 r
end

note x < 2 (x > 0, x not 1)
fn est_lg_below2 x f64 ix ulong to f64
  if le ix 1072483532
    r = neg est_log x
    if ge ix 1072130372
      ret est_lg_case0 sub 1.0f64 x r
    end
    if ge ix 1070442081
      ret est_lg_case1_fms sub x 0.46163214496836225f64 r
    end
    ret est_lg_case2 x r
  end
  if ge ix 1073460419
    ret est_lg_case0 sub 2.0f64 x 0.0f64
  end
  if ge ix 1072936132
    ret est_lg_case1_fms sub x 1.4616321449683622f64 0.0f64
  end
  ret est_lg_case2 sub x 1.0f64 0.0f64
end

note [2, 8)
fn est_lg_below8 x f64 to f64
  i = long x

fn est_lgamma x f64 to f64
  bits = bitcast ulong x
  hi = shr bits 32
  lo = and bits 4294967295
  ix = and hi 2147483647
  if ge ix 2146435072
    ret mul x x
  end
  if eq or ix lo 0
    ret div 1.0f64 fabs x
  end
  if ne shr hi 31 0
    ret est_nan
  end
  if lt ix 999292928
    ret neg est_log x
  end
  if eq lo 0
    if or eq ix 1072693248 eq ix 1073741824
      ret 0.0f64
    end
  end
  if lt ix 1073741824
    ret est_lg_below2 x ix
  end
  if lt ix 1075838976
    ret est_lg_below8 x
  end
  if lt ix 1133510656
    ret est_lg_large x
  end
  ret mul sub est_log x 1.0f64 x
end


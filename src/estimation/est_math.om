  p = fma y 3.194753265841009e-05f64 0.0018402845140733772f64
  p = fma p y 0.02664227030336386f64
  p = fma p y 0.14635047265246445f64
  p = fma p y 0.325778796408931f64
  p = fma p y 0.21498241596060885f64
  p = mul fma p y -0.07721566490153287f64 y
  q = fma y 7.326684307446256e-06f64 0.0007779424963818936f64
  q = fma q y 0.01864591917156529f64
  q = fma q y 0.17193386563280308f64
  q = fma q y 0.7219355475671381f64
  q = fma q y 1.3920053346762105f64
  q = fma q y 1.0f64
  r = fma y 0.5f64 div p q
  if lt i 3
    ret r
  end
  z = f64 1.0f64
  if ge i 7
    z = mul z add y 6.0f64
  end
  if ge i 6
    z = mul z add y 5.0f64
  end
  if ge i 5
    z = mul z add y 4.0f64
  end
  if ge i 4
    z = mul z add y 3.0f64
  end
  z = mul z add y 2.0f64
  ret add r est_log z
end


note ---- pow(x, y): bit for bit with glibc 2.39 AArch64 libm (sysdeps/ieee754/dbl-64/e_pow.c) ----
note g_gpow_t is __pow_log_data: [0] ln2hi, [1] ln2lo, [2..8] poly[0..6], [9 + 3i] tab[i].invc,
note [10 + 3i] tab[i].logc, [11 + 3i] tab[i].logctail; the exp step uses __exp_data (g_gexp_t).
note Fused steps are the __builtin_fma calls of e_pow.c (__FP_FAST_FMA) and the contractions GCC 13
note made in that file; the same source compiled that way matches libm.so.6 on 4M sample pairs.

fn est_gpow_c i ulong to f64
  if eq get g_gpow_ready 0 0
    est_gpow_init
    put g_gpow_ready 0 1
  end
  ret bitcast f64 get g_gpow_t i
end

note 0 when y is not an integer, 1 when odd, 2 when even (iy: bits of a nonzero finite y)
fn est_gpow_checkint iy ulong to ulong
  e = and shr iy 52 2047
  if lt e 1023
    ret 0
  end
  if gt e 1075
    ret 2
  end
  sh = sub 1075 e
  if ne and iy sub shl ulong 1 sh 1 0
    ret 0
  end
  if ne and iy shl ulong 1 sh 0
    ret 1
  end
  ret 2
end

note bits of 0, infinity or nan
fn est_gpow_zin i ulong to bool
  ret ge sub mul i 2 1 ulong 18437736874454810623
end

fn est_gpow_snan i ulong to bool
  ret gt mul xor i ulong 2251799813685248 2 ulong 18442240474082181120
end

note __math_oflow / __math_uflow: (sign ? -v : v) * v with v = 2^769 / 2^-767
fn est_gpow_xflow sgn ulong over bool to f64
  v = bitcast f64 ulong 1152921504606846976
  if over
    v = bitcast f64 ulong 8070450532247928832
  end
  if ne sgn 0
    ret mul neg v v
  end
  ret mul v v
end

fn est_gpow_poly r f64 ar2 f64 to f64
  p12 = fma r est_gpow_c 4 est_gpow_c 3
  p34 = fma r est_gpow_c 6 est_gpow_c 5
  p56 = fma r est_gpow_c 8 est_gpow_c 7
  ret fma ar2 fma ar2 p56 p34 p12
end

note log_inline, first part: st = [r, t2, lo1 + lo2] for ix (x = 2^k z, z near the table point c)
fn est_gpow_log_a ix ulong st edit f64 3 to void
  tmp = add ix ulong 13842212212371881984
  i = and shr tmp 45 127
  ku = shr tmp 52
  kd = f64 long ku
  if ge ku 2048
    kd = f64 sub long ku 4096
  end
  z = bitcast f64 sub ix and tmp ulong 18442240474082181120
  b = add 9 mul i 3
  r = fma z est_gpow_c b -1.0f64
  t1 = fma kd est_gpow_c 0 est_gpow_c add b 1
  t2 = add r t1
  lo1 = fma kd est_gpow_c 1 est_gpow_c add b 2
  put st 0 r
  put st 1 t2
  put st 2 add lo1 add r sub t1 t2
end

note log_inline: log of ix (normalized) as hi + tail; tail written to tl
fn est_gpow_log ix ulong tl edit f64 1 to f64
  st = new f64 3 0.0f64
  est_gpow_log_a ix st
  r = get st 0
  t2 = get st 1
  ar = mul r est_gpow_c 2
  ar2 = mul r ar
  ar3 = mul r ar2
  hi = add t2 ar2
  lo3 = fma r ar neg ar2
  lo4 = add ar2 sub t2 hi
  q = est_gpow_poly r ar2
  lo = fma ar3 q add lo4 add lo3 get st 2
  y = add hi lo
  put tl 0 add lo sub hi y
  ret y
end

note specialcase of exp_inline (result may overflow, or lies in the subnormal range)
fn est_gpow_special tmp f64 sbits ulong ki long to f64
  if ge ki 0
    sc = bitcast f64 sub sbits ulong 4544132024016830464
    ret mul fma tmp sc sc bitcast f64 ulong 9151314442816847872
  end
  sb2 = add sbits ulong 4602678819172646912
  sc = bitcast f64 sb2
  st = mul tmp sc
  y = add sc st
  if lt fabs y 1.0f64
    one = f64 1.0f64
    if lt y 0.0f64
      one = f64 -1.0f64
    end
    lo = add st sub sc y
    hi = add y one
    lo = add lo add y sub one hi
    y = sub add hi lo one
    if eq y 0.0f64
      y = bitcast f64 and sb2 ulong 9223372036854775808
    end
  end
  ret mul y bitcast f64 ulong 4503599627370496
end

note exp_inline: sign * exp(x + xtail), sign from sb (0 or 0x40000)
fn est_gpow_exp x f64 xtail f64 sb ulong to f64
  bits = bitcast ulong x
  abstop = and shr bits 52 2047
  if gt sub abstop 969 62
    if lt abstop 969
      one = add x 1.0f64
      if ne sb 0
        ret neg one
      end
      ret one
    end
    if gt abstop 1032
      ret est_gpow_xflow sb eq shr bits 63 0
    end
    abstop = 0
  end
  z = mul x est_gexp_c 0
  kd = est_round_away z
  ki = long int kd
  r = add xtail fma kd est_gexp_c 3 fma kd est_gexp_c 2 x
  idx = mul and bitcast ulong ki 127 2
  tail = est_gexp_c add 22 idx
  sbits = add est_gexp_w add 23 idx shl add bitcast ulong ki sb 45
  tmp = est_gexp_tmp r tail
  if eq abstop 0
    ret est_gpow_special tmp sbits ki
  end
  sc = bitcast f64 sbits
  ret fma tmp sc sc
end

note y == 0, x == 1, nan, y infinite (iy is 0, inf or nan)
fn est_gpow_yspecial x f64 y f64 ix ulong iy ulong to f64
  if eq mul iy 2 0
    if est_gpow_snan ix
      ret add x y
    end
    ret 1.0f64
  end
  if eq ix ulong 4607182418800017408
    if est_gpow_snan iy
      ret add x y
    end
    ret 1.0f64
  end
  if or gt mul ix 2 ulong 18437736874454810624 gt mul iy 2 ulong 18437736874454810624
    ret add x y
  end
  if eq mul ix 2 ulong 9214364837600034816
    ret 1.0f64
  end
  if eq lt mul ix 2 ulong 9214364837600034816 eq shr iy 63 0
    ret 0.0f64
  end
  ret mul y y
end

note x is 0, inf or nan (y finite nonzero)
fn est_gpow_xspecial x f64 ix ulong iy ulong to f64
  x2 = mul x x
  sgn = ulong 0
  if ne shr ix 63 0
    if eq est_gpow_checkint iy 1
      x2 = neg x2
      sgn = 1
    end
  end
  if ne shr iy 63 0
    if eq mul ix 2 0
      if ne sgn 0
        ret div -1.0f64 0.0f64
      end
      ret div 1.0f64 0.0f64
    end
    ret div 1.0f64 x2
  end
  ret x2
end

note |y| < 2^-65 or |y| >= 2^63 (x positive finite nonzero after the sign step)
fn est_gpow_yrange y f64 ix ulong topy ulong to f64
  if eq ix ulong 4607182418800017408
    ret 1.0f64
  end
  if lt and topy 2047 958
    if gt ix ulong 4607182418800017408
      ret add 1.0f64 y
    end
    ret sub 1.0f64 y
  end
  if eq gt ix ulong 4607182418800017408 lt topy 2048
    ret est_gpow_xflow 0 true
  end
  ret est_gpow_xflow 0 false
end

fn est_gpow_main x f64 y f64 ix ulong sb ulong to f64
  tl = new f64 1 0.0f64
  hi = est_gpow_log ix tl
  lo = get tl 0
  ehi = mul y hi
  elo = fma y lo fma y hi neg ehi
  ret est_gpow_exp ehi elo sb
end

fn est_pow x f64 y f64 to f64
  ix = bitcast ulong x
  iy = bitcast ulong y
  topx = shr ix 52
  topy = shr iy 52
  sb = ulong 0
  yr = ge sub and topy 2047 958 128
  if or ge sub topx 1 2046 yr
    if est_gpow_zin iy
      ret est_gpow_yspecial x y ix iy
    end
    if est_gpow_zin ix
      ret est_gpow_xspecial x ix iy
    end
    if ne shr ix 63 0
      yint = est_gpow_checkint iy
      if eq yint 0
        ret div sub x x sub x x
      end
      if eq yint 1
        sb = ulong 262144
      end
      ix = and ix ulong 9223372036854775807
      topx = and topx 2047
    end
    if yr
      ret est_gpow_yrange y ix topy
    end
    if eq topx 0
      ix = sub and bitcast ulong mul x 4503599627370496.0f64 ulong 9223372036854775807 ulong 234187180623265792
    end
  end
  ret est_gpow_main x y ix sb
end

fn est_sin_poly r f64 to f64
  r2 = mul r r
  p = f64 -2.5052108385441719e-8
  p = add mul p r2 2.7557319223985891e-6
  p = add mul p r2 -1.9841269841269841e-4
  p = add mul p r2 8.3333333333333333e-3
  p = add mul p r2 -1.6666666666666667e-1
  p = add mul p r2 1.0
  ret mul r p
end

fn est_cos_poly r f64 to f64
  r2 = mul r r
  p = f64 2.0876756987868099e-9
  p = add mul p r2 -2.7557319223985891e-7
  p = add mul p r2 2.4801587301587302e-5
  p = add mul p r2 -1.3888888888888889e-3
  p = add mul p r2 4.1666666666666667e-2
  p = add mul p r2 -0.5
  p = add mul p r2 1.0
  ret p
end

fn est_sin x f64 to f64
  if not est_isfinite x
    ret est_nan
  end
  kf = est_nearbyint div x EST_HALF_PI
  r = sub x mul kf EST_HALF_PI
  q = and long kf 3
  if eq q 0
    ret est_sin_poly r
  end
  if eq q 1
    ret est_cos_poly r
  end
  if eq q 2
    ret neg est_sin_poly r
  end
  ret neg est_cos_poly r
end

fn est_cos x f64 to f64
  if not est_isfinite x
    ret est_nan
  end
  kf = est_nearbyint div x EST_HALF_PI
  r = sub x mul kf EST_HALF_PI
  q = and long kf 3
  if eq q 0
    ret est_cos_poly r
  end
  if eq q 1
    ret neg est_sin_poly r
  end
  if eq q 2
    ret neg est_cos_poly r
  end
  ret est_sin_poly r
end

fn est_atan_small t f64 to f64
  t2 = mul t t
  term = t
  s = t
  k = ulong 1
  while lt k 30 bound 30
    term = mul neg term t2
    addv = div term f64 add mul 2 k 1
    s = add s addv
    if le fabs addv mul 1.0e-17f64 fabs s
      break
    end
    k = add k 1
  end
  ret s
end

fn est_atan x f64 to f64
  if est_isnan x
    ret x
  end
  if lt x 0.0f64
    ret neg est_atan neg x
  end
  if gt x 1.0f64
    ret sub EST_HALF_PI est_atan div 1.0f64 x
  end
  if gt x 0.2679491924311227
    sq3 = f64 1.7320508075688773
    t = div sub mul sq3 x 1.0 add sq3 x
    ret add div EST_PI 6.0f64 est_atan_small t
  end
  ret est_atan_small x
end

fn est_asin x f64 to f64
  if or lt x -1.0f64 gt x 1.0f64
    ret est_nan
  end
  if eq x 1.0f64
    ret EST_HALF_PI
  end
  if eq x -1.0f64
    ret neg EST_HALF_PI
  end
  ret est_atan div x fsqrt sub 1.0f64 mul x x
end

note ---- Pure OM-2 SHA-256 (FIPS 180-4) ----

fn est_sha_kinit k edit uint 64 to void
  put k 0 0x428a2f98
  put k 1 0x71374491
  put k 2 0xb5c0fbcf
  put k 3 0xe9b5dba5
  put k 4 0x3956c25b
  put k 5 0x59f111f1
  put k 6 0x923f82a4
  put k 7 0xab1c5ed5
  put k 8 0xd807aa98
  put k 9 0x12835b01
  put k 10 0x243185be
  put k 11 0x550c7dc3
  put k 12 0x72be5d74
  put k 13 0x80deb1fe
  put k 14 0x9bdc06a7
  put k 15 0xc19bf174
  put k 16 0xe49b69c1
  put k 17 0xefbe4786
  put k 18 0x0fc19dc6
  put k 19 0x240ca1cc
  put k 20 0x2de92c6f
  put k 21 0x4a7484aa
  put k 22 0x5cb0a9dc
  put k 23 0x76f988da
  put k 24 0x983e5152
  put k 25 0xa831c66d
  put k 26 0xb00327c8
  put k 27 0xbf597fc7
  put k 28 0xc6e00bf3
  put k 29 0xd5a79147
  put k 30 0x06ca6351
  put k 31 0x14292967
  put k 32 0x27b70a85
  put k 33 0x2e1b2138
  put k 34 0x4d2c6dfc
  put k 35 0x53380d13
  put k 36 0x650a7354
  put k 37 0x766a0abb
  put k 38 0x81c2c92e
  put k 39 0x92722c85
  put k 40 0xa2bfe8a1
  put k 41 0xa81a664b
  put k 42 0xc24b8b70
  put k 43 0xc76c51a3
  put k 44 0xd192e819
  put k 45 0xd6990624
  put k 46 0xf40e3585
  put k 47 0x106aa070
  put k 48 0x19a4c116
  put k 49 0x1e376c08
  put k 50 0x2748774c
  put k 51 0x34b0bcb5
  put k 52 0x391c0cb3
  put k 53 0x4ed8aa4a
  put k 54 0x5b9cca4f
  put k 55 0x682e6ff3
  put k 56 0x748f82ee
  put k 57 0x78a5636f
  put k 58 0x84c87814
  put k 59 0x8cc70208
  put k 60 0x90befffa
  put k 61 0xa4506ceb
  put k 62 0xbef9a3f7
  put k 63 0xc67178f2
end

fn est_sha_iv s edit uint 8 to void
  put s 0 0x6a09e667
  put s 1 0xbb67ae85
  put s 2 0x3c6ef372
  put s 3 0xa54ff53a
  put s 4 0x510e527f
  put s 5 0x9b05688c
  put s 6 0x1f83d9ab
  put s 7 0x5be0cd19
end

fn est_sha_sched w edit uint 64 fresh m view uchar * o ulong to void
  q = ulong 0
  x = uint 0
  y = uint 0
  for i ulong 16 unroll
    q = add o mul i 4
    x = uint get m q
    x = or shl x 8 uint get m add q 1
    x = or shl x 8 uint get m add q 2
    put w i or shl x 8 uint get m add q 3
  end
  for i ulong 48 unroll
    x = get w add i 1
    y = get w add i 14
    x = add add get w i get w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
    put w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
  end
end

fn est_sha_rounds s edit uint 8 w view uint 64 kt view uint 64 to void
  a = get s 0
  b = get s 1
  c = get s 2
  d = get s 3
  e = get s 4
  f = get s 5
  g = get s 6
  h = get s 7
  t = uint 0
  for i ulong 64 unroll
    h = add h get kt i
    h = add h get w i
    t = xor rotr e 6 rotr e 11
    t = xor t rotr e 25
    h = add h t
    h = add h xor g and e xor f g
    d = add d h
    t = xor rotr a 2 rotr a 13
    t = xor t rotr a 22
    h = add h t
    t = and c or a b
    h = add h or and a b t
    t = h
    h = g
    g = f
    f = e
    e = d
    d = c
    c = b
    b = a
    a = t
  end
  put s 0 add get s 0 a
  put s 1 add get s 1 b
  put s 2 add get s 2 c
  put s 3 add get s 3 d
  put s 4 add get s 4 e
  put s 5 add get s 5 f
  put s 6 add get s 6 g
  put s 7 add get s 7 h
end

fn est_sha_compress s edit uint 8 w edit uint 64 kt view uint 64 m view uchar * o ulong to void
  est_sha_sched w m o
  est_sha_rounds s w kt
end

fn est_sha_finish s edit uint 8 w edit uint 64 kt view uint 64 p edit uchar 128 k ulong n ulong to void
  put p k 0x80
  e = ulong 64
  if ge k 56
    e = 128
  end
  bits = shl n 3
  for i ulong 8 unroll
    put p sub e add i 1 uchar and shr bits mul i 8 0xff
  end
  est_sha_compress s w kt view p 0
  if eq e 128
    est_sha_compress s w kt view p 64
  end
end

fn est_sha256_hash d view uchar * n ulong dst edit uchar 32 to void
  s = new uint 8 0
  w = new uint 64 0
  kt = new uint 64 0
  p = new uchar 128 0
  est_sha_kinit kt
  est_sha_iv s
  nb = shr n 6
  for j ulong nb
    est_sha_compress s w kt d shl j 6
  end
  off = shl nb 6
  k = sub n off
  for i ulong k
    put p i get d add off i
  end
  est_sha_finish s w kt p k n
  for i ulong 8 unroll
    v = ulong get s i
    for j ulong 4 unroll
      put dst add mul i 4 j uchar and shr v sub 24 mul j 8 0xff
    end
  end
end

fn est_sha256_domain dom view uchar * enc view uchar * enclen ulong dst edit uchar 32 to void
  dlen = len dom
  buf = new uchar 2400 0
  for i ulong dlen
    put buf i get dom i
  end
  put buf dlen uchar 0
  base = add dlen 1
  for i ulong enclen
    put buf add base i get enc i
  end
  est_sha256_hash view buf add base enclen dst
end

note ---- Minimal stdout/stderr printing helpers for test suites ----

fn est_write_all fd int s view uchar * n ulong to void
  off = ulong 0
  while lt off n bound 65536
    k = write fd s off sub n off
    if le k 0
      ret
    end
    off = add off ulong k
  end
end

fn est_puts s view uchar * to void
  est_write_all 1 s len s
end

fn est_eputs s view uchar * to void
  est_write_all 2 s len s
end

fn est_putu_fd fd int v ulong to void
  buf = new uchar 32 0
  if eq v 0
    put buf 0 uchar 48
    est_write_all fd view buf 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0 bound 32
    put buf n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  rev = new uchar 32 0
  for i ulong n
    put rev i get buf sub sub n 1 i
  end
  est_write_all fd view rev n
end

fn est_putu v ulong to void
  est_putu_fd 1 v
end

fn est_puti_fd fd int v long to void
  m = new uchar 1 45
  if lt v 0
    est_write_all fd view m 1
    est_putu_fd fd ulong neg v
    ret
  end
  est_putu_fd fd ulong v
end

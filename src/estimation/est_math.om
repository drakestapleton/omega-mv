  end
  if lt ix 1072365568
    if lt ix 1043333120
      if lt ix 8388608
        ret mul fma x 16.0f64 mul x mul 16.0f64 0.1283791670955126f64 0.0625f64
      end
      ret fma x 0.1283791670955126f64 x
    end
    ret fma x est_erf_rs_small mul x x x
  end
  if lt ix 1072955392
    pq = est_erf_pq_mid sub fabs x 1.0f64
    if neg_x
      ret sub -0.8450629115104675f64 pq
    end
    ret add pq 0.8450629115104675f64
  end
  if ge ix 1075314688
    if neg_x
      ret sub 1.0e-300f64 1.0f64
    end
    ret sub 1.0f64 1.0e-300f64
  end
  ax = fabs x
  r = est_erf_tail ax est_erf_tail_rs ax ix 1074191214
  if neg_x
    ret sub div r ax 1.0f64
  end
  ret sub 1.0f64 div r ax
end

fn est_erfc_small x f64 hi ulong to f64
  y = est_erf_rs_small mul x x
  xy = mul x y
  if or ne shr hi 31 0 lt hi 1070596096
    ret sub 1.0f64 add xy x
  end
  ret sub 0.5f64 add xy sub x 0.5f64
end

fn est_erfc x f64 to f64
  hi = est_erf_hi x
  ix = and hi 2147483647
  neg_x = ne shr hi 31 0
  if ge ix 2146435072
    sg = f64 0.0f64
    if neg_x
      sg = f64 2.0f64
    end
    ret add sg div 1.0f64 x
  end
  if lt ix 1072365568
    if lt ix 1013972992
      ret sub 1.0f64 x
    end
    ret est_erfc_small x hi
  end
  if lt ix 1072955392
    pq = est_erf_pq_mid sub fabs x 1.0f64
    if neg_x
      ret add add pq 0.8450629115104675f64 1.0f64
    end
    ret sub 0.15493708848953247f64 pq
  end
  if lt ix 1077673984
    if and neg_x ge ix 1075314688
      ret sub 2.0f64 1.0e-300f64
    end
    ax = fabs x
    r = est_erf_tail ax est_erf_tail_rs ax ix 1074191213
    if neg_x
      ret sub 2.0f64 div r ax
    end
    ret div r ax
  end
  if neg_x

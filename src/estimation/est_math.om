note ---- exp(x), bit for bit with glibc 2.39 AArch64 libm (sysdeps/ieee754/dbl-64/e_exp.c) ----
note g_gexp_t is __exp_data as stored in libm.so.6: [0] invln2N, [2] negln2hiN, [3] negln2loN,
note [4..7] C2..C5, [22 + 2i] tab[2i] (tail bits), [23 + 2i] tab[2i+1] (scale bits).
note The fused steps follow the FMADDs GCC emitted; kd = round(z) (FRINTA), ki = lround(z).

fn est_gexp_w i ulong to ulong
  if eq get g_gexp_ready 0 0
    est_gexp_init
    put g_gexp_ready 0 1
  end
  ret get g_gexp_t i
end

fn est_gexp_c i ulong to f64
  ret bitcast f64 est_gexp_w i
end

fn est_round_away z f64 to f64
  t = f64 long z
  fr = sub z t
  if ge fr f64 0.5
    ret add t f64 1.0
  end
  if le fr f64 -0.5
    ret sub t f64 1.0
  end
  if eq t f64 0.0
    ret mul z f64 0.0
  end
  ret t
end

fn est_gexp_tmp r f64 tail f64 to f64
  p23 = fma est_gexp_c 5 r est_gexp_c 4
  p45 = fma est_gexp_c 7 r est_gexp_c 6
  r2 = mul r r
  t1 = add r tail
  t2 = fma p23 r2 t1
  ret fma mul r2 r2 p45 t2
end

fn est_gexp_special tmp f64 sbits ulong ki long to f64
  if ge ki 0
    sc = bitcast f64 sub sbits ulong 4544132024016830464
    ret mul fma tmp sc sc bitcast f64 ulong 9151314442816847872
  end
  sc = bitcast f64 add sbits ulong 4602678819172646912
  st = mul tmp sc
  y = add sc st
  tiny = bitcast f64 ulong 4503599627370496
  if ge y f64 1.0
    ret mul y tiny
  end
  hi = add y f64 1.0
  lo = add sub sc y st
  y2 = sub add add add sub f64 1.0 hi y lo hi f64 1.0
  if eq y2 f64 0.0
    ret f64 0.0
  end
  ret mul y2 tiny
end

fn est_exp x f64 to f64
  bits = bitcast ulong x
  abstop = and shr bits 52 2047
  if ge sub abstop 969 63
    if lt abstop 969
      ret add f64 1.0 x
    end
    if gt abstop 1032
      if eq bits ulong 18442240474082181120
        ret f64 0.0
      end
      if eq abstop 2047
        ret add f64 1.0 x
      end
      if ne shr bits 63 0
        ret f64 0.0
      end
      ret est_inf
    end
    abstop = 0
  end
  z = mul x est_gexp_c 0
  kd = est_round_away z
  ki = long kd
  r = fma est_gexp_c 3 kd fma est_gexp_c 2 kd x
  idx = mul and bitcast ulong ki 127 2
  tail = est_gexp_c add 22 idx
  sbits = add est_gexp_w add 23 idx shl bitcast ulong ki 45
  tmp = est_gexp_tmp r tail
  if eq abstop 0
    ret est_gexp_special tmp sbits ki
  end
  sc = bitcast f64 sbits
  ret fma tmp sc sc
end



note ---- log(x), bit for bit with glibc 2.39 AArch64 libm (sysdeps/ieee754/dbl-64/e_log.c) ----
note The table g_glog_t is __log_data as stored in libm.so.6: [0] ln2hi, [1] ln2lo,
note [2..6] poly A[0..4], [7..17] poly1 B[0..10], [18 + 2i] tab[i].invc, [19 + 2i] tab[i].logc.
note Each fused step follows the FMADD/FMSUB that GCC emitted for that build.

fn est_glog_t i ulong to f64
  if eq get g_glog_ready 0 0
    est_glog_init
    put g_glog_ready 0 1
  end
  ret bitcast f64 get g_glog_t i
end

fn est_glog_n1_mid r f64 r2 f64 r3 f64 to f64
  p78 = fma est_glog_t 15 r est_glog_t 14
  p79 = fma est_glog_t 16 r2 p78
  pin = fma est_glog_t 17 r3 p79
  p45 = fma est_glog_t 12 r est_glog_t 11
  p46 = fma est_glog_t 13 r2 p45
  ret fma pin r3 p46
end

fn est_glog_n1_poly r f64 r2 f64 r3 f64 to f64
  pmid = est_glog_n1_mid r r2 r3
  p12 = fma est_glog_t 9 r est_glog_t 8
  p13 = fma est_glog_t 10 r2 p12
  ret fma pmid r3 p13
end

fn est_glog_near1 x f64 to f64
  r = sub x f64 1.0
  two27 = bitcast f64 ulong 4728779608739020800
  b0 = est_glog_t 7
  rw = fma r two27 r
  rhi = fma neg r two27 rw
  r2 = mul r r
  r3 = mul r r2
  pout = est_glog_n1_poly r r2 r3
  rh2 = mul rhi rhi
  hi = fma rh2 b0 r
  brlo = mul b0 sub r rhi
  rpr = add r rhi
  lo1 = fma rh2 b0 sub r hi
  lo2 = fma brlo rpr lo1
  y = fma pout r3 lo2
  ret add hi y
end

fn est_glog_tail r f64 kd f64 w f64 to f64
  hi = add r w
  lo = fma est_glog_t 1 kd add sub w hi r
  r2 = mul r r
  a34 = fma est_glog_t 6 r est_glog_t 5
  a12 = fma est_glog_t 4 r est_glog_t 3
  pa = fma a34 r2 a12
  y0 = fma est_glog_t 2 r2 lo
  y1 = fma mul r r2 pa y0
  ret add y1 hi
end

fn est_glog_main ix0 ulong to f64
  tmp = sub ix0 ulong 4604367669032910848
  i = and shr tmp 45 127
  kd = f64 shr bitcast long tmp 52
  z = bitcast f64 sub ix0 and tmp ulong 18442240474082181120
  w = fma est_glog_t 0 kd est_glog_t add 19 mul i 2
  r = fma est_glog_t add 18 mul i 2 z f64 -1.0
  ret est_glog_tail r kd w
end

fn est_log x f64 to f64
  ix = bitcast ulong x
  if lt sub ix ulong 4606619468846596096 ulong 854320534781952
    if eq ix ulong 4607182418800017408
      ret f64 0.0
    end
    ret est_glog_near1 x
  end
  top = shr ix 48
  if ge sub top 16 ulong 32736
    if eq shl ix 1 0
      ret est_ninf
    end
    if eq ix ulong 9218868437227405312
      ret x
    end
    if or ne and top 32768 0 eq and top 32752 32752
      ret div sub x x sub x x
    end
    ix = sub bitcast ulong mul x bitcast f64 ulong 4841369599423283200 ulong 234187180623265792
  end
  ret est_glog_main ix
end


fn est_powu a f64 n ulong to f64
  res = f64 1.0f64
  base = a
  r = n
  while gt r 0 bound 64
    if ne and r 1 0
      res = mul res base
    end
    r = shr r 1
    if gt r 0
      base = mul base base
    end
  end
  ret res
end

note ---- erf(x), erfc(x): bit for bit with glibc 2.39 AArch64 libm (sysdeps/ieee754/dbl-64/s_erf.c) ----
note Coefficients and branches as s_erf.c. Each fma is a fused multiply-add GCC 13 emitted for
note that file (-O2, contraction on, as libm is built): the same source compiled that way matches
note libm.so.6 on 2M samples per function, and with -ffp-contract=off it does not.
note hi32 is the high word of x as an unsigned 32-bit value (C's int32 hx: sign = bit 31).

fn est_erf_hi x f64 to ulong
  ret shr bitcast ulong x 32
end

note r/s of the [0, 0.84375) branch, z = x*x
fn est_erf_rs_small z f64 to f64
  r1 = fma z -0.3250421072470015f64 0.12837916709551256f64
  z2 = mul z z
  r2 = fma z -0.005770270296489442f64 -0.02848174957559851f64
  z4 = mul z2 z2
  s1 = fma z 0.39791722395915535f64 1.0f64
  s2 = fma z 0.005081306281875766f64 0.0650222499887673f64
  s3 = fma z -3.960228278775368e-06f64 0.00013249473800432164f64
  r = fma z4 -2.3763016656650163e-05f64 fma z2 r2 r1
  s = fma z4 s3 fma z2 s2 s1
  ret div r s
end

note P/Q of the [0.84375, 1.25) branch, s = |x| - 1
fn est_erf_pq_mid s f64 to f64
  p1 = fma s 0.41485611868374833f64 -0.0023621185607526594f64
  s2 = mul s s
  q1 = fma s 0.10642088040084423f64 1.0f64
  s4 = mul s2 s2
  p2 = fma s 0.31834661990116175f64 -0.3722078760357013f64
  s6 = mul s2 s4
  q2 = fma s 0.07182865441419627f64 0.540397917702171f64
  p3 = fma s 0.035478304325618236f64 -0.11089469428239668f64
  q3 = fma s 0.01363708391202905f64 0.12617121980876164f64
  pp = fma s6 -0.002166375594868791f64 fma s4 p3 fma s2 p2 p1
  qq = fma s6 0.011984499846799107f64 fma s4 q3 fma s2 q2 q1
  ret div pp qq
end

note R/S for |x| in [1.25, 1/0.35), s = 1/(x*x)
fn est_erf_rs_a s f64 to f64
  s2 = mul s s
  s4 = mul s2 s2
  s6 = mul s2 s4
  r1 = fma s -0.6938585727071818f64 -0.009864944034847148f64
  r2 = fma s -62.375332450326006f64 -10.558626225323291f64
  r3 = fma s -184.60509290671104f64 -162.39666946257347f64
  r4 = fma s -9.814329344169145f64 -81.2874355063066f64
  rr = fma s6 r4 fma s4 r3 fma s2 r2 r1
  ret rr
end

fn est_erf_ss_a s f64 to f64
  s2 = mul s s
  s4 = mul s2 s2
  s6 = mul s2 s4
  s8 = mul s4 s4
  t1 = fma s 19.651271667439257f64 1.0f64
  t2 = fma s 434.56587747522923f64 137.65775414351904f64
  t3 = fma s 429.00814002756783f64 645.3872717332679f64
  t4 = fma s 6.570249770319282f64 108.63500554177944f64

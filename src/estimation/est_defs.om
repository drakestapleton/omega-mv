note ---- Compact structs (all <= 64 cells) ----

struct EstMix k ulong w f64 3 v f64 3 end
struct EstAssump family ulong unit ulong quantum f64 lo f64 hi f64 nparam ulong param f64 8 end
struct EstPObs val f64 cls ulong evidence uchar 32 end
struct EstBState assumption ulong 4 has_anchor ulong anchor f64 xhat f64 P f64 s2 f64 gap ulong generation ulong evidence_root ulong 4 cnt ulong 5 cache_valid ulong cache_key f64 cache_lo long cache_hi long end
struct EstDPred assumption uchar 32 family ulong horizon ulong generation ulong anchor f64 quantum f64 end
struct EstPInnov valid ulong cls ulong k long F_lo f64 F_hi f64 logp f64 z f64 end
struct EstCalib n ulong cov f64 3 pit f64 10 logp_sum f64 width_sum f64 z_sum f64 z_sq f64 z_lag f64 z_prev f64 end
struct EstBands cov50 f64 2 cov80 f64 2 cov95 f64 2 pit f64 2 bias_max f64 lag1_max f64 min_n ulong end
struct Est4Params family ulong dyn f64 q f64 lam f64 nu f64 c f64 phi f64 nu_h f64 c_h f64 quantum f64 end
struct Est4State family ulong pv f64 9 d ulong A f64 9 Q f64 9 H f64 3 r f64 has_anchor ulong anchor f64 gap ulong x f64 3 P f64 9 g f64 gl f64 generation ulong end
struct Est4Pred h ulong loc f64 scale f64 nu f64 end

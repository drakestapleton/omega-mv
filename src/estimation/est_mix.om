note SPDX-License-Identifier: Apache-2.0
note EST-3b Gaussian scale mixture in pure seeded OM-2 (est_mix.h / est_mix.c).

const EST_LOG_2PI f64 1.8378770664093453

fn est_mix_check mx view EstMix to long
  k = get mx k
  if or lt k 1 gt k EST_MIX_MAX
    ret EST_ERR_DIM
  end
  s = f64 0.0f64
  for j ulong k
    wf = get mx w j
    vf = get mx v j
    if or not est_isfinite wf not est_isfinite vf
      ret EST_ERR_NONFINITE
    end
    if lt wf 0.0f64
      ret EST_ERR_NOT_PSD
    end
    if not gt vf 0.0f64
      ret EST_ERR_NOT_PD
    end
    s = add s wf
  end
  if le fabs sub s 1.0f64 1.0e-12f64
    ret EST_OK
  end
  ret EST_ERR_ENCODING
end

fn est_mix_total_var mx view EstMix to f64
  k = get mx k
  s = f64 0.0f64
  for j ulong k
    s = add s mul get mx w j get mx v j
  end
  ret s
end

fn est_mix_term_eval mx view EstMix a view ulong 3 lh f64 res edit f64 2 to bool
  k = get mx k
  lw = lh
  var = f64 0.0f64
  for j ulong k
    aj = get a j
    if gt aj 0
      wj = get mx w j
      if le wj 0.0f64
        ret false
      end
      ajf = f64 aj
      lg = est_lgamma add ajf 1.0f64
      lw = add lw sub mul ajf est_log wj lg
      var = add var mul ajf get mx v j
    end
  end
  put res 0 lw
  put res 1 var
  ret true
end

fn est_mix_cdf_contrib tv view f64 2 t f64 to f64
  w = est_exp get tv 0
  sd = fsqrt mul 2.0f64 get tv 1
  ret mul w est_erf div t sd
end

fn est_mix_lp_contrib tv view f64 2 e f64 to f64
  v = get tv 1
  q = add add EST_LOG_2PI est_log v div mul e e v
  ret sub get tv 0 mul 0.5f64 q
end

fn est_mix_cdf_k3 mx view EstMix h ulong t f64 lh f64 to f64
  acc = f64 0.0
  a = new ulong 3 0
  tv = new f64 2 0.0
  for a0 ulong add h 1 bound 66
    rem1 = sub h a0
    for a1 ulong add rem1 1 bound 66
      put a 0 a0
      put a 1 a1
      put a 2 sub rem1 a1
      if est_mix_term_eval mx view a lh tv
        acc = add acc est_mix_cdf_contrib view tv t
      end
    end
  end
  ret acc
end

fn est_mix_cdf_abs mx view EstMix h ulong t f64 res edit f64 1 to long
  st = est_mix_check mx
  if ne st EST_OK
    ret st
  end
  if or lt h 1 gt h EST_MIX_MAX_H
    ret EST_ERR_TIME
  end
  if not est_isfinite t
    ret EST_ERR_NONFINITE
  end
  if le t 0.0f64
    put res 0 0.0f64
    ret EST_OK
  end
  k = get mx k
  lh = est_lgamma add f64 h 1.0f64
  acc = f64 0.0
  a = new ulong 3 0
  tv = new f64 2 0.0
  if eq k 1
    put a 0 h
    if est_mix_term_eval mx view a lh tv
      acc = est_mix_cdf_contrib view tv t
    end
  else
    if eq k 2
      for a0 ulong add h 1 bound 66
        put a 0 a0
        put a 1 sub h a0
        if est_mix_term_eval mx view a lh tv
          acc = add acc est_mix_cdf_contrib view tv t
        end
      end
    else
      acc = est_mix_cdf_k3 mx h t lh
    end
  end
  if gt acc 1.0f64
    acc = 1.0f64
  end
  put res 0 acc
  ret EST_OK
end

fn est_mix_quantile_abs mx view EstMix h ulong p f64 res edit f64 1 to long
  st = est_mix_check mx
  if ne st EST_OK
    ret st
  end
  if or lt h 1 gt h EST_MIX_MAX_H
    ret EST_ERR_TIME
  end
  if not and gt p 0.0f64 lt p 1.0f64
    ret EST_ERR_DIM
  end
  vmax = f64 0.0f64
  for j ulong get mx k
    if gt get mx v j vmax
      vmax = get mx v j
    end
  end
  lo = f64 0.0f64
  hi = mul 64.0f64 fsqrt mul f64 h vmax
  c = new f64 1 0.0f64
  for i ulong 200
    mid = mul 0.5f64 add lo hi
    st = est_mix_cdf_abs mx h mid c
    if lt get c 0 p
      lo = mid
    else
      hi = mid
    end
  end
  put res 0 hi
  ret EST_OK
end

fn est_mix_lp_k3_max mx view EstMix h ulong a0 ulong e f64 to f64
  lh = est_lgamma add f64 h 1.0f64
  rem1 = sub h a0
  outv = est_ninf
  a = new ulong 3 0
  tv = new f64 2 0.0
  put a 0 a0
  for a1 ulong add rem1 1 bound 66
    put a 1 a1
    put a 2 sub rem1 a1
    if est_mix_term_eval mx view a lh tv
      l = est_mix_lp_contrib view tv e
      if gt l outv
        outv = l
      end
    end
  end
  ret outv
end

fn est_mix_lp_k3_sum mx view EstMix h ulong a0 ulong e f64 mxl f64 to f64
  lh = est_lgamma add f64 h 1.0f64
  rem1 = sub h a0
  outv = f64 0.0
  a = new ulong 3 0
  tv = new f64 2 0.0
  put a 0 a0
  for a1 ulong add rem1 1 bound 66
    put a 1 a1
    put a 2 sub rem1 a1
    if est_mix_term_eval mx view a lh tv
      l = est_mix_lp_contrib view tv e
      outv = add outv est_exp sub l mxl
    end
  end
  ret outv
end

fn est_mix_lp_k3 mx view EstMix h ulong e f64 pass ulong mxl f64 to f64
  outv = mxl
  if eq pass 1
    outv = 0.0f64
  end
  for a0 ulong add h 1 bound 66
    if eq pass 0
      r = est_mix_lp_k3_max mx h a0 e
      if gt r outv
        outv = r
      end
    else
      outv = add outv est_mix_lp_k3_sum mx h a0 e mxl
    end
  end
  ret outv
end

fn est_mix_lp_pass mx view EstMix h ulong e f64 pass ulong mxl f64 to f64
  k = get mx k
  if eq k 3
    ret est_mix_lp_k3 mx h e pass mxl
  end
  lh = est_lgamma add f64 h 1.0f64
  outv = mxl
  if eq pass 1
    outv = 0.0f64
  end
  a = new ulong 3 0
  tv = new f64 2 0.0
  if eq k 1
    put a 0 h
    if est_mix_term_eval mx view a lh tv
      l = est_mix_lp_contrib view tv e
      if eq pass 0
        if gt l outv
          outv = l
        end
      else
        outv = add outv est_exp sub l mxl
      end
    end
  else
    for a0 ulong add h 1 bound 66
      put a 0 a0
      put a 1 sub h a0
      if est_mix_term_eval mx view a lh tv
        l = est_mix_lp_contrib view tv e
        if eq pass 0
          if gt l outv
            outv = l
          end
        else
          outv = add outv est_exp sub l mxl
        end
      end
    end
  end
  ret outv
end

fn est_mix_logpdf mx view EstMix h ulong e f64 res edit f64 1 to long
  st = est_mix_check mx
  if ne st EST_OK
    ret st
  end
  if or lt h 1 gt h EST_MIX_MAX_H
    ret EST_ERR_TIME
  end
  if not est_isfinite e
    ret EST_ERR_NONFINITE
  end
  mxl = est_mix_lp_pass mx h e 0 est_ninf
  acc = est_mix_lp_pass mx h e 1 mxl
  put res 0 add mxl est_log acc
  ret EST_OK
end

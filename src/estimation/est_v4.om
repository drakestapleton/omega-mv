note SPDX-License-Identifier: Apache-2.0
note ESTIMATION v4 persistence-aware predictive families in pure seeded OM-2 (est_v4.h / est_v4.c).

text EST_DOM_V4 "omega.est.v4.params.v1"

fn est4_mat_mul d ulong a view f64 9 b view f64 9 dst edit f64 9 to void
  t = new f64 9 0.0f64
  for i ulong d
    for j ulong d
      s = f64 0.0f64
      for k ulong d
        aik = get a add mul i d k
        bkj = get b add mul k d j
        s = add s mul aik bkj
      end
      put t add mul i d j s
    end
  end
  for i ulong mul d d
    put dst i get t i
  end
end

fn est4_sandwich d ulong a view f64 9 b view f64 9 dst edit f64 9 to void
  t = new f64 9 0.0
  atr = new f64 9 0.0
  for i ulong d
    for j ulong d
      put atr add mul j d i get a add mul i d j
    end
  end
  est4_mat_mul d a b t
  est4_mat_mul d view t view atr dst
end

fn est4_params_check p view Est4Params to long
  fam = get p family
  if and ne fam EST4_G1_LAG and ne fam EST4_G2_AR ne fam EST4_G3_TWO
    ret EST_ERR_KIND
  end
  if not est_isfinite get p dyn
    ret EST_ERR_NONFINITE
  end
  if not est_isfinite get p q
    ret EST_ERR_NONFINITE
  end
  if not est_isfinite get p lam
    ret EST_ERR_NONFINITE
  end
  if not est_isfinite get p phi
    ret EST_ERR_NONFINITE
  end
  if not est_isfinite get p nu
    ret EST_ERR_NONFINITE
  end
  if not est_isfinite get p c
    ret EST_ERR_NONFINITE
  end
  if not est_isfinite get p nu_h
    ret EST_ERR_NONFINITE
  end
  if not est_isfinite get p c_h
    ret EST_ERR_NONFINITE
  end
  if not est_isfinite get p quantum
    ret EST_ERR_NONFINITE
  end
  if eq fam EST4_G2_AR
    if or lt get p dyn 0.0f64 ge get p dyn 1.0f64
      ret EST_ERR_DIM
    end
  else
    if not gt get p dyn 0.0f64
      ret EST_ERR_DIM
    end
  end
  if not gt get p q 0.0f64
    ret EST_ERR_DIM
  end
  if or lt get p lam 0.0f64 ge get p lam 1.0f64
    ret EST_ERR_DIM
  end
  if or le get p phi 0.0f64 gt get p phi 1.0f64
    ret EST_ERR_DIM
  end
  if not gt get p nu 0.0f64
    ret EST_ERR_DIM
  end
  if not gt get p c 0.0f64
    ret EST_ERR_DIM
  end
  if not gt get p nu_h 0.0f64
    ret EST_ERR_DIM
  end
  if not gt get p c_h 0.0f64
    ret EST_ERR_DIM
  end
  if not gt get p quantum 0.0f64
    ret EST_ERR_DIM
  end
  ret EST_OK
end

fn est4_params_digest p view Est4Params dst edit uchar 32 to long
  st = est4_params_check p
  if ne st EST_OK
    ret st
  end
  enc = new uchar 100 0
  o = est_put_u32 enc 0 get p family
  o = est_put_f64_canon enc o get p dyn
  o = est_put_f64_canon enc o get p q
  o = est_put_f64_canon enc o get p lam
  o = est_put_f64_canon enc o get p nu
  o = est_put_f64_canon enc o get p c
  o = est_put_f64_canon enc o get p phi
  o = est_put_f64_canon enc o get p nu_h
  o = est_put_f64_canon enc o get p c_h
  o = est_put_f64_canon enc o get p quantum
  o = est_put_f64_canon enc o EST4_GL_LAMBDA
  o = est_put_f64_canon enc o EST4_TAU_RATIO
  o = est_put_f64_canon enc o EST4_G3_W
  est_sha256_domain EST_DOM_V4 view enc o dst
  ret EST_OK
end

fn est4_state_to_params s view Est4State p edit Est4Params to void
  put p family get s family
  put p dyn get s pv 0
  put p q get s pv 1
  put p lam get s pv 2
  put p nu get s pv 3
  put p c get s pv 4
  put p phi get s pv 5
  put p nu_h get s pv 6
  put p c_h get s pv 7
  put p quantum get s pv 8
end

fn est4_init p view Est4Params s edit Est4State to long
  st = est4_params_check p
  if ne st EST_OK
    ret st
  end
  fam = get p family
  put s family fam
  put s pv 0 get p dyn
  put s pv 1 get p q
  put s pv 2 get p lam
  put s pv 3 get p nu
  put s pv 4 get p c
  put s pv 5 get p phi
  put s pv 6 get p nu_h
  put s pv 7 get p c_h
  put s pv 8 get p quantum
  for i ulong 9
    put s A i 0.0f64
    put s Q i 0.0f64
    put s P i 0.0f64
  end
  for i ulong 3
    put s H i 0.0f64
    put s x i 0.0f64
  end
  qu = get p quantum
  put s r div mul qu qu 12.0f64
  put s has_anchor 0
  put s anchor 0.0f64
  put s gap 0
  put s g 1.0f64
  put s gl 1.0f64
  put s generation 0
  if eq fam EST4_G1_LAG
    a = est_exp div -1.0f64 get p dyn
    put s d 2
    put s A 0 a
    put s A 1 sub 1.0f64 a
    put s A 3 1.0f64
    put s Q 3 get p q
    put s H 0 1.0f64
  else
    if eq fam EST4_G2_AR
      rv = get p dyn
      put s d 2
      put s A 0 1.0f64
      put s A 1 rv
      put s A 3 rv
      qv = get p q
      put s Q 0 qv
      put s Q 1 qv
      put s Q 2 qv
      put s Q 3 qv
      put s H 0 1.0f64
    else
      af = est_exp div -1.0f64 get p dyn
      asv = est_exp div -1.0f64 mul get p dyn EST4_TAU_RATIO
      w = EST4_G3_W
      put s d 3
      put s A 0 af
      put s A 2 mul sub 1.0f64 af w
      put s A 4 asv
      put s A 5 mul sub 1.0f64 asv sub 1.0f64 w
      put s A 8 1.0f64
      put s Q 8 get p q
      put s H 0 1.0f64
      put s H 1 1.0f64
    end
  end
  ret EST_OK
end

fn est4_first_obs s edit Est4State y0 f64 to void
  for i ulong 3
    put s x i 0.0f64
  end
  for i ulong 9
    put s P i 0.0f64
  end
  qv = get s pv 1
  rv = get s r
  fam = get s family
  if eq fam EST4_G1_LAG
    put s x 0 y0
    put s x 1 y0
    put s P 0 rv
    put s P 3 add rv qv
  else
    if eq fam EST4_G2_AR
      put s x 0 y0
      put s x 1 0.0f64
      put s P 0 rv
      put s P 3 qv
    else
      put s x 0 mul EST4_G3_W y0
      put s x 1 mul sub 1.0f64 EST4_G3_W y0
      put s x 2 y0
      put s P 0 rv
      put s P 4 rv
      put s P 8 add rv qv
    end
  end
end

fn est4_prop_step d ulong Am view f64 9 Qm view f64 9 x edit f64 3 P edit f64 9 to void
  xn = new f64 3 0.0
  for i ulong d
    acc = f64 0.0
    base = mul i d
    for j ulong d
      acc = add acc mul get Am add base j get x j
    end
    put xn i acc
  end
  for i ulong d
    put x i get xn i
  end
  Pn = new f64 9 0.0
  est4_sandwich d Am view P Pn
  for i ulong mul d d
    put P i add get Pn i get Qm i
  end
end

fn est4_prop_vrow s view Est4State P view f64 9 i ulong d ulong to f64
  acc = f64 0.0
  base = mul i d
  for j ulong d
    acc = add acc mul get P add base j get s H j
  end
  ret mul get s H i acc
end

fn est4_prop_moments s view Est4State x view f64 3 P view f64 9 res edit f64 2 to void
  d = get s d
  mm = f64 0.0
  vv = f64 0.0
  for i ulong d
    mm = add mm mul get s H i get x i
    vv = add vv est4_prop_vrow s P i d
  end
  put res 0 mm
  put res 1 add vv get s r
end

fn est4_propagate s view Est4State h ulong res edit f64 2 to void
  d = get s d
  x = new f64 3 0.0
  P = new f64 9 0.0
  Am = new f64 9 0.0
  Qm = new f64 9 0.0
  for i ulong d
    put x i get s x i
  end
  for i ulong mul d d
    put P i get s P i
    put Am i get s A i
    put Qm i get s Q i
  end
  for k ulong h bound 66
    est4_prop_step d view Am view Qm x P
  end
  est4_prop_moments s view x view P res
end

fn est4_gbar g f64 gl f64 phi f64 h ulong to f64
  if eq h 0
    ret est_nan
  end
  f = f64 1.0f64
  gb = f64 0.0f64
  for j ulong h bound 66
    gb = add gb add gl mul sub g gl f
    f = mul f phi
  end
  ret div gb f64 h
end

fn est4_moments s view Est4State h ulong res edit f64 2 to long
  if or lt h 1 gt h EST_PRED_MAX_H
    ret EST_ERR_TIME
  end
  if eq get s has_anchor 0
    ret EST_ERR_STALE
  end
  est4_propagate s h res
  if and est_isfinite get res 0 and gt get res 1 0.0f64 est_isfinite get res 1
    ret EST_OK
  end
  ret EST_ERR_NONFINITE
end

fn est4_predict s view Est4State h ulong dst edit Est4Pred to long
  if or lt h 1 gt h EST_PRED_MAX_H
    ret EST_ERR_TIME
  end
  if eq get s has_anchor 0
    ret EST_ERR_STALE
  end
  mv = new f64 2 0.0f64
  est4_propagate s h mv
  mh = get mv 0
  Vh = get mv 1
  if or not gt Vh 0.0f64 not est_isfinite Vh
    ret EST_ERR_NONFINITE
  end
  put dst h h
  put dst loc mh
  if eq h 1
    put dst nu get s pv 3
    put dst scale mul get s pv 4 fsqrt mul get s g Vh
  else
    gb = est4_gbar get s g get s gl get s pv 5 h
    put dst nu get s pv 6
    put dst scale mul get s pv 7 fsqrt mul gb Vh
  end
  if or not est_isfinite get dst loc or not gt get dst scale 0.0f64 not est_isfinite get dst scale
    ret EST_ERR_NONFINITE
  end
  ret EST_OK
end

fn est4_state_digest s view Est4State dig edit uchar 32 to long
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  est4_state_to_params s p
  ret est4_params_digest view p dig
end

fn est4_dpred s view Est4State pr view Est4Pred dp edit EstDPred pmf edit f64 801 to long
  if eq get s has_anchor 0
    ret EST_ERR_STALE
  end
  ph = get pr h
  hz = add get s gap ph
  if or lt ph 1 gt hz EST_PRED_MAX_H
    ret EST_ERR_TIME
  end
  if not est_isfinite get pr loc
    ret EST_ERR_NONFINITE
  end
  if or not gt get pr scale 0.0f64 not est_isfinite get pr scale
    ret EST_ERR_NONFINITE
  end
  if not gt get pr nu 0.0f64
    ret EST_ERR_NONFINITE
  end
  dig = new uchar 32 0
  st = est4_state_digest s dig
  if ne st EST_OK
    ret st
  end
  for i ulong 32
    put dp assumption i get dig i
  end
  put dp family 0
  put dp horizon hz
  put dp generation get s generation
  put dp anchor get s anchor
  put dp quantum get s pv 8
  mx = new EstMix ulong 0 f64 0.0 f64 0.0
  mq = new f64 2 0.0
  put mq 0 sub get pr loc get s anchor
  put mq 1 get s pv 8
  st = est_pmf_from_dist 1 get pr scale get pr nu view mx view mq pmf
  if ne st EST_OK
    ret st
  end
  est_pmf_floor pmf
  ret EST_OK
end

fn est4_sf_any x f64 nu f64 to f64
  if est_isinf x
    if gt x 0.0f64
      ret 0.0f64
    end
    ret 1.0f64
  end
  if ge x 0.0f64
    ret est_t_sf x nu
  end
  ret sub 1.0f64 est_t_sf neg x nu
end

fn est4_fast_prob a f64 b f64 nu f64 res edit f64 3 to void
  lo = f64 0.0
  hi = f64 0.0
  p = f64 0.0
  if ge a 0.0f64
    sa = est4_sf_any a nu
    sb = est4_sf_any b nu
    p = sub sa sb
    lo = sub 1.0f64 sa
    hi = sub 1.0f64 sb
  else
    if le b 0.0f64
      ca = est4_sf_any neg a nu
      cb = est4_sf_any neg b nu
      p = sub cb ca
      lo = ca
      hi = cb
    else
      lo = est4_sf_any neg a nu
      sb = est4_sf_any b nu
      p = sub sub 1.0f64 lo sb
      hi = sub 1.0f64 sb
    end
  end
  if lt p 0.0f64
    p = 0.0f64
  end
  put res 0 p
  put res 1 lo
  put res 2 hi
end

fn est4_fast_finish plh view f64 3 k long fout edit f64 2 to f64
  u = div EST_PRED_FLOOR 801.0f64
  omf = sub 1.0f64 EST_PRED_FLOOR
  idx = f64 add k EST_PRED_K
  p = add mul omf get plh 0 u
  put fout 0 add mul omf get plh 1 mul u idx
  put fout 1 add mul omf get plh 2 mul u add idx 1.0f64
  if lt p 1.0e-300f64
    p = 1.0e-300f64
  end
  ret est_log p
end

fn est4_fast_logp pr view Est4Pred quantum f64 anchor f64 y f64 fout edit f64 2 to f64
  kd = est_nearbyint div sub y anchor quantum
  if lt kd -400.0f64
    kd = -400.0f64
  end
  if gt kd 400.0f64
    kd = 400.0f64
  end
  k = long kd
  mu = sub get pr loc anchor
  a = est_ninf
  if ne k -400
    a = div sub mul sub kd 0.5f64 quantum mu get pr scale
  end
  b = est_inf
  if ne k 400
    b = div sub mul add kd 0.5f64 quantum mu get pr scale
  end
  plh = new f64 3 0.0
  est4_fast_prob a b get pr nu plh
  ret est4_fast_finish view plh k fout
end

fn est4_time_update s edit Est4State to void
  d = get s d
  x = new f64 3 0.0
  P = new f64 9 0.0
  Am = new f64 9 0.0
  Qm = new f64 9 0.0
  for i ulong d
    put x i get s x i
  end
  for i ulong mul d d
    put P i get s P i
    put Am i get s A i
    put Qm i get s Q i
  end
  est4_prop_step d view Am view Qm x P
  for i ulong d
    put s x i get x i
  end
  for i ulong mul d d
    put s P i get P i
  end
end

fn est4_update_p s edit Est4State PH view f64 3 S1 f64 to void
  d = get s d
  for i ulong d
    base = mul i d
    phi = get PH i
    for j ulong d
      idx = add base j
      dec = div mul phi get PH j S1
      put s P idx sub get s P idx dec
    end
  end
  for i ulong d
    j = add i 1
    while lt j d bound 8
      p1 = add mul i d j
      p2 = add mul j d i
      v = mul 0.5f64 add get s P p1 get s P p2
      put s P p1 v
      put s P p2 v
      j = add j 1
    end
  end
end

fn est4_compute_ph s view Est4State PH edit f64 3 to f64
  d = get s d
  m = f64 0.0
  for i ulong d
    m = add m mul get s H i get s x i
    acc = f64 0.0
    base = mul i d
    for j ulong d
      acc = add acc mul get s P add base j get s H j
    end
    put PH i acc
  end
  ret m
end

fn est4_update_scale s edit Est4State e f64 S1 f64 to void
  e2 = mul e e
  if lt e2 get s r
    e2 = get s r
  end
  lam = get s pv 2
  gn = add mul lam get s g mul sub 1.0f64 lam div e2 S1
  put s g gn
  put s gl add mul EST4_GL_LAMBDA get s gl mul sub 1.0f64 EST4_GL_LAMBDA gn
end

fn est4_update_meas s edit Est4State y f64 to long
  d = get s d
  est4_time_update s
  PH = new f64 3 0.0
  m = est4_compute_ph view s PH
  S1 = get s r
  for i ulong d
    S1 = add S1 mul get s H i get PH i
  end
  if or not gt S1 0.0f64 not est_isfinite S1
    ret EST_ERR_NONFINITE
  end
  e = sub y m
  for i ulong d
    put s x i add get s x i mul div get PH i S1 e
  end
  est4_update_p s view PH S1
  est4_update_scale s e S1
  put s anchor y
  put s gap 0
  for i ulong d
    if not est_isfinite get s x i
      ret EST_ERR_NONFINITE
    end
  end
  ret EST_OK
end

fn est4_update s edit Est4State present ulong y f64 to long
  ok = and ne present 0 est_isfinite y
  put s generation add get s generation 1
  if eq get s has_anchor 0
    if not ok
      ret EST_OK
    end
    est4_first_obs s y
    put s has_anchor 1
    put s anchor y
    put s gap 0
    ret EST_OK
  end
  if not ok
    est4_time_update s
    put s gl add mul EST4_GL_LAMBDA get s gl mul sub 1.0f64 EST4_GL_LAMBDA get s g
    put s gap add get s gap 1
    ret EST_OK
  end
  ret est4_update_meas s y
end

note SPDX-License-Identifier: Apache-2.0
note ESTIMATION-2 protocol v3 discrete predictive layer in pure seeded OM-2 (est_pred.h / est_pred.c).

text EST_DOM_ASSUMPTION "omega.est.assumption.v1"

const EST_BETACF_MAXIT ulong 20000
const EST_BETACF_EPS f64 1.0e-15
const EST_BETACF_FPMIN f64 1.0e-300

note ---- Special functions ----

fn est_betacf_step cdh edit f64 3 aa f64 to f64
  c = get cdh 0
  d = get cdh 1
  d = add 1.0f64 mul aa d
  if lt fabs d EST_BETACF_FPMIN
    d = EST_BETACF_FPMIN
  end
  c = add 1.0f64 div aa c
  if lt fabs c EST_BETACF_FPMIN
    c = EST_BETACF_FPMIN
  end
  d = div 1.0f64 d
  del = mul d c
  put cdh 0 c
  put cdh 1 d
  put cdh 2 mul get cdh 2 del
  ret del
end

fn est_betacf a f64 b f64 x f64 to f64
  cdh = new f64 3 1.0
  d0 = sub 1.0f64 div mul add a b x add a 1.0f64
  if lt fabs d0 EST_BETACF_FPMIN
    d0 = EST_BETACF_FPMIN
  end
  d0 = div 1.0f64 d0
  put cdh 1 d0
  put cdh 2 d0
  m = ulong 1
  while le m EST_BETACF_MAXIT bound 20002
    mf = f64 m
    m2 = mul 2.0f64 mf
    aa = mul mul mf sub b mf x
    aa = div aa mul add sub a 1.0f64 m2 add a m2
    del = est_betacf_step cdh aa
    aa = mul mul neg add a mf add add a b mf x
    aa = div aa mul add a m2 add add a 1.0f64 m2
    del = est_betacf_step cdh aa
    if le fabs sub del 1.0f64 EST_BETACF_EPS
      ret get cdh 2
    end
    m = add m 1
  end
  ret est_nan
end

fn est_betai_xy a f64 b f64 x f64 y f64 to f64
  if or not gt a 0.0f64 or not gt b 0.0f64 or not est_isfinite a not est_isfinite b
    ret est_nan
  end
  if or not and ge x 0.0f64 le x 1.0f64 not and ge y 0.0f64 le y 1.0f64
    ret est_nan
  end
  if eq x 0.0f64
    ret 0.0f64
  end
  if eq y 0.0f64
    ret 1.0f64
  end
  lbt = add sub sub est_lgamma add a b est_lgamma a est_lgamma b add mul a est_log x mul b est_log y
  bt = est_exp lbt
  if lt x div add a 1.0f64 add add a b 2.0f64
    cf = est_betacf a b x
    ret div mul bt cf a
  end
  cf = est_betacf b a y
  ret sub 1.0f64 div mul bt cf b
end

fn est_betai a f64 b f64 x f64 to f64
  if not and ge x 0.0f64 le x 1.0f64
    ret est_nan
  end
  ret est_betai_xy a b x sub 1.0f64 x
end

fn est_t_sf_pos t f64 nu f64 to f64
  if est_isinf t
    ret 0.0f64
  end
  t2 = mul t t
  den = add nu t2
  if not est_isfinite den
    ret 0.0f64
  end
  ret mul 0.5f64 est_betai_xy mul 0.5f64 nu 0.5f64 div nu den div t2 den
end

fn est_t_sf t f64 nu f64 to f64
  if or est_isnan t or est_isnan nu not gt nu 0.0f64
    ret est_nan
  end
  if ge t 0.0f64
    ret est_t_sf_pos t nu
  end
  ret sub 1.0f64 est_t_sf_pos neg t nu
end

fn est_t_cdf t f64 nu f64 to f64
  if or est_isnan t or est_isnan nu not gt nu 0.0f64
    ret est_nan
  end
  ret est_t_sf neg t nu
end

fn est_norm_cdf x f64 to f64
  ret mul 0.5f64 est_erfc mul neg x EST_SQRT1_2
end

fn est_norm_ppf p f64 to f64
  if est_isnan p
    ret est_nan
  end
  if le p 0.0f64
    ret -8.0f64
  end
  if ge p 1.0f64
    ret 8.0f64
  end
  lo = f64 -8.0f64
  hi = f64 8.0f64
  if ge est_norm_cdf lo p
    ret -8.0f64
  end
  if le est_norm_cdf hi p
    ret 8.0f64
  end
  for i ulong 200
    mid = mul 0.5f64 add lo hi
    if or le mid lo ge mid hi
      break
    end
    if lt est_norm_cdf mid p
      lo = mid
    else
      hi = mid
    end
  end
  ret mul 0.5f64 add lo hi
end

note ---- Assumption ----

fn est_fam_nparam f ulong to ulong
  if eq f EST_FAM_GAUSS_KF
    ret 3
  end
  if eq f EST_FAM_HUBER_KF
    ret 4
  end
  if eq f EST_FAM_STUDENT_T
    ret 2
  end
  if eq f EST_FAM_SCALE_MIX
    ret 7
  end
  if eq f EST_FAM_ADAPTIVE_T
    ret 5
  end
  ret 0
end

fn est_pos_fin v f64 to bool
  ret and est_isfinite v gt v 0.0f64
end

fn est_nonneg_fin v f64 to bool
  ret and est_isfinite v ge v 0.0f64
end

fn est_mix_from_assump a view EstAssump mx edit EstMix to long
  kd = get a param 0
  if not or eq kd 1.0f64 or eq kd 2.0f64 eq kd 3.0f64
    ret EST_ERR_DIM
  end
  k = ulong kd
  put mx k k
  for j ulong EST_MIX_MAX
    w = get a param add 1 j
    v = get a param add 4 j
    if ge j k
      if or ne w 0.0f64 ne v 0.0f64
        ret EST_ERR_DIM
      end
      put mx w j 0.0f64
      put mx v j 0.0f64
    else
      put mx w j w
      put mx v j v
    end
  end
  ret est_mix_check view mx
end

fn est_assumption_check_fam a view EstAssump to long
  mx = new EstMix ulong 0 f64 0.0 f64 0.0
  fam = get a family
  if or eq fam EST_FAM_GAUSS_KF eq fam EST_FAM_HUBER_KF
    if not est_nonneg_fin get a param 0
      ret EST_ERR_NOT_PD
    end
    if not est_nonneg_fin get a param 1
      ret EST_ERR_NOT_PD
    end
    if not est_nonneg_fin get a param 2
      ret EST_ERR_NOT_PD
    end
    if not gt add get a param 0 get a param 1 0.0f64
      ret EST_ERR_ENCODING
    end
    if eq fam EST_FAM_HUBER_KF
      if not est_pos_fin get a param 3
        ret EST_ERR_NOT_PD
      end
    end
    ret EST_OK
  end
  if eq fam EST_FAM_STUDENT_T
    if not est_pos_fin get a param 0
      ret EST_ERR_NOT_PD
    end
    if not est_pos_fin get a param 1
      ret EST_ERR_NOT_PD
    end
    ret EST_OK
  end
  if eq fam EST_FAM_SCALE_MIX
    ret est_mix_from_assump a mx
  end
  if eq fam EST_FAM_ADAPTIVE_T
    lam = get a param 0
    if or lt lam 0.0f64 gt lam 1.0f64
      ret EST_ERR_ENCODING
    end
    if not est_pos_fin get a param 1
      ret EST_ERR_NOT_PD
    end
    if not est_pos_fin get a param 2
      ret EST_ERR_NOT_PD
    end
    if not est_pos_fin get a param 3
      ret EST_ERR_NOT_PD
    end
    if not est_pos_fin get a param 4
      ret EST_ERR_NOT_PD
    end
    ret EST_OK
  end
  ret EST_ERR_KIND
end

fn est_assumption_check a view EstAssump to long
  fam = get a family
  np = est_fam_nparam fam
  if eq np 0
    ret EST_ERR_KIND
  end
  u = get a unit
  if or lt u 1 ge u EST_UNIT_MAX
    ret EST_ERR_UNIT
  end
  if not est_isfinite get a quantum
    ret EST_ERR_NONFINITE
  end
  if not est_isfinite get a lo
    ret EST_ERR_NONFINITE
  end
  if not est_isfinite get a hi
    ret EST_ERR_NONFINITE
  end
  for i ulong EST_PRED_NPARAM
    if not est_isfinite get a param i
      ret EST_ERR_NONFINITE
    end
  end
  if not gt get a quantum 0.0f64
    ret EST_ERR_NOT_PD
  end
  if not lt get a lo get a hi
    ret EST_ERR_ENCODING
  end
  if ne get a nparam np
    ret EST_ERR_DIM
  end
  i = np
  while lt i EST_PRED_NPARAM bound 16
    if ne get a param i 0.0f64
      ret EST_ERR_DIM
    end
    i = add i 1
  end
  ret est_assumption_check_fam a
end

fn est_assumption_digest a view EstAssump dst edit uchar 32 to long
  st = est_assumption_check a
  if ne st EST_OK
    ret st
  end
  enc = new uchar 128 0
  o = est_put_u32 enc 0 get a family
  o = est_put_u32 enc o get a unit
  o = est_put_f64_canon enc o get a quantum
  o = est_put_f64_canon enc o get a lo
  o = est_put_f64_canon enc o get a hi
  np = get a nparam
  o = est_put_u32 enc o np
  for i ulong np
    o = est_put_f64_canon enc o get a param i
  end
  est_sha256_domain EST_DOM_ASSUMPTION view enc o dst
  ret EST_OK
end

note ---- Observation classification ----

fn est_pobs_classify_raw a view EstAssump v f64 present ulong to ulong
  if eq present 0
    ret EST_OBS_MISSING
  end
  if not est_isfinite v
    ret EST_OBS_NONFINITE
  end
  if or lt v get a lo gt v get a hi
    ret EST_OBS_OUT_OF_RANGE
  end
  u = div v get a quantum
  if gt fabs sub u est_nearbyint u EST_PRED_GRID_TOL
    ret EST_OBS_OFF_GRID
  end
  ret EST_OBS_OK
end

fn est_pobs_classify a view EstAssump val f64 present ulong ev view uchar 32 dst edit EstPObs to long
  st = est_assumption_check a
  if ne st EST_OK
    ret st
  end
  if est_digest_is_zero ev
    ret EST_ERR_KIND
  end
  put dst val val
  put dst cls est_pobs_classify_raw a val present
  for i ulong 32
    put dst evidence i get ev i
  end
  ret EST_OK
end

note ---- Continuous change law -> discrete PMF ----

fn est_dist_sf_pos kind ulong scale f64 nu f64 mx view EstMix x f64 to f64
  if eq kind 0
    ret mul 0.5f64 est_erfc mul div x scale EST_SQRT1_2
  end
  if eq kind 1
    ret est_t_sf_pos div x scale nu
  end
  s = f64 0.0f64
  for j ulong get mx k
    wj = get mx w j
    if gt wj 0.0f64
      s = add s mul wj mul 0.5f64 est_erfc mul div x fsqrt get mx v j EST_SQRT1_2
    end
  end
  ret s
end

fn est_pmf_from_edges S view f64 800 x view f64 800 dst edit f64 801 to long
  if le get x 0 0.0f64
    put dst 0 get S 0
  else
    put dst 0 sub 1.0f64 get S 0
  end
  if ge get x 799 0.0f64
    put dst 800 get S 799
  else
    put dst 800 sub 1.0f64 get S 799
  end
  for i ulong 799
    idx = add i 1
    a = get x i
    b = get x idx
    m = f64 0.0f64
    if ge a 0.0f64
      m = sub get S i get S idx
    else
      if le b 0.0f64
        m = sub get S idx get S i
      else
        m = sub sub 1.0f64 get S i get S idx
      end
    end
    if gt m 0.0f64
      put dst idx m
    else
      put dst idx 0.0f64
    end
  end
  s = f64 0.0f64
  for i ulong EST_PRED_N
    s = add s get dst i
  end
  if or not gt s 0.0f64 not est_isfinite s
    ret EST_ERR_NONFINITE
  end
  for i ulong EST_PRED_N
    put dst i div get dst i s
  end
  ret EST_OK
end

fn est_pmf_from_dist kind ulong scale f64 nu f64 mx view EstMix mq view f64 2 dst edit f64 801 to long
  mu = get mq 0
  q = get mq 1
  S = new f64 800 0.0f64
  x = new f64 800 0.0f64
  for e ulong 800
    ef = sub f64 e 400.0f64
    put x e sub mul add ef 0.5f64 q mu
  end
  if eq mu 0.0f64
    for j ulong 400
      e = add 400 j
      sv = est_dist_sf_pos kind scale nu mx get x e
      put S e sv
      put S sub 799 e sv
    end
  else
    for e ulong 800
      put S e est_dist_sf_pos kind scale nu mx fabs get x e
    end
  end
  for e ulong 800
    sv = get S e
    if not and ge sv 0.0f64 le sv 1.0f64
      ret EST_ERR_NONFINITE
    end
  end
  ret est_pmf_from_edges view S view x dst
end

note ---- PMF utilities: support, conv_fold, conv_pow, floor ----

fn est_pmf_support p view f64 801 lh edit ulong 2 to void
  l = ulong 0
  h = ulong 800
  while lt l 800 bound 802
    if ne get p l 0.0f64
      break
    end
    l = add l 1
  end
  while gt h l bound 802
    if ne get p h 0.0f64
      break
    end
    h = sub h 1
  end
  put lh 0 l
  put lh 1 h
end

fn est_conv_fold_row ai f64 ii long b view f64 801 blh view ulong 2 dst edit f64 801 to void
  j = sub EST_PRED_K ii
  if lt j long get blh 0
    j = long get blh 0
  end
  j1 = sub add 800 EST_PRED_K ii
  if gt j1 long get blh 1
    j1 = long get blh 1
  end
  while le j j1 bound 805
    t = ulong add j sub ii EST_PRED_K
    addv = mul ai get b ulong j
    put dst t add get dst t addv
    j = add j 1
  end
end

fn est_conv_cum b view f64 801 C edit f64 801 D edit f64 801 to void
  s = f64 0.0
  for j ulong EST_PRED_N
    s = add s get b j
    put C j s
  end
  s = 0.0f64
  for j ulong EST_PRED_N
    idx = sub 800 j
    s = add s get b idx
    put D idx s
  end
end

fn est_conv_fold_edges ai f64 i long C view f64 801 D view f64 801 blh view ulong 2 dst edit f64 801 to void
  bl = long get blh 0
  bh = long get blh 1
  m1 = sub sub EST_PRED_K i 1
  if ge m1 bl
    if gt m1 bh
      m1 = bh
    end
    put dst 0 add get dst 0 mul ai get C ulong m1
  end
  m2 = sub add 801 EST_PRED_K i
  if le m2 bh
    if lt m2 bl
      m2 = bl
    end
    put dst 800 add get dst 800 mul ai get D ulong m2
  end
end

fn est_conv_fold a view f64 801 b view f64 801 dst edit f64 801 to void
  C = new f64 801 0.0
  D = new f64 801 0.0
  alh = new ulong 2 0
  blh = new ulong 2 0
  est_pmf_support a alh
  est_pmf_support b blh
  est_conv_cum b C D
  for i ulong EST_PRED_N
    put dst i 0.0f64
  end
  i = long get alh 0
  ah = long get alh 1
  while le i ah bound 805
    ai = get a ulong i
    if ne ai 0.0f64
      est_conv_fold_edges ai i view C view D view blh dst
      est_conv_fold_row ai i b view blh dst
    end
    i = add i 1
  end
end

fn est_pmf_conv_pow one view f64 801 h ulong dst edit f64 801 to long
  if or lt h 1 gt h EST_PRED_MAX_H
    ret EST_ERR_TIME
  end
  for i ulong EST_PRED_N
    v = get one i
    if or not est_isfinite v lt v 0.0f64
      ret EST_ERR_NONFINITE
    end
  end
  base = new f64 801 0.0
  base2 = new f64 801 0.0
  acc = new f64 801 0.0
  tmp = new f64 801 0.0
  for i ulong EST_PRED_N
    put base i get one i
  end
  have = ulong 0
  r = h
  while gt r 0 bound 64
    if ne and r 1 0
      if eq have 0
        for i ulong EST_PRED_N
          put acc i get base i
        end
        have = 1
      else
        est_conv_fold view acc view base tmp
        for i ulong EST_PRED_N
          put acc i get tmp i
        end
      end
    end
    r = shr r 1
    if eq r 0
      break
    end
    for i ulong EST_PRED_N
      put base2 i get base i
    end
    est_conv_fold view base view base2 tmp
    for i ulong EST_PRED_N
      put base i get tmp i
    end
  end
  for i ulong EST_PRED_N
    put dst i get acc i
  end
  ret EST_OK
end

fn est_pmf_floor pmf edit f64 801 to void
  s = f64 0.0f64
  for i ulong EST_PRED_N
    s = add s get pmf i
  end
  u = div EST_PRED_FLOOR 801.0f64
  omp = sub 1.0f64 EST_PRED_FLOOR
  t = f64 0.0f64
  for i ulong EST_PRED_N
    v = u
    if gt s 0.0f64
      v = add mul omp div get pmf i s u
    end
    put pmf i v
    t = add t v
  end
  for i ulong EST_PRED_N
    put pmf i div get pmf i t
  end
end

note ---- Candidate state machine ----

fn est_bstate_get_assump b view EstBState dst edit uchar 32 to void
  for w ulong 4
    v = get b assumption w
    for j ulong 8
      put dst add mul w 8 j uchar and shr v mul j 8 0xff
    end
  end
end

fn est_bstate_put_assump b edit EstBState src view uchar 32 to void
  for w ulong 4
    v = ulong 0
    for j ulong 8
      v = or v shl ulong get src add mul w 8 j mul j 8
    end
    put b assumption w v
  end
end

fn est_bstate_get_root b view EstBState dst edit uchar 32 to void
  for w ulong 4
    v = get b evidence_root w
    for j ulong 8
      put dst add mul w 8 j uchar and shr v mul j 8 0xff
    end
  end
end

fn est_bstate_put_root b edit EstBState src view uchar 32 to void
  for w ulong 4
    v = ulong 0
    for j ulong 8
      v = or v shl ulong get src add mul w 8 j mul j 8
    end
    put b evidence_root w v
  end
end

fn est_pred_bind a view EstAssump b view EstBState to long
  d = new uchar 32 0
  st = est_assumption_digest a d
  if ne st EST_OK
    ret st
  end
  ba = new uchar 32 0
  est_bstate_get_assump b ba
  if est_digest_eq view d view ba
    ret EST_OK
  end
  ret EST_ERR_MODEL
end

fn est_pred_init a view EstAssump b edit EstBState cache edit f64 801 to long
  d = new uchar 32 0
  st = est_assumption_digest a d
  if ne st EST_OK
    ret st
  end
  est_bstate_put_assump b view d
  for w ulong 4
    put b evidence_root w 0
  end
  put b has_anchor 0
  put b anchor 0.0f64
  put b xhat 0.0f64
  put b P 0.0f64
  put b s2 0.0f64
  put b gap 0
  put b generation 0
  for i ulong 5
    put b cnt i 0
  end
  put b cache_valid 0
  put b cache_key 0.0f64
  put b cache_lo 0
  put b cache_hi 0
  for i ulong EST_PRED_N
    put cache i 0.0f64
  end
  fam = get a family
  if or eq fam EST_FAM_GAUSS_KF eq fam EST_FAM_HUBER_KF
    put b P get a param 2
  end
  if eq fam EST_FAM_ADAPTIVE_T
    s0 = get a param 4
    put b s2 mul s0 s0
  end
  ret EST_OK
end

fn est_pred_persist_params a view EstAssump b view EstBState mx edit EstMix pars edit f64 3 to long
  fam = get a family
  if eq fam EST_FAM_STUDENT_T
    put pars 0 get a param 1
    put pars 1 get a param 0
    put pars 2 get a param 1
    ret 1
  end
  if eq fam EST_FAM_ADAPTIVE_T
    sc = mul get a param 2 fsqrt get b s2
    if not est_pos_fin sc
      ret EST_ERR_NONFINITE
    end
    put pars 0 sc
    put pars 1 get a param 1
    put pars 2 sc
    ret 1
  end
  if eq fam EST_FAM_SCALE_MIX
    st = est_mix_from_assump a mx
    if ne st EST_OK
      ret st
    end
    put pars 0 0.0f64
    put pars 1 0.0f64
    put pars 2 est_mix_total_var view mx
    ret 2
  end
  ret EST_ERR_KIND
end

fn est_pred_refresh_cache a view EstAssump b edit EstBState cache edit f64 801 kind ulong pars view f64 3 mx view EstMix to long
  mq = new f64 2 0.0
  put mq 0 0.0f64
  put mq 1 get a quantum
  st = est_pmf_from_dist kind get pars 0 get pars 1 mx view mq cache
  if ne st EST_OK
    put b cache_valid 0
    ret st
  end
  lh = new ulong 2 0
  est_pmf_support view cache lh
  put b cache_lo sub long get lh 0 EST_PRED_K
  put b cache_hi sub long get lh 1 EST_PRED_K
  put b cache_key get pars 2
  put b cache_valid 1
  ret EST_OK
end

fn est_pred_predict_persist a view EstAssump b edit EstBState cache edit f64 801 H ulong pmf edit f64 801 to long
  mx = new EstMix ulong 0 f64 0.0 f64 0.0
  pars = new f64 3 0.0
  kind = est_pred_persist_params a view b mx pars
  if lt kind 0
    ret kind
  end
  if or eq get b cache_valid 0 ne get b cache_key get pars 2
    st = est_pred_refresh_cache a b cache ulong kind view pars view mx
    if ne st EST_OK
      ret st
    end
  end
  ret est_pmf_conv_pow view cache H pmf
end

fn est_pred_predict_gauss a view EstAssump b view EstBState H ulong pmf edit f64 801 to long
  mx = new EstMix ulong 0 f64 0.0 f64 0.0
  mq = new f64 2 0.0
  var = add get b P mul f64 H get a param 0
  var = add var get a param 1
  sc = fsqrt var
  if not est_pos_fin sc
    ret EST_ERR_NONFINITE
  end
  put mq 0 sub get b xhat get b anchor
  put mq 1 get a quantum
  ret est_pmf_from_dist 0 sc 0.0f64 view mx view mq pmf
end

fn est_pred_predict a view EstAssump b edit EstBState cache edit f64 801 h ulong dst edit EstDPred pmf edit f64 801 to long
  st = est_pred_bind a view b
  if ne st EST_OK
    ret st
  end
  if eq get b has_anchor 0
    ret EST_ERR_STALE
  end
  H = add get b gap h
  if or lt h 1 or lt H 1 gt H EST_PRED_MAX_H
    ret EST_ERR_TIME
  end
  fam = get a family
  if or eq fam EST_FAM_GAUSS_KF eq fam EST_FAM_HUBER_KF
    st = est_pred_predict_gauss a view b H pmf
  else
    st = est_pred_predict_persist a b cache H pmf
  end
  if ne st EST_OK
    ret st
  end
  est_pmf_floor pmf
  gen = add get b generation 1
  put b generation gen
  adig = new uchar 32 0
  est_bstate_get_assump view b adig
  for i ulong 32
    put dst assumption i get adig i
  end
  put dst family fam
  put dst horizon H
  put dst generation gen
  put dst anchor get b anchor
  put dst quantum get a quantum
  ret EST_OK
end

fn est_pred_update_ok a view EstAssump b edit EstBState y f64 to void
  fam = get a family
  if eq get b has_anchor 0
    if or eq fam EST_FAM_GAUSS_KF eq fam EST_FAM_HUBER_KF
      put b xhat y
      put b P get a param 2
    end
  else
    if or eq fam EST_FAM_GAUSS_KF eq fam EST_FAM_HUBER_KF
      Pp = add get b P mul add f64 get b gap 1.0f64 get a param 0
      S = add Pp get a param 1
      K = div Pp S
      e = sub y get b xhat
      if eq fam EST_FAM_HUBER_KF
        c = mul get a param 3 fsqrt S
        if gt e c
          e = c
        else
          if lt e neg c
            e = neg c
          end
        end
      end
      put b xhat add get b xhat mul K e
      Pn = mul sub 1.0f64 K Pp
      if lt Pn 0.0f64
        Pn = 0.0f64
      end
      put b P Pn
    else
      if and eq fam EST_FAM_ADAPTIVE_T eq get b gap 0
        dd = sub y get b anchor
        lam = get a param 0
        fl = get a param 3
        d2 = mul dd dd
        if lt d2 fl
          d2 = fl
        end
        put b s2 add mul lam get b s2 mul sub 1.0f64 lam d2
      end
    end
  end
  put b anchor y
  put b has_anchor 1
  put b gap 0
end

fn est_pred_update a view EstAssump b edit EstBState obs view EstPObs to long
  st = est_pred_bind a view b
  if ne st EST_OK
    ret st
  end
  ev = new uchar 32 0
  for i ulong 32
    put ev i get obs evidence i
  end
  if est_digest_is_zero view ev
    ret EST_ERR_KIND
  end
  ocls = get obs cls
  if ge ocls EST_OBS_CLASSES
    ret EST_ERR_KIND
  end
  pres = ulong 1
  if eq ocls EST_OBS_MISSING
    pres = 0
  end
  cls = est_pobs_classify_raw a get obs val pres
  if ne cls ocls
    ret EST_ERR_KIND
  end
  prev_root = new uchar 32 0
  est_bstate_get_root view b prev_root
  root = new uchar 32 0
  st = est_evidence_root_extend view prev_root view ev root
  if ne st EST_OK
    ret st
  end
  if eq cls EST_OBS_OK
    est_pred_update_ok a b get obs val
  else
    if lt get b gap 0xffffffff
      put b gap add get b gap 1
    end
  end
  put b generation add get b generation 1
  est_bstate_put_root b view root
  put b cnt cls add get b cnt cls 1
  ret EST_OK
end

note ---- Scoring ----

fn est_check_dpred p view EstDPred pmf view f64 801 to long
  if or not est_isfinite get p anchor not est_pos_fin get p quantum
    ret EST_ERR_NONFINITE
  end
  hz = get p horizon
  if or lt hz 1 gt hz EST_PRED_MAX_H
    ret EST_ERR_TIME
  end
  s = f64 0.0f64
  for i ulong EST_PRED_N
    v = get pmf i
    if or not est_isfinite v lt v 0.0f64
      ret EST_ERR_NONFINITE
    end
    s = add s v
  end
  if not gt s 0.0f64
    ret EST_ERR_NONFINITE
  end
  ret EST_OK
end

fn est_dpred_score_ok pmf view f64 801 k long dst edit EstPInnov to void
  idx = ulong add k EST_PRED_K
  below = f64 0.0
  above = f64 0.0
  for i ulong idx
    below = add below get pmf i
  end
  i = ulong 800
  while gt i idx bound 805
    above = add above get pmf i
    i = sub i 1
  end
  pk = get pmf idx
  tot = add add below pk above
  flo = div below tot
  fhi = div add below pk tot
  if gt fhi 1.0f64
    fhi = 1.0f64
  end
  pr = div pk tot
  if lt pr 1.0e-300f64
    pr = 1.0e-300f64
  end
  put dst valid 1
  put dst k k
  put dst F_lo flo
  put dst F_hi fhi
  put dst logp est_log pr
  put dst z est_norm_ppf mul 0.5f64 add flo fhi
end

fn est_dpred_score p view EstDPred pmf view f64 801 obs view EstPObs dst edit EstPInnov to long
  st = est_check_dpred p pmf
  if ne st EST_OK
    ret st
  end
  ocls = get obs cls
  if ge ocls EST_OBS_CLASSES
    ret EST_ERR_KIND
  end
  put dst valid 0
  put dst cls ocls
  put dst k 0
  put dst F_lo 0.0f64
  put dst F_hi 0.0f64
  put dst logp 0.0f64
  put dst z 0.0f64
  if ne ocls EST_OBS_OK
    ret EST_OK
  end
  ov = get obs val
  if not est_isfinite ov
    ret EST_ERR_KIND
  end
  q = get p quantum
  u = div ov q
  if gt fabs sub u est_nearbyint u EST_PRED_GRID_TOL
    ret EST_ERR_KIND
  end
  kd = est_nearbyint div sub ov get p anchor q
  if lt kd -400.0f64
    kd = -400.0f64
  end
  if gt kd 400.0f64
    kd = 400.0f64
  end
  est_dpred_score_ok pmf long kd dst
  ret EST_OK
end

fn est_pred_innov b view EstBState p view EstDPred pmf view f64 801 obs view EstPObs dst edit EstPInnov to long
  ba = new uchar 32 0
  pa = new uchar 32 0
  est_bstate_get_assump b ba
  for i ulong 32
    put pa i get p assumption i
  end
  if not est_digest_eq view ba view pa
    ret EST_ERR_STALE
  end
  if eq get b has_anchor 0
    ret EST_ERR_STALE
  end
  if ne get p generation get b generation
    ret EST_ERR_STALE
  end
  if ne get p horizon add get b gap 1
    ret EST_ERR_STALE
  end
  ret est_dpred_score p pmf obs dst
end

fn est_dpred_width80 p view EstDPred pmf view f64 801 res edit f64 1 to long
  st = est_check_dpred p pmf
  if ne st EST_OK
    ret st
  end
  tot = f64 0.0f64
  for i ulong EST_PRED_N
    tot = add tot get pmf i
  end
  lo = long -1
  hi = long -1
  c = f64 0.0f64
  for i ulong EST_PRED_N
    c = add c div get pmf i tot
    if and lt lo 0 ge c 0.1f64
      lo = long i
    end
    if and lt hi 0 ge c 0.9f64
      hi = long i
      break
    end
  end
  if lt lo 0
    lo = 800
  end
  if lt hi 0
    hi = 800
  end
  put res 0 mul f64 sub hi lo get p quantum
  ret EST_OK
end

note ---- Calibration ----

fn est_calib_init c edit EstCalib to void
  put c n 0
  for i ulong 3
    put c cov i 0.0f64
  end
  for i ulong 10
    put c pit i 0.0f64
  end
  put c logp_sum 0.0f64
  put c width_sum 0.0f64
  put c z_sum 0.0f64
  put c z_sq 0.0f64
  put c z_lag 0.0f64
  put c z_prev 0.0f64
end

fn est_overlap a0 f64 a1 f64 b0 f64 b1 f64 to f64
  lo = a0
  if gt b0 lo
    lo = b0
  end
  hi = a1
  if lt b1 hi
    hi = b1
  end
  if gt hi lo
    ret sub hi lo
  end
  ret 0.0f64
end

fn est_frac_cover flo f64 fhi f64 alpha f64 to f64
  lo = mul 0.5f64 sub 1.0f64 alpha
  hi = mul 0.5f64 add 1.0f64 alpha
  if not gt fhi flo
    if and ge flo lo le flo hi
      ret 1.0f64
    end
    ret 0.0f64
  end
  ret div est_overlap flo fhi lo hi sub fhi flo
end

fn est_calib_add_pit c edit EstCalib flo f64 fhi f64 to void
  span = sub fhi flo
  if gt span 0.0f64
    for j ulong 10
      b0 = div f64 j 10.0f64
      b1 = div f64 add j 1 10.0f64
      ov = div est_overlap flo fhi b0 b1 span
      put c pit j add get c pit j ov
    end
  else
    ji = long est_floor mul flo 10.0f64
    if lt ji 0
      ji = 0
    end
    if gt ji 9
      ji = 9
    end
    put c pit ulong ji add get c pit ulong ji 1.0f64
  end
end

fn est_calib_add c edit EstCalib p view EstDPred pmf view f64 801 iv view EstPInnov to long
  if or ne get iv valid 1 ne get iv cls EST_OBS_OK
    ret EST_ERR_KIND
  end
  flo = get iv F_lo
  fhi = get iv F_hi
  if or not est_isfinite flo not est_isfinite fhi
    ret EST_ERR_NONFINITE
  end
  if or not est_isfinite get iv z not est_isfinite get iv logp
    ret EST_ERR_NONFINITE
  end
  if or lt flo 0.0f64 or gt fhi 1.0f64 lt fhi flo
    ret EST_ERR_ENCODING
  end
  w = new f64 1 0.0
  st = est_dpred_width80 p pmf w
  if ne st EST_OK
    ret st
  end
  put c cov 0 add get c cov 0 est_frac_cover flo fhi 0.50f64
  put c cov 1 add get c cov 1 est_frac_cover flo fhi 0.80f64
  put c cov 2 add get c cov 2 est_frac_cover flo fhi 0.95f64
  est_calib_add_pit c flo fhi
  put c logp_sum add get c logp_sum get iv logp
  put c width_sum add get c width_sum get w 0
  zv = get iv z
  put c z_sum add get c z_sum zv
  put c z_sq add get c z_sq mul zv zv
  if gt get c n 0
    put c z_lag add get c z_lag mul zv get c z_prev
  end
  put c z_prev zv
  put c n add get c n 1
  ret EST_OK
end

fn est_bands_default b edit EstBands to void
  put b cov50 0 0.46f64
  put b cov50 1 0.54f64
  put b cov80 0 0.76f64
  put b cov80 1 0.84f64
  put b cov95 0 0.93f64
  put b cov95 1 0.97f64
  put b pit 0 0.07f64
  put b pit 1 0.13f64
  put b bias_max 0.10f64
  put b lag1_max 0.20f64
  put b min_n 2000
end

fn est_calib_lag1 c view EstCalib to f64
  if lt get c n 2
    ret est_nan
  end
  nf = f64 get c n
  m = div get c z_sum nf
  den = sub div get c z_sq nf mul m m
  if not gt den 0.0f64
    ret 0.0f64
  end
  ret div sub div get c z_lag sub nf 1.0f64 mul m m den
end

note reason_code: 0=calibrated, 1=n, 2=cov50, 3=cov80, 4=cov95, 10+j=pit[j], 20=bias, 21=lag1
fn est_calib_verdict c view EstCalib b view EstBands reason_code edit ulong 1 to ulong
  nc = get c n
  if or lt nc get b min_n eq nc 0
    put reason_code 0 1
    ret EST_NOT_CALIBRATED
  end
  nf = f64 nc
  v = div get c cov 0 nf
  if not and ge v get b cov50 0 le v get b cov50 1
    put reason_code 0 2
    ret EST_NOT_CALIBRATED
  end
  v = div get c cov 1 nf
  if not and ge v get b cov80 0 le v get b cov80 1
    put reason_code 0 3
    ret EST_NOT_CALIBRATED
  end
  v = div get c cov 2 nf
  if not and ge v get b cov95 0 le v get b cov95 1
    put reason_code 0 4
    ret EST_NOT_CALIBRATED
  end
  for j ulong 10
    v = div get c pit j nf
    if not and ge v get b pit 0 le v get b pit 1
      put reason_code 0 add 10 j
      ret EST_NOT_CALIBRATED
    end
  end
  v = div get c z_sum nf
  if not le fabs v get b bias_max
    put reason_code 0 20
    ret EST_NOT_CALIBRATED
  end
  v = est_calib_lag1 c
  if not le fabs v get b lag1_max
    put reason_code 0 21
    ret EST_NOT_CALIBRATED
  end
  put reason_code 0 0
  ret EST_CALIBRATED
end

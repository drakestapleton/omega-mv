note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_blackwell_codegen_pf.c.
note Composes on om/gpu/cg_pf.om.
om2

fn omega_blackwell_codegen_pf_copy_prog ins edit ulong 8192 meta edit ulong 512 to long
  for i ulong 8192
    put ins i 0
  end
  for i ulong 512
    put meta i 0
  end
  rc = cg_pf_copy ins meta
  if ne rc 0
    ret -1
  end
  if or ne get meta 5 0 eq get meta 0 0
    ret -1
  end
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/dual/ (rx_dual.c, rx_dual_bind.c,
note rx_dual_update.c, rx_dual_replay.c): digest/unit/site/consequence checks,
note canonical LE codecs, binary64 price update, freshness classification,
note CSV decimal parser, and replay series measures.
om2

fn dual_fin64 bits ulong to bool
  ret lt and bits 0x7ff0000000000000 0x7ff0000000000000
end

fn dual_unit_ok u ulong to ulong
  if gt u 0
    if lt u 16
      ret 1
    end
  end
  ret 0
end

fn dual_get_u64 src view uchar * pos ulong to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get src add pos i
    v = or v shl b mul i 8
  end
  ret v
end

fn dual_digit_f64 d ulong to f64
  if eq d 0
    ret bitcast f64 ulong 0
  end
  if eq d 1
    ret bitcast f64 ulong 0x3ff0000000000000
  end
  if eq d 2
    ret bitcast f64 ulong 0x4000000000000000
  end
  if eq d 3
    ret bitcast f64 ulong 0x4008000000000000
  end
  if eq d 4
    ret bitcast f64 ulong 0x4010000000000000
  end
  if eq d 5
    ret bitcast f64 ulong 0x4014000000000000
  end
  if eq d 6
    ret bitcast f64 ulong 0x4018000000000000
  end
  if eq d 7
    ret bitcast f64 ulong 0x401c000000000000
  end
  if eq d 8
    ret bitcast f64 ulong 0x4020000000000000
  end
  ret bitcast f64 ulong 0x4022000000000000
end

export fn rx_dual_om_digest_is_zero d view uchar 32 to ulong
  acc = ulong 0
  for i ulong 32
    acc = or acc ulong get d i
  end
  if eq acc 0
    ret 1
  end
  ret 0
end

export fn rx_dual_om_digest_eq a view uchar 32 b view uchar 32 to ulong
  for i ulong 32
    if ne get a i get b i
      ret 0
    end
  end
  ret 1
end

export fn rx_dual_om_unit_valid u ulong to ulong
  ret dual_unit_ok u
end

export fn rx_dual_om_ids_ascending ids view uint * n ulong to ulong
  if le n 1
    ret 1
  end
  i = ulong 1
  while lt i n
    if le get ids i get ids sub i 1
      ret 0
    end
    i = add i 1
  end
  ret 1
end

export fn rx_dual_om_check_site_name name view uchar 32 to ulong
  if eq get name 0 0
    ret 0
  end
  if ne get name 31 0
    ret 0
  end
  seen_nul = ulong 0
  for i ulong 32
    c = ulong get name i
    if eq seen_nul 0
      if eq c 0
        seen_nul = 1
      else
        if lt c 0x21
          ret 0
        end
        if gt c 0x7e
          ret 0
        end
      end
    else
      if ne c 0
        ret 0
      end
    end
  end
  ret 1
end

export fn rx_dual_om_put_u32 dst edit uchar * pos ulong v ulong to void
  for i ulong 4
    put dst add pos i uchar and shr v mul i 8 255
  end
end

export fn rx_dual_om_put_u64 dst edit uchar * pos ulong v ulong to void
  for i ulong 8
    put dst add pos i uchar and shr v mul i 8 255
  end
end

export fn rx_dual_om_put_f64_canon dst edit uchar * pos ulong bits ulong to void
  u = bits
  if eq and bits 0x7fffffffffffffff 0
    u = 0
  end
  for i ulong 8
    put dst add pos i uchar and shr u mul i 8 255
  end
end

export fn rx_dual_om_get_u32 src view uchar * pos ulong to ulong
  v = ulong 0
  for i ulong 4
    b = ulong get src add pos i
    v = or v shl b mul i 8
  end
  ret v
end

export fn rx_dual_om_get_u64 src view uchar * pos ulong to ulong
  ret dual_get_u64 src pos
end

export fn rx_dual_om_consequence_check meta view ulong 2 vals view ulong 4 to ulong
  if eq dual_unit_ok get meta 0 0
    ret 3
  end
  for i ulong 4
    if not dual_fin64 get vals i
      ret 2
    end
  end
  z0 = bitcast f64 ulong 0
  sd = bitcast f64 get vals 1
  if lt sd z0
    ret 6
  end
  hm = get meta 1
  if gt hm 1
    ret 6
  end
  if ne hm 0
    if not gt sd z0
      ret 6
    end
    e = div sub bitcast f64 get vals 2 bitcast f64 get vals 0 sd
    if not dual_fin64 bitcast ulong e
      ret 2
    end
    if not eq e bitcast f64 get vals 3
      ret 6
    end
  else
    if ne bitcast f64 get vals 2 z0
      ret 6
    end
    if ne bitcast f64 get vals 3 z0
      ret 6
    end
  end
  ret 0
end

export fn rx_dual_om_consequence_error pred_b ulong sd_b ulong meas_b ulong to ulong
  if not dual_fin64 sd_b
    ret 0
  end
  z0 = bitcast f64 ulong 0
  sd = bitcast f64 sd_b
  if not gt sd z0
    ret 0
  end
  e = div sub bitcast f64 meas_b bitcast f64 pred_b sd
  ret bitcast ulong e
end

export fn rx_dual_om_unit_from_est u ulong to ulong
  if eq u 1
    ret 12
  end
  if eq u 2
    ret 13
  end
  if eq u 3
    ret 10
  end
  if eq u 4
    ret 11
  end
  if eq u 5
    ret 9
  end
  if eq u 6
    ret 3
  end
  if eq u 7
    ret 14
  end
  if eq u 8
    ret 15
  end
  ret 0
end

export fn rx_dual_om_classify_state flags view ulong 6 to ulong
  if eq get flags 0 0
    ret 5
  end
  in_gen = get flags 1
  now_gen = get flags 2
  if gt in_gen now_gen
    ret 5
  end
  if gt sub now_gen in_gen get flags 3
    ret 2
  end
  if ne get flags 4 0
    ret 2
  end
  bm = get flags 5
  if eq and bm 1 0
    ret 2
  end
  if ne and bm 2 0
    ret 3
  end
  if ne and bm 4 0
    ret 4
  end
  ret 1
end

fn dual_check_step_in p view ulong 9 to ulong
  if not dual_fin64 get p 0
    ret 2
  end
  if not dual_fin64 get p 1
    ret 2
  end
  if not dual_fin64 get p 2
    ret 2
  end
  if not dual_fin64 get p 3
    ret 2
  end
  if not dual_fin64 get p 4
    ret 2
  end
  if not dual_fin64 get p 8
    ret 2
  end
  z0 = bitcast f64 ulong 0
  scale = bitcast f64 get p 4
  if not gt scale z0
    ret 5
  end
  lam = bitcast f64 get p 0
  unc = bitcast f64 get p 2
  lmax = bitcast f64 get p 8
  if lt lam z0
    ret 6
  end
  if lt unc z0
    ret 6
  end
  if not gt lmax z0
    ret 6
  end
  if gt lam lmax
    ret 6
  end
  ret 0
end

fn dual_grad p view ulong 9 to f64
  z0 = bitcast f64 ulong 0
  scale = bitcast f64 get p 4
  pressure = div sub bitcast f64 get p 1 bitcast f64 get p 3 scale
  deadband = div mul bitcast f64 get p 5 bitcast f64 get p 2 scale
  ap = bitcast f64 and bitcast ulong pressure 0x7fffffffffffffff
  if le ap deadband
    ret z0
  end
  if gt pressure z0
    ret sub pressure deadband
  end
  ret add pressure deadband
end

export fn rx_dual_om_step_lambda p view ulong 9 out_b edit ulong 1 to ulong
  st = dual_check_step_in p
  if ne st 0
    ret st
  end
  g = dual_grad p
  one = bitcast f64 ulong 0x3ff0000000000000
  a = mul sub one bitcast f64 get p 6 bitcast f64 get p 0
  b = mul bitcast f64 get p 7 g
  next = add a b
  if not dual_fin64 bitcast ulong next
    ret 2
  end
  z0 = bitcast f64 ulong 0
  if lt next z0
    next = z0
  end
  lmax = bitcast f64 get p 8
  if gt next lmax
    next = lmax
  end
  put out_b 0 bitcast ulong next
  ret 0
end

export fn rx_dual_om_parse_udec p view uchar * n ulong out_b edit ulong 1 to ulong
  if eq n 0
    ret 0
  end
  if gt n 19
    ret 0
  end
  ten = bitcast f64 ulong 0x4024000000000000
  v = bitcast f64 ulong 0
  for i ulong n
    c = ulong get p i
    if lt c 48
      ret 0
    end
    if gt c 57
      ret 0
    end
    v = add mul v ten dual_digit_f64 sub c 48
  end
  put out_b 0 bitcast ulong v
  ret 1
end

export fn rx_dual_om_reversals xbytes view uchar * lo ulong hi ulong to ulong
  if le hi lo
    ret 0
  end
  z0 = bitcast f64 ulong 0
  r = ulong 0
  last = ulong 0
  i = add lo 1
  while lt i hi
    cur = bitcast f64 dual_get_u64 xbytes mul i 8
    prv = bitcast f64 dual_get_u64 xbytes mul sub i 1 8
    d = sub cur prv
    s = ulong 0
    if gt d z0
      s = 1
    else
      if lt d z0
        s = 2
      end
    end
    if ne s 0
      if ne last 0
        if ne s last
          r = add r 1
        end
      end
      last = s
    end
    i = add i 1
  end
  ret r
end

export fn rx_dual_om_peak_to_peak xbytes view uchar * lo ulong hi ulong to ulong
  if le hi lo
    ret 0
  end
  mn = bitcast f64 dual_get_u64 xbytes mul lo 8
  mx = mn
  i = add lo 1
  while lt i hi
    v = bitcast f64 dual_get_u64 xbytes mul i 8
    if lt v mn
      mn = v
    end
    if gt v mx
      mx = v
    end
    i = add i 1
  end
  ret bitcast ulong sub mx mn
end

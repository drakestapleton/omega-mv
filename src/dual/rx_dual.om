note ---- FIPS 180-4 SHA-256 ----
fn dsh_rotr x uint n uint to uint
  ret or shr x n shl x sub uint 32 n
end

fn dsh_init_tbl to void
  if ne get g_dshk 0 0
    ret
  end
  put g_dshk 0 1116352408
  put g_dshk 1 1899447441
  put g_dshk 2 3049323471
  put g_dshk 3 3921009573
  put g_dshk 4 961987163
  put g_dshk 5 1508970993
  put g_dshk 6 2453635748
  put g_dshk 7 2870763221
  put g_dshk 8 3624381080
  put g_dshk 9 310598401
  put g_dshk 10 607225278
  put g_dshk 11 1426881987
  put g_dshk 12 1925078388
  put g_dshk 13 2162078206
  put g_dshk 14 2614888103
  put g_dshk 15 3248222580
  put g_dshk 16 3835390401
  put g_dshk 17 4022224774
  put g_dshk 18 264347078
  put g_dshk 19 604807628
  put g_dshk 20 770255983
  put g_dshk 21 1249150122
  put g_dshk 22 1555081692
  put g_dshk 23 1996064986
  put g_dshk 24 2554220882
  put g_dshk 25 2821834349
  put g_dshk 26 2952996808
  put g_dshk 27 3210313671
  put g_dshk 28 3336571891
  put g_dshk 29 3584528711
  put g_dshk 30 113926993
  put g_dshk 31 338241895
  put g_dshk 32 666307205
  put g_dshk 33 773529912
  put g_dshk 34 1294757372
  put g_dshk 35 1396182291
  put g_dshk 36 1695183700
  put g_dshk 37 1986661051
  put g_dshk 38 2177026350
  put g_dshk 39 2456956037
  put g_dshk 40 2730485921
  put g_dshk 41 2820302411
  put g_dshk 42 3259730800
  put g_dshk 43 3345764771
  put g_dshk 44 3516065817
  put g_dshk 45 3600352804
  put g_dshk 46 4094571909
  put g_dshk 47 275423344
  put g_dshk 48 430227734
  put g_dshk 49 506948616
  put g_dshk 50 659060556
  put g_dshk 51 883997877
  put g_dshk 52 958139571
  put g_dshk 53 1322822218
  put g_dshk 54 1537002063
  put g_dshk 55 1747873779
  put g_dshk 56 1955562222
  put g_dshk 57 2024104815
  put g_dshk 58 2227730452
  put g_dshk 59 2361852424
  put g_dshk 60 2428436474
  put g_dshk 61 2756734187
  put g_dshk 62 3204031479
  put g_dshk 63 3329325298
  put g_dshk 64 1779033703
  put g_dshk 65 3144134277
  put g_dshk 66 1013904242
  put g_dshk 67 2773480762
  put g_dshk 68 1359893119
  put g_dshk 69 2600822924
  put g_dshk 70 528734635
  put g_dshk 71 1541459225
end

fn dsh_load_w to void
  for i ulong 16
    b0 = shl uint get g_dshb mul i 4 uint 24
    b1 = shl uint get g_dshb add mul i 4 1 uint 16
    b2 = shl uint get g_dshb add mul i 4 2 uint 8
    b3 = uint get g_dshb add mul i 4 3
    put g_dshw i or or b0 b1 or b2 b3
  end
  i = ulong 16
  while lt i 64
    x = get g_dshw sub i 15
    s0 = xor xor dsh_rotr x uint 7 dsh_rotr x uint 18 shr x uint 3
    y = get g_dshw sub i 2
    s1 = xor xor dsh_rotr y uint 17 dsh_rotr y uint 19 shr y uint 10
    put g_dshw i add add get g_dshw sub i 16 s0 add get g_dshw sub i 7 s1
    i = add i 1
  end
end

fn dsh_round i ulong to void
  e = get g_dshv 4
  s1 = xor xor dsh_rotr e uint 6 dsh_rotr e uint 11 dsh_rotr e uint 25
  ch = xor and e get g_dshv 5 and not e get g_dshv 6
  t1 = add add add get g_dshv 7 s1 add ch get g_dshk i get g_dshw i
  a = get g_dshv 0
  s0 = xor xor dsh_rotr a uint 2 dsh_rotr a uint 13 dsh_rotr a uint 22
  maj = xor xor and a get g_dshv 1 and a get g_dshv 2 and get g_dshv 1 get g_dshv 2
  t2 = add s0 maj
  put g_dshv 7 get g_dshv 6
  put g_dshv 6 get g_dshv 5
  put g_dshv 5 e
  put g_dshv 4 add get g_dshv 3 t1
  put g_dshv 3 get g_dshv 2
  put g_dshv 2 get g_dshv 1
  put g_dshv 1 a
  put g_dshv 0 add t1 t2
end

fn dsh_block to void
  dsh_load_w
  for i ulong 8
    put g_dshv i get g_dshh i
  end
  for i ulong 64
    dsh_round i
  end
  for i ulong 8
    put g_dshh i add get g_dshh i get g_dshv i
  end
end

fn dsh_init to void
  dsh_init_tbl
  for i ulong 8
    put g_dshh i get g_dshk add i 64
  end
  put g_dshm 0 0
  put g_dshm 1 0
end

fn dsh_byte b uchar to void
  bl = get g_dshm 0
  put g_dshb bl b
  bl = add bl 1
  put g_dshm 1 add get g_dshm 1 1
  if eq bl 64
    dsh_block
    bl = 0
  end
  put g_dshm 0 bl
end

fn dsh_dig off ulong n ulong to void
  for i ulong n
    dsh_byte get g_dig add off i
  end
end

fn dsh_dw n ulong to void
  for i ulong n
    dsh_byte get g_dw i
  end
end

fn dsh_file n ulong to void
  pos = ulong 0
  while lt pos n
    rem_n = sub n pos
    if gt rem_n 65536
      rem_n = 65536
    end
    for j ulong rem_n
      dsh_byte get g_file add pos j
    end
    pos = add pos rem_n
  end
end

fn dsh_txt s view uchar * to void
  n = len s
  for i ulong n
    dsh_byte get s i
  end
end

fn dsh_final off ulong to void
  tot = get g_dshm 1
  bits = mul tot 8
  dsh_byte uchar 128
  while ne get g_dshm 0 56
    dsh_byte uchar 0
  end
  for i ulong 8
    sh = mul sub 7 i 8
    dsh_byte uchar and shr bits sh 255
  end
  for i ulong 8
    w = get g_dshh i
    o = add off mul i 4
    put g_dig o uchar and shr w uint 24 uint 255
    put g_dig add o 1 uchar and shr w uint 16 uint 255
    put g_dig add o 2 uchar and shr w uint 8 uint 255
    put g_dig add o 3 uchar and w uint 255
  end
end

note ---- IEEE-754 & digest helpers ----
fn dl_fin x f64 to bool
  b = bitcast ulong x
  ret lt and b 0x7ff0000000000000 0x7ff0000000000000
end

fn dl_dg_is_zero off ulong to ulong
  acc = ulong 0
  for i ulong 32
    acc = or acc ulong get g_dig add off i
  end
  if eq acc 0
    ret 1
  end
  ret 0
end

fn dl_dg_eq ao ulong bo ulong to ulong
  for i ulong 32
    if ne get g_dig add ao i get g_dig add bo i
      ret 0
    end
  end
  ret 1
end

fn dl_dg_cp doff ulong soff ulong to void
  for i ulong 32
    put g_dig add doff i get g_dig add soff i
  end
end

fn dl_dg_clr doff ulong to void
  for i ulong 32
    put g_dig add doff i uchar 0
  end
end

fn dl_dg_fill doff ulong v uchar to void
  for i ulong 32
    put g_dig add doff i v
  end
end

fn dl_unit_valid u ulong to ulong
  if gt u 0
    if lt u DL_U_MAX
      ret 1
    end
  end
  ret 0
end

note ---- Wire writer / reader over g_dw ----
fn dw_init cap ulong to void
  put g_dws 0 0
  put g_dws 1 0
  put g_dws 2 cap
  put g_dws 3 0
  put g_dw_st 0 DL_OK
end

fn dw_u8 v uchar to void
  pos = get g_dws 0
  cap = get g_dws 2
  if lt pos cap
    put g_dw pos v
  else
    put g_dws 3 1
  end
  put g_dws 0 add pos 1
end

fn dw_u32 v ulong to void
  for i ulong 4
    dw_u8 uchar and shr v mul i 8 255
  end
end

fn dw_u64 v ulong to void
  for i ulong 8
    dw_u8 uchar and shr v mul i 8 255
  end
end

fn dw_i64 v long to void
  dw_u64 bitcast ulong v
end

fn dw_f64 d f64 to void
  b = bitcast ulong d
  if eq and b 0x7fffffffffffffff 0
    b = 0
  end
  dw_u64 b
end

fn dw_bytes off ulong n ulong to void
  for i ulong n
    dw_u8 get g_dig add off i
  end
end

fn dw_hdr k ulong to void
  dw_u8 uchar k
  dw_u8 uchar DL_FMT_VER
end

fn dw_finish to long
  if ne get g_dws 3 0
    ret DL_E_ENC
  end
  put g_dws 1 get g_dws 0
  ret DL_OK
end

fn dr_init n ulong to void
  put g_dws 0 0
  put g_dws 1 n
  put g_dws 2 n
  put g_dws 3 0
  put g_dw_st 0 DL_OK
end

fn dr_fail st long to void
  if eq get g_dw_st 0 DL_OK
    put g_dw_st 0 st
  end
end

fn dr_need n ulong to bool
  if ne get g_dw_st 0 DL_OK
    ret false
  end
  if gt add get g_dws 0 n get g_dws 1
    dr_fail DL_E_ENC
    ret false
  end
  ret true
end

fn dr_u8 to uchar
  if not dr_need 1
    ret uchar 0
  end
  pos = get g_dws 0
  v = get g_dw pos
  put g_dws 0 add pos 1
  ret v
end

fn dr_u32 to ulong
  if not dr_need 4
    ret 0
  end
  pos = get g_dws 0
  v = ulong 0
  for i ulong 4
    v = or v shl ulong get g_dw add pos i mul i 8
  end
  put g_dws 0 add pos 4
  ret v
end

fn dr_u64 to ulong
  if not dr_need 8
    ret 0
  end
  pos = get g_dws 0
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get g_dw add pos i mul i 8
  end
  put g_dws 0 add pos 8
  ret v
end

fn dr_f64 to f64
  ret bitcast f64 dr_u64
end

fn dr_dig off ulong to void
  if not dr_need 32
    dl_dg_clr off
    ret
  end
  pos = get g_dws 0
  for i ulong 32
    put g_dig add off i get g_dw add pos i
  end
  put g_dws 0 add pos 32
end

fn dr_hdr want ulong to void
  k = ulong dr_u8
  v = ulong dr_u8
  if ne get g_dw_st 0 DL_OK
    ret
  end
  if ne k want
    dr_fail DL_E_KIND
    ret
  end
  if ne v DL_FMT_VER
    dr_fail DL_E_ENC
  end
end

fn dr_end to long
  st = get g_dw_st 0
  if ne st DL_OK
    ret st
  end
  if ne get g_dws 0 get g_dws 1
    ret DL_E_ENC
  end
  ret DL_OK
end

fn dl_dom_hash dom view uchar * off ulong to void
  dsh_init
  dsh_txt dom
  dsh_byte uchar 0
  dsh_dw get g_dws 1
  dsh_final off
end

note ---- Minimal EST-0 checks & digests for DUAL-0b binding ----
fn de_unit_ok u ulong to bool
  if gt u 0
    if lt u DL_EST_UNIT_MAX
      ret true
    end
  end
  ret false
end

fn de_cov_get w ulong idx ulong to f64
  if eq w 0
    ret get g_dm_Q idx
  end
  if eq w 1
    ret get g_dm_R idx
  end
  if eq w 2
    ret get g_do_R idx
  end
  if eq w 3
    ret get g_db_P idx
  end
  if eq w 4
    ret get g_dp_P idx
  end
  ret get g_dp_S idx
end

fn dl_fabs x f64 to f64
  if lt x 0.0
    ret sub 0.0 x
  end
  ret x
end

fn dl_fmax a f64 b f64 to f64
  if gt a b
    ret a
  end
  ret b
end

fn de_cov_ok w ulong off ulong n ulong to long
  for i ulong n
    for j ulong n
      v = de_cov_get w add off add mul i n j
      if not dl_fin v
        ret -3
      end
      if gt j i
        v2 = de_cov_get w add off add mul j n i
        diff = dl_fabs sub v v2
        mx = dl_fmax dl_fabs v dl_fabs v2
        if gt diff mul 1e-12 dl_fmax 1.0 mx
          ret -4
        end
      end
    end
  end
  for i ulong n
    d = de_cov_get w add off add mul i n i
    if lt d -1e-12
      ret -5
    end
  end
  ret DL_EST_OK
end

fn de_check_model s ulong to long
  n = get g_dm_n s
  m = get g_dm_m s
  if or eq n 0 gt n DL_EST_MAX_DIM
    ret -2
  end
  if or eq m 0 gt m DL_EST_MAX_DIM
    ret -2
  end
  if ne get g_dm_ek s 1
    ret -7
  end
  if ne get g_dm_mn s 1
    ret -7
  end
  if le get g_dm_st s 0
    ret -12
  end
  for i ulong n
    if not de_unit_ok get g_dm_su add mul s 8 i
      ret -7
    end
  end
  for i ulong m
    if not de_unit_ok get g_dm_ou add mul s 8 i
      ret -7
    end
  end
  bo = mul s 64
  for i ulong mul n n
    if not dl_fin get g_dm_F add bo i
      ret -3
    end
  end
  for i ulong mul m n
    if not dl_fin get g_dm_H add bo i
      ret -3
    end
  end
  st = de_cov_ok 0 bo n
  if ne st 0
    ret st
  end
  ret de_cov_ok 1 bo m
end

fn de_digest_model s ulong doff ulong to long
  st = de_check_model s
  if ne st 0
    ret st
  end
  dw_init DL_ENC_MAX
  dw_u8 uchar 1
  dw_u8 uchar 1
  n = get g_dm_n s
  m = get g_dm_m s
  dw_u32 n
  dw_u32 m
  dw_u32 get g_dm_ek s
  dw_u32 get g_dm_mn s
  dw_i64 get g_dm_st s
  for i ulong n
    dw_u32 get g_dm_su add mul s 8 i
  end
  for i ulong m
    dw_u32 get g_dm_ou add mul s 8 i
  end
  bo = mul s 64
  for i ulong mul n n
    dw_f64 get g_dm_F add bo i
  end
  for i ulong mul n n
    dw_f64 get g_dm_Q add bo i
  end
  for i ulong mul m n
    dw_f64 get g_dm_H add bo i
  end
  for i ulong mul m m
    dw_f64 get g_dm_R add bo i
  end
  _f = dw_finish
  dl_dom_hash t_de_dom_mdl doff
  ret 0
end

fn de_check_obs s ulong to long
  m = get g_do_m s
  if or eq m 0 gt m DL_EST_MAX_DIM
    ret -2
  end
  for i ulong m
    if not de_unit_ok get g_do_u add mul s 8 i
      ret -7
    end
    if not dl_fin get g_do_z add mul s 8 i
      ret -3
    end
  end
  st = de_cov_ok 2 mul s 64 m
  if ne st 0
    ret st
  end
  if eq dl_dg_is_zero add 13504 mul s 32 1
    ret -10
  end
  if eq dl_dg_is_zero add 13568 mul s 32 1
    ret -10
  end
  ret 0
end

fn de_digest_obs s ulong doff ulong to long
  st = de_check_obs s
  if ne st 0
    ret st
  end
  dw_init DL_ENC_MAX
  dw_u8 uchar 2
  dw_u8 uchar 1
  m = get g_do_m s
  dw_u32 m
  for i ulong m
    dw_u32 get g_do_u add mul s 8 i
  end
  for i ulong m
    dw_f64 get g_do_z add mul s 8 i
  end
  bo = mul s 64
  for i ulong mul m m
    dw_f64 get g_do_R add bo i
  end
  dw_i64 get g_do_tn s
  dw_u64 get g_do_sq s
  dw_bytes add 13504 mul s 32 32
  dw_bytes add 13568 mul s 32 32
  _f = dw_finish
  dl_dom_hash t_de_dom_obs doff
  ret 0
end

fn de_check_belief s ulong to long
  n = get g_db_n s
  if or eq n 0 gt n DL_EST_MAX_DIM
    ret -2
  end
  for i ulong n
    if not de_unit_ok get g_db_u add mul s 8 i
      ret -7
    end
    if not dl_fin get g_db_x add mul s 8 i
      ret -3
    end
  end
  st = de_cov_ok 3 mul s 64 n
  if ne st 0
    ret st
  end
  if eq dl_dg_is_zero add 13632 mul s 32 1
    ret -9
  end
  gen = get g_db_gn s
  pz = dl_dg_is_zero add 13696 mul s 32
  if eq gen 0
    if eq pz 0
      ret -8
    end
  else
    if eq pz 1
      ret -8
    end
  end
  ret 0
end

fn de_digest_belief s ulong doff ulong to long
  st = de_check_belief s
  if ne st 0
    ret st
  end
  dw_init DL_ENC_MAX
  dw_u8 uchar 3
  dw_u8 uchar 1
  n = get g_db_n s
  dw_u32 n
  for i ulong n
    dw_u32 get g_db_u add mul s 8 i
  end
  for i ulong n
    dw_f64 get g_db_x add mul s 8 i
  end
  bo = mul s 64
  for i ulong mul n n
    dw_f64 get g_db_P add bo i
  end
  dw_u64 get g_db_gn s
  dw_i64 get g_db_tn s
  dw_bytes add 13632 mul s 32 32
  dw_bytes add 13696 mul s 32 32
  dw_bytes add 13760 mul s 32 32
  _f = dw_finish
  dl_dom_hash t_de_dom_bel doff
  ret 0
end

fn de_check_pred s ulong to long
  n = get g_dp_n s
  m = get g_dp_m s
  if or eq n 0 gt n DL_EST_MAX_DIM
    ret -2
  end
  if or eq m 0 gt m DL_EST_MAX_DIM
    ret -2
  end
  hz = get g_dp_hz s
  if or eq hz 0 gt hz DL_EST_MAX_HORIZON
    ret -12
  end
  if eq dl_dg_is_zero add 13824 mul s 32 1
    ret -8
  end
  if eq dl_dg_is_zero add 13888 mul s 32 1
    ret -9
  end
  for i ulong n
    if not dl_fin get g_dp_x add mul s 8 i
      ret -3
    end
  end
  for i ulong m
    if not dl_fin get g_dp_ym add mul s 8 i
      ret -3
    end
  end
  st = de_cov_ok 4 mul s 64 n
  if ne st 0
    ret st
  end
  st = de_cov_ok 5 mul s 64 m
  if ne st 0
    ret st
  end
  if ne get g_dp_hc s 0
    for i ulong n
      if not dl_fin get g_dp_Bu add mul s 8 i
        ret -3
      end
    end
  end
  ret 0
end

fn de_digest_pred s ulong doff ulong to long
  st = de_check_pred s
  if ne st 0
    ret st
  end
  dw_init DL_ENC_MAX
  dw_u8 uchar 4
  dw_u8 uchar 1
  dw_bytes add 13824 mul s 32 32
  dw_bytes add 13888 mul s 32 32
  dw_u64 get g_dp_hz s
  dw_u64 get g_dp_gn s
  dw_i64 get g_dp_tn s
  n = get g_dp_n s
  m = get g_dp_m s
  dw_u32 n
  dw_u32 m
  dw_u32 get g_dp_hc s
  for i ulong n
    dw_f64 get g_dp_x add mul s 8 i
  end
  bo = mul s 64
  for i ulong mul n n
    dw_f64 get g_dp_P add bo i
  end
  for i ulong m
    dw_f64 get g_dp_ym add mul s 8 i
  end
  for i ulong mul m m
    dw_f64 get g_dp_S add bo i
  end
  for i ulong n
    dw_f64 get g_dp_Bu add mul s 8 i
  end
  _f = dw_finish
  dl_dom_hash t_de_dom_prd doff
  ret 0
end

fn de_evroot_extend ro ulong eo ulong to long
  if eq dl_dg_is_zero eo 1
    ret -10
  end
  dsh_init
  dsh_txt t_de_dom_broot
  dsh_byte uchar 0
  dsh_dig ro 32
  dsh_dig eo 32
  dsh_final 896
  ret 0
end

note ---- DUAL-0a Validation ----
fn dl_ids_asc w ulong off ulong n ulong to bool
  if le n 1
    ret true
  end
  i = ulong 1
  while lt i n
    a = ulong 0
    b = ulong 0
    if eq w 0
      a = get g_ct_rid add off i
      b = get g_ct_rid add off sub i 1
    else
      a = get g_pv_rid add off i
      b = get g_pv_rid add off sub i 1
    end
    if le a b
      ret false
    end
    i = add i 1
  end
  ret true
end

fn dl_check_resource s ulong to long
  if eq dl_unit_valid get g_rs_u s 0
    ret DL_E_UNIT
  end
  sc = get g_rs_sc s
  if not dl_fin sc
    ret DL_E_NONFIN
  end
  if not gt sc 0.0
    ret DL_E_SCALE
  end
  if eq dl_dg_is_zero add 1024 mul s 32 1
    ret DL_E_DIG
  end
  ret DL_OK
end

fn dl_check_con_digs s ulong to long
  off = mul s 32
  if eq dl_dg_is_zero add 2304 off 1
    ret DL_E_DIG
  end
  if eq dl_dg_is_zero add 2816 off 1
    ret DL_E_DIG
  end
  if eq dl_dg_is_zero add 3328 off 1
    ret DL_E_DIG
  end
  if eq dl_dg_is_zero add 3584 off 1
    ret DL_E_DIG
  end
  if eq get g_cs_ek s DL_EK_MEAS
    if eq dl_dg_is_zero add 2560 off 1
      ret DL_E_DIG
    end
  end
  if eq dl_dg_is_zero add 3072 off 1
    if eq get g_cs_ls s DL_LS_FRESH
      ret DL_E_CAL
    end
  end
  tk = get g_cs_tk s
  pz = dl_dg_is_zero add 3840 off
  if eq tk 0
    if eq pz 0
      ret DL_E_DIG
    end
  else
    if eq pz 1
      ret DL_E_DIG
    end
  end
  ret DL_OK
end

fn dl_check_constraint s ulong to long
  if eq dl_unit_valid get g_cs_u s 0
    ret DL_E_UNIT
  end
  cls = get g_cs_cls s
  if and ne cls DL_CLS_CAP ne cls DL_CLS_SOFT
    ret DL_E_CLASS
  end
  if or not dl_fin get g_cs_bgt s not dl_fin get g_cs_est s
    ret DL_E_NONFIN
  end
  if or not dl_fin get g_cs_unc s not dl_fin get g_cs_lam s
    ret DL_E_NONFIN
  end
  if or lt get g_cs_unc s 0.0 lt get g_cs_lam s 0.0
    ret DL_E_RANGE
  end
  ek = get g_cs_ek s
  if or lt ek 1 ge ek DL_EK_MAX
    ret DL_E_KIND
  end
  ls = get g_cs_ls s
  if or lt ls 1 ge ls DL_LS_MAX
    ret DL_E_RANGE
  end
  ret dl_check_con_digs s
end

fn dl_check_constraint_against cs ulong rs ulong to long
  st = dl_check_constraint cs
  if ne st DL_OK
    ret st
  end
  st = dl_check_resource rs
  if ne st DL_OK
    ret st
  end
  if ne get g_cs_id cs get g_rs_id rs
    ret DL_E_RES
  end
  if ne get g_cs_u cs get g_rs_u rs
    ret DL_E_UNIT
  end
  ret DL_OK
end

fn dl_check_controller s ulong to long
  eta = get g_ct_eta s
  rho = get g_ct_rho s
  ks = get g_ct_ks s
  if or not dl_fin eta or not dl_fin rho not dl_fin ks
    ret DL_E_NONFIN
  end
  if or lt eta 0.0 or lt rho 0.0 or gt rho 1.0 lt ks 0.0
    ret DL_E_RANGE
  end
  if or eq get g_ct_age s 0 eq get g_ct_cad s 0
    ret DL_E_RANGE
  end
  n = get g_ct_n s
  if or eq n 0 gt n DL_MAX_RES
    ret DL_E_RANGE
  end
  bo = mul s 32
  if not dl_ids_asc 0 bo n
    ret DL_E_RES
  end
  for i ulong n
    lm = get g_ct_lm add bo i
    if not dl_fin lm
      ret DL_E_NONFIN
    end
    if not gt lm 0.0
      ret DL_E_RANGE
    end
  end
  ret DL_OK
end

fn dl_ctl_lambda_max s ulong rid ulong to long
  st = dl_check_controller s
  if ne st DL_OK
    ret st
  end
  n = get g_ct_n s
  bo = mul s 32
  for i ulong n
    if eq get g_ct_rid add bo i rid
      put g_dla 0 get g_ct_lm add bo i
      ret DL_OK
    end
  end
  ret DL_E_RES
end

fn dl_check_pv s ulong to long
  if eq dl_dg_is_zero add 4096 mul s 32 1
    ret DL_E_DIG
  end
  n = get g_pv_n s
  if or eq n 0 gt n DL_MAX_RES
    ret DL_E_RANGE
  end
  bo = mul s 32
  if not dl_ids_asc 1 bo n
    ret DL_E_RES
  end
  sbo = mul s 1024
  for i ulong n
    if eq dl_dg_is_zero add 4224 add sbo mul i 32 1
      ret DL_E_DIG
    end
  end
  ret DL_OK
end

fn dl_check_site_name off ulong to bool
  if eq get g_dig add 8320 off 0
    ret false
  end
  if ne get g_dig add 8320 add off 31 0
    ret false
  end
  seen = ulong 0
  for i ulong 32
    c = ulong get g_dig add 8320 add off i
    if eq seen 0
      if eq c 0
        seen = 1
      else
        if or lt c 33 gt c 126
          ret false
        end
      end
    else
      if ne c 0
        ret false
      end
    end
  end
  ret true
end

fn dl_check_site s ulong to long
  if not dl_check_site_name mul s 32
    ret DL_E_SITE
  end
  if eq dl_dg_is_zero add 8448 mul s 32 1
    ret DL_E_DIG
  end
  ma = get g_st_ma s
  if or eq ma 0 gt ma DL_MAX_CAND
    ret DL_E_RANGE
  end
  ret DL_OK
end

fn dl_check_conseq_vals u ulong hm ulong pr f64 sd f64 ms f64 er f64 to long
  if eq dl_unit_valid u 0
    ret DL_E_UNIT
  end
  if not dl_fin pr
    ret DL_E_NONFIN
  end
  if not dl_fin sd
    ret DL_E_NONFIN
  end
  if not dl_fin ms
    ret DL_E_NONFIN
  end
  if not dl_fin er
    ret DL_E_NONFIN
  end
  if lt sd 0.0
    ret DL_E_RANGE
  end
  if gt hm 1
    ret DL_E_RANGE
  end
  if ne hm 0
    if not gt sd 0.0
      ret DL_E_RANGE
    end
    want = div sub ms pr sd
    if not dl_fin want
      ret DL_E_NONFIN
    end
    if ne want er
      ret DL_E_RANGE
    end
  else
    if ne ms 0.0
      ret DL_E_RANGE
    end
    if ne er 0.0
      ret DL_E_RANGE
    end
  end
  ret DL_OK
end

fn dl_check_rec_conseq_at idx ulong to long
  u = get g_rc_qu idx
  hm = get g_rc_qhm idx
  pr = get g_rc_qp idx
  sd = get g_rc_qsd idx
  ms = get g_rc_qm idx
  er = get g_rc_qe idx
  ret dl_check_conseq_vals u hm pr sd ms er
end

fn dl_check_rec_conseqs s ulong to long
  nq = get g_rc_nq s
  if gt nq DL_MAX_RES
    ret DL_E_RANGE
  end
  bo = mul s 32
  for i ulong nq
    idx = add bo i
    st = dl_check_rec_conseq_at idx
    if ne st DL_OK
      ret st
    end
    if gt i 0
      if le get g_rc_qid idx get g_rc_qid sub idx 1
        ret DL_E_RES
      end
    end
  end
  ret DL_OK
end

fn dl_check_rec s ulong to long
  if ne get g_rc_au s DL_AUTH_NONE
    ret DL_E_AUTH
  end
  if or eq dl_dg_is_zero add 8576 mul s 32 1 eq dl_dg_is_zero add 8640 mul s 32 1
    ret DL_E_DIG
  end
  nc = get g_rc_nc s
  if or eq nc 0 gt nc DL_MAX_CAND
    ret DL_E_RANGE
  end
  cbo = mul s 2048
  for i ulong nc
    if eq dl_dg_is_zero add 8704 add cbo mul i 32 1
      ret DL_E_DIG
    end
  end
  if or ge get g_rc_act s nc ge get g_rc_rec s nc
    ret DL_E_RANGE
  end
  ret dl_check_rec_conseqs s
end

fn dl_check_outcome s ulong to long
  off = mul s 32
  if or eq dl_dg_is_zero add 12800 off 1 or eq dl_dg_is_zero add 12864 off 1 eq dl_dg_is_zero add 12928 off 1
    ret DL_E_DIG
  end
  if lt get g_oc_ga s get g_oc_gb s
    ret DL_E_GEN
  end
  if or not dl_fin get g_oc_lb s not dl_fin get g_oc_la s
    ret DL_E_NONFIN
  end
  if or lt get g_oc_lb s 0.0 lt get g_oc_la s 0.0
    ret DL_E_RANGE
  end
  ret DL_OK
end

note ---- Registry ----
fn dl_reg_init to void
  put g_rg_n 0 0
end

fn dl_reg_add rs ulong to long
  st = dl_check_resource rs
  if ne st DL_OK
    ret st
  end
  n = get g_rg_n 0
  rid = get g_rs_id rs
  pos = ulong 0
  while lt pos n
    if lt get g_rg_id pos rid
      pos = add pos 1
    else
      break
    end
  end
  if lt pos n
    if eq get g_rg_id pos rid
      ret DL_E_RES
    end
  end
  if ge n DL_MAX_RES
    ret DL_E_FULL
  end
  i = n
  while gt i pos
    prev = sub i 1
    put g_rg_id i get g_rg_id prev
    put g_rg_u i get g_rg_u prev
    put g_rg_sc i get g_rg_sc prev
    dl_dg_cp add 1280 mul i 32 add 1280 mul prev 32
    i = prev
  end
  put g_rg_id pos rid
  put g_rg_u pos get g_rs_u rs
  put g_rg_sc pos get g_rs_sc rs
  dl_dg_cp add 1280 mul pos 32 add 1024 mul rs 32
  put g_rg_n 0 add n 1
  ret DL_OK
end

fn dl_reg_find rid ulong to long
  n = get g_rg_n 0
  for i ulong n
    if eq get g_rg_id i rid
      ret long i
    end
  end
  ret -1
end

note ---- Encode / Decode / Digest for all 7 DUAL-0a record kinds ----
fn dl_enc_resource s ulong cap ulong to long
  st = dl_check_resource s
  if ne st DL_OK
    ret st
  end
  dw_init cap
  dw_hdr DL_KIND_RES
  dw_u32 get g_rs_id s
  dw_u32 get g_rs_u s
  dw_f64 get g_rs_sc s
  dw_bytes add 1024 mul s 32 32
  ret dw_finish
end

fn dl_dec_resource n ulong s ulong to long
  dr_init n
  dr_hdr DL_KIND_RES
  put g_rs_id s dr_u32
  put g_rs_u s dr_u32
  put g_rs_sc s dr_f64
  dr_dig add 1024 mul s 32
  st = dr_end
  if ne st DL_OK
    ret st
  end
  ret dl_check_resource s
end

fn dl_dig_resource s ulong doff ulong to long
  st = dl_enc_resource s DL_ENC_MAX
  if ne st DL_OK
    ret st
  end
  dl_dom_hash t_dl_dom_res doff
  ret DL_OK
end

fn dl_enc_constraint s ulong cap ulong to long
  st = dl_check_constraint s
  if ne st DL_OK
    ret st
  end
  dw_init cap
  dw_hdr DL_KIND_CON
  off = mul s 32
  dw_u32 get g_cs_id s
  dw_u32 get g_cs_u s
  dw_u32 get g_cs_cls s
  dw_f64 get g_cs_bgt s
  dw_bytes add 2304 off 32
  dw_bytes add 2560 off 32
  dw_bytes add 2816 off 32
  dw_u32 get g_cs_ek s
  dw_f64 get g_cs_est s
  dw_f64 get g_cs_unc s
  dw_bytes add 3072 off 32
  dw_f64 get g_cs_lam s
  dw_u32 get g_cs_ls s
  dw_bytes add 3328 off 32
  dw_u64 get g_cs_gen s
  dw_u64 get g_cs_tk s
  dw_bytes add 3584 off 32
  dw_bytes add 3840 off 32
  ret dw_finish
end

fn dl_dec_constraint n ulong s ulong to long
  dr_init n
  dr_hdr DL_KIND_CON
  off = mul s 32
  put g_cs_id s dr_u32
  put g_cs_u s dr_u32
  put g_cs_cls s dr_u32
  put g_cs_bgt s dr_f64
  dr_dig add 2304 off
  dr_dig add 2560 off
  dr_dig add 2816 off
  put g_cs_ek s dr_u32
  put g_cs_est s dr_f64
  put g_cs_unc s dr_f64
  dr_dig add 3072 off
  put g_cs_lam s dr_f64
  put g_cs_ls s dr_u32
  dr_dig add 3328 off
  put g_cs_gen s dr_u64
  put g_cs_tk s dr_u64
  dr_dig add 3584 off
  dr_dig add 3840 off
  st = dr_end
  if ne st DL_OK
    ret st
  end
  ret dl_check_constraint s
end

fn dl_dig_constraint s ulong doff ulong to long
  st = dl_enc_constraint s DL_ENC_MAX
  if ne st DL_OK
    ret st
  end
  dl_dom_hash t_dl_dom_con doff
  ret DL_OK
end

fn dl_enc_controller s ulong cap ulong to long
  st = dl_check_controller s
  if ne st DL_OK
    ret st
  end
  dw_init cap
  dw_hdr DL_KIND_CTL
  dw_f64 get g_ct_eta s
  dw_f64 get g_ct_rho s
  dw_f64 get g_ct_ks s
  dw_u64 get g_ct_age s
  dw_u64 get g_ct_cad s
  n = get g_ct_n s
  dw_u32 n
  bo = mul s 32
  for i ulong n
    dw_u32 get g_ct_rid add bo i
    dw_f64 get g_ct_lm add bo i
  end
  ret dw_finish
end

fn dl_dec_controller n ulong s ulong to long
  dr_init n
  dr_hdr DL_KIND_CTL
  put g_ct_eta s dr_f64
  put g_ct_rho s dr_f64
  put g_ct_ks s dr_f64
  put g_ct_age s dr_u64
  put g_ct_cad s dr_u64
  cnt = dr_u32
  put g_ct_n s cnt
  if ne get g_dw_st 0 DL_OK
    ret get g_dw_st 0
  end
  if or eq cnt 0 gt cnt DL_MAX_RES
    ret DL_E_RANGE
  end
  bo = mul s 32
  for i ulong cnt
    put g_ct_rid add bo i dr_u32
    put g_ct_lm add bo i dr_f64
  end
  st = dr_end
  if ne st DL_OK
    ret st
  end
  ret dl_check_controller s
end

fn dl_dig_controller s ulong doff ulong to long
  st = dl_enc_controller s DL_ENC_MAX
  if ne st DL_OK
    ret st
  end
  dl_dom_hash t_dl_dom_ctl doff
  ret DL_OK
end

fn dl_enc_pv s ulong cap ulong to long
  st = dl_check_pv s
  if ne st DL_OK
    ret st
  end
  dw_init cap
  dw_hdr DL_KIND_PV
  dw_u64 get g_pv_gen s
  dw_bytes add 4096 mul s 32 32
  n = get g_pv_n s
  dw_u32 n
  bo = mul s 32
  sbo = mul s 1024
  for i ulong n
    dw_u32 get g_pv_rid add bo i
    dw_bytes add 4224 add sbo mul i 32 32
  end
  ret dw_finish
end

fn dl_dec_pv n ulong s ulong to long
  dr_init n
  dr_hdr DL_KIND_PV
  put g_pv_gen s dr_u64
  dr_dig add 4096 mul s 32
  cnt = dr_u32
  put g_pv_n s cnt
  if ne get g_dw_st 0 DL_OK
    ret get g_dw_st 0
  end
  if or eq cnt 0 gt cnt DL_MAX_RES
    ret DL_E_RANGE
  end
  bo = mul s 32
  sbo = mul s 1024
  for i ulong cnt
    put g_pv_rid add bo i dr_u32
    dr_dig add 4224 add sbo mul i 32
  end
  st = dr_end
  if ne st DL_OK
    ret st
  end
  ret dl_check_pv s
end

fn dl_dig_pv s ulong doff ulong to long
  st = dl_enc_pv s DL_ENC_MAX
  if ne st DL_OK
    ret st
  end
  dl_dom_hash t_dl_dom_pv doff
  ret DL_OK
end

fn dl_enc_site s ulong cap ulong to long
  st = dl_check_site s
  if ne st DL_OK
    ret st
  end
  dw_init cap
  dw_hdr DL_KIND_SITE
  dw_u32 get g_st_id s
  dw_bytes add 8320 mul s 32 32
  dw_bytes add 8448 mul s 32 32
  dw_u32 get g_st_ma s
  ret dw_finish
end

fn dl_dec_site n ulong s ulong to long
  dr_init n
  dr_hdr DL_KIND_SITE
  put g_st_id s dr_u32
  dr_dig add 8320 mul s 32
  dr_dig add 8448 mul s 32
  put g_st_ma s dr_u32
  st = dr_end
  if ne st DL_OK
    ret st
  end
  ret dl_check_site s
end

fn dl_dig_site s ulong doff ulong to long
  st = dl_enc_site s DL_ENC_MAX
  if ne st DL_OK
    ret st
  end
  dl_dom_hash t_dl_dom_site doff
  ret DL_OK
end

fn dl_enc_rec s ulong cap ulong to long
  st = dl_check_rec s
  if ne st DL_OK
    ret st
  end
  dw_init cap
  dw_hdr DL_KIND_REC
  dw_bytes add 8576 mul s 32 32
  dw_bytes add 8640 mul s 32 32
  dw_u64 get g_rc_gen s
  nc = get g_rc_nc s
  dw_u32 nc
  cbo = mul s 2048
  for i ulong nc
    dw_bytes add 8704 add cbo mul i 32 32
  end
  dw_u32 get g_rc_act s
  dw_u32 get g_rc_rec s
  nq = get g_rc_nq s
  dw_u32 nq
  qbo = mul s 32
  for i ulong nq
    idx = add qbo i
    dw_u32 get g_rc_qid idx
    dw_u32 get g_rc_qu idx
    dw_f64 get g_rc_qp idx
    dw_f64 get g_rc_qsd idx
    dw_u32 get g_rc_qhm idx
    dw_f64 get g_rc_qm idx
    dw_f64 get g_rc_qe idx
  end
  dw_u32 get g_rc_au s
  ret dw_finish
end

fn dl_dec_rec_tail s ulong to long
  put g_rc_act s dr_u32
  put g_rc_rec s dr_u32
  nq = dr_u32
  put g_rc_nq s nq
  if ne get g_dw_st 0 DL_OK
    ret get g_dw_st 0
  end
  if gt nq DL_MAX_RES
    ret DL_E_RANGE
  end
  qbo = mul s 32
  for i ulong nq
    idx = add qbo i
    put g_rc_qid idx dr_u32
    put g_rc_qu idx dr_u32
    put g_rc_qp idx dr_f64
    put g_rc_qsd idx dr_f64
    put g_rc_qhm idx dr_u32
    put g_rc_qm idx dr_f64
    put g_rc_qe idx dr_f64
  end
  put g_rc_au s dr_u32
  st = dr_end
  if ne st DL_OK
    ret st
  end
  ret dl_check_rec s
end

fn dl_dec_rec n ulong s ulong to long
  dr_init n
  dr_hdr DL_KIND_REC
  dr_dig add 8576 mul s 32
  dr_dig add 8640 mul s 32
  put g_rc_gen s dr_u64
  nc = dr_u32
  put g_rc_nc s nc
  if ne get g_dw_st 0 DL_OK
    ret get g_dw_st 0
  end
  if or eq nc 0 gt nc DL_MAX_CAND
    ret DL_E_RANGE
  end
  cbo = mul s 2048
  for i ulong nc
    dr_dig add 8704 add cbo mul i 32
  end
  ret dl_dec_rec_tail s
end

fn dl_dig_rec s ulong doff ulong to long
  st = dl_enc_rec s DL_ENC_MAX
  if ne st DL_OK
    ret st
  end
  dl_dom_hash t_dl_dom_rec doff
  ret DL_OK
end

fn dl_enc_outcome s ulong cap ulong to long
  st = dl_check_outcome s
  if ne st DL_OK
    ret st
  end
  dw_init cap
  dw_hdr DL_KIND_OUT
  off = mul s 32
  dw_bytes add 12800 off 32
  dw_bytes add 12864 off 32
  dw_bytes add 12928 off 32
  dw_u32 get g_oc_tid s
  dw_u64 get g_oc_gb s
  dw_u64 get g_oc_ga s
  dw_f64 get g_oc_lb s
  dw_f64 get g_oc_la s
  ret dw_finish
end

fn dl_dec_outcome n ulong s ulong to long
  dr_init n
  dr_hdr DL_KIND_OUT
  off = mul s 32
  dr_dig add 12800 off
  dr_dig add 12864 off
  dr_dig add 12928 off
  put g_oc_tid s dr_u32
  put g_oc_gb s dr_u64
  put g_oc_ga s dr_u64
  put g_oc_lb s dr_f64
  put g_oc_la s dr_f64
  st = dr_end
  if ne st DL_OK
    ret st
  end
  ret dl_check_outcome s
end

fn dl_dig_outcome s ulong doff ulong to long
  st = dl_enc_outcome s DL_ENC_MAX
  if ne st DL_OK
    ret st
  end
  dl_dom_hash t_dl_dom_out doff
  ret DL_OK
end

fn dl_pv_build n ulong coff ulong pv ulong to long
  if or eq n 0 gt n DL_MAX_RES
    ret DL_E_RANGE
  end
  if eq dl_dg_is_zero add 0 coff 1
    ret DL_E_DIG
  end
  bo = mul pv 32
  sbo = mul pv 1024
  g0 = ulong 0
  for i ulong n
    cs = get g_sl i
    st = dl_check_constraint cs
    if ne st DL_OK
      ret st
    end
    if eq i 0
      g0 = get g_cs_gen cs
    else
      if le get g_cs_id cs get g_cs_id get g_sl sub i 1
        ret DL_E_RES
      end
      if ne get g_cs_gen cs g0
        ret DL_E_GEN
      end
    end
    put g_pv_rid add bo i get g_cs_id cs
    st = dl_dig_constraint cs add 4224 add sbo mul i 32
    if ne st DL_OK
      ret st
    end
  end
  put g_pv_n pv n
  put g_pv_gen pv g0
  dl_dg_cp add 4096 mul pv 32 add 0 coff
  ret dl_check_pv pv
end

fn dl_conseq_set rid ulong u ulong pr f64 sd f64 hm ulong ms f64 to long
  put g_cq_id 0 rid
  put g_cq_u 0 u
  put g_cq_p 0 pr
  put g_cq_sd 0 sd
  if ne hm 0
    put g_cq_hm 0 1
    put g_cq_m 0 ms
    if and dl_fin sd gt sd 0.0
      put g_cq_e 0 div sub ms pr sd
    else
      put g_cq_e 0 0.0
    end
  else
    put g_cq_hm 0 0
    put g_cq_m 0 0.0
    put g_cq_e 0 0.0
  end
  u0 = get g_cq_u 0
  hm0 = get g_cq_hm 0
  p0 = get g_cq_p 0
  sd0 = get g_cq_sd 0
  m0 = get g_cq_m 0
  e0 = get g_cq_e 0
  ret dl_check_conseq_vals u0 hm0 p0 sd0 m0 e0
end

note ---- DUAL-0b Binding & Freshness Classification ----
fn dl_unit_from_est u ulong to ulong
  if eq u 1
    ret DL_U_MC
  end
  if eq u 2
    ret DL_U_MCPS
  end
  if eq u 3
    ret DL_U_WATT
  end
  if eq u 4
    ret DL_U_WPS
  end
  if eq u 5
    ret DL_U_NS
  end
  if eq u 6
    ret DL_U_BYTES
  end
  if eq u 7
    ret DL_U_DIMLESS
  end
  if eq u 8
    ret DL_U_LOG2PS
  end
  ret DL_U_NONE
end

fn dl_in_clr s ulong to void
  off = mul s 32
  dl_dg_clr add 12992 off
  dl_dg_clr add 13120 off
  dl_dg_clr add 13248 off
  dl_dg_clr add 13376 off
  put g_in_ek s 0
  put g_in_u s 0
  put g_in_est s 0.0
  put g_in_unc s 0.0
  put g_in_gen s 0
  put g_in_evv s 0
  put g_in_reg s 0
end

fn dl_check_input s ulong to long
  if eq dl_unit_valid get g_in_u s 0
    ret DL_E_UNIT
  end
  ek = get g_in_ek s
  if or lt ek 1 ge ek DL_EK_MAX
    ret DL_E_KIND
  end
  if or not dl_fin get g_in_est s not dl_fin get g_in_unc s
    ret DL_E_NONFIN
  end
  if lt get g_in_unc s 0.0
    ret DL_E_RANGE
  end
  off = mul s 32
  if or eq dl_dg_is_zero add 12992 off 1 eq dl_dg_is_zero add 13248 off 1
    ret DL_E_DIG
  end
  if eq ek DL_EK_MEAS
    if eq dl_dg_is_zero add 13120 off 1
      ret DL_E_DIG
    end
  end
  if or gt get g_in_evv s 1 gt get g_in_reg s 1
    ret DL_E_RANGE
  end
  ret DL_OK
end

fn dl_bind_belief bs ulong k ulong has_cal ulong cal_slot ulong ins ulong to long
  dl_in_clr ins
  if ne de_check_belief bs DL_EST_OK
    ret DL_E_KIND
  end
  n = get g_db_n bs
  if ge k n
    ret DL_E_RANGE
  end
  if eq dl_dg_is_zero add 13760 mul bs 32 1
    ret DL_E_EVID
  end
  du = dl_unit_from_est get g_db_u add mul bs 8 k
  if eq du DL_U_NONE
    ret DL_E_UNIT
  end
  put g_in_u ins du
  off = mul ins 32
  if ne de_digest_belief bs add 12992 off DL_EST_OK
    ret DL_E_KIND
  end
  put g_in_ek ins DL_EK_EST
  put g_in_est ins get g_db_x add mul bs 8 k
  vr = get g_db_P add mul bs 64 add mul k n k
  if not dl_fin vr
    ret DL_E_NONFIN
  end
  if lt vr 0.0
    ret DL_E_RANGE
  end
  put g_in_unc ins fsqrt vr
  put g_in_gen ins get g_db_gn bs
  dl_dg_cp add 13248 off add 13760 mul bs 32
  if ne has_cal 0
    dl_dg_cp add 13376 off add 0 mul cal_slot 32
  end
  ret dl_check_input ins
end

fn dl_bind_pred_check ps ulong ms ulong bs ulong k ulong to long
  if or ne de_check_pred ps 0 or ne de_check_model ms 0 ne de_check_belief bs 0
    ret DL_E_KIND
  end
  if or ge k get g_dp_n ps ge k get g_dm_n ms
    ret DL_E_RANGE
  end
  if ne de_digest_model ms ulong 640 0
    ret DL_E_DIG
  end
  if eq dl_dg_eq ulong 640 add 13888 mul ps 32 0
    ret DL_E_DIG
  end
  if ne de_digest_belief bs ulong 640 0
    ret DL_E_DIG
  end
  if eq dl_dg_eq ulong 640 add 13824 mul ps 32 0
    ret DL_E_DIG
  end
  if eq dl_dg_is_zero add 13760 mul bs 32 1
    ret DL_E_EVID
  end
  ret DL_OK
end

fn dl_bind_pred_fill ps ulong bs ulong k ulong cal_s ulong ins ulong to long
  off = mul ins 32
  put g_in_ek ins DL_EK_PRED
  put g_in_est ins get g_dp_x add mul ps 8 k
  pn = get g_dp_n ps
  pidx = add mul ps 64 add mul k pn k
  vr = get g_dp_P pidx
  if not dl_fin vr
    ret DL_E_NONFIN
  end
  if lt vr 0.0
    ret DL_E_RANGE
  end
  put g_in_unc ins fsqrt vr
  put g_in_gen ins get g_dp_gn ps
  dl_dg_cp add 13248 off add 13760 mul bs 32
  if lt cal_s 32
    dl_dg_cp add 13376 off mul cal_s 32
  end
  ret dl_check_input ins
end

fn dl_bind_prediction ps ulong ms ulong bs ulong k ulong cal_s ulong ins ulong to long
  dl_in_clr ins
  st = dl_bind_pred_check ps ms bs k
  if ne st DL_OK
    ret st
  end
  du = dl_unit_from_est get g_dm_su add mul ms 8 k
  if eq du DL_U_NONE
    ret DL_E_UNIT
  end
  put g_in_u ins du
  if ne de_digest_pred ps add 12992 mul ins 32 0
    ret DL_E_KIND
  end
  ret dl_bind_pred_fill ps bs k cal_s ins
end

fn dl_bind_obs os ulong k ulong gen ulong has_cal ulong cal_slot ulong ins ulong to long
  dl_in_clr ins
  if ne de_check_obs os 0
    ret DL_E_KIND
  end
  m = get g_do_m os
  if ge k m
    ret DL_E_RANGE
  end
  du = dl_unit_from_est get g_do_u add mul os 8 k
  if eq du DL_U_NONE
    ret DL_E_UNIT
  end
  put g_in_u ins du
  off = mul ins 32
  if ne de_digest_obs os add 12992 off 0
    ret DL_E_KIND
  end
  dl_dg_cp add 13120 off add 12992 off
  put g_in_ek ins DL_EK_MEAS
  put g_in_est ins get g_do_z add mul os 8 k
  vr = get g_do_R add mul os 64 add mul k m k
  if not dl_fin vr
    ret DL_E_NONFIN
  end
  if lt vr 0.0
    ret DL_E_RANGE
  end
  put g_in_unc ins fsqrt vr
  put g_in_gen ins gen
  dl_dg_cp add 13248 off add 13568 mul os 32
  put g_in_evv ins 1
  if ne has_cal 0
    dl_dg_cp add 13376 off add 0 mul cal_slot 32
  end
  ret dl_check_input ins
end

fn dl_verify_belief_ev bs ulong par_slot ulong os ulong ins ulong to long
  if or ne de_check_belief bs 0 ne de_check_obs os 0
    ret DL_E_KIND
  end
  if ne de_digest_belief bs ulong 672 0
    ret DL_E_KIND
  end
  if eq dl_dg_eq ulong 672 add 12992 mul ins 32 0
    ret DL_E_DIG
  end
  if ne de_digest_obs os ulong 704 0
    ret DL_E_KIND
  end
  if ne de_evroot_extend add 0 mul par_slot 32 ulong 704 0
    ret DL_E_EVID
  end
  if eq dl_dg_eq ulong 896 add 13760 mul bs 32 0
    put g_in_evv ins 0
    ret DL_E_EVID
  end
  put g_in_evv ins 1
  ret DL_OK
end

fn dl_classify_input ins ulong has_prev ulong prev ulong ctl ulong now_gen ulong to long
  st = dl_check_controller ctl
  if ne st DL_OK
    ret st
  end
  if ne has_prev 0
    st = dl_check_constraint prev
    if ne st DL_OK
      ret st
    end
    if ne get g_in_u ins get g_cs_u prev
      ret DL_E_UNIT
    end
  end
  if ne dl_check_input ins DL_OK
    put g_dws 3 DL_LS_REFUSED
    ret DL_OK
  end
  ig = get g_in_gen ins
  if gt ig now_gen
    put g_dws 3 DL_LS_REFUSED
    ret DL_OK
  end
  if gt sub now_gen ig get g_ct_age ctl
    put g_dws 3 DL_LS_STALE
    ret DL_OK
  end
  if ne has_prev 0
    if lt ig get g_cs_gen prev
      put g_dws 3 DL_LS_STALE
      ret DL_OK
    end
  end
  if eq get g_in_evv ins 0
    put g_dws 3 DL_LS_STALE
    ret DL_OK
  end
  if ne get g_in_reg ins 0
    put g_dws 3 DL_LS_FROZEN
    ret DL_OK
  end
  if eq dl_dg_is_zero add 13376 mul ins 32 1
    put g_dws 3 DL_LS_UNCAL
    ret DL_OK
  end
  put g_dws 3 DL_LS_FRESH
  ret DL_OK
end

fn dl_ev_extend ro ulong eo ulong to long
  if eq dl_dg_is_zero eo 1
    ret DL_E_DIG
  end
  if ne de_evroot_extend ro eo 0
    ret DL_E_EVID
  end
  ret DL_OK
end

note ---- DUAL-1a Reference Price Update ----
fn dl_step_lambda_core lam f64 est f64 unc f64 bgt f64 sc f64 ctl ulong to long
  lmax = get g_dla 0
  if not dl_fin lam
    ret DL_E_NONFIN
  end
  if not dl_fin est
    ret DL_E_NONFIN
  end
  if not dl_fin unc
    ret DL_E_NONFIN
  end
  if not dl_fin bgt
    ret DL_E_NONFIN
  end
  if not dl_fin sc
    ret DL_E_NONFIN
  end
  if not dl_fin lmax
    ret DL_E_NONFIN
  end
  if not gt sc 0.0
    ret DL_E_SCALE
  end
  if lt unc 0.0
    ret DL_E_RANGE
  end
  if lt lam 0.0
    ret DL_E_RANGE
  end
  if not gt lmax 0.0
    ret DL_E_RANGE
  end
  if gt lam lmax
    ret DL_E_RANGE
  end
  p = div sub est bgt sc
  band = div mul get g_ct_ks ctl unc sc
  if not dl_fin p
    ret DL_E_NONFIN
  end
  if not dl_fin band
    ret DL_E_NONFIN
  end
  g = f64 0.0
  if gt p band
    g = sub p band
  else
    if lt p sub 0.0 band
      g = add p band
    end
  end
  t1 = mul sub 1.0 get g_ct_rho ctl lam
  t2 = mul get g_ct_eta ctl g
  nxt = add t1 t2
  if not dl_fin nxt
    ret DL_E_NONFIN
  end
  if lt nxt 0.0
    nxt = f64 0.0
  end
  if gt nxt lmax
    nxt = lmax
  end
  put g_dla 1 nxt
  ret DL_OK
end

fn dl_step_lambda lam f64 est f64 unc f64 bgt f64 sc f64 ctl ulong to long
  st = dl_check_controller ctl
  if ne st DL_OK
    ret st
  end
  ret dl_step_lambda_core lam est unc bgt sc ctl
end

fn dl_cs_copy dst ulong src ulong to void
  put g_cs_id dst get g_cs_id src
  put g_cs_u dst get g_cs_u src
  put g_cs_cls dst get g_cs_cls src
  put g_cs_bgt dst get g_cs_bgt src
  doff = mul dst 32
  soff = mul src 32
  dl_dg_cp add 2304 doff add 2304 soff
  dl_dg_cp add 2560 doff add 2560 soff
  dl_dg_cp add 2816 doff add 2816 soff
  put g_cs_ek dst get g_cs_ek src
  put g_cs_est dst get g_cs_est src
  put g_cs_unc dst get g_cs_unc src
  dl_dg_cp add 3072 doff add 3072 soff
  put g_cs_lam dst get g_cs_lam src
  put g_cs_ls dst get g_cs_ls src
  dl_dg_cp add 3328 doff add 3328 soff
  put g_cs_gen dst get g_cs_gen src
  put g_cs_tk dst get g_cs_tk src
  dl_dg_cp add 3584 doff add 3584 soff
  dl_dg_cp add 3840 doff add 3840 soff
end

fn dl_cs_take_input dst ulong ins ulong to void
  doff = mul dst 32
  ioff = mul ins 32
  dl_dg_cp add 2560 doff add 13120 ioff
  dl_dg_cp add 2816 doff add 12992 ioff
  put g_cs_ek dst get g_in_ek ins
  put g_cs_est dst get g_in_est ins
  put g_cs_unc dst get g_in_unc ins
  dl_dg_cp add 3072 doff add 13376 ioff
  put g_cs_gen dst get g_in_gen ins
end

fn dl_common_check rs ulong ctl ulong cid_slot ulong to long
  st = dl_check_resource rs
  if ne st DL_OK
    ret st
  end
  st = dl_check_controller ctl
  if ne st DL_OK
    ret st
  end
  st = dl_ctl_lambda_max ctl get g_rs_id rs
  if ne st DL_OK
    ret st
  end
  ret dl_dig_controller ctl add 0 mul cid_slot 32
end

fn dl_init_state_step rs ulong ins ulong ctl ulong dst ulong to long
  est0 = get g_in_est ins
  unc0 = get g_in_unc ins
  bgt0 = get g_cs_bgt dst
  sc0 = get g_rs_sc rs
  st = dl_step_lambda 0.0 est0 unc0 bgt0 sc0 ctl
  if ne st DL_OK
    ret st
  end
  put g_cs_lam dst get g_dla 1
  ret dl_check_constraint dst
end

fn dl_init_state_fill rs ulong cls ulong bc_slot ulong ins ulong ctl ulong dst ulong to long
  ls = get g_dws 3
  doff = mul dst 32
  put g_cs_id dst get g_rs_id rs
  put g_cs_u dst get g_rs_u rs
  put g_cs_cls dst cls
  put g_cs_bgt dst get g_dla 3
  dl_dg_cp add 2304 doff mul bc_slot 32
  dl_cs_take_input dst ins
  dl_dg_cp add 3328 doff ulong 768
  put g_cs_tk dst 0
  dl_dg_clr add 3840 doff
  dl_dg_clr ulong 800
  st = dl_ev_extend ulong 800 add 12992 mul ins 32
  if ne st DL_OK
    ret st
  end
  dl_dg_cp add 3584 doff ulong 896
  put g_cs_lam dst 0.0
  put g_cs_ls dst ls
  if or eq ls DL_LS_FRESH eq ls DL_LS_UNCAL
    ret dl_init_state_step rs ins ctl dst
  end
  ret dl_check_constraint dst
end

fn dl_init_state rs ulong cls ulong bc_slot ulong ins ulong ctl ulong now_gen ulong to long
  dst = get g_dws 0
  st = dl_common_check rs ctl 24
  if ne st DL_OK
    ret st
  end
  if and ne cls DL_CLS_CAP ne cls DL_CLS_SOFT
    ret DL_E_CLASS
  end
  if not dl_fin get g_dla 3
    ret DL_E_NONFIN
  end
  if eq dl_dg_is_zero mul bc_slot 32 1
    ret DL_E_DIG
  end
  st = dl_check_input ins
  if ne st DL_OK
    ret st
  end
  if ne get g_in_u ins get g_rs_u rs
    ret DL_E_UNIT
  end
  st = dl_classify_input ins 0 0 ctl now_gen
  if ne st DL_OK
    ret st
  end
  ret dl_init_state_fill rs cls bc_slot ins ctl dst
end

fn dl_update_step prev ulong rs ulong ins ulong ctl ulong to long
  lam0 = get g_cs_lam prev
  est0 = get g_in_est ins
  unc0 = get g_in_unc ins
  bgt0 = get g_cs_bgt prev
  sc0 = get g_rs_sc rs
  ret dl_step_lambda lam0 est0 unc0 bgt0 sc0 ctl
end

fn dl_update_fill prev ulong rs ulong ins ulong ctl ulong dst ulong to long
  ls = get g_dws 3
  dl_cs_copy dst prev
  doff = mul dst 32
  dl_dg_cp add 3840 doff ulong 800
  put g_cs_tk dst add get g_cs_tk prev 1
  put g_cs_ls dst ls
  if or eq ls DL_LS_FRESH eq ls DL_LS_UNCAL
    if ne get g_in_u ins get g_rs_u rs
      ret DL_E_UNIT
    end
    st = dl_update_step prev rs ins ctl
    if ne st DL_OK
      ret st
    end
    dl_cs_take_input dst ins
    put g_cs_lam dst get g_dla 1
    st = dl_ev_extend add 3584 mul prev 32 add 12992 mul ins 32
    if ne st DL_OK
      ret st
    end
    dl_dg_cp add 3584 doff ulong 896
  end
  ret dl_check_constraint dst
end

fn dl_update prev ulong rs ulong ins ulong ctl ulong now_gen ulong dst ulong to long
  st = dl_common_check rs ctl 24
  if ne st DL_OK
    ret st
  end
  st = dl_check_constraint_against prev rs
  if ne st DL_OK
    ret st
  end
  if eq dl_dg_eq add 3328 mul prev 32 ulong 768 0
    ret DL_E_CTL
  end
  if gt get g_cs_lam prev get g_dla 0
    ret DL_E_RANGE
  end
  st = dl_dig_constraint prev ulong 800
  if ne st DL_OK
    ret st
  end
  st = dl_classify_input ins 1 prev ctl now_gen
  if ne st DL_OK
    ret st
  end
  ret dl_update_fill prev rs ins ctl dst
end

note ---- DUAL-1b Traces, CSV Import, Replay & Measures ----
global g_xs ulong 1

fn dl_xorshift64s to ulong
  x = get g_xs 0
  x = xor x shr x 12
  x = xor x shl x 25
  x = xor x shr x 27
  put g_xs 0 x
  m = or shl ulong 0x2545f491 32 ulong 0x4f6cdd1d
  ret mul x m
end

fn dl_xorshift_unit to f64
  v = shr dl_xorshift64s 11
  ret div f64 v 9007199254740992.0
end

fn dl_check_trace tr ulong to long
  k = get g_tr_k tr
  if or lt k 1 ge k DL_TR_KIND_MAX
    ret DL_E_KIND
  end
  n = get g_tr_n tr
  if or lt n 1 gt n DL_TR_MAX_TICKS
    ret DL_E_RANGE
  end
  bo = mul tr DL_TR_MAX_TICKS
  for i ulong n
    idx = add bo i
    if not dl_fin get g_tr_es idx
      ret DL_E_NONFIN
    end
    if not dl_fin get g_tr_un idx
      ret DL_E_NONFIN
    end
    if lt get g_tr_un idx 0.0
      ret DL_E_RANGE
    end
    if gt get g_tr_cl idx 1
      ret DL_E_RANGE
    end
    if gt get g_tr_ev idx 1
      ret DL_E_RANGE
    end
    if gt get g_tr_rg idx 1
      ret DL_E_RANGE
    end
  end
  ret DL_OK
end

fn dl_enc_trace tr ulong cap ulong to long
  st = dl_check_trace tr
  if ne st DL_OK
    ret st
  end
  n = get g_tr_n tr
  need = add DL_TR_HDR_SZ mul n DL_TR_TICK_SZ
  if lt cap need
    ret DL_E_ENC
  end
  dw_init cap
  dw_hdr DL_KIND_TRACE
  dw_u32 get g_tr_k tr
  dw_u64 get g_tr_sd tr
  dw_u32 n
  bo = mul tr DL_TR_MAX_TICKS
  for i ulong n
    idx = add bo i
    dw_u64 get g_tr_gn idx
    dw_f64 get g_tr_es idx
    dw_f64 get g_tr_un idx
    dw_u32 get g_tr_cl idx
    dw_u32 get g_tr_ev idx
    dw_u32 get g_tr_rg idx
  end
  ret dw_finish
end

fn dl_dec_trace nlen ulong tr ulong to long
  if lt nlen DL_TR_HDR_SZ
    ret DL_E_ENC
  end
  if ne ulong get g_dw 0 DL_KIND_TRACE
    ret DL_E_KIND
  end
  if ne ulong get g_dw 1 DL_FMT_VER
    ret DL_E_ENC
  end
  dr_init nlen
  _k = dr_u8
  _v = dr_u8
  put g_tr_k tr dr_u32
  put g_tr_sd tr dr_u64
  nt = dr_u32
  if or lt nt 1 gt nt DL_TR_MAX_TICKS
    ret DL_E_RANGE
  end
  if ne nlen add DL_TR_HDR_SZ mul nt DL_TR_TICK_SZ
    ret DL_E_ENC
  end
  put g_tr_n tr nt
  bo = mul tr DL_TR_MAX_TICKS
  for i ulong nt
    idx = add bo i
    put g_tr_gn idx dr_u64
    put g_tr_es idx dr_f64
    put g_tr_un idx dr_f64
    put g_tr_cl idx dr_u32
    put g_tr_ev idx dr_u32
    put g_tr_rg idx dr_u32
  end
  ret dl_check_trace tr
end

fn dl_dig_trace tr ulong doff ulong to long
  st = dl_enc_trace tr DL_TR_ENC_MAX
  if ne st DL_OK
    ret st
  end
  dl_dom_hash t_dl_dom_tr doff
  ret DL_OK
end

fn dl_field_eq off ulong n ulong want view uchar * to bool
  if ne n len want
    ret false
  end
  for i ulong n
    if ne get g_file add off i get want i
      ret false
    end
  end
  ret true
end

fn dl_parse_udec off ulong n ulong to bool
  if or eq n 0 gt n 19
    ret false
  end
  v = f64 0.0
  for i ulong n
    c = ulong get g_file add off i
    if or lt c 48 gt c 57
      ret false
    end
    v = add mul v 10.0 f64 sub c 48
  end
  put g_dla 2 v
  ret true
end

global g_csv_f ulong 8

fn dl_csv_split_line i ulong eol ulong to ulong
  fn_cnt = ulong 1
  put g_csv_f 0 i
  k = i
  while lt k eol
    if eq get g_file k 44
      if lt fn_cnt 8
        put g_csv_f fn_cnt add k 1
        fn_cnt = add fn_cnt 1
      end
    end
    k = add k 1
  end
  ret fn_cnt
end

fn dl_csv_append to long
  n = get g_dws 2
  if ge n DL_TR_MAX_TICKS
    ret DL_E_FULL
  end
  v0 = get g_csv_f 2
  v1 = sub get g_csv_f 3 1
  if not dl_parse_udec v0 sub v1 v0
    ret DL_E_ENC
  end
  idx = add get g_dws 3 n
  put g_tr_gn idx add n 1
  put g_tr_es idx get g_dla 2
  put g_tr_un idx 0.0
  put g_tr_cl idx 0
  put g_tr_ev idx 1
  put g_tr_rg idx 0
  put g_dws 2 add n 1
  ret DL_OK
end

fn dl_csv_line i ulong eol ulong cpu view uchar * ev view uchar * to long
  fn_cnt = dl_csv_split_line i eol
  if lt fn_cnt 5
    ret DL_OK
  end
  c0 = get g_csv_f 1
  c1 = sub get g_csv_f 2 1
  if not dl_field_eq c0 sub c1 c0 cpu
    ret DL_OK
  end
  e0 = get g_csv_f 4
  e1 = eol
  if gt fn_cnt 5
    e1 = sub get g_csv_f 5 1
  end
  if not dl_field_eq e0 sub e1 e0 ev
    ret DL_OK
  end
  ret dl_csv_append
end

fn dl_trace_from_csv cpu view uchar * ev view uchar * to long
  tr = get g_dws 0
  nlen = get g_dws 1
  put g_dws 2 0
  put g_dws 3 mul tr DL_TR_MAX_TICKS
  i = ulong 0
  while lt i nlen
    eol = i
    while lt eol nlen
      if eq get g_file eol 10
        break
      end
      eol = add eol 1
    end
    if gt eol i
      if ne get g_file i 35
        st = dl_csv_line i eol cpu ev
        if ne st DL_OK
          ret st
        end
      end
    end
    i = add eol 1
  end
  n = get g_dws 2
  if eq n 0
    ret DL_E_RANGE
  end
  put g_tr_k tr 13
  put g_tr_sd tr 0
  put g_tr_n tr n
  ret dl_check_trace tr
end

fn dl_derive tag view uchar * idx ulong doff ulong to void
  toff = get g_dws 0
  dsh_init
  dsh_txt tag
  dsh_dig add 13952 toff 32
  for j ulong 4
    dsh_byte uchar and shr idx mul j 8 255
  end
  dsh_final doff
end

fn dl_replay_tick tr ulong i ulong rp ulong ctl ulong rs ulong cal_s ulong to long
  tidx = add mul tr DL_TR_MAX_TICKS i
  dl_in_clr 3
  put g_dws 0 mul rp 32
  dl_derive t_dl_tr_eref i ulong 13088
  put g_dws 0 mul rp 32
  dl_derive t_dl_tr_evr 0 ulong 13344
  put g_in_ek 3 DL_EK_EST
  put g_in_u 3 get g_rs_u rs
  put g_in_est 3 get g_tr_es tidx
  put g_in_unc 3 get g_tr_un tidx
  put g_in_gen 3 get g_tr_gn tidx
  put g_in_evv 3 get g_tr_ev tidx
  put g_in_reg 3 get g_tr_rg tidx
  if ne get g_tr_cl tidx 0
    if ge cal_s 32
      ret DL_E_CAL
    end
    if eq dl_dg_is_zero add 0 mul cal_s 32 1
      ret DL_E_CAL
    end
    dl_dg_cp ulong 13472 add 0 mul cal_s 32
  end
  ret DL_OK
end

fn dl_replay_finish rp ulong nt ulong to void
  put g_rp_n rp nt
  dsh_init
  dsh_txt t_dl_dom_rep
  dsh_byte uchar 0
  dsh_dig add 14016 mul rp 32 32
  dsh_dig add 13952 mul rp 32 32
  for j ulong 4
    dsh_byte uchar and shr nt mul j 8 255
  end
  rbo = mul rp 65536
  for i ulong nt
    dsh_dig add 16384 add rbo mul i 32 32
  end
  dsh_final add 14080 mul rp 32
end

note Replay config: g_rp_cfg = [cls, bc_slot, has_cal, cal_slot], g_rp_bgt[0] = budget
global g_rp_cfg ulong 4
global g_rp_bgt f64 1

fn dl_replay_step tr ulong i ulong rp ulong ctl ulong rs ulong to long
  cal_arg = ulong 99
  if ne get g_rp_cfg 2 0
    cal_arg = get g_rp_cfg 3
  end
  st = dl_replay_tick tr i rp ctl rs cal_arg
  if ne st DL_OK
    ret st
  end
  tidx = add mul tr DL_TR_MAX_TICKS i
  if eq i 0
    put g_dla 3 get g_rp_bgt 0
    put g_dws 0 7
    st = dl_init_state rs get g_rp_cfg 0 get g_rp_cfg 1 3 ctl get g_tr_gn tidx
  else
    st = dl_update 6 rs 3 ctl get g_tr_gn tidx 7
  end
  if ne st DL_OK
    ret st
  end
  rbo = mul rp 65536
  st = dl_dig_constraint 7 add 16384 add rbo mul i 32
  if ne st DL_OK
    ret st
  end
  ridx = add mul rp DL_TR_MAX_TICKS i
  put g_rp_lm ridx get g_cs_lam 7
  put g_rp_es ridx get g_cs_est 7
  put g_rp_gn ridx get g_cs_gen 7
  put g_rp_ls ridx get g_cs_ls 7
  dl_cs_copy 6 7
  ret DL_OK
end

fn dl_replay_run tr ulong ctl ulong rs ulong rp ulong to long
  st = dl_check_trace tr
  if ne st DL_OK
    ret st
  end
  st = dl_dig_trace tr add 13952 mul rp 32
  if ne st DL_OK
    ret st
  end
  st = dl_dig_controller ctl add 14016 mul rp 32
  if ne st DL_OK
    ret st
  end
  nt = get g_tr_n tr
  for i ulong nt
    st = dl_replay_step tr i rp ctl rs
    if ne st DL_OK
      ret st
    end
  end
  dl_replay_finish rp nt
  ret DL_OK
end

fn dl_ser_get w ulong idx ulong to f64
  if eq w 0
    ret get g_rp_lm idx
  end
  ret get g_est_arr idx
end

fn dl_reversals w ulong off ulong lo ulong hi ulong to ulong
  if le hi lo
    ret 0
  end
  rev = ulong 0
  prev = long 0
  i = add lo 1
  while lt i hi
    d = sub dl_ser_get w add off i dl_ser_get w add off sub i 1
    sgn = long 0
    if gt d 0.0
      sgn = 1
    else
      if lt d 0.0
        sgn = -1
      end
    end
    if ne sgn 0
      if ne prev 0
        if ne sgn prev
          rev = add rev 1
        end
      end
      prev = sgn
    end
    i = add i 1
  end
  ret rev
end

fn dl_peak_to_peak w ulong off ulong lo ulong hi ulong to f64
  if le hi lo
    ret 0.0
  end
  mn = dl_ser_get w add off lo
  mx = mn
  i = add lo 1
  while lt i hi
    v = dl_ser_get w add off i
    if lt v mn
      mn = v
    end
    if gt v mx
      mx = v
    end
    i = add i 1
  end
  ret sub mx mn
end

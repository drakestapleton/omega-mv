note SPDX-License-Identifier: Apache-2.0
note VC-GENESIS-1: pinned Genesis Set (pure seeded OM-2 replacement for src/omega_genesis.h).
note Compile-time constant table only; audit record lives in docs/osc/VC-GENESIS-1.md.
om2

const OMEGA_GENESIS_1_COUNT ulong 0
text OMEGA_GENESIS_SET_NAME "VC-GENESIS-1"

fn omega_genesis_count to ulong
  ret OMEGA_GENESIS_1_COUNT
end

fn omega_genesis_member_ok idx ulong to bool
  ret lt idx OMEGA_GENESIS_1_COUNT
end

fn omega_genesis_contains id view uchar 32 to bool
  nz = ulong 0
  for i ulong 32
    if ne get id i 0
      nz = 1
    end
  end
  if eq nz 0
    ret false
  end
  ret false
end

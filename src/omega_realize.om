note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_realize.c (realization ID hashing and
note AArch64 f_add_sub / pure_binary code realization).
note Composes on seed/ng/sha256.om and om/aarch64/aarch64_om2.om.
om2

const REAL_PROFILE_V8A_BAREMETAL ulong 1
const REAL_MAX_CODE_BYTES ulong 4096

const REAL_OP_ADD ulong 3
const REAL_OP_SUB ulong 4
const REAL_OP_MUL ulong 5
const REAL_OP_AND ulong 9
const REAL_OP_OR ulong 10

global g_real_has_id ulong 1
global g_real_profile ulong 1
global g_real_entry_off ulong 1
global g_real_code_len ulong 1
global g_real_sem_id uchar 32
global g_real_id uchar 32
global g_real_code uchar 4096

fn real_put_word pos ulong w long to long
  if lt w 0
    ret -1
  end
  if gt add pos 4 REAL_MAX_CODE_BYTES
    ret -1
  end
  wu = ulong w
  put g_real_code pos uchar and wu 255
  put g_real_code add pos 1 uchar and shr wu 8 255
  put g_real_code add pos 2 uchar and shr wu 16 255
  put g_real_code add pos 3 uchar and shr wu 24 255
  ret long add pos 4
end

fn omega_compute_realization_id to long
  clen = get g_real_code_len 0
  if gt clen REAL_MAX_CODE_BYTES
    ret -1
  end
  note Magic "OMG_R0"
  put sh_dat 0 uchar 0x4f
  put sh_dat 1 uchar 0x4d
  put sh_dat 2 uchar 0x47
  put sh_dat 3 uchar 0x5f
  put sh_dat 4 uchar 0x52
  put sh_dat 5 uchar 0x30
  put sh_dat 6 uchar and get g_real_profile 0 255
  for i ulong 32
    put sh_dat add 7 i get g_real_sem_id i
  end
  put sh_dat 39 uchar and shr clen 24 255
  put sh_dat 40 uchar and shr clen 16 255
  put sh_dat 41 uchar and shr clen 8 255
  put sh_dat 42 uchar and clen 255
  for i ulong clen bound 4096
    put sh_dat add 43 i get g_real_code i
  end
  sh_all add 43 clen
  for i ulong 32
    put g_real_id i get sh_dig i
  end
  put g_real_has_id 0 1
  ret 0
end

fn omega_realize_f_add_sub sem_id view uchar * to long
  if lt len sem_id 32
    ret -1
  end
  put g_real_has_id 0 0
  put g_real_profile 0 REAL_PROFILE_V8A_BAREMETAL
  put g_real_entry_off 0 0
  for i ulong 32
    put g_real_sem_id i get sem_id i
  end
  p = real_put_word 0 a64addreg 1 0 0 1
  if lt p 0
    ret -1
  end
  p = real_put_word ulong p a64subreg 1 0 0 2
  if lt p 0
    ret -1
  end
  p = real_put_word ulong p a64ret
  if lt p 0
    ret -1
  end
  put g_real_code_len 0 ulong p
  ret omega_compute_realization_id
end

fn omega_realize_pure_binary opcode ulong sem_id view uchar * to long
  if lt len sem_id 32
    ret -1
  end
  put g_real_has_id 0 0
  put g_real_profile 0 REAL_PROFILE_V8A_BAREMETAL
  put g_real_entry_off 0 0
  for i ulong 32
    put g_real_sem_id i get sem_id i
  end
  w = long -1
  if eq opcode REAL_OP_ADD
    w = a64addreg 1 0 0 1
  end
  if eq opcode REAL_OP_SUB
    w = a64subreg 1 0 0 1
  end
  if eq opcode REAL_OP_MUL
    w = a64mulreg 1 0 0 1
  end
  if eq opcode REAL_OP_AND
    w = a64andreg 1 0 0 1
  end
  if eq opcode REAL_OP_OR
    w = a64orrreg 1 0 0 1
  end
  if lt w 0
    ret -1
  end
  p = real_put_word 0 w
  if lt p 0
    ret -1
  end
  p = real_put_word ulong p a64ret
  if lt p 0
    ret -1
  end
  put g_real_code_len 0 ulong p
  ret omega_compute_realization_id
end

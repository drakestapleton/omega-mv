note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_numeric_provenance.c (52-entry SM121
note opcode provenance fixture table and cross-check verifier against the
note executor patch table and calibrated vecadd baseline).
note Composes on om/gpu/bw_vecadd.om, om/gpu/bw_qmd.om, src/omega_numeric.om.
om2

const PROV_COUNT ulong 52

note Provenance table storage (52 entries, index 0..51; pid = index + 1)
global g_prov_op uint 64
global g_prov_w0 uint 64
global g_prov_w1 uint 64
global g_prov_w2 uint 64
global g_prov_var ulong 64
global g_prov_init ulong 1

fn prov_set idx ulong op uint w0 uint w1 uint w2 uint vlat ulong to void
  put g_prov_op idx op
  put g_prov_w0 idx w0
  put g_prov_w1 idx w1
  put g_prov_w2 idx w2
  put g_prov_var idx vlat
end

fn prov_init_part1 to void
  prov_set 0 uint 0x7221 uint 0x02097221 uint 0x00000005 uint 0x00000000 0
  prov_set 1 uint 0x7221 uint 0x02097221 uint 0x80000005 uint 0x00000000 0
  prov_set 2 uint 0x7220 uint 0x02097220 uint 0x00000005 uint 0x00400000 0
  prov_set 3 uint 0x7223 uint 0x02097223 uint 0x00000005 uint 0x00000001 0
  prov_set 4 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f06000 0
  prov_set 5 uint 0x7208 uint 0x02097208 uint 0x00000005 uint 0x00000000 0
  prov_set 6 uint 0x720b uint 0x0200720b uint 0x000000ff uint 0x03f06000 0
  prov_set 7 uint 0x7208 uint 0x05097208 uint 0x00000002 uint 0x00000000 0
  prov_set 8 uint 0x7209 uint 0x02097209 uint 0x00000005 uint 0x03800000 0
  prov_set 9 uint 0x7209 uint 0x02097209 uint 0x00000005 uint 0x07800000 0
  prov_set 10 uint 0x7245 uint 0x00097245 uint 0x00000002 uint 0x00201400 0
  prov_set 11 uint 0x7305 uint 0x00097305 uint 0x00000002 uint 0x0020f100 1
  prov_set 12 uint 0x7308 uint 0x00097308 uint 0x00000002 uint 0x00001000 1
  prov_set 13 uint 0x7308 uint 0x00097308 uint 0x00000002 uint 0x00001400 1
  prov_set 14 uint 0x7f89 uint 0x02097f89 uint 0x08201f00 uint 0x000e0000 1
  prov_set 15 uint 0x7f89 uint 0x02097f89 uint 0x0a001f00 uint 0x000e0000 1
  prov_set 16 uint 0x7f89 uint 0x02097f89 uint 0x09001f00 uint 0x000e0000 1
  prov_set 17 uint 0x7f89 uint 0x02097f89 uint 0x08801f00 uint 0x000e0000 1
  prov_set 18 uint 0x7f89 uint 0x02097f89 uint 0x08401f00 uint 0x000e0000 1
  prov_set 19 uint 0x7221 uint 0x02027221 uint 0x00000009 uint 0x00000000 0
  prov_set 20 uint 0x7221 uint 0x02097221 uint 0x00000009 uint 0x00000000 0
  prov_set 21 uint 0x7819 uint 0x00087819 uint 0x00000002 uint 0x000006ff 0
  prov_set 22 uint 0x7812 uint 0x080a7812 uint 0x000000fc uint 0x078e3cff 0
  prov_set 23 uint 0x7988 uint 0x08007988 uint 0x00000002 uint 0x080008ff 0
  prov_set 24 uint 0x7b1d uint 0x00007b1d uint 0x00000000 uint 0x00010000 0
  prov_set 25 uint 0x7984 uint 0x0a097984 uint 0x000000ff uint 0x08000800 1
end

fn prov_init_part2 to void
  prov_set 26 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f01000 0
  prov_set 27 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f02000 0
  prov_set 28 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f03000 0
  prov_set 29 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f04000 0
  prov_set 30 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f05000 0
  prov_set 31 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f07000 0
  prov_set 32 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f08000 0
  prov_set 33 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f09000 0
  prov_set 34 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f0a000 0
  prov_set 35 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f0b000 0
  prov_set 36 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f0c000 0
  prov_set 37 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f0d000 0
  prov_set 38 uint 0x720b uint 0x0200720b uint 0x00000005 uint 0x03f0e000 0
  prov_set 39 uint 0x7305 uint 0x00097305 uint 0x00000002 uint 0x00207100 1
  prov_set 40 uint 0x7305 uint 0x00097305 uint 0x00000002 uint 0x0020b100 1
  prov_set 41 uint 0x7305 uint 0x00097305 uint 0x00000002 uint 0x00203100 1
  prov_set 42 uint 0x7305 uint 0x00097305 uint 0x00000002 uint 0x0020f000 1
  prov_set 43 uint 0x7245 uint 0x00097245 uint 0x00000002 uint 0x00201000 0
  prov_set 44 uint 0x7304 uint 0x00097304 uint 0x00000002 uint 0x00200800 1
  prov_set 45 uint 0x7304 uint 0x00097304 uint 0x00000002 uint 0x00202000 1
  prov_set 46 uint 0x7230 uint 0xff097230 uint 0x20000002 uint 0x00004100 0
  prov_set 47 uint 0x7819 uint 0x02097819 uint 0x00000010 uint 0x000006ff 0
  prov_set 48 uint 0x7b82 uint 0xff0a7b82 uint 0x0000e800 uint 0x00000a00 1
  prov_set 49 uint 0x7825 uint 0x090a7825 uint 0x00000004 uint 0x078e000a 0
  prov_set 50 uint 0x7981 uint 0x0a0b7981 uint 0x00000004 uint 0x0c1e1900 1
  prov_set 51 uint 0x7223 uint 0x02097223 uint 0x00000005 uint 0x0000000b 0
end

fn prov_ensure_init to void
  if eq get g_prov_init 0 0
    prov_init_part1
    prov_init_part2
    put g_prov_init 0 1
  end
end

fn omega_numeric_get_opcode_count to ulong
  ret PROV_COUNT
end

fn omega_numeric_get_opcode idx ulong dst edit uint 5 to long
  prov_ensure_init
  if ge idx PROV_COUNT
    ret -1
  end
  put dst 0 get g_prov_op idx
  put dst 1 get g_prov_w0 idx
  put dst 2 get g_prov_w1 idx
  put dst 3 get g_prov_w2 idx
  put dst 4 uint get g_prov_var idx
  ret 0
end

fn prov_read_u32_le buf view uchar 512 off ulong to uint
  b0 = uint get buf off
  b1 = uint get buf add off 1
  b2 = uint get buf add off 2
  b3 = uint get buf add off 3
  ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

global g_prov_stg uint 4
global g_prov_ex uint 4
global g_prov_used ulong 64
global g_prov_pending long 1

fn prov_is_baseline_stg w0 uint w1 uint w2 uint to bool
  if ne w0 get g_prov_stg 0
    ret false
  end
  if ne w1 get g_prov_stg 1
    ret false
  end
  ret eq w2 get g_prov_stg 2
end

fn prov_is_baseline_ex w0 uint w1 uint w2 uint to bool
  if ne w0 get g_prov_ex 0
    ret false
  end
  if ne w1 get g_prov_ex 1
    ret false
  end
  ret eq w2 get g_prov_ex 2
end

fn prov_check_insn t ulong n ulong to long
  problems = long 0
  b = mul t 4
  w0 = get g_num_patch_w b
  w1 = get g_num_patch_w add b 1
  w2 = get g_num_patch_w add b 2
  w3 = get g_num_patch_w add b 3
  pend = get g_prov_pending 0
  if ge pend 0
    if not ctrl_waits w3 uint pend
      problems = add problems 1
    end
    put g_prov_pending 0 -1
  end
  pid = get g_num_patch_prov t
  if eq pid 0
    if not prov_is_baseline_stg w0 w1 w2
      if not prov_is_baseline_ex w0 w1 w2
        problems = add problems 1
      end
    end
    ret problems
  end
  idx = sub pid 1
  if ge idx n
    ret add problems 1
  end
  put g_prov_used idx 1
  if ne get g_prov_w0 idx w0
    problems = add problems 1
  end
  if ne get g_prov_w1 idx w1
    problems = add problems 1
  end
  if ne get g_prov_w2 idx w2
    problems = add problems 1
  end
  if ne get g_prov_var idx 0
    bar = and shr w3 14 uint 7
    if gt bar uint 5
      problems = add problems 1
    else
      put g_prov_pending 0 long bar
    end
  end
  ret problems
end

fn prov_check_one_op op ulong n ulong to long
  problems = long 0
  m = omega_numeric_patch_words op
  if omega_numeric_op_whole_kernel op
    if ne m OMEGA_NUMERIC_ERR_NOT_ENCODED
      problems = add problems 1
    end
    ret problems
  end
  if le m 0
    ret 1
  end
  if not ctrl_waits get g_num_patch_w 3 uint 4
    problems = add problems 1
  end
  put g_prov_pending 0 -1
  for t ulong ulong m bound 15
    problems = add problems prov_check_insn t n
  end
  pend = get g_prov_pending 0
  if ge pend 0
    if eq m 1
      if not ctrl_waits get g_prov_stg 3 uint pend
        problems = add problems 1
      end
    else
      problems = add problems 1
    end
  end
  ret problems
end

fn omega_numeric_verify_fixture_table n ulong to long
  base = new uchar 512 0
  problems = long 0
  if or eq n 0 gt n 64
    ret 1
  end
  for i ulong 64
    put g_prov_used i 0
  end
  for i ulong n bound 64
    op = get g_prov_op i
    w0 = get g_prov_w0 i
    if eq op uint 0
      problems = add problems 1
    else
      if ne op and w0 uint 0xffff
        problems = add problems 1
      end
    end
  end
  if lt bw_encode_vecadd base 0x140
    ret add problems 1
  end
  for j ulong 4
    put g_prov_stg j prov_read_u32_le base add 0x120 mul j 4
    put g_prov_ex j prov_read_u32_le base add 0x130 mul j 4
  end
  for k ulong omega_numeric_op_count bound 64
    problems = add problems prov_check_one_op k n
  end
  for i ulong n bound 64
    if eq get g_prov_used i 0
      problems = add problems 1
    end
  end
  ret problems
end

fn omega_numeric_verify_all_fixtures to long
  prov_ensure_init
  ret omega_numeric_verify_fixture_table PROV_COUNT
end

note
note src/omega_accelerator.om -- pure seeded OM-2 port of src/omega_accelerator.c
note Composes with seed/ng/sha256.om and src/omega_machine.om.
note Exact 64-byte EffectIntent and 192-byte EffectReceipt little-endian layouts.

note Capability fields (OmegaAccelCapability)
global g_ac_cap_slot ulong 1
global g_ac_cap_gen ulong 1
global g_ac_cap_princ ulong 1
global g_ac_cap_rtype ulong 1
global g_ac_cap_ops ulong 1
global g_ac_cap_iova_base ulong 1
global g_ac_cap_iova_size ulong 1
global g_ac_cap_qmask ulong 1
global g_ac_cap_rev ulong 1
global g_ac_cap_prov uchar 32

note Port state (OmegaAccelPort)
global g_ac_win_cnt ulong 1
global g_ac_w_iova ulong 8
global g_ac_w_phys ulong 8
global g_ac_w_size ulong 8
global g_ac_w_perm ulong 8
global g_ac_w_id ulong 8
global g_ac_qid ulong 1
global g_ac_has_q ulong 1
global g_ac_seal uchar 32
global g_ac_reqs ulong 1
global g_ac_rcpts ulong 1
global g_ac_bound ulong 1

fn ac_put_u16le dst edit uchar * off ulong v ulong to void
  put dst off uchar and v 255
  put dst add off 1 uchar and shr v 8 255
end

fn ac_put_u32le dst edit uchar * off ulong v ulong to void
  put dst off uchar and v 255
  put dst add off 1 uchar and shr v 8 255
  put dst add off 2 uchar and shr v 16 255
  put dst add off 3 uchar and shr v 24 255
end

fn ac_put_u64le dst edit uchar * off ulong v ulong to void
  ac_put_u32le dst off and v 4294967295
  ac_put_u32le dst add off 4 shr v 32
end

fn ac_get_u32le src view uchar * off ulong to ulong
  b0 = ulong get src off
  b1 = ulong get src add off 1
  b2 = ulong get src add off 2
  b3 = ulong get src add off 3
  r = or b0 shl b1 8
  r = or r shl b2 16
  ret or r shl b3 24
end

fn ac_get_u64le src view uchar * off ulong to ulong
  lo = ac_get_u32le src off
  hi = ac_get_u32le src add off 4
  ret or lo shl hi 32
end

fn omega_accel_cap_set_a p0 ulong p1 ulong p2 ulong p3 ulong p4 ulong to void
  put g_ac_cap_slot 0 p0
  put g_ac_cap_gen 0 p1
  put g_ac_cap_princ 0 p2
  put g_ac_cap_rtype 0 p3
  put g_ac_cap_ops 0 p4
end

fn omega_accel_cap_set_b iova_base ulong iova_size ulong qmask ulong rev ulong to void
  put g_ac_cap_iova_base 0 iova_base
  put g_ac_cap_iova_size 0 iova_size
  put g_ac_cap_qmask 0 qmask
  put g_ac_cap_rev 0 rev
end

fn omega_accel_port_init prov view uchar 32 to long
  for i ulong 32
    put g_ac_cap_prov i get prov i
    put g_ac_seal i 0
  end
  put g_ac_win_cnt 0 0
  for i ulong 8
    put g_ac_w_iova i 0
    put g_ac_w_phys i 0
    put g_ac_w_size i 0
    put g_ac_w_perm i 0
    put g_ac_w_id i 0
  end
  put g_ac_qid 0 0
  put g_ac_has_q 0 0
  put g_ac_reqs 0 0
  put g_ac_rcpts 0 0
  put g_ac_bound 0 1
  ret 0
end

fn omega_accel_port_build_dma_intent iova_base ulong phys_base ulong size_bytes ulong perms ulong out_intent edit uchar 64 to long
  if eq size_bytes 0
    ret neg long 1
  end
  cbase = get g_ac_cap_iova_base 0
  csize = get g_ac_cap_iova_size 0
  if lt iova_base cbase
    ret neg long 2
  end
  if gt add iova_base size_bytes add cbase csize
    ret neg long 2
  end
  for i ulong 64
    put out_intent i 0
  end
  ac_put_u16le out_intent 0 1
  ac_put_u16le out_intent 2 64
  ac_put_u32le out_intent 4 0
  ac_put_u64le out_intent 8 add 1001 get g_ac_reqs 0
  ac_put_u64le out_intent 16 get g_ac_cap_princ 0
  ac_put_u32le out_intent 24 get g_ac_cap_slot 0
  ac_put_u32le out_intent 28 get g_ac_cap_gen 0
  ac_put_u32le out_intent 32 5
  ac_put_u32le out_intent 36 2
  ac_put_u64le out_intent 40 iova_base
  ac_put_u64le out_intent 48 size_bytes
  ac_put_u64le out_intent 56 phys_base
  ign = perms
  ret 0
end

fn omega_accel_port_build_submit_intent queue_id ulong cmd_iova ulong cmd_len ulong out_intent edit uchar 64 to long
  if eq cmd_len 0
    ret neg long 1
  end
  for i ulong 64
    put out_intent i 0
  end
  ac_put_u16le out_intent 0 1
  ac_put_u16le out_intent 2 64
  ac_put_u32le out_intent 4 0
  ac_put_u64le out_intent 8 add 2001 get g_ac_reqs 0
  ac_put_u64le out_intent 16 get g_ac_cap_princ 0
  ac_put_u32le out_intent 24 get g_ac_cap_slot 0
  ac_put_u32le out_intent 28 get g_ac_cap_gen 0
  ac_put_u32le out_intent 32 5
  ac_put_u32le out_intent 36 16
  ac_put_u64le out_intent 40 queue_id
  ac_put_u64le out_intent 48 cmd_len
  ac_put_u64le out_intent 56 cmd_iova
  ret 0
end

fn omega_accel_port_verify_receipt has_intent ulong intent view uchar 64 receipt view uchar 192 to long
  dec = ac_get_u32le receipt 4
  if ne dec 1
    ret neg long 2
  end
  if ne has_intent 0
    for i ulong 64
      put sh_dat i get intent i
    end
    sh_all 64
    for i ulong 32
      if ne get sh_dig i get receipt add 24 i
        ret neg long 3
      end
    end
  end
  for i ulong 32
    if ne get g_ac_seal i get receipt add 96 i
      ret neg long 4
    end
  end
  for i ulong 128
    put sh_dat i get receipt i
  end
  for i ulong 32
    put sh_dat add 128 i get receipt add 96 i
  end
  sh_all 160
  for i ulong 32
    if ne get sh_dig i get receipt add 128 i
      ret neg long 5
    end
  end
  for i ulong 32
    put g_ac_seal i get receipt add 128 i
  end
  put g_ac_rcpts 0 add get g_ac_rcpts 0 1
  if ne has_intent 0
    op = ac_get_u32le intent 36
    if eq op 2
      wc = get g_ac_win_cnt 0
      if lt wc 8
        put g_ac_w_iova wc ac_get_u64le intent 40
        put g_ac_w_phys wc ac_get_u64le receipt 56
        put g_ac_w_size wc ac_get_u64le intent 48
        put g_ac_w_perm wc 7
        put g_ac_win_cnt 0 add wc 1
        put g_ac_w_id wc add wc 1
      end
    end
  end
  ret 0
end

fn omega_accel_port_bind_machine_graph to long
  uc = get g_mg_unit_n 0
  if lt uc 8
    mg_set_unit uc 6 1 10 4
    put g_mg_unit_n 0 add uc 1
  end
  put g_mg_phys_auth 0 1
  for i ulong 32
    put g_mg_phys_seal i get g_ac_seal i
  end
  ret omega_machine_compute_id
end

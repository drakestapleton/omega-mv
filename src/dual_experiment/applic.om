note
note DUAL applicability experiment (ARCH-0031 / ADR 0031, offline evidence lane):
note pure seeded OM-2 simulator, aggregate (macroscopic) predictor, heterogeneity
note measurements, campaign driver, canonical formatting, SHA-256 digests, and
note Pearson correlation. Zero heap, zero syscalls, zero host words.
om2

note ---- pre-registered experiment constants (DUAL-APPLIC-V1) ----
const AP_WINDOW ulong 20
const AP_WINDOWS ulong 100
const AP_STEPS ulong 2000
const AP_WARMUP_WINDOWS ulong 5

const AP_SLOTS ulong 32
const AP_MEMORY ulong 1024
const AP_MAX_QUEUE ulong 256
const AP_CLASSES ulong 4
const AP_MAX_ITEMS ulong 32768

const AP_HOM_DEMAND_MIN ulong 11
const AP_HOM_DEMAND_MAX ulong 13
const AP_HOM_MEM_MIN ulong 16
const AP_HOM_MEM_MAX ulong 24
const AP_HOM_SLOTS ulong 1

const AP_HET_DEMAND_CAP ulong 400
const AP_HET_MEM_BASE ulong 8

const AP_SQUARE_HALF_PERIOD ulong 100
const AP_BURST_MIN ulong 15
const AP_BURST_MAX ulong 35
const AP_CAP_DROP_SLOTS ulong 20
const AP_SWITCH_STEP ulong 1000

const AP_WL_COUNT ulong 8
const AP_SEEDS ulong 24
const AP_NROWS ulong 192
const AP_SEED_BASE ulong 0x4455414c2d415031

note ---- slot-indexed state (2 sim slots, 2 row-table slots) ----
note sim_u layout (stride 20 per slot):
note  0:n_items 1:queue_len 2:running_len 3:used_slots 4:used_mem
note  5:slots_capacity 6:arrived 7:completed 8:rejected 9:pool_exhausted
note 10:n_completed_stats 11:n_windows 12:rng_s 13:wl 14:step
note 15:w_arrivals 16:w_completions 17:w_blocked 18:w_rejected
global ap_sim_u ulong 40

note sim_f layout (stride 5 per slot):
note  0:sum_demand 1:sum_slots 2:sum_mem 3:het_sigma 4:sweep_rate
global ap_sim_f f64 10

note items arrays (stride 32768 per slot)
global ap_it_arr uint 65536
global ap_it_dem uint 65536
global ap_it_rem uint 65536
global ap_it_mem uint 65536
global ap_it_slt uint 65536
global ap_it_cls uint 65536

note queue (stride 256 per slot) and running (stride 32 per slot)
global ap_queue uint 512
global ap_run uint 64

note windows (stride 100 windows per slot):
note win_f stride 6: 0:used_slots_frac 1:used_mem_frac 2:queue_density 3:mean_demand 4:mean_slots 5:mean_mem
note win_u stride 8: 0:arrivals 1:completions 2:blocked_steps 3:rejected 4:in_system 5:queue_len 6:running 7:slots_capacity
global ap_win_f f64 1200
global ap_win_u ulong 1600

note scratch index array for heapsort in ap_measure
global ap_idx uint 32768

note campaign rows (2 slots x 192 rows = 384 rows):
note row_u stride 7: 0:wl 1:seed_index 2:seed 3:arrived 4:completed 5:rejected 6:windows
note row_f stride 19:
note   0..3:  real (completions_nrmse, queue_rmse, blocked_rmse, composite)
note   4..7:  known_arrivals (completions_nrmse, queue_rmse, blocked_rmse, composite)
note   8..11: shuffled (completions_nrmse, queue_rmse, blocked_rmse, composite)
note  12..18: hetero (cv_demand, top_share, max_item_share, class_entropy, arrival_cv, broken_const, broken_noise)
global ap_row_u ulong 2688
global ap_row_f f64 7296

note temporary single-window/prediction/error/hetero/pearson buffers
global ap_pred_f f64 3
global ap_err_f f64 4
global ap_err_w ulong 1
global ap_se_acc f64 4
global ap_het_f f64 7
global ap_pearson_f f64 2

note streaming SHA-256 state
global ap_sha_h ulong 8
global ap_sha_w ulong 64
global ap_sha_k ulong 64
global ap_sha_blk uchar 64
global ap_sha_st ulong 3

note scratch formatting buffers
global ap_line_buf uchar 512
global ap_pbuf uchar 2048


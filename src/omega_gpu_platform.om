note SPDX-License-Identifier: Apache-2.0
note src/omega_gpu_platform.om: Pure seeded OM-2 twin of src/omega_gpu_platform.c.
note Contract checks, capability negotiation, buffer descriptor validation, and
note 4096-slot generational handle table (ABI 1.2).
om2

const OGP_ABI_MAJOR ulong 1
const OGP_ABI_MINOR ulong 2

const OGP_HANDLE_DEVICE ulong 1
const OGP_HANDLE_BUF_DATA ulong 2
const OGP_HANDLE_BUF_CODE ulong 3
const OGP_HANDLE_BUF_QUEUE ulong 4
const OGP_HANDLE_QUEUE ulong 5
const OGP_HANDLE_KIND_COUNT ulong 6

const OGP_RIGHT_CPU_READ ulong 1
const OGP_RIGHT_CPU_WRITE ulong 2
const OGP_RIGHT_GPU_READ ulong 4
const OGP_RIGHT_GPU_WRITE ulong 8
const OGP_RIGHT_GPU_EXEC ulong 16
const OGP_RIGHT_HOST_POLLED ulong 32
const OGP_RIGHT_ALL ulong 63

const OGP_CACHE_GPU_UNCACHED ulong 0
const OGP_CACHE_GPU_CACHED ulong 1

const OGP_SVC_TIME ulong 1
const OGP_SVC_WAIT ulong 2
const OGP_SVC_LOCK ulong 4
const OGP_SVC_MMIO ulong 8
const OGP_SVC_DMA ulong 16
const OGP_SVC_SYNC ulong 32
const OGP_SVC_COMPLETION ulong 64
const OGP_SVC_IRQ ulong 128
const OGP_SVC_REQUIRED_V1 ulong 127
const OGP_SVC_DEVICE ulong 256
const OGP_SVC_QUEUE ulong 512
const OGP_SVC_CLOCK_NS ulong 1024
const OGP_SVC_HOST_MEM ulong 2048
const OGP_SVC_REQUIRED_SESSION ulong 3959
const OGP_SVC_ALL ulong 4095

const OGP_OK ulong 0
const OGP_REFUSED_ARGS ulong 1
const OGP_REFUSED_ABI ulong 2
const OGP_REFUSED_MISSING_SERVICE ulong 3
const OGP_REFUSED_NULL_SERVICE ulong 4
const OGP_REFUSED_BAD_HANDLE ulong 5
const OGP_REFUSED_STALE_HANDLE ulong 6
const OGP_REFUSED_BAD_LENGTH ulong 7
const OGP_REFUSED_BAD_RIGHTS ulong 8
const OGP_REFUSED_BAD_KIND ulong 9
const OGP_REFUSED_CACHE_POLICY ulong 10
const OGP_REFUSED_LIMIT ulong 11
const OGP_REFUSED_BUSY ulong 12
const OGP_REFUSED_DEVICE ulong 13
const OGP_REFUSAL_COUNT ulong 14

const OGP_POLL_TIMED_OUT ulong 100
const OGP_HANDLE_SLOTS ulong 4096

note Caps layout (ulong[10]):
note   0: abi_major, 1: abi_minor, 2: services, 3: max_devices, 4: max_buffers,
note   5: max_queues, 6: max_inflight, 7: max_buffer_bytes, 8: max_total_bytes,
note   9: submit_prefix_words
note BufferDesc layout (ulong[5]):
note   0: kind, 1: rights, 2: gpu_cache, 3: align, 4: bytes
note PlatformFnMask (ulong[12]):
note   bit 0 = present_all, bit 1 = present_any for each of the 12 service bits (0..11)

text ogp_rn_0 "OK"
text ogp_rn_1 "REFUSED_ARGS"
text ogp_rn_2 "REFUSED_ABI"
text ogp_rn_3 "REFUSED_MISSING_SERVICE"
text ogp_rn_4 "REFUSED_NULL_SERVICE"
text ogp_rn_5 "REFUSED_BAD_HANDLE"
text ogp_rn_6 "REFUSED_STALE_HANDLE"
text ogp_rn_7 "REFUSED_BAD_LENGTH"
text ogp_rn_8 "REFUSED_BAD_RIGHTS"
text ogp_rn_9 "REFUSED_BAD_KIND"
text ogp_rn_10 "REFUSED_CACHE_POLICY"
text ogp_rn_11 "REFUSED_LIMIT"
text ogp_rn_12 "REFUSED_BUSY"
text ogp_rn_13 "REFUSED_DEVICE"
text ogp_rn_unk "UNKNOWN"

fn ogp_copy_name src view uchar * dst edit uchar * to ulong
n = len src
cap = len dst
if gt n cap
n = cap
end
for i ulong n
put dst i get src i
end
ret n
end

fn ogp_refusal_name refusal ulong dst edit uchar * to ulong
if eq refusal 0
ret ogp_copy_name ogp_rn_0 dst
end
if eq refusal 1
ret ogp_copy_name ogp_rn_1 dst
end
if eq refusal 2
ret ogp_copy_name ogp_rn_2 dst
end
if eq refusal 3
ret ogp_copy_name ogp_rn_3 dst
end
if eq refusal 4
ret ogp_copy_name ogp_rn_4 dst
end
if eq refusal 5
ret ogp_copy_name ogp_rn_5 dst
end
if eq refusal 6
ret ogp_copy_name ogp_rn_6 dst
end
if eq refusal 7
ret ogp_copy_name ogp_rn_7 dst
end
if eq refusal 8
ret ogp_copy_name ogp_rn_8 dst
end
if eq refusal 9
ret ogp_copy_name ogp_rn_9 dst
end
if eq refusal 10
ret ogp_copy_name ogp_rn_10 dst
end
if eq refusal 11
ret ogp_copy_name ogp_rn_11 dst
end
if eq refusal 12
ret ogp_copy_name ogp_rn_12 dst
end
if eq refusal 13
ret ogp_copy_name ogp_rn_13 dst
end
ret ogp_copy_name ogp_rn_unk dst
end

fn ogp_negotiate provided view ulong 10 required view ulong 10 to ulong
if ne get provided 0 get required 0
ret OGP_REFUSED_ABI
end
if lt get provided 1 get required 1
ret OGP_REFUSED_ABI
end
ps = get provided 2
rs = get required 2
if ne and or ps rs not OGP_SVC_ALL 0
ret OGP_REFUSED_ARGS
end
if ne and rs not ps 0
ret OGP_REFUSED_MISSING_SERVICE
end
if gt get required 3 get provided 3
ret OGP_REFUSED_LIMIT
end
if gt get required 4 get provided 4
ret OGP_REFUSED_LIMIT
end
if gt get required 5 get provided 5
ret OGP_REFUSED_LIMIT
end
if gt get required 6 get provided 6
ret OGP_REFUSED_LIMIT
end
if gt get required 7 get provided 7
ret OGP_REFUSED_LIMIT
end
if gt get required 8 get provided 8
ret OGP_REFUSED_LIMIT
end
ret OGP_OK
end

fn ogp_svc_check services ulong bit ulong mask ulong to ulong
if ne and services bit 0
if ne and mask 1 0
ret OGP_OK
end
ret OGP_REFUSED_NULL_SERVICE
end
if ne and mask 2 0
ret OGP_REFUSED_ARGS
end
ret OGP_OK
end

fn ogp_check_for fnmask view ulong 12 caps view ulong 10 required ulong to ulong
s = get caps 2
if ne and s not OGP_SVC_ALL 0
ret OGP_REFUSED_ARGS
end
if ne and required not OGP_SVC_ALL 0
ret OGP_REFUSED_ARGS
end
if ne and s required required
ret OGP_REFUSED_MISSING_SERVICE
end
for i ulong 12
bit = shl ulong 1 i
rc = ogp_svc_check s bit get fnmask i
if ne rc OGP_OK
ret rc
end
end
ret OGP_OK
end

fn ogp_check fnmask view ulong 12 caps view ulong 10 to ulong
ret ogp_check_for fnmask caps OGP_SVC_REQUIRED_V1
end

fn ogp_is_pow2 v ulong to bool
if eq v 0
ret false
end
ret eq and v sub v 1 0
end

fn ogp_check_buffer d view ulong 5 caps view ulong 10 to ulong
kind = get d 0
ok_k = false
if eq kind OGP_HANDLE_BUF_DATA
ok_k = true
end
if eq kind OGP_HANDLE_BUF_CODE
ok_k = true
end
if eq kind OGP_HANDLE_BUF_QUEUE
ok_k = true
end
if not ok_k
ret OGP_REFUSED_BAD_KIND
end
nbytes = get d 4
if eq nbytes 0
ret OGP_REFUSED_BAD_LENGTH
end
if gt nbytes get caps 7
ret OGP_REFUSED_LIMIT
end
al = get d 3
if ne al 0
if not ogp_is_pow2 al
ret OGP_REFUSED_ARGS
end
end
gc = get d 2
if and ne gc OGP_CACHE_GPU_UNCACHED ne gc OGP_CACHE_GPU_CACHED
ret OGP_REFUSED_ARGS
end
r = get d 1
if or eq r 0 ne and r not OGP_RIGHT_ALL 0
ret OGP_REFUSED_BAD_RIGHTS
end
if and ne and r OGP_RIGHT_GPU_EXEC 0 ne kind OGP_HANDLE_BUF_CODE
ret OGP_REFUSED_BAD_RIGHTS
end
if eq kind OGP_HANDLE_BUF_CODE
if ne and r or OGP_RIGHT_GPU_WRITE OGP_RIGHT_HOST_POLLED 0
ret OGP_REFUSED_BAD_RIGHTS
end
if or eq and r OGP_RIGHT_GPU_EXEC 0 eq and r OGP_RIGHT_CPU_WRITE 0
ret OGP_REFUSED_BAD_RIGHTS
end
end
if eq kind OGP_HANDLE_BUF_QUEUE
if or eq and r OGP_RIGHT_CPU_WRITE 0 eq and r OGP_RIGHT_GPU_READ 0
ret OGP_REFUSED_BAD_RIGHTS
end
end
if ne and r OGP_RIGHT_HOST_POLLED 0
if or eq and r OGP_RIGHT_CPU_READ 0 eq and r OGP_RIGHT_GPU_WRITE 0
ret OGP_REFUSED_BAD_RIGHTS
end
if ne gc OGP_CACHE_GPU_UNCACHED
ret OGP_REFUSED_CACHE_POLICY
end
end
ret OGP_OK
end

note Handle table state (process-local global table, matching OmegaGpuHandleTable):
global ogp_ht_gen uint 4096
global ogp_ht_kind uint 4096
global ogp_ht_bytes ulong 4096
global ogp_ht_live uchar 4096
global ogp_ht_nlive ulong 1
global ogp_ht_total_bytes ulong 1

fn ogp_handles_init to void
for i ulong OGP_HANDLE_SLOTS
put ogp_ht_gen i 1
put ogp_ht_kind i 0
put ogp_ht_bytes i 0
put ogp_ht_live i 0
end
put ogp_ht_nlive 0 0
put ogp_ht_total_bytes 0 0
end

fn ogp_kind_known kind ulong to bool
ret and ge kind OGP_HANDLE_DEVICE lt kind OGP_HANDLE_KIND_COUNT
end

fn ogp_handles_open kind ulong nbytes ulong limit_slots ulong limit_bytes ulong res edit ulong 2 to ulong
if not ogp_kind_known kind
ret OGP_REFUSED_BAD_KIND
end
same_kind = ulong 0
for i ulong OGP_HANDLE_SLOTS
if ne get ogp_ht_live i 0
if eq ulong get ogp_ht_kind i kind
same_kind = add same_kind 1
end
end
end
if ge same_kind limit_slots
ret OGP_REFUSED_LIMIT
end
if ne nbytes 0
if gt nbytes limit_bytes
ret OGP_REFUSED_LIMIT
end
if gt get ogp_ht_total_bytes 0 sub limit_bytes nbytes
ret OGP_REFUSED_LIMIT
end
end
for i ulong OGP_HANDLE_SLOTS
if eq get ogp_ht_live i 0
gen = get ogp_ht_gen i
if ne gen 0
put ogp_ht_live i 1
put ogp_ht_kind i uint kind
put ogp_ht_bytes i nbytes
put ogp_ht_nlive 0 add get ogp_ht_nlive 0 1
put ogp_ht_total_bytes 0 add get ogp_ht_total_bytes 0 nbytes
put res 0 i
put res 1 ulong gen
ret OGP_OK
end
end
end
ret OGP_REFUSED_LIMIT
end

fn ogp_handles_check index ulong gen ulong kind ulong to ulong
if or ge index OGP_HANDLE_SLOTS eq gen 0
ret OGP_REFUSED_BAD_HANDLE
end
if or eq get ogp_ht_live index 0 ne ulong get ogp_ht_gen index gen
ret OGP_REFUSED_STALE_HANDLE
end
if ne ulong get ogp_ht_kind index kind
ret OGP_REFUSED_BAD_HANDLE
end
ret OGP_OK
end

fn ogp_handles_close index ulong gen ulong kind ulong to ulong
rc = ogp_handles_check index gen kind
if ne rc OGP_OK
ret rc
end
put ogp_ht_live index 0
put ogp_ht_total_bytes 0 sub get ogp_ht_total_bytes 0 get ogp_ht_bytes index
put ogp_ht_bytes index 0
put ogp_ht_nlive 0 sub get ogp_ht_nlive 0 1
gnext = add ulong get ogp_ht_gen index 1
put ogp_ht_gen index uint and gnext 0xffffffff
ret OGP_OK
end

end

note Build kernel k (0=sdot, 1=crumb) into g_enc_word[0..n). base=0 object form, base!=0 final form.
fn omx_encoder_build k ulong base ulong to int
  if ge k OMX_ENC_KERNELS
    ret -1
  end
  if ne and base 0xfff 0
    ret -1
  end
  for i ulong 16
    put g_enc_sdot_mask i uchar 0
    put g_enc_sdot_mask add i 16 uchar 0xff
  end
  put g_enc_st 3 base
  off = ulong 0
  for pass ulong 2
    for i ulong 32
      put g_enc_lab i -1
    end
    put g_enc_st 0 0
    put g_enc_st 1 0
    put g_enc_st 2 0
    put g_enc_st 4 off
    if eq k OMX_ENC_SDOT
      emit_sdot
    else
      emit_crumb
    end
    if ne get g_enc_st 1 0
      ret -1
    end
    n = get g_enc_st 0
    off = and add mul n 4 15 0xfffffffffffffff0
    if eq off get g_enc_st 4
      break
    end
    if eq pass 1
      ret -1
    end
  end
  n = get g_enc_st 0
  ub = ulong 512
  if eq k OMX_ENC_SDOT
    ub = 256
  end
  if gt n ub
    ret -1
  end
  if ne enc_resolve 0
    ret -1
  end
  put g_enc_st 4 off
  if eq k OMX_ENC_SDOT
    put g_enc_st 5 32
  else
    put g_enc_st 5 0
  end
  ret 0
end

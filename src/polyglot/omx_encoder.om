  enc_o omx_a64_subsimm 1 14 14 1
  enc_bcond OMX_COND_NE 7
  enc_label 8
  enc_cbz 8 9
  enc_x oxe_ld1_4x16b 0 31
  emit_chunk4
  enc_label 9
  enc_x oxe_add_4s 24 24 28
  enc_x oxe_add_4s 25 25 29
  enc_x oxe_add_4s 26 26 30
  enc_x oxe_add_4s 27 27 31
  enc_x oxe_addp_4s 24 24 25
  enc_x oxe_addp_4s 26 26 27
  enc_x oxe_addp_4s 24 24 26
  enc_x oxe_str_q_post 24 2 16
  enc_xlsl oxe_add_lsl_x 5 5 7 2
  enc_x oxe_sub_imm_x 3 3 4 0
  enc_br 1

  enc_label 2
  enc_cbz 3 4
  enc_label 3
  enc_x oxe_movi_16b 24 0
  enc_x oxe_movi_16b 28 0
  enc_o omx_a64_movreg 1 9 1
  enc_o omx_a64_movreg 1 10 5
  enc_cbz 6 11
  enc_o omx_a64_movreg 1 14 6
  enc_label 10
  enc_x oxe_ld1_4x16b_post 0 9 64
  enc_x oxe_ldr_q_post 4 10 16
  emit_crow 4 24 28 16
  enc_o omx_a64_subsimm 1 14 14 1
  enc_bcond OMX_COND_NE 10

  enc_x oxe_lsr_imm_x 6 4 6
  enc_x oxe_ubfx_x 7 4 4 2
  enc_x oxe_and_imm_x 8 4 15
  enc_adr_data 16
  enc_o omx_a64_addreg 1 16 16 8
  enc_o omx_a64_movz 1 15 16
  enc_o omx_a64_subreg 1 15 15 8

  emit_sdot_blk4
  emit_sdot_tail
end

note ---- Kernel: asm_crumb (mirrors src/polyglot/asm/omx_crumb.S line by line) ----
note labels: 0=ERR 1=BLK4 2=ROWS1 3=ROW1 4=OK 5=T0 6=T1 7=B0 8=B1 9=B2 10=R0 11=R1 12=R2

fn emit_crow wv ulong va ulong vb ulong tbase ulong to void
  t0 = tbase
  t1 = add tbase 1
  t2 = add tbase 2
  t3 = add tbase 3
  enc_x oxe_shl_16b t0 wv 6
  enc_x oxe_shl_16b t1 wv 4
  enc_x oxe_shl_16b t2 wv 2
  enc_x oxe_sshr_16b t3 wv 6
  enc_x oxe_sshr_16b t0 t0 6
  enc_x oxe_sshr_16b t1 t1 6
  enc_x oxe_sshr_16b t2 t2 6
  enc_x oxe_sdot_4s vb t3 3
  enc_x oxe_sdot_4s va t0 0
  enc_x oxe_sdot_4s vb t1 1
  enc_x oxe_sdot_4s va t2 2
end

fn emit_chunk4 to void
  enc_x oxe_ldr_q_post 4 10 16
  enc_x oxe_ldr_q_post 5 11 16
  enc_x oxe_ldr_q_post 6 12 16
  enc_x oxe_ldr_q_post 7 13 16

fn emit_crow wv ulong va ulong vb ulong tbase ulong to void
  t0 = tbase
  t1 = add tbase 1
  t2 = add tbase 2
  t3 = add tbase 3
  enc_x oxe_shl_16b t0 wv 6
  enc_x oxe_shl_16b t1 wv 4

  enc_x oxe_add_imm_x 10 31 0 0
  enc_o omx_a64_movreg 1 14 8
  enc_label 5
  enc_x oxe_ldrb_w_post 11 9 1
  enc_x oxe_strb_w_post 11 10 1
  enc_o omx_a64_subsimm 1 14 14 1

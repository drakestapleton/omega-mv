  enc_label 6

  enc_label 1
  enc_o omx_a64_subsimm 1 31 3 4
  enc_bcond OMX_COND_LO 2
  for v ulong 8
    enc_x oxe_movi_16b add 24 v 0
  end
  enc_o omx_a64_movreg 1 9 1
  enc_o omx_a64_movreg 1 10 5
  enc_o omx_a64_addreg 1 11 10 7
  enc_o omx_a64_addreg 1 12 11 7
  enc_o omx_a64_addreg 1 13 12 7

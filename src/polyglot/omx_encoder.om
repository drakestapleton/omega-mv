fn emit_sdot to void
  enc_cbz 0 0
  enc_cbz 1 0
  enc_cbz 2 0
  enc_x oxe_ldp_x_off 3 4 0 0
  enc_o omx_a64_ldruoff 1 5 0 16
  enc_cbz 5 0
  enc_cbz 3 0
  enc_cbz 4 0
  enc_o omx_a64_subsimm 1 31 4 16

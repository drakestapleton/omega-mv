note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/polyglot/omx_bench.c:
note SplitMix64 RNG, [0,1) unit draw, lowercase hex encoder, ELF64 LE header
note validator, deterministic f64 heapsort, median, and absolute deviations.
om2

fn omx_hex_nib v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

fn omx_sm64 st edit ulong 1 to ulong
  z = add get st 0 0x9e3779b97f4a7c15
  put st 0 z
  z = mul xor z shr z 30 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 0x94d049bb133111eb
  ret xor z shr z 31
end

fn omx_sift v edit ulong * root ulong n ulong to void
  r = root
  while true
    child = add mul r 2 1
    if ge child n
      ret
    end
    pick = r
    if gt bitcast f64 get v child bitcast f64 get v pick
      pick = child
    end
    c2 = add child 1
    if lt c2 n
      if gt bitcast f64 get v c2 bitcast f64 get v pick
        pick = c2
      end
    end
    if eq pick r
      ret
    end
    tmp = get v r
    put v r get v pick
    put v pick tmp
    r = pick
  end
end

export fn omx_om_rng_next st edit ulong 1 to ulong
  ret omx_sm64 st
end

export fn omx_om_rng_01 st edit ulong 1 to ulong
  v = omx_sm64 st
  q = shr v 11
  inv = bitcast f64 ulong 0x3ca0000000000000
  ret bitcast ulong mul f64 q inv
end

export fn omx_om_hex d view uchar * n ulong dst edit uchar * to void
  for i ulong n
    b = ulong get d i
    put dst mul i 2 omx_hex_nib shr b 4
    put dst add mul i 2 1 omx_hex_nib and b 15
  end
end

export fn omx_om_elf64_le_ok b view uchar * slen ulong to ulong
  if lt slen 64
    ret 0
  end
  if ne ulong get b 0 0x7f
    ret 0
  end
  if ne ulong get b 1 69
    ret 0
  end
  if ne ulong get b 2 76
    ret 0
  end
  if ne ulong get b 3 70
    ret 0
  end
  if ne ulong get b 4 2
    ret 0
  end
  if ne ulong get b 5 1
    ret 0
  end
  ret 1
end

export fn omx_om_sort_d v edit ulong * n ulong to void
  if lt n 2
    ret
  end
  i = div n 2
  while gt i 0
    i = sub i 1
    omx_sift v i n
  end
  i = sub n 1
  while gt i 0
    t = get v 0
    put v 0 get v i
    put v i t
    omx_sift v 0 i
    i = sub i 1
  end
end

export fn omx_om_median_sorted v view ulong * n ulong to ulong
  if eq n 0
    ret 0
  end
  mid = div n 2
  if eq and n 1 1
    ret get v mid
  end
  a = bitcast f64 get v sub mid 1
  b = bitcast f64 get v mid
  half = bitcast f64 ulong 0x3fe0000000000000
  ret bitcast ulong mul half add a b
end

export fn omx_om_abs_dev v view ulong * n ulong med_b ulong dst edit ulong * to void
  med = bitcast f64 med_b
  for i ulong n
    x = bitcast f64 get v i
    if gt x med
      put dst i bitcast ulong sub x med
    else
      put dst i bitcast ulong sub med x
    end
  end
end

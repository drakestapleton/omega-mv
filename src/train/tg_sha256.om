note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 streaming SHA-256 (FIPS 180-4) for M22 train and M20 tensor.
note Context layout (uchar 104):
note   bytes 0..31   h[0..7] little-endian uint32
note   bytes 32..39  total byte count little-endian ulong
note   bytes 40..103 64-byte pending block buffer

fn sha_k idx ulong to uint
  if lt idx 16
    if lt idx 8
      if eq idx 0
        ret uint 0x428a2f98
      end
      if eq idx 1
        ret uint 0x71374491
      end
      if eq idx 2
        ret uint 0xb5c0fbcf
      end
      if eq idx 3
        ret uint 0xe9b5dba5
      end
      if eq idx 4
        ret uint 0x3956c25b
      end
      if eq idx 5
        ret uint 0x59f111f1
      end
      if eq idx 6
        ret uint 0x923f82a4
      end
      ret uint 0xab1c5ed5
    end
    if eq idx 8
      ret uint 0xd807aa98
    end
    if eq idx 9
      ret uint 0x12835b01
    end
    if eq idx 10
      ret uint 0x243185be
    end
    if eq idx 11
      ret uint 0x550c7dc3
    end
    if eq idx 12
      ret uint 0x72be5d74
    end
    if eq idx 13
      ret uint 0x80deb1fe
    end
    if eq idx 14
      ret uint 0x9bdc06a7
    end
    ret uint 0xc19bf174
  end
  if lt idx 32
    if lt idx 24
      if eq idx 16
        ret uint 0xe49b69c1
      end
      if eq idx 17
        ret uint 0xefbe4786
      end
      if eq idx 18
        ret uint 0x0fc19dc6
      end
      if eq idx 19
        ret uint 0x240ca1cc
      end
      if eq idx 20
        ret uint 0x2de92c6f
      end
      if eq idx 21
        ret uint 0x4a7484aa
      end
      if eq idx 22
        ret uint 0x5cb0a9dc
      end
      ret uint 0x76f988da
    end
    if eq idx 24
      ret uint 0x983e5152
    end
    if eq idx 25
      ret uint 0xa831c66d
    end
    if eq idx 26
      ret uint 0xb00327c8
    end
    if eq idx 27
      ret uint 0xbf597fc7
    end
    if eq idx 28
      ret uint 0xc6e00bf3
    end
    if eq idx 29
      ret uint 0xd5a79147
    end
    if eq idx 30
      ret uint 0x06ca6351
    end
    ret uint 0x14292967
  end
  if lt idx 48
    if lt idx 40
      if eq idx 32
        ret uint 0x27b70a85
      end
      if eq idx 33
        ret uint 0x2e1b2138
      end
      if eq idx 34
        ret uint 0x4d2c6dfc
      end
      if eq idx 35
        ret uint 0x53380d13
      end
      if eq idx 36
        ret uint 0x650a7354
      end
      if eq idx 37
        ret uint 0x766a0abb
      end
      if eq idx 38
        ret uint 0x81c2c92e
      end
      ret uint 0x92722c85
    end
    if eq idx 40
      ret uint 0xa2bfe8a1
    end
    if eq idx 41
      ret uint 0xa81a664b
    end
    if eq idx 42
      ret uint 0xc24b8b70
    end
    if eq idx 43
      ret uint 0xc76c51a3
    end
    if eq idx 44
      ret uint 0xd192e819
    end
    if eq idx 45
      ret uint 0xd6990624
    end
    if eq idx 46
      ret uint 0xf40e3585
    end
    ret uint 0x106aa070
  end
  if lt idx 56
    if eq idx 48
      ret uint 0x19a4c116
    end
    if eq idx 49
      ret uint 0x1e376c08
    end
    if eq idx 50
      ret uint 0x2748774c
    end
    if eq idx 51
      ret uint 0x34b0bcb5
    end
    if eq idx 52
      ret uint 0x391c0cb3
    end
    if eq idx 53
      ret uint 0x4ed8aa4a
    end
    if eq idx 54
      ret uint 0x5b9cca4f
    end
    ret uint 0x682e6ff3
  end
  if eq idx 56
    ret uint 0x748f82ee
  end
  if eq idx 57
    ret uint 0x78a5636f
  end
  if eq idx 58
    ret uint 0x84c87814
  end
  if eq idx 59
    ret uint 0x8cc70208
  end
  if eq idx 60
    ret uint 0x90befffa
  end
  if eq idx 61
    ret uint 0xa4506ceb
  end
  if eq idx 62
    ret uint 0xbef9a3f7
  end
  ret uint 0xc67178f2
end

fn sha_get_u32le buf view uchar 104 off ulong to uint
  b0 = uint get buf off
  b1 = shl uint get buf add off 1 8
  b2 = shl uint get buf add off 2 16
  b3 = shl uint get buf add off 3 24
  ret or or b0 b1 or b2 b3
end

fn sha_put_u32le buf edit uchar 104 off ulong v uint to void
  put buf off uchar and v 255
  put buf add off 1 uchar and shr v 8 255
  put buf add off 2 uchar and shr v 16 255
  put buf add off 3 uchar and shr v 24 255
end

fn sha_get_u64le buf view uchar 104 off ulong to ulong
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get buf add off i mul i 8
  end
  ret v
end

fn sha_put_u64le buf edit uchar 104 off ulong v ulong to void
  for i ulong 8
    put buf add off i uchar and shr v mul i 8 255
  end
end

fn sha_expand blk view uchar 64 w edit uint 64 to void
  for i ulong 16
    p = mul i 4
    v = shl uint get blk p 24
    v = or v shl uint get blk add p 1 16
    v = or v shl uint get blk add p 2 8
    v = or v uint get blk add p 3
    put w i v
  end
  for j ulong 48
    i = add j 16
    x = get w sub i 15
    s0 = xor xor rotr x 7 rotr x 18 shr x 3
    y = get w sub i 2
    s1 = xor xor rotr y 17 rotr y 19 shr y 10
    v = add get w sub i 16 s0
    v = add v get w sub i 7
    v = add v s1
    put w i v
  end
end

fn sha_round st edit uint 8 ki uint wi uint to void
  e = get st 4
  t1 = xor xor rotr e 6 rotr e 11 rotr e 25
  t1 = add t1 xor and e get st 5 and not e get st 6
  t1 = add t1 get st 7
  t1 = add t1 add ki wi
  a = get st 0
  t2 = xor xor rotr a 2 rotr a 13 rotr a 22
  b = get st 1
  c = get st 2
  t2 = add t2 xor xor and a b and a c and b c
  put st 7 get st 6
  put st 6 get st 5
  put st 5 e
  put st 4 add get st 3 t1
  put st 3 c
  put st 2 b
  put st 1 a
  put st 0 add t1 t2
end

fn sha_compress ctx edit uchar 104 blk view uchar 64 to void
  w = new uint 64 0
  st = new uint 8 0
  sha_expand blk w
  for i ulong 8
    put st i sha_get_u32le ctx mul i 4
  end
  for i ulong 64
    sha_round st sha_k i get w i
  end
  for i ulong 8
    v = add sha_get_u32le ctx mul i 4 get st i
    sha_put_u32le ctx mul i 4 v
  end
end

fn tg_sha_init ctx edit uchar 104 to void
  for i ulong 104
    put ctx i 0
  end
  sha_put_u32le ctx 0 uint 0x6a09e667
  sha_put_u32le ctx 4 uint 0xbb67ae85
  sha_put_u32le ctx 8 uint 0x3c6ef372
  sha_put_u32le ctx 12 uint 0xa54ff53a
  sha_put_u32le ctx 16 uint 0x510e527f
  sha_put_u32le ctx 20 uint 0x9b05688c
  sha_put_u32le ctx 24 uint 0x1f83d9ab
  sha_put_u32le ctx 28 uint 0x5be0cd19
end

fn sha_compress_ctx ctx edit uchar 104 to void
  blk = new uchar 64 0
  for j ulong 64
    put blk j get ctx add 40 j
  end
  sha_compress ctx blk
end

fn tg_sha_update ctx edit uchar 104 data view uchar * n ulong to void
  cnt = sha_get_u64le ctx 32
  used = and cnt 63
  sha_put_u64le ctx 32 add cnt n
  pos = ulong 0
  while lt pos n bound 16777216
    b = get data pos
    put ctx add 40 used b
    used = add used 1
    pos = add pos 1
    if eq used 64
      sha_compress_ctx ctx
      used = 0
    end
  end
end

fn tg_sha_final ctx edit uchar 104 dig edit uchar 32 to void
  blk = new uchar 64 0
  cnt = sha_get_u64le ctx 32
  used = and cnt 63
  for j ulong 64
    if lt j used
      put blk j get ctx add 40 j
    else
      put blk j 0
    end
  end
  put blk used 128
  if ge used 56
    sha_compress ctx blk
    for j ulong 64
      put blk j 0
    end
  end
  bits = shl cnt 3
  for j ulong 8
    put blk sub 63 j uchar and shr bits mul j 8 255
  end
  sha_compress ctx blk
  for i ulong 8
    v = sha_get_u32le ctx mul i 4
    p = mul i 4
    put dig p uchar and shr v 24 255
    put dig add p 1 uchar and shr v 16 255
    put dig add p 2 uchar and shr v 8 255
    put dig add p 3 uchar and v 255
  end
end

fn tg_sha_hash data view uchar * n ulong dig edit uchar 32 to void
  ctx = new uchar 104 0
  tg_sha_init ctx
  tg_sha_update ctx data n
  tg_sha_final ctx dig
end

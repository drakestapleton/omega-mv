note SPDX-License-Identifier: Apache-2.0
note M22 OMTRGEN1 snapshots. The first 120 bytes and the payloads are hashed.
note The digest is filled by the caller after transfer of the payloads.
om2

const gen_magic ulong 3552853328668151119
const cur_magic ulong 3553996803581168975
const rec_magic ulong 826558292
const payload_limit ulong 1099511627776

fn gen_word bytes view uchar * first ulong to ulong
  value = ulong 0
  for j ulong 8
    value = or value shl ulong get bytes add first j mul j 8
  end
  ret value
end

fn gen_word32 bytes view uchar * first ulong to ulong
  value = ulong 0
  for j ulong 4
    value = or value shl ulong get bytes add first j mul j 8
  end
  ret value
end

fn put_gen_word bytes edit uchar * first ulong value ulong to void
  for j ulong 8
    put bytes add first j uchar and shr value mul j 8 255
  end
end

fn put_gen_word32 bytes edit uchar * first ulong value ulong to void
  for j ulong 4
    put bytes add first j uchar and shr value mul j 8 255
  end
end

fn hex_nibble v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

fn unhex_char c ulong to long
  if and ge c 48 le c 57
    ret long sub c 48
  end
  if and ge c 97 le c 102
    ret long add sub c 97 10
  end
  ret -1
end

export fn tg_encode_hex digest view uchar 32 out_hex out uchar 64 to void
  for i ulong 32
    b = ulong get digest i
    put out_hex mul i 2 hex_nibble shr b 4
    put out_hex add mul i 2 1 hex_nibble and b 15
  end
end

export fn tg_encode_pointer gen ulong digest view uchar 32 out_buf out uchar 95 to void
  put_gen_word out_buf 0 cur_magic
  put out_buf 8 32
  rem_gen = gen
  for i ulong 20
    pos = sub 28 i
    put out_buf pos uchar add 48 rem rem_gen 10
    rem_gen = div rem_gen 10
  end
  put out_buf 29 32
  for i ulong 32
    b = ulong get digest i
    put out_buf add 30 mul i 2 hex_nibble shr b 4
    put out_buf add 31 mul i 2 hex_nibble and b 15
  end
  put out_buf 94 10
end

export fn tg_decode_pointer buf view uchar 95 gen_out edit ulong 1 digest_out out uchar 32 to ulong
  if ne gen_word buf 0 cur_magic
    ret 0
  end
  if or ne get buf 8 32 ne get buf 29 32
    ret 0
  end
  if ne get buf 94 10
    ret 0
  end
  g = ulong 0
  for i ulong 20
    c = ulong get buf add 9 i
    if or lt c 48 gt c 57
      ret 0
    end
    d = sub c 48
    if or gt g 1844674407370955161 and eq g 1844674407370955161 gt d 5
      ret 0
    end
    g = add mul g 10 d
  end
  for i ulong 32
    hi = unhex_char ulong get buf add 30 mul i 2
    lo = unhex_char ulong get buf add 31 mul i 2
    if or lt hi 0 lt lo 0
      ret 0
    end
    put digest_out i uchar or shl ulong hi 4 ulong lo
  end
  put gen_out 0 g
  ret 1
end

export fn tg_encode_dispatch fields view ulong 6 refs view ulong 9 base_digest view uchar 32 rec out uchar 192 to void
  for i ulong 192
    put rec i 0
  end
  put_gen_word32 rec 0 rec_magic
  put_gen_word32 rec 4 get fields 0
  put_gen_word rec 16 get fields 1
  put_gen_word rec 24 get fields 2
  put_gen_word rec 32 get fields 3
  put_gen_word rec 40 get fields 4
  n_refs = get fields 5
  if gt n_refs 3
    n_refs = 3
  end
  put_gen_word32 rec 48 n_refs
  for i ulong n_refs
    base = add 56 mul i 24
    put_gen_word32 rec base get refs mul i 3
    put_gen_word rec add base 8 get refs add mul i 3 1
    put_gen_word rec add base 16 get refs add mul i 3 2
  end
  for i ulong 32
    put rec add 128 i get base_digest i
  end
end

export fn tg_set_dispatch_seq rec edit uchar 192 seq ulong to void
  put_gen_word rec 8 seq
end

export fn tg_check_dispatch_header rec view uchar 192 expect_seq ulong to ulong
  if or ne gen_word32 rec 0 rec_magic ne gen_word rec 8 expect_seq
    ret 0
  end
  ret 1
end

export fn tg_decode_dispatch rec view uchar 192 fields edit ulong 7 refs edit ulong 9 to ulong
  n_refs = gen_word32 rec 48
  if gt n_refs 3
    ret 0
  end
  put fields 0 gen_word32 rec 4
  put fields 1 gen_word rec 8
  put fields 2 gen_word rec 16
  put fields 3 gen_word rec 24
  put fields 4 gen_word rec 32
  put fields 5 gen_word rec 40
  put fields 6 n_refs
  for i ulong 9
    put refs i 0
  end
  for i ulong n_refs
    base = add 56 mul i 24
    put refs mul i 3 gen_word32 rec base
    put refs add mul i 3 1 gen_word rec add base 8
    put refs add mul i 3 2 gen_word rec add base 16
  end
  ret 1
end

export fn tg_encode_generation fields view ulong 5 dispatch view uchar 32 previous view uchar 32 header out uchar 152 to void
  put_gen_word header 0 gen_magic
  put_gen_word header 8 1
  for i ulong 5
    put_gen_word header add 16 mul i 8 get fields i
  end
  for i ulong 32
    put header add 56 i get dispatch i
    put header add 88 i get previous i
    put header add 120 i 0
  end
end

note Return 1 for a verified header, 2 for a truncated file and 0 for a
note format error. Preserve the historical order of these refusals.
export fn tg_decode_generation header view uchar 152 size ulong expected ulong fields edit ulong 5 to ulong
  if or ne gen_word header 0 gen_magic ne gen_word header 8 1
    ret 0
  end
  params = gen_word header 32
  opt = gen_word header 40
  if or gt params payload_limit gt opt payload_limit
    ret 0
  end
  total = add 152 add params opt
  if lt size total
    ret 2
  end
  if or ne size total ne gen_word header 16 expected
    ret 0
  end
  for i ulong 5
    put fields i gen_word header add 16 mul i 8
  end
  ret 1
end

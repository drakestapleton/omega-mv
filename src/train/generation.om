note SPDX-License-Identifier: Apache-2.0
note M22 OMTRGEN1 snapshots. The first 120 bytes and the payloads are hashed.
note The digest is filled by the caller after transfer of the payloads.
om2

const gen_magic ulong 3552853328668151119
const payload_limit ulong 1099511627776

fn gen_word bytes view uchar 152 first ulong to ulong
  value = ulong 0
  for j ulong 8
    value = or value shl ulong get bytes add first j mul j 8
  end
  ret value
end

fn put_gen_word bytes edit uchar 152 first ulong value ulong to void
  for j ulong 8
    put bytes add first j uchar and shr value mul j 8 255
  end
end

export fn tg_encode_generation fields view ulong 5 dispatch view uchar 32 previous view uchar 32 header out uchar 152 to void
  put_gen_word header 0 gen_magic
  put_gen_word header 8 1
  for i ulong 5
    put_gen_word header add 16 mul i 8 get fields i
  end
  for i ulong 32
    put header add 56 i get dispatch i
    put header add 88 i get previous i
    put header add 120 i 0
  end
end

note Return 1 for a verified header, 2 for a truncated file and 0 for a
note format error. Preserve the historical order of these refusals.
export fn tg_decode_generation header view uchar 152 size ulong expected ulong fields edit ulong 5 to ulong
  if or ne gen_word header 0 gen_magic ne gen_word header 8 1
    ret 0
  end
  params = gen_word header 32
  opt = gen_word header 40
  if or gt params payload_limit gt opt payload_limit
    ret 0
  end
  total = add 152 add params opt
  if lt size total
    ret 2
  end
  if or ne size total ne gen_word header 16 expected
    ret 0
  end
  for i ulong 5
    put fields i gen_word header add 16 mul i 8
  end
  ret 1
end

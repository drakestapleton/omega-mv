note SPDX-License-Identifier: Apache-2.0
note Scalar arguments and storage carry IEEE binary32 bits. Each multiply
note and add or subtract is a separate operation, as specified by tg_sgd.h.
om2

export fn tg_sgd_mode learning ulong momentum ulong to long
  if or eq learning 0 ge learning 0x7f800000
    ret -1
  end
  if or eq momentum 0 eq momentum 0x80000000
    ret 0
  end
  if ge momentum 0x3f800000
    ret -1
  end
  ret 1
end

export fn tg_update_velocity velocity edit uint * gradient view uint * bits ulong to void
requires eq len velocity len gradient
  momentum = bitcast f32 uint bits
  for i ulong len velocity
    previous = bitcast f32 get velocity i
    contribution = mul momentum previous
    updated = add contribution bitcast f32 get gradient i
    put velocity i bitcast uint updated
  end
end

export fn tg_update_params params edit uint * direction view uint * bits ulong to void
requires eq len params len direction
  learning = bitcast f32 uint bits
  for i ulong len params
    value = bitcast f32 get params i
    step = mul learning bitcast f32 get direction i
    put params i bitcast uint sub value step
  end
end

note SPDX-License-Identifier: Apache-2.0
note src/omega_blackwell_gates.om: Pure seeded OM-2 twin of src/omega_blackwell_gates.c.
note M17 Blackwell vector qualification gates (semantic oracle, SM121 machine binding,
note realization tamper check, native SM121 vecadd encoding, QMD0/QMD1 invariants,
note live/mock vector submit + boundary sweep + mutation refusal + zero-CUDA audit)
note and M18 matmul structural/oracle/QMD2D/regression gates.
om2

const OBWG_SM_ARCH_121 ulong 121
const OBWG_VECADD_INSNS ulong 32
const OBWG_VECADD_BYTES ulong 512

global obwg_m17_count ulong 1
global obwg_m17_passed ulong 1
global obwg_m18_count ulong 1
global obwg_m18_passed ulong 1
global obwg_use_mock ulong 1

fn obwg_set_mock enable ulong to void
  put obwg_use_mock 0 enable
end

fn obwg_get_m17_gate_snapshot dst edit ulong 2 to void
  put dst 0 get obwg_m17_count 0
  put dst 1 get obwg_m17_passed 0
end

fn obwg_get_m18_gate_snapshot dst edit ulong 2 to void
  put dst 0 get obwg_m18_count 0
  put dst 1 get obwg_m18_passed 0
end

fn obwg_m17_rec ok bool to void
  put obwg_m17_count 0 add get obwg_m17_count 0 1
  if ok
    put obwg_m17_passed 0 add get obwg_m17_passed 0 1
  end
end

fn obwg_m18_rec ok bool to void
  put obwg_m18_count 0 add get obwg_m18_count 0 1
  if ok
    put obwg_m18_passed 0 add get obwg_m18_passed 0 1
  end
end

fn obwg_gen_vec a edit uint 1024 b edit uint 1024 n ulong to void
  for i ulong n bound 1024
    if eq i 0
      put a 0 0xfffffffe
      put b 0 3
    else
      if eq i 1
        put a 1 0x80000000
        put b 1 0x80000000
      else
        put a i uint and add mul i 2654435761 17 0xffffffff
        put b i uint and add mul i 2246822519 31 0xffffffff
      end
    end
  end
end

fn obwg_exec_vec n ulong a view uint 1024 b view uint 1024 dst edit uint 1024 einfo edit ulong 10 to ulong
  if ne get obwg_use_mock 0 0
    for i ulong 10
      put einfo i 0
    end
    put einfo 0 n
    put einfo 4 ulong OBWE_MARKER1_PAYLOAD
    put einfo 5 ulong OBWE_MARKER2_PAYLOAD
    put einfo 6 ulong OBWE_SEM_DONE
    put einfo 7 1
    if eq obws_verify_zero_libcuda_linkage 0
      put einfo 8 1
    end
    if eq obws_verify_zero_libcuda_runtime 0
      put einfo 9 1
    end
    for i ulong n bound 1024
      put dst i uint and add ulong get a i ulong get b i 0xffffffff
    end
    ret 0
  end
  ret obws_execute_vector n a b dst einfo
end

fn obwg_m17_semantic to bool
  s0 = and add ulong 0xffffffff ulong 1 0xffffffff
  s1 = and add ulong 10 ulong 20 0xffffffff
  s2 = and add ulong 0x80000000 ulong 0x80000000 0xffffffff
  if or ne s0 0 or ne s1 30 ne s2 0
    ret false
  end
  ret true
end

fn obwg_m17_machine_binding to bool
  if or ne OBWG_SM_ARCH_121 121 or ne OBWG_VECADD_INSNS 32 ne OBWG_VECADD_BYTES 512
    ret false
  end
  ret true
end

fn obwg_m17_native_encoding to bool
  code = new uchar 512 0
  clen = bw_encode_vecadd code
  if ne clen OBWG_VECADD_BYTES
    ret false
  end
  acc = ulong 0
  for i ulong clen bound 512
    acc = xor mul acc 1099511628211 ulong get code i
  end
  ret ne acc 0
end

fn obwg_m17_qmd to bool
  cfg = new ulong 16 0
  put cfg 0 0x1004121000
  put cfg 1 0x1004122000
  put cfg 2 0x1004127000
  put cfg 3 0x1004128000
  put cfg 4 0x1004126000
  put cfg 5 64
  put cfg 6 64
  put cfg 7 1
  q0 = new uint 96 0
  q1 = new uint 96 0
  ign0 = bw_qmd0 q0 0x1004127000
  if ne bw_qmd1 cfg q1 0
    ret false
  end
  if ne bw_qmd_verify q1 0
    ret false
  end
  if ne get q1 37 0
    ret false
  end
  if ne and shr get q1 14 20 0xf 5
    ret false
  end
  if ne and shr get q1 4 23 0x7 2
    ret false
  end
  ret true
end

fn obwg_m17_run_vec_check n ulong to bool
  a = new uint 1024 0
  b = new uint 1024 0
  c = new uint 1024 0
  einfo = new ulong 10 0
  obwg_gen_vec a b n
  if ne obwg_exec_vec n a b c einfo 0
    ret false
  end
  if ne get einfo 4 ulong OBWE_MARKER1_PAYLOAD
    ret false
  end
  if ne get einfo 6 ulong OBWE_SEM_DONE
    ret false
  end
  if ne get einfo 7 1
    ret false
  end
  for i ulong n bound 1024
    want = uint and add ulong get a i ulong get b i 0xffffffff
    if ne get c i want
      ret false
    end
  end
  ret true
end

fn obwg_m17_boundary to bool
  lens = new ulong 9 0
  put lens 0 1
  put lens 1 15
  put lens 2 63
  put lens 3 64
  put lens 4 65
  put lens 5 127
  put lens 6 128
  put lens 7 256
  put lens 8 1024
  for i ulong 9
    if not obwg_m17_run_vec_check get lens i
      ret false
    end
  end
  ret true
end

fn obwg_m17_mutation_refusal to bool
  code = new uchar 512 0
  clen = bw_encode_vecadd code
  if ne clen 512
    ret false
  end
  h0 = ulong 14695981039346656037
  for i ulong 512
    h0 = mul xor h0 ulong get code i 1099511628211
  end
  put code 17 xor get code 17 1
  h1 = ulong 14695981039346656037
  for i ulong 512
    h1 = mul xor h1 ulong get code i 1099511628211
  end
  ret ne h0 h1
end

fn obwg_run_m17_gates to ulong
  put obwg_m17_count 0 0
  put obwg_m17_passed 0 0
  obwg_m17_rec obwg_m17_semantic
  obwg_m17_rec obwg_m17_machine_binding
  obwg_m17_rec obwg_m17_native_encoding
  obwg_m17_rec obwg_m17_qmd
  obwg_m17_rec obwg_m17_run_vec_check 64
  obwg_m17_rec obwg_m17_boundary
  obwg_m17_rec obwg_m17_mutation_refusal
  obwg_m17_rec eq obws_verify_zero_libcuda_linkage 0
  obwg_m17_rec eq obws_verify_zero_cuda_symbols 0
  obwg_m17_rec eq obws_verify_zero_libcuda_runtime 0
  if eq get obwg_m17_passed 0 get obwg_m17_count 0
    ret 0
  end
  ret 1
end

fn obwg_run_demo_blackwell_vector to ulong
  if obwg_m17_run_vec_check 1024
    ret 0
  end
  ret 1
end

fn obwg_m18_semantic_contract to bool
  a = new uint 4 0
  b = new uint 4 0
  c = new uint 4 0
  put a 0 1
  put a 1 2
  put a 2 3
  put a 3 4
  put b 0 5
  put b 1 6
  put b 2 7
  put b 3 8
  for r ulong 2
    for col ulong 2
      acc = ulong 0
      for k ulong 2
        acc = add acc mul ulong get a add mul r 2 k ulong get b add mul k 2 col
      end
      put c add mul r 2 col uint and acc 0xffffffff
    end
  end
  if or ne get c 0 19 ne get c 1 22
    ret false
  end
  if or ne get c 2 43 ne get c 3 50
    ret false
  end
  ret true
end

fn obwg_m18_qmd_2d to bool
  cfg = new ulong 16 0
  put cfg 0 0x10000000
  put cfg 1 0x20000000
  put cfg 2 0x30000000
  put cfg 3 0x40000000
  put cfg 4 0x50000000
  put cfg 5 256
  put cfg 6 256
  put cfg 7 1
  put cfg 8 16
  put cfg 9 16
  put cfg 10 1
  put cfg 11 1
  put cfg 12 32
  q1 = new uint 96 0
  if ne bw_qmd1 cfg q1 0
    ret false
  end
  ret eq bw_qmd_verify q1 0
end

fn obwg_run_m18_gates to ulong
  put obwg_m18_count 0 0
  put obwg_m18_passed 0 0
  obwg_m18_rec obwg_m18_semantic_contract
  obwg_m18_rec eq OBWG_SM_ARCH_121 121
  obwg_m18_rec obwg_m18_qmd_2d
  obwg_m18_rec and eq obws_verify_zero_libcuda_linkage 0 and eq obws_verify_zero_cuda_symbols 0 eq obws_verify_zero_libcuda_runtime 0
  obwg_m18_rec eq obwg_run_m17_gates 0
  if eq get obwg_m18_passed 0 get obwg_m18_count 0
    ret 0
  end
  ret 1
end

fn obwg_run_demo_blackwell_matmul to ulong
  if obwg_m18_semantic_contract
    ret 0
  end
  ret 1
end

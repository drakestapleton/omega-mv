note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_vector.c (vector spec digest, u32 wrap oracle,
note oracle verifier, and deterministic test-vector generator).
note Composes on seed/ng/sha256.om.
om2

const OMEGA_VECTOR_POISON_VALUE uint 0xdeadbeef
const VEC_TYPE_UNSIGNED_INT ulong 3
const VEC_OVERFLOW_WRAP ulong 1

text vec_spec_tag "OMEGA_VECADD_U32"

global g_vec_name uchar 64
global g_vec_name_len ulong 1
global g_vec_elem_type ulong 1
global g_vec_elem_width ulong 1
global g_vec_elem_count ulong 1
global g_vec_overflow ulong 1
global g_vec_spec_digest uchar 32
global g_vec_mismatch ulong 1

fn omega_vector_spec_init name view uchar * name_len ulong n ulong to long
  if or eq name_len 0 eq n 0
    ret -1
  end
  if gt name_len len name
    ret -1
  end
  for i ulong 64
    put g_vec_name i 0
  end
  cpy = name_len
  if gt cpy 63
    cpy = 63
  end
  for i ulong cpy bound 63
    put g_vec_name i get name i
  end
  put g_vec_name_len 0 cpy
  put g_vec_elem_type 0 VEC_TYPE_UNSIGNED_INT
  put g_vec_elem_width 0 32
  put g_vec_elem_count 0 n
  put g_vec_overflow 0 VEC_OVERFLOW_WRAP

  note Canonical spec digest: SHA-256("OMEGA_VECADD_U32" || width_u16le || count_u32le || overflow_u8)
  for i ulong 16
    put sh_dat i get vec_spec_tag i
  end
  put sh_dat 16 uchar 32
  put sh_dat 17 uchar 0
  put sh_dat 18 uchar and n 255
  put sh_dat 19 uchar and shr n 8 255
  put sh_dat 20 uchar and shr n 16 255
  put sh_dat 21 uchar and shr n 24 255
  put sh_dat 22 uchar VEC_OVERFLOW_WRAP
  sh_all 23
  for i ulong 32
    put g_vec_spec_digest i get sh_dig i
  end
  ret 0
end

fn omega_vector_get_digest dst edit uchar * to long
  if lt len dst 32
    ret -1
  end
  for i ulong 32
    put dst i get g_vec_spec_digest i
  end
  ret 0
end

fn omega_vector_oracle_u32 a view uint * b view uint * c edit uint * to void
  n = len a
  if or eq n 0 or lt len b n lt len c n
    ret
  end
  for i ulong n bound 65536
    put c i add get a i get b i
  end
end

fn omega_vector_verify_oracle a view uint * b view uint * actual_c view uint * to long
  n = len a
  if or eq n 0 or lt len b n lt len actual_c n
    ret -1
  end
  for i ulong n bound 65536
    expected = add get a i get b i
    if ne get actual_c i expected
      put g_vec_mismatch 0 i
      ret -1
    end
  end
  ret 0
end

fn omega_vector_generate_deterministic a edit uint * b edit uint * c_poison edit uint * to void
  n = len a
  if or eq n 0 or lt len b n lt len c_poison n
    ret
  end
  for i ulong n bound 65536
    if eq i 0
      put a i uint 0xfffffffe
      put b i uint 3
    else
      if eq i 1
        put a i uint 0x80000000
        put b i uint 0x80000000
      else
        put a i add uint 1000 uint i
        put b i add uint 2000 mul uint i uint 2
      end
    end
    put c_poison i OMEGA_VECTOR_POISON_VALUE
  end
end

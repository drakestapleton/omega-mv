note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/turing/ (field.c, history_selector.c):
note hex digest formatting, digest equality, SplitMix64, online running mean
note observation, minimum-cost spec ranking, and seeded Fisher-Yates shuffle.
om2

fn tur_hex_nib v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

fn tur_sm64 st edit ulong 1 to ulong
  z = add get st 0 0x9e3779b97f4a7c15
  put st 0 z
  z = mul xor z shr z 30 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 0x94d049bb133111eb
  ret xor z shr z 31
end

export fn turing_om_hex d view uchar 32 dst edit uchar 64 to void
  for i ulong 32
    b = ulong get d i
    put dst mul i 2 tur_hex_nib shr b 4
    put dst add mul i 2 1 tur_hex_nib and b 15
  end
end

export fn turing_om_digest_eq a view uchar 32 b view uchar 32 to ulong
  for i ulong 32
    if ne get a i get b i
      ret 0
    end
  end
  ret 1
end

export fn turing_om_splitmix64 st edit ulong 1 to ulong
  ret tur_sm64 st
end

export fn turing_om_bucket_observe cnt edit uint 1 mean_b edit ulong 1 cost_ps ulong to void
  c = add ulong get cnt 0 1
  put cnt 0 uint c
  m = bitcast f64 get mean_b 0
  m = add m div sub f64 cost_ps m f64 c
  put mean_b 0 bitcast ulong m
end

export fn turing_om_rank_min_cost cnt view uint 32 means view ulong 32 allowed view uint 32 nspec ulong to ulong
  lim = nspec
  if gt lim 32
    lim = 32
  end
  best = ulong 0xffffffffffffffff
  best_m = bitcast f64 ulong 0
  for k ulong lim
    if ne ulong get allowed k 0
      if ne ulong get cnt k 0
        mk = bitcast f64 get means k
        if eq best 0xffffffffffffffff
          best = k
          best_m = mk
        else
          if lt mk best_m
            best = k
            best_m = mk
          end
        end
      end
    end
  end
  ret best
end

export fn turing_om_fisher_yates ord edit uint 32 nspec ulong seed ulong to void
  st = ulong seed
  k = nspec
  while gt k 1
    z = add st 0x9e3779b97f4a7c15
    st = z
    z = mul xor z shr z 30 0xbf58476d1ce4e5b9
    z = mul xor z shr z 27 0x94d049bb133111eb
    r = xor z shr z 31
    j = rem r k
    km1 = sub k 1
    t = get ord km1
    put ord km1 get ord j
    put ord j t
    k = km1
  end
end

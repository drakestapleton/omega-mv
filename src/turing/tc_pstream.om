note
note src/turing/tc_pstream.om: Canonical probability stream (TPS1), observed-symbol
note file (TSY1), coded-file header (56 bytes), and ideal code length (G2 ub rule)
note in pure seeded OM-2. Composed after seed/ng/sha256.om.
note Normative layout: calibration/docs/CODER_SPEC.md.

const TC_OK int 0
const TC_E_ARG int -101
const TC_E_IO int -102
const TC_E_FORMAT int -103
const TC_E_DIGEST int -104
const TC_E_NORM int -105
const TC_E_ZERO int -106
const TC_E_PROFILE int -107
const TC_E_MODEL int -108
const TC_E_DATASET int -109
const TC_E_COUNT int -110
const TC_E_HEADER int -111
const TC_E_BINDING int -112
const TC_E_TRUNC int -113
const TC_E_TRAIL int -114
const TC_E_CORRUPT int -115
const TC_E_SYMBOL int -116
const TC_E_INDEX int -117

const TC_QONE ulong 65536
const TC_KMIN ulong 2
const TC_KMAX ulong 16
const TC_PS_VERSION ulong 1
const TC_PS_HEADER ulong 128
const TC_PS_REC_FIXED ulong 24
const TC_SY_VERSION ulong 1
const TC_SY_HEADER ulong 56
const TC_DIGEST ulong 32
const TC_CODED_HEADER ulong 56
const TC_CODED_VERSION ulong 1
const TC_PB_HALF ulong 16777216
const TC_PB_CAP ulong 33554432
const TC_SB_CAP ulong 524288
const TC_CB_CAP ulong 4194304
const TC_MAX_N ulong 500000
const TC_MAX_Q ulong 5000000

note Domain separators and error names
text TC_DOM_PS "turing.tc.pstream.v1"
text TC_DOM_SY "turing.tc.symbols.v1"
text TC_DOM_YM "turing.ymodel.v0"
text TC_HEX_DIG "0123456789abcdef"
text TC_ERR_OK "OK"
text TC_ERR_ARG "TC_E_ARG"
text TC_ERR_IO "TC_E_IO"
text TC_ERR_FORMAT "TC_E_FORMAT"
text TC_ERR_DIGEST "TC_E_DIGEST"
text TC_ERR_NORM "TC_E_NORM"
text TC_ERR_ZERO "TC_E_ZERO"
text TC_ERR_PROFILE "TC_E_PROFILE"
text TC_ERR_MODEL "TC_E_MODEL"
text TC_ERR_DATASET "TC_E_DATASET"
text TC_ERR_COUNT "TC_E_COUNT"
text TC_ERR_HEADER "TC_E_HEADER"
text TC_ERR_BINDING "TC_E_BINDING"
text TC_ERR_TRUNC "TC_E_TRUNC"
text TC_ERR_TRAIL "TC_E_TRAIL"
text TC_ERR_CORRUPT "TC_E_CORRUPT"
text TC_ERR_SYMBOL "TC_E_SYMBOL"
text TC_ERR_INDEX "TC_E_INDEX"
text TC_ERR_UNK "TC_E_UNKNOWN"

text TC_W_FMT_PS "not a TPS1 probability stream (magic, header or size)"
text TC_W_DIG_PS "TPS1 trailer digest does not match the stream bytes"
text TC_W_IDX_PS "record observation_index is not its position"
text TC_W_ZERO "probability entry is 0 (zero-probability policy: refuse)"
text TC_W_NORM "record entries do not sum to 65536 or norm_sum != 65536"
text TC_W_FMT_SY "not a TSY1 symbol file (magic, header or size)"
text TC_W_DIG_SY "TSY1 trailer digest does not match the symbol bytes"
text TC_W_CNT_SY "TSY1 count disagrees with size"
text TC_W_SYM "symbol outside 0..K-1"
text TC_W_PROF "profile digest mismatch"
text TC_W_MOD "model digest mismatch"
text TC_W_DAT "dataset digest mismatch"
text TC_W_PAIR_CNT "TPS1 and TSY1 K or count mismatch"
text TC_W_PAIR_DAT "TPS1 and TSY1 name different dataset digests"
text TC_W_CHDR "coded file header missing or altered"
text TC_W_CBIND "coded file is bound to a different TPS1 digest"
text TC_W_CCNT "coded file symbol count disagrees with TPS1"
text TC_W_CTRUNC "payload declared exceeds file bytes (truncated bitstream)"
text TC_W_CTRAIL "file carries trailing bytes past declared payload"
text TC_W_IO "I/O failure"
text TC_W_ARG "invalid argument"

note Streaming SHA-256 state (wraps seed/ng/sha256.om sh_blk/sh_out)
global tc_sh_h uint 8
global tc_sh_buf uchar 64
global tc_sh_n ulong 1
global tc_sh_out uchar 32

note Primary TPS1 state
global tc_ps_k ulong 1
global tc_ps_n ulong 1
global tc_ps_prof uchar 32
global tc_ps_mod uchar 32
global tc_ps_dat uchar 32
global tc_ps_dig uchar 32
global tc_ps_key ulong 500000
global tc_ps_crumb uint 500000
global tc_ps_q ushort 5000000

note Primary TSY1 state
global tc_sy_k ulong 1
global tc_sy_n ulong 1
global tc_sy_dat uchar 32
global tc_sy_dig uchar 32
global tc_sy_sym uchar 500000

note Decoded TSY1 state
global tc_dsy_k ulong 1
global tc_dsy_n ulong 1
global tc_dsy_dat uchar 32
global tc_dsy_dig uchar 32
global tc_dsy_sym uchar 500000

note Expected digests for tc_ps_expect
global tc_exp_prof uchar 32
global tc_exp_mod uchar 32
global tc_exp_dat uchar 32

note Serialized TPS1 (32 MiB split across two 16 MiB globals), TSY1, coded buffers
global tc_pb0 uchar 16777216
global tc_pb1 uchar 16777216
global tc_pb_len ulong 1
global tc_sb uchar 524288
global tc_sb_len ulong 1
global tc_db uchar 524288
global tc_db_len ulong 1
global tc_cb uchar 4194304
global tc_cb_len ulong 1
global tc_cb_plen ulong 1

note Shared I/O, output formatting, reason buffer, ub(q) memo table
global tc_iobuf uchar 65536
global tc_why uchar 512
global tc_whylen ulong 1
global tc_outbuf uchar 16384
global tc_outlen ulong 1
global tc_ubt ulong 65537

note ---------------------------------------------------------------- reason string

fn tc_why_clear to void
put tc_whylen 0 0
put tc_why 0 0
end

fn tc_why_set s view uchar * to void
n = len s
if gt n 511
n = ulong 511
end
for i ulong n bound 512
put tc_why i get s i
end
put tc_whylen 0 n
put tc_why n 0
end

note ---------------------------------------------------------------- output formatting

fn tc_out_reset to void
put tc_outlen 0 0
end

fn tc_out_byte b uchar to void
n = get tc_outlen 0
if lt n 16384
put tc_outbuf n b
put tc_outlen 0 add n 1
end
end

fn tc_out_str s view uchar * to void
for i ulong len s bound 4096
tc_out_byte get s i
end
end

fn tc_out_why to void
n = get tc_whylen 0
for i ulong n bound 512
tc_out_byte get tc_why i
end
end

fn tc_out_u64 v ulong to void
d = new uchar 24 0
k = ulong 0
x = v
while true bound 24
put d k uchar add rem x 10 48
k = add k 1
x = div x 10
if eq x 0
break
end
end
while gt k 0 bound 24
k = sub k 1
tc_out_byte get d k
end
end

fn tc_out_i64 v long to void
if lt v 0
tc_out_byte 45
if eq v -9223372036854775808
tc_out_u64 9223372036854775808
ret
end
tc_out_u64 ulong neg v
ret
end
tc_out_u64 ulong v
end

fn tc_out_hex_byte b uchar to void
v = ulong b
tc_out_byte get TC_HEX_DIG shr v 4
tc_out_byte get TC_HEX_DIG and v 15
end

fn tc_out_hex_sh nbytes ulong to void
for i ulong nbytes bound 32
tc_out_hex_byte get tc_sh_out i
end
end

fn tc_out_hex_ps_dig nbytes ulong to void
for i ulong nbytes bound 32
tc_out_hex_byte get tc_ps_dig i
end
end

fn tc_out_hex_sy_dig nbytes ulong to void
for i ulong nbytes bound 32
tc_out_hex_byte get tc_sy_dig i
end
end

fn tc_out_errname e int to void
if eq e TC_OK
tc_out_str TC_ERR_OK
ret
end
if eq e TC_E_ARG
tc_out_str TC_ERR_ARG
ret
end
if eq e TC_E_IO
tc_out_str TC_ERR_IO
ret
end
if eq e TC_E_FORMAT
tc_out_str TC_ERR_FORMAT
ret
end
if eq e TC_E_DIGEST
tc_out_str TC_ERR_DIGEST
ret
end
if eq e TC_E_NORM
tc_out_str TC_ERR_NORM
ret
end
if eq e TC_E_ZERO
tc_out_str TC_ERR_ZERO
ret
end
if eq e TC_E_PROFILE
tc_out_str TC_ERR_PROFILE
ret
end
if eq e TC_E_MODEL
tc_out_str TC_ERR_MODEL
ret
end
if eq e TC_E_DATASET
tc_out_str TC_ERR_DATASET
ret
end
if eq e TC_E_COUNT
tc_out_str TC_ERR_COUNT
ret
end
if eq e TC_E_HEADER
tc_out_str TC_ERR_HEADER
ret
end
if eq e TC_E_BINDING
tc_out_str TC_ERR_BINDING
ret
end
if eq e TC_E_TRUNC
tc_out_str TC_ERR_TRUNC
ret
end
if eq e TC_E_TRAIL
tc_out_str TC_ERR_TRAIL
ret
end
if eq e TC_E_CORRUPT
tc_out_str TC_ERR_CORRUPT
ret
end
if eq e TC_E_SYMBOL
tc_out_str TC_ERR_SYMBOL
ret
end
if eq e TC_E_INDEX
tc_out_str TC_ERR_INDEX
ret
end
tc_out_str TC_ERR_UNK
end

fn tc_out_flush fd int to int
n = get tc_outlen 0
o = ulong 0
while lt o n bound 16384
k = write fd tc_outbuf o sub n o
if le k 0
put tc_outlen 0 0
ret TC_E_IO
end
o = add o ulong k
end
put tc_outlen 0 0
ret TC_OK
end

note ---------------------------------------------------------------- hex decode

fn tc_hex_nib c uchar to int
v = int c
if ge v 48
if le v 57
ret sub v 48
end
end
if ge v 97
if le v 102
ret add sub v 97 10
end
end
ret -1
end

fn tc_unhex_to_exp s view uchar * off ulong slen ulong which ulong to int
note which: 0=tc_exp_prof, 1=tc_exp_mod, 2=tc_exp_dat
if ne slen 64
ret TC_E_ARG
end
for i ulong 32
hi = tc_hex_nib get s add off mul i 2
lo = tc_hex_nib get s add off add mul i 2 1
if lt hi 0
ret TC_E_ARG
end
if lt lo 0
ret TC_E_ARG
end
bv = uchar or shl ulong hi 4 ulong lo
if eq which 0
put tc_exp_prof i bv
else
if eq which 1
put tc_exp_mod i bv
else
put tc_exp_dat i bv
end
end
end
ret TC_OK
end

note ---------------------------------------------------------------- streaming SHA-256

fn tc_sha_blk to void
for j ulong 8
put sh_h j get tc_sh_h j
end
for j ulong 64
put sh_pad j get tc_sh_buf j
end
sh_blk 1 0
for j ulong 8
put tc_sh_h j get sh_h j
end
end

fn tc_sha_init to void
sh_init
for j ulong 8
put tc_sh_h j get sh_k add j 64
end
put tc_sh_n 0 0
end

fn tc_sha_byte b uchar to void
n = get tc_sh_n 0
put tc_sh_buf rem n 64 b
n = add n 1
put tc_sh_n 0 n
if eq rem n 64 0
tc_sha_blk
end
end

fn tc_sha_dom s view uchar * to void
for i ulong len s bound 64
tc_sha_byte get s i
end
tc_sha_byte 0
end

fn tc_sha_final to void
bits = mul get tc_sh_n 0 8
tc_sha_byte 128
while ne rem get tc_sh_n 0 64 56 bound 64
tc_sha_byte 0
end
for j ulong 8
tc_sha_byte uchar and shr bits mul sub 7 j 8 255
end
for j ulong 8
put sh_h j get tc_sh_h j
end
sh_out
for i ulong 32
put tc_sh_out i get sh_dig i
end
end

fn tc_sha_cb off ulong n ulong to void
tc_sha_init
for i ulong n bound 4194304
tc_sha_byte get tc_cb add off i
end
tc_sha_final
end

fn tc_file_sha256 path view uchar * off ulong plen ulong to int
fd = fopen path off plen 0 0
if lt fd 0
ret TC_E_IO
end
tc_sha_init
while true bound 1000000
k = read int fd tc_iobuf 0 65536
if lt k 0
z = fclose int fd
ret TC_E_IO
end
if eq k 0
break
end
kn = ulong k
for i ulong kn bound 65536
tc_sha_byte get tc_iobuf i
end
end
z = fclose int fd
tc_sha_final
ret TC_OK
end

note ---------------------------------------------------------------- 32 MiB TPS1 buffer accessors

fn tc_pb_get i ulong to uchar
if lt i TC_PB_HALF
ret get tc_pb0 i
end
ret get tc_pb1 sub i TC_PB_HALF
end

fn tc_pb_put i ulong v uchar to void
if lt i TC_PB_HALF
put tc_pb0 i v
ret
end
put tc_pb1 sub i TC_PB_HALF v
end

fn tc_pb_put_u16 o ulong v ulong to void
tc_pb_put o uchar and v 255
tc_pb_put add o 1 uchar and shr v 8 255
end

fn tc_pb_put_u32 o ulong v ulong to void
for i ulong 4
tc_pb_put add o i uchar and shr v mul i 8 255
end
end

fn tc_pb_put_u64 o ulong v ulong to void
for i ulong 8
tc_pb_put add o i uchar and shr v mul i 8 255
end
end

fn tc_pb_get_u16 o ulong to ulong
b0 = ulong tc_pb_get o
b1 = ulong tc_pb_get add o 1
ret or b0 shl b1 8
end

fn tc_pb_get_u32 o ulong to ulong
v = ulong 0
for i ulong 4
b = ulong tc_pb_get add o sub 3 i
v = or shl v 8 b
end
ret v
end

fn tc_pb_get_u64 o ulong to ulong
v = ulong 0
for i ulong 8
b = ulong tc_pb_get add o sub 7 i
v = or shl v 8 b
end
ret v
end

note Little-endian helpers on tc_sb, tc_db, tc_cb

fn tc_sb_put_u16 o ulong v ulong to void
put tc_sb o uchar and v 255
put tc_sb add o 1 uchar and shr v 8 255
end

fn tc_sb_put_u64 o ulong v ulong to void
for i ulong 8
put tc_sb add o i uchar and shr v mul i 8 255
end
end

fn tc_sb_get_u16 o ulong to ulong
b0 = ulong get tc_sb o
b1 = ulong get tc_sb add o 1
ret or b0 shl b1 8
end

fn tc_sb_get_u64 o ulong to ulong
v = ulong 0
for i ulong 8
b = ulong get tc_sb add o sub 7 i
v = or shl v 8 b
end
ret v
end

fn tc_db_put_u16 o ulong v ulong to void
put tc_db o uchar and v 255
put tc_db add o 1 uchar and shr v 8 255
end

fn tc_db_put_u64 o ulong v ulong to void
for i ulong 8
put tc_db add o i uchar and shr v mul i 8 255
end
end

fn tc_cb_put_u64 o ulong v ulong to void
for i ulong 8
put tc_cb add o i uchar and shr v mul i 8 255
end
end

fn tc_cb_get_u64 o ulong to ulong
v = ulong 0
for i ulong 8
b = ulong get tc_cb add o sub 7 i
v = or shl v 8 b
end
ret v
end

note ---------------------------------------------------------------- ideal length (G2 ub rule)

fn tc_sq62 m ulong to ulong
a = shr m 32
b = and m 4294967295
p0 = mul b b
p1 = mul a b
p2 = mul a a
c = shl p1 1
mid = add shr p0 32 and c 4294967295
lo = or and p0 4294967295 shl and mid 4294967295 32
hi = add add p2 shr c 32 shr mid 32
ret or shl hi 2 shr lo 62
end

fn tc_hibit q ulong to ulong
i = ulong 63
while eq and shr q i 1 0 bound 64
i = sub i 1
end
ret i
end

fn tc_ubcalc q ulong to ulong
ip = tc_hibit q
m = shl q sub 62 ip
f = ulong 0
for i ulong 32
m = tc_sq62 m
if ge m 9223372036854775808
f = or f shl 1 sub 31 i
m = shr m 1
end
end
l = or shl ip 32 f
x = sub 68719476736 l
ret shr add mul x 1000000 2147483648 32
end

fn tc_ubits_q16 q ulong to long
if eq q 0
ret -1
end
if gt q TC_QONE
ret -1
end
v = get tc_ubt q
if eq v 0
v = add tc_ubcalc q 1
put tc_ubt q v
end
ret long sub v 1
end

fn tc_ideal_ub lo ulong hi ulong to long
n = get tc_ps_n 0
if gt hi n
ret -1
end
if gt hi get tc_sy_n 0
ret -1
end
if gt lo hi
ret -1
end
k = get tc_ps_k 0
tot = long 0
t = lo
while lt t hi bound 500000
s = ulong get tc_sy_sym t
if ge s k
ret -1
end
qv = ulong get tc_ps_q add mul t k s
b = tc_ubits_q16 qv
if lt b 0
ret -1
end
tot = add tot b
t = add t 1
end
ret tot
end

note ---------------------------------------------------------------- TPS1 check, serialize, parse

fn tc_ps_check_row t ulong norm_sum ulong to int
k = get tc_ps_k 0
base = mul t k
s = ulong 0
for x ulong k bound 16
v = ulong get tc_ps_q add base x
if eq v 0
tc_why_set TC_W_ZERO
ret TC_E_ZERO
end
s = add s v
end
if ne s TC_QONE
tc_why_set TC_W_NORM
ret TC_E_NORM
end
if ne norm_sum TC_QONE
tc_why_set TC_W_NORM
ret TC_E_NORM
end
ret TC_OK
end

fn tc_ps_check_rows to int
k = get tc_ps_k 0
if lt k TC_KMIN
tc_why_set TC_W_ARG
ret TC_E_ARG
end
if gt k TC_KMAX
tc_why_set TC_W_ARG
ret TC_E_ARG
end
n = get tc_ps_n 0
for t ulong n bound 500000
rc = tc_ps_check_row t TC_QONE
if ne rc TC_OK
ret rc
end
end
ret TC_OK
end

fn tc_ps_hash_pb body ulong to void
tc_sha_init
tc_sha_dom TC_DOM_PS
i = ulong 0
while lt i body bound 33554432
tc_sha_byte tc_pb_get i
i = add i 1
end
tc_sha_final
end

fn tc_ps_ser_rec t ulong off ulong k ulong to void
tc_pb_put_u64 off t
tc_pb_put_u64 add off 8 get tc_ps_key t
tc_pb_put_u32 add off 16 ulong get tc_ps_crumb t
tc_pb_put_u32 add off 20 TC_QONE
qbase = mul t k
for x ulong k bound 16
qo = add off add 24 mul 2 x
qv = ulong get tc_ps_q add qbase x
tc_pb_put_u16 qo qv
end
end

fn tc_ps_serialize to int
k = get tc_ps_k 0
if lt k TC_KMIN
tc_why_set TC_W_ARG
ret TC_E_ARG
end
if gt k TC_KMAX
tc_why_set TC_W_ARG
ret TC_E_ARG
end
rc = tc_ps_check_rows
if ne rc TC_OK
ret rc
end
n = get tc_ps_n 0
rb = add TC_PS_REC_FIXED mul 2 k
body = add TC_PS_HEADER mul n rb
if gt add body TC_DIGEST TC_PB_CAP
tc_why_set TC_W_IO
ret TC_E_IO
end
for i ulong 128
tc_pb_put i 0
end
tc_pb_put 0 84
tc_pb_put 1 80
tc_pb_put 2 83
tc_pb_put 3 49
tc_pb_put_u16 4 TC_PS_VERSION
tc_pb_put 6 uchar k
tc_pb_put 7 16
tc_pb_put_u32 8 0
tc_pb_put_u64 12 n
tc_pb_put_u32 20 rb
tc_pb_put_u32 24 0
for i ulong 32
tc_pb_put add 28 i get tc_ps_prof i
tc_pb_put add 60 i get tc_ps_mod i
tc_pb_put add 92 i get tc_ps_dat i
end
off = TC_PS_HEADER
for t ulong n bound 500000
tc_ps_ser_rec t off k
off = add off rb
end
tc_ps_hash_pb body
for i ulong 32
bv = get tc_sh_out i
tc_pb_put add body i bv
put tc_ps_dig i bv
end
put tc_pb_len 0 add body TC_DIGEST
ret TC_OK
end

fn tc_ps_parse_hdr plen ulong to int
if lt plen add TC_PS_HEADER TC_DIGEST
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if ne tc_pb_get 0 84
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if ne tc_pb_get 1 80
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if ne tc_pb_get 2 83
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if ne tc_pb_get 3 49
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
body = sub plen TC_DIGEST
tc_ps_hash_pb body
for i ulong 32
if ne get tc_sh_out i tc_pb_get add body i
tc_why_set TC_W_DIG_PS
ret TC_E_DIGEST
end
end
ver = tc_pb_get_u16 4
k = ulong tc_pb_get 6
qb = ulong tc_pb_get 7
flags = tc_pb_get_u32 8
res = tc_pb_get_u32 24
res2 = tc_pb_get_u32 124
if ne ver TC_PS_VERSION
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if ne qb 16
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if ne flags 0
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if ne res 0
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if ne res2 0
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if lt k TC_KMIN
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if gt k TC_KMAX
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
ret TC_OK
end

fn tc_ps_parse_rec t ulong off ulong k ulong to int
if ne tc_pb_get_u64 off t
tc_why_set TC_W_IDX_PS
ret TC_E_INDEX
end
put tc_ps_key t tc_pb_get_u64 add off 8
put tc_ps_crumb t uint tc_pb_get_u32 add off 16
nsum = tc_pb_get_u32 add off 20
qbase = mul t k
for x ulong k bound 16
qo = add off add 24 mul 2 x
qv = tc_pb_get_u16 qo
put tc_ps_q add qbase x ushort qv
end
ret tc_ps_check_row t nsum
end

fn tc_ps_parse plen ulong to int
rc = tc_ps_parse_hdr plen
if ne rc TC_OK
ret rc
end
k = ulong tc_pb_get 6
n = tc_pb_get_u64 12
rbw = tc_pb_get_u32 20
rb = add TC_PS_REC_FIXED mul 2 k
if ne rbw rb
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
avail = sub sub plen TC_PS_HEADER TC_DIGEST
if gt n div avail rb
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if ne add add TC_PS_HEADER mul n rb TC_DIGEST plen
tc_why_set TC_W_FMT_PS
ret TC_E_FORMAT
end
if gt n TC_MAX_N
tc_why_set TC_W_IO
ret TC_E_IO
end
if gt mul n k TC_MAX_Q
tc_why_set TC_W_IO
ret TC_E_IO
end
put tc_ps_k 0 k
put tc_ps_n 0 n
for i ulong 32
put tc_ps_prof i tc_pb_get add 28 i
put tc_ps_mod i tc_pb_get add 60 i
put tc_ps_dat i tc_pb_get add 92 i
put tc_ps_dig i get tc_sh_out i
end
off = TC_PS_HEADER
for t ulong n bound 500000
rc2 = tc_ps_parse_rec t off k
if ne rc2 TC_OK
ret rc2
end
off = add off rb
end
ret TC_OK
end

note ---------------------------------------------------------------- TSY1 serialize and parse

fn tc_sy_serialize use_dsy ulong to int
k = ulong 0
n = ulong 0
if eq use_dsy 0
k = get tc_sy_k 0
n = get tc_sy_n 0
else
k = get tc_dsy_k 0
n = get tc_dsy_n 0
end
if lt k TC_KMIN
tc_why_set TC_W_ARG
ret TC_E_ARG
end
if gt k TC_KMAX
tc_why_set TC_W_ARG
ret TC_E_ARG
end
body = add TC_SY_HEADER n
if gt add body TC_DIGEST TC_SB_CAP
tc_why_set TC_W_IO
ret TC_E_IO
end
for t ulong n bound 500000
sv = ulong 0
if eq use_dsy 0
sv = ulong get tc_sy_sym t
else
sv = ulong get tc_dsy_sym t
end
if ge sv k
tc_why_set TC_W_SYM
ret TC_E_SYMBOL
end
end
if eq use_dsy 0
for i ulong 56
put tc_sb i 0
end
put tc_sb 0 84
put tc_sb 1 83
put tc_sb 2 89
put tc_sb 3 49
tc_sb_put_u16 4 TC_SY_VERSION
put tc_sb 6 uchar k
tc_sb_put_u64 8 n
for i ulong 32
put tc_sb add 24 i get tc_sy_dat i
end
for t ulong n bound 500000
put tc_sb add TC_SY_HEADER t get tc_sy_sym t
end
tc_sha_init
tc_sha_dom TC_DOM_SY
for i ulong body bound 524288
tc_sha_byte get tc_sb i
end
tc_sha_final
for i ulong 32
bv = get tc_sh_out i
put tc_sb add body i bv
put tc_sy_dig i bv
end
put tc_sb_len 0 add body TC_DIGEST
else
for i ulong 56
put tc_db i 0
end
put tc_db 0 84
put tc_db 1 83
put tc_db 2 89
put tc_db 3 49
tc_db_put_u16 4 TC_SY_VERSION
put tc_db 6 uchar k
tc_db_put_u64 8 n
for i ulong 32
put tc_db add 24 i get tc_dsy_dat i
end
for t ulong n bound 500000
put tc_db add TC_SY_HEADER t get tc_dsy_sym t
end
tc_sha_init
tc_sha_dom TC_DOM_SY
for i ulong body bound 524288
tc_sha_byte get tc_db i
end
tc_sha_final
for i ulong 32
bv = get tc_sh_out i
put tc_db add body i bv
put tc_dsy_dig i bv
end
put tc_db_len 0 add body TC_DIGEST
end
ret TC_OK
end

fn tc_sy_parse slen ulong to int
if lt slen add TC_SY_HEADER TC_DIGEST
tc_why_set TC_W_FMT_SY
ret TC_E_FORMAT
end
if ne get tc_sb 0 84
tc_why_set TC_W_FMT_SY
ret TC_E_FORMAT
end
if ne get tc_sb 1 83
tc_why_set TC_W_FMT_SY
ret TC_E_FORMAT
end
if ne get tc_sb 2 89
tc_why_set TC_W_FMT_SY
ret TC_E_FORMAT
end
if ne get tc_sb 3 49
tc_why_set TC_W_FMT_SY
ret TC_E_FORMAT
end
body = sub slen TC_DIGEST
tc_sha_init
tc_sha_dom TC_DOM_SY
for i ulong body bound 524288
tc_sha_byte get tc_sb i
end
tc_sha_final
for i ulong 32
if ne get tc_sh_out i get tc_sb add body i
tc_why_set TC_W_DIG_SY
ret TC_E_DIGEST
end
end
ver = tc_sb_get_u16 4
k = ulong get tc_sb 6
r7 = ulong get tc_sb 7
r16 = tc_sb_get_u64 16
n = tc_sb_get_u64 8
if ne ver TC_SY_VERSION
tc_why_set TC_W_FMT_SY
ret TC_E_FORMAT
end
if ne r7 0
tc_why_set TC_W_FMT_SY
ret TC_E_FORMAT
end
if ne r16 0
tc_why_set TC_W_FMT_SY
ret TC_E_FORMAT
end
if lt k TC_KMIN
tc_why_set TC_W_FMT_SY
ret TC_E_FORMAT
end
if gt k TC_KMAX
tc_why_set TC_W_FMT_SY
ret TC_E_FORMAT
end
if ne n sub body TC_SY_HEADER
tc_why_set TC_W_CNT_SY
ret TC_E_COUNT
end
if gt n TC_MAX_N
tc_why_set TC_W_IO
ret TC_E_IO
end
for t ulong n bound 500000
sv = ulong get tc_sb add TC_SY_HEADER t
if ge sv k
tc_why_set TC_W_SYM
ret TC_E_SYMBOL
end
put tc_sy_sym t uchar sv
end
put tc_sy_k 0 k
put tc_sy_n 0 n
for i ulong 32
put tc_sy_dat i get tc_sb add 24 i
put tc_sy_dig i get tc_sh_out i
end
ret TC_OK
end

note ---------------------------------------------------------------- expect, pair, coded header

fn tc_ps_expect chk_p ulong chk_m ulong chk_d ulong to int
if ne chk_p 0
for i ulong 32
if ne get tc_exp_prof i get tc_ps_prof i
tc_why_set TC_W_PROF
ret TC_E_PROFILE
end
end
end
if ne chk_m 0
for i ulong 32
if ne get tc_exp_mod i get tc_ps_mod i
tc_why_set TC_W_MOD
ret TC_E_MODEL
end
end
end
if ne chk_d 0
for i ulong 32
if ne get tc_exp_dat i get tc_ps_dat i
tc_why_set TC_W_DAT
ret TC_E_DATASET
end
end
end
ret TC_OK
end

fn tc_pair_check to int
pk = get tc_ps_k 0
pn = get tc_ps_n 0
sk = get tc_sy_k 0
sn = get tc_sy_n 0
if ne pk sk
tc_why_set TC_W_PAIR_CNT
ret TC_E_COUNT
end
if ne pn sn
tc_why_set TC_W_PAIR_CNT
ret TC_E_COUNT
end
for i ulong 32
if ne get tc_ps_dat i get tc_sy_dat i
tc_why_set TC_W_PAIR_DAT
ret TC_E_DATASET
end
end
for t ulong sn bound 500000
if ge ulong get tc_sy_sym t sk
tc_why_set TC_W_SYM
ret TC_E_SYMBOL
end
end
ret TC_OK
end

fn tc_coded_hdr_write cid ulong payload ulong to void
for i ulong 56
put tc_cb i 0
end
put tc_cb 0 84
put tc_cb 1 67
if eq cid 1
put tc_cb 2 82
else
put tc_cb 2 65
end
put tc_cb 3 49
put tc_cb 4 uchar TC_CODED_VERSION
put tc_cb 5 uchar cid
tc_cb_put_u64 8 get tc_ps_n 0
for i ulong 32
put tc_cb add 16 i get tc_ps_dig i
end
tc_cb_put_u64 48 payload
end

fn tc_coded_hdr_check cid ulong clen ulong to int
if lt clen TC_CODED_HEADER
tc_why_set TC_W_CHDR
ret TC_E_HEADER
end
m2 = uchar 65
if eq cid 1
m2 = uchar 82
end
if ne get tc_cb 0 84
tc_why_set TC_W_CHDR
ret TC_E_HEADER
end
if ne get tc_cb 1 67
tc_why_set TC_W_CHDR
ret TC_E_HEADER
end
if ne get tc_cb 2 m2
tc_why_set TC_W_CHDR
ret TC_E_HEADER
end
if ne get tc_cb 3 49
tc_why_set TC_W_CHDR
ret TC_E_HEADER
end
if ne ulong get tc_cb 4 TC_CODED_VERSION
tc_why_set TC_W_CHDR
ret TC_E_HEADER
end
if ne ulong get tc_cb 5 cid
tc_why_set TC_W_CHDR
ret TC_E_HEADER
end
if ne get tc_cb 6 0
tc_why_set TC_W_CHDR
ret TC_E_HEADER
end
if ne get tc_cb 7 0
tc_why_set TC_W_CHDR
ret TC_E_HEADER
end
for i ulong 32
if ne get tc_cb add 16 i get tc_ps_dig i
tc_why_set TC_W_CBIND
ret TC_E_BINDING
end
end
n = tc_cb_get_u64 8
pl = tc_cb_get_u64 48
if ne n get tc_ps_n 0
tc_why_set TC_W_CCNT
ret TC_E_COUNT
end
avail = sub clen TC_CODED_HEADER
if gt pl avail
tc_why_set TC_W_CTRUNC
ret TC_E_TRUNC
end
if lt pl avail
tc_why_set TC_W_CTRAIL
ret TC_E_TRAIL
end
put tc_cb_plen 0 pl
ret TC_OK
end

note ---------------------------------------------------------------- whole-file I/O

fn tc_copy_io_pb tot ulong kn ulong to void
for i ulong kn bound 65536
tc_pb_put add tot i get tc_iobuf i
end
end

fn tc_copy_io_sb tot ulong kn ulong to void
for i ulong kn bound 65536
put tc_sb add tot i get tc_iobuf i
end
end

fn tc_copy_io_cb tot ulong kn ulong to void
for i ulong kn bound 65536
put tc_cb add tot i get tc_iobuf i
end
end

fn tc_copy_pb_io pos ulong chk ulong to void
for i ulong chk bound 65536
put tc_iobuf i tc_pb_get add pos i
end
end

fn tc_write_iobuf fd int chk ulong to int
wo = ulong 0
while lt wo chk bound 65536
k = write fd tc_iobuf wo sub chk wo
if le k 0
ret TC_E_IO
end
wo = add wo ulong k
end
ret TC_OK
end

fn tc_read_pb path view uchar * off ulong plen ulong to int
fd = fopen path off plen 0 0
if lt fd 0
tc_why_set TC_W_IO
ret TC_E_IO
end
tot = ulong 0
while true bound 1000000
k = read int fd tc_iobuf 0 65536
if lt k 0
z = fclose int fd
tc_why_set TC_W_IO
ret TC_E_IO
end
if eq k 0
break
end
kn = ulong k
if gt add tot kn TC_PB_CAP
z = fclose int fd
tc_why_set TC_W_IO
ret TC_E_IO
end
tc_copy_io_pb tot kn
tot = add tot kn
end
z = fclose int fd
put tc_pb_len 0 tot
ret TC_OK
end

fn tc_write_pb path view uchar * off ulong plen ulong to int
fd = fopen path off plen 577 420
if lt fd 0
tc_why_set TC_W_IO
ret TC_E_IO
end
tot = get tc_pb_len 0
pos = ulong 0
while lt pos tot bound 1000
remn = sub tot pos
chk = ulong 65536
if lt remn chk
chk = remn
end
tc_copy_pb_io pos chk
if ne tc_write_iobuf int fd chk TC_OK
z = fclose int fd
tc_why_set TC_W_IO
ret TC_E_IO
end
pos = add pos chk
end
z = fclose int fd
if ne z 0
tc_why_set TC_W_IO
ret TC_E_IO
end
ret TC_OK
end

fn tc_read_sb path view uchar * off ulong plen ulong to int
fd = fopen path off plen 0 0
if lt fd 0
tc_why_set TC_W_IO
ret TC_E_IO
end
tot = ulong 0
while true bound 1000
k = read int fd tc_iobuf 0 65536
if lt k 0
z = fclose int fd
tc_why_set TC_W_IO
ret TC_E_IO
end
if eq k 0
break
end
kn = ulong k
if gt add tot kn TC_SB_CAP
z = fclose int fd
tc_why_set TC_W_IO
ret TC_E_IO
end
tc_copy_io_sb tot kn
tot = add tot kn
end
z = fclose int fd
put tc_sb_len 0 tot
ret TC_OK
end

fn tc_write_sb path view uchar * off ulong plen ulong use_db ulong to int
fd = fopen path off plen 577 420
if lt fd 0
tc_why_set TC_W_IO
ret TC_E_IO
end
tot = get tc_sb_len 0
if ne use_db 0
tot = get tc_db_len 0
end
pos = ulong 0
while lt pos tot bound 1000
k = long 0
if eq use_db 0
k = write int fd tc_sb pos sub tot pos
else
k = write int fd tc_db pos sub tot pos
end
if le k 0
z = fclose int fd
tc_why_set TC_W_IO
ret TC_E_IO
end
pos = add pos ulong k
end
z = fclose int fd
if ne z 0
tc_why_set TC_W_IO
ret TC_E_IO
end
ret TC_OK
end

fn tc_read_cb path view uchar * off ulong plen ulong to int
fd = fopen path off plen 0 0
if lt fd 0
tc_why_set TC_W_IO
ret TC_E_IO
end
tot = ulong 0
while true bound 1000
k = read int fd tc_iobuf 0 65536
if lt k 0
z = fclose int fd
tc_why_set TC_W_IO
ret TC_E_IO
end
if eq k 0
break
end
kn = ulong k
if gt add tot kn TC_CB_CAP
z = fclose int fd
tc_why_set TC_W_IO
ret TC_E_IO
end
tc_copy_io_cb tot kn
tot = add tot kn
end
z = fclose int fd
put tc_cb_len 0 tot
ret TC_OK
end

fn tc_write_cb path view uchar * off ulong plen ulong to int
fd = fopen path off plen 577 420
if lt fd 0
tc_why_set TC_W_IO
ret TC_E_IO
end
tot = get tc_cb_len 0
pos = ulong 0
while lt pos tot bound 1000
k = write int fd tc_cb pos sub tot pos
if le k 0
z = fclose int fd
tc_why_set TC_W_IO
ret TC_E_IO
end
pos = add pos ulong k
end
z = fclose int fd
if ne z 0
tc_why_set TC_W_IO
ret TC_E_IO
end
ret TC_OK
end

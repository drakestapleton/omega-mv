note ---- Output helpers ----

fn tf_out_flush to void
  n = get g_tf_olen 0
  if gt n 0
    ign = write int 1 g_tf_out 0 n
    put g_tf_olen 0 0
  end
end

fn tf_out_b c uchar to void
  n = get g_tf_olen 0
  if ge n 65536
    tf_out_flush
    n = 0
  end
  put g_tf_out n c
  put g_tf_olen 0 add n 1
end

fn tf_out_txt s view uchar * to void
  n = len s
  for i ulong n bound 4096
    tf_out_b get s i
  end
end

fn tf_out_cstr buf view uchar * off ulong cap ulong to void
  for i ulong cap bound 4096
    c = get buf add off i
    if eq c uchar 0
      break
    end
    tf_out_b c
  end
end

fn tf_out_sp n ulong to void
  for i ulong n bound 256
    tf_out_b uchar 32
  end
end

fn tf_out_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    tf_out_b uchar 48
    ret
  end
  n = ulong 0
  x = v
  while gt x 0 bound 24
    put tmp n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = n
  while gt i 0 bound 24
    i = sub i 1
    tf_out_b get tmp i
  end
end

fn tf_out_u64_w v ulong w ulong to void
  tmp = new uchar 24 0
  n = ulong 0
  if eq v 0
    put tmp 0 uchar 48
    n = 1
  else
    x = v
    while gt x 0 bound 24
      put tmp n uchar add 48 rem x 10
      x = div x 10
      n = add n 1
    end
  end
  if lt n w
    tf_out_sp sub w n
  end
  i = n
  while gt i 0 bound 24
    i = sub i 1
    tf_out_b get tmp i
  end
end

fn tf_out_hex64 v ulong to void
  for i ulong 16
    sh = mul sub 15 i 4
    nib = and shr v sh 15
    tf_out_b get t_tf_hx nib
  end
end

fn tf_u64_ndigits v ulong to ulong
  if eq v 0
    ret 1
  end
  n = ulong 0
  t = v
  while gt t 0 bound 24
    t = div t 10
    n = add n 1
  end
  ret n
end

fn tf_out_frac fp ulong dscale ulong prec ulong to void
  divp = div dscale 10
  for i ulong prec bound 8
    dig = rem div fp divp 10
    tf_out_b uchar add 48 dig
    if gt divp 1
      divp = div divp 10
    end
  end
end

fn tf_round_even ax f64 dscale ulong to ulong
  s = mul ax f64 dscale
  fl = ulong s
  r = sub s f64 fl
  if gt r 0.5
    ret add fl 1
  end
  if eq r 0.5
    if ne and fl 1 0
      ret add fl 1
    end
  end
  ret fl
end

fn tf_out_f64_fix x f64 prec ulong width ulong to void
  dscale = ulong 1
  for i ulong prec bound 8
    dscale = mul dscale 10
  end
  neg_f = lt x 0.0
  ax = x
  if neg_f
    ax = neg x
  end
  iv = tf_round_even ax dscale
  ip = div iv dscale
  fp = rem iv dscale
  tot = add tf_u64_ndigits ip add 1 prec
  if neg_f
    tot = add tot 1
  end
  if lt tot width
    tf_out_sp sub width tot
  end
  if neg_f
    tf_out_b uchar 45
  end
  tf_out_u64 ip
  tf_out_b uchar 46
  tf_out_frac fp dscale prec
end

note ---- Math helpers ----

fn tf_llround x f64 to long
  if ge x 0.0
    ret long add x 0.5
  end
  ret neg long add neg x 0.5
end

fn tf_fabs x f64 to f64
  if lt x 0.0
    ret neg x
  end
  ret x
end

fn tf_log2 x f64 to f64
  u = bitcast ulong x
  eb = and shr u 52 2047
  e = sub long eb 1023
  mb = or and u ulong 0x000fffffffffffff ulong 0x3ff0000000000000
  m = bitcast f64 mb
  if gt m bitcast f64 ulong 0x3ff6a09e667f3bcd
    m = mul m 0.5
    e = add e 1
  end
  t = div sub m 1.0 add m 1.0
  t2 = mul t t
  s = t
  p = t
  k = ulong 3
  while le k 15 bound 8
    p = mul p t2
    s = add s div p f64 k
    k = add k 2
  end
  lnm = mul 2.0 s
  ret add f64 e mul lnm bitcast f64 ulong 0x3ff71547652b82fe
end


  put g_tf_shk 61 uint 0xa4506ceb
  put g_tf_shk 62 uint 0xbef9a3f7
  put g_tf_shk 63 uint 0xc67178f2
end

fn tf_sh_load_w to void
  for i ulong 16
    b0 = ulong get g_tf_shb mul i 4
    b1 = ulong get g_tf_shb add mul i 4 1
    b2 = ulong get g_tf_shb add mul i 4 2
    b3 = ulong get g_tf_shb add mul i 4 3
    put g_tf_shw i uint or shl b0 24 or shl b1 16 or shl b2 8 b3
  end
  i = ulong 16
  while lt i 64 bound 64
    x = get g_tf_shw sub i 15
    s0 = xor or shr x 7 shl x 25 xor or shr x 18 shl x 14 shr x 3
    y = get g_tf_shw sub i 2
    s1 = xor or shr y 17 shl y 15 xor or shr y 19 shl y 13 shr y 10
    put g_tf_shw i add add get g_tf_shw sub i 16 s0 add get g_tf_shw sub i 7 s1
    i = add i 1
  end
end

fn tf_sh_t1 j ulong to uint
  e = get g_tf_shv 4
  r1 = or shr e 6 shl e 26
  r2 = or shr e 11 shl e 21
  r3 = or shr e 25 shl e 7
  s1 = xor xor r1 r2 r3
  ch = xor and e get g_tf_shv 5 and not e get g_tf_shv 6
  ret add add get g_tf_shv 7 s1 add ch add get g_tf_shk j get g_tf_shw j
end

fn tf_sh_t2 to uint
  a = get g_tf_shv 0
  b = get g_tf_shv 1
  c = get g_tf_shv 2
  r1 = or shr a 2 shl a 30
  r2 = or shr a 13 shl a 19
  r3 = or shr a 22 shl a 10
  s0 = xor xor r1 r2 r3
  maj = xor xor and a b and a c and b c
  ret add s0 maj
end

fn tf_sh_round j ulong to void
  t1 = tf_sh_t1 j
  t2 = tf_sh_t2
  put g_tf_shv 7 get g_tf_shv 6
  put g_tf_shv 6 get g_tf_shv 5
  put g_tf_shv 5 get g_tf_shv 4
  put g_tf_shv 4 add get g_tf_shv 3 t1
  put g_tf_shv 3 get g_tf_shv 2
  put g_tf_shv 2 get g_tf_shv 1
  put g_tf_shv 1 get g_tf_shv 0
  put g_tf_shv 0 add t1 t2
end

fn tf_sh_block to void
  tf_sh_load_w
  for i ulong 8
    put g_tf_shv i get g_tf_shh i
  end
  for j ulong 64
    tf_sh_round j
  end
  for i ulong 8
    put g_tf_shh i add get g_tf_shh i get g_tf_shv i
  end
end

fn tf_sh_init to void
  tf_sh_init_k
  put g_tf_shh 0 uint 0x6a09e667
  put g_tf_shh 1 uint 0xbb67ae85
  put g_tf_shh 2 uint 0x3c6ef372
  put g_tf_shh 3 uint 0xa54ff53a
  put g_tf_shh 4 uint 0x510e527f
  put g_tf_shh 5 uint 0x9b05688c
  put g_tf_shh 6 uint 0x1f83d9ab
  put g_tf_shh 7 uint 0x5be0cd19
  put g_tf_shm 0 0
  put g_tf_shm 1 0
end

fn tf_sh_byte b uchar to void
  idx = get g_tf_shm 0
  put g_tf_shb idx b
  idx = add idx 1
  put g_tf_shm 1 add get g_tf_shm 1 1
  if eq idx 64
    tf_sh_block
    put g_tf_shm 0 0
  else
    put g_tf_shm 0 idx
  end
end

fn tf_sh_slice s view uchar * n ulong to void
  for i ulong n bound 65536
    tf_sh_byte get s i
  end
end

fn tf_sh_final to void
  tot_bits = mul get g_tf_shm 1 8
  tf_sh_byte uchar 128
  while ne get g_tf_shm 0 56 bound 128
    tf_sh_byte uchar 0
  end
  for i ulong 8
    sh = mul sub 7 i 8
    tf_sh_byte uchar and shr tot_bits sh 255
  end
  for i ulong 8
    w = ulong get g_tf_shh i
    o = mul i 4
    put g_tf_sh_out o uchar and shr w 24 255
    put g_tf_sh_out add o 1 uchar and shr w 16 255
    put g_tf_sh_out add o 2 uchar and shr w 8 255
    put g_tf_sh_out add o 3 uchar and w 255
  end
end

note ---- Digest helpers ----

fn tf_dig_to_hex_tmp to void
  for i ulong 32
    b = ulong get g_tf_tmp_dig i
    put g_tf_tmp_hex mul i 2 get t_tf_hx shr b 4
    put g_tf_tmp_hex add mul i 2 1 get t_tf_hx and b 15
  end
end

fn tf_dig_out_full to void
  tf_dig_to_hex_tmp
  for i ulong 64
    tf_out_b get g_tf_tmp_hex i
  end
end

fn tf_dig_out_short to void
  tf_dig_to_hex_tmp
  for i ulong 12
    tf_out_b get g_tf_tmp_hex i
  end
end

fn tf_file_digest_gp to long
  fd = fopen g_tf_path 0 get g_tf_plen 0 int 0 int 0
  if lt fd 0
    ret -1
  end
  tf_sh_init
  done = false
  while not done bound 1000000
    k = read int fd g_tf_fbuf 0 8192
    if lt k 0
      ign = fclose int fd
      ret -1
    end
    if eq k 0
      done = true
    else
      ku = ulong k
      for i ulong ku bound 8192
        tf_sh_byte get g_tf_fbuf i
      end
    end
  end
  ign = fclose int fd
  tf_sh_final
  ret 0
end

fn tf_set_path_txt s view uchar * to void
  n = len s
  for i ulong n bound 512
    put g_tf_path i get s i
  end
  put g_tf_plen 0 n
end

fn tf_set_path_cstr_rc idx ulong to void
  base = mul idx TF_PATH
  n = ulong 0
  for i ulong TF_PATH
    c = get g_rc_path add base i
    if eq c uchar 0
      break
    end
    put g_tf_path i c
    n = add n 1
  end
  put g_tf_plen 0 n
end

fn tf_set_path_cstr_ev idx ulong to void
  base = mul idx TF_PATH
  n = ulong 0
  for i ulong TF_PATH
    c = get g_ev_rpath add base i
    if eq c uchar 0
      break
    end
    put g_tf_path i c
    n = add n 1
  end
  put g_tf_plen 0 n
end

note ---- String helpers over global buffers ----

fn tf_tmp_fam_eq s view uchar * to bool
  n = len s
  if ge n 32
    ret false
  end
  for i ulong n bound 32
    if ne get g_tf_tmp_fam i get s i
      ret false
    end
  end
  ret eq get g_tf_tmp_fam n uchar 0
end

fn tf_ev_tier_eq idx ulong s view uchar * to bool
  off = mul idx 8
  n = len s
  if ge n 8
    ret false
  end
  for i ulong n bound 8
    if ne get g_ev_tier add off i get s i
      ret false
    end
  end
  ret eq get g_ev_tier add off n uchar 0
end

fn tf_dc_crz_eq did ulong k ulong s view uchar * to bool
  off = add mul did mul TF_MAX_CAND 32 mul k 32
  n = len s
  if ge n 32
    ret false
  end
  for i ulong n bound 32
    if ne get g_dc_crz add off i get s i
      ret false
    end
  end
  ret eq get g_dc_crz add off n uchar 0
end

fn tf_dc_verd_eq did ulong s view uchar * to bool
  off = mul did 16
  n = len s
  if ge n 16
    ret false
  end
  for i ulong n bound 16
    if ne get g_dc_verd add off i get s i
      ret false
    end
  end
  ret eq get g_dc_verd add off n uchar 0
end

fn tf_dc_tres_eq did ulong s view uchar * to bool
  off = mul did 16
  n = len s
  if ge n 16
    ret false
  end
  for i ulong n bound 16
    if ne get g_dc_tres add off i get s i
      ret false
    end
  end
  ret eq get g_dc_tres add off n uchar 0
end

fn tf_dc_sel_eq did ulong s view uchar * to bool
  off = mul did 32
  n = len s
  if ge n 32
    ret false
  end
  for i ulong n bound 32
    if ne get g_dc_sel add off i get s i
      ret false
    end
  end
  ret eq get g_dc_sel add off n uchar 0
end

note ---- OMG0 canonical builder (attributes + relations) ----

fn tf_tv_clr to void
  put g_tf_tvl 0 0
end

fn tf_tv_b c uchar to void
  n = get g_tf_tvl 0
  if lt n 1024
    put g_tf_tv n c
    put g_tf_tvl 0 add n 1
  end
end

fn tf_tv_txt s view uchar * to void
  n = len s
  for i ulong n bound 1024
    tf_tv_b get s i
  end
end

fn tf_tv_u64 v ulong to void
  if eq v 0
    tf_tv_b uchar 48
    ret
  end
  tmp = new uchar 24 0
  n = ulong 0
  x = v
  while gt x 0 bound 24
    put tmp n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = n
  while gt i 0 bound 24
    i = sub i 1
    tf_tv_b get tmp i
  end
end

fn tf_tv_dig_tmp to void
  tf_dig_to_hex_tmp
  for i ulong 64
    tf_tv_b get g_tf_tmp_hex i
  end
end

fn tf_tk_set key view uchar * to void
  n = len key
  for i ulong n bound 128
    put g_tf_tk i get key i
  end
  put g_tf_tkl 0 n
end

fn tf_ob_add_kv to void
  if ne get g_tf_ob_err 0 0
    ret
  end
  na = get g_tf_ob_na 0
  kl = get g_tf_tkl 0
  vl = get g_tf_tvl 0
  if ge na 32
    put g_tf_ob_err 0 1
    ret
  end
  if ge kl 64
    put g_tf_ob_err 0 1
    ret
  end
  if gt vl 512
    put g_tf_ob_err 0 1
    ret
  end
  ko = mul na 64
  for i ulong kl bound 64
    put g_tf_ob_ak add ko i get g_tf_tk i
  end
  put g_tf_ob_akl na kl
  vo = mul na 512
  for i ulong vl bound 512
    put g_tf_ob_av add vo i get g_tf_tv i
  end
  put g_tf_ob_avl na vl
  put g_tf_ob_na 0 add na 1
end

fn tf_ob_reset rec view uchar * to void
  put g_tf_ob_na 0 0
  put g_tf_ob_nr 0 0
  put g_tf_ob_err 0 0
  tf_tv_clr
  tf_tv_txt rec
  tf_tk_set t_tf_k_record
  tf_ob_add_kv
end

fn tf_ob_add_k key view uchar * to void
  tf_tk_set key
  tf_ob_add_kv
end

fn tf_ob_add_txt key view uchar * val view uchar * to void
  tf_tv_clr
  tf_tv_txt val
  tf_ob_add_k key
end

fn tf_ob_add_u64 key view uchar * v ulong to void
  tf_tv_clr
  tf_tv_u64 v
  tf_ob_add_k key
end

fn tf_ob_add_dig_tmp key view uchar * to void
  tf_tv_clr
  tf_tv_dig_tmp
  tf_ob_add_k key
end

fn tf_ob_add_rel_tmp rkind ulong to void
  if ne get g_tf_ob_err 0 0
    ret
  end
  nr = get g_tf_ob_nr 0
  if ge nr 64
    put g_tf_ob_err 0 1
    ret
  end
  put g_tf_ob_rk nr rkind
  ro = mul nr 32
  for i ulong 32
    put g_tf_ob_rt add ro i get g_tf_tmp_dig i
  end
  put g_tf_ob_nr 0 add nr 1
end

fn tf_ob_key_lt a ulong b ulong to bool
  la = get g_tf_ob_akl a
  lb = get g_tf_ob_akl b
  m = la
  if lt lb m
    m = lb
  end
  oa = mul a 64
  ob = mul b 64
  for i ulong m bound 64
    ca = get g_tf_ob_ak add oa i
    cb = get g_tf_ob_ak add ob i
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret lt la lb
end

fn tf_ob_sort_attr to void
  na = get g_tf_ob_na 0
  for i ulong na bound 32
    put g_tf_ob_aord i i
  end
  i = ulong 1
  while lt i na bound 32
    key = get g_tf_ob_aord i
    j = i
    while gt j 0 bound 32
      prev = get g_tf_ob_aord sub j 1
      if tf_ob_key_lt key prev
        put g_tf_ob_aord j prev
        j = sub j 1
      else
        break
      end
    end
    put g_tf_ob_aord j key
    i = add i 1
  end
end

fn tf_ob_rel_lt a ulong b ulong to bool
  ka = get g_tf_ob_rk a
  kb = get g_tf_ob_rk b
  if lt ka kb
    ret true
  end
  if gt ka kb
    ret false
  end
  oa = mul a 32
  ob = mul b 32
  for i ulong 32
    ca = get g_tf_ob_rt add oa i
    cb = get g_tf_ob_rt add ob i
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret false
end

fn tf_ob_sort_rel to void
  nr = get g_tf_ob_nr 0
  for i ulong nr bound 64
    put g_tf_ob_rord i i
  end
  i = ulong 1
  while lt i nr bound 64
    key = get g_tf_ob_rord i
    j = i
    while gt j 0 bound 64
      prev = get g_tf_ob_rord sub j 1
      if tf_ob_rel_lt key prev
        put g_tf_ob_rord j prev
        j = sub j 1
      else
        break
      end
    end
    put g_tf_ob_rord j key
    i = add i 1
  end
end

fn tf_cb_u8 b uchar to void
  n = get g_tf_clen 0
  if lt n TF_CANON_CAP
    put g_tf_cbuf n b
    put g_tf_clen 0 add n 1
  else
    put g_tf_ob_err 0 1
  end
end

fn tf_cb_u16be v ulong to void
  tf_cb_u8 uchar and shr v 8 255
  tf_cb_u8 uchar and v 255
end

fn tf_cb_u32be v ulong to void
  tf_cb_u8 uchar and shr v 24 255
  tf_cb_u8 uchar and shr v 16 255
  tf_cb_u8 uchar and shr v 8 255
  tf_cb_u8 uchar and v 255
end

fn tf_ob_encode kind ulong to long
  if ne get g_tf_ob_err 0 0
    ret -1
  end
  tf_ob_sort_attr
  tf_ob_sort_rel
  put g_tf_clen 0 0
  tf_cb_u8 uchar 79
  tf_cb_u8 uchar 77
  tf_cb_u8 uchar 71
  tf_cb_u8 uchar 48
  tf_cb_u8 uchar 1
  tf_cb_u8 uchar kind
  na = get g_tf_ob_na 0
  tf_cb_u16be na
  for i ulong na bound 32
    ai = get g_tf_ob_aord i
    kl = get g_tf_ob_akl ai
    tf_cb_u8 uchar kl
    ko = mul ai 64
    for j ulong kl bound 64
      tf_cb_u8 get g_tf_ob_ak add ko j
    end
    vl = get g_tf_ob_avl ai
    tf_cb_u16be vl
    vo = mul ai 512
    for j ulong vl bound 512
      tf_cb_u8 get g_tf_ob_av add vo j
    end
  end
  nr = get g_tf_ob_nr 0
  tf_cb_u16be nr
  for i ulong nr bound 64
    ri = get g_tf_ob_rord i
    tf_cb_u16be get g_tf_ob_rk ri
    ro = mul ri 32
    for j ulong 32
      tf_cb_u8 get g_tf_ob_rt add ro j
    end
  end
  tf_cb_u16be 0
  tf_cb_u32be 0
  if ne get g_tf_ob_err 0 0
    ret -1
  end
  ret 0
end

fn tf_ob_finish kind ulong dom view uchar * to long
  if ne tf_ob_encode kind 0
    ret -1
  end
  tf_sh_init
  tf_sh_slice dom len dom
  tf_sh_byte uchar 0
  n = get g_tf_clen 0
  for i ulong n bound 40000
    tf_sh_byte get g_tf_cbuf i
  end
  tf_sh_final
  ret 0
end

note ---- Reason name helper ----

fn tf_tv_reason r ulong to void
  if eq r TF_R_CHOSEN
    tf_tv_txt t_tf_rn0
    ret
  end
  if eq r TF_R_RANKED
    tf_tv_txt t_tf_rn1
    ret
  end
  if eq r TF_R_TIED
    tf_tv_txt t_tf_rn2
    ret
  end
  if eq r TF_R_CONTRACT_MISMATCH
    tf_tv_txt t_tf_rn3
    ret
  end
  if eq r TF_R_NOT_EXACT
    tf_tv_txt t_tf_rn4
    ret
  end
  if eq r TF_R_MAX_N
    tf_tv_txt t_tf_rn5
    ret
  end
  if eq r TF_R_NO_EVIDENCE
    tf_tv_txt t_tf_rn6
    ret
  end
  if eq r TF_R_RECEIPT_UNVERIFIED
    tf_tv_txt t_tf_rn7
    ret
  end
  if eq r TF_R_UNVERIFIED_RUN
    tf_tv_txt t_tf_rn8
    ret
  end
  if eq r TF_R_CONTENTION_FORCED
    tf_tv_txt t_tf_rn9
    ret
  end
  if eq r TF_R_TIER
    tf_tv_txt t_tf_rn10
    ret
  end
  if eq r TF_R_EXPLORE
    tf_tv_txt t_tf_rn11
    ret
  end
  tf_tv_txt t_tf_rn_unk
end

fn tf_out_reason r ulong to void
  tf_tv_clr
  tf_tv_reason r
  n = get g_tf_tvl 0
  for i ulong n bound 64
    tf_out_b get g_tf_tv i
  end
end

note ---- Contract ----

fn tf_contract_omega_x sid ulong to void
  off96 = mul sid TF_TEXT
  off256 = mul sid 256
  for i ulong TF_TEXT
    put g_st_c_name add off96 i uchar 0
    put g_st_c_ex add off96 i uchar 0
    put g_st_c_ovf add off96 i uchar 0
    put g_st_c_ora add off96 i uchar 0
    put g_st_c_src add off96 i uchar 0
  end
  for i ulong 256
    put g_st_c_stmt add off256 i uchar 0
  end
  n = len t_tf_c_name
  for i ulong n bound 96
    put g_st_c_name add off96 i get t_tf_c_name i
  end
  n = len t_tf_c_stmt
  for i ulong n bound 256
    put g_st_c_stmt add off256 i get t_tf_c_stmt i
  end
  n = len t_tf_c_exact
  for i ulong n bound 96
    put g_st_c_ex add off96 i get t_tf_c_exact i
  end
  n = len t_tf_c_ovf
  for i ulong n bound 96
    put g_st_c_ovf add off96 i get t_tf_c_ovf i
  end
  n = len t_tf_c_oracle
  for i ulong n bound 96
    put g_st_c_ora add off96 i get t_tf_c_oracle i
  end
  n = len t_tf_c_src
  for i ulong n bound 96
    put g_st_c_src add off96 i get t_tf_c_src i
  end
  put g_st_c_maxn sid TF_OMA_RZ_MAX_N
end

fn tf_tv_cstr_st_name sid ulong to void
  off = mul sid TF_TEXT
  for i ulong TF_TEXT
    c = get g_st_c_name add off i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
end

fn tf_contract_digest sid ulong to long
  off96 = mul sid TF_TEXT
  off256 = mul sid 256
  tf_ob_reset t_tf_rec_contract
  tf_ob_add_txt t_tf_k_status t_tf_c_status
  tf_tv_clr
  tf_tv_cstr_st_name sid
  tf_ob_add_k t_tf_k_name
  tf_tv_clr
  for i ulong 256
    c = get g_st_c_stmt add off256 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_stmt
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_st_c_ex add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_exactness
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_st_c_ovf add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_overflow
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_st_c_ora add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_oracle
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_st_c_src add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_source
  tf_ob_add_u64 t_tf_k_max_n get g_st_c_maxn sid
  ret tf_ob_finish TF_KIND_OP t_tf_dom_contract
end

note ---- Spec ----

fn tf_spec_obj idx ulong to long
  tf_ob_reset t_tf_rec_spec
  doff = mul idx 32
  for i ulong 32
    put g_tf_tmp_dig i get g_sp_cdig add doff i
  end
  tf_ob_add_dig_tmp t_tf_k_contract
  off32 = mul idx 32
  tf_tv_clr
  for i ulong 32
    c = get g_sp_rz add off32 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_rz_id
  off96 = mul idx TF_TEXT
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_sp_alg add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_algorithm
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_sp_alge add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_algebra
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_sp_rep add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_repr
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_sp_prec add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_precision
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_sp_lang add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_language
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_sp_back add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_backend
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_sp_mcls add off96 i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_mclass
  tf_ob_add_u64 t_tf_k_max_n get g_sp_maxn idx
  tf_ob_add_u64 t_tf_k_exact get g_sp_exact idx
  tf_ob_add_u64 t_tf_k_wbase get g_sp_wbase idx
  ret 0
end

fn tf_spec_digest idx ulong to long
  ign = tf_spec_obj idx
  ret tf_ob_finish TF_KIND_RZ t_tf_dom_spec
end

fn tf_spec_bytes idx ulong to long
  ign = tf_spec_obj idx
  ret tf_ob_encode TF_KIND_RZ
end

fn tf_fam_id_tmp to long
  if tf_tmp_fam_eq t_tf_fam0
    ret 0
  end
  if tf_tmp_fam_eq t_tf_fam1
    ret 1
  end
  if tf_tmp_fam_eq t_tf_fam2
    ret 2
  end
  if tf_tmp_fam_eq t_tf_fam3
    ret 3
  end
  if tf_tmp_fam_eq t_tf_fam4
    ret 4
  end
  if tf_tmp_fam_eq t_tf_fam5
    ret 5
  end
  if tf_tmp_fam_eq t_tf_fam6
    ret 6
  end
  ret -1
end

fn tf_sp_put_alge idx ulong fid ulong to void
  off = mul idx TF_TEXT
  if eq fid 0
    n = len t_tf_falg0
    for i ulong n bound 96
      put g_sp_alge add off i get t_tf_falg0 i
    end
    ret
  end
  if eq fid 4
    n = len t_tf_falg4
    for i ulong n bound 96
      put g_sp_alge add off i get t_tf_falg4 i
    end
    ret
  end
  if eq fid 5
    n = len t_tf_falg5
    for i ulong n bound 96
      put g_sp_alge add off i get t_tf_falg5 i
    end
    ret
  end
  n = len t_tf_falg1
  for i ulong n bound 96
    put g_sp_alge add off i get t_tf_falg1 i
  end
end

fn tf_sp_put_rep idx ulong fid ulong to void
  off = mul idx TF_TEXT
  if eq fid 0
    n = len t_tf_frep0
    for i ulong n bound 96
      put g_sp_rep add off i get t_tf_frep0 i
    end
    ret
  end
  if eq fid 1
    n = len t_tf_frep1
    for i ulong n bound 96
      put g_sp_rep add off i get t_tf_frep1 i
    end
    ret
  end
  if eq fid 2
    n = len t_tf_frep2
    for i ulong n bound 96
      put g_sp_rep add off i get t_tf_frep2 i
    end
    ret
  end
  if eq fid 3
    n = len t_tf_frep3
    for i ulong n bound 96
      put g_sp_rep add off i get t_tf_frep3 i
    end
    ret
  end
  if eq fid 4
    n = len t_tf_frep4
    for i ulong n bound 96
      put g_sp_rep add off i get t_tf_frep4 i
    end
    ret
  end
  if eq fid 5
    n = len t_tf_frep5
    for i ulong n bound 96
      put g_sp_rep add off i get t_tf_frep5 i
    end
    ret
  end
  n = len t_tf_frep6
  for i ulong n bound 96
    put g_sp_rep add off i get t_tf_frep6 i
  end
end

fn tf_spec_zero idx ulong to void
  off32 = mul idx 32
  off96 = mul idx TF_TEXT
  for i ulong 32
    put g_sp_rz add off32 i uchar 0
  end
  for i ulong TF_TEXT
    put g_sp_alg add off96 i uchar 0
    put g_sp_alge add off96 i uchar 0
    put g_sp_rep add off96 i uchar 0
    put g_sp_prec add off96 i uchar 0
    put g_sp_lang add off96 i uchar 0
    put g_sp_back add off96 i uchar 0
    put g_sp_mcls add off96 i uchar 0
  end
end

fn tf_spec_fill_const idx ulong to void
  off96 = mul idx TF_TEXT
  for i ulong len t_tf_prec bound 96
    put g_sp_prec add off96 i get t_tf_prec i
  end
  for i ulong len t_tf_lang bound 96
    put g_sp_lang add off96 i get t_tf_lang i
  end
  for i ulong len t_tf_back bound 96
    put g_sp_back add off96 i get t_tf_back i
  end
  for i ulong len t_tf_mcls bound 96
    put g_sp_mcls add off96 i get t_tf_mcls i
  end
end

fn tf_spec_fill_alg idx ulong rzlen ulong to void
  off96 = mul idx TF_TEXT
  pos = ulong 0
  for i ulong len t_tf_alg_pre bound 32
    put g_sp_alg add off96 pos get t_tf_alg_pre i
    pos = add pos 1
  end
  for i ulong rzlen bound 32
    put g_sp_alg add off96 pos get g_tf_tmp_id i
    pos = add pos 1
  end
  for i ulong len t_tf_alg_suf bound 32
    if lt pos 95
      put g_sp_alg add off96 pos get t_tf_alg_suf i
      pos = add pos 1
    end
  end
end

fn tf_spec_fill_tmp sid ulong idx ulong exact ulong wbase ulong maxn ulong to long
  fid = tf_fam_id_tmp
  if lt fid 0
    ret -1
  end
  tf_spec_zero idx
  off32 = mul idx 32
  coff = mul sid 32
  for i ulong 32
    put g_sp_cdig add off32 i get g_st_cdig add coff i
  end
  rzlen = ulong 0
  for i ulong 31
    c = get g_tf_tmp_id i
    if eq c uchar 0
      break
    end
    put g_sp_rz add off32 i c
    rzlen = add rzlen 1
  end
  tf_spec_fill_alg idx rzlen
  tf_sp_put_alge idx ulong fid
  tf_sp_put_rep idx ulong fid
  tf_spec_fill_const idx
  put g_sp_maxn idx maxn
  put g_sp_exact idx exact
  put g_sp_wbase idx wbase
  ret 0
end

fn tf_find_spec_tmp sid ulong to long
  ns = get g_st_nspec sid
  sbase = mul sid TF_MAX_SPECS
  for k ulong ns bound 32
    off = mul add sbase k 32
    ok = true
    for i ulong 32
      a = get g_sp_rz add off i
      b = get g_tf_tmp_id i
      if ne a b
        ok = false
        break
      end
      if eq a uchar 0
        break
      end
    end
    if ok
      ret long k
    end
  end
  ret -1
end

fn tf_find_spec_txt sid ulong rz view uchar * to long
  n = len rz
  if ge n 32
    ret -1
  end
  for i ulong n bound 32
    put g_tf_tmp_id i get rz i
  end
  put g_tf_tmp_id n uchar 0
  ret tf_find_spec_tmp sid
end

fn tf_store_add_spec_tmp sid ulong exact ulong wbase ulong maxn ulong to long
  ns = get g_st_nspec sid
  sbase = mul sid TF_MAX_SPECS
  k = tf_find_spec_tmp sid
  if ge k 0
    if ge ns TF_MAX_SPECS
      ret -1
    end
    tmp_idx = add sbase ns
    if ne tf_spec_fill_tmp sid tmp_idx exact wbase maxn 0
      ret -1
    end
    if ne tf_spec_digest tmp_idx 0
      ret -1
    end
    koff = mul add sbase ulong k 32
    for i ulong 32
      if ne get g_sp_id add koff i get g_tf_sh_out i
        ret -1
      end
    end
    ret k
  end
  if ge ns TF_MAX_SPECS
    ret -1
  end
  idx = add sbase ns
  if ne tf_spec_fill_tmp sid idx exact wbase maxn 0
    ret -1
  end
  if ne tf_spec_digest idx 0
    ret -1
  end
  ioff = mul idx 32
  for i ulong 32
    put g_sp_id add ioff i get g_tf_sh_out i
  end
  put g_st_nspec sid add ns 1
  ret long ns
end

fn tf_set_tmp_id rz view uchar * to void
  n = len rz
  for i ulong n bound 32
    put g_tf_tmp_id i get rz i
  end
  put g_tf_tmp_id n uchar 0
end

fn tf_set_tmp_fam fam view uchar * to void
  m = len fam
  for i ulong m bound 32
    put g_tf_tmp_fam i get fam i
  end
  put g_tf_tmp_fam m uchar 0
end

fn tf_store_init sid ulong to long
  put g_st_nspec sid 0
  put g_st_nev sid 0
  put g_st_nrec sid 0
  tf_contract_omega_x sid
  if ne tf_contract_digest sid 0
    ret -1
  end
  coff = mul sid 32
  for i ulong 32
    put g_st_cdig add coff i get g_tf_sh_out i
  end
  ret 0
end

fn tf_ingest_registry sid ulong to long
  tf_set_tmp_id t_tf_rz0
  tf_set_tmp_fam t_tf_fam0
  if lt tf_store_add_spec_tmp sid 1 1 TF_OMA_RZ_MAX_N 0
    ret -1
  end
  tf_set_tmp_id t_tf_rz1
  tf_set_tmp_fam t_tf_fam0
  if lt tf_store_add_spec_tmp sid 1 0 TF_OMA_RZ_MAX_N 0
    ret -1
  end
  tf_set_tmp_id t_tf_rz2
  tf_set_tmp_fam t_tf_fam0
  if lt tf_store_add_spec_tmp sid 1 0 TF_OMA_RZ_MAX_N 0
    ret -1
  end
  tf_set_tmp_id t_tf_rz3
  tf_set_tmp_fam t_tf_fam0
  if lt tf_store_add_spec_tmp sid 1 0 TF_OMA_RZ_MAX_N 0
    ret -1
  end
  tf_set_tmp_id t_tf_rz4
  tf_set_tmp_fam t_tf_fam1
  if lt tf_store_add_spec_tmp sid 1 0 TF_OMA_RZ_MAX_N 0
    ret -1
  end
  tf_set_tmp_id t_tf_rz5
  tf_set_tmp_fam t_tf_fam2
  if lt tf_store_add_spec_tmp sid 1 0 TF_OMA_RZ_MAX_N 0
    ret -1
  end
  tf_set_tmp_id t_tf_rz6
  tf_set_tmp_fam t_tf_fam3
  if lt tf_store_add_spec_tmp sid 1 0 TF_OMA_RZ_MAX_N 0
    ret -1
  end
  tf_set_tmp_id t_tf_rz7
  tf_set_tmp_fam t_tf_fam4
  if lt tf_store_add_spec_tmp sid 1 0 65536 0
    ret -1
  end
  tf_set_tmp_id t_tf_rz8
  tf_set_tmp_fam t_tf_fam5
  if lt tf_store_add_spec_tmp sid 1 0 64512 0
    ret -1
  end
  tf_set_tmp_id t_tf_rz9
  tf_set_tmp_fam t_tf_fam6
  if lt tf_store_add_spec_tmp sid 1 0 TF_OMA_RZ_MAX_N 0
    ret -1
  end
  ret 10
end

note ---- Evidence digest & cost ----

fn tf_ev_add_cstr_96 key view uchar * arr_id ulong idx ulong to void
  off = mul idx TF_TEXT
  tf_tv_clr
  for i ulong TF_TEXT
    c = uchar 0
    if eq arr_id 0
      c = get g_ev_runid add off i
    end
    if eq arr_id 1
      c = get g_ev_tsrc add off i
    end
    if eq arr_id 2
      c = get g_ev_tc add off i
    end
    if eq arr_id 3
      c = get g_ev_cpuf add off i
    end
    if eq arr_id 4
      c = get g_ev_qflag add off i
    end
    if eq arr_id 5
      c = get g_ev_therm add off i
    end
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k key
end

fn tf_ev_digest_part1 idx ulong to void
  doff = mul idx 32
  for i ulong 32
    put g_tf_tmp_dig i get g_ev_spid add doff i
  end
  tf_ob_add_dig_tmp t_tf_k_spec
  tf_ob_add_u64 t_tf_k_n get g_ev_n idx
  tf_ob_add_u64 t_tf_k_m get g_ev_m idx
  tf_ob_add_u64 t_tf_k_sp_milli get g_ev_spm idx
  for i ulong 32
    put g_tf_tmp_dig i get g_ev_rdig add doff i
  end
  tf_ob_add_dig_tmp t_tf_k_receipt
  tf_ev_add_cstr_96 t_tf_k_run_id 0 idx
  toff = mul idx 8
  tf_tv_clr
  for i ulong 8
    c = get g_ev_tier add toff i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_tier
  tf_ev_add_cstr_96 t_tf_k_tier_src 1 idx
  tf_ob_add_u64 t_tf_k_verified get g_ev_ver idx
  tf_ob_add_u64 t_tf_k_forced get g_ev_forced idx
  tf_ob_add_u64 t_tf_k_retries get g_ev_ret idx
  tf_ob_add_u64 t_tf_k_samples get g_ev_samp idx
  tf_ob_add_u64 t_tf_k_med_ps get g_ev_med idx
  tf_ob_add_u64 t_tf_k_q25_ps get g_ev_q25 idx
  tf_ob_add_u64 t_tf_k_q75_ps get g_ev_q75 idx
  tf_ob_add_u64 t_tf_k_min_ps get g_ev_min idx
  tf_ob_add_u64 t_tf_k_pack_ps get g_ev_pack idx
end

fn tf_evidence_digest idx ulong to long
  tf_ob_reset t_tf_rec_ev
  tf_ev_digest_part1 idx
  tf_ob_add_u64 t_tf_k_noise_ppm get g_ev_nppm idx
  tf_ob_add_u64 t_tf_k_pnoise_ppm get g_ev_pnppm idx
  tf_ob_add_u64 t_tf_k_wbytes get g_ev_wb idx
  tf_ob_add_u64 t_tf_k_wsbytes get g_ev_wsb idx
  boff = mul idx 72
  tf_tv_clr
  for i ulong 72
    c = get g_ev_bdig add boff i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_bdig
  goff = mul idx 48
  tf_tv_clr
  for i ulong 48
    c = get g_ev_gcom add goff i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_gcom
  tf_ob_add_u64 t_tf_k_dirty get g_ev_dirty idx
  tf_ev_add_cstr_96 t_tf_k_tc 2 idx
  tf_ev_add_cstr_96 t_tf_k_cpuf 3 idx
  tf_ev_add_cstr_96 t_tf_k_qflag 4 idx
  tf_ev_add_cstr_96 t_tf_k_therm 5 idx
  ret tf_ob_finish TF_KIND_EV t_tf_dom_ev
end

fn tf_ev_cost idx ulong pack ulong to ulong
  if eq pack TF_PACK_PER_CALL
    ret add get g_ev_med idx get g_ev_pack idx
  end
  ret get g_ev_med idx
end

fn tf_find_evidence_tmp sid ulong to long
  ne_n = get g_st_nev sid
  ebase = mul sid TF_MAX_EV
  for i ulong ne_n bound 1024
    off = mul add ebase i 32
    ok = true
    for j ulong 32
      if ne get g_ev_id add off j get g_tf_tmp_dig j
        ok = false
        break
      end
    end
    if ok
      ret long i
    end
  end
  ret -1
end

note ---- Decision digest ----

fn tf_cs_lt a ulong b ulong to bool
  oa = mul a 32
  ob = mul b 32
  for i ulong 32
    ca = get g_tf_cs_buf add oa i
    cb = get g_tf_cs_buf add ob i
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret false
end

fn tf_citeset_digest did ulong to void
  nc = get g_dc_ncite did
  cbase = mul did mul TF_MAX_CITE 32
  for i ulong nc bound 128
    so = add cbase mul i 32
    do = mul i 32
    for j ulong 32
      put g_tf_cs_buf add do j get g_dc_cite add so j
    end
    put g_tf_cs_ord i i
  end
  i = ulong 1
  while lt i nc bound 128
    key = get g_tf_cs_ord i
    j = i
    while gt j 0 bound 128
      prev = get g_tf_cs_ord sub j 1
      if tf_cs_lt key prev
        put g_tf_cs_ord j prev
        j = sub j 1
      else
        break
      end
    end
    put g_tf_cs_ord j key
    i = add i 1
  end
  tf_sh_init
  tf_sh_slice t_tf_dom_cite len t_tf_dom_cite
  tf_sh_byte uchar 0
  for fi ulong nc bound 128
    ci = get g_tf_cs_ord fi
    co = mul ci 32
    for fj ulong 32
      tf_sh_byte get g_tf_cs_buf add co fj
    end
  end
  tf_sh_final
end

fn tf_dc_add_cands did ulong to long
  ncand = get g_dc_ncand did
  rbase = mul did TF_MAX_CAND
  zbase = mul did mul TF_MAX_CAND 32
  tf_tv_clr
  for i ulong ncand bound 16
    if gt i 0
      tf_tv_b uchar 59
    end
    zo = add zbase mul i 32
    for j ulong 32
      c = get g_dc_crz add zo j
      if eq c uchar 0
        break
      end
      tf_tv_b c
    end
    tf_tv_b uchar 61
    tf_tv_reason get g_dc_reas add rbase i
    tf_tv_b uchar 58
    tf_tv_u64 get g_dc_cost add rbase i
  end
  if gt get g_tf_tvl 0 512
    put g_tf_ob_err 0 1
    ret -1
  end
  tf_ob_add_k t_tf_k_cands
  ret 0
end

fn tf_decision_digest did ulong to long
  ncand = get g_dc_ncand did
  ncite = get g_dc_ncite did
  if gt ncand TF_MAX_CAND
    ret -1
  end
  if gt ncite TF_MAX_CITE
    ret -1
  end
  tf_ob_reset t_tf_rec_dec
  doff = mul did 32
  for i ulong 32
    put g_tf_tmp_dig i get g_dc_cdig add doff i
  end
  tf_ob_add_dig_tmp t_tf_k_contract
  tf_tv_clr
  for i ulong 32
    c = get g_dc_sel add doff i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_sel
  coff = mul did TF_TEXT
  tf_tv_clr
  for i ulong TF_TEXT
    c = get g_dc_cons add coff i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_cons
  tf_ob_add_u64 t_tf_k_n get g_dc_n did
  tf_ob_add_u64 t_tf_k_m get g_dc_m did
  tf_ob_add_u64 t_tf_k_sp_milli get g_dc_spm did
  if eq get g_dc_pack did TF_PACK_PER_CALL
    tf_ob_add_txt t_tf_k_pack t_tf_pack_pc
  else
    tf_ob_add_txt t_tf_k_pack t_tf_pack_oa
  end
  tf_ob_add_u64 t_tf_k_cell_n get g_dc_cn did
  tf_ob_add_u64 t_tf_k_cell_m get g_dc_cm did
  tf_ob_add_u64 t_tf_k_cell_sp get g_dc_cspm did
  tf_ob_add_u64 t_tf_k_exact_c get g_dc_exc did
  if ne tf_dc_add_cands did 0
    ret -1
  end
  ch = get g_dc_chosen did
  if and ge ch 0 lt ulong ch ncand
    zo = add mul did mul TF_MAX_CAND 32 mul ulong ch 32
    tf_tv_clr
    for i ulong 32
      c = get g_dc_crz add zo i
      if eq c uchar 0
        break
      end
      tf_tv_b c
    end
    tf_ob_add_k t_tf_k_chosen
  else
    tf_ob_add_txt t_tf_k_chosen t_tf_dash
  end
  voff = mul did 16
  tf_tv_clr
  for i ulong 16
    c = get g_dc_verd add voff i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_verdict
  tf_tv_clr
  for i ulong 16
    c = get g_dc_tres add voff i
    if eq c uchar 0
      break
    end
    tf_tv_b c
  end
  tf_ob_add_k t_tf_k_tieres
  tf_ob_add_u64 t_tf_k_margin get g_dc_mppm did
  tf_ob_add_u64 t_tf_k_band get g_dc_bppm did
  if ne get g_dc_hsup did 0
    for i ulong 32
      put g_tf_tmp_dig i get g_dc_sup add doff i
    end
    tf_ob_add_dig_tmp t_tf_k_super
  else
    tf_ob_add_txt t_tf_k_super t_tf_none
  end
  cand_base = mul did mul TF_MAX_CAND 32
  for i ulong ncand bound 16
    co = add cand_base mul i 32
    for j ulong 32
      put g_tf_tmp_dig j get g_dc_cand add co j
    end
    tf_ob_add_rel_tmp TF_REL_DEPENDS_ON
  end
  tf_ob_add_u64 t_tf_k_cite_cnt ncite
  if gt ncite 0
    tf_citeset_digest did
    for j ulong 32
      put g_tf_tmp_dig j get g_tf_sh_out j
    end
    tf_ob_add_rel_tmp TF_REL_DERIVED_FROM
  end
  ret tf_ob_finish TF_KIND_EV t_tf_dom_dec
end

note ---- JSON line parser for receipts ----

fn tf_read_file_gp to long
  fd = fopen g_tf_path 0 get g_tf_plen 0 int 0 int 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  done = false
  while not done bound 100000
    rem_c = sub 524287 tot
    if eq rem_c 0
      ign = fclose int fd
      ret -1
    end
    rd = rem_c
    if gt rd 8192
      rd = 8192
    end
    k = read int fd g_tf_fbuf 0 rd
    if lt k 0
      ign = fclose int fd
      ret -1
    end
    if eq k 0
      done = true
    else
      ku = ulong k
      for i ulong ku bound 8192
        put g_tf_file add tot i get g_tf_fbuf i
      end
      tot = add tot ku
    end
  end
  ign = fclose int fd
  put g_tf_file tot uchar 0
  put g_tf_flen 0 tot
  ret 0
end

fn tf_line_starts ls ulong le_pos ulong pat view uchar * to bool
  pn = len pat
  if gt add ls pn le_pos
    ret false
  end
  for i ulong pn bound 64
    if ne get g_tf_file add ls i get pat i
      ret false
    end
  end
  ret true
end

fn tf_line_contains ls ulong le_pos ulong pat view uchar * to bool
  pn = len pat
  if eq pn 0
    ret true
  end
  if gt pn sub le_pos ls
    ret false
  end
  lim = sub le_pos pn
  p = ls
  while le p lim bound 4096
    ok = true
    for i ulong pn bound 64
      if ne get g_tf_file add p i get pat i
        ok = false
        break
      end
    end
    if ok
      ret true
    end
    p = add p 1
  end
  ret false
end

fn tf_jpat_build key view uchar * to ulong
  kn = len key
  put g_tf_jpat 0 uchar 34
  for i ulong kn bound 64
    put g_tf_jpat add i 1 get key i
  end
  put g_tf_jpat add kn 1 uchar 34
  put g_tf_jpat add kn 2 uchar 58
  put g_tf_jpat add kn 3 uchar 32
  ret add kn 4
end

fn tf_jfind_pat ls ulong le_pos ulong plen ulong to long
  if gt plen sub le_pos ls
    ret -1
  end
  lim = sub le_pos plen
  p = ls
  while le p lim bound 4096
    ok = true
    for i ulong plen bound 80
      if ne get g_tf_file add p i get g_tf_jpat i
        ok = false
        break
      end
    end
    if ok
      ret long add p plen
    end
    p = add p 1
  end
  ret -1
end

fn tf_jfind ls ulong le_pos ulong key view uchar * to long
  plen = tf_jpat_build key
  ret tf_jfind_pat ls le_pos plen
end

fn tf_jstr ls ulong le_pos ulong key view uchar * cap ulong to long
  pos = tf_jfind ls le_pos key
  if lt pos 0
    ret -1
  end
  p = ulong pos
  if ge p le_pos
    ret -1
  end
  if ne get g_tf_file p uchar 34
    ret -1
  end
  p = add p 1
  k = ulong 0
  while lt p le_pos bound 2048
    c = get g_tf_file p
    if eq c uchar 34
      put g_tf_jval k uchar 0
      ret long k
    end
    if eq c uchar 92
      if lt add p 1 le_pos
        p = add p 1
        c = get g_tf_file p
      end
    end
    if ge add k 1 cap
      ret -1
    end
    put g_tf_jval k c
    k = add k 1
    p = add p 1
  end
  ret -1
end

fn tf_jnum_exp p ulong le_pos ulong val f64 to f64
  if ge p le_pos
    ret val
  end
  ec = get g_tf_file p
  if and ne ec uchar 101 ne ec uchar 69
    ret val
  end
  p = add p 1
  eneg = false
  if lt p le_pos
    sc = get g_tf_file p
    if eq sc uchar 45
      eneg = true
      p = add p 1
    else
      if eq sc uchar 43
        p = add p 1
      end
    end
  end
  ev = ulong 0
  while lt p le_pos bound 16
    c = get g_tf_file p
    if and ge c uchar 48 le c uchar 57
      ev = add mul ev 10 sub ulong c 48
      p = add p 1
    else
      break
    end
  end
  res = val
  for ei ulong ev bound 308
    if eneg
      res = mul res 0.1
    else
      res = mul res 10.0
    end
  end
  ret res
end

fn tf_jnum_at p ulong le_pos ulong to long
  while lt p le_pos bound 64
    if ne get g_tf_file p uchar 32
      break
    end
    p = add p 1
  end
  if ge p le_pos
    ret -1
  end
  neg_f = false
  c = get g_tf_file p
  if eq c uchar 45
    neg_f = true
    p = add p 1
  else
    if eq c uchar 43
      p = add p 1
    end
  end
  val = f64 0.0
  ndig = ulong 0
  while lt p le_pos bound 64
    c = get g_tf_file p
    if and ge c uchar 48 le c uchar 57
      val = add mul val 10.0 f64 sub ulong c 48
      ndig = add ndig 1
      p = add p 1
    else
      break
    end
  end
  if lt p le_pos
    if eq get g_tf_file p uchar 46
      p = add p 1
      frac = f64 0.1
      while lt p le_pos bound 64
        c = get g_tf_file p
        if and ge c uchar 48 le c uchar 57
          val = add val mul frac f64 sub ulong c 48
          frac = mul frac 0.1
          ndig = add ndig 1
          p = add p 1
        else
          break
        end
      end
    end
  end
  if eq ndig 0
    ret -1
  end
  val = tf_jnum_exp p le_pos val
  if neg_f
    val = neg val
  end
  put g_tf_jnum 0 val
  ret 0
end

fn tf_jnum ls ulong le_pos ulong key view uchar * to long
  pos = tf_jfind ls le_pos key
  if lt pos 0
    ret -1
  end
  ret tf_jnum_at ulong pos le_pos
end

fn tf_ju64 ls ulong le_pos ulong key view uchar * to long
  if ne tf_jnum ls le_pos key 0
    ret -1
  end
  v = get g_tf_jnum 0
  if lt v 0.0
    ret -1
  end
  if gt v 1.8e19
    ret -1
  end
  put g_tf_ju64 0 ulong tf_llround v
  ret 0
end

fn tf_jbool ls ulong le_pos ulong key view uchar * to long
  pos = tf_jfind ls le_pos key
  if lt pos 0
    ret -1
  end
  p = ulong pos
  if tf_line_starts p le_pos t_tf_j_true
    put g_tf_jbool 0 1
    ret 0
  end
  if tf_line_starts p le_pos t_tf_j_false
    put g_tf_jbool 0 0
    ret 0
  end
  ret -1
end

fn tf_copy_jval_to_hdr target ulong cap ulong to void
  for i ulong cap bound 96
    c = get g_tf_jval i
    if eq target 0
      put g_tf_hdr_sch i c
    end
    if eq target 1
      put g_tf_hdr_rid i c
    end
    if eq target 2
      put g_tf_hdr_com i c
    end
    if eq target 3
      put g_tf_hdr_bin i c
    end
    if eq target 4
      put g_tf_hdr_cc i c
    end
    if eq c uchar 0
      break
    end
  end
end

fn tf_fmt_thermal t0 ulong t1 ulong to void
  tf_tv_clr
  tf_tv_txt t_tf_soc_p1
  tf_tv_u64 t0
  tf_tv_txt t_tf_soc_p2
  tf_tv_u64 t1
  tf_tv_txt t_tf_soc_p3
  n = get g_tf_tvl 0
  if gt n 95
    n = 95
  end
  for i ulong n bound 96
    put g_tf_hdr_thm i get g_tf_tv i
  end
  put g_tf_hdr_thm n uchar 0
end

fn tf_ev_clear idx ulong to void
  put g_ev_n idx 0
  put g_ev_m idx 0
  put g_ev_spm idx 0
  put g_ev_ver idx 0
  put g_ev_forced idx 0
  put g_ev_ret idx 0
  put g_ev_samp idx 0
  put g_ev_med idx 0
  put g_ev_q25 idx 0
  put g_ev_q75 idx 0
  put g_ev_min idx 0
  put g_ev_pack idx 0
  put g_ev_nppm idx 0
  put g_ev_pnppm idx 0
  put g_ev_wb idx 0
  put g_ev_wsb idx 0
  put g_ev_dirty idx 0
  o8 = mul idx 8
  for i ulong 8
    put g_ev_tier add o8 i uchar 0
  end
  o48 = mul idx 48
  for i ulong 48
    put g_ev_gcom add o48 i uchar 0
  end
  o72 = mul idx 72
  for i ulong 72
    put g_ev_bdig add o72 i uchar 0
  end
  o96 = mul idx TF_TEXT
  for i ulong TF_TEXT
    put g_ev_runid add o96 i uchar 0
    put g_ev_tsrc add o96 i uchar 0
    put g_ev_tc add o96 i uchar 0
    put g_ev_cpuf add o96 i uchar 0
    put g_ev_qflag add o96 i uchar 0
    put g_ev_therm add o96 i uchar 0
  end
  o256 = mul idx TF_PATH
  for i ulong TF_PATH
    put g_ev_rpath add o256 i uchar 0
  end
end

fn tf_ev_fill_meta idx ulong dirty ulong to void
  o256 = mul idx TF_PATH
  pl = get g_tf_plen 0
  if gt pl 255
    pl = 255
  end
  for i ulong pl bound 256
    put g_ev_rpath add o256 i get g_tf_path i
  end
  put g_ev_rpath add o256 pl uchar 0
  o96 = mul idx TF_TEXT
  for i ulong TF_TEXT
    c = get g_tf_hdr_rid i
    put g_ev_runid add o96 i c
    if eq c uchar 0
      break
    end
  end
  n = len t_tf_tier_src
  for i ulong n bound 96
    put g_ev_tsrc add o96 i get t_tf_tier_src i
  end
  o72 = mul idx 72
  for i ulong 72
    c = get g_tf_hdr_bin i
    put g_ev_bdig add o72 i c
    if eq c uchar 0
      break
    end
  end
  o48 = mul idx 48
  for i ulong 48
    c = get g_tf_hdr_com i
    put g_ev_gcom add o48 i c
    if eq c uchar 0
      break
    end
  end
  put g_ev_dirty idx dirty
  for i ulong TF_TEXT
    c = get g_tf_hdr_cc i
    put g_ev_tc add o96 i c
    if eq c uchar 0
      break
    end
  end
  n = len t_tf_nr_cpu
  for i ulong n bound 96
    put g_ev_cpuf add o96 i get t_tf_nr_cpu i
  end
  n = len t_tf_nr_qf
  for i ulong n bound 96
    put g_ev_qflag add o96 i get t_tf_nr_qf i
  end
  for i ulong TF_TEXT
    c = get g_tf_hdr_thm i
    put g_ev_therm add o96 i c
    if eq c uchar 0
      break
    end
  end
end

fn tf_parse_ev_row sid ulong ls ulong le_pos ulong dirty ulong to long
  if lt tf_jstr ls le_pos t_tf_j_rz 32 0
    ret -1
  end
  for i ulong 32
    c = get g_tf_jval i
    put g_tf_tmp_id i c
    if eq c uchar 0
      break
    end
  end
  k = tf_find_spec_tmp sid
  ne_n = get g_st_nev sid
  if or lt k 0 ge ne_n TF_MAX_EV
    ret -1
  end
  idx = add mul sid TF_MAX_EV ne_n
  tf_ev_clear idx
  if ne tf_ju64 ls le_pos t_tf_k_n 0
    ret -1
  end
  put g_ev_n idx get g_tf_ju64 0
  if ne tf_ju64 ls le_pos t_tf_k_m 0
    ret -1
  end
  put g_ev_m idx get g_tf_ju64 0
  if ne tf_jnum ls le_pos t_tf_j_sp 0
    ret -1
  end
  put g_ev_spm idx ulong tf_llround mul get g_tf_jnum 0 1000.0
  if ne tf_jbool ls le_pos t_tf_k_verified 0
    ret -1
  end
  put g_ev_ver idx ulong get g_tf_jbool 0
  if ne tf_ju64 ls le_pos t_tf_k_forced 0
    ret -1
  end
  put g_ev_forced idx get g_tf_ju64 0
  if ne tf_ju64 ls le_pos t_tf_k_retries 0
    ret -1
  end
  put g_ev_ret idx get g_tf_ju64 0
  if ne tf_ju64 ls le_pos t_tf_k_samples 0
    ret -1
  end
  put g_ev_samp idx get g_tf_ju64 0
  if ne tf_ju64 ls le_pos t_tf_k_med_ps 0
    ret -1
  end
  put g_ev_med idx get g_tf_ju64 0
  if ne tf_ju64 ls le_pos t_tf_k_q25_ps 0
    ret -1
  end
  put g_ev_q25 idx get g_tf_ju64 0
  if ne tf_ju64 ls le_pos t_tf_k_q75_ps 0
    ret -1
  end
  put g_ev_q75 idx get g_tf_ju64 0
  if ne tf_ju64 ls le_pos t_tf_k_min_ps 0
    ret -1
  end
  put g_ev_min idx get g_tf_ju64 0
  if ne tf_ju64 ls le_pos t_tf_k_pack_ps 0
    ret -1
  end
  put g_ev_pack idx get g_tf_ju64 0
  if ne tf_jnum ls le_pos t_tf_j_nrel 0
    ret -1
  end
  put g_ev_nppm idx ulong tf_llround mul get g_tf_jnum 0 1.0e6
  if ne tf_jnum ls le_pos t_tf_j_pnrel 0
    ret -1
  end
  put g_ev_pnppm idx ulong tf_llround mul get g_tf_jnum 0 1.0e6
  if ne tf_ju64 ls le_pos t_tf_k_wbytes 0
    ret -1
  end
  put g_ev_wb idx get g_tf_ju64 0
  if ne tf_ju64 ls le_pos t_tf_k_wsbytes 0
    ret -1
  end
  put g_ev_wsb idx get g_tf_ju64 0
  spoff = mul add mul sid TF_MAX_SPECS ulong k 32
  doff = mul idx 32
  for i ulong 32
    put g_ev_spid add doff i get g_sp_id add spoff i
    put g_ev_rdig add doff i get g_tf_tmp_dig2 i
  end
  tf_ev_fill_meta idx dirty
  put g_st_nev sid add ne_n 1
  ret 0
end

fn tf_schema_ok to bool
  pn = len t_tf_sch_pre
  for i ulong pn bound 32
    if ne get g_tf_hdr_sch i get t_tf_sch_pre i
      ret false
    end
  end
  sn = len t_tf_sch_suf
  sl = ulong 0
  for i ulong TF_TEXT
    if eq get g_tf_hdr_sch i uchar 0
      break
    end
    sl = add sl 1
  end
  if lt sl sn
    ret false
  end
  lim = sub sl sn
  p = ulong 0
  while le p lim bound 96
    ok = true
    for i ulong sn bound 16
      if ne get g_tf_hdr_sch add p i get t_tf_sch_suf i
        ok = false
        break
      end
    end
    if ok
      ret true
    end
    p = add p 1
  end
  ret false
end

global g_tf_ing_dirty long 1
global g_tf_ing_mm ulong 1
global g_tf_ing_sec ulong 1
global g_tf_ing_added ulong 1

fn tf_ing_sec0 ls ulong le_pos ulong to void
  if ge tf_jstr ls le_pos t_tf_j_schema TF_TEXT 0
    tf_copy_jval_to_hdr 0 TF_TEXT
  end
  if ge tf_jstr ls le_pos t_tf_j_run_id TF_TEXT 0
    tf_copy_jval_to_hdr 1 TF_TEXT
  end
  if ge tf_jstr ls le_pos t_tf_j_commit 48 0
    tf_copy_jval_to_hdr 2 48
  end
  if ge tf_jstr ls le_pos t_tf_j_bin 72 0
    tf_copy_jval_to_hdr 3 72
  end
  if ge tf_jstr ls le_pos t_tf_j_cc TF_TEXT 0
    tf_copy_jval_to_hdr 4 TF_TEXT
  end
  if eq tf_jbool ls le_pos t_tf_j_dirty 0
    put g_tf_ing_dirty 0 get g_tf_jbool 0
  end
  if tf_line_contains ls le_pos t_tf_j_host
    if eq tf_ju64 ls le_pos t_tf_j_tc0 0
      t0 = get g_tf_ju64 0
      if eq tf_ju64 ls le_pos t_tf_j_tc1 0
        tf_fmt_thermal t0 get g_tf_ju64 0
      end
    end
  end
  if tf_line_starts ls le_pos t_tf_j_rzs
    put g_tf_ing_sec 0 1
  end
end

fn tf_ing_sec1 sid ulong ls ulong le_pos ulong to long
  if ge tf_jstr ls le_pos t_tf_j_id 32 0
    for i ulong 32
      c = get g_tf_jval i
      put g_tf_tmp_id i c
      if eq c uchar 0
        break
      end
    end
    if lt tf_jstr ls le_pos t_tf_j_fam 32 0
      ret -1
    end
    for i ulong 32
      c = get g_tf_jval i
      put g_tf_tmp_fam i c
      if eq c uchar 0
        break
      end
    end
    if ne tf_ju64 ls le_pos t_tf_k_exact 0
      ret -1
    end
    ex = get g_tf_ju64 0
    if ne tf_ju64 ls le_pos t_tf_k_wbase 0
      ret -1
    end
    wb = get g_tf_ju64 0
    if ne tf_ju64 ls le_pos t_tf_k_max_n 0
      ret -1
    end
    mx = get g_tf_ju64 0
    if lt tf_store_add_spec_tmp sid ex wb mx 0
      ret -1
    end
    ret 0
  end
  if tf_line_starts ls le_pos t_tf_j_endarr
    put g_tf_ing_sec 0 2
  end
  ret 0
end

fn tf_ing_sec2 sid ulong ls ulong le_pos ulong to long
  if tf_line_starts ls le_pos t_tf_j_corr
    if eq tf_ju64 ls le_pos t_tf_j_mm 0
      put g_tf_ing_mm 0 get g_tf_ju64 0
    end
  end
  if tf_line_starts ls le_pos t_tf_j_ener
    put g_tf_ing_sec 0 3
    ret 0
  end
  if ge tf_jfind ls le_pos t_tf_j_rz 0
    if ge tf_jfind ls le_pos t_tf_k_med_ps 0
      du = ulong 0
      if gt get g_tf_ing_dirty 0 0
        du = 1
      end
      if ne tf_parse_ev_row sid ls le_pos du 0
        ret -1
      end
      put g_tf_ing_added 0 add get g_tf_ing_added 0 1
    end
  end
  ret 0
end

fn tf_ing_add_rec sid ulong to void
  nr = get g_st_nrec sid
  if ge nr TF_MAX_REC
    ret
  end
  ridx = add mul sid TF_MAX_REC nr
  rdoff = mul ridx 32
  for j ulong 32
    put g_rc_dig add rdoff j get g_tf_tmp_dig2 j
  end
  rpoff = mul ridx TF_PATH
  pl = get g_tf_plen 0
  if gt pl 255
    pl = 255
  end
  for j ulong pl bound 256
    put g_rc_path add rpoff j get g_tf_path j
  end
  put g_rc_path add rpoff pl uchar 0
  rroff = mul ridx TF_TEXT
  for j ulong TF_TEXT
    c = get g_tf_hdr_rid j
    put g_rc_runid add rroff j c
    if eq c uchar 0
      break
    end
  end
  put g_st_nrec sid add nr 1
end

fn tf_ing_finish sid ulong to long
  added = get g_tf_ing_added 0
  ev_end = get g_st_nev sid
  ev_start = sub ev_end added
  ebase = mul sid TF_MAX_EV
  mm = get g_tf_ing_mm 0
  i = ev_start
  while lt i ev_end bound 1024
    idx = add ebase i
    toff = mul idx 8
    put g_ev_tier toff uchar 69
    if and eq mm 0 ne get g_ev_ver idx 0
      put g_ev_tier add toff 1 uchar 50
    else
      put g_ev_tier add toff 1 uchar 48
    end
    put g_ev_tier add toff 2 uchar 0
    if ne tf_evidence_digest idx 0
      put g_st_nev sid ev_start
      ret -1
    end
    doff = mul idx 32
    for j ulong 32
      put g_ev_id add doff j get g_tf_sh_out j
    end
    i = add i 1
  end
  tf_ing_add_rec sid
  ret long added
end

fn tf_ing_reset_hdr to void
  put g_tf_hdr_sch 0 uchar 0
  put g_tf_hdr_rid 0 uchar 0
  put g_tf_hdr_com 0 uchar 0
  put g_tf_hdr_bin 0 uchar 0
  put g_tf_hdr_cc 0 uchar 0
  n_nr = len t_tf_nr
  for i ulong n_nr bound 32
    put g_tf_hdr_thm i get t_tf_nr i
  end
  put g_tf_hdr_thm n_nr uchar 0
  put g_tf_ing_dirty 0 -1
  put g_tf_ing_mm 0 ulong 0xffffffffffffffff
  put g_tf_ing_sec 0 0
  put g_tf_ing_added 0 0
end

fn tf_ing_valid fail bool added ulong to bool
  if fail
    ret false
  end
  if not tf_schema_ok
    ret false
  end
  if eq get g_tf_hdr_rid 0 uchar 0
    ret false
  end
  if ne get g_tf_ing_sec 0 3
    ret false
  end
  if eq added 0
    ret false
  end
  if lt get g_tf_ing_dirty 0 0
    ret false
  end
  ret true
end

fn tf_ingest_receipt_gp sid ulong to long
  if ne tf_file_digest_gp 0
    ret -1
  end
  for i ulong 32
    put g_tf_tmp_dig2 i get g_tf_sh_out i
  end
  if ne tf_read_file_gp 0
    ret -1
  end
  tf_ing_reset_hdr
  fail = false
  flen = get g_tf_flen 0
  pos = ulong 0
  while lt pos flen bound 50000
    ls = pos
    while lt pos flen bound 4096
      if eq get g_tf_file pos uchar 10
        break
      end
      pos = add pos 1
    end
    le_pos = pos
    if lt pos flen
      pos = add pos 1
    end
    sec = get g_tf_ing_sec 0
    if eq sec 0
      tf_ing_sec0 ls le_pos
    else
      if eq sec 1
        if ne tf_ing_sec1 sid ls le_pos 0
          fail = true
          break
        end
      else
        if eq sec 2
          if ne tf_ing_sec2 sid ls le_pos 0
            fail = true
            break
          end
        end
      end
    end
  end
  added = get g_tf_ing_added 0
  if not tf_ing_valid fail added
    put g_st_nev sid sub get g_st_nev sid added
    ret -1
  end
  ret tf_ing_finish sid
end

fn tf_ingest_receipt_txt sid ulong p view uchar * to long
  tf_set_path_txt p
  ret tf_ingest_receipt_gp sid
end

note ---- Decision verification ----

fn tf_why_clr to void
  put g_tf_whyl 0 0
  put g_tf_why 0 uchar 0
end

fn tf_why_b c uchar to void
  n = get g_tf_whyl 0
  if lt n 255
    put g_tf_why n c
    put g_tf_whyl 0 add n 1
    put g_tf_why add n 1 uchar 0
  end
end

fn tf_why_txt s view uchar * to void
  n = len s
  for i ulong n bound 256
    tf_why_b get s i
  end
end

fn tf_why_hex_short to void
  tf_dig_to_hex_tmp
  for i ulong 12
    tf_why_b get g_tf_tmp_hex i
  end
end

fn tf_why_ev_path idx ulong to void
  base = mul idx TF_PATH
  for i ulong TF_PATH
    c = get g_ev_rpath add base i
    if eq c uchar 0
      break
    end
    tf_why_b c
  end
end

fn tf_ev_rpath_eq a ulong b ulong to bool
  oa = mul a TF_PATH
  ob = mul b TF_PATH
  for i ulong TF_PATH
    ca = get g_ev_rpath add oa i
    cb = get g_ev_rpath add ob i
    if ne ca cb
      ret false
    end
    if eq ca uchar 0
      ret true
    end
  end
  ret true
end

fn tf_ev_rdig_eq a ulong b ulong to bool
  oa = mul a 32
  ob = mul b 32
  for i ulong 32
    if ne get g_ev_rdig add oa i get g_ev_rdig add ob i
      ret false
    end
  end
  ret true
end

global g_tf_vnchk ulong 1

fn tf_ver_cand_eq cco ulong spoff ulong to bool
  for j ulong 32
    if ne get g_dc_cand add cco j get g_ev_spid add spoff j
      ret false
    end
  end
  ret true
end

fn tf_ver_in_cand did ulong idx ulong to bool
  ncand = get g_dc_ncand did
  cand_base = mul did mul TF_MAX_CAND 32
  spoff = mul idx 32
  for c ulong ncand bound 16
    if tf_ver_cand_eq add cand_base mul c 32 spoff
      ret true
    end
  end
  ret false
end

fn tf_ver_receipt idx ulong to long
  nchk = get g_tf_vnchk 0
  for j ulong nchk bound 8
    prev = get g_tf_vchk j
    if tf_ev_rpath_eq prev idx
      if tf_ev_rdig_eq prev idx
        ret 0
      end
    end
  end
  tf_set_path_cstr_ev idx
  if ne tf_file_digest_gp 0
    tf_why_txt t_tf_w_ru1
    tf_why_ev_path idx
    tf_why_txt t_tf_w_ru2
    ret -7
  end
  spoff = mul idx 32
  for j ulong 32
    if ne get g_tf_sh_out j get g_ev_rdig add spoff j
      tf_why_txt t_tf_w_ru1
      tf_why_ev_path idx
      tf_why_txt t_tf_w_rb2
      ret -8
    end
  end
  if lt nchk TF_MAX_REC
    put g_tf_vchk nchk idx
    put g_tf_vnchk 0 add nchk 1
  end
  ret 0
end

fn tf_ver_one_cite sid ulong did ulong ci ulong to long
  co = add mul did mul TF_MAX_CITE 32 mul ci 32
  for j ulong 32
    put g_tf_tmp_dig j get g_dc_cite add co j
  end
  k = tf_find_evidence_tmp sid
  if lt k 0
    tf_why_txt t_tf_w_ev1
    tf_why_hex_short
    tf_why_txt t_tf_w_ev2
    ret -4
  end
  idx = add mul sid TF_MAX_EV ulong k
  if ne tf_evidence_digest idx 0
    tf_why_txt t_tf_w_dm1
    tf_why_hex_short
    tf_why_txt t_tf_w_dm2
    ret -5
  end
  for j ulong 32
    if ne get g_tf_sh_out j get g_dc_cite add co j
      for m ulong 32
        put g_tf_tmp_dig m get g_dc_cite add co m
      end
      tf_why_txt t_tf_w_dm1
      tf_why_hex_short
      tf_why_txt t_tf_w_dm2
      ret -5
    end
  end
  if not tf_ver_in_cand did idx
    for m ulong 32
      put g_tf_tmp_dig m get g_dc_cite add co m
    end
    tf_why_txt t_tf_w_dm1
    tf_why_hex_short
    tf_why_txt t_tf_w_nc1
    ret -6
  end
  ret tf_ver_receipt idx
end

fn tf_decision_verify sid ulong did ulong to long
  tf_why_clr
  scoff = mul sid 32
  dcoff = mul did 32
  for i ulong 32
    if ne get g_dc_cdig add dcoff i get g_st_cdig add scoff i
      tf_why_txt t_tf_w_con
      ret -2
    end
  end
  ncite = get g_dc_ncite did
  if eq ncite 0
    tf_why_txt t_tf_w_nc
    ret -3
  end
  put g_tf_vnchk 0 0
  for i ulong ncite bound 128
    rc = tf_ver_one_cite sid did i
    if ne rc 0
      ret rc
    end
  end
  tf_why_txt t_tf_ok
  ret 0
end

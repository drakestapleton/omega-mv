note ---- FIPS 180-4 SHA-256 ----
fn tsh_rotr x uint n uint to uint
  ret or shr x n shl x sub uint 32 n
end

fn tsh_init_tbl to void
  if ne get g_tshk 0 0
    ret
  end
  put g_tshk 0 1116352408
  put g_tshk 1 1899447441
  put g_tshk 2 3049323471
  put g_tshk 3 3921009573
  put g_tshk 4 961987163
  put g_tshk 5 1508970993
  put g_tshk 6 2453635748
  put g_tshk 7 2870763221
  put g_tshk 8 3624381080
  put g_tshk 9 310598401
  put g_tshk 10 607225278
  put g_tshk 11 1426881987
  put g_tshk 12 1925078388
  put g_tshk 13 2162078206
  put g_tshk 14 2614888103
  put g_tshk 15 3248222580
  put g_tshk 16 3835390401
  put g_tshk 17 4022224774
  put g_tshk 18 264347078
  put g_tshk 19 604807628
  put g_tshk 20 770255983
  put g_tshk 21 1249150122
  put g_tshk 22 1555081692
  put g_tshk 23 1996064986
  put g_tshk 24 2554220882
  put g_tshk 25 2821834349
  put g_tshk 26 2952996808
  put g_tshk 27 3210313671
  put g_tshk 28 3336571891
  put g_tshk 29 3584528711
  put g_tshk 30 113926993
  put g_tshk 31 338241895
  put g_tshk 32 666307205
  put g_tshk 33 773529912
  put g_tshk 34 1294757372
  put g_tshk 35 1396182291
  put g_tshk 36 1695183700
  put g_tshk 37 1986661051
  put g_tshk 38 2177026350
  put g_tshk 39 2456956037
  put g_tshk 40 2730485921
  put g_tshk 41 2820302411
  put g_tshk 42 3259730800
  put g_tshk 43 3345764771
  put g_tshk 44 3516065817
  put g_tshk 45 3600352804
  put g_tshk 46 4094571909
  put g_tshk 47 275423344
  put g_tshk 48 430227734
  put g_tshk 49 506948616
  put g_tshk 50 659060556
  put g_tshk 51 883997877
  put g_tshk 52 958139571
  put g_tshk 53 1322822218
  put g_tshk 54 1537002063
  put g_tshk 55 1747873779
  put g_tshk 56 1955562222
  put g_tshk 57 2024104815
  put g_tshk 58 2227730452
  put g_tshk 59 2361852424
  put g_tshk 60 2428436474
  put g_tshk 61 2756734187
  put g_tshk 62 3204031479
  put g_tshk 63 3329325298
  put g_tshk 64 1779033703
  put g_tshk 65 3144134277
  put g_tshk 66 1013904242
  put g_tshk 67 2773480762
  put g_tshk 68 1359893119
  put g_tshk 69 2600822924
  put g_tshk 70 528734635
  put g_tshk 71 1541459225
end

fn tsh_load_w to void
  for i ulong 16
    b0 = shl uint get g_tshb mul i 4 uint 24
    b1 = shl uint get g_tshb add mul i 4 1 uint 16
    b2 = shl uint get g_tshb add mul i 4 2 uint 8
    b3 = uint get g_tshb add mul i 4 3
    put g_tshw i or or b0 b1 or b2 b3
  end
  i = ulong 16
  while lt i 64
    x = get g_tshw sub i 15
    s0 = xor xor tsh_rotr x uint 7 tsh_rotr x uint 18 shr x uint 3
    y = get g_tshw sub i 2
    s1 = xor xor tsh_rotr y uint 17 tsh_rotr y uint 19 shr y uint 10
    put g_tshw i add add get g_tshw sub i 16 s0 add get g_tshw sub i 7 s1
    i = add i 1
  end
end

fn tsh_round j ulong to void
  e = get g_tshv 4
  s1 = xor xor tsh_rotr e uint 6 tsh_rotr e uint 11 tsh_rotr e uint 25
  ch = xor and e get g_tshv 5 and not e get g_tshv 6
  t1 = add add add get g_tshv 7 s1 add ch get g_tshk j get g_tshw j
  a = get g_tshv 0
  s0 = xor xor tsh_rotr a uint 2 tsh_rotr a uint 13 tsh_rotr a uint 22
  maj = xor xor and a get g_tshv 1 and a get g_tshv 2 and get g_tshv 1 get g_tshv 2
  t2 = add s0 maj
  put g_tshv 7 get g_tshv 6
  put g_tshv 6 get g_tshv 5
  put g_tshv 5 e
  put g_tshv 4 add get g_tshv 3 t1
  put g_tshv 3 get g_tshv 2
  put g_tshv 2 get g_tshv 1
  put g_tshv 1 a
  put g_tshv 0 add t1 t2
end

fn tsh_block to void
  tsh_load_w
  for j ulong 8
    put g_tshv j get g_tshh j
  end
  for j ulong 64
    tsh_round j
  end
  for j ulong 8
    put g_tshh j add get g_tshh j get g_tshv j
  end
end

fn tsh_init to void
  tsh_init_tbl
  for i ulong 8
    put g_tshh i get g_tshk add i 64
  end
  put g_tshm 0 0
  put g_tshm 1 0
end

fn tsh_byte b uchar to void
  bl = get g_tshm 0
  put g_tshb bl b
  bl = add bl 1
  put g_tshm 1 add get g_tshm 1 1
  if eq bl 64
    tsh_block
    bl = 0
  end
  put g_tshm 0 bl
end

fn tsh_txt s view uchar * to void
  n = len s
  for i ulong n
    tsh_byte get s i
  end
end

fn tsh_final slot ulong to void
  tot = get g_tshm 1
  bits = mul tot 8
  tsh_byte uchar 128
  while ne get g_tshm 0 56
    tsh_byte uchar 0
  end
  for i ulong 8
    sh = mul sub 7 i 8
    tsh_byte uchar and shr bits sh 255
  end
  off = mul slot 32
  for i ulong 8
    w = get g_tshh i
    o = add off mul i 4
    put g_tdig o uchar and shr w uint 24 uint 255
    put g_tdig add o 1 uchar and shr w uint 16 uint 255
    put g_tdig add o 2 uchar and shr w uint 8 uint 255
    put g_tdig add o 3 uchar and w uint 255
  end
end

fn tdg_eq s1 ulong s2 ulong to bool
  o1 = mul s1 32
  o2 = mul s2 32
  for i ulong 32
    if ne get g_tdig add o1 i get g_tdig add o2 i
      ret false
    end
  end
  ret true
end

fn tdg_cp dst ulong src ulong to void
  o1 = mul dst 32
  o2 = mul src 32
  for i ulong 32
    put g_tdig add o1 i get g_tdig add o2 i
  end
end

note ---- Confidence & Status helpers ----
fn ty_conf_forge c ulong to ulong
  if or eq c TY_DIRECT eq c TY_COUNTER_DERIVED
    ret TY_FORGE_MEASURED
  end
  if or eq c TY_CAUSAL_RUNTIME or eq c TY_COUNTERFACTUAL eq c TY_MODELLED
    ret TY_FORGE_ESTIMATED
  end
  ret TY_FORGE_NOT_MEASURED
end

fn tv_clr to void
  put g_tvl 0 0
end

fn tv_b c uchar to void
  n = get g_tvl 0
  if lt n 512
    put g_tval n c
    put g_tvl 0 add n 1
  end
end

fn tv_txt s view uchar * to void
  n = len s
  for i ulong n
    tv_b get s i
  end
end

fn tv_u64 v ulong to void
  if eq v 0
    tv_b uchar 48
    ret
  end
  dig = new uchar 24 0
  n = ulong 0
  x = v
  while gt x 0
    put dig n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = n
  while gt i 0
    i = sub i 1
    tv_b get dig i
  end
end

fn tv_i64 v long to void
  if lt v 0
    tv_b uchar 45
    note handle INT64_MIN safely
    u = add not bitcast ulong v 1
    tv_u64 u
    ret
  end
  tv_u64 ulong v
end

fn tv_conf c ulong to void
  if eq c 0
    tv_txt t_ty_c0
    ret
  end
  if eq c 1
    tv_txt t_ty_c1
    ret
  end
  if eq c 2
    tv_txt t_ty_c2
    ret
  end
  if eq c 3
    tv_txt t_ty_c3
    ret
  end
  if eq c 4
    tv_txt t_ty_c4
    ret
  end
  if eq c 5
    tv_txt t_ty_c5
    ret
  end
  tv_txt t_ty_inv
end

fn tv_status s ulong to void
  if eq s 0
    tv_txt t_ty_s0
    ret
  end
  if eq s 1
    tv_txt t_ty_s1
    ret
  end
  if eq s 2
    tv_txt t_ty_s2
    ret
  end
  if eq s 3
    tv_txt t_ty_s3
    ret
  end
  if eq s 4
    tv_txt t_ty_s4
    ret
  end
  if eq s 5
    tv_txt t_ty_s5
    ret
  end
  if eq s 6
    tv_txt t_ty_s6
    ret
  end
  if eq s 7
    tv_txt t_ty_s7
    ret
  end
  if eq s 8
    tv_txt t_ty_s8
    ret
  end
  if eq s 9
    tv_txt t_ty_s9
    ret
  end
  if eq s 10
    tv_txt t_ty_s10
    ret
  end
  if eq s 11
    tv_txt t_ty_s11
    ret
  end
  if eq s 12
    tv_txt t_ty_s12
    ret
  end
  if eq s 13
    tv_txt t_ty_s13
    ret
  end
  if eq s 14
    tv_txt t_ty_s14
    ret
  end
  if eq s 15
    tv_txt t_ty_s15
    ret
  end
  if eq s 16
    tv_txt t_ty_s16
    ret
  end
  tv_txt t_ty_inv
end

note ---- C-string helpers in fixed-stride pools ----
fn tx_ok_at which ulong off ulong cap ulong to bool
  for i ulong cap
    c = uchar 0
    if eq which 0
      c = get g_tw_run add off i
    else
      if eq which 1
        c = get g_tw_cfg add off i
      else
        if eq which 2
          c = get g_tw_cnd add off i
        else
          if eq which 3
            c = get g_tp_rz add off i
          else
            if eq which 4
              c = get g_tp_cpu add off i
            else
              if eq which 5
                c = get g_ta_mth add off i
              else
                c = get g_ts_who add off i
              end
            end
          end
        end
      end
    end
    if eq c 0
      ret gt i 0
    end
    if eq c 124
      ret false
    end
  end
  ret false
end

fn tv_cstr which ulong off ulong cap ulong to void
  for i ulong cap
    c = uchar 0
    if eq which 0
      c = get g_tw_run add off i
    else
      if eq which 1
        c = get g_tw_cfg add off i
      else
        if eq which 2
          c = get g_tw_cnd add off i
        else
          if eq which 3
            c = get g_tp_rz add off i
          else
            if eq which 4
              c = get g_tp_cpu add off i
            else
              if eq which 5
                c = get g_ta_mth add off i
              else
                if eq which 6
                  c = get g_ts_who add off i
                else
                  c = get g_tp_tag add off i
                end
              end
            end
          end
        end
      end
    end
    if eq c 0
      ret
    end
    tv_b c
  end
end

fn cnd_len w ulong to ulong
  off = mul w 8
  for i ulong 8
    if eq get g_tw_cnd add off i 0
      ret i
    end
  end
  ret 8
end

fn cnd_eq_txt w ulong want view uchar * to bool
  n = cnd_len w
  if ne n len want
    ret false
  end
  off = mul w 8
  for i ulong n
    if ne get g_tw_cnd add off i get want i
      ret false
    end
  end
  ret true
end

fn cstr_eq_pool which ulong o1 ulong o2 ulong cap ulong to bool
  for i ulong cap
    a = uchar 0
    b = uchar 0
    if eq which 0
      a = get g_tw_run add o1 i
      b = get g_tw_run add o2 i
    else
      if eq which 1
        a = get g_tw_cfg add o1 i
        b = get g_tw_cfg add o2 i
      else
        a = get g_ts_who add o1 i
        b = get g_ts_who add o2 i
      end
    end
    if ne a b
      ret false
    end
    if eq a 0
      ret true
    end
  end
  ret true
end

fn who_eq_idle sh ulong to bool
  off = mul sh 8
  for i ulong 4
    if ne get g_ts_who add off i get t_ty_idle i
      ret false
    end
  end
  ret eq get g_ts_who add off 4 0
end

fn has_tag_byte w ulong ch uchar to bool
  np = get g_tw_np w
  pbo = mul w 4
  for i ulong np
    po = mul add pbo i 8
    c0 = get g_tp_tag po
    c1 = get g_tp_tag add po 1
    if and eq c0 ch eq c1 0
      ret true
    end
  end
  ret false
end

fn who_matches_part w ulong sh ulong to bool
  off = mul sh 8
  if eq get g_ts_who off 0
    ret false
  end
  if ne get g_ts_who add off 1 0
    ret false
  end
  ret has_tag_byte w get g_ts_who off
end

note ---- Window validity & energy ----
fn ty_check_part_str pbo ulong i ulong to bool
  p = add pbo i
  toff = mul p 8
  c = get g_tp_tag toff
  c1 = get g_tp_tag add toff 1
  if or lt c 65 or gt c 68 ne c1 0
    ret false
  end
  if not tx_ok_at 3 mul p 32 32
    ret false
  end
  if not tx_ok_at 4 mul p 32 32
    ret false
  end
  for j ulong i
    cj = get g_tp_tag mul add pbo j 8
    if eq c cj
      ret false
    end
  end
  ret true
end

fn ty_shape_ok w ulong to bool
  np = get g_tw_np w
  if gt np TY_MAX_PART
    ret false
  end
  if not tx_ok_at 0 mul w 64 64
    ret false
  end
  if not tx_ok_at 1 mul w 16 16
    ret false
  end
  if not tx_ok_at 2 mul w 8 8
    ret false
  end
  pbo = mul w 4
  for i ulong np
    if not ty_check_part_str pbo i
      ret false
    end
  end
  ret true
end

fn ty_check_cond w ulong to ulong
  if cnd_eq_txt w t_ty_idle
    if eq get g_tw_np w 0
      ret TYE_OK
    end
    ret TYE_E_CONDITION
  end
  want = cnd_len w
  if ne want get g_tw_np w
    ret TYE_E_CONDITION
  end
  off = mul w 8
  for i ulong want
    c = get g_tw_cnd add off i
    if or lt c 65 gt c 68
      ret TYE_E_CONDITION
    end
    for j ulong i
      cj = get g_tw_cnd add off j
      if eq c cj
        ret TYE_E_CONDITION
      end
    end
    if not has_tag_byte w c
      ret TYE_E_CONDITION
    end
  end
  ret TYE_OK
end

note 128-bit compare a1*a2 < b1*b2 using 64x64->128 split (32-bit halves)
global g_m128 ulong 8

fn mul128 a ulong b ulong dst ulong to void
  put g_m128 4 mul and a 0xffffffff and b 0xffffffff
  put g_m128 5 mul and a 0xffffffff shr b 32
  put g_m128 6 mul shr a 32 and b 0xffffffff
  put g_m128 7 mul shr a 32 shr b 32
  mid = add add shr get g_m128 4 32 and get g_m128 5 0xffffffff and get g_m128 6 0xffffffff
  put g_m128 dst or shl and mid 0xffffffff 32 and get g_m128 4 0xffffffff
  hi = add add add get g_m128 7 shr get g_m128 5 32 shr get g_m128 6 32 shr mid 32
  put g_m128 add dst 1 hi
end

fn lt128 a1 ulong a2 ulong b1 ulong b2 ulong to bool
  mul128 a1 a2 0
  mul128 b1 b2 2
  h1 = get g_m128 1
  h2 = get g_m128 3
  if lt h1 h2
    ret true
  end
  if gt h1 h2
    ret false
  end
  ret lt get g_m128 0 get g_m128 2
end

fn ty_check_part w ulong p ulong to ulong
  if eq get g_tp_ex p 0
    ret TYE_E_PARTIAL_RUN
  end
  if eq get g_tp_or p 0
    ret TYE_E_PARTIAL_RUN
  end
  if eq get g_tp_pn p 0
    ret TYE_E_PARTIAL_RUN
  end
  if eq get g_tp_cl p 0
    ret TYE_E_PARTIAL_RUN
  end
  pl = get g_tw_pl w
  if ne get g_tp_pl p pl
    ret TYE_E_INTERVAL_MISMATCH
  end
  go = get g_tp_go p
  t0 = get g_tp_t0 p
  t1 = get g_tp_t1 p
  dn = get g_tp_dn p
  if lt go get g_tw_t0 w
    ret TYE_E_INTERVAL_MISMATCH
  end
  if lt t0 go
    ret TYE_E_INTERVAL_MISMATCH
  end
  if lt t1 t0
    ret TYE_E_INTERVAL_MISMATCH
  end
  if lt dn t1
    ret TYE_E_INTERVAL_MISMATCH
  end
  if gt dn get g_tw_t1 w
    ret TYE_E_INTERVAL_MISMATCH
  end
  if lt128 sub t1 t0 50 pl 49
    ret TYE_E_PARTIAL_RUN
  end
  if eq get g_tp_pm p 0
    ret TYE_E_SENSOR
  end
  if ne get g_tp_mx p 0
    ret TYE_E_MULTIPLEXED
  end
  ret TYE_OK
end

fn ty_interval_check w ulong to ulong
  if not ty_shape_ok w
    ret TYE_E_ARG
  end
  pl = get g_tw_pl w
  if or eq pl 0 le get g_tw_t1 w get g_tw_t0 w
    ret TYE_E_ARG
  end
  if or eq get g_tw_ok0 w 0 eq get g_tw_ok1 w 0
    ret TYE_E_SENSOR
  end
  if ne get g_tw_ovf w 0
    ret TYE_E_WRAP
  end
  ebo = mul w 3
  for c ulong TY_NCH
    if lt get g_tw_e1 add ebo c get g_tw_e0 add ebo c
      ret TYE_E_WRAP
    end
  end
  for c ulong TY_NCH
    e0 = get g_tw_e0 add ebo c
    e1 = get g_tw_e1 add ebo c
    if ge e1 TY_WRAP_UJ
      ret TYE_E_HEADROOM
    end
    if le sub TY_WRAP_UJ e1 sub e1 e0
      ret TYE_E_HEADROOM
    end
  end
  dt = sub get g_tw_t1 w get g_tw_t0 w
  ns = get g_tw_ns w
  if gt get g_tw_mg w TY_MAX_GAP_NS
    ret TYE_E_SAMPLING_GAP
  end
  if lt128 ns mul 10 TY_SAMPLE_PERIOD_NS dt 9
    ret TYE_E_SAMPLING_GAP
  end
  if gt ns add div dt TY_SAMPLE_PERIOD_NS 2
    ret TYE_E_SAMPLING_GAP
  end
  sc = ty_check_cond w
  if ne sc TYE_OK
    ret sc
  end
  if or lt dt pl gt sub dt pl div pl 20
    ret TYE_E_INTERVAL_MISMATCH
  end
  np = get g_tw_np w
  pbo = mul w 4
  for i ulong np
    sp = ty_check_part w add pbo i
    if ne sp TYE_OK
      ret sp
    end
  end
  ret TYE_OK
end

note Compute floor(de * pl_us / dt_us) safely via 128-bit division (shift-subtract)
fn div128_by_u64 lo ulong hi ulong d ulong to ulong
  q = ulong 0
  r = hi
  for i ulong 64
    sh = sub 63 i
    bit = and shr lo sh 1
    r_hi = shr r 63
    r = or shl r 1 bit
    if or ne r_hi 0 ge r d
      r = sub r d
      q = or q shl ulong 1 sh
    end
  end
  ret q
end

fn ty_interval_energy w ulong ch long to ulong
  if or lt ch 0 ge ch long TY_NCH
    ret TYE_E_ARG
  end
  s = ty_interval_check w
  if ne s TYE_OK
    ret s
  end
  ebo = mul w 3
  de = sub get g_tw_e1 add ebo ulong ch get g_tw_e0 add ebo ulong ch
  dt_us = div sub get g_tw_t1 w get g_tw_t0 w 1000
  if or eq dt_us 0 gt de 1000000000000
    ret TYE_E_ARG
  end
  pl_us = div get g_tw_pl w 1000
  mul128 de pl_us 0
  if ge get g_m128 1 dt_us
    ret TYE_E_ARG
  end
  sc = div128_by_u64 get g_m128 0 get g_m128 1 dt_us
  if gt sc 0x7fffffffffffffff
    ret TYE_E_ARG
  end
  put g_tret 0 long sc
  ret TYE_OK
end

fn ty_intervals_disjoint n ulong to ulong
  for i ulong n
    wi = get g_tidx i
    if le get g_tw_t1 wi get g_tw_t0 wi
      ret TYE_E_ARG
    end
  end
  for i ulong n
    wi = get g_tidx i
    j = add i 1
    while lt j n
      wj = get g_tidx j
      if lt get g_tw_t0 wi get g_tw_t1 wj
        if lt get g_tw_t0 wj get g_tw_t1 wi
          ret TYE_E_OVERLAP
        end
      end
      j = add j 1
    end
  end
  ret TYE_OK
end

text t_ty_cA "A"
text t_ty_cB "B"
text t_ty_cAB "AB"

fn ty_inter_cond k ulong wk ulong to bool
  if eq k 0
    ret cnd_eq_txt wk t_ty_idle
  end
  if eq k 1
    ret cnd_eq_txt wk t_ty_cA
  end
  if eq k 2
    ret cnd_eq_txt wk t_ty_cB
  end
  ret cnd_eq_txt wk t_ty_cAB
end

fn ty_inter_match k ulong wk ulong wab ulong to bool
  if not ty_inter_cond k wk
    ret false
  end
  if ne get g_tw_rnd wk get g_tw_rnd wab
    ret false
  end
  if ne get g_tw_pl wk get g_tw_pl wab
    ret false
  end
  if not cstr_eq_pool 1 mul wk 16 mul wab 16 16
    ret false
  end
  ret cstr_eq_pool 0 mul wk 64 mul wab 64 64
end

fn ty_interaction wi ulong wa ulong wb ulong wab ulong ch long to ulong
  put g_tidx 0 wi
  put g_tidx 1 wa
  put g_tidx 2 wb
  put g_tidx 3 wab
  for k ulong 4
    wk = get g_tidx k
    s = ty_interval_energy wk ch
    if ne s TYE_OK
      ret s
    end
    put g_tret add 4 k get g_tret 0
    if not ty_inter_match k wk wab
      if and eq k 0 not cnd_eq_txt wk t_ty_idle
        ret TYE_E_MISSING_IDLE
      end
      ret TYE_E_CONDITION
    end
  end
  sd = ty_intervals_disjoint 4
  if ne sd TYE_OK
    ret sd
  end
  e0 = get g_tret 4
  e1 = get g_tret 5
  e2 = get g_tret 6
  e3 = get g_tret 7
  put g_tret 0 add sub sub e3 e1 e2 e0
  ret TYE_OK
end

note ---- Canonical OMG0 encoder & digests ----
fn ca_reset to void
  put g_ca_n 0 0
  put g_cr_n 0 0
end

fn ca_add_attr k view uchar * to void
  idx = get g_ca_n 0
  kl = len k
  put g_ca_kl idx kl
  ko = mul idx 64
  for i ulong kl
    put g_ca_k add ko i get k i
  end
  vl = get g_tvl 0
  put g_ca_vl idx vl
  vo = mul idx 512
  for i ulong vl
    put g_ca_v add vo i get g_tval i
  end
  put g_ca_n 0 add idx 1
end

fn ca_add_txt k view uchar * v view uchar * to void
  tv_clr
  tv_txt v
  ca_add_attr k
end

fn ca_add_u64 k view uchar * v ulong to void
  tv_clr
  tv_u64 v
  ca_add_attr k
end

fn ca_add_i64 k view uchar * v long to void
  tv_clr
  tv_i64 v
  ca_add_attr k
end

fn ca_add_rel kind ulong dslot ulong to void
  idx = get g_cr_n 0
  put g_cr_k idx kind
  tdg_cp add 536 idx dslot
  put g_cr_n 0 add idx 1
end

fn ca_key_lt a ulong b ulong to bool
  la = get g_ca_kl a
  lb = get g_ca_kl b
  mn = la
  if lt lb mn
    mn = lb
  end
  oa = mul a 64
  ob = mul b 64
  for i ulong mn
    ca = get g_ca_k add oa i
    cb = get g_ca_k add ob i
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret lt la lb
end

fn ca_rel_lt a ulong b ulong to bool
  ka = get g_cr_k a
  kb = get g_cr_k b
  if lt ka kb
    ret true
  end
  if gt ka kb
    ret false
  end
  oa = mul add 536 a 32
  ob = mul add 536 b 32
  for i ulong 32
    ca = get g_tdig add oa i
    cb = get g_tdig add ob i
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret false
end

fn cb_u8 b uchar to void
  p = get g_clen 0
  put g_cbuf p b
  put g_clen 0 add p 1
end

fn cb_u16be v ulong to void
  cb_u8 uchar and shr v 8 255
  cb_u8 uchar and v 255
end

fn cb_u32be v ulong to void
  cb_u8 uchar and shr v 24 255
  cb_u8 uchar and shr v 16 255
  cb_u8 uchar and shr v 8 255
  cb_u8 uchar and v 255
end

fn ca_sort_attrs to void
  na = get g_ca_n 0
  for i ulong na
    put g_ca_ord i i
  end
  i = ulong 1
  while lt i na
    key = get g_ca_ord i
    j = i
    while gt j 0
      prev = get g_ca_ord sub j 1
      if ca_key_lt key prev
        put g_ca_ord j prev
        j = sub j 1
      else
        break
      end
    end
    put g_ca_ord j key
    i = add i 1
  end
end

fn ca_sort_rels to void
  nr = get g_cr_n 0
  for i ulong nr
    put g_cr_ord i i
  end
  i = ulong 1
  while lt i nr
    key = get g_cr_ord i
    j = i
    while gt j 0
      prev = get g_cr_ord sub j 1
      if ca_rel_lt key prev
        put g_cr_ord j prev
        j = sub j 1
      else
        break
      end
    end
    put g_cr_ord j key
    i = add i 1
  end
end

fn ca_emit_attr ai ulong to void
  kl = get g_ca_kl ai
  cb_u8 uchar kl
  ko = mul ai 64
  for j ulong kl
    cb_u8 get g_ca_k add ko j
  end
  vl = get g_ca_vl ai
  cb_u16be vl
  vo = mul ai 512
  for j ulong vl
    cb_u8 get g_ca_v add vo j
  end
end

fn ca_emit_rel ri ulong to void
  cb_u16be get g_cr_k ri
  ro = mul add 536 ri 32
  for j ulong 32
    cb_u8 get g_tdig add ro j
  end
end

fn ca_finish dom view uchar * dslot ulong to long
  ca_sort_attrs
  ca_sort_rels
  put g_clen 0 0
  cb_u8 uchar 79
  cb_u8 uchar 77
  cb_u8 uchar 71
  cb_u8 uchar 48
  cb_u8 uchar 1
  cb_u8 uchar TY_KIND_EVIDENCE
  na = get g_ca_n 0
  cb_u16be na
  for i ulong na
    ca_emit_attr get g_ca_ord i
  end
  nr = get g_cr_n 0
  cb_u16be nr
  for i ulong nr
    ca_emit_rel get g_cr_ord i
  end
  cb_u16be 0
  cb_u32be 0
  tsh_init
  tsh_txt dom
  tsh_byte uchar 0
  n = get g_clen 0
  for i ulong n
    tsh_byte get g_cbuf i
  end
  tsh_final dslot
  ret 0
end

fn ty_add_part_attr w ulong i ulong to void
  p = add mul w 4 i
  tv_clr
  tv_cstr 7 mul p 8 8
  tv_b uchar 124
  tv_cstr 3 mul p 32 32
  tv_b uchar 124
  tv_cstr 4 mul p 32 32
  tv_b uchar 124
  tv_u64 get g_tp_go p
  tv_b uchar 124
  tv_u64 get g_tp_t0 p
  tv_b uchar 124
  tv_u64 get g_tp_t1 p
  tv_b uchar 124
  tv_u64 get g_tp_dn p
  tv_b uchar 124
  tv_u64 get g_tp_pl p
  tv_b uchar 124
  tv_u64 get g_tp_cl p
  tv_b uchar 124
  tv_u64 get g_tp_cy p
  tv_b uchar 124
  tv_u64 get g_tp_in p
  tv_b uchar 124
  tv_u64 get g_tp_l2 p
  tv_b uchar 124
  tv_u64 get g_tp_pn p
  tv_b uchar 124
  tv_u64 get g_tp_or p
  tv_b uchar 124
  tv_u64 get g_tp_ex p
  tv_b uchar 124
  tv_u64 get g_tp_pm p
  tv_b uchar 124
  tv_u64 get g_tp_mx p
  if eq i 0
    ca_add_attr t_k_p0
    ret
  end
  if eq i 1
    ca_add_attr t_k_p1
    ret
  end
  if eq i 2
    ca_add_attr t_k_p2
    ret
  end
  ca_add_attr t_k_p3
end

fn ty_interval_digest w ulong dslot ulong to long
  if not ty_shape_ok w
    ret -1
  end
  ca_reset
  ca_add_txt t_k_record t_ty_rec_int
  tv_clr
  tv_cstr 0 mul w 64 64
  ca_add_attr t_k_run
  tv_clr
  tv_cstr 1 mul w 16 16
  ca_add_attr t_k_config
  tv_clr
  tv_cstr 2 mul w 8 8
  ca_add_attr t_k_cond
  ca_add_u64 t_k_round get g_tw_rnd w
  ca_add_u64 t_k_pos get g_tw_pos w
  ca_add_u64 t_k_t0 get g_tw_t0 w
  ca_add_u64 t_k_t1 get g_tw_t1 w
  ca_add_u64 t_k_pl get g_tw_pl w
  tv_clr
  tv_u64 get g_tw_ok0 w
  tv_b uchar 44
  tv_u64 get g_tw_ok1 w
  tv_b uchar 44
  tv_u64 get g_tw_ovf w
  ca_add_attr t_k_sok
  ebo = mul w 3
  tv_clr
  tv_u64 get g_tw_e0 ebo
  tv_b uchar 44
  tv_u64 get g_tw_e0 add ebo 1
  tv_b uchar 44
  tv_u64 get g_tw_e0 add ebo 2
  ca_add_attr t_k_e0
  tv_clr
  tv_u64 get g_tw_e1 ebo
  tv_b uchar 44
  tv_u64 get g_tw_e1 add ebo 1
  tv_b uchar 44
  tv_u64 get g_tw_e1 add ebo 2
  ca_add_attr t_k_e1
  ca_add_u64 t_k_ns get g_tw_ns w
  ca_add_u64 t_k_mg get g_tw_mg w
  ca_add_u64 t_k_res TY_RESOLUTION_UJ
  ca_add_u64 t_k_sp TY_SAMPLE_PERIOD_NS
  ca_add_u64 t_k_fb get g_tw_fb w
  ca_add_u64 t_k_mt get g_tw_mt w
  for i ulong get g_tw_np w
    ty_add_part_attr w i
  end
  st = ty_interval_check w
  cf = TY_UNATTRIBUTED
  if eq st TYE_OK
    cf = TY_DIRECT
  end
  tv_clr
  tv_status st
  ca_add_attr t_k_st
  tv_clr
  tv_conf cf
  ca_add_attr t_k_cf
  ca_add_u64 t_k_fe ty_conf_forge cf
  ret ca_finish t_ty_dom_int dslot
end

note Signed 64-bit overflow-checked add/sub
fn i64_add_ovf a long b long to bool
  if gt b 0
    if gt a sub 0x7fffffffffffffff b
      ret true
    end
  end
  mn = bitcast long or shl ulong 0x80000000 32 ulong 0
  if lt b 0
    if lt a sub mn b
      ret true
    end
  end
  ret false
end

fn i64_sub_ovf a long b long to bool
  if lt b 0
    if gt a add 0x7fffffffffffffff b
      ret true
    end
  end
  mn = bitcast long or shl ulong 0x80000000 32 ulong 0
  if gt b 0
    if lt a add mn b
      ret true
    end
  end
  ret false
end

fn ty_attr_has_dup a ulong to bool
  nsh = get g_ta_nsh a
  sbo = mul a 8
  for i ulong nsh
    si = add sbo i
    j = add i 1
    while lt j nsh
      sj = add sbo j
      if cstr_eq_pool 2 mul si 8 mul sj 8 8
        ret true
      end
      j = add j 1
    end
  end
  ret false
end

fn ty_attr_has_tag a ulong ptag uchar to bool
  nsh = get g_ta_nsh a
  sbo = mul a 8
  for j ulong nsh
    off = mul add sbo j 8
    if eq get g_ts_who off ptag
      if eq get g_ts_who add off 1 0
        ret true
      end
    end
  end
  ret false
end

fn ty_attr_missing a ulong w ulong to bool
  np = get g_tw_np w
  pbo = mul w 4
  for i ulong np
    ptag = get g_tp_tag mul add pbo i 8
    if not ty_attr_has_tag a ptag
      ret true
    end
  end
  ret false
end

fn ty_attr_check_shares a ulong w ulong tol long to ulong
  if ty_attr_has_dup a
    ret TYE_E_DOUBLE_COUNT
  end
  nsh = get g_ta_nsh a
  sbo = mul a 8
  idle = ulong 0
  wk = TY_DIRECT
  alloc = long 0
  for i ulong nsh
    si = add sbo i
    cf = get g_ts_cf si
    if ge cf TY_UNATTRIBUTED
      ret TYE_E_ARG
    end
    if who_eq_idle si
      idle = 1
    else
      if not who_matches_part w si
        ret TYE_E_UNKNOWN_PARTICIPANT
      end
    end
    uj = get g_ts_uj si
    if lt uj sub 0 tol
      ret TYE_E_NEGATIVE_SHARE
    end
    if gt cf wk
      wk = cf
    end
    if i64_add_ovf alloc uj
      ret TYE_E_ARG
    end
    alloc = add alloc uj
  end
  put g_ta_auj a alloc
  if eq idle 0
    ret TYE_E_MISSING_IDLE
  end
  if ty_attr_missing a w
    ret TYE_E_MISSING_PARTICIPANT
  end
  muj = get g_ta_muj a
  if i64_sub_ovf muj alloc
    ret TYE_E_ARG
  end
  ruj = sub muj alloc
  put g_ta_ruj a ruj
  put g_ta_ov a wk
  if lt ruj sub 0 tol
    ret TYE_E_OVER_ALLOCATED
  end
  ret TYE_OK
end

fn ty_attribution_check a ulong w ulong to ulong
  put g_ta_vd a TYE_E_ARG
  nsh = get g_ta_nsh a
  nsr = get g_ta_nsr a
  ch = get g_ta_ch a
  if or gt nsh TY_MAX_SHARE or gt nsr TY_MAX_SRC or lt ch 0 ge ch long TY_NCH
    ret TYE_E_ARG
  end
  if or not tx_ok_at 5 mul a 32 32 gt get g_ta_tol a 0x7fffffffffffffff
    ret TYE_E_ARG
  end
  sbo = mul a 8
  for i ulong nsh
    if not tx_ok_at 6 mul add sbo i 8 8
      ret TYE_E_ARG
    end
  end
  put g_ta_auj a 0
  put g_ta_ruj a 0
  put g_ta_muj a 0
  put g_ta_ov a TY_UNATTRIBUTED
  s = ty_interval_energy w ch
  if eq s TYE_OK
    put g_ta_muj a get g_tret 0
    if ne ty_interval_digest w add 528 a 0
      s = TYE_E_ARG
    end
  end
  if ne s TYE_OK
    put g_ta_vd a s
    ret s
  end
  srbo = add 512 mul a 8
  for i ulong nsr
    if tdg_eq add srbo i add 528 a
      put g_ta_vd a TYE_E_DOUBLE_COUNT
      ret TYE_E_DOUBLE_COUNT
    end
    j = add i 1
    while lt j nsr
      if tdg_eq add srbo i add srbo j
        put g_ta_vd a TYE_E_DOUBLE_COUNT
        ret TYE_E_DOUBLE_COUNT
      end
      j = add j 1
    end
  end
  if ne get g_ta_au a 0
    if ne nsh 0
      put g_ta_vd a TYE_E_ARG
      ret TYE_E_ARG
    end
    put g_ta_ruj a get g_ta_muj a
    put g_ta_vd a TYE_OK
    ret TYE_OK
  end
  v = ty_attr_check_shares a w long get g_ta_tol a
  put g_ta_vd a v
  ret v
end

fn ty_attribution_digest a ulong dslot ulong to long
  nsh = get g_ta_nsh a
  nsr = get g_ta_nsr a
  if or not tx_ok_at 5 mul a 32 32 or gt nsh TY_MAX_SHARE gt nsr TY_MAX_SRC
    ret -1
  end
  sbo = mul a 8
  for i ulong nsh
    if not tx_ok_at 6 mul add sbo i 8 8
      ret -1
    end
  end
  ca_reset
  ca_add_txt t_k_record t_ty_rec_att
  tv_clr
  tv_cstr 5 mul a 32 32
  ca_add_attr t_k_meth
  ch = get g_ta_ch a
  if eq ch 0
    ca_add_txt t_k_chan t_ty_ch0
  else
    if eq ch 1
      ca_add_txt t_k_chan t_ty_ch1
    else
      if eq ch 2
        ca_add_txt t_k_chan t_ty_ch2
      else
        ca_add_txt t_k_chan t_ty_ch_inv
      end
    end
  end
  ca_add_u64 t_k_tol get g_ta_tol a
  auv = ulong 0
  if ne get g_ta_au a 0
    auv = 1
  end
  ca_add_u64 t_k_au auv
  ca_add_i64 t_k_mu get g_ta_muj a
  ca_add_i64 t_k_al get g_ta_auj a
  ca_add_i64 t_k_un get g_ta_ruj a
  tv_clr
  for i ulong nsh
    si = add sbo i
    if gt i 0
      tv_b uchar 59
    end
    tv_cstr 6 mul si 8 8
    tv_b uchar 58
    tv_conf get g_ts_cf si
    tv_b uchar 58
    tv_i64 get g_ts_uj si
    tv_b uchar 58
    tv_u64 ty_conf_forge get g_ts_cf si
  end
  ca_add_attr t_k_sh
  tv_clr
  tv_status get g_ta_vd a
  ca_add_attr t_k_vd
  cf = get g_ta_ov a
  if or ne get g_ta_au a 0 ne get g_ta_vd a TYE_OK
    cf = TY_UNATTRIBUTED
  end
  tv_clr
  tv_conf cf
  ca_add_attr t_k_oc
  ca_add_u64 t_k_of ty_conf_forge cf
  ca_add_rel TY_REL_DERIVED_FROM add 528 a
  srbo = add 512 mul a 8
  for i ulong nsr
    ca_add_rel TY_REL_DEPENDS_ON add srbo i
  end
  ret ca_finish t_ty_dom_att dslot
end

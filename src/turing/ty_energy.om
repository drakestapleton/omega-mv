note ---- SHA-256 state ----
global g_tshk uint 72
global g_tshh uint 8
global g_tshw uint 64
global g_tshv uint 8
global g_tshb uchar 64
global g_tshm ulong 2

note ---- Unified digest store (1024 slots x 32B = 32768B) ----
note Slots 0..511: window/test, 512..527: attr.src (2x8), 528..529: attr.measured, 536..551: canon rels
global g_tdig uchar 32768

note ---- Interval pool (512 slots; each has up to 4 participants -> 2048 participant slots) ----
global g_tw_run uchar 32768
global g_tw_cfg uchar 8192
global g_tw_cnd uchar 4096
global g_tw_rnd ulong 512
global g_tw_pos ulong 512

note SPDX-License-Identifier: Apache-2.0
note Copyright 2026 Drake Stapleton (AIEN / aien-dev)
note
note src/turing/tc_range.om: TURING Yield coder A (TCR1, range coder) written in Omega, the peer
note of src/turing/tc_range.c (ledger L111). Normative text: calibration/docs/CODER_SPEC.md
note sections 2 (TPS1), 3 (TSY1), 4 (coded header), 5 (range coder), 8 (ideal length) and
note docs/turing/TURING_YIELD_RANGE_CODER_OM.md (the length bound and its proof).
note
note Program mode, OM-1 code in an OM-2 unit: composed after the FIPS 180-4 unit seed/ng/sha256.om
note (prefix sh_), with an om2 first line for the unsized text views:
note   { printf 'om2\n'; cat seed/ng/sha256.om src/turing/tc_range.om; } | seed/out/omc > tcr-om
note
note CLI (same shape as turing-coder, range only):
note   tcr-om encode range IN.tps IN.tsy OUT.tcr
note   tcr-om decode range IN.tps IN.tcr OUT.tsy
note   tcr-om verify range IN.tps IN.tsy IN.tcr
note   tcr-om selftest
note Exit 0 accepted, 2 refused (one line on stderr with the CODER_SPEC s.10 code), 1 usage,
note 3 ALARM: a proved property failed on this run (length identity, upper or lower bound, ub rule,
note or a micro-bit sum that would wrap).
note Refusals come in turing-coder's order (encode: TPS1, TSY1, pair; decode: TPS1, coded file,
note decode; verify: TPS1, coded file and decode, TSY1 and pair, byte identity).
note
note Every file is streamed through fixed buffers, so memory does not grow with the number of
note symbols. The micro-bit sums are 64-bit, and one past either ceiling wraps 2^64-1 (Wolfram W3):
note   tpsload refuses n > 1152514738906 with ARG, before the body-size check, because
note   16005647*n + 480000000 no longer fits
note   report refuses a coded file of more than 2305843009213 bytes with ARG, because
note   coded_bytes*8*1000000 no longer fits
note These are the word limits of the check, not a buffer size. A sum that would wrap anyway
note raises ALARM 7 (uadd / umul). Each input is read twice: a validation pass (trailer digest,
note header, every record or symbol, in the refusal order of src/turing/tc_pstream.c) and the
note coding pass, which re-checks every record and symbol and re-hashes the file (DIGEST if it
note changed in between). An output path naming an input is refused; a refusal after the output
note was created, including IO (102) from a failed fsync or fclose in ofinish, removes it.
note
note Length bounds. The Lean file docs/turing/proofs/TcrBound.lean proves the natural-number model
note (step, renorm, run), not encs. The log step and Wolfram receipts are in
note docs/turing/TURING_YIELD_RANGE_CODER_OM.md.
note   payload_bytes = renorm shifts + 4, coded_bits = 8 * shifts + 480
note   encode: shifts are EN[5], one per encs renorm; payload is the bytes emitted (EN[6])
note   decode and verify: shifts are DC[5], one per decs renorm byte (range < 2^24). The four
note     bytes decbeg reads are not shifts. Payload is the declared length. ST[7] is DC[5],
note     not payload - 4. ALARM 1 if they disagree.
note   selftest: both comparisons, on the encoded bytes and after a successful decode
note   upper: 1000000 * coded_bits <= ideal_ub + 5647 * n + 480000000
note   lower: 1000000 * coded_bits >= ideal_ub + 472000000 - n - gain_ub, gain_ub = sum over symbols
note          coded as the last of their row of an upper bound of 1e6 * log2(1 + 256/q) (gub).
note          That integer test is a necessary consequence of coded_bits >= T + 472 - G, not a
note          sufficient one. lower=PASS certifies coded_bits >= T + 472 - G -
note          (1.49984 n + 24.37 m) / 1e6, m = last-symbol count (see the range-coder doc).
note The upper and lower comparisons run on every encode, decode, verify and selftest case.

global RB uchar 196608
global RS ulong 24
global OB uchar 65536
global OS ulong 8
global MB uchar 16777216
global HB uchar 256
global HS uint 16
global HP uchar 128
global HN ulong 2
global Q ulong 16
global EN ulong 8
global DC ulong 8
global ST ulong 32
global UBT ulong 65537
global AR uchar 24576
global AL ulong 8
global DG uchar 256
global INO ulong 8
global HSEL ulong 4
global FS uchar 128
global PB uchar 4096
global PL ulong 2
global RG ulong 2

text DPS "turing.tc.pstream.v1"
text DSY "turing.tc.symbols.v1"
text ENAM "ARG     IO      FORMAT  DIGEST  NORM    ZERO    PROFILE MODEL   DATASET COUNT   HEADER  BINDING TRUNC   TRAIL   CORRUPT SYMBOL  INDEX   "
text TREF "tcr-om: refused -"
text TALM "tcr-om: ALARM "
text TAT " at "
text TUSE "usage: tcr-om encode|decode|verify range IN.tps IN.tsy|IN.tcr OUT|IN, or tcr-om selftest\n"
text KMODE "mode="
text KCNT "count="
text KIDL "ideal_ub="
text KCB "coded_bytes="
text KCBT "coded_bits="
text KPAY "payload_bytes="
text KSHF "shifts="
text KBND "bound_ub="
text KSLK "slack_ub="
text KOVH "overhead_ub="
text KTPS "tps1_digest="
text KTSY "tsy1_digest="
text KBOK "bound=PASS\n"
text KLOW "lower_ub="
text KLOK "lower=PASS\n"
text KRT "roundtrip=byte-exact\n"
text KCASE "selftest cases="
text KSYM " symbols="
text KFLIP " flips_detected="
text KMIN " min_slack_ub="
text KMIN1 " min_slack_n_ge_1_ub="
text KLMIN " min_lower_slack_ub="
text KBELOW " max_below_ideal_ub="
text KPASS "\nselftest=PASS\n"
text WENC "encode"
text WDEC "decode"
text WVER "verify"
text WSLF "selftest"
text WRNG "range"
text ALID "length identity payload_bytes != shifts + 4"
text ALBD "length bound 1e6*coded_bits > ideal_ub + 5647*n + 480e6"
text ALRT "selftest round trip"
text ALFL "selftest corruption not detected"
text ALUB "ub rule differs from the Wolfram receipt"
text ALLO "lower bound 1e6*coded_bits < ideal_ub + 472e6 - n - gain_ub"
text ALOV "length sum would wrap the 64-bit micro-bit word"
text WOVF "overflow"
text KUB "ub_rule q=1..65535 sum="
text KUBQ " qsum="

note ---------------------------------------------------------------- printing (PB to fd 1 or 2)

fn pbyte b ulong to void
n = get PL 0
if lt n 4096
put PB n uchar b
put PL 0 add n 1
end
end

fn ptext t view uchar * to void
for i ulong len t bound 4096
pbyte ulong get t i
end
end

fn pdec v ulong to void
d = new uchar 24 0
k = ulong 0
x = v
while true bound 21
put d k uchar add rem x 10 48
k = add k 1
x = div x 10
if eq x 0
break
end
end
while gt k 0 bound 21
k = sub k 1
pbyte ulong get d k
end
end

fn phex o ulong to void
for i ulong 32
b = ulong get DG add o i
h = shr b 4
l = and b 15
if lt h 10
pbyte add h 48
else
pbyte add h 87
end
if lt l 10
pbyte add l 48
else
pbyte add l 87
end
end
end

fn pkv k view uchar * v ulong to void
ptext k
pdec v
pbyte 10
end

fn pflush fd int to void
n = get PL 0
o = ulong 0
while lt o n bound 4096
k = write fd PB o sub n o
if le k 0
break
end
o = add o ulong k
end
put PL 0 0
end

note ---------------------------------------------------------------- refusal and cleanup

fn cleanup to void
note Remove a partly written output file (encode, decode) after a refusal.
if eq get OS 4 1
f = int get OS 0
z = fclose f
o = mul get OS 5 4096
k = unlink AR o get AL get OS 5
put OS 4 0
end
end

fn refuse c ulong t ulong to void
note c = 101..117 (CODER_SPEC s.10), t = the record or symbol index (or 0).
cleanup
put PL 0 0
ptext TREF
pdec c
pbyte 32
o = mul sub c 101 8
for i ulong 8
b = ulong get ENAM add o i
if ne b 32
pbyte b
end
end
ptext TAT
pdec t
pbyte 10
pflush 2
exit 2
end

fn alarm w ulong to void
cleanup
pflush 1
ptext TALM
if eq w 1
ptext ALID
end
if eq w 2
ptext ALBD
end
if eq w 3
ptext ALRT
end
if eq w 4
ptext ALFL
end
if eq w 5
ptext ALUB
end
if eq w 6
ptext ALLO
end
if eq w 7
ptext ALOV
end
pbyte 10
pflush 2
exit 3
end

note ---------------------------------------------------------------- input streams (0 TPS, 1 TSY, 2 coded)

fn rdfill s ulong to ulong
b = mul s 8
f = int get RS b
k = read f RB mul s 65536 65536
if lt k 0
refuse 102 0
end
put RS add b 1 0
put RS add b 2 ulong k
ret ulong k
end

fn rdb s ulong to ulong
note Next byte of stream s, or 256 at end of file. HSEL[s] = 1 + h feeds the byte to hash stream h.
b = mul s 8
if ge get RS add b 1 get RS add b 2
k = rdfill s
if eq k 0
ret 256
end
end
p = get RS add b 1
put RS add b 1 add p 1
v = ulong get RB add mul s 65536 p
h = get HSEL s
if ne h 0
hbyte sub h 1 v
end
ret v
end

fn lefs o ulong to ulong
v = ulong 0
for i ulong 8
v = or shl v 8 ulong get FS sub add o 7 i
end
ret v
end

fn sopen s ulong a ulong to ulong
note Open argument a read-only as stream s; returns its size in bytes and keeps its device and
note inode (INO[2s], INO[2s+1]) so that an output path naming an input is refused.
o = mul a 4096
f = fopen AR o get AL a 0 0
if lt f 0
refuse 102 0
end
b = mul s 8
put RS b ulong f
put RS add b 1 0
put RS add b 2 0
put HSEL s 0
k = fstat int f FS 0 128
if lt k 0
refuse 102 0
end
put INO mul s 2 lefs 0
put INO add mul s 2 1 lefs 8
ret lefs 48
end

fn srew s ulong to void
note Back to byte 0 of stream s.
b = mul s 8
f = int get RS b
k = fseek f long 0 int 0
if ne k 0
refuse 102 0
end
put RS add b 1 0
put RS add b 2 0
end

fn rdn s ulong n ulong to void
note n bytes of stream s into HB[0..n); a short file here is an IO refusal (sizes are checked first).
for i ulong n bound 256
b = rdb s
if eq b 256
refuse 102 0
end
put HB i uchar b
end
end

fn lev o ulong w ulong to ulong
note Little-endian value of w bytes at HB[o].
v = ulong 0
for i ulong w bound 8
v = or shl v 8 ulong get HB sub add o sub w 1 i
end
ret v
end

fn magic a ulong b ulong c ulong d ulong to bool
r = true
if ne ulong get HB 0 a
r = false
end
if ne ulong get HB 1 b
r = false
end
if ne ulong get HB 2 c
r = false
end
if ne ulong get HB 3 d
r = false
end
ret r
end

note ---------------------------------------------------------------- SHA-256 streams over sh_ (h 0, 1)

fn hblk h ulong to void
for j ulong 8
put sh_h j get HS add mul h 8 j
end
for j ulong 64
put sh_pad j get HP add mul h 64 j
end
sh_blk 1 0
for j ulong 8
put HS add mul h 8 j get sh_h j
end
end

fn hbyte h ulong b ulong to void
n = get HN h
put HP add mul h 64 rem n 64 uchar b
n = add n 1
put HN h n
if eq rem n 64 0
hblk h
end
end

fn hbeg h ulong d ulong to void
note Start stream h with domain d (0 pstream, 1 symbols) and its 0x00 separator.
sh_init
for j ulong 8
put HS add mul h 8 j get sh_k add j 64
end
put HN h 0
for i ulong 20
if eq d 0
hbyte h ulong get DPS i
else
hbyte h ulong get DSY i
end
end
hbyte h 0
end

fn hend h ulong o ulong to void
note Finish stream h; the 32-byte digest goes to DG[o..o+32).
bits = mul get HN h 8
hbyte h 128
while ne rem get HN h 64 56 bound 64
hbyte h 0
end
for j ulong 8
hbyte h and shr bits mul sub 7 j 8 255
end
for j ulong 8
put sh_h j get HS add mul h 8 j
end
sh_out
for i ulong 32
put DG add o i get sh_dig i
end
end

fn dgeq a ulong b ulong to bool
r = true
for i ulong 32
if ne get DG add a i get DG add b i
r = false
end
end
ret r
end

fn hfile s ulong d ulong sz ulong o ulong to bool
note Validation pass: hash domain d || bytes[0..sz-32) of stream s, read the 32-byte trailer
note into DG[o+32..o+64) and the computed digest into DG[o..o+32); true when they agree.
hbeg 0 d
m = sub sz 32
x = ulong 0
while lt x m bound 9223372036854775807
b = rdb s
if eq b 256
refuse 102 0
end
hbyte 0 b
x = add x 1
end
for i ulong 32
b = rdb s
if eq b 256
refuse 102 0
end
put DG add add o 32 i uchar b
end
hend 0 o
ret dgeq o add o 32
end

note ---------------------------------------------------------------- ideal length (CODER_SPEC s.8)

fn sq62 m ulong to ulong
note floor(m * m / 2^62) for m < 2^63 through 32-bit limbs (as tqsq, native/turing/origsel.om).
a = shr m 32
b = and m 4294967295
p0 = mul b b
p1 = mul a b
p2 = mul a a
c = shl p1 1
mid = add shr p0 32 and c 4294967295
lo = or and p0 4294967295 shl and mid 4294967295 32
hi = add add p2 shr c 32 shr mid 32
ret or shl hi 2 shr lo 62
end

fn hibit q ulong to ulong
i = ulong 63
while eq and shr q i 1 0 bound 64
i = sub i 1
end
ret i
end

fn ubcalc q ulong to ulong
ip = hibit q
m = shl q sub 62 ip
f = ulong 0
for i ulong 32
m = sq62 m
if ge m 9223372036854775808
f = or f shl 1 sub 31 i
m = shr m 1
end
end
l = or shl ip 32 f
x = sub 68719476736 l
ret shr add mul x 1000000 2147483648 32
end

fn ub q ulong to ulong
note ub(q) in micro-bits, memoised (UBT holds ub + 1, 0 = not yet computed).
v = get UBT q
if eq v 0
v = add ubcalc q 1
put UBT q v
end
ret sub v 1
end

note ---------------------------------------------------------------- payload byte sink and source

fn oflush to void
n = get OS 1
f = int get OS 0
o = ulong 0
while lt o n bound 65536
k = write f OB o sub n o
if le k 0
refuse 102 0
end
o = add o ulong k
end
put OS 1 0
end

fn obyte b ulong to void
note Output byte to the file buffer (OS[3] = 0) or to the selftest memory MB (OS[3] = 1).
if eq get OS 3 1
p = get OS 2
put MB p uchar b
put OS 2 add p 1
ret
end
n = get OS 1
put OB n uchar b
put OS 1 add n 1
if eq add n 1 65536
oflush
end
end

fn nxtb to ulong
note Next payload byte for the decoder, or 256 when the declared payload is used up.
p = get DC 2
if ge p get DC 3
ret 256
end
put DC 2 add p 1
if eq get DC 4 1
ret ulong get MB p
end
b = rdb 2
if eq b 256
refuse 102 0
end
ret b
end

note ---------------------------------------------------------------- range coder (CODER_SPEC s.5)

fn shlow to ulong
note shift_low; returns 0. A carry before the first cached byte has nowhere to land, so the
note emitted length cannot equal the renorm shifts. That is the length identity, ALARM 1,
note not a bad input (decode still reports CORRUPT).
lo = get EN 0
c = shr lo 32
if or lt and lo 4294967295 4278190080 ne c 0
if eq get EN 3 1
obyte and add get EN 2 c 255
put EN 6 add get EN 6 1
else
if ne c 0
alarm 1
end
end
while gt get EN 4 0 bound 9223372036854775807
obyte and add 255 c 255
put EN 6 add get EN 6 1
put EN 4 sub get EN 4 1
end
put EN 2 and shr lo 24 255
put EN 3 1
else
put EN 4 add get EN 4 1
end
put EN 0 shl and lo 16777215 8
ret 0
end

fn encbeg to void
put EN 0 0
put EN 1 4294967295
put EN 2 0
put EN 3 0
put EN 4 0
put EN 5 0
put EN 6 0
end

fn encs s ulong to ulong
note Code symbol s with the row Q[0..K), K = ST[2]; returns 0 or a refusal number.
k = get ST 2
cum = ulong 0
for x ulong s bound 16
cum = add cum get Q x
end
rg = get EN 1
r = shr rg 16
put EN 0 add get EN 0 mul r cum
if eq s sub k 1
rg = sub rg mul r cum
else
rg = mul r get Q s
end
while lt rg 16777216 bound 2
rg = shl rg 8
put EN 5 add get EN 5 1
e = shlow
if ne e 0
ret e
end
end
put EN 1 rg
ret 0
end

fn encend to ulong
for i ulong 5
e = shlow
if ne e 0
ret e
end
end
ret 0
end

fn decbeg to ulong
note DC: 0 code, 1 range, 2 payload bytes consumed, 3 payload bytes declared, 4 source,
note 5 renorm shifts (one per decs byte, not these four).
if lt get DC 3 4
ret 113
end
put DC 2 0
put DC 5 0
c = ulong 0
for i ulong 4
c = or shl c 8 nxtb
end
put DC 0 c
put DC 1 4294967295
ret 0
end

fn decs to ulong
note Decode one symbol with the row Q[0..K); returns it, or 1000 + a refusal number.
k = get ST 2
code = get DC 0
rg = get DC 1
if ge code rg
ret 1115
end
r = shr rg 16
cum = ulong 0
s = ulong 0
nk = sub k 1
while lt s nk bound 16
nx = add cum get Q s
if lt code mul r nx
break
end
cum = nx
s = add s 1
end
code = sub code mul r cum
if eq s nk
rg = sub rg mul r cum
else
rg = mul r get Q s
end
while lt rg 16777216 bound 2
b = nxtb
if gt b 255
ret 1113
end
code = and or shl code 8 b 4294967295
rg = shl rg 8
put DC 5 add get DC 5 1
end
put DC 0 code
put DC 1 rg
ret s
end

fn decend to ulong
if ne get DC 0 0
ret 115
end
if ne get DC 2 get DC 3
ret 114
end
ret 0
end

note ---------------------------------------------------------------- TPS1 (stream 0) and TSY1 (stream 1)

fn tpsrow t ulong chk ulong to void
note Read record t into Q (K = ST[2], record bytes ST[3]); chk 1 applies INDEX, ZERO, NORM.
k = get ST 2
rdn 0 get ST 3
if eq chk 1
if ne lev 0 8 t
refuse 117 t
end
end
sum = ulong 0
zero = false
for x ulong k bound 16
v = lev add 24 mul x 2 2
put Q x v
sum = add sum v
if eq v 0
zero = true
end
end
if eq chk 1
if zero
refuse 106 t
end
if ne sum 65536
refuse 105 t
end
if ne lev 20 4 65536
refuse 105 t
end
end
end

fn tpshdr chk ulong to void
note Read the 128-byte header; chk 1 applies the FORMAT checks and fills ST and DG.
rdn 0 128
if eq chk 0
ret
end
k = ulong get HB 6
ok = true
if ne lev 4 2 1
ok = false
end
if ne ulong get HB 7 16
ok = false
end
if ne lev 8 4 0
ok = false
end
if ne lev 24 4 0
ok = false
end
if ne lev 124 4 0
ok = false
end
if lt k 2
ok = false
end
if gt k 16
ok = false
end
if not ok
refuse 103 0
end
put ST 2 k
put ST 0 lev 12 8
put ST 3 add 24 mul k 2
if ne lev 20 4 get ST 3
refuse 103 0
end
for i ulong 32
put DG add 64 i get HB add 92 i
end
end

fn uadd a ulong b ulong to ulong
note a + b, or ALARM 7 if the sum would wrap 2^64.
if gt a sub 18446744073709551615 b
alarm 7
end
ret add a b
end

fn umul a ulong b ulong to ulong
note a * b, or ALARM 7 if the product would wrap 2^64.
if eq a 0
ret 0
end
if eq b 0
ret 0
end
if gt a div 18446744073709551615 b
alarm 7
end
ret mul a b
end

fn ncap n ulong to void
note ARG when n is past the last count whose maximum upper sum fits in 64 bits.
note 16005647 * n + 480000000 <= 2^64-1 for n = 1152514738906 and not for n + 1 (Wolfram W3).
if gt n 1152514738906
refuse 101 0
end
end

fn bndsum idl ulong n ulong to ulong
note ideal_ub + 5647*n + 480000000. ALARM 7 if that sum would wrap.
ret uadd uadd idl umul n 5647 480000000
end

fn cubit cb ulong to ulong
note 1000000 * coded_bits = cb * 8 * 1000000. ALARM 7 if that product would wrap.
ret umul umul cb 8 1000000
end

fn tpsload a ulong to void
note Validate TPS1 argument a fully (CODER_SPEC s.2 order). DG[0..32) = its digest,
note DG[64..96) = its dataset digest, ST[0] = count, ST[2] = K, ST[3] = record bytes.
sz = sopen 0 a
if lt sz 160
refuse 103 0
end
rdn 0 4
if not magic 84 80 83 49
refuse 103 0
end
srew 0
if not hfile 0 0 sz 0
refuse 104 0
end
srew 0
tpshdr 1
n = get ST 0
note Before the body-size check. A short file whose header count is past the cap must refuse
note ARG here; the size check would otherwise report FORMAT and the cap would be unreachable
note without a multi-terabyte body.
ncap n
rb = get ST 3
if gt n div sub sz 160 rb
refuse 103 0
end
if ne mul n rb sub sz 160
refuse 103 0
end
t = ulong 0
while lt t n bound 9223372036854775807
tpsrow t 1
t = add t 1
end
end

fn tsyload a ulong to void
note Validate TSY1 argument a (s.3) and the pair check against the loaded TPS1.
sz = sopen 1 a
if lt sz 88
refuse 103 0
end
rdn 1 4
if not magic 84 83 89 49
refuse 103 0
end
srew 1
if not hfile 1 1 sz 96
refuse 104 0
end
srew 1
rdn 1 56
k = ulong get HB 6
ok = true
if ne lev 4 2 1
ok = false
end
if ne ulong get HB 7 0
ok = false
end
if ne lev 16 8 0
ok = false
end
if lt k 2
ok = false
end
if gt k 16
ok = false
end
if not ok
refuse 103 0
end
n = lev 8 8
if ne n sub sz 88
refuse 110 0
end
for i ulong 32
put DG add 128 i get HB add 24 i
end
put ST 4 k
put ST 5 n
t = ulong 0
while lt t n bound 9223372036854775807
b = rdb 1
if ge b k
refuse 116 t
end
t = add t 1
end
if ne k get ST 2
refuse 110 0
end
if ne n get ST 0
refuse 110 0
end
if not dgeq 64 128
refuse 109 0
end
end

note ---------------------------------------------------------------- arguments

fn argget i ulong to void
o = mul i 4096
k = argread i AR o 4096
if lt k 0
refuse 101 0
end
put AL i ulong k
end

fn argis i ulong t view uchar * to bool
if ne get AL i len t
ret false
end
o = mul i 4096
r = true
for j ulong len t bound 4096
if ne get AR add o j get t j
r = false
end
end
ret r
end

note ---------------------------------------------------------------- report

fn gub q ulong to ulong
note Upper bound, in ub, of 1e6 * log2(1 + 256/q): the most the last symbol of a row can gain
note over its ideal (lower bound, TcrBound.lean encode_lower). Each ub is within
note [-0.500192, +0.49984] of exact (Wolfram W2), so the difference plus 2 is safe; for q > 65280
note the gain is below its value at 65281, 1e6 * log2(1 + 256/65281) = 5646.48 (Wolfram W3).
if le q 65280
ret add sub ub q ub add q 256 2
end
ret 5649
end

fn acc s ulong to void
note Add symbol s (row Q) to the ideal length ST[1] and, for the last symbol of the row, to the
note lower-bound gain ST[8].
q = get Q s
put ST 1 uadd get ST 1 ub q
if eq s sub get ST 2 1
put ST 8 uadd get ST 8 gub q
end
end

fn report to void
note ST: 0 n, 1 ideal_ub, 6 payload bytes, 7 renorm shifts, 8 last-symbol gain. Prints the length
note lines and checks the identity and both bounds; a failure is an ALARM (exit 3).
note n is capped in tpsload. cb above 2305843009213 is ARG: coded_bytes*8*1000000 would not fit.
note The additions themselves alarm if they would wrap, which is what a bypassed cap would hit.
n = get ST 0
pay = get ST 6
cb = uadd pay 56
if gt cb 2305843009213
refuse 101 0
end
pkv KCNT n
pkv KIDL get ST 1
pkv KCB cb
pkv KCBT mul cb 8
pkv KPAY pay
pkv KSHF get ST 7
bnd = bndsum get ST 1 n
cub = cubit cb
pkv KBND bnd
if ne pay add get ST 7 4
alarm 1
end
if gt cub bnd
alarm 2
end
pkv KSLK sub bnd cub
lw = uadd get ST 1 472000000
g = uadd n get ST 8
lo = ulong 0
if gt lw g
lo = sub lw g
end
pkv KLOW lo
if lt cub lo
alarm 6
end
ptext KOVH
if ge cub get ST 1
pdec sub cub get ST 1
else
pbyte 45
pdec sub get ST 1 cub
end
pbyte 10
ptext KBOK
ptext KLOK
end

fn hdrw t view uchar * to void
note The 56-byte coded header (s.4) into HB: magic t, version 1, coder 1, count, TPS1 digest, payload.
for i ulong 56
put HB i 0
end
for i ulong 4
put HB i get t i
end
put HB 4 1
put HB 5 1
n = get ST 0
for i ulong 8
put HB add 8 i uchar and shr n mul i 8 255
end
for i ulong 32
put HB add 16 i get DG i
end
p = get ST 6
for i ulong 8
put HB add 48 i uchar and shr p mul i 8 255
end
end

text MTCR "TCR1"

fn sameio d ulong i ulong to bool
r = false
for s ulong 3
if eq get INO mul s 2 d
if eq get INO add mul s 2 1 i
r = true
end
end
end
ret r
end

fn ocreate a ulong to void
note Refuse (ARG) an output path that names one of the open inputs (same device and inode):
note O_TRUNC would destroy the input and the refusal cleanup would then remove it.
o = mul a 4096
k = stat AR o get AL a FS 0 128
if eq k 0
if sameio lefs 0 lefs 8
refuse 101 0
end
end
f = fopen AR o get AL a 577 420
if lt f 0
refuse 102 0
end
put OS 0 ulong f
put OS 1 0
put OS 3 0
put OS 4 1
put OS 5 a
end

fn ofinish to void
note Flush, fsync and close. Refuse IO (102) on fsync or fclose failure before clearing
note OS[4], so cleanup still unlinks the partial output.
oflush
f = int get OS 0
k = fsync f
z = fclose f
if lt k 0
refuse 102 0
end
if lt z 0
refuse 102 0
end
put OS 4 0
end

fn rehbeg s ulong h ulong d ulong to void
note Coding pass: re-read stream s from byte 0 through hash stream h (domain d).
srew s
hbeg h d
put HSEL s add h 1
end

fn rehend s ulong h ulong o ulong w ulong to void
note End of a coding pass: skip the 32-byte trailer, finish hash h into DG[o..o+32) and refuse
note DIGEST unless it equals the validation-pass digest DG[w..w+32) (the file changed between
note the passes).
put HSEL s 0
rdn s 32
hend h o
if not dgeq o w
refuse 104 0
end
end

note ---------------------------------------------------------------- modes

fn cmdenc to int
tpsload 3
tsyload 4
ocreate 5
for i ulong 56
obyte 0
end
rehbeg 0 0 0
tpshdr 0
rehbeg 1 1 1
rdn 1 56
encbeg
n = get ST 0
k = get ST 2
put ST 1 0
put ST 8 0
t = ulong 0
while lt t n bound 9223372036854775807
tpsrow t 1
s = rdb 1
if ge s k
refuse 116 t
end
e = encs s
if ne e 0
refuse e t
end
acc s
t = add t 1
end
e = encend
if ne e 0
refuse e n
end
rehend 0 0 192 0
rehend 1 1 224 96
put ST 6 get EN 6
put ST 7 get EN 5
oflush
hdrw MTCR
f = int get OS 0
w = pwrite f HB 0 56 long 0
if ne w 56
refuse 102 0
end
ofinish
ptext KMODE
ptext WENC
pbyte 10
ptext KTPS
phex 0
pbyte 10
report
pflush 1
ret 0
end

fn codhdr a ulong to void
note Check the coded file header of argument a as stream 2 (s.4 order); DC[3] = payload bytes.
sz = sopen 2 a
if lt sz 56
refuse 111 0
end
rdn 2 56
if not magic 84 67 82 49
refuse 111 0
end
if ne ulong get HB 4 1
refuse 111 0
end
if ne ulong get HB 5 1
refuse 111 0
end
if ne lev 6 2 0
refuse 111 0
end
for i ulong 32
put DG add 32 i get HB add 16 i
end
if not dgeq 0 32
refuse 112 0
end
if ne lev 8 8 get ST 0
refuse 110 0
end
p = lev 48 8
if lt sub sz 56 p
refuse 113 0
end
if gt sub sz 56 p
refuse 114 0
end
put DC 3 p
put DC 4 0
end

fn tsyhdr w ulong to void
note The TSY1 header of the decoded symbols (K, count, dataset digest of the TPS1), fed to hash
note stream 1 and, when w = 1, written to the output.
for i ulong 56
put HB i 0
end
put HB 0 84
put HB 1 83
put HB 2 89
put HB 3 49
put HB 4 1
put HB 6 uchar get ST 2
n = get ST 0
for i ulong 8
put HB add 8 i uchar and shr n mul i 8 255
end
for i ulong 32
put HB add 24 i get DG add 64 i
end
for i ulong 56
b = ulong get HB i
if eq w 1
obyte b
end
hbyte 1 b
end
end

fn decrun w ulong to void
note Decode all symbols into hash stream 1 (and, w = 1, the output file). Fills ST[1] (ideal),
note ST[6], ST[7], ST[8]. The TPS1 is re-hashed and its rows re-checked on the way.
rehbeg 0 0 0
tpshdr 0
e = decbeg
if ne e 0
refuse e 0
end
n = get ST 0
put ST 1 0
put ST 8 0
t = ulong 0
while lt t n bound 9223372036854775807
tpsrow t 1
s = decs
if gt s 999
refuse sub s 1000 t
end
if eq w 1
obyte s
end
hbyte 1 s
acc s
t = add t 1
end
e = decend
if ne e 0
refuse e n
end
rehend 0 0 192 0
put ST 6 get DC 3
put ST 7 get DC 5
end

fn cmddec to int
tpsload 3
codhdr 4
ocreate 5
hbeg 1 1
tsyhdr 1
decrun 1
hend 1 96
for i ulong 32
obyte ulong get DG add 96 i
end
ofinish
ptext KMODE
ptext WDEC
pbyte 10
ptext KTSY
phex 96
pbyte 10
report
pflush 1
ret 0
end

fn cmdver to int
note Same order as turing-coder verify: probability stream, coded file and full decode, then the
note symbol file and the pair check, then byte identity of the symbol file with the decoded one
note (compared through their TSY1 digests: equal digests of domain || header || symbols).
tpsload 3
codhdr 5
hbeg 1 1
tsyhdr 0
decrun 0
hend 1 160
tsyload 4
if not dgeq 160 96
refuse 116 0
end
ptext KMODE
ptext WVER
pbyte 10
ptext KTPS
phex 0
pbyte 10
report
ptext KRT
pflush 1
ret 0
end

note ---------------------------------------------------------------- selftest (synthetic streams in memory)

fn rnd to ulong
x = add mul get RG 0 6364136223846793005 1442695040888963407
put RG 0 x
ret shr x 33
end

fn genrow k ulong md ulong to void
note Row Q[0..k) summing to 65536, every entry >= 1. md 0 random weights, 1 one dominant
note entry (the rest 1), 2 two-level skew, 3 uniform-ish.
if eq md 1
for x ulong k bound 16
put Q x 1
end
d = rem rnd k
put Q d sub 65537 k
ret
end
w = new ulong 16 0
tot = ulong 0
for x ulong k bound 16
v = add rem rnd 1000 1
if eq md 2
if eq rem rnd 4 0
v = add v 40000
end
end
if eq md 3
v = ulong 1000
end
put w x v
tot = add tot v
end
rest = sub 65536 k
used = ulong 0
for x ulong k bound 16
v = add div mul get w x rest tot 1
put Q x v
used = add used v
end
d = rem rnd k
put Q d add get Q d sub 65536 used
end

fn gensym k ulong md ulong to ulong
note md 0: sample from Q; md 1: the least likely symbol (worst information per symbol);
note md 2: always the last symbol of the row (the lower side of the bound).
if eq md 2
ret sub k 1
end
if eq md 1
b = ulong 0
for x ulong k bound 16
if lt get Q x get Q b
b = x
end
end
ret b
end
u = rem rnd 65536
c = ulong 0
for x ulong k bound 16
c = add c get Q x
if lt u c
ret x
end
end
ret sub k 1
end

fn stenc seed ulong n ulong k ulong md ulong to ulong
note Encode case (seed, n, k, md) into MB; returns ideal_ub (gain in ST[8]). md: low 2 bits row
note mode, md >> 2 symbol mode.
put RG 0 seed
put ST 2 k
put OS 3 1
put OS 2 0
encbeg
put ST 1 0
put ST 8 0
t = ulong 0
while lt t n bound 9223372036854775807
genrow k and md 3
s = gensym k shr md 2
e = encs s
if ne e 0
alarm 3
end
acc s
t = add t 1
end
if ne encend 0
alarm 3
end
ret get ST 1
end

fn stdec seed ulong n ulong k ulong md ulong to ulong
note Decode MB[0..OS[2]) against the regenerated case; 0 = identical and terminated, 1 = refused or different.
put RG 0 seed
put ST 2 k
put DC 3 get OS 2
put DC 4 1
if ne decbeg 0
ret 1
end
t = ulong 0
while lt t n bound 9223372036854775807
genrow k and md 3
s = gensym k shr md 2
d = decs
if ne d s
ret 1
end
t = add t 1
end
if ne decend 0
ret 1
end
ret 0
end

fn flip pay ulong to void
note XOR one random payload byte of MB[0..pay) with a nonzero value.
p = rem rnd pay
x = add rem rnd 255 1
put MB p uchar xor ulong get MB p x
end

fn stlow n ulong idl ulong cub ulong to void
note Lower bound for a selftest case (ST[8] = last-symbol gain), its smallest slack (ST[27]) and
note the largest amount any case codes below its ideal (ST[28]).
lw = uadd idl 472000000
g = uadd n get ST 8
lo = ulong 0
if gt lw g
lo = sub lw g
end
if lt cub lo
alarm 6
end
if lt sub cub lo get ST 27
put ST 27 sub cub lo
end
if gt idl cub
if gt sub idl cub get ST 28
put ST 28 sub idl cub
end
end
end

fn stcase seed ulong n ulong k ulong md ulong to void
note One case: round trip, length identity, both bounds, then flip one payload byte and require
note detection.
idl = stenc seed n k md
pay = get OS 2
if ne pay add get EN 5 4
alarm 1
end
bnd = bndsum idl n
cub = cubit uadd pay 56
if gt cub bnd
alarm 2
end
stlow n idl cub
if lt sub bnd cub get ST 20
put ST 20 sub bnd cub
end
if gt n 0
if lt sub bnd cub get ST 24
put ST 24 sub bnd cub
end
end
if ne stdec seed n k md 0
alarm 3
end
if ne get DC 3 add get DC 5 4
alarm 1
end
flip pay
if eq stdec seed n k md 0
alarm 4
end
put ST 21 add get ST 21 1
put ST 22 add get ST 22 1
put ST 23 add get ST 23 n
end

fn ubchk to void
note Exhaustive check of the s.8 ub rule: sum of ub(q) and sum of q * ub(q) mod 2^64 over
note q = 1..65535 must equal the values Wolfram computed from the same rule
note (docs/turing/TURING_YIELD_RANGE_CODER_OM.md, receipt W2): 94539136349 and 1549081999916376.
note The same Wolfram run gives max(exact - ub) = 0.49984 ub, inside the 0.501 the bound uses.
s1 = ulong 0
s2 = ulong 0
q = ulong 1
while lt q 65536 bound 65535
v = ub q
s1 = add s1 v
s2 = add s2 mul q v
q = add q 1
end
put ST 25 s1
put ST 26 s2
if ne s1 94539136349
alarm 5
end
if ne s2 1549081999916376
alarm 5
end
end

fn ceilchk to void
note The last legal n and the last legal coded length still fit. cmdovf is one past the n cap.
note A constant that no longer fits alarms here and selftest does not pass.
ncap 1152514738906
z = bndsum umul 1152514738906 16000000 1152514738906
y = cubit 2305843009213
if eq z 0
alarm 7
end
if eq y 0
alarm 7
end
end

fn cmdovf to int
note n = cap+1 at ub(q=1) per symbol. 16005647*(cap+1) + 480000000 does not fit in 64 bits.
note Must ALARM 7. Returning 0 means the sum wrapped or the check was removed.
z = bndsum umul 1152514738907 16000000 1152514738907
put ST 29 z
ret 0
end

fn cmdself to int
note Cases: K 2..16, all four row modes, three symbol modes, n from 0 to 200000.
ceilchk
put ST 20 18446744073709551615
put ST 24 18446744073709551615
put ST 27 18446744073709551615
put ST 28 0
ubchk
put ST 21 0
put ST 22 0
put ST 23 0
seed = ulong 1
for k ulong 15
for md ulong 12
stcase seed 0 add k 2 md
seed = add seed 1
stcase seed 1 add k 2 md
seed = add seed 1
stcase seed 37 add k 2 md
seed = add seed 1
stcase seed 4000 add k 2 md
seed = add seed 1
end
end
stcase 777 200000 9 0
stcase 778 200000 2 4
stcase 779 200000 16 5
stcase 780 200000 16 7
stcase 781 200000 16 9
stcase 782 200000 2 9
ptext KUB
pdec get ST 25
ptext KUBQ
pdec get ST 26
pbyte 10
ptext KCASE
pdec get ST 22
ptext KSYM
pdec get ST 23
ptext KFLIP
pdec get ST 21
ptext KMIN
pdec get ST 20
ptext KMIN1
pdec get ST 24
ptext KLMIN
pdec get ST 27
ptext KBELOW
pdec get ST 28
ptext KPASS
pflush 1
ret 0
end

fn main to int
for i ulong 8
put INO i 18446744073709551615
end
c = argcnt
if eq c 2
argget 1
if argis 1 WSLF
ret cmdself
end
end
if eq c 3
argget 1
if argis 1 WSLF
argget 2
if argis 2 WOVF
ret cmdovf
end
end
end
if ne c 6
ptext TUSE
pflush 2
ret 1
end
for i ulong 6
argget i
end
if not argis 2 WRNG
ptext TUSE
pflush 2
ret 1
end
if argis 1 WENC
ret cmdenc
end
if argis 1 WDEC
ret cmddec
end
if argis 1 WVER
ret cmdver
end
ptext TUSE
pflush 2
ret 1
end

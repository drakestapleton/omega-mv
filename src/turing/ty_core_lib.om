  put g_shk 67 2773480762
  put g_shk 68 1359893119
  put g_shk 69 2600822924
  put g_shk 70 528734635
  put g_shk 71 1541459225
end

fn sh_load_w to void
  for i ulong 16
    b0 = shl uint get g_shb mul i 4 uint 24
    b1 = shl uint get g_shb add mul i 4 1 uint 16
    b2 = shl uint get g_shb add mul i 4 2 uint 8
    b3 = uint get g_shb add mul i 4 3
    put g_shw i or or b0 b1 or b2 b3
  end
  i = ulong 16
  while lt i 64 bound 64
    x = get g_shw sub i 15
    s0 = xor xor rotr x uint 7 rotr x uint 18 shr x uint 3
    y = get g_shw sub i 2
    s1 = xor xor rotr y uint 17 rotr y uint 19 shr y uint 10
    put g_shw i add add get g_shw sub i 16 s0 add get g_shw sub i 7 s1
    i = add i 1
  end
end

fn sh_round j ulong to void
  e = get g_shv 4
  s1 = xor rotr e uint 6 rotr e uint 11
  s1 = xor s1 rotr e uint 25
  ch = xor and e get g_shv 5 and not e get g_shv 6
  t1 = add get g_shv 7 s1
  t1 = add t1 ch
  t1 = add t1 get g_shk j
  t1 = add t1 get g_shw j
  a = get g_shv 0
  s0 = xor rotr a uint 2 rotr a uint 13
  s0 = xor s0 rotr a uint 22
  maj = xor and a get g_shv 1 and a get g_shv 2
  maj = xor maj and get g_shv 1 get g_shv 2
  t2 = add s0 maj
  put g_shv 7 get g_shv 6
  put g_shv 6 get g_shv 5
  put g_shv 5 e
  put g_shv 4 add get g_shv 3 t1
  put g_shv 3 get g_shv 2
  put g_shv 2 get g_shv 1
  put g_shv 1 a
  put g_shv 0 add t1 t2
end

fn sh_block to void
  sh_load_w
  for j ulong 8
    put g_shv j get g_shh j
  end
  for j ulong 64
    sh_round j
  end
  for j ulong 8
    put g_shh j add get g_shh j get g_shv j
  end
end

fn sh_init to void
  sh_init_tbl
  for i ulong 8
    put g_shh i get g_shk add i 64
  end
  put g_shm 0 0
  put g_shm 1 0
end

fn sh_byte b uchar to void
  bl = get g_shm 0
  put g_shb bl b
  bl = add bl 1
  put g_shm 1 add get g_shm 1 1
  if eq bl 64
    sh_block
    bl = 0
  end
  put g_shm 0 bl
end

fn sh_slice s view uchar * n ulong to void
  for i ulong n bound 10000000
    sh_byte get s i
  end
end

fn sh_final slot ulong to void
  tot = get g_shm 1
  bits = mul tot 8
  sh_byte uchar 128
  while ne get g_shm 0 56 bound 128
    sh_byte uchar 0
  end
  for i ulong 8
    sh = mul sub 7 i 8
    sh_byte uchar and shr bits sh 255
  end
  off = mul slot 32
  for i ulong 8
    w = get g_shh i
    o = add off mul i 4
    put g_dig o uchar and shr w uint 24 uint 255
    put g_dig add o 1 uchar and shr w uint 16 uint 255
    put g_dig add o 2 uchar and shr w uint 8 uint 255
    put g_dig add o 3 uchar and w uint 255
  end
end

note ---- Digest helpers on g_dig ----
fn dg_eq s1 ulong s2 ulong to bool
  o1 = mul s1 32
  o2 = mul s2 32
  for i ulong 32
    if ne get g_dig add o1 i get g_dig add o2 i
      ret false
    end
  end
  ret true
end

fn dg_cp dst ulong src ulong to void
  o1 = mul dst 32
  o2 = mul src 32
  for i ulong 32
    put g_dig add o1 i get g_dig add o2 i
  end
end

fn dg_zero slot ulong to void
  o = mul slot 32
  for i ulong 32
    put g_dig add o i uchar 0
  end
end

fn dg_is_zero slot ulong to bool
  o = mul slot 32
  for i ulong 32
    if ne get g_dig add o i 0
      ret false
    end
  end
  ret true
end

fn dg_to_hex slot ulong dst edit uchar * to void
  o = mul slot 32
  for i ulong 32
    b = ulong get g_dig add o i
    put dst mul i 2 get t_hx shr b 4
    put dst add mul i 2 1 get t_hx and b 15
  end
end

fn dg_parse_hex s view uchar * n ulong slot ulong to long
  if lt n 64
    ret TY_E_FORMAT
  end
  o = mul slot 32
  for i ulong 32
    v = ulong 0
    for j ulong 2
      c = get s add mul i 2 j
      d = long -1
      if and ge c 48 le c 57
        d = long sub c 48
      else
        if and ge c 97 le c 102
          d = add long sub c 97 10
        end
      end
      if lt d 0
        ret TY_E_FORMAT
      end
      v = add mul v 16 ulong d
    end
    put g_dig add o i uchar v
  end
  ret TY_OK
end

fn gp_set s view uchar * n ulong to void
  for i ulong n bound 1024
    put g_path i get s i
  end
  put g_plen 0 n
end

fn ty_file_sha256_gp slot ulong to long
  fd = fopen g_path 0 get g_plen 0 int 0 int 0
  if lt fd 0
    ret TY_E_IO
  end
  sh_init
  done = false
  while not done bound 10000000
    k = read int fd g_fbuf 0 65536
    if lt k 0
      dc = fclose int fd
      ret TY_E_IO
    end
    if eq k 0
      done = true
    else
      ku = ulong k
      for i ulong ku bound 65536
        sh_byte get g_fbuf i
      end
    end
  end
  dc = fclose int fd
  sh_final slot
  ret TY_OK
end

fn ty_file_sha256 path view uchar * plen ulong slot ulong to long
  gp_set path plen
  ret ty_file_sha256_gp slot
end

note ---- OMG0 Canonical Builder ----
fn tv_clr to void
  put g_tvl 0 0
end

fn tv_b c uchar to void
  n = get g_tvl 0
  if lt n 1024
    put g_tv n c
    put g_tvl 0 add n 1
  end
end

fn tv_slice s view uchar * n ulong to void
  for i ulong n bound 1024
    tv_b get s i
  end
end

fn tv_txt s view uchar * to void
  tv_slice s len s
end

fn tv_u64 v ulong to void
  if eq v 0
    tv_b uchar 48
    ret
  end
  dig = new uchar 24 0
  n = ulong 0
  x = v
  while gt x 0 bound 24
    put dig n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = n
  while gt i 0 bound 24
    i = sub i 1
    tv_b get dig i
  end
end

fn tv_i64 v long to void
  if lt v 0
    tv_b uchar 45
    u = add not bitcast ulong v 1
    tv_u64 u
    ret
  end
  tv_u64 ulong v
end

fn tv_dig slot ulong to void
  o = mul slot 32
  for i ulong 32
    b = ulong get g_dig add o i
    tv_b get t_hx shr b 4
    tv_b get t_hx and b 15
  end
end

fn tk_clr to void
  put g_tkl 0 0
end

fn tk_b c uchar to void
  n = get g_tkl 0
  if lt n 128
    put g_tk n c
    put g_tkl 0 add n 1
  end
end

fn tk_txt s view uchar * to void
  n = len s
  for i ulong n bound 128
    tk_b get s i
  end
end

fn tk_2d v ulong to void
  tk_b uchar add 48 div v 10
  tk_b uchar add 48 rem v 10
end

fn ca_reset rec view uchar * to void
  put g_ca_n 0 0
  put g_ca_err 0 0
  tv_clr
  tv_txt rec
  ca_add_k t_tk_record
end

fn ca_add_kv_raw to void
  if ne get g_ca_err 0 0
    ret
  end
  na = get g_ca_n 0
  kl = get g_tkl 0
  vl = get g_tvl 0
  if or ge na 32 or ge kl 64 gt vl 512
    put g_ca_err 0 1
    ret
  end
  ko = mul na 64
  for i ulong kl bound 64
    put g_ca_k add ko i get g_tk i
  end
  put g_ca_kl na kl
  vo = mul na 512
  for i ulong vl bound 512
    put g_ca_v add vo i get g_tv i
  end
  put g_ca_vl na vl
  put g_ca_n 0 add na 1
end

fn ca_add_k key view uchar * to void
  tk_clr
  tk_txt key
  ca_add_kv_raw
end

fn ca_add_txt key view uchar * val view uchar * to void
  tv_clr
  tv_txt val
  ca_add_k key
end

fn ca_add_u64 key view uchar * v ulong to void
  tv_clr
  tv_u64 v
  ca_add_k key
end

fn ca_add_i64 key view uchar * v long to void
  tv_clr
  tv_i64 v
  ca_add_k key
end

fn ca_add_dig key view uchar * slot ulong to void
  tv_clr
  tv_dig slot
  ca_add_k key
end

fn ca_key_lt a ulong b ulong to bool
  la = get g_ca_kl a
  lb = get g_ca_kl b
  m = la
  if lt lb m
    m = lb
  end
  oa = mul a 64
  ob = mul b 64
  for i ulong m bound 64
    ca = get g_ca_k add oa i
    cb = get g_ca_k add ob i
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret lt la lb
end

fn ca_sort to void
  na = get g_ca_n 0
  for i ulong na bound 32
    put g_ca_ord i i
  end
  i = ulong 1
  while lt i na bound 32
    key = get g_ca_ord i
    j = i
    while gt j 0 bound 32
      prev = get g_ca_ord sub j 1
      if ca_key_lt key prev
        put g_ca_ord j prev
        j = sub j 1
      else
        break
      end
    end
    put g_ca_ord j key
    i = add i 1
  end
end

fn cb_u8 b uchar to void
  n = get g_clen 0
  if lt n 40000
    put g_cbuf n b
    put g_clen 0 add n 1
  end
end

fn cb_u16be v ulong to void
  cb_u8 uchar and shr v 8 255
  cb_u8 uchar and v 255
end

fn cb_u32be v ulong to void
  cb_u8 uchar and shr v 24 255
  cb_u8 uchar and shr v 16 255
  cb_u8 uchar and shr v 8 255
  cb_u8 uchar and v 255
end

fn ca_emit_attr ai ulong to void
  kl = get g_ca_kl ai
  cb_u8 uchar kl
  ko = mul ai 64
  for j ulong kl bound 64
    cb_u8 get g_ca_k add ko j
  end
  vl = get g_ca_vl ai
  cb_u16be vl
  vo = mul ai 512
  for j ulong vl bound 512
    cb_u8 get g_ca_v add vo j
  end
end

fn ca_finish kind ulong dom view uchar * dslot ulong to long
  if ne get g_ca_err 0 0
    ret TY_E_FORMAT
  end
  ca_sort
  put g_clen 0 0
  cb_u8 uchar 79
  cb_u8 uchar 77
  cb_u8 uchar 71
  cb_u8 uchar 48
  cb_u8 uchar 1
  cb_u8 uchar kind
  na = get g_ca_n 0
  cb_u16be na
  for i ulong na bound 32
    ca_emit_attr get g_ca_ord i
  end
  cb_u16be 0
  cb_u16be 0
  cb_u32be 0
  sh_init
  sh_slice dom len dom
  sh_byte uchar 0
  n = get g_clen 0
  for i ulong n bound 40000
    sh_byte get g_cbuf i
  end
  sh_final dslot
  ret TY_OK
end

note ---- Packed event helpers ----
note bits: 0..3 sym | 4..7 op | 8..11 depth | 12 first | 13..28 crumb | 29..60 idx
fn ev_pack sym ulong op ulong dep ulong first ulong crumb ulong idx ulong to ulong
  v = and sym 15
  v = or v shl and op 15 4
  v = or v shl and dep 15 8
  v = or v shl and first 1 12
  v = or v shl and crumb 65535 13
  v = or v shl and idx ulong 0xffffffff 29
  ret v
end

fn ev_sym e ulong to ulong
  ret and e 15
end

fn ev_op e ulong to ulong
  ret and shr e 4 15
end

fn ev_dep e ulong to ulong
  ret and shr e 8 15
end

fn ev_first e ulong to ulong
  ret and shr e 12 1
end

fn ev_crumb e ulong to ulong
  ret and shr e 13 65535
end

fn ev_idx e ulong to ulong
  ret and shr e 29 ulong 0xffffffff
end

note ---- Stream management ----
fn st_reset_all to void
  put g_ev_used 0 0
  for i ulong TY_MAX_STREAMS
    put g_st_off i 0
    put g_st_n i 0
    put g_st_ncr i 0
    put g_st_gap i 0
  end
end

fn st_begin sid ulong to void
  put g_st_off sid get g_ev_used 0
  put g_st_n sid 0
  put g_st_ncr sid 0
  put g_st_gap sid 0
end

fn st_push sid ulong ev ulong to long
  u = get g_ev_used 0
  if ge u TY_MAX_EV
    ret TY_E_IO
  end
  put g_ev u ev
  put g_ev_used 0 add u 1
  put g_st_n sid add get g_st_n sid 1
  if ne ev_first ev 0
    put g_st_ncr sid add get g_st_ncr sid 1
  end
  ret TY_OK
end

note ---- CTR1 Reader ----
fn rd16_fb off ulong to ulong
  ret or ulong get g_fbuf off shl ulong get g_fbuf add off 1 8
end

fn rd32_fb off ulong to ulong
  b0 = ulong get g_fbuf off
  b1 = shl ulong get g_fbuf add off 1 8
  b2 = shl ulong get g_fbuf add off 2 16
  b3 = shl ulong get g_fbuf add off 3 24
  ret or or b0 b1 or b2 b3
end

note Decode 247-byte record at g_fbuf[off..]; returns TY_OK (packed ev in g_ty_ret_u[0]) or TY_E_FORMAT
fn ty_ctr1_dec_fb off ulong prev long to long
  for i ulong 4
    if ne get g_fbuf add off i get t_ctr1_mag i
      ret TY_E_FORMAT
    end
  end
  if ne rd16_fb add off 4 1
    ret TY_E_FORMAT
  end
  if ne get g_fbuf add off 22 uchar 0
    ret TY_E_FORMAT
  end
  if or gt get g_fbuf add off 24 uchar 4 gt get g_fbuf add off 25 uchar 2
    ret TY_E_FORMAT
  end
  kind = ulong get g_fbuf add off 6
  rc_v = ulong get g_fbuf add off 7
  prn = ulong get g_fbuf add off 23
  sym = ulong 0
  out_op = ulong 0
  if eq kind 1
    op = rd16_fb add off 20
    if or ge op TY_CTR1_NOPS gt prn 4
      ret TY_E_FORMAT
    end
    if ne prn 0
      if ne rc_v 1
        ret TY_E_FORMAT
      end
      sym = sub prn 1
    else
      if or lt rc_v 2 gt rc_v 4
        ret TY_E_FORMAT
      end
      sym = add 4 sub rc_v 2
    end
    out_op = op
  else
    if eq kind 2
      if or ne prn 0 or lt rc_v 5 gt rc_v 7
        ret TY_E_FORMAT
      end
      if eq rc_v 5
        sym = 7
      else
        sym = 8
      end
      out_op = TY_OP_SUBMIT
    else
      ret TY_E_FORMAT
    end
  end
  dep = rd16_fb add off 29
  if gt dep TY_DEPTH_CLIP
    dep = TY_DEPTH_CLIP
  end
  idx = rd32_fb add off 8
  first = ulong 0
  if eq idx 0
    first = 1
  else
    if or lt prev 0 le long idx prev
      ret TY_E_FORMAT
    end
  end
  put g_ty_ret_u 0 ev_pack sym out_op dep first 0 idx
  ret TY_OK
end

global g_cr_st long 4

fn ty_ctr1_chunk sid ulong nrec ulong to long
  n = get g_cr_st 0
  prev = get g_cr_st 1
  crumb = ulong get g_cr_st 2
  for i ulong nrec bound 260
    rc = ty_ctr1_dec_fb mul i TY_CTR1_BYTES prev
    if ne rc TY_OK
      ret rc
    end
    ev = get g_ty_ret_u 0
    idx = ev_idx ev
    if ne ev_first ev 0
      if gt n 0
        crumb = add crumb 1
      end
    else
      if ne long idx add prev 1
        put g_st_gap sid add get g_st_gap sid 1
      end
    end
    cr_c = crumb
    if gt cr_c 65535
      cr_c = 65535
    end
    ev2 = or ev shl cr_c 13
    prev = long idx
    if ne st_push sid ev2 TY_OK
      ret TY_E_IO
    end
    n = add n 1
  end
  put g_cr_st 0 n
  put g_cr_st 1 prev
  put g_cr_st 2 long crumb
  ret TY_OK
end

fn fb_shift used ulong rem_b ulong to void
  for i ulong rem_b bound 247
    put g_fbuf i get g_fbuf add used i
  end
end

note Read whole CTR1 file at g_path into stream sid (assumes st_begin already called). Returns record count or <0 error.
fn ty_ctr1_read_gp sid ulong to long
  fd = fopen g_path 0 get g_plen 0 int 0 int 0
  if lt fd 0
    ret TY_E_IO
  end
  put g_cr_st 0 0
  put g_cr_st 1 -1
  put g_cr_st 2 0
  rem_b = ulong 0
  done = false
  while not done bound 10000000
    k = read int fd g_fbuf rem_b sub 64220 rem_b
    if lt k 0
      dc = fclose int fd
      ret TY_E_IO
    end
    if eq k 0
      done = true
    else
      tot = add rem_b ulong k
      nrec = div tot TY_CTR1_BYTES
      crc = ty_ctr1_chunk sid nrec
      if ne crc TY_OK
        dc = fclose int fd
        ret crc
      end
      used = mul nrec TY_CTR1_BYTES
      rem_b = sub tot used
      fb_shift used rem_b
    end
  end
  dc = fclose int fd
  if ne rem_b 0
    ret TY_E_FORMAT
  end
  ret get g_cr_st 0
end

fn ty_ctr1_read path view uchar * plen ulong sid ulong to long
  gp_set path plen
  ret ty_ctr1_read_gp sid
end

note ---- TYM0 Context-Table Models ----
fn ty_key_space mask ulong k ulong to long
  if or ne and mask not TY_F_ALL 0 or lt k 2 gt k TY_KMAX
    ret TY_E_ARG
  end
  p = ulong 1
  lim = shl ulong 1 62
  if ne and mask TY_F_OP 0
    p = mul p 16
  end
  if ne and mask TY_F_DEPTH 0
    p = mul p 8
  end
  kp1 = add k 1
  if ne and mask TY_F_PREV1 0
    p = mul p kp1
  end
  if ne and mask TY_F_PREV2 0
    p = mul p kp1
  end
  if ne and mask TY_F_PREV3 0
    p = mul p kp1
  end
  if ne and mask TY_F_PREV4 0
    p = mul p kp1
  end
  if ne and mask TY_F_PREV5 0
    p = mul p kp1
  end
  if ne and mask TY_F_POS 0
    if gt p shr lim 36
      ret TY_E_RANGE
    end
    p = shl p 36
  end
  if gt p lim
    ret TY_E_RANGE
  end
  bits = ulong 0
  if gt p 1
    bits = sub 64 ty_clz64 sub p 1
  end
  put g_ty_ret_u 0 p
  put g_ty_ret_u 1 bits
  ret TY_OK
end

global g_kw ulong 8
fn kw_init mask ulong k ulong to void
  put g_kw 0 mask
  put g_kw 1 k
  put g_kw 2 k
  put g_kw 3 k
  put g_kw 4 k
  put g_kw 5 k
  put g_kw 6 k
end

fn kw_key ev ulong to ulong
  mask = get g_kw 0
  k = get g_kw 1
  if ne ev_first ev 0
    put g_kw 2 k
    put g_kw 3 k
    put g_kw 4 k
    put g_kw 5 k
    put g_kw 6 k
  end
  key = ulong 0
  m = ulong 1
  if ne and mask TY_F_OP 0
    key = add key mul ev_op ev m
    m = mul m 16
  end
  if ne and mask TY_F_DEPTH 0
    key = add key mul ev_dep ev m
    m = mul m 8
  end
  kp1 = add k 1
  if ne and mask TY_F_PREV1 0
    key = add key mul get g_kw 2 m
    m = mul m kp1
  end
  if ne and mask TY_F_PREV2 0
    key = add key mul get g_kw 3 m
    m = mul m kp1
  end
  if ne and mask TY_F_PREV3 0
    key = add key mul get g_kw 4 m
    m = mul m kp1
  end
  if ne and mask TY_F_PREV4 0
    key = add key mul get g_kw 5 m
    m = mul m kp1
  end
  if ne and mask TY_F_PREV5 0
    key = add key mul get g_kw 6 m
    m = mul m kp1
  end
  if ne and mask TY_F_POS 0
    idx = ev_idx ev
    if ge idx 1048576
      idx = 1048575
    end
    pv = or shl ev_crumb ev 20 idx
    key = add key mul pv m
  end
  ret key
end

fn kw_adv ev ulong to void
  put g_kw 6 get g_kw 5
  put g_kw 5 get g_kw 4
  put g_kw 4 get g_kw 3
  put g_kw 3 get g_kw 2
  put g_kw 2 ev_sym ev
end

fn ty_mix64 x ulong to ulong
  z = xor x shr x 33
  z = mul z or shl ulong 0xff51afd7 32 ulong 0xed558ccd
  z = xor z shr z 33
  z = mul z or shl ulong 0xc4ceb9fe 32 ulong 0x1a85ec53
  ret xor z shr z 33
end

fn ht_clear to void
  put g_ht_n 0 0
  for i ulong TY_HT_CAP bound 131072
    put g_ht_s i uint 0
  end
end

fn ht_inc key ulong sym ulong to long
  j = and ty_mix64 key sub TY_HT_CAP 1
  while ne get g_ht_s j uint 0 bound 131072
    if eq get g_ht_k j key
      ri = sub ulong get g_ht_s j 1
      o = add mul ri 16 sym
      put g_ht_rc o add get g_ht_rc o 1
      ret TY_OK
    end
    j = and add j 1 sub TY_HT_CAP 1
  end
  n = get g_ht_n 0
  if ge n TY_MAX_MROWS
    ret TY_E_IO
  end
  put g_ht_rk n key
  bo = mul n 16
  for x ulong 16
    put g_ht_rc add bo x 0
  end
  put g_ht_rc add bo sym 1
  put g_ht_k j key
  put g_ht_s j uint add n 1
  put g_ht_n 0 add n 1
  ret TY_OK
end

note Heapsort model rows in slot ms by ascending key
fn md_swap_row ms ulong a ulong b ulong to void
  bo = mul ms TY_MAX_MROWS
  ka = get g_md_rkey add bo a
  put g_md_rkey add bo a get g_md_rkey add bo b
  put g_md_rkey add bo b ka
  oa = mul add bo a 16
  ob = mul add bo b 16
  for x ulong 16
    t = get g_md_rq add oa x
    put g_md_rq add oa x get g_md_rq add ob x
    put g_md_rq add ob x t
  end
end

fn md_sift_step bo ulong root ulong end_n ulong to ulong
  ch = add mul root 2 1
  sw = root
  if lt get g_md_rkey add bo sw get g_md_rkey add bo ch
    sw = ch
  end
  ch2 = add ch 1
  if lt ch2 end_n
    if lt get g_md_rkey add bo sw get g_md_rkey add bo ch2
      sw = ch2
    end
  end
  ret sw
end

fn md_sift ms ulong start ulong end_n ulong to void
  bo = mul ms TY_MAX_MROWS
  root = start
  while lt add mul root 2 1 end_n bound 128
    sw = md_sift_step bo root end_n
    if eq sw root
      ret
    end
    md_swap_row ms root sw
    root = sw
  end
end

fn md_sort ms ulong to void
  n = get g_md_nr ms
  if le n 1
    ret
  end
  i = div n 2
  while gt i 0 bound 65536
    i = sub i 1
    md_sift ms i n
  end
  e = n
  while gt e 1 bound 65536
    e = sub e 1
    md_swap_row ms 0 e
    md_sift ms 0 e
  end
end

fn ty_model_uniform ms ulong k ulong to long
  if or lt k 2 gt k TY_KMAX
    ret TY_E_ARG
  end
  put g_md_k ms k
  put g_md_mask ms 0
  put g_md_kb ms 0
  put g_md_nr ms 0
  z = new ulong 16 0
  q = new uint 16 0
  rc = ty_quantize_kt z k q
  if ne rc TY_OK
    ret rc
  end
  bo = mul ms 16
  for x ulong k
    put g_md_def add bo x get q x
  end
  ret TY_OK
end

global g_fit_cnt ulong 16
global g_fit_rq uint 16

fn ty_mdl_save ms ulong k ulong to long
  dbo = mul ms 16
  sv = long 0
  for x ulong k
    u1 = ty_ubits_q16 ulong get g_md_def add dbo x
    u2 = ty_ubits_q16 ulong get g_fit_rq x
    c = long get g_fit_cnt x
    sv = add sv mul c sub u1 u2
  end
  ret sv
end

fn ty_store_row ms ulong i ulong k ulong to void
  nr = get g_md_nr ms
  mbo = mul ms TY_MAX_MROWS
  put g_md_rkey add mbo nr get g_ht_rk i
  ro = mul add mbo nr 16
  for x ulong k
    put g_md_rq add ro x get g_fit_rq x
  end
  put g_md_nr ms add nr 1
end

fn ty_fit_one_row ms ulong i ulong k ulong rcost long rule ulong to long
  cnt = new ulong 16 0
  rq = new uint 16 0
  ho = mul i 16
  for x ulong k
    v = get g_ht_rc add ho x
    put cnt x v
    put g_fit_cnt x v
  end
  if ne ty_quantize_kt cnt k rq TY_OK
    ret TY_E_RANGE
  end
  for x ulong k
    put g_fit_rq x get rq x
  end
  if eq rule TY_FIT_MDL_PRUNE
    if le ty_mdl_save ms k rcost
      ret TY_OK
    end
  end
  ty_store_row ms i k
  ret TY_OK
end

fn ty_fit_rows ms ulong k ulong kb ulong rule ulong to long
  rcost = mul long add kb mul sub k 1 TY_QBITS TY_UB_PER_BIT
  hn = get g_ht_n 0
  for i ulong hn bound 65536
    rc = ty_fit_one_row ms i k rcost rule
    if ne rc TY_OK
      ret rc
    end
  end
  md_sort ms
  ret TY_OK
end

global g_fit_tot ulong 16

fn ty_fit_stream sid ulong mask ulong k ulong to long
  kw_init mask k
  so = get g_st_off sid
  sn = get g_st_n sid
  for t ulong sn bound 2097152
    ev = get g_ev add so t
    sym = ev_sym ev
    if ge sym k
      ret TY_E_RANGE
    end
    key = kw_key ev
    put g_fit_tot sym add get g_fit_tot sym 1
    if ne mask 0
      if ne ht_inc key sym TY_OK
        ret TY_E_IO
      end
    end
    kw_adv ev
  end
  ret TY_OK
end

note Fit model ms on streams g_fit_sids[0..ns-1]
fn ty_model_fit ms ulong ns ulong mask ulong k ulong rule ulong to long
  if and ne rule TY_FIT_KEEP_ALL ne rule TY_FIT_MDL_PRUNE
    ret TY_E_ARG
  end
  rc = ty_key_space mask k
  if ne rc TY_OK
    ret rc
  end
  kb = get g_ty_ret_u 1
  put g_md_k ms k
  put g_md_mask ms mask
  put g_md_kb ms kb
  put g_md_nr ms 0
  for x ulong 16
    put g_fit_tot x 0
  end
  if ne mask 0
    ht_clear
  end
  for si ulong ns bound 16
    src = ty_fit_stream get g_fit_sids si mask k
    if ne src TY_OK
      ret src
    end
  end
  tot = new ulong 16 0
  for x ulong k
    put tot x get g_fit_tot x
  end
  dq = new uint 16 0
  if ne ty_quantize_kt tot k dq TY_OK
    ret TY_E_RANGE
  end
  dbo = mul ms 16
  for x ulong k
    put g_md_def add dbo x get dq x
  end
  if eq mask 0
    ret TY_OK
  end
  ret ty_fit_rows ms k kb rule
end

note ---- TYM0 Bitstream Encode / Decode ----
global g_bw_bits ulong 1
global g_br_pos ulong 1
global g_br_nbits ulong 1
global g_br_err ulong 1

fn bw_bit cs ulong b ulong to void
  bp = get g_bw_bits 0
  by = shr bp 3
  if and ne b 0 lt by TY_MCODE_SLOT
    idx = add mul cs TY_MCODE_SLOT by
    sh = sub 7 and bp 7
    m = uchar shl ulong 1 sh
    put g_mcode idx or get g_mcode idx m
  end
  put g_bw_bits 0 add bp 1
end

fn bw_put cs ulong v ulong n ulong to void
  i = n
  while gt i 0 bound 64
    i = sub i 1
    bw_bit cs and shr v i 1
  end
end

fn br_get cs ulong n ulong to ulong
  cbo = mul cs TY_MCODE_SLOT
  v = ulong 0
  for i ulong n bound 64
    pos = get g_br_pos 0
    if ge pos get g_br_nbits 0
      put g_br_err 0 1
      ret 0
    end
    by = get g_mcode add cbo shr pos 3
    sh = sub 7 and pos 7
    bit = and shr ulong by sh 1
    v = or shl v 1 bit
    put g_br_pos 0 add pos 1
  end
  ret v
end

fn ty_menc_row cs ulong mbo ulong i ulong k ulong kb ulong to void
  bw_put cs get g_md_rkey add mbo i kb
  ro = mul add mbo i 16
  for x ulong sub k 1
    bw_put cs ulong get g_md_rq add ro x TY_QBITS
  end
end

fn ty_model_encode ms ulong cs ulong to long
  k = get g_md_k ms
  if or lt k 2 gt k TY_KMAX
    ret TY_E_ARG
  end
  kb = get g_md_kb ms
  nr = get g_md_nr ms
  need = add add TY_MODEL_HEADER_BITS mul sub k 1 TY_QBITS mul nr add kb mul sub k 1 TY_QBITS
  nby = div add need 7 8
  if gt nby TY_MCODE_SLOT
    ret TY_E_IO
  end
  cbo = mul cs TY_MCODE_SLOT
  for i ulong nby bound 1048576
    put g_mcode add cbo i uchar 0
  end
  put g_bw_bits 0 0
  bw_put cs ulong 0x54594d30 32
  bw_put cs TY_MODEL_VERSION 8
  bw_put cs k 8
  bw_put cs get g_md_mask ms 8
  bw_put cs TY_QBITS 8
  bw_put cs kb 8
  bw_put cs nr 32
  dbo = mul ms 16
  for x ulong sub k 1
    bw_put cs ulong get g_md_def add dbo x TY_QBITS
  end
  mbo = mul ms TY_MAX_MROWS
  for i ulong nr bound 65536
    ty_menc_row cs mbo i k kb
  end
  put g_mclen cs nby
  put g_mcbits cs get g_bw_bits 0
  ret TY_OK
end

fn br_get_row cs ulong k ulong q edit uint * to long
  s = ulong 0
  for x ulong sub k 1
    v = br_get cs TY_QBITS
    if eq v 0
      ret TY_E_PROFILE
    end
    put q x uint v
    s = add s v
  end
  if ge s TY_QONE
    ret TY_E_PROFILE
  end
  put q sub k 1 uint sub TY_QONE s
  if ne get g_br_err 0 0
    ret TY_E_FORMAT
  end
  ret TY_OK
end

fn ty_mdec_one cs ulong ms ulong i ulong rk ulong to long
  k = get g_md_k ms
  q = new uint 16 0
  rrc = br_get_row cs k q
  if ne rrc TY_OK
    ret rrc
  end
  mbo = mul ms TY_MAX_MROWS
  put g_md_rkey add mbo i rk
  ro = mul add mbo i 16
  for x ulong k
    put g_md_rq add ro x get q x
  end
  ret TY_OK
end

fn ty_mdec_rows cs ulong ms ulong nr ulong space ulong to long
  k = get g_md_k ms
  kb = get g_md_kb ms
  q = new uint 16 0
  rc = br_get_row cs k q
  if ne rc TY_OK
    ret rc
  end
  dbo = mul ms 16
  for x ulong k
    put g_md_def add dbo x get q x
  end
  prev_k = ulong 0
  for i ulong nr bound 65536
    rk = br_get cs kb
    if ge rk space
      ret TY_E_FORMAT
    end
    if gt i 0
      if le rk prev_k
        ret TY_E_FORMAT
      end
    end
    prev_k = rk
    rrc = ty_mdec_one cs ms i rk
    if ne rrc TY_OK
      ret rrc
    end
  end
  while lt get g_br_pos 0 get g_br_nbits 0 bound 8
    if ne br_get cs 1 0
      ret TY_E_FORMAT
    end
  end
  put g_md_nr ms nr
  ret TY_OK
end

fn ty_model_decode cs ulong nby ulong ms ulong to long
  put g_br_pos 0 0
  put g_br_nbits 0 mul nby 8
  put g_br_err 0 0
  if or ne br_get cs 32 ulong 0x54594d30 ne get g_br_err 0 0
    ret TY_E_FORMAT
  end
  ver = br_get cs 8
  k = br_get cs 8
  mask = br_get cs 8
  qb = br_get cs 8
  kb = br_get cs 8
  nr = br_get cs 32
  if ne get g_br_err 0 0
    ret TY_E_FORMAT
  end
  if or ne ver TY_MODEL_VERSION ne qb TY_QBITS
    ret TY_E_PROFILE
  end
  if or ne ty_key_space mask k TY_OK ne kb get g_ty_ret_u 1
    ret TY_E_FORMAT
  end
  if gt nr TY_MAX_MROWS
    ret TY_E_IO
  end
  put g_md_k ms k
  put g_md_mask ms mask
  put g_md_kb ms kb
  put g_md_nr ms 0
  rowb = mul sub k 1 TY_QBITS
  need = add add TY_MODEL_HEADER_BITS rowb mul nr add kb rowb
  if ne div add need 7 8 nby
    ret TY_E_FORMAT
  end
  rc = ty_mdec_rows cs ms nr get g_ty_ret_u 0
  if ne rc TY_OK
    ret rc
  end
  put g_ty_ret_u 0 need
  ret TY_OK
end

fn md_find_row ms ulong key ulong to long
  nr = get g_md_nr ms
  if eq nr 0
    ret -1
  end
  bo = mul ms TY_MAX_MROWS
  lo = ulong 0
  hi = nr
  while lt lo hi bound 32
    mid = add lo shr sub hi lo 1
    if lt get g_md_rkey add bo mid key
      lo = add mid 1
    else
      hi = mid
    end
  end
  if lt lo nr
    if eq get g_md_rkey add bo lo key
      ret long lo
    end
  end
  ret -1
end

fn md_lookup_q ms ulong key ulong sym ulong to ulong
  ri = md_find_row ms key
  if ge ri 0
    mbo = mul ms TY_MAX_MROWS
    ret ulong get g_md_rq add mul add mbo ulong ri 16 sym
  end
  ret ulong get g_md_def add mul ms 16 sym
end

note Score model ms on stream sid -> ub in g_ty_ret_i[0], nsym in g_ty_ret_u[0]
fn ty_model_score ms ulong sid ulong to long
  k = get g_md_k ms
  kw_init get g_md_mask ms k
  tot = long 0
  so = get g_st_off sid
  sn = get g_st_n sid
  for t ulong sn bound 2097152
    ev = get g_ev add so t
    sym = ev_sym ev
    if ge sym k
      ret TY_E_RANGE
    end
    qv = md_lookup_q ms kw_key ev sym
    b = ty_ubits_q16 qv
    if lt b 0
      ret TY_E_ZERO_REALIZED
    end
    if ne ty_add tot b TY_OK
      ret TY_E_OVERFLOW
    end
    tot = get g_ty_ret_i 0
    kw_adv ev
  end
  put g_ty_ret_i 0 tot
  put g_ty_ret_u 0 sn
  ret TY_OK
end

fn ty_model_digest cs ulong nby ulong dslot ulong to void
  sh_init
  sh_slice t_ty_dom_model len t_ty_dom_model
  sh_byte uchar 0
  cbo = mul cs TY_MCODE_SLOT
  for i ulong nby bound 1048576
    sh_byte get g_mcode add cbo i
  end
  sh_final dslot
end

note ---- TY-1/TY-2 Profile V0, Split, Fit, Gain Records ----
note Digest slots for profile/split/fit/gain helpers:
note Caller supplies digest slots in g_dig.
fn ty_profile_v0_digest man_slot ulong floor_q ulong dslot ulong to long
  ca_reset t_ty_rec_prof
  ca_add_txt t_tk_name t_ty_v0_name
  ca_add_txt t_tk_dataset t_ty_v0_dataset
  ca_add_dig t_tk_manifest man_slot
  ca_add_txt t_tk_xt t_ty_v0_xt
  ca_add_txt t_tk_side t_ty_v0_side
  ca_add_txt t_tk_reset t_ty_v0_reset
  ca_add_u64 t_tk_ak TY_OUT_K
  ca_add_u64 t_tk_qbits TY_QBITS
  ca_add_u64 t_tk_floorq floor_q
  ca_add_txt t_tk_est t_ty_v0_est
  ca_add_txt t_tk_lmcode t_ty_v0_lm
  ca_add_u64 t_tk_frule TY_FIT_MDL_PRUNE
  ca_add_txt t_tk_brule t_ty_v0_brule
  ca_add_u64 t_tk_bmask TY_V0_BASELINE_MASK
  ca_add_txt t_tk_crule t_ty_v0_crule
  ca_add_u64 t_tk_cmask TY_V0_CANDIDATE_MASK
  ca_add_txt t_tk_prule t_ty_v0_prule
  ca_add_i64 t_tk_margin TY_V0_MARGIN_UB
  ca_add_u64 t_tk_qerr_m TY_QERR_MILLI_UB
  ca_add_txt t_tk_eden t_ty_v0_eden
  ca_add_txt t_tk_unit t_ty_v0_unit
  ret ca_finish TY_KIND_CONSTRAINT t_ty_dom_prof dslot
end

note Split labels stored in globals (12 fit + 12 held x 64 bytes)
global g_sp_flbl uchar 768
global g_sp_flen ulong 12
global g_sp_hlbl uchar 768
global g_sp_hlen ulong 12
global g_sp_fdig ulong 12
global g_sp_hdig ulong 12
global g_sp_nf ulong 1
global g_sp_nh ulong 1

text t_pre_fit "fit."
text t_pre_held "held."
text t_pre_file "file."

fn ty_split_digest dslot ulong to long
  nf = get g_sp_nf 0
  nh = get g_sp_nh 0
  if or gt nf TY_MAX_FILES gt nh TY_MAX_FILES
    ret TY_E_ARG
  end
  ca_reset t_ty_rec_split
  ca_add_u64 t_tk_nfit nf
  ca_add_u64 t_tk_nheld nh
  for i ulong nf bound 12
    tk_clr
    tk_txt t_pre_fit
    tk_2d i
    tv_clr
    tv_dig get g_sp_fdig i
    tv_b uchar 32
    lo = mul i 64
    ln = get g_sp_flen i
    for j ulong ln bound 64
      tv_b get g_sp_flbl add lo j
    end
    ca_add_kv_raw
  end
  for i ulong nh bound 12
    tk_clr
    tk_txt t_pre_held
    tk_2d i
    tv_clr
    tv_dig get g_sp_hdig i
    tv_b uchar 32
    lo = mul i 64
    ln = get g_sp_hlen i
    for j ulong ln bound 64
      tv_b get g_sp_hlbl add lo j
    end
    ca_add_kv_raw
  end
  ret ca_finish TY_KIND_EVIDENCE t_ty_dom_split dslot
end

note Fit record slots (2 slots: 0=baseline, 1=candidate)
global g_fr_prof ulong 2
global g_fr_split ulong 2
global g_fr_role ulong 2
global g_fr_mask ulong 2
global g_fr_rule ulong 2
global g_fr_nf ulong 2
global g_fr_fdig ulong 24
global g_fr_mod ulong 2
global g_fr_mbits ulong 2

fn ty_fit_digest fi ulong dslot ulong to long
  nf = get g_fr_nf fi
  if gt nf TY_MAX_FILES
    ret TY_E_ARG
  end
  ca_reset t_ty_rec_fit
  ca_add_dig t_tk_prof get g_fr_prof fi
  ca_add_dig t_tk_split get g_fr_split fi
  if eq get g_fr_role fi TY_ROLE_BASELINE
    ca_add_txt t_tk_role t_base_role
  else
    ca_add_txt t_tk_role t_cand_role
  end
  ca_add_u64 t_tk_mask get g_fr_mask fi
  ca_add_u64 t_tk_rule get g_fr_rule fi
  ca_add_u64 t_tk_nfit nf
  bo = mul fi 12
  for i ulong nf bound 12
    tk_clr
    tk_txt t_pre_fit
    tk_2d i
    tv_clr
    tv_dig get g_fr_fdig add bo i
    tv_b uchar 32
    ca_add_kv_raw
  end
  ca_add_dig t_tk_model get g_fr_mod fi
  ca_add_u64 t_tk_mbits get g_fr_mbits fi
  ret ca_finish TY_KIND_EVIDENCE t_ty_dom_fit dslot
end

note Gain record globals
global g_gr_dig ulong 6
global g_gr_u ulong 4
global g_gr_i long 8
global g_gr_fnsym ulong 12
global g_gr_ftub long 12
global g_gr_pass ulong 1

fn ty_gain_digest dslot ulong to long
  nh = get g_gr_u 3
  if gt nh TY_MAX_FILES
    ret TY_E_ARG
  end
  ca_reset t_ty_rec_gain
  ca_add_dig t_tk_prof get g_gr_dig 0
  ca_add_dig t_tk_split get g_gr_dig 1
  ca_add_dig t_tk_bfit get g_gr_dig 2
  ca_add_dig t_tk_cfit get g_gr_dig 3
  ca_add_dig t_tk_bmod get g_gr_dig 4
  ca_add_dig t_tk_cmod get g_gr_dig 5
  ca_add_u64 t_tk_nsym get g_gr_u 0
  ca_add_u64 t_tk_lmb get g_gr_u 1
  ca_add_u64 t_tk_lmc get g_gr_u 2
  ca_add_i64 t_tk_ldb get g_gr_i 0
  ca_add_i64 t_tk_ldc get g_gr_i 1
  ca_add_i64 t_tk_dlb get g_gr_i 2
  ca_add_i64 t_tk_dlc get g_gr_i 3
  ca_add_i64 t_tk_tub get g_gr_i 4
  ca_add_u64 t_tk_nheld nh
  for i ulong nh bound 12
    tk_clr
    tk_txt t_pre_file
    tk_2d i
    tv_clr
    tv_u64 get g_gr_fnsym i
    tv_b uchar 32
    tv_i64 get g_gr_ftub i
    ca_add_kv_raw
  end
  ca_add_i64 t_tk_qerrb get g_gr_i 5
  ca_add_i64 t_tk_margin get g_gr_i 6
  if ne get g_gr_pass 0 0
    ca_add_txt t_tk_verdict t_pass
  else
    ca_add_txt t_tk_verdict t_fail
  end
  ret ca_finish TY_KIND_EVIDENCE t_ty_dom_gain dslot
end

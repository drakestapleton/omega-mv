note ---- 128-bit unsigned arithmetic helpers ----
note mul64x64: a * b -> (g_ty_u128[0]=hi, g_ty_u128[1]=lo)
fn ty_mul128 a ulong b ulong to void
  m = ulong 0xffffffff
  p0 = mul and a m and b m
  p1 = mul and a m shr b 32
  p2 = mul shr a 32 and b m
  mid = add add shr p0 32 and p1 m and p2 m
  put g_ty_u128 1 or and p0 m shl and mid m 32
  hi = mul shr a 32 shr b 32
  hi = add hi shr p1 32
  hi = add hi shr p2 32
  put g_ty_u128 0 add hi shr mid 32
end

note div128by128: (nhi,nlo) / (dhi,dlo) -> quot in g_ty_u128[2..3], rem in g_ty_u128[4..5]
fn ty_div128 nhi ulong nlo ulong dhi ulong dlo ulong to void
  qhi = ulong 0
  qlo = ulong 0
  rhi = ulong 0
  rlo = ulong 0
  for i ulong 128
    bit = ulong 0
    if lt i 64
      bit = and shr nhi sub 63 i 1
    else
      bit = and shr nlo sub 127 i 1
    end
    rhi = or shl rhi 1 shr rlo 63
    rlo = or shl rlo 1 bit
    ge_d = false
    if gt rhi dhi
      ge_d = true
    else
      if eq rhi dhi
        if ge rlo dlo
          ge_d = true
        end
      end
    end
    qhi = or shl qhi 1 shr qlo 63
    qlo = shl qlo 1
    if ge_d
      bor = ulong 0
      if lt rlo dlo
        bor = 1
      end
      rlo = sub rlo dlo
      rhi = sub sub rhi dhi bor
      qlo = or qlo 1
    end
  end
  put g_ty_u128 2 qhi
  put g_ty_u128 3 qlo
  put g_ty_u128 4 rhi
  put g_ty_u128 5 rlo
end

note ---- TY-1 Math ----
fn ty_clz64 x ulong to ulong
  if eq x 0
    ret 64
  end
  n = ulong 0
  v = x
  if eq shr v 32 0
    n = add n 32
    v = shl v 32
  end
  if eq shr v 48 0
    n = add n 16
    v = shl v 16
  end
  if eq shr v 56 0
    n = add n 8
    v = shl v 8
  end
  if eq shr v 60 0
    n = add n 4
    v = shl v 4
  end
  if eq shr v 62 0
    n = add n 2
    v = shl v 2
  end
  if eq shr v 63 0
    n = add n 1
  end
  ret n
end

fn ty_log2_q32 x ulong to ulong
  if eq x 0
    ret 0
  end
  e = sub 63 ty_clz64 x
  m = ulong 0
  if le e 62
    m = shl x sub 62 e
  else
    m = shr x 1
  end
  frac = ulong 0
  two = shl ulong 1 63
  for i ulong 32
    ty_mul128 m m
    hi = get g_ty_u128 0
    lo = get g_ty_u128 1
    m = or shl hi 2 shr lo 62
    frac = shl frac 1
    if ge m two
      m = shr m 1
      frac = or frac 1
    end
  end
  ret or shl e 32 frac
end

fn ty_q32_to_ub v ulong to long
  ty_mul128 v ulong 1000000
  hi = get g_ty_u128 0
  lo = get g_ty_u128 1
  half = shl ulong 1 31
  lo2 = add lo half
  if lt lo2 lo
    hi = add hi 1
  end
  ret long or shl hi 32 shr lo2 32
end

fn ty_ub_tbl_init to void
  put g_ty_ub_tbl 0 TY_E_RANGE
  top = shl TY_QBITS 32
  q = ulong 1
  while le q TY_QONE
    v = sub top ty_log2_q32 q
    put g_ty_ub_tbl q ty_q32_to_ub v
    q = add q 1
  end
  put g_ty_ub_rdy 0 1
end

fn ty_ubits_q16 q ulong to long
  if or eq q 0 gt q TY_QONE
    ret TY_E_RANGE
  end
  if eq get g_ty_ub_rdy 0 0
    ty_ub_tbl_init
  end
  ret get g_ty_ub_tbl q
end

fn ty_ubits_ratio num ulong den ulong to long
  if eq num 0
    ret TY_E_ZERO_REALIZED
  end
  if gt num den
    ret TY_E_RANGE
  end
  v = ulong 0
  if ne num den
    v = sub ty_log2_q32 den ty_log2_q32 num
  end
  put g_ty_ret_i 0 ty_q32_to_ub v
  ret TY_OK
end

fn ty_f64_isinf x f64 to bool
  u = bitcast ulong x
  exp = and shr u 52 ulong 2047
  man = and u or shl ulong 0x000fffff 32 ulong 0xffffffff
  ret and eq exp 2047 eq man 0
end

fn ty_f64_issub x f64 to bool
  u = bitcast ulong x
  exp = and shr u 52 ulong 2047
  man = and u or shl ulong 0x000fffff 32 ulong 0xffffffff
  ret and eq exp 0 ne man 0
end

fn ty_validate_f64 p view f64 * n ulong tol f64 to long
  if or eq n 0 or ne tol tol or lt tol f64 0.0 ty_f64_isinf tol
    ret TY_E_ARG
  end
  s = f64 0.0
  for i ulong n
    v = get p i
    if ne v v
      ret TY_E_NAN
    end
    if ty_f64_isinf v
      ret TY_E_INF
    end
    u = bitcast ulong v
    if or lt v f64 0.0 ne shr u 63 0
      if eq v f64 0.0
        continue
      end
      ret TY_E_NEG
    end
    s = add s v
  end
  if ty_f64_isinf s
    ret TY_E_NORM
  end
  diff = fabs sub s f64 1.0
  if gt diff tol
    ret TY_E_NORM
  end
  ret TY_OK
end

fn ty_ubits_f64 p view f64 * n ulong realized ulong tol f64 to long
  if ge realized n
    ret TY_E_ARG
  end
  rc = ty_validate_f64 p n tol
  if ne rc TY_OK
    ret rc
  end
  v = get p realized
  if eq v f64 0.0
    ret TY_E_ZERO_REALIZED
  end
  if ty_f64_issub v
    ret TY_E_UNDERFLOW
  end
  if gt v f64 1.0
    ret TY_E_RANGE
  end
  u = bitcast ulong v
  exp = and shr u 52 ulong 2047
  if lt exp 961
    ret TY_E_UNDERFLOW
  end
  man = and u or shl ulong 0x000fffff 32 ulong 0xffffffff
  su = or shl add exp 62 52 man
  scaled = bitcast f64 su
  num = ulong scaled
  ret ty_ubits_ratio num shl ulong 1 62
end

fn ty_add a long b long to long
  im = bitcast long or shl ulong 0x7fffffff 32 ulong 0xffffffff
  inm = bitcast long shl ulong 0x80000000 32
  if gt b 0
    if gt a sub im b
      ret TY_E_OVERFLOW
    end
  end
  if lt b 0
    if lt a sub inm b
      ret TY_E_OVERFLOW
    end
  end
  put g_ty_ret_i 0 add a b
  ret TY_OK
end

fn ty_sub a long b long to long
  im = bitcast long or shl ulong 0x7fffffff 32 ulong 0xffffffff
  inm = bitcast long shl ulong 0x80000000 32
  if lt b 0
    if gt a add im b
      ret TY_E_OVERFLOW
    end
  end
  if gt b 0
    if lt a add inm b
      ret TY_E_OVERFLOW
    end
  end
  put g_ty_ret_i 0 sub a b
  ret TY_OK
end

fn ty_bits_to_ub bits ulong to long
  if gt bits ulong 9223372036854
    ret TY_E_OVERFLOW
  end
  put g_ty_ret_i 0 mul long bits TY_UB_PER_BIT
  ret TY_OK
end

fn ty_dl mbits ulong data_ub long to long
  if lt data_ub 0
    ret TY_E_RANGE
  end
  rc = ty_bits_to_ub mbits
  if ne rc TY_OK
    ret rc
  end
  ret ty_add get g_ty_ret_i 0 data_ub
end

fn ty_gain dl_b long dl_c long to long
  if or lt dl_b 0 lt dl_c 0
    ret TY_E_RANGE
  end
  ret ty_sub dl_b dl_c
end

global g_qkt_wh ulong 16
global g_qkt_wl ulong 16
global g_qkt_rh ulong 16
global g_qkt_rl ulong 16
global g_qkt_gv uchar 16

fn ty_qkt_pick k ulong to ulong
  best = long -1
  for s ulong k
    if eq get g_qkt_gv s 0
      take = false
      if lt best 0
        take = true
      else
        bu = ulong best
        if gt get g_qkt_rh s get g_qkt_rh bu
          take = true
        else
          if eq get g_qkt_rh s get g_qkt_rh bu
            if gt get g_qkt_rl s get g_qkt_rl bu
              take = true
            end
          end
        end
      end
      if take
        best = long s
      end
    end
  end
  ret ulong best
end

fn ty_qkt_weights counts view ulong * k ulong to long
  whi = ulong 0
  wlo = ulong 0
  lim = shl ulong 1 62
  for s ulong k
    c = get counts s
    if gt c lim
      ret TY_E_RANGE
    end
    lo = add shl c 1 1
    hi = shr c 63
    put g_qkt_wh s hi
    put g_qkt_wl s lo
    nlo = add wlo lo
    if lt nlo wlo
      whi = add whi 1
    end
    wlo = nlo
    whi = add whi hi
  end
  put g_ty_u128 6 whi
  put g_ty_u128 7 wlo
  ret TY_OK
end

note ty_quantize_kt: counts[0..k-1] -> q[0..k-1]
fn ty_quantize_kt counts view ulong * k ulong q edit uint * to long
  if or lt k 2 gt k TY_KMAX
    ret TY_E_ARG
  end
  if ne ty_qkt_weights counts k TY_OK
    ret TY_E_RANGE
  end
  r_val = sub TY_QONE k
  bsum = ulong 0
  for s ulong k
    ty_mul128 r_val get g_qkt_wl s
    thi = add get g_ty_u128 0 mul r_val get g_qkt_wh s
    ty_div128 thi get g_ty_u128 1 get g_ty_u128 6 get g_ty_u128 7
    b = get g_ty_u128 3
    put g_qkt_rh s get g_ty_u128 4
    put g_qkt_rl s get g_ty_u128 5
    put q s add uint 1 uint b
    put g_qkt_gv s uchar 0
    bsum = add bsum b
  end
  left = sub r_val bsum
  while gt left 0 bound 32
    bu = ty_qkt_pick k
    put g_qkt_gv bu uchar 1
    put q bu add get q bu uint 1
    left = sub left 1
  end
  ret TY_OK
end


note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/searchtrace/ (st_holdout.c,
note st_corpus.c): lowercase hex encode/decode, constant-time byte compare,
note label/name validation, task-prefix line counter, big-endian commitment
note header encoder, canonical u64/i64 decimal parsers, and record byte checks.
om2

fn st_hex_nibble v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

export fn st_om_hex_lower src view uchar * n ulong dst edit uchar * to void
  for i ulong n bound 9223372036854775807
    b = ulong get src i
    put dst mul i 2 st_hex_nibble shr b 4
    put dst add mul i 2 1 st_hex_nibble and b 15
  end
end

export fn st_om_ct_equal a view uchar * b view uchar * n ulong to ulong
  acc = ulong 0
  for i ulong n bound 9223372036854775807
    acc = or acc xor ulong get a i ulong get b i
  end
  if eq acc 0
    ret 1
  end
  ret 0
end

export fn st_om_label_ok s view uchar * n ulong lim ulong to ulong
  if or lt n 1 gt n lim
    ret 0
  end
  for i ulong n bound 9223372036854775807
    c = ulong get s i
    ok = ulong 0
    if and ge c 97 le c 122
      ok = 1
    end
    if and ge c 65 le c 90
      ok = 1
    end
    if and ge c 48 le c 57
      ok = 1
    end
    if or eq c 46 or eq c 95 eq c 45
      ok = 1
    end
    if eq ok 0
      ret 0
    end
  end
  ret 1
end

fn st_is_task_prefix t view uchar * slen ulong pos ulong to ulong
  if lt sub slen pos 5
    ret 0
  end
  if ne ulong get t pos 116
    ret 0
  end
  if ne ulong get t add pos 1 97
    ret 0
  end
  if ne ulong get t add pos 2 115
    ret 0
  end
  if ne ulong get t add pos 3 107
    ret 0
  end
  if ne ulong get t add pos 4 32
    ret 0
  end
  ret 1
end

export fn st_om_count_tasks t view uchar * slen ulong to ulong
  n = ulong 0
  i = ulong 0
  while lt i slen bound 9223372036854775807
    if eq st_is_task_prefix t slen i 1
      if lt n 4294967295
        n = add n 1
      end
    end
    while lt i slen bound 9223372036854775807
      c = ulong get t i
      i = add i 1
      if eq c 10
        break
      end
    end
  end
  ret n
end

export fn st_om_put_be64_be32 dst edit uchar 12 l ulong count ulong to void
  for i ulong 8
    put dst i uchar and shr l sub 56 mul i 8 255
  end
  for i ulong 4
    put dst add 8 i uchar and shr count sub 24 mul i 8 255
  end
end

export fn st_om_parse_hex32 v view uchar * n ulong dst edit uchar 32 to long
  if ne n 64
    ret 1
  end
  for i ulong 64
    ch = ulong get v i
    x = ulong 99
    if and ge ch 48 le ch 57
      x = sub ch 48
    else
      if and ge ch 97 le ch 102
        x = add sub ch 97 10
      else
        if and ge ch 65 le ch 70
          ret 2
        end
        ret 3
      end
    end
    idx = div i 2
    if eq and i 1 1
      prev = ulong get dst idx
      put dst idx uchar or prev x
    else
      put dst idx uchar shl x 4
    end
  end
  ret 0
end

export fn st_om_parse_dec v view uchar * n ulong max_v ulong dst edit ulong 1 to long
  if or eq n 0 gt n 20
    ret 1
  end
  if and gt n 1 eq ulong get v 0 48
    ret 1
  end
  x = ulong 0
  for i ulong n bound 9223372036854775807
    c = ulong get v i
    if or lt c 48 gt c 57
      ret 2
    end
    d = sub c 48
    if gt x div sub max_v d 10
      ret 3
    end
    x = add mul x 10 d
  end
  put dst 0 x
  ret 0
end

export fn st_om_parse_i64 s view uchar * n ulong dst edit ulong 1 to ulong
  if eq n 0
    ret 0
  end
  is_neg = ulong 0
  off = ulong 0
  if eq ulong get s 0 45
    is_neg = 1
    off = 1
  end
  rem_n = sub n off
  if or eq rem_n 0 gt rem_n 20
    ret 0
  end
  if and gt rem_n 1 eq ulong get s off 48
    ret 0
  end
  v = ulong 0
  for i ulong rem_n
    c = ulong get s add off i
    if or lt c 48 gt c 57
      ret 0
    end
    d = sub c 48
    if gt v div sub 2147483648 d 10
      ret 0
    end
    v = add mul v 10 d
  end
  if gt v 2147483648
    ret 0
  end
  if and eq is_neg 1 eq v 0
    ret 0
  end
  if eq is_neg 1
    put dst 0 sub 0 v
  else
    put dst 0 v
  end
  ret 1
end

export fn st_om_check_rec_bytes rec view uchar * slen ulong to long
  if gt slen 1024
    ret 1
  end
  for i ulong slen
    c = ulong get rec i
    if eq c 0
      ret 2
    end
  end
  for i ulong slen
    c = ulong get rec i
    if eq c 13
      ret 3
    end
  end
  ret 0
end

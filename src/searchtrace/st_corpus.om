note ---- Hook API ----

fn stc_synth_set_hook fn_id ulong ctx ulong to long
  if or eq fn_id 0 ne get stc_synth_hook_fn 0 0
    ret -1
  end
  put stc_synth_hook_fn 0 fn_id
  put stc_synth_hook_ctx 0 ctx
  ret 0
end

fn stc_synth_clear_hook ctx ulong to long
  if or eq get stc_synth_hook_fn 0 0 ne get stc_synth_hook_ctx 0 ctx
    ret -1
  end
  put stc_synth_hook_fn 0 0
  put stc_synth_hook_ctx 0 0
  ret 0
end

fn stc_real_set_hook fn_id ulong ctx ulong to long
  if or eq fn_id 0 ne get stc_real_hook_fn 0 0
    ret -1
  end
  put stc_real_hook_fn 0 fn_id
  put stc_real_hook_ctx 0 ctx
  ret 0
end

fn stc_real_clear_hook ctx ulong to long
  if or eq get stc_real_hook_fn 0 0 ne get stc_real_hook_ctx 0 ctx
    ret -1
  end
  put stc_real_hook_fn 0 0
  put stc_real_hook_ctx 0 0
  ret 0
end

note ---- Output buffer helpers ----

fn stc_out_ch c uchar to void
  p = get stc_out_len 0
  if lt p STC_OUT_CAP
    put stc_out p c
    put stc_out_len 0 add p 1
  end
end

fn stc_out_txt s view uchar * to void
  p = get stc_out_len 0
  n = len s
  if le add p n STC_OUT_CAP
    for i ulong n bound 256
      put stc_out add p i get s i
    end
    put stc_out_len 0 add p n
  end
end

fn stc_out_u64 v ulong to void
  tmp = new uchar 24 0
  k = ulong 24
  x = v
  while true bound 24
    k = sub k 1
    put tmp k uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  n = sub 24 k
  p = get stc_out_len 0
  if le add p n STC_OUT_CAP
    for i ulong n bound 24
      put stc_out add p i get tmp add k i
    end
    put stc_out_len 0 add p n
  end
end

fn stc_out_hex2 v ulong to void
  stc_out_ch sth_hex_nib and shr v 4 15
  stc_out_ch sth_hex_nib and v 15
end

fn stc_out_hex_u64 v ulong to void
  tmp = new uchar 16 0
  k = ulong 16
  x = v
  while true bound 16
    k = sub k 1
    put tmp k sth_hex_nib and x 15
    x = shr x 4
    if eq x 0
      break
    end
  end
  n = sub 16 k
  p = get stc_out_len 0
  if le add p n STC_OUT_CAP
    for i ulong n bound 16
      put stc_out add p i get tmp add k i
    end
    put stc_out_len 0 add p n
  end
end

fn stc_out_hex32 d view uchar 32 to void
  p = get stc_out_len 0
  if le add p 64 STC_OUT_CAP
    for i ulong 32
      b = ulong get d i
      put stc_out add p mul i 2 sth_hex_nib shr b 4
      put stc_out add p add mul i 2 1 sth_hex_nib and b 15
    end
    put stc_out_len 0 add p 64
  end
end

fn stc_out_prim_name idx ulong to void
  if eq idx 0
    stc_out_txt stc_p0
    ret
  end
  if eq idx 1
    stc_out_txt stc_p1
    ret
  end
  if eq idx 2
    stc_out_txt stc_p2
    ret
  end
  if eq idx 3
    stc_out_txt stc_p3
    ret
  end
  if eq idx 4
    stc_out_txt stc_p4
    ret
  end
  if eq idx 5
    stc_out_txt stc_p5
    ret
  end
  if eq idx 6
    stc_out_txt stc_p6
    ret
  end
  if eq idx 7
    stc_out_txt stc_p7
    ret
  end
  if eq idx 8
    stc_out_txt stc_p8
    ret
  end
  if eq idx 9
    stc_out_txt stc_p9
    ret
  end
  if eq idx 10
    stc_out_txt stc_p10
    ret
  end
  if eq idx 11
    stc_out_txt stc_p11
    ret
  end
  if eq idx 12
    stc_out_txt stc_p12
    ret
  end
  if eq idx 13
    stc_out_txt stc_p13
    ret
  end
  stc_out_txt stc_p14
end

fn stc_out_prune_name pr ulong to void
  if eq pr 0
    stc_out_txt stc_pn_0
    ret
  end
  if eq pr 1
    stc_out_txt stc_pn_1
    ret
  end
  if eq pr 2
    stc_out_txt stc_pn_2
    ret
  end
  if eq pr 3
    stc_out_txt stc_pn_3
    ret
  end
  stc_out_txt stc_pn_4
end

fn stc_out_verd_name vd ulong to void
  if eq vd 0
    stc_out_txt stc_vn_0
    ret
  end
  if eq vd 1
    stc_out_txt stc_vn_1
    ret
  end
  if eq vd 2
    stc_out_txt stc_vn_2
    ret
  end
  stc_out_txt stc_vn_3
end

note ---- OMG0 canonical object hashing ----

fn stc_put_u16be pos ulong v ulong to ulong
  put stc_obj pos uchar and shr v 8 255
  put stc_obj add pos 1 uchar and v 255
  ret add pos 2
end

fn stc_put_u32be pos ulong v ulong to ulong
  put stc_obj pos uchar and shr v 24 255
  put stc_obj add pos 1 uchar and shr v 16 255
  put stc_obj add pos 2 uchar and shr v 8 255
  put stc_obj add pos 3 uchar and v 255
  ret add pos 4
end

fn stc_put_u64be pos ulong v ulong to ulong
  for i ulong 8
    sh = sub 56 mul i 8
    put stc_obj add pos i uchar and shr v sh 255
  end
  ret add pos 8
end

fn stc_put_u16le pos ulong v ulong to ulong
  put stc_obj pos uchar and v 255
  put stc_obj add pos 1 uchar and shr v 8 255
  ret add pos 2
end

fn stc_put_u32le pos ulong v ulong to ulong
  put stc_obj pos uchar and v 255
  put stc_obj add pos 1 uchar and shr v 8 255
  put stc_obj add pos 2 uchar and shr v 16 255
  put stc_obj add pos 3 uchar and shr v 24 255
  ret add pos 4
end

fn stc_obj_hdr kind ulong to ulong
  put stc_obj 0 79
  put stc_obj 1 77
  put stc_obj 2 71
  put stc_obj 3 48
  put stc_obj 4 1
  put stc_obj 5 uchar kind
  ret 6
end

fn stc_obj_hash n ulong dst edit uchar 32 to void
  for i ulong n bound 512
    put sh_dat i get stc_obj i
  end
  sh_all n
  for i ulong 32
    put dst i get sh_dig i
  end
end

fn stc_build_constraint_id ckind ulong ann view uchar * alen ulong dst edit uchar 32 to void
  p = stc_obj_hdr 5
  p = stc_put_u16be p 0
  p = stc_put_u16be p 0
  p = stc_put_u16be p 1
  p = stc_put_u16be p ckind
  p = stc_put_u16be p alen
  for i ulong alen bound 128
    put stc_obj add p i get ann i
  end
  p = add p alen
  p = stc_put_u32be p 0
  stc_obj_hash p dst
end

fn stc_build_post_seq_2 a view uchar 32 b view uchar 32 dst edit uchar 32 to void
  p = stc_obj_hdr 5
  p = stc_put_u16be p 1
  kl = len stc_attr_comp
  put stc_obj p uchar kl
  p = add p 1
  for i ulong kl bound 32
    put stc_obj add p i get stc_attr_comp i
  end
  p = add p kl
  p = stc_put_u16be p 3
  for i ulong 3
    put stc_obj add p i get stc_val_seq i
  end
  p = add p 3
  p = stc_put_u16be p 0
  p = stc_put_u16be p 1
  p = stc_put_u16be p 8
  p = stc_put_u16be p 64
  for i ulong 32
    put stc_obj add p i get a i
    put stc_obj add add p 32 i get b i
  end
  p = add p 64
  p = stc_put_u32be p 0
  stc_obj_hash p dst
end

fn stc_build_apply op_idx ulong arg1 view uchar 32 arg2 view uchar 32 dst edit uchar 32 to void
  p = stc_obj_hdr 3
  p = stc_put_u16be p 0
  p = stc_put_u16be p 0
  p = stc_put_u16be p 0
  p = stc_put_u32be p 161
  for i ulong 161
    put stc_obj add p i 0
  end
  base = mul op_idx 32
  for i ulong 32
    put stc_obj add p i get stc_op_ids add base i
    put stc_obj add add p 33 i get arg1 i
    put stc_obj add add p 65 i get arg2 i
  end
  put stc_obj add p 32 2
  stc_obj_hash add p 161 dst
end

fn stc_compute_prog_id root view uchar 32 post view uchar 32 dst edit uchar 32 to void
  dl = len stc_dom_prog
  for i ulong dl bound 32
    put sh_dat i get stc_dom_prog i
  end
  put sh_dat dl 0
  p = add dl 1
  for i ulong 32
    put sh_dat add p i get root i
    put sh_dat add add p 32 i get stc_u64_tid i
    put sh_dat add add p 64 i get stc_u64_tid i
    put sh_dat add add p 96 i get stc_pre_id i
    put sh_dat add add p 128 i get post i
  end
  sh_all add p 160
  for i ulong 32
    put dst i get sh_dig i
  end
end

fn stc_init_machine_id to void
  p = ulong 0
  put stc_obj 0 79
  put stc_obj 1 77
  put stc_obj 2 71
  put stc_obj 3 48
  put stc_obj 4 7
  put stc_obj 5 1
  nl = len stc_m_name
  put stc_obj 6 uchar nl
  p = 7
  for i ulong nl bound 64
    put stc_obj add p i get stc_m_name i
  end
  p = add p nl
  p = stc_put_u32be p 4
  p = stc_put_u32be p 256
  put stc_obj p 1
  put stc_obj add p 1 6
  p = add p 2
  note 6 units: (0,4,1,4), (1,2,1,2), (2,2,3,2), (3,1,12,1), (4,2,3,2), (5,4,2,4)
  put stc_obj p 0
  put stc_obj add p 1 4
  put stc_obj add p 2 1
  put stc_obj add p 3 4
  put stc_obj add p 4 1
  put stc_obj add p 5 2
  put stc_obj add p 6 1
  put stc_obj add p 7 2
  put stc_obj add p 8 2
  put stc_obj add p 9 2
  put stc_obj add p 10 3
  put stc_obj add p 11 2
  put stc_obj add p 12 3
  put stc_obj add p 13 1
  put stc_obj add p 14 12
  put stc_obj add p 15 1
  put stc_obj add p 16 4
  put stc_obj add p 17 2
  put stc_obj add p 18 3
  put stc_obj add p 19 2
  put stc_obj add p 20 5
  put stc_obj add p 21 4
  put stc_obj add p 22 2
  put stc_obj add p 23 4
  p = add p 24
  put stc_obj p 31
  put stc_obj add p 1 64
  put stc_obj add p 2 32
  put stc_obj add p 3 128
  put stc_obj add p 4 4
  p = add p 5
  note L1I: 1, 1, 65536, 64, 4, 3
  put stc_obj p 1
  put stc_obj add p 1 1
  p = stc_put_u64be add p 2 65536
  put stc_obj p 64
  put stc_obj add p 1 4
  put stc_obj add p 2 3
  p = add p 3
  note L1D: 1, 0, 65536, 64, 8, 4
  put stc_obj p 1
  put stc_obj add p 1 0
  p = stc_put_u64be add p 2 65536
  put stc_obj p 64
  put stc_obj add p 1 8
  put stc_obj add p 2 4
  p = add p 3
  note L2: 2, 0, 1048576, 64, 8, 10
  put stc_obj p 2
  put stc_obj add p 1 0
  p = stc_put_u64be add p 2 1048576
  put stc_obj p 64
  put stc_obj add p 1 8
  put stc_obj add p 2 10
  p = add p 3
  note L3: 3, 0, 119537664, 64, 16, 35
  put stc_obj p 3
  put stc_obj add p 1 0
  p = stc_put_u64be add p 2 119537664
  put stc_obj p 64
  put stc_obj add p 1 16
  put stc_obj add p 2 35
  p = add p 3
  p = stc_put_u64be p 0x80000000
  p = stc_put_u64be p 137438953472
  put stc_obj p 1
  p = add p 1
  for i ulong 32
    put stc_obj add p i 0xa1
  end
  p = add p 32
  id = new uchar 32 0
  stc_obj_hash p id
  for i ulong 32
    put stc_mach_id i get id i
  end
end

fn stc_init_op_id op_code ulong to void
  p = stc_obj_hdr 3
  p = stc_put_u16be p 0
  p = stc_put_u16be p 0
  p = stc_put_u16be p 0
  p = stc_put_u32be p 204
  for i ulong 204
    put stc_obj add p i 0
  end
  r = stc_put_u32le p op_code
  r = stc_put_u32le add p 4 1
  put stc_obj add p 40 2
  for i ulong 32
    v = get stc_u64_tid i
    put stc_obj add add p 8 i v
    put stc_obj add add p 41 i v
    put stc_obj add add p 73 i v
    put stc_obj add add p 169 i v
  end
  id = new uchar 32 0
  stc_obj_hash add p 204 id
  base = mul op_code 32
  for i ulong 32
    put stc_op_ids add base i get id i
  end
end

fn stc_init_prim_val_prog idx ulong op ulong imm ulong lp view uchar 32 to void
  base = mul idx 32
  p = stc_obj_hdr 1
  p = stc_put_u16be p 0
  p = stc_put_u16be p 0
  p = stc_put_u16be p 0
  p = stc_put_u32be p 98
  for i ulong 98
    put stc_obj add p i 0
  end
  for i ulong 32
    put stc_obj add p i get stc_u64_tid i
  end
  r = stc_put_u16le add p 32 8
  r = stc_put_u64be add p 34 imm
  vid = new uchar 32 0
  stc_obj_hash add p 98 vid
  for i ulong 32
    put stc_p_val_id add base i get vid i
  end
  p0 = new uchar 32 0
  for i ulong 32
    put p0 i get stc_param0_id i
  end
  root = new uchar 32 0
  stc_build_apply op p0 vid root
  stc_compute_prog_id root lp vid
  for i ulong 32
    put stc_p_prog_id add base i get vid i
  end
end

fn stc_init_one_prim idx ulong op ulong imm ulong pstr view uchar * to void
  put stc_p_op idx op
  put stc_p_imm idx imm
  lp = new uchar 32 0
  stc_build_constraint_id 8 pstr len pstr lp
  base = mul idx 32
  for i ulong 32
    put stc_p_leaf_post add base i get lp i
  end
  stc_init_prim_val_prog idx op imm lp
end

fn stc_init_prims to void
  stc_init_one_prim 0 3 1 stc_post0
  stc_init_one_prim 1 3 2 stc_post1
  stc_init_one_prim 2 3 3 stc_post2
  stc_init_one_prim 3 3 5 stc_post3
  stc_init_one_prim 4 4 1 stc_post4
  stc_init_one_prim 5 4 2 stc_post5
  stc_init_one_prim 6 4 3 stc_post6
  stc_init_one_prim 7 4 5 stc_post7
  stc_init_one_prim 8 5 2 stc_post8
  stc_init_one_prim 9 5 3 stc_post9
  stc_init_one_prim 10 5 4 stc_post10
  stc_init_one_prim 11 9 255 stc_post11
  stc_init_one_prim 12 9 15 stc_post12
  stc_init_one_prim 13 10 1 stc_post13
  stc_init_one_prim 14 10 2 stc_post14
end

fn stc_init to void
  if ne get stc_inited 0 0
    ret
  end
  put stc_inited 0 1
  stc_init_machine_id
  note type_u64_id
  p = stc_obj_hdr 2
  p = stc_put_u16be p 0
  p = stc_put_u16be p 0
  p = stc_put_u16be p 0
  p = stc_put_u32be p 44
  for i ulong 44
    put stc_obj add p i 0
  end
  r = stc_put_u32le p 3
  r = stc_put_u16le add p 4 64
  id = new uchar 32 0
  stc_obj_hash add p 44 id
  for i ulong 32
    put stc_u64_tid i get id i
  end
  note param0_id
  p = stc_obj_hdr 1
  p = stc_put_u16be p 1
  kl = len stc_attr_param
  put stc_obj p uchar kl
  p = add p 1
  for i ulong kl bound 32
    put stc_obj add p i get stc_attr_param i
  end
  p = add p kl
  p = stc_put_u16be p 2
  put stc_obj p 0
  put stc_obj add p 1 0
  p = add p 2
  p = stc_put_u16be p 0
  p = stc_put_u16be p 0
  p = stc_put_u32be p 98
  for i ulong 98
    put stc_obj add p i 0
  end
  for i ulong 32
    put stc_obj add p i get stc_u64_tid i
  end
  stc_obj_hash add p 98 id
  for i ulong 32
    put stc_param0_id i get id i
  end
  note pre_id ("x >= 0")
  stc_build_constraint_id 7 stc_pre_str len stc_pre_str id
  for i ulong 32
    put stc_pre_id i get id i
  end
  note op_bin_id for ADD(3), SUB(4), MUL(5), AND(9), OR(10)
  stc_init_op_id 3
  stc_init_op_id 4
  stc_init_op_id 5
  stc_init_op_id 9
  stc_init_op_id 10
  stc_init_prims
end

fn stc_task_raw_put64 off ulong v ulong to void
  for b ulong 8
    if lt add off b 2664
      sh = mul b 8
      put stc_task_raw add off b uchar and shr v sh 255
    end
  end
end

fn stc_task_raw_pairs t ulong to void
  np = get stc_ts_npairs t
  put stc_task_raw 2432 uchar np
  pbase = mul t 16
  for i ulong np bound 16
    stc_task_raw_put64 add 2440 mul i 8 get stc_ts_in add pbase i
    stc_task_raw_put64 add 2568 mul i 8 get stc_ts_out add pbase i
  end
end

note Compute SynthesisTask.task_id (exact 2664-byte AArch64 struct prefix hash).
fn stc_compute_task_id t ulong dst edit uchar 32 to void
  for i ulong 2664 bound 3000
    put stc_task_raw i 0
  end
  nl = get stc_ts_nlens t
  nbase = mul t 64
  nb = new uchar 64 0
  for i ulong nl bound 64
    c = get stc_ts_names add nbase i
    put stc_task_raw add 32 i c
    put nb i c
  end
  put stc_task_raw 160 3
  put stc_task_raw 164 64
  put stc_task_raw 168 3
  put stc_task_raw 172 64
  post_id = new uchar 32 0
  stc_build_constraint_id 8 nb nl post_id
  for i ulong 32
    put stc_task_raw add 174 i get stc_pre_id i
    put stc_task_raw add 206 i get post_id i
  end
  for i ulong len stc_pre_str bound 16
    put stc_task_raw add 238 i get stc_pre_str i
  end
  for i ulong nl bound 60
    put stc_task_raw add 302 i get nb i
  end
  put stc_task_raw 2416 10
  put stc_task_raw 2420 4
  put stc_task_raw 2428 10
  stc_task_raw_pairs t
  for i ulong 2664 bound 3000
    put sh_dat i get stc_task_raw i
  end
  sh_all 2664
  for i ulong 32
    put dst i get sh_dig i
  end
end

note ---- Execution & program ID for 1..3 step compositions ----

fn stc_eval_step x ulong pidx ulong to ulong
  op = get stc_p_op pidx
  imm = get stc_p_imm pidx
  if eq op 3
    ret add x imm
  end
  if eq op 4
    ret sub x imm
  end
  if eq op 5
    ret mul x imm
  end
  if eq op 9
    ret and x imm
  end
  ret or x imm
end

fn stc_eval_chain x ulong d ulong p0 ulong p1 ulong p2 ulong to ulong
  v = stc_eval_step x p0
  if ge d 2
    v = stc_eval_step v p1
  end
  if ge d 3
    v = stc_eval_step v p2
  end
  ret v
end

fn stc_shdat_put64 off ulong v ulong to void
  for b ulong 8
    sh = mul b 8
    put sh_dat add off b uchar and shr v sh 255
  end
end

fn stc_compute_sig d ulong p0 ulong p1 ulong p2 ulong dst edit uchar 32 to void
  probes = new ulong 6 0
  put probes 0 0
  put probes 1 1
  put probes 2 3
  put probes 3 7
  put probes 4 13
  put probes 5 42
  for i ulong 6
    y = stc_eval_chain get probes i d p0 p1 p2
    stc_shdat_put64 mul i 8 y
  end
  sh_all 48
  for i ulong 32
    put dst i get sh_dig i
  end
end

fn stc_prog_id_chain d ulong p0 ulong p1 ulong p2 ulong dst edit uchar 32 to void
  if eq d 1
    base = mul p0 32
    for i ulong 32
      put dst i get stc_p_prog_id add base i
    end
    ret
  end
  cur = new uchar 32 0
  vid = new uchar 32 0
  nxt = new uchar 32 0
  for i ulong 32
    put cur i get stc_param0_id i
    put vid i get stc_p_val_id add mul p0 32 i
  end
  stc_build_apply get stc_p_op p0 cur vid nxt
  for i ulong 32
    put cur i get nxt i
    put vid i get stc_p_val_id add mul p1 32 i
  end
  stc_build_apply get stc_p_op p1 cur vid nxt
  if eq d 3
    for i ulong 32
      put cur i get nxt i
      put vid i get stc_p_val_id add mul p2 32 i
    end
    stc_build_apply get stc_p_op p2 cur vid nxt
  end
  note postcondition right-fold: reuse cur, vid; nxt holds body_root
  post = new uchar 32 0
  if eq d 2
    for i ulong 32
      put cur i get stc_p_leaf_post add mul p0 32 i
      put vid i get stc_p_leaf_post add mul p1 32 i
    end
    stc_build_post_seq_2 cur vid post
  else
    for i ulong 32
      put cur i get stc_p_leaf_post add mul p1 32 i
      put vid i get stc_p_leaf_post add mul p2 32 i
    end
    stc_build_post_seq_2 cur vid post
    for i ulong 32
      put cur i get stc_p_leaf_post add mul p0 32 i
      put vid i get post i
    end
    stc_build_post_seq_2 cur vid post
  end
  stc_compute_prog_id nxt post dst
end

note ---- Equivalence table ----

fn stc_equiv_contains_or_add sig view uchar 32 cost ulong to bool
  cnt = get stc_eq_cnt 0
  for i ulong cnt bound 1024
    base = mul i 32
    same = ulong 1
    for j ulong 32
      if ne get stc_eq_hash add base j get sig j
        same = 0
        break
      end
    end
    if eq same 1
      if le get stc_eq_cost i cost
        ret true
      else
        put stc_eq_cost i cost
        ret false
      end
    end
  end
  if lt cnt STC_MAX_SIGS
    base = mul cnt 32
    for j ulong 32
      put stc_eq_hash add base j get sig j
    end
    put stc_eq_cost cnt cost
    put stc_eq_cnt 0 add cnt 1
  end
  ret false
end

note ---- Task-set parser ----

fn stc_name_ok buf view uchar * off ulong n ulong to bool
  if or eq n 0 gt n 60
    ret false
  end
  for i ulong n bound 64
    c = ulong get buf add off i
    ok = ulong 0
    if and ge c 97 le c 122
      ok = 1
    end
    if and ge c 65 le c 90
      ok = 1
    end
    if and ge c 48 le c 57
      ok = 1
    end
    if or eq c 46 or eq c 95 eq c 45
      ok = 1
    end
    if eq ok 0
      ret false
    end
  end
  ret true
end

fn stc_parse_u64 buf view uchar * off ulong n ulong dst edit ulong 1 to bool
  if or eq n 0 gt n 20
    ret false
  end
  if gt n 1
    if eq ulong get buf off 48
      ret false
    end
  end
  x = ulong 0
  for i ulong n bound 24
    c = ulong get buf add off i
    if or lt c 48 gt c 57
      ret false
    end
    d = sub c 48
    if gt x div sub 18446744073709551615 d 10
      ret false
    end
    x = add mul x 10 d
  end
  put dst 0 x
  ret true
end

fn stc_parse_i64 buf view uchar * off ulong n ulong to bool
  if eq n 0
    ret false
  end
  is_neg = ulong 0
  cur = off
  remn = n
  if eq ulong get buf cur 45
    is_neg = 1
    cur = add cur 1
    remn = sub remn 1
  end
  if or eq remn 0 gt remn 20
    ret false
  end
  if gt remn 1
    if eq ulong get buf cur 48
      ret false
    end
  end
  v = ulong 0
  for i ulong remn bound 24
    c = ulong get buf add cur i
    if or lt c 48 gt c 57
      ret false
    end
    d = sub c 48
    if gt v div sub 2147483648 d 10
      ret false
    end
    v = add mul v 10 d
  end
  if gt v 2147483648
    ret false
  end
  if and eq is_neg 1 eq v 0
    ret false
  end
  ret true
end

fn stc_expect_kv buf view uchar * lend ulong key view uchar * to bool
  p = get stc_pos 0
  kl = len key
  if lt sub lend p add kl 1
    ret false
  end
  for i ulong kl bound 32
    if ne get buf add p i get key i
      ret false
    end
  end
  if ne ulong get buf add p kl 61
    ret false
  end
  p = add p add kl 1
  q = p
  while lt q lend bound 4096
    if eq ulong get buf q 32
      break
    end
    q = add q 1
  end
  put stc_kv_off 0 p
  put stc_kv_len 0 sub q p
  if lt q lend
    q = add q 1
  end
  put stc_pos 0 q
  ret true
end

fn stc_find_ch buf view uchar * a ulong lim ulong ch ulong to ulong
  for i ulong sub lim a bound 1024
    if eq ulong get buf add a i ch
      ret add a i
    end
  end
  ret lim
end

fn stc_parse_pairs buf view uchar * voff ulong vlen ulong t ulong to bool
  a = voff
  ve = add voff vlen
  np = ulong 0
  u = new ulong 1 0
  pbase = mul t 16
  while lt a ve bound 32
    cpos = stc_find_ch buf a ve 44
    col = stc_find_ch buf a cpos 58
    if or eq col cpos ge np STC_MAX_PAIRS
      ret false
    end
    if not stc_parse_u64 buf a sub col a u
      ret false
    end
    put stc_ts_in add pbase np get u 0
    if not stc_parse_u64 buf add col 1 sub sub cpos col 1 u
      ret false
    end
    put stc_ts_out add pbase np get u 0
    np = add np 1
    if lt cpos ve
      if eq add cpos 1 ve
        ret false
      end
      a = add cpos 1
    else
      a = ve
    end
  end
  if eq np 0
    ret false
  end
  put stc_ts_npairs t np
  ret true
end

fn stc_name_eq_k k ulong buf view uchar * q ulong nl ulong to bool
  if ne get stc_ts_nlens k nl
    ret false
  end
  kb = mul k 64
  for j ulong nl bound 64
    if ne get stc_ts_names add kb j get buf add q j
      ret false
    end
  end
  ret true
end

fn stc_dup_name buf view uchar * q ulong nl ulong nt ulong to bool
  for k ulong nt bound 64
    if stc_name_eq_k k buf q nl
      ret true
    end
  end
  ret false
end

fn stc_kv_u64 buf view uchar * lend ulong key view uchar * to long
  if not stc_expect_kv buf lend key
    ret -1
  end
  u = new ulong 1 0
  if not stc_parse_u64 buf get stc_kv_off 0 get stc_kv_len 0 u
    ret -1
  end
  put stc_kv_off 0 get u 0
  ret 0
end

fn stc_parse_task_fields buf view uchar * lend ulong nt ulong to long
  if ne stc_kv_u64 buf lend stc_k_depth 0
    ret -1
  end
  v = get stc_kv_off 0
  if or lt v 1 gt v 3
    ret -1
  end
  put stc_ts_depth nt v
  if ne stc_kv_u64 buf lend stc_k_mcost 0
    ret -1
  end
  v = get stc_kv_off 0
  if or lt v 1 gt v 64
    ret -1
  end
  put stc_ts_mcost nt v
  if ne stc_kv_u64 buf lend stc_k_mcand 0
    ret -1
  end
  v = get stc_kv_off 0
  if or lt v 1 gt v 100000
    ret -1
  end
  put stc_ts_mcand nt v
  if ne stc_kv_u64 buf lend stc_k_dedup 0
    ret -1
  end
  v = get stc_kv_off 0
  if gt v 1
    ret -1
  end
  put stc_ts_dedup nt v
  if not stc_expect_kv buf lend stc_k_pairs
    ret -1
  end
  if ne get stc_pos 0 lend
    ret -1
  end
  if not stc_parse_pairs buf get stc_kv_off 0 get stc_kv_len 0 nt
    ret -1
  end
  put stc_ts_n 0 add nt 1
  ret 0
end

fn stc_parse_task_line buf view uchar * p ulong lend ulong to long
  nt = get stc_ts_n 0
  if ge nt STC_MAX_TASKS
    ret -1
  end
  q = add p 5
  nend = q
  while lt nend lend bound 256
    if eq ulong get buf nend 32
      break
    end
    nend = add nend 1
  end
  nl = sub nend q
  if or not stc_name_ok buf q nl ge nend lend
    ret -1
  end
  if stc_dup_name buf q nl nt
    ret -1
  end
  nb = mul nt 64
  for j ulong nl bound 64
    put stc_ts_names add nb j get buf add q j
  end
  put stc_ts_nlens nt nl
  put stc_pos 0 add nend 1
  ret stc_parse_task_fields buf lend nt
end

fn stc_taskset_parse buf view uchar * blen ulong to long
  put stc_ts_n 0 0
  if eq blen 0
    ret -1
  end
  if ne ulong get buf sub blen 1 10
    ret -1
  end
  for i ulong blen bound 65536
    b = ulong get buf i
    if or eq b 0 eq b 13
      ret -1
    end
  end
  p = ulong 0
  lineno = ulong 0
  got_end = ulong 0
  while lt p blen bound 1024
    nl = p
    while lt nl blen bound 4096
      if eq ulong get buf nl 10
        break
      end
      nl = add nl 1
    end
    lineno = add lineno 1
    if ne got_end 0
      ret -1
    end
    ln = sub nl p
    if gt ln 0
      if eq ulong get buf sub nl 1 32
        ret -1
      end
    end
    if eq lineno 1
      if not sth_slice_eq buf p ln stc_t_ts_magic
        ret -1
      end
    else
      if and gt ln 0 eq ulong get buf p 35
        note comment line
      else
        if sth_slice_eq buf p ln stc_t_end
          got_end = 1
        else
          if and gt ln 5 sth_slice_eq buf p 5 stc_t_tasksp
            if ne stc_parse_task_line buf p nl 0
              ret -1
            end
          else
            ret -1
          end
        end
      end
    end
    p = add nl 1
  end
  if or eq got_end 0 eq get stc_ts_n 0 0
    ret -1
  end
  for i ulong blen bound 65536
    put sh_dat i get buf i
  end
  sh_all blen
  for i ulong 32
    put stc_ts_dig i get sh_dig i
  end
  ret 0
end

note ---- Corpus generator (synthesis + recorder) ----

fn stc_emit_body d ulong p0 ulong p1 ulong p2 ulong to void
  stc_out_hex2 get stc_p_op p0
  stc_out_ch 58
  stc_out_hex_u64 get stc_p_imm p0
  if ge d 2
    stc_out_ch 47
    stc_out_hex2 get stc_p_op p1
    stc_out_ch 58
    stc_out_hex_u64 get stc_p_imm p1
  end
  if ge d 3
    stc_out_ch 47
    stc_out_hex2 get stc_p_op p2
    stc_out_ch 58
    stc_out_hex_u64 get stc_p_imm p2
  end
end

fn stc_count_muls d ulong p0 ulong p1 ulong p2 ulong to ulong
  m = ulong 0
  if eq get stc_p_op p0 5
    m = add m 1
  end
  if ge d 2
    if eq get stc_p_op p1 5
      m = add m 1
    end
  end
  if ge d 3
    if eq get stc_p_op p2 5
      m = add m 1
    end
  end
  ret m
end

fn stc_emit_step_prefix d ulong par_seq ulong prim ulong to void
  stc_out_txt stc_t_stepsp
  stc_out_u64 get stc_cur_t 0
  stc_out_ch 32
  stc_out_u64 get stc_seq 0
  stc_out_txt stc_f_d
  stc_out_u64 d
  stc_out_txt stc_f_par
  if eq d 1
    stc_out_ch 45
  else
    stc_out_u64 par_seq
  end
  stc_out_txt stc_f_pr
  stc_out_u64 prim
  stc_out_txt stc_f_pn
  stc_out_prim_name prim
  stc_out_txt stc_f_xf
  stc_out_hex2 get stc_p_op prim
  stc_out_ch 58
  stc_out_hex_u64 get stc_p_imm prim
  stc_out_txt stc_f_ch
end

fn stc_emit_step_tail has_sig ulong sig view uchar 32 pr ulong vd ulong to void
  if ne has_sig 0
    stc_out_txt stc_f_sg
    stc_out_hex32 sig
  else
    stc_out_txt stc_f_nosg
  end
  stc_out_txt stc_f_pru
  stc_out_prune_name pr
  stc_out_txt stc_f_vd
  stc_out_verd_name vd
  stc_out_txt stc_f_erc
end

fn stc_emit_realize d ulong p0 ulong p1 ulong p2 ulong to void
  insn = add mul d 2 1
  rbytes = mul insn 4
  rcy = add insn mul 2 stc_count_muls d p0 p1 p2
  stc_out_txt stc_f_rrc
  stc_out_u64 rbytes
  stc_out_txt stc_f_rcy
  stc_out_u64 rcy
  stc_out_txt stc_f_rck
end

fn stc_eval_task t ulong d ulong p0 ulong p1 ulong p2 ulong to bool
  np = get stc_ts_npairs t
  pbase = mul t 16
  for i ulong np bound 16
    x = get stc_ts_in add pbase i
    want = get stc_ts_out add pbase i
    if ne stc_eval_chain x d p0 p1 p2 want
      ret false
    end
  end
  ret true
end

global stc_cand_pid uchar 32
global stc_cand_sig uchar 32
global stc_cand_hsig ulong 1

fn stc_emit_cand_full d ulong par_seq ulong p0 ulong p1 ulong p2 ulong to void
  prim = p0
  if eq d 2
    prim = p1
  end
  if eq d 3
    prim = p2
  end
  stc_emit_step_prefix d par_seq prim
  pid = new uchar 32 0
  for i ulong 32
    put pid i get stc_cand_pid i
  end
  stc_out_hex32 pid
  stc_out_txt stc_f_ns
  stc_out_u64 d
  stc_out_txt stc_f_in
  stc_out_u64 add mul d 2 1
  stc_out_txt stc_f_bd
  stc_emit_body d p0 p1 p2
end

fn stc_emit_cand_end pr ulong vd ulong to void
  sig = new uchar 32 0
  for i ulong 32
    put sig i get stc_cand_sig i
  end
  stc_emit_step_tail get stc_cand_hsig 0 sig pr vd
end

fn stc_eval_cand d ulong par_seq ulong p0 ulong p1 ulong p2 ulong to ulong
  t = get stc_cur_t 0
  insn = add mul d 2 1
  pid = new uchar 32 0
  sig = new uchar 32 0
  stc_prog_id_chain d p0 p1 p2 pid
  for i ulong 32
    put stc_cand_pid i get pid i
  end
  put stc_cand_hsig 0 0
  if gt d 1
    if or gt insn 10 gt insn get stc_ts_mcost t
      if eq get stc_rec_mode 0 1
        stc_emit_cand_full d par_seq p0 p1 p2
        stc_emit_cand_end STC_PRUNE_COST STC_VERD_NONE
        stc_out_txt stc_f_nor
      end
      if eq get stc_rec_mode 0 2
        put stc_hook_events 0 add get stc_hook_events 0 1
      end
      put stc_seq 0 add get stc_seq 0 1
      ret 0
    end
  end
  if ne get stc_ts_dedup t 0
    stc_compute_sig d p0 p1 p2 sig
    put stc_cand_hsig 0 1
    for i ulong 32
      put stc_cand_sig i get sig i
    end
    if stc_equiv_contains_or_add sig insn
      put stc_st_peq 0 add get stc_st_peq 0 1
      if eq get stc_rec_mode 0 1
        stc_emit_cand_full d par_seq p0 p1 p2
        stc_emit_cand_end STC_PRUNE_EQUIV STC_VERD_NONE
        stc_out_txt stc_f_nor
      end
      if eq get stc_rec_mode 0 2
        put stc_hook_events 0 add get stc_hook_events 0 1
      end
      put stc_seq 0 add get stc_seq 0 1
      ret 0
    end
  end
  if stc_eval_task t d p0 p1 p2
    if eq get stc_rec_mode 0 1
      stc_emit_cand_full d par_seq p0 p1 p2
      stc_emit_cand_end STC_PRUNE_NONE STC_VERD_SOLVED
      stc_emit_realize d p0 p1 p2
    end
    if eq get stc_rec_mode 0 2
      put stc_hook_events 0 add get stc_hook_events 0 1
    end
    put stc_seq 0 add get stc_seq 0 1
    put stc_solved 0 1
    put stc_st_sols 0 add get stc_st_sols 0 1
    for i ulong 32
      put stc_sol_id i get pid i
    end
    ret 2
  end
  put stc_st_fail 0 add get stc_st_fail 0 1
  if eq get stc_rec_mode 0 1
    stc_emit_cand_full d par_seq p0 p1 p2
    stc_emit_cand_end STC_PRUNE_NONE STC_VERD_REJECT
    stc_emit_realize d p0 p1 p2
  end
  if eq get stc_rec_mode 0 2
    put stc_hook_events 0 add get stc_hook_events 0 1
  end
  put stc_seq 0 add get stc_seq 0 1
  ret 1
end

fn stc_emit_budget d ulong par_seq ulong prim ulong to void
  sig = new uchar 32 0
  if eq get stc_rec_mode 0 1
    stc_emit_step_prefix d par_seq prim
    stc_out_txt stc_f_nochild
    stc_emit_step_tail 0 sig STC_PRUNE_BUDGET STC_VERD_NONE
    stc_out_txt stc_f_nor
  end
  if eq get stc_rec_mode 0 2
    put stc_hook_events 0 add get stc_hook_events 0 1
  end
  put stc_seq 0 add get stc_seq 0 1
end

fn stc_synth_task t ulong to void
  put stc_cur_t 0 t
  put stc_seq 0 0
  put stc_eq_cnt 0 0
  put stc_d1_cnt 0 0
  put stc_d2_cnt 0 0
  put stc_st_gen 0 0
  put stc_st_peq 0 0
  put stc_st_fail 0 0
  put stc_st_sols 0 0
  put stc_solved 0 0
  for i ulong 32
    put stc_sol_id i 0
  end
  maxd = get stc_ts_depth t
  mcand = get stc_ts_mcand t
  note Depth 1
  for i ulong STC_MAX_PRIMS
    put stc_st_gen 0 add get stc_st_gen 0 1
    seq_now = get stc_seq 0
    rc = stc_eval_cand 1 0 i 0 0
    if eq rc 2
      ret
    end
    if eq rc 1
      c1 = get stc_d1_cnt 0
      put stc_d1_p0 c1 i
      put stc_d1_seq c1 seq_now
      put stc_d1_cnt 0 add c1 1
    end
  end
  if lt maxd 2
    ret
  end
  note Depth 2
  n1 = get stc_d1_cnt 0
  for i ulong n1 bound 32
    p0 = get stc_d1_p0 i
    s0 = get stc_d1_seq i
    for j ulong STC_MAX_PRIMS
      if ge get stc_st_gen 0 mcand
        stc_emit_budget 2 s0 j
        ret
      end
      put stc_st_gen 0 add get stc_st_gen 0 1
      seq_now = get stc_seq 0
      rc = stc_eval_cand 2 s0 p0 j 0
      if eq rc 2
        ret
      end
      if eq rc 1
        c2 = get stc_d2_cnt 0
        if lt c2 STC_MAX_CANDS
          put stc_d2_p0 c2 p0
          put stc_d2_p1 c2 j
          put stc_d2_seq c2 seq_now
          put stc_d2_cnt 0 add c2 1
        end
      end
    end
  end
  if lt maxd 3
    ret
  end
  note Depth 3
  n2 = get stc_d2_cnt 0
  for i ulong n2 bound 512
    p0 = get stc_d2_p0 i
    p1 = get stc_d2_p1 i
    s1 = get stc_d2_seq i
    for j ulong STC_MAX_PRIMS
      if ge get stc_st_gen 0 mcand
        stc_emit_budget 3 s1 j
        ret
      end
      put stc_st_gen 0 add get stc_st_gen 0 1
      rc = stc_eval_cand 3 s1 p0 p1 j
      if eq rc 2
        ret
      end
    end
  end
end

fn stc_emit_task_hdr t ulong to void
  tid = new uchar 32 0
  stc_compute_task_id t tid
  stc_out_txt stc_t_tasksp
  stc_out_u64 t
  stc_out_txt stc_f_name
  nl = get stc_ts_nlens t
  nb = mul t 64
  for i ulong nl bound 64
    stc_out_ch get stc_ts_names add nb i
  end
  stc_out_txt stc_f_tid
  stc_out_hex32 tid
  stc_out_txt stc_f_dep
  stc_out_u64 get stc_ts_depth t
  stc_out_txt stc_f_mc
  stc_out_u64 get stc_ts_mcost t
  stc_out_txt stc_f_mk
  stc_out_u64 get stc_ts_mcand t
  stc_out_txt stc_f_dd
  stc_out_u64 get stc_ts_dedup t
  stc_out_txt stc_f_ex
  stc_out_u64 get stc_ts_npairs t
  stc_out_ch 10
end

fn stc_emit_task_res t ulong to void
  sid = new uchar 32 0
  stc_out_txt stc_t_ressp
  stc_out_u64 t
  stc_out_txt stc_f_sol1
  stc_out_u64 get stc_solved 0
  stc_out_txt stc_f_sol2
  if ne get stc_solved 0 0
    for i ulong 32
      put sid i get stc_sol_id i
    end
    stc_out_hex32 sid
  else
    stc_out_ch 45
  end
  stc_out_txt stc_f_gen
  stc_out_u64 get stc_st_gen 0
  stc_out_txt stc_f_pt
  stc_out_u64 get stc_st_peq 0
  stc_out_txt stc_f_fl
  stc_out_u64 get stc_st_fail 0
  stc_out_txt stc_f_sf
  stc_out_u64 get stc_st_sols 0
  stc_out_txt stc_f_st
  stc_out_u64 get stc_seq 0
  stc_out_ch 10
end

fn stc_corpus_generate to long
  stc_init
  if ne stc_synth_set_hook 2 9001 0
    ret -1
  end
  if ne stc_real_set_hook 2 9001 0
    r = stc_synth_clear_hook 9001
    ret -1
  end
  put stc_out_len 0 0
  put stc_tot_steps 0 0
  put stc_rec_mode 0 1
  stc_out_txt stc_t_c_magic
  stc_out_ch 10
  stc_out_txt stc_t_tssp
  d = new uchar 32 0
  for i ulong 32
    put d i get stc_ts_dig i
  end
  stc_out_hex32 d
  stc_out_ch 10
  stc_out_txt stc_t_machsp
  for i ulong 32
    put d i get stc_mach_id i
  end
  stc_out_hex32 d
  stc_out_txt stc_f_bank
  nt = get stc_ts_n 0
  for t ulong nt bound 64
    stc_emit_task_hdr t
    stc_synth_task t
    stc_emit_task_res t
    put stc_tot_steps 0 add get stc_tot_steps 0 get stc_seq 0
  end
  put stc_rec_mode 0 0
  r1 = stc_synth_clear_hook 9001
  r2 = stc_real_clear_hook 9001
  ol = get stc_out_len 0
  for i ulong ol bound 2097152
    put sh_dat i get stc_out i
  end
  sh_all ol
  for i ulong 32
    put d i get sh_dig i
  end
  stc_out_txt stc_f_et
  stc_out_u64 nt
  stc_out_txt stc_f_es
  stc_out_u64 get stc_tot_steps 0
  stc_out_txt stc_f_ed
  stc_out_hex32 d
  stc_out_ch 10
  ret 0
end

note ---- Strict corpus verifier ----

fn stc_hex_ok buf view uchar * off ulong n ulong want ulong to bool
  if ne n want
    ret false
  end
  for i ulong n bound 64
    c = ulong get buf add off i
    ok = ulong 0
    if and ge c 48 le c 57
      ok = 1
    end
    if and ge c 97 le c 102
      ok = 1
    end
    if eq ok 0
      ret false
    end
  end
  ret true
end

fn stc_is_dash buf view uchar * off ulong n ulong to bool
  if ne n 1
    ret false
  end
  ret eq ulong get buf off 45
end

fn stc_opimm_ok buf view uchar * off ulong n ulong to bool
  if lt n 4
    ret false
  end
  if not stc_hex_ok buf off 2 2
    ret false
  end
  if ne ulong get buf add off 2 58
    ret false
  end
  m = sub n 3
  if gt m 16
    ret false
  end
  if gt m 1
    if eq ulong get buf add off 3 48
      ret false
    end
  end
  ret stc_hex_ok buf add off 3 m m
end

fn stc_body_ok buf view uchar * off ulong n ulong want_steps ulong to bool
  a = off
  e = add off n
  cnt = ulong 0
  while lt a e bound 65
    sp = e
    has_s = ulong 0
    for i ulong sub e a bound 256
      if eq ulong get buf add a i 47
        sp = add a i
        has_s = 1
        break
      end
    end
    if not stc_opimm_ok buf a sub sp a
      ret false
    end
    cnt = add cnt 1
    if eq has_s 1
      if eq add sp 1 e
        ret false
      end
      a = add sp 1
    else
      a = e
    end
  end
  ret and gt cnt 0 eq cnt want_steps
end

fn stc_parse_prune buf view uchar * off ulong n ulong to long
  if sth_slice_eq buf off n stc_pn_0
    ret 0
  end
  if sth_slice_eq buf off n stc_pn_1
    ret 1
  end
  if sth_slice_eq buf off n stc_pn_2
    ret 2
  end
  if sth_slice_eq buf off n stc_pn_3
    ret 3
  end
  if sth_slice_eq buf off n stc_pn_4
    ret 4
  end
  ret -1
end

fn stc_parse_verd buf view uchar * off ulong n ulong to long
  if sth_slice_eq buf off n stc_vn_0
    ret 0
  end
  if sth_slice_eq buf off n stc_vn_1
    ret 1
  end
  if sth_slice_eq buf off n stc_vn_2
    ret 2
  end
  if sth_slice_eq buf off n stc_vn_3
    ret 3
  end
  ret -1
end

fn stc_v_find_sp buf view uchar * q ulong lend ulong to ulong
  r = q
  while lt r lend bound 4096
    if eq ulong get buf r 32
      ret r
    end
    r = add r 1
  end
  ret lend
end

fn stc_v_tok_u64 buf view uchar * lend ulong want ulong to bool
  p = get stc_pos 0
  nend = stc_v_find_sp buf p lend
  if ge nend lend
    ret false
  end
  u = new ulong 1 0
  if not stc_parse_u64 buf p sub nend p u
    ret false
  end
  if ne get u 0 want
    ret false
  end
  put stc_pos 0 add nend 1
  ret true
end

fn stc_v_task_line buf view uchar * p ulong lend ulong n_tasks ulong check_ts ulong to long
  put stc_pos 0 add p 5
  if not stc_v_tok_u64 buf lend n_tasks
    ret -1
  end
  if not stc_expect_kv buf lend stc_k_name
    ret -1
  end
  if not stc_name_ok buf get stc_kv_off 0 get stc_kv_len 0
    ret -1
  end
  if ne check_ts 0
    if or ge n_tasks get stc_ts_n 0 not stc_name_eq_k n_tasks buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
  end
  if not stc_expect_kv buf lend stc_k_tid
    ret -1
  end
  if not stc_hex_ok buf get stc_kv_off 0 get stc_kv_len 0 64
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_depth 0
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_mcost 0
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_mcand 0
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_dedup 0
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_ex 0
    ret -1
  end
  if ne get stc_pos 0 lend
    ret -1
  end
  ret 0
end

fn stc_v_result_line buf view uchar * p ulong lend ulong cur_t ulong seq ulong to long
  put stc_pos 0 add p 7
  if not stc_v_tok_u64 buf lend cur_t
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_solved 0
    ret -1
  end
  sol = get stc_kv_off 0
  if gt sol 1
    ret -1
  end
  if not stc_expect_kv buf lend stc_k_sol
    ret -1
  end
  if eq sol 1
    if not stc_hex_ok buf get stc_kv_off 0 get stc_kv_len 0 64
      ret -1
    end
  else
    if not stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
  end
  if ne stc_kv_u64 buf lend stc_k_gen 0
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_pt 0
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_pe 0
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_fail 0
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_sols 0
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_steps 0
    ret -1
  end
  if or ne get stc_kv_off 0 seq ne get stc_pos 0 lend
    ret -1
  end
  ret 0
end

fn stc_v_step_real buf view uchar * lend ulong realized ulong to long
  u = new ulong 1 0
  if not stc_expect_kv buf lend stc_k_rrc
    ret -1
  end
  if ne realized 0
    if not stc_parse_i64 buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
  else
    if not stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
  end
  if not stc_expect_kv buf lend stc_k_rbytes
    ret -1
  end
  if ne realized 0
    if not stc_parse_u64 buf get stc_kv_off 0 get stc_kv_len 0 u
      ret -1
    end
  else
    if not stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
  end
  if not stc_expect_kv buf lend stc_k_rcycles
    ret -1
  end
  if ne realized 0
    if not stc_parse_u64 buf get stc_kv_off 0 get stc_kv_len 0 u
      ret -1
    end
  else
    if not stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
  end
  if not stc_expect_kv buf lend stc_k_rchk
    ret -1
  end
  if ne realized 0
    if not stc_parse_u64 buf get stc_kv_off 0 get stc_kv_len 0 u
      ret -1
    end
  else
    if not stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
  end
  if ne get stc_pos 0 lend
    ret -1
  end
  ret 0
end

fn stc_v_step_tail buf view uchar * lend ulong dep ulong has_ch ulong to long
  if not stc_expect_kv buf lend stc_k_sig
    ret -1
  end
  has_sig = ulong 1
  if stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
    has_sig = 0
  else
    if not stc_hex_ok buf get stc_kv_off 0 get stc_kv_len 0 64
      ret -1
    end
  end
  if not stc_expect_kv buf lend stc_k_prune
    ret -1
  end
  pr = stc_parse_prune buf get stc_kv_off 0 get stc_kv_len 0
  if not stc_expect_kv buf lend stc_k_verd
    ret -1
  end
  vd = stc_parse_verd buf get stc_kv_off 0 get stc_kv_len 0
  if or lt pr 0 lt vd 0
    ret -1
  end
  if ne eq pr 0 ne vd 0
    ret -1
  end
  no_ch = or eq pr 1 eq pr 4
  if eq no_ch eq has_ch 1
    ret -1
  end
  if and eq pr 3 eq has_sig 0
    ret -1
  end
  if eq dep 1
    if or eq pr 1 or eq pr 2 eq pr 4
      ret -1
    end
  end
  if or not stc_expect_kv buf lend stc_k_erc not stc_parse_i64 buf get stc_kv_off 0 get stc_kv_len 0
    ret -1
  end
  if or not stc_expect_kv buf lend stc_k_vrc not stc_parse_i64 buf get stc_kv_off 0 get stc_kv_len 0
    ret -1
  end
  rlz = ulong 0
  if eq pr 0
    rlz = 1
  end
  if ne stc_v_step_real buf lend rlz 0
    ret -1
  end
  ret pr
end

fn stc_v_step_line buf view uchar * p ulong lend ulong cur_t ulong seq ulong to long
  put stc_pos 0 add p 5
  if not stc_v_tok_u64 buf lend cur_t
    ret -1
  end
  if not stc_v_tok_u64 buf lend seq
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_d 0
    ret -1
  end
  dep = get stc_kv_off 0
  if or lt dep 1 gt dep 3
    ret -1
  end
  if eq dep 1
    if not stc_expect_kv buf lend stc_k_parent
      ret -1
    end
    if not stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
  else
    if ne stc_kv_u64 buf lend stc_k_parent 0
      ret -1
    end
    if ge get stc_kv_off 0 seq
      ret -1
    end
  end
  if ne stc_kv_u64 buf lend stc_k_prim 0
    ret -1
  end
  if ge get stc_kv_off 0 32
    ret -1
  end
  if not stc_expect_kv buf lend stc_k_pname
    ret -1
  end
  if and not stc_name_ok buf get stc_kv_off 0 get stc_kv_len 0 not stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
    ret -1
  end
  if or not stc_expect_kv buf lend stc_k_xform not stc_opimm_ok buf get stc_kv_off 0 get stc_kv_len 0
    ret -1
  end
  if not stc_expect_kv buf lend stc_k_child
    ret -1
  end
  has_ch = ulong 1
  if stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
    has_ch = 0
  else
    if not stc_hex_ok buf get stc_kv_off 0 get stc_kv_len 0 64
      ret -1
    end
  end
  nsteps = ulong 0
  if eq has_ch 1
    if ne stc_kv_u64 buf lend stc_k_nsteps 0
      ret -1
    end
    nsteps = get stc_kv_off 0
    if ne stc_kv_u64 buf lend stc_k_insn 0
      ret -1
    end
    if not stc_expect_kv buf lend stc_k_body
      ret -1
    end
    if not stc_body_ok buf get stc_kv_off 0 get stc_kv_len 0 nsteps
      ret -1
    end
  else
    if or not stc_expect_kv buf lend stc_k_nsteps not stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
    if or not stc_expect_kv buf lend stc_k_insn not stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
    if or not stc_expect_kv buf lend stc_k_body not stc_is_dash buf get stc_kv_off 0 get stc_kv_len 0
      ret -1
    end
  end
  ret stc_v_step_tail buf lend dep has_ch
end

fn stc_v_end_dig_ok buf view uchar * p ulong vo ulong to bool
  for i ulong p bound 2097152
    put sh_dat i get buf i
  end
  sh_all p
  for i ulong 32
    bv = ulong get sh_dig i
    if ne sth_hex_nib shr bv 4 get buf add vo mul i 2
      ret false
    end
    if ne sth_hex_nib and bv 15 get buf add vo add mul i 2 1
      ret false
    end
  end
  ret true
end

fn stc_v_end_line buf view uchar * p ulong lend ulong n_tasks ulong check_ts ulong to long
  put stc_pos 0 add p 4
  if ne stc_kv_u64 buf lend stc_k_tasks 0
    ret -1
  end
  if ne get stc_kv_off 0 n_tasks
    ret -1
  end
  if ne stc_kv_u64 buf lend stc_k_steps 0
    ret -1
  end
  if ne get stc_kv_off 0 get stc_v_steps 0
    ret -1
  end
  if not stc_expect_kv buf lend stc_k_digest
    ret -1
  end
  if or not stc_hex_ok buf get stc_kv_off 0 get stc_kv_len 0 64 ne get stc_pos 0 lend
    ret -1
  end
  if not stc_v_end_dig_ok buf p get stc_kv_off 0
    ret -1
  end
  if and ne check_ts 0 ne n_tasks get stc_ts_n 0
    ret -1
  end
  if eq n_tasks 0
    ret -1
  end
  for i ulong 32
    put stc_v_dig i get sh_dig i
  end
  ret 0
end

fn stc_v_hdr_lines buf view uchar * p ulong ln ulong st ulong check_ts ulong to long
  if eq st 0
    if not sth_slice_eq buf p ln stc_t_c_magic
      ret -1
    end
    ret 1
  end
  if eq st 1
    if or ne ln 72 not sth_slice_eq buf p 8 stc_t_tssp
      ret -1
    end
    if not stc_hex_ok buf add p 8 64 64
      ret -1
    end
    if ne check_ts 0
      for i ulong 32
        bv = ulong get stc_ts_dig i
        if ne sth_hex_nib shr bv 4 get buf add add p 8 mul i 2
          ret -1
        end
        if ne sth_hex_nib and bv 15 get buf add add p 8 add mul i 2 1
          ret -1
        end
      end
    end
    ret 2
  end
  if or lt ln 73 not sth_slice_eq buf p 8 stc_t_machsp
    ret -1
  end
  if or not stc_hex_ok buf add p 8 64 64 ne ulong get buf add p 72 32
    ret -1
  end
  put stc_pos 0 add p 73
  if ne stc_kv_u64 buf add p ln stc_k_bank 0
    ret -1
  end
  bk = get stc_kv_off 0
  if or eq bk 0 gt bk 32
    ret -1
  end
  if ne get stc_pos 0 add p ln
    ret -1
  end
  ret 3
end

global stc_vst ulong 5

fn stc_v_line buf view uchar * p ulong nl ulong check_ts ulong to long
  ln = sub nl p
  if eq ln 0
    ret -1
  end
  if eq ulong get buf sub nl 1 32
    ret -1
  end
  st = get stc_vst 0
  if lt st 3
    nst = stc_v_hdr_lines buf p ln st check_ts
    if lt nst 0
      ret -1
    end
    put stc_vst 0 ulong nst
    ret 0
  end
  if eq st 3
    if and ge ln 4 sth_slice_eq buf p 4 stc_t_endsp
      put stc_v_steps 0 get stc_vst 3
      if ne stc_v_end_line buf p nl get stc_vst 1 check_ts 0
        ret -1
      end
      put stc_vst 0 5
      ret 0
    end
    if or lt ln 5 not sth_slice_eq buf p 5 stc_t_tasksp
      ret -1
    end
    if ne stc_v_task_line buf p nl get stc_vst 1 check_ts 0
      ret -1
    end
    put stc_vst 1 add get stc_vst 1 1
    put stc_vst 2 0
    put stc_vst 4 0
    put stc_vst 0 4
    ret 0
  end
  if eq st 4
    cur_t = sub get stc_vst 1 1
    seq = get stc_vst 2
    if and ge ln 7 sth_slice_eq buf p 7 stc_t_ressp
      if ne stc_v_result_line buf p nl cur_t seq 0
        ret -1
      end
      put stc_vst 3 add get stc_vst 3 seq
      put stc_vst 0 3
      ret 0
    end
    if lt ln 5
      ret -1
    end
    if not sth_slice_eq buf p 5 stc_t_stepsp
      ret -1
    end
    if ne get stc_vst 4 0
      ret -1
    end
    pr = stc_v_step_line buf p nl cur_t seq
    if lt pr 0
      ret -1
    end
    if eq pr 4
      put stc_vst 4 1
    end
    put stc_vst 2 add seq 1
    ret 0
  end
  ret -1
end

fn stc_corpus_verify buf view uchar * blen ulong check_ts ulong to long
  if eq blen 0
    ret -1
  end
  if ne ulong get buf sub blen 1 10
    ret -1
  end
  for i ulong blen bound 2097152
    b = ulong get buf i
    if or eq b 0 eq b 13
      ret -1
    end
  end
  for i ulong 5
    put stc_vst i 0
  end
  p = ulong 0
  while lt p blen bound 200000
    nl = p
    while lt nl blen bound 4096
      if eq ulong get buf nl 10
        break
      end
      nl = add nl 1
    end
    if ne stc_v_line buf p nl check_ts 0
      ret -1
    end
    p = add nl 1
  end
  if ne get stc_vst 0 5
    ret -1
  end
  ret 0
end

note ---- Hooks-off equivalence ----

fn stc_hook_equivalence to long
  stc_init
  nt = get stc_ts_n 0
  s1 = new ulong 5 0
  s1_id = new uchar 32 0
  for t ulong nt bound 64
    put stc_rec_mode 0 0
    stc_synth_task t
    put s1 0 get stc_solved 0
    put s1 1 get stc_st_gen 0
    put s1 2 get stc_st_peq 0
    put s1 3 get stc_st_fail 0
    put s1 4 get stc_st_sols 0
    for i ulong 32
      put s1_id i get stc_sol_id i
    end
    if ne stc_synth_set_hook 3 9002 0
      ret -1
    end
    put stc_hook_events 0 0
    put stc_rec_mode 0 2
    stc_synth_task t
    put stc_rec_mode 0 0
    r = stc_synth_clear_hook 9002
    if ne get s1 0 get stc_solved 0
      ret -1
    end
    if ne get s1 1 get stc_st_gen 0
      ret -1
    end
    if ne get s1 2 get stc_st_peq 0
      ret -1
    end
    if ne get s1 3 get stc_st_fail 0
      ret -1
    end
    if ne get s1 4 get stc_st_sols 0
      ret -1
    end
    if eq get stc_hook_events 0 0
      ret -1
    end
    if ne get s1 0 0
      for i ulong 32
        if ne get s1_id i get stc_sol_id i
          ret -1
        end
      end
    end
  end
  ret 0
end

note src/searchtrace/st_holdout.om: Pure seeded OM-2 G3 sealed-holdout commitment
note format v1 (commit, parse, reveal, receipt, Ed25519 sign, strict verify, CLI).
note Compose after:
note   src/searchtrace/st_om2_hdr.om
note   seed/ng/sha256.om
note   protocol/omnet/om/sha512/sha512.om
note   protocol/omnet/om/ed25519/ed25519.om
note   protocol/uor-gpu/ed_sign.om

const STH_OK long 0
const STH_EARG long -1
const STH_ELABEL long -2
const STH_ENOTASKS long -3
const STH_ECAP long -4
const STH_EFORMAT long -5
const STH_EDIGEST long -6
const STH_ESALT long -7
const STH_ELEN long -8
const STH_ECOUNT long -9
const STH_ECOMMIT long -10
const STH_ECOMMITID long -11
const STH_EUNSIGNED long -12
const STH_EBIND long -13
const STH_EKEY long -14
const STH_ESIG long -15

const STH_REC_MAX ulong 1024

text sth_t_magic "OMEGA-G3-HOLDOUT-COMMIT v1"
text sth_t_rmagic "OMEGA-G3-HOLDOUT-REVEAL v1"
text sth_t_smagic "OMEGA-G3-HOLDOUT-SIG v1"
text sth_t_dom "omega.g3.holdout.commit.v1"
text sth_t_sdom "omega.g3.holdout.salt.v1"
text sth_t_sigdom "omega.g3.holdout.sig.v1"

text sth_k_domain "domain"
text sth_k_hid "holdout_id"
text sth_k_tcnt "task_count"
text sth_k_tlen "taskset_len"
text sth_k_sdig "salt_digest"
text sth_k_comm "commitment"
text sth_k_rdig "record_digest"
text sth_k_kid "key_id"
text sth_k_sig "signature"
text sth_k_rcom "repo_commit"
text sth_k_verd "verdict PASS\n"
text sth_k_end "end"
text sth_t_endsp "end "
text sth_t_nl "\n"
text sth_t_sp " "
text sth_t_slash "/"
text sth_t_dot "."
text sth_t_p_commit "/g3-commit-"
text sth_t_p_reveal "/g3-reveal-"
text sth_t_p_sig "/g3-sig-"
text sth_t_txt ".txt"
text sth_t_tmp ".tmp."
text sth_t_envk "OMEGA_REPO_COMMIT="

text sth_t_cmd_commit "commit"
text sth_t_cmd_reveal "reveal"
text sth_t_cmd_verify "verify"
text sth_t_cmd_sign "sign"
text sth_t_opt_strict "--strict"

text sth_m_ok "OK holdout_id "
text sth_m_ok_tc " task_count "
text sth_m_ok_rd " record_digest "
text sth_m_oks "OK SIGNED holdout_id "
text sth_m_oks_kid " key_id "

text sth_w_null "null argument"
text sth_w_long "record too long"
text sth_w_nul "NUL byte in record"
text sth_w_cr "CR character in record (LF only)"
text sth_w_magic "wrong magic or version"
text sth_w_dom "wrong domain"
text sth_w_label "bad holdout_id label"
text sth_w_ztask "zero tasks refused"
text sth_w_tsmall "taskset_len too small for task_count"
text sth_w_trail "trailing bytes after end line"
text sth_w_edig "end digest mismatch"
text sth_w_trunc "truncated record (missing field or end line)"
text sth_w_nolf "truncated record (line without LF)"
text sth_w_expf "expected field '"
text sth_w_expf2 "' (missing/extra/reordered)"
text sth_w_hex64 "hex field is not 64 characters"
text sth_w_hexup "uppercase hex refused"
text sth_w_hexbad "bad hex character"
text sth_w_dec1 "bad decimal (empty, too long or leading zero)"
text sth_w_dec2 "bad decimal digit"
text sth_w_dec3 "decimal out of range"
text sth_w_esalt "salt does not match salt_digest"
text sth_w_elen "taskset_len mismatch"
text sth_w_ecnt "task_count mismatch"
text sth_w_ecomm "commitment mismatch"
text sth_w_sig128 "signature is not 128 hex characters"
text sth_w_unsig "unsigned record (strict mode needs a signature)"
text sth_w_slong "signature record too long"
text sth_w_snulcr "NUL or CR byte in signature record"
text sth_w_smagic "signature record: wrong magic or version"
text sth_w_sdom "signature record: wrong domain"
text sth_w_slabel "signature record: bad holdout_id label"
text sth_w_strail "signature record: trailing bytes after end line"
text sth_w_sedig "signature record: end digest mismatch"
text sth_w_ebind "signature names a different commitment record"
text sth_w_ekey "signed by a different key (key_id mismatch)"
text sth_w_esig "Ed25519 signature does not verify"
text sth_w_sself "signature self-check failed"
text sth_w_cap "output buffer too small"
text sth_w_usage "usage: commit <holdout_id> <taskset_file> <salt_file> <out_dir>\n       reveal <record_file> <taskset_file> <salt_file> <out_dir>\n       verify <record_file>\n       verify --strict <public_key_file> <record_file> [<sig_file>]\n       sign <record_file> <secret_key_file> <out_dir>\n"
text sth_w_errpfx "st_holdout: "

note Parsed commitment state (globals avoid 6-slot parameter overflow)
global sth_c_id uchar 65
global sth_c_idlen ulong 1
global sth_c_tcnt ulong 1
global sth_c_tlen ulong 1
global sth_c_sd uchar 32
global sth_c_cm uchar 32
global sth_c_ed uchar 32
global sth_c_rd uchar 32

note Last refusal message
global sth_why uchar 128
global sth_whylen ulong 1

note Scratch buffers for commit/parse/sign/verify/CLI
global sth_rec uchar 2048
global sth_reclen ulong 1
global sth_sig uchar 2048
global sth_siglen ulong 1
global sth_rcpt uchar 2048
global sth_rcptlen ulong 1
global sth_fbuf uchar 1048576
global sth_flen ulong 1
global sth_fbuf2 uchar 1048576
global sth_flen2 ulong 1

note Cursor state for parsing
global sth_cur_pos ulong 1
global sth_val_off ulong 1
global sth_val_len ulong 1

note CLI argv storage (up to 8 args, 512 bytes each)
global sth_argc ulong 1
global sth_argv uchar 4096
global sth_argl ulong 8

note Optional env override for testing OMEGA_REPO_COMMIT
note mode: 0 = read process env, 1 = unset, 2 = use sth_env_val
global sth_env_mode ulong 1
global sth_env_val uchar 128
global sth_env_len ulong 1

note PKCS#8 and SPKI DER prefixes for Ed25519
global sth_pkcs8 uchar 16
global sth_spki uchar 12
global sth_der_init ulong 1

fn sth_init_der to void
  if ne get sth_der_init 0 0
    ret
  end
  put sth_der_init 0 1
  put sth_pkcs8 0 0x30
  put sth_pkcs8 1 0x2e
  put sth_pkcs8 2 0x02
  put sth_pkcs8 3 0x01
  put sth_pkcs8 4 0x00
  put sth_pkcs8 5 0x30
  put sth_pkcs8 6 0x05
  put sth_pkcs8 7 0x06
  put sth_pkcs8 8 0x03
  put sth_pkcs8 9 0x2b
  put sth_pkcs8 10 0x65
  put sth_pkcs8 11 0x70
  put sth_pkcs8 12 0x04
  put sth_pkcs8 13 0x22
  put sth_pkcs8 14 0x04
  put sth_pkcs8 15 0x20
  put sth_spki 0 0x30
  put sth_spki 1 0x2a
  put sth_spki 2 0x30
  put sth_spki 3 0x05
  put sth_spki 4 0x06
  put sth_spki 5 0x03
  put sth_spki 6 0x2b
  put sth_spki 7 0x65
  put sth_spki 8 0x70
  put sth_spki 9 0x03
  put sth_spki 10 0x21
  put sth_spki 11 0x00
end

fn sth_set_why msg view uchar * to void
  n = len msg
  if gt n 127
    n = 127
  end
  for i ulong n bound 128
    put sth_why i get msg i
  end
  put sth_whylen 0 n
end

fn sth_set_why_exp key view uchar * to void
  p = ulong 0
  n1 = len sth_w_expf
  for i ulong n1 bound 32
    put sth_why p get sth_w_expf i
    p = add p 1
  end
  nk = len key
  for i ulong nk bound 32
    if lt p 127
      put sth_why p get key i
      p = add p 1
    end
  end
  n2 = len sth_w_expf2
  for i ulong n2 bound 64
    if lt p 127
      put sth_why p get sth_w_expf2 i
      p = add p 1
    end
  end
  put sth_whylen 0 p
end

fn sth_wr fd int s view uchar * to void
  r = write fd s 0 len s
end

fn sth_wr_why fd int to void
  n = get sth_whylen 0
  if gt n 0
    r = write fd sth_why 0 n
  end
end

fn sth_hex_nib v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

fn sth_ct_eq32 a view uchar 32 b view uchar 32 to bool
  acc = ulong 0
  for i ulong 32
    acc = or acc xor ulong get a i ulong get b i
  end
  ret eq acc 0
end

fn sth_label_ok s view uchar * n ulong to bool
  if or lt n 1 gt n 64
    ret false
  end
  for i ulong n bound 65
    c = ulong get s i
    ok = ulong 0
    if and ge c 97 le c 122
      ok = 1
    end
    if and ge c 65 le c 90
      ok = 1
    end
    if and ge c 48 le c 57
      ok = 1
    end
    if or eq c 46 or eq c 95 eq c 45
      ok = 1
    end
    if eq ok 0
      ret false
    end
  end
  ret true
end

fn sth_is_task_at buf view uchar * slen ulong pos ulong to bool
  if lt sub slen pos 5
    ret false
  end
  if ne ulong get buf pos 116
    ret false
  end
  if ne ulong get buf add pos 1 97
    ret false
  end
  if ne ulong get buf add pos 2 115
    ret false
  end
  if ne ulong get buf add pos 3 107
    ret false
  end
  if ne ulong get buf add pos 4 32
    ret false
  end
  ret true
end

fn sth_count_tasks buf view uchar * slen ulong to ulong
  n = ulong 0
  i = ulong 0
  while lt i slen bound 9223372036854775807
    if sth_is_task_at buf slen i
      if lt n 4294967295
        n = add n 1
      end
    end
    while lt i slen bound 9223372036854775807
      c = ulong get buf i
      i = add i 1
      if eq c 10
        break
      end
    end
  end
  ret n
end

fn sth_sha256_copy dst edit uchar 32 to void
  for i ulong 32
    put dst i get sh_dig i
  end
end

fn sth_sha256_buf buf view uchar * n ulong dst edit uchar 32 to void
  for i ulong n bound 9223372036854775807
    put sh_dat i get buf i
  end
  sh_all n
  sth_sha256_copy dst
end

fn sth_salt_digest salt view uchar 32 dst edit uchar 32 to void
  dl = len sth_t_sdom
  for i ulong dl bound 64
    put sh_dat i get sth_t_sdom i
  end
  put sh_dat dl 0
  p = add dl 1
  for i ulong 32
    put sh_dat add p i get salt i
  end
  sh_all add p 32
  sth_sha256_copy dst
end

fn sth_commitment salt view uchar 32 ts view uchar * tlen ulong cnt ulong to void
  p = len sth_t_dom
  for i ulong p bound 64
    put sh_dat i get sth_t_dom i
  end
  put sh_dat p 0
  p = add p 1
  for i ulong 32
    put sh_dat add p i get salt i
  end
  p = add p 32
  for i ulong 8
    sh = sub 56 mul i 8
    bv = and shr tlen sh 255
    put sh_dat add p i uchar bv
  end
  p = add p 8
  for i ulong 4
    sh = sub 24 mul i 8
    bv = and shr cnt sh 255
    put sh_dat add p i uchar bv
  end
  p = add p 4
  for i ulong tlen bound 9223372036854775807
    put sh_dat add p i get ts i
  end
  sh_all add p tlen
end

note Append helpers into sth_rec at pos
fn sth_rec_put_txt pos ulong s view uchar * to ulong
  n = len s
  for i ulong n bound 256
    put sth_rec add pos i get s i
  end
  ret add pos n
end

fn sth_rec_put_slice pos ulong s view uchar * n ulong to ulong
  for i ulong n bound 1024
    put sth_rec add pos i get s i
  end
  ret add pos n
end

fn sth_rec_put_u64 pos ulong v ulong to ulong
  tmp = new uchar 24 0
  k = ulong 24
  x = v
  while true bound 24
    k = sub k 1
    put tmp k uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  n = sub 24 k
  for i ulong n bound 24
    put sth_rec add pos i get tmp add k i
  end
  ret add pos n
end

fn sth_rec_put_hex pos ulong d view uchar * n ulong to ulong
  for i ulong n bound 64
    b = ulong get d i
    put sth_rec add pos mul i 2 sth_hex_nib shr b 4
    put sth_rec add pos add mul i 2 1 sth_hex_nib and b 15
  end
  ret add pos mul n 2
end

fn sth_rec_seal pos ulong cap ulong to long
  for i ulong pos bound 1024
    put sh_dat i get sth_rec i
  end
  sh_all pos
  ed = new uchar 32 0
  sth_sha256_copy ed
  tot = add pos 69
  if lt cap tot
    sth_set_why sth_w_cap
    ret STH_ECAP
  end
  p = sth_rec_put_txt pos sth_t_endsp
  p = sth_rec_put_hex p ed 32
  put sth_rec p 10
  put sth_reclen 0 add p 1
  ret STH_OK
end

note Build canonical commitment record into sth_rec[0..sth_reclen).
fn sth_commit hid view uchar * ts view uchar * salt view uchar 32 cap ulong to long
  hlen = len hid
  if not sth_label_ok hid hlen
    ret STH_ELABEL
  end
  tlen = len ts
  cnt = sth_count_tasks ts tlen
  if eq cnt 0
    ret STH_ENOTASKS
  end
  sd = new uchar 32 0
  cm = new uchar 32 0
  sth_salt_digest salt sd
  sth_commitment salt ts tlen cnt
  sth_sha256_copy cm
  p = ulong 0
  p = sth_rec_put_txt p sth_t_magic
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_domain
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_txt p sth_t_dom
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_hid
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_slice p hid hlen
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_tcnt
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_u64 p cnt
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_tlen
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_u64 p tlen
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_sdig
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_hex p sd 32
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_comm
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_hex p cm 32
  put sth_rec p 10
  p = add p 1
  ret sth_rec_seal p cap
end

note ---- strict parser helpers ----

fn sth_check_rec_bytes rec view uchar * rlen ulong is_sig ulong to long
  if gt rlen STH_REC_MAX
    if ne is_sig 0
      sth_set_why sth_w_slong
    else
      sth_set_why sth_w_long
    end
    ret STH_EFORMAT
  end
  for i ulong rlen bound 1025
    b = ulong get rec i
    if eq b 0
      if ne is_sig 0
        sth_set_why sth_w_snulcr
      else
        sth_set_why sth_w_nul
      end
      ret STH_EFORMAT
    end
    if eq b 13
      if ne is_sig 0
        sth_set_why sth_w_snulcr
      else
        sth_set_why sth_w_cr
      end
      ret STH_EFORMAT
    end
  end
  ret STH_OK
end

fn sth_slice_eq a view uchar * off ulong alen ulong b view uchar * to bool
  if ne alen len b
    ret false
  end
  for i ulong alen bound 1024
    if ne get a add off i get b i
      ret false
    end
  end
  ret true
end

fn sth_next_field rec view uchar * rlen ulong key view uchar * to long
  pos = get sth_cur_pos 0
  if ge pos rlen
    sth_set_why sth_w_trunc
    ret STH_EFORMAT
  end
  nl = pos
  found = ulong 0
  while lt nl rlen bound 1025
    if eq ulong get rec nl 10
      found = 1
      break
    end
    nl = add nl 1
  end
  if eq found 0
    sth_set_why sth_w_nolf
    ret STH_EFORMAT
  end
  ll = sub nl pos
  kl = len key
  if lt ll add kl 1
    sth_set_why_exp key
    ret STH_EFORMAT
  end
  for i ulong kl bound 64
    if ne get rec add pos i get key i
      sth_set_why_exp key
      ret STH_EFORMAT
    end
  end
  if ne ulong get rec add pos kl 32
    sth_set_why_exp key
    ret STH_EFORMAT
  end
  put sth_val_off 0 add pos add kl 1
  put sth_val_len 0 sub sub ll kl 1
  put sth_cur_pos 0 add nl 1
  ret STH_OK
end

fn sth_parse_hex32 rec view uchar * off ulong n ulong dst edit uchar 32 to long
  if ne n 64
    sth_set_why sth_w_hex64
    ret STH_EFORMAT
  end
  for i ulong 64
    ch = ulong get rec add off i
    x = ulong 99
    if and ge ch 48 le ch 57
      x = sub ch 48
    else
      if and ge ch 97 le ch 102
        x = add sub ch 97 10
      else
        if and ge ch 65 le ch 70
          sth_set_why sth_w_hexup
          ret STH_EFORMAT
        end
        sth_set_why sth_w_hexbad
        ret STH_EFORMAT
      end
    end
    idx = div i 2
    if eq and i 1 1
      put dst idx uchar or ulong get dst idx x
    else
      put dst idx uchar shl x 4
    end
  end
  ret STH_OK
end

fn sth_parse_hex64 rec view uchar * off ulong n ulong dst edit uchar 64 to long
  if ne n 128
    sth_set_why sth_w_sig128
    ret STH_EFORMAT
  end
  h1 = new uchar 32 0
  h2 = new uchar 32 0
  r1 = sth_parse_hex32 rec off 64 h1
  if ne r1 0
    ret r1
  end
  r2 = sth_parse_hex32 rec add off 64 64 h2
  if ne r2 0
    ret r2
  end
  for i ulong 32
    put dst i get h1 i
    put dst add i 32 get h2 i
  end
  ret STH_OK
end

fn sth_parse_dec rec view uchar * off ulong n ulong maxv ulong dst edit ulong 1 to long
  if or eq n 0 gt n 20
    sth_set_why sth_w_dec1
    ret STH_EFORMAT
  end
  if gt n 1
    if eq ulong get rec off 48
      sth_set_why sth_w_dec1
      ret STH_EFORMAT
    end
  end
  x = ulong 0
  for i ulong n bound 24
    c = ulong get rec add off i
    if or lt c 48 gt c 57
      sth_set_why sth_w_dec2
      ret STH_EFORMAT
    end
    d = sub c 48
    if gt x div sub maxv d 10
      sth_set_why sth_w_dec3
      ret STH_EFORMAT
    end
    x = add mul x 10 d
  end
  put dst 0 x
  ret STH_OK
end

fn sth_parse_hdr rec view uchar * rlen ulong to long
  ml = len sth_t_magic
  if lt rlen add ml 1
    sth_set_why sth_w_magic
    ret STH_EFORMAT
  end
  if not sth_slice_eq rec 0 ml sth_t_magic
    sth_set_why sth_w_magic
    ret STH_EFORMAT
  end
  if ne ulong get rec ml 10
    sth_set_why sth_w_magic
    ret STH_EFORMAT
  end
  put sth_cur_pos 0 add ml 1
  r = sth_next_field rec rlen sth_k_domain
  if ne r 0
    ret r
  end
  if not sth_slice_eq rec get sth_val_off 0 get sth_val_len 0 sth_t_dom
    sth_set_why sth_w_dom
    ret STH_EFORMAT
  end
  r = sth_next_field rec rlen sth_k_hid
  if ne r 0
    ret r
  end
  vo = get sth_val_off 0
  vl = get sth_val_len 0
  tmp = new uchar 65 0
  if or lt vl 1 gt vl 64
    sth_set_why sth_w_label
    ret STH_EFORMAT
  end
  for i ulong vl bound 65
    put tmp i get rec add vo i
  end
  if not sth_label_ok tmp vl
    sth_set_why sth_w_label
    ret STH_EFORMAT
  end
  for i ulong vl bound 65
    put sth_c_id i get tmp i
  end
  put sth_c_idlen 0 vl
  ret STH_OK
end

fn sth_parse_nums rec view uchar * rlen ulong to long
  num = new ulong 1 0
  r = sth_next_field rec rlen sth_k_tcnt
  if ne r 0
    ret r
  end
  r = sth_parse_dec rec get sth_val_off 0 get sth_val_len 0 4294967295 num
  if ne r 0
    ret r
  end
  tc = get num 0
  if eq tc 0
    sth_set_why sth_w_ztask
    ret STH_EFORMAT
  end
  put sth_c_tcnt 0 tc
  r = sth_next_field rec rlen sth_k_tlen
  if ne r 0
    ret r
  end
  r = sth_parse_dec rec get sth_val_off 0 get sth_val_len 0 18446744073709551615 num
  if ne r 0
    ret r
  end
  tl = get num 0
  if lt div tl 5 tc
    sth_set_why sth_w_tsmall
    ret STH_EFORMAT
  end
  put sth_c_tlen 0 tl
  ret STH_OK
end

fn sth_parse rec view uchar * rlen ulong to long
  r = sth_check_rec_bytes rec rlen 0
  if ne r 0
    ret r
  end
  r = sth_parse_hdr rec rlen
  if ne r 0
    ret r
  end
  r = sth_parse_nums rec rlen
  if ne r 0
    ret r
  end
  sd = new uchar 32 0
  cm = new uchar 32 0
  ed = new uchar 32 0
  r = sth_next_field rec rlen sth_k_sdig
  if ne r 0
    ret r
  end
  r = sth_parse_hex32 rec get sth_val_off 0 get sth_val_len 0 sd
  if ne r 0
    ret r
  end
  r = sth_next_field rec rlen sth_k_comm
  if ne r 0
    ret r
  end
  r = sth_parse_hex32 rec get sth_val_off 0 get sth_val_len 0 cm
  if ne r 0
    ret r
  end
  blen = get sth_cur_pos 0
  r = sth_next_field rec rlen sth_k_end
  if ne r 0
    ret r
  end
  r = sth_parse_hex32 rec get sth_val_off 0 get sth_val_len 0 ed
  if ne r 0
    ret r
  end
  if ne get sth_cur_pos 0 rlen
    sth_set_why sth_w_trail
    ret STH_EFORMAT
  end
  d = new uchar 32 0
  sth_sha256_buf rec blen d
  if not sth_ct_eq32 d ed
    sth_set_why sth_w_edig
    ret STH_EDIGEST
  end
  rd = new uchar 32 0
  sth_sha256_buf rec rlen rd
  for i ulong 32
    put sth_c_sd i get sd i
    put sth_c_cm i get cm i
    put sth_c_ed i get ed i
    put sth_c_rd i get rd i
  end
  ret STH_OK
end

fn sth_reveal ts view uchar * tlen ulong salt view uchar 32 to long
  d = new uchar 32 0
  want = new uchar 32 0
  sth_salt_digest salt d
  for i ulong 32
    put want i get sth_c_sd i
  end
  if not sth_ct_eq32 d want
    sth_set_why sth_w_esalt
    ret STH_ESALT
  end
  if ne tlen get sth_c_tlen 0
    sth_set_why sth_w_elen
    ret STH_ELEN
  end
  cnt = sth_count_tasks ts tlen
  if ne cnt get sth_c_tcnt 0
    sth_set_why sth_w_ecnt
    ret STH_ECOUNT
  end
  sth_commitment salt ts tlen cnt
  sth_sha256_copy d
  for i ulong 32
    put want i get sth_c_cm i
  end
  if not sth_ct_eq32 d want
    sth_set_why sth_w_ecomm
    ret STH_ECOMMIT
  end
  ret STH_OK
end

fn sth_commit40_ok s view uchar * n ulong to bool
  if ne n 40
    ret false
  end
  for i ulong 40
    ch = ulong get s i
    ok = ulong 0
    if and ge ch 48 le ch 57
      ok = 1
    end
    if and ge ch 97 le ch 102
      ok = 1
    end
    if eq ok 0
      ret false
    end
  end
  ret true
end

fn sth_reveal_receipt rcom view uchar * rlen ulong cap ulong to long
  if not sth_commit40_ok rcom rlen
    ret STH_ECOMMITID
  end
  idlen = get sth_c_idlen 0
  idb = new uchar 64 0
  if or lt idlen 1 gt idlen 64
    ret STH_ELABEL
  end
  for i ulong idlen bound 64
    put idb i get sth_c_id i
  end
  if not sth_label_ok idb idlen
    ret STH_ELABEL
  end
  cm = new uchar 32 0
  rd = new uchar 32 0
  for i ulong 32
    put cm i get sth_c_cm i
    put rd i get sth_c_rd i
  end
  p = ulong 0
  p = sth_rec_put_txt p sth_t_rmagic
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_domain
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_txt p sth_t_dom
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_hid
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_slice p idb idlen
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_comm
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_hex p cm 32
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_rdig
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_hex p rd 32
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_tcnt
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_u64 p get sth_c_tcnt 0
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_tlen
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_u64 p get sth_c_tlen 0
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_rcom
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_slice p rcom 40
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_verd
  r = sth_rec_seal p cap
  if ne r 0
    ret r
  end
  tot = get sth_reclen 0
  for i ulong tot bound 1024
    put sth_rcpt i get sth_rec i
  end
  put sth_rcptlen 0 tot
  ret STH_OK
end

note ---- Ed25519 strict verify (rejects small-order A and R, matching aienos_sig) ----

fn sth_pt_small_order b view uchar 32 to bool
  w = new ulong 1024 0
  edinit w
  if eq edpdec w edq b 0
    ret true
  end
  edpdbl w edq
  edpdbl w edq
  edpdbl w edq
  ret eq edpid w edq 1
end

fn sth_edverify_strict pk view uchar 32 msg view uchar 65536 mlen ulong sg view uchar 64 to bool
  if sth_pt_small_order pk
    ret false
  end
  rb = new uchar 32 0
  for i ulong 32
    put rb i get sg i
  end
  if sth_pt_small_order rb
    ret false
  end
  ret eq edverify pk msg mlen sg 0 1
end

fn sth_build_sig_msg rec view uchar * rlen ulong msg edit uchar 65536 to ulong
  dl = len sth_t_sigdom
  for i ulong dl bound 64
    put msg i get sth_t_sigdom i
  end
  put msg dl 0
  p = add dl 1
  for i ulong rlen bound 1025
    put msg add p i get rec i
  end
  ret add p rlen
end

fn sth_emit_sig_rec kid view uchar 32 sg view uchar 64 cap ulong to long
  idlen = get sth_c_idlen 0
  idb = new uchar 64 0
  rd = new uchar 32 0
  for i ulong idlen bound 64
    put idb i get sth_c_id i
  end
  for i ulong 32
    put rd i get sth_c_rd i
  end
  p = ulong 0
  p = sth_rec_put_txt p sth_t_smagic
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_domain
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_txt p sth_t_sigdom
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_hid
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_slice p idb idlen
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_rdig
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_hex p rd 32
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_kid
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_hex p kid 32
  put sth_rec p 10
  p = add p 1
  p = sth_rec_put_txt p sth_k_sig
  put sth_rec p 32
  p = add p 1
  p = sth_rec_put_hex p sg 64
  put sth_rec p 10
  p = add p 1
  r = sth_rec_seal p cap
  if ne r 0
    ret r
  end
  tot = get sth_reclen 0
  for i ulong tot bound 1024
    put sth_sig i get sth_rec i
  end
  put sth_siglen 0 tot
  ret STH_OK
end

fn sth_sign rec view uchar * rlen ulong sk view uchar 32 cap ulong to long
  r = sth_parse rec rlen
  if ne r 0
    ret r
  end
  pk = new uchar 32 0
  kid = new uchar 32 0
  sg = new uchar 64 0
  msg = new uchar 65536 0
  ues_pubkey sk pk
  sth_sha256_buf pk 32 kid
  ml = sth_build_sig_msg rec rlen msg
  ues_sign sk msg ml sg
  if not sth_edverify_strict pk msg ml sg
    sth_set_why sth_w_sself
    ret STH_ESIG
  end
  ret sth_emit_sig_rec kid sg cap
end

fn sth_vsig_hdr srec view uchar * slen ulong id_ok edit ulong 1 to long
  r = sth_check_rec_bytes srec slen 1
  if ne r 0
    ret r
  end
  ml = len sth_t_smagic
  if lt slen add ml 1
    sth_set_why sth_w_smagic
    ret STH_EFORMAT
  end
  if not sth_slice_eq srec 0 ml sth_t_smagic
    sth_set_why sth_w_smagic
    ret STH_EFORMAT
  end
  if ne ulong get srec ml 10
    sth_set_why sth_w_smagic
    ret STH_EFORMAT
  end
  put sth_cur_pos 0 add ml 1
  r = sth_next_field srec slen sth_k_domain
  if ne r 0
    ret r
  end
  if not sth_slice_eq srec get sth_val_off 0 get sth_val_len 0 sth_t_sigdom
    sth_set_why sth_w_sdom
    ret STH_EFORMAT
  end
  r = sth_next_field srec slen sth_k_hid
  if ne r 0
    ret r
  end
  vo = get sth_val_off 0
  vl = get sth_val_len 0
  tmp = new uchar 65 0
  if or lt vl 1 gt vl 64
    sth_set_why sth_w_slabel
    ret STH_EFORMAT
  end
  for i ulong vl bound 65
    put tmp i get srec add vo i
  end
  if not sth_label_ok tmp vl
    sth_set_why sth_w_slabel
    ret STH_EFORMAT
  end
  ok = ulong 0
  if eq vl get sth_c_idlen 0
    ok = 1
    for i ulong vl bound 65
      if ne get tmp i get sth_c_id i
        ok = 0
      end
    end
  end
  put id_ok 0 ok
  ret STH_OK
end

fn sth_vsig_crypto rec view uchar 1024 rlen ulong pk view uchar 32 sg view uchar 64 to long
  msg = new uchar 65536 0
  ml = sth_build_sig_msg rec rlen msg
  if not sth_edverify_strict pk msg ml sg
    sth_set_why sth_w_esig
    ret STH_ESIG
  end
  ret STH_OK
end

fn sth_vsig_check_bind idok ulong rd view uchar 32 kid view uchar 32 pk view uchar 32 to long
  crd = new uchar 32 0
  for i ulong 32
    put crd i get sth_c_rd i
  end
  if or eq idok 0 not sth_ct_eq32 rd crd
    sth_set_why sth_w_ebind
    ret STH_EBIND
  end
  wkid = new uchar 32 0
  sth_sha256_buf pk 32 wkid
  if not sth_ct_eq32 kid wkid
    sth_set_why sth_w_ekey
    ret STH_EKEY
  end
  ret STH_OK
end

fn sth_vsig_check_end srec view uchar 1024 blen ulong ed view uchar 32 to long
  for i ulong blen bound 1025
    put sh_dat i get srec i
  end
  sh_all blen
  d_ok = ulong 0
  for i ulong 32
    d_ok = or d_ok xor ulong get sh_dig i ulong get ed i
  end
  if ne d_ok 0
    sth_set_why sth_w_sedig
    ret STH_EDIGEST
  end
  ret STH_OK
end

fn sth_verify_signed rec view uchar 1024 rlen ulong srec view uchar 1024 slen ulong pk view uchar 32 to long
  r = sth_parse rec rlen
  if ne r 0
    ret r
  end
  if eq slen 0
    sth_set_why sth_w_unsig
    ret STH_EUNSIGNED
  end
  id_ok = new ulong 1 0
  r = sth_vsig_hdr srec slen id_ok
  if ne r 0
    ret r
  end
  rd = new uchar 32 0
  kid = new uchar 32 0
  sg = new uchar 64 0
  ed = new uchar 32 0
  r = sth_next_field srec slen sth_k_rdig
  if ne r 0
    ret r
  end
  r = sth_parse_hex32 srec get sth_val_off 0 get sth_val_len 0 rd
  if ne r 0
    ret r
  end
  r = sth_next_field srec slen sth_k_kid
  if ne r 0
    ret r
  end
  r = sth_parse_hex32 srec get sth_val_off 0 get sth_val_len 0 kid
  if ne r 0
    ret r
  end
  r = sth_next_field srec slen sth_k_sig
  if ne r 0
    ret r
  end
  r = sth_parse_hex64 srec get sth_val_off 0 get sth_val_len 0 sg
  if ne r 0
    ret r
  end
  blen = get sth_cur_pos 0
  r = sth_next_field srec slen sth_k_end
  if ne r 0
    ret r
  end
  r = sth_parse_hex32 srec get sth_val_off 0 get sth_val_len 0 ed
  if ne r 0
    ret r
  end
  if ne get sth_cur_pos 0 slen
    sth_set_why sth_w_strail
    ret STH_EFORMAT
  end
  r = sth_vsig_check_end srec blen ed
  if ne r 0
    ret r
  end
  r = sth_vsig_check_bind get id_ok 0 rd kid pk
  if ne r 0
    ret r
  end
  ret sth_vsig_crypto rec rlen pk sg
end

note ---- CLI file I/O and subcommands ----

fn sth_arg_get idx ulong dst edit uchar 512 to ulong
  n = get sth_argl idx
  base = mul idx 512
  for i ulong n bound 512
    put dst i get sth_argv add base i
  end
  ret n
end

fn sth_arg_eq idx ulong s view uchar * to bool
  n = get sth_argl idx
  if ne n len s
    ret false
  end
  base = mul idx 512
  for i ulong n bound 512
    if ne get sth_argv add base i get s i
      ret false
    end
  end
  ret true
end

fn sth_arg_set idx ulong s view uchar * n ulong to void
  base = mul idx 512
  for i ulong n bound 512
    put sth_argv add base i get s i
  end
  put sth_argl idx n
end

note Read file into sth_fbuf (slot 0) or sth_fbuf2 (slot 1). Returns length or -errno.
fn sth_read_file pth view uchar 512 plen ulong slot ulong to long
  fd = fopen pth 0 plen 0 0
  if lt fd 0
    ret fd
  end
  tot = ulong 0
  cap = ulong 1048576
  while lt tot cap bound 1048576
    r = long 0
    if eq slot 0
      r = read int fd sth_fbuf tot sub cap tot
    else
      r = read int fd sth_fbuf2 tot sub cap tot
    end
    if lt r 0
      if eq r -4
        continue
      end
      rc = fclose int fd
      ret r
    end
    if eq r 0
      break
    end
    tot = add tot ulong r
  end
  rc = fclose int fd
  if eq slot 0
    put sth_flen 0 tot
  else
    put sth_flen2 0 tot
  end
  ret long tot
end

fn sth_pack_two p1 view uchar 512 l1 ulong p2 view uchar 512 l2 ulong dst edit uchar 1040 to ulong
  put dst 0 2
  put dst 1 0
  put dst 2 uchar and l1 255
  put dst 3 uchar and shr l1 8 255
  p = ulong 4
  for i ulong l1 bound 512
    put dst add p i get p1 i
  end
  p = add p l1
  put dst p uchar and l2 255
  put dst add p 1 uchar and shr l2 8 255
  p = add p 2
  for i ulong l2 bound 512
    put dst add p i get p2 i
  end
  ret add p l2
end

fn sth_append_u64_buf dst edit uchar 512 pos ulong v ulong to ulong
  tmp = new uchar 24 0
  k = ulong 24
  x = v
  while true bound 24
    k = sub k 1
    put tmp k uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  n = sub 24 k
  for i ulong n bound 24
    put dst add pos i get tmp add k i
  end
  ret add pos n
end

fn sth_make_tmp_path pth view uchar 512 plen ulong tmp edit uchar 512 to ulong
  for i ulong plen bound 480
    put tmp i get pth i
  end
  tp = plen
  tl = len sth_t_tmp
  for i ulong tl bound 16
    put tmp add tp i get sth_t_tmp i
  end
  tp = add tp tl
  ret sth_append_u64_buf tmp tp ulong getpid
end

fn sth_write_addressed pth view uchar 512 plen ulong dat view uchar * dlen ulong to long
  r = sth_read_file pth plen 1
  if ge r 0
    if ne ulong r dlen
      ret -2
    end
    for i ulong dlen bound 1048576
      if ne get sth_fbuf2 i get dat i
        ret -2
      end
    end
    ret 0
  end
  if ne r -2
    ret -1
  end
  tmp = new uchar 512 0
  pk = new uchar 1040 0
  tp = sth_make_tmp_path pth plen tmp
  note O_WRONLY|O_CREAT|O_EXCL = 1|64|128 = 193, mode 0666 = 438
  fd = fopen tmp 0 tp 193 438
  if lt fd 0
    ret -1
  end
  ok = eq write int fd dat 0 dlen long dlen
  if ne fsync int fd 0
    ok = false
  end
  if ne fclose int fd 0
    ok = false
  end
  if not ok
    r = unlink tmp 0 tp
    ret -1
  end
  pkl = sth_pack_two tmp tp pth plen pk
  lr = link pk 0 pkl
  r = unlink tmp 0 tp
  if ne lr 0
    if eq lr -17
      ret -2
    end
    ret -1
  end
  ret 0
end

fn sth_read_salt pth view uchar 512 plen ulong salt edit uchar 32 to long
  r = sth_read_file pth plen 0
  if lt r 0
    ret -1
  end
  if ne r 32
    ret -1
  end
  for i ulong 32
    put salt i get sth_fbuf i
    put sth_fbuf i 0
  end
  ret 0
end

fn sth_check_key_stat fd int secret ulong to long
  st = new uchar 128 0
  if ne fstat fd st 0 128 0
    ret -1
  end
  mode = ulong get st 16
  mode = or mode shl ulong get st 17 8
  mode = or mode shl ulong get st 18 16
  mode = or mode shl ulong get st 19 24
  if ne and mode 0xf000 0x8000
    ret -1
  end
  if ne secret 0
    if ne and mode 63 0
      ret -3
    end
  end
  ret 0
end

note Read key file safely: O_RDONLY|O_NONBLOCK|O_CLOEXEC (2048+524288=526336), fstat S_ISREG, mode & 077.
fn sth_read_key_file pth view uchar 512 plen ulong buf edit uchar 80 secret ulong to long
  ex = new uchar 1 0
  fd = fopen pth 0 plen 526336 0
  if lt fd 0
    ret -1
  end
  sr = sth_check_key_stat int fd secret
  if ne sr 0
    rc = fclose int fd
    ret sr
  end
  n = ulong 0
  while lt n 80 bound 128
    r = read int fd buf n sub 80 n
    if lt r 0
      if eq r -4
        continue
      end
      rc = fclose int fd
      ret -1
    end
    if eq r 0
      break
    end
    n = add n ulong r
  end
  if eq n 80
    er = read int fd ex 0 1
    if ne er 0
      rc = fclose int fd
      ret -2
    end
  end
  rc = fclose int fd
  ret long n
end

fn sth_load_key pth view uchar 512 plen ulong secret ulong key edit uchar 32 to long
  sth_init_der
  buf = new uchar 80 0
  n = sth_read_key_file pth plen buf secret
  if lt n 0
    for i ulong 80
      put buf i 0
    end
    ret -1
  end
  un = ulong n
  ok = ulong 0
  if eq un 32
    for i ulong 32
      put key i get buf i
    end
    ok = 1
  else
    is_hex = ulong 0
    if eq un 64
      is_hex = 1
    else
      if eq un 65
        if eq ulong get buf 64 10
          is_hex = 1
        end
      end
    end
    if eq is_hex 1
      for i ulong 64
        c = ulong get buf i
        if and ge c 65 le c 70
          put buf i uchar add sub c 65 97
        end
      end
      if eq sth_parse_hex32 buf 0 64 key 0
        ok = 1
      end
    else
      if ne secret 0
        if eq un 48
          m = ulong 1
          for i ulong 16
            if ne get buf i get sth_pkcs8 i
              m = 0
            end
          end
          if eq m 1
            for i ulong 32
              put key i get buf add 16 i
            end
            ok = 1
          end
        end
      else
        if eq un 44
          m = ulong 1
          for i ulong 12
            if ne get buf i get sth_spki i
              m = 0
            end
          end
          if eq m 1
            for i ulong 32
              put key i get buf add 12 i
            end
            ok = 1
          end
        end
      end
    end
  end
  for i ulong 80
    put buf i 0
  end
  if eq ok 0
    for i ulong 32
      put key i 0
    end
    ret -1
  end
  ret 0
end

fn sth_make_out_path dir view uchar 512 dlen ulong pfx view uchar * dig view uchar 32 dst edit uchar 512 to ulong
  p = ulong 0
  for i ulong dlen bound 400
    put dst p get dir i
    p = add p 1
  end
  pl = len pfx
  for i ulong pl bound 32
    put dst p get pfx i
    p = add p 1
  end
  for i ulong 32
    b = ulong get dig i
    put dst p sth_hex_nib shr b 4
    put dst add p 1 sth_hex_nib and b 15
    p = add p 2
  end
  tl = len sth_t_txt
  for i ulong tl bound 8
    put dst p get sth_t_txt i
    p = add p 1
  end
  ret p
end

fn sth_get_repo_commit dst edit uchar 64 to long
  m = get sth_env_mode 0
  if eq m 1
    ret -1
  end
  if eq m 2
    n = get sth_env_len 0
    if gt n 64
      n = 64
    end
    for i ulong n bound 64
      put dst i get sth_env_val i
    end
    ret long n
  end
  ec = envcnt
  eb = new uchar 256 0
  kl = len sth_t_envk
  for i ulong ulong ec bound 4096
    el = envread i eb 0 256
    if gt el long kl
      match = ulong 1
      for j ulong kl bound 32
        if ne get eb j get sth_t_envk j
          match = 0
        end
      end
      if eq match 1
        vl = sub ulong el kl
        if gt vl 64
          vl = 64
        end
        for j ulong vl bound 64
          put dst j get eb add kl j
        end
        ret long vl
      end
    end
  end
  ret -1
end

fn sth_cli_write_out dir_idx ulong pfx view uchar * dat view uchar * dlen ulong to int
  rd = new uchar 32 0
  dp = new uchar 512 0
  op = new uchar 512 0
  sth_sha256_buf dat dlen rd
  dpl = sth_arg_get dir_idx dp
  opl = sth_make_out_path dp dpl pfx rd op
  if ne sth_write_addressed op opl dat dlen 0
    ret 2
  end
  w1 = write 1 op 0 opl
  sth_wr 1 sth_t_nl
  ret 0
end

fn sth_cli_commit to int
  pth = new uchar 512 0
  salt = new uchar 32 0
  pl = sth_arg_get 3 pth
  if ne sth_read_salt pth pl salt 0
    ret 2
  end
  pl = sth_arg_get 2 pth
  tl = sth_read_file pth pl 0
  if or lt tl 0 gt tl 65536
    ret 2
  end
  ts = new uchar 65536 0
  for i ulong ulong tl bound 65536
    put ts i get sth_fbuf i
  end
  pl = sth_arg_get 1 pth
  r = sth_commit part pth 0 pl part ts 0 ulong tl salt STH_REC_MAX
  for i ulong 32
    put salt i 0
  end
  if ne r 0
    ret 2
  end
  rl = get sth_reclen 0
  rb = new uchar 1024 0
  for i ulong rl bound 1024
    put rb i get sth_rec i
  end
  if ne sth_parse rb rl 0
    ret 2
  end
  ret sth_cli_write_out 4 sth_t_p_commit rb rl
end

fn sth_cli_reveal to int
  rcom = new uchar 64 0
  rcl = sth_get_repo_commit rcom
  if le rcl 0
    ret 2
  end
  pth = new uchar 512 0
  pl = sth_arg_get 1 pth
  rbl = sth_read_file pth pl 0
  if or lt rbl 0 gt rbl 1024
    ret 2
  end
  rb = new uchar 1024 0
  for i ulong ulong rbl bound 1024
    put rb i get sth_fbuf i
  end
  if ne sth_parse rb ulong rbl 0
    ret 2
  end
  salt = new uchar 32 0
  pl = sth_arg_get 3 pth
  if ne sth_read_salt pth pl salt 0
    ret 2
  end
  pl = sth_arg_get 2 pth
  tl = sth_read_file pth pl 0
  if or lt tl 0 gt tl 65536
    ret 2
  end
  ts = new uchar 65536 0
  for i ulong ulong tl bound 65536
    put ts i get sth_fbuf i
  end
  rv = sth_reveal ts ulong tl salt
  for i ulong 32
    put salt i 0
  end
  if ne rv 0
    ret 2
  end
  if ne sth_reveal_receipt rcom ulong rcl STH_REC_MAX 0
    ret 2
  end
  ol = get sth_rcptlen 0
  for i ulong ol bound 1024
    put rb i get sth_rcpt i
  end
  ret sth_cli_write_out 4 sth_t_p_reveal rb ol
end

fn sth_cli_verify to int
  rp = new uchar 512 0
  rpl = sth_arg_get 1 rp
  rbl = sth_read_file rp rpl 0
  if or lt rbl 0 gt rbl 1024
    ret 2
  end
  rb = new uchar 1024 0
  for i ulong ulong rbl bound 1024
    put rb i get sth_fbuf i
  end
  if ne sth_parse rb ulong rbl 0
    ret 2
  end
  sth_wr 1 sth_m_ok
  w1 = write 1 sth_c_id 0 get sth_c_idlen 0
  sth_wr 1 sth_m_ok_tc
  nb = new uchar 512 0
  nl = sth_append_u64_buf nb 0 get sth_c_tcnt 0
  w2 = write 1 nb 0 nl
  sth_wr 1 sth_m_ok_rd
  hx = new uchar 64 0
  for i ulong 32
    b = ulong get sth_c_rd i
    put hx mul i 2 sth_hex_nib shr b 4
    put hx add mul i 2 1 sth_hex_nib and b 15
  end
  w3 = write 1 hx 0 64
  sth_wr 1 sth_t_nl
  ret 0
end

fn sth_cli_sign_write dir_idx ulong sb view uchar 1024 sl ulong to int
  rd = new uchar 32 0
  dp = new uchar 512 0
  op = new uchar 512 0
  for i ulong 32
    put rd i get sth_c_rd i
  end
  dpl = sth_arg_get dir_idx dp
  opl = sth_make_out_path dp dpl sth_t_p_sig rd op
  if ne sth_write_addressed op opl sb sl 0
    ret 2
  end
  w1 = write 1 op 0 opl
  sth_wr 1 sth_t_nl
  ret 0
end

fn sth_cli_sign to int
  pth = new uchar 512 0
  rb = new uchar 1024 0
  sk = new uchar 32 0
  pl = sth_arg_get 1 pth
  rbl = sth_read_file pth pl 0
  if or lt rbl 0 gt rbl 1024
    ret 2
  end
  for i ulong ulong rbl bound 1024
    put rb i get sth_fbuf i
  end
  if ne sth_parse rb ulong rbl 0
    ret 2
  end
  pl = sth_arg_get 2 pth
  if ne sth_load_key pth pl 1 sk 0
    ret 2
  end
  sr = sth_sign rb ulong rbl sk STH_REC_MAX
  for i ulong 32
    put sk i 0
  end
  if ne sr 0
    ret 2
  end
  sl = get sth_siglen 0
  for i ulong sl bound 1024
    put rb i get sth_sig i
  end
  ret sth_cli_sign_write 3 rb sl
end

fn sth_print_ok_signed pk view uchar 32 to void
  sth_wr 1 sth_m_oks
  w1 = write 1 sth_c_id 0 get sth_c_idlen 0
  sth_wr 1 sth_m_ok_tc
  nb = new uchar 512 0
  nl = sth_append_u64_buf nb 0 get sth_c_tcnt 0
  w2 = write 1 nb 0 nl
  sth_wr 1 sth_m_ok_rd
  hx = new uchar 64 0
  for i ulong 32
    b = ulong get sth_c_rd i
    put hx mul i 2 sth_hex_nib shr b 4
    put hx add mul i 2 1 sth_hex_nib and b 15
  end
  w3 = write 1 hx 0 64
  sth_wr 1 sth_m_oks_kid
  kd = new uchar 32 0
  sth_sha256_buf pk 32 kd
  for i ulong 32
    b = ulong get kd i
    put hx mul i 2 sth_hex_nib shr b 4
    put hx add mul i 2 1 sth_hex_nib and b 15
  end
  w4 = write 1 hx 0 64
  sth_wr 1 sth_t_nl
end

fn sth_derive_sig_path rp view uchar 512 rpl ulong rb view uchar 1024 rbl ulong sp edit uchar 512 to ulong
  d = new uchar 32 0
  dir = new uchar 512 0
  sth_sha256_buf rb rbl d
  slash = long -1
  for i ulong rpl bound 512
    if eq ulong get rp i 47
      slash = long i
    end
  end
  dl = ulong 0
  if ge slash 0
    dl = ulong slash
    for i ulong dl bound 512
      put dir i get rp i
    end
  else
    put dir 0 46
    dl = 1
  end
  ret sth_make_out_path dir dl sth_t_p_sig d sp
end

fn sth_cli_load_sig rb view uchar 1024 rbl ulong sb edit uchar 1024 to long
  rp = new uchar 512 0
  sp = new uchar 512 0
  ac = get sth_argc 0
  spl = ulong 0
  if eq ac 5
    spl = sth_arg_get 4 sp
  else
    rpl = sth_arg_get 3 rp
    spl = sth_derive_sig_path rp rpl rb rbl sp
  end
  sbl = sth_read_file sp spl 0
  if lt sbl 0
    if or ne sbl -2 eq ac 5
      ret -1
    end
    ret 0
  end
  if gt sbl 1024
    ret -1
  end
  for i ulong ulong sbl bound 1024
    put sb i get sth_fbuf i
  end
  ret sbl
end

fn sth_cli_verify_strict to int
  pth = new uchar 512 0
  pk = new uchar 32 0
  rb = new uchar 1024 0
  sb = new uchar 1024 0
  pl = sth_arg_get 2 pth
  if ne sth_load_key pth pl 0 pk 0
    ret 2
  end
  pl = sth_arg_get 3 pth
  rbl = sth_read_file pth pl 0
  if or lt rbl 0 gt rbl 1024
    ret 2
  end
  for i ulong ulong rbl bound 1024
    put rb i get sth_fbuf i
  end
  sbl = sth_cli_load_sig rb ulong rbl sb
  if lt sbl 0
    ret 2
  end
  if ne sth_verify_signed rb ulong rbl sb ulong sbl pk 0
    ret 2
  end
  sth_print_ok_signed pk
  ret 0
end

fn sth_cli_run to int
  ac = get sth_argc 0
  if lt ac 1
    sth_wr 2 sth_w_usage
    ret 1
  end
  if and sth_arg_eq 0 sth_t_cmd_commit eq ac 5
    ret sth_cli_commit
  end
  if and sth_arg_eq 0 sth_t_cmd_reveal eq ac 5
    ret sth_cli_reveal
  end
  if sth_arg_eq 0 sth_t_cmd_verify
    if or eq ac 4 eq ac 5
      if sth_arg_eq 1 sth_t_opt_strict
        ret sth_cli_verify_strict
      end
    end
    if eq ac 2
      ret sth_cli_verify
    end
  end
  if and sth_arg_eq 0 sth_t_cmd_sign eq ac 4
    ret sth_cli_sign
  end
  sth_wr 2 sth_w_usage
  ret 1
end

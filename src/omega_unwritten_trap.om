note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_unwritten_trap.c (C3 unwritten-output detector).
note Host-only, zero GPU, zero C.
om2

const OMEGA_UNWRITTEN_BLOCK ulong 64

note Report fields stored in global g_uw_rep[0..7]:
note   0: count          (words equal to poison)
note   1: first          (index of first hit, valid if count > 0)
note   2: last           (index of last hit, valid if count > 0)
note   3: runs           (maximal contiguous runs of hits)
note   4: longest_run    (length of longest run)
note   5: full_blocks    (aligned blocks entirely poison)
note   6: partial_blocks (aligned blocks with some but not all poison)
note   7: whole_blocks   (1 if count > 0 and partial_blocks == 0, else 0)
note   8: tail           (1 if count > 0 and last == n-1 and count == n - first, else 0)
global g_uw_rep ulong 9
global g_uw_buf uint 16777179

fn omega_unwritten_scan n ulong poison uint block ulong to void
  for k ulong 9
    put g_uw_rep k 0
  end
  if eq block 0
    ret
  end
  run = ulong 0
  b = ulong 0
  while lt b n bound 300000
    bend = add b block
    if gt bend n
      bend = n
    end
    hits = ulong 0
    i = b
    while lt i bend bound 1024
      if eq get g_uw_buf i poison
        if eq get g_uw_rep 0 0
          put g_uw_rep 1 i
        end
        put g_uw_rep 2 i
        put g_uw_rep 0 add get g_uw_rep 0 1
        hits = add hits 1
        if eq run 0
          put g_uw_rep 3 add get g_uw_rep 3 1
        end
        run = add run 1
        if gt run get g_uw_rep 4
          put g_uw_rep 4 run
        end
      else
        run = 0
      end
      i = add i 1
    end
    if eq hits sub bend b
      put g_uw_rep 5 add get g_uw_rep 5 1
    else
      if gt hits 0
        put g_uw_rep 6 add get g_uw_rep 6 1
      end
    end
    b = add b block
  end
  cnt = get g_uw_rep 0
  if and gt cnt 0 eq get g_uw_rep 6 0
    put g_uw_rep 7 1
  end
  if and gt cnt 0 and eq get g_uw_rep 2 sub n 1 eq cnt sub n get g_uw_rep 1
    put g_uw_rep 8 1
  end
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor lane 4: structured 6-row verification report
note (replaces src/visor/visor_verify.c). Depends on visor.om, visor_semantic.om, visor_realization.om.

text vver_v_abs "object absent from graph"
text vver_v_str "structural validation failed"
text vver_v_typ "type validation failed"
text vver_v_rcd "REALIZATION_ID or code validation failed"
text vver_v_rid "REALIZATION_ID digest mismatch"
text vver_v_mch "machine profile mismatch"
text vver_v_pidx "invalid program index"
text vver_v_punr "program not realized"
text vver_v_pdig "program realization digest mismatch"
text vver_s_pass "PASS"
text vver_s_fail "FAIL"
text vver_s_nr "NOT_RUN"
text vver_f0 "STRUCTURAL      "
text vver_f1 "\nTYPE            "
text vver_f2 "\nINVARIANTS      "
text vver_f3 "\nREALIZATION     "
text vver_f4 "\nAUTHORITY       "
text vver_fa1 "  REQUIRED (never granted by Visor)"
text vver_fa0 "  NONE: pure object"
text vver_f5 "\nMACHINE         "
text vver_fv "\nVERDICT         "
text vver_fvp "PASS\n"
text vver_fvf "FAIL\nfirst violation: "
text vver_j1 "{\"passed\":"
text vver_j_t "true"
text vver_j_f "false"
text vver_j2 ",\"rows\":[{\"name\":\"STRUCTURAL\",\"status\":\""
text vver_j3 "\"},{\"name\":\"TYPE\",\"status\":\""
text vver_j4 "\"},{\"name\":\"INVARIANTS\",\"status\":\""
text vver_j5 "\"},{\"name\":\"REALIZATION\",\"status\":\""
text vver_j6 "\"},{\"name\":\"AUTHORITY\",\"status\":\""
text vver_ja1 "\",\"detail\":\"REQUIRED: effects/caps present\"},{\"name\":\"MACHINE\",\"status\":\""
text vver_ja0 "\",\"detail\":\"NONE: pure\"},{\"name\":\"MACHINE\",\"status\":\""
text vver_j7 "\"}],\"authority\":{\"required\":"
text vver_j8 ",\"effects\":"
text vver_j9 ",\"capability_refs\":"
text vver_j10 ",\"granted\":false},\"failure\":"
text vver_jnull "null}"
text vver_jend "}"

global vver_st ulong 6
global vver_chk ulong 6
global vver_fail ulong 6
global vver_passed ulong 1
global vver_auth_req ulong 1
global vver_eff_cnt ulong 1
global vver_cap_cnt ulong 1
global vver_viol uchar 256
global vver_vlen ulong 1

fn vver_set_viol s view uchar * to void
  if gt get vver_vlen 0 0
    ret
  end
  n = len s
  if gt n 255
    n = 255
  end
  for i ulong n bound 256
    put vver_viol i get s i
  end
  put vver_vlen 0 n
end

fn vver_reset to void
  for i ulong 6
    put vver_st i 2
    put vver_chk i 0
    put vver_fail i 0
  end
  put vver_passed 0 0
  put vver_auth_req 0 0
  put vver_eff_cnt 0 0
  put vver_cap_cnt 0 0
  put vver_vlen 0 0
end

fn vver_check_auth_walk idx ulong depth ulong to void
  if gt depth 16
    ret
  end
  if ge idx get v_og_cnt 0
    ret
  end
  k = get v_og_kind idx
  pb = mul idx V_MAX_PAYLOAD
  if eq k V_KIND_EFFECT
    put vver_auth_req 0 1
    put vver_eff_cnt 0 add get vver_eff_cnt 0 1
  end
  if eq k V_KIND_TYPE
    tag = v_dec_u32le_pay pb 0
    if or eq tag V_TY_CAP_REF or eq tag V_TY_EFF_INTENT_REF eq tag V_TY_EFF_RECEIPT_REF
      put vver_auth_req 0 1
      put vver_cap_cnt 0 add get vver_cap_cnt 0 1
    end
  end
  rc = get v_og_rcnt idx
  for r ulong rc bound 4
    rslot = add mul idx V_MAX_RELS r
    tb = mul rslot 32
    for i ulong 32
      put v_tmp_id i get v_og_rtgt add tb i
    end
    ti = og_find_by_tmp
    if ge ti 0
      vver_check_auth_walk ulong ti add depth 1
    end
  end
end

fn vver_verify_object idx long ridx long has_mach ulong to long
  vver_reset
  if or lt idx 0 ge ulong idx get v_og_cnt 0
    put vver_st 0 1
    put vver_chk 0 1
    put vver_fail 0 1
    vver_set_viol vver_v_abs
    put vver_passed 0 0
    ret 0
  end
  u = ulong idx
  ir = vsem_inspect u
  if or ne ir 0 gt get vsem_dangling 0 0
    put vver_st 0 1
    put vver_chk 0 1
    put vver_fail 0 1
    vver_set_viol vver_v_str
  else
    put vver_st 0 0
    put vver_chk 0 1
  end
  if eq ir 0
    put vver_st 1 0
    put vver_chk 1 1
  else
    put vver_st 1 1
    put vver_chk 1 1
    put vver_fail 1 1
    vver_set_viol vver_v_typ
  end
  put vver_st 2 0
  put vver_chk 2 4
  if ge ridx 0
    ru = ulong ridx
    if lt vrl_validate_pure ru 0
      put vver_st 3 1
      put vver_chk 3 1
      put vver_fail 3 1
      vver_set_viol vver_v_rcd
    else
      cl = get v_real_clen ru
      cb = mul ru 256
      rb = mul ru 32
      for i ulong cl bound 256
        put v_sha_in i get v_real_code add cb i
      end
      for i ulong 32
        put v_sha_in add cl i get v_real_sem_id add rb i
      end
      sha256_hash add cl 32
      rmatch = true
      for i ulong 32
        if ne get v_sha_out i get v_real_id add rb i
          rmatch = false
          break
        end
      end
      if not rmatch
        put vver_st 3 1
        put vver_chk 3 1
        put vver_fail 3 1
        vver_set_viol vver_v_rid
      else
        put vver_st 3 0
        put vver_chk 3 11
      end
    end
  else
    put vver_st 3 2
  end
  vver_check_auth_walk u 0
  put vver_st 4 0
  put vver_chk 4 1
  if and ge ridx 0 ne has_mach 0
    ru2 = ulong ridx
    if eq get v_real_prof ru2 get vmch_profile 0
      put vver_st 5 0
      put vver_chk 5 1
    else
      put vver_st 5 1
      put vver_chk 5 1
      put vver_fail 5 1
      vver_set_viol vver_v_mch
    end
  else
    put vver_st 5 2
  end
  any_fail = false
  for i ulong 6
    if eq get vver_st i 1
      any_fail = true
    end
  end
  if not any_fail
    put vver_passed 0 1
  end
  ret 0
end

fn vver_verify_program pidx ulong to long
  vver_reset
  if ge pidx get v_prog_cnt 0
    vver_set_viol vver_v_pidx
    ret -1
  end
  if eq get v_prog_realized pidx 0
    put vver_st 0 1
    put vver_chk 0 1
    put vver_fail 0 1
    vver_set_viol vver_v_punr
    ret 0
  end
  cl = get v_prog_clen pidx
  cb = mul pidx 256
  pb = mul pidx 32
  for i ulong cl bound 256
    put v_sha_in i get v_prog_code add cb i
  end
  sha256_hash cl
  rmatch = true
  for i ulong 32
    if ne get v_sha_out i get v_prog_real_id add pb i
      rmatch = false
      break
    end
  end
  if not rmatch
    put vver_st 0 1
    put vver_chk 0 1
    put vver_fail 0 1
    vver_set_viol vver_v_pdig
    ret 0
  end
  put vver_st 0 0
  put vver_chk 0 1
  put vver_st 1 0
  put vver_chk 1 1
  put vver_st 2 0
  put vver_chk 2 4
  put vver_st 3 2
  put vver_st 4 0
  put vver_chk 4 1
  put vver_st 5 2
  put vver_passed 0 1
  ret 0
end

fn vver_put_st st ulong to void
  if eq st 0
    ob_puts vver_s_pass
    ret
  end
  if eq st 1
    ob_puts vver_s_fail
    ret
  end
  ob_puts vver_s_nr
end

fn vver_format_text cap ulong to long
  ob_reset cap
  ob_puts vver_f0
  vver_put_st get vver_st 0
  ob_puts vver_f1
  vver_put_st get vver_st 1
  ob_puts vver_f2
  vver_put_st get vver_st 2
  ob_puts vver_f3
  vver_put_st get vver_st 3
  ob_puts vver_f4
  vver_put_st get vver_st 4
  if ne get vver_auth_req 0 0
    ob_puts vver_fa1
  else
    ob_puts vver_fa0
  end
  ob_puts vver_f5
  vver_put_st get vver_st 5
  ob_puts vver_fv
  if ne get vver_passed 0 0
    ob_puts vver_fvp
  else
    ob_puts vver_fvf
    vl = get vver_vlen 0
    for i ulong vl bound 256
      ob_putc get vver_viol i
    end
    ob_putc uchar 10
  end
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vver_format_json cap ulong to long
  ob_reset cap
  ob_puts vver_j1
  if ne get vver_passed 0 0
    ob_puts vver_j_t
  else
    ob_puts vver_j_f
  end
  ob_puts vver_j2
  vver_put_st get vver_st 0
  ob_puts vver_j3
  vver_put_st get vver_st 1
  ob_puts vver_j4
  vver_put_st get vver_st 2
  ob_puts vver_j5
  vver_put_st get vver_st 3
  ob_puts vver_j6
  vver_put_st get vver_st 4
  if ne get vver_auth_req 0 0
    ob_puts vver_ja1
  else
    ob_puts vver_ja0
  end
  vver_put_st get vver_st 5
  ob_puts vver_j7
  if ne get vver_auth_req 0 0
    ob_puts vver_j_t
  else
    ob_puts vver_j_f
  end
  ob_puts vver_j8
  ob_put_u64 get vver_eff_cnt 0
  ob_puts vver_j9
  ob_put_u64 get vver_cap_cnt 0
  ob_puts vver_j10
  if eq get vver_vlen 0 0
    ob_puts vver_jnull
  else
    vl = get vver_vlen 0
    for i ulong vl bound 256
      put v_sbuf i get vver_viol i
    end
    ob_put_json_sbuf vl
    ob_puts vver_jend
  end
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

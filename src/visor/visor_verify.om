note ---- VerifyReport (one tier run), string builder, validation error ----
global vver_vr_pass ulong 1
global vver_vr_cnt ulong 1
global vver_vr_fail ulong 1
global vver_vr_det uchar 512
global vver_vr_dl ulong 1
global vver_sb uchar 1024
global vver_sbl ulong 1
global vver_err uchar 256
global vver_el ulong 1
global vver_vec ulong 48
global vver_xout ulong 1
global vver_vu ulong 1
global vver_v1mm ulong 1

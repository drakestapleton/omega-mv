note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor lane 2: the console (replaces src/visor/visor_console.c).
note It only parses, classifies and prints; every view comes from a hook
note (visor_console_hooks.om). Link order: visor.om, visor_parse_command.om,
note visor_console_hooks.om, the ops, the vcon_hook_* dispatcher, this file.
note Output goes to fd 1 (out) and fd 2 (err), or, in capture mode, to one
note stream vcon_cap (the C test harness's shared memstream).

text vcon_prompt_tail "> "
text vcon_nul_echo "<line with NUL byte>\n"
text vcon_m_nul "NUL byte in line is not allowed"
text vcon_m_notw "not wired in this build"
text vcon_m_eff "EFFECT REQUEST: requires authority; routed via EffectIntent -> AEGIS/PHYSICS (not executed)"
text vcon_m_rsn "; reason: "
text vcon_m_failed "failed"
text vcon_m_unkid1 "unknown name or id '"
text vcon_m_nocmd1 "no such command '"
text vcon_m_q "'"
text vcon_m_unkcmd "unknown command"
text vcon_m_unksrc "unknown command or invalid source line: '"
text vcon_m_line "line too long ("
text vcon_m_line2 " bytes, max 4095)"
text vcon_cls_insp "inspection"
text vcon_cls_pure "pure-execution"
text vcon_cls_sim "simulation"
text vcon_cls_eff "effect-request"
text vcon_k_object "object"
text vcon_k_program "program"
text vcon_k_real "realization"
text vcon_k_none "none"
text vcon_t_bye "bye"
text vcon_t_jbye "\"bye\""
text vcon_t_clr "session cleared"
text vcon_t_jclr "\"session cleared\""
text vcon_t_nobind "(no bindings)\n"
text vcon_t_errpfx "error: "
text vcon_t_colsp ": "
text vcon_t_sep2 "  "
text vcon_t_null "null"
text vcon_j_c1 "{\"command\":"
text vcon_j_ok ",\"status\":\"ok\",\"class\":\""
text vcon_j_er ",\"status\":\"error\",\"class\":\""
text vcon_j_res "\",\"result\":"
text vcon_j_errnull ",\"error\":null}\n"
text vcon_j_err ",\"error\":"
text vcon_j_end "}\n"
text vcon_j_name "{\"name\":"
text vcon_j_kind ",\"kind\":\""
text vcon_j_id "\",\"id\":\""
text vcon_j_idend "\"}"
text vcon_j_value "{\"value\":"
text vcon_j_idk "\",\"id\":"
text vcon_j_hcmd "{\"command\":"
text vcon_j_husage ",\"usage\":"
text vcon_j_hclass ",\"class\":\""
text vcon_j_hmean "\",\"meaning\":"
text vcon_h_head "Omega Visor commands (classes: inspection, pure-execution, simulation, effect-request):\n"
text vcon_h_foot "Names: a session name, _ (last result), or a semantic id (64 hex, optional sha256: prefix).\n"
text vcon_u0 "help [command]"
text vcon_u1 "quit"
text vcon_u2 "inspect <x>"
text vcon_u3 "type <x>"
text vcon_u4 "id <x>"
text vcon_u5 "graph <x>"
text vcon_u6 "verify <x>"
text vcon_u7 "machine"
text vcon_u8 "realize <x> [for current.machine]"
text vcon_u9 "cost <x>"
text vcon_u10 "run <x> [args...]"
text vcon_u11 "evidence [name]"
text vcon_u12 "bindings"
text vcon_u13 "clear"
text vcon_u14 "world [cap]"
text vcon_u15 "effects [x]"
text vcon_u16 "alternatives <x>"
text vcon_u17 "compare <a> <b>"
text vcon_u18 "why <x>"
text vcon_u19 "let x: u64 = <expr> | fn .. | <expr>"
text vcon_n0 "list commands, or show one"
text vcon_n1 "leave the console"
text vcon_n2 "show the object a name or id refers to"
text vcon_n3 "show the type of an object"
text vcon_n4 "show the semantic id of a name, _ or hex id"
text vcon_n5 "show the semantic graph reachable from x"
text vcon_n6 "run the verification pipeline on x"
text vcon_n7 "show the current machine model"
text vcon_n8 "build machine code for x (does not run it)"
text vcon_n9 "estimate the cost of x"
text vcon_n10 "run x if pure; effects become an effect request"
text vcon_n11 "show recorded evidence receipts"
text vcon_n12 "list session names in the order they were made"
text vcon_n13 "forget all session names and objects"
text vcon_n14 "show the runtime world state (read only)"
text vcon_n15 "show effect objects as requests (never executed)"
text vcon_n16 "list other ways to realize x"
text vcon_n17 "compare two objects or realizations"
text vcon_n18 "explain where x came from"
text vcon_n19 "Omega source line, evaluated by the language"

const VCON_CAP_MAX ulong 8388608

global vcon_json ulong 1
global vcon_quit ulong 1
global vcon_last_st ulong 1
global vcon_err_cnt ulong 1
global vcon_capmode ulong 1
global vcon_cap uchar 8388608
global vcon_caplen ulong 1
global vk_buf uchar 65536
global vk_len ulong 1
global vk_fd ulong 1
global vcon_word uchar 256
global vcon_wlen ulong 1
global vcon_lb uchar 65536
note The last two bytes read of the current line (for the length a line longer than vcon_lb
note reports: the C parser strips one trailing LF, then one CR, before it counts).
global vcon_tl uchar 2
global vcon_rb uchar 65536

fn vcon_init is_json ulong to void
  put vcon_json 0 is_json
  put vcall_json 0 is_json
  put vcon_quit 0 0
  put vcon_last_st 0 0
  put vcon_err_cnt 0 0
  put vk_len 0 0
  put vk_fd 0 1
end

note Capture mode: out and err share vcon_cap (the C harness's memstream).
fn vcon_capture on ulong to void
  put vcon_capmode 0 on
  put vcon_caplen 0 0
end

fn vk_flush to void
  n = get vk_len 0
  if eq n 0
    ret
  end
  if ne get vcon_capmode 0 0
    c = get vcon_caplen 0
    k = n
    if gt add c k VCON_CAP_MAX
      k = sub VCON_CAP_MAX c
    end
    for i ulong k bound 65536
      put vcon_cap add c i get vk_buf i
    end
    put vcon_caplen 0 add c k
  else
    fd = int get vk_fd 0
    off = ulong 0
    while lt off n bound 65536
      w = write fd vk_buf off sub n off
      if le w 0
        break
      end
      off = add off ulong w
    end
  end
  put vk_len 0 0
end

note Select the stream (1 out, 2 err); keeps out/err ordered like the C fflush.
fn vk_sel fd ulong to void
  if ne fd get vk_fd 0
    vk_flush
    put vk_fd 0 fd
  end
end

fn vk_putc c uchar to void
  if ge get vk_len 0 65536
    vk_flush
  end
  n = get vk_len 0
  put vk_buf n c
  put vk_len 0 add n 1
end

fn vk_puts s view uchar * to void
  for i ulong len s bound 65536
    vk_putc get s i
  end
end

fn vk_put_ob to void
  for i ulong get v_ob_len 0 bound 65536
    vk_putc get v_ob i
  end
end

fn vk_put_body to void
  for i ulong get vcon_blen 0 bound 1048576
    vk_putc get vcon_body i
  end
end

fn vk_put_err to void
  for i ulong get vcon_elen 0 bound 512
    vk_putc get vcon_err i
  end
end

fn vk_json_byte c ulong to void
  if eq c 34
    vk_putc uchar 92
    vk_putc uchar 34
    ret
  end
  if eq c 92
    vk_putc uchar 92
    vk_putc uchar 92
    ret
  end
  if eq c 10
    vk_putc uchar 92
    vk_putc uchar 110
    ret
  end
  if eq c 13
    vk_putc uchar 92
    vk_putc uchar 114
    ret
  end
  if eq c 9
    vk_putc uchar 92
    vk_putc uchar 116
    ret
  end
  if or lt c 32 eq c 127
    vk_puts vt_u00
    vk_putc get vcon_hx shr c 4
    vk_putc get vcon_hx and c 15
    ret
  end
  vk_putc uchar c
end

fn vk_json_ob to void
  vk_putc uchar 34
  for i ulong get v_ob_len 0 bound 65536
    vk_json_byte ulong get v_ob i
  end
  vk_putc uchar 34
end

fn vk_json_err to void
  vk_putc uchar 34
  for i ulong get vcon_elen 0 bound 512
    vk_json_byte ulong get vcon_err i
  end
  vk_putc uchar 34
end

note Command name of cmd (visor_cmd_name) into v_ob.
fn vcon_name_ob cmd ulong to void
  ob_reset 65535
  vpc_put_cmd_name cmd
end

fn vcon_cls_txt_vk cls ulong to void
  if eq cls VCON_CL_PURE
    vk_puts vcon_cls_pure
    ret
  end
  if eq cls VCON_CL_SIM
    vk_puts vcon_cls_sim
    ret
  end
  if eq cls VCON_CL_EFF
    vk_puts vcon_cls_eff
    ret
  end
  vk_puts vcon_cls_insp
end

note VISOR_PROMPT "\xCE\xA9> " (U+03A9 OMEGA, then "> ").
fn vk_prompt to void
  vk_putc uchar 206
  vk_putc uchar 169
  vk_puts vcon_prompt_tail
end

fn vcon_cls_txt_vb cls ulong to void
  if eq cls VCON_CL_PURE
    vb_puts vcon_cls_pure
    ret
  end
  if eq cls VCON_CL_SIM
    vb_puts vcon_cls_sim
    ret
  end
  if eq cls VCON_CL_EFF
    vb_puts vcon_cls_eff
    ret
  end
  vb_puts vcon_cls_insp
end

note class_for: help-table class; EMPTY/UNKNOWN are inspection.
fn vcon_class_for cmd ulong to ulong
  if or or eq cmd 6 eq cmd 8 or eq cmd 10 eq cmd 19
    ret VCON_CL_PURE
  end
  if or eq cmd 9 or eq cmd 16 eq cmd 17
    ret VCON_CL_SIM
  end
  if eq cmd 15
    ret VCON_CL_EFF
  end
  ret VCON_CL_INSP
end

fn vcon_kind_vb kind ulong to void
  if eq kind V_BIND_OBJECT
    vb_puts vcon_k_object
    ret
  end
  if eq kind V_BIND_PROGRAM
    vb_puts vcon_k_program
    ret
  end
  if eq kind V_BIND_REALIZATION
    vb_puts vcon_k_real
    ret
  end
  vb_puts vcon_k_none
end

note emit_ok_tag: body is vcon_body (JSON value in JSON mode, text otherwise).
fn vcon_emit_ok cmd ulong cls ulong tag bool to long
  bl = get vcon_blen 0
  vk_sel 1
  if ne get vcon_json 0 0
    vk_puts vcon_j_c1
    vcon_name_ob cmd
    vk_json_ob
    vk_puts vcon_j_ok
    vcon_cls_txt_vk cls
    vk_puts vcon_j_res
    if gt bl 0
      vk_put_body
    else
      vk_puts vcon_t_null
    end
    vk_puts vcon_j_errnull
  else
    if and tag ne cls VCON_CL_INSP
      vk_putc uchar 91
      vcon_cls_txt_vk cls
      vk_putc uchar 93
      vk_putc uchar 10
    end
    if gt bl 0
      vk_put_body
      if ne get vcon_body sub bl 1 10
        vk_putc uchar 10
      end
    end
  end
  put vcon_last_st 0 0
  ret 0
end

fn vcon_starts_eff to bool
  el = get vcon_elen 0
  if lt el 14
    ret false
  end
  for i ulong 14
    if ne get vcon_err i get vcon_m_eff i
      ret false
    end
  end
  ret true
end

note emit_err_body: message in vcon_err ("failed" if empty); with_body prints vcon_body.
fn vcon_emit_err cmd ulong cls ulong with_body bool to long
  if eq get vcon_elen 0 0
    ve_puts vcon_m_failed
  end
  bl = get vcon_blen 0
  has_body = and with_body gt bl 0
  isj = ne get vcon_json 0 0
  vk_sel 1
  if and not isj has_body
    vk_put_body
    if ne get vcon_body sub bl 1 10
      vk_putc uchar 10
    end
  end
  if isj
    vk_puts vcon_j_c1
    vcon_name_ob cmd
    vk_json_ob
    vk_puts vcon_j_er
    vcon_cls_txt_vk cls
    vk_puts vcon_j_res
    if has_body
      vk_put_body
    else
      vk_puts vcon_t_null
    end
    vk_puts vcon_j_err
    vk_json_err
    vk_puts vcon_j_end
  else
    vk_sel 2
    if vcon_starts_eff
      vk_put_err
      vk_putc uchar 10
    else
      vk_puts vcon_t_errpfx
      vcon_name_ob cmd
      vk_put_ob
      vk_puts vcon_t_colsp
      vk_put_err
      vk_putc uchar 10
    end
  end
  put vcon_last_st 0 1
  put vcon_err_cnt 0 add get vcon_err_cnt 0 1
  ret 1
end

fn vcon_err_txt cmd ulong cls ulong s view uchar * to long
  ve_reset
  ve_puts s
  ret vcon_emit_err cmd cls false
end

fn vcon_unresolved cmd ulong cls ulong idx ulong to long
  ve_reset
  ve_puts vcon_m_unkid1
  ve_put_arg idx
  ve_puts vcon_m_q
  ret vcon_emit_err cmd cls false
end

note ---------- help ----------

fn vcon_usage_vb i ulong to void
  if lt i 10
    if lt i 5
      if eq i 0
        vb_puts vcon_u0
      end
      if eq i 1
        vb_puts vcon_u1
      end
      if eq i 2
        vb_puts vcon_u2
      end
      if eq i 3
        vb_puts vcon_u3
      end
      if eq i 4
        vb_puts vcon_u4
      end
      ret
    end
    if eq i 5
      vb_puts vcon_u5
    end
    if eq i 6
      vb_puts vcon_u6
    end
    if eq i 7
      vb_puts vcon_u7
    end
    if eq i 8
      vb_puts vcon_u8
    end
    if eq i 9
      vb_puts vcon_u9
    end
    ret
  end
  if lt i 15
    if eq i 10
      vb_puts vcon_u10
    end
    if eq i 11
      vb_puts vcon_u11
    end
    if eq i 12
      vb_puts vcon_u12
    end
    if eq i 13
      vb_puts vcon_u13
    end
    if eq i 14
      vb_puts vcon_u14
    end
    ret
  end
  if eq i 15
    vb_puts vcon_u15
  end
  if eq i 16
    vb_puts vcon_u16
  end
  if eq i 17
    vb_puts vcon_u17
  end
  if eq i 18
    vb_puts vcon_u18
  end
  if eq i 19
    vb_puts vcon_u19
  end
end

fn vcon_mean_vb i ulong to void
  if lt i 10
    if lt i 5
      if eq i 0
        vb_puts vcon_n0
      end
      if eq i 1
        vb_puts vcon_n1
      end
      if eq i 2
        vb_puts vcon_n2
      end
      if eq i 3
        vb_puts vcon_n3
      end
      if eq i 4
        vb_puts vcon_n4
      end
      ret
    end
    if eq i 5
      vb_puts vcon_n5
    end
    if eq i 6
      vb_puts vcon_n6
    end
    if eq i 7
      vb_puts vcon_n7
    end
    if eq i 8
      vb_puts vcon_n8
    end
    if eq i 9
      vb_puts vcon_n9
    end
    ret
  end
  if lt i 15
    if eq i 10
      vb_puts vcon_n10
    end
    if eq i 11
      vb_puts vcon_n11
    end
    if eq i 12
      vb_puts vcon_n12
    end
    if eq i 13
      vb_puts vcon_n13
    end
    if eq i 14
      vb_puts vcon_n14
    end
    ret
  end
  if eq i 15
    vb_puts vcon_n15
  end
  if eq i 16
    vb_puts vcon_n16
  end
  if eq i 17
    vb_puts vcon_n17
  end
  if eq i 18
    vb_puts vcon_n18
  end
  if eq i 19
    vb_puts vcon_n19
  end
end

note Pad the body with spaces from column start to width w ("%-Ns").
fn vcon_pad_vb start ulong w ulong to void
  used = sub get vcon_blen 0 start
  if lt used w
    for i ulong sub w used bound 64
      vb_putc uchar 32
    end
  end
end

fn vcon_help_row_human i ulong to void
  vb_puts vcon_t_sep2
  s0 = get vcon_blen 0
  vcon_usage_vb i
  vcon_pad_vb s0 36
  vb_putc uchar 32
  s1 = get vcon_blen 0
  vcon_cls_txt_vb vcon_class_for i
  vcon_pad_vb s1 15
  vb_putc uchar 32
  vcon_mean_vb i
  vb_putc uchar 10
end

note A help field as a JSON string: render it, then escape it in place.
fn vcon_json_field_vb start ulong to void
  e = get vcon_blen 0
  n = sub e start
  for i ulong n bound 256
    put vcon_word i get vcon_body add start i
  end
  put vcon_blen 0 start
  vb_putc uchar 34
  for i ulong n bound 256
    vb_json_byte ulong get vcon_word i
  end
  vb_putc uchar 34
end

fn vcon_help_row_json i ulong to void
  vb_puts vcon_j_hcmd
  vcon_name_ob i
  vb_json_ob
  vb_puts vcon_j_husage
  s0 = get vcon_blen 0
  vcon_usage_vb i
  vcon_json_field_vb s0
  vb_puts vcon_j_hclass
  vcon_cls_txt_vb vcon_class_for i
  vb_puts vcon_j_hmean
  s1 = get vcon_blen 0
  vcon_mean_vb i
  vcon_json_field_vb s1
  vb_putc uchar 125
end

note Is v_ob (a command name) equal to argument 0?
fn vcon_ob_is_arg0 to bool
  n = get v_ob_len 0
  if ne n get vpc_alen 0
    ret false
  end
  for i ulong n bound 256
    if ne get v_ob i get vpc_args i
      ret false
    end
  end
  ret true
end

fn vcon_cmd_help to long
  one = long -1
  if eq get vpc_argc 0 1
    for i ulong 20
      vcon_name_ob i
      if vcon_ob_is_arg0
        one = long i
        break
      end
    end
    if lt one 0
      ve_reset
      ve_puts vcon_m_nocmd1
      ve_put_arg 0
      ve_puts vcon_m_q
      ret vcon_emit_err 0 VCON_CL_INSP false
    end
  end
  vb_reset
  if ne get vcon_json 0 0
    vb_putc uchar 91
    k = ulong 0
    for i ulong 20
      if or lt one 0 eq one long i
        if gt k 0
          vb_putc uchar 44
        end
        k = add k 1
        vcon_help_row_json i
      end
    end
    vb_putc uchar 93
  else
    if ge one 0
      vcon_help_row_human ulong one
    else
      vb_puts vcon_h_head
      for i ulong 20
        vcon_help_row_human i
      end
      vb_puts vcon_h_foot
    end
  end
  ret vcon_emit_ok 0 VCON_CL_INSP true
end

note ---------- bindings / id ----------

fn vcon_bind_row slot ulong first bool to void
  ib = mul slot 32
  for i ulong 32
    put v_tmp_id i get v_bind_id add ib i
  end
  nb = mul slot 64
  nl = get v_bind_nlen slot
  if ne get vcon_json 0 0
    if not first
      vb_putc uchar 44
    end
    vb_puts vcon_j_name
    vb_putc uchar 34
    for j ulong nl bound 64
      vb_json_byte ulong get v_bind_name add nb j
    end
    vb_putc uchar 34
    vb_puts vcon_j_kind
    vcon_kind_vb get v_bind_kind slot
    vb_puts vcon_j_id
    vb_put_id_tmp
    vb_puts vcon_j_idend
  else
    for j ulong nl bound 64
      vb_putc get v_bind_name add nb j
    end
    vb_puts vcon_t_sep2
    vcon_kind_vb get v_bind_kind slot
    vb_puts vcon_t_sep2
    vb_put_id_tmp
    vb_putc uchar 10
  end
end

fn vcon_last_row first bool to void
  for i ulong 32
    put v_tmp_id i get v_last_id i
  end
  if ne get vcon_json 0 0
    if not first
      vb_putc uchar 44
    end
    vb_puts vcon_j_name
    vb_putc uchar 34
    vb_putc uchar 95
    vb_putc uchar 34
    vb_puts vcon_j_kind
    vcon_kind_vb get v_last_kind 0
    vb_puts vcon_j_id
    vb_put_id_tmp
    vb_puts vcon_j_idend
  else
    vb_putc uchar 95
    vb_puts vcon_t_sep2
    vcon_kind_vb get v_last_kind 0
    vb_puts vcon_t_sep2
    vb_put_id_tmp
    vb_putc uchar 10
  end
end

fn vcon_cmd_bindings to long
  vb_reset
  isj = ne get vcon_json 0 0
  if isj
    vb_putc uchar 91
  end
  shown = ulong 0
  for i ulong get v_bind_cnt 0 bound 64
    vcon_bind_row i eq shown 0
    shown = add shown 1
  end
  if ne get v_has_last 0 0
    vcon_last_row eq shown 0
    shown = add shown 1
  end
  if isj
    vb_putc uchar 93
  else
    if eq shown 0
      vb_puts vcon_t_nobind
    end
  end
  ret vcon_emit_ok 12 VCON_CL_INSP true
end

fn vcon_cmd_id to long
  if lt vcall_resolve_arg 0 0
    ret vcon_unresolved 4 VCON_CL_INSP 0
  end
  for i ulong 32
    put v_tmp_id i get v_res_id i
  end
  vb_reset
  if ne get vcon_json 0 0
    vb_puts vcon_j_name
    vb_putc uchar 34
    for i ulong get vpc_alen 0 bound 256
      vb_json_byte ulong get vpc_args i
    end
    vb_putc uchar 34
    vb_puts vcon_j_kind
    vcon_kind_vb get v_res_kind 0
    vb_puts vcon_j_id
    vb_put_id_tmp
    vb_puts vcon_j_idend
  else
    vb_put_id_tmp
    vb_putc uchar 10
  end
  ret vcon_emit_ok 4 VCON_CL_INSP true
end

note ---------- hook dispatch ----------

fn vcon_call_view cmd ulong cls ulong hid ulong to long
  if not vcon_hook_wired hid
    ret vcon_err_txt cmd cls vcon_m_notw
  end
  vb_reset
  ve_reset
  rc = vcon_hook_call hid
  if eq rc 0
    ret vcon_emit_ok cmd cls true
  end
  if eq rc 2
    ret vcon_emit_err cmd cls true
  end
  ret vcon_emit_err cmd cls false
end

fn vcon_no_subjects to void
  put vcall_has_a 0 0
  put vcall_has_b 0 0
end

fn vcon_subject_view cmd ulong hid ulong to long
  cls = vcon_class_for cmd
  if not vcon_hook_wired hid
    ret vcon_err_txt cmd cls vcon_m_notw
  end
  vcon_no_subjects
  if gt get vpc_argc 0 0
    if lt vcall_resolve_arg 0 0
      ret vcon_unresolved cmd cls 0
    end
    vcall_take_a
  end
  if eq cmd 17
    if gt get vpc_argc 0 1
      if lt vcall_resolve_arg 1 0
        ret vcon_unresolved cmd cls 1
      end
      vcall_take_b
    end
  end
  ret vcon_call_view cmd cls hid
end

fn vcon_cmd_run to long
  if not vcon_hook_wired VCON_HK_CLASSIFY
    ret vcon_err_txt 10 VCON_CL_PURE vcon_m_notw
  end
  vcon_no_subjects
  if lt vcall_resolve_arg 0 0
    ret vcon_unresolved 10 VCON_CL_PURE 0
  end
  vcall_take_a
  put vcall_cls 0 VCON_CL_EFF
  vr_reset
  ve_reset
  if ne vcon_hook_classify 0
    ret vcon_emit_err 10 VCON_CL_PURE false
  end
  if ne get vcall_cls 0 VCON_CL_PURE
    ve_reset
    ve_puts vcon_m_eff
    rl = get vcon_rlen 0
    if gt rl 0
      ve_puts vcon_m_rsn
      for i ulong rl bound 256
        ve_putc get vcon_rsn i
      end
    end
    ret vcon_emit_err 10 VCON_CL_EFF false
  end
  ret vcon_call_view 10 VCON_CL_PURE VCON_HK_RUN
end

fn vcon_alpha c ulong to bool
  ret or and ge c 65 le c 90 and ge c 97 le c 122
end

fn vcon_alnum_ c ulong to bool
  ret or or vcon_alpha c and ge c 48 le c 57 eq c 95
end

note looks_like_command on vpc_line: "<word> <word-or-_>...", not let/fn. Word into vcon_word.
fn vcon_looks_like_command to bool
  ll = get vpc_llen 0
  if eq ll 0
    ret false
  end
  c0 = ulong get vpc_line 0
  if not or vcon_alpha c0 eq c0 95
    ret false
  end
  i = ulong 0
  while lt i ll bound 4096
    if not vcon_alnum_ ulong get vpc_line i
      break
    end
    i = add i 1
  end
  if ge i ll
    ret false
  end
  ci = ulong get vpc_line i
  if and ne ci 32 ne ci 9
    ret false
  end
  if eq i 3
    if and and eq get vpc_line 0 108 eq get vpc_line 1 101 eq get vpc_line 2 116
      ret false
    end
  end
  if eq i 2
    if and eq get vpc_line 0 102 eq get vpc_line 1 110
      ret false
    end
  end
  j = i
  while lt j ll bound 4096
    cj = ulong get vpc_line j
    if and ne cj 32 ne cj 9
      break
    end
    j = add j 1
  end
  if ge j ll
    ret false
  end
  if not vcon_alnum_ ulong get vpc_line j
    ret false
  end
  wl = i
  if gt wl 255
    wl = 255
  end
  for k ulong wl bound 256
    put vcon_word k get vpc_line k
  end
  put vcon_wlen 0 wl
  ret true
end

fn vcon_cmd_source to long
  if not vcon_hook_wired VCON_HK_EVAL
    ret vcon_err_txt 19 VCON_CL_PURE vcon_m_notw
  end
  put vcall_ev_kind 0 V_BIND_NONE
  put vcall_ev_idx 0 -1
  for i ulong 32
    put vcall_ev_id i uchar 0
  end
  vv_reset
  ve_reset
  if ne vcon_hook_eval 0
    if vcon_looks_like_command
      ve_reset
      ve_puts vcon_m_unksrc
      for i ulong get vcon_wlen 0 bound 256
        ve_putc get vcon_word i
      end
      ve_puts vcon_m_q
      ret vcon_emit_err 21 VCON_CL_PURE false
    end
    ret vcon_emit_err 19 VCON_CL_PURE false
  end
  kind = get vcall_ev_kind 0
  has = ne kind V_BIND_NONE
  for i ulong 32
    put v_tmp_id i get vcall_ev_id i
  end
  if has
    vs_set_last kind get vcall_ev_idx 0
  end
  vl = get vcon_vlen 0
  vb_reset
  if ne get vcon_json 0 0
    vb_puts vcon_j_value
    vb_putc uchar 34
    for i ulong vl bound 1024
      vb_json_byte ulong get vcon_val i
    end
    vb_putc uchar 34
    vb_puts vcon_j_kind
    vcon_kind_vb kind
    vb_puts vcon_j_idk
    if has
      vb_putc uchar 34
      vb_put_id_tmp
      vb_puts vcon_j_idend
    else
      vb_puts vcon_t_null
      vb_putc uchar 125
    end
  else
    if gt vl 0
      for i ulong vl bound 1024
        vb_putc get vcon_val i
      end
      vb_putc uchar 10
    else
      if has
        vb_put_id_tmp
        vb_putc uchar 10
      end
    end
  end
  ret vcon_emit_ok 19 VCON_CL_PURE false
end

fn vcon_body_txt s view uchar * to void
  vb_reset
  vb_puts s
end

fn vcon_dispatch to long
  cmd = get vpc_cmd 0
  if eq cmd 20
    put vcon_last_st 0 0
    ret 0
  end
  if eq cmd 0
    ret vcon_cmd_help
  end
  isj = ne get vcon_json 0 0
  if eq cmd 1
    put vcon_quit 0 1
    if isj
      vcon_body_txt vcon_t_jbye
    else
      vcon_body_txt vcon_t_bye
    end
    ret vcon_emit_ok 1 VCON_CL_INSP true
  end
  if eq cmd 12
    ret vcon_cmd_bindings
  end
  if eq cmd 13
    vs_clear
    if isj
      vcon_body_txt vcon_t_jclr
    else
      vcon_body_txt vcon_t_clr
    end
    ret vcon_emit_ok 13 VCON_CL_INSP true
  end
  if eq cmd 4
    if vcon_hook_wired VCON_HK_ID
      ret vcon_subject_view 4 VCON_HK_ID
    end
    ret vcon_cmd_id
  end
  if eq cmd 2
    ret vcon_subject_view 2 VCON_HK_INSPECT
  end
  if eq cmd 3
    ret vcon_subject_view 3 VCON_HK_TYPE
  end
  if eq cmd 5
    ret vcon_subject_view 5 VCON_HK_GRAPH
  end
  if eq cmd 6
    ret vcon_subject_view 6 VCON_HK_VERIFY
  end
  if eq cmd 8
    ret vcon_subject_view 8 VCON_HK_REALIZE
  end
  if eq cmd 9
    ret vcon_subject_view 9 VCON_HK_COST
  end
  if eq cmd 16
    ret vcon_subject_view 16 VCON_HK_ALT
  end
  if eq cmd 17
    ret vcon_subject_view 17 VCON_HK_COMPARE
  end
  if eq cmd 18
    ret vcon_subject_view 18 VCON_HK_WHY
  end
  if eq cmd 7
    vcon_no_subjects
    ret vcon_call_view 7 VCON_CL_INSP VCON_HK_MACHINE
  end
  if eq cmd 11
    vcon_no_subjects
    ret vcon_call_view 11 VCON_CL_INSP VCON_HK_EVIDENCE
  end
  if eq cmd 14
    vcon_no_subjects
    ret vcon_call_view 14 VCON_CL_INSP VCON_HK_WORLD
  end
  if eq cmd 15
    ret vcon_subject_view 15 VCON_HK_EFFECTS
  end
  if eq cmd 10
    ret vcon_cmd_run
  end
  if eq cmd 19
    ret vcon_cmd_source
  end
  ret vcon_err_txt 21 VCON_CL_INSP vcon_m_unkcmd
end

note visor_console_exec_line on vpc_in[0..rlen) (a line of any length up to 65536).
fn vcon_exec_in rlen ulong to long
  rc = long 0
  if lt vpc_parse_in rlen 0
    ve_reset
    for i ulong get vpc_elen 0 bound 512
      ve_putc get vpc_err i
    end
    cmd = get vpc_cmd 0
    rc = vcon_emit_err cmd vcon_class_for cmd false
  else
    rc = vcon_dispatch
  end
  vk_flush
  ret rc
end

fn vcon_exec_sbuf rlen ulong to long
  for i ulong rlen bound 4096
    put vpc_in i get v_sbuf i
  end
  ret vcon_exec_in rlen
end

note line_is_empty on vcon_lb[0..n).
fn vcon_line_empty n ulong to bool
  p = ulong 0
  while lt p n bound 65536
    c = get vcon_lb p
    if and ne c 32 ne c 9
      break
    end
    p = add p 1
  end
  if ge p n
    ret true
  end
  c = get vcon_lb p
  ret or or eq c 10 eq c 13 eq c 35
end

note One getline() line in vcon_lb[0..n) (n is the true length; bytes past 65536
note are not kept). has_nul: the line held a NUL byte.
fn vcon_line n ulong has_nul bool echo bool to long
  if has_nul
    if echo
      vk_sel 1
      vk_prompt
      vk_puts vcon_nul_echo
    end
    ve_reset
    ve_puts vcon_m_nul
    u = vcon_emit_err 21 VCON_CL_INSP false
    vk_flush
    ret u
  end
  kept = n
  if gt kept 65536
    kept = 65536
  end
  if vcon_line_empty kept
    ret 0
  end
  if echo
    l = kept
    while gt l 0 bound 65536
      c = get vcon_lb sub l 1
      if and ne c 10 ne c 13
        break
      end
      l = sub l 1
    end
    vk_sel 1
    vk_prompt
    for i ulong l bound 65536
      vk_putc get vcon_lb i
    end
    vk_putc uchar 10
  end
  if gt n 65536
    m = n
    t1 = get vcon_tl 1
    if eq t1 10
      m = sub m 1
      if eq get vcon_tl 0 13
        m = sub m 1
      end
    else
      if eq t1 13
        m = sub m 1
      end
    end
    ve_reset
    ve_puts vcon_m_line
    ve_put_u64 m
    ve_puts vcon_m_line2
    u = vcon_emit_err 21 VCON_CL_INSP false
    vk_flush
    ret u
  end
  for i ulong n bound 65536
    put vpc_in i get vcon_lb i
  end
  ret vcon_exec_in n
end

note run_loop(c, in, echo, prompt) over descriptor fd; returns any_err.
fn vcon_run_fd fd int echo bool prompt bool to long
  any = long 0
  n = ulong 0
  nul = false
  done = false
  if prompt
    vk_sel 1
    vk_prompt
    vk_flush
  end
  while not done bound 1000000000
    k = read fd vcon_rb 0 65536
    if le k 0
      if gt n 0
        if ne vcon_line n nul echo 0
          any = 1
        end
        if ne get vcon_quit 0 0
          break
        end
        if prompt
          vk_sel 1
          vk_prompt
        end
      end
      if prompt
        vk_sel 1
        vk_putc uchar 10
      end
      break
    end
    kn = ulong k
    i = ulong 0
    while lt i kn bound 65536
      b = get vcon_rb i
      put vcon_tl 0 get vcon_tl 1
      put vcon_tl 1 b
      if lt n 65536
        put vcon_lb n b
      end
      n = add n 1
      if eq b 0
        nul = true
      end
      if eq b 10
        if ne vcon_line n nul echo 0
          any = 1
        end
        n = 0
        nul = false
        if ne get vcon_quit 0 0
          done = true
          break
        end
        if prompt
          vk_sel 1
          vk_prompt
          vk_flush
        end
      end
      i = add i 1
    end
  end
  vk_flush
  ret any
end

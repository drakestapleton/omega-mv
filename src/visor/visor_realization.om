fn vrl_diff_set to void
  n = get vsb_n 0
  if gt n 159
    n = 159
  end
  for i ulong n bound 160
    put vrl_diff i get vsb_b i
  end
  put vrl_dfl 0 n
end

fn vsb_diff m ulong to void
  n = get vrl_dfl 0
  if gt n m
    n = m
  end
  for i ulong n bound 160
    vsb_c ulong get vrl_diff i
  end
end

fn vrl_kdiff i ulong to ulong
  if eq i 0
    ret 0
  end
  if eq i 1
    ret 1
  end
  if eq i 2
    ret 2
  end
  if eq i 3
    ret 5
  end
  if eq i 4
    ret 10
  end
  if eq i 5
    ret 50
  end
  if eq i 6
    ret 100
  end
  ret 4294967295
end

note cross-check of synth (entry e) against the direct realization of p; 1 match, 0 not
fn vrl_cross p ulong e ulong to ulong
  vpg_copy VPG_TMP p
  if ne vpg_realize_ex VPG_TMP 0 0
    vsb_reset
    vsb_t vrl_x_nod
    vrl_diff_set
    ret 0
  end
  vsb_reset
  vsb_t vrl_x_match1
  vsb_u 8
  vsb_t vrl_x_match2
  vrl_diff_set
  for i ulong 8
    x = vrl_kdiff i
    yd = ulong 0
    ys = ulong 0
    ok = false
    if eq vrl_exec VPG_TMP x 0 0 0
      yd = get vrl_out 0
      if eq vrl_exec vre_r e x 0 0 0
        ys = get vrl_out 0
        ok = eq yd ys
      end
    end
    if not ok
      vsb_reset
      vsb_t vrl_x_mm1
      vsb_u x
      vsb_t vrl_x_mm2
      vsb_u yd
      vsb_t vrl_x_mm3
      vsb_u ys
      vrl_diff_set
      ret 0
    end
  end
  ret 1
end

fn vrl_synth_refused e ulong m ulong v ulong rc long to void
  vsb_reset
  vsb_t vrl_x_ref1
  vsb_i rc
  vsb_t vrl_x_ref2
  vsb_swhy 96
  vre_verdict e 0
  u = vrl_view e m v
  vrv_p v VW_COMPAT 0
  vrv_p v VW_RUN 0
  vsb_reset
  vsb_t vrl_x_sref
  vsb_i rc
  vsb_t vrl_x_ref2
  vsb_swhy 160
  vrv_set v VF_WHY
  if lt u -999
    ret
  end
end

fn vrl_synth_why v ulong rc long to void
  vsb_reset
  vsb_t vrl_x_c1
  if eq get vrl_sr 4 1
    vsb_t vrl_x_pre
  else
    vsb_t vrl_x_seq
  end
  vsb_t vrl_x_c2
  vsb_u ulong get vrl_sr 6
  vsb_t vrl_x_c3
  vsb_diff 60
  vsb_t vrl_x_c4
  vsb_i rc
  vrv_set v VF_WHY
end

fn vrl_synth_verdict e ulong match ulong rc long to void
  if eq match 1
    vre_verdict e 1
    ret
  end
  vsb_reset
  vsb_t vrl_x_s1
  vsb_i rc
  vsb_t vrl_x_s2
  vsb_u ulong get vrl_sr 7
  vsb_t vrl_x_s3
  vsb_diff 40
  vsb_t vrl_x_s3
  vsb_swhy 60
  vre_verdict e 0
end

note synth_alt(p, m, tname, e, v)
fn vrl_synth_alt p ulong m ulong tname view uchar * e ulong v ulong to void
  vre_zero e
  vre_subj_from_prog e p
  vre_p e VE_SUBJP 1
  put vre_pidx e -1
  vre_set_tn e tname
  rc = vrl_synth p m
  if eq vro_g VRO_TMP2 VRO_CLEN 0
    vrl_synth_refused e m v rc
    ret
  end
  vro_copy vre_r e VRO_TMP2
  vre_mach_from_mg e m
  vre_p e VE_EST ulong get vrl_sr 5
  vre_p e VE_HASEST 1
  match = vrl_cross p e
  if or ne rc 0 eq get vrl_sr 7 0
    match = 0
  end
  vrl_synth_verdict e match rc
  u = vrl_view e m v
  vrv_p v VW_COMPAT and vrv_g v VW_COMPAT match
  vrv_p v VW_RUN and vrv_g v VW_RUN match
  vrl_synth_why v rc
  if lt u -999
    ret
  end
end

note machine_target_name(mg) as a text choice: 0 aarch64-v8a, 1 dgx-spark, 2 qemu-virt
fn vrl_target_kind mg ulong to ulong
  if eq mg VRL_NOMG
    ret 0
  end
  u = vmch_build_spark VRL_MG_SC
  if vmch_id_eq VRL_MG_SC mg
    ret 1
  end
  u = vmch_build_qemu VRL_MG_SC
  if vmch_id_eq VRL_MG_SC mg
    ret 2
  end
  if lt u -999
    ret 0
  end
  ret 0
end

fn vsb_target_kind k ulong to void
  if eq k 1
    vsb_t vrl_t_dgx
    ret
  end
  if eq k 2
    vsb_t vrl_t_qemu
    ret
  end
  vsb_t vrl_t_a64
end

fn vrl_alt_label v ulong pre view uchar * k ulong to void
  vsb_reset
  vsb_t pre
  vsb_target_kind k
  vrv_set v VF_LABEL
end

fn vrl_alt_synth p ulong m ulong k ulong e ulong v ulong to void
  if eq k 1
    vrl_synth_alt p m vrl_t_dgx e v
  else
    if eq k 2
      vrl_synth_alt p m vrl_t_qemu e v
    else
      vrl_synth_alt p m vrl_t_a64 e v
    end
  end
  vrl_alt_label v vrl_x_synth k
end

fn vrl_alt_direct p ulong m ulong k ulong e ulong v ulong to void
  if ne vrl_realize_program p m e v 0
    vsb_reset
    vsb_t vrl_x_dfail
    vre_verdict e 0
    vrv_p v VW_COMPAT 0
    vrv_p v VW_RUN 0
  end
  vre_set_tn e vrl_t_a64
  vrl_alt_label v vrl_x_direct k
end


fn vrl_alt_one p ulong mg ulong k ulong n ulong to void
  e = VRL_ETMP
  if ne get vrl_alt 2 VRL_NOMG
    e = add get vrl_alt 2 n
  end
  v = add get vrl_alt 3 n
  m = mg
  tk = get vrl_alt 0
  if eq rem k 2 1
    m = VRL_MG_OT
    tk = get vrl_alt 1
  end
  if lt k 2
    vrl_alt_direct p m tk e v
  else
    vrl_alt_synth p m tk e v
  end
end

note visor_realization_alternatives_ex(p, mg, entries from e0 (VRL_NOMG: none), views from v0, max):
note 0 with the count in vrl_cnt
fn vrl_alternatives_ex p ulong mg ulong e0 ulong v0 ulong max ulong to long
  put vrl_cnt 0 0
  if eq mg VRL_NOMG
    ret -1
  end
  u = vmch_build_spark VRL_MG_SP
  if vmch_id_eq VRL_MG_SP mg
    u = vmch_build_qemu VRL_MG_OT
  else
    vmch_graph_copy VRL_MG_OT VRL_MG_SP
  end
  put vrl_alt 0 vrl_target_kind mg
  put vrl_alt 1 vrl_target_kind VRL_MG_OT
  put vrl_alt 2 e0
  put vrl_alt 3 v0
  n = ulong 0
  for k ulong 4
    if ge n max
      break
    end
    vrl_alt_one p mg k n
    n = add n 1
  end
  put vrl_cnt 0 n
  if lt u -999
    ret -1
  end
  ret 0
end


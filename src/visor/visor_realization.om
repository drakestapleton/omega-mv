fn vsb_vro_id r ulong k ulong to void
  vsb_t vpg_t_sha
  b = vro_ib r k
  for i ulong 32
    vsb_x ulong get vro_id add b i 2
  end
end

fn vsb_vre_id e ulong k ulong to void
  vsb_t vpg_t_sha
  b = vre_ib e k
  for i ulong 32
    vsb_x ulong get vre_ids add b i 2
  end
end

fn vrl_view_ids e ulong mg ulong v ulong to void
  r = vre_r e
  vsb_reset
  if eq vro_g r VRO_HASID 1
    vsb_vro_id r VRO_K_RID
  else
    vsb_t vrl_t_none
  end
  vrv_set v VF_RID
  vsb_reset
  vsb_vre_id e 0
  vrv_set v VF_SID
  vsb_reset
  if vro_id_zero r VRO_K_SEM
    vsb_t vrl_t_none
  else
    vsb_vro_id r VRO_K_SEM
  end
  vrv_set v VF_ZID
  vsb_reset
  if eq vre_g e VE_HASEM 1
    vsb_vre_id e 1
  else
    vsb_t vrl_t_none
  end
  vrv_set v VF_MID
  vsb_reset
  if eq vro_g r VRO_HASM 1
    vsb_vro_id r VRO_K_MACH
  else
    vsb_t vrl_t_none
  end
  vrv_set v VF_BID
  vsb_reset
  if eq mg VRL_NOMG
    vsb_t vrl_t_none
  else
    vsb_mname mg 63
  end
  vrv_set v VF_MNAME
  vsb_reset
  vsb_tn_e e 31
  vrv_set v VF_TARGET
end

note the why line; bind in vrl_sr 0 (0 none, 1 ==, 2 !=), profile_ok vrl_sr 1, verdict_ok vrl_sr 2
fn vrl_view_why e ulong mg ulong v ulong to void
  pr = vro_g vre_r e VRO_PROF
  vsb_reset
  vsb_t vrl_v_p1
  vsb_x pr 2
  if eq mg VRL_NOMG
    vsb_t vrl_v_nomg
  else
    vsb_t vrl_v_p2
    vsb_x vrl_mg_prof mg 2
    if eq get vrl_sr 1 1
      vsb_t vrl_v_match
    else
      vsb_t vrl_v_mis
    end
  end
  bd = get vrl_sr 0
  if eq bd 0
    vsb_t vrl_v_nob
  end
  if eq bd 1
    vsb_t vrl_v_beq
  end
  if eq bd 2
    vsb_t vrl_v_bne
  end
  vsb_t vrl_v_run
  if eq vrv_g v VW_RUN 1
    vsb_t vrl_v_allowed
  else
    vsb_t vrl_v_refused
  end
  if eq get vrl_sr 2 0
    n0 = get vsb_n 0
    vsb_t vrl_v_inc
    vsb_ir e 127
    if gt sub get vsb_n 0 n0 191
      put vsb_n 0 add n0 191
    end
  end
  vrv_set v VF_WHY
end

note visor_realization_view(e, mg, v): 0
fn vrl_view e ulong mg ulong v ulong to long
  vrv_zero v
  r = vre_r e
  vrl_view_ids e mg v
  n = vro_g r VRO_CLEN
  vrv_p v VW_PROF vro_g r VRO_PROF
  vrv_p v VW_CLEN n
  vrv_p v VW_INSN div n 4
  vrl_disasm v r
  pok = ulong 0
  if ne mg VRL_NOMG
    if eq vro_g r VRO_PROF vrl_mg_prof mg
      pok = 1
    end
  end
  bok = ulong 1
  bd = long 0
  if eq vro_g r VRO_HASM 1
    bok = 0
    bd = 2
    if ne mg VRL_NOMG
      if vro_id_is_mg r VRO_K_MACH mg
        bok = 1
        bd = 1
      end
    end
  end
  nbw = ulong 1
  if vre_tn_is e vrl_t_bw
    nbw = 0
  end
  vok = ulong 1
  if and eq vre_g e VE_VK 1 eq vre_g e VE_COMPAT 0
    vok = 0
  end
  vrv_p v VW_COMPAT and and pok bok and nbw vok
  run = ulong 0
  if eq vok 1
    if eq vrl_run_check e 0
      run = 1
    end
  end
  vrv_p v VW_RUN run
  put vrl_sr 0 bd
  put vrl_sr 1 long pok
  put vrl_sr 2 long vok
  vrl_view_why e mg v
  ret vrl_cost e mg v
end

note ---- realize ----
fn vrl_entry_base e ulong mg ulong to void
  if eq mg VRL_NOMG
    ret
  end
  vre_mach_from_mg e mg
  r = vre_r e
  if gt vro_g r VRO_CLEN 0
    vre_p e VE_EST vrl_latency mg r
    vre_p e VE_HASEST 1
  end
end

note fail_view(v, vsb): -2
fn vrl_fail_view v ulong to long
  vrv_zero v
  vrv_set v VF_WHY
  vrv_txt v VF_RID vrl_t_none
  vrv_txt v VF_SID vrl_t_none
  vrv_txt v VF_ZID vrl_t_none
  vrv_txt v VF_MID vrl_t_none
  vrv_txt v VF_BID vrl_t_none
  vrv_txt v VF_MNAME vrl_t_none
  vrv_txt v VF_TARGET vrl_t_none
  vrl_cost_clear v
  for i ulong 4
    vrv_txt v add VF_SRC i vrl_c_notr
  end
  ret -2
end

fn vrl_fail_txt v ulong t view uchar * to long
  vsb_reset
  vsb_t t
  ret vrl_fail_view v
end


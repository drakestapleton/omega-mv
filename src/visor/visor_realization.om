fn vrl_swhy_set to void
  n = get vsb_n 0
  if gt n 191
    n = 191
  end
  for i ulong n bound 192
    put vrl_swhy i get vsb_b i
  end
  put vrl_swl 0 n
end

fn vrl_swhy_txt t view uchar * to long
  vsb_reset
  vsb_t t
  vrl_swhy_set
  ret -1
end

fn vsb_swhy m ulong to void
  n = get vrl_swl 0
  if gt n m
    n = m
  end
  for i ulong n bound 192
    vsb_c ulong get vrl_swhy i
  end
end

fn vrl_rng to ulong
  x = get vrl_cnt 0
  x = xor x shr x 12
  x = xor x shl x 25
  x = xor x shr x 27
  put vrl_cnt 0 x
  ret mul x 2685821657736338717
end

note omega_realize_differential_inputs(p) into vrl_xs (84)
fn vrl_diff_inputs p ulong to void
  w = vpg_g p VPG_IW
  m = ulong 18446744073709551615
  top = ulong 9223372036854775808
  if and lt w 64 ne w 0
    m = sub shl 1 w 1
    top = shl 1 sub w 1
  end
  put vrl_xs 0 0
  put vrl_xs 1 1
  put vrl_xs 2 2
  put vrl_xs 3 3
  put vrl_xs 4 5
  put vrl_xs 5 7
  put vrl_xs 6 10
  put vrl_xs 7 100
  put vrl_xs 8 m
  put vrl_xs 9 sub m 1
  put vrl_xs 10 sub m 2
  put vrl_xs 11 top
  put vrl_xs 12 sub top 1
  put vrl_xs 13 add top 1
  put vrl_xs 14 0x5555555555555555
  put vrl_xs 15 12297829382473034410
  put vrl_xs 16 65535
  put vrl_xs 17 0x10000
  put vrl_xs 18 4294967295
  put vrl_xs 19 0x100000000
  for i ulong 20
    put vrl_xs i and get vrl_xs i m
  end
  s = ulong 11400714819323198485
  pb = vpg_ib p 0
  for i ulong 8
    s = xor s shl ulong get vpg_ids add pb i mul 8 i
  end
  if eq s 0
    s = 1
  end
  put vrl_cnt 0 s
  for k ulong 64
    put vrl_xs add 20 k and vrl_rng m
  end
end

fn vrl_verify_ids p ulong m ulong r ulong to long
  if not vro_id_is_prog r VRO_K_SEM p
    ret vrl_swhy_txt vrl_s_sem
  end
  vmch_graph_copy VRL_MG_SC m
  u = vmch_compute_id VRL_MG_SC
  if not vmch_id_eq VRL_MG_SC m
    ret vrl_swhy_txt vrl_s_mid
  end
  if lt u -999
    ret -1
  end
  if eq vro_g r VRO_HASM 0
    ret vrl_swhy_txt vrl_s_mach
  end
  if not vro_id_is_mg r VRO_K_MACH m
    ret vrl_swhy_txt vrl_s_mach
  end
  if ne vro_g r VRO_PROF vrl_mg_prof m
    ret vrl_swhy_txt vrl_s_prd
  end
  if ne vro_v0 r 0
    vsb_reset
    vsb_why 200
    vrl_swhy_set
    ret -1
  end
  ret 0
end

fn vrl_verify_diff p ulong r ulong to long
  vrl_diff_inputs p
  for i ulong 84
    if ne vpg_eval p get vrl_xs i 0
      ret vrl_swhy_txt vrl_s_eval
    end
    put vrl_ys i get vpg_ev 0
  end
  for i ulong 84
    if ne vrl_exec r get vrl_xs i 0 0 0
      ret vrl_swhy_txt vrl_s_nat
    end
    if ne get vrl_out 0 get vrl_ys i
      vsb_reset
      vsb_t vrl_s_mm1
      vsb_x get vrl_xs i 1
      vsb_t vrl_s_mm2
      vsb_x get vrl_ys i 1
      vsb_t vrl_s_mm3
      vsb_x get vrl_out 0 1
      vrl_swhy_set
      ret -1
    end
    put vrl_sr 6 add get vrl_sr 6 1
  end
  put vrl_swl 0 0
  ret 0
end

note omega_realization_verify_program(p, m, r)
fn vrl_verify_program p ulong m ulong r ulong to long
  put vrl_sr 6 0
  if ne vpg_realize_check p 256 0
    vsb_reset
    vsb_t vrl_s_pref
    vsb_why 255
    vrl_swhy_set
    ret -1
  end
  if ne vrl_verify_ids p m r 0
    ret -1
  end
  ret vrl_verify_diff p r
end

fn vrl_synth_emit p ulong m ulong r ulong to long
  vro_zero r
  if ne vpg_emit_schedule p get vpg_w 0 ulong get vrl_sr 4 r 0
    vsb_reset
    vsb_t vpg_w_emit
    vrl_swhy_set
    ret -2
  end
  pb = vpg_ib p 0
  sb = vro_ib r VRO_K_SEM
  mb = vro_ib r VRO_K_MACH
  for i ulong 32
    put vro_id add sb i get vpg_ids add pb i
    put vro_id add mb i get vmch_gid add mul m 32 i
  end
  vro_p r VRO_HASM 1
  vro_p r VRO_PROF vrl_mg_prof m
  vro_p r VRO_EOFF 0
  if eq vro_calc_triple r 0
    vro_id_from_sha r VRO_K_RID
  end
  vro_p r VRO_HASID 1
  put vrl_sr 5 long vrl_latency m r
  ret 0
end

note synthesize_realization_impl(p, m): rc (also vrl_sr 3)
fn vrl_synth_impl p ulong m ulong to long
  for k ulong 8
    put vrl_sr k 0
  end
  put vrl_swl 0 0
  r = VRO_TMP2
  vro_zero r
  if ne vpg_realize_check p 192 0
    vsb_reset
    vsb_why 191
    vrl_swhy_set
    ret -2
  end
  if ne vrl_mg_prof m 1
    vsb_reset
    vsb_t vrl_s_prof1
    vsb_x vrl_mg_prof m 2
    vsb_t vrl_s_prof2
    vrl_swhy_set
    ret -2
  end
  sch = long 0
  if and ge vmch_gget m VMCH_K_ISSUE 4 ge vmch_gget m VMCH_K_GPRC 16
    sch = 1
  end
  put vrl_sr 4 sch
  if ne vrl_synth_emit p m r 0
    ret -2
  end
  vrc = vrl_verify_program p m r
  if ne vrc 0
    if eq vrc -3
      ret -3
    end
    ret -1
  end
  info = new ulong 4 0
  if lt om_ver_v2_props info 0
    ret -1
  end
  put vrl_sr 7 1
  ret 0
end

fn vrl_synth p ulong m ulong to long
  rc = vrl_synth_impl p m
  put vrl_sr 3 rc
  ret rc
end


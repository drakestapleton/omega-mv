fn vrl_text_head v ulong to void
  if eq vrv_len v VF_LABEL 0
    ob_puts vrl_w_real
  else
    ob_puts vrl_t_r
    ob_vf v VF_LABEL
  end
  ob_putc uchar 10
  ob_puts vrl_t_id
  ob_vf v VF_RID
  ob_putc uchar 10
  ob_puts vrl_t_subj
  ob_vf v VF_SID
  ob_putc uchar 10
  ob_puts vrl_t_zid
  ob_vf v VF_ZID
  ob_putc uchar 10
  ob_puts vrl_t_mach
  ob_vf v VF_MID
  ob_putc uchar 32
  ob_putc uchar 40

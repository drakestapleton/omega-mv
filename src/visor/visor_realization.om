note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor lane 5: realization lab (replaces src/visor/visor_realization.c).
note Depends on visor.om, omega_lower.om, visor_machine.om.

global vrl_regs ulong 32
global vrl_run_out ulong 1
global vrl_why uchar 256
global vrl_wlen ulong 1

text vrl_w_div "DIV is not supported by pure AArch64 realizer"
text vrl_w_ovf "overflow policy must be WRAP"
text vrl_w_wid "operand width must be 64"
text vrl_w_kind "object is not a realizable APPLY"
text vrl_w_ok "direct pure AArch64 realization"
text vrl_w_incompat "INCOMPATIBLE"
text vrl_w_unr "program is not realized"
text vrl_sp2 "  "
text vrl_sp4 "    "
text vrl_d_ret "ret"
text vrl_d_add "add x0, x0, x1"
text vrl_d_sub "sub x0, x0, x1"
text vrl_d_mul "mul x0, x0, x1"
text vrl_d_and "and x0, x0, x1"
text vrl_d_orr "orr x0, x0, x1"
text vrl_d_eor "eor x0, x0, x1"
text vrl_d_movz "movz x1, #"
text vrl_d_movk1 "movk x1, #"
text vrl_d_movk2 ", lsl #16"
text vrl_d_insn "insn"
text vrl_c1 "cost (four separate classes; never merged)\n  predicted cycles="
text vrl_c2 " insns="
text vrl_c3 " (static model)\n  estimated cycles="
text vrl_c4 " (omega_machine_estimate_latency)\n  measured  ABSENT (no receipt ingested in V1)\n  qualified ABSENT (no qualified gate ingested in V1)\n"
text vrl_cj1 "{\"predicted\":{\"present\":true,\"cycles\":"
text vrl_cj2 "},\"estimated\":{\"present\":true,\"cycles\":"
text vrl_cj3 "},\"measured\":{\"present\":false,\"cycles\":0},\"qualified\":{\"present\":false,\"cycles\":0}}"
text vrl_f1 "realization: sha256:"
text vrl_f2 "  compatible   "
text vrl_f3 "yes\n  runnable     yes\n"
text vrl_f4 "no\n  runnable     no\n"
text vrl_f5 "  code_len     "
text vrl_j1 "{\"realization_id\":\"sha256:"
text vrl_j2 "\",\"compatible\":"
text vrl_j3 "true,\"runnable\":true"
text vrl_j4 "false,\"runnable\":false"
text vrl_j5 ",\"disasm\":["
text vrl_j6 "],\"cost\":{\"predicted\":{\"present\":true,\"cycles\":"
text vrl_j7 "},\"estimated\":{\"present\":true,\"cycles\":"
text vrl_j8 "},\"measured\":{\"present\":false,\"cycles\":0},\"qualified\":{\"present\":false,\"cycles\":0}}}"

fn vrl_set_why s view uchar * to void
  n = len s
  if gt n 255
    n = 255
  end
  for i ulong n bound 256
    put vrl_why i get s i
  end
  put vrl_wlen 0 n
end

fn vrl_dec_insn32 ridx ulong off ulong to ulong
  base = add mul ridx 256 off
  b0 = ulong get v_real_code base
  b1 = ulong get v_real_code add base 1
  b2 = ulong get v_real_code add base 2
  b3 = ulong get v_real_code add base 3
  ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn vrl_put_insn32 ridx ulong off ulong w ulong to void
  base = add mul ridx 256 off
  put v_real_code base uchar and w 0xff
  put v_real_code add base 1 uchar and shr w 8 0xff
  put v_real_code add base 2 uchar and shr w 16 0xff
  put v_real_code add base 3 uchar and shr w 24 0xff
end

fn vrl_disasm_insn w ulong to void
  ob_put_hex_byte and shr w 24 0xff
  ob_put_hex_byte and shr w 16 0xff
  ob_put_hex_byte and shr w 8 0xff
  ob_put_hex_byte and w 0xff
  ob_puts vrl_sp2
  if eq w 0xd65f03c0
    ob_puts vrl_d_ret
    ret
  end
  if eq w 0x8b010000
    ob_puts vrl_d_add
    ret
  end
  if eq w 0xcb010000
    ob_puts vrl_d_sub
    ret
  end
  if eq w 0x9b017c00
    ob_puts vrl_d_mul
    ret
  end
  if eq w 0x8a010000
    ob_puts vrl_d_and
    ret
  end
  if eq w 0xaa010000
    ob_puts vrl_d_orr
    ret
  end
  if eq w 0xca010000
    ob_puts vrl_d_eor
    ret
  end
  if eq and w 0xff80001f 0xd2800001
    ob_puts vrl_d_movz
    ob_put_u64 and shr w 5 0xffff
    ret
  end
  if eq and w 0xff80001f 0xf2a00001
    ob_puts vrl_d_movk1
    ob_put_u64 and shr w 5 0xffff
    ob_puts vrl_d_movk2
    ret
  end
  ob_puts vrl_d_insn
end

fn vrl_is_pure_insn w ulong to bool
  if or eq w 0x8b010000 eq w 0xcb010000
    ret true
  end
  if or eq w 0x9b017c00 eq w 0x8a010000
    ret true
  end
  if or eq w 0xaa010000 eq w 0xca010000
    ret true
  end
  m = and w 0xff80001f
  if or eq m 0xd2800001 eq m 0xf2a00001
    ret true
  end
  ret false
end

fn vrl_validate_pure ridx ulong to long
  if ge ridx get v_real_cnt 0
    ret -3
  end
  if ne get v_real_prof ridx 1
    ret -3
  end
  if ne get v_real_vknown ridx 0
    if eq get v_real_compat ridx 0
      ret -3
    end
  end
  tl = get v_real_tlen ridx
  if ge tl 9
    tb = mul ridx 32
    if and eq get v_real_tname tb uchar 98 eq get v_real_tname add tb 1 uchar 108
      ret -3
    end
  end
  if ne get v_real_has_mach ridx 0
    mb = mul ridx 32
    is_bw = true
    for i ulong 32
      if ne get v_real_mach_id add mb i get vmch_bw_id i
        is_bw = false
        break
      end
    end
    if is_bw
      ret -3
    end
  end
  cl = get v_real_clen ridx
  if or lt cl 4 ne rem cl 4 0
    ret -3
  end
  nins = div cl 4
  last = vrl_dec_insn32 ridx sub cl 4
  if ne last 0xd65f03c0
    ret -3
  end
  for i ulong sub nins 1 bound 64
    w = vrl_dec_insn32 ridx mul i 4
    if not vrl_is_pure_insn w
      ret -3
    end
  end
  ret 0
end

fn vrl_run_pure ridx ulong a0 ulong a1 ulong a2 ulong argc ulong to long
  if gt argc 3
    ret -3
  end
  if lt vrl_validate_pure ridx 0
    ret -3
  end
  for i ulong 32
    put vrl_regs i 0
  end
  put vrl_regs 0 a0
  put vrl_regs 1 a1
  put vrl_regs 2 a2
  cl = get v_real_clen ridx
  nins = div cl 4
  for i ulong nins bound 64
    w = vrl_dec_insn32 ridx mul i 4
    if eq w 0xd65f03c0
      break
    end
    if eq w 0x8b010000
      put vrl_regs 0 add get vrl_regs 0 get vrl_regs 1
    else
      if eq w 0xcb010000
        put vrl_regs 0 sub get vrl_regs 0 get vrl_regs 1
      else
        if eq w 0x9b017c00
          put vrl_regs 0 mul get vrl_regs 0 get vrl_regs 1
        else
          if eq w 0x8a010000
            put vrl_regs 0 and get vrl_regs 0 get vrl_regs 1
          else
            if eq w 0xaa010000
              put vrl_regs 0 or get vrl_regs 0 get vrl_regs 1
            else
              if eq w 0xca010000
                put vrl_regs 0 xor get vrl_regs 0 get vrl_regs 1
              else
                if eq and w 0xff80001f 0xd2800001
                  put vrl_regs 1 and shr w 5 0xffff
                else
                  if eq and w 0xff80001f 0xf2a00001
                    imm = and shr w 5 0xffff
                    cur = and get vrl_regs 1 0xffffffff0000ffff
                    put vrl_regs 1 or cur shl imm 16
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  put vrl_run_out 0 get vrl_regs 0
  ret 0
end

fn vrl_estimate_cycles ridx ulong is_spark ulong to ulong
  nins = div get v_real_clen ridx 4
  if eq is_spark 1
    ret add nins 1
  end
  ret add mul nins 2 1
end

fn vrl_finish_apply_meta rc ulong apply_idx ulong opi ulong to void
  tl = len vmch_t_a64
  put v_real_tlen rc tl
  tb = mul rc 32
  for i ulong tl bound 32
    put v_real_tname add tb i get vmch_t_a64 i
  end
  sb = mul apply_idx 32
  ob = mul opi 32
  rb = mul rc 32
  for i ulong 32
    put v_real_subj_id add rb i get v_og_id add sb i
    put v_real_sem_id add rb i get v_og_id add ob i
    put v_real_mach_id add rb i get vmch_id i
  end
  cb = mul rc 256
  for i ulong 8
    put v_sha_in i get v_real_code add cb i
  end
  for i ulong 32
    put v_sha_in add 8 i get v_real_sem_id add rb i
  end
  sha256_hash 40
  for i ulong 32
    put v_real_id add rb i get v_sha_out i
  end
end

fn vrl_realize_apply apply_idx ulong to long
  if ge apply_idx get v_og_cnt 0
    vrl_set_why vrl_w_kind
    ret -2
  end
  if or ne get v_og_kind apply_idx V_KIND_OP ne get v_og_plen apply_idx 161
    vrl_set_why vrl_w_kind
    ret -2
  end
  pb = mul apply_idx V_MAX_PAYLOAD
  for i ulong 32
    put v_tmp_id i get v_og_pay add pb i
  end
  opi = og_find_by_tmp
  if lt opi 0
    vrl_set_why vrl_w_kind
    ret -2
  end
  opb = mul ulong opi V_MAX_PAYLOAD
  opc = v_dec_u32le_pay opb 0
  ovf = v_dec_u32le_pay opb 4
  info = olw_obj_type_info ulong opi
  wid = and info 0xffff
  if eq opc V_OP_DIV
    vrl_set_why vrl_w_div
    ret -2
  end
  if ne ovf V_OVF_WRAP
    vrl_set_why vrl_w_ovf
    ret -2
  end
  if ne wid 64
    vrl_set_why vrl_w_wid
    ret -2
  end
  insn = ulong 0
  if eq opc V_OP_ADD
    insn = 0x8b010000
  else
    if eq opc V_OP_SUB
      insn = 0xcb010000
    else
      if eq opc V_OP_MUL
        insn = 0x9b017c00
      else
        if eq opc V_OP_AND
          insn = 0x8a010000
        else
          if eq opc V_OP_OR
            insn = 0xaa010000
          else
            if eq opc V_OP_XOR
              insn = 0xca010000
            else
              vrl_set_why vrl_w_kind
              ret -2
            end
          end
        end
      end
    end
  end
  rc = get v_real_cnt 0
  if ge rc V_MAX_REALS
    ret -1
  end
  put v_real_cnt 0 add rc 1
  vrl_put_insn32 rc 0 insn
  vrl_put_insn32 rc 4 0xd65f03c0
  put v_real_clen rc 8
  put v_real_prof rc 1
  put v_real_is_prog rc 0
  put v_real_pidx rc -1
  put v_real_vknown rc 1
  put v_real_compat rc 1
  put v_real_ilen rc 0
  put v_real_has_mach rc 1
  put v_real_has_est rc 1
  put v_real_est rc vrl_estimate_cycles rc get vmch_is_spark 0
  vrl_finish_apply_meta rc apply_idx ulong opi
  vrl_set_why vrl_w_ok
  ret long rc
end

fn vrl_realize_program pidx ulong to long
  if ge pidx get v_prog_cnt 0
    ret -2
  end
  if eq get v_prog_realized pidx 0
    vrl_set_why vrl_w_unr
    ret -2
  end
  rc = get v_real_cnt 0
  if ge rc V_MAX_REALS
    ret -1
  end
  put v_real_cnt 0 add rc 1
  cl = get v_prog_clen pidx
  put v_real_clen rc cl
  pcb = mul pidx 256
  rcb = mul rc 256
  for i ulong cl bound 256
    put v_real_code add rcb i get v_prog_code add pcb i
    put v_sha_in i get v_prog_code add pcb i
  end
  put v_real_prof rc 1
  put v_real_is_prog rc 1
  put v_real_pidx rc long pidx
  put v_real_vknown rc 1
  put v_real_compat rc 1
  put v_real_ilen rc 0
  put v_real_has_mach rc 1
  put v_real_has_est rc 1
  put v_real_est rc vrl_estimate_cycles rc get vmch_is_spark 0
  tl = len vmch_t_a64
  put v_real_tlen rc tl
  tb = mul rc 32
  for i ulong tl bound 32
    put v_real_tname add tb i get vmch_t_a64 i
  end
  pb = mul pidx 32
  rb = mul rc 32
  for i ulong 32
    put v_real_subj_id add rb i get v_prog_id add pb i
    put v_real_sem_id add rb i get v_prog_id add pb i
    put v_real_mach_id add rb i get vmch_id i
    put v_sha_in add cl i get v_prog_id add pb i
  end
  sha256_hash add cl 32
  for i ulong 32
    put v_real_id add rb i get v_sha_out i
  end
  vrl_set_why vrl_w_ok
  ret long rc
end

fn vrl_format_cost_text ridx ulong cap ulong to long
  ob_reset cap
  nins = div get v_real_clen ridx 4
  est = get v_real_est ridx
  ob_puts vrl_c1
  ob_put_u64 nins
  ob_puts vrl_c2
  ob_put_u64 nins
  ob_puts vrl_c3
  ob_put_u64 est
  ob_puts vrl_c4
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vrl_format_cost_json ridx ulong cap ulong to long
  ob_reset cap
  nins = div get v_real_clen ridx 4
  est = get v_real_est ridx
  ob_puts vrl_cj1
  ob_put_u64 nins
  ob_puts vrl_cj2
  ob_put_u64 est
  ob_puts vrl_cj3
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vrl_format_text ridx ulong cap ulong to long
  ob_reset cap
  rb = mul ridx 32
  ob_puts vrl_f1
  for i ulong 32
    ob_put_hex_byte ulong get v_real_id add rb i
  end
  ob_putc uchar 10
  ok = eq vrl_validate_pure ridx 0
  ob_puts vrl_f2
  if ok
    ob_puts vrl_f3
  else
    ob_puts vrl_f4
  end
  ob_puts vrl_f5
  ob_put_u64 get v_real_clen ridx
  ob_putc uchar 10
  nins = div get v_real_clen ridx 4
  for i ulong nins bound 64
    ob_puts vrl_sp4
    vrl_disasm_insn vrl_dec_insn32 ridx mul i 4
    ob_putc uchar 10
  end
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vrl_format_json ridx ulong cap ulong to long
  ob_reset cap
  rb = mul ridx 32
  ok = eq vrl_validate_pure ridx 0
  nins = div get v_real_clen ridx 4
  est = get v_real_est ridx
  ob_puts vrl_j1
  for i ulong 32
    ob_put_hex_byte ulong get v_real_id add rb i
  end
  ob_puts vrl_j2
  if ok
    ob_puts vrl_j3
  else
    ob_puts vrl_j4
  end
  ob_puts vrl_j5
  for i ulong nins bound 64
    if gt i 0
      ob_putc uchar 44
    end
    ob_putc uchar 34
    vrl_disasm_insn vrl_dec_insn32 ridx mul i 4
    ob_putc uchar 34
  end
  ob_puts vrl_j6
  ob_put_u64 nins
  ob_puts vrl_j7
  ob_put_u64 est
  ob_puts vrl_j8
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

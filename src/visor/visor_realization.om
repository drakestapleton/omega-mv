text vrl_c_pred1 "static: code_len/4 = "
text vrl_c_pred2 " instructions x 1 cycle; no machine model"
text vrl_c_empty "absent: empty code"
text vrl_c_est1 "omega_machine_estimate_latency("
text vrl_c_est2 ") (assumed profile, not measured)"
text vrl_c_rec "machine-model estimate recorded when realized (assumed profile, not measured)"
text vrl_c_nomg "absent: no machine model"
text vrl_c_meas "absent: Visor V1 ingests no execution receipts"
text vrl_c_qual "absent: no qualified gate result for this realization in V1"
text vrl_c_notr "absent: not realized"
text vrl_n_pred "predicted"
text vrl_n_est "estimated"
text vrl_n_meas "measured"
text vrl_n_qual "qualified"

fn vrl_cost_clear v ulong to void
  for i ulong 4
    for k ulong 5
      vrv_cset v i k 0
    end
    vrv_cset v i 1 i
    put vrv_l add mul v VRL_NF add VF_SRC i 0
  end
end

fn vrl_cost_present v ulong i ulong cyc ulong ins ulong by ulong to void
  vrv_cset v i 0 1
  vrv_cset v i 2 cyc
  vrv_cset v i 3 ins
  vrv_cset v i 4 by
end

fn vrl_cost_est v ulong e ulong mg ulong ins ulong by ulong to void
  f = add VF_SRC 1
  if and ne mg VRL_NOMG gt ins 0
    vrl_cost_present v 1 vrl_latency mg vre_r e ins by
    vsb_reset
    vsb_t vrl_c_est1
    vsb_mname mg 63
    vsb_t vrl_c_est2
    vrv_set v f
    ret
  end
  if eq vre_g e VE_HASEST 1
    vrl_cost_present v 1 vre_g e VE_EST ins by
    vrv_txt v f vrl_c_rec
    ret
  end
  vrv_txt v f vrl_c_nomg
end

note visor_realization_cost(e, mg) into the cost of view v
fn vrl_cost e ulong mg ulong v ulong to long
  vrl_cost_clear v
  by = vro_g vre_r e VRO_CLEN
  ins = div by 4
  if gt ins 0
    vrl_cost_present v 0 ins ins by
    vsb_reset
    vsb_t vrl_c_pred1
    vsb_u ins
    vsb_t vrl_c_pred2
    vrv_set v VF_SRC
  else
    vrv_txt v VF_SRC vrl_c_empty
  end
  vrl_cost_est v e mg ins by
  vrv_txt v add VF_SRC 2 vrl_c_meas
  vrv_txt v add VF_SRC 3 vrl_c_qual
  ret 0
end


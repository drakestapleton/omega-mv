fn vrl_tmp_from_pay idx ulong off ulong to void
  pb = add mul idx V_MAX_PAYLOAD off
  for i ulong 32
    put v_tmp_id i get v_og_pay add pb i
  end
end

note the operation id (vrl_opid) of the object idx with id vrl_aid: 0, or -2 with the failed view v
fn vrl_apply_op idx ulong v ulong to long
  if ne get v_og_kind idx V_KIND_OP
    ret vrl_fail_txt v vrl_a_kind
  end
  pl = get v_og_plen idx
  if eq pl 161
    oc = ulong get v_og_pay add mul idx V_MAX_PAYLOAD 32
    if ne oc 2
      vsb_reset
      vsb_t vrl_a_cnt1
      vsb_u oc
      vsb_t vrl_a_cnt2
      ret vrl_fail_view v
    end
    vrl_tmp_from_pay idx 0
    for i ulong 32
      put vrl_opid i get v_tmp_id i
    end
    ret 0
  end
  if ge pl 204
    for i ulong 32
      put vrl_opid i get vrl_aid i
    end
    ret 0
  end
  ret vrl_fail_txt v vrl_a_size
end

fn vrl_op_ok opc ulong to bool
  ret vpg_step_valid opc
end

note checks of the operation and its type; 0 or -2 with the failed view
fn vrl_check_op v ulong to long
  for i ulong 32
    put v_tmp_id i get vrl_opid i
  end
  oi = og_find_by_tmp
  if lt oi 0
    ret vrl_fail_txt v vrl_a_noop
  end
  o = ulong oi
  if or ne get v_og_kind o V_KIND_OP lt get v_og_plen o 204
    ret vrl_fail_txt v vrl_a_noop
  end
  pb = mul o V_MAX_PAYLOAD
  opc = v_dec_u32le_pay pb 0
  ovf = v_dec_u32le_pay pb 4
  if not vrl_op_ok opc
    vsb_reset
    vsb_t vrl_a_opc1
    vsb_opname opc
    vsb_t vrl_a_opc2
    ret vrl_fail_view v
  end
  vrl_tmp_from_pay o 8
  ti = og_find_by_tmp
  if lt ti 0
    ret vrl_fail_txt v vrl_a_noty
  end
  t = ulong ti
  if or ne get v_og_kind t V_KIND_TYPE lt get v_og_plen t 44
    ret vrl_fail_txt v vrl_a_noty
  end
  tb = mul t V_MAX_PAYLOAD
  tag = v_dec_u32le_pay tb 0
  wid = v_dec_u16le_pay tb 4
  if or ne tag V_TY_UINT ne wid 64
    vsb_reset
    vsb_t vrl_a_ty1
    vsb_x tag 2
    vsb_t vrl_a_ty2
    vsb_u wid
    vsb_t vrl_a_ty3
    ret vrl_fail_view v
  end
  if or or eq opc V_OP_ADD eq opc V_OP_SUB eq opc V_OP_MUL
    if and ne ovf V_OVF_WRAP ne ovf V_OVF_DEFAULT
      vsb_reset
      vsb_t vrl_a_ov1
      vsb_x ovf 2
      vsb_t vrl_a_ov2
      ret vrl_fail_view v
    end
  end
  put vrl_cnt 0 opc
  ret 0
end

note omega_realize_pure_binary into vro r (op id vrl_opid, opcode opc)
fn vrl_pure_binary r ulong opc ulong to long
  vro_zero r
  sb = vro_ib r VRO_K_SEM
  for i ulong 32
    put vro_id add sb i get vrl_opid i
  end
  vro_p r VRO_PROF 1
  if lt vro_emit_op r opc 1 0
    ret -1
  end
  if lt vro_put32 r a64ret 0
    ret -1
  end
  ret vro_compute_rid r
end

note visor_realize_apply(g, id in v_tmp_id, mg, e, v): 0, or -2 with the failed view
fn vrl_realize_apply mg ulong e ulong v ulong to long
  vre_zero e
  for i ulong 32
    put vrl_aid i get v_tmp_id i
  end
  ai = og_find_by_tmp
  if lt ai 0
    ret vrl_fail_txt v vrl_a_unk
  end
  if ne vrl_apply_op ulong ai v 0
    ret -2
  end
  if ne vrl_check_op v 0
    ret -2
  end
  if ne vrl_pure_binary vre_r e get vrl_cnt 0 0
    ret -2
  end
  b = vre_ib e 0
  for i ulong 32
    put vre_ids add b i get vrl_aid i
  end
  put vre_pidx e -1
  vre_set_tn e vrl_t_a64
  vre_p e VE_VK 1
  vre_p e VE_COMPAT 1
  vrl_entry_base e mg
  ret vrl_view e mg v
end

text vrl_p_ref "omega_program_realize refused: "
text vrl_p_unk "unknown"

note visor_realize_program(p, mg, e, v): 0, or -2 with the failed view
fn vrl_realize_program p ulong mg ulong e ulong v ulong to long
  vre_zero e
  vpg_copy VPG_TMP p
  if ne vpg_realize_ex VPG_TMP 192 0
    vsb_reset
    vsb_t vrl_p_ref
    if eq get vpg_wl 0 0
      vsb_t vrl_p_unk
    else
      vsb_why 191
    end
    vsb_trunc 239
    ret vrl_fail_view v
  end
  vro_copy vre_r e VPG_TMP
  vre_subj_from_prog e p
  vre_p e VE_SUBJP 1
  put vre_pidx e -1
  vre_set_tn e vrl_t_a64
  vre_p e VE_VK 1
  vre_p e VE_COMPAT 1
  vrl_entry_base e mg
  ret vrl_view e mg v
end


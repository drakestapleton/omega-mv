  vrl_ci_name i
  if eq vrv_ci v i 0 1
    ob_puts vrl_f_cyc
    ob_put_u64 vrv_ci v i 2
    ob_puts vrl_f_insns
    ob_put_u64 vrv_ci v i 3
    ob_puts vrl_f_bytes
    ob_put_u64 vrv_ci v i 4
    ob_puts vrl_f_lb
  else
    ob_puts vrl_f_absent
  end
  ob_vf v add VF_SRC i
  ob_puts vrl_f_rb
end


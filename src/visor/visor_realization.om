fn vsb_opname2 op ulong to void
  if eq op V_OP_NOT
    vsb_t vrl_o_not
    ret
  end
  if eq op V_OP_EQUAL
    vsb_t vrl_o_eq
    ret
  end
  if eq op V_OP_LESS_THAN
    vsb_t vrl_o_lt
    ret
  end
  if eq op V_OP_IDENTITY
    vsb_t vrl_o_id
    ret
  end
  if eq op V_OP_CONSTANT
    vsb_t vrl_o_k
    ret
  end
  if eq op V_OP_SELECT
    vsb_t vrl_o_sel
    ret
  end
  if eq op V_OP_CONCAT
    vsb_t vrl_o_cat
    ret
  end
  if eq op V_OP_SLICE
    vsb_t vrl_o_sli
    ret
  end
  if eq op V_OP_COMPILE
    vsb_t vrl_o_cmp
    ret
  end
  if eq op V_OP_CONVERT
    vsb_t vrl_o_cnv
    ret
  end
  vsb_t vrl_o_inv
end

fn vsb_opname op ulong to void
  if eq op V_OP_ADD
    vsb_t vrl_o_add
    ret
  end
  if eq op V_OP_SUB
    vsb_t vrl_o_sub
    ret
  end
  if eq op V_OP_MUL
    vsb_t vrl_o_mul
    ret
  end
  if eq op V_OP_DIV
    vsb_t vrl_o_div
    ret
  end
  if eq op V_OP_AND
    vsb_t vrl_o_and
    ret
  end
  if eq op V_OP_OR
    vsb_t vrl_o_or
    ret
  end
  vsb_opname2 op
end


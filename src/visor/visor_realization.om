fn vrl_label_or v ulong t view uchar * to void
  if eq vrv_len v VF_LABEL 0
    ob_puts t
  else
    ob_vf v VF_LABEL
  end
end

fn vrl_why_head v ulong to void
  ob_puts vrl_w_why
  vrl_label_or v vrl_w_real
  ob_putc uchar 10
  ob_puts vrl_w_c1
  if eq vrv_g v VW_COMPAT 1
    ob_puts vrl_w_comp
  else
    ob_puts vrl_w_ncomp
  end
  ob_putc uchar 10
  ob_puts vrl_w_p1
  ob_x vrv_g v VW_PROF 2
  ob_puts vrl_w_p2
  ob_vf v VF_MNAME
  ob_puts vrl_w_p3
  ob_puts vrl_w_b1
  ob_vf v VF_BID
  ob_puts vrl_w_b2
  ob_vf v VF_MID
  ob_putc uchar 10
  ob_puts vrl_w_t1
  ob_vf v VF_TARGET
  ob_puts vrl_w_t2
  if eq vrv_g v VW_RUN 1
    ob_puts vrl_w_allow
  else
    ob_puts vrl_v_refused
  end
  ob_putc uchar 10
end

note visor_realization_why(v, n)
fn vrl_why v ulong n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  vrl_why_head v
  ob_puts vrl_w_cons
  ob_vf v VF_WHY
  ob_putc uchar 10
  ob_puts vrl_w_srcs
  for i ulong 4
    ob_puts vrl_f_sp4
    vrl_ci_name i
    if eq vrv_ci v i 0 1
      ob_puts vrl_w_pres
    else
      ob_puts vrl_w_abs
    end
    ob_vf v add VF_SRC i
    ob_putc uchar 10
  end
  ret ob_done
end


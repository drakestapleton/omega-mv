note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor lane 5: realization lab, a faithful port of src/visor/visor_realization.c
note with the C it calls (omega_realize_pure_binary, omega_program_realize_ex, the realization
note synthesizer and its verifier, omega_machine_estimate_latency, aarch64 decode/validate).
note Depends on visor.om, om/aarch64/aarch64_om2.om, om/visor/verify_om2.om, visor_machine.om,
note visor_program.om.
note
note Storage. Entries (VisorRealizationEntry) 0..23, entry e's RealizationObject is vro slot 16+e.
note Views (VisorRealizationView) 0..23. A machine model is a visor_machine graph slot; VRL_NOMG
note means none (C NULL). The lab uses machine slots 12..14 for its own canonical builds.
note run_pure executes the code with an interpreter of exactly the AArch64 subset run_check admits
note (ADD SUB AND ORR EOR shifted register, MUL, MOVZ, MOVK, RET) on x0..x2 = args, other
note registers 0; C runs it natively on the AArch64 host (this binary only runs on AArch64, so
note the C aarch64 branches are the ones ported). Encodings the CPU would reject (shift type 3 on
note ADD/SUB, a 32-bit shift >= 32, a 32-bit MOVZ/MOVK hw >= 2) give an execution failure (-1).

const VRL_NE ulong 24
const VRL_NV ulong 24
const VRL_ETMP ulong 23
const VRL_NOMG ulong 255
const VRL_MG_SC ulong 12
const VRL_MG_SP ulong 13
const VRL_MG_OT ulong 14
const VRL_ES ulong 16
const VE_SUBJP ulong 0
const VE_HASEM ulong 1
const VE_EST ulong 2
const VE_HASEST ulong 3
const VE_VK ulong 4
const VE_COMPAT ulong 5
const VE_TLEN ulong 6
const VE_RLEN ulong 7
const VRL_VS ulong 32
const VW_PROF ulong 0
const VW_CLEN ulong 1
const VW_INSN ulong 2
const VW_DCNT ulong 3
const VW_COMPAT ulong 4
const VW_RUN ulong 5
const VW_COST ulong 8
const VF_LABEL ulong 0
const VF_RID ulong 1
const VF_SID ulong 2
const VF_ZID ulong 3
const VF_MID ulong 4
const VF_BID ulong 5
const VF_MNAME ulong 6
const VF_TARGET ulong 7
const VF_WHY ulong 8
const VF_SRC ulong 9
const VF_DIS ulong 13
const VRL_VSTR ulong 4352
const VRL_NF ulong 80

global vre_s ulong 384
global vre_pidx long 24
global vre_ids uchar 1536
global vre_tn uchar 768
global vre_ir uchar 3072
global vrv_s ulong 768
global vrv_str uchar 104448
global vrv_l ulong 1920
global vrl_aid uchar 32
global vrl_opid uchar 32
global vrl_out ulong 1
global vrl_run_out ulong 1
global vrl_rwhy uchar 160
global vrl_rwl ulong 1
global vrl_xs ulong 84
global vrl_ys ulong 84
global vrl_swhy uchar 192
global vrl_swl ulong 1
global vrl_sr long 8
global vrl_diff uchar 160
global vrl_dfl ulong 1
global vrl_cnt ulong 1
global vrs_why uchar 256
global vrs_wlen ulong 1
global vrl_alt ulong 4

text vrl_t_a64 "aarch64-v8a"
text vrl_t_dgx "dgx-spark"
text vrl_t_qemu "qemu-virt"
text vrl_t_bw "blackwell-gb10-sm121"
text vrl_t_none "none"

note ---- entry fields ----
fn vre_g e ulong k ulong to ulong
  ret get vre_s add mul e VRL_ES k
end

fn vre_p e ulong k ulong v ulong to void
  put vre_s add mul e VRL_ES k v
end

fn vre_r e ulong to ulong
  ret add 16 e
end

note id k of e: 0 subject_id, 1 machine_id
fn vre_ib e ulong k ulong to ulong
  ret mul add mul e 2 k 32
end

fn vre_zero e ulong to void
  for k ulong VRL_ES
    vre_p e k 0
  end
  put vre_pidx e 0
  b = mul e 64
  for i ulong 64
    put vre_ids add b i uchar 0
  end
  vro_zero vre_r e
end

fn vre_copy d ulong s ulong to void
  for k ulong VRL_ES
    vre_p d k vre_g s k
  end
  put vre_pidx d get vre_pidx s
  for i ulong 64
    put vre_ids add mul d 64 i get vre_ids add mul s 64 i
  end
  for i ulong 32
    put vre_tn add mul d 32 i get vre_tn add mul s 32 i
  end
  for i ulong 128
    put vre_ir add mul d 128 i get vre_ir add mul s 128 i
  end
  vro_copy vre_r d vre_r s
end

note target_name = text (snprintf into 32)
fn vre_set_tn e ulong t view uchar * to void
  n = len t
  if gt n 31
    n = 31
  end
  b = mul e 32
  for i ulong n bound 32
    put vre_tn add b i get t i
  end
  vre_p e VE_TLEN n
end

fn vre_tn_is e ulong t view uchar * to bool
  n = len t
  if ne vre_g e VE_TLEN n
    ret false
  end
  b = mul e 32
  for i ulong n bound 32
    if ne get vre_tn add b i get t i
      ret false
    end
  end
  ret true
end

note incompatible_reason = vsb (snprintf into 128)
fn vre_set_ir e ulong to void
  n = get vsb_n 0
  if gt n 127
    n = 127
  end
  b = mul e 128
  for i ulong n bound 128
    put vre_ir add b i get vsb_b i
  end
  vre_p e VE_RLEN n
end

fn vsb_ir e ulong m ulong to void
  n = vre_g e VE_RLEN
  if gt n m
    n = m
  end
  b = mul e 128
  for i ulong n bound 128
    vsb_c ulong get vre_ir add b i
  end
end

note set_verdict(e, compatible, vsb)
fn vre_verdict e ulong ok ulong to void
  vre_p e VE_VK 1
  vre_p e VE_COMPAT ok
  if eq ok 1
    vsb_reset
  end
  vre_set_ir e
end

fn vsb_tn_e e ulong m ulong to void
  n = vre_g e VE_TLEN
  if gt n m
    n = m
  end
  b = mul e 32
  for i ulong n bound 32
    vsb_c ulong get vre_tn add b i
  end
end

note subject id of e = program id of p / machine id of e = machine m
fn vre_subj_from_prog e ulong p ulong to void
  b = vre_ib e 0
  pb = vpg_ib p 0
  for i ulong 32
    put vre_ids add b i get vpg_ids add pb i
  end
end

fn vre_mach_from_mg e ulong mg ulong to void
  b = vre_ib e 1
  for i ulong 32
    put vre_ids add b i get vmch_gid add mul mg 32 i
  end
  vre_p e VE_HASEM 1
end

fn vre_id_is_mg e ulong k ulong mg ulong to bool
  b = vre_ib e k
  for i ulong 32
    if ne get vre_ids add b i get vmch_gid add mul mg 32 i
      ret false
    end
  end
  ret true
end

fn vro_id_is_mg r ulong k ulong mg ulong to bool
  b = vro_ib r k
  for i ulong 32
    if ne get vro_id add b i get vmch_gid add mul mg 32 i
      ret false
    end
  end
  ret true
end

fn vro_id_is_prog r ulong k ulong p ulong to bool
  b = vro_ib r k
  pb = vpg_ib p 0
  for i ulong 32
    if ne get vro_id add b i get vpg_ids add pb i
      ret false
    end
  end
  ret true
end

note ---- view fields ----
fn vrv_g v ulong k ulong to ulong
  ret get vrv_s add mul v VRL_VS k
end

fn vrv_p v ulong k ulong x ulong to void
  put vrv_s add mul v VRL_VS k x
end

fn vrv_ci v ulong i ulong k ulong to ulong
  ret vrv_g v add VW_COST add mul i 5 k
end

fn vrv_cset v ulong i ulong k ulong x ulong to void
  vrv_p v add VW_COST add mul i 5 k x
end

fn vrv_off f ulong to ulong
  if ge f VF_DIS
    ret add 1272 mul sub f VF_DIS 48
  end
  if ge f VF_SRC
    ret add 760 mul sub f VF_SRC 128
  end
  if eq f VF_WHY
    ret 504
  end
  if eq f VF_TARGET
    ret 472
  end
  if eq f VF_MNAME
    ret 408
  end
  if eq f VF_LABEL
    ret 0
  end
  ret add 48 mul sub f 1 72
end

fn vrv_cap f ulong to ulong
  if ge f VF_DIS
    ret 48
  end
  if ge f VF_SRC
    ret 128
  end
  if eq f VF_WHY
    ret 256
  end
  if eq f VF_TARGET
    ret 32
  end
  if eq f VF_MNAME
    ret 64
  end
  if eq f VF_LABEL
    ret 48
  end
  ret 72
end

fn vrv_len v ulong f ulong to ulong
  ret get vrv_l add mul v VRL_NF f
end

note field = vsb (snprintf "%s" into the field's size)
fn vrv_set v ulong f ulong to void
  n = get vsb_n 0
  c = sub vrv_cap f 1
  if gt n c
    n = c
  end
  b = add mul v VRL_VSTR vrv_off f
  for i ulong n bound 256
    put vrv_str add b i get vsb_b i
  end
  put vrv_l add mul v VRL_NF f n
end

fn vrv_txt v ulong f ulong t view uchar * to void
  vsb_reset
  vsb_t t
  vrv_set v f
end

fn vsb_vf v ulong f ulong m ulong to void
  n = vrv_len v f
  if gt n m
    n = m
  end
  b = add mul v VRL_VSTR vrv_off f
  for i ulong n bound 256
    vsb_c ulong get vrv_str add b i
  end
end

fn vrv_byte v ulong f ulong i ulong to ulong
  ret ulong get vrv_str add add mul v VRL_VSTR vrv_off f i
end

fn vrv_feq va ulong fa ulong vb ulong fb ulong to bool
  n = vrv_len va fa
  if ne n vrv_len vb fb
    ret false
  end
  for i ulong n bound 256
    if ne vrv_byte va fa i vrv_byte vb fb i
      ret false
    end
  end
  ret true
end

fn vrv_zero v ulong to void
  for k ulong VRL_VS
    vrv_p v k 0
  end
  for f ulong VRL_NF
    put vrv_l add mul v VRL_NF f 0
  end
end

note ---- output (C buffer-size semantics: ob_reset sub n 1, fail when it overflows) ----
fn ob_vf v ulong f ulong to void
  n = vrv_len v f
  b = add mul v VRL_VSTR vrv_off f
  for i ulong n bound 256
    ob_putc get vrv_str add b i
  end
end

fn ob_hex4 c ulong to void
  ob_putc uchar 48
  ob_putc uchar 48
  ob_putc get vsb_hx and shr c 4 15
  ob_putc get vsb_hx and c 15
end

note json_str of one byte
fn ob_jc c ulong to void
  if or eq c 34 eq c 92
    ob_putc uchar 92
    ob_putc uchar c
    ret
  end
  if lt c 32
    ob_putc uchar 92
    ob_putc uchar 117
    ob_hex4 c
    ret
  end
  ob_putc uchar c
end

fn ob_jvf v ulong f ulong to void
  ob_putc uchar 34
  n = vrv_len v f
  b = add mul v VRL_VSTR vrv_off f
  for i ulong n bound 256
    ob_jc ulong get vrv_str add b i
  end
  ob_putc uchar 34
end

fn ob_jt t view uchar * to void
  ob_putc uchar 34
  n = len t
  for i ulong n bound 256
    ob_jc ulong get t i
  end
  ob_putc uchar 34
end

note %0<w>x / %-9s
fn ob_x v ulong w ulong to void
  vsb_reset
  vsb_x v w
  n = get vsb_n 0
  for i ulong n bound 24
    ob_putc get vsb_b i
  end
end

fn ob_pad9 t view uchar * to void
  ob_puts t
  n = len t
  while lt n 9 bound 9
    ob_putc uchar 32
    n = add n 1
  end
end

fn ob_yn b ulong to void
  if eq b 1
    ob_putc uchar 121
    ob_putc uchar 101
    ob_putc uchar 115
  else
    ob_putc uchar 110
    ob_putc uchar 111
  end
end

text vrl_j_true "true"
text vrl_j_false "false"

fn ob_tf b ulong to void
  if eq b 1
    ob_puts vrl_j_true
  else
    ob_puts vrl_j_false
  end
end

fn ob_done to long
  if eq get v_ob_ovf 0 1
    ret -1
  end
  ret long get v_ob_len 0
end

note ---- machine model access ----
fn vrl_mg_prof mg ulong to ulong
  ret vmch_gget mg VMCH_K_PROF
end

fn vsb_mname mg ulong m ulong to void
  n = vmch_gget mg VMCH_K_NLEN
  if gt n m
    n = m
  end
  nb = mul mg 64
  for i ulong n bound 64
    vsb_c ulong get vmch_gname add nb i
  end
end

fn vrl_mg_same a ulong b ulong to bool
  ret vmch_id_eq a b
end

note omega_machine_estimate_latency(mg, r)
fn vrl_latency mg ulong r ulong to ulong
  n = div vro_g r VRO_CLEN 4
  if eq n 0
    ret 0
  end
  ml = ulong 3
  al = ulong 1
  uc = vmch_gget mg VMCH_K_UCNT
  for u ulong uc bound 8
    b = add VMCH_K_UNIT mul u 4
    ty = vmch_gget mg b
    if eq ty 2
      ml = vmch_gget mg add b 2
    end
    if eq ty 0
      al = vmch_gget mg add b 2
    end
  end
  tot = ulong 0
  d = new ulong 9 0
  for i ulong n bound 1024
    rc = a64decode vro_word r mul i 4 d
    if and eq rc 0 eq get d 0 3
      tot = add tot ml
    else
      tot = add tot al
    end
  end
  iw = vmch_gget mg VMCH_K_ISSUE
  if and gt iw 1 gt n 1
    f = div sub add n iw 1 iw
    if gt f tot
      tot = f
    end
  end
  ret and tot 4294967295
end

note ---- disassembly ----
text vrl_m_add "add"
text vrl_m_sub "sub"
text vrl_m_mul "mul"
text vrl_m_and "and"
text vrl_m_orr "orr"
text vrl_m_eor "eor"
text vrl_m_lsl "lsl"
text vrl_m_lsr "lsr"
text vrl_m_asr "asr"
text vrl_m_ror "ror"
text vrl_m_movz "movz"
text vrl_m_movk "movk"
text vrl_m_ret "ret"
text vrl_m_b "b imm26=0x"
text vrl_m_bc "b.cond "
text vrl_m_i19 " imm19=0x"
text vrl_m_cbz "cbz "
text vrl_m_cbnz "cbnz "
text vrl_m_adr "adr"
text vrl_m_ldr "ldr"
text vrl_m_str "str"
text vrl_m_ldrb "ldrb"
text vrl_m_strb "strb"
text vrl_m_subs "subs"
text vrl_m_word ".word 0x"
text vrl_m_cs ", "
text vrl_m_hash ", #0x"
text vrl_m_lslh ", lsl #"
text vrl_m_xzr "xzr"
text vrl_m_wzr "wzr"

fn vsb_reg sf ulong r ulong to void
  if eq r 31
    if eq sf 1
      vsb_t vrl_m_xzr
    else
      vsb_t vrl_m_wzr
    end
    ret
  end
  if eq sf 1
    vsb_c 120
  else
    vsb_c 119
  end
  vsb_u r
end

fn vsb_rrr_name op ulong to void
  if eq op 1
    vsb_t vrl_m_add
  end
  if eq op 2
    vsb_t vrl_m_sub
  end
  if eq op 3
    vsb_t vrl_m_mul
  end
  if eq op 4
    vsb_t vrl_m_and
  end
  if eq op 5
    vsb_t vrl_m_orr
  end
  if eq op 6
    vsb_t vrl_m_eor
  end
end

fn vsb_shift_name sh ulong to void
  if eq sh 0
    vsb_t vrl_m_lsl
  end
  if eq sh 1
    vsb_t vrl_m_lsr
  end
  if eq sh 2
    vsb_t vrl_m_asr
  end
  if eq sh 3
    vsb_t vrl_m_ror
  end
end

fn vsb_dis_rrr w ulong op ulong sf ulong rd ulong rn ulong rm ulong to void
  vsb_rrr_name op
  vsb_c 32
  vsb_reg sf rd
  vsb_t vrl_m_cs
  vsb_reg sf rn
  vsb_t vrl_m_cs
  vsb_reg sf rm
  i6 = and shr w 10 63
  if and ne op 3 ne i6 0
    vsb_t vrl_m_cs
    vsb_shift_name and shr w 22 3
    vsb_c 32
    vsb_c 35
    vsb_u i6
  end
end

fn vsb_dis_wide w ulong op ulong sf ulong rd ulong imm ulong to void
  if eq op 7
    vsb_t vrl_m_movz
  else
    vsb_t vrl_m_movk
  end
  vsb_c 32
  vsb_reg sf rd
  vsb_t vrl_m_hash
  vsb_x imm 1
  hw = and shr w 21 3
  if ne hw 0
    vsb_t vrl_m_lslh
    vsb_u mul hw 16
  end
end

fn vsb_dis_branch op ulong sf ulong rd ulong bi ulong cond ulong to void
  if eq op 9
    vsb_t vrl_m_b
    vsb_x bi 1
    ret
  end
  if eq op 10
    vsb_t vrl_m_bc
    vsb_u cond
  else
    if eq op 11
      vsb_t vrl_m_cbz
    else
      vsb_t vrl_m_cbnz
    end
    vsb_reg sf rd
  end
  vsb_t vrl_m_i19
  vsb_x bi 1
end

fn vsb_dis_other op ulong w ulong to void
  if eq op 14
    vsb_t vrl_m_adr
    ret
  end
  if eq op 15
    vsb_t vrl_m_ldr
    ret
  end
  if eq op 16
    vsb_t vrl_m_str
    ret
  end
  if eq op 17
    vsb_t vrl_m_ldrb
    ret
  end
  if eq op 18
    vsb_t vrl_m_strb
    ret
  end
  if eq op 19
    vsb_t vrl_m_subs
    ret
  end
  vsb_t vrl_m_word
  vsb_x w 8
end

note one disassembly line of word w into vsb
fn vsb_dis w ulong to void
  vsb_reset
  vsb_x w 8
  vsb_c 32
  vsb_c 32
  d = new ulong 9 0
  if ne a64decode w d 0
    vsb_t vrl_m_word
    vsb_x w 8
    ret
  end
  op = get d 0
  if le op 6
    vsb_dis_rrr w op get d 1 get d 2 get d 3 get d 4
    ret
  end
  if or eq op 7 eq op 13
    vsb_dis_wide w op get d 1 get d 2 get d 5
    ret
  end
  if eq op 8
    vsb_t vrl_m_ret
    ret
  end
  if and ge op 9 le op 12
    vsb_dis_branch op get d 1 get d 2 get d 7 get d 8
    ret
  end
  vsb_dis_other op w
end

fn vrl_disasm v ulong r ulong to void
  n = vro_g r VRO_CLEN
  cnt = ulong 0
  off = ulong 0
  while le add off 4 n bound 1024
    if ge cnt 64
      break
    end
    vsb_dis vro_word r off
    vrv_set v add VF_DIS cnt
    cnt = add cnt 1
    off = add off 4
  end
  vrv_p v VW_DCNT cnt
end

note ---- run gate ----
text vrl_r_bw "Blackwell target: requires GPU submit authority; not linked in Visor V1"
text vrl_r_tg1 "target '"
text vrl_r_tg2 "' is not an AArch64 target"
text vrl_r_pr1 "profile 0x"
text vrl_r_pr2 " is not AArch64 v8a (0x01)"
text vrl_r_len1 "code length "
text vrl_r_len2 " / entry offset "
text vrl_r_len3 " not runnable"
text vrl_r_val "code validation failed: "
text vrl_r_und1 "undecodable instruction 0x"
text vrl_r_at " at +"
text vrl_r_noret "code does not end in RET"
text vrl_r_early "RET before end of code at +"
text vrl_r_np1 "non-pure instruction 0x"
text vrl_r_np2 " (branch/load/store not allowed)"
text vrl_r_ok "pure AArch64 register-only code ending in RET; executes natively on host"

fn vrl_rwhy_set to void
  n = get vsb_n 0
  if gt n 159
    n = 159
  end
  for i ulong n bound 160
    put vrl_rwhy i get vsb_b i
  end
  put vrl_rwl 0 n
end

fn vrl_rwhy_txt t view uchar * to long
  vsb_reset
  vsb_t t
  vrl_rwhy_set
  ret -3
end

fn vrl_is_bw e ulong to bool
  if vre_tn_is e vrl_t_bw
    ret true
  end
  if eq vre_g e VE_HASEM 1
    u = vmch_blackwell_id
    b = vre_ib e 1
    for i ulong 32
      if ne get vre_ids add b i get vmch_bw_id i
        ret false
      end
    end
    if lt u -999
      ret false
    end
    ret true
  end
  ret false
end

fn vrl_tgt_a64 e ulong to bool
  if vre_tn_is e vrl_t_a64
    ret true
  end
  if vre_tn_is e vrl_t_dgx
    ret true
  end
  ret vre_tn_is e vrl_t_qemu
end

note the per-instruction loop of run_check; 0 or -3 with the reason
fn vrl_scan r ulong to long
  n = vro_g r VRO_CLEN
  d = new ulong 9 0
  off = ulong 0
  while lt off n bound 1024
    w = vro_word r off
    if ne a64decode w d 0
      vsb_reset
      vsb_t vrl_r_und1
      vsb_x w 8
      vsb_t vrl_r_at
      vsb_u off
      vrl_rwhy_set
      ret -3
    end
    op = get d 0
    last = eq add off 4 n
    if or and ge op 1 le op 7 eq op 13
      if last
        ret vrl_rwhy_txt vrl_r_noret
      end
    else
      if eq op 8
        if not last
          vsb_reset
          vsb_t vrl_r_early
          vsb_u off
          vrl_rwhy_set
          ret -3
        end
      else
        vsb_reset
        vsb_t vrl_r_np1
        vsb_x w 8
        vsb_t vrl_r_at
        vsb_u off
        vsb_t vrl_r_np2
        vrl_rwhy_set
        ret -3
      end
    end
    off = add off 4
  end
  ret 0
end

note run_check(e): 0 runnable, -3 refused (reason in vrl_rwhy)
fn vrl_run_check e ulong to long
  if vrl_is_bw e
    ret vrl_rwhy_txt vrl_r_bw
  end
  if not vrl_tgt_a64 e
    vsb_reset
    vsb_t vrl_r_tg1
    vsb_tn_e e 31
    vsb_t vrl_r_tg2
    vrl_rwhy_set
    ret -3
  end
  r = vre_r e
  pr = vro_g r VRO_PROF
  if ne pr 1
    vsb_reset
    vsb_t vrl_r_pr1
    vsb_x pr 2
    vsb_t vrl_r_pr2
    vrl_rwhy_set
    ret -3
  end
  n = vro_g r VRO_CLEN
  if or or eq n 0 ne rem n 4 0 or gt n 4096 ne vro_g r VRO_EOFF 0
    vsb_reset
    vsb_t vrl_r_len1
    vsb_u n
    vsb_t vrl_r_len2
    vsb_u vro_g r VRO_EOFF
    vsb_t vrl_r_len3
    vrl_rwhy_set
    ret -3
  end
  if ne vro_validate r 0
    vsb_reset
    vsb_t vrl_r_val
    vsb_vmsg 80
    vrl_rwhy_set
    ret -3
  end
  if ne vrl_scan r 0
    ret -3
  end
  u = vrl_rwhy_txt vrl_r_ok
  if lt u -999
    ret -3
  end
  ret 0
end

note ---- execution (interpreter of the run_check subset) ----
fn vrl_m32 sf ulong to ulong
  if eq sf 1
    ret 18446744073709551615
  end
  ret 4294967295
end

note shifted register operand: type sh, amount a, width by sf; -2 marker via vrl_out unused
fn vrl_shift v ulong sh ulong a ulong sf ulong to ulong
  m = vrl_m32 sf
  x = and v m
  if eq a 0
    ret x
  end
  wb = ulong 32
  if eq sf 1
    wb = 64
  end
  if eq sh 0
    ret and shl x a m
  end
  if eq sh 1
    ret shr x a
  end
  if eq sh 2
    top = and shr x sub wb 1 1
    r = shr x a
    if eq top 1
      r = or r and xor shr m a m m
    end
    ret r
  end
  ret and or shr x a shl x sub wb a m
end

fn vrl_reg rg edit ulong 32 r ulong to ulong
  if eq r 31
    ret 0
  end
  ret get rg r
end

fn vrl_wreg rg edit ulong 32 r ulong v ulong to void
  if ne r 31
    put rg r v
  end
end

note one data-processing instruction; 0 ok, -1 the CPU would reject it
fn vrl_step_rrr rg edit ulong 32 w ulong d edit ulong 9 to long
  op = get d 0
  sf = get d 1
  m = vrl_m32 sf
  sh = and shr w 22 3
  a = and shr w 10 63
  if and eq sf 0 ge a 32
    ret -1
  end
  if and eq sh 3 le op 2
    ret -1
  end
  x = and vrl_reg rg get d 3 m
  y = and vrl_reg rg get d 4 m
  res = ulong 0
  if eq op 3
    res = mul x y
  else
    z = vrl_shift y sh a sf
    if eq op 1
      res = add x z
    end
    if eq op 2
      res = sub x z
    end
    if eq op 4
      res = and x z
    end
    if eq op 5
      res = or x z
    end
    if eq op 6
      res = xor x z
    end
  end
  vrl_wreg rg get d 2 and res m
  ret 0
end

fn vrl_step_wide rg edit ulong 32 d edit ulong 9 to long
  op = get d 0
  sf = get d 1
  hw = get d 6
  if and eq sf 0 ge hw 2
    ret -1
  end
  sa = mul hw 16
  imm = shl get d 5 sa
  rd = get d 2
  v = imm
  if eq op 13
    keep = xor shl 65535 sa 18446744073709551615
    v = or and vrl_reg rg rd keep imm
  end
  vrl_wreg rg rd and v vrl_m32 sf
  ret 0
end

note omega_exec_native_f3(r, a, b, c): 0 with vrl_out = x0 at RET, or -1
fn vrl_exec r ulong a ulong b ulong c ulong to long
  rg = new ulong 32 0
  put rg 0 a
  put rg 1 b
  put rg 2 c
  d = new ulong 9 0
  n = vro_g r VRO_CLEN
  off = ulong 0
  while lt off n bound 1024
    w = vro_word r off
    if ne a64decode w d 0
      ret -1
    end
    op = get d 0
    if eq op 8
      put vrl_out 0 get rg 0
      ret 0
    end
    rc = long -1
    if le op 6
      rc = vrl_step_rrr rg w d
    end
    if or eq op 7 eq op 13
      rc = vrl_step_wide rg d
    end
    if ne rc 0
      ret -1
    end
    off = add off 4
  end
  ret -1
end

note visor_realization_run_pure(e, args, argc): 0 with vrl_run_out, -3 refused, -1 failed
fn vrl_run_pure e ulong argc ulong a0 ulong a1 ulong a2 ulong to long
  if gt argc 3
    ret -3
  end
  if and eq vre_g e VE_VK 1 eq vre_g e VE_COMPAT 0
    ret -3
  end
  if ne vrl_run_check e 0
    ret -3
  end
  x = ulong 0
  y = ulong 0
  z = ulong 0
  if gt argc 0
    x = a0
  end
  if gt argc 1
    y = a1
  end
  if gt argc 2
    z = a2
  end
  if ne vrl_exec vre_r e x y z 0
    ret -1
  end
  put vrl_run_out 0 get vrl_out 0
  ret 0
end


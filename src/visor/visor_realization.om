  ob_putc uchar 41
  ob_putc uchar 10
  ob_puts vrl_t_bound
  ob_vf v VF_BID
  ob_putc uchar 10
end

fn vrl_text_mid v ulong to void
  ob_puts vrl_t_tgt
  ob_vf v VF_TARGET
  ob_puts vrl_t_prof
  ob_x vrv_g v VW_PROF 2
  ob_putc uchar 10
  ob_puts vrl_t_code
  ob_put_u64 vrv_g v VW_CLEN
  ob_puts vrl_t_cb
  ob_put_u64 vrv_g v VW_INSN
  ob_puts vrl_t_ci
  dc = vrv_g v VW_DCNT
  for i ulong dc bound 64
    ob_puts vrl_f_sp4
    ob_vf v add VF_DIS i
    ob_putc uchar 10
  end
  ob_puts vrl_t_comp
  ob_yn vrv_g v VW_COMPAT
  ob_putc uchar 10
  ob_puts vrl_t_run
  ob_yn vrv_g v VW_RUN
  ob_putc uchar 10
  ob_puts vrl_t_why
  ob_vf v VF_WHY
  ob_putc uchar 10
end

note visor_realization_format_text(v, n)
fn vrl_format_text v ulong n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  vrl_text_head v
  vrl_text_mid v
  vrl_cost_text_body v
  ret ob_done
end

text vrl_k_label "{\"label\":"
text vrl_k_rid ",\"realization_id\":"
text vrl_k_sid ",\"subject_id\":"
text vrl_k_zid ",\"realized_id\":"
text vrl_k_mid ",\"machine_id\":"
text vrl_k_mname ",\"machine_name\":"
text vrl_k_bid ",\"bound_machine_id\":"
text vrl_k_tgt ",\"target\":"
text vrl_k_prof ",\"profile\":"
text vrl_k_clen ",\"code_len\":"
text vrl_k_insn ",\"insn_count\":"
text vrl_k_dis ",\"disasm\":["
text vrl_k_comp "],\"compatible\":"
text vrl_k_run ",\"runnable\":"
text vrl_k_why ",\"why\":"
text vrl_k_cost ",\"cost\":"

fn vrl_json_head v ulong to void
  ob_puts vrl_k_label
  ob_jvf v VF_LABEL
  ob_puts vrl_k_rid
  ob_jvf v VF_RID
  ob_puts vrl_k_sid
  ob_jvf v VF_SID
  ob_puts vrl_k_zid
  ob_jvf v VF_ZID
  ob_puts vrl_k_mid
  ob_jvf v VF_MID
  ob_puts vrl_k_mname
  ob_jvf v VF_MNAME
  ob_puts vrl_k_bid
  ob_jvf v VF_BID
  ob_puts vrl_k_tgt
  ob_jvf v VF_TARGET
end

fn vrl_json_mid v ulong to void
  ob_puts vrl_k_prof
  ob_put_u64 vrv_g v VW_PROF
  ob_puts vrl_k_clen
  ob_put_u64 vrv_g v VW_CLEN
  ob_puts vrl_k_insn
  ob_put_u64 vrv_g v VW_INSN
  ob_puts vrl_k_dis
  dc = vrv_g v VW_DCNT
  for i ulong dc bound 64
    if gt i 0
      ob_putc uchar 44
    end
    ob_jvf v add VF_DIS i
  end
  ob_puts vrl_k_comp
  ob_tf vrv_g v VW_COMPAT
  ob_puts vrl_k_run
  ob_tf vrv_g v VW_RUN
  ob_puts vrl_k_why
  ob_jvf v VF_WHY
  ob_puts vrl_k_cost
end

note visor_realization_format_json(v, n)
fn vrl_format_json v ulong n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  vrl_json_head v
  vrl_json_mid v
  vrl_cost_json_body v
  ob_putc uchar 125
  ret ob_done
end

text vrl_q_head "compare A="
text vrl_q_b " B="
text vrl_q_rid "  realization_id "
text vrl_q_same "same"
text vrl_q_diff "different"
text vrl_q_code "  code           "
text vrl_q_ident "identical"
text vrl_q_ca " (A "
text vrl_q_cb " insns, B "
text vrl_q_cc " insns)\n"
text vrl_q_prof "  profile        A=0x"
text vrl_q_on " on "
text vrl_q_pb ") B=0x"
text vrl_q_comp "  compatible     A="
text vrl_q_runa "; runnable A="
text vrl_q_cost "  cost (per class; classes never mixed)\n"
text vrl_q_a " A="
text vrl_q_equal "equal"
text vrl_q_alow "A lower"
text vrl_q_blow "B lower"
text vrl_q_sa ")  [A: "
text vrl_q_sb "] [B: "
text vrl_q_present "present"
text vrl_q_absent "ABSENT"
text vrl_q_nc "  (not compared)\n"

fn vrl_label_rid v ulong to void
  if eq vrv_len v VF_LABEL 0
    ob_vf v VF_RID
  else
    ob_vf v VF_LABEL
  end
end

fn vrl_same_code a ulong b ulong to bool
  if ne vrv_g a VW_CLEN vrv_g b VW_CLEN
    ret false
  end
  dc = vrv_g a VW_DCNT
  if ne dc vrv_g b VW_DCNT
    ret false
  end
  for i ulong dc bound 64
    if not vrv_feq a add VF_DIS i b add VF_DIS i
      ret false
    end
  end
  ret true
end

fn vrl_cmp_prof v ulong to void
  ob_x vrv_g v VW_PROF 2
  ob_putc uchar 32
  ob_putc uchar 40
  ob_vf v VF_TARGET
  ob_puts vrl_q_on
  ob_vf v VF_MNAME
end

fn vrl_cmp_head a ulong b ulong to void
  ob_puts vrl_q_head
  vrl_label_rid a
  ob_puts vrl_q_b
  vrl_label_rid b
  ob_putc uchar 10
  ob_puts vrl_q_rid
  if vrv_feq a VF_RID b VF_RID
    ob_puts vrl_q_same
  else
    ob_puts vrl_q_diff
  end
  ob_putc uchar 10
  ob_puts vrl_q_code
  if vrl_same_code a b
    ob_puts vrl_q_ident
  else
    ob_puts vrl_q_diff
  end
  ob_puts vrl_q_ca
  ob_put_u64 vrv_g a VW_INSN
  ob_puts vrl_q_cb
  ob_put_u64 vrv_g b VW_INSN
  ob_puts vrl_q_cc
  ob_puts vrl_q_prof
  vrl_cmp_prof a
  ob_puts vrl_q_pb
  vrl_cmp_prof b
  ob_putc uchar 41
  ob_putc uchar 10
end

fn vrl_pres_txt p ulong to void
  if eq p 1
    ob_puts vrl_q_present
  else
    ob_puts vrl_q_absent
  end
end

fn vrl_cmp_cost a ulong b ulong i ulong to void
  ob_puts vrl_f_sp2
  vrl_ci_name i
  pa = vrv_ci a i 0
  pb = vrv_ci b i 0
  if and eq pa 1 eq pb 1
    ca = vrv_ci a i 2
    cb = vrv_ci b i 2
    ob_puts vrl_q_a
    ob_put_u64 ca
    ob_puts vrl_q_b
    ob_put_u64 cb
    ob_putc uchar 32
    ob_putc uchar 40
    if eq ca cb
      ob_puts vrl_q_equal
    else
      if lt ca cb
        ob_puts vrl_q_alow
      else
        ob_puts vrl_q_blow
      end
    end
    ob_puts vrl_q_sa
    ob_vf a add VF_SRC i
    ob_puts vrl_q_sb
    ob_vf b add VF_SRC i
    ob_puts vrl_f_rb
  else
    ob_puts vrl_q_a
    vrl_pres_txt pa
    ob_puts vrl_q_b
    vrl_pres_txt pb
    ob_puts vrl_q_nc
  end
end

note visor_realization_compare(a, b, n)
fn vrl_compare a ulong b ulong n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  vrl_cmp_head a b
  ob_puts vrl_q_comp
  ob_yn vrv_g a VW_COMPAT
  ob_puts vrl_q_b
  ob_yn vrv_g b VW_COMPAT
  ob_puts vrl_q_runa
  ob_yn vrv_g a VW_RUN
  ob_puts vrl_q_b
  ob_yn vrv_g b VW_RUN
  ob_putc uchar 10
  ob_puts vrl_q_cost
  for i ulong 4
    vrl_cmp_cost a b i
  end
  ret ob_done
end

note ---- Visor session shims (console, verify): session realization r is entry r (r < 16) ----
note Realize into staging entry VRL_SE / view VRL_SV with the session machine (machine slot 0),
note keep one entry per (realization id, subject, target) as om_add_entry, and mirror it into
note the session store v_real_* the console and verify read (code mirrored up to 256 bytes).
note A session program is rebuilt as omega_lower.c builds it: the body steps in application
note order, u64 -> u64, precondition = requires text, postcondition = ensures text, v2 id.
const VRL_SE ulong 22
const VRL_SV ulong 22
const VRL_SP ulong 14
const VRL_SMG ulong 0


text vrl_w_incompat "INCOMPATIBLE"
text vrl_w_full "too many realizations in this session"

fn vrs_why_view v ulong to void
  n = vrv_len v VF_WHY
  b = add mul v VRL_VSTR vrv_off VF_WHY
  for i ulong n bound 256
    put vrs_why i get vrv_str add b i
  end
  put vrs_wlen 0 n
end

fn vrs_why_txt t view uchar * to long
  n = len t
  for i ulong n bound 256
    put vrs_why i get t i
  end
  put vrs_wlen 0 n
  ret -1
end

fn vrs_same_ids a ulong b ulong to bool
  ra = vro_ib vre_r a VRO_K_RID
  rb = vro_ib vre_r b VRO_K_RID
  for i ulong 32
    if ne get vro_id add ra i get vro_id add rb i
      ret false
    end
  end
  sa = vre_ib a 0
  sb = vre_ib b 0
  for i ulong 32
    if ne get vre_ids add sa i get vre_ids add sb i
      ret false
    end
  end
  ret true
end

fn vre_tn_byte e ulong i ulong to ulong
  ret ulong get vre_tn add mul e 32 i
end

fn vrs_same a ulong b ulong to bool
  if not vrs_same_ids a b
    ret false
  end
  n = vre_g a VE_TLEN
  if ne n vre_g b VE_TLEN
    ret false
  end
  for i ulong n bound 32
    if ne vre_tn_byte a i vre_tn_byte b i
      ret false
    end
  end
  ret true
end

fn vrs_mirror_ids r ulong to void
  e = vre_r r
  rb = mul r 32
  for i ulong 32
    put v_real_id add rb i get vro_id add vro_ib e VRO_K_RID i
    put v_real_sem_id add rb i get vro_id add vro_ib e VRO_K_SEM i
    put v_real_bound_mach add rb i get vro_id add vro_ib e VRO_K_MACH i
    put v_real_subj_id add rb i get vre_ids add vre_ib r 0 i
    put v_real_mach_id add rb i get vre_ids add vre_ib r 1 i
  end
end

fn vrs_mirror_txt r ulong to void
  tl = vre_g r VE_TLEN
  for i ulong tl bound 32
    put v_real_tname add mul r 32 i get vre_tn add mul r 32 i
  end
  put v_real_tlen r tl
  il = vre_g r VE_RLEN
  for i ulong il bound 128
    put v_real_incompat add mul r 128 i get vre_ir add mul r 128 i
  end
  put v_real_ilen r il
end

fn vrs_mirror_code r ulong to void
  e = vre_r r
  cl = vro_g e VRO_CLEN
  put v_real_clen r cl
  if gt cl 256
    cl = 256
  end
  cb = mul r 256
  eb = mul e 4096
  for i ulong cl bound 256
    put v_real_code add cb i get vro_code add eb i
  end
end

fn vrs_mirror r ulong to void
  vrs_mirror_ids r
  e = vre_r r
  put v_real_is_prog r vre_g r VE_SUBJP
  put v_real_pidx r get vre_pidx r
  put v_real_has_mach r vre_g r VE_HASEM
  put v_real_has_bmach r vro_g e VRO_HASM
  put v_real_prof r vro_g e VRO_PROF
  put v_real_est r vre_g r VE_EST
  put v_real_has_est r vre_g r VE_HASEST
  put v_real_vknown r vre_g r VE_VK
  put v_real_compat r vre_g r VE_COMPAT
  vrs_mirror_txt r
  vrs_mirror_code r
end

note store the staging entry: the session index, or -1 (why set)
fn vrs_store to long
  cnt = get v_real_cnt 0
  for i ulong cnt bound 16
    if vrs_same i VRL_SE
      ret long i
    end
  end
  if ge cnt V_MAX_REALS
    ret vrs_why_txt vrl_w_full
  end
  vre_copy cnt VRL_SE
  vrs_mirror cnt
  put v_real_cnt 0 add cnt 1
  ret long cnt
end

note console realize/run of an object (graph index oi)
fn vrs_realize_apply oi ulong to long
  og_tmp_from_obj oi
  if ne vrl_realize_apply VRL_SMG VRL_SE VRL_SV 0
    vrs_why_view VRL_SV
    ret -1
  end
  ret vrs_store
end

fn vrs_prog_txt pidx ulong k ulong to void
  vsb_reset
  if eq k 1
    n = get v_prog_rlen pidx
    for i ulong n bound 64
      vsb_c ulong get v_prog_req add mul pidx 64 i
    end
  else
    n2 = get v_prog_elen pidx
    for i ulong n2 bound 64
      vsb_c ulong get v_prog_ens add mul pidx 64 i
    end
  end
  vsb_trunc 63
end

fn vrs_prog_steps pidx ulong p ulong to void
  sc = get v_prog_scnt pidx
  vpg_p p VPG_HASB 1
  vpg_p p VPG_SCNT sc
  db = mul p 64
  sb = mul pidx 64
  for i ulong sc bound 64
    put vpg_op add db i get v_prog_sop add sb i
    put vpg_imm add db i get v_prog_simm add sb i
  end
end

note the session program pidx as the C lowering's OmegaProgram, in program slot p
fn vrs_prog_from_session pidx ulong p ulong to long
  vsb_reset
  nl = get v_prog_nlen pidx
  for i ulong nl bound 64
    vsb_c ulong get v_prog_name add mul pidx 64 i
  end
  vpg_init_vsb p
  vpg_p p VPG_ITAG V_TY_UINT
  vpg_p p VPG_IW 64
  vpg_p p VPG_OTAG V_TY_UINT
  vpg_p p VPG_OW 64
  vrs_prog_txt pidx 1
  vpg_set_txt p 1 63
  u1 = vpg_constraint_id p 1 V_CONST_PRECONDITION
  vrs_prog_txt pidx 2
  vpg_set_txt p 2 63
  u2 = vpg_constraint_id p 2 V_CONST_POSTCONDITION
  vrs_prog_steps pidx p
  if lt add u1 u2 -999
    ret -1
  end
  ret vpg_compute_id p
end

fn vrs_realize_program pidx ulong to long
  u = vrs_prog_from_session pidx VRL_SP
  if ne vrl_realize_program VRL_SP VRL_SMG VRL_SE VRL_SV 0
    vrs_why_view VRL_SV
    ret -1
  end
  put vre_pidx VRL_SE long pidx
  if lt u -999
    ret -1
  end
  ret vrs_store
end

fn vrs_run ridx ulong a0 ulong a1 ulong a2 ulong argc ulong to long
  ret vrl_run_pure ridx argc a0 a1 a2
end

fn vrs_format_text ridx ulong cap ulong to long
  u = vrl_view ridx VRL_SMG VRL_SV
  if lt u -999
    ret -1
  end
  ret vrl_format_text VRL_SV add cap 1
end

fn vrs_format_json ridx ulong cap ulong to long
  u = vrl_view ridx VRL_SMG VRL_SV
  if lt u -999
    ret -1
  end
  ret vrl_format_json VRL_SV add cap 1
end

fn vrs_format_cost_text ridx ulong cap ulong to long
  u = vrl_cost ridx VRL_SMG VRL_SV
  if lt u -999
    ret -1
  end
  ret vrl_cost_format_text VRL_SV add cap 1
end

fn vrs_format_cost_json ridx ulong cap ulong to long
  u = vrl_cost ridx VRL_SMG VRL_SV
  if lt u -999
    ret -1
  end
  ret vrl_cost_format_json VRL_SV add cap 1
end

note v0 structural check of session realization r: 0, or -1 (detail in vpg_why)
fn vrs_v0 r ulong to long
  ret vro_v0 vre_r r
end

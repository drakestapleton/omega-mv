note ---- SHA-256 globals ----
global v_sha_in uchar 262144
global v_sha_out uchar 32
global v_sha_k uint 64
global v_sha_s uint 8
global v_sha_w uint 64
global v_sha_pad uchar 128

note ---- Output buffer globals ----
global v_ob uchar 65536
global v_ob_len ulong 1
global v_ob_cap ulong 1
global v_ob_ovf ulong 1
global v_numbuf uchar 32
global v_sbuf uchar 4096

note ---- OMG0 Canonical encoder buffer ----
global v_enc uchar 4096
global v_enc_len ulong 1

note ---- OmegaGraph globals (256 objects) ----
note The arrays hold 512 object slots: the session graph is limited to V_MAX_OBJS (256) and
note the slots above it are scratch for the program-id builders (visor_program.om), which
note build into the graph and drop what they added. C builds those ids in a fresh graph, so
note they never depend on how full the session graph is; v_og_scratch lifts the limit to
note V_OG_SLOTS while they run.
const V_OG_SLOTS ulong 512
global v_og_scratch ulong 1
global v_og_cnt ulong 1
global v_og_id uchar 16384
global v_og_has_id ulong 512
global v_og_kind ulong 512
global v_og_plen ulong 512

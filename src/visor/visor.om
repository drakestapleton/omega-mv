note ---- Output buffer helpers ----
fn ob_reset cap ulong to void
  put v_ob_len 0 0
  if gt cap 65535
    put v_ob_cap 0 65535
  else
    put v_ob_cap 0 cap
  end
  put v_ob_ovf 0 0
end

fn ob_putc c uchar to void
  p = get v_ob_len 0
  cap = get v_ob_cap 0
  if ge p cap
    put v_ob_ovf 0 1
    ret
  end
  put v_ob p c
  put v_ob_len 0 add p 1
end

fn ob_puts s view uchar * to void
  n = len s
  for i ulong n bound 4096
    ob_putc get s i
  end
end

fn ob_put_sbuf n ulong to void
  for i ulong n bound 4096
    ob_putc get v_sbuf i
  end
end

fn ob_put_json_sbuf n ulong to void
  ob_putc uchar 34
  for i ulong n bound 4096
    c = ulong get v_sbuf i
    if eq c 34
      ob_putc uchar 92
      ob_putc uchar 34
    else
      if eq c 92
        ob_putc uchar 92
        ob_putc uchar 92
      else
        if eq c 10
          ob_putc uchar 92
          ob_putc uchar 110
        else
          if eq c 13
            ob_putc uchar 92
            ob_putc uchar 114
          else
            if eq c 9
              ob_putc uchar 92
              ob_putc uchar 116
            else
              ob_putc uchar c
            end
          end
        end
      end
    end
  end
  ob_putc uchar 34
end

fn v_copy_txt_sbuf s view uchar * to ulong
  n = len s
  if gt n 4095
    n = 4095
  end
  for i ulong n bound 4096
    put v_sbuf i get s i
  end
  ret n
end

fn ob_put_slice s view uchar * off ulong n ulong to void
  for i ulong n bound 65536
    ob_putc get s add off i
  end
end

fn ob_put_u64 v ulong to void
  if eq v 0
    ob_putc uchar 48
    ret
  end
  x = v
  d = ulong 0
  while gt x 0 bound 24
    put v_numbuf d uchar add 48 rem x 10
    x = div x 10
    d = add d 1
  end
  while gt d 0 bound 24
    d = sub d 1
    ob_putc get v_numbuf d
  end
end

fn ob_put_hex_byte b ulong to void
  hi = and shr b 4 15
  lo = and b 15
  ob_putc get vt_hex hi
  ob_putc get vt_hex lo
end

fn ob_put_hex_id32 id_off ulong is_og ulong to void
  for i ulong 32
    b = ulong 0
    if eq is_og 1
      b = ulong get v_og_id add id_off i
    else
      if eq is_og 2
        b = ulong get v_sha_out i
      else
        b = ulong get v_tmp_id i
      end
    end
    ob_put_hex_byte b
  end
end

fn ob_put_json_str s view uchar * off ulong n ulong to void
  ob_putc uchar 34
  for i ulong n bound 4096
    c = ulong get s add off i
    if eq c 34
      ob_putc uchar 92
      ob_putc uchar 34
    else
      if eq c 92
        ob_putc uchar 92
        ob_putc uchar 92
      else
        if eq c 10
          ob_putc uchar 92
          ob_putc uchar 110
        else
          if eq c 13
            ob_putc uchar 92
            ob_putc uchar 114
          else
            if eq c 9
              ob_putc uchar 92
              ob_putc uchar 116
            else
              ob_putc uchar c
            end
          end
        end
      end
    end
  end
  ob_putc uchar 34
end

fn ob_write_fd fd int to void
  n = get v_ob_len 0
  off = ulong 0
  while lt off n bound 65536
    k = write fd v_ob off sub n off
    if le k 0
      ret
    end
    off = add off ulong k
  end
end

fn v_write_all fd int s view uchar * to void
  n = len s
  off = ulong 0
  while lt off n bound 4096
    k = write fd s off sub n off
    if le k 0
      ret
    end
    off = add off ulong k
  end
end

note ---- SHA-256 ----
fn sha_kinit to void
  put v_sha_k 0 0x428a2f98
  put v_sha_k 1 0x71374491
  put v_sha_k 2 0xb5c0fbcf
  put v_sha_k 3 0xe9b5dba5
  put v_sha_k 4 0x3956c25b
  put v_sha_k 5 0x59f111f1
  put v_sha_k 6 0x923f82a4
  put v_sha_k 7 0xab1c5ed5
  put v_sha_k 8 0xd807aa98
  put v_sha_k 9 0x12835b01
  put v_sha_k 10 0x243185be
  put v_sha_k 11 0x550c7dc3
  put v_sha_k 12 0x72be5d74
  put v_sha_k 13 0x80deb1fe
  put v_sha_k 14 0x9bdc06a7
  put v_sha_k 15 0xc19bf174
  put v_sha_k 16 0xe49b69c1
  put v_sha_k 17 0xefbe4786
  put v_sha_k 18 0x0fc19dc6
  put v_sha_k 19 0x240ca1cc
  put v_sha_k 20 0x2de92c6f
  put v_sha_k 21 0x4a7484aa
  put v_sha_k 22 0x5cb0a9dc
  put v_sha_k 23 0x76f988da
  put v_sha_k 24 0x983e5152
  put v_sha_k 25 0xa831c66d
  put v_sha_k 26 0xb00327c8
  put v_sha_k 27 0xbf597fc7
  put v_sha_k 28 0xc6e00bf3
  put v_sha_k 29 0xd5a79147
  put v_sha_k 30 0x06ca6351
  put v_sha_k 31 0x14292967
  put v_sha_k 32 0x27b70a85
  put v_sha_k 33 0x2e1b2138
  put v_sha_k 34 0x4d2c6dfc
  put v_sha_k 35 0x53380d13
  put v_sha_k 36 0x650a7354
  put v_sha_k 37 0x766a0abb
  put v_sha_k 38 0x81c2c92e
  put v_sha_k 39 0x92722c85
  put v_sha_k 40 0xa2bfe8a1
  put v_sha_k 41 0xa81a664b
  put v_sha_k 42 0xc24b8b70
  put v_sha_k 43 0xc76c51a3
  put v_sha_k 44 0xd192e819
  put v_sha_k 45 0xd6990624
  put v_sha_k 46 0xf40e3585
  put v_sha_k 47 0x106aa070
  put v_sha_k 48 0x19a4c116
  put v_sha_k 49 0x1e376c08
  put v_sha_k 50 0x2748774c
  put v_sha_k 51 0x34b0bcb5
  put v_sha_k 52 0x391c0cb3
  put v_sha_k 53 0x4ed8aa4a
  put v_sha_k 54 0x5b9cca4f
  put v_sha_k 55 0x682e6ff3
  put v_sha_k 56 0x748f82ee
  put v_sha_k 57 0x78a5636f
  put v_sha_k 58 0x84c87814
  put v_sha_k 59 0x8cc70208
  put v_sha_k 60 0x90befffa
  put v_sha_k 61 0xa4506ceb
  put v_sha_k 62 0xbef9a3f7
  put v_sha_k 63 0xc67178f2
end

fn sha_sched_in off ulong to void
  for i ulong 16
    p = add off mul i 4
    w = shl uint get v_sha_in p 24
    w = or w shl uint get v_sha_in add p 1 16
    w = or w shl uint get v_sha_in add p 2 8
    w = or w uint get v_sha_in add p 3
    put v_sha_w i w
  end
  for i ulong 48
    k = add i 16
    a = get v_sha_w sub k 15
    s0 = xor xor rotr a 7 rotr a 18 shr a 3
    b = get v_sha_w sub k 2
    s1 = xor xor rotr b 17 rotr b 19 shr b 10
    put v_sha_w k add add add get v_sha_w sub k 16 s0 get v_sha_w sub k 7 s1
  end
end

fn sha_sched_pad off ulong to void
  for i ulong 16
    p = add off mul i 4
    w = shl uint get v_sha_pad p 24
    w = or w shl uint get v_sha_pad add p 1 16
    w = or w shl uint get v_sha_pad add p 2 8
    w = or w uint get v_sha_pad add p 3
    put v_sha_w i w
  end
  for i ulong 48
    k = add i 16
    a = get v_sha_w sub k 15
    s0 = xor xor rotr a 7 rotr a 18 shr a 3
    b = get v_sha_w sub k 2
    s1 = xor xor rotr b 17 rotr b 19 shr b 10
    put v_sha_w k add add add get v_sha_w sub k 16 s0 get v_sha_w sub k 7 s1
  end
end

fn sha_s1 x uint to uint
  ret xor xor rotr x 6 rotr x 11 rotr x 25
end

fn sha_s0 x uint to uint
  ret xor xor rotr x 2 rotr x 13 rotr x 22
end

fn sha_ch e uint f uint g uint to uint
  ret xor and e f and not e g
end

fn sha_maj a uint b uint c uint to uint
  ret xor xor and a b and a c and b c
end

fn sha_rounds to void
  a = get v_sha_s 0
  b = get v_sha_s 1
  c = get v_sha_s 2
  d = get v_sha_s 3
  e = get v_sha_s 4
  f = get v_sha_s 5
  g = get v_sha_s 6
  h = get v_sha_s 7
  for i ulong 64
    t1 = add h sha_s1 e
    t1 = add t1 sha_ch e f g
    t1 = add t1 get v_sha_k i
    t1 = add t1 get v_sha_w i
    t2 = sha_s0 a
    t2 = add t2 sha_maj a b c
    h = g
    g = f
    f = e
    e = add d t1
    d = c
    c = b
    b = a
    a = add t1 t2
  end
  put v_sha_s 0 add get v_sha_s 0 a
  put v_sha_s 1 add get v_sha_s 1 b
  put v_sha_s 2 add get v_sha_s 2 c
  put v_sha_s 3 add get v_sha_s 3 d
  put v_sha_s 4 add get v_sha_s 4 e
  put v_sha_s 5 add get v_sha_s 5 f
  put v_sha_s 6 add get v_sha_s 6 g
  put v_sha_s 7 add get v_sha_s 7 h
end

fn sha256_hash n ulong to void
  put v_sha_s 0 0x6a09e667
  put v_sha_s 1 0xbb67ae85
  put v_sha_s 2 0x3c6ef372
  put v_sha_s 3 0xa54ff53a
  put v_sha_s 4 0x510e527f
  put v_sha_s 5 0x9b05688c
  put v_sha_s 6 0x1f83d9ab
  put v_sha_s 7 0x5be0cd19
  full = div n 64
  for bi ulong full bound 4096
    sha_sched_in mul bi 64
    sha_rounds
  end
  remb = rem n 64
  for i ulong 128
    put v_sha_pad i uchar 0
  end
  base = mul full 64
  for i ulong remb bound 64
    put v_sha_pad i get v_sha_in add base i
  end
  put v_sha_pad remb uchar 0x80
  pblks = ulong 1
  if ge remb 56
    pblks = 2
  end
  bits = mul n 8
  endoff = sub mul pblks 64 8
  for i ulong 8
    sh = mul sub 7 i 8
    put v_sha_pad add endoff i uchar and shr bits sh 0xff
  end
  sha_sched_pad 0
  sha_rounds
  if eq pblks 2
    sha_sched_pad 64
    sha_rounds
  end
  for i ulong 8
    w = get v_sha_s i
    p = mul i 4
    put v_sha_out p uchar and shr w 24 0xff
    put v_sha_out add p 1 uchar and shr w 16 0xff
    put v_sha_out add p 2 uchar and shr w 8 0xff
    put v_sha_out add p 3 uchar and w 0xff
  end
end

note ---- OMG0 canonical encoding (omega_canonical.c + om/visor/canonical_om2.om) ----
note Wire form: "OMG0", version (2 for EFFECT, else 1), kind; u16 attribute count,
note attributes sorted by key (u8 key length, key, u16 value length, value);
note u16 relation count, relations sorted by (kind, target) (u16 kind, 32-byte id);
note u16 constraint count, constraints sorted by (kind, payload, length)
note (u16 kind, u16 length, payload); u32 payload length, payload. At most 4096 bytes.
global v_ord ulong 64

fn v_enc_u16be pos ulong v ulong to ulong
  put v_enc pos uchar and shr v 8 0xff
  put v_enc add pos 1 uchar and v 0xff
  ret add pos 2
end

fn v_enc_u32be pos ulong v ulong to ulong
  put v_enc pos uchar and shr v 24 0xff
  put v_enc add pos 1 uchar and shr v 16 0xff
  put v_enc add pos 2 uchar and shr v 8 0xff
  put v_enc add pos 3 uchar and v 0xff
  ret add pos 4
end

fn v_enc_u16le_pay base ulong off ulong v ulong to void
  put v_og_pay add base off uchar and v 0xff
  put v_og_pay add add base off 1 uchar and shr v 8 0xff
end

fn v_enc_u32le_pay base ulong off ulong v ulong to void
  put v_og_pay add base off uchar and v 0xff
  put v_og_pay add add base off 1 uchar and shr v 8 0xff
  put v_og_pay add add base off 2 uchar and shr v 16 0xff
  put v_og_pay add add base off 3 uchar and shr v 24 0xff
end

fn v_enc_u64le_pay base ulong off ulong v ulong to void
  for i ulong 8
    put v_og_pay add add base off i uchar and shr v mul i 8 0xff
  end
end

fn v_enc_be_pay base ulong off ulong nb ulong v ulong to void
  for i ulong nb bound 8
    sh = mul sub sub nb 1 i 8
    put v_og_pay add add base off i uchar and shr v sh 0xff
  end
end

fn v_dec_u16le_pay base ulong off ulong to ulong
  b0 = ulong get v_og_pay add base off
  b1 = ulong get v_og_pay add add base off 1
  ret or b0 shl b1 8
end

fn v_dec_u32le_pay base ulong off ulong to ulong
  b0 = ulong get v_og_pay add base off
  b1 = ulong get v_og_pay add add base off 1
  b2 = ulong get v_og_pay add add base off 2
  b3 = ulong get v_og_pay add add base off 3
  ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn v_dec_u64le_pay base ulong off ulong to ulong
  r = ulong 0
  for i ulong 8
    b = ulong get v_og_pay add add base off i
    r = or r shl b mul i 8
  end
  ret r
end

note attribute slot a of object idx: key at slot*64, value at slot*512.
fn og_aslot idx ulong a ulong to ulong
  ret add mul idx V_MAX_ATTRS a
end

fn og_rslot idx ulong r ulong to ulong
  ret add mul idx V_MAX_RELS r
end

fn og_cslot idx ulong c ulong to ulong
  ret add mul idx V_MAX_CONSTS c
end

note strcmp of two attribute keys (slots sa, sb).
fn og_cmp_key sa ulong sb ulong to long
  la = get v_og_aklen sa
  lb = get v_og_aklen sb
  ka = mul sa 64
  kb = mul sb 64
  m = la
  if lt lb m
    m = lb
  end
  for k ulong m bound 64
    ca = get v_og_akey add ka k
    cb = get v_og_akey add kb k
    if lt ca cb
      ret -1
    end
    if gt ca cb
      ret 1
    end
  end
  if lt la lb
    ret -1
  end
  if gt la lb
    ret 1
  end
  ret 0
end

fn og_cmp_rel sa ulong sb ulong to long
  ka = get v_og_rkind sa
  kb = get v_og_rkind sb
  if lt ka kb
    ret -1
  end
  if gt ka kb
    ret 1
  end
  ta = mul sa 32
  tb = mul sb 32
  for k ulong 32
    ca = get v_og_rtgt add ta k
    cb = get v_og_rtgt add tb k
    if lt ca cb
      ret -1
    end
    if gt ca cb
      ret 1
    end
  end
  ret 0
end

fn og_cmp_const sa ulong sb ulong to long
  ka = get v_og_ckind sa
  kb = get v_og_ckind sb
  if lt ka kb
    ret -1
  end
  if gt ka kb
    ret 1
  end
  la = get v_og_clen sa
  lb = get v_og_clen sb
  m = la
  if lt lb m
    m = lb
  end
  if gt m 128
    m = 128
  end
  pa = mul sa 128
  pb = mul sb 128
  for k ulong m bound 128
    ca = get v_og_cpay add pa k
    cb = get v_og_cpay add pb k
    if lt ca cb
      ret -1
    end
    if gt ca cb
      ret 1
    end
  end
  if lt la lb
    ret -1
  end
  if gt la lb
    ret 1
  end
  ret 0
end

note sel 0 attributes, 1 relations, 2 constraints: compare entries i and j of object idx.
fn og_cmp_sel sel ulong idx ulong i ulong j ulong to long
  if eq sel 0
    ret og_cmp_key og_aslot idx i og_aslot idx j
  end
  if eq sel 1
    ret og_cmp_rel og_rslot idx i og_rslot idx j
  end
  ret og_cmp_const og_cslot idx i og_cslot idx j
end

note stable insertion sort of v_ord[0..n) (as canon_sort_*).
fn og_sort sel ulong idx ulong n ulong to void
  for i ulong n bound 64
    put v_ord i i
  end
  i = ulong 1
  while lt i n bound 64
    cur = get v_ord i
    j = long sub i 1
    while ge j 0 bound 64
      prev = get v_ord ulong j
      if le og_cmp_sel sel idx prev cur 0
        break
      end
      put v_ord ulong add j 1 prev
      j = sub j 1
    end
    put v_ord ulong add j 1 cur
    i = add i 1
  end
end

fn og_enc_one_attr aslot ulong p0 ulong to long
  kl = get v_og_aklen aslot
  vl = get v_og_avlen aslot
  if gt kl 255
    ret -1
  end
  if gt add add add p0 1 kl add 2 vl 4096
    ret -1
  end
  put v_enc p0 uchar kl
  p = add p0 1
  kbase = mul aslot 64
  for i ulong kl bound 64
    put v_enc add p i get v_og_akey add kbase i
  end
  p = v_enc_u16be add p kl vl
  vbase = mul aslot 512
  for i ulong vl bound 512
    put v_enc add p i get v_og_aval add vbase i
  end
  ret long add p vl
end

fn og_enc_attrs idx ulong p0 ulong to long
  n = get v_og_acnt idx
  if gt n V_MAX_ATTRS
    ret -1
  end
  og_sort 0 idx n
  p = long v_enc_u16be p0 n
  for a ulong n bound 32
    if lt p 0
      ret -1
    end
    p = og_enc_one_attr og_aslot idx get v_ord a ulong p
  end
  ret p
end

fn og_enc_one_rel rslot ulong p0 ulong to long
  if gt add p0 34 4096
    ret -1
  end
  p = v_enc_u16be p0 get v_og_rkind rslot
  tbase = mul rslot 32
  for i ulong 32
    put v_enc add p i get v_og_rtgt add tbase i
  end
  ret long add p 32
end

fn og_enc_rels idx ulong p0 ulong to long
  n = get v_og_rcnt idx
  if gt n V_MAX_RELS
    ret -1
  end
  og_sort 1 idx n
  if gt add p0 2 4096
    ret -1
  end
  p = long v_enc_u16be p0 n
  for r ulong n bound 64
    if lt p 0
      ret -1
    end
    p = og_enc_one_rel og_rslot idx get v_ord r ulong p
  end
  ret p
end

fn og_enc_one_const cslot ulong p0 ulong to long
  cl = get v_og_clen cslot
  if gt add add p0 4 cl 4096
    ret -1
  end
  p = v_enc_u16be p0 get v_og_ckind cslot
  p = v_enc_u16be p cl
  cbase = mul cslot 128
  for i ulong cl bound 128
    put v_enc add p i get v_og_cpay add cbase i
  end
  ret long add p cl
end

fn og_enc_consts idx ulong p0 ulong to long
  n = get v_og_ccnt idx
  if gt n V_MAX_CONSTS
    ret -1
  end
  og_sort 2 idx n
  if gt add p0 2 4096
    ret -1
  end
  p = long v_enc_u16be p0 n
  for c ulong n bound 32
    if lt p 0
      ret -1
    end
    p = og_enc_one_const og_cslot idx get v_ord c ulong p
  end
  ret p
end

fn og_kind_version kind ulong to ulong
  if eq kind V_KIND_EFFECT
    ret 2
  end
  ret 1
end

fn og_canonical_encode idx ulong to long
  kind = get v_og_kind idx
  put v_enc 0 uchar 0x4f
  put v_enc 1 uchar 0x4d
  put v_enc 2 uchar 0x47
  put v_enc 3 uchar 0x30
  put v_enc 4 uchar og_kind_version kind
  put v_enc 5 uchar and kind 0xff
  p = og_enc_attrs idx 6
  if lt p 0
    ret -1
  end
  p = og_enc_rels idx ulong p
  if lt p 0
    ret -1
  end
  p = og_enc_consts idx ulong p
  if lt p 0
    ret -1
  end
  plen = get v_og_plen idx
  up = ulong p
  if gt plen V_MAX_PAYLOAD
    ret -1
  end
  if gt add add up 4 plen 4096
    ret -1
  end
  q = v_enc_u32be up plen
  pbase = mul idx V_MAX_PAYLOAD
  for i ulong plen bound 1024
    put v_enc add q i get v_og_pay add pbase i
  end
  q = add q plen
  put v_enc_len 0 q
  ret long q
end

note sha256 of the canonical encoding into v_sha_out; -1 if it does not encode.
fn og_hash_encoding idx ulong to long
  elen = og_canonical_encode idx
  if lt elen 0
    ret -1
  end
  n = ulong elen
  for i ulong n bound 4096
    put v_sha_in i get v_enc i
  end
  if eq get v_sha_k 0 0
    sha_kinit
  end
  sha256_hash n
  ret elen
end

note omega_compute_semantic_id: on failure the object keeps its old id state.
fn og_compute_id idx ulong to long
  if lt og_hash_encoding idx 0
    ret -1
  end
  ibase = mul idx 32
  for i ulong 32
    put v_og_id add ibase i get v_sha_out i
  end
  put v_og_has_id idx 1
  ret 0
end

fn og_reset to void
  put v_og_cnt 0 0
end

fn og_id_eq_sha idx ulong to bool
  base = mul idx 32
  for i ulong 32
    if ne get v_og_id add base i get v_sha_out i
      ret false
    end
  end
  ret true
end

fn og_id_eq_tmp idx ulong to bool
  base = mul idx 32
  for i ulong 32
    if ne get v_og_id add base i get v_tmp_id i
      ret false
    end
  end
  ret true
end

fn og_id_eq_pair a ulong b ulong to bool
  ba = mul a 32
  bb = mul b 32
  for i ulong 32
    if ne get v_og_id add ba i get v_og_id add bb i
      ret false
    end
  end
  ret true
end

note omega_graph_find_object: first object with an id equal to v_sha_out / v_tmp_id.
fn og_find_by_sha to long
  cnt = get v_og_cnt 0
  for i ulong cnt bound 256
    if eq get v_og_has_id i 1
      if og_id_eq_sha i
        ret long i
      end
    end
  end
  ret -1
end

fn og_find_by_tmp to long
  cnt = get v_og_cnt 0
  for i ulong cnt bound 256
    if eq get v_og_has_id i 1
      if og_id_eq_tmp i
        ret long i
      end
    end
  end
  ret -1
end

note omega_graph_add_object: a zeroed object of this kind, or -1 when the graph is full.
fn og_add_object kind ulong to long
  cnt = get v_og_cnt 0
  lim = V_MAX_OBJS
  if ne get v_og_scratch 0 0
    lim = V_OG_SLOTS
  end
  if ge cnt lim
    ret -1
  end
  put v_og_kind cnt kind
  put v_og_plen cnt 0
  put v_og_has_id cnt 0
  put v_og_acnt cnt 0
  put v_og_rcnt cnt 0
  put v_og_ccnt cnt 0
  ib = mul cnt 32
  for i ulong 32
    put v_og_id add ib i uchar 0
  end
  pbase = mul cnt V_MAX_PAYLOAD
  for i ulong V_MAX_PAYLOAD
    put v_og_pay add pbase i uchar 0
  end
  put v_og_cnt 0 add cnt 1
  ret long cnt
end

note Builders compute the id and return the new object (never deduplicated), as omega_build_*.
fn og_finish idx ulong to long
  u = og_compute_id idx
  if lt u -999
    ret -1
  end
  ret long idx
end

fn og_build_type_tw tag ulong w ulong to long
  s = og_add_object V_KIND_TYPE
  if lt s 0
    ret -1
  end
  idx = ulong s
  put v_og_plen idx 44
  pb = mul idx V_MAX_PAYLOAD
  v_enc_u32le_pay pb 0 tag
  v_enc_u16le_pay pb 4 w
  ret og_finish idx
end

fn og_build_type_unit to long
  ret og_build_type_tw V_TY_UNIT 0
end

fn og_build_type_bool to long
  ret og_build_type_tw V_TY_BOOL 0
end

fn og_build_type_uint w ulong to long
  ret og_build_type_tw V_TY_UINT w
end

fn og_build_type_sint w ulong to long
  ret og_build_type_tw V_TY_SINT w
end

fn og_build_type_bitvec w ulong to long
  ret og_build_type_tw V_TY_BITVEC w
end

fn og_build_type_fp32 to long
  ret og_build_type_tw V_TY_FP32 32
end

fn og_build_type_byte to long
  ret og_build_type_tw V_TY_BYTE 8
end

fn og_build_type_cap_ref to long
  ret og_build_type_tw V_TY_CAP_REF 0
end

fn og_build_type_tag tag ulong to long
  ret og_build_type_tw tag 0
end

note sequence of the element type whose id is in v_tmp_id.
fn og_build_type_seq_tmp slen ulong to long
  s = og_add_object V_KIND_TYPE
  if lt s 0
    ret -1
  end
  idx = ulong s
  put v_og_plen idx 44
  pb = mul idx V_MAX_PAYLOAD
  v_enc_u32le_pay pb 0 V_TY_SEQ
  v_enc_u32le_pay pb 8 slen
  for i ulong 32
    put v_og_pay add add pb 12 i get v_tmp_id i
  end
  ret og_finish idx
end

fn og_tmp_from_obj src ulong to void
  sb = mul src 32
  for i ulong 32
    put v_tmp_id i get v_og_id add sb i
  end
end

fn og_build_type_seq elem_idx ulong slen ulong to long
  og_tmp_from_obj elem_idx
  ret og_build_type_seq_tmp slen
end

fn og_copy_id_to_pay dst ulong src_idx ulong to void
  sb = mul src_idx 32
  for i ulong 32
    put v_og_pay add dst i get v_og_id add sb i
  end
end

fn og_build_val_uint tidx ulong w ulong val ulong to long
  s = og_add_object V_KIND_VALUE
  if lt s 0
    ret -1
  end
  idx = ulong s
  put v_og_plen idx 98
  pb = mul idx V_MAX_PAYLOAD
  og_copy_id_to_pay pb tidx
  nb = div add w 7 8
  if eq nb 0
    nb = 1
  end
  if gt nb 64
    nb = 64
  end
  v_enc_u16le_pay pb 32 nb
  lead = ulong 0
  if gt nb 8
    lead = sub nb 8
  end
  v_enc_be_pay pb add 34 lead sub nb lead val
  ret og_finish idx
end

fn og_build_val_bool tidx ulong bv ulong to long
  s = og_add_object V_KIND_VALUE
  if lt s 0
    ret -1
  end
  idx = ulong s
  put v_og_plen idx 98
  pb = mul idx V_MAX_PAYLOAD
  og_copy_id_to_pay pb tidx
  v_enc_u16le_pay pb 32 1
  b = uchar 0
  if ne bv 0
    b = 1
  end
  put v_og_pay add pb 34 b
  ret og_finish idx
end

fn og_build_op_binary opc ulong ovf ulong tidx ulong to long
  s = og_add_object V_KIND_OP
  if lt s 0
    ret -1
  end
  idx = ulong s
  put v_og_plen idx 204
  pb = mul idx V_MAX_PAYLOAD
  v_enc_u32le_pay pb 0 opc
  v_enc_u32le_pay pb 4 ovf
  og_copy_id_to_pay add pb 8 tidx
  put v_og_pay add pb 40 uchar 2
  og_copy_id_to_pay add pb 41 tidx
  og_copy_id_to_pay add pb 73 tidx
  og_copy_id_to_pay add pb 169 tidx
  ret og_finish idx
end

note apply of the operation object opidx to operands a1idx, a2idx.
fn og_build_apply opidx ulong a1idx ulong a2idx ulong to long
  s = og_add_object V_KIND_OP
  if lt s 0
    ret -1
  end
  idx = ulong s
  put v_og_plen idx 161
  pb = mul idx V_MAX_PAYLOAD
  og_copy_id_to_pay pb opidx
  put v_og_pay add pb 32 uchar 2
  og_copy_id_to_pay add pb 33 a1idx
  og_copy_id_to_pay add pb 65 a2idx
  ret og_finish idx
end

note apply by ids: op id in v_tmp_id, first operand in v_tmp_id2, second operand object a2idx.
fn og_build_apply_ids a2idx ulong to long
  s = og_add_object V_KIND_OP
  if lt s 0
    ret -1
  end
  idx = ulong s
  put v_og_plen idx 161
  pb = mul idx V_MAX_PAYLOAD
  for i ulong 32
    put v_og_pay add pb i get v_tmp_id i
    put v_og_pay add add pb 33 i get v_tmp_id2 i
  end
  put v_og_pay add pb 32 uchar 2
  og_copy_id_to_pay add pb 65 a2idx
  ret og_finish idx
end

note Effect payload v2, 178 bytes big-endian (omega_effect_payload_encode):
note [0..1] resource class, [2..3] operation, [4..7] capability slot,
note [8..15] capability generation, [16..47] capability ref, [48..49] param_len,
note [50..177] params (zero padded).
fn og_build_effect res_cls ulong op_code ulong cap_slot ulong cap_gen ulong to long
  s = og_add_object V_KIND_EFFECT
  if lt s 0
    ret -1
  end
  idx = ulong s
  put v_og_plen idx 178
  pb = mul idx V_MAX_PAYLOAD
  v_enc_be_pay pb 0 2 res_cls
  v_enc_be_pay pb 2 2 op_code
  v_enc_be_pay pb 4 4 cap_slot
  v_enc_be_pay pb 8 8 cap_gen
  ret og_finish idx
end

fn og_put_key slot ulong key view uchar * to void
  kl = len key
  put v_og_aklen slot kl
  kb = mul slot 64
  for i ulong kl bound 64
    put v_og_akey add kb i get key i
  end
end

note omega_object_add_attribute: key (shorter than 64 bytes) and value (at most 512 bytes).
fn og_add_attr idx ulong key view uchar * val view uchar * to long
  ac = get v_og_acnt idx
  if ge ac V_MAX_ATTRS
    ret -1
  end
  if ge len key 64
    ret -1
  end
  vl = len val
  if gt vl 512
    ret -1
  end
  for i ulong vl bound 512
    put v_sbuf i get val i
  end
  ret og_add_attr_sbuf idx key vl
end

note value bytes from v_sbuf[0..vl) (for binary values).
fn og_add_attr_sbuf idx ulong key view uchar * vl ulong to long
  ac = get v_og_acnt idx
  if ge ac V_MAX_ATTRS
    ret -1
  end
  if ge len key 64
    ret -1
  end
  if gt vl 512
    ret -1
  end
  slot = og_aslot idx ac
  og_put_key slot key
  put v_og_avlen slot vl
  vb = mul slot 512
  for i ulong vl bound 512
    put v_og_aval add vb i get v_sbuf i
  end
  put v_og_acnt idx add ac 1
  ret 0
end

fn og_add_rel_tmp idx ulong rkind ulong to long
  rc = get v_og_rcnt idx
  if ge rc V_MAX_RELS
    ret -1
  end
  slot = og_rslot idx rc
  put v_og_rkind slot rkind
  tb = mul slot 32
  for i ulong 32
    put v_og_rtgt add tb i get v_tmp_id i
  end
  put v_og_rcnt idx add rc 1
  ret 0
end

fn og_add_rel idx ulong rkind ulong tgt_idx ulong to long
  og_tmp_from_obj tgt_idx
  ret og_add_rel_tmp idx rkind
end

note omega_object_add_constraint: payload from v_sbuf[0..cl), at most 128 bytes.
fn og_add_const_sbuf idx ulong ckind ulong cl ulong to long
  cc = get v_og_ccnt idx
  if ge cc V_MAX_CONSTS
    ret -1
  end
  if gt cl 128
    ret -1
  end
  slot = og_cslot idx cc
  put v_og_ckind slot ckind
  put v_og_clen slot cl
  cb = mul slot 128
  for i ulong cl bound 128
    put v_og_cpay add cb i get v_sbuf i
  end
  put v_og_ccnt idx add cc 1
  ret 0
end

fn og_add_const idx ulong ckind ulong pay view uchar * to long
  cl = len pay
  if gt cl 128
    ret -1
  end
  for i ulong cl bound 128
    put v_sbuf i get pay i
  end
  ret og_add_const_sbuf idx ckind cl
end

text vt_omega_param "omega.param"

note omega_build_param: VALUE with attribute omega.param (2-byte big-endian index), byte_len 0.
fn og_build_param tidx ulong pindex ulong to long
  s = og_add_object V_KIND_VALUE
  if lt s 0
    ret -1
  end
  idx = ulong s
  put v_sbuf 0 uchar and shr pindex 8 0xff
  put v_sbuf 1 uchar and pindex 0xff
  if lt og_add_attr_sbuf idx vt_omega_param 2 0
    ret -1
  end
  put v_og_plen idx 98
  og_copy_id_to_pay mul idx V_MAX_PAYLOAD tidx
  ret og_finish idx
end

note The lowering's dedupe: if object idx (the last appended) equals an earlier one,
note drop it and return the earlier index.
fn og_dedupe idx long to long
  if lt idx 0
    ret idx
  end
  u = ulong idx
  cnt = get v_og_cnt 0
  if eq cnt 0
    ret idx
  end
  lim = sub cnt 1
  for i ulong lim bound 256
    if eq get v_og_has_id i 1
      if og_id_eq_pair i u
        put v_og_cnt 0 lim
        ret long i
      end
    end
  end
  ret idx
end

note ---- VisorSession ----
fn vs_init to void
  sha_kinit
  og_reset
  put v_bind_cnt 0 0
  put v_has_last 0 0
  put v_prog_cnt 0 0
  put v_real_cnt 0 0
end

fn vs_clear to void
  og_reset
  put v_bind_cnt 0 0
  put v_has_last 0 0
  put v_prog_cnt 0 0
  put v_real_cnt 0 0
end

fn vs_bind_find_sbuf n ulong to long
  cnt = get v_bind_cnt 0
  for i ulong cnt bound 64
    if eq get v_bind_nlen i n
      base = mul i 64
      ok = true
      for j ulong n bound 64
        if ne get v_bind_name add base j get v_sbuf j
          ok = false
          break
        end
      end
      if ok
        ret long i
      end
    end
  end
  ret -1
end

note visor_name_ok on v_sbuf[0..n): [A-Za-z_][A-Za-z0-9_.]*, shorter than 64.
fn v_name_char c ulong first bool to bool
  if or and ge c 65 le c 90 and ge c 97 le c 122
    ret true
  end
  if eq c 95
    ret true
  end
  if first
    ret false
  end
  ret or and ge c 48 le c 57 eq c 46
end

fn vs_name_ok_sbuf n ulong to bool
  if or eq n 0 ge n 64
    ret false
  end
  for i ulong n bound 64
    if not v_name_char ulong get v_sbuf i eq i 0
      ret false
    end
  end
  ret true
end

fn vs_bind_set_sbuf n ulong kind ulong pidx0 long to long
  if not vs_name_ok_sbuf n
    ret -1
  end
  if eq kind V_BIND_NONE
    ret -1
  end
  if and eq n 1 eq get v_sbuf 0 95
    ret -1
  end
  pidx = pidx0
  if eq kind V_BIND_OBJECT
    pidx = -1
  end
  ex = vs_bind_find_sbuf n
  slot = ulong 0
  if ge ex 0
    slot = ulong ex
  else
    cnt = get v_bind_cnt 0
    if ge cnt V_MAX_BINDINGS
      ret -1
    end
    slot = cnt
    put v_bind_cnt 0 add cnt 1
    put v_bind_nlen slot n
    nb = mul slot 64
    for i ulong n bound 64
      put v_bind_name add nb i get v_sbuf i
    end
  end
  put v_bind_kind slot kind
  put v_bind_idx slot pidx
  ib = mul slot 32
  for i ulong 32
    put v_bind_id add ib i get v_tmp_id i
  end
  ret long slot
end

fn vs_set_last kind ulong pidx long to void
  put v_has_last 0 1
  put v_last_kind 0 kind
  put v_last_idx 0 pidx
  for i ulong 32
    put v_last_id i get v_tmp_id i
  end
end

fn v_hex_digit c ulong to long
  if and ge c 48 le c 57
    ret long sub c 48
  end
  if and ge c 97 le c 102
    ret long add sub c 97 10
  end
  if and ge c 65 le c 70
    ret long add sub c 65 10
  end
  ret -1
end

fn v_parse_hex_sbuf n ulong to long
  p = ulong 0
  remn = n
  if ge remn 7
    ok = true
    for i ulong 7
      if ne get v_sbuf add p i get vt_sha256_pfx i
        ok = false
      end
    end
    if ok
      p = add p 7
      remn = sub remn 7
    end
  end
  if ne remn 64
    ret -1
  end
  for i ulong 32
    hi = v_hex_digit ulong get v_sbuf add p mul i 2
    lo = v_hex_digit ulong get v_sbuf add add p mul i 2 1
    if or lt hi 0 lt lo 0
      ret -1
    end
    put v_tmp_id i uchar or shl ulong hi 4 ulong lo
  end
  ret 0
end

fn vs_find_prog_tmp to long
  pc = get v_prog_cnt 0
  for i ulong pc bound 16
    pb = mul i 32
    eqp = true
    for j ulong 32
      if ne get v_prog_id add pb j get v_tmp_id j
        eqp = false
        break
      end
    end
    if eqp
      ret long i
    end
  end
  ret -1
end

fn vs_find_real_tmp to long
  rc = get v_real_cnt 0
  for i ulong rc bound 16
    rb = mul i 32
    eqr = true
    for j ulong 32
      if ne get v_real_id add rb j get v_tmp_id j
        eqr = false
        break
      end
    end
    if eqr
      ret long i
    end
  end
  ret -1
end

fn vs_resolve_sbuf n ulong to long
  if eq n 0
    ret -1
  end
  if and eq n 1 eq get v_sbuf 0 uchar 95
    if eq get v_has_last 0 0
      ret -1
    end
    put v_res_kind 0 get v_last_kind 0
    put v_res_idx 0 get v_last_idx 0
    for i ulong 32
      put v_res_id i get v_last_id i
    end
    put v_res_nlen 0 1
    put v_res_name 0 uchar 95
    ret 0
  end
  bi = vs_bind_find_sbuf n
  if ge bi 0
    u = ulong bi
    put v_res_kind 0 get v_bind_kind u
    put v_res_idx 0 get v_bind_idx u
    ib = mul u 32
    for i ulong 32
      put v_res_id i get v_bind_id add ib i
    end
    put v_res_nlen 0 n
    for i ulong n bound 64
      put v_res_name i get v_sbuf i
    end
    ret 0
  end
  if eq v_parse_hex_sbuf n 0
    oi = og_find_by_tmp
    if ge oi 0
      put v_res_kind 0 V_BIND_OBJECT
      put v_res_idx 0 -1
      for i ulong 32
        put v_res_id i get v_tmp_id i
      end
      put v_res_nlen 0 0
      ret 0
    end
    pi = vs_find_prog_tmp
    if ge pi 0
      put v_res_kind 0 V_BIND_PROGRAM
      put v_res_idx 0 pi
      for j ulong 32
        put v_res_id j get v_tmp_id j
      end
      ret 0
    end
    ri = vs_find_real_tmp
    if ge ri 0
      put v_res_kind 0 V_BIND_REALIZATION
      put v_res_idx 0 ri
      for j ulong 32
        put v_res_id j get v_tmp_id j
      end
      ret 0
    end
  end
  ret -1
end

fn v_put_kind_name kind ulong to void
  if eq kind V_KIND_VALUE
    ob_puts vt_k_value
    ret
  end
  if eq kind V_KIND_TYPE
    ob_puts vt_k_type
    ret
  end
  if eq kind V_KIND_OP
    ob_puts vt_k_op
    ret
  end
  if eq kind V_KIND_RELATION
    ob_puts vt_k_relation
    ret
  end
  if eq kind V_KIND_CONSTRAINT
    ob_puts vt_k_constraint
    ret
  end
  if eq kind V_KIND_MEMORY
    ob_puts vt_k_memory
    ret
  end
  if eq kind V_KIND_MACHINE
    ob_puts vt_k_machine
    ret
  end
  if eq kind V_KIND_EFFECT
    ob_puts vt_k_effect
    ret
  end
  if eq kind V_KIND_REALIZATION
    ob_puts vt_k_realization
    ret
  end
  if eq kind V_KIND_EVIDENCE
    ob_puts vt_k_evidence
    ret
  end
  if eq kind V_KIND_PROOF
    ob_puts vt_k_proof
    ret
  end
  ob_puts vt_k_invalid
end

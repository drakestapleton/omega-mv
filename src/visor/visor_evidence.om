note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor V1 lane 4: evidence (receipt) inspection.
note Port of src/visor/visor_evidence.c: strict JSON scanner over one fixed
note buffer and token pool, record extraction (commit, physics, run, machine,
note realization, gates, claim, scope and its basis, tree state, content-hash
note name check), a deterministic sorted directory walk that keeps the
note max-files smallest paths whatever the readdir order, and the text and
note JSON renderings. Records live in 17 slots: 0..15 are the view items,
note slot 16 is the record filled by vev_load.

const VEV_SCOPE_UNKNOWN ulong 0
const VEV_SCOPE_SIMULATED ulong 1
const VEV_SCOPE_HOST ulong 2
const VEV_SCOPE_QEMU ulong 3
const VEV_SCOPE_SILICON ulong 4

const VEV_MAX_ITEMS ulong 16
const VEV_MAX_UNPARSED ulong 8
const VEV_MAX_FILE ulong 262144
const VEV_MAX_FILES ulong 131072
const VEV_REC ulong 16
const VEV_POOL ulong 16777216
const VEV_DSTACK ulong 8192

const VEV_JT_OBJ uchar 1
const VEV_JT_ARR uchar 2
const VEV_JT_STR uchar 3
const VEV_JT_PRIM uchar 4
const VEV_MAX_TOK ulong 32768

const VEV_F_PATH ulong 0
const VEV_F_COMMIT ulong 1
const VEV_F_PHYS ulong 2
const VEV_F_RUN ulong 3
const VEV_F_MACH ulong 4
const VEV_F_REAL ulong 5
const VEV_F_CLAIM ulong 6
const VEV_F_BASIS ulong 7
const VEV_F_RID ulong 8

const VEV_S_SCOPE ulong 0
const VEV_S_DIRTY ulong 1
const VEV_S_GRUN ulong 2
const VEV_S_GPASS ulong 3
const VEV_S_TKNOWN ulong 4

const VEV_R_TMP ulong 0
const VEV_R_LBL ulong 1
const VEV_R_STAT ulong 2
const VEV_R_HEAD ulong 3
const VEV_R_KEY ulong 4
const VEV_R_VAL ulong 5
const VEV_R_S ulong 6
const VEV_R_HEX ulong 7


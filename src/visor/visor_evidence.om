note ---- file buffer and token pool ----
global vev_fbuf uchar 262146
global vev_flen ulong 1
global vev_p ulong 1
global vev_tt uchar 32768
global vev_tk uchar 32768
global vev_ts ulong 32768
global vev_te ulong 32768
global vev_tn ulong 32768
global vev_ntok ulong 1
global vev_stok ulong 80
global vev_sobj uchar 80

note ---- scratch regions (8 x 256 bytes) ----
global vev_sc uchar 2048
global vev_scl ulong 8

note ---- records: 17 slots x 1024 bytes of fields ----
global vev_rf uchar 17408
global vev_rl ulong 272
global vev_rs ulong 136
global vev_rn long 17

note ---- view ----
global vev_cnt ulong 1
global vev_scanned ulong 1
global vev_unparsed ulong 1
global vev_matched ulong 1
global vev_trunc ulong 1
global vev_up uchar 2048
global vev_upl ulong 8
global vev_upn ulong 1

note ---- path pool, directory stack, scan state ----
global vev_pbuf uchar 4096
global vev_plen ulong 1
global vev_root uchar 4096
global vev_qid uchar 32
global vev_pool uchar 16777216
global vev_pused ulong 1
global vev_poff ulong 131072
global vev_pln ulong 131072
global vev_ord ulong 131072
global vev_ordt ulong 131072
global vev_np ulong 1
global vev_maxf ulong 1
global vev_povf ulong 1
global vev_oom ulong 1
global vev_ds uchar 2097152
global vev_dsl ulong 8192
global vev_dsd ulong 8192
global vev_dtop ulong 1
global vev_dbuf uchar 32768
global vev_stb uchar 128
global vev_scur ulong 1
global vev_shave ulong 1

note ---- character classes ----
fn vev_isdig c ulong to bool
  ret and ge c 48 le c 57
end

fn vev_isxd c ulong to bool
  if vev_isdig c
    ret true
  end
  if and ge c 97 le c 102
    ret true
  end
  ret and ge c 65 le c 70
end

fn vev_isws c ulong to bool
  if or eq c 32 eq c 9
    ret true
  end
  ret or eq c 10 eq c 13
end

fn vev_is_esc c ulong to bool
  n = len vev_esc
  for i ulong n
    if eq c ulong get vev_esc i
      ret true
    end
  end
  ret false
end

note ---- JSON scanner ----
fn vev_ws to void
  p = get vev_p 0
  n = get vev_flen 0
  while lt p n bound 262146
    if not vev_isws ulong get vev_fbuf p
      break
    end
    p = add p 1
  end
  put vev_p 0 p
end

fn vev_j_new ty uchar start ulong to long
  t = get vev_ntok 0
  if ge t VEV_MAX_TOK
    ret -1
  end
  put vev_tt t ty
  put vev_tk t uchar 0
  put vev_ts t start
  put vev_te t 0
  put vev_tn t 0
  put vev_ntok 0 add t 1
  ret long t
end

fn vev_j_ux i ulong to bool
  for k ulong 4
    if not vev_isxd ulong get vev_fbuf add add i 2 k
      ret false
    end
  end
  ret true
end

fn vev_j_string is_key uchar to long
  p = get vev_p 0
  n = get vev_flen 0
  if ge p n
    ret -1
  end
  if ne get vev_fbuf p 34
    ret -1
  end
  t = vev_j_new VEV_JT_STR add p 1
  if lt t 0
    ret -1
  end
  ut = ulong t
  put vev_tk ut is_key
  i = add p 1
  closed = false
  while lt i n bound 262146
    c = ulong get vev_fbuf i
    if eq c 34
      closed = true
      break
    end
    if lt c 32
      ret -1
    end
    if eq c 92
      if ge add i 1 n
        ret -1
      end
      e = ulong get vev_fbuf add i 1
      if eq e 117
        if ge add i 5 n
          ret -1
        end
        if not vev_j_ux i
          ret -1
        end
        i = add i 6
        continue
      end
      if not vev_is_esc e
        ret -1
      end
      i = add i 2
      continue
    end
    i = add i 1
  end
  if not closed
    ret -1
  end
  put vev_te ut i
  put vev_tn ut get vev_ntok 0
  put vev_p 0 add i 1
  ret t
end

fn vev_lit_at s ulong lit view uchar * to bool
  n = get vev_flen 0
  ll = len lit
  if gt add s ll n
    ret false
  end
  for k ulong ll
    if ne get vev_fbuf add s k get lit k
      ret false
    end
  end
  ret true
end

fn vev_digits_end s ulong to ulong
  n = get vev_flen 0
  i = s
  while lt i n bound 262146
    if not vev_isdig ulong get vev_fbuf i
      break
    end
    i = add i 1
  end
  ret i
end

fn vev_num_end s ulong to long
  n = get vev_flen 0
  i = s
  if and lt i n eq get vev_fbuf i 45
    i = add i 1
  end
  if ge i n
    ret -1
  end
  if not vev_isdig ulong get vev_fbuf i
    ret -1
  end
  if eq get vev_fbuf i 48
    i = add i 1
  else
    i = vev_digits_end i
  end
  if and lt i n eq get vev_fbuf i 46
    i = add i 1
    if ge i n
      ret -1
    end
    if not vev_isdig ulong get vev_fbuf i
      ret -1
    end
    i = vev_digits_end i
  end
  if lt i n
    c = get vev_fbuf i
    if or eq c 101 eq c 69
      i = add i 1
      if lt i n
        c2 = get vev_fbuf i
        if or eq c2 43 eq c2 45
          i = add i 1
        end
      end
      if ge i n
        ret -1
      end
      if not vev_isdig ulong get vev_fbuf i
        ret -1
      end
      i = vev_digits_end i
    end
  end
  ret long i
end

fn vev_j_prim to long
  s = get vev_p 0
  t = vev_j_new VEV_JT_PRIM s
  if lt t 0
    ret -1
  end
  e = long -1
  if vev_lit_at s vev_l_true
    e = long add s 4
  else
    if vev_lit_at s vev_l_false
      e = long add s 5
    else
      if vev_lit_at s vev_l_null
        e = long add s 4
      else
        e = vev_num_end s
      end
    end
  end
  if lt e 0
    ret -1
  end
  ut = ulong t
  put vev_te ut ulong e
  put vev_tn ut get vev_ntok 0
  put vev_p 0 ulong e
  ret t
end

fn vev_j_close top ulong to void
  t = get vev_stok top
  put vev_te t get vev_p 0
  put vev_tn t get vev_ntok 0
end

note A container opened at the current position: returns the next mode
note (0 value, 1 key, 2 after) or -1.
fn vev_j_open sp ulong to long
  p = get vev_p 0
  n = get vev_flen 0
  c = get vev_fbuf p
  isobj = eq c 123
  ty = VEV_JT_ARR
  close = uchar 93
  if isobj
    ty = VEV_JT_OBJ
    close = 125
  end
  t = vev_j_new ty p
  if lt t 0
    ret -1
  end
  put vev_stok sp ulong t
  put vev_sobj sp uchar 0
  if isobj
    put vev_sobj sp uchar 1
  end
  put vev_p 0 add p 1
  vev_ws
  p2 = get vev_p 0
  if and lt p2 n eq get vev_fbuf p2 close
    put vev_p 0 add p2 1
    vev_j_close sp
    ret 3
  end
  if isobj
    ret 1
  end
  ret 0
end

fn vev_j_key to long
  vev_ws
  if lt vev_j_string uchar 1 0
    ret -1
  end
  vev_ws
  p = get vev_p 0
  if ge p get vev_flen 0
    ret -1
  end
  if ne get vev_fbuf p 58
    ret -1
  end
  put vev_p 0 add p 1
  ret 0
end

note After a value inside container sp-1: returns next mode, 4 = closed, -1 error.
fn vev_j_after sp ulong to long
  vev_ws
  p = get vev_p 0
  if ge p get vev_flen 0
    ret -1
  end
  c = get vev_fbuf p
  top = sub sp 1
  isobj = eq get vev_sobj top 1
  if eq c 44
    put vev_p 0 add p 1
    if isobj
      ret 1
    end
    ret 0
  end
  close = uchar 93
  if isobj
    close = 125
  end
  if eq c close
    put vev_p 0 add p 1
    vev_j_close top
    ret 4
  end
  ret -1
end

fn vev_j_parse to long
  put vev_ntok 0 0
  put vev_p 0 0
  n = get vev_flen 0
  mode = long 0
  sp = ulong 0
  while true bound 4000000
    if eq mode 0
      if gt sp 64
        ret -1
      end
      vev_ws
      p = get vev_p 0
      if ge p n
        ret -1
      end
      c = get vev_fbuf p
      if eq c 34
        if lt vev_j_string uchar 0 0
          ret -1
        end
        mode = 2
      else
        if or eq c 123 eq c 91
          m = vev_j_open sp
          if lt m 0
            ret -1
          end
          if eq m 3
            mode = 2
          else
            sp = add sp 1
            mode = m
          end
        else
          if lt vev_j_prim 0
            ret -1
          end
          mode = 2
        end
      end
    else
      if eq mode 1
        if lt vev_j_key 0
          ret -1
        end
        mode = 0
      else
        if eq sp 0
          break
        end
        m2 = vev_j_after sp
        if lt m2 0
          ret -1
        end
        if eq m2 4
          sp = sub sp 1
          mode = 2
        else
          mode = m2
        end
      end
    end
  end
  if eq get vev_ntok 0 0
    ret -1
  end
  if ne get vev_tt 0 VEV_JT_OBJ
    ret -1
  end
  vev_ws
  if ne get vev_p 0 n
    ret -1
  end
  ret 0
end

fn vev_tok_len i ulong to ulong
  ret sub get vev_te i get vev_ts i
end

fn vev_key_eq i ulong key view uchar * to bool
  if ne get vev_tt i VEV_JT_STR
    ret false
  end
  kl = len key
  if ne vev_tok_len i kl
    ret false
  end
  s = get vev_ts i
  for k ulong kl
    if ne get vev_fbuf add s k get key k
      ret false
    end
  end
  ret true
end

fn vev_j_get obj long key view uchar * to long
  if lt obj 0
    ret -1
  end
  o = ulong obj
  if ne get vev_tt o VEV_JT_OBJ
    ret -1
  end
  k = add o 1
  lim = get vev_tn o
  while lt k lim bound 32768
    if vev_key_eq k key
      ret long add k 1
    end
    k = get vev_tn add k 1
  end
  ret -1
end

fn vev_find_any key view uchar * to long
  nt = get vev_ntok 0
  for i ulong nt bound 32768
    if eq get vev_tk i 1
      if vev_key_eq i key
        ret long add i 1
      end
    end
  end
  ret -1
end

fn vev_is_type v long ty uchar to bool
  if lt v 0
    ret false
  end
  ret eq get vev_tt ulong v ty
end

fn vev_is_lit v long lit view uchar * to bool
  if not vev_is_type v VEV_JT_PRIM
    ret false
  end
  u = ulong v
  ll = len lit
  if ne vev_tok_len u ll
    ret false
  end
  s = get vev_ts u
  for k ulong ll
    if ne get vev_fbuf add s k get lit k
      ret false
    end
  end
  ret true
end

note ---- scratch regions ----
fn vev_sc_clear r ulong to void
  put vev_scl r 0
end

fn vev_sc_push r ulong c uchar cap ulong to void
  l = get vev_scl r
  if lt add l 1 cap
    put vev_sc add mul r 256 l c
    put vev_scl r add l 1
  end
end

note j_copy: token text (STR or PRIM only) truncated to cap-1 bytes.
fn vev_tok_sc v long r ulong cap ulong to ulong
  vev_sc_clear r
  if lt v 0
    ret 0
  end
  u = ulong v
  ty = get vev_tt u
  if and ne ty VEV_JT_STR ne ty VEV_JT_PRIM
    ret 0
  end
  ll = vev_tok_len u
  if ge ll cap
    ll = sub cap 1
  end
  s = get vev_ts u
  b = mul r 256
  for k ulong ll bound 256
    put vev_sc add b k get vev_fbuf add s k
  end
  put vev_scl r ll
  ret ll
end

fn vev_sc_eq r ulong w view uchar * to bool
  l = get vev_scl r
  wl = len w
  if ne l wl
    ret false
  end
  b = mul r 256
  for k ulong wl
    if ne get vev_sc add b k get w k
      ret false
    end
  end
  ret true
end

fn vev_sc_at r ulong pos ulong w view uchar * to bool
  l = get vev_scl r
  wl = len w
  if gt add pos wl l
    ret false
  end
  b = add mul r 256 pos
  for k ulong wl
    if ne get vev_sc add b k get w k
      ret false
    end
  end
  ret true
end

fn vev_sc_has r ulong w view uchar * to bool
  l = get vev_scl r
  wl = len w
  if gt wl l
    ret false
  end
  lim = add sub l wl 1
  for i ulong lim bound 256
    if vev_sc_at r i w
      ret true
    end
  end
  ret false
end

fn vev_sc_lower r ulong to void
  l = get vev_scl r
  b = mul r 256
  for k ulong l bound 256
    c = get vev_sc add b k
    if and ge c 65 le c 90
      put vev_sc add b k add c 32
    end
  end
end

fn vev_sc_hex r ulong n ulong to bool
  if ne get vev_scl r n
    ret false
  end
  b = mul r 256
  for k ulong n bound 256
    if not vev_isxd ulong get vev_sc add b k
      ret false
    end
  end
  ret true
end

note ---- record fields ----
fn vev_foff f ulong to ulong
  if eq f 0
    ret 0
  end
  if le f 2
    ret add 256 mul sub f 1 48
  end
  if eq f 3
    ret 352
  end
  if eq f 4
    ret 416
  end
  if eq f 5
    ret 512
  end
  if eq f 6
    ret 592
  end
  if eq f 7
    ret 720
  end
  ret 816
end

fn vev_fsz f ulong to ulong
  if eq f 0
    ret 256
  end
  if le f 2
    ret 41
  end
  if eq f 3
    ret 64
  end
  if or eq f 4 eq f 7
    ret 96
  end
  if eq f 6
    ret 128
  end
  ret 72
end

fn vev_flen_of r ulong f ulong to ulong
  ret get vev_rl add mul r 16 f
end

fn vev_fclr r ulong f ulong to void
  put vev_rl add mul r 16 f 0
end

fn vev_fpush r ulong f ulong c uchar to void
  li = add mul r 16 f
  l = get vev_rl li
  if lt add l 1 vev_fsz f
    put vev_rf add add mul r 1024 vev_foff f l c
    put vev_rl li add l 1
  end
end

fn vev_fget r ulong f ulong k ulong to uchar
  ret get vev_rf add add mul r 1024 vev_foff f k
end

fn vev_fpush_txt r ulong f ulong w view uchar * to void
  n = len w
  for k ulong n bound 256
    vev_fpush r f get w k
  end
end

fn vev_fpush_sc r ulong f ulong reg ulong maxn ulong to void
  l = get vev_scl reg
  if gt l maxn
    l = maxn
  end
  b = mul reg 256
  for k ulong l bound 256
    vev_fpush r f get vev_sc add b k
  end
end

fn vev_rec_copy dst ulong src ulong to void
  db = mul dst 1024
  sb = mul src 1024
  for k ulong 1024
    put vev_rf add db k get vev_rf add sb k
  end
  for k ulong 16
    put vev_rl add mul dst 16 k get vev_rl add mul src 16 k
  end
  for k ulong 8
    put vev_rs add mul dst 8 k get vev_rs add mul src 8 k
  end
  put vev_rn dst get vev_rn src
end

fn vev_rs_get r ulong s ulong to ulong
  ret get vev_rs add mul r 8 s
end

fn vev_rs_set r ulong s ulong v ulong to void
  put vev_rs add mul r 8 s v
end

fn vev_rec_reset r ulong to void
  for k ulong 16
    put vev_rl add mul r 16 k 0
  end
  for k ulong 8
    put vev_rs add mul r 8 k 0
  end
  put vev_rn r -1
end

fn vev_rec_path_from_pbuf r ulong to void
  n = get vev_plen 0
  for k ulong n bound 4096
    vev_fpush r VEV_F_PATH get vev_pbuf k
  end
end

note ---- extraction ----
note mode: 0 top-level, 1 anywhere, 3 anywhere with the sha256: prefix.
fn vev_hexf f ulong hexlen ulong mode ulong key view uchar * to bool
  r = VEV_REC
  v = long -1
  if ne mode 0
    v = vev_find_any key
  else
    v = vev_j_get 0 key
  end
  if not vev_is_type v VEV_JT_STR
    ret false
  end
  u = vev_tok_sc v VEV_R_TMP 80
  if not vev_sc_hex VEV_R_TMP hexlen
    ret false
  end
  vev_fclr r f
  if eq mode 3
    vev_fpush_txt r f vev_sha
  end
  vev_fpush_sc r f VEV_R_TMP u
  ret true
end

fn vev_fill_commit r ulong to void
  if vev_hexf VEV_F_COMMIT 40 0 vev_k_cc
    ret
  end
  if vev_hexf VEV_F_COMMIT 40 0 vev_k_rc
    ret
  end
  if vev_hexf VEV_F_COMMIT 40 0 vev_k_gc
    ret
  end
  if vev_hexf VEV_F_COMMIT 40 0 vev_k_cgc
    ret
  end
  u = vev_hexf VEV_F_COMMIT 40 0 vev_k_qic
  if u
    ret
  end
end

fn vev_fill_phys r ulong to void
  if vev_hexf VEV_F_PHYS 40 0 vev_k_pc
    ret
  end
  if vev_hexf VEV_F_PHYS 40 0 vev_k_pfc
    ret
  end
  if vev_hexf VEV_F_PHYS 40 1 vev_k_pc
    ret
  end
  u = vev_hexf VEV_F_PHYS 40 1 vev_k_pfc
  if u
    ret
  end
end

fn vev_fill_real r ulong to void
  if vev_hexf VEV_F_REAL 64 3 vev_k_rid
    ret
  end
  if vev_hexf VEV_F_REAL 64 3 vev_k_sri
    ret
  end
  if vev_hexf VEV_F_REAL 64 3 vev_k_pri
    ret
  end
  u = vev_hexf VEV_F_REAL 64 3 vev_k_cri
  if u
    ret
  end
end

fn vev_fill_run r ulong to void
  v = vev_j_get 0 vev_k_run
  if vev_is_type v VEV_JT_STR
    u = vev_tok_sc v VEV_R_TMP 64
    vev_fpush_sc r VEV_F_RUN VEV_R_TMP u
  end
end

fn vev_add_part r ulong label view uchar * v long to void
  if not vev_is_type v VEV_JT_STR
    ret
  end
  u = vev_tok_sc v VEV_R_TMP 64
  if eq u 0
    ret
  end
  l = vev_flen_of r VEV_F_MACH
  if ge l 95
    ret
  end
  if gt l 0
    vev_fpush r VEV_F_MACH uchar 32
  end
  vev_fpush_txt r VEV_F_MACH label
  vev_fpush r VEV_F_MACH uchar 61
  vev_fpush_sc r VEV_F_MACH VEV_R_TMP u
end

fn vev_fill_machine r ulong to void
  mi = vev_j_get 0 vev_k_mi
  if vev_is_type mi VEV_JT_OBJ
    vev_add_part r vev_l_node vev_j_get mi vev_k_node
    vev_add_part r vev_l_arch vev_j_get mi vev_k_arch
    vev_add_part r vev_l_kern vev_j_get mi vev_k_rel
    ret
  end
  h = vev_j_get 0 vev_k_host
  if vev_is_type h VEV_JT_OBJ
    vev_add_part r vev_l_os vev_j_get h vev_k_sysn
    vev_add_part r vev_l_os vev_j_get h vev_k_os
    vev_add_part r vev_l_arch vev_j_get h vev_k_mach
    vev_add_part r vev_l_arch vev_j_get h vev_k_arch2
    vev_add_part r vev_l_kern vev_j_get h vev_k_rel
    vev_add_part r vev_l_core vev_j_get h vev_k_core
  end
end

note j_u32: a PRIM of decimal digits only, at most UINT32_MAX; -1 otherwise.
fn vev_u32 v long to long
  if not vev_is_type v VEV_JT_PRIM
    ret -1
  end
  l = vev_tok_sc v VEV_R_TMP 24
  if eq l 0
    ret -1
  end
  acc = ulong 0
  for k ulong l bound 24
    c = ulong get vev_sc k
    if not vev_isdig c
      ret -1
    end
    acc = add mul acc 10 sub c 48
    if gt acc 4294967295
      ret -1
    end
  end
  ret long acc
end

fn vev_head_set to void
  kl = get vev_scl VEV_R_KEY
  if gt kl 90
    kl = 90
  end
  vev_sc_clear VEV_R_HEAD
  kb = mul VEV_R_KEY 256
  for k ulong kl bound 256
    vev_sc_push VEV_R_HEAD get vev_sc add kb k 112
  end
  vev_sc_push VEV_R_HEAD uchar 61 112
  vl = get vev_scl VEV_R_VAL
  vb = mul VEV_R_VAL 256
  for k ulong vl bound 256
    vev_sc_push VEV_R_HEAD get vev_sc add vb k 112
  end
end

fn vev_gate_one r ulong k ulong to void
  v = add k 1
  if ne get vev_tt v VEV_JT_STR
    ret
  end
  u = vev_tok_sc long v VEV_R_VAL 16
  pass = vev_sc_eq VEV_R_VAL vev_pass
  fail = vev_sc_eq VEV_R_VAL vev_fail
  if not or pass fail
    ret
  end
  vev_rs_set r VEV_S_GRUN add vev_rs_get r VEV_S_GRUN 1
  if pass
    vev_rs_set r VEV_S_GPASS add vev_rs_get r VEV_S_GPASS 1
  end
  kl = vev_tok_sc long k VEV_R_KEY 96
  ends = false
  if gt kl 5
    ends = vev_sc_at VEV_R_KEY sub kl 5 vev_upass
  end
  if or ends eq get vev_scl VEV_R_HEAD 0
    vev_head_set
  end
  if eq u 99999
    ret
  end
end

fn vev_count_gates obj long r ulong to void
  if not vev_is_type obj VEV_JT_OBJ
    ret
  end
  o = ulong obj
  k = add o 1
  lim = get vev_tn o
  while lt k lim bound 32768
    vev_gate_one r k
    k = get vev_tn add k 1
  end
end

fn vev_label to ulong
  l = vev_tok_sc vev_j_get 0 vev_k_schema VEV_R_LBL 96
  if eq l 0
    l = vev_tok_sc vev_j_get 0 vev_k_mile VEV_R_LBL 96
  end
  if eq l 0
    l = vev_tok_sc vev_j_get 0 vev_k_stage VEV_R_LBL 96
  end
  if eq l 0
    l = vev_tok_sc vev_j_get 0 vev_k_contract VEV_R_LBL 96
  end
  ret l
end

fn vev_fill_gates r ulong to void
  vev_sc_clear VEV_R_HEAD
  qg = vev_j_get 0 vev_k_qg
  done = false
  if ge qg 0
    a = vev_u32 vev_j_get qg vev_k_total
    b = vev_u32 vev_j_get qg vev_k_passed
    if and ge a 0 ge b 0
      vev_rs_set r VEV_S_GRUN ulong a
      vev_rs_set r VEV_S_GPASS ulong b
      done = true
    end
  end
  if not done
    vev_count_gates vev_j_get 0 vev_k_gates r
    vev_count_gates vev_j_get 0 vev_k_gate r
    if ge qg 0
      vev_count_gates vev_j_get qg vev_k_gates r
    end
  end
end

fn vev_fill_claim r ulong to void
  ll = vev_label
  sl = vev_tok_sc vev_j_get 0 vev_k_status VEV_R_STAT 64
  wr = VEV_R_STAT
  if gt get vev_scl VEV_R_HEAD 0
    wr = VEV_R_HEAD
  end
  wl = get vev_scl wr
  if and gt ll 0 gt wl 0
    vev_fpush_sc r VEV_F_CLAIM VEV_R_LBL 60
    vev_fpush r VEV_F_CLAIM uchar 58
    vev_fpush r VEV_F_CLAIM uchar 32
    vev_fpush_sc r VEV_F_CLAIM wr 64
    ret
  end
  if gt ll 0
    vev_fpush_sc r VEV_F_CLAIM VEV_R_LBL 120
    ret
  end
  vev_fpush_sc r VEV_F_CLAIM wr 120
  if eq sl 99999
    ret
  end
end

fn vev_sig r ulong s ulong basis view uchar * to void
  if or eq get vev_shave 0 0 lt s get vev_scur 0
    put vev_scur 0 s
    vev_fclr r VEV_F_BASIS
    vev_fpush_txt r VEV_F_BASIS basis
  end
  put vev_shave 0 1
end

fn vev_scope_key r ulong key view uchar * to void
  v = vev_j_get 0 key
  if not vev_is_type v VEV_JT_STR
    ret
  end
  u = vev_tok_sc v VEV_R_S 256
  vev_sc_lower VEV_R_S
  if vev_sc_has VEV_R_S vev_w_simulat
    vev_sig r VEV_SCOPE_SIMULATED key
  end
  if or vev_sc_at VEV_R_S 0 vev_w_host vev_sc_has VEV_R_S vev_w_nosil
    vev_sig r VEV_SCOPE_HOST key
  end
  if vev_sc_has VEV_R_S vev_w_qemu
    vev_sig r VEV_SCOPE_QEMU key
  end
  if eq u 99999
    ret
  end
end

fn vev_fill_scope r ulong to void
  put vev_scur 0 VEV_SCOPE_UNKNOWN
  put vev_shave 0 0
  so = vev_j_get 0 vev_k_so
  if vev_is_lit so vev_l_true
    vev_sig r VEV_SCOPE_SILICON vev_b_sot
  end
  if vev_is_lit so vev_l_false
    vev_sig r VEV_SCOPE_HOST vev_b_sof
  end
  if ge vev_find_any vev_k_gpu 0
    vev_sig r VEV_SCOPE_SILICON vev_k_gpu
  end
  if ge vev_find_any vev_k_cc2 0
    vev_sig r VEV_SCOPE_SILICON vev_k_cc2
  end
  if ge vev_find_any vev_k_qt 0
    vev_sig r VEV_SCOPE_QEMU vev_k_qt
  end
  vev_scope_key r vev_k_hs
  vev_scope_key r vev_k_scope
  if eq get vev_shave 0 1
    vev_rs_set r VEV_S_SCOPE get vev_scur 0
  else
    vev_rs_set r VEV_S_SCOPE VEV_SCOPE_UNKNOWN
    vev_fclr r VEV_F_BASIS
  end
end

fn vev_fill_tree r ulong to void
  td = vev_j_get 0 vev_k_td
  if or vev_is_lit td vev_l_true vev_is_lit td vev_l_false
    vev_rs_set r VEV_S_TKNOWN 1
    if vev_is_lit td vev_l_true
      vev_rs_set r VEV_S_DIRTY 1
    end
    ret
  end
  tc = vev_j_get 0 vev_k_ctc
  if not vev_is_type tc VEV_JT_OBJ
    ret
  end
  vev_rs_set r VEV_S_TKNOWN 1
  o = ulong tc
  k = add o 1
  lim = get vev_tn o
  while lt k lim bound 32768
    if vev_is_lit long add k 1 vev_l_false
      vev_rs_set r VEV_S_DIRTY 1
    end
    k = get vev_tn add k 1
  end
end

note name_hash_match on the path in vev_pbuf against the hex in scratch R_HEX.
fn vev_name_match to long
  n = get vev_plen 0
  base = ulong 0
  for k ulong n bound 4096
    if eq get vev_pbuf k 47
      base = add k 1
    end
  end
  bl = sub n base
  if ne bl 69
    ret -1
  end
  jl = len vev_json
  for k ulong jl
    if ne get vev_pbuf add add base 64 k get vev_json k
      ret -1
    end
  end
  for k ulong 64
    if not vev_isxd ulong get vev_pbuf add base k
      ret -1
    end
  end
  hb = mul VEV_R_HEX 256
  for k ulong 64
    if ne get vev_pbuf add base k get vev_sc add hb k
      ret 0
    end
  end
  ret 1
end

fn vev_has_nul to bool
  n = get vev_flen 0
  for k ulong n bound 262146
    if eq get vev_fbuf k 0
      ret true
    end
  end
  ret false
end

fn vev_hash_buf to void
  n = get vev_flen 0
  for k ulong n bound 262146
    put v_sha_in k get vev_fbuf k
  end
  if eq get v_sha_k 0 0
    sha_kinit
  end
  sha256_hash n
  vev_sc_clear VEV_R_HEX
  for k ulong 32
    b = ulong get v_sha_out k
    vev_sc_push VEV_R_HEX get vt_hex and shr b 4 15 256
    vev_sc_push VEV_R_HEX get vt_hex and b 15 256
  end
end

note Record from vev_fbuf (already read) for the path in vev_pbuf.
fn vev_record_from_buf r ulong to long
  vev_rec_reset r
  vev_rec_path_from_pbuf r
  if vev_has_nul
    ret -1
  end
  if lt vev_j_parse 0
    ret -1
  end
  vev_hash_buf
  vev_fpush_txt r VEV_F_RID vev_sha
  vev_fpush_sc r VEV_F_RID VEV_R_HEX 64
  put vev_rn r vev_name_match
  vev_fill_commit r
  vev_fill_phys r
  vev_fill_run r
  vev_fill_real r
  vev_fill_machine r
  vev_fill_tree r
  vev_fill_gates r
  vev_fill_claim r
  vev_fill_scope r
  ret 0
end

note read_file: -1 if unreadable, not a regular file, or more than 256 KiB.
fn vev_read_file to long
  put vev_flen 0 0
  put vev_fbuf 0 uchar 0
  n = get vev_plen 0
  if eq n 0
    ret -1
  end
  fd = fopen vev_pbuf 0 n 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  bad = false
  while lt tot 262145 bound 262146
    k = read int fd vev_fbuf tot sub 262145 tot
    if lt k 0
      bad = true
      break
    end
    if eq k 0
      break
    end
    tot = add tot ulong k
  end
  u = fclose int fd
  if bad
    ret -1
  end
  if gt tot VEV_MAX_FILE
    ret -1
  end
  put vev_flen 0 tot
  put vev_fbuf tot uchar 0
  if lt u -999999
    ret -1
  end
  ret 0
end

note visor_evidence_load: the path in vev_pbuf into record slot 16.
fn vev_load to long
  if lt vev_read_file 0
    vev_rec_reset VEV_REC
    vev_rec_path_from_pbuf VEV_REC
    ret -1
  end
  ret vev_record_from_buf VEV_REC
end

fn vev_load_txt s view uchar * to long
  n = len s
  for k ulong n bound 4096
    put vev_pbuf k get s k
  end
  put vev_plen 0 n
  ret vev_load
end

note ---- directory walk ----
fn vev_set_max_files cap ulong to ulong
  prev = get vev_maxf 0
  if eq prev 0
    prev = VEV_MAX_FILES
  end
  if eq cap 0
    put vev_maxf 0 VEV_MAX_FILES
  else
    put vev_maxf 0 cap
  end
  ret prev
end

fn vev_cap to ulong
  c = get vev_maxf 0
  if eq c 0
    ret VEV_MAX_FILES
  end
  if gt c VEV_MAX_FILES
    ret VEV_MAX_FILES
  end
  ret c
end

note strcmp of pool slots a and b (unsigned bytes).
fn vev_cmp_slot a ulong b ulong to long
  oa = get vev_poff a
  la = get vev_pln a
  ob = get vev_poff b
  lb = get vev_pln b
  m = la
  if lt lb m
    m = lb
  end
  for k ulong m bound 4096
    ca = get vev_pool add oa k
    cb = get vev_pool add ob k
    if lt ca cb
      ret -1
    end
    if gt ca cb
      ret 1
    end
  end
  if lt la lb
    ret -1
  end
  if gt la lb
    ret 1
  end
  ret 0
end

fn vev_cmp_pbuf_slot b ulong to long
  la = get vev_plen 0
  ob = get vev_poff b
  lb = get vev_pln b
  m = la
  if lt lb m
    m = lb
  end
  for k ulong m bound 4096
    ca = get vev_pbuf k
    cb = get vev_pool add ob k
    if lt ca cb
      ret -1
    end
    if gt ca cb
      ret 1
    end
  end
  if lt la lb
    ret -1
  end
  if gt la lb
    ret 1
  end
  ret 0
end

fn vev_swap_slot a ulong b ulong to void
  t0 = get vev_poff a
  tl = get vev_pln a
  put vev_poff a get vev_poff b
  put vev_pln a get vev_pln b
  put vev_poff b t0
  put vev_pln b tl
end

fn vev_sift i0 ulong to void
  np = get vev_np 0
  i = i0
  while true bound 64
    l = add mul i 2 1
    r = add l 1
    m = i
    if lt l np
      if gt vev_cmp_slot l m 0
        m = l
      end
    end
    if lt r np
      if gt vev_cmp_slot r m 0
        m = r
      end
    end
    if eq m i
      ret
    end
    vev_swap_slot i m
    i = m
  end
end

fn vev_pool_put to long
  n = get vev_plen 0
  off = get vev_pused 0
  if gt add off n VEV_POOL
    put vev_oom 0 1
    ret -1
  end
  for k ulong n bound 4096
    put vev_pool add off k get vev_pbuf k
  end
  put vev_pused 0 add off n
  ret long off
end

fn vev_keep_path to void
  cap = vev_cap
  np = get vev_np 0
  if lt np cap
    off = vev_pool_put
    if lt off 0
      ret
    end
    put vev_poff np ulong off
    put vev_pln np get vev_plen 0
    np2 = add np 1
    put vev_np 0 np2
    if eq np2 cap
      h = div np2 2
      while gt h 0 bound 131072
        h = sub h 1
        vev_sift h
      end
    end
    ret
  end
  put vev_povf 0 1
  if ge vev_cmp_pbuf_slot 0 0
    ret
  end
  off2 = vev_pool_put
  if lt off2 0
    ret
  end
  put vev_poff 0 ulong off2
  put vev_pln 0 get vev_plen 0
  vev_sift 0
end

fn vev_ds_push depth ulong to void
  top = get vev_dtop 0
  if ge top VEV_DSTACK
    put vev_oom 0 1
    ret
  end
  n = get vev_plen 0
  b = mul top 256
  for k ulong n bound 256
    put vev_ds add b k get vev_pbuf k
  end
  put vev_dsl top n
  put vev_dsd top depth
  put vev_dtop 0 add top 1
end

fn vev_stat_mode to ulong
  m0 = ulong get vev_stb 16
  m1 = ulong get vev_stb 17
  m2 = ulong get vev_stb 18
  m3 = ulong get vev_stb 19
  ret or or m0 shl m1 8 or shl m2 16 shl m3 24
end

global vev_dir uchar 256
global vev_dirl ulong 1

note One directory entry: name at vev_dbuf[noff..noff+nl), parent in vev_dir.
fn vev_entry noff ulong nl ulong depth ulong to void
  if eq get vev_dbuf noff 46
    ret
  end
  dl = get vev_dirl 0
  if ge dl 256
    put vev_povf 0 1
    ret
  end
  sep = ulong 1
  if gt dl 0
    if eq get vev_dir sub dl 1 47
      sep = 0
    end
  end
  total = add add dl sep nl
  if ge total 256
    put vev_povf 0 1
    ret
  end
  for k ulong dl bound 256
    put vev_pbuf k get vev_dir k
  end
  if eq sep 1
    put vev_pbuf dl uchar 47
  end
  pb = add dl sep
  for k ulong nl bound 256
    put vev_pbuf add pb k get vev_dbuf add noff k
  end
  put vev_plen 0 total
  rc = lstat vev_pbuf 0 total vev_stb 0 128
  if ne rc 0
    ret
  end
  fm = and vev_stat_mode 61440
  if eq fm 16384
    if le add depth 1 8
      vev_ds_push add depth 1
    end
    ret
  end
  if ne fm 32768
    ret
  end
  vev_keep_path
end

fn vev_dirent_rlen pos ulong to ulong
  lo = ulong get vev_dbuf add pos 16
  hi = ulong get vev_dbuf add pos 17
  ret or lo shl hi 8
end

fn vev_dirent_name_len pos ulong rlen ulong to ulong
  noff = add pos 19
  lim = add pos rlen
  nl = ulong 0
  while lt add noff nl lim bound 256
    if eq get vev_dbuf add noff nl 0
      break
    end
    nl = add nl 1
  end
  ret nl
end

fn vev_walk_entries fd long depth ulong to void
  while true bound 1000000
    nr = getdnts int fd vev_dbuf 0 32768
    if le nr 0
      break
    end
    pos = ulong 0
    nru = ulong nr
    while lt pos nru bound 32768
      rlen = vev_dirent_rlen pos
      if eq rlen 0
        break
      end
      nl = vev_dirent_name_len pos rlen
      if gt nl 0
        vev_entry add pos 19 nl depth
      end
      pos = add pos rlen
    end
  end
end

fn vev_walk_one to void
  top = sub get vev_dtop 0 1
  put vev_dtop 0 top
  dl = get vev_dsl top
  depth = get vev_dsd top
  sb = mul top 256
  for k ulong dl bound 256
    put vev_dir k get vev_ds add sb k
    put vev_pbuf k get vev_ds add sb k
  end
  put vev_dirl 0 dl
  fd = fopen vev_pbuf 0 dl 16384 0
  if lt fd 0
    ret
  end
  vev_walk_entries fd depth
  u = fclose int fd
  if lt u -999999
    ret
  end
end

fn vev_take_a a ulong b ulong mid ulong hi ulong to bool
  if ge a mid
    ret false
  end
  if ge b hi
    ret true
  end
  oa = get vev_ord a
  ob = get vev_ord b
  ret le vev_cmp_slot oa ob 0
end

fn vev_merge lo ulong mid ulong hi ulong to void
  a = lo
  b = mid
  o = lo
  while lt o hi bound 262144
    if vev_take_a a b mid hi
      put vev_ordt o get vev_ord a
      a = add a 1
    else
      put vev_ordt o get vev_ord b
      b = add b 1
    end
    o = add o 1
  end
end

fn vev_sort to void
  np = get vev_np 0
  for i ulong np bound 131072
    put vev_ord i i
  end
  w = ulong 1
  while lt w np bound 64
    lo = ulong 0
    while lt lo np bound 131072
      mid = add lo w
      if gt mid np
        mid = np
      end
      hi = add lo mul w 2
      if gt hi np
        hi = np
      end
      vev_merge lo mid hi
      lo = hi
    end
    for i ulong np bound 131072
      put vev_ord i get vev_ordt i
    end
    w = mul w 2
  end
end

note A root of 256 bytes or more (the C walk's snprintf into a 256-byte path then fails for
note every entry): no path is kept, and the walk records an overflow (truncated) when the root
note has an entry not starting with '.', as the C does; an unopenable root keeps nothing.
fn vev_collect_long rl ulong to void
  fd = fopen vev_root 0 rl 16384 0
  if lt fd 0
    ret
  end
  put vev_dirl 0 rl
  vev_walk_entries fd 0
  u = fclose int fd
  if lt u -999999
    ret
  end
end

note collect: the root (in vev_root, length rl) must be a directory.
fn vev_collect rl ulong to long
  if or eq rl 0 ge rl 4096
    ret -1
  end
  rc = stat vev_root 0 rl vev_stb 0 128
  if ne rc 0
    ret -1
  end
  if ne and vev_stat_mode 61440 16384
    ret -1
  end
  put vev_np 0 0
  put vev_pused 0 0
  put vev_povf 0 0
  put vev_oom 0 0
  put vev_dtop 0 0
  if ge rl 256
    vev_collect_long rl
    if ne get vev_oom 0 0
      ret -1
    end
    ret 0
  end
  for k ulong rl bound 256
    put vev_pbuf k get vev_root k
  end
  put vev_plen 0 rl
  vev_ds_push 0
  while gt get vev_dtop 0 0 bound 16777216
    vev_walk_one
  end
  if ne get vev_oom 0 0
    ret -1
  end
  vev_sort
  ret 0
end

fn vev_view_reset to void
  put vev_cnt 0 0
  put vev_scanned 0 0
  put vev_unparsed 0 0
  put vev_matched 0 0
  put vev_trunc 0 0
  put vev_upn 0 0
end

fn vev_note_unparsed to void
  put vev_unparsed 0 add get vev_unparsed 0 1
  n = get vev_upn 0
  if lt n VEV_MAX_UNPARSED
    l = get vev_plen 0
    if gt l 255
      l = 255
    end
    b = mul n 256
    for k ulong l bound 256
      put vev_up add b k get vev_pbuf k
    end
    put vev_upl n l
    put vev_upn 0 add n 1
  end
end

fn vev_view_add to void
  put vev_matched 0 add get vev_matched 0 1
  c = get vev_cnt 0
  if lt c VEV_MAX_ITEMS
    vev_rec_copy c VEV_REC
    put vev_cnt 0 add c 1
  else
    put vev_trunc 0 1
  end
end

fn vev_path_of_sorted i ulong to void
  s = get vev_ord i
  o = get vev_poff s
  l = get vev_pln s
  for k ulong l bound 4096
    put vev_pbuf k get vev_pool add o k
  end
  put vev_plen 0 l
end

fn vev_pbuf_json to bool
  l = get vev_plen 0
  jl = len vev_json
  if lt l jl
    ret false
  end
  b = sub l jl
  for k ulong jl
    if ne get vev_pbuf add b k get vev_json k
      ret false
    end
  end
  ret true
end

note visor_evidence_scan over the root in vev_root (length rl).
fn vev_scan rl ulong to long
  vev_view_reset
  if lt vev_collect rl 0
    ret -1
  end
  np = get vev_np 0
  for i ulong np bound 131072
    vev_path_of_sorted i
    put vev_scanned 0 add get vev_scanned 0 1
    ok = false
    if vev_pbuf_json
      if eq vev_load 0
        ok = true
      end
    end
    if ok
      vev_view_add
    else
      vev_note_unparsed
    end
  end
  if ne get vev_povf 0 0
    put vev_trunc 0 1
  end
  ret 0
end

fn vev_buf_mentions to bool
  n = get vev_flen 0
  if lt n 64
    ret false
  end
  hb = mul VEV_R_HEX 256
  first = get vev_sc hb
  lim = add sub n 64 1
  for i ulong lim bound 262146
    if eq get vev_fbuf i first
      hit = true
      for k ulong 64
        if ne get vev_fbuf add i k get vev_sc add hb k
          hit = false
          break
        end
      end
      if hit
        ret true
      end
    end
  end
  ret false
end

fn vev_qid_hex to void
  vev_sc_clear VEV_R_HEX
  for k ulong 32
    b = ulong get vev_qid k
    vev_sc_push VEV_R_HEX get vt_hex and shr b 4 15 256
    vev_sc_push VEV_R_HEX get vt_hex and b 15 256
  end
end

fn vev_for_id_one to void
  if lt vev_read_file 0
    vev_note_unparsed
    ret
  end
  vev_qid_hex
  if not vev_buf_mentions
    ret
  end
  ok = false
  if vev_pbuf_json
    if eq vev_record_from_buf VEV_REC 0
      ok = true
    end
  end
  if ok
    vev_view_add
  else
    vev_note_unparsed
  end
end

note visor_evidence_for_id over vev_root (length rl) for the id in vev_qid.
fn vev_for_id rl ulong to long
  vev_view_reset
  if lt vev_collect rl 0
    ret -1
  end
  np = get vev_np 0
  for i ulong np bound 131072
    vev_path_of_sorted i
    put vev_scanned 0 add get vev_scanned 0 1
    vev_for_id_one
  end
  if ne get vev_povf 0 0
    put vev_trunc 0 1
  end
  ret 0
end

fn vev_root_txt s view uchar * to ulong
  n = len s
  for k ulong n bound 4096
    put vev_root k get s k
  end
  ret n
end

note ---- rendering ----
fn vev_scope_name s ulong to void
  if eq s VEV_SCOPE_SILICON
    ob_puts vev_s_sil
    ret
  end
  if eq s VEV_SCOPE_QEMU
    ob_puts vev_s_qemu
    ret
  end
  if eq s VEV_SCOPE_HOST
    ob_puts vev_s_host
    ret
  end
  if eq s VEV_SCOPE_SIMULATED
    ob_puts vev_s_sim
    ret
  end
  ob_puts vev_s_unk
end

fn vev_put_field r ulong f ulong to void
  l = vev_flen_of r f
  for k ulong l bound 256
    ob_putc vev_fget r f k
  end
end

fn vev_put_or_none r ulong f ulong to void
  if eq vev_flen_of r f 0
    ob_puts vev_t_none
  else
    vev_put_field r f
  end
  ob_putc uchar 10
end

fn vev_text_item r ulong to void
  ob_puts vev_t_receipt
  vev_put_field r VEV_F_RID
  nm = get vev_rn r
  if eq nm 1
    ob_puts vev_t_nmatch
  end
  if eq nm 0
    ob_puts vev_t_nmis
  end
  ob_putc uchar 10
  ob_puts vev_t_path
  vev_put_field r VEV_F_PATH
  ob_putc uchar 10
  ob_puts vev_t_claim
  vev_put_or_none r VEV_F_CLAIM
  ob_puts vev_t_scope
  vev_scope_name vev_rs_get r VEV_S_SCOPE
  if gt vev_flen_of r VEV_F_BASIS 0
    ob_puts vev_t_from
    vev_put_field r VEV_F_BASIS
    ob_putc uchar 41
  end
  ob_putc uchar 10
  ob_puts vev_t_gates
  ob_put_u64 vev_rs_get r VEV_S_GPASS
  ob_putc uchar 47
  ob_put_u64 vev_rs_get r VEV_S_GRUN
  ob_puts vev_t_gpassed
end

fn vev_text_item2 r ulong to void
  ob_puts vev_t_commit
  vev_put_or_none r VEV_F_COMMIT
  ob_puts vev_t_phys
  vev_put_or_none r VEV_F_PHYS
  ob_puts vev_t_run
  vev_put_or_none r VEV_F_RUN
  ob_puts vev_t_mach
  vev_put_or_none r VEV_F_MACH
  ob_puts vev_t_real
  vev_put_or_none r VEV_F_REAL
  ob_puts vev_t_tree
  if eq vev_rs_get r VEV_S_TKNOWN 0
    ob_puts vev_t_unknown
  else
    if eq vev_rs_get r VEV_S_DIRTY 1
      ob_puts vev_t_dirty
    else
      ob_puts vev_t_clean
    end
  end
  ob_putc uchar 10
end

fn vev_put_up i ulong to void
  l = get vev_upl i
  b = mul i 256
  for k ulong l bound 256
    ob_putc get vev_up add b k
  end
end

note visor_evidence_format_text into v_ob; n is the C buffer size (output < n).
fn vev_format_text n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  ob_puts vev_t_hdr
  ob_put_u64 get vev_cnt 0
  ob_puts vev_t_shown
  ob_put_u64 get vev_matched 0
  ob_puts vev_t_matched
  ob_put_u64 get vev_scanned 0
  ob_puts vev_t_scanned
  ob_put_u64 get vev_unparsed 0
  ob_puts vev_t_unparsed
  if eq get vev_trunc 0 1
    ob_puts vev_t_trunc
  end
  ob_putc uchar 10
  c = get vev_cnt 0
  if eq c 0
    ob_puts vev_t_noev
  end
  for i ulong c bound 16
    vev_text_item i
    vev_text_item2 i
  end
  un = get vev_upn 0
  for i ulong un bound 8
    ob_puts vev_t_unp
    vev_put_up i
    ob_putc uchar 10
  end
  if gt get vev_unparsed 0 un
    ob_puts vev_t_more
    ob_put_u64 sub get vev_unparsed 0 un
    ob_puts vev_t_more2
  end
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vev_json_byte c uchar to void
  if or eq c 34 eq c 92
    ob_putc uchar 92
    ob_putc c
    ret
  end
  if lt c 32
    ob_putc uchar 92
    ob_putc uchar 117
    ob_putc uchar 48
    ob_putc uchar 48
    ob_putc get vt_hex ulong shr c 4
    ob_putc get vt_hex ulong and c 15
    ret
  end
  ob_putc c
end

fn vev_json_field r ulong f ulong to void
  ob_putc uchar 34
  l = vev_flen_of r f
  for k ulong l bound 256
    vev_json_byte vev_fget r f k
  end
  ob_putc uchar 34
end

fn vev_json_bool b ulong to void
  if eq b 1
    ob_puts vev_j_true
  else
    ob_puts vev_j_false
  end
end

fn vev_json_item r ulong to void
  ob_puts vev_j_rid
  vev_json_field r VEV_F_RID
  ob_puts vev_j_path
  vev_json_field r VEV_F_PATH
  ob_puts vev_j_claim
  vev_json_field r VEV_F_CLAIM
  ob_puts vev_j_scope
  vev_scope_name vev_rs_get r VEV_S_SCOPE
  ob_puts vev_j_basis
  vev_json_field r VEV_F_BASIS
  ob_puts vev_j_grun
  ob_put_u64 vev_rs_get r VEV_S_GRUN
  ob_puts vev_j_gpass
  ob_put_u64 vev_rs_get r VEV_S_GPASS
  ob_puts vev_j_commit
  vev_json_field r VEV_F_COMMIT
  ob_puts vev_j_phys
  vev_json_field r VEV_F_PHYS
  ob_puts vev_j_run
  vev_json_field r VEV_F_RUN
  ob_puts vev_j_mach
  vev_json_field r VEV_F_MACH
  ob_puts vev_j_real
  vev_json_field r VEV_F_REAL
  ob_puts vev_j_tree
  if eq vev_rs_get r VEV_S_TKNOWN 0
    ob_puts vev_t_unknown
  else
    if eq vev_rs_get r VEV_S_DIRTY 1
      ob_puts vev_j_dirty
    else
      ob_puts vev_t_clean
    end
  end
  ob_puts vev_j_nhm
  nm = get vev_rn r
  if lt nm 0
    ob_putc uchar 45
    ob_put_u64 ulong neg nm
  else
    ob_put_u64 ulong nm
  end
  ob_putc uchar 125
end

note visor_evidence_format_json into v_ob; n is the C buffer size.
fn vev_format_json n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  ob_puts vev_j_count
  ob_put_u64 get vev_cnt 0
  ob_puts vev_j_matched
  ob_put_u64 get vev_matched 0
  ob_puts vev_j_scanned
  ob_put_u64 get vev_scanned 0
  ob_puts vev_j_unparsed
  ob_put_u64 get vev_unparsed 0
  ob_puts vev_j_trunc
  vev_json_bool get vev_trunc 0
  ob_puts vev_j_receipts
  c = get vev_cnt 0
  for i ulong c bound 16
    if gt i 0
      ob_putc uchar 44
    end
    vev_json_item i
  end
  ob_puts vev_j_upaths
  un = get vev_upn 0
  for i ulong un bound 8
    if gt i 0
      ob_putc uchar 44
    end
    ob_putc uchar 34
    l = get vev_upl i
    b = mul i 256
    for k ulong l bound 256
      vev_json_byte get vev_up add b k
    end
    ob_putc uchar 34
  end
  ob_puts vev_j_end
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

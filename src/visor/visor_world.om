note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor lane 6: read-only World view (port of src/visor/visor_world.c:
note VisorWorldView, visor_world_gap_append, visor_world_unattached and the two
note deterministic renderings). The runtime snapshot (src/visor/rx/visor_world_rx.c)
note is not part of the V1 omega binary and stays in C with tests/visor/test_visor_world.c.
note Depends on visor.om.
note The omega binary renders only the unattached view: tools/omega_ops.om vom_world calls
note vwld_unattached and then a rendering, and nothing else in omega fills the view
note (tests/visor/check_world_unattached.sh enforces both). That view, text and JSON, is
note pinned against the C by make test-visor-effect-parity (corpus command G).

const VWLD_MAX_OBJECTS ulong 32

text vwld_g_unatt "no resident World attached in this session: the V1 omega binary does not link the runtime (src/runtime); nothing here is observed"
text vwld_t_unattached "unattached"
text vwld_t_attached "attached"
text vwld_t_dash "-"
text vwld_t_none "none"
text vwld_t_sep "; "
text vwld_t_w "world: "
text vwld_t_state "  state:              "
text vwld_t_gen "  generation:         "
text vwld_t_genno "  generation:         (not observable)\n"
text vwld_t_res "  resident objects:   "
text vwld_t_shown " (shown "
text vwld_t_rpar ")\n"
text vwld_t_rxn "  reactions:          "
text vwld_t_act "  active work:        "
text vwld_t_pub "  published results:  "
text vwld_t_pubno " (not observable)"
text vwld_t_st "  staged effects:     "
text vwld_t_stno "  staged effects:     (not visible)\n"
text vwld_t_tail "  publication tail:   "
text vwld_t_dig "  digest:             "
text vwld_t_obj "  object "
text vwld_t_gap "  gap: "
text vwld_t_note "  note: view only; this view holds no authority over the World\n"
text vwld_j_att "{\"attached\":"
text vwld_j_state ",\"state\":"
text vwld_j_gen ",\"generation\":"
text vwld_j_genobs ",\"generation_observable\":"
text vwld_j_res ",\"resident_object_count\":"
text vwld_j_rxn ",\"reaction_count\":"
text vwld_j_act ",\"active_work\":"
text vwld_j_pub ",\"published_results\":"
text vwld_j_st ",\"staged_effects\":"
text vwld_j_stv ",\"staged_effects_visible\":"
text vwld_j_tail ",\"publication_tail\":"
text vwld_j_dig ",\"digest\":"
text vwld_j_objs ",\"objects\":["
text vwld_j_oid "{\"id\":"
text vwld_j_okind ",\"kind\":"
text vwld_j_ostate ",\"state\":"
text vwld_j_gap "],\"gap_note\":"
text vwld_j_auth ",\"authority\":false}"
text vwld_j_true "true"
text vwld_j_false "false"
text vwld_j_null "null"
text vwld_hx "0123456789abcdef"

note ---- VisorWorldView ----
global vwld_generation ulong 1
global vwld_state uchar 64
global vwld_slen ulong 1
global vwld_res_cnt ulong 1
global vwld_act_cnt ulong 1
global vwld_rxn_cnt ulong 1
global vwld_pub_cnt ulong 1
global vwld_staged ulong 1
global vwld_staged_vis ulong 1
global vwld_pub_tail ulong 1
global vwld_digest uchar 72
global vwld_dlen ulong 1
global vwld_attached ulong 1
global vwld_gap uchar 256
global vwld_glen ulong 1
global vwld_obj_cnt ulong 1
global vwld_oid uchar 2304
global vwld_oidl ulong 32
global vwld_okind uchar 1024
global vwld_okl ulong 32
global vwld_ostate uchar 1024
global vwld_osl ulong 32

fn vwld_reset to void
  put vwld_generation 0 0
  put vwld_slen 0 0
  put vwld_res_cnt 0 0
  put vwld_act_cnt 0 0
  put vwld_rxn_cnt 0 0
  put vwld_pub_cnt 0 0
  put vwld_staged 0 0
  put vwld_staged_vis 0 0
  put vwld_pub_tail 0 0
  put vwld_dlen 0 0
  put vwld_attached 0 0
  put vwld_glen 0 0
  put vwld_obj_cnt 0 0
end

note visor_world_gap_append: "; "-separated, bounded to 255 bytes (snprintf into 256).
fn vwld_gap_put c uchar to void
  n = get vwld_glen 0
  if lt n 255
    put vwld_gap n c
    put vwld_glen 0 add n 1
  end
end

fn vwld_append_gap s view uchar * to void
  sl = len s
  if eq sl 0
    ret
  end
  cur = get vwld_glen 0
  if ge cur 255
    ret
  end
  if gt cur 0
    for i ulong 2
      vwld_gap_put get vwld_t_sep i
    end
  end
  for i ulong sl bound 4096
    vwld_gap_put get s i
  end
end

fn vwld_unattached to void
  vwld_reset
  sl = len vwld_t_unattached
  for i ulong sl bound 64
    put vwld_state i get vwld_t_unattached i
  end
  put vwld_slen 0 sl
  vwld_append_gap vwld_g_unatt
end

note ---- bounded writer: the C Buf overflow makes the whole render -1 ----

fn vwld_finish to long
  if ne get v_ob_ovf 0 0
    put v_ob_len 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vwld_put_state_or_dash to void
  sl = get vwld_slen 0
  if eq sl 0
    ob_puts vwld_t_dash
    ret
  end
  for i ulong sl bound 64
    ob_putc get vwld_state i
  end
end

note "%-Ns" of field bytes [base, base+l) of buf sel (0 id, 1 kind, 2 state).
fn vwld_put_field sel ulong slot ulong w ulong to void
  l = ulong 0
  if eq sel 0
    l = get vwld_oidl slot
    for i ulong l bound 72
      ob_putc get vwld_oid add mul slot 72 i
    end
  end
  if eq sel 1
    l = get vwld_okl slot
    if eq l 0
      ob_puts vwld_t_dash
      l = 1
    end
    for i ulong get vwld_okl slot bound 32
      ob_putc get vwld_okind add mul slot 32 i
    end
  end
  if eq sel 2
    l = get vwld_osl slot
    if eq l 0
      ob_puts vwld_t_dash
      l = 1
    end
    for i ulong get vwld_osl slot bound 32
      ob_putc get vwld_ostate add mul slot 32 i
    end
  end
  if lt l w
    for i ulong sub w l bound 32
      ob_putc uchar 32
    end
  end
end

fn vwld_format_text n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  ob_puts vwld_t_w
  if ne get vwld_attached 0 0
    ob_puts vwld_t_attached
  else
    ob_puts vwld_t_unattached
  end
  ob_putc uchar 10
  ob_puts vwld_t_state
  vwld_put_state_or_dash
  ob_putc uchar 10
  g = get vwld_generation 0
  if ne g 0
    ob_puts vwld_t_gen
    ob_put_u64 g
    ob_putc uchar 10
  else
    ob_puts vwld_t_genno
  end
  ob_puts vwld_t_res
  ob_put_u64 get vwld_res_cnt 0
  ob_puts vwld_t_shown
  ob_put_u64 get vwld_obj_cnt 0
  ob_puts vwld_t_rpar
  ob_puts vwld_t_rxn
  ob_put_u64 get vwld_rxn_cnt 0
  ob_putc uchar 10
  ob_puts vwld_t_act
  ob_put_u64 get vwld_act_cnt 0
  ob_putc uchar 10
  ob_puts vwld_t_pub
  pc = get vwld_pub_cnt 0
  ob_put_u64 pc
  if eq pc 0
    ob_puts vwld_t_pubno
  end
  ob_putc uchar 10
  if ne get vwld_staged_vis 0 0
    ob_puts vwld_t_st
    ob_put_u64 get vwld_staged 0
    ob_putc uchar 10
  else
    ob_puts vwld_t_stno
  end
  ob_puts vwld_t_tail
  ob_put_u64 get vwld_pub_tail 0
  ob_putc uchar 10
  ob_puts vwld_t_dig
  dl = get vwld_dlen 0
  if eq dl 0
    ob_puts vwld_t_dash
  else
    for i ulong dl bound 72
      ob_putc get vwld_digest i
    end
  end
  ob_putc uchar 10
  shown = get vwld_obj_cnt 0
  if gt shown VWLD_MAX_OBJECTS
    shown = VWLD_MAX_OBJECTS
  end
  for i ulong shown bound 32
    ob_puts vwld_t_obj
    vwld_put_field 0 i 22
    ob_putc uchar 32
    vwld_put_field 1 i 10
    ob_putc uchar 32
    vwld_put_field 2 i 0
    ob_putc uchar 10
  end
  ob_puts vwld_t_gap
  gl = get vwld_glen 0
  if eq gl 0
    ob_puts vwld_t_none
  else
    for i ulong gl bound 256
      ob_putc get vwld_gap i
    end
  end
  ob_putc uchar 10
  ob_puts vwld_t_note
  ret vwld_finish
end

note bjson_str byte: escapes ", \ and bytes below 0x20 (0x7F passes through here).
fn vwld_jbyte c ulong to void
  if or eq c 34 eq c 92
    ob_putc uchar 92
    ob_putc uchar c
    ret
  end
  if lt c 32
    ob_putc uchar 92
    ob_putc uchar 117
    ob_putc uchar 48
    ob_putc uchar 48
    ob_putc get vwld_hx shr c 4
    ob_putc get vwld_hx and c 15
    ret
  end
  ob_putc uchar c
end

fn vwld_jtf b bool to void
  if b
    ob_puts vwld_j_true
  else
    ob_puts vwld_j_false
  end
end

note A JSON string of field sel of object slot (C NULL kind/state renders null).
fn vwld_jfield sel ulong slot ulong to void
  if and eq sel 1 eq get vwld_okl slot 0
    ob_puts vwld_j_null
    ret
  end
  if and eq sel 2 eq get vwld_osl slot 0
    ob_puts vwld_j_null
    ret
  end
  ob_putc uchar 34
  if eq sel 0
    for i ulong get vwld_oidl slot bound 72
      vwld_jbyte ulong get vwld_oid add mul slot 72 i
    end
  end
  if eq sel 1
    for i ulong get vwld_okl slot bound 32
      vwld_jbyte ulong get vwld_okind add mul slot 32 i
    end
  end
  if eq sel 2
    for i ulong get vwld_osl slot bound 32
      vwld_jbyte ulong get vwld_ostate add mul slot 32 i
    end
  end
  ob_putc uchar 34
end

fn vwld_json_head to void
  ob_puts vwld_j_att
  vwld_jtf ne get vwld_attached 0 0
  ob_puts vwld_j_state
  sl = get vwld_slen 0
  if eq sl 0
    ob_puts vwld_j_null
  else
    ob_putc uchar 34
    for i ulong sl bound 64
      vwld_jbyte ulong get vwld_state i
    end
    ob_putc uchar 34
  end
  g = get vwld_generation 0
  ob_puts vwld_j_gen
  ob_put_u64 g
  ob_puts vwld_j_genobs
  vwld_jtf ne g 0
  ob_puts vwld_j_res
  ob_put_u64 get vwld_res_cnt 0
  ob_puts vwld_j_rxn
  ob_put_u64 get vwld_rxn_cnt 0
  ob_puts vwld_j_act
  ob_put_u64 get vwld_act_cnt 0
  ob_puts vwld_j_pub
  ob_put_u64 get vwld_pub_cnt 0
  ob_puts vwld_j_st
  ob_put_u64 get vwld_staged 0
  ob_puts vwld_j_stv
  vwld_jtf ne get vwld_staged_vis 0 0
  ob_puts vwld_j_tail
  ob_put_u64 get vwld_pub_tail 0
  ob_puts vwld_j_dig
  dl = get vwld_dlen 0
  if eq dl 0
    ob_puts vwld_j_null
  else
    ob_putc uchar 34
    for i ulong dl bound 72
      vwld_jbyte ulong get vwld_digest i
    end
    ob_putc uchar 34
  end
end

fn vwld_format_json n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  vwld_json_head
  ob_puts vwld_j_objs
  shown = get vwld_obj_cnt 0
  if gt shown VWLD_MAX_OBJECTS
    shown = VWLD_MAX_OBJECTS
  end
  for i ulong shown bound 32
    if gt i 0
      ob_putc uchar 44
    end
    ob_puts vwld_j_oid
    vwld_jfield 0 i
    ob_puts vwld_j_okind
    vwld_jfield 1 i
    ob_puts vwld_j_ostate
    vwld_jfield 2 i
    ob_putc uchar 125
  end
  ob_puts vwld_j_gap
  ob_putc uchar 34
  for i ulong get vwld_glen 0 bound 256
    vwld_jbyte ulong get vwld_gap i
  end
  ob_putc uchar 34
  ob_puts vwld_j_auth
  ret vwld_finish
end

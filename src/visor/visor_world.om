note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor lane 6: read-only World view
note (replaces src/visor/visor_world.c and src/visor/rx/visor_world_rx.c).
note Depends on visor.om.

text vwld_t_unatt "world: unattached (V1 omega binary does not link the runtime; holds no authority)\n"
text vwld_t_att "world: attached (read-only snapshot; holds no authority)\n"
text vwld_t_gen "  generation:         (not observable)\n"
text vwld_t_st "  staged_effects:     (not visible)\n"
text vwld_t_objs "  resident_objects:   "
text vwld_t_rxn "\n  reactions:          "
text vwld_t_pub "\n  publication_tail:   "
text vwld_t_dig "\n  digest:             sha256:"
text vwld_t_gap "\n  gap_note:           "
text vwld_t_obj_pfx "    rx:"
text vwld_t_at "@"
text vwld_t_sp " "
text vwld_k_res "RESIDENT"
text vwld_k_eph "EPHEMERAL"
text vwld_k_dur "DURABLE"
text vwld_s_live "live"
text vwld_s_placed "live,placed"
text vwld_g_unatt "V1 omega binary does not link the runtime; holds no authority"
text vwld_g_null "NULL world: fail closed"
text vwld_g_att "generation not observable; published results not observable; staged effects not visible; coherent only when quiescent"
text vwld_g_trunc "; object list truncated at 32"
text vwld_j_unatt "{\"attached\":false,\"authority\":false,\"staged_effects_visible\":false,\"generation_observable\":false,\"resident_object_count\":0,\"object_count\":0,\"gap_note\":\"V1 omega binary does not link the runtime; holds no authority\"}"
text vwld_j_a1 "{\"attached\":true,\"authority\":false,\"staged_effects_visible\":false,\"generation_observable\":false,\"resident_object_count\":"
text vwld_j_a2 ",\"object_count\":"
text vwld_j_a3 ",\"reaction_count\":"
text vwld_j_a4 ",\"publication_tail\":"
text vwld_j_a5 ",\"digest\":\"sha256:"
text vwld_j_a6 "\"}"

global vwld_attached ulong 1
global vwld_res_cnt ulong 1
global vwld_obj_cnt ulong 1
global vwld_rxn_cnt ulong 1
global vwld_act_cnt ulong 1
global vwld_pub_tail ulong 1
global vwld_digest uchar 32
global vwld_oid ulong 32
global vwld_ogen ulong 32
global vwld_opers ulong 32
global vwld_oplaced ulong 32
global vwld_gap uchar 256
global vwld_glen ulong 1

fn vwld_set_gap s view uchar * to void
  n = len s
  if gt n 255
    n = 255
  end
  for i ulong n bound 256
    put vwld_gap i get s i
  end
  put vwld_glen 0 n
end

fn vwld_append_gap s view uchar * to void
  cur = get vwld_glen 0
  n = len s
  for i ulong n bound 256
    if lt add cur i 255
      put vwld_gap add cur i get s i
    end
  end
  nn = add cur n
  if gt nn 255
    nn = 255
  end
  put vwld_glen 0 nn
end

fn vwld_unattached to void
  put vwld_attached 0 0
  put vwld_res_cnt 0 0
  put vwld_obj_cnt 0 0
  put vwld_rxn_cnt 0 0
  put vwld_act_cnt 0 0
  put vwld_pub_tail 0 0
  vwld_set_gap vwld_g_unatt
end

fn vwld_fail_closed to void
  put vwld_attached 0 0
  put vwld_res_cnt 0 0
  put vwld_obj_cnt 0 0
  put vwld_rxn_cnt 0 0
  put vwld_act_cnt 0 0
  put vwld_pub_tail 0 0
  vwld_set_gap vwld_g_null
end

fn vwld_format_text cap ulong to long
  ob_reset cap
  if eq get vwld_attached 0 0
    ob_puts vwld_t_unatt
  else
    ob_puts vwld_t_att
    ob_puts vwld_t_gen
    ob_puts vwld_t_st
    ob_puts vwld_t_objs
    ob_put_u64 get vwld_res_cnt 0
    ob_puts vwld_t_rxn
    ob_put_u64 get vwld_rxn_cnt 0
    ob_puts vwld_t_pub
    ob_put_u64 get vwld_pub_tail 0
    ob_puts vwld_t_dig
    for i ulong 32
      ob_put_hex_byte ulong get vwld_digest i
    end
    ob_puts vwld_t_gap
    gl = get vwld_glen 0
    for i ulong gl bound 256
      ob_putc get vwld_gap i
    end
    ob_putc uchar 10
    oc = get vwld_obj_cnt 0
    for i ulong oc bound 32
      ob_puts vwld_t_obj_pfx
      ob_put_u64 get vwld_oid i
      ob_puts vwld_t_at
      ob_put_u64 get vwld_ogen i
      ob_puts vwld_t_sp
      ps = get vwld_opers i
      if eq ps 0
        ob_puts vwld_k_res
      else
        if eq ps 1
          ob_puts vwld_k_eph
        else
          ob_puts vwld_k_dur
        end
      end
      ob_puts vwld_t_sp
      if ne get vwld_oplaced i 0
        ob_puts vwld_s_placed
      else
        ob_puts vwld_s_live
      end
      ob_putc uchar 10
    end
  end
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vwld_format_json cap ulong to long
  ob_reset cap
  if eq get vwld_attached 0 0
    ob_puts vwld_j_unatt
  else
    ob_puts vwld_j_a1
    ob_put_u64 get vwld_res_cnt 0
    ob_puts vwld_j_a2
    ob_put_u64 get vwld_obj_cnt 0
    ob_puts vwld_j_a3
    ob_put_u64 get vwld_rxn_cnt 0
    ob_puts vwld_j_a4
    ob_put_u64 get vwld_pub_tail 0
    ob_puts vwld_j_a5
    for i ulong 32
      ob_put_hex_byte ulong get vwld_digest i
    end
    ob_puts vwld_j_a6
  end
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

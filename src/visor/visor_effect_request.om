note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor lane 7: effect requests, a port of src/visor/visor_effect_request.c
note (visor_effect_request_build, _classify, _format_text, _format_json), qualified against
note that C by tests/visor/effect_parity.sh (make test-visor-effect-parity: committed goldens
note generated from the C at main commit 3f2c70dc5, mutants included).
note Invariant: THE VISOR CAN ASK. THE VISOR CANNOT GRANT.
note authorized is ALWAYS false (constant 0). Never mints, grants, or submits.
note Depends on visor.om and, for the strict object validation, visor_verify.om
note (vver_validate_object is the OM port of omega_validate_object, vver_eff_code of
note omega_effect_read's strict v2 decode).
note
note The C takes a SemanticId; verq_build and verq_classify take an object index and resolve
note it through that object's id to the FIRST object with that id, which is the object C's
note omega_graph_find_object_const returns, so duplicate ids behave as in C.
note Deliberate differences from the C, each fail closed and none reachable from a graph the
note OmegaGraph store can hold (V_MAX_OBJS = OMEGA_MAX_GRAPH_OBJECTS = 256 session objects):
note  D1 verq_build and verq_classify return -1 (classify: needs 1) when the graph holds more
note     than V_MAX_OBJS objects (C classify does the same; C build cannot see such a graph,
note     since omega_graph_add_object stops at 256; OM can, while v_og_scratch is set).
note  D2 an index at or past the object count returns -1 (C takes an id, not an index).
note  D3 the formatters return the rendered length instead of 0, and -1 when it does not fit
note     cap bytes (C: -1 when it does not fit n bytes with its NUL).
note There is no walk depth limit: the walk is an explicit stack over a visited set, as C's
note Walk, both sized to the store's V_OG_SLOTS slots, and every loop bound is the real maximum
note (64 relations, 4 operands, 4 input types, V_OG_SLOTS objects), so no valid graph traps.

text verq_t_hdr "effect request (UNAUTHORIZED_REQUEST)\n  effect:     sha256:"
text verq_t_res "\n  resource:   class "
text verq_t_op "\n  operation:  code "
text verq_t_cap "\n  capability: slot "
text verq_t_gen " generation "
text verq_t_ref " ref sha256:"
text verq_t_nv " (not validated by the Visor)\n  params:     "
text verq_t_by " bytes "
text verq_t_dig "\n  digest:     sha256:"
text verq_t_auth "\n  authorized: false\n  route:      Visor -> EffectIntent -> AEGIS/PHYSICS authority -> bounded execution -> receipt\n"
text verq_j_1 "{\"effect_id\":\"sha256:"
text verq_j_2 "\",\"resource_class\":"
text verq_j_3 ",\"operation_code\":"
text verq_j_4 ",\"capability_slot\":"
text verq_j_5 ",\"capability_generation\":"
text verq_j_6 ",\"capability_ref\":\"sha256:"
text verq_j_7 "\",\"param_len\":"
text verq_j_8 ",\"param_bytes\":\""
text verq_j_9 "\",\"request_digest\":\"sha256:"
text verq_j_10 "\",\"authorized\":false,\"status\":\"UNAUTHORIZED_REQUEST\",\"route\":\"Visor -> EffectIntent -> AEGIS/PHYSICS authority -> bounded execution -> receipt\"}"

global verq_eff_id uchar 32
global verq_res_cls ulong 1
global verq_op_code ulong 1
global verq_cap_slot ulong 1
global verq_cap_gen ulong 1
global verq_cap_ref uchar 32
global verq_plen ulong 1
global verq_pbytes uchar 128
global verq_digest uchar 32
global verq_seen uchar 512
global verq_stack ulong 512
global verq_sp ulong 1
global verq_missing ulong 1
global verq_needs ulong 1

note Effect payload v2 fields are big-endian (src/omega_core.c eff_get16/32/64 and the
note encoder og_build_effect): read nb bytes at pb+off most significant first.
fn verq_be pb ulong off ulong nb ulong to ulong
  r = ulong 0
  for i ulong nb bound 8
    r = or shl r 8 ulong get v_og_pay add add pb off i
  end
  ret r
end

fn verq_reset to void
  put verq_res_cls 0 0
  put verq_op_code 0 0
  put verq_cap_slot 0 0
  put verq_cap_gen 0 0
  put verq_plen 0 0
  for i ulong 32
    put verq_eff_id i uchar 0
    put verq_cap_ref i uchar 0
    put verq_digest i uchar 0
  end
end

fn verq_populate idx ulong pb ulong plen ulong to void
  ib = mul idx 32
  for i ulong 32
    put verq_eff_id i get v_og_id add ib i
    put verq_cap_ref i get v_og_pay add add pb 16 i
    put verq_digest i get v_sha_out i
  end
  put verq_res_cls 0 verq_be pb 0 2
  put verq_op_code 0 verq_be pb 2 2
  put verq_cap_slot 0 verq_be pb 4 4
  put verq_cap_gen 0 verq_be pb 8 8
  put verq_plen 0 plen
  p50 = add pb 50
  for i ulong plen bound 128
    put verq_pbytes i get v_og_pay add p50 i
  end
end

note The first object whose id equals the id of object idx (C index_of / find_object_const), or -1.
fn verq_resolve idx ulong to long
  cnt = get v_og_cnt 0
  if gt cnt V_MAX_OBJS
    ret -1
  end
  if ge idx cnt
    ret -1
  end
  og_tmp_from_obj idx
  ret og_find_by_tmp
end

note visor_effect_request_build: omega_validate_object, the 178-byte strict v2 decode
note (omega_effect_read: length, legacy v1, resource 0, param_len, padding) and the canonical
note digest equal to the stored id. Any failure is -1 with the request left zeroed.
fn verq_build idx ulong to long
  verq_reset
  f = verq_resolve idx
  if lt f 0
    ret -1
  end
  o = ulong f
  if or eq get v_og_has_id o 0 ne get v_og_kind o V_KIND_EFFECT
    ret -1
  end
  if ne vver_validate_object o 0
    ret -1
  end
  if ne get v_og_plen o 178
    ret -1
  end
  if ne vver_eff_code o 0
    ret -1
  end
  pb = mul o V_MAX_PAYLOAD
  plen = verq_be pb 48 2
  if gt plen 128
    ret -1
  end
  note Digest = sha256(canonical encoding) must equal the stored SemanticId (refuse edited objects)
  if lt og_hash_encoding o 0
    ret -1
  end
  if not og_id_eq_sha o
    ret -1
  end
  verq_populate o pb plen
  ret 0
end

fn verq_is_zero_tmp to bool
  for i ulong 32
    if ne get v_tmp_id i uchar 0
      ret false
    end
  end
  ret true
end

note push_ref: the id in v_tmp_id. Zero = field unused; missing = fail closed; seen once.
fn verq_push_tmp to void
  if verq_is_zero_tmp
    ret
  end
  ti = og_find_by_tmp
  if lt ti 0
    put verq_missing 0 1
    ret
  end
  t = ulong ti
  if ne get verq_seen t uchar 0
    ret
  end
  put verq_seen t uchar 1
  sp = get verq_sp 0
  put verq_stack sp t
  put verq_sp 0 add sp 1
end

fn verq_push_pay pb ulong off ulong to void
  for i ulong 32
    put v_tmp_id i get v_og_pay add add pb off i
  end
  verq_push_tmp
end

note object_needs_authority: an EFFECT, or a TYPE whose TypePayload (44 bytes; tag a 4-byte
note little-endian enum at 0) is tagged capability, effect-intent or effect-receipt ref.
fn verq_needs_auth o ulong to bool
  k = get v_og_kind o
  if eq k V_KIND_EFFECT
    ret true
  end
  if and eq k V_KIND_TYPE ge get v_og_plen o 44
    tag = v_dec_u32le_pay mul o V_MAX_PAYLOAD 0
    if or eq tag V_TY_CAP_REF or eq tag V_TY_EFF_INTENT_REF eq tag V_TY_EFF_RECEIPT_REF
      ret true
    end
  end
  ret false
end

note push_payload_refs, at the C struct offsets (aarch64): TypePayload.elem_type 12 (size 44);
note ValuePayload.type_id 0 (size 98); OperationPayload (size 204) type_id 8, input_types
note 41 73 105 137, output_type 169; else ApplyPayload (size 161) op_id 0, operand_count 32
note (at most 4 used), operands 33 65 97 129; an effect that decodes: capability_ref 16.
fn verq_push_payload_refs o ulong to void
  k = get v_og_kind o
  pl = get v_og_plen o
  pb = mul o V_MAX_PAYLOAD
  if eq k V_KIND_TYPE
    if ge pl 44
      verq_push_pay pb 12
    end
    ret
  end
  if eq k V_KIND_VALUE
    if ge pl 98
      verq_push_pay pb 0
    end
    ret
  end
  if eq k V_KIND_OP
    if ge pl 204
      verq_push_pay pb 8
      for i ulong 4
        verq_push_pay pb add 41 mul i 32
      end
      verq_push_pay pb 169
      ret
    end
    if ge pl 161
      verq_push_pay pb 0
      n = ulong get v_og_pay add pb 32
      if gt n 4
        n = 4
      end
      for i ulong n bound 4
        verq_push_pay pb add 33 mul i 32
      end
    end
    ret
  end
  if eq k V_KIND_EFFECT
    if eq vver_eff_code o 0
      verq_push_pay pb 16
    end
  end
end

note Every relation target (at most V_MAX_RELS = OMEGA_MAX_RELATIONS, as C clamps rel_count).
fn verq_push_rels o ulong to void
  nrel = get v_og_rcnt o
  if gt nrel V_MAX_RELS
    nrel = V_MAX_RELS
  end
  for r ulong nrel bound V_MAX_RELS
    tb = mul og_rslot o r 32
    for i ulong 32
      put v_tmp_id i get v_og_rtgt add tb i
    end
    verq_push_tmp
  end
end

note visor_effect_request_classify: verq_needs = 1 when anything reachable from the object
note (relations and payload references) needs authority. -1 (verq_needs 1, fail closed) when
note the object or any referenced non-zero id is missing from the graph.
fn verq_classify idx ulong to long
  put verq_needs 0 1
  put verq_missing 0 0
  put verq_sp 0 0
  f = verq_resolve idx
  if lt f 0
    ret -1
  end
  root = ulong f
  for i ulong V_OG_SLOTS
    put verq_seen i uchar 0
  end
  put verq_seen root uchar 1
  put verq_stack 0 root
  put verq_sp 0 1
  needs = false
  while gt get verq_sp 0 0 bound V_OG_SLOTS
    sp = sub get verq_sp 0 1
    put verq_sp 0 sp
    o = get verq_stack sp
    if verq_needs_auth o
      needs = true
    end
    verq_push_rels o
    verq_push_payload_refs o
  end
  if ne get verq_missing 0 0
    ret -1
  end
  if needs
    put verq_needs 0 1
  else
    put verq_needs 0 0
  end
  ret 0
end

fn verq_format_text cap ulong to long
  ob_reset cap
  ob_puts verq_t_hdr
  for i ulong 32
    ob_put_hex_byte ulong get verq_eff_id i
  end
  ob_puts verq_t_res
  ob_put_u64 get verq_res_cls 0
  ob_puts verq_t_op
  ob_put_u64 get verq_op_code 0
  ob_puts verq_t_cap
  ob_put_u64 get verq_cap_slot 0
  ob_puts verq_t_gen
  ob_put_u64 get verq_cap_gen 0
  ob_puts verq_t_ref
  for i ulong 32
    ob_put_hex_byte ulong get verq_cap_ref i
  end
  ob_puts verq_t_nv
  pl = get verq_plen 0
  ob_put_u64 pl
  ob_puts verq_t_by
  for i ulong pl bound 128
    ob_put_hex_byte ulong get verq_pbytes i
  end
  ob_puts verq_t_dig
  for i ulong 32
    ob_put_hex_byte ulong get verq_digest i
  end
  ob_puts verq_t_auth
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn verq_format_json cap ulong to long
  ob_reset cap
  ob_puts verq_j_1
  for i ulong 32
    ob_put_hex_byte ulong get verq_eff_id i
  end
  ob_puts verq_j_2
  ob_put_u64 get verq_res_cls 0
  ob_puts verq_j_3
  ob_put_u64 get verq_op_code 0
  ob_puts verq_j_4
  ob_put_u64 get verq_cap_slot 0
  ob_puts verq_j_5
  ob_put_u64 get verq_cap_gen 0
  ob_puts verq_j_6
  for i ulong 32
    ob_put_hex_byte ulong get verq_cap_ref i
  end
  ob_puts verq_j_7
  pl = get verq_plen 0
  ob_put_u64 pl
  ob_puts verq_j_8
  for i ulong pl bound 128
    ob_put_hex_byte ulong get verq_pbytes i
  end
  ob_puts verq_j_9
  for i ulong 32
    ob_put_hex_byte ulong get verq_digest i
  end
  ob_puts verq_j_10
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

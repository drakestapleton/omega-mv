note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor V1 lane 5: machine view (read-only).
note Port of src/visor/visor_machine.c and the machine-graph half of
note src/omega_machine.c: the canonical dgx_spark / qemu_virt builders, the
note OMG0 machine id (omega_machine_compute_id), topology validation and its
note messages, the view, host facts, profile selection from facts with its
note provenance text, the declared aarch64 and Blackwell targets (Blackwell id =
note sha256 of "NVIDIA_DGX_SPARK_GB10_SM121", omega_blackwell_get_machine_id),
note and the text and JSON renderings with the C buffer-size rule.
note Graph slots 0..15 (a view v owns graph slot 8+v); view slots 0..7.
note The host machine word comes from /proc/sys/kernel/arch (the kernel's
note uname machine string; OM has no uname host word).
note Depends on visor.om.

const VMCH_GS ulong 128
const VMCH_K_PROF ulong 0
const VMCH_K_ISSUE ulong 1
const VMCH_K_MIF ulong 2
const VMCH_K_OOO ulong 3
const VMCH_K_UCNT ulong 4
const VMCH_K_GPRC ulong 5
const VMCH_K_GPRW ulong 6
const VMCH_K_VECC ulong 7
const VMCH_K_VECW ulong 8
const VMCH_K_CCNT ulong 9
const VMCH_K_DBASE ulong 10
const VMCH_K_DSIZE ulong 11
const VMCH_K_PHYS ulong 12
const VMCH_K_NLEN ulong 13
const VMCH_K_UNIT ulong 16
const VMCH_K_CACHE ulong 48
const VMCH_MAXU ulong 8
const VMCH_MAXC ulong 8

text vmch_t_a64 "aarch64-v8a"
text vmch_t_bw "blackwell-gb10-sm121"
text vmch_bw_name "NVIDIA_DGX_SPARK_GB10_SM121"

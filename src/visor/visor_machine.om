note ---- graph slots ----
global vmch_g ulong 2048
global vmch_gname uchar 1024
global vmch_gseal uchar 512
global vmch_gid uchar 512

note ---- view slots ----
global vmch_vprov uchar 3072
global vmch_vprovl ulong 8
global vmch_vtopo ulong 8
global vmch_vterr uchar 768
global vmch_vterrl ulong 8
global vmch_vph ulong 8
global vmch_vobs ulong 8
global vmch_vtcnt ulong 8

note ---- host facts: 0 uname machine (32), 1 dmi product (64), 2 cpu parts (64) ----
global vmch_fact uchar 192
global vmch_factl ulong 3
global vmch_fbuf uchar 65536
global vmch_fblen ulong 1
global vmch_parts uchar 204
global vmch_partl ulong 17
global vmch_pcnt ulong 1

note ---- scratch text (topology error) and session state ----
global vmch_err uchar 96
global vmch_errl ulong 1
global vmch_id uchar 32
global vmch_bw_id uchar 32
global vmch_bw_ok ulong 1
global vmch_is_spark ulong 1
global vmch_profile ulong 1

note ---- graph field access ----
fn vmch_gget g ulong k ulong to ulong
  ret get vmch_g add mul g VMCH_GS k
end

fn vmch_gset g ulong k ulong v ulong to void
  put vmch_g add mul g VMCH_GS k v
end

fn vmch_init g ulong name view uchar * prof ulong to void
  b = mul g VMCH_GS
  for k ulong VMCH_GS
    put vmch_g add b k 0
  end
  nb = mul g 64
  for k ulong 64
    put vmch_gname add nb k uchar 0
  end
  sb = mul g 32
  for k ulong 32
    put vmch_gseal add sb k uchar 0
    put vmch_gid add sb k uchar 0
  end
  n = len name
  if gt n 63
    n = 63
  end
  for k ulong n
    put vmch_gname add nb k get name k
  end
  vmch_gset g VMCH_K_NLEN n
  vmch_gset g VMCH_K_PROF prof
end

fn vmch_unit g ulong u ulong ty ulong cnt ulong to void
  b = add VMCH_K_UNIT mul u 4
  vmch_gset g b ty
  vmch_gset g add b 1 cnt
end

fn vmch_unit2 g ulong u ulong lat ulong thr ulong to void
  b = add VMCH_K_UNIT mul u 4
  vmch_gset g add b 2 lat
  vmch_gset g add b 3 thr
end

fn vmch_cache g ulong c ulong lvl ulong isi ulong size ulong to void
  b = add VMCH_K_CACHE mul c 6
  vmch_gset g b lvl
  vmch_gset g add b 1 isi
  vmch_gset g add b 2 size
end

fn vmch_cache2 g ulong c ulong line ulong assoc ulong lat ulong to void
  b = add VMCH_K_CACHE mul c 6
  vmch_gset g add b 3 line
  vmch_gset g add b 4 assoc
  vmch_gset g add b 5 lat
end

fn vmch_seal_fill g ulong b uchar to void
  sb = mul g 32
  for k ulong 32
    put vmch_gseal add sb k b
  end
end

fn vmch_graph_copy dst ulong src ulong to void
  db = mul dst VMCH_GS
  sb = mul src VMCH_GS
  for k ulong VMCH_GS
    put vmch_g add db k get vmch_g add sb k
  end
  for k ulong 64
    put vmch_gname add mul dst 64 k get vmch_gname add mul src 64 k
  end
  for k ulong 32
    put vmch_gseal add mul dst 32 k get vmch_gseal add mul src 32 k
    put vmch_gid add mul dst 32 k get vmch_gid add mul src 32 k
  end
end

fn vmch_id_eq a ulong b ulong to bool
  for k ulong 32
    if ne get vmch_gid add mul a 32 k get vmch_gid add mul b 32 k
      ret false
    end
  end
  ret true
end

note ---- OMG0 machine id ----
fn vmch_put8 pos ulong v ulong to ulong
  put v_sha_in pos uchar and v 255
  ret add pos 1
end

fn vmch_put32 pos ulong v ulong to ulong
  p = vmch_put8 pos shr v 24
  p = vmch_put8 p shr v 16
  p = vmch_put8 p shr v 8
  ret vmch_put8 p v
end

fn vmch_put64 pos ulong v ulong to ulong
  p = pos
  for b ulong 8
    p = vmch_put8 p shr v mul sub 7 b 8
  end
  ret p
end

fn vmch_ser_units g ulong pos ulong to ulong
  p = vmch_put8 pos vmch_gget g VMCH_K_UCNT
  uc = vmch_gget g VMCH_K_UCNT
  if gt uc VMCH_MAXU
    uc = VMCH_MAXU
  end
  for u ulong uc bound 8
    b = add VMCH_K_UNIT mul u 4
    p = vmch_put8 p vmch_gget g b
    p = vmch_put8 p vmch_gget g add b 1
    p = vmch_put8 p vmch_gget g add b 2
    p = vmch_put8 p vmch_gget g add b 3
  end
  ret p
end

fn vmch_ser_caches g ulong pos ulong to ulong
  p = vmch_put8 pos vmch_gget g VMCH_K_CCNT
  cc = vmch_gget g VMCH_K_CCNT
  if gt cc VMCH_MAXC
    cc = VMCH_MAXC
  end
  for c ulong cc bound 8
    b = add VMCH_K_CACHE mul c 6
    p = vmch_put8 p vmch_gget g b
    p = vmch_put8 p vmch_gget g add b 1
    p = vmch_put64 p vmch_gget g add b 2
    p = vmch_put8 p vmch_gget g add b 3
    p = vmch_put8 p vmch_gget g add b 4
    p = vmch_put8 p vmch_gget g add b 5
  end
  ret p
end

fn vmch_sha_init to void
  if eq get v_sha_k 0 0
    sha_kinit
  end
end

fn vmch_compute_id g ulong to long
  vmch_sha_init
  p = vmch_put8 0 79
  p = vmch_put8 p 77
  p = vmch_put8 p 71
  p = vmch_put8 p 48
  p = vmch_put8 p 7
  p = vmch_put8 p vmch_gget g VMCH_K_PROF
  nl = vmch_gget g VMCH_K_NLEN
  p = vmch_put8 p nl
  nb = mul g 64
  for k ulong nl bound 64
    p = vmch_put8 p ulong get vmch_gname add nb k
  end
  p = vmch_put32 p vmch_gget g VMCH_K_ISSUE
  p = vmch_put32 p vmch_gget g VMCH_K_MIF
  p = vmch_put8 p vmch_gget g VMCH_K_OOO
  p = vmch_ser_units g p
  p = vmch_put8 p vmch_gget g VMCH_K_GPRC
  p = vmch_put8 p vmch_gget g VMCH_K_GPRW
  p = vmch_put8 p vmch_gget g VMCH_K_VECC
  p = vmch_put8 p vmch_gget g VMCH_K_VECW
  p = vmch_ser_caches g p
  p = vmch_put64 p vmch_gget g VMCH_K_DBASE
  p = vmch_put64 p vmch_gget g VMCH_K_DSIZE
  p = vmch_put8 p vmch_gget g VMCH_K_PHYS
  sb = mul g 32
  for k ulong 32
    p = vmch_put8 p ulong get vmch_gseal add sb k
  end
  sha256_hash p
  for k ulong 32
    put vmch_gid add sb k get v_sha_out k
  end
  ret 0
end

note ---- canonical builders ----
fn vmch_build_spark g ulong to long
  vmch_init g vmch_n_spark 1
  vmch_gset g VMCH_K_ISSUE 4
  vmch_gset g VMCH_K_MIF 256
  vmch_gset g VMCH_K_OOO 1
  vmch_gset g VMCH_K_UCNT 6
  vmch_unit g 0 0 4
  vmch_unit2 g 0 1 4
  vmch_unit g 1 1 2
  vmch_unit2 g 1 1 2
  vmch_unit g 2 2 2
  vmch_unit2 g 2 3 2
  vmch_unit g 3 3 1
  vmch_unit2 g 3 12 1
  vmch_unit g 4 4 2
  vmch_unit2 g 4 3 2
  vmch_unit g 5 5 4
  vmch_unit2 g 5 2 4
  vmch_gset g VMCH_K_GPRC 31
  vmch_gset g VMCH_K_GPRW 64
  vmch_gset g VMCH_K_VECC 32
  vmch_gset g VMCH_K_VECW 128
  vmch_gset g VMCH_K_CCNT 4
  vmch_cache g 0 1 1 65536
  vmch_cache2 g 0 64 4 3
  vmch_cache g 1 1 0 65536
  vmch_cache2 g 1 64 8 4
  vmch_cache g 2 2 0 1048576
  vmch_cache2 g 2 64 8 10
  vmch_cache g 3 3 0 119537664
  vmch_cache2 g 3 64 16 35
  vmch_gset g VMCH_K_DBASE 0x80000000
  vmch_gset g VMCH_K_DSIZE 137438953472
  vmch_gset g VMCH_K_PHYS 1
  vmch_seal_fill g uchar 0xa1
  ret vmch_compute_id g
end

fn vmch_build_qemu g ulong to long
  vmch_init g vmch_n_qemu 1
  vmch_gset g VMCH_K_ISSUE 2
  vmch_gset g VMCH_K_MIF 64
  vmch_gset g VMCH_K_OOO 0
  vmch_gset g VMCH_K_UCNT 5
  vmch_unit g 0 0 2
  vmch_unit2 g 0 1 2
  vmch_unit g 1 1 1
  vmch_unit2 g 1 1 1
  vmch_unit g 2 2 1
  vmch_unit2 g 2 4 1
  vmch_unit g 3 4 1
  vmch_unit2 g 3 4 1
  vmch_unit g 4 5 2
  vmch_unit2 g 4 3 2
  vmch_gset g VMCH_K_GPRC 31
  vmch_gset g VMCH_K_GPRW 64
  vmch_gset g VMCH_K_VECC 32
  vmch_gset g VMCH_K_VECW 128
  vmch_gset g VMCH_K_CCNT 3
  vmch_cache g 0 1 1 32768
  vmch_cache2 g 0 64 2 2
  vmch_cache g 1 1 0 32768
  vmch_cache2 g 1 64 4 3
  vmch_cache g 2 2 0 524288
  vmch_cache2 g 2 64 8 12
  vmch_gset g VMCH_K_DBASE 0x40000000
  vmch_gset g VMCH_K_DSIZE 1073741824
  vmch_gset g VMCH_K_PHYS 1
  vmch_seal_fill g uchar 0xb2
  ret vmch_compute_id g
end

note ---- Blackwell declared target id ----
fn vmch_blackwell_id to long
  vmch_sha_init
  n = len vmch_bw_name
  for k ulong n
    put v_sha_in k get vmch_bw_name k
  end
  sha256_hash n
  for k ulong 32
    put vmch_bw_id k get v_sha_out k
  end
  put vmch_bw_ok 0 1
  ret 0
end

note ---- topology validation (messages into vmch_err, at most 95 bytes) ----
fn vmch_err_c c uchar to void
  l = get vmch_errl 0
  if lt l 95
    put vmch_err l c
    put vmch_errl 0 add l 1
  end
end

fn vmch_err_txt w view uchar * to void
  n = len w
  for k ulong n bound 128
    vmch_err_c get w k
  end
end

fn vmch_err_u v ulong to void
  if eq v 0
    vmch_err_c uchar 48
    ret
  end
  x = v
  d = ulong 0
  while gt x 0 bound 24
    put v_numbuf d uchar add 48 rem x 10
    x = div x 10
    d = add d 1
  end
  while gt d 0 bound 24
    d = sub d 1
    vmch_err_c get v_numbuf d
  end
end

fn vmch_caches_ok g ulong to long
  prev = ulong 0
  cc = vmch_gget g VMCH_K_CCNT
  if gt cc VMCH_MAXC
    cc = VMCH_MAXC
  end
  for c ulong cc bound 8
    b = add VMCH_K_CACHE mul c 6
    lvl = vmch_gget g b
    line = vmch_gget g add b 3
    if lt lvl prev
      vmch_err_txt vmch_e_inv
      vmch_err_u lvl
      vmch_err_txt vmch_e_after
      vmch_err_u prev
      ret -1
    end
    bad = eq line 0
    if not bad
      bad = ne and line sub line 1 0
    end
    if bad
      vmch_err_txt vmch_e_line
      vmch_err_u line
      ret -1
    end
    prev = lvl
  end
  ret 0
end

fn vmch_validate g ulong to long
  put vmch_errl 0 0
  if eq vmch_gget g VMCH_K_ISSUE 0
    vmch_err_txt vmch_e_iw
    ret -1
  end
  gc = vmch_gget g VMCH_K_GPRC
  if ne gc 31
    vmch_err_txt vmch_e_gc
    vmch_err_u gc
    vmch_err_txt vmch_e_x31
    ret -1
  end
  gw = vmch_gget g VMCH_K_GPRW
  if ne gw 64
    vmch_err_txt vmch_e_gw
    vmch_err_u gw
    vmch_err_txt vmch_e_x64
    ret -1
  end
  ret vmch_caches_ok g
end

note ---- view ----
fn vmch_prov_c v ulong c uchar to void
  l = get vmch_vprovl v
  if lt l 383
    put vmch_vprov add mul v 384 l c
    put vmch_vprovl v add l 1
  end
end

fn vmch_prov_txt v ulong w view uchar * to void
  n = len w
  for k ulong n bound 512
    vmch_prov_c v get w k
  end
end

fn vmch_seal_const g ulong to bool
  sb = mul g 32
  s0 = get vmch_gseal sb
  for k ulong 31
    if ne get vmch_gseal add add sb 1 k s0
      ret false
    end
  end
  ret true
end

note visor_machine_view: graph g into view v (view graph slot 8+v).
fn vmch_view g ulong v ulong to long
  vg = add 8 v
  vmch_graph_copy vg g
  put vmch_vprovl v 0
  vmch_prov_txt v vmch_prov_view
  put vmch_vobs v 0
  put vmch_vph v 0
  if vmch_seal_const g
    put vmch_vph v 1
  end
  put vmch_vterrl v 0
  put vmch_vtopo v 0
  if eq vmch_validate g 0
    put vmch_vtopo v 1
  else
    el = get vmch_errl 0
    for k ulong el bound 96
      put vmch_vterr add mul v 96 k get vmch_err k
    end
    put vmch_vterrl v el
  end
  u = vmch_blackwell_id
  put vmch_vtcnt v 2
  ret u
end

note ---- host facts ----
fn vmch_fact_c f ulong c uchar cap ulong to void
  l = get vmch_factl f
  if lt add l 1 cap
    put vmch_fact add mul f 64 l c
    put vmch_factl f add l 1
  end
end

fn vmch_fact_txt f ulong w view uchar * cap ulong to void
  n = len w
  for k ulong n bound 128
    vmch_fact_c f get w k cap
  end
end

fn vmch_facts_clear to void
  for f ulong 3
    put vmch_factl f 0
  end
  for k ulong 192
    put vmch_fact k uchar 0
  end
end

fn vmch_slurp p view uchar * to long
  put vmch_fblen 0 0
  n = len p
  fd = fopen p 0 n 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 65535 bound 65536
    k = read int fd vmch_fbuf tot sub 65535 tot
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  u = fclose int fd
  put vmch_fblen 0 tot
  if lt u -999999
    ret -1
  end
  ret 0
end

note read_first_line: fgets(n) then strip trailing \n \r and spaces.
fn vmch_first_line f ulong cap ulong to void
  put vmch_factl f 0
  n = get vmch_fblen 0
  lim = sub cap 1
  l = ulong 0
  while lt l n bound 65536
    if ge l lim
      break
    end
    c = get vmch_fbuf l
    l = add l 1
    if eq c 10
      break
    end
  end
  while gt l 0 bound 65536
    c2 = get vmch_fbuf sub l 1
    if and ne c2 10 and ne c2 13 ne c2 32
      break
    end
    l = sub l 1
  end
  for k ulong l bound 64
    vmch_fact_c f get vmch_fbuf k cap
  end
end

fn vmch_part_eq a ulong b ulong to bool
  la = get vmch_partl a
  if ne la get vmch_partl b
    ret false
  end
  for k ulong la bound 12
    if ne get vmch_parts add mul a 12 k get vmch_parts add mul b 12 k
      ret false
    end
  end
  ret true
end

fn vmch_part_lt a ulong b ulong to bool
  la = get vmch_partl a
  lb = get vmch_partl b
  m = la
  if lt lb m
    m = lb
  end
  for k ulong m bound 12
    ca = get vmch_parts add mul a 12 k
    cb = get vmch_parts add mul b 12 k
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret lt la lb
end

fn vmch_part_swap a ulong b ulong to void
  for k ulong 12
    t = get vmch_parts add mul a 12 k
    put vmch_parts add mul a 12 k get vmch_parts add mul b 12 k
    put vmch_parts add mul b 12 k t
  end
  tl = get vmch_partl a
  put vmch_partl a get vmch_partl b
  put vmch_partl b tl
end

fn vmch_part_add to void
  cnt = get vmch_pcnt 0
  dup = false
  for i ulong cnt bound 16
    if vmch_part_eq i 16
      dup = true
    end
  end
  if dup
    ret
  end
  if ge cnt 16
    ret
  end
  db = mul cnt 12
  for k ulong 12
    put vmch_parts add db k get vmch_parts add 192 k
  end
  put vmch_partl cnt get vmch_partl 16
  put vmch_pcnt 0 add cnt 1
end

note One fgets chunk [s, e): a "CPU part" line adds its value (slot 16 holds the candidate).
fn vmch_cpu_chunk s ulong e ulong to void
  wl = len vmch_w_cpupart
  if lt sub e s wl
    ret
  end
  for k ulong wl
    if ne get vmch_fbuf add s k get vmch_w_cpupart k
      ret
    end
  end
  c = s
  found = false
  while lt c e bound 256
    if eq get vmch_fbuf c 58
      found = true
      break
    end
    c = add c 1
  end
  if not found
    ret
  end
  c = add c 1
  while lt c e bound 256
    ch = get vmch_fbuf c
    if and ne ch 32 ne ch 9
      break
    end
    c = add c 1
  end
  kk = ulong 0
  cb = ulong 192
  while lt c e bound 256
    ch2 = get vmch_fbuf c
    if or eq ch2 10 eq ch2 32
      break
    end
    if ge add kk 1 12
      break
    end
    put vmch_parts add cb kk ch2
    kk = add kk 1
    c = add c 1
  end
  put vmch_partl 16 kk
  vmch_part_add
end

fn vmch_cpu_parts to void
  put vmch_factl 2 0
  put vmch_pcnt 0 0
  if lt vmch_slurp vmch_p_cpu 0
    ret
  end
  n = get vmch_fblen 0
  s = ulong 0
  while lt s n bound 65536
    e = s
    while lt e n bound 256
      if ge sub e s 255
        break
      end
      ce = get vmch_fbuf e
      e = add e 1
      if eq ce 10
        break
      end
    end
    vmch_cpu_chunk s e
    s = e
  end
  cnt = get vmch_pcnt 0
  for i ulong cnt bound 16
    for j ulong cnt bound 16
      if gt j i
        if vmch_part_lt j i
          vmch_part_swap i j
        end
      end
    end
  end
  for i ulong cnt bound 16
    if gt i 0
      vmch_fact_c 2 uchar 44 64
    end
    pl = get vmch_partl i
    for k ulong pl bound 12
      vmch_fact_c 2 get vmch_parts add mul i 12 k 64
    end
  end
end

note visor_machine_host_facts.
fn vmch_host_facts to long
  vmch_facts_clear
  if eq vmch_slurp vmch_p_arch 0
    vmch_first_line 0 32
  end
  if eq vmch_slurp vmch_p_dmi 0
    vmch_first_line 1 64
  end
  vmch_cpu_parts
  ret 0
end

fn vmch_fact_at f ulong s ulong w view uchar * to bool
  n = len w
  b = add mul f 64 s
  for k ulong n bound 64
    if ne get vmch_fact add b k get w k
      ret false
    end
  end
  ret true
end

fn vmch_fact_has f ulong w view uchar * to bool
  l = get vmch_factl f
  n = len w
  if gt n l
    ret false
  end
  lim = add sub l n 1
  for s ulong lim bound 64
    if vmch_fact_at f s w
      ret true
    end
  end
  ret false
end

fn vmch_fact_eq f ulong w view uchar * to bool
  n = len w
  if ne get vmch_factl f n
    ret false
  end
  b = mul f 64
  for k ulong n bound 64
    if ne get vmch_fact add b k get w k
      ret false
    end
  end
  ret true
end

fn vmch_prov_fact v ulong f ulong maxn ulong to void
  l = get vmch_factl f
  if eq l 0
    vmch_prov_txt v vmch_q
    ret
  end
  if gt l maxn
    l = maxn
  end
  b = mul f 64
  for k ulong l bound 64
    vmch_prov_c v get vmch_fact add b k
  end
end

note visor_machine_from_facts: facts -> graph g and view v.
fn vmch_from_facts g ulong v ulong to long
  a64 = vmch_fact_eq 0 vmch_w_a64
  dmi = or vmch_fact_has 1 vmch_w_dgx1 vmch_fact_has 1 vmch_w_dgx2
  nv2 = vmch_fact_has 2 vmch_w_d4f
  spark = and a64 or dmi nv2
  rc = long 0
  if spark
    rc = vmch_build_spark g
  else
    rc = vmch_build_qemu g
  end
  if ne rc 0
    ret -1
  end
  if ne vmch_view g v 0
    ret -1
  end
  put vmch_vprovl v 0
  vmch_prov_txt v vmch_pv1
  if spark
    vmch_prov_txt v vmch_pv_sp
  else
    vmch_prov_txt v vmch_pv_qv
  end
  vmch_prov_txt v vmch_pv2
  vmch_prov_fact v 0 31
  vmch_prov_txt v vmch_pv3
  vmch_prov_fact v 1 63
  vmch_prov_txt v vmch_pv4
  vmch_prov_fact v 2 63
  vmch_prov_txt v vmch_pv5
  if not spark
    vmch_prov_txt v vmch_fit_fb
  else
    if nv2
      vmch_prov_txt v vmch_fit_nv2
    else
      vmch_prov_txt v vmch_fit_mis
    end
  end
  vmch_prov_txt v vmch_pv6
  put vmch_vobs v 0
  ret 0
end

fn vmch_current g ulong v ulong to long
  if ne vmch_host_facts 0
    ret -1
  end
  ret vmch_from_facts g v
end

note Session machine: graph 0, view 0; sets vmch_id, vmch_profile, vmch_is_spark.
fn vmch_detect_current to void
  u = vmch_current 0 0
  for k ulong 32
    put vmch_id k get vmch_gid k
  end
  put vmch_profile 0 vmch_gget 0 VMCH_K_PROF
  sp = ulong 0
  if eq vmch_gget 0 VMCH_K_ISSUE 4
    sp = 1
  end
  put vmch_is_spark 0 sp
  if lt u -999
    ret
  end
end

note ---- rendering ----
fn vmch_unit_name t ulong to void
  if eq t 0
    ob_puts vmch_u_alu
    ret
  end
  if eq t 1
    ob_puts vmch_u_br
    ret
  end
  if eq t 2
    ob_puts vmch_u_mul
    ret
  end
  if eq t 3
    ob_puts vmch_u_div
    ret
  end
  if eq t 4
    ob_puts vmch_u_ls
    ret
  end
  if eq t 5
    ob_puts vmch_u_vec
    ret
  end
  if eq t 6
    ob_puts vmch_u_acc
    ret
  end
  ob_puts vmch_u_unk
end

fn vmch_unit_name_len t ulong to ulong
  if eq t 0
    ret len vmch_u_alu
  end
  if eq t 1
    ret len vmch_u_br
  end
  if eq t 2
    ret len vmch_u_mul
  end
  if eq t 3
    ret len vmch_u_div
  end
  if eq t 4
    ret len vmch_u_ls
  end
  if eq t 5
    ret len vmch_u_vec
  end
  if eq t 6
    ret len vmch_u_acc
  end
  ret len vmch_u_unk
end

fn vmch_pad have ulong width ulong to void
  if ge have width
    ret
  end
  for k ulong sub width have bound 64
    ob_putc uchar 32
  end
end

fn vmch_put_hex64 v ulong to void
  started = false
  for i ulong 16
    nib = and shr v mul sub 15 i 4 15
    if or ne nib 0 or started eq i 15
      started = true
      ob_putc get vt_hex nib
    end
  end
end

fn vmch_put_id g ulong to void
  ob_puts vt_sha256_pfx
  sb = mul g 32
  for k ulong 32
    ob_put_hex_byte ulong get vmch_gid add sb k
  end
end

fn vmch_put_bwid to void
  ob_puts vt_sha256_pfx
  for k ulong 32
    ob_put_hex_byte ulong get vmch_bw_id k
  end
end

fn vmch_put_name g ulong to void
  nl = vmch_gget g VMCH_K_NLEN
  nb = mul g 64
  for k ulong nl bound 64
    ob_putc get vmch_gname add nb k
  end
end

fn vmch_yesno b ulong to void
  if ne b 0
    ob_puts vmch_x_yes
  else
    ob_puts vmch_x_no
  end
end

fn vmch_text_units g ulong to void
  uc = vmch_gget g VMCH_K_UCNT
  if gt uc VMCH_MAXU
    uc = VMCH_MAXU
  end
  for u ulong uc bound 8
    b = add VMCH_K_UNIT mul u 4
    t = vmch_gget g b
    ob_puts vmch_x_unit
    vmch_unit_name t
    vmch_pad vmch_unit_name_len t 16
    ob_putc uchar 32
    ob_puts vmch_x_count
    ob_put_u64 vmch_gget g add b 1
    ob_puts vmch_x_lat
    ob_put_u64 vmch_gget g add b 2
    ob_puts vmch_x_thr
    ob_put_u64 vmch_gget g add b 3
    ob_putc uchar 10
  end
end

fn vmch_text_caches g ulong to void
  cc = vmch_gget g VMCH_K_CCNT
  if gt cc VMCH_MAXC
    cc = VMCH_MAXC
  end
  for c ulong cc bound 8
    b = add VMCH_K_CACHE mul c 6
    lvl = vmch_gget g b
    ob_puts vmch_x_cache
    ob_put_u64 lvl
    if ne vmch_gget g add b 1 0
      ob_putc uchar 73
    else
      if eq lvl 1
        ob_putc uchar 68
      else
        ob_putc uchar 32
      end
    end
    ob_puts vmch_x_size
    ob_put_u64 vmch_gget g add b 2
    ob_puts vmch_x_line
    ob_put_u64 vmch_gget g add b 3
    ob_puts vmch_x_assoc
    ob_put_u64 vmch_gget g add b 4
    ob_puts vmch_x_lat
    ob_put_u64 vmch_gget g add b 5
    ob_putc uchar 10
  end
end

fn vmch_text_head v ulong to void
  g = add 8 v
  ob_puts vmch_x_machine
  vmch_put_name g
  ob_putc uchar 10
  ob_puts vmch_x_id
  vmch_put_id g
  ob_putc uchar 10
  ob_puts vmch_x_prof
  ob_put_hex_byte and vmch_gget g VMCH_K_PROF 255
  ob_putc uchar 10
  ob_puts vmch_x_obs
  if ne get vmch_vobs v 0
    ob_puts vmch_x_yes
  else
    ob_puts vmch_x_obs_no
  end
  ob_putc uchar 10
  ob_puts vmch_x_prov
  pl = get vmch_vprovl v
  for k ulong pl bound 384
    ob_putc get vmch_vprov add mul v 384 k
  end
  ob_putc uchar 10
  ob_puts vmch_x_pipe
  ob_put_u64 vmch_gget g VMCH_K_ISSUE
  ob_puts vmch_x_inf
  ob_put_u64 vmch_gget g VMCH_K_MIF
  ob_putc uchar 32
  if ne vmch_gget g VMCH_K_OOO 0
    ob_puts vmch_x_ooo
  else
    ob_puts vmch_x_ino
  end
  ob_putc uchar 10
end

fn vmch_text_mid v ulong to void
  g = add 8 v
  ob_puts vmch_x_regs
  ob_put_u64 vmch_gget g VMCH_K_GPRC
  ob_putc uchar 120
  ob_put_u64 vmch_gget g VMCH_K_GPRW
  ob_puts vmch_x_vec
  ob_put_u64 vmch_gget g VMCH_K_VECC
  ob_putc uchar 120
  ob_put_u64 vmch_gget g VMCH_K_VECW
  ob_putc uchar 10
  vmch_text_caches g
  ob_puts vmch_x_dram
  vmch_put_hex64 vmch_gget g VMCH_K_DBASE
  ob_puts vmch_x_size
  ob_put_u64 vmch_gget g VMCH_K_DSIZE
  ob_putc uchar 10
  ob_puts vmch_x_phys
  if ne vmch_gget g VMCH_K_PHYS 0
    ob_puts vmch_x_set
  else
    ob_puts vmch_x_unset
  end
  ob_puts vmch_x_seal
  if ne get vmch_vph v 0
    ob_puts vmch_x_ph
  else
    ob_puts vmch_x_nc
  end
  ob_putc uchar 10
  ob_puts vmch_x_topo
  if ne get vmch_vtopo v 0
    ob_puts vmch_x_valid
  else
    ob_puts vmch_x_invalid
    el = get vmch_vterrl v
    for k ulong el bound 96
      ob_putc get vmch_vterr add mul v 96 k
    end
  end
  ob_putc uchar 10
end

fn vmch_text_targets v ulong to void
  g = add 8 v
  ob_puts vmch_x_target
  ob_puts vmch_t_a64
  vmch_pad len vmch_t_a64 22
  ob_putc uchar 32
  ob_puts vmch_x_linked
  vmch_yesno 1
  ob_puts vmch_x_run
  vmch_yesno 1
  ob_puts vmch_x_tid
  vmch_put_id g
  ob_puts vmch_x_note
  ob_puts vmch_note_a64
  ob_putc uchar 10
  ob_puts vmch_x_target
  ob_puts vmch_t_bw
  vmch_pad len vmch_t_bw 22
  ob_putc uchar 32
  ob_puts vmch_x_linked
  vmch_yesno 1
  ob_puts vmch_x_run
  vmch_yesno 0
  ob_puts vmch_x_tid
  vmch_put_bwid
  ob_puts vmch_x_note
  ob_puts vmch_note_bw
  ob_putc uchar 10
end

note visor_machine_format_text for view v into v_ob; n is the C buffer size.
fn vmch_vtext v ulong n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  vmch_text_head v
  vmch_text_units add 8 v
  vmch_text_mid v
  vmch_text_targets v
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vmch_jbyte c uchar to void
  if or eq c 34 eq c 92
    ob_putc uchar 92
    ob_putc c
    ret
  end
  if lt c 32
    ob_putc uchar 92
    ob_putc uchar 117
    ob_putc uchar 48
    ob_putc uchar 48
    ob_putc get vt_hex ulong shr c 4
    ob_putc get vt_hex ulong and c 15
    ret
  end
  ob_putc c
end

fn vmch_jtxt w view uchar * to void
  ob_putc uchar 34
  n = len w
  for k ulong n bound 512
    vmch_jbyte get w k
  end
  ob_putc uchar 34
end

fn vmch_jbool b ulong to void
  if ne b 0
    ob_puts vmch_j_true
  else
    ob_puts vmch_j_false
  end
end

fn vmch_json_head v ulong to void
  g = add 8 v
  ob_puts vmch_j_name
  ob_putc uchar 34
  nl = vmch_gget g VMCH_K_NLEN
  for k ulong nl bound 64
    vmch_jbyte get vmch_gname add mul g 64 k
  end
  ob_putc uchar 34
  ob_puts vmch_j_id
  ob_putc uchar 34
  vmch_put_id g
  ob_putc uchar 34
  ob_puts vmch_j_tp
  ob_put_u64 and vmch_gget g VMCH_K_PROF 255
  ob_puts vmch_j_obs
  vmch_jbool get vmch_vobs v
  ob_puts vmch_j_prov
  ob_putc uchar 34
  pl = get vmch_vprovl v
  for k ulong pl bound 384
    vmch_jbyte get vmch_vprov add mul v 384 k
  end
  ob_putc uchar 34
  ob_puts vmch_j_pipe
  ob_put_u64 vmch_gget g VMCH_K_ISSUE
  ob_puts vmch_j_mif
  ob_put_u64 vmch_gget g VMCH_K_MIF
  ob_puts vmch_j_ooo
  vmch_jbool vmch_gget g VMCH_K_OOO
  ob_puts vmch_j_units
end

fn vmch_json_units g ulong to void
  uc = vmch_gget g VMCH_K_UCNT
  if gt uc VMCH_MAXU
    uc = VMCH_MAXU
  end
  for u ulong uc bound 8
    if gt u 0
      ob_putc uchar 44
    end
    b = add VMCH_K_UNIT mul u 4
    ob_puts vmch_j_ut
    vmch_unit_name vmch_gget g b
    ob_puts vmch_j_uc
    ob_put_u64 vmch_gget g add b 1
    ob_puts vmch_j_ul
    ob_put_u64 vmch_gget g add b 2
    ob_puts vmch_j_uth
    ob_put_u64 vmch_gget g add b 3
    ob_putc uchar 125
  end
end

fn vmch_json_caches g ulong to void
  cc = vmch_gget g VMCH_K_CCNT
  if gt cc VMCH_MAXC
    cc = VMCH_MAXC
  end
  for c ulong cc bound 8
    if gt c 0
      ob_putc uchar 44
    end
    b = add VMCH_K_CACHE mul c 6
    ob_puts vmch_j_cl
    ob_put_u64 vmch_gget g b
    ob_puts vmch_j_ci
    vmch_jbool vmch_gget g add b 1
    ob_puts vmch_j_cs
    ob_put_u64 vmch_gget g add b 2
    ob_puts vmch_j_cline
    ob_put_u64 vmch_gget g add b 3
    ob_puts vmch_j_ca
    ob_put_u64 vmch_gget g add b 4
    ob_puts vmch_j_ul
    ob_put_u64 vmch_gget g add b 5
    ob_putc uchar 125
  end
end

fn vmch_json_mid v ulong to void
  g = add 8 v
  ob_puts vmch_j_regs
  ob_put_u64 vmch_gget g VMCH_K_GPRC
  ob_puts vmch_j_gw
  ob_put_u64 vmch_gget g VMCH_K_GPRW
  ob_puts vmch_j_vc
  ob_put_u64 vmch_gget g VMCH_K_VECC
  ob_puts vmch_j_vw
  ob_put_u64 vmch_gget g VMCH_K_VECW
  ob_puts vmch_j_caches
  vmch_json_caches g
  ob_puts vmch_j_db
  ob_put_u64 vmch_gget g VMCH_K_DBASE
  ob_puts vmch_j_ds
  ob_put_u64 vmch_gget g VMCH_K_DSIZE
  ob_puts vmch_j_pa
  vmch_jbool vmch_gget g VMCH_K_PHYS
  ob_puts vmch_j_pp
  vmch_jbool get vmch_vph v
  ob_puts vmch_j_tv
  vmch_jbool get vmch_vtopo v
  ob_puts vmch_j_te
  ob_putc uchar 34
  el = get vmch_vterrl v
  for k ulong el bound 96
    vmch_jbyte get vmch_vterr add mul v 96 k
  end
  ob_putc uchar 34
end

fn vmch_json_targets v ulong to void
  g = add 8 v
  ob_puts vmch_j_tg
  ob_puts vmch_j_name
  vmch_jtxt vmch_t_a64
  ob_puts vmch_j_tmid
  ob_putc uchar 34
  vmch_put_id g
  ob_putc uchar 34
  ob_puts vmch_j_tl
  vmch_jbool 1
  ob_puts vmch_j_tr
  vmch_jbool 1
  ob_puts vmch_j_tn
  vmch_jtxt vmch_note_a64
  ob_putc uchar 125
  ob_putc uchar 44
  ob_puts vmch_j_name
  vmch_jtxt vmch_t_bw
  ob_puts vmch_j_tmid
  ob_putc uchar 34
  vmch_put_bwid
  ob_putc uchar 34
  ob_puts vmch_j_tl
  vmch_jbool 1
  ob_puts vmch_j_tr
  vmch_jbool 0
  ob_puts vmch_j_tn
  vmch_jtxt vmch_note_bw
  ob_putc uchar 125
  ob_puts vmch_j_end
end

note visor_machine_format_json for view v into v_ob; n is the C buffer size.
fn vmch_vjson v ulong n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  vmch_json_head v
  vmch_json_units add 8 v
  vmch_json_mid v
  vmch_json_targets v
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

note Session machine view (view 0) renderings, as tools/omega.c om_machine.
fn vmch_format_text n ulong to long
  ret vmch_vtext 0 n
end

fn vmch_format_json n ulong to long
  ret vmch_vjson 0 n
end

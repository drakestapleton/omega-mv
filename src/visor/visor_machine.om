note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor lane 5: machine view (replaces src/visor/visor_machine.c).
note Depends on visor.om.

text vmch_n_spark "dgx-spark"
text vmch_n_qemu "qemu-virt"
text vmch_t_a64 "aarch64-v8a"
text vmch_t_bw "blackwell-gb10-sm121"
text vmch_bw_seed "omega.machine.blackwell.gb10.sm121.v1"
text vmch_spark_seed "omega.machine.dgx-spark.v1"
text vmch_qemu_seed "omega.machine.qemu-virt.v1"
text vmch_prov_pfx "assumed: canonical profile (no physics descriptor ingested)"
text vmch_prov_mis "assumed: canonical dgx-spark profile (no physics descriptor ingested; host cores do NOT match Neoverse-V2)"
text vmch_p_dmi "/sys/class/dmi/id/product_name"
text vmch_p_cpu "/proc/cpuinfo"
text vmch_k_dgx "DGX"
text vmch_k_d4f "0xd4f"
text vmch_f1 "machine: "
text vmch_f2 "  id: sha256:"
text vmch_f3 "  observed: false\n  provenance: "
text vmch_f4 "  pipeline: issue_width="
text vmch_f5 " units="
text vmch_f6 " caches="
text vmch_f7 "  target aarch64-v8a linked=yes runnable=yes\n  target blackwell-gb10-sm121 linked=yes runnable=no (requires GPU submit authority)\n"
text vmch_j1 "{\"name\":\""
text vmch_j2 "\",\"id\":\"sha256:"
text vmch_j3 "\",\"observed\":false,\"provenance\":\""
text vmch_j4 "\",\"pipeline\":{\"issue_width\":"
text vmch_j5 "},\"registers\":{\"gpr_count\":"
text vmch_j6 "},\"caches\":"
text vmch_j7 ",\"physics_seal_is_placeholder\":true,\"targets\":[{\"name\":\"aarch64-v8a\",\"linked\":true,\"runnable\":true},{\"name\":\"blackwell-gb10-sm121\",\"linked\":true,\"runnable\":false,\"note\":\"requires GPU submit authority\"}]}"

global vmch_is_spark ulong 1
global vmch_profile ulong 1
global vmch_issue ulong 1
global vmch_units ulong 1
global vmch_caches ulong 1
global vmch_gprs ulong 1
global vmch_topo_ok ulong 1
global vmch_observed ulong 1
global vmch_placeholder ulong 1
global vmch_id uchar 32
global vmch_bw_id uchar 32
global vmch_mismatch ulong 1
global vmch_fbuf uchar 4096

fn vmch_hash_seed s view uchar * to void
  n = len s
  for i ulong n bound 128
    put v_sha_in i get s i
  end
  sha256_hash n
end

fn vmch_init_bw_id to void
  vmch_hash_seed vmch_bw_seed
  for i ulong 32
    put vmch_bw_id i get v_sha_out i
  end
end

fn vmch_build_spark to void
  put vmch_is_spark 0 1
  put vmch_profile 0 1
  put vmch_issue 0 4
  put vmch_units 0 6
  put vmch_caches 0 4
  put vmch_gprs 0 31
  put vmch_topo_ok 0 1
  put vmch_observed 0 0
  put vmch_placeholder 0 1
  vmch_hash_seed vmch_spark_seed
  for i ulong 32
    put vmch_id i get v_sha_out i
  end
  vmch_init_bw_id
end

fn vmch_build_qemu to void
  put vmch_is_spark 0 0
  put vmch_profile 0 1
  put vmch_issue 0 2
  put vmch_units 0 5
  put vmch_caches 0 3
  put vmch_gprs 0 31
  put vmch_topo_ok 0 1
  put vmch_observed 0 0
  put vmch_placeholder 0 1
  vmch_hash_seed vmch_qemu_seed
  for i ulong 32
    put vmch_id i get v_sha_out i
  end
  vmch_init_bw_id
end

fn vmch_validate_topo to long
  g = get vmch_gprs 0
  if lt g 16
    put vmch_topo_ok 0 0
    ret -1
  end
  put vmch_topo_ok 0 1
  ret 0
end

fn vmch_buf_has buf_len ulong needle view uchar * to bool
  nl = len needle
  if or eq nl 0 gt nl buf_len
    ret false
  end
  lim = add sub buf_len nl 1
  for i ulong lim bound 4096
    ok = true
    for j ulong nl bound 64
      if ne get vmch_fbuf add i j get needle j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn vmch_detect_current to void
  put vmch_mismatch 0 0
  is_sp = false
  fd = fopen vmch_p_dmi 0 len vmch_p_dmi 0 0
  if ge fd 0
    k = read int fd vmch_fbuf 0 256
    u = fclose int fd
    if gt k 0
      if vmch_buf_has ulong k vmch_k_dgx
        is_sp = true
      end
    end
  end
  fd2 = fopen vmch_p_cpu 0 len vmch_p_cpu 0 0
  if ge fd2 0
    k2 = read int fd2 vmch_fbuf 0 4095
    u2 = fclose int fd2
    if gt k2 0
      if vmch_buf_has ulong k2 vmch_k_d4f
        is_sp = true
      else
        if is_sp
          put vmch_mismatch 0 1
        end
      end
    end
  end
  if is_sp
    vmch_build_spark
  else
    vmch_build_qemu
  end
end

fn vmch_format_text cap ulong to long
  ob_reset cap
  ob_puts vmch_f1
  if ne get vmch_is_spark 0 0
    ob_puts vmch_n_spark
  else
    ob_puts vmch_n_qemu
  end
  ob_putc uchar 10
  ob_puts vmch_f2
  for i ulong 32
    ob_put_hex_byte ulong get vmch_id i
  end
  ob_putc uchar 10
  ob_puts vmch_f3
  if ne get vmch_mismatch 0 0
    ob_puts vmch_prov_mis
  else
    ob_puts vmch_prov_pfx
  end
  ob_putc uchar 10
  ob_puts vmch_f4
  ob_put_u64 get vmch_issue 0
  ob_puts vmch_f5
  ob_put_u64 get vmch_units 0
  ob_puts vmch_f6
  ob_put_u64 get vmch_caches 0
  ob_putc uchar 10
  ob_puts vmch_f7
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vmch_format_json cap ulong to long
  ob_reset cap
  ob_puts vmch_j1
  if ne get vmch_is_spark 0 0
    ob_puts vmch_n_spark
  else
    ob_puts vmch_n_qemu
  end
  ob_puts vmch_j2
  for i ulong 32
    ob_put_hex_byte ulong get vmch_id i
  end
  ob_puts vmch_j3
  if ne get vmch_mismatch 0 0
    ob_puts vmch_prov_mis
  else
    ob_puts vmch_prov_pfx
  end
  ob_puts vmch_j4
  ob_put_u64 get vmch_issue 0
  ob_puts vmch_j5
  ob_put_u64 get vmch_gprs 0
  ob_puts vmch_j6
  ob_put_u64 get vmch_caches 0
  ob_puts vmch_j7
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

text vmch_j_db "],\"dram_base\":"
text vmch_j_ds ",\"dram_size\":"
text vmch_j_pa ",\"physics_authorized\":"
text vmch_j_pp ",\"physics_seal_is_placeholder\":"
text vmch_j_tv ",\"topology_valid\":"

note ---- names ----
fn vsem_put_opcode op ulong to void
  if eq op 0
    ob_puts vsem_op0
    ret
  end
  if eq op 1
    ob_puts vsem_op1
    ret
  end
  if eq op 2
    ob_puts vsem_op2
    ret
  end
  if eq op 3
    ob_puts vsem_op3
    ret
  end
  if eq op 4
    ob_puts vsem_op4
    ret
  end
  if eq op 5
    ob_puts vsem_op5
    ret
  end
  if eq op 6
    ob_puts vsem_op6
    ret
  end
  if eq op 7
    ob_puts vsem_op7
    ret
  end
  if eq op 8
    ob_puts vsem_op8
    ret
  end
  if eq op 9
    ob_puts vsem_op9
    ret
  end
  if eq op 10
    ob_puts vsem_op10
    ret
  end
  if eq op 11
    ob_puts vsem_op11
    ret
  end
  if eq op 12
    ob_puts vsem_op12
    ret
  end
  if eq op 13
    ob_puts vsem_op13
    ret
  end
  if eq op 14
    ob_puts vsem_op14
    ret
  end
  if eq op 15
    ob_puts vsem_op15
    ret
  end
  ob_puts vsem_op_unk
end

fn vsem_put_overflow ov ulong to void
  if eq ov 0
    ob_puts vsem_ov0
    ret
  end
  if eq ov 1
    ob_puts vsem_ov1
    ret
  end
  if eq ov 2
    ob_puts vsem_ov2
    ret
  end
  if eq ov 3
    ob_puts vsem_ov3
    ret
  end
  ob_puts vsem_op_unk
end

fn vsem_put_relation k ulong to void
  if eq k 0
    ob_puts vsem_op0
    ret
  end
  if eq k 1
    ob_puts vsem_rl1
    ret
  end
  if eq k 2
    ob_puts vsem_rl2
    ret
  end
  if eq k 3
    ob_puts vsem_rl3
    ret
  end
  if eq k 4
    ob_puts vsem_rl4
    ret
  end
  if eq k 5
    ob_puts vsem_rl5
    ret
  end
  if eq k 6
    ob_puts vsem_rl6
    ret
  end
  if eq k 7
    ob_puts vsem_rl7
    ret
  end
  if eq k 8
    ob_puts vsem_rl8
    ret
  end
  if eq k 9
    ob_puts vsem_rl9
    ret
  end
  ob_puts vsem_op_unk
end

fn vsem_put_constraint k ulong to void
  if eq k 0
    ob_puts vsem_op0
    ret
  end
  if eq k 1
    ob_puts vsem_c1
    ret
  end
  if eq k 2
    ob_puts vsem_c2
    ret
  end
  if eq k 3
    ob_puts vsem_c3
    ret
  end
  if eq k 4
    ob_puts vsem_c4
    ret
  end
  if eq k 5
    ob_puts vsem_c5
    ret
  end
  if eq k 6
    ob_puts vsem_c6
    ret
  end
  if eq k 7
    ob_puts vsem_c7
    ret
  end
  if eq k 8
    ob_puts vsem_c8
    ret
  end
  if eq k 9
    ob_puts vsem_c9
    ret
  end
  ob_puts vsem_op_unk
end

fn vsem_put_shape s ulong to void
  if eq s VSEM_SHAPE_TYPE
    ob_puts vsem_s_type
    ret
  end
  if eq s VSEM_SHAPE_VALUE
    ob_puts vsem_s_value
    ret
  end
  if eq s VSEM_SHAPE_OP
    ob_puts vsem_s_op
    ret
  end
  if eq s VSEM_SHAPE_APPLY
    ob_puts vsem_s_apply
    ret
  end
  if eq s VSEM_SHAPE_OPAQUE
    ob_puts vsem_s_opaque
    ret
  end
  ob_puts vsem_s_none
end

note ---- payload readers (object idx) ----
fn vsem_pb idx ulong to ulong
  ret mul idx V_MAX_PAYLOAD
end

fn vsem_pay_u32 idx ulong off ulong to ulong
  ret v_dec_u32le_pay vsem_pb idx off
end

fn vsem_pay_u16 idx ulong off ulong to ulong
  ret v_dec_u16le_pay vsem_pb idx off
end

fn vsem_pay_u8 idx ulong off ulong to ulong
  ret ulong get v_og_pay add vsem_pb idx off
end

fn vsem_pay_to_tmp idx ulong off ulong to void
  b = add vsem_pb idx off
  for i ulong 32
    put v_tmp_id i get v_og_pay add b i
  end
end

fn vsem_tmp_zero to bool
  for i ulong 32
    if ne get v_tmp_id i 0
      ret false
    end
  end
  ret true
end

note ---- reason text ----
fn vsem_rs_clear to void
  put vsem_rsl 0 0
end

fn vsem_rs_push c uchar to void
  l = get vsem_rsl 0
  if lt l 127
    put vsem_rs l c
    put vsem_rsl 0 add l 1
  end
end

fn vsem_rs_txt w view uchar * to void
  n = len w
  for i ulong n bound 256
    vsem_rs_push get w i
  end
end

fn vsem_rs_u64 v ulong to void
  if eq v 0
    vsem_rs_push uchar 48
    ret
  end
  d = ulong 1
  while le d div v 10 bound 24
    d = mul d 10
  end
  x = v
  while gt d 0 bound 24
    vsem_rs_push uchar add 48 div x d
    x = rem x d
    d = div d 10
  end
end

fn vsem_rs_hex2 v ulong to void
  nd = ulong 2
  t = shr v 8
  while gt t 0 bound 16
    nd = add nd 1
    t = shr t 4
  end
  for i ulong nd bound 16
    sh = mul sub sub nd 1 i 4
    vsem_rs_push get vt_hex and shr v sh 15
  end
end

fn vsem_rs_count w view uchar * v ulong mx ulong to long
  vsem_rs_clear
  vsem_rs_txt w
  vsem_rs_u64 v
  vsem_rs_txt vsem_r_exceeds
  vsem_rs_u64 mx
  ret -2
end

note ---- bounded structural parse: shape (1..5) or -2 with a reason ----
fn vsem_parse_kind_payload idx ulong kind ulong to long
  pl = get v_og_plen idx
  if eq kind V_KIND_TYPE
    if lt pl 44
      vsem_rs_clear
      vsem_rs_txt vsem_r_tplen
      vsem_rs_u64 pl
      vsem_rs_txt vsem_r_lt
      vsem_rs_u64 44
      ret -2
    end
    tag = vsem_pay_u32 idx 0
    if or eq tag 0 gt tag V_TY_FP32
      vsem_rs_clear
      vsem_rs_txt vsem_r_tag
      vsem_rs_hex2 tag
      ret -2
    end
    ret long VSEM_SHAPE_TYPE
  end
  if eq kind V_KIND_VALUE
    if lt pl 98
      vsem_rs_clear
      vsem_rs_txt vsem_r_vplen
      vsem_rs_u64 pl
      vsem_rs_txt vsem_r_lt
      vsem_rs_u64 98
      ret -2
    end
    bl = vsem_pay_u16 idx 32
    if gt bl 64
      vsem_rs_clear
      vsem_rs_txt vsem_r_vbl
      vsem_rs_u64 bl
      vsem_rs_txt vsem_r_gt
      vsem_rs_u64 64
      ret -2
    end
    ret long VSEM_SHAPE_VALUE
  end
  if eq kind V_KIND_OP
    ret vsem_parse_op idx pl
  end
  ret long VSEM_SHAPE_OPAQUE
end

fn vsem_parse_op idx ulong pl ulong to long
  if ge pl 204
    opc = vsem_pay_u32 idx 0
    if or eq opc 0 gt opc V_OP_CONVERT
      vsem_rs_clear
      vsem_rs_txt vsem_r_opc
      vsem_rs_hex2 opc
      ret -2
    end
    ovf = vsem_pay_u32 idx 4
    if or eq ovf 0 gt ovf V_OVF_FAIL_CLOSED
      vsem_rs_clear
      vsem_rs_txt vsem_r_ovf
      vsem_rs_hex2 ovf
      ret -2
    end
    ar = vsem_pay_u8 idx 40
    if gt ar 4
      vsem_rs_clear
      vsem_rs_txt vsem_r_arity
      vsem_rs_u64 ar
      vsem_rs_txt vsem_r_gt4
      ret -2
    end
    ret long VSEM_SHAPE_OP
  end
  if ge pl 161
    oc = vsem_pay_u8 idx 32
    if gt oc 4
      vsem_rs_clear
      vsem_rs_txt vsem_r_apcnt
      vsem_rs_u64 oc
      vsem_rs_txt vsem_r_gt4
      ret -2
    end
    ret long VSEM_SHAPE_APPLY
  end
  vsem_rs_clear
  vsem_rs_txt vsem_r_oplen
  vsem_rs_u64 pl
  vsem_rs_txt vsem_r_oplen2
  ret -2
end

fn vsem_parse_counts idx ulong to long
  ac = get v_og_acnt idx
  if gt ac V_MAX_ATTRS
    ret vsem_rs_count vsem_r_acnt ac V_MAX_ATTRS
  end
  rc = get v_og_rcnt idx
  if gt rc V_MAX_RELS
    ret vsem_rs_count vsem_r_rcnt rc V_MAX_RELS
  end
  cc = get v_og_ccnt idx
  if gt cc V_MAX_CONSTS
    ret vsem_rs_count vsem_r_ccnt cc V_MAX_CONSTS
  end
  pl = get v_og_plen idx
  if gt pl V_MAX_PAYLOAD
    ret vsem_rs_count vsem_r_plen pl V_MAX_PAYLOAD
  end
  for i ulong ac bound 32
    vl = get v_og_avlen og_aslot idx i
    if gt vl 512
      vsem_rs_clear
      vsem_rs_txt vsem_r_attr
      vsem_rs_u64 i
      vsem_rs_txt vsem_r_vallen
      vsem_rs_u64 vl
      vsem_rs_txt vsem_r_toolong
      ret -2
    end
  end
  for i ulong cc bound 32
    cl = get v_og_clen og_cslot idx i
    if gt cl 128
      vsem_rs_clear
      vsem_rs_txt vsem_r_const
      vsem_rs_u64 i
      vsem_rs_txt vsem_r_cplen
      vsem_rs_u64 cl
      vsem_rs_txt vsem_r_toolong
      ret -2
    end
  end
  ret 0
end

note parse_object: shape or -2; canonical length in vsem_clen, hash in v_sha_out.
fn vsem_parse idx ulong to long
  kind = get v_og_kind idx
  if or lt kind V_KIND_VALUE gt kind V_KIND_PROOF
    vsem_rs_clear
    vsem_rs_txt vsem_r_kind
    vsem_rs_hex2 kind
    ret -2
  end
  if lt vsem_parse_counts idx 0
    ret -2
  end
  sh = vsem_parse_kind_payload idx kind
  if lt sh 0
    ret -2
  end
  el = og_hash_encoding idx
  if lt el 0
    vsem_rs_clear
    vsem_rs_txt vsem_r_canon
    ret -2
  end
  put vsem_clen 0 ulong el
  ret sh
end

note load: the object whose id is in v_tmp_id. -1 missing, -2 malformed, else shape;
note the object index in vsem_lidx.
fn vsem_load_tmp to long
  oi = og_find_by_tmp
  if lt oi 0
    ret -1
  end
  idx = ulong oi
  put vsem_lidx 0 idx
  sh = vsem_parse idx
  if lt sh 0
    ret sh
  end
  if not og_id_eq_sha idx
    vsem_rs_clear
    vsem_rs_txt vsem_r_stored
    ret -2
  end
  ret sh
end

note ---- type text regions (64 x 128 bytes) ----
fn vsem_tr_clear r ulong to void
  put vsem_trl r 0
end

fn vsem_tr_push r ulong c uchar cap ulong to void
  l = get vsem_trl r
  if lt add l 1 cap
    put vsem_tr add mul r 128 l c
    put vsem_trl r add l 1
  end
end

fn vsem_tr_txt r ulong w view uchar * cap ulong to void
  n = len w
  for i ulong n bound 128
    vsem_tr_push r get w i cap
  end
end

fn vsem_tr_u64 r ulong v ulong cap ulong to void
  if eq v 0
    vsem_tr_push r uchar 48 cap
    ret
  end
  d = ulong 1
  while le d div v 10 bound 24
    d = mul d 10
  end
  x = v
  while gt d 0 bound 24
    vsem_tr_push r uchar add 48 div x d cap
    x = rem x d
    d = div d 10
  end
end

fn vsem_tr_copy dst ulong src ulong maxn ulong cap ulong to void
  l = get vsem_trl src
  if gt l maxn
    l = maxn
  end
  b = mul src 128
  for i ulong l bound 128
    vsem_tr_push dst get vsem_tr add b i cap
  end
end

fn vsem_tr_set r ulong w view uchar * cap ulong to void
  vsem_tr_clear r
  vsem_tr_txt r w cap
end

fn vsem_put_tr r ulong to void
  l = get vsem_trl r
  b = mul r 128
  for i ulong l bound 128
    ob_putc get vsem_tr add b i
  end
end

note type_text_of for the type id in v_tmp_id into region r (snprintf cap); 0 or -1.
fn vsem_type_text r ulong cap ulong depth ulong to long
  if gt depth 8
    vsem_tr_set r vsem_n_q cap
    ret -1
  end
  sh = vsem_load_tmp
  if ne sh long VSEM_SHAPE_TYPE
    vsem_tr_set r vsem_n_q cap
    ret -1
  end
  idx = get vsem_lidx 0
  tag = vsem_pay_u32 idx 0
  w = vsem_pay_u16 idx 4
  vsem_tr_clear r
  if eq tag V_TY_SEQ
    vsem_pay_to_tmp idx 12
    u = vsem_type_text add r 1 96 add depth 1
    vsem_tr_txt r vsem_tt_seq cap
    vsem_tr_copy r add r 1 64 cap
    vsem_tr_push r uchar 44 cap
    vsem_tr_u64 r vsem_pay_u32 idx 8 cap
    vsem_tr_push r uchar 62 cap
    if lt u -9
      ret -1
    end
    ret 0
  end
  ret vsem_type_text_flat r cap tag w
end

fn vsem_type_text_flat r ulong cap ulong tag ulong w ulong to long
  if eq tag V_TY_UNIT
    vsem_tr_txt r vsem_tt_unit cap
    ret 0
  end
  if eq tag V_TY_BOOL
    vsem_tr_txt r vsem_t_bool cap
    ret 0
  end
  if eq tag V_TY_UINT
    vsem_tr_txt r vsem_t_u cap
    vsem_tr_u64 r w cap
    ret 0
  end
  if eq tag V_TY_SINT
    vsem_tr_txt r vsem_tt_i cap
    vsem_tr_u64 r w cap
    ret 0
  end
  if eq tag V_TY_BITVEC
    vsem_tr_txt r vsem_tt_bv cap
    vsem_tr_u64 r w cap
    vsem_tr_push r uchar 62 cap
    ret 0
  end
  if eq tag V_TY_BYTE
    vsem_tr_txt r vsem_tt_byte cap
    ret 0
  end
  if eq tag V_TY_TUPLE
    vsem_tr_txt r vsem_tt_tuple cap
    ret 0
  end
  if eq tag V_TY_ADDR
    vsem_tr_txt r vsem_tt_addr cap
    vsem_tr_u64 r w cap
    vsem_tr_push r uchar 62 cap
    ret 0
  end
  ret vsem_type_text_ref r cap tag
end

fn vsem_type_text_ref r ulong cap ulong tag ulong to long
  if eq tag V_TY_RESOURCE
    vsem_tr_txt r vsem_tt_res cap
    ret 0
  end
  if eq tag V_TY_CAP_REF
    vsem_tr_txt r vsem_tt_cap cap
    ret 0
  end
  if eq tag V_TY_EFF_INTENT_REF
    vsem_tr_txt r vsem_tt_ei cap
    ret 0
  end
  if eq tag V_TY_EFF_RECEIPT_REF
    vsem_tr_txt r vsem_tt_er cap
    ret 0
  end
  if eq tag V_TY_FP32
    vsem_tr_txt r vsem_tt_fp cap
    ret 0
  end
  vsem_tr_set r vsem_n_q cap
  ret -1
end

note int_width_of the type id in v_tmp_id: width, or -1; bool flag in vsem_isb.
fn vsem_int_width to long
  sh = vsem_load_tmp
  if ne sh long VSEM_SHAPE_TYPE
    ret -1
  end
  idx = get vsem_lidx 0
  put vsem_isb 0 0
  tag = vsem_pay_u32 idx 0
  w = ulong 0
  if or eq tag V_TY_UINT eq tag V_TY_BITVEC
    w = vsem_pay_u16 idx 4
  else
    if eq tag V_TY_BYTE
      w = 8
    else
      if eq tag V_TY_BOOL
        w = 1
        put vsem_isb 0 1
      else
        ret -1
      end
    end
  end
  if or lt w 1 gt w 64
    ret -1
  end
  ret long w
end

note decode_value of VALUE object vidx: 0 with vsem_dv / vsem_isb, or -1.
fn vsem_decode vidx ulong to long
  vsem_pay_to_tmp vidx 0
  w = vsem_int_width
  if lt w 0
    ret -1
  end
  bl = vsem_pay_u16 vidx 32
  pb = add vsem_pb vidx 34
  if eq get vsem_isb 0 1
    b0 = ulong get v_og_pay pb
    if or ne bl 1 gt b0 1
      ret -1
    end
    put vsem_dv 0 b0
    ret 0
  end
  uw = ulong w
  if ne bl div add uw 7 8
    ret -1
  end
  v = ulong 0
  for i ulong bl bound 64
    v = or shl v 8 ulong get v_og_pay add pb i
  end
  if lt uw 64
    if ne shr v uw 0
      ret -1
    end
  end
  put vsem_dv 0 v
  ret 0
end

fn vsem_rtid_from idx ulong off ulong to long
  b = add vsem_pb idx off
  zero = true
  for i ulong 32
    c = get v_og_pay add b i
    put vsem_rtid i c
    if ne c 0
      zero = false
    end
  end
  if zero
    ret -1
  end
  ret 0
end

note result_type_id of parsed object idx with shape sh: 0 (vsem_rtid) or -1.
fn vsem_result_type idx ulong sh long to long
  if eq sh long VSEM_SHAPE_VALUE
    ret vsem_rtid_from idx 0
  end
  if eq sh long VSEM_SHAPE_OP
    ret vsem_rtid_from idx 169
  end
  if eq sh long VSEM_SHAPE_APPLY
    vsem_pay_to_tmp idx 0
    os = vsem_load_tmp
    if ne os long VSEM_SHAPE_OP
      ret -1
    end
    ret vsem_rtid_from get vsem_lidx 0 169
  end
  ret -1
end

fn vsem_rtid_to_tmp to void
  for i ulong 32
    put v_tmp_id i get vsem_rtid i
  end
end

note ---- dependencies (one list per graph depth) ----
fn vsem_dep_push lv ulong code ulong arg ulong to void
  if vsem_tmp_zero
    ret
  end
  c = get vsem_dl_cnt lv
  if ge c VSEM_MAX_DEPS
    ret
  end
  base = mul lv VSEM_MAX_DEPS
  for i ulong c bound 72
    same = true
    ib = mul add base i 32
    for k ulong 32
      if ne get vsem_dl_ids add ib k get v_tmp_id k
        same = false
        break
      end
    end
    if same
      ret
    end
  end
  nb = mul add base c 32
  for k ulong 32
    put vsem_dl_ids add nb k get v_tmp_id k
  end
  put vsem_dl_code add base c code
  put vsem_dl_arg add base c arg
  put vsem_dl_cnt lv add c 1
end

fn vsem_collect_deps idx ulong sh long lv ulong to void
  put vsem_dl_cnt lv 0
  rc = get v_og_rcnt idx
  for i ulong rc bound 64
    s = og_rslot idx i
    tb = mul s 32
    for k ulong 32
      put v_tmp_id k get v_og_rtgt add tb k
    end
    vsem_dep_push lv 0 get v_og_rkind s
  end
  if eq sh long VSEM_SHAPE_TYPE
    if eq vsem_pay_u32 idx 0 V_TY_SEQ
      vsem_pay_to_tmp idx 12
      vsem_dep_push lv 1 0
    end
    ret
  end
  if eq sh long VSEM_SHAPE_VALUE
    vsem_pay_to_tmp idx 0
    vsem_dep_push lv 2 0
    ret
  end
  if eq sh long VSEM_SHAPE_OP
    vsem_pay_to_tmp idx 8
    vsem_dep_push lv 2 0
    ar = vsem_pay_u8 idx 40
    for i ulong ar bound 4
      vsem_pay_to_tmp idx add 41 mul i 32
      vsem_dep_push lv 3 i
    end
    vsem_pay_to_tmp idx 169
    vsem_dep_push lv 4 0
    ret
  end
  if eq sh long VSEM_SHAPE_APPLY
    vsem_pay_to_tmp idx 0
    vsem_dep_push lv 5 0
    oc = vsem_pay_u8 idx 32
    for i ulong oc bound 4
      vsem_pay_to_tmp idx add 33 mul i 32
      vsem_dep_push lv 6 i
    end
  end
end

fn vsem_put_role code ulong arg ulong to void
  if eq code 0
    ob_puts vsem_ro_rel
    vsem_put_relation arg
    ret
  end
  if eq code 1
    ob_puts vsem_ro_elem
    ret
  end
  if eq code 2
    ob_puts vsem_ro_type
    ret
  end
  if eq code 3
    ob_puts vsem_ro_input
    ob_put_u64 arg
    ret
  end
  if eq code 4
    ob_puts vsem_ro_output
    ret
  end
  if eq code 5
    ob_puts vsem_ro_op
    ret
  end
  ob_puts vsem_ro_operand
  ob_put_u64 arg
end

note ---- inspect ----
fn vsem_v_copy_tr r ulong to void
  l = get vsem_trl r
  if gt l 95
    l = 95
  end
  b = mul r 128
  for i ulong l bound 128
    put vsem_vtt i get vsem_tr add b i
  end
  put vsem_vttl 0 l
end

fn vsem_v_set_txt w view uchar * to void
  n = len w
  for i ulong n bound 96
    put vsem_vtt i get w i
  end
  put vsem_vttl 0 n
end

fn vsem_copy32 dst ulong idx ulong off ulong to void
  b = add vsem_pb idx off
  for i ulong 32
    if eq dst 0
      put vsem_v_tid i get v_og_pay add b i
    end
    if eq dst 1
      put vsem_v_elem i get v_og_pay add b i
    end
    if eq dst 2
      put vsem_v_optype i get v_og_pay add b i
    end
    if eq dst 3
      put vsem_v_output i get v_og_pay add b i
    end
    if eq dst 4
      put vsem_v_apop i get v_og_pay add b i
    end
  end
end

fn vsem_inspect_type idx ulong to void
  put vsem_v_tag 0 and vsem_pay_u32 idx 0 255
  put vsem_v_width 0 vsem_pay_u16 idx 4
  put vsem_v_length 0 vsem_pay_u32 idx 8
  if eq vsem_pay_u32 idx 0 V_TY_SEQ
    vsem_pay_to_tmp idx 12
    if not vsem_tmp_zero
      put vsem_v_haselem 0 1
      vsem_copy32 1 idx 12
    end
  end
  for i ulong 32
    put v_tmp_id i get vsem_v_id i
  end
  u = vsem_type_text 0 96 0
  vsem_v_copy_tr 0
  if lt u -9
    ret
  end
end

fn vsem_inspect_value idx ulong to void
  bl = vsem_pay_u16 idx 32
  put vsem_v_vbl 0 bl
  pb = add vsem_pb idx 34
  for i ulong bl bound 64
    put vsem_v_vbytes i get v_og_pay add pb i
  end
  vsem_pay_to_tmp idx 0
  u = vsem_type_text 0 96 0
  vsem_v_copy_tr 0
  if eq vsem_decode idx 0
    put vsem_v_hasu64 0 1
    put vsem_v_u64 0 get vsem_dv 0
    put vsem_v_isbool 0 get vsem_isb 0
  else
    put vsem_v_isbool 0 0
  end
  if lt u -9
    ret
  end
end

fn vsem_inspect_op idx ulong to void
  put vsem_v_opcode 0 and vsem_pay_u32 idx 0 255
  put vsem_v_ovf 0 and vsem_pay_u32 idx 4 255
  ar = vsem_pay_u8 idx 40
  put vsem_v_arity 0 ar
  vsem_copy32 2 idx 8
  pb = add vsem_pb idx 41
  for i ulong 128
    put vsem_v_inputs i get v_og_pay add pb i
  end
  vsem_copy32 3 idx 169
  vsem_tr_clear 20
  vsem_tr_txt 20 vsem_tt_fn 96
  for i ulong ar bound 4
    vsem_pay_to_tmp idx add 41 mul i 32
    u = vsem_type_text 21 24 0
    if gt i 0
      vsem_tr_push 20 uchar 44 96
    end
    vsem_tr_copy 20 21 128 96
    if lt u -9
      ret
    end
  end
  vsem_pay_to_tmp idx 169
  u2 = vsem_type_text 21 24 0
  vsem_tr_txt 20 vsem_tt_arrow 96
  vsem_tr_copy 20 21 128 96
  vsem_v_copy_tr 20
  if lt u2 -9
    ret
  end
end

fn vsem_inspect_apply idx ulong sh long to void
  vsem_copy32 4 idx 0
  put vsem_v_opcnt 0 vsem_pay_u8 idx 32
  pb = add vsem_pb idx 33
  for i ulong 128
    put vsem_v_operands i get v_og_pay add pb i
  end
  vsem_pay_to_tmp idx 0
  if eq vsem_load_tmp long VSEM_SHAPE_OP
    oi = get vsem_lidx 0
    put vsem_v_opcode 0 and vsem_pay_u32 oi 0 255
    put vsem_v_ovf 0 and vsem_pay_u32 oi 4 255
    put vsem_v_arity 0 vsem_pay_u8 oi 40
    put vsem_v_hasopn 0 1
  end
  if eq vsem_result_type idx sh 0
    vsem_rtid_to_tmp
    u = vsem_type_text 0 96 0
    vsem_v_copy_tr 0
    if lt u -9
      ret
    end
  else
    vsem_v_set_txt vsem_n_q
  end
end

fn vsem_view_reset to void
  put vsem_v_status 0 0
  put vsem_v_rsl 0 0
  put vsem_v_shape 0 0
  put vsem_vttl 0 0
  put vsem_v_hastid 0 0
  put vsem_v_tag 0 0
  put vsem_v_width 0 0
  put vsem_v_length 0 0
  put vsem_v_haselem 0 0
  put vsem_v_vbl 0 0
  put vsem_v_hasu64 0 0
  put vsem_v_u64 0 0
  put vsem_v_isbool 0 0
  put vsem_v_opcode 0 0
  put vsem_v_ovf 0 0
  put vsem_v_arity 0 0
  put vsem_v_hasopn 0 0
  put vsem_v_opcnt 0 0
  put vsem_v_clen 0 0
  put vsem_v_cmatch 0 0
  put vsem_v_dcnt 0 0
  put vsem_dangling 0 0
  for i ulong 32
    put vsem_v_tid i uchar 0
    put vsem_v_elem i uchar 0
    put vsem_v_optype i uchar 0
    put vsem_v_output i uchar 0
    put vsem_v_apop i uchar 0
  end
  for i ulong 128
    put vsem_v_inputs i uchar 0
    put vsem_v_operands i uchar 0
  end
end

fn vsem_inspect_deps idx ulong sh long to void
  vsem_collect_deps idx sh 0
  c = get vsem_dl_cnt 0
  put vsem_v_dcnt 0 c
  dang = ulong 0
  for i ulong c bound 72
    b = mul i 32
    for k ulong 32
      ch = get vsem_dl_ids add b k
      put vsem_v_dids add b k ch
      put v_tmp_id k ch
    end
    put vsem_v_dcode i get vsem_dl_code i
    put vsem_v_darg i get vsem_dl_arg i
    res = ge og_find_by_tmp 0
    if res
      put vsem_v_dres i 1
    else
      put vsem_v_dres i 0
      dang = add dang 1
    end
  end
  put vsem_dangling 0 dang
end

fn vsem_inspect_rels idx ulong to void
  rc = get v_og_rcnt idx
  for i ulong rc bound 64
    tb = mul og_rslot idx i 32
    for k ulong 32
      put v_tmp_id k get v_og_rtgt add tb k
    end
    if ge og_find_by_tmp 0
      put vsem_v_rres i 1
    else
      put vsem_v_rres i 0
    end
  end
end

note visor_semantic_inspect for the id in v_tmp_id: 0, -1 missing, -2 malformed.
fn vsem_inspect_tmp to long
  oi = og_find_by_tmp
  if lt oi 0
    ret -1
  end
  idx = ulong oi
  vsem_view_reset
  put vsem_v_idx 0 idx
  for i ulong 32
    put vsem_v_id i get v_og_id add mul idx 32 i
  end
  put vsem_v_kind 0 and get v_og_kind idx 255
  sh = vsem_load_tmp
  if lt sh 0
    put vsem_v_status 0 -2
    l = get vsem_rsl 0
    for i ulong l bound 256
      put vsem_v_rs i get vsem_rs i
    end
    put vsem_v_rsl 0 l
    ret -2
  end
  put vsem_v_shape 0 ulong sh
  put vsem_v_clen 0 get vsem_clen 0
  for i ulong 32
    put vsem_v_csha i get v_sha_out i
  end
  if og_id_eq_sha idx
    put vsem_v_cmatch 0 1
  end
  vsem_inspect_shape idx sh
  if eq vsem_result_type idx sh 0
    put vsem_v_hastid 0 1
    for i ulong 32
      put vsem_v_tid i get vsem_rtid i
    end
  end
  vsem_inspect_rels idx
  vsem_inspect_deps idx sh
  ret 0
end

fn vsem_inspect_shape idx ulong sh long to void
  if eq sh long VSEM_SHAPE_TYPE
    vsem_inspect_type idx
    ret
  end
  if eq sh long VSEM_SHAPE_VALUE
    vsem_inspect_value idx
    ret
  end
  if eq sh long VSEM_SHAPE_OP
    vsem_inspect_op idx
    ret
  end
  if eq sh long VSEM_SHAPE_APPLY
    vsem_inspect_apply idx sh
    ret
  end
  vsem_v_set_txt vsem_n_dash
end

fn vsem_inspect idx ulong to long
  og_tmp_from_obj idx
  ret vsem_inspect_tmp
end

note C argument checks: a missing graph or id refuses with -1.
fn vsem_inspect_args gok bool idok bool to long
  if not and gok idok
    ret -1
  end
  ret vsem_inspect_tmp
end

note ---- formatting ----
fn vsem_put_id_bytes b view uchar * off ulong to void
  ob_puts vt_sha256_pfx
  for i ulong 32
    ob_put_hex_byte ulong get b add off i
  end
end

fn vsem_put_tmp_id to void
  ob_puts vt_sha256_pfx
  for i ulong 32
    ob_put_hex_byte ulong get v_tmp_id i
  end
end

fn vsem_put_view_id to void
  ob_puts vt_sha256_pfx
  for i ulong 32
    ob_put_hex_byte ulong get vsem_v_id i
  end
end

fn vsem_put_g32 sel ulong off ulong to void
  ob_puts vt_sha256_pfx
  for i ulong 32
    b = ulong 0
    if eq sel 0
      b = ulong get vsem_v_tid add off i
    end
    if eq sel 1
      b = ulong get vsem_v_elem add off i
    end
    if eq sel 2
      b = ulong get vsem_v_optype add off i
    end
    if eq sel 3
      b = ulong get vsem_v_output add off i
    end
    if eq sel 4
      b = ulong get vsem_v_apop add off i
    end
    if eq sel 5
      b = ulong get vsem_v_inputs add off i
    end
    if eq sel 6
      b = ulong get vsem_v_operands add off i
    end
    if eq sel 7
      b = ulong get vsem_v_dids add off i
    end
    ob_put_hex_byte b
  end
end

fn vsem_put_rel_target idx ulong i ulong to void
  tb = mul og_rslot idx i 32
  ob_puts vt_sha256_pfx
  for k ulong 32
    ob_put_hex_byte ulong get v_og_rtgt add tb k
  end
end

fn vsem_put_vtt to void
  l = get vsem_vttl 0
  for i ulong l bound 96
    ob_putc get vsem_vtt i
  end
end

fn vsem_put_rs to void
  l = get vsem_v_rsl 0
  for i ulong l bound 256
    ob_putc get vsem_v_rs i
  end
end

fn vsem_finish to long
  if ne get v_ob_ovf 0 0
    put v_ob_len 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vsem_attr_utf8 slot ulong to bool
  vl = get v_og_avlen slot
  vb = mul slot 512
  for i ulong vl bound 512
    c = get v_og_aval add vb i
    if or lt c 32 gt c 126
      ret false
    end
  end
  ret true
end

fn vsem_put_attr_key slot ulong to void
  kl = get v_og_aklen slot
  kb = mul slot 64
  for i ulong kl bound 64
    ob_putc get v_og_akey add kb i
  end
end

fn vsem_put_attr_hex slot ulong to void
  vl = get v_og_avlen slot
  vb = mul slot 512
  for i ulong vl bound 512
    ob_put_hex_byte ulong get v_og_aval add vb i
  end
end

fn vsem_put_attr_raw slot ulong to void
  vl = get v_og_avlen slot
  vb = mul slot 512
  for i ulong vl bound 512
    ob_putc get v_og_aval add vb i
  end
end

fn vsem_put_const_hex slot ulong to void
  cl = get v_og_clen slot
  cb = mul slot 128
  for i ulong cl bound 128
    ob_put_hex_byte ulong get v_og_cpay add cb i
  end
end

fn vsem_text_shape to void
  sh = get vsem_v_shape 0
  if eq sh VSEM_SHAPE_TYPE
    ob_puts vsem_f_tag
    ob_put_u64 get vsem_v_tag 0
    ob_putc uchar 10
    ob_puts vsem_f_width
    ob_put_u64 get vsem_v_width 0
    ob_putc uchar 10
    ob_puts vsem_f_length
    ob_put_u64 get vsem_v_length 0
    ob_putc uchar 10
    if eq get vsem_v_haselem 0 1
      ob_puts vsem_f_elem
      vsem_put_g32 1 0
      ob_putc uchar 10
    end
    ret
  end
  if eq sh VSEM_SHAPE_VALUE
    ob_puts vsem_f_vbytes
    bl = get vsem_v_vbl 0
    for i ulong bl bound 64
      ob_put_hex_byte ulong get vsem_v_vbytes i
    end
    ob_putc uchar 10
    if eq get vsem_v_hasu64 0 1
      ob_puts vsem_f_value
      if eq get vsem_v_isbool 0 1
        if ne get vsem_v_u64 0 0
          ob_puts vsem_f_true
        else
          ob_puts vsem_f_false
        end
      else
        ob_put_u64 get vsem_v_u64 0
      end
      ob_putc uchar 10
    else
      ob_puts vsem_f_nodec
    end
    ret
  end
  vsem_text_shape_op sh
end

fn vsem_text_shape_op sh ulong to void
  if eq sh VSEM_SHAPE_OP
    ob_puts vsem_f_opcode
    vsem_put_opcode get vsem_v_opcode 0
    ob_putc uchar 10
    ob_puts vsem_f_ovf
    vsem_put_overflow get vsem_v_ovf 0
    ob_putc uchar 10
    ob_puts vsem_f_arity
    ar = get vsem_v_arity 0
    ob_put_u64 ar
    ob_putc uchar 10
    ob_puts vsem_f_optype
    vsem_put_g32 2 0
    ob_putc uchar 10
    for i ulong ar bound 4
      ob_puts vsem_f_input
      ob_put_u64 i
      ob_putc uchar 58
      ob_putc uchar 32
      vsem_put_g32 5 mul i 32
      ob_putc uchar 10
    end
    ob_puts vsem_f_output
    vsem_put_g32 3 0
    ob_putc uchar 10
    ret
  end
  if eq sh VSEM_SHAPE_APPLY
    ob_puts vsem_f_op
    vsem_put_g32 4 0
    ob_putc uchar 10
    ob_puts vsem_f_opcode
    if eq get vsem_v_hasopn 0 1
      vsem_put_opcode get vsem_v_opcode 0
    else
      ob_puts vsem_n_q
    end
    ob_putc uchar 10
    ob_puts vsem_f_ovf
    if eq get vsem_v_hasopn 0 1
      vsem_put_overflow get vsem_v_ovf 0
    else
      ob_puts vsem_n_q
    end
    ob_putc uchar 10
    ob_puts vsem_f_operands
    oc = get vsem_v_opcnt 0
    ob_put_u64 oc
    ob_putc uchar 10
    for i ulong oc bound 4
      ob_putc uchar 32
      ob_putc uchar 32
      ob_putc uchar 91
      ob_put_u64 i
      ob_putc uchar 93
      ob_putc uchar 32
      vsem_put_g32 6 mul i 32
      ob_putc uchar 10
    end
  end
end

fn vsem_idx_tag i ulong to void
  ob_putc uchar 32
  ob_putc uchar 32
  ob_putc uchar 91
  ob_put_u64 i
  ob_putc uchar 93
  ob_putc uchar 32
end

fn vsem_text_lists to void
  idx = get vsem_v_idx 0
  ob_puts vsem_f_attrs
  ac = get v_og_acnt idx
  ob_put_u64 ac
  ob_putc uchar 10
  for i ulong ac bound 32
    s = og_aslot idx i
    vsem_idx_tag i
    vsem_put_attr_key s
    ob_puts vsem_f_hexeq
    vsem_put_attr_hex s
    if vsem_attr_utf8 s
      ob_puts vsem_f_utf8
      vsem_put_attr_raw s
      ob_putc uchar 34
    end
    ob_putc uchar 10
  end
  ob_puts vsem_f_rels
  rc = get v_og_rcnt idx
  ob_put_u64 rc
  ob_putc uchar 10
  for i ulong rc bound 64
    vsem_idx_tag i
    vsem_put_relation get v_og_rkind og_rslot idx i
    ob_putc uchar 32
    vsem_put_rel_target idx i
    if eq get vsem_v_rres i 0
      ob_puts vsem_f_dangl
    end
    ob_putc uchar 10
  end
  ob_puts vsem_f_consts
  cc = get v_og_ccnt idx
  ob_put_u64 cc
  ob_putc uchar 10
  for i ulong cc bound 32
    s2 = og_cslot idx i
    vsem_idx_tag i
    vsem_put_constraint get v_og_ckind s2
    ob_puts vsem_f_clen
    ob_put_u64 get v_og_clen s2
    ob_puts vsem_f_hex
    vsem_put_const_hex s2
    ob_putc uchar 10
  end
end

fn vsem_text_tail to void
  ob_puts vsem_f_canlen
  ob_put_u64 get vsem_v_clen 0
  ob_putc uchar 10
  ob_puts vsem_f_cansha
  for i ulong 32
    ob_put_hex_byte ulong get vsem_v_csha i
  end
  ob_putc uchar 10
  ob_puts vsem_f_canm
  if eq get vsem_v_cmatch 0 1
    ob_puts vsem_f_yes
  else
    ob_puts vsem_f_no
  end
  ob_putc uchar 10
  ob_puts vsem_f_deps
  dc = get vsem_v_dcnt 0
  ob_put_u64 dc
  ob_puts vsem_f_dangling
  ob_put_u64 get vsem_dangling 0
  ob_putc uchar 41
  ob_putc uchar 10
  for i ulong dc bound 72
    vsem_idx_tag i
    vsem_put_role get vsem_v_dcode i get vsem_v_darg i
    ob_putc uchar 32
    vsem_put_g32 7 mul i 32
    if eq get vsem_v_dres i 0
      ob_puts vsem_f_dangl
    end
    ob_putc uchar 10
  end
end

note visor_semantic_format_text into v_ob; n is the C buffer size (output < n).
fn vsem_format_text n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  ob_puts vsem_f_id
  vsem_put_view_id
  ob_putc uchar 10
  ob_puts vsem_f_kind
  v_put_kind_name get vsem_v_kind 0
  ob_putc uchar 10
  if ne get vsem_v_status 0 0
    ob_puts vsem_f_mal
    vsem_put_rs
    ob_putc uchar 41
    ob_putc uchar 10
    ret vsem_finish
  end
  ob_puts vsem_f_ok
  ob_puts vsem_f_shape
  vsem_put_shape get vsem_v_shape 0
  ob_putc uchar 10
  ob_puts vsem_f_type
  vsem_put_vtt
  ob_putc uchar 10
  if eq get vsem_v_hastid 0 1
    ob_puts vsem_f_tid
    vsem_put_g32 0 0
    ob_putc uchar 10
  end
  vsem_text_shape
  vsem_text_lists
  vsem_text_tail
  ret vsem_finish
end

note ---- JSON ----
fn vsem_jbyte c uchar to void
  if eq c 34
    ob_putc uchar 92
    ob_putc uchar 34
    ret
  end
  if eq c 92
    ob_putc uchar 92
    ob_putc uchar 92
    ret
  end
  if or lt c 32 gt c 126
    ob_putc uchar 92
    ob_putc uchar 117
    ob_putc uchar 48
    ob_putc uchar 48
    ob_putc get vt_hex ulong shr c 4
    ob_putc get vt_hex ulong and c 15
    ret
  end
  ob_putc c
end

fn vsem_jtxt w view uchar * to void
  ob_putc uchar 34
  n = len w
  for i ulong n bound 256
    vsem_jbyte get w i
  end
  ob_putc uchar 34
end

fn vsem_jg32 sel ulong off ulong to void
  ob_putc uchar 34
  vsem_put_g32 sel off
  ob_putc uchar 34
end

fn vsem_jbool b bool to void
  if b
    ob_puts vsem_f_true
  else
    ob_puts vsem_f_false
  end
end

note names as JSON strings (all printable ASCII, no escapes needed).
fn vsem_jname_open to void
  ob_putc uchar 34
end

fn vsem_json_shape to void
  sh = get vsem_v_shape 0
  if eq sh VSEM_SHAPE_TYPE
    ob_puts vsem_j_tag
    ob_put_u64 get vsem_v_tag 0
    ob_puts vsem_j_width
    ob_put_u64 get vsem_v_width 0
    ob_puts vsem_j_length
    ob_put_u64 get vsem_v_length 0
    ob_puts vsem_j_elem
    if eq get vsem_v_haselem 0 1
      vsem_jg32 1 0
    else
      ob_puts vsem_j_null
    end
    ret
  end
  if eq sh VSEM_SHAPE_VALUE
    ob_puts vsem_j_vbytes
    ob_putc uchar 34
    bl = get vsem_v_vbl 0
    for i ulong bl bound 64
      ob_put_hex_byte ulong get vsem_v_vbytes i
    end
    ob_putc uchar 34
    ob_puts vsem_j_value
    if eq get vsem_v_hasu64 0 0
      ob_puts vsem_j_null
    else
      if eq get vsem_v_isbool 0 1
        vsem_jbool ne get vsem_v_u64 0 0
      else
        ob_putc uchar 34
        ob_put_u64 get vsem_v_u64 0
        ob_putc uchar 34
      end
    end
    ret
  end
  vsem_json_shape_op sh
end

fn vsem_json_shape_op sh ulong to void
  if eq sh VSEM_SHAPE_OP
    ob_puts vsem_j_opcode
    ob_putc uchar 34
    vsem_put_opcode get vsem_v_opcode 0
    ob_putc uchar 34
    ob_puts vsem_j_ovf
    ob_putc uchar 34
    vsem_put_overflow get vsem_v_ovf 0
    ob_putc uchar 34
    ob_puts vsem_j_arity
    ar = get vsem_v_arity 0
    ob_put_u64 ar
    ob_puts vsem_j_optype
    vsem_jg32 2 0
    ob_puts vsem_j_inputs
    for i ulong ar bound 4
      if gt i 0
        ob_putc uchar 44
      end
      vsem_jg32 5 mul i 32
    end
    ob_puts vsem_j_output
    vsem_jg32 3 0
    ret
  end
  if eq sh VSEM_SHAPE_APPLY
    ob_puts vsem_j_op
    vsem_jg32 4 0
    ob_puts vsem_j_opcode
    if eq get vsem_v_hasopn 0 1
      ob_putc uchar 34
      vsem_put_opcode get vsem_v_opcode 0
      ob_putc uchar 34
    else
      ob_puts vsem_j_null
    end
    ob_puts vsem_j_ovf
    if eq get vsem_v_hasopn 0 1
      ob_putc uchar 34
      vsem_put_overflow get vsem_v_ovf 0
      ob_putc uchar 34
    else
      ob_puts vsem_j_null
    end
    ob_puts vsem_j_operands
    oc = get vsem_v_opcnt 0
    for i ulong oc bound 4
      if gt i 0
        ob_putc uchar 44
      end
      vsem_jg32 6 mul i 32
    end
    ob_putc uchar 93
  end
end

fn vsem_json_attr s ulong to void
  ob_puts vsem_j_key
  ob_putc uchar 34
  kl = get v_og_aklen s
  kb = mul s 64
  for k ulong kl bound 64
    vsem_jbyte get v_og_akey add kb k
  end
  ob_putc uchar 34
  ob_puts vsem_j_hex
  ob_putc uchar 34
  vsem_put_attr_hex s
  ob_putc uchar 34
  if vsem_attr_utf8 s
    ob_puts vsem_j_utf8
    ob_putc uchar 34
    vl = get v_og_avlen s
    vb = mul s 512
    for k ulong vl bound 512
      vsem_jbyte get v_og_aval add vb k
    end
    ob_putc uchar 34
  end
  ob_putc uchar 125
end

fn vsem_json_lists to void
  idx = get vsem_v_idx 0
  ob_puts vsem_j_attrs
  ac = get v_og_acnt idx
  for i ulong ac bound 32
    if gt i 0
      ob_putc uchar 44
    end
    vsem_json_attr og_aslot idx i
  end
  ob_puts vsem_j_rels
  rc = get v_og_rcnt idx
  for i ulong rc bound 64
    if gt i 0
      ob_putc uchar 44
    end
    ob_puts vsem_j_rkind
    ob_putc uchar 34
    vsem_put_relation get v_og_rkind og_rslot idx i
    ob_putc uchar 34
    ob_puts vsem_j_target
    ob_putc uchar 34
    vsem_put_rel_target idx i
    ob_putc uchar 34
    ob_puts vsem_j_resolved
    vsem_jbool eq get vsem_v_rres i 1
    ob_putc uchar 125
  end
  ob_puts vsem_j_consts
  cc = get v_og_ccnt idx
  for i ulong cc bound 32
    if gt i 0
      ob_putc uchar 44
    end
    s2 = og_cslot idx i
    ob_puts vsem_j_rkind
    ob_putc uchar 34
    vsem_put_constraint get v_og_ckind s2
    ob_putc uchar 34
    ob_puts vsem_j_len
    ob_put_u64 get v_og_clen s2
    ob_puts vsem_j_hex
    ob_putc uchar 34
    vsem_put_const_hex s2
    ob_putc uchar 34
    ob_putc uchar 125
  end
end

fn vsem_json_tail to void
  ob_puts vsem_j_canon
  ob_put_u64 get vsem_v_clen 0
  ob_puts vsem_j_sha
  for i ulong 32
    ob_put_hex_byte ulong get vsem_v_csha i
  end
  ob_puts vsem_j_idm
  vsem_jbool eq get vsem_v_cmatch 0 1
  ob_puts vsem_j_deps
  dc = get vsem_v_dcnt 0
  for i ulong dc bound 72
    if gt i 0
      ob_putc uchar 44
    end
    ob_puts vsem_j_role
    ob_putc uchar 34
    vsem_put_role get vsem_v_dcode i get vsem_v_darg i
    ob_putc uchar 34
    ob_puts vsem_j_idk
    vsem_jg32 7 mul i 32
    ob_puts vsem_j_resolved
    vsem_jbool eq get vsem_v_dres i 1
    ob_putc uchar 125
  end
  ob_puts vsem_j_dangling
  ob_put_u64 get vsem_dangling 0
  ob_putc uchar 125
end

note visor_semantic_format_json into v_ob; n is the C buffer size.
fn vsem_format_json n ulong to long
  if eq n 0
    ret -1
  end
  ob_reset sub n 1
  ob_puts vsem_j_id
  vsem_put_view_id
  ob_puts vsem_j_kind
  ob_putc uchar 34
  v_put_kind_name get vsem_v_kind 0
  ob_putc uchar 34
  if ne get vsem_v_status 0 0
    ob_puts vsem_j_mal
    ob_putc uchar 34
    l = get vsem_v_rsl 0
    for i ulong l bound 256
      vsem_jbyte get vsem_v_rs i
    end
    ob_putc uchar 34
    ob_putc uchar 125
    ret vsem_finish
  end
  ob_puts vsem_j_ok
  ob_putc uchar 34
  vsem_put_shape get vsem_v_shape 0
  ob_putc uchar 34
  ob_puts vsem_j_type
  ob_putc uchar 34
  l2 = get vsem_vttl 0
  for i ulong l2 bound 96
    vsem_jbyte get vsem_vtt i
  end
  ob_putc uchar 34
  ob_puts vsem_j_tid
  if eq get vsem_v_hastid 0 1
    vsem_jg32 0 0
  else
    ob_puts vsem_j_null
  end
  vsem_json_shape
  vsem_json_lists
  vsem_json_tail
  ret vsem_finish
end

note ---- type_of, apply_parts, value_u64 ----
note visor_semantic_type_of for the id in v_tmp_id: 0 (id in vsem_rtid, text in region 40), else rc.
fn vsem_type_of_tmp to long
  sh = vsem_load_tmp
  if lt sh 0
    ret sh
  end
  idx = get vsem_lidx 0
  if ne vsem_result_type idx sh 0
    ret -1
  end
  vsem_rtid_to_tmp
  if ne vsem_type_text 40 96 0 0
    ret -1
  end
  ret 0
end

note console `type`: the type text of TYPE object tidx into v_ob.
fn vsem_put_type_str tidx ulong to void
  og_tmp_from_obj tidx
  u = vsem_type_text 40 96 0
  vsem_put_tr 40
  if lt u -9
    ret
  end
end

fn vsem_apply_parts_tmp to long
  sh = vsem_load_tmp
  if lt sh 0
    ret sh
  end
  if ne sh long VSEM_SHAPE_APPLY
    ret -1
  end
  idx = get vsem_lidx 0
  pb = vsem_pb idx
  for i ulong 32
    put vsem_ap_op i get v_og_pay add pb i
  end
  oc = vsem_pay_u8 idx 32
  for i ulong mul oc 32 bound 128
    put vsem_ap_ops i get v_og_pay add add pb 33 i
  end
  put vsem_ap_cnt 0 oc
  ret 0
end

fn vsem_value_u64_tmp to long
  sh = vsem_load_tmp
  if lt sh 0
    ret sh
  end
  if ne sh long VSEM_SHAPE_VALUE
    ret -1
  end
  if ne vsem_decode get vsem_lidx 0 0
    ret -1
  end
  put vsem_val 0 get vsem_dv 0
  ret 0
end

note ---- eval ----
note omega_eval_pure_binary_uint: 0 (result in vsem_evv), -1 refused, -2 fail-closed overflow.
fn vsem_eval_pure opc ulong ovf ulong w ulong a0 ulong b0 ulong to long
  mask = ulong 0xffffffffffffffff
  if lt w 64
    mask = sub shl ulong 1 w 1
  end
  a = and a0 mask
  b = and b0 mask
  res = ulong 0
  over = false
  if eq opc V_OP_EQUAL
    put vsem_evv 0 0
    if eq a b
      put vsem_evv 0 1
    end
    ret 0
  end
  if eq opc V_OP_LESS_THAN
    put vsem_evv 0 0
    if lt a b
      put vsem_evv 0 1
    end
    ret 0
  end
  if eq opc V_OP_ADD
    res = add a b
    if or lt res a ne and res not mask 0
      over = true
    end
  else
    if eq opc V_OP_SUB
      if lt a b
        over = true
        res = sub add a add mask 1 b
      else
        res = sub a b
      end
    else
      if eq opc V_OP_MUL
        if and ne a 0 gt b div mask a
          over = true
        end
        res = and mul a b mask
      else
        res = vsem_eval_pure_rest opc a b
        if eq get vsem_evv 0 1
          ret -1
        end
      end
    end
  end
  if over
    if eq ovf V_OVF_FAIL_CLOSED
      ret -2
    end
    if eq ovf V_OVF_SATURATE
      res = mask
    end
  end
  put vsem_evv 0 and res mask
  ret 0
end

note DIV, AND, OR; vsem_evv 1 marks a refusal.
fn vsem_eval_pure_rest opc ulong a ulong b ulong to ulong
  put vsem_evv 0 0
  if eq opc V_OP_DIV
    if eq b 0
      put vsem_evv 0 1
      ret 0
    end
    ret div a b
  end
  if eq opc V_OP_AND
    ret and a b
  end
  if eq opc V_OP_OR
    ret or a b
  end
  put vsem_evv 0 1
  ret 0
end

fn vsem_input_eq_rtid opi ulong i ulong to bool
  b = add vsem_pb opi add 41 mul i 32
  for k ulong 32
    if ne get vsem_rtid k get v_og_pay add b k
      ret false
    end
  end
  ret true
end

note one operand i of apply idx against operation opi: 0 (value in vsem_evv) or rc.
fn vsem_eval_arg idx ulong opi ulong i ulong depth ulong to long
  off = add 33 mul i 32
  vsem_pay_to_tmp idx off
  la = vsem_load_tmp
  if lt la 0
    ret la
  end
  argi = get vsem_lidx 0
  if ne vsem_result_type argi la 0
    ret -1
  end
  if not vsem_input_eq_rtid opi i
    ret -1
  end
  vsem_pay_to_tmp idx off
  ret vsem_eval_rec add depth 1
end

note eval_rec of the id in v_tmp_id.
fn vsem_eval_rec depth ulong to long
  if gt depth 64
    ret -1
  end
  sh = vsem_load_tmp
  if lt sh 0
    ret sh
  end
  idx = get vsem_lidx 0
  if eq sh long VSEM_SHAPE_VALUE
    if eq vsem_decode idx 0
      put vsem_evv 0 get vsem_dv 0
      ret 0
    end
    ret -1
  end
  if ne sh long VSEM_SHAPE_APPLY
    ret -1
  end
  vsem_pay_to_tmp idx 0
  os = vsem_load_tmp
  if lt os 0
    ret os
  end
  if ne os long VSEM_SHAPE_OP
    ret -1
  end
  opi = get vsem_lidx 0
  if or ne vsem_pay_u8 opi 40 2 ne vsem_pay_u8 idx 32 2
    ret -1
  end
  vsem_pay_to_tmp opi 8
  w = vsem_int_width
  if or lt w 0 eq get vsem_isb 0 1
    ret -1
  end
  r0 = vsem_eval_arg idx opi 0 depth
  if ne r0 0
    ret r0
  end
  a0 = get vsem_evv 0
  r1 = vsem_eval_arg idx opi 1 depth
  if ne r1 0
    ret r1
  end
  a1 = get vsem_evv 0
  rc = vsem_eval_pure vsem_pay_u32 opi 0 vsem_pay_u32 opi 4 ulong w a0 a1
  if ne rc 0
    ret -3
  end
  ret 0
end

note visor_semantic_eval_u64 of the id in v_tmp_id: 0 with vsem_val, or rc.
fn vsem_eval_u64_tmp to long
  rc = vsem_eval_rec 0
  if eq rc 0
    put vsem_val 0 get vsem_evv 0
  end
  ret rc
end

note ---- graph text ----
fn vsem_short_id off ulong to void
  for i ulong 6
    ob_put_hex_byte ulong get v_og_pay add off i
  end
end

fn vsem_summary idx ulong sh long to void
  if eq sh long VSEM_SHAPE_TYPE
    og_tmp_from_obj idx
    u = vsem_type_text 24 96 0
    ob_puts vsem_g_type
    vsem_put_tr 24
    if lt u -9
      ret
    end
    ret
  end
  if eq sh long VSEM_SHAPE_VALUE
    vsem_pay_to_tmp idx 0
    u2 = vsem_type_text 24 96 0
    if eq vsem_decode idx 0
      ob_puts vsem_g_value
      if eq get vsem_isb 0 1
        if ne get vsem_dv 0 0
          ob_puts vsem_f_true
        else
          ob_puts vsem_f_false
        end
      else
        ob_put_u64 get vsem_dv 0
      end
    else
      ob_puts vsem_g_hex
      bl = vsem_pay_u16 idx 32
      pb = add vsem_pb idx 34
      for i ulong bl bound 64
        ob_put_hex_byte ulong get v_og_pay add pb i
      end
    end
    ob_puts vsem_g_colon
    vsem_put_tr 24
    if lt u2 -9
      ret
    end
    ret
  end
  vsem_summary_op idx sh
end

fn vsem_summary_op idx ulong sh long to void
  if eq sh long VSEM_SHAPE_OP
    vsem_pay_to_tmp idx 169
    u = vsem_type_text 24 96 0
    ob_puts vsem_g_op
    vsem_put_opcode vsem_pay_u32 idx 0
    ob_putc uchar 32
    vsem_put_overflow vsem_pay_u32 idx 4
    ob_puts vsem_g_arity
    ob_put_u64 vsem_pay_u8 idx 40
    ob_puts vsem_g_arrow
    vsem_put_tr 24
    if lt u -9
      ret
    end
    ret
  end
  if eq sh long VSEM_SHAPE_APPLY
    vsem_summary_apply idx sh
    ret
  end
  ob_puts vsem_g_plen
  ob_put_u64 get v_og_plen idx
end

fn vsem_summary_apply idx ulong sh long to void
  vsem_pay_to_tmp idx 0
  ob_puts vsem_g_apply
  if eq vsem_load_tmp long VSEM_SHAPE_OP
    vsem_put_opcode vsem_pay_u32 get vsem_lidx 0 0
  else
    ob_puts vsem_n_q
  end
  ob_putc uchar 40
  oc = vsem_pay_u8 idx 32
  for i ulong oc bound 4
    if gt i 0
      ob_putc uchar 44
    end
    vsem_short_id add vsem_pb idx add 33 mul i 32
  end
  if eq vsem_result_type idx sh 0
    vsem_rtid_to_tmp
    u = vsem_type_text 24 96 0
    if lt u -9
      ret
    end
  else
    vsem_tr_set 24 vsem_n_q 96
  end
  ob_puts vsem_g_close
  vsem_put_tr 24
end

fn vsem_gid_save depth ulong to void
  b = mul depth 32
  for i ulong 32
    put vsem_gid add b i get v_tmp_id i
  end
end

fn vsem_gid_load depth ulong to void
  b = mul depth 32
  for i ulong 32
    put v_tmp_id i get vsem_gid add b i
  end
end

note graph_rec of the id in v_tmp_id at depth; 0 or -1 (too deep).
fn vsem_graph_rec depth ulong to long
  if gt depth 64
    ret -1
  end
  vsem_gid_save depth
  oi = og_find_by_tmp
  if ge oi 0
    if eq get vsem_visited ulong oi 1
      ret 0
    end
  end
  for i ulong depth bound 65
    ob_putc uchar 32
    ob_putc uchar 32
  end
  if lt oi 0
    ob_puts vsem_g_missing
    vsem_put_tmp_id
    ob_putc uchar 10
    ret 0
  end
  idx = ulong oi
  sh = vsem_load_tmp
  if lt sh 0
    ob_puts vsem_g_mal
    vsem_gid_load depth
    vsem_put_tmp_id
    ob_putc uchar 32
    l = get vsem_rsl 0
    for i ulong l bound 256
      ob_putc get vsem_rs i
    end
    ob_putc uchar 10
    put vsem_visited idx 1
    ret 0
  end
  v_put_kind_name get v_og_kind idx
  ob_putc uchar 32
  vsem_gid_load depth
  vsem_put_tmp_id
  ob_putc uchar 32
  vsem_summary idx sh
  ob_putc uchar 10
  put vsem_visited idx 1
  vsem_collect_deps idx sh depth
  c = get vsem_dl_cnt depth
  base = mul depth VSEM_MAX_DEPS
  for i ulong c bound 72
    ib = mul add base i 32
    for k ulong 32
      put v_tmp_id k get vsem_dl_ids add ib k
    end
    rc = vsem_graph_rec add depth 1
    if ne rc 0
      ret rc
    end
  end
  ret 0
end

note visor_semantic_graph_text for the root id in v_tmp_id; n is the C buffer size.
fn vsem_graph_text_tmp n ulong to long
  ob_reset 0
  if eq n 0
    ret -1
  end
  if lt og_find_by_tmp 0
    ret -1
  end
  for i ulong 256
    put vsem_visited i 0
  end
  ob_reset sub n 1
  rc = vsem_graph_rec 0
  if ne rc 0
    put v_ob_len 0 0
    ret -1
  end
  ret vsem_finish
end

fn vsem_graph_text root ulong n ulong to long
  og_tmp_from_obj root
  ret vsem_graph_text_tmp n
end

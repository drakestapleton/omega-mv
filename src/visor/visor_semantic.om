note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor lane 1: read-only semantic inspection API
note (replaces src/visor/visor_semantic.c). Depends on visor.om and omega_lower.om.

text vsem_s_type "TYPE"
text vsem_s_value "VALUE"
text vsem_s_op "OPERATION"
text vsem_s_apply "APPLY"
text vsem_s_opaque "OPAQUE"
text vsem_op_add "ADD"
text vsem_op_sub "SUB"
text vsem_op_mul "MUL"
text vsem_op_div "DIV"
text vsem_op_and "AND"
text vsem_op_or "OR"
text vsem_op_xor "XOR"
text vsem_op_unk "UNKNOWN"
text vsem_ov_def "DEFAULT"
text vsem_ov_wrap "WRAP"
text vsem_ov_sat "SATURATE"
text vsem_ov_fc "FAIL_CLOSED"
text vsem_t_bool "bool"
text vsem_t_u "u"
text vsem_t_bv1 "bitvector<"
text vsem_t_bv2 ">"
text vsem_t_seq1 "seq<"
text vsem_t_seq2 ","
text vsem_m_kind "invalid kind"
text vsem_m_plen "invalid payload_len"
text vsem_m_ovf "invalid overflow policy"
text vsem_m_id "stored id does not match canonical digest"
text vsem_m_miss "MISSING sha256:"
text vsem_f_id "id: "
text vsem_f_kind "kind: "
text vsem_f_malf1 "status: MALFORMED ("
text vsem_f_malf2 ")\n"
text vsem_f_sh "shape: "
text vsem_f_ty "type: "
text vsem_f_tag "tag: "
text vsem_f_wid "width: "
text vsem_f_val "value: "
text vsem_f_true "true"
text vsem_f_false "false"
text vsem_f_opc "opcode: "
text vsem_f_ovf "overflow: "
text vsem_f_ops "operands: "
text vsem_f_d1 "dangling: "
text vsem_f_d2 " (DANGLING)\n"
text vsem_j1 "{\"id\":\""
text vsem_j2 "\",\"kind\":\""
text vsem_j3 "\",\"status\":\""
text vsem_j4 "malformed\"}"
text vsem_j5 "ok\",\"shape\":\""
text vsem_j6 "\",\"canonical_len\":"
text vsem_j7 "}"
text vsem_sp2 "  "
text vsem_sha_sp " sha256:"

global vsem_status long 1
global vsem_oidx ulong 1
global vsem_shape ulong 1
global vsem_canon_len ulong 1
global vsem_id_match ulong 1
global vsem_dangling ulong 1
global vsem_reason uchar 128
global vsem_rlen ulong 1
global vsem_seen uchar 256

fn vsem_set_reason s view uchar * to void
  n = len s
  if gt n 127
    n = 127
  end
  for i ulong n bound 128
    put vsem_reason i get s i
  end
  put vsem_rlen 0 n
end

fn vsem_put_opcode opc ulong to void
  if eq opc V_OP_ADD
    ob_puts vsem_op_add
    ret
  end
  if eq opc V_OP_SUB
    ob_puts vsem_op_sub
    ret
  end
  if eq opc V_OP_MUL
    ob_puts vsem_op_mul
    ret
  end
  if eq opc V_OP_DIV
    ob_puts vsem_op_div
    ret
  end
  if eq opc V_OP_AND
    ob_puts vsem_op_and
    ret
  end
  if eq opc V_OP_OR
    ob_puts vsem_op_or
    ret
  end
  if eq opc V_OP_XOR
    ob_puts vsem_op_xor
    ret
  end
  ob_puts vsem_op_unk
end

fn vsem_put_ovf ovf ulong to void
  if eq ovf V_OVF_DEFAULT
    ob_puts vsem_ov_def
    ret
  end
  if eq ovf V_OVF_WRAP
    ob_puts vsem_ov_wrap
    ret
  end
  if eq ovf V_OVF_SATURATE
    ob_puts vsem_ov_sat
    ret
  end
  if eq ovf V_OVF_FAIL_CLOSED
    ob_puts vsem_ov_fc
    ret
  end
  ob_puts vsem_op_unk
end

fn vsem_put_shape sh ulong to void
  if eq sh 1
    ob_puts vsem_s_type
    ret
  end
  if eq sh 2
    ob_puts vsem_s_value
    ret
  end
  if eq sh 3
    ob_puts vsem_s_op
    ret
  end
  if eq sh 4
    ob_puts vsem_s_apply
    ret
  end
  ob_puts vsem_s_opaque
end

fn vsem_put_type_str tidx ulong to void
  pb = mul tidx V_MAX_PAYLOAD
  tag = v_dec_u32le_pay pb 0
  wid = v_dec_u16le_pay pb 4
  slen = v_dec_u32le_pay pb 8
  if eq tag V_TY_BOOL
    ob_puts vsem_t_bool
    ret
  end
  if eq tag V_TY_UINT
    ob_puts vsem_t_u
    ob_put_u64 wid
    ret
  end
  if eq tag V_TY_BITVEC
    ob_puts vsem_t_bv1
    ob_put_u64 wid
    ob_puts vsem_t_bv2
    ret
  end
  if eq tag V_TY_SEQ
    ob_puts vsem_t_seq1
    for i ulong 32
      put v_tmp_id i get v_og_pay add add pb 12 i
    end
    ei = og_find_by_tmp
    if ge ei 0
      vsem_put_type_str ulong ei
    else
      ob_puts vsem_op_unk
    end
    ob_puts vsem_t_seq2
    ob_put_u64 slen
    ob_puts vsem_t_bv2
    ret
  end
  ob_puts vsem_op_unk
end

fn vsem_count_dangling idx ulong to void
  rc = get v_og_rcnt idx
  for r ulong rc bound 4
    rslot = add mul idx V_MAX_RELS r
    tb = mul rslot 32
    for i ulong 32
      put v_tmp_id i get v_og_rtgt add tb i
    end
    if lt og_find_by_tmp 0
      put vsem_dangling 0 add get vsem_dangling 0 1
    end
  end
end

fn vsem_inspect idx ulong to long
  cnt = get v_og_cnt 0
  if ge idx cnt
    ret -1
  end
  put vsem_oidx 0 idx
  put vsem_status 0 0
  put vsem_rlen 0 0
  put vsem_dangling 0 0
  kind = get v_og_kind idx
  pl = get v_og_plen idx
  if or eq kind 0 gt kind 6
    put vsem_status 0 -2
    vsem_set_reason vsem_m_kind
    ret -2
  end
  if gt pl V_MAX_PAYLOAD
    put vsem_status 0 -2
    vsem_set_reason vsem_m_plen
    ret -2
  end
  elen = og_canonical_encode idx
  if lt elen 0
    put vsem_status 0 -2
    vsem_set_reason vsem_m_plen
    ret -2
  end
  put vsem_canon_len 0 ulong elen
  for i ulong ulong elen bound 4096
    put v_sha_in i get v_enc i
  end
  sha256_hash ulong elen
  if og_id_eq_sha idx
    put vsem_id_match 0 1
  else
    put vsem_id_match 0 0
    put vsem_status 0 -2
    vsem_set_reason vsem_m_id
    ret -2
  end
  pb = mul idx V_MAX_PAYLOAD
  if eq kind V_KIND_TYPE
    if lt pl 44
      put vsem_status 0 -2
      vsem_set_reason vsem_m_plen
      ret -2
    end
    put vsem_shape 0 1
  else
    if eq kind V_KIND_VALUE
      if lt pl 98
        put vsem_status 0 -2
        vsem_set_reason vsem_m_plen
        ret -2
      end
      put vsem_shape 0 2
    else
      if eq kind V_KIND_OP
        if ge pl 204
          ovf = v_dec_u32le_pay pb 4
          if eq ovf V_OVF_DEFAULT
            put vsem_status 0 -2
            vsem_set_reason vsem_m_ovf
            ret -2
          end
          put vsem_shape 0 3
        else
          if ge pl 161
            put vsem_shape 0 4
          else
            put vsem_status 0 -2
            vsem_set_reason vsem_m_plen
            ret -2
          end
        end
      else
        put vsem_shape 0 5
      end
    end
  end
  vsem_count_dangling idx
  ret 0
end

fn vsem_format_text cap ulong to long
  ob_reset cap
  idx = get vsem_oidx 0
  ob_puts vsem_f_id
  ob_puts vt_sha256_pfx
  ob_put_hex_id32 mul idx 32 1
  ob_putc uchar 10
  ob_puts vsem_f_kind
  v_put_kind_name get v_og_kind idx
  ob_putc uchar 10
  if ne get vsem_status 0 0
    ob_puts vsem_f_malf1
    rl = get vsem_rlen 0
    for i ulong rl bound 128
      ob_putc get vsem_reason i
    end
    ob_puts vsem_f_malf2
  else
    ob_puts vsem_f_sh
    sh = get vsem_shape 0
    vsem_put_shape sh
    ob_putc uchar 10
    pb = mul idx V_MAX_PAYLOAD
    if eq sh 1
      ob_puts vsem_f_ty
      vsem_put_type_str idx
      ob_putc uchar 10
      ob_puts vsem_f_tag
      ob_put_u64 v_dec_u32le_pay pb 0
      ob_putc uchar 10
      ob_puts vsem_f_wid
      ob_put_u64 v_dec_u16le_pay pb 4
      ob_putc uchar 10
    end
    if eq sh 2
      ev = olw_eval_obj_u64 idx 0
      if eq ev 0
        ob_puts vsem_f_val
        if ne get olw_val_is_bool 0 0
          if ne get olw_val_out 0 0
            ob_puts vsem_f_true
          else
            ob_puts vsem_f_false
          end
        else
          ob_put_u64 get olw_val_out 0
        end
        ob_putc uchar 10
      end
    end
    if eq sh 3
      ob_puts vsem_f_opc
      vsem_put_opcode v_dec_u32le_pay pb 0
      ob_putc uchar 10
      ob_puts vsem_f_ovf
      vsem_put_ovf v_dec_u32le_pay pb 4
      ob_putc uchar 10
    end
    if eq sh 4
      ob_puts vsem_f_ops
      ob_put_u64 ulong get v_og_pay add pb 32
      ob_putc uchar 10
    end
    if gt get vsem_dangling 0 0
      ob_puts vsem_f_d1
      ob_put_u64 get vsem_dangling 0
      ob_puts vsem_f_d2
    end
  end
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vsem_format_json cap ulong to long
  ob_reset cap
  idx = get vsem_oidx 0
  ob_puts vsem_j1
  ob_puts vt_sha256_pfx
  ob_put_hex_id32 mul idx 32 1
  ob_puts vsem_j2
  v_put_kind_name get v_og_kind idx
  ob_puts vsem_j3
  if ne get vsem_status 0 0
    ob_puts vsem_j4
  else
    ob_puts vsem_j5
    vsem_put_shape get vsem_shape 0
    ob_puts vsem_j6
    ob_put_u64 get vsem_canon_len 0
    ob_puts vsem_j7
  end
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

fn vsem_graph_dfs idx ulong depth ulong to void
  if gt depth 16
    ret
  end
  if ne get vsem_seen idx uchar 0
    ret
  end
  put vsem_seen idx uchar 1
  for d ulong depth bound 16
    ob_puts vsem_sp2
  end
  v_put_kind_name get v_og_kind idx
  ob_puts vsem_sha_sp
  ob_put_hex_id32 mul idx 32 1
  ob_putc uchar 10
  rc = get v_og_rcnt idx
  for r ulong rc bound 4
    rslot = add mul idx V_MAX_RELS r
    tb = mul rslot 32
    for i ulong 32
      put v_tmp_id i get v_og_rtgt add tb i
    end
    ti = og_find_by_tmp
    if ge ti 0
      vsem_graph_dfs ulong ti add depth 1
    else
      for d ulong add depth 1 bound 17
        ob_puts vsem_sp2
      end
      ob_puts vsem_m_miss
      ob_put_hex_id32 0 0
      ob_putc uchar 10
    end
  end
  k = get v_og_kind idx
  pb = mul idx V_MAX_PAYLOAD
  if eq k V_KIND_VALUE
    for i ulong 32
      put v_tmp_id i get v_og_pay add pb i
    end
    ti = og_find_by_tmp
    if ge ti 0
      vsem_graph_dfs ulong ti add depth 1
    end
  end
  if and eq k V_KIND_OP eq get v_og_plen idx 161
    for i ulong 32
      put v_tmp_id i get v_og_pay add pb i
    end
    oi = og_find_by_tmp
    if ge oi 0
      vsem_graph_dfs ulong oi add depth 1
    end
    for i ulong 32
      put v_tmp_id i get v_og_pay add add pb 33 i
    end
    a1 = og_find_by_tmp
    if ge a1 0
      vsem_graph_dfs ulong a1 add depth 1
    end
    for i ulong 32
      put v_tmp_id i get v_og_pay add add pb 65 i
    end
    a2 = og_find_by_tmp
    if ge a2 0
      vsem_graph_dfs ulong a2 add depth 1
    end
  end
end

fn vsem_graph_text root ulong cap ulong to long
  if ge root get v_og_cnt 0
    ret -1
  end
  for i ulong 256
    put vsem_seen i uchar 0
  end
  ob_reset cap
  vsem_graph_dfs root 0
  if ne get v_ob_ovf 0 0
    ret -1
  end
  ret long get v_ob_len 0
end

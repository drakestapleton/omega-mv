note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 Visor lane 2: console command parser
note (replaces src/visor/visor_parse_command.c). Depends on visor.om.

note Command codes:
note 0=help 1=quit 2=inspect 3=type 4=id 5=graph 6=verify 7=machine 8=realize
note 9=cost 10=run 11=evidence 12=bindings 13=clear 14=world 15=effects
note 16=alternatives 17=compare 18=why 19=source 20=empty 21=unknown

text vpc_c_help "help"
text vpc_c_quit "quit"
text vpc_c_inspect "inspect"
text vpc_c_type "type"
text vpc_c_id "id"
text vpc_c_graph "graph"
text vpc_c_verify "verify"
text vpc_c_machine "machine"
text vpc_c_realize "realize"
text vpc_c_cost "cost"
text vpc_c_run "run"
text vpc_c_evidence "evidence"
text vpc_c_bindings "bindings"
text vpc_c_clear "clear"
text vpc_c_world "world"
text vpc_c_effects "effects"
text vpc_c_alt "alternatives"
text vpc_c_cmp "compare"
text vpc_c_why "why"
text vpc_c_source "source"
text vpc_c_empty "empty"
text vpc_c_unk "unknown"
text vpc_w_for "for"
text vpc_w_cur "current.machine"
text vpc_e_long "line too long"
text vpc_e_ctrl "control character is not allowed"
text vpc_e_utf8 "invalid UTF-8 sequence"
text vpc_e_tok "argument too long"
text vpc_e_arity "wrong number of arguments"
text vpc_e_real "realize only accepts 'for current.machine'"

global vpc_cmd ulong 1
global vpc_argc ulong 1
global vpc_args uchar 1024
global vpc_alen ulong 4
global vpc_for_cur ulong 1
global vpc_line uchar 4096
global vpc_llen ulong 1
global vpc_err uchar 256
global vpc_elen ulong 1
global vpc_tok0 uchar 256
global vpc_t0len ulong 1

fn vpc_set_err s view uchar * to void
  n = len s
  if gt n 255
    n = 255
  end
  for i ulong n bound 256
    put vpc_err i get s i
  end
  put vpc_elen 0 n
end

fn vpc_utf8_step_sbuf n ulong pos ulong to ulong
  b = ulong get v_sbuf pos
  clen = ulong 0
  cp0 = ulong 0
  cmin = ulong 0
  if eq and b 0xe0 0xc0
    clen = 2
    cp0 = and b 0x1f
    cmin = 0x80
  else
    if eq and b 0xf0 0xe0
      clen = 3
      cp0 = and b 0x0f
      cmin = 0x800
    else
      if eq and b 0xf8 0xf0
        clen = 4
        cp0 = and b 0x07
        cmin = 0x10000
      else
        ret 0
      end
    end
  end
  if gt add pos clen n
    ret 0
  end
  cp = cp0
  k = ulong 1
  while lt k clen bound 4
    c = ulong get v_sbuf add pos k
    if ne and c 0xc0 0x80
      ret 0
    end
    cp = or shl cp 6 and c 0x3f
    k = add k 1
  end
  if or lt cp cmin gt cp 0x10ffff
    ret 0
  end
  if and ge cp 0xd800 le cp 0xdfff
    ret 0
  end
  ret clen
end

fn vpc_check_bytes_sbuf n ulong to ulong
  i = ulong 0
  while lt i n bound 4096
    b = ulong get v_sbuf i
    if lt b 0x80
      if and lt b 0x20 ne b 9
        ret 1
      end
      if eq b 0x7f
        ret 1
      end
      i = add i 1
    else
      adv = vpc_utf8_step_sbuf n i
      if eq adv 0
        ret 2
      end
      i = add i adv
    end
  end
  ret 0
end

fn vpc_eq_tok0 s view uchar * to bool
  n = len s
  if ne get vpc_t0len 0 n
    ret false
  end
  for i ulong n bound 64
    if ne get vpc_tok0 i get s i
      ret false
    end
  end
  ret true
end

fn vpc_eq_arg idx ulong s view uchar * to bool
  n = len s
  if ne get vpc_alen idx n
    ret false
  end
  base = mul idx 256
  for i ulong n bound 64
    if ne get vpc_args add base i get s i
      ret false
    end
  end
  ret true
end

fn vpc_lookup_cmd to ulong
  if vpc_eq_tok0 vpc_c_help
    ret 0
  end
  if vpc_eq_tok0 vpc_c_quit
    ret 1
  end
  if vpc_eq_tok0 vpc_c_inspect
    ret 2
  end
  if vpc_eq_tok0 vpc_c_type
    ret 3
  end
  if vpc_eq_tok0 vpc_c_id
    ret 4
  end
  if vpc_eq_tok0 vpc_c_graph
    ret 5
  end
  if vpc_eq_tok0 vpc_c_verify
    ret 6
  end
  if vpc_eq_tok0 vpc_c_machine
    ret 7
  end
  if vpc_eq_tok0 vpc_c_realize
    ret 8
  end
  if vpc_eq_tok0 vpc_c_cost
    ret 9
  end
  if vpc_eq_tok0 vpc_c_run
    ret 10
  end
  if vpc_eq_tok0 vpc_c_evidence
    ret 11
  end
  if vpc_eq_tok0 vpc_c_bindings
    ret 12
  end
  if vpc_eq_tok0 vpc_c_clear
    ret 13
  end
  if vpc_eq_tok0 vpc_c_world
    ret 14
  end
  if vpc_eq_tok0 vpc_c_effects
    ret 15
  end
  if vpc_eq_tok0 vpc_c_alt
    ret 16
  end
  if vpc_eq_tok0 vpc_c_cmp
    ret 17
  end
  if vpc_eq_tok0 vpc_c_why
    ret 18
  end
  ret 19
end

fn vpc_arity_ok cmd ulong ac ulong to bool
  if or eq cmd 0 or eq cmd 11 or eq cmd 14 eq cmd 15
    ret le ac 1
  end
  if or eq cmd 1 or eq cmd 7 or eq cmd 12 eq cmd 13
    ret eq ac 0
  end
  if eq cmd 10
    ret and ge ac 1 le ac 4
  end
  if eq cmd 17
    ret eq ac 2
  end
  if lt cmd 19
    ret eq ac 1
  end
  ret true
end

fn vpc_parse_sbuf rlen ulong to long
  put vpc_cmd 0 21
  put vpc_argc 0 0
  put vpc_for_cur 0 0
  put vpc_llen 0 0
  put vpc_elen 0 0
  n = rlen
  if gt n 0
    if eq get v_sbuf sub n 1 uchar 10
      n = sub n 1
    end
  end
  if gt n 0
    if eq get v_sbuf sub n 1 uchar 13
      n = sub n 1
    end
  end
  if gt n 4095
    vpc_set_err vpc_e_long
    ret -1
  end
  chk = vpc_check_bytes_sbuf n
  if eq chk 1
    vpc_set_err vpc_e_ctrl
    ret -1
  end
  if eq chk 2
    vpc_set_err vpc_e_utf8
    ret -1
  end
  a = ulong 0
  b = n
  while lt a b bound 4096
    c = ulong get v_sbuf a
    if or eq c 32 eq c 9
      a = add a 1
    else
      break
    end
  end
  while gt b a bound 4096
    c = ulong get v_sbuf sub b 1
    if or eq c 32 eq c 9
      b = sub b 1
    else
      break
    end
  end
  tlen = sub b a
  for i ulong tlen bound 4096
    put vpc_line i get v_sbuf add a i
  end
  put vpc_llen 0 tlen
  if eq tlen 0
    put vpc_cmd 0 20
    ret 0
  end
  if eq get vpc_line 0 uchar 35
    put vpc_cmd 0 20
    ret 0
  end
  note Extract first word
  p = ulong 0
  while lt p tlen bound 256
    c = ulong get vpc_line p
    if or eq c 32 eq c 9
      break
    end
    put vpc_tok0 p uchar c
    p = add p 1
  end
  put vpc_t0len 0 p
  cmd = vpc_lookup_cmd
  if eq cmd 19
    put vpc_cmd 0 19
    ret 0
  end
  put vpc_cmd 0 cmd
  ac = ulong 0
  while lt p tlen bound 4096
    while lt p tlen bound 4096
      c = ulong get vpc_line p
      if or eq c 32 eq c 9
        p = add p 1
      else
        break
      end
    end
    if ge p tlen
      break
    end
    if ge ac 4
      vpc_set_err vpc_e_arity
      ret -1
    end
    start = p
    while lt p tlen bound 4096
      c = ulong get vpc_line p
      if or eq c 32 eq c 9
        break
      end
      p = add p 1
    end
    al = sub p start
    if gt al 255
      vpc_set_err vpc_e_tok
      ret -1
    end
    vpc_store_arg ac start al
    ac = add ac 1
  end
  if and eq cmd 8 eq ac 3
    if and vpc_eq_arg 1 vpc_w_for vpc_eq_arg 2 vpc_w_cur
      put vpc_for_cur 0 1
      ac = 1
    else
      vpc_set_err vpc_e_real
      ret -1
    end
  end
  put vpc_argc 0 ac
  if not vpc_arity_ok cmd ac
    vpc_set_err vpc_e_arity
    ret -1
  end
  ret 0
end

fn vpc_store_arg ac ulong start ulong al ulong to void
  base = mul ac 256
  for i ulong al bound 256
    put vpc_args add base i get vpc_line add start i
  end
  put vpc_alen ac al
end

fn vpc_put_cmd_name cmd ulong to void
  if eq cmd 0
    ob_puts vpc_c_help
    ret
  end
  if eq cmd 1
    ob_puts vpc_c_quit
    ret
  end
  if eq cmd 2
    ob_puts vpc_c_inspect
    ret
  end
  if eq cmd 3
    ob_puts vpc_c_type
    ret
  end
  if eq cmd 4
    ob_puts vpc_c_id
    ret
  end
  if eq cmd 5
    ob_puts vpc_c_graph
    ret
  end
  if eq cmd 6
    ob_puts vpc_c_verify
    ret
  end
  if eq cmd 7
    ob_puts vpc_c_machine
    ret
  end
  if eq cmd 8
    ob_puts vpc_c_realize
    ret
  end
  if eq cmd 9
    ob_puts vpc_c_cost
    ret
  end
  if eq cmd 10
    ob_puts vpc_c_run
    ret
  end
  if eq cmd 11
    ob_puts vpc_c_evidence
    ret
  end
  if eq cmd 12
    ob_puts vpc_c_bindings
    ret
  end
  if eq cmd 13
    ob_puts vpc_c_clear
    ret
  end
  if eq cmd 14
    ob_puts vpc_c_world
    ret
  end
  if eq cmd 15
    ob_puts vpc_c_effects
    ret
  end
  if eq cmd 16
    ob_puts vpc_c_alt
    ret
  end
  if eq cmd 17
    ob_puts vpc_c_cmp
    ret
  end
  if eq cmd 18
    ob_puts vpc_c_why
    ret
  end
  if eq cmd 19
    ob_puts vpc_c_source
    ret
  end
  if eq cmd 20
    ob_puts vpc_c_empty
    ret
  end
  ob_puts vpc_c_unk
end

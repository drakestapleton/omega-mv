note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/visor/visor_parse_command.c:
note RFC 3629 UTF-8 + control-character validator, blank trimming, and command
note arity lookup.
om2

fn v_utf8_cont p view uchar * pos ulong clen ulong cp0 ulong to ulong
  cp = cp0
  k = ulong 1
  while lt k clen
    b = ulong get p add pos k
    if ne and b 0xc0 0x80
      ret 0xffffffff
    end
    cp = or shl cp 6 and b 0x3f
    k = add k 1
  end
  ret cp
end

fn v_utf8_step p view uchar * n ulong pos ulong to ulong
  b = ulong get p pos
  clen = ulong 0
  cp0 = ulong 0
  cmin = ulong 0
  if eq and b 0xe0 0xc0
    clen = 2
    cp0 = and b 0x1f
    cmin = 0x80
  else
    if eq and b 0xf0 0xe0
      clen = 3
      cp0 = and b 0x0f
      cmin = 0x800
    else
      if eq and b 0xf8 0xf0
        clen = 4
        cp0 = and b 0x07
        cmin = 0x10000
      else
        ret 0
      end
    end
  end
  if gt add pos clen n
    ret 0
  end
  cp = v_utf8_cont p pos clen cp0
  if eq cp 0xffffffff
    ret 0
  end
  if or lt cp cmin gt cp 0x10ffff
    ret 0
  end
  if and ge cp 0xd800 le cp 0xdfff
    ret 0
  end
  ret clen
end

export fn visor_om_check_bytes p view uchar * n ulong dst edit ulong 2 to ulong
  i = ulong 0
  while lt i n
    b = ulong get p i
    if lt b 0x80
      if and lt b 0x20 ne b 9
        put dst 0 b
        put dst 1 i
        ret 1
      end
      if eq b 0x7f
        put dst 0 b
        put dst 1 i
        ret 1
      end
      i = add i 1
    else
      adv = v_utf8_step p n i
      if eq adv 0
        put dst 0 0
        put dst 1 i
        ret 2
      end
      i = add i adv
    end
  end
  put dst 0 0
  put dst 1 0
  ret 0
end

export fn visor_om_trim_blanks p view uchar * n ulong dst edit ulong 2 to void
  a = ulong 0
  b = n
  while lt a b
    c = ulong get p a
    if or eq c 32 eq c 9
      a = add a 1
    else
      break
    end
  end
  while gt b a
    c = ulong get p sub b 1
    if or eq c 32 eq c 9
      b = sub b 1
    else
      break
    end
  end
  put dst 0 a
  put dst 1 b
end

export fn visor_om_cmd_arity cmd ulong dst edit ulong 2 to ulong
  if or eq cmd 0 or eq cmd 11 or eq cmd 14 eq cmd 15
    put dst 0 0
    put dst 1 1
    ret 1
  end
  if or eq cmd 1 or eq cmd 7 or eq cmd 12 eq cmd 13
    put dst 0 0
    put dst 1 0
    ret 1
  end
  if eq cmd 10
    put dst 0 1
    put dst 1 4
    ret 1
  end
  if eq cmd 17
    put dst 0 2
    put dst 1 2
    ret 1
  end
  if lt cmd 19
    put dst 0 1
    put dst 1 1
    ret 1
  end
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 PATH-1 validation, comparison, and canonical big-endian
note header/step wire codecs backing src/path/rx_path.c.
om2

const rxp_err_step_limit long -80
const rxp_err_input_limit long -81
const rxp_err_output_limit long -82
const rxp_err_param_limit long -83
const rxp_err_attr_limit long -84
const rxp_err_malformed long -87

fn rxp_role_cap family ulong to ulong
  if eq family 1
    ret 4
  end
  if eq family 2
    ret 4
  end
  if eq family 3
    ret 7
  end
  if eq family 4
    ret 7
  end
  if eq family 5
    ret 6
  end
  ret 0
end

export fn rxp_valid_role family ulong role ulong to ulong
  cap = rxp_role_cap family
  if eq cap 0
    ret 0
  end
  if ne shr role 8 family
    ret 0
  end
  lo = and role 255
  if or lt lo 1 gt lo cap
    ret 0
  end
  ret 1
end

export fn rxp_check_step family ulong role ulong n_in ulong n_out ulong plen ulong to long
  if eq rxp_valid_role family role 0
    ret rxp_err_malformed
  end
  if gt n_in 8
    ret rxp_err_input_limit
  end
  if gt n_out 8
    ret rxp_err_output_limit
  end
  if gt plen 1024
    ret rxp_err_param_limit
  end
  ret 0
end

export fn rxp_step_size n_in ulong n_out ulong plen ulong to ulong
  ret add add add 46 mul 32 n_in mul 32 n_out plen
end

export fn rxp_bytes_cmp a view uchar * b view uchar * to long
  n = len a
  if lt len b n
    n = len b
  end
  for i ulong n
    xa = ulong get a i
    xb = ulong get b i
    if lt xa xb
      ret -1
    end
    if gt xa xb
      ret 1
    end
  end
  if lt len a len b
    ret -1
  end
  if gt len a len b
    ret 1
  end
  ret 0
end

fn rxp_put16_be buf edit uchar * off ulong v ulong to void
  put buf off uchar and shr v 8 255
  put buf add off 1 uchar and v 255
end

fn rxp_get16_be buf view uchar * off ulong to ulong
  ret or shl ulong get buf off 8 ulong get buf add off 1
end

export fn rxp_encode_header count ulong attr_count ulong ids view uchar 96 out_hdr out uchar 106 to void
  put out_hdr 0 79
  put out_hdr 1 77
  put out_hdr 2 71
  put out_hdr 3 48
  put out_hdr 4 1
  put out_hdr 5 12
  rxp_put16_be out_hdr 6 count
  for i ulong 96
    put out_hdr add 8 i get ids i
  end
  rxp_put16_be out_hdr 104 attr_count
end

export fn rxp_decode_header in_hdr view uchar 106 counts edit ulong 2 ids out uchar 96 to long
  if or ne get in_hdr 0 79 ne get in_hdr 1 77
    ret rxp_err_malformed
  end
  if or ne get in_hdr 2 71 ne get in_hdr 3 48
    ret rxp_err_malformed
  end
  if or ne get in_hdr 4 1 ne get in_hdr 5 12
    ret rxp_err_malformed
  end
  count = rxp_get16_be in_hdr 6
  if gt count 512
    ret rxp_err_step_limit
  end
  for i ulong 96
    put ids i get in_hdr add 8 i
  end
  acount = rxp_get16_be in_hdr 104
  if gt acount 32
    ret rxp_err_attr_limit
  end
  put counts 0 count
  put counts 1 acount
  ret 0
end

export fn rxp_encode_step_head idx ulong family ulong role ulong in_cnt ulong out_buf out uchar 8 to void
  rxp_put16_be out_buf 0 idx
  rxp_put16_be out_buf 2 family
  rxp_put16_be out_buf 4 role
  rxp_put16_be out_buf 6 in_cnt
end

export fn rxp_decode_step_head in_buf view uchar 8 expect_idx ulong fields edit ulong 3 to long
  idx = rxp_get16_be in_buf 0
  if ne idx expect_idx
    ret rxp_err_malformed
  end
  family = rxp_get16_be in_buf 2
  role = rxp_get16_be in_buf 4
  if eq rxp_valid_role family role 0
    ret rxp_err_malformed
  end
  in_cnt = rxp_get16_be in_buf 6
  if gt in_cnt 8
    ret rxp_err_input_limit
  end
  put fields 0 family
  put fields 1 role
  put fields 2 in_cnt
  ret 0
end

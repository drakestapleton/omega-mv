note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_blackwell_codegen_tc.c.
note Composes on om/gpu/cg_tc.om and om/gpu/bw_regalloc.om.
om2

fn tc_om_touch_vreg vinfo edit long 768 r64 ulong pos long is_def ulong nv ulong to void
  if ge r64 nv
    ret
  end
  base = mul r64 3
  fd = get vinfo base
  lu = get vinfo add base 1
  if and ne is_def 0 lt fd 0
    put vinfo base pos
  end
  if gt pos lu
    put vinfo add base 1 pos
  end
end

fn tc_om_build_vinfo ins view ulong 8192 meta view ulong 512 vinfo edit long 768 to void
  n = get meta 0
  nv = get meta 1
  nl = get meta 3
  for v ulong nv bound 256
    base = mul v 3
    put vinfo base -1
    put vinfo add base 1 -1
    put vinfo add base 2 long get meta add 64 v
  end
  for i ulong n bound 1024
    off = mul i 8
    flags = get ins add off 7
    if eq and flags 1 0
      pos = long i
      tc_om_touch_vreg vinfo get ins add off 1 pos 1 nv
      tc_om_touch_vreg vinfo get ins add off 2 pos 0 nv
      tc_om_touch_vreg vinfo get ins add off 3 pos 0 nv
      tc_om_touch_vreg vinfo get ins add off 4 pos 0 nv
    end
  end
  for l ulong nl bound 16
    ls = long get meta add 320 mul l 2
    le_idx = long get meta add 321 mul l 2
    for v ulong nv bound 256
      base = mul v 3
      fd = get vinfo base
      lu = get vinfo add base 1
      if ge fd 0
        if lt fd ls
          if ge lu ls
            if lt lu le_idx
              put vinfo add base 1 le_idx
            end
          end
        end
      end
    end
  end
end

fn tc_om_solve ins view ulong 8192 meta view ulong 512 out_stats edit uint 2 to long
  n = get meta 0
  nv = get meta 1
  nu = get meta 2
  nl = get meta 3
  if or eq n 0 gt n 1024
    ret -1
  end
  if gt nv 256
    ret -1
  end
  if gt nu 32
    ret -1
  end
  if gt nl 16
    ret -1
  end
  vinfo = new long 768 0
  tc_om_build_vinfo ins meta vinfo
  uinfo = new ulong 32 0
  for u ulong nu bound 32
    put uinfo u get meta add 352 u
  end
  cfg = new ulong 4 0
  put cfg 0 nv
  put cfg 1 nu
  put cfg 2 0
  res = new long 290 0
  if ne bw_regalloc_solve cfg vinfo uinfo res 0
    ret -1
  end
  put out_stats 0 uint n
  put out_stats 1 uint get res 288
  ret 0
end

fn omega_blackwell_codegen_tc_probe_prog mutant ulong ins edit ulong 8192 meta edit ulong 512 to long
  for i ulong 8192
    put ins i 0
  end
  for i ulong 512
    put meta i 0
  end
  sp = new ulong 4 0
  put sp 0 mutant
  if ne cg_tc_probe_emit sp ins meta 0
    ret -1
  end
  if or ne get meta 5 0 eq get meta 0 0
    ret -1
  end
  stats = new uint 2 0
  if ne tc_om_solve ins meta stats 0
    ret -1
  end
  ret 0
end

fn omega_tcgemm_spec_ok sp view ulong 8 to long
  if ne cg_tcgemm_spec_ok sp 0
    ret 1
  end
  ret 0
end

fn omega_tcgemm_shared_bytes sp view ulong 8 to uint
  if eq omega_tcgemm_spec_ok sp 0
    ret 0
  end
  ret uint mul mul 32 get sp 1 128
end

fn omega_tcgemm_span sp view ulong 8 to uint
  if eq omega_tcgemm_spec_ok sp 0
    ret 0
  end
  ret uint mul mul get sp 3 8 get sp 2
end

fn tc_bf16_rne f f32 to ushort
  u = bitcast uint f
  if gt and u uint 0x7fffffff uint 0x7f800000
    ret ushort and or shr u 16 0x40 0xffff
  end
  u = add u add uint 0x7fff and shr u 16 1
  ret ushort shr u 16
end

fn omega_tcgemm_permute_x x view f32 * k ulong dst edit ushort * to void
  scale = bitcast f32 uint 0x5f800000
  q = ulong 0
  while le add q 4 k bound 32768
    put dst q tc_bf16_rne mul get x q scale
    put dst add q 1 tc_bf16_rne mul get x add q 2 scale
    put dst add q 2 tc_bf16_rne mul get x add q 1 scale
    put dst add q 3 tc_bf16_rne mul get x add q 3 scale
    q = add q 4
  end
end

fn omega_tcgemm_w_bf16 c uchar to ushort
  cu = uint c
  lo = shl and cu 0x7f 4
  hi = shl and cu 0x80 8
  ret ushort or lo hi
end

fn omega_blackwell_codegen_tcgemm_prog sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to long
  for i ulong 8192
    put ins i 0
  end
  for i ulong 512
    put meta i 0
  end
  if ne cg_tcgemm_emit sp ins meta 0
    ret -1
  end
  if or ne get meta 5 0 eq get meta 0 0
    ret -1
  end
  stats = new uint 2 0
  if ne tc_om_solve ins meta stats 0
    ret -1
  end
  ret 0
end

fn omega_blackwell_codegen_tc_peak_prog iters ulong chains ulong stall ulong threads ulong ins edit ulong 8192 meta edit ulong 512 to long
  for i ulong 8192
    put ins i 0
  end
  for i ulong 512
    put meta i 0
  end
  sp = new ulong 4 0
  put sp 0 iters
  put sp 1 chains
  put sp 2 stall
  put sp 3 threads
  if ne cg_tc_peak_emit sp ins meta 0
    ret -1
  end
  if or ne get meta 5 0 eq get meta 0 0
    ret -1
  end
  stats = new uint 2 0
  if ne tc_om_solve ins meta stats 0
    ret -1
  end
  ret 0
end

fn omega_blackwell_codegen_tc_bw_prog iters ulong groups ulong threads ulong ins edit ulong 8192 meta edit ulong 512 to long
  for i ulong 8192
    put ins i 0
  end
  for i ulong 512
    put meta i 0
  end
  sp = new ulong 4 0
  put sp 0 iters
  put sp 1 groups
  put sp 2 threads
  if ne cg_tc_bw_emit sp ins meta 0
    ret -1
  end
  if or ne get meta 5 0 eq get meta 0 0
    ret -1
  end
  stats = new uint 2 0
  if ne tc_om_solve ins meta stats 0
    ret -1
  end
  ret 0
end

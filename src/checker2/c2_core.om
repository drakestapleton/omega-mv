note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 core logic backing src/checker2/ (c2_receipt.c, c2_lrat.c):
note canonical LE u16/u64 codecs, strictly-ascending 32-byte dependency digest
note check, and DIMACS/LRAT whitespace/comment skipper + signed integer reader.
om2

export fn c2_om_put16 dst edit uchar * pos ulong v ulong to void
  put dst pos uchar and v 255
  put dst add pos 1 uchar and shr v 8 255
end

export fn c2_om_put64 dst edit uchar * pos ulong v ulong to void
  for i ulong 8
    put dst add pos i uchar and shr v mul i 8 255
  end
end

export fn c2_om_get16 src view uchar * pos ulong to ulong
  b0 = ulong get src pos
  b1 = ulong get src add pos 1
  ret or b0 shl b1 8
end

export fn c2_om_get64 src view uchar * pos ulong to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get src add pos i
    v = or v shl b mul i 8
  end
  ret v
end

fn c2_cmp32 ids view uchar * a ulong b ulong to long
  oa = mul a 32
  ob = mul b 32
  for j ulong 32
    va = ulong get ids add oa j
    vb = ulong get ids add ob j
    if lt va vb
      ret -1
    end
    if gt va vb
      ret 1
    end
  end
  ret 0
end

export fn c2_om_deps_ascending ids view uchar * n ulong to ulong
  if le n 1
    ret 1
  end
  i = ulong 1
  while lt i n bound 9223372036854775807
    if ge c2_cmp32 ids sub i 1 i 0
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn c2_is_ws c ulong to ulong
  if or eq c 32 or eq c 9 or eq c 13 eq c 10
    ret 1
  end
  ret 0
end

fn c2_skip_ws_inner p view uchar * n ulong pos ulong nl_out edit ulong 1 to ulong
  i = pos
  nl = ulong 0
  while true bound 9223372036854775807
    while lt i n bound 9223372036854775807
      c = ulong get p i
      if eq c2_is_ws c 0
        break
      end
      if eq c 10
        nl = add nl 1
      end
      i = add i 1
    end
    if lt i n
      if eq ulong get p i 99
        while lt i n bound 9223372036854775807
          if eq ulong get p i 10
            break
          end
          i = add i 1
        end
        continue
      end
    end
    break
  end
  put nl_out 0 nl
  ret i
end

export fn c2_om_lrat_skip_ws p view uchar * n ulong pos ulong nl_out edit ulong 1 to ulong
  ret c2_skip_ws_inner p n pos nl_out
end

export fn c2_om_lrat_rd_int p view uchar * n ulong pos ulong dst edit ulong 3 to ulong
  newlines = new ulong 1 0
  i = c2_skip_ws_inner p n pos newlines
  put dst 0 i
  put dst 1 0
  put dst 2 get newlines 0
  if ge i n
    ret 1
  end
  is_neg = ulong 0
  if eq ulong get p i 45
    is_neg = 1
    i = add i 1
  end
  if ge i n
    put dst 0 i
    ret 2
  end
  c0 = ulong get p i
  if or lt c0 48 gt c0 57
    put dst 0 i
    ret 2
  end
  v = ulong 0
  while lt i n bound 9223372036854775807
    c = ulong get p i
    if or lt c 48 gt c 57
      break
    end
    v = add mul v 10 sub c 48
    if gt v 100000000
      put dst 0 i
      ret 2
    end
    i = add i 1
  end
  put dst 0 i
  if lt i n
    if eq c2_is_ws ulong get p i 0
      ret 2
    end
  end
  if eq is_neg 1
    put dst 1 sub 0 v
  else
    put dst 1 v
  end
  ret 0
end

note src/checker2/c2_ir.om: canonical OSC IR decoder and re-encoder (pure seeded OM-2).

const C2_MAX_FUNCS ulong 32
const C2_MAX_PARAMS ulong 6
const C2_MAX_VREGS ulong 480
const C2_MAX_INSNS ulong 4096
const C2_MAX_BLOCKS ulong 512
const C2_MAX_ARRAY ulong 64
const C2_NAME_MAX ulong 63
const C2_CLAUSE_MAX ulong 255
const C2_MAX_STRUCTS ulong 16
const C2_MAX_FIELDS ulong 16
const C2_POOL_SLOTS ulong 16
const C2_TRAP_MAX ulong 14
const C2_IR_CAP ulong 1048576

const S_VOID uchar 0
const S_BOOL uchar 1
const S_U8 uchar 2
const S_U16 uchar 3
const S_U32 uchar 4
const S_U64 uchar 5
const S_I8 uchar 6
const S_I16 uchar 7
const S_I32 uchar 8
const S_I64 uchar 9
const S_REF uchar 10
const S_BYTES uchar 11
const S_CELLS uchar 12
const S_LIMIT uchar 13

const K_NONE uchar 0
const K_OWN uchar 1
const K_SHARED uchar 2
const K_MUT uchar 3

const C2_CONST uchar 1
const C2_MOV uchar 2
const C2_BIN uchar 3
const C2_UN uchar 4
const C2_CMP uchar 5
const C2_CAST uchar 6
const C2_ALLOC uchar 7
const C2_RELEASE uchar 8
const C2_LOAD uchar 9
const C2_STORE uchar 10
const C2_CALL uchar 11
const C2_TRAP uchar 12
const C2_BR uchar 13
const C2_CBR uchar 14
const C2_RET uchar 15
const C2_FLOAD uchar 16
const C2_FSTORE uchar 17
const C2_AOPEN uchar 18
const C2_AALLOC uchar 19
const C2_ADESTROY uchar 20
const C2_POPEN uchar 21
const C2_PCLOSE uchar 22
const C2_HALLOC uchar 23
const C2_HGEN uchar 24
const C2_HFREE uchar 25
const C2_HLOAD uchar 26
const C2_HSTORE uchar 27
const C2_SLOAD uchar 28
const C2_SSTORE uchar 29
const C2_OP_LIMIT uchar 30

const B_ADD uchar 1
const B_SUB uchar 2
const B_MUL uchar 3
const B_DIV uchar 4
const B_REM uchar 5
const B_AND uchar 6
const B_OR uchar 7
const B_XOR uchar 8
const B_SHL uchar 9
const B_SHR uchar 10
const B_LIMIT uchar 11

const U_NEG uchar 1
const U_BNOT uchar 2
const U_LNOT uchar 3
const U_LIMIT uchar 4

const CC_EQ uchar 1
const CC_NE uchar 2
const CC_LT uchar 3
const CC_LE uchar 4
const CC_GT uchar 5
const CC_GE uchar 6
const CC_LIMIT uchar 7

note IR input/encode buffers
global c2_ir_buf uchar 1048576
global c2_ir_enc uchar 1048576
global c2_rd_pos ulong 1
global c2_rd_len ulong 1
global c2_wr_pos ulong 1

note Decoded unit state (flat BSS)
global c2_ver ulong 1
global c2_nstructs ulong 1
global c2_st_name uchar 1024
global c2_st_namelen uchar 16
global c2_st_nfields uchar 16
global c2_st_ncells ushort 16
global c2_fld_name uchar 16384
global c2_fld_namelen uchar 256
global c2_fld_s uchar 256
global c2_fld_alen ushort 256
global c2_fld_off ushort 256

global c2_nfuncs ulong 1
global c2_fn_name uchar 2048
global c2_fn_namelen uchar 32
global c2_fn_nparams uchar 32
global c2_fn_ret_s uchar 32
global c2_fn_ret_kind uchar 32
global c2_fn_ret_elem uchar 32
global c2_fn_ret_sid uchar 32
global c2_fn_ret_len ushort 32
global c2_fn_nvregs ushort 32
global c2_fn_nblocks ushort 32
global c2_fn_ninsns uint 32
global c2_fn_req uchar 8192
global c2_fn_reqlen ushort 32
global c2_fn_ens uchar 8192
global c2_fn_enslen ushort 32

global c2_vt_s uchar 15360
global c2_vt_kind uchar 15360
global c2_vt_elem uchar 15360
global c2_vt_sid uchar 15360
global c2_vt_len ushort 15360

global c2_blk_first uint 16384
global c2_blk_count uint 16384

global c2_in_op uchar 131072
global c2_in_sub uchar 131072
global c2_in_nargs uchar 131072
global c2_in_dst short 131072
global c2_in_a short 131072
global c2_in_b short 131072
global c2_in_c short 131072
global c2_in_args short 786432
global c2_in_t ushort 131072
global c2_in_f ushort 131072
global c2_in_callee ushort 131072
global c2_in_imm ulong 131072

note Verdict globals
global c2_v_ok ulong 1
global c2_v_func long 1
global c2_v_insn long 1
global c2_v_rule uchar 64
global c2_v_rulelen ulong 1
global c2_v_detail uchar 160
global c2_v_detaillen ulong 1

text c2i_magic "OSC1IR"
text c2i_accept "ACCEPT"
text c2i_r_magic "C2-DECODE-MAGIC"
text c2i_r_ver "C2-DECODE-VERSION"
text c2i_r_trunc "C2-DECODE-TRUNCATED"
text c2i_r_name "C2-DECODE-NAME"
text c2i_r_text "C2-DECODE-TEXT"
text c2i_r_op "C2-DECODE-OPCODE"
text c2i_r_trail "C2-DECODE-TRAILING"
text c2i_r_noncan "C2-DECODE-VERSION-NONCANONICAL"
text c2i_r_lim_st "C2-LIMIT-STRUCTS"
text c2i_r_st_fld "C2-STRUCT-FIELDS"
text c2i_r_lim_fn "C2-LIMIT-FUNCS"
text c2i_r_lim_vr "C2-LIMIT-VREGS"
text c2i_r_lim_bk "C2-LIMIT-BLOCKS"
text c2i_r_lim_in "C2-LIMIT-INSNS"
text c2i_r_arity "C2-CALL-ARITY"

text c2i_d_magic "bad magic"
text c2i_d_ver "unknown version"
text c2i_d_trunc "truncated"
text c2i_d_name "bad name"
text c2i_d_text "bad text"
text c2i_d_op "unknown opcode"
text c2i_d_trail "trailing bytes"
text c2i_d_noncan "non-canonical version"
text c2i_d_lim "limit exceeded"
text c2i_d_arity "call arity"

fn c2_fail rule view uchar * fi long ii long det view uchar * to long
  put c2_v_ok 0 0
  put c2_v_func 0 fi
  put c2_v_insn 0 ii
  rn = len rule
  for i ulong rn bound 64
    put c2_v_rule i get rule i
  end
  put c2_v_rulelen 0 rn
  dn = len det
  if gt dn 159
    dn = 159
  end
  for i ulong dn bound 160
    put c2_v_detail i get det i
  end
  put c2_v_detaillen 0 dn
  ret -1
end

fn c2_rd_need k ulong to bool
  ret ge sub get c2_rd_len 0 get c2_rd_pos 0 k
end

fn c2_rd8 dst edit uchar 1 to bool
  if not c2_rd_need 1
    ret false
  end
  p = get c2_rd_pos 0
  put dst 0 get c2_ir_buf p
  put c2_rd_pos 0 add p 1
  ret true
end

fn c2_rd16 dst edit ushort 1 to bool
  if not c2_rd_need 2
    ret false
  end
  p = get c2_rd_pos 0
  b0 = ulong get c2_ir_buf p
  b1 = ulong get c2_ir_buf add p 1
  put dst 0 ushort or b0 shl b1 8
  put c2_rd_pos 0 add p 2
  ret true
end

fn c2_rd32 dst edit uint 1 to bool
  if not c2_rd_need 4
    ret false
  end
  p = get c2_rd_pos 0
  v = ulong 0
  for k ulong 4
    v = or v shl ulong get c2_ir_buf add p k mul k 8
  end
  put dst 0 uint v
  put c2_rd_pos 0 add p 4
  ret true
end

fn c2_rd64 dst edit ulong 1 to bool
  if not c2_rd_need 8
    ret false
  end
  p = get c2_rd_pos 0
  v = ulong 0
  for k ulong 8
    v = or v shl ulong get c2_ir_buf add p k mul k 8
  end
  put dst 0 v
  put c2_rd_pos 0 add p 8
  ret true
end

fn c2_rdvr dst edit short 1 to bool
  u = new ushort 1 0
  if not c2_rd16 u
    ret false
  end
  x = ulong get u 0
  if ge x 32768
    put dst 0 short sub long x 65536
  else
    put dst 0 short x
  end
  ret true
end

fn c2_ident_ok off ulong n ulong to bool
  if eq n 0
    ret false
  end
  for i ulong n bound 64
    c = get c2_ir_buf add off i
    ok = false
    if ge c 97
      if le c 122
        ok = true
      end
    end
    if ge c 65
      if le c 90
        ok = true
      end
    end
    if eq c 95
      ok = true
    end
    if gt i 0
      if ge c 48
        if le c 57
          ok = true
        end
      end
    end
    if not ok
      ret false
    end
  end
  ret true
end

note Read name into c2_st_name (kind=0), c2_fld_name (kind=1), or c2_fn_name (kind=2).
note Returns 0 ok, -1 truncated, -2 bad name.
fn c2_rd_name kind ulong idx ulong to long
  nb = new uchar 1 0
  if not c2_rd8 nb
    ret -1
  end
  n = ulong get nb 0
  if gt n C2_NAME_MAX
    ret -2
  end
  if not c2_rd_need n
    ret -2
  end
  p = get c2_rd_pos 0
  base = mul idx 64
  for i ulong n bound 64
    b = get c2_ir_buf add p i
    if eq kind 0
      put c2_st_name add base i b
    end
    if eq kind 1
      put c2_fld_name add base i b
    end
    if eq kind 2
      put c2_fn_name add base i b
    end
  end
  if eq kind 0
    put c2_st_namelen idx uchar n
  end
  if eq kind 1
    put c2_fld_namelen idx uchar n
  end
  if eq kind 2
    put c2_fn_namelen idx uchar n
  end
  put c2_rd_pos 0 add p n
  if not c2_ident_ok p n
    ret -2
  end
  ret 0
end

note Read type into ret slot (is_ret=1, idx=fi) or vt slot (is_ret=0, idx=fi*480+k)
fn c2_rd_type is_ret ulong idx ulong to bool
  b = new uchar 1 0
  u = new ushort 1 0
  if not c2_rd8 b
    ret false
  end
  s = get b 0
  kd = uchar 0
  el = uchar 0
  sd = uchar 0
  ln = ushort 0
  if eq s S_REF
    if not c2_rd8 b
      ret false
    end
    kd = get b 0
    if not c2_rd8 b
      ret false
    end
    el = get b 0
    if not c2_rd16 u
      ret false
    end
    ln = get u 0
    if eq el S_VOID
      if not c2_rd8 b
        ret false
      end
      sd = get b 0
    end
  end
  if eq is_ret 1
    put c2_fn_ret_s idx s
    put c2_fn_ret_kind idx kd
    put c2_fn_ret_elem idx el
    put c2_fn_ret_sid idx sd
    put c2_fn_ret_len idx ln
  else
    put c2_vt_s idx s
    put c2_vt_kind idx kd
    put c2_vt_elem idx el
    put c2_vt_sid idx sd
    put c2_vt_len idx ln
  end
  ret true
end

fn c2_dec_insn_a op uchar idx ulong to bool
  vr = new short 1 0
  b = new uchar 1 0
  v64 = new ulong 1 0
  if eq op C2_CONST
    if not c2_rdvr vr
      ret false
    end
    put c2_in_dst idx get vr 0
    if not c2_rd64 v64
      ret false
    end
    put c2_in_imm idx get v64 0
    ret true
  end
  if or eq op C2_MOV or eq op C2_CAST eq op C2_ALLOC
    if not c2_rdvr vr
      ret false
    end
    put c2_in_dst idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    ret true
  end
  if or eq op C2_BIN eq op C2_CMP
    if not c2_rd8 b
      ret false
    end
    put c2_in_sub idx get b 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_dst idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_b idx get vr 0
    ret true
  end
  if eq op C2_UN
    if not c2_rd8 b
      ret false
    end
    put c2_in_sub idx get b 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_dst idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    ret true
  end
  if or eq op C2_RELEASE or eq op C2_ADESTROY or eq op C2_PCLOSE eq op C2_RET
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    ret true
  end
  if eq op C2_AOPEN
    if not c2_rdvr vr
      ret false
    end
    put c2_in_dst idx get vr 0
    if not c2_rd8 b
      ret false
    end
    put c2_in_imm idx ulong get b 0
    ret true
  end
  ret false
end

fn c2_dec_insn_b op uchar idx ulong to bool
  vr = new short 1 0
  b = new uchar 1 0
  v16 = new ushort 1 0
  v64 = new ulong 1 0
  if or eq op C2_AALLOC or eq op C2_HALLOC or eq op C2_HGEN or eq op C2_LOAD eq op C2_SLOAD
    if not c2_rdvr vr
      ret false
    end
    put c2_in_dst idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_b idx get vr 0
    ret true
  end
  if eq op C2_POPEN
    if not c2_rdvr vr
      ret false
    end
    put c2_in_dst idx get vr 0
    if not c2_rd8 b
      ret false
    end
    put c2_in_sub idx get b 0
    if not c2_rd8 b
      ret false
    end
    put c2_in_nargs idx get b 0
    if not c2_rd64 v64
      ret false
    end
    put c2_in_imm idx get v64 0
    ret true
  end
  if or eq op C2_HFREE or eq op C2_STORE eq op C2_SSTORE
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_b idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_c idx get vr 0
    ret true
  end
  if eq op C2_HLOAD
    if not c2_rdvr vr
      ret false
    end
    put c2_in_dst idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_b idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_c idx get vr 0
    ret true
  end
  if eq op C2_HSTORE
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_b idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_c idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_args mul idx 6 get vr 0
    put c2_in_nargs idx 1
    ret true
  end
  if eq op C2_FLOAD
    if not c2_rdvr vr
      ret false
    end
    put c2_in_dst idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_b idx get vr 0
    if not c2_rd8 b
      ret false
    end
    put c2_in_imm idx ulong get b 0
    ret true
  end
  if eq op C2_FSTORE
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_b idx get vr 0
    if not c2_rdvr vr
      ret false
    end
    put c2_in_c idx get vr 0
    if not c2_rd8 b
      ret false
    end
    put c2_in_imm idx ulong get b 0
    ret true
  end
  if eq op C2_TRAP
    if not c2_rd8 b
      ret false
    end
    put c2_in_imm idx ulong get b 0
    ret true
  end
  if eq op C2_BR
    if not c2_rd16 v16
      ret false
    end
    put c2_in_t idx get v16 0
    ret true
  end
  if eq op C2_CBR
    if not c2_rdvr vr
      ret false
    end
    put c2_in_a idx get vr 0
    if not c2_rd16 v16
      ret false
    end
    put c2_in_t idx get v16 0
    if not c2_rd16 v16
      ret false
    end
    put c2_in_f idx get v16 0
    ret true
  end
  ret false
end

fn c2_dec_insn fi ulong ii ulong to long
  idx = add mul fi C2_MAX_INSNS ii
  put c2_in_op idx 0
  put c2_in_sub idx 0
  put c2_in_nargs idx 0
  put c2_in_dst idx -1
  put c2_in_a idx -1
  put c2_in_b idx -1
  put c2_in_c idx -1
  put c2_in_t idx 0
  put c2_in_f idx 0
  put c2_in_callee idx 0
  put c2_in_imm idx 0
  abase = mul idx 6
  for k ulong 6
    put c2_in_args add abase k -1
  end
  b = new uchar 1 0
  vr = new short 1 0
  v16 = new ushort 1 0
  if not c2_rd8 b
    ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
  end
  op = get b 0
  put c2_in_op idx op
  if eq op 0
    ret c2_fail c2i_r_op long fi long ii c2i_d_op
  end
  if ge op C2_OP_LIMIT
    ret c2_fail c2i_r_op long fi long ii c2i_d_op
  end
  if eq op C2_CALL
    if not c2_rdvr vr
      ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
    end
    put c2_in_dst idx get vr 0
    if not c2_rd16 v16
      ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
    end
    put c2_in_callee idx get v16 0
    if not c2_rd8 b
      ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
    end
    na = ulong get b 0
    put c2_in_nargs idx get b 0
    bad_na = false
    note GUARD:call-nargs-limit
    bad_na = gt na C2_MAX_PARAMS
    if bad_na
      ret c2_fail c2i_r_arity long fi long ii c2i_d_arity
    end
    for k ulong na bound 6
      if not c2_rdvr vr
        ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
      end
      put c2_in_args add abase k get vr 0
    end
    ret 0
  end
  ok = c2_dec_insn_a op idx
  if not ok
    ok = c2_dec_insn_b op idx
  end
  if not ok
    ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
  end
  ret 0
end

fn c2_rd_clause is_ens ulong fi ulong to long
  v16 = new ushort 1 0
  if not c2_rd16 v16
    ret -1
  end
  n = ulong get v16 0
  if gt n C2_CLAUSE_MAX
    ret -2
  end
  if not c2_rd_need n
    ret -2
  end
  p = get c2_rd_pos 0
  base = mul fi 256
  for k ulong n bound 256
    c = get c2_ir_buf add p k
    if eq c 0
      put c2_rd_pos 0 add p n
      ret -2
    end
    if eq is_ens 0
      put c2_fn_req add base k c
    else
      put c2_fn_ens add base k c
    end
  end
  if eq is_ens 0
    put c2_fn_reqlen fi ushort n
  else
    put c2_fn_enslen fi ushort n
  end
  put c2_rd_pos 0 add p n
  ret 0
end

fn c2_has_op lo uchar hi uchar to bool
  nf = get c2_nfuncs 0
  for fi ulong nf bound 32
    ni = ulong get c2_fn_ninsns fi
    base = mul fi C2_MAX_INSNS
    for i ulong ni bound 4096
      op = get c2_in_op add base i
      if ge op lo
        if le op hi
          ret true
        end
      end
    end
  end
  ret false
end

fn c2_has_slice to bool
  nf = get c2_nfuncs 0
  for fi ulong nf bound 32
    nv = ulong get c2_fn_nvregs fi
    base = mul fi C2_MAX_VREGS
    for k ulong nv bound 480
      s = get c2_vt_s add base k
      if eq s S_BYTES
        ret true
      end
      if eq s S_CELLS
        ret true
      end
    end
  end
  ret false
end

fn c2_canonical_version to ulong
  if c2_has_slice
    ret 5
  end
  if c2_has_op C2_POPEN C2_HSTORE
    ret 4
  end
  if c2_has_op C2_AOPEN C2_ADESTROY
    ret 3
  end
  if ne get c2_nstructs 0 0
    ret 2
  end
  ret 1
end

fn c2_dec_structs to long
  b = new uchar 1 0
  v16 = new ushort 1 0
  if not c2_rd8 b
    ret c2_fail c2i_r_trunc -1 -1 c2i_d_trunc
  end
  ns = ulong get b 0
  put c2_nstructs 0 ns
  if gt ns C2_MAX_STRUCTS
    ret c2_fail c2i_r_lim_st -1 -1 c2i_d_lim
  end
  for k ulong ns bound 16
    e = c2_rd_name 0 k
    if eq e -1
      ret c2_fail c2i_r_trunc -1 -1 c2i_d_trunc
    end
    if ne e 0
      ret c2_fail c2i_r_name -1 -1 c2i_d_name
    end
    if not c2_rd8 b
      ret c2_fail c2i_r_trunc -1 -1 c2i_d_trunc
    end
    nf = ulong get b 0
    put c2_st_nfields k get b 0
    if not c2_rd16 v16
      ret c2_fail c2i_r_trunc -1 -1 c2i_d_trunc
    end
    put c2_st_ncells k get v16 0
    if eq nf 0
      ret c2_fail c2i_r_st_fld -1 -1 c2i_d_lim
    end
    if gt nf C2_MAX_FIELDS
      ret c2_fail c2i_r_st_fld -1 -1 c2i_d_lim
    end
    for f ulong nf bound 16
      fidx = add mul k 16 f
      e2 = c2_rd_name 1 fidx
      if eq e2 -1
        ret c2_fail c2i_r_trunc -1 -1 c2i_d_trunc
      end
      if ne e2 0
        ret c2_fail c2i_r_name -1 -1 c2i_d_name
      end
      if not c2_rd8 b
        ret c2_fail c2i_r_trunc -1 -1 c2i_d_trunc
      end
      put c2_fld_s fidx get b 0
      if not c2_rd16 v16
        ret c2_fail c2i_r_trunc -1 -1 c2i_d_trunc
      end
      put c2_fld_alen fidx get v16 0
      if not c2_rd16 v16
        ret c2_fail c2i_r_trunc -1 -1 c2i_d_trunc
      end
      put c2_fld_off fidx get v16 0
    end
  end
  ret 0
end

fn c2_dec_func fi ulong to long
  b = new uchar 1 0
  v16 = new ushort 1 0
  v32 = new uint 1 0
  e = c2_rd_name 2 fi
  if eq e -1
    ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
  end
  if ne e 0
    ret c2_fail c2i_r_name long fi -1 c2i_d_name
  end
  if not c2_rd8 b
    ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
  end
  put c2_fn_nparams fi get b 0
  if not c2_rd_type 1 fi
    ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
  end
  if not c2_rd16 v16
    ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
  end
  nv = ulong get v16 0
  put c2_fn_nvregs fi get v16 0
  if gt nv C2_MAX_VREGS
    ret c2_fail c2i_r_lim_vr long fi -1 c2i_d_lim
  end
  vbase = mul fi C2_MAX_VREGS
  for k ulong nv bound 480
    if not c2_rd_type 0 add vbase k
      ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
    end
  end
  if not c2_rd16 v16
    ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
  end
  nb = ulong get v16 0
  put c2_fn_nblocks fi get v16 0
  if eq nb 0
    ret c2_fail c2i_r_lim_bk long fi -1 c2i_d_lim
  end
  if gt nb C2_MAX_BLOCKS
    ret c2_fail c2i_r_lim_bk long fi -1 c2i_d_lim
  end
  bbase = mul fi C2_MAX_BLOCKS
  for bi ulong nb bound 512
    if not c2_rd32 v32
      ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
    end
    put c2_blk_first add bbase bi get v32 0
    if not c2_rd32 v32
      ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
    end
    put c2_blk_count add bbase bi get v32 0
  end
  if not c2_rd32 v32
    ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
  end
  ni = ulong get v32 0
  put c2_fn_ninsns fi get v32 0
  if eq ni 0
    ret c2_fail c2i_r_lim_in long fi -1 c2i_d_lim
  end
  if gt ni C2_MAX_INSNS
    ret c2_fail c2i_r_lim_in long fi -1 c2i_d_lim
  end
  for ii ulong ni bound 4096
    if ne c2_dec_insn fi ii 0
      ret -1
    end
  end
  er = c2_rd_clause 0 fi
  if eq er -1
    ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
  end
  if ne er 0
    ret c2_fail c2i_r_text long fi -1 c2i_d_text
  end
  ee = c2_rd_clause 1 fi
  if eq ee -1
    ret c2_fail c2i_r_trunc long fi -1 c2i_d_trunc
  end
  if ne ee 0
    ret c2_fail c2i_r_text long fi -1 c2i_d_text
  end
  ret 0
end

note Strict decode of c2_ir_buf[0..blen)
fn c2_decode blen ulong to long
  put c2_ver 0 0
  put c2_nstructs 0 0
  put c2_nfuncs 0 0
  put c2_v_ok 0 1
  put c2_v_func 0 -1
  put c2_v_insn 0 -1
  put c2_v_rulelen 0 0
  put c2_v_detaillen 0 0
  put c2_rd_pos 0 0
  put c2_rd_len 0 blen
  if lt blen 8
    ret c2_fail c2i_r_magic -1 -1 c2i_d_magic
  end
  for i ulong 6
    if ne get c2_ir_buf i get c2i_magic i
      ret c2_fail c2i_r_magic -1 -1 c2i_d_magic
    end
  end
  if ne get c2_ir_buf 6 0
    ret c2_fail c2i_r_magic -1 -1 c2i_d_magic
  end
  ver = ulong get c2_ir_buf 7
  put c2_ver 0 ver
  bad_v = false
  note GUARD:version-range
  bad_v = or lt ver 1 gt ver 5
  if bad_v
    ret c2_fail c2i_r_ver -1 -1 c2i_d_ver
  end
  put c2_rd_pos 0 8
  if ge ver 2
    if ne c2_dec_structs 0
      ret -1
    end
  end
  v16 = new ushort 1 0
  if not c2_rd16 v16
    ret c2_fail c2i_r_trunc -1 -1 c2i_d_trunc
  end
  nf = ulong get v16 0
  put c2_nfuncs 0 nf
  if eq nf 0
    ret c2_fail c2i_r_lim_fn -1 -1 c2i_d_lim
  end
  if gt nf C2_MAX_FUNCS
    ret c2_fail c2i_r_lim_fn -1 -1 c2i_d_lim
  end
  for fi ulong nf bound 32
    if ne c2_dec_func fi 0
      ret -1
    end
  end
  bad_tr = false
  note GUARD:trailing
  bad_tr = ne get c2_rd_pos 0 blen
  if bad_tr
    ret c2_fail c2i_r_trail -1 -1 c2i_d_trail
  end
  cv = c2_canonical_version
  bad_cv = false
  note GUARD:canonical-version
  bad_cv = ne cv ver
  if bad_cv
    ret c2_fail c2i_r_noncan -1 -1 c2i_d_noncan
  end
  ret 0
end

note ---- Canonical re-encoder (mirror of c2_decode) into c2_ir_enc ----

fn c2_w8 v ulong to void
  p = get c2_wr_pos 0
  if lt p C2_IR_CAP
    put c2_ir_enc p uchar and v 255
  end
  put c2_wr_pos 0 add p 1
end

fn c2_w16 v ulong to void
  c2_w8 and v 255
  c2_w8 and shr v 8 255
end

fn c2_w32 v ulong to void
  for k ulong 4
    c2_w8 and shr v mul k 8 255
  end
end

fn c2_w64 v ulong to void
  for k ulong 8
    c2_w8 and shr v mul k 8 255
  end
end

fn c2_wvr v short to void
  x = long v
  if lt x 0
    x = add x 65536
  end
  c2_w16 ulong x
end

fn c2_wname kind ulong idx ulong to void
  n = ulong 0
  if eq kind 0
    n = ulong get c2_st_namelen idx
  end
  if eq kind 1
    n = ulong get c2_fld_namelen idx
  end
  if eq kind 2
    n = ulong get c2_fn_namelen idx
  end
  c2_w8 n
  base = mul idx 64
  for i ulong n bound 64
    b = uchar 0
    if eq kind 0
      b = get c2_st_name add base i
    end
    if eq kind 1
      b = get c2_fld_name add base i
    end
    if eq kind 2
      b = get c2_fn_name add base i
    end
    c2_w8 ulong b
  end
end

fn c2_wtype is_ret ulong idx ulong to void
  s = uchar 0
  kd = uchar 0
  el = uchar 0
  sd = uchar 0
  ln = ushort 0
  if eq is_ret 1
    s = get c2_fn_ret_s idx
    kd = get c2_fn_ret_kind idx
    el = get c2_fn_ret_elem idx
    sd = get c2_fn_ret_sid idx
    ln = get c2_fn_ret_len idx
  else
    s = get c2_vt_s idx
    kd = get c2_vt_kind idx
    el = get c2_vt_elem idx
    sd = get c2_vt_sid idx
    ln = get c2_vt_len idx
  end
  c2_w8 ulong s
  if eq s S_REF
    c2_w8 ulong kd
    c2_w8 ulong el
    c2_w16 ulong ln
    if eq el S_VOID
      c2_w8 ulong sd
    end
  end
end

fn c2_enc_insn idx ulong to void
  op = get c2_in_op idx
  c2_w8 ulong op
  if eq op C2_CONST
    c2_wvr get c2_in_dst idx
    c2_w64 get c2_in_imm idx
    ret
  end
  if or eq op C2_MOV or eq op C2_CAST eq op C2_ALLOC
    c2_wvr get c2_in_dst idx
    c2_wvr get c2_in_a idx
    ret
  end
  if or eq op C2_BIN eq op C2_CMP
    c2_w8 ulong get c2_in_sub idx
    c2_wvr get c2_in_dst idx
    c2_wvr get c2_in_a idx
    c2_wvr get c2_in_b idx
    ret
  end
  if eq op C2_UN
    c2_w8 ulong get c2_in_sub idx
    c2_wvr get c2_in_dst idx
    c2_wvr get c2_in_a idx
    ret
  end
  if or eq op C2_RELEASE or eq op C2_ADESTROY or eq op C2_PCLOSE eq op C2_RET
    c2_wvr get c2_in_a idx
    ret
  end
  if eq op C2_AOPEN
    c2_wvr get c2_in_dst idx
    c2_w8 get c2_in_imm idx
    ret
  end
  if or eq op C2_AALLOC or eq op C2_HALLOC or eq op C2_HGEN or eq op C2_LOAD eq op C2_SLOAD
    c2_wvr get c2_in_dst idx
    c2_wvr get c2_in_a idx
    c2_wvr get c2_in_b idx
    ret
  end
  if eq op C2_POPEN
    c2_wvr get c2_in_dst idx
    c2_w8 ulong get c2_in_sub idx
    c2_w8 ulong get c2_in_nargs idx
    c2_w64 get c2_in_imm idx
    ret
  end
  if or eq op C2_HFREE or eq op C2_STORE eq op C2_SSTORE
    c2_wvr get c2_in_a idx
    c2_wvr get c2_in_b idx
    c2_wvr get c2_in_c idx
    ret
  end
  if eq op C2_HLOAD
    c2_wvr get c2_in_dst idx
    c2_wvr get c2_in_a idx
    c2_wvr get c2_in_b idx
    c2_wvr get c2_in_c idx
    ret
  end
  if eq op C2_HSTORE
    c2_wvr get c2_in_a idx
    c2_wvr get c2_in_b idx
    c2_wvr get c2_in_c idx
    c2_wvr get c2_in_args mul idx 6
    ret
  end
  if eq op C2_FLOAD
    c2_wvr get c2_in_dst idx
    c2_wvr get c2_in_a idx
    c2_wvr get c2_in_b idx
    c2_w8 get c2_in_imm idx
    ret
  end
  if eq op C2_FSTORE
    c2_wvr get c2_in_a idx
    c2_wvr get c2_in_b idx
    c2_wvr get c2_in_c idx
    c2_w8 get c2_in_imm idx
    ret
  end
  if eq op C2_CALL
    c2_wvr get c2_in_dst idx
    c2_w16 ulong get c2_in_callee idx
    na = ulong get c2_in_nargs idx
    c2_w8 na
    abase = mul idx 6
    for k ulong na bound 6
      c2_wvr get c2_in_args add abase k
    end
    ret
  end
  if eq op C2_TRAP
    c2_w8 get c2_in_imm idx
    ret
  end
  if eq op C2_BR
    c2_w16 ulong get c2_in_t idx
    ret
  end
  if eq op C2_CBR
    c2_wvr get c2_in_a idx
    c2_w16 ulong get c2_in_t idx
    c2_w16 ulong get c2_in_f idx
    ret
  end
end

fn c2_enc_func fi ulong to void
  c2_wname 2 fi
  c2_w8 ulong get c2_fn_nparams fi
  c2_wtype 1 fi
  nv = ulong get c2_fn_nvregs fi
  c2_w16 nv
  vbase = mul fi C2_MAX_VREGS
  for k ulong nv bound 480
    c2_wtype 0 add vbase k
  end
  nb = ulong get c2_fn_nblocks fi
  c2_w16 nb
  bbase = mul fi C2_MAX_BLOCKS
  for b ulong nb bound 512
    c2_w32 ulong get c2_blk_first add bbase b
    c2_w32 ulong get c2_blk_count add bbase b
  end
  ni = ulong get c2_fn_ninsns fi
  c2_w32 ni
  ibase = mul fi C2_MAX_INSNS
  for ii ulong ni bound 4096
    c2_enc_insn add ibase ii
  end
  rl = ulong get c2_fn_reqlen fi
  c2_w16 rl
  rbase = mul fi 256
  for k ulong rl bound 256
    c2_w8 ulong get c2_fn_req add rbase k
  end
  el = ulong get c2_fn_enslen fi
  c2_w16 el
  for k ulong el bound 256
    c2_w8 ulong get c2_fn_ens add rbase k
  end
end

fn c2_encode to ulong
  put c2_wr_pos 0 0
  for i ulong 6
    c2_w8 ulong get c2i_magic i
  end
  c2_w8 0
  ver = get c2_ver 0
  c2_w8 ver
  if ge ver 2
    ns = get c2_nstructs 0
    c2_w8 ns
    for k ulong ns bound 16
      c2_wname 0 k
      nf = ulong get c2_st_nfields k
      c2_w8 nf
      c2_w16 ulong get c2_st_ncells k
      for f ulong nf bound 16
        fidx = add mul k 16 f
        c2_wname 1 fidx
        c2_w8 ulong get c2_fld_s fidx
        c2_w16 ulong get c2_fld_alen fidx
        c2_w16 ulong get c2_fld_off fidx
      end
    end
  end
  nfn = get c2_nfuncs 0
  c2_w16 nfn
  for fi ulong nfn bound 32
    c2_enc_func fi
  end
  p = get c2_wr_pos 0
  if gt p C2_IR_CAP
    ret 0
  end
  ret p
end

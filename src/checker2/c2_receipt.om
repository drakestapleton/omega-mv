note src/checker2/c2_receipt.om: signed Omega realization receipts v1 (pure seeded OM-2).
note Compose after: c2_om2_hdr.om, seed/ng/sha256.om, protocol/omnet/om/sha512/sha512.om,
note                protocol/omnet/om/ed25519/ed25519.om, protocol/uor-gpu/ed_sign.om

const C2R_SIZE ulong 416
const C2R_SIGNED_LEN ulong 352
const C2R_SIGNED_MSG_LEN ulong 65
const C2R_FORMAT_VERSION ulong 1
const C2R_ALG_ED25519 ulong 1

const C2R_CLASS_TEST ulong 1
const C2R_CLASS_OWNER ulong 2

const C2R_EV_IR_CHECKED ulong 1
const C2R_EV_IR_CHECKED_LRAT ulong 2

const C2R_OK long 0
const C2R_E_SIZE long 1
const C2R_E_MAGIC long 2
const C2R_E_VERSION long 3
const C2R_E_ALG long 4
const C2R_E_CLASS long 5
const C2R_E_EVIDENCE long 6
const C2R_E_EPOCH_ORDER long 7
const C2R_E_TEST_IN_PRODUCTION long 9
const C2R_E_UNTRUSTED_SIGNER long 10
const C2R_E_BAD_SIGNATURE long 11
const C2R_E_REVOKED long 12
const C2R_E_STALE long 13
const C2R_E_EXPIRED long 14
const C2R_E_NOT_YET_VALID long 15
const C2R_E_WRONG_TARGET long 16
const C2R_E_WRONG_FIRMWARE long 17
const C2R_E_PROGRAM_MISMATCH long 18
const C2R_E_EXECUTABLE_MISMATCH long 19
const C2R_E_ARG long 20
const C2R_E_KEY_CLASS long 21
const C2R_E_UNTRUSTED_CHECKER long 22
const C2R_E_WRONG_PRODUCER long 23
const C2R_E_DEPS_MISMATCH long 24

note Hash slot indices in c2r_r_h (10 * 32 = 320 bytes)
const C2RH_REQ ulong 0
const C2RH_PROG ulong 32
const C2RH_EXE ulong 64
const C2RH_DEPS ulong 96
const C2RH_CHK ulong 128
const C2RH_PCHK ulong 160
const C2RH_TGT ulong 192
const C2RH_FW ulong 224
const C2RH_INP ulong 256
const C2RH_KFP ulong 288

text c2r_t_magic "OMRCPT1"
text c2r_t_test_seed "OMEGA-CHECKER2-TEST-KEY-v1 NOT FOR PRODUCTION"
text c2r_t_tgt_tag "OMEGA-TARGET-V1"
text c2r_t_deps_tag "OMEGA-RECEIPT-DEPS-V1"
text c2r_t_body_tag "OMEGA-REALIZATION-RECEIPT-V1"
text c2r_t_sig_tag "OMEGA-REALIZATION-RECEIPT-SIG-V1"

text c2r_t_owner_hex "578ada3cb0c2d154623ac089191023c8ad4bc5e63b8ccd1a38db2d679b8c9e76"
text c2r_t_test_hex "602810d43c0115df877b0cf8c327010e5a7e570490c85e31466c0cff6ca374c5"

text c2r_rn_ok "OK"
text c2r_rn_size "SIZE"
text c2r_rn_magic "MAGIC"
text c2r_rn_ver "VERSION"
text c2r_rn_alg "SIGNATURE_ALGORITHM"
text c2r_rn_cls "SIGNER_CLASS"
text c2r_rn_ev "EVIDENCE_CLASS"
text c2r_rn_epo "EPOCH_ORDER"
text c2r_rn_tip "TEST_SIGNER_IN_PRODUCTION"
text c2r_rn_usig "UNTRUSTED_SIGNER"
text c2r_rn_bsig "BAD_SIGNATURE"
text c2r_rn_rev "REVOKED"
text c2r_rn_stale "STALE_EPOCH"
text c2r_rn_exp "EXPIRED"
text c2r_rn_nyv "NOT_YET_VALID"
text c2r_rn_wtgt "WRONG_TARGET"
text c2r_rn_wfw "WRONG_FIRMWARE"
text c2r_rn_pmis "PROGRAM_MISMATCH"
text c2r_rn_emis "EXECUTABLE_MISMATCH"
text c2r_rn_arg "ARGUMENT"
text c2r_rn_kcls "KEY_CLASS"
text c2r_rn_uchk "UNTRUSTED_CHECKER"
text c2r_rn_wprd "WRONG_PRODUCER"
text c2r_rn_dmis "DEPENDENCIES_MISMATCH"
text c2r_rn_unk "UNKNOWN"

global c2r_keys_ready ulong 1
global c2r_owner_root_pk uchar 32
global c2r_test_pk uchar 32

note Active C2Receipt struct in globals
global c2r_r_u16 ulong 4
global c2r_r_h uchar 320
global c2r_r_ep ulong 2
global c2r_r_sig uchar 64

note Scratch receipt for internal decode checks
global c2r_s_u16 ulong 4
global c2r_s_h uchar 320
global c2r_s_ep ulong 2
global c2r_s_sig uchar 64

note Encoded receipt & signed message buffers
global c2r_buf uchar 416
global c2r_tmp uchar 416
global c2r_msg uchar 65
global c2r_id_out uchar 32

note Policy globals (up to 16 entries per list)
global c2r_pol_prod ulong 1
global c2r_pol_ntest ulong 1
global c2r_pol_test uchar 512
global c2r_pol_nowner ulong 1
global c2r_pol_owner uchar 512
global c2r_pol_nrev_id ulong 1
global c2r_pol_rev_id uchar 512
global c2r_pol_nrev_key ulong 1
global c2r_pol_rev_key uchar 512
global c2r_pol_nchk ulong 1
global c2r_pol_chk uchar 512
global c2r_pol_floor ulong 1
global c2r_pol_cur ulong 1

note Expect globals: ex_has[0]=enabled, 1=tgt, 2=fw, 3=prog, 4=exe, 5=prod, 6=deps
global c2r_ex_has ulong 7
global c2r_ex_h uchar 192

note Reason string output buffer
global c2r_rsn_buf uchar 64
global c2r_rsn_len ulong 1

fn c2r_hex_nib c uchar to long
  v = ulong c
  if ge v 48
    if le v 57
      ret long sub v 48
    end
  end
  if ge v 97
    if le v 102
      ret long sub v 87
    end
  end
  ret -1
end

fn c2r_init_keys to void
  if ne get c2r_keys_ready 0 0
    ret
  end
  for i ulong 32
    hi = c2r_hex_nib get c2r_t_owner_hex mul i 2
    lo = c2r_hex_nib get c2r_t_owner_hex add mul i 2 1
    put c2r_owner_root_pk i uchar or shl ulong hi 4 ulong lo
    hi2 = c2r_hex_nib get c2r_t_test_hex mul i 2
    lo2 = c2r_hex_nib get c2r_t_test_hex add mul i 2 1
    put c2r_test_pk i uchar or shl ulong hi2 4 ulong lo2
  end
  put c2r_keys_ready 0 1
end

fn c2r_test_seed dst edit uchar 32 to void
  n = len c2r_t_test_seed
  for i ulong n bound 64
    put sh_dat i get c2r_t_test_seed i
  end
  sh_all n
  for i ulong 32
    put dst i get sh_dig i
  end
end

fn c2r_set_rsn src view uchar * to void
  n = len src
  for i ulong n bound 64
    put c2r_rsn_buf i get src i
  end
  put c2r_rsn_len 0 n
end

fn c2r_reason code long to void
  if eq code C2R_OK
    c2r_set_rsn c2r_rn_ok
    ret
  end
  if eq code C2R_E_SIZE
    c2r_set_rsn c2r_rn_size
    ret
  end
  if eq code C2R_E_MAGIC
    c2r_set_rsn c2r_rn_magic
    ret
  end
  if eq code C2R_E_VERSION
    c2r_set_rsn c2r_rn_ver
    ret
  end
  if eq code C2R_E_ALG
    c2r_set_rsn c2r_rn_alg
    ret
  end
  if eq code C2R_E_CLASS
    c2r_set_rsn c2r_rn_cls
    ret
  end
  if eq code C2R_E_EVIDENCE
    c2r_set_rsn c2r_rn_ev
    ret
  end
  if eq code C2R_E_EPOCH_ORDER
    c2r_set_rsn c2r_rn_epo
    ret
  end
  if eq code C2R_E_TEST_IN_PRODUCTION
    c2r_set_rsn c2r_rn_tip
    ret
  end
  if eq code C2R_E_UNTRUSTED_SIGNER
    c2r_set_rsn c2r_rn_usig
    ret
  end
  if eq code C2R_E_BAD_SIGNATURE
    c2r_set_rsn c2r_rn_bsig
    ret
  end
  if eq code C2R_E_REVOKED
    c2r_set_rsn c2r_rn_rev
    ret
  end
  if eq code C2R_E_STALE
    c2r_set_rsn c2r_rn_stale
    ret
  end
  if eq code C2R_E_EXPIRED
    c2r_set_rsn c2r_rn_exp
    ret
  end
  if eq code C2R_E_NOT_YET_VALID
    c2r_set_rsn c2r_rn_nyv
    ret
  end
  if eq code C2R_E_WRONG_TARGET
    c2r_set_rsn c2r_rn_wtgt
    ret
  end
  if eq code C2R_E_WRONG_FIRMWARE
    c2r_set_rsn c2r_rn_wfw
    ret
  end
  if eq code C2R_E_PROGRAM_MISMATCH
    c2r_set_rsn c2r_rn_pmis
    ret
  end
  if eq code C2R_E_EXECUTABLE_MISMATCH
    c2r_set_rsn c2r_rn_emis
    ret
  end
  if eq code C2R_E_ARG
    c2r_set_rsn c2r_rn_arg
    ret
  end
  if eq code C2R_E_KEY_CLASS
    c2r_set_rsn c2r_rn_kcls
    ret
  end
  if eq code C2R_E_UNTRUSTED_CHECKER
    c2r_set_rsn c2r_rn_uchk
    ret
  end
  if eq code C2R_E_WRONG_PRODUCER
    c2r_set_rsn c2r_rn_wprd
    ret
  end
  if eq code C2R_E_DEPS_MISMATCH
    c2r_set_rsn c2r_rn_dmis
    ret
  end
  c2r_set_rsn c2r_rn_unk
end

fn c2r_put16_buf pos ulong v ulong to void
  put c2r_buf pos uchar and v 255
  put c2r_buf add pos 1 uchar and shr v 8 255
end

fn c2r_put64_buf pos ulong v ulong to void
  for i ulong 8
    put c2r_buf add pos i uchar and shr v mul i 8 255
  end
end

fn c2r_get16_buf pos ulong to ulong
  b0 = ulong get c2r_buf pos
  b1 = ulong get c2r_buf add pos 1
  ret or b0 shl b1 8
end

fn c2r_get64_buf pos ulong to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get c2r_buf add pos i
    v = or v shl b mul i 8
  end
  ret v
end

fn c2r_target_id name view uchar * nlen ulong dst edit uchar 32 to void
  tl = len c2r_t_tgt_tag
  for i ulong tl bound 32
    put sh_dat i get c2r_t_tgt_tag i
  end
  put sh_dat tl 0
  p = add tl 1
  for i ulong nlen bound 4096
    put sh_dat add p i get name i
  end
  sh_all add p nlen
  for i ulong 32
    put dst i get sh_dig i
  end
end

fn c2r_cmp32_in a view uchar * ao ulong bo ulong to long
  for i ulong 32
    va = ulong get a add ao i
    vb = ulong get a add bo i
    if lt va vb
      ret -1
    end
    if gt va vb
      ret 1
    end
  end
  ret 0
end

fn c2r_deps_digest ids view uchar * n ulong dst edit uchar 32 to long
  for i ulong n bound 64
    if gt i 0
      prev = mul sub i 1 32
      cur = mul i 32
      c = c2r_cmp32_in ids prev cur
      if ge c 0
        ret -1
      end
    end
  end
  tl = len c2r_t_deps_tag
  for i ulong tl bound 32
    put sh_dat i get c2r_t_deps_tag i
  end
  put sh_dat tl 0
  p = add tl 1
  put sh_dat p uchar and n 255
  put sh_dat add p 1 uchar and shr n 8 255
  put sh_dat add p 2 uchar and shr n 16 255
  put sh_dat add p 3 uchar and shr n 24 255
  p = add p 4
  for i ulong n bound 64
    base = mul i 32
    for j ulong 32
      put sh_dat add p add base j get ids add base j
    end
  end
  sh_all add p mul n 32
  for i ulong 32
    put dst i get sh_dig i
  end
  ret 0
end

note Encode active c2r_r_* into c2r_buf[0..416)
fn c2r_encode to void
  for i ulong 7
    put c2r_buf i get c2r_t_magic i
  end
  put c2r_buf 7 0
  c2r_put16_buf 8 get c2r_r_u16 0
  c2r_put16_buf 10 get c2r_r_u16 1
  c2r_put16_buf 12 get c2r_r_u16 2
  c2r_put16_buf 14 get c2r_r_u16 3
  for i ulong 288
    put c2r_buf add 16 i get c2r_r_h i
  end
  c2r_put64_buf 304 get c2r_r_ep 0
  c2r_put64_buf 312 get c2r_r_ep 1
  for i ulong 32
    put c2r_buf add 320 i get c2r_r_h add 288 i
  end
  for i ulong 64
    put c2r_buf add 352 i get c2r_r_sig i
  end
end

fn c2r_magic_bad to bool
  for i ulong 7
    if ne get c2r_buf i get c2r_t_magic i
      ret true
    end
  end
  if ne get c2r_buf 7 0
    ret true
  end
  ret false
end

fn c2r_decode_hdr to long
  ver = c2r_get16_buf 8
  cls = c2r_get16_buf 10
  alg = c2r_get16_buf 12
  ev = c2r_get16_buf 14
  put c2r_r_u16 0 ver
  put c2r_r_u16 1 cls
  put c2r_r_u16 2 alg
  put c2r_r_u16 3 ev
  if ne ver C2R_FORMAT_VERSION
    ret C2R_E_VERSION
  end
  if ne alg C2R_ALG_ED25519
    ret C2R_E_ALG
  end
  if ne cls C2R_CLASS_TEST
    if ne cls C2R_CLASS_OWNER
      ret C2R_E_CLASS
    end
  end
  if ne ev C2R_EV_IR_CHECKED
    if ne ev C2R_EV_IR_CHECKED_LRAT
      ret C2R_E_EVIDENCE
    end
  end
  ret C2R_OK
end

note Structural decode of c2r_buf[0..blen) into c2r_r_*
fn c2r_decode blen ulong to long
  if ne blen C2R_SIZE
    ret C2R_E_SIZE
  end
  bad_m = false
  note GUARD:magic
  bad_m = c2r_magic_bad
  if bad_m
    ret C2R_E_MAGIC
  end
  eh = c2r_decode_hdr
  if ne eh C2R_OK
    ret eh
  end
  for i ulong 288
    put c2r_r_h i get c2r_buf add 16 i
  end
  pe = c2r_get64_buf 304
  xe = c2r_get64_buf 312
  put c2r_r_ep 0 pe
  put c2r_r_ep 1 xe
  bad_ep = false
  note GUARD:epoch-order
  bad_ep = lt xe pe
  if bad_ep
    ret C2R_E_EPOCH_ORDER
  end
  for i ulong 32
    put c2r_r_h add 288 i get c2r_buf add 320 i
  end
  for i ulong 64
    put c2r_r_sig i get c2r_buf add 352 i
  end
  ret C2R_OK
end

note Compute receipt id = SHA-256(c2r_buf[0..416)) into dst
fn c2r_id dst edit uchar 32 to void
  for i ulong C2R_SIZE
    put sh_dat i get c2r_buf i
  end
  sh_all C2R_SIZE
  for i ulong 32
    put dst i get sh_dig i
  end
end

note Compute 65-byte signed message from c2r_buf[0..352) into c2r_msg[0..65)
fn c2r_signed_message to void
  bl = len c2r_t_body_tag
  for i ulong bl bound 40
    put sh_dat i get c2r_t_body_tag i
  end
  put sh_dat bl 0
  p = add bl 1
  for i ulong C2R_SIGNED_LEN
    put sh_dat add p i get c2r_buf i
  end
  sh_all add p C2R_SIGNED_LEN
  sl = len c2r_t_sig_tag
  for i ulong sl bound 40
    put c2r_msg i get c2r_t_sig_tag i
  end
  put c2r_msg sl 0
  q = add sl 1
  for i ulong 32
    put c2r_msg add q i get sh_dig i
  end
end

note ---- Ed25519 strict verify (rejects small-order A and R, matching aienos_sig) ----

fn c2r_pt_small_order b view uchar 32 to bool
  w = new ulong 1024 0
  edinit w
  if eq edpdec w edq b 0
    ret true
  end
  edpdbl w edq
  edpdbl w edq
  edpdbl w edq
  ret eq edpid w edq 1
end

fn c2r_edverify_strict pk view uchar 32 msg view uchar 65536 mlen ulong sg view uchar 64 to bool
  if c2r_pt_small_order pk
    ret false
  end
  rb = new uchar 32 0
  for i ulong 32
    put rb i get sg i
  end
  if c2r_pt_small_order rb
    ret false
  end
  ret eq edverify pk msg mlen sg 0 1
end

fn c2r_sign_msg65 seed view uchar 32 sg edit uchar 64 to void
  m = new uchar 65536 0
  for i ulong C2R_SIGNED_MSG_LEN
    put m i get c2r_msg i
  end
  ues_sign seed m C2R_SIGNED_MSG_LEN sg
end

fn c2r_verify_msg65 pk view uchar 32 sg view uchar 64 to bool
  m = new uchar 65536 0
  for i ulong C2R_SIGNED_MSG_LEN
    put m i get c2r_msg i
  end
  ret c2r_edverify_strict pk m C2R_SIGNED_MSG_LEN sg
end

fn c2r_fields_ok to long
  for i ulong 4
    put c2r_s_u16 i get c2r_r_u16 i
  end
  for i ulong 320
    put c2r_s_h i get c2r_r_h i
  end
  for i ulong 2
    put c2r_s_ep i get c2r_r_ep i
  end
  for i ulong 64
    put c2r_s_sig i get c2r_r_sig i
  end
  for i ulong 32
    put c2r_r_h add 288 i 0
  end
  for i ulong 64
    put c2r_r_sig i 0
  end
  c2r_encode
  e = c2r_decode C2R_SIZE
  for i ulong 4
    put c2r_r_u16 i get c2r_s_u16 i
  end
  for i ulong 320
    put c2r_r_h i get c2r_s_h i
  end
  for i ulong 2
    put c2r_r_ep i get c2r_s_ep i
  end
  for i ulong 64
    put c2r_r_sig i get c2r_s_sig i
  end
  ret e
end

fn c2r_eq32_global_test_pk pk view uchar 32 to bool
  for i ulong 32
    if ne get pk i get c2r_test_pk i
      ret false
    end
  end
  ret true
end

fn c2r_eq32_global_owner_pk pk view uchar 32 to bool
  for i ulong 32
    if ne get pk i get c2r_owner_root_pk i
      ret false
    end
  end
  ret true
end

note Sign active c2r_r_* with TEST seed; result in c2r_buf[0..416)
fn c2r_sign_test seed view uchar 32 to long
  c2r_init_keys
  bad_cls = false
  note GUARD:sign-test-class-only
  bad_cls = ne get c2r_r_u16 1 C2R_CLASS_TEST
  if bad_cls
    ret C2R_E_KEY_CLASS
  end
  pk = new uchar 32 0
  ues_pubkey seed pk
  bad_key = false
  note GUARD:sign-test-key-only
  bad_key = not c2r_eq32_global_test_pk pk
  if bad_key
    ret C2R_E_KEY_CLASS
  end
  e = c2r_fields_ok
  if ne e C2R_OK
    ret e
  end
  for i ulong 32
    put sh_dat i get pk i
  end
  sh_all 32
  for i ulong 32
    put c2r_r_h add 288 i get sh_dig i
  end
  for i ulong 64
    put c2r_r_sig i 0
  end
  c2r_encode
  c2r_signed_message
  sg = new uchar 64 0
  c2r_sign_msg65 seed sg
  for i ulong 64
    put c2r_r_sig i get sg i
    put c2r_buf add 352 i get sg i
  end
  ret C2R_OK
end

note Attach signature sg for public key pk to active c2r_r_*; verifies and encodes into c2r_buf
fn c2r_attach pk view uchar 32 sg view uchar 64 to long
  c2r_init_keys
  e = c2r_fields_ok
  if ne e C2R_OK
    ret e
  end
  for i ulong 32
    put sh_dat i get pk i
  end
  sh_all 32
  for i ulong 32
    put c2r_r_h add 288 i get sh_dig i
  end
  for i ulong 64
    put c2r_r_sig i get sg i
  end
  c2r_encode
  c2r_signed_message
  if not c2r_verify_msg65 pk sg
    ret C2R_E_BAD_SIGNATURE
  end
  ret C2R_OK
end

note Find anchor in test set (which=0) or owner set (which=1) matching c2r_r_h[288..320); writes pk into dst
fn c2r_anchor_find which ulong dst edit uchar 32 to bool
  n = get c2r_pol_ntest 0
  if eq which 1
    n = get c2r_pol_nowner 0
  end
  for i ulong n bound 16
    base = mul i 32
    for j ulong 32
      if eq which 0
        put sh_dat j get c2r_pol_test add base j
      else
        put sh_dat j get c2r_pol_owner add base j
      end
    end
    sh_all 32
    eq_fp = true
    for j ulong 32
      if ne get sh_dig j get c2r_r_h add 288 j
        eq_fp = false
      end
    end
    if eq_fp
      for j ulong 32
        if eq which 0
          put dst j get c2r_pol_test add base j
        else
          put dst j get c2r_pol_owner add base j
        end
      end
      ret true
    end
  end
  ret false
end

note Check if 32-byte value is in policy list: which=0 rev_id, 1 rev_key, 2 checkers
fn c2r_in_pol_set which ulong val view uchar 32 to bool
  n = get c2r_pol_nrev_id 0
  if eq which 1
    n = get c2r_pol_nrev_key 0
  end
  if eq which 2
    n = get c2r_pol_nchk 0
  end
  for i ulong n bound 16
    base = mul i 32
    eq_v = true
    for j ulong 32
      b = uchar 0
      if eq which 0
        b = get c2r_pol_rev_id add base j
      end
      if eq which 1
        b = get c2r_pol_rev_key add base j
      end
      if eq which 2
        b = get c2r_pol_chk add base j
      end
      if ne b get val j
        eq_v = false
      end
    end
    if eq_v
      ret true
    end
  end
  ret false
end

fn c2r_ex_mismatch ex_idx ulong rh_off ulong to bool
  base = mul ex_idx 32
  for i ulong 32
    if ne get c2r_ex_h add base i get c2r_r_h add rh_off i
      ret true
    end
  end
  ret false
end

fn c2r_verify_bindings to long
  if eq get c2r_ex_has 0 0
    ret C2R_OK
  end
  if ne get c2r_ex_has 1 0
    bad = false
    note GUARD:target
    bad = c2r_ex_mismatch 0 C2RH_TGT
    if bad
      ret C2R_E_WRONG_TARGET
    end
  end
  if ne get c2r_ex_has 2 0
    bad = false
    note GUARD:firmware
    bad = c2r_ex_mismatch 1 C2RH_FW
    if bad
      ret C2R_E_WRONG_FIRMWARE
    end
  end
  if ne get c2r_ex_has 3 0
    bad = false
    note GUARD:program
    bad = c2r_ex_mismatch 2 C2RH_PROG
    if bad
      ret C2R_E_PROGRAM_MISMATCH
    end
  end
  if ne get c2r_ex_has 4 0
    bad = false
    note GUARD:executable
    bad = c2r_ex_mismatch 3 C2RH_EXE
    if bad
      ret C2R_E_EXECUTABLE_MISMATCH
    end
  end
  if ne get c2r_ex_has 5 0
    bad = false
    note GUARD:producer
    bad = c2r_ex_mismatch 4 C2RH_PCHK
    if bad
      ret C2R_E_WRONG_PRODUCER
    end
  end
  if ne get c2r_ex_has 6 0
    bad = false
    note GUARD:dependencies
    bad = c2r_ex_mismatch 5 C2RH_DEPS
    if bad
      ret C2R_E_DEPS_MISMATCH
    end
  end
  ret C2R_OK
end

fn c2r_verify_signer to long
  prod = ne get c2r_pol_prod 0 0
  cls = get c2r_r_u16 1
  bad_prod = false
  note GUARD:production-class
  bad_prod = and prod ne cls C2R_CLASS_OWNER
  if bad_prod
    ret C2R_E_TEST_IN_PRODUCTION
  end
  key = new uchar 32 0
  have_key = false
  if eq cls C2R_CLASS_TEST
    have_key = c2r_anchor_find 0 key
  else
    have_key = c2r_anchor_find 1 key
    if have_key
      if prod
        not_root = false
        note GUARD:production-root
        not_root = not c2r_eq32_global_owner_pk key
        if not_root
          have_key = false
        end
      end
    end
  end
  no_anchor = false
  note GUARD:anchor
  no_anchor = not have_key
  if no_anchor
    ret C2R_E_UNTRUSTED_SIGNER
  end
  dummy = new uchar 32 0
  other = false
  if eq cls C2R_CLASS_TEST
    other = c2r_anchor_find 1 dummy
  else
    other = c2r_anchor_find 0 dummy
  end
  cross_bad = false
  note GUARD:cross-class
  cross_bad = other
  if cross_bad
    ret C2R_E_UNTRUSTED_SIGNER
  end
  c2r_signed_message
  sg = new uchar 64 0
  for i ulong 64
    put sg i get c2r_r_sig i
  end
  sig_bad = false
  note GUARD:signature
  sig_bad = not c2r_verify_msg65 key sg
  if sig_bad
    ret C2R_E_BAD_SIGNATURE
  end
  ret C2R_OK
end

fn c2r_verify_rev_fresh to long
  tmp = new uchar 32 0
  c2r_id tmp
  bad = false
  note GUARD:revoked-id
  bad = c2r_in_pol_set 0 tmp
  if bad
    ret C2R_E_REVOKED
  end
  for i ulong 32
    put tmp i get c2r_r_h add 288 i
  end
  bad = false
  note GUARD:revoked-key
  bad = c2r_in_pol_set 1 tmp
  if bad
    ret C2R_E_REVOKED
  end
  pe = get c2r_r_ep 0
  xe = get c2r_r_ep 1
  flr = get c2r_pol_floor 0
  cur = get c2r_pol_cur 0
  bad = false
  note GUARD:stale
  bad = lt pe flr
  if bad
    ret C2R_E_STALE
  end
  bad = false
  note GUARD:not-yet-valid
  bad = lt cur pe
  if bad
    ret C2R_E_NOT_YET_VALID
  end
  bad = false
  note GUARD:expired
  bad = gt cur xe
  if bad
    ret C2R_E_EXPIRED
  end
  for i ulong 32
    put tmp i get c2r_r_h add C2RH_CHK i
  end
  bad = false
  note GUARD:checker-identity
  bad = not c2r_in_pol_set 2 tmp
  if bad
    ret C2R_E_UNTRUSTED_CHECKER
  end
  ret C2R_OK
end

note Full admission check on c2r_buf[0..blen) under c2r_pol_* and c2r_ex_*
fn c2r_verify blen ulong to long
  c2r_init_keys
  e = c2r_decode blen
  if ne e C2R_OK
    ret e
  end
  e = c2r_verify_signer
  if ne e C2R_OK
    ret e
  end
  e = c2r_verify_rev_fresh
  if ne e C2R_OK
    ret e
  end
  ret c2r_verify_bindings
end

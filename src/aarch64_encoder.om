note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/aarch64_encoder.c (legacy AArch64 instruction
note encoder). Composes on om/aarch64/aarch64_om2.om.
om2

global g_a64_pos ulong 1
global g_a64_max ulong 1

fn a64_enc_put dst edit uchar * w long to long
  st = new ulong 2 0
  put st 0 get g_a64_pos 0
  put st 1 get g_a64_max 0
  rc = a64put dst st w
  put g_a64_pos 0 get st 0
  ret rc
end

fn aarch64_emit_add_reg dst edit uchar * sf ulong rd ulong rn ulong rm ulong to long
  ret a64_enc_put dst a64addreg sf rd rn rm
end

fn aarch64_emit_sub_reg dst edit uchar * sf ulong rd ulong rn ulong rm ulong to long
  ret a64_enc_put dst a64subreg sf rd rn rm
end

fn aarch64_emit_mul_reg dst edit uchar * sf ulong rd ulong rn ulong rm ulong to long
  ret a64_enc_put dst a64mulreg sf rd rn rm
end

fn aarch64_emit_and_reg dst edit uchar * sf ulong rd ulong rn ulong rm ulong to long
  ret a64_enc_put dst a64andreg sf rd rn rm
end

fn aarch64_emit_orr_reg dst edit uchar * sf ulong rd ulong rn ulong rm ulong to long
  ret a64_enc_put dst a64orrreg sf rd rn rm
end

fn aarch64_emit_eor_reg dst edit uchar * sf ulong rd ulong rn ulong rm ulong to long
  ret a64_enc_put dst a64eorreg sf rd rn rm
end

fn aarch64_emit_subs_reg dst edit uchar * sf ulong rd ulong rn ulong rm ulong to long
  ret a64_enc_put dst a64subsreg sf rd rn rm
end

fn aarch64_emit_mov_reg dst edit uchar * sf ulong rd ulong rm ulong to long
  ret a64_enc_put dst a64movreg sf rd rm
end

fn aarch64_emit_movz dst edit uchar * sf ulong rd ulong imm16 ulong sh ulong to long
  ret a64_enc_put dst a64movz sf rd imm16 sh
end

fn aarch64_emit_movk dst edit uchar * sf ulong rd ulong imm16 ulong sh ulong to long
  ret a64_enc_put dst a64movk sf rd imm16 sh
end

fn aarch64_emit_ret dst edit uchar * to long
  ret a64_enc_put dst a64ret
end

fn aarch64_emit_b dst edit uchar * imm26 long to long
  ret a64_enc_put dst a64b imm26
end

fn aarch64_emit_b_cond dst edit uchar * cond long imm19 long to long
  ret a64_enc_put dst a64bcond cond imm19
end

fn aarch64_emit_cbz dst edit uchar * sf ulong rt ulong imm19 long to long
  ret a64_enc_put dst a64cbz sf rt imm19
end

fn aarch64_emit_cbnz dst edit uchar * sf ulong rt ulong imm19 long to long
  ret a64_enc_put dst a64cbnz sf rt imm19
end

fn aarch64_emit_adr dst edit uchar * rd ulong imm21 long to long
  ret a64_enc_put dst a64adr rd imm21
end


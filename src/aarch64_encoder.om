fn aarch64_emit_strb_uoff dst edit uchar * rt ulong rn ulong uoff ulong to long
  ret a64_enc_put dst a64strbuoff rt rn uoff
end

fn aarch64_emit_ldr_post dst edit uchar * rt ulong rn ulong simm9 long to long
  ret a64_enc_put dst a64ldrpost rt rn simm9
end

fn aarch64_emit_str_post dst edit uchar * rt ulong rn ulong simm9 long to long
  ret a64_enc_put dst a64strpost rt rn simm9
end

fn aarch64_emit_ldr_x_post dst edit uchar * rt ulong rn ulong simm9 long to long
  ret a64_enc_put dst a64ldrxpost rt rn simm9
end

fn aarch64_emit_str_x_post dst edit uchar * rt ulong rn ulong simm9 long to long
  ret a64_enc_put dst a64strxpost rt rn simm9
end

fn aarch64_emit_subs_imm dst edit uchar * sf ulong rd ulong rn ulong imm12 ulong to long
  ret a64_enc_put dst a64subsimm sf rd rn imm12
end

  ret a64_enc_put dst a64ldruoff sf rt rn uoff
end

fn aarch64_emit_str_uoff dst edit uchar * sf ulong rt ulong rn ulong uoff ulong to long
  ret a64_enc_put dst a64struoff sf rt rn uoff

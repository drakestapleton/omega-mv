note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/omega_blackwell_qmd.c.
note Composes on om/gpu/bw_qmd.om.
om2

const OMEGA_BW_QMD_WORDS ulong 96
const OMEGA_BW_CBANK_DRIVER_WORDS ulong 224
const OMEGA_BW_CBANK_ARGS_WORDS ulong 7
const OMEGA_BW_CBANK_MATMUL_ARGS_WORDS ulong 10

fn bw_qmd_u32lo v ulong to uint
  ret uint and v 0xffffffff
end

fn bw_qmd_u32hi v ulong to uint
  ret uint and shr v 32 0xffffffff
end

fn bw_cbank_tpl_part1 dst edit uint 224 to void
  for i ulong 224
    put dst i 0
  end
  put dst 0 0x26420000
  put dst 1 0x00000003
  put dst 48 0x94fe5d00
  put dst 49 0xe811c39b
  put dst 62 0x000fffff
  put dst 64 0x20000000
  put dst 65 0x00000003
  put dst 66 0x22000000
  put dst 67 0x00000003
  put dst 68 0x24280000
  put dst 69 0x00000003
  put dst 70 0x24010000
  put dst 71 0x00000003
  put dst 80 0x00000001
  put dst 82 0x0400c000
  put dst 83 0x00000002
  put dst 91 0x00000400
  put dst 108 0x04ba32c8
  put dst 114 0x00000001
  put dst 118 0x00000120
  put dst 126 0x25b66900
  put dst 127 0x00000003
end

fn bw_cbank_tpl_part2 dst edit uint 224 to void
  put dst 128 0x00000001
  put dst 129 0x00000001
  put dst 130 0x00000001
  put dst 132 0x3f800000
  put dst 133 0x3f800000
  put dst 134 0x3f800000
  put dst 135 0x00000400
  put dst 136 0x00000001
  put dst 137 0x00000001
  put dst 138 0x00000001
  put dst 139 0x00000001
  put dst 148 0x04ba32c8
  put dst 154 0x00000001
  put dst 158 0x00000120
  put dst 166 0x25b66900
  put dst 167 0x00000003
  put dst 168 0x00000001
  put dst 169 0x00000001
  put dst 170 0x00000001
  put dst 172 0x3f800000
  put dst 173 0x3f800000
  put dst 174 0x3f800000
  put dst 175 0x00000400
end

fn bw_cbank_tpl_part3 dst edit uint 224 to void
  put dst 176 0x00000001
  put dst 177 0x00000001
  put dst 178 0x00000001
  put dst 179 0x00000001
  put dst 180 0x00000030
  put dst 183 0x01000000
  put dst 185 0x0000e9c0
  put dst 189 0x0000e9c0
  put dst 190 0x01000000
  put dst 191 0x0000e9bf
  put dst 210 0x24280380
  put dst 211 0x00000003
  put dst 212 0x2428039c
  put dst 213 0x00000003
  put dst 216 0x00000040
  put dst 217 0x00000001
  put dst 218 0x00000001
  put dst 220 0x00000001
  put dst 221 0x00000001
  put dst 222 0x00000001
  put dst 223 0x00fffdc0
end

fn omega_blackwell_build_qmd0 qmd0 edit uint 96 qmd0_va ulong qmd1_va ulong to long
  ign = qmd0_va
  rc = bw_qmd0 qmd0 qmd1_va
  if ne rc 0
    ret -1
  end
  ret 0
end

fn omega_blackwell_build_qmd1 qmd1 edit uint 96 cfg view ulong 16 to long
  rc = bw_qmd1 cfg qmd1
  if ne rc 0
    ret -1
  end
  ret 0
end

fn omega_blackwell_build_cbank_driver dst edit uint 224 cbank_va ulong to long
  bw_cbank_tpl_part1 dst
  bw_cbank_tpl_part2 dst
  bw_cbank_tpl_part3 dst
  put dst 68 bw_qmd_u32hi cbank_va
  put dst 69 bw_qmd_u32lo cbank_va
  a380 = add cbank_va 0x380
  a39c = add cbank_va 0x39c
  put dst 210 bw_qmd_u32hi a380
  put dst 211 bw_qmd_u32lo a380
  put dst 212 bw_qmd_u32hi a39c
  put dst 213 bw_qmd_u32lo a39c
  ret 0
end

fn omega_blackwell_build_cbank_driver_2d dst edit uint 224 cbank_va ulong tx uint ty uint gx uint gy uint to long
  rc = omega_blackwell_build_cbank_driver dst cbank_va
  if ne rc 0
    ret -1
  end
  if gt tx 0
    put dst 216 tx
  end
  if gt ty 0
    put dst 217 ty
  end
  if gt gx 0
    put dst 220 gx
  end
  if gt gy 0
    put dst 221 gy
  end
  ret 0
end

fn omega_blackwell_build_cbank_args dst edit uint 7 a_va ulong b_va ulong c_va ulong n uint to long
  put dst 0 bw_qmd_u32lo a_va
  put dst 1 bw_qmd_u32hi a_va
  put dst 2 bw_qmd_u32lo b_va
  put dst 3 bw_qmd_u32hi b_va
  put dst 4 bw_qmd_u32lo c_va
  put dst 5 bw_qmd_u32hi c_va
  put dst 6 n
  ret 0
end

fn omega_blackwell_build_cbank_args_matmul dst edit uint 10 vas view ulong 3 dims view uint 3 to long
  a_va = get vas 0
  b_va = get vas 1
  c_va = get vas 2
  put dst 0 bw_qmd_u32lo a_va
  put dst 1 bw_qmd_u32hi a_va
  put dst 2 bw_qmd_u32lo b_va
  put dst 3 bw_qmd_u32hi b_va
  put dst 4 bw_qmd_u32lo c_va
  put dst 5 bw_qmd_u32hi c_va
  put dst 6 get dims 0
  put dst 7 get dims 1
  put dst 8 get dims 2
  put dst 9 0
  ret 0
end

fn omega_blackwell_verify_qmd_invariants qmd1 view uint 96 to long
  rc = bw_qmd_verify qmd1
  if ne rc 0
    ret -1
  end
  ret 0
end

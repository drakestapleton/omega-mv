note SPDX-License-Identifier: Apache-2.0
note om/units.sh concatenates this OM-2 entry with the b3unit.om compression
note and tree functions. The legacy chunk ABI and this API share one source.
om2

export fn omega_blake3_hash input view uchar * digest out uchar 32 to void
  state = new ulong 448 0
  work = new ulong 128 0
  block = new uchar 64 0
  bytes = new uchar 1024 0
  initw work
  pos = ulong 0
  while gt sub len input pos 1024
    for i ulong 1024
      put bytes i get input add pos i
    end
    midchk work block state bytes
    pos = add pos 1024
  end
  count = sub len input pos
  for i ulong count
    put bytes i get input add pos i
  end
  lastchk work block state bytes count digest
end

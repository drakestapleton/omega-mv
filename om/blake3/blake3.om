note SPDX-License-Identifier: Apache-2.0
note blake3: BLAKE3 default (unkeyed, 32-byte) hash of one file (or stdin when no argument),
note 64 hex digits + newline on stdout. Pure seeded OM-2 streaming implementation.
note Uses 32-bit uint state words with native OM-2 rotr and a 64 KiB I/O read buffer,
note removing the legacy 16 MiB static BSS buffer and file-size cap.
note 1024-byte chunks of 64-byte blocks, a binary tree of parents (stack depth <= 54, up to 16 EiB),
note the ROOT flag on the last compression only. Exit 65 when the file cannot be read, 74 on stdout error.
note usage: blake3 [FILE]
om2

text tbad "blake3: cannot read input\n"

global io uchar 65536
global cbuf uchar 1024
global clen ulong 1
global cctr ulong 1
global iv uint 8
global perm ulong 16
global m uint 16
global mt uint 16
global s uint 16
global co uint 16
global ncv uint 8
global blk uchar 64
global nb ulong 3
global cvr uint 8
global stk uint 512
global sp ulong 1
global name uchar 4096
global hex uchar 65

const cstart ulong 1
const cend ulong 2
const parent ulong 4
const root ulong 8

fn initiv to void
put iv 0 0x6a09e667
put iv 1 0xbb67ae85
put iv 2 0x3c6ef372
put iv 3 0xa54ff53a
put iv 4 0x510e527f
put iv 5 0x9b05688c
put iv 6 0x1f83d9ab
put iv 7 0x5be0cd19
end

fn initperm to void
put perm 0 2
put perm 1 6
put perm 2 3
put perm 3 10
put perm 4 7
put perm 5 0
put perm 6 4
put perm 7 13
put perm 8 1
put perm 9 11
put perm 10 12
put perm 11 5
put perm 12 9
put perm 13 14
put perm 14 15
put perm 15 8
end

note the G mixing function on state words a b c d with message words mx my (native OM-2 uint rotr)
fn g a ulong b ulong c ulong d ulong mx uint my uint to void
put s a add add get s a get s b mx
put s d rotr xor get s d get s a uint 16
put s c add get s c get s d
put s b rotr xor get s b get s c uint 12
put s a add add get s a get s b my
put s d rotr xor get s d get s a uint 8
put s c add get s c get s d
put s b rotr xor get s b get s c uint 7
end

fn round to void
g 0 4 8 12 get m 0 get m 1
g 1 5 9 13 get m 2 get m 3
g 2 6 10 14 get m 4 get m 5
g 3 7 11 15 get m 6 get m 7
g 0 5 10 15 get m 8 get m 9
g 1 6 11 12 get m 10 get m 11
g 2 7 8 13 get m 12 get m 13
g 3 4 9 14 get m 14 get m 15
end

fn permute to void
for i ulong 16 unroll
put mt i get m get perm i
end
for i ulong 16 unroll
put m i get mt i
end
end

note load the 16 little-endian words of blk into m
fn loadm to void
for i ulong 16 unroll
o = mul i 4
v = uint get blk add o 3
v = or shl v 8 uint get blk add o 2
v = or shl v 8 uint get blk add o 1
v = or shl v 8 uint get blk o
put m i v
end
end

note compress the node (ncv, blk, nb = block_len counter flags) into co (16 words);
note co 0..7 is the chaining value
fn compress to void
loadm
for i ulong 8 unroll
put s i get ncv i
put s add i 8 get iv i
end
ctr = get nb 1
put s 12 uint and ctr 0xffffffff
put s 13 uint shr ctr 32
put s 14 uint get nb 0
put s 15 uint get nb 2
for r ulong 7
round
permute
end
for i ulong 8 unroll
put co i xor get s i get s add i 8
put co add i 8 xor get s add i 8 get ncv i
end
end

note chaining value of the node into cvr
fn nodecv to void
compress
for i ulong 8 unroll
put cvr i get co i
end
end

note copy cnt bytes of cbuf from offset o into blk, zero the rest
fn loadblk o ulong cnt ulong to void
for i ulong 64
if lt i cnt
put blk i get cbuf add o i
else
put blk i 0
end
end
end

note prepare the unfinished last compression of chunk ctr holding cbuf[0 .. cnt)
fn chunk cnt ulong ctr ulong to void
for i ulong 8 unroll
put ncv i get iv i
end
nblk = ulong 1
if gt cnt 0
nblk = div add cnt 63 64
end
b = ulong 0
while lt add b 1 nblk bound 16
loadblk mul b 64 64
put nb 0 64
put nb 1 ctr
put nb 2 0
if eq b 0
put nb 2 cstart
end
compress
for i ulong 8 unroll
put ncv i get co i
end
b = add b 1
end
bo = mul sub nblk 1 64
rest = sub cnt bo
loadblk bo rest
put nb 0 rest
put nb 1 ctr
put nb 2 cend
if eq nblk 1
put nb 2 or cend cstart
end
end

note parent node of stk row r (left) and cvr (right)
fn parentn r ulong to void
for i ulong 8 unroll
put ncv i get iv i
end
for i ulong 8
l = get stk add mul r 8 i
v = get cvr i
for k ulong 4 unroll
sh = uint mul k 8
put blk add mul i 4 k uchar and shr l sh 255
put blk add 32 add mul i 4 k uchar and shr v sh 255
end
end
put nb 0 64
put nb 1 0
put nb 2 parent
end

fn push to void
p = get sp 0
for i ulong 8 unroll
put stk add mul p 8 i get cvr i
end
put sp 0 add p 1
end

note flush a full non-final 1024-byte chunk in cbuf and merge completed subtrees
fn flushchunk to void
c = get cctr 0
chunk 1024 c
nodecv
tot = add c 1
put cctr 0 tot
while eq and tot 1 0 bound 64
put sp 0 sub get sp 0 1
parentn get sp 0
nodecv
tot = shr tot 1
end
push
put clen 0 0
end

note feed io[0 .. cnt) into the streaming chunker (never flushes the last chunk before EOF)
fn feed cnt ulong to void
pos = ulong 0
while lt pos cnt bound 65536
if eq get clen 0 1024
flushchunk
end
cur = get clen 0
take = sub 1024 cur
rem_b = sub cnt pos
if lt rem_b take
take = rem_b
end
for i ulong take bound 1024
put cbuf add cur i get io add pos i
end
put clen 0 add cur take
pos = add pos take
end
end

note stream the entire descriptor in 64 KiB reads; 0 ok, 65 read error
fn streamfd fd int to int
while true bound 1000000000
r = read fd io 0 len io
if lt r 0
ret 65
end
if eq r 0
break
end
feed ulong r
end
ret 0
end

note finalize the last chunk in cbuf[0 .. clen) and fold all pending stack CVs with ROOT on the last node
fn finalize to void
chunk get clen 0 get cctr 0
while gt get sp 0 0 bound 64
nodecv
put sp 0 sub get sp 0 1
parentn get sp 0
end
put nb 2 or get nb 2 root
compress
end

fn hexd v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end

note little-endian bytes of co 0..7 as 64 hex digits
fn emit to int
for i ulong 8
v = ulong get co i
for k ulong 4
bt = and shr v mul k 8 255
p = add mul i 8 mul k 2
put hex p hexd shr bt 4
put hex add p 1 hexd and bt 15
end
end
put hex 64 10
off = ulong 0
while lt off 65 bound 65
r = write 1 hex off sub 65 off
if le r 0
ret 74
end
off = add off ulong r
end
ret 0
end

fn main to int
initiv
initperm
fd = int 0
if ge argcnt 2
l = argread 1 name 0 4095
if lt l 1
r = write 2 tbad 0 len tbad
ret 65
end
fd = int fopen name 0 ulong l 0 0
if lt fd 0
r = write 2 tbad 0 len tbad
ret 65
end
end
e = streamfd fd
if ne e 0
r = write 2 tbad 0 len tbad
ret 65
end
finalize
ret emit
end

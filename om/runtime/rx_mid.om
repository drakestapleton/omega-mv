om2
note rx_mid.om -- Canonical AIEN Machine ID codec, comparison, and hashing in pure OM-2.
note Replaces the pure byte-codec, hex-codec, equality, ordering, and hash logic
note of src/runtime/aien_machine_id.h and src/runtime/aien_machine_id.c.

const MID_OK long 0
const MID_E_ARG long -1
const MID_E_ZERO long -2
const MID_E_FORMAT long -3
const MID_E_CHECK long -4

fn is_zero_32 buf view uchar 32 to ulong
  acc = uchar 0
  for i ulong 32
    acc = or acc get buf i
  end
  if eq acc 0
    ret 1
  end
  ret 0
end

fn root_valid r ulong to ulong
  if eq r 1
    ret 1
  end
  if eq r 2
    ret 1
  end
  if eq r 3
    ret 1
  end
  ret 0
end

fn hex_nibble c uchar to long
  if ge c 48
    if le c 57
      ret long sub c 48
    end
  end
  if ge c 97
    if le c 102
      ret add long sub c 97 10
    end
  end
  ret -1
end

fn nibble_hex v uchar to uchar
  if lt v 10
    ret add v 48
  end
  ret add sub v 10 97
end

export fn rx_mid_is_zero buf view uchar 32 to ulong
  ret is_zero_32 buf
end

export fn rx_mid_equal a view uchar 32 b view uchar 32 to ulong
  for i ulong 32
    if ne get a i get b i
      ret 0
    end
  end
  ret 1
end

export fn rx_mid_compare a view uchar 32 b view uchar 32 to long
  for i ulong 32
    va = get a i
    vb = get b i
    if lt va vb
      ret -1
    end
    if gt va vb
      ret 1
    end
  end
  ret 0
end

export fn rx_mid_hash buf view uchar 32 to ulong
  h = ulong 0
  for i ulong 8
    b = ulong get buf i
    h = or shl h 8 b
  end
  ret h
end

note Pack the 40-byte header+id prefix of an AMID record (caller fills check bytes 40..43).
export fn rx_mid_pack_hdr root ulong id view uchar 32 rec edit uchar 44 to long
  if eq root_valid root 0
    ret MID_E_ARG
  end
  if eq is_zero_32 id 1
    ret MID_E_ZERO
  end
  put rec 0 uchar 65
  put rec 1 uchar 77
  put rec 2 uchar 73
  put rec 3 uchar 68
  put rec 4 uchar 1
  put rec 5 uchar and root 255
  put rec 6 uchar 0
  put rec 7 uchar 0
  for i ulong 32
    put rec add i 8 get id i
  end
  ret MID_OK
end

note Validate a 44-byte AMID record against expected 4-byte SHA-256 check prefix.
note On success, writes dst[0]=root and dst[1..32]=id.
export fn rx_mid_val_rec rec view uchar 44 chk view uchar 4 dst edit uchar 33 to long
  if ne get rec 0 65
    ret MID_E_FORMAT
  end
  if ne get rec 1 77
    ret MID_E_FORMAT
  end
  if ne get rec 2 73
    ret MID_E_FORMAT
  end
  if ne get rec 3 68
    ret MID_E_FORMAT
  end
  if ne get rec 4 1
    ret MID_E_FORMAT
  end
  if ne get rec 6 0
    ret MID_E_FORMAT
  end
  if ne get rec 7 0
    ret MID_E_FORMAT
  end
  r = ulong get rec 5
  if eq root_valid r 0
    ret MID_E_FORMAT
  end
  for i ulong 4
    if ne get rec add i 40 get chk i
      ret MID_E_CHECK
    end
  end
  acc = uchar 0
  for j ulong 32
    b = get rec add j 8
    acc = or acc b
    put dst add j 1 b
  end
  if eq acc 0
    ret MID_E_ZERO
  end
  put dst 0 get rec 5
  ret MID_OK
end

note Encode 44 raw bytes to 88 lowercase hex ASCII bytes.
export fn rx_mid_to_hex rec view uchar 44 hex edit uchar 88 to void
  for i ulong 44
    v = get rec i
    hi = shr v 4
    lo = and v 15
    put hex mul i 2 nibble_hex hi
    put hex add mul i 2 1 nibble_hex lo
  end
end

note Decode 88 lowercase hex ASCII bytes to 44 raw bytes.
export fn rx_mid_from_hex hex view uchar 88 rec edit uchar 44 to long
  for i ulong 44
    hi = hex_nibble get hex mul i 2
    if lt hi 0
      ret MID_E_FORMAT
    end
    lo = hex_nibble get hex add mul i 2 1
    if lt lo 0
      ret MID_E_FORMAT
    end
    bv = or shl ulong hi 4 ulong lo
    put rec i uchar and bv 255
  end
  ret MID_OK
end

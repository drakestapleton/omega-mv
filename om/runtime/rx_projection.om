om2
note rx_projection.om -- Cognitive state projection core in pure OM-2.
note Replaces pj_summarize, section_of, and form_of in src/runtime/rx_projection.c.

const U64_MAX ulong 18446744073709551615

const CX_CLAIM ulong 2
const CX_EVIDENCE ulong 6

const PJ_LIVE ulong 2
const PJ_RECALLABLE ulong 4
const PJ_COMPRESSIBLE ulong 5
const PJ_REFERENCE_ONLY ulong 6

const PJ_T_LATEST ulong 2

const PJ_SEC_WORLD ulong 1
const PJ_SEC_CORTEX ulong 2
const PJ_SEC_HYPOTHESIS ulong 3
const PJ_SEC_EVIDENCE ulong 4

const PJ_FORM_FULL ulong 1
const PJ_FORM_SUMMARY ulong 2
const PJ_FORM_REF ulong 3

note Compute [count, sum, sum_sq, min, max] over w[0..len-1] into dst[0..4].
export fn rx_pj_summarize w view ulong * dst edit ulong 5 to void
  n = len w
  s = ulong 0
  sq = ulong 0
  mn = U64_MAX
  mx = ulong 0
  note The public C count is uint32_t.
  for i ulong n bound 4294967295
    v = get w i
    s = add s v
    sq = add sq mul v v
    if lt v mn
      mn = v
    end
    if gt v mx
      mx = v
    end
  end
  put dst 0 n
  put dst 1 s
  put dst 2 sq
  if eq n 0
    put dst 3 0
  else
    put dst 3 mn
  end
  put dst 4 mx
end

note Classify a Cortex object into its projection section.
export fn rx_pj_section_of protect ulong cls ulong treatment ulong temporal ulong to ulong
  if eq treatment PJ_LIVE
    if eq temporal PJ_T_LATEST
      ret PJ_SEC_WORLD
    end
  end
  if ne protect 0
    ret PJ_SEC_EVIDENCE
  end
  if eq cls CX_EVIDENCE
    ret PJ_SEC_EVIDENCE
  end
  if eq cls CX_CLAIM
    ret PJ_SEC_HYPOTHESIS
  end
  ret PJ_SEC_CORTEX
end

note Map treatment class to representation form (FULL, SUMMARY, REF).
export fn rx_pj_form_of treatment ulong to ulong
  if eq treatment PJ_COMPRESSIBLE
    ret PJ_FORM_SUMMARY
  end
  if eq treatment PJ_RECALLABLE
    ret PJ_FORM_REF
  end
  if eq treatment PJ_REFERENCE_ONLY
    ret PJ_FORM_REF
  end
  ret PJ_FORM_FULL
end

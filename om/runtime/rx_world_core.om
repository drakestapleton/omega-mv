om2
note rx_world_core.om -- Reaction World lifecycle FSM, resource admission,
note and priority/fairness ordering in pure OM-2.
note Replaces rx_state_transition_legal, res_fits, and better_admit
note in src/runtime/rx_world.c.
note
note RxState enum:
note   0 DORMANT, 1 READY, 2 BLOCKED_AUTHORITY, 3 BLOCKED_RESOURCE,
note   4 RUNNING, 5 PUBLISHING, 6 COMMITTED, 7 INVALIDATED,
note   8 FAILED, 9 CANCELLED, 10 CONFLICT, 11 REJECTED.

const ST_DORMANT ulong 0
const ST_READY ulong 1
const ST_BLOCKED_AUTH ulong 2
const ST_BLOCKED_RES ulong 3
const ST_RUNNING ulong 4
const ST_PUBLISHING ulong 5
const ST_COMMITTED ulong 6
const ST_INVALIDATED ulong 7
const ST_FAILED ulong 8
const ST_CANCELLED ulong 9
const ST_CONFLICT ulong 10
const ST_REJECTED ulong 11

export fn rx_world_state_legal from ulong dest ulong to ulong
  if eq from ST_DORMANT
    if eq dest ST_READY
      ret 1
    end
    if eq dest ST_BLOCKED_RES
      ret 1
    end
    ret 0
  end
  if eq from ST_READY
    if eq dest ST_RUNNING
      ret 1
    end
    if eq dest ST_BLOCKED_AUTH
      ret 1
    end
    if eq dest ST_BLOCKED_RES
      ret 1
    end
    if eq dest ST_INVALIDATED
      ret 1
    end
    ret 0
  end
  if eq from ST_RUNNING
    if eq dest ST_PUBLISHING
      ret 1
    end
    if eq dest ST_FAILED
      ret 1
    end
    if eq dest ST_CANCELLED
      ret 1
    end
    if eq dest ST_INVALIDATED
      ret 1
    end
    if eq dest ST_READY
      ret 1
    end
    ret 0
  end
  if eq from ST_PUBLISHING
    if eq dest ST_COMMITTED
      ret 1
    end
    if eq dest ST_CONFLICT
      ret 1
    end
    if eq dest ST_REJECTED
      ret 1
    end
    if eq dest ST_INVALIDATED
      ret 1
    end
    ret 0
  end
  if eq from ST_BLOCKED_RES
    if eq dest ST_DORMANT
      ret 1
    end
    if eq dest ST_READY
      ret 1
    end
    ret 0
  end
  if ge from ST_COMMITTED
    if le from ST_REJECTED
      if eq dest ST_DORMANT
        ret 1
      end
      ret 0
    end
  end
  if eq from ST_BLOCKED_AUTH
    if eq dest ST_DORMANT
      ret 1
    end
    ret 0
  end
  ret 0
end

note used[3]:   0=used_slots, 1=used_memory, 2=used_energy
note budget[6]: 0=slots, 1=memory_bytes, 2=energy_budget, 3=offered_locality, 4=offered_accel, 5=compute_mask
note need[5]:   0=memory_bytes, 1=energy_cost, 2=locality, 3=accelerator_features, 4=compute_class
export fn rx_world_res_fits used view ulong 4 budget view ulong 6 need view ulong 5 to ulong
  if ge get used 0 get budget 0
    ret 0
  end
  umem = get used 1
  bmem = get budget 1
  if gt umem bmem
    ret 0
  end
  ueng = get used 2
  beng = get budget 2
  if gt ueng beng
    ret 0
  end
  if gt get need 0 sub bmem umem
    ret 0
  end
  if gt get need 1 sub beng ueng
    ret 0
  end
  nloc = get need 2
  if ne nloc 0
    if ne and nloc get budget 3 nloc
      ret 0
    end
  end
  nacc = get need 3
  if ne nacc 0
    if ne and nacc get budget 4 nacc
      ret 0
    end
  end
  ncc = get need 4
  if ne ncc 0
    bit = shl ulong 1 and ncc 31
    if eq and get budget 5 bit 0
      ret 0
    end
  end
  ret 1
end

note a[3], b[3]: 0=priority, 1=wait_seq, 2=service. Returns 1 if a beats b.
export fn rx_world_better_admit a view ulong 3 b view ulong 3 to ulong
  pa = get a 0
  pb = get b 0
  if ne pa pb
    if lt pa pb
      ret 1
    end
    ret 0
  end
  wa = get a 1
  wb = get b 1
  if ne wa wb
    if lt wa wb
      ret 1
    end
    ret 0
  end
  if lt get a 2 get b 2
    ret 1
  end
  ret 0
end

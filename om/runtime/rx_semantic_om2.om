om2
note SPDX-License-Identifier: AGPL-3.0-only
note Pure seeded OM-2 semantic incremental primitives backing src/runtime/rx_semantic.c:
note constant-time digest equality, 56-bit derived node ID packing, and input uniqueness check.

note Constant-time 32-byte digest comparison. Returns 1 if equal, 0 otherwise.
export fn rx_sem_digest_eq_om2 a view uchar 32 b view uchar 32 to ulong
  diff = ulong 0
  for i ulong 32
    diff = or diff xor ulong get a i ulong get b i
  end
  if eq diff 0
    ret 1
  end
  ret 0
end

note Pack (kind << 56) | le56(d[0..6]) into a 64-bit semantic node ID.
export fn rx_sem_node_id_from_hash d view uchar 32 kind ulong to ulong
  v = ulong 0
  for i ulong 7
    b = ulong get d i
    v = or v shl b mul i 8
  end
  ret or shl kind 56 v
end

note Verify no duplicate input semantic IDs in inputs[0..n-1]. Returns 1 if unique, 0 else.
export fn rx_sem_inputs_unique inputs view ulong * n ulong to ulong
  for i ulong n bound 64
    vi = get inputs i
    j = add i 1
    while lt j n bound 64
      if eq vi get inputs j
        ret 0
      end
      j = add j 1
    end
  end
  ret 1
end

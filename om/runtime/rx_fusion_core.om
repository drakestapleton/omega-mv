om2
note rx_fusion_core.om -- Workflow fusion eligibility and digest-word
note helpers in pure OM-2.
note Replaces eligible_kind and word64 in src/runtime/rx_fusion.c.

export fn rx_fus_word64 d view uchar 8 to ulong
  v = ulong 0
  for i ulong 8
    v = or shl v 8 ulong get d i
  end
  ret v
end

note AgKind eligibility for fusion fragments:
note   1 AG_CONST, 2 AG_PURE, 3 AG_WORLD_READ, 5 AG_RECALL,
note   7 AG_PHYSICAL, 8 AG_SKILL, 9 AG_EFFECT_PROPOSE, 11 AG_VERIFY, 14 AG_RETRY
export fn rx_fus_eligible_kind k ulong to ulong
  if eq k 1
    ret 1
  end
  if eq k 2
    ret 1
  end
  if eq k 3
    ret 1
  end
  if eq k 5
    ret 1
  end
  if eq k 7
    ret 1
  end
  if eq k 8
    ret 1
  end
  if eq k 9
    ret 1
  end
  if eq k 11
    ret 1
  end
  if eq k 14
    ret 1
  end
  ret 0
end

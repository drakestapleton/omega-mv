om2
note rx_plan_core.om -- Plan IR word packing, predicate sorting, and
note arrangement-domain fact pack/unpack in pure OM-2.
note Replaces pure logic in src/runtime/rx_plan.c and src/runtime/rx_plan_arrange.c.

note Read little-endian ulong word k (0..3) from 32-byte digest.
export fn rx_pl_word dig view uchar 32 k ulong to ulong
  if ge k 4
    ret 0
  end
  base = mul k 8
  v = ulong 0
  for i ulong 8
    b = ulong get dig add base i
    v = or v shl b mul i 8
  end
  ret v
end

note Pack arrangement fact: bit 63=1, x.id(0..7), x.gen(8..31),
note floor(62), t.id(32..39), t.gen(40..61).
export fn rx_pla_fact_pack xid ulong xgen ulong is_floor ulong tid ulong tgen ulong to ulong
  v = or shl ulong 1 63 and xid 255
  v = or v shl and xgen 16777215 8
  if ne is_floor 0
    ret or v shl ulong 1 62
  end
  v = or v shl and tid 255 32
  v = or v shl and tgen 4194303 40
  ret v
end

note Unpack arrangement fact into dst[0..4]: xid, xgen, is_floor, tid, tgen.
export fn rx_pla_fact_unpack f ulong dst edit ulong 5 to void
  put dst 0 and f 255
  put dst 1 and shr f 8 16777215
  put dst 2 and shr f 62 1
  put dst 3 and shr f 32 255
  put dst 4 and shr f 40 4194303
end

fn pred_gt buf view ulong 288 a ulong b ulong to ulong
  ia = mul a 6
  ib = mul b 6
  for k ulong 6
    va = get buf add ia k
    vb = get buf add ib k
    if gt va vb
      ret 1
    end
    if lt va vb
      ret 0
    end
  end
  ret 0
end

fn pred_swap buf edit ulong 288 a ulong b ulong to void
  ia = mul a 6
  ib = mul b 6
  for k ulong 6
    t = get buf add ia k
    put buf add ia k get buf add ib k
    put buf add ib k t
  end
end

note Insertion-sort up to 48 PlPreds packed as 6 ulongs each (kind, slot, field, slot2, type, value).
export fn rx_pl_sort_preds buf edit ulong 288 n ulong to void
  if le n 1
    ret
  end
  cnt = n
  if gt cnt 48
    cnt = ulong 48
  end
  i = ulong 1
  while lt i cnt bound 48
    j = i
    while gt j 0 bound 48
      jm = sub j 1
      if eq pred_gt buf jm j 0
        break
      end
      pred_swap buf jm j
      j = jm
    end
    i = add i 1
  end
end

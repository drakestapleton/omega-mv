om2
note rx_skillroute_core.om -- Skill Router rejection-class bitmask and
note digest-zero check in pure OM-2.
note Replaces why_of and digest_zero in src/runtime/rx_skillroute.c.

export fn rx_sr_digest_zero d view uchar 32 to ulong
  acc = uchar 0
  for i ulong 32
    acc = or acc get d i
  end
  if eq acc 0
    ret 1
  end
  ret 0
end

note counts[10]:
note   0 rejected_dead         -> 0x001
note   1 rejected_unavailable  -> 0x002
note   2 rejected_authority    -> 0x004
note   3 not_a_skill           -> 0x008
note   4 not_executable        -> 0x010
note   5 digest_mismatch       -> 0x020
note   6 remote_refused        -> 0x040
note   7 pin_mismatch          -> 0x080
note   8 machine_mismatch      -> 0x100
note   9 machine_unknown       -> 0x200
export fn rx_sr_why_of counts view ulong 10 to ulong
  w = ulong 0
  for i ulong 10
    if ne get counts i 0
      w = or w shl ulong 1 i
    end
  end
  ret w
end

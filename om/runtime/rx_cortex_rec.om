om2
note rx_cortex_rec.om -- World crumb to Cortex record classification,
note digest packing, and parent-link deduplication in pure OM-2.
note Replaces pure logic in src/runtime/rx_cortex_record.c.

const CX_ENTITY ulong 1
const CX_OBSERVATION ulong 3
const CX_EXECUTION ulong 4
const CX_FAILURE ulong 5

const CX_K_WORK_ACCEPTED ulong 65537
const CX_K_ENTITY_CREATED ulong 65538
const CX_K_ENTITY_RETIRED ulong 65539
const CX_K_EXEC_COMMIT ulong 65540
const CX_K_EXEC_NOOP ulong 65541
const CX_K_EXEC_FAILED ulong 65542

const CX_PROT_AUTHORITY ulong 1
const CX_PROT_COMMIT_RECEIPT ulong 2

note Map RxCrumbKind to (cls, kind, protect) in dst[0..2].
export fn rx_cx_kind_of ckind ulong dst edit ulong 4 to void
  put dst 2 0
  if eq ckind 2
    put dst 0 CX_OBSERVATION
    put dst 1 CX_K_WORK_ACCEPTED
    put dst 2 CX_PROT_AUTHORITY
    ret
  end
  if eq ckind 1
    put dst 0 CX_ENTITY
    put dst 1 CX_K_ENTITY_CREATED
    ret
  end
  if eq ckind 9
    put dst 0 CX_ENTITY
    put dst 1 CX_K_ENTITY_RETIRED
    ret
  end
  if eq ckind 3
    put dst 0 CX_EXECUTION
    put dst 1 CX_K_EXEC_COMMIT
    put dst 2 CX_PROT_COMMIT_RECEIPT
    ret
  end
  if eq ckind 8
    put dst 0 CX_EXECUTION
    put dst 1 CX_K_EXEC_NOOP
    ret
  end
  if eq ckind 5
    put dst 0 CX_FAILURE
    put dst 1 CX_K_EXEC_FAILED
    put dst 2 CX_PROT_AUTHORITY
    ret
  end
  put dst 0 CX_FAILURE
  put dst 1 CX_K_EXEC_FAILED
end

note Pack 32-byte digest into 4 little-endian ulong words.
export fn rx_cx_pack_digest dig view uchar 32 dst edit ulong 4 to void
  for i ulong 4
    v = ulong 0
    base = mul i 8
    for b ulong 8
      bv = ulong get dig add base b
      v = or v shl bv mul b 8
    end
    put dst i v
  end
end

note Deduplicate wake cause + parent Cortex IDs into dst[0..max_links-1].
note Returns count written (<= 8).
export fn rx_cx_dedup_links cause ulong parents view ulong * dst edit ulong 8 max_links ulong to ulong
  lim = max_links
  if gt lim 8
    lim = ulong 8
  end
  nl = ulong 0
  if ne cause 0
    if lt nl lim
      put dst nl cause
      nl = add nl 1
    end
  end
  np = len parents
  if gt np 1024
    np = ulong 1024
  end
  for i ulong np bound 1024
    if ge nl lim
      break
    end
    p = get parents i
    if eq p 0
      continue
    end
    dup = ulong 0
    for j ulong nl bound 8
      if eq get dst j p
        dup = ulong 1
        break
      end
    end
    if eq dup 0
      put dst nl p
      nl = add nl 1
    end
  end
  ret nl
end

om2
note SPDX-License-Identifier: AGPL-3.0-only
note Pure seeded OM-2 coherent projection primitives backing src/runtime/rx_coherent.c:
note Castagnoli CRC32C, ring message validation, required rights, and fault code mapping.

const CRC32C_POLY ulong 0x82f63b78
const U32_MASK ulong 0xffffffff

note Compute Castagnoli CRC32C over data[0..n-1].
export fn rx_coh_crc32c data view uchar * n ulong to ulong
  c = U32_MASK
  for i ulong n bound 65536
    b = ulong get data i
    c = xor c b
    for bit ulong 8
      low = and c 1
      c = shr c 1
      if ne low 0
        c = xor c CRC32C_POLY
      end
    end
  end
  ret and xor c U32_MASK U32_MASK
end

note Validate coherent ring message type. Returns 1 if valid, 0 otherwise.
export fn rx_coh_ring_msg t ulong to ulong
  if eq t 0x0003
    ret 1
  end
  if and ge t 0x0010 le t 0x0015
    ret 1
  end
  ret 0
end

note Return required capability right for ring message type: READ (1) or WRITE (2).
export fn rx_coh_msg_rights t ulong to ulong
  if eq t 0x0003
    ret 1
  end
  if or eq t 0x0010 eq t 0x0011
    ret 1
  end
  if or eq t 0x0013 eq t 0x0014
    ret 1
  end
  ret 2
end

note Map OMEGA_SW_FAULT_* / RX_FAULT_* to RX_ERR_*.
export fn rx_coh_fault_err fault ulong to long
  if or eq fault 0x0004 eq fault 0x0105
    ret -3
  end
  if eq fault 0x0005
    ret -21
  end
  if or eq fault 0x0008 eq fault 0x0103
    ret -22
  end
  if or eq fault 0x0007 or eq fault 0x0101 eq fault 0x0104
    ret -20
  end
  if eq fault 0x0102
    ret -4
  end
  if eq fault 0x0106
    ret -24
  end
  ret -23
end

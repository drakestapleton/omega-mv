om2
note rx_capq_core.om -- Capability Graph key hashing, dimension evaluation,
note Pareto dominance, strict ordering, and 128-bit tolerance band in pure OM-2.
note Replaces pure ranking/hashing logic in src/runtime/rx_capq.c.

const CQ_PPM ulong 1000000
const MASK32 ulong 4294967295
const MIX1 ulong 0x9e3779b97f4a7c15
const MIX2 ulong 0xbf58476d1ce4e5b9
const MIX3 ulong 0x94d049bb133111eb

fn dim_val vals view ulong 7 dim ulong to ulong
  if eq dim 0
    ret get vals 0
  end
  if eq dim 1
    ret get vals 1
  end
  if eq dim 2
    ret get vals 2
  end
  if eq dim 3
    c = get vals 3
    if ge c CQ_PPM
      ret 0
    end
    ret sub CQ_PPM c
  end
  if eq dim 4
    r = get vals 4
    if ge r CQ_PPM
      ret 0
    end
    ret sub CQ_PPM r
  end
  if eq dim 5
    if ne get vals 5 0
      ret 0
    end
    ret 1
  end
  if eq dim 6
    if ne get vals 6 0
      ret 0
    end
    ret 1
  end
  ret 0
end

fn mul128_hi a ulong b ulong to ulong
  a0 = and a MASK32
  a1 = shr a 32
  b0 = and b MASK32
  b1 = shr b 32
  p1 = mul a0 b1
  p2 = mul a1 b0
  mid = add shr mul a0 b0 32 and p1 MASK32
  mid = add mid and p2 MASK32
  hi = add mul a1 b1 shr p1 32
  hi = add hi shr p2 32
  ret add hi shr mid 32
end

fn mul128 a ulong b ulong dst edit ulong 2 to void
  put dst 0 mul a b
  put dst 1 mul128_hi a b
end

export fn rx_cq_key_hash cap_id ulong real_id ulong mach_id ulong skill_id ulong to ulong
  h = mul cap_id MIX1
  t1 = add add add real_id MIX2 shl h 6 shr h 2
  h = xor h t1
  t2 = add add add mach_id MIX3 shl h 6 shr h 2
  h = xor h t2
  t3 = add add add skill_id MIX1 shl h 6 shr h 2
  h = xor h t3
  ret and xor h shr h 32 MASK32
end

export fn rx_cq_dim_value vals view ulong 7 dim ulong to ulong
  ret dim_val vals dim
end

export fn rx_cq_dominates a view ulong 7 b view ulong 7 dims view uchar 7 nd ulong to ulong
  n = nd
  if gt n 7
    n = ulong 7
  end
  strict = ulong 0
  for i ulong n bound 7
    d = ulong get dims i
    x = dim_val a d
    y = dim_val b d
    if gt x y
      ret 0
    end
    if lt x y
      strict = ulong 1
    end
  end
  ret strict
end

note Strict lexicographic order over dims[0..nd-1], then 4 id tie-breakers in [7..10].
export fn rx_cq_cmp_full a view ulong 11 b view ulong 11 dims view uchar 7 nd ulong to long
  n = nd
  if gt n 7
    n = ulong 7
  end
  av = new ulong 7 0
  bv = new ulong 7 0
  for k ulong 7
    put av k get a k
    put bv k get b k
  end
  for i ulong n bound 7
    d = ulong get dims i
    x = dim_val av d
    y = dim_val bv d
    if lt x y
      ret -1
    end
    if gt x y
      ret 1
    end
  end
  for j ulong 4
    idx = add j 7
    ka = get a idx
    kb = get b idx
    if lt ka kb
      ret -1
    end
    if gt ka kb
      ret 1
    end
  end
  ret 0
end

note Exact 128-bit tolerance band: v * CQ_PPM <= best * (CQ_PPM + tol_ppm).
export fn rx_cq_within v ulong best ulong tol_ppm ulong to ulong
  lhs = new ulong 2 0
  rhs = new ulong 2 0
  mul128 v CQ_PPM lhs
  mul128 best add CQ_PPM tol_ppm rhs
  lhi = get lhs 1
  rhi = get rhs 1
  if lt lhi rhi
    ret 1
  end
  if gt lhi rhi
    ret 0
  end
  if le get lhs 0 get rhs 0
    ret 1
  end
  ret 0
end

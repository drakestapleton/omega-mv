om2
note rx_route_core.om -- Cognitive compute routing confidence binning and
note 95% Wilson score interval in pure OM-2.
note Replaces conf_bin, wilson_lower, wilson_upper in src/runtime/rx_route.c.

const WILSON_Z f64 1.959964

fn wilson_lo k ulong n ulong to f64
  if eq n 0
    ret 0.0f64
  end
  nn = f64 n
  p = div f64 k nn
  z2 = mul WILSON_Z WILSON_Z
  c = add p div z2 mul 2.0f64 nn
  t1 = div mul p sub 1.0f64 p nn
  t2 = div z2 mul 4.0f64 mul nn nn
  r = mul WILSON_Z fsqrt add t1 t2
  ret div sub c r add 1.0f64 div z2 nn
end

export fn rx_rt_conf_bin conf ulong conf_one ulong bins ulong to ulong
  if eq bins 0
    ret 0
  end
  if eq conf_one 0
    ret 0
  end
  if ge conf conf_one
    ret sub bins 1
  end
  ret div mul conf bins conf_one
end

note Compute 95% Wilson lower (dst[0]) and upper (dst[1]) bounds as bitcast ulong.
export fn rx_rt_wilson k ulong n ulong dst edit ulong 2 to void
  lo = wilson_lo k n
  hi = f64 1.0f64
  if ne n 0
    if le k n
      hi = sub 1.0f64 wilson_lo sub n k n
    end
  end
  put dst 0 bitcast ulong lo
  put dst 1 bitcast ulong hi
end

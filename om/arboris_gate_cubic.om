note SPDX-License-Identifier: AGPL-3.0-only
note Experimental cubic Hermite gate on unit intervals of |x|. Table rows
note hold s(i), s'(i), 3*(s(i+1)-s(i))-2*s'(i)-s'(i+1), and
note 2*(s(i)-s(i+1))+s'(i)+s'(i+1), for s(z)=1/(1+exp(z)).
note Initialize the 256-byte table once at model load. Reference v1 remains separate.
fn arboris_cubic_table coeff edit uint 64 to void
  put coeff 0 0x3f000000
  put coeff 1 0xbe800000
  put coeff 2 0x3b6131d3
  put coeff 3 0x3c7e09a0
  put coeff 4 0x3e89b2b1
  put coeff 5 0xbe4954a3
  put coeff 6 0x3d48b646
  put coeff 7 0xbb0b7ea4
  put coeff 8 0x3df420a9
  put coeff 9 0xbdd706e0
  put coeff 10 0x3d232799
  put coeff 11 0xbbd8cc44
  put coeff 12 0x3d4241a2
  put coeff 13 0xbd390b29
  put coeff 14 0x3ca15bae
  put coeff 15 0xbb81c338
  put coeff 16 0x3c9357d1
  put coeff 17 0xbc90b161
  put coeff 18 0x3c049a25
  put coeff 19 0xbae1f958
  put coeff 20 0x3bdb4fb4
  put coeff 21 0xbbd9d7f1
  put coeff 22 0x3b4b49e8
  put coeff 23 0xba30b6c9
  put coeff 24 0x3b220bbc
  put coeff 25 0xbb21a529
  put coeff 26 0x3a97d99c
  put coeff 27 0xb984f3cf
  put coeff 28 0x3a6ed39c
  put coeff 29 0xba6e9be9
  put coeff 30 0x39e0b29c
  put coeff 31 0xb8c54052
  put coeff 32 0x39afd1ef
  put coeff 33 0xb9afc2d7
  put coeff 34 0x3925a997
  put coeff 35 0xb8119130
  put coeff 36 0x3901637b
  put coeff 37 0xb9015f64
  put coeff 38 0x3873f589
  put coeff 39 0xb756712b
  put coeff 40 0x383e6997
  put coeff 41 0xb83e6761
  put coeff 42 0x37b38b7d
  put coeff 43 0xb69dd78b
  put coeff 44 0x378c1a08
  put coeff 45 0xb78c196e
  put coeff 46 0x37041d7f
  put coeff 47 0xb5e84d54
  put coeff 48 0x36ce2a0f
  put coeff 49 0xb6ce29bc
  put coeff 50 0x36426acd
  put coeff 51 0xb52aed80
  put coeff 52 0x3617b013
  put coeff 53 0xb617affd
  put coeff 54 0x358f0bd1
  put coeff 55 0xb47b873f
  put coeff 56 0x355f362c
  put coeff 57 0xb55f3620
  put coeff 58 0x34d27efc
  put coeff 59 0xb3b910c9
  put coeff 60 0x34a43ae2
  put coeff 61 0xb4a43ade
  put coeff 62 0x341adfe7
  put coeff 63 0xb30829fc
end

fn arboris_cubic_gate x f32 coeff view uint 64 to f32
  magnitude = fabs x
  tail = f32 0
  if lt magnitude f32 16
    interval = ulong magnitude
    offset = sub magnitude f32 interval
    index = mul 4 interval
    tail = fma offset f32of ulong get coeff add index 3 f32of ulong get coeff add index 2
    tail = fma offset tail f32of ulong get coeff add index 1
    tail = fma offset tail f32of ulong get coeff index
  end
  if lt x f32 0
    ret tail
  end
  ret sub f32 1 tail
end

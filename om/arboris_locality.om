note SPDX-License-Identifier: AGPL-3.0-only
note Cold loader for sparse StateGraph records. Caller supplies a community
note traversal order (or an empty view for logical order). Stable degree
note buckets preserve that ordering inside each band. The two permutations
note remain available for restoring external node handles and state planes.
fn al_valid records view uint * to bool
  if not ar_records_shape records
    ret false
  end
  arcs = mul 2 ulong get records 3
  ret eq ar_validate_records records add arcs add 4 ulong get records 2 arcs 0
end

fn al_degrees records view uint * plan edit uint * to void
  n = ulong get records 2
  pos = add 6 mul n 3
  for i ulong ulong get records 3 bound ar_u32_max
    a = add mul n 2 ulong get records pos
    b = add mul n 2 ulong get records add pos 2
    put plan a add get plan a 1
    put plan b add get plan b 1
    pos = add pos 4
  end
end

fn al_band degree uint to ulong
  band = ulong 0
  while ne degree 0 bound 32
    band = add band 1
    degree = shr degree 1
  end
  ret band
end

fn al_order order view uint * plan edit uint * n ulong to bool
  for i ulong n bound ar_u32_max
    logical = uint i
    if ne len order 0
      logical = get order i
    end
    if ge ulong logical n
      ret false
    end
    if ne get plan ulong logical 0xffffffff
      ret false
    end
    put plan ulong logical uint i
  end
  ret true
end

fn al_group order view uint * plan edit uint * n ulong to void
  next = new uint 33 0
  for i ulong n bound ar_u32_max
    band = al_band get plan add mul n 2 i
    put next band add get next band 1
  end
  pos = uint 0
  for i ulong 33
    count = get next i
    put next i pos
    pos = add pos count
  end
  for i ulong n bound ar_u32_max
    logical = uint i
    if ne len order 0
      logical = get order i
    end
    band = al_band get plan add mul n 2 ulong logical
    physical = get next band
    put next band add physical 1
    put plan ulong logical physical
    put plan add n ulong physical logical
  end
end

note Plan words: logical-to-physical, physical-to-logical, logical degree.
note A failed plan may contain scratch values and must be discarded.
fn arboris_plan_locality records view uint * order view uint * plan edit uint * to ulong
  if not al_valid records
    ret 1
  end
  n = ulong get records 2
  if or ne len plan mul 3 n and ne len order 0 ne len order n
    ret 2
  end
  for i ulong n bound ar_u32_max
    put plan i 0xffffffff
    put plan add mul n 2 i 0
  end
  if not al_order order plan n
    ret 3
  end
  al_degrees records plan
  al_group order plan n
  ret 0
end

fn al_permutation plan view uint * n ulong to bool
  if ne len plan mul 3 n
    ret false
  end
  for i ulong n bound ar_u32_max
    v = ulong get plan i
    if ge v n
      ret false
    end
    if ne ulong get plan add n v i
      ret false
    end
  end
  ret true
end

note Verify source and permutation before writing. Keep edge ordinal, relation
note and conductance together; the regular ontology loader then materializes
note both incident arcs in the reordered CSR.
fn arboris_pack_locality records view uint * plan view uint * packed edit uint * to ulong
  if or not al_valid records ne len records len packed
    ret 1
  end
  n = ulong get records 2
  if not al_permutation plan n
    ret 2
  end
  for i ulong 6
    put packed i get records i
  end
  for i ulong n bound ar_u32_max
    src = add 6 mul 3 ulong get plan add n i
    dst = add 6 mul 3 i
    for j ulong 3
      put packed add dst j get records add src j
    end
  end
  pos = add 6 mul 3 n
  for i ulong ulong get records 3 bound ar_u32_max
    put packed pos get plan ulong get records pos
    put packed add pos 1 get records add pos 1
    put packed add pos 2 get plan ulong get records add pos 2
    put packed add pos 3 get records add pos 3
    pos = add pos 4
  end
  ret 0
end

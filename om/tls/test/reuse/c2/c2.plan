# CRYPTO-REUSE-AGGREGATE 1 plan: checker2 NO-TRAP obligations (omega-mv #639, see README.md here)
# Run from the repository root. Each unit traps (code 1) exactly when its property fails, so
# "c2sat UNSAT + checker2 prove-check lrat=VERIFIED" == the property holds for every input value.
# c2sat is the untrusted solver; only checker2's own LRAT replay (prove-check) is believed.

# provenance: pinned compiler, checker2 and c2sat built from this tree, checker2 source identity
row c2-omc-pin control
exit 0
arg sha256sum
arg seed/out/omc
need 6d1b1cf5a44803389a831b67f750ea4cd1c9f53edfde9d6d9241d7352887f1f8  seed/out/omc
end

row c2-tools-build control
after c2-omc-pin
exit 0
arg make
arg -s
arg -j2
arg checker2
arg build/checker2/c2sat
empty
end

row c2-checker2-id control
after c2-tools-build
exit 0
arg build/checker2/checker2
arg version
need sources_sha256=c061a5edc68ed2df9355ee887662bc14a692c1ba1046c8750560e17c9c8993e5
end

row c2-scratch control
after c2-checker2-id
exit 0
arg mkdir
arg -p
arg build/tls/reuse/c2
empty
end

# prove-cnf never overwrites its output (O_EXCL): remove formulas and proofs of an earlier run
row c2-clean control
after c2-scratch
exit 0
arg rm
arg -f
arg build/tls/reuse/c2/xor-cancel.cnf
arg build/tls/reuse/c2/xor-cancel.lrat
arg build/tls/reuse/c2/xor-wrong-key.cnf
arg build/tls/reuse/c2/xor-wrong-key.lrat
arg build/tls/reuse/c2/counter-distinct.cnf
arg build/tls/reuse/c2/counter-distinct.lrat
arg build/tls/reuse/c2/counter-truncated.cnf
arg build/tls/reuse/c2/counter-truncated.lrat
empty
end

# obligation 1: xor (xor p1 k) (xor p2 k) == xor p1 p2 for all ulong p1 p2 k
row c2-xor-cancel-ir control
after c2-clean
in om/tls/test/reuse/c2/xor-cancel.om
out build/tls/reuse/c2/xor-cancel.ir
exit 0
arg seed/out/omc
empty
file om/tls/test/reuse/c2/xor-cancel.om
end

row c2-xor-cancel-check control
after c2-xor-cancel-ir
exit 0
arg build/checker2/checker2
arg check
arg build/tls/reuse/c2/xor-cancel.ir
need checker2=ACCEPT ir_sha256=8ebb8da7352ea061f291afb7f096fc43ea6c4ce762dbbc10b90685ee3eb3390f
end

row c2-xor-cancel-cnf control
after c2-xor-cancel-check
exit 0
arg build/checker2/checker2
arg prove-cnf
arg build/tls/reuse/c2/xor-cancel.ir
arg f
arg build/tls/reuse/c2/xor-cancel.cnf
need property=no-trap-except-requires func=f inputs=224 paths=2 trap_sites=1 vars=2540 clauses=7206
end

row c2-xor-cancel-sat control
after c2-xor-cancel-cnf
exit 20
arg build/checker2/c2sat
arg build/tls/reuse/c2/xor-cancel.cnf
arg build/tls/reuse/c2/xor-cancel.lrat
need s UNSATISFIABLE
end

row c2-xor-cancel-proof control
after c2-xor-cancel-sat
exit 0
arg build/checker2/checker2
arg prove-check
arg build/tls/reuse/c2/xor-cancel.ir
arg f
arg build/tls/reuse/c2/xor-cancel.lrat
need lrat=VERIFIED property=no-trap-except-requires func=f ir_sha256=8ebb8da7352ea061f291afb7f096fc43ea6c4ce762dbbc10b90685ee3eb3390f proof_sha256=
end

# mutant 1: the second keystream is xor k 1 (a different key); bit 0 never cancels
row c2-xor-wrong-key-ir control
after c2-clean
in om/tls/test/reuse/c2/xor-wrong-key.om
out build/tls/reuse/c2/xor-wrong-key.ir
exit 0
arg seed/out/omc
empty
file om/tls/test/reuse/c2/xor-wrong-key.om
end

row c2-xor-wrong-key-check control
after c2-xor-wrong-key-ir
exit 0
arg build/checker2/checker2
arg check
arg build/tls/reuse/c2/xor-wrong-key.ir
need checker2=ACCEPT ir_sha256=0ebd34c070065b4d23898cc31430bfa7515e19d0b35bbce8142c74e666c5f592
end

row c2-xor-wrong-key-cnf control
after c2-xor-wrong-key-check
exit 0
arg build/checker2/checker2
arg prove-cnf
arg build/tls/reuse/c2/xor-wrong-key.ir
arg f
arg build/tls/reuse/c2/xor-wrong-key.cnf
need property=no-trap-except-requires func=f inputs=224 paths=2 trap_sites=1 vars=2540 clauses=7206
end

# killed: the solver finds an input that reaches trap 1 (a survivor would exit 20, class INVALID)
row c2-xor-wrong-key-sat mutant
after c2-xor-wrong-key-cnf
exit 10
arg build/checker2/c2sat
arg build/tls/reuse/c2/xor-wrong-key.cnf
arg build/tls/reuse/c2/xor-wrong-key.lrat
need s SATISFIABLE
pass s UNSATISFIABLE
end

# killed: checker2 refuses the solver's output as a proof (a survivor exits 0 VERIFIED, class FAIL)
row c2-xor-wrong-key-proof mutant
after c2-xor-wrong-key-sat
exit 1
arg build/checker2/checker2
arg prove-check
arg build/tls/reuse/c2/xor-wrong-key.ir
arg f
arg build/tls/reuse/c2/xor-wrong-key.lrat
need lrat=REFUSED rule=LRAT-NO-EMPTY-CLAUSE line=1003
pass lrat=VERIFIED property=no-trap-except-requires func=f ir_sha256=0ebd34c070065b4d23898cc31430bfa7515e19d0b35bbce8142c74e666c5f592
end

# obligation 2: nonce = or (shl base 32) (and c 4294967295); distinct 32-bit counters give distinct nonces
row c2-counter-distinct-ir control
after c2-clean
in om/tls/test/reuse/c2/counter-distinct.om
out build/tls/reuse/c2/counter-distinct.ir
exit 0
arg seed/out/omc
empty
file om/tls/test/reuse/c2/counter-distinct.om
end

row c2-counter-distinct-check control
after c2-counter-distinct-ir
exit 0
arg build/checker2/checker2
arg check
arg build/tls/reuse/c2/counter-distinct.ir
need checker2=ACCEPT ir_sha256=5706b91a0184bda48b2ff5c2cdd5d4de036bb46e9a385f07429f6e93ea40416a
end

row c2-counter-distinct-cnf control
after c2-counter-distinct-check
exit 0
arg build/checker2/checker2
arg prove-cnf
arg build/tls/reuse/c2/counter-distinct.ir
arg f
arg build/tls/reuse/c2/counter-distinct.cnf
need property=no-trap-except-requires func=f inputs=224 paths=3 trap_sites=1 vars=1449 clauses=3835
end

row c2-counter-distinct-sat control
after c2-counter-distinct-cnf
exit 20
arg build/checker2/c2sat
arg build/tls/reuse/c2/counter-distinct.cnf
arg build/tls/reuse/c2/counter-distinct.lrat
need s UNSATISFIABLE
end

row c2-counter-distinct-proof control
after c2-counter-distinct-sat
exit 0
arg build/checker2/checker2
arg prove-check
arg build/tls/reuse/c2/counter-distinct.ir
arg f
arg build/tls/reuse/c2/counter-distinct.lrat
need lrat=VERIFIED property=no-trap-except-requires func=f ir_sha256=5706b91a0184bda48b2ff5c2cdd5d4de036bb46e9a385f07429f6e93ea40416a proof_sha256=
end

# mutant 2: the nonce keeps 31 counter bits (and c 2147483647); counters differing in bit 31 collide
row c2-counter-truncated-ir control
after c2-clean
in om/tls/test/reuse/c2/counter-truncated.om
out build/tls/reuse/c2/counter-truncated.ir
exit 0
arg seed/out/omc
empty
file om/tls/test/reuse/c2/counter-truncated.om
end

row c2-counter-truncated-check control
after c2-counter-truncated-ir
exit 0
arg build/checker2/checker2
arg check
arg build/tls/reuse/c2/counter-truncated.ir
need checker2=ACCEPT ir_sha256=7a31400cced531fc7c9a16d8b1d85c0ad198f9777706f18af0dcf34a3dba84e8
end

row c2-counter-truncated-cnf control
after c2-counter-truncated-check
exit 0
arg build/checker2/checker2
arg prove-cnf
arg build/tls/reuse/c2/counter-truncated.ir
arg f
arg build/tls/reuse/c2/counter-truncated.cnf
need property=no-trap-except-requires func=f inputs=224 paths=3 trap_sites=1 vars=1437 clauses=3794
end

row c2-counter-truncated-sat mutant
after c2-counter-truncated-cnf
exit 10
arg build/checker2/c2sat
arg build/tls/reuse/c2/counter-truncated.cnf
arg build/tls/reuse/c2/counter-truncated.lrat
need s SATISFIABLE
pass s UNSATISFIABLE
end

row c2-counter-truncated-proof mutant
after c2-counter-truncated-sat
exit 1
arg build/checker2/checker2
arg prove-check
arg build/tls/reuse/c2/counter-truncated.ir
arg f
arg build/tls/reuse/c2/counter-truncated.lrat
need lrat=REFUSED rule=LRAT-NO-EMPTY-CLAUSE line=1
pass lrat=VERIFIED property=no-trap-except-requires func=f ir_sha256=7a31400cced531fc7c9a16d8b1d85c0ad198f9777706f18af0dcf34a3dba84e8
end

ir
note counter-truncated mutant: the nonce keeps only 31 counter bits, so counters differing in bit 31 collide
fn f i uint base ulong c1 ulong c2 ulong to ulong
j = and i uint 31
d1 = and c1 ulong 4294967295
d2 = and c2 ulong 4294967295
n1 = or shl base 32 and c1 ulong 2147483647
n2 = or shl base 32 and c2 ulong 2147483647
if eq n1 n2
if ne and shr d1 j ulong 1 and shr d2 j ulong 1
trap 1
end
end
ret n1
end

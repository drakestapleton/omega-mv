note SPDX-License-Identifier: Apache-2.0
note fixture.om: self-test command for aggregate.om. `fixture STATUS LINE...` writes each LINE and a
note newline to stdout, then exits with STATUS (a canonical decimal 0..255; anything else exits 99).
global buf uchar 4096
global nl uchar 1
fn main to int
put nl 0 10
n = argread 1 buf 0 len buf
if or le n 0 gt n 3
ret 99
end
v = ulong 0
for i ulong ulong n
b = ulong get buf i
if or lt b 48 gt b 57
ret 99
end
v = add mul v 10 sub b 48
end
if or gt v 255 and gt n 1 eq get buf 0 48
ret 99
end
c = long argcnt
a = ulong 2
while lt long a c bound 1000
k = argread a buf 0 len buf
if lt k 0
ret 99
end
if ge k long len buf
ret 99
end
r = write 1 buf 0 ulong k
r = write 1 nl 0 1
a = add a 1
end
ret int v
end

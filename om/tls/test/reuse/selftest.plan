# selftest.plan: every classification branch of aggregate.om, each row with its expected class.
# build/tls/reuse/fixture (fixture.om) prints its arguments as lines and exits with the first.
# The L698 review findings have rows: F1 an unrelated failure that prints the intended marker
# (mut-unrelated) or a verbatim copy of the intended panic line next to an unrelated panic
# (mut-forged, caught by `once`), F2 a missing executable (ctl-missing-exe, mut-missing-exe), F3
# zero selected or skipped tests (ctl-zero-tests, mut-zero, mut-ignored). `once` itself:
# ctl-once-ok, ctl-once-none, ctl-once-twice.

row ctl-pass control
arg build/tls/reuse/fixture
arg 0
arg test a::b ... ok
exit 0
need test a::b ... ok
end

row ctl-fail control
arg build/tls/reuse/fixture
arg 1
arg test a::b ... FAILED
exit 0
need test a::b ... ok
want FAIL
end

row ctl-zero-tests control
arg build/tls/reuse/fixture
arg 0
arg running 0 tests
exit 0
need test a::b ... ok
want INVALID
end

row ctl-midline control
arg build/tls/reuse/fixture
arg 0
arg note: test a::b ... ok
exit 0
need test a::b ... ok
want INVALID
end

row ctl-empty-ok control
arg build/tls/reuse/fixture
arg 0
exit 0
empty
end

row ctl-empty-bad control
arg build/tls/reuse/fixture
arg 0
arg  M src/lib.rs
exit 0
empty
want INVALID
end

row ctl-missing-exe control
arg build/tls/reuse/no-such-program
exit 0
want INVALID
end

row ctl-deadline control
time 1
arg sleep
arg 5
exit 0
want INVALID
end

row ctl-signal control
time 5
arg timeout
arg --preserve-status
arg -s
arg KILL
arg 1
arg sleep
arg 10
exit 0
want INVALID
end

row ctl-big-log control
arg head
arg -c
arg 8388609
arg /dev/zero
exit 0
want INVALID
end

row ctl-no-cwd control
cwd build/tls/reuse/no-such-dir
arg build/tls/reuse/fixture
arg 0
exit 0
want NOT_RUN
end

row ctl-no-in control
in build/tls/reuse/no-such-file
arg build/tls/reuse/fixture
arg 0
exit 0
want NOT_RUN
end

row ctl-after-fail control
after ctl-fail
arg build/tls/reuse/fixture
arg 0
exit 0
want NOT_RUN
end

row ctl-after-pass control
after ctl-pass
cwd om/tls
in om/tls/test/reuse/fixture.om
arg ../../build/tls/reuse/fixture
arg 0
arg test a::b ... ok
exit 0
need test a::b ... ok
end

row ctl-env control
arg env
exit 0
need LC_ALL=C
end

row ctl-out control
out build/tls/reuse/selftest.out
arg build/tls/reuse/fixture
arg 0
arg to stdout
exit 0
empty
end

row ctl-digits control
arg build/tls/reuse/fixture
arg 0
arg thread 'a::b' (3941214) panicked at src/x.rs:16:13:
exit 0
need thread 'a::b' (#) panicked at src/x.rs:16:13:
end

row ctl-no-digits control
arg build/tls/reuse/fixture
arg 0
arg thread 'a::b' () panicked at src/x.rs:16:13:
exit 0
need thread 'a::b' (#) panicked at src/x.rs:16:13:
want INVALID
end

row ctl-fixture-bound control
file build/tls/reuse/fixture
arg build/tls/reuse/fixture
arg 0
exit 0
end

row ctl-fixture-missing control
file build/tls/reuse/no-such-fixture
arg build/tls/reuse/fixture
arg 0
exit 0
want INVALID
end

row ctl-once-ok control
arg build/tls/reuse/fixture
arg 0
arg test a::b ... ok
exit 0
need test a::b ... ok
once test 
end

row ctl-once-none control
arg build/tls/reuse/fixture
arg 0
arg test a::b ... ok
exit 0
need test a::b ... ok
once test result: 
want INVALID
end

row ctl-once-twice control
arg build/tls/reuse/fixture
arg 0
arg test a::b ... ok
arg test a::b ... ok
exit 0
need test a::b ... ok
once test 
want INVALID
end

row mut-killed mutant
arg build/tls/reuse/fixture
arg 101
arg test a::b ... FAILED
arg thread 'a::b' (77) panicked at src/x.rs:16:13:
exit 101
need test a::b ... FAILED
need thread 'a::b' (#) panicked at src/x.rs:16:13:
once thread '
pass test a::b ... ok
end

row mut-survived mutant
arg build/tls/reuse/fixture
arg 0
arg test a::b ... ok
exit 101
need test a::b ... FAILED
pass test a::b ... ok
want FAIL
end

row mut-unrelated mutant
arg build/tls/reuse/fixture
arg 101
arg note: expected test a::b ... FAILED at src/x.rs:16:13
arg thread 'a::b' (77) panicked at src/other.rs:5:1:
arg test a::b ... FAILED
exit 101
need test a::b ... FAILED
need thread 'a::b' (#) panicked at src/x.rs:16:13:
pass test a::b ... ok
want INVALID
end

row mut-forged mutant
arg build/tls/reuse/fixture
arg 101
arg test a::b ... FAILED
arg thread 'a::b' (77) panicked at src/x.rs:16:13:
arg thread 'a::b' (78) panicked at src/other.rs:5:1:
exit 101
need test a::b ... FAILED
need thread 'a::b' (#) panicked at src/x.rs:16:13:
once thread '
pass test a::b ... ok
want INVALID
end

row mut-zero mutant
arg build/tls/reuse/fixture
arg 0
arg running 0 tests
arg test result: ok. 0 passed; 0 failed; 0 ignored
exit 101
need test a::b ... FAILED
pass test a::b ... ok
want INVALID
end

row mut-ignored mutant
arg build/tls/reuse/fixture
arg 0
arg test a::b ... ignored
exit 101
need test a::b ... FAILED
pass test a::b ... ok
want INVALID
end

row mut-build-error mutant
arg build/tls/reuse/fixture
arg 101
arg error[E0308]: mismatched types
exit 101
need test a::b ... FAILED
pass test a::b ... ok
want INVALID
end

row mut-missing-exe mutant
arg build/tls/reuse/no-such-program
exit 101
need test a::b ... FAILED
pass test a::b ... ok
want INVALID
end

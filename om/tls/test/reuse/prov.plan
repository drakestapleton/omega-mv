# prov.plan: provenance rows of the #639 aggregate (this repository). Run from the repository root.
# The commit is not a `need` (a plan cannot name the commit that contains it); its log is hashed
# into the receipt and agg.sh prints it. The tree must be clean, so the receipt describes a commit.

row prov-head control
exit 0
arg git
arg rev-parse
arg HEAD
end

row prov-clean control
after prov-head
exit 0
arg git
arg status
arg --porcelain
arg --untracked-files=all
empty
end

row prov-omc control
exit 0
arg sha256sum
arg seed/out/omc
need 6d1b1cf5a44803389a831b67f750ea4cd1c9f53edfde9d6d9241d7352887f1f8  seed/out/omc
end

# the exact environment every row receives (agg.sh starts the runner under env -i)
row prov-env control
exit 0
arg env
need LC_ALL=C
end

row prov-runner control
exit 0
arg sha256sum
arg om/tls/sha2.om
arg om/tls/test/reuse/aggregate.om
arg om/tls/test/reuse/fixture.om
arg om/tls/test/reuse/agg.sh
file om/tls/sha2.om
file om/tls/test/reuse/aggregate.om
file om/tls/test/reuse/agg.sh
end

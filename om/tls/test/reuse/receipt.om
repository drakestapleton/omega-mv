note SPDX-License-Identifier: Apache-2.0
note receipt.om: OMEGA-CRYPTO-REUSE-1 receipt contract version 1 and its verifier (issue #639).
note Library part (no main): the verifier is `om2`, om/tls/sha2.om, receipt.om, verify.om and its
note controls are `om2`, om/tls/sha2.om, receipt.om, controls.om (both built by run.sh, run from the
note repository root).
note run.sh only records facts (exit codes, byte counts, files); every classification and the verdict
note are decided here, from the evidence files themselves, never from a number run.sh wrote.
note
note Stdin: the receipt, at most 8192 bytes, lines ending in "\n", tokens separated by one space:
note   CRYPTO-REUSE-RECEIPT 1                     first line, exactly
note   source HEX40|none                          checkout commit (git rev-parse HEAD), or none
note   dirty 0|1|none                             uncommitted changes in the checkout
note   omc HEX64 PATH                             sha256 of the compiler and the path it ran from
note   driver HEX64                               sha256 of build/tls/reuse/driver (the base binary)
note   fixture HEX64                              sha256 of om/tls/test/reuse/vectors.txt
note   checker HEX64                              sha256 of the verifier unit: om2 line, om/tls/sha2.om,
note                                              om/tls/test/reuse/receipt.om, om/tls/test/reuse/verify.om
note   runner HEX64                               sha256 of om/tls/test/reuse/run.sh (the command)
note   env empty                                  every case ran with an empty environment (env -i)
note   row NAME HEX64 HEX64 BRC ERRB EXIT HEX64   one per case: sha256 of the compiler input
note                                              rows/NAME.unit, of the program input rows/NAME.in,
note                                              build exit, compiler stderr bytes, program exit
note                                              (or none when it did not run), sha256 of its stdout
note                                              rows/NAME.out; rows/ is build/tls/reuse/rows/
note   class NAME CLASS                           optional; when present it must equal the computed one
note   verdict PASS|FAIL|INVALID|NOT_RUN          optional; when present it must equal the computed one
note Each of source, dirty, omc, driver, fixture, checker, runner, env exactly once; a row name at most
note once; nothing else.
note
note Refusals (exit 2, one line "REFUSED <reason>"): malformed receipt, unknown key or row, duplicate,
note compiler sha256 not equal to the pin seed/out/omc.sha256, compiler, driver, fixture, checker
note sources, runner or any row file missing or not hashing to the recorded value (tampered, stale or
note missing evidence), the base row not built from the current sources (om2 line, om/tls/chacha.om,
note om/tls/aesgcm.om, om/tls/gcmsiv.om, om/tls/test/reuse/driver.om) or not run on the current
note fixture, a claimed class or verdict different from the computed one.
note
note Rows: base (the unmutated driver), five source mutants (the same input, a different unit) and one
note vector mutant (the same unit, a different input). Each mutant names the exact set of driver checks
note its defect must fail (its intended assertions):
note   tags-in-detector        6 14        detector compares 96 bytes, tags included
note   detector-always-reuse   3 7 15 23   every no-reuse control
note   nonce-not-distinct      7 11 15 19 27
note   tamper-not-applied      10 18
note   siv-as-other-mode       21
note   wrong-expected-xor      1 5 13      (vector mutant)
note A program stdout may hold only "MISMATCH check N", "BAD input" and, last, exactly one
note "reuse driver: C checks, F failed". Classes:
note   base   PASS     built (exit 0, no stderr), exit 0, C 27, F 0, no other line
note          FAIL     built, exit 1, C 27, F > 0, F equal to the MISMATCH/BAD lines
note   mutant CAUGHT   built, exit 1, C 27, F > 0, the failed checks are exactly the intended set
note          SURVIVED built, exit 0, C 27, F 0
note   either INVALID  anything else: build failure or stderr, trap, signal, deadline, no or several
note                   summaries, zero or other check counts, unknown lines, failures outside the
note                   intended set (an unrelated failure is not a kill), a mutant whose unit (source
note                   mutant) or input (vector mutant) equals the base one, or whose other half differs
note          NOT_RUN  no row
note Verdict and exit: FAIL 1 when the base fails or a mutant survives; else INVALID 3 when a row is
note INVALID; else NOT_RUN 4 when a row is missing; else PASS 0. Stdout: "class NAME CLASS" per row in
note table order, then "verdict V". A signature is not part of this contract: a receipt and its
note evidence rewritten together and consistently are not detected here (see README.md).

const NROW ulong 7
const RW ulong 16
const BIG ulong 4611686018427387904

global qrin uchar 8192
global qgs ulong 64
global qpb uchar 1024
global qhx uchar 64
global qfx uchar 64
global qbx uchar 64
global qlb uchar 16384
global qqt uchar 1
global qtk ulong 32
global qrw ulong 112
global qone uchar 1

text zhdr "CRYPTO-REUSE-RECEIPT"
text zone "1"
text zsrc "source"
text zdty "dirty"
text zomc "omc"
text zdrv "driver"
text zfix "fixture"
text zrow "row"
text zcls "class"
text zver "verdict"
text zchk "checker"
text zrun "runner"
text zenv "env"
text zempty "empty"
text znone "none"
text z0 "0"
text n0 "base"
text n1 "tags-in-detector"
text n2 "detector-always-reuse"
text n3 "nonce-not-distinct"
text n4 "tamper-not-applied"
text n5 "siv-as-other-mode"
text n6 "wrong-expected-xor"
text c0 "PASS"
text c1 "CAUGHT"
text c2 "FAIL"
text c3 "SURVIVED"
text c4 "INVALID"
text c5 "NOT_RUN"
text pfix "om/tls/test/reuse/vectors.txt"
text pdrv "build/tls/reuse/driver"
text ppin "seed/out/omc.sha256"
text prows "build/tls/reuse/rows/"
text eunit ".unit"
text ein ".in"
text eout ".out"
text u0 "om2\n"
text u1 "om/tls/chacha.om"
text u2 "om/tls/aesgcm.om"
text u3 "om/tls/gcmsiv.om"
text u4 "om/tls/test/reuse/driver.om"
text u5 "om/tls/sha2.om"
text u6 "om/tls/test/reuse/receipt.om"
text u7 "om/tls/test/reuse/verify.om"
text prun "om/tls/test/reuse/run.sh"
text lmis "MISMATCH check "
text lbad "BAD input"
text lsum "reuse driver: "
text lchk " checks, "
text lfld " failed"
text tcls "class "
text tver "verdict "
text tsp " "
text tnl "\n"
text tref "REFUSED "
text r1 "receipt unreadable or over 8192 bytes"
text r2 "first line is not CRYPTO-REUSE-RECEIPT 1"
text r3 "malformed line"
text r4 "unknown key"
text r5 "duplicate key or row"
text r6 "unknown row or class name"
text r7 "source, dirty, omc, driver or fixture missing"
text r8 "compiler sha256 is not the pin seed/out/omc.sha256"
text r9 "compiler missing or its sha256 differs from the receipt"
text r10 "driver missing or its sha256 differs from the receipt"
text r11 "fixture missing or its sha256 differs from the receipt (stale input)"
text r12 "base sources unreadable"
text r13 "row evidence file missing or its sha256 differs from the receipt"
text r14 "base row was not built from the current sources (stale source)"
text r15 "base row was not run on the current fixture (stale input)"
text r16 "claimed class differs from the evidence"
text r17 "claimed verdict differs from the evidence"
text r18 "checker sources missing or their sha256 differs from the receipt (stale checker)"
text r19 "runner missing or its sha256 differs from the receipt (stale command)"

note qgs: 0 receipt length, 1 refusal (0 none, else the reason number),
note 4 source, 5 dirty, 6 omc, 7 driver, 8 fixture (each: token offset + 1),
note 9 omc path offset, 10 omc path length, 11 claimed verdict + 1, 12 path length,
note 13 stdout length, 14 summary checks, 15 summary failed, 16 MISMATCH/BAD lines, 17 failed set,
note 18 summaries seen, 19 unknown stdout lines, 20 checker, 21 runner (token offset + 1), 22 env seen
note qrw row i at RW i: 0 present, 1 unit hex offset, 2 input hex offset, 3 build exit, 4 stderr bytes,
note 5 program exit (BIG - 1 when none), 6 stdout hex offset, 7 claimed class + 1, 8 computed class

note stdout, unless qqt 0 is nonzero (controls.om runs the verifier quietly)
fn rc_out t view uchar * to void
if eq get qqt 0 0
r = write 1 t 0 len t
end
end

fn rc_refuse id ulong to void
if eq get qgs 1 0
put qgs 1 id
end
end

fn rc_slurp to ulong
t = ulong 0
while true bound 8193
room = sub len qrin t
if eq room 0
r = read 0 qone 0 1
if ne r 0
ret 1
end
break
end
r = read 0 qrin t room
if lt r 0
ret 1
end
if eq r 0
break
end
t = add t ulong r
end
put qgs 0 t
ret 0
end

note split qrin[s .. e) into tokens at single spaces: qtk 2k offset, 2k+1 length; the count, or 99
note for an empty line, an empty token (two spaces, leading or trailing space) or over 16 tokens
fn rc_toks s ulong e ulong to ulong
if eq s e
ret 99
end
n = ulong 0
b = s
p = s
while le p e bound 8193
atend = eq p e
issp = false
if not atend
issp = eq get qrin p 32
end
if or atend issp
if eq p b
ret 99
end
if ge n 16
ret 99
end
put qtk mul n 2 b
put qtk add mul n 2 1 sub p b
n = add n 1
b = add p 1
end
p = add p 1
end
ret n
end

fn rc_tlen k ulong to ulong
ret get qtk add mul k 2 1
end

fn rc_toff k ulong to ulong
ret get qtk mul k 2
end

fn rc_teq k ulong t view uchar * to bool
o = rc_toff k
n = rc_tlen k
if ne n len t
ret false
end
for i ulong n
if ne get qrin add o i get t i
ret false
end
end
ret true
end

note token k is exactly n lowercase hex digits
fn rc_ishex k ulong n ulong to bool
if ne rc_tlen k n
ret false
end
o = rc_toff k
for i ulong n
c = get qrin add o i
dig = and ge c 48 le c 57
low = and ge c 97 le c 102
if not or dig low
ret false
end
end
ret true
end

note token k as a decimal number of 1..12 digits, else BIG
fn rc_dec k ulong to ulong
n = rc_tlen k
if or eq n 0 gt n 12
ret BIG
end
o = rc_toff k
v = ulong 0
for i ulong n
c = ulong get qrin add o i
if or lt c 48 gt c 57
ret BIG
end
v = add mul v 10 sub c 48
end
ret v
end

fn rc_rowid k ulong to ulong
if rc_teq k n0
ret 0
end
if rc_teq k n1
ret 1
end
if rc_teq k n2
ret 2
end
if rc_teq k n3
ret 3
end
if rc_teq k n4
ret 4
end
if rc_teq k n5
ret 5
end
if rc_teq k n6
ret 6
end
ret 7
end

fn rc_clsid k ulong to ulong
if rc_teq k c0
ret 0
end
if rc_teq k c1
ret 1
end
if rc_teq k c2
ret 2
end
if rc_teq k c3
ret 3
end
if rc_teq k c4
ret 4
end
if rc_teq k c5
ret 5
end
ret 9
end

note verdict token: PASS 0, FAIL 1, INVALID 3, NOT_RUN 4, else 9
fn rc_verid k ulong to ulong
if rc_teq k c0
ret 0
end
if rc_teq k c2
ret 1
end
if rc_teq k c4
ret 3
end
if rc_teq k c5
ret 4
end
ret 9
end

fn rc_name i ulong to void
if eq i 0
rc_out n0
end
if eq i 1
rc_out n1
end
if eq i 2
rc_out n2
end
if eq i 3
rc_out n3
end
if eq i 4
rc_out n4
end
if eq i 5
rc_out n5
end
if eq i 6
rc_out n6
end
end

fn rc_class c ulong to void
if eq c 0
rc_out c0
end
if eq c 1
rc_out c1
end
if eq c 2
rc_out c2
end
if eq c 3
rc_out c3
end
if eq c 4
rc_out c4
end
if eq c 5
rc_out c5
end
end

note the failed-check set each row must produce (bit N = driver check N); 0 for base
fn rc_want i ulong to ulong
if eq i 1
ret or shl ulong 1 6 shl ulong 1 14
end
if eq i 2
ret or or shl ulong 1 3 shl ulong 1 7 or shl ulong 1 15 shl ulong 1 23
end
if eq i 3
ret or or or shl ulong 1 7 shl ulong 1 11 or shl ulong 1 15 shl ulong 1 19 shl ulong 1 27
end
if eq i 4
ret or shl ulong 1 10 shl ulong 1 18
end
if eq i 5
ret shl ulong 1 21
end
if eq i 6
ret or or shl ulong 1 1 shl ulong 1 5 shl ulong 1 13
end
ret 0
end

note one key/value line: tokens already in qtk (n of them)
fn rc_key n ulong to void
if rc_teq 0 zsrc
if ne n 2
rc_refuse 3
ret
end
if ne get qgs 4 0
rc_refuse 5
ret
end
if not or rc_ishex 1 40 rc_teq 1 znone
rc_refuse 3
ret
end
put qgs 4 add rc_toff 1 1
ret
end
if rc_teq 0 zdty
if ne n 2
rc_refuse 3
ret
end
if ne get qgs 5 0
rc_refuse 5
ret
end
d = rc_dec 1
if not or le d 1 rc_teq 1 znone
rc_refuse 3
ret
end
put qgs 5 add rc_toff 1 1
ret
end
if rc_teq 0 zomc
if ne n 3
rc_refuse 3
ret
end
if ne get qgs 6 0
rc_refuse 5
ret
end
if or not rc_ishex 1 64 gt rc_tlen 2 900
rc_refuse 3
ret
end
put qgs 6 add rc_toff 1 1
put qgs 9 rc_toff 2
put qgs 10 rc_tlen 2
ret
end
if rc_teq 0 zdrv
rc_hexkey n 7
ret
end
if rc_teq 0 zfix
rc_hexkey n 8
ret
end
if rc_teq 0 zchk
rc_hexkey n 20
ret
end
if rc_teq 0 zrun
rc_hexkey n 21
ret
end
if rc_teq 0 zenv
if or ne n 2 not rc_teq 1 zempty
rc_refuse 3
ret
end
if ne get qgs 22 0
rc_refuse 5
ret
end
put qgs 22 1
ret
end
if rc_teq 0 zver
if ne n 2
rc_refuse 3
ret
end
if ne get qgs 11 0
rc_refuse 5
ret
end
v = rc_verid 1
if eq v 9
rc_refuse 6
ret
end
put qgs 11 add v 1
ret
end
if rc_teq 0 zcls
if ne n 3
rc_refuse 3
ret
end
i = rc_rowid 1
c = rc_clsid 2
if or eq i 7 eq c 9
rc_refuse 6
ret
end
b = mul i RW
if ne get qrw add b 7 0
rc_refuse 5
ret
end
put qrw add b 7 add c 1
ret
end
if rc_teq 0 zrow
rc_rowline n
ret
end
rc_refuse 4
end

note a single 64-digit hex value key into qgs slot s (token offset + 1)
fn rc_hexkey n ulong s ulong to void
if or ne n 2 not rc_ishex 1 64
rc_refuse 3
ret
end
if ne get qgs s 0
rc_refuse 5
ret
end
put qgs s add rc_toff 1 1
end

fn rc_rowline n ulong to void
if ne n 8
rc_refuse 3
ret
end
i = rc_rowid 1
if eq i 7
rc_refuse 6
ret
end
b = mul i RW
if ne get qrw b 0
rc_refuse 5
ret
end
if not and and rc_ishex 2 64 rc_ishex 3 64 rc_ishex 7 64
rc_refuse 3
ret
end
brc = rc_dec 4
erb = rc_dec 5
if or ge brc BIG ge erb BIG
rc_refuse 3
ret
end
ex = rc_dec 6
if rc_teq 6 znone
ex = sub BIG 1
end
if ge ex BIG
rc_refuse 3
ret
end
put qrw b 1
put qrw add b 1 rc_toff 2
put qrw add b 2 rc_toff 3
put qrw add b 3 brc
put qrw add b 4 erb
put qrw add b 5 ex
put qrw add b 6 rc_toff 7
end

fn rc_parse to void
n = get qgs 0
if eq n 0
rc_refuse 2
ret
end
if ne get qrin sub n 1 10
rc_refuse 3
ret
end
p = ulong 0
first = true
while lt p n bound 8193
q = p
while ne get qrin q 10 bound 8193
q = add q 1
end
k = rc_toks p q
if eq k 99
rc_refuse 3
ret
end
if first
hok = and and eq k 2 rc_teq 0 zhdr rc_teq 1 zone
if not hok
rc_refuse 2
ret
end
first = false
else
rc_key k
end
if ne get qgs 1 0
ret
end
p = add q 1
end
end

note path builder qpb[0 .. qgs 12)
fn rc_pset t view uchar * to void
put qgs 12 0
rc_padd t
end

fn rc_padd t view uchar * to void
l = get qgs 12
for i ulong len t
put qpb add l i get t i
end
put qgs 12 add l len t
end

fn rc_paddr o ulong n ulong to void
l = get qgs 12
for i ulong n
put qpb add l i get qrin add o i
end
put qgs 12 add l n
end

note the receipt's name token of row i (its line is gone; names are fixed texts)
fn rc_pname i ulong to void
if eq i 0
rc_padd n0
end
if eq i 1
rc_padd n1
end
if eq i 2
rc_padd n2
end
if eq i 3
rc_padd n3
end
if eq i 4
rc_padd n4
end
if eq i 5
rc_padd n5
end
if eq i 6
rc_padd n6
end
end

fn rc_open to int
r = fopen qpb 0 get qgs 12 524288 0
if lt r 0
ret -1
end
ret int r
end

note absorb all of fd into c; false on a read error
fn rc_absorb fd int c edit ulong * a edit uchar * to bool
while true bound 1000000
r = read fd a 0 len a
if lt r 0
ret false
end
if eq r 0
ret true
end
sha256_update c part a 0 ulong r
end
ret false
end

fn rc_hex o view uchar * to void
for i ulong 32
b = get o i
hi = shr b 4
lo = and b 15
ch = add hi 48
if gt hi 9
ch = add hi 87
end
cl = add lo 48
if gt lo 9
cl = add lo 87
end
put qhx mul i 2 ch
put qhx add mul i 2 1 cl
end
end

note sha256 of the file at qpb into qhx: true when it was read to the end
fn rc_hfile to bool
c = new ulong 40 0
a = new uchar 16384 0
o = new uchar 32 0
fd = rc_open
if lt fd 0
ret false
end
sha256_init c
ok = rc_absorb fd c a
r = fclose fd
if not ok
ret false
end
sha256_final c o
rc_hex o
ret true
end

note path of file j of source set s into qpb: set 0 the driver base unit (four files), set 1 the
note verifier unit (three files); false when the set has no file j
fn rc_setpath s ulong j ulong to bool
if eq s 1
if eq j 0
rc_pset u5
end
if eq j 1
rc_pset u6
end
if eq j 2
rc_pset u7
end
ret lt j 3
end
if eq j 0
rc_pset u1
end
if eq j 1
rc_pset u2
end
if eq j 2
rc_pset u3
end
if eq j 3
rc_pset u4
end
ret lt j 4
end

note sha256 of the om2 line and the files of set s, as run.sh writes that unit, into qhx
fn rc_hunit s ulong to bool
c = new ulong 40 0
a = new uchar 16384 0
o = new uchar 32 0
sha256_init c
sha256_update c u0
for j ulong 4
if rc_setpath s j
fd = rc_open
if lt fd 0
ret false
end
ok = rc_absorb fd c a
r = fclose fd
if not ok
ret false
end
end
end
sha256_final c o
rc_hex o
ret true
end

note qhx equals the 64 hex digits at qrin[o ..)
fn rc_hxeq o ulong to bool
for i ulong 64
if ne get qhx i get qrin add o i
ret false
end
end
ret true
end

note the saved digest (s 0: base unit qbx, s 1: fixture qfx) equals the hex at qrin[o ..)
fn rc_hxeqs s ulong o ulong to bool
for i ulong 64
c = get qbx i
if eq s 1
c = get qfx i
end
if ne c get qrin add o i
ret false
end
end
ret true
end

note hash the row file NAME.EXT; false when missing or not equal to the hex at qrin[o ..)
fn rc_hrow i ulong t view uchar * o ulong to bool
rc_pset prows
rc_pname i
rc_padd t
if not rc_hfile
ret false
end
ret rc_hxeq o
end

note read the stdout file at qpb into qlb; 0 ok, 1 missing, 2 over 16384 bytes
fn rc_slog to ulong
fd = rc_open
if lt fd 0
ret 1
end
t = ulong 0
ovr = false
while true bound 16386
room = sub len qlb t
if eq room 0
r = read fd qone 0 1
if ne r 0
ovr = true
end
break
end
r = read fd qlb t room
if lt r 0
ovr = true
break
end
if eq r 0
break
end
t = add t ulong r
end
r = fclose fd
if ovr
ret 2
end
put qgs 13 t
ret 0
end

note qlb[p ..) starts with text t
fn rc_lpre p ulong e ulong t view uchar * to bool
if lt sub e p len t
ret false
end
for i ulong len t
if ne get qlb add p i get t i
ret false
end
end
ret true
end

note decimal digits qlb[p .. e) (1..9 of them), else BIG
fn rc_ldec p ulong e ulong to ulong
if or le e p gt sub e p 9
ret BIG
end
v = ulong 0
for i ulong sub e p
c = ulong get qlb add p i
if or lt c 48 gt c 57
ret BIG
end
v = add mul v 10 sub c 48
end
ret v
end

note the summary line qlb[p .. e): sets qgs 14, 15; false when it is not one
fn rc_lsum p ulong e ulong to bool
if not rc_lpre p e lsum
ret false
end
a = add p len lsum
q = a
while and lt q e ne get qlb q 32 bound 16385
q = add q 1
end
cc = rc_ldec a q
if ge cc BIG
ret false
end
if not rc_lpre q e lchk
ret false
end
a = add q len lchk
q = a
while and lt q e ne get qlb q 32 bound 16385
q = add q 1
end
ff = rc_ldec a q
if ge ff BIG
ret false
end
if or ne sub e q len lfld not rc_lpre q e lfld
ret false
end
put qgs 14 cc
put qgs 15 ff
ret true
end

note parse qlb into qgs 14..19
fn rc_lparse to void
n = get qgs 13
for k ulong 6
put qgs add 14 k 0
end
p = ulong 0
while lt p n bound 16385
q = p
while and lt q n ne get qlb q 10 bound 16385
q = add q 1
end
last = ge add q 1 n
known = false
if rc_lpre p q lmis
v = rc_ldec add p len lmis q
if lt v 64
put qgs 16 add get qgs 16 1
put qgs 17 or get qgs 17 shl ulong 1 v
known = true
end
end
if and not known eq sub q p len lbad
if rc_lpre p q lbad
put qgs 16 add get qgs 16 1
put qgs 17 or get qgs 17 1
known = true
end
end
if not known
if rc_lsum p q
put qgs 18 add get qgs 18 1
if not last
put qgs 19 1
end
known = true
end
end
if not known
put qgs 19 add get qgs 19 1
end
p = add q 1
end
end

note class of present row i (evidence files already verified against the receipt)
fn rc_cls i ulong to ulong
b = mul i RW
if or ne get qrw add b 3 0 ne get qrw add b 4 0
ret 4
end
ex = get qrw add b 5
if ge ex sub BIG 1
ret 4
end
rc_pset prows
rc_pname i
rc_padd eout
s = rc_slog
if ne s 0
ret 4
end
rc_lparse
okshape = and eq get qgs 18 1 eq get qgs 19 0
okshape = and okshape eq get qgs 14 27
if not okshape
ret 4
end
f = get qgs 15
m = get qgs 16
fset = get qgs 17
if eq i 0
if and and eq ex 0 eq f 0 eq m 0
ret 0
end
if and and eq ex 1 gt f 0 eq f m
ret 2
end
ret 4
end
if and and eq ex 0 eq f 0 eq m 0
ret 3
end
okk = and and eq ex 1 gt f 0 eq f m
if and okk eq fset rc_want i
ret 1
end
ret 4
end

note mutant rows must differ from base in exactly the half they mutate
fn rc_applied i ulong to bool
b = mul i RW
su = rc_hxeqs 0 get qrw add b 1
si = rc_hxeqs 1 get qrw add b 2
if eq i 6
ret and su not si
end
ret and not su si
end

note the first 64 bytes of seed/out/omc.sha256 equal the compiler hex at qrin[oo ..)
fn rc_pinok oo ulong to bool
rc_pset ppin
fd = rc_open
if lt fd 0
ret false
end
r = read fd qhx 0 64
x = fclose fd
if ne r 64
ret false
end
ret rc_hxeq oo
end

note every single-valued key present; false refuses 7
fn rc_haveall to bool
for k ulong 5
if eq get qgs add 4 k 0
ret false
end
end
for k ulong 3
if eq get qgs add 20 k 0
ret false
end
end
ret true
end

note the checker (verifier unit) and the runner (run.sh) are the ones in this tree
fn rc_vtools to void
if not rc_hunit 1
rc_refuse 18
ret
end
if not rc_hxeq sub get qgs 20 1
rc_refuse 18
ret
end
rc_pset prun
if not rc_hfile
rc_refuse 19
ret
end
if not rc_hxeq sub get qgs 21 1
rc_refuse 19
end
end

fn rc_verify to void
if not rc_haveall
rc_refuse 7
ret
end
oo = sub get qgs 6 1
if not rc_pinok oo
rc_refuse 8
ret
end
put qgs 12 0
rc_paddr get qgs 9 get qgs 10
if not rc_hfile
rc_refuse 9
ret
end
if not rc_hxeq oo
rc_refuse 9
ret
end
rc_vtools
if ne get qgs 1 0
ret
end
rc_pset pdrv
if not rc_hfile
rc_refuse 10
ret
end
if not rc_hxeq sub get qgs 7 1
rc_refuse 10
ret
end
rc_pset pfix
if not rc_hfile
rc_refuse 11
ret
end
if not rc_hxeq sub get qgs 8 1
rc_refuse 11
ret
end
for i ulong 64
put qfx i get qhx i
end
if not rc_hunit 0
rc_refuse 12
ret
end
for i ulong 64
put qbx i get qhx i
end
for i ulong NROW
b = mul i RW
if ne get qrw b 0
ok = rc_hrow i eunit get qrw add b 1
ok = and ok rc_hrow i ein get qrw add b 2
ok = and ok rc_hrow i eout get qrw add b 6
if not ok
rc_refuse 13
ret
end
end
end
if ne get qrw 0 0
if not rc_hxeqs 0 get qrw 1
rc_refuse 14
ret
end
if not rc_hxeqs 1 get qrw 2
rc_refuse 15
ret
end
end
end

note classes into qrw 8 and the verdict
fn rc_judge to ulong
fl = false
inv = false
nr = false
for i ulong NROW
b = mul i RW
c = ulong 5
if ne get qrw b 0
c = rc_cls i
if and gt i 0 not rc_applied i
c = 4
end
end
put qrw add b 8 c
if or eq c 2 eq c 3
fl = true
end
if eq c 4
inv = true
end
if eq c 5
nr = true
end
end
if fl
ret 1
end
if inv
ret 3
end
if nr
ret 4
end
ret 0
end

fn rc_claims v ulong to void
for i ulong NROW
b = mul i RW
cl = get qrw add b 7
if ne cl 0
if ne sub cl 1 get qrw add b 8
rc_refuse 16
ret
end
end
end
cv = get qgs 11
if ne cv 0
if ne sub cv 1 v
rc_refuse 17
end
end
end

fn rc_reason id ulong to void
rc_out tref
if eq id 1
rc_out r1
end
if eq id 2
rc_out r2
end
if eq id 3
rc_out r3
end
if eq id 4
rc_out r4
end
if eq id 5
rc_out r5
end
if eq id 6
rc_out r6
end
if eq id 7
rc_out r7
end
if eq id 8
rc_out r8
end
if eq id 9
rc_out r9
end
if eq id 10
rc_out r10
end
if eq id 11
rc_out r11
end
if eq id 12
rc_out r12
end
if eq id 13
rc_out r13
end
if eq id 14
rc_out r14
end
if eq id 15
rc_out r15
end
if eq id 16
rc_out r16
end
if eq id 17
rc_out r17
end
if eq id 18
rc_out r18
end
if eq id 19
rc_out r19
end
rc_out tnl
end

note clear all verdict state (qrin and qgs 0 are the input and stay)
fn rc_reset to void
for i ulong sub len qgs 1
put qgs add i 1 0
end
for i ulong len qrw
put qrw i 0
end
for i ulong len qtk
put qtk i 0
end
end

note verify the receipt in qrin[0 .. qgs 0) after rc_reset: print the classes and verdict, or the
note refusal, and return the exit code
fn rc_run to ulong
rc_parse
if eq get qgs 1 0
rc_verify
end
v = ulong 0
if eq get qgs 1 0
v = rc_judge
rc_claims v
end
if ne get qgs 1 0
rc_reason get qgs 1
ret 2
end
for i ulong NROW
rc_out tcls
rc_name i
rc_out tsp
rc_class get qrw add mul i RW 8
rc_out tnl
end
rc_out tver
if eq v 0
rc_out c0
end
if eq v 1
rc_out c2
end
if eq v 3
rc_out c4
end
if eq v 4
rc_out c5
end
rc_out tnl
ret v
end

note SPDX-License-Identifier: Apache-2.0
note controls.om: negative controls for the OMEGA-CRYPTO-REUSE-1 receipt verifier (issue #639).
note Built as `om2`, om/tls/sha2.om, receipt.om, controls.om; run from the repository root after
note run.sh has written and verified build/tls/reuse/receipt.txt, with that receipt on stdin.
note Each control edits the receipt in memory, and some rewrite one evidence file under
note build/tls/reuse/rows/ (saved first, restored after), runs the verifier in this process
note (rc_run, quiet) and requires one exit code and, for a refusal, one reason. A last control
note reruns the untouched receipt, which proves every file was restored.
note Stdout: "control ID PASS" or "control ID FAIL exit E reason R", then "controls P passed F failed".
note Exit 0 when every control passes, 1 when one fails, 3 when the receipt, a save or a restore fails.

global kg uchar 8192
global kgs ulong 8
global kw uchar 65536
global ks uchar 65536
global ksp uchar 1024
global kn uchar 32

text kok "PASS\n"
text kno "FAIL exit "
text krs " reason "
text kctl "control "
text kpass " passed "
text kfld " failed\n"
text kfat "controls INVALID: receipt, save or restore failed\n"
text kcls "controls "
text kfix "fixture "
text komc "omc "
text kdrv "driver "
text kchk "checker "
text krun "runner "
text kenv "env "
text kcb "class base "
text k1 "1"
text k2 "2"
text k12 "12"
text k139 "139"
text kbasis "basis"
text kfoo "foo bar\n"
text kcdup "class base PASS\n"
text kpanic "panic: index out of range\n"
text kzero "reuse driver: 0 checks, 0 failed\n"
text koff "MISMATCH check 2\nreuse driver: 27 checks, 1 failed\n"
text khello "hello\nreuse driver: 27 checks, 0 failed\n"
text kbfail "MISMATCH check 4\nreuse driver: 27 checks, 1 failed\n"
text kbsum "MISMATCH check 4\nreuse driver: 27 checks, 2 failed\n"
text knl "\n"

note kgs: 0 good receipt length, 1 passed, 2 failed, 3 saved file length, 4 saved path length

fn ct_out t view uchar * to void
r = write 1 t 0 len t
end

fn ct_num v ulong to void
x = v
k = ulong 0
while true bound 21
put kn sub 31 k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
r = write 1 kn sub 32 k k
end

fn ct_fatal to void
ct_out kfat
exit 3
end

fn ct_load to void
n = get kgs 0
for i ulong n
put qrin i get kg i
end
put qgs 0 n
end

note offset of the "\n" ending the line that holds p
fn ct_eol p ulong to ulong
q = p
while ne get qrin q 10 bound 8193
q = add q 1
end
ret q
end

note qrin[p ..) starts with text t
fn ct_peq p ulong t view uchar * to bool
n = get qgs 0
if gt add p len t n
ret false
end
for i ulong len t
if ne get qrin add p i get t i
ret false
end
end
ret true
end

note start of the first line beginning with t; fatal when none
fn ct_find t view uchar * to ulong
n = get qgs 0
p = ulong 0
while lt p n bound 8193
if ct_peq p t
ret p
end
p = add ct_eol p 1
end
ct_fatal
ret 0
end

fn ct_isname q ulong i ulong to bool
if eq i 0
ret ct_peq q n0
end
if eq i 1
ret ct_peq q n1
end
if eq i 2
ret ct_peq q n2
end
if eq i 3
ret ct_peq q n3
end
if eq i 4
ret ct_peq q n4
end
if eq i 5
ret ct_peq q n5
end
ret ct_peq q n6
end

fn ct_nlen i ulong to ulong
if eq i 0
ret len n0
end
if eq i 1
ret len n1
end
if eq i 2
ret len n2
end
if eq i 3
ret len n3
end
if eq i 4
ret len n4
end
if eq i 5
ret len n5
end
ret len n6
end

note start of the line "row NAME ..." of row i; fatal when none
fn ct_findrow i ulong to ulong
n = get qgs 0
p = ulong 0
while lt p n bound 8193
if ct_peq p zrow
q = add p 4
if ct_isname q i
if eq get qrin add q ct_nlen i 32
ret p
end
end
end
p = add ct_eol p 1
end
ct_fatal
ret 0
end

note offset of token j of the line starting at p
fn ct_tok p ulong j ulong to ulong
q = p
for k ulong j
while ne get qrin q 32 bound 8193
q = add q 1
end
q = add q 1
end
ret q
end

fn ct_tend q ulong to ulong
e = q
while and ne get qrin e 32 ne get qrin e 10 bound 8193
e = add e 1
end
ret e
end

note move qrin[s .. s + c) to qrin[d ..); overlap safe
fn ct_move s ulong d ulong c ulong to void
if gt d s
for k ulong c
i = sub sub add s c 1 k
put qrin add i sub d s get qrin i
end
ret
end
for k ulong c
put qrin add d k get qrin add s k
end
end

note replace qrin[p .. p + n) with t
fn ct_splice p ulong n ulong t view uchar * to void
m = get qgs 0
nm = add sub m n len t
if gt nm len qrin
ct_fatal
end
ct_move add p n add p len t sub m add p n
for k ulong len t
put qrin add p k get t k
end
put qgs 0 nm
end

fn ct_settok p ulong j ulong t view uchar * to void
q = ct_tok p j
ct_splice q sub ct_tend q q t
end

note delete the line starting at p
fn ct_cutline p ulong to void
e = add ct_eol p 1
m = get qgs 0
for k ulong sub m e
put qrin add p k get qrin add e k
end
put qgs 0 sub m sub e p
end

fn ct_app t view uchar * to void
ct_splice get qgs 0 0 t
end

note drop every claim: the facts end at the first "class " line
fn ct_noclaims to void
n = get qgs 0
p = ulong 0
while lt p n bound 8193
if ct_peq p tcls
put qgs 0 p
ret
end
p = add ct_eol p 1
end
end

note change one hex digit of token j of line p
fn ct_fliphex p ulong j ulong to void
q = ct_tok p j
c = uchar 97
if eq get qrin q 97
c = 98
end
put qrin q c
end

note qhx into the 64-digit token j of line p
fn ct_sethex p ulong j ulong to void
q = ct_tok p j
for i ulong 64
put qrin add q i get qhx i
end
end

fn ct_rowpath i ulong t view uchar * to void
rc_pset prows
rc_pname i
rc_padd t
end

note read the file at qpb into kw; its length, fatal when unreadable or over 65536 bytes
fn ct_rdkw to ulong
fd = rc_open
if lt fd 0
ct_fatal
end
t = ulong 0
while true bound 65538
room = sub len kw t
if eq room 0
ct_fatal
end
r = read fd kw t room
if lt r 0
ct_fatal
end
if eq r 0
break
end
t = add t ulong r
end
r = fclose fd
ret t
end

note write kw[0 .. n) to the file at qpb (created or truncated)
fn ct_wr n ulong to void
r = fopen qpb 0 get qgs 12 524865 420
if lt r 0
ct_fatal
end
fd = int r
w = write fd kw 0 n
x = fclose fd
if ne w long n
ct_fatal
end
end

fn ct_wtext t view uchar * to void
for i ulong len t
put kw i get t i
end
ct_wr len t
end

note keep the file at qpb (path and bytes) for ct_restore
fn ct_save to void
n = ct_rdkw
for i ulong n
put ks i get kw i
end
put kgs 3 n
l = get qgs 12
for i ulong l
put ksp i get qpb i
end
put kgs 4 l
end

fn ct_restore to void
l = get kgs 4
for i ulong l
put qpb i get ksp i
end
put qgs 12 l
n = get kgs 3
for i ulong n
put kw i get ks i
end
ct_wr n
end

note sha256 of the file at qpb into token j of line p
fn ct_rehash p ulong j ulong to void
if not rc_hfile
ct_fatal
end
ct_sethex p j
end

note run the verifier on qrin; want the exit w and, when w is 2, the refusal reason why
fn ct_check id ulong w ulong why ulong to void
rc_reset
put qqt 0 1
r = rc_run
put qqt 0 0
got = get qgs 1
ok = eq r w
if eq w 2
ok = and ok eq got why
end
ct_out kctl
ct_num id
ct_out tsp
if ok
ct_out kok
put kgs 1 add get kgs 1 1
ret
end
ct_out kno
ct_num r
ct_out krs
ct_num got
ct_out knl
put kgs 2 add get kgs 2 1
end

note row i file NAME.EXT becomes text t, its hash goes to token j of its line, then check
fn ct_rowtext i ulong ext view uchar * j ulong t view uchar * to void
p = ct_findrow i
ct_rowpath i ext
ct_save
ct_wtext t
ct_rehash p j
end

note row i file NAME.EXT becomes a copy of row s's file of the same kind
fn ct_rowcopy i ulong s ulong ext view uchar * j ulong to void
p = ct_findrow i
ct_rowpath i ext
ct_save
ct_rowpath s ext
n = ct_rdkw
ct_rowpath i ext
ct_wr n
ct_rehash p j
end

fn ct_claims to void
ct_load
ct_check 1 0 0
ct_load
ct_noclaims
ct_check 2 0 0
ct_load
ct_settok ct_find tver 1 c2
ct_check 3 2 17
ct_load
ct_settok ct_find kcb 2 c2
ct_check 4 2 16
end

fn ct_evidence to void
ct_load
ct_rowpath 0 eout
ct_save
n = ct_rdkw
put kw 0 xor get kw 0 1
ct_wr n
ct_check 5 2 13
ct_restore
ct_load
ct_rowpath 0 eout
ct_save
r = unlink qpb 0 get qgs 12
ct_check 6 2 13
ct_restore
ct_load
ct_fliphex ct_find kfix 1
ct_check 7 2 11
ct_load
ct_fliphex ct_find komc 1
ct_check 8 2 8
ct_load
ct_settok ct_find komc 2 pfix
ct_check 9 2 9
ct_load
ct_fliphex ct_find kdrv 1
ct_check 10 2 10
ct_load
ct_fliphex ct_find kchk 1
ct_check 35 2 18
ct_load
ct_fliphex ct_find krun 1
ct_check 36 2 19
ct_load
ct_cutline ct_find kenv
ct_check 37 2 7
end

fn ct_stale to void
ct_load
ct_noclaims
p = ct_findrow 0
ct_rowpath 0 eunit
ct_save
n = ct_rdkw
put kw n 10
ct_wr add n 1
ct_rehash p 2
ct_check 11 2 14
ct_restore
ct_load
ct_noclaims
ct_rowcopy 0 6 ein 3
ct_check 12 2 15
ct_restore
end

fn ct_rows to void
ct_load
ct_noclaims
ct_cutline ct_findrow 5
ct_check 13 4 0
ct_load
ct_noclaims
ct_settok ct_findrow 1 4 k1
ct_check 14 3 0
ct_load
ct_noclaims
ct_rowcopy 1 0 eout 7
ct_settok ct_findrow 1 6 z0
ct_check 15 1 0
ct_restore
ct_load
ct_noclaims
p = ct_findrow 1
ct_rowpath 1 eout
ct_save
ct_wr 0
ct_rehash p 7
ct_settok p 6 k139
ct_check 16 3 0
ct_restore
ct_load
ct_noclaims
ct_rowtext 0 eout 7 kzero
ct_check 17 3 0
ct_restore
ct_load
ct_noclaims
ct_rowtext 1 eout 7 koff
ct_check 18 3 0
ct_restore
ct_load
ct_noclaims
ct_rowtext 1 eout 7 kpanic
ct_check 19 3 0
ct_restore
end

fn ct_shapes to void
ct_load
ct_noclaims
ct_rowtext 0 eout 7 khello
ct_check 20 3 0
ct_restore
ct_load
ct_noclaims
ct_rowcopy 1 0 eunit 2
ct_check 21 3 0
ct_restore
ct_load
ct_noclaims
ct_rowcopy 6 0 ein 3
ct_check 22 3 0
ct_restore
ct_load
ct_noclaims
ct_rowtext 0 eout 7 kbfail
ct_settok ct_findrow 0 6 k1
ct_check 23 1 0
ct_restore
ct_load
ct_noclaims
ct_rowtext 0 eout 7 kbsum
ct_settok ct_findrow 0 6 k1
ct_check 24 3 0
ct_restore
ct_load
ct_noclaims
ct_settok ct_findrow 0 6 znone
ct_check 25 3 0
ct_load
ct_noclaims
ct_settok ct_findrow 2 5 k12
ct_check 26 3 0
end

fn ct_syntax to void
ct_load
ct_settok ct_findrow 0 1 kbasis
ct_check 27 2 6
ct_load
ct_noclaims
p = ct_findrow 0
e = add ct_eol p 1
n = get qgs 0
for i ulong sub e p
put qrin add n i get qrin add p i
end
put qgs 0 add n sub e p
ct_check 28 2 5
ct_load
ct_app kfoo
ct_check 29 2 4
ct_load
ct_settok 0 1 k2
ct_check 30 2 2
ct_load
ct_splice ct_eol 0 0 tsp
ct_check 31 2 3
ct_load
put qgs 0 sub get qgs 0 1
ct_check 32 2 3
ct_load
ct_app kcdup
ct_check 33 2 5
ct_load
ct_cutline ct_find zsrc
ct_check 34 2 7
end

fn main to int
put qqt 0 0
if ne rc_slurp 0
ct_fatal
end
n = get qgs 0
for i ulong n
put kg i get qrin i
end
put kgs 0 n
ct_claims
ct_evidence
ct_stale
ct_rows
ct_shapes
ct_syntax
ct_load
ct_check 99 0 0
ct_out kcls
ct_num get kgs 1
ct_out kpass
ct_num get kgs 2
ct_out kfld
if ne get kgs 2 0
ret 1
end
ret 0
end

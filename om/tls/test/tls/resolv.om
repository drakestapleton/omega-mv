note Test instrument for dns_conf: test composition replaces TLRESOLV with a private fixture path.
note Writes the four address octets on success; exits 1 on TLEDNS, 2 on any other failure.
fn main to int
ip = new uchar 4 0
r = dns_conf ip
if eq r TLEDNS
ret 1
end
if ne r 0
ret 2
end
k = write 1 ip 0 4
if ne k 4
ret 2
end
ret 0
end

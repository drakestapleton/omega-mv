note SPDX-License-Identifier: AGPL-3.0-only
note One CTA covers 128 prefix destinations or four suffix destinations.
note Every active suffix warp reduces disjoint incoming arcs to the same
note FP32 max. Only lane zero writes. The compiler specializes both counts.
fn ah_coordinates code edit uchar 16384 s edit ulong 5 cfg edit ulong 192 to void
  wave_imm code s 3 0 0x21
  wave_imm code s 3 1 0x25
  wave_imm code s 3 2 0x26
  wave_imm code s 2 6 get cfg 0
  wave_imm code s 2 30 div add get cfg 1 127 128
  wave_imm code s 2 31 get cfg 1
  gv_opimm code s 18 32 0 31
  wave_ins code s 28 0 1 30
  gv_jump code s cfg 1 1
  gv_imad code s 5 1 128 0
  wave_ins code s 28 0 5 31
  put s 3 1
  wave_ins code s 45 wave_rz wave_rz wave_rz
  wave_imm code s 2 3 1
  wave_imm code s 2 33 0
  gv_jump code s cfg 2 0
  gv_mark s cfg 1
  gv_opimm code s 17 5 0 5
  wave_imm code s 2 34 and sub get cfg 1 mul 4 div add get cfg 1 127 128 0xffffffff
  gv_imad code s 5 1 4 5
  wave_ins code s 14 5 5 34
  wave_ins code s 28 0 5 6
  put s 3 1
  wave_ins code s 45 wave_rz wave_rz wave_rz
  wave_imm code s 2 3 32
  gv_imad code s 33 32 1 wave_rz
  gv_mark s cfg 2
end

fn arboris_emit_hubs n ulong leaves ulong code edit uchar 16384 to ulong
  if or eq n 0 or gt n 0x1fffffff ge leaves n
    ret 0
  end
  s = new ulong 5 0
  cfg = new ulong 192 0
  put s 2 wave_rz
  put cfg 0 n
  put cfg 1 leaves
  ah_coordinates code s cfg
  wave_imm code s 7 4 0x358
  for i ulong 5
    wave_imm code s 5 add 8 mul i 2 add 0x380 mul i 8
  end
  wave_imm code s 4 26 0x3a8
  wave_wide code s 14 2 mul 4 n 14
  wave_wide code s 16 2 mul 4 n 16
  wave_wide code s 18 5 4 8
  wave_ins code s 11 20 18 wave_rz
  put s 1 4
  wave_ins code s 11 21 18 wave_rz
  wave_ins code s 14 20 20 33
  wave_imm code s 2 4 0
  wave_loop code s true
  wave_ins code s 28 0 1 30
  gv_jump code s cfg 3 2
  for i ulong 5
    put s 1 shl ulong 1 i
    wave_ins code s 60 25 4 wave_rz
    wave_ins code s 37 4 4 25
  end
  wave_imm code s 2 34 1
  wave_ins code s 28 0 32 34
  put s 3 1
  wave_ins code s 45 wave_rz wave_rz wave_rz
  gv_mark s cfg 3
  wave_wide code s 18 5 4 14
  wave_ins code s 11 29 18 wave_rz
  wave_ins code s 37 28 4 29
  wave_wide code s 18 5 4 16
  wave_ins code s 12 wave_rz 18 28
  wave_exit code s
  gv_relocate code s cfg
  if ne get s 4 0
    ret 0
  end
  ret mul get s 0 16
end

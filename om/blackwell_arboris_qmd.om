note SPDX-License-Identifier: AGPL-3.0-only
note Offline SM121 sparse-wave descriptor packing. Compose after om/gpu/bw_qmd.om.
note Internal slot pairs are GPU VA and mapped extent, obtained by the allocator.
note Order: code, driver bank, scratch, semaphore, QMD0, QMD1, ART1 CSR,
note conductance, ping, pong. The public graph contains no GPU addresses.
note Shape: emitted node count, CSR node count, arc count, query count,
note active bank, decay and threshold bits. A zero decay is a host no-op.
note This serializer produces host bytes and does not grant submission rights.

fn wave_shape_ok shape view ulong 7 compound bool to bool
  n = get shape 1
  if or ne n get shape 0 or eq n 0 gt n 0x1fffffff
    ret false
  end
  if or gt get shape 2 0xffffffff or eq get shape 3 0 gt get shape 3 65535
    ret false
  end
  if or gt get shape 4 1 and not compound eq get shape 5 0
    ret false
  end
  if and compound ne get shape 6 0
    ret false
  end
  ret and le get shape 5 0x3f800000 le get shape 6 0x3f800000
end

fn wave_mapped slots view ulong 20 required view ulong 10 to bool
  note QMD linkage words encode VA[39:8]. Use the native allocator's low VA range.
  limit = ulong 0x10000000000
  for i ulong 10
    va = get slots mul i 2
    extent = get slots add mul i 2 1
    if or eq va 0 ge va limit
      ret false
    end
    if or lt extent get required i gt extent sub limit va
      ret false
    end
    align = ulong 128
    if or eq i 0 or eq i 4 eq i 5
      align = ulong 256
    end
    if ne and va sub align 1 0
      ret false
    end
    for j ulong i bound 10
      other = get slots mul j 2
      finish = add other get slots add mul j 2 1
      if and lt va finish lt other add va extent
        ret false
      end
    end
  end
  ret true
end

fn wave_regions_ok shape view ulong 7 slots view ulong 20 compound bool to bool
  req = new ulong 10 0
  put req 0 896
  put req 1 1024
  put req 2 65536
  put req 3 16
  put req 4 384
  put req 5 384
  words = add 4 add get shape 1 get shape 2
  put req 6 mul words 4
  put req 7 mul get shape 2 4
  state = mul mul get shape 1 get shape 3 8
  if compound
    state = div state 2
  end
  put req 8 state
  put req 9 state
  ret wave_mapped slots req
end

fn wave_bank_va bank edit uint 236 index ulong va ulong to void
  put bank index u32lo va
  put bank add index 1 u32lo shr va 32
end

fn wave_pack shape view ulong 7 slots view ulong 20 driver view uint 224 bank edit uint 236 q0 edit uint 96 q1 edit uint 96 to ulong
  m = new ulong 16 0
  for i ulong 5
    put m i get slots mul i 2
  end
  put m 8 128
  put m 9 1
  put m 10 div add get shape 1 127 128
  put m 11 get shape 3
  put m 12 32
  if ne bw_qmd1 m q1 0
    ret 3
  end
  if ne bw_qmd_verify q1 0
    ret 3
  end
  if ne bw_qmd0 q0 get slots 10 0
    ret 3
  end
  for i ulong 224
    put bank i get driver i
  end
  cb = get m 1
  put bank 68 u32lo shr cb 32
  put bank 69 u32lo cb
  put bank 210 u32lo shr add cb 0x380 32
  put bank 211 u32lo add cb 0x380
  put bank 212 u32lo shr add cb 0x39c 32
  put bank 213 u32lo add cb 0x39c
  put bank 216 128
  put bank 217 1
  put bank 218 1
  put bank 220 u32lo get m 10
  put bank 221 u32lo get m 11
  put bank 222 1
  csr = get slots 12
  wave_bank_va bank 224 add csr 12
  wave_bank_va bank 226 add csr mul add get shape 1 4 4
  wave_bank_va bank 228 get slots 14
  active = get shape 4
  read_slot = add ulong 16 mul active 2
  write_slot = xor read_slot 2
  wave_bank_va bank 230 get slots read_slot
  wave_bank_va bank 232 get slots write_slot
  put bank 234 u32lo get shape 5
  put bank 235 u32lo get shape 6
  ret 0
end

export fn arboris_wave_qmd shape view ulong 7 slots view ulong 20 driver view uint 224 bank edit uint 236 q0 edit uint 96 q1 edit uint 96 to ulong
  if not wave_shape_ok shape false
    ret 1
  end
  if not wave_regions_ok shape slots false
    ret 2
  end
  ret wave_pack shape slots driver bank q0 q1
end

export fn arboris_relax_qmd shape view ulong 7 slots view ulong 20 driver view uint 224 bank edit uint 236 q0 edit uint 96 q1 edit uint 96 to ulong
  if not wave_shape_ok shape true
    ret 1
  end
  if not wave_regions_ok shape slots true
    ret 2
  end
  ret wave_pack shape slots driver bank q0 q1
end

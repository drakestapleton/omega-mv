note SPDX-License-Identifier: AGPL-3.0-only
note One SM121 launch over a locked preorder forest. A warp owns 32 aligned FP16
note vectors per feature tile, grid Y tiles D in units of 256 coordinates.
note Standard somas precede hubs. Four warps share one hub: accumulate raw
note branch vectors into SMEM in parallel, synchronize, then warp 0 folds the
note tree in CPU order using the consumed slots as its stack. No global temps.
note Args at 0x380 are ten uint64 VAs: soma row offsets, branch row offsets,
note source handles, branch metadata, synapse W, branch bias, gate W, pred W,
note read bank, write bank. The dispatcher validates CSR, depth and scratch.
note Physical registers: R0..7 coordinates, R8..23 temporaries/addresses,
note R24..31 branch, R32..39 soma FP32 accumulators, R40..51 traversal,
note R52..63 constants, R64..83 arena argument bases, R84..87 scalar temps.
note SM121 reserves one extra register after the peak and rounds to eight.
const arboris_gated_qmd_regs ulong 96
note cfg words 0..4 hold N,D,standard,standardCTAs,vectors per active warp.
note Label offsets at 16; branch relocation triples at 64, count at 15.

fn gv_mark s view ulong 5 cfg edit ulong 192 label ulong to void
  put cfg add label 16 add get s 0 1
end
fn gv_jump code edit uchar 16384 s edit ulong 5 cfg edit ulong 192 label ulong guard ulong to void
  count = get cfg 15
  if ge count 42
    put s 4 1
    ret
  end
  p = add 64 mul count 3
  put cfg p get s 0
  put cfg add p 1 label
  put cfg add p 2 guard
  put cfg 15 add count 1
  put s 3 guard
  wave_imm code s 46 0 1
end
fn gv_relocate code edit uchar 16384 s edit ulong 5 cfg view ulong 192 to void
  last = get s 0
  for i ulong get cfg 15 bound 42
    p = add 64 mul i 3
    loc = get cfg p
    target = get cfg add 16 get cfg add p 1
    if eq target 0
      put s 4 1
      ret
    end
    put s 0 loc
    put s 3 get cfg add p 2
    wave_imm code s 46 0 and sub sub target 1 loc 0xffffffff
  end
  put s 0 last
end
fn gv_opimm code edit uchar 16384 s edit ulong 5 op ulong dst ulong a ulong imm ulong to void
  put s 1 imm
  wave_ins code s op dst a wave_rz
end
fn gv_imad code edit uchar 16384 s edit ulong 5 dst ulong a ulong imm ulong c ulong to void
  put s 1 imm
  put s 2 c
  wave_ins code s 8 dst a wave_rz
end
fn gv_address code edit uchar 16384 s edit ulong 5 cfg view ulong 192 row ulong base ulong to void
  wave_wide code s 16 row mul 2 get cfg 1 base
  wave_wide code s 16 6 16 16
end
fn gv_index code edit uchar 16384 s edit ulong 5 row ulong base ulong dst ulong to void
  wave_wide code s 16 row 4 base
  wave_ins code s 11 dst 16 wave_rz
end

note A half magnitude shifted left by 13 is the exact binary32 magnitude
note scaled by 2^-112. FMUL without FTZ restores both normals and subnormals.
note Insert the sign afterwards to preserve signed zero.
fn gv_unpack code edit uchar 16384 s edit ulong 5 outreg ulong packed ulong index ulong to void
  src = add packed div index 2
  if ne and index 1 0
    gv_opimm code s 17 84 src 16
    gv_opimm code s 18 85 src 0x80000000
  else
    gv_imad code s 84 src 1 wave_rz
    gv_opimm code s 18 85 src 0x8000
    gv_imad code s 85 85 65536 wave_rz
  end
  gv_opimm code s 18 outreg 84 0x7fff
  gv_imad code s outreg outreg 8192 wave_rz
  wave_ins code s 32 outreg outreg 56
  wave_ins code s 29 outreg outreg 85
end
fn gv_vector code edit uchar 16384 s edit ulong 5 cfg view ulong 192 row ulong base ulong dst ulong to void
  gv_address code s cfg row base
  wave_ins code s 57 dst 16 wave_rz
end
fn gv_frame code edit uchar 16384 s edit ulong 5 index ulong to void
  put s 2 50
  wave_ins code s 8 18 index 51
end
fn gv_shared_load code edit uchar 16384 s edit ulong 5 dst ulong to void
  wave_ins code s 58 dst 18 wave_rz
  put s 1 16
  wave_ins code s 58 add dst 4 18 wave_rz
end
fn gv_shared_store code edit uchar 16384 s edit ulong 5 src ulong to void
  for i ulong 8
    gv_imad code s 19 7 mul i 4 18
    wave_ins code s 50 wave_rz 19 add src i
  end
end
fn gv_pop code edit uchar 16384 s edit ulong 5 cfg edit ulong 192 to void
  gv_mark s cfg 10
  wave_ins code s 28 0 46 43
  gv_jump code s cfg 12 1
  wave_ins code s 14 43 43 55
  gv_frame code s 43
  gv_shared_load code s 24
  for i ulong 8
    wave_ins code s 37 add 24 i add 24 i wave_rz
  end
  wave_ins code s 28 0 wave_rz 43
  gv_jump code s cfg 11 1
  wave_ins code s 14 49 43 55
  gv_frame code s 49
  gv_shared_load code s 8
  for i ulong 8
    wave_ins code s 30 add 8 i add 8 i add 24 i
  end
  gv_shared_store code s 8
  gv_jump code s cfg 10 0
  gv_mark s cfg 11
  for i ulong 8
    wave_ins code s 30 add 32 i add 32 i add 24 i
  end
  gv_jump code s cfg 10 0
end

fn gv_setup code edit uchar 16384 s edit ulong 5 cfg edit ulong 192 to void
  wave_imm code s 3 0 0x21
  wave_imm code s 3 1 0x25
  wave_imm code s 3 2 0x26
  gv_opimm code s 18 3 0 31
  gv_opimm code s 17 4 0 5
  gv_imad code s 6 2 32 3
  wave_imm code s 2 52 div get cfg 1 8
  wave_ins code s 28 0 6 52
  put s 3 1
  wave_ins code s 45 wave_rz wave_rz wave_rz
  wave_imm code s 2 7 1
  wave_imm code s 2 55 0xffffffff
  wave_imm code s 2 56 0x77800000
  wave_imm code s 2 57 0x3f800000
  wave_imm code s 2 58 0xbfb8aa3b
  wave_imm code s 2 59 0x80000000
  wave_imm code s 7 4 0x358
  for i ulong 10
    wave_imm code s 5 add 64 mul i 2 add 0x380 mul i 8
  end
  wave_imm code s 2 52 get cfg 3
  wave_ins code s 28 0 1 52
  gv_jump code s cfg 1 1
  gv_imad code s 5 1 4 4
  wave_imm code s 2 52 get cfg 2
  wave_ins code s 28 0 5 52
  put s 3 1
  wave_ins code s 45 wave_rz wave_rz wave_rz
  wave_imm code s 2 48 0
  gv_imad code s 50 4 get cfg 4 3
  gv_imad code s 50 50 32 wave_rz
  wave_imm code s 2 51 mul get cfg 4 128
  gv_jump code s cfg 2 0
  gv_mark s cfg 1
  wave_imm code s 2 52 sub get cfg 2 get cfg 3
  wave_ins code s 14 5 1 52
  wave_imm code s 2 52 get cfg 0
  wave_ins code s 28 0 5 52
  put s 3 1
  wave_ins code s 45 wave_rz wave_rz wave_rz
  gv_imad code s 50 3 32 wave_rz
  wave_imm code s 2 51 mul get cfg 4 32
  wave_imm code s 2 48 1
  gv_mark s cfg 2
  gv_index code s 5 64 40
  put s 1 4
  wave_ins code s 11 41 16 wave_rz
  for i ulong 8
    wave_imm code s 2 add 32 i 0
  end
  wave_imm code s 2 43 0
  gv_imad code s 42 40 1 wave_rz
  wave_ins code s 28 0 48 7
  gv_jump code s cfg 8 2
  wave_ins code s 14 42 42 4
  gv_mark s cfg 3
  wave_ins code s 28 0 42 41
  gv_jump code s cfg 7 1
end

note Each feature vector occupies one packed word; four vectors share a scale.
fn gv_q4_load code edit uchar 16384 s edit ulong 5 cfg view ulong 192 to void
  gv_imad code s 90 44 div get cfg 1 8 6
  gv_opimm code s 17 91 90 2
  gv_opimm code s 18 90 90 3
  wave_wide code s 16 91 20 72
  wave_ins code s 11 12 16 wave_rz
  wave_wide code s 16 90 4 16
  put s 1 4
  wave_ins code s 11 13 16 wave_rz
end

fn gv_q4_unpack code edit uchar 16384 s edit ulong 5 i ulong to void
  gv_opimm code s 17 87 13 mul 4 i
  gv_opimm code s 18 87 87 15
  wave_ins code s 29 87 87 90
  wave_ins code s 14 87 87 91
  wave_ins code s 31 87 87 92
  wave_ins code s 32 87 87 12
end

fn gv_raw code edit uchar 16384 s edit ulong 5 cfg edit ulong 192 to void
  gv_mark s cfg 4
  gv_vector code s cfg 42 74 8
  for i ulong 8
    gv_unpack code s add 24 i 8 i
  end
  gv_index code s 42 66 44
  put s 1 4
  wave_ins code s 11 45 16 wave_rz
  gv_mark s cfg 5
  wave_ins code s 28 0 44 45
  gv_jump code s cfg 6 1
  gv_index code s 44 68 47
  gv_vector code s cfg 47 80 8
  if eq get cfg 5 0
    gv_vector code s cfg 44 72 12
  else
    gv_q4_load code s cfg
    wave_imm code s 2 90 8
    wave_imm code s 2 91 0x4b000000
    wave_imm code s 2 92 0x4b000008
  end
  for i ulong 8
    gv_unpack code s 86 8 i
    if eq get cfg 5 0
      gv_unpack code s 87 12 i
    else
      gv_q4_unpack code s i
    end
    put s 2 add 24 i
    wave_ins code s 33 add 24 i 86 87
  end
  wave_ins code s 14 44 44 7
  gv_jump code s cfg 5 0
  gv_mark s cfg 6
  wave_ins code s 28 0 48 7
  gv_jump code s cfg 14 2
  gv_imad code s 49 40 0xffffffff 42
  gv_frame code s 49
  gv_shared_store code s 24
  gv_imad code s 42 7 4 42
  gv_jump code s cfg 3 0
  gv_mark s cfg 7
  wave_ins code s 48 wave_rz wave_rz wave_rz
  wave_ins code s 28 0 4 7
  put s 3 1
  wave_ins code s 45 wave_rz wave_rz wave_rz
  gv_imad code s 42 40 1 wave_rz
end

fn gv_tree code edit uchar 16384 s edit ulong 5 cfg edit ulong 192 to void
  gv_mark s cfg 8
  wave_imm code s 2 46 0
  wave_ins code s 28 0 42 41
  gv_jump code s cfg 10 1
  gv_index code s 42 70 46
  gv_opimm code s 17 46 46 24
  gv_pop code s cfg
  gv_mark s cfg 12
  wave_ins code s 28 0 42 41
  gv_jump code s cfg 15 1
  wave_ins code s 28 0 48 7
  gv_jump code s cfg 4 2
  gv_imad code s 49 40 0xffffffff 42
  gv_frame code s 49
  gv_shared_load code s 24
  gv_mark s cfg 14
  gv_frame code s 43
  gv_shared_store code s 24
  wave_ins code s 14 43 43 7
  wave_ins code s 14 42 42 7
  gv_jump code s cfg 8 0
end

fn gv_sigmoid code edit uchar 16384 s edit ulong 5 to void
  wave_ins code s 32 87 87 86
  gv_opimm code s 18 84 87 0x7fffffff
  wave_ins code s 32 84 84 58
  wave_ins code s 47 84 84 wave_rz
  wave_ins code s 30 85 57 84
  wave_ins code s 40 85 85 wave_rz
  wave_ins code s 28 0 87 59
  gv_imad code s 87 85 1 wave_rz
  put s 3 1
  wave_ins code s 32 87 85 84
end

note Positive float bit ordering yields the interval. R90 remembers |x|
note for saturation; R87 retains the signed product until the final select.
fn gv_cubic code edit uchar 16384 s edit ulong 5 to void
  wave_ins code s 32 87 87 86
  gv_opimm code s 18 90 87 0x7fffffff
  wave_imm code s 2 91 0x41800000
  wave_ins code s 28 0 90 91
  gv_imad code s 84 90 1 wave_rz
  put s 3 1
  wave_imm code s 2 84 0
  wave_imm code s 2 91 0x4b000000
  wave_ins code s 30 85 84 91
  gv_opimm code s 18 92 85 31
  wave_ins code s 31 85 85 91
  wave_ins code s 28 0 84 85
  put s 3 2
  wave_ins code s 14 92 92 55
  put s 3 2
  wave_ins code s 31 85 85 57
  wave_ins code s 31 84 84 85
  wave_wide code s 16 92 16 88
  wave_ins code s 57 44 16 wave_rz
  put s 2 46
  wave_ins code s 33 85 84 47
  put s 2 45
  wave_ins code s 33 85 84 85
  put s 2 44
  wave_ins code s 33 85 84 85
  wave_imm code s 2 91 0x41800000
  wave_ins code s 28 0 90 91
  put s 3 1
  wave_imm code s 2 85 0
  wave_ins code s 28 0 87 59
  gv_imad code s 87 85 1 wave_rz
  put s 3 2
  wave_ins code s 31 87 57 85
end

fn gv_gate code edit uchar 16384 s edit ulong 5 cfg edit ulong 192 to void
  gv_mark s cfg 15
  gv_vector code s cfg 5 80 8
  gv_vector code s cfg 5 76 12
  gv_vector code s cfg 5 78 20
  if ne get cfg 5 0
    wave_imm code s 5 88 0x3d0
  end
  for i ulong 8
    y = add 24 i
    gv_unpack code s y 20 i
    gv_unpack code s 86 8 i
    gv_unpack code s 87 12 i
    if eq get cfg 5 0
      gv_sigmoid code s
    else
      gv_cubic code s
    end
    wave_ins code s 32 y y add 32 i
    wave_ins code s 37 y y wave_rz
    wave_ins code s 31 84 57 87
    wave_ins code s 32 84 84 86
    put s 2 84
    wave_ins code s 33 y 87 y
  end
  for i ulong 4
    note F2FP.F16.F32.PACK_AB selects FP16 by clearing the BF16 format bit.
    pack = mul get s 0 16
    low = add 24 mul i 2
    wave_ins code s 61 add 8 i add low 1 low
    put code add pack 9 and get code add pack 9 239
  end
  gv_address code s cfg 5 82
  note STG.E.128 has the same address and source operands as STG.E.
  note The vector width is 6 in word two bits 11:9 (scalar width 4).
  store_pc = mul get s 0 16
  wave_ins code s 12 wave_rz 16 8
  put code add store_pc 9 or get code add store_pc 9 4
  wave_exit code s
end

fn gv_emit_profile n ulong d ulong standard ulong experimental bool code edit uchar 16384 to ulong
  if or eq n 0 gt n 0x1000000
    ret 0
  end
  if or gt standard n or eq d 0 gt d 24576
    ret 0
  end
  if ne and d 7 0
    ret 0
  end
  cfg = new ulong 192 0
  s = new ulong 5 0
  put s 2 wave_rz
  put cfg 0 n
  put cfg 1 d
  put cfg 2 standard
  put cfg 3 div add standard 3 4
  cols = div d 8
  if gt cols 32
    cols = ulong 32
  end
  put cfg 4 cols
  if experimental
    put cfg 5 1
  end
  gv_setup code s cfg
  gv_raw code s cfg
  gv_tree code s cfg
  gv_gate code s cfg
  gv_relocate code s cfg
  if ne get s 4 0
    ret 0
  end
  ret mul get s 0 16
end

export fn arboris_emit_gated n ulong d ulong standard ulong code edit uchar 16384 to ulong
  ret gv_emit_profile n d standard false code
end

note SPDX-License-Identifier: Apache-2.0
note Parse a scalar, fixed array, reference body or parameter type. The longest
note production is "& mut [ scalar ; INT ]". Input beyond EOF is padded with OT_EOF.
note used counts consumed tokens, including on failure. Named references stop
note at NAME so the caller can resolve it against the current declaration table.
note bridge c-define OSC_TYPE_WINDOW 7
note bridge c-define OSC_TYPE_SCALAR 1
note bridge c-define OSC_TYPE_ARRAY 2
note bridge c-define OSC_TYPE_REF_BODY 3
note bridge c-define OSC_TYPE_PARAM 4
note bridge c-define OSC_TYPE_EXPECT_SCALAR 1
note bridge c-define OSC_TYPE_SLICE_ESCAPE 2
note bridge c-define OSC_TYPE_EXPECT_OPEN 3
note bridge c-define OSC_TYPE_EXPECT_SEMI 4
note bridge c-define OSC_TYPE_EXPECT_LENGTH 5
note bridge c-define OSC_TYPE_ZERO_LENGTH 6
note bridge c-define OSC_TYPE_LONG_ARRAY 7
note bridge c-define OSC_TYPE_EXPECT_CLOSE 8
note bridge c-define OSC_TYPE_NAMED_REF 9
note bridge c-define OSC_TYPE_BARE_NAME 10
note bridge c-define OSC_TYPE_LOCAL_ONLY 11
note bridge c-type typerec OscParsedType
om2

layout typerec 24
field used uint at 0 little
field scalar uint at 4 little
field refkind uint at 8 little
field elem uint at 12 little
field count ulong at 16 little
end

note Token and type IDs are the public enums in osc_lex.h and osc_ir.h.
const OT_NAME ushort 1
const OT_INT ushort 2
const OT_MUT ushort 6
const OT_OWN ushort 7
const OT_U8 ushort 21
const OT_I64 ushort 28
const OT_BOOL ushort 29
const OT_LBRACK ushort 34
const OT_RBRACK ushort 35
const OT_SEMI ushort 37
const OT_AMP ushort 47
const OT_HANDLE ushort 66
const OT_POOL ushort 65
const OT_BYTES ushort 68
const OT_CELLS ushort 69
const OSC_TYPE_SCALAR ulong 1
const OSC_TYPE_ARRAY ulong 2
const OSC_TYPE_REF_BODY ulong 3
const OSC_TYPE_PARAM ulong 4
const OSC_TYPE_EXPECT_SCALAR ulong 1
const OSC_TYPE_SLICE_ESCAPE ulong 2
const OSC_TYPE_EXPECT_OPEN ulong 3
const OSC_TYPE_EXPECT_SEMI ulong 4
const OSC_TYPE_EXPECT_LENGTH ulong 5
const OSC_TYPE_ZERO_LENGTH ulong 6
const OSC_TYPE_LONG_ARRAY ulong 7
const OSC_TYPE_EXPECT_CLOSE ulong 8
const OSC_TYPE_NAMED_REF ulong 9
const OSC_TYPE_BARE_NAME ulong 10
const OSC_TYPE_LOCAL_ONLY ulong 11
const TYPE_BOOL uint 1
const TYPE_U8 uint 2
const TYPE_REF uint 10
const TYPE_BYTES uint 11
const TYPE_CELLS uint 12
const REF_OWN uint 1
const REF_SHARED uint 2
const REF_MUT uint 3

fn type_scalar kind ushort to uint
if eq kind OT_BOOL
  ret TYPE_BOOL
end
if and ge kind OT_U8 le kind OT_I64
  ret add TYPE_U8 uint sub kind OT_U8
end
ret 0
end

fn type_scalar_error kind ushort to ulong
if or eq kind OT_BYTES eq kind OT_CELLS
  ret OSC_TYPE_SLICE_ESCAPE
end
ret OSC_TYPE_EXPECT_SCALAR
end

fn type_array kinds view ushort 7 values view ulong 7 pos ulong limit ulong result edit typerec to ulong
if ne get kinds pos OT_LBRACK
  ret OSC_TYPE_EXPECT_OPEN
end
pos = add pos 1
put result used uint pos
kind = get kinds pos
scalar = type_scalar kind
if eq scalar 0
  ret type_scalar_error kind
end
pos = add pos 1
put result used uint pos
if ne get kinds pos OT_SEMI
  ret OSC_TYPE_EXPECT_SEMI
end
pos = add pos 1
put result used uint pos
if ne get kinds pos OT_INT
  ret OSC_TYPE_EXPECT_LENGTH
end
size = get values pos
if eq size 0
  ret OSC_TYPE_ZERO_LENGTH
end
if gt size limit
  ret OSC_TYPE_LONG_ARRAY
end
pos = add pos 1
put result used uint pos
if ne get kinds pos OT_RBRACK
  ret OSC_TYPE_EXPECT_CLOSE
end
put result used uint add pos 1
put result scalar TYPE_REF
put result elem scalar
put result count size
ret 0
end

export fn osc_read_type kinds view ushort 7 values view ulong 7 form ulong refkind ulong limit ulong result edit typerec to ulong
put result used 0
put result scalar 0
put result refkind uint refkind
put result elem 0
put result count 0
pos = ulong 0
kind = get kinds pos
if eq form OSC_TYPE_PARAM
  if eq kind OT_OWN
    put result refkind REF_OWN
    pos = 1
    form = OSC_TYPE_REF_BODY
  end
  if eq kind OT_AMP
    put result refkind REF_SHARED
    pos = 1
    if eq get kinds pos OT_MUT
      put result refkind REF_MUT
      pos = 2
    end
    form = OSC_TYPE_REF_BODY
  end
  put result used uint pos
  if eq form OSC_TYPE_PARAM
    if eq kind OT_NAME
      ret OSC_TYPE_BARE_NAME
    end
    if or eq kind OT_HANDLE eq kind OT_POOL
      ret OSC_TYPE_LOCAL_ONLY
    end
    if or eq kind OT_BYTES eq kind OT_CELLS
      if eq kind OT_BYTES
        put result scalar TYPE_BYTES
      else
        put result scalar TYPE_CELLS
      end
      put result used 1
      ret 0
    end
  end
end
if eq form OSC_TYPE_REF_BODY
  if eq get kinds pos OT_NAME
    ret OSC_TYPE_NAMED_REF
  end
  form = OSC_TYPE_ARRAY
end
if eq form OSC_TYPE_ARRAY
  ret type_array kinds values pos limit result
end
scalar = type_scalar kind
if eq scalar 0
  ret type_scalar_error kind
end
put result scalar scalar
put result used 1
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note OSC ownership trace. Object and borrow arguments are zero-based checker
note IDs or -1. Region, slot and handle arguments already use model IDs.
note bridge c-type trinput OscTraceInput
om2

layout trinput 48
field op uchar at 0 little
field refused uchar at 1 little
field func ushort at 2 little
field line uint at 4 little
field kind uint at 8 little
field obj int at 12 little
field obj2 int at 16 little
field borrow int at 20 little
field via int at 24 little
field region uint at 28 little
field slot uint at 32 little
field handle uint at 36 little
field rights ulong at 40 little
end

const prefix ulong 8
const entry_size ulong 88
const capacity ulong 16384

fn store_bytes trace edit uchar * pos ulong count ulong value ulong to void
  for j ulong count
    put trace add pos j uchar and shr value mul j 8 255
  end
end

fn model_id id int to ulong
  if lt id 0
    ret 0
  end
  ret add ulong id 1
end

fn exceeds_model event view trinput to bool
  if or ge get event obj 64 ge get event obj2 64
    ret true
  end
  if or ge get event borrow 64 ge get event via 64
    ret true
  end
  if or gt get event region 16 gt get event slot 16
    ret true
  end
  ret gt get event handle 64
end

export fn osc_trace_record trace edit uchar * event view trinput to void
requires eq len trace add prefix mul capacity entry_size
  n = ulong 0
  for j ulong 4
    n = or n shl ulong get trace j mul j 8
  end
  if ge n capacity
    put trace 4 1
    ret
  end
  base = add prefix mul n entry_size
  store_bytes trace 0 4 add n 1
  put trace base get event op
  put trace add base 1 get event refused
  store_bytes trace add base 2 2 ulong get event func
  store_bytes trace add base 4 4 ulong get event line
  store_bytes trace add base 8 4 ulong get event kind
  store_bytes trace add base 12 4 model_id get event obj
  store_bytes trace add base 16 4 model_id get event obj2
  store_bytes trace add base 20 4 model_id get event borrow
  store_bytes trace add base 24 4 model_id get event via
  store_bytes trace add base 28 4 ulong get event region
  store_bytes trace add base 32 4 ulong get event slot
  store_bytes trace add base 36 4 ulong get event handle
  note This checker emits neither model cell/token fields nor generations.
  for unused ulong 40
    put trace add add base 40 unused 0
  end
  store_bytes trace add base 80 8 get event rights
  if exceeds_model event
    put trace 4 1
  end
  if ne get event refused 0
    put trace 5 1
  end
end

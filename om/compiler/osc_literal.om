note SPDX-License-Identifier: Apache-2.0
note Decode the spelling of one OSC integer token. Syntax takes precedence over overflow.
note bridge c-define OSC_LITERAL_MALFORMED 1
note bridge c-define OSC_LITERAL_OVERFLOW 2
note The lexer and literal decoder share this unit so integer tokens need no second bridge call.
note bridge c-type lexstate OscLexState
note bridge c-define OSC_LEX_COMMENT 3
note bridge c-define OSC_LEX_FULL 4
note bridge c-define OSC_LEX_NAME_LONG 5
note bridge c-define OSC_LEX_BAD_BYTE 6
om2

layout lexstate 40
field pos ulong at 0 little
field start ulong at 8 little
field value ulong at 16 little
field line uint at 24 little
field col uint at 28 little
field width uint at 32 little
field kind uint at 36 little
end

fn literal_digit c ulong to ulong
if and ge c 48 le c 57
  ret sub c 48
end
if and ge c 65 le c 70
  ret add 10 sub c 65
end
if and ge c 97 le c 102
  ret add 10 sub c 97
end
ret 16
end

export fn osc_parse_literal spelling view uchar * value out ulong 1 to ulong
put value 0 0
radix = ulong 10
pos = ulong 0
if ge len spelling 2
  if eq get spelling 0 48
    prefix = get spelling 1
    if eq prefix 120
      radix = 16
      pos = 2
    end
    if eq prefix 98
      radix = 2
      pos = 2
    end
  end
end
if eq pos len spelling
  ret 1
end
acc = ulong 0
overflow = false
note The input span bounds the scan, including arbitrarily many leading zeroes.
while lt pos len spelling bound 9223372036854775807
  digit = literal_digit ulong get spelling pos
  if ge digit radix
    ret 1
  end
  if gt acc div sub 0xffffffffffffffff digit radix
    overflow = true
  end
  acc = add mul acc radix digit
  pos = add pos 1
end
if overflow
  ret 2
end
put value 0 acc
ret 0
end

note OscTokKind values from src/compiler/osc_lex.h. The oracle exercises every spelling.
const OT_EOF uint 0
const OT_NAME uint 1
const OT_INT uint 2
const OT_RESERVED uint 3
const OT_FN uint 4
const OT_LET uint 5
const OT_MUT uint 6
const OT_OWN uint 7
const OT_ALLOC uint 8
const OT_IF uint 9
const OT_ELSE uint 10
const OT_WHILE uint 11
const OT_BOUND uint 12
const OT_FOR uint 13
const OT_IN uint 14
const OT_RETURN uint 15
const OT_REQUIRES uint 16
const OT_ENSURES uint 17
const OT_AS uint 18
const OT_TRUE uint 19
const OT_FALSE uint 20
const OT_U8 uint 21
const OT_U16 uint 22
const OT_U32 uint 23
const OT_U64 uint 24
const OT_I8 uint 25
const OT_I16 uint 26
const OT_I32 uint 27
const OT_I64 uint 28
const OT_BOOL uint 29
const OT_LPAREN uint 30
const OT_RPAREN uint 31
const OT_LBRACE uint 32
const OT_RBRACE uint 33
const OT_LBRACK uint 34
const OT_RBRACK uint 35
const OT_COMMA uint 36
const OT_SEMI uint 37
const OT_COLON uint 38
const OT_ARROW uint 39
const OT_DOTDOT uint 40
const OT_ASSIGN uint 41
const OT_PLUS uint 42
const OT_MINUS uint 43
const OT_STAR uint 44
const OT_SLASH uint 45
const OT_PERCENT uint 46
const OT_AMP uint 47
const OT_PIPE uint 48
const OT_CARET uint 49
const OT_TILDE uint 50
const OT_BANG uint 51
const OT_ANDAND uint 52
const OT_OROR uint 53
const OT_SHL uint 54
const OT_SHR uint 55
const OT_EQ uint 56
const OT_NE uint 57
const OT_LT uint 58
const OT_LE uint 59
const OT_GT uint 60
const OT_GE uint 61
const OT_STRUCT uint 62
const OT_DOT uint 63
const OT_ARENA uint 64
const OT_POOL uint 65
const OT_HANDLE uint 66
const OT_IMPORT uint 67
const OT_BYTES uint 68
const OT_CELLS uint 69

fn lex_digit c uchar to bool
ret and ge c 48 le c 57
end

fn lex_alpha c uchar to bool
if eq c 95
  ret true
end
ret or and ge c 65 le c 90 and ge c 97 le c 122
end

note Function-mode units cannot contain text globals. Compare exact ASCII spellings
note packed most significant byte first. Identifiers contain no zero bytes.
fn lex_word word view uchar * to uint
if gt len word 10
  ret OT_NAME
end
key = ulong 0
tail = uint 0
index = ulong 0
while lt index len word bound 10
  if lt index 8
    key = or shl key 8 ulong get word index
  else
    tail = or shl tail 8 uint get word index
  end
  index = add index 1
end
if ne tail 0
  note capability
  if and eq key 0x6361706162696c69 eq tail 0x7479
    ret OT_RESERVED
  end
  note authority
  if and eq key 0x617574686f726974 eq tail 0x79
    ret OT_RESERVED
  end
  ret OT_NAME
end
note fn
if eq key 0x666e
  ret OT_FN
end
note let
if eq key 0x6c6574
  ret OT_LET
end
note mut
if eq key 0x6d7574
  ret OT_MUT
end
note own
if eq key 0x6f776e
  ret OT_OWN
end
note alloc
if eq key 0x616c6c6f63
  ret OT_ALLOC
end
note if
if eq key 0x6966
  ret OT_IF
end
note else
if eq key 0x656c7365
  ret OT_ELSE
end
note while
if eq key 0x7768696c65
  ret OT_WHILE
end
note bound
if eq key 0x626f756e64
  ret OT_BOUND
end
note for
if eq key 0x666f72
  ret OT_FOR
end
note in
if eq key 0x696e
  ret OT_IN
end
note return
if eq key 0x72657475726e
  ret OT_RETURN
end
note requires
if eq key 0x7265717569726573
  ret OT_REQUIRES
end
note ensures
if eq key 0x656e7375726573
  ret OT_ENSURES
end
note as
if eq key 0x6173
  ret OT_AS
end
note true
if eq key 0x74727565
  ret OT_TRUE
end
note false
if eq key 0x66616c7365
  ret OT_FALSE
end
note u8
if eq key 0x7538
  ret OT_U8
end
note u16
if eq key 0x753136
  ret OT_U16
end
note u32
if eq key 0x753332
  ret OT_U32
end
note u64
if eq key 0x753634
  ret OT_U64
end
note i8
if eq key 0x6938
  ret OT_I8
end
note i16
if eq key 0x693136
  ret OT_I16
end
note i32
if eq key 0x693332
  ret OT_I32
end
note i64
if eq key 0x693634
  ret OT_I64
end
note bool
if eq key 0x626f6f6c
  ret OT_BOOL
end
note struct
if eq key 0x737472756374
  ret OT_STRUCT
end
note arena
if eq key 0x6172656e61
  ret OT_ARENA
end
note pool
if eq key 0x706f6f6c
  ret OT_POOL
end
note handle
if eq key 0x68616e646c65
  ret OT_HANDLE
end
note import
if eq key 0x696d706f7274
  ret OT_IMPORT
end
note bytes
if eq key 0x6279746573
  ret OT_BYTES
end
note cells
if eq key 0x63656c6c73
  ret OT_CELLS
end
note free
if eq key 0x66726565
  ret OT_RESERVED
end
note drop
if eq key 0x64726f70
  ret OT_RESERVED
end
note delete
if eq key 0x64656c657465
  ret OT_RESERVED
end
note dealloc
if eq key 0x6465616c6c6f63
  ret OT_RESERVED
end
note effect
if eq key 0x656666656374
  ret OT_RESERVED
end
note cap
if eq key 0x636170
  ret OT_RESERVED
end
note mint
if eq key 0x6d696e74
  ret OT_RESERVED
end
note revoke
if eq key 0x7265766f6b65
  ret OT_RESERVED
end
note grant
if eq key 0x6772616e74
  ret OT_RESERVED
end
note publish
if eq key 0x7075626c697368
  ret OT_RESERVED
end
note promote
if eq key 0x70726f6d6f7465
  ret OT_RESERVED
end
note admin
if eq key 0x61646d696e
  ret OT_RESERVED
end
note syscall
if eq key 0x73797363616c6c
  ret OT_RESERVED
end
note io
if eq key 0x696f
  ret OT_RESERVED
end
note print
if eq key 0x7072696e74
  ret OT_RESERVED
end
note extern
if eq key 0x65787465726e
  ret OT_RESERVED
end
note unsafe
if eq key 0x756e73616665
  ret OT_RESERVED
end
note asm
if eq key 0x61736d
  ret OT_RESERVED
end
note loop
if eq key 0x6c6f6f70
  ret OT_RESERVED
end
note match
if eq key 0x6d61746368
  ret OT_RESERVED
end
note enum
if eq key 0x656e756d
  ret OT_RESERVED
end
note var
if eq key 0x766172
  ret OT_RESERVED
end
note const
if eq key 0x636f6e7374
  ret OT_RESERVED
end
note self
if eq key 0x73656c66
  ret OT_RESERVED
end
note rec
if eq key 0x726563
  ret OT_RESERVED
end
note break
if eq key 0x627265616b
  ret OT_RESERVED
end
note continue
if eq key 0x636f6e74696e7565
  ret OT_RESERVED
end
ret OT_NAME
end

fn lex_pair key uint to uint
note ->
if eq key 0x2d3e
  ret OT_ARROW
end
note ..
if eq key 0x2e2e
  ret OT_DOTDOT
end
note &&
if eq key 0x2626
  ret OT_ANDAND
end
note ||
if eq key 0x7c7c
  ret OT_OROR
end
note <<
if eq key 0x3c3c
  ret OT_SHL
end
note >>
if eq key 0x3e3e
  ret OT_SHR
end
note ==
if eq key 0x3d3d
  ret OT_EQ
end
note !=
if eq key 0x213d
  ret OT_NE
end
note <=
if eq key 0x3c3d
  ret OT_LE
end
note >=
if eq key 0x3e3d
  ret OT_GE
end
ret OT_EOF
end

fn lex_single key uint to uint
note (
if eq key 0x28
  ret OT_LPAREN
end
note )
if eq key 0x29
  ret OT_RPAREN
end
note {
if eq key 0x7b
  ret OT_LBRACE
end
note }
if eq key 0x7d
  ret OT_RBRACE
end
note [
if eq key 0x5b
  ret OT_LBRACK
end
note ]
if eq key 0x5d
  ret OT_RBRACK
end
note ,
if eq key 0x2c
  ret OT_COMMA
end
note ;
if eq key 0x3b
  ret OT_SEMI
end
note :
if eq key 0x3a
  ret OT_COLON
end
note =
if eq key 0x3d
  ret OT_ASSIGN
end
note +
if eq key 0x2b
  ret OT_PLUS
end
note -
if eq key 0x2d
  ret OT_MINUS
end
note *
if eq key 0x2a
  ret OT_STAR
end
note /
if eq key 0x2f
  ret OT_SLASH
end
note %
if eq key 0x25
  ret OT_PERCENT
end
note &
if eq key 0x26
  ret OT_AMP
end
note |
if eq key 0x7c
  ret OT_PIPE
end
note ^
if eq key 0x5e
  ret OT_CARET
end
note ~
if eq key 0x7e
  ret OT_TILDE
end
note !
if eq key 0x21
  ret OT_BANG
end
note <
if eq key 0x3c
  ret OT_LT
end
note >
if eq key 0x3e
  ret OT_GT
end
note .
if eq key 0x2e
  ret OT_DOT
end
ret OT_EOF
end

note Leave pos at the first token byte. Only LF advances the line number.
note On an unfinished block comment, report the position of its opening slash.
fn lex_trivia src view uchar * cursor edit lexstate to bool
pos = get cursor pos
line = get cursor line
col = get cursor col
while lt pos len src bound 9223372036854775807
  c = get src pos
  if eq c 10
    line = add line 1
    col = 1
    pos = add pos 1
    continue
  end
  if or eq c 32 or eq c 9 eq c 13
    col = add col 1
    pos = add pos 1
    continue
  end
  if ne c 47
    break
  end
  if eq add pos 1 len src
    break
  end
  nextbyte = get src add pos 1
  if eq nextbyte 47
    while lt pos len src bound 9223372036854775807
      if eq get src pos 10
        break
      end
      pos = add pos 1
      col = add col 1
    end
    continue
  end
  if ne nextbyte 42
    break
  end
  put cursor line line
  put cursor col col
  pos = add pos 2
  col = add col 2
  while true bound 9223372036854775807
    if eq pos len src
      ret false
    end
    c = get src pos
    pos = add pos 1
    col = add col 1
    if eq c 42
      if lt pos len src
        if eq get src pos 47
          pos = add pos 1
          col = add col 1
          break
        end
      end
    end
    if eq c 10
      line = add line 1
      col = 1
    end
  end
end
put cursor pos pos
put cursor line line
put cursor col col
ret true
end

note On entry col is the previous token's start column and width its byte length.
note Tokens never cross a line. Trivia updates both coordinates before the capacity check.
export fn osc_lex_next src view uchar * cursor edit lexstate room ulong namemax ulong to ulong
value = new ulong 1 0
put cursor col add get cursor col get cursor width
if not lex_trivia src cursor
  ret 3
end
if eq room 0
  ret 4
end
start = get cursor pos
put cursor start start
put cursor width 0
put cursor value 0
put cursor kind OT_EOF
if eq start len src
  ret 0
end
c = get src start
pos = add start 1
if or lex_alpha c lex_digit c
  while lt pos len src bound 9223372036854775807
    ch = get src pos
    if not or lex_alpha ch lex_digit ch
      break
    end
    pos = add pos 1
  end
  size = sub pos start
  put cursor pos pos
  put cursor width uint size
  if lex_digit c
    status = osc_parse_literal part src start size value
    if ne status 0
      ret status
    end
    put cursor value get value 0
    put cursor kind OT_INT
  else
    if gt ulong uint size namemax
      ret 5
    end
    put cursor kind lex_word part src start size
  end
  ret 0
end
kind = OT_EOF
if lt pos len src
  pair = or shl uint c 8 uint get src pos
  kind = lex_pair pair
end
if ne kind OT_EOF
  pos = add pos 1
else
  kind = lex_single uint c
  if eq kind OT_EOF
    ret 6
  end
end
put cursor kind kind
put cursor pos pos
put cursor width uint sub pos start
ret 0
end

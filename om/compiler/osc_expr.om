note SPDX-License-Identifier: Apache-2.0
note OSC infix expressions. Pending operators are strictly increasing in precedence.
note Thus nine precedence levels need nine slots regardless of expression length.
note The caller supplies one parsed unary operand at a time, allocates AST nodes
note on shift, and attaches their edges on reduction. No syntax tree is buffered.
note bridge c-type exprstk OscExprStack
note bridge c-define OSC_EXPR_DONE 0
note bridge c-define OSC_EXPR_SHIFT 1
note bridge c-define OSC_EXPR_REDUCE 2
note bridge c-define OSC_EXPR_CHAINED 3
om2

layout exprstk 120
field depth uint at 0 little
field rank uint 9 at 4 little
field node int 9 at 40 little
field lhs int 9 at 76 little
field parent int at 112 little
field left int at 116 little
end

const OT_PLUS uint 42
const OT_MINUS uint 43
const OT_STAR uint 44
const OT_SLASH uint 45
const OT_PERCENT uint 46
const OT_AMP uint 47
const OT_PIPE uint 48
const OT_CARET uint 49
const OT_ANDAND uint 52
const OT_OROR uint 53
const OT_SHL uint 54
const OT_SHR uint 55
const OT_EQ uint 56
const OT_GE uint 61
const CMP_RANK uint 3
const EXPR_DONE ulong 0
const EXPR_SHIFT ulong 1
const EXPR_REDUCE ulong 2
const EXPR_CHAINED ulong 3

fn expr_rank kind uint to uint
if eq kind OT_OROR
  ret 1
end
if eq kind OT_ANDAND
  ret 2
end
if and ge kind OT_EQ le kind OT_GE
  ret CMP_RANK
end
if eq kind OT_PIPE
  ret 4
end
if eq kind OT_CARET
  ret 5
end
if eq kind OT_AMP
  ret 6
end
if or eq kind OT_SHL eq kind OT_SHR
  ret 7
end
if or eq kind OT_PLUS eq kind OT_MINUS
  ret 8
end
if or eq kind OT_STAR or eq kind OT_SLASH eq kind OT_PERCENT
  ret 9
end
ret 0
end

export fn osc_expr_step stack edit exprstk look ulong operand ulong to ulong
rank = expr_rank uint look
depth = get stack depth
if ne depth 0
  top = ulong sub depth 1
  pending = get stack rank top
  if ge pending rank
    put stack depth sub depth 1
    put stack parent get stack node top
    put stack left get stack lhs top
    if and eq pending CMP_RANK eq rank CMP_RANK
      ret EXPR_CHAINED
    end
    ret EXPR_REDUCE
  end
end
if eq rank 0
  ret EXPR_DONE
end
put stack rank ulong depth rank
put stack lhs ulong depth int operand
put stack depth add depth 1
ret EXPR_SHIFT
end

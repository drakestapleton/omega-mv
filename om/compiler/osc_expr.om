note SPDX-License-Identifier: Apache-2.0
note OSC infix expressions. Pending operators are strictly increasing in precedence.
note Thus nine precedence levels need nine slots regardless of expression length.
note The caller supplies one parsed unary operand at a time, allocates AST nodes
note on shift, and attaches their edges on reduction. No syntax tree is buffered.
note bridge c-type exprstk OscExprStack
note bridge c-define OSC_EXPR_DONE 0
note bridge c-define OSC_EXPR_SHIFT 1
note bridge c-define OSC_EXPR_REDUCE 2
note bridge c-define OSC_EXPR_CHAINED 3
note bridge c-type opstate OscOperandState
note bridge c-define OSC_OPERAND_DONE 0
note bridge c-define OSC_OPERAND_PREFIX 1
note bridge c-define OSC_OPERAND_INTEGER 2
note bridge c-define OSC_OPERAND_TRUE 3
note bridge c-define OSC_OPERAND_FALSE 4
note bridge c-define OSC_OPERAND_NAME 5
note bridge c-define OSC_OPERAND_CALL 6
note bridge c-define OSC_OPERAND_FIELD 7
note bridge c-define OSC_OPERAND_INDEX 8
note bridge c-define OSC_OPERAND_POOL 9
note bridge c-define OSC_OPERAND_GROUP 10
note bridge c-define OSC_OPERAND_BORROW_ERROR 11
note bridge c-define OSC_OPERAND_SYNTAX 12
note bridge c-define OSC_OPERAND_CAST 13
note bridge c-define OSC_OPERAND_CAST_ERROR 14
note bridge c-define OSC_OPERAND_UNWIND 15
om2

layout exprstk 120
field depth uint at 0 little
field rank uint 9 at 4 little
field node int 9 at 40 little
field lhs int 9 at 76 little
field parent int at 112 little
field left int at 116 little
end

note Prefix nodes are consecutive until the primary begins. Unwind links them
note only after a successful primary and cast, preserving partial ASTs on errors.
layout opstate 12
field phase uint at 0 little
field prefixes uint at 4 little
field pending uint at 8 little
end

const OP_DONE ulong 0
const OP_PREFIX ulong 1
const OP_INTEGER ulong 2
const OP_TRUE ulong 3
const OP_FALSE ulong 4
const OP_NAME ulong 5
const OP_CALL ulong 6
const OP_FIELD ulong 7
const OP_INDEX ulong 8
const OP_POOL ulong 9
const OP_GROUP ulong 10
const OP_BORROW_ERROR ulong 11
const OP_SYNTAX ulong 12
const OP_CAST ulong 13
const OP_CAST_ERROR ulong 14
const OP_UNWIND ulong 15

const OT_PLUS uint 42
const OT_MINUS uint 43
const OT_STAR uint 44
const OT_SLASH uint 45
const OT_PERCENT uint 46
const OT_AMP uint 47
const OT_PIPE uint 48
const OT_CARET uint 49
const OT_ANDAND uint 52
const OT_OROR uint 53
const OT_SHL uint 54
const OT_SHR uint 55
const OT_EQ uint 56
const OT_GE uint 61
const CMP_RANK uint 3
const EXPR_DONE ulong 0
const EXPR_SHIFT ulong 1
const EXPR_REDUCE ulong 2
const EXPR_CHAINED ulong 3

fn expr_rank kind uint to uint
if eq kind OT_OROR
  ret 1
end
if eq kind OT_ANDAND
  ret 2
end
if and ge kind OT_EQ le kind OT_GE
  ret CMP_RANK
end
if eq kind OT_PIPE
  ret 4
end
if eq kind OT_CARET
  ret 5
end
if eq kind OT_AMP
  ret 6
end
if or eq kind OT_SHL eq kind OT_SHR
  ret 7
end
if or eq kind OT_PLUS eq kind OT_MINUS
  ret 8
end
if or eq kind OT_STAR or eq kind OT_SLASH eq kind OT_PERCENT
  ret 9
end
ret 0
end

export fn osc_expr_step stack edit exprstk look ulong operand ulong to ulong
rank = expr_rank uint look
depth = get stack depth
if ne depth 0
  top = ulong sub depth 1
  pending = get stack rank top
  if ge pending rank
    put stack depth sub depth 1
    put stack parent get stack node top
    put stack left get stack lhs top
    if and eq pending CMP_RANK eq rank CMP_RANK
      ret EXPR_CHAINED
    end
    ret EXPR_REDUCE
  end
end
if eq rank 0
  ret EXPR_DONE
end
put stack rank ulong depth rank
put stack lhs ulong depth int operand
put stack depth add depth 1
ret EXPR_SHIFT
end
const OT_LPAREN uint 30
const OT_LBRACK uint 34
const OT_DOT uint 63
const OT_ALLOC uint 8
const OT_AS uint 18
const OT_INT uint 2
const OT_NAME uint 1
const OT_TRUE uint 19
const OT_FALSE uint 20
const OT_BANG uint 51
const OT_TILDE uint 50

note phase 0 scans prefixes and selects the primary, phase 1 permits one cast,
note phase 2 refuses a second cast, phase 3 attaches the pending prefix nodes.
export fn osc_operand_step state edit opstate kind ulong nextkind ulong third ulong to ulong
phase = get state phase
if eq phase 0
  if or eq uint kind OT_MINUS or eq uint kind OT_TILDE eq uint kind OT_BANG
    put state prefixes add get state prefixes 1
    ret OP_PREFIX
  end
  put state phase 1
  if eq uint kind OT_INT
    ret OP_INTEGER
  end
  if eq uint kind OT_TRUE
    ret OP_TRUE
  end
  if eq uint kind OT_FALSE
    ret OP_FALSE
  end
  if eq uint kind OT_NAME
    if eq uint nextkind OT_LPAREN
      ret OP_CALL
    end
    if eq uint nextkind OT_LBRACK
      ret OP_INDEX
    end
    if eq uint nextkind OT_DOT
      if eq uint third OT_ALLOC
        ret OP_POOL
      end
      ret OP_FIELD
    end
    ret OP_NAME
  end
  if eq uint kind OT_LPAREN
    ret OP_GROUP
  end
  if eq uint kind OT_AMP
    ret OP_BORROW_ERROR
  end
  ret OP_SYNTAX
end
if eq uint kind OT_AS
  if eq phase 1
    put state phase 2
    ret OP_CAST
  end
  if eq phase 2
    ret OP_CAST_ERROR
  end
end
put state phase 3
count = get state prefixes
if ne count 0
  put state pending sub count 1
  put state prefixes sub count 1
  ret OP_UNWIND
end
ret OP_DONE
end

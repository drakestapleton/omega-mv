note SPDX-License-Identifier: Apache-2.0
note Definite pool usage for OSC versioned handles. Crossing a conditional
note free invalidates the live-slot bound. The generation budget still applies.
note bridge c-type poolstat OscCheckedPool
note bridge c-define OSC_POOL_FULL 1
note bridge c-define OSC_POOL_RETIRED 2
om2

layout poolstat 32
field gbase ulong at 0 little
field dallocs ulong at 8 little
field loop int at 16 little
field branch int at 20 little
field cap ushort at 24 little
field dlive ushort at 26 little
field cap_off uchar at 28 little
end

export fn osc_pool_init p edit poolstat cap ulong base ulong loop_depth long cond_depth long to void
  put p gbase base
  put p dallocs 0
  put p loop int loop_depth
  put p branch int cond_depth
  put p cap ushort cap
  put p dlive 0
  put p cap_off 0
end

fn definite p view poolstat loop_depth long cond_depth long to bool
  ret and eq long get p loop loop_depth eq long get p branch cond_depth
end

export fn osc_pool_alloc p edit poolstat loop_depth long cond_depth long to ulong
  if not definite p loop_depth cond_depth
    ret 0
  end
  live = ulong get p dlive
  slots = ulong get p cap
  if and eq get p cap_off 0 ge live slots
    ret 1
  end
  remaining = sub ulong 18446744073709551615 get p gbase
  allocations = add get p dallocs 1
  if and lt remaining 4294967296 gt allocations mul slots add remaining 1
    ret 2
  end
  put p dallocs allocations
  if eq get p cap_off 0
    put p dlive ushort add live 1
  end
  ret 0
end

export fn osc_pool_free p edit poolstat loop_depth long cond_depth long to void
  if not definite p loop_depth cond_depth
    put p cap_off 1
  else
    live = get p dlive
    if ne live 0
      put p dlive sub live 1
    end
  end
end

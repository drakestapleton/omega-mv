note SPDX-License-Identifier: Apache-2.0
note Definite pool usage for OSC versioned handles. Crossing a conditional
note free invalidates the live-slot bound. The generation budget still applies.
note bridge c-type poolstat OscCheckedPool
note bridge c-define OSC_POOL_FULL 1
note bridge c-define OSC_POOL_RETIRED 2
note bridge c-type handles OscHandleState
note bridge c-define OSC_HANDLE_UNKNOWN 0
note bridge c-define OSC_HANDLE_LIVE 1
note bridge c-define OSC_HANDLE_STALE 2
note bridge c-define OSC_HANDLE_STALE_COPY 3
om2

note Each allocation creates exactly one provenance, one model slot and one
note model handle. Model IDs are one-based. Bindings have their own monotonically
note assigned indices so a branch snapshot visits only actual handle bindings.
layout handles 2952
field count uint at 0 little
field nbind uint at 4 little
field freed uchar 1024 at 8 little
field binding int 480 at 1032 little
end

layout poolstat 32
field gbase ulong at 0 little
field dallocs ulong at 8 little
field loop int at 16 little
field branch int at 20 little
field cap ushort at 24 little
field dlive ushort at 26 little
field cap_off uchar at 28 little
end

export fn osc_pool_init p edit poolstat cap ulong base ulong loop_depth long cond_depth long to void
  put p gbase base
  put p dallocs 0
  put p loop int loop_depth
  put p branch int cond_depth
  put p cap ushort cap
  put p dlive 0
  put p cap_off 0
end

fn definite p view poolstat loop_depth long cond_depth long to bool
  ret and eq long get p loop loop_depth eq long get p branch cond_depth
end

export fn osc_pool_alloc p edit poolstat loop_depth long cond_depth long to ulong
  if not definite p loop_depth cond_depth
    ret 0
  end
  live = ulong get p dlive
  slots = ulong get p cap
  if and eq get p cap_off 0 ge live slots
    ret 1
  end
  remaining = sub ulong 18446744073709551615 get p gbase
  allocations = add get p dallocs 1
  if and lt remaining 4294967296 gt allocations mul slots add remaining 1
    ret 2
  end
  put p dallocs allocations
  if eq get p cap_off 0
    put p dlive ushort add live 1
  end
  ret 0
end

export fn osc_pool_free p edit poolstat loop_depth long cond_depth long to void
  if not definite p loop_depth cond_depth
    put p cap_off 1
  else
    live = get p dlive
    if ne live 0
      put p dlive sub live 1
    end
  end
end

export fn osc_handle_allocate h edit handles to long
  p = ulong get h count
  if ge p 1024
    ret -1
  end
  put h count uint add p 1
  put h freed p 0
  ret long p
end

export fn osc_handle_bind h edit handles provenance long to ulong
requires lt get h nbind 480
  b = ulong get h nbind
  put h nbind uint add b 1
  put h binding b int provenance
  ret b
end

note An unknown provenance produces no model event. A refused free retains
note the first free site, including when the second access is through a copy.
export fn osc_handle_visit h edit handles sites edit ulong 1024 b ulong freeing ulong symbol long line ulong to ulong
requires lt b ulong get h nbind
  provenance = get h binding b
  if lt provenance 0
    ret 0
  end
  p = ulong provenance
  if ne get h freed p 0
    if ne shr get sites p 32 ulong symbol
      ret 3
    end
    ret 2
  end
  if ne freeing 0
    put h freed p 1
    put sites p or shl ulong symbol 32 ulong uint line
  end
  ret 1
end

export fn osc_handles_save h view handles s edit handles to void
  put s count get h count
  put s nbind get h nbind
  for p ulong ulong get h count
    put s freed p get h freed p
  end
  for b ulong ulong get h nbind
    put s binding b get h binding b
  end
end

note Restoring a branch retains fresh allocation and binding IDs. A loop
note restores definite frees only, then settles possible binding assignments.
export fn osc_handles_restore h edit handles s view handles bindings ulong to void
  for p ulong ulong get s count
    put h freed p get s freed p
  end
  if ne bindings 0
    for b ulong ulong get s nbind
      put h binding b get s binding b
    end
  end
end

export fn osc_handles_settle h edit handles before view handles other view handles to void
  for b ulong ulong get before nbind
    initial = get before binding b
    if or ne get h binding b initial ne get other binding b initial
      put h binding b -1
    end
  end
end

note Return newly definite frees in original model-event order.
export fn osc_handle_frees h view handles before view handles ids edit uint 1024 to ulong
  count = ulong 0
  for p ulong ulong get before count
    if and ne get h freed p 0 eq get before freed p 0
      put ids count uint add p 1
      count = add count 1
    end
  end
  ret count
end

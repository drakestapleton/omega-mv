note SPDX-License-Identifier: Apache-2.0
note Scalar semantics of validated OSC IR. Checked operations return the OSC
note trap code as data. The host delivers that trap through the program runtime.
om2

note IDs from osc_ir.h. Operands enter in their canonical 64-bit representation.
const T_BOOL ulong 1
const T_U8 ulong 2
const T_U64 ulong 5
const T_I8 ulong 6
const T_I64 ulong 9
const SIGN64 ulong 0x8000000000000000
const OVERFLOW ulong 1
const DIV_ZERO ulong 2
const CAST_RANGE ulong 5
const BAD_SHIFT ulong 7
const BAD_OPCODE ulong 8

note Contract bindings contain known scalar arguments and the optional result.
note bridge c-type contract OscContractBindings
note Function calls preserve left-to-right checking. This frame pairs parsed
note arguments with parameters and records cell slices already bound at the call.
note bridge c-type callargs OscCallArgs
note bridge c-define OSC_ARG_SCALAR 1
note bridge c-define OSC_ARG_SLICE 2
note bridge c-define OSC_ARG_OWNER 3
note bridge c-define OSC_ARG_BORROW 4
note bridge c-define OSC_ARG_SCALAR_BORROW 5
note bridge c-define OSC_ARG_SLICE_BORROW 6
note bridge c-define OSC_ARG_OWNER_FORM 7
note bridge c-define OSC_ARG_BORROW_FORM 8
layout callargs 112
field params int 6 at 0 little
field args int 7 at 24 little
field actions uint 6 at 52 little
field cells int 6 at 76 little
field np uint at 100 little
field na uint at 104 little
field clause uint at 108 little
end

layout contract 80
field v ulong 6 at 0 little
field k uchar 6 at 48 little
field nk int at 56 little
field res_sym int at 60 little
field known uchar at 64 little
field result ulong at 72 little
end

note Offsets refer to the OscNode representation asserted at its C boundary.
const ast_stride ulong 104
const arg_scalar uint 1
const arg_slice uint 2
const arg_owner uint 3
const arg_borrow uint 4
const bad_scalar_borrow uint 5
const bad_slice_borrow uint 6
const bad_owner_form uint 7
const bad_borrow_form uint 8
const node_borrow ulong 20
const type_ref ulong 10
const type_bytes ulong 11
const type_cells ulong 12
const ref_own ulong 1
const ref_mut ulong 3
const node_int ulong 15
const node_bool ulong 16
const node_name ulong 17
const node_bin ulong 21
const node_un ulong 22
const node_cast ulong 23
const node_type ulong 56
const node_flag ulong 73
const node_known ulong 75
const node_value ulong 80
const node_symbol ulong 88

note The checker calls back into its general expression checker for each
note operand. The frame preserves the exact evaluation order and type context.
note bridge c-type infer OscInference
note bridge c-define OSC_INFER_DONE 0
note bridge c-define OSC_INFER_CHECK 1
note bridge c-define OSC_INFER_CAST_LITERAL 2
note bridge c-define OSC_INFER_COMPARE_LITERALS 3
note bridge c-define OSC_INFER_COMPARE_BOOL 4
note bridge c-define OSC_INFER_ARITH_BOOL 5
note bridge c-define OSC_INFER_UNARY_TYPE 6
note bridge c-define OSC_INFER_CAST_TYPE 7
note bridge c-define OSC_INFER_SHIFT_TYPE 8
note bridge c-define OSC_INFER_AMOUNT_TYPE 9
note bridge c-define OSC_INFER_SHIFT_RANGE 10
note bridge c-define OSC_INFER_ARITH_TYPE 11
note bridge c-define OSC_INFER_ZERO_DIVISOR 12

layout infer 72
field root ulong at 0 little
field want ulong at 8 little
field phase ulong at 16 little
field first ulong at 24 little
field second ulong at 32 little
field literal2 ulong at 40 little
field optype ulong at 48 little
field site ulong at 56 little
field context ulong at 64 little
end

fn alu_signed t ulong to bool
ret and ge t T_I8 le t T_I64
end

export fn osc_alu_width t ulong to ulong
if eq t T_BOOL
  ret 1
end
if and ge t T_U8 le t T_U64
  ret shl ulong 8 sub t T_U8
end
if alu_signed t
  ret shl ulong 8 sub t T_I8
end
ret 0
end

fn alu_mask width ulong to ulong
if eq width 64
  ret 0xffffffffffffffff
end
ret sub shl ulong 1 width 1
end

export fn osc_alu_canon t ulong v ulong to ulong
w = osc_alu_width t
v = and v alu_mask w
if alu_signed t
  sign = shl ulong 1 sub w 1
  v = sub xor v sign sign
end
ret v
end

fn alu_mag v ulong to ulong
if ge v SIGN64
  ret sub ulong 0 v
end
ret v
end

fn alu_limit width ulong negative bool to ulong
top = shl ulong 1 sub width 1
if negative
  ret top
end
ret sub top 1
end

fn alu_addsub op ulong t ulong a ulong b ulong value edit ulong 1 to ulong
w = osc_alu_width t
signedop = alu_signed t
r = add a b
if eq op 2
  r = sub a b
end
if signedop
  sign = shl ulong 1 sub w 1
  changed = and xor r a sign
  diff = and xor a b sign
  if ne changed 0
    if eq eq op 1 eq diff 0
      ret OVERFLOW
    end
  end
end
put value 0 osc_alu_canon t r
ret 0
end

fn alu_mul t ulong a ulong b ulong value edit ulong 1 to ulong
w = osc_alu_width t
signedop = alu_signed t
if signedop
  limit = alu_limit w ge xor a b SIGN64
  bm = alu_mag b
  if ne bm 0
    if gt alu_mag a div limit bm
      ret OVERFLOW
    end
  end
end
put value 0 osc_alu_canon t mul a b
ret 0
end

fn alu_divrem op ulong t ulong a ulong b ulong value edit ulong 1 to ulong
w = osc_alu_width t
signedop = alu_signed t
if eq b 0
  ret DIV_ZERO
end
am = a
bm = b
if signedop
  am = alu_mag a
  bm = alu_mag b
end
if eq op 4
  r = div am bm
  if signedop
    negative = ge xor a b SIGN64
    if gt r alu_limit w negative
      ret OVERFLOW
    end
    if negative
      r = sub ulong 0 r
    end
  end
  put value 0 r
else
  r = rem am bm
  if and signedop ge a SIGN64
    r = sub ulong 0 r
  end
  put value 0 r
end
ret 0
end

fn alu_shift op ulong t ulong a ulong b ulong value edit ulong 1 to ulong
w = osc_alu_width t
signedop = alu_signed t
note A negative canonical count is unsigned-greater than every valid width.
if ge b w
  ret BAD_SHIFT
end
if eq op 9
  if signedop
    limit = alu_limit w ge a SIGN64
    if gt alu_mag a shr limit b
      ret OVERFLOW
    end
  end
  put value 0 osc_alu_canon t shl a b
else
  r = shr a b
  if and signedop ge a SIGN64
    r = not shr not a b
  end
  put value 0 r
end
ret 0
end

export fn osc_alu_bin op ulong t ulong a ulong b ulong value out ulong 1 to ulong
put value 0 0
if eq osc_alu_width t 0
  ret BAD_OPCODE
end
if or eq op 1 eq op 2
  ret alu_addsub op t a b value
end
if eq op 3
  ret alu_mul t a b value
end
if or eq op 4 eq op 5
  ret alu_divrem op t a b value
end
if eq op 6
  put value 0 and a b
  ret 0
end
if eq op 7
  put value 0 or a b
  ret 0
end
if eq op 8
  put value 0 xor a b
  ret 0
end
if or eq op 9 eq op 10
  ret alu_shift op t a b value
end
ret BAD_OPCODE
end

export fn osc_alu_un op ulong t ulong a ulong value out ulong 1 to ulong
put value 0 0
if eq op 1
  if alu_signed t
    if ge a SIGN64
      if gt alu_mag a alu_limit osc_alu_width t false
        ret OVERFLOW
      end
    end
  end
  put value 0 osc_alu_canon t sub ulong 0 a
  ret 0
end
if eq op 2
  put value 0 osc_alu_canon t not a
  ret 0
end
if eq op 3
  put value 0 xor a 1
  ret 0
end
ret BAD_OPCODE
end

fn alu_truth flag bool to ulong
if flag
  ret 1
end
ret 0
end

export fn osc_alu_cmp cc ulong t ulong a ulong b ulong to ulong
if alu_signed t
  a = xor a SIGN64
  b = xor b SIGN64
end
if eq cc 1
  ret alu_truth eq a b
end
if eq cc 2
  ret alu_truth ne a b
end
if eq cc 3
  ret alu_truth lt a b
end
if eq cc 4
  ret alu_truth le a b
end
if eq cc 5
  ret alu_truth gt a b
end
if eq cc 6
  ret alu_truth ge a b
end
ret 0
end

export fn osc_alu_cast target ulong src ulong a ulong value out ulong 1 to ulong
put value 0 0
negative = and alu_signed src ge a SIGN64
width = osc_alu_width target
if alu_signed target
  magnitude = a
  if negative
    magnitude = alu_mag a
  end
  if gt magnitude alu_limit width negative
    ret CAST_RANGE
  end
else
  if or negative gt a alu_mask width
    ret CAST_RANGE
  end
end
put value 0 a
ret 0
end

note OSC surface token numbers from osc_lex.h and scalar sub-opcodes from osc_ir.h.
const TOK_PLUS ulong 42
const TOK_XOR ulong 49
const TOK_SHL ulong 54
const TOK_SHR ulong 55
const TOK_EQ ulong 56
const TOK_GE ulong 61

export fn osc_binary_opcode tok ulong to ulong
if and ge tok TOK_PLUS le tok TOK_XOR
  ret add sub tok TOK_PLUS 1
end
if eq tok TOK_SHL
  ret 9
end
if eq tok TOK_SHR
  ret 10
end
ret 0
end

export fn osc_compare_opcode tok ulong to ulong
if and ge tok TOK_EQ le tok TOK_GE
  ret add sub tok TOK_EQ 1
end
ret 0
end

note The minus of a literal may denote the signed minimum directly, even
note though its positive magnitude cannot stand alone as that signed type.
export fn osc_literal_fits t ulong magnitude ulong negative ulong to ulong
w = osc_alu_width t
if alu_signed t
  ret alu_truth le magnitude alu_limit w ne negative 0
end
if ne negative 0
  ret alu_truth eq magnitude 0
end
ret alu_truth le magnitude alu_mask w
end

fn ast_read nodes view uchar * atbyte ulong bytes ulong to ulong
  v = ulong 0
  for i ulong bytes
    v = or v shl ulong get nodes add atbyte i mul i 8
  end
  ret v
end

fn contract_leaf nodes view uchar * base ulong env view contract value edit ulong 1 to ulong
  if ne get nodes add base node_known 0
    put value 0 ast_read nodes add base node_value 8
    ret 1
  end
  kind = ast_read nodes base 2
  if eq kind node_bool
    put value 0 alu_truth ne ast_read nodes add base 32 8 0
    ret 1
  end
  if eq kind node_name
    symbol = long int uint ast_read nodes add base node_symbol 4
    if lt symbol 0
      ret 0
    end
    if lt symbol long get env nk
      if ne get env k ulong symbol 0
        put value 0 get env v ulong symbol
        ret 1
      end
    end
    if and eq symbol long get env res_sym ne get env known 0
      put value 0 get env result
      ret 1
    end
    ret 0
  end
  if or eq kind node_un or eq kind node_cast eq kind node_bin
    ret 2
  end
  ret 0
end

fn contract_unary nodes view uchar * base ulong value edit ulong 1 to ulong
  typ = ast_read nodes add base node_type 4
  if eq ast_read nodes base 2 node_cast
    child = ast_read nodes add base 12 4
    src = ast_read nodes add mul child ast_stride node_type 4
    ret alu_truth eq osc_alu_cast typ src get value 0 value 0
  end
  tok = ast_read nodes add base 2 2
  unop = ulong 1
  if eq tok 51
    unop = 3
  else
    if eq tok 50
      unop = 2
    end
  end
  ret alu_truth eq osc_alu_un unop typ get value 0 value 0
end

fn contract_binary nodes view uchar * base ulong left ulong value edit ulong 1 to ulong
  tok = ast_read nodes add base 2 2
  if or eq tok 52 eq tok 53
    ret 1
  end
  cc = osc_compare_opcode tok
  if ne cc 0
    put value 0 osc_alu_cmp cc ulong get nodes add base node_flag left get value 0
    ret 1
  end
  typ = ast_read nodes add base node_type 4
  ret alu_truth eq osc_alu_bin osc_binary_opcode tok typ left get value 0 value 0
end

fn short_circuit nodes view uchar * base ulong value ulong to bool
  op = ast_read nodes add base 2 2
  ret or and eq op 52 eq value 0 and eq op 53 ne value 0
end

note Each work entry holds the node and its continuation. The second half of
note the stack holds left operands while right subtrees are being evaluated.
export fn osc_contract_value nodes view uchar * env view contract stack edit ulong * request edit ulong 2 to ulong
  value = new ulong 1 0
  depth = ulong 1
  put stack 0 mul get request 0 4
  while ne depth 0 bound 65537
    top = sub depth 1
    base = mul shr get stack top 2 ast_stride
    phase = and get stack top 3
    if eq phase 0
      choice = contract_leaf nodes base env value
      if eq choice 0
        ret 0
      end
      if eq choice 2
        put stack top add get stack top 1
        put stack depth mul ast_read nodes add base 12 4 4
        depth = add depth 1
        continue
      end
    else
      if ne ast_read nodes base 2 node_bin
        if eq contract_unary nodes base value 0
          ret 0
        end
      else
        if eq phase 1
          if short_circuit nodes base get value 0
            put value 0 alu_truth ne get value 0 0
          else
            put stack add top div len stack 2 get value 0
            put stack top add get stack top 1
            put stack depth mul ast_read nodes add base 16 4 4
            depth = add depth 1
            continue
          end
        else
          if eq contract_binary nodes base get stack add top div len stack 2 value 0
            ret 0
          end
        end
      end
    end
    depth = top
  end
  put request 1 get value 0
  ret 1
end

note Both classifications accept integer literals and arithmetic subtrees.
note Shift width comes from its left child; folding also needs a literal RHS.
fn needs_rhs op ulong literals ulong to bool
  ret or ne literals 0 not or eq op TOK_SHL eq op TOK_SHR
end

export fn osc_constant_tree nodes view uchar * id ulong require_literals ulong pending edit ulong * to ulong
  count = ulong 1
  put pending 0 id
  while ne count 0 bound 16384
    count = sub count 1
    base = mul get pending count ast_stride
    kind = ast_read nodes base 2
    if eq kind node_int
      continue
    end
    op = ast_read nodes add base 2 2
    if eq kind node_un
      if eq op 51
        ret 0
      end
    else
      if or ne kind node_bin eq osc_binary_opcode op 0
        ret 0
      end
      if needs_rhs op require_literals
        put pending count ast_read nodes add base 16 4
        count = add count 1
      end
    end
    put pending count ast_read nodes add base 12 4
    count = add count 1
  end
  ret 1
end

note Folding annotates the node only after its operands succeed. Negative
note signed minimum is allowed as a single literal, though its positive
note magnitude cannot stand alone in that type.
fn ast_write nodes edit uchar * pos ulong bytes ulong v ulong to void
  for j ulong bytes
    put nodes add pos j uchar and shr v mul j 8 255
  end
end

fn mark_folded nodes edit uchar * base ulong typ ulong v ulong to void
  ast_write nodes add base node_type 4 typ
  put nodes add base node_known 1
  ast_write nodes add base node_value 8 v
end

fn fold_leaf nodes edit uchar * base ulong typ ulong report edit ulong 3 to ulong
  magnitude = ast_read nodes add base 32 8
  if eq osc_literal_fits typ magnitude 0 0
    put report 2 magnitude
    ret 2
  end
  mark_folded nodes base typ magnitude
  ret 0
end

fn fold_neg_literal nodes edit uchar * base ulong typ ulong report edit ulong 3 to ulong
  child = mul ast_read nodes add base 12 4 ast_stride
  magnitude = ast_read nodes add child 32 8
  put report 2 magnitude
  if and not alu_signed typ ne magnitude 0
    ret 3
  end
  if eq osc_literal_fits typ magnitude 1 0
    ret 4
  end
  mark_folded nodes child typ magnitude
  mark_folded nodes base typ sub ulong 0 magnitude
  ret 0
end

fn fold_unary nodes edit uchar * base ulong typ ulong to ulong
  input = ast_read nodes add mul ast_read nodes add base 12 4 ast_stride node_value 8
  op = ulong 2
  if eq ast_read nodes add base 2 2 43
    op = 1
    if and not alu_signed typ ne input 0
      ret 5
    end
  end
  value = new ulong 1 0
  if ne osc_alu_un op typ input value 0
    ret 6
  end
  mark_folded nodes base typ get value 0
  ret 0
end

fn fold_binary nodes edit uchar * base ulong typ ulong report edit ulong 3 to ulong
  left = ast_read nodes add mul ast_read nodes add base 12 4 ast_stride node_value 8
  right_id = ast_read nodes add base 16 4
  right = ast_read nodes add mul right_id ast_stride node_value 8
  tok = ast_read nodes add base 2 2
  value = new ulong 1 0
  status = osc_alu_bin osc_binary_opcode tok typ left right value
  if eq status 0
    mark_folded nodes base typ get value 0
    ret 0
  end
  if or eq status DIV_ZERO eq status BAD_SHIFT
    put report 1 right_id
    put report 2 right
    if eq status DIV_ZERO
      ret 7
    end
    ret 8
  end
  if eq status OVERFLOW
    if eq tok TOK_SHL
      ret 9
    end
    ret 10
  end
  ret 11
end

fn fold_enter nodes edit uchar * base ulong typ ulong report edit ulong 3 to ulong
  kind = ast_read nodes base 2
  if eq kind node_int
    ret fold_leaf nodes base typ report
  end
  if not or eq kind node_un eq kind node_bin
    ret 12
  end
  if and eq kind node_un eq ast_read nodes add base 2 2 43
    child = ast_read nodes add base 12 4
    if eq ast_read nodes mul child ast_stride 2 node_int
      ret fold_neg_literal nodes base typ report
    end
  end
  ret 13
end

export fn osc_fold_tree nodes edit uchar * typ ulong stack edit ulong * report edit ulong 3 to ulong
  id = get report 1
  if eq typ T_BOOL
    ret 1
  end
  depth = ulong 1
  put stack 0 mul id 4
  while ne depth 0 bound 65537
    top = sub depth 1
    base = mul shr get stack top 2 ast_stride
    put report 1 shr get stack top 2
    phase = and get stack top 3
    status = ulong 0
    if eq phase 0
      status = fold_enter nodes base typ report
      if eq status 13
        put stack top add get stack top 1
        put stack depth mul ast_read nodes add base 12 4 4
        depth = add depth 1
        continue
      end
    else
      if eq ast_read nodes base 2 node_un
        status = fold_unary nodes base typ
      else
        if eq phase 1
          put stack top add get stack top 1
          put stack depth mul ast_read nodes add base 16 4 4
          depth = add depth 1
          continue
        end
        status = fold_binary nodes base typ report
      end
    end
    if ne status 0
      ret status
    end
    depth = top
  end
  put report 0 ast_read nodes add mul id ast_stride node_value 8
  ret 0
end

fn infer_integer t ulong to bool
  ret and ge t T_U8 le t T_I64
end

fn infer_begin nodes view uchar * stack edit ulong * frame edit infer to ulong
  base = mul get frame root ast_stride
  op = ast_read nodes add base 2 2
  kind = ast_read nodes base 2
  a = ast_read nodes add base 12 4
  b = ast_read nodes add base 16 4
  put frame first a
  put frame second b
  put frame context 0
  if or eq op 51 or eq op 52 eq op 53
    put frame context T_BOOL
  else
    left_literal = osc_constant_tree nodes a 0 stack
    if eq kind node_cast
      if ne left_literal 0
        put frame site a
        ret 2
      end
    else
      if eq kind node_un
        if ne left_literal 0
          put frame context get frame want
        end
      else
        right_literal = osc_constant_tree nodes b 0 stack
        if or eq op TOK_SHL eq op TOK_SHR
          if ne left_literal 0
            put frame context get frame want
          end
        else
          if ne left_literal 0
            if ne right_literal 0
              if ne osc_compare_opcode op 0
                put frame site get frame root
                ret 3
              end
              put frame context get frame want
            else
              put frame first b
              put frame second a
              right_literal = 1
            end
          end
        end
        put frame literal2 right_literal
      end
    end
  end
  put frame site get frame first
  put frame phase 1
  ret 1
end

fn infer_after_first nodes view uchar * frame edit infer t ulong to ulong
  base = mul get frame root ast_stride
  kind = ast_read nodes base 2
  op = ast_read nodes add base 2 2
  put frame optype t
  put frame site get frame root
  if eq kind node_un
    if and ne op 51 not infer_integer t
      ret 6
    end
    put frame context t
    ret 0
  end
  if eq kind node_cast
    target = ast_read nodes add base node_type 4
    if not and infer_integer t infer_integer target
      ret 7
    end
    put frame context target
    ret 0
  end
  context = t
  if or eq op TOK_SHL eq op TOK_SHR
    if not infer_integer t
      ret 8
    end
    if eq get frame literal2 0
      context = 0
    end
  else
    if ne osc_compare_opcode op 0
      if and eq t T_BOOL ne get frame literal2 0
        put frame site get frame second
        ret 4
      end
    else
      if and eq t T_BOOL not or eq op 52 eq op 53
        put frame site get frame first
        ret 5
      end
    end
  end
  put frame site get frame second
  put frame context context
  put frame phase 2
  ret 1
end

fn infer_after_second nodes edit uchar * frame edit infer second_type ulong to ulong
  base = mul get frame root ast_stride
  op = ast_read nodes add base 2 2
  t = get frame optype
  put frame context t
  if or eq op 52 eq op 53
    ret 0
  end
  if ne osc_compare_opcode op 0
    put nodes add base node_flag uchar t
    put frame context T_BOOL
    ret 0
  end
  right = ast_read nodes add base 16 4
  rb = mul right ast_stride
  if or eq op TOK_SHL eq op TOK_SHR
    if not infer_integer second_type
      put frame optype second_type
      ret 9
    end
    if and ne get nodes add rb node_known 0 ge ast_read nodes add rb node_value 8 osc_alu_width t
      ret 10
    end
  else
    if not infer_integer t
      put frame site get frame root
      ret 11
    end
    if or eq op 45 eq op 46
      if and ne get nodes add rb node_known 0 eq ast_read nodes add rb node_value 8 0
        put frame site right
        ret 12
      end
    end
  end
  ret 0
end

export fn osc_infer_step nodes edit uchar * stack edit ulong * frame edit infer checked ulong to ulong
  phase = get frame phase
  if eq phase 0
    ret infer_begin nodes stack frame
  end
  if eq phase 1
    ret infer_after_first nodes frame checked
  end
  ret infer_after_second nodes frame checked
end

fn arg_action nodes view uchar * param ulong arg ulong to uint
  typ = ast_read nodes add param 56 4
  kind = ast_read nodes arg 2
  if or eq typ type_bytes eq typ type_cells
    if eq kind node_borrow
      ret bad_slice_borrow
    end
    ret arg_slice
  end
  if ne typ type_ref
    if eq kind node_borrow
      ret bad_scalar_borrow
    end
    ret arg_scalar
  end
  refkind = ast_read nodes add param 60 4
  if eq refkind ref_own
    if ne kind node_name
      ret bad_owner_form
    end
    ret arg_owner
  end
  mutable = ne get nodes add arg 72 0
  expected_mutable = eq refkind ref_mut
  if or ne kind node_borrow ne mutable expected_mutable
    ret bad_borrow_form
  end
  ret arg_borrow
end

fn call_next nodes view uchar * id long to long
  raw = ast_read nodes add mul ulong id ast_stride 24 4
  if eq raw 4294967295
    ret -1
  end
  ret long raw
end

export fn osc_call_args nodes view uchar * param long arg long call edit callargs to void
  np = ulong 0
  while and ge param 0 lt np 6 bound 6
    put call params np int param
    param = call_next nodes param
    np = add np 1
  end
  na = ulong 0
  while and ge arg 0 lt na 7 bound 7
    put call args na int arg
    arg = call_next nodes arg
    na = add na 1
  end
  put call np uint np
  put call na uint na
  if eq np na
    for k ulong na
      p = mul ulong get call params k ast_stride
      a = mul ulong get call args k ast_stride
      put call actions k arg_action nodes p a
      put call cells k int -1
    end
  end
end

export fn osc_bind_cell_argument call edit callargs index ulong symbol long to ulong
requires lt index 6
  for k ulong index
    if eq long get call cells k symbol
      ret 0
    end
  end
  put call cells index int symbol
  ret 1
end

note Only scalar parameters bind constants. Unknown actual arguments keep
note their slots unknown, including names in the caller's scope.
export fn osc_call_requires nodes view uchar * call view callargs bindings edit contract stack edit ulong * to ulong
requires le get call na 6
  request = new ulong 2 0
  count = ulong get call na
  note nk stays zero while actuals are evaluated in the caller.
  for i ulong count
    if eq get call actions i arg_scalar
      put request 0 ulong get call args i
      if ne osc_contract_value nodes bindings stack request 0
        put bindings k i uchar 1
        put bindings v i get request 1
      end
    end
  end
  put bindings nk int count
  put request 0 ulong get call clause
  if eq osc_contract_value nodes bindings stack request 0
    ret 1
  end
  ret alu_truth ne get request 1 0
end

note Native and interpreted calls use the same byte range rule. A pair of
note read-only byte slices may overlap. A nonempty cell slice is exclusive.
fn slice_width types view uint * p ulong to ulong
  base = mul p 4
  if ne get types add base 1 0
    ret 0
  end
  if ne get types add base 2 0
    ret 0
  end
  note Length and struct id occupy the low 24 bits of the last word.
  if ne and get types add base 3 0x00ffffff 0
    ret 0
  end
  typ = get types base
  if eq ulong typ type_bytes
    ret 1
  end
  if eq ulong typ type_cells
    ret 8
  end
  ret 0
end

fn slice_limit base ulong count ulong width ulong to ulong
  maxaddr = ulong 0xffffffffffffffff
  if eq base 0
    ret 0
  end
  if eq width 8
    if or ne and base 7 0 gt count shr maxaddr 3
      ret 0
    end
  end
  size = mul count width
  if gt size sub maxaddr base
    ret 0
  end
  ret add base size
end

fn slices_overlap args view ulong * p ulong q ulong limit ulong width ulong to bool
  count = get args add q 1
  if eq count 0
    ret false
  end
  begin = get args q
  note This earlier range passed the arithmetic checks.
  ret and lt begin limit lt get args p add begin mul count width
end

fn check_aliases types view uint * args view ulong * p ulong limit ulong to bool
  for q ulong p
    width = slice_width types q
    if ne width 0
      if or eq width 8 eq ulong get types mul p 4 type_cells
        if slices_overlap args p q limit width
          ret false
        end
      end
    end
  end
  ret true
end

export fn osc_slice_args types view uint * args view ulong * to long
requires eq len types mul len args 4
  if lt len args 2
    ret 0
  end
  for p ulong sub len args 1
    width = slice_width types p
    if eq width 0
      continue
    end
    count = get args add p 1
    if ne count 0
      limit = slice_limit get args p count width
      if eq limit 0
        ret -1
      end
      if not check_aliases types args p limit
        ret -1
      end
    end
  end
  ret 0
end

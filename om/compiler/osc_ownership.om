note SPDX-License-Identifier: Apache-2.0
note OSC semantic decisions. The checker supplies the live counts for the owner
note or, for a reborrow, the live child counts for its parent borrow.
note bridge c-define OSC_OWN_ALLOWED 0
note bridge c-define OSC_OWN_MOVED 1
note bridge c-define OSC_OWN_ALIAS 2
note bridge c-define OSC_OWN_READ_ONLY 3
note bridge c-define OSC_OWN_LOOP_MOVE 4
note bridge c-type oscowner OscCheckedOwner
om2

note The checker snapshots this record at each branch. sym is the owning
note symbol or -1, and arena1 is the arena symbol plus one or zero.
layout oscowner 20
field moved uchar at 0 little
field n_shared ushort at 2 little
field n_mut ushort at 4 little
field moveline uint at 8 little
field sym int at 12 little
field arena1 int at 16 little
end

const owner_live uchar 0
const owner_moved uchar 1
const owner_maybe uchar 3

const allowed ulong 0
const moved_owner ulong 1
const mutable_alias ulong 2
const read_only ulong 3
const loop_move ulong 4

fn check_alias exclusive ulong shared_count ulong mut_count ulong to ulong
  if or ne mut_count 0 and ne exclusive 0 ne shared_count 0
    ret mutable_alias
  end
  ret allowed
end

export fn osc_owner_access moved ulong exclusive ulong shared_count ulong mut_count ulong to ulong
  if ne moved 0
    ret moved_owner
  end
  ret check_alias exclusive shared_count mut_count
end

export fn osc_borrow_access writable ulong exclusive ulong shared_count ulong mut_count ulong to ulong
  if and ne exclusive 0 eq writable 0
    ret read_only
  end
  ret check_alias exclusive shared_count mut_count
end

export fn osc_owner_move moved ulong shared_count ulong mut_count ulong declaration_depth long loop_depth long to ulong
  decision = osc_owner_access moved 1 shared_count mut_count
  if ne decision allowed
    ret decision
  end
  if lt declaration_depth loop_depth
    ret loop_move
  end
  ret allowed
end

note Join two paths that reach the same point. Keep the diagnostic line from
note the already maybe-moved path when the other path definitely moved.
note Return one when the declaration needs a conditional release.
export fn osc_join_owner taken view oscowner remaining edit oscowner to ulong
  first = get taken moved
  second = get remaining moved
  if eq first second
    ret 0
  end
  if or eq second owner_live and eq second owner_moved eq first owner_maybe
    put remaining moveline get taken moveline
  end
  put remaining moved owner_maybe
  ret 1
end

note Handle provenance is definite only while every surviving path retains
note its original allocation. For a single surviving path pass before as other.
export fn osc_join_handle before long current long other long to long
  if or ne current before ne other before
    ret -1
  end
  ret before
end

note A provenance is definitely freed only when it was freed on both paths.
export fn osc_join_frees taken view uchar * remaining edit uchar * to void
requires eq len taken len remaining
  for i ulong len remaining
    if and ne get taken i 0 ne get remaining i 0
      put remaining i 1
    else
      put remaining i 0
    end
  end
end

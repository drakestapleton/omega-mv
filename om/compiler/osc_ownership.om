note SPDX-License-Identifier: Apache-2.0
note OSC semantic decisions. The checker supplies the live counts for the owner
note or, for a reborrow, the live child counts for its parent borrow.
note bridge c-define OSC_OWN_ALLOWED 0
note bridge c-define OSC_OWN_MOVED 1
note bridge c-define OSC_OWN_ALIAS 2
note bridge c-define OSC_OWN_READ_ONLY 3
note bridge c-define OSC_OWN_LOOP_MOVE 4
note bridge c-type oscowner OscCheckedOwner
note bridge c-type oscbor OscCheckedBorrow
om2

note The checker snapshots this record at each branch. sym is the owning
note symbol or -1, and arena1 is the arena symbol plus one or zero.
layout oscowner 20
field moved uchar at 0 little
field n_shared ushort at 2 little
field n_mut ushort at 4 little
field moveline uint at 8 little
field sym int at 12 little
field arena1 int at 16 little
end

note parent is -1 for a direct borrow. Nested borrows count against
note the parent borrow, direct borrows count against the owner.
layout oscbor 24
field live uchar at 0 little
field mut uchar at 1 little
field obj int at 4 little
field parent int at 8 little
field n_shared ushort at 12 little
field n_mut ushort at 14 little
field line uint at 16 little
field sym int at 20 little
end

const owner_live uchar 0
const owner_moved uchar 1
const owner_maybe uchar 3

const allowed ulong 0
const moved_owner ulong 1
const mutable_alias ulong 2
const read_only ulong 3
const loop_move ulong 4

fn check_alias exclusive ulong shared_count ulong mut_count ulong to ulong
  if or ne mut_count 0 and ne exclusive 0 ne shared_count 0
    ret mutable_alias
  end
  ret allowed
end

export fn osc_owner_access moved ulong exclusive ulong shared_count ulong mut_count ulong to ulong
  if ne moved 0
    ret moved_owner
  end
  ret check_alias exclusive shared_count mut_count
end

export fn osc_borrow_access writable ulong exclusive ulong shared_count ulong mut_count ulong to ulong
  if and ne exclusive 0 eq writable 0
    ret read_only
  end
  ret check_alias exclusive shared_count mut_count
end

export fn osc_owner_move moved ulong shared_count ulong mut_count ulong declaration_depth long loop_depth long to ulong
  decision = osc_owner_access moved 1 shared_count mut_count
  if ne decision allowed
    ret decision
  end
  if lt declaration_depth loop_depth
    ret loop_move
  end
  ret allowed
end

note Join two paths that reach the same point. Keep the diagnostic line from
note the already maybe-moved path when the other path definitely moved.
note Return one when the declaration needs a conditional release.
fn keep_taken_line first uchar second uchar to bool
  ret or eq second owner_live and eq second owner_moved eq first owner_maybe
end

export fn osc_join_owner taken view oscowner remaining edit oscowner to ulong
  first = get taken moved
  second = get remaining moved
  if eq first second
    ret 0
  end
  if keep_taken_line first second
    put remaining moveline get taken moveline
  end
  put remaining moved owner_maybe
  ret 1
end

note Handle provenance is definite only while every surviving path retains
note its original allocation. For a single surviving path pass before as other.
export fn osc_join_handle before long current long other long to long
  if or ne current before ne other before
    ret -1
  end
  ret before
end

note A provenance is definitely freed only when it was freed on both paths.
export fn osc_join_frees taken view uchar * remaining edit uchar * to void
requires eq len taken len remaining
  for i ulong len remaining
    if and ne get taken i 0 ne get remaining i 0
      put remaining i 1
    else
      put remaining i 0
    end
  end
end

export fn osc_init_owner item edit oscowner symbol long to void
  put item moved owner_live
  put item n_shared 0
  put item n_mut 0
  put item moveline 0
  put item sym int symbol
  put item arena1 0
end

fn init_borrow child edit oscbor object long parent_id long mutable ulong source_line ulong to void
  put child live 1
  put child mut uchar mutable
  put child obj int object
  put child parent int parent_id
  put child n_shared 0
  put child n_mut 0
  put child line uint source_line
  put child sym -1
end

export fn osc_open_borrow owner edit oscowner child edit oscbor object long mutable ulong source_line ulong to void
  init_borrow child object -1 mutable source_line
  if ne mutable 0
    put owner n_mut add get owner n_mut 1
  else
    put owner n_shared add get owner n_shared 1
  end
end

export fn osc_open_reborrow parent edit oscbor child edit oscbor object long parent_id long mutable ulong source_line ulong to void
  init_borrow child object parent_id mutable source_line
  if ne mutable 0
    put parent n_mut add get parent n_mut 1
  else
    put parent n_shared add get parent n_shared 1
  end
end

export fn osc_close_borrow owner edit oscowner child edit oscbor to void
  put child live 0
  if ne get child mut 0
    put owner n_mut sub get owner n_mut 1
  else
    put owner n_shared sub get owner n_shared 1
  end
end

export fn osc_close_reborrow parent edit oscbor child edit oscbor to void
  put child live 0
  if ne get child mut 0
    put parent n_mut sub get parent n_mut 1
  else
    put parent n_shared sub get parent n_shared 1
  end
end

note Join all pre-branch records in one call. Only declarations requiring a
note conditional release are returned to the AST consumer.
export fn osc_join_owners taken view uchar * remaining edit uchar * changes edit int * to ulong
requires eq len taken mul len changes 20
requires eq len remaining len taken
  count = ulong 0
  for i ulong len changes
    offset = mul i 20
    first = get taken offset
    second = get remaining offset
    if ne first second
      if keep_taken_line first second
        for j ulong 4
          atline = add add offset 8 j
          put remaining atline get taken atline
        end
      end
      put remaining offset owner_maybe
      put changes count int i
      count = add count 1
    end
  end
  ret count
end

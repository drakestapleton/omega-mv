note SPDX-License-Identifier: Apache-2.0
note End a range of lexical scopes, newest binding first. Emit one action for
note each destruction that the trace or lowering release list needs. A live
note borrow at arena exit stops the walk after all preceding actions.
note bridge c-define OSC_SCOPE_END_BORROW 1
note bridge c-define OSC_SCOPE_RELEASE_OWNER 2
note bridge c-define OSC_SCOPE_DESTROY_ARENA 3
note bridge c-define OSC_SCOPE_CLOSE_POOL 4
note bridge c-define OSC_SCOPE_REFUSE_ESCAPE 5
note bridge c-type exitwork OscScopeExit
om2

layout exitwork 1936
field first uint at 0 little
field count uint at 4 little
field objects uint at 8 little
field borrows uint at 12 little
field actions uint 480 at 16 little
end

fn load32 data view uchar * pos ulong to ulong
  value = ulong 0
  for j ulong 4
    value = or value shl ulong get data add pos j mul j 8
  end
  ret value
end

fn dec16 data edit uchar * pos ulong to void
  high = shl ulong get data add pos 1 8
  value = sub or high ulong get data pos 1
  put data pos uchar and value 255
  put data add pos 1 uchar and shr value 8 255
end

fn end_borrow owners edit uchar * borrows edit uchar * id ulong to ulong
  if eq id 4294967295
    ret 0
  end
  child = mul id 24
  if eq get borrows child 0
    ret 0
  end
  put borrows child 0
  count_offset = ulong 0
  if ne get borrows add child 1 0
    count_offset = 2
  end
  parent = load32 borrows add child 8
  if eq parent 4294967295
    object = mul load32 borrows add child 4 20
    dec16 owners add add object 2 count_offset
  else
    dec16 borrows add add mul parent 24 12 count_offset
  end
  ret 1
end

fn end_owner owners edit uchar * id ulong to ulong
  pos = mul id 20
  if ne load32 owners add pos 16 0
    ret 0
  end
  moved = get owners pos
  if and ne moved 0 ne moved 3
    ret 0
  end
  put owners pos 2
  ret 2
end

fn end_arena owners edit uchar 5120 borrows view uchar 12288 symbol ulong work view exitwork to ulong
  region = add symbol 1
  for b ulong ulong get work borrows
    pos = mul b 24
    if ne get borrows pos 0
      object = mul load32 borrows add pos 4 20
      if eq load32 owners add object 16 region
        ret 5
      end
    end
  end
  for o ulong ulong get work objects
    pos = mul o 20
    if and eq get owners pos 0 eq load32 owners add pos 16 region
      put owners pos 2
    end
  end
  ret 3
end

fn end_symbol symbols view uchar 76800 owners edit uchar 5120 borrows edit uchar 12288 id ulong work view exitwork to ulong
  base = mul id 160
  kind = get symbols add base 68
  if eq kind 3
    ret end_borrow owners borrows load32 symbols add base 96
  end
  if eq kind 2
    ret end_owner owners load32 symbols add base 92
  end
  if eq kind 4
    ret end_arena owners borrows id work
  end
  if eq kind 5
    ret 4
  end
  ret 0
end

export fn osc_scope_exit visible view ushort 480 symbols view uchar 76800 owners edit uchar 5120 borrows edit uchar 12288 work edit exitwork to ulong
requires le get work count 480
requires le get work first get work count
requires le get work objects 256
requires le get work borrows 512
  count = ulong 0
  pos = ulong get work count
  while gt pos ulong get work first bound 480
    pos = sub pos 1
    id = ulong get visible pos
    action = end_symbol symbols owners borrows id work
    if ne action 0
      put work actions count uint or shl action 16 id
      count = add count 1
      if eq action 5
        break
      end
    end
  end
  ret count
end

note Only an allocation at the declaration's loop and branch depth is
note guaranteed to consume cells. Refusals leave the arena counter intact.
export fn osc_reserve_arena symbol edit uchar 160 loop_depth ulong branch_depth ulong cells ulong to ulong
  if or ne load32 symbol 88 loop_depth ne load32 symbol 108 branch_depth
    ret 1
  end
  cap = or ulong get symbol 104 shl ulong get symbol 105 8
  used = or ulong get symbol 106 shl ulong get symbol 107 8
  if gt used cap
    ret 0
  end
  if gt cells sub cap used
    ret 0
  end
  total = add used cells
  put symbol 106 uchar and total 255
  put symbol 107 uchar shr total 8
  ret 1
end

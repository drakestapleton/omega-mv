note SPDX-License-Identifier: Apache-2.0
note Visible OSC names are indexed by spelling. Declaration IDs live for the
note whole function; leaving a block unlinks its entries in reverse order.
note The zero bucket sentinel is distinct from symbol zero.
note bridge c-type scopetab OscCheckedScope
om2

layout scopetab 3672
field head ushort 256 at 0 little
field prior ushort 480 at 512 little
field bucket ushort 480 at 1472 little
field visible ushort 480 at 2432 little
field start ushort 136 at 3392 little
field count uint at 3664 little
field depth uint at 3668 little
end

fn name_bucket name view uchar * to ulong
  hash = ulong 5381
  for i ulong len name
    hash = xor mul hash 33 ulong get name i
  end
  ret and hash 255
end

export fn osc_scope_reset table edit scopetab to void
  for i ulong 256
    put table head i 0
  end
  put table count 0
  put table depth 0
end

export fn osc_scope_find table view scopetab words view uchar 30720 name view uchar * to long
  entry = ulong get table head name_bucket name
  while ne entry 0 bound 480
    id = sub entry 1
    base = mul id 64
    if eq ulong get words base len name
      equal = true
      for i ulong len name
        if ne get words add add base 1 i get name i
          equal = false
          break
        end
      end
      if equal
        ret long id
      end
    end
    entry = ulong get table prior id
  end
  ret -1
end

export fn osc_scope_bind table edit scopetab words edit uchar 30720 id ulong name view uchar * to void
requires lt id 480
requires le len name 63
  slot = name_bucket name
  put table prior id get table head slot
  put table bucket id ushort slot
  put table head slot ushort add id 1
  base = mul id 64
  put words base uchar len name
  for i ulong len name
    put words add add base 1 i get name i
  end
  n = ulong get table count
  put table visible n ushort id
  put table count uint add n 1
end

export fn osc_scope_push table edit scopetab to ulong
  d = ulong get table depth
  if eq d 136
    ret 0
  end
  put table start d ushort get table count
  put table depth uint add d 1
  ret 1
end

export fn osc_scope_pop table edit scopetab to void
  d = sub ulong get table depth 1
  first = ulong get table start d
  n = ulong get table count
  while gt n first bound 480
    n = sub n 1
    id = ulong get table visible n
    put table head ulong get table bucket id get table prior id
  end
  put table depth uint d
  put table count uint first
end

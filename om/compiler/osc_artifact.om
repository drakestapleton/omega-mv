note SPDX-License-Identifier: Apache-2.0
note oscc artifact entry, in the text format consumed by the unit packager.
note bridge c-type entry OscArtifactEntry
om2
layout entry 40
field index uint at 0 little
field count uint at 4 little
field result uint at 8 little
field kind uint 6 at 12 little
field offset uint at 36 little
end

fn decimal value uint dst edit uchar * pos ulong to ulong
  digits = new uchar 10 0
  n = ulong 0
  while true
    put digits n uchar add rem value 10 48
    n = add n 1
    value = div value 10
    if eq value 0
      break
    end
  end
  if gt add pos n len dst
    ret len dst
  end
  for i ulong n
    put dst add pos i get digits sub sub n 1 i
  end
  ret add pos n
end

note Negative results -1 through -6 name a refused parameter register.
note -7 means insufficient space or an arity outside the artifact format.
export fn osc_artifact_entry row view entry name view uchar * dst edit uchar * to long
  count = ulong get row count
  if gt count 6
    ret -7
  end
  for i ulong count
    kind = get row kind i
    if or eq kind 0 or eq kind 10 gt kind 12
      ret sub long -1 long i
    end
  end
  pos = decimal get row index dst 0
  for i ulong 9
    if ge pos len dst
      ret -7
    end
    put dst pos 32
    value = uint 0
    if eq i 0
      value = uint count
    end
    if eq i 1
      value = get row result
    end
    if and ge i 2 lt i add count 2
      value = get row kind sub i 2
    end
    if eq i 8
      value = get row offset
    end
    pos = decimal value dst add pos 1
  end
  if gt add add pos len name 2 len dst
    ret -7
  end
  put dst pos 32
  pos = add pos 1
  for i ulong len name
    put dst add pos i get name i
  end
  pos = add pos len name
  put dst pos 10
  ret long add pos 1
end

fn digit_hex nibble uchar to uchar
  if lt nibble 10
    ret add nibble 48
  end
  ret add nibble 87
end

export fn osc_artifact_hex digest view uchar 32 dst edit uchar 65 to void
  for i ulong 32
    value = get digest i
    put dst mul i 2 digit_hex shr value 4
    put dst add mul i 2 1 digit_hex and value 15
  end
  put dst 64 0
end

note SPDX-License-Identifier: Apache-2.0
note Encode/decode the variable fields of OSC's supported 64-bit AArch64 forms.
note The opcode table supplies base bits and the class. Register kind, canonical
note operands and range checks precede packing. Negative offsets use low field bits.
note bridge c-type a64field OscA64Fields
note bridge c-define OSC_A64_ERR_UNUSED_SHIFT 1
note bridge c-define OSC_A64_ERR_UNUSED_COND 2
note bridge c-define OSC_A64_ERR_UNUSED_IMM2 3
note bridge c-define OSC_A64_ERR_UNUSED_IMM 4
note bridge c-define OSC_A64_ERR_SHIFT_KIND 5
note bridge c-define OSC_A64_ERR_SHIFT_AMOUNT 6
note bridge c-define OSC_A64_ERR_IMM12 7
note bridge c-define OSC_A64_ERR_LSL12 8
note bridge c-define OSC_A64_ERR_IMMR 9
note bridge c-define OSC_A64_ERR_IMMS 10
note bridge c-define OSC_A64_ERR_COND 11
note bridge c-define OSC_A64_ERR_IMM16 12
note bridge c-define OSC_A64_ERR_MOV_SHIFT 13
note bridge c-define OSC_A64_ERR_MEM_OFFSET 14
note bridge c-define OSC_A64_ERR_PAIR_OFFSET 15
note bridge c-define OSC_A64_ERR_WRITEBACK_ALIAS 16
note bridge c-define OSC_A64_ERR_LOAD_ALIAS 17
note bridge c-define OSC_A64_ERR_BRANCH_OFFSET 18
note bridge c-define OSC_A64_ERR_BRANCH_COND 19
note bridge c-define OSC_A64_ERR_UNUSED_REG 32
note bridge c-define OSC_A64_ERR_REG_SP 36
note bridge c-define OSC_A64_ERR_REG_ZR 40
note bridge c-define OSC_A64_ERR_BAD_REG 44
om2
layout a64spec 24
field base uint at 8 little
field form uchar at 12 little
field role uchar 4 at 13 little
field flags uchar at 17 little
end
layout a64insn 24
field opcode uchar at 0 little
field reg uchar 4 at 1 little
field shift uchar at 5 little
field cond uchar at 6 little
field imm long at 8 little
field imm2 long at 16 little
end
layout a64field 40
field rd uint at 0 little
field rn uint at 4 little
field rm uint at 8 little
field ra uint at 12 little
field shift uint at 16 little
field cond uint at 20 little
field imm long at 24 little
field imm2 long at 32 little
end

const CLS_NONE ulong 0
const CLS_RRR_SH ulong 1
const CLS_RI ulong 2
const CLS_R4 ulong 3
const CLS_MULH ulong 4
const CLS_R3 ulong 5
const CLS_BFM ulong 6
const CLS_CSINC ulong 7
const CLS_MOV16 ulong 8
const CLS_MEM ulong 9
const CLS_PAIR ulong 10
const CLS_B26 ulong 11
const CLS_BCOND ulong 12
const CLS_CB ulong 13
const CLS_BREG ulong 14
const CLS_BRK ulong 15

export fn osc_a64_pack_fields form ulong base ulong f view a64field to ulong
rd = ulong get f rd
rn = shl ulong get f rn 5
rm = shl ulong get f rm 16
ra = shl ulong get f ra 10
imm = bitcast ulong get f imm
second = bitcast ulong get f imm2
if eq form CLS_RRR_SH
  regs = or rd or rn rm
  returnbits = or shl ulong get f shift 22 shl imm 10
  ret or base or regs returnbits
end
if eq form CLS_RI
  ret or base or or rd rn or shl second 22 shl imm 10
end
if eq form CLS_R4
  ret or base or or rd rn or rm ra
end
if or eq form CLS_MULH eq form CLS_R3
  ret or base or rd or rn rm
end
if eq form CLS_BFM
  ret or base or or rd rn or shl imm 16 shl second 10
end
if eq form CLS_CSINC
  regs = or rd or rn rm
  ret or base or regs shl ulong get f cond 12
end
if eq form CLS_MOV16
  ret or base or rd or shl shr second 4 21 shl imm 5
end
if eq form CLS_MEM
  ret or base or or rd rn shl shr imm 3 10
end
if eq form CLS_PAIR
  offset = shl and shr imm 3 0x7f 15
  ret or base or or rd rn or ra offset
end
if eq form CLS_B26
  ret or base and shr imm 2 0x03ffffff
end
if or eq form CLS_BCOND eq form CLS_CB
  offset = shl and shr imm 2 0x7ffff 5
  if eq form CLS_BCOND
    ret or base or offset ulong get f cond
  end
  ret or base or offset rd
end
if eq form CLS_BREG
  ret or base rn
end
if eq form CLS_BRK
  ret or base shl imm 5
end
trap 5
end

fn a64_scaled_signed fieldbits ulong signbit ulong scale ulong to long
ret bitcast long shl sub xor fieldbits signbit signbit scale
end

export fn osc_a64_unpack_fields form ulong word ulong f edit a64field to void
put f rd uint and word 31
put f rn uint and shr word 5 31
put f rm uint and shr word 16 31
put f ra uint and shr word 10 31
put f shift 0
put f cond 0
put f imm 0
put f imm2 0
if eq form CLS_RRR_SH
  put f shift uint and shr word 22 3
  put f imm long and shr word 10 63
end
if eq form CLS_RI
  put f imm long and shr word 10 0xfff
  put f imm2 long and shr word 22 1
end
if eq form CLS_BFM
  put f imm long and shr word 16 63
  put f imm2 long and shr word 10 63
end
if eq form CLS_CSINC
  put f cond uint and shr word 12 15
end
if eq form CLS_MOV16
  put f imm long and shr word 5 0xffff
  put f imm2 long shl and shr word 21 3 4
end
if eq form CLS_MEM
  put f imm long shl and shr word 10 0xfff 3
end
if eq form CLS_PAIR
  put f imm a64_scaled_signed and shr word 15 0x7f 0x40 3
end
if eq form CLS_B26
  put f imm a64_scaled_signed and word 0x03ffffff 0x02000000 2
end
if or eq form CLS_BCOND eq form CLS_CB
  put f imm a64_scaled_signed and shr word 5 0x7ffff 0x40000 2
  if eq form CLS_BCOND
    put f cond uint and word 15
  end
end
if eq form CLS_BRK
  put f imm long and shr word 5 0xffff
end
end
const ERR_UNUSED_SHIFT ulong 1
const ERR_UNUSED_COND ulong 2
const ERR_UNUSED_IMM2 ulong 3
const ERR_UNUSED_IMM ulong 4
const ERR_SHIFT_KIND ulong 5
const ERR_SHIFT_AMOUNT ulong 6
const ERR_IMM12 ulong 7
const ERR_LSL12 ulong 8
const ERR_IMMR ulong 9
const ERR_IMMS ulong 10
const ERR_COND ulong 11
const ERR_IMM16 ulong 12
const ERR_MOV_SHIFT ulong 13
const ERR_MEM_OFFSET ulong 14
const ERR_PAIR_OFFSET ulong 15
const ERR_WRITEBACK_ALIAS ulong 16
const ERR_LOAD_ALIAS ulong 17
const ERR_BRANCH_OFFSET ulong 18
const ERR_BRANCH_COND ulong 19

note Pair flags come from the opcode table. Encoded base register 31 is SP
note for the pair class, so it cannot alias a transfer even when that is XZR.
export fn osc_a64_check_fields cls ulong f view a64field writeback ulong loadpair ulong to ulong
imm = get f imm
second = get f imm2
if and ne cls CLS_RRR_SH ne get f shift 0
  ret ERR_UNUSED_SHIFT
end
if and ne get f cond 0 and ne cls CLS_CSINC ne cls CLS_BCOND
  ret ERR_UNUSED_COND
end
if ne second 0
  if and ne cls CLS_RI and ne cls CLS_BFM ne cls CLS_MOV16
    ret ERR_UNUSED_IMM2
  end
end
if ne imm 0
  if or eq cls CLS_R4 or eq cls CLS_MULH eq cls CLS_R3
    ret ERR_UNUSED_IMM
  end
  if or eq cls CLS_CSINC eq cls CLS_BREG
    ret ERR_UNUSED_IMM
  end
end
if eq cls CLS_RRR_SH
  if gt get f shift 2
    ret ERR_SHIFT_KIND
  end
  if or lt imm 0 gt imm 63
    ret ERR_SHIFT_AMOUNT
  end
end
if eq cls CLS_RI
  if or lt imm 0 gt imm 4095
    ret ERR_IMM12
  end
  if and ne second 0 ne second 1
    ret ERR_LSL12
  end
end
if eq cls CLS_BFM
  if or lt imm 0 gt imm 63
    ret ERR_IMMR
  end
  if or lt second 0 gt second 63
    ret ERR_IMMS
  end
end
if and eq cls CLS_CSINC gt get f cond 14
  ret ERR_COND
end
if or eq cls CLS_MOV16 eq cls CLS_BRK
  if or lt imm 0 gt imm 65535
    ret ERR_IMM16
  end
  if eq cls CLS_MOV16
    if or lt second 0 or gt second 48 ne and second 15 0
      ret ERR_MOV_SHIFT
    end
  end
end
if eq cls CLS_MEM
  if or lt imm 0 or gt imm 32760 ne and imm 7 0
    ret ERR_MEM_OFFSET
  end
end
if eq cls CLS_PAIR
  if or lt imm -512 or gt imm 504 ne and imm 7 0
    ret ERR_PAIR_OFFSET
  end
  if and ne writeback 0 ne get f rn 31
    base = get f rn
    if or eq base get f rd eq base get f ra
      ret ERR_WRITEBACK_ALIAS
    end
  end
  if and ne loadpair 0 eq get f rd get f ra
    ret ERR_LOAD_ALIAS
  end
end
if eq cls CLS_B26
  if or lt imm -134217728 or gt imm 134217724 ne and imm 3 0
    ret ERR_BRANCH_OFFSET
  end
end
if or eq cls CLS_BCOND eq cls CLS_CB
  if and eq cls CLS_BCOND gt get f cond 13
    ret ERR_BRANCH_COND
  end
  if or lt imm -1048576 or gt imm 1048572 ne and imm 3 0
    ret ERR_BRANCH_OFFSET
  end
end
ret 0
end

note Checked encoder result: the low word is an instruction on success.
note The high word carries the existing diagnostic code on refusal.
export fn osc_a64_checked_word form ulong base ulong f view a64field flags ulong to ulong
  status = osc_a64_check_fields form f and flags 1 shr flags 1
  if ne status 0
    ret shl status 32
  end
  ret osc_a64_pack_fields form base f
end

note The opcode matcher has already checked the fixed bits. Unpack, check
note and re-encode each candidate inside the same Omega invocation, so a
note successful decode always proves the original word is canonical.
export fn osc_a64_canonical_word form ulong base ulong word ulong flags ulong fields edit a64field to ulong
  osc_a64_unpack_fields form word fields
  if and eq form CLS_BREG eq get fields rn 31
    ret 0
  end
  if ne osc_a64_checked_word form base fields flags word
    ret 0
  end
  ret 1
end

note Plan the move-wide instructions for a 64-bit constant in lane order.
note Each record holds the opcode in the high word, shift and immediate in
note the low word. A tied MOVZ/MOVN cost selects MOVZ for stable code bytes.
export fn osc_a64_materialize value ulong plan edit ulong 4 to ulong
  zeros = ulong 0
  ones = ulong 0
  for lane ulong 4
    chunk = and shr value mul lane 16 65535
    if eq chunk 0
      zeros = add zeros 1
    end
    if eq chunk 65535
      ones = add ones 1
    end
  end
  fill = ulong 0
  initial = ulong 25
  if gt ones zeros
    fill = 65535
    initial = 26
  end
  count = ulong 0
  for lane ulong 4
    shift = mul lane 16
    chunk = and shr value shift 65535
    if ne chunk fill
      opcode = ulong 27
      if eq count 0
        opcode = initial
        chunk = xor chunk fill
      end
      payload = or chunk shl shift 16
      put plan count or shl opcode 32 payload
      count = add count 1
    end
  end
  if eq count 0
    put plan 0 shl initial 32
    ret 1
  end
  ret count
end

note The descriptor table is indexed in public opcode order. Class masks
note select the variable bits excluded from the fixed opcode comparison.
fn a64_mask form ulong to ulong
  if eq form CLS_RRR_SH
    ret 0x00dfffff
  end
  if eq form CLS_RI
    ret 0x007fffff
  end
  if eq form CLS_R4
    ret 0x001f7fff
  end
  if eq form CLS_MULH
    ret 0x001f03ff
  end
  if eq form CLS_R3
    ret 0x001f03ff
  end
  if eq form CLS_BFM
    ret 0x003fffff
  end
  if eq form CLS_CSINC
    ret 0x001ff3ff
  end
  if eq form CLS_MOV16
    ret 0x007fffff
  end
  if eq form CLS_MEM
    ret 0x003fffff
  end
  if eq form CLS_PAIR
    ret 0x003fffff
  end
  if eq form CLS_B26
    ret 0x03ffffff
  end
  if eq form CLS_BCOND
    ret 0x00ffffef
  end
  if eq form CLS_CB
    ret 0x00ffffff
  end
  if eq form CLS_BREG
    ret 0x000003e0
  end
  if eq form CLS_BRK
    ret 0x001fffe0
  end
  ret 0
end

fn a64_encode_registers spec view a64spec insn view a64insn fields edit a64field to ulong
  regs = new uint 4 0
  for i ulong 4
    if and eq get spec role i 0 ne get insn reg i 0
      ret shl add 32 i 32
    end
  end
  for i ulong 4
    role = get spec role i
    regno = get insn reg i
    if le regno 30
      put regs i uint regno
    else
      if eq regno 33
        if ne role 2
          ret shl add 36 i 32
        end
      else
        if eq regno 32
          if ne role 1
            ret shl add 40 i 32
          end
        else
          ret shl add 44 i 32
        end
      end
      put regs i 31
    end
  end
  put fields rd get regs 0
  put fields rn get regs 1
  put fields rm get regs 2
  put fields ra get regs 3
  put fields shift uint get insn shift
  put fields cond uint get insn cond
  put fields imm get insn imm
  put fields imm2 get insn imm2
  ret osc_a64_checked_word ulong get spec form ulong get spec base fields ulong get spec flags
end

export fn osc_a64_write spec view uchar 24 insn view uchar 24 to ulong
  fields = new uchar 40 0
  ret a64_encode_registers spec insn fields
end

fn a64_decode_register role uchar bits uint to uchar
  if eq role 0
    ret 0
  end
  if lt bits 31
    ret uchar bits
  end
  if eq role 1
    ret 32
  end
  if eq role 2
    ret 33
  end
  ret 255
end

fn a64_try_opcode word ulong op ulong spec view a64spec insn edit a64insn fields edit a64field to ulong
  form = ulong get spec form
  base = ulong get spec base
  if eq osc_a64_canonical_word form base word ulong get spec flags fields 0
    ret 0
  end
  put insn opcode uchar op
  put insn reg 0 a64_decode_register get spec role 0 get fields rd
  put insn reg 1 a64_decode_register get spec role 1 get fields rn
  put insn reg 2 a64_decode_register get spec role 2 get fields rm
  put insn reg 3 a64_decode_register get spec role 3 get fields ra
  put insn shift uchar get fields shift
  put insn cond uchar get fields cond
  put insn imm get fields imm
  put insn imm2 get fields imm2
  ret 1
end

fn a64_matches specs view uchar * pos ulong word ulong to bool
  form = ulong get specs add pos 12
  base = ulong get specs add pos 8
  base = or base shl ulong get specs add pos 9 8
  base = or base shl ulong get specs add pos 10 16
  base = or base shl ulong get specs add pos 11 24
  ret and ne form 0 eq and word xor a64_mask form 0xffffffff base
end

fn a64_copy_spec specs view uchar * pos ulong spec edit uchar 24 to void
  for i ulong 10
    put spec add 8 i get specs add add pos 8 i
  end
end

export fn osc_a64_read word ulong specs view uchar * insn edit uchar 24 to ulong
  fields = new uchar 40 0
  spec = new uchar 24 0
  n = div len specs 24
  op = ulong 1
  while lt op n bound 255
    pos = mul op 24
    if a64_matches specs pos word
      a64_copy_spec specs pos spec
      if ne a64_try_opcode word op spec insn fields 0
        ret 1
      end
    end
    op = add op 1
  end
  ret 0
end

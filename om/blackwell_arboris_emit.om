note SPDX-License-Identifier: AGPL-3.0-only
note OM-2 instruction emitter composed after om/encoder/bw_enc_sm121.om.
note Sparse wave, 128 threads/CTA. Grid X covers destinations, grid Y queries.
note Driver descriptor at c[0][0x358]. Args at 0x380 are five aligned 64-bit
note bases (row offsets, source handles, weights, read bank, write bank), then
note the two FP32 words decay(hop), threshold. Each query bank is [raw, best].
note Positive finite input and locked CSR validation belong to the launcher.
note No completion receipt is encoded by this measurement candidate.
const wave_rz ulong 255

fn wave_cw op ulong to ulong
  note Conservative scoreboard: retire prior W0/R1 before each instruction.
  note Stall 15 cycles for fixed-latency producers. Variable producers set
  note W0; global accesses declare R1 for late address/data reads.
  wbar = ulong 7
  rbar = ulong 7
  if or eq op 3 or eq op 5 or eq op 4 eq op 7
    wbar = ulong 0
  end
  if eq op 11
    wbar = ulong 0
    rbar = ulong 1
  end
  if eq op 12
    rbar = ulong 1
  end
  ret or 0x301e00 or shl wbar 14 shl rbar 17
end

note Assembly state: instruction index, immediate, addend, guard (PT/P0/!P0), error.
fn wave_ins code edit uchar 16384 s edit ulong 5 op ulong dst ulong a ulong b ulong to void
  o = new ulong 16 0
  w = new ulong 4 0
  put o 0 op
  put o 1 dst
  put o 2 a
  put o 3 b
  put o 4 get s 2
  put o 5 4
  put o 6 get s 1
  put o 7 wave_cw op
  if ne get s 3 0
    put o 9 1
  end
  if eq get s 3 2
    put o 10 1
  end
  if ne a wave_rz
    put o 12 1
  end
  if ne b wave_rz
    put o 13 1
  end
  if ne dst wave_rz
    put o 15 1
  end
  if or ne enc1 o w 0 ge get s 0 1024
    put s 4 1
    ret
  end
  store code get s 0 w
  put s 0 add get s 0 1
  put s 1 0
  put s 2 wave_rz
  put s 3 0
end

fn wave_imm code edit uchar 16384 s edit ulong 5 op ulong dst ulong imm ulong to void
  put s 1 imm
  wave_ins code s op dst wave_rz wave_rz
end

fn wave_wide code edit uchar 16384 s edit ulong 5 dst ulong index ulong stride ulong base ulong to void
  put s 1 stride
  put s 2 base
  wave_ins code s 9 dst index wave_rz
end

fn wave_setup code edit uchar 16384 s edit ulong 5 n ulong compound bool to void
  wave_imm code s 3 0 0x21
  wave_imm code s 3 1 0x25
  wave_imm code s 3 2 0x26
  put s 1 128
  put s 2 0
  wave_ins code s 8 5 1 wave_rz
  wave_imm code s 2 6 n
  wave_ins code s 28 0 5 6
  put s 3 1
  wave_ins code s 45 wave_rz wave_rz wave_rz
  wave_imm code s 7 4 0x358
  for p ulong 5
    wave_imm code s 5 add 8 mul 2 p add 0x380 mul 8 p
  end
  wave_imm code s 4 26 0x3a8
  wave_imm code s 4 27 0x3ac
  pitch = mul n 8
  if compound
    pitch = mul n 4
  end
  wave_wide code s 14 2 pitch 14
  wave_wide code s 16 2 pitch 16
  wave_wide code s 18 5 4 8
  wave_ins code s 11 20 18 wave_rz
  put s 1 4
  wave_ins code s 11 21 18 wave_rz
  wave_imm code s 2 4 0
  wave_imm code s 2 3 1
end

fn wave_loop code edit uchar 16384 s edit ulong 5 compound bool to void
  join = get s 0
  wave_imm code s 54 0 2
  top = get s 0
  wave_ins code s 28 0 20 21
  branch = get s 0
  put s 3 1
  wave_imm code s 46 0 1
  wave_wide code s 18 20 4 10
  wave_ins code s 11 22 18 wave_rz
  wave_wide code s 18 20 4 12
  wave_ins code s 11 23 18 wave_rz
  wave_wide code s 18 22 4 14
  wave_ins code s 11 24 18 wave_rz
  if compound
    wave_ins code s 32 23 26 23
  end
  wave_ins code s 32 25 24 23
  wave_ins code s 37 4 4 25
  wave_ins code s 14 20 20 3
  wave_imm code s 46 0 and sub top get s 0 0xffffffff
  sync = get s 0
  wave_ins code s 55 0 wave_rz wave_rz
  done = get s 0
  put s 0 branch
  put s 3 1
  wave_imm code s 46 0 sub sync branch
  put s 0 join
  wave_imm code s 54 0 sub done join
  put s 0 done
end

fn wave_finish code edit uchar 16384 s edit ulong 5 to void
  wave_ins code s 32 28 4 26
  wave_ins code s 28 0 28 27
  put s 3 2
  wave_imm code s 2 4 0
  put s 3 2
  wave_imm code s 2 28 0
  wave_wide code s 18 5 4 16
  wave_ins code s 12 wave_rz 18 4
  wave_ins code s 14 7 5 6
  wave_wide code s 18 7 4 14
  wave_ins code s 11 29 18 wave_rz
  wave_ins code s 37 28 28 29
  wave_wide code s 18 7 4 16
  wave_ins code s 12 wave_rz 18 28
end

fn wave_exit code edit uchar 16384 s edit ulong 5 to void
  wave_ins code s 23 wave_rz wave_rz wave_rz
  wave_ins code s 45 wave_rz wave_rz wave_rz
  wave_imm code s 46 0 0
  while ne and get s 0 7 0 bound 7
    wave_ins code s 0 0 0 0
  end
end

fn wave_emit n ulong code edit uchar 16384 compound bool to ulong
  note The IMAD.WIDE immediate is a 32-bit byte pitch for the two planes.
  if or eq n 0 gt n 0x1fffffff
    ret 0
  end
  s = new ulong 5 0
  put s 2 wave_rz
  wave_setup code s n compound
  wave_loop code s compound
  if compound
    wave_wide code s 18 5 4 14
    wave_ins code s 11 29 18 wave_rz
    wave_ins code s 37 28 4 29
    wave_wide code s 18 5 4 16
    wave_ins code s 12 wave_rz 18 28
  else
    wave_finish code s
  end
  wave_exit code s
  if ne get s 4 0
    ret 0
  end
  ret mul get s 0 16
end

export fn arboris_emit_spread n ulong code edit uchar 16384 to ulong
  ret wave_emit n code false
end

note Compounding max-product recurrence. Each query has one FP32 plane per bank.
export fn arboris_emit_relax n ulong code edit uchar 16384 to ulong
  ret wave_emit n code true
end

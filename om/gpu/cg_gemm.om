off = add mul mm mul 128 get sp 1 mul get meta 507 512
if eq q 0
gm_lds128 ins meta get meta add 444 q get meta 406 off 1
else
gm_lds128 ins meta get meta add 444 q get meta 406 off 0
end
end
for i ulong 4
gm_comp_ffma ins meta i
end
end

fn gm_kstep_stage sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
ks = div get sp 0 mul 32 get sp 1
u_un = ks
if eq and ks 1 0
u_un = ulong 2
end
pf = ulong 0
if lt add get meta 501 1 u_un
pf = ulong 1
end
if gt ks u_un
pf = ulong 1
end
put meta 502 GM_NOREG
put meta 503 GM_NOREG
if ne pf 0
put meta 502 gm_v meta 2
put meta 503 gm_v meta 2
end
put meta 504 gm_v meta 1
if ne pf 0
gm_pf_addr sp ins meta
end
nj_tot = div mul get sp 2 get sp 1 get sp 3
j0 = ulong 0
while lt j0 nj_tot bound 16
nj = sub nj_tot j0
if gt nj 4
nj = ulong 4
end
put meta 505 j0
put meta 506 nj
gm_stage_chunk sp ins meta
j0 = add j0 nj
end
gm_r0 r 48
gm_emit ins meta r 6
end

fn gm_kstep_comp sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
cur = and get meta 501 1
gm_consume meta add 3 cur
for m ulong get sp 2 bound 16

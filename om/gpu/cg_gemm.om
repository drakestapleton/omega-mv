put meta 10 get meta 442
gm_ffma ins meta get meta 443 get meta add 450 cur get meta 442 0
end
for m ulong get sp 2 bound 16
ac = get meta add 460 m
put meta 10 ac
if eq get sp 4 1
gm_ffma ins meta ac get meta add 476 m get meta 442 0
else
gm_ffma ins meta ac get meta add 476 m get meta add 450 cur 0
end
end

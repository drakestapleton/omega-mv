gm_emit ins meta r 6
roww4 = mul mul 32 get sp 1 4
if ne get sp 5 0
put meta 10 get meta 440
put meta 11 roww4
gm_imadi ins meta get meta 440 get meta 395 0
else
gm_imadw ins meta get meta 430 get meta 395 roww4 get meta 430
end
end

fn gm_kstep sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void

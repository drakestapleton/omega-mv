fn gm_stage_chunk sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
xv = new ulong 4 0
xa = new ulong 4 0
for q ulong get meta 506 bound 4
put xv q gm_v meta 1
put xa q gm_v meta 2

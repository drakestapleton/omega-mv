fn gm_pf_addr sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
us = get meta 501
ks = div get sp 0 mul 32 get sp 1
u_un = ks
if eq and ks 1 0
u_un = ulong 2
end
bps = div mul 32 get sp 1 128
if lt add us 1 u_un
w_off = mul add us 1 mul 32 get sp 1
s_off = mul add us 1 mul bps 4
if eq get sp 4 2
s_off = ulong 0
end
gm_imadw ins meta get meta 502 get meta 395 w_off get meta 431
gm_imadw ins meta get meta 503 get meta 395 s_off get meta 432
else
nf = gm_v meta 1
inc = gm_v meta 1
inc2 = gm_v meta 1
put meta 10 get meta 433
put meta 11 0xfffffffe
gm_imadi ins meta nf get meta 395 0
gm_shr ins meta nf nf 0 31
put meta 10 get meta 395
put meta 11 0xffffffff
gm_imadi ins meta nf nf 0
put meta 10 GM_NOREG
put meta 11 mul u_un mul 32 get sp 1

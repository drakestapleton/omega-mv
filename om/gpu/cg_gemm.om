m0 = ulong 0
while lt m0 get sp 2 bound 4
nb = sub get sp 2 m0
if gt nb 4
nb = ulong 4
end
put meta 508 m0
put meta 509 nb
gm_comp_tile sp ins meta
m0 = add m0 nb
end
end

om2
note Pure OM-2 Blackwell FP8 e4m3 block-scaled grouped GEMM codegen (om/gpu/cg_gemm.om).
note Replaces src/omega_blackwell_codegen_gemm.c with the same 8-ulong-per-insn + 512-ulong meta wire format.
note sp[8]: 0=k, 1=lane_bytes, 2=mt, 3=warps, 4=mutant, 5=rowmap.

const GM_NOREG ulong 0xffffffffffffffff
const GM_MAX_SHM ulong 16384

fn gm_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn gm_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn gm_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn gm_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 GM_NOREG
put r 2 GM_NOREG
put r 3 GM_NOREG
put r 4 GM_NOREG
put r 5 GM_NOREG
put r 6 0
put r 7 0
end

fn gm_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = gm_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = gm_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or gm_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or gm_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or gm_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or gm_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = gm_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = gm_cw 5 7 7 wt
if eq and shr get r 7 1 1 0
put meta 4 0
end
end
if eq kind 8
cw = or gm_cw 1 7 7 wt 0x2000
put meta 4 0
end
if eq kind 9
cw = or gm_cw 5 7 7 wt 0x2000
put meta 4 0
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn gm_ldw_pf ins edit ulong 8192 meta edit ulong 512 op ulong dst ulong addr ulong sb ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = or gm_cw 4 sb 1 and wt 2 0x2000
put meta 4 or wt 2
put meta 6 or get meta 6 shl ulong 1 sb
b = mul n 8
put ins b op
put ins add b 1 dst
put ins add b 2 addr
put ins add b 3 GM_NOREG
put ins add b 4 GM_NOREG
put ins add b 5 get meta 384
put ins add b 6 shl cw 32
put ins add b 7 0
put meta 0 add n 1
end

fn gm_consume meta edit ulong 512 sb ulong to void
bit = shl ulong 1 sb
put meta 4 or get meta 4 and get meta 6 bit
put meta 6 and get meta 6 xor bit 0xffffffffffffffff
end

fn gm_patch ins edit ulong 8192 pos ulong target ulong to void
b = add mul pos 8 6
hi = and get ins b 0xffffffff00000000
d = and sub target pos 0xffffffff
put ins b or hi d
end

fn gm_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
put meta add 320 mul nl 2 start
put meta add 321 mul nl 2 sub get meta 0 1
put meta 3 add nl 1
end

fn gm_op1 ins edit ulong 8192 meta edit ulong 512 op ulong d ulong imm ulong kind ulong to void
r = new ulong 8 0
gm_r0 r op
put r 1 d
put r 6 imm
if eq kind 4
put r 7 1
end
gm_emit ins meta r kind
end

fn gm_imadi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong to void
r = new ulong 8 0
gm_r0 r 8
put r 1 d
put r 2 a
put r 4 get meta 10
put r 6 get meta 11
put r 7 shl asub 24
gm_emit ins meta r 0
end

fn gm_imadr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong c ulong to void
r = new ulong 8 0
gm_r0 r 8
put r 1 d
put r 2 a
put r 3 b
put r 4 c
gm_emit ins meta r 0
end

fn gm_imadw ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong c ulong to void
r = new ulong 8 0
gm_r0 r 9
put r 1 d
put r 2 a
put r 4 c
put r 6 imm
gm_emit ins meta r 0
end

fn gm_shr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong imm ulong to void
r = new ulong 8 0
gm_r0 r 17
put r 1 d
put r 2 a
put r 6 imm
put r 7 shl asub 24
gm_emit ins meta r 0
end

fn gm_andi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong imm ulong to void
r = new ulong 8 0
gm_r0 r 18
put r 1 d
put r 2 a
put r 6 imm
put r 7 shl asub 24
gm_emit ins meta r 0
end

fn gm_ldg ins edit ulong 8192 meta edit ulong 512 op ulong d ulong addr ulong imm ulong to void
r = new ulong 8 0
gm_r0 r op
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 imm
gm_emit ins meta r get meta 12
end

fn gm_lds128 ins edit ulong 8192 meta edit ulong 512 d ulong addr ulong imm ulong fst ulong to void
r = new ulong 8 0
gm_r0 r 58
put r 1 d
put r 2 addr
put r 6 imm
if ne fst 0
gm_emit ins meta r 2
else
gm_emit ins meta r 3
end
end

fn gm_ffma ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong bsub ulong to void
r = new ulong 8 0
gm_r0 r 33
put r 1 d
put r 2 a
put r 3 b
put r 4 get meta 10
put r 7 shl bsub 32
gm_emit ins meta r 0
end

fn gm_log2 v ulong to ulong
l = ulong 0
while lt shl ulong 1 l v bound 32
l = add l 1
end
if eq shl ulong 1 l v
ret l
end
ret 99
end

fn cg_gemm_ok_i sp view ulong 8 to ulong
k = get sp 0
lb = get sp 1
mt = get sp 2
w = get sp 3
mut = get sp 4
rm = get sp 5
if ne lb 8
if ne lb 16
ret 0
end
end
if eq mt 0
ret 0
end
if ne and mt sub mt 1 0
ret 0
end
if gt mul mul mt 128 lb GM_MAX_SHM
ret 0
end
if lt w 1
ret 0
end
if gt w 32
ret 0
end
if ne and w sub w 1 0
ret 0
end
if ne rem mul mt lb w 0
ret 0
end
if eq k 0
ret 0
end
if gt k 32768
ret 0
end
if ne rem k 128 0
ret 0
end
if ne rem k mul 32 lb 0
ret 0
end
ks = div k mul 32 lb
if ne and ks 1 0
if gt ks 3
ret 0
end
end
if gt mut 4
ret 0
end
if gt rm 1
ret 0
end
if ne rm 0
if gt mt 4
ret 0
end
end
ret 1
end

fn gm_prologue_alloc sp view ulong 8 meta edit ulong 512 to void
put meta 384 gm_uv meta 2
put meta 385 gm_v meta 2
put meta 386 gm_v meta 2
put meta 387 gm_v meta 2
put meta 388 gm_v meta 1
put meta 389 gm_v meta 1
put meta 390 gm_v meta 1
put meta 391 gm_v meta 1

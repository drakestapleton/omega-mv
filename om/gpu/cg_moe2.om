om2
note Pure OM-2 Blackwell FP8 e4m3 block-scaled GEMV v2 (row-pipelined) codegen (om/gpu/cg_moe2.om).
note Replaces src/omega_blackwell_codegen_moe2.c with the same 8-ulong-per-insn + 512-ulong meta wire format.
note sp[8]: 0=k, 1=lane_bytes, 2=rows, 3=warps, 4=mutant.

const M2_NOREG ulong 0xffffffffffffffff
const M2_MAX_K ulong 32768

fn m2_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn m2_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn m2_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn m2_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 M2_NOREG
put r 2 M2_NOREG
put r 3 M2_NOREG
put r 4 M2_NOREG
put r 5 M2_NOREG
put r 6 0
put r 7 0
end

fn m2_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = m2_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = m2_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or m2_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or m2_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or m2_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or m2_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = m2_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = m2_cw 5 7 7 wt
if eq and shr get r 7 1 1 0
put meta 4 0
end
end
if eq kind 8
cw = or m2_cw 1 7 7 wt 0x2000
put meta 4 0
end
if eq kind 9
cw = or m2_cw 5 7 7 wt 0x2000
put meta 4 0
end
if eq kind 10
cw = or m2_cw 4 3 1 wt 0x2000
put meta 4 2
end
if eq kind 11
cw = or m2_cw 4 3 1 and wt 2 0x2000
put meta 4 2
end
if eq kind 12
cw = m2_cw 6 7 7 or wt 8
put meta 4 0
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn m2_patch ins edit ulong 8192 pos ulong target ulong to void
b = add mul pos 8 6
hi = and get ins b 0xffffffff00000000
d = and sub target pos 0xffffffff
put ins b or hi d
end

fn m2_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
put meta add 320 mul nl 2 start
put meta add 321 mul nl 2 sub get meta 0 1
put meta 3 add nl 1
end

fn m2_op1 ins edit ulong 8192 meta edit ulong 512 op ulong d ulong imm ulong kind ulong to void
r = new ulong 8 0
m2_r0 r op
put r 1 d
put r 6 imm
if eq kind 4
put r 7 1
end
m2_emit ins meta r kind
end

fn m2_imadi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong to void
r = new ulong 8 0
m2_r0 r 8
put r 1 d
put r 2 a
put r 4 get meta 10
put r 6 get meta 11
put r 7 shl asub 24
m2_emit ins meta r 0
end

fn m2_imadr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong c ulong to void
r = new ulong 8 0
m2_r0 r 8
put r 1 d
put r 2 a
put r 3 b
put r 4 c
m2_emit ins meta r 0
end

fn m2_imadw ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong c ulong to void
r = new ulong 8 0
m2_r0 r 9
put r 1 d
put r 2 a
put r 4 c
put r 6 imm
m2_emit ins meta r 0
end

fn m2_movsub ins edit ulong 8192 meta edit ulong 512 d ulong dsub ulong s ulong ssub ulong to void
r = new ulong 8 0
m2_r0 r 8
put r 1 d
put r 2 s
put r 6 1
put r 7 or shl dsub 16 shl ssub 24
m2_emit ins meta r get meta 12
end

fn m2_shr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong imm ulong to void
r = new ulong 8 0
m2_r0 r 17
put r 1 d
put r 2 a
put r 6 imm
put r 7 shl asub 24
m2_emit ins meta r 0
end

fn m2_andi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong imm ulong to void
r = new ulong 8 0
m2_r0 r 18
put r 1 d
put r 2 a
put r 6 imm
put r 7 shl asub 24
m2_emit ins meta r 0
end

fn m2_bin ins edit ulong 8192 meta edit ulong 512 op ulong d ulong a ulong b ulong to void
r = new ulong 8 0
m2_r0 r op
put r 1 d
put r 2 a
put r 3 b
m2_emit ins meta r 0
end

fn m2_ldg ins edit ulong 8192 meta edit ulong 512 op ulong d ulong addr ulong imm ulong to void
r = new ulong 8 0
m2_r0 r op
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 imm
m2_emit ins meta r get meta 12
end

fn m2_ffma ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong bsub ulong to void
r = new ulong 8 0
m2_r0 r 33
put r 1 d
put r 2 a
put r 3 b
put r 4 get meta 10
put r 7 shl bsub 32
m2_emit ins meta r 0
end

fn m2_log2 v ulong to ulong
l = ulong 0
while lt shl ulong 1 l v bound 32
l = add l 1
end
if eq shl ulong 1 l v
ret l
end
ret 99
end

fn cg_moe2_ok_i sp view ulong 8 to ulong
k = get sp 0
lb = get sp 1
rows = get sp 2
w = get sp 3
mut = get sp 4
if ne lb 8
if ne lb 16
ret 0
end
end
if ne rows 1
if ne rows 2
if ne rows 4
if ne rows 8
ret 0
end
end
end
end
if lt w 1
ret 0
end
if gt w 32
ret 0
end
if eq k 0
ret 0
end
if gt k M2_MAX_K
ret 0
end
if ne rem k 128 0
ret 0
end
if ne rem k mul 32 lb 0
ret 0
end
if gt mut 3
ret 0
end
ks = div k mul 32 lb
if gt ks 16
ret 0
end
if gt mul mul rows ks lb 128
ret 0
end
if gt k mul 512 w
ret 0
end
if ge add mul sub rows 1 k lb shl ulong 1 23
ret 0
end
ret 1
end

fn m2_prologue sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
put meta 384 m2_uv meta 2
put meta 385 m2_v meta 2
put meta 386 m2_v meta 2
put meta 387 m2_v meta 2
for i ulong 11
put meta add 388 i m2_v meta 1
end
put meta 399 m2_v meta 2
put meta 400 m2_v meta 2
put meta 401 m2_v meta 2
put meta 402 m2_v meta 1
put meta 403 m2_v meta 2
put meta 404 m2_v meta 2
for i ulong 4
put meta add 405 i m2_v meta 1
end
m2_op1 ins meta 7 get meta 384 0x358 4
m2_op1 ins meta 5 get meta 385 0x380 2
m2_op1 ins meta 5 get meta 386 0x388 2
m2_op1 ins meta 5 get meta 387 0x390 2
m2_op1 ins meta 4 get meta 388 0x398 2
m2_op1 ins meta 4 get meta 389 0x39c 2
m2_op1 ins meta 4 get meta 390 0x3a0 2
m2_op1 ins meta 4 get meta 391 0x3a4 2
m2_op1 ins meta 3 get meta 392 0x21 2
m2_op1 ins meta 3 get meta 393 0x25 2
m2_op1 ins meta 3 get meta 394 0x26 2
m2_op1 ins meta 2 get meta 397 1 0
m2_shr ins meta get meta 395 get meta 392 0 5
m2_andi ins meta get meta 396 get meta 392 0 31
if eq get sp 4 3
m2_bin ins meta 29 get meta 398 get meta 394 get meta 397
else
put meta 10 M2_NOREG
put meta 11 1
m2_imadi ins meta get meta 398 get meta 394 0
end
m2_imadw ins meta get meta 399 get meta 398 16 get meta 385
put meta 12 2
m2_ldg ins meta 56 get meta 400 get meta 399 0
put meta 12 3
m2_ldg ins meta 56 get meta 401 get meta 399 8
m2_imadr ins meta get meta 402 get meta 394 get meta 389 M2_NOREG
m2_imadw ins meta get meta 403 get meta 402 1 get meta 386
m2_imadr ins meta get meta 402 get meta 394 get meta 390 M2_NOREG
m2_imadw ins meta get meta 404 get meta 402 1 get meta 387
put meta 10 M2_NOREG
put meta 11 get sp 1
m2_imadi ins meta get meta 405 get meta 396 0
m2_shr ins meta get meta 406 get meta 396 0 m2_log2 div 128 get sp 1
put meta 10 M2_NOREG
put meta 11 4
m2_imadi ins meta get meta 406 get meta 406 0
put meta 10 get meta 395
put meta 11 get sp 3
m2_imadi ins meta get meta 407 get meta 393 0
put meta 10 M2_NOREG
put meta 11 1
m2_imadi ins meta get meta 408 get meta 407 0
end

fn m2_alloc_body sp view ulong 8 meta edit ulong 512 to void
put meta 409 m2_v meta 4
ks = div get sp 0 mul 32 get sp 1
wq_w = ulong 2
if eq get sp 1 16
wq_w = ulong 4
end
for ri ulong get sp 2 bound 8
put meta add 422 ri m2_v meta 1
put meta add 430 ri m2_v meta 1
for s ulong ks bound 16
idx = add mul ri ks s
put meta add 440 idx m2_v meta wq_w
put meta add 456 idx m2_v meta wq_w
end
end
for s ulong ks bound 16
put meta add 472 s m2_v meta 1
put meta add 488 s m2_v meta 1
end
put meta 410 m2_v meta 2
put meta 411 m2_v meta 2
put meta 412 m2_v meta 2
put meta 413 m2_v meta 2
put meta 414 m2_v meta 2
for i ulong 7
put meta add 415 i m2_v meta 1
end
end

fn m2_stage_clamp sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 last_px ulong to void
j = sub div sub add get sp 0 mul 32 get sp 3 1 mul 32 get sp 3 1
put meta 10 M2_NOREG
put meta 11 1
m2_imadi ins meta get meta 438 get meta 392 0
put meta 10 get meta 438
put meta 11 mul j mul 32 get sp 3
m2_imadi ins meta get meta 438 get meta 397 0
put meta 10 M2_NOREG
put meta 11 0xffffffff
m2_imadi ins meta get meta 504 get meta 438 0
put meta 10 get meta 504
put meta 11 sub get sp 0 1
m2_imadi ins meta get meta 504 get meta 397 0
m2_shr ins meta get meta 439 get meta 504 0 31
put meta 10 M2_NOREG
put meta 11 1
m2_imadi ins meta get meta 504 get meta 438 0
put meta 10 get meta 504
put meta 11 and sub ulong 0 get sp 0 0xffffffff
m2_imadi ins meta get meta 504 get meta 397 0
m2_imadr ins meta get meta 505 get meta 439 get meta 504 M2_NOREG
put meta 10 get meta 438
put meta 11 0xffffffff
m2_imadi ins meta get meta 505 get meta 505 0
put meta 10 M2_NOREG
put meta 11 1
m2_imadi ins meta get meta 506 get meta 504 0
put meta 10 get meta 506
put meta 11 1
m2_imadi ins meta get meta 506 get meta 397 0
m2_imadr ins meta get meta 506 get meta 439 get meta 506 M2_NOREG
put meta 10 get meta 438
put meta 11 0xffffffff
m2_imadi ins meta get meta 506 get meta 506 0
m2_imadw ins meta last_px get meta 506 4 get meta 403
put meta 10 M2_NOREG
put meta 11 4
m2_imadi ins meta get meta 509 get meta 505 0
end

fn m2_stage_sts sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 xst view ulong 16 to void
r = new ulong 8 0
rounds = div sub add get sp 0 mul 32 get sp 3 1 mul 32 get sp 3
for j ulong rounds bound 16
if ne rem get sp 0 mul 32 get sp 3 0
if eq j sub rounds 1
m2_r0 r 50
put r 2 get meta 509
put r 3 get xst j
m2_emit ins meta r 5
else
put meta 10 get meta 507
put meta 11 mul j mul 128 get sp 3
m2_imadi ins meta get meta 508 get meta 397 0
m2_r0 r 50
put r 2 get meta 508
put r 3 get xst j
m2_emit ins meta r 5
end
else
put meta 10 get meta 507
put meta 11 mul j mul 128 get sp 3
m2_imadi ins meta get meta 508 get meta 397 0
m2_r0 r 50
put r 2 get meta 508
put r 3 get xst j
m2_emit ins meta r 5
end
end
m2_r0 r 48
m2_emit ins meta r 6
end

fn m2_stage_x sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
pxs = new ulong 16 0
xst = new ulong 16 0
rounds = div sub add get sp 0 mul 32 get sp 3 1 mul 32 get sp 3
pxt = m2_v meta 2
put meta 507 m2_v meta 1
put meta 508 m2_v meta 1
put meta 509 m2_v meta 1
put meta 438 m2_v meta 1
put meta 439 m2_v meta 1
put meta 504 m2_v meta 1
put meta 505 m2_v meta 1
put meta 506 m2_v meta 1
for j ulong rounds bound 16
put pxs j m2_v meta 2
put xst j m2_v meta 1
end
m2_imadw ins meta pxt get meta 392 4 get meta 403
put meta 10 M2_NOREG
put meta 11 4
m2_imadi ins meta get meta 507 get meta 392 0
for j ulong rounds bound 16
m2_imadw ins meta get pxs j get meta 397 mul j mul 128 get sp 3 pxt
end
if ne rem get sp 0 mul 32 get sp 3 0
m2_stage_clamp sp ins meta get pxs sub rounds 1
end
for j ulong rounds bound 16
put meta 12 3
if eq j 0
put meta 12 2
end
m2_ldg ins meta 11 get xst j get pxs j 0
end
m2_stage_sts sp ins meta xst
put meta 10 M2_NOREG
put meta 11 mul get sp 1 4
m2_imadi ins meta get meta 416 get meta 396 0
end

fn m2_issue_b_w sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 s ulong to void
ks = div get sp 0 mul 32 get sp 1
ldw = ulong 56
if eq get sp 1 16
ldw = ulong 57
end
for ri ulong get sp 2 bound 8
off = add mul ri get sp 0 mul s mul 32 get sp 1
m2_ldg ins meta ldw get meta add 456 add mul ri ks s get meta 410 off
put meta 12 11
end
end

fn m2_issue_b sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
ks = div get sp 0 mul 32 get sp 1
bps = div mul 32 get sp 1 128
m2_imadw ins meta get meta 410 get meta 407 mul get sp 2 get sp 0 get meta 400
m2_imadw ins meta get meta 410 get meta 405 1 get meta 410
m2_shr ins meta get meta 415 get meta 407 0 m2_log2 div 128 get sp 2
m2_imadw ins meta get meta 411 get meta 415 mul div get sp 0 128 4 get meta 401
m2_imadw ins meta get meta 411 get meta 406 1 get meta 411
put meta 12 10
for s ulong ks bound 16
m2_issue_b_w sp ins meta s
end
for s ulong ks bound 16
if eq s 0
m2_ldg ins meta 11 get meta 488 get meta 411 0
else
soff = mul s mul bps 4
if eq get sp 4 2
soff = ulong 0
end
m2_imadw ins meta get meta 412 get meta 397 soff get meta 411
put meta 12 11
m2_ldg ins meta 11 get meta add 488 s get meta 412 0
end
put meta 12 11
end
put meta 10 get meta 407
put meta 11 1
m2_imadi ins meta get meta 407 get meta 391 0
end

fn m2_copy_b_row sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 s ulong ri ulong to void
ks = div get sp 0 mul 32 get sp 1
idx = add mul ri ks s
aw = get meta add 440 idx
bw = get meta add 456 idx
for q ulong div get sp 1 4 bound 4
m2_movsub ins meta aw q bw q
put meta 12 0
end
end

fn m2_copy_b sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
ks = div get sp 0 mul 32 get sp 1
put meta 12 12
for s ulong ks bound 16
for ri ulong get sp 2 bound 8
m2_copy_b_row sp ins meta s ri
end
end
put meta 12 0
for s ulong ks bound 16
m2_movsub ins meta get meta add 472 s 0 get meta add 488 s 0
end
end

fn m2_decode_byte ins edit ulong 8192 meta edit ulong 512 wq ulong wd ulong i ulong to void
u = get meta 417
a = get meta 418
sg = get meta 419
f = get meta 420
if lt i 3
put meta 10 M2_NOREG
put meta 11 shl ulong 1 sub 20 mul 8 i
m2_imadi ins meta u wq wd
else
m2_shr ins meta u wq wd 4
end
m2_andi ins meta a u 0 0x07f00000
m2_andi ins meta sg wq wd shl ulong 0x80 mul 8 i
put meta 10 a
if lt i 3
put meta 11 shl ulong 1 sub 24 mul 8 i
else
put meta 11 1
end
m2_imadi ins meta f sg 0
end

fn m2_comp_word sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
s = get meta 510
wd = get meta 511
ks = div get sp 0 mul 32 get sp 1
m2_r0 r 58
put r 1 get meta 409
put r 2 get meta 416
put r 6 add mul s mul 128 get sp 1 mul wd 16
m2_emit ins meta r 2
for ri ulong get sp 2 bound 8
wq = get meta add 440 add mul ri ks s
dt = get meta add 430 ri
for i ulong 4
m2_decode_byte ins meta wq wd i
put meta 10 dt
m2_ffma ins meta dt get meta 420 get meta 409 i
end
end
end

fn m2_compute sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
ks = div get sp 0 mul 32 get sp 1
for ri ulong get sp 2 bound 8
m2_op1 ins meta 1 get meta add 422 ri 0 0
end
for s ulong ks bound 16
put meta 510 s
for ri ulong get sp 2 bound 8
m2_op1 ins meta 1 get meta add 430 ri 0 0
end
for wd ulong div get sp 1 4 bound 4
put meta 511 wd
m2_comp_word sp ins meta
end
for ri ulong get sp 2 bound 8
ac = get meta add 422 ri
dt = get meta add 430 ri
if eq get sp 4 1
m2_bin ins meta 30 ac ac dt
else
put meta 10 ac
m2_ffma ins meta ac dt get meta add 472 s 0
end
end
end
end

fn m2_reduce_one ins edit ulong 8192 meta edit ulong 512 ac ulong to void
r = new ulong 8 0
off = ulong 16
while ge off 1 bound 5
m2_r0 r 42
put r 1 get meta 421
put r 2 ac
put r 6 off
m2_emit ins meta r 2
m2_bin ins meta 30 ac ac get meta 421
off = shr off 1
end
end

fn m2_reduce_store sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
for ri ulong get sp 2 bound 8
m2_reduce_one ins meta get meta add 422 ri
end
m2_imadw ins meta get meta 413 get meta 408 mul get sp 2 4 get meta 404
m2_r0 r 28
put r 2 get meta 396
put r 3 get meta 397
m2_emit ins meta r 1
put meta 507 get meta 0
m2_r0 r 54
put r 6 2
m2_emit ins meta r 8
put meta 508 get meta 0
m2_r0 r 46
put r 6 1
put r 7 2
m2_emit ins meta r 7
for ri ulong get sp 2 bound 8
m2_imadw ins meta get meta 414 get meta 397 mul ri 4 get meta 413
m2_r0 r 12
put r 2 get meta 414
put r 3 get meta add 422 ri
put r 5 get meta 384
m2_emit ins meta r 5
end
at_bsync = get meta 0
m2_r0 r 55
m2_emit ins meta r 9
m2_patch ins get meta 508 at_bsync
m2_patch ins get meta 507 add at_bsync 1
end

fn m2_body sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
m2_r0 r 28
put r 2 get meta 407
put r 3 get meta 388
m2_emit ins meta r 1
put meta 504 get meta 0
m2_r0 r 46
put r 6 1
put r 7 2
m2_emit ins meta r 7
m2_issue_b sp ins meta
put meta 505 get meta 0
m2_copy_b sp ins meta
m2_r0 r 28
put r 2 get meta 407
put r 3 get meta 388
m2_emit ins meta r 1
put meta 506 get meta 0
m2_r0 r 46
put r 6 1
put r 7 2
m2_emit ins meta r 7
m2_issue_b sp ins meta
m2_patch ins get meta 506 get meta 0
m2_compute sp ins meta
m2_reduce_store sp ins meta
put meta 10 get meta 408
put meta 11 1
m2_imadi ins meta get meta 408 get meta 391 0
m2_r0 r 28
put r 2 get meta 408
put r 3 get meta 388
m2_emit ins meta r 1
put meta 509 get meta 0
m2_r0 r 46
put r 6 1
put r 7 2
m2_emit ins meta r 7
m2_r0 r 46
put r 6 sub get meta 505 get meta 0
m2_emit ins meta r 7
m2_loop_end meta get meta 505
l_end = get meta 0
m2_patch ins get meta 504 l_end
m2_patch ins get meta 509 l_end
m2_r0 r 45
m2_emit ins meta r 7
end

export fn cg_moe2_ok sp view ulong 8 to ulong
ret cg_moe2_ok_i sp
end

export fn cg_moe2_emit sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to ulong
if eq cg_moe2_ok_i sp 0
ret 1
end
for i ulong 512
put meta i 0
end
m2_prologue sp ins meta
m2_alloc_body sp meta
m2_stage_x sp ins meta
m2_body sp ins meta
n = get meta 0
if ge n 1024
ret 1
end
b = mul n 8
put ins b 46
put ins add b 1 M2_NOREG
put ins add b 2 M2_NOREG
put ins add b 3 M2_NOREG
put ins add b 4 M2_NOREG
put ins add b 5 M2_NOREG
put ins add b 6 shl ulong 0x000fc000 32
put ins add b 7 0
put meta 0 add n 1
if ne get meta 5 0
ret 1
end
ret 0
end

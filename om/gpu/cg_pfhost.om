om2
note Pure OM-2 Blackwell prefill router logits (rl) and MoE weighted combine (mc) codegen (om/gpu/cg_pfhost.om).
note Replaces src/omega_blackwell_codegen_pfhost.c.

const PH_NOREG ulong 0xffffffffffffffff

fn ph_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn ph_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn ph_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn ph_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 PH_NOREG
put r 2 PH_NOREG
put r 3 PH_NOREG
put r 4 PH_NOREG
put r 5 PH_NOREG
put r 6 0
put r 7 0
end

fn ph_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = ph_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = ph_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or ph_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or ph_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or ph_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or ph_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = ph_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = ph_cw 5 7 7 wt
if eq and shr get r 7 1 1 0
put meta 4 0
end
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn ph_ldw_pf ins edit ulong 8192 meta edit ulong 512 dst ulong addr ulong imm ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = or ph_cw 4 3 1 and wt 2 0x2000
put meta 4 or wt 2
put meta 6 or get meta 6 8
b = mul n 8
put ins b 57
put ins add b 1 dst
put ins add b 2 addr
put ins add b 3 PH_NOREG
put ins add b 4 PH_NOREG
put ins add b 5 get meta 384
put ins add b 6 or and imm 0xffffffff shl cw 32
put ins add b 7 0
put meta 0 add n 1
end

fn ph_consume3 meta edit ulong 512 to void
put meta 4 or get meta 4 and get meta 6 8
put meta 6 and get meta 6 xor ulong 8 0xffffffffffffffff
end

fn ph_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
put meta add 320 mul nl 2 start
put meta add 321 mul nl 2 sub get meta 0 1
put meta 3 add nl 1
end

fn ph_tail ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
ph_r0 r 45
ph_emit ins meta r 7
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
b = mul n 8
put ins b 46
put ins add b 1 PH_NOREG
put ins add b 2 PH_NOREG
put ins add b 3 PH_NOREG
put ins add b 4 PH_NOREG
put ins add b 5 PH_NOREG
put ins add b 6 shl ulong 0x000fc000 32
put ins add b 7 0
put meta 0 add n 1
end

fn ph_op1 ins edit ulong 8192 meta edit ulong 512 op ulong d ulong imm ulong kind ulong to void
r = new ulong 8 0
ph_r0 r op
put r 1 d
put r 6 imm
if eq kind 4
put r 7 1
end
ph_emit ins meta r kind
end

fn ph_imadi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong to void
r = new ulong 8 0
ph_r0 r 8
put r 1 d
put r 2 a
put r 4 get meta 10
put r 6 get meta 11
put r 7 shl asub 24
ph_emit ins meta r 0
end

fn ph_imadw ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong c ulong to void
r = new ulong 8 0
ph_r0 r 9
put r 1 d
put r 2 a
put r 4 c
put r 6 imm
ph_emit ins meta r 0
end

fn ph_ldg128 ins edit ulong 8192 meta edit ulong 512 d ulong addr ulong imm ulong fst ulong to void
r = new ulong 8 0
ph_r0 r 57
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 imm
if ne fst 0
ph_emit ins meta r 2
else
ph_emit ins meta r 3
end
end

fn ph_lds128 ins edit ulong 8192 meta edit ulong 512 d ulong addr ulong imm ulong fst ulong to void
r = new ulong 8 0
ph_r0 r 58
put r 1 d
put r 2 addr
put r 6 imm
if ne fst 0
ph_emit ins meta r 2
else
ph_emit ins meta r 3
end
end

fn ph_mul_add ins edit ulong 8192 meta edit ulong 512 acc ulong accsub ulong prod ulong to void
r = new ulong 8 0
if ne get meta 14 0
ph_r0 r 33
put r 1 acc
put r 2 get meta 10
put r 3 get meta 12
put r 4 acc
fl = or shl accsub 16 shl get meta 11 24
fl = or fl shl get meta 13 32
put r 7 or fl shl accsub 40
ph_emit ins meta r 0
else
ph_r0 r 32
put r 1 prod
put r 2 get meta 10
put r 3 get meta 12
put r 7 or shl get meta 11 24 shl get meta 13 32
ph_emit ins meta r 0
ph_r0 r 30
put r 1 acc
put r 2 acc
put r 3 prod
put r 7 or shl accsub 16 shl accsub 24
ph_emit ins meta r 0
end
end

fn cg_rl_ok_i sp view ulong 8 to ulong
k = get sp 0
ev = get sp 1
tv = get sp 2
mut = get sp 3
if lt k 128
ret 0
end
if gt k 16384
ret 0
end
if ne rem k 128 0
ret 0
end
if lt ev 32
ret 0
end
if gt ev 1024
ret 0
end
if ne rem ev 32 0
ret 0
end
if lt tv 1
ret 0
end
if gt tv 16
ret 0
end
if ne rem tv div ev 32 0
ret 0
end
if gt mul mul add div k 4 1 ev 16 0x7fffffff
ret 0
end
if gt mut 2
ret 0
end
ret 1
end

fn rl_comp_tile ins edit ulong 8192 meta edit ulong 512 rv ulong immoff ulong to void
for i ulong get meta 17 bound 4
off = add mul add get meta 16 i 512 immoff
if eq i 0
ph_lds128 ins meta get meta add 418 i get meta 398 off 1
else
ph_lds128 ins meta get meta add 418 i get meta 398 off 0
end
end
for i ulong get meta 17 bound 4
ac = get meta add 402 add get meta 16 i
vqi = get meta add 418 i
for q ulong 4
put meta 10 rv
put meta 11 q
put meta 12 vqi
put meta 13 q
ph_mul_add ins meta ac 0 get meta 399
end
end
end

fn rl_compute sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 rv ulong immoff ulong to void
b0 = ulong 0
while lt b0 get sp 2 bound 4
nb = sub get sp 2 b0
if gt nb 4
nb = ulong 4
end
put meta 16 b0
put meta 17 nb
rl_comp_tile ins meta rv immoff
b0 = add b0 nb
end
end

fn rl_stage sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
w = div get sp 1 32
passes = div get sp 2 w
ph_r0 r 48
ph_emit ins meta r 6
for p ulong passes bound 16
off = mul mul p w mul get sp 0 4
if eq p 0
ph_ldg128 ins meta get meta add 422 p get meta 385 off 1
else
ph_ldg128 ins meta get meta add 422 p get meta 385 off 0
end
end
for p ulong passes bound 16
for q ulong 4
put meta 10 get meta 394
put meta 11 add mul mul p w 512 mul 4 q
ph_imadi ins meta get meta 395 get meta 392 0
ph_r0 r 50
put r 2 get meta 395
put r 3 get meta add 422 p
put r 7 shl q 32
ph_emit ins meta r 5
end
end
ph_r0 r 48
ph_emit ins meta r 6
end

fn rl_body sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
gb = mul get sp 1 16
put meta 14 0
if eq get sp 3 1
put meta 14 1
end
lc = get meta 0
rl_stage sp ins meta
ph_imadw ins meta get meta 385 get meta 392 512 get meta 385
ph_op1 ins meta 2 get meta 398 0 0
ph_op1 ins meta 2 get meta 397 16 0
li = get meta 0
ph_consume3 meta
ph_ldw_pf ins meta get meta 401 get meta 386 gb
rl_compute sp ins meta get meta 400 0
ph_consume3 meta
ph_ldw_pf ins meta get meta 400 get meta 386 mul 2 gb
rl_compute sp ins meta get meta 401 16
ph_imadw ins meta get meta 386 get meta 392 mul 2 gb get meta 386
put meta 10 get meta 398
put meta 11 32
ph_imadi ins meta get meta 398 get meta 392 0
put meta 10 get meta 397
put meta 11 0xffffffff
ph_imadi ins meta get meta 397 get meta 392 0
ph_r0 r 28
put r 2 get meta 397
put r 3 get meta 392
ph_emit ins meta r 1
ph_r0 r 46
put r 6 sub li get meta 0
put r 7 2
ph_emit ins meta r 7
ph_loop_end meta li
put meta 10 get meta 396
put meta 11 0xffffffff
ph_imadi ins meta get meta 396 get meta 392 0
ph_r0 r 28
put r 2 get meta 396
put r 3 get meta 392
ph_emit ins meta r 1
ph_r0 r 46
put r 6 sub lc get meta 0
put r 7 2
ph_emit ins meta r 7
ph_loop_end meta lc
ph_consume3 meta
for ti ulong get sp 2 bound 16
ph_r0 r 12
put r 2 get meta 387
put r 3 get meta add 402 ti
put r 5 get meta 384
put r 6 mul mul ti get sp 1 4
ph_emit ins meta r 5
end
ph_tail ins meta
end

export fn cg_rl_ok sp view ulong 8 to ulong
ret cg_rl_ok_i sp
end

export fn cg_rl_emit sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to ulong
if eq cg_rl_ok_i sp 0
ret 1
end
chunks = div get sp 0 128
if eq get sp 3 2
chunks = sub chunks 1
end
if eq chunks 0
ret 1
end
for i ulong 512
put meta i 0
end
r = new ulong 8 0
put meta 384 ph_uv meta 2
put meta 385 ph_v meta 2
put meta 386 ph_v meta 2
put meta 387 ph_v meta 2
for i ulong 12
put meta add 388 i ph_v meta 1
end
put meta 400 ph_v meta 4
put meta 401 ph_v meta 4
for ti ulong get sp 2 bound 16
put meta add 402 ti ph_v meta 1
end
for i ulong 4
put meta add 418 i ph_v meta 4
end
passes = div get sp 2 div get sp 1 32
for p ulong passes bound 16
put meta add 422 p ph_v meta 4
end
ph_op1 ins meta 7 get meta 384 0x358 4
ph_op1 ins meta 5 get meta 385 0x380 2
ph_op1 ins meta 5 get meta 386 0x388 2
ph_op1 ins meta 5 get meta 387 0x390 2
ph_op1 ins meta 3 get meta 388 0x21 2
ph_op1 ins meta 3 get meta 389 0x25 2
ph_op1 ins meta 2 get meta 392 1 0
ph_r0 r 17
put r 1 get meta 390
put r 2 get meta 388
put r 6 5
ph_emit ins meta r 0
ph_r0 r 18
put r 1 get meta 391
put r 2 get meta 388
put r 6 31
ph_emit ins meta r 0
put meta 10 get meta 390
put meta 11 get sp 2
ph_imadi ins meta get meta 393 get meta 389 0
ph_imadw ins meta get meta 385 get meta 393 mul get sp 0 4 get meta 385
ph_imadw ins meta get meta 385 get meta 391 16 get meta 385
put meta 10 PH_NOREG
put meta 11 512
ph_imadi ins meta get meta 394 get meta 390 0
put meta 10 get meta 394
put meta 11 16
ph_imadi ins meta get meta 394 get meta 391 0
ph_imadw ins meta get meta 386 get meta 388 16 get meta 386
put meta 10 get meta 388
put meta 11 mul get sp 2 get sp 1
ph_imadi ins meta get meta 395 get meta 389 0
ph_imadw ins meta get meta 387 get meta 395 4 get meta 387
for ti ulong get sp 2 bound 16
ph_op1 ins meta 2 get meta add 402 ti 0x80000000 0
end
ph_ldw_pf ins meta get meta 400 get meta 386 0
ph_op1 ins meta 2 get meta 396 chunks 0
rl_body sp ins meta
if ne get meta 5 0
ret 1
end
ret 0
end

fn cg_mc_ok_i sp view ulong 8 to ulong
h = get sp 0
ks = get sp 1
mut = get sp 2
if lt h 128
ret 0
end
if gt h 4096
ret 0
end
if ne rem h 128 0
ret 0
end
if lt ks 4
ret 0
end
if gt ks 16
ret 0
end
if ne rem ks 4 0
ret 0
end
if gt mut 2
ret 0
end
ret 1
end

fn mc_body sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
put meta 14 0
if eq get sp 2 1
put meta 14 1
end
ph_op1 ins meta 7 get meta 384 0x358 4
ph_op1 ins meta 5 get meta 385 0x380 2
ph_op1 ins meta 5 get meta 386 0x388 2
ph_op1 ins meta 5 get meta 387 0x390 2
ph_op1 ins meta 5 get meta 388 0x398 2
ph_op1 ins meta 3 get meta 389 0x21 2
ph_op1 ins meta 3 get meta 390 0x25 2
ph_imadw ins meta get meta 386 get meta 390 mul get sp 1 4 get meta 386
ph_imadw ins meta get meta 387 get meta 390 mul get sp 1 4 get meta 387
for q ulong div get sp 1 4 bound 4
if eq q 0
ph_ldg128 ins meta get meta add 394 q get meta 386 mul 16 q 1
else
ph_ldg128 ins meta get meta add 394 q get meta 386 mul 16 q 0
end
end
for q ulong div get sp 1 4 bound 4
ph_ldg128 ins meta get meta add 398 q get meta 387 mul 16 q 0
end
for s ulong get sp 1 bound 16
put meta 10 get meta 389
put meta 11 div get sp 0 4
ph_imadi ins meta get meta 391 get meta add 394 div s 4 rem s 4
ph_imadw ins meta get meta add 418 s get meta 391 16 get meta 385
end
for s ulong get sp 1 bound 16
if eq s 0
ph_ldg128 ins meta get meta add 402 s get meta add 418 s 0 1
else
ph_ldg128 ins meta get meta add 402 s get meta add 418 s 0 0
end
end
for q ulong 4
ph_r0 r 1
put r 1 get meta 393
put r 7 shl q 16
ph_emit ins meta r 0
end
used = get sp 1
if eq get sp 2 2
used = sub used 1
end
for s ulong used bound 16
for q ulong 4
put meta 10 get meta add 398 div s 4
put meta 11 rem s 4
put meta 12 get meta add 402 s
put meta 13 q
ph_mul_add ins meta get meta 393 q get meta 392
end
end
put meta 10 get meta 389
put meta 11 div get sp 0 4
ph_imadi ins meta get meta 391 get meta 390 0
ph_imadw ins meta get meta 388 get meta 391 16 get meta 388
for q ulong 4
ph_r0 r 12
put r 2 get meta 388
put r 3 get meta 393
put r 5 get meta 384
put r 6 mul 4 q
put r 7 shl q 32
ph_emit ins meta r 5
end
ph_tail ins meta
end

export fn cg_mc_ok sp view ulong 8 to ulong
ret cg_mc_ok_i sp
end

export fn cg_mc_emit sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to ulong
if eq cg_mc_ok_i sp 0
ret 1
end
for i ulong 512
put meta i 0
end
put meta 384 ph_uv meta 2
put meta 385 ph_v meta 2
put meta 386 ph_v meta 2
put meta 387 ph_v meta 2
put meta 388 ph_v meta 2
put meta 389 ph_v meta 1
put meta 390 ph_v meta 1
put meta 391 ph_v meta 1
put meta 392 ph_v meta 1
put meta 393 ph_v meta 4
nq = div get sp 1 4
for q ulong nq bound 4
put meta add 394 q ph_v meta 4
put meta add 398 q ph_v meta 4
end
for s ulong get sp 1 bound 16
put meta add 402 s ph_v meta 4
put meta add 418 s ph_v meta 2
end
mc_body sp ins meta
if ne get meta 5 0
ret 1
end
ret 0
end

om2
note Pure OM-2 Blackwell prefill attention 256 (Q38 27B / Q36) codegen (om/gpu/cg_pattn256.om).
note Replaces the kernel emitter in src/omega_blackwell_codegen_pattn256.c.

const P2_NOREG ulong 0xffffffffffffffff
const P2_NEG_BIG ulong 0xf149f2ca

fn p2_op v ulong s ulong to ulong
ret or v shl s 16
end

fn p2_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn p2_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn p2_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn p2_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 P2_NOREG
put r 2 P2_NOREG
put r 3 P2_NOREG
put r 4 P2_NOREG
put r 5 P2_NOREG
put r 6 0
put r 7 0
end

fn p2_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = p2_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = p2_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or p2_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or p2_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or p2_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or p2_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = p2_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = p2_cw 5 7 7 wt
if eq and shr get r 7 1 1 0
put meta 4 0
end
end
if eq kind 8
cw = or p2_cw 1 7 7 wt 0x2000
put meta 4 0
end
if eq kind 9
cw = or p2_cw 5 7 7 wt 0x2000
put meta 4 0
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn p2_emit_raw ins edit ulong 8192 meta edit ulong 512 r view ulong 8 cw ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn p2_consume meta edit ulong 512 sb ulong to void
bit = shl ulong 1 sb
h = get meta 6
p = get meta 4
put meta 4 or p and h bit
put meta 6 sub h and h bit
end

fn p2_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
n = get meta 0
if eq n 0
put meta 5 1
ret
end
put meta add 320 mul nl 2 start
put meta add 321 mul nl 2 sub n 1
put meta 3 add nl 1
end

fn p2_patch ins edit ulong 8192 meta edit ulong 512 pos ulong tgt ulong to void
if ne get meta 5 0
ret
end
if ge pos 1024
put meta 5 1
ret
end
idx = add mul pos 8 6
hi = and get ins idx 0xffffffff00000000
d = and sub tgt pos 0xffffffff
put ins idx or hi d
end

fn p2_ldcu64 ins edit ulong 8192 meta edit ulong 512 ud ulong off ulong to void
r = new ulong 8 0
p2_r0 edit r 7
put r 1 ud
put r 6 off
put r 7 1
p2_emit edit ins edit meta view r 4
end

fn p2_ldc64 ins edit ulong 8192 meta edit ulong 512 d ulong off ulong to void
r = new ulong 8 0
p2_r0 edit r 5
put r 1 d
put r 6 off
p2_emit edit ins edit meta view r 2
end

fn p2_ldc32 ins edit ulong 8192 meta edit ulong 512 d ulong off ulong to void
r = new ulong 8 0
p2_r0 edit r 4
put r 1 d
put r 6 off
p2_emit edit ins edit meta view r 2
end

fn p2_s2r ins edit ulong 8192 meta edit ulong 512 d ulong sr ulong to void
r = new ulong 8 0
p2_r0 edit r 3
put r 1 d
put r 6 sr
p2_emit edit ins edit meta view r 2
end

fn p2_movi ins edit ulong 8192 meta edit ulong 512 dop ulong imm ulong to void
r = new ulong 8 0
p2_r0 edit r 2
put r 1 and dop 0xffff
put r 6 imm
put r 7 shl shr dop 16 16
p2_emit edit ins edit meta view r 0
end

fn p2_movrz ins edit ulong 8192 meta edit ulong 512 dop ulong to void
r = new ulong 8 0
p2_r0 edit r 1
put r 1 and dop 0xffff
put r 7 shl shr dop 16 16
p2_emit edit ins edit meta view r 0
end

fn p2_imadi ins edit ulong 8192 meta edit ulong 512 dop ulong aop ulong imm ulong c ulong to void
r = new ulong 8 0
p2_r0 edit r 8
put r 1 and dop 0xffff
put r 2 and aop 0xffff
put r 4 c
put r 6 imm
put r 7 or shl shr dop 16 16 shl shr aop 16 24
p2_emit edit ins edit meta view r 0
end

fn p2_imadr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong c ulong to void
r = new ulong 8 0
p2_r0 edit r 8
put r 1 d
put r 2 a
put r 3 b
put r 4 c
p2_emit edit ins edit meta view r 0
end

fn p2_imadw ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong c ulong to void
r = new ulong 8 0
p2_r0 edit r 9
put r 1 d
put r 2 a
put r 4 c
put r 6 imm
p2_emit edit ins edit meta view r 0
end

fn p2_mov ins edit ulong 8192 meta edit ulong 512 dop ulong aop ulong to void
p2_imadi edit ins edit meta dop aop 1 P2_NOREG
end

fn p2_shr ins edit ulong 8192 meta edit ulong 512 d ulong aop ulong imm ulong to void
r = new ulong 8 0
p2_r0 edit r 17
put r 1 d
put r 2 and aop 0xffff
put r 6 imm
put r 7 shl shr aop 16 24
p2_emit edit ins edit meta view r 0
end

fn p2_andi ins edit ulong 8192 meta edit ulong 512 dop ulong aop ulong imm ulong to void
r = new ulong 8 0
p2_r0 edit r 18
put r 1 and dop 0xffff
put r 2 and aop 0xffff
put r 6 imm
put r 7 or shl shr dop 16 16 shl shr aop 16 24
p2_emit edit ins edit meta view r 0
end

fn p2_fop2 ins edit ulong 8192 meta edit ulong 512 op ulong dop ulong aop ulong bop ulong to void
r = new ulong 8 0
p2_r0 edit r op
put r 1 and dop 0xffff
put r 2 and aop 0xffff
put r 3 and bop 0xffff
f1 = or shl shr dop 16 16 shl shr aop 16 24
put r 7 or f1 shl shr bop 16 32
p2_emit edit ins edit meta view r 0
end

fn p2_iadd ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong to void
p2_fop2 edit ins edit meta 14 d a b
end

fn p2_mufu ins edit ulong 8192 meta edit ulong 512 op ulong dop ulong aop ulong first ulong to void
r = new ulong 8 0
p2_r0 edit r op
put r 1 and dop 0xffff
put r 2 and aop 0xffff
put r 7 or shl shr dop 16 16 shl shr aop 16 24
k = ulong 3
if ne first 0
k = 2
end
p2_emit edit ins edit meta view r k
end

fn p2_ldg128 ins edit ulong 8192 meta edit ulong 512 d ulong addr ulong imm ulong first ulong to void
r = new ulong 8 0
p2_r0 edit r 57
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 imm
k = ulong 3
if ne first 0
k = 2
end
p2_emit edit ins edit meta view r k
end

fn p2_stg ins edit ulong 8192 meta edit ulong 512 addr ulong imm ulong vop ulong to void
r = new ulong 8 0
p2_r0 edit r 12
put r 2 addr
put r 3 and vop 0xffff
put r 5 get meta 384
put r 6 imm
put r 7 shl shr vop 16 32
p2_emit edit ins edit meta view r 5
end

fn p2_lds128 ins edit ulong 8192 meta edit ulong 512 d ulong addr ulong imm ulong first ulong to void
r = new ulong 8 0
p2_r0 edit r 58
put r 1 d
put r 2 addr
put r 6 imm
k = ulong 3

k = 2
end
p2_emit edit ins edit meta view r k
end

fn p2_sts32 ins edit ulong 8192 meta edit ulong 512 addr ulong vop ulong to void
r = new ulong 8 0
p2_r0 edit r 50
put r 2 addr
put r 3 and vop 0xffff
put r 7 shl shr vop 16 32
p2_emit edit ins edit meta view r 5
end

fn p2_bar ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
p2_r0 edit r 48
p2_emit edit ins edit meta view r 6
end

fn p2_shfl_bfly ins edit ulong 8192 meta edit ulong 512 d ulong a ulong lanes ulong to void
r = new ulong 8 0
p2_r0 edit r 60
put r 1 d
put r 2 a
put r 6 and lanes 31
p2_emit edit ins edit meta view r 2
end

fn p2_f2fp ins edit ulong 8192 meta edit ulong 512 dop ulong hiop ulong loop ulong to void
r = new ulong 8 0
p2_r0 edit r 61
put r 1 and dop 0xffff
put r 2 and hiop 0xffff
put r 3 and loop 0xffff
f1 = or shl shr dop 16 16 shl shr hiop 16 24
put r 7 or f1 shl shr loop 16 32
p2_emit edit ins edit meta view r 0
end

fn p2_isetp_ge_u32 ins edit ulong 8192 meta edit ulong 512 a ulong b ulong to void

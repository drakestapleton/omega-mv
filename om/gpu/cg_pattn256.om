fn p2_bsync ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
p2_r0 edit r 55
p2_emit edit ins edit meta view r 9
end

fn p2_tail ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
p2_r0 edit r 45
p2_emit edit ins edit meta view r 7
p2_r0 edit r 46
p2_emit_raw edit ins edit meta view r 0x000fc000
end

fn p2_hmma8 ins edit ulong 8192 meta edit ulong 512 d ulong a ulong bop ulong c ulong to void
r = new ulong 8 0
p2_r0 edit r 16
put r 1 d
put r 2 a
put r 3 and bop 0xffff
put r 4 c
put r 7 shl shr bop 16 32
cw = p2_cw 8 7 7 get meta 4
put meta 4 0
p2_emit_raw edit ins edit meta view r cw
end

fn p2_nop ins edit ulong 8192 meta edit ulong 512 stall ulong to void
r = new ulong 8 0
p2_r0 edit r 0
cw = p2_cw stall 7 7 get meta 4
put meta 4 0
p2_emit_raw edit ins edit meta view r cw
end

fn p2_lds_pf ins edit ulong 8192 meta edit ulong 512 d ulong addr ulong imm ulong sb ulong to void
r = new ulong 8 0
p2_r0 edit r 58
put r 1 d
put r 2 addr
put r 6 imm
wt = get meta 4
cw = or p2_cw 4 sb 1 and wt 2 0x2000
put meta 4 or wt 2
put meta 6 or get meta 6 shl ulong 1 sb
p2_emit_raw edit ins edit meta view r cw
end

fn p2_shape_ok sp view ulong 4 to ulong
mut = get sp 0
if gt mut 2
ret 0
end
qh = get sp 1
if eq qh 0
qh = 24
end
kvh = get sp 2
if eq kvh 0
kvh = 4
end
if ne rem qh kvh 0
ret 0
end
if gt div qh kvh 8
ret 0
end
ret 1
end


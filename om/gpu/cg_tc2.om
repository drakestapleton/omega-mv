put meta 32 2
tc_ldg64 ins meta get meta 399 get meta 398 0
put meta 32 3
tc_ldg64 ins meta get meta 400 get meta 398 8
tc_ldg64 ins meta get meta 401 get meta 398 16
put meta 30 TC_NOREG
put meta 31 1

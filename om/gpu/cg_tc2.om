end
end

fn tc_alloc_loop_regs meta edit ulong 512 to void
rt = get meta 17
ct = get meta 18
aqn = get meta 19
nj = get meta 25
put meta 464 tc_v meta 2
put meta 465 tc_v meta 1
put meta 466 tc_v meta 1
put meta 467 tc_v meta 1
put meta 468 tc_v meta 1
for x ulong mul rt ct bound 32
put meta add 432 x tc_v meta 4
end
for j ulong ct bound 4
put meta add 448 j tc_v meta 4
put meta add 450 j tc_v meta 4
put meta add 452 j tc_v meta 2
end
for q ulong aqn bound 4
put meta add 454 q tc_v meta 4
end
for jj ulong nj bound 16
put meta add 456 jj tc_v meta 4
end
end

fn tc_issue ins edit ulong 8192 meta edit ulong 512 wbase_idx ulong sb ulong mode ulong to void
put meta 33 sb
xoff = ulong 0
woff = ulong 0
if eq mode 1
xoff = ulong 128
woff = ulong 64
end
for jj ulong get meta 25 bound 16
put meta 31 xoff
tc_ldw_pf ins meta 57 get meta add 456 jj get meta add 410 jj
end
for j ulong get meta 18 bound 4
put meta 31 add woff mul mul j 8 get meta 16
tc_ldw_pf ins meta 57 get meta add wbase_idx j get meta 406
end
if eq mode 0
put meta 31 0
tc_ldw_pf ins meta 56 get meta 464 get meta 407
end
end

fn tc_stage ins edit ulong 8192 meta edit ulong 512 bufoff ulong to void
nj = get meta 25
one = get meta 397
tmp = get meta 404
for jj ulong nj bound 16
saj = get meta add 418 jj
stgr = get meta add 456 jj
put meta 30 saj
put meta 31 bufoff
tc_imadi ins meta tmp one 0
tc_sts32_sub ins meta tmp stgr 0
put meta 30 saj
put meta 31 add bufoff 8
tc_imadi ins meta tmp one 0
tc_sts32_sub ins meta tmp stgr 1
put meta 30 saj
put meta 31 add bufoff 512
tc_imadi ins meta tmp one 0
tc_sts32_sub ins meta tmp stgr 2
put meta 30 saj
put meta 31 add bufoff 520
tc_imadi ins meta tmp one 0
tc_sts32_sub ins meta tmp stgr 3
end
tc_bar_sync ins meta
end

fn tc_hmma_row ins edit ulong 8192 meta edit ulong 512 row ulong aqv ulong to void
ct = get meta 18
for j ulong ct bound 4
x = add mul row ct j
tc_hmma ins meta get meta add 432 x aqv get meta add 452 j
end
end

fn tc_compute_tile ins edit ulong 8192 meta edit ulong 512 bufoff ulong s ulong i0 ulong to void
nb = sub get meta 17 i0
if gt nb get meta 19
nb = get meta 19
end
for q ulong nb bound 4
ii = add i0 q
if eq get meta 23 3
ii = xor ii 1
end
if eq q 0
put meta 32 2
else
put meta 32 3
end
soff = add bufoff mul add mul ii 4 s 512
tc_lds128 ins meta get meta add 454 q get meta 408 soff
end
for q ulong nb bound 4
tc_hmma_row ins meta add i0 q get meta add 454 q
end
end

fn tc_compute ins edit ulong 8192 meta edit ulong 512 bufoff ulong wbase_idx ulong odd ulong to void
for s ulong 4
if and eq get meta 23 4 and ne odd 0 eq s 3
break
end
for j ulong get meta 18 bound 4
tc_decode_word ins meta get meta add 452 j get meta add wbase_idx j s
end
i0 = ulong 0
while lt i0 get meta 17 bound 16
tc_compute_tile ins meta bufoff s i0
i0 = add i0 get meta 19
end
end
end

fn tc_rescale ins edit ulong 8192 meta edit ulong 512 to void
rt = get meta 17
ct = get meta 18
rr = get meta 464
tc_nop ins meta 15
tc_nop ins meta 14
for x ulong mul rt ct bound 32
av = get meta add 432 x
rsub = rem x ct
for q ulong 4
f0 = or shl q 16 shl q 24
put meta 34 or f0 shl rsub 32
tc_fmul_s ins meta av av rr
end
end
end

fn tc_kloop ins edit ulong 8192 meta edit ulong 512 to void
rt = get meta 17
ct = get meta 18
buf = get meta 26
nj = get meta 25
one = get meta 397
cntk = get meta 465
for x ulong mul rt ct bound 32
av = get meta add 432 x
for q ulong 4
tc_movrz_sub ins meta av q
end
end

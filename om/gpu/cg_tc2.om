tc_consume meta 4
tc_stage ins meta buf
nf = tc_v meta 1
inc = tc_v meta 1
if ne get meta 5 0
ret
end
put meta 30 cntk
put meta 31 0xfffffffe
tc_imadi ins meta nf one 0
tc_shr ins meta nf nf 31
put meta 30 one
put meta 31 0xffffffff
tc_imadi ins meta nf nf 0
for jj ulong nj bound 16
gxj = get meta add 410 jj

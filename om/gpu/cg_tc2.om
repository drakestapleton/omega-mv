put meta 401 tc_v meta 2
put meta 402 tc_v meta 1
put meta 403 tc_v meta 1
put meta 404 tc_v meta 1
put meta 405 tc_v meta 1
put meta 406 tc_v meta 2
put meta 407 tc_v meta 2
put meta 408 tc_v meta 1
put meta 409 tc_v meta 2
if ne get meta 5 0

tc_iadd ins meta tmp get meta 402 r
if ne get meta 21 0
put meta 30 TC_NOREG
put meta 31 1
tc_imadi ins meta srow tmp 0
else
put meta 30 get meta 386
tc_imadw ins meta get meta 427 tmp 4
tc_ldg32 ins meta srow get meta 427
end
put meta 30 get meta 387
tc_imadw ins meta gxj srow mul get meta 16 2
put meta 30 gxj
tc_imadw ins meta gxj get meta 429 1
tc_shr ins meta tmp r 4
put meta 30 get meta 431
put meta 31 4

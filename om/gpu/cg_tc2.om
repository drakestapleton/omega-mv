put meta 30 TC_NOREG
put meta 31 16
tc_imadi ins meta w0b tmp 0
tc_shr ins meta ts tmp 1
tc_andi ins meta s0 tid 1
put meta 30 TC_NOREG
put meta 31 2
tc_imadi ins meta s0 s0 0
end

fn tc_staging_one ins edit ulong 8192 meta edit ulong 512 jj ulong to void
gxj = get meta add 410 jj
saj = get meta add 418 jj
tmp = get meta 404
tmp2 = get meta 405
r = get meta 426
srow = get meta 428
tc_shr ins meta r get meta 390 3
put meta 30 r
put meta 31 div mul jj get meta 14 8

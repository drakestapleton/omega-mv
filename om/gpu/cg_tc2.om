tc_andi ins meta tmp2 r 7
put meta 30 tmp
put meta 31 4
tc_imadi ins meta tmp2 tmp2 0
put meta 30 TC_NOREG
put meta 31 16
tc_imadi ins meta saj tmp2 0
tc_shr ins meta tmp2 r 3
tc_andi ins meta tmp2 tmp2 1
put meta 30 saj
put meta 31 4
tc_imadi ins meta saj tmp2 0
end

fn tc_staging_loop ins edit ulong 8192 meta edit ulong 512 to void

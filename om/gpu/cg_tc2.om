tc_rescale ins meta
tc_epilogue_setup ins meta
if ne get meta 5 0
ret 1
end
tc_epilogue_ptr ins meta
tc_epilogue_stores ins meta
if ne get meta 5 0
ret 1
end
tc_tail ins meta
if ne get meta 5 0
ret 1
end
ret 0
end

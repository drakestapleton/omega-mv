fn tc_decode_word ins edit ulong 8192 meta edit ulong 512 bp ulong wq ulong word ulong to void
m = get meta 466
s = get meta 467
t = get meta 468
put meta 31 0x007f007f
tc_andi_s ins meta m wq word
put meta 31 0x00800080
tc_andi_s ins meta s wq word
put meta 30 TC_NOREG
put meta 31 16
tc_imadi ins meta t m 0
r = new ulong 8 0
tc_r0 r 8
put r 1 bp
put r 2 s
put r 4 t
put r 6 256
tc_emit ins meta r 0
put meta 31 0x7f007f00
tc_andi_s ins meta m wq word
put meta 31 0x80008000
tc_andi_s ins meta s wq word
tc_shr ins meta t m 4
tc_r0 r 14
put r 1 bp
put r 2 t
put r 3 s
put r 7 shl ulong 1 16
tc_emit ins meta r 0
end

fn tc_spec_ok sp view ulong 10 to ulong
k = get sp 0
if or lt k 128 or gt k 16384 ne rem k 128 0
ret 0
end
rt = get sp 1
if and ne rt 2 and ne rt 4 ne rt 8
ret 0
end
if ne get sp 2 2
ret 0
end
if lt mul rt get sp 2 4
ret 0
end
w = get sp 3
if and ne w 4 and ne w 8 ne w 16
ret 0
end
if and ne get sp 4 1 ne get sp 4 2
ret 0
end
if or gt get sp 5 1 and eq get sp 5 1 ne get sp 2 2
ret 0
end
if gt get sp 6 1
ret 0
end
span = mul mul w 8 get sp 2
nv = get sp 7
if eq nv 0
ret 0
end
if ne rem nv span 0
ret 0
end
if ge mul mul nv 4 mul 16 rt 8388608
ret 0
end
if ne rem mul mul 16 rt 8 mul 32 w 0
ret 0
end
if gt get sp 8 4
ret 0
end
if and eq get sp 8 3 lt rt 2
ret 0
end
ret 1
end

fn tc_init_meta sp view ulong 10 meta edit ulong 512 to void
k = get sp 0
rt = get sp 1
ct = get sp 2
warps = get sp 3
t = mul 32 warps
bm = mul 16 rt
kb = div k 128
span = mul mul warps 8 ct
put meta 14 t
put meta 15 span
put meta 16 k
put meta 17 rt
put meta 18 ct
put meta 19 get sp 4
put meta 20 get sp 5
put meta 21 get sp 6
put meta 22 get sp 7
put meta 23 get sp 8
put meta 24 kb
put meta 25 div mul bm 8 t
put meta 26 mul bm 128
put meta 27 mul add kb 1 8
end

fn tc_prologue ins edit ulong 8192 meta edit ulong 512 to void
udesc = tc_uv meta 2
put meta 384 udesc
put meta 385 tc_v meta 2
put meta 386 tc_v meta 2
put meta 387 tc_v meta 2

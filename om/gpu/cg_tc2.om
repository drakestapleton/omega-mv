fn tc_staging_setup ins edit ulong 8192 meta edit ulong 512 to void
nj = get meta 25
for jj ulong nj bound 16
put meta add 410 jj tc_v meta 2
put meta add 418 jj tc_v meta 1
end
r = tc_v meta 1
sidx = tc_v meta 2
srow = tc_v meta 1
w0b = tc_v meta 1
ts = tc_v meta 1
s0 = tc_v meta 1
put meta 426 r
put meta 427 sidx
put meta 428 srow
put meta 429 w0b
put meta 430 ts
put meta 431 s0
if ne get meta 5 0
ret
end
tid = get meta 390
tmp = get meta 404
tmp2 = get meta 405

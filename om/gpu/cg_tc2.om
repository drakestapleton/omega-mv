ret tc_spec_ok sp
end

export fn cg_tc2_emit sp view ulong 10 ins edit ulong 8192 meta edit ulong 512 to ulong
if eq tc_spec_ok sp 0
put meta 5 1
ret 1
end
tc_init_meta sp meta
tc_prologue ins meta
if ne get meta 5 0
ret 1
end

note SPDX-License-Identifier: Apache-2.0
note om/gpu/cg_pf.om: Pure OM-2 Blackwell IR emitter for device-resident prefill 16-byte copy kernel.
note Replaces src/omega_blackwell_codegen_pf.c.
om2

const PF_NOREG ulong 0xffffffffffffffff
const PF_CW_YIELD ulong 0x2000

fn pf_cw st ulong wb ulong rb ulong wt ulong to ulong
ret or or or shl st 9 shl wb 14 shl rb 17 shl wt 20
end

fn pf_v meta edit ulong 512 w ulong to ulong
v = get meta 1
put meta add 64 v w
put meta 1 add v 1
ret v
end

fn pf_uv meta edit ulong 512 w ulong to ulong
u = get meta 2
put meta add 352 u w
put meta 2 add u 1
ret u
end

fn pf_emit ins edit ulong 8192 meta edit ulong 512 row view ulong 8 kind ulong to void
n = get meta 0
wt = get meta 4
ctrl = ulong 0
if eq kind 0
ctrl = pf_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
ctrl = pf_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
ctrl = or pf_cw 4 0 1 wt PF_CW_YIELD
put meta 4 3
end
if eq kind 3
ctrl = or pf_cw 4 2 7 wt PF_CW_YIELD
put meta 4 4
end
if eq kind 4
ctrl = or pf_cw 4 7 1 wt PF_CW_YIELD
put meta 4 2
end
if eq kind 5
ctrl = pf_cw 5 7 7 wt
if eq and shr get row 7 1 1 0
put meta 4 0
end
end
b = mul n 8
for k ulong 6
put ins add b k get row k
end
put ins add b 6 or and get row 6 0xffffffff shl ctrl 32
put ins add b 7 get row 7
put meta 0 add n 1
end

fn pf_init_row row edit ulong 8 op ulong to void
put row 0 op
put row 1 PF_NOREG
put row 2 PF_NOREG
put row 3 PF_NOREG
put row 4 PF_NOREG
put row 5 PF_NOREG
put row 6 0
put row 7 0
end

fn pf_tail ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
pf_init_row r 45
pf_emit ins meta r 5
n = get meta 0
b = mul n 8
put ins b 46
put ins add b 1 PF_NOREG
put ins add b 2 PF_NOREG
put ins add b 3 PF_NOREG
put ins add b 4 PF_NOREG
put ins add b 5 PF_NOREG
put ins add b 6 shl ulong 0x000fc000 32
put ins add b 7 0
put meta 0 add n 1
end

fn pf_body ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
pf_init_row r 9
put r 1 get meta 386
put r 2 get meta 390
put r 4 get meta 386
put r 6 16
pf_emit ins meta r 0
pf_init_row r 9
put r 1 get meta 385
put r 2 get meta 390
put r 4 get meta 385
put r 6 16
pf_emit ins meta r 0
pf_init_row r 57
put r 1 get meta 391
put r 2 get meta 386
put r 5 get meta 384
pf_emit ins meta r 2
for q ulong 4
pf_init_row r 12
put r 2 get meta 385
put r 3 get meta 391
put r 5 get meta 384
put r 6 mul q 4
put r 7 shl q 32
pf_emit ins meta r 4
end
pf_tail ins meta
end

export fn cg_pf_copy ins edit ulong 8192 meta edit ulong 512 to ulong
for i ulong 512
put meta i 0
end
put meta 384 pf_uv meta 2
put meta 385 pf_v meta 2
put meta 386 pf_v meta 2
put meta 387 pf_v meta 1
put meta 388 pf_v meta 1
put meta 389 pf_v meta 1
put meta 390 pf_v meta 1
put meta 391 pf_v meta 4
r = new ulong 8 0
pf_init_row r 7
put r 1 get meta 384
put r 6 0x358
put r 7 1
pf_emit ins meta r 3
pf_init_row r 5
put r 1 get meta 385
put r 6 0x380
pf_emit ins meta r 2
pf_init_row r 5
put r 1 get meta 386
put r 6 0x388
pf_emit ins meta r 2
pf_init_row r 4
put r 1 get meta 387
put r 6 0x390
pf_emit ins meta r 2
pf_init_row r 3
put r 1 get meta 388
put r 6 0x21
pf_emit ins meta r 2
pf_init_row r 3
put r 1 get meta 389
put r 6 0x25
pf_emit ins meta r 2
pf_init_row r 8
put r 1 get meta 390
put r 2 get meta 389
put r 4 get meta 388
put r 6 256
pf_emit ins meta r 0
pf_init_row r 28
put r 2 get meta 390
put r 3 get meta 387
pf_emit ins meta r 1
pf_init_row r 45
put r 7 2
pf_emit ins meta r 5
pf_body ins meta
ret 0
end

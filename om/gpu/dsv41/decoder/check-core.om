note SPDX-License-Identifier: AGPL-3.0-only
note In host-scaffold mode pre-fault the original Zone 1 checkpoint bytes
note into an owned mapping. GPU startup can pass its own RM mapping to dcPopulate.
fn dcOpenArg arg ulong to int
  path = new uchar 4096 0
  n = argread arg path 0 4096
  if le n 0
    ret int -1
  end
  ret int fopen path 0 ulong n 524288 0
end

fn main to int
  if and ne argcnt 2 ne argcnt 50
    ret 64
  end
  fd = dcOpenArg 1
  if lt fd 0
    ret 66
  end
  ok = dcPlan fd
  if ne fclose fd 0
    ret 74
  end
  if not ok
    ret 65
  end
  if eq argcnt 50
    for i ulong 48
      source = dcOpenArg add i 2
      if lt source 0
        ret 66
      end
      if ne fseek source 0 2 long dsFileBytes add i 1
        ret 65
      end
      put dcFD i long source
    end
    arena = mapnew -1 0 get dcTotals 0 3 33
    if le arena 0
      ret 74
    end
    if not dcPopulate arena
      ret 74
    end
    if ne mapdrop arena 0
      ret 74
    end
    for i ulong 48
      if ne fclose int get dcFD i 0
        ret 74
      end
    end
  end
  record = new uchar 24 0
  for i ulong 3
    diPut record mul i 8 8 get dcTotals i
  end
  if ne write 1 record 0 24 24
    ret 74
  end
  ret 0
end

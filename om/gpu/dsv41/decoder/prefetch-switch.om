note SPDX-License-Identifier: AGPL-3.0-only
note Arboris prefetch switch for dsv41-decode A/B runs.
note DSV41_ARBORIS_PREFETCH unset or "1" keeps the prefetcher on (the default), "0" turns it off,
note and any other value, a repeated entry, or an environment entry the decoder cannot inspect is
note refused with one stderr line, so a typo cannot silently run the wrong arm.
note The read buffer is 2097152 bytes: Linux MAX_ARG_STRLEN is 32 pages per execve string including
note its terminating zero, which is 128 KiB on 4 KiB-page kernels (the Spark) and 2 MiB on 64 KiB-page
note kernels, so every entry a process can receive fits on either.

text dpsKey "DSV41_ARBORIS_PREFETCH="
text dpsBadMsg "dsv41-decode: DSV41_ARBORIS_PREFETCH must be unset, 0 or 1\n"

global dpsBuf uchar 2097152

fn dpsKeyAt n ulong to bool
  kl = len dpsKey
  if lt n kl
    ret false
  end
  for i ulong kl
    if ne get dpsBuf i get dpsKey i
      ret false
    end
  end
  ret true
end

note dpsSetting returns 1 (on), 0 (off) or -1 (refused; the stderr line is already written).
fn dpsSetting to long
  kl = len dpsKey
  ec = ulong envcnt
  found = long 1
  seen = false
  for i ulong ec bound 65536
    n = envread i dpsBuf 0 2097152
    if lt n 0
      r = write 2 dpsBadMsg 0 len dpsBadMsg
      ret -1
    end
    if not dpsKeyAt ulong n
      continue
    end
    if seen
      r = write 2 dpsBadMsg 0 len dpsBadMsg
      ret -1
    end
    seen = true
    c = get dpsBuf kl
    ok = eq ulong n add kl 1
    ok = and ok or eq c 48 eq c 49
    if not ok
      r = write 2 dpsBadMsg 0 len dpsBadMsg
      ret -1
    end
    if eq c 48
      found = 0
    end
  end
  ret found
end

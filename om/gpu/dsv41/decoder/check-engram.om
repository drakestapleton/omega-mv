note SPDX-License-Identifier: AGPL-3.0-only
note Print both layers' 24 row IDs at each position of a text-only control.
fn main to int
  path = new uchar 4096 0
  n = argread 1 path 0 4096
  if or ne argcnt 2 le n 0
    ret 64
  end
  fd = fopen path 0 ulong n 524288 0
  if lt fd 0
    ret 66
  end
  if not ar_claim_compute 1
    ret 75
  end
  if not dgLoad int fd
    ret 65
  end
  closed = fclose int fd
  ids = new uint 24 0
  buf = new uchar 96 0
  for pos ulong 12
    if not dgToken pos uint rem mul pos 11213 dgTokenCount
      ret 1
    end
    for i ulong 2
      if not dgRows add 1 mul i 13 ids
        ret 2
      end
      for j ulong 24
        diPut buf mul j 4 4 ulong get ids j
      end
      if ne write 1 buf 0 96 96
        ret 74
      end
    end
  end
  ar_drop_compute
  ret 0
end

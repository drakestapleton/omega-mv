note SPDX-License-Identifier: AGPL-3.0-only
note Arguments: one 264-byte row, a one-byte mutant, and its 40-byte sidecar.
fn eiOpen arg ulong to int
  path = new uchar 4096 0
  n = argread arg path 0 4096
  if le n 0
    ret -1
  end
  ret int fopen path 0 ulong n 524288 0
end

fn main to int
  if ne argcnt 4
    ret 64
  end
  good = eiOpen 1
  bad = eiOpen 2
  index = eiOpen 3
  if or lt good 0 or lt bad 0 lt index 0
    ret 66
  end
  put dfEngramCount 0 1
  put dfEngramBase 0 0
  put dfEngramBase 1 256
  if not dcValidEngramIndex index 0 1
    ret 1
  end
  if dcValidEngramIndex index 0 14
    ret 2
  end
  put dfEngramSideFD 0 index
  put dfEngramShardFD 0 good
  put ar_compute_kind 0 1
  put ar_compute_pid 0 long getpid
  raw = new uchar 6144 0
  scales = new uchar 192 0
  if not dfEngramReadOne 0 0 raw scales 0
    ret 3
  end
  put dfEngramShardFD 0 bad
  put raw 0 93
  if dfEngramReadOne 0 0 raw scales 0
    ret 4
  end
  if ne get raw 0 93
    ret 5
  end
  ret 0
end

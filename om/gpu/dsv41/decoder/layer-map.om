note SPDX-License-Identifier: AGPL-3.0-only
note Map every resident Zone 1 tensor in tensors.bin into fixed per-layer slots
note for O(1) GPU binding during the 40-layer forward pass.
const lmStride ulong 41
const lmMissing ulong 18446744073709551615
global lmGlobal ulong 3
global lmLayer ulong 1640

text lmTNorm "norm.weight"
text lmTHead "head.weight"
text lmTAttnNorm "attn_norm.weight"
text lmTFfnNorm "ffn_norm.weight"
text lmTHcAttnBase "hc_attn_base"
text lmTHcAttnFn "hc_attn_fn"
text lmTHcAttnScale "hc_attn_scale"
text lmTHcFfnBase "hc_ffn_base"
text lmTHcFfnFn "hc_ffn_fn"
text lmTHcFfnScale "hc_ffn_scale"
text lmTAttnSink "attn.attn_sink"
text lmTQNorm "attn.q_norm.weight"
text lmTKvNorm "attn.kv_norm.weight"
text lmTWqAW "attn.wq_a.weight"
text lmTWqAS "attn.wq_a.scale"
text lmTWqBW "attn.wq_b.weight"
text lmTWqBS "attn.wq_b.scale"
text lmTWkvW "attn.wkv.weight"
text lmTWkvS "attn.wkv.scale"
text lmTWoAW "attn.wo_a.weight"
text lmTWoAS "attn.wo_a.scale"
text lmTWoBW "attn.wo_b.weight"
text lmTWoBS "attn.wo_b.scale"
text lmTGateW "ffn.gate.weight"
text lmTGateB "ffn.gate.bias"
text lmTShW1W "ffn.shared_experts.w1.weight"
text lmTShW1S "ffn.shared_experts.w1.scale"
text lmTShW2W "ffn.shared_experts.w2.weight"
text lmTShW2S "ffn.shared_experts.w2.scale"
text lmTShW3W "ffn.shared_experts.w3.weight"
text lmTShW3S "ffn.shared_experts.w3.scale"
text lmTCmpNorm "attn.compressor.norm.weight"
text lmTCmpWkv "attn.compressor.wkv.weight"
text lmTCmpWgate "attn.compressor.wgate.weight"
text lmTIdxWqbW "attn.indexer.wq_b.weight"
text lmTIdxWqbS "attn.indexer.wq_b.scale"
text lmTIdxWproj "attn.indexer.weights_proj.weight"
text lmTIdxWk "attn.indexer.wk.weight"
text lmTIdxKnorm "attn.indexer.k_norm.weight"
text lmTEngWkvW "engram.wkv.weight"
text lmTEngWkvS "engram.wkv.scale"
text lmTEngQW "engram.q_weight"
text lmTEngKW "engram.k_weight"

fn lmExact row view uchar 160 pos ulong needle view uchar * to bool
  if not dcMatch row pos needle
    ret false
  end
  endp = add pos len needle
  if ge endp 160
    ret true
  end
  ret eq get row endp 0
end

fn lmSlotCore row view uchar 160 pos ulong to long
  if lmExact row pos lmTAttnNorm
    ret 0
  end
  if lmExact row pos lmTFfnNorm
    ret 1
  end
  if lmExact row pos lmTHcAttnBase
    ret 2
  end
  if lmExact row pos lmTHcAttnFn
    ret 3
  end
  if lmExact row pos lmTHcAttnScale
    ret 4
  end
  if lmExact row pos lmTHcFfnBase
    ret 5
  end
  if lmExact row pos lmTHcFfnFn
    ret 6
  end
  if lmExact row pos lmTHcFfnScale
    ret 7
  end
  if lmExact row pos lmTAttnSink
    ret 8
  end
  if lmExact row pos lmTQNorm
    ret 9
  end
  if lmExact row pos lmTKvNorm
    ret 10
  end
  if lmExact row pos lmTWqAW
    ret 11
  end
  if lmExact row pos lmTWqAS
    ret 12
  end
  if lmExact row pos lmTWqBW
    ret 13
  end
  if lmExact row pos lmTWqBS
    ret 14
  end
  if lmExact row pos lmTWkvW
    ret 15
  end
  if lmExact row pos lmTWkvS
    ret 16
  end
  if lmExact row pos lmTWoAW
    ret 17
  end
  if lmExact row pos lmTWoAS
    ret 18
  end
  if lmExact row pos lmTWoBW
    ret 19
  end
  if lmExact row pos lmTWoBS
    ret 20
  end
  ret -1
end

fn lmSlotFfn row view uchar 160 pos ulong to long
  if lmExact row pos lmTGateW
    ret 21
  end
  if lmExact row pos lmTGateB
    ret 22
  end
  if lmExact row pos lmTShW1W
    ret 23
  end
  if lmExact row pos lmTShW1S
    ret 24
  end
  if lmExact row pos lmTShW2W
    ret 25
  end
  if lmExact row pos lmTShW2S
    ret 26
  end
  if lmExact row pos lmTShW3W
    ret 27
  end
  if lmExact row pos lmTShW3S
    ret 28
  end
  if lmExact row pos lmTCmpNorm
    ret 29
  end
  if lmExact row pos lmTCmpWkv
    ret 30
  end
  if lmExact row pos lmTCmpWgate
    ret 31
  end
  if lmExact row pos lmTIdxWqbW
    ret 32
  end
  if lmExact row pos lmTIdxWqbS
    ret 33
  end
  if lmExact row pos lmTIdxWproj
    ret 34
  end
  if lmExact row pos lmTIdxWk
    ret 35
  end
  if lmExact row pos lmTIdxKnorm
    ret 36
  end
  if lmExact row pos lmTEngWkvW
    ret 37
  end
  if lmExact row pos lmTEngWkvS
    ret 38
  end
  if lmExact row pos lmTEngQW
    ret 39
  end
  if lmExact row pos lmTEngKW
    ret 40
  end
  ret -1
end

fn lmParseLayer row view uchar 160 to long
  if or ne get row 56 108 ne get row 62 46
    ret -1
  end
  val = ulong 0
  pos = ulong 63
  digits = ulong 0
  while and ge get row pos 48 le get row pos 57
    val = add mul val 10 sub ulong get row pos 48
    pos = add pos 1
    digits = add digits 1
  end
  if or eq digits 0 or ge val 40 ne get row pos 46
    ret -1
  end
  ret long val
end

fn lmSuffixPos row view uchar 160 to ulong
  pos = ulong 63
  while and ge get row pos 48 le get row pos 57
    pos = add pos 1
  end
  ret add pos 1
end

fn lmIndex fd int to bool
  row = new uchar 160 0
  for i ulong 3
    put lmGlobal i lmMissing
  end
  for i ulong 1640
    put lmLayer i lmMissing
  end
  for i ulong 96085
    if ne get dcLength i 0
      if not diRead fd row mul i 160 160
        ret false
      end
      off = get dcOffset i
      if lmExact row 56 dcEmbedding
        put lmGlobal 0 off
      end
      if lmExact row 56 lmTNorm
        put lmGlobal 1 off
      end
      if lmExact row 56 lmTHead
        put lmGlobal 2 off
      end
      layer = lmParseLayer row
      if ge layer 0
        spos = lmSuffixPos row
        slot = lmSlotCore row spos
        if lt slot 0
          slot = lmSlotFfn row spos
        end
        if ge slot 0
          put lmLayer add mul ulong layer lmStride ulong slot off
        end
      end
    end
  end
  for i ulong 3
    if eq get lmGlobal i lmMissing
      ret false
    end
  end
  for l ulong 40
    for s ulong 29
      if eq get lmLayer add mul l lmStride s lmMissing
        ret false
      end
    end
  end
  ret true
end

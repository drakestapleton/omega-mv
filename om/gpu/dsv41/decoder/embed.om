note SPDX-License-Identifier: AGPL-3.0-only
note Text ingress for V4.1 Flash. Open verified shard 02 once. For every
note input token read its BF16 row and emit the four initial residual streams
note and identity pre-mix in the decoder's frame representation.
text dsEmbedName "embed.weight"
global dsEmbedOffset ulong 1

fn dsEmbedDescriptor dsSource view uchar 65536 dsTape view uint 4096 obj ulong payload ulong to bool
  if eq obj jsnone
    ret false
  end
  dtype = stMember dsSource dsTape obj dtypeName
  if ne js_type dsTape dtype jsstr
    ret false
  end
  if not js_streq dsSource js_off dsTape dtype bfName
    ret false
  end
  shape = stMember dsSource dsTape obj shapeName
  if or ne js_type dsTape shape jsarr ne js_nkids dsTape shape 2
    ret false
  end
  item = js_first dsTape shape
  if or ne stUInt dsSource dsTape item 129280 ne stUInt dsSource dsTape js_enext dsTape item 5120
    ret false
  end
  ret dsEmbedExtents dsSource dsTape obj payload
end

fn dsEmbedExtents dsSource view uchar 65536 dsTape view uint 4096 obj ulong payload ulong to bool
  offsets = stMember dsSource dsTape obj offsetsName
  if or ne js_type dsTape offsets jsarr ne js_nkids dsTape offsets 2
    ret false
  end
  item = js_first dsTape offsets
  begin = stUInt dsSource dsTape item
  stop = stUInt dsSource dsTape js_enext dsTape item
  if or gt begin stop or gt stop payload ne sub stop begin 1323827200
    ret false
  end
  put dsEmbedOffset 0 begin
  ret true
end

fn dsOpenEmbed fd int to bool
  size = fseek fd 0 2
  if ne size 1323858272
    ret false
  end
  prefix = new uchar 8 0
  if not fileAt fd prefix 8 0
    ret false
  end
  n = ulong 0
  for j ulong 8
    n = or n shl ulong get prefix j mul j 8
  end
  if ne n 344
    ret false
  end
  dsSource = new uchar 65536 0
  dsTape = new uint 4096 0
  if not fileAt fd dsSource n 8
    ret false
  end
  if ne js_init dsTape n 64 0
    ret false
  end
  if lt js_parse dsSource dsTape n 0
    ret false
  end
  if not dsEmbedDescriptor dsSource dsTape stMember dsSource dsTape 0 dsEmbedName sub ulong size add 8 n
    ret false
  end
  put dsEmbedOffset 0 add get dsEmbedOffset 0 add 8 n
  ret true
end

fn dsInitResidual fd int token uint frame edit uchar 40976 to bool
  if ge token 129280
    ret false
  end
  if not fileAt fd frame 10240 add get dsEmbedOffset 0 mul ulong token 10240
    ret false
  end
  for stream ulong 3
    for i ulong 10240
      put frame add mul add stream 1 10240 i get frame i
    end
  end
  for i ulong 16
    put frame add 40960 i 0
  end
  put frame 40962 128
  put frame 40963 63
  ret true
end

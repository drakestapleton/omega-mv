note SPDX-License-Identifier: AGPL-3.0-only
note Native 40-layer DeepSeek-V4.1-Flash forward pass in pure seeded OM-2.
note Executes attention, hyper-connections, Engram, router, shared expert,
note offloaded routed experts through slab_arena.om, and final LM head.

global dfSidecarFD int 40
global dfShardFD int 40
global dfEngramShardFD int 2
global dfEngramSideFD int 2
global dfEngramBase ulong 4
global dfEngramCount ulong 2
global dfResIn ulong 1
global dfResOut ulong 1
global dfPreMix ulong 1
global dfCompLen ulong 1
global dfActiveKvLayer ulong 1
global dfActiveTopK ulong 1
global dfCurIds uint 6
global dfCurWeights uint 6
global dfCurSlots long 6
global dfCoord ulong 3
global dfStats ulong 6
global dfSlotOf long 15360
global dfSlotKey long 4800
global dfSlabCfg ulong 5
global dfPhysical ulong 4800
global dfLruPrev long 4800
global dfLruNext long 4800
const dfSpecN ulong 3
const dfSpecRowBytes ulong 7864320
global dfSpecIds uint 18
global dfSpecHist uint 720
global dfSpecStat ulong 6
global dfArbPfMeta ulong 5
global dfPfStat ulong 5
global dfPfReq int 6
global dfPfRep int 6
global dfPfPid long 6
global dfPfBusy long 6
global dfPfActive ulong 1
global dfPfStage long 1
global dfPfSlotKey long 64
global dfPfSlotState uchar 64
global dfPfSlotSeq ulong 64
global dfPfOfKey uchar 15360
global dfPfPoll uchar 8
const dfPfSlots ulong 64
note dfStats: 0=hits, 1=misses, 2=nvme_ns, 3=gpu_ns, 4=engram_ns, 5=tokens
note dfSlabCfg: 0=totalSlots, 1=lruTail, 2=recordTrace, 3=unpublished physical slot, 4=lruHead
note Look-ahead routing (prefetch on only). In the batch that routes layer L, the routers of dfSpecN
note later layers are also applied to layer L's FFN input, which is already on the GPU. Their top-6
note picks are guesses for those layers and feed the prefetch workers. The guesses never reach the
note model's arithmetic: routing, weights and outputs come from the true router of each layer.
note dfSpecIds: this step's guesses, 6 per depth index, 0xffffffff when the layer does not exist.
note dfSpecHist: [depth index][target layer][6], the guess made for that layer in this token.
note dfSpecStat: per depth index, guesses compared and guesses that the true router confirmed.
note dfArbPfMeta: 0=prefetches in flight, 1=prefetches the decoder had to wait for, 2=prefetched experts
note used (pf_hits), 3=prefetches dispatched, 4=pfEnabled
note dfPfStat: 0=staged experts dropped unused, 1=prefetches that failed verification or lost their
note worker, 2=nanoseconds spent waiting for an in-flight prefetch, 3=guesses skipped because no prefetch
note worker was idle, 4=dispatch sequence number
note dfPfBusy: per prefetch worker, the staging slot it is filling, -1 idle, -2 gone
note Staging: dfPfSlots payload-sized slots of shared anonymous memory, created before the prefetch
note workers fork. A prefetch worker reads one expert payload into its slot and checks the digest of
note exactly those bytes. dfPfSlotState: 0 free, 1 in flight, 2 verified. dfPfOfKey: staging slot + 1
note of a (layer, expert) key, 0 when the key is not staged. The decoder never waits for a prefetch it
note does not need: replies are collected with a zero-interval poll.

fn dfMonoNs to ulong
  ret ulong monons
end

fn dfSlot layer ulong slot ulong to ulong
  ret get lmLayer add mul layer lmStride slot
end

fn dfRatio layer ulong to ulong
  if or lt layer 2 ge layer 37
    ret 0
  end
  if lt layer 20
    ret 2
  end
  ret 1
end

fn dfIsKvSource layer ulong to bool
  ret or or eq layer 2 eq layer 8 or eq layer 14 eq layer 20
end

fn dfIsIndexSource layer ulong to bool
  if dfIsKvSource layer
    ret true
  end
  ret or or eq layer 24 eq layer 28 or eq layer 32 eq layer 36
end

fn dfSubmit to bool
  t0 = dfMonoNs
  ok = gbbsubmit 30000000000
  t1 = dfMonoNs
  put dfStats 3 add get dfStats 3 sub t1 t0
  ret ok
end

fn dfHcMix resOff ulong layer ulong isFfn bool to bool
  fnOff = dfSlot layer 3
  scaleOff = dfSlot layer 4
  baseOff = dfSlot layer 2
  preOff = wsAttnPre
  postOff = wsAttnPost
  combOff = wsAttnComb
  if isFfn
    fnOff = dfSlot layer 6
    scaleOff = dfSlot layer 7
    baseOff = dfSlot layer 5
    preOff = wsFfnPre
    postOff = wsFfnPost
    combOff = wsFfnComb
  end
  if not dwBind 3 resOff 81920
    ret false
  end
  if not dwBind 3 wsStat 4
    ret false
  end
  headArg 20480
  if not dnRecord 30 1 1 1 32
    ret false
  end
  if not dwDense resOff 0 fnOff wsRaw24 20480 24
    ret false
  end
  if not dwBind 3 wsRaw24 96
    ret false
  end
  if not dwBind 3 wsOnes 96
    ret false
  end
  if not dwBind 3 wsStat 4
    ret false
  end
  if not dwBind 3 wsRaw24 96
    ret false
  end
  headArg 24
  if not dnRecord 13 1 1 1 128
    ret false
  end
  if not dwBind 3 wsRaw24 96
    ret false
  end
  if not dwBind 0 scaleOff 12
    ret false
  end
  if not dwBind 0 baseOff 96
    ret false
  end
  if not dwBind 3 preOff 16
    ret false
  end
  if not dwBind 3 postOff 16
    ret false
  end
  if not dwBind 3 combOff 64
    ret false
  end
  ret dnRecord 2 1 1 1 1
end

fn dfHcPre resOff ulong preOff ulong dstOff ulong to bool
  if not dwBind 3 resOff 81920
    ret false
  end
  if not dwBind 3 preOff 16
    ret false
  end
  if not dwBind 3 dstOff 20480
    ret false
  end
  if not dnRecord 0 40 1 1 128
    ret false
  end
  ret dwRoundBf16 dstOff 5120
end

fn dfHcPost subOff ulong resOff ulong postOff ulong combOff ulong dstOff ulong to bool
  if not dwBind 3 subOff 20480
    ret false
  end
  if not dwBind 3 resOff 81920
    ret false
  end
  if not dwBind 3 postOff 16
    ret false
  end
  if not dwBind 3 combOff 64
    ret false
  end
  if not dwBind 3 dstOff 81920
    ret false
  end
  if not dnRecord 1 40 1 1 128
    ret false
  end
  ret dwRoundBf16 dstOff 20480
end

fn dfRotary bufOff ulong ropeOff ulong d ulong h ulong signBits uint to bool
  if not dwBind 3 bufOff mul mul h d 4
    ret false
  end
  if not dwBind 3 ropeOff 256
    ret false
  end
  headArg uint d
  headArg uint h
  headArg signBits
  ret dnRecord 14 uint h 1 1 32
end

fn dfEmbedToken token uint pos ulong to bool
  scr = get dwMaps 3
  iom = get dwMaps 4
  if ne mapset iom ioToken 4 ulong token 0
    ret false
  end
  if ne mapset scr wsPosBuf 4 pos 0
    ret false
  end
  pm = new uchar 16 0
  put pm 2 128
  put pm 3 63
  if ne mapwrite scr wsPreMix pm 0 16 16
    ret false
  end
  put dfResIn 0 wsResA
  put dfResOut 0 wsResB
  put dfPreMix 0 wsPreMix
  put frameDirty 0 1
  if not gbbegin 1
    ret false
  end
  if not dwBind 4 ioToken 4
    ret false
  end
  if not dwBind 0 get lmGlobal 0 1323827200
    ret false
  end
  if not dwBind 3 wsResA 81920
    ret false
  end
  headArg 0
  headArg 129280
  if not dnRecord 25 40 1 1 128
    ret false
  end
  ret dfSubmit
end

fn dfEngramReadOne which ulong rid ulong raw edit uchar 6144 scs edit uchar 192 idx ulong to bool
  if ge rid get dfEngramCount which
    ret false
  end
  row = new uchar 264 0
  header = new uchar 32 0
  diPut header 8 8 get dfEngramCount which
  diPut header 16 8 get dfEngramBase mul which 2
  diPut header 24 8 get dfEngramBase add mul which 2 1
  if not dgReadRow get dfEngramShardFD which get dfEngramSideFD which header uint rid row
    ret false
  end
  for i ulong 256
    put raw add mul idx 256 i get row i
  end
  for i ulong 8
    put scs add mul idx 8 i get row add 256 i
  end
  ret true
end

fn dfEngramCpu layer ulong to bool
  t0 = dfMonoNs
  ids = new uint 24 0
  if not dgRows layer ids
    ret false
  end
  which = ulong 0
  if eq layer 14
    which = 1
  end
  raw = new uchar 6144 0
  scs = new uchar 192 0
  lids = new uchar 96 0
  for i ulong 24
    if not dfEngramReadOne which ulong get ids i raw scs i
      ret false
    end
    diPut lids mul i 4 4 i
  end
  if ne mapwrite get dwMaps 4 ioEngramRaw raw 0 6144 6144
    ret false
  end
  if ne mapwrite get dwMaps 4 ioEngramScales scs 0 192 192
    ret false
  end
  if ne mapwrite get dwMaps 4 ioEngramIds lids 0 96 96
    ret false
  end
  t1 = dfMonoNs
  put dfStats 4 add get dfStats 4 sub t1 t0
  ret true
end

fn dfEngramGpu layer ulong to bool
  gainOff = wsEngramGain1
  if eq layer 14
    gainOff = wsEngramGain14
  end
  res = get dfResIn 0
  put frameDirty 0 1
  if not gbbegin 7
    ret false
  end
  if not dwBind 4 ioEngramIds 96
    ret false
  end
  if not dwBind 4 ioEngramRaw 6144
    ret false
  end
  if not dwBind 4 ioEngramScales 192
    ret false
  end
  if not dwBind 3 wsLut 1088
    ret false
  end
  if not dwBind 3 wsEngramRows 24576
    ret false
  end
  headArg 0
  headArg 24
  if not dnRecord 17 24 1 1 256
    ret false
  end
  if not dwRoundBf16 wsEngramRows 6144
    ret false
  end
  if not dwQuantFp8 wsEngramRows 6144
    ret false
  end
  if not dwFp8Gemm 0 dfSlot layer 37 dfSlot layer 38 wsEngramKV 6144 25600
    ret false
  end
  if not dwBind 3 res 81920
    ret false
  end
  if not dwBind 3 wsEngramKV 81920
    ret false
  end
  if not dwBind 3 gainOff 81920
    ret false
  end
  if not dwBind 3 wsEngramValid 4
    ret false
  end
  if not dwBind 3 wsEngramGate 16
    ret false
  end
  if not dnRecord 23 4 1 1 1
    ret false
  end
  if not dwBind 3 res 81920
    ret false
  end
  if not dwBind 3 add wsEngramKV 81920 20480
    ret false
  end
  if not dwBind 3 wsEngramGate 16
    ret false
  end
  if not dwBind 3 res 81920
    ret false
  end
  if not dnRecord 24 40 4 1 128
    ret false
  end
  ret dfSubmit
end

fn dfAttnPre layer ulong pos ulong to bool
  res = get dfResIn 0
  ropeBase = wsRopeBase
  if ne dfRatio layer 0
    ropeBase = wsRopeComp
  end
  ropeOff = add ropeBase mul pos 256
  if not gbbegin 40
    ret false
  end
  if not dfHcMix res layer false
    ret false
  end
  if not dfHcPre res get dfPreMix 0 wsX
    ret false
  end
  if not dwRmsNorm wsX dfSlot layer 0 wsXNorm 5120
    ret false
  end
  if not dwQuantFp8 wsXNorm 5120
    ret false
  end
  if not dwFp8Gemm 0 dfSlot layer 11 dfSlot layer 12 wsQr 5120 1280
    ret false
  end
  if not dwRoundBf16 wsQr 1280
    ret false
  end
  if not dwRmsNorm wsQr dfSlot layer 9 wsQr 1280
    ret false
  end
  if not dwQuantFp8 wsQr 1280
    ret false
  end
  if not dwFp8Gemm 0 dfSlot layer 13 dfSlot layer 14 wsQ 1280 32768
    ret false
  end
  if not dwRoundBf16 wsQ 32768
    ret false
  end
  if not dfRotary wsQ ropeOff 512 64 0x3f800000
    ret false
  end
  if not dwRoundBf16 wsQ 32768
    ret false
  end
  if not dwQuantFp8 wsXNorm 5120
    ret false
  end
  if not dwFp8Gemm 0 dfSlot layer 15 dfSlot layer 16 wsKv 5120 512
    ret false
  end
  if not dwRoundBf16 wsKv 512
    ret false
  end
  if not dwRmsNorm wsKv dfSlot layer 10 wsKv 512
    ret false
  end
  if not dfRotary wsKv ropeOff 512 1 0x3f800000
    ret false
  end
  if not dwQuantFp8 wsKv 512
    ret false
  end
  if not dwBind 3 wsRecon 2048
    ret false
  end
  if not dwBind 3 wsPosBuf 4
    ret false
  end
  if not dwBind 1 get dkWindow layer 262144
    ret false
  end
  if not dwBind 3 wsIdxBuf 512
    ret false
  end
  if not dnRecord 27 4 1 1 128
    ret false
  end
  ret dfSubmit
end

fn dfCompressKvSource layer ulong pos ulong to bool
  ratio = dfRatio layer
  if eq ratio 1
    if not gbbegin 7
      ret false
    end
    if not dwBf16Unpack 0 dfSlot layer 30 3 wsUnpack 2621440
      ret false
    end
    if not dwDense wsXNorm 3 wsUnpack wsCompOut 5120 512
      ret false
    end
    if not dwRmsNorm wsCompOut dfSlot layer 29 wsCompOut 512
      ret false
    end
    ret dfSubmit
  end
  slot = rem pos 2
  stOff = get dkState layer
  kvSlotOff = add stOff mul slot 2048
  scSlotOff = add add stOff 4096 mul slot 2048
  if not gbbegin 4
    ret false
  end
  if not dwBf16Unpack 0 dfSlot layer 30 3 wsUnpack 2621440
    ret false
  end
  if not dwDense wsXNorm 3 wsUnpack wsCompOut 5120 512
    ret false
  end
  if not dwBf16Unpack 0 dfSlot layer 31 3 wsUnpack 2621440
    ret false
  end
  if not dwDense wsXNorm 3 wsUnpack wsKv 5120 512
    ret false
  end
  if not dfSubmit
    ret false
  end
  tmp = new uchar 2048 0
  if ne mapread get dwMaps 3 wsCompOut tmp 0 2048 2048
    ret false
  end
  if ne mapwrite get dwMaps 1 kvSlotOff tmp 0 2048 2048
    ret false
  end
  if ne mapread get dwMaps 3 wsKv tmp 0 2048 2048
    ret false
  end
  if ne mapwrite get dwMaps 1 scSlotOff tmp 0 2048 2048
    ret false
  end
  if ne rem add pos 1 2 0
    ret true
  end
  put frameDirty 0 1
  if not gbbegin 8
    ret false
  end
  if not dwBind 1 stOff 4096
    ret false
  end
  if not dwBind 1 add stOff 4096 4096
    ret false
  end
  if not dwBind 3 wsCompOut 2048
    ret false
  end
  if not dnRecord 15 4 1 1 128
    ret false
  end
  if not dwRoundBf16 wsCompOut 512
    ret false
  end
  if not dwRmsNorm wsCompOut dfSlot layer 29 wsCompOut 512
    ret false
  end
  ret dfSubmit
end

fn dfUpdateIndexK layer ulong pos ulong to bool
  kbuf = new uchar 512 0
  ratio = dfRatio layer
  gpos = sub add pos 1 ratio
  gslot = div pos ratio
  if not gbbegin 9
    ret false
  end
  if not dwBf16Unpack 0 dfSlot layer 35 3 wsUnpack 65536
    ret false
  end
  if not dwDense wsCompOut 3 wsUnpack wsCompK 512 128
    ret false
  end
  if not dwRmsNorm wsCompK dfSlot layer 36 wsCompK 128
    ret false
  end
  if not dfRotary wsCompK add wsRopeComp mul gpos 256 128 1 0x3f800000
    ret false
  end
  if not dwQuantFp4 wsCompK 128
    ret false
  end
  if not dfSubmit
    ret false
  end
  if ne mapread get dwMaps 3 wsRecon kbuf 0 512 512
    ret false
  end
  dest = add get dkIndex layer mul gslot 512
  ret eq mapwrite get dwMaps 1 dest kbuf 0 512 512
end

fn dfCandidateBlocksBody clen ulong nblocks ulong to bool
  if not dwBind 3 wsIdxScores mul clen 4
    ret false
  end
  if not dwBind 3 wsIdxLens 4
    ret false
  end
  if not dwBind 3 wsCandBlocks mul nblocks 4
    ret false
  end
  headArg uint clen
  if not dnRecord 21 uint nblocks 1 1 1
    ret false
  end
  cbK = nblocks
  if gt cbK 2048
    cbK = 2048
  end
  if not dwBind 3 wsCandBlocks mul nblocks 4
    ret false
  end
  if not dwBind 3 wsCandIds mul cbK 4
    ret false
  end
  if not dwBind 3 wsCandKeep mul nblocks 4
    ret false
  end
  headArg uint nblocks
  headArg uint cbK
  headArg 0
  ret dnRecord 22 1 1 1 1
end

fn dfRunIndexer layer ulong pos ulong clen ulong latentReady bool to bool
  ones = new uchar 10240 0
  if and dfIsKvSource layer latentReady
    if not dfUpdateIndexK layer pos
      ret false
    end
  end
  if ne mapset get dwMaps 3 wsIdxLens 4 clen 0
    ret false
  end
  nblocks = div add clen 7 8
  if le layer 20
    for b ulong nblocks
      diPut ones mul b 4 4 1
    end
    if ne mapwrite get dwMaps 3 wsCandKeep ones 0 mul nblocks 4 long mul nblocks 4
      ret false
    end
  end
  topk = clen
  if gt topk 512
    topk = 512
  end
  put dfActiveTopK 0 topk
  if ne mapset get dwMaps 3 wsStat 4 ulong bitcast uint 0.015625f32 0
    ret false
  end
  put frameDirty 0 1
  idxBatch = ulong 11
  if eq layer 20
    idxBatch = ulong 13
  end
  if not gbbegin idxBatch
    ret false
  end
  if not dwQuantFp8 wsQr 1280
    ret false
  end
  if not dwFp8Gemm 0 dfSlot layer 32 dfSlot layer 33 wsIdxQ 1280 4096
    ret false
  end
  if not dfRotary wsIdxQ add wsRopeComp mul pos 256 128 32 0x3f800000
    ret false
  end
  if not dwQuantFp4 wsIdxQ 4096
    ret false
  end
  if not dwBf16Unpack 0 dfSlot layer 34 3 wsUnpack 163840
    ret false
  end
  if not dwDense wsXNorm 3 wsUnpack wsIdxW 5120 32
    ret false
  end
  if not dwBind 3 wsIdxW 128
    ret false
  end
  if not dwBind 3 wsOnes 128
    ret false
  end
  if not dwBind 3 wsStat 4
    ret false
  end
  if not dwBind 3 wsIdxW 128
    ret false
  end
  headArg 32
  if not dnRecord 13 1 1 1 128
    ret false
  end
  if not dwRoundBf16 wsIdxW 32
    ret false
  end
  if not dwBind 3 wsRecon 16384
    ret false
  end
  if not dwBind 1 get dkIndex get dfActiveKvLayer 0 mul clen 512
    ret false
  end
  if not dwBind 3 wsIdxW 128
    ret false
  end
  if not dwBind 3 wsIdxLens 4
    ret false
  end
  if not dwBind 3 wsCandKeep mul nblocks 4
    ret false
  end
  if not dwBind 3 wsIdxScores mul clen 4
    ret false
  end
  headArg 32
  headArg uint clen
  if not dnRecord 20 uint div add clen 127 128 1 1 128
    ret false
  end
  if not dwBind 3 wsIdxScores mul clen 4
    ret false
  end
  if not dwBind 3 add wsIdxBuf 512 mul topk 4
    ret false
  end
  if not dwBind 3 wsTopMask mul clen 4
    ret false
  end
  headArg uint clen
  headArg uint topk
  headArg 128
  if not dnRecord 22 1 1 1 1
    ret false
  end
  if eq layer 20
    if not dfCandidateBlocksBody clen nblocks
      ret false
    end
  end
  ret dfSubmit
end

fn dfStoreCompressedKv layer ulong pos ulong to bool
  ratio = dfRatio layer
  gpos = sub add pos 1 ratio
  gslot = div pos ratio
  if not gbbegin 2
    ret false
  end
  if not dfRotary wsCompOut add wsRopeComp mul gpos 256 512 1 0x3f800000
    ret false
  end
  if not dwQuantKv wsCompOut 512
    ret false
  end
  if not dfSubmit
    ret false
  end
  vbuf = new uchar 2048 0
  if ne mapread get dwMaps 3 wsRecon vbuf 0 2048 2048
    ret false
  end
  ret eq mapwrite get dwMaps 1 add get dkLatent layer mul gslot 2048 vbuf 0 2048 2048
end

fn dfCopyRegion srcMap long srcOff ulong dstMap long dstOff ulong bytes ulong to bool
  buf = new uchar 65536 0
  pos = ulong 0
  while lt pos bytes
    n = sub bytes pos
    if gt n len buf
      n = len buf
    end
    if ne mapread srcMap add srcOff pos buf 0 n long n
      ret false
    end
    if ne mapwrite dstMap add dstOff pos buf 0 n long n
      ret false
    end
    pos = add pos n
  end
  ret true
end

fn dfPrepareCompressedKv layer ulong pos ulong to long
  ratio = dfRatio layer
  clen = div add pos 1 ratio
  latentReady = false
  if dfIsKvSource layer
    put dfActiveKvLayer 0 layer
    if not dfCompressKvSource layer pos
      ret -1
    end
    latentReady = eq rem add pos 1 ratio 0
  end
  if and dfIsIndexSource layer gt clen 0
    if not dfRunIndexer layer pos clen latentReady
      ret -1
    end
  end
  if eq clen 0
    put dfActiveTopK 0 0
  end
  if and dfIsKvSource layer latentReady
    if not dfStoreCompressedKv layer pos
      ret -1
    end
  end
  if gt clen 0
    if not dfCopyRegion get dwMaps 1 get dkWindow layer get dwMaps 3 wsKvConcat 262144
      ret -1
    end
    latOff = get dkLatent get dfActiveKvLayer 0
    if not dfCopyRegion get dwMaps 1 latOff get dwMaps 3 add wsKvConcat 262144 mul clen 2048
      ret -1
    end
    put frameDirty 0 1
  end
  ret long clen
end

fn dfAttnOutProj layer ulong to bool
  woaW = dfSlot layer 17
  woaS = dfSlot layer 18
  for g ulong 8
    if not dwQuantFp8 add wsAttnOut mul g 16384 4096
      ret false
    end
    wOff = add woaW mul g 4194304
    sOff = add woaS mul g 4096
    dOff = add wsWoAOut mul g 4096
    if not dwFp8Gemm 0 wOff sOff dOff 4096 1024
      ret false
    end
    if not dwRoundBf16 dOff 1024
      ret false
    end
  end
  if not dwQuantFp8 wsWoAOut 8192
    ret false
  end
  if not dwFp8Gemm 0 dfSlot layer 19 dfSlot layer 20 wsSubOut 8192 5120
    ret false
  end
  if not dwRoundBf16 wsSubOut 5120
    ret false
  end
  ret dfHcPost wsSubOut get dfResIn 0 wsAttnPost wsAttnComb get dfResOut 0
end

fn dfAttnPost layer ulong pos ulong to bool
  ratio = dfRatio layer
  kvIdx = ulong 1
  kvOff = get dkWindow layer
  tLen = ulong 128
  sLen = ulong 128
  if ne ratio 0
    clen = dfPrepareCompressedKv layer pos
    if lt clen 0
      ret false
    end
    if gt clen 0
      kvIdx = 3
      kvOff = wsKvConcat
      tLen = add 128 ulong clen
      sLen = add 128 get dfActiveTopK 0
    end
  end
  ropeBase = wsRopeBase
  if ne ratio 0
    ropeBase = wsRopeComp
  end
  ropeOff = add ropeBase mul pos 256
  if not gbbegin add 69 dfSpecRecords layer
    ret false
  end
  if not dwBind 3 wsQ 131072
    ret false
  end
  if not dwBind kvIdx kvOff mul tLen 2048
    ret false
  end
  if not dwBind 3 wsIdxBuf mul sLen 4
    ret false
  end
  if not dwBind 3 wsScores mul mul 64 sLen 4
    ret false
  end
  headArg 64
  headArg uint tLen
  headArg uint sLen
  if not dnRecord 6 uint sLen 64 1 1
    ret false
  end
  if not dwBind 3 wsScores mul mul 64 sLen 4
    ret false
  end
  if not dwBind kvIdx kvOff mul tLen 2048
    ret false
  end
  if not dwBind 3 wsIdxBuf mul sLen 4
    ret false
  end
  if not dwBind 0 dfSlot layer 8 256
    ret false
  end
  if not dwBind 3 wsAttnOut 131072
    ret false
  end
  headArg 64
  headArg uint tLen
  headArg uint sLen
  if not dnRecord 7 4 64 1 128
    ret false
  end
  if not dfRotary wsAttnOut ropeOff 512 64 0xbf800000
    ret false
  end
  if not dwRoundBf16 wsAttnOut 32768
    ret false
  end
  if not dfAttnOutProj layer
    ret false
  end
  if not dfFfnPreRouteBody layer
    ret false
  end
  if not dfSpecRouteBody layer
    ret false
  end
  ret dfSubmit
end

fn dfFfnPreRouteBody layer ulong to bool
  res = get dfResOut 0
  if not dfHcMix res layer true
    ret false
  end
  if not dfHcPre res wsAttnPre wsX
    ret false
  end
  if not dwRmsNorm wsX dfSlot layer 1 wsXNorm 5120
    ret false
  end
  if not dwBf16Unpack 0 dfSlot layer 21 3 wsUnpack 1966080
    ret false
  end
  if not dwDense wsXNorm 3 wsUnpack wsGateLogits 5120 384
    ret false
  end
  if not dwBind 3 wsGateLogits 1536
    ret false
  end
  if not dwBind 0 dfSlot layer 22 1536
    ret false
  end
  if not dwBind 4 ioExpIds 24
    ret false
  end
  if not dwBind 4 ioExpWeights 24
    ret false
  end
  if not dnRecord 16 1 1 1 1
    ret false
  end
  if not dwQuantFp8 wsXNorm 5120
    ret false
  end
  if not dwFp8Gemm 0 dfSlot layer 23 dfSlot layer 24 wsExpGate 5120 2304
    ret false
  end
  if not dwFp8Gemm 0 dfSlot layer 27 dfSlot layer 28 wsExpUp 5120 2304
    ret false
  end
  if not dwBind 3 wsExpGate 9216
    ret false
  end
  if not dwBind 3 wsExpUp 9216
    ret false
  end
  if not dwBind 3 wsOnes 4
    ret false
  end
  if not dwBind 3 wsExpAct 9216
    ret false
  end
  if not dnRecord 3 18 1 1 128
    ret false
  end
  if not dwRoundBf16 wsExpAct 2304
    ret false
  end
  if not dwQuantFp8 wsExpAct 2304
    ret false
  end
  if not dwFp8Gemm 0 dfSlot layer 25 dfSlot layer 26 wsSharedOut 2304 5120
    ret false
  end
  if not dwRoundBf16 wsSharedOut 5120
    ret false
  end
  ret true
end

fn dfInitSlabMap nSlots ulong to void
  for i ulong 15360
    put dfSlotOf i -1
  end
  for i ulong 4800
    put dfSlotKey i -1
    put dfPhysical i i
    put dfLruPrev i -1
    put dfLruNext i -1
  end
  note Link nSlots-1 (MRU head) -> ... -> 0 (LRU tail) so initial fills take 0,1,2...
  for i ulong nSlots bound 4800
    if gt i 0
      put dfLruNext i sub long i 1
    end
    if lt add i 1 nSlots
      put dfLruPrev i add long i 1
    end
  end
  put dfSlabCfg 0 nSlots
  put dfSlabCfg 1 0
  put dfSlabCfg 2 1
  if gt nSlots 3200
    put dfSlabCfg 3 4800
  else
    put dfSlabCfg 3 3200
  end
  put dfSlabCfg 4 sub nSlots 1
end

fn dfLruTouch slot ulong to void
  head = get dfSlabCfg 4
  if eq slot head
    ret
  end
  prev = get dfLruPrev slot
  nxt = get dfLruNext slot
  if ge prev 0
    put dfLruNext ulong prev nxt
  end
  if ge nxt 0
    put dfLruPrev ulong nxt prev
  else
    put dfSlabCfg 1 ulong prev
  end
  put dfLruPrev slot -1
  put dfLruNext slot long head
  put dfLruPrev head long slot
  put dfSlabCfg 4 slot
end

fn dfGateNeedsKey key long layer ulong to bool
  if lt key 0
    ret false
  end
  for k ulong 6
    if eq ulong key add mul layer 384 ulong get dfCurIds k
      ret true
    end
  end
  ret false
end

fn dfPickVictim layer ulong to ulong
  cur = long get dfSlabCfg 1
  for i ulong 7
    if lt cur 0
      ret get dfSlabCfg 1
    end
    if not dfGateNeedsKey get dfSlotKey ulong cur layer
      ret ulong cur
    end
    cur = get dfLruPrev ulong cur
  end
  ret get dfSlabCfg 1
end

note The spare physical slot now holds key's verified payload: give it to logical slot `slot`, whose
note old physical slot becomes the spare.
fn dfSwapSpareIn slot ulong key ulong to long
  spare = get dfSlabCfg 3
  oldKey = get dfSlotKey slot
  if ge oldKey 0
    put dfSlotOf ulong oldKey -1
  end
  put dfSlabCfg 3 get dfPhysical slot
  put dfPhysical slot spare
  put dfSlotKey slot long key
  put dfSlotOf key long slot
  dfLruTouch slot
  ret long slot
end

fn dfLoadMiss layer ulong key ulong desc view uchar 64 to long
  if or ne ulong get desc 0 add layer 3 ne ulong get desc 1 layer
    ret -1
  end
  if ne key add mul layer 384 diGet desc 4 4
    ret -1
  end
  slot = dfPickVictim layer
  spare = get dfSlabCfg 3
  if not deVerifyAt get dfShardFD layer desc get dwSlabMaps div spare 800 mul rem spare 800 deBytes
    ret -1
  end
  ret dfSwapSpareIn slot key
end

note Load gate position k's absent expert inline: read, hash and write it into the spare slab slot.
note timed adds the load time to nvme_ns; pass false inside an interval that is already being timed.
fn dfGateDemand layer ulong k ulong timed bool to bool
  desc = new uchar 64 0
  eid = ulong get dfCurIds k
  key = add mul layer 384 eid
  if not diRead get dfSidecarFD layer desc mul eid 64 64
    ret false
  end
  tN0 = dfMonoNs
  slot = dfLoadMiss layer key desc
  if lt slot 0
    ret false
  end
  if timed
    put dfStats 2 add get dfStats 2 sub dfMonoNs tN0
  end
  put dfCurSlots k slot
  put dfStats 1 add get dfStats 1 1
  ret true
end

fn dfPublishVerified layer ulong key ulong desc view uchar 64 to long
  slot = dfPickVictim layer
  spare = get dfSlabCfg 3
  dMap = get dwSlabMaps div spare 800
  dOff = mul rem spare 800 deBytes
  if not deWriteVerifiedAt get dfShardFD layer desc dMap dOff
    ret -1
  end
  ret dfSwapSpareIn slot key
end

fn dfPipeRead fd int buf edit uchar * n ulong to bool
  pos = ulong 0
  while lt pos n
    r = read fd buf pos sub n pos
    if eq r -4
      continue
    end
    if le r 0
      ret false
    end
    pos = add pos ulong r
  end
  ret true
end

fn dfPipeWrite fd int buf view uchar * n ulong to bool
  pos = ulong 0
  while lt pos n
    r = write fd buf pos sub n pos
    if eq r -4
      continue
    end
    if le r 0
      ret false
    end
    pos = add pos ulong r
  end
  ret true
end

fn dfWorkerLoop idx ulong reqFd int repFd int to void
  req = new uchar 72 0
  desc = new uchar 64 0
  rep = new uchar 1 0
  while dfPipeRead reqFd req 72
    layer = diGet req 0 8
    for j ulong 64
      put desc j get req add 8 j
    end
    put rep 0 1
    if and lt layer 40 deVerifyOnly get dfShardFD layer desc
      put rep 0 0
    end
    if not dfPipeWrite repFd rep 1
      exit 1
    end
  end
  exit 0
end

fn dfPfWorkerLoop reqFd int repFd int to void
  req = new uchar 80 0
  desc = new uchar 64 0
  rep = new uchar 1 0
  while dfPipeRead reqFd req 80
    layer = diGet req 0 8
    slot = diGet req 72 8
    for j ulong 64
      put desc j get req add 8 j
    end
    put rep 0 1
    if and lt layer 40 lt slot dfPfSlots
      if deVerifyAt get dfShardFD layer desc get dfPfStage 0 mul slot deBytes
        put rep 0 0
      end
    end
    if not dfPipeWrite repFd rep 1
      exit 1
    end
  end
  exit 0
end

fn dfPfFree slot ulong to void
  key = get dfPfSlotKey slot
  if ge key 0
    put dfPfOfKey ulong key 0
  end
  put dfPfSlotKey slot -1
  put dfPfSlotState slot 0
end

note Read worker w's reply (blocking) and record whether its staging slot holds verified bytes.
fn dfPfFinish w ulong to void
  rep = new uchar 1 1
  slot = get dfPfBusy w
  if lt slot 0
    ret
  end
  ok = dfPipeRead get dfPfRep w rep 1
  put dfArbPfMeta 0 sub get dfArbPfMeta 0 1
  if not ok
    put dfPfBusy w -2
    dfPfFree ulong slot
    put dfPfStat 1 add get dfPfStat 1 1
    ret
  end
  put dfPfBusy w -1
  if eq get rep 0 0
    put dfPfSlotState ulong slot 2
  else
    dfPfFree ulong slot
    put dfPfStat 1 add get dfPfStat 1 1
  end
end

fn dfPfReplyReady w ulong to bool
  fd = get dfPfRep w
  put dfPfPoll 0 uchar and fd 255
  put dfPfPoll 1 uchar and shr fd 8 255
  put dfPfPoll 2 uchar and shr fd 16 255
  put dfPfPoll 3 uchar and shr fd 24 255
  put dfPfPoll 4 1
  put dfPfPoll 5 0
  put dfPfPoll 6 0
  put dfPfPoll 7 0
  ret gt pollfds dfPfPoll 0 8 0 0
end

note Collect the replies that have already arrived. Never waits.
fn dfPfHarvest to void
  n = get dfPfActive 0
  for w ulong n bound 6
    if ge get dfPfBusy w 0
      if dfPfReplyReady w
        dfPfFinish w
      end
    end
  end
end

note Staging slot assigned to key (being read or verified), or -1.
fn dfPfLookup key ulong to long
  v = ulong get dfPfOfKey key
  if eq v 0
    ret -1
  end
  ret long sub v 1
end

note True when staging slot `slot` holds key's verified payload. Waits only when that payload, which
note the decoder needs now, is still being read by a prefetch worker. timed adds the wait to nvme_ns.
fn dfPfAwait slot ulong key ulong timed bool to bool
  if eq get dfPfSlotState slot 1
    tN0 = dfMonoNs
    n = get dfPfActive 0
    for w ulong n bound 6
      if eq get dfPfBusy w long slot
        dfPfFinish w
      end
    end
    waited = sub dfMonoNs tN0
    put dfArbPfMeta 1 add get dfArbPfMeta 1 1
    put dfPfStat 2 add get dfPfStat 2 waited
    if timed
      put dfStats 2 add get dfStats 2 waited
    end
  end
  ret and eq get dfPfSlotState slot 2 eq get dfPfSlotKey slot long key
end

note Copy a verified staged payload into the spare slab slot and publish it. The bytes published are
note the bytes the worker hashed.
fn dfPfPublish layer ulong key ulong stage ulong to long
  buf = new uchar 1048576 0
  slot = dfPickVictim layer
  spare = get dfSlabCfg 3
  dMap = get dwSlabMaps div spare 800
  dOff = mul rem spare 800 deBytes
  sMap = get dfPfStage 0
  sOff = mul stage deBytes
  pos = ulong 0
  while lt pos deBytes
    n = sub deBytes pos
    if gt n len buf
      n = len buf
    end
    if ne mapread sMap add sOff pos buf 0 n long n
      ret -1
    end
    if ne mapwrite dMap add dOff pos buf 0 n long n
      ret -1
    end
    pos = add pos n
  end
  dfPfFree stage
  put dfArbPfMeta 2 add get dfArbPfMeta 2 1
  ret dfSwapSpareIn slot key
end

note A free staging slot, else the verified slot that has waited longest (its payload is dropped), else -1.
fn dfPfPickSlot to long
  best = long -1
  bestSeq = ulong 0
  for s ulong dfPfSlots
    st = get dfPfSlotState s
    if eq st 0
      ret long s
    end
    if eq st 2
      if or lt best 0 lt get dfPfSlotSeq s bestSeq
        best = long s
        bestSeq = get dfPfSlotSeq s
      end
    end
  end
  if ge best 0
    dfPfFree ulong best
    put dfPfStat 0 add get dfPfStat 0 1
  end
  ret best
end

fn dfPfIdleWorker to long
  n = get dfPfActive 0
  for w ulong n bound 6
    if eq get dfPfBusy w -1
      ret long w
    end
  end
  ret -1
end

note Ask an idle prefetch worker to stage expert eid of layer. 1 sent, 0 not sent. Never waits.
fn dfPfDispatch layer ulong eid ulong to long
  desc = new uchar 64 0
  req = new uchar 80 0
  if or ge layer 40 ge eid 384
    ret 0
  end
  key = add mul layer 384 eid
  if or ge get dfSlotOf key 0 ne get dfPfOfKey key 0
    ret 0
  end
  w = dfPfIdleWorker
  if lt w 0
    put dfPfStat 3 add get dfPfStat 3 1
    ret 0
  end
  if not diRead get dfSidecarFD layer desc mul eid 64 64
    ret 0
  end
  if or ne ulong get desc 0 add layer 3 ne ulong get desc 1 layer
    ret 0
  end
  if ne eid diGet desc 4 4
    ret 0
  end
  slot = dfPfPickSlot
  if lt slot 0
    ret 0
  end
  diPut req 0 8 layer
  for j ulong 64
    put req add 8 j get desc j
  end
  diPut req 72 8 ulong slot
  if not dfPipeWrite get dfPfReq ulong w req 80
    put dfPfBusy ulong w -2
    put dfPfStat 1 add get dfPfStat 1 1
    ret 0
  end
  seq = add get dfPfStat 4 1
  put dfPfStat 4 seq
  put dfPfBusy ulong w slot
  put dfPfSlotKey ulong slot long key
  put dfPfSlotState ulong slot 1
  put dfPfSlotSeq ulong slot seq
  put dfPfOfKey key uchar add ulong slot 1
  put dfArbPfMeta 0 add get dfArbPfMeta 0 1
  put dfArbPfMeta 3 add get dfArbPfMeta 3 1
  ret 1
end

note How many layers ahead depth index i looks.
fn dfSpecDepthAt i ulong to ulong
  ret add i 2
end

note Number of leading depth indexes whose target layer exists (0 with prefetch off).
fn dfSpecDepths layer ulong to ulong
  if eq get dfArbPfMeta 4 0
    ret 0
  end
  n = ulong 0
  for i ulong dfSpecN
    if le add layer dfSpecDepthAt i 39
      n = add n 1
    end
  end
  ret n
end

note Launches the look-ahead adds to the batch that routes `layer`.
fn dfSpecRecords layer ulong to ulong
  n = dfSpecDepths layer
  if eq n 0
    ret 0
  end
  ret add 2 mul 2 n
end

fn dfSpecMulRow wb view uchar 10240 gb view uchar 10240 ob edit uchar 20480 to void
  for j ulong 5120
    p = mul j 2
    wu = or shl uint get wb p 16 shl uint get wb add p 1 24
    gu = or shl uint get gb p 16 shl uint get gb add p 1 24
    pv = bitcast uint mul bitcast f32 wu bitcast f32 gu
    q = mul j 4
    put ob q uchar and pv 255
    put ob add q 1 uchar and shr pv 8 255
    put ob add q 2 uchar and shr pv 16 255
    put ob add q 3 uchar and shr pv 24 255
  end
end

note Table for one layer: its router matrix (384 x 5120, BF16 in zone 1) as f32, each column multiplied
note by that layer's FFN norm gain. One dense launch on the unit-RMS input then gives its router logits.
fn dfSpecFoldLayer layer ulong to bool
  wb = new uchar 10240 0
  gb = new uchar 10240 0
  ob = new uchar 20480 0
  woff = dfSlot layer 21
  goff = dfSlot layer 1
  if or eq woff lmMissing eq goff lmMissing
    ret false
  end
  if ne mapread get dwMaps 0 goff gb 0 10240 10240
    ret false
  end
  dst = mul sub layer 1 dfSpecRowBytes
  for e ulong 384
    if ne mapread get dwMaps 0 add woff mul e 10240 wb 0 10240 10240
      ret false
    end
    dfSpecMulRow wb gb ob
    if ne mapwrite get dwMaps 5 add dst mul e 20480 ob 0 20480 20480
      ret false
    end
  end
  ret true
end

note Build the look-ahead tables for layers 1 to 39. Call after zone 1 is populated, prefetch on only.
fn dfSpecInit to bool
  for i ulong 18
    put dfSpecIds i 0xffffffff
  end
  for i ulong 6
    put dfSpecStat i 0
  end
  size = mul 39 dfSpecRowBytes
  m = nvalloc size true
  if le m 0
    ret false
  end
  put dwMaps 5 m
  put dwSizes 5 size
  for layer ulong 39
    if not dfSpecFoldLayer add layer 1
      ret false
    end
  end
  ret true
end

note Record the look-ahead launches. wsX is the FFN input the true router of `layer` has just used.
fn dfSpecRouteBody layer ulong to bool
  n = dfSpecDepths layer
  if eq n 0
    ret true
  end
  if not dwBind 3 wsX 20480
    ret false
  end
  if not dwBind 3 wsSpecStat 4
    ret false
  end
  headArg 5120
  if not dnRecord 30 1 1 1 32
    ret false
  end
  if not dwBind 3 wsX 20480
    ret false
  end
  if not dwBind 3 wsOnes 20480
    ret false
  end
  if not dwBind 3 wsSpecStat 4
    ret false
  end
  if not dwBind 3 wsSpecNorm 20480
    ret false
  end
  headArg 5120
  if not dnRecord 13 40 1 1 128
    ret false
  end
  for i ulong n bound 3
    tl = add layer dfSpecDepthAt i
    if not dwDense wsSpecNorm 5 mul sub tl 1 dfSpecRowBytes wsSpecLogits 5120 384
      ret false
    end
    if not dwBind 3 wsSpecLogits 1536
      ret false
    end
    if not dwBind 0 dfSlot tl 22 1536
      ret false
    end
    if not dwBind 4 add ioSpecIds mul i 32 24
      ret false
    end
    if not dwBind 4 add ioSpecWeights mul i 32 24
      ret false
    end
    if not dnRecord 16 1 1 1 1
      ret false
    end
  end
  ret true
end

note Score the guesses made earlier in this token for `layer` against its true routing (dfCurIds).
fn dfSpecScore layer ulong to void
  for i ulong dfSpecN
    if ge layer dfSpecDepthAt i
      base = mul add mul i 40 layer 6
      right = ulong 0
      for j ulong 6
        g = get dfSpecHist add base j
        for k ulong 6
          if eq g get dfCurIds k
            right = add right 1
          end
        end
      end
      put dfSpecStat mul i 2 add get dfSpecStat mul i 2 6
      put dfSpecStat add mul i 2 1 add get dfSpecStat add mul i 2 1 right
    end
  end
end

note Read this step's guesses from the I/O map into dfSpecIds and dfSpecHist.
fn dfSpecRead layer ulong to bool
  raw = new uchar 24 0
  n = dfSpecDepths layer
  for i ulong dfSpecN
    if lt i n
      if ne mapread get dwMaps 4 add ioSpecIds mul i 32 raw 0 24 24
        ret false
      end
      base = mul add mul i 40 add layer dfSpecDepthAt i 6
      for j ulong 6
        e = uint diGet raw mul j 4 4
        if ge e 384
          e = 0xffffffff
        end
        put dfSpecIds add mul i 6 j e
        put dfSpecHist add base j e
      end
    else
      for j ulong 6
        put dfSpecIds add mul i 6 j 0xffffffff
      end
    end
  end
  ret true
end

note After a layer's experts are resolved: collect finished prefetches, then hand this step's guesses
note to idle prefetch workers, nearest layer first. Nothing here waits.
fn dfArbDispatchPrefetch layer ulong to void
  if or eq get dfArbPfMeta 4 0 eq get dfPfActive 0 0
    ret
  end
  dfPfHarvest
  for i ulong dfSpecN
    tl = add layer dfSpecDepthAt i
    if le tl 39
      for j ulong 6
        e = ulong get dfSpecIds add mul i 6 j
        if lt e 384
          sent = dfPfDispatch tl e
        end
      end
    end
  end
end

fn dfPfStop to void
  wbuf = new uchar 4 0
  n = get dfPfActive 0
  put dfPfActive 0 0
  for i ulong n bound 6
    u1 = fclose get dfPfReq i
    u2 = fclose get dfPfRep i
    u3 = waitpid int get dfPfPid i wbuf 0 4 0
  end
  if gt get dfPfStage 0 0
    u4 = mapdrop get dfPfStage 0
    put dfPfStage 0 0
  end
  put dfArbPfMeta 0 0
end

fn dfStopWorkers to void
  dfPfStop
  wbuf = new uchar 4 0
  n = get dfWrActive 0
  put dfWrActive 0 0
  for i ulong n bound 6
    u1 = fclose get dfWrReq i
    u2 = fclose get dfWrRep i
    u3 = waitpid int get dfWrPid i wbuf 0 4 0
  end
end

fn dfClosePrevWorkers w ulong to void
  for prev ulong w bound 6
    u3 = fclose get dfWrReq prev
    u4 = fclose get dfWrRep prev
  end
end

fn dfStartOneWorker w ulong to bool
  p1 = new uchar 8 0
  p2 = new uchar 8 0
  if ne pipefds p1 0 8 0 0
    ret false
  end
  if ne pipefds p2 0 8 0 0
    u1 = fclose int diGet p1 0 4
    u2 = fclose int diGet p1 4 4
    ret false
  end
  r1 = int diGet p1 0 4
  w1 = int diGet p1 4 4
  r2 = int diGet p2 0 4
  w2 = int diGet p2 4 4
  p = fork
  if lt p 0
    u1 = fclose r1
    u2 = fclose w1
    u3 = fclose r2
    u4 = fclose w2
    ret false
  end
  if eq p 0
    u1 = fclose w1
    u2 = fclose r2
    dfClosePrevWorkers w
    dfWorkerLoop w r1 w2
  end
  u1 = fclose r1
  u2 = fclose w2
  put dfWrReq w w1
  put dfWrRep w r2
  put dfWrPid w p
  put dfWrActive 0 add w 1
  ret true
end

fn dfPfClosePrev w ulong to void
  for prev ulong w bound 6
    u3 = fclose get dfPfReq prev
    u4 = fclose get dfPfRep prev
  end
end

fn dfPfStartOne w ulong to bool
  p1 = new uchar 8 0
  p2 = new uchar 8 0
  if ne pipefds p1 0 8 0 0
    ret false
  end
  if ne pipefds p2 0 8 0 0
    u1 = fclose int diGet p1 0 4
    u2 = fclose int diGet p1 4 4
    ret false
  end
  r1 = int diGet p1 0 4
  w1 = int diGet p1 4 4
  r2 = int diGet p2 0 4
  w2 = int diGet p2 4 4
  p = fork
  if lt p 0
    u1 = fclose r1
    u2 = fclose w1
    u3 = fclose r2
    u4 = fclose w2
    ret false
  end
  if eq p 0
    u1 = fclose w1
    u2 = fclose r2
    dfClosePrevWorkers get dfWrActive 0
    dfPfClosePrev w
    dfPfWorkerLoop r1 w2
  end
  u1 = fclose r1
  u2 = fclose w2
  put dfPfReq w w1
  put dfPfRep w r2
  put dfPfPid w p
  put dfPfBusy w -1
  put dfPfActive 0 add w 1
  ret true
end

note The staging memory is shared and is created before the prefetch workers fork.
fn dfPfStart to bool
  for s ulong dfPfSlots
    put dfPfSlotKey s -1
    put dfPfSlotState s 0
    put dfPfSlotSeq s 0
  end
  for i ulong 15360
    put dfPfOfKey i 0
  end
  for i ulong 5
    put dfPfStat i 0
  end
  m = mapnew -1 0 mul dfPfSlots deBytes 3 33
  if le m 0
    ret false
  end
  put dfPfStage 0 m
  for w ulong 6
    if not dfPfStartOne w
      ret false
    end
  end
  ret true
end

note dfStartWorkers starts the six payload workers and sets the Arboris prefetch switch in the same
note place (pfOn 1 = prefetch on, 0 = off), so no later step can leave the wrong arm running.
fn dfStartWorkers pfOn ulong to bool
  if gt pfOn 1
    ret false
  end
  for w ulong 6
    if not dfStartOneWorker w
      dfStopWorkers
      ret false
    end
  end
  if eq pfOn 1
    if not dfPfStart
      dfStopWorkers
      ret false
    end
  end
  put dfArbPfMeta 4 pfOn
  ret true
end

fn dfReadMissDescs layer ulong mIdx view ulong 6 mCount ulong descs edit uchar 384 to bool
  desc = new uchar 64 0
  for m ulong mCount bound 6
    k = get mIdx m
    eid = ulong get dfCurIds k
    key = add mul layer 384 eid
    if not diRead get dfSidecarFD layer desc mul eid 64 64
      ret false
    end
    if or ne ulong get desc 0 add layer 3 ne ulong get desc 1 layer
      ret false
    end
    if ne key add mul layer 384 diGet desc 4 4
      ret false
    end
    for j ulong 64
      put descs add mul m 64 j get desc j
    end
  end
  ret true
end

fn dfSendMisses layer ulong mCount ulong descs view uchar 384 to bool
  req = new uchar 72 0
  for m ulong mCount bound 6
    diPut req 0 8 layer
    base = mul m 64
    for j ulong 64
      put req add 8 j get descs add base j
    end
    if not dfPipeWrite get dfWrReq m req 72
      ret false
    end
  end
  ret true
end

fn dfCollectMisses mCount ulong to bool
  rep = new uchar 1 0
  allOk = true
  for m ulong mCount bound 6
    if or not dfPipeRead get dfWrRep m rep 1 ne get rep 0 0
      allOk = false
    end
  end
  ret allOk
end

note Resolve the six routed experts of a layer. Each is resident (a hit), staged by a prefetch worker
note (copied in from staging), or absent (loaded on demand: by the six payload workers when two or more
note are absent, inline when one is). On-demand reads are started before the decoder waits for a
note staged payload that is still being read, so the two overlap. Slab slots are assigned in gate order
note whatever the source, so the slot table evolves exactly as it does with prefetch off.
note dfGateScan fills src per gate position (-1 resident, -2 absent, else the staging slot) and mIdx with
note the absent positions. It returns the absent count plus 8 for each staged position.
fn dfGateScan layer ulong src edit long 6 mIdx edit ulong 6 to ulong
  mCount = ulong 0
  staged = ulong 0
  for k ulong 6
    key = add mul layer 384 ulong get dfCurIds k
    cur = get dfSlotOf key
    put src k -1
    if ge cur 0
      put dfCurSlots k cur
      dfLruTouch ulong cur
      put dfStats 0 add get dfStats 0 1
    else
      st = dfPfLookup key
      if ge st 0
        put src k st
        staged = add staged 1
      else
        put src k -2
        put mIdx mCount k
        mCount = add mCount 1
      end
    end
  end
  ret add mCount mul staged 8
end

note Wait for the staged payloads this gate needs. A prefetch that failed verification turns its
note position into -3: that expert is then loaded inline, where a bad payload stops the decoder.
fn dfGateAwait layer ulong src edit long 6 timed bool to void
  for k ulong 6
    s = get src k
    if ge s 0
      key = add mul layer 384 ulong get dfCurIds k
      if not dfPfAwait ulong s key timed
        put src k -3
      end
    end
  end
end

fn dfGateStaged layer ulong k ulong stage ulong timed bool to bool
  key = add mul layer 384 ulong get dfCurIds k
  tS0 = dfMonoNs
  slot = dfPfPublish layer key stage
  if lt slot 0
    ret false
  end
  put dfCurSlots k slot
  if timed
    put dfStats 2 add get dfStats 2 sub dfMonoNs tS0
  end
  ret true
end

fn dfGateVerified layer ulong k ulong m ulong descs view uchar 384 to bool
  desc = new uchar 64 0
  key = add mul layer 384 ulong get dfCurIds k
  base = mul m 64
  for j ulong 64
    put desc j get descs add base j
  end
  slot = dfPublishVerified layer key desc
  if lt slot 0
    ret false
  end
  put dfCurSlots k slot
  put dfStats 1 add get dfStats 1 1
  ret true
end

fn dfGatePublish layer ulong src view long 6 descs view uchar 384 par bool to bool
  m = ulong 0
  for k ulong 6
    s = get src k
    if ge s 0
      if not dfGateStaged layer k ulong s not par
        ret false
      end
    end
    if eq s -3
      if not dfGateDemand layer k not par
        ret false
      end
    end
    if eq s -2
      if par
        if not dfGateVerified layer k m descs
          ret false
        end
      else
        if not dfGateDemand layer k true
          ret false
        end
      end
      m = add m 1
    end
  end
  ret true
end

fn dfResolveGate layer ulong to long
  mIdx = new ulong 6 0
  src = new long 6 0
  descs = new uchar 384 0
  got = dfGateScan layer src mIdx
  if eq got 0
    ret 0
  end
  mCount = rem got 8
  par = and ge mCount 2 eq get dfWrActive 0 6
  tN0 = ulong 0
  if par
    if not dfReadMissDescs layer mIdx mCount descs
      ret -1
    end
    tN0 = dfMonoNs
    if not dfSendMisses layer mCount descs
      ret -1
    end
  end
  dfGateAwait layer src not par
  if par
    if not dfCollectMisses mCount
      ret -1
    end
  end
  if not dfGatePublish layer src descs par
    ret -1
  end
  if par
    put dfStats 2 add get dfStats 2 sub dfMonoNs tN0
  end
  ret 1
end

fn dfResolveExperts h edit zonehdr slots edit uchar * layer ulong to bool
  rawIds = new uchar 24 0
  rawW = new uchar 24 0
  lIds = new uint 6 0
  lWts = new uint 6 0
  coord = new uint 3 0
  times = new ulong 2 0
  if ne mapread get dwMaps 4 ioExpIds rawIds 0 24 24
    ret false
  end
  if ne mapread get dwMaps 4 ioExpWeights rawW 0 24 24
    ret false
  end
  for k ulong 6
    eid = uint diGet rawIds mul k 4 4
    ewt = uint diGet rawW mul k 4 4
    put dfCurIds k eid
    put dfCurWeights k ewt
    put lIds k eid
    put lWts k ewt
  end
  if eq get dfArbPfMeta 4 1
    dfSpecScore layer
    if not dfSpecRead layer
      ret false
    end
  end
  put times 0 dfMonoNs
  gr = dfResolveGate layer
  if lt gr 0
    ret false
  end
  put times 1 dfMonoNs
  dfArbDispatchPrefetch layer
  if ne get dfSlabCfg 2 0
    put coord 0 uint get dfCoord 0
    put coord 1 uint get dfCoord 1
    put coord 2 uint layer
    if not dtAppend coord lIds lWts times
      ret false
    end
  end
  if eq gr 1
    put frameDirty 0 1
  end
  ret true
end

fn dfFfnRouted to bool
  if not gbbegin 64
    ret false
  end
  for k ulong 6
    slot = get dfPhysical ulong get dfCurSlots k
    chunk = div slot 800
    base = mul rem slot 800 deBytes
    if not dwQuantFp8 wsXNorm 5120
      ret false
    end
    if not dwFp4GemmChunk chunk base add base 17694720 wsExpGate 5120 2304
      ret false
    end
    if not dwFp4GemmChunk chunk add base 11796480 add base 18432000 wsExpUp 5120 2304
      ret false
    end
    if not dwBind 3 wsExpGate 9216
      ret false
    end
    if not dwBind 3 wsExpUp 9216
      ret false
    end
    if not dwBind 4 add ioExpWeights mul k 4 4
      ret false
    end
    if not dwBind 3 wsExpAct 9216
      ret false
    end
    if not dnRecord 3 18 1 1 128
      ret false
    end
    if not dwRoundBf16 wsExpAct 2304
      ret false
    end
    if not dwQuantFp8 wsExpAct 2304
      ret false
    end
    if not dwFp4GemmChunk chunk add base 5898240 add base 18063360 add wsRoutedOut mul k 20480 2304 5120
      ret false
    end
    if not dwRoundBf16 add wsRoutedOut mul k 20480 5120
      ret false
    end
  end
  if not dwBind 3 wsRoutedOut 122880
    ret false
  end
  if not dwBind 3 wsSharedOut 20480
    ret false
  end
  if not dwBind 3 wsSubOut 20480
    ret false
  end
  if not dnRecord 26 40 1 1 128
    ret false
  end
  if not dfHcPost wsSubOut get dfResOut 0 wsFfnPost wsFfnComb get dfResIn 0
    ret false
  end
  put dfPreMix 0 wsFfnPre
  ret dfSubmit
end

fn dfRunLayer h edit zonehdr slots edit uchar * layer ulong to bool
  pos = get dfCoord 2
  if or eq layer 1 eq layer 14
    if not deAcquire h 1
      ret false
    end
    if not dfEngramCpu layer
      ok = deRelease h 1 0 false
      ret false
    end
    if not deRelease h 1 0 false
      ret false
    end
    if not deAcquire h 2
      ret false
    end
    if not dfEngramGpu layer
      ok = deRelease h 2 0 true
      ret false
    end
    if not deRelease h 2 0 false
      ret false
    end
  end
  if not deAcquire h 2
    ret false
  end
  if not dfAttnPre layer pos
    ok = deRelease h 2 0 true
    ret false
  end
  if not dfAttnPost layer pos
    ok = deRelease h 2 0 true
    ret false
  end
  if not deRelease h 2 0 false
    ret false
  end
  if not deAcquire h 1
    ret false
  end
  if not dfResolveExperts h slots layer
    ok = deRelease h 1 0 false
    ret false
  end
  if not deRelease h 1 0 false
    ret false
  end
  if not deAcquire h 2
    ret false
  end
  if not dfFfnRouted
    ok = deRelease h 2 0 true
    ret false
  end
  ret deRelease h 2 0 false
end

fn dfHeadArgmax h edit zonehdr to long
  if not deAcquire h 2
    ret -1
  end
  if not gbbegin 8
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dfHcPre get dfResIn 0 get dfPreMix 0 wsX
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBind 3 wsX 20480
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBind 3 wsStat 4
    ok = deRelease h 2 0 true
    ret -1
  end
  if not recordHeadKernel 3 1 32
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBf16Unpack 0 get lmGlobal 1 3 wsUnpack 5120
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBind 3 wsX 20480
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBind 3 wsUnpack 20480
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBind 3 wsStat 4
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBind 3 wsXNorm 20480
    ok = deRelease h 2 0 true
    ret -1
  end
  headArg 5120
  if not recordHeadKernel 4 40 128
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBf16Pack 3 wsXNorm 3 wsPacked 5120
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBind 3 wsPacked 10240
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBind 0 get lmGlobal 2 1323827200
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dwBind 4 ioLogits 517120
    ok = deRelease h 2 0 true
    ret -1
  end
  if not recordHeadKernel 5 129280 32
    ok = deRelease h 2 0 true
    ret -1
  end
  if not dfSubmit
    ok = deRelease h 2 0 true
    ret -1
  end
  if not deRelease h 2 0 false
    ret -1
  end
  buf = new uchar 517120 0
  if ne mapread get dwMaps 4 ioLogits buf 0 517120 517120
    ret -1
  end
  best = ulong 0
  bestV = bitcast f32 uint diGet buf 0 4
  for i ulong 129280
    v = bitcast f32 uint diGet buf mul i 4 4
    if gt v bestV
      bestV = v
      best = i
    end
  end
  ret long best
end

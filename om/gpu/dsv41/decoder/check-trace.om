note SPDX-License-Identifier: AGPL-3.0-only
note Known control stream for independent byte and digest verification.
fn main to int
  ctx = new uchar 104 0
  digest = new uchar 32 0
  coord = new uint 3 0
  ids = new uint 6 0
  weights = new uint 6 0
  times = new ulong 2 0
  dtStart ctx
  if not ar_claim_compute 1
    ret 75
  end
  for i ulong 6
    put ids i uint i
    put weights i 0x3e800000
  end
  for layer ulong 40
    put coord 2 uint layer
    put times 0 mul layer 2
    put times 1 add mul layer 2 1
    if not dtAppend coord ids weights times
      ret 1
    end
    if dtAppend coord ids weights times
      ret 2
    end
  end
  if not dtFinish 1 ctx digest
    ret 3
  end
  if dtAppend coord ids weights times
    ret 4
  end
  ar_drop_compute
  if ne write 2 digest 0 32 32
    ret 74
  end
  ret 0
end

note SPDX-License-Identifier: AGPL-3.0-only
note Token remapping and n-gram ID generation execute only under the shared
note CPU lease. Maps and hash multipliers belong to the pinned tokenizer.
global dgTokens uint 129280
global dgHistory uint 4
global dgPos ulong 1

fn dgOwned to bool
  ret and eq get ar_compute_kind 0 1 eq get ar_compute_pid 0 long getpid
end

fn dgLoad fd int to bool
  if not dgOwned
    ret false
  end
  size = mul dgTokenCount 4
  if ne fseek fd 0 2 long size
    ret false
  end
  buf = new uchar 517120 0
  if not diRead fd buf 0 size
    ret false
  end
  digest = new uchar 32 0
  sha256_hash part buf 0 size digest
  for i ulong 32
    v = uint get digest i
    if ne sh_hexd shr v 4 get dgPin mul i 2
      ret false
    end
    if ne sh_hexd and v 15 get dgPin add mul i 2 1
      ret false
    end
  end
  for i ulong dgTokenCount
    put dgTokens i uint diGet buf mul i 4 4
  end
  dgReset
  ret true
end

fn dgReset to void
  for i ulong 4
    put dgHistory i dgPad
  end
  put dgPos 0 0
end

fn dgToken position ulong id uint to bool
  if or not dgOwned or ne position get dgPos 0 ge ulong id dgTokenCount
    ret false
  end
  for i ulong 3
    put dgHistory sub 3 i get dgHistory sub 2 i
  end
  put dgHistory 0 get dgTokens ulong id
  put dgPos 0 add position 1
  ret true
end

fn dgRows layer ulong ids edit uint 24 to bool
  if or not dgOwned eq get dgPos 0 0
    ret false
  end
  if and ne layer 1 ne layer 14
    ret false
  end
  which = ulong 0
  if eq layer 14
    which = 1
  end
  rolling = mul ulong get dgHistory 0 dgMultiplier mul which 4
  offset = ulong 0
  for n ulong 3
    age = add n 1
    rolling = xor rolling mul ulong get dgHistory age dgMultiplier add mul which 4 age
    for head ulong 8
      column = add mul n 8 head
      prime = dgPrime add mul which 24 column
      put ids column uint add offset rem rolling prime
      offset = add offset prime
    end
  end
  ret true
end

fn dgReadRow shard int sidecar int header view uchar 32 id uint row edit uchar 264 to bool
  if not dgOwned
    ret false
  end
  if ge ulong id diGet header 8 8
    ret false
  end
  weight = add diGet header 16 8 mul ulong id 256
  scale = add diGet header 24 8 mul ulong id 8
  if not diRead shard part row 0 256 weight 256
    ret false
  end
  if not diRead shard part row 256 8 scale 8
    ret false
  end
  expected = new uchar 8 0
  if not diRead sidecar expected add 32 mul ulong id 8 8
    ret false
  end
  digest = new uchar 32 0
  sha256_hash row digest
  for i ulong 8
    if ne get digest i get expected i
      ret false
    end
  end
  ret true
end

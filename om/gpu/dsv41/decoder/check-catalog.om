note SPDX-License-Identifier: AGPL-3.0-only
note Emit the native production code image to stdout, without opening a GPU.
fn main to int
  if not dnEmit
    ret 1
  end
  size = get codePos 0
  mem = mapnew -1 0 size 3 33
  if le mem 0
    ret 74
  end
  put codeMap 0 mem
  if not dnEmit
    ret 2
  end
  buf = new uchar 65536 0
  pos = ulong 0
  while lt pos size
    n = sub size pos
    if gt n len buf
      n = len buf
    end
    if ne mapread mem pos buf 0 n long n
      ret 74
    end
    if ne write 1 buf 0 n long n
      ret 74
    end
    pos = add pos n
  end
  if ne mapdrop mem 0
    ret 74
  end
  ret 0
end

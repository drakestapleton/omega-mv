note SPDX-License-Identifier: AGPL-3.0-only
note CPU=1 and GPU=2. Caller fences and retires the channel before releasing
note GPU ownership. A faulted or outstanding GPU submission retains ownership.
fn deAcquire h edit zonehdr owner uint to bool
  if or ne get h owner 0 or lt owner 1 gt owner 2
    ret false
  end
  if not ar_claim_compute ulong owner
    ret false
  end
  if not slab_acquire_lease h owner
    ar_drop_compute
    ret false
  end
  ret true
end

fn deRelease h edit zonehdr owner uint outstanding ulong faulted bool to bool
  if or ne get ar_compute_pid 0 long getpid ne get ar_compute_kind 0 ulong owner
    ret false
  end
  if or faulted ne outstanding 0
    ret false
  end
  if not slab_release_lease h owner
    ret false
  end
  ar_drop_compute
  ret true
end

note SPDX-License-Identifier: AGPL-3.0-only
note Host control for prefetch-switch.om. Compose: om2 + prefetch-switch.om + this file.
note Without arguments: exit 10 = prefetch on, 11 = prefetch off, 12 = refused.
note With argument "dup": runs itself through execenv with two DSV41_ARBORIS_PREFETCH entries
note (1 then 0, 0 then 0, 1 then 1), which env(1) cannot produce; every child must exit 12.
note Parent exit 0 when all three are refused, otherwise 20 + the failing case.
note check-prefetch-switch.sh drives both modes.

text cpsDupMode "dup"
text cpsOne "DSV41_ARBORIS_PREFETCH=1"
text cpsZero "DSV41_ARBORIS_PREFETCH=0"
global cpsArgv uchar 4096
global cpsEnv uchar 256
global cpsBuf uchar 4096
global cpsStatus uchar 4

fn cpsRec buf edit uchar * pos ulong s view uchar * to ulong
  put buf pos uchar and len s 255
  put buf add pos 1 uchar shr len s 8
  for i ulong len s
    put buf add add pos 2 i get s i
  end
  ret add add pos 2 len s
end

fn cpsRun first view uchar * second view uchar * to ulong
  put cpsEnv 0 2
  put cpsEnv 1 0
  en = cpsRec cpsEnv 2 first
  en = cpsRec cpsEnv en second
  n = argread 0 cpsBuf 0 len cpsBuf
  if le n 0
    ret 1000
  end
  m = ulong n
  put cpsArgv 0 1
  put cpsArgv 1 0
  put cpsArgv 2 uchar and m 255
  put cpsArgv 3 uchar shr m 8
  for i ulong m
    put cpsArgv add 4 i get cpsBuf i
  end
  an = add m 4
  pid = fork
  if lt pid 0
    ret 1001
  end
  if eq pid 0
    r = execenv cpsArgv 0 an cpsEnv 0 en
    exit 98
  end
  w = waitpid int pid cpsStatus 0 len cpsStatus 0
  if ne w pid
    ret 1002
  end
  if ne get cpsStatus 0 0
    ret 1003
  end
  ret ulong get cpsStatus 1
end

fn main to int
  if eq argcnt 2
    n = argread 1 cpsBuf 0 len cpsBuf
    if ne n long len cpsDupMode
      ret 64
    end
    for i ulong len cpsDupMode
      if ne get cpsBuf i get cpsDupMode i
        ret 64
      end
    end
    if ne cpsRun cpsOne cpsZero 12
      ret 21
    end
    if ne cpsRun cpsZero cpsZero 12
      ret 22
    end
    if ne cpsRun cpsOne cpsOne 12
      ret 23
    end
    ret 0
  end
  s = dpsSetting
  if eq s 1
    ret 10
  end
  if eq s 0
    ret 11
  end
  ret 12
end

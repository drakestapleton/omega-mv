note SPDX-License-Identifier: AGPL-3.0-only
note Host control for prefetch-switch.om. Compose: om2 + prefetch-switch.om + this file.
note Exit 10 = prefetch on, 11 = prefetch off, 12 = refused. check-prefetch-switch.sh drives the cases.

fn main to int
  s = dpsSetting
  if eq s 1
    ret 10
  end
  if eq s 0
    ret 11
  end
  ret 12
end

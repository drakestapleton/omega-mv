note SPDX-License-Identifier: AGPL-3.0-only
note Plan the resident checkpoint in tensor-index order. Offloaded expert
note weights and Engram row planes stay on disk; Engram projections stay resident.
global dcOffset ulong 96085
global dcSource ulong 96085
global dcLength ulong 96085
global dcShard uint 96085
global dcFD long 48
global dcTotals ulong 3
text dcExpert ".ffn.experts."
text dcRows ".engram.embed."
text dcEmbedding "embed.weight"
text dcPin "aeffef21b0840b05d82f525da3f72546b8ffbb5ee876b926518b486f0198cb9f"

fn dcMatch row view uchar 160 pos ulong needle view uchar * to bool
  if gt add pos len needle 160
    ret false
  end
  for i ulong len needle
    if ne get row add pos i get needle i
      ret false
    end
  end
  ret true
end

fn dcResident row view uchar 160 shard ulong to bool
  if eq shard 2
    ret dcMatch row 56 dcEmbedding
  end
  if eq shard 43
    ret true
  end
  if or lt shard 3 and gt shard 42 lt shard 47
    ret false
  end
  pos = ulong 63
  while and ge get row pos 48 le get row pos 57
    pos = add pos 1
  end
  ret not or dcMatch row pos dcExpert dcMatch row pos dcRows
end

fn dcPlan fd int to bool
  if ne fseek fd 0 2 15373600
    ret false
  end
  ctx = new uchar 104 0
  digest = new uchar 32 0
  row = new uchar 160 0
  sha256_init ctx
  for i ulong 3
    put dcTotals i 0
  end
  for i ulong 96085
    if not diRead fd row mul i 160 160
      ret false
    end
    sha256_update ctx row
    shard = ulong get row 0
    put dcLength i 0
    if dcResident row shard
      pos = and add get dcTotals 0 255 18446744073709551360
      size = diGet row 16 8
      put dcOffset i pos
      put dcLength i size
      put dcSource i diGet row 8 8
      put dcShard i uint shard
      put dcTotals 0 add pos size
      put dcTotals 1 add get dcTotals 1 size
      put dcTotals 2 add get dcTotals 2 1
    end
  end
  sha256_final ctx digest
  for i ulong 32
    v = uint get digest i
    if ne sh_hexd shr v 4 get dcPin mul i 2
      ret false
    end
    if ne sh_hexd and v 15 get dcPin add mul i 2 1
      ret false
    end
  end
  ret true
end

fn dcTransfer fd int arena long src ulong dest ulong size ulong to bool
  buf = new uchar 262144 0
  pos = ulong 0
  while lt pos size
    n = sub size pos
    if gt n len buf
      n = len buf
    end
    if not diRead fd buf add src pos n
      ret false
    end
    if ne mapwrite arena add dest pos buf 0 n long n
      ret false
    end
    pos = add pos n
  end
  ret true
end

fn dcPopulate arena long to bool
  for i ulong 96085
    size = get dcLength i
    if ne size 0
      shard = ulong get dcShard i
      fd = int get dcFD sub shard 1
      if not dcTransfer fd arena get dcSource i get dcOffset i size
        ret false
      end
    end
  end
  ret true
end

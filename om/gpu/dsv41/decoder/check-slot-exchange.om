note SPDX-License-Identifier: AGPL-3.0-only
note Compose with the decoder in place of decode-cli.om. Both slabs here are
note anonymous host maps. The input is the layer-zero index and its real shard.
fn sxOpen arg ulong to int
  path = new uchar 4096 0
  n = argread arg path 0 4096
  if le n 0
    ret -1
  end
  ret int fopen path 0 ulong n 524288 0
end

fn sxCheck index int to int
  desc = new uchar 64 0
  for i ulong 7
    if not diRead index desc mul i 64 64
      ret 1
    end
    if ne dfLoadMiss 0 i desc long i
      ret 2
    end
  end
  note Pin six residents in this gate. Only the seventh slot is eligible.
  for i ulong 6
    put dfCurIds i uint i
  end
  if not diRead index desc 448 64
    ret 3
  end
  prefix = get desc 8
  put desc 8 xor prefix 1
  spare = get dfSlabCfg 3
  if ne dfLoadMiss 0 7 desc -1
    ret 4
  end
  if or ne get dfSlabCfg 3 spare ne get dfSlabCfg 1 0
    ret 5
  end
  if or ne get dfSlotOf 6 6 ne get dfSlotOf 7 -1
    ret 6
  end
  put desc 8 prefix
  if ne dfLoadMiss 0 8 desc -1
    ret 10
  end
  if or ne get dfSlabCfg 3 spare ne get dfSlabCfg 1 0
    ret 11
  end
  if or ne get dfSlotOf 6 6 ne get dfSlotOf 8 -1
    ret 12
  end
  if ne dfLoadMiss 0 7 desc 6
    ret 7
  end
  if or ne get dfSlotOf 6 -1 ne get dfPhysical 6 spare
    ret 8
  end
  for i ulong 6
    if ne get dfSlotOf i long i
      ret 9
    end
  end
  ret 0
end

fn main to int
  if ne argcnt 3
    ret 64
  end
  index = sxOpen 1
  shard = sxOpen 2
  if or lt index 0 lt shard 0
    ret 66
  end
  for i ulong 6
    put dfCurIds i 383
  end
  dfInitSlabMap 7
  put dfShardFD 0 shard
  put dwSlabMaps 0 mapnew -1 0 mul 7 deBytes 3 33
  put dwSlabMaps 4 mapnew -1 0 deBytes 3 33
  if or le get dwSlabMaps 0 0 le get dwSlabMaps 4 0
    ret 70
  end
  rc = sxCheck index
  dropped = mapdrop get dwSlabMaps 0
  dropped = mapdrop get dwSlabMaps 4
  closed = fclose index
  closed = fclose shard
  ret rc
end

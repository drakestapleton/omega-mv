note Warp-parallel RMS statistic (1 warp = 32 threads, d % 32 == 0).
fn dnEmitRmsStatWarp to void
  dsStart 2
  parameter 20 16
  madreg 21 15 20 Z
  mad 23 14 1 Z
  literal 24 32
  number 22 0.0f32
  mark = get dsPc 0
  iadd 25 21 23
  readAt 25 0 25 0
  fmaReg 22 25 25 22
  nextLoop 23 20 mark 24
  for stage ulong 5
    inst 42 26 22 Z Z shr 16 stage
    fop 30 22 22 26
  end
  fop 38 25 20 Z
  fop 40 25 25 Z
  number 26 1e-20f32
  fmaReg 22 22 25 26
  fop 41 22 22 Z
  literal 27 1
  inst 28 Z 14 27 Z 0
  inst 9 16 15 Z 2 4
  put dsGuard 0 2
  inst 12 Z 16 22 Z 0
end

note Warp-parallel FP32 dense GEMV (1 warp per output row, K % 32 == 0).
fn dnEmitDenseWarp to void
  dsStart 3
  parameter 21 24
  parameter 22 28
  madreg 23 18 21 Z
  madreg 24 15 21 Z
  number 25 0.0f32
  mad 26 14 1 Z
  literal 27 32
  mark = get dsPc 0
  iadd 28 23 26
  readAt 28 0 28 0
  iadd 29 24 26
  readAt 29 2 29 0
  fmaReg 25 28 29 25
  nextLoop 26 21 mark 27
  for stage ulong 5
    inst 42 28 25 Z Z shr 16 stage
    fop 30 25 25 28
  end
  literal 27 1
  inst 28 Z 14 27 Z 0
  madreg 28 18 22 15
  inst 9 16 28 Z 4 4
  put dsGuard 0 2
  inst 12 Z 16 25 Z 0
end

fn dnEmit to bool
  headEmit
  for i ulong 28
    pos = and add get codePos 0 255 18446744073709551360
    put entry add 6 i pos
    put codePos 0 pos
    put dsPc 0 0
    if not dsKernel get dnKinds i
      ret false
    end
    done
  end
  pos = and add get codePos 0 255 18446744073709551360
  put entry 34 pos
  put codePos 0 pos
  dnEmitMmaFp4
  pos = and add get codePos 0 255 18446744073709551360
  put entry 35 pos
  put codePos 0 pos
  dnEmitMmaFp8Block
  pos = and add get codePos 0 255 18446744073709551360
  put entry 36 pos
  put codePos 0 pos
  put dsPc 0 0
  dnEmitRmsStatWarp
  done
  pos = and add get codePos 0 255 18446744073709551360
  put entry 37 pos
  put codePos 0 pos
  put dsPc 0 0
  dnEmitDenseWarp
  done
  ret eq get codeWriteFailed 0 0
end

fn dnOpen to bool
  if not dnEmit
    ret false
  end
  if not gbopen 1
    ret false
  end
  if not gbbopen
    ret false
  end
  mapping = nvalloc get codePos 0 false
  if le mapping 0
    ret false
  end
  put codeMap 0 mapping
  ret dnEmit
end

note All address derivation stays within an owned RM mapping. Its allocation
note size is supplied by the owner; offsets are byte offsets into that region.
fn dnBind mapping long allocation ulong offset ulong span ulong to bool
  if or le mapping 0 or eq span 0 gt offset allocation
    ret false
  end
  if or gt span sub allocation offset gt get bindingCount 0 14
    ret false
  end
  va = add mapaddr mapping offset
  headArg gblo va
  headArg gbhi va
  ret true
end

fn dnRecord kernel ulong x uint y uint z uint threads uint to bool
  if or ge kernel 32 or eq x 0 or eq y 0 eq z 0
    ret false
  end
  if or eq threads 0 gt threads 1024
    ret false
  end
  shape = new uint 4 0
  put shape 0 x
  put shape 1 y
  put shape 2 z
  put shape 3 threads
  ret recordDsGrid add 6 kernel shape
end

note SPDX-License-Identifier: AGPL-3.0-only
fn dsEmbedSession fd int to int
  token = new uchar 4 0
  frame = new uchar 40976 0
  while true
    used = ulong 0
    while lt used 4
      n = read 0 token used sub 4 used
      if eq n -4
        continue
      end
      if lt n 0
        ret 74
      end
      if eq n 0
        if eq used 0
          ret 0
        end
        ret 65
      end
      used = add used ulong n
    end
    id = uint 0
    for i ulong 4
      id = or id shl uint get token i mul i 8
    end
    if ge id 129280
      ret 65
    end
    if not dsInitResidual fd id frame
      ret 74
    end
    sent = ulong 0
    while lt sent 40976
      n = write 1 frame sent sub 40976 sent
      if eq n -4
        continue
      end
      if le n 0
        ret 74
      end
      sent = add sent ulong n
    end
  end
  ret 74
end

fn main to int
  path = new uchar 4096 0
  n = argread 1 path 0 4096
  if or ne argcnt 2 le n 0
    ret 64
  end
  fd = fopen path 0 ulong n 524288 0
  if lt fd 0
    ret 66
  end
  rc = int 65
  if dsOpenEmbed int fd
    rc = dsEmbedSession int fd
  end
  if ne fclose int fd 0
    ret 74
  end
  ret rc
end

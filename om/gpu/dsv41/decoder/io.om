note SPDX-License-Identifier: AGPL-3.0-only
fn diRead fd int buf edit uchar * pos ulong count ulong to bool
  used = ulong 0
  while lt used count
    n = pread fd buf used sub count used long add pos used
    if eq n -4
      continue
    end
    if le n 0
      ret false
    end
    used = add used ulong n
  end
  ret true
end

fn diPut record edit uchar * off ulong width ulong v ulong to void
  for i ulong width
    put record add off i uchar and shr v mul i 8 255
  end
end

fn diGet record view uchar * off ulong width ulong to ulong
  value = ulong 0
  for i ulong width
    value = or value shl ulong get record add off i mul i 8
  end
  ret value
end

fn deArg arg ulong to int
  path = new uchar 4096 0
  n = argread arg path 0 4096
  if le n 0
    ret int -1
  end
  ret int fopen path 0 ulong n 524288 0
end

fn deReadRecord fd int expert ulong record edit uchar 64 to bool
  if not diRead fd record mul expert 64 64
    ret false
  end
  ret eq diGet record 4 4 expert
end

fn deCheckLease index int shard int maps view long 2 to int
  h = new uchar 128 0
  slots = new uchar 192 0
  descriptor = new uchar 64 0
  slab_init h 0 1 2
  if not deReadRecord index 383 descriptor
    ret 1
  end
  if ne deResolve h slots descriptor maps shard -2
    ret 2
  end
  if not deAcquire h 1
    ret 3
  end
  if ne deResolve h slots descriptor maps shard 1
    ret 4
  end
  if ne deResolve h slots descriptor maps shard 1
    ret 5
  end
  if not deReadRecord index 0 descriptor
    ret 6
  end
  if ne deResolve h slots descriptor maps shard 2
    ret 7
  end
  if not deReadRecord index 127 descriptor
    ret 8
  end
  prior = get descriptor 8
  put descriptor 8 xor prior 1
  if ne deResolve h slots descriptor maps shard -2
    ret 9
  end
  if ne diGet slots 66 2 383
    ret 10
  end
  put descriptor 8 prior
  if ne deResolve h slots descriptor maps shard 1
    ret 11
  end
  if not deRelease h 1 0 false
    ret 12
  end
  if not deAcquire h 2
    ret 13
  end
  if ne deResolve h slots descriptor maps shard -2
    ret 14
  end
  if or deRelease h 2 1 false deRelease h 2 0 true
    ret 15
  end
  if not deRelease h 2 0 false
    ret 15
  end
  ret 0
end

fn main to int
  if ne argcnt 3
    ret 64
  end
  index = deArg 1
  shard = deArg 2
  if or lt index 0 lt shard 0
    ret 66
  end
  maps = new long 2 0
  put maps 0 mapnew -1 0 deBytes 3 33
  put maps 1 mapnew -1 0 mul 3 deBytes 3 33
  rc = deCheckLease index shard maps
  dropped = mapdrop get maps 0
  dropped = mapdrop get maps 1
  closed = fclose index
  closed = fclose shard
  ret rc
end

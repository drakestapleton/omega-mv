note SPDX-License-Identifier: AGPL-3.0-only
note Batch-one KV layout. Each layer owns a 128-row sliding window. Layers
note 2, 8, 14 and 20 publish compressed latents and index keys for consumers.
note The checked kernels use FP32 storage for BF16-rounded reconstructions.
note Sequence pages have 2048 token positions. The final partial page stays
note addressable only through the sequence length supplied to the planner.
const dkPage ulong 2048
global dkWindow ulong 40
global dkLatent ulong 40
global dkIndex ulong 40
global dkState ulong 40
global dkPlanInfo ulong 3

fn dkPlan length ulong to bool
  if or eq length 0 gt length 1048576
    ret false
  end
  pages = div add length sub dkPage 1 dkPage
  reserved = mul pages dkPage
  off = ulong 0
  for l ulong 40
    put dkWindow l off
    off = add off mul 128 mul 512 4
  end
  latent = ulong 0
  keys = ulong 0
  state = ulong 0
  for l ulong 40
    if or or eq l 2 eq l 8 or eq l 14 eq l 20
      rows = reserved
      if lt l 20
        rows = div reserved 2
      end
      latent = off
      off = add off mul rows mul 512 4
      keys = off
      off = add off mul rows mul 128 4
      state = 0
      if lt l 20
        state = off
        off = add off mul 2 mul 2 mul 512 4
      end
    end
    if ge l 37
      latent = 0
      keys = 0
      state = 0
    end
    put dkLatent l latent
    put dkIndex l keys
    put dkState l state
  end
  put dkPlanInfo 0 length
  put dkPlanInfo 1 pages
  put dkPlanInfo 2 off
  ret true
end

fn dkTouch mapping long to bool
  pos = ulong 0
  while lt pos get dkPlanInfo 2
    if ne mapset mapping pos 1 0 0
      ret false
    end
    pos = add pos 4096
  end
  ret true
end

note SPDX-License-Identifier: AGPL-3.0-only
note Little-endian f32 decode table. First 256 E4M3FN encodings, then 16 E2M1 encodings.
om2
fn e4m3 c uint to uint
e = and shr c 3 15
m = and c 7
raw = or shl add e 120 23 shl m 20
if eq e 0
raw = bitcast uint mul f32 m 0.001953125f32
end
if and eq e 15 eq m 7
raw = uint 0x7fc00000
end
ret or raw shl and c 128 24
end
fn e2m1 c uint to uint
e = and shr c 1 3
m = and c 1
raw = or shl add e 126 23 shl m 22
if eq e 0
raw = bitcast uint mul f32 m 0.5f32
end
ret or raw shl and c 8 28
end
fn main to int
buf = new uchar 1088 0
for i ulong 272
v = e4m3 uint i
if ge i 256
v = e2m1 uint sub i 256
end
for j ulong 4
put buf add mul i 4 j uchar and shr v uint mul j 8 255
end
end
if ne write 1 buf 0 1088 1088
ret 1
end
ret 0
end

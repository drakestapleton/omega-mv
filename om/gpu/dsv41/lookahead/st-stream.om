note SPDX-License-Identifier: AGPL-3.0-only
note Input is a little-endian horizon followed by ordered six-u32 routes.
note Horizons 40 and 80 target the same layer one and two tokens later.
note Emit six expert IDs per observed gate. Unused entries are 0xffffffff.
fn st_read bytes edit uchar 24 size ulong to int
  pos = ulong 0
  while lt pos size bound 24
    n = read 0 bytes pos sub size pos
    if lt n 0
      ret int -1
    end
    if eq n 0
      if eq pos 0
        ret 0
      end
      ret int -1
    end
    pos = add pos ulong n
  end
  ret 1
end
fn st_word bytes view uchar 24 pos ulong to uint
  word = uint 0
  for i ulong 4
    word = or word shl uint get bytes add pos i mul i 8
  end
  ret word
end
global past uint 480
global recent uint 240
global observed uint 40

fn st_observe idx ulong horizon ulong route view uint 6 to bool
  prior = new uint 6 0
  layer = rem idx 40
  slot = mul rem idx horizon 6
  if ge idx horizon
    for i ulong 6
      put prior i get past add slot i
    end
    srclayer = rem sub idx horizon 40
    if not st_learn srclayer prior route
      ret false
    end
  end
  for i ulong 6
    put past add slot i get route i
    put recent add mul layer 6 i get route i
  end
  put observed layer 6
  ret true
end

fn st_predict layer ulong horizon ulong route view uint 6 hints edit uint 6 to long
  history = new uint 6 0
  dest = rem add layer horizon 40
  for i ulong 6
    put history i get recent add mul dest 6 i
  end
  ret st_hints layer route part history 0 ulong get observed dest hints
end

fn st_emit bytes edit uchar 24 count ulong hints view uint 6 to bool
  for k ulong 6
    expert = uint 0xffffffff
    if lt k ulong count
      expert = get hints k
    end
    for b ulong 4
      put bytes add mul k 4 b uchar and shr expert mul b 8 255
    end
  end
  sent = ulong 0
  while lt sent 24 bound 24
    n = write 1 bytes sent sub 24 sent
    if le n 0
      ret false
    end
    sent = add sent ulong n
  end
  ret true
end

fn main to int
  bytes = new uchar 24 0
  if ne st_read bytes 4 1
    ret 65
  end
  horizon = ulong st_word bytes 0
  if or eq horizon 0 and gt horizon 4 and ne horizon 40 ne horizon 80
    ret 65
  end
  route = new uint 6 0
  hints = new uint 6 0
  idx = ulong 0
  while true
    status = st_read bytes 24
    if eq status 0
      if or eq idx 0 ne rem idx 40 0
        ret 65
      end
      ret 0
    end
    if ne status 1
      ret 65
    end
    layer = rem idx 40
    for i ulong 6
      put route i st_word bytes mul i 4
    end
    if not st_valid route
      ret 65
    end
    if not st_observe idx horizon route
      ret 65
    end
    count = st_predict layer horizon route hints
    if lt count 0
      ret 65
    end
    if not st_emit bytes ulong count hints
      ret 74
    end
    idx = add idx 1
  end
  ret 65
end

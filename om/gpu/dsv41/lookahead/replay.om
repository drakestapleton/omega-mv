note SPDX-License-Identifier: AGPL-3.0-only
note One table per source layer and horizon. The replay owner calls learn
note only when the target gate has emitted its six native experts.
global correlation uint 5898240

fn st_valid route view uint 6 to bool
  for i ulong 6
    if ge get route i 384
      ret false
    end
    for j ulong i bound 6
      if eq get route i get route j
        ret false
      end
    end
  end
  ret true
end

fn st_learn layer ulong source view uint 6 target view uint 6 to bool
  if or ge layer 40 or not st_valid source not st_valid target
    ret false
  end
  for i ulong 6
    row = mul add mul layer 384 ulong get source i 384
    for j ulong 6
      index = add row ulong get target j
      if ne get correlation index 0xffffffff
        put correlation index add get correlation index 1
      end
    end
  end
  ret true
end

note The history boost is one vote for a member of the last observed
note target-layer route. An empty history at cold start has length zero.
note Rank positive scores only, breaking ties by ascending expert ID.
fn st_hints layer ulong source view uint 6 history view uint * hints edit uint 6 to long
  if or ge layer 40 or not st_valid source and ne len history 0 ne len history 6
    ret long -1
  end
  score = new ulong 384 0
  for j ulong len history bound 6
    expert = ulong get history j
    if ge expert 384
      ret long -1
    end
    if ne get score expert 0
      ret long -1
    end
    put score expert 1
  end
  for i ulong 6
    row = mul add mul layer 384 ulong get source i 384
    for e ulong 384
      put score e add get score e ulong get correlation add row e
    end
  end
  for k ulong 6
    best = ulong 0
    for e ulong 384
      if gt get score e get score best
        best = e
      end
    end
    if eq get score best 0
      ret long k
    end
    put hints k uint best
    put score best 0
  end
  ret 6
end

note Times share a monotonic origin and are expressed in nanoseconds.
note service_ns is the sampled duration for this request's physical extent.
fn slab_arrival queue_free_ns ulong issue_ns ulong service_ns ulong to ulong
  start = issue_ns
  if gt queue_free_ns start
    start = queue_free_ns
  end
  ret add start service_ns
end

note Flat miss-only LRU. last_use starts zero, ticks start at one.
note Returns 1 on a hit, 0 on a demand read and -1 on invalid input.
fn demand_lru keys edit uint * last_use edit ulong * key uint tick ulong to int
  if or eq tick 0 or eq len keys 0 ne len keys len last_use
    ret int -1
  end
  victim = ulong 0
  for slot ulong len keys bound 0xffffffff
    if and ne get last_use slot 0 eq get keys slot key
      put last_use slot tick
      ret 1
    end
    if lt get last_use slot get last_use victim
      victim = slot
    end
  end
  put keys victim key
  put last_use victim tick
  ret 0
end

note SPDX-License-Identifier: AGPL-3.0-only
fn main to int
  source = new uint 6 0
  target = new uint 6 0
  hints = new uint 6 0
  for i ulong 6
    put source i uint i
    put target i uint add 10 i
  end
  if ne st_hints 0 source part target 0 0 hints 0
    ret 1
  end
  if not st_learn 0 source target
    ret 2
  end
  if ne st_hints 0 source part target 0 6 hints 6
    ret 3
  end
  for i ulong 6
    if ne get hints i get target i
      ret 4
    end
  end
  put target 0 11
  if st_learn 0 source target
    ret 5
  end
  keys = new uint 2 0
  last_use = new ulong 2 0
  if ne demand_lru part keys 0 2 part last_use 0 2 0 1 0
    ret 6
  end
  if ne demand_lru part keys 0 2 part last_use 0 2 1 2 0
    ret 7
  end
  if ne demand_lru part keys 0 2 part last_use 0 2 0 3 1
    ret 8
  end
  if ne demand_lru part keys 0 2 part last_use 0 2 2 4 0
    ret 9
  end
  if ne demand_lru part keys 0 2 part last_use 0 2 1 5 0
    ret 10
  end
  if or ne slab_arrival 15 12 5 20 ne slab_arrival 10 12 5 17
    ret 11
  end
  ret 0
end

note SPDX-License-Identifier: AGPL-3.0-only
note Read one settled score frame. Header: "ARH1" u32le, pair count,
note hint budget. Each pair is an expert ID (0xffffffff ignores the node)
note followed by positive FP32 score bits. Emit cache replay OP3 records.
fn ah_read4 b edit uchar 4 to bool
  pos = ulong 0
  while lt pos 4 bound 4
    r = read 0 b pos sub 4 pos
    if le r 0
      ret false
    end
    pos = add pos ulong r
  end
  ret true
end
fn ah_word b view uchar 4 to uint
  word = uint 0
  for i ulong 4
    word = or word shl uint get b i mul i 8
  end
  ret word
end
fn main to int
  b = new uchar 4 0
  peak = new uint 384 0
  hints = new uint 768 0
  if or not ah_read4 b ne ah_word b 0x31485241
    ret 65
  end
  if not ah_read4 b
    ret 65
  end
  n = ulong ah_word b
  if not ah_read4 b
    ret 65
  end
  k = ulong ah_word b
  if gt k 384
    ret 65
  end
  for i ulong n bound 0xffffffff
    if not ah_read4 b
      ret 65
    end
    id = ah_word b
    if not ah_read4 b
      ret 65
    end
    if not ar_vote_expert peak id ah_word b
      ret 65
    end
  end
  if ne read 0 b 0 1 0
    ret 65
  end
  count = ar_select_experts peak part hints 0 mul k 2
  if not arboris_send_hints 1 hints ulong count
    ret 74
  end
  ret 0
end

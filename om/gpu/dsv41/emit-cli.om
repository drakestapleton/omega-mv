note SPDX-License-Identifier: AGPL-3.0-only
fn dsWrite w view ulong 4 to void
bytes = new uchar 16 0
for i ulong 16
put bytes i uchar and shr get w div i 4 mul rem i 4 8 255
end
if ne write 1 bytes 0 16 16
exit 4
end
end
fn main to int
arg = new uchar 2 0
if ne argcnt 2
ret 2
end
if ne argread 1 arg 0 2 1
ret 2
end
kind = get arg 0
if eq kind 97
hcPre
done
ret 0
end
if eq kind 98
hcPost
done
ret 0
end
if eq kind 99
sinkhorn
done
ret 0
end
if eq kind 100
swiglu
done
ret 0
end
if eq kind 101
gemm false
done
ret 0
end
if eq kind 102
gemm true
done
ret 0
end
if eq kind 103
sparseScore
done
ret 0
end
if eq kind 104
sparseMix
done
ret 0
end
if and ge kind 105 le kind 107
quant ne kind 105 eq kind 107
done
ret 0
end
if eq kind 108
dense
done
ret 0
end
if eq kind 109
rmsStat
done
ret 0
end
if eq kind 110
rmsApply
done
ret 0
end
if eq kind 111
rotary
done
ret 0
end
if eq kind 112

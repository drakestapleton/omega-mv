done
ret 0
end
if eq kind 113
route
done
ret 0
end
if eq kind 114
engramRows
done
ret 0
end
if eq kind 115
convert false
done
ret 0
end
if eq kind 116
convert true
done
ret 0
end
if eq kind 117
indexScore
done
ret 0
end
if eq kind 118
blockScores
done
ret 0
end
if eq kind 119
topPositions
done
ret 0
end
if eq kind 120
engramGate
done
ret 0
end
if eq kind 121
engramAdd
done
ret 0
end
if eq kind 122
tokenEmbed
done

note Compute the Engram normalized signed-sqrt gate for each token and residual stream.
fn engramGate to void
start 5
mad 20 18 4 15
mad 21 20 5120 Z
mad 22 15 5120 Z
literal 23 0
literal 24 5120
literal 25 1
number 26 0.0f32
number 27 0.0f32
number 28 0.0f32
mark = get dsPc 0
iadd 29 21 23
readAt 30 0 29 0
readAt 31 2 29 0
iadd 29 22 23
readAt 32 4 29 0
fmaReg 26 30 30 26
fmaReg 27 31 31 27
fop 32 30 30 32
fmaReg 28 30 31 28
nextLoop 23 24 mark 25
number 29 0.0001953125f32
number 30 1e-20f32
fmaReg 26 26 29 30
fmaReg 27 27 29 30
fop 41 26 26 Z
fop 41 27 27 Z
fop 32 26 26 27
fop 32 28 28 26
number 29 0.013975424859373685f32
fop 32 28 28 29
inst 18 30 28 Z Z 0x80000000
inst 18 28 28 Z Z 0x7fffffff
number 29 0.000001f32
fop 37 28 28 29
fop 70 28 28 Z
iadd 28 28 30
number 29 -1.4426950408889634f32
number 30 1.0f32
sigmoid 28 28 29 30
readAt 31 6 18 0
inst 28 Z 31 25 Z 0
put dsGuard 0 2
number 28 0.0f32
writeAt 28 8 20 0
end

note SPDX-License-Identifier: AGPL-3.0-only
note Compose after om/encoder/bw_enc_sm121.om. The public encoder receives physical operands.
note R0..R13 pointer pairs, R14 lane, R15 CTA.x, R18 CTA.y, R19 CTA.z, R16:R17 address.
const Z ulong 255
global dsPc ulong 1
global dsGuard ulong 1
fn dsCtrl op ulong to ulong
note Conservative issue schedule: wait on both barriers, long fixed stalls, no dual issue.
wb = ulong 7
rbar = ulong 7
if or or and ge op 3 le op 7 and ge op 38 le op 42 or eq op 47 eq op 59
wb = ulong 0
end
if or eq op 11 eq op 19
wb = ulong 0
rbar = ulong 1
end
if eq op 12
rbar = ulong 1
end
stall = ulong 6
if or ne wb 7 ne rbar 7
stall = ulong 4
end
if or eq op 28 eq op 34
stall = ulong 14
end
ret or 0x300000 or shl stall 9 or shl wb 14 shl rbar 17
end
fn inst op ulong dst ulong a ulong b ulong c ulong imm ulong to void
o = new ulong 16 0
w = new ulong 4 0
native = op
if or eq op 65 eq op 66
native = ulong 61
end
if or eq op 67 eq op 68
native = ulong 12
end
if or eq op 69 eq op 70
native = ulong 40
end
put o 0 native
put o 1 dst
put o 2 a
put o 3 b
put o 4 c
put o 5 4
put o 6 and imm 0xffffffff
put o 7 dsCtrl native
if ne get dsGuard 0 0
put o 9 1
end
if eq get dsGuard 0 2
put o 10 1
end
put dsGuard 0 0
if ne a Z
put o 12 1
end
if ne b Z
put o 13 1
end
if ne enc1 o w 0
exit 3
end
note F2FP.SATFINITE PACK_AB_MERGE_C and narrow STG encodings, SM121.
if eq op 65
put w 2 0x048070ff
end
if eq op 66
put w 2 0x042070ff
end
if eq op 67
put w 2 sub get w 2 0x800
end
if eq op 68
put w 2 sub get w 2 0x400
end
if eq op 69
put w 2 0xc00
end
if eq op 70
put w 2 0x2000
end
dsWrite w
put dsPc 0 add get dsPc 0 1
end
fn dsWrite w view ulong 4 to void
bytes = new uchar 16 0
for i ulong 16
put bytes i uchar and shr get w div i 4 mul rem i 4 8 255
end
if ne write 1 bytes 0 16 16
exit 4
end
end
fn literal d ulong x ulong to void
inst 2 d Z Z Z x
end
fn number d ulong x f32 to void
literal d ulong bitcast uint x
end
fn mad d ulong a ulong scale ulong c ulong to void
inst 8 d a Z c scale
end
fn madreg d ulong a ulong b ulong c ulong to void
inst 8 d a b c 0
end
fn iadd d ulong a ulong b ulong to void
inst 14 d a b Z 0
end
fn fop op ulong d ulong a ulong b ulong to void
inst op d a b Z 0
end
fn fmaReg d ulong a ulong b ulong c ulong to void
inst 33 d a b c 0
end
fn parameter d ulong offset ulong to void
inst 4 d Z Z Z add 896 offset
end
fn start pointers ulong to void
inst 7 4 Z Z Z 856
for i ulong pointers
inst 5 mul i 2 Z Z Z add 896 mul i 8
end
inst 3 14 Z Z Z 33
inst 3 15 Z Z Z 37
inst 3 18 Z Z Z 38
inst 3 19 Z Z Z 39
end
fn readAt d ulong base ulong idx ulong offset ulong to void
inst 9 16 idx Z base 4
inst 11 d 16 Z Z offset
end
fn writeAt d ulong base ulong idx ulong offset ulong to void
inst 9 16 idx Z base 4
inst 12 Z 16 d Z offset
end
fn nextLoop counter ulong limit ulong mark ulong one ulong to void
iadd counter counter one
inst 28 Z counter limit Z 0
put dsGuard 0 2
inst 46 Z Z Z Z sub mark get dsPc 0
end
fn expReg d ulong a ulong logtwo ulong to void
fop 32 d a logtwo
fop 47 d d Z
end
fn sigmoid d ulong a ulong neglog ulong one ulong to void
expReg d a neglog
fop 30 d d one
fop 40 d d Z
end
fn done to void
inst 45 Z Z Z Z 0
while or lt get dsPc 0 32 ne rem get dsPc 0 8 0
inst 0 Z Z Z Z 0
end
end

note Four-stream pre mix. CTA.y is the token; x covers the 5120 components with 128 threads per CTA.
fn hcPre to void
start 3
mad 20 15 128 14
mad 21 18 20480 20
mad 22 18 4 Z
number 23 0.0f32
for stream ulong 4
readAt 24 0 21 mul stream 20480
readAt 25 2 22 mul stream 4
fmaReg 23 24 25 23
end
mad 21 18 5120 20
writeAt 23 4 21 0
end

note post[j] * sublayer + sum_i residual[i] * comb[i,j]. Each thread writes all four streams.
fn hcPost to void
start 5
mad 20 15 128 14
mad 21 18 20480 20
mad 22 18 5120 20
mad 23 18 4 Z
mad 24 18 16 Z
readAt 25 0 22 0
for i ulong 4
readAt add i 26 2 21 mul i 20480
end
for j ulong 4
readAt 30 4 23 mul j 4
fop 32 31 25 30
for i ulong 4
readAt 30 6 24 mul add mul i 4 j 4
fmaReg 31 add i 26 30 31
end
writeAt 31 8 21 mul j 20480
end
end

note One thread per token; registers 32..47 are the 4x4 transport matrix.
fn normalize columns bool epsilon bool to void
for i ulong 4
number 30 0.0f32
for j ulong 4
reg = add 32 add mul i 4 j
if columns
reg = add 32 add mul j 4 i
end
fop 30 30 30 reg
end
if epsilon
fop 30 30 30 28
end
fop 40 30 30 Z
for j ulong 4
reg = add 32 add mul i 4 j
if columns
reg = add 32 add mul j 4 i
end
fop 32 reg reg 30
if not epsilon
fop 30 reg reg 28
end
end
end
end
fn sinkhorn to void
start 6
mad 20 15 24 Z
mad 21 15 4 Z
mad 22 15 16 Z
literal 23 0
for i ulong 3
readAt add 24 i 2 23 mul i 4
end
number 27 -1.4426950408889634f32
number 28 0.000001f32
number 29 1.0f32
for i ulong 24
readAt 30 0 20 mul i 4
readAt 31 4 23 mul i 4
if lt i 8
fmaReg 30 30 add 24 div i 4 31
sigmoid 30 30 27 29
if lt i 4
fop 30 30 30 28
writeAt 30 6 21 mul i 4
else
fop 30 30 30 30
writeAt 30 8 21 mul sub i 4 4
end
else
fmaReg add 32 sub i 8 30 26 31
end
end
number 27 1.4426950408889634f32
for i ulong 4
base = add 32 mul i 4
fop 37 31 base add base 1
fop 37 31 31 add base 2
fop 37 31 31 add base 3
for j ulong 4
r = add base j
fop 31 r r 31
expReg r r 27
end
end
normalize false false
normalize true true
literal 48 0
literal 49 19
literal 50 1
mark = get dsPc 0
normalize false true
normalize true true
nextLoop 48 49 mark 50
for i ulong 16
writeAt add 32 i 10 22 mul i 4
end
end
fn swiglu to void
start 4
mad 20 15 128 14
mad 21 18 2304 20
readAt 22 0 21 0
readAt 23 2 21 0
readAt 24 4 18 0
number 25 10.0f32
number 26 -10.0f32
fop 36 22 22 25
fop 36 23 23 25
fop 37 23 23 26
number 27 -1.4426950408889634f32
number 28 1.0f32
sigmoid 29 22 27 28
fop 32 29 29 22
fop 32 29 29 23
fop 32 29 29 24
writeAt 29 6 21 0
end

note Read a packed uint8 with an aligned 32-bit load. Source has padding to the next word.
fn byteRead d ulong base ulong idx ulong to void
inst 17 52 idx Z Z 2
readAt 53 base 52 0
inst 18 52 idx Z Z 3
literal 54 3
fop 29 52 52 54
mad 52 52 8 Z
inst 52 53 53 52 Z 0
inst 17 d 53 Z Z 24
end
fn e8Scale d ulong base ulong idx ulong to void
byteRead d base idx
mad 55 d 1 Z
literal 54 23
inst 52 d d 54 Z 0
literal 54 1
inst 28 Z d 54 Z 0
put dsGuard 0 2
literal d 0x00400000
literal 54 255
inst 28 Z 55 54 Z 0
put dsGuard 0 1
literal d 0x7fc00000
end

note Pointers A[E4M3], W[E4M3 or packed E2M1], A_scale[E8M0], W_scale[E8M0], LUT[f32], C[f32].
note Params K and N. LUT has 256 E4M3 then 16 E2M1 values. CTA.y = m. K divisible by 32.
fn gemm fp4 bool to void
start 6
parameter 21 48
parameter 22 52
mad 20 15 128 14
inst 28 Z 20 22 Z 0
put dsGuard 0 1
inst 45 Z Z Z Z 0
inst 17 23 21 Z Z 5
madreg 24 18 23 Z
madreg 25 20 23 Z
if fp4
mad 26 25 4 Z
mad 27 25 1 Z
else
mad 26 25 8 Z
inst 17 27 20 Z Z 5
madreg 27 27 23 Z
end
mad 28 24 8 Z
literal 29 0
literal 30 1
number 31 0.0f32
mark = get dsPc 0
number 32 0.0f32
for k ulong 32
if eq rem k 4 0
readAt 33 0 28 mul div k 4 4
end
pack = ulong 4
width = ulong 8
mask = ulong 255
if fp4
pack = ulong 8
width = ulong 4
mask = ulong 15
end
if eq rem k pack 0
readAt 34 2 26 mul div k pack 4
end
inst 17 35 33 Z Z mul rem k 4 8
inst 18 35 35 Z Z 255
readAt 35 8 35 0
inst 17 36 34 Z Z mul rem k pack width
inst 18 36 36 Z Z mask
if fp4
readAt 36 8 36 1024
else
readAt 36 8 36 0
end
fmaReg 32 35 36 32
end
iadd 37 24 29
e8Scale 38 4 37
iadd 37 27 29
e8Scale 39 6 37
fop 32 32 32 38
fmaReg 31 32 39 31
literal 40 8
iadd 28 28 40
if fp4
literal 40 4
end
iadd 26 26 40
nextLoop 29 23 mark 30
madreg 41 18 22 20
writeAt 31 10 41 0
end

note Split latent attention: one CTA.x per selected entry, CTA.y per query head,

note Fixed SM121a instruction stream calibrated against the included PTX oracle.
om2
fn ins a ulong b ulong to void
buf = new uchar 16 0
for i ulong 8
put buf i uchar and shr a mul i 8 255
put buf add 8 i uchar and shr b mul i 8 255
end
if ne write 1 buf 0 16 16
exit 4
end
end

note SPDX-License-Identifier: AGPL-3.0-only
note Code is generated from the same emitter as the cubins and placed at 256-byte QMD alignments.
global codePos ulong 1
global entry ulong 38
global codeMap long 1
global codeWriteFailed uint 1
global bindings uint 16
global bindingCount ulong 1
global frameDirty uint 1
fn dsWrite w view ulong 4 to void
p = get codePos 0
b = new uchar 16 0
if gt get codeMap 0 0
for i ulong 16
put b i uchar and shr get w div i 4 mul rem i 4 8 255
end
if ne mapwrite get codeMap 0 p b 0 16 16
put codeWriteFailed 0 1
end
end
put codePos 0 add p 16
end
fn vocabularyDot to void
note One warp per vocabulary row. Each lane accumulates 80 pairs, then the warp sums in FP32.
dsStart 3
mad 20 15 2560 14
mad 21 14 1 Z
literal 22 0
literal 23 10
literal 24 1
literal 25 256
number 26 0.0f32
mark = get dsPc 0
for pair ulong 8
readAt 27 0 21 mul pair 128
readAt 28 2 20 mul pair 128
mad 29 27 65536 Z
mad 30 28 65536 Z
fmaReg 26 29 30 26
inst 18 29 27 Z Z 0xffff0000
inst 18 30 28 Z Z 0xffff0000
fmaReg 26 29 30 26
end
iadd 20 20 25
iadd 21 21 25
nextLoop 22 23 mark 24
for stage ulong 5
inst 42 27 26 Z Z shr 16 stage
fop 30 26 26 27
end
inst 28 Z 14 24 Z 0
inst 9 16 15 Z 4 4
put dsGuard 0 2
inst 12 Z 16 26 Z 0
end
fn headRms to void
note Sum squared BF16 hidden elements in 32 lane-local FP32 partials before reducing across the warp.
dsStart 2
mad 20 14 1 Z
literal 21 0
literal 22 20
literal 23 1
literal 24 256
number 25 0.0f32
mark = get dsPc 0
for k ulong 8
readAt 26 0 20 mul k 128
fmaReg 25 26 26 25
end
iadd 20 20 24
nextLoop 21 22 mark 23
for stage ulong 5
inst 42 26 25 Z Z shr 16 stage
fop 30 25 25 26
end
number 27 0.0001953125f32
number 28 1e-20f32
fmaReg 25 25 27 28
fop 41 25 25 Z
inst 28 Z 14 23 Z 0
put dsGuard 0 2
inst 12 Z 2 25 Z 0
end
fn headEmit to void
put codePos 0 0
for i ulong 6
p = mul div add get codePos 0 255 256 256
put entry i p
put codePos 0 p
put dsPc 0 0
if eq i 0
convert true
end
if eq i 1
hcPre
end
if eq i 2
convert false
end
if eq i 3
headRms
end
if eq i 4
rmsApply
end
if eq i 5
vocabularyDot
end
done
end
end
fn headArg v uint to void
i = get bindingCount 0
put bindings i v
put bindingCount 0 add i 1
end
fn headPtr m long to void
a = mapaddr m
headArg gblo a
headArg gbhi a
end
fn recordHeadKernel id ulong grid uint threads uint to bool
  shape = new uint 4 1
  put shape 0 grid
  put shape 3 threads
  ret recordDsGrid id shape
end
fn recordDsGrid id ulong shape view uint 4 to bool
gbqmd 1
a = add mapaddr get codeMap 0 get entry id
put gbq1 32 gblo shr a 4
put gbq1 33 or uint and shr a 36 2097151 20971520
put gbq1 59 gblo shr a 8
put gbq1 34 or 65536 get shape 3
put gbq1 35 or 131073 shl uint 64 8
put gbq1 39 get shape 0
put gbq1 40 get shape 1
put gbq1 41 get shape 2
put gbcb 216 get shape 3
put gbcb 220 get shape 0
put gbcb 221 get shape 1
put gbcb 222 get shape 2
cb = mapaddr get gbmem 1
words = get bindingCount 0
endva = add cb add 896 mul words 4
put gbcb 212 gbhi endva
put gbcb 213 gblo endva
put gbused 0 0
gbsetup
if ne get frameDirty 0 0
note Invalidate stale sysmem cache lines after CPU writes, before the first GPU load.
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
put frameDirty 0 0
end
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
gbdma add cb 896 uint words
for j ulong words
gbemit get bindings j
end
q = mapaddr get gbmem 2
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
put bindingCount 0 0
ret gbappend id get gbst 1
end

note SPDX-License-Identifier: AGPL-3.0-only
note One context, resident final-head weights, sequential binary residual frames until EOF.
global inputs long 9
const hStream ulong 0
const hMix ulong 1
const hWide ulong 2
const hHidden ulong 3
const hPacked ulong 4
const hStat ulong 5
const hGain ulong 6
const hWeight ulong 7
const hLogits ulong 8
global ioBuf uchar 1048576
text usage "Usage: dsv41-head MODEL-00043.safetensors < frames > logits\n"
text invalid "Invalid DeepSeek-V4.1-Flash output head shard.\n"
text deviceError "Native GPU stage/status: "
text endLine "\n"
text truncated "Short or unreadable residual frame.\n"
fn reportInt x long to void
b = new uchar 22 0
pos = ulong 21
v = ulong 0
if lt x 0
v = ulong neg x
else
v = ulong x
end
while true
pos = sub pos 1
put b pos uchar add 48 rem v 10
v = div v 10
if eq v 0
break
end
end
if lt x 0
pos = sub pos 1
put b pos 45
end
put b 21 32
r = write 2 b pos sub 22 pos
end
fn allocateInput slot ulong size ulong to bool
m = nvalloc size true
if le m 0
ret false
end
put inputs slot m
ret true
end
fn readWeights fd int n ulong pos ulong to bool
i = ulong 0
while lt i n
r = pread fd ioBuf i sub n i long add pos i
if le r 0
ret false
end
i = add i ulong r
end
ret true
end
fn uploadHead fd int to bool
p = add get stLayout 2 get stLayout 0
off = ulong 0
while lt off 1323827200
n = sub ulong 1323827200 off
if gt n len ioBuf
n = len ioBuf
end
if not readWeights fd n add p off
ret false
end
if ne mapwrite get inputs hWeight off ioBuf 0 n long n
ret false
end
off = add off n
end
ret uploadGain fd
end
fn uploadGain fd int to bool
if not readWeights fd 10240 add get stLayout 2 get stLayout 1
ret false
end
for i ulong 5120
raw = add ulong get ioBuf mul i 2 shl ulong get ioBuf add mul i 2 1 8
if ne mapset get inputs hGain mul i 4 4 shl raw 16 0
ret false
end
end
ret true
end
fn openHead fd int to bool
if not gbopen 1
ret false
end
if not gbbopen
ret false
end
m = nvalloc get codePos 0 false
if le m 0
ret false
end
put codeMap 0 m
headEmit
if ne get codeWriteFailed 0 0
ret false
end
ok = allocateInput hStream 40960
if not ok
ret false
end
if not allocateInput hMix 16
ret false
end
if not allocateInput hWide 81920
ret false
end
if not allocateInput hHidden 20480
ret false
end
if not allocateInput hPacked 10240
ret false
end
if not allocateInput hStat 4
ret false
end
if not allocateInput hGain 20480
ret false
end
if not allocateInput hWeight 1323827200
ret false
end
if not allocateInput hLogits 517120
ret false
end
ret uploadHead fd
end
fn bindHead slot ulong to void
headPtr get inputs slot
end
fn casting id ulong source ulong dest ulong width uint to bool
bindHead source
bindHead dest
headArg width
ret recordHeadKernel id div add width 127 128 128
end
fn headFrame to bool
if not gbbegin 8
ret false
end
put frameDirty 0 1
if not casting 0 hStream hWide 20480
ret false
end
bindHead hWide
bindHead hMix
bindHead hHidden
if not recordHeadKernel 1 40 128
ret false
end
if not casting 2 hHidden hPacked 5120
ret false
end
if not casting 0 hPacked hHidden 5120
ret false
end
bindHead hHidden
bindHead hStat
headArg 5120
if not recordHeadKernel 3 1 1
ret false
end
bindHead hHidden
bindHead hGain
bindHead hStat
bindHead hWide
headArg 5120
if not recordHeadKernel 4 40 128
ret false
end
if not casting 2 hWide hPacked 5120
ret false
end
bindHead hPacked
bindHead hWeight
bindHead hLogits
if not recordHeadKernel 5 129280 32
ret false
end
ret gbbsubmit 30000000000
end
fn nextFrame to int
n = ulong 0
while lt n 40976
r = read 0 ioBuf n sub 40976 n
if lt r 0
ret -1
end
if eq r 0
if eq n 0
ret 0
end
ret -1
end
n = add n ulong r
end
ret 1
end
fn session fd int to int
if not openHead fd
ret 74
end
while true
n = nextFrame
if eq n 0
ret 0
end
if lt n 0
r = write 2 truncated 0 len truncated
ret 65
end
if ne mapwrite get inputs hStream 0 ioBuf 0 40960 40960
ret 74
end
if ne mapwrite get inputs hMix 0 ioBuf 40960 16 16
ret 74
end
if not headFrame
ret 74
end
if ne mapread get inputs hLogits 0 ioBuf 0 517120 517120
ret 74
end
off = ulong 0
while lt off 517120
r = write 1 ioBuf off sub 517120 off
if le r 0
ret 74
end
off = add off ulong r
end
end
ret 0
end
fn main to int
path = new uchar 4096 0
n = argread 1 path 0 4096
if or ne argcnt 2 le n 0
r = write 2 usage 0 len usage
ret 64
end
fd = fopen path 0 ulong n 524288 0
if lt fd 0
ret 66
end
if not headShard int fd
r = write 2 invalid 0 len invalid
r = fclose int fd
ret 65
end
headEmit
rc = session int fd
if eq rc 74
r = write 2 deviceError 0 len deviceError
reportInt long get nvstage 0
reportInt get nverr 0
r = write 2 endLine 0 len endLine
end
if not nvstop
rc = int 74
end
r = fclose int fd
ret rc
end

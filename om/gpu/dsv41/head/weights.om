note SPDX-License-Identifier: AGPL-3.0-only
note Safetensors head shard. Offsets are relative to the end of its JSON header.
global stLayout ulong 3
text headName "head.weight"
text normName "norm.weight"
text dtypeName "dtype"
text shapeName "shape"
text offsetsName "data_offsets"
text bfName "BF16"

fn stMember stSource view uchar 65536 stTape view uint 4096 obj ulong name view uchar * to ulong
if ne js_type stTape obj jsobj
ret jsnone
end
k = js_first stTape obj
v = jsnone
while ne k jsnone
if js_streq stSource js_off stTape k name
if ne v jsnone
ret jsnone
end
v = add k 1
end
k = js_mnext stTape k
end
ret v
end
fn stUInt stSource view uchar 65536 stTape view uint 4096 token ulong to ulong
if ne js_type stTape token jsnum
ret 18446744073709551615
end
off = js_off stTape token
if not js_isu stSource off
ret 18446744073709551615
end
ret js_imag stSource off
end
fn stTensor stSource view uchar 65536 stTape view uint 4096 obj ulong matrix bool to bool
if eq obj jsnone
ret false
end
t = stMember stSource stTape obj dtypeName
if ne js_type stTape t jsstr
ret false
end
if not js_streq stSource js_off stTape t bfName
ret false
end
t = stMember stSource stTape obj shapeName
if ne js_type stTape t jsarr
ret false
end
i = js_first stTape t
size = ulong 10240
if matrix
if ne stUInt stSource stTape i 129280
ret false
end
i = js_enext stTape i
size = mul size 129280
end
if or ne stUInt stSource stTape i 5120 ne js_enext stTape i jsnone
ret false
end
t = stMember stSource stTape obj offsetsName
if or ne js_type stTape t jsarr ne js_nkids stTape t 2
ret false
end
i = js_first stTape t
begin = stUInt stSource stTape i
stop = stUInt stSource stTape js_enext stTape i
if or or gt begin stop gt stop 1323837440 ne sub stop begin size
ret false
end
slot = ulong 1
if matrix
slot = ulong 0
end
put stLayout slot begin
ret true
end
fn fileAt fd int buf edit uchar * n ulong pos ulong to bool
i = ulong 0
while lt i n
r = pread fd buf i sub n i long add pos i
if le r 0
ret false
end
i = add i ulong r
end
ret true
end
fn headShard fd int to bool
size = fseek fd 0 2
if lt size 8
ret false
end
prefix = new uchar 8 0
if not fileAt fd prefix 8 0
ret false
end
n = ulong 0
for j ulong 8
n = or n shl ulong get prefix j mul j 8
end
note The published head shard has exactly two tensors, with fixed payload sizes.
payload = ulong 1323837440
if or le ulong size payload ne n sub sub ulong size payload 8
ret false
end
note Seeded Omega's JSON API takes array views. The checkpoint's two descriptors use 176 bytes.
stSource = new uchar 65536 0
stTape = new uint 4096 0
if or eq n 0 gt n len stSource
ret false
end
if not fileAt fd stSource n 8
ret false
end
if ne get stSource 0 123
ret false
end
if ne js_init stTape n 64 0
ret false
end
if lt js_parse stSource stTape n 0
ret false
end
if ne js_nkids stTape 0 2
ret false
end
if not stTensor stSource stTape stMember stSource stTape 0 headName true
ret false
end
if not stTensor stSource stTape stMember stSource stTape 0 normName false
ret false
end
put stLayout 2 add n 8
ret adjacentHead
end
fn adjacentHead to bool
w = get stLayout 0
g = get stLayout 1
ret or and eq w 0 eq g 1323827200 and eq w 10240 eq g 0
end

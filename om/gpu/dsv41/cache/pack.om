note Layer-0 packer for the pinned DeepSeek V4.1 Flash release. Compose after seed/ng/sha256.om.
text headerHash "71213f444f9c15a4af6dbcbddc36f7611542884ebb3aadef54de650071357449"
global usedExpert uint 384
global plan uint 384
fn fillBytes fd int start ulong size ulong to bool
pos = ulong 0
while lt pos size
n = pread fd sh_dat pos sub size pos long add start pos
if le n 0
ret false
end
pos = add pos ulong n
end
ret true
end
fn putBytes size ulong to bool
pos = ulong 0
while lt pos size
n = write 1 sh_dat pos sub size pos
if le n 0
ret false
end
pos = add pos ulong n
end
ret true
end
fn checkShard fd int to bool
if ne fseek fd 0 2 7389759032
ret false
end
if not fillBytes fd 0 8
ret false
end
headerSize = ulong 0
for i ulong 8
headerSize = or headerSize shl ulong get sh_dat i mul i 8
end
if ne headerSize 258136
ret false
end
if not fillBytes fd 8 headerSize
ret false
end
sh_all headerSize
for i ulong 32
b = uint get sh_dig i
if ne sh_hexd shr b 4 get headerHash mul 2 i
ret false
end
if ne sh_hexd and b 15 get headerHash add mul 2 i 1
ret false
end
end
ret true
end
fn idArg arg ulong to uint
b = new uchar 4 0
n = argread arg b 0 4
if or le n 0 gt n 3
ret 384
end
v = uint 0
for j ulong ulong n
c = uint get b j
if or lt c 48 gt c 57
ret 384
end
v = add mul v 10 sub c 48
end
ret v
end
note Decimal strings use lexicographic order in this verified header. Base 11 reserves zero for EOS.
fn lexKey id uint to uint
if lt id 10
ret mul add id 1 121
end
if lt id 100
ret add mul add div id 10 1 121 mul add rem id 10 1 11
end
a = mul add div id 100 1 121
b = mul add rem div id 10 10 1 11
ret add add a b add rem id 10 1
end
fn sourceRow id uint to ulong
key = lexKey id
row = ulong 0
for i uint 384
if lt lexKey i key
row = add row 1
end
end
ret row
end
fn emitExtent fd int base ulong size ulong to bool
pos = ulong 0
while lt pos size
chunk = sub size pos
if gt chunk 1048576
chunk = 1048576
end
if not fillBytes fd add base pos chunk
ret false
end
if not putBytes chunk
ret false
end
pos = add pos chunk
end
ret true
end
fn store32 pos ulong v uint to void
for j ulong 4
put sh_dat add pos j uchar and shr v mul j 8 255
end
end
fn emitPack fd int count uint to bool
for i ulong 4096
put sh_dat i 0
end
store32 0 0x31505844
store32 4 1
store32 8 count
store32 12 18800640
for i uint count
store32 add 16 mul ulong i 4 get plan i
end
if not putBytes 4096
ret false
end
for i uint count
row = sourceRow get plan i
if not emitExtent fd add 594986552 mul row 17694720 17694720
ret false
end
if not emitExtent fd add 8273720 mul row 1105920 1105920
ret false
end
end
ret true
end
fn main to int
if or lt argcnt 3 gt argcnt 386
ret 64
end
count = sub uint argcnt 2
for j uint count
id = idArg ulong add j 2
if ge id 384
ret 64
end
if ne get usedExpert id 0
ret 64
end
put usedExpert id 1
put plan j id
end
path = new uchar 4096 0
n = argread 1 path 0 4096
if le n 0
ret 64
end
fd = fopen path 0 ulong n 524288 0
if lt fd 0
ret 66
end
rc = int 65
if checkShard int fd
rc = int 74
if emitPack int fd count
rc = int 0
end
end
closed = fclose int fd
ret rc
end

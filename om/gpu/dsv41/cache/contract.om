note Host-only controls for ownership, partial transfers, stale completions, ABA and turn hysteresis.
fn exchange t edit slabtab q edit nvqueue a edit slab b edit slab x edit nvreq y edit nvreq to int
request x 0 5 4096
request y 1 6 18804736
if not beginRead t q a x
ret 11
end
if not beginRead t q b y
ret 12
end
if freeEntry q
ret 13
end
if complete a y 2 expertBytes 0
ret 14
end
if not complete b y 2 expertBytes 0
ret 15
end
if reap q y
ret 16
end
if not complete a x 1 sub expertBytes 1 0
ret 17
end
if ne acquire t a 5 0
ret 18
end
if not reap q x
ret 19
end
if not reap q y
ret 20
end
if or reap q y complete b y 2 expertBytes 0
ret 21
end
returnCode = lockCheck t q b x
ret returnCode
end
fn lockCheck t edit slabtab q edit nvqueue s edit slab r edit nvreq to int
lease = acquire t s 6
if eq lease 0
ret 23
end
request r 1 7 18804736
if beginRead t q s r
ret 24
end
if release s 6 add lease 1
ret 25
end
if not release s 6 lease
ret 26
end
if not beginRead t q s r
ret 27
end
if complete s r 2 expertBytes 0
ret 28
end
if not complete s r 3 expertBytes -5
ret 29
end
if ne acquire t s 7 0
ret 30
end
if not reap q r
ret 31
end
ret 0
end
fn votes t edit slabtab to int
if observe t 1 1
ret 33
end
if observe t 1 1
ret 34
end
if observe t 3 1
ret 35
end
if observe t 4 noDomain
ret 36
end
if observe t 5 2
ret 37
end
if observe t 6 2
ret 38
end
if not observe t 7 2
ret 39
end
ret 0
end
fn testRing t edit slabtab q edit nvqueue to int
if not cacheStart t 1 1
ret 1
end
if not ringStart q 2
ret 2
end
a = new uchar 64 0
b = new uchar 64 0
x = new uchar 64 0
y = new uchar 64 0
rc = exchange t q a b x y
if ne rc 0
ret rc
end
ret votes t
end
fn heldPack t edit slabtab q edit nvqueue s edit slab r edit nvreq table long to int
request r 0 8 4096
if not beginRead t q s r
ret 40
end
if commitPack t q table
ret 41
end
if not complete s r get r ticket expertBytes 0
ret 42
end
if not reap q r
ret 43
end
request r 0 9 18804736
if beginRead t q s r
ret 44
end
lease = acquire t s 8
if eq lease 0
ret 45
end
if ne mapwrite table 0 s 0 64 64
ret 46
end
if commitPack t q table
ret 47
end
if not release s 8 lease
ret 48
end
if ne mapwrite table 0 s 0 64 64
ret 49
end
if not commitPack t q table
ret 50
end
if ne acquire t s 8 0
ret 51
end
ret 0
end
fn main to int
t = new uchar 64 0
q = new uchar 64 0
rc = testRing t q
if ne rc 0
ret rc
end
s = new uchar 64 0
r = new uchar 64 0
table = mapnew -1 0 128 3 33
if le table 0
ret 52
end
rc = heldPack t q s r table
closed = mapdrop table
ret rc
end

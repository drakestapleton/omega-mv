note SPDX-License-Identifier: AGPL-3.0-only
note CLI entrypoint for inkling2-decode (composes after om/gpu/inkling2/decoder/decode.om).

fn main to int
ikDPrint ikDMsgBanner
ikDPrint ikDMsgLoad
t0 = monons
rc0 = ikDInitAll
if ne rc0 0
ikDPrint ikDMsgFail
ikDPrintU ulong rc0
ikDPrint ikDMsgNl
ret rc0
end
t1 = monons
ikDPrint ikDMsgLoaded
ikDPrintU ulong div sub t1 t0 1000000
ikDPrint ikDMsgNl
ikArbResetAll
for i ulong 3072
put ikDArbRes i -1
end
for i ulong 4
put ikDArbStats i 0
end
rc1 = ikDRunPrompt
ikDPrint ikDMsgArb
ikDPrintU get ikDArbStats 0
ikDPrint ikDMsgHit8
ikDPrintU get ikDArbStats 1
ikDPrint ikDMsgHit16
ikDPrintU get ikDArbStats 2
ikDPrint ikDMsgNl
rc = nvmclose
ret rc1
end

note SPDX-License-Identifier: AGPL-3.0-only
note 100% Pure Seeded-Omega Real-Weight End-to-End Inkling-2-Mini Decoder on GB10.
note ZERO libcuda.so.1, ZERO libc, ZERO Python, ZERO C.
note Composes: context.om + vector.om + launch.om + batch.om + bw_enc_sm121.om + emit_fast.om
note           + arboris/prefetch.om + safetensors.om + tokenizer.om + decode.om.

const IK_TMAX ulong 512
const IK_KV_LAYER_BYTES ulong 2097152
const IK_KV_HALF_BYTES ulong 1048576
const IK_SCONV_LAYER_BYTES ulong 79872
const IK_KV_SLOT_BYTES ulong 100663296
const IK_SCONV_SLOT_BYTES ulong 3833856

global ikDSlot ulong 1
global ikDKCode long 1
global ikDKCodePos ulong 1
global ikDKCodeFail uint 1
global ikDKOff ulong 24
global ikDKSmem uint 24
global ikDKLut long 1
global ikDWork long 1
global ikDWorkVa ulong 1
global ikDKv long 1
global ikDKvVa ulong 1
global ikDArg uint 32
global ikDArgC ulong 1
global ikDPkt long 1
global ikDPktPos ulong 1
global ikDOutBuf uchar 65536
global ikDProjTmp f32 16384
global ikDRLatTmp f32 384
global ikDPromptIds uint 1024
global ikDPromptLen ulong 1
global ikDBlockCnt ulong 1
global ikDPreBlockCnt ulong 1
global ikDPrevBlockCnt ulong 1

note Live Arboris online hit-rate counters across real Inkling-2-Mini routing traces:
global ikDArbRes long 3072
global ikDArbScores ulong 128
global ikDArbPred8 uint 16
global ikDArbPred16 uint 32
global ikDArbHasPred ulong 1
global ikDArbStats ulong 4

text ikDMsgBanner "=== INKLING-2-MINI 100% PURE SEEDED-OMEGA REAL-WEIGHT DECODER (ZERO CUDA) ===\n"
text ikDMsgLoad "Loading real checkpoint (~18.3 GB) + tokenizer into GB10 UVM...\n"
text ikDMsgLoaded "Loaded checkpoint in ms: "
text ikDMsgPrompt "Prompt tokens: "
text ikDMsgGen "Generated: "
text ikDMsgStats "\nDecode summary: tokens="
text ikDMsgMs " avg_ms_per_tok="
text ikDMsgArb "\nLive Arboris (real routing): transitions="
text ikDMsgHit8 " top8_hits="
text ikDMsgHit16 " top16_hits="
text ikDMsgFail "FAIL: decoder error stage="
text ikDMsgNl "\n"
text ikDDefDir "/home/drakestapleton/models/inkling-2-mini-ed40e7da"
text ikDSufSt "/model-00001-of-00001.safetensors"
text ikDSufTok "/tokenizer.json"
text ikDDefPrompt "What is the capital of France? Answer in one sentence."

fn ikDPrint s view uchar * to void
w = write 1 s 0 len s
end

fn ikDPrintU v ulong to void
b = new uchar 32 0
if eq v 0
put b 0 48
w = write 1 b 0 1
ret
end
n = ulong 0
x = v
while gt x 0 bound 32
put b n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
for i ulong n bound 32
p = sub sub n 1 i
w = write 1 b p 1
end
end

fn ikDW off ulong to ulong
ret add get ikDWorkVa 0 off
end

fn ikDKvVaStep step ulong to ulong
sOff = mul get ikDSlot 0 IK_KV_SLOT_BYTES
lOff = mul step IK_KV_LAYER_BYTES
ret add get ikDKvVa 0 add sOff lOff
end

fn ikDScBaseStep step ulong to ulong
sOff = mul get ikDSlot 0 IK_SCONV_SLOT_BYTES
lOff = mul step IK_SCONV_LAYER_BYTES
ret add 0x500000 add sOff lOff
end

fn ikDF32Bits f f32 to uint
ret bitcast uint f
end

fn ikDBuildLut to bool
m = nvalloc 4096 true
if le m 0
ret false
end
put ikDKLut 0 m
for i ulong 256
s = and shr i 7 1
e = and shr i 3 15
mn = and i 7
v = f32 0.0f32
if eq e 15
if eq mn 7
v = bitcast f32 uint 0x7fc00000
else
v = mul f32 256.0f32 add f32 1.0f32 div f32 mn f32 8.0f32
end
else
if eq e 0
v = mul f32 0.015625f32 div f32 mn f32 8.0f32
else
pw = f32 1.0f32
if ge e 7
for k ulong sub e 7 bound 16
pw = mul pw f32 2.0f32
end
else
for k ulong sub 7 e bound 16
pw = mul pw f32 0.5f32
end
end
v = mul pw add f32 1.0f32 div f32 mn f32 8.0f32
end
end
if eq s 1
v = sub f32 0.0f32 v
end
r = mapset m mul i 4 4 ulong ikDF32Bits v
end
e2 = new f32 16 0.0f32
put e2 0 0.0f32
put e2 1 0.5f32
put e2 2 1.0f32
put e2 3 1.5f32
put e2 4 2.0f32
put e2 5 3.0f32
put e2 6 4.0f32
put e2 7 6.0f32
put e2 8 -0.0f32
put e2 9 -0.5f32
put e2 10 -1.0f32
put e2 11 -1.5f32
put e2 12 -2.0f32
put e2 13 -3.0f32
put e2 14 -4.0f32
put e2 15 -6.0f32
for i ulong 16
r = mapset m mul add 256 i 4 4 ulong ikDF32Bits get e2 i
end
ret true
end

fn ikfWrite w view ulong 4 to void
p = get ikDKCodePos 0
b = new uchar 16 0
if gt get ikDKCode 0 0
for i ulong 16
put b i uchar and shr get w div i 4 mul rem i 4 8 255
end
if ne mapwrite get ikDKCode 0 p b 0 16 16
put ikDKCodeFail 0 1
end
end
put ikDKCodePos 0 add p 16
end

fn ikDInitKernels to bool
cm = nvalloc 262144 false
if le cm 0
ret false
end
put ikDKCode 0 cm
put ikDKCodePos 0 0
put ikDKCodeFail 0 0
sm = new uint 21 0
put sm 0 18432
put sm 1 12288
put sm 2 12288
put sm 3 6144
put sm 4 512
put sm 5 256
put sm 6 10752
put sm 7 0
put sm 8 1088
put sm 9 1088
put sm 10 0
put sm 11 0
put sm 12 2048
put sm 13 6144
put sm 14 0
put sm 15 0
put sm 16 256
put sm 17 9280
put sm 18 0
put sm 19 0
put sm 20 0
for k ulong 21
p = mul div add get ikDKCodePos 0 255 256 256
put ikDKOff k p
put ikDKCodePos 0 p
put ikDKSmem k get sm k
put ikfPc 0 0
put ikfGuard 0 0
ok = ikfKernel uchar add 97 k
if not ok
ret false
end
ikfDone
if ne get ikDKCodeFail 0 0
ret false
end
end
ret true
end

fn ikDArgReset to void
put ikDArgC 0 0
end

fn ikDPtr va ulong to void
c = get ikDArgC 0
put ikDArg c gblo va
put ikDArg add c 1 gbhi va
put ikDArgC 0 add c 2
end

fn ikDArgU v uint to void
c = get ikDArgC 0
put ikDArg c v
put ikDArgC 0 add c 1
end

fn ikDQmd k ulong gx uint gy uint gz uint bx uint to void
gbqmd 1
code = add mapaddr get ikDKCode 0 get ikDKOff k
put gbq1 32 gblo shr code 4
put gbq1 33 or uint and shr code 36 2097151 20971520
put gbq1 34 or shl uint 1 16 bx
put gbq1 35 or uint 131073 shl uint 64 8
sm = get ikDKSmem k
if eq sm 0
put gbq1 36 78923784
else
put gbq1 36 or uint 78923776 div add sm 127 128
end
put gbq1 37 0
put gbq1 39 gx
put gbq1 40 gy
put gbq1 41 gz
put gbq1 59 gblo shr code 8
end

note Fast single-batch GPFIFO builder: uploads driver cb template ONCE per batch, not per kernel.
fn ikDBatchStart to bool
put gbused 0 0
gbsetup
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
cb = mapaddr get gbmem 1
gbdriver cb
gbdma cb 224
for i ulong 224
gbemit get gbcb i
end
n = get gbused 0
r = mapwrite get ikDPkt 0 0 gbcmd 0 n
if ne r long n
ret false
end
put ikDPktPos 0 n
ret true
end

fn ikDBatchAdd k ulong gx uint gy uint gz uint bx uint to bool
ikDQmd k gx gy gz bx
put gbused 0 0
cb = mapaddr get gbmem 1
q = mapaddr get gbmem 2
argc = uint get ikDArgC 0
gbdma add cb 896 argc
for i ulong get ikDArgC 0 bound 32
gbemit get ikDArg i
end
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
va = mapaddr get gbmem 3
gbrel add va 32 6
gbmth 1 540 1
gbemit 4113
n = get gbused 0
pos = get ikDPktPos 0
if gt add pos n 1048000
ret false
end
r = mapwrite get ikDPkt 0 pos gbcmd 0 n
if ne r long n
ret false
end
put ikDPktPos 0 add pos n
ikDArgReset
ret true
end

fn ikDBatchRun to bool
put gbused 0 0
gbtail
n = get gbused 0
pos = get ikDPktPos 0
r = mapwrite get ikDPkt 0 pos gbcmd 0 n
if ne r long n
ret false
end
tot = add pos n
r = mapset get gbmem 2 8192 4 0
r = mapset get gbmem 3 0 4 0
r = mapset get gbmem 3 16 4 0
if not nvsend get ikDPkt 0 0 uint div tot 4
ret false
end
if not nvwait get gbmem 3 16 1179010630 15000000000
ret false
end
ret eq mapget get gbmem 3 0 4 1145324612
end

fn ikDRunOne k ulong gx uint gy uint gz uint bx uint to bool
if not ikDBatchStart
ret false
end
if not ikDBatchAdd k gx gy gz bx
ret false
end
ret ikDBatchRun
end

fn ikDReadF32 m long off ulong to f32
ret bitcast f32 uint mapget m off 4
end

fn ikDWriteF32 m long off ulong v f32 to void
r = mapset m off 4 ulong bitcast uint v
end

fn ikDReadBf16Buf idx ulong to f32
o = mul idx 2
lo = uint get ikDOutBuf o
hi = shl uint get ikDOutBuf add o 1 8
ret bitcast f32 shl or lo hi 16
end

fn ikDEmbedWrite invRms f32 to void
ar = get ikStArena 0
normBase = sub get ikGW 1 get ikStArenaVa 0
wk = get ikDWork 0
for i ulong 2304
g = ikDReadF32 ar add normBase mul i 4
v = mul mul get ikDProjTmp i invRms g
ikDWriteF32 wk mul i 4 v
end
end

note CPU helper: embed lookup (BF16 -> FP32) + embed_norm (RMSNorm) into work[0x000000].
fn ikDEmbed tok ulong to void
ar = get ikStArena 0
embBase = add sub get ikGW 0 get ikStArenaVa 0 mul tok 4608
r = mapread ar embBase ikDOutBuf 0 4608
sq = f32 0.0f32
for i ulong 2304
v = ikDReadBf16Buf i
put ikDProjTmp i v
sq = add sq mul v v
end
invRms = div f32 1.0f32 fsqrt add div sq f32 2304.0f32 f32 0.000001f32
ikDEmbedWrite invRms
end

note Copy 2304 FP32 values inside ikDWork (9216 bytes).
fn ikDCopy2304 dstOff ulong srcOff ulong to void
wk = get ikDWork 0
r = mapread wk srcOff ikDOutBuf 0 9216
r = mapwrite wk dstOff ikDOutBuf 0 9216
end

fn ikDCopyBlocks dstOff ulong srcOff ulong nBlocks ulong to void
wk = get ikDWork 0
for b ulong nBlocks bound 16
r = mapread wk add srcOff mul b 9216 ikDOutBuf 0 9216
r = mapwrite wk add dstOff mul b 9216 ikDOutBuf 0 9216
end
end

note Run BlockAttentionResidual: cat(block_states[0..k-1], partial) -> unweighted RMSNorm -> attn_res_fast.
fn ikDAttnRes blkOff ulong nBlk ulong partialOff ulong qVa ulong qCnt uint outOff ulong to bool
wk = get ikDWork 0
ikDCopy2304 add blkOff mul nBlk 9216 partialOff
kTot = add nBlk 1
if not ikDBatchStart
ret false
end
ikDArgReset
ikDPtr ikDW blkOff
ikDPtr 0
ikDPtr ikDW 0x0f0000
ikDArgU 2304
if not ikDBatchAdd 5 uint kTot 1 1 256
ret false
end
ikDPtr ikDW 0x0f0000
ikDPtr qVa
ikDPtr ikDW outOff
ikDArgU uint kTot
ikDArgU qCnt
ikDArgU 2304
if not ikDBatchAdd 4 qCnt 1 1 256
ret false
end
ret ikDBatchRun
end

fn ikDReadArenaChunk va ulong nbytes ulong to void
for a ulong 4
base = get ikStArenaVa a
if and ge va base lt va add base IK_ARENA_SZ
r = mapread get ikStArena a sub va base ikDOutBuf 0 nbytes
ret
end
end
end

fn ikDMgUpProj wVa ulong outOff ulong to void
wk = get ikDWork 0
for i ulong 64
put ikDRLatTmp i ikDReadF32 wk add 0x1d5000 mul i 4
end
for blk ulong 9
ikDReadArenaChunk add wVa mul blk 32768 32768
for r ulong 256
acc = f32 0.0f32
rowIdx = add mul blk 256 r
for c ulong 64
w = ikDReadBf16Buf add mul r 64 c
acc = add acc mul w get ikDRLatTmp c
end
ikDWriteF32 wk add outOff mul rowIdx 4 acc
end
end
end

note Run Inkling2LoopMessageGate: (1 - tanh(f))*h + tanh(m)*msg using layer l controller ctrlIdx (0:attn,1:k,2:v,3:mlp).
fn ikDMsgGate l ulong ctrlIdx ulong hOff ulong msgOff ulong outOff ulong to bool
slotBase = add 28 mul ctrlIdx 3
if not ikDBatchStart
ret false
end
ikDArgReset
ikDPtr ikDW hOff
ikDPtr 0
ikDPtr ikDW 0x1d0000
ikDArgU 2304
if not ikDBatchAdd 5 1 1 1 256
ret false
end
ikDPtr ikDW msgOff
ikDPtr 0
ikDPtr ikDW 0x1d2400
ikDArgU 2304
if not ikDBatchAdd 5 1 1 1 256
ret false
end
ikDPtr ikLva l slotBase
ikDPtr ikDW 0x1d0000
ikDPtr ikDW 0x1d5000
ikDArgU 4608
ikDArgU 64
if not ikDBatchAdd 0 2 1 1 256
ret false
end
if not ikDBatchRun
ret false
end
ikDMgUpProj ikLva l add slotBase 1 0x1d6000
ikDMgUpProj ikLva l add slotBase 2 0x1d9000
if not ikDBatchStart
ret false
end
ikDArgReset
ikDPtr ikDW hOff
ikDPtr ikDW msgOff
ikDPtr ikDW 0x1d6000
ikDPtr ikDW 0x1d9000
ikDPtr ikDW outOff
ikDArgU 2304
if not ikDBatchAdd 19 18 1 1 128
ret false
end
ret ikDBatchRun
end

note Compute cross-pass 4 messages [q, k, v, mlp] into work[0x1c0000] from prev_pass_blocks.
fn ikDCrossPassMsgs loopIdx ulong to bool
nPrev = get ikDPrevBlockCnt 0
vaQ = add get ikGW 5 mul mul loopIdx 2 9216
vaKV = add get ikGW 6 mul mul loopIdx 2 9216
if not ikDBatchStart
ret false
end
ikDArgReset
ikDPtr ikDW 0x160000
ikDPtr 0
ikDPtr ikDW 0x190000
ikDArgU 2304
if not ikDBatchAdd 5 uint nPrev 1 1 256
ret false
end
ikDPtr ikDW 0x190000
ikDPtr vaQ
ikDPtr ikDW 0x1c0000
ikDArgU uint nPrev
ikDArgU 1
ikDArgU 2304
if not ikDBatchAdd 4 1 1 1 256
ret false
end
ikDPtr ikDW 0x190000
ikDPtr add vaQ 9216
ikDPtr ikDW 0x1c6c00
ikDArgU uint nPrev
ikDArgU 1
ikDArgU 2304
if not ikDBatchAdd 4 1 1 1 256
ret false
end
ikDPtr ikDW 0x190000
ikDPtr vaKV
ikDPtr ikDW 0x1c2400
ikDArgU uint nPrev
ikDArgU 2
ikDArgU 2304
if not ikDBatchAdd 4 2 1 1 256
ret false
end
ret ikDBatchRun
end

fn ikDRelDot h ulong dMax ulong to void
wk = get ikDWork 0
hOff = add 0x020000 mul mul h 1024 4
for d ulong dMax bound 1024
acc = f32 0.0f32
for rr ulong 16
a = get ikDRLatTmp add mul h 16 rr
b = get ikDProjTmp add mul rr 1024 d
acc = add acc mul a b
end
ikDWriteF32 wk add hOff mul d 4 acc
end
end

note Compute rel_bias[24, 1024] on CPU from R_lat[24, 16] (FP32) @ rel_logits_proj[16, 1024] (BF16).
fn ikDComputeRelBias l ulong posQ ulong to void
wk = get ikDWork 0
projBase = sub get ikLW add mul l 40 7 get ikStArenaVa 0
r = mapread get ikStArena 0 projBase ikDOutBuf 0 32768
for i ulong 384
put ikDRLatTmp i ikDReadF32 wk add 0x01c000 mul i 4
end
dMax = add posQ 1
if gt dMax 1024
dMax = ulong 1024
end
for rr ulong 16
for d ulong dMax bound 1024
idx = add mul rr 1024 d
put ikDProjTmp idx ikDReadBf16Buf idx
end
end
for h ulong 24
ikDRelDot h dMax
end
end

fn ikDPackKvHead h ulong to void
wk = get ikDWork 0
for d ulong 128
idx = mul add mul h 128 d 4
kb = mapget wk add 0x014000 idx 4
vb = mapget wk add 0x016000 idx 4
o = mul d 2
put ikDOutBuf o uchar and shr kb 16 255
put ikDOutBuf add o 1 uchar and shr kb 24 255
put ikDOutBuf add 256 o uchar and shr vb 16 255
put ikDOutBuf add 257 o uchar and shr vb 24 255
end
end

fn ikDAppendKvHead step ulong posQ ulong h ulong to void
ikDPackKvHead h
kv = get ikDKv 0
kBase = add mul get ikDSlot 0 IK_KV_SLOT_BYTES mul step IK_KV_LAYER_BYTES
hOff = add mul h mul IK_TMAX 256 mul posQ 256
r = mapwrite kv add kBase hOff ikDOutBuf 0 256
r = mapwrite kv add add kBase IK_KV_HALF_BYTES hOff ikDOutBuf 256 256
end

note Write current token K[8, 128] and V[8, 128] (FP32) into KV cache BF16 slot posQ for logical layer step.
fn ikDAppendKv step ulong posQ ulong to void
for h ulong 8
ikDAppendKvHead step posQ h
end
end

note Live Arboris hook: score next transition, check hits against actual top-8, and update graph.
fn ikDArbStep step ulong l ulong to void
wk = get ikDWork 0
ids = new uint 8 0
scores = new ulong 128 0
for i ulong 8
put ids i uint mapget wk add 0x058400 mul i 4 4
end
if eq get ikDArbHasPred 0 1
put ikDArbStats 0 add get ikDArbStats 0 1
for i ulong 8
eid = get ids i
for j ulong 8
if eq get ikDArbPred8 j eid
put ikDArbStats 1 add get ikDArbStats 1 1
break
end
end
for j ulong 16
if eq get ikDArbPred16 j eid
put ikDArbStats 2 add get ikDArbStats 2 1
break
end
end
end
end
ikArbUpdate l ids
trans = l
nextL = add l 1
if and eq l 17 lt step 40
trans = ulong 23
nextL = ulong 6
end
if lt nextL 24
ikArbScoreNext trans ids scores
for k ulong 16
best = ulong 128
bestSc = ulong 0
for e ulong 128
sc = get scores e
if gt sc bestSc
bestSc = sc
best = e
end
end
if lt best 128
put ikDArbPred16 k uint best
if lt k 8
put ikDArbPred8 k uint best
end
put scores best 0
else
put ikDArbPred16 k 0xffffffff
if lt k 8
put ikDArbPred8 k 0xffffffff
end
end
end
put ikDArbHasPred 0 1
else
put ikDArbHasPred 0 0
end
end

fn ikDSig x f32 to f32
y = sub f32 0.0f32 x
if gt y f32 20.0f32
ret f32 0.0f32
end
if lt y f32 -20.0f32
ret f32 1.0f32
end
z = mul y f32 1.4426950408889634f32
k = int z
if lt z f32 0.0f32
k = sub k 1
end
f = sub z f32 k
p = add f32 1.0f32 mul f add f32 0.69314718f32 mul f add f32 0.24022651f32 mul f add f32 0.05550411f32 mul f f32 0.00961813f32
bits = shl uint add k 127 23
e = mul bitcast f32 bits p
ret div f32 1.0f32 add f32 1.0f32 e
end

fn ikDApplyGate to void
wk = get ikDWork 0
for i ulong 3072
o = mul i 4
ao = ikDReadF32 wk add 0x040000 o
ga = ikDReadF32 wk add 0x018000 o
ikDWriteF32 wk add 0x040000 o mul ao ikDSig ga
end
end

fn ikDRunLayerAttn step ulong l ulong posQ ulong hasMsgs bool to bool
isFull = or or eq l 5 eq l 11 or eq l 17 eq l 23
wk = get ikDWork 0
ikDCopy2304 0x04c000 0x000000
if gt l 0
qCnt = uint 1
if isFull
qCnt = uint 3
end
qVa = get ikAttnQOff sub l 1
if not ikDAttnRes 0x0c0000 get ikDBlockCnt 0 0x000000 qVa qCnt 0x0b0000
ret false
end
else
ikDCopy2304 0x0b0000 0x000000
end
if hasMsgs
if not ikDMsgGate l 0 0x0b0000 0x1c0000 0x000000
ret false
end
if isFull
if not ikDMsgGate l 1 0x0b2400 0x1c2400 0x008000
ret false
end
if not ikDMsgGate l 2 0x0b4800 0x1c4800 0x00c000
ret false
end
else
if not ikDMsgGate l 1 0x0b0000 0x1c2400 0x008000
ret false
end
if not ikDMsgGate l 2 0x0b0000 0x1c4800 0x00c000
ret false
end
end
else
ikDCopy2304 0x000000 0x0b0000
if isFull
ikDCopy2304 0x008000 0x0b2400
ikDCopy2304 0x00c000 0x0b4800
else
ikDCopy2304 0x008000 0x0b0000
ikDCopy2304 0x00c000 0x0b0000
end
end
tau = f32 1.0f32
ikDWriteF32 wk 0x1e0000 tau
if not ikDBatchStart
ret false
end
ikDArgReset
ikDPtr ikDW 0x000000
ikDPtr ikLva l 16
ikDPtr ikDW 0x004000
ikDArgU 2304
if not ikDBatchAdd 5 1 1 1 256
ret false
end
if isFull
ikDPtr ikDW 0x008000
ikDPtr ikLva l 17
ikDPtr ikDW 0x008000
ikDArgU 2304
if not ikDBatchAdd 5 1 1 1 256
ret false
end
ikDPtr ikDW 0x00c000
ikDPtr ikLva l 18
ikDPtr ikDW 0x00c000
ikDArgU 2304
if not ikDBatchAdd 5 1 1 1 256
ret false
end
else
ikDPtr ikDW 0x008000
ikDPtr ikLva l 16
ikDPtr ikDW 0x008000
ikDArgU 2304
if not ikDBatchAdd 5 1 1 1 256
ret false
end
ikDPtr ikDW 0x00c000
ikDPtr ikLva l 16
ikDPtr ikDW 0x00c000
ikDArgU 2304
if not ikDBatchAdd 5 1 1 1 256
ret false
end
end
ikDPtr ikLva l 0
ikDPtr ikDW 0x004000
ikDPtr ikDW 0x010000
ikDArgU 2304
ikDArgU 3072
if not ikDBatchAdd 0 96 1 1 256
ret false
end
ikDPtr ikLva l 1
ikDPtr ikDW 0x008000
ikDPtr ikDW 0x014000
ikDArgU 2304
ikDArgU 1024
if not ikDBatchAdd 0 32 1 1 256
ret false
end
ikDPtr ikLva l 2
ikDPtr ikDW 0x00c000
ikDPtr ikDW 0x016000
ikDArgU 2304
ikDArgU 1024
if not ikDBatchAdd 0 32 1 1 256
ret false
end
ikDPtr ikLva l 3
ikDPtr ikDW 0x004000
ikDPtr ikDW 0x01c000
ikDArgU 2304
ikDArgU 384
if not ikDBatchAdd 0 12 1 1 256
ret false
end
ikDPtr ikLva l 5
ikDPtr ikDW 0x004000
ikDPtr ikDW 0x018000
ikDArgU 2304
ikDArgU 3072
if not ikDBatchAdd 0 96 1 1 256
ret false
end
ikDPtr ikLva l 6
ikDPtr ikDW 0x004000
ikDPtr ikDW 0x01d000
ikDArgU 2304
ikDArgU 24
if not ikDBatchAdd 0 1 1 1 256
ret false
end
scBase = ikDScBaseStep step
if isFull
ikDPtr ikLva l 12
ikDPtr ikDW 0x008000
ikDPtr ikDW 0x01e000
ikDArgU 2304
ikDArgU 32
if not ikDBatchAdd 0 1 1 1 256
ret false
end
ikDPtr ikLva l 13
ikDPtr ikDW 0x00c000
ikDPtr ikDW 0x01e100
ikDArgU 2304
ikDArgU 32
if not ikDBatchAdd 0 1 1 1 256
ret false
end
ikDPtr ikDW 0x014000
ikDPtr ikDW scBase
ikDPtr ikLva l 10
ikDPtr ikDW 0x01e000
ikDPtr ikDW 0x014000
ikDArgU 1024
ikDArgU 7
if not ikDBatchAdd 18 8 1 1 128
ret false
end
ikDPtr ikDW 0x016000
ikDPtr ikDW add scBase 12288
ikDPtr ikLva l 11
ikDPtr ikDW 0x01e100
ikDPtr ikDW 0x016000
ikDArgU 1024
ikDArgU 7
if not ikDBatchAdd 18 8 1 1 128
ret false
end
else
ikDPtr ikDW 0x014000
ikDPtr ikDW scBase
ikDPtr ikLva l 10
ikDPtr ikDW 0x014000
ikDArgU 1024
if not ikDBatchAdd 11 8 1 1 128
ret false
end
ikDPtr ikDW 0x016000
ikDPtr ikDW add scBase 12288
ikDPtr ikLva l 11
ikDPtr ikDW 0x016000
ikDArgU 1024
if not ikDBatchAdd 11 8 1 1 128
ret false
end
end
ikDPtr ikDW 0x010000
ikDPtr ikLva l 8
ikDPtr ikDW 0x1e0000
ikDPtr ikDW 0x010000
ikDArgU 24
ikDArgU 128
ikDArgU ikDF32Bits 22.627417f32
if isFull
ikDArgU 3
else
ikDArgU 1
end
if not ikDBatchAdd 7 24 1 1 32
ret false
end
ikDPtr ikDW 0x014000
ikDPtr 0
ikDPtr 0
ikDPtr ikDW 0x014000
ikDArgU 8
ikDArgU 128
ikDArgU ikDF32Bits 22.627417f32
ikDArgU 0
if not ikDBatchAdd 7 8 1 1 32
ret false
end
ikDPtr ikDW 0x016000
ikDPtr 0
ikDPtr ikDW 0x016000
ikDArgU 128
if not ikDBatchAdd 5 8 1 1 256
ret false
end
ikDPtr ikDW 0x01c000
ikDPtr ikLva l 9
ikDPtr ikDW 0x1e0000
ikDPtr ikDW 0x01c000
ikDArgU 24
ikDArgU 16
ikDArgU ikDF32Bits 8.0f32
if isFull
ikDArgU 3
else
ikDArgU 1
end
if not ikDBatchAdd 7 24 1 1 32
ret false
end
if not ikDBatchRun
ret false
end
ikDComputeRelBias l posQ
ikDAppendKv step posQ
kva = ikDKvVaStep step
if not ikDBatchStart
ret false
end
ikDArgReset
ikDPtr ikDW 0x010000
ikDPtr kva
ikDPtr add kva IK_KV_HALF_BYTES
ikDPtr ikDW 0x020000
ikDPtr ikDW 0x01d000
ikDPtr ikDW 0x040000
ikDArgU 24
ikDArgU 8
ikDArgU uint IK_TMAX
ikDArgU 1024
ikDArgU uint posQ
if isFull
ikDArgU 0
else
ikDArgU 1024
end
if not ikDBatchAdd 3 24 1 1 256
ret false
end
if not ikDBatchRun
ret false
end
ikDApplyGate
if not ikDBatchStart
ret false
end
ikDArgReset
ikDPtr ikLva l 4
ikDPtr ikDW 0x040000
ikDPtr ikDW 0x044000
ikDArgU 3072
ikDArgU 2304
if not ikDBatchAdd 0 72 1 1 256
ret false
end
ikDPtr ikDW 0x044000
ikDPtr ikDW add scBase 24576
ikDPtr ikLva l 14
ikDPtr ikDW 0x048000
ikDArgU 2304
if not ikDBatchAdd 11 18 1 1 128
ret false
end
ret ikDBatchRun
end

fn ikDRunLayerMlp step ulong l ulong hasMsgs bool to bool
wk = get ikDWork 0
isBoundary = eq rem l 6 0
if isBoundary
bc = get ikDBlockCnt 0
ikDCopy2304 add 0x0c0000 mul bc 9216 0x04c000
put ikDBlockCnt 0 add bc 1
ikDCopy2304 0x04c000 0x048000
else
for i ulong 2304
v1 = ikDReadF32 wk add 0x04c000 mul i 4
v2 = ikDReadF32 wk add 0x048000 mul i 4
ikDWriteF32 wk add 0x04c000 mul i 4 add v1 v2
end
end
mqVa = get ikMlpQOff l
if not ikDAttnRes 0x0c0000 get ikDBlockCnt 0 0x04c000 mqVa 1 0x050000
ret false
end
if hasMsgs
if not ikDMsgGate l 3 0x050000 0x1c6c00 0x050000
ret false
end
end
lutva = mapaddr get ikDKLut 0
if not ikDBatchStart
ret false
end
ikDArgReset
ikDPtr ikDW 0x050000
ikDPtr ikLva l 19
ikDPtr ikDW 0x054000
ikDArgU 2304
if not ikDBatchAdd 5 1 1 1 256
ret false
end
ikDPtr ikLva l 20
ikDPtr ikDW 0x054000
ikDPtr ikDW 0x058000
ikDArgU 2304
ikDArgU 128
if not ikDBatchAdd 0 4 1 1 256
ret false
end
ikDPtr ikDW 0x058000
ikDPtr ikLva l 21
ikDPtr ikDW 0x058400
ikDPtr ikDW 0x058500
if not ikDBatchAdd 12 1 1 1 32
ret false
end
if lt l 20
ikDPtr ikDW 0x054000
ikDPtr lutva
ikDPtr ikDW 0x059000
ikDPtr ikDW 0x05a000
ikDPtr ikDW 0x05e000
ikDPtr ikDW 0x060000
ikDArgU 144
if not ikDBatchAdd 8 2 1 1 128
ret false
end
ikDPtr ikDW 0x060000
ikDPtr ikLva l 22
ikDPtr ikLva l 23
ikDPtr ikDW 0x058400
ikDPtr ikLva l 24
ikDPtr lutva
ikDPtr ikDW 0x070000
ikDArgU 2304
ikDArgU 2304
ikDArgU 0
if not ikDBatchAdd 1 72 8 1 256
ret false
end
ikDPtr ikDW 0x070000
ikDPtr ikDW 0x058500
ikDPtr lutva
ikDPtr ikDW 0x059000
ikDPtr ikDW 0x05a000
ikDPtr ikDW 0x05e000
ikDPtr ikDW 0x060000
ikDArgU 1152
if not ikDBatchAdd 17 1 8 1 128
ret false
end
ikDPtr ikDW 0x060000
ikDPtr ikLva l 25
ikDPtr ikLva l 26
ikDPtr ikDW 0x058400
ikDPtr ikLva l 27
ikDPtr lutva
ikDPtr ikDW 0x090000
ikDArgU 1152
ikDArgU 2304
ikDArgU 1152
if not ikDBatchAdd 1 72 8 1 256
ret false
end
else
ikDPtr ikDW 0x054000
ikDPtr lutva
ikDPtr ikDW 0x05a000
ikDPtr ikDW 0x05e000
ikDPtr ikDW 0x060000
ikDArgU 72
if not ikDBatchAdd 9 1 1 1 128
ret false
end
ikDPtr ikDW 0x060000
ikDPtr ikLva l 22
ikDPtr ikLva l 23
ikDPtr ikDW 0x058400
ikDPtr lutva
ikDPtr ikDW 0x070000
ikDArgU 2304
ikDArgU 2304
ikDArgU 0
if not ikDBatchAdd 2 72 8 1 256
ret false
end
ikDPtr ikDW 0x070000
ikDPtr ikDW 0x058500
ikDPtr ikDW 0x084000
ikDPtr 0
ikDArgU 1152
if not ikDBatchAdd 10 9 8 1 128
ret false
end
ikDPtr ikDW 0x084000
ikDPtr lutva
ikDPtr ikDW 0x05a000
ikDPtr ikDW 0x05e000
ikDPtr ikDW 0x060000
ikDArgU 288
if not ikDBatchAdd 9 3 1 1 128
ret false
end
ikDPtr ikDW 0x060000
ikDPtr ikLva l 25
ikDPtr ikLva l 26
ikDPtr ikDW 0x058400
ikDPtr lutva
ikDPtr ikDW 0x090000
ikDArgU 1152
ikDArgU 2304
ikDArgU 1152
if not ikDBatchAdd 2 72 8 1 256
ret false
end
end
scBase = ikDScBaseStep step
ikDPtr ikDW 0x090000
ikDPtr ikDW add scBase 52224
ikDPtr ikLva l 15
ikDPtr ikDW 0x0a4000
ikDArgU 2304
if not ikDBatchAdd 15 18 1 1 128
ret false
end
if not ikDBatchRun
ret false
end
ikDArbStep step l
for i ulong 2304
v1 = ikDReadF32 wk add 0x04c000 mul i 4
v2 = ikDReadF32 wk add 0x0a4000 mul i 4
ikDWriteF32 wk mul i 4 add v1 v2
end
ret true
end

note Run all 48 logical layers + final attn_res + norm + 201k unembed + softcap + greedy argmax.
fn ikDForwardToken tok ulong posQ ulong needLogits bool to long
ikDEmbed tok
put ikDBlockCnt 0 0
ikArbResetToken
put ikDArbHasPred 0 0
for l ulong 6
if not ikDRunLayerAttn l l posQ false
ret -1
end
if not ikDRunLayerMlp l l false
ret -2
end
end
ikDCopy2304 0x150000 0x000000
ikDCopyBlocks 0x120000 0x0c0000 get ikDBlockCnt 0
put ikDPreBlockCnt 0 get ikDBlockCnt 0
for j ulong 12
l = add 6 j
if not ikDRunLayerAttn l l posQ false
ret -3
end
if not ikDRunLayerMlp l l false
ret -4
end
end
for pass ulong 2
preN = get ikDPreBlockCnt 0
curN = get ikDBlockCnt 0
nPrev = sub curN add preN 1
ikDCopyBlocks 0x160000 add 0x0c0000 mul add preN 1 9216 nPrev
ikDCopy2304 add 0x160000 mul nPrev 9216 0x000000
put ikDPrevBlockCnt 0 add nPrev 1
ikDCopy2304 0x000000 0x150000
ikDCopyBlocks 0x0c0000 0x120000 preN
put ikDBlockCnt 0 preN
for j ulong 12
step = add add 18 mul pass 12 j
l = add 6 j
if not ikDCrossPassMsgs j
ret -5
end
if not ikDRunLayerAttn step l posQ true
ret -6
end
if not ikDRunLayerMlp step l true
ret -7
end
end
end
for j ulong 6
step = add 42 j
l = add 18 j
if not ikDRunLayerAttn step l posQ false
ret -8
end
if not ikDRunLayerMlp step l false
ret -9
end
end
if not needLogits
ret 0
end
if not ikDAttnRes 0x0c0000 get ikDBlockCnt 0 0x000000 ikGva 4 1 0x0b0000
ret -10
end
if not ikDBatchStart
ret -15
end
ikDArgReset
ikDPtr ikDW 0x0b0000
ikDPtr ikGva 2
ikDPtr ikDW 0x004000
ikDArgU 2304
if not ikDBatchAdd 5 1 1 1 256
ret -11
end
ikDPtr ikGva 3
ikDPtr ikDW 0x004000
ikDPtr ikDW 0x200000
ikDArgU 2304
ikDArgU 201024
if not ikDBatchAdd 0 6282 1 1 256
ret -12
end
ikDPtr ikDW 0x200000
ikDPtr ikDW 0x300000
ikDArgU 201024
ikDArgU ikDF32Bits 30.0f32
if not ikDBatchAdd 20 1571 1 1 128
ret -13
end
if not ikDBatchRun
ret -14
end
wk = get ikDWork 0
bestId = ulong 0
bestVal = f32 -1e30f32
for v ulong 200058
val = ikDReadF32 wk add 0x300000 mul v 4
if gt val bestVal
bestVal = val
bestId = v
end
end
ret long bestId
end

fn ikDJoinPath dir view uchar * dlen ulong suf view uchar * dst edit uchar 512 to ulong
p = ulong 0
for i ulong dlen bound 256
put dst p get dir i
p = add p 1
end
for i ulong len suf bound 128
put dst p get suf i
p = add p 1
end
ret p
end

fn ikDResetSlot slot ulong to void
wk = get ikDWork 0
for i ulong 65536
put ikDOutBuf i 0
end
base = add 0x500000 mul slot IK_SCONV_SLOT_BYTES
done = ulong 0
while lt done IK_SCONV_SLOT_BYTES bound 128
chunk = sub IK_SCONV_SLOT_BYTES done
if gt chunk 65536
chunk = ulong 65536
end
r = mapwrite wk add base done ikDOutBuf 0 chunk
done = add done chunk
end
end

fn ikDInitGpu nSlots ulong to int
if not gbopen 1
ret 10
end
if not gbbopen
ret 11
end
pkt = nvalloc 1048576 false
if le pkt 0
ret 12
end
put ikDPkt 0 pkt
if not ikDBuildLut
ret 13
end
if not ikDInitKernels
ret 14
end
wk = nvalloc add 5242880 mul nSlots IK_SCONV_SLOT_BYTES true
kv = nvalloc mul nSlots IK_KV_SLOT_BYTES true
if or le wk 0 le kv 0
ret 15
end
put ikDWork 0 wk
put ikDWorkVa 0 mapaddr wk
ikDWriteF32 wk 0x059000 0.05f32
put ikDKv 0 kv
put ikDKvVa 0 mapaddr kv
put ikDSlot 0 0
ret 0
end

fn ikDInitModel nSlots ulong to int
dir = new uchar 256 0
arg1 = new uchar 256 0
pSt = new uchar 512 0
pTok = new uchar 512 0
dlen = len ikDDefDir
for i ulong dlen bound 256
put dir i get ikDDefDir i
end
if ge argcnt 2
n = argread 1 arg1 0 256
if gt n 0
if ne get arg1 0 45
dlen = ulong n
for i ulong dlen bound 256
put dir i get arg1 i
end
end
end
end
lSt = ikDJoinPath dir dlen ikDSufSt pSt
lTok = ikDJoinPath dir dlen ikDSufTok pTok
rc = ikDInitGpu nSlots
if ne rc 0
ret rc
end
if not ikStLoadAll pSt lSt
ret 16
end
if not ikTokLoad pTok lTok
ret 17
end
ret 0
end

fn ikDInitAll to int
ret ikDInitModel 1
end

fn ikDForwardSlot slot ulong tok ulong posQ ulong needLogits bool to long
put ikDSlot 0 slot
ret ikDForwardToken tok posQ needLogits
end

fn ikDRunPrompt to int
pBuf = new uchar 1024 0
pIds = new uint 1024 0
pLen = len ikDDefPrompt
for i ulong pLen bound 1024
put pBuf i get ikDDefPrompt i
end
if ge argcnt 3
n = argread 2 pBuf 0 1024
if gt n 0
pLen = ulong n
end
end
nTok = ikTokEncodeChat pBuf pLen pIds
put ikDPromptLen 0 nTok
ikDPrint ikDMsgPrompt
ikDPrintU nTok
ikDPrint ikDMsgNl
posQ = ulong 0
nextTok = long 0
for i ulong nTok bound 1024
needL = eq add i 1 nTok
nextTok = ikDForwardToken ulong get pIds i posQ needL
if lt nextTok 0
ikDPrint ikDMsgFail
ikDPrintU ulong sub 0 nextTok
ikDPrint ikDMsgNl
ret 20
end
posQ = add posQ 1
end
ikDPrint ikDMsgGen
ikTokPrint ulong nextTok
tGen0 = monons
genCnt = ulong 1
for g ulong 31 bound 64
if or eq nextTok 200006 eq nextTok 200010
break
end
nextTok = ikDForwardToken ulong nextTok posQ true
if lt nextTok 0
ikDPrint ikDMsgFail
ikDPrintU ulong sub 0 nextTok
ikDPrint ikDMsgNl
ret 21
end
ikTokPrint ulong nextTok
posQ = add posQ 1
genCnt = add genCnt 1
end
tGen1 = monons
ikDPrint ikDMsgStats
ikDPrintU genCnt
ikDPrint ikDMsgMs
if gt genCnt 1
ikDPrintU div div ulong sub tGen1 tGen0 sub genCnt 1 1000000
else
ikDPrintU 0
end
ret 0
end

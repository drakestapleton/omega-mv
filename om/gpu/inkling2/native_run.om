fn ikLayerIsFull layer ulong to bool
ret or or eq layer 5 eq layer 11 or eq layer 17 eq layer 23
end

fn ikPhysLayer step ulong to ulong
if lt step 6
ret step
end
if lt step 42
ret add 6 rem sub step 6 12
end
ret sub step 24
end

fn ikLayerKernels step ulong to ulong
layer = ikPhysLayer step
n = ulong 18
if and ge step 18 lt step 42
n = add n 1
end
if ge layer 20
n = add n 1
end
ret n
end


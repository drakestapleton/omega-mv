ikPtr add wva 0x060000
ikPtr add wva 0x080000
ikPtr add wva 0x090000
ikPtr add wva 0x090100
ikPtr lutva
ikPtr add wva 0x090200
ikArg 2304
ikArg 32
ikArg 0
if not ikRecord 1 1 8 1 256
ret false
end
note 3. mxfp8_gemv_grouped8_fast (8x32x2304, W=1.0, sw=1.0, x=1.0 -> C=2304.0)
ikPtr add wva 0x040000
ikPtr add wva 0x0a0000
ikPtr add wva 0x0c0000
ikPtr add wva 0x090000
ikPtr lutva
ikPtr add wva 0x0d0000
ikArg 2304
ikArg 32
ikArg 0
if not ikRecord 2 1 8 1 256
ret false
end
note 4. router_top8_fast (logits=0, bias[e]=0.01*e -> ids=[127..120], wts=[1.0..1.0])
ikPtr add wva 0x130000
ikPtr add wva 0x131000
ikPtr add wva 0x132000
ikPtr add wva 0x132100
if not ikRecord 12 1 1 1 32

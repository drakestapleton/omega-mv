note SPDX-License-Identifier: AGPL-3.0-only
note Pure seeded-Omega native GB10 runner for Inkling-2-Mini (ZERO libcuda.so.1, ZERO Python, ZERO C).
note Compose after:
note   gpu/nvidia/native/nvrm/context.om
note   gpu/nvidia/native/blackwell/vector.om
note   gpu/nvidia/native/blackwell/launch.om
note   gpu/nvidia/native/blackwell/batch.om
note   om/encoder/bw_enc_sm121.om
note   om/gpu/inkling2/emit_fast.om

global ikCodePos ulong 1
global ikEntry ulong 24
global ikSmem ulong 24
global ikCodeMap long 1
global ikCodeFail uint 1
global ikBind uint 32
global ikBindN ulong 1
global ikDirty uint 1

note Device allocations (all via native NVRM/UVM ioctl nvalloc)
global ikLut long 1
global ikWork long 1
global ikKvSwa long 1
global ikKvFull long 1
global ikUnembed long 1
global ikLogits long 1
global ikWqkv long 4
global ikWo long 4
global ikWgate long 4
global ikW413 long 4
global ikS413 long 4
global ikW42 long 4
global ikS42 long 4
global ikW813 long 1
global ikS813 long 1
global ikW82 long 1
global ikS82 long 1
global ikPkt long 5
global ikPktBytes ulong 5
global ikPktCnt ulong 5
global ikFastMode ulong 1
global ikFastSlot ulong 1
global ikFastPos ulong 1
global ikFillBuf uchar 65536
global ikCopyBuf uchar 65536

text ikHdr "=== INKLING-2-MINI 100% PURE SEEDED-OMEGA NATIVE GB10 RUNNER (ZERO libcuda.so.1) ===\n"
text ikOpenErr "FAIL: native /dev/nvidia* open/alloc error (stage/err): "
text ikSubErr "FAIL: native GPFIFO submit error (stage/err/idx): "
text ikP1Ok "PASS: native GB10 21/21 kernel parity self-test (all fast SM121 kernels verified, ZERO libcuda.so.1)\n"
text ikP1Fail "FAIL: native GB10 kernel parity check failed at test id: "
text ikRes1 "NATIVE_GPFIFO_48L_NO_UNEMBED: median_us="
text ikRes2 "NATIVE_GPFIFO_48L_FULL_201K_UNEMBED: median_us="
text ikTokS " tok_s_x100="
text ikFinOk " finite=OK\n"
text ikFinBad "FAIL: non-finite output detected!\n"
text ikNl "\n"

fn ikPrint s view uchar * to void
r = write 1 s 0 len s
end

fn ikPrintU x ulong to void
b = new uchar 24 0
pos = ulong 24
v = x
while true
pos = sub pos 1
put b pos uchar add 48 rem v 10
v = div v 10
if eq v 0
break
end
end
r = write 1 b pos sub 24 pos
end

fn ikPrintI x long to void
b = new uchar 1 45
if lt x 0
r = write 1 b 0 1
ikPrintU ulong neg x
else
ikPrintU ulong x
end
end

fn ikW off ulong to ulong
ret add mapaddr get ikWork 0 off
end

fn ikfWrite w view ulong 4 to void
p = get ikCodePos 0
b = new uchar 16 0
if gt get ikCodeMap 0 0
for i ulong 16
put b i uchar and shr get w div i 4 mul rem i 4 8 255
end
if ne mapwrite get ikCodeMap 0 p b 0 16 16
put ikCodeFail 0 1
end
end
put ikCodePos 0 add p 16
end

fn ikEmitAll to void
put ikCodePos 0 0
for i ulong 21
p = mul div add get ikCodePos 0 255 256 256
put ikEntry i p
put ikCodePos 0 p
put ikfPc 0 0
put ikfGuard 0 0
ok = ikfKernel uchar add 97 i
if not ok
exit 4
end
ikfDone
end
put ikSmem 0 16384
put ikSmem 1 12288
put ikSmem 2 12288
put ikSmem 3 6144
put ikSmem 4 512
put ikSmem 5 256
put ikSmem 6 10752
put ikSmem 7 0
put ikSmem 8 1088
put ikSmem 9 1088
put ikSmem 10 0
put ikSmem 11 0
put ikSmem 12 64
put ikSmem 13 6144
put ikSmem 14 0
put ikSmem 15 0
put ikSmem 16 256
put ikSmem 17 9280
put ikSmem 18 0
put ikSmem 19 0
put ikSmem 20 0
end

fn ikArg u uint to void
i = get ikBindN 0
put ikBind i u
put ikBindN 0 add i 1
end

fn ikPtr va ulong to void
ikArg gblo va
ikArg gbhi va
end

fn ikFastEmit words ulong to bool
cb = mapaddr get gbmem 1
gbdma add cb 896 uint words
for j ulong words
gbemit get ikBind j
end
q = mapaddr get gbmem 2
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
gbrel add mapaddr get gbmem 3 32 6
put ikBindN 0 0
n = get gbused 0
pos = get ikFastPos 0
if gt add pos n 2096000
ret false
end
if ne mapwrite get ikPkt get ikFastSlot 0 pos gbcmd 0 n long n
ret false
end
put ikFastPos 0 add pos n
ret true
end

fn ikRecord id ulong gx uint gy uint gz uint bx uint to bool
gbqmd 1
a = add mapaddr get ikCodeMap 0 get ikEntry id
put gbq1 32 gblo shr a 4
put gbq1 33 or uint and shr a 36 2097151 20971520
put gbq1 59 gblo shr a 8
put gbq1 34 or uint 65536 bx
put gbq1 35 or uint 131073 shl uint 64 8
sm = get ikSmem id
s7 = ulong 8
if ne sm 0
s7 = div add sm 127 128
end
put gbq1 36 uint or 78923776 s7
put gbq1 37 0
put gbq1 39 gx
put gbq1 40 gy
put gbq1 41 gz
put gbcb 216 bx
put gbcb 220 gx
put gbcb 221 gy
put gbcb 222 gz
cb = mapaddr get gbmem 1
words = get ikBindN 0
endva = add cb add 896 mul words 4
put gbcb 212 gbhi endva
put gbcb 213 gblo endva
put gbused 0 0
if eq get ikFastMode 0 1
ret ikFastEmit words
end
gbsetup
if ne get ikDirty 0 0
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
put ikDirty 0 0
end
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
gbdma add cb 896 uint words
for j ulong words
gbemit get ikBind j
end
q = mapaddr get gbmem 2
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
put ikBindN 0 0
ret gbappend id get gbst 1
end

fn ikWriteLut m long to bool
for code ulong 256
exp = and shr code 3 15
frac = and code 7
bits = uint 0
if and eq exp 15 eq frac 7
bits = uint 0x7fc00000
else
v = f32 0.0
if eq exp 0
v = div f32 frac f32 512.0
else
p = f32 1.0
if ge exp 7
for s ulong sub exp 7 bound 16
p = mul p f32 2.0
end
else
for s ulong sub 7 exp bound 16
p = mul p f32 0.5
end
end
v = mul add f32 1.0 div f32 frac f32 8.0 p
end
if ne and code 128 0
v = sub f32 0.0 v
end
bits = bitcast uint v
end
if ne mapset m mul code 4 4 ulong bits 0
ret false
end
end
fp4 = new f32 16 0.0f32
put fp4 0 0.0f32
put fp4 1 0.5f32
put fp4 2 1.0f32
put fp4 3 1.5f32
put fp4 4 2.0f32
put fp4 5 3.0f32
put fp4 6 4.0f32
put fp4 7 6.0f32
for k ulong 8
put fp4 add 8 k sub 0.0f32 get fp4 k
end
for k ulong 16
if ne mapset m mul add 256 k 4 4 ulong bitcast uint get fp4 k 0
ret false
end
end
ret true
end

fn ikFillPattern m long bytes ulong pat uint to bool
for i ulong 16384
for j ulong 4
put ikFillBuf add mul i 4 j uchar and shr pat mul j 8 255
end
end
off = ulong 0
while lt off bytes bound 4000000000
n = sub bytes off
if gt n 65536
n = ulong 65536
end
if ne mapwrite m off ikFillBuf 0 n long n
ret false
end
off = add off n
end
ret true
end

fn ikF32Bits v f32 to uint
ret bitcast uint v
end

fn ikCheckF32 m long off ulong want f32 tol f32 to bool
got = bitcast f32 uint mapget m off 4
diff = sub got want
if lt diff 0.0f32
diff = sub 0.0f32 diff
end
ret le diff tol
end

fn ikIsFiniteU32 u ulong to bool
ret lt and u 0x7f800000 0x7f800000
end

note =========================================================================
note Phase 1: Native GB10 parity self-test across core fast kernels (ZERO libcuda.so.1)
note =========================================================================
fn ikSelfTest to bool
wk = get ikWork 0
wva = mapaddr wk
lutva = mapaddr get ikLut 0
note Scratch offsets inside 32 MiB ikWork:
note  0x000000: W_bf16[32, 2304] (147456 B)  filled with BF16 0.5 (0x3f003f00)
note  0x040000: x[2304] (9216 B)             filled with 1.0f32 (0x3f800000)
note  0x050000: y[2304] (9216 B)             output
note  0x060000: W_nv4[1, 32, 1152] (36864 B) filled with 0x22 (1.0f32 in E2M1)
note  0x080000: sw_nv4[1, 32, 144] (4608 B)  filled with 56 (1.0f32 in E4M3FN)
note  0x090000: ids[8] (32 B)                all 0
note  0x090100: alpha_w[1] (4 B)             1.0f32
note  0x090200: C_nv4[8, 32] (1024 B)        output
note  0x0a0000: W_mx8[1, 32, 2304] (73728 B) filled with 56 (1.0f32 in E4M3FN)
note  0x0c0000: sw_mx8[1, 1, 72] (72 B)      filled with 127 (2^0 = 1.0f32 in UE8M0)
note  0x0d0000: C_mx8[8, 32] (1024 B)        output
note  0x0e0000: state[1, 2304, 3] (27648 B)  filled with 1.0f32
note  0x0f0000: w_sc[2304, 4] (36864 B)      filled with 0.25f32
note  0x100000: gain[2304] (9216 B)          filled with 2.0f32
note  0x110000: h_out[2304] (9216 B)         output
note  0x120000: hn_out[2304] (9216 B)        output
note  0x130000: logits128[128] (512 B)       0.0f32
note  0x131000: bias128[128] (512 B)         bias[e] = e * 0.01f32 -> top-8 = 127..120
note  0x132000: out_ids[8] (32 B), 0x132100: out_wts[8] (32 B)
note  0x140000: Q[1,24,128], 0x150000: K_bf16[1,8,32,128], 0x170000: V_bf16[1,8,32,128]
note  0x190000: rel[1,24,16], 0x192000: sinks[1,24], 0x193000: gate[1,24,128]
note  0x198000: pml[1,24,2,2], 0x199000: po[1,24,2,128], 0x1a0000: attn_out[1,24,128]
note  0x1b0000: gu8[8, 2304] (73728 B), 0x1d0000: w8[8], 0x1d0100: outer[1]
note  0x1d1000: pk[576, 8], 0x1d4000: sc[576], 0x1d5000: rc[576, 16]
note  0x1e0000: downs[1, 8, 2304] (73728 B), 0x200000: mc_out[2304]
note  0x210000: Vb[1, 4, 2304], 0x220000: Qr[1, 2304], 0x224000: ar_out[1, 1, 2304]
note  0x230000: msg_out[2304], 0x234000: sc_out[2304]

for i ulong 36864
r = mapset wk mul i 4 4 0x3f003f00
end
for i ulong 2304
r = mapset wk add 0x040000 mul i 4 4 0x3f800000
r = mapset wk add 0x100000 mul i 4 4 0x40000000
end
for i ulong 9216
r = mapset wk add 0x060000 mul i 4 4 0x22222222
end
for i ulong 1152
r = mapset wk add 0x080000 mul i 4 4 0x38383838
end
for i ulong 8
r = mapset wk add 0x090000 mul i 4 4 0
r = mapset wk add 0x1d0000 mul i 4 4 0x3f800000
end
r = mapset wk 0x090100 4 0x3f800000
r = mapset wk 0x1d0100 4 0x3d4ccccd
for i ulong 18432
r = mapset wk add 0x0a0000 mul i 4 4 0x38383838
r = mapset wk add 0x1b0000 mul i 4 4 0x3f800000
r = mapset wk add 0x1e0000 mul i 4 4 0x3e000000
end
for i ulong 576
r = mapset wk add 0x0c0000 mul i 4 4 0x7f7f7f7f
end
for i ulong 6912
r = mapset wk add 0x0e0000 mul i 4 4 0x3f800000
end
for i ulong 9216
r = mapset wk add 0x0f0000 mul i 4 4 0x3e800000
end
for i ulong 128
r = mapset wk add 0x130000 mul i 4 4 0
bv = mul f32 i 0.01f32
r = mapset wk add 0x131000 mul i 4 4 ulong bitcast uint bv
end
for i ulong 3072
r = mapset wk add 0x140000 mul i 4 4 0x3f800000
r = mapset wk add 0x193000 mul i 4 4 0
end
for i ulong 16384
r = mapset wk add 0x150000 mul i 4 4 0x3f803f80
r = mapset wk add 0x170000 mul i 4 4 0x40004000
end
for i ulong 384
r = mapset wk add 0x190000 mul i 4 4 0
end
for i ulong 24
r = mapset wk add 0x192000 mul i 4 4 0xc2c80000
end
for i ulong 9216
r = mapset wk add 0x210000 mul i 4 4 0x3f800000
end
for i ulong 2304
r = mapset wk add 0x220000 mul i 4 4 0x3f800000
end

put ikDirty 0 1
if not gbbegin 11
ret false
end
note 1. bf16_gemv_fast (32x2304, W=0.5, x=1.0 -> y=1152.0)
ikPtr wva
ikPtr add wva 0x040000
ikPtr add wva 0x050000
ikArg 2304
ikArg 32
if not ikRecord 0 1 1 1 256
ret false
end
note 2. nvfp4_gemv_grouped8_fast (8x32x2304, W=1.0, sw=1.0, x=1.0, alpha=1.0 -> C=2304.0)

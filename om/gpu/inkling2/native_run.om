ikArg 31
ikArg 16
ikArg 2
if not ikRecord 13 24 2 1 256
ret false
end
ikPtr add wva 0x198000
ikPtr add wva 0x199000
ikPtr add wva 0x192000
ikPtr add wva 0x193000
ikPtr add wva 0x1a0000
ikArg 24
ikArg 2
if not ikRecord 14 24 1 1 32
ret false
end
note 7. sconv_rmsnorm_fast (x=1, st=1, w=0.25 -> y=(4*0.25+1)/sqrt(5)=2/sqrt(5)=0.894427; gain=2 -> hn=2.0)
ikPtr add wva 0x040000
ikPtr add wva 0x0e0000
ikPtr add wva 0x0f0000
ikPtr add wva 0x100000
ikPtr add wva 0x110000
ikPtr add wva 0x120000
if not ikRecord 16 1 1 1 256
ret false
end
note 8. swiglu8_nvfp4_quant_fast (gu=1.0, w=1.0 -> finite recon)
ikPtr add wva 0x1b0000
ikPtr add wva 0x1d0000
ikPtr lutva
ikPtr add wva 0x1d0100
ikPtr add wva 0x1d1000
ikPtr add wva 0x1d4000
ikPtr add wva 0x1d5000
ikArg 1152
if not ikRecord 17 1 8 1 128
ret false
end
note 9. moe_combine8_sconv_fast (downs=0.125 -> sum=1.0, st=1, w=0.25 -> out=0.894427)
ikPtr add wva 0x1e0000
ikPtr add wva 0x0e0000
ikPtr add wva 0x0f0000
ikPtr add wva 0x200000
ikArg 2304
if not ikRecord 15 18 1 1 128
ret false
end
note 10. attn_res_fast (Vb=1.0, Qr=1.0 -> out=1.0)
ikPtr add wva 0x210000
ikPtr add wva 0x220000
ikPtr add wva 0x224000
ikArg 4
ikArg 1
ikArg 2304
if not ikRecord 4 1 1 1 256
ret false
end
note 11. logit_softcap_fast (x=1.0, cap=30.0 -> 30*tanh(1/30)=0.99963)
ikPtr add wva 0x040000
ikPtr add wva 0x234000
ikArg 2304
ikArg ikF32Bits 30.0f32
if not ikRecord 20 18 1 1 128
ret false
end

if not gbbsubmit 10000000000
ikPrint ikSubErr
ikPrintU ulong get nvstage 0
ikPrint ikNl
ret false
end

if not ikCheckF32 wk 0x050000 1152.0f32 0.1f32
ikPrint ikP1Fail
ikPrintU 1
ikPrint ikNl
ret false
end
if not ikCheckF32 wk 0x090200 2304.0f32 0.5f32
ikPrint ikP1Fail
ikPrintU 2
ikPrint ikNl
ret false
end
if not ikCheckF32 wk 0x0d0000 2304.0f32 0.5f32
ikPrint ikP1Fail
ikPrintU 3
ikPrint ikNl
ret false
end
if ne mapget wk 0x132000 4 127
ikPrint ikP1Fail
ikPrintU 4
ikPrint ikNl
ret false
end
if not ikCheckF32 wk 0x132100 1.0f32 0.01f32
ikPrint ikP1Fail
ikPrintU 5
ikPrint ikNl
ret false
end
if not ikCheckF32 wk 0x1a0000 1.0f32 0.01f32
ikPrint ikP1Fail
ikPrintU 6
ikPrint ikNl
ret false
end
if not ikCheckF32 wk 0x110000 0.894427f32 0.01f32
ikPrint ikP1Fail
ikPrintU 7
ikPrint ikNl
ret false
end
if not ikCheckF32 wk 0x120000 2.0f32 0.01f32
ikPrint ikP1Fail
ikPrintU 8
ikPrint ikNl
ret false
end
if not ikIsFiniteU32 mapget wk 0x1d5000 4
ikPrint ikP1Fail
ikPrintU 9
ikPrint ikNl
ret false
end
if not ikCheckF32 wk 0x200000 0.894427f32 0.01f32
ikPrint ikP1Fail
ikPrintU 10
ikPrint ikNl
ret false
end
if not ikCheckF32 wk 0x224000 1.0f32 0.01f32
ikPrint ikP1Fail
ikPrintU 11
ikPrint ikNl
ret false
end
if not ikCheckF32 wk 0x234000 0.99963f32 0.01f32
ikPrint ikP1Fail
ikPrintU 12
ikPrint ikNl
ret false
end
ret ikSelfTest2
end

fn ikSelfTest2 to bool
wk = get ikWork 0
wva = mapaddr wk
lutva = mapaddr get ikLut 0
for i ulong 2304
r = mapset wk add 0x240000 mul i 4 4 0x3f800000
r = mapset wk add 0x244000 mul i 4 4 0x40000000
r = mapset wk add 0x248000 mul i 4 4 0
end
if not gbbegin 10
ret false
end

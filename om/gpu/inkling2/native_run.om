fn ikInitWork to bool
wk = get ikWork 0
if not ikFillPattern wk 2097152 0
ret false
end
for i ulong 2304
r = mapset wk mul i 4 4 0x3dcccccd
r = mapset wk add 0x008000 mul i 4 4 0x3f800000
r = mapset wk add 0x050000 mul i 16 4 0x3dcccccd
r = mapset wk add 0x120000 mul i 4 4 0x3e4ccccd
r = mapset wk add 0x140000 mul i 4 4 0x3dcccccd
end
for i ulong 3072
r = mapset wk add 0x024000 mul i 4 4 0x3f800000
end
r = mapset wk 0x028000 4 0x3f800000
r = mapset wk 0x0a4000 4 0x3d4ccccd
for i ulong 128
r = mapset wk add 0x0a5000 mul i 4 4 0x3b03126f
bv = mul f32 i 0.001f32
r = mapset wk add 0x0a0000 mul i 4 4 ulong bitcast uint bv
end
put ikDirty 0 1
ret true
end

fn ikSortTimes t edit ulong 16 to void
for i ulong 16
for j ulong 15
if gt get t j get t add j 1
tmp = get t j
put t j get t add j 1
put t add j 1 tmp
end
end
end
end

fn ikRunToken incUnembed bool to bool
if incUnembed
ret ikReplayPkt 1
end
ret ikReplayPkt 0
end

fn ikBench48 incUnembed bool to bool
for w ulong 2
if not ikRunToken incUnembed
ret false
end
end
ts = new ulong 16 0
for it ulong 16
t0 = monons
if not ikRunToken incUnembed
ret false
end
t1 = monons
put ts it div ulong sub t1 t0 1000
end
ikSortTimes ts
medUs = get ts 8
tokSx100 = div 100000000 medUs
if incUnembed
ikPrint ikRes2
else
ikPrint ikRes1
end
ikPrintU medUs
ikPrint ikTokS
ikPrintU tokSx100
for i ulong 2304
if not ikIsFiniteU32 mapget get ikWork 0 mul i 4 4
ikPrint ikFinBad
ret false
end
end
if incUnembed
for i ulong 1024
if not ikIsFiniteU32 mapget get ikLogits 0 mul i 4 4
ikPrint ikFinBad
ret false
end
end
end
ikPrint ikFinOk
ret true
end

fn main to int
ikPrint ikHdr
if not gbopen 1
ikPrint ikOpenErr
ikPrintU ulong get nvstage 0
ikPrint ikNl
ret 1
end
if not gbbopen
ikPrint ikOpenErr
ikPrintU ulong get nvstage 0
ikPrint ikNl
ret 2
end
put ikCodeMap 0 0
ikEmitAll
csize = mul div add get ikCodePos 0 4095 4096 4096
cm = nvalloc csize false
if le cm 0
ikPrint ikOpenErr
ikPrintU ulong get nvstage 0
ikPrint ikNl
ret 3
end
put ikCodeMap 0 cm
put ikCodeFail 0 0
ikEmitAll
if ne get ikCodeFail 0 0
ret 4
end
lm = nvalloc 4096 true
if le lm 0
ret 5
end
put ikLut 0 lm
if not ikWriteLut lm
ret 6
end
wm = nvalloc 33554432 true
if le wm 0
ret 7
end
put ikWork 0 wm
if not ikSelfTest
rc = nvmclose
ret 10
end
if not ikAllocModel
ikPrint ikOpenErr
ikPrintU ulong get nvstage 0
ikPrint ikNl
rc = nvmclose
ret 11
end
if not ikInitWork
rc = nvmclose
ret 12
end
if not ikRecordAll48 0 false
ikPrint ikSubErr
ikPrintU ulong get gbst 4
ikPrint ikNl
rc = nvmclose
ret 13
end
if not ikRecordAll48 1 true
ikPrint ikSubErr
ikPrintU ulong get gbst 4
ikPrint ikNl
rc = nvmclose
ret 15
end
if not ikBench48 false
rc = nvmclose
ret 16
end
if not ikBench48 true
rc = nvmclose
ret 17
end
rc = nvmclose
ret 0
end

fn ikRecordLayer step ulong to bool
layer = ikPhysLayer step
bk = rem step 4
if not ikRecordLayerAttn step ikLayerIsFull layer bk
ret false
end
ret ikRecordLayerMlp ge layer 20 bk
end

fn ikCopyPkt dst long nbytes ulong to bool
off = ulong 0
while lt off nbytes bound 2000000
n = sub nbytes off
if gt n 65536
n = ulong 65536
end
if ne mapread get gbpkt 0 off ikCopyBuf 0 n long n
ret false
end
if ne mapwrite dst off ikCopyBuf 0 n long n
ret false
end
off = add off n
end
ret true
end

fn ikFastBegin slot ulong to bool
put ikFastMode 0 1
put ikFastSlot 0 slot
put ikFastPos 0 0
put gbused 0 0
gbsetup
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
cb = mapaddr get gbmem 1
gbdriver cb
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
n = get gbused 0
if ne mapwrite get ikPkt slot 0 gbcmd 0 n long n
ret false
end
put ikFastPos 0 n
ret true
end

fn ikFastFinish slot ulong to bool
put gbused 0 0
gbtail
n = get gbused 0
pos = get ikFastPos 0
if ne mapwrite get ikPkt slot pos gbcmd 0 n long n
ret false
end
put ikPktBytes slot add pos n
put ikFastMode 0 0
ret true
end

fn ikRecordAll48 slot ulong incUnembed bool to bool
if not ikFastBegin slot
ret false
end
for s ulong 48
if not ikRecordLayer s
put ikFastMode 0 0
ret false
end
end
if incUnembed
wva = mapaddr get ikWork 0
lva = mapaddr get ikLogits 0
ikPtr wva
ikPtr add wva 0x008000
ikPtr add wva 0x004000
ikArg 2304
if not ikRecord 5 1 1 1 256
put ikFastMode 0 0
ret false
end
ikPtr mapaddr get ikUnembed 0
ikPtr add wva 0x004000
ikPtr lva
ikArg 2304
ikArg 201024
if not ikRecord 0 6282 1 1 256
put ikFastMode 0 0
ret false
end
ikPtr lva
ikPtr lva
ikArg 201024
ikArg ikF32Bits 30.0f32
if not ikRecord 20 1571 1 1 128
put ikFastMode 0 0
ret false
end
end
ret ikFastFinish slot
end

fn ikWaitFast budget ulong to bool
t0 = monons
while lt ulong sub monons t0 budget bound 5000000
if eq mapget get gbmem 3 16 4 1179010630
put nvret 0 get nvput 0
ret true
end
r = sleepns long 5000
end
ret false
end

fn ikReplayPkt slot ulong to bool
r = mapset get gbmem 2 8192 4 0
r = mapset get gbmem 3 0 4 0
r = mapset get gbmem 3 16 4 0
nb = get ikPktBytes slot
if not nvsend get ikPkt slot 0 uint div nb 4
ret false
end
if not ikWaitFast 15000000000
ret false
end
ret eq mapget get gbmem 3 0 4 1145324612
end


ic4 33 51 55 add xBase 2 51 cwAlu3
ic4 33 50 52 add xBase 3 50 cwAlu3
ic4 33 51 56 add xBase 3 51 cwAlu3
end

fn decodeE8Fast dst ulong src ulong tmp ulong to void
fLit tmp 23
ic4 52 dst src tmp Z cwAlu4
fLit tmp 1
ic 28 Z dst tmp 0 cwCmp
put ikfGuard 0 2
ic 2 dst Z Z 0x00400000 cwAlu4
fLit tmp 255
ic 28 Z src tmp 0 cwCmp
put ikfGuard 0 1
ic 2 dst Z Z 0x7fc00000 cwAlu4
end


note SPDX-License-Identifier: AGPL-3.0-only
note Inkling-2-Mini high-speed SM121 SASS emitter (pipelined scoreboards, LDG.E.128/64, SMEM, SHFL, grouped MoE).
note Compose after om/encoder/bw_enc_sm121.om.
const Z ulong 255
global ikfPc ulong 1
global ikfGuard ulong 1
global ikfBuf ulong 8192

fn cw st ulong wb ulong rbar ulong wt ulong yld ulong to ulong
a = or shl st 9 shl yld 13
b = or shl wb 14 shl rbar 17
ret or or a b shl wt 20
end

fn cwAlu0 to ulong
ret cw 1 7 7 0 0
end
fn cwAlu1 to ulong
ret cw 2 7 7 0 0
end
fn cwAlu3 to ulong
ret cw 3 7 7 0 0
end
fn cwAlu4 to ulong
ret cw 6 7 7 0 0
end
fn cwCmp to ulong
ret cw 14 7 7 0 0
end
fn cwLd to ulong
ret cw 2 0 1 0 1
end
fn cwLdW1 to ulong
ret cw 2 0 1 2 1
end
fn cwLdB2 to ulong
ret cw 2 2 1 0 1
end
fn cwSt to ulong
ret cw 4 7 1 0 1
end
fn cwW0 to ulong
ret cw 6 7 7 1 0
end
fn cwW1 to ulong
ret cw 6 7 7 2 0
end
fn cwW2 to ulong
ret cw 6 7 7 4 0
end
fn cwWall to ulong
ret cw 6 7 7 7 0
end
fn cwShfl to ulong
ret cw 4 0 7 0 1
end
fn cwMufu to ulong
ret cw 4 0 7 0 1
end
fn cwSafe to ulong
ret cw 6 7 7 7 0
end

fn emitRaw o edit ulong 16 atPc ulong to void
w = new ulong 4 0
op = get o 0
native = op
if or eq op 65 eq op 66
native = ulong 61
end
if or eq op 67 eq op 68
native = ulong 12
end
if or eq op 69 eq op 70
native = ulong 40
end
put o 0 native
if ne get ikfGuard 0 0
put o 9 1
end
if eq get ikfGuard 0 2
put o 10 1
end
put ikfGuard 0 0
if ne get o 2 Z
put o 12 1
end
if ne get o 3 Z
put o 13 1
end
if ne enc1 o w 0
exit 3
end
if eq op 65
put w 2 0x048070ff
end
if eq op 66
put w 2 0x042070ff
end
if eq op 67
put w 2 sub get w 2 0x800
end
if eq op 68
put w 2 sub get w 2 0x400
end
if eq op 69
put w 2 0xc00
end
if eq op 70
put w 2 0x2000
end
base = mul atPc 4
for i ulong 4
put ikfBuf add base i get w i
end
end

fn ic op ulong dst ulong a ulong b ulong imm ulong ctrl ulong to void
o = new ulong 16 0
put o 0 op
put o 1 dst
put o 2 a
put o 3 b
put o 4 Z
put o 5 4
put o 6 and imm 0xffffffff
put o 7 ctrl
pc = get ikfPc 0
emitRaw o pc
put ikfPc 0 add pc 1
end

fn ic4 op ulong dst ulong a ulong b ulong c ulong ctrl ulong to void
o = new ulong 16 0
put o 0 op
put o 1 dst
put o 2 a
put o 3 b
put o 4 c
put o 5 4
put o 6 0
put o 7 ctrl
pc = get ikfPc 0
emitRaw o pc
put ikfPc 0 add pc 1
end

fn icImm op ulong dst ulong a ulong c ulong imm ulong ctrl ulong to void
o = new ulong 16 0
put o 0 op
put o 1 dst
put o 2 a
put o 3 Z
put o 4 c
put o 5 4
put o 6 and imm 0xffffffff
put o 7 ctrl
pc = get ikfPc 0
emitRaw o pc
put ikfPc 0 add pc 1
end

fn fBraFwd gd ulong to ulong
pos = get ikfPc 0
put ikfGuard 0 gd
ic 46 Z Z Z 0 cwAlu4
ret pos
end

fn fPatch pos ulong gd ulong to void
o = new ulong 16 0
put o 0 46
put o 1 Z
put o 2 Z
put o 3 Z
put o 4 Z
put o 5 4
put o 6 and sub get ikfPc 0 pos 0xffffffff
put o 7 cwAlu4
put ikfGuard 0 gd
emitRaw o pos
end

fn fBssy to ulong
pos = get ikfPc 0
ic 54 Z Z Z 2 cwSafe
ret pos
end

fn fBsync bpos ulong to void
ic 55 Z Z Z 0 cwSafe
o = new ulong 16 0
put o 0 54
put o 1 Z
put o 2 Z
put o 3 Z
put o 4 Z
put o 5 4
put o 6 and sub get ikfPc 0 bpos 0xffffffff
put o 7 cwSafe
emitRaw o bpos
end

fn fLit d ulong x ulong to void
ic 2 d Z Z x cwAlu4
end

fn fNum d ulong x f32 to void
fLit d ulong bitcast uint x
end

fn fMad d ulong a ulong s ulong c ulong to void
icImm 8 d a c s cwAlu4
end

fn fMadReg d ulong a ulong b ulong c ulong to void
ic4 8 d a b c cwAlu4
end

fn fIadd d ulong a ulong b ulong to void
ic 14 d a b 0 cwAlu4
end

fn fParam d ulong off ulong to void
ic 4 d Z Z add 896 off cw 4 0 7 0 1
ic 0 Z Z Z 0 cwW0
end

fn fStart ptrs ulong to void
ic 7 4 Z Z 856 cw 4 2 7 0 1
for i ulong ptrs
ic 5 mul i 2 Z Z add 896 mul i 8 cw 4 0 7 0 1
end
ic 3 14 Z Z 33 cw 4 0 7 0 1
ic 3 15 Z Z 37 cw 4 0 7 0 1
ic 3 18 Z Z 38 cw 4 0 7 0 1
ic 3 19 Z Z 39 cw 4 0 7 0 1
ic 0 Z Z Z 0 cwWall
end

fn fReadSafe d ulong base ulong idx ulong off ulong to void
icImm 9 16 idx base 4 cwWall
ic 11 d 16 Z off cwLd
ic 0 Z Z Z 0 cwW0
end

fn fWriteSafe d ulong base ulong idx ulong off ulong to void
icImm 9 16 idx base 4 cwWall
ic 12 Z 16 d off cwSt
ic 0 Z Z Z 0 cwW1
end

fn fBar to void
ic 0 Z Z Z 0 cwWall
ic 48 Z Z Z 0 cwSafe
end

fn fWarpRedSum acc ulong tmp ulong startDelta ulong to void
d = startDelta
while ge d 1 bound 5
ic 42 tmp acc Z d cwShfl
ic 30 acc acc tmp 0 cwW0
d = shr d 1
end
end

fn fWarpBflySum acc ulong tmp ulong to void
d = ulong 16
while ge d 1 bound 5
ic 60 tmp acc Z d cwShfl
ic 30 acc acc tmp 0 cwW0
d = shr d 1
end
end

fn fExp d ulong a ulong l2e ulong to void
ic 32 d a l2e 0 cwAlu4
ic 47 d d Z 0 cwMufu
ic 0 Z Z Z 0 cwW0
end

fn fSig d ulong a ulong nl2e ulong one ulong to void
fExp d a nl2e
ic 30 d d one 0 cwAlu4
ic 40 d d Z 0 cwMufu
ic 0 Z Z Z 0 cwW0
end

fn fTanh d ulong a ulong s1 ulong s2 ulong s3 ulong to void
fNum s1 20.0f32
fNum s2 -20.0f32
ic 36 d a s1 0 cwAlu4
ic 37 d d s2 0 cwAlu4
fNum s1 -2.8853900817779268f32
fNum s2 1.0f32
fNum s3 2.0f32
fSig d d s1 s2
fNum s1 -1.0f32
ic4 33 d s3 d s1 cwAlu4
end

fn ikfDone to void
ic 0 Z Z Z 0 cwWall
ic 45 Z Z Z 0 cwSafe
while or lt get ikfPc 0 32 ne rem get ikfPc 0 8 0 bound 2048
ic 0 Z Z Z 0 cwSafe
end
w = new ulong 4 0
cnt = get ikfPc 0
for i ulong cnt bound 2048
base = mul i 4
for j ulong 4
put w j get ikfBuf add base j
end
ikfWrite w
end
end

note =========================================================================
note a: bf16_gemv_fast -- packed BF16 streaming GEMV (LDG.E.128, SMEM x, 8 warps x 4 rows = 32 rows/CTA)
note Args: W_bf16[N,K] (R0:1), x[K] (R2:3), y[N] (R4:5), K (R6), N (R7).
note Grid: (ceil(N/32), 1, 1), Block: 256, SMEM: 16384 (K <= 4096, K % 256 == 0).
note =========================================================================
fn bf16MacWord wBase ulong xLo ulong xHi ulong to void
for r ulong 4
icImm 8 add 52 r add wBase mul r 4 Z 65536 cwAlu1
end
ic 0 Z Z Z 0 cwAlu1
for r ulong 4
ic4 33 add 48 r add 52 r xLo add 48 r cwAlu1
end
for r ulong 4
ic 18 add 52 r add wBase mul r 4 Z 0xffff0000 cwAlu1
end
ic 0 Z Z Z 0 cwAlu1
for r ulong 4
ic4 33 add 48 r add 52 r xHi add 48 r cwAlu1
end
end

fn bf16GemvFast to void
fStart 3
fParam 6 24
fParam 7 28
fLit 56 0
fLit 57 256
mStage = get ikfPc 0
fIadd 52 56 14
icImm 9 16 52 2 4 cwW1
ic 11 53 16 Z 0 cwLd
fMad 54 52 4 Z
ic 0 Z Z Z 0 cwW0
ic 50 Z 54 53 0 cwSt
ic 0 Z Z Z 0 cwW1
fIadd 56 56 57
ic 28 Z 56 6 0 cwCmp
put ikfGuard 0 2
ic 46 Z Z Z sub mStage get ikfPc 0 cwAlu4
fBar
ic 17 10 14 Z 5 cwAlu4
ic 18 11 14 Z 31 cwAlu4
fMad 8 15 32 Z
fMad 8 10 4 8
fMad 9 6 2 Z
fLit 59 0xffffffff
fIadd 59 7 59
fMad 55 11 16 Z
for r ulong 4
fLit 52 r
fIadd 52 8 52
ic 28 Z 52 7 0 cwCmp
put ikfGuard 0 1
fMad 52 59 1 Z
fMadReg 53 52 9 55
icImm 9 add 16 mul r 2 53 0 1 cwAlu4
end
fMad 12 11 32 Z
ic 17 13 6 Z 8 cwAlu4
for r ulong 4
fNum add 48 r 0.0f32
end
fLit 56 0
fLit 57 1
fLit 58 1024
mLoop = get ikfPc 0
ic 57 24 16 Z 0 cwLdW1
ic 57 28 18 Z 0 cwLd
ic 57 32 20 Z 0 cwLd
ic 57 36 22 Z 0 cwLd
ic 58 40 12 Z 0 cwLd
ic 58 44 12 Z 16 cwLd
ic 0 Z Z Z 0 cwW0
bf16MacWord 24 40 41
bf16MacWord 25 42 43
bf16MacWord 26 44 45
bf16MacWord 27 46 47
ic 0 Z Z Z 0 cwW1
for r ulong 4
icImm 9 add 16 mul r 2 57 add 16 mul r 2 512 cwAlu1
end
ic 14 12 12 58 0 cwAlu1
ic 14 56 56 57 0 cwAlu4
ic 28 Z 56 13 0 cwCmp
put ikfGuard 0 2
ic 46 Z Z Z sub mLoop get ikfPc 0 cwAlu4
for r ulong 4
fWarpRedSum add 48 r 52 16
end
fLit 57 1
ic 28 Z 11 57 0 cwCmp
put ikfGuard 0 1
ic 45 Z Z Z 0 cwSafe
for r ulong 4
fLit 52 r
fIadd 52 8 52
ic 28 Z 52 7 0 cwCmp
sk = fBraFwd 1
icImm 9 16 52 4 4 cwAlu4
ic 12 Z 16 add 48 r 0 cwSt
ic 0 Z Z Z 0 cwW1
fPatch sk 1
end
end

note =========================================================================
note b: nvfp4_gemv_grouped8_fast -- 1-launch 8-expert NVFP4 GEMV (half-warp 16 lanes/row, 32 rows/CTA, SMEM x + SMEM LUT)
note Args: x_rec(R0:1), W_packed(R2:3), sw(R4:5), ids(R6:7), alpha_w(R8:9), lut(R10:11), C(R12:13),
note       K(56), N(60), x_stride(64).
note Grid: (ceil(N/32), 8, 1), Block: 256, SMEM: 12288. K % 128 == 0, K <= 2304.
note =========================================================================
fn nvfp4QuadMac w0 ulong w1 ulong xBase ulong nibStart ulong to void
for j ulong 4
sh = mul add nibStart j 4
if eq sh 0
ic 18 j w0 Z 15 cwAlu0
ic 18 add 4 j w1 Z 15 cwAlu0
else
ic 17 j w0 Z sh cwAlu0
ic 17 add 4 j w1 Z sh cwAlu0
end
end
for j ulong 4
sh = mul add nibStart j 4
if ne sh 0
ic 18 j j Z 15 cwAlu0
ic 18 add 4 j add 4 j Z 15 cwAlu0
end
end
for i ulong 8
icImm 8 i i 59 4 cwAlu0
end
ic 49 8 0 Z 0 cwLd
ic 49 9 1 Z 0 cwLd
ic 49 10 2 Z 0 cwLd
ic 49 11 3 Z 0 cwLd
ic 49 14 4 Z 0 cwLd
ic 49 15 5 Z 0 cwLd
ic 49 19 6 Z 0 cwLd
ic 49 20 7 Z 0 cwLd
ic 0 Z Z Z 0 cwW0
ic4 33 50 8 xBase 50 cwAlu3
ic4 33 51 14 xBase 51 cwAlu3
ic4 33 50 9 add xBase 1 50 cwAlu3
ic4 33 51 15 add xBase 1 51 cwAlu3
ic4 33 50 10 add xBase 2 50 cwAlu3
ic4 33 51 19 add xBase 2 51 cwAlu3
ic4 33 50 11 add xBase 3 50 cwAlu3
ic4 33 51 20 add xBase 3 51 cwAlu3
end


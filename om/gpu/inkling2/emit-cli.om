note SPDX-License-Identifier: AGPL-3.0-only
fn ikWrite w view ulong 4 to void
bytes = new uchar 16 0
for i ulong 16
put bytes i uchar and shr get w div i 4 mul rem i 4 8 255
end
if ne write 1 bytes 0 16 16
exit 4
end
end
fn main to int
arg = new uchar 2 0
if ne argcnt 2
ret 2
end
if ne argread 1 arg 0 2 1
ret 2
end
kind = get arg 0
if not ikKernel kind
ret 2
end
ikDone
ret 0
end

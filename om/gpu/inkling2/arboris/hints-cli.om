note SPDX-License-Identifier: AGPL-3.0-only
note Read one settled Arboris score frame for Inkling-2-Mini (128 experts).
note Header: "ARH1" u32le, pair count, hint budget (<= 128).
note Each pair is an expert ID (0..127, or 0xffffffff to ignore the node)
note followed by positive FP32 score bits in [0, 1]. Emit cache replay OP3 records.
fn ik_ah_read4 b edit uchar 4 to bool
  pos = ulong 0
  while lt pos 4 bound 4
    r = read 0 b pos sub 4 pos
    if le r 0
      ret false
    end
    pos = add pos ulong r
  end
  ret true
end

fn ik_ah_word b view uchar 4 to uint
  word = uint 0
  for i ulong 4
    word = or word shl uint get b i mul i 8
  end
  ret word
end

fn main to int
  b = new uchar 4 0
  peak = new uint 128 0
  hints = new uint 256 0
  if not ik_ah_read4 b
    ret 65
  end
  if ne ik_ah_word b 0x31485241
    ret 65
  end
  if not ik_ah_read4 b
    ret 65
  end
  n = ulong ik_ah_word b
  if not ik_ah_read4 b
    ret 65
  end
  k = ulong ik_ah_word b
  if gt k 128
    ret 65
  end
  for i ulong n bound 0xffffffff
    if not ik_ah_read4 b
      ret 65
    end
    id = ik_ah_word b
    if not ik_ah_read4 b
      ret 65
    end
    if not ik_ar_vote_expert peak id ik_ah_word b
      ret 65
    end
  end
  if ne read 0 b 0 1 0
    ret 65
  end
  count = ik_ar_select_experts peak part hints 0 mul k 2
  if not ik_arboris_send_hints 1 hints ulong count
    ret 74
  end
  ret 0
end

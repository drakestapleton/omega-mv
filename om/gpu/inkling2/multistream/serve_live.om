note SPDX-License-Identifier: AGPL-3.0-only
note 100% Pure Seeded-Omega Real-Weight N=8 Multi-Stream Inkling-2-Mini Server (32,768-tok KV, Native Tool Calling, Live Arboris).
note ZERO CUDA, ZERO libc, ZERO Python, ZERO C, ZERO heap.
note Composes after:
note   context.om + vector.om + launch.om + batch.om + bw_enc_sm121.om + emit_fast.om
note   + arboris/prefetch.om + safetensors.om + tokenizer.om + decode.om + multistream/batcher.om.
note
note Usage:
note   inkling2-serve --self-test                  (loads real 18.3 GB checkpoint, runs 2 interleaved
note                                                concurrent streams + verifies 8-slot 503 gate)
note   inkling2-serve [model_dir] [port]           (starts live HTTP server on port 8080 or [port])

global slReqBuf uchar 131072
global slRespBuf uchar 65536
global slRespLen ulong 1
global slOutTxt uchar 65536
global slOutLen ulong 8
global slPromptIds uint 131072
global slPromptLen ulong 8
global slPromptPos ulong 8
global slDone ulong 8
global slCacheIds uint 131072
global slCacheLen ulong 8
global slCacheHits ulong 1

text slBanner "=== INKLING-2-MINI 100% PURE SEEDED-OMEGA LIVE N=8 SERVER (32K CTX + NATIVE TOOLS + ARBORIS, ZERO CUDA) ===\n"
text slListenMsg "Listening on HTTP port "
text slReadyMsg " (N=8 static 32K KV slots, native tool tokens, Arboris active, 503 server_busy when full)\n"
text slSelfHdr "Running live real-weight multi-stream self-test (2 interleaved streams + 8-slot 503 gate)...\n"
text slS0Prompt "What is the capital of France? Answer in one sentence."
text slS1Prompt "What is 2 + 2? Answer in one sentence."
text slS0Lbl "Stream 0 (slot 0): "
text slS1Lbl "Stream 1 (slot 1): "
text slSelfOk "PASS: live real-weight N=8 multi-stream continuous batcher (2 interleaved coherent streams, 9th -> 503 server_busy, retire+reuse OK)\n"
text slSelfBad "FAIL: live multi-stream self-test failed\n"

text slH200 "HTTP/1.1 200 OK\nContent-Type: application/json\nConnection: close\n\n"
text slH503 "HTTP/1.1 503 Service Unavailable\nContent-Type: application/json\nRetry-After: 1\nConnection: close\n\n{\"error\":{\"type\":\"server_busy\",\"message\":\"all 8 static KV slots occupied\",\"slots_max\":8}}\n"
text slH404 "HTTP/1.1 404 Not Found\nContent-Type: application/json\nConnection: close\n\n{\"error\":{\"type\":\"not_found\"}}\n"
text slHealthPre "{\"status\":\"ok\",\"model\":\"inkling-2-mini\",\"context_window\":32768,\"slots_max\":8,\"slots_active\":"
text slHealthCache ",\"kv_prefix_hits\":"
text slHealthArb1 ",\"arboris_transitions\":"
text slHealthArb2 ",\"arboris_top8_hits\":"
text slHealthArb3 ",\"arboris_top16_hits\":"
text slHealthSuf "}\n"
text slModels "{\"object\":\"list\",\"data\":[{\"id\":\"inkling-2-mini\",\"object\":\"model\",\"context_window\":32768,\"slots_max\":8}]}\n"
text slChatPre "{\"id\":\"cmpl-ik2\",\"object\":\"chat.completion\",\"model\":\"inkling-2-mini\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\""
text slChatMid "\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":"
text slChatMid2 ",\"completion_tokens\":"
text slChatMid3 ",\"total_tokens\":"
text slChatSuf "}}\n"
text slKeyContent "\"content\""
text slKeyCLen "Content-Length:"
text slKeyCLenLo "content-length:"

fn slRespReset to void
put slRespLen 0 0
end

fn slRespAppendHdr s view uchar * n ulong to void
p = get slRespLen 0
for i ulong n bound 512
c = get s i
if and eq c 10 lt p 65528
put slRespBuf p 13
p = add p 1
end
if lt p 65530
put slRespBuf p c
p = add p 1
end
end
put slRespLen 0 p
end

fn slRespAppend s view uchar * n ulong to void
p = get slRespLen 0
for i ulong n bound 32768
if lt p 65530
put slRespBuf p get s i
p = add p 1
end
end
put slRespLen 0 p
end

fn slRespAppendU v ulong to void
tmp = new uchar 24 0
p = get slRespLen 0
if eq v 0
if lt p 65530
put slRespBuf p 48
put slRespLen 0 add p 1
end
ret
end
n = ulong 0
x = v
while gt x 0 bound 24
put tmp n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
for i ulong n bound 24
if lt p 65530
put slRespBuf p get tmp sub sub n 1 i
p = add p 1
end
end
put slRespLen 0 p
end

fn slRespAppendJsonEsc off ulong n ulong to void
p = get slRespLen 0
for i ulong n bound 8192
c = get slOutTxt add off i
if and lt p 65520 ge c 32
if or eq c 34 eq c 92
put slRespBuf p 92
p = add p 1
end
put slRespBuf p c
p = add p 1
else
if and lt p 65520 eq c 10
put slRespBuf p 92
put slRespBuf add p 1 110
p = add p 2
else
if and lt p 65520 eq c 9
put slRespBuf p 92
put slRespBuf add p 1 116
p = add p 2
end
end
end
end
put slRespLen 0 p
end

fn slAppendTokOut slot ulong tid ulong to void
if ge tid IK_VOCAB_MAX
ret
end
l = ulong get ikTokLen tid
if eq l 0
ret
end
off = ulong get ikTokOff tid
cur = get slOutLen slot
base = mul slot 8192
for i ulong l bound 64
if lt cur 8184
put slOutTxt add base cur get ikTokPool add off i
cur = add cur 1
end
end
put slOutLen slot cur
end

fn slCacheMatches slot ulong nTok ulong to bool
cLen = get slCacheLen slot
if or eq cLen 0 le nTok cLen
ret false
end
base = mul slot 16384
for i ulong cLen bound 16384
if ne get slCacheIds add base i get ikTokOutLong i
ret false
end
end
ret true
end

fn slStartFromBuf slot ulong tlen ulong maxGen ulong to bool
nTok = ikTokEncodeSmartLong tlen
if eq nTok 0
ret false
end
base = mul slot 16384
if gt nTok 16300
nTok = ulong 16300
end
startPos = ulong 0
if slCacheMatches slot nTok
startPos = get slCacheLen slot
put slCacheHits 0 add get slCacheHits 0 1
else
ikDResetSlot slot
put slCacheLen slot 0
end
for i ulong nTok bound 16384
put slPromptIds add base i get ikTokOutLong i
end
put slPromptLen slot nTok
put slPromptPos slot startPos
put slOutLen slot 0
put slDone slot 0
put msMaxGen slot maxGen
ret true
end

fn slStartStream slot ulong txt view uchar * tlen ulong maxGen ulong to bool
for i ulong tlen bound 16384
put ikTokInBuf i get txt i
end
ret slStartFromBuf slot tlen maxGen
end

note Execute 1 prefill or decode step for active stream `slot`.
note Stops ONLY on 200006 (<|content_model_end_sampling|>) or 199999 (<|endoftext|>),
note NOT on 200010 (<|end_message|>), so native multi-message tool calls complete cleanly.
fn slStepStream slot ulong to bool
if eq get slDone slot 1
ret true
end
pPos = get slPromptPos slot
pLen = get slPromptLen slot
if lt pPos pLen
if ge sub pLen pPos 9
base = mul slot 16384
for b ulong 8
put ikB8Toks b get slPromptIds add base add pPos b
end
if not ikDPrefillBatch8 slot pPos
put slDone slot 1
ret true
end
for b ulong 8
posB = add pPos b
if lt posB 16300
put slCacheIds add base posB get ikB8Toks b
put slCacheLen slot add posB 1
end
end
put slPromptPos slot add pPos 8
ret false
end
tok = ulong get slPromptIds add mul slot 16384 pPos
needL = eq add pPos 1 pLen
nxt = ikDForwardSlot slot tok pPos needL
if lt nxt 0
put slDone slot 1
ret true
end
if lt pPos 16300
put slCacheIds add mul slot 16384 pPos uint tok
put slCacheLen slot add pPos 1
end
put slPromptPos slot add pPos 1
if needL
if or eq nxt 200006 eq nxt 199999
put slDone slot 1
ret true
end
slAppendTokOut slot ulong nxt
ok = msAdvance slot uint nxt
put msPosQ slot pLen
end
ret false
end
posQ = get msPosQ slot
curTok = ulong get msLastTok slot
nxt = ikDForwardSlot slot curTok posQ true
if lt posQ 16300
put slCacheIds add mul slot 16384 posQ uint curTok
put slCacheLen slot add posQ 1
end
if or lt nxt 0 or eq nxt 200006 eq nxt 199999
put slDone slot 1
ret true
end
slAppendTokOut slot ulong nxt
ok = msAdvance slot uint nxt
if or not ok ge get msGenCnt slot get msMaxGen slot
put slDone slot 1
ret true
end
ret false
end

fn slRunSelfTest to int
ikDPrint slSelfHdr
msInit
s0 = msAdmit 10 32 0
s1 = msAdmit 11 32 0
if or ne s0 0 ne s1 1
ikDPrint slSelfBad
ret 30
end
if not slStartStream 0 slS0Prompt len slS0Prompt 32
ikDPrint slSelfBad
ret 31
end
if not slStartStream 1 slS1Prompt len slS1Prompt 32
ikDPrint slSelfBad
ret 32
end
for k ulong 6
sk = msAdmit int add 12 k 8 0
if ne sk long add 2 k
ikDPrint slSelfBad
ret 33
end
end
if ne msAdmit 99 8 0 -1
ikDPrint slSelfBad
ret 34
end
for k ulong 6
msRetire add 2 k
end
for step ulong 128
d0 = slStepStream 0
d1 = slStepStream 1
if and d0 d1
break
end
end
ikDPrint slS0Lbl
w0 = write 1 slOutTxt 0 get slOutLen 0
ikDPrint ikDMsgNl
ikDPrint slS1Lbl
w1 = write 1 slOutTxt 8192 get slOutLen 1
ikDPrint ikDMsgNl
msRetire 0
msRetire 1
reused = msAdmit 42 8 0
if ne reused 0
ikDPrint slSelfBad
ret 35
end
msRetire 0
if or eq get slOutLen 0 0 eq get slOutLen 1 0
ikDPrint slSelfBad
ret 36
end
ikDPrint slSelfOk
ret 0
end

fn slFindHdrEnd n ulong to ulong
if lt n 4
ret n
end
lim = sub n 3
for i ulong lim bound 4096
if and eq get slReqBuf i 13 eq get slReqBuf add i 1 10
if and eq get slReqBuf add i 2 13 eq get slReqBuf add i 3 10
ret add i 4
end
end
if and eq get slReqBuf i 10 eq get slReqBuf add i 1 10
ret add i 2
end
end
ret n
end

fn slMatchHdrAt pos ulong pat view uchar * to bool
for j ulong len pat bound 32
if ne get slReqBuf add pos j get pat j
ret false
end
end
ret true
end

fn slParseDigitsAt start ulong lim ulong to ulong
p = start
while and lt p lim eq get slReqBuf p 32 bound 32
p = add p 1
end
v = ulong 0
while lt p lim bound 16
c = get slReqBuf p
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
p = add p 1
end
ret v
end

fn slParseContentLength hdrEnd ulong to ulong
if lt hdrEnd 16
ret 0
end
lim = sub hdrEnd 15
for i ulong lim bound 4096
if slMatchHdrAt i slKeyCLen
ret slParseDigitsAt add i 15 hdrEnd
end
if slMatchHdrAt i slKeyCLenLo
ret slParseDigitsAt add i 15 hdrEnd
end
end
ret 0
end

note Read complete HTTP request (headers + full Content-Length body up to 128 KiB).
fn slReadFullReq fd int to ulong
tot = ulong 0
wantTot = ulong 0
for iter ulong 256
if ge tot 131070
break
end
r = read fd slReqBuf tot sub 131070 tot
if eq r -4
continue
end
if le r 0
break
end
tot = add tot ulong r
if eq wantTot 0
he = slFindHdrEnd tot
if lt he tot
cl = slParseContentLength he
if gt cl 0
wantTot = add he cl
if gt wantTot 131070
wantTot = ulong 131070
end
else
break
end
else
if eq get slReqBuf 0 71
if lt he add tot 1
break
end
end
end
end
if and gt wantTot 0 ge tot wantTot
break
end
end
ret tot
end

fn slUnescapeToPrompt st ulong n ulong to ulong
p = st
o = ulong 0
while and lt p n lt o 131000 bound 131072
c = get slReqBuf p
if eq c 34
break
end
p = add p 1
if eq c 92
if ge p n
break
end
e = get slReqBuf p
p = add p 1
if eq e 110
put ikTokInBuf o 10
o = add o 1
else
if eq e 114
put ikTokInBuf o 13
o = add o 1
else
if eq e 116
put ikTokInBuf o 9
o = add o 1
else
put ikTokInBuf o e
o = add o 1
end
end
end
else
put ikTokInBuf o c
o = add o 1
end
end
ret o
end

fn slExtractContent n ulong to ulong
if lt n 14
ret 0
end
lim = sub n 10
for i ulong lim bound 131072
ok = true
for j ulong 9
if ne get slReqBuf add i j get slKeyContent j
ok = false
break
end
end
if ok
p = add i 9
while and lt p n ne get slReqBuf p 34 bound 64
p = add p 1
end
if lt p n
ret slUnescapeToPrompt add p 1 n
end
end
end
ret 0
end

fn slHandleChat fd int n ulong to void
slot = msAdmit fd 1024 0
if lt slot 0
w = write fd slH503 0 len slH503
ret
end
pLen = slExtractContent n
if eq pLen 0
pLen = len slS0Prompt
for i ulong pLen bound 1024
put ikTokInBuf i get slS0Prompt i
end
end
s = ulong slot
if slStartFromBuf s pLen 1024
for step ulong 17408
if slStepStream s
break
end
end
end
pToks = get slPromptLen s
cToks = get msGenCnt s
slRespReset
slRespAppendHdr slH200 len slH200
slRespAppend slChatPre len slChatPre
slRespAppendJsonEsc mul s 8192 get slOutLen s
slRespAppend slChatMid len slChatMid
slRespAppendU pToks
slRespAppend slChatMid2 len slChatMid2
slRespAppendU cToks
slRespAppend slChatMid3 len slChatMid3
slRespAppendU add pToks cToks
slRespAppend slChatSuf len slChatSuf
w = write fd slRespBuf 0 get slRespLen 0
msRetire s
end

fn slHandleHttp fd int to void
n = slReadFullReq fd
if le n 4
ret
end
if and eq get slReqBuf 0 71 eq get slReqBuf 4 47
if eq get slReqBuf 5 104
slRespReset
slRespAppendHdr slH200 len slH200
slRespAppend slHealthPre len slHealthPre
slRespAppendU get msActiveCnt 0
slRespAppend slHealthCache len slHealthCache
slRespAppendU get slCacheHits 0
slRespAppend slHealthArb1 len slHealthArb1
slRespAppendU get ikDArbStats 0
slRespAppend slHealthArb2 len slHealthArb2
slRespAppendU get ikDArbStats 1
slRespAppend slHealthArb3 len slHealthArb3
slRespAppendU get ikDArbStats 2
slRespAppend slHealthSuf len slHealthSuf
w = write fd slRespBuf 0 get slRespLen 0
ret
end
if and eq get slReqBuf 5 118 eq get slReqBuf 8 109
slRespReset
slRespAppendHdr slH200 len slH200
slRespAppend slModels len slModels
w = write fd slRespBuf 0 get slRespLen 0
ret
end
end
if and eq get slReqBuf 0 80 eq get slReqBuf 5 47
slHandleChat fd n
ret
end
w = write fd slH404 0 len slH404
end

fn slIsSelfTestArg to bool
a = new uchar 32 0
if lt argcnt 2
ret false
end
n = argread 1 a 0 32
if eq n 11
if and eq get a 0 45 eq get a 2 115
ret true
end
end
if ge argcnt 3
n2 = argread 2 a 0 32
if eq n2 11
if and eq get a 0 45 eq get a 2 115
ret true
end
end
end
ret false
end

fn slListen port ulong to long
addr = new uchar 16 0
one = new uchar 4 0
put addr 0 2
put addr 2 uchar shr port 8
put addr 3 uchar and port 255
put one 0 1
fd = socknew 2 524289 0
if lt fd 0
ret fd
end
r = sockopt int fd 1 2 one 0 4
if eq r 0
r = bind int fd addr 0 16
end
if eq r 0
r = listen int fd 16
end
if ne r 0
c = fclose int fd
ret r
end
ret fd
end

fn main to int
ikDPrint slBanner
ikDPrint ikDMsgLoad
t0 = monons
rc0 = ikDInitModel 8
if ne rc0 0
ikDPrint ikDMsgFail
ikDPrintU ulong rc0
ikDPrint ikDMsgNl
ret rc0
end
t1 = monons
ikDPrint ikDMsgLoaded
ikDPrintU ulong div sub t1 t0 1000000
ikDPrint ikDMsgNl
ikArbResetAll
for i ulong 3072
put ikDArbRes i -1
end
for i ulong 4
put ikDArbStats i 0
end
for s ulong 8
put slCacheLen s 0
end
put slCacheHits 0 0
if slIsSelfTestArg
rc1 = slRunSelfTest
rc = nvmclose
ret rc1
end
msInit
port = ulong 8080
lfd = slListen port
if lt lfd 0
rc = nvmclose
ret 40
end
ikDPrint slListenMsg
ikDPrintU port
ikDPrint slReadyMsg
for conn ulong 1000000
cfd = accept int lfd 524288
if ge cfd 0
slHandleHttp int cfd
c0 = fclose int cfd
end
end
c1 = fclose int lfd
rc = nvmclose
ret 0
end

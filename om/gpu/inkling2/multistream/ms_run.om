m = nvalloc 926318592 true
if le m 0
ret false
end
put msUnembed 0 m
if not msFillPattern m 926318592 0x3c003c00
ret false
end
m = nvalloc 6432768 true
if le m 0
ret false
end
put msLogits 0 m
m = nvalloc 2097152 false
if le m 0
ret false
end
put msFastPkt 0 m
ret true
end

fn main to int
msPrint msHdr
if not msTestBatcher
msPrint msFail
msPrintU 1
msPrint msNl
ret 1
end
if not gbopen 1
ret 2
end
if not gbbopen
ret 3
end
put msCodeMap 0 0
if not msEmitAll
ret 4
end
csize = mul div add get msCodePos 0 4095 4096 4096
cm = nvalloc csize false
if le cm 0
ret 5
end
put msCodeMap 0 cm
put msCodeFail 0 0
if not msEmitAll
ret 6
end
lm = nvalloc 4096 true
if le lm 0
ret 7
end
put msLut 0 lm
if not msWriteLut lm
ret 8
end
wm = nvalloc 33554432 true
if le wm 0
ret 9
end
put msWork 0 wm
if not msTestKernels
msPrint msFail
msPrintU 10
msPrint msNl
rc = nvmclose
ret 10
end
if not msAllocModel
rc = nvmclose
ret 11
end
if not msBenchConfig 1 8 false msResB1
rc = nvmclose
ret 12
end
if not msBenchConfig 4 16 false msResB4
rc = nvmclose
ret 13
end
if not msBenchConfig 8 24 false msResB8
rc = nvmclose
ret 14
end
if not msBenchConfig 1 8 true msResB1U
rc = nvmclose
ret 15
end
if not msBenchConfig 4 16 true msResB4U
rc = nvmclose
ret 16
end
if not msBenchConfig 8 24 true msResB8U
rc = nvmclose
ret 17
end
rc = nvmclose
ret 0
end

note SPDX-License-Identifier: AGPL-3.0-only
note 100% Pure Seeded-Omega Multi-Stream Inkling-2-Mini Runner & Throughput Benchmark (B = 1, 4, 8).
note ZERO libcuda.so.1, ZERO libc, ZERO Python, ZERO C.
note Compose after:
note   gpu/nvidia/native/nvrm/context.om
note   gpu/nvidia/native/blackwell/vector.om
note   gpu/nvidia/native/blackwell/launch.om
note   gpu/nvidia/native/blackwell/batch.om
note   om/encoder/bw_enc_sm121.om
note   om/gpu/inkling2/emit_fast.om
note   om/gpu/inkling2/emit_batch.om
note   om/gpu/inkling2/multistream/batcher.om

global msCodeMap long 1
global msCodePos ulong 1
global msCodeFail uint 1
global msEntry ulong 24
global msSmem ulong 24
global msBind uint 32
global msBindN ulong 1
global msFastMode ulong 1
global msFastPos ulong 1
global msFastPkt long 1
global msFastBytes ulong 1

global msLut long 1
global msWork long 1
global msKvSlab long 1
global msUnembed long 1
global msLogits long 1
global msWqkv long 4
global msWo long 4
global msWgate long 4
global msW413 long 4
global msS413 long 4
global msW42 long 4
global msS42 long 4
global msW813 long 1
global msS813 long 1
global msW82 long 1
global msS82 long 1
global msFillBuf uchar 65536

text msHdr "=== INKLING-2-MINI 100% PURE SEEDED-OMEGA MULTI-STREAM GB10 RUNNER (ZERO CUDA) ===\n"
text msBatcherOk "PASS: static 8-slot paged-KV table + continuous batcher (8 admitted, 9th -> 503 server_busy, retire+reuse, dedup OK)\n"
text msKernelOk "PASS: multi-stream SM121 kernel parity (bf16_gemm_batch B=4/8, nvfp4_gemm_dedup B=8, mxfp8_gemm_dedup B=8)\n"
text msFail "FAIL: multi-stream error code="
text msNl "\n"
text msResB1 "MS_GPFIFO_48L_B1_NO_UNEMBED: step_us="
text msResB4 "MS_GPFIFO_48L_B4_NO_UNEMBED: step_us="
text msResB8 "MS_GPFIFO_48L_B8_NO_UNEMBED: step_us="
text msResB8U "MS_GPFIFO_48L_B8_FULL_201K_UNEMBED: step_us="
text msResB4U "MS_GPFIFO_48L_B4_FULL_201K_UNEMBED: step_us="
text msResB1U "MS_GPFIFO_48L_B1_FULL_201K_UNEMBED: step_us="
text msAgg " agg_tok_s_x100="
text msFinOk " finite=OK\n"
text msFinBad " finite=FAIL\n"

fn msPrint s view uchar * to void
w = write 1 s 0 len s
end

fn msPrintU v ulong to void
b = new uchar 32 0
if eq v 0
put b 0 48
w = write 1 b 0 1
ret
end
n = ulong 0
x = v
while gt x 0 bound 32
put b n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
for i ulong n bound 32
p = sub sub n 1 i
w = write 1 b p 1
end
end

fn ikfWrite w view ulong 4 to void
p = get msCodePos 0
b = new uchar 16 0
if gt get msCodeMap 0 0
for i ulong 16
put b i uchar and shr get w div i 4 mul rem i 4 8 255
end
if ne mapwrite get msCodeMap 0 p b 0 16 16
put msCodeFail 0 1
end
end
put msCodePos 0 add p 16
end

fn msEmitAll to bool
put msCodePos 0 0
for i ulong 21
p = mul div add get msCodePos 0 255 256 256
put msEntry i p
put msCodePos 0 p
put ikfPc 0 0
put ikfGuard 0 0
if not ikfKernel uchar add 97 i
ret false
end
ikfDone
end
for j ulong 3
idx = add 21 j
p = mul div add get msCodePos 0 255 256 256
put msEntry idx p
put msCodePos 0 p
put ikfPc 0 0
put ikfGuard 0 0
if not ikbKernel uchar add 65 j
ret false
end
ikfDone
end
put msSmem 0 16384
put msSmem 1 12288
put msSmem 2 12288
put msSmem 3 6144
put msSmem 4 512
put msSmem 5 256
put msSmem 6 10752
put msSmem 7 0
put msSmem 8 1088
put msSmem 9 1088
put msSmem 10 0
put msSmem 11 0
put msSmem 12 2048
put msSmem 13 6144
put msSmem 14 0
put msSmem 15 0
put msSmem 16 256
put msSmem 17 9280
put msSmem 18 0
put msSmem 19 0
put msSmem 20 0
put msSmem 21 8192
put msSmem 22 9280
put msSmem 23 9280
ret eq get msCodeFail 0 0
end

fn msArg u uint to void
i = get msBindN 0
put msBind i u
put msBindN 0 add i 1
end

fn msPtr va ulong to void
msArg gblo va
msArg gbhi va
end

fn msFastEmit words ulong to bool
cb = mapaddr get gbmem 1
gbdma add cb 896 uint words
for j ulong words
gbemit get msBind j
end
q = mapaddr get gbmem 2
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
gbrel add mapaddr get gbmem 3 32 6
put msBindN 0 0
n = get gbused 0
pos = get msFastPos 0
if gt add pos n 2096000
ret false
end
if ne mapwrite get msFastPkt 0 pos gbcmd 0 n long n
ret false
end
put msFastPos 0 add pos n
ret true
end

fn msRecord id ulong gx uint gy uint gz uint bx uint to bool
gbqmd 1
a = add mapaddr get msCodeMap 0 get msEntry id
put gbq1 32 gblo shr a 4
put gbq1 33 or uint and shr a 36 2097151 20971520
put gbq1 59 gblo shr a 8
put gbq1 34 or uint 65536 bx
put gbq1 35 or uint 131073 shl uint 64 8
sm = get msSmem id
s7 = ulong 8
if ne sm 0
s7 = div add sm 127 128
end
put gbq1 36 uint or 78923776 s7
put gbq1 37 0
put gbq1 39 gx
put gbq1 40 gy
put gbq1 41 gz
put gbcb 216 bx
put gbcb 220 gx
put gbcb 221 gy
put gbcb 222 gz
cb = mapaddr get gbmem 1
words = get msBindN 0
endva = add cb add 896 mul words 4
put gbcb 212 gbhi endva
put gbcb 213 gblo endva
put gbused 0 0
if eq get msFastMode 0 1
ret msFastEmit words
end
gbsetup
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
gbdma add cb 896 uint words
for j ulong words
gbemit get msBind j
end
q = mapaddr get gbmem 2
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
put msBindN 0 0
ret gbappend id get gbst 1
end

fn msFastBegin to bool
put msFastMode 0 1
put msFastPos 0 0
put gbused 0 0
gbsetup
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
cb = mapaddr get gbmem 1
gbdriver cb
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
n = get gbused 0
if ne mapwrite get msFastPkt 0 0 gbcmd 0 n long n
ret false
end
put msFastPos 0 n
ret true
end

fn msFastFinish to bool
put gbused 0 0
gbtail
n = get gbused 0
pos = get msFastPos 0
if ne mapwrite get msFastPkt 0 pos gbcmd 0 n long n
ret false
end
put msFastBytes 0 add pos n
put msFastMode 0 0
ret true
end

fn msWaitFast budget ulong to bool
t0 = monons
while lt ulong sub monons t0 budget bound 5000000
if eq mapget get gbmem 3 16 4 1179010630
put nvret 0 get nvput 0
ret true
end
r = sleepns long 5000
end
ret false
end

fn msReplayFast to bool
r = mapset get gbmem 2 8192 4 0
r = mapset get gbmem 3 0 4 0
r = mapset get gbmem 3 16 4 0
nb = get msFastBytes 0
if not nvsend get msFastPkt 0 0 uint div nb 4
ret false
end
if not msWaitFast 15000000000
ret false
end
ret eq mapget get gbmem 3 0 4 1145324612
end

fn msWriteLut m long to bool
for code ulong 256
exp = and shr code 3 15
frac = and code 7
bits = uint 0
if and eq exp 15 eq frac 7
bits = uint 0x7fc00000
else
v = f32 0.0
if eq exp 0
v = div f32 frac f32 512.0
else
p = f32 1.0
if ge exp 7
for s ulong sub exp 7 bound 16
p = mul p f32 2.0
end
else
for s ulong sub 7 exp bound 16
p = mul p f32 0.5
end
end
v = mul add f32 1.0 div f32 frac f32 8.0 p
end
if ne and code 128 0
v = sub f32 0.0 v
end
bits = bitcast uint v
end
if ne mapset m mul code 4 4 ulong bits 0
ret false
end
end
fp4 = new f32 16 0.0f32
put fp4 0 0.0f32
put fp4 1 0.5f32
put fp4 2 1.0f32
put fp4 3 1.5f32
put fp4 4 2.0f32
put fp4 5 3.0f32
put fp4 6 4.0f32
put fp4 7 6.0f32
for k ulong 8
put fp4 add 8 k sub 0.0f32 get fp4 k
end
for k ulong 16
if ne mapset m mul add 256 k 4 4 ulong bitcast uint get fp4 k 0
ret false
end
end
ret true
end

fn msFillPattern m long nbytes ulong pat uint to bool
for i ulong 16384
put msFillBuf mul i 4 uchar and pat 255
put msFillBuf add mul i 4 1 uchar and shr pat 8 255
put msFillBuf add mul i 4 2 uchar and shr pat 16 255
put msFillBuf add mul i 4 3 uchar and shr pat 24 255
end
off = ulong 0
while lt off nbytes bound 20000
n = sub nbytes off
if gt n 65536
n = ulong 65536
end
if ne mapwrite m off msFillBuf 0 n long n
ret false
end
off = add off n
end
ret true
end

fn msCheckF32 m long off ulong want f32 tol f32 to bool
v = bitcast f32 uint mapget m off 4
d = sub v want
if lt d f32 0.0f32
d = sub f32 0.0f32 d
end
ret le d tol
end

fn msIsFiniteU32 u ulong to bool
ret ne and u 0x7f800000 0x7f800000
end

note Phase 0: Verify static 8-slot paged-KV table, 503 admission gate, retire+reuse, and expert dedup.
fn msTestBatcher to bool
msInit
for s ulong 8
sl = msAdmit int add 10 s 32 uint add 100 s
if ne sl long s
ret false
end
end
if ne msAdmit 99 32 999 -1
ret false
end
for step ulong 70
if not msAdvance 3 uint step
ret false
end
end
if ne get msStreamPageCnt 3 2
ret false
end
msRetire 3
if ne get msActiveCnt 0 7
ret false
end
reused = msAdmit 42 16 777
if ne reused 3
ret false
end
ids = new uint 64 0
for s ulong 8
for k ulong 8
put ids add mul s 8 k uint add mul rem s 2 8 k
end
end
u = msDedupExperts ids 8
if ne u 16
ret false
end
if ne get msUniqCnt 0 4
ret false
end
msPrint msBatcherOk
ret true
end

note Write msUniqEids/msUniqCnt/msSlotMap + alpha[128] into UVM meta buffer at wk + metaOff.
fn msUploadDedupMeta wk long metaOff ulong alphaVal uint to void
for i ulong 64
r = mapset wk add metaOff mul i 4 4 ulong get msUniqEids i
r = mapset wk add add metaOff 256 mul i 4 4 ulong get msUniqCnt i
end
for i ulong 512
r = mapset wk add add metaOff 512 mul i 4 4 ulong get msSlotMap i
end
for e ulong 128
r = mapset wk add add metaOff 2560 mul e 4 4 ulong alphaVal
end
end

note Phase 1: Live-silicon parity test for bf16_gemm_batch_fast (B=8), nvfp4_gemm_dedup_fast (B=8), mxfp8_gemm_dedup_fast (B=8).
fn msTestKernels to bool
wk = get msWork 0
wva = mapaddr wk
lutva = mapaddr get msLut 0
note W_bf16[32, 2304] = 0.5 (0x3f00) at 0x000000
for i ulong 36864
r = mapset wk mul i 4 4 0x3f003f00
end
note X[8, 2304] at 0x040000: stream b has value (b + 1.0)
for b ulong 8
fv = add f32 b f32 1.0f32
fb = ulong bitcast uint fv
for k ulong 2304
r = mapset wk add 0x040000 mul add mul b 2304 k 4 4 fb
end
end
note NVFP4 W_u8[16, 32, 1152] = 1.0 (0x22222222) at 0x100000, sw = 1.0 (0x38383838) at 0x200000
for i ulong 147456
r = mapset wk add 0x100000 mul i 4 4 0x22222222
end
for i ulong 18432
r = mapset wk add 0x200000 mul i 4 4 0x38383838
end
note MXFP8 W_fp8[16, 32, 2304] = 1.0 (0x38383838) at 0x300000, sw = 1.0 (0x7f7f7f7f) at 0x480000
for i ulong 294912
r = mapset wk add 0x300000 mul i 4 4 0x38383838
end
for i ulong 9216
r = mapset wk add 0x480000 mul i 4 4 0x7f7f7f7f
end
note X_rec[64, 2304] at 0x500000: slot m has value (1.0 + (m & 7))
for m ulong 64
fv = add f32 and m 7 f32 1.0f32
fb = ulong bitcast uint fv
for k ulong 2304
r = mapset wk add 0x500000 mul add mul m 2304 k 4 4 fb
end
end
ids = new uint 64 0
for s ulong 8
for k ulong 8
put ids add mul s 8 k uint add mul rem s 2 8 k
end
end
u = msDedupExperts ids 8
msUploadDedupMeta wk 0x080000 0x3f800000
if not gbbegin 3
ret false
end
note 1. bf16_gemm_batch_fast (B=8, K=2304, N=32 -> Y[b, 0] = (b+1)*1152.0)
msPtr wva
msPtr add wva 0x040000
msPtr add wva 0x060000
msArg 2304
msArg 32
msArg 8
if not msRecord 21 4 1 1 256
ret false
end
note 2. nvfp4_gemm_dedup_fast (U=16 unique experts x 4 streams each -> C[m, 0] = (1 + (m&7)) * 2304.0)
msPtr add wva 0x500000
msPtr add wva 0x100000
msPtr add wva 0x200000
msPtr add wva 0x080000
msPtr lutva
msPtr add wva 0x600000
msArg 2304
msArg 32
if not msRecord 22 4 uint u 1 256
ret false
end
note 3. mxfp8_gemm_dedup_fast (U=16 unique experts x 4 streams each -> C[m, 0] = (1 + (m&7)) * 2304.0)
msPtr add wva 0x500000
msPtr add wva 0x300000
msPtr add wva 0x480000
msPtr add wva 0x080000
msPtr lutva
msPtr add wva 0x640000
msArg 2304
msArg 32
if not msRecord 23 4 uint u 1 256
ret false
end
if not gbbsubmit 10000000000
msPrint msFail
msPrintU add 100 get gbst 4
msPrint msNl
ret false
end
for b ulong 8
want = mul add f32 b f32 1.0f32 f32 1152.0f32
if not msCheckF32 wk add 0x060000 mul mul b 32 4 want 0.5f32
msPrint msFail
msPrintU add 200 b
msPrint msAgg
msPrintU mapget wk add 0x060000 mul mul b 32 4 4
msPrint msNl
ret false
end
end
for m ulong 64
want = mul add f32 and m 7 f32 1.0f32 f32 2304.0f32
if not msCheckF32 wk add 0x600000 mul mul m 32 4 want 1.0f32
msPrint msFail
msPrintU add 300 m
msPrint msAgg
msPrintU mapget wk add 0x600000 mul mul m 32 4 4
msPrint msNl
ret false
end
if not msCheckF32 wk add 0x640000 mul mul m 32 4 want 1.0f32
msPrint msFail
msPrintU add 400 m
msPrint msAgg
msPrintU mapget wk add 0x640000 mul mul m 32 4 4
msPrint msNl
ret false
end
end
msPrint msKernelOk
ret true
end

fn msW off ulong to ulong
ret add mapaddr get msWork 0 off
end

fn msPhysLayer step ulong to ulong
if lt step 6
ret step
end
if lt step 42
ret add 6 rem sub step 6 12
end
ret sub step 24
end

fn msRecordLayer48 step ulong B ulong U ulong to bool
l = msPhysLayer step
bk = rem step 4
isFull = or or eq l 5 eq l 11 or eq l 17 eq l 23
isMx8 = ge l 20
lutva = mapaddr get msLut 0
note Batched RMSNorm (Grid.x = B)
msPtr msW 0
msPtr msW 0x018000
msPtr msW 0x020000
msArg 2304
if not msRecord 5 uint B 1 1 256
ret false
end
note Batched QKV + Gate BF16 GEMM (W loaded ONCE for all B streams!)
msPtr mapaddr get msWqkv bk
msPtr msW 0x020000
msPtr msW 0x040000
msArg 2304
msArg 8192
msArg uint B
if not msRecord 21 1024 1 1 256
ret false
end
note Batched Split-K Flash-Decoding (Grid = (24, S, B), disjoint 64MB K + 64MB V slabs)
kva = mapaddr get msKvSlab 0
msPtr msW 0x040000
msPtr kva
msPtr add kva 67108864
msPtr msW 0x100000
msPtr msW 0x180000
msPtr msW 0x200000
msArg 24
msArg 8
if isFull
msArg 4096
msArg 1024
msArg 1000
msArg 0
msArg 4
if not msRecord 13 24 4 uint B 256
ret false
end
else
msArg 1024
msArg 1024
msArg 1000
msArg 1024
msArg 2
if not msRecord 13 24 2 uint B 256
ret false
end
end
msPtr msW 0x180000
msPtr msW 0x200000
msPtr msW 0x220000
msPtr msW 0x048000
msPtr msW 0x040000
msArg 24
if isFull
msArg 4
else
msArg 2
end
if not msRecord 14 24 uint B 1 32
ret false
end
note Batched Wo BF16 GEMM (W loaded ONCE for all B streams!)
msPtr mapaddr get msWo bk
msPtr msW 0x040000
msPtr msW 0
msArg 3072
msArg 2304
msArg uint B
if not msRecord 21 288 1 1 256
ret false
end
note Batched Router (Grid.x = B)
msPtr msW 0
msPtr mapaddr get msWgate bk
msPtr msW 0x1a0000
msPtr msW 0x1a1000
msPtr msW 0x1a2000
if not msRecord 6 uint B 1 1 256
ret false
end
note Deduplicated MoE Experts (U unique experts across all B streams!)
if not isMx8
msPtr msW 0x500000
msPtr mapaddr get msW413 bk
msPtr mapaddr get msS413 bk
msPtr msW 0x080000
msPtr lutva
msPtr msW 0x700000
msArg 2304
msArg 2304
if not msRecord 22 288 uint U 1 256
ret false
end
msPtr msW 0x700000
msPtr msW 0x1a2000
msPtr msW 0x500000
msPtr 0
msArg 1152
if not msRecord 10 9 uint mul B 8 1 128
ret false
end
msPtr msW 0x500000
msPtr mapaddr get msW42 bk
msPtr mapaddr get msS42 bk
msPtr msW 0x080000
msPtr lutva
msPtr msW 0x700000
msArg 1152
msArg 2304
if not msRecord 22 288 uint U 1 256
ret false
end
else
msPtr msW 0x500000
msPtr mapaddr get msW813 0
msPtr mapaddr get msS813 0
msPtr msW 0x080000
msPtr lutva
msPtr msW 0x700000
msArg 2304
msArg 2304
if not msRecord 23 288 uint U 1 256
ret false
end
msPtr msW 0x700000
msPtr msW 0x1a2000
msPtr msW 0x500000
msPtr 0
msArg 1152
if not msRecord 10 9 uint mul B 8 1 128
ret false
end
msPtr msW 0x500000
msPtr mapaddr get msW82 0
msPtr mapaddr get msS82 0
msPtr msW 0x080000
msPtr lutva
msPtr msW 0x700000
msArg 1152
msArg 2304
if not msRecord 23 288 uint U 1 256
ret false
end
end
ret true
end

fn msSort12 t edit ulong 12 to void
for i ulong 12
for j ulong 11
if gt get t j get t add j 1
tmp = get t j
put t j get t add j 1
put t add j 1 tmp
end
end
end
end

fn msBenchConfig B ulong U ulong incUnembed bool label view uchar * to bool
wk = get msWork 0
ids = new uint 64 0
for s ulong B bound 8
for k ulong 8
e = rem add mul s 4 k U
put ids add mul s 8 k uint e
end
end
uActual = msDedupExperts ids B
msUploadDedupMeta wk 0x080000 0x3b03126f
if not msFastBegin
ret false
end
for s ulong 48
if not msRecordLayer48 s B uActual
put msFastMode 0 0
ret false
end
end
if incUnembed
msPtr mapaddr get msUnembed 0
msPtr msW 0
msPtr mapaddr get msLogits 0
msArg 2304
msArg 201024
msArg uint B
if not msRecord 21 25128 1 1 256
put msFastMode 0 0
ret false
end
end
if not msFastFinish
ret false
end
for w ulong 2
if not msReplayFast
ret false
end
end
ts = new ulong 12 0
for it ulong 12
t0 = monons
if not msReplayFast
ret false
end
t1 = monons
put ts it div ulong sub t1 t0 1000
end
msSort12 ts
medUs = get ts 6
aggTokSx100 = div mul B 100000000 medUs
msPrint label
msPrintU medUs
msPrint msAgg
msPrintU aggTokSx100
if msIsFiniteU32 mapget wk 0 4
msPrint msFinOk
else
msPrint msFinBad
ret false
end
ret true
end


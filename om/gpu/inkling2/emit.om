note SPDX-License-Identifier: AGPL-3.0-only
note Inkling-2-Mini SM121 SASS emitter. Compose after om/encoder/bw_enc_sm121.om.
note R0..R13 pointer pairs (up to 7 pointers), R14 lane, R15 CTA.x, R16:R17 addr, R18 CTA.y, R19 CTA.z.
const Z ulong 255
global ikPc ulong 1
global ikGuard ulong 1

fn ikCtrl op ulong to ulong
wb = ulong 7
rbar = ulong 7
if or or and ge op 3 le op 7 and ge op 38 le op 42 or eq op 47 eq op 59
wb = ulong 0
end
if or eq op 11 eq op 19
wb = ulong 0
rbar = ulong 1
end
if eq op 12
rbar = ulong 1
end
stall = ulong 6
if or ne wb 7 ne rbar 7
stall = ulong 4
end
if or eq op 28 eq op 34
stall = ulong 14
end
ret or 0x300000 or shl stall 9 or shl wb 14 shl rbar 17
end

fn inst op ulong dst ulong a ulong b ulong c ulong imm ulong to void
o = new ulong 16 0
w = new ulong 4 0
native = op
if or eq op 65 eq op 66
native = ulong 61
end
if or eq op 67 eq op 68
native = ulong 12
end
if or eq op 69 eq op 70
native = ulong 40
end
put o 0 native
put o 1 dst
put o 2 a
put o 3 b
put o 4 c
put o 5 4
put o 6 and imm 0xffffffff
put o 7 ikCtrl native
if ne get ikGuard 0 0
put o 9 1
end
if eq get ikGuard 0 2
put o 10 1
end
put ikGuard 0 0
if ne a Z
put o 12 1
end
if ne b Z
put o 13 1
end
if ne enc1 o w 0
exit 3
end
if eq op 65
put w 2 0x048070ff
end
if eq op 66
put w 2 0x042070ff
end
if eq op 67
put w 2 sub get w 2 0x800
end
if eq op 68
put w 2 sub get w 2 0x400
end
if eq op 69
put w 2 0xc00
end
if eq op 70
put w 2 0x2000
end
ikWrite w
put ikPc 0 add get ikPc 0 1
end

fn literal d ulong x ulong to void
inst 2 d Z Z Z x
end

fn number d ulong x f32 to void
literal d ulong bitcast uint x
end

fn mad d ulong a ulong scale ulong c ulong to void
inst 8 d a Z c scale
end

fn madreg d ulong a ulong b ulong c ulong to void
inst 8 d a b c 0
end

fn iadd d ulong a ulong b ulong to void
inst 14 d a b Z 0
end

fn fop op ulong d ulong a ulong b ulong to void
inst op d a b Z 0
end

fn fmaReg d ulong a ulong b ulong c ulong to void
inst 33 d a b c 0
end

fn parameter d ulong offset ulong to void
inst 4 d Z Z Z add 896 offset
end

fn ikStart pointers ulong to void
inst 7 4 Z Z Z 856
for i ulong pointers
inst 5 mul i 2 Z Z Z add 896 mul i 8
end
inst 3 14 Z Z Z 33
inst 3 15 Z Z Z 37
inst 3 18 Z Z Z 38
inst 3 19 Z Z Z 39
end

fn readAt d ulong base ulong idx ulong offset ulong to void
inst 9 16 idx Z base 4
inst 11 d 16 Z Z offset
end

fn writeAt d ulong base ulong idx ulong offset ulong to void
inst 9 16 idx Z base 4
inst 12 Z 16 d Z offset
end

fn nextLoop counter ulong limit ulong mark ulong one ulong to void
iadd counter counter one
inst 28 Z counter limit Z 0
put ikGuard 0 2
inst 46 Z Z Z Z sub mark get ikPc 0
end

fn expReg d ulong a ulong logtwo ulong to void
fop 32 d a logtwo
fop 47 d d Z
end

fn sigmoid d ulong a ulong neglog ulong one ulong to void
expReg d a neglog
fop 30 d d one
fop 40 d d Z
end

note Stable tanh(a) = 2 * sigmoid(2 * clamp(a, -20, 20)) - 1. Uses scratch s1, s2, s3.
fn tanhReg d ulong a ulong s1 ulong s2 ulong s3 ulong to void
number s1 20.0f32
number s2 -20.0f32
fop 36 d a s1
fop 37 d d s2
number s1 -2.8853900817779268f32
number s2 1.0f32
number s3 2.0f32
sigmoid d d s1 s2
number s1 -1.0f32
fmaReg d s3 d s1
end

fn byteRead d ulong base ulong idx ulong to void
inst 17 52 idx Z Z 2
readAt 53 base 52 0
inst 18 52 idx Z Z 3
literal 54 3
fop 29 52 52 54
mad 52 52 8 Z
inst 52 53 53 52 Z 0
inst 17 d 53 Z Z 24
end

fn e8Scale d ulong base ulong idx ulong to void
byteRead d base idx
mad 55 d 1 Z
literal 54 23
inst 52 d d 54 Z 0
literal 54 1
inst 28 Z d 54 Z 0
put ikGuard 0 2
literal d 0x00400000
literal 54 255
inst 28 Z 55 54 Z 0
put ikGuard 0 1
literal d 0x7fc00000
end

fn ikDone to void
inst 45 Z Z Z Z 0
while or lt get ikPc 0 32 ne rem get ikPc 0 8 0
inst 0 Z Z Z Z 0
end
end

note Helper for nvfp4_quant: evaluate candidate scale divisor (6.0 or 4.0) on block at base=R21.
note Inputs: R21=base elem, R22=outer, R23=amax, R24=zero, divisor in divVal.
note Outputs: codeReg=u8 E4M3 code, scaleReg=f32 effective scale, invReg=f32 inv scale, maeReg=f32 MAE.
fn nvfp4Cand divVal f32 codeReg ulong scaleReg ulong invReg ulong maeReg ulong to void
number 30 divVal
fop 32 30 30 22
number 31 0.0f32
inst 34 0 30 24 Z 0x03f04000
put ikGuard 0 1
fop 40 31 30 Z
fop 32 31 23 31
inst 65 codeReg Z 31 Z 0
inst 18 codeReg codeReg Z Z 255
readAt scaleReg 2 codeReg 0
fop 32 scaleReg scaleReg 22
number invReg 0.0f32
inst 34 0 scaleReg 24 Z 0x03f04000
put ikGuard 0 1
fop 40 invReg scaleReg Z
number maeReg 0.0f32
literal 32 0
literal 33 16
literal 34 1
mark = get ikPc 0
iadd 35 21 32
readAt 36 0 35 0
fop 32 37 36 invReg
inst 66 38 Z 37 Z 0
inst 18 38 38 Z Z 15
readAt 38 2 38 1024
fop 32 38 38 scaleReg
fop 31 38 36 38
inst 18 38 38 Z Z 0x7fffffff
fop 30 maeReg maeReg 38
nextLoop 32 33 mark 34
end

note a: NVFP4 block-16 quantizer with fouroversix_mae (6 vs 4 scale selection).
note Args: in[N,16], lut[272], outer_scale[1], packed[N,8], scales[N], recon[N,16], N.
note Grid: (ceil(N/128)), block 128. Each thread owns one 16-element block.
fn nvfp4Quant to void
ikStart 6
parameter 25 48
mad 20 15 128 14
inst 28 Z 20 25 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
mad 21 20 16 Z
literal 26 0
readAt 22 4 26 0
number 23 0.0f32
number 24 0.0f32
literal 32 0
literal 33 16
literal 34 1
mark = get ikPc 0
iadd 35 21 32
readAt 36 0 35 0
inst 18 36 36 Z Z 0x7fffffff
fop 37 23 23 36
nextLoop 32 33 mark 34
nvfp4Cand 6.0f32 40 41 42 43
nvfp4Cand 4.0f32 44 45 46 47
note Pick candidate 4 if mae6 > mae4.
inst 34 0 43 47 Z 0x03f04000
put ikGuard 0 1
mad 40 44 1 Z
inst 34 0 43 47 Z 0x03f04000
put ikGuard 0 1
mad 41 45 1 Z
inst 34 0 43 47 Z 0x03f04000
put ikGuard 0 1
mad 42 46 1 Z
inst 9 16 20 Z 8 1
inst 67 Z 16 40 Z 0
mad 48 20 8 Z
literal 32 0
literal 33 8
literal 34 1
mark = get ikPc 0
mad 35 32 2 21
readAt 36 0 35 0
readAt 37 0 35 4
fop 32 36 36 42
fop 32 37 37 42
inst 66 38 37 36 Z 0
iadd 39 48 32
inst 9 16 39 Z 6 1
inst 67 Z 16 38 Z 0
inst 18 50 38 Z Z 15
inst 17 51 38 Z Z 4
inst 18 51 51 Z Z 15
readAt 50 2 50 1024
readAt 51 2 51 1024
fop 32 50 50 41
fop 32 51 51 41
writeAt 50 10 35 0
writeAt 51 10 35 4
nextLoop 32 33 mark 34
end

note b: NVFP4 GEMM. Packed E2M1 A[M,K/2], W[N,K/2], E4M3 scales sa[M,K/16], sw[N,K/16],
note alpha[1] (outer_scale_a * outer_scale_w), lut[272], C[M,N], scalars K, N.
note Grid: (ceil(N/128), M), block 128. K divisible by 16.
fn nvfp4Gemm to void
ikStart 7
parameter 21 56
parameter 22 60
mad 20 15 128 14
inst 28 Z 20 22 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
inst 17 23 21 Z Z 4
madreg 24 18 23 Z
madreg 25 20 23 Z
mad 26 24 2 Z
mad 27 25 2 Z
literal 29 0
literal 30 1
number 31 0.0f32
mark = get ikPc 0
number 32 0.0f32
for k ulong 16
if eq rem k 8 0
readAt 33 0 26 mul div k 8 4
readAt 34 2 27 mul div k 8 4
end
inst 17 35 33 Z Z mul rem k 8 4
inst 18 35 35 Z Z 15
readAt 35 10 35 1024
inst 17 36 34 Z Z mul rem k 8 4
inst 18 36 36 Z Z 15
readAt 36 10 36 1024
fmaReg 32 35 36 32
end
iadd 37 24 29
byteRead 38 4 37
readAt 38 10 38 0
iadd 37 25 29
byteRead 39 6 37
readAt 39 10 39 0
fop 32 32 32 38
fmaReg 31 32 39 31
literal 40 2
iadd 26 26 40
iadd 27 27 40
nextLoop 29 23 mark 30
literal 40 0
readAt 41 8 40 0
fop 32 31 31 41
madreg 42 18 22 20
writeAt 31 12 42 0
end

note c: MXFP8 group-32 quantizer with UE8M0 scales.
note Args: in[G,32], lut[272], packed[G,32], scales[G], recon[G,32]. Grid: (G), block 16.
fn mxfp8Quant to void
ikStart 5
mad 20 15 32 Z
number 21 0.0001f32
number 24 0.002232142857142857f32
for j ulong 32
readAt 22 0 20 mul j 4
inst 18 22 22 Z Z 0x7fffffff
fop 37 21 21 22
end
fop 32 21 21 24
inst 17 23 21 Z Z 23
inst 18 22 21 Z Z 0x7fffff
literal 26 1
inst 28 Z 22 26 Z 0
put ikGuard 0 1
iadd 23 23 26
mad 25 23 8388608 Z
literal 26 1
inst 28 Z 14 26 Z 0
inst 9 16 15 Z 6 1
put ikGuard 0 2
inst 67 Z 16 23 Z 0
mad 26 14 2 20
readAt 27 0 26 0
readAt 28 0 26 4
fop 40 29 25 Z
fop 32 30 27 29
fop 32 31 28 29
inst 65 32 31 30 Z 0
inst 9 16 26 Z 4 1
inst 68 Z 16 32 Z 0
inst 18 34 32 Z Z 255
inst 17 35 32 Z Z 8
inst 18 35 35 Z Z 255
readAt 34 2 34 0
readAt 35 2 35 0
fop 32 34 34 25
fop 32 35 35 25
inst 61 34 35 34 Z 0
inst 18 35 34 Z Z 0xffff0000
mad 34 34 65536 Z
writeAt 34 8 26 0
writeAt 35 8 26 4
end

note d: MXFP8 GEMM ([32,32] UE8M0 weight scales, group-32 UE8M0 activation scales).
note Args: A[M,K], W[N,K], sa[M,K/32], sw[ceil(N/32),K/32], lut[272], C[M,N], K, N.
fn mxfp8Gemm to void
ikStart 6
parameter 21 48
parameter 22 52
mad 20 15 128 14
inst 28 Z 20 22 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
inst 17 23 21 Z Z 5
madreg 24 18 23 Z
madreg 25 20 23 Z
mad 26 25 8 Z
inst 17 27 20 Z Z 5
madreg 27 27 23 Z
mad 28 24 8 Z
literal 29 0
literal 30 1
number 31 0.0f32
mark = get ikPc 0
number 32 0.0f32
for k ulong 32
if eq rem k 4 0
readAt 33 0 28 mul div k 4 4
readAt 34 2 26 mul div k 4 4
end
inst 17 35 33 Z Z mul rem k 4 8
inst 18 35 35 Z Z 255
readAt 35 8 35 0
inst 17 36 34 Z Z mul rem k 4 8
inst 18 36 36 Z Z 255
readAt 36 8 36 0
fmaReg 32 35 36 32
end
iadd 37 24 29
e8Scale 38 4 37
iadd 37 27 29
e8Scale 39 6 37
fop 32 32 32 38
fmaReg 31 32 39 31
literal 40 8
iadd 28 28 40
iadd 26 26 40
nextLoop 29 23 mark 30
madreg 41 18 22 20
writeAt 31 10 41 0
end

note e: General dense FP32/widened-BF16 matmul: A[M,K] x W[N,K]^T -> C[M,N].
fn denseMat to void
ikStart 3
parameter 21 24
parameter 22 28
mad 20 15 128 14
inst 28 Z 20 22 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
madreg 23 18 21 Z
madreg 24 20 21 Z
number 25 0.0f32
literal 26 0
literal 27 1
mark = get ikPc 0
iadd 28 23 26
readAt 28 0 28 0
iadd 29 24 26
readAt 29 2 29 0
fmaReg 25 28 29 25
nextLoop 26 21 mark 27
madreg 28 18 22 20
writeAt 25 4 28 0
end

note f: RMS statistic with Inkling-2-Mini eps = 1e-6. Grid: (B), block 1.
fn rmsStat to void
ikStart 2
parameter 20 16
madreg 21 15 20 Z
number 22 0.0f32
literal 23 0
literal 24 1
mark = get ikPc 0
iadd 25 21 23
readAt 25 0 25 0
fmaReg 22 25 25 22
nextLoop 23 20 mark 24
fop 38 25 20 Z
fop 40 25 25 Z
number 26 0.000001f32
fmaReg 22 22 25 26
fop 41 22 22 Z
writeAt 22 2 15 0
end

note g: Weighted RMSNorm apply: out = in * inv_rms * gain. Grid: (tiles(D), B), block 128.
fn rmsApply to void
ikStart 4
parameter 21 32
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
madreg 22 18 21 20
readAt 23 0 22 0
readAt 24 2 20 0
readAt 25 4 18 0
fop 32 23 23 25
fop 32 23 23 24
writeAt 23 6 22 0
end

note h: Unweighted RMSNorm apply (V-norm, attn_res, msg_gate): out = in * inv_rms.
fn rmsUnweighted to void
ikStart 3
parameter 21 24
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
madreg 22 18 21 20
readAt 23 0 22 0
readAt 24 2 18 0
fop 32 23 23 24
writeAt 23 4 22 0
end

note i: L2 clip with optional learned per-head scale (flags bit 0) and log_scale tau (flags bit 1).
note Args: in[B,H,D], scale[H,D], tau[B], out[B,H,D], H, D, thresh_bits, flags. Grid: (H, B), block 1.
fn l2Clip to void
ikStart 4
parameter 20 32
parameter 21 36
parameter 22 40
parameter 23 44
madreg 24 18 20 15
madreg 24 24 21 Z
madreg 25 15 21 Z
inst 18 26 23 Z Z 1
inst 18 27 23 Z Z 2
literal 28 1
number 29 0.0f32
literal 30 0
mark = get ikPc 0
iadd 31 24 30
readAt 32 0 31 0
inst 28 Z 26 28 Z 0
put ikGuard 0 2
inst 46 Z Z Z Z 5
iadd 33 25 30
readAt 34 2 33 0
fop 32 32 32 34
fmaReg 29 32 32 29
nextLoop 30 21 mark 28
fop 70 29 29 Z
number 35 0.000001f32
fop 30 29 29 35
fop 40 29 29 Z
fop 32 29 22 29
number 35 1.0f32
fop 36 29 29 35
literal 36 2
inst 28 Z 27 36 Z 0
put ikGuard 0 2
inst 46 Z Z Z Z 4
readAt 37 4 18 0
fop 32 29 29 37
literal 30 0
mark = get ikPc 0
iadd 31 24 30
readAt 32 0 31 0
inst 28 Z 26 28 Z 0
put ikGuard 0 2
inst 46 Z Z Z Z 5
iadd 33 25 30
readAt 34 2 33 0
fop 32 32 32 34
fop 32 32 32 29
writeAt 32 6 31 0
nextLoop 30 21 mark 28
end

note j: Static short causal conv1d (k=4) decode step with in-place state update.
note state[B,D,3] stores [t-3, t-2, t-1]. w[D,4] stores [w0(t-3), w1(t-2), w2(t-1), w3(t)].
note out = (w0*s0 + w1*s1 + w2*s2 + w3*x + x) / sqrt(5). Grid: (tiles(D), B), block 128.
fn sconvStatic to void
ikStart 4
parameter 21 32
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
madreg 22 18 21 20
mad 23 22 3 Z
mad 24 20 4 Z
readAt 25 0 22 0
readAt 26 2 23 0
readAt 27 2 23 4
readAt 28 2 23 8
readAt 29 4 24 0
readAt 30 4 24 4
readAt 31 4 24 8
readAt 32 4 24 12
fop 32 33 26 29
fmaReg 33 27 30 33
fmaReg 33 28 31 33
fmaReg 33 25 32 33
fop 30 33 33 25
number 34 0.4472135954999579f32
fop 32 33 33 34
writeAt 33 6 22 0
writeAt 27 2 23 0
writeAt 28 2 23 4
writeAt 25 2 23 8
end

note k: Dynamic short causal conv1d (k=4) decode step for full-attention K and V.
note static_w[4,D] (tap 0 = current token, tap 1 = t-1, tap 2 = t-2, tap 3 = t-3).
note dyn_w[B,H,4] (tap 0..3 per head; head = d >> hd_shift).
note state[B,D,3] stores [t-3, t-2, t-1]. out = (conv + x) / 3.0.
fn sconvDynamic to void
ikStart 5
parameter 21 40
parameter 22 44
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
madreg 23 18 21 20
mad 24 23 3 Z
readAt 25 0 23 0
readAt 26 2 24 0
readAt 27 2 24 4
readAt 28 2 24 8
note head_idx = d >> hd_shift; H = D >> hd_shift; dyn_base = (b * H + head) * 4.
mad 29 20 1 Z
mad 30 21 1 Z
literal 32 0
literal 33 1
inst 28 Z 22 33 Z 0
put ikGuard 0 2
inst 46 Z Z Z Z 6
mark = get ikPc 0
inst 17 29 29 Z Z 1
inst 17 30 30 Z Z 1
nextLoop 32 22 mark 33
madreg 31 18 30 29
mad 31 31 4 Z
note tap 0 (current x)
readAt 32 4 20 0
readAt 33 6 31 0
fop 30 32 32 33
fop 32 34 25 32
note tap 1 (t-1 = R28)
iadd 35 20 21
readAt 32 4 35 0
readAt 33 6 31 4
fop 30 32 32 33
fmaReg 34 28 32 34
note tap 2 (t-2 = R27)
iadd 35 35 21
readAt 32 4 35 0
readAt 33 6 31 8
fop 30 32 32 33
fmaReg 34 27 32 34
note tap 3 (t-3 = R26)
iadd 35 35 21
readAt 32 4 35 0
readAt 33 6 31 12
fop 30 32 32 33
fmaReg 34 26 32 34
fop 30 34 34 25
number 36 0.3333333333333333f32
fop 32 34 34 36
writeAt 34 8 23 0
writeAt 27 2 24 0
writeAt 28 2 24 4
writeAt 25 2 24 8
end

note Helper: compute kv_head = h / (H / Hkv) into kvReg, given h in hReg, H in HReg, Hkv in HkvReg.
note Uses exact repeated subtraction (at most 8 iterations). Scratch: sBase..sBase+3.
fn gqaKvHead kvReg ulong hReg ulong HReg ulong HkvReg ulong sBase ulong to void
r1 = sBase
r2 = add sBase 1
r3 = add sBase 2
r4 = add sBase 3
literal r1 0
literal r2 0
literal r3 1
note Compute group_size r1 = H / Hkv by repeated subtraction.
mad r4 HReg 1 Z
m1 = get ikPc 0
inst 28 Z r4 HkvReg Z 0
put ikGuard 0 2
inst 46 Z Z Z Z 5
literal r2 0xffffffff
madreg r4 HkvReg r2 r4
iadd r1 r1 r3
inst 46 Z Z Z Z sub m1 get ikPc 0
note Compute kvReg = h / group_size.
literal kvReg 0
mad r4 hReg 1 Z
m2 = get ikPc 0
inst 28 Z r4 r1 Z 0
put ikGuard 0 2
inst 46 Z Z Z Z 5
literal r2 0xffffffff
madreg r4 r1 r2 r4
iadd kvReg kvReg r3
inst 46 Z Z Z Z sub m2 get ikPc 0
end

note l: Inkling-2-Mini attention scores with GQA, relative-position bias, causal & sliding-window mask.
note Args: Q[B,H,128], K[B,Hkv,T,128], rel[B,H,R], scores[B,H,T], H, Hkv, T, R, pos_q, window.
note Grid: (T, H, B), block 1. CTA.x = key pos t, CTA.y = query head h, CTA.z = batch b.
fn inklingAttnScores to void
ikStart 4
parameter 20 32
parameter 21 36
parameter 22 40
parameter 23 44
parameter 24 48
parameter 25 52
note out_idx = ((b * H + h) * T) + t
madreg 26 19 20 18
madreg 27 26 22 15
note Causal mask: if t > pos_q (i.e. pos_q < t, or t >= pos_q + 1), write -inf and exit.
literal 28 1
iadd 29 24 28
inst 28 Z 15 29 Z 0
literal 30 0xff800000
inst 9 16 27 Z 6 4
put ikGuard 0 1
inst 12 Z 16 30 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
note dist = pos_q - t (guaranteed >= 0).
literal 31 0xffffffff
madreg 32 15 31 24
note Sliding window mask: if window > 0 and dist >= window, write -inf and exit.
inst 28 Z 25 28 Z 0
put ikGuard 0 2
inst 46 Z Z Z Z 5
inst 28 Z 32 25 Z 0
inst 9 16 27 Z 6 4
put ikGuard 0 1
inst 12 Z 16 30 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
note Compute kv_head into R33.
gqaKvHead 33 18 20 21 34
note Q offset = (b * H + h) * 128; K offset = ((b * Hkv + kv) * T + t) * 128.
mad 34 26 128 Z
madreg 35 19 21 33
madreg 35 35 22 15
mad 35 35 128 Z
number 36 0.0f32
literal 37 0
literal 38 128
literal 39 1
mark = get ikPc 0
iadd 40 34 37
readAt 40 0 40 0
iadd 41 35 37
readAt 41 2 41 0
fmaReg 36 40 41 36
nextLoop 37 38 mark 39
note Scale by 1 / sqrt(128) = 0.08838834764831845.
number 42 0.08838834764831845f32
fop 32 36 36 42
note Add relative position bias if dist < R.
inst 28 Z 32 23 Z 0
put ikGuard 0 1
inst 46 Z Z Z Z 5
madreg 43 26 23 32
readAt 44 4 43 0
fop 30 36 36 44
writeAt 36 6 27 0
end

note m: Inkling-2-Mini attention value mix with per-token learned attention sink.
note Args: scores[B,H,T], V[B,Hkv,T,128], sinks[B,H], out[B,H,128], H, Hkv, T.
note Grid: (H, B), block 128. Each thread handles one head_dim element d = lane (0..127).
fn inklingAttnMix to void
ikStart 4
parameter 20 32
parameter 21 36
parameter 22 40
note CTA.x = h (R15), CTA.y = b (R18), lane = d (R14).
gqaKvHead 23 15 20 21 24
madreg 24 18 20 15
madreg 25 24 22 Z
readAt 26 4 24 0
note Find max over scores[0..T-1] and sink (R26).
mad 27 26 1 Z
literal 28 0
literal 29 1
mark = get ikPc 0
iadd 30 25 28
readAt 31 0 30 0
fop 37 27 27 31
nextLoop 28 22 mark 29
note Accumulate denominator (starting with exp(sink - max)) and weighted V sum.
number 32 1.4426950408889634f32
fop 31 33 26 27
expReg 33 33 32
number 34 0.0f32
madreg 35 18 21 23
madreg 35 35 22 Z
literal 28 0
mark = get ikPc 0
iadd 30 25 28
readAt 31 0 30 0
fop 31 31 31 27
expReg 31 31 32
fop 30 33 33 31
iadd 36 35 28
mad 36 36 128 14
readAt 37 2 36 0
fmaReg 34 31 37 34
nextLoop 28 22 mark 29
fop 40 33 33 Z
fop 32 34 34 33
mad 38 24 128 14
writeAt 34 6 38 0
end

note n: Attention output gate: out[i] = a[i] * sigmoid(g[i]). Grid: (tiles(N)), block 128.
fn attnGate to void
ikStart 3
parameter 21 24
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
readAt 22 0 20 0
readAt 23 2 20 0
number 24 -1.4426950408889634f32
number 25 1.0f32
sigmoid 23 23 24 25
fop 32 22 22 23
writeAt 22 4 20 0
end

note o: Inkling-2-Mini top-8 router (128 experts, sigmoid, FP32 bias, renorm * 8.0).
note Args: logits[B,128], bias[128], ids[B,8], weights[B,8]. Grid: (B), block 1.
note Registers: R32..R39 top-8 keys, R40..R47 top-8 ids, R48..R55 top-8 raw scores.
fn route8 to void
ikStart 4
mad 20 15 128 Z
mad 21 15 8 Z
for k ulong 8
literal add 32 k 0xff800000
literal add 40 k 0
number add 48 k 0.0f32
end
literal 22 0
literal 23 128
literal 24 1
number 25 -1.4426950408889634f32
number 26 1.0f32
mark = get ikPc 0
iadd 27 20 22
readAt 28 0 27 0
readAt 29 2 22 0
sigmoid 28 28 25 26
fop 30 29 28 29
mad 30 22 1 Z
literal 56 0
for k ulong 8
rk = add 32 k
rix = add 40 k
rraw = add 48 k
inst 34 0 29 rk Z 0x03f04000
put ikGuard 0 1
literal 56 1
inst 28 Z 56 24 Z 0
mad 57 rk 1 Z
mad 58 rix 1 Z
mad 59 rraw 1 Z
put ikGuard 0 1
mad rk 29 1 Z
put ikGuard 0 1
mad rix 30 1 Z
put ikGuard 0 1
mad rraw 28 1 Z
put ikGuard 0 1
mad 29 57 1 Z
put ikGuard 0 1
mad 30 58 1 Z
put ikGuard 0 1
mad 28 59 1 Z
end
nextLoop 22 23 mark 24
number 28 1e-20f32
for k ulong 8
fop 30 28 28 add 48 k
end
fop 40 28 28 Z
number 29 8.0f32
fop 32 29 28 29
for k ulong 8
fop 32 30 add 48 k 29
writeAt add 40 k 4 21 mul k 4
writeAt 30 6 21 mul k 4
end
end

note p: Softcapped SwiGLU for Inkling-2-Mini:
note out = (4*tanh(g/4)) * sigmoid(g) * (25*tanh(u/25)) * route_weight.
note Args: gate[B,I], up[B,I], weight[B], out[B,I], I. Grid: (tiles(I), B), block 128.
fn softcapSwiglu to void
ikStart 4
parameter 21 32
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
madreg 22 18 21 20
readAt 23 0 22 0
readAt 24 2 22 0
readAt 25 4 18 0
number 26 0.25f32
fop 32 27 23 26
tanhReg 27 27 30 31 32
number 26 4.0f32
fop 32 27 27 26
number 30 -1.4426950408889634f32
number 31 1.0f32
sigmoid 28 23 30 31
fop 32 27 27 28
number 26 0.04f32
fop 32 29 24 26
tanhReg 29 29 30 31 32
number 26 25.0f32
fop 32 29 29 26
fop 32 27 27 29
fop 32 27 27 25
writeAt 27 6 22 0
end

note q: MoE 8-expert combine: out[b,d] = sum_{e=0..7} downs[b,e,d].
note Args: downs[B,8,D], out[B,D], D. Grid: (tiles(D), B), block 128.
fn moeCombine8 to void
ikStart 2
parameter 21 16
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
mad 22 18 8 Z
madreg 22 22 21 20
number 23 0.0f32
for e ulong 8
readAt 24 0 22 0
fop 30 23 23 24
if lt e 7
iadd 22 22 21
end
end
madreg 25 18 21 20
writeAt 23 2 25 0
end

note r: Block & Cross-Pass Attention Residual (K <= 16 normalized block states).
note Args: V[B,K,D], queries[Q,D], out[B,Q,D], K, Q, D. Grid: (Q, B), block 1.
note CTA.x = q, CTA.y = b. Stores up to 16 softmax weights in R40..R55.
fn attnRes to void
ikStart 3
parameter 20 24
parameter 21 28
parameter 22 32
note inv_sqrt_D in R23.
fop 38 23 22 Z
fop 41 23 23 Z
madreg 24 15 22 Z
madreg 25 18 20 Z
madreg 25 25 22 Z
number 26 -1e30f32
for k ulong 16
literal 27 k
inst 28 Z 27 20 Z 0
put ikGuard 0 1
inst 46 Z Z Z Z 17
madreg 28 27 22 25
number 29 0.0f32
literal 30 0
literal 31 1
mark = get ikPc 0
iadd 32 24 30
readAt 33 2 32 0
iadd 32 28 30
readAt 34 0 32 0
fmaReg 29 33 34 29
nextLoop 30 22 mark 31
fop 32 add 40 k 29 23
fop 37 26 26 add 40 k
end
number 29 0.0f32
number 30 1.4426950408889634f32
for k ulong 16
literal 27 k
inst 28 Z 27 20 Z 0
put ikGuard 0 1
inst 46 Z Z Z Z 5
fop 31 add 40 k add 40 k 26
expReg add 40 k add 40 k 30
fop 30 29 29 add 40 k
end
fop 40 29 29 Z
for k ulong 16
literal 27 k
inst 28 Z 27 20 Z 0
put ikGuard 0 1
inst 46 Z Z Z Z 2
fop 32 add 40 k add 40 k 29
end
madreg 35 18 21 15
madreg 35 35 22 Z
literal 30 0
literal 31 1
mark = get ikPc 0
number 36 0.0f32
for k ulong 16
literal 27 k
inst 28 Z 27 20 Z 0
put ikGuard 0 1
inst 46 Z Z Z Z 6
madreg 28 27 22 25
iadd 28 28 30
readAt 37 0 28 0
fmaReg 36 add 40 k 37 36
end
iadd 38 35 30
writeAt 36 4 38 0
nextLoop 30 22 mark 31
end

note s: Loop Message Gate: out = (1 - tanh(f_logit)) * h + tanh(m_logit) * msg.
note Args: h[N], msg[N], f_logit[N], m_logit[N], out[N], N. Grid: (tiles(N)), block 128.
fn msgGate to void
ikStart 5
parameter 21 40
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
readAt 22 0 20 0
readAt 23 2 20 0
readAt 24 4 20 0
readAt 25 6 20 0
tanhReg 24 24 30 31 32
tanhReg 25 25 30 31 32
number 26 1.0f32
fop 31 26 26 24
fop 32 26 26 22
fmaReg 26 25 23 26
writeAt 26 8 20 0
end

note t: Softcap: out[i] = cap * tanh(x[i] / cap). Args: x[N], out[N], N, cap_bits.
fn logitSoftcap to void
ikStart 2
parameter 21 16
parameter 22 20
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
readAt 23 0 20 0
fop 40 24 22 Z
fop 32 23 23 24
tanhReg 23 23 30 31 32
fop 32 23 23 22
writeAt 23 2 20 0
end

note u/v: BF16 pack and unpack (exact RNE).
fn bf16Pack to void
ikStart 2
parameter 21 16
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
readAt 22 0 20 0
inst 61 22 Z 22 Z 0
inst 9 16 20 Z 2 2
inst 68 Z 16 22 Z 0
end

fn bf16Unpack to void
ikStart 2
parameter 21 16
mad 20 15 128 14
inst 28 Z 20 21 Z 0
put ikGuard 0 1
inst 45 Z Z Z Z 0
inst 17 22 20 Z Z 1
readAt 23 0 22 0
inst 18 22 20 Z Z 1
mad 22 22 16 Z
inst 17 24 23 Z Z 16
literal 25 1
inst 28 Z 22 25 Z 0
put ikGuard 0 1
mad 23 24 1 Z
inst 18 23 23 Z Z 0xffff
mad 23 23 65536 Z
writeAt 23 2 20 0
end


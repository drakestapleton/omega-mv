fStart 6
fParam 20 48
fParam 21 52
icImm 9 16 14 8 4 cwW1
ic 11 52 16 Z 0 cwLd
fMad 53 14 4 Z
ic 0 Z Z Z 0 cwW0
ic 50 Z 53 52 0 cwSt
ic 0 Z Z Z 0 cwW1
fBar
icImm 9 16 18 6 4 cwW1
ic 11 23 16 Z 0 cwLd
fLit 52 64
fIadd 52 18 52
icImm 9 16 52 6 4 cwW1
ic 11 22 16 Z 0 cwLd
ic 0 Z Z Z 0 cwW0
ic 17 36 14 Z 5 cwAlu4
ic 18 39 14 Z 31 cwAlu4
fMad 12 15 8 36
fLit 59 0xffffffff
fIadd 59 21 59
fMad 52 12 1 Z
ic 28 Z 52 21 0 cwCmp
put ikfGuard 0 1
fMad 52 59 1 Z
fMadReg 53 23 21 52
fMadReg 55 53 20 Z
fMad 56 39 8 Z
fIadd 55 55 56
icImm 9 24 55 2 1 cwAlu4
ic 17 54 20 Z 5 cwAlu4
fMadReg 55 53 54 Z
ic 17 56 39 Z 4 cwAlu4
fMad 56 56 4 Z
fIadd 55 55 56
icImm 9 26 55 4 1 cwAlu4
ic 17 37 39 Z 2 cwAlu4
ic 18 37 37 Z 3 cwAlu4
fMad 37 37 8 Z
fLit 55 24
fLit 56 0xffffffff
ic4 8 37 37 56 55 cwAlu4
fLit 31 1088
fMad 31 39 32 31
for b ulong 8
fNum add 40 b 0.0f32
end
fLit 28 0
fLit 29 256
mK = get ikfPc 0
fLit 30 0
mLoadX = get ikfPc 0
fMad 52 18 8 30
fLit 53 128
fIadd 52 52 53
icImm 9 16 52 6 4 cwW1
ic 11 53 16 Z 0 cwLd
ic 0 Z Z Z 0 cwW0
fMadReg 52 53 20 28
fIadd 52 52 14
fNum 53 0.0f32
fIadd 55 28 14
bX = fBssy
ic 28 Z 55 20 0 cwCmp
skX = fBraFwd 1
icImm 9 16 52 0 4 cwW1
ic 11 53 16 Z 0 cwLd
ic 0 Z Z Z 0 cwW0
fPatch skX 1
fBsync bX
fLit 54 1088
fMad 54 30 1024 54
fMad 54 14 4 54
ic 50 Z 54 53 0 cwSt
ic 0 Z Z Z 0 cwW1
fLit 55 1
fIadd 30 30 55
ic 28 Z 30 22 0 cwCmp
put ikfGuard 0 2
ic 46 Z Z Z sub mLoadX get ikfPc 0 cwAlu4
fBar
fLit 32 0
fLit 33 0
fNum 35 0.0f32
fMad 55 39 8 28
bW = fBssy
ic 28 Z 55 20 0 cwCmp
skW = fBraFwd 1
ic 56 32 24 Z 0 cwLd
ic 11 34 26 Z 0 cwLd
ic 0 Z Z Z 0 cwW0
ic4 52 34 34 37 Z cwAlu4
ic 17 34 34 Z 24 cwAlu4
decodeE8Fast 35 34 55
fPatch skW 1
fBsync bW
bMxfp8Decode8 32 33 35 52
for b ulong 8
fLit 30 b
ic 28 Z 30 22 0 cwCmp
skB = fBraFwd 1
bBf16AccStream b add 40 b
fPatch skB 1
end
fLit 55 1
icImm 9 24 55 24 256 cwAlu1
icImm 9 26 55 26 8 cwAlu1
fIadd 28 28 29
fBar
ic 28 Z 28 20 0 cwCmp
put ikfGuard 0 2
ic 46 Z Z Z sub mK get ikfPc 0 cwAlu4
for b ulong 8
fWarpRedSum add 40 b 52 16
end
fLit 55 1
ic 28 Z 39 55 0 cwCmp
put ikfGuard 0 1
ic 45 Z Z Z 0 cwSafe
ic 28 Z 12 21 0 cwCmp
put ikfGuard 0 1
ic 45 Z Z Z 0 cwSafe
for b ulong 8
fLit 30 b
ic 28 Z 30 22 0 cwCmp
skS = fBraFwd 1
fMad 52 18 8 30
fLit 53 128
fIadd 52 52 53
icImm 9 16 52 6 4 cwW1
ic 11 53 16 Z 0 cwLd
ic 0 Z Z Z 0 cwW0
fMadReg 52 53 21 12

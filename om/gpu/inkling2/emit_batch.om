end

fn ikbKernel kind uchar to bool
if eq kind 65
bf16GemmBatchFast
ret true
end
if eq kind 66
nvfp4GemmDedupFast
ret true
end
if eq kind 67
mxfp8GemmDedupFast
ret true
end
ret false
end

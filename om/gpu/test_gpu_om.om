note SPDX-License-Identifier: Apache-2.0
note om/gpu/test_gpu_om.om: Pure OM-2 self-test + negative controls for bw_qmd, bw_sched, q38_plan.
note Composed with om/gpu/{bw_qmd,bw_sched,q38_plan}.om and compiled by seed/out/omc.

text msg_pass "PASS om/gpu pure-Omega suite (qmd + sched + q38_plan + negative controls)\n"
text msg_fail "FAIL om/gpu pure-Omega suite\n"

fn test_qmd to uint
q = new uint 96 0
if ne bw_qmd0 q 0x100000 0
ret 1
end
if ne get q 4 0x00800002
ret 2
end
if ne get q 12 0x1000
ret 3
end
m = new ulong 16 0
put m 0 0x200000
put m 1 0x300000
put m 2 0x400000
put m 3 0x500000
put m 4 0x600000
put m 8 256
put m 10 48
put m 12 64
put m 13 0
if ne bw_qmd1 m q 0
ret 4
end
if ne get q 36 0x04b44808
ret 5
end
if ne bw_qmd_verify q 0
ret 6
end
put m 13 65536
if ne bw_qmd1 m q 0
ret 7
end
if ne and shr get q 36 11 0x3f 17
ret 8
end
if ne and get q 36 0x7ff 512
ret 9
end
put m 13 81920
if ne bw_qmd1 m q 0
ret 10
end
if ne and shr get q 36 11 0x3f 26
ret 11
end
if ne and shr get q 36 23 0x3f 26
ret 12
end
if ne bw_qmd_verify q 0
ret 13
end
put m 13 98305
if eq bw_qmd1 m q 0
ret 14
end
put q 37 1
if eq bw_qmd_verify q 0
ret 15
end
ret 0
end

fn set_ffma ins edit ulong 8192 idx ulong dst ulong s1 ulong s2 ulong s3 ulong to void
b = mul idx 8
put ins b 33
put ins add b 1 dst
put ins add b 2 s1
put ins add b 3 s2
put ins add b 4 s3
put ins add b 5 0xffffffffffffffff
ctrl = shl ulong 6 9
ctrl = or ctrl shl ulong 7 14
ctrl = or ctrl shl ulong 7 17
put ins add b 6 shl ctrl 32
put ins add b 7 0
end

fn test_sched to uint
ins = new ulong 8192 0
phys = new ulong 256 0
bsz = new ulong 256 1
for i ulong 256
put phys i i
end
set_ffma ins 0 0 10 11 0
set_ffma ins 1 1 10 12 1
set_ffma ins 2 2 10 13 2
set_ffma ins 3 3 10 14 3
set_ffma ins 4 0 15 16 0
put ins 40 45
put ins 41 0xffffffffffffffff
put ins 42 0xffffffffffffffff
put ins 43 0xffffffffffffffff
put ins 44 0xffffffffffffffff
put ins 45 0xffffffffffffffff
put ins 46 shl or or shl ulong 5 9 shl ulong 7 14 shl ulong 7 17 32
if ne bw_sched_stalls ins phys bsz 6 0
ret 20
end
if ne and shr shr get ins 6 32 9 0xf 1
ret 21
end
if ne and shr shr get ins 14 32 9 0xf 1
ret 22
end
if ne and shr shr get ins 22 32 9 0xf 1
ret 23
end
if ne and shr shr get ins 30 32 9 0xf 3
ret 24
end
if ne and shr shr get ins 38 32 9 0xf 6
ret 25
end
note negative control: out-of-range branch delta must be refused
put ins 40 46
put ins 46 100
if eq bw_sched_stalls ins phys bsz 6 0
ret 26
end
ret 0
end

fn test_plan to uint
cfg = new ulong 8 0
plan = new uint 384 0
put cfg 0 8
put cfg 1 0
put cfg 2 1
put cfg 3 1
n = q38_plan_layer cfg plan
if ne n 28
ret 30
end
if ne get plan 13 1
ret 31
end
if ne get plan 17 0
ret 32
end
if ne get plan 21 1
ret 33
end
if ne q38_bf16_xbatch_max 5120 98304 4
ret 34
end
if ne q38_bf16_xbatch_max 5120 32768 1
ret 35
end
put cfg 0 8
put cfg 1 5120
put cfg 2 98304
put cfg 3 1
put cfg 4 1
put cfg 5 0
nf = q38_plan_final cfg plan
if ne nf 51
ret 36
end
if ne get plan 0 101
ret 37
end
if ne get plan 8 103
ret 38
end
put cfg 3 0
put cfg 4 0
nf2 = q38_plan_final cfg plan
if ne nf2 18
ret 39
end
if ne get plan 0 108
ret 40
end
if ne get plan 3 4
ret 41
end
if ne q38_attn256_cache_policy 0 1
ret 42
end
if ne q38_attn256_cache_policy 1 3
ret 43
end
if ne q38_attn256_cache_policy 2 0
ret 44
end
ret 0
end

fn main to int
r = test_qmd
if ne r 0
k = write 1 msg_fail 0 len msg_fail
ret int r
end
r = test_sched
if ne r 0
k = write 1 msg_fail 0 len msg_fail
ret int r
end
r = test_plan
if ne r 0
k = write 1 msg_fail 0 len msg_fail
ret int r
end
k = write 1 msg_pass 0 len msg_pass
ret 0
end

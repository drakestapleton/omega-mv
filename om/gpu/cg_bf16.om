note SPDX-License-Identifier: Apache-2.0
note om/gpu/cg_bf16.om: Pure OM-2 Blackwell IR emitter for BF16 streaming GEMV (lm_head, ROWS, MASK, XBATCH).
note Replaces src/omega_blackwell_codegen_bf16.c.
note Spec wire sp[8]: 0=k, 1=rows, 2=warps, 3=depth, 4=mutant, 5=ystride, 6=xbatch, 7=mask.
om2

const BF_NOREG ulong 0xffffffffffffffff
const BF_CW_YIELD ulong 0x2000
const BF_MAX_SMEM ulong 98304
const BF_MAX_K ulong 8192
const BF_MAX_XB ulong 4

fn bf_cw st ulong wb ulong rb ulong wt ulong to ulong
ret or or or shl st 9 shl wb 14 shl rb 17 shl wt 20
end

fn bf_v meta edit ulong 512 w ulong to ulong
v = get meta 1
if ge v 256
put meta 5 1
ret 0
end
put meta add 64 v w
put meta 1 add v 1
ret v
end

fn bf_uv meta edit ulong 512 w ulong to ulong
u = get meta 2
if ge u 32
put meta 5 1
ret 0
end
put meta add 352 u w
put meta 2 add u 1
ret u
end

fn bf_emit ins edit ulong 8192 meta edit ulong 512 row view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
ctrl = ulong 0
if eq kind 0
ctrl = bf_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
ctrl = bf_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
ctrl = or bf_cw 4 0 1 wt BF_CW_YIELD
put meta 4 3
end
if eq kind 3
ctrl = or bf_cw 4 0 1 and wt 2 BF_CW_YIELD
put meta 4 or wt 3
end
if eq kind 4
ctrl = or bf_cw 4 2 7 wt BF_CW_YIELD
put meta 4 4
end
if eq kind 5
ctrl = or bf_cw 4 7 1 wt BF_CW_YIELD
put meta 4 2
end
if eq kind 6
ctrl = bf_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
ctrl = bf_cw 5 7 7 wt
if eq and shr get row 7 1 1 0
put meta 4 0
end
end
if eq kind 8
ctrl = or bf_cw 1 7 7 wt BF_CW_YIELD
put meta 4 0
end
if eq kind 9
ctrl = or bf_cw 5 7 7 wt BF_CW_YIELD
put meta 4 0
end
b = mul n 8
for k ulong 6
put ins add b k get row k
end
put ins add b 6 or and get row 6 0xffffffff shl ctrl 32
put ins add b 7 get row 7
put meta 0 add n 1
end

fn bf_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 BF_NOREG
put r 2 BF_NOREG
put r 3 BF_NOREG
put r 4 BF_NOREG
put r 5 BF_NOREG
put r 6 0
put r 7 0
end

fn bf_patch ins edit ulong 8192 pos ulong tgt ulong to void
b = add mul pos 8 6
w6 = get ins b
delta = sub tgt pos
put ins b or and w6 0xffffffff00000000 and delta 0xffffffff
end

fn bf_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
put meta add 320 mul nl 2 start
put meta add 321 mul nl 2 sub get meta 0 1
put meta 3 add nl 1
end

fn em_op1 ins edit ulong 8192 meta edit ulong 512 op ulong dst ulong imm ulong kind ulong to void
r = new ulong 8 0
bf_r0 r op
put r 1 dst
put r 6 imm
if eq kind 4
put r 7 1
end
bf_emit ins meta r kind
end

fn em_imadi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong to void
r = new ulong 8 0
bf_r0 r 8
put r 1 d
put r 2 a
put r 4 get meta 10
put r 6 get meta 11
put r 7 shl asub 24
bf_emit ins meta r 0
end

fn em_imadw ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong c ulong to void
r = new ulong 8 0
bf_r0 r 9
put r 1 d
put r 2 a
put r 4 c
put r 6 imm
bf_emit ins meta r 0
end

fn em_bin ins edit ulong 8192 meta edit ulong 512 op ulong d ulong a ulong b ulong to void
r = new ulong 8 0
bf_r0 r op
put r 1 d
put r 2 a
put r 3 b
bf_emit ins meta r 0
end

fn em_ldg ins edit ulong 8192 meta edit ulong 512 op ulong d ulong a ulong imm ulong to void
r = new ulong 8 0
bf_r0 r op
put r 1 d
put r 2 a
put r 5 get meta 384
put r 6 imm
bf_emit ins meta r get meta 12
end

fn em_lds128 ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong first ulong to void
r = new ulong 8 0
bf_r0 r 58
put r 1 d
put r 2 a
put r 6 imm
k = ulong 3
if ne first 0
k = ulong 2
end
bf_emit ins meta r k
end

fn em_ffma ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong bsub ulong to void
r = new ulong 8 0
bf_r0 r 33
put r 1 d
put r 2 a
put r 3 b
put r 4 d
put r 7 shl bsub 32
bf_emit ins meta r 0
end

fn bf_ok_xb sp view ulong 8 xb ulong to ulong
k = get sp 0
rows = get sp 1
warps = get sp 2
ys = get sp 5
if eq ys 0
ret 0
end
if gt mul rows xb 16
ret 0
end
if gt mul mul xb k 4 BF_MAX_SMEM
ret 0
end
if gt mul xb k mul 2048 warps
ret 0
end
if ge mul mul sub xb 1 ys 4 shl ulong 1 31
ret 0
end
ret 1
end

export fn cg_bf16_ok_i sp view ulong 8 to ulong
k = get sp 0
rows = get sp 1
warps = get sp 2
depth = get sp 3
if ne rows 1
if ne rows 2
if ne rows 4
ret 0
end
end
end
if eq warps 0
ret 0
end
if gt warps 32
ret 0
end
if eq k 0
ret 0
end
if gt k BF_MAX_K
ret 0
end
if ne rem k 256 0
ret 0
end
if ne rem k mul 32 warps 0
ret 0
end
if gt k mul 2048 warps
ret 0
end
if eq depth 0
ret 0
end
if gt depth 16
ret 0
end
if ne rem div k 256 depth 0
ret 0
end
if gt mul rows depth 16
ret 0
end
if gt get sp 7 1
ret 0
end
xb = get sp 6
if eq xb 0
xb = ulong 1
end
if gt xb BF_MAX_XB
ret 0
end
if ne get sp 7 0
if ne rows 1
ret 0
end
if ne get sp 5 0
ret 0
end
if gt xb 1
ret 0
end
end
if gt xb 1
if eq bf_ok_xb sp xb 0
ret 0
end
end
if gt get sp 4 4
ret 0
end
if eq get sp 4 4
if eq get sp 7 0
if lt xb 2
ret 0
end
end
end
if gt get sp 5 shl ulong 1 28
ret 0
end
if ge add mul mul sub rows 1 k 2 mul 512 depth shl ulong 1 23
ret 0
end
ret 1
end

fn bf_stage_chunk sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
pxs = new ulong 8 0
xst = new ulong 8 0
r = new ulong 8 0
j0 = get meta 416
nj = get meta 417
step = mul 128 get sp 2
for q ulong nj bound 8
put pxs q bf_v meta 2
put xst q bf_v meta 1
end
for q ulong nj bound 8
off = mul add j0 q step
em_imadw ins meta get pxs q get meta 394 off get meta 413
end
for q ulong nj bound 8
put meta 12 3
if eq q 0
put meta 12 2
end
em_ldg ins meta 11 get xst q get pxs q 0
end
for q ulong nj bound 8
put meta 10 get meta 414
put meta 11 mul add j0 q step
em_imadi ins meta get meta 415 get meta 394 0
bf_r0 r 50
put r 2 get meta 415
put r 3 get xst q
bf_emit ins meta r 5
end
end

fn bf_stage_x sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
xb = get sp 6
if eq xb 0
xb = ulong 1
end
rounds = div mul xb get sp 0 mul 32 get sp 2
put meta 413 bf_v meta 2
put meta 414 bf_v meta 1
put meta 415 bf_v meta 1
em_imadw ins meta get meta 413 get meta 390 4 get meta 386
put meta 10 BF_NOREG
put meta 11 4
em_imadi ins meta get meta 414 get meta 390 0
j0 = ulong 0
while lt j0 rounds bound 64
nj = sub rounds j0
if gt nj 8
nj = ulong 8
end
put meta 416 j0
put meta 417 nj
bf_stage_chunk sp ins meta
j0 = add j0 nj
end
bf_r0 r 48
bf_emit ins meta r 6
end

fn bf_prologue sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
put meta 384 bf_uv meta 2
put meta 385 bf_v meta 2
put meta 386 bf_v meta 2
put meta 387 bf_v meta 2
put meta 388 bf_v meta 1
put meta 389 bf_v meta 1
put meta 390 bf_v meta 1
put meta 391 bf_v meta 1
put meta 392 bf_v meta 1
put meta 393 bf_v meta 1
put meta 394 bf_v meta 1
put meta 395 bf_v meta 1
put meta 396 bf_v meta 1
put meta 397 bf_v meta 1
em_op1 ins meta 7 get meta 384 0x358 4
em_op1 ins meta 5 get meta 385 0x380 2
em_op1 ins meta 5 get meta 386 0x388 2
em_op1 ins meta 5 get meta 387 0x390 2
em_op1 ins meta 4 get meta 388 0x398 2
em_op1 ins meta 4 get meta 389 0x39c 2
em_op1 ins meta 3 get meta 390 0x21 2
em_op1 ins meta 3 get meta 391 0x25 2
xb = get sp 6
if eq xb 0
xb = ulong 1
end
if ne get sp 5 0
if eq xb 1
cy = bf_v meta 1
em_op1 ins meta 3 cy 0x26 2
em_imadw ins meta get meta 386 cy mul get sp 0 4 get meta 386
em_imadw ins meta get meta 387 cy mul get sp 5 4 get meta 387
end
end
em_op1 ins meta 2 get meta 394 1 0
r = new ulong 8 0
bf_r0 r 17
put r 1 get meta 392
put r 2 get meta 390
put r 6 5
bf_emit ins meta r 0
bf_r0 r 18
put r 1 get meta 393
put r 2 get meta 390
put r 6 31
bf_emit ins meta r 0
put meta 10 BF_NOREG
put meta 11 16
em_imadi ins meta get meta 395 get meta 393 0
put meta 10 get meta 392
put meta 11 get sp 2
em_imadi ins meta get meta 396 get meta 391 0
put meta 10 BF_NOREG
put meta 11 32
em_imadi ins meta get meta 397 get meta 393 0
bf_stage_x sp ins meta
end

fn bf_alloc_body sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
put meta 398 bf_v meta 2
put meta 399 bf_v meta 2
put meta 400 bf_v meta 1
put meta 401 bf_v meta 1
put meta 402 bf_v meta 2
put meta 403 bf_v meta 2
put meta 404 bf_v meta 1
put meta 405 bf_v meta 1
rows = get sp 1
depth = get sp 3
xb = get sp 6
if eq xb 0
xb = ulong 1
end
for ri ulong rows bound 4
for m ulong xb bound 4
put meta add 416 add mul ri 4 m bf_v meta 1
end
for s ulong depth bound 16
put meta add 432 add mul ri 16 s bf_v meta 4
end
end
for m ulong xb bound 4
put meta add 496 mul m 2 bf_v meta 4
put meta add 497 mul m 2 bf_v meta 4
end
if ne get sp 7 0
ptau = bf_v meta 2
put meta 406 bf_v meta 2
put meta 407 bf_v meta 1
put meta 408 bf_v meta 1
put meta 409 bf_v meta 1
put meta 410 bf_v meta 2
put meta 411 bf_v meta 1
put meta 412 bf_v meta 1
em_op1 ins meta 5 get meta 406 0x3a0 2
em_op1 ins meta 5 ptau 0x3a8 2
put meta 12 2
em_ldg ins meta 11 get meta 407 ptau 0
em_op1 ins meta 1 get meta 408 0 0
em_bin ins meta 30 get meta 407 get meta 407 get meta 408
em_op1 ins meta 2 get meta 409 0xff800000 0
end
end

fn bf_kloop_ldg_s sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
for ri ulong get sp 1 bound 4
put meta 12 3
if ne get meta 505 0
put meta 12 2
put meta 505 0
end
off = mul ri get sp 0
off = add mul off 2 mul get meta 504 512
em_ldg ins meta 57 get meta add 432 add mul ri 16 get meta 504 get meta 398 off
end
end

fn bf_kloop_ldg sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
put meta 505 1
for s ulong get sp 3 bound 16
put meta 504 s
bf_kloop_ldg_s sp ins meta
end
end

fn bf_kloop_lds sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
xb = get sp 6
if eq xb 0
xb = ulong 1
end
put meta 508 mul get meta 504 1024
if eq get sp 4 2
put meta 508 0
end
for m ulong xb bound 4
off = mul mul m get sp 0 4
if eq get sp 4 4
off = ulong 0
end
off = add off get meta 508
if eq m 0
em_lds128 ins meta get meta add 496 mul m 2 get meta 400 off 1
else
em_lds128 ins meta get meta add 496 mul m 2 get meta 400 off 0
end
off = add off 16
em_lds128 ins meta get meta add 497 mul m 2 get meta 400 off 0
end
end

fn bf_kloop_ffma sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
xb = get sp 6
if eq xb 0
xb = ulong 1
end
for m ulong xb bound 4
acc = get meta add 416 add mul get meta 505 4 m
xv = get meta add 496 add mul m 2 shr get meta 507 1
em_ffma ins meta acc get meta 405 xv get meta 508
end
end

fn bf_kloop_word sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
sub0 = mul and get meta 507 1 2
sub1 = add sub0 1
if eq get sp 4 1
sub0 = add mul and get meta 507 1 2 1
sub1 = mul and get meta 507 1 2
end
put meta 10 BF_NOREG
put meta 11 65536
em_imadi ins meta get meta 405 get meta 506 get meta 507
put meta 508 sub0
bf_kloop_ffma sp ins meta
bf_r0 r 18
put r 1 get meta 405
put r 2 get meta 506
put r 6 0xffff0000
put r 7 shl get meta 507 24
bf_emit ins meta r 0
put meta 508 sub1
bf_kloop_ffma sp ins meta
end

fn bf_kloop_mac sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
s = get meta 504
bf_kloop_lds sp ins meta
words = ulong 4
if eq get sp 4 3
words = ulong 3
end
for ri ulong get sp 1 bound 4
put meta 506 get meta add 432 add mul ri 16 s
put meta 505 ri
for wd ulong words bound 4
put meta 507 wd
bf_kloop_word sp ins meta
end
end
end

fn bf_kloop sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
lk = get meta 0
bf_kloop_ldg sp ins meta
for s ulong get sp 3 bound 16
put meta 504 s
bf_kloop_mac sp ins meta
end
em_imadw ins meta get meta 398 get meta 394 mul get sp 3 512 get meta 398
put meta 10 get meta 400
put meta 11 mul get sp 3 1024
if eq get sp 4 2
put meta 11 0
end
em_imadi ins meta get meta 400 get meta 394 0
put meta 10 get meta 401
put meta 11 0xffffffff
em_imadi ins meta get meta 401 get meta 394 0
bf_r0 r 28
put r 2 get meta 401
put r 3 get meta 394
bf_emit ins meta r 1
bf_r0 r 46
put r 6 sub lk get meta 0
put r 7 2
bf_emit ins meta r 7
bf_loop_end meta lk
end

fn bf_store_row sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 ri ulong to void
r = new ulong 8 0
xb = get sp 6
if eq xb 0
xb = ulong 1
end
for m ulong xb bound 4
off = add mul ri 4 mul mul m get sp 5 4
em_imadw ins meta get meta 403 get meta 394 off get meta 402
bf_r0 r 12
put r 2 get meta 403
put r 3 get meta add 416 add mul ri 4 m
put r 5 get meta 384
bf_emit ins meta r 5
end
end

fn bf_store_rows sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
for ri ulong get sp 1 bound 4
bf_store_row sp ins meta ri
end
end

fn bf_reduce_one ins edit ulong 8192 meta edit ulong 512 ac ulong to void
r = new ulong 8 0
off = ulong 16
while ge off 1 bound 5
bf_r0 r 42
put r 1 get meta 404
put r 2 ac
put r 6 off
bf_emit ins meta r 2
em_bin ins meta 30 ac ac get meta 404
off = shr off 1
end
end

fn bf_reduce_store sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
xb = get sp 6
if eq xb 0
xb = ulong 1
end
for ri ulong get sp 1 bound 4
for m ulong xb bound 4
bf_reduce_one ins meta get meta add 416 add mul ri 4 m
end
end
em_imadw ins meta get meta 402 get meta 396 mul get sp 1 4 get meta 387
bf_r0 r 28
put r 2 get meta 393
put r 3 get meta 394
bf_emit ins meta r 1
put meta 504 get meta 0
bf_r0 r 54
put r 6 2
bf_emit ins meta r 8
put meta 505 get meta 0
bf_r0 r 46
put r 6 1
put r 7 2
bf_emit ins meta r 7
bf_store_rows sp ins meta
at_bsync = get meta 0
bf_r0 r 55
bf_emit ins meta r 9
bf_patch ins get meta 505 at_bsync
bf_patch ins get meta 504 add at_bsync 1
end

fn bf_zero_acc sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
xb = get sp 6
if eq xb 0
xb = ulong 1
end
for ri ulong get sp 1 bound 4
for m ulong xb bound 4
em_op1 ins meta 1 get meta add 416 add mul ri 4 m 0 0
end
end
end

fn bf_rowgroup sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
lrg = get meta 0
bf_r0 r 28
put r 2 get meta 396
put r 3 get meta 388
bf_emit ins meta r 1
bra_end = get meta 0
bf_r0 r 46
put r 6 1
put r 7 2
bf_emit ins meta r 7
bra_skip_row = BF_NOREG
if ne get sp 7 0
em_imadw ins meta get meta 410 get meta 396 4 get meta 406
put meta 12 2
em_ldg ins meta 11 get meta 411 get meta 410 0
em_bin ins meta 30 get meta 411 get meta 411 get meta 408
em_bin ins meta 37 get meta 412 get meta 411 get meta 407
em_bin ins meta 29 get meta 412 get meta 412 get meta 411
bf_r0 r 28
put r 2 get meta 412
put r 3 get meta 394
bf_emit ins meta r 1
bra_skip_row = get meta 0
bf_r0 r 46
put r 6 1
put r 7 2
if eq get sp 4 4
put r 7 6
end
bf_emit ins meta r 7
end
em_imadw ins meta get meta 399 get meta 396 mul mul get sp 1 get sp 0 2 get meta 385
em_imadw ins meta get meta 398 get meta 395 1 get meta 399
put meta 10 BF_NOREG
put meta 11 1
em_imadi ins meta get meta 400 get meta 397 0
bf_zero_acc sp ins meta
em_op1 ins meta 2 get meta 401 div div get sp 0 256 get sp 3 0
bf_kloop sp ins meta
bf_reduce_store sp ins meta
if ne get sp 7 0
bra_next = get meta 0
bf_r0 r 46
put r 6 1
bf_emit ins meta r 7
bf_patch ins bra_skip_row get meta 0
em_imadw ins meta get meta 402 get meta 396 4 get meta 387
bf_r0 r 12
put r 2 get meta 402
put r 3 get meta 409
put r 5 get meta 384
bf_emit ins meta r 5
bf_patch ins bra_next get meta 0
end
put meta 10 get meta 396
put meta 11 1
em_imadi ins meta get meta 396 get meta 389 0
bf_r0 r 46
put r 6 sub lrg get meta 0
bf_emit ins meta r 7
bf_loop_end meta lrg
bf_patch ins bra_end get meta 0
bf_r0 r 45
bf_emit ins meta r 7
end

export fn cg_bf16_ok sp view ulong 8 to ulong
ret cg_bf16_ok_i sp
end

export fn cg_bf16_emit sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to ulong
if eq cg_bf16_ok_i sp 0
ret 1
end
for i ulong 512
put meta i 0
end
bf_prologue sp ins meta
bf_alloc_body sp ins meta
bf_rowgroup sp ins meta
n = get meta 0
if ge n 1024
ret 1
end
b = mul n 8
put ins b 46
put ins add b 1 BF_NOREG
put ins add b 2 BF_NOREG
put ins add b 3 BF_NOREG
put ins add b 4 BF_NOREG
put ins add b 5 BF_NOREG
put ins add b 6 shl ulong 0x000fc000 32
put ins add b 7 0
put meta 0 add n 1
if ne get meta 5 0
ret 1
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note om/gpu/bw_regalloc.om: Blackwell linear-scan GPR/UGPR register allocator in pure OM-2.
note Replaces the register allocation logic of omega_bw_regalloc_solve in src/omega_blackwell_codegen.c.
note
note ABI:
note   cfg[0] = num_vregs (0..256), cfg[1] = num_uvregs (0..32), cfg[2] = gpr_limit (0 -> 128, else <= 246)
note   vinfo[v*3 + 0] = first_def (< 0 if unused), +1 = last_use, +2 = bsize (1, 2, or 4)
note   uinfo[uv] = 2 if is_pair else 1
note   res[0..255] = vreg_to_phys, res[256..287] = uvreg_to_phys, res[288] = peak_gpr_usage, res[289] = peak_ugpr_usage
note   returns 0 on success, 1 on invalid input or register exhaustion.
om2

const BW_MAX_VREGS ulong 256
const BW_MAX_UVREGS ulong 32
const BW_GPR_START ulong 2
const BW_GPR_DEF ulong 128
const BW_GPR_HW_LIM ulong 246
const BW_UGPR_START ulong 4
const BW_UGPR_MAX ulong 32

fn ra_sort cnt ulong vinfo view long 768 order edit ulong 256 to void
if le cnt 1
  ret
end
lim = sub cnt 1
for i ulong lim bound 256
  j = add i 1
  while lt j cnt bound 256
    vi = get order i
    vj = get order j
    fi = get vinfo mul vi 3
    fj = get vinfo mul vj 3
    if gt fi fj
      put order i vj
      put order j vi
    end
    j = add j 1
  end
end
end

fn ra_clear_busy fu ulong bsu ulong gpr_lim ulong st edit ulong 512 to void
for k ulong bsu bound 4
  rk = add fu k
  if lt rk gpr_lim
    put st add 256 rk 0
  end
end
end

fn ra_expire v_fdef long vinfo view long 768 res view long 290 st edit ulong 512 to void
nv = get st 502
gpr_lim = get st 503
for p ulong nv bound 256
  if eq get st p 1
    p_luse = get vinfo add mul p 3 1
    if lt p_luse v_fdef
      freed = get res p
      if ge freed 0
        fu = ulong freed
        if lt fu gpr_lim
          bs = get vinfo add mul p 3 2
          if gt bs 0
            bsu = ulong bs
            if gt bsu 4
              bsu = ulong 4
            end
            ra_clear_busy fu bsu gpr_lim st
          end
        end
      end
      put st p 0
    end
  end
end
end

fn ra_find4 gpr_lim ulong st edit ulong 512 to long
p = ulong 4
while le add p 4 gpr_lim bound 64
  if eq get st add 256 p 0
    if eq get st add 257 p 0
      if eq get st add 258 p 0
        if eq get st add 259 p 0
          put st add 256 p 1
          put st add 257 p 1
          put st add 258 p 1
          put st add 259 p 1
          ret long p
        end
      end
    end
  end
  p = add p 4
end
ret long -1
end

fn ra_find2 gpr_lim ulong st edit ulong 512 to long
p = ulong 2
while le add p 2 gpr_lim bound 128
  if eq get st add 256 p 0
    if eq get st add 257 p 0
      put st add 256 p 1
      put st add 257 p 1
      ret long p
    end
  end
  p = add p 2
end
ret long -1
end

fn ra_find1 gpr_lim ulong st edit ulong 512 to long
p = ulong 2
while lt p gpr_lim bound 256
  if eq get st add 256 p 0
    put st add 256 p 1
    ret long p
  end
  p = add p 1
end
ret long -1
end

fn ra_alloc_one bsize long gpr_lim ulong st edit ulong 512 to long
if eq bsize 4
  ret ra_find4 gpr_lim st
end
if eq bsize 2
  ret ra_find2 gpr_lim st
end
ret ra_find1 gpr_lim st
end

fn ra_scan cnt ulong vinfo view long 768 order view ulong 256 st edit ulong 512 res edit long 290 to ulong
gpr_lim = get st 503
max_phys = long BW_GPR_START
for idx ulong cnt bound 256
  v = get order idx
  v_fdef = get vinfo mul v 3
  ra_expire v_fdef vinfo res st
  bs = get vinfo add mul v 3 2
  assigned = ra_alloc_one bs gpr_lim st
  if lt assigned 0
    ret 1
  end
  put st v 1
  put res v assigned
  top = sub add assigned bs 1
  if gt top max_phys
    max_phys = top
  end
end
put res 288 add max_phys 1
ret 0
end

fn ra_collect nv ulong vinfo view long 768 order edit ulong 256 res edit long 290 to ulong
cnt = ulong 0
for v ulong nv bound 256
  fdef = get vinfo mul v 3
  if ge fdef 0
    put order cnt v
    cnt = add cnt 1
  else
    put res v long BW_GPR_START
  end
end
ret cnt
end

fn ra_alloc_ugprs nu ulong uinfo view ulong 32 res edit long 290 to ulong
cur_u = BW_UGPR_START
for uv ulong nu bound 32
  uw = get uinfo uv
  if eq uw 2
    if ne and cur_u 1 0
      cur_u = add cur_u 1
    end
    if ge add cur_u 1 BW_UGPR_MAX
      ret 1
    end
    put res add 256 uv long cur_u
    cur_u = add cur_u 2
  else
    if ge cur_u BW_UGPR_MAX
      ret 1
    end
    put res add 256 uv long cur_u
    cur_u = add cur_u 1
  end
end
put res 289 long cur_u
ret 0
end

export fn bw_regalloc_solve cfg view ulong 4 vinfo view long 768 uinfo view ulong 32 res edit long 290 to ulong
st = new ulong 512 0
order = new ulong 256 0
nv = get cfg 0
nu = get cfg 1
gpr_lim = get cfg 2
if eq gpr_lim 0
  gpr_lim = BW_GPR_DEF
end
if gt nv BW_MAX_VREGS
  ret 1
end
if gt nu BW_MAX_UVREGS
  ret 1
end
if gt gpr_lim BW_GPR_HW_LIM
  ret 1
end
put st 502 nv
put st 503 gpr_lim
cnt = ra_collect nv vinfo order res
ra_sort cnt vinfo order
rc = ra_scan cnt vinfo order st res
if ne rc 0
  ret 1
end
ret ra_alloc_ugprs nu uinfo res
end

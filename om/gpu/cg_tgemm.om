bqv = get meta add 426 bidx
boff = mul add mul 4 s j nv2
tg_ldw64_pf ins meta bqv pb boff
end
end

fn tg_issue ins edit ulong 8192 meta edit ulong 512 seti ulong sb ulong chunk ulong to void
put meta 33 sb
coff = mul chunk mul get meta 20 2
for jj ulong get meta 24 bound 16
stgr = get meta add 442 jj
off = add mul jj get meta 27 coff
tg_ldw64_pf ins meta stgr get meta 405 off
end
for s ulong get meta 22 bound 8
tg_issue_b ins meta seti s
end
end

fn tg_stage ins edit ulong 8192 meta edit ulong 512 bufoff ulong to void
nj = get meta 24
saj = get meta 28
one = get meta 395
tmp = get meta 400
sa = get meta 406
for jj ulong nj bound 16
stgr = get meta add 442 jj
o0 = add bufoff mul jj saj
put meta 30 sa
put meta 31 o0
tg_imadi ins meta tmp one 0
tg_sts32_sub ins meta tmp stgr 0
put meta 30 sa
put meta 31 add o0 8
tg_imadi ins meta tmp one 0
tg_sts32_sub ins meta tmp stgr 1
end
tg_bar_sync ins meta
end

fn tg_bfrag ins edit ulong 8192 meta edit ulong 512 seti ulong s ulong to void
ws0 = get meta 452
ws1 = get meta 453
tw = get meta 456
for h ulong 2
base = add add mul seti 8 mul s 4 mul 2 h
tg_lop3_sel ins meta ws0 get meta add 426 base get meta 404
tg_lop3_sel ins meta ws1 get meta add 426 add base 1 get meta 404
tg_andi ins meta tw ws0 0xffff
put meta 30 tw
put meta 31 0x10000
tg_imadi_d ins meta get meta 454 h ws1
tg_andi ins meta tw ws1 0xffff0000
put meta 31 16
tg_shr_d ins meta get meta 455 h ws0
tg_iadd_d ins meta get meta 455 h tw
end
end

fn tg_compute_tile ins edit ulong 8192 meta edit ulong 512 bufoff ulong s ulong i0 ulong to void
nb = sub get meta 18 i0
if gt nb get meta 21
nb = get meta 21
end
ns = get meta 22
for q ulong nb bound 4
ii = add i0 q
if eq get meta 29 3
ii = xor ii 1
end
if eq q 0
put meta 32 2
else
put meta 32 3
end
soff = add bufoff mul add mul ii ns s 512
tg_lds128 ins meta get meta add 450 q get meta 403 soff
end
for q ulong nb bound 4
aqv = get meta add 450 q
x = mul add i0 q get meta 19
tg_hmma ins meta get meta add 410 x aqv get meta 454
tg_hmma ins meta get meta add 410 add x 1 aqv get meta 455
end
end

fn tg_compute ins edit ulong 8192 meta edit ulong 512 bufoff ulong seti ulong last ulong to void
ns = get meta 22
for s ulong ns bound 8
if and eq get meta 29 1 and ne last 0 eq s sub ns 1
break
end
tg_bfrag ins meta seti s
i0 = ulong 0
while lt i0 get meta 18 bound 16
tg_compute_tile ins meta bufoff s i0
i0 = add i0 get meta 21
end
end
end


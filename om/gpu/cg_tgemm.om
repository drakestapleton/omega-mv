fn tg_spec_basic sp view ulong 10 to ulong
k = get sp 0
if or lt k 128 or gt k 65536 ne rem k 128 0
ret 0
end
rt = get sp 2
if and ne rt 2 and ne rt 4 ne rt 8
ret 0
end
if ne get sp 3 2
ret 0
end
w = get sp 4
if and ne w 8 ne w 16
ret 0
end
if ne get sp 5 32
ret 0
end
if and ne get sp 6 1 ne get sp 6 2
ret 0
end
if or ne get sp 7 0 ne get sp 8 0
ret 0
end
if gt get sp 9 5
ret 0
end
ret 1
end

fn tg_spec_ok sp view ulong 10 to ulong
if eq tg_spec_basic sp 0
ret 0
end
span = mul mul get sp 4 8 get sp 3
n = get sp 1
if or eq n 0 or ne rem n span 0 ge n 131072
ret 0
end
t = mul 32 get sp 4
ppr = div get sp 5 4
num = mul mul 16 get sp 2 ppr
if ne rem num t 0
ret 0
end
rj = div t ppr
if ne rem rj 16 0
ret 0
end
off1 = mul mul sub div num t 1 rj mul get sp 0 2
off2 = mul sub div 128 get sp 5 1 mul get sp 5 2
if ge add off1 off2 8388608
ret 0
end
smem = mul mul mul 32 get sp 2 get sp 5 2
if gt smem 16384
ret 0
end
if gt mul 32 span smem
ret 0
end
if ne rem mul 8 span t 0
ret 0
end
ret 1
end

fn tg_issue_b ins edit ulong 8192 meta edit ulong 512 seti ulong s ulong to void

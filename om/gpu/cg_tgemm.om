fn tg_epilogue_pass ins edit ulong 8192 meta edit ulong 512 i ulong h ulong to void
ct = get meta 19
nj2 = get meta 35
nv4 = mul get meta 17 4
tg_bar_sync ins meta
for w ulong 4
av = get meta add 410 add mul i ct and w 1
subr = add mul 2 h shr w 1
tg_sts32_sub ins meta get meta add 473 w av subr
end
tg_bar_sync ins meta
for j ulong nj2 bound 8
first = ulong 0
if eq j 0
first = ulong 1
end
tg_lds32 ins meta get meta add 481 j get meta add 477 j first
end
put meta 30 get meta 471
tg_imadw ins meta get meta 472 get meta 470 mul add mul 16 i mul 8 h nv4
rj2 = get meta 34
for j ulong nj2 bound 8
tg_stg ins meta get meta 472 mul mul j rj2 nv4 get meta add 481 j
end
end

fn tg_epilogue_stores ins edit ulong 8192 meta edit ulong 512 to void
if eq get meta 29 5
ret
end
for i ulong get meta 18 bound 16
tg_epilogue_pass ins meta i 0
tg_epilogue_pass ins meta i 1
end
end

fn tg_init_meta sp view ulong 10 meta edit ulong 512 to void
put meta 16 get sp 0
put meta 17 get sp 1
put meta 18 get sp 2
put meta 19 get sp 3
put meta 20 get sp 5
put meta 21 get sp 6
put meta 29 get sp 9
warps = get sp 4
t = mul 32 warps
bm = mul 16 get sp 2
span = mul mul warps 8 get sp 3
kc = get sp 5
ppr = div kc 4
ns = div kc 16
rj = div t ppr
put meta 14 t
put meta 15 span
put meta 22 ns
put meta 23 ppr
put meta 24 div mul bm ppr t
put meta 25 div 128 kc
put meta 26 mul mul bm kc 2
put meta 27 mul mul rj get sp 0 2
put meta 28 mul mul div rj 16 ns 512
put meta 34 div t span
put meta 35 div mul 8 span t
end

export fn cg_tgemm_spec_ok sp view ulong 10 to ulong
ret tg_spec_ok sp
end

export fn cg_tgemm_emit sp view ulong 10 ins edit ulong 8192 meta edit ulong 512 to ulong
if eq tg_spec_ok sp 0
put meta 5 1
ret 1
end
tg_init_meta sp meta
tg_prologue ins meta
if ne get meta 5 0
ret 1
end
tg_prologue_ptrs ins meta
tg_staging_setup ins meta
if ne get meta 5 0
ret 1
end
tg_alloc_loop_regs meta
if ne get meta 5 0
ret 1
end
tg_kloop ins meta
if ne get meta 5 0
ret 1
end
tg_nop ins meta 15
tg_nop ins meta 14
tg_epilogue_setup ins meta
if ne get meta 5 0
ret 1
end
tg_epilogue_addrs ins meta
tg_epilogue_stores ins meta
tg_tail ins meta
if ne get meta 5 0
ret 1
end
if gt get meta 0 1000
put meta 5 1
ret 1
end
ret 0
end

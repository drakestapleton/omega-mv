note om/gpu/cg_gpu_attn.om: Pure OM-2 Blackwell IR emitter for paged GQA flash-decode attention.
note Replaces gen_attention and its Em helpers in src/omega_gpu_attention_api.c.
om2

const AT_NOREG ulong 0xffffffffffffffff
const AT_CW_YIELD ulong 0x2000
const AT_F32_NINF ulong 0xff800000
const AT_F32_ONE ulong 0x3f800000

const AT_OP_NOP ulong 0
const AT_OP_MOV_RZ ulong 1
const AT_OP_MOV_IMM ulong 2
const AT_OP_S2R ulong 3
const AT_OP_LDC ulong 4
const AT_OP_LDC64 ulong 5
const AT_OP_LDCU64 ulong 7
const AT_OP_IMAD ulong 8
const AT_OP_IMAD_WIDE ulong 9
const AT_OP_LDG_E ulong 11
const AT_OP_STG_E ulong 12
const AT_OP_IADD3 ulong 14
const AT_OP_SHF_R ulong 17
const AT_OP_LOP3_AND ulong 18
const AT_OP_LDG_U16 ulong 19
const AT_OP_ISETP_GE_U32 ulong 28
const AT_OP_LOP3_XOR ulong 29
const AT_OP_FADD ulong 30
const AT_OP_FSUB ulong 31
const AT_OP_FMUL ulong 32
const AT_OP_FFMA ulong 33
const AT_OP_FMNMX_MAX ulong 37
const AT_OP_MUFU_RCP ulong 40
const AT_OP_SHFL_DOWN ulong 42
const AT_OP_EXIT ulong 45
const AT_OP_BRA ulong 46
const AT_OP_MUFU_EX2 ulong 47
const AT_OP_BAR_SYNC ulong 48
const AT_OP_LDS32 ulong 49
const AT_OP_STS32 ulong 50
const AT_OP_BSSY ulong 54
const AT_OP_BSYNC ulong 55
const AT_OP_LDG_128 ulong 57
const AT_OP_LDS128 ulong 58

const AT_SR_TID_X ulong 0x21
const AT_SR_CTAID_X ulong 0x25
const AT_SR_CTAID_Y ulong 0x26

fn at_cw st ulong wb ulong rb ulong wt ulong to ulong
ret or or or shl st 9 shl wb 14 shl rb 17 shl wt 20
end

fn at_v meta edit ulong 512 w ulong to ulong
v = get meta 1
if ge v 256
  put meta 5 1
  ret 0
end
put meta add 64 v w
put meta 1 add v 1
ret v
end

fn at_uv meta edit ulong 512 w ulong to ulong
u = get meta 2
if ge u 32
  put meta 5 1
  ret 0
end
put meta add 352 u w
put meta 2 add u 1
ret u
end

fn at_row0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 AT_NOREG
put r 2 AT_NOREG
put r 3 AT_NOREG
put r 4 AT_NOREG
put r 5 AT_NOREG
put r 6 0
put r 7 0
end

fn at_push ins edit ulong 8192 meta edit ulong 512 r view ulong 8 ctrl ulong to void
n = get meta 0
if ge n 1024
  put meta 5 1
  ret
end
b = mul n 8
for k ulong 6
  put ins add b k get r k
end
put ins add b 6 or and get r 6 0xffffffff shl ctrl 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn at_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
wt = get meta 4
put meta 6 0
for k ulong 8
  put meta add 7 k 0
end
ctrl = ulong 0
if eq kind 0
  ctrl = at_cw 6 7 7 wt
  put meta 4 0
end
if eq kind 1
  ctrl = at_cw 13 7 7 wt
  put meta 4 0
end
if eq kind 2
  ctrl = or at_cw 4 0 7 wt AT_CW_YIELD
  put meta 4 1
end
if eq kind 3
  ctrl = or at_cw 4 2 7 wt AT_CW_YIELD
  put meta 4 4
end
if eq kind 4
  ctrl = or at_cw 4 7 1 wt AT_CW_YIELD
  put meta 4 2
end
if eq kind 5
  ctrl = at_cw 6 7 7 wt
  put meta 4 0
end
if eq kind 6
  ctrl = at_cw 5 7 7 wt
  if eq and shr get r 7 1 1 0
    put meta 4 0
  end
end
if eq kind 7
  ctrl = at_cw 5 7 7 wt
  if eq and shr get r 7 1 1 0
    put meta 4 0
  end
end
if eq kind 8
  ctrl = or at_cw 1 7 7 wt AT_CW_YIELD
  put meta 4 0
end
if eq kind 9
  ctrl = or at_cw 5 7 7 wt AT_CW_YIELD
  put meta 4 0
end
at_push ins meta r ctrl
end

fn at_emit_batched ins edit ulong 8192 meta edit ulong 512 r view ulong 8 sb ulong to void
if ge sb 8
  put meta 5 1
  ret
end
bn = get meta add 7 sb
if ge bn 4
  put meta 5 1
  ret
end
wt = and get meta 4 xor get meta 6 AT_NOREG
ctrl = or at_cw 4 sb 1 wt AT_CW_YIELD
bit = or shl ulong 1 sb 2
put meta 6 or get meta 6 bit
put meta add 7 sb add bn 1
put meta 4 or get meta 4 bit
at_push ins meta r ctrl
end

fn at_emit_fib ins edit ulong 8192 meta edit ulong 512 r view ulong 8 to void
wt = and get meta 4 xor get meta 6 AT_NOREG
if ne get meta 6 0
  wt = or wt 2
end
at_push ins meta r at_cw 6 7 7 wt
end

fn at_patch_imm ins edit ulong 8192 meta edit ulong 512 pos ulong target ulong to void
if ge pos 1024
  put meta 5 1
  ret
end
if ne get meta 5 0
  ret
end
idx = add mul pos 8 6
old = get ins idx
delta = and sub target pos 0xffffffff
put ins idx or and old 0xffffffff00000000 delta
end

fn at_loop_begin meta edit ulong 512 to void
d = get meta 15
if ge d 8
  put meta 5 1
  ret
end
put meta add 16 d get meta 0
put meta 15 add d 1
end

fn at_loop_end meta edit ulong 512 to void
d = get meta 15
if eq d 0
  put meta 5 1
  ret
end
d = sub d 1
put meta 15 d
nl = get meta 3
if ge nl 16
  put meta 5 1
  ret
end
put meta add 320 mul nl 2 get meta add 16 d
put meta add 321 mul nl 2 sub get meta 0 1
put meta 3 add nl 1
end

fn at_ldcu64 ins edit ulong 8192 meta edit ulong 512 ud ulong off ulong to void
r = new ulong 8 0
at_row0 r AT_OP_LDCU64
put r 1 ud
put r 6 off
put r 7 1
at_emit ins meta r 3
end

fn at_ldc ins edit ulong 8192 meta edit ulong 512 op ulong dst ulong off ulong to void
r = new ulong 8 0
at_row0 r op
put r 1 dst
put r 6 off
at_emit ins meta r 2
end

fn at_movi ins edit ulong 8192 meta edit ulong 512 dst ulong imm ulong to void
r = new ulong 8 0
at_row0 r AT_OP_MOV_IMM
put r 1 dst
put r 6 and imm 0xffffffff
at_emit ins meta r 0
end

fn at_movrz ins edit ulong 8192 meta edit ulong 512 dst ulong to void
r = new ulong 8 0
at_row0 r AT_OP_MOV_RZ
put r 1 dst
at_emit ins meta r 0
end

fn at_imadi ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong imm ulong to void
r = new ulong 8 0
at_row0 r AT_OP_IMAD
put r 1 dst
put r 2 a
put r 4 get meta 24
put r 6 and imm 0xffffffff
put r 7 shl get meta 25 24
at_emit ins meta r 0
end

fn at_imadr ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong b ulong to void
r = new ulong 8 0
at_row0 r AT_OP_IMAD
put r 1 dst
put r 2 a
put r 3 b
put r 4 get meta 24
at_emit ins meta r 0
end

fn at_bin ins edit ulong 8192 meta edit ulong 512 op ulong d ulong a ulong b ulong to void
r = new ulong 8 0
at_row0 r op
put r 1 d
put r 2 a
put r 3 b
at_emit ins meta r 0
end

fn at_un_imm ins edit ulong 8192 meta edit ulong 512 op ulong d ulong a ulong imm ulong to void
r = new ulong 8 0
at_row0 r op
put r 1 d
put r 2 a
put r 6 and imm 0xffffffff
put r 7 shl get meta 25 24
at_emit ins meta r 0
end

fn at_wide ins edit ulong 8192 meta edit ulong 512 dst ulong idx ulong imm ulong to void
r = new ulong 8 0
at_row0 r AT_OP_IMAD_WIDE
put r 1 dst
put r 2 idx
put r 4 get meta 24
put r 6 and imm 0xffffffff
put r 7 shl get meta 25 24
at_emit ins meta r 0
end

fn at_wide_b ins edit ulong 8192 meta edit ulong 512 dst ulong idx ulong imm ulong to void
r = new ulong 8 0
at_row0 r AT_OP_IMAD_WIDE
put r 1 dst
put r 2 idx
put r 4 get meta 24
put r 6 and imm 0xffffffff
put r 7 shl get meta 25 24
at_emit_fib ins meta r
end

fn at_ldg ins edit ulong 8192 meta edit ulong 512 dst ulong addr ulong to void
r = new ulong 8 0
at_row0 r AT_OP_LDG_E
put r 1 dst
put r 2 addr
put r 5 get meta 384
at_emit ins meta r 2
end

fn at_stg ins edit ulong 8192 meta edit ulong 512 addr ulong val ulong to void
r = new ulong 8 0
at_row0 r AT_OP_STG_E
put r 2 addr
put r 3 val
put r 5 get meta 384
at_emit ins meta r 4
end

fn at_sts32 ins edit ulong 8192 meta edit ulong 512 addr ulong val ulong to void
r = new ulong 8 0
at_row0 r AT_OP_STS32
put r 2 addr
put r 3 val
at_emit ins meta r 4
end

fn at_lds32 ins edit ulong 8192 meta edit ulong 512 dst ulong addr ulong to void
r = new ulong 8 0
at_row0 r AT_OP_LDS32
put r 1 dst
put r 2 addr
at_emit ins meta r 2
end

fn at_bar ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
at_row0 r AT_OP_BAR_SYNC
at_emit ins meta r 5
end

fn at_mufu ins edit ulong 8192 meta edit ulong 512 op ulong d ulong a ulong to void
r = new ulong 8 0
at_row0 r op
put r 1 d
put r 2 a
at_emit ins meta r 2
end

fn at_shfl ins edit ulong 8192 meta edit ulong 512 d ulong a ulong off ulong to void
r = new ulong 8 0
at_row0 r AT_OP_SHFL_DOWN
put r 1 d
put r 2 a
put r 6 off
at_emit ins meta r 2
end

fn at_ffma ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong to void
r = new ulong 8 0
at_row0 r AT_OP_FFMA
put r 1 d
put r 2 a
put r 3 b
put r 4 get meta 24
put r 7 or shl get meta 25 24 shl get meta 26 32
at_emit ins meta r 0
end

fn at_isetp ins edit ulong 8192 meta edit ulong 512 a ulong b ulong to void
r = new ulong 8 0
at_row0 r AT_OP_ISETP_GE_U32
put r 2 a
put r 3 b
at_emit ins meta r 1
end

fn at_bra_back ins edit ulong 8192 meta edit ulong 512 target ulong to void
r = new ulong 8 0
at_row0 r AT_OP_BRA
put r 6 and sub target get meta 0 0xffffffff
put r 7 6
at_emit ins meta r 7
end

fn at_bra_fwd ins edit ulong 8192 meta edit ulong 512 to ulong
pos = get meta 0
r = new ulong 8 0
at_row0 r AT_OP_BRA
put r 7 2
at_emit ins meta r 7
ret pos
end

fn at_tail ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
at_row0 r AT_OP_EXIT
at_emit ins meta r 6
at_row0 r AT_OP_BRA
at_push ins meta r 0x000fc000
end

fn at_ldg_b ins edit ulong 8192 meta edit ulong 512 op ulong dst ulong addr ulong sb ulong to void
r = new ulong 8 0
at_row0 r op
put r 1 dst
put r 2 addr
put r 5 get meta 384
put r 6 get meta 27
at_emit_batched ins meta r sb
end

fn at_lds128_b ins edit ulong 8192 meta edit ulong 512 dst ulong addr ulong off ulong to void
r = new ulong 8 0
at_row0 r AT_OP_LDS128
put r 1 dst
put r 2 addr
put r 6 off
at_emit_batched ins meta r 4
end

note ---- gen_attention helpers ----

fn at_setup_consts meta edit ulong 512 sp view ulong 8 to void
elem = ulong 2
if ne get sp 0 0
  elem = ulong 4
end
hd = get sp 5
gc = ulong 1
l2gc = ulong 0
if eq hd 128
  l2gqa = get sp 2
  if ge l2gqa 2
    gc = ulong 4
    l2gc = ulong 2
  else
    if eq l2gqa 1
      gc = ulong 2
      l2gc = ulong 1
    end
  end
end
hb = mul hd 4
sh_s = mul gc hb
sh_o = mul 2 sh_s
sh_r = add sh_o hb
s_cnt = ulong 1
if ne get sp 6 0
  s_cnt = shl ulong 1 get sp 7
end
put meta 32 elem
put meta 33 gc
put meta 34 l2gc
put meta 35 hb
put meta 36 sh_s
put meta 37 sh_o
put meta 38 sh_r
put meta 39 s_cnt
end

fn at_prologue_base ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
put meta 384 at_uv meta 2
put meta 385 at_v meta 2
put meta 386 at_v meta 2
put meta 387 at_v meta 2
put meta 388 at_v meta 2
put meta 389 at_v meta 1
put meta 390 at_v meta 1
put meta 391 at_v meta 1
put meta 392 at_v meta 1
put meta 393 at_v meta 1
put meta 394 at_v meta 1
put meta 395 at_v meta 1
put meta 396 at_v meta 1
put meta 397 at_v meta 1
put meta 398 at_v meta 1
put meta 399 at_v meta 1
at_ldcu64 ins meta get meta 384 0x358
at_ldc ins meta AT_OP_LDC64 get meta 385 0x380
at_ldc ins meta AT_OP_LDC64 get meta 386 0x388
at_ldc ins meta AT_OP_LDC64 get meta 387 0x390
at_ldc ins meta AT_OP_LDC64 get meta 388 0x398
at_ldc ins meta AT_OP_LDC get meta 392 0x3a0
at_ldc ins meta AT_OP_LDC get meta 393 0x3a4
at_ldc ins meta AT_OP_LDC get meta 394 0x3a8
at_ldc ins meta AT_OP_LDC get meta 395 0x3ac
at_ldc ins meta AT_OP_LDC get meta 396 0x3b0
at_ldc ins meta AT_OP_LDC get meta 397 0x3b4
at_ldc ins meta AT_OP_LDC get meta 398 0x3b8
at_ldc ins meta AT_OP_LDC get meta 399 0x3bc
at_ldc ins meta AT_OP_S2R get meta 389 AT_SR_TID_X
at_ldc ins meta AT_OP_S2R get meta 390 AT_SR_CTAID_X
at_ldc ins meta AT_OP_S2R get meta 391 AT_SR_CTAID_Y
if ne get sp 6 0
  v_sp = at_v meta 1
  put meta 400 v_sp
  put meta 25 0
  if ne get sp 7 0
    at_un_imm ins meta AT_OP_LOP3_AND v_sp get meta 391 sub get meta 39 1
    at_un_imm ins meta AT_OP_SHF_R get meta 391 get meta 391 get sp 7
  else
    at_movrz ins meta v_sp
  end
end
end

fn at_prologue_consts ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
hd = get sp 5
for k ulong 9
  put meta add 403 k at_v meta 1
end
at_movi ins meta get meta 403 1
at_movi ins meta get meta 404 4
at_movi ins meta get meta 405 div hd 2
at_movi ins meta get meta 406 hd
at_movi ins meta get meta 407 get meta 36
at_movi ins meta get meta 408 get meta 37
at_movi ins meta get meta 409 get meta 38
at_movi ins meta get meta 410 add get meta 38 128
at_movrz ins meta get meta 411
if eq hd 128
  put meta 412 at_v meta 1
  put meta 413 at_v meta 1
  put meta 414 at_v meta 1
  put meta 415 at_v meta 1
  at_movi ins meta get meta 412 add get meta 38 256
  at_movi ins meta get meta 413 add get meta 38 384
end
end

fn at_load_q_gc ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
gc = get meta 33
h0 = at_v meta 1
hg = at_v meta 1
qsh = at_v meta 1
put meta 24 AT_NOREG
at_imadi ins meta h0 get meta 390 gc
for g ulong gc bound 4
  put meta 24 h0
  at_imadi ins meta hg get meta 403 g
  if eq get sp 3 5
    at_bin ins meta AT_OP_LOP3_XOR hg hg get meta 403
  end
  put meta 24 hg
  at_imadr ins meta get meta 417 get meta 391 get meta 398
  put meta 24 get meta 416
  at_imadi ins meta get meta 418 get meta 417 get meta 35
  put meta 24 get meta 385
  at_wide ins meta get meta 419 get meta 418 1
  at_ldg ins meta get meta 420 get meta 419
  put meta 24 get meta 416
  at_imadi ins meta qsh get meta 403 mul g get meta 35
  at_sts32 ins meta qsh get meta 420
end
end

fn at_load_q ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
gc = get meta 33
put meta 416 at_v meta 1
put meta 417 at_v meta 1
put meta 418 at_v meta 1
put meta 419 at_v meta 2
put meta 420 at_v meta 1
if eq gc 1
  put meta 421 at_v meta 2
end
hq = get meta 390
ho = get meta 390
if eq gc 1
  if eq get sp 3 5
    hq = at_v meta 1
    at_bin ins meta AT_OP_LOP3_XOR hq get meta 390 get meta 403
  end
  if eq get sp 3 6
    ho = at_v meta 1
    at_bin ins meta AT_OP_LOP3_XOR ho get meta 390 get meta 403
  end
end
put meta 24 AT_NOREG
put meta 25 0
at_imadi ins meta get meta 416 get meta 389 4
if eq gc 1
  put meta 24 hq
  at_imadr ins meta get meta 417 get meta 391 get meta 398
  put meta 24 get meta 416
  at_imadi ins meta get meta 418 get meta 417 get meta 35
  put meta 24 get meta 385
  at_wide ins meta get meta 419 get meta 418 1
  at_ldg ins meta get meta 420 get meta 419
  at_sts32 ins meta get meta 416 get meta 420
  if eq get sp 6 0
    if eq ho hq
      put meta 24 get meta 387
      at_wide ins meta get meta 421 get meta 418 1
    else
      orow = at_v meta 1
      ooff = at_v meta 1
      put meta 24 ho
      at_imadr ins meta orow get meta 391 get meta 398
      put meta 24 get meta 416
      at_imadi ins meta ooff orow get meta 35
      put meta 24 get meta 387
      at_wide ins meta get meta 421 ooff 1
    end
  end
else
  at_load_q_gc ins meta sp
end
end

fn at_split_slice ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
hd = get sp 5
l2hd = ulong 6
if eq hd 128
  l2hd = ulong 7
end
for k ulong 7
  put meta add 48 k at_v meta 1
end
put meta 401 at_v meta 1
put meta 402 at_v meta 1
at_movi ins meta get meta 53 sub hd 1
at_bin ins meta AT_OP_IADD3 get meta 48 get meta 427 get meta 53
put meta 25 0
at_un_imm ins meta AT_OP_LOP3_AND get meta 48 get meta 48 xor sub hd 1 0xffffffff
at_un_imm ins meta AT_OP_SHF_R get meta 49 get meta 48 l2hd
c = ulong 1
while le c get sp 7 bound 8
  at_movi ins meta get meta 54 sub shl ulong 1 c 1
  at_bin ins meta AT_OP_IADD3 get meta 50 get meta 427 get meta 54
  at_un_imm ins meta AT_OP_SHF_R get meta 50 get meta 50 c
  at_bin ins meta AT_OP_IADD3 get meta 50 get meta 50 get meta 53
  at_un_imm ins meta AT_OP_LOP3_AND get meta 50 get meta 50 xor sub hd 1 0xffffffff
  at_movi ins meta get meta 54 and sub ulong 0 shl ulong 1 c 0xffffffff
  at_bin ins meta AT_OP_IADD3 get meta 51 get meta 49 get meta 54
  at_un_imm ins meta AT_OP_SHF_R get meta 52 get meta 51 31
  put meta 24 get meta 48
  at_imadi ins meta get meta 51 get meta 50 0xffffffff
  put meta 24 get meta 50
  at_imadr ins meta get meta 48 get meta 52 get meta 51
  c = add c 1
end
put meta 24 AT_NOREG
at_imadr ins meta get meta 401 get meta 400 get meta 48
at_bin ins meta AT_OP_IADD3 get meta 402 get meta 401 get meta 48
put meta 24 get meta 427
at_imadi ins meta get meta 51 get meta 402 0xffffffff
at_un_imm ins meta AT_OP_SHF_R get meta 52 get meta 51 31
put meta 24 get meta 402
at_imadr ins meta get meta 402 get meta 52 get meta 51
end

fn at_kv_and_state ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
put meta 422 at_v meta 1
put meta 423 at_v meta 1
put meta 424 at_v meta 1
put meta 425 at_v meta 2
put meta 426 at_v meta 2
put meta 427 at_v meta 1
put meta 428 at_v meta 2
put meta 25 0
at_un_imm ins meta AT_OP_SHF_R get meta 422 get meta 390 sub get sp 2 get meta 34
if eq get sp 3 2
  at_bin ins meta AT_OP_LOP3_XOR get meta 422 get meta 422 get meta 403
end
put meta 24 AT_NOREG
at_imadr ins meta get meta 423 get meta 422 get meta 397
at_imadr ins meta get meta 424 get meta 391 get meta 392
at_imadi ins meta get meta 424 get meta 424 4
put meta 24 get meta 388
at_wide ins meta get meta 425 get meta 424 1
put meta 24 get meta 399
at_imadi ins meta get meta 424 get meta 391 4
put meta 24 get meta 388
at_wide ins meta get meta 426 get meta 424 1
at_ldg ins meta get meta 427 get meta 426
if ne get sp 6 0
  at_split_slice ins meta sp
end
put meta 24 get meta 386
put meta 25 0
at_wide ins meta get meta 428 get meta 389 get meta 32
put meta 24 get meta 428
at_wide ins meta get meta 428 get meta 396 1
gc = get meta 33
for g ulong gc bound 4
  put meta add 430 g at_v meta 1
end
for g ulong gc bound 4
  put meta add 434 g at_v meta 1
end
for g ulong gc bound 4
  put meta add 438 g at_v meta 1
end
put meta 442 at_v meta 1
put meta 443 at_v meta 1
put meta 444 at_v meta 1
put meta 445 at_v meta 1
for g ulong gc bound 4
  at_movi ins meta get meta add 430 g AT_F32_NINF
end
for g ulong gc bound 4
  if eq get sp 3 1
    at_movrz ins meta get meta add 434 g
  else
    at_movi ins meta get meta add 434 g AT_F32_ONE
  end
end
for g ulong gc bound 4
  at_movrz ins meta get meta add 438 g
end
if ne get sp 6 0
  at_bin ins meta AT_OP_IADD3 get meta 442 get meta 401 get meta 411
else
  at_movrz ins meta get meta 442
end
at_bin ins meta AT_OP_IADD3 get meta 443 get meta 416 get meta 407
at_bin ins meta AT_OP_IADD3 get meta 444 get meta 416 get meta 408
at_bin ins meta AT_OP_IADD3 get meta 445 get meta 416 get meta 409
at_bar ins meta
if ne get sp 6 0
  at_isetp ins meta get meta 401 get meta 402
else
  at_isetp ins meta get meta 411 get meta 427
end
put meta 28 at_bra_fwd ins meta
end

fn at_phase_a_dot_hh ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
g = get meta 46
hh = get meta 47
half = ulong 2
if ne get sp 0 0
  half = ulong 1
end
for i ulong half bound 2
  qi = add mul hh half i
  off = add mul g get meta 35 mul qi 16
  at_lds128_b ins meta get meta add 482 qi get meta 468 off
end
dotg = get meta add 461 g
kx_v = get meta add 480 hh
if ne get sp 0 0
  qq_v = get meta add 482 hh
  for s4 ulong 4
    put meta 24 dotg
    put meta 25 s4
    put meta 26 s4
    at_ffma ins meta dotg qq_v kx_v
  end
else
  for s4 ulong 4
    pi = add mul hh 4 s4
    put meta 24 AT_NOREG
    put meta 25 s4
    at_imadi ins meta get meta 466 kx_v 0x10000
    at_un_imm ins meta AT_OP_LOP3_AND get meta 467 kx_v 0xffff0000
    qq_p = get meta add 482 div pi 2
    sub0 = mul rem pi 2 2
    put meta 24 dotg
    put meta 25 sub0
    put meta 26 0
    at_ffma ins meta dotg qq_p get meta 466
    put meta 25 add sub0 1
    at_ffma ins meta dotg qq_p get meta 467
  end
end
end

fn at_phase_a_dot_g ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 g ulong to void
put meta 46 g
put meta 47 0
at_phase_a_dot_hh ins meta sp
put meta 47 1
at_phase_a_dot_hh ins meta sp
end

fn at_phase_a ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
r = new ulong 8 0
gc = get meta 33
lim = get meta 427
if ne get sp 6 0
  lim = get meta 402
end
put meta 450 at_v meta 1
for g ulong gc bound 4
  put meta add 451 g at_v meta 1
end
put meta 455 at_v meta 1

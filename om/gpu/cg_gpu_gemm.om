note om/gpu/cg_gpu_gemm.om: Pure OM-2 Blackwell IR emitters and planner for general BF16/FP8 GEMM.
note Replaces gen_pack, gen_main, omega_gpu_gemm_codegen, and omega_gpu_gemm_plan in src/omega_gpu_gemm.c.
om2

const GG_NOREG ulong 0xffffffffffffffff
const GG_CW_YIELD ulong 0x2000
const GG_FRAG ulong 512
const GG_QMMA_MARK ulong 0x51303832
const GG_MAX_DIM ulong 16384

const GG_OP_NOP ulong 0
const GG_OP_MOV_RZ ulong 1
const GG_OP_MOV_IMM ulong 2
const GG_OP_S2R ulong 3
const GG_OP_LDC ulong 4
const GG_OP_LDC64 ulong 5
const GG_OP_LDCU64 ulong 7
const GG_OP_IMAD ulong 8
const GG_OP_IMAD_WIDE ulong 9
const GG_OP_STG_E ulong 12
const GG_OP_IADD3 ulong 14
const GG_OP_HMMA_BF16 ulong 16
const GG_OP_SHF_R ulong 17
const GG_OP_LOP3_AND ulong 18
const GG_OP_LDG_U16 ulong 19
const GG_OP_ISETP_GE_U32 ulong 28
const GG_OP_EXIT ulong 45
const GG_OP_BRA ulong 46
const GG_OP_LOP3_LUT ulong 51
const GG_OP_BSSY ulong 54
const GG_OP_BSYNC ulong 55
const GG_OP_LDG_128 ulong 57

const GG_SR_TID_X ulong 0x21
const GG_SR_CTAID_X ulong 0x25
const GG_SR_CTAID_Y ulong 0x26

fn gg_cw st ulong wb ulong rb ulong wt ulong to ulong
ret or or or shl st 9 shl wb 14 shl rb 17 shl wt 20
end

fn gg_v meta edit ulong 512 w ulong to ulong
v = get meta 1
if ge v 256
  put meta 5 1
  ret 0
end
put meta add 64 v w
put meta 1 add v 1
ret v
end

fn gg_uv meta edit ulong 512 w ulong to ulong
u = get meta 2
if ge u 32
  put meta 5 1
  ret 0
end
put meta add 352 u w
put meta 2 add u 1
ret u
end

fn gg_row0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 GG_NOREG
put r 2 GG_NOREG
put r 3 GG_NOREG
put r 4 GG_NOREG
put r 5 GG_NOREG
put r 6 0
put r 7 0
end

fn gg_push ins edit ulong 8192 meta edit ulong 512 r view ulong 8 ctrl ulong to void
n = get meta 0
if ge n 1024
  put meta 5 1
  ret
end
b = mul n 8
for k ulong 6
  put ins add b k get r k
end
put ins add b 6 or and get r 6 0xffffffff shl ctrl 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn gg_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
wt = get meta 4
ctrl = ulong 0
if eq kind 0
  ctrl = gg_cw 6 7 7 wt
  put meta 4 0
end
if eq kind 1
  ctrl = gg_cw 14 7 7 wt
  put meta 4 0
end
if eq kind 2
  ctrl = or gg_cw 4 0 1 wt GG_CW_YIELD
  put meta 4 3
end
if eq kind 3
  ctrl = or gg_cw 4 0 1 and wt 2 GG_CW_YIELD
  put meta 4 or wt 3
end
if eq kind 4
  ctrl = or gg_cw 4 2 7 wt GG_CW_YIELD
  put meta 4 4
end
if eq kind 5
  ctrl = or gg_cw 4 7 1 wt GG_CW_YIELD
  put meta 4 2
end
if eq kind 7
  ctrl = gg_cw 5 7 7 wt
  if eq and shr get r 7 1 1 0
    put meta 4 0
  end
end
if eq kind 8
  ctrl = gg_cw 5 7 7 wt
  if eq and shr get r 7 1 1 0
    put meta 4 0
  end
end
if eq kind 9
  ctrl = or gg_cw 1 7 7 wt GG_CW_YIELD
  put meta 4 0
end
if eq kind 10
  ctrl = or gg_cw 5 7 7 wt GG_CW_YIELD
  put meta 4 0
end
gg_push ins meta r ctrl
end

fn gg_ldcu64 ins edit ulong 8192 meta edit ulong 512 ud ulong off ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_LDCU64
put r 1 ud
put r 6 off
put r 7 1
gg_emit ins meta r 4
end

fn gg_ldc ins edit ulong 8192 meta edit ulong 512 op ulong dst ulong off ulong to void
r = new ulong 8 0
gg_row0 r op
put r 1 dst
put r 6 off
gg_emit ins meta r 2
end

fn gg_movi ins edit ulong 8192 meta edit ulong 512 dst ulong imm ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_MOV_IMM
put r 1 dst
put r 6 and imm 0xffffffff
gg_emit ins meta r 0
end

fn gg_movrz ins edit ulong 8192 meta edit ulong 512 dst ulong dsub ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_MOV_RZ
put r 1 dst
put r 7 shl dsub 16
gg_emit ins meta r 0
end

fn gg_imadi ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong imm ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_IMAD
put r 1 dst
put r 2 a
put r 4 get meta 16
put r 6 and imm 0xffffffff
gg_emit ins meta r 0
end

fn gg_imadr ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong b ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_IMAD
put r 1 dst
put r 2 a
put r 3 b
put r 4 get meta 16
gg_emit ins meta r 0
end

fn gg_imadw ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong imm ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_IMAD_WIDE
put r 1 dst
put r 2 a
put r 4 get meta 16
put r 6 and imm 0xffffffff
gg_emit ins meta r 0
end

fn gg_shr ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong imm ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_SHF_R
put r 1 dst
put r 2 a
put r 6 imm
gg_emit ins meta r 0
end

fn gg_andi ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong imm ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_LOP3_AND
put r 1 dst
put r 2 a
put r 6 and imm 0xffffffff
gg_emit ins meta r 0
end

fn gg_and_r ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong b ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_LOP3_LUT
put r 1 dst
put r 2 a
put r 3 b
put r 6 0xc0
gg_emit ins meta r 0
end

fn gg_iadd ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong b ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_IADD3
put r 1 dst
put r 2 a
put r 3 b
gg_emit ins meta r 0
end

fn gg_isub ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong b ulong to void
put meta 16 a
gg_imadi ins meta dst b 0xffffffff
end

fn gg_lt_bit ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong b ulong to void
gg_isub ins meta dst a b
gg_shr ins meta dst dst 31
end

fn gg_isetp_ge_u32 ins edit ulong 8192 meta edit ulong 512 a ulong b ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_ISETP_GE_U32
put r 2 a
put r 3 b
gg_emit ins meta r 1
end

fn gg_ldg_u16 ins edit ulong 8192 meta edit ulong 512 dst ulong addr ulong first ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_LDG_U16
put r 1 dst
put r 2 addr
put r 5 get meta 384
kind = ulong 3
if ne first 0
  kind = ulong 2
end
gg_emit ins meta r kind
end

fn gg_stg ins edit ulong 8192 meta edit ulong 512 addr ulong off ulong val ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_STG_E
put r 2 addr
put r 3 val
put r 5 get meta 384
put r 6 and off 0xffffffff
put r 7 shl get meta 17 32
gg_emit ins meta r 5
end

fn gg_ldw_pf ins edit ulong 8192 meta edit ulong 512 dst ulong addr ulong off ulong to void
sb = get meta 18
r = new ulong 8 0
gg_row0 r GG_OP_LDG_128
put r 1 dst
put r 2 addr
put r 5 get meta 384
put r 6 and off 0xffffffff
wt = get meta 4
ctrl = or gg_cw 4 sb 1 and wt 2 GG_CW_YIELD
put meta 4 or wt 2
put meta 6 or get meta 6 shl ulong 1 sb
gg_push ins meta r ctrl
end

fn gg_consume meta edit ulong 512 sb ulong to void
bit = shl ulong 1 sb
h = get meta 6
put meta 4 or get meta 4 and h bit
put meta 6 and h xor bit GG_NOREG
end

fn gg_nop ins edit ulong 8192 meta edit ulong 512 st ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_NOP
wt = get meta 4
put meta 4 0
gg_push ins meta r gg_cw st 7 7 wt
end

fn gg_mma ins edit ulong 8192 meta edit ulong 512 dst ulong a ulong b ulong to void
r = new ulong 8 0
gg_row0 r GG_OP_HMMA_BF16
put r 1 dst
put r 2 a
put r 3 b
put r 4 dst
if ne get meta 19 0
  put r 6 GG_QMMA_MARK
end
put r 7 shl get meta 20 32
wt = get meta 4
put meta 4 0
gg_push ins meta r gg_cw get meta 21 7 7 wt
end

fn gg_tail ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
gg_row0 r GG_OP_EXIT
gg_emit ins meta r 7
gg_row0 r GG_OP_BRA
gg_push ins meta r 0x000fc000
end

fn gg_patch_imm ins edit ulong 8192 meta edit ulong 512 pos ulong target ulong to void
if ge pos 1024
  put meta 5 1
  ret
end
if ne get meta 5 0
  ret
end
idx = add mul pos 8 6
old = get ins idx
delta = and sub target pos 0xffffffff
put ins idx or and old 0xffffffff00000000 delta
end

fn gg_loop_begin meta edit ulong 512 to void
d = get meta 7
if ge d 4
  put meta 5 1
  ret
end
put meta add 8 d get meta 0
put meta 7 add d 1
end

fn gg_loop_end meta edit ulong 512 to void
d = get meta 7
if eq d 0
  put meta 5 1
  ret
end
d = sub d 1
put meta 7 d
nl = get meta 3
if ge nl 16
  put meta 5 1
  ret
end
put meta add 320 mul nl 2 get meta add 8 d
put meta add 321 mul nl 2 sub get meta 0 1
put meta 3 add nl 1
end

fn gg_pow124 v ulong to ulong
if eq v 1
  ret 1
end
if eq v 2
  ret 1
end
if eq v 4
  ret 1
end
ret 0
end

fn gg_cfg_ok sp view ulong 8 to ulong
if gt get sp 0 1
  ret 0
end
if eq gg_pow124 get sp 1 0
  ret 0
end
if eq gg_pow124 get sp 2 0
  ret 0
end
if eq gg_pow124 get sp 3 0
  ret 0
end
if eq gg_pow124 get sp 4 0
  ret 0
end
if lt get sp 5 1
  ret 0
end
if gt get sp 5 15
  ret 0
end
if gt get sp 6 4
  ret 0
end
rt = get sp 1
ct = get sp 2
regs = mul 4 add add mul 4 rt mul 2 ct mul rt ct
if gt regs 100
  ret 0
end
ret 1
end

fn gg_log2 v ulong to ulong
if eq v 1
  ret 0
end
if eq v 2
  ret 1
end
ret 2
end


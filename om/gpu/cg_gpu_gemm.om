gg_imadw ins meta get meta 385 get meta 402 1
put meta 16 get meta 386
gg_imadw ins meta get meta 386 get meta 402 1
nt = mul rt ct
for x ulong nt bound 16
  acc = get meta add 410 x
  for q ulong 4
    gg_movrz ins meta acc q
  end
end
gg_shr ins meta get meta 403 get meta 390 1
end

fn gg_run_main ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
rt = get sp 1
ct = get sp 2
gm_alloc meta rt ct
gm_prologue ins meta sp
put meta 18 3
gm_issue ins meta rt ct 0
top = get meta 0
gg_loop_begin meta
put meta 18 4
gm_issue ins meta rt ct 1
gg_consume meta 3
gm_compute ins meta sp 0
gg_nop ins meta 15
put meta 18 3
gm_issue ins meta rt ct 0
gg_consume meta 4
gm_compute ins meta sp 1
gg_nop ins meta 15
put meta 16 get meta 403
gg_imadi ins meta get meta 403 get meta 398 0xffffffff
gg_isetp_ge_u32 ins meta get meta 403 get meta 398
r = new ulong 8 0
gg_row0 r GG_OP_BRA
put r 6 and sub top get meta 0 0xffffffff
put r 7 2
gg_emit ins meta r 8
gg_loop_end meta
gg_consume meta 3
gg_nop ins meta 15
gg_nop ins meta 15
gg_nop ins meta 15
gg_nop ins meta 15
gm_stores ins meta sp
gg_tail ins meta
end

export fn cg_gpu_gemm_emit sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to ulong
if eq gg_cfg_ok sp 0
  ret 1
end
kind = get sp 7
if ge kind 3
  ret 1
end
if eq kind 2
  gg_run_main ins meta sp
  ret get meta 5
end
gp_alloc meta
gp_prologue ins meta sp
ff = mul 2 get sp 1
if eq kind 1
  ff = get sp 2
end
for f ulong ff bound 8
  gp_frag ins meta sp f
end
gg_tail ins meta
ret get meta 5
end

fn gg_roundup v ulong m ulong to ulong
ret mul div sub add v m 1 m m
end

fn gg_plan_check sp view ulong 10 to ulong
if gt get sp 0 1
  ret 1
end
if eq gg_pow124 get sp 1 0
  ret 1
end
if eq gg_pow124 get sp 2 0
  ret 1
end
if eq gg_pow124 get sp 3 0
  ret 1
end
if eq gg_pow124 get sp 4 0
  ret 1
end
if lt get sp 5 1
  ret 1
end
if gt get sp 5 15
  ret 1
end
if gt get sp 6 4
  ret 1
end
rt = get sp 1
ct = get sp 2
if gt mul 4 add add mul 4 rt mul 2 ct mul rt ct 100
  ret 1
end
if eq get sp 7 0
  ret 1
end
if eq get sp 8 0
  ret 1
end
if eq get sp 9 0
  ret 1
end
if gt get sp 7 GG_MAX_DIM
  ret 2
end
if gt get sp 8 GG_MAX_DIM
  ret 2
end
if gt get sp 9 GG_MAX_DIM
  ret 2
end
ret 0
end

fn gg_plan_fill sp view ulong 10 res edit ulong 18 to void
ga = mul 16 get sp 1
gb = mul 8 get sp 2
mp = get res 0
np = get res 1
ks2 = get res 3
fa = mul 2 get sp 1
t1 = mul div mp ga ks2
t2 = mul fa GG_FRAG
put res 6 add mul t1 t2 mul 2 t2
t1 = mul div np gb ks2
t2 = mul get sp 2 GG_FRAG
put res 7 add mul t1 t2 mul 2 t2
put res 8 ks2
put res 9 div mp ga
put res 10 ks2
put res 11 div np gb
put res 12 div np mul gb get sp 4
put res 13 div mp mul ga get sp 3
put res 14 128
put res 15 128
put res 16 mul mul 32 get sp 3 get sp 4
end

export fn cg_gpu_gemm_plan sp view ulong 10 res edit ulong 18 to ulong
chk = gg_plan_check sp
if ne chk 0
  ret chk
end
esz = ulong 2
ks = ulong 16
if ne get sp 0 0
  esz = ulong 1
  ks = ulong 32
end
ga = mul 16 get sp 1
gb = mul 8 get sp 2
put res 0 gg_roundup get sp 7 mul ga get sp 3
put res 1 gg_roundup get sp 8 mul gb get sp 4
kp = gg_roundup get sp 9 mul 4 ks
put res 2 kp
put res 3 div kp mul 2 ks
put res 4 mul mul get sp 7 get sp 9 esz
put res 5 mul mul get sp 9 get sp 8 esz
gg_plan_fill sp res
ret 0
end

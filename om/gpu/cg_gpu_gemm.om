fn gm_alloc meta edit ulong 512 rt ulong ct ulong to void
put meta 384 gg_uv meta 2
put meta 385 gg_v meta 2
put meta 386 gg_v meta 2
put meta 387 gg_v meta 2
put meta 388 gg_v meta 1
put meta 389 gg_v meta 1
put meta 390 gg_v meta 1
put meta 391 gg_v meta 1
put meta 392 gg_v meta 1
put meta 393 gg_v meta 1
put meta 394 gg_v meta 1
put meta 395 gg_v meta 1
put meta 396 gg_v meta 1
put meta 397 gg_v meta 1
put meta 398 gg_v meta 1
put meta 399 gg_v meta 1
put meta 400 gg_v meta 1
put meta 401 gg_v meta 1
put meta 402 gg_v meta 1
put meta 403 gg_v meta 1
nt = mul rt ct
for x ulong nt bound 16
  put meta add 410 x gg_v meta 4
end
fa = mul 2 rt
for s ulong 2
  for f ulong fa bound 8
    put meta add add 426 mul s 8 f gg_v meta 4
  end
  for j ulong ct bound 4
    put meta add add 442 mul s 4 j gg_v meta 4
  end
end
end

fn gm_issue ins edit ulong 8192 meta edit ulong 512 rt ulong ct ulong s ulong to void
fa = mul 2 rt
base_a = add 426 mul s 8
for f ulong fa bound 8
  dst = get meta add base_a f
  gg_ldw_pf ins meta dst get meta 385 mul f GG_FRAG
end
base_b = add 442 mul s 4
for j ulong ct bound 4
  dst = get meta add base_b j
  gg_ldw_pf ins meta dst get meta 386 mul j GG_FRAG
end
put meta 16 get meta 385
gg_imadw ins meta get meta 385 get meta 398 mul fa GG_FRAG
put meta 16 get meta 386
gg_imadw ins meta get meta 386 get meta 398 mul ct GG_FRAG
end

fn gm_compute_ui ins edit ulong 8192 meta edit ulong 512 ct ulong s ulong u ulong to void
rt = get meta 23
i = get meta 24
put meta 20 mul 2 u
a = get meta add add 426 mul s 8 add mul u rt i
bd = add 410 mul i ct
bb = add 442 mul s 4
for j ulong ct bound 4
  d = get meta add bd j
  b = get meta add bb j
  gg_mma ins meta d a b
end
end

fn gm_compute ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 s ulong to void
put meta 19 get sp 0
put meta 21 get sp 5
put meta 23 get sp 1
for u ulong 2
  if eq get sp 6 1
    if eq u 1
      break
    end
  end
  for i ulong get sp 1 bound 4
    put meta 24 i
    gm_compute_ui ins meta get sp 2 s u
  end
end
end

fn gm_store_cell ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 j ulong cc ulong to void
r = new ulong 8 0
put meta 16 get meta 451
gg_imadi ins meta get meta 453 get meta 398 add mul 8 j cc
gg_lt_bit ins meta get meta 455 get meta 453 get meta 389
gg_and_r ins meta get meta 455 get meta 455 get meta 454
gg_isetp_ge_u32 ins meta get meta 399 get meta 455
put meta 26 get meta 0
gg_row0 r GG_OP_BSSY
put r 6 2
gg_emit ins meta r 9
put meta 27 get meta 0
gg_row0 r GG_OP_BRA
put r 6 1
put r 7 2
gg_emit ins meta r 8
gg_iadd ins meta get meta 402 get meta 456 get meta 453
put meta 16 get meta 387
gg_imadw ins meta get meta 457 get meta 402 4
sub_cc = cc
if eq get sp 6 3
  sub_cc = sub 1 cc
end
put meta 17 add mul 2 get meta 25 sub_cc
acc = get meta add 410 add mul get meta 24 get sp 2 j
gg_stg ins meta get meta 457 0 acc
at_pos = get meta 0
gg_row0 r GG_OP_BSYNC
gg_emit ins meta r 10
gg_patch_imm ins meta get meta 27 at_pos
gg_patch_imm ins meta get meta 26 add at_pos 1
end

fn gm_stores ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
put meta 450 gg_v meta 1
put meta 451 gg_v meta 1
put meta 452 gg_v meta 1
put meta 453 gg_v meta 1
put meta 454 gg_v meta 1
put meta 455 gg_v meta 1
put meta 456 gg_v meta 1
put meta 457 gg_v meta 2
gg_shr ins meta get meta 396 get meta 395 2
gg_andi ins meta get meta 397 get meta 395 3
put meta 16 get meta 396
gg_imadi ins meta get meta 450 get meta 400 mul 16 get sp 1
put meta 16 GG_NOREG
gg_imadi ins meta get meta 402 get meta 397 2
put meta 16 get meta 402
gg_imadi ins meta get meta 451 get meta 401 mul 8 get sp 2
for i ulong get sp 1 bound 4
  put meta 24 i
  for h ulong 2
    put meta 25 h
    put meta 16 get meta 450
    gg_imadi ins meta get meta 452 get meta 398 add mul 16 i mul 8 h
    gg_lt_bit ins meta get meta 454 get meta 452 get meta 388

fn gp_alloc meta edit ulong 512 to void
put meta 384 gg_uv meta 2
put meta 385 gg_v meta 2
put meta 386 gg_v meta 2
put meta 387 gg_v meta 1
put meta 388 gg_v meta 1
put meta 389 gg_v meta 1
put meta 390 gg_v meta 1
put meta 391 gg_v meta 1
put meta 392 gg_v meta 1
put meta 393 gg_v meta 1
put meta 394 gg_v meta 1
put meta 395 gg_v meta 1
put meta 396 gg_v meta 1
put meta 397 gg_v meta 1
put meta 398 gg_v meta 1
put meta 399 gg_v meta 1
put meta 400 gg_v meta 1
put meta 401 gg_v meta 1
put meta 402 gg_v meta 1
put meta 403 gg_v meta 2
put meta 404 gg_v meta 1
put meta 405 gg_v meta 1
put meta 406 gg_v meta 1
put meta 407 gg_v meta 1
put meta 408 gg_v meta 1
put meta 409 gg_v meta 1
put meta 410 gg_v meta 1
for x ulong 4
  put meta add 412 x gg_v meta 2
  put meta add 416 x gg_v meta 1
  put meta add 420 x gg_v meta 1
  put meta add 424 x gg_v meta 1
end
end

fn gp_prologue ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 to void
fp8 = get sp 0
isb = get sp 7
ks = ulong 16
r_el = ulong 2
if ne fp8 0
  ks = ulong 32
  r_el = ulong 4
end
ff = mul 2 get sp 1
if ne isb 0
  ff = get sp 2
end
gg_ldcu64 ins meta get meta 384 0x358
gg_ldc ins meta GG_OP_LDC64 get meta 385 0x380
gg_ldc ins meta GG_OP_LDC64 get meta 386 0x388
gg_ldc ins meta GG_OP_LDC get meta 387 0x390
gg_ldc ins meta GG_OP_LDC get meta 388 0x394
gg_ldc ins meta GG_OP_LDC get meta 389 0x398
gg_ldc ins meta GG_OP_LDC get meta 390 0x39c
gg_ldc ins meta GG_OP_LDC get meta 391 0x3a0
gg_ldc ins meta GG_OP_S2R get meta 392 GG_SR_TID_X
gg_ldc ins meta GG_OP_S2R get meta 393 GG_SR_CTAID_X
gg_ldc ins meta GG_OP_S2R get meta 394 GG_SR_CTAID_Y
gg_movi ins meta get meta 395 1
gg_shr ins meta get meta 396 get meta 392 4
gg_shr ins meta get meta 397 get meta 392 2
gg_andi ins meta get meta 397 get meta 397 3
gg_andi ins meta get meta 398 get meta 392 1
gg_shr ins meta get meta 399 get meta 392 1
gg_andi ins meta get meta 399 get meta 399 1
if eq isb 0
  put meta 16 get meta 396
  gg_imadi ins meta get meta 400 get meta 394 mul 16 get sp 1
  put meta 16 get meta 400
  gg_imadi ins meta get meta 400 get meta 398 8
  put meta 16 GG_NOREG
  gg_imadi ins meta get meta 401 get meta 393 mul 2 ks
  put meta 16 get meta 401
  gg_imadi ins meta get meta 401 get meta 397 r_el
  gg_imadi ins meta get meta 401 get meta 399 mul 4 r_el
else
  put meta 16 get meta 396
  gg_imadi ins meta get meta 400 get meta 394 mul 8 get sp 2
  put meta 16 GG_NOREG
  gg_imadi ins meta get meta 401 get meta 393 mul 2 ks
  put meta 16 get meta 401
  gg_imadi ins meta get meta 401 get meta 397 r_el
  gg_imadi ins meta get meta 401 get meta 399 ks
  gg_imadi ins meta get meta 401 get meta 398 mul 4 r_el
end
put meta 16 get meta 393
gg_imadr ins meta get meta 402 get meta 394 get meta 391
put meta 16 get meta 392
gg_imadi ins meta get meta 402 get meta 402 mul ff 128
put meta 16 get meta 386
gg_imadw ins meta get meta 403 get meta 402 4
end

fn gp_frag_elem ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 x ulong to void
fp8 = get sp 0
dk = get meta 22
put meta 16 get meta 401
gg_imadi ins meta get meta 407 get meta 395 add dk x
gg_lt_bit ins meta get meta 408 get meta 407 get meta 388
gg_and_r ins meta get meta 408 get meta 408 get meta 405
put meta 16 get meta 406
gg_imadr ins meta get meta 409 get meta 407 get meta 390
put meta 16 GG_NOREG
gg_imadr ins meta get meta 409 get meta 409 get meta 408
if eq get sp 6 2
  gg_movi ins meta get meta add 420 x 0xffffffff
else
  put meta 16 GG_NOREG
  gg_imadi ins meta get meta add 420 x get meta 408 0xffffffff
end
if ne fp8 0
  gg_andi ins meta get meta add 424 x get meta 409 1
  gg_andi ins meta get meta 409 get meta 409 0xfffffffe
  put meta 16 get meta 385
  gg_imadw ins meta get meta add 412 x get meta 409 1
else
  put meta 16 get meta 385
  gg_imadw ins meta get meta add 412 x get meta 409 2
end
end

fn gp_frag_finish ins edit ulong 8192 meta edit ulong 512 fp8 ulong r_el ulong f ulong to void
for x ulong r_el bound 4
  first = ulong 0
  if eq x 0
    first = ulong 1
  end
  gg_ldg_u16 ins meta get meta add 416 x get meta add 412 x first
end
for x ulong r_el bound 4
  val = get meta add 416 x
  if ne fp8 0
    gg_andi ins meta get meta 407 val 0xff
    gg_shr ins meta get meta 408 val 8
    gg_andi ins meta get meta 408 get meta 408 0xff
    gg_isub ins meta get meta 408 get meta 408 get meta 407
    put meta 16 get meta 407
    gg_imadr ins meta val get meta 408 get meta add 424 x
  end
  gg_and_r ins meta val val get meta add 420 x
end
put meta 16 GG_NOREG
gg_imadi ins meta get meta 410 get meta 416 1
step_sh = div 32 r_el
x = ulong 1
while lt x r_el bound 4
  put meta 16 get meta 410
  gg_imadi ins meta get meta 410 get meta add 416 x shl ulong 1 mul x step_sh
  x = add x 1
end
put meta 17 0
gg_stg ins meta get meta 403 mul f GG_FRAG get meta 410
end

fn gp_frag ins edit ulong 8192 meta edit ulong 512 sp view ulong 8 f ulong to void
fp8 = get sp 0
ks = ulong 16
r_el = ulong 2
if ne fp8 0
  ks = ulong 32
  r_el = ulong 4
end
drow = mul 16 rem f get sp 1
dk = mul ks div f get sp 1
if ne get sp 7 0
  drow = mul 8 f
  dk = ulong 0
end
put meta 22 dk
put meta 16 get meta 400
gg_imadi ins meta get meta 404 get meta 395 drow
gg_lt_bit ins meta get meta 405 get meta 404 get meta 387
put meta 16 GG_NOREG
gg_imadr ins meta get meta 406 get meta 404 get meta 389
for x ulong r_el bound 4
  gp_frag_elem ins meta sp x
end
gp_frag_finish ins meta fp8 r_el f
end


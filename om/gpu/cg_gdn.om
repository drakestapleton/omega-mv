om2
note Pure OM-2 Blackwell Gated DeltaNet codegen (om/gpu/cg_gdn.om).
note Replaces the kernel emitters in src/omega_blackwell_codegen_gdn.c.

const GD_NOREG ulong 0xffffffffffffffff
const GD_C_LOG2E ulong 0x3fb8aa3b
const GD_C_NLOG2E ulong 0xbfb8aa3b
const GD_C_LN2 ulong 0x3f317218
const GD_C_ONE ulong 0x3f800000
const GD_C_M1 ulong 0xbf800000
const GD_C_INV128 ulong 0x3c000000
const GD_C_QS ulong 0x3db504f3
const GD_C_1MQS ulong 0x3f695f62

fn gd_op v ulong s ulong to ulong
ret or v shl s 16
end

fn gd_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn gd_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn gd_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn gd_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 GD_NOREG
put r 2 GD_NOREG
put r 3 GD_NOREG
put r 4 GD_NOREG
put r 5 GD_NOREG
put r 6 0
put r 7 0
end

fn gd_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = gd_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = gd_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or gd_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or gd_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or gd_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or gd_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = gd_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = gd_cw 5 7 7 wt
p0 = and shr get r 7 1 1
if eq p0 0
put meta 4 0
end
end
if eq kind 8
cw = gd_cw 5 7 7 wt
p0 = and shr get r 7 1 1
if eq p0 0
put meta 4 0
end
end
if eq kind 9
cw = or gd_cw 1 7 7 wt 0x2000
put meta 4 0
end
if eq kind 10
cw = or gd_cw 5 7 7 wt 0x2000
put meta 4 0
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn gd_ldcu64 ins edit ulong 8192 meta edit ulong 512 ud ulong off ulong to void
r = new ulong 8 0
gd_r0 r 7
put r 1 ud
put r 6 off
put r 7 1
gd_emit ins meta r 4
end

fn gd_ldc64 ins edit ulong 8192 meta edit ulong 512 d ulong off ulong to void
r = new ulong 8 0
gd_r0 r 5
put r 1 d
put r 6 off
gd_emit ins meta r 2
end

fn gd_ldc32 ins edit ulong 8192 meta edit ulong 512 d ulong off ulong to void
r = new ulong 8 0
gd_r0 r 4
put r 1 d
put r 6 off
gd_emit ins meta r 2
end

fn gd_s2r ins edit ulong 8192 meta edit ulong 512 d ulong sr ulong to void
r = new ulong 8 0
gd_r0 r 3
put r 1 d
put r 6 sr
gd_emit ins meta r 2
end

fn gd_movi ins edit ulong 8192 meta edit ulong 512 d ulong imm ulong to void
r = new ulong 8 0
gd_r0 r 2
put r 1 d
put r 6 and imm 0xffffffff
gd_emit ins meta r 0
end

fn gd_movrz ins edit ulong 8192 meta edit ulong 512 dp ulong to void
r = new ulong 8 0
gd_r0 r 1
put r 1 and dp 0xffff
put r 7 shl shr dp 16 16
gd_emit ins meta r 0
end

fn gd_imadi ins edit ulong 8192 meta edit ulong 512 dp ulong ap ulong imm ulong c ulong to void
r = new ulong 8 0
gd_r0 r 8
put r 1 and dp 0xffff
put r 2 and ap 0xffff
put r 4 c
put r 6 and imm 0xffffffff
put r 7 or shl shr dp 16 16 shl shr ap 16 24
gd_emit ins meta r 0
end

fn gd_imadw ins edit ulong 8192 meta edit ulong 512 d64 ulong a ulong imm ulong c64 ulong to void
r = new ulong 8 0
gd_r0 r 9
put r 1 d64
put r 2 a
put r 4 c64
put r 6 and imm 0xffffffff
gd_emit ins meta r 0
end

fn gd_mov ins edit ulong 8192 meta edit ulong 512 dp ulong ap ulong to void
gd_imadi ins meta dp ap 1 GD_NOREG
end

fn gd_shr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong to void
r = new ulong 8 0
gd_r0 r 17
put r 1 d
put r 2 a
put r 6 imm
gd_emit ins meta r 0
end

fn gd_andi ins edit ulong 8192 meta edit ulong 512 dp ulong ap ulong imm ulong to void
r = new ulong 8 0
gd_r0 r 18
put r 1 and dp 0xffff
put r 2 and ap 0xffff
put r 6 and imm 0xffffffff
put r 7 or shl shr dp 16 16 shl shr ap 16 24
gd_emit ins meta r 0
end

fn gd_i2fp ins edit ulong 8192 meta edit ulong 512 d ulong a ulong to void
r = new ulong 8 0
gd_r0 r 38
put r 1 d
put r 2 a
gd_emit ins meta r 0
end

fn gd_ldg_wide ins edit ulong 8192 meta edit ulong 512 opf ulong d ulong addr64 ulong imm ulong to void
r = new ulong 8 0
op = and opf 0xffff
first = shr opf 16
gd_r0 r op
put r 1 d
put r 2 addr64
put r 5 get meta 384
put r 6 and imm 0xffffffff
k = ulong 3
if ne first 0
k = 2
end
gd_emit ins meta r k
end

fn gd_ldg32 ins edit ulong 8192 meta edit ulong 512 dp ulong addr64 ulong first ulong to void
r = new ulong 8 0
gd_r0 r 11
put r 1 and dp 0xffff
put r 2 addr64
put r 5 get meta 384
put r 7 shl shr dp 16 16
k = ulong 3
if ne first 0
k = 2
end
gd_emit ins meta r k
end

fn gd_ldg_pf ins edit ulong 8192 meta edit ulong 512 op_sb ulong d ulong addr64 ulong imm ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
sb = shr op_sb 16
wt = get meta 4
cw = or gd_cw 4 sb 1 and wt 2 0x2000
put meta 4 or wt 2
put meta 6 or get meta 6 shl 1 sb
cw = or and imm 0xffffffff shl cw 32
b = mul n 8
put ins b and op_sb 0xffff
put ins add b 1 d
put ins add b 2 addr64
put ins add b 3 GD_NOREG
put ins add b 4 GD_NOREG
put ins add b 5 get meta 384
put ins add b 6 cw
put ins add b 7 0
put meta 0 add n 1
end

fn gd_consume meta edit ulong 512 sb ulong to void
m = shl 1 sb
h = get meta 6
put meta 4 or get meta 4 and h m
put meta 6 and h xor m 0xffffffffffffffff
end

fn gd_stg ins edit ulong 8192 meta edit ulong 512 addr64 ulong imm ulong vp ulong to void
r = new ulong 8 0
gd_r0 r 12
put r 2 addr64
put r 3 and vp 0xffff
put r 5 get meta 384
put r 6 and imm 0xffffffff
put r 7 shl shr vp 16 32
gd_emit ins meta r 5
end

fn gd_f2fp ins edit ulong 8192 meta edit ulong 512 dp ulong hip ulong lop ulong to void
r = new ulong 8 0
gd_r0 r 61
put r 1 and dp 0xffff
put r 2 and hip 0xffff
put r 3 and lop 0xffff
put r 7 or or shl shr dp 16 16 shl shr hip 16 24 shl shr lop 16 32
gd_emit ins meta r 0
end

fn gd_bf16x4_widen ins edit ulong 8192 meta edit ulong 512 q ulong w ulong to void
gd_imadi ins meta gd_op q 0 gd_op w 0 65536 GD_NOREG
gd_andi ins meta gd_op q 1 gd_op w 0 0xffff0000
gd_imadi ins meta gd_op q 2 gd_op w 1 65536 GD_NOREG
gd_andi ins meta gd_op q 3 gd_op w 1 0xffff0000
end

fn gd_bf16x4_pack ins edit ulong 8192 meta edit ulong 512 w ulong q ulong to void
gd_f2fp ins meta gd_op w 0 gd_op q 1 gd_op q 0
gd_f2fp ins meta gd_op w 1 gd_op q 3 gd_op q 2
end

fn gd_lds128 ins edit ulong 8192 meta edit ulong 512 d128 ulong addr ulong imm ulong first ulong to void
r = new ulong 8 0
gd_r0 r 58
put r 1 d128
put r 2 addr
put r 6 imm
k = ulong 3
if ne first 0
k = 2
end
gd_emit ins meta r k
end

fn gd_lds32 ins edit ulong 8192 meta edit ulong 512 dp ulong addr ulong first ulong to void
r = new ulong 8 0
gd_r0 r 49
put r 1 and dp 0xffff
put r 2 addr
put r 7 shl shr dp 16 16
k = ulong 3
if ne first 0
k = 2
end
gd_emit ins meta r k
end

fn gd_sts32 ins edit ulong 8192 meta edit ulong 512 addr ulong vp ulong to void
r = new ulong 8 0
gd_r0 r 50
put r 2 addr
put r 3 and vp 0xffff
put r 7 shl shr vp 16 32
gd_emit ins meta r 5
end

fn gd_bar ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
gd_r0 r 48
gd_emit ins meta r 6
end

fn gd_f2 ins edit ulong 8192 meta edit ulong 512 op ulong dp ulong ap ulong bp ulong to void
r = new ulong 8 0
gd_r0 r op
put r 1 and dp 0xffff
put r 2 and ap 0xffff
put r 3 and bp 0xffff
put r 7 or or shl shr dp 16 16 shl shr ap 16 24 shl shr bp 16 32
gd_emit ins meta r 0
end

fn gd_ffma ins edit ulong 8192 meta edit ulong 512 dp ulong ap ulong bp ulong cp ulong to void
r = new ulong 8 0
gd_r0 r 33
put r 1 and dp 0xffff
put r 2 and ap 0xffff
put r 3 and bp 0xffff
put r 4 and cp 0xffff
fl = or shl shr dp 16 16 shl shr ap 16 24
fl = or fl or shl shr bp 16 32 shl shr cp 16 40
put r 7 fl
gd_emit ins meta r 0
end

fn gd_mufu ins edit ulong 8192 meta edit ulong 512 op ulong dp ulong ap ulong to void
r = new ulong 8 0
gd_r0 r op
put r 1 and dp 0xffff
put r 2 and ap 0xffff
put r 7 or shl shr dp 16 16 shl shr ap 16 24
gd_emit ins meta r 2
end

fn gd_shfl_down ins edit ulong 8192 meta edit ulong 512 d ulong a ulong off ulong to void
r = new ulong 8 0
gd_r0 r 42
put r 1 d
put r 2 a
put r 6 off
gd_emit ins meta r 2
end

fn gd_shfl_bfly ins edit ulong 8192 meta edit ulong 512 d ulong a ulong lanes ulong to void
r = new ulong 8 0
gd_r0 r 60
put r 1 d
put r 2 a
put r 6 and lanes 31
gd_emit ins meta r 2
end

fn gd_isetp_ge_u32 ins edit ulong 8192 meta edit ulong 512 a ulong b ulong to void
r = new ulong 8 0
gd_r0 r 28
put r 2 a
put r 3 b
gd_emit ins meta r 1
end

fn gd_bra_if_p0 ins edit ulong 8192 meta edit ulong 512 target ulong to void
r = new ulong 8 0
gd_r0 r 46
here = get meta 0
put r 6 and sub target here 0xffffffff
put r 7 2
gd_emit ins meta r 8
end

fn gd_bra_fwd ins edit ulong 8192 meta edit ulong 512 to ulong
here = get meta 0
r = new ulong 8 0
gd_r0 r 46
put r 6 1
gd_emit ins meta r 8
ret here
end

fn gd_bra_if_p0_fwd ins edit ulong 8192 meta edit ulong 512 to ulong
here = get meta 0
r = new ulong 8 0
gd_r0 r 46
put r 6 1
put r 7 2
gd_emit ins meta r 8
ret here
end

fn gd_patch_bra ins edit ulong 8192 meta edit ulong 512 idx ulong target ulong to void
if ne get meta 5 0
ret
end
b = mul idx 8
old = get ins add b 6
cw = and old 0xffffffff00000000
rel = and sub target idx 0xffffffff
put ins add b 6 or cw rel
end

fn gd_bssy_fwd ins edit ulong 8192 meta edit ulong 512 to ulong
here = get meta 0
r = new ulong 8 0
gd_r0 r 54
put r 6 2
gd_emit ins meta r 9
ret here
end

fn gd_bsync ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
gd_r0 r 55
gd_emit ins meta r 10
end

fn gd_reg_skip ins edit ulong 8192 meta edit ulong 512 to ulong
bs = gd_bssy_fwd ins meta
br = gd_bra_if_p0_fwd ins meta
ret or bs shl br 16
end

fn gd_reg_end ins edit ulong 8192 meta edit ulong 512 rg ulong to void
atp = get meta 0
gd_bsync ins meta
gd_patch_bra ins meta shr rg 16 atp
gd_patch_bra ins meta and rg 0xffff add atp 1
end

fn gd_tail ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
gd_r0 r 45
gd_emit ins meta r 7
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
b = mul n 8
put ins b 46
put ins add b 1 GD_NOREG
put ins add b 2 GD_NOREG
put ins add b 3 GD_NOREG
put ins add b 4 GD_NOREG
put ins add b 5 GD_NOREG
put ins add b 6 0x000fc00000000000
put ins add b 7 0
put meta 0 add n 1
end

fn gd_loop_begin meta edit ulong 512 to void
dp = get meta 7
if ge dp 2
put meta 5 1
ret
end
put meta add 8 dp get meta 0
put meta 7 add dp 1
end

fn gd_loop_end meta edit ulong 512 to void
dp = get meta 7
if eq dp 0
put meta 5 1
ret
end
dp = sub dp 1
put meta 7 dp
st = get meta add 8 dp
en = sub get meta 0 1
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
put meta add 320 mul 2 nl st
put meta add 321 mul 2 nl en
put meta 3 add nl 1
end

fn gd_bfly_sum ins edit ulong 8192 meta edit ulong 512 v ulong t ulong lo ulong hi ulong to void
o = lo
while le o hi
gd_shfl_bfly ins meta t v o
gd_f2 ins meta 30 v v t
o = shl o 1
end
end

fn gd_warp_sum ins edit ulong 8192 meta edit ulong 512 v ulong t ulong to void
o = ulong 16
while ge o 1
gd_shfl_down ins meta t v o
gd_f2 ins meta 30 v v t
o = shr o 1
end
end

fn gd_lane0_sts ins edit ulong 8192 meta edit ulong 512 lane ulong one ulong addr ulong vp ulong to void
gd_isetp_ge_u32 ins meta lane one
rg = gd_reg_skip ins meta
gd_sts32 ins meta addr vp
gd_reg_end ins meta rg
end

fn gd_silu ins edit ulong 8192 meta edit ulong 512 xp ulong t ulong nlog2e ulong fone ulong to void
gd_f2 ins meta 32 t xp nlog2e
gd_mufu ins meta 47 t t
gd_f2 ins meta 30 t t fone
gd_mufu ins meta 40 t t
gd_f2 ins meta 32 xp xp t
end

fn gd_cross_warp_sum ins edit ulong 8192 meta edit ulong 512 slot ulong pa ulong one ulong la ulong to void
pj = gd_v meta 1
b0 = gd_v meta 4
b1 = gd_v meta 4
if ne get meta 5 0
ret
end
gd_sts32 ins meta pa get meta slot
for j ulong 3
jj = add j 1
gd_imadi ins meta pj one mul 4 jj pa
gd_sts32 ins meta pj get meta add slot jj
end
gd_bar ins meta
w2 = ulong 0
while lt w2 8
gd_lds128 ins meta b0 la add 1600 mul w2 512 1
gd_lds128 ins meta b1 la add 1600 mul add w2 1 512 0
for j ulong 4
aj = get meta add slot j
if eq w2 0
gd_f2 ins meta 30 aj gd_op b0 j gd_op b1 j
else
gd_f2 ins meta 30 aj aj gd_op b0 j
gd_f2 ins meta 30 aj aj gd_op b1 j
end
end
w2 = add w2 2
end
end

fn gd_scalars ins edit ulong 8192 meta edit ulong 512 mut ulong to void
put meta 500 gd_v meta 1
put meta 501 gd_v meta 1
put meta 502 gd_v meta 1
put meta 503 gd_v meta 1
if ne get meta 5 0
ret
end
gd_f2 ins meta 30 get meta 500 gd_op get meta 487 0 gd_op get meta 404 1
gd_movi ins meta get meta 501 GD_C_M1
gd_f2 ins meta 32 get meta 501 get meta 500 get meta 501
gd_f2 ins meta 36 get meta 501 get meta 500 get meta 501
gd_movi ins meta get meta 503 GD_C_LOG2E
gd_f2 ins meta 32 get meta 501 get meta 501 get meta 503
gd_mufu ins meta 47 get meta 501 get meta 501
gd_f2 ins meta 30 get meta 501 get meta 501 get meta 406
gd_mufu ins meta 59 get meta 501 get meta 501
gd_movrz ins meta get meta 502
gd_f2 ins meta 37 get meta 502 get meta 500 get meta 502
gd_movi ins meta get meta 394 GD_C_LN2
gd_ffma ins meta get meta 502 get meta 501 get meta 394 get meta 502
if eq mut 1
gd_movi ins meta get meta 488 GD_C_ONE
else
gd_f2 ins meta 32 get meta 488 gd_op get meta 404 0 get meta 502
gd_f2 ins meta 32 get meta 488 get meta 488 get meta 503
gd_mufu ins meta 47 get meta 488 get meta 488
end
if eq mut 2
gd_movi ins meta get meta 489 GD_C_ONE
else
gd_f2 ins meta 32 get meta 489 gd_op get meta 487 1 get meta 405
gd_mufu ins meta 47 get meta 489 get meta 489
gd_f2 ins meta 30 get meta 489 get meta 489 get meta 406
gd_mufu ins meta 40 get meta 489 get meta 489
end
end


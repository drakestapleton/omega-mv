fn tn_ldg ins edit ulong 8192 meta edit ulong 512 opf ulong d ulong addr ulong imm ulong to void
r = new ulong 8 0
tn_r0 edit r and opf 0xffff
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 imm
k = ulong 3
if ne shr opf 16 0
k = 2
end
tn_emit edit ins edit meta view r k
end


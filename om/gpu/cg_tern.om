first = ulong 0
if eq r 0
if eq d 0
first = 1
end
end
dv = get meta add 453 add mul r dlim d
off = add mul r get meta 27 mul d get meta 28
tn_ldg edit ins edit meta tn_op 11 first dv get meta 417 off
d = add d 1
end
r = add r 1
end
end

fn tn_weight_loads ins edit ulong 8192 meta edit ulong 512 to void
if eq get meta 17 0
tn_weight_loads_rm edit ins edit meta
ret
end
dlim = get meta 20
op = ulong 56
if eq get meta 18 4
op = 57
end
d = ulong 0
while lt d dlim
first = ulong 0
if eq d 0
first = 1
end
tn_ldg edit ins edit meta tn_op op first get meta add 453 d get meta 417 mul d get meta 28
d = add d 1
end
end


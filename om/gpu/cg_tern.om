fn tn_spec_ok_i sp view ulong 8 to ulong
k = get sp 0
if eq k 0
ret 0
end
if gt k 16384
ret 0
end
if ne rem k 256 0
ret 0
end
nch = div add k 8191 8192
if ne rem k mul 256 nch 0
ret 0
end
lay = get sp 1
rv = get sp 2
if eq lay 0
ok = ulong 0
if eq rv 1
ok = 1
end
if eq rv 2
ok = 1
end
if eq rv 4
ok = 1
end
if eq ok 0
ret 0
end
else
if eq lay 1
ok = ulong 0
if eq rv 2
ok = 1
end
if eq rv 4
ok = 1
end
if eq ok 0
ret 0
end
else
ret 0
end
end
w = get sp 3
if eq w 0
ret 0
end
if gt w 32
ret 0
end
ksc = div div k nch 256
d = get sp 4
if eq d 0
ret 0
end
if gt d 16
ret 0
end
if ne rem ksc d 0
ret 0
end
if gt mul rv d 16
ret 0
end
epi = get sp 5
if gt epi 1
ret 0
end
if eq epi 1
if ne nch 1
ret 0
end
end
if gt get sp 6 5
ret 0
end
ret 1
end

fn tn_weight_loads_rm ins edit ulong 8192 meta edit ulong 512 to void
rv = get meta 18
dlim = get meta 20

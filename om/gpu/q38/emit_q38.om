note SPDX-License-Identifier: AGPL-3.0-only
note om/gpu/q38/emit_q38.om: Pure Seeded-OM-2 SM121 SASS Kernel Suite for Qwen 3.8 27B Dense
note (64 layers: 48 Gated DeltaNet 16K/48V + 16 Full-Attention 24Q/4KV hd=256, H=5120, I=17408, V=248320).
note Compose after:
note   om/encoder/bw_enc_sm121.om
note   om/gpu/q36/emit_fast.om
note   om/gpu/q36/emit_prefill.om
note
note Reuses unchanged from q36:
note   - qFp8ToW4B32Quant   (on-GPU FP8 -> W4 block-32 quantizer for any K%128, N%32)
note   - qFp8B128GemvFast   (Exact FP8 block-128x128 GEMV, SMEM = 1088 + 4*K <= 96 KiB)
note   - qBf16Gemv1R        (BF16 GEMV for in_proj_a/b [96, 5120])
note   - qGdnConvL2Fast     (Grid=(80,1,1): blk 0..15=Q, 16..31=K, 32..79=V!)
note   - qFaPrepQDecGpu     (Grid=(24,1,1): 24 Q heads, hd=256, 64 RoPE dims!)
note   - qFaReduceGateDec   (Grid=(24,1,1): 24 Q heads Split-K combine + sigmoid(gate)!)
note   - qPreW4GemmHmma     (SM121 HMMA.16816 W4 GEMM for all K=5120/6144/17408, N%64==0!)
note   - qPreLmHeadW4Hmma   (SM121 HMMA.16816 W4 lm_head for batched/speculative!)
note   - qPreBf16GemmBatch  (SM121 HMMA.16816 BF16 GEMM for batched in_proj_a/b!)
note   - qPreFaHmmaPhaseB   (Half-warp online softmax for HMMA FA2!)

note =========================================================================
note Helper: Stage x[K] into SMEM[0..4*K-1] in 1024-float steps (K % 1024 == 0)
note =========================================================================
fn q38StageX128 xPtrReg ulong kReg ulong xOffReg ulong to void
qLit 56 0
qLit 57 1024
mSx = get q36Pc 0
qMad 52 14 4 56
if ne xOffReg QZ
qIadd 52 52 xOffReg
end
qicImm 9 16 52 xPtrReg 4 qAlu4
qic 57 24 16 QZ 0 qcw 2 0 7 0 1
qic 0 QZ QZ QZ 0 qW0
qMad 54 14 4 56
qMad 54 54 4 QZ
qLit 59 4
for j ulong 4
qic 50 QZ 54 add 24 j 0 qSt
qic 0 QZ QZ QZ 0 qW1
if lt j 3
qIadd 54 54 59
end
end
qIadd 56 56 57
qic 28 QZ 56 kReg 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mSx get q36Pc 0 qAlu4
qBar
end

note =========================================================================
note Mode 200: q38W4Gemv4R -- 4-row/warp zero-stall 4x LDG.E.128 W4 block-32 GEMV
note   Streams K in 1024-float chunks through 4 KiB SMEM (100% occupancy for K=5120/6144/17408)!
note Args: x[K] (R0:1), W[N,K/8] u32 (R2:3), S[N,K/64] u32 (R4:5), C[N] (R6:7), K (32), N (36).
note Grid: (ceil(N/32), 1, 1), Block: 256, SMEM: 4128 (4096 x chunk + 8 x_ptr).
note =========================================================================
fn q38W4Gemv4R to void
qStart 4
qParam 20 32
qParam 21 36
note Store x_ptr (R0:1) into SMEM[4096..4103] by thread 0 so R0..R7 hold all 4 row W4 pointers!
qLit 52 4096
qLit 53 4100
qLit 54 1
bXp = qBssy
qic 28 QZ 14 54 0 qCmp
skXp = qBraFwd 1
qic 50 QZ 52 0 0 qSt
qic 50 QZ 53 1 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skXp 1
qBsync bXp
qBar
note Relocate C_ptr (R6:7 -> R8:9), S_ptr (R4:5 -> R16:17), W_ptr (R2:3 -> R12:13)
qicImm 8 8 6 QZ 1 qAlu1
qicImm 8 9 7 QZ 1 qAlu1
qicImm 8 16 4 QZ 1 qAlu1
qicImm 8 17 5 QZ 1 qAlu1
qicImm 8 12 2 QZ 1 qAlu1
qicImm 8 13 3 QZ 1 qAlu4
qic 17 52 14 QZ 5 qAlu4
qic 18 11 14 QZ 31 qAlu4
qMad 18 15 32 QZ
qMad 18 52 4 18
qicImm 8 19 21 QZ 1 qAlu4
qic 17 24 20 QZ 3 qAlu4
qic 17 22 20 QZ 10 qAlu4
qic 17 20 20 QZ 6 qAlu4
qMad 58 11 4 QZ
for r ulong 4
qLit 52 r
qIadd 52 18 52
qMadReg 53 52 24 58
qicImm 9 mul r 2 53 12 4 qAlu4
end
qMad 10 11 128 QZ
qLit 21 0
qLit 23 1
for r ulong 4
qNum add 48 r 0.0f32
end
mLoop = get q36Pc 0
note Stage 1024 floats x[chunk*1024 + tid*4 .. +3] -> SMEM[tid*16 .. +15]
qLit 54 4096
qLit 55 4100
qic 49 52 54 QZ 0 qLd
qic 49 53 55 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qMad 54 21 1024 QZ
qMad 54 14 4 54
qicImm 9 56 54 52 4 qAlu4
qic 57 24 56 QZ 0 qcw 2 0 7 0 1
qic 0 QZ QZ QZ 0 qW0
qMad 54 14 16 QZ
qLit 59 4
for j ulong 4
qic 50 QZ 54 add 24 j 0 qSt
qic 0 QZ QZ QZ 0 qW1
if lt j 3
qIadd 54 54 59
end
end
qBar
note 4-row-per-warp zero-stall 4x LDG.E.128 W4 MAC over SMEM[0..4095]
qic 57 24 0 QZ 0 qcw 2 0 7 0 1
qic 57 28 2 QZ 0 qcw 2 0 7 0 1
qic 57 32 4 QZ 0 qcw 2 0 7 0 1
qic 57 36 6 QZ 0 qcw 2 0 7 0 1
qic 17 60 11 QZ 1 qAlu4
qMad 60 21 16 60
qMadReg 52 18 20 60
qicImm 9 52 52 16 4 qAlu4
qicImm 9 54 20 52 4 qAlu4
qicImm 9 56 20 54 4 qAlu4
qicImm 9 58 20 56 4 qAlu4
qic 11 12 52 QZ 0 qcw 2 0 7 0 1
qic 11 13 54 QZ 0 qcw 2 0 7 0 1
qic 11 15 56 QZ 0 qcw 2 0 7 0 1
qic 11 19 58 QZ 0 qcw 2 0 7 0 1
qic 0 QZ QZ QZ 0 qW0
qic 18 56 11 QZ 1 qAlu4
qic 28 QZ 56 23 0 qCmp
qicImm 8 52 12 QZ 65536 qAlu1
qic 18 53 12 QZ 0xffff0000 qAlu4
put q36Guard 0 1
qicImm 8 52 53 QZ 1 qAlu4
qicImm 8 12 52 QZ 1 qAlu4
qicImm 8 52 13 QZ 65536 qAlu1
qic 18 53 13 QZ 0xffff0000 qAlu4
put q36Guard 0 1
qicImm 8 52 53 QZ 1 qAlu4
qicImm 8 13 52 QZ 1 qAlu4
qicImm 8 52 15 QZ 65536 qAlu1
qic 18 53 15 QZ 0xffff0000 qAlu4
put q36Guard 0 1
qicImm 8 52 53 QZ 1 qAlu4
qicImm 8 15 52 QZ 1 qAlu4
qicImm 8 52 19 QZ 65536 qAlu1
qic 18 53 19 QZ 0xffff0000 qAlu4
put q36Guard 0 1
qicImm 8 52 53 QZ 1 qAlu4
qicImm 8 19 52 QZ 1 qAlu4
qW4MacBlock 10 12 13 15 19
qicImm 9 0 23 0 512 qAlu1
qicImm 9 2 23 2 512 qAlu1
qicImm 9 4 23 4 512 qAlu1
qicImm 9 6 23 6 512 qAlu4
qIadd 21 21 23
qBar
qic 28 QZ 21 22 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mLoop get q36Pc 0 qAlu4
qParam 19 36
for r ulong 4
qWarpRedSum add 48 r 52 16
end
qic 28 QZ 11 23 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
for r ulong 4
qLit 52 r
qIadd 52 18 52
qic 28 QZ 52 19 0 qCmp
skO = qBraFwd 1
qicImm 9 54 52 8 4 qAlu4
qic 12 QZ 54 add 48 r 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skO 1
end
end

note =========================================================================
note Mode 201: q38W4GemmM4 -- 4-token W4 block-32 GEMM streaming K in 1024-elem chunks
note   Supports K % 1024 == 0 (K = 5120, 6144, 17408), N % 8 == 0, B = 4 or 8!
note Args: X_bf16 (R0:1), W_w4 (R2:3), S_bf16 (R4:5), Y_f32 (R6:7),
note       K (32), N (36), xStrU32 (40), xOffU32 (44), yStrF32 (48), yOffF32 (52).
note Grid: (ceil(N/8), B/4, 1), Block: 256, SMEM: 8192 (4 toks x 512 u32 BF16 pairs).
note =========================================================================
fn q38W4GemmM4 to void
qStart 4
qParam 19 32
qParam 22 40
qParam 23 44
qParam 60 48
qParam 61 52
qMad 52 18 4 QZ
qMadReg 23 52 22 23
qMadReg 61 52 60 61

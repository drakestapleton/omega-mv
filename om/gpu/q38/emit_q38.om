qic 17 54 10 QZ 1 qAlu4
qMadReg 52 18 53 54
qicImm 9 16 52 16 4 qAlu4
qic 18 11 10 QZ 1 qAlu4
qLit 13 1
note nChunks = K >> 10 (1024-elem chunks -> 5 for 5120, 6 for 6144, 17 for 17408!)
qic 17 2 19 QZ 10 qAlu4
qLit 3 0
for t ulong 4
qNum add 48 t 0.0f32
end
mChunk = get q36Pc 0
note Stage 4 tokens x 512 u32 BF16 pairs into SMEM[0..8191] (2 iters x 256 threads per token)
for t ulong 4
qLit 52 t
qMadReg 53 52 22 23
qLit 54 0
qLit 56 512
qLit 57 256
mSt = get q36Pc 0
qIadd 58 54 14
qIadd 59 53 58
qicImm 9 20 59 6 4 qW1
qic 11 55 20 QZ 0 qLd
qLit 52 mul t 2048
qMad 58 58 4 52
qic 0 QZ QZ QZ 0 qW0
qic 50 QZ 58 55 0 qSt
qic 0 QZ QZ QZ 0 qW1
qIadd 54 54 57
qic 28 QZ 54 56 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mSt get q36Pc 0 qAlu4
end
qBar
qMad 4 10 64 QZ
qNum 55 -8.0f32
qic 57 24 0 QZ 0 qcw 2 0 7 0 1
qic 11 12 16 QZ 0 qcw 2 0 7 0 1
qic 0 QZ QZ QZ 0 qW0
qic 28 QZ 11 13 0 qCmp
qicImm 8 52 12 QZ 65536 qAlu1
qic 18 53 12 QZ 0xffff0000 qAlu4
put q36Guard 0 1
qicImm 8 52 53 QZ 1 qAlu4
qicImm 8 12 52 QZ 1 qAlu4
for w ulong 4
note Adjust token stride inside SMEM from 4096 -> 2048 B: load from SMEM[R4 + t*2048 + w*16]
qicImm 8 56 add 24 w QZ 1 qAlu4
for t ulong 4
qic 58 28 4 QZ add mul t 2048 mul w 16 qLd
qic 0 QZ QZ QZ 0 qW0
qNum 58 0.0f32
qNum 59 0.0f32
for pair ulong 4
qicImm 8 40 add 28 pair QZ 65536 qAlu1
qic 18 41 add 28 pair QZ 0xffff0000 qAlu4
qic 30 59 59 40 0 qAlu1
qic 30 59 59 41 0 qAlu4
qic 18 42 56 QZ 15 qAlu1
qic 17 43 56 QZ 4 qAlu1
qic 18 43 43 QZ 15 qAlu4
qic 38 42 42 QZ 0 qMufu
qic 38 43 43 QZ 0 qMufu
qic 0 QZ QZ QZ 0 qW0
qic4 33 58 42 40 58 qAlu3
qic4 33 58 43 41 58 qAlu4
if lt pair 3
qic 17 56 56 QZ 8 qAlu4
end
end
qic4 33 58 55 59 58 qAlu4
qic4 33 add 48 t 58 12 add 48 t qAlu4
if lt t 3
qicImm 8 56 add 24 w QZ 1 qAlu4
end
end
end
qicImm 9 0 13 0 512 qAlu1
qicImm 9 16 13 16 64 qAlu1
qLit 52 512
qIadd 23 23 52
qIadd 3 3 13
qBar
qic 28 QZ 3 2 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mChunk get q36Pc 0 qAlu4
for t ulong 4
qWarpRedSum add 48 t 52 16
end
qic 28 QZ 10 13 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
for t ulong 4
qLit 52 t
qMadReg 53 52 60 61
qIadd 53 53 18
qicImm 9 20 53 8 4 qAlu4
qic 12 QZ 20 add 48 t 0 qSt
qic 0 QZ QZ QZ 0 qW1
end
end


ret add get q38PreWorkVa 0 off
end

fn q38InitWorkLayout to bool
cur = ulong 0
put q38SlotOffs QI_X cur
cur = add cur 32768
put q38SlotOffs QI_XN cur
cur = add cur 32768
put q38SlotOffs QI_QKV cur
put q38SlotOffs QI_Z add cur 40960
put q38SlotOffs QI_K add cur 49152
put q38SlotOffs QI_V add cur 53248
cur = add cur 131072
put q38SlotOffs QI_Y cur
cur = add cur 32768
put q38SlotOffs QI_AOUT cur
cur = add cur 32768
put q38SlotOffs QI_AB cur
cur = add cur 4096
put q38SlotOffs QI_GU cur
cur = add cur 262144
put q38SlotOffs QI_SW cur
cur = add cur 131072
put q38SlotOffs QI_ALOG cur
cur = add cur 32768
put q38SlotOffs QI_FNORM cur
cur = add cur 32768
put q38SlotOffs QI_POS cur
cur = add cur 4096
put q38SlotOffs QI_OUT_TOK cur
cur = add cur 4096
put q38SlotOffs QI_LOGW4 cur
cur = add cur 1048576
put q38SlotOffs QI_LOGBF cur
cur = add cur 1048576
put q38SlotOffs QI_CIDS cur
cur = add cur 16384
put q38SlotOffs QI_CLOG cur
cur = add cur 16384
put q38SlotOffs QI_QROT cur
cur = add cur 32768
put q38SlotOffs QI_OPART cur
cur = add cur 262144
put q38SlotOffs QI_MLPART cur
cur = add cur 16384
cur = mul div add cur 4095 4096 4096
put q38SlotOffs QI_PKT cur
ret le add cur 50331648 Q38_WORK_BYTES
end

fn q38Arg u uint to void
n = get q38BindN 0
put q38Bind n u
put q38BindN 0 add n 1
end

fn q38Ptr va ulong to void
q38Arg gblo va
q38Arg gbhi va
end

fn q38PktStartAt off ulong to void
put q38PktOff 0 off
put q38PktPos 0 0
put q38BindN 0 0
put gbused 0 0
gbsetup
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
cb = mapaddr get gbmem 1
gbdriver cb
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
n = get gbused 0
r = mapwrite get q38Work 0 off gbcmd 0 n
put q38PktPos 0 n
end

fn q38PktStart to void
q38PktStartAt add q38O QI_PKT 25165824
end

fn q38PrepQmdGy kid ulong gx uint gy uint bx uint to void
gbqmd 1
a = add mapaddr get q38CodeMap 0 get q38Entry kid
put gbq1 32 gblo shr a 4
put gbq1 33 or uint and shr a 36 2097151 20971520
put gbq1 59 gblo shr a 8
put gbq1 34 or uint 65536 bx
rg = get q38Regs kid
if eq rg 0
rg = ulong 64
end
put gbq1 35 or uint 131073 shl uint rg 8
sm = get q38Smem kid
s7 = ulong 8
if ne sm 0
s7 = div add sm 127 128
end
sc = ulong 9
if gt sm 8192
sc = ulong 17
end
if gt sm 16000
sc = ulong 26
end
w36 = or or or shl sc 23 shl ulong 26 17 shl sc 11 s7
put gbq1 36 uint w36
put gbq1 37 0
put gbq1 39 gx
put gbq1 40 gy
put gbq1 41 1
put gbcb 216 bx
put gbcb 220 gx
put gbcb 221 gy
put gbcb 222 1
end

fn q38PktEmitGy kid ulong gx uint gy uint bx uint to bool
q38PrepQmdGy kid gx gy bx
cb = mapaddr get gbmem 1
words = get q38BindN 0
endva = add cb add 896 mul words 4
put gbcb 212 gbhi endva
put gbcb 213 gblo endva
put gbused 0 0
gbdma add cb 896 uint words
for j ulong words
gbemit get q38Bind j
end
q = mapaddr get gbmem 2
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
gbrel add mapaddr get gbmem 3 32 6
put q38BindN 0 0
n = get gbused 0
pos = get q38PktPos 0
if gt add pos n 4000000
ret false
end
dstOff = add get q38PktOff 0 pos
if ne mapwrite get q38Work 0 dstOff gbcmd 0 n long n
ret false
end
put q38PktPos 0 add pos n
ret true
end

fn q38PktFinish slot ulong to bool
put gbused 0 0
gbtail
n = get gbused 0
pos = get q38PktPos 0
dstOff = add get q38PktOff 0 pos
if ne mapwrite get q38Work 0 dstOff gbcmd 0 n long n
ret false
end
put q38SlotOff slot get q38PktOff 0
put q38SlotLen slot add pos n
ret true
end

fn q38WaitFast timeout ulong to bool
for sp ulong 50000
if eq mapget get gbmem 3 16 4 1179010630
put nvret 0 get nvput 0
ret true
end
end
t0 = monons
while lt ulong sub monons t0 timeout bound 5000000
if eq mapget get gbmem 3 16 4 1179010630
put nvret 0 get nvput 0
ret true
end
r = sleepns long 5000
end
ret false
end

fn q38KickPre slot ulong to bool
r0 = mapset get gbmem 2 8192 4 0
r1 = mapset get gbmem 3 0 4 0
r2 = mapset get gbmem 3 16 4 0
off = get q38SlotOff slot
ln = get q38SlotLen slot
ret nvsend get q38Work 0 off uint div ln 4
end

fn q38ReplayPre slot ulong to bool
if not q38KickPre slot
ret false
end
if not q38WaitFast 30000000000
ret false
end
ret eq mapget get gbmem 3 0 4 1145324612
end

fn q38PktRun to bool
put gbused 0 0
gbtail
n = get gbused 0
pos = get q38PktPos 0
dstOff = add get q38PktOff 0 pos
if ne mapwrite get q38Work 0 dstOff gbcmd 0 n long n
ret false
end
tot = add pos n
r0 = mapset get gbmem 2 8192 4 0
r1 = mapset get gbmem 3 0 4 0
r2 = mapset get gbmem 3 16 4 0
if not nvsend get q38Work 0 get q38PktOff 0 uint div tot 4
ret false
end
if not q38WaitFast 30000000000
ret false
end
ret eq mapget get gbmem 3 0 4 1145324612
end

fn q38Exp f f32 to f32
x = f
if gt x f32 80.0f32
x = f32 80.0f32
end
if lt x f32 -80.0f32
x = f32 -80.0f32
end
k = int mul x f32 1.4426950408889634f32
r = sub x mul f32 k f32 0.6931471805599453f32
p = f32 1.0f32
term = f32 1.0f32
for i ulong 8
term = div mul term r f32 add i 1
p = add p term
end
if ge k 0
for i ulong ulong k bound 128
p = mul p f32 2.0f32
end
else
for i ulong ulong neg k bound 128
p = mul p f32 0.5f32
end
end
ret p
end

fn q38Exp64 x f64 to f64
k = long mul x f64 1.4426950408889634f64
r = sub x mul f64 k f64 0.6931471805599453f64
p = f64 1.0f64
term = f64 1.0f64
for i ulong 14
term = div mul term r f64 add i 1
p = add p term
end
if ge k 0
for i ulong ulong k bound 1024
p = mul p f64 2.0f64
end
else
for i ulong ulong neg k bound 1024
p = mul p f64 0.5f64
end
end
ret p
end

fn q38SinCore x f64 to f64
x2 = mul x x
s = x
t = x
for i ulong 7
k0 = add mul i 2 2
t = div mul neg t x2 mul f64 k0 f64 add k0 1
s = add s t
end
ret s
end

fn q38SinCos64 theta f64 isCos bool to f64
tp = f64 6.283185307179586f64
pi = f64 3.141592653589793f64
hp = f64 1.570796326794896f64
x = sub theta mul f64 long div theta tp tp
if gt x pi
x = sub x tp
end
if lt x neg pi
x = add x tp
end
if isCos
x = add x hp
if gt x pi
x = sub x tp
end
end
sgn = f64 1.0f64
if gt x hp
x = sub pi x
end
if lt x neg hp
x = sub neg pi x
end
if lt x f64 0.0f64
x = neg x
sgn = f64 -1.0f64
end
ret mul sgn q38SinCore x
end

fn q38InitRopeFreq to void
ln10m = f64 16.11809565095832f64
for i ulong 32
e = div mul neg f64 mul i 2 ln10m f64 64.0f64
put q38RopeFreq i q38Exp64 e
end
end

fn q38PutU32Io off ulong w uint to void
put q38IoBuf off uchar and w 255
put q38IoBuf add off 1 uchar and shr w 8 255
put q38IoBuf add off 2 uchar and shr w 16 255
put q38IoBuf add off 3 uchar and shr w 24 255
end

fn q38FillRopeRow base ulong p ulong to void
for d ulong 32
th = mul f64 p get q38RopeFreq d
cw = bitcast uint f32 q38SinCos64 th true
sw = bitcast uint f32 q38SinCos64 th false
q38PutU32Io add base mul d 4 cw
q38PutU32Io add base add 128 mul d 4 sw
end
end

fn q38UploadRope128K to bool
pos = ulong 0
while lt pos Q38_MAX_T bound 128
for t ulong 1024
q38FillRopeRow mul t 256 add pos t
end
if ne mapwrite get q38RopeMap 0 mul pos 256 q38IoBuf 0 262144 262144
ret false
end
pos = add pos 1024
end
ret true
end

fn q38BuildFp8Lut to bool
m = nvalloc 4096 true
if le m 0
ret false
end
put q38Lut 0 m
for i ulong 256
s = and shr i 7 1
e = and shr i 3 15
mn = and i 7
v = f32 0.0f32
if eq e 15
if eq mn 7
v = f32 0.0f32
else
v = mul f32 256.0f32 add f32 1.0f32 div f32 mn f32 8.0f32
end
else
if eq e 0
v = mul f32 0.015625f32 div f32 mn f32 8.0f32
else
pw = f32 1.0f32
if ge e 7
for k ulong sub e 7 bound 16
pw = mul pw f32 2.0f32
end
else
for k ulong sub 7 e bound 16
pw = mul pw f32 0.5f32
end
end
v = mul pw add f32 1.0f32 div f32 mn f32 8.0f32
end
end
if eq s 1
v = neg v
end
w = bitcast uint v
p = mul i 4
put q38IoBuf p uchar and w 255
put q38IoBuf add p 1 uchar and shr w 8 255
put q38IoBuf add p 2 uchar and shr w 16 255
put q38IoBuf add p 3 uchar and shr w 24 255
end
ret eq mapwrite m 0 q38IoBuf 0 1024 1024
end

fn q38BuildPath suf view uchar * layIdx long to ulong
dlen = get q38DirLen 0
for i ulong dlen bound 256
put q38PathBuf i get q38DirBuf i
end
pos = dlen
for i ulong len suf bound 64
put q38PathBuf pos get suf i
pos = add pos 1
end
if ge layIdx 0
if ge layIdx 10
put q38PathBuf pos uchar add 48 div ulong layIdx 10
pos = add pos 1
put q38PathBuf pos uchar add 48 rem ulong layIdx 10
pos = add pos 1
else
put q38PathBuf pos uchar add 48 ulong layIdx
pos = add pos 1
end
for i ulong len q38SufSt bound 32
put q38PathBuf pos get q38SufSt i
pos = add pos 1
end
end
put q38PathBuf pos 0
ret pos
end

fn q38ReadHdrOff fd int to ulong
if ne pread fd q38IoBuf 0 8 0 8
ret 0
end
v = ulong 0
for i ulong 8
v = or v shl ulong get q38IoBuf i mul i 8
end
ret add v 8
end

fn q38StreamToMap fd int foff ulong m long moff ulong bytes ulong to bool
pos = ulong 0
while lt pos bytes bound 3000
want = sub bytes pos
if gt want 1048576
want = ulong 1048576
end
got = pread fd q38IoBuf 0 want long add foff pos
if le got 0
ret false
end
if ne mapwrite m add moff pos q38IoBuf 0 ulong got got
ret false
end
pos = add pos ulong got
end
ret true
end

fn q38WidenBuf cnt ulong to void
for i ulong cnt bound 131072
p = mul i 2
q = mul i 4
put q38ScaleOut q 0
put q38ScaleOut add q 1 0
put q38ScaleOut add q 2 get q38IoBuf p
put q38ScaleOut add q 3 get q38IoBuf add p 1
end
end

fn q38WidenLayerScales fd int foff ulong L ulong bf16Bytes ulong to bool
pos = ulong 0
sbase = mul L Q38_SCALE_STRIDE
sm = get q38ScaleMap 0
while lt pos bf16Bytes bound 32
want = sub bf16Bytes pos
if gt want 262144
want = ulong 262144
end
got = pread fd q38IoBuf 0 want long add foff pos
if ne got long want
ret false
end
q38WidenBuf div want 2
outBytes = mul want 2
dstOff = add sbase mul pos 2
if ne mapwrite sm dstOff q38ScaleOut 0 outBytes long outBytes
ret false
end
pos = add pos want
end
ret true
end


fn q38LoadLayer L ulong to bool
isFa = eq rem L 4 3
n = q38BuildPath q38SufLay long L
fd = int fopen q38PathBuf 0 n 0 0
if lt fd 0
ret false
end
dataOff = q38ReadHdrOff fd
if eq dataOff 0
c0 = fclose fd
ret false
end
bfBytes = G38_BF16_BYTES
payBytes = G38_PAYLOAD
if isFa
bfBytes = F38_BF16_BYTES
payBytes = F38_PAYLOAD
end
if not q38WidenLayerScales fd dataOff L bfBytes
c1 = fclose fd
ret false
end
if not isFa
if not q38PrepGdnAlog L fd dataOff
c2 = fclose fd
ret false
end
end
if eq get q38UseW4 0 0
slab = get q38SlabMap div L 8
moff = mul rem L 8 Q38_FP8_LSTRIDE
ok = q38StreamToMap fd dataOff slab moff payBytes
c6 = fclose fd
ret ok
end
if not q38StreamToMap fd dataOff get q38TmpSlab 0 0 payBytes
c7 = fclose fd
ret false
end
c8 = fclose fd
ret q38QuantLayerW4 L isFa
end


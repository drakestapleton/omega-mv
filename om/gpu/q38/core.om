ret false
end
if not q38StreamToMap fd add dataOff add MTP_FC_BYTES MTP_BF16_BYTES get q38TmpSlab 0 F38_DN_W MTP_FP8_BYTES
rc = fclose fd
ret false
end
rc = fclose fd
if not q38QuantMtpFa wVa sVa
ret false
end
put q38MtpReady 0 1
q38Print q38MsgMtpLoad
q38PrintU div sub ulong monons t0 1000000
q38Print q38MsgNl
ret true
end


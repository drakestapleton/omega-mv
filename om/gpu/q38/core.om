ret q38SpecEmitVerifyPkt M
end

fn q38LoadEmbedToAout tid ulong to bool
off = mul tid 10240
if ne mapread get q38EmbBf16 0 off q38IoBuf 0 10240 10240
ret false
end
q38WidenBuf Q38_H
ret eq mapwrite get q38Work 0 q38O QI_AOUT q38ScaleOut 0 20480 20480
end

fn q38MtpReadTopTok to ulong
if ne mapread get q38Work 0 q38O QI_CIDS q38IoBuf 0 208 208
ret 999999
end
for i ulong 52
put q38CandIds i q38GetU32Io mul i 4
end
if ne mapread get q38Work 0 q38O QI_CLOG q38IoBuf 0 208 208
ret 999999
end
bestIdx = ulong 0
bestVal = f32 -1000000000.0f32
for i ulong 52
v = bitcast f32 q38GetU32Io mul i 4
if gt v bestVal
bestVal = v
bestIdx = i
end
end
ret ulong get q38CandIds bestIdx
end

fn q38MtpDraftChain curTok ulong pos0 ulong M ulong to bool
put q38SpecDraft 0 curTok
for s ulong sub M 1 bound 16
if not q38LoadEmbedToAout get q38SpecDraft s
ret false
end
if not q38SetPos add pos0 s
ret false
end
if not q38ReplayPre 7
ret false
end
d = q38MtpReadTopTok
if eq d 999999
ret false
end
put q38SpecDraft add s 1 d
end
ret true
end

fn q38GetU32Scale p ulong to uint
b0 = uint get q38ScaleOut p
b1 = shl uint get q38ScaleOut add p 1 8
b2 = shl uint get q38ScaleOut add p 2 16
b3 = shl uint get q38ScaleOut add p 3 24
ret or or b0 b1 or b2 b3
end

fn q38SpecReadPreds M ulong to bool
nb = mul M 512
if ne mapread get q38PreWork 0 QP_CIDS q38IoBuf 0 nb long nb
ret false
end
for t ulong M bound 8
base = mul t 512
for j ulong 128
put q38CandIds j q38GetU32Io add base mul j 4
end
if ne mapread get q38PreWork 0 add QP_CLOG base q38ScaleOut 0 512 512
ret false
end
bestId = ulong get q38CandIds 0
bestLog = f32 -1000000000.0f32
for j ulong 128
v = bitcast f32 q38GetU32Scale mul j 4
if gt v bestLog
bestLog = v
bestId = ulong get q38CandIds j
end
end
put q38SpecPred t bestId
end
ret true
end

fn q38SpecRollbackGdn acc ulong to bool
sva = get q38SpecSnapVa 0
q38PktStart
if not q38EmitCopyU32 add sva QSP_GDN_STATE get q38GdnStateVa 0 150994944
ret false
end
if not q38EmitCopyU32 add sva QSP_GDN_TAIL get q38GdnTailVa 0 5898240
ret false
end
gdnIdx = ulong 0
for L ulong Q38_LAYERS
if ne rem L 4 3
sVa = q38LayerSVa L
if not q38EmitCopyU32 add sva add QSP_QKV mul gdnIdx 524288 q38P QP_QKV mul acc 65536
ret false
end
if not q38EmitCopyU32 add sva add QSP_AB mul gdnIdx 3072 q38P QP_AB mul acc 384
ret false
end
q38Ptr q38P QP_QKV
q38Ptr add sVa mul G38_CONV 2
q38Ptr add get q38GdnTailVa 0 mul gdnIdx 122880
q38Arg uint acc
if not q38PktEmitGy 23 80 1 128
ret false
end
q38Ptr q38P QP_AB
q38Ptr add q38W QI_ALOG mul gdnIdx 384
q38Ptr q38P QP_DB
if not q38PktEmitGy 24 uint acc 1 64
ret false
end
q38Ptr q38P QP_QKV
q38Ptr q38P QP_DB
q38Ptr add get q38GdnStateVa 0 mul gdnIdx 3145728
q38Ptr q38P QP_YRAW
q38Arg uint acc
if not q38PktEmitGy 25 48 4 256
ret false
end
gdnIdx = add gdnIdx 1
end
end
ret q38PktRun
end

fn q38SpecVerifyStep M ulong pos0 ulong to ulong
for t ulong M bound 8
q38PutU32Io mul t 4 uint get q38SpecDraft t
end
if ne mapwrite get q38PreWork 0 QP_TOKS q38IoBuf 0 mul M 4 long mul M 4
ret 0
end
if not q38SetPos pos0
ret 0
end
if not q38ReplayPre 9
ret 0
end
if not q38SpecReadPreds M
ret 0
end
acc = ulong 1
for k ulong sub M 1 bound 8
if eq get q38SpecPred k get q38SpecDraft add k 1
acc = add k 2
else
break
end
end
if lt acc M
if not q38SpecRollbackGdn acc
ret 0
end
end
ret acc
end

fn q38MtpCopyMainHid acc ulong to bool
off = add QP_X mul sub acc 1 20480
if ne mapread get q38PreWork 0 off q38IoBuf 0 20480 20480
ret false
end
ret eq mapwrite get q38Work 0 q38O QI_X q38IoBuf 0 20480 20480
end

fn q38MtpWarmFromPre ntok ulong to bool
if or le ntok 1 gt ntok 128
ret true
end
note Save h_main(ntok-1) currently in QI_X -> QP_YRAW, warm MTP KV for p=0..ntok-2, then restore QI_X!
if ne mapread get q38Work 0 q38O QI_X q38IoBuf 0 20480 20480
ret false
end
if ne mapwrite get q38PreWork 0 QP_YRAW q38IoBuf 0 20480 20480
ret false
end
doAdd = uint 1
if le ntok 8
doAdd = uint 0
end
for p ulong sub ntok 1 bound 128
if not q38LoadEmbedToAout ulong get q38TokSeq add p 1
ret false
end
if not q38SetPos p
ret false
end
q38PktStart
if not q38EmitCopyU32 add q38P QP_X mul p 20480 q38W QI_X 20480
ret false
end
if eq doAdd 1
q38Ptr q38W QI_X
q38Ptr add q38P QP_AOUT mul p 20480
q38Ptr q38W QI_FNORM
q38Ptr q38W QI_XN
q38Arg 1
if not q38PktEmitGy 5 1 1 256
ret false
end
end
if not q38PktRun
ret false
end
if not q38ReplayPre 8
ret false
end
end
if ne mapread get q38PreWork 0 QP_YRAW q38IoBuf 0 20480 20480
ret false
end
ret eq mapwrite get q38Work 0 q38O QI_X q38IoBuf 0 20480 20480
end

fn q38RecordAllPackets to bool
note Slot 0: 64L decode + Exact Two-Pass lm_head
q38PktStartAt q38O QI_PKT
if not q38EmitAll64Layers
ret false
end
if not q38EmitFinalHead
ret false
end
if not q38PktFinish 0
ret false
end
note Slot 1: 64L decode only (sequential prefill fallback)
q38PktStartAt add q38O QI_PKT 4194304
if not q38EmitAll64Layers
ret false
end
if not q38PktFinish 1
ret false
end
note Slot 2: 64L ZOS async self-advancing decode + GPU argmax->embed->pos++
q38PktStartAt add q38O QI_PKT 8388608
if not q38EmitAll64Layers
ret false
end
if not q38EmitFinalHead
ret false
end
if not q38EmitArgmaxEmbed
ret false
end
if not q38PktFinish 2
ret false
end
if eq get q38UseW4 0 1
note Slot 3: 64L HMMA Tensor-Core chunked prefill B=512 (no head)
q38PktStartAt add q38O QI_PKT 12582912
if not q38PreEmitAll64W4 512 false false
ret false
end
if not q38PktFinish 3
ret false
end
note Slot 4: 64L HMMA Tensor-Core chunked prefill B=512 + final exact head
q38PktStartAt add q38O QI_PKT 16777216
if not q38PreEmitAll64W4 512 false false
ret false
end
if not q38PreEmitFinalHead 512
ret false
end
if not q38PktFinish 4
ret false
end
note Slot 5: 64L Continuous Batch-4 / Spec-4 (q38W4GemmM4 + Split-K S=16 HMMA FA2 + batched head!)
q38PktStartAt add q38O QI_PKT 29360128
if not q38PreEmitAll64W4 4 true true
ret false
end
if not q38PreEmitFinalHead 4
ret false
end
if not q38PktFinish 5
ret false
end
note Slot 6: 64L Continuous Batch-8 / Spec-8 (q38W4GemmM4 + Split-K S=16 HMMA FA2 + batched head!)
q38PktStartAt add q38O QI_PKT 33554432
if not q38PreEmitAll64W4 8 true true
ret false
end
if not q38PreEmitFinalHead 8
ret false
end
ret q38PktFinish 6
end
ret true
end

fn q38SetPos pos ulong to bool
w = uint pos
put q38IoBuf 0 uchar and w 255
put q38IoBuf 1 uchar and shr w 8 255
put q38IoBuf 2 uchar and shr w 16 255
put q38IoBuf 3 uchar and shr w 24 255
ret eq mapwrite get q38Work 0 q38O QI_POS q38IoBuf 0 4 4
end

fn q38ReadOutTok to ulong
if ne mapread get q38Work 0 q38O QI_OUT_TOK q38IoBuf 0 4 4
ret 999999
end
b0 = uint get q38IoBuf 0
b1 = shl uint get q38IoBuf 1 8
b2 = shl uint get q38IoBuf 2 16
b3 = shl uint get q38IoBuf 3 24
ret ulong or or b0 b1 or b2 b3
end

fn q38ReadBestFromCands to ulong
if ne mapread get q38Work 0 q38O QI_CIDS q38IoBuf 0 512 512
ret 999999
end
for i ulong 128
put q38CandIds i q38GetU32Io mul i 4
end
if ne mapread get q38Work 0 q38O QI_CLOG q38IoBuf 0 512 512
ret 999999
end
bestIdx = ulong 0
bestVal = f32 -1000000000.0f32
for i ulong 128
v = bitcast f32 q38GetU32Io mul i 4
put q38CandLog i v
if gt v bestVal
bestVal = v
bestIdx = i
end
end
ret ulong get q38CandIds bestIdx
end

fn q38PrefillChunk off ulong cnt ulong pos0 ulong needHead bool to bool
if eq cnt 0
ret true
end
for i ulong cnt bound 512
q38PutU32Io mul i 4 get q38TokSeq add off i
end
if ne mapwrite get q38PreWork 0 QP_TOKS q38IoBuf 0 mul cnt 4 long mul cnt 4
ret false
end
if not q38SetPos pos0
ret false
end
q38PktStart
q38Ptr q38P QP_TOKS
q38Ptr mapaddr get q38EmbBf16 0
q38Ptr q38P QP_X
if not q38PktEmitGy 33 uint cnt 1 256
ret false
end
if not q38PktRun
ret false
end
if eq cnt 512
if needHead
ret q38ReplayPre 4
end
ret q38ReplayPre 3
end
q38PktStart
if not q38PreEmitAll64W4 uint cnt false false
ret false
end
if needHead
if not q38PreEmitFinalHead uint cnt
ret false
end
end
ret q38PktRun
end

fn q38PrefillSeq ntok ulong to ulong
q38ResetState
if eq get q38UseW4 0 1
if gt ntok 4
pos = ulong 0
while lt pos ntok bound 300
remN = sub ntok pos
cnt = remN
if gt cnt 512
cnt = ulong 512
end
isLast = eq add pos cnt ntok
if not q38PrefillChunk pos cnt pos isLast
ret 999999
end
pos = add pos cnt
end
put q38CurPos 0 ntok
ret q38ReadBestFromCands
end
end
for i ulong ntok bound 2048
if not q38LoadEmbed ulong get q38TokSeq i
ret 999999
end
if not q38SetPos i
ret 999999
end
if eq add i 1 ntok
if not q38ReplayPre 0
ret 999999
end
else
if not q38ReplayPre 1
ret 999999
end
end
end
put q38CurPos 0 ntok
ret q38ReadBestFromCands
end

fn q38GpuInit to int
if not q38InitWorkLayout
ret 1
end
if not gbopen 1
ret 2
end
if not gbbopen
ret 3
end
put q38CodeMap 0 0
q38EmitAll
csize = mul div add get q38CodePos 0 4095 4096 4096
cm = nvalloc csize false
if le cm 0
ret 4
end
put q38CodeMap 0 cm
put q38CodeFail 0 0
q38EmitAll
if ne get q38CodeFail 0 0
ret 5
end
if not q38BuildFp8Lut
ret 6
end
put q38Work 0 nvalloc Q38_WORK_BYTES true
if le get q38Work 0 0
ret 7
end
put q38WorkVa 0 mapaddr get q38Work 0
put q38PreWork 0 nvalloc Q38_PRE_BYTES true
if le get q38PreWork 0 0
ret 7
end
put q38PreWorkVa 0 mapaddr get q38PreWork 0
put q38LmBf16 0 nvalloc Q38_LM_BYTES true
if le get q38LmBf16 0 0
ret 8
end
put q38EmbBf16 0 nvalloc Q38_LM_BYTES true
if le get q38EmbBf16 0 0
ret 8
end
put q38LmW4 0 nvalloc 720000000 true
if le get q38LmW4 0 0
ret 9
end
put q38LmW4Va 0 mapaddr get q38LmW4 0
put q38ScaleMap 0 nvalloc Q38_SCALE_BYTES true
if le get q38ScaleMap 0 0
ret 10
end
put q38ScaleVa 0 mapaddr get q38ScaleMap 0
put q38RopeMap 0 nvalloc 33554432 true
if le get q38RopeMap 0 0
ret 10
end
put q38RopeVa 0 mapaddr get q38RopeMap 0
put q38GdnStateMap 0 nvalloc 150994944 true
if le get q38GdnStateMap 0 0
ret 10
end
put q38GdnStateVa 0 mapaddr get q38GdnStateMap 0
put q38GdnTailMap 0 nvalloc 5898240 true
if le get q38GdnTailMap 0 0
ret 10
end
put q38GdnTailVa 0 mapaddr get q38GdnTailMap 0
for fi ulong Q38_FA_N
km = nvalloc 1073741824 true
if le km 0
ret 11
end
put q38KvMap fi km
put q38KvVa fi mapaddr km
end
if eq get q38UseW4 0 1
for s ulong 4
sm = nvalloc Q38_W4_SLAB true
if le sm 0
ret 12
end
put q38SlabMap s sm
put q38SlabVa s mapaddr sm
end
put q38TmpSlab 0 nvalloc 402653184 true
if le get q38TmpSlab 0 0
ret 12
end
put q38TmpSlabVa 0 mapaddr get q38TmpSlab 0
if eq get q38UseMtp 0 1
put q38MtpW4Map 0 nvalloc Q38_MTP_W4_BYTES true
if le get q38MtpW4Map 0 0
ret 12
end
put q38MtpW4Va 0 mapaddr get q38MtpW4Map 0
put q38MtpKvMap 0 nvalloc 1073741824 true
if le get q38MtpKvMap 0 0
ret 12
end
put q38MtpKvVa 0 mapaddr get q38MtpKvMap 0
put q38SpecSnapMap 0 nvalloc Q38_SNAP_BYTES true
if le get q38SpecSnapMap 0 0
ret 12
end
put q38SpecSnapVa 0 mapaddr get q38SpecSnapMap 0
end
else
for s ulong 8
sm = nvalloc Q38_FP8_SLAB true
if le sm 0
ret 12
end
put q38SlabMap s sm
put q38SlabVa s mapaddr sm
end
end
ret 0
end

fn q38LoadAll to int
q38Print q38MsgLoad
t0 = ulong monons
if not q38UploadRope128K
ret 13
end
if not q38LoadOutside
ret 14
end
for L ulong Q38_LAYERS
if not q38LoadLayer L
ret 15
end
end
if not q38RecordAllPackets
ret 16
end
if eq get q38UseMtp 0 1
mVal = get q38MtpM 0
if eq mVal 0
mVal = ulong 5
put q38MtpM 0 5
end
if q38LoadMtpW4
if not q38MtpRecordPackets mVal
ret 17
end
end
end
t1 = ulong monons
q38Print q38MsgLoaded
q38PrintU div sub t1 t0 1000000
q38Print q38MsgNl
ret 0
end

fn q38ParseArgU idx ulong to ulong
b = new uchar 32 0
n = argread idx b 0 30
if le n 0
ret 0
end
v = ulong 0
for i ulong ulong n bound 20
c = get b i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
end
ret v
end

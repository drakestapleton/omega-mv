fn q38Print s view uchar * to void
r = write 1 s 0 len s
end

fn q38PrintU x ulong to void
if eq x 0
put q38Dig 0 48
r = write 1 q38Dig 0 1
ret
end
v = x
p = ulong 32
while gt v 0 bound 24
p = sub p 1
put q38Dig p uchar add 48 rem v 10
v = div v 10
end
r = write 1 q38Dig p sub 32 p
end

fn q36Write w view ulong 4 to void
p = get q38CodePos 0
b = new uchar 16 0
if gt get q38CodeMap 0 0
for i ulong 16
ww = get w div i 4
sh = mul rem i 4 8
put b i uchar and shr ww sh 255
end
if ne mapwrite get q38CodeMap 0 p b 0 16 16
put q38CodeFail 0 1
end
end
put q38CodePos 0 add p 16
end

fn q38RegKernel kid ulong src ulong mode uchar smem ulong to void
p = mul div add get q38CodePos 0 255 256 256
put q38Entry kid p
put q38Smem kid smem
put q38Regs kid 64
put q38CodePos 0 p
put q36Pc 0 0
put q36Guard 0 0
if eq src 0
if not q36Kernel mode
exit 4
end
else
if eq src 1
if not q36PreKernel mode
exit 4
end
else
if not q38Kernel mode
exit 4
end
end
end
q36Done
end

fn q38EmitAll to void
put q38CodePos 0 0
note 0: q38W4Gemv4R (Zero-I2F overlapped 4 KiB streaming SMEM W4 GEMV)
q38RegKernel 0 2 200 4128
note 1: q38W4GemmM4 (legacy fallback)
q38RegKernel 1 2 201 8192
note 2: qFp8B128GemvFast (K=5120 -> 21568 B SMEM)
q38RegKernel 2 0 98 21568
note 3: qFp8B128GemvFast (K=6144 -> 25664 B SMEM)
q38RegKernel 3 0 98 25664
note 4: qFp8B128GemvFast (K=17408 -> 70720 B SMEM, dynamic 100 KiB QMD carveout!)
q38RegKernel 4 0 98 70720
note 5: q38RmsNormAdd (H=5120)
q38RegKernel 5 2 202 64
note 6: q38SwiGlu (I=17408)
q38RegKernel 6 2 203 0
note 7: q38SwiGluBf16 (I=17408 -> BF16)
q38RegKernel 7 2 204 1024
note 8: q38GdnStepRealBf16 (48V/16K, 30 KiB SMEM)
q38RegKernel 8 2 205 31744
note 9: qGdnConvL2Fast (Grid=(80,1,1))
q38RegKernel 9 0 114 64
note 10: q38Bf16Gemv1R (in_proj_a/b [96, 5120])
q38RegKernel 10 2 222 20480
note 11: q38FaPrepKvGpu (4 KV heads)
q38RegKernel 11 2 206 1088
note 12: qFaPrepQDecGpu (24 Q heads)
q38RegKernel 12 0 128 1088
note 13: q38FaAttendSplitF32 (24Q/4KV, S=8)
q38RegKernel 13 2 207 0
note 14: qFaReduceGateDec (24 Q heads)
q38RegKernel 14 0 130 0
note 15: qFp8ToW4B32Quant (on-GPU FP8->W4 quant, SMEM=1024 LUT)
q38RegKernel 15 0 121 1024
note 16: q38Bf16ToW4Quant (on-GPU BF16->W4 lm_head quant)
q38RegKernel 16 2 208 0
note 17: vocab_chunk_top64 (64 chunks -> 128 cands)
q38RegKernel 17 0 112 2048
note 18: q38Bf16RescoreCands (H=5120)
q38RegKernel 18 2 209 0
note 19: q38ArgmaxEmbedStep (H=5120)
q38RegKernel 19 2 210 512
note 20: q38PreRmsNormBf16 (H=5120 -> BF16)
q38RegKernel 20 2 211 1088
note 21: qPreW4GemmHmma (legacy 32-tok HMMA W4 GEMM)
q38RegKernel 21 1 132 2048
note 22: q38PreBf16GemmBatch (SM121 HMMA.16816 BF16 GEMM, K=5120)
q38RegKernel 22 2 224 2048
note 23: q38PreGdnConvBatch (10240 ch)
q38RegKernel 23 2 212 64
note 24: q38PreGdnPrepL2Db (48V)
q38RegKernel 24 2 213 0
note 25: q38PreGdnStepBatch (48V/16K zero-barrier warp-resident)
q38RegKernel 25 2 214 0
note 26: q38PreGdnNormGateBf16 (48V -> BF16)
q38RegKernel 26 2 215 544
note 27: q38PreFaPrepKvBatch (4KV)
q38RegKernel 27 2 216 1088
note 28: q38PreFaPrepQBatch (24Q -> Q_rot_bf16)
q38RegKernel 28 2 217 1088
note 29: q38PreFaAttendBatch (24Q/4KV HMMA FA2)
q38RegKernel 29 2 218 20736
note 30: q38PreFaAttendSplitHmma (24Q/4KV Split-K S=16 HMMA FA2)
q38RegKernel 30 2 219 20736
note 31: q38PreFaSplitReduceGate (24Q Split-K reduce + gate)
q38RegKernel 31 2 220 0
note 32: q38F32ToBf16
q38RegKernel 32 2 221 0
note 33: q38PreGatherEmbeds (H=5120)
q38RegKernel 33 2 223 0
note 34: qPreLmHeadW4Hmma (unused; replaced by kid 36)
q38RegKernel 34 1 147 2048
note 35: qPreCopyU32 (GPU u32 memcpy for GDN snapshot/rollback)
q38RegKernel 35 1 148 0
note 36: q38W4GemmM8Hmma (100% Coalesced SMEM-W4 Tensor Core HMMA.16816 for B<=8 + lm_head!)
q38RegKernel 36 2 225 3328

ret false
end
q38Ptr q38P QP_TOKS
q38Ptr mapaddr get q38EmbBf16 0
q38Ptr q38P QP_X
if not q38PktEmitGy 33 uint M 1 256
ret false
end
put q38SpecMode 0 1
ok = q38PreEmitAll64W4 uint M true true
put q38SpecMode 0 0
if not ok
ret false
end
if not q38PreEmitFinalHead uint M
ret false
end
ret q38PktFinish 9
end


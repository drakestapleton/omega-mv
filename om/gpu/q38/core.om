fn q38SpecEmitVerifyPkt M ulong to bool
sva = get q38SpecSnapVa 0
q38PktStartAt add q38O QI_PKT 41943040
if not q38EmitCopyU32 get q38GdnStateVa 0 add sva QSP_GDN_STATE 150994944
ret false
end

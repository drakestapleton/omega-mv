fn q38GetU32Io p ulong to uint
b0 = uint get q38IoBuf p
b1 = shl uint get q38IoBuf add p 1 8
b2 = shl uint get q38IoBuf add p 2 16
b3 = shl uint get q38IoBuf add p 3 24
ret or or b0 b1 or b2 b3
end

fn q38PrepGdnAlog L ulong fd int dataOff ulong to bool
gdnIdx = sub L div L 4
sm = get q38ScaleMap 0
sOff = mul L Q38_SCALE_STRIDE
if ne mapread sm add sOff mul G38_ALOG 2 q38IoBuf 0 192 192
ret false
end
for h ulong 48
p = mul h 4
vw = bitcast uint neg q38Exp bitcast f32 q38GetU32Io p
put q38ScaleOut p uchar and vw 255
put q38ScaleOut add p 1 uchar and shr vw 8 255
put q38ScaleOut add p 2 uchar and shr vw 16 255
put q38ScaleOut add p 3 uchar and shr vw 24 255
end
if ne mapread sm add sOff mul G38_DTBIAS 2 q38ScaleOut 192 192 192
ret false
end
if ne mapwrite get q38Work 0 add q38O QI_ALOG mul gdnIdx 384 q38ScaleOut 0 384 384
ret false
end
ret q38StreamToMap fd add dataOff G38_IN_AB sm add sOff 2300000 983040
end


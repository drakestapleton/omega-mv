note =========================================================================
note Native Qwen 3.8 27B MTP Speculative Drafter (mtp.safetensors -> W4) + GDN Rollback
note =========================================================================
fn q38WidenToMap fd int foff ulong dstMap long dstOff ulong bf16Bytes ulong to bool
pos = ulong 0
while lt pos bf16Bytes bound 32
want = sub bf16Bytes pos
if gt want 262144
want = ulong 262144
end
got = pread fd q38IoBuf 0 want long add foff pos
if ne got long want
ret false
end
q38WidenBuf div want 2
outBytes = mul want 2
if ne mapwrite dstMap add dstOff mul pos 2 q38ScaleOut 0 outBytes long outBytes
ret false
end
pos = add pos want
end
ret true
end


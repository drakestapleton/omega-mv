if not q38EmitQuantFp8Mat add tVa F38_K_W add sVa mul F38_K_S 2 add wVa W4F_K_W add wVa W4F_K_S 5120 1024
ret false
end
if not q38EmitQuantFp8Mat add tVa F38_V_W add sVa mul F38_V_S 2 add wVa W4F_V_W add wVa W4F_V_S 5120 1024
ret false
end
if not q38EmitQuantFp8Mat add tVa F38_O_W add sVa mul F38_O_S 2 add wVa W4F_O_W add wVa W4F_O_S 6144 5120
ret false
end
if not q38EmitQuantFp8Mat add tVa F38_GU_W add sVa mul F38_GU_S 2 add wVa W4F_GU_W add wVa W4F_GU_S 5120 34816
ret false
end
if not q38EmitQuantFp8Mat add tVa F38_DN_W add sVa mul F38_DN_S 2 add wVa W4F_DN_W add wVa W4F_DN_S 17408 5120
ret false
end
ret q38PktRun
end

fn q38LoadMtpW4 to bool
t0 = ulong monons
n = q38BuildPath q38SufMtp neg 1
fd = int fopen q38PathBuf 0 n 0 0
if lt fd 0
ret false
end
rc = long 0
dataOff = q38ReadHdrOff fd
if eq dataOff 0
rc = fclose fd
ret false
end
if not q38StreamToMap fd dataOff get q38TmpSlab 0 0 MTP_FC_BYTES
rc = fclose fd
ret false
end
wVa = get q38MtpW4Va 0
sVa = add wVa MTP_SCALE_OFF
q38PktStart
q38Ptr get q38TmpSlabVa 0
q38Ptr add wVa MTP_FC_W
q38Ptr add wVa MTP_FC_S
q38Arg 10240
q38Arg 5120
if not q38PktEmitGy 38 640 1 256
rc = fclose fd
ret false

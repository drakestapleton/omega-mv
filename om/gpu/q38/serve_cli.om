note SPDX-License-Identifier: AGPL-3.0-only
note om/gpu/q38/serve_cli.om: Pure Seeded-OM-2 Zero-CUDA OpenAI-Compatible HTTP Server for Qwen 3.8 27B!
note Supports:
note   GET  /health               (status, model, engine, context_window=131072, precision)
note   GET  /v1/models            (OpenAI model list: qwen3.8-27b-fp8)
note   POST /v1/chat/completions  (OpenAI JSON & timings: prefill_ms, decode_ms)
note Usage:
note   q38-serve [--model-dir PATH] [--port PORT] [--fp8] [--self-test] [--batch]

global qsPort ulong 1
global qsSelfTest ulong 1
global qsReqBuf uchar 524288
global qsRespBuf uchar 262144
global qsRespLen ulong 1
global qsGenText uchar 131072
global qsGenTextLen ulong 1
global qsNumBuf uchar 32
global qsTimings ulong 2

text qsBanner "=== QWEN 3.8 27B DENSE 100% PURE SEEDED-OMEGA ZERO-CUDA SERVER (q38-serve) ===\n"
text qsModeW4 "Mode: Full-W4 (~13.8 GB trunk + 0.72 GB W4 lm_head + 128K KV)\n"
text qsModeFp8 "Mode: Exact FP8 (~24.6 GB trunk + 128K KV)\n"
text qsTokOk "Loaded Qwen 3.8 ByteLevel BPE tokenizer (248,044 vocab)\n"
text qsTokFail "ERROR: failed to load tokenizer.json\n"
text qsListenMsg "Listening on 0.0.0.0:"
text qsListenEnd " (GET /health, GET /v1/models, POST /v1/chat/completions)\n"
text qsHdrOk "HTTP/1.1 200 OK\nContent-Type: application/json\nAccess-Control-Allow-Origin: *\nConnection: close\nContent-Length: "
text qsHdrEnd "\n\n"
text qsHdr404 "HTTP/1.1 404 Not Found\nContent-Length: 2\nConnection: close\n\n{}"
text qsHealthA "{\"status\":\"ok\",\"model\":\"qwen3.8-27b-fp8\",\"engine\":\"omega-zero-cuda-q38\",\"context_window\":131072,\"precision\":\""
text qsHealthB "\"}\n"
text qsPrecW4 "w4"
text qsPrecFp8 "fp8"
text qsModels "{\"object\":\"list\",\"data\":[{\"id\":\"qwen3.8-27b-fp8\",\"object\":\"model\",\"owned_by\":\"omega-zero-cuda-q38\",\"context_window\":131072}]}\n"
text qsChatA "{\"id\":\"cmpl-q38\",\"object\":\"chat.completion\",\"model\":\"qwen3.8-27b-fp8\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\""
text qsChatB "\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":"
text qsChatC ",\"completion_tokens\":"
text qsChatD ",\"total_tokens\":"
text qsChatE "},\"timings\":{\"prefill_ms\":"
text qsChatF ",\"decode_ms\":"
text qsChatG "}}\n"
text qsSelfHdr "Running live real-weight q38-serve 128K self-test...\n"
text qsSelfP0 "What is the capital of France?"
text qsSelfP1 "What is 2 + 2?"
text qsSelfRes0 "Prompt 0: "
text qsSelfRes1 "Prompt 1: "
text qsSelfPass "PASS: q38-serve real-weight 27B self-test\n"

fn qsAppStr s view uchar * to void
p = get qsRespLen 0
for i ulong len s bound 512
if lt p 262100
put qsRespBuf p get s i
p = add p 1
end
end
put qsRespLen 0 p
end

fn qsAppU v ulong to void
if eq v 0
p = get qsRespLen 0
if lt p 262100
put qsRespBuf p 48
put qsRespLen 0 add p 1
end
ret
end
x = v
n = ulong 0
while gt x 0 bound 24
put qsNumBuf n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
p = get qsRespLen 0
i = n
while gt i 0 bound 24
i = sub i 1
if lt p 262100
put qsRespBuf p get qsNumBuf i
p = add p 1
end
end
put qsRespLen 0 p
end

fn qsAppJsonEsc blen ulong to void
p = get qsRespLen 0
for i ulong blen bound 131072
if ge p 262000
break
end
c = get qsGenText i
if eq c 34
put qsRespBuf p 92
put qsRespBuf add p 1 34
p = add p 2
else
if eq c 92
put qsRespBuf p 92
put qsRespBuf add p 1 92
p = add p 2
else
if eq c 10
put qsRespBuf p 92
put qsRespBuf add p 1 110
p = add p 2
else
if eq c 13
put qsRespBuf p 92
put qsRespBuf add p 1 114
p = add p 2
else
if eq c 9
put qsRespBuf p 92
put qsRespBuf add p 1 116
p = add p 2
else
if ge c 32
put qsRespBuf p c
p = add p 1
end
end
end
end
end
end
end
put qsRespLen 0 p
end

fn qsAppendTokText tid ulong to void
if ge tid 248044
ret
end
off = ulong get q36TokOff tid
tl = ulong get q36TokLen tid
gp = get qsGenTextLen 0
for i ulong tl bound 128
if lt gp 131000
put qsGenText gp get q36TokPool add off i
gp = add gp 1
end
end
put qsGenTextLen 0 gp
end

fn qsGenerate maxToks ulong pMsOut edit ulong 2 to ulong
ntok = get q36TokOutIds 0
note q36TokEncodeChatGlobal returned ntok; pass ntok directly via qsRunChat
ret 0
end

fn qsIsStop tok ulong to bool
if eq tok 248046
ret true
end
if eq tok 248044
ret true
end
ret ge tok Q38_VOCAB
end

fn qsRunChatMtp ntok ulong maxToks ulong firstTok ulong to ulong
M = get q38MtpM 0
pos = ntok
nextTok = firstTok
genCnt = ulong 1
t0 = ulong monons
while lt genCnt maxToks bound 8192
if not q38MtpDraftChain nextTok sub pos 1 M
break
end
acc = q38SpecVerifyStep M pos
if eq acc 0
break
end
stopped = false
for k ulong acc bound 8
tk = get q38SpecPred k
if qsIsStop tk
stopped = true
break
end
if lt genCnt maxToks
qsAppendTokText tk
genCnt = add genCnt 1
end
end
if stopped
break
end
if not q38MtpCopyMainHid acc
break
end
nextTok = get q38SpecPred sub acc 1
pos = add pos acc
end
put qsTimings 1 div sub ulong monons t0 1000000
ret genCnt
end

fn qsRunChat ntok ulong maxToks ulong to ulong
put qsGenTextLen 0 0
for i ulong ntok bound 131072
put q38TokSeq i get q36TokOutIds i
end
t0 = ulong monons
firstTok = q38PrefillSeq ntok
t1 = ulong monons
put qsTimings 0 div sub t1 t0 1000000
put qsTimings 1 0
if qsIsStop firstTok
ret 0
end
qsAppendTokText firstTok
genCnt = ulong 1
if lt genCnt maxToks
if eq get q38MtpReady 0 1
if q38MtpWarmFromPre ntok
ret qsRunChatMtp ntok maxToks firstTok
end
end
if not q38LoadEmbed firstTok
ret genCnt
end
if not q38SetPos ntok
ret genCnt
end
t0 = ulong monons
while lt genCnt maxToks bound 32768
if not q38ReplayPre 2
break
end
tok = q38ReadOutTok
if qsIsStop tok
break
end
qsAppendTokText tok
genCnt = add genCnt 1
end
put qsTimings 1 div sub ulong monons t0 1000000
end
ret genCnt
end

text qsPatContent "\"content\""
text qsPatMaxTok "\"max_tokens\""

fn qsMatchAt pos ulong pat view uchar * to bool
for i ulong len pat bound 32
if ne get qsReqBuf add pos i get pat i
ret false
end
end
ret true
end

fn qsSkipWs j0 ulong rlen ulong to ulong
j = j0
while lt j rlen bound 32
c = get qsReqBuf j
if eq c 32
j = add j 1
else
if eq c 9
j = add j 1
else
if eq c 10
j = add j 1
else
ret j
end
end
end
end
ret j
end

fn qsExtractContent rlen ulong to ulong
pos = ulong 0
lastStart = ulong 0
found = ulong 0
while lt add pos 12 rlen bound 524288
if qsMatchAt pos qsPatContent
j = add pos 9
while and lt j rlen ne get qsReqBuf j 58 bound 32
j = add j 1
end
j = qsSkipWs add j 1 rlen
if and lt j rlen eq get qsReqBuf j 34
lastStart = add j 1
found = ulong 1
end
end
pos = add pos 1
end
if eq found 0
ret 0
end
olen = ulong 0
p = lastStart
while and lt p rlen lt olen 524000 bound 524288
c = get qsReqBuf p
if eq c 34
break
end
if and eq c 92 lt add p 1 rlen
nx = get qsReqBuf add p 1
if eq nx 110
put q36TokInBuf olen 10
else
if eq nx 114
put q36TokInBuf olen 13
else
if eq nx 116
put q36TokInBuf olen 9
else
put q36TokInBuf olen nx
end
end
end
olen = add olen 1
p = add p 2
else
put q36TokInBuf olen c
olen = add olen 1
p = add p 1
end
end
ret olen
end

fn qsExtractMaxToks rlen ulong to ulong
pos = ulong 0
while lt add pos 14 rlen bound 524288
if qsMatchAt pos qsPatMaxTok
j = add pos 12
while and lt j rlen ne get qsReqBuf j 58 bound 32
j = add j 1
end
j = qsSkipWs add j 1 rlen
v = ulong 0
while lt j rlen bound 12
c = get qsReqBuf j
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
j = add j 1
end
if gt v 0
if gt v 32768
ret 32768
end
ret v
end
end
pos = add pos 1
end
ret 8192
end

fn qsSendJson fd int to void
blen = get qsRespLen 0
hdr = new uchar 256 0
hp = ulong 0
for i ulong len qsHdrOk bound 200
put hdr hp get qsHdrOk i
hp = add hp 1
end
x = blen
n = ulong 0
if eq x 0
put qsNumBuf 0 48
n = ulong 1
else
while gt x 0 bound 16
put qsNumBuf n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
end
i = n
while gt i 0 bound 16
i = sub i 1
put hdr hp get qsNumBuf i
hp = add hp 1
end
for j ulong len qsHdrEnd bound 16
put hdr hp get qsHdrEnd j
hp = add hp 1
end
w0 = write fd hdr 0 hp
w1 = write fd qsRespBuf 0 blen
end

fn qsFindHdrEnd tot ulong to ulong
p = ulong 0
while lt add p 3 tot bound 8192
if eq get qsReqBuf p 13
if eq get qsReqBuf add p 1 10
if eq get qsReqBuf add p 2 13
if eq get qsReqBuf add p 3 10
ret add p 4
end
end
end
end
p = add p 1
end
ret 0
end

fn qsParseContentLen hdrEnd ulong to ulong
q = ulong 0
while lt add q 16 hdrEnd bound 4096
c0 = get qsReqBuf q
if or eq c0 67 eq c0 99
if eq get qsReqBuf add q 1 111
if eq get qsReqBuf add q 8 76
k = add q 15
while lt k hdrEnd bound 16
ck = get qsReqBuf k
if and ne ck 32 ne ck 58
break
end
k = add k 1
end
cl = ulong 0
while lt k hdrEnd bound 12
cd = get qsReqBuf k
if or lt cd 48 gt cd 57
break
end
cl = add mul cl 10 ulong sub cd 48
k = add k 1
end
ret cl
end
end
end
q = add q 1
end
ret 0
end

fn qsReadHttpReq fd int to ulong
tot = ulong 0
hdrEnd = ulong 0
contentLen = ulong 0
for iter ulong 64
if ge tot 524000
break
end
got = read fd qsReqBuf tot sub 524288 tot
if le got 0
break
end
tot = add tot ulong got
if eq hdrEnd 0
hdrEnd = qsFindHdrEnd tot
if gt hdrEnd 0
contentLen = qsParseContentLen hdrEnd
end
end
if gt hdrEnd 0
if ge sub tot hdrEnd contentLen
break
end
end
end
ret tot
end

fn qsHandleHttp fd int to void
tot = qsReadHttpReq fd
if lt tot 10
ret
end
if eq get qsReqBuf 0 71
if eq get qsReqBuf 5 104
put qsRespLen 0 0
qsAppStr qsHealthA
if eq get q38UseW4 0 1
qsAppStr qsPrecW4
else
qsAppStr qsPrecFp8
end
qsAppStr qsHealthB
qsSendJson fd
ret
end
if eq get qsReqBuf 5 118
put qsRespLen 0 0
qsAppStr qsModels
qsSendJson fd
ret
end
end
if eq get qsReqBuf 0 80
tlen = qsExtractContent tot
maxToks = qsExtractMaxToks tot
ntok = q36TokEncodeChatGlobal tlen
genCnt = qsRunChat ntok maxToks
put qsRespLen 0 0
qsAppStr qsChatA
qsAppJsonEsc get qsGenTextLen 0
qsAppStr qsChatB
qsAppU ntok
qsAppStr qsChatC
qsAppU genCnt
qsAppStr qsChatD
qsAppU add ntok genCnt
qsAppStr qsChatE
qsAppU get qsTimings 0
qsAppStr qsChatF
qsAppU get qsTimings 1
qsAppStr qsChatG
qsSendJson fd
ret
end
w4 = write fd qsHdr404 0 len qsHdr404
end

fn qsRunSelfTest to int
q38Print qsSelfHdr
for i ulong len qsSelfP0 bound 64
put q36TokInBuf i get qsSelfP0 i
end
n0 = q36TokEncodeChatGlobal len qsSelfP0
g0 = qsRunChat n0 32
q38Print qsSelfRes0
r0 = write 1 qsGenText 0 get qsGenTextLen 0
q38Print q38MsgNl
for i ulong len qsSelfP1 bound 64
put q36TokInBuf i get qsSelfP1 i
end
n1 = q36TokEncodeChatGlobal len qsSelfP1
g1 = qsRunChat n1 32
q38Print qsSelfRes1
r1 = write 1 qsGenText 0 get qsGenTextLen 0
q38Print q38MsgNl
if or eq g0 0 eq g1 0
ret 25
end
q38Print qsSelfPass
ret 0
end

fn qsParseArgs to void
put q38UseW4 0 1
put q38UseNv4 0 0
put q38UseMtp 0 0
put q38MtpM 0 5
put q38BatchN 0 0
put q38SpecM 0 0
put qsPort 0 18099
put qsSelfTest 0 0
for i ulong len q38DefDir bound 128
put q38DirBuf i get q38DefDir i
end
put q38DirLen 0 len q38DefDir
a = new uchar 64 0
argc = ulong argcnt
ai = ulong 1
while lt ai argc bound 32
n = argread ai a 0 60
if and ge n 5 eq get a 0 45
if and eq get a 2 102 eq get a 3 112
put q38UseW4 0 0
put q38UseNv4 0 0
put q38UseMtp 0 0
end
if and eq get a 2 110 eq get a 3 118
put q38UseW4 0 1
put q38UseNv4 0 1
end
if and eq get a 2 109 eq get a 3 116
put q38UseMtp 0 1
put q38MtpM 0 5
if and ge n 6 eq get a 5 56
put q38MtpM 0 8
end
if and ge n 6 eq get a 5 52
put q38MtpM 0 4
end
end
if and eq get a 2 115 eq get a 3 101
put qsSelfTest 0 1
end
if and eq get a 2 112 eq get a 3 111
if lt add ai 1 argc
ai = add ai 1
pv = q38ParseArgU ai
if gt pv 0
put qsPort 0 pv
end
end
end
if and eq get a 2 109 eq get a 3 111
if lt add ai 1 argc
ai = add ai 1
dl = argread ai q38DirBuf 0 250
if gt dl 0
put q38DirLen 0 ulong dl
end
end
end
end
ai = add ai 1
end
end

fn qsLoadTok to bool
tlen = q38BuildPath q38SufTok neg 1
pLocal = new uchar 512 0
for i ulong tlen bound 512
put pLocal i get q38PathBuf i
end
ret q36TokLoad pLocal tlen
end

fn qsListen port ulong to long
addr = new uchar 16 0
one = new uchar 4 0
put addr 0 2
put addr 2 uchar shr port 8
put addr 3 uchar and port 255
put one 0 1
fd = socknew 2 524289 0
if lt fd 0
ret fd
end
r = sockopt int fd 1 2 one 0 4
if eq r 0
r = bind int fd addr 0 16
end
if eq r 0
r = listen int fd 16
end
if ne r 0
c = fclose int fd
ret r
end
ret fd
end

fn main to int
q38Print qsBanner
qsParseArgs
if eq get q38UseW4 0 1
q38Print qsModeW4
else
q38Print qsModeFp8
end
if not qsLoadTok
q38Print qsTokFail
ret 2
end
q38Print qsTokOk
q38InitRopeFreq
irc = q38GpuInit
if ne irc 0
q38Print q38MsgErr
q38PrintU ulong irc
q38Print q38MsgNl
ret irc
end
lrc = q38LoadAll
if ne lrc 0
q38Print q38MsgErr
q38PrintU ulong lrc
q38Print q38MsgNl
rc = nvstop
ret lrc
end
if eq get qsSelfTest 0 1
prc = qsRunSelfTest
r = fclose get q38OutFd 0
rc = nvstop
ret prc
end
port = get qsPort 0
lfd = qsListen port
if lt lfd 0
r = fclose get q38OutFd 0
rc = nvstop
ret 40
end
q38Print qsListenMsg
q38PrintU port
q38Print qsListenEnd
for conn ulong 1000000
cfd = accept int lfd 524288
if ge cfd 0
qsHandleHttp int cfd
c0 = fclose int cfd
end
end
c1 = fclose int lfd
r = fclose get q38OutFd 0
rc = nvstop
ret 0
end

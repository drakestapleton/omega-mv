engArg uint 2560
engArg uint 64
if not and engPktEmitGy 38 8 1 256 engPktRun
ret false
end
rr3 = mapread get engWork 0 EW_AOUT refB 0 256
engPrint ecKtHead
engPrintU 35
if not ecCheckArr64 view refB view gotB
ret false
end
engPrint ecKtOk
if not ecKtCheckOmma sva slab view refB

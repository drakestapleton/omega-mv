text ecKtDump "  NVFP4_DUMP s0="
text ecKtDumpW0 " w0="
text ecKtDumpW1 " w1="

fn ecKtDumpNvfp4 slab long to void
rw = mapread slab 16777216 engIoBuf 0 64
w0 = engGetU32Io 0
w8 = engGetU32Io 32
rs = mapread slab 17825792 engIoBuf 0 16
s0 = engGetU32Io 0
s1 = engGetU32Io 4
engPrint ecKtDump
engPrintU ulong s0
engPrint ecKtDumpW0
engPrintU ulong s1
engPrint ecKtDumpW1
engPrintU ulong w8
engPrint ecNl
end


engPtr add sva 16777216
engPtr add sva 17825792
engPtr engW EW_AOUT
engArg uint 2560
engArg uint 64
if not and engPktEmitGy 34 2 1 256 engPktRun
ret false
end
rr1 = mapread get engWork 0 EW_AOUT gotB 0 256

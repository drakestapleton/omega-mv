note SPDX-License-Identifier: AGPL-3.0-only
note om/gpu/engine/cli.om: Universal Pure Seeded-OM-2 Zero-CUDA `omega-engine` CLI & OpenAI HTTP Server.
note Usage:
note   omega-engine inspect <model-dir>
note   omega-engine run     <model-dir> [gen_tokens]
note   omega-engine serve   <model-dir> [--port PORT] [--self-test]

global ecPort ulong 1
global ecSelfTest ulong 1
global ecUseLong ulong 1
global ecStreamFd int 1
global ecMsgOutCnt ulong 1
global ecMode ulong 1
global ecGenN ulong 1
global ecReqBuf uchar 262144
global ecRespBuf uchar 262144
global ecRespLen ulong 1
global ecGenText uchar 131072
global ecGenTextLen ulong 1
global ecNumBuf uchar 32
global ecTimings ulong 2

text ecUsage "usage: omega-engine <inspect|run|serve> <model-dir> [gen_tokens | --port PORT | --self-test]\n"
text ecBanner "=== OMEGA UNIVERSAL ZERO-CUDA ENGINE (Pure Seeded-OM-2 / SM121 Blackwell) ===\n"
text ecErrCfg "ERROR: failed to load config.json from model directory\n"
text ecErrSt "ERROR: failed to index safetensors weights\n"
text ecErrMoe "NOTE: MoE execution (num_experts > 0) is inspected natively; use q36-serve for 256-expert Qwen 3.6 MoE.\n"
text ecErrGpu "OMEGA_ENGINE_ERR stage="
text ecNl "\n"
text ecSp " "
text ecKModelType "model_type      : "
text ecKArch "arch_family     : "
text ecKDims "hidden / inter  : H="
text ecKInter " I="
text ecKMoeI " moe_I="
text ecKLayers "layers          : "
text ecKFa " (FA="
text ecKGdn ", GDN="
text ecKClose ")\n"
text ecKAttn "attention       : nQ="
text ecKNkv " nKV="
text ecKHd " hd="
text ecKRope " rope_dims="
text ecKTheta " theta="
text ecKMoe "moe             : experts="
text ecKTopk " top_k="
text ecKVocab "vocab / ctx     : vocab="
text ecKCtx " max_ctx="
text ecKConv "conventions     : norm_add1="
text ecKQk " qk_norm="
text ecKGate " attn_gate="
text ecKTie " tie_emb="
text ecKQuant " quant="
text ecKLayout "weights         : layout="
text ecKFiles " files="
text ecKTensors " tensors="
text ecKPlan "kernel_plan     : uRmsNormAdd(H) + q38W4Gemv4R + uFaAttendSplitF32(nQ/nKV/hd) + uBf16ToW4Quant + uBf16RescoreCands\n"
text ecArch0 "Standard Dense Transformer (Llama/Qwen2/Qwen3/Mistral)"
text ecArch1 "Hybrid GDN+FA Dense Transformer (Qwen3.5/3.8 Dense)"
text ecArch2 "Hybrid GDN+FA MoE Transformer (Qwen3.5/3.6 MoE)"
text ecArch3 "Hybrid GDN+QSA MoE + Gated Residual + 51B PLE (Qwen 3.8 Flash Next / Qwen4 Exp)"
text ecArch4 "DeepSeek MoE Transformer"
text ecArch5 "Gemma Transformer"
text ecKHc "hyper_conn      : hc_count="
text ecKHcLr " hc_lowrank="
text ecKGdnSig " gdn_sigmoid="
text ecKPle "ple_ngram       : layer="
text ecKPleDim " dim="
text ecKPleSp " splits="
text ecKQsa "qsa_indexer     : budget="
text ecKQsaC " compress="
text ecKPlanQ4 "kernel_plan     : FULL-APU (20 ARMv9 CPU + 48 SM121 = 6,164 cores) + Live Arboris (48L x 512E top-10) + uGroupedRmsNorm + uHcMixReduce/Inject + uPleGate/Conv + uGdnStepReal(sig) + uRouterTopK + uMoeW4Gu/DnAdd + uFaAttendSplitF32\n"
text ecLay0 "single-file (model.safetensors)"
text ecLay1 "sharded-hf (model.safetensors.index.json)"
text ecLay2 "omega-per-layer (outside + layers-L.safetensors)"
text ecLayGguf "gguf-v3 (PTQ1_0 1.75bpw + blk.64 Q4_0 MTP)"
text ecFmtW4 "  weight_format   : W4 (INT4 block-32 + BF16 scale, 4.5 bpw)\n"
text ecFmtNvfp4 "  weight_format   : NVFP4 (FP4 E2M1 + FP8 E4M3 block-16, 4.5 bpw)\n"
text ecLoading "Specializing SM121 SASS kernels & loading weights into GB10 UVM...\n"
text ecLoaded "Engine ready in ms="
text ecRunStat "OMEGA_ENGINE_RUN: gen_tokens="
text ecRunUs " avg_us_per_tok="
text ecRunTps " tok_s_x100="
text ecRunArb " arboris_hit_pct_x10="
text ecRunTxt "Output: "
text ecTokOk "Loaded tokenizer.json\n"
text ecTokFail "ERROR: failed to load tokenizer.json\n"
text ecListenA "Listening on 0.0.0.0:"
text ecListenB " (GET /health, GET /v1/models, POST /v1/chat/completions)\n"
text ecHdrOk "HTTP/1.1 200 OK\nContent-Type: application/json\nAccess-Control-Allow-Origin: *\nConnection: close\nContent-Length: "
text ecHdrEnd "\n\n"
text ecMtpStat1 "MTP_SPEC_STATS: steps="
text ecMtpStat2 " accepted_toks="
text ecMtpStat3 " avg_acc_x100="
text ecLongPrompt "Explain how GPU warp schedulers hide memory latency in Transformer inference, comparing occupancy, warp switching, and memory-level parallelism."
text ecHdrOpt "HTTP/1.1 204 No Content\nAccess-Control-Allow-Origin: *\nAccess-Control-Allow-Methods: GET, POST, OPTIONS\nAccess-Control-Allow-Headers: Content-Type, Authorization\nConnection: close\n\n"
text ecHdrSse "HTTP/1.1 200 OK\nContent-Type: text/event-stream\nCache-Control: no-cache\nAccess-Control-Allow-Origin: *\nConnection: close\n\n"
text ecSseA "data: {\"id\":\"cmpl-omega\",\"object\":\"chat.completion.chunk\",\"model\":\""
text ecSseB "\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\""
text ecSseC "\"},\"finish_reason\":null}]}\n\n"
text ecSseEndA "data: {\"id\":\"cmpl-omega\",\"object\":\"chat.completion.chunk\",\"model\":\""
text ecSseEndB "\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"
text ecPatRole "\"role\""
text ecPatText "\"text\""
text ecPatStream "\"stream\""
text ecPatTrue "true"
text ecRoleSys "system"
text ecRoleAsst "assistant"
text ecHdr404 "HTTP/1.1 404 Not Found\nContent-Length: 2\nConnection: close\n\n{}"
text ecHealthA "{\"status\":\"ok\",\"engine\":\"omega-universal-zero-cuda\",\"model_type\":\""
text ecHealthB "\",\"hidden_size\":"
text ecHealthC ",\"num_hidden_layers\":"
text ecHealthD ",\"context_window\":"
text ecHealthE "}\n"
text ecModelsA "{\"object\":\"list\",\"data\":[{\"id\":\""
text ecModelsB "\",\"object\":\"model\",\"owned_by\":\"omega-universal-zero-cuda\"}]}\n"
text ecChatA "{\"id\":\"cmpl-omega\",\"object\":\"chat.completion\",\"model\":\""
text ecChatB "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\""
text ecChatC "\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":"
text ecChatD ",\"completion_tokens\":"
text ecChatE ",\"total_tokens\":"
text ecChatF "},\"timings\":{\"prefill_ms\":"
text ecChatG ",\"decode_ms\":"
text ecChatArb ",\"arboris_hit_pct_x10\":"
text ecChatH "}}\n"
text ecSelfP0 "What is the capital of France?"
text ecSelfRes "Self-test: "
text ecSelfPass "PASS: omega-engine live GB10 self-test\n"
text ecPatContent "\"content\""
text ecPatMaxTok "\"max_tokens\""
text ecSufTok "/tokenizer.json"

fn ecPrintInspect to void
engPrint ecKModelType
r = write 1 engModelType 0 get engModelTypeLen 0
engPrint ecNl
engPrint ecKArch
a = get engSpec MS_ARCH
if eq a 0
engPrint ecArch0
else
if eq a 1
engPrint ecArch1
else
if eq a 2
engPrint ecArch2
else
if eq a 3
engPrint ecArch3
else
if eq a 4
engPrint ecArch4
else
engPrint ecArch5
end
end
end
end
end
engPrint ecNl
engPrint ecKDims
engPrintU get engSpec MS_H
engPrint ecKInter
engPrintU get engSpec MS_I
engPrint ecKMoeI
engPrintU get engSpec MS_MOE_I
engPrint ecNl
engPrint ecKLayers
engPrintU get engSpec MS_LAYERS
engPrint ecKFa
engPrintU get engSpec MS_N_FA
engPrint ecKGdn
engPrintU get engSpec MS_N_GDN
engPrint ecKClose
engPrint ecKAttn
engPrintU get engSpec MS_NQ
engPrint ecKNkv
engPrintU get engSpec MS_NKV
engPrint ecKHd
engPrintU get engSpec MS_HD
engPrint ecKRope
engPrintU get engSpec MS_ROPE_DIMS
engPrint ecKTheta
engPrintU get engSpec MS_ROPE_THETA
engPrint ecNl
engPrint ecKMoe
engPrintU get engSpec MS_NEXP
engPrint ecKTopk
engPrintU get engSpec MS_TOPK
engPrint ecNl
engPrint ecKVocab
engPrintU get engSpec MS_VOCAB
engPrint ecKCtx
engPrintU get engSpec MS_MAX_CTX
engPrint ecNl
engPrint ecKConv
engPrintU get engSpec MS_NORM_ADD1
engPrint ecKQk
engPrintU get engSpec MS_QK_NORM
engPrint ecKGate
engPrintU get engSpec MS_ATTN_GATE
engPrint ecKTie
engPrintU get engSpec MS_TIE_EMB
engPrint ecKQuant
engPrintU get engSpec MS_QUANT
engPrint ecNl
engPrint ecKLayout
lm = get stLayoutMode 0
if eq get ggIsGguf 0 1
engPrint ecLayGguf
engPrint ecKFiles
engPrintU 1
engPrint ecKTensors
engPrintU get ggNTensors 0
else
if eq lm 0
engPrint ecLay0
else
if eq lm 1
engPrint ecLay1
else
engPrint ecLay2
end
end
engPrint ecKFiles
engPrintU get stFileCount 0
engPrint ecKTensors
engPrintU get stTensorCount 0
end
engPrint ecNl
if gt get engSpec MS_HC_COUNT 1
engPrint ecKHc
engPrintU get engSpec MS_HC_COUNT
engPrint ecKHcLr
engPrintU get engSpec MS_HC_LOWRANK
engPrint ecKGdnSig
engPrintU get engSpec MS_GDN_SIGMOID
engPrint ecNl
end
if gt get engSpec MS_PLE_LAYER 0
engPrint ecKPle
engPrintU get engSpec MS_PLE_LAYER
engPrint ecKPleDim
engPrintU get engSpec MS_PLE_DIM
engPrint ecKPleSp
engPrintU get engSpec MS_PLE_SPLITS
engPrint ecNl
end
if gt get engSpec MS_IDX_BUDGET 0
engPrint ecKQsa
engPrintU get engSpec MS_IDX_BUDGET
engPrint ecKQsaC
engPrintU get engSpec MS_IDX_COMP
engPrint ecNl
end
if eq get ggIsGguf 0 1
if eq get bonUseNvfp4 0 1
engPrint bonMsgModeNv4
else
engPrint bonMsgMode
end
engPrint bonMsgMtp
engPrintU get ggHasMtp 0
engPrint ecNl
else
if eq get engSpec MS_ARCH 3
engPrint ecKPlanQ4
else
engPrint ecKPlan
end
end
end

fn ecAppStr s view uchar * to void
p = get ecRespLen 0
for i ulong len s bound 512
if lt p 262100
put ecRespBuf p get s i
p = add p 1
end
end
put ecRespLen 0 p
end

fn ecAppModelType to void
p = get ecRespLen 0
ml = get engModelTypeLen 0
for i ulong ml bound 64
if lt p 262100
put ecRespBuf p get engModelType i
p = add p 1
end
end
put ecRespLen 0 p
end

fn ecAppU v ulong to void
if eq v 0
p = get ecRespLen 0
if lt p 262100
put ecRespBuf p 48
put ecRespLen 0 add p 1
end
ret
end
x = v
n = ulong 0
while gt x 0 bound 24
put ecNumBuf n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
p = get ecRespLen 0
i = n
while gt i 0 bound 24
i = sub i 1
if lt p 262100
put ecRespBuf p get ecNumBuf i
p = add p 1
end
end
put ecRespLen 0 p
end

fn ecAppJsonEsc blen ulong to void
p = get ecRespLen 0
for i ulong blen bound 131072
if ge p 262000
break
end
c = get ecGenText i
if eq c 34
put ecRespBuf p 92
put ecRespBuf add p 1 34
p = add p 2
else
if eq c 92
put ecRespBuf p 92
put ecRespBuf add p 1 92
p = add p 2
else
if eq c 10
put ecRespBuf p 92
put ecRespBuf add p 1 110
p = add p 2
else
if ge c 32
put ecRespBuf p c
p = add p 1
end
end
end
end
end
put ecRespLen 0 p
end

fn ecSendSseSlice start ulong blen ulong to void
sfd = get ecStreamFd 0
if le sfd 0
ret
end
if eq blen 0
ret
end
put ecRespLen 0 0
ecAppStr ecSseA
ecAppModelType
ecAppStr ecSseB
p = get ecRespLen 0
for i ulong blen bound 256
if ge p 262000
break
end
c = get ecGenText add start i
if eq c 34
put ecRespBuf p 92
put ecRespBuf add p 1 34
p = add p 2
else
if eq c 92
put ecRespBuf p 92
put ecRespBuf add p 1 92
p = add p 2
else
if eq c 10
put ecRespBuf p 92
put ecRespBuf add p 1 110
p = add p 2
else
if eq c 13
put ecRespBuf p 92
put ecRespBuf add p 1 114
p = add p 2
else
if eq c 9
put ecRespBuf p 92
put ecRespBuf add p 1 116
p = add p 2
else
if ge c 32
put ecRespBuf p c
p = add p 1
end
end
end
end
end
end
end
put ecRespLen 0 p
ecAppStr ecSseC
ws = write sfd ecRespBuf 0 get ecRespLen 0
end

fn ecAppendTokText tid ulong to void
if ge tid 248044
ret
end
off = ulong get q36TokOff tid
tl = ulong get q36TokLen tid
gp0 = get ecGenTextLen 0
gp = gp0
for i ulong tl bound 128
if lt gp 131000
put ecGenText gp get q36TokPool add off i
gp = add gp 1
end
end
put ecGenTextLen 0 gp
if gt get ecStreamFd 0 0
ecSendSseSlice gp0 sub gp gp0
end
end

fn ecIsStop tok ulong to bool
if eq tok 248046
ret true
end
if eq tok 248044
ret true
end
ret ge tok get engSpec MS_VOCAB
end

fn ecMtpDraft3 tok ulong pos ulong to void
put bmM4Toks 0 tok
dtok = tok
for d ulong 3
dtok = bmStepMtpDraft dtok sub add pos d 1
put bmDraftToks d dtok
put bmM4Toks add d 1 dtok
end
end

fn ecMtpCountAcc remToks ulong to ulong
acc = ulong 1
if and eq get bmVerToks 0 get bmDraftToks 0 gt remToks 1
acc = ulong 2
if and eq get bmVerToks 1 get bmDraftToks 1 gt remToks 2
acc = ulong 3
if and eq get bmVerToks 2 get bmDraftToks 2 gt remToks 3
acc = ulong 4
end
end
end
ret acc
end

fn ecRunMtpLoop pos0 ulong tok0 ulong maxToks ulong to ulong
genCnt = ulong 1
pos = pos0
tok = tok0
put bmStatSteps 0 0
put bmStatAcc 0 0
while lt genCnt maxToks bound 4096
ecMtpDraft3 tok pos
if not bmStepVerifyM4 pos
break
end
acc = ecMtpCountAcc sub maxToks genCnt
stopped = false
emitN = ulong 0
for ai ulong acc bound 4
vt = get bmVerToks ai
if ecIsStop vt
stopped = true
break
end
ecAppendTokText vt
genCnt = add genCnt 1
emitN = add emitN 1
tok = vt
if ge genCnt maxToks
stopped = true
break
end
end
put bmStatSteps 0 add get bmStatSteps 0 1
put bmStatAcc 0 add get bmStatAcc 0 emitN
if stopped
break
end
if gt acc 1
for kj ulong sub acc 1 bound 3
if not bmStepMtpKvFromM4 kj get bmVerToks kj add pos kj
break
end
end
end
if lt acc 4
if not engReplayPre add 8 acc
break
end
end
pos = add pos acc
end
ret genCnt
end

fn ecPrintMtpStats to void
st = get bmStatSteps 0
if gt st 0
engPrint ecMtpStat1
engPrintU st
engPrint ecMtpStat2
engPrintU get bmStatAcc 0
engPrint ecMtpStat3
engPrintU div mul get bmStatAcc 0 100 st
engPrint bonDbgNl
end
end

fn ecRunChatBonsai ntok ulong maxToks ulong to ulong
t0 = ulong monons
firstTok = ulong 0
if eq get bmMtpReady 0 1
firstTok = bmPrefillAndFirst ntok
else
firstTok = bonPrefillAndFirst ntok
end
t1 = ulong monons
put ecTimings 0 div sub t1 t0 1000000
put ecTimings 1 0
if ecIsStop firstTok
ret 0
end
ecAppendTokText firstTok
t0 = ulong monons
genCnt = ulong 1
if eq get bmMtpReady 0 1
genCnt = ecRunMtpLoop ntok firstTok maxToks
t1 = ulong monons
put ecTimings 1 div sub t1 t0 1000000
if eq get ecStreamFd 0 0
ecPrintMtpStats
end
ret genCnt
end
pos = ntok
tok = firstTok
while lt genCnt maxToks bound 4096
if not bonLoadEmbedCpu tok
break
end
if not bonSetPos pos
break
end
tok = bonStepDecode
if ecIsStop tok
break
end
ecAppendTokText tok
genCnt = add genCnt 1
pos = add pos 1
end
t1 = ulong monons
put ecTimings 1 div sub t1 t0 1000000
ret genCnt
end

fn ecRunChat ntok ulong maxToks ulong to ulong
put ecGenTextLen 0 0
for i ulong ntok bound 131072
put engTokSeq i get q36TokOutIds i
end
if eq get ggIsGguf 0 1
ret ecRunChatBonsai ntok maxToks
end
isQ4 = eq get engSpec MS_ARCH 3
t0 = ulong monons
firstTok = ulong 999999
if isQ4
firstTok = q4B8PrefillSeq ntok
else
firstTok = engPrefillSeq ntok
end
t1 = ulong monons
put ecTimings 0 div sub t1 t0 1000000
put ecTimings 1 0
if ecIsStop firstTok
ret 0
end
ecAppendTokText firstTok
genCnt = ulong 1
if lt genCnt maxToks
if isQ4
curTok = firstTok
curPos = ntok
t0 = ulong monons
while lt genCnt maxToks bound 4096
tok = q4DecodeStep curTok curPos
if ecIsStop tok
break
end
ecAppendTokText tok
curTok = tok
curPos = add curPos 1
genCnt = add genCnt 1
end
t1 = ulong monons
put ecTimings 1 div sub t1 t0 1000000
else
if not engLoadEmbed firstTok
ret genCnt
end
if not engSetPos ntok
ret genCnt
end
t0 = ulong monons
while lt genCnt maxToks bound 4096
if not engReplayPre 2
break
end
tok = engReadOutTok
if ecIsStop tok
break
end
ecAppendTokText tok
genCnt = add genCnt 1
end
t1 = ulong monons
put ecTimings 1 div sub t1 t0 1000000
end
end
ret genCnt
end

fn ecLoadTok to bool
if eq get ggIsGguf 0 1
ret true
end
tlen = engJoinPath ecSufTok
pLocal = new uchar 512 0
for i ulong tlen bound 512
put pLocal i get engPathTmp i
end
ret q36TokLoad pLocal tlen
end

fn ecSendJson fd int to void
blen = get ecRespLen 0
hdr = new uchar 256 0
hp = ulong 0
for i ulong len ecHdrOk bound 200
put hdr hp get ecHdrOk i
hp = add hp 1
end
x = blen
n = ulong 0
if eq x 0
put ecNumBuf 0 48
n = ulong 1
else
while gt x 0 bound 16
put ecNumBuf n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
end
i = n
while gt i 0 bound 16
i = sub i 1
put hdr hp get ecNumBuf i
hp = add hp 1
end
for j ulong len ecHdrEnd bound 16
put hdr hp get ecHdrEnd j
hp = add hp 1
end
w0 = write fd hdr 0 hp
w1 = write fd ecRespBuf 0 blen
end

fn ecMatchReq pos ulong rlen ulong pat view uchar * to bool
plen = len pat
if gt add pos plen rlen
ret false
end
for i ulong plen bound 32
if ne get ecReqBuf add pos i get pat i
ret false
end
end
ret true
end

fn ecSkipWs j0 ulong rlen ulong to ulong
j = j0
while lt j rlen bound 32
c = get ecReqBuf j
if or eq c 32 eq c 9
j = add j 1
else
break
end
end
ret j
end

fn ecExtractContent rlen ulong to ulong
pos = ulong 0
lastStart = ulong 0
found = ulong 0
while lt add pos 12 rlen bound 262144
if ecMatchReq pos rlen ecPatContent
j = add pos 9
while and lt j rlen ne get ecReqBuf j 58 bound 32
j = add j 1
end
j = ecSkipWs add j 1 rlen
if and lt j rlen eq get ecReqBuf j 34
lastStart = add j 1
found = ulong 1
end
end
pos = add pos 1
end
if eq found 0
ret 0
end
olen = ulong 0
p = lastStart
while and lt p rlen lt olen 262000 bound 262144
c = get ecReqBuf p
if eq c 34
break
end
if and eq c 92 lt add p 1 rlen
nx = get ecReqBuf add p 1
if eq nx 110
put q36TokInBuf olen 10
else
put q36TokInBuf olen nx
end
olen = add olen 1
p = add p 2
else
put q36TokInBuf olen c
olen = add olen 1
p = add p 1
end
end
ret olen
end

fn ecExtractMaxToks rlen ulong to ulong
pos = ulong 0
while lt add pos 14 rlen bound 262144
if ecMatchReq pos rlen ecPatMaxTok
j = add pos 12
while and lt j rlen ne get ecReqBuf j 58 bound 32
j = add j 1
end
j = add j 1
while and lt j rlen eq get ecReqBuf j 32 bound 16
j = add j 1
end
v = ulong 0
while lt j rlen bound 12
c = get ecReqBuf j
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
j = add j 1
end
if gt v 0
ret v
end
end
pos = add pos 1
end
ret 4096
end

fn ecIsWs c uchar to bool
if eq c 32
ret true
end
if eq c 10
ret true
end
if eq c 13
ret true
end
ret eq c 9
end

fn ecHasJsonEnd tot ulong to bool
if lt tot 16
ret false
end
i = tot
while gt i 0 bound 64
i = sub i 1
c = get ecReqBuf i
if eq c 125
ret true
end
if not ecIsWs c
ret false
end
end
ret false
end

fn ecSkipWsNl j0 ulong rlen ulong to ulong
j = j0
while lt j rlen bound 64
c = get ecReqBuf j
if or eq c 32 or eq c 9 or eq c 10 eq c 13
j = add j 1
else
break
end
end
ret j
end

fn ecReadJsonStrLen p0 ulong rlen ulong dstOff ulong to ulong
p = p0
olen = dstOff
while and lt p rlen lt olen 262000 bound 262144
c = get ecReqBuf p
if eq c 34
put ecMsgOutCnt 0 olen
ret add p 1
end
if and eq c 92 lt add p 1 rlen
nx = get ecReqBuf add p 1
if eq nx 110
put q36TokInBuf olen 10
else
if eq nx 114
put q36TokInBuf olen 13
else
if eq nx 116
put q36TokInBuf olen 9
else
put q36TokInBuf olen nx
end
end
end
olen = add olen 1
p = add p 2
else
put q36TokInBuf olen c
olen = add olen 1
p = add p 1
end
end
put ecMsgOutCnt 0 olen
ret p
end

fn ecTokAppendBuf tlen ulong cnt0 ulong to ulong
res = new ulong 2 0
cnt = cnt0
pos = ulong 0
while and lt pos tlen lt cnt 131050 bound 524288
maxTry = sub tlen pos
if gt maxTry 24
maxTry = ulong 24
end
q36TokBestGlobal pos maxTry res
bestLen = get res 1
if eq bestLen 0
bestLen = ulong 1
end
put q36TokOutIds cnt uint get res 0
cnt = add cnt 1
pos = add pos bestLen
end
ret cnt
end

fn ecEmitTurn roleId ulong clen ulong cnt0 ulong to ulong
cnt = cnt0
put q36TokOutIds cnt 248045
cnt = add cnt 1
if eq roleId 0
put q36TokOutIds cnt 8678
else
if eq roleId 2
put q36TokOutIds cnt 74455
else
put q36TokOutIds cnt 846
end
end
cnt = add cnt 1
put q36TokOutIds cnt 198
cnt = add cnt 1
cnt = ecTokAppendBuf clen cnt
put q36TokOutIds cnt 248046
cnt = add cnt 1
put q36TokOutIds cnt 198
cnt = add cnt 1
ret cnt
end

fn ecReadPartsArray p0 ulong rlen ulong to ulong
clen = ulong 0
p = p0
while and lt p rlen ne get ecReqBuf p 93 bound 65536
if ecMatchReq p rlen ecPatText
k = add p 6
while and lt k rlen ne get ecReqBuf k 58 bound 32
k = add k 1
end
k = ecSkipWsNl add k 1 rlen
if and lt k rlen eq get ecReqBuf k 34
p = ecReadJsonStrLen add k 1 rlen clen
clen = get ecMsgOutCnt 0
else
p = add p 6
end
else
p = add p 1
end
end
put ecMsgOutCnt 0 clen
ret add p 1
end

fn ecReadRoleAt j0 ulong rlen ulong to ulong
j = j0
while and lt j rlen ne get ecReqBuf j 58 bound 32
j = add j 1
end
j = ecSkipWsNl add j 1 rlen
if and lt j rlen eq get ecReqBuf j 34
j = add j 1
if ecMatchReq j rlen ecRoleSys
ret 0
end
if ecMatchReq j rlen ecRoleAsst
ret 2
end
end
ret 1
end

fn ecEncodeMessagesHttp rlen ulong to ulong
cnt = ulong 0
pos = ulong 0
curRole = ulong 1
turns = ulong 0
while lt add pos 8 rlen bound 262144
if ecMatchReq pos rlen ecPatRole
curRole = ecReadRoleAt add pos 6 rlen
pos = add pos 6
else
if ecMatchReq pos rlen ecPatContent
j = add pos 9
while and lt j rlen ne get ecReqBuf j 58 bound 32
j = add j 1
end
j = ecSkipWsNl add j 1 rlen
if and lt j rlen eq get ecReqBuf j 34
pos = ecReadJsonStrLen add j 1 rlen 0
cnt = ecEmitTurn curRole get ecMsgOutCnt 0 cnt
turns = add turns 1
else
if and lt j rlen eq get ecReqBuf j 91
pos = ecReadPartsArray add j 1 rlen
cnt = ecEmitTurn curRole get ecMsgOutCnt 0 cnt
turns = add turns 1
else
pos = add pos 9
end
end
else
pos = add pos 1
end
end
end
if eq turns 0
ret 0
end
put q36TokOutIds cnt 248045
cnt = add cnt 1
put q36TokOutIds cnt 74455
cnt = add cnt 1
put q36TokOutIds cnt 198
cnt = add cnt 1
put q36TokOutIds cnt 248068
cnt = add cnt 1
put q36TokOutIds cnt 271
cnt = add cnt 1
put q36TokOutIds cnt 248069
cnt = add cnt 1
put q36TokOutIds cnt 271
cnt = add cnt 1
ret cnt
end

fn ecExtractStream rlen ulong to bool
pos = ulong 0
while lt add pos 12 rlen bound 262144
if ecMatchReq pos rlen ecPatStream
j = add pos 8
while and lt j rlen ne get ecReqBuf j 58 bound 32
j = add j 1
end
j = ecSkipWsNl add j 1 rlen
if ecMatchReq j rlen ecPatTrue
ret true
end
end
pos = add pos 1
end
ret false
end

fn ecHandleHttp fd int to void
tot = ulong 0
for it ulong 16
got = read fd ecReqBuf tot sub 262144 tot
if le got 0
break
end
tot = add tot ulong got
if ge tot 16
if or and eq get ecReqBuf 0 71 eq get ecReqBuf 1 69 eq get ecReqBuf 0 79
break
end
if ecHasJsonEnd tot
break
end
end
end
if lt tot 12
ret
end
if eq get ecReqBuf 0 79
wo = write fd ecHdrOpt 0 len ecHdrOpt
ret
end
if and eq get ecReqBuf 0 71 eq get ecReqBuf 5 104
put ecRespLen 0 0
ecAppStr ecHealthA
ecAppModelType
ecAppStr ecHealthB
ecAppU get engSpec MS_H
ecAppStr ecHealthC
ecAppU get engSpec MS_LAYERS
ecAppStr ecHealthD
ecAppU get engSpec MS_MAX_CTX
ecAppStr ecHealthE
ecSendJson fd
ret
end
if and eq get ecReqBuf 0 71 eq get ecReqBuf 5 118
put ecRespLen 0 0
ecAppStr ecModelsA
ecAppModelType
ecAppStr ecModelsB
ecSendJson fd
ret
end
if eq get ecReqBuf 0 80
ntok = ecEncodeMessagesHttp tot
if eq ntok 0
clen = ecExtractContent tot
ntok = q36TokEncodeChatGlobal clen
end
maxToks = ecExtractMaxToks tot
if ecExtractStream tot
wh = write fd ecHdrSse 0 len ecHdrSse
put ecStreamFd 0 fd
genCnt = ecRunChat ntok maxToks
put ecStreamFd 0 0
put ecRespLen 0 0
ecAppStr ecSseEndA
ecAppModelType
ecAppStr ecSseEndB
we = write fd ecRespBuf 0 get ecRespLen 0
ret
end
put ecStreamFd 0 0
genCnt = ecRunChat ntok maxToks
put ecRespLen 0 0
ecAppStr ecChatA
ecAppModelType
ecAppStr ecChatB
ecAppJsonEsc get ecGenTextLen 0
ecAppStr ecChatC
ecAppU ntok
ecAppStr ecChatD
ecAppU genCnt
ecAppStr ecChatE
ecAppU add ntok genCnt
ecAppStr ecChatF
ecAppU get ecTimings 0
ecAppStr ecChatG
ecAppU get ecTimings 1
ecAppStr ecChatArb
ecAppU q4ArbHitPctX10
ecAppStr ecChatH
ecSendJson fd
ret
end
w4 = write fd ecHdr404 0 len ecHdr404
end

fn ecListen port ulong to long
addr = new uchar 16 0
one = new uchar 4 0
put addr 0 2
put addr 2 uchar shr port 8
put addr 3 uchar and port 255
put one 0 1
fd = socknew 2 524289 0
if lt fd 0
ret fd
end
r = sockopt int fd 1 2 one 0 4
if eq r 0
r = bind int fd addr 0 16
end
if eq r 0
r = listen int fd 128
end
if ne r 0
c = fclose int fd
ret r
end
ret fd
end

fn ecParseU idx ulong to ulong
b = new uchar 32 0
n = argread idx b 0 30
if le n 0
ret 0
end
v = ulong 0
for i ulong ulong n bound 20
c = get b i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
end
ret v
end

fn ecRunSelfOrCli to int
pl = len ecSelfP0
if eq get ecUseLong 0 1
pl = len ecLongPrompt
for i ulong len ecLongPrompt bound 512
put q36TokInBuf i get ecLongPrompt i
end
else
for i ulong len ecSelfP0 bound 64
put q36TokInBuf i get ecSelfP0 i
end
end
ntok = q36TokEncodeChatGlobal pl
g = ecRunChat ntok get ecGenN 0
engPrint ecRunTxt
w = write 1 ecGenText 0 get ecGenTextLen 0
engPrint ecNl
dms = get ecTimings 1
if eq dms 0
dms = ulong 1
end
decN = g
if gt decN 1
decN = sub decN 1
end
if eq decN 0
decN = ulong 1
end
engPrint ecRunStat
engPrintU g
engPrint ecRunUs
engPrintU div mul dms 1000 decN
engPrint ecRunTps
engPrintU div mul decN 100000 dms
if eq get engSpec MS_ARCH 3
engPrint ecRunArb
engPrintU q4ArbHitPctX10
end
engPrint ecNl
if eq g 0
ret 25
end
if eq get ecSelfTest 0 1
engPrint ecSelfPass
end
ret 0
end

text ecKtHead "KTEST kid="
text ecKtVal " val="
text ecKtOk " PASS\n"
text ecKtFail " FAIL\n"

text ecKtMismatch " MISMATCH row="

fn ecReadU32 b view uchar * off ulong to uint
b0 = uint get b off
b1 = shl uint get b add off 1 8
b2 = shl uint get b add off 2 16
b3 = shl uint get b add off 3 24
ret or or b0 b1 or b2 b3
end

fn ecCheckArr64 refBuf view uchar * gotBuf view uchar * to bool
for r ulong 64
off = mul r 4
a = ecReadU32 refBuf off
b = ecReadU32 gotBuf off
if ne a b
engPrint ecKtMismatch
engPrintU r
engPrint ecKtVal
engPrintU ulong a
engPrint ecKtVal
engPrintU ulong b
engPrint ecNl
ret false
end
end
ret true
end

fn ecKtCheckW4 kid ulong K ulong sva ulong to bool
refB = new uchar 256 0
gotB = new uchar 256 0
engPktStart
engPtr engW EW_XN
engPtr sva
engPtr add sva 1048576
engPtr engW EW_AOUT
engArg uint K
engArg uint 64
r0 = engPktEmitGy 15 8 1 256
if not and r0 engPktRun
ret false
end
rr0 = mapread get engWork 0 EW_AOUT refB 0 256
engPktStart
engPtr engW EW_XN
engPtr sva
engPtr add sva 1048576
engPtr engW EW_AOUT
engArg uint K
engArg uint 64
r1 = engPktEmitGy kid 2 1 256
if not and r1 engPktRun
ret false
end
rr1 = mapread get engWork 0 EW_AOUT gotB 0 256
engPrint ecKtHead
engPrintU kid
if ecCheckArr64 view refB view gotB
engPrint ecKtOk
ret true
end
ret false
end

text ecKtTolFail " TOL_FAIL row="

fn ecCheckApprox64 refBuf view uchar * gotBuf view uchar * absTol f32 relTol f32 to bool
for r ulong 64
off = mul r 4
a = bitcast f32 ecReadU32 refBuf off
b = bitcast f32 ecReadU32 gotBuf off
d = sub a b
if lt d f32 0.0f32
d = neg d
end
aa = a
if lt aa f32 0.0f32
aa = neg aa
end
lim = add absTol mul aa relTol
if gt d lim
engPrint ecKtTolFail
engPrintU r
engPrint ecKtVal
engPrintU ulong ecReadU32 refBuf off
engPrint ecKtVal
engPrintU ulong ecReadU32 gotBuf off
engPrint ecNl
ret false
end
end
ret true
end


end
ret ecKtCheckMoeNvfp4 sva slab
end

fn ecRunKtest to int
slab = nvalloc 67108864 true
if le slab 0
ret 50
end
sva = mapaddr slab
for i ulong 4096
engPutU32Io mul i 4 bitcast uint f32 add 1 rem i 11
end
rx = mapwrite get engWork 0 EW_XN engIoBuf 0 16384
for i ulong 32768
engPutU32Io mul i 4 add uint 0x11111111 mul uint and i 15 uint 0x01020304
end
rw = mapwrite slab 0 engIoBuf 0 131072
for i ulong 4096
lo = add uint 0x3f80 mul uint and i 7 uint 0x0010
hi = add uint 0x3fc0 mul uint and shr i 3 7 uint 0x0010
engPutU32Io mul i 4 or lo shl hi 16
end
rs = mapwrite slab 1048576 engIoBuf 0 16384
for i ulong 81920
lo = add uint 0x3d00 mul uint and i 7 uint 0x0010
hi = add uint 0xbd40 mul uint and shr i 3 7 uint 0x0010
engPutU32Io mul i 4 or lo shl hi 16
end
rs2 = mapwrite slab 2097152 engIoBuf 0 327680
if not ecKtCheckW4 0 4096 sva
ret 53
end
if not ecKtCheckW4 26 2560 sva
ret 56
end
if not ecKtCheckBf16 sva
ret 59
end
if not ecKtCheckB8 sva slab
ret 60
end
if not ecKtCheckNvfp4 sva slab
ret 61
end
ret 0
end

note True Concurrent B=8 Multi-Stream HTTP Batcher for Qwen 3.8 Flash Next
global ecB8Fd int 8
global ecB8State ulong 8
global ecB8Ptoks uint 16384
global ecB8Plen ulong 8
global ecB8Pidx ulong 8
global ecB8Pos ulong 8
global ecB8Gen ulong 8
global ecB8Max ulong 8
global ecB8T0 ulong 8
global ecB8T1 ulong 8
global ecB8Txt uchar 131072
global ecB8TxtLen ulong 8

fn ecB8AppTokText b ulong tid ulong to void
if ge tid 248044
ret
end
off = ulong get q36TokOff tid
tl = ulong get q36TokLen tid
gp = get ecB8TxtLen b
base = mul b 16384
for i ulong tl bound 128
if lt gp 16300
put ecB8Txt add base gp get q36TokPool add off i
gp = add gp 1
end
end
put ecB8TxtLen b gp
end

fn ecB8SendDone b ulong to void
fd = get ecB8Fd b
t2 = ulong monons
pms = div sub get ecB8T1 b get ecB8T0 b 1000000
dms = div sub t2 get ecB8T1 b 1000000
if eq dms 0
dms = ulong 1
end
tl = get ecB8TxtLen b
base = mul b 16384
for i ulong tl bound 16384
put ecGenText i get ecB8Txt add base i
end
put ecGenTextLen 0 tl
put ecRespLen 0 0
ecAppStr ecChatA
ecAppModelType
ecAppStr ecChatB
ecAppJsonEsc tl
ecAppStr ecChatC
ecAppU get ecB8Plen b
ecAppStr ecChatD
ecAppU get ecB8Gen b
ecAppStr ecChatE
ecAppU add get ecB8Plen b get ecB8Gen b
ecAppStr ecChatF
ecAppU pms
ecAppStr ecChatG
ecAppU dms
ecAppStr ecChatArb
ecAppU q4ArbHitPctX10
ecAppStr ecChatH
ecSendJson fd
c0 = fclose fd
put ecB8Fd b int -1
put ecB8State b 0
put q4B8Active b 0
end

fn ecB8FindFree to long
for b ulong Q4_B8
if eq get ecB8State b 0
ret long b
end
end
ret long -1
end

fn ecB8CountAct to ulong
c = ulong 0
for b ulong Q4_B8
if ne get ecB8State b 0
c = add c 1
end
end
ret c
end

fn ecB8InitSlot b ulong cfd int tot ulong to void
clen = ecExtractContent tot
maxToks = ecExtractMaxToks tot
ntok = q36TokEncodeChatGlobal clen
if gt ntok 2000
ntok = ulong 2000
end
if eq ntok 0
ntok = ulong 1
end
base = mul b 2048
for i ulong ntok bound 2048
put ecB8Ptoks add base i get q36TokOutIds i
end
q4B8ResetStream b
put ecB8Fd b cfd
put ecB8State b 1
put ecB8Plen b ntok
put ecB8Pidx b 0
put ecB8Pos b 0
put ecB8Gen b 0
put ecB8Max b maxToks
put ecB8TxtLen b 0
put ecB8T0 b ulong monons
put ecB8T1 b get ecB8T0 b
put q4B8Active b 1
end

fn ecB8AcceptOne lfd int to bool
cfd = accept lfd 524288
if lt cfd 0
ret false
end
tot = ulong 0
for it ulong 16
got = read int cfd ecReqBuf tot sub 262144 tot
if le got 0
break
end
tot = add tot ulong got
if ge tot 16
if and eq get ecReqBuf 0 71 eq get ecReqBuf 1 69
break
end
if ecHasJsonEnd tot
break
end
end
end
if lt tot 12
c0 = fclose int cfd
ret false
end
if and eq get ecReqBuf 0 71 eq get ecReqBuf 5 104
put ecRespLen 0 0
ecAppStr ecHealthA
ecAppModelType
ecAppStr ecHealthB
ecAppU get engSpec MS_H
ecAppStr ecHealthC
ecAppU get engSpec MS_LAYERS
ecAppStr ecHealthD
ecAppU get engSpec MS_MAX_CTX
ecAppStr ecHealthE
ecSendJson int cfd
c0 = fclose int cfd
ret false
end
if and eq get ecReqBuf 0 71 eq get ecReqBuf 5 118
put ecRespLen 0 0
ecAppStr ecModelsA
ecAppModelType
ecAppStr ecModelsB
ecSendJson int cfd
c0 = fclose int cfd
ret false
end
if ne get ecReqBuf 0 80
w4 = write int cfd ecHdr404 0 len ecHdr404
c0 = fclose int cfd
ret false
end
slot = ecB8FindFree
if lt slot 0
c0 = fclose int cfd
ret false
end
ecB8InitSlot ulong slot int cfd tot
ret true
end

fn ecB8RunSingleFast b ulong to void
fd = get ecB8Fd b
ntok = get ecB8Plen b
maxToks = get ecB8Max b
base = mul b 2048
for i ulong ntok bound 2048
put q36TokOutIds i get ecB8Ptoks add base i
end
genCnt = ecRunChat ntok maxToks
put ecRespLen 0 0
ecAppStr ecChatA
ecAppModelType
ecAppStr ecChatB
ecAppJsonEsc get ecGenTextLen 0
ecAppStr ecChatC
ecAppU ntok
ecAppStr ecChatD
ecAppU genCnt
ecAppStr ecChatE
ecAppU add ntok genCnt
ecAppStr ecChatF
ecAppU get ecTimings 0
ecAppStr ecChatG
ecAppU get ecTimings 1
ecAppStr ecChatArb
ecAppU q4ArbHitPctX10
ecAppStr ecChatH
ecSendJson fd
c0 = fclose fd
put ecB8Fd b int -1
put ecB8State b 0
put q4B8Active b 0
end

fn ecB8StepAll to void
needLog = false
for b ulong Q4_B8
st = get ecB8State b
if eq st 0
put q4B8InTok b 0
put q4B8InPos b 0
else
if eq st 1
pidx = get ecB8Pidx b
plen = get ecB8Plen b
tok = ulong get ecB8Ptoks add mul b 2048 pidx
put q4B8InTok b tok
put q4B8InPos b pidx
if eq add pidx 1 plen
needLog = true
end
else
put q4B8InTok b get q4B8OutTok b
put q4B8InPos b get ecB8Pos b
needLog = true
end
end
end
if not q4B8StepDecode needLog
for b ulong Q4_B8
if ne get ecB8State b 0
ecB8SendDone b
end
end
ret
end
for b ulong Q4_B8
st = get ecB8State b
if eq st 1
pidx = add get ecB8Pidx b 1
plen = get ecB8Plen b
put ecB8Pidx b pidx
put ecB8Pos b pidx
if ge pidx plen
put ecB8T1 b ulong monons
tok = get q4B8OutTok b
if or ecIsStop tok ge 1 get ecB8Max b
if not ecIsStop tok
ecB8AppTokText b tok
put ecB8Gen b 1
end
ecB8SendDone b
else
ecB8AppTokText b tok
put ecB8Gen b 1
put ecB8State b 2
end
end
else
if eq st 2
put ecB8Pos b add get ecB8Pos b 1
tok = get q4B8OutTok b
g = add get ecB8Gen b 1
if ecIsStop tok
ecB8SendDone b
else
ecB8AppTokText b tok
put ecB8Gen b g
if ge g get ecB8Max b
ecB8SendDone b
end
end
end
end
end
end

fn ecServeB8 lfd int to void
for b ulong Q4_B8
put ecB8Fd b int -1
put ecB8State b 0
put q4B8Active b 0
end
for iter ulong 100000000
nAct = ecB8CountAct
if eq nAct 0
w0 = waitio lfd int 1 long 1000000000
if le w0 0
continue
end
ok0 = ecB8AcceptOne lfd
nAct = ecB8CountAct
if eq nAct 0
continue
end
note Wait 5 ms to batch any concurrent burst arriving together!
for k ulong 7
if ge nAct Q4_B8
break
end
w1 = waitio lfd int 1 long 5000000
if le w1 0
break
end
ok1 = ecB8AcceptOne lfd
nAct = ecB8CountAct
end
note If still only 1 request (C=1), run fast zero-overhead B=1 path!
if eq nAct 1
for b ulong Q4_B8
if ne get ecB8State b 0
ecB8RunSingleFast b
end
end
continue
end
else
for k ulong 8
if ge nAct Q4_B8
break
end
w2 = waitio lfd int 1 long 0
if le w2 0
break
end
ok2 = ecB8AcceptOne lfd
nAct = ecB8CountAct
end
end
ecB8StepAll
end
end

fn ecParseFlags to void
put ecGenN 0 24
put ecPort 0 18095
put ecSelfTest 0 0
put ecUseLong 0 0
put engUseNvfp4 0 0
put bonUseApu 0 1
put bonUseNvfp4 0 0
put bonLmNCpu 0 0
put bmUseMtp 0 1
put bmMtpK 0 3
a = new uchar 32 0
ai = ulong 3
while lt ai ulong argcnt bound 16
al = argread ai a 0 30
c0 = get a 0
c2 = get a 2
if and ge al 1 and ge c0 48 le c0 57
put ecGenN 0 ecParseU ai
end
if eq c0 45
if and ge al 6 eq c2 112
if lt add ai 1 ulong argcnt
ai = add ai 1
put ecPort 0 ecParseU ai
end
end
if and ge al 6 eq c2 115
put ecSelfTest 0 1
end
if and ge al 6 eq c2 108
put ecUseLong 0 1
end
if and ge al 7 and eq c2 110 eq get a 3 118
put bonUseNvfp4 0 1
put engUseNvfp4 0 1
end
if and ge al 8 and eq c2 110 eq get a 3 111
if eq get a 5 109
put bmUseMtp 0 0
else
put bonUseApu 0 0
end
end
if and ge al 10 eq c2 97
if lt add ai 1 ulong argcnt
ai = add ai 1
put bonLmNCpu 0 ecParseU ai
end
end
end
ai = add ai 1
end
end

fn main to int
engPrint ecBanner
if lt argcnt 3
engPrint ecUsage
ret 1
end
cmd = new uchar 32 0
cl = argread 1 cmd 0 30
put ecMode 0 0
if and ge cl 3 eq get cmd 0 114
put ecMode 0 1
else
if and ge cl 5 eq get cmd 0 115
put ecMode 0 2
else
if and ge cl 5 eq get cmd 0 107
put ecMode 0 3
end
end
end
dl = argread 2 engModelDir 0 500
if le dl 0
engPrint ecUsage
ret 1
end
put engModelDirLen 0 ulong dl
ecParseFlags

if ggDetectAndOpen
if not ggParseFile
engPrint ecErrCfg
ret 2
end
else
if not engLoadConfig
engPrint ecErrCfg
ret 2
end
if not stIndexModel
engPrint ecErrSt
ret 3
end
end
ecPrintInspect
if eq get ecMode 0 0
ret 0
end
if and gt get engSpec MS_NEXP 0 ne get engSpec MS_ARCH 3
engPrint ecErrMoe
ret 0
end
if not ecLoadTok
engPrint ecTokFail
ret 4
end
engPrint ecTokOk
if eq get engUseNvfp4 0 1
engPrint ecFmtNvfp4
else
engPrint ecFmtW4
end
engPrint ecLoading
t0 = ulong monons
irc = int 0
if eq get ggIsGguf 0 1
irc = bonGpuInit
else
irc = engGpuInit
end
if ne irc 0
engPrint ecErrGpu
engPrintU ulong irc
engPrint ecNl
ret irc
end
if eq get ecMode 0 3
krc = ecRunKtest
rc = nvstop
ret krc
end
lrc = int 0
if eq get ggIsGguf 0 1
lrc = bonLoadAll
else
if eq get engSpec MS_ARCH 3
lrc = q4LoadAll
if eq lrc 0
if not q4B8Init
lrc = int 19
end
end
else
lrc = engLoadAll
end
end
if ne lrc 0
engPrint ecErrGpu
engPrintU ulong lrc
engPrint ecNl
rc = nvstop
ret lrc
end
t1 = ulong monons
engPrint ecLoaded
engPrintU div sub t1 t0 1000000
engPrint ecNl

if or eq get ecMode 0 1 eq get ecSelfTest 0 1
rrc = ecRunSelfOrCli
bonApuStop
q4ApuStop
rc = nvstop
ret rrc
end

port = get ecPort 0
lfd = ecListen port
if lt lfd 0
bonApuStop
q4ApuStop
rc = nvstop
ret 40
end
engPrint ecListenA
engPrintU port
engPrint ecListenB
if eq get q4B8Ready 0 1
ecServeB8 int lfd
else
for conn ulong 1000000
cfd = accept int lfd 524288
if ge cfd 0
ecHandleHttp int cfd
c0 = fclose int cfd
end
end
end
c1 = fclose int lfd
bonApuStop
q4ApuStop
rc = nvstop
ret 0
end

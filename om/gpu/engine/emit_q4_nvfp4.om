fn engNvfp4Kernel mode ulong to bool
if eq mode 420
uFp8ToNvfp4Quant
ret true
end
if eq mode 421
uBf16ToNvfp4Quant
ret true
end
if eq mode 422
uNvfp4Gemv4R512
ret true
end
if eq mode 423
uNvfp4GemmB8
ret true
end
if eq mode 424
uMoeNvfp4Gu
ret true
end
if eq mode 425
uMoeNvfp4DnAdd
ret true
end
if eq mode 426
uNvfp4GemvAnyK
ret true
end
ret false
end

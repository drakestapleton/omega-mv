note =========================================================================
note Mode 306: uFaPrepKv -- Shape-parameterized KV prep (optional k_norm + RoPE + KV cache store)
note   Specialized for nKV, hd (128 or 256), ropeDims, qkNorm, addOne, eps!
note Args: K_in (R0:1), V_in (R2:3), k_norm (R4:5), rope (R6:7), K_cache (R8:9), V_cache (R10:11), pos_ptr (R12:13).
note Grid: (nKV, 1, 1), Block: hd (128 or 256), SMEM: 1088.
note =========================================================================
fn uEmitQkNormBlock to void
hd = get engSpec MS_HD
nWarps = div hd 32
invHd = div f32 1.0f32 f32 hd
eps = mul f32 get engSpec MS_EPS_E6 f32 0.000001f32
qic 32 48 21 21 0 qAlu4
qWarpRedSum 48 52 16
qic 18 52 14 QZ 31 qAlu4
qic 17 53 14 QZ 5 qAlu4
qLit 55 1024
qLit 57 1
bKw = qBssy
qic 28 QZ 52 57 0 qCmp
skKw = qBraFwd 1
qMad 53 53 4 55
qic 50 QZ 53 48 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skKw 1
qBsync bKw
qBar
qNum 48 0.0f32
for w ulong nWarps bound 8
qLit 56 add 1024 mul w 4
qic 49 49 56 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 30 48 48 49 0 qAlu4
end
qNum 49 invHd
qNum 50 eps
qic4 33 48 48 49 50 qAlu4
qic 41 49 48 QZ 0 qMufu
qic 0 QZ QZ QZ 0 qW0
if eq get engSpec MS_NORM_ADD1 1
qNum 50 1.0f32
qic 30 23 23 50 0 qAlu4
end
qic 32 21 21 49 0 qAlu4
qic 32 21 21 23 0 qAlu4
end

fn uEmitRopeBlock ropePtrReg ulong to void
ropeD = get engSpec MS_ROPE_DIMS
halfR = div ropeD 2
qMad 53 14 4 QZ
qic 50 QZ 53 21 0 qSt
qic 0 QZ QZ QZ 0 qW1
qBar
qLit 57 ropeD
bRp = qBssy
qic 28 QZ 14 57 0 qCmp
skRp = qBraFwd 1
qic 18 25 14 QZ sub halfR 1 qAlu4
qMad 26 20 ropeD 25
qicImm 9 16 26 ropePtrReg 4 qW1
qic 11 27 16 QZ 0 qLd
qLit 52 halfR
qIadd 28 26 52
qicImm 9 16 28 ropePtrReg 4 qW1
qic 11 29 16 QZ 0 qLd
qMad 53 25 4 QZ
qic 49 30 53 QZ 0 qLd
qIadd 54 25 52
qMad 54 54 4 QZ
qic 49 31 54 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 32 32 30 27 0 qAlu4
qic 32 33 31 29 0 qAlu4
qic 31 32 32 33 0 qAlu4
qic 32 34 31 27 0 qAlu4
qic4 33 34 30 29 34 qAlu4
qic 28 QZ 14 52 0 qCmp
qicImm 8 21 32 QZ 1 qAlu4
put q36Guard 0 1
qicImm 8 21 34 QZ 1 qAlu4
qPatch skRp 1
qBsync bRp
end

fn uFaPrepKv to void
hd = get engSpec MS_HD
kvStride = mul get engSpec MS_NKV hd
qStart 7
qLit 52 0
qicImm 9 16 52 12 4 qW1
qic 11 20 16 QZ 0 qLd
qMad 24 15 hd 14
qicImm 9 16 24 0 4 qW1
qic 11 21 16 QZ 0 qLd
qicImm 9 16 24 2 4 qW1
qic 11 22 16 QZ 0 qLd
if eq get engSpec MS_QK_NORM 1
qicImm 9 16 14 4 4 qW1
qic 11 23 16 QZ 0 qLd
end
qic 0 QZ QZ QZ 0 qW0
if eq get engSpec MS_QK_NORM 1
uEmitQkNormBlock
end
uEmitRopeBlock 6
qMad 25 20 kvStride 24
qicImm 9 16 25 8 4 qAlu4
qic 12 QZ 16 21 0 qSt
qic 0 QZ QZ QZ 0 qW1
qicImm 9 16 25 10 4 qAlu4
qic 12 QZ 16 22 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

fn uFaPrepQ to void
hd = get engSpec MS_HD
qInStride = hd
if eq get engSpec MS_ATTN_GATE 1
qInStride = mul hd 2
end
scaleQ = f32 0.0625f32
if eq hd 128
scaleQ = f32 0.0883883476f32
end
qStart 5
qLit 52 0
qicImm 9 16 52 8 4 qW1
qic 11 20 16 QZ 0 qLd
qMad 24 15 qInStride 14
qicImm 9 16 24 0 4 qW1
qic 11 21 16 QZ 0 qLd
if eq get engSpec MS_QK_NORM 1
qicImm 9 16 14 2 4 qW1
qic 11 23 16 QZ 0 qLd
end
qic 0 QZ QZ QZ 0 qW0
if eq get engSpec MS_QK_NORM 1
uEmitQkNormBlock
end
uEmitRopeBlock 4
qNum 50 scaleQ
qic 32 21 21 50 0 qAlu4
qMad 25 15 hd 14
qicImm 9 16 25 6 4 qAlu4
qic 12 QZ 16 21 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

note =========================================================================
note Mode 308: uFaAttendSplitF32 -- Shape-parameterized Split-K (S=8) F32 Flash-Decoding
note   Supports ANY nQ, nKV (GQA ratio G = nQ/nKV), hd in {128, 256}!
note Args: Q_rot (R0:1), K_cache (R2:3), V_cache (R4:5), O_part (R6:7), ml_part (R8:9), pos_ptr (R10:11).
note Grid: (nQ, 8, 1), Block: 32, SMEM: 0.
note =========================================================================
fn uFaSplitInner epLane ulong advBytes ulong to void
qic 57 40 48 QZ 0 qLd
if eq epLane 8
qic 57 44 48 QZ 16 qLd
end
qic 57 52 50 QZ 0 qLd
if eq epLane 8
qic 57 56 50 QZ 16 qLd
end
qic 0 QZ QZ QZ 0 qW0
qic 32 2 20 40 0 qAlu4
for j ulong sub epLane 1 bound 7
qic4 33 2 add 21 j add 41 j 2 qAlu4
end
qWarpBflySum 2 3
qic 37 3 36 2 0 qAlu4
qic 31 4 36 3 0 qAlu4
qExp 4 4 38
qic 31 5 2 3 0 qAlu4
qExp 5 5 38
qic 32 37 37 4 0 qAlu4
qic 30 37 37 5 0 qAlu4
qicImm 8 36 3 QZ 1 qAlu4
for j ulong sub epLane 1 bound 7
qic 32 add 28 j add 28 j 4 0 qAlu1
end
last = sub epLane 1
qic 32 add 28 last add 28 last 4 0 qAlu4
for j ulong last bound 7
qic4 33 add 28 j 5 add 52 j add 28 j qAlu1
end
qic4 33 add 28 last 5 add 52 last add 28 last qAlu4
qicImm 9 48 1 48 advBytes qAlu1
qicImm 9 50 1 50 advBytes qAlu1
end

fn uFaAttendSplitF32 to void
hd = get engSpec MS_HD
epLane = div hd 32
kvStride = mul get engSpec MS_NKV hd
qStart 6
uEmitDivByG 12 15 div get engSpec MS_NQ get engSpec MS_NKV
qLit 52 0
qicImm 9 16 52 10 4 qW1
qic 11 13 16 QZ 0 qLd
qMad 52 15 hd QZ
qMad 52 14 epLane 52
qicImm 9 16 52 0 4 qW1

note SPDX-License-Identifier: AGPL-3.0-only
note om/gpu/engine/emit_generic.om: Shape-Parameterized Pure Seeded-OM-2 SM121 SASS Kernel Generator.
note Emits specialized SM121 Blackwell machine code at runtime for ANY ModelSpec (engSpec):
note   - uRmsNormAdd(H, addOne, eps)       : Any H % 256 == 0; (1+w) for Qwen3.5/3.8/4/Gemma or w for Llama/Qwen2/Mistral
note   - uSwiGlu(I)                        : Any I % 256 == 0 (dense MLP or MoE)
note   - uBf16ToW4Quant(K)                 : On-GPU BF16 -> W4 block-32 quantizer for ANY K % 64 == 0, any N
note   - uBf16Gemv1R(K)                    : Universal BF16 GEMV for ANY K % 256 == 0, any N (BF16 models & in_proj_a/b)
note   - uBf16RescoreCands(H)              : Exact Two-Pass BF16 lm_head rescoring for ANY H % 256 == 0
note   - uArgmaxEmbedStep(H)               : Fused 128-cand argmax + BF16->F32 embed + pos++ for ANY H % 256 == 0
note   - uFaPrepKv(nKV, hd, ropeD, qkN, a1): Per-head optional k_norm + partial/full RoPE + 128K KV store (hd=128 or 256)
note   - uFaPrepQ(nQ, hd, ropeD, qkN, a1, g): Per-head optional q_norm + RoPE + 1/sqrt(hd) (gated or ungated QKV)
note   - uFaAttendSplitF32(nQ, nKV, hd)    : Warp-only Split-K (S=8) F32 Flash-Decoding for ANY GQA ratio (nQ/nKV) & hd=128/256
note   - uFaReduceGate(hd, attnGate)       : Split-K combine + optional sigmoid(gate) for ANY nQ, hd=128/256
note   - uGdnStepReal(nK, nV)              : Fused decay/beta + 30 KiB SMEM GDN + Gated RMSNorm for ANY nV/nK (32/16, 48/16, etc.)
note Reuses from om/gpu/q36/emit_fast.om & om/gpu/q38/emit_q38.om:
note   - q38W4Gemv4R (4 KiB streaming SMEM W4 GEMV for ANY K % 1024 == 0, ANY N)
note   - qFp8ToW4B32Quant (on-GPU FP8 block-128 -> W4 block-32 quantizer for ANY K % 128 == 0, N % 32 == 0)
note   - qFp8B128GemvFast (Exact FP8 block-128 GEMV for ANY K, N)
note   - qGdnConvL2Fast (causal Conv1d + SiLU + L2-norm for any Grid=(nQ+nK+nV, 1, 1))
note   - vocab_chunk_top64 (64-chunk top-128 candidate screener)
note   - qPreW4GemmHmma / qPreCopyU32

note Helper: compute exact magic multiplier & shift for unsigned division by G (1..64)
fn uGqaDivShift G ulong to ulong
if eq G 1
ret 0
end
if eq G 2
ret 1
end
if eq G 3
ret 17
end
if eq G 4
ret 2
end
if eq G 6
ret 18
end
if eq G 8
ret 3
end
if eq G 12
ret 19
end
if eq G 16
ret 4
end
ret 0
end

fn uGqaDivMul G ulong to ulong
if or eq G 3 or eq G 6 eq G 12
ret 43691
end
ret 1
end

fn uEmitDivByG dstReg ulong srcReg ulong G ulong to void
if eq G 1
qicImm 8 dstReg srcReg QZ 1 qAlu4
ret
end
sh = uGqaDivShift G
ml = uGqaDivMul G
if eq ml 1
qic 17 dstReg srcReg QZ sh qAlu4
else
qMad dstReg srcReg ml QZ
qic 17 dstReg dstReg QZ sh qAlu4
end
end

note =========================================================================
note Mode 300: uRmsNormAdd -- Shape-parameterized RMSNorm + optional residual add
note   Specialized at emit time for H (MS_H), addOne (MS_NORM_ADD1), eps (MS_EPS_E6).
note Args: x_inout[H] (R0:1), add_in[H] (R2:3), norm_w[H] (R4:5), out_xn[H] (R6:7), do_add (32).
note Grid: (1, 1, 1), Block: 256, SMEM: 64.
note =========================================================================
fn uRmsNormAdd to void
H = get engSpec MS_H
nIter = div H 256
addOne = get engSpec MS_NORM_ADD1
eps = mul f32 get engSpec MS_EPS_E6 f32 0.000001f32
invH = div f32 1.0f32 f32 H
qStart 4
qParam 18 32
qNum 48 0.0f32
qLit 20 0
qLit 21 nIter
qLit 22 1
mSum = get q36Pc 0
qMad 52 20 256 14
qicImm 9 16 52 0 4 qW1
qic 11 24 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
bA = qBssy
qic 28 QZ 18 22 0 qCmp
skA = qBraFwd 2
qicImm 9 32 52 2 4 qW1
qic 11 34 32 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 30 24 24 34 0 qAlu4
qic 12 QZ 16 24 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skA 2
qBsync bA
qic4 33 48 24 24 48 qAlu4
qIadd 20 20 22
qic 28 QZ 20 21 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mSum get q36Pc 0 qAlu4
qWarpRedSum 48 52 16
qic 18 52 14 QZ 31 qAlu4
qic 17 53 14 QZ 5 qAlu4
bW = qBssy
qic 28 QZ 52 22 0 qCmp
skW = qBraFwd 1
qMad 53 53 4 QZ
qic 50 QZ 53 48 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skW 1
qBsync bW
qBar
qNum 48 0.0f32
for w ulong 8
qLit 55 mul w 4
qic 49 49 55 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 30 48 48 49 0 qAlu4
end
qNum 49 invH
qNum 50 eps
qic4 33 48 48 49 50 qAlu4
qic 41 49 48 QZ 0 qMufu
qic 0 QZ QZ QZ 0 qW0
qNum 50 1.0f32
qLit 20 0
mOut = get q36Pc 0
qMad 52 20 256 14
qicImm 9 16 52 0 4 qW1
qic 11 24 16 QZ 0 qLd
qicImm 9 32 52 4 4 qW1
qic 11 34 32 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
if eq addOne 1
qic 30 34 34 50 0 qAlu4
end
qic 32 35 24 49 0 qAlu4
qic 32 35 35 34 0 qAlu4
qicImm 9 16 52 6 4 qAlu4
qic 12 QZ 16 35 0 qSt
qic 0 QZ QZ QZ 0 qW1
qIadd 20 20 22
qic 28 QZ 20 21 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mOut get q36Pc 0 qAlu4
end

note =========================================================================
note Mode 301: uSwiGlu -- Shape-parameterized Dense SwiGLU silu(gate)*up for ANY I % 256 == 0
note Args: GU[B, 2*I] (R0:1), out[B, I] (R2:3), I (16).
note Grid: (I/256, B, 1), Block: 256, SMEM: 0.

tSn = ggFindLayer L gSufSsmNorm
if or lt tConv 0 lt tSn 0
ret false
end
va0 = bonLoadF32 ulong tConv
if eq va0 0
ret false
end
put engLA4SVa L va0
va0 = bonLoadF32 ulong tSn
if eq va0 0
ret false
end
put engLQNormVa L va0
va0 = bonLoadGdnAbBf16 L
if eq va0 0
ret false
end
put engLA4WVa L va0
va0 = bonLoadGdnAlogDt L
if eq va0 0

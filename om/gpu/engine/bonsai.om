fn bonLoadAll to int
bonBuildCpuLut
if not engUploadRope
ret 13
end
if not bonUploadSigns
ret 13
end
tEmb = ggFindExact gNmEmb len gNmEmb
tOut = ggFindExact gNmOut len gNmOut
tFn = ggFindExact gNmFNorm len gNmFNorm
if or lt tEmb 0 or lt tOut 0 lt tFn 0
ret 14
end
put bonEmbRawOff 0 add get ggDataStart 0 get ggTOff ulong tEmb
put bonLmRawOff 0 add get ggDataStart 0 get ggTOff ulong tOut
H = get engSpec MS_H
V = get engSpec MS_VOCAB
put bonLmNAll 0 V
if eq get bonUseApu 0 1
if eq get bonLmNCpu 0 0
put bonLmNCpu 0 512
end
if ge get bonLmNCpu 0 V
put bonLmNCpu 0 0
end
note Keep bonLmNGpu a multiple of 4 for 4-row tiled PTQ1_0!
ng = mul div sub V get bonLmNCpu 0 4 4
put bonLmNGpu 0 ng
put bonLmNCpu 0 sub V ng
else
put bonLmNCpu 0 0
put bonLmNGpu 0 V
end
if not bonCopySmall ulong tFn get engWork 0 EW_FNORM mul H 4
ret 14
end
if not bonLoadTiledSlice ulong tOut get bonLmNAll 0
ret 14
end
put bonLmT 0 get bonTResVa 0
nL = get engSpec MS_LAYERS
for L ulong nL bound 128
if not bonLoadLayer L
ret 15
end
end
if not bonRecordPackets
ret 16
end
if not bmLoadAndRecord
ret 17
end
bonApuInit
ret 0
end

fn bonResetState to void
if gt get engSlotLen 16 0
okZ = engReplayPre 16
put engCurPos 0 0
ret
end
for i ulong 65536
put engIoBuf i 0
end
nGdn = get engSpec MS_N_GDN
nV = get engSpec MS_GDN_NV
nK = get engSpec MS_GDN_NK
sTot = mul nGdn mul nV 32768
engZeroMap get engGdnStateMap 0 div add sTot 65535 65536
qkvN = add mul nK 256 mul nV 128
tTot = mul nGdn mul qkvN 12
engZeroMap get engGdnTailMap 0 div add tTot 65535 65536
put engCurPos 0 0
end

fn bonStepDecode to ulong
if eq get bonApuReady 0 0
if not engReplayPre 3
ret 999999
end
if ne mapread get bonApuShm 0 APU_SHM_BEST engIoBuf 0 8 8
ret 999999
end
ret ulong engGetU32Io 4
end
if not engReplayPre 0
ret 999999
end
r0 = mapset get gbmem 2 8192 4 0
r1 = mapset get gbmem 3 0 4 0
r2 = mapset get gbmem 3 16 4 0
if not nvsend get engWork 0 get engSlotOff 2 uint div get engSlotLen 2 4
ret 999999
end
put bonPipeMsg 0 1
for w ulong 20
wr = write get bonGoFds w bonPipeMsg 0 1
end
if not engWaitFast 10000000000
ret 999999
end
if ne mapread get bonApuShm 0 APU_SHM_BEST engIoBuf 0 8 8
ret 999999
end
bestVal = bitcast f32 engGetU32Io 0
bestIdx = ulong engGetU32Io 4
for w ulong 20
rd = read get bonResFds w bonPipeMsg 0 8
fv = bitcast f32 bonGetU32Msg 0
idx = ulong bonGetU32Msg 4
if gt fv bestVal
bestVal = fv
bestIdx = idx
end
end
ret bestIdx
end

fn bonPrefillAndFirst ntok ulong to ulong
bonResetState
for i ulong ntok bound 4096
if not bonLoadEmbedCpu ulong get engTokSeq i
ret 999999
end
if not bonSetPos i
ret 999999
end
if eq add i 1 ntok
tok = bonStepDecode
put engCurPos 0 ntok
ret tok
else
if not engReplayPre 1
ret 999999
end
end
end
ret 999999
end

global bonProfUs ulong 8
text bonDbgM4 "M4_PROBE (copy rms fwht ptq1M4_ok ptq1M4_us gdnM4 faM4 mlpM4 s6_ok s6_us mtp4_ok mtp4_us): "
text bonP1 "PROF_1TOK: trunk_us="
text bonP2 " lm_gpu_us="
text bonP3 " ptq1_34816x5120_us="
text bonP4 " fwht5120_us="

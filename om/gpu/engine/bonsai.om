for i ulong 17408
engPutU32Io mul i 4 bitcast uint get ggSign17408 i
end
if ne mapwrite get engWork 0 BW_SIGN17408 engIoBuf 0 69632 69632
ret false
end
ret true
end

fn bonLoadFaSub L ulong to bool
tQ = ggFindLayer L gSufQ
tK = ggFindLayer L gSufK
tV = ggFindLayer L gSufV

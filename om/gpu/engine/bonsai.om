global bonCurMap long 1
global bonCurOff ulong 1
global bonCurVa ulong 1

fn bonSlabAllocMap bytes ulong to bool
al = mul div add bytes 4095 4096 4096
cnt = get engSlabCnt 0
if gt cnt 0
last = sub cnt 1
used = get engSlabUsed last
if le add used al ENG_SLAB_SZ
put engSlabUsed last add used al
put bonCurMap 0 get engSlabMap last
put bonCurOff 0 used
put bonCurVa 0 add get engSlabVa last used
ret true
end
end
if ge cnt 16
ret false
end
sm = nvalloc ENG_SLAB_SZ true
if le sm 0
ret false
end
sva = mapaddr sm
put engSlabMap cnt sm
put engSlabVa cnt sva
put engSlabUsed cnt al
put engSlabCnt 0 add cnt 1
put bonCurMap 0 sm
put bonCurOff 0 0
put bonCurVa 0 sva
ret true
end

fn bonLoadF32 tid ulong to ulong
n = mul get ggDim0 tid get ggDim1 tid
nb = mul n 4
if not bonSlabAllocMap nb
ret 0
end
dm = get bonCurMap 0
doff = get bonCurOff 0
va = get bonCurVa 0
foff = add get ggDataStart 0 get ggTOff tid
fd = get ggFd 0
done = ulong 0
while lt done nb bound 4096
ch = sub nb done
if gt ch 1048576
ch = ulong 1048576
end
if ne pread fd engIoBuf 0 ch long add foff done long ch
ret 0
end
if ne mapwrite dm add doff done engIoBuf 0 ch long ch
ret 0
end
done = add done ch
end
ret va
end

fn bonPackF32ToBf16 elems ulong to void
for i ulong elems bound 524288
u = engGetU32Io mul i 4
r = add u add 32767 and shr u 16 1
bf = shr r 16
put engWideBuf mul i 2 uchar and bf 255
put engWideBuf add mul i 2 1 uchar and shr bf 8 255
end
end

fn bonLoadGdnAbPart tid ulong dm long dstOff ulong elems ulong to bool
f32B = mul elems 4
bfB = mul elems 2
foff = add get ggDataStart 0 get ggTOff tid
if ne pread get ggFd 0 engIoBuf 0 f32B long foff long f32B
ret false
end
bonPackF32ToBf16 elems
ret eq mapwrite dm dstOff engWideBuf 0 bfB long bfB
end

fn bonLoadGdnAbBf16 L ulong to ulong
tA = ggFindLayer L gSufAlpha
tB = ggFindLayer L gSufBeta
if or lt tA 0 lt tB 0
ret 0
end
elems = mul get engSpec MS_GDN_NV get engSpec MS_H
bfB = mul elems 2
if not bonSlabAllocMap mul bfB 2
ret 0
end
dm = get bonCurMap 0
doff = get bonCurOff 0
va = get bonCurVa 0
if not bonLoadGdnAbPart ulong tA dm doff elems
ret 0
end
if not bonLoadGdnAbPart ulong tB dm add doff bfB elems
ret 0
end
ret va
end

fn bonCopySmall tid ulong dm long dstOff ulong nb ulong to bool
foff = add get ggDataStart 0 get ggTOff tid
got = pread get ggFd 0 engIoBuf 0 nb long foff
if ne got long nb
ret false
end
ret eq mapwrite dm dstOff engIoBuf 0 nb long nb
end

fn bonLoadGdnAlogDt L ulong to ulong
tA = ggFindLayer L gSufSsmA
tD = ggFindLayer L gSufSsmDt
if or lt tA 0 lt tD 0
ret 0
end
nb = mul get engSpec MS_GDN_NV 4
if not bonSlabAllocMap mul nb 2
ret 0
end
dm = get bonCurMap 0
doff = get bonCurOff 0
va = get bonCurVa 0
if not bonCopySmall ulong tA dm doff nb
ret 0
end
if not bonCopySmall ulong tD dm add doff nb nb
ret 0
end
ret va
end

note =========================================================================
note 896-Byte 4-Row Contiguous Tile PTQ1_0 Loader!
note Packs every 4 rows x 8 blocks (4 x 1024 w = 896 B) into:
note   [0..511]   : 32 lanes x 16 B (W_a -> 512 B coalesced LDG.E.128!)
note   [512..767] : 32 lanes x  8 B (W_b -> 256 B coalesced LDG.E.64!)
note   [768..895] : 32 lanes x  4 B (W_c -> 128 B coalesced LDG.E.32!)
note =========================================================================
global bonTDstMap long 1
global bonTDstOff ulong 1
global bonTResVa ulong 1

fn bonCopyBlk28 src ulong tBase ulong lane ulong to void
da = add tBase mul lane 16
db = add add tBase 512 mul lane 8
dc = add add tBase 768 mul lane 4
for j ulong 16
put bonTileOut add da j get bonRaw4Buf add src j
end
for j ulong 8
put bonTileOut add db j get bonRaw4Buf add add src 16 j
end
for j ulong 4
put bonTileOut add dc j get bonRaw4Buf add add src 24 j
end
end

fn bonPackChunk4 rgRawOff ulong tBase ulong cByte ulong rowBytes ulong to void
for sr ulong 4
rOff = add add rgRawOff mul sr rowBytes cByte
for blk ulong 8
bonCopyBlk28 add rOff mul blk 28 tBase add mul sr 8 blk
end
end
end

fn bonPackOneTile4 rgRawOff ulong rgTileOff ulong nChunks ulong to void
rowBytes = mul nChunks 224
for c ulong nChunks bound 64
bonPackChunk4 rgRawOff add rgTileOff mul c 896 mul c 224 rowBytes
end
end

fn bonTileBatch foff ulong dstOff ulong cnt ulong nChunks ulong to bool
rgBytes = mul nChunks 896
nb = mul cnt rgBytes
if ne pread get ggFd 0 bonRaw4Buf 0 nb long foff long nb
ret false
end
for g ulong cnt bound 256
bonPackOneTile4 mul g rgBytes mul g rgBytes nChunks
end
ret eq mapwrite get bonTDstMap 0 dstOff bonTileOut 0 nb long nb
end

fn bonStreamTiledRange tid ulong nRows ulong byteOff ulong to bool
nChunks = div get ggDim0 tid 1024
rgBytes = mul nChunks 896
nRg = div nRows 4
batchRg = div 1048576 rgBytes
if eq batchRg 0
batchRg = ulong 1
end
foff = add get ggDataStart 0 get ggTOff tid
dstBase = add get bonTDstOff 0 byteOff
done = ulong 0
while lt done nRg bound 100000
cnt = sub nRg done
if gt cnt batchRg
cnt = batchRg
end
if not bonTileBatch add foff mul done rgBytes add dstBase mul done rgBytes cnt nChunks
ret false
end
done = add done cnt
end
ret true
end

fn bonAllocTiled totBytes ulong to bool
if not bonSlabAllocMap totBytes
ret false
end
put bonTDstMap 0 get bonCurMap 0
put bonTDstOff 0 get bonCurOff 0
put bonTResVa 0 get bonCurVa 0
ret true
end

fn bonLoadTiled1 tid ulong to bool
nb = mul div mul get ggDim0 tid get ggDim1 tid 128 28
if not bonAllocTiled nb
ret false
end
ret bonStreamTiledRange tid get ggDim1 tid 0
end

fn bonLoadTiled2 t0 ulong t1 ulong to bool
b0 = mul div mul get ggDim0 t0 get ggDim1 t0 128 28
b1 = mul div mul get ggDim0 t1 get ggDim1 t1 128 28
if not bonAllocTiled add b0 b1
ret false
end
if not bonStreamTiledRange t0 get ggDim1 t0 0
ret false
end
ret bonStreamTiledRange t1 get ggDim1 t1 b0
end

fn bonLoadTiled3 t0 ulong t1 ulong t2 ulong to bool
b0 = mul div mul get ggDim0 t0 get ggDim1 t0 128 28
b1 = mul div mul get ggDim0 t1 get ggDim1 t1 128 28
b2 = mul div mul get ggDim0 t2 get ggDim1 t2 128 28
if not bonAllocTiled add add b0 b1 b2
ret false
end
if not bonStreamTiledRange t0 get ggDim1 t0 0
ret false
end
if not bonStreamTiledRange t1 get ggDim1 t1 b0
ret false
end
ret bonStreamTiledRange t2 get ggDim1 t2 add b0 b1
end

fn bonLoadTiledSlice tid ulong nRows ulong to bool
nb = mul div mul get ggDim0 tid nRows 128 28
if not bonAllocTiled nb
ret false
end
ret bonStreamTiledRange tid nRows 0
end

note =========================================================================
note CPU-side PTQ1_0 embed dequant + inverse 1024-block FWHT -> uncached bonApuShm!
note =========================================================================
fn bonBuildCpuLut to void
for bv ulong 256
v = bv
for tr ulong 5
t = mul v 3
xi = shr t 8
v = and t 255
put bonCpuLut add mul bv 5 tr uchar xi
put bonCpuLutF add mul bv 5 tr sub f32 xi f32 1.0f32
end
end
end

fn bonFwht1024Cpu base ulong to void
h = ulong 1
while lt h 1024 bound 12
step = shl h 1
i = ulong 0
while lt i 1024 bound 1024
for j ulong h bound 512
p0 = add base add i j
p1 = add p0 h
a = get bonEmbF32 p0
b = get bonEmbF32 p1
put bonEmbF32 p0 add a b
put bonEmbF32 p1 sub a b
end
i = add i step
end
h = step
end
for j ulong 1024
put bonEmbF32 add base j mul get bonEmbF32 add base j f32 0.03125f32
end
end

fn bonEmbByte bv ulong dstOff ulong stride ulong cnt ulong d f32 to void
lb = mul bv 5
for tr ulong cnt bound 5
w = get bonCpuLutF add lb tr
put bonEmbF32 add dstOff mul tr stride mul w d
end
end

fn bonDequantEmbBlk b ulong to void
src = mul b 28
h = or ulong get bonEmbRowBuf add src 26 shl ulong get bonEmbRowBuf add src 27 8
d = bitcast f32 ggFp16ToF32Bits h
base = mul b 128
for m ulong 16
bonEmbByte ulong get bonEmbRowBuf add src m add base m 16 5 d
end
for m ulong 8
bonEmbByte ulong get bonEmbRowBuf add add src 16 m add add base 80 m 8 5 d
end
for j ulong 2
bonEmbByte ulong get bonEmbRowBuf add add src 24 j add add base 120 j 2 4 d
end
end

fn bonLoadEmbedCpu tok ulong to bool
H = get engSpec MS_H
nb = div H 128
rowBytes = mul nb 28
foff = add get bonEmbRawOff 0 mul tok rowBytes
if ne pread get ggFd 0 bonEmbRowBuf 0 rowBytes long foff long rowBytes
ret false
end
for b ulong nb bound 64
bonDequantEmbBlk b
end
nblks = div H 1024
for kb ulong nblks bound 8
bonFwht1024Cpu mul kb 1024
end
for i ulong H bound 8192
v = mul get bonEmbF32 i get ggSign5120 i
engPutU32Io mul i 4 bitcast uint v
end
note Write to UNCACHED host-coherent bonApuShm + APU_SHM_XINIT (zero stale GPU L2!)
ret eq mapwrite get bonApuShm 0 APU_SHM_XINIT engIoBuf 0 mul H 4 long mul H 4
end

fn bonSetPos pos ulong to bool
engPutU32Io 0 uint pos
note Write to UNCACHED host-coherent bonApuShm + APU_SHM_POS (zero stale GPU L2!)
ret eq mapwrite get bonApuShm 0 APU_SHM_POS engIoBuf 0 4 4
end

note =========================================================================
note Full-APU 20-Core CPU Pool (10x X925 @ 3.9 GHz + 10x A725 @ 2.8 GHz)
note =========================================================================
fn bonPinCore cpu ulong to void
m = new uchar 8 0
put m div cpu 8 uchar shl ulong 1 rem cpu 8
r = cpuset 0 m 0 8
end

fn bonPutU32Msg off ulong v uint to void
for j ulong 4
put bonPipeMsg add off j uchar and shr v mul j 8 255
end
end

fn bonGetU32Msg off ulong to uint
b0 = uint get bonPipeMsg off
b1 = shl uint get bonPipeMsg add off 1 8
b2 = shl uint get bonPipeMsg add off 2 16
b3 = shl uint get bonPipeMsg add off 3 24
ret or or b0 b1 or b2 b3
end

fn bonGetI32 b view uchar * off ulong to int
b0 = uint get b off
b1 = shl uint get b add off 1 8
b2 = shl uint get b add off 2 16
b3 = shl uint get b add off 3 24
ret int or or b0 b1 or b2 b3
end

fn bonWorkerLoadSlice r0 ulong rCnt ulong to void
rowBytes = ulong 1120
totB = mul rCnt rowBytes
foff = add get bonLmRawOff 0 mul r0 rowBytes
done = ulong 0
while lt done totB bound 256
ch = sub totB done
if gt ch 1048576
ch = ulong 1048576
end
got = pread get ggFd 0 bonCpuRawBuf done ch long add foff done
if le got 0
break
end
done = add done ulong got
end
nBlks = mul rCnt 40
for b ulong nBlks bound 262144
src = mul b 28
dlo = ulong get bonCpuRawBuf add src 26
dhi = ulong get bonCpuRawBuf add src 27
put bonCpuScaleBuf b bitcast f32 ggFp16ToF32Bits or dlo shl dhi 8
end
put bonCpuRowStart 0 r0
put bonCpuRowCnt 0 rCnt
end

fn bonCpuDotBlk blkIdx ulong xb ulong to f32
src = mul blkIdx 28
bsum = f32 0.0f32
for m ulong 16
lb = mul ulong get bonCpuRawBuf add src m 5
xm = add xb m
bsum = add bsum mul get bonCpuLutF lb get bonCpuX xm
bsum = add bsum mul get bonCpuLutF add lb 1 get bonCpuX add xm 16
bsum = add bsum mul get bonCpuLutF add lb 2 get bonCpuX add xm 32
bsum = add bsum mul get bonCpuLutF add lb 3 get bonCpuX add xm 48
bsum = add bsum mul get bonCpuLutF add lb 4 get bonCpuX add xm 64
end
for m ulong 8
lb = mul ulong get bonCpuRawBuf add add src 16 m 5
xm = add add xb 80 m
bsum = add bsum mul get bonCpuLutF lb get bonCpuX xm
bsum = add bsum mul get bonCpuLutF add lb 1 get bonCpuX add xm 8
bsum = add bsum mul get bonCpuLutF add lb 2 get bonCpuX add xm 16
bsum = add bsum mul get bonCpuLutF add lb 3 get bonCpuX add xm 24
bsum = add bsum mul get bonCpuLutF add lb 4 get bonCpuX add xm 32
end
for j ulong 2
lb = mul ulong get bonCpuRawBuf add add src 24 j 5
xm = add add xb 120 j
bsum = add bsum mul get bonCpuLutF lb get bonCpuX xm
bsum = add bsum mul get bonCpuLutF add lb 1 get bonCpuX add xm 2
bsum = add bsum mul get bonCpuLutF add lb 2 get bonCpuX add xm 4
bsum = add bsum mul get bonCpuLutF add lb 3 get bonCpuX add xm 6
end
ret mul bsum get bonCpuScaleBuf blkIdx
end

fn bonCpuDotRow rIdx ulong to f32
acc = f32 0.0f32
blkBase = mul rIdx 40
for b ulong 40
acc = add acc bonCpuDotBlk add blkBase b mul b 128
end
ret acc
end

fn bonWorkerExecAt shmOff ulong resFd int to void
rr = mapread get bonApuShm 0 shmOff engIoBuf 0 20480
for i ulong 5120
put bonCpuX i bitcast f32 engGetU32Io mul i 4
end
bestVal = f32 -1000000000.0f32
bestIdx = ulong 0
rc = get bonCpuRowCnt 0
rs = get bonCpuRowStart 0
for ri ulong rc bound 32768
v = bonCpuDotRow ri
if gt v bestVal
bestVal = v
bestIdx = add rs ri
end
end
bonPutU32Msg 0 bitcast uint bestVal
bonPutU32Msg 4 uint bestIdx
wr = write resFd bonPipeMsg 0 8
end

fn bonCpuDotBlkM4A src ulong xb ulong to void
s0 = f32 0.0f32
s1 = f32 0.0f32
s2 = f32 0.0f32
s3 = f32 0.0f32
for m ulong 16
lb = mul ulong get bonCpuRawBuf add src m 5
xm = add xb m
w = get bonCpuLutF lb
s0 = add s0 mul w get bonCpuX4 xm
s1 = add s1 mul w get bonCpuX4 add xm 5120
s2 = add s2 mul w get bonCpuX4 add xm 10240
s3 = add s3 mul w get bonCpuX4 add xm 15360
w = get bonCpuLutF add lb 1
s0 = add s0 mul w get bonCpuX4 add xm 16
s1 = add s1 mul w get bonCpuX4 add xm 5136
s2 = add s2 mul w get bonCpuX4 add xm 10256
s3 = add s3 mul w get bonCpuX4 add xm 15376
w = get bonCpuLutF add lb 2
s0 = add s0 mul w get bonCpuX4 add xm 32
s1 = add s1 mul w get bonCpuX4 add xm 5152
s2 = add s2 mul w get bonCpuX4 add xm 10272
s3 = add s3 mul w get bonCpuX4 add xm 15392
w = get bonCpuLutF add lb 3
s0 = add s0 mul w get bonCpuX4 add xm 48
s1 = add s1 mul w get bonCpuX4 add xm 5168
s2 = add s2 mul w get bonCpuX4 add xm 10288
s3 = add s3 mul w get bonCpuX4 add xm 15408
w = get bonCpuLutF add lb 4
s0 = add s0 mul w get bonCpuX4 add xm 64
s1 = add s1 mul w get bonCpuX4 add xm 5184
s2 = add s2 mul w get bonCpuX4 add xm 10304
s3 = add s3 mul w get bonCpuX4 add xm 15424
end
put bonCpuAcc4 0 s0
put bonCpuAcc4 1 s1
put bonCpuAcc4 2 s2
put bonCpuAcc4 3 s3
end

fn bonCpuDotBlkM4B src ulong xb ulong to void
s0 = get bonCpuAcc4 0
s1 = get bonCpuAcc4 1
s2 = get bonCpuAcc4 2
s3 = get bonCpuAcc4 3
for m ulong 8
lb = mul ulong get bonCpuRawBuf add add src 16 m 5
xm = add add xb 80 m
w = get bonCpuLutF lb
s0 = add s0 mul w get bonCpuX4 xm
s1 = add s1 mul w get bonCpuX4 add xm 5120
s2 = add s2 mul w get bonCpuX4 add xm 10240
s3 = add s3 mul w get bonCpuX4 add xm 15360
w = get bonCpuLutF add lb 1
s0 = add s0 mul w get bonCpuX4 add xm 8
s1 = add s1 mul w get bonCpuX4 add xm 5128
s2 = add s2 mul w get bonCpuX4 add xm 10248
s3 = add s3 mul w get bonCpuX4 add xm 15368
w = get bonCpuLutF add lb 2
s0 = add s0 mul w get bonCpuX4 add xm 16
s1 = add s1 mul w get bonCpuX4 add xm 5136
s2 = add s2 mul w get bonCpuX4 add xm 10256
s3 = add s3 mul w get bonCpuX4 add xm 15376
w = get bonCpuLutF add lb 3
s0 = add s0 mul w get bonCpuX4 add xm 24
s1 = add s1 mul w get bonCpuX4 add xm 5144
s2 = add s2 mul w get bonCpuX4 add xm 10264
s3 = add s3 mul w get bonCpuX4 add xm 15384
w = get bonCpuLutF add lb 4
s0 = add s0 mul w get bonCpuX4 add xm 32
s1 = add s1 mul w get bonCpuX4 add xm 5152
s2 = add s2 mul w get bonCpuX4 add xm 10272
s3 = add s3 mul w get bonCpuX4 add xm 15392
end
put bonCpuAcc4 0 s0
put bonCpuAcc4 1 s1
put bonCpuAcc4 2 s2
put bonCpuAcc4 3 s3
end

fn bonCpuDotBlkM4C src ulong xb ulong to void
s0 = get bonCpuAcc4 0
s1 = get bonCpuAcc4 1
s2 = get bonCpuAcc4 2
s3 = get bonCpuAcc4 3
for j ulong 2
lb = mul ulong get bonCpuRawBuf add add src 24 j 5
xm = add add xb 120 j
w = get bonCpuLutF lb
s0 = add s0 mul w get bonCpuX4 xm
s1 = add s1 mul w get bonCpuX4 add xm 5120
s2 = add s2 mul w get bonCpuX4 add xm 10240
s3 = add s3 mul w get bonCpuX4 add xm 15360
w = get bonCpuLutF add lb 1
s0 = add s0 mul w get bonCpuX4 add xm 2

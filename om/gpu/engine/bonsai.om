fn bonEmitTrunk to bool
H = get engSpec MS_H
note Copy uncached host-coherent bonApuShm -> GPU-cached EW_X & EW_POS (0.5 us, ZERO stale L2!)
engPtr add get bonApuShmVa 0 APU_SHM_XINIT
engPtr engW EW_X
engArg uint H
if not engPktEmitGy 20 uint div H 256 1 256
ret false
end
engPtr add get bonApuShmVa 0 APU_SHM_POS
engPtr engW EW_POS
engArg 1
if not engPktEmitGy 20 1 1 256
ret false
end
nL = get engSpec MS_LAYERS
faIdx = ulong 0
gdnIdx = ulong 0
for L ulong nL bound 128
doAdd = uint 1
if eq L 0
doAdd = 0
end
if not engEmitRmsNormAdd get engLInNormVa L doAdd
ret false
end
if eq get engLayerKind L 0
if not bonEmitFaLayer L faIdx
ret false
end
faIdx = add faIdx 1
else
if not bonEmitGdnLayer L gdnIdx
ret false
end
gdnIdx = add gdnIdx 1
end
if not bonEmitMlpLayer L
ret false
end
end
ret true
end


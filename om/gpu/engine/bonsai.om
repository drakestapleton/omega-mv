text bonP6 " fa_layer_us="
text bonP7 " mlp_layer_us="

fn bonBenchSlot slot ulong reps ulong idx ulong to void
ok = engReplayPre slot
t0 = ulong monons
for r ulong reps bound 128
ok = engReplayPre slot
end
t1 = ulong monons
put bonProfUs idx div sub t1 t0 mul reps 1000
end

fn bonProfileSteps to void
bonResetState
ok = bonLoadEmbedCpu 760
ok = bonSetPos 0
bonBenchSlot 0 2 0
bonBenchSlot 2 2 1
engPktStartAt add EW_PKT 54525952
ok = bonEmitPtq1 engW BW_XN_ROT get bonGuT 0 engW EW_GU 5120 34816
ok = engPktFinish 0
bonBenchSlot 0 10 2
engPktStartAt add EW_PKT 54525952
ok = bonEmitFwht engW EW_XN engW BW_SIGN5120 engW BW_XN_ROT 5120
ok = engPktFinish 0
bonBenchSlot 0 50 3
engPktStartAt add EW_PKT 54525952
ok = bonEmitGdnLayer 0 0
ok = engPktFinish 0

end
ret engPktFinish 3
end

fn bonGpuInitKvGdn to int
ropeBytes = mul get engSpec MS_MAX_CTX mul get engSpec MS_ROPE_DIMS 4
put engRopeMap 0 nvalloc ropeBytes true
if le get engRopeMap 0 0
ret 10
end
put engRopeVa 0 mapaddr get engRopeMap 0
nGdn = get engSpec MS_N_GDN
nK = get engSpec MS_GDN_NK
nV = get engSpec MS_GDN_NV
qkvN = add mul nK 256 mul nV 128
put engGdnStateMap 0 nvalloc mul nGdn mul nV 32768 true
if le get engGdnStateMap 0 0
ret 10
end
put engGdnStateVa 0 mapaddr get engGdnStateMap 0
put engGdnTailMap 0 nvalloc mul div add mul nGdn mul qkvN 12 65535 65536 65536 true
if le get engGdnTailMap 0 0
ret 10
end
put engGdnTailVa 0 mapaddr get engGdnTailMap 0
kvBytes = mul get engSpec MS_MAX_CTX mul get engSpec MS_NKV mul get engSpec MS_HD 8
put engKvSlabBytes 0 kvBytes
nFa = add get engSpec MS_N_FA get ggHasMtp 0
for fi ulong nFa bound 64
km = nvalloc kvBytes true
if le km 0
ret 11
end
put engKvMap fi km
put engKvVa fi mapaddr km
end
put engSlabCnt 0 0
if not bmAllocGpu
ret 12
end
ret 0
end

fn bonGpuInit to int
put engUseStrictSync 0 1
if not gbopen 1
ret 2
end
if not gbbopen
ret 3
end
put engCodeMap 0 0
bonEmitAllKernels
csize = mul div add get engCodePos 0 4095 4096 4096
cm = nvalloc csize false
if le cm 0
ret 4
end
put engCodeMap 0 cm
put engCodeFail 0 0
bonEmitAllKernels
if ne get engCodeFail 0 0
ret 5
end
put engWork 0 nvalloc ENG_WORK_BYTES true
if le get engWork 0 0
ret 7
end
put engWorkVa 0 mapaddr get engWork 0
put bonApuShm 0 nvalloc 262144 false
if le get bonApuShm 0 0
ret 7
end
put bonApuShmVa 0 mapaddr get bonApuShm 0
ret bonGpuInitKvGdn
end


s3 = add s3 mul w get bonCpuX4 add xm 15366
end
put bonCpuAcc4 0 s0
put bonCpuAcc4 1 s1
put bonCpuAcc4 2 s2
put bonCpuAcc4 3 s3
end

fn bonCpuDotBlkM4 blkIdx ulong xb ulong to void
src = mul blkIdx 28
bonCpuDotBlkM4A src xb
bonCpuDotBlkM4B src xb
bonCpuDotBlkM4C src xb
sc = get bonCpuScaleBuf blkIdx
put bonCpuRowAcc 0 add get bonCpuRowAcc 0 mul get bonCpuAcc4 0 sc
put bonCpuRowAcc 1 add get bonCpuRowAcc 1 mul get bonCpuAcc4 1 sc
put bonCpuRowAcc 2 add get bonCpuRowAcc 2 mul get bonCpuAcc4 2 sc
put bonCpuRowAcc 3 add get bonCpuRowAcc 3 mul get bonCpuAcc4 3 sc
end

fn bonWorkerExecM4 resFd int to void
rr = mapread get bonApuShm 0 APU_SHM_XROT_M4 engIoBuf 0 81920
for i ulong 20480
put bonCpuX4 i bitcast f32 engGetU32Io mul i 4
end
put bonCpuBestV 0 f32 -1000000000.0f32
put bonCpuBestV 1 f32 -1000000000.0f32
put bonCpuBestV 2 f32 -1000000000.0f32
put bonCpuBestV 3 f32 -1000000000.0f32
put bonCpuBestI 0 0
put bonCpuBestI 1 0
put bonCpuBestI 2 0
put bonCpuBestI 3 0
rc = get bonCpuRowCnt 0
rs = get bonCpuRowStart 0
for ri ulong rc bound 32768
put bonCpuRowAcc 0 f32 0.0f32
put bonCpuRowAcc 1 f32 0.0f32
put bonCpuRowAcc 2 f32 0.0f32
put bonCpuRowAcc 3 f32 0.0f32
for b ulong 40
bonCpuDotBlkM4 add mul ri 40 b mul b 128
end
for m ulong 4
if gt get bonCpuRowAcc m get bonCpuBestV m
put bonCpuBestV m get bonCpuRowAcc m
put bonCpuBestI m add rs ri
end
end
end
for m2 ulong 4
bonPutU32Msg mul m2 8 bitcast uint get bonCpuBestV m2
bonPutU32Msg add mul m2 8 4 uint get bonCpuBestI m2
end
wr = write resFd bonPipeMsg 0 32
end

fn bonWorkerLoop w ulong goFd int resFd int r0 ulong rCnt ulong to void
bonPinCore w
bonBuildCpuLut
bonWorkerLoadSlice r0 rCnt
put bonPipeMsg 0 1
wr0 = write resFd bonPipeMsg 0 1
for iter ulong 2000000
rd = read goFd bonPipeMsg 0 1
if or le rd 0 eq get bonPipeMsg 0 0
exit 0
end
tag = ulong get bonPipeMsg 0
if eq tag 2
bonWorkerExecM4 resFd
else
bonWorkerExecAt APU_SHM_XROT resFd
end
end
exit 0
end

fn bonClosePrevPipes w ulong to void
for pw ulong w bound 20
cp1 = fclose get bonGoFds pw
cp2 = fclose get bonResFds pw
end
end

fn bonSpawnOne w ulong cur ulong cnt ulong to void
pGo = new uchar 8 0
pRes = new uchar 8 0
r1 = pipefds pGo 0 8 0
r2 = pipefds pRes 0 8 0
goRd = bonGetI32 pGo 0
goWr = bonGetI32 pGo 4
resRd = bonGetI32 pRes 0
resWr = bonGetI32 pRes 4
pid = fork
if eq pid 0
c1 = fclose goWr
c2 = fclose resRd
bonClosePrevPipes w
bonWorkerLoop w goRd resWr cur cnt
end
c3 = fclose goRd
c4 = fclose resWr
put bonPids w pid
put bonGoFds w goWr
put bonResFds w resRd
end

fn bonApuInit to void
if or eq get bonUseApu 0 0 eq get bonLmNCpu 0 0
put bonApuReady 0 0
ret
end
cur = get bonLmNGpu 0
remW = ulong 30
remR = get bonLmNCpu 0
for w ulong 20
wt = ulong 2
if lt rem w 10 5
wt = ulong 1
end
cnt = div mul remR wt remW
if eq w 19
cnt = remR
end
remR = sub remR cnt
remW = sub remW wt
bonSpawnOne w cur cnt
cur = add cur cnt
end
for w ulong 20
ack = read get bonResFds w bonPipeMsg 0 1
end
put bonApuReady 0 1
end

fn bonApuStop to void
if eq get bonApuReady 0 0
ret
end
st = new uchar 4 0
put bonPipeMsg 0 0
for w ulong 20
wr = write get bonGoFds w bonPipeMsg 0 1
c1 = fclose get bonGoFds w
c2 = fclose get bonResFds w
wp = waitpid int get bonPids w st 0 4 0
end
put bonApuReady 0 0
end


note SPDX-License-Identifier: AGPL-3.0-only
note om/gpu/engine/bonsai.om: Pure Seeded-OM-2 Zero-CUDA Full-APU Ternary Bonsai 2.5 27B Engine!
note Native 1.750000 bpw 896-Byte 4-Row Tiled PTQ1_0 + 64-Row/CTA Overlapped Double-Stream GEMV
note + 1024-Block Walsh-Hadamard + BF16-State Grouped GDN + Uncached Host-Coherent APU Shm
note + Full GB10 APU (20 ARMv9 Cores + 48 Blackwell SMs = 6,164 Cores Simultaneously)!

const BW_XN_ROT ulong 98304
const BW_Y_ROT ulong 950272
const BW_SW_ROT ulong 1785856
const BW_PARTS ulong 2039808
const BW_SIGN5120 ulong 2113536
const BW_SIGN6144 ulong 2146304
const BW_SIGN17408 ulong 2179072

note Uncached host-coherent bonApuShm (64 KiB) layout:
note   0..20479     : xn_rot[5120] F32 (GPU -> 20 CPU workers)
note   32768..32775 : gpu_best (val f32, idx u32)
note   32784..32787 : pos u32 (CPU -> GPU FA kernels, uncached coherent!)
note   40960..61439 : x_init[5120] F32 (CPU embed -> GPU EW_X, uncached coherent!)
const APU_SHM_XROT ulong 0
const APU_SHM_BEST ulong 32768
const APU_SHM_POS ulong 32800
const APU_SHM_MTP_POS ulong 32832
const APU_SHM_XROT_M4 ulong 131072
const APU_SHM_XINIT ulong 40960

note Per-layer single-VA 896-B tiled PTQ1_0 pointers (100% 1.750000 bpw!)
global bonA1T ulong 128
global bonOT ulong 128
global bonGuT ulong 128
global bonDnT ulong 128

global bonLmT ulong 1
global bonLmNAll ulong 1
global bonLmNGpu ulong 1
global bonLmNCpu ulong 1
global bonUseApu ulong 1

global bonApuShm long 1
global bonApuShmVa ulong 1

global bonEmbRawOff ulong 1
global bonLmRawOff ulong 1
global bonEmbRowBuf uchar 1280
global bonEmbF32 f32 5120

note 4-row-group tiled loader buffers (up to 64 row-groups = 256 rows per I/O batch -> ~1 MB!)
global bonRaw4Buf uchar 1048576
global bonTileOut uchar 1048576

note 20-core persistent Full-APU CPU worker pool (10x X925 + 10x A725)
global bonApuReady ulong 1
global bonPids long 20
global bonGoFds int 20
global bonResFds int 20
global bonPipeMsg uchar 32
global bonCpuX f32 5120
global bonCpuX4 f32 20480
global bonCpuAcc4 f32 4
global bonCpuRowAcc f32 4
global bonCpuBestV f32 4
global bonCpuBestI ulong 4
global bonCpuLut uchar 1280
global bonCpuLutF f32 1280
global bonCpuRawBuf uchar 4194304
global bonCpuRowStart ulong 1
global bonCpuRowCnt ulong 1
global bonCpuScaleBuf f32 262144

text gNmEmb "token_embd.weight"
text gNmOut "output.weight"
text gNmFNorm "output_norm.weight"
text gSufInNorm "attn_norm.weight"
text gSufPostNorm "post_attention_norm.weight"
text gSufQ "attn_q.weight"
text gSufK "attn_k.weight"
text gSufV "attn_v.weight"
text gSufO "attn_output.weight"
text gSufQNorm "attn_q_norm.weight"
text gSufKNorm "attn_k_norm.weight"
text gSufQkv "attn_qkv.weight"
text gSufZ "attn_gate.weight"
text gSufSsmOut "ssm_out.weight"
text gSufConv "ssm_conv1d.weight"

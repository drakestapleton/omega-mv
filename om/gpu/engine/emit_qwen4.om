note SPDX-License-Identifier: AGPL-3.0-only
note om/gpu/engine/emit_qwen4.om: Pure Seeded-OM-2 SM121 SASS Kernels for Qwen 3.8 Flash Next (qwen4_exp) & MoE/HC/PLE.
note   Mode 400: uW4GemvAnyK       -- Universal W4 block-32 GEMV for ANY K % 128 == 0, ANY N (0 SMEM)
note   Mode 401: uBf16GemvAnyK     -- Universal BF16 GEMV for ANY K % 64 == 0, ANY N (0 SMEM)
note   Mode 402: uGroupedRmsNorm   -- Grouped RMSNorm (1+w) for hc_count streams of H
note   Mode 403: uScaleSilu        -- In-place x[i] = silu(x[i] * scale)
note   Mode 404: uHcMixReduce      -- Gated Residual read mixer: mean_c(sigmoid(mix_up[c,j]) * x_norm[c,j])
note   Mode 405: uHcInjectAdd      -- Gated Residual write inject: hyper[c,j] += block_out[j] * 2*sigmoid(inj[c]/G)
note   Mode 406: uRouterTopK       -- Softmax + Top-K + norm_topk_prob for E=512, K=10 (or any E % 32 == 0)
note   Mode 407: uMoeW4Gu          -- Fused Top-K MoE W4 gate+up+SiLU*up in 1 launch (H % 128 == 0)
note   Mode 408: uMoeW4DnAdd       -- Fused Top-K MoE W4 down_proj + weighted sum + sigmoid(sh_g)*sh_out in 1 launch
note   Mode 409: uPleGate          -- PLE per-stream dot gate: sign(g)*sqrt(max(|g|,1e-6)), sigmoid(g)*val
note   Mode 410: uPleDilatedConvAdd -- PLE dilated depthwise Conv1d (K=4, dil=3, state=9) + SiLU + add to hyper[4*H]

note Helper: unpack 4-nibble block from wReg (low 16b) against x in R40..R43, scale in sReg, accumulate into accReg
fn uW4Mac4Lane wReg ulong sReg ulong accReg ulong to void
qNum 56 0.0f32
qW4Unpack4 wReg 40 41 42 43 56
qic 30 57 40 41 0 qAlu1
qic 30 58 42 43 0 qAlu4
qic 30 57 57 58 0 qAlu4
qNum 58 -8.0f32
qic4 33 56 57 58 56 qAlu4
qic4 33 accReg 56 sReg accReg qAlu4
end

note Helper: select low or high 16-bit BF16 scale from sPackReg based on (lane & 8) != 0 -> dstReg
fn uPickBf16Scale dstReg ulong sPackReg ulong laneReg ulong to void
qic 18 52 laneReg QZ 8 qAlu4
qLit 53 1
qic 28 QZ 52 53 0 qCmp
qic 18 54 sPackReg QZ 0xffff0000 qAlu1
qicImm 8 dstReg sPackReg QZ 65536 qAlu4
put q36Guard 0 1
qicImm 8 dstReg 54 QZ 1 qAlu4
end

note Helper: shift wReg right by 16 if (lane & 1) != 0
fn uPickW4Half wReg ulong laneReg ulong to void
qic 18 52 laneReg QZ 1 qAlu4
qLit 53 1
qic 28 QZ 52 53 0 qCmp
put q36Guard 0 1
qic 17 wReg wReg QZ 16 qAlu4
end

note =========================================================================
note Mode 400: uW4GemvAnyK -- Universal W4 block-32 GEMV for ANY K % 128 == 0, ANY N
note Args: x[K] (R0:1), W[N,K/8] u32 (R2:3), S[N,K/64] u32 (R4:5), C[N] (R6:7), K (32), N (36).
note Grid: (ceil(N/8), 1, 1), Block: 256 (8 warps = 8 rows), SMEM: 0.
note =========================================================================
fn uW4GemvAnyK to void
qStart 4
qParam 20 32
qParam 21 36
qic 17 10 14 QZ 5 qAlu1
qic 18 11 14 QZ 31 qAlu4
qMad 8 15 8 10
qic 28 QZ 8 21 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
note R12 = K/8 (w u32 stride), R13 = K/64 (s u32 stride), R22 = K/128 (iters)
qic 17 12 20 QZ 3 qAlu1
qic 17 13 20 QZ 6 qAlu1
qic 17 22 20 QZ 7 qAlu4
note W ptr (R24:25) = W + (row*wStride + (lane>>1)) * 4
qMadReg 26 8 12 QZ
qic 17 27 11 QZ 1 qAlu4
qIadd 26 26 27
qicImm 9 24 26 2 4 qAlu4
note S ptr (R28:29) = S + (row*sStride + (lane>>4)) * 4
qMadReg 26 8 13 QZ
qic 17 27 11 QZ 4 qAlu4
qIadd 26 26 27
qicImm 9 28 26 4 4 qAlu4
note X ptr (R30:31) = x + (lane * 4) * 4
qMad 26 11 4 QZ
qicImm 9 30 26 0 4 qAlu4
qNum 48 0.0f32
qLit 23 0
qLit 33 1
mLp = get q36Pc 0
qic 57 40 30 QZ 0 qLdW1
qic 11 34 24 QZ 0 qLd
qic 11 35 28 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
uPickW4Half 34 11
uPickBf16Scale 36 35 11
uW4Mac4Lane 34 36 48
qicImm 9 30 33 30 512 qAlu1
qicImm 9 24 33 24 64 qAlu1
qicImm 9 28 33 28 8 qAlu4
qIadd 23 23 33
qic 28 QZ 23 22 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mLp get q36Pc 0 qAlu4
qWarpRedSum 48 52 16
qic 28 QZ 11 33 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
qicImm 9 16 8 6 4 qAlu4
qic 12 QZ 16 48 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

note =========================================================================
note Mode 401: uBf16GemvAnyK -- Universal BF16 GEMV for ANY K % 64 == 0, ANY N
note Args: W_bf16[N,K/2] u32 (R0:1), x[K] (R2:3), C[N] (R4:5), K (24), N (28).
note Grid: (ceil(N/8), 1, 1), Block: 256, SMEM: 0.
note =========================================================================
fn uBf16GemvAnyK to void
qStart 3
qParam 6 24
qParam 7 28
qic 17 10 14 QZ 5 qAlu1
qic 18 11 14 QZ 31 qAlu4
qMad 8 15 8 10
qic 28 QZ 8 7 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
qic 17 9 6 QZ 1 qAlu4
qMadReg 9 8 9 11
qicImm 9 16 9 0 4 qAlu4
qMad 12 11 2 QZ
qicImm 9 18 12 2 4 qAlu4
qNum 48 0.0f32
qLit 13 0
qic 17 20 6 QZ 6 qAlu4
qLit 21 1
mLp = get q36Pc 0
qic 11 24 16 QZ 0 qLdW1
qic 56 40 18 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qicImm 8 52 24 QZ 65536 qAlu1
qic 18 53 24 QZ 0xffff0000 qAlu4
qic4 33 48 52 40 48 qAlu4
qic4 33 48 53 41 48 qAlu4
qicImm 9 16 21 16 128 qAlu1
qicImm 9 18 21 18 256 qAlu4
qIadd 13 13 21
qic 28 QZ 13 20 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mLp get q36Pc 0 qAlu4
qWarpRedSum 48 52 16
qic 28 QZ 11 21 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
qicImm 9 16 8 4 4 qAlu4
qic 12 QZ 16 48 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

note =========================================================================
note Mode 402: uGroupedRmsNorm -- Grouped RMSNorm (1+w) for hc_count streams of H
note Args: x_in[G,H] (R0:1), w[G,H] (R2:3), out[G,H] (R4:5).
note Grid: (G, 1, 1), Block: 256, SMEM: 64.
note =========================================================================
fn uGroupedRmsNorm to void
H = get engSpec MS_H
nIter = div H 256
eps = mul f32 get engSpec MS_EPS_E6 f32 0.000001f32
invH = div f32 1.0f32 f32 H
qStart 3
qMad 19 15 H QZ
qNum 48 0.0f32
qLit 20 0
qLit 21 nIter
qLit 22 1
mSum = get q36Pc 0
qMad 52 20 256 14
qIadd 52 52 19
qicImm 9 16 52 0 4 qW1
qic 11 24 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic4 33 48 24 24 48 qAlu4
qIadd 20 20 22
qic 28 QZ 20 21 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mSum get q36Pc 0 qAlu4
qWarpRedSum 48 52 16
qic 18 52 14 QZ 31 qAlu1
qic 17 53 14 QZ 5 qAlu4
bW = qBssy
qic 28 QZ 52 22 0 qCmp
skW = qBraFwd 1
qMad 53 53 4 QZ
qic 50 QZ 53 48 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skW 1
qBsync bW
qBar
qNum 48 0.0f32
for w ulong 8
qLit 55 mul w 4
qic 49 49 55 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 30 48 48 49 0 qAlu4
end
qNum 49 invH
qNum 50 eps
qic4 33 48 48 49 50 qAlu4
qic 41 49 48 QZ 0 qMufu
qic 0 QZ QZ QZ 0 qW0
qNum 50 1.0f32
qLit 20 0
mOut = get q36Pc 0
qMad 52 20 256 14
qIadd 52 52 19
qicImm 9 16 52 0 4 qW1
qic 11 24 16 QZ 0 qLd
qicImm 9 32 52 2 4 qW1
qic 11 34 32 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 30 34 34 50 0 qAlu4
qic 32 35 24 49 0 qAlu4
qic 32 35 35 34 0 qAlu4
qicImm 9 16 52 4 4 qAlu4
qic 12 QZ 16 35 0 qSt
qic 0 QZ QZ QZ 0 qW1
qIadd 20 20 22
qic 28 QZ 20 21 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mOut get q36Pc 0 qAlu4
end

note =========================================================================
note Mode 403: uScaleSilu -- In-place x[i] = silu(x[i] * (1 / hc_count))
note Args: x[N] (R0:1), N (8).
note Grid: (ceil(N/256), 1, 1), Block: 256, SMEM: 0.
note =========================================================================
fn uScaleSilu to void
hc = get engSpec MS_HC_COUNT
invHc = div f32 1.0f32 f32 hc
qStart 1
qParam 20 8
qMad 21 15 256 14
qic 28 QZ 21 20 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
qicImm 9 16 21 0 4 qAlu4
qic 11 24 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qNum 25 invHc
qic 32 24 24 25 0 qAlu4
qNum 30 -1.4426950408889634f32
qNum 31 1.0f32
qSig 26 24 30 31
qic 32 24 24 26 0 qAlu4
qic 12 QZ 16 24 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

note =========================================================================
note Mode 404: uHcMixReduce -- mixed[j] = (1/G) * sum_{c=0..G-1}(sigmoid(mix_up[c,j]) * x_norm[c,j])
note Args: mix_up[G,H] (R0:1), x_norm[G,H] (R2:3), mixed_out[H] (R4:5).
note Grid: (H/256, 1, 1), Block: 256, SMEM: 0.
note =========================================================================
fn uHcMixReduce to void
H = get engSpec MS_H
hc = get engSpec MS_HC_COUNT
invHc = div f32 1.0f32 f32 hc
qStart 3
qMad 20 15 256 14
qNum 48 0.0f32
qNum 30 -1.4426950408889634f32
qNum 31 1.0f32
for c ulong hc bound 8
qLit 21 mul c H
qIadd 21 21 20
qicImm 9 16 21 0 4 qW1
qic 11 24 16 QZ 0 qLd
qicImm 9 18 21 2 4 qW1
qic 11 25 18 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qSig 26 24 30 31
qic4 33 48 26 25 48 qAlu4
end
qNum 27 invHc
qic 32 48 48 27 0 qAlu4
qicImm 9 16 20 4 4 qAlu4
qic 12 QZ 16 48 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

note =========================================================================
note Mode 405: uHcInjectAdd -- hyper[c,j] += block_out[j] * (2 * sigmoid(inj_raw[c] * (1/G)))
note Args: hyper_inout[G,H] (R0:1), block_out[H] (R2:3), inj_raw[G] (R4:5).
note Grid: (H/256, G, 1), Block: 256, SMEM: 0.
note =========================================================================
fn uHcInjectAdd to void
H = get engSpec MS_H
hc = get engSpec MS_HC_COUNT
invHc = div f32 1.0f32 f32 hc
qStart 3
qMad 20 15 256 14
qMad 21 18 H 20
qicImm 9 16 18 4 4 qW1
qic 11 24 16 QZ 0 qLd
qicImm 9 16 20 2 4 qW1
qic 11 25 16 QZ 0 qLd
qicImm 9 22 21 0 4 qW1
qic 11 26 22 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qNum 27 invHc
qic 32 24 24 27 0 qAlu4
qNum 30 -1.4426950408889634f32
qNum 31 1.0f32
qSig 24 24 30 31
qNum 28 2.0f32
qic 32 24 24 28 0 qAlu4
qic4 33 26 25 24 26 qAlu4
qic 12 QZ 22 26 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

note =========================================================================
note Mode 406: uRouterTopK -- Softmax over E experts + Top-K + norm_topk_prob
note Args: logits[E] (R0:1), out_ids[K] (R2:3), out_weights[K] (R4:5).
note Grid: (1, 1, 1), Block: 32 (1 warp), SMEM: 4096 (probs[E] at 0..2047, laneMax at 2048..2303).
note =========================================================================
fn uRouterTopK to void
nE = get engSpec MS_NEXP
topK = get engSpec MS_TOPK
perLane = div nE 32
qStart 3
note Pass 1: load logits into SMEM and find max
qNum 48 -1000000000.0f32
qLit 20 0
qLit 21 perLane
qLit 22 1
mMax = get q36Pc 0
qMad 23 20 32 14
qicImm 9 16 23 0 4 qW1
qic 11 24 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qMad 25 23 4 QZ
qic 50 QZ 25 24 0 qSt
qic 37 48 48 24 0 qAlu4
qic 0 QZ QZ QZ 0 qW1
qIadd 20 20 22
qic 28 QZ 20 21 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mMax get q36Pc 0 qAlu4
qWarpBflyMax 48 52
note Pass 2: exp(logit - max), store to SMEM, compute sum
qNum 49 0.0f32
qNum 30 1.4426950408889634f32
qLit 20 0
mExp = get q36Pc 0
qMad 23 20 32 14
qMad 25 23 4 QZ
qic 49 24 25 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 31 24 24 48 0 qAlu4
qExp 24 24 30
qic 50 QZ 25 24 0 qSt
qic 30 49 49 24 0 qAlu4
qic 0 QZ QZ QZ 0 qW1
qIadd 20 20 22
qic 28 QZ 20 21 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mExp get q36Pc 0 qAlu4
qWarpBflySum 49 52
qic 40 49 49 QZ 0 qMufu
qic 0 QZ QZ QZ 0 qW0
note Normalize SMEM probs by 1/sum
qLit 20 0
mNorm = get q36Pc 0
qMad 23 20 32 14
qMad 25 23 4 QZ
qic 49 24 25 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 32 24 24 49 0 qAlu4
qic 50 QZ 25 24 0 qSt
qic 0 QZ QZ QZ 0 qW1
qIadd 20 20 22
qic 28 QZ 20 21 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mNorm get q36Pc 0 qAlu4
qBar
note Pass 3: lane 0 picks top-K sequentially (512 * 10 = 5120 SMEM reads = ~15 us, exact deterministic ties!)
qic 28 QZ 14 22 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
qNum 35 0.0f32
qLit 36 0
qLit 37 topK
qLit 38 nE
mPick = get q36Pc 0
qNum 40 -1.0f32
qLit 41 0
qLit 20 0
mScan = get q36Pc 0
qMad 25 20 4 QZ
qic 49 24 25 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 34 0 24 40 0x03f04000 qCmp
put q36Guard 0 1
qicImm 8 40 24 QZ 1 qAlu1
put q36Guard 0 1
qicImm 8 41 20 QZ 1 qAlu4
qIadd 20 20 22
qic 28 QZ 20 38 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mScan get q36Pc 0 qAlu4
note Mask selected expert to -1.0 in SMEM, save id & weight
qNum 42 -1.0f32
qMad 25 41 4 QZ
qic 50 QZ 25 42 0 qSt
qic 0 QZ QZ QZ 0 qW1
qicImm 9 16 36 2 4 qAlu4
qic 12 QZ 16 41 0 qSt
qicImm 9 16 36 4 4 qAlu4
qic 12 QZ 16 40 0 qSt
qic 0 QZ QZ QZ 0 qW1
qic 30 35 35 40 0 qAlu4
qIadd 36 36 22
qic 28 QZ 36 37 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mPick get q36Pc 0 qAlu4
note Pass 4: normalize top_k weights by 1/wSum
qic 40 35 35 QZ 0 qMufu
qic 0 QZ QZ QZ 0 qW0
qLit 36 0
mRenorm = get q36Pc 0
qicImm 9 16 36 4 4 qAlu4
qic 11 40 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 32 40 40 35 0 qAlu4
qic 12 QZ 16 40 0 qSt
qic 0 QZ QZ QZ 0 qW1
qIadd 36 36 22
qic 28 QZ 36 37 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mRenorm get q36Pc 0 qAlu4
end

note =========================================================================
note Mode 407: uMoeW4Gu -- Fused Top-K MoE W4 gate+up + SiLU*up in ONE launch
note   W_gu layout: [nExp, 2*moeI, H/8] u32 (for each exp: gate[0..moeI-1] then up[0..moeI-1])
note   S_gu layout: [nExp, 2*moeI, H/64] u32
note Args: x[H] (R0:1), W_gu (R2:3), S_gu (R4:5), topk_ids[K] (R6:7), out_mid[K,moeI] (R8:9).
note Grid: (ceil(moeI/8), topK, 1), Block: 256 (8 warps), SMEM: 0.
note =========================================================================
fn uMoeW4Gu to void
H = get engSpec MS_H
moeI = get engSpec MS_MOE_I
wStride = div H 8
sStride = div H 64
nIter = div H 128
expWOff = mul mul 2 moeI wStride
expSOff = mul mul 2 moeI sStride
upWOff = mul moeI wStride
upSOff = mul moeI sStride
qStart 5
qic 17 10 14 QZ 5 qAlu1
qic 18 11 14 QZ 31 qAlu4
qMad 12 15 8 10
qLit 13 moeI
qic 28 QZ 12 13 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
note Load expert_id = topk_ids[cta_y (R18)] -> R19
qicImm 9 16 18 6 4 qW1
qic 11 19 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
note Gate W ptr (R20:21), Up W ptr (R22:23)
qMad 26 19 expWOff QZ
qMad 26 12 wStride 26
qic 17 27 11 QZ 1 qAlu4
qIadd 26 26 27
qicImm 9 20 26 2 4 qAlu1
qLit 27 upWOff
qIadd 26 26 27
qicImm 9 22 26 2 4 qAlu4
note Gate S ptr (R24:25), Up S ptr (R28:29)
qMad 26 19 expSOff QZ
qMad 26 12 sStride 26
qic 17 27 11 QZ 4 qAlu4
qIadd 26 26 27
qicImm 9 24 26 4 4 qAlu1
qLit 27 upSOff
qIadd 26 26 27
qicImm 9 28 26 4 4 qAlu4
note X ptr (R30:31)
qMad 26 11 4 QZ
qicImm 9 30 26 0 4 qAlu4
qNum 48 0.0f32
qNum 49 0.0f32
qLit 32 0
qLit 33 nIter
qLit 34 1
mLp = get q36Pc 0
qic 57 40 30 QZ 0 qLdW1
qic 11 35 20 QZ 0 qLd
qic 11 36 22 QZ 0 qLd
qic 11 37 24 QZ 0 qLd
qic 11 38 28 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
uPickW4Half 35 11
uPickW4Half 36 11
uPickBf16Scale 37 37 11
uPickBf16Scale 38 38 11
uW4Mac4Lane 35 37 48
uW4Mac4Lane 36 38 49
qicImm 9 30 34 30 512 qAlu1
qicImm 9 20 34 20 64 qAlu1
qicImm 9 22 34 22 64 qAlu1
qicImm 9 24 34 24 8 qAlu1
qicImm 9 28 34 28 8 qAlu4
qIadd 32 32 34
qic 28 QZ 32 33 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mLp get q36Pc 0 qAlu4
qWarpRedSum 48 52 16
qWarpRedSum 49 52 16
qic 28 QZ 11 34 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
qNum 30 -1.4426950408889634f32
qNum 31 1.0f32
qSig 35 48 30 31
qic 32 48 48 35 0 qAlu4
qic 32 48 48 49 0 qAlu4
qMad 26 18 moeI 12
qicImm 9 16 26 8 4 qAlu4
qic 12 QZ 16 48 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

note =========================================================================
note Mode 408: uMoeW4DnAdd -- Fused Top-K MoE W4 down_proj + weighted sum + gated shared expert
note   W_dn layout: [nExp, H, moeI/8] u32; S_dn layout: [nExp, H, moeI/64] u32
note Args: moe_mid[K,moeI] (R0:1), W_dn (R2:3), S_dn (R4:5), topk_ids[K] (R6:7),
note       topk_w[K] (R8:9), sh_out[H] (R10:11), sh_gate_s[1] (R12:13), out[H] (56,60).
note Grid: (ceil(H/8), 1, 1), Block: 256 (8 warps = 8 output rows), SMEM: 0.
note =========================================================================
fn uMoeW4DnAdd to void
H = get engSpec MS_H
moeI = get engSpec MS_MOE_I
topK = get engSpec MS_TOPK
wStride = div moeI 8
sStride = div moeI 64
nIter = div moeI 128
expWOff = mul H wStride
expSOff = mul H sStride
qStart 7
qic 17 16 14 QZ 5 qAlu1
qic 18 17 14 QZ 31 qAlu4
qMad 18 15 8 16
qLit 19 H
qic 28 QZ 18 19 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
qNum 48 0.0f32
qLit 20 0
qLit 21 topK
qLit 22 1
mExp = get q36Pc 0
note Load expert_id = topk_ids[k] -> R23, expert_w = topk_w[k] -> R24
qicImm 9 26 20 6 4 qW1
qic 11 23 26 QZ 0 qLd
qicImm 9 26 20 8 4 qW1
qic 11 24 26 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
note W ptr (R26:27) = W_dn + (exp*expWOff + row*wStride + (lane>>1)) * 4
qMad 28 23 expWOff QZ
qMad 28 18 wStride 28
qic 17 29 17 QZ 1 qAlu4
qIadd 28 28 29
qicImm 9 26 28 2 4 qAlu4
note S ptr (R28:29) = S_dn + (exp*expSOff + row*sStride + (lane>>4)) * 4
qMad 30 23 expSOff QZ
qMad 30 18 sStride 30
qic 17 31 17 QZ 4 qAlu4
qIadd 30 30 31
qicImm 9 28 30 4 4 qAlu4
note X ptr (R30:31) = moe_mid + (k*moeI + lane*4) * 4
qMad 32 20 moeI QZ
qMad 32 17 4 32
qicImm 9 30 32 0 4 qAlu4
qNum 49 0.0f32
qLit 33 0
qLit 34 nIter
mK = get q36Pc 0
qic 57 40 30 QZ 0 qLdW1
qic 11 35 26 QZ 0 qLd
qic 11 36 28 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
uPickW4Half 35 17
uPickBf16Scale 36 36 17
uW4Mac4Lane 35 36 49
qicImm 9 30 22 30 512 qAlu1
qicImm 9 26 22 26 64 qAlu1
qicImm 9 28 22 28 8 qAlu4
qIadd 33 33 22
qic 28 QZ 33 34 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mK get q36Pc 0 qAlu4
qic4 33 48 49 24 48 qAlu4
qIadd 20 20 22
qic 28 QZ 20 21 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mExp get q36Pc 0 qAlu4
qWarpRedSum 48 52 16
qic 28 QZ 17 22 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
note Add sigmoid(sh_gate_s[0]) * sh_out[row]
qLit 25 0
qicImm 9 26 25 12 4 qW1
qic 11 35 26 QZ 0 qLd
qicImm 9 26 18 10 4 qW1
qic 11 36 26 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qNum 30 -1.4426950408889634f32
qNum 31 1.0f32
qSig 35 35 30 31
qic4 33 48 36 35 48 qAlu4
qParam 26 56
qParam 27 60
qicImm 9 26 18 26 4 qAlu4
qic 12 QZ 26 48 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

note =========================================================================
note Mode 409: uPleGate -- PLE per-stream dot gate + sigmoid(g) * val
note Args: key_norm[G,H] (R0:1), qry_norm[G,H] (R2:3), val[H] (R4:5), gated_out[G,H] (R6:7).
note Grid: (G, 1, 1), Block: 256, SMEM: 64.
note =========================================================================
fn uPleGate to void
H = get engSpec MS_H
nIter = div H 256
note 1 / sqrt(2560) = 0.019764235376f32
invSqrtH = f32 0.019764235376f32
if eq H 2048
invSqrtH = f32 0.022097086912f32
end
if eq H 4096
invSqrtH = f32 0.015625f32
end
qStart 4
qMad 19 15 H QZ
qNum 48 0.0f32
qLit 20 0
qLit 21 nIter
qLit 22 1
mDot = get q36Pc 0
qMad 52 20 256 14
qIadd 52 52 19
qicImm 9 16 52 0 4 qW1
qic 11 24 16 QZ 0 qLd
qicImm 9 18 52 2 4 qW1
qic 11 25 18 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic4 33 48 24 25 48 qAlu4
qIadd 20 20 22
qic 28 QZ 20 21 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mDot get q36Pc 0 qAlu4
qWarpRedSum 48 52 16
qic 18 52 14 QZ 31 qAlu1
qic 17 53 14 QZ 5 qAlu4
bW = qBssy
qic 28 QZ 52 22 0 qCmp
skW = qBraFwd 1
qMad 53 53 4 QZ
qic 50 QZ 53 48 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skW 1
qBsync bW
qBar
qNum 48 0.0f32
for w ulong 8
qLit 55 mul w 4
qic 49 49 55 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 30 48 48 49 0 qAlu4
end
note g = dot * invSqrtH; g = sign(g) * sqrt(max(|g|, 1e-6)); sg = sigmoid(g)
qNum 49 invSqrtH
qic 32 48 48 49 0 qAlu4
qic 18 49 48 QZ 0x7fffffff qAlu1
qic 18 50 48 QZ 0x80000000 qAlu4
qNum 51 0.000001f32
qic 37 49 49 51 0 qAlu4
qic 41 51 49 QZ 0 qMufu
qic 0 QZ QZ QZ 0 qW0
qic 32 49 49 51 0 qAlu4
note Apply original sign bit: if sign bit != 0, negate
qNum 52 0.0f32
qic 31 53 52 49 0 qAlu4
qLit 54 1
qic 28 QZ 50 54 0 qCmp
put q36Guard 0 1
qicImm 8 49 53 QZ 1 qAlu4
qNum 30 -1.4426950408889634f32
qNum 31 1.0f32
qSig 49 49 30 31
qLit 20 0
mOut = get q36Pc 0
qMad 52 20 256 14
qicImm 9 16 52 4 4 qW1
qic 11 24 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 32 24 24 49 0 qAlu4
qIadd 53 52 19
qicImm 9 16 53 6 4 qAlu4
qic 12 QZ 16 24 0 qSt
qic 0 QZ QZ QZ 0 qW1
qIadd 20 20 22
qic 28 QZ 20 21 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mOut get q36Pc 0 qAlu4
end

note =========================================================================
note Mode 410: uPleDilatedConvAdd -- PLE dilated depthwise Conv1d (K=4, dilation=3, state=9) + SiLU + add
note Args: gated_val[4H] (R0:1), gated_norm[4H] (R2:3), conv_w[4H,4] (R4:5),
note       conv_state[4H,9] (R6:7), hyper_inout[4H] (R8:9).
note Grid: (4H/256, 1, 1), Block: 256, SMEM: 0.
note =========================================================================
fn uPleDilatedConvAdd to void
qStart 5
qMad 20 15 256 14
qicImm 9 16 20 0 4 qW1
qic 11 21 16 QZ 0 qLd
qicImm 9 16 20 2 4 qW1
qic 11 22 16 QZ 0 qLd
qicImm 9 48 20 8 4 qW1
qic 11 23 48 QZ 0 qLd
qMad 24 20 4 QZ
qicImm 9 16 24 4 4 qW1
qic 57 28 16 QZ 0 qLd
qMad 25 20 9 QZ
qicImm 9 16 25 6 4 qW1
qic 11 32 16 QZ 0 qLd
qLit 52 3
qIadd 26 25 52
qicImm 9 16 26 6 4 qW1
qic 11 33 16 QZ 0 qLd
qLit 52 6
qIadd 27 25 52
qicImm 9 16 27 6 4 qW1
qic 11 34 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
note acc = w0*s[0] + w1*s[3] + w2*s[6] + w3*x_cur
qic 32 35 28 32 0 qAlu4
qic4 33 35 29 33 35 qAlu4
qic4 33 35 30 34 35 qAlu4
qic4 33 35 31 22 35 qAlu4
qNum 36 -1.4426950408889634f32
qNum 37 1.0f32
qSig 38 35 36 37
qic 32 35 35 38 0 qAlu4
note hyper_inout[ch] += gated_val[ch] + silu(acc)
qic 30 23 23 21 0 qAlu4
qic 30 23 23 35 0 qAlu4
qic 12 QZ 48 23 0 qSt
qic 0 QZ QZ QZ 0 qW1
note Shift conv_state[ch*9 + 0..7] = conv_state[ch*9 + 1..8], conv_state[ch*9 + 8] = x_cur
qLit 52 0
qLit 53 8
qLit 54 1
mSh = get q36Pc 0
qIadd 26 25 52
qIadd 27 26 54
qicImm 9 16 27 6 4 qW1
qic 11 39 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qicImm 9 16 26 6 4 qAlu4
qic 12 QZ 16 39 0 qSt
qic 0 QZ QZ QZ 0 qW1
qIadd 52 52 54
qic 28 QZ 52 53 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mSh get q36Pc 0 qAlu4
qIadd 26 25 53
qicImm 9 16 26 6 4 qAlu4
qic 12 QZ 16 22 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

fn engQwen4Kernel mode ulong to bool
if eq mode 400
uW4GemvAnyK
ret true
end
if eq mode 401
uBf16GemvAnyK
ret true
end
if eq mode 402
uGroupedRmsNorm
ret true
end
if eq mode 403
uScaleSilu
ret true
end
if eq mode 404
uHcMixReduce
ret true
end
if eq mode 405
uHcInjectAdd
ret true
end
if eq mode 406
uRouterTopK
ret true
end
if eq mode 407
uMoeW4Gu
ret true
end
if eq mode 408
uMoeW4DnAdd
ret true
end
if eq mode 409
uPleGate
ret true
end
if eq mode 410
uPleDilatedConvAdd
ret true
end
ret false
end

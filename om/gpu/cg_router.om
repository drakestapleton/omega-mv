fn rt_ne_of ins edit ulong 8192 meta edit ulong 512 nev ulong aop ulong b ulong to void
t = get meta 399
t2 = get meta 400
rt_xorr edit ins edit meta t aop b
rt_imadi edit ins edit meta t2 t 0xffffffff RT_NOREG
rt_lop3_or edit ins edit meta t t t2
rt_shr edit ins edit meta nev t 31
end

fn rt_warp_red ins edit ulong 8192 meta edit ulong 512 op ulong v ulong t ulong to void
o = ulong 16
while ge o 1
rt_shfl_down edit ins edit meta t v o
rt_fop2 edit ins edit meta op v v t
o = shr o 1
end
end

fn rt_lane0_sts ins edit ulong 8192 meta edit ulong 512 addr ulong v ulong to void
rt_isetp_ge_u32 edit ins edit meta get meta 393 get meta 394
rbssy = rt_bssy_fwd edit ins edit meta
rbra = rt_bra_p0_fwd edit ins edit meta
rt_sts32 edit ins edit meta addr v
join = get meta 0
rt_bsync edit ins edit meta
rt_patch edit ins edit meta rbra join
rt_patch edit ins edit meta rbssy add join 1
end

fn rt_spec_ok_i sp view ulong 8 to ulong
w = get sp 0
w_ok = ulong 0
if eq w 8
w_ok = 1
end
if eq w 16
w_ok = 1
end
if eq w 32
w_ok = 1
end
if eq w_ok 0
ret 0
end
d = get sp 1
d_ok = ulong 0
if eq d 1
d_ok = 1
end
if eq d 2
d_ok = 1
end
if eq d 4
d_ok = 1
end
if eq d 8
d_ok = 1
end
if eq d_ok 0
ret 0
end
mut = get sp 2
if gt mut 6
ret 0
end
ex = get sp 3
if eq ex 0
ex = 128
end
ex_ok = ulong 0
if eq ex 128
ex_ok = 1
end
if eq ex 256
ex_ok = 1
end
if eq ex_ok 0
ret 0
end
shx = get sp 4
if gt shx 1
ret 0
end
xst = get sp 5
lbst = get sp 6
xnz = ulong 0
if ne xst 0
xnz = 1
end
lnz = ulong 0
if ne lbst 0
lnz = 1
end
if ne xnz lnz
ret 0
end
if ne xst 0
if lt xst 8192
ret 0
end
if ne and xst 15 0
ret 0
end
if ne and lbst 15 0
ret 0
end
end
if eq mut 6
if eq xst 0
ret 0
end
end
if eq mut 5
if eq shx 0
ret 0
end
end
ret 1
end


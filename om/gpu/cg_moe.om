om2
note Pure OM-2 Blackwell FP8 e4m3 block-scaled GEMV v1 codegen (om/gpu/cg_moe.om).
note Replaces src/omega_blackwell_codegen_moe.c with the same 8-ulong-per-insn + 512-ulong meta wire format.
note sp[8]: 0=k, 1=lane_bytes, 2=rows, 3=warps, 4=mutant, 5=depth, 6=sched, 7=flags (bit0=coal, bit1=wfirst).

const M1_NOREG ulong 0xffffffffffffffff
const M1_MAX_K ulong 32768

fn m1_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn m1_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn m1_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn m1_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 M1_NOREG
put r 2 M1_NOREG
put r 3 M1_NOREG
put r 4 M1_NOREG
put r 5 M1_NOREG
put r 6 0
put r 7 0
end

fn m1_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = m1_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = m1_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or m1_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or m1_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or m1_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or m1_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = m1_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = m1_cw 5 7 7 wt
if eq and shr get r 7 1 1 0
put meta 4 0
end
end
if eq kind 8
cw = or m1_cw 1 7 7 wt 0x2000
put meta 4 0
end
if eq kind 9
cw = or m1_cw 5 7 7 wt 0x2000
put meta 4 0
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn m1_patch ins edit ulong 8192 pos ulong target ulong to void
if ge pos 1024
ret
end
b = add mul pos 8 6
hi = and get ins b 0xffffffff00000000
d = and sub target pos 0xffffffff
put ins b or hi d
end

fn m1_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
put meta add 320 mul nl 2 start
put meta add 321 mul nl 2 sub get meta 0 1
put meta 3 add nl 1
end

fn m1_op1 ins edit ulong 8192 meta edit ulong 512 op ulong d ulong imm ulong kind ulong to void
r = new ulong 8 0
m1_r0 r op
put r 1 d
put r 6 imm
if eq kind 4
put r 7 1
end
m1_emit ins meta r kind
end

fn m1_imadi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong to void
r = new ulong 8 0
m1_r0 r 8
put r 1 d
put r 2 a
put r 4 get meta 10
put r 6 get meta 11
put r 7 shl asub 24
m1_emit ins meta r 0
end

fn m1_imadr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong c ulong to void
r = new ulong 8 0
m1_r0 r 8
put r 1 d
put r 2 a
put r 3 b
put r 4 c
m1_emit ins meta r 0
end

fn m1_imadw ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong c ulong to void
r = new ulong 8 0
m1_r0 r 9
put r 1 d
put r 2 a
put r 4 c
put r 6 imm
m1_emit ins meta r 0
end

fn m1_shr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong imm ulong to void
r = new ulong 8 0
m1_r0 r 17
put r 1 d
put r 2 a
put r 6 imm
put r 7 shl asub 24
m1_emit ins meta r 0
end

fn m1_andi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong imm ulong to void
r = new ulong 8 0
m1_r0 r 18
put r 1 d
put r 2 a
put r 6 imm
put r 7 shl asub 24
m1_emit ins meta r 0
end

fn m1_bin ins edit ulong 8192 meta edit ulong 512 op ulong d ulong a ulong b ulong to void
r = new ulong 8 0
m1_r0 r op
put r 1 d
put r 2 a
put r 3 b
m1_emit ins meta r 0
end

fn m1_ldg ins edit ulong 8192 meta edit ulong 512 op ulong d ulong addr ulong imm ulong to void
r = new ulong 8 0
m1_r0 r op
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 imm
m1_emit ins meta r get meta 12
end

fn m1_lds128 ins edit ulong 8192 meta edit ulong 512 d ulong addr ulong imm ulong fst ulong to void
r = new ulong 8 0
m1_r0 r 58
put r 1 d
put r 2 addr
put r 6 imm
if ne fst 0
m1_emit ins meta r 2
else
m1_emit ins meta r 3
end
end

fn m1_ffma ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong bsub ulong to void
r = new ulong 8 0
m1_r0 r 33
put r 1 d
put r 2 a
put r 3 b
put r 4 get meta 10
put r 7 shl bsub 32
m1_emit ins meta r 0
end

fn m1_log2 v ulong to ulong
l = ulong 0
while lt shl ulong 1 l v bound 32
l = add l 1
end
if eq shl ulong 1 l v
ret l
end
ret 99
end

fn m1_ok_depth sp view ulong 8 to ulong
k = get sp 0
lb = get sp 1
rows = get sp 2
w = get sp 3
depth = get sp 5
ks = div k mul 32 lb
if gt depth 16
ret 0
end
if ne rem ks depth 0
ret 0
end
if gt mul mul rows depth lb 128
ret 0
end
if gt k mul 2048 w
ret 0
end
ret 1
end

fn cg_moe_ok_i sp view ulong 8 to ulong
k = get sp 0
lb = get sp 1
rows = get sp 2
w = get sp 3
mut = get sp 4
coal = and get sp 7 1
if ne lb 8
if ne lb 16
ret 0
end
end
if ne rows 1
if ne rows 2
if ne rows 4
if ne rows 8
ret 0
end
end
end
end
if lt w 1
ret 0
end
if gt w 32
ret 0
end
if eq k 0
ret 0
end
if gt k M1_MAX_K
ret 0
end
if ne rem k 128 0
ret 0
end
if ne rem k mul 32 lb 0
ret 0
end
if gt mut 5
ret 0
end
if ge mut 4
if eq coal 0
ret 0
end
end
if gt get sp 6 1
ret 0
end
if gt get sp 7 3
ret 0
end
if ne coal 0
if gt mul w rows 32
ret 0
end
end
if ne get sp 5 0
if eq m1_ok_depth sp 0
ret 0
end
end
if ge add mul sub rows 1 k lb shl ulong 1 23
ret 0
end
ret 1
end

fn m1_prologue sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
put meta 384 m1_uv meta 2
put meta 385 m1_v meta 2
put meta 386 m1_v meta 2
put meta 387 m1_v meta 2
for i ulong 11
put meta add 388 i m1_v meta 1
end
put meta 399 m1_v meta 2
put meta 400 m1_v meta 2
put meta 401 m1_v meta 2
put meta 402 m1_v meta 1
put meta 403 m1_v meta 2
put meta 404 m1_v meta 2
put meta 405 m1_v meta 2
put meta 406 m1_v meta 1
put meta 407 m1_v meta 1
put meta 408 m1_v meta 1
m1_op1 ins meta 7 get meta 384 0x358 4
m1_op1 ins meta 5 get meta 385 0x380 2
m1_op1 ins meta 5 get meta 386 0x388 2
m1_op1 ins meta 5 get meta 387 0x390 2
m1_op1 ins meta 4 get meta 388 0x398 2
m1_op1 ins meta 4 get meta 389 0x39c 2

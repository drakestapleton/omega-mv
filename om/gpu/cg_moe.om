put meta 11 4
m1_imadi ins meta get meta 23 get meta 27 0
end

fn m1_stage_sts sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 xst view ulong 8 to void
r = new ulong 8 0
for q ulong get meta 30 bound 8
j = add get meta 29 q
if ne get meta 33 0
if eq j sub get meta 32 1
m1_r0 r 50
put r 2 get meta 23
put r 3 get xst q
m1_emit ins meta r 5
else
put meta 10 get meta 21
put meta 11 mul j mul 128 get sp 3
m1_imadi ins meta get meta 22 get meta 397 0
m1_r0 r 50
put r 2 get meta 22
put r 3 get xst q
m1_emit ins meta r 5
end
else
put meta 10 get meta 21
put meta 11 mul j mul 128 get sp 3
m1_imadi ins meta get meta 22 get meta 397 0
m1_r0 r 50
put r 2 get meta 22
put r 3 get xst q
m1_emit ins meta r 5
end
end
end

fn m1_stage_chunk sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
pxs = new ulong 8 0
xst = new ulong 8 0
for q ulong get meta 30 bound 8
put pxs q m1_v meta 2
put xst q m1_v meta 1
end
for q ulong get meta 30 bound 8
off = mul add get meta 29 q mul 128 get sp 3
m1_imadw ins meta get pxs q get meta 397 off get meta 20
end
if ne get meta 33 0
if eq add get meta 29 get meta 30 get meta 32
m1_stage_clamp sp ins meta get pxs sub get meta 30 1
end
end
for q ulong get meta 30 bound 8
put meta 12 3
if eq q 0
put meta 12 2
end
m1_ldg ins meta 11 get xst q get pxs q 0
end
m1_stage_sts sp ins meta xst
end

fn m1_stage_x sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
rounds = div sub add get sp 0 mul 32 get sp 3 1 mul 32 get sp 3
put meta 32 rounds
put meta 33 rem get sp 0 mul 32 get sp 3
put meta 20 m1_v meta 2
for i ulong 8
put meta add 21 i m1_v meta 1
end
put meta 416 m1_v meta 1
put meta 417 m1_v meta 1
m1_imadw ins meta get meta 20 get meta 392 4 get meta 403
put meta 10 M1_NOREG
put meta 11 4
m1_imadi ins meta get meta 21 get meta 392 0
j0 = ulong 0
while lt j0 rounds bound 64
nj = sub rounds j0
if gt nj 8
nj = ulong 8
end
put meta 29 j0
put meta 30 nj
m1_stage_chunk sp ins meta
j0 = add j0 nj
end
m1_r0 r 48
m1_emit ins meta r 6
put meta 10 M1_NOREG
put meta 11 mul get sp 1 4
m1_imadi ins meta get meta 417 get meta 396 0
end

fn m1_coal_init sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
nrow = mul get sp 3 get sp 2
xsb = ulong 0
if ne get sp 5 0
xsb = add mul get sp 0 4 16
end
osb = mul nrow 4
stog_v = mul 2 xsb
if ne get sp 4 4
stog_v = add stog_v osb
end
put meta 10 get meta 388
put meta 11 0xffffffff
m1_imadi ins meta get meta 496 get meta 397 0
put meta 10 M1_NOREG
put meta 11 0xffffffff
m1_imadi ins meta get meta 497 get meta 388 0
put meta 10 M1_NOREG

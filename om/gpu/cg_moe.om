m1_op1 ins meta 3 get meta 394 0x26 2
m1_op1 ins meta 2 get meta 397 1 0
m1_shr ins meta get meta 395 get meta 392 0 5
m1_andi ins meta get meta 396 get meta 392 0 31
if eq get sp 4 3
m1_bin ins meta 29 get meta 398 get meta 394 get meta 397
else
put meta 10 M1_NOREG
put meta 11 1
m1_imadi ins meta get meta 398 get meta 394 0
end
m1_imadw ins meta get meta 399 get meta 398 16 get meta 385
put meta 12 2
m1_ldg ins meta 56 get meta 400 get meta 399 0
put meta 12 3
m1_ldg ins meta 56 get meta 401 get meta 399 8
m1_imadr ins meta get meta 402 get meta 394 get meta 389 M1_NOREG
m1_imadw ins meta get meta 403 get meta 402 1 get meta 386
m1_imadr ins meta get meta 402 get meta 394 get meta 390 M1_NOREG
m1_imadw ins meta get meta 404 get meta 402 1 get meta 387
m1_imadw ins meta get meta 405 get meta 396 mul get sp 1 4 get meta 403
put meta 10 M1_NOREG
put meta 11 get sp 1
m1_imadi ins meta get meta 406 get meta 396 0
m1_shr ins meta get meta 407 get meta 396 0 m1_log2 div 128 get sp 1
put meta 10 M1_NOREG
put meta 11 4
m1_imadi ins meta get meta 407 get meta 407 0
put meta 10 get meta 395
put meta 11 get sp 3
m1_imadi ins meta get meta 408 get meta 393 0
end

fn m1_alloc_body sp view ulong 8 meta edit ulong 512 to void
d_dep = get sp 5
if eq d_dep 0
d_dep = ulong 1
end
put meta 409 m1_v meta 2
put meta 410 m1_v meta 2
put meta 411 m1_v meta 2
put meta 412 m1_v meta 2
put meta 413 m1_v meta 2
put meta 414 m1_v meta 1
put meta 415 m1_v meta 1
put meta 416 M1_NOREG
put meta 417 M1_NOREG
wq_w = ulong 2
if eq get sp 1 16
wq_w = ulong 4
end
for ri ulong get sp 2 bound 8
put meta add 424 ri m1_v meta 1
for s ulong d_dep bound 16
put meta add 436 add mul ri d_dep s m1_v meta wq_w
end
end
for q ulong div get sp 1 4 bound 4
put meta add 432 q m1_v meta 4
end
for s ulong d_dep bound 16
put meta add 452 s m1_v meta 1
put meta add 468 s m1_v meta 2
end
for i ulong 6
put meta add 418 i m1_v meta 1
end
if ne get sp 6 0
for q ulong 4
put meta add 484 q m1_v meta 1
end
for q ulong 6
put meta add 488 q m1_v meta 1
end
end
put meta 495 get meta 408
if ne and get sp 7 1 0
for i ulong 15
put meta add 494 i m1_v meta 1
end
end
end

fn m1_stage_clamp sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 last_px ulong to void
j = sub div sub add get sp 0 mul 32 get sp 3 1 mul 32 get sp 3 1
put meta 10 M1_NOREG
put meta 11 1
m1_imadi ins meta get meta 24 get meta 392 0
put meta 10 get meta 24

fn m1_decode_byte ins edit ulong 8192 meta edit ulong 512 wq ulong wd ulong i ulong to void
if lt i 3
put meta 10 M1_NOREG
put meta 11 shl ulong 1 sub 20 mul 8 i
m1_imadi ins meta get meta 419 wq wd
else
m1_shr ins meta get meta 419 wq wd 4
end
m1_andi ins meta get meta 420 get meta 419 0 0x07f00000
m1_andi ins meta get meta 421 wq wd shl ulong 0x80 mul 8 i
put meta 10 get meta 420
if lt i 3
put meta 11 shl ulong 1 sub 24 mul 8 i
else
put meta 11 1
end
m1_imadi ins meta get meta 422 get meta 421 0
end

fn m1_pipe_es ins edit ulong 8192 meta edit ulong 512 wq ulong c ulong to void
wd = div c 4
i = rem c 4
u = get meta add 484 i
sg = get meta add 488 rem c 6
if lt i 3
put meta 10 M1_NOREG
put meta 11 shl ulong 1 sub 20 mul 8 i
m1_imadi ins meta u wq wd
else
m1_shr ins meta u wq wd 4
end
m1_andi ins meta sg wq wd shl ulong 0x80 mul 8 i
end

fn m1_pipe_f ins edit ulong 8192 meta edit ulong 512 b ulong to void
i = rem b 4
sg = get meta add 488 rem b 6
put meta 10 get meta add 484 i
if lt i 3
put meta 11 shl ulong 1 sub 24 mul 8 i
else
put meta 11 1
end
m1_imadi ins meta sg sg 0
end

fn m1_pipe_c ins edit ulong 8192 meta edit ulong 512 b ulong to void
put meta 10 get meta 418
s1 = get meta add 488 rem b 6
s2 = get meta add 432 div b 4
m1_ffma ins meta get meta 418 s1 s2 rem b 4
end

fn m1_decode_pipe ins edit ulong 8192 meta edit ulong 512 wq ulong words ulong to void
nb = mul 4 words
for c ulong add nb 5 bound 24
if lt c nb
m1_pipe_es ins meta wq c
end
if ge c 2
if lt sub c 2 nb
u = get meta add 484 rem sub c 2 4
m1_andi ins meta u u 0 0x07f00000
end
end
if ge c 3
if lt sub c 3 nb
m1_pipe_f ins meta sub c 3
end
end
if ge c 5
if lt sub c 5 nb
m1_pipe_c ins meta sub c 5
end
end
end
end

fn m1_kloop_ldg_w sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 s ulong to void
d_dep = get sp 5
if eq d_dep 0
d_dep = ulong 1
end
ldw = ulong 56
if eq get sp 1 16
ldw = ulong 57
end
for ri ulong get sp 2 bound 8
put meta 12 3
if ne get meta 31 0
put meta 12 2
put meta 31 0
end
off = add mul ri get sp 0 mul s mul 32 get sp 1
m1_ldg ins meta ldw get meta add 436 add mul ri d_dep s get meta 409 off
end
end

fn m1_kloop_ldg sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
d_dep = get sp 5
if eq d_dep 0
d_dep = ulong 1
end
bps = div mul 32 get sp 1 128
put meta 31 1
if eq get sp 5 0
if eq and get sp 7 2 0
for q ulong div get sp 1 4 bound 4
put meta 12 3
if ne get meta 31 0
put meta 12 2
put meta 31 0
end
m1_ldg ins meta 57 get meta add 432 q get meta 411 mul q 16
end
end
end
for s ulong d_dep bound 16
soff = mul s mul bps 4
if eq get sp 4 2
soff = ulong 0
end
m1_imadw ins meta get meta add 468 s get meta 397 soff get meta 410
end
for s ulong d_dep bound 16
m1_kloop_ldg_w sp ins meta s
end
put meta 12 3
for s ulong d_dep bound 16
m1_ldg ins meta 11 get meta add 452 s get meta add 468 s 0
end
if eq get sp 5 0
if ne and get sp 7 2 0
for q ulong div get sp 1 4 bound 4
m1_ldg ins meta 57 get meta add 432 q get meta 411 mul q 16
end
end
end
end

fn m1_comp_row sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 wq ulong to void
words = div get sp 1 4
m1_op1 ins meta 1 get meta 418 0 0
if ne get sp 6 0
m1_decode_pipe ins meta wq words
else
for wd ulong words bound 4
for i ulong 4
m1_decode_byte ins meta wq wd i
put meta 10 get meta 418
m1_ffma ins meta get meta 418 get meta 422 get meta add 432 wd i
end
end
end
end

fn m1_kloop_lds sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 s ulong to void
base = mul s mul 128 get sp 1
for q ulong div get sp 1 4 bound 4
off = add base mul q 16
if eq q 0
m1_lds128 ins meta get meta add 432 q get meta 416 off 1
else
m1_lds128 ins meta get meta add 432 q get meta 416 off 0
end
end
end

fn m1_kloop_comp sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 s ulong to void
if ne get sp 5 0
m1_kloop_lds sp ins meta s
end
d_dep = get sp 5
if eq d_dep 0
d_dep = ulong 1
end
for ri ulong get sp 2 bound 8
wq = get meta add 436 add mul ri d_dep s
m1_comp_row sp ins meta wq
ac = get meta add 424 ri
if eq get sp 4 1
m1_bin ins meta 30 ac ac get meta 418
else
put meta 10 ac
m1_ffma ins meta ac get meta 418 get meta add 452 s 0
end
end
end

fn m1_kloop sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
d_dep = get sp 5
if eq d_dep 0
d_dep = ulong 1
end
bps = div mul 32 get sp 1 128
lk = get meta 0
m1_kloop_ldg sp ins meta
for s ulong d_dep bound 16
m1_kloop_comp sp ins meta s
end
m1_imadw ins meta get meta 409 get meta 397 mul d_dep mul 32 get sp 1 get meta 409
if eq get sp 5 0
m1_imadw ins meta get meta 411 get meta 397 mul 128 get sp 1 get meta 411
end
soff = mul d_dep mul bps 4
if eq get sp 4 2
soff = ulong 0
end
m1_imadw ins meta get meta 410 get meta 397 soff get meta 410
if ne get sp 5 0
put meta 10 get meta 416
put meta 11 mul d_dep mul 128 get sp 1
m1_imadi ins meta get meta 416 get meta 397 0
end
put meta 10 get meta 415
put meta 11 0xffffffff
m1_imadi ins meta get meta 415 get meta 397 0
m1_r0 r 28
put r 2 get meta 415
put r 3 get meta 397
m1_emit ins meta r 1
m1_r0 r 46
put r 6 sub lk get meta 0
put r 7 2
m1_emit ins meta r 7
m1_loop_end meta lk
end

fn m1_reduce_one ins edit ulong 8192 meta edit ulong 512 ac ulong to void
r = new ulong 8 0
off = ulong 16
while ge off 1 bound 5
m1_r0 r 42
put r 1 get meta 423
put r 2 ac
put r 6 off
m1_emit ins meta r 2
m1_bin ins meta 30 ac ac get meta 423
off = shr off 1
end
end

fn m1_store_plain sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
m1_imadw ins meta get meta 412 get meta 408 mul get sp 2 4 get meta 404
m1_r0 r 28
put r 2 get meta 396
put r 3 get meta 397
m1_emit ins meta r 1

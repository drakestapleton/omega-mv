r = new ulong 8 0
da_r0 edit r 46
da_emit_raw edit ins edit meta view r 0x000fc000
end

fn da_bf16_of ins edit ulong 8192 meta edit ulong 512 d ulong xop ulong tb ulong to void
da_shr edit ins edit meta tb xop 16
da_andi edit ins edit meta tb tb 1
da_fop2 edit ins edit meta 14 tb tb get meta 414
da_fop2 edit ins edit meta 14 d xop tb
da_shr edit ins edit meta d d 16
end

fn da_spec_ok_i sp view ulong 4 to ulong
d = get sp 0
if eq d 0
ret 0
end
if gt d 4
ret 0
end
if gt get sp 1 4
ret 0
end
ret 1
end


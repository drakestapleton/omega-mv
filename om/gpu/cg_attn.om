put r 2 and aop 0xffff
put r 6 imm
put r 7 or shl shr dop 16 16 shl shr aop 16 24
da_emit edit ins edit meta view r 0
end

fn da_xorr ins edit ulong 8192 meta edit ulong 512 dop ulong aop ulong bop ulong to void
r = new ulong 8 0
da_r0 edit r 29
put r 1 and dop 0xffff
put r 2 and aop 0xffff
put r 3 and bop 0xffff
f1 = or shl shr dop 16 16 shl shr aop 16 24
put r 7 or f1 shl shr bop 16 32

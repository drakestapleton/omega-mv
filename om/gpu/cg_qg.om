qg_r0 r 45
qg_emit ins meta r 7
qg_r0 r 46
qg_emit_raw ins meta r 0x000fc000
end

note ---- activation quantiser (pq) ----

fn pq_spec_ok sp view ulong 8 to ulong
k = get sp 0
if or lt k 128 or gt k 32768 ne rem k 128 0
ret 0
end
kb = div k 128
g = get sp 3
if eq g 0
g = kb
end
if gt g 32
ret 0
end
if ne rem kb g 0
ret 0
end
if gt get sp 1 1
ret 0
end
if gt get sp 2 3
ret 0
end
ret 1
end

fn pq_alloc meta edit ulong 512 to void
put meta 384 qg_uv meta 2
put meta 385 qg_v meta 2
put meta 386 qg_v meta 2
put meta 387 qg_v meta 2
put meta 388 qg_v meta 1
put meta 389 qg_v meta 1
put meta 390 qg_v meta 1
put meta 391 qg_v meta 4
put meta 392 qg_v meta 2
put meta 393 qg_v meta 4
put meta 394 qg_v meta 1
put meta 395 qg_v meta 1
put meta 396 qg_v meta 1
put meta 397 qg_v meta 1
put meta 398 qg_v meta 1
put meta 399 qg_v meta 1
put meta 400 qg_v meta 1
put meta 401 qg_v meta 1
put meta 402 qg_v meta 1
put meta 403 qg_v meta 1
put meta 404 qg_v meta 1
put meta 405 qg_v meta 1
put meta 406 qg_v meta 1
put meta 407 qg_v meta 1
end

fn pq_body_load sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
k = get sp 0
in_type = get sp 1
mut = get sp 2
groups = get sp 3
qg_ldcu64 ins meta get meta 384 0x358
qg_ldc64 ins meta get meta 385 0x380
qg_ldc64 ins meta get meta 386 0x388
qg_ldc64 ins meta get meta 387 0x390
qg_s2r ins meta get meta 388 0x21
qg_s2r ins meta get meta 389 0x25
if ne groups 0
cy = qg_v meta 1
if ne get meta 5 0
ret
end
qg_s2r ins meta cy 0x26
if ne mut 3
put meta 30 get meta 388
put meta 31 mul 32 groups
qg_imadi ins meta get meta 388 cy 0
end
end
qg_shr ins meta get meta 390 get meta 388 5
if eq in_type 0
put meta 30 get meta 385
qg_imadw ins meta get meta 385 get meta 389 mul k 4
put meta 30 get meta 385
qg_imadw ins meta get meta 385 get meta 388 16
put meta 31 0
put meta 32 2
qg_ldg_wide ins meta 57 get meta 391 get meta 385
else
put meta 30 get meta 385
qg_imadw ins meta get meta 385 get meta 389 mul k 2
put meta 30 get meta 385
qg_imadw ins meta get meta 385 get meta 388 8
put meta 31 0
put meta 32 2
qg_ldg_wide ins meta 56 get meta 392 get meta 385
end
put meta 30 get meta 386
qg_imadw ins meta get meta 386 get meta 389 k
put meta 30 get meta 386
qg_imadw ins meta get meta 386 get meta 388 4
put meta 30 get meta 387
qg_imadw ins meta get meta 387 get meta 389 mul div k 128 4
put meta 30 get meta 387
qg_imadw ins meta get meta 387 get meta 390 4
end

fn pq_body_quant sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
v = get meta 391
w = get meta 392
a = get meta 393
m = get meta 394
qg_movi ins meta get meta 396 0x0d800000
qg_movi ins meta get meta 400 0x001fffff
qg_movi ins meta get meta 401 0xfc000000
qg_movi ins meta get meta 402 0x83000000
if eq get sp 1 1
for j ulong 2
qg_r0 r 8
put r 1 v
put r 2 w
put r 6 65536
put r 7 or shl mul 2 j 16 shl j 24
qg_emit ins meta r 0
qg_r0 r 18
put r 1 v
put r 2 w
put r 6 0xffff0000
put r 7 or shl add mul 2 j 1 16 shl j 24
qg_emit ins meta r 0
end
end
for q ulong 4
qg_r0 r 18
put r 1 a
put r 2 v
put r 6 0x7fffffff
put r 7 or shl q 16 shl q 24
qg_emit ins meta r 0
end
put meta 34 shl ulong 1 32
qg_fmax_r ins meta m a a
put meta 34 shl ulong 2 32
qg_fmax_r ins meta m m a
put meta 34 shl ulong 3 32
qg_fmax_r ins meta m m a
put meta 34 0
qg_fmax_r ins meta m m get meta 396
if ne get sp 2 1
l = ulong 16
while ge l 1 bound 8
qg_shfl_bfly ins meta get meta 395 m l
put meta 34 0
qg_fmax_r ins meta m m get meta 395
l = shr l 1
end
end
end

fn pq_body_store sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
v = get meta 391
ev = get meta 397
mv = get meta 398
cv = get meta 399
qg_shr ins meta ev get meta 394 23
qg_andi ins meta mv get meta 394 0x007fffff
if eq get sp 2 2
qg_movi ins meta cv 0
else
put meta 30 get meta 400
put meta 31 1
qg_imadi ins meta cv mv 0
qg_shr ins meta cv cv 23
end
qg_iadd ins meta ev ev cv
put meta 30 get meta 401
put meta 31 0x00800000
qg_imadi ins meta get meta 403 ev 0
put meta 30 get meta 402
put meta 31 0xff800000
qg_imadi ins meta get meta 404 ev 0
for q ulong 4
put meta 34 or shl q 16 shl q 24
qg_fmul_r ins meta v v get meta 404
end
put meta 34 0
qg_f2e4 ins meta get meta 405 v 1
put meta 34 2
qg_f2e4 ins meta get meta 406 v 3
put meta 30 get meta 405
put meta 31 65536
qg_imadi ins meta get meta 407 get meta 406 0
put meta 31 0
qg_stg_sub ins meta get meta 386 get meta 407 0
put meta 31 0
qg_stg_sub ins meta get meta 387 get meta 403 0
qg_tail ins meta
end

note ---- grouped GEMM on QMMA (qgemm) ----

fn qg_spec_ok sp view ulong 10 to ulong
k = get sp 0
if or lt k 128 or gt k 32768 ne rem k 128 0
ret 0
end
rt = get sp 1
if ne rt 4
ret 0
end
w = get sp 2
if and ne w 8 ne w 16
ret 0
end
epi = get sp 3
if gt epi 1
ret 0
end
if gt get sp 4 1
ret 0
end
if gt get sp 6 120
ret 0
end
nv = get sp 5
if and eq epi 1 ne rem nv 256 0
ret 0
end
if eq nv 0
ret 0
end
if ne rem nv mul w 16 0
ret 0
end
eb = ulong 1
if eq epi 0
eb = ulong 4
end
if ge mul mul eb nv mul 16 rt 8388608
ret 0
end
if ne rem mul mul 16 rt 4 mul 32 w 0
ret 0
end
if gt get sp 7 4
ret 0
end
ret 1
end

fn qg_init_meta sp view ulong 10 meta edit ulong 512 to void
k = get sp 0
rt = get sp 1
w = get sp 2
t = mul 32 w
bm = mul 16 rt
abuf = mul bm 64
ns = ulong 1
if eq get sp 3 1
ns = ulong 2
end
put meta 14 t
put meta 15 mul w 16
put meta 16 k
put meta 17 rt
put meta 18 get sp 3
put meta 19 get sp 4
put meta 20 get sp 5
put meta 21 get sp 6
put meta 22 get sp 7
put meta 23 div k 128
put meta 24 div mul bm 4 t
put meta 25 abuf
put meta 26 add abuf mul bm 4
put meta 27 ns
end


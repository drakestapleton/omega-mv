fn qg_qmma_s ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong to void
r = new ulong 8 0
qg_r0 r 16
put r 1 d
put r 2 a
put r 3 b
put r 4 get meta 30
put r 6 QG_MARK
put r 7 shl get meta 34 32
cw = qg_cw 2 7 7 get meta 4
put meta 4 0
qg_emit_raw ins meta r cw
end

fn qg_nop ins edit ulong 8192 meta edit ulong 512 stall ulong to void
r = new ulong 8 0
qg_r0 r 0
cw = qg_cw stall 7 7 get meta 4
put meta 4 0
qg_emit_raw ins meta r cw
end


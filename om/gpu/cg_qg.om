fn qg_ldw_pf ins edit ulong 8192 meta edit ulong 512 op ulong d ulong addr ulong to void
r = new ulong 8 0
qg_r0 r op
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 get meta 31
sb = get meta 33
wt = and get meta 4 2
cw = or qg_cw 4 sb 1 wt 0x2000
put meta 4 or get meta 4 2
put meta 6 or get meta 6 shl ulong 1 sb
qg_emit_raw ins meta r cw
end

fn qg_sts32_sub ins edit ulong 8192 meta edit ulong 512 addr ulong val ulong subr ulong to void
r = new ulong 8 0
qg_r0 r 50
put r 2 addr

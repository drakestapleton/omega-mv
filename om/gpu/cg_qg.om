om2
note Pure OM-2 Blackwell native FP8 prefill codegen (om/gpu/cg_qg.om).
note Replaces the pq and qgemm emitters in src/omega_blackwell_codegen_qg.c.

const QG_NOREG ulong 0xffffffffffffffff
const QG_MARK ulong 0x51303832
const QG_MARK_F2E4 ulong 0x46453433

fn qg_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn qg_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn qg_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn qg_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 QG_NOREG
put r 2 QG_NOREG
put r 3 QG_NOREG
put r 4 QG_NOREG
put r 5 QG_NOREG
put r 6 0
put r 7 0
end

fn qg_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = qg_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = qg_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or qg_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or qg_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or qg_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or qg_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = qg_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = qg_cw 5 7 7 wt
if eq and shr get r 7 1 1 0
put meta 4 0
end
end
if eq kind 8
cw = or qg_cw 1 7 7 wt 0x2000
put meta 4 0
end
if eq kind 9
cw = or qg_cw 5 7 7 wt 0x2000
put meta 4 0
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn qg_emit_raw ins edit ulong 8192 meta edit ulong 512 r view ulong 8 cw ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn qg_consume meta edit ulong 512 sb ulong to void
bit = shl ulong 1 sb
h = get meta 6
p = get meta 4
put meta 4 or p and h bit
put meta 6 sub h and h bit
end

fn qg_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
n = get meta 0
if eq n 0
put meta 5 1
ret
end
put meta add 320 mul 2 nl start
put meta add 321 mul 2 nl sub n 1
put meta 3 add nl 1
end

fn qg_patch_bra ins edit ulong 8192 pos ulong target ulong to void
if ge pos 1024
ret
end
idx = add mul pos 8 6
old = get ins idx
hi = and old 0xffffffff00000000
lo = and sub target pos 0xffffffff
put ins idx or hi lo
end

fn qg_ldcu64 ins edit ulong 8192 meta edit ulong 512 ud ulong off ulong to void
r = new ulong 8 0
qg_r0 r 7
put r 1 ud
put r 6 off
put r 7 1
qg_emit ins meta r 4
end

fn qg_ldc64 ins edit ulong 8192 meta edit ulong 512 d ulong off ulong to void

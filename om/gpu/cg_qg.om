fn qg_staging_one ins edit ulong 8192 meta edit ulong 512 jj ulong to void
tmp = get meta 403
tmp2 = get meta 404
r = get meta 428
srow = get meta 430
ti = get meta 434
qg_shr ins meta r get meta 389 2
put meta 30 r
put meta 31 div mul jj get meta 14 4

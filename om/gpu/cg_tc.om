om2
note Pure OM-2 Blackwell tensor-core probe, tcgemm, tc_peak and tc_bw codegen (om/gpu/cg_tc.om).
note Replaces the kernel emitters in src/omega_blackwell_codegen_tc.c.

const T1_NOREG ulong 0xffffffffffffffff

fn t1_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn t1_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn t1_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn t1_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 T1_NOREG
put r 2 T1_NOREG
put r 3 T1_NOREG
put r 4 T1_NOREG
put r 5 T1_NOREG
put r 6 0
put r 7 0
end

fn t1_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = t1_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = t1_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or t1_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or t1_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or t1_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or t1_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = t1_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = t1_cw 5 7 7 wt
if eq and shr get r 7 1 1 0
put meta 4 0
end
end
if eq kind 8
cw = or t1_cw 1 7 7 wt 0x2000
put meta 4 0
end
if eq kind 9
cw = or t1_cw 5 7 7 wt 0x2000
put meta 4 0
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn t1_emit_raw ins edit ulong 8192 meta edit ulong 512 r view ulong 8 cw ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn t1_consume meta edit ulong 512 sb ulong to void
bit = shl ulong 1 sb
h = get meta 6
p = get meta 4
put meta 4 or p and h bit
put meta 6 sub h and h bit
end

fn t1_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
n = get meta 0
if eq n 0
put meta 5 1
ret
end
put meta add 320 mul 2 nl start
put meta add 321 mul 2 nl sub n 1
put meta 3 add nl 1
end

fn t1_patch_bra ins edit ulong 8192 pos ulong target ulong to void
if ge pos 1024
ret
end
idx = add mul pos 8 6
old = get ins idx
hi = and old 0xffffffff00000000
lo = and sub target pos 0xffffffff
put ins idx or hi lo
end

fn t1_ldcu64 ins edit ulong 8192 meta edit ulong 512 ud ulong off ulong to void
r = new ulong 8 0
t1_r0 r 7
put r 1 ud
put r 6 off
put r 7 1
t1_emit ins meta r 4
end

fn t1_ldc64 ins edit ulong 8192 meta edit ulong 512 d ulong off ulong to void
r = new ulong 8 0
t1_r0 r 5
put r 1 d
put r 6 off
t1_emit ins meta r 2
end

fn t1_ldc32 ins edit ulong 8192 meta edit ulong 512 d ulong off ulong to void
r = new ulong 8 0
t1_r0 r 4
put r 1 d
put r 6 off
t1_emit ins meta r 2
end

fn t1_s2r ins edit ulong 8192 meta edit ulong 512 d ulong sr ulong to void
r = new ulong 8 0
t1_r0 r 3
put r 1 d
put r 6 sr
t1_emit ins meta r 2
end

fn t1_movi ins edit ulong 8192 meta edit ulong 512 d ulong imm ulong to void
r = new ulong 8 0
t1_r0 r 2
put r 1 d
put r 6 imm
t1_emit ins meta r 0
end

fn t1_movi_sub ins edit ulong 8192 meta edit ulong 512 d ulong dsub ulong imm ulong to void
r = new ulong 8 0
t1_r0 r 2
put r 1 d
put r 6 imm
put r 7 shl dsub 16
t1_emit ins meta r 0
end

fn t1_movrz_sub ins edit ulong 8192 meta edit ulong 512 d ulong dsub ulong to void
r = new ulong 8 0
t1_r0 r 1
put r 1 d
put r 7 shl dsub 16
t1_emit ins meta r 0
end

fn t1_imadi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong to void
r = new ulong 8 0
t1_r0 r 8
put r 1 d
put r 2 a
put r 4 get meta 30
put r 6 get meta 31
put r 7 shl asub 24
t1_emit ins meta r 0
end

fn t1_imadr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong to void
r = new ulong 8 0
t1_r0 r 8
put r 1 d
put r 2 a
put r 3 b
put r 4 get meta 30
t1_emit ins meta r 0
end

fn t1_imadw ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong to void
r = new ulong 8 0
t1_r0 r 9
put r 1 d
put r 2 a
put r 4 get meta 30
put r 6 imm
t1_emit ins meta r 0
end

fn t1_shr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong to void
r = new ulong 8 0
t1_r0 r 17
put r 1 d
put r 2 a
put r 6 imm
t1_emit ins meta r 0
end

fn t1_andi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong to void
r = new ulong 8 0
t1_r0 r 18
put r 1 d
put r 2 a
put r 6 imm
t1_emit ins meta r 0
end

fn t1_andi_s ins edit ulong 8192 meta edit ulong 512 d ulong a ulong asub ulong to void
r = new ulong 8 0
t1_r0 r 18
put r 1 d
put r 2 a
put r 6 get meta 31
put r 7 shl asub 24
t1_emit ins meta r 0
end

fn t1_iadd ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong to void
r = new ulong 8 0
t1_r0 r 14
put r 1 d
put r 2 a
put r 3 b
t1_emit ins meta r 0
end

fn t1_xor_s2 ins edit ulong 8192 meta edit ulong 512 d ulong b ulong s2sub ulong to void
r = new ulong 8 0
t1_r0 r 29
put r 1 d
put r 2 d
put r 3 b
put r 7 shl s2sub 32
t1_emit ins meta r 0
end

fn t1_ldg_wide ins edit ulong 8192 meta edit ulong 512 op ulong d ulong addr ulong to void
r = new ulong 8 0
t1_r0 r op
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 get meta 31
t1_emit ins meta r get meta 32
end

fn t1_ldg32 ins edit ulong 8192 meta edit ulong 512 d ulong addr ulong to void
r = new ulong 8 0
t1_r0 r 11
put r 1 d
put r 2 addr
put r 5 get meta 384
t1_emit ins meta r 2
end

fn t1_ldw_pf ins edit ulong 8192 meta edit ulong 512 op ulong d ulong addr ulong to void
r = new ulong 8 0
t1_r0 r op
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 get meta 31
sb = get meta 33
wt = and get meta 4 2
cw = or t1_cw 4 sb 1 wt 0x2000
put meta 4 or get meta 4 2
put meta 6 or get meta 6 shl ulong 1 sb
t1_emit_raw ins meta r cw
end

fn t1_sts32_sub ins edit ulong 8192 meta edit ulong 512 addr ulong val ulong subr ulong to void
r = new ulong 8 0
t1_r0 r 50
put r 2 addr
put r 3 val
put r 7 shl subr 32
t1_emit ins meta r 5
end

fn t1_lds128 ins edit ulong 8192 meta edit ulong 512 d ulong addr ulong imm ulong to void
r = new ulong 8 0
t1_r0 r 58
put r 1 d
put r 2 addr
put r 6 imm
t1_emit ins meta r get meta 32
end

fn t1_stg_sub ins edit ulong 8192 meta edit ulong 512 addr ulong val ulong subr ulong to void
r = new ulong 8 0
t1_r0 r 12
put r 2 addr
put r 3 val
put r 5 get meta 384
put r 6 get meta 31
put r 7 shl subr 32
t1_emit ins meta r 5
end

fn t1_bar_sync ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
t1_r0 r 48
t1_emit ins meta r 6
end

fn t1_hmma ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong to void
r = new ulong 8 0
t1_r0 r 16
put r 1 d
put r 2 a
put r 3 b
put r 4 get meta 30
cw = t1_cw get meta 34 7 7 get meta 4
put meta 4 0
t1_emit_raw ins meta r cw
end

fn t1_nop ins edit ulong 8192 meta edit ulong 512 stall ulong to void
r = new ulong 8 0
t1_r0 r 0
cw = t1_cw stall 7 7 get meta 4
put meta 4 0
t1_emit_raw ins meta r cw
end

fn t1_ffma_q ins edit ulong 8192 meta edit ulong 512 acc ulong tm ulong sc ulong to void
r = new ulong 8 0
for q ulong 4
t1_r0 r 33
put r 1 acc
put r 2 tm
put r 3 sc
put r 4 acc
put r 7 or or shl q 16 shl q 24 shl q 40
t1_emit ins meta r 0
end
end

fn t1_isetp_ge_u32 ins edit ulong 8192 meta edit ulong 512 a ulong b ulong to void
r = new ulong 8 0
t1_r0 r 28
put r 2 a
put r 3 b
t1_emit ins meta r 1
end

fn t1_bra_p0 ins edit ulong 8192 meta edit ulong 512 target ulong to void
r = new ulong 8 0
t1_r0 r 46
here = get meta 0
put r 6 and sub target here 0xffffffff
put r 7 2
t1_emit ins meta r 7
end

fn t1_bra_p0_fwd ins edit ulong 8192 meta edit ulong 512 to ulong
pos = get meta 0
r = new ulong 8 0
t1_r0 r 46
put r 6 1
put r 7 2
t1_emit ins meta r 7
ret pos
end

fn t1_bssy_fwd ins edit ulong 8192 meta edit ulong 512 to ulong
pos = get meta 0
r = new ulong 8 0
t1_r0 r 54
put r 6 2
t1_emit ins meta r 8
ret pos
end

fn t1_bsync ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
t1_r0 r 55
t1_emit ins meta r 9
end

fn t1_tail ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
t1_r0 r 45
t1_emit ins meta r 7
t1_r0 r 46
t1_emit_raw ins meta r 0x000fc000
end

fn t1_decode_word ins edit ulong 8192 meta edit ulong 512 bp ulong wq ulong word ulong to void
m = get meta 437
s = get meta 438
t = get meta 439
put meta 31 0x007f007f
t1_andi_s ins meta m wq word
put meta 31 0x00800080
t1_andi_s ins meta s wq word
put meta 30 T1_NOREG
put meta 31 16
t1_imadi ins meta t m 0
r = new ulong 8 0
t1_r0 r 8
put r 1 bp
put r 2 s
put r 4 t
put r 6 256
t1_emit ins meta r 0
put meta 31 0x7f007f00
t1_andi_s ins meta m wq word
put meta 31 0x80008000
t1_andi_s ins meta s wq word
t1_shr ins meta t m 4
t1_r0 r 14
put r 1 bp
put r 2 t
put r 3 s
put r 7 shl ulong 1 16
t1_emit ins meta r 0
end

note ---- tcgemm spec & emitter ----

fn t1_spec_ok sp view ulong 8 to ulong
k = get sp 0
if or lt k 128 or gt k 32768 ne rem k 128 0
ret 0
end
rt = get sp 1
if and ne rt 1 and ne rt 2 ne rt 4
ret 0
end
ct = get sp 2
if and ne ct 1 and ne ct 2 ne ct 4
ret 0
end
if lt mul rt ct 4
ret 0
end
w = get sp 3
if and ne w 1 and ne w 2 and ne w 4 ne w 8
ret 0
end
if ne rem mul mul 16 rt 8 mul 32 w 0
ret 0
end
mut = get sp 4
if gt mut 4
ret 0
end
if and eq mut 3 lt rt 2
ret 0
end
ret 1
end

fn t1_init_meta sp view ulong 8 meta edit ulong 512 to void
k = get sp 0
rt = get sp 1
ct = get sp 2
w = get sp 3
aqn = ulong 2
if ge mul rt ct 8
aqn = ulong 1
end
t = mul 32 w
bm = mul 16 rt
put meta 14 t
put meta 15 mul mul w 8 ct
put meta 16 k
put meta 17 rt
put meta 18 ct
put meta 19 aqn
put meta 20 get sp 4
put meta 21 div k 128
put meta 22 div mul bm 8 t
put meta 23 mul bm 128
end

fn t1_prologue ins edit ulong 8192 meta edit ulong 512 to void
udesc = t1_uv meta 2
put meta 384 udesc
put meta 385 t1_v meta 2
put meta 386 t1_v meta 2
put meta 387 t1_v meta 2
put meta 388 t1_v meta 2
put meta 389 t1_v meta 1
put meta 390 t1_v meta 1
put meta 391 t1_v meta 1
put meta 392 t1_v meta 1
put meta 393 t1_v meta 1
put meta 394 t1_v meta 1
put meta 395 t1_v meta 1
put meta 396 t1_v meta 1
put meta 397 t1_v meta 1
put meta 398 t1_v meta 2
put meta 399 t1_v meta 2
put meta 400 t1_v meta 2
put meta 401 t1_v meta 2
put meta 402 t1_v meta 1
put meta 403 t1_v meta 1
put meta 404 t1_v meta 1
put meta 405 t1_v meta 1
put meta 406 t1_v meta 1
put meta 407 t1_v meta 2
put meta 408 t1_v meta 2
put meta 409 t1_v meta 1
put meta 410 t1_v meta 1
put meta 411 t1_v meta 2
if ne get meta 5 0
ret
end
t1_ldcu64 ins meta udesc 0x358
t1_ldc64 ins meta get meta 385 0x380
t1_ldc64 ins meta get meta 386 0x388
t1_ldc64 ins meta get meta 387 0x390
t1_ldc64 ins meta get meta 388 0x398
t1_ldc32 ins meta get meta 389 0x3a0
t1_s2r ins meta get meta 390 0x21
t1_s2r ins meta get meta 391 0x25
t1_s2r ins meta get meta 392 0x26
t1_movi ins meta get meta 397 1
t1_shr ins meta get meta 393 get meta 390 5
t1_andi ins meta get meta 394 get meta 390 31
t1_shr ins meta get meta 395 get meta 394 2
t1_andi ins meta get meta 396 get meta 394 3
put meta 30 get meta 385
t1_imadw ins meta get meta 398 get meta 392 32
put meta 31 0
put meta 32 2
t1_ldg_wide ins meta 56 get meta 399 get meta 398
put meta 31 8
put meta 32 3
t1_ldg_wide ins meta 56 get meta 400 get meta 398
put meta 31 16
t1_ldg_wide ins meta 56 get meta 401 get meta 398
put meta 30 T1_NOREG
put meta 31 1
t1_imadi ins meta get meta 402 get meta 401 0
put meta 30 T1_NOREG
put meta 31 1
t1_imadi ins meta get meta 403 get meta 401 1
end

fn t1_prologue_ptrs ins edit ulong 8192 meta edit ulong 512 to void
n0w = get meta 404
tmp = get meta 405
tmp2 = get meta 406
pw = get meta 407
put meta 30 T1_NOREG
put meta 31 get meta 15
t1_imadi ins meta n0w get meta 391 0
put meta 30 T1_NOREG
put meta 31 mul 8 get meta 18
t1_imadi ins meta tmp get meta 393 0
t1_iadd ins meta n0w n0w tmp
t1_iadd ins meta tmp n0w get meta 395
put meta 30 get meta 399
t1_imadw ins meta pw tmp get meta 16
put meta 30 T1_NOREG
put meta 31 16
t1_imadi ins meta tmp2 get meta 396 0
put meta 30 pw
t1_imadw ins meta pw tmp2 1
t1_shr ins meta tmp n0w 7
put meta 30 get meta 400
t1_imadw ins meta get meta 408 tmp mul get meta 21 4
put meta 30 T1_NOREG
put meta 31 16
t1_imadi ins meta get meta 409 get meta 394 0
put meta 30 T1_NOREG
put meta 31 4
t1_imadi ins meta get meta 410 get meta 389 0
t1_iadd ins meta tmp get meta 402 get meta 395
put meta 30 n0w
t1_imadr ins meta tmp tmp get meta 389
put meta 30 T1_NOREG
put meta 31 2
t1_imadi ins meta tmp2 get meta 396 0
t1_iadd ins meta tmp tmp tmp2
put meta 30 get meta 388
t1_imadw ins meta get meta 411 tmp 4
end

fn t1_staging_one ins edit ulong 8192 meta edit ulong 512 jj ulong to void
gxj = get meta add 412 jj
saj = get meta add 420 jj
tmp = get meta 405
tmp2 = get meta 406
r = get meta 428
srow = get meta 430
t1_shr ins meta r get meta 390 3
put meta 30 r
put meta 31 div mul jj get meta 14 8
t1_imadi ins meta r get meta 397 0
t1_iadd ins meta tmp get meta 402 r
put meta 30 get meta 386
t1_imadw ins meta get meta 429 tmp 4
t1_ldg32 ins meta srow get meta 429
put meta 30 get meta 387
t1_imadw ins meta gxj srow mul get meta 16 2
put meta 30 gxj
t1_imadw ins meta gxj get meta 431 1
t1_shr ins meta tmp r 4
put meta 30 get meta 433
put meta 31 4
t1_imadi ins meta tmp tmp 0
put meta 30 get meta 432
put meta 31 32
t1_imadi ins meta tmp tmp 0
t1_andi ins meta tmp2 r 7
put meta 30 tmp
put meta 31 4
t1_imadi ins meta tmp2 tmp2 0
put meta 30 T1_NOREG
put meta 31 16
t1_imadi ins meta saj tmp2 0
t1_shr ins meta tmp2 r 3
t1_andi ins meta tmp2 tmp2 1
put meta 30 saj
put meta 31 4
t1_imadi ins meta saj tmp2 0
end

fn t1_staging_setup ins edit ulong 8192 meta edit ulong 512 to void
nj = get meta 22
for jj ulong nj bound 16
put meta add 412 jj t1_v meta 2
put meta add 420 jj t1_v meta 1
end
put meta 428 t1_v meta 1
put meta 429 t1_v meta 2
put meta 430 t1_v meta 1
put meta 431 t1_v meta 1
put meta 432 t1_v meta 1
put meta 433 t1_v meta 1
if ne get meta 5 0
ret
end
tid = get meta 390
tmp = get meta 405
t1_andi ins meta tmp tid 7
put meta 30 T1_NOREG
put meta 31 16
t1_imadi ins meta get meta 431 tmp 0
t1_shr ins meta get meta 432 tmp 1
t1_andi ins meta get meta 433 tid 1
put meta 30 T1_NOREG
put meta 31 2
t1_imadi ins meta get meta 433 get meta 433 0
for jj ulong nj bound 16
t1_staging_one ins meta jj
end
end

fn t1_alloc_loop_regs meta edit ulong 512 to void
put meta 434 t1_v meta 1
put meta 435 t1_v meta 1
put meta 436 t1_v meta 1
put meta 437 t1_v meta 1
put meta 438 t1_v meta 1
put meta 439 t1_v meta 1
put meta 440 t1_v meta 1
put meta 441 t1_v meta 1
for x ulong mul get meta 17 get meta 18 bound 32
put meta add 442 x t1_v meta 4
put meta add 458 x t1_v meta 4
end
for j ulong get meta 18 bound 8
put meta add 474 j t1_v meta 4
put meta add 478 j t1_v meta 4
put meta add 482 j t1_v meta 2
end
for q ulong get meta 19 bound 4
put meta add 486 q t1_v meta 4
end
for jj ulong get meta 22 bound 16
put meta add 488 jj t1_v meta 4
end
end

fn t1_issue ins edit ulong 8192 meta edit ulong 512 wbase_idx ulong sb ulong mode ulong to void
put meta 33 sb
xoff = ulong 0
woff = ulong 0
if eq mode 1
xoff = ulong 128
woff = ulong 64
end
for jj ulong get meta 22 bound 16
put meta 31 xoff
t1_ldw_pf ins meta 57 get meta add 488 jj get meta add 412 jj
end
for j ulong get meta 18 bound 8
put meta 31 add woff mul mul j 8 get meta 16
t1_ldw_pf ins meta 57 get meta add wbase_idx j get meta 407
end
if eq mode 0
put meta 31 0
t1_ldw_pf ins meta 11 get meta 434 get meta 408
end
end

fn t1_stage ins edit ulong 8192 meta edit ulong 512 bufoff ulong to void
one = get meta 397
tmp = get meta 405
for jj ulong get meta 22 bound 16
saj = get meta add 420 jj
stgv = get meta add 488 jj
put meta 30 saj
put meta 31 bufoff
t1_imadi ins meta tmp one 0
t1_sts32_sub ins meta tmp stgv 0
put meta 30 saj
put meta 31 add bufoff 8
t1_imadi ins meta tmp one 0
t1_sts32_sub ins meta tmp stgv 1
put meta 30 saj
put meta 31 add bufoff 512
t1_imadi ins meta tmp one 0
t1_sts32_sub ins meta tmp stgv 2
put meta 30 saj
put meta 31 add bufoff 520
t1_imadi ins meta tmp one 0
t1_sts32_sub ins meta tmp stgv 3
end
t1_bar_sync ins meta
end

fn t1_hmma_row ins edit ulong 8192 meta edit ulong 512 row ulong aqv ulong zero_c ulong to void
ct = get meta 18
put meta 34 8
for j ulong ct bound 8
x = add mul row ct j
tv = get meta add 458 x
if ne zero_c 0
put meta 30 T1_NOREG
else
put meta 30 tv
end
t1_hmma ins meta tv aqv get meta add 482 j
end
end

fn t1_compute_tile ins edit ulong 8192 meta edit ulong 512 bufoff ulong s ulong i0 ulong to void
nb = sub get meta 17 i0
if gt nb get meta 19
nb = get meta 19
end
for q ulong nb bound 4
ii = add i0 q
if eq get meta 20 3
ii = xor ii 1
end
if eq q 0
put meta 32 2
else
put meta 32 3
end
soff = add bufoff mul add mul ii 4 s 512
t1_lds128 ins meta get meta add 486 q get meta 409 soff
end
zero_c = ulong 0
if and ne get meta 35 0 eq s 0
zero_c = ulong 1
end
for q ulong nb bound 4
t1_hmma_row ins meta add i0 q get meta add 486 q zero_c
end
end

fn t1_compute ins edit ulong 8192 meta edit ulong 512 bufoff ulong wbase_idx ulong mode ulong to void
first = and mode 1
odd = shr mode 1
put meta 35 first
for s ulong 4
if and eq get meta 20 4 and ne odd 0 eq s 3
break
end
for j ulong get meta 18 bound 8
t1_decode_word ins meta get meta add 482 j get meta add wbase_idx j s
end
i0 = ulong 0
while lt i0 get meta 17 bound 16
t1_compute_tile ins meta bufoff s i0
i0 = add i0 get meta 19
end
end
end

fn t1_kloop_advance ins edit ulong 8192 meta edit ulong 512 to void
nf = t1_v meta 1
inc = t1_v meta 1
if ne get meta 5 0
ret
end
one = get meta 397
put meta 30 get meta 436
put meta 31 0xfffffffe
t1_imadi ins meta nf one 0
t1_shr ins meta nf nf 31
put meta 30 one
put meta 31 0xffffffff
t1_imadi ins meta nf nf 0
for jj ulong get meta 22 bound 16
gxj = get meta add 412 jj
put meta 30 gxj
t1_imadw ins meta gxj nf 256
end
put meta 30 get meta 407
t1_imadw ins meta get meta 407 nf 128
sinc = ulong 4
if eq get meta 20 2
sinc = ulong 0
end
put meta 30 T1_NOREG
put meta 31 sinc
t1_imadi ins meta inc nf 0
put meta 30 get meta 408
t1_imadw ins meta get meta 408 inc 1
end

fn t1_kloop ins edit ulong 8192 meta edit ulong 512 to void
for x ulong mul get meta 17 get meta 18 bound 32
av = get meta add 442 x
for q ulong 4
t1_movrz_sub ins meta av q
end
end

note SPDX-License-Identifier: Apache-2.0
note om/gpu/bw_qmd.om: Blackwell sm_121 QMD0/QMD1 builder and invariant verifier in pure OM-2.
note Replaces the QMD packing and verification logic of src/omega_blackwell_qmd.c.
note Word 36 dynamically sets MIN_ and TARGET_SM_CONFIG_SHARED_MEM_SIZE from shared_bytes:
note   <= 32768 B -> 9 (32 KiB), <= 65536 B -> 17 (64 KiB), <= 98304 B -> 26 (100 KiB),
note   keeping MAX = 26 (100 KiB). For shared_bytes <= 32768 this is bit-identical to 0x04b44808.
om2

const QMD_MAX_SMEM ulong 98304

fn u32lo v ulong to uint
ret uint and v 0xffffffff
end

fn qzero q edit uint 96 to void
for i ulong 96
put q i 0
end
end

fn resolve_tx m view ulong 16 to ulong
tx = get m 8
if ne tx 0
ret tx
end
tpb = get m 6
if ne tpb 0
ret tpb
end
ret 64
end

fn resolve_gx m view ulong 16 tx ulong to ulong
gx = get m 10
if ne gx 0
ret gx
end
gw = get m 7
if ne gw 0
ret gw
end
ne_val = get m 5
g = div add ne_val sub tx 1 tx
if eq g 0
ret 1
end
ret g
end

fn smem_cfg_for sb ulong to ulong
if le sb 32768
ret 9
end
if le sb 65536
ret 17
end
ret 26
end

export fn bw_qmd0 q edit uint 96 qmd1_va ulong to ulong
qzero q
put q 4 0x00800002
put q 10 0x00230000
put q 12 u32lo shr qmd1_va 8
put q 14 0x00500200
put q 34 0x00010001
put q 35 0x00000801
ret 0
end

fn qmd1_head m view ulong 16 q edit uint 96 to void
code_va = get m 0
sem_va = get m 3
qmd0_va = get m 4
put q 4 0x013f0000
put q 9 0x00000003
put q 10 0x00190000
put q 12 u32lo shr qmd0_va 8
put q 14 0x2f5003a4
put q 15 u32lo sem_va
put q 16 u32lo shr sem_va 32
put q 17 0x00000006
put q 19 0x81810000
put q 20 0x00000038
put q 22 0x04000000
put q 32 u32lo shr code_va 4
put q 33 u32lo or and shr code_va 36 0x1fffff shl ulong 0xa 21
end

fn qmd1_cbanks m view ulong 16 q edit uint 96 to void
cbank_va = get m 1
scratch_va = get m 2
code_va = get m 0
cb5 = add cbank_va 0x300
put q 42 u32lo shr cbank_va 6
put q 43 u32lo or and shr cbank_va 38 0x7ffff shl ulong 0x40 19
put q 44 u32lo shr scratch_va 6
put q 45 u32lo or and shr scratch_va 38 0x7ffff shl ulong 0x90 19
put q 52 u32lo shr cb5 6
put q 53 u32lo or and shr cb5 38 0x7ffff shl ulong 0x10 19
put q 56 u32lo shr scratch_va 6
put q 57 u32lo or and shr scratch_va 38 0x7ffff shl ulong 0x1000 19
put q 58 0x10300011
put q 59 u32lo shr code_va 8
end

fn qmd1_dims m view ulong 16 q edit uint 96 to void
tx = resolve_tx m
ty = get m 9
if eq ty 0
ty = ulong 1
end
gx = resolve_gx m tx
gy = get m 11
if eq gy 0
gy = ulong 1
end
gpr = get m 12
if lt gpr 16
gpr = ulong 16
end
put q 34 u32lo or and tx 0xffff shl and ty 0xffff 16
put q 35 u32lo or or ulong 1 shl and gpr 0x1ff 8 shl ulong 1 17
put q 37 0
put q 39 u32lo gx
put q 40 u32lo gy
put q 41 1
end

export fn bw_qmd1 m view ulong 16 q edit uint 96 to ulong
sb = get m 13
if gt sb QMD_MAX_SMEM
ret 1
end
qzero q
qmd1_head m q
qmd1_dims m q
s7 = ulong 8
if ne sb 0
s7 = div add sb 127 128
end
sc = smem_cfg_for sb
w36 = or or or shl sc 23 shl ulong 26 17 shl sc 11 s7
put q 36 u32lo w36
qmd1_cbanks m q
ret 0
end

export fn bw_qmd_verify q view uint 96 to ulong
ver = and shr get q 14 20 0xf
if ne ver 5
ret 1
end
qtype = and shr get q 4 23 0x7
if ne qtype 2
ret 1
end
if ne get q 37 0
ret 1
end
if eq get q 17 0
ret 1
end
pf = and shr get q 33 21 0x1ff
if ne pf 0xa
ret 1
end
if eq and get q 58 1 0
ret 1
end
ret 0
end

note The single-token hd256 record and direct launch share the same 25-word kernel ABI.
note Input addresses: QKV, K, plane bytes, RoPE, norm base, output, partials, counters.
note Scalars: layer, position, tokens per split, split count, max position, epsilon bits, output scale bits, log2 scale bits.
fn attn_addr args edit uint 25 i ulong va ulong to void
put args i u32lo va
put args add i 1 u32lo shr va 32
end

export fn bw_attn256_args s view ulong 16 args edit uint 25 to ulong
norm = add get s 4 mul get s 8 2048
attn_addr args 0 get s 0
attn_addr args 2 get s 1
attn_addr args 4 add get s 1 get s 2
attn_addr args 6 get s 3
attn_addr args 8 norm
attn_addr args 10 add norm 1024
attn_addr args 12 get s 5
attn_addr args 14 get s 6
attn_addr args 16 get s 7
put args 18 u32lo get s 9
put args 19 u32lo get s 10
put args 20 u32lo get s 11
put args 21 u32lo mul get s 12 512
put args 22 u32lo get s 13
put args 23 u32lo get s 14
put args 24 u32lo get s 15
ret 0
end

note Record one hd256 launch. The caller reserves a valid slot and publishes it after success.
note Slot fields: code, bank, scratch, semaphore, QMD1, declared registers, grid Y, output words.
export fn bw_attn256_record s view ulong 16 slot view ulong 8 driver view uint 224 bank edit uint 249 q1 edit uint 96 q0 edit uint 96 to ulong
gx = get s 11
gy = get slot 6
if eq gx 0
ret 1
end
if eq gy 0
ret 1
end
if eq get slot 0 0
ret 1
end
m = new ulong 16 0
for i ulong 4
put m i get slot i
end
put m 4 add get slot 4 512
put m 5 get slot 7
put m 8 256
put m 9 1
put m 10 gx
put m 11 gy
regs = get slot 5
if le regs 64
regs = ulong 64
else
regs = and add regs 7 0xfffffff8
end
put m 12 regs
put m 13 14896
if ne bw_qmd1 m q1 0
ret 1
end
if ne bw_qmd_verify q1 0
ret 1
end
if ne bw_qmd0 q0 get slot 4 0
ret 1
end
for i ulong 224
put bank i get driver i
end
va = get slot 1
put bank 68 u32lo shr va 32
put bank 69 u32lo va
put bank 210 u32lo shr add va 0x380 32
put bank 211 u32lo add va 0x380
put bank 212 u32lo shr add va 0x39c 32
put bank 213 u32lo add va 0x39c
put bank 216 256
put bank 217 1
put bank 220 u32lo gx
put bank 221 u32lo gy
args = new uint 25 0
status = bw_attn256_args s args
for i ulong 25
put bank add i 224 get args i
end
ret status
end

om2
note Pure OM-2 Blackwell QMMA probe/peak and F2E4 probe codegen (om/gpu/cg_qmma.om).
note Replaces the kernel emitters in src/omega_blackwell_codegen_qmma.c.

const QM_NOREG ulong 0xffffffffffffffff
const QM_MARK ulong 0x51303832
const QM_MARK_F2E4 ulong 0x46453433

fn qm_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn qm_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn qm_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn qm_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 QM_NOREG
put r 2 QM_NOREG
put r 3 QM_NOREG
put r 4 QM_NOREG
put r 5 QM_NOREG
put r 6 0
put r 7 0
end

fn qm_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = qm_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = qm_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or qm_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or qm_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or qm_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or qm_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 7
cw = qm_cw 5 7 7 wt
if eq and shr get r 7 1 1 0
put meta 4 0
end
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn qm_emit_raw ins edit ulong 8192 meta edit ulong 512 r view ulong 8 stall ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
cw = qm_cw stall 7 7 get meta 4
put meta 4 0
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn qm_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
put meta add 320 mul nl 2 start
put meta add 321 mul nl 2 sub get meta 0 1
put meta 3 add nl 1
end

fn qm_tail ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
qm_r0 r 45
qm_emit ins meta r 7
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
b = mul n 8
put ins b 46
put ins add b 1 QM_NOREG
put ins add b 2 QM_NOREG
put ins add b 3 QM_NOREG
put ins add b 4 QM_NOREG
put ins add b 5 QM_NOREG
put ins add b 6 shl ulong 0x000fc000 32
put ins add b 7 0
put meta 0 add n 1
end

fn qm_op1 ins edit ulong 8192 meta edit ulong 512 op ulong d ulong imm ulong kind ulong to void
r = new ulong 8 0
qm_r0 r op
put r 1 d
put r 6 imm
if eq kind 4
put r 7 1
end
qm_emit ins meta r kind
end

fn qm_imadi ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong c ulong to void
r = new ulong 8 0
qm_r0 r 8
put r 1 d
put r 2 a
put r 4 c
put r 6 imm
qm_emit ins meta r 0
end

fn qm_imadw ins edit ulong 8192 meta edit ulong 512 d ulong a ulong imm ulong c ulong to void
r = new ulong 8 0
qm_r0 r 9
put r 1 d
put r 2 a
put r 4 c
put r 6 imm
qm_emit ins meta r 0
end

fn qm_ldg ins edit ulong 8192 meta edit ulong 512 op ulong d ulong addr ulong imm ulong to void
r = new ulong 8 0
qm_r0 r op
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 imm
qm_emit ins meta r get meta 12
end

fn qm_nop ins edit ulong 8192 meta edit ulong 512 stall ulong to void
r = new ulong 8 0
qm_r0 r 0
qm_emit_raw ins meta r stall
end

fn qm_qmma ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong c ulong to void
r = new ulong 8 0
qm_r0 r 16
put r 1 d
put r 2 a
put r 3 b
put r 4 c
put r 6 QM_MARK
qm_emit_raw ins meta r get meta 13
end

fn qm_probe_body sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
qm_op1 ins meta 7 get meta 384 0x358 4
qm_op1 ins meta 5 get meta 385 0x380 2
qm_op1 ins meta 5 get meta 386 0x388 2
qm_op1 ins meta 3 get meta 387 0x21 2
qm_op1 ins meta 3 get meta 388 0x25 2
qm_imadw ins meta get meta 391 get meta 388 1280 get meta 385
qm_imadw ins meta get meta 389 get meta 387 16 get meta 391
qm_imadw ins meta get meta 392 get meta 387 8 get meta 391
qm_imadw ins meta get meta 390 get meta 388 512 get meta 386
qm_imadw ins meta get meta 390 get meta 387 16 get meta 390
put meta 12 2
qm_ldg ins meta 57 get meta 393 get meta 389 0
put meta 12 3
qm_ldg ins meta 57 get meta 395 get meta 389 768
qm_ldg ins meta 56 get meta 394 get meta 392 512
put meta 13 15
cv = get meta 395
if eq get sp 0 1
cv = QM_NOREG
end
qm_qmma ins meta get meta 396 get meta 393 get meta 394 cv
for i ulong get sp 1 bound 16
qm_nop ins meta 15
end
for q ulong 4
qm_r0 r 12
put r 2 get meta 390
put r 3 get meta 396
put r 5 get meta 384
put r 6 mul 4 q
put r 7 shl q 32
qm_emit ins meta r 5
end
qm_tail ins meta
end

fn qm_peak_init sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
qm_op1 ins meta 7 get meta 384 0x358 4
qm_op1 ins meta 5 get meta 385 0x380 2
qm_op1 ins meta 3 get meta 386 0x21 2
qm_op1 ins meta 3 get meta 387 0x25 2
qm_op1 ins meta 2 get meta 388 1 0
for q ulong 4
qm_r0 r 2
put r 1 get meta 390
put r 6 0x38383838
put r 7 shl q 16
qm_emit ins meta r 0
end
for q ulong 2
qm_r0 r 2
put r 1 get meta 391
put r 6 0x38383838
put r 7 shl q 16
qm_emit ins meta r 0
end
for c ulong get sp 1 bound 16
for q ulong 4
qm_r0 r 1
put r 1 get meta add 392 c
put r 7 shl q 16
qm_emit ins meta r 0
end
end
qm_op1 ins meta 2 get meta 389 get sp 0 0
end

fn qm_peak_store sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
tv = qm_v meta 1
qm_imadi ins meta tv get meta 387 get sp 3 get meta 386
qm_imadw ins meta get meta 385 tv mul 16 get sp 1 get meta 385
for c ulong get sp 1 bound 16
for q ulong 4
qm_r0 r 12
put r 2 get meta 385
put r 3 get meta add 392 c
put r 5 get meta 384
put r 6 add mul c 16 mul 4 q
put r 7 shl q 32
qm_emit ins meta r 5
end
end
qm_tail ins meta
end

export fn cg_qmma_probe sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to ulong
if gt get sp 0 1
ret 1
end
if gt get sp 1 16
ret 1
end
for i ulong 512
put meta i 0
end
put meta 384 qm_uv meta 2
put meta 385 qm_v meta 2
put meta 386 qm_v meta 2
put meta 387 qm_v meta 1
put meta 388 qm_v meta 1
put meta 389 qm_v meta 2
put meta 390 qm_v meta 2
put meta 391 qm_v meta 2
put meta 392 qm_v meta 2
put meta 393 qm_v meta 4
put meta 394 qm_v meta 2
put meta 395 qm_v meta 4
put meta 396 qm_v meta 4
qm_probe_body sp ins meta
if ne get meta 5 0
ret 1
end
ret 0
end

export fn cg_qmma_peak sp view ulong 8 ins edit ulong 8192 meta edit ulong 512 to ulong
if eq get sp 0 0
ret 1
end
if eq get sp 1 0
ret 1
end
if gt get sp 1 16
ret 1
end
if eq get sp 2 0
ret 1
end
if gt get sp 2 15
ret 1
end
if eq get sp 3 0
ret 1
end
if ne rem get sp 3 32 0
ret 1
end
if gt get sp 3 1024
ret 1
end
for i ulong 512
put meta i 0
end
put meta 384 qm_uv meta 2
put meta 385 qm_v meta 2
put meta 386 qm_v meta 1
put meta 387 qm_v meta 1
put meta 388 qm_v meta 1
put meta 389 qm_v meta 1
put meta 390 qm_v meta 4
put meta 391 qm_v meta 2
for c ulong get sp 1 bound 16
put meta add 392 c qm_v meta 4
end
qm_peak_init sp ins meta
r = new ulong 8 0
lp = get meta 0
put meta 13 get sp 2
for c ulong get sp 1 bound 16
ac = get meta add 392 c
qm_qmma ins meta ac get meta 390 get meta 391 ac
end
qm_imadi ins meta get meta 389 get meta 388 0xffffffff get meta 389
qm_r0 r 28
put r 2 get meta 389
put r 3 get meta 388
qm_emit ins meta r 1
qm_r0 r 46
put r 6 sub lp get meta 0
put r 7 2
qm_emit ins meta r 7
qm_loop_end meta lp
for i ulong 4
qm_nop ins meta 15
end
qm_peak_store sp ins meta
if ne get meta 5 0
ret 1
end
ret 0
end

export fn cg_f2e4_probe ins edit ulong 8192 meta edit ulong 512 to ulong
for i ulong 512
put meta i 0
end
r = new ulong 8 0
put meta 384 qm_uv meta 2
put meta 385 qm_v meta 2
put meta 386 qm_v meta 2
put meta 387 qm_v meta 1
put meta 388 qm_v meta 1
put meta 389 qm_v meta 1
put meta 390 qm_v meta 2
put meta 391 qm_v meta 1
qm_op1 ins meta 7 get meta 384 0x358 4
qm_op1 ins meta 5 get meta 385 0x380 2
qm_op1 ins meta 5 get meta 386 0x388 2
qm_op1 ins meta 3 get meta 387 0x21 2
qm_op1 ins meta 3 get meta 388 0x25 2
qm_imadi ins meta get meta 389 get meta 388 128 get meta 387
qm_imadw ins meta get meta 385 get meta 389 8 get meta 385
qm_imadw ins meta get meta 386 get meta 389 4 get meta 386
put meta 12 2
qm_ldg ins meta 56 get meta 390 get meta 385 0
qm_r0 r 37
put r 1 get meta 391
put r 2 get meta 390
put r 3 get meta 390
put r 6 QM_MARK_F2E4
put r 7 shl ulong 1 32
qm_emit ins meta r 0
qm_r0 r 12
put r 2 get meta 386
put r 3 get meta 391
put r 5 get meta 384
qm_emit ins meta r 5
qm_tail ins meta
if ne get meta 5 0
ret 1
end
ret 0
end

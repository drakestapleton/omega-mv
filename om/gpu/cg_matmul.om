note om/gpu/cg_matmul.om: Pure OM-2 Blackwell IR emitters for tensor and fragment matmul kernels.
note Replaces omega_blackwell_codegen_matmul_{tensor,tensor_loop,frag,frag_block}_prog
note and omega_matmul_frag_{block_shape,block_unr,unr} in src/omega_blackwell_codegen.c.
om2

const MM_NOREG ulong 0xffffffffffffffff
const MM_MAX_M ulong 8192

const OP_NOP ulong 0
const OP_MOV_RZ ulong 1
const OP_MOV_IMM ulong 2
const OP_S2R ulong 3
const OP_LDC64 ulong 5
const OP_LDCU64 ulong 7
const OP_IMAD ulong 8
const OP_IMAD_WIDE ulong 9
const OP_ISETP_GE ulong 10
const OP_LDG_E ulong 11
const OP_STG_E ulong 12
const OP_IADD3 ulong 14
const OP_HMMA_F16 ulong 15
const OP_HMMA_BF16 ulong 16
const OP_SHF_R ulong 17
const OP_LOP3_AND ulong 18
const OP_LDG_E_U16 ulong 19
const OP_EXIT ulong 45
const OP_BRA ulong 46
const OP_LDG_E_64 ulong 56
const OP_LDG_E_128 ulong 57

const SR_TID_X ulong 0x21
const SR_TID_Y ulong 0x22
const SR_CTAID_X ulong 0x25
const SR_CTAID_Y ulong 0x26

const CTRL_LDA ulong 0x001ea800
const CTRL_LDB ulong 0x002ea800
const CTRL_PACK ulong 0x004fca00
const CTRL_HMMA ulong 0x002fca00
const CTRL_STG_DEF ulong 0x000fe200
const CTRL_STG_RDBAR3 ulong 0x0007e200
const CTRL_IMADW_WAIT3 ulong 0x009fcc00
const CTRL_MOVRZ_WAIT3 ulong 0x008fe200
const CTRL_FRAG_LDG_A ulong 0x000ea800
const CTRL_FRAG_LDG_B ulong 0x000f2800
const CTRL_FRAG_HMMA ulong 0x014fde00
const CTRL_FRAG_NOP ulong 0x000fdc00

fn mm_v meta edit ulong 512 w ulong to ulong
v = get meta 1
if ge v 256
  put meta 5 1
  ret 0
end
put meta add 64 v w
put meta 1 add v 1
ret v
end

fn mm_uv meta edit ulong 512 w ulong to ulong
u = get meta 2
if ge u 32
  put meta 5 1
  ret 0
end
put meta add 352 u w
put meta 2 add u 1
ret u
end

fn mm_push ins edit ulong 8192 meta edit ulong 512 r view ulong 8 to void
n = get meta 0
if ge n 1024
  put meta 5 1
  ret
end
b = mul n 8
for k ulong 8
  put ins add b k get r k
end
put meta 0 add n 1
end

fn mm_zero r edit ulong 8 op ulong to void
put r 0 op
for k ulong 7
  put r add k 1 0
end
end

fn mm_imad ins edit ulong 8192 meta edit ulong 512 dst ulong s1 ulong imm ulong to void
r = new ulong 8 0
mm_zero r OP_IMAD
put r 1 dst
put r 2 s1
put r 3 MM_NOREG
put r 4 MM_NOREG
put r 6 and imm 0xffffffff
mm_push ins meta r
end

fn mm_imad3 ins edit ulong 8192 meta edit ulong 512 dst ulong s1 ulong imm ulong to void
r = new ulong 8 0
mm_zero r OP_IMAD
put r 1 dst
put r 2 s1
put r 3 MM_NOREG
put r 4 get meta 16
put r 6 or and imm 0xffffffff shl get meta 17 32
put r 7 shl get meta 18 16
mm_push ins meta r
end

fn mm_imadw ins edit ulong 8192 meta edit ulong 512 dst ulong s1 ulong imm ulong to void
r = new ulong 8 0
mm_zero r OP_IMAD_WIDE
put r 1 dst
put r 2 s1
put r 3 MM_NOREG
put r 4 get meta 16
put r 6 or and imm 0xffffffff shl get meta 17 32
mm_push ins meta r
end

fn mm_ld_base ins edit ulong 8192 meta edit ulong 512 op ulong dst ulong imm ulong to void
r = new ulong 8 0
mm_zero r op
put r 1 dst
put r 6 and imm 0xffffffff
put r 7 get meta 18
mm_push ins meta r
end

fn mm_stg ins edit ulong 8192 meta edit ulong 512 addr ulong rd ulong sub2 ulong to void
r = new ulong 8 0
mm_zero r OP_STG_E
put r 2 addr
put r 3 rd
put r 4 get meta 16
put r 5 get meta 19
put r 6 or and get meta 20 0xffffffff shl get meta 17 32
put r 7 shl sub2 32
mm_push ins meta r
end

fn mm_ldg ins edit ulong 8192 meta edit ulong 512 op ulong dst ulong addr ulong to void
r = new ulong 8 0
mm_zero r op
put r 1 dst
put r 2 addr
put r 3 MM_NOREG
put r 4 MM_NOREG
put r 5 get meta 19
put r 6 or and get meta 20 0xffffffff shl get meta 17 32
put r 7 shl get meta 18 16
mm_push ins meta r
end

fn mm_prologue_hdr ins edit ulong 8192 meta edit ulong 512 to void
put meta 18 1
mm_ld_base ins meta OP_LDCU64 get meta 387 0x358
put meta 18 0
mm_ld_base ins meta OP_LDC64 get meta 384 0x380
mm_ld_base ins meta OP_LDC64 get meta 385 0x388
mm_ld_base ins meta OP_LDC64 get meta 386 0x390
mm_ld_base ins meta OP_S2R get meta 388 SR_TID_X
mm_ld_base ins meta OP_S2R get meta 389 SR_CTAID_X
mm_ld_base ins meta OP_S2R get meta 390 SR_CTAID_Y
end

fn mm_exit_bra ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
mm_zero r OP_EXIT
mm_push ins meta r
mm_zero r OP_BRA
mm_push ins meta r
end

fn mm_bra_back ins edit ulong 8192 meta edit ulong 512 target ulong flags ulong to void
r = new ulong 8 0
mm_zero r OP_BRA
here = get meta 0
delta = and sub target here 0xffffffff
put r 6 delta
put r 7 flags
mm_push ins meta r
end

fn mm_isetp_ge ins edit ulong 8192 meta edit ulong 512 s1 ulong imm ulong to void
r = new ulong 8 0
mm_zero r OP_ISETP_GE
put r 1 MM_NOREG
put r 2 s1
put r 3 MM_NOREG
put r 4 MM_NOREG
put r 6 and imm 0xffffffff
mm_push ins meta r
end

fn mm_mov_rz ins edit ulong 8192 meta edit ulong 512 dst ulong dsub ulong ctrl ulong to void
r = new ulong 8 0
mm_zero r OP_MOV_RZ
put r 1 dst
put r 6 shl ctrl 32
put r 7 shl dsub 16
mm_push ins meta r
end

fn mm_shf_lop ins edit ulong 8192 meta edit ulong 512 tid ulong grp ulong tig ulong to void
r = new ulong 8 0
mm_zero r OP_SHF_R
put r 1 grp
put r 2 tid
put r 6 2
mm_push ins meta r
mm_zero r OP_LOP3_AND
put r 1 tig
put r 2 tid
put r 6 3
mm_push ins meta r
end

fn mm_iadd3 ins edit ulong 8192 meta edit ulong 512 dst ulong s1 ulong s2 ulong to void
r = new ulong 8 0
mm_zero r OP_IADD3
put r 1 dst
put r 2 s1
put r 3 s2
put r 4 MM_NOREG
mm_push ins meta r
end


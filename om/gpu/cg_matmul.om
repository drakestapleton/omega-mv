put meta 16 get meta 401
mm_imadw ins meta get meta 401 v_c1 mul mul gx ks 256
mm_isetp_ge ins meta get meta 398 nt
mm_bra_back ins meta get meta 23 6
put meta 24 sub get meta 0 1
end

fn mf_check sp view ulong 12 to ulong
if eq get sp 0 0
  ret 1
end
if eq get sp 1 0
  ret 1
end
if eq get sp 2 0
  ret 1
end
if ne get sp 3 1
  if ne get sp 3 2
    ret 1
  end
end
if ne rem get sp 0 16 0
  ret 1
end
if ne rem get sp 2 8 0
  ret 1
end
if ne rem get sp 1 16 0
  ret 1
end
unr = get sp 5
if ne unr 1
  if ne unr 2
    if ne unr 4
      if ne unr 8
        ret 1
      end
    end
  end
end
nt = div get sp 2 8
ks = div get sp 1 16
if ne rem ks unr 0
  ret 1
end
if eq get sp 4 0
  ret 1
end
if gt get sp 4 nt
  ret 1
end
if ne get sp 6 0
  if lt div ks unr 2
    ret 1
  end
end
if gt mul mul nt ks 32 0xffffffff
  ret 1
end
if gt mul mul 512 ks 32 0xffffffff
  ret 1
end
if gt mul mul get sp 4 ks 256 0xffffffff
  ret 1
end
if gt mul get sp 2 32 0xffffffff
  ret 1
end
if gt mul MM_MAX_M get sp 2 0xffffffff
  ret 1
end
ret 0
end

export fn cg_matmul_frag sp view ulong 12 ins edit ulong 8192 meta edit ulong 512 to ulong
if ne mf_check sp 0
  ret 1
end
n = get sp 2
prec = get sp 3
gx = get sp 4
unr = get sp 5
mut = get sp 6
nt = div n 8
ks = div get sp 1 16
iters = div ks unr
mf_alloc meta unr
mf_prologue ins meta ks n
put meta 23 get meta 0
mm_mov_rz ins meta get meta 408 0 CTRL_MOVRZ_WAIT3
mm_mov_rz ins meta get meta 408 1 0
mm_mov_rz ins meta get meta 408 2 0
mm_mov_rz ins meta get meta 408 3 0
put meta 17 0
put meta 16 get meta 400
mm_imadw ins meta get meta 404 get meta 396 0
put meta 16 get meta 401
mm_imadw ins meta get meta 405 get meta 396 0
cnt_init = iters
if ne mut 0
  cnt_init = sub iters 1
end
put meta 18 0
mm_ld_base ins meta OP_MOV_IMM get meta 399 cnt_init
mf_kloop ins meta unr prec
mf_store_adv ins meta gx ks nt
mm_exit_bra ins meta
put meta 480 get meta 23
put meta 481 get meta 21
put meta 482 get meta 22
put meta 483 get meta 24
put meta 484 get meta 396
put meta 485 get meta 398
put meta 486 get meta 400
put meta 487 get meta 401
put meta 488 get meta 402
put meta 489 get meta 403
put meta 490 get meta 408
put meta 491 get meta 404
put meta 492 get meta 405
put meta 493 get meta 399
ret get meta 5
end


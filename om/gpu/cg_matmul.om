export fn cg_matmul_frag_shape mt ulong nt ulong kp ulong res edit ulong 4 to ulong
r = ulong 1
if eq rem mt 4 0
  r = ulong 4
else
  if eq rem mt 2 0
    r = ulong 2
  end
end
c = ulong 1
while gt r 1 bound 4
  if eq rem nt 4 0
    c = ulong 4
  else
    if eq rem nt 2 0
      c = ulong 2
    else
      c = ulong 1
    end
  end
  if ne mb_store_fits r c mul nt 8 0
    break
  end
  r = div r 2
end
if le r 1
  c = ulong 1
end
ks = div kp 16
bu = ulong 1
if eq rem ks 2 0
  if le mul 2 add r c 8
    bu = ulong 2
  end
end
fu = ulong 1
if eq rem ks 4 0
  fu = ulong 4
else
  if eq rem ks 2 0
    fu = ulong 2
  end
end
put res 0 r
put res 1 c
put res 2 bu
put res 3 fu
ret 0
end


fn ml_prologue ins edit ulong 8192 meta edit ulong 512 k ulong n ulong to void
mm_prologue_hdr ins meta
put meta 18 0
mm_ld_base ins meta OP_MOV_IMM get meta 396 1
mm_shf_lop ins meta get meta 388 get meta 391 get meta 392
mm_imad ins meta get meta 393 get meta 392 2
put meta 16 get meta 391
put meta 17 0
mm_imad3 ins meta get meta 394 get meta 390 16
put meta 16 get meta 394
mm_imad3 ins meta get meta 395 get meta 396 8
put meta 16 get meta 393
mm_imad3 ins meta get meta 397 get meta 394 k
put meta 16 get meta 384
mm_imadw ins meta get meta 400 get meta 397 2
put meta 16 get meta 393
mm_imad3 ins meta get meta 397 get meta 395 k
put meta 16 get meta 384
mm_imadw ins meta get meta 401 get meta 397 2
mm_imad ins meta get meta 398 get meta 389 1
put meta 16 get meta 391
mm_imad3 ins meta get meta 397 get meta 393 n
put meta 16 get meta 397
mm_imad3 ins meta get meta 397 get meta 398 8
put meta 16 get meta 385
mm_imadw ins meta get meta 402 get meta 397 2
put meta 16 get meta 393
mm_imad3 ins meta get meta 397 get meta 394 n
put meta 16 get meta 397
mm_imad3 ins meta get meta 397 get meta 398 8
put meta 16 get meta 386
mm_imadw ins meta get meta 403 get meta 397 4
put meta 16 get meta 393
mm_imad3 ins meta get meta 397 get meta 395 n
put meta 16 get meta 397
mm_imad3 ins meta get meta 397 get meta 398 8
put meta 16 get meta 386
mm_imadw ins meta get meta 404 get meta 397 4
end

fn ml_kloop ins edit ulong 8192 meta edit ulong 512 n ulong prec ulong to void
put meta 21 get meta 0
v_c1 = get meta 396
put meta 17 0
put meta 16 get meta 405
mm_imadw ins meta get meta 408 v_c1 16
put meta 16 get meta 406
mm_imadw ins meta get meta 409 v_c1 16
put meta 16 get meta 407
mm_imadw ins meta get meta 410 v_c1 mul 2 n
put meta 16 get meta 407
mm_imadw ins meta get meta 411 v_c1 mul 16 n
put meta 16 get meta 407
mm_imadw ins meta get meta 412 v_c1 mul 18 n
put meta 17 CTRL_LDA
put meta 19 get meta 387
put meta 20 0
put meta 18 0
mm_ldg ins meta OP_LDG_E get meta 415 get meta 405
put meta 18 1
mm_ldg ins meta OP_LDG_E get meta 415 get meta 406
put meta 18 2
mm_ldg ins meta OP_LDG_E get meta 415 get meta 408
put meta 18 3
mm_ldg ins meta OP_LDG_E get meta 415 get meta 409
put meta 17 CTRL_LDB
put meta 18 0
mm_ldg ins meta OP_LDG_E_U16 get meta 418 get meta 407
mm_ldg ins meta OP_LDG_E_U16 get meta 419 get meta 410
put meta 16 get meta 418
put meta 17 CTRL_PACK
put meta 18 0
mm_imad3 ins meta get meta 416 get meta 419 0x10000
put meta 17 CTRL_LDB
put meta 18 0
mm_ldg ins meta OP_LDG_E_U16 get meta 418 get meta 411
mm_ldg ins meta OP_LDG_E_U16 get meta 419 get meta 412
put meta 16 get meta 418
put meta 17 CTRL_PACK
put meta 18 1
mm_imad3 ins meta get meta 416 get meta 419 0x10000
r = new ulong 8 0
mma_op = OP_HMMA_F16
if eq prec 2
  mma_op = OP_HMMA_BF16
end
mm_zero r mma_op
put r 1 get meta 417
put r 2 get meta 415
put r 3 get meta 416
put r 4 get meta 417
put r 6 shl CTRL_HMMA 32
mm_push ins meta r
put meta 17 0
put meta 18 0
put meta 16 get meta 405
mm_imadw ins meta get meta 405 v_c1 32
put meta 16 get meta 406
mm_imadw ins meta get meta 406 v_c1 32
put meta 16 get meta 407
mm_imadw ins meta get meta 407 v_c1 mul 32 n
put meta 16 get meta 399
mm_imad3 ins meta get meta 399 v_c1 0xffffffff
mm_isetp_ge ins meta get meta 399 1
mm_bra_back ins meta get meta 21 2
put meta 22 sub get meta 0 1
end

fn ml_store_adv ins edit ulong 8192 meta edit ulong 512 gx ulong nt ulong to void
v_c1 = get meta 396
put meta 17 0
put meta 16 get meta 403
mm_imadw ins meta get meta 413 v_c1 4
put meta 16 get meta 404
mm_imadw ins meta get meta 414 v_c1 4
put meta 16 MM_NOREG
put meta 17 CTRL_STG_RDBAR3
put meta 19 get meta 387
put meta 20 0
mm_stg ins meta get meta 403 get meta 417 0
mm_stg ins meta get meta 413 get meta 417 1
mm_stg ins meta get meta 404 get meta 417 2
mm_stg ins meta get meta 414 get meta 417 3
put meta 16 get meta 398
put meta 17 0
put meta 18 0
mm_imad3 ins meta get meta 398 v_c1 gx
put meta 16 get meta 403
put meta 17 CTRL_IMADW_WAIT3
mm_imadw ins meta get meta 403 v_c1 mul gx 32
put meta 16 get meta 404
put meta 17 0
mm_imadw ins meta get meta 404 v_c1 mul gx 32
put meta 16 get meta 402
mm_imadw ins meta get meta 402 v_c1 mul gx 16
mm_isetp_ge ins meta get meta 398 nt
mm_bra_back ins meta get meta 23 6
put meta 24 sub get meta 0 1
end

export fn cg_matmul_tensor_loop sp view ulong 12 ins edit ulong 8192 meta edit ulong 512 to ulong
m = get sp 0
k = get sp 1
n = get sp 2
prec = get sp 3
gx = get sp 4
mut = get sp 5
if eq m 0
  ret 1
end
if eq k 0
  ret 1
end
if eq n 0
  ret 1
end
if ne prec 1
  if ne prec 2
    ret 1
  end
end
if ne rem m 16 0
  ret 1
end
if ne rem n 8 0
  ret 1
end
if ne rem k 16 0
  ret 1
end
nt = div n 8
ksteps = div k 16
if eq gx 0
  ret 1
end
if gt gx nt
  ret 1
end
if gt mul n 32 0xffffffff
  ret 1
end
if gt mul gx 32 0xffffffff
  ret 1
end
if ne mut 0
  if lt ksteps 2
    ret 1
  end
end
ml_alloc meta
ml_prologue ins meta k n
put meta 23 get meta 0
mm_mov_rz ins meta get meta 417 0 CTRL_MOVRZ_WAIT3
mm_mov_rz ins meta get meta 417 1 0
mm_mov_rz ins meta get meta 417 2 0
mm_mov_rz ins meta get meta 417 3 0
put meta 17 0
put meta 16 get meta 400
mm_imadw ins meta get meta 405 get meta 396 0
put meta 16 get meta 401
mm_imadw ins meta get meta 406 get meta 396 0
put meta 16 get meta 402
mm_imadw ins meta get meta 407 get meta 396 0
cnt_init = ksteps
if ne mut 0
  cnt_init = sub ksteps 1
end
put meta 18 0
mm_ld_base ins meta OP_MOV_IMM get meta 399 cnt_init
ml_kloop ins meta n prec
ml_store_adv ins meta gx nt
mm_exit_bra ins meta
put meta 480 get meta 23
put meta 481 get meta 21
put meta 482 get meta 22
put meta 483 get meta 24
put meta 484 get meta 417
ret get meta 5
end


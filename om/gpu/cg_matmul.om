fn mf_kloop ins edit ulong 8192 meta edit ulong 512 unr ulong prec ulong to void
put meta 21 get meta 0
put meta 18 0
put meta 19 get meta 387
for u ulong unr bound 8
  put meta 17 CTRL_FRAG_LDG_A
  put meta 20 mul u 512
  mm_ldg ins meta OP_LDG_E_128 get meta add 410 u get meta 404
  put meta 17 CTRL_FRAG_LDG_B
  put meta 20 mul u 256
  mm_ldg ins meta OP_LDG_E_64 get meta add 418 u get meta 405
end
mma_op = OP_HMMA_F16
if eq prec 2
  mma_op = OP_HMMA_BF16
end
r = new ulong 8 0
for u ulong unr bound 8
  mm_zero r mma_op
  put r 1 get meta 408
  put r 2 get meta add 410 u
  put r 3 get meta add 418 u
  put r 4 get meta 408
  put r 6 shl CTRL_FRAG_HMMA 32
  mm_push ins meta r
  mm_zero r OP_NOP
  put r 1 MM_NOREG
  put r 2 MM_NOREG
  put r 3 MM_NOREG
  put r 4 MM_NOREG
  put r 5 MM_NOREG
  put r 6 shl CTRL_FRAG_NOP 32
  mm_push ins meta r
end
v_c1 = get meta 396
put meta 17 0
put meta 18 0
put meta 16 get meta 404
mm_imadw ins meta get meta 404 v_c1 mul unr 512
put meta 16 get meta 405
mm_imadw ins meta get meta 405 v_c1 mul unr 256
put meta 16 get meta 399
mm_imad3 ins meta get meta 399 v_c1 0xffffffff
mm_isetp_ge ins meta get meta 399 1
mm_bra_back ins meta get meta 21 2
put meta 22 sub get meta 0 1
end

fn mf_store_adv ins edit ulong 8192 meta edit ulong 512 gx ulong ks ulong nt ulong to void
v_c1 = get meta 396
put meta 17 0
put meta 16 get meta 402
mm_imadw ins meta get meta 406 v_c1 4
put meta 16 get meta 403
mm_imadw ins meta get meta 407 v_c1 4
put meta 16 MM_NOREG
put meta 17 CTRL_STG_RDBAR3
put meta 19 get meta 387
put meta 20 0
mm_stg ins meta get meta 402 get meta 408 0
mm_stg ins meta get meta 406 get meta 408 1
mm_stg ins meta get meta 403 get meta 408 2
mm_stg ins meta get meta 407 get meta 408 3
put meta 16 get meta 398
put meta 17 0
put meta 18 0

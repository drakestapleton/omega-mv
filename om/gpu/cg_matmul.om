fn mb_zero_accs ins edit ulong 8192 meta edit ulong 512 ntiles ulong to void
for t ulong ntiles bound 16
  rd = get meta add 408 t
  for s ulong 4
    ctrl = ulong 0
    if eq t 0
      if eq s 0
        ctrl = CTRL_MOVRZ_WAIT3
      end
    end
    mm_mov_rz ins meta rd s ctrl
  end
end
end

fn mb_kloop_loads_u ins edit ulong 8192 meta edit ulong 512 sp view ulong 12 u ulong to void
ks = div get sp 1 16
put meta 17 CTRL_FRAG_LDG_A
for i ulong get sp 6 bound 8
  put meta 20 add mul u 512 mul mul i ks 512
  mm_ldg ins meta OP_LDG_E_128 get meta add add 424 mul u 8 i get meta 404
end
put meta 17 CTRL_FRAG_LDG_B
for j ulong get sp 7 bound 4
  put meta 20 add mul u 256 mul mul j ks 256
  mm_ldg ins meta OP_LDG_E_64 get meta add add 440 mul u 4 j get meta 405
end
end

fn mb_kloop_loads ins edit ulong 8192 meta edit ulong 512 sp view ulong 12 to void
put meta 18 0
put meta 19 get meta 387
for u ulong get sp 5 bound 2
  mb_kloop_loads_u ins meta sp u
end
end

fn mb_kloop_hmma_one ins edit ulong 8192 meta edit ulong 512 rd ulong to void
r = new ulong 8 0
mm_zero r get meta 28
put r 1 rd
put r 2 get meta 29
put r 3 get meta 25
put r 4 rd
put r 6 shl CTRL_FRAG_HMMA 32
mm_push ins meta r
mm_zero r OP_NOP
put r 1 MM_NOREG
put r 2 MM_NOREG
put r 3 MM_NOREG
put r 4 MM_NOREG
put r 5 MM_NOREG
put r 6 shl CTRL_FRAG_NOP 32
mm_push ins meta r
end

fn mb_kloop_hmmas_ui ins edit ulong 8192 meta edit ulong 512 sp view ulong 12 to void
put meta 28 OP_HMMA_F16
if eq get sp 3 2
  put meta 28 OP_HMMA_BF16
end
put meta 29 get meta add add 424 mul get meta 26 8 get meta 27
for j ulong get sp 7 bound 4
  idx = add 440 add mul get meta 26 4 j
  put meta 25 get meta idx
  rd = get meta add 408 add mul get meta 27 get sp 7 j
  mb_kloop_hmma_one ins meta rd
end
end

fn mb_kloop_hmmas ins edit ulong 8192 meta edit ulong 512 sp view ulong 12 to void
for u ulong get sp 5 bound 2
  put meta 26 u
  for i ulong get sp 6 bound 8
    put meta 27 i
    mb_kloop_hmmas_ui ins meta sp
  end
end
end

fn mb_stores_row ins edit ulong 8192 meta edit ulong 512 sp view ulong 12 i ulong to void
ct = get sp 7
base = mul mul mul i 16 get sp 2 4
for j ulong ct bound 4
  rd = get meta add 408 add mul i ct j
  off = add base mul j 32
  put meta 20 off
  mm_stg ins meta get meta 402 rd 0
  put meta 20 add off 4
  mm_stg ins meta get meta 402 rd 1
  put meta 20 off
  mm_stg ins meta get meta 403 rd 2
  put meta 20 add off 4
  mm_stg ins meta get meta 403 rd 3
end
end

fn mb_stores ins edit ulong 8192 meta edit ulong 512 sp view ulong 12 to void
put meta 16 MM_NOREG
put meta 17 CTRL_STG_RDBAR3
put meta 19 get meta 387
for i ulong get sp 6 bound 8
  mb_stores_row ins meta sp i
end
end

export fn cg_matmul_frag_block sp view ulong 12 ins edit ulong 8192 meta edit ulong 512 to ulong

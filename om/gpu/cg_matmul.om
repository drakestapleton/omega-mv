fn mt_alloc meta edit ulong 512 to void
put meta 384 mm_v meta 2
put meta 385 mm_v meta 2
put meta 386 mm_v meta 2
put meta 387 mm_uv meta 2
put meta 388 mm_v meta 1
put meta 389 mm_v meta 1
put meta 390 mm_v meta 1
put meta 391 mm_v meta 1
put meta 392 mm_v meta 1
put meta 393 mm_v meta 1
put meta 394 mm_v meta 1
put meta 395 mm_v meta 1
put meta 396 mm_v meta 1
put meta 397 mm_v meta 1
put meta 398 mm_v meta 1
put meta 399 mm_v meta 1
put meta 400 mm_v meta 4
put meta 401 mm_v meta 2
put meta 402 mm_v meta 4
put meta 403 mm_v meta 1
put meta 404 mm_v meta 2
put meta 405 mm_v meta 1
put meta 406 mm_v meta 1
end

fn mt_load_a ins edit ulong 8192 meta edit ulong 512 row_v ulong dsub ulong add16 ulong to void
v_idx = get meta 403
v_off = get meta 404
mm_imad ins meta v_idx row_v 32
put meta 16 v_idx
put meta 17 0
put meta 18 0
mm_imad3 ins meta v_idx get meta 398 2
if ne add16 0
  put meta 16 v_idx
  mm_imad3 ins meta v_idx get meta 399 16
end
put meta 16 get meta 384
put meta 17 0
mm_imadw ins meta v_off v_idx 1
put meta 17 CTRL_LDA
put meta 18 dsub
put meta 19 get meta 387
put meta 20 0
mm_ldg ins meta OP_LDG_E get meta 400 v_off
end

fn mt_load_b_pair ins edit ulong 8192 meta edit ulong 512 nval ulong dsub ulong add8n ulong to void
v_idx = get meta 403
v_off = get meta 404
put meta 16 get meta 397
put meta 17 0
put meta 18 0
mm_imad3 ins meta v_idx get meta 398 nval
if ne add8n 0
  put meta 16 v_idx
  mm_imad3 ins meta v_idx get meta 399 mul 8 nval
end
put meta 16 get meta 385
mm_imadw ins meta v_off v_idx 2
put meta 17 CTRL_LDB
put meta 18 0
put meta 19 get meta 387
put meta 20 0
mm_ldg ins meta OP_LDG_E_U16 get meta 405 v_off
put meta 16 v_idx
put meta 17 0
mm_imad3 ins meta v_idx get meta 399 nval
put meta 16 get meta 385
mm_imadw ins meta v_off v_idx 2
put meta 17 CTRL_LDB
mm_ldg ins meta OP_LDG_E_U16 get meta 406 v_off
put meta 16 get meta 405
put meta 17 CTRL_PACK
put meta 18 dsub
mm_imad3 ins meta get meta 401 get meta 406 0x10000
end

fn mt_store_c_pair ins edit ulong 8192 meta edit ulong 512 row_v ulong nval ulong s0 ulong to void
v_idx = get meta 403
v_off = get meta 404
put meta 16 get meta 394
put meta 17 0
put meta 18 0
mm_imad3 ins meta v_idx row_v nval
mm_iadd3 ins meta v_idx v_idx get meta 398
put meta 16 get meta 386
mm_imadw ins meta v_off v_idx 4
put meta 16 0
put meta 17 CTRL_STG_DEF
put meta 19 get meta 387
put meta 20 0
mm_stg ins meta v_off get meta 402 s0
put meta 16 v_idx
put meta 17 0
mm_imad3 ins meta v_idx get meta 399 1
put meta 16 get meta 386
mm_imadw ins meta v_off v_idx 4
put meta 16 0
put meta 17 CTRL_STG_DEF
mm_stg ins meta v_off get meta 402 add s0 1
end

export fn cg_matmul_tensor sp view ulong 12 ins edit ulong 8192 meta edit ulong 512 to ulong
m = get sp 0
k = get sp 1
n = get sp 2
prec = get sp 3
if eq m 0
  ret 1
end
if ne k 16
  ret 1
end
if eq n 0
  ret 1
end
if ne rem m 16 0
  ret 1
end
if ne rem n 8 0
  ret 1
end
if ne prec 1
  if ne prec 2
    ret 1
  end
end
mt_alloc meta
mm_prologue_hdr ins meta
put meta 18 0
mm_ld_base ins meta OP_MOV_IMM get meta 399 1
mm_shf_lop ins meta get meta 388 get meta 391 get meta 392
mm_imad ins meta get meta 393 get meta 390 16
mm_imad ins meta get meta 394 get meta 389 8
mm_iadd3 ins meta get meta 395 get meta 393 get meta 391
put meta 16 get meta 395
put meta 17 0
put meta 18 0
mm_imad3 ins meta get meta 396 get meta 399 8
mm_iadd3 ins meta get meta 397 get meta 394 get meta 391
mm_imad ins meta get meta 398 get meta 392 2

mt_load_a ins meta get meta 395 0 0
mt_load_a ins meta get meta 396 1 0
mt_load_a ins meta get meta 395 2 1
mt_load_a ins meta get meta 396 3 1

mt_load_b_pair ins meta n 0 0
mt_load_b_pair ins meta n 1 1

r = new ulong 8 0
mma_op = OP_HMMA_F16
if eq prec 2
  mma_op = OP_HMMA_BF16
end
mm_zero r mma_op
put r 1 get meta 402
put r 2 get meta 400
put r 3 get meta 401
put r 4 MM_NOREG
put r 6 shl CTRL_HMMA 32
mm_push ins meta r

mt_store_c_pair ins meta get meta 395 n 0
mt_store_c_pair ins meta get meta 396 n 2
mm_exit_bra ins meta
ret get meta 5
end


fn mb_store_fits rt ulong ct ulong n ulong to ulong
off = add add mul mul mul sub rt 1 16 n 4 mul sub ct 1 32 4
if lt off 0x800000
  ret 1
end
ret 0
end

fn mb_check sp view ulong 12 to ulong
if eq get sp 0 0
  ret 1
end
if eq get sp 1 0
  ret 1
end
if eq get sp 2 0
  ret 1
end
if ne get sp 3 1
  if ne get sp 3 2
    ret 1
  end
end
if ne rem get sp 0 16 0
  ret 1
end
if ne rem get sp 2 8 0
  ret 1
end
if ne rem get sp 1 16 0
  ret 1
end
rt = get sp 6
ct = get sp 7
if ne rt 1
  if ne rt 2
    if ne rt 4
      if ne rt 8
        ret 1
      end
    end
  end
end
if ne ct 1
  if ne ct 2
    if ne ct 4
      ret 1
    end
  end
end
if gt mul rt ct 16
  ret 1
end
if lt mul rt ct 2
  ret 1
end
unr = get sp 5
if ne unr 1
  if ne unr 2
    ret 1
  end
end
if gt mul unr add rt ct 8
  ret 1
end
nt = div get sp 2 8
ks = div get sp 1 16
if ne rem ks unr 0
  ret 1
end
if ne rem nt ct 0
  ret 1
end
if eq get sp 4 0
  ret 1
end
if gt get sp 4 div nt ct
  ret 1
end
if ne get sp 8 0
  if lt div ks unr 2
    ret 1
  end
end
if gt mul mul nt ks 32 0xffffffff
  ret 1
end
if gt mul mul 512 ks 32 0xffffffff
  ret 1
end
if gt mul mul mul get sp 4 ct ks 256 0xffffffff
  ret 1
end
if gt mul get sp 2 32 0xffffffff
  ret 1
end
if gt mul MM_MAX_M get sp 2 0xffffffff
  ret 1
end
if ge add mul mul sub rt 1 ks 512 mul sub unr 1 512 0x800000
  ret 1
end
if ge add mul mul sub ct 1 ks 256 mul sub unr 1 256 0x800000
  ret 1
end
if eq mb_store_fits rt ct get sp 2 0
  ret 1
end
ret 0
end

fn mb_alloc meta edit ulong 512 unr ulong rt ulong ct ulong to void
put meta 384 mm_v meta 2
put meta 385 mm_v meta 2
put meta 386 mm_v meta 2
put meta 387 mm_uv meta 2
put meta 388 mm_v meta 1
put meta 389 mm_v meta 1
put meta 390 mm_v meta 1
put meta 391 mm_v meta 1

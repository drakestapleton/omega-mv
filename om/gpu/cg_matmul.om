put meta 401 mm_v meta 2
put meta 402 mm_v meta 2
put meta 403 mm_v meta 2
put meta 404 mm_v meta 2
put meta 405 mm_v meta 2
ntiles = mul rt ct
for t ulong ntiles bound 16
  put meta add 408 t mm_v meta 4
end
for u ulong unr bound 2
  for i ulong rt bound 8
    put meta add add 424 mul u 8 i mm_v meta 4
  end
  for j ulong ct bound 4
    put meta add add 440 mul u 4 j mm_v meta 2
  end
end
end

fn mb_prologue ins edit ulong 8192 meta edit ulong 512 sp view ulong 12 to void

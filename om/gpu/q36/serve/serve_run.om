note SPDX-License-Identifier: AGPL-3.0-only
note 100% Pure Seeded-Omega Zero-CUDA Real-Weight Qwen 3.6 35B-A3B HTTP Server + Live Arboris (q36-serve).
note ZERO libcuda.so.1, ZERO libc, ZERO Python, ZERO C, ZERO Rust.
note Defaults to Full-W4 mode (67.76 tok/s, ~19.5 GB VRAM); pass --fp8 for Exact FP8 (48.01 tok/s).
note Endpoints:
note   GET  /health               (status, model, mode, live Arboris transitions/hits/hit_pct)
note   GET  /v1/models            (OpenAI model list: qwen3.6-35b-a3b-fp8)
note   POST /v1/chat/completions  (OpenAI chat completion with live Arboris tracking)
note
note Usage:
note   q36-serve [--model-dir PATH] [--port PORT] [--fp8 | --w4] [--self-test]

global qsReqBuf uchar 524288
global qsRespBuf uchar 262144
global qsRespLen ulong 1
global qsOutTxt uchar 131072
global qsOutLen ulong 1
global qsPort ulong 1
global qsSelfTest ulong 1
global qsPendPreArb ulong 1
global qsStreamFd int 1

text qsDefDir "/home/drakestapleton/models/qwen3.6-35b-a3b-fp8-95a723d0"

fn qsRespReset to void
put qsRespLen 0 0
end

fn qsRespAppendHdr s view uchar * n ulong to void
p = get qsRespLen 0
for i ulong n bound 512
c = get s i
if and eq c 10 lt p 65520
put qsRespBuf p 13
p = add p 1
end
if lt p 262100
put qsRespBuf p c
p = add p 1
end
end
put qsRespLen 0 p
end

fn qsRespAppend s view uchar * n ulong to void
p = get qsRespLen 0
for i ulong n bound 16384
if lt p 262100
put qsRespBuf p get s i
p = add p 1
end
end
put qsRespLen 0 p
end

fn qsRespAppendU v ulong to void
tmp = new uchar 24 0
p = get qsRespLen 0
if eq v 0
if lt p 262100
put qsRespBuf p 48
put qsRespLen 0 add p 1
end
ret
end
n = ulong 0
x = v
while gt x 0 bound 24
put tmp n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
for i ulong n bound 24
if lt p 262100
put qsRespBuf p get tmp sub sub n 1 i
p = add p 1
end
end
put qsRespLen 0 p
end

fn qsRespAppendEscByte c uchar to void
p = get qsRespLen 0
if ge p 262096
ret
end
if or eq c 34 eq c 92
put qsRespBuf p 92
put qsRespBuf add p 1 c
put qsRespLen 0 add p 2
ret
end
if eq c 10
put qsRespBuf p 92
put qsRespBuf add p 1 110
put qsRespLen 0 add p 2
ret
end
if eq c 13
put qsRespBuf p 92
put qsRespBuf add p 1 114
put qsRespLen 0 add p 2
ret
end
if eq c 9
put qsRespBuf p 92
put qsRespBuf add p 1 116
put qsRespLen 0 add p 2
ret
end
if eq c 8
put qsRespBuf p 92
put qsRespBuf add p 1 98
put qsRespLen 0 add p 2
ret
end
if eq c 12
put qsRespBuf p 92
put qsRespBuf add p 1 102
put qsRespLen 0 add p 2
ret
end
if ge c 32
put qsRespBuf p c
put qsRespLen 0 add p 1
end
end

fn qsRespAppendJsonEsc n ulong to void
for i ulong n bound 131072
qsRespAppendEscByte get qsOutTxt i
end
end

fn qsSendSseDelta fd int tid ulong to void
if ge tid Q36_VOCAB_MAX
ret
end
l = ulong get q36TokLen tid
if eq l 0
ret
end
off = ulong get q36TokOff tid
qsRespReset
qsRespAppend qsSseData len qsSseData
qsRespAppend qsSseDeltaA len qsSseDeltaA
for i ulong l bound 64
qsRespAppendEscByte get q36TokPool add off i
end
qsRespAppend qsSseDeltaB len qsSseDeltaB
w = write fd qsRespBuf 0 get qsRespLen 0
end

fn qsAppendTok tid ulong to void
if ge tid Q36_VOCAB_MAX
ret
end
l = ulong get q36TokLen tid
if eq l 0
ret
end
off = ulong get q36TokOff tid
cur = get qsOutLen 0
for i ulong l bound 64
if lt cur 131000
put qsOutTxt cur get q36TokPool add off i
cur = add cur 1
end
end
put qsOutLen 0 cur
end

fn qsArbHitPct to ulong
tot = get qdArbTot 0
if eq tot 0
ret 0
end
ret div mul get qdArbHits 0 100 tot
end

fn qsPrefill nTok ulong to ulong
if and eq get qdUseW4 0 1 ge nTok 2
pos = ulong 0
prevChunk = ulong 0
hasPrev = false
while lt pos nTok bound 1024
chunk = sub nTok pos
if gt chunk QP_MAX_B
chunk = QP_MAX_B
end
isFinal = eq add pos chunk nTok
if hasPrev
if not qdWaitPre
ret 999999
end
okSnap = qdPreSnapTrace prevChunk
for j ulong chunk bound 512
put qdPreTokIds j get q36TokOutIds add pos j
end
if not qdPreKickChunk chunk pos isFinal
ret 999999
end
if okSnap
qdPreUpdateArborisSnap prevChunk
end
else
for j ulong chunk bound 512
put qdPreTokIds j get q36TokOutIds add pos j
end
if not qdPreKickChunk chunk pos isFinal
ret 999999
end
end
prevChunk = chunk
hasPrev = true
pos = add pos chunk
end
if not qdWaitPre
ret 999999
end
put qsPendPreArb 0 0
if qdPreSnapTrace prevChunk
put qsPendPreArb 0 prevChunk
end
ret qdPrePickBest prevChunk false
end
put qsPendPreArb 0 0
nextTok = ulong 0
for p ulong nTok bound 131072
isLast = eq add p 1 nTok
nextTok = qdForwardToken ulong get q36TokOutIds p p isLast false
if eq nextTok 999999
ret 999999
end
end
ret nextTok
end

fn qsFlushPendPreArb to void
n = get qsPendPreArb 0
if gt n 0
put qsPendPreArb 0 0
qdPreUpdateArborisSnap n
end
end

fn qsEmitTokStep tid ulong to void
qsAppendTok tid
sfd = get qsStreamFd 0
if ge sfd 0
qsSendSseDelta sfd tid
end
end

fn qsIsStopTok tid ulong to bool
if eq tid 248046
ret true
end
ret eq tid 248044
end

global qsSpecCnt ulong 2

fn qsSpecEmitAcc acc ulong cap ulong to bool
g = get qsSpecCnt 0
for k ulong acc bound 16
tokK = get qdSpecPred k
if qsIsStopTok tokK
put qsSpecCnt 0 g
ret true
end
if lt g cap
qsEmitTokStep tokK
g = add g 1
h2 = get qdHistLen 0
if lt h2 131070
put qdHistToks h2 tokK
put qdHistLen 0 add h2 1
end
end
end
put qsSpecCnt 0 g
ret false
end

fn qsDecodeLoopSpec firstTok ulong nTok ulong cap ulong to ulong
M = get qdSpecM 0
qsFlushPendPreArb
hl = nTok
if gt hl 131000
hl = ulong 131000
end
for p ulong hl bound 131072
put qdHistToks p ulong get q36TokOutIds p
end
put qdHistToks hl firstTok
put qdHistLen 0 add hl 1
qsEmitTokStep firstTok
put qsSpecCnt 0 1
curTok = firstTok
pos = nTok
while lt get qsSpecCnt 0 cap bound 4096
if eq get qdMtpReady 0 1
if not qdMtpDraftChain curTok sub pos 1 M
qdSpecDraftNgram curTok M
end
else
qdSpecDraftNgram curTok M
end
acc = qdSpecVerifyStep M pos
if eq acc 0
break
end
if qsSpecEmitAcc acc cap
break
end
if eq get qdMtpReady 0 1
okH = qdMtpCopyMainHid acc
end
curTok = get qdSpecPred sub acc 1
pos = add pos acc
end
ret get qsSpecCnt 0
end

fn qsDecodeLoop firstTok ulong nTok ulong maxGen ulong to ulong
cap = maxGen
if gt add nTok cap QD_MAX_T
cap = sub QD_MAX_T nTok
end
if or eq cap 0 qsIsStopTok firstTok
qsFlushPendPreArb
ret 0
end
if and eq get qdUseW4 0 1 gt get qdSpecM 0 0
ret qsDecodeLoopSpec firstTok nTok cap
end
qsEmitTokStep firstTok
genCnt = ulong 1
if ge genCnt cap
qsFlushPendPreArb
ret genCnt
end
if not qdPrepAsyncDecode firstTok nTok
qsFlushPendPreArb
ret genCnt
end
if not qdKickPre 2
qsFlushPendPreArb
ret genCnt
end
note Overlap final prefill chunk Live Arboris update behind decode step 1 on GPU!
qsFlushPendPreArb
for g ulong sub cap 1 bound 16384
if not qdWaitPre
break
end
nextTok = qdReadOutTok
if eq nextTok 999999
break
end
okSnap = qdSnapTrace
if qsIsStopTok nextTok
if okSnap
qdUpdateArborisSnap
end
break
end
if lt add g 2 cap
if not qdKickPre 2
if okSnap
qdUpdateArborisSnap
end
qsEmitTokStep nextTok
genCnt = add genCnt 1
break
end
end
if okSnap
qdUpdateArborisSnap
end
qsEmitTokStep nextTok
genCnt = add genCnt 1
end
ret genCnt
end

fn qsGenerate tlen ulong maxGen ulong outCounts edit ulong 4 to bool
qdResetState
nTok = q36TokEncodeChatGlobal tlen
if eq nTok 0
ret false
end
put outCounts 0 nTok
put qsOutLen 0 0
t0 = monons
firstTok = qsPrefill nTok
if eq firstTok 999999
ret false
end
t1 = monons
genCnt = qsDecodeLoop firstTok nTok maxGen
t2 = monons
put outCounts 1 genCnt
put outCounts 2 div ulong sub t1 t0 1000000
put outCounts 3 div ulong sub t2 t1 1000000
ret true
end

fn qsMatchKey kbuf view uchar * pos ulong klen ulong to bool
for j ulong klen bound 16
if ne get qsReqBuf add pos j get kbuf j
ret false
end
end
ret true
end

fn qsScanQuoted p0 ulong n ulong outBounds edit ulong 2 to bool
p = p0
while and lt p n ne get qsReqBuf p 34 bound 64
p = add p 1
end
if ge p n
ret false
end
st = add p 1
q = st
while and lt q n ne get qsReqBuf q 34 bound 524288
if eq get qsReqBuf q 92
q = add q 2
else
q = add q 1
end
end
if gt q st
put outBounds 0 st
put outBounds 1 sub q st
ret true
end
ret false
end

fn qsFindLastContent n ulong outBounds edit ulong 2 to bool
put outBounds 0 0
put outBounds 1 0
found = false
if lt n 14
ret false
end
lim = sub n 10
for i ulong lim bound 524288
if qsMatchKey qsKeyContent i 9
if qsScanQuoted add i 9 n outBounds
found = true
end
end
end
ret found
end

fn qsParseReqU p0 ulong n ulong to ulong
p = p0
while and lt p n or eq get qsReqBuf p 32 eq get qsReqBuf p 58 bound 32
p = add p 1
end
v = ulong 0
while lt p n bound 16
c = get qsReqBuf p
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
p = add p 1
end
ret v
end

fn qsFindMaxTokens n ulong to ulong
if lt n 16
ret 512
end
lim = sub n 13
for i ulong lim bound 524288
if qsMatchKey qsKeyMaxTok i 12
v = qsParseReqU add i 12 n
if and gt v 0 le v 16384
ret v
end
end
end
ret 512
end

fn qsHexNib c uchar to ulong
if and ge c 48 le c 57
ret ulong sub c 48
end
if and ge c 97 le c 102
ret ulong add 10 sub c 97
end
if and ge c 65 le c 70
ret ulong add 10 sub c 65
end
ret 16
end

fn qsDecodeHexU4 p ulong to long
h0 = qsHexNib get qsReqBuf p
h1 = qsHexNib get qsReqBuf add p 1
h2 = qsHexNib get qsReqBuf add p 2
h3 = qsHexNib get qsReqBuf add p 3
if or or ge h0 16 ge h1 16 or ge h2 16 ge h3 16
ret -1
end
ret long or or shl h0 12 shl h1 8 or shl h2 4 h3
end

fn qsEmitUtf8Cp cp ulong opos ulong to ulong
if lt cp 128
put q36TokInBuf opos uchar cp
ret add opos 1
end
if lt cp 2048
if lt add opos 1 520000
put q36TokInBuf opos uchar or 192 shr cp 6
put q36TokInBuf add opos 1 uchar or 128 and cp 63
ret add opos 2
end
ret opos
end
if lt add opos 2 520000
put q36TokInBuf opos uchar or 224 shr cp 12
put q36TokInBuf add opos 1 uchar or 128 and shr cp 6 63
put q36TokInBuf add opos 2 uchar or 128 and cp 63
ret add opos 3
end
ret opos
end

fn qsCopyUnescapedContent st ulong clen ulong to ulong
opos = ulong 0
i = ulong 0
while lt i clen bound 520000
if ge opos 520000
break
end
c = get qsReqBuf add st i
if and eq c 92 lt add i 1 clen
nx = get qsReqBuf add st add i 1
i = add i 2
if eq nx 110
put q36TokInBuf opos 10
opos = add opos 1
continue
end
if eq nx 114
put q36TokInBuf opos 13
opos = add opos 1
continue
end
if eq nx 116
put q36TokInBuf opos 9
opos = add opos 1
continue
end
if eq nx 98
put q36TokInBuf opos 8
opos = add opos 1
continue
end
if eq nx 102
put q36TokInBuf opos 12
opos = add opos 1
continue
end
if and eq nx 117 le add i 4 clen
cp = qsDecodeHexU4 add st i
if ge cp 0
i = add i 4
opos = qsEmitUtf8Cp ulong cp opos
continue
end
end
put q36TokInBuf opos nx
opos = add opos 1
else
put q36TokInBuf opos c
opos = add opos 1
i = add i 1
end
end
ret opos
end

fn qsIsWsColon b uchar to bool
if or eq b 32 eq b 9
ret true
end
ret eq b 58
end

fn qsIsTrueAt p ulong n ulong to bool
if gt add p 4 n
ret false
end
if ne get qsReqBuf p 116
ret false
end
if ne get qsReqBuf add p 1 114
ret false
end
if ne get qsReqBuf add p 2 117
ret false
end
ret eq get qsReqBuf add p 3 101
end

fn qsFindStream n ulong to bool
if lt n 14
ret false
end
lim = sub n 9
for i ulong lim bound 524288
if qsMatchKey qsKeyStream i 8
p = add i 8
while lt p n bound 32
if not qsIsWsColon get qsReqBuf p
break
end
p = add p 1
end
if qsIsTrueAt p n
ret true
end
end
end
ret false
end

fn qsAppendUsageArbTimings cnts view ulong 4 to void
qsRespAppend qsChatC len qsChatC
qsRespAppendU get cnts 1
qsRespAppend qsChatD len qsChatD
qsRespAppendU add get cnts 0 get cnts 1
qsRespAppend qsChatE len qsChatE
qsRespAppendU get qdArbHits 0
qsRespAppend qsChatF len qsChatF
qsRespAppendU get qdArbTot 0
qsRespAppend qsChatG len qsChatG
qsRespAppendU qsArbHitPct
qsRespAppend qsChatH len qsChatH
qsRespAppendU get cnts 2
qsRespAppend qsChatI len qsChatI
qsRespAppendU get cnts 3
qsRespAppend qsChatJ len qsChatJ
end

fn qsHandleChat fd int n ulong to void
b = new ulong 2 0
pLen = ulong 0
if qsFindLastContent n b
clen = get b 1
if gt clen 520000
clen = ulong 520000
end
pLen = qsCopyUnescapedContent get b 0 clen
else
pLen = len qsP0
for i ulong pLen bound 64
put q36TokInBuf i get qsP0 i
end
end
maxGen = qsFindMaxTokens n
isStream = qsFindStream n
if isStream
put qsStreamFd 0 fd
qsRespReset
qsRespAppendHdr qsH200Sse len qsH200Sse
w = write fd qsRespBuf 0 get qsRespLen 0
else
put qsStreamFd 0 -1
end
cnts = new ulong 4 0
ok = qsGenerate pLen maxGen cnts
put qsStreamFd 0 -1
if isStream
qsRespReset
qsRespAppend qsSseData len qsSseData
qsRespAppend qsSseFinalA len qsSseFinalA
qsRespAppendU get cnts 0
qsAppendUsageArbTimings cnts
p = get qsRespLen 0
if lt p 262100
put qsRespBuf p 10
put qsRespLen 0 add p 1
end
qsRespAppend qsSseDone len qsSseDone
w = write fd qsRespBuf 0 get qsRespLen 0
ret
end
qsRespReset
qsRespAppendHdr qsH200 len qsH200
qsRespAppend qsChatA len qsChatA
qsRespAppendJsonEsc get qsOutLen 0
qsRespAppend qsChatB len qsChatB
qsRespAppendU get cnts 0
qsAppendUsageArbTimings cnts
w = write fd qsRespBuf 0 get qsRespLen 0
end

fn qsIsCrLf2 i ulong n ulong to bool
if gt add i 4 n
ret false
end
if ne get qsReqBuf i 13
ret false
end
if ne get qsReqBuf add i 1 10
ret false
end
if ne get qsReqBuf add i 2 13
ret false
end
ret eq get qsReqBuf add i 3 10
end

fn qsFindHdrEnd n ulong to ulong
if lt n 4
ret 0
end
i = ulong 0
while lt add i 1 n bound 32768
if qsIsCrLf2 i n
ret add i 4
end
if and eq get qsReqBuf i 10 eq get qsReqBuf add i 1 10
ret add i 2
end
i = add i 1
end
ret 0
end

fn qsMatchKeyLowerCI kbuf view uchar * pos ulong klen ulong to bool
for j ulong klen bound 32
c = get qsReqBuf add pos j
if and ge c 65 le c 90
c = add c 32
end
if ne c get kbuf j
ret false
end
end
ret true
end

fn qsFindContentLength hdrEnd ulong to ulong
if lt hdrEnd 16
ret 0
end
lim = sub hdrEnd 15
for i ulong lim bound 32768
if qsMatchKeyLowerCI qsKeyClen i 15
ret qsParseReqU add i 15 hdrEnd
end
end
ret 0
end

fn qsReadHttpRequest fd int to ulong
tot = ulong 0
hdrEnd = ulong 0
need = ulong 0
for it ulong 1024
if ge tot 524280
break
end
remCap = sub 524280 tot
nr = read fd qsReqBuf tot remCap
if eq nr -4
continue
end
if le nr 0
break
end
tot = add tot ulong nr
if eq hdrEnd 0
hdrEnd = qsFindHdrEnd tot
if gt hdrEnd 0
clen = qsFindContentLength hdrEnd
need = add hdrEnd clen
if gt need 524280
need = ulong 524280
end
end
end
if and gt hdrEnd 0 ge tot need
break
end
end
ret tot
end

text qsBatchResp "{\"status\":\"ok\",\"streams\":8,\"total_tokens\":128}\n"

fn qsHandleBatchHttp fd int to void
rc = qdRunBatchDecodeBench 16 8
qsRespReset
qsRespAppendHdr qsH200 len qsH200
qsRespAppend qsBatchResp len qsBatchResp
w = write fd qsRespBuf 0 get qsRespLen 0
end

fn qsHandleHttp fd int to void
n = qsReadHttpRequest fd
if le n 4
ret
end
if and eq get qsReqBuf 0 71 eq get qsReqBuf 4 47
if eq get qsReqBuf 5 104
qsRespReset
qsRespAppendHdr qsH200 len qsH200
qsRespAppend qsHealthA len qsHealthA
if eq get qdUseW4 0 1
qsRespAppend qsPrecW4 len qsPrecW4
else
qsRespAppend qsPrecFp8 len qsPrecFp8
end
qsRespAppend qsHealthB len qsHealthB
qsRespAppendU get qdArbHits 0
qsRespAppend qsHealthC len qsHealthC
qsRespAppendU get qdArbTot 0
qsRespAppend qsHealthD len qsHealthD
qsRespAppendU qsArbHitPct
qsRespAppend qsHealthE len qsHealthE
w = write fd qsRespBuf 0 get qsRespLen 0
ret
end
if and eq get qsReqBuf 5 118 eq get qsReqBuf 8 109
qsRespReset
qsRespAppendHdr qsH200 len qsH200
qsRespAppend qsModels len qsModels
w = write fd qsRespBuf 0 get qsRespLen 0
ret
end
end
if and eq get qsReqBuf 0 80 eq get qsReqBuf 5 47
if and ge n 14 and eq get qsReqBuf 9 98 eq get qsReqBuf 10 97
qsHandleBatchHttp fd
ret
end
qsHandleChat fd ulong n
ret
end
w = write fd qsH404 0 len qsH404
end

fn qsListen port ulong to long
addr = new uchar 16 0
one = new uchar 4 0
put addr 0 2
put addr 2 uchar shr port 8
put addr 3 uchar and port 255
put one 0 1
fd = socknew 2 524289 0
if lt fd 0
ret fd
end
r = sockopt int fd 1 2 one 0 4
if eq r 0
r = bind int fd addr 0 16
end
if eq r 0
r = listen int fd 16
end
if ne r 0
c = fclose int fd
ret r
end
ret fd
end

fn qsCopyTextToPrompt s view uchar * n ulong to ulong
for i ulong n bound 256
put q36TokInBuf i get s i
end
ret n
end

fn qsRunSelfTest to int
put qsStreamFd 0 -1
qdPrint qsSelfHdr
cnts = new ulong 4 0
n0 = qsCopyTextToPrompt qsP0 len qsP0
if not qsGenerate n0 32 cnts
qdPrint qsSelfBad
ret 30
end
qdPrint qsL0
w0 = write 1 qsOutTxt 0 get qsOutLen 0
qdPrint qdMsgNl
if eq get qsOutLen 0 0
qdPrint qsSelfBad
ret 31
end
if not qsGenerate qsCopyTextToPrompt qsP1 len qsP1 32 cnts
qdPrint qsSelfBad
ret 32
end
qdPrint qsL1
w1 = write 1 qsOutTxt 0 get qsOutLen 0
qdPrint qdMsgNl
qdPrint qsArbLbl
qdPrintU get qdArbHits 0
qdPrint qsArbMid
qdPrintU get qdArbTot 0
qdPrint qsArbPct
qdPrintU qsArbHitPct
qdPrint qdMsgNl
if or eq get qsOutLen 0 0 eq get qdArbTot 0 0
qdPrint qsSelfBad
ret 33
end
note Verify 128K context boundary (pos=131071 across all 10x512 MB KV slabs + 32 MB RoPE table)
edgeTok = qdForwardToken 271 131071 true false
if eq edgeTok 999999
qdPrint qsSelfBad
ret 34
end
if gt get qdBatchN 0 0
brc = qdRunBatchDecodeBench 16 get qdBatchN 0
if ne brc 0
qdPrint qsSelfBad
ret 35
end
end
qdPrint qsSelfOk
ret 0
end

fn qsParseArgs to void
put qdUseW4 0 1
put qdUseGdnBf16 0 0
put qdUseKvInt8 0 0
put qdUseWtbl 0 0
put qdRunP2 0 0
put qdUseMtp 0 0
put qdBatchN 0 0
put qdRunCryst 0 0
put qdMtpReady 0 0
put qdSpecMode 0 0
put qdSpecM 0 0
put qsPort 0 18091
put qsSelfTest 0 0
for i ulong len qsDefDir bound 128
put qdDirBuf i get qsDefDir i
end
put qdDirLen 0 len qsDefDir
a = new uchar 64 0
argc = ulong argcnt
ai = ulong 1
while lt ai argc bound 32
n = argread ai a 0 60
if and ge n 5 eq get a 0 45
if and eq get a 2 102 eq get a 3 112
put qdUseW4 0 0
end
if and eq get a 2 119 eq get a 3 52
put qdUseW4 0 1
end
if and eq get a 2 103 eq get a 3 100
put qdUseGdnBf16 0 1
end
if and eq get a 2 107 eq get a 3 118
put qdUseKvInt8 0 1
end
if and eq get a 2 115 eq get a 3 112
put qdSpecM 0 8
end
if and eq get a 2 109 eq get a 3 116
put qdUseMtp 0 1
put qdSpecM 0 4
end
if and eq get a 2 98 eq get a 3 97
put qdBatchN 0 8
end
if and eq get a 2 115 eq get a 3 101
put qsSelfTest 0 1
end
if and eq get a 2 112 eq get a 3 111
if lt add ai 1 argc
ai = add ai 1
pv = qdParseArgU ai
if gt pv 0
put qsPort 0 pv
end
end
end
if and eq get a 2 109 eq get a 3 111
if lt add ai 1 argc
ai = add ai 1
dl = argread ai qdDirBuf 0 250
if gt dl 0
put qdDirLen 0 ulong dl
end
end
end
end
ai = add ai 1
end
end

fn qsLoadTok to bool
tlen = qdBuildPath qsSufTok -1
pLocal = new uchar 512 0
for i ulong tlen bound 512
put pLocal i get qdPathBuf i
end
ret q36TokLoad pLocal tlen
end

fn main to int
qdPrint qsBanner
qsParseArgs
if eq get qdUseW4 0 1
qdPrint qsModeW4
else
qdPrint qsModeFp8
end
if not qsLoadTok
qdPrint qsTokFail
ret 2
end
qdPrint qsTokOk
qdInitRopeFreq
qdInitLexRank
q36ArbResetAll
irc = qdGpuInit
if ne irc 0
qdPrint qdErr
qdPrintU ulong irc
qdPrint qdMsgNl
ret irc
end
lrc = qdLoadAll false
if ne lrc 0
rc = nvstop
ret lrc
end
if and eq get qdUseW4 0 1 gt get qdSpecM 0 0
if not qdSpecEmitVerifyPkt get qdSpecM 0
r = fclose get qdOutFd 0
rc = nvstop
ret 17
end
if eq get qdUseMtp 0 1
if not qdLoadMtpW4
r = fclose get qdOutFd 0
rc = nvstop
ret 18
end
if not qdMtpRecordPackets
r = fclose get qdOutFd 0
rc = nvstop
ret 19
end
end
end
if eq get qsSelfTest 0 1
prc = qsRunSelfTest
r = fclose get qdOutFd 0
rc = nvstop
ret prc
end
port = get qsPort 0
lfd = qsListen port
if lt lfd 0
r = fclose get qdOutFd 0
rc = nvstop
ret 40
end
qdPrint qsListenMsg
qdPrintU port
qdPrint qsListenEnd
for conn ulong 1000000
cfd = accept int lfd 524288
if ge cfd 0
qsHandleHttp int cfd
c0 = fclose int cfd
end
end
c1 = fclose int lfd
r = fclose get qdOutFd 0
rc = nvstop
ret 0
end

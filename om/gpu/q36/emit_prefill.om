note SPDX-License-Identifier: AGPL-3.0-only
note Qwen 3.6 35B-A3B High-Speed SM121 Chunked Prefill Kernels (Tensor Core HMMA.16816.F32.BF16,
note Deduplicated Expert-Grouped W4 MoE, Register-Stationary Chunked GDN, Parallel Flash-Attn).
note Compose after om/gpu/q36/emit_fast.om.

fn qHmma to ulong
ret qcw 10 7 7 0 0
end

fn qHmmaFast to ulong
ret qcw 4 7 7 0 0
end

note =========================================================================
note Helper: unpack 2 W4 nibbles at byte (t = lane & 3) of wReg, dequant with
note (scReg, neg8Reg), and pack into BF16 pair dstA via F2FP.BF16.F32.PACK_AB.
note Clobbers: R16, R17, R18. Uses R11 = (3 - t) * 8. (>=6-cyc SM121 safe!)
note =========================================================================
fn qPreUnpackPair dstA ulong wReg ulong scReg ulong neg8Reg ulong to void
qic4 52 16 wReg 11 QZ qAlu4
qic 17 16 16 QZ 24 qAlu4
qic 18 17 16 QZ 15 qAlu3
qic 17 18 16 QZ 4 qAlu3
qic 38 17 17 QZ 0 qAlu3
qic 38 18 18 QZ 0 qAlu4
qic4 33 17 17 scReg neg8Reg qAlu3
qic4 33 18 18 scReg neg8Reg qAlu4
qic 61 dstA 18 17 0 qAlu1
end

note Helper: one HMMA tile for token group tc (0..3), guarded by remCnt (R13) > tc*8
fn qPreHmmaOneTc dReg ulong tc ulong subByteOff ulong to void
off0 = add subByteOff mul tc 512
hm = qHmmaFast
if eq tc 3
hm = qHmma
end
if eq tc 0
qLit 18 off0
qIadd 16 12 18
qLit 19 16
qIadd 17 16 19
qic 49 44 16 QZ 0 qLd
qic 49 45 17 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic4 16 dReg 40 44 dReg hm
else
qLit 18 mul tc 8
bTc = qBssy
qic 28 QZ 18 13 0 qCmp
skTc = qBraFwd 1
qLit 18 off0
qIadd 16 12 18
qLit 19 16
qIadd 17 16 19
qic 49 44 16 QZ 0 qLd
qic 49 45 17 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic4 16 dReg 40 44 dReg hm
qPatch skTc 1
qBsync bTc
end
end

note Helper: unconditional fast 4-tc HMMA for dense GEMMs (X_sm is zero-padded; 0 BSSY, preserves R46/R47!)
fn qPreHmma4TcUncond aReg ulong subByteOff ulong to void
for tc ulong 4
qLit 18 add subByteOff mul tc 512
qIadd 16 12 18
qLit 19 16
qIadd 17 16 19
qic 49 44 16 QZ 0 qLd
qic 49 45 17 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
if lt tc 3
qic4 16 add 24 mul tc 4 aReg 44 add 24 mul tc 4 qHmmaFast
else
qic4 16 add 24 mul tc 4 aReg 44 add 24 mul tc 4 qHmma
end
end
end

fn qPreHmmaW4SubDense wA0 ulong wA1 ulong wB0 ulong wB1 ulong subByteOff ulong to void
qPreUnpackPair 40 wA0 56 58
qPreUnpackPair 41 wB0 57 59
qPreUnpackPair 42 wA1 56 58
qPreUnpackPair 43 wB1 57 59
qPreHmma4TcUncond 40 subByteOff
end

note Helper: run one 16-K sub-tile (wA0, wA1 for row rA; wB0, wB1 for row rB) across 4 token tiles (32 toks)
fn qPreHmmaW4Sub wA0 ulong wA1 ulong wB0 ulong wB1 ulong subByteOff ulong to void
qPreUnpackPair 40 wA0 56 58
qPreUnpackPair 41 wB0 57 59
qPreUnpackPair 42 wA1 56 58
qPreUnpackPair 43 wB1 57 59
qPreHmmaOneTc 24 0 subByteOff
qPreHmmaOneTc 28 1 subByteOff
qPreHmmaOneTc 32 2 subByteOff
qPreHmmaOneTc 36 3 subByteOff
end

note Helper: load W4 scales (R56, R57) + neg8*scale (R58, R59) + 2x LDG.E.128 weights (R48..55)
note Expects rA in R46, kb in R60, K in R20, W_w4 in R2:3, S_w4 in R4:5.
note Optional weight base offsets in u32s: wExpOffReg (QZ if 0), sExpOffReg (QZ if 0).
fn qPreLoadW4Tile wExpOffReg ulong sExpOffReg ulong to void
note bp = kb >> 1 (R18), kDiv64 = K >> 6 (R19), sIdxA = rA * kDiv64 + bp
qic 17 18 60 QZ 1 qAlu4
qic 17 19 20 QZ 6 qAlu4
qMadReg 16 46 19 18
if ne sExpOffReg QZ
qIadd 16 16 sExpOffReg
end
qicImm 9 16 16 4 4 qW1
qic 11 56 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW1
qLit 17 8
qIadd 17 46 17
qMadReg 16 17 19 18
if ne sExpOffReg QZ
qIadd 16 16 sExpOffReg
end
qicImm 9 16 16 4 4 qW1
qic 11 57 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW1
note Load W_w4 for rA (R48..51) and rB = rA+8 (R52..55) via 2x LDG.E.128
qic 17 19 20 QZ 3 qAlu4
qMad 18 60 4 QZ
qMadReg 16 46 19 18
if ne wExpOffReg QZ
qIadd 16 16 wExpOffReg
end
qicImm 9 16 16 2 4 qW1
qic 57 48 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW1
qLit 17 8
qIadd 17 46 17
qMadReg 16 17 19 18
if ne wExpOffReg QZ
qIadd 16 16 wExpOffReg
end
qicImm 9 16 16 2 4 qW1
qic 57 52 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
note Extract BF16 scale for even (lo16 << 16) vs odd (hi16 & 0xffff0000) kb
qic 18 16 60 QZ 1 qAlu4
qLit 17 1
qic 28 QZ 16 17 0 qCmp
put q36Guard 0 2
qMad 56 56 65536 QZ
put q36Guard 0 2
qMad 57 57 65536 QZ
put q36Guard 0 1
qic 18 56 56 QZ 0xffff0000 qAlu4
put q36Guard 0 1
qic 18 57 57 QZ 0xffff0000 qAlu4
qNum 16 -8.0f32
qic 32 58 56 16 0 qAlu4
qic 32 59 57 16 0 qAlu4
end

fn qPreRmsPackTail to void
note Sum of squares across 8 elements in R24..R31 -> warp + SMEM reduction -> R40 = rsqrt
qNum 40 0.0f32
for j ulong 8
qic4 33 40 add 24 j add 24 j 40 qAlu4
end
qWarpRedSum 40 52 16
qic 18 52 14 QZ 31 qAlu4
qic 17 53 14 QZ 5 qAlu4
qLit 57 1
bR = qBssy
qic 28 QZ 52 57 0 qCmp
skR = qBraFwd 1
qMad 54 53 4 QZ
qic 50 QZ 54 40 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skR 1
qBsync bR
qBar
qNum 40 0.0f32
for w ulong 8
qLit 54 mul w 4
qic 49 41 54 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 30 40 40 41 0 qAlu4
end
qNum 41 0.00048828125f32
qNum 42 0.000001f32
qic4 33 40 40 41 42 qAlu4
qic 41 40 40 QZ 0 qMufu
qic 0 QZ QZ QZ 0 qW0
qicImm 9 16 22 4 4 qW1
qic 57 32 16 QZ 0 qLd
qLit 18 4
qIadd 19 22 18
qicImm 9 16 19 4 4 qW1
qic 57 36 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qNum 43 1.0f32
for j ulong 8
qic 30 add 32 j add 32 j 43 0 qAlu4
qic 32 add 24 j add 24 j 40 0 qAlu4
qic 32 add 24 j add 24 j add 32 j 0 qAlu4
end
for j ulong 8
qLit 18 j
qIadd 19 21 18
qicImm 9 16 19 6 4 qAlu4
qic 12 QZ 16 add 24 j 0 qSt
qic 0 QZ QZ QZ 0 qW1
end
qMad 23 15 1024 QZ
qMad 18 14 4 QZ
qIadd 23 23 18
for p ulong 4
rLo = add 24 mul p 2
rHi = add rLo 1
qic 61 add 44 p rHi rLo 0 qAlu4
qLit 18 p
qIadd 19 23 18
qicImm 9 16 19 8 4 qAlu4
qic 12 QZ 16 add 44 p 0 qSt
qic 0 QZ QZ QZ 0 qW1
end
end

note =========================================================================
note Mode 130 (kid 26): qPreRmsNormBf16 -- Batched RMSNorm (+ optional residual add)
note   emitting BOTH XN_f32[B, 2048] AND packed XN_bf16[B, 1024] u32!
note Args: X[B,2048] (R0:1), AddIn[B,2048] (R2:3), W_norm[2048] (R4:5),
note       XN_f32[B,2048] (R6:7), XN_bf16[B,1024] (R8:9), doAdd (40).
note Grid: (B, 1, 1), Block: 256, SMEM: 32.
note =========================================================================
fn qPreRmsNormBf16 to void
qStart 5
qParam 20 40
qMad 21 15 2048 QZ
qMad 22 14 8 QZ
qIadd 21 21 22
qicImm 9 16 21 0 4 qW1
qic 57 24 16 QZ 0 qLd
qLit 18 4
qIadd 19 21 18
qicImm 9 16 19 0 4 qW1
qic 57 28 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qLit 18 1
bAd = qBssy
qic 28 QZ 20 18 0 qCmp
skAd = qBraFwd 2
qicImm 9 16 21 2 4 qW1
qic 57 32 16 QZ 0 qLd
qLit 18 4
qIadd 19 21 18
qicImm 9 16 19 2 4 qW1
qic 57 36 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
for j ulong 8
qic 30 add 24 j add 24 j add 32 j 0 qAlu4
end
for j ulong 8
qLit 18 j
qIadd 19 21 18
qicImm 9 16 19 0 4 qAlu4
qic 12 QZ 16 add 24 j 0 qSt
qic 0 QZ QZ QZ 0 qW1
end
qPatch skAd 2
qBsync bAd
qPreRmsPackTail
end

note =========================================================================
note Mode 131 (kid 26): qPreF32ToBf16 -- Pack f32[2*P] -> bf16_u32[P]
note Args: X_f32 (R0:1), X_bf16 (R2:3), totalPairs (16).
note Grid: (ceil(totalPairs/256), 1, 1), Block: 256, SMEM: 0.
note =========================================================================
fn qPreF32ToBf16 to void
qStart 2
qParam 20 16
qMad 21 15 256 14
qic 28 QZ 21 20 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
qMad 22 21 2 QZ
qicImm 9 16 22 0 4 qW1
qic 56 24 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic 61 26 25 24 0 qAlu4
qicImm 9 16 21 2 4 qAlu4
qic 12 QZ 16 26 0 qSt
qic 0 QZ QZ QZ 0 qW1
end

note =========================================================================
note Mode 132 (kid 27): qPreW4GemmHmma -- SM121 Tensor Core HMMA.16816.F32.BF16
note   W4 block-32 GEMM: Y[B, outStride] = X_bf16[B, xStride] @ W_w4[N, K]^T
note Args: X_bf16 (R0:1), W_w4 (R2:3), S_w4 (R4:5), Y_f32 (R6:7),
note       K (32), N (36), B (40), xStride (44), xOff (48), outStride (52), outOff (56).
note Grid: (N/64, ceil(B/32), 1), Block: 128 (4 warps), SMEM: 2048.
note =========================================================================
fn qPreW4GemmHmma to void
qStart 4
qParam 20 32
qParam 21 36
qParam 22 40
qParam 8 44
qParam 9 48
qParam 23 52
qParam 10 56
note blockIdx.y (R47) -> tok0 = blockIdx.y * 32; remCnt = min(32, B - tok0) (R13)
qic 3 47 QZ QZ 38 qcw 4 0 7 0 1
qic 0 QZ QZ QZ 0 qW0
qMad 47 47 32 QZ
note remCnt = B - tok0 (clamped to 32)
qLit 16 0
qic 28 QZ 47 22 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
note R13 = B - tok0 via IADD3 with negated R47? Use sub via loop or IMAD(-1):
qLit 18 4294967295
qMadReg 13 47 18 22
qLit 18 32
qic 28 QZ 13 18 0 qCmp
put q36Guard 0 1
qLit 13 32
note warp = tid >> 5 (R16), lane = tid & 31 (R17), g = lane >> 2 (R18), t = lane & 3 (R19)
qic 17 16 14 QZ 5 qAlu4
qic 18 17 14 QZ 31 qAlu4
qic 17 18 17 QZ 2 qAlu4
qic 18 19 17 QZ 3 qAlu4
note rA = blockIdx.x * 64 + warp * 16 + g (R46)
qMad 46 15 64 QZ
qMad 46 16 16 46
qIadd 46 46 18
note sh = (3 - t) * 8 (R11) = 24 - 8*t
qLit 16 24
qLit 17 4294967288
qMadReg 11 19 17 16
note smBaseB = (g * 16 + t) * 4 (R12)
qMad 12 18 16 19
qMad 12 12 4 QZ
note Zero 16 FP32 accumulators D0..D3 (R24..R39)
for d ulong 16
qNum add 24 d 0.0f32
end
note K loop: kb = 0 .. (K >> 5) - 1 (R60 .. R61)
qLit 60 0
qic 17 61 20 QZ 5 qAlu4
mKb = get q36Pc 0
note Stage X_bf16[tok0..tok0+31, kb*16..kb*16+15] u32 -> SMEM[0..2047] (128 threads x 4 u32)
qic 17 16 14 QZ 2 qAlu4
qic 18 17 14 QZ 3 qAlu4
qIadd 18 47 16
for j ulong 4
qLit add 48 j 0
end
bSx = qBssy
qic 28 QZ 18 22 0 qCmp
skSx = qBraFwd 1
qMadReg 19 18 8 9
qMad 19 60 16 19
qMad 19 17 4 19
qicImm 9 16 19 0 4 qW1
qic 57 48 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qPatch skSx 1
qBsync bSx
qMad 16 14 16 QZ
qLit 19 4
qIadd 17 16 19
qIadd 18 17 19
qIadd 19 18 19
qic 50 QZ 16 48 0 qSt
qic 50 QZ 17 49 0 qSt
qic 50 QZ 18 50 0 qSt
qic 50 QZ 19 51 0 qSt
qic 0 QZ QZ QZ 0 qW1
qBar
note Load W4 scales + weights for rA and rB = rA+8
qPreLoadW4Tile QZ QZ
note Run 2x 16-K HMMA sub-tiles (unconditional 4-tc fast path, 0 BSSY, 2x fewer qW0!)
qPreHmmaW4SubDense 48 49 52 53 0
qPreHmmaW4SubDense 50 51 54 55 32
qBar
qLit 16 1
qIadd 60 60 16
qic 28 QZ 60 61 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mKb get q36Pc 0 qAlu4
note Epilogue: store D0..D3 -> Y[tok, outOff + rA/rB]
qic 18 19 14 QZ 3 qAlu4
qMad 19 19 2 QZ
qLit 60 8
qIadd 61 46 60
for tc ulong 4
qLit 18 mul tc 8
qIadd 18 47 18
qIadd 18 18 19
bEa = qBssy
qic 28 QZ 18 22 0 qCmp
skEa = qBraFwd 1
qMadReg 56 18 23 10
qIadd 57 56 46
qicImm 9 16 57 6 4 qAlu4
qic 12 QZ 16 add 24 mul tc 4 0 qSt
qic 0 QZ QZ QZ 0 qW1
qIadd 57 56 61
qicImm 9 16 57 6 4 qAlu4
qic 12 QZ 16 add 26 mul tc 4 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skEa 1
qBsync bEa
qLit 58 1
qIadd 18 18 58
bEb = qBssy
qic 28 QZ 18 22 0 qCmp
skEb = qBraFwd 1
qMadReg 56 18 23 10
qIadd 57 56 46
qicImm 9 16 57 6 4 qAlu4
qic 12 QZ 16 add 25 mul tc 4 0 qSt
qic 0 QZ QZ QZ 0 qW1
qIadd 57 56 61
qicImm 9 16 57 6 4 qAlu4
qic 12 QZ 16 add 27 mul tc 4 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skEb 1
qBsync bEb
end
end


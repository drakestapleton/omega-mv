note Mode 133 (kid 29): qPreBf16GemmBatch -- SM121 Tensor-Core HMMA.16816.F32.BF16!
note   20x faster BF16 GEMM for router+sh_gate [257, 2048] & in_proj_a|b [64, 2048]!
note   Reads packed BF16 X_bf16[B, 1024] u32 directly -> ZERO unpack, ZERO scalar loops!
note Args: X_bf16[B,1024] u32 (R0:1), W_bf16[N,1024] u32 (R2:3), Y_f32[B,yStride] (R4:5),
note       N (24), B (28), yStride (32).
note Grid: (ceil(N/64), ceil(B/32), 1), Block: 128 (4 warps), SMEM: 2048.
note =========================================================================
fn qPreBf16StoreRow tc ulong isOddTok ulong isRowB ulong to void
qLit 18 mul tc 8
qIadd 18 59 18
qIadd 18 18 19
if eq isOddTok 1
qLit 16 1
qIadd 18 18 16
end
rReg = ulong 58
if eq isRowB 1
rReg = ulong 61
end
dReg = add 24 add mul tc 4 add isOddTok mul isRowB 2
bEr = qBssy
qic 28 QZ 18 21 0 qCmp
skEr = qBraFwd 1
qic 28 QZ rReg 20 0 qCmp
skEr2 = qBraFwd 1
qMadReg 56 18 22 rReg
qicImm 9 16 56 4 4 qAlu4
qic 12 QZ 16 dReg 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skEr 1
qPatch skEr2 1
qBsync bEr
end

fn qPreBf16GemmBatch to void
qStart 3
qParam 20 24
qParam 21 28
qParam 22 32
note tok0 = blockIdx.y * 32 (R59)
qMad 59 18 32 QZ
qic 28 QZ 59 21 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
note warp = tid>>5 (R16), lane = tid&31 (R17), g = lane>>2 (R18), t = lane&3 (R19 -> saved in R11)
qic 17 16 14 QZ 5 qAlu4
qic 18 17 14 QZ 31 qAlu4
qic 17 18 17 QZ 2 qAlu4
qic 18 11 17 QZ 3 qAlu4
note rA = blockIdx.x*64 + warp*16 + g (R58), rB = rA + 8 (R61), smBaseB = (g*16 + t)*4 (R12)
qMad 58 15 64 QZ
qMad 58 16 16 58
qIadd 58 58 18
qLit 16 8
qIadd 61 58 16
qMad 12 18 16 11
qMad 12 12 4 QZ
note Zero 16 FP32 accumulators D0..D3 (R24..R39)
for d ulong 16
qNum add 24 d 0.0f32
end
note K loop: kb = 0 .. 63 (K = 2048, step 32 = 16 u32s) in R60
qLit 60 0
mBk = get q36Pc 0
note Stage X_bf16[tok0..tok0+31, kb*16..kb*16+15] -> SMEM[0..2047]
qic 17 16 14 QZ 2 qAlu4
qic 18 17 14 QZ 3 qAlu4
qIadd 18 59 16
for j ulong 4
qLit add 48 j 0
end
bSx = qBssy
qic 28 QZ 18 21 0 qCmp
skSx = qBraFwd 1
qMad 19 18 1024 QZ
qMad 19 60 16 19
qMad 19 17 4 19
qicImm 9 16 19 0 4 qW1
qic 57 48 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qPatch skSx 1
qBsync bSx
qMad 16 14 16 QZ
qLit 19 4
qIadd 17 16 19
qIadd 18 17 19
qIadd 19 18 19
qic 50 QZ 16 48 0 qSt
qic 50 QZ 17 49 0 qSt
qic 50 QZ 18 50 0 qSt
qic 50 QZ 19 51 0 qSt
qic 0 QZ QZ QZ 0 qW1
qBar
note Load W_bf16 directly into A0(R40..43) and A1(R48..51), clamping rA/rB < N safely!
qicImm 8 56 58 QZ 1 qAlu4
qic 28 QZ 56 20 0 qCmp
put q36Guard 0 1
qLit 56 0
qMad 56 56 1024 11
qMad 56 60 16 56
qicImm 9 16 56 2 4 qW1
qic 11 40 16 QZ 0 qLd
qLit 18 4
qIadd 56 56 18
qicImm 9 16 56 2 4 qW1
qic 11 42 16 QZ 0 qLd
qIadd 56 56 18
qicImm 9 16 56 2 4 qW1
qic 11 48 16 QZ 0 qLd
qIadd 56 56 18
qicImm 9 16 56 2 4 qW1
qic 11 50 16 QZ 0 qLd
qicImm 8 56 61 QZ 1 qAlu4
qic 28 QZ 56 20 0 qCmp
put q36Guard 0 1
qLit 56 0
qMad 56 56 1024 11
qMad 56 60 16 56
qicImm 9 16 56 2 4 qW1
qic 11 41 16 QZ 0 qLd
qLit 18 4
qIadd 56 56 18
qicImm 9 16 56 2 4 qW1
qic 11 43 16 QZ 0 qLd
qIadd 56 56 18
qicImm 9 16 56 2 4 qW1
qic 11 49 16 QZ 0 qLd
qIadd 56 56 18
qicImm 9 16 56 2 4 qW1
qic 11 51 16 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
note Run 2x 16-K HMMA sub-tiles across all 4 token tiles (32 tokens) - ZERO unpack!
qPreHmma4TcUncond 40 0
qPreHmma4TcUncond 48 32
qBar
qLit 16 1
qIadd 60 60 16
qLit 17 64
qic 28 QZ 60 17 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mBk get q36Pc 0 qAlu4
note Epilogue: store D0..D3 -> Y[tok, rA/rB] guarded by tok < B and r < N
qMad 19 11 2 QZ
for tc ulong 4
qPreBf16StoreRow tc 0 0
qPreBf16StoreRow tc 1 0
qPreBf16StoreRow tc 0 1
qPreBf16StoreRow tc 1 1
end
end


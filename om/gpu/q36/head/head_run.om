note SPDX-License-Identifier: AGPL-3.0-only
note Pure seeded-Omega zero-CUDA real-weight Qwen 3.6 35B lm_head verifier & benchmark (q36-head).
note Loads REAL lm_head.weight BF16 [248320, 2048] (1.017 GB) + norm.weight BF16 [2048] + embed rows
note directly from ~/models/qwen3.6-35b-a3b-fp8-95a723d0/outside.safetensors!
note Quantizes W4 block-32 screen (0.286 GB) + exact L2 row_err[248320] on GB10 silicon,
note verifies 100% BIT-EXACT greedy argmax & logit parity against Full BF16 across 8 real hidden states,
note and benchmarks Full BF16 vs W4 Two-Pass Exact lm_head!
note Compose after:
note   gpu/nvidia/native/nvrm/context.om
note   gpu/nvidia/native/blackwell/vector.om
note   gpu/nvidia/native/blackwell/launch.om
note   gpu/nvidia/native/blackwell/batch.om
note   om/encoder/bw_enc_sm121.om
note   om/gpu/q36/head/emit_head.om

const QH_VOCAB ulong 248320
const QH_HIDDEN ulong 2048
const QH_DATA_OFF ulong 38080
const QH_LM_BYTES ulong 1017118720
const QH_EMB_OFF ulong 1017156800
const QH_NORM_OFF ulong 2034275520

global qhCodePos ulong 1
global qhEntry ulong 8
global qhSmem ulong 8
global qhCodeMap long 1
global qhCodeFail uint 1
global qhBind uint 32
global qhBindN ulong 1
global qhDirty uint 1
global qhFastMode ulong 1
global qhFastSlot ulong 1
global qhFastPos ulong 1

global qhWbf16 long 1
global qhWw4 long 1
global qhSw4 long 1
global qhRowErr long 1
global qhX long 1
global qhLogBf16 long 1
global qhLogW4 long 1
global qhCandIds long 1
global qhCandLog long 1
global qhPkt long 4
global qhPktBytes ulong 4

global qhIoBuf uchar 65536
global qhNormF32 f32 2048
global qhRowErrCpu f32 248320
global qhLogW4Cpu f32 248320
global qhLogBf16Cpu f32 248320
global qhCandCpu uint 4096

text qhHdr "=== QWEN 3.6 35B REAL-WEIGHT LM_HEAD: FULL BF16 (1.017 GB) vs W4 TWO-PASS EXACT (0.286 GB) ===\n"
text qhErr "FAIL: stage="
text qhLoaded "LOADED real outside.safetensors: lm_head.weight [248320, 2048] BF16 (1017.1 MB) + norm.weight\n"
text qhQuantOk "QUANTIZED on GB10 -> W4 block-32 (286.1 MB, 3.56x smaller) + exact L2 row_err bounds in us="
text qhTestRow "  probe #"
text qhBfId " bf16_argmax="
text qhW4Id " w4_exact_argmax="
text qhCands " cands="
text qhParOk " PARITY=EXACT\n"
text qhParBad " PARITY=MISMATCH!\n"
text qhAllPar "PASS: 8/8 real-weight probes 100% BIT-EXACT argmax parity (W4 Two-Pass Exact == Full BF16)\n"
text qhResBf "REAL_LM_HEAD_FULL_BF16_1.017GB: median_us="
text qhResW4 "REAL_LM_HEAD_W4_SCREEN_0.286GB: median_us="
text qhResTwo "REAL_LM_HEAD_W4_TWOPASS_EXACT: median_us="
text qhGbS " eff_gb_s_x10="
text qhNl "\n"
text qhUsage "usage: q36-head /path/to/outside.safetensors\n"

fn qhPrint s view uchar * to void
r = write 1 s 0 len s
end

fn qhPrintU x ulong to void
b = new uchar 24 0
pos = ulong 24
v = x
while true
pos = sub pos 1
put b pos uchar add 48 rem v 10
v = div v 10
if eq v 0
break
end
end
r = write 1 b pos sub 24 pos
end

fn qhWrite w view ulong 4 to void
p = get qhCodePos 0
b = new uchar 16 0
if gt get qhCodeMap 0 0
for i ulong 16
put b i uchar and shr get w div i 4 mul rem i 4 8 255
end
if ne mapwrite get qhCodeMap 0 p b 0 16 16
put qhCodeFail 0 1
end
end
put qhCodePos 0 add p 16
end

fn qhEmitAll to void
put qhCodePos 0 0
for i ulong 4
p = mul div add get qhCodePos 0 255 256 256
put qhEntry i p
put qhCodePos 0 p
put qhPc 0 0
put qhGuard 0 0
ok = qhKernel uchar add 97 i
if not ok
exit 4
end
qhDone
end
put qhSmem 0 8192
put qhSmem 1 0
put qhSmem 2 8192
put qhSmem 3 0
end

fn qhArg u uint to void
i = get qhBindN 0
put qhBind i u
put qhBindN 0 add i 1
end

fn qhPtr va ulong to void
qhArg gblo va
qhArg gbhi va
end

fn qhFastEmit words ulong to bool
cb = mapaddr get gbmem 1
gbdma add cb 896 uint words
for j ulong words
gbemit get qhBind j
end
q = mapaddr get gbmem 2
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
gbrel add mapaddr get gbmem 3 32 6
put qhBindN 0 0
n = get gbused 0
pos = get qhFastPos 0
if gt add pos n 65000
ret false
end
if ne mapwrite get qhPkt get qhFastSlot 0 pos gbcmd 0 n long n
ret false
end
put qhFastPos 0 add pos n
ret true
end

fn qhRecord id ulong gx uint gy uint gz uint bx uint to bool
gbqmd 1
a = add mapaddr get qhCodeMap 0 get qhEntry id
put gbq1 32 gblo shr a 4
put gbq1 33 or uint and shr a 36 2097151 20971520
put gbq1 59 gblo shr a 8
put gbq1 34 or uint 65536 bx
put gbq1 35 or uint 131073 shl uint 64 8
sm = get qhSmem id
s7 = ulong 8
if ne sm 0
s7 = div add sm 127 128
end
put gbq1 36 uint or 78923776 s7
put gbq1 37 0
put gbq1 39 gx
put gbq1 40 gy
put gbq1 41 gz
put gbcb 216 bx
put gbcb 220 gx
put gbcb 221 gy
put gbcb 222 gz
cb = mapaddr get gbmem 1
words = get qhBindN 0
endva = add cb add 896 mul words 4
put gbcb 212 gbhi endva
put gbcb 213 gblo endva
put gbused 0 0
if eq get qhFastMode 0 1
ret qhFastEmit words
end
gbsetup
if ne get qhDirty 0 0
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
put qhDirty 0 0
end
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
gbdma add cb 896 uint words
for j ulong words
gbemit get qhBind j
end
q = mapaddr get gbmem 2
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
put qhBindN 0 0
ret gbappend id get gbst 1
end

fn qhRunSingle id ulong gx uint gy uint gz uint bx uint to bool
put qhDirty 0 1
if not gbbegin 1
ret false
end
if not qhRecord id gx gy gz bx
ret false
end
ret gbbsubmit 10000000000
end

fn qhWaitFast timeout ulong to bool
t0 = monons
while lt ulong sub monons t0 timeout bound 5000000
if eq mapget get gbmem 3 16 4 1179010630
put nvret 0 get nvput 0
ret true
end
r = sleepns long 5000
end
ret false
end

fn qhReplayPkt slot ulong to bool
r = mapset get gbmem 2 8192 4 0
r = mapset get gbmem 3 0 4 0
r = mapset get gbmem 3 16 4 0
nb = get qhPktBytes slot
if not nvsend get qhPkt slot 0 uint div nb 4
ret false
end
if not qhWaitFast 15000000000
ret false
end
ret eq mapget get gbmem 3 0 4 1145324612
end

fn qhFastBegin slot ulong to bool
put qhFastMode 0 1
put qhFastSlot 0 slot
put qhFastPos 0 0
put gbused 0 0
gbsetup
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
cb = mapaddr get gbmem 1
gbdriver cb
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
n = get gbused 0
if ne mapwrite get qhPkt slot 0 gbcmd 0 n long n
ret false
end
put qhFastPos 0 n
ret true
end

fn qhFastFinish slot ulong to bool
put gbused 0 0
gbtail
n = get gbused 0
pos = get qhFastPos 0
if ne mapwrite get qhPkt slot pos gbcmd 0 n long n
ret false
end
put qhPktBytes slot add pos n
put qhFastMode 0 0
ret true
end

fn qhReadFileToMap fd int foff ulong m long bytes ulong to bool
pos = ulong 0
while lt pos bytes bound 20000
want = sub bytes pos
if gt want 65536
want = ulong 65536
end
got = pread fd qhIoBuf 0 want long add foff pos
if le got 0
ret false
end
if ne mapwrite m pos qhIoBuf 0 ulong got got
ret false
end
pos = add pos ulong got
end
ret true
end

fn qhBf16ToF32 lo uchar hi uchar to f32
bits = or shl uint hi 24 shl uint lo 16
ret bitcast f32 bits
end

fn qhLoadNorm fd int to bool
got = pread fd qhIoBuf 0 4096 long QH_NORM_OFF
if ne got 4096
ret false
end
for i ulong 2048
p = mul i 2
lo = get qhIoBuf p
hi = get qhIoBuf add p 1
v = qhBf16ToF32 lo hi
put qhNormF32 i add 1.0f32 v
end
ret true
end

fn qhLoadProbeX fd int rowIdx ulong to f32
off = add QH_EMB_OFF mul rowIdx 4096
got = pread fd qhIoBuf 0 4096 long off
if ne got 4096
ret 0.0f32
end
x = new f32 2048 0.0f32
ss = f32 0.0
for i ulong 2048
p = mul i 2
lo = get qhIoBuf p
hi = get qhIoBuf add p 1
v = qhBf16ToF32 lo hi
put x i v
ss = add ss mul v v
end
inv = f32 div 1.0f64 fsqrt add div f64 ss 2048.0f64 0.000001f64
norm2 = f32 0.0
for i ulong 2048
v = mul get x i inv
v = mul v get qhNormF32 i
norm2 = add norm2 mul v v
r = mapset get qhX 0 mul i 4 4 ulong bitcast uint v
end
ret f32 fsqrt f64 norm2
end

fn qhUnpackF32 which ulong pos ulong cnt ulong to void
for i ulong cnt bound 16384
p = mul i 4
b0 = uint get qhIoBuf p
b1 = uint get qhIoBuf add p 1
b2 = uint get qhIoBuf add p 2
b3 = uint get qhIoBuf add p 3
lo = or b0 shl b1 8
hi = or shl b2 16 shl b3 24
fv = bitcast f32 or lo hi
idx = add pos i
if eq which 0
put qhRowErrCpu idx fv
end
if eq which 1
put qhLogBf16Cpu idx fv
end
if eq which 2
put qhLogW4Cpu idx fv
end
end
end

fn qhReadF32Arr m long which ulong to bool
pos = ulong 0
while lt pos 248320 bound 20
cnt = sub 248320 pos
if gt cnt 16384
cnt = ulong 16384
end
nb = mul cnt 4
if ne mapread m mul pos 4 qhIoBuf 0 nb long nb
ret false
end
qhUnpackF32 which pos cnt
pos = add pos cnt
end
ret true
end

fn qhArgmaxBf16 to ulong
best = ulong 0
bestV = get qhLogBf16Cpu 0
for i ulong 248320
v = get qhLogBf16Cpu i
if gt v bestV
bestV = v
best = i
end
end
ret best
end

fn qhTop64W4 to ulong
used = new uchar 248320 0
for k ulong 64
best = ulong 0
bestV = f32 -1000000000.0
for i ulong 248320
if eq get used i 0
v = get qhLogW4Cpu i
if gt v bestV
bestV = v
best = i
end
end
end
put used best 1
put qhCandCpu k uint best
end
ret 64
end

fn qhSort16 t edit ulong 16 to void
for i ulong 16
for j ulong 15
if gt get t j get t add j 1
tmp = get t j
put t j get t add j 1
put t add j 1 tmp
end
end
end
end

fn qhBenchSlot slot ulong bytes ulong label view uchar * to bool
for w ulong 2
if not qhReplayPkt slot
ret false
end
end
ts = new ulong 16 0
for it ulong 16
t0 = monons
if not qhReplayPkt slot
ret false
end
t1 = monons
put ts it div ulong sub t1 t0 1000
end
qhSort16 ts
medUs = get ts 8
gbsX10 = div div bytes 100 medUs
qhPrint label
qhPrintU medUs
qhPrint qhGbS
qhPrintU gbsX10
qhPrint qhNl
ret true
end

fn qhOpenPath argIdx ulong to int
p = new uchar 512 0
n = argread argIdx p 0 511
if le n 0
ret -1
end
ret int fopen p 0 ulong n 0 0
end

fn qhRescoreTop nRun ulong to ulong
for ci ulong nRun bound 4096
r = mapset get qhCandIds 0 mul ci 4 4 ulong get qhCandCpu ci
end
qhPtr mapaddr get qhWbf16 0
qhPtr mapaddr get qhX 0
qhPtr mapaddr get qhCandIds 0
qhPtr mapaddr get qhCandLog 0
qhArg uint nRun
if not qhRunSingle 3 uint nRun 1 1 32
ret 999999
end
bestId = ulong get qhCandCpu 0
bestL = bitcast f32 uint mapget get qhCandLog 0 0 4
for ci ulong nRun bound 4096
lv = bitcast f32 uint mapget get qhCandLog 0 mul ci 4 4
if gt lv bestL
bestL = lv
bestId = ulong get qhCandCpu ci
end
end
ret bestId
end

fn qhRunProbe fd int p ulong to bool
rowId = add 100 mul p 17321
normX = qhLoadProbeX fd rowId
if not qhReplayPkt 0
ret false
end
if not qhReplayPkt 1
ret false
end
if not qhReadF32Arr get qhLogBf16 0 1
ret false
end
if not qhReadF32Arr get qhLogW4 0 2
ret false
end
bfId = qhArgmaxBf16
nc = qhTop64W4
bestId = qhRescoreTop nc
if eq bestId 999999
ret false
end
qhPrint qhTestRow
qhPrintU p
qhPrint qhBfId
qhPrintU bfId
qhPrint qhW4Id
qhPrintU bestId
qhPrint qhCands
qhPrintU nc
if eq bfId bestId
qhPrint qhParOk
ret true
end
qhPrint qhParBad
ret false
end

fn main to int
qhPrint qhHdr
if lt argcnt 2
qhPrint qhUsage
ret 1
end
fd = qhOpenPath 1
if lt fd 0
qhPrint qhErr
qhPrintU 1
qhPrint qhNl
ret 2
end
if not qhLoadNorm fd
qhPrint qhErr
qhPrintU 2
qhPrint qhNl
ret 3
end
if not gbopen 1
qhPrint qhErr
qhPrintU 3
qhPrint qhNl
ret 4
end
if not gbbopen
qhPrint qhErr
qhPrintU 4
qhPrint qhNl
ret 5
end
put qhCodeMap 0 0
qhEmitAll
csize = mul div add get qhCodePos 0 4095 4096 4096
cm = nvalloc csize false
if le cm 0
ret 6
end
put qhCodeMap 0 cm
put qhCodeFail 0 0
qhEmitAll
if ne get qhCodeFail 0 0
ret 7
end
note Allocate GPU buffers for real BF16 lm_head (1.017 GB) + W4 screen (286 MB) + bounds
put qhWbf16 0 nvalloc QH_LM_BYTES true
put qhWw4 0 nvalloc 254279680 true
put qhSw4 0 nvalloc 31784960 true
put qhRowErr 0 nvalloc 1048576 true
put qhX 0 nvalloc 8192 true
put qhLogBf16 0 nvalloc 1048576 true
put qhLogW4 0 nvalloc 1048576 true
put qhCandIds 0 nvalloc 16384 true
put qhCandLog 0 nvalloc 16384 true
for s ulong 3
put qhPkt s nvalloc 65536 true
end
if not qhReadFileToMap fd QH_DATA_OFF get qhWbf16 0 QH_LM_BYTES
qhPrint qhErr
qhPrintU 8
qhPrint qhNl
rc = nvmclose
ret 8
end
qhPrint qhLoaded
note Quantize BF16 -> W4 block-32 + exact L2 row_err on GB10!
t0 = monons
qhPtr mapaddr get qhWbf16 0
qhPtr mapaddr get qhWw4 0
qhPtr mapaddr get qhSw4 0
qhPtr mapaddr get qhRowErr 0
qhArg uint QH_VOCAB
if not qhRunSingle 1 62080 1 1 128
qhPrint qhErr
qhPrintU 9
qhPrint qhNl
rc = nvmclose
ret 9
end
t1 = monons
qhPrint qhQuantOk
qhPrintU div ulong sub t1 t0 1000
qhPrint qhNl
if not qhReadF32Arr get qhRowErr 0 0
rc = nvmclose
ret 10
end
note Record pre-recorded GPFIFO packets: slot 0 = Full BF16, slot 1 = W4 screen
if not qhFastBegin 0
rc = nvmclose
ret 11
end
qhPtr mapaddr get qhWbf16 0
qhPtr mapaddr get qhX 0
qhPtr mapaddr get qhLogBf16 0
qhArg uint QH_HIDDEN
qhArg uint QH_VOCAB
if not qhRecord 0 7760 1 1 256
rc = nvmclose
ret 11
end
if not qhFastFinish 0
rc = nvmclose
ret 11
end
if not qhFastBegin 1
rc = nvmclose
ret 12
end
qhPtr mapaddr get qhWw4 0
qhPtr mapaddr get qhSw4 0
qhPtr mapaddr get qhX 0
qhPtr mapaddr get qhLogW4 0
qhArg uint QH_VOCAB
if not qhRecord 2 7760 1 1 256
rc = nvmclose
ret 12
end
if not qhFastFinish 1
rc = nvmclose
ret 12
end
if not qhFastBegin 2
rc = nvmclose
ret 12
end
qhPtr mapaddr get qhWw4 0
qhPtr mapaddr get qhSw4 0
qhPtr mapaddr get qhX 0
qhPtr mapaddr get qhLogW4 0
qhArg uint QH_VOCAB
if not qhRecord 2 7760 1 1 256
rc = nvmclose
ret 12
end
qhPtr mapaddr get qhWbf16 0
qhPtr mapaddr get qhX 0
qhPtr mapaddr get qhCandIds 0
qhPtr mapaddr get qhCandLog 0
qhArg 64
if not qhRecord 3 64 1 1 32
rc = nvmclose
ret 12
end
if not qhFastFinish 2
rc = nvmclose
ret 12
end
note Verify BIT-EXACT argmax parity across 8 real embedding probes!
allOk = true
for p ulong 8
if not qhRunProbe fd p
allOk = false
end
end
if allOk
qhPrint qhAllPar
end
note Timed benchmarks on real Qwen 3.6 35B lm_head weights (16 iters median)
if not qhBenchSlot 0 QH_LM_BYTES qhResBf
rc = nvmclose
ret 19
end
if not qhBenchSlot 1 286064640 qhResW4
rc = nvmclose
ret 20
end
if not qhBenchSlot 2 286326784 qhResTwo
rc = nvmclose
ret 21
end
if not allOk
rc = nvmclose
ret 18
end
rc = nvmclose
ret 0
end

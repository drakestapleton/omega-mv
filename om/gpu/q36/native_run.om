end
put qLmFp8 0 m
if not qFillPattern m 508559360 0x30303030
ret false
end
m = nvalloc 131072 true
if le m 0
ret false
end
put qLmFp8S 0 m
if not qFillPattern m 131072 0x3b800000
ret false
end
note BF16 lm_head [248320, 2048] = 1,017,118,720 B
m = nvalloc 1017118720 true

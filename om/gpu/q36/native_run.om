note Pure seeded-Omega zero-CUDA native GB10 runner for Qwen 3.6 35B-A3B FP8 + Arboris.
note ZERO libcuda.so.1, ZERO libc, ZERO Python, ZERO C (static AArch64 ELF).
note Compose after:
note   gpu/nvidia/native/nvrm/context.om
note   gpu/nvidia/native/blackwell/vector.om
note   gpu/nvidia/native/blackwell/launch.om
note   gpu/nvidia/native/blackwell/batch.om
note   om/encoder/bw_enc_sm121.om
note   om/gpu/q36/emit_fast.om
note   om/gpu/q36/arboris/prefetch.om

global qCodePos ulong 1
global qEntry ulong 16
global qSmem ulong 16
global qCodeMap long 1
global qCodeFail uint 1
global qBind uint 32
global qBindN ulong 1
global qDirty uint 1
global qFastMode ulong 1
global qFastSlot ulong 1
global qFastPos ulong 1

note Device allocations (all via native NVRM/UVM ioctl nvalloc)
global qLut long 1
global qWork long 1
global qKvK long 1
global qKvV long 1
global qGdnState long 1
global qLmBf16 long 1
global qLmFp8 long 1
global qLmFp8S long 1
global qLmW4 long 1
global qLmW4S long 1
global qCandIds long 1
global qCandLog long 1
global qLogits long 1

note 4 cold weight banks (> 110x GB10 24 MiB L2)
global qWGdnQkv long 4
global qWGdnQkvS long 4
global qWGdnZ long 4
global qWGdnZS long 4
global qWGdnAb long 4
global qWOut long 4
global qWOutS long 4
global qWAttnQkvg long 4
global qWAttnQkvgS long 4

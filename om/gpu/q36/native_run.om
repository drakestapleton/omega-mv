if not qFillPattern m 1048576 0x30303030
ret false
end
m = nvalloc 4096 true
if le m 0
ret false
end
put qWShDnS b m
if not qFillPattern m 4096 0x3b800000
ret false
end
end
note 30 GDN BF16 states: 30 x 32 x 128 x 128 x 2B = 30 MiB
m = nvalloc 31457280 true
if le m 0
ret false
end
put qGdnState 0 m
if not qFillPattern m 31457280 0
ret false
end
note Full-Attn BF16 KV (T=1024, 2 KV heads, hd=256): 1 MiB K + 1 MiB V
m = nvalloc 1048576 true
if le m 0
ret false
end

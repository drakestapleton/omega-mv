note W4 Routed Experts share the 4 cold banks (zero extra nvalloc slots!): gu at +0 (256 MiB), guS at +256 MiB (32 MiB)
note dn at +0 (128 MiB), dnS at +128 MiB (16 MiB)
put qW4ExpGu b get qWExpGu b
put qW4ExpDn b get qWExpDn b
note Shared Expert: gu[1024,2048] = 2 MiB, dn[2048,512] = 1 MiB
m = nvalloc 2097152 true
if le m 0
ret false
end
put qWShGu b m
if not qFillPattern m 2097152 0x30303030
ret false
end
m = nvalloc 4096 true
if le m 0
ret false
end
put qWShGuS b m
if not qFillPattern m 4096 0x3b800000
ret false
end
m = nvalloc 1048576 true
if le m 0
ret false
end

if not qFillPattern m 31784960 0x3c003c00
ret false
end
m = nvalloc 4096 true
if le m 0
ret false
end
put qCandIds 0 m
for ci ulong 64
r = mapset m mul ci 4 4 mul ci 17
end
m = nvalloc 4096 true
if le m 0
ret false
end
put qCandLog 0 m
note 4 GPFIFO command packet buffers (2 MiB each)
for s ulong 4
m = nvalloc 2097152 true
if le m 0
ret false
end
put qPkt s m
end
ret true
end

fn qInitWork to bool
wk = get qWork 0
for i ulong 2048
r = mapset wk mul i 4 4 0x3dcccccd
r = mapset wk add 0x004000 mul i 4 4 0x3dcccccd
r = mapset wk add 0x008000 mul i 4 4 0x3f800000
end
ret true
end

fn qSortTimes t edit ulong 16 to void
for i ulong 16
for j ulong 15
if gt get t j get t add j 1
tmp = get t j
put t j get t add j 1
put t add j 1 tmp
end
end
end
end

fn qBenchConfig slot ulong labelMode ulong to bool
for w ulong 2
if not qReplayPkt slot
ret false
end
end
ts = new ulong 16 0
for it ulong 16
t0 = monons
if not qReplayPkt slot
ret false
end
t1 = monons
put ts it div ulong sub t1 t0 1000
end
qSortTimes ts
medUs = get ts 8
tokSx100 = div 100000000 medUs
if eq labelMode 0
qPrint qRes0
end
if eq labelMode 1
qPrint qRes1
end
if eq labelMode 2
qPrint qRes2
end
if eq labelMode 3
qPrint qRes3
end
qPrintU medUs
qPrint qTokS
qPrintU tokSx100
for i ulong 2048
if not qIsFiniteU32 mapget get qWork 0 mul i 4 4
qPrint qFinBad
ret false
end
end
if gt labelMode 0
for i ulong 1024
if not qIsFiniteU32 mapget get qLogits 0 mul i 4 4
qPrint qFinBad
ret false
end
end
end
qPrint qFinOk
ret true
end

fn qFillIds ids edit uint 8 l ulong tok ulong to void
t = rem tok 4
for k ulong 8
v = add mul l 7 mul k 13
v = rem add v t 256
put ids k uint v
end
end

fn qBenchArbTok tok ulong to void
ids = new uint 8 0
pr = new uint 8 0
q36ArbResetToken
for l ulong 40
qFillIds ids l tok
if gt l 0
put q36ArbHits 0 add get q36ArbHits 0 q36ArbScorePred pr 8 ids
put q36ArbTotal 0 add get q36ArbTotal 0 8
end
q36ArbObserve l ids
if lt l 39
n = q36ArbPredict l ids 8 pr
end
end
end

fn qBenchArboris40L to void
q36ArbResetAll
t0 = monons
for tok ulong 64
qBenchArbTok tok
end
t1 = monons
usPerTok = div ulong sub t1 t0 64000
hitPct = div mul get q36ArbHits 0 100 get q36ArbTotal 0
qPrint qArbRes
qPrintU usPerTok
qPrint qArbHit
qPrintU hitPct
qPrint qNl
end

fn main to int
qPrint qHdr
if not q36ArbSelfTest
qPrint qArbFail
ret 1
end
qPrint qArbOk
if not gbopen 1
qPrint qOpenErr
qPrintU ulong get nvstage 0
qPrint qNl
ret 2
end
if not gbbopen
qPrint qOpenErr
qPrintU ulong get nvstage 0
qPrint qNl
ret 3
end
put qCodeMap 0 0
qEmitAll
csize = mul div add get qCodePos 0 4095 4096 4096
cm = nvalloc csize false
if le cm 0
qPrint qOpenErr
qPrintU ulong get nvstage 0
qPrint qNl
ret 4
end
put qCodeMap 0 cm
put qCodeFail 0 0
qEmitAll
if ne get qCodeFail 0 0
ret 5
end
lm = nvalloc 4096 true
if le lm 0
ret 6
end
put qLut 0 lm
if not qWriteLut lm
ret 7
end
wm = nvalloc 16777216 true
if le wm 0
ret 8
end
put qWork 0 wm
if not qSelfTest
rc = nvmclose
ret 10
end
if not qAllocModel
qPrint qOpenErr
qPrintU ulong get nvstage 0
qPrint qNl
rc = nvmclose
ret 11
end
if not qInitWork
rc = nvmclose
ret 12
end
for slot ulong 4
if not qRecordAll40 slot slot
qPrint qSubErr
qPrintU ulong get gbst 4
qPrint qNl
rc = nvmclose
ret 13
end
end
for slot ulong 4
if not qBenchConfig slot slot
rc = nvmclose
ret 14
end
end
qBenchArboris40L
rc = nvmclose
ret 0
end

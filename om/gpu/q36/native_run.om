note Fused MoE combine + shared + residual + next-layer RMSNorm (D=2048)
qPtr qW 0x0a0000
qPtr qW 0x0b2000
qPtr qW 0x000000
qPtr qW 0x008000
qPtr qW 0x000000
qPtr qW 0x004000
if not qRecord 5 1 1 1 256
ret false
end
ret true
end

fn qRecordAll40 slot ulong headMode ulong to bool
put qFastMode 0 1
put qFastSlot 0 slot
put qFastPos 0 0
put gbused 0 0
gbsetup
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
cb = mapaddr get gbmem 1
gbdriver cb
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
n = get gbused 0
if ne mapwrite get qPkt slot 0 gbcmd 0 n long n
ret false
end
put qFastPos 0 n
useW4 = ge headMode 2
for l ulong 40
bk = rem l 4
if not qRecordLayer l bk useW4
put qFastMode 0 0
ret false
end
end
lutva = mapaddr get qLut 0
if or eq headMode 1 eq headMode 3
note W4 block-32 two-pass exact lm_head: 0.286 GB W4 screen + Top-64 exact BF16 rescore!
qPtr mapaddr get qLmW4 0
qPtr mapaddr get qLmW4S 0
qPtr qW 0x004000
qPtr mapaddr get qLogits 0
qArg 248320
if not qRecord 9 7760 1 1 256
put qFastMode 0 0
ret false
end
qPtr mapaddr get qLmBf16 0
qPtr qW 0x004000
qPtr mapaddr get qCandIds 0
qPtr mapaddr get qCandLog 0
qArg 64
if not qRecord 10 64 1 1 32
put qFastMode 0 0
ret false
end
end
put gbused 0 0
gbtail
n = get gbused 0
pos = get qFastPos 0
if ne mapwrite get qPkt slot pos gbcmd 0 n long n
put qFastMode 0 0
ret false
end
put qPktBytes slot add pos n
put qFastMode 0 0
ret true
end

fn qAllocModel to bool
for b ulong 4
note GDN fused in_proj_qkvz[12288,2048] = 24 MiB, S[96,16] = 8 KiB
m = nvalloc 25165824 true

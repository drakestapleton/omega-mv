ret false
end
put qLmBf16 0 m
if not qFillPattern m 1017118720 0x3c003c00
ret false
end
note Logits [248320] = 993,280 B -> 1 MiB
m = nvalloc 1048576 true
if le m 0
ret false
end
put qLogits 0 m
note W4 block-32 lm_head [248320, 256] u32 = 254,279,680 B + scales [248320, 32] u32 = 31,784,960 B
m = nvalloc 254279680 true
if le m 0
ret false
end
put qLmW4 0 m
if not qFillPattern m 254279680 0x99999999
ret false
end

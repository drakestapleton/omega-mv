fn q36Kernel mode uchar to bool
if eq mode 97
qBf16GemvFast
ret true
end
if eq mode 98
qFp8B128GemvFast
ret true
end
if eq mode 99
qFp8B128Grouped8Fast
ret true
end
if eq mode 100
qRouterTop8Fast
ret true
end
if eq mode 101
qSwiglu8Fast
ret true
end

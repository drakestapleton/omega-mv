note SPDX-License-Identifier: AGPL-3.0-only
note Qwen 3.6 35B-A3B FP8 high-speed SM121 SASS emitter (pipelined scoreboards, LDG.E.128/64,
note SMEM x + LUT staging, block-128x128 FP8 GEMV & grouped-8 MoE, BF16 GDN state, Split-K HD256 attn).
note Compose after om/encoder/bw_enc_sm121.om.
const QZ ulong 255
global q36Pc ulong 1
global q36Guard ulong 1
global q36Buf ulong 16384

fn qcw st ulong wb ulong rbar ulong wt ulong yld ulong to ulong
a = or shl st 9 shl yld 13
b = or shl wb 14 shl rbar 17
ret or or a b shl wt 20
end

fn qAlu1 to ulong
ret qcw 2 7 7 0 0
end
fn qAlu3 to ulong
ret qcw 3 7 7 0 0
end
fn qAlu4 to ulong
ret qcw 6 7 7 0 0
end
fn qCmp to ulong
ret qcw 14 7 7 0 0
end
fn qLd to ulong
ret qcw 2 0 1 0 1
end
fn qLdW1 to ulong
ret qcw 2 0 1 2 1
end
fn qLdB2 to ulong
ret qcw 2 2 1 0 1
end
fn qSt to ulong
ret qcw 4 7 1 0 1
end
fn qW0 to ulong
ret qcw 6 7 7 1 0
end
fn qW1 to ulong
ret qcw 6 7 7 2 0
end
fn qW2 to ulong
ret qcw 6 7 7 4 0
end
fn qWall to ulong
ret qcw 6 7 7 7 0
end
fn qShfl to ulong
ret qcw 4 0 7 0 1
end
fn qMufu to ulong
ret qcw 4 0 7 0 1
end
fn qSafe to ulong
ret qcw 6 7 7 7 0
end

fn qEmitRaw o edit ulong 16 atPc ulong to void
w = new ulong 4 0
op = get o 0
native = op
if or eq op 65 eq op 66
native = ulong 61
end
if or eq op 67 eq op 68
native = ulong 12
end
if or eq op 69 eq op 70
native = ulong 40
end
put o 0 native
if ne get q36Guard 0 0
put o 9 1
end
if eq get q36Guard 0 2
put o 10 1
end
put q36Guard 0 0
if ne get o 2 QZ
put o 12 1
end
if ne get o 3 QZ
put o 13 1
end
if ne enc1 o w 0
exit 3
end
if eq op 65
put w 2 0x048070ff
end
if eq op 66
put w 2 0x042070ff
end
if eq op 67
put w 2 sub get w 2 0x800
end
if eq op 68
put w 2 sub get w 2 0x400
end
if eq op 69
put w 2 0xc00
end
if eq op 70
put w 2 0x2000
end
base = mul atPc 4
for i ulong 4
put q36Buf add base i get w i
end
end

fn qic op ulong dst ulong a ulong b ulong imm ulong ctrl ulong to void
o = new ulong 16 0
put o 0 op
put o 1 dst
put o 2 a
put o 3 b
put o 4 QZ
put o 5 4
put o 6 and imm 0xffffffff
put o 7 ctrl
pc = get q36Pc 0
qEmitRaw o pc
put q36Pc 0 add pc 1
end

fn qic4 op ulong dst ulong a ulong b ulong c ulong ctrl ulong to void
o = new ulong 16 0
put o 0 op
put o 1 dst
put o 2 a
put o 3 b
put o 4 c
put o 5 4
put o 6 0
put o 7 ctrl
pc = get q36Pc 0
qEmitRaw o pc
put q36Pc 0 add pc 1
end

fn qicImm op ulong dst ulong a ulong c ulong imm ulong ctrl ulong to void
o = new ulong 16 0
put o 0 op
put o 1 dst
put o 2 a
put o 3 QZ
put o 4 c
put o 5 4
put o 6 and imm 0xffffffff
put o 7 ctrl
pc = get q36Pc 0
qEmitRaw o pc
put q36Pc 0 add pc 1
end

fn qBraFwd gd ulong to ulong
pos = get q36Pc 0
put q36Guard 0 gd
qic 46 QZ QZ QZ 0 qAlu4
ret pos
end

fn qPatch pos ulong gd ulong to void
o = new ulong 16 0
put o 0 46
put o 1 QZ
put o 2 QZ
put o 3 QZ
put o 4 QZ
put o 5 4
put o 6 and sub get q36Pc 0 pos 0xffffffff
put o 7 qAlu4
put q36Guard 0 gd
qEmitRaw o pos
end

fn qBssy to ulong
pos = get q36Pc 0
qic 54 QZ QZ QZ 2 qSafe
ret pos
end

fn qBsync bpos ulong to void
qic 55 QZ QZ QZ 0 qSafe
o = new ulong 16 0
put o 0 54
put o 1 QZ
put o 2 QZ
put o 3 QZ
put o 4 QZ
put o 5 4
put o 6 and sub get q36Pc 0 bpos 0xffffffff
put o 7 qSafe
qEmitRaw o bpos
end

fn qLit d ulong x ulong to void
qic 2 d QZ QZ x qAlu4
end

fn qNum d ulong x f32 to void
qLit d ulong bitcast uint x
end

fn qMad d ulong a ulong s ulong c ulong to void
qicImm 8 d a c s qAlu4
end

fn qMadReg d ulong a ulong b ulong c ulong to void
qic4 8 d a b c qAlu4
end

fn qIadd d ulong a ulong b ulong to void
qic 14 d a b 0 qAlu4
end

fn qParam d ulong off ulong to void
qic 4 d QZ QZ add 896 off qcw 4 0 7 0 1
qic 0 QZ QZ QZ 0 qW0
end

fn qStart ptrs ulong to void
qic 7 4 QZ QZ 856 qcw 4 2 7 0 1
for i ulong ptrs
qic 5 mul i 2 QZ QZ add 896 mul i 8 qcw 4 0 7 0 1
end
qic 3 14 QZ QZ 33 qcw 4 0 7 0 1
qic 3 15 QZ QZ 37 qcw 4 0 7 0 1
qic 3 18 QZ QZ 38 qcw 4 0 7 0 1
qic 3 19 QZ QZ 39 qcw 4 0 7 0 1
qic 0 QZ QZ QZ 0 qWall
end

fn qBar to void
qic 0 QZ QZ QZ 0 qWall
qic 48 QZ QZ QZ 0 qSafe
end

fn qWarpRedSum acc ulong tmp ulong startDelta ulong to void
d = startDelta
while ge d 1 bound 5
qic 42 tmp acc QZ d qShfl
qic 30 acc acc tmp 0 qW0
d = shr d 1
end
end

fn qWarpBflySum acc ulong tmp ulong to void
d = ulong 16
while ge d 1 bound 5
qic 60 tmp acc QZ d qShfl
qic 30 acc acc tmp 0 qW0
d = shr d 1
end
end

fn qWarpBflyMax acc ulong tmp ulong to void
d = ulong 16
while ge d 1 bound 5
qic 60 tmp acc QZ d qShfl
qic 37 acc acc tmp 0 qW0
d = shr d 1
end
end

fn qExp d ulong a ulong l2e ulong to void
qic 32 d a l2e 0 qAlu4
qic 47 d d QZ 0 qMufu
qic 0 QZ QZ QZ 0 qW0
end

fn qSig d ulong a ulong nl2e ulong one ulong to void
qExp d a nl2e
qic 30 d d one 0 qAlu4
qic 40 d d QZ 0 qMufu
qic 0 QZ QZ QZ 0 qW0
end

fn q36Done to void
qic 0 QZ QZ QZ 0 qWall
qic 45 QZ QZ QZ 0 qSafe
while or lt get q36Pc 0 32 ne rem get q36Pc 0 8 0 bound 2048
qic 0 QZ QZ QZ 0 qSafe
end
w = new ulong 4 0
cnt = get q36Pc 0
for i ulong cnt bound 2048
base = mul i 4
for j ulong 4
put w j get q36Buf add base j
end
q36Write w
end
end

note =========================================================================
note a (0): bf16_gemv_fast -- packed BF16 streaming GEMV (LDG.E.128, SMEM x, 32 rows/CTA)
note Args: W_bf16[N,K] (R0:1), x[K] (R2:3), y[N] (R4:5), K (24), N (28).
note Grid: (ceil(N/32), 1, 1), Block: 256, SMEM: 16384 (K <= 4096, K % 256 == 0).
note =========================================================================
fn qBf16MacWord wBase ulong xLo ulong xHi ulong to void
for r ulong 4
qicImm 8 add 52 r add wBase mul r 4 QZ 65536 qAlu1
end
qic 0 QZ QZ QZ 0 qAlu1
for r ulong 4
qic4 33 add 48 r add 52 r xLo add 48 r qAlu1
end
for r ulong 4
qic 18 add 52 r add wBase mul r 4 QZ 0xffff0000 qAlu1
end
qic 0 QZ QZ QZ 0 qAlu1
for r ulong 4
qic4 33 add 48 r add 52 r xHi add 48 r qAlu1
end
end

fn qBf16GemvFast to void
qStart 3
qParam 6 24
qParam 7 28
qLit 56 0
qLit 57 256
mStage = get q36Pc 0
qIadd 52 56 14
qicImm 9 16 52 2 4 qW1
qic 11 53 16 QZ 0 qLd
qMad 54 52 4 QZ
qic 0 QZ QZ QZ 0 qW0
qic 50 QZ 54 53 0 qSt
qic 0 QZ QZ QZ 0 qW1
qIadd 56 56 57
qic 28 QZ 56 6 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mStage get q36Pc 0 qAlu4
qBar
qic 17 10 14 QZ 5 qAlu4
qic 18 11 14 QZ 31 qAlu4
qMad 8 15 32 QZ
qMad 8 10 4 8
qMad 9 6 2 QZ
qLit 59 0xffffffff
qIadd 59 7 59
qMad 55 11 16 QZ
for r ulong 4
qLit 52 r
qIadd 52 8 52
qic 28 QZ 52 7 0 qCmp
put q36Guard 0 1
qMad 52 59 1 QZ
qMadReg 53 52 9 55
qicImm 9 add 16 mul r 2 53 0 1 qAlu4
end
qMad 12 11 32 QZ
qic 17 13 6 QZ 8 qAlu4
for r ulong 4
qNum add 48 r 0.0f32
end
qLit 56 0
qLit 57 1
qLit 58 1024
mLoop = get q36Pc 0
qic 57 24 16 QZ 0 qLdW1
qic 57 28 18 QZ 0 qLd
qic 57 32 20 QZ 0 qLd
qic 57 36 22 QZ 0 qLd
qic 58 40 12 QZ 0 qLd
qic 58 44 12 QZ 16 qLd
qic 0 QZ QZ QZ 0 qW0
qBf16MacWord 24 40 41
qBf16MacWord 25 42 43
qBf16MacWord 26 44 45
qBf16MacWord 27 46 47
qic 0 QZ QZ QZ 0 qW1
for r ulong 4
qicImm 9 add 16 mul r 2 57 add 16 mul r 2 512 qAlu1
end
qic 14 12 12 58 0 qAlu1
qic 14 56 56 57 0 qAlu4
qic 28 QZ 56 13 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mLoop get q36Pc 0 qAlu4
for r ulong 4
qWarpRedSum add 48 r 52 16
end
qLit 57 1
qic 28 QZ 11 57 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
for r ulong 4
qLit 52 r
qIadd 52 8 52
qic 28 QZ 52 7 0 qCmp
sk = qBraFwd 1
qicImm 9 16 52 4 4 qAlu4
qic 12 QZ 16 add 48 r 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch sk 1
end
end

note =========================================================================
note Shared FP8 E4M3FN 8-byte batched LUT MAC helper (used by b & c)
note Unpacks 4 bytes from w0 (row 0) + 4 bytes from w1 (row 1), 8x LDS from SMEM[0..1023],
note accumulates into R50 (row 0) and R51 (row 1).
note =========================================================================
fn qFp8QuadMac w0 ulong w1 ulong xBase ulong to void
qic 18 0 w0 QZ 255 qAlu1
qic 18 4 w1 QZ 255 qAlu1
for j ulong 3
bIdx = add j 1
sh = mul bIdx 8
qic 17 bIdx w0 QZ sh qAlu1
qic 17 add 4 bIdx w1 QZ sh qAlu1
end
for j ulong 3
bIdx = add j 1
qic 18 bIdx bIdx QZ 255 qAlu1
qic 18 add 4 bIdx add 4 bIdx QZ 255 qAlu1
end
for i ulong 8
qicImm 8 i i QZ 4 qAlu1
end
qic 49 8 0 QZ 0 qLd
qic 49 9 1 QZ 0 qLd
qic 49 22 2 QZ 0 qLd
qic 49 52 3 QZ 0 qLd
qic 49 53 4 QZ 0 qLd
qic 49 54 5 QZ 0 qLd
qic 49 55 6 QZ 0 qLd
qic 49 56 7 QZ 0 qLd
qic 0 QZ QZ QZ 0 qW0
qic4 33 50 8 xBase 50 qAlu3
qic4 33 51 53 xBase 51 qAlu3
qic4 33 50 9 add xBase 1 50 qAlu3
qic4 33 51 54 add xBase 1 51 qAlu3
qic4 33 50 22 add xBase 2 50 qAlu3
qic4 33 51 55 add xBase 2 51 qAlu3
qic4 33 50 52 add xBase 3 50 qAlu3
qic4 33 51 56 add xBase 3 51 qAlu3
end

note =========================================================================
note b (1): fp8_b128_gemv_fast -- streaming FP8 E4M3FN block-128x128 GEMV
note Args: x[K] (R0:1), W_fp8[N,K] (R2:3), S_f32[N/128,K/128] (R4:5), lut[256] (R6:7), C[N] (R8:9), K (40), N (44).
note Grid: (ceil(N/32), 1, 1), Block: 256, SMEM: 17472 (1088 LUT + 16384 x). K % 128 == 0, K <= 4096.
note Half-warp (16 lanes) x 8 weights/lane = 128 elements = 1 exact block-128 scale per iteration!
note =========================================================================
fn qFp8B128GemvFast to void
qStart 5
qParam 20 40
qParam 21 44
note Stage 256-entry LUT into SMEM[0..1023]
qicImm 9 16 14 6 4 qW1
qic 11 52 16 QZ 0 qLd
qMad 53 14 4 QZ
qic 0 QZ QZ QZ 0 qW0
qic 50 QZ 53 52 0 qSt
qic 0 QZ QZ QZ 0 qW1
note Stage x[K] into SMEM[1088 .. 1088 + 4*K]
qLit 56 0
qLit 57 256
qLit 58 1088
mSx = get q36Pc 0
qIadd 52 56 14
bX = qBssy
qic 28 QZ 52 20 0 qCmp
skX = qBraFwd 1
qicImm 9 16 52 0 4 qW1
qic 11 54 16 QZ 0 qLd
qMad 53 52 4 58
qic 0 QZ QZ QZ 0 qW0
qic 50 QZ 53 54 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch skX 1
qBsync bX
qIadd 56 56 57
qic 28 QZ 56 20 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mSx get q36Pc 0 qAlu4
qBar
note Half-warp geometry: hw = tid >> 4 (0..15), lane = tid & 15 (0..15)
note row0 = blockIdx.x * 32 + hw * 2; row1 = row0 + 1
qic 17 52 14 QZ 4 qAlu4
qic 18 39 14 QZ 15 qAlu4
qMad 36 15 32 QZ
qMad 36 52 2 36
qLit 59 0xffffffff
qIadd 59 21 59
note kBlocks = K >> 7 (R13)
qic 17 13 20 QZ 7 qAlu4
qMad 58 39 8 QZ
note Row 0 pointer (R24:25) & scale pointer (R28:29)
qMad 52 36 1 QZ
qic 28 QZ 52 21 0 qCmp
put q36Guard 0 1
qMad 52 59 1 QZ
qMadReg 32 52 20 58
qicImm 9 24 32 2 1 qAlu4
qic 17 35 52 QZ 7 qAlu4
qMadReg 32 35 13 QZ
qicImm 9 28 32 4 4 qAlu4
note Row 1 pointer (R26:27) & scale pointer (R30:31)
qLit 52 1
qIadd 52 36 52
qic 28 QZ 52 21 0 qCmp
put q36Guard 0 1
qMad 52 59 1 QZ
qMadReg 32 52 20 58
qicImm 9 26 32 2 1 qAlu4
qic 17 35 52 QZ 7 qAlu4
qMadReg 32 35 13 QZ
qicImm 9 30 32 4 4 qAlu4
note Save C output pointer R8:9 -> R10:11 before qFp8QuadMac clobbers R0..R9
qicImm 8 10 8 QZ 1 qAlu1
qicImm 8 11 9 QZ 1 qAlu4
note SMEM x offset = 1088 + lane * 32 (R32)
qLit 59 1088
qMad 32 39 32 59
qNum 48 0.0f32
qNum 49 0.0f32
qLit 58 512
qLit 57 1
qLit 34 0
mLoop = get q36Pc 0
qic 56 16 24 QZ 0 qLdW1
qic 56 52 26 QZ 0 qLd
qic 11 35 28 QZ 0 qLd
qic 11 37 30 QZ 0 qLd
qic 58 40 32 QZ 0 qLd
qic 58 44 32 QZ 16 qLd
qic 0 QZ QZ QZ 0 qW0
qicImm 8 60 16 QZ 1 qAlu1
qicImm 8 61 17 QZ 1 qAlu1
qicImm 8 59 52 QZ 1 qAlu1
qicImm 8 38 53 QZ 1 qAlu1
qNum 50 0.0f32
qNum 51 0.0f32
qFp8QuadMac 60 59 40
qFp8QuadMac 61 38 44
qic4 33 48 50 35 48 qAlu3
qic4 33 49 51 37 49 qAlu4
qic 0 QZ QZ QZ 0 qW1
qicImm 9 24 57 24 128 qAlu1
qicImm 9 26 57 26 128 qAlu1
qicImm 9 28 57 28 4 qAlu1
qicImm 9 30 57 30 4 qAlu1
qic 14 32 32 58 0 qAlu1
qic 14 34 34 57 0 qAlu4
qic 28 QZ 34 13 0 qCmp
put q36Guard 0 2
qic 46 QZ QZ QZ sub mLoop get q36Pc 0 qAlu4
qWarpRedSum 48 52 8
qWarpRedSum 49 52 8
qLit 57 1
qic 28 QZ 39 57 0 qCmp
put q36Guard 0 1
qic 45 QZ QZ QZ 0 qSafe
qic 28 QZ 36 21 0 qCmp
sk0 = qBraFwd 1
qicImm 9 16 36 10 4 qAlu4
qic 12 QZ 16 48 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch sk0 1
qLit 52 1
qIadd 36 36 52
qic 28 QZ 36 21 0 qCmp
sk1 = qBraFwd 1
qicImm 9 16 36 10 4 qAlu4
qic 12 QZ 16 49 0 qSt
qic 0 QZ QZ QZ 0 qW1
qPatch sk1 1
end


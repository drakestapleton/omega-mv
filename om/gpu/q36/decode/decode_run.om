fn qdPrint s view uchar * to void
r = write 1 s 0 len s
end

fn qdPrintU x ulong to void
b = new uchar 24 0
pos = ulong 24
v = x
while true
pos = sub pos 1
put b pos uchar add 48 rem v 10
v = div v 10
if eq v 0
break
end
end
r = write 1 b pos sub 24 pos
end

fn qdPrintHex x uint to void
b = new uchar 10 0
put b 0 48
put b 1 120
for i ulong 8
nib = and shr x mul sub 7 i 4 15
c = uchar add 48 nib
if ge nib 10
c = uchar add 87 nib
end
put b add 2 i c
end
r = write 1 b 0 10
end

fn q36Write w view ulong 4 to void
p = get qdCodePos 0
b = new uchar 16 0
if gt get qdCodeMap 0 0
for i ulong 16
put b i uchar and shr get w div i 4 mul rem i 4 8 255
end
if ne mapwrite get qdCodeMap 0 p b 0 16 16
put qdCodeFail 0 1
end
end
put qdCodePos 0 add p 16
end

fn qhWrite w view ulong 4 to void
q36Write w
end


ret false
end
bfId = ulong 0
bfMax = get qdLogBf 0
for v ulong QD_VOCAB
if gt get qdLogBf v bfMax
bfMax = get qdLogBf v
bfId = v
end
end
if eq bfId bestId
qdPrint qdMsgParOk
qdPrintU bestId
qdPrint qdMsgRp
else
qdPrint qdMsgParBad
qdPrintU bfId
qdPrint qdMsgEq
qdPrintU bestId
qdPrint qdMsgRp
end
ret true
end

fn qdReadCandIds to bool
if ne mapread get qdWork 0 QDW_CIDS qdIoBuf 0 512 512
ret false
end
for j ulong 128
p = mul j 4
b0 = uint get qdIoBuf p
b1 = shl uint get qdIoBuf add p 1 8
b2 = shl uint get qdIoBuf add p 2 16
b3 = shl uint get qdIoBuf add p 3 24
put qdCandIds j or or b0 b1 or b2 b3
end
ret true
end

fn qdRunLmHead checkParity bool to ulong
note Single-submit 4-kernel final_norm + W4 Two-Pass Exact lm_head!

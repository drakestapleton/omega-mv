note =========================================================================
note Pure OM-2 FP32 math helpers (sqrt, exp, log, cos, sin, bf16)
note =========================================================================
fn qdSqrt x f32 to f32
if le x 0.0f32
ret 0.0f32
end
bits = bitcast uint x
gbits = add 0x1fc00000 shr bits 1
y = bitcast f32 gbits
for i ulong 5
y = mul 0.5f32 add y div x y
end
ret y
end

fn qdExp x f32 to f32
v = x
if gt v 80.0f32
v = f32 80.0f32
end
if lt v neg 80.0f32
ret 0.0f32
end
note x = k * ln(2) + r, |r| <= 0.35
kf = mul v 1.44269504f32
ki = int 0
if ge kf 0.0f32
ki = int add kf 0.5f32
else
ki = int sub kf 0.5f32
end
r = sub v mul f32 ki 0.69314718f32
p = f32 1.0f32
p = add 1.0f32 mul r mul p 0.16666667f32
p = add 1.0f32 mul r mul p 0.2f32
p = add 1.0f32 mul r mul p 0.25f32
p = add 1.0f32 mul r mul p 0.33333333f32
p = add 1.0f32 mul r mul p 0.5f32
p = add 1.0f32 mul r p
eb = shl uint add ki 127 23
ret mul p bitcast f32 eb
end

fn qdLog x f32 to f32
if le x 0.0f32
ret neg 80.0f32
end
bits = bitcast uint x
e = sub int and shr bits 23 255 127
mbits = or and bits 0x007fffff 0x3f800000
m = bitcast f32 mbits
if gt m 1.41421356f32
m = mul m 0.5f32
e = add e 1
end
t = div sub m 1.0f32 add m 1.0f32
t2 = mul t t
s = add 0.14285714f32 mul t2 0.11111111f32
s = add 0.2f32 mul t2 s
s = add 0.33333333f32 mul t2 s
s = add 1.0f32 mul t2 s
ret add mul f32 e 0.69314718f32 mul 2.0f32 mul t s
end

fn qdSigmoid x f32 to f32
if ge x 0.0f32
e = qdExp neg x
ret div 1.0f32 add 1.0f32 e
end
e = qdExp x
ret div e add 1.0f32 e
end

fn qdSilu x f32 to f32
ret mul x qdSigmoid x
end

fn qdSoftplus x f32 to f32
if gt x 20.0f32
ret x
end
if lt x neg 20.0f32
ret qdExp x
end
ret qdLog add 1.0f32 qdExp x
end

fn qdSinCos theta f32 isCos bool to f32
note Reduce theta to [-pi, pi]
inv2pi = f32 0.15915494f32
twopi = f32 6.28318531f32
pi = f32 3.14159265f32
hp = f32 1.57079633f32
k = mul theta inv2pi
ki = int 0
if ge k 0.0f32
ki = int add k 0.5f32
else
ki = int sub k 0.5f32
end
x = sub theta mul f32 ki twopi
if isCos
x = add x hp
if gt x pi
x = sub x twopi
end
end
sgn = f32 1.0f32
if gt x hp
x = sub pi x
end
if lt x neg hp
x = sub neg pi x
end
x2 = mul x x
r = sub 1.0f32 mul x2 0.0001984127f32
r = sub 1.0f32 mul x2 mul 0.0083333333f32 r
r = sub 1.0f32 mul x2 mul 0.0416666667f32 r
r = sub 1.0f32 mul x2 mul 0.1666666667f32 r
ret mul sgn mul x r
end

fn qdInitRopeFreq to void
note inv_freq[j] = exp(-2*j/64 * ln(10000000.0))
lnTheta = f32 16.11809565f32
for j ulong 32
e = div mul f32 mul j 2 lnTheta 64.0f32
put qdRopeFreq j qdExp neg e
end
end

note Compute lexicographic rank in 0..255 for expert id e in 0..255
fn qdLexLess a ulong b ulong to bool
sa = new uchar 4 0
sb = new uchar 4 0
la = ulong 0
lb = ulong 0
if lt a 10
put sa 0 uchar add 48 a
la = ulong 1
else
if lt a 100
put sa 0 uchar add 48 div a 10
put sa 1 uchar add 48 rem a 10
la = ulong 2
else
put sa 0 uchar add 48 div a 100
put sa 1 uchar add 48 rem div a 10 10
put sa 2 uchar add 48 rem a 10
la = ulong 3
end
end
if lt b 10
put sb 0 uchar add 48 b
lb = ulong 1
else
if lt b 100
put sb 0 uchar add 48 div b 10
put sb 1 uchar add 48 rem b 10
lb = ulong 2
else
put sb 0 uchar add 48 div b 100
put sb 1 uchar add 48 rem div b 10 10
put sb 2 uchar add 48 rem b 10
lb = ulong 3
end
end
m = la
if lt lb m
m = lb
end
for i ulong m bound 4
ca = get sa i
cb = get sb i
if ne ca cb
ret lt ca cb
end
end
ret lt la lb
end

fn qdInitLexRank to void
for e ulong 256
r = ulong 0
for o ulong 256
if qdLexLess o e
r = add r 1
end
end
put qdLexRank e r
end
end

note =========================================================================
note GPU dispatch & UVM memory helpers
note =========================================================================
fn qdArg u uint to void
i = get qdBindN 0
put qdBind i u
put qdBindN 0 add i 1
end

fn qdPtr va ulong to void
qdArg gblo va
qdArg gbhi va
end

fn qdPktStartAt off ulong to void
put qdPktOff 0 off
put qdPktPos 0 0
put gbused 0 0
gbsetup
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
cb = mapaddr get gbmem 1
gbdriver cb
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
n = get gbused 0
r = mapwrite get qdWork 0 off gbcmd 0 n
put qdPktPos 0 n
end

fn qdPktStart to void
qdPktStartAt add QDW_PKT 6291456
end

fn qdPrepQmdGy kid ulong gx uint gy uint bx uint to void
gbqmd 1
a = add mapaddr get qdCodeMap 0 get qdEntry kid
put gbq1 32 gblo shr a 4
put gbq1 33 or uint and shr a 36 2097151 20971520
put gbq1 59 gblo shr a 8
put gbq1 34 or uint 65536 bx
put gbq1 35 or uint 131073 shl uint 64 8
sm = get qdSmem kid
s7 = ulong 8
if ne sm 0
s7 = div add sm 127 128
end
put gbq1 36 uint or 78923776 s7
put gbq1 37 0
put gbq1 39 gx
put gbq1 40 gy
put gbq1 41 1
put gbcb 216 bx
put gbcb 220 gx
put gbcb 221 gy
put gbcb 222 1
end

fn qdPktEmitGy kid ulong gx uint gy uint bx uint to bool
qdPrepQmdGy kid gx gy bx
cb = mapaddr get gbmem 1
words = get qdBindN 0
endva = add cb add 896 mul words 4
put gbcb 212 gbhi endva
put gbcb 213 gblo endva
put gbused 0 0
gbdma add cb 896 uint words
for j ulong words
gbemit get qdBind j
end
q = mapaddr get gbmem 2
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
gbrel add mapaddr get gbmem 3 32 6
put qdBindN 0 0
n = get gbused 0
pos = get qdPktPos 0
if gt add pos n 2000000
ret false
end
dstOff = add get qdPktOff 0 pos
if ne mapwrite get qdWork 0 dstOff gbcmd 0 n long n
ret false
end
put qdPktPos 0 add pos n
ret true
end

fn qdPktEmitBx kid ulong gx uint bx uint to bool
ret qdPktEmitGy kid gx 1 bx
end

fn qdPktEmit kid ulong gx uint words ulong to bool
ret qdPktEmitGy kid gx 1 256
end

fn qdPktFinish slot ulong to bool
put gbused 0 0
gbtail
n = get gbused 0
pos = get qdPktPos 0
dstOff = add get qdPktOff 0 pos
if ne mapwrite get qdWork 0 dstOff gbcmd 0 n long n
ret false
end
put qdPreOff slot get qdPktOff 0
put qdPreBytes slot add pos n
ret true
end

fn qdReplayPre slot ulong to bool
r = mapset get gbmem 2 8192 4 0
r = mapset get gbmem 3 0 4 0
r = mapset get gbmem 3 16 4 0
off = get qdPreOff slot
nb = get qdPreBytes slot
if not nvsend get qdWork 0 off uint div nb 4
ret false
end
if not qdWaitFast 15000000000
ret false
end
ret eq mapget get gbmem 3 0 4 1145324612
end

fn qdWaitFast timeout ulong to bool
for sp ulong 50000
if eq mapget get gbmem 3 16 4 1179010630
put nvret 0 get nvput 0
ret true
end
end
t0 = monons
while lt ulong sub monons t0 timeout bound 5000000
if eq mapget get gbmem 3 16 4 1179010630
put nvret 0 get nvput 0
ret true
end
r = sleepns long 5000
end
ret false
end

fn qdPktRun to bool
put gbused 0 0
gbtail
n = get gbused 0
pos = get qdPktPos 0
dstOff = add get qdPktOff 0 pos
if ne mapwrite get qdWork 0 dstOff gbcmd 0 n long n
ret false
end
tot = add pos n
r = mapset get gbmem 2 8192 4 0
r = mapset get gbmem 3 0 4 0
r = mapset get gbmem 3 16 4 0
if not nvsend get qdWork 0 get qdPktOff 0 uint div tot 4
ret false
end
if not qdWaitFast 15000000000
ret false
end
ret eq mapget get gbmem 3 0 4 1145324612
end

fn qdGetF32Io p ulong to f32
b0 = uint get qdIoBuf p
b1 = shl uint get qdIoBuf add p 1 8
b2 = shl uint get qdIoBuf add p 2 16
b3 = shl uint get qdIoBuf add p 3 24
w = or or b0 b1 or b2 b3
ret bitcast f32 w
end

fn qdStoreF32Sel dstSel ulong idx ulong f f32 to void
if eq dstSel 0
put qdQkv idx f
ret
end
if eq dstSel 1
put qdZ idx f
ret
end
if eq dstSel 2
put qdAout idx f
ret
end
if eq dstSel 3
put qdK idx f
ret
end
if eq dstSel 4
put qdV idx f
ret
end
if eq dstSel 5
put qdRout idx f
ret
end
if eq dstSel 6
put qdEmid idx f
ret
end
if eq dstSel 7
put qdEout idx f
ret
end
if eq dstSel 8
put qdShMid idx f
ret
end
if eq dstSel 9
put qdShOut idx f
ret
end
if eq dstSel 10
put qdLogW4 idx f
ret
end
if eq dstSel 11
put qdLogBf idx f
ret
end
if eq dstSel 12
put qdCandLog idx f
ret
end
if eq dstSel 14
put qdAbTmp idx f
ret
end
if eq dstSel 15
put qdX idx f
ret
end
put qdTmpVec idx f
end

fn qdReadF32 m long off ulong dstSel ulong n ulong to bool
bytes = mul n 4
pos = ulong 0
while lt pos bytes bound 1000
want = sub bytes pos
if gt want 65536
want = ulong 65536
end
if ne mapread m add off pos qdIoBuf 0 want long want
ret false
end
cnt = div want 4
base = div pos 4
for i ulong cnt bound 16384
f = qdGetF32Io mul i 4
qdStoreF32Sel dstSel add base i f
end
pos = add pos want
end
ret true
end

fn qdPutF32Io p ulong f f32 to void
w = bitcast uint f
put qdIoBuf p uchar and w 255
put qdIoBuf add p 1 uchar and shr w 8 255
put qdIoBuf add p 2 uchar and shr w 16 255
put qdIoBuf add p 3 uchar and shr w 24 255
end

fn qdLoadF32Sel srcSel ulong idx ulong to f32
if eq srcSel 0
ret get qdXn idx
end
if eq srcSel 1
ret get qdY idx
end
if eq srcSel 2
ret get qdEmid idx
end
if eq srcSel 4
ret get qdQkv idx
end
if eq srcSel 5
ret get qdDbTmp idx
end
if eq srcSel 6
ret get qdX idx
end
if eq srcSel 7
ret get qdWts idx
end
ret get qdShMid idx
end

fn qdWriteF32 m long off ulong srcSel ulong n ulong to bool
bytes = mul n 4
pos = ulong 0
while lt pos bytes bound 1000
want = sub bytes pos
if gt want 65536
want = ulong 65536
end
cnt = div want 4
base = div pos 4
for i ulong cnt bound 16384
f = qdLoadF32Sel srcSel add base i
qdPutF32Io mul i 4 f
end
if ne mapwrite m add off pos qdIoBuf 0 want long want
ret false
end
pos = add pos want
end
ret true
end

fn qdBuildFp8Lut to bool
m = nvalloc 4096 true
if le m 0
ret false
end
put qdLut 0 m
for i ulong 256
s = and shr i 7 1
e = and shr i 3 15
mn = and i 7
v = f32 0.0f32
if eq e 15
if eq mn 7
v = f32 0.0f32
else
v = mul f32 256.0f32 add f32 1.0f32 div f32 mn f32 8.0f32
end
else
if eq e 0
v = mul f32 0.015625f32 div f32 mn f32 8.0f32
else
pw = f32 1.0f32
if ge e 7
for k ulong sub e 7 bound 16
pw = mul pw f32 2.0f32
end
else
for k ulong sub 7 e bound 16
pw = mul pw f32 0.5f32
end
end
v = mul pw add f32 1.0f32 div f32 mn f32 8.0f32
end
end
if eq s 1
v = neg v
end
w = bitcast uint v
p = mul i 4
put qdIoBuf p uchar and w 255
put qdIoBuf add p 1 uchar and shr w 8 255
put qdIoBuf add p 2 uchar and shr w 16 255
put qdIoBuf add p 3 uchar and shr w 24 255
end
ret eq mapwrite m 0 qdIoBuf 0 1024 1024
end

note =========================================================================
note Checkpoint file path builder & streaming loader
note =========================================================================
fn qdBuildPath suf view uchar * layIdx long to ulong
dlen = get qdDirLen 0
for i ulong dlen bound 256
put qdPathBuf i get qdDirBuf i
end
pos = dlen
for i ulong len suf bound 64
put qdPathBuf pos get suf i
pos = add pos 1
end
if ge layIdx 0
if ge layIdx 10
put qdPathBuf pos uchar add 48 div ulong layIdx 10
pos = add pos 1
put qdPathBuf pos uchar add 48 rem ulong layIdx 10
pos = add pos 1
else
put qdPathBuf pos uchar add 48 ulong layIdx
pos = add pos 1
end
for i ulong len qdSufSt bound 32
put qdPathBuf pos get qdSufSt i
pos = add pos 1
end
end
put qdPathBuf pos 0
ret pos
end

fn qdStreamToMap fd int foff ulong m long moff ulong bytes ulong to bool
pos = ulong 0
while lt pos bytes bound 2000
want = sub bytes pos
if gt want 1048576
want = ulong 1048576
end
got = pread fd qdIoBuf 0 want long add foff pos
if le got 0
ret false
end
if ne mapwrite m add moff pos qdIoBuf 0 ulong got got
ret false
end
pos = add pos ulong got
end
ret true
end

fn qdWidenBuf cnt ulong to void
for i ulong cnt bound 131072
p = mul i 2
q = mul i 4
put qdScaleOut q 0
put qdScaleOut add q 1 0
put qdScaleOut add q 2 get qdIoBuf p
put qdScaleOut add q 3 get qdIoBuf add p 1
end
end

note Widen first bf16Bytes of layer L from BF16 -> F32 into qdScaleMap at L * QD_SCALE_STRIDE
fn qdWidenLayerScales fd int foff ulong L ulong bf16Bytes ulong to bool
pos = ulong 0
sbase = mul L QD_SCALE_STRIDE
while lt pos bf16Bytes bound 64
want = sub bf16Bytes pos
if gt want 262144
want = ulong 262144
end
got = pread fd qdIoBuf 0 want long add foff pos
if ne got long want
ret false
end
qdWidenBuf div want 2
outBytes = mul want 2
dstOff = add sbase mul pos 2
sm = get qdScaleMap 0
if ne mapwrite sm dstOff qdScaleOut 0 outBytes long outBytes
ret false
end
pos = add pos want
end
ret true
end

fn qdLoadOutside to bool
n = qdBuildPath qdSufOut neg 1
fd = int fopen qdPathBuf 0 n 0 0
if lt fd 0
ret false
end
put qdOutFd 0 fd
note Read final norm.weight BF16 [2048] and upload raw F32 to QDW_FNORM (GPU adds 1+w)
if ne pread fd qdIoBuf 0 4096 long QD_NORM_OFF 4096
ret false
end
for i ulong QD_H
p = mul i 2
bits = or shl uint get qdIoBuf add p 1 24 shl uint get qdIoBuf p 16
put qdFinalNorm i bitcast f32 bits
end
for i ulong QD_H
qdPutF32Io mul i 4 get qdFinalNorm i
end
if ne mapwrite get qdWork 0 QDW_FNORM qdIoBuf 0 8192 8192
ret false
end
note Stream lm_head.weight BF16 (1.017 GB) into qdLmBf16
if not qdStreamToMap fd QD_OUT_DATA_OFF get qdLmBf16 0 0 QD_LM_BYTES
ret false
end
ret true
end

fn qdCacheLayerFa L ulong to bool
faIdx = div L 4
b256 = mul faIdx 256
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L FA_QNORM 13 256
ret false
end
for d ulong 256
put qdQnC add b256 d add 1.0f32 get qdTmpVec d
end
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L FA_KNORM 13 256
ret false
end
for d ulong 256
put qdKnC add b256 d add 1.0f32 get qdTmpVec d
end
ret true
end

fn qdCacheLayerGdn L ulong to bool
gdnIdx = sub L div L 4
b32 = mul gdnIdx 32
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L GDN_ALOG 13 32
ret false
end
for h ulong 32
v = neg qdExp get qdTmpVec h
put qdAlogC add b32 h v
qdPutF32Io mul h 4 v
end
if ne mapwrite get qdWork 0 add QDW_ALOG mul gdnIdx 256 qdIoBuf 0 128 128
ret false
end
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L GDN_DTBIAS 13 32
ret false
end
for h ulong 32
qdPutF32Io mul h 4 get qdTmpVec h
end
if ne mapwrite get qdWork 0 add add QDW_ALOG mul gdnIdx 256 128 qdIoBuf 0 128 128
ret false
end
ret true
end

fn qdCacheLayerCpu L ulong isFa bool to bool
b2048 = mul L QD_H
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L 0 13 QD_H
ret false
end
for d ulong QD_H
put qdInNormC add b2048 d add 1.0f32 get qdTmpVec d
end
pnOff = GDN_POST_NORM
sgOff = GDN_SH_GATE
if isFa
pnOff = FA_POST_NORM
sgOff = FA_SH_GATE
end
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L pnOff 13 QD_H
ret false
end
for d ulong QD_H
put qdPostNormC add b2048 d add 1.0f32 get qdTmpVec d
end
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L sgOff 13 QD_H
ret false
end
for d ulong QD_H
put qdShGateC add b2048 d get qdTmpVec d
end
if isFa
ret qdCacheLayerFa L
end
ret qdCacheLayerGdn L
end

fn qdLayerW4Va L ulong to ulong
ret add get qdW4Va div L 7 mul rem L 7 QD_W4_LSTRIDE
end

fn qdEmitQuantW4 wFp8Va ulong sFp8Va ulong wW4Va ulong sW4Va ulong K uint N uint to bool
qdPtr wFp8Va
qdPtr sFp8Va
qdPtr mapaddr get qdLut 0
qdPtr wW4Va
qdPtr sW4Va
qdArg K
qdArg N
gx = div add N 3 4
ret qdPktEmitGy 18 gx 1 128
end

fn qdCopyMapBytes srcMap long srcOff ulong dstMap long dstOff ulong bytes ulong to bool
pos = ulong 0
while lt pos bytes bound 64
want = sub bytes pos
if gt want 262144
want = ulong 262144
end
if ne mapread srcMap add srcOff pos qdIoBuf 0 want long want
ret false
end
if ne mapwrite dstMap add dstOff pos qdIoBuf 0 want long want
ret false
end
pos = add pos want
end
ret true
end

fn qdQuantOneGu L ulong expW0 ulong expS0 ulong rk ulong to bool
fw = add get qdSlabVa 0 add expW0 add mul rk QD_EXP_WSTRIDE 1048576
fs = add qdLayerSVa L add mul expS0 2 add mul rk QD_EXP_SSTRIDE 256
dw = add qdLayerW4Va L add W4_GU_W mul rk 1048576
ds = add qdLayerW4Va L add W4_GU_S mul rk 131072
ret qdEmitQuantW4 fw fs dw ds 2048 1024
end

fn qdQuantExpGuW4 L ulong expW0 ulong expS0 ulong to bool
for b ulong 2
qdPktStart
for k ulong 128
if not qdQuantOneGu L expW0 expS0 add mul b 128 k
ret false
end
end
if not qdPktRun
ret false
end
end
ret true
end

fn qdQuantOneDn L ulong expW0 ulong expS0 ulong rk ulong to bool
fw = add get qdSlabVa 0 add expW0 mul rk QD_EXP_WSTRIDE
fs = add qdLayerSVa L add mul expS0 2 mul rk QD_EXP_SSTRIDE
dw = add qdLayerW4Va L add W4_DN_W mul rk 524288
ds = add qdLayerW4Va L add W4_DN_S mul rk 65536
ret qdEmitQuantW4 fw fs dw ds 512 2048
end

fn qdQuantExpDnW4 L ulong expW0 ulong expS0 ulong to bool
for b ulong 2
qdPktStart
for k ulong 128
if not qdQuantOneDn L expW0 expS0 add mul b 128 k
ret false
end
end
if not qdPktRun
ret false
end
end
ret true
end

fn qdQuantLayerExpW4 L ulong isFa bool to bool
expW0 = GDN_EXP_W0
expS0 = GDN_EXP_S0
if isFa
expW0 = FA_EXP_W0
expS0 = FA_EXP_S0
end
if not qdQuantExpGuW4 L expW0 expS0
ret false
end
ret qdQuantExpDnW4 L expW0 expS0
end

fn qdQuantShGuW4 L ulong isFa bool to bool
guW = GDN_SH_GU_W
guS = GDN_SH_GU_S
if isFa
guW = FA_SH_GU_W
guS = FA_SH_GU_S
end
fw = add get qdSlabVa 0 guW
fs = add qdLayerSVa L mul guS 2
w4 = qdLayerW4Va L
dw = add w4 268435456
ds = add w4 add W4_GU_S 33554432
ret qdEmitQuantW4 fw fs dw ds 2048 1024
end

fn qdQuantShDnW4 L ulong isFa bool to bool
dnW = GDN_SH_DN_W
dnS = GDN_SH_DN_S
if isFa
dnW = FA_SH_DN_W
dnS = FA_SH_DN_S
end
fw = add get qdSlabVa 0 dnW
fs = add qdLayerSVa L mul dnS 2
w4 = qdLayerW4Va L
dw = add w4 add W4_DN_W 134217728
ds = add w4 add W4_DN_S 16777216
ret qdEmitQuantW4 fw fs dw ds 512 2048
end

fn qdQuantShW4 L ulong isFa bool to bool
if not qdQuantShGuW4 L isFa
ret false
end
ret qdQuantShDnW4 L isFa
end

fn qdQuantDenseFaW4 L ulong to bool
wbase = get qdSlabVa 0
sbase = qdLayerSVa L
d4 = add qdLayerW4Va L W4_DENSE
dm = get qdW4Map div L 7
doff = add mul rem L 7 QD_W4_LSTRIDE W4_DENSE
qdPktStart
note Fused FA Q|K|V W at d4+0..9437184, S at d4+9437184..10616832
if not qdEmitQuantW4 add wbase FA_Q_W add sbase mul FA_Q_S 2 d4 add d4 9437184 2048 8192
ret false
end
if not qdEmitQuantW4 add wbase FA_K_W add sbase mul FA_K_S 2 add d4 8388608 add d4 10485760 2048 512
ret false
end
if not qdEmitQuantW4 add wbase FA_V_W add sbase mul FA_V_S 2 add d4 8912896 add d4 10551296 2048 512
ret false
end
if not qdEmitQuantW4 add wbase FA_O_W add sbase mul FA_O_S 2 add d4 10616832 add d4 14811136 4096 2048
ret false
end
if not qdQuantShW4 L true
ret false
end
if not qdPktRun
ret false
end
note Contiguous GATE [256,2048] + SH_GATE [1,2048] at d4+15335424
if not qdCopyMapBytes get qdSlabMap 0 FA_GATE dm add doff 15335424 1048576
ret false
end
ret qdCopyMapBytes get qdSlabMap 0 FA_SH_GATE dm add doff 16384000 4096
end

fn qdQuantDenseGdnW4 L ulong to bool
wbase = get qdSlabVa 0
sbase = qdLayerSVa L
d4 = add qdLayerW4Va L W4_DENSE
dm = get qdW4Map div L 7
doff = add mul rem L 7 QD_W4_LSTRIDE W4_DENSE
qdPktStart
if not qdEmitQuantW4 add wbase GDN_QKV_W add sbase mul GDN_QKV_S 2 d4 add d4 12582912 2048 12288
ret false
end
if not qdEmitQuantW4 add wbase GDN_OUT_W add sbase mul GDN_OUT_S 2 add d4 14155776 add d4 18350080 4096 2048
ret false
end
if not qdQuantShW4 L false
ret false
end
if not qdPktRun
ret false
end
note Contiguous GATE [256,2048] + SH_GATE [1,2048] at d4+18874368, IN_AB at d4+19927040
if not qdCopyMapBytes get qdSlabMap 0 GDN_GATE dm add doff 18874368 1048576
ret false
end
if not qdCopyMapBytes get qdSlabMap 0 GDN_SH_GATE dm add doff 19922944 4096
ret false
end
ret qdCopyMapBytes get qdSlabMap 0 GDN_IN_A dm add doff 19927040 262144
end

fn qdQuantLayerDenseW4 L ulong isFa bool to bool
if isFa
ret qdQuantDenseFaW4 L
end
ret qdQuantDenseGdnW4 L
end

fn qdLoadLayer L ulong to bool
n = qdBuildPath qdSufLay long L
fd = int fopen qdPathBuf 0 n 0 0
if lt fd 0
ret false
end
if ne pread fd qdIoBuf 0 8 0 8
r = fclose fd
ret false
end
hdrLen = ulong 0
for i ulong 8
hdrLen = or hdrLen shl ulong get qdIoBuf i mul i 8
end
dataOff = add 8 hdrLen
slabIdx = div L 4
inSlab = rem L 4
moff = mul inSlab QD_LAYER_STRIDE
if eq get qdUseW4 0 1
slabIdx = ulong 0
moff = ulong 0
end
isFa = eq rem L 4 3
payload = GDN_PAYLOAD
bf16Top = ulong 1491712
if isFa
payload = FA_PAYLOAD
bf16Top = ulong 1163904
end
ok = qdStreamToMap fd dataOff get qdSlabMap slabIdx moff payload
if not ok
r = fclose fd
ret false
end
ok = qdWidenLayerScales fd dataOff L bf16Top
r = fclose fd
if not ok
ret false
end
if not qdCacheLayerCpu L isFa
ret false
end
if eq get qdUseW4 0 1
if not qdQuantLayerExpW4 L isFa
ret false
end
ret qdQuantLayerDenseW4 L isFa
end
ret true
end

fn qdLayerWVa L ulong to ulong
ret add get qdSlabVa div L 4 mul rem L 4 QD_LAYER_STRIDE
end

fn qdLayerSVa L ulong to ulong
ret add get qdScaleVa 0 mul L QD_SCALE_STRIDE
end

fn qdLayerSOff L ulong bf16Off ulong to ulong
ret add mul L QD_SCALE_STRIDE mul bf16Off 2
end


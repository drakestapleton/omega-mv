qdPtr xVa
qdPtr wVa
qdPtr sVa
qdPtr outVa
qdArg K
qdArg N
gx = div add N 31 32
ret qdPktEmitGy 17 gx 1 256
end

fn qdEmitFp8 xVa ulong wVa ulong sVa ulong outVa ulong K uint N uint to bool
qdPtr xVa
qdPtr wVa
qdPtr sVa
qdPtr mapaddr get qdLut 0
qdPtr outVa
qdArg K
qdArg N
gx = div add N 31 32
ret qdPktEmit 1 gx 12
end

fn qdEmitBf161R xVa ulong wVa ulong outVa ulong N uint to bool
qdPtr wVa
qdPtr xVa
qdPtr outVa
qdArg N

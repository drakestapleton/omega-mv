note =========================================================================
note Pure OM-2 FP32 math helpers (sqrt, exp, log, cos, sin, bf16)
note =========================================================================
fn qdSqrt x f32 to f32
if le x 0.0f32
ret 0.0f32
end
bits = bitcast uint x
gbits = add 0x1fc00000 shr bits 1
y = bitcast f32 gbits
for i ulong 5
y = mul 0.5f32 add y div x y
end
ret y
end

fn qdExp x f32 to f32
v = x
if gt v 80.0f32
v = f32 80.0f32
end
if lt v neg 80.0f32
ret 0.0f32
end
note x = k * ln(2) + r, |r| <= 0.35
kf = mul v 1.44269504f32
ki = int 0
if ge kf 0.0f32
ki = int add kf 0.5f32
else
ki = int sub kf 0.5f32
end
r = sub v mul f32 ki 0.69314718f32
p = f32 1.0f32
p = add 1.0f32 mul r mul p 0.16666667f32
p = add 1.0f32 mul r mul p 0.2f32
p = add 1.0f32 mul r mul p 0.25f32
p = add 1.0f32 mul r mul p 0.33333333f32
p = add 1.0f32 mul r mul p 0.5f32
p = add 1.0f32 mul r p
eb = shl uint add ki 127 23
ret mul p bitcast f32 eb
end

fn qdLog x f32 to f32
if le x 0.0f32
ret neg 80.0f32
end
bits = bitcast uint x
e = sub int and shr bits 23 255 127
mbits = or and bits 0x007fffff 0x3f800000
m = bitcast f32 mbits
if gt m 1.41421356f32
m = mul m 0.5f32
e = add e 1
end
t = div sub m 1.0f32 add m 1.0f32
t2 = mul t t
s = add 0.14285714f32 mul t2 0.11111111f32
s = add 0.2f32 mul t2 s
s = add 0.33333333f32 mul t2 s
s = add 1.0f32 mul t2 s
ret add mul f32 e 0.69314718f32 mul 2.0f32 mul t s
end

fn qdSigmoid x f32 to f32
if ge x 0.0f32
e = qdExp neg x
ret div 1.0f32 add 1.0f32 e
end
e = qdExp x
ret div e add 1.0f32 e
end

fn qdSilu x f32 to f32
ret mul x qdSigmoid x
end

fn qdSoftplus x f32 to f32
if gt x 20.0f32
ret x
end
if lt x neg 20.0f32
ret qdExp x
end
ret qdLog add 1.0f32 qdExp x
end

fn qdSinCos theta f32 isCos bool to f32
note Reduce theta to [-pi, pi]
inv2pi = f32 0.15915494f32
twopi = f32 6.28318531f32
pi = f32 3.14159265f32
hp = f32 1.57079633f32
k = mul theta inv2pi
ki = int 0
if ge k 0.0f32
ki = int add k 0.5f32
else
ki = int sub k 0.5f32
end
x = sub theta mul f32 ki twopi
if isCos
x = add x hp
if gt x pi
x = sub x twopi
end
end
sgn = f32 1.0f32
if gt x hp
x = sub pi x
end
if lt x neg hp
x = sub neg pi x
end
x2 = mul x x
r = sub 1.0f32 mul x2 0.0001984127f32
r = sub 1.0f32 mul x2 mul 0.0083333333f32 r
r = sub 1.0f32 mul x2 mul 0.0416666667f32 r
r = sub 1.0f32 mul x2 mul 0.1666666667f32 r
ret mul sgn mul x r
end

fn qdInitRopeFreq to void
note inv_freq[j] = exp(-2*j/64 * ln(10000000.0))
lnTheta = f32 16.11809565f32
for j ulong 32
e = div mul f32 mul j 2 lnTheta 64.0f32
put qdRopeFreq j qdExp neg e
end
end

note Compute lexicographic rank in 0..255 for expert id e in 0..255
fn qdLexLess a ulong b ulong to bool
sa = new uchar 4 0
sb = new uchar 4 0
la = ulong 0
lb = ulong 0
if lt a 10
put sa 0 uchar add 48 a
la = ulong 1
else
if lt a 100
put sa 0 uchar add 48 div a 10
put sa 1 uchar add 48 rem a 10
la = ulong 2
else
put sa 0 uchar add 48 div a 100
put sa 1 uchar add 48 rem div a 10 10
put sa 2 uchar add 48 rem a 10
la = ulong 3
end
end
if lt b 10
put sb 0 uchar add 48 b
lb = ulong 1
else
if lt b 100
put sb 0 uchar add 48 div b 10
put sb 1 uchar add 48 rem b 10
lb = ulong 2
else
put sb 0 uchar add 48 div b 100
put sb 1 uchar add 48 rem div b 10 10
put sb 2 uchar add 48 rem b 10
lb = ulong 3
end
end
m = la
if lt lb m
m = lb
end
for i ulong m bound 4
ca = get sa i
cb = get sb i
if ne ca cb
ret lt ca cb
end
end
ret lt la lb
end

fn qdInitLexRank to void
for e ulong 256
r = ulong 0
for o ulong 256
if qdLexLess o e
r = add r 1
end
end
put qdLexRank e r
end
end

note =========================================================================
note GPU dispatch & UVM memory helpers
note =========================================================================
fn qdArg u uint to void
i = get qdBindN 0
put qdBind i u
put qdBindN 0 add i 1
end

fn qdPtr va ulong to void
qdArg gblo va
qdArg gbhi va
end

fn qdPktStart to void
put qdPktPos 0 0
put gbused 0 0
gbsetup
gbmth 0 40 4
gbemit 0
gbemit 0
gbemit 0
gbemit 2281701376
cb = mapaddr get gbmem 1
gbdriver cb
gbdma cb 224
for j ulong 224
gbemit get gbcb j
end
n = get gbused 0
r = mapwrite get qdWork 0 QDW_PKT gbcmd 0 n
put qdPktPos 0 n
end

fn qdPrepQmd kid ulong gx uint bx uint to void
gbqmd 1
a = add mapaddr get qdCodeMap 0 get qdEntry kid
put gbq1 32 gblo shr a 4
put gbq1 33 or uint and shr a 36 2097151 20971520
put gbq1 59 gblo shr a 8
put gbq1 34 or uint 65536 bx
put gbq1 35 or uint 131073 shl uint 64 8
sm = get qdSmem kid
s7 = ulong 8
if ne sm 0
s7 = div add sm 127 128
end
put gbq1 36 uint or 78923776 s7
put gbq1 37 0
put gbq1 39 gx
put gbq1 40 1
put gbq1 41 1
put gbcb 216 bx
put gbcb 220 gx
put gbcb 221 1
put gbcb 222 1
end

fn qdPktEmitBx kid ulong gx uint bx uint to bool
qdPrepQmd kid gx bx
cb = mapaddr get gbmem 1
words = get qdBindN 0
endva = add cb add 896 mul words 4
put gbcb 212 gbhi endva
put gbcb 213 gblo endva
put gbused 0 0
gbdma add cb 896 uint words
for j ulong words
gbemit get qdBind j
end
q = mapaddr get gbmem 2
gbinline q false
gbdma add q 8192 1
gbemit 1
gbinline add q 4096 true
gbrel add mapaddr get gbmem 3 32 6
put qdBindN 0 0
n = get gbused 0
pos = get qdPktPos 0
if gt add pos n 65000
ret false
end
if ne mapwrite get qdWork 0 add QDW_PKT pos gbcmd 0 n long n
ret false
end
put qdPktPos 0 add pos n
ret true
end

fn qdPktEmit kid ulong gx uint words ulong to bool
ret qdPktEmitBx kid gx 256
end

fn qdWaitFast timeout ulong to bool
for sp ulong 50000
if eq mapget get gbmem 3 16 4 1179010630
put nvret 0 get nvput 0
ret true
end
end
t0 = monons
while lt ulong sub monons t0 timeout bound 5000000
if eq mapget get gbmem 3 16 4 1179010630
put nvret 0 get nvput 0
ret true
end
r = sleepns long 5000
end
ret false
end

fn qdPktRun to bool
put gbused 0 0
gbtail
n = get gbused 0
pos = get qdPktPos 0
if ne mapwrite get qdWork 0 add QDW_PKT pos gbcmd 0 n long n
ret false
end
tot = add pos n
r = mapset get gbmem 2 8192 4 0
r = mapset get gbmem 3 0 4 0
r = mapset get gbmem 3 16 4 0
if not nvsend get qdWork 0 QDW_PKT uint div tot 4
ret false
end
if not qdWaitFast 15000000000
ret false
end
ret eq mapget get gbmem 3 0 4 1145324612
end

fn qdGetF32Io p ulong to f32
b0 = uint get qdIoBuf p
b1 = shl uint get qdIoBuf add p 1 8
b2 = shl uint get qdIoBuf add p 2 16
b3 = shl uint get qdIoBuf add p 3 24
w = or or b0 b1 or b2 b3
ret bitcast f32 w
end

fn qdStoreF32Sel dstSel ulong idx ulong f f32 to void
if eq dstSel 0
put qdQkv idx f
ret
end
if eq dstSel 1
put qdZ idx f
ret
end
if eq dstSel 2
put qdAout idx f
ret
end
if eq dstSel 3
put qdK idx f
ret
end
if eq dstSel 4
put qdV idx f
ret
end
if eq dstSel 5
put qdRout idx f
ret
end
if eq dstSel 6
put qdEmid idx f
ret
end
if eq dstSel 7
put qdEout idx f
ret
end
if eq dstSel 8
put qdShMid idx f
ret
end
if eq dstSel 9
put qdShOut idx f
ret
end
if eq dstSel 10
put qdLogW4 idx f
ret
end
if eq dstSel 11
put qdLogBf idx f
ret
end
if eq dstSel 12
put qdCandLog idx f
ret
end
if eq dstSel 14
put qdAbTmp idx f
ret
end
if eq dstSel 15
put qdX idx f
ret
end
put qdTmpVec idx f
end

fn qdReadF32 m long off ulong dstSel ulong n ulong to bool
bytes = mul n 4
pos = ulong 0
while lt pos bytes bound 1000
want = sub bytes pos
if gt want 65536
want = ulong 65536
end
if ne mapread m add off pos qdIoBuf 0 want long want
ret false
end
cnt = div want 4
base = div pos 4
for i ulong cnt bound 16384
f = qdGetF32Io mul i 4
qdStoreF32Sel dstSel add base i f
end
pos = add pos want
end
ret true
end

fn qdPutF32Io p ulong f f32 to void
w = bitcast uint f
put qdIoBuf p uchar and w 255
put qdIoBuf add p 1 uchar and shr w 8 255
put qdIoBuf add p 2 uchar and shr w 16 255
put qdIoBuf add p 3 uchar and shr w 24 255
end

fn qdLoadF32Sel srcSel ulong idx ulong to f32
if eq srcSel 0
ret get qdXn idx
end
if eq srcSel 1
ret get qdY idx
end
if eq srcSel 2
ret get qdEmid idx
end
if eq srcSel 4
ret get qdQkv idx
end
if eq srcSel 5
ret get qdDbTmp idx
end
if eq srcSel 6
ret get qdX idx
end
if eq srcSel 7
ret get qdWts idx
end
ret get qdShMid idx
end

fn qdWriteF32 m long off ulong srcSel ulong n ulong to bool
bytes = mul n 4
pos = ulong 0
while lt pos bytes bound 1000
want = sub bytes pos
if gt want 65536
want = ulong 65536
end
cnt = div want 4
base = div pos 4
for i ulong cnt bound 16384
f = qdLoadF32Sel srcSel add base i
qdPutF32Io mul i 4 f
end
if ne mapwrite m add off pos qdIoBuf 0 want long want
ret false
end
pos = add pos want
end
ret true
end

fn qdBuildFp8Lut to bool
m = nvalloc 4096 true
if le m 0
ret false
end
put qdLut 0 m
for i ulong 256
s = and shr i 7 1
e = and shr i 3 15
mn = and i 7
v = f32 0.0f32
if eq e 15
if eq mn 7
v = f32 0.0f32
else
v = mul f32 256.0f32 add f32 1.0f32 div f32 mn f32 8.0f32
end
else
if eq e 0
v = mul f32 0.015625f32 div f32 mn f32 8.0f32
else
pw = f32 1.0f32
if ge e 7
for k ulong sub e 7 bound 16
pw = mul pw f32 2.0f32
end
else
for k ulong sub 7 e bound 16
pw = mul pw f32 0.5f32
end
end
v = mul pw add f32 1.0f32 div f32 mn f32 8.0f32
end
end
if eq s 1
v = neg v
end
w = bitcast uint v
p = mul i 4
put qdIoBuf p uchar and w 255
put qdIoBuf add p 1 uchar and shr w 8 255
put qdIoBuf add p 2 uchar and shr w 16 255
put qdIoBuf add p 3 uchar and shr w 24 255
end
ret eq mapwrite m 0 qdIoBuf 0 1024 1024
end

note =========================================================================
note Checkpoint file path builder & streaming loader
note =========================================================================
fn qdBuildPath suf view uchar * layIdx long to ulong
dlen = get qdDirLen 0
for i ulong dlen bound 256
put qdPathBuf i get qdDirBuf i
end
pos = dlen
for i ulong len suf bound 64
put qdPathBuf pos get suf i
pos = add pos 1
end
if ge layIdx 0
if ge layIdx 10
put qdPathBuf pos uchar add 48 div ulong layIdx 10
pos = add pos 1
put qdPathBuf pos uchar add 48 rem ulong layIdx 10
pos = add pos 1
else
put qdPathBuf pos uchar add 48 ulong layIdx
pos = add pos 1
end
for i ulong len qdSufSt bound 32
put qdPathBuf pos get qdSufSt i
pos = add pos 1
end
end
put qdPathBuf pos 0
ret pos
end

fn qdStreamToMap fd int foff ulong m long moff ulong bytes ulong to bool
pos = ulong 0
while lt pos bytes bound 2000
want = sub bytes pos
if gt want 1048576
want = ulong 1048576
end
got = pread fd qdIoBuf 0 want long add foff pos
if le got 0
ret false
end
if ne mapwrite m add moff pos qdIoBuf 0 ulong got got
ret false
end
pos = add pos ulong got
end
ret true
end

fn qdWidenBuf cnt ulong to void
for i ulong cnt bound 131072
p = mul i 2
q = mul i 4
put qdScaleOut q 0
put qdScaleOut add q 1 0
put qdScaleOut add q 2 get qdIoBuf p
put qdScaleOut add q 3 get qdIoBuf add p 1
end
end

note Widen first bf16Bytes of layer L from BF16 -> F32 into qdScaleMap at L * QD_SCALE_STRIDE
fn qdWidenLayerScales fd int foff ulong L ulong bf16Bytes ulong to bool
pos = ulong 0
sbase = mul L QD_SCALE_STRIDE
while lt pos bf16Bytes bound 64
want = sub bf16Bytes pos
if gt want 262144
want = ulong 262144
end
got = pread fd qdIoBuf 0 want long add foff pos
if ne got long want
ret false
end
qdWidenBuf div want 2
outBytes = mul want 2
dstOff = add sbase mul pos 2
sm = get qdScaleMap 0
if ne mapwrite sm dstOff qdScaleOut 0 outBytes long outBytes
ret false
end
pos = add pos want
end
ret true
end

fn qdLoadOutside to bool
n = qdBuildPath qdSufOut neg 1
fd = int fopen qdPathBuf 0 n 0 0
if lt fd 0
ret false
end
put qdOutFd 0 fd
note Read final norm.weight BF16 [2048] and fold (1 + w)
if ne pread fd qdIoBuf 0 4096 long QD_NORM_OFF 4096
ret false
end
for i ulong QD_H
p = mul i 2
bits = or shl uint get qdIoBuf add p 1 24 shl uint get qdIoBuf p 16
put qdFinalNorm i add 1.0f32 bitcast f32 bits
end
note Stream lm_head.weight BF16 (1.017 GB) into qdLmBf16
if not qdStreamToMap fd QD_OUT_DATA_OFF get qdLmBf16 0 0 QD_LM_BYTES
ret false
end
ret true
end

fn qdCacheLayerFa L ulong to bool
faIdx = div L 4
b256 = mul faIdx 256
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L FA_QNORM 13 256
ret false
end
for d ulong 256
put qdQnC add b256 d add 1.0f32 get qdTmpVec d
end
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L FA_KNORM 13 256
ret false
end
for d ulong 256
put qdKnC add b256 d add 1.0f32 get qdTmpVec d
end
ret true
end

fn qdCacheLayerGdn L ulong to bool
gdnIdx = sub L div L 4
b32 = mul gdnIdx 32
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L GDN_ALOG 13 32
ret false
end
for h ulong 32
put qdAlogC add b32 h neg qdExp get qdTmpVec h
end
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L GDN_DTBIAS 13 32
ret false
end
for h ulong 32
put qdDtC add b32 h get qdTmpVec h
end
cBase = mul gdnIdx 32768
for blk ulong 8
if not qdReadF32 get qdScaleMap 0 add qdLayerSOff L GDN_CONV mul blk 16384 13 4096
ret false
end
bo = add cBase mul blk 4096
for i ulong 4096
put qdConvC add bo i get qdTmpVec i
end
end
ret true
end

fn qdCacheLayerCpu L ulong isFa bool to bool
b2048 = mul L QD_H
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L 0 13 QD_H
ret false
end
for d ulong QD_H
put qdInNormC add b2048 d add 1.0f32 get qdTmpVec d
end
pnOff = GDN_POST_NORM
sgOff = GDN_SH_GATE
if isFa
pnOff = FA_POST_NORM
sgOff = FA_SH_GATE
end
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L pnOff 13 QD_H
ret false
end
for d ulong QD_H
put qdPostNormC add b2048 d add 1.0f32 get qdTmpVec d
end
if not qdReadF32 get qdScaleMap 0 qdLayerSOff L sgOff 13 QD_H
ret false
end
for d ulong QD_H
put qdShGateC add b2048 d get qdTmpVec d
end
if isFa
ret qdCacheLayerFa L
end
ret qdCacheLayerGdn L
end

fn qdLoadLayer L ulong to bool
n = qdBuildPath qdSufLay long L
fd = int fopen qdPathBuf 0 n 0 0
if lt fd 0
ret false
end
if ne pread fd qdIoBuf 0 8 0 8
r = fclose fd
ret false
end
hdrLen = ulong 0
for i ulong 8
hdrLen = or hdrLen shl ulong get qdIoBuf i mul i 8
end
dataOff = add 8 hdrLen
slabIdx = div L 4
inSlab = rem L 4
moff = mul inSlab QD_LAYER_STRIDE
isFa = eq rem L 4 3
payload = GDN_PAYLOAD
bf16Top = ulong 1491712
if isFa
payload = FA_PAYLOAD
bf16Top = ulong 1163904
end
ok = qdStreamToMap fd dataOff get qdSlabMap slabIdx moff payload
if not ok
r = fclose fd
ret false
end
ok = qdWidenLayerScales fd dataOff L bf16Top
r = fclose fd
if not ok
ret false
end
ret qdCacheLayerCpu L isFa
end

fn qdLayerWVa L ulong to ulong
ret add get qdSlabVa div L 4 mul rem L 4 QD_LAYER_STRIDE
end

fn qdLayerSVa L ulong to ulong
ret add get qdScaleVa 0 mul L QD_SCALE_STRIDE
end

fn qdLayerSOff L ulong bf16Off ulong to ulong
ret add mul L QD_SCALE_STRIDE mul bf16Off 2
end

note =========================================================================
note GPU GEMV helpers (reusing verified bf16_gemv_fast & fp8_b128_gemv_fast)
note =========================================================================
fn qdEmitFp8 xVa ulong wVa ulong sVa ulong outVa ulong K uint N uint to bool
qdPtr xVa
qdPtr wVa
qdPtr sVa
qdPtr mapaddr get qdLut 0
qdPtr outVa
qdArg K
qdArg N
gx = div add N 31 32
ret qdPktEmit 1 gx 12
end

fn qdEmitBf16 xVa ulong wVa ulong outVa ulong K uint N uint to bool
qdPtr wVa
qdPtr xVa
qdPtr outVa
qdArg K
qdArg N
gx = div add N 31 32
ret qdPktEmit 0 gx 8
end

fn qdQuantLmHeadOnGpu to bool
qdPktStart
qdPtr mapaddr get qdLmBf16 0
qdPtr get qdLmW4Va 0
qdPtr add get qdLmW4Va 0 254279680
qdPtr add get qdLmW4Va 0 286064640
qdArg uint QD_VOCAB
if not qdPktEmitBx 2 62080 128
ret false
end
ret qdPktRun
end

note =========================================================================
note CPU exact FP32 helpers (RMSNorm, GDN, Full-Attn, Router, SwiGLU)
note =========================================================================
fn qdLoadEmbed tid ulong to bool
off = add QD_EMB_OFF mul tid 4096
if ne pread get qdOutFd 0 qdIoBuf 0 4096 long off 4096
ret false
end
for i ulong QD_H
p = mul i 2
bits = or shl uint get qdIoBuf add p 1 24 shl uint get qdIoBuf p 16
put qdX i bitcast f32 bits
end
ret true
end

fn qdRmsNormLayer L ulong isPost bool to bool
b2048 = mul L QD_H
ss = f32 0.0f32
for i ulong QD_H
v = get qdX i
ss = add ss mul v v
end
inv = div 1.0f32 qdSqrt add div ss 2048.0f32 0.000001f32
if isPost
for i ulong QD_H
put qdXn i mul mul get qdX i inv get qdPostNormC add b2048 i
end
else
for i ulong QD_H
put qdXn i mul mul get qdX i inv get qdInNormC add b2048 i
end
end
ret qdWriteF32 get qdWork 0 QDW_XN 0 QD_H
end

fn qdGdnConvCh tBase ulong cBase ulong c ulong to void
tb = add tBase mul c 3
x0 = get qdGdnTail tb
x1 = get qdGdnTail add tb 1
x2 = get qdGdnTail add tb 2
x3 = get qdQkv c
wb = add cBase mul c 4
s = mul x0 get qdConvC wb
s = add s mul x1 get qdConvC add wb 1
s = add s mul x2 get qdConvC add wb 2
s = add s mul x3 get qdConvC add wb 3
put qdGdnTail tb x1
put qdGdnTail add tb 1 x2
put qdGdnTail add tb 2 x3
put qdQkv c qdSilu s
end

fn qdL2Norm128 base ulong scale f32 to void
sq = f32 0.000001f32
for d ulong 128
v = get qdQkv add base d
sq = add sq mul v v
end
inv = mul div 1.0f32 qdSqrt sq scale
for d ulong 128
idx = add base d
put qdQkv idx mul get qdQkv idx inv
end
end

fn qdGdnL2Norm to void
for hk ulong 16
qb = mul hk 128
qdL2Norm128 qb 0.08838835f32
qdL2Norm128 add 2048 qb 1.0f32
end
end

fn qdGdnConvNorm gdnIdx ulong to bool
tBase = mul gdnIdx 24576
cBase = mul gdnIdx 32768
for c ulong 8192
qdGdnConvCh tBase cBase c
end
qdGdnL2Norm
ret true
end

fn qdRunOutProj L ulong wOff ulong sOff ulong to bool
if not qdWriteF32 get qdWork 0 QDW_Y 1 4096
ret false
end
wbase = qdLayerWVa L
sbase = qdLayerSVa L
yVa = add get qdWorkVa 0 QDW_Y
oVa = add get qdWorkVa 0 QDW_AOUT
qdPktStart
if not qdEmitFp8 yVa add wbase wOff add sbase mul sOff 2 oVa 4096 2048
ret false
end
if not qdPktRun
ret false
end
ret qdReadF32 get qdWork 0 QDW_AOUT 2 2048
end

fn qdGdnEmitGpuStep L ulong gdnIdx ulong to bool
wbase = qdLayerWVa L
sbase = qdLayerSVa L
wva = get qdWorkVa 0
qdPktStart
qdPtr add wva QDW_QKV
qdPtr add wva QDW_Z
qdPtr add wva QDW_DB
qdPtr add get qdGdnStateVa 0 mul gdnIdx 2097152
qdPtr add sbase mul GDN_LIN_NORM 2
qdPtr add wva QDW_Y
if not qdPktEmitBx 5 32 128
ret false
end
if not qdEmitFp8 add wva QDW_Y add wbase GDN_OUT_W add sbase mul GDN_OUT_S 2 add wva QDW_AOUT 4096 2048
ret false
end
ret qdPktRun
end

fn qdStepGdn L ulong gdnIdx ulong to bool
wbase = qdLayerWVa L
sbase = qdLayerSVa L
wva = get qdWorkVa 0
xnVa = add wva QDW_XN
note 1. GPU packet 1: in_proj_qkv + in_proj_z + in_proj_a|b + GPU conv1d+SiLU+L2-norm (4 QMDs!)
qdPktStart
if not qdEmitFp8 xnVa add wbase GDN_QKV_W add sbase mul GDN_QKV_S 2 add wva QDW_QKV 2048 8192
ret false
end
if not qdEmitFp8 xnVa add wbase GDN_Z_W add sbase mul GDN_Z_S 2 add wva QDW_Z 2048 4096
ret false
end
if not qdEmitBf16 xnVa add wbase GDN_IN_A add wva QDW_AB 2048 64
ret false
end
qdPtr add wva QDW_QKV
qdPtr add sbase mul GDN_CONV 2
qdPtr add get qdGdnTailVa 0 mul gdnIdx 98304
if not qdPktEmitBx 9 64 128
ret false
end
if not qdPktRun
ret false
end
note 2. Tiny 64-float decay/beta on CPU (256 bytes read, 256 bytes written!)
if not qdReadF32 get qdWork 0 QDW_AB 14 64
ret false
end
b32 = mul gdnIdx 32
for h ulong 32
sp = qdSoftplus add get qdAbTmp h get qdDtC add b32 h
put qdDbTmp h qdExp mul get qdAlogC add b32 h sp
put qdDbTmp add 32 h qdSigmoid get qdAbTmp add 32 h
end
if not qdWriteF32 get qdWork 0 QDW_DB 5 64
ret false
end
note 3. GPU packet 2: exact FP32 gdn_step_real_f32 + out_proj (2 QMDs in ONE submit!)
if not qdGdnEmitGpuStep L gdnIdx
ret false
end
ret qdReadF32 get qdWork 0 QDW_AOUT 2 2048
end

global qdFaQn f32 256
global qdFaKn f32 256
global qdFaCs f32 32
global qdFaSn f32 32

fn qdRopePairQ qb ulong j ulong to void
i0 = add qb j
i1 = add i0 32
x0 = get qdQkv i0
x1 = get qdQkv i1
c = get qdFaCs j
s = get qdFaSn j
put qdQkv i0 sub mul x0 c mul x1 s
put qdQkv i1 add mul x1 c mul x0 s
end

fn qdFaNormRopeQ qb ulong to void
ss = f32 0.0f32
for d ulong 256
v = get qdQkv add qb d
ss = add ss mul v v
end
inv = div 1.0f32 qdSqrt add div ss 256.0f32 0.000001f32
for d ulong 256
idx = add qb d
put qdQkv idx mul mul get qdQkv idx inv get qdFaQn d
end
for j ulong 32
qdRopePairQ qb j
end
end

fn qdDotQK qb ulong cb ulong to f32
dot = f32 0.0f32
for d ulong 256
dot = add dot mul get qdQkv add qb d get qdKCache add cb d
end
ret dot
end

fn qdFaScores kvLayer ulong kh ulong qb ulong tLen ulong to f32
mx = f32 neg 1000000.0f32
for t ulong tLen bound 128
cb = add kvLayer add mul t 512 mul kh 256
sc = mul qdDotQK qb cb 0.0625f32
put qdScores t sc
if gt sc mx
mx = sc
end
end
sm = f32 0.0f32
for t ulong tLen bound 128
e = qdExp sub get qdScores t mx
put qdScores t e
sm = add sm e
end
ret div 1.0f32 sm
end

fn qdValAcc kvLayer ulong kh ulong tLen ulong d ulong to f32
acc = f32 0.0f32
for t ulong tLen bound 128
cb = add kvLayer add mul t 512 mul kh 256
acc = add acc mul get qdScores t get qdVCache add cb d
end
ret acc
end

fn qdFaWriteY kvLayer ulong kh ulong tLen ulong h ulong invSm f32 to void
yb = mul h 256
gb = add mul h 512 256
for d ulong 256
acc = mul qdValAcc kvLayer kh tLen d invSm
gv = qdSigmoid get qdQkv add gb d
put qdY add yb d mul acc gv
end
end

fn qdFaHeadAttend faIdx ulong pos ulong h ulong to void
kvLayer = mul faIdx 65536
tLen = add pos 1
qb = mul h 512
qdFaNormRopeQ qb
kh = div h 8
invSm = qdFaScores kvLayer kh qb tLen
qdFaWriteY kvLayer kh tLen h invSm
end

fn qdRopePairK kb ulong j ulong to void
i0 = add kb j
i1 = add i0 32
x0 = get qdK i0
x1 = get qdK i1
c = get qdFaCs j
s = get qdFaSn j
put qdK i0 sub mul x0 c mul x1 s
put qdK i1 add mul x1 c mul x0 s
end

fn qdFaNormKHead kb ulong to void
ss = f32 0.0f32
for d ulong 256
v = get qdK add kb d
ss = add ss mul v v
end
inv = div 1.0f32 qdSqrt add div ss 256.0f32 0.000001f32
for d ulong 256
idx = add kb d
put qdK idx mul mul get qdK idx inv get qdFaKn d
end
for j ulong 32
qdRopePairK kb j
end
end

fn qdFaNormRopeStoreK faIdx ulong pos ulong to void
kvLayer = mul faIdx 65536
for kh ulong 2
kb = mul kh 256
qdFaNormKHead kb
cb = add kvLayer add mul pos 512 kb
for d ulong 256
put qdKCache add cb d get qdK add kb d
put qdVCache add cb d get qdV add kb d
end
end
end

fn qdStepFullAttn L ulong faIdx ulong pos ulong to bool
wbase = qdLayerWVa L
sbase = qdLayerSVa L
xnVa = add get qdWorkVa 0 QDW_XN
qdPktStart
if not qdEmitFp8 xnVa add wbase FA_Q_W add sbase mul FA_Q_S 2 add get qdWorkVa 0 QDW_QKV 2048 8192
ret false
end
if not qdEmitFp8 xnVa add wbase FA_K_W add sbase mul FA_K_S 2 add get qdWorkVa 0 QDW_K 2048 512
ret false
end
if not qdEmitFp8 xnVa add wbase FA_V_W add sbase mul FA_V_S 2 add get qdWorkVa 0 QDW_V 2048 512
ret false
end
if not qdPktRun
ret false
end
if not qdReadF32 get qdWork 0 QDW_QKV 0 8192
ret false
end
if not qdReadF32 get qdWork 0 QDW_K 3 512
ret false
end
if not qdReadF32 get qdWork 0 QDW_V 4 512
ret false
end
b256 = mul faIdx 256
for d ulong 256
put qdFaQn d get qdQnC add b256 d
put qdFaKn d get qdKnC add b256 d
end
pf = f32 pos
for j ulong 32
th = mul pf get qdRopeFreq j
put qdFaCs j qdSinCos th true
put qdFaSn j qdSinCos th false
end
qdFaNormRopeStoreK faIdx pos
for h ulong 16
qdFaHeadAttend faIdx pos h
end
ret qdRunOutProj L FA_O_W FA_O_S
end

fn qdArbStep L ulong to void
if and gt L 0 eq get qdArbHasPred 0 1
for k ulong 8
id = uint get qdIds k
for p ulong 8
if eq get qdArbPred p id
put qdArbHits 0 add get qdArbHits 0 1
break
end
end
end
put qdArbTot 0 add get qdArbTot 0 8
end
idsLocal = new uint 8 0
for j ulong 8
put idsLocal j uint get qdIds j
end
q36ArbObserve L idsLocal
prLocal = new uint 8 0
if lt L 39
np = q36ArbPredict L idsLocal 8 prLocal
for q ulong 8
put qdArbPred q get prLocal q
end
put qdArbHasPred 0 1
else
put qdArbHasPred 0 0
end
end

fn qdRouterTop8 L ulong to void
mx = get qdRout 0
for e ulong 256
if gt get qdRout e mx
mx = get qdRout e
end
end
sm = f32 0.0f32
for e ulong 256
v = qdExp sub get qdRout e mx
put qdRout e v
sm = add sm v
end
used = new uchar 256 0
wsum = f32 0.0f32
for k ulong 8
bestE = ulong 0
bestV = f32 neg 1.0f32
for e ulong 256
if eq get used e 0
v = get qdRout e
if gt v bestV
bestV = v
bestE = e
end
end
end
put used bestE 1
put qdIds k bestE
put qdWts k div bestV sm
wsum = add wsum get qdWts k
end
for k ulong 8
put qdWts k div get qdWts k wsum
end
qdArbStep L
end

fn qdMoeSwiglu to bool
if not qdReadF32 get qdWork 0 QDW_EMID 6 8192
ret false
end
if not qdReadF32 get qdWork 0 QDW_SHMID 8 1024
ret false
end
for k ulong 8
base = mul k 1024
for d ulong 512
g = get qdEmid add base d
u = get qdEmid add base add d 512
put qdEmid add mul k 512 d mul qdSilu g u
end
end
for d ulong 512
g = get qdShMid d
u = get qdShMid add d 512
put qdShMid d mul qdSilu g u
end
if not qdWriteF32 get qdWork 0 QDW_EMID 2 4096
ret false
end
ret qdWriteF32 get qdWork 0 QDW_SHMID 3 512
end

fn qdMoeEmitExpGu L ulong isFa bool k ulong to bool
expW0 = GDN_EXP_W0
expS0 = GDN_EXP_S0
if isFa
expW0 = FA_EXP_W0
expS0 = FA_EXP_S0
end
rk = get qdLexRank get qdIds k
ew = add qdLayerWVa L add expW0 add mul rk QD_EXP_WSTRIDE 1048576
es = add qdLayerSVa L add mul expS0 2 add mul rk QD_EXP_SSTRIDE 256
eo = add get qdWorkVa 0 add QDW_EMID mul k 4096
ret qdEmitFp8 add get qdWorkVa 0 QDW_XN ew es eo 2048 1024
end

fn qdMoeEmitExpDn L ulong isFa bool k ulong to bool
expW0 = GDN_EXP_W0
expS0 = GDN_EXP_S0
if isFa
expW0 = FA_EXP_W0
expS0 = FA_EXP_S0
end
rk = get qdLexRank get qdIds k
ew = add qdLayerWVa L add expW0 mul rk QD_EXP_WSTRIDE
es = add qdLayerSVa L add mul expS0 2 mul rk QD_EXP_SSTRIDE
ei = add get qdWorkVa 0 add QDW_ESW mul k 2048
eo = add get qdWorkVa 0 add QDW_EOUT mul k 8192
ret qdEmitFp8 ei ew es eo 512 2048
end

fn qdMoeEmitShGu L ulong isFa bool to bool
shGuW = GDN_SH_GU_W
shGuS = GDN_SH_GU_S
if isFa
shGuW = FA_SH_GU_W
shGuS = FA_SH_GU_S
end
ew = add qdLayerWVa L shGuW
es = add qdLayerSVa L mul shGuS 2
eo = add get qdWorkVa 0 QDW_SHMID
ret qdEmitFp8 add get qdWorkVa 0 QDW_XN ew es eo 2048 1024
end

fn qdMoeEmitShDn L ulong isFa bool to bool
shDnW = GDN_SH_DN_W
shDnS = GDN_SH_DN_S
if isFa
shDnW = FA_SH_DN_W
shDnS = FA_SH_DN_S
end
ew = add qdLayerWVa L shDnW
es = add qdLayerSVa L mul shDnS 2
ei = add get qdWorkVa 0 add QDW_ESW 16384
eo = add get qdWorkVa 0 QDW_SHOUT
ret qdEmitFp8 ei ew es eo 512 2048
end

fn qdMoeRunAll L ulong isFa bool to bool
qdPktStart
for k ulong 8
if not qdMoeEmitExpGu L isFa k
ret false
end
end
if not qdMoeEmitShGu L isFa
ret false
end
qdPtr add get qdWorkVa 0 QDW_EMID
qdPtr add get qdWorkVa 0 QDW_ESW
if not qdPktEmitBx 6 18 256
ret false
end
for k ulong 8
if not qdMoeEmitExpDn L isFa k
ret false
end
end
if not qdMoeEmitShDn L isFa
ret false
end
qdPtr add get qdWorkVa 0 QDW_X
qdPtr add get qdWorkVa 0 QDW_EOUT
qdPtr add get qdWorkVa 0 QDW_WTS
if not qdPktEmitBx 8 8 256
ret false
end
ret qdPktRun
end

fn qdMoeCombine shScale f32 to void
for d ulong 2048
acc = mul shScale get qdShOut d
for k ulong 8
acc = add acc mul get qdWts k get qdEout add mul k 2048 d
end
put qdX d add get qdX d acc
end
end

fn qdStepMoe L ulong isFa bool to bool
wbase = qdLayerWVa L
xnVa = add get qdWorkVa 0 QDW_XN
gateOff = GDN_GATE
shGate = GDN_SH_GATE
if isFa
gateOff = FA_GATE
shGate = FA_SH_GATE
end
qdPktStart
if not qdEmitBf16 xnVa add wbase gateOff add get qdWorkVa 0 QDW_ROUT 2048 256
ret false
end
if not qdPktRun
ret false
end
if not qdReadF32 get qdWork 0 QDW_ROUT 5 256
ret false
end
qdRouterTop8 L
b2048 = mul L QD_H
shDot = f32 0.0f32
for d ulong 2048
shDot = add shDot mul get qdShGateC add b2048 d get qdXn d
end
shScale = qdSigmoid shDot
put qdWts 8 shScale
if not qdWriteF32 get qdWork 0 QDW_X 6 QD_H
ret false
end
if not qdWriteF32 get qdWork 0 QDW_WTS 7 9
ret false
end
if not qdMoeRunAll L isFa
ret false
end
ret qdReadF32 get qdWork 0 QDW_X 15 QD_H
end

fn qdLmPickTop64 to bool
topV = new f32 64 neg 1000000000.0f32
topI = new uint 64 0
minIdx = ulong 0
minVal = f32 neg 1000000000.0f32
for v ulong QD_VOCAB
s = get qdLogW4 v
if gt s minVal
put topV minIdx s
put topI minIdx uint v
minIdx = ulong 0
minVal = get topV 0
for j ulong 64
if lt get topV j minVal
minVal = get topV j
minIdx = j
end
end
end
end
for j ulong 64
w = get topI j
put qdCandIds j w
p = mul j 4
put qdIoBuf p uchar and w 255
put qdIoBuf add p 1 uchar and shr w 8 255
put qdIoBuf add p 2 uchar and shr w 16 255
put qdIoBuf add p 3 uchar and shr w 24 255
end
ret eq mapwrite get qdWork 0 QDW_CIDS qdIoBuf 0 256 256
end

fn qdLmCheckParity bestId ulong to bool
qdPktStart
if not qdEmitBf16 add get qdWorkVa 0 QDW_XN mapaddr get qdLmBf16 0 add get qdWorkVa 0 QDW_LOGBF uint QD_H uint QD_VOCAB
ret false
end
if not qdPktRun
ret false
end
if not qdReadF32 get qdWork 0 QDW_LOGBF 11 QD_VOCAB
ret false
end
bfId = ulong 0
bfMax = get qdLogBf 0
for v ulong QD_VOCAB
if gt get qdLogBf v bfMax
bfMax = get qdLogBf v
bfId = v
end
end
if eq bfId bestId
qdPrint qdMsgParOk
qdPrintU bestId
qdPrint qdMsgRp
else
qdPrint qdMsgParBad
qdPrintU bfId
qdPrint qdMsgEq
qdPrintU bestId
qdPrint qdMsgRp
end
ret true
end

fn qdReadCandIds to bool
if ne mapread get qdWork 0 QDW_CIDS qdIoBuf 0 256 256
ret false
end
for j ulong 64
p = mul j 4
b0 = uint get qdIoBuf p
b1 = shl uint get qdIoBuf add p 1 8
b2 = shl uint get qdIoBuf add p 2 16
b3 = shl uint get qdIoBuf add p 3 24
put qdCandIds j or or b0 b1 or b2 b3
end
ret true
end

fn qdRunLmHead checkParity bool to ulong
ss = f32 0.0f32
for i ulong QD_H
v = get qdX i
ss = add ss mul v v
end
inv = div 1.0f32 qdSqrt add div ss 2048.0f32 0.000001f32
for i ulong QD_H
put qdXn i mul mul get qdX i inv get qdFinalNorm i
end
if not qdWriteF32 get qdWork 0 QDW_XN 0 QD_H
ret 999999
end
note Single-submit 3-kernel W4 Two-Pass Exact lm_head: screen -> GPU chunk top-64 -> BF16 rescore!
qdPktStart
qdPtr get qdLmW4Va 0
qdPtr add get qdLmW4Va 0 254279680
qdPtr add get qdWorkVa 0 QDW_XN
qdPtr add get qdWorkVa 0 QDW_LOGW4
qdArg uint QD_VOCAB
if not qdPktEmitBx 3 7760 256
ret 999999
end
qdPtr add get qdWorkVa 0 QDW_LOGW4
qdPtr add get qdWorkVa 0 QDW_CIDS
if not qdPktEmitBx 7 64 256
ret 999999
end
qdPtr mapaddr get qdLmBf16 0
qdPtr add get qdWorkVa 0 QDW_XN
qdPtr add get qdWorkVa 0 QDW_CIDS
qdPtr add get qdWorkVa 0 QDW_CLOG
qdArg 64
if not qdPktEmitBx 4 64 32
ret 999999
end
if not qdPktRun
ret 999999
end
if not qdReadCandIds
ret 999999
end
if not qdReadF32 get qdWork 0 QDW_CLOG 12 64
ret 999999
end
bestId = ulong get qdCandIds 0
bestLog = get qdCandLog 0
for j ulong 64
if gt get qdCandLog j bestLog
bestLog = get qdCandLog j
bestId = ulong get qdCandIds j
end
end
if checkParity
if not qdLmCheckParity bestId
ret 999999
end
end
ret bestId
end

fn qdForwardToken tid ulong pos ulong runHead bool checkParity bool to ulong
if not qdLoadEmbed tid
ret 999999
end
put qdArbHasPred 0 0
q36ArbResetToken
gdnIdx = ulong 0
faIdx = ulong 0
for L ulong QD_LAYERS
isFa = eq rem L 4 3
if not qdRmsNormLayer L false
ret 999999
end
if isFa
if not qdStepFullAttn L faIdx pos
ret 999999
end
faIdx = add faIdx 1
else
if not qdStepGdn L gdnIdx
ret 999999
end
gdnIdx = add gdnIdx 1
end
for d ulong QD_H
put qdX d add get qdX d get qdAout d
end
if not qdRmsNormLayer L true
ret 999999
end
if not qdStepMoe L isFa
ret 999999
end
end
if not runHead
ret 0
end
ret qdRunLmHead checkParity
end

fn qdGpuInit to int
if not gbopen 1
ret 2
end
if not gbbopen
ret 3
end
put qdCodeMap 0 0
qdEmitAll
csize = mul div add get qdCodePos 0 4095 4096 4096
cm = nvalloc csize false
if le cm 0
ret 4
end
put qdCodeMap 0 cm
put qdCodeFail 0 0
qdEmitAll
if ne get qdCodeFail 0 0
ret 5
end
if not qdBuildFp8Lut
ret 6
end
put qdWork 0 nvalloc 33554432 true
if le get qdWork 0 0
ret 7
end
put qdWorkVa 0 mapaddr get qdWork 0
put qdLmBf16 0 nvalloc QD_LM_BYTES true
if le get qdLmBf16 0 0
ret 8
end
put qdLmW4 0 nvalloc 300000000 true
if le get qdLmW4 0 0
ret 9
end
put qdLmW4Va 0 mapaddr get qdLmW4 0
put qdScaleMap 0 nvalloc QD_SCALE_BYTES true
if le get qdScaleMap 0 0
ret 10
end
put qdScaleVa 0 mapaddr get qdScaleMap 0
put qdGdnStateMap 0 nvalloc 62914560 true
if le get qdGdnStateMap 0 0
ret 10
end
put qdGdnStateVa 0 mapaddr get qdGdnStateMap 0
for i ulong 65536
put qdIoBuf i 0
end
for z ulong 960
r = mapwrite get qdGdnStateMap 0 mul z 65536 qdIoBuf 0 65536
end
put qdGdnTailMap 0 nvalloc 2949120 true
if le get qdGdnTailMap 0 0
ret 10
end
put qdGdnTailVa 0 mapaddr get qdGdnTailMap 0
for z ulong 45
r = mapwrite get qdGdnTailMap 0 mul z 65536 qdIoBuf 0 65536
end
for s ulong 10
m = nvalloc QD_SLAB_BYTES true
if le m 0
ret 11
end
put qdSlabMap s m
put qdSlabVa s mapaddr m
end
ret 0
end

fn qdRunPrompt genN ulong to int
prompt = new ulong 17 0
put prompt 0 248045
put prompt 1 846
put prompt 2 198
put prompt 3 3710
put prompt 4 369
put prompt 5 279
put prompt 6 6511
put prompt 7 314
put prompt 8 9338
put prompt 9 30
put prompt 10 248046
put prompt 11 198
put prompt 12 248045
put prompt 13 74455
put prompt 14 198
put prompt 15 248068
put prompt 16 248069
qdPrint qdMsgPrefill
qdPrintU 17
nextTok = ulong 0
for p ulong 17
isLast = eq p 16
nextTok = qdForwardToken get prompt p p isLast isLast
if eq nextTok 999999
qdPrint qdErr
qdPrintU 50
qdPrint qdMsgNl
ret 15
end
end
genOut = new ulong 64 0
put genOut 0 nextTok
tDec0 = monons
pos = ulong 17
for g ulong sub genN 1 bound 64
nextTok = qdForwardToken nextTok pos true false
if eq nextTok 999999
qdPrint qdErr
qdPrintU 51
qdPrint qdMsgNl
ret 16
end
put genOut add g 1 nextTok
pos = add pos 1
end
tDecMs = div ulong sub monons tDec0 1000000
qdPrint qdMsgGen
for g ulong genN bound 64
qdPrintU get genOut g
qdPrint qdMsgSp
end
qdPrint qdMsgSummary
qdPrintU genN
qdPrint qdMsgAvgMs
avgMs = ulong 0
if gt genN 1
avgMs = div tDecMs sub genN 1
end
qdPrintU avgMs
qdPrint qdMsgArb
hitPct = ulong 0
if gt get qdArbTot 0 0
hitPct = div mul get qdArbHits 0 100 get qdArbTot 0
end
qdPrintU hitPct
qdPrint qdMsgNl
ret 0
end

fn qdLoadAll dbgOnly bool to int
qdPrint qdMsgLoad
tLoad0 = monons
if not qdLoadOutside
qdPrint qdErr
qdPrintU 30
qdPrint qdMsgNl
ret 12
end
nLay = QD_LAYERS
if dbgOnly
nLay = ulong 1
end
for L ulong nLay bound 40
if not qdLoadLayer L
qdPrint qdErr
qdPrintU add 100 L
qdPrint qdMsgNl
ret 13
end
end
if not dbgOnly
if not qdQuantLmHeadOnGpu
qdPrint qdErr
qdPrintU 40
qdPrint qdMsgNl
ret 14
end
end
tLoadMs = div ulong sub monons tLoad0 1000000
qdPrint qdMsgLoaded
qdPrintU tLoadMs
qdPrint qdMsgNl
ret 0
end

fn qdRunDbg to void
r0 = qdLoadEmbed 248045
r1 = qdRmsNormLayer 0 false
r2 = qdStepGdn 0 0
qdPrint qdDbgAout
qdPrintHex bitcast uint get qdAout 0
qdPrint qdMsgNl
end

fn main to int
qdPrint qdBanner
if lt argcnt 2
qdPrint qdUsage
ret 1
end
dlen = argread 1 qdDirBuf 0 250
if le dlen 0
ret 1
end
put qdDirLen 0 ulong dlen
genN = ulong 8
nb = new uchar 16 0
if ge argcnt 3
nl = argread 2 nb 0 15
if gt nl 0
v = ulong 0
for i ulong ulong nl bound 16
c = get nb i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
end
if and gt v 0 le v 99
genN = v
end
end
end
qdInitRopeFreq
qdInitLexRank
q36ArbResetAll
irc = qdGpuInit
if ne irc 0
qdPrint qdErr
qdPrintU ulong irc
qdPrint qdMsgNl
ret irc
end
dbgOnly = eq genN 99
lrc = qdLoadAll dbgOnly
if ne lrc 0
rc = nvmclose
ret lrc
end
if dbgOnly
qdRunDbg
r = fclose get qdOutFd 0
rc = nvmclose
ret 0
end
prc = qdRunPrompt genN
r = fclose get qdOutFd 0
rc = nvmclose
ret prc
end

qdPtr add w4 W4_DN_W
qdPtr add w4 W4_DN_S
qdPtr add wva QDW_IDS
qdPtr add wva QDW_EOUT
if not qdPktEmitGy 22 32 9 256
ret false
end
note FUSED 9-expert combine + residual add + NEXT-LAYER RMSNorm (-40 rmsnorm launches!)
nextNorm = add wva QDW_FNORM
if lt add L 1 QD_LAYERS
nextNorm = qdLayerSVa add L 1
end
qdPtr add wva QDW_X
qdPtr add wva QDW_EOUT
qdPtr add wva QDW_WTS
qdPtr nextNorm
qdPtr add wva QDW_XN
qdArg 1
ret qdPktEmitGy 23 1 1 256
end

fn qdEmitGdnLayerW4 L ulong gdnIdx ulong to bool
d4 = add qdLayerW4Va L W4_DENSE
sbase = qdLayerSVa L
wva = get qdWorkVa 0
xnVa = add wva QDW_XN
if eq L 0
if not qdEmitRmsNormAdd sbase 0
ret false
end
end
if not qdEmitW4Gemv4R xnVa d4 add d4 12582912 add wva QDW_QKV 2048 12288
ret false
end
if not qdEmitBf161R xnVa add d4 19927040 add wva QDW_AB 64
ret false
end
qdPtr add wva QDW_QKV
qdPtr add sbase mul GDN_CONV 2
qdPtr add get qdGdnTailVa 0 mul gdnIdx 98304
if not qdPktEmitGy 9 64 1 128
ret false
end
note Fused decay/beta + BF16 GDN state (64 iters, -63 MB/tok, -30 launches!) + Gated RMSNorm
qdPtr add wva QDW_QKV
qdPtr add wva QDW_Z
qdPtr add wva QDW_AB
qdPtr add wva add QDW_ALOG mul gdnIdx 256
qdPtr add get qdGdnStateVa 0 mul gdnIdx 2097152
qdPtr add sbase mul GDN_LIN_NORM 2
qdPtr add wva QDW_Y
if not qdPktEmitGy 21 32 1 128
ret false
end
if not qdEmitW4Gemv4R add wva QDW_Y add d4 14155776 add d4 18350080 add wva QDW_AOUT 4096 2048
ret false
end
if not qdEmitRmsNormAdd add sbase mul GDN_POST_NORM 2 1
ret false
end
note Fused high-occupancy 33-CTA router [256,2048] + sh_gate [1,2048] in ONE launch!
if not qdEmitBf161R xnVa add d4 18874368 add wva QDW_ROUT 257
ret false
end
ret qdEmitGpuMoeW4 L false
end

fn qdEmitFaLayerW4 L ulong faIdx ulong to bool
d4 = add qdLayerW4Va L W4_DENSE
sbase = qdLayerSVa L
wva = get qdWorkVa 0
xnVa = add wva QDW_XN
if eq L 0
if not qdEmitRmsNormAdd sbase 0
ret false
end
end
note Fused FA Q[8192] | K[512] | V[512] in ONE 4-row/warp W4 launch!
if not qdEmitW4Gemv4R xnVa d4 add d4 9437184 add wva QDW_QKV 2048 9216
ret false
end
kBase = add get qdKvVa 0 mul faIdx 2621440
vBase = add kBase 1310720
qdPtr add wva add QDW_QKV 32768
qdPtr add wva add QDW_QKV 34816
qdPtr add sbase mul FA_KNORM 2
qdPtr add wva QDW_ROPE
qdPtr kBase
qdPtr vBase
qdPtr add wva QDW_POS
if not qdPktEmitGy 14 2 1 256
ret false
end
qdPtr add wva QDW_QKV
qdPtr add sbase mul FA_QNORM 2
qdPtr add wva QDW_ROPE
qdPtr kBase
qdPtr vBase
qdPtr add wva QDW_Y
qdPtr add wva QDW_POS
if not qdPktEmitGy 15 16 1 256
ret false
end
if not qdEmitW4Gemv4R add wva QDW_Y add d4 10616832 add d4 14811136 add wva QDW_AOUT 4096 2048
ret false
end
if not qdEmitRmsNormAdd add sbase mul FA_POST_NORM 2 1
ret false
end
note Fused high-occupancy 33-CTA router [256,2048] + sh_gate [1,2048] in ONE launch!
if not qdEmitBf161R xnVa add d4 15335424 add wva QDW_ROUT 257
ret false
end
ret qdEmitGpuMoeW4 L true
end

fn qdEmitGdnLayerFull L ulong gdnIdx ulong to bool
if eq get qdUseW4 0 1
ret qdEmitGdnLayerW4 L gdnIdx
end
wbase = qdLayerWVa L
sbase = qdLayerSVa L
wva = get qdWorkVa 0
xnVa = add wva QDW_XN
if not qdEmitRmsNormAdd sbase 0
ret false
end
note Fused in_proj_qkv + in_proj_z [12288, 2048] in ONE launch!
if not qdEmitFp8 xnVa add wbase GDN_QKV_W add sbase mul GDN_QKV_S 2 add wva QDW_QKV 2048 12288
ret false
end
if not qdEmitBf16 xnVa add wbase GDN_IN_A add wva QDW_AB 2048 64
ret false
end
qdPtr add wva QDW_QKV
qdPtr add sbase mul GDN_CONV 2
qdPtr add get qdGdnTailVa 0 mul gdnIdx 98304
if not qdPktEmitGy 9 64 1 128
ret false
end
if not qdEmitGdnTail L gdnIdx
ret false
end
ret qdEmitGpuMoe L false
end

fn qdEmitFaHead L ulong to bool
wbase = qdLayerWVa L
sbase = qdLayerSVa L
wva = get qdWorkVa 0
xnVa = add wva QDW_XN
if not qdEmitRmsNormAdd sbase 0
ret false
end
if not qdEmitFp8 xnVa add wbase FA_Q_W add sbase mul FA_Q_S 2 add wva QDW_QKV 2048 8192
ret false
end
if not qdEmitFp8 xnVa add wbase FA_K_W add sbase mul FA_K_S 2 add wva QDW_K 2048 512
ret false
end
ret qdEmitFp8 xnVa add wbase FA_V_W add sbase mul FA_V_S 2 add wva QDW_V 2048 512
end

fn qdEmitFaTailAndMoe L ulong to bool
wbase = qdLayerWVa L
sbase = qdLayerSVa L
wva = get qdWorkVa 0
xnVa = add wva QDW_XN
if not qdEmitFp8 add wva QDW_Y add wbase FA_O_W add sbase mul FA_O_S 2 add wva QDW_AOUT 4096 2048
ret false
end
if not qdEmitRmsNormAdd add sbase mul FA_POST_NORM 2 1
ret false
end
if not qdEmitBf16 xnVa add wbase FA_GATE add wva QDW_ROUT 2048 256
ret false
end
if not qdEmitBf16 xnVa add wbase FA_SH_GATE add wva QDW_SHG 2048 1
ret false
end
ret qdEmitGpuMoe L true
end

fn qdEmitFaLayerFull L ulong faIdx ulong to bool
if eq get qdUseW4 0 1
ret qdEmitFaLayerW4 L faIdx
end
if not qdEmitFaHead L
ret false
end
sbase = qdLayerSVa L
wva = get qdWorkVa 0
kBase = add get qdKvVa 0 mul faIdx 2621440
vBase = add kBase 1310720
note GPU k_norm + partial RoPE + KV cache append
qdPtr add wva QDW_K
qdPtr add wva QDW_V
qdPtr add sbase mul FA_KNORM 2
qdPtr add wva QDW_ROPE
qdPtr kBase
qdPtr vBase
qdPtr add wva QDW_POS
if not qdPktEmitGy 14 2 1 256
ret false
end
note GPU q_norm + partial RoPE + GQA + sigmoid(gate) -> QDW_Y
qdPtr add wva QDW_QKV
qdPtr add sbase mul FA_QNORM 2
qdPtr add wva QDW_ROPE
qdPtr kBase
qdPtr vBase
qdPtr add wva QDW_Y
qdPtr add wva QDW_POS
if not qdPktEmitGy 15 16 1 256
ret false
end
ret qdEmitFaTailAndMoe L
end

fn qdEmitFinalHead to bool
wva = get qdWorkVa 0
if eq get qdUseW4 0 0
if not qdEmitRmsNormAdd add wva QDW_FNORM 0
ret false
end
end
qdPtr get qdLmW4Va 0
qdPtr add get qdLmW4Va 0 254279680
qdPtr add wva QDW_XN
qdPtr add wva QDW_LOGW4
qdArg uint QD_VOCAB
if not qdPktEmitGy 3 7760 1 256
ret false
end
qdPtr add wva QDW_LOGW4
qdPtr add wva QDW_CIDS
if not qdPktEmitGy 7 64 1 256
ret false
end
qdPtr mapaddr get qdLmBf16 0
qdPtr add wva QDW_XN
qdPtr add wva QDW_CIDS
qdPtr add wva QDW_CLOG
qdArg 128
ret qdPktEmitGy 4 128 1 32
end

fn qdEmitAll40Layers to bool
gdnIdx = ulong 0
faIdx = ulong 0
for L ulong QD_LAYERS
if eq rem L 4 3
if not qdEmitFaLayerFull L faIdx
ret false
end
faIdx = add faIdx 1
else
if not qdEmitGdnLayerFull L gdnIdx
ret false
end
gdnIdx = add gdnIdx 1
end
end
ret true
end

fn qdRecordAllPackets to bool
note Slot 0: ALL 40 REAL LAYERS + FINAL NORM + W4 TWO-PASS EXACT LM_HEAD IN ONE SINGLE GPFIFO SUBMIT!!
qdPktStartAt QDW_PKT
if not qdEmitAll40Layers
ret false
end
if not qdEmitFinalHead
ret false
end
if not qdPktFinish 0
ret false
end
note Slot 1: ALL 40 REAL LAYERS ONLY (for prefill tokens)
qdPktStartAt add QDW_PKT 2097152
if not qdEmitAll40Layers
ret false
end
ret qdPktFinish 1
end

fn qdForwardToken tid ulong pos ulong runHead bool checkParity bool to ulong
if not qdLoadEmbed tid
ret 999999
end
w = uint pos
put qdIoBuf 0 uchar and w 255
put qdIoBuf 1 uchar and shr w 8 255
put qdIoBuf 2 uchar and shr w 16 255
put qdIoBuf 3 uchar and shr w 24 255
if ne mapwrite get qdWork 0 QDW_POS qdIoBuf 0 4 4
ret 999999
end
if not runHead
if not qdReplayPre 1
ret 999999
end
ret 0
end
if not qdReplayPre 0
ret 999999
end
if not qdReadCandIds
ret 999999
end
if not qdReadF32 get qdWork 0 QDW_CLOG 12 128
ret 999999
end
bestId = ulong get qdCandIds 0
bestLog = get qdCandLog 0
for j ulong 128
if gt get qdCandLog j bestLog
bestLog = get qdCandLog j
bestId = ulong get qdCandIds j
end
end
if checkParity
if not qdLmCheckParity bestId
ret 999999
end
end
ret bestId
end

fn qdGpuInit to int
if not gbopen 1
ret 2
end
if not gbbopen
ret 3
end
put qdCodeMap 0 0
qdEmitAll
csize = mul div add get qdCodePos 0 4095 4096 4096
cm = nvalloc csize false
if le cm 0
ret 4
end
put qdCodeMap 0 cm
put qdCodeFail 0 0
qdEmitAll
if ne get qdCodeFail 0 0
ret 5
end
if not qdBuildFp8Lut
ret 6
end
put qdWork 0 nvalloc 33554432 true
if le get qdWork 0 0
ret 7
end
put qdWorkVa 0 mapaddr get qdWork 0
put qdLmBf16 0 nvalloc QD_LM_BYTES true
if le get qdLmBf16 0 0
ret 8
end
put qdLmW4 0 nvalloc 300000000 true
if le get qdLmW4 0 0
ret 9
end
put qdLmW4Va 0 mapaddr get qdLmW4 0
put qdScaleMap 0 nvalloc QD_SCALE_BYTES true
if le get qdScaleMap 0 0
ret 10
end
put qdScaleVa 0 mapaddr get qdScaleMap 0
put qdGdnStateMap 0 nvalloc 62914560 true
if le get qdGdnStateMap 0 0
ret 10
end
put qdGdnStateVa 0 mapaddr get qdGdnStateMap 0
for i ulong 65536
put qdIoBuf i 0
end
for z ulong 960
r = mapwrite get qdGdnStateMap 0 mul z 65536 qdIoBuf 0 65536
end
put qdGdnTailMap 0 nvalloc 2949120 true
if le get qdGdnTailMap 0 0
ret 10
end
put qdGdnTailVa 0 mapaddr get qdGdnTailMap 0
for z ulong 45
r = mapwrite get qdGdnTailMap 0 mul z 65536 qdIoBuf 0 65536
end
note Upload 256-entry lexRank table to QDW_LEXMAP
for e ulong 256
w = uint get qdLexRank e
p = mul e 4
put qdIoBuf p uchar and w 255
put qdIoBuf add p 1 uchar and shr w 8 255
put qdIoBuf add p 2 uchar and shr w 16 255
put qdIoBuf add p 3 uchar and shr w 24 255
end
r = mapwrite get qdWork 0 QDW_LEXMAP qdIoBuf 0 1024
note Allocate GPU KV cache (10 layers x 128 pos x 2 kv x 256 f32 x 2 = 25 MB)
put qdKvMap 0 nvalloc 26214400 true
if le get qdKvMap 0 0
ret 10
end
put qdKvVa 0 mapaddr get qdKvMap 0
note Precompute RoPE cos/sin table [128, 64] into QDW_ROPE
for pos ulong 128
pf = f32 pos
for j ulong 32
th = mul pf get qdRopeFreq j
qdPutF32Io mul add mul pos 64 j 4 qdSinCos th true
qdPutF32Io mul add mul pos 64 add 32 j 4 qdSinCos th false
end
end
r = mapwrite get qdWork 0 QDW_ROPE qdIoBuf 0 32768
if eq get qdUseW4 0 1
m0 = nvalloc QD_LAYER_STRIDE true
if le m0 0
ret 11
end
put qdSlabMap 0 m0
put qdSlabVa 0 mapaddr m0
for s ulong 6
mw = nvalloc QD_W4_SLAB true
if le mw 0
ret 11
end
put qdW4Map s mw
put qdW4Va s mapaddr mw
end
else
for s ulong 10
m = nvalloc QD_SLAB_BYTES true
if le m 0
ret 11
end
put qdSlabMap s m
put qdSlabVa s mapaddr m
end
end
ret 0
end

fn qdRunPrompt genN ulong to int
prompt = new ulong 17 0
put prompt 0 248045
put prompt 1 846
put prompt 2 198
put prompt 3 3710
put prompt 4 369
put prompt 5 279
put prompt 6 6511
put prompt 7 314
put prompt 8 9338
put prompt 9 30
put prompt 10 248046
put prompt 11 198
put prompt 12 248045
put prompt 13 74455
put prompt 14 198
put prompt 15 248068
put prompt 16 248069
qdPrint qdMsgPrefill
qdPrintU 17
nextTok = ulong 0
for p ulong 17
isLast = eq p 16
nextTok = qdForwardToken get prompt p p isLast isLast
if eq nextTok 999999
qdPrint qdErr
qdPrintU 50
qdPrint qdMsgNl
ret 15
end
end
genOut = new ulong 64 0
put genOut 0 nextTok
tDec0 = monons
pos = ulong 17
for g ulong sub genN 1 bound 64
nextTok = qdForwardToken nextTok pos true false
if eq nextTok 999999
qdPrint qdErr
qdPrintU 51
qdPrint qdMsgNl
ret 16
end
put genOut add g 1 nextTok
pos = add pos 1
end
tDecUs = div ulong sub monons tDec0 1000
qdPrint qdMsgGen
for g ulong genN bound 64
qdPrintU get genOut g
qdPrint qdMsgSp
end
qdPrint qdMsgSummary
qdPrintU genN
qdPrint qdMsgAvgMs
avgUs = ulong 0
tpsX100 = ulong 0
if gt genN 1
avgUs = div tDecUs sub genN 1
if gt avgUs 0
tpsX100 = div 100000000 avgUs
end
end
qdPrintU avgUs
qdPrint qdMsgTps
qdPrintU tpsX100
qdPrint qdMsgArb
hitPct = ulong 0
if gt get qdArbTot 0 0
hitPct = div mul get qdArbHits 0 100 get qdArbTot 0
end
qdPrintU hitPct
qdPrint qdMsgNl
ret 0
end

fn qdLoadAll dbgOnly bool to int
qdPrint qdMsgLoad
tLoad0 = monons
if not qdLoadOutside
qdPrint qdErr
qdPrintU 30
qdPrint qdMsgNl
ret 12
end
nLay = QD_LAYERS
if dbgOnly
nLay = ulong 1
end
for L ulong nLay bound 40
if not qdLoadLayer L
qdPrint qdErr
qdPrintU add 100 L
qdPrint qdMsgNl
ret 13
end
end
if not dbgOnly
if not qdQuantLmHeadOnGpu
qdPrint qdErr
qdPrintU 40
qdPrint qdMsgNl
ret 14
end
if not qdRecordAllPackets
qdPrint qdErr
qdPrintU 41
qdPrint qdMsgNl
ret 14
end
end
tLoadMs = div ulong sub monons tLoad0 1000000
qdPrint qdMsgLoaded
qdPrintU tLoadMs
qdPrint qdMsgNl
ret 0
end

fn qdPrintHex4 f f32 to void
w = bitcast uint f
qdPrintU ulong w
qdPrint qdMsgSp
end

fn qdDbgDumpIo off ulong to void
r = mapread get qdW4Map 0 off qdIoBuf 0 16
for i ulong 4
qdPrintU ulong bitcast uint qdGetF32Io mul i 4
qdPrint qdMsgSp
end
qdPrint qdMsgNl
end

fn qdRunDbg to void
r = qdLoadEmbed 248045
wva = get qdWorkVa 0
sbase = qdLayerSVa 0
qdPktStart
r = qdEmitRmsNormAdd sbase 0
r = qdEmitFp8 add wva QDW_XN add get qdSlabVa 0 GDN_QKV_W add sbase mul GDN_QKV_S 2 add wva QDW_QKV 2048 12288
r = qdPktRun
r = qdReadF32 get qdWork 0 QDW_QKV 4 8
for i ulong 4
qdPrintHex4 get qdQkv i
end
qdPrint qdMsgNl
if eq get qdUseW4 0 1
d4 = add qdLayerW4Va 0 W4_DENSE
qdPktStart
r = qdEmitW4Gemv add wva QDW_XN d4 add d4 12582912 add wva QDW_QKV 2048 12288
r = qdPktRun
r = qdReadF32 get qdWork 0 QDW_QKV 4 8
for i ulong 4
qdPrintHex4 get qdQkv i
end
qdPrint qdMsgNl
qdDbgDumpIo W4_DENSE
qdDbgDumpIo add W4_DENSE 12582912
end
end

fn main to int
qdPrint qdBanner
if lt argcnt 2
qdPrint qdUsage
ret 1
end
dlen = argread 1 qdDirBuf 0 250
if le dlen 0
ret 1
end
put qdDirLen 0 ulong dlen
genN = ulong 8
nb = new uchar 16 0
if ge argcnt 3
nl = argread 2 nb 0 15
if gt nl 0
v = ulong 0
for i ulong ulong nl bound 16
c = get nb i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
end
if and gt v 0 le v 99
genN = v
end
end
end
put qdUseW4 0 0
wb = new uchar 16 0
if ge argcnt 4
wl = argread 3 wb 0 15
if and ge wl 2 eq get wb 0 119
put qdUseW4 0 1
end
end
qdInitRopeFreq
qdInitLexRank
q36ArbResetAll
irc = qdGpuInit
if ne irc 0
qdPrint qdErr
qdPrintU ulong irc
qdPrint qdMsgNl
ret irc
end
dbgOnly = eq genN 99
lrc = qdLoadAll dbgOnly
if ne lrc 0
rc = nvmclose
ret lrc
end
if dbgOnly
qdRunDbg
r = fclose get qdOutFd 0
rc = nvmclose
ret 0
end
prc = qdRunPrompt genN
r = fclose get qdOutFd 0
rc = nvmclose
ret prc
end

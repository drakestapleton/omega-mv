qdPtr addInVa
qdPtr wNormVa
qdPtr add pva QP_XN
qdPtr add pva QP_XNB
qdArg doAdd
ret qdPktEmitGy 26 uint B 1 256
end

fn qdPreEmitF32ToBf16 srcVa ulong dstVa ulong totalPairs uint to bool

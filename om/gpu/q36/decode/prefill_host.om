ret false
end
end
qdPreSetStr 1024 0 9216 0
qdPreSetKN 2048 9216 B
if not qdPreEmitW4Gemm add pva QP_XNB d4 add d4 9437184 add pva QP_QKV
ret false
end
kBase = get qdKvVa faIdx
vBase = add kBase 268435456
qdPtr add pva QP_QKV
qdPtr add sbase mul FA_KNORM 2
qdPtr get qdRopeVa 0
qdPtr kBase
qdPtr vBase
qdPtr add get qdPreCtlVa 0 QP_POS0
if not qdPktEmitGy 34 2 uint B 256
ret false
end
qdPtr add pva QP_QKV
qdPtr add sbase mul FA_QNORM 2
qdPtr get qdRopeVa 0
qdPtr add pva QP_YB
qdPtr add get qdPreCtlVa 0 QP_POS0
if not qdPktEmitGy 42 16 uint B 256
ret false
end
qdPtr add pva QP_YB
qdPtr add pva QP_QKV
qdPtr kBase
qdPtr vBase
qdPtr add pva QP_Y
qdPtr add get qdPreCtlVa 0 QP_POS0
qdArg uint B
if not qdPktEmitGy 35 16 uint div add B 15 16 256
ret false
end
if not qdPreEmitF32ToBf16 add pva QP_Y add pva QP_YB uint mul B 2048
ret false
end
qdPreSetStr 2048 0 2048 0
qdPreSetKN 4096 2048 B
if not qdPreEmitW4Gemm add pva QP_YB add d4 10616832 add d4 14811136 add pva QP_AOUT
ret false
end
if not qdPreEmitRmsNorm add sbase mul FA_POST_NORM 2 add pva QP_AOUT 1 B
ret false
end
ret qdPreEmitMoeW4 L true B
end

fn qdPreEmitAll40W4 B ulong to bool
gdnIdx = ulong 0
faIdx = ulong 0
for L ulong QD_LAYERS
if eq rem L 4 3
if not qdPreEmitFaLayerW4 L faIdx B
ret false
end
faIdx = add faIdx 1
else
if not qdPreEmitGdnLayerW4 L gdnIdx B
ret false
end
gdnIdx = add gdnIdx 1
end
end
ret true
end

fn qdPreEmitFinalHead B ulong to bool
pva = get qdPreVa 0
wva = get qdWorkVa 0
lastXn = add pva add QP_XN mul sub B 1 8192
qdPtr get qdLmW4Va 0
qdPtr add get qdLmW4Va 0 254279680
qdPtr lastXn
qdPtr qdW QDI_LOGW4
qdArg uint QD_VOCAB
if not qdPktEmitGy 3 7760 1 256
ret false
end
qdPtr qdW QDI_LOGW4
qdPtr qdW QDI_CIDS
if not qdPktEmitGy 7 64 1 256
ret false
end
qdPtr mapaddr get qdLmBf16 0
qdPtr lastXn
qdPtr qdW QDI_CIDS
qdPtr qdW QDI_CLOG
qdArg 128
ret qdPktEmitGy 4 128 1 32
end

fn qdPreEmitFinalHeadSpec M ulong to bool
pva = get qdPreVa 0
note 1. Single-read Tensor Core W4 lm_head screen across ALL M tokens [M, 248320]
qdPtr add pva QP_XNB
qdPtr get qdLmW4Va 0
qdPtr add get qdLmW4Va 0 254279680
qdPtr add pva QP_SPEC_LOG
qdArg 2048
qdArg uint QD_VOCAB
qdArg uint M
qdArg 1024
qdArg 0
qdArg uint QD_VOCAB
qdArg 0
if not qdPktEmitGy 47 3880 1 128
ret false
end
note 2. Exact top-128 BF16 rescore for each t = 0..M-1
for t ulong M bound 16
logVa = add pva add QP_SPEC_LOG mul t 993280
cidsVa = add pva add QP_SPEC_CIDS mul t 512
clogVa = add pva add QP_SPEC_CLOG mul t 512
xnVa = add pva add QP_XN mul t 8192
qdPtr logVa
qdPtr cidsVa
if not qdPktEmitGy 7 64 1 256
ret false
end
qdPtr mapaddr get qdLmBf16 0
qdPtr xnVa
qdPtr cidsVa
qdPtr clogVa
qdArg 128
if not qdPktEmitGy 4 128 1 32
ret false
end
end
ret true
end

fn qdSpecEmitVerifyPkt M ulong to bool
sva = get qdSpecVa 0
qdPktStartAt add qdO QDI_PKT 16777216
if not qdEmitCopyU32 get qdGdnStateVa 0 add sva QSP_GDN_STATE 62914560
ret false
end
if not qdEmitCopyU32 get qdGdnTailVa 0 add sva QSP_GDN_TAIL 2949120
ret false
end
put qdSpecMode 0 1
ok = qdPreEmitAll40W4 M
put qdSpecMode 0 0
if not ok
ret false
end
if not qdPreEmitFinalHeadSpec M
ret false
end
ret qdPktFinish 6
end

fn qdSpecRollbackGdn acc ulong to bool
pva = get qdPreVa 0
sva = get qdSpecVa 0
qdPktStart
if not qdEmitCopyU32 add sva QSP_GDN_STATE get qdGdnStateVa 0 62914560
ret false
end
if not qdEmitCopyU32 add sva QSP_GDN_TAIL get qdGdnTailVa 0 2949120
ret false
end
gdnIdx = ulong 0
for L ulong QD_LAYERS
if ne rem L 4 3
sbase = qdLayerSVa L
qkvSrc = add sva add QSP_QKV mul gdnIdx 393216
abSrc = add sva add QSP_AB mul gdnIdx 2048
if not qdEmitCopyU32 qkvSrc add pva QP_QKV mul acc 49152
ret false
end
qdPtr add pva QP_QKV
qdPtr add sbase mul GDN_CONV 2
qdPtr add get qdGdnTailVa 0 mul gdnIdx 98304
qdArg uint acc
if not qdPktEmitGy 30 32 1 256
ret false
end
alogVa = add qdW QDI_ALOG mul gdnIdx 256
qdPtr add pva QP_QKV
qdPtr abSrc
qdPtr alogVa
qdPtr add alogVa 128
qdPtr add pva QP_DB
if not qdPktEmitGy 31 32 uint acc 128
ret false
end
qdPtr add pva QP_QKV
qdPtr add pva QP_DB
qdPtr add get qdGdnStateVa 0 mul gdnIdx 2097152
qdPtr add pva QP_Y
qdArg uint acc
if not qdPktEmitGy 32 32 4 256
ret false
end
gdnIdx = add gdnIdx 1
end
end
ret qdPktRun
end

fn qdSpecReadPreds M ulong to bool
nb = mul M 512
if ne mapread get qdPreMap 0 QP_SPEC_CIDS qdIoBuf 0 nb long nb
ret false
end
for t ulong M bound 16
base = mul t 512
for j ulong 128
p = add base mul j 4
b0 = uint get qdIoBuf p
b1 = shl uint get qdIoBuf add p 1 8
b2 = shl uint get qdIoBuf add p 2 16
b3 = shl uint get qdIoBuf add p 3 24
put qdCandIds j or or b0 b1 or b2 b3
end
if not qdReadF32 get qdPreMap 0 add QP_SPEC_CLOG base 12 128
ret false
end
bestId = ulong get qdCandIds 0
bestLog = get qdCandLog 0
for j ulong 128
if gt get qdCandLog j bestLog
bestLog = get qdCandLog j
bestId = ulong get qdCandIds j
end
end
put qdSpecPred t bestId
end
ret true
end

fn qdSpecVerifyStep M ulong pos0 ulong to ulong
for t ulong M bound 16
put qdPreTokIds t uint get qdSpecDraft t
end
if not qdPreUploadToks M pos0
ret 0
end
if not qdKickPre 6
ret 0
end
if not qdWaitPre
ret 0
end
if not qdSpecReadPreds M
ret 0
end
acc = ulong 1
for k ulong sub M 1 bound 16
if eq get qdSpecPred k get qdSpecDraft add k 1
acc = add k 2
else
break
end
end
if lt acc M
if not qdSpecRollbackGdn acc
ret 0
end
end
if qdPreSnapTrace M
qdPreUpdateArborisSnap acc
end
ret acc
end

fn qdSpecMatchNgram pos ulong nLen ulong hlen ulong to bool
tail = sub hlen nLen
for j ulong nLen bound 4
if ne get qdHistToks add pos j get qdHistToks add tail j
ret false
end
end
ret true
end

fn qdSpecFindNgram nLen ulong hlen ulong to ulong
lim = sub hlen nLen
for idx ulong lim bound 131072
pos = sub sub lim 1 idx
if qdSpecMatchNgram pos nLen hlen
ret add pos nLen
end
end
ret 0
end

fn qdSpecDraftNgram curTok ulong M ulong to void
put qdSpecDraft 0 curTok
hlen = get qdHistLen 0
for s ulong sub M 1 bound 16
put qdSpecDraft add s 1 curTok
end
if lt hlen 2
ret
end
for ng ulong 4
nLen = sub 4 ng
if ge hlen nLen
bestPos = qdSpecFindNgram nLen hlen
if gt bestPos 0
for s ulong sub M 1 bound 16
if lt add bestPos s hlen
put qdSpecDraft add s 1 get qdHistToks add bestPos s
end
end
ret
end
end
end
end


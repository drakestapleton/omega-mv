fn qdPreEmitKernels to void
for ki ulong 17
p = mul div add get qdCodePos 0 255 256 256
put qdEntry add 26 ki p
put qdCodePos 0 p
put q36Pc 0 0
put q36Guard 0 0
ok = q36PreKernel uchar add 130 ki
if not ok
exit 4
end
q36Done
end
put qdSmem 26 32
put qdSmem 27 0
put qdSmem 28 2048
put qdSmem 29 2048
put qdSmem 30 0
put qdSmem 31 32
put qdSmem 32 0
put qdSmem 33 544
put qdSmem 34 1088
put qdSmem 35 20736
put qdSmem 36 1088
put qdSmem 37 17408
put qdSmem 38 2304
put qdSmem 39 0
put qdSmem 40 32
put qdSmem 41 0
put qdSmem 42 1088
note 47: qPreLmHeadW4Hmma (mode 147), 48: qPreCopyU32 (mode 148)
for sk ulong 2
p = mul div add get qdCodePos 0 255 256 256
put qdEntry add 47 sk p
put qdCodePos 0 p
put q36Pc 0 0
put q36Guard 0 0
ok = q36PreKernel uchar add 147 sk
if not ok
exit 4
end
q36Done
end
put qdSmem 47 2048
put qdSmem 48 0
end

fn qdEmitCopyU32 srcVa ulong dstVa ulong nBytes ulong to bool
qdPtr srcVa
qdPtr dstVa
qdArg uint div nBytes 16
ret qdPktEmitGy 48 256 1 256
end

fn qdPreEmitGatherEmbeds B ulong to bool
pva = get qdPreVa 0
qdPtr add get qdPreCtlVa 0 QP_TOKS
qdPtr mapaddr get qdEmbBf16 0
qdPtr add pva QP_X
ret qdPktEmitGy 41 uint B 1 256
end

fn qdPreEmitRmsNorm wNormVa ulong addInVa ulong doAdd uint B ulong to bool

fn qdSpecPrefill17 saveHist bool to ulong
prompt = new ulong 19 0
qdSpecFillPrompt prompt
qdResetState
if saveHist
for p ulong 19
put qdHistToks p get prompt p
end
put qdHistLen 0 19
end
nextTok = ulong 0
for p ulong 19
isLast = eq p 18
nextTok = qdForwardToken get prompt p p isLast false
if eq nextTok 999999
ret 999999
end
end
ret nextTok
end

fn qdSpecBenchN1 genN ulong to ulong
nextTok = qdSpecPrefill17 false
if eq nextTok 999999
ret 0
end
put qdRefOut 0 nextTok
t0 = monons
pos = ulong 19
for g ulong sub genN 1 bound 64
nextTok = qdForwardToken nextTok pos true false
if eq nextTok 999999
ret 0
end
put qdRefOut add g 1 nextTok
pos = add pos 1
end
n1Us = div ulong sub monons t0 1000
n1Avg = div n1Us sub genN 1
n1Tps = div 100000000 n1Avg
qdPrint qpMsgSpecN1
qdPrintU genN
qdPrint qdMsgAvgMs
qdPrintU n1Avg
qdPrint qdMsgTps
qdPrintU n1Tps
qdPrint qdMsgNl
ret n1Avg
end

global qdSpecSt ulong 4

fn qdSpecCommitAcc acc ulong genN ulong saveHist bool to void
prod = get qdSpecSt 0
ex = get qdSpecSt 1
for k ulong acc bound 16
tokK = get qdSpecPred k
if lt prod genN
if ne tokK get qdRefOut prod
ex = ulong 0
end
if saveHist
hl = get qdHistLen 0
put qdHistToks hl tokK
put qdHistLen 0 add hl 1
end
prod = add prod 1
end
end
put qdSpecSt 0 prod
put qdSpecSt 1 ex
end

fn qdSpecBenchNgram genN ulong M ulong to bool
nextTok = qdSpecPrefill17 true
if eq nextTok 999999
ret false
end
put qdHistToks 19 nextTok
put qdHistLen 0 20
put qdSpecSt 0 1
put qdSpecSt 1 1
if ne nextTok get qdRefOut 0
put qdSpecSt 1 0
end
steps = ulong 0
pos = ulong 19
t1 = monons
while lt get qdSpecSt 0 genN bound 64
qdSpecDraftNgram nextTok M
acc = qdSpecVerifyStep M pos
if eq acc 0
ret false
end
steps = add steps 1
qdSpecCommitAcc acc genN true
nextTok = get qdSpecPred sub acc 1
pos = add pos acc
end
ngUs = div ulong sub monons t1 1000
ngAvg = div ngUs sub get qdSpecSt 0 1
qdPrint qpMsgSpecNg
qdPrintU M
if eq get qdSpecSt 1 1
qdPrint qpMsgSpecParOk
else
qdPrint qpMsgSpecParBad
end
qdPrintU steps
qdPrint qpMsgSpecAcc
qdPrintU div mul sub get qdSpecSt 0 1 100 steps
qdPrint qdMsgAvgMs
qdPrintU ngAvg
qdPrint qdMsgTps
qdPrintU div 100000000 ngAvg
qdPrint qdMsgNl
ret eq get qdSpecSt 1 1
end

fn qdSpecFillOracle nextTok ulong prod ulong genN ulong M ulong to void
put qdSpecDraft 0 nextTok
for s ulong sub M 1 bound 16
idx = add prod s
if lt idx genN
put qdSpecDraft add s 1 get qdRefOut idx
else
put qdSpecDraft add s 1 nextTok
end
end
end

fn qdSpecBenchVerify genN ulong M ulong n1Avg ulong to bool
nextTok = qdSpecPrefill17 false
if eq nextTok 999999
ret false
end
put qdSpecSt 0 1
put qdSpecSt 1 1
if ne nextTok get qdRefOut 0
put qdSpecSt 1 0
end
steps = ulong 0
pos = ulong 19
t2 = monons
while lt get qdSpecSt 0 genN bound 64
qdSpecFillOracle nextTok get qdSpecSt 0 genN M
acc = qdSpecVerifyStep M pos
if eq acc 0
ret false
end
steps = add steps 1
qdSpecCommitAcc acc genN false
nextTok = get qdSpecPred sub acc 1
pos = add pos acc
end
vfUs = div ulong sub monons t2 1000
vfAvg = div vfUs sub get qdSpecSt 0 1
qdPrint qpMsgSpecVf
qdPrintU M
if eq get qdSpecSt 1 1
qdPrint qpMsgSpecParOk
else
qdPrint qpMsgSpecParBad
end
qdPrintU steps
qdPrint qpMsgSpecAcc
qdPrintU div mul sub get qdSpecSt 0 1 100 steps
qdPrint qdMsgAvgMs
qdPrintU vfAvg
qdPrint qdMsgTps
qdPrintU div 100000000 vfAvg
qdPrint qpMsgSpecSpd
qdPrintU div mul n1Avg 100 vfAvg
qdPrint qdMsgNl
ret eq get qdSpecSt 1 1
end

fn qdRunSpecBench genN ulong M ulong to int
qdPrint qpMsgSpecHdr
qdPrintU M
qdPrint qdMsgRp
n1Avg = qdSpecBenchN1 genN
if eq n1Avg 0
ret 15
end
if not qdSpecEmitVerifyPkt M
ret 17
end
ok1 = qdSpecBenchNgram genN M
ok2 = qdSpecBenchVerify genN M n1Avg
if or not ok1 not ok2
ret 22
end
ret 0
end

note =========================================================================
note Phase 2 Exit Gate: QDI_WTBL + QDI_FASTW 1000-soak + 128K INT8 KV
note =========================================================================
fn qdP2SetU64 off ulong val ulong to void
wm = get qdWork 0
r0 = mapset wm off 4 ulong gblo val
r1 = mapset wm add off 4 4 ulong gbhi val
end

fn qdP2TestWtbl to bool
note Source table: [0] = real QDI_FNORM, [1] = perturbed QDI_AB (negative control)
qdP2SetU64 qdO QDI_WTBL_SRC qdW QDI_FNORM
qdP2SetU64 add qdO QDI_WTBL_SRC 8 qdW QDI_AB
note Fill perturbed norm buffer (QDI_ROPE) with -2.0f32 so (1 + w) = -1.0f32 flips all logits!
for i ulong 2048
qdPutF32Io mul i 4 -2.0f32
end
r0 = mapwrite get qdWork 0 qdO QDI_ROPE qdIoBuf 0 8192
qdP2SetU64 add qdO QDI_WTBL_SRC 8 qdW QDI_ROPE
note Run identity control (sel = 0 -> real QDI_FNORM)
r1 = mapset get qdWork 0 qdO QDI_WTBL_SEL 4 0
tokId = qdSpecPrefill17 false
note Flip ONLY QDI_WTBL_SEL = 1 on GPU (ZERO packet re-recording!) -> negative control
r2 = mapset get qdWork 0 qdO QDI_WTBL_SEL 4 1
tokNeg = qdSpecPrefill17 false
r3 = mapset get qdWork 0 qdO QDI_WTBL_SEL 4 0
ok = and ne tokId 999999 and ne tokNeg 999999 ne tokId tokNeg
if ok
qdPrint qpMsgP2WtblOk
else
qdPrint qpMsgP2WtblBad
end
qdPrintU tokId
qdPrint qpMsgP2WtblNeg
qdPrintU tokNeg
qdPrint qdMsgRp
ret ok
end

fn qdP2InitFastW to void
note Initialize A[8, 2048] deterministically with non-zero projection onto x so k_t = A@x/sqrt(2048) != 0
for i ulong 16384
v = f32 0.1f32
if eq rem i 3 1
v = f32 -0.02f32
end
qdPutF32Io mul i 4 v
end
r0 = mapwrite get qdWork 0 qdO QDI_FASTW qdIoBuf 0 65536
for i ulong 65536
put qdIoBuf i 0
end
r1 = mapwrite get qdWork 0 add qdO QDI_FASTW 65536 qdIoBuf 0 65536
note Seed bounded activation template in QDI_Y (0.5f32) so each of 1,000 soak steps gets fresh x_t
for i ulong 2048
qdPutF32Io mul i 4 0.5f32
end
r2 = mapwrite get qdWork 0 qdO QDI_Y qdIoBuf 0 8192
end

fn qdP2SetFastWHypers oneMinusLam f32 eta f32 to void
wm = get qdWork 0
dOff = qdO QDI_FASTW_DIAG
r0 = mapset wm add dOff 40 4 ulong bitcast uint oneMinusLam
r1 = mapset wm add dOff 44 4 ulong bitcast uint eta
end

fn qdP2RunFastWStep to bool
qdPktStart
qdPtr qdW QDI_X
qdPtr qdW QDI_FASTW
qdPtr add qdW QDI_FASTW 65536
qdPtr qdW QDI_FASTW_DIAG
if not qdPktEmitGy 51 1 1 256
ret false
end
qdPtr qdW QDI_X
qdPtr add qdW QDI_FASTW 65536
qdPtr qdW QDI_FASTW_DIAG
if not qdPktEmitGy 52 1 1 256
ret false
end
ret qdPktRun
end

fn qdP2TestFastWSoak to bool
qdP2InitFastW
qdP2SetFastWHypers 0.99f32 0.001f32
note Record 1-step fresh-x + fold + delta-update packet once into slot 5 and replay 1,000 times!
qdPktStart
if not qdEmitCopyU32 qdW QDI_Y qdW QDI_X 8192
ret false
end
qdPtr qdW QDI_X
qdPtr qdW QDI_FASTW
qdPtr add qdW QDI_FASTW 65536
qdPtr qdW QDI_FASTW_DIAG
if not qdPktEmitGy 51 1 1 256
ret false
end
qdPtr qdW QDI_Y
qdPtr add qdW QDI_FASTW 65536
qdPtr qdW QDI_FASTW_DIAG
if not qdPktEmitGy 52 1 1 256
ret false
end
if not qdPktFinish 5
ret false
end
ok = true
normSq = f32 0.0f32
for st ulong 1000
if not qdReplayPre 5
qdPrint qpMsgP2FwBad
ret false
end
if eq rem st 100 99
if ne mapread get qdWork 0 qdO QDI_FASTW_DIAG qdIoBuf 0 8 8
qdPrint qpMsgP2FwBad
ret false
end
normSq = qdGetF32Io 0
nanFlg = qdGetF32Io 4
if or ne nanFlg 0.0f32 or ne normSq normSq gt normSq 10000.0f32
ok = false
end
end
end
note Negative-control alarm test: inject unstable eta=1e20f32 -> alarm MUST trip!
qdP2SetFastWHypers 0.99f32 1.0e20f32
tripped = ulong 0
for st ulong 4
if qdReplayPre 5
if eq mapread get qdWork 0 qdO QDI_FASTW_DIAG qdIoBuf 0 8 8
ns2 = qdGetF32Io 0
nf2 = qdGetF32Io 4
if or ne nf2 0.0f32 or ne ns2 ns2 gt ns2 10000.0f32
tripped = ulong 1
end
end
end
end
if and ok eq tripped 1
qdPrint qpMsgP2FwOk
qdPrintU ulong mul normSq 100.0f32
qdPrint qpMsgP2FwNeg
qdPrintU tripped
qdPrint qdMsgNl
ret true
end
qdPrint qpMsgP2FwBad
ret false
end

fn qdRunPhase2Gate to int
qdPrint qpMsgP2Hdr
if not qdP2TestWtbl
ret 31
end
if not qdP2TestFastWSoak
ret 32
end
note Test 3: 128K INT8 KV boundary check at pos = 131071
qdResetState
edgeTok = qdForwardToken 271 131071 true false
if eq edgeTok 999999
qdPrint qpMsgP2KvBad
ret 33
end
qdPrint qpMsgP2KvOk
qdPrintU edgeTok
qdPrint qdMsgRp
ret 0
end

note =========================================================================
note Native Qwen 3.6 MTP (mtp.safetensors -> Slot 40 W4) + Batched N=4..8 Decode
note =========================================================================
fn qdLoadMtpW4 to bool
t0 = monons
n = qdBuildPath qdSufMtp neg 1
fd = int fopen qdPathBuf 0 n 0 0
if lt fd 0
ret false
end
if ne pread fd qdIoBuf 0 8 0 8
c = fclose fd
ret false
end
hdrLen = ulong 0
for i ulong 8
hdrLen = or hdrLen shl ulong get qdIoBuf i mul i 8
end
dataOff = add 8 hdrLen
note 1. Stream mtp.fc.weight [2048, 4096] BF16 (16 MiB) -> qdMtpFcMap
if not qdStreamToMap fd dataOff get qdMtpFcMap 0 0 16777216
c = fclose fd
ret false
end
baseOff = add dataOff 16777216
note 2. Widen all scales + norms (including mtp.norm, pre_fc_norm_emb, pre_fc_norm_hid) -> Slot 40
if not qdWidenLayerScales fd baseOff 40 1176192
c = fclose fd
ret false
end
note 3. Stream FP8 weights shifted by -12288 so every FA_* offset matches verbatim!
if not qdStreamToMap fd add baseOff 1176192 get qdSlabMap 0 FA_EXP_W0 835715072
c = fclose fd
ret false
end
note Copy router GATE [256,2048] + SH_GATE [1,2048] to FA_GATE / FA_SH_GATE in staging slab
if not qdStreamToMap fd add baseOff FA_GATE get qdSlabMap 0 FA_GATE 1048576
c = fclose fd
ret false
end
if not qdStreamToMap fd add baseOff FA_SH_GATE get qdSlabMap 0 FA_SH_GATE 4096
c = fclose fd
ret false
end
c = fclose fd
note 4. Quantize all 256 experts + shared + FA Q/K/V/O on GPU into Slot 40
if not qdQuantLayerExpW4 40 true
ret false
end
if not qdQuantLayerDenseW4 40 true
ret false
end
put qdMtpReady 0 1
qdPrint qpMsgMtpLoad
qdPrintU div ulong sub monons t0 1000000
qdPrint qdMsgNl
ret true
end

fn qdEmitMtpLayerW4 to bool
w4 = qdLayerW4Va 40
d4 = add w4 W4_DENSE
sbase = qdLayerSVa 40
note 1. pre_fc_norm_embedding(QDI_AOUT) -> QDI_Y[0..2047], pre_fc_norm_hidden(QDI_X) -> QDI_Y[2048..4095]
qdPtr qdW QDI_AOUT
qdPtr qdW QDI_AOUT
qdPtr add sbase 2336000
qdPtr qdW QDI_Y
qdArg 0
if not qdPktEmitBx 10 1 256
ret false
end
qdPtr qdW QDI_X
qdPtr qdW QDI_X
qdPtr add sbase 2344192
qdPtr add qdW QDI_Y 8192
qdArg 0
if not qdPktEmitBx 10 1 256
ret false
end
note 2. QDI_X = mtp.fc @ QDI_Y[0..4095] ([2048, 4096] BF16) + input_layernorm -> QDI_XN
if not qdEmitBf16 qdW QDI_Y get qdMtpFcVa 0 qdW QDI_X 4096 2048
ret false
end
if not qdEmitRmsNormAdd sbase 0
ret false
end
note 3. Full-Attention Q|K|V + KV append + Split-K GQA + O_proj
if not qdEmitW4Gemv4R qdW QDI_XN d4 add d4 9437184 qdW QDI_QKV 2048 9216
ret false
end
kBase = get qdMtpKvVa 0
vBase = add kBase 268435456
if eq get qdUseKvInt8 0 1
qdPtr add qdW QDI_QKV 32768
qdPtr add qdW QDI_QKV 34816
qdPtr add sbase mul FA_KNORM 2
qdPtr get qdRopeVa 0
qdPtr kBase
qdPtr qdW QDI_POS
if not qdPktEmitGy 53 2 1 256
ret false
end
else
qdPtr add qdW QDI_QKV 32768
qdPtr add qdW QDI_QKV 34816
qdPtr add sbase mul FA_KNORM 2
qdPtr get qdRopeVa 0
qdPtr kBase
qdPtr vBase
qdPtr qdW QDI_POS
if not qdPktEmitGy 14 2 1 256
ret false
end
end
if not qdEmitFaAttnSplit sbase kBase vBase
ret false
end
if not qdEmitW4Gemv4R qdW QDI_Y add d4 10616832 add d4 14811136 qdW QDI_AOUT 4096 2048
ret false
end
if not qdEmitRmsNormAdd add sbase mul FA_POST_NORM 2 1
ret false
end
note 4. Router + 256E top-8 + shared W4 MoE + combine + mtp.norm -> QDI_X (h_mtp) & QDI_XN
if not qdEmitBf161R qdW QDI_XN add d4 15335424 qdW QDI_ROUT 257
ret false
end
idsVa = qdW QDI_IDS
qdPtr qdW QDI_ROUT
qdPtr idsVa
qdPtr qdW QDI_WTS
qdPtr add qdW QDI_ROUT 1024
qdPtr qdW QDI_LEXMAP
qdPtr qdW QDI_ARB_TAB
qdPtr 0
if not qdPktEmitGy 13 1 1 256
ret false
end
qdPtr qdW QDI_XN
qdPtr add w4 W4_GU_W
qdPtr add w4 W4_GU_S
qdPtr idsVa
qdPtr qdW QDI_EMID
qdArg 2048
qdArg 1024
qdArg 0
if not qdPktEmitGy 20 32 9 256
ret false
end
qdPtr qdW QDI_EMID
qdPtr add w4 W4_DN_W
qdPtr add w4 W4_DN_S
qdPtr idsVa
qdPtr qdW QDI_EOUT
if not qdPktEmitGy 22 32 9 256
ret false
end
qdPtr qdW QDI_X
qdPtr qdW QDI_EOUT
qdPtr qdW QDI_WTS
qdPtr add sbase 2327808
qdPtr qdW QDI_XN
qdArg 1
ret qdPktEmitGy 23 1 1 256
end

note Fast Shortlist MTP Draft lm_head: screens first 100,880 English/code vocab rows (2.46x smaller -> -576 MB/step!)
note Main 35B verify pass STILL scores full 248,320 vocab -> 100% PARITY=EXACT!
fn qdEmitMtpShortHead to bool
qdPtr get qdLmW4Va 0
qdPtr add get qdLmW4Va 0 254279680
qdPtr qdW QDI_XN
qdPtr qdW QDI_LOGW4
qdArg 100880
if not qdPktEmitGy 3 3153 1 256
ret false
end
qdPtr qdW QDI_LOGW4
qdPtr qdW QDI_CIDS
if not qdPktEmitGy 7 26 1 256
ret false
end
qdPtr mapaddr get qdLmBf16 0
qdPtr qdW QDI_XN
qdPtr qdW QDI_CIDS
qdPtr qdW QDI_CLOG
qdArg 26
ret qdPktEmitGy 4 26 1 32
end

fn qdMtpRecordPackets to bool
qdPktStartAt add qdO QDI_PKT 18874368
if not qdEmitMtpLayerW4
ret false
end
if not qdEmitMtpShortHead
ret false
end
if not qdPktFinish 7
ret false
end
qdPktStartAt add qdO QDI_PKT 20971520
if not qdEmitMtpLayerW4
ret false
end
ret qdPktFinish 8
end

fn qdLoadEmbedToAout tid ulong to bool
off = add QD_EMB_OFF mul tid 4096
if ne pread get qdOutFd 0 qdIoBuf 0 4096 long off 4096
ret false
end
for i ulong QD_H
p = mul i 2
bits = or shl uint get qdIoBuf add p 1 24 shl uint get qdIoBuf p 16
put qdX i bitcast f32 bits
end
ret qdWriteF32 get qdWork 0 qdO QDI_AOUT 6 QD_H
end

fn qdMtpWritePos pos ulong to bool
w = uint pos
put qdIoBuf 0 uchar and w 255
put qdIoBuf 1 uchar and shr w 8 255
put qdIoBuf 2 uchar and shr w 16 255
put qdIoBuf 3 uchar and shr w 24 255
ret eq mapwrite get qdWork 0 qdO QDI_POS qdIoBuf 0 4 4
end

fn qdMtpReadTopTok to ulong
if not qdReadCandIds
ret 999999
end
if not qdReadF32 get qdWork 0 qdO QDI_CLOG 12 26
ret 999999
end
bestId = ulong get qdCandIds 0
bestLog = get qdCandLog 0
for j ulong 26
if gt get qdCandLog j bestLog
bestLog = get qdCandLog j
bestId = ulong get qdCandIds j
end
end
ret bestId
end

fn qdMtpDraftChain curTok ulong pos0 ulong M ulong to bool
put qdSpecDraft 0 curTok
for s ulong sub M 1 bound 16
if not qdLoadEmbedToAout get qdSpecDraft s
ret false
end
if not qdMtpWritePos add pos0 s
ret false
end
if not qdReplayPre 7
ret false
end
d = qdMtpReadTopTok
if eq d 999999
ret false
end
put qdSpecDraft add s 1 d
end
ret true
end

fn qdMtpCopyMainHid acc ulong to bool
off = add QP_X mul sub acc 1 8192
if ne mapread get qdPreMap 0 off qdIoBuf 0 8192 8192
ret false
end
ret eq mapwrite get qdWork 0 qdO QDI_X qdIoBuf 0 8192 8192
end

fn qdMtpPrefillWarm to ulong
prompt = new ulong 19 0
qdSpecFillPrompt prompt
qdResetState
nextTok = ulong 0
for p ulong 19
isLast = eq p 18
nextTok = qdForwardToken get prompt p p isLast false
if eq nextTok 999999
ret 999999
end
if lt p 18
if not qdLoadEmbedToAout get prompt add p 1
ret 999999
end
if not qdMtpWritePos p
ret 999999
end
if not qdReplayPre 8
ret 999999
end
end
end
ret nextTok
end

fn qdRunMtpBench genN ulong M ulong to int
if not qdLoadMtpW4
ret 41
end
if not qdMtpRecordPackets
ret 42
end
if not qdSpecEmitVerifyPkt M
ret 43
end
qdPrint qpMsgMtpHdr
qdPrintU M
qdPrint qdMsgRp
n1Avg = qdSpecBenchN1 genN
if eq n1Avg 0
ret 44
end
nextTok = qdMtpPrefillWarm
if eq nextTok 999999
ret 45
end
put qdSpecSt 0 1
put qdSpecSt 1 1
if ne nextTok get qdRefOut 0
put qdSpecSt 1 0
end
steps = ulong 0
pos = ulong 19
t0 = monons
while lt get qdSpecSt 0 genN bound 64
if not qdMtpDraftChain nextTok sub pos 1 M
ret 46
end
acc = qdSpecVerifyStep M pos
if eq acc 0
ret 47
end
steps = add steps 1
qdSpecCommitAcc acc genN false
if not qdMtpCopyMainHid acc
ret 48
end
nextTok = get qdSpecPred sub acc 1
pos = add pos acc
end
mUs = div ulong sub monons t0 1000
mAvg = div mUs sub get qdSpecSt 0 1
qdPrint qpMsgMtpOk
qdPrintU M
if eq get qdSpecSt 1 1
qdPrint qpMsgSpecParOk
else
qdPrint qpMsgSpecParBad
end
qdPrintU steps
qdPrint qpMsgSpecAcc
qdPrintU div mul sub get qdSpecSt 0 1 100 steps
qdPrint qdMsgAvgMs
qdPrintU mAvg
qdPrint qdMsgTps
qdPrintU div 100000000 mAvg
qdPrint qpMsgSpecSpd
qdPrintU div mul n1Avg 100 mAvg
qdPrint qdMsgNl
if ne get qdSpecSt 1 1
ret 49
end
ret 0
end

fn qdRunBatchDecodeBench genN ulong B ulong to int
qdPrint qpMsgBatHdr
qdPrintU B
qdPrint qdMsgRp
if not qdSpecEmitVerifyPkt B
ret 51
end
qdResetState
for s ulong B bound 16
put qdPreTokIds s uint add 271 s
end
t0 = monons
pos = ulong 0
for st ulong genN bound 64
if not qdPreUploadToks B pos
ret 52
end
if not qdKickPre 6
ret 53
end
if not qdWaitPre
ret 54
end
if not qdSpecReadPreds B
ret 55
end
for s ulong B bound 16
put qdPreTokIds s uint get qdSpecPred s
end
pos = add pos B
end
bUs = div ulong sub monons t0 1000
totTok = mul genN B
stepUs = div bUs genN
aggTps = div mul totTok 100000000 bUs
qdPrint qpMsgBatRes
qdPrintU B
qdPrint qpMsgBatTot
qdPrintU totTok
qdPrint qpMsgBatStep
qdPrintU stepUs
qdPrint qpMsgBatAgg
qdPrintU aggTps
qdPrint qdMsgNl
ret 0
end

fn qdCrEval o1 ulong o2 ulong c ulong x0 ulong x1 ulong to ulong
t = ulong 0
if eq o1 1
t = add x0 x1
else
if eq o1 2
if ge x0 x1
t = sub x0 x1
end
else
t = mul x0 x1
end
end
if eq o2 1
ret add t c
end
ret mul t c
end

fn qdCrMatchAll o1 ulong o2 ulong c ulong to bool
for i ulong 4
if ne qdCrEval o1 o2 c get qdCrObsX0 i get qdCrObsX1 i get qdCrObsY i
ret false
end
end
ret true
end

fn qdCrSynth to bool
for o1 ulong 3
op1 = add o1 1
for o2 ulong 2
op2 = add o2 1
for c ulong 8
cc = add c 1
if qdCrMatchAll op1 op2 cc
put qdCrFound 0 1
put qdCrFound 1 op1
put qdCrFound 2 op2
put qdCrFound 3 cc
ret true
end
end
end
end
ret false
end

fn qdRunLiveCrystGate to int
qdPrint qpMsgCrHdr
note 1. Initialize & verify live GB10 QDI_WTBL zero-CPU-hop GPU pointer patching + negative control
if not qdP2TestWtbl
qdPrint qpMsgCrBad

neuralUs = div ulong sub monons t0 1000
if eq tok0 999999
qdPrint qpMsgCrBad
ret 61
end
note 3. Record neural task traces and run observational-equivalence crystallization
put qdCrObsX0 0 2
put qdCrObsX1 0 3
put qdCrObsY 0 15
put qdCrObsX0 1 4
put qdCrObsX1 1 1
put qdCrObsY 1 15

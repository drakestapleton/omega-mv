fn qdPreUploadToks B ulong pos0 ulong to bool
for t ulong B bound 512
w = get qdPreTokIds t
p = mul t 4
put qdIoBuf p uchar and w 255
put qdIoBuf add p 1 uchar and shr w 8 255
put qdIoBuf add p 2 uchar and shr w 16 255
put qdIoBuf add p 3 uchar and shr w 24 255
end
nb = mul B 4
if ne mapwrite get qdPreCtlMap 0 QP_TOKS qdIoBuf 0 nb long nb
ret false
end
pw = uint pos0
put qdIoBuf 0 uchar and pw 255
put qdIoBuf 1 uchar and shr pw 8 255
put qdIoBuf 2 uchar and shr pw 16 255
put qdIoBuf 3 uchar and shr pw 24 255
ret eq mapwrite get qdPreCtlMap 0 QP_POS0 qdIoBuf 0 4 4
end

fn qdPreSnapU32 p ulong to uint
b0 = uint get qdPreTraceSnap p
b1 = shl uint get qdPreTraceSnap add p 1 8
b2 = shl uint get qdPreTraceSnap add p 2 16
b3 = shl uint get qdPreTraceSnap add p 3 24
ret or or b0 b1 or b2 b3
end

fn qdPreSnapTrace B ulong to bool
totBytes = mul QD_LAYERS mul B 32
if gt totBytes 655360
ret false
end
ret eq mapread get qdPreMap 0 QP_TRACE qdPreTraceSnap 0 totBytes long totBytes
end

fn qdPreUpdateArborisOne t ulong B ulong to void
q36ArbResetToken
idsLocal = new uint 8 0
prLocal = new uint 8 0
hasPred = ulong 0
np = ulong 0
for L ulong QD_LAYERS
base = add mul L mul B 32 mul t 32
for k ulong 8
put idsLocal k qdPreSnapU32 add base mul k 4
end
if eq hasPred 1
h = q36ArbScorePred prLocal np idsLocal
put qdArbHits 0 add get qdArbHits 0 h
put qdArbTot 0 add get qdArbTot 0 8
end
q36ArbObserve L idsLocal
if lt add L 1 QD_LAYERS
np = q36ArbPredict L idsLocal 8 prLocal
hasPred = ulong 1
if eq np 0
hasPred = ulong 0
end
end
end
end

fn qdPreUpdateArborisSnap B ulong to void
t0 = monons
for t ulong B bound 512
qdPreUpdateArborisOne t B
end
dt = div ulong sub monons t0 1000000
put qdPreStatMs 0 add get qdPreStatMs 0 dt
end

fn qdPrePickBest B ulong checkParity bool to ulong
if not qdReadCandIds
ret 999999
end
if not qdReadF32 get qdWork 0 qdO QDI_CLOG 12 128
ret 999999
end
bestId = ulong get qdCandIds 0
bestLog = get qdCandLog 0
for j ulong 128
if gt get qdCandLog j bestLog
bestLog = get qdCandLog j
bestId = ulong get qdCandIds j
end
end
if checkParity
off = add QP_XN mul sub B 1 8192
if eq mapread get qdPreMap 0 off qdIoBuf 0 8192 8192
r = mapwrite get qdWork 0 qdO QDI_XN qdIoBuf 0 8192
if not qdLmCheckParity bestId
ret 999999
end
end
end
ret bestId
end

fn qdPreKickChunk B ulong pos0 ulong runFinalHead bool to bool
if or eq B 0 gt B QP_MAX_B
ret false
end
if not qdPreUploadToks B pos0
ret false
end
if eq B QP_MAX_B
if runFinalHead
ret qdKickPre 4
end
ret qdKickPre 3
end
qdPktStart
if not qdPreEmitAll40W4 B
ret false
end
if runFinalHead
if not qdPreEmitFinalHead B
ret false
end
end
if not qdPktFinish 5
ret false
end
ret qdKickPre 5
end

fn qdRunPrefillChunkW4 B ulong pos0 ulong runFinalHead bool checkParity bool to ulong
if not qdPreKickChunk B pos0 runFinalHead
ret 999999
end
if not qdWaitPre
ret 999999
end
if qdPreSnapTrace B
qdPreUpdateArborisSnap B
end
if not runFinalHead
ret 0
end
ret qdPrePickBest B checkParity
end

fn qdPreFillBenchToks pos ulong chunk ulong to void
bp = new uint 17 0
put bp 0 248045
put bp 1 846
put bp 2 198
put bp 3 3710
put bp 4 369
put bp 5 279
put bp 6 6511
put bp 7 314
put bp 8 9338
put bp 9 30
put bp 10 248046
put bp 11 198
put bp 12 248045
put bp 13 74455
put bp 14 198
put bp 15 248068
put bp 16 248069
for j ulong chunk bound 512
put qdPreTokIds j get bp rem add pos j 17
end
end

fn qdRunPrefillBench nTok ulong to int
qdResetState
put qdArbHits 0 0
put qdArbTot 0 0
put qdPreStatMs 0 0
t0 = monons
pos = ulong 0
prevChunk = ulong 0
hasPrev = false
while lt pos nTok bound 1024
chunk = sub nTok pos
if gt chunk QP_MAX_B
chunk = QP_MAX_B
end
isFinal = eq add pos chunk nTok
if hasPrev
if not qdWaitPre
ret 20
end
okSnap = qdPreSnapTrace prevChunk
qdPreFillBenchToks pos chunk
if not qdPreKickChunk chunk pos isFinal
ret 20
end
if okSnap
qdPreUpdateArborisSnap prevChunk
end
else
qdPreFillBenchToks pos chunk
if not qdPreKickChunk chunk pos isFinal
ret 20
end
end
prevChunk = chunk
hasPrev = true
pos = add pos chunk
end
if hasPrev
if not qdWaitPre
ret 20
end
if qdPreSnapTrace prevChunk
qdPreUpdateArborisSnap prevChunk
end
end
dtMs = div ulong sub monons t0 1000000
tps = ulong 0
if gt dtMs 0
tps = div mul nTok 1000 dtMs
end
hitPct = ulong 0
if gt get qdArbTot 0 0
hitPct = div mul get qdArbHits 0 100 get qdArbTot 0
end
qdPrint qpMsgBench
qdPrintU nTok
qdPrint qpMsgMs
qdPrintU dtMs
qdPrint qpMsgTps
qdPrintU tps
qdPrint qpMsgArb
qdPrintU hitPct
qdPrint qpMsgArbMs
qdPrintU get qdPreStatMs 0
qdPrint qdMsgNl
ret 0
end

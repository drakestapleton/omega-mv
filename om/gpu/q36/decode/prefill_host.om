fn qdPreEmitKernels to void
for ki ulong 17
p = mul div add get qdCodePos 0 255 256 256
put qdEntry add 26 ki p
put qdCodePos 0 p
put q36Pc 0 0
put q36Guard 0 0
ok = q36PreKernel uchar add 130 ki
if not ok
exit 4
end
q36Done
end
put qdSmem 26 32
put qdSmem 27 0
put qdSmem 28 2048
put qdSmem 29 2048
put qdSmem 30 0
put qdSmem 31 32
put qdSmem 32 0
put qdSmem 33 544
put qdSmem 34 1088
put qdSmem 35 20736
put qdSmem 36 1088
put qdSmem 37 17408
put qdSmem 38 2304
put qdSmem 39 0
put qdSmem 40 32
put qdSmem 41 0
put qdSmem 42 1088
note 47: qPreLmHeadW4Hmma (mode 147), 48: qPreCopyU32 (mode 148)
for sk ulong 2
p = mul div add get qdCodePos 0 255 256 256
put qdEntry add 47 sk p
put qdCodePos 0 p
put q36Pc 0 0
put q36Guard 0 0
ok = q36PreKernel uchar add 147 sk
if not ok
exit 4
end
q36Done
end
put qdSmem 47 2048
put qdSmem 48 0
end

fn qdEmitCopyU32 srcVa ulong dstVa ulong nBytes ulong to bool
qdPtr srcVa
qdPtr dstVa
qdArg uint div nBytes 16
ret qdPktEmitGy 48 256 1 256
end

fn qdPreEmitGatherEmbeds B ulong to bool
pva = get qdPreVa 0
qdPtr add get qdPreCtlVa 0 QP_TOKS
qdPtr mapaddr get qdEmbBf16 0
qdPtr add pva QP_X
ret qdPktEmitGy 41 uint B 1 256
end

fn qdPreEmitRmsNorm wNormVa ulong addInVa ulong doAdd uint B ulong to bool
pva = get qdPreVa 0
qdPtr add pva QP_X
qdPtr addInVa
qdPtr wNormVa
qdPtr add pva QP_XN
qdPtr add pva QP_XNB
qdArg doAdd
ret qdPktEmitGy 26 uint B 1 256
end

fn qdPreEmitF32ToBf16 srcVa ulong dstVa ulong totalPairs uint to bool
qdPtr srcVa
qdPtr dstVa
qdArg totalPairs
gx = div add totalPairs 255 256
ret qdPktEmitGy 27 gx 1 256
end

fn qdPreSetStr xStr uint xOff uint oStr uint oOff uint to void
put qdPreStr 0 xStr
put qdPreStr 1 xOff
put qdPreStr 2 oStr
put qdPreStr 3 oOff
end

fn qdPreSetKN K uint N uint B ulong to void
put qdPreStr 4 K
put qdPreStr 5 N
put qdPreStr 6 uint B
end

fn qdPreEmitW4Gemm xVa ulong wVa ulong sVa ulong yVa ulong to bool
K = get qdPreStr 4
N = get qdPreStr 5
B = ulong get qdPreStr 6
qdPtr xVa
qdPtr wVa
qdPtr sVa
qdPtr yVa
qdArg K
qdArg N
qdArg uint B
qdArg get qdPreStr 0
qdArg get qdPreStr 1
qdArg get qdPreStr 2
qdArg get qdPreStr 3
gx = div N 64
gy = uint div add B 31 32
ret qdPktEmitGy 28 gx gy 128
end

fn qdPreEmitBf16Gemm xVa ulong wVa ulong yVa ulong N uint B ulong yStr uint to bool
qdPtr xVa
qdPtr wVa
qdPtr yVa
qdArg N
qdArg uint B
qdArg yStr
gx = div add N 63 64
gy = uint div add B 31 32
ret qdPktEmitGy 29 gx gy 128
end

fn qdPreEmitMoeRouterW4 L ulong isFa bool B ulong to bool
pva = get qdPreVa 0
wva = get qdWorkVa 0
d4 = add qdLayerW4Va L W4_DENSE
routOff = ulong 18874368
if isFa
routOff = ulong 15335424
end
if not qdPreEmitBf16Gemm add pva QP_XNB add d4 routOff add pva QP_ROUT 257 B 257
ret false
end
trOff = add QP_TRACE mul L mul B 32
qdPtr add pva QP_ROUT
qdPtr qdW QDI_LEXMAP
qdPtr add pva QP_IDS
qdPtr add pva QP_WTS
qdPtr add pva QP_SHG
qdPtr add pva trOff
if not qdPktEmitGy 36 uint B 1 256
ret false
end
qdPtr add pva QP_IDS
qdPtr add pva QP_ECNT
qdArg uint B
ret qdPktEmitGy 37 1 1 256
end

fn qdPreEmitMoeGuW4 w4 ulong B ulong to bool
pva = get qdPreVa 0
qdPreSetStr 1024 0 9216 8192
qdPreSetKN 2048 1024 B
shS = add w4 add W4_GU_S 33554432
if not qdPreEmitW4Gemm add pva QP_XNB add w4 268435456 shS add pva QP_EMID
ret false
end
qdPtr add pva QP_XNB
qdPtr add w4 W4_GU_W
qdPtr add w4 W4_GU_S
qdPtr add pva QP_EMID
qdPtr add pva QP_ECNT
qdArg 2048
qdArg 1024
qdArg 0
qdArg 262144
qdArg 32768
if not qdPktEmitGy 38 16 256 128
ret false
end
qdPtr add pva QP_EMID
qdPtr add pva QP_WTS
qdPtr add pva QP_SHG
qdPtr add pva QP_ESWB
ret qdPktEmitGy 39 9 uint B 256
end

fn qdPreEmitMoeDnW4 L ulong w4 ulong B ulong to bool
pva = get qdPreVa 0
qdPreSetStr 2304 2048 18432 16384
qdPreSetKN 512 2048 B
shW = add w4 add W4_DN_W 134217728
shS = add w4 add W4_DN_S 16777216
if not qdPreEmitW4Gemm add pva QP_ESWB shW shS add pva QP_EOUT
ret false
end
qdPtr add pva QP_ESWB
qdPtr add w4 W4_DN_W
qdPtr add w4 W4_DN_S
qdPtr add pva QP_EOUT
qdPtr add pva QP_ECNT
qdArg 512
qdArg 2048
qdArg 1
qdArg 131072
qdArg 16384
if not qdPktEmitGy 38 32 256 128
ret false
end
nextNorm = qdW QDI_FNORM
if lt add L 1 QD_LAYERS
nextNorm = qdLayerSVa add L 1
end
qdPtr add pva QP_X
qdPtr add pva QP_EOUT
qdPtr nextNorm
qdPtr add pva QP_XN
qdPtr add pva QP_XNB
qdArg 1
ret qdPktEmitGy 40 uint B 1 256
end

fn qdPreEmitMoeW4 L ulong isFa bool B ulong to bool
if not qdPreEmitMoeRouterW4 L isFa B
ret false
end
w4 = qdLayerW4Va L
if not qdPreEmitMoeGuW4 w4 B
ret false
end
ret qdPreEmitMoeDnW4 L w4 B
end

fn qdSpecSaveGdnInputs gdnIdx ulong B ulong to bool
pva = get qdPreVa 0
sva = get qdSpecVa 0
dstQkv = add sva add QSP_QKV mul gdnIdx 393216
if not qdEmitCopyU32 add pva QP_QKV dstQkv mul B 49152
ret false
end
dstAb = add sva add QSP_AB mul gdnIdx 2048
ret qdEmitCopyU32 add pva QP_AB dstAb mul B 256
end

fn qdPreEmitGdnLayerW4 L ulong gdnIdx ulong B ulong to bool
pva = get qdPreVa 0
wva = get qdWorkVa 0
sbase = qdLayerSVa L
d4 = add qdLayerW4Va L W4_DENSE
if eq L 0
if not qdPreEmitGatherEmbeds B
ret false
end
if not qdPreEmitRmsNorm sbase add pva QP_AOUT 0 B
ret false
end
end
qdPreSetStr 1024 0 12288 0
qdPreSetKN 2048 12288 B
if not qdPreEmitW4Gemm add pva QP_XNB d4 add d4 12582912 add pva QP_QKV
ret false
end
if not qdPreEmitBf16Gemm add pva QP_XNB add d4 19927040 add pva QP_AB 64 B 64
ret false
end
if eq get qdSpecMode 0 1
if not qdSpecSaveGdnInputs gdnIdx B
ret false
end
end
note Register-stationary causal conv1d + SiLU across all B tokens
qdPtr add pva QP_QKV
qdPtr add sbase mul GDN_CONV 2
qdPtr add get qdGdnTailVa 0 mul gdnIdx 98304
qdArg uint B
if not qdPktEmitGy 30 32 1 256
ret false
end
note Per-token Q/K L2-norm + decay/beta
alogVa = add qdW QDI_ALOG mul gdnIdx 256
qdPtr add pva QP_QKV
qdPtr add pva QP_AB
qdPtr alogVa
qdPtr add alogVa 128
qdPtr add pva QP_DB
if not qdPktEmitGy 31 32 uint B 128
ret false
end
note ZERO-BARRIER warp-resident chunked GDN state update (reads & writes S ONCE for all B tokens!)
qdPtr add pva QP_QKV
qdPtr add pva QP_DB
qdPtr add get qdGdnStateVa 0 mul gdnIdx 2097152
qdPtr add pva QP_Y
qdArg uint B
if not qdPktEmitGy 32 32 4 256
ret false
end
note Per-head RMSNorm(lin_norm)*silu(z) -> packed BF16 QP_YB
qdPtr add pva QP_Y
qdPtr add pva QP_QKV
qdPtr add sbase mul GDN_LIN_NORM 2
qdPtr add pva QP_YB
if not qdPktEmitGy 33 32 uint B 128
ret false
end
note Tensor Core W4 out_proj [2048, 4096]
qdPreSetStr 2048 0 2048 0
qdPreSetKN 4096 2048 B
if not qdPreEmitW4Gemm add pva QP_YB add d4 14155776 add d4 18350080 add pva QP_AOUT
ret false
end
if not qdPreEmitRmsNorm add sbase mul GDN_POST_NORM 2 add pva QP_AOUT 1 B
ret false
end
ret qdPreEmitMoeW4 L false B
end

fn qdPreEmitFaLayerW4 L ulong faIdx ulong B ulong to bool
pva = get qdPreVa 0
sbase = qdLayerSVa L
d4 = add qdLayerW4Va L W4_DENSE
if eq L 0
if not qdPreEmitGatherEmbeds B
ret false
end
if not qdPreEmitRmsNorm sbase add pva QP_AOUT 0 B
ret false
end
end
qdPreSetStr 1024 0 9216 0
qdPreSetKN 2048 9216 B
if not qdPreEmitW4Gemm add pva QP_XNB d4 add d4 9437184 add pva QP_QKV
ret false
end
kBase = get qdKvVa faIdx
vBase = add kBase 268435456
qdPtr add pva QP_QKV
qdPtr add sbase mul FA_KNORM 2
qdPtr get qdRopeVa 0
qdPtr kBase
qdPtr vBase
qdPtr add get qdPreCtlVa 0 QP_POS0
if not qdPktEmitGy 34 2 uint B 256
ret false
end
qdPtr add pva QP_QKV
qdPtr add sbase mul FA_QNORM 2
qdPtr get qdRopeVa 0
qdPtr add pva QP_YB
qdPtr add get qdPreCtlVa 0 QP_POS0
if not qdPktEmitGy 42 16 uint B 256
ret false
end
qdPtr add pva QP_YB
qdPtr add pva QP_QKV
qdPtr kBase
qdPtr vBase
qdPtr add pva QP_Y
qdPtr add get qdPreCtlVa 0 QP_POS0
qdArg uint B
if not qdPktEmitGy 35 16 uint div add B 15 16 256
ret false
end
if not qdPreEmitF32ToBf16 add pva QP_Y add pva QP_YB uint mul B 2048
ret false
end
qdPreSetStr 2048 0 2048 0
qdPreSetKN 4096 2048 B
if not qdPreEmitW4Gemm add pva QP_YB add d4 10616832 add d4 14811136 add pva QP_AOUT
ret false
end
if not qdPreEmitRmsNorm add sbase mul FA_POST_NORM 2 add pva QP_AOUT 1 B
ret false
end
ret qdPreEmitMoeW4 L true B
end

fn qdPreEmitAll40W4 B ulong to bool
gdnIdx = ulong 0
faIdx = ulong 0
for L ulong QD_LAYERS
if eq rem L 4 3
if not qdPreEmitFaLayerW4 L faIdx B
ret false
end
faIdx = add faIdx 1
else
if not qdPreEmitGdnLayerW4 L gdnIdx B
ret false
end
gdnIdx = add gdnIdx 1
end
end
ret true
end

fn qdPreEmitFinalHead B ulong to bool
pva = get qdPreVa 0
wva = get qdWorkVa 0
lastXn = add pva add QP_XN mul sub B 1 8192
qdPtr get qdLmW4Va 0
qdPtr add get qdLmW4Va 0 254279680
qdPtr lastXn
qdPtr qdW QDI_LOGW4
qdArg uint QD_VOCAB
if not qdPktEmitGy 3 7760 1 256
ret false
end
qdPtr qdW QDI_LOGW4
qdPtr qdW QDI_CIDS
if not qdPktEmitGy 7 64 1 256
ret false
end
qdPtr mapaddr get qdLmBf16 0
qdPtr lastXn
qdPtr qdW QDI_CIDS
qdPtr qdW QDI_CLOG
qdArg 128
ret qdPktEmitGy 4 128 1 32
end

fn qdPreEmitFinalHeadSpec M ulong to bool
pva = get qdPreVa 0
note 1. Single-read Tensor Core W4 lm_head screen across ALL M tokens [M, 248320]
qdPtr add pva QP_XNB
qdPtr get qdLmW4Va 0
qdPtr add get qdLmW4Va 0 254279680
qdPtr add pva QP_SPEC_LOG
qdArg 2048
qdArg uint QD_VOCAB
qdArg uint M
qdArg 1024
qdArg 0
qdArg uint QD_VOCAB
qdArg 0
if not qdPktEmitGy 47 3880 1 128
ret false
end
note 2. Exact top-128 BF16 rescore for each t = 0..M-1
for t ulong M bound 16
logVa = add pva add QP_SPEC_LOG mul t 993280
cidsVa = add pva add QP_SPEC_CIDS mul t 512
clogVa = add pva add QP_SPEC_CLOG mul t 512
xnVa = add pva add QP_XN mul t 8192
qdPtr logVa
qdPtr cidsVa
if not qdPktEmitGy 7 64 1 256
ret false
end
qdPtr mapaddr get qdLmBf16 0
qdPtr xnVa
qdPtr cidsVa
qdPtr clogVa
qdArg 128
if not qdPktEmitGy 4 128 1 32
ret false
end
end
ret true
end

fn qdSpecEmitVerifyPkt M ulong to bool
sva = get qdSpecVa 0
qdPktStartAt add qdO QDI_PKT 16777216
if not qdEmitCopyU32 get qdGdnStateVa 0 add sva QSP_GDN_STATE 62914560
ret false
end
if not qdEmitCopyU32 get qdGdnTailVa 0 add sva QSP_GDN_TAIL 2949120
ret false
end
put qdSpecMode 0 1
ok = qdPreEmitAll40W4 M
put qdSpecMode 0 0
if not ok
ret false
end
if not qdPreEmitFinalHeadSpec M
ret false
end
ret qdPktFinish 6
end

fn qdSpecRollbackGdn acc ulong to bool
pva = get qdPreVa 0
sva = get qdSpecVa 0
qdPktStart
if not qdEmitCopyU32 add sva QSP_GDN_STATE get qdGdnStateVa 0 62914560
ret false
end
if not qdEmitCopyU32 add sva QSP_GDN_TAIL get qdGdnTailVa 0 2949120
ret false
end
gdnIdx = ulong 0
for L ulong QD_LAYERS
if ne rem L 4 3
sbase = qdLayerSVa L
qkvSrc = add sva add QSP_QKV mul gdnIdx 393216
abSrc = add sva add QSP_AB mul gdnIdx 2048
if not qdEmitCopyU32 qkvSrc add pva QP_QKV mul acc 49152
ret false
end
qdPtr add pva QP_QKV
qdPtr add sbase mul GDN_CONV 2
qdPtr add get qdGdnTailVa 0 mul gdnIdx 98304
qdArg uint acc
if not qdPktEmitGy 30 32 1 256
ret false
end
alogVa = add qdW QDI_ALOG mul gdnIdx 256
qdPtr add pva QP_QKV
qdPtr abSrc
qdPtr alogVa
qdPtr add alogVa 128
qdPtr add pva QP_DB
if not qdPktEmitGy 31 32 uint acc 128
ret false
end
qdPtr add pva QP_QKV
qdPtr add pva QP_DB
qdPtr add get qdGdnStateVa 0 mul gdnIdx 2097152
qdPtr add pva QP_Y
qdArg uint acc
if not qdPktEmitGy 32 32 4 256
ret false
end
gdnIdx = add gdnIdx 1
end
end
ret qdPktRun
end

fn qdSpecReadPreds M ulong to bool
nb = mul M 512
if ne mapread get qdPreMap 0 QP_SPEC_CIDS qdIoBuf 0 nb long nb
ret false
end
for t ulong M bound 16
base = mul t 512
for j ulong 128
p = add base mul j 4
b0 = uint get qdIoBuf p
b1 = shl uint get qdIoBuf add p 1 8
b2 = shl uint get qdIoBuf add p 2 16
b3 = shl uint get qdIoBuf add p 3 24
put qdCandIds j or or b0 b1 or b2 b3
end
if not qdReadF32 get qdPreMap 0 add QP_SPEC_CLOG base 12 128
ret false
end
bestId = ulong get qdCandIds 0
bestLog = get qdCandLog 0
for j ulong 128
if gt get qdCandLog j bestLog
bestLog = get qdCandLog j
bestId = ulong get qdCandIds j
end
end
put qdSpecPred t bestId
end
ret true
end

fn qdSpecVerifyStep M ulong pos0 ulong to ulong
for t ulong M bound 16
put qdPreTokIds t uint get qdSpecDraft t
end
if not qdPreUploadToks M pos0
ret 0
end
if not qdKickPre 6
ret 0
end
if not qdWaitPre
ret 0
end
if not qdSpecReadPreds M
ret 0
end
acc = ulong 1
for k ulong sub M 1 bound 16
if eq get qdSpecPred k get qdSpecDraft add k 1
acc = add k 2
else
break
end
end
if lt acc M
if not qdSpecRollbackGdn acc
ret 0
end
end
if qdPreSnapTrace M
qdPreUpdateArborisSnap acc
end
ret acc
end

fn qdSpecMatchNgram pos ulong nLen ulong hlen ulong to bool
tail = sub hlen nLen
for j ulong nLen bound 4
if ne get qdHistToks add pos j get qdHistToks add tail j
ret false
end
end
ret true
end

fn qdSpecFindNgram nLen ulong hlen ulong to ulong
lim = sub hlen nLen
for idx ulong lim bound 131072
pos = sub sub lim 1 idx
if qdSpecMatchNgram pos nLen hlen
ret add pos nLen
end
end
ret 0
end

fn qdSpecDraftNgram curTok ulong M ulong to void
put qdSpecDraft 0 curTok
hlen = get qdHistLen 0
for s ulong sub M 1 bound 16
put qdSpecDraft add s 1 curTok
end
if lt hlen 2
ret
end
for ng ulong 4
nLen = sub 4 ng
if ge hlen nLen
bestPos = qdSpecFindNgram nLen hlen
if gt bestPos 0
for s ulong sub M 1 bound 16
if lt add bestPos s hlen
put qdSpecDraft add s 1 get qdHistToks add bestPos s
end
end
ret
end
end
end
end

fn qdSpecFillPrompt p edit ulong 19 to void
put p 0 248045
put p 1 846
put p 2 198
put p 3 3710
put p 4 369
put p 5 279
put p 6 3712
put p 7 314
put p 8 11751
put p 9 303
put p 10 7472
put p 11 13
put p 12 248046
put p 13 198
put p 14 248045
put p 15 74455
put p 16 198
put p 17 248068
put p 18 248069
end

fn qdSpecPrefill17 saveHist bool to ulong
prompt = new ulong 19 0
qdSpecFillPrompt prompt
qdResetState
if saveHist
for p ulong 19
put qdHistToks p get prompt p
end
put qdHistLen 0 19
end
nextTok = ulong 0
for p ulong 19
isLast = eq p 18
nextTok = qdForwardToken get prompt p p isLast false
if eq nextTok 999999
ret 999999
end
end
ret nextTok
end

fn qdSpecBenchN1 genN ulong to ulong
nextTok = qdSpecPrefill17 false
if eq nextTok 999999
ret 0
end
put qdRefOut 0 nextTok
t0 = monons
pos = ulong 19
for g ulong sub genN 1 bound 64
nextTok = qdForwardToken nextTok pos true false
if eq nextTok 999999
ret 0
end
put qdRefOut add g 1 nextTok
pos = add pos 1
end
n1Us = div ulong sub monons t0 1000
n1Avg = div n1Us sub genN 1
n1Tps = div 100000000 n1Avg
qdPrint qpMsgSpecN1
qdPrintU genN
qdPrint qdMsgAvgMs
qdPrintU n1Avg
qdPrint qdMsgTps
qdPrintU n1Tps
qdPrint qdMsgNl
ret n1Avg
end

global qdSpecSt ulong 4

fn qdSpecCommitAcc acc ulong genN ulong saveHist bool to void
prod = get qdSpecSt 0
ex = get qdSpecSt 1
for k ulong acc bound 16
tokK = get qdSpecPred k
if lt prod genN
if ne tokK get qdRefOut prod
ex = ulong 0
end
if saveHist
hl = get qdHistLen 0
put qdHistToks hl tokK
put qdHistLen 0 add hl 1
end
prod = add prod 1
end
end
put qdSpecSt 0 prod
put qdSpecSt 1 ex
end

fn qdSpecBenchNgram genN ulong M ulong to bool
nextTok = qdSpecPrefill17 true
if eq nextTok 999999
ret false
end
put qdHistToks 19 nextTok
put qdHistLen 0 20
put qdSpecSt 0 1
put qdSpecSt 1 1
if ne nextTok get qdRefOut 0
put qdSpecSt 1 0
end
steps = ulong 0
pos = ulong 19
t1 = monons
while lt get qdSpecSt 0 genN bound 64
qdSpecDraftNgram nextTok M
acc = qdSpecVerifyStep M pos
if eq acc 0
ret false
end
steps = add steps 1
qdSpecCommitAcc acc genN true
nextTok = get qdSpecPred sub acc 1
pos = add pos acc
end
ngUs = div ulong sub monons t1 1000
ngAvg = div ngUs sub get qdSpecSt 0 1
qdPrint qpMsgSpecNg
qdPrintU M
if eq get qdSpecSt 1 1
qdPrint qpMsgSpecParOk
else
qdPrint qpMsgSpecParBad
end
qdPrintU steps
qdPrint qpMsgSpecAcc
qdPrintU div mul sub get qdSpecSt 0 1 100 steps
qdPrint qdMsgAvgMs
qdPrintU ngAvg
qdPrint qdMsgTps
qdPrintU div 100000000 ngAvg
qdPrint qdMsgNl
ret eq get qdSpecSt 1 1
end

fn qdSpecFillOracle nextTok ulong prod ulong genN ulong M ulong to void
put qdSpecDraft 0 nextTok
for s ulong sub M 1 bound 16
idx = add prod s
if lt idx genN
put qdSpecDraft add s 1 get qdRefOut idx
else
put qdSpecDraft add s 1 nextTok
end
end
end

fn qdSpecBenchVerify genN ulong M ulong n1Avg ulong to bool
nextTok = qdSpecPrefill17 false
if eq nextTok 999999
ret false
end
put qdSpecSt 0 1
put qdSpecSt 1 1
if ne nextTok get qdRefOut 0
put qdSpecSt 1 0
end
steps = ulong 0
pos = ulong 19
t2 = monons
while lt get qdSpecSt 0 genN bound 64
qdSpecFillOracle nextTok get qdSpecSt 0 genN M
acc = qdSpecVerifyStep M pos
if eq acc 0
ret false
end
steps = add steps 1
qdSpecCommitAcc acc genN false
nextTok = get qdSpecPred sub acc 1
pos = add pos acc
end
vfUs = div ulong sub monons t2 1000
vfAvg = div vfUs sub get qdSpecSt 0 1
qdPrint qpMsgSpecVf
qdPrintU M
if eq get qdSpecSt 1 1
qdPrint qpMsgSpecParOk
else
qdPrint qpMsgSpecParBad
end
qdPrintU steps
qdPrint qpMsgSpecAcc
qdPrintU div mul sub get qdSpecSt 0 1 100 steps
qdPrint qdMsgAvgMs
qdPrintU vfAvg
qdPrint qdMsgTps
qdPrintU div 100000000 vfAvg
qdPrint qpMsgSpecSpd
qdPrintU div mul n1Avg 100 vfAvg
qdPrint qdMsgNl
ret eq get qdSpecSt 1 1
end

fn qdRunSpecBench genN ulong M ulong to int
qdPrint qpMsgSpecHdr
qdPrintU M
qdPrint qdMsgRp
n1Avg = qdSpecBenchN1 genN
if eq n1Avg 0
ret 15
end
if not qdSpecEmitVerifyPkt M
ret 17
end
ok1 = qdSpecBenchNgram genN M
ok2 = qdSpecBenchVerify genN M n1Avg
if or not ok1 not ok2
ret 22
end
ret 0
end

fn qdPreUploadToks B ulong pos0 ulong to bool
for t ulong B bound 512
w = get qdPreTokIds t
p = mul t 4
put qdIoBuf p uchar and w 255
put qdIoBuf add p 1 uchar and shr w 8 255
put qdIoBuf add p 2 uchar and shr w 16 255
put qdIoBuf add p 3 uchar and shr w 24 255
end
nb = mul B 4
if ne mapwrite get qdPreCtlMap 0 QP_TOKS qdIoBuf 0 nb long nb
ret false
end
pw = uint pos0
put qdIoBuf 0 uchar and pw 255
put qdIoBuf 1 uchar and shr pw 8 255
put qdIoBuf 2 uchar and shr pw 16 255
put qdIoBuf 3 uchar and shr pw 24 255
ret eq mapwrite get qdPreCtlMap 0 QP_POS0 qdIoBuf 0 4 4
end

fn qdPreSnapU32 p ulong to uint
b0 = uint get qdPreTraceSnap p
b1 = shl uint get qdPreTraceSnap add p 1 8
b2 = shl uint get qdPreTraceSnap add p 2 16
b3 = shl uint get qdPreTraceSnap add p 3 24
ret or or b0 b1 or b2 b3
end

fn qdPreSnapTrace B ulong to bool
totBytes = mul QD_LAYERS mul B 32
if gt totBytes 655360
ret false
end
ret eq mapread get qdPreMap 0 QP_TRACE qdPreTraceSnap 0 totBytes long totBytes
end

fn qdPreUpdateArborisOne t ulong B ulong to void
q36ArbResetToken
idsLocal = new uint 8 0
prLocal = new uint 8 0
hasPred = ulong 0
np = ulong 0
for L ulong QD_LAYERS
base = add mul L mul B 32 mul t 32
for k ulong 8
put idsLocal k qdPreSnapU32 add base mul k 4
end
if eq hasPred 1
h = q36ArbScorePred prLocal np idsLocal
put qdArbHits 0 add get qdArbHits 0 h
put qdArbTot 0 add get qdArbTot 0 8
end
q36ArbObserve L idsLocal
if lt add L 1 QD_LAYERS
np = q36ArbPredict L idsLocal 8 prLocal
hasPred = ulong 1
if eq np 0
hasPred = ulong 0
end
end
end
end

fn qdPreUpdateArborisSnap B ulong to void
t0 = monons
for t ulong B bound 512
qdPreUpdateArborisOne t B
end
dt = div ulong sub monons t0 1000000
put qdPreStatMs 0 add get qdPreStatMs 0 dt
end

fn qdPrePickBest B ulong checkParity bool to ulong
if not qdReadCandIds
ret 999999
end
if not qdReadF32 get qdWork 0 qdO QDI_CLOG 12 128
ret 999999
end
bestId = ulong get qdCandIds 0
bestLog = get qdCandLog 0
for j ulong 128
if gt get qdCandLog j bestLog
bestLog = get qdCandLog j
bestId = ulong get qdCandIds j
end
end
if checkParity
off = add QP_XN mul sub B 1 8192
if eq mapread get qdPreMap 0 off qdIoBuf 0 8192 8192
r = mapwrite get qdWork 0 qdO QDI_XN qdIoBuf 0 8192
if not qdLmCheckParity bestId
ret 999999
end
end
end
ret bestId
end

fn qdPreKickChunk B ulong pos0 ulong runFinalHead bool to bool
if or eq B 0 gt B QP_MAX_B
ret false
end
if not qdPreUploadToks B pos0
ret false
end
if eq B QP_MAX_B
if runFinalHead
ret qdKickPre 4
end
ret qdKickPre 3
end
qdPktStart
if not qdPreEmitAll40W4 B
ret false
end
if runFinalHead
if not qdPreEmitFinalHead B
ret false
end
end
if not qdPktFinish 5
ret false
end
ret qdKickPre 5
end

fn qdRunPrefillChunkW4 B ulong pos0 ulong runFinalHead bool checkParity bool to ulong
if not qdPreKickChunk B pos0 runFinalHead
ret 999999
end
if not qdWaitPre
ret 999999
end
if qdPreSnapTrace B
qdPreUpdateArborisSnap B
end
if not runFinalHead
ret 0
end
ret qdPrePickBest B checkParity
end

fn qdPreFillBenchToks pos ulong chunk ulong to void
bp = new uint 17 0
put bp 0 248045
put bp 1 846
put bp 2 198
put bp 3 3710
put bp 4 369
put bp 5 279
put bp 6 6511
put bp 7 314
put bp 8 9338
put bp 9 30
put bp 10 248046
put bp 11 198
put bp 12 248045
put bp 13 74455
put bp 14 198
put bp 15 248068
put bp 16 248069
for j ulong chunk bound 512
put qdPreTokIds j get bp rem add pos j 17
end
end

fn qdRunPrefillBench nTok ulong to int
qdResetState
put qdArbHits 0 0
put qdArbTot 0 0
put qdPreStatMs 0 0
t0 = monons
pos = ulong 0
prevChunk = ulong 0
hasPrev = false
while lt pos nTok bound 1024
chunk = sub nTok pos
if gt chunk QP_MAX_B
chunk = QP_MAX_B
end
isFinal = eq add pos chunk nTok
if hasPrev
if not qdWaitPre
ret 20
end
okSnap = qdPreSnapTrace prevChunk
qdPreFillBenchToks pos chunk
if not qdPreKickChunk chunk pos isFinal
ret 20
end
if okSnap
qdPreUpdateArborisSnap prevChunk
end
else
qdPreFillBenchToks pos chunk
if not qdPreKickChunk chunk pos isFinal
ret 20
end
end
prevChunk = chunk
hasPrev = true
pos = add pos chunk
end
if hasPrev
if not qdWaitPre
ret 20
end
if qdPreSnapTrace prevChunk
qdPreUpdateArborisSnap prevChunk
end
end
dtMs = div ulong sub monons t0 1000000
tps = ulong 0
if gt dtMs 0
tps = div mul nTok 1000 dtMs
end
hitPct = ulong 0
if gt get qdArbTot 0 0
hitPct = div mul get qdArbHits 0 100 get qdArbTot 0
end
qdPrint qpMsgBench
qdPrintU nTok
qdPrint qpMsgMs
qdPrintU dtMs
qdPrint qpMsgTps
qdPrintU tps
qdPrint qpMsgArb
qdPrintU hitPct
qdPrint qpMsgArbMs
qdPrintU get qdPreStatMs 0
qdPrint qdMsgNl
ret 0
end

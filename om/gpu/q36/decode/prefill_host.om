fn qdPreEmitMoeRouterW4 L ulong isFa bool B ulong to bool
pva = get qdPreVa 0
wva = get qdWorkVa 0
d4 = add qdLayerW4Va L W4_DENSE
routOff = ulong 18874368
if isFa
routOff = ulong 15335424
end
if not qdPreEmitBf16Gemm add pva QP_XNB add d4 routOff add pva QP_ROUT 257 B 257
ret false
end
trOff = add QP_TRACE mul L mul B 32
qdPtr add pva QP_ROUT
qdPtr qdW QDI_LEXMAP
qdPtr add pva QP_IDS
qdPtr add pva QP_WTS
qdPtr add pva QP_SHG
qdPtr add pva trOff
if not qdPktEmitGy 36 uint B 1 256
ret false
end
qdPtr add pva QP_IDS
qdPtr add pva QP_ECNT
qdArg uint B
ret qdPktEmitGy 37 1 1 256
end

fn qdPreEmitMoeGuW4 w4 ulong B ulong to bool
pva = get qdPreVa 0
qdPreSetStr 1024 0 9216 8192
qdPreSetKN 2048 1024 B
shS = add w4 add W4_GU_S 33554432
if not qdPreEmitW4Gemm add pva QP_XNB add w4 268435456 shS add pva QP_EMID
ret false
end
qdPtr add pva QP_XNB
qdPtr add w4 W4_GU_W
qdPtr add w4 W4_GU_S
qdPtr add pva QP_EMID
qdPtr add pva QP_ECNT
qdArg 2048
qdArg 1024
qdArg 0
qdArg 262144
qdArg 32768
gyExp = mul B 8
if gt gyExp 256
gyExp = ulong 256
end
if not qdPktEmitGy 38 16 uint gyExp 128
ret false
end
qdPtr add pva QP_EMID
qdPtr add pva QP_WTS
qdPtr add pva QP_SHG
qdPtr add pva QP_ESWB
ret qdPktEmitGy 39 9 uint B 256
end

fn qdPreEmitMoeDnW4 L ulong w4 ulong B ulong to bool
pva = get qdPreVa 0
qdPreSetStr 2304 2048 18432 16384
qdPreSetKN 512 2048 B
shW = add w4 add W4_DN_W 134217728
shS = add w4 add W4_DN_S 16777216
if not qdPreEmitW4Gemm add pva QP_ESWB shW shS add pva QP_EOUT
ret false
end
qdPtr add pva QP_ESWB
qdPtr add w4 W4_DN_W
qdPtr add w4 W4_DN_S
qdPtr add pva QP_EOUT
qdPtr add pva QP_ECNT
qdArg 512
qdArg 2048
qdArg 1
qdArg 131072
qdArg 16384
gyExp = mul B 8
if gt gyExp 256
gyExp = ulong 256
end
if not qdPktEmitGy 38 32 uint gyExp 128
ret false
end
nextNorm = qdW QDI_FNORM
if lt add L 1 QD_LAYERS
nextNorm = qdLayerSVa add L 1
end
qdPtr add pva QP_X
qdPtr add pva QP_EOUT
qdPtr nextNorm
qdPtr add pva QP_XN
qdPtr add pva QP_XNB
qdArg 1
ret qdPktEmitGy 40 uint B 1 256
end

fn qdPreEmitMoeW4 L ulong isFa bool B ulong to bool
if not qdPreEmitMoeRouterW4 L isFa B
ret false
end
w4 = qdLayerW4Va L
if not qdPreEmitMoeGuW4 w4 B
ret false
end
ret qdPreEmitMoeDnW4 L w4 B
end

fn qdSpecSaveGdnInputs gdnIdx ulong B ulong to bool
pva = get qdPreVa 0
sva = get qdSpecVa 0
dstQkv = add sva add QSP_QKV mul gdnIdx 393216
if not qdEmitCopyU32 add pva QP_QKV dstQkv mul B 49152
ret false
end
dstAb = add sva add QSP_AB mul gdnIdx 2048
ret qdEmitCopyU32 add pva QP_AB dstAb mul B 256
end

fn qdPreEmitGdnLayerW4 L ulong gdnIdx ulong B ulong to bool
pva = get qdPreVa 0
wva = get qdWorkVa 0
sbase = qdLayerSVa L
d4 = add qdLayerW4Va L W4_DENSE
if eq L 0
if not qdPreEmitGatherEmbeds B
ret false
end
if not qdPreEmitRmsNorm sbase add pva QP_AOUT 0 B
ret false
end
end
qdPreSetStr 1024 0 12288 0
qdPreSetKN 2048 12288 B
if not qdPreEmitW4Gemm add pva QP_XNB d4 add d4 12582912 add pva QP_QKV
ret false
end
if not qdPreEmitBf16Gemm add pva QP_XNB add d4 19927040 add pva QP_AB 64 B 64
ret false
end
if eq get qdSpecMode 0 1
if not qdSpecSaveGdnInputs gdnIdx B
ret false
end
end
note Register-stationary causal conv1d + SiLU across all B tokens
qdPtr add pva QP_QKV
qdPtr add sbase mul GDN_CONV 2
qdPtr add get qdGdnTailVa 0 mul gdnIdx 98304
qdArg uint B
if not qdPktEmitGy 30 32 1 256
ret false
end
note Per-token Q/K L2-norm + decay/beta
alogVa = add qdW QDI_ALOG mul gdnIdx 256
qdPtr add pva QP_QKV
qdPtr add pva QP_AB
qdPtr alogVa
qdPtr add alogVa 128
qdPtr add pva QP_DB
if not qdPktEmitGy 31 32 uint B 128
ret false
end
note ZERO-BARRIER warp-resident chunked GDN state update (reads & writes S ONCE for all B tokens!)
qdPtr add pva QP_QKV
qdPtr add pva QP_DB
qdPtr add get qdGdnStateVa 0 mul gdnIdx 2097152
qdPtr add pva QP_Y
qdArg uint B
if not qdPktEmitGy 32 32 4 256
ret false
end
note Per-head RMSNorm(lin_norm)*silu(z) -> packed BF16 QP_YB
qdPtr add pva QP_Y
qdPtr add pva QP_QKV
qdPtr add sbase mul GDN_LIN_NORM 2
qdPtr add pva QP_YB
if not qdPktEmitGy 33 32 uint B 128
ret false
end
note Tensor Core W4 out_proj [2048, 4096]
qdPreSetStr 2048 0 2048 0
qdPreSetKN 4096 2048 B
if not qdPreEmitW4Gemm add pva QP_YB add d4 14155776 add d4 18350080 add pva QP_AOUT
ret false
end
if not qdPreEmitRmsNorm add sbase mul GDN_POST_NORM 2 add pva QP_AOUT 1 B
ret false
end
ret qdPreEmitMoeW4 L false B
end

fn qdPreEmitFaLayerW4 L ulong faIdx ulong B ulong to bool
pva = get qdPreVa 0
sbase = qdLayerSVa L
d4 = add qdLayerW4Va L W4_DENSE
if eq L 0
if not qdPreEmitGatherEmbeds B
ret false
end

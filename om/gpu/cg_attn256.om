om2
note Pure OM-2 Blackwell decode attention 256 (Q38 27B / Q36, prep & multi-token) codegen (om/gpu/cg_attn256.om).
note Replaces the kernel emitter in src/omega_blackwell_codegen_attn256.c.

const A2_NOREG ulong 0xffffffffffffffff
const A2_NEG_BIG ulong 0xf149f2ca

fn a2_op v ulong s ulong to ulong
ret or v shl s 16
end

fn a2_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn a2_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn a2_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn a2_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 A2_NOREG
put r 2 A2_NOREG
put r 3 A2_NOREG
put r 4 A2_NOREG
put r 5 A2_NOREG
put r 6 0
put r 7 0
end

fn a2_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = a2_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = a2_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or a2_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or a2_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or a2_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or a2_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = a2_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = a2_cw 5 7 7 wt
if eq and shr get r 7 1 1 0
put meta 4 0
end
end
if eq kind 8
cw = or a2_cw 1 7 7 wt 0x2000
put meta 4 0
end
if eq kind 9
cw = or a2_cw 5 7 7 wt 0x2000
put meta 4 0
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn a2_emit_raw ins edit ulong 8192 meta edit ulong 512 r view ulong 8 cw ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn a2_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
n = get meta 0
if eq n 0
put meta 5 1
ret
end
put meta add 320 mul nl 2 start
put meta add 321 mul nl 2 sub n 1
put meta 3 add nl 1
end

fn a2_patch ins edit ulong 8192 meta edit ulong 512 pos ulong tgt ulong to void
if ne get meta 5 0
ret
end
if ge pos 1024
put meta 5 1
ret
end
idx = add mul pos 8 6
hi = and get ins idx 0xffffffff00000000
d = and sub tgt pos 0xffffffff
put ins idx or hi d
end

fn a2_ldcu64 ins edit ulong 8192 meta edit ulong 512 ud ulong off ulong to void
r = new ulong 8 0
a2_r0 edit r 7
put r 1 ud
put r 6 off
put r 7 1
a2_emit edit ins edit meta view r 4
end

fn a2_ldc64 ins edit ulong 8192 meta edit ulong 512 d ulong off ulong to void
r = new ulong 8 0
a2_r0 edit r 5
put r 1 d
put r 6 off
a2_emit edit ins edit meta view r 2
end

fn a2_ldc32 ins edit ulong 8192 meta edit ulong 512 d ulong off ulong to void
r = new ulong 8 0
a2_r0 edit r 4
put r 1 d
put r 6 off
a2_emit edit ins edit meta view r 2
end

fn a2_s2r ins edit ulong 8192 meta edit ulong 512 d ulong sr ulong to void
r = new ulong 8 0
a2_r0 edit r 3
put r 1 d
put r 6 sr
a2_emit edit ins edit meta view r 2
end


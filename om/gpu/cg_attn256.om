fn a2_bra ins edit ulong 8192 meta edit ulong 512 tgt ulong to void
r = new ulong 8 0
a2_r0 edit r 46
put r 6 and sub tgt get meta 0 0xffffffff
a2_emit edit ins edit meta view r 7
end

fn a2_bra_p0_fwd ins edit ulong 8192 meta edit ulong 512 to ulong
pos = get meta 0
r = new ulong 8 0
a2_r0 edit r 46
put r 6 1
put r 7 2
a2_emit edit ins edit meta view r 7
ret pos
end

fn a2_bssy_fwd ins edit ulong 8192 meta edit ulong 512 to ulong

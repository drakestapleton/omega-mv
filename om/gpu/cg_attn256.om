put r 6 imm
a2_emit edit ins edit meta view r 0
end

fn a2_movrz ins edit ulong 8192 meta edit ulong 512 dop ulong to void
r = new ulong 8 0
a2_r0 edit r 1
put r 1 and dop 0xffff
put r 7 shl shr dop 16 16
a2_emit edit ins edit meta view r 0
end

fn a2_imadi ins edit ulong 8192 meta edit ulong 512 dop ulong aop ulong imm ulong c ulong to void
r = new ulong 8 0
a2_r0 edit r 8
put r 1 and dop 0xffff
put r 2 and aop 0xffff
put r 4 c
put r 6 imm
put r 7 or shl shr dop 16 16 shl shr aop 16 24
a2_emit edit ins edit meta view r 0
end

fn a2_imadr ins edit ulong 8192 meta edit ulong 512 d ulong a ulong b ulong c ulong to void
r = new ulong 8 0

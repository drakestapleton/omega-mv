fn a2_bsync ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
a2_r0 edit r 55
a2_emit edit ins edit meta view r 9
end

fn a2_exit ins edit ulong 8192 meta edit ulong 512 to void
r = new ulong 8 0
a2_r0 edit r 45
a2_emit edit ins edit meta view r 7
end

fn a2_tail ins edit ulong 8192 meta edit ulong 512 to void
a2_exit edit ins edit meta
r = new ulong 8 0
a2_r0 edit r 46
a2_emit_raw edit ins edit meta view r 0x000fc000
end

fn a2_bf16_of ins edit ulong 8192 meta edit ulong 512 d ulong xop ulong tb ulong to void
a2_shr edit ins edit meta tb xop 16
a2_andi edit ins edit meta tb tb 1
a2_fop2 edit ins edit meta 14 tb tb get meta 413
a2_fop2 edit ins edit meta 14 d xop tb
a2_shr edit ins edit meta d d 16
end

fn a2_sts8 ins edit ulong 8192 meta edit ulong 512 base ulong qa ulong qb ulong to void
for i ulong 8
a2_imadi edit ins edit meta get meta 401 get meta 392 mul i 4 base
vo = a2_op qb sub i 4
if lt i 4
vo = a2_op qa i
end
a2_sts32 edit ins edit meta get meta 401 vo
end
end

fn a2_spec_ok_i sp view ulong 8 to ulong
d = get sp 0
if eq d 0
ret 0
end
if gt d 4
ret 0
end
if gt get sp 1 5
ret 0
end
if gt get sp 2 1
ret 0
end
if gt get sp 6 1
ret 0
end
qh = get sp 3
if eq qh 0
qh = 24
end
kvh = get sp 4
if eq kvh 0
kvh = 4
end
hv = get sp 5
if eq hv 0
hv = 6
end
if gt hv 6
ret 0
end
if ne rem qh hv 0
ret 0
end
vy = div qh hv
if ne rem vy kvh 0
ret 0
end
g = div vy kvh
g_ok = ulong 0
if eq g 1
g_ok = 1
end
if eq g 2
g_ok = 1
end
if eq g_ok 0
ret 0
end
if ne get sp 6 0
if eq get sp 2 0
if ne and vy sub vy 1 0
ret 0
end
end
end
ret 1
end


end

fn a2_xorr ins edit ulong 8192 meta edit ulong 512 dop ulong aop ulong bop ulong to void
r = new ulong 8 0
a2_r0 edit r 29
put r 1 and dop 0xffff
put r 2 and aop 0xffff
put r 3 and bop 0xffff
f1 = or shl shr dop 16 16 shl shr aop 16 24
put r 7 or f1 shl shr bop 16 32
a2_emit edit ins edit meta view r 0
end

fn a2_fop2 ins edit ulong 8192 meta edit ulong 512 op ulong dop ulong aop ulong bop ulong to void
r = new ulong 8 0
a2_r0 edit r op
put r 1 and dop 0xffff
put r 2 and aop 0xffff
put r 3 and bop 0xffff
f1 = or shl shr dop 16 16 shl shr aop 16 24
put r 7 or f1 shl shr bop 16 32
a2_emit edit ins edit meta view r 0
end

fn a2_ffma ins edit ulong 8192 meta edit ulong 512 dop ulong aop ulong bop ulong cop ulong to void
r = new ulong 8 0
a2_r0 edit r 33
put r 1 and dop 0xffff
put r 2 and aop 0xffff
put r 3 and bop 0xffff
put r 4 and cop 0xffff
f1 = or shl shr dop 16 16 shl shr aop 16 24
f2 = or shl shr bop 16 32 shl shr cop 16 40
put r 7 or f1 f2
a2_emit edit ins edit meta view r 0
end

fn a2_ldg64 ins edit ulong 8192 meta edit ulong 512 d ulong addr ulong imm ulong first ulong to void
r = new ulong 8 0
a2_r0 edit r 56
put r 1 d
put r 2 addr
put r 5 get meta 384
put r 6 imm
k = ulong 3
if ne first 0
k = 2
end
a2_emit edit ins edit meta view r k
end


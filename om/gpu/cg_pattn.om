fn pa_norm_rope_rot ins edit ulong 8192 meta edit ulong 512 x4 ulong to void
pa_sts32 edit ins edit meta get meta 411 pa_op x4 0
for i ulong 3
ii = add i 1
pa_imadi edit ins edit meta get meta 416 get meta 401 mul 4 ii get meta 411
pa_sts32 edit ins edit meta get meta 416 pa_op x4 ii
end
pa_bar edit ins edit meta
pa_lds128 edit ins edit meta get meta 417 get meta 412 0 1
if ne get meta 17 1
ts = get meta 414
for i ulong 4
pa_fop2 edit ins edit meta 32 ts pa_op x4 i pa_op get meta 422 i
pa_ffma edit ins edit meta pa_op x4 i pa_op get meta 417 i pa_op get meta 423 i ts
end
end
end

fn pa_norm_rope ins edit ulong 8192 meta edit ulong 512 x4 ulong w4 ulong to void

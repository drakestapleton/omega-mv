om2
note Pure OM-2 Blackwell causal prefill attention (hd=128) codegen (om/gpu/cg_pattn.om).
note Replaces the kernel emitter in src/omega_blackwell_codegen_pattn.c.

const PA_NOREG ulong 0xffffffffffffffff
const PA_NEG_BIG ulong 0xf149f2ca

fn pa_op v ulong s ulong to ulong
ret or v shl s 16
end

fn pa_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn pa_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn pa_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn pa_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 PA_NOREG
put r 2 PA_NOREG
put r 3 PA_NOREG
put r 4 PA_NOREG
put r 5 PA_NOREG
put r 6 0
put r 7 0
end

fn pa_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = pa_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = pa_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or pa_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or pa_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or pa_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or pa_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = pa_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = pa_cw 5 7 7 wt
if eq and shr get r 7 1 1 0
put meta 4 0
end
end
if eq kind 8
cw = or pa_cw 1 7 7 wt 0x2000
put meta 4 0
end
if eq kind 9
cw = or pa_cw 5 7 7 wt 0x2000
put meta 4 0
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn pa_emit_raw ins edit ulong 8192 meta edit ulong 512 r view ulong 8 cw ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end

fn pa_consume meta edit ulong 512 sb ulong to void
bit = shl ulong 1 sb
h = get meta 6
p = get meta 4
put meta 4 or p and h bit
put meta 6 sub h and h bit
end

fn pa_loop_end meta edit ulong 512 start ulong to void
nl = get meta 3
if ge nl 16
put meta 5 1
ret
end
n = get meta 0
if eq n 0
put meta 5 1
ret
end
put meta add 320 mul nl 2 start
put meta add 321 mul nl 2 sub n 1
put meta 3 add nl 1
end

fn pa_patch ins edit ulong 8192 meta edit ulong 512 pos ulong tgt ulong to void
if ne get meta 5 0
ret
end
if ge pos 1024
put meta 5 1
ret
end
idx = add mul pos 8 6
hi = and get ins idx 0xffffffff00000000
d = and sub tgt pos 0xffffffff
put ins idx or hi d
end


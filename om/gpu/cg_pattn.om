fn pa_spec_ok_i sp view ulong 4 to ulong
w = get sp 0
w_ok = ulong 0
if eq w 4
w_ok = 1
end
if eq w 8
w_ok = 1
end
if eq w_ok 0
ret 0
end
if gt get sp 1 4
ret 0
end
mode = get sp 2
if gt mode 2
ret 0
end
mir = get sp 3
if ne mir 0
if ne mir 1
ret 0
end
if ne mode 1
ret 0
end
end
ret 1
end


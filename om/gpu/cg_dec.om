om2
note Pure OM-2 Blackwell decode glue kernels codegen (om/gpu/cg_dec.om).
note Replaces the kernel emitters in src/omega_blackwell_codegen_dec.c.

const DC_NOREG ulong 0xffffffffffffffff
const DC_C_INV2048 ulong 0x3a000000
const DC_C_NLOG2E ulong 0xbfb8aa3b
const DC_C_ONE ulong 0x3f800000
const DC_C_2P23 ulong 0x4b000000

fn dc_op v ulong s ulong to ulong
ret or v shl s 16
end

fn dc_cw stall ulong wbar ulong rbar ulong wait ulong to ulong
a = or shl stall 9 shl wbar 14
b = or shl rbar 17 shl wait 20
ret or a b
end

fn dc_v meta edit ulong 512 w ulong to ulong
n = get meta 1
if ge n 256
put meta 5 1
ret 0
end
put meta add 64 n w
put meta 1 add n 1
ret n
end

fn dc_uv meta edit ulong 512 w ulong to ulong
n = get meta 2
if ge n 32
put meta 5 1
ret 0
end
put meta add 352 n w
put meta 2 add n 1
ret n
end

fn dc_r0 r edit ulong 8 op ulong to void
put r 0 op
put r 1 DC_NOREG
put r 2 DC_NOREG
put r 3 DC_NOREG
put r 4 DC_NOREG
put r 5 DC_NOREG
put r 6 0
put r 7 0
end

fn dc_emit ins edit ulong 8192 meta edit ulong 512 r view ulong 8 kind ulong to void
n = get meta 0
if ge n 1024
put meta 5 1
ret
end
wt = get meta 4
cw = ulong 0
if eq kind 0
cw = dc_cw 6 7 7 wt
put meta 4 0
end
if eq kind 1
cw = dc_cw 14 7 7 wt
put meta 4 0
end
if eq kind 2
cw = or dc_cw 4 0 1 wt 0x2000
put meta 4 3
end
if eq kind 3
cw = or dc_cw 4 0 1 and wt 2 0x2000
put meta 4 or wt 3
end
if eq kind 4
cw = or dc_cw 4 2 7 wt 0x2000
put meta 4 4
end
if eq kind 5
cw = or dc_cw 4 7 1 wt 0x2000
put meta 4 2
end
if eq kind 6
cw = dc_cw 6 7 7 wt
put meta 4 0
end
if eq kind 7
cw = dc_cw 5 7 7 wt
p0 = and shr get r 7 1 1
if eq p0 0
put meta 4 0
end
end
if eq kind 8
cw = dc_cw 5 7 7 wt
p0 = and shr get r 7 1 1
if eq p0 0
put meta 4 0
end
end
if eq kind 9
cw = or dc_cw 1 7 7 wt 0x2000
put meta 4 0
end
if eq kind 10
cw = or dc_cw 5 7 7 wt 0x2000
put meta 4 0
end
b = mul n 8
put ins b get r 0
put ins add b 1 get r 1
put ins add b 2 get r 2
put ins add b 3 get r 3
put ins add b 4 get r 4
put ins add b 5 get r 5
put ins add b 6 or and get r 6 0xffffffff shl cw 32
put ins add b 7 get r 7
put meta 0 add n 1
end


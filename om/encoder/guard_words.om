note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note guard_words.om: one line per op 0..63 and form 0 (always), 1 (@P0), 2 (@!P0).
note Concatenate after either bw_enc_sm121.om. The guard gate runs it on both copies.
note Line: op form status guard w0 w1 w2 w3
note status 0 accepted, 1 refused. guard is 99 when refused, else w0 bits 12..15.
note No arguments. Exit 0.
text gwsp " "
text gwnl "\n"

note encode op with form f (0 none, 1 @P0, 2 @!P0) into w; enc1's result (0 accepted)
fn gw_enc op ulong f ulong w edit ulong 4 to ulong
o = new ulong 16 0
put o 0 op
put o 1 4
put o 2 8
put o 3 12
put o 4 16
put o 5 4
if or eq op 46 eq op 54
put o 6 2
end
if eq op 11
put o 6 64
end
put o 12 1
put o 13 1
put o 14 1
put o 15 1
if ne f 0
put o 9 1
end
if eq f 2
put o 10 1
end
ret enc1 view o w
end

fn gw_dec x ulong to void
b = new uchar 20 0
i = ulong 20
v = x
c = true
while c bound 20
i = sub i 1
put b i uchar add 48 rem v 10
v = div v 10
if eq v 0
c = false
end
end
k = write 1 b i sub 20 i
end

fn gw_sp to void
k = write 1 gwsp 0 1
end

fn gw_line op ulong f ulong st ulong g ulong w view ulong 4 to void
gw_dec op
gw_sp
gw_dec f
gw_sp
gw_dec st
gw_sp
gw_dec g
for k ulong 4
gw_sp
gw_dec get w k
end
k = write 1 gwnl 0 1
end

fn main to int
w = new ulong 4 0
for op ulong 64
for f ulong 3
r = gw_enc op f edit w
if ne r 0
gw_line op f 1 99 view w
else
gw_line op f 0 and shr get w 0 12 15 view w
end
end
end
ret 0
end

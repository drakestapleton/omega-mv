note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note guard_pred_test.om: gate for the guard predicate of every sm_121 op this encoder emits (DRA-599).
note Concatenate after om/encoder/bw_enc_sm121.om; om/encoder/guard-gate.sh compiles it with the pinned omc.
note Input word 7 bit 1 (predicate_p0) and bit 2 (predicate_not) ask for @P0 / @!P0; the guard is w0 bits 12..15:
note 7 always (PT), 0 @P0, 8 @!P0. Every op 0..63 is encoded three times with R4 <- R8, R12, R16, UR4 (imm 2 for
note BRA and BSSY, else 0): unpredicated, @P0 and @!P0. The @P0 / @!P0 words must carry guard 0 / 8 and equal the
note unpredicated words in every other bit. LDCU and LDCU.64 (ops 6, 7) are uniform-datapath instructions: their
note guard bits name UP0..UPT, so @P0 cannot be encoded there and both forms must be refused.
note Program rows: the omega-mv #1044 seed/oscgpu bool and trap shapes (gpuir.om bw_bool, bw_trap; the C twin is
note src/omega_osc_gpu.c Bool, Trap) go through the program entry bw_enc_sm121 with word 7 as the C packer writes
note it: MOV R4, 0 / @P0 MOV R4, 1 / @!P0 STG.E desc[UR4][R8.64], R12 / @!P0 MOV R5, 1 / @!P0 MOV R4, 0. Their
note guards must be 7, 0, 8, 8, 8.
note No arguments: print one line per failing form (op, form 1 @P0 / 2 @!P0, guard read; 99 refused, 98 accepted
note but must refuse, 97 another bit changed; program rows as op 100 + row), then the failure count; exit 0 when
note none, else 1.
note One argument: write 133 instructions (2128 bytes) on stdout for the ORACLE: the @P0 and @!P0 forms of the 62
note P-guarded ops in op order, then the unpredicated LDCU and LDCU.64 words with their guard bits set to 0 and 8
note (an oracle probe, not encoder output), then the five program rows.
note Two arguments: read the ORACLE's text on stdin; instruction k must start with @P0 / @!P0 (k < 124, even / odd),
note then @UP0 / @!UP0 (124..127), then no guard, @P0, @!P0, @!P0, @!P0 (128..132). Exit 0, 4 when a guard or the
note instruction count is wrong, 70 read error, 71 text too long.
note ORACLE (independent, not first-party, never shipped): NVIDIA nvdisasm 13.0.85 -b SM121 -hex.
note Constants: 61440 = 0xf000 (guard mask), 124 = 2 * 62, 128 = 124 + 4, 133 = 128 + 5, 2128 = 133 * 16.
text gptok "@P0 @!P0 @UP0 @!UP0 "
text gpm1 "FAIL op "
text gpm2 " form "
text gpm3 " guard "
text gpm4 "guard predicate failures: "
text gpm5 "oracle instructions: "
text gpm6 " guard mismatches: "
text gprow "row guards:"
text gps " "
text gpnl "\n"
global gpbuf uchar 65536
const GPNONE ulong 18446744073709551615

note uniform-datapath ops: the guard bits name a uniform predicate
fn gp_uni op ulong to bool
ret or eq op 6 eq op 7
end

note encode op with form f (0 none, 1 @P0, 2 @!P0) into w; enc1's result (0 accepted)
fn gp_enc op ulong f ulong w edit ulong 4 to ulong
o = new ulong 16 0
put o 0 op
put o 1 4
put o 2 8
put o 3 12
put o 4 16
put o 5 4
if or eq op 46 eq op 54
put o 6 2
end
put o 12 1
put o 13 1
put o 14 1
put o 15 1
if ne f 0
put o 9 1
end
if eq f 2
put o 10 1
end
ret enc1 view o w
end

fn gp_dec x ulong to void
b = new uchar 20 0
i = ulong 20
v = x
c = true
while c bound 20
i = sub i 1
put b i uchar add 48 rem v 10
v = div v 10
if eq v 0
c = false
end
end
k = write 1 b i sub 20 i
end

fn gp_fail op ulong f ulong g ulong to void
k = write 1 gpm1 0 len gpm1
gp_dec op
k = write 1 gpm2 0 len gpm2
gp_dec f
k = write 1 gpm3 0 len gpm3
gp_dec g
k = write 1 gpnl 0 1
end

note the guard field of w0
fn gp_g w view ulong 4 to ulong
ret and shr get w 0 12 15
end

note equal outside the guard field
fn gp_same u view ulong 4 p view ulong 4 to bool
if ne or get u 0 61440 or get p 0 61440
ret false
end
for k ulong 3
if ne get u add k 1 get p add k 1
ret false
end
end
ret true
end

note the failing forms of op (0..2)
fn gp_row op ulong to ulong
u = new ulong 4 0
p = new ulong 4 0
if ne gp_enc op 0 edit u 0
gp_fail op 0 99
ret 1
end
bad = ulong 0
for f ulong 2
fm = add f 1
r = gp_enc op fm edit p
if gp_uni op
if eq r 0
gp_fail op fm 98
bad = add bad 1
end
else
if ne r 0
gp_fail op fm 99
bad = add bad 1
else
g = gp_g view p
if ne g mul f 8
gp_fail op fm g
bad = add bad 1
else
if not gp_same view u view p
gp_fail op fm 97
bad = add bad 1
end
end
end
end
end
ret bad
end

note program row r: op, dst, src1, src2, imm, word 7 (2 @P0, 6 @!P0), and the guard it must get
fn gp_pop r ulong to ulong
if eq r 2
ret 12
end
ret 2
end
fn gp_pdst r ulong to ulong
if eq r 2
ret GPNONE
end
if eq r 3
ret 5
end
ret 4
end
fn gp_pimm r ulong to ulong
if or eq r 1 eq r 3
ret 1
end
ret 0
end
fn gp_pfl r ulong to ulong
if eq r 0
ret 0
end
if eq r 1
ret 2
end
ret 6
end
fn gp_pg r ulong to ulong
if eq r 0
ret 7
end
if eq r 1
ret 0
end
ret 8
end

note the five #1044 rows through bw_enc_sm121 into code; the byte count (80 when accepted)
fn gp_penc code edit uchar 16384 to ulong
ins = new ulong 8192 0
phys = new ulong 288 0
for v ulong 256
put phys v v
end
for u ulong 32
put phys add 256 u u
end
for r ulong 5
b = mul r 8
put ins b gp_pop r
put ins add b 1 gp_pdst r
put ins add b 2 GPNONE
put ins add b 3 GPNONE
put ins add b 4 GPNONE
put ins add b 5 GPNONE
put ins add b 6 gp_pimm r
put ins add b 7 gp_pfl r
if eq r 2
put ins add b 2 8
put ins add b 3 12
put ins add b 5 4
end
end
ret bw_enc_sm121 view ins view phys 5 0 code
end

fn gp_prog to ulong
code = new uchar 16384 0
if ne gp_penc edit code 80
gp_fail 100 0 99
ret 1
end
k = write 1 gprow 0 len gprow
for r ulong 5
k = write 1 gps 0 1
g = and shr get code add mul r 16 1 4 15
gp_dec ulong g
end
k = write 1 gpnl 0 1
bad = ulong 0
for r ulong 5
g = and shr get code add mul r 16 1 4 15
if ne ulong g gp_pg r
gp_fail add 100 r gp_pfl r ulong g
bad = add bad 1
end
end
ret bad
end

fn gp_rows to int
bad = ulong 0
for op ulong 64
bad = add bad gp_row op
end
bad = add bad gp_prog
k = write 1 gpm4 0 len gpm4
gp_dec bad
k = write 1 gpnl 0 1
if ne bad 0
ret 1
end
ret 0
end

fn gp_bin to int
w = new ulong 4 0
code = new uchar 16384 0
pc = new uchar 16384 0
i = ulong 0
for op ulong 64
if not gp_uni op
for f ulong 2
if ne gp_enc op add f 1 edit w 0
ret int add 10 op
end
store edit code i view w
i = add i 1
end
end
end
for op ulong 64
if gp_uni op
if ne gp_enc op 0 edit w 0
ret int add 10 op
end
x = get w 0
for f ulong 2
put w 0 or sub x and x 61440 shl mul f 8 12
store edit code i view w
i = add i 1
end
end
end
if ne gp_penc edit pc 80
ret 9
end
for q ulong 80
put code add mul i 16 q get pc q
end
n = add mul i 16 80
off = ulong 0
while lt off n bound 4096
k = write 1 code off sub n off
if le k 0
ret 3
end
off = add off ulong k
end
ret 0
end

fn gp_ts t ulong to ulong
if eq t 0
ret 0
end
if eq t 1
ret 4
end
if eq t 2
ret 9
end
ret 14
end

note does token t of gptok start at gpbuf[j]? Token 4 is no guard (the mnemonic is not an @ word).
fn gp_tok j ulong n ulong t ulong to bool
if eq t 4
if ge j n
ret false
end
ret ne get gpbuf j 64
end
s = gp_ts t
e = gp_ts add t 1
if eq t 3
e = 20
end
if gt add j sub e s n
ret false
end
for q ulong sub e s
if ne get gpbuf add j q get gptok add s q
ret false
end
end
ret true
end

note an address marker "/*" then a hex digit at gpbuf[i]; the caller keeps i + 2 below n
fn gp_mark i ulong to bool
if ne get gpbuf i 47
ret false
end
if ne get gpbuf add i 1 42
ret false
end
c = get gpbuf add i 2
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end

note the index after the marker's "*/" and the blanks that follow
fn gp_after i ulong n ulong to ulong
j = add i 2
while lt add j 1 n bound 65536
if eq get gpbuf j 42
if eq get gpbuf add j 1 47
j = add j 2
break
end
end
j = add j 1
end
while lt j n bound 65536
c = get gpbuf j
if and ne c 32 ne c 9
break
end
j = add j 1
end
ret j
end

note the token instruction k must carry
fn gp_want k ulong to ulong
if lt k 124
ret rem k 2
end
if lt k 128
ret add 2 rem k 2
end
if eq k 128
ret 4
end
if eq k 129
ret 0
end
ret 1
end

fn gp_check to int
n = ulong 0
while lt n 65536 bound 65536
r = read 0 gpbuf n sub 65536 n
if lt r 0
ret 70
end
if eq r 0
break
end
n = add n ulong r
end
if eq n 65536
ret 71
end
k = ulong 0
bad = ulong 0
i = ulong 0
while lt add i 2 n bound 65536
if gp_mark i
j = gp_after i n
if not gp_tok j n gp_want k
bad = add bad 1
end
k = add k 1
i = j
else
i = add i 1
end
end
w = write 1 gpm5 0 len gpm5
gp_dec k
w = write 1 gpm6 0 len gpm6
gp_dec bad
w = write 1 gpnl 0 1
if or ne k 133 ne bad 0
ret 4
end
ret 0
end

fn main to int
if gt argcnt 3
ret 64
end
if eq argcnt 3
ret gp_check
end
if eq argcnt 2
ret gp_bin
end
ret gp_rows
end

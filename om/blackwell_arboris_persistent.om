note SPDX-License-Identifier: AGPL-3.0-only
note One independent max-product query per 128-thread CTA. All of its vertices
note must fit in two CTA-local score banks. CSR and weights stay read-only.
note A barrier between hops orders every in-CTA edge; no inter-CTA edge or
note frontier exchange is admitted. Dynamic tile loops handle partial warps.
fn ap_tile code edit uchar 16384 s edit ulong 5 to void
  wave_ins code s 14 36 0 34
  gv_imad code s 5 36 1 wave_rz
  wave_ins code s 28 0 36 6
  put s 3 1
  wave_imm code s 2 5 0
end

fn ap_continue code edit uchar 16384 s edit ulong 5 cfg edit ulong 192 label ulong to void
  wave_ins code s 14 34 34 7
  wave_ins code s 28 0 34 6
  gv_jump code s cfg label 2
end

fn ap_edge_loop code edit uchar 16384 s edit ulong 5 to void
  join = get s 0
  wave_imm code s 54 0 2
  top = get s 0
  wave_ins code s 28 0 20 21
  branch = get s 0
  put s 3 1
  wave_imm code s 46 0 1
  wave_wide code s 18 20 4 10
  wave_ins code s 11 22 18 wave_rz
  wave_wide code s 18 20 4 12
  wave_ins code s 11 23 18 wave_rz
  gv_imad code s 33 22 4 30
  wave_ins code s 49 24 33 wave_rz
  wave_ins code s 32 23 26 23
  wave_ins code s 32 25 24 23
  wave_ins code s 37 29 29 25
  wave_ins code s 14 20 20 3
  wave_imm code s 46 0 and sub top get s 0 0xffffffff
  sync = get s 0
  wave_ins code s 55 0 wave_rz wave_rz
  done = get s 0
  put s 0 branch
  put s 3 1
  wave_imm code s 46 0 sub sync branch
  put s 0 join
  wave_imm code s 54 0 sub done join
  put s 0 done
end

fn ap_init code edit uchar 16384 s edit ulong 5 cfg edit ulong 192 to void
  wave_imm code s 3 0 0x21
  wave_imm code s 3 2 0x26
  wave_imm code s 7 4 0x358
  for p ulong 5
    wave_imm code s 5 add 8 mul 2 p add 0x380 mul 8 p
  end
  wave_imm code s 4 26 0x3a8
  wave_imm code s 2 6 get cfg 0
  wave_imm code s 2 7 128
  wave_imm code s 2 3 1
  wave_imm code s 2 30 0
  pitch = mul 4 get cfg 0
  wave_imm code s 2 31 pitch
  wave_imm code s 2 32 get cfg 1
  wave_wide code s 14 2 pitch 14
  wave_wide code s 16 2 pitch 16
  wave_imm code s 2 34 0
  gv_mark s cfg 0
  ap_tile code s
  wave_wide code s 18 5 4 14
  wave_ins code s 11 29 18 wave_rz
  gv_imad code s 33 5 4 30
  wave_ins code s 28 0 36 6
  put s 3 2
  wave_ins code s 50 wave_rz 33 29
  ap_continue code s cfg 0
  wave_ins code s 48 wave_rz wave_rz wave_rz
end

fn ap_hops code edit uchar 16384 s edit ulong 5 cfg edit ulong 192 to void
  gv_mark s cfg 1
  wave_imm code s 2 34 0
  gv_mark s cfg 2
  ap_tile code s
  wave_wide code s 18 5 4 8
  wave_ins code s 11 20 18 wave_rz
  put s 1 4
  wave_ins code s 11 21 18 wave_rz
  gv_imad code s 33 5 4 30
  wave_ins code s 49 29 33 wave_rz
  wave_ins code s 28 0 36 6
  put s 3 1
  gv_imad code s 20 21 1 wave_rz
  ap_edge_loop code s
  gv_imad code s 33 5 4 31
  wave_ins code s 28 0 36 6
  put s 3 2
  wave_ins code s 50 wave_rz 33 29
  ap_continue code s cfg 2
  wave_ins code s 48 wave_rz wave_rz wave_rz
  gv_imad code s 33 30 1 wave_rz
  gv_imad code s 30 31 1 wave_rz
  gv_imad code s 31 33 1 wave_rz
  wave_imm code s 2 33 0xffffffff
  wave_ins code s 14 32 32 33
  wave_ins code s 28 0 32 3
  gv_jump code s cfg 1 1
end

fn arboris_emit_persistent n ulong hops ulong code edit uchar 16384 to ulong
  if or eq n 0 gt n div qmd_scratch_limit 8
    ret 0
  end
  if or eq hops 0 gt hops 0xffffffff
    ret 0
  end
  s = new ulong 5 0
  cfg = new ulong 192 0
  put s 2 wave_rz
  put cfg 0 n
  put cfg 1 hops
  ap_init code s cfg
  ap_hops code s cfg
  wave_imm code s 2 34 0
  gv_mark s cfg 3
  ap_tile code s
  gv_imad code s 33 5 4 30
  wave_ins code s 49 29 33 wave_rz
  wave_wide code s 18 5 4 16
  wave_ins code s 28 0 36 6
  put s 3 2
  wave_ins code s 12 wave_rz 18 29
  ap_continue code s cfg 3
  wave_exit code s
  gv_relocate code s cfg
  if ne get s 4 0
    ret 0
  end
  ret mul get s 0 16
end

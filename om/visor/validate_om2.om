note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 semantic graph validation & iterative cycle detector backing src/omega_validate.c.
om2

export fn om_val_kind kind ulong to long
  if or eq kind 0 gt kind 11
    ret -1
  end
  ret 0
end

export fn om_val_rel_kind kind ulong to long
  if or eq kind 0 gt kind 9
    ret -1
  end
  ret 0
end

export fn om_val_const_kind kind ulong to long
  if or eq kind 0 gt kind 9
    ret -1
  end
  ret 0
end

note Validate TypePayload fields: 0 OK, 1 invalid tag, 2 uint width, 3 sint width, 4 fp32 width, 5 bv width, 6 seq len.
export fn om_val_type_fields tag ulong width ulong slen ulong to long
  if or eq tag 0 gt tag 14
    ret 1
  end
  if eq tag 3
    if or lt width 1 gt width 256
      ret 2
    end
  end
  if eq tag 4
    if or lt width 2 gt width 256
      ret 3
    end
  end
  if eq tag 14
    if ne width 32
      ret 4
    end
  end
  if eq tag 5
    if or lt width 1 gt width 256
      ret 5
    end
  end
  if eq tag 7
    if gt slen 65535
      ret 6
    end
  end
  ret 0
end

note Validate ValuePayload blen against integer/bitvector type width. Returns 0 OK, or expected bytes > 0 on mismatch.
export fn om_val_val_bytes tag ulong width ulong blen ulong to long
  if or eq tag 3 or eq tag 4 eq tag 5
    exp = div add width 7 8
    if ne blen exp
      ret long exp
    end
  end
  ret 0
end

note Validate OperationPayload fields: 0 OK, 1 invalid opcode, 2 invalid overflow policy.
export fn om_val_op_fields opcode ulong overflow ulong to long
  if or eq opcode 0 gt opcode 16
    ret 1
  end
  if or eq overflow 0 gt overflow 3
    ret 2
  end
  ret 0
end

note Validate graph object count: 0 OK, 1 empty, 2 exceeds max.
export fn om_val_graph_count cnt ulong mcnt ulong to long
  if eq cnt 0
    ret 1
  end
  if gt cnt mcnt
    ret 2
  end
  ret 0
end

fn dfs_from edges view ushort 32768 deg view ushort 256 col edit uchar 256 root ulong to ulong
  frm = new ushort 512 0
  put frm 0 ushort root
  put frm 1 0
  put col root 1
  sp = ulong 1
  while gt sp 0
    u = ulong get frm mul sub sp 1 2
    k = ulong get frm add mul sub sp 1 2 1
    if ge k ulong get deg u
      put col u 2
      sp = sub sp 1
    else
      put frm add mul sub sp 1 2 1 ushort add k 1
      ent = ulong get edges add mul u 128 k
      tgt = and ent 511
      if lt tgt 256
        if eq get col tgt 0
          put col tgt 1
          put frm mul sp 2 ushort tgt
          put frm add mul sp 2 1 0
          sp = add sp 1
        else
          if eq get col tgt 1
            ret add ent 1
          end
        end
      end
    end
  end
  ret 0
end

note Iterative 3-color DFS cycle detector matching check_cycle_dfs order.
note edges[u*128 + k] packs (edge_kind << 9) | target_idx (edge_kind 0=relation, 1=operand).
note deg[u] is edge count for object u (<= 128). n <= 256.
note Returns 0 if acyclic, -1 if cycle found with info[0]=target_idx, info[1]=edge_kind.
export fn om_val_find_cycle edges view ushort 32768 deg view ushort 256 n ulong info edit ulong 2 to long
  if gt n 256
    ret -2
  end
  col = new uchar 256 0
  for root ulong n
    if eq get col root 0
      r = dfs_from edges deg col root
      if ne r 0
        ent = sub r 1
        put info 0 and ent 511
        put info 1 shr ent 9
        ret -1
      end
    end
  end
  ret 0
end

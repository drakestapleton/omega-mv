note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 verification engine primitives backing src/omega_verify.c.
om2

note V0 structural realization bounds check:
note profile == 1 (AARCH64_PROFILE_V8A_BAREMETAL), 4 <= clen <= mcode, clen % 4 == 0, hasid != 0.
note Returns 0 OK, 1 bad profile, 2 bad clen, 3 missing id.
export fn om_ver_v0_real prof ulong clen ulong mcode ulong hasid ulong to long
  if ne prof 1
    ret 1
  end
  if or lt clen 4 or gt clen mcode ne rem clen 4 0
    ret 2
  end
  if eq hasid 0
    ret 3
  end
  ret 0
end

note V1 semantic reference evaluation: F(a, b, c) = (a + b) - c modulo 2^64.
export fn om_ver_v1_ref a ulong b ulong c ulong to ulong
  ret sub add a b c
end

note V1 default test vectors (7 triplets). Returns 0 if idx in 0..6, -1 otherwise.
export fn om_ver_v1_defvec idx ulong dst edit ulong 3 to long
  if eq idx 0
    put dst 0 7
    put dst 1 11
    put dst 2 3
    ret 0
  end
  if eq idx 1
    put dst 0 0
    put dst 1 0
    put dst 2 0
    ret 0
  end
  if eq idx 2
    put dst 0 100
    put dst 1 200
    put dst 2 50
    ret 0
  end
  if eq idx 3
    put dst 0 1000
    put dst 1 500
    put dst 2 300
    ret 0
  end
  if eq idx 4
    put dst 0 1
    put dst 1 1
    put dst 2 1
    ret 0
  end
  if eq idx 5
    put dst 0 50
    put dst 1 0
    put dst 2 10
    ret 0
  end
  if eq idx 6
    put dst 0 18446744073709551614
    put dst 1 1
    put dst 2 0
    ret 0
  end
  ret -1
end

fn mask_w width ulong to ulong
  if ge width 64
    ret 18446744073709551615
  end
  ret sub shl ulong 1 width 1
end

note Pure binary uint wrap evaluation for OP_ADD(3), OP_SUB(4), OP_MUL(5), OP_AND(9), OP_OR(10).
export fn om_ver_v2_eval op ulong width ulong a ulong b ulong to ulong
  m = mask_w width
  if eq op 3
    ret and add a b m
  end
  if eq op 4
    ret and sub a b m
  end
  if eq op 5
    ret and mul a b m
  end
  if eq op 9
    ret and and a b m
  end
  if eq op 10
    ret and or a b m
  end
  ret 0
end

note Run full V2 algebraic property suite in pure OM-2.
note Returns total check count (>= 0) on pass, or -1 on failure with info[0]=kind (1..7), info[1]=op, info[2]=x, info[3]=y.
export fn om_ver_v2_props info edit ulong 4 to long
  cnt = ulong 0
  oparr = new ulong 4 0
  put oparr 0 3
  put oparr 1 5
  put oparr 2 9
  put oparr 3 10
  for o ulong 4
    op = get oparr o
    x = ulong 0
    while lt x 32
      y = ulong 0
      while lt y 32
        cnt = add cnt 1
        r1 = om_ver_v2_eval op 64 x y
        r2 = om_ver_v2_eval op 64 y x
        if ne r1 r2
          put info 0 1
          put info 1 op
          put info 2 x
          put info 3 y
          ret -1
        end
        y = add y 5
      end
      x = add x 7
    end
  end
  all1 = ulong 18446744073709551615
  for v ulong 64
    cnt = add cnt 1
    if ne om_ver_v2_eval 3 64 v 0 v
      put info 0 2
      put info 1 3
      put info 2 v
      put info 3 0
      ret -1
    end
    cnt = add cnt 1
    if ne om_ver_v2_eval 5 64 v 1 v
      put info 0 3
      put info 1 5
      put info 2 v
      put info 3 1
      ret -1
    end
    cnt = add cnt 1
    if ne om_ver_v2_eval 9 64 v all1 v
      put info 0 4
      put info 1 9
      put info 2 v
      put info 3 all1
      ret -1
    end
    cnt = add cnt 1
    if ne om_ver_v2_eval 10 64 v 0 v
      put info 0 5
      put info 1 10
      put info 2 v
      put info 3 0
      ret -1
    end
  end
  cnt = add cnt 1
  if ne om_ver_v2_eval 3 64 all1 1 0
    put info 0 6
    put info 1 3
    put info 2 all1
    put info 3 1
    ret -1
  end
  cnt = add cnt 1
  if ne om_ver_v2_eval 4 64 0 1 all1
    put info 0 6
    put info 1 4
    put info 2 0
    put info 3 1
    ret -1
  end
  cnt = add cnt 1
  if ne om_ver_v2_eval 3 16 65535 1 0
    put info 0 7
    put info 1 3
    put info 2 65535
    put info 3 1
    ret -1
  end
  put info 0 0
  put info 1 0
  put info 2 0
  put info 3 0
  ret long cnt
end

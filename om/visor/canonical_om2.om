note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 canonical encoding & SemanticId primitives backing src/omega_canonical.c.
om2

note Per-kind object version: KIND_EFFECT (8) -> 2, all others -> 1.
export fn om_canon_obj_ver kind ulong to ulong
  if eq kind 8
    ret 2
  end
  ret 1
end

note Check header (version, kind): 0 OK, -2 legacy v1 effect refused, -1 version mismatch.
export fn om_canon_chk_hdr ver ulong kind ulong to long
  if and eq kind 8 eq ver 1
    ret -2
  end
  if ne ver om_canon_obj_ver kind
    ret -1
  end
  ret 0
end

note Lexicographical comparison of two 32-byte SemanticIds (-1, 0, 1).
export fn om_canon_cmp_id a view uchar 32 b view uchar 32 to long
  for i ulong 32
    va = ulong get a i
    vb = ulong get b i
    if lt va vb
      ret -1
    end
    if gt va vb
      ret 1
    end
  end
  ret 0
end

fn hex_nib v ulong to uchar
  if lt v 10
    ret uchar add v 48
  end
  ret uchar add v 87
end

note Format 32-byte SemanticId as 64 lowercase hex chars + NUL terminator.
export fn om_canon_hex_id id view uchar 32 dst edit uchar 65 to void
  for i ulong 32
    b = ulong get id i
    put dst mul i 2 hex_nib shr b 4
    put dst add mul i 2 1 hex_nib and b 15
  end
  put dst 64 0
end

fn hex_val c ulong to long
  if and ge c 48 le c 57
    ret long sub c 48
  end
  if and ge c 97 le c 102
    ret long add sub c 97 10
  end
  if and ge c 65 le c 70
    ret long add sub c 65 10
  end
  ret -1
end

note Parse 64-char hex string into 32-byte SemanticId. Returns 0 on success, -1 on refusal.
export fn om_canon_parse_hex hx view uchar * n ulong dst edit uchar 32 to long
  if ne n 64
    ret -1
  end
  for i ulong 32
    hi = hex_val ulong get hx mul i 2
    lo = hex_val ulong get hx add mul i 2 1
    if or lt hi 0 lt lo 0
      ret -1
    end
    put dst i uchar or shl ulong hi 4 ulong lo
  end
  ret 0
end

note Write canonical OMG0 header (6 bytes) into dst[0..5]. Returns 6 or -1 if mlen < 6.
export fn om_canon_write_hdr kind ulong dst edit uchar * mlen ulong to long
  if or lt mlen 6 lt len dst 6
    ret -1
  end
  put dst 0 79
  put dst 1 77
  put dst 2 71
  put dst 3 48
  put dst 4 uchar om_canon_obj_ver kind
  put dst 5 uchar and kind 255
  ret 6
end

note Write big-endian u16 at dst[pos..pos+1]. Returns pos+2 or -1.
export fn om_canon_write_u16be v ulong dst edit uchar * pos ulong mlen ulong to long
  if or gt add pos 2 mlen gt add pos 2 len dst
    ret -1
  end
  put dst pos uchar and shr v 8 255
  put dst add pos 1 uchar and v 255
  ret long add pos 2
end

note Write big-endian u32 at dst[pos..pos+3]. Returns pos+4 or -1.
export fn om_canon_write_u32be v ulong dst edit uchar * pos ulong mlen ulong to long
  if or gt add pos 4 mlen gt add pos 4 len dst
    ret -1
  end
  put dst pos uchar and shr v 24 255
  put dst add pos 1 uchar and shr v 16 255
  put dst add pos 2 uchar and shr v 8 255
  put dst add pos 3 uchar and v 255
  ret long add pos 4
end

note Compare two 64-byte NUL-terminated attribute keys at slots ia and ib in keys[32*64].
fn cmp_attr_key keys view uchar 2048 ia ulong ib ulong to long
  oa = mul ia 64
  ob = mul ib 64
  for k ulong 64
    ca = ulong get keys add oa k
    cb = ulong get keys add ob k
    if lt ca cb
      ret -1
    end
    if gt ca cb
      ret 1
    end
    if eq ca 0
      ret 0
    end
  end
  ret 0
end

note Stable insertion sort of attribute indices [0..n-1] by key ascending.
export fn om_canon_sort_attr keys view uchar 2048 n ulong order edit ushort 32 to long
  if gt n 32
    ret -1
  end
  for i ulong n
    put order i ushort i
  end
  i = ulong 1
  while lt i n
    kidx = ulong get order i
    j = long sub i 1
    while ge j 0
      prev = ulong get order ulong j
      if le cmp_attr_key keys prev kidx 0
        break
      end
      put order ulong add j 1 ushort prev
      j = sub j 1
    end
    put order ulong add j 1 ushort kidx
    i = add i 1
  end
  ret 0
end

note Compare two relations by (kind, 32-byte target_id).
fn cmp_rel kinds view ushort 64 targets view uchar 2048 ia ulong ib ulong to long
  ka = ulong get kinds ia
  kb = ulong get kinds ib
  if lt ka kb
    ret -1
  end
  if gt ka kb
    ret 1
  end
  oa = mul ia 32
  ob = mul ib 32
  for k ulong 32
    ba = ulong get targets add oa k
    bb = ulong get targets add ob k
    if lt ba bb
      ret -1
    end
    if gt ba bb
      ret 1
    end
  end
  ret 0
end

note Stable insertion sort of relation indices [0..n-1] by (kind, target_id).
export fn om_canon_sort_rel kinds view ushort 64 targets view uchar 2048 n ulong order edit ushort 64 to long
  if gt n 64
    ret -1
  end
  for i ulong n
    put order i ushort i
  end
  i = ulong 1
  while lt i n
    cur = ulong get order i
    j = long sub i 1
    while ge j 0
      prev = ulong get order ulong j
      if le cmp_rel kinds targets prev cur 0
        break
      end
      put order ulong add j 1 ushort prev
      j = sub j 1
    end
    put order ulong add j 1 ushort cur
    i = add i 1
  end
  ret 0
end

fn cmp_const_pay payloads view uchar 4096 oa ulong ob ulong ml ulong to long
  for k ulong ml
    ba = ulong get payloads add oa k
    bb = ulong get payloads add ob k
    if lt ba bb
      ret -1
    end
    if gt ba bb
      ret 1
    end
  end
  ret 0
end

note Compare two constraints by (kind, payload bytes, payload_len). meta packs [2*i]=kind, [2*i+1]=len.
fn cmp_const meta view ushort 64 payloads view uchar 4096 ia ulong ib ulong to long
  ka = ulong get meta mul ia 2
  kb = ulong get meta mul ib 2
  if lt ka kb
    ret -1
  end
  if gt ka kb
    ret 1
  end
  la = ulong get meta add mul ia 2 1
  lb = ulong get meta add mul ib 2 1
  ml = la
  if lt lb ml
    ml = lb
  end
  c = cmp_const_pay payloads mul ia 128 mul ib 128 ml
  if ne c 0
    ret c
  end
  if lt la lb
    ret -1
  end
  if gt la lb
    ret 1
  end
  ret 0
end

note Stable insertion sort of constraint indices [0..n-1].
export fn om_canon_sort_const meta view ushort 64 payloads view uchar 4096 n ulong order edit ushort 32 to long
  if gt n 32
    ret -1
  end
  for i ulong n
    put order i ushort i
  end
  i = ulong 1
  while lt i n
    cur = ulong get order i
    j = long sub i 1
    while ge j 0
      prev = ulong get order ulong j
      if le cmp_const meta payloads prev cur 0
        break
      end
      put order ulong add j 1 ushort prev
      j = sub j 1
    end
    put order ulong add j 1 ushort cur
    i = add i 1
  end
  ret 0
end

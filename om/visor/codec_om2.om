note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 binary graph codec framing primitives backing src/omega_codec.c.
om2

note Encode OMGG graph header (6 bytes) into dst[0..5]. Returns 6 or -1.
export fn om_codec_hdr_enc cnt ulong dst edit uchar * mlen ulong to long
  if or lt mlen 6 lt len dst 6
    ret -1
  end
  put dst 0 79
  put dst 1 77
  put dst 2 71
  put dst 3 71
  put dst 4 uchar and shr cnt 8 255
  put dst 5 uchar and cnt 255
  ret 6
end

note Decode and validate OMGG graph header. Returns object count (>= 0) or -1.
export fn om_codec_hdr_dec buf view uchar * n ulong mobj ulong to long
  if or lt n 6 lt len buf 6
    ret -1
  end
  if or ne get buf 0 79 ne get buf 1 77
    ret -1
  end
  if or ne get buf 2 71 ne get buf 3 71
    ret -1
  end
  cnt = or shl ulong get buf 4 8 ulong get buf 5
  if gt cnt mobj
    ret -1
  end
  ret long cnt
end

note Read big-endian u16 from buf[pos..pos+1].
export fn om_codec_u16_rd buf view uchar * pos ulong to ulong
  ret or shl ulong get buf pos 8 ulong get buf add pos 1
end

note Read big-endian u32 from buf[pos..pos+3].
export fn om_codec_u32_rd buf view uchar * pos ulong to ulong
  b0 = shl ulong get buf pos 24
  b1 = shl ulong get buf add pos 1 16
  b2 = shl ulong get buf add pos 2 8
  b3 = ulong get buf add pos 3
  ret or or b0 b1 or b2 b3
end

note Validate embedded OMG0 object header at buf[pos..pos+5] with clen >= 6 and per-kind version.
note Returns SemanticKind (0..255) on success, or -1 on refusal.
export fn om_codec_obj_hdr_chk buf view uchar * pos ulong clen ulong to long
  if or lt clen 6 gt add pos 6 len buf
    ret -1
  end
  if or ne get buf pos 79 ne get buf add pos 1 77
    ret -1
  end
  if or ne get buf add pos 2 71 ne get buf add pos 3 48
    ret -1
  end
  ver = ulong get buf add pos 4
  kind = ulong get buf add pos 5
  exp = ulong 1
  if eq kind 8
    exp = 2
  end
  if ne ver exp
    ret -1
  end
  ret long kind
end

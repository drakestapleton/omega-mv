note SPDX-License-Identifier: AGPL-3.0-only
note Domain and range tables transcribed from Adam Pippert, Arboris (Apache-2.0),
note commit 803b432c9be11f0150faa7199d33c40adbda9ae6, ontologies/ upper and domains v0.1.0.
note Profile 1 selects upper, 2 infrastructure. Type and relation handles are
note zero-based document order. Property bits in order: name, schedulable, phase, replicas, active.
om2

note upper-0.1.0 type order:
note Entity, Agent, Object, System, Component, Event, State, Action, Process, Place, Time, Quantity, Observation, Goal, Claim, Hypothesis, Prediction, Constraint, Resource, Capability
fn arboris_rule_1 relation ulong to ulong
  note is_a
  if eq relation 0
    ret 0x100000001
  end
  note part_of
  if eq relation 1
    ret 0x100000001
  end
  note contains
  if eq relation 2
    ret 0x100000001
  end
  note located_in
  if eq relation 3
    ret 0x20100000001
  end
  note participates_in
  if eq relation 4
    ret 0x12000000001
  end
  note acts_on
  if eq relation 5
    ret 0x100000082
  end
  note causes
  if eq relation 6
    ret 0x60000000e0
  end
  note enables
  if eq relation 7
    ret 0x1c000000041
  end
  note prevents
  if eq relation 8
    ret 0x1c000000041
  end
  note precedes
  if eq relation 9
    ret 0xe0000000e0
  end
  note follows
  if eq relation 10
    ret 0xe0000000e0
  end
  note depends_on
  if eq relation 11
    ret 0x100000001
  end
  note supports
  if eq relation 12
    ret 0x400100004001
  end
  note contradicts
  if eq relation 13
    ret 0x504000005040
  end
  note observes
  if eq relation 14
    ret 0x6100001002
  end
  note has_state
  if eq relation 15
    ret 0x4000000001
  end
  note transforms_into
  if eq relation 16
    ret 0x4100000041
  end
  note owns
  if eq relation 17
    ret 0x10000000a
  end
  note controls
  if eq relation 18
    ret 0x10000000a
  end
  note connected_to
  if eq relation 19
    ret 0x100000001
  end
  note communicates_with
  if eq relation 20
    ret 0x100000001
  end
  note requires
  if eq relation 21
    ret 0x4004100000181
  end
  note produces
  if eq relation 22
    ret 0x4000100000101
  end
  note consumes
  if eq relation 23
    ret 0x4000100000101
  end
  ret 0
end

note infrastructure-0.1.0 type order:
note Host, Process, Service, Container, Image, Cluster, Node, Pod, Deployment, ReplicaSet, Network, Route, Volume, Certificate, Alert, Request, Dependency, State, Action, Observation
fn arboris_rule_2 relation ulong to ulong
  note part_of
  if eq relation 0
    ret 0x20000009c4
  end
  note scheduled_on
  if eq relation 1
    ret 0x4000000080
  end
  note managed_by
  if eq relation 2
    ret 0x30000000280
  end
  note selects
  if eq relation 3
    ret 0x18000000004
  end
  note routes_to
  if eq relation 4
    ret 0x8400000804
  end
  note depends_on
  if eq relation 5
    ret 0x380400000184
  end
  note has_state
  if eq relation 6
    ret 0x20000000009ef
  end
  ret 0
end

fn arboris_node_ok profile ulong kind ulong properties uint states uint to bool
  if ge kind 20
    ret false
  end
  if eq and states 3 3
    ret false
  end
  if eq profile 1
    ret true
  end
  if ne profile 2
    ret false
  end
  note Cluster requires name
  if eq kind 5
    ret eq and properties 1 1
  end
  note Node requires name, schedulable
  if eq kind 6
    ret eq and properties 3 3
  end
  note Pod requires name, phase
  if eq kind 7
    ret eq and properties 5 5
  end
  note Deployment requires name, replicas
  if eq kind 8
    ret eq and properties 9 9
  end
  note Service requires name
  if eq kind 2
    ret eq and properties 1 1
  end
  note Route requires active
  if eq kind 11
    ret eq and properties 16 16
  end
  ret true
end

fn arboris_edge_ok profile ulong relation ulong subject ulong object_type ulong to bool
  if or ge subject 20 ge object_type 20
    ret false
  end
  rule = ulong 0
  if eq profile 1
    rule = arboris_rule_1 relation
  end
  if eq profile 2
    rule = arboris_rule_2 relation
  end
  return_domain = and shr rule subject 1
  return_range = and shr shr rule 32 object_type 1
  ret ne and return_domain return_range 0
end

note Finite non-negative binary32 check: sign bit 0 and exponent < 0xff (< 0x7f800000).
fn arboris_f32_nonneg_finite bits uint to bool
  ret lt bits 0x7f800000
end

note Validate a pull-based incoming-edge CSR in Slab 1 layout (hdr[1]=V, hdr[2]=E, hdr[11]=off_in_src, hdr[12]=off_in_weight).
note Returns 0 on success, non-zero fail-closed error code on any invalid input.
fn arboris_check_in_csr_impl hdr view ulong 16 csr view uint * to ulong
  v_cnt = get hdr 1
  e_cnt = get hdr 2
  off_src = div get hdr 11 4
  off_w = div get hdr 12 4
  if or eq v_cnt 0 gt v_cnt 0x1fffffff
    ret 1
  end
  if gt e_cnt 0xffffffff
    ret 1
  end
  if or ne and get hdr 11 127 0 ne and get hdr 12 127 0
    ret 2
  end
  if or lt off_src add v_cnt 1 or lt off_w add off_src e_cnt lt len csr add off_w e_cnt
    ret 2
  end
  if ne get csr 0 0
    ret 3
  end
  prev = ulong 0
  for i ulong v_cnt bound 0x1fffffff
    nxt = ulong get csr add i 1
    if or lt nxt prev gt nxt e_cnt
      ret 3
    end
    prev = nxt
  end
  if ne prev e_cnt
    ret 3
  end
  for e ulong e_cnt bound 0xffffffff
    if ge ulong get csr add off_src e v_cnt
      ret 4
    end
    if not arboris_f32_nonneg_finite get csr add off_w e
      ret 5
    end
  end
  ret 0
end

fn arboris_in_edge_ok r view uint * epos ulong to ulong
  prof = ulong get r 1
  v_cnt = ulong get r 2
  src = ulong get r epos
  rel = ulong get r add epos 1
  dst = ulong get r add epos 2
  wbits = get r add epos 3
  if or ge src v_cnt ge dst v_cnt
    ret 4
  end
  ksrc = ulong get r add 6 mul src 3
  kdst = ulong get r add 6 mul dst 3
  if not arboris_edge_ok prof rel ksrc kdst
    ret 7
  end
  if not arboris_f32_nonneg_finite wbits
    ret 5
  end
  ret 0
end

fn arboris_in_records_valid r view uint * to ulong
  if lt len r 6
    ret 1
  end
  if ne get r 0 0x41523031
    ret 1
  end
  prof = ulong get r 1
  if or lt prof 1 gt prof 2
    ret 1
  end
  v_cnt = ulong get r 2
  e_cnt = ulong get r 3
  if or eq v_cnt 0 gt v_cnt 0x1fffffff
    ret 1
  end
  if gt e_cnt 0xffffffff
    ret 1
  end
  if not arboris_f32_nonneg_finite get r 5
    ret 5
  end
  if ne len r add 6 add mul v_cnt 3 mul e_cnt 4
    ret 1
  end
  for i ulong v_cnt bound 0x1fffffff
    pos = add 6 mul i 3
    if not arboris_node_ok prof ulong get r pos get r add pos 1 get r add pos 2
      ret 6
    end
  end
  ebase = add 6 mul v_cnt 3
  for e ulong e_cnt bound 0xffffffff
    rc = arboris_in_edge_ok r add ebase mul e 4
    if ne rc 0
      ret rc
    end
  end
  ret 0
end

fn arboris_scatter_one r view uint * hdr view ulong 16 csr edit uint * epos ulong to void
  dst = ulong get r add epos 2
  idx = ulong get csr dst
  put csr add div get hdr 11 4 idx get r epos
  put csr add div get hdr 12 4 idx get r add epos 3
  put csr dst add uint idx 1
end

fn arboris_scatter_in_csr r view uint * hdr view ulong 16 csr edit uint * to void
  v_cnt = ulong get r 2
  e_cnt = ulong get r 3
  ebase = add 6 mul v_cnt 3
  for e ulong e_cnt bound 0xffffffff
    arboris_scatter_one r hdr csr add ebase mul e 4
  end
  for i ulong v_cnt bound 0x1fffffff
    slot = sub v_cnt i
    put csr slot get csr sub slot 1
  end
  put csr 0 0
end

fn arboris_csr_buf_ok hdr view ulong 16 v_cnt ulong e_cnt ulong csr_len ulong to bool
  if or ne get hdr 1 v_cnt ne get hdr 2 e_cnt
    ret false
  end
  if ne and get hdr 11 127 0
    ret false
  end
  if ne and get hdr 12 127 0
    ret false
  end
  off_src = div get hdr 11 4
  off_w = div get hdr 12 4
  if lt off_src add v_cnt 1
    ret false
  end
  if lt off_w add off_src e_cnt
    ret false
  end
  ret ge csr_len add off_w e_cnt
end

fn arboris_count_in_rows r view uint * csr edit uint * to void
  v_cnt = ulong get r 2
  e_cnt = ulong get r 3
  for i ulong add v_cnt 1 bound 0x20000000
    put csr i 0
  end
  ebase = add 6 mul v_cnt 3
  for e ulong e_cnt bound 0xffffffff
    dst = ulong get r add add ebase mul e 4 2
    put csr dst add get csr dst 1
  end
  cur = uint 0
  for v ulong v_cnt bound 0x1fffffff
    cnt = get csr v
    put csr v cur
    cur = add cur cnt
  end
  put csr v_cnt cur
end

note Compile validated Arboris AR01 records into pull-based incoming-edge CSR in Slab 1 layout.
note Fail closed before writing any output word.
fn arboris_compile_in_csr_impl r view uint * hdr view ulong 16 csr edit uint * to ulong
  rc = arboris_in_records_valid r
  if ne rc 0
    ret rc
  end
  if not arboris_csr_buf_ok hdr ulong get r 2 ulong get r 3 len csr
    ret 2
  end
  arboris_count_in_rows r csr
  arboris_scatter_in_csr r hdr csr
  ret 0
end

export fn arboris_validate_in_csr hdr view ulong 16 csr view uint * to ulong
  ret arboris_check_in_csr_impl hdr csr
end

export fn arboris_compile_in_csr r view uint * hdr view ulong 16 csr edit uint * to ulong
  ret arboris_compile_in_csr_impl r hdr csr
end

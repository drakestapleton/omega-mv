note SPDX-License-Identifier: AGPL-3.0-only
note Domain and range tables transcribed from Adam Pippert, Arboris (Apache-2.0),
note commit 803b432c9be11f0150faa7199d33c40adbda9ae6, ontologies/ upper and domains v0.1.0.
note Profile 1 selects upper, 2 infrastructure. Type and relation handles are
note zero-based document order. Property bits in order: name, schedulable, phase, replicas, active.
om2

note upper-0.1.0 type order:
note Entity, Agent, Object, System, Component, Event, State, Action, Process, Place, Time, Quantity, Observation, Goal, Claim, Hypothesis, Prediction, Constraint, Resource, Capability
fn arboris_rule_1 relation ulong to ulong
  note is_a
  if eq relation 0
    ret 0x100000001
  end
  note part_of
  if eq relation 1
    ret 0x100000001
  end
  note contains
  if eq relation 2
    ret 0x100000001
  end
  note located_in
  if eq relation 3
    ret 0x20100000001
  end
  note participates_in
  if eq relation 4
    ret 0x12000000001
  end
  note acts_on
  if eq relation 5
    ret 0x100000082
  end
  note causes
  if eq relation 6
    ret 0x60000000e0
  end
  note enables
  if eq relation 7
    ret 0x1c000000041
  end
  note prevents
  if eq relation 8
    ret 0x1c000000041
  end
  note precedes
  if eq relation 9
    ret 0xe0000000e0
  end
  note follows
  if eq relation 10
    ret 0xe0000000e0
  end
  note depends_on
  if eq relation 11
    ret 0x100000001
  end
  note supports
  if eq relation 12
    ret 0x400100004001
  end
  note contradicts
  if eq relation 13
    ret 0x504000005040
  end
  note observes
  if eq relation 14
    ret 0x6100001002
  end
  note has_state
  if eq relation 15
    ret 0x4000000001
  end
  note transforms_into
  if eq relation 16
    ret 0x4100000041
  end
  note owns
  if eq relation 17
    ret 0x10000000a
  end
  note controls
  if eq relation 18
    ret 0x10000000a
  end
  note connected_to
  if eq relation 19
    ret 0x100000001
  end
  note communicates_with
  if eq relation 20
    ret 0x100000001
  end
  note requires
  if eq relation 21
    ret 0x4004100000181
  end
  note produces
  if eq relation 22
    ret 0x4000100000101
  end
  note consumes
  if eq relation 23
    ret 0x4000100000101
  end
  ret 0
end

note infrastructure-0.1.0 type order:
note Host, Process, Service, Container, Image, Cluster, Node, Pod, Deployment, ReplicaSet, Network, Route, Volume, Certificate, Alert, Request, Dependency, State, Action, Observation
fn arboris_rule_2 relation ulong to ulong
  note part_of
  if eq relation 0
    ret 0x20000009c4
  end
  note scheduled_on
  if eq relation 1
    ret 0x4000000080
  end
  note managed_by
  if eq relation 2
    ret 0x30000000280
  end
  note selects
  if eq relation 3
    ret 0x18000000004
  end
  note routes_to
  if eq relation 4
    ret 0x8400000804
  end
  note depends_on
  if eq relation 5
    ret 0x380400000184
  end
  note has_state
  if eq relation 6
    ret 0x20000000009ef
  end
  ret 0
end

fn arboris_node_ok profile ulong kind ulong properties uint states uint to bool
  if ge kind 20
    ret false
  end
  if eq and states 3 3
    ret false
  end
  if eq profile 1
    ret true
  end
  if ne profile 2
    ret false
  end
  note Cluster requires name
  if eq kind 5
    ret eq and properties 1 1
  end
  note Node requires name, schedulable
  if eq kind 6
    ret eq and properties 3 3
  end
  note Pod requires name, phase
  if eq kind 7
    ret eq and properties 5 5
  end
  note Deployment requires name, replicas
  if eq kind 8
    ret eq and properties 9 9
  end
  note Service requires name
  if eq kind 2
    ret eq and properties 1 1
  end
  note Route requires active
  if eq kind 11
    ret eq and properties 16 16
  end
  ret true
end

fn arboris_edge_ok profile ulong relation ulong subject ulong object_type ulong to bool
  if or ge subject 20 ge object_type 20
    ret false
  end
  rule = ulong 0
  if eq profile 1
    rule = arboris_rule_1 relation
  end
  if eq profile 2
    rule = arboris_rule_2 relation
  end
  return_domain = and shr rule subject 1
  return_range = and shr shr rule 32 object_type 1
  ret ne and return_domain return_range 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/algebra/realize_sparse.c (MA-2 R3_sparse).
note Per-row uint16 +1/-1 column index lists + uint32 row offsets (n <= 65536).
om2

fn rz_sparse_count_nnz w view byte * tot ulong to ulong
  nnz = ulong 0
  for i ulong tot bound 300000
    if ne int get w i 0
      nnz = add nnz 1
    end
  end
  ret nnz
end

fn rz_sparse_pack_row i ulong n ulong k uint w view byte * to uint
  base = mul i n
  kk = k
  put rz_off mul 2 i kk
  for j ulong n bound 70000
    if gt int get w add base j 0
      put rz_idx ulong kk ushort j
      kk = add kk 1
    end
  end
  put rz_off add mul 2 i 1 kk
  for j ulong n bound 70000
    if lt int get w add base j 0
      put rz_idx ulong kk ushort j
      kk = add kk 1
    end
  end
  ret kk
end

fn rz_pack_sparse w view byte * m ulong n ulong to int
  rc = oma_rz_check_shape m n RZ_SP_MAX_N
  if ne rc 0
    ret rc
  end
  rc = oma_rz_validate w m n
  if ne rc 0
    ret rc
  end
  if gt add mul 2 m 1 RZ_OFF_CAP
    ret OMA_RZ_E_NOMEM
  end
  nnz = rz_sparse_count_nnz w mul m n
  if gt nnz ulong 4294967295
    ret OMA_RZ_E_OVERFLOW
  end
  if gt nnz RZ_IDX_CAP
    ret OMA_RZ_E_NOMEM
  end
  k = uint 0
  for i ulong m bound 1024
    k = rz_sparse_pack_row i n k w
  end
  put rz_off mul 2 m k
  wb = add mul nnz 2 mul add mul 2 m 1 4
  put rz_plan 0 m
  put rz_plan 1 n
  put rz_plan 2 wb
  put rz_plan 3 wb
  put rz_plan 4 ulong 0
  put rz_plan 5 nnz
  put rz_plan 6 ulong 1
  put rz_plan 7 RZ_R3_SPARSE
  ret OMA_RZ_OK
end

fn rz_gather_sum x view byte * start_idx ulong end_idx ulong to int
  acc = int 0
  k = start_idx
  while lt k end_idx bound 70000
    acc = add acc int get x ulong get rz_idx k
    k = add k 1
  end
  ret acc
end

fn rz_run_sparse x view byte * y edit int * to int
  m = get rz_plan 0
  for i ulong m bound 1024
    a = ulong get rz_off mul 2 i
    b = ulong get rz_off add mul 2 i 1
    c = ulong get rz_off add mul 2 i 2
    spos = rz_gather_sum x a b
    sneg = rz_gather_sum x b c
    put y i sub spos sneg
  end
  ret OMA_RZ_OK
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/algebra/realize_rns.c (MA-2 R4_rns).
note Residue number system {256, 255, 253} (M = 16,515,840), n <= 64,512, mixed-radix CRT.
om2

fn rz_rns_modp v int p int to int
  r = rem v p
  if lt r 0
    ret add r p
  end
  ret r
end

fn rz_pack_rns_row sbase ulong dbase ulong np ulong w view byte * to ulong
  nnz = ulong 0
  for j ulong np bound 70000
    v = int 0
    if lt j get rz_plan 1
      v = int get w add sbase j
    end
    if ne v 0
      nnz = add nnz 1
    end
    put rz_mem add dbase j uchar and v 255
  end
  ret nnz
end

fn rz_pack_rns_all w view byte * m ulong n ulong np ulong to ulong
  nnz = ulong 0
  for i ulong m bound 1024
    nnz = add nnz rz_pack_rns_row mul i n mul i np np w
  end
  ret nnz
end

fn rz_pack_rns w view byte * m ulong n ulong to int
  rc = oma_rz_check_shape m n RZ_RNS_MAX_N
  if ne rc 0
    ret rc
  end
  rc = oma_rz_validate w m n
  if ne rc 0
    ret rc
  end
  np = mul div add n 15 16 16
  wb = mul m np
  sb = mul 3 np
  if or eq oma_rz_alloc wb 0 gt oma_rz_alloc wb RZ_MEM_CAP
    ret OMA_RZ_E_NOMEM
  end
  if or eq oma_rz_alloc sb 0 gt oma_rz_alloc sb RZ_SCRATCH_CAP
    ret OMA_RZ_E_NOMEM
  end
  rz_zero_scratch sb
  put rz_plan 0 m
  put rz_plan 1 n
  nnz = rz_pack_rns_all w m n np
  put rz_plan 2 wb
  put rz_plan 3 add wb sb
  put rz_plan 4 sb
  put rz_plan 5 nnz
  put rz_plan 6 ulong 1
  put rz_plan 7 RZ_R4_RNS
  ret OMA_RZ_OK
end

fn rz_rns_crt c0 int c1 int c2 int to int
  a0 = and c0 255
  r255 = rz_rns_modp c1 255
  r253 = rz_rns_modp c2 253
  a1 = rz_rns_modp sub r255 a0 255
  t2 = rz_rns_modp sub sub r253 a0 mul 256 a1 253
  a2 = rz_rns_modp int rem mul long t2 211 253 253
  yv = add a0 add mul 256 a1 mul 65280 a2
  if ge yv div RZ_RNS_M 2
    ret sub yv RZ_RNS_M
  end
  ret yv
end

fn rz_rns_dot base ulong xoff ulong np ulong to int
  acc = int 0
  for j ulong np bound 70000
    wv = rz_u8_to_s8 get rz_mem add base j
    xv = rz_u8_to_s8 get rz_scratch add xoff j
    acc = add acc mul wv xv
  end
  ret acc
end

fn rz_rns_build_x x view byte * n ulong np ulong to void
  for j ulong n bound 70000
    v = int get x j
    put rz_scratch j uchar and v 255
    if eq v -128
      put rz_scratch add np j uchar 127
    else
      put rz_scratch add np j uchar and v 255
    end
    v253 = v
    if gt v 126
      v253 = sub v 253
    else
      if lt v -126
        v253 = add v 253
      end
    end
    put rz_scratch add mul 2 np j uchar and v253 255
  end
end

fn rz_run_rns x view byte * y edit int * to int
  m = get rz_plan 0
  n = get rz_plan 1
  np = mul div add n 15 16 16
  rz_rns_build_x x n np
  for i ulong m bound 1024
    base = mul i np
    c0 = rz_rns_dot base 0 np
    c1 = rz_rns_dot base np np
    c2 = rz_rns_dot base mul 2 np np
    put y i rz_rns_crt c0 c1 c2
  end
  ret OMA_RZ_OK
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of src/algebra/realize_dense.c (MA-2 R5_dense5).
note Strided 5 trits/byte (chunks of 80 weights in 16 bytes), div3 = (b * 171) >> 9 decode.
om2

const D5_CHUNK ulong 80

fn rz_d5_div3 b ulong to ulong
  ret shr mul b 171 9
end

fn rz_pack_d5_lane base_w ulong base_d ulong col0 ulong w view byte * to ulong
  nnz = ulong 0
  bv = ulong 0
  pw = ulong 1
  for i ulong 5
    col = add col0 mul 16 i
    v = int 0
    if lt col get rz_plan 1
      v = int get w add base_w col
    end
    if ne v 0
      nnz = add nnz 1
    end
    bv = add bv mul ulong add v 1 pw
    pw = mul pw 3
  end
  put rz_mem base_d uchar bv
  ret nnz
end

fn rz_pack_d5_chunk r ulong c ulong w view byte * to ulong
  n = get rz_plan 1
  base_w = mul r n
  base_d = add mul r mul div add n 79 D5_CHUNK 16 mul c 16
  cbase = mul c D5_CHUNK
  nnz = ulong 0
  for j ulong 16
    nnz = add nnz rz_pack_d5_lane base_w add base_d j add cbase j w
  end
  ret nnz
end

fn rz_pack_d5_all w view byte * m ulong chunks ulong to ulong
  nnz = ulong 0
  for r ulong m bound 1024
    for c ulong chunks bound 2048
      nnz = add nnz rz_pack_d5_chunk r c w
    end
  end
  ret nnz
end

fn rz_pack_dense5 w view byte * m ulong n ulong to int
  rc = oma_rz_check_shape m n OMA_RZ_MAX_N
  if ne rc 0
    ret rc
  end
  rc = oma_rz_validate w m n
  if ne rc 0
    ret rc
  end
  chunks = div add n 79 D5_CHUNK
  wb = mul m mul chunks 16
  if or eq oma_rz_alloc wb 0 gt oma_rz_alloc wb RZ_MEM_CAP
    ret OMA_RZ_E_NOMEM
  end
  put rz_plan 0 m
  put rz_plan 1 n
  nnz = rz_pack_d5_all w m chunks
  put rz_plan 2 wb
  put rz_plan 3 wb
  put rz_plan 4 ulong 0
  put rz_plan 5 nnz
  put rz_plan 6 ulong 1
  put rz_plan 7 RZ_R5_DENSE5
  ret OMA_RZ_OK
end

fn rz_run_d5_lane b ulong cbase ulong n ulong j ulong x view byte * to int
  acc = int 0
  v = b
  for i ulong 5
    q = rz_d5_div3 v
    d = int sub v mul q 3
    v = q
    col = add add cbase mul 16 i j
    if lt col n
      acc = add acc mul d int get x col
    end
  end
  ret acc
end

fn rz_run_d5_chunk base_d ulong cbase ulong n ulong x view byte * to int
  acc = int 0
  for j ulong 16
    acc = add acc rz_run_d5_lane ulong get rz_mem add base_d j cbase n j x
  end
  ret acc
end

fn rz_run_d5_row r ulong sumx int x view byte * to int
  n = get rz_plan 1
  chunks = div add n 79 D5_CHUNK
  base_r = mul r mul chunks 16
  acc = int 0
  for c ulong chunks bound 2048
    acc = add acc rz_run_d5_chunk add base_r mul c 16 mul c D5_CHUNK n x
  end
  ret sub acc sumx
end

fn rz_run_dense5 x view byte * y edit int * to int
  m = get rz_plan 0
  n = get rz_plan 1
  sumx = int 0
  for j ulong n bound 200000
    sumx = add sumx int get x j
  end
  for r ulong m bound 1024
    put y r rz_run_d5_row r sumx x
  end
  ret OMA_RZ_OK
end

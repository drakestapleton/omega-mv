note SPDX-License-Identifier: AGPL-3.0-only
note Literal token costs from the frozen tokenizer receipts evidence/packet-N.tokens.
note tests/pack.om derives its expectations from packcost itself, so it cannot see a changed cost.
fn main to int
if ne packcost 1 255
ret 1
end
if ne packcost 2 263
ret 2
end
if ne packcost 3 502
ret 3
end
if ne packcost 4 502
ret 4
end
if ne packcost 0 0
ret 5
end
if ne packcost 5 0
ret 6
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note bridge/rust-trace/sample_unit.om: Pure seeded OM-2 function-mode unit for the
note Universal Byte-Traceable Rust FFI Hook (omega-bridge ABI v2).
note Demonstrates contracts (requires/ensures -> trap 9/10), checked division/overflow
note (trap 1/2), runtime slice bounds (trap 3), loop bounds (trap 4), narrowing cast
note (trap 5), mutable views (edit ulong *), and out-parameter isolation (out uchar 32).
om2

export fn trace_fma_acc a ulong b ulong c ulong to ulong
ret add mul a b c
end

export fn trace_checked_div num long den long to long
ret div num den
end

export fn trace_contract_scale x ulong k ulong to ulong
requires gt k 0
requires le k 1024
ensures ge result x
ret mul x k
end

export fn trace_slice_get buf view ulong * idx ulong to ulong
ret get buf idx
end

export fn trace_dot_u64 a view ulong * b view ulong * to ulong
requires eq len a len b
n = len a
acc = ulong 0
for i ulong n bound 65536
acc = add acc mul get a i get b i
end
ret acc
end

export fn trace_transform_inplace dst edit ulong * scale ulong bias ulong to ulong
n = len dst
chk = ulong 0
for i ulong n bound 65536
v = add mul get dst i scale bias
put dst i v
chk = xor chk v
end
ret chk
end

export fn trace_loop_probe n ulong to ulong
i = ulong 0
while lt i n bound 16
i = add i 1
end
ret i
end

export fn trace_narrow_u8 x ulong to ulong
b = uchar x
ret ulong b
end

export fn trace_digest_out src view uchar * digest out uchar 32 to ulong
requires gt len src 0
n = len src
s0 = ulong 0x6a09e667f3bcc908
s1 = ulong 0xbb67ae8584caa73b
s2 = ulong 0x3c6ef372fe94f82b
s3 = ulong 0xa54ff53a5f1d36f1
for i ulong n bound 65536
b = ulong get src i
s0 = xor rotr add s0 b 7 mul add b 1 0x9e3779b97f4a7c15
s1 = add rotl xor s1 s0 11 mul add i 1 0xbf58476d1ce4e5b9
s2 = xor rotr add s2 s1 17 mul add b 3 0x94d049bb133111eb
s3 = add rotl xor s3 s2 23 s0
end
for j ulong 8
sh = mul j 8
put digest j uchar and shr s0 sh 255
put digest add j 8 uchar and shr s1 sh 255
put digest add j 16 uchar and shr s2 sh 255
put digest add j 24 uchar and shr s3 sh 255
end
ret n
end

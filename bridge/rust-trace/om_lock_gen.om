om2
note SPDX-License-Identifier: Apache-2.0
note bridge/rust-trace/om_lock_gen.om: Pure seeded OM-2 Universal Trace Lock Generator
note & Fail-Closed Cryptographic Chain Verifier (zero C/Python/Node/crates).
note
note Modes:
note   om_lock_gen emit-artifacts <src_om> <egp3_out> <ompk_out>
note   om_lock_gen generate <lock_path> <unit_name> <src_om> <omc_bin> <egp3_cert> <lean_src> <ompk_pkg> <unit_bin> <native_c> <unit_obj>
note   om_lock_gen verify   <lock_path> <src_om> <omc_bin> <egp3_cert> <lean_src> <ompk_pkg> <unit_bin> <native_c> <unit_obj>
note
note Fail-closed exit codes (aligned with Rust OmegaTrap::LockDrift 100+):
note   0   = PASS (every byte in the full chain verified bit-for-bit)
note   2   = CLI usage error
note   100 = Lock missing, unreadable, malformed, or missing/duplicate key
note   101 = Source .om SHA-256 drift
note   102 = omc compiler SHA-256 drift
note   103 = EGP3 proof certificate format or SHA-256 drift
note   104 = Lean 4 proof source SHA-256 drift
note   105 = SEMANTIC_ID / OMPK format, internal payload hash, or SHA-256 drift
note   106 = Compiled unit (.bin), ABI v2 bridge (.c), or object (.o) drift
note   107 = OMEGA2_IDENT drift (mismatch with unit/src/omc)
note   108 = CHAIN_ROOT_SHA256 drift (lockfile itself tampered)

text t_hexd "0123456789abcdef"
text t_kiv "1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221 3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580 3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986 2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895 666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037 2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344 430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779 1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298 1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225"

text t_cmd_emit "emit-artifacts"
text t_cmd_gen "generate"
text t_cmd_ver "verify"

text t_k_fmt "FORMAT="
text t_v_fmt "OMEGA_TRACE_LOCK_V1"
text t_k_unit "UNIT_NAME="
text t_k_abi "ABI_VERSION="
text t_v_abi "2"
text t_k_prof "PROFILE="
text t_v_prof "OM-2"
text t_k_ident "OMEGA2_IDENT="
text t_k_src "SOURCE_OM_SHA256="
text t_k_omc "OMC_SHA256="
text t_k_egp3 "EGP3_SHA256="
text t_k_lean "LEAN_PROOF_SHA256="
text t_k_semid "SEMANTIC_ID="
text t_k_ompk "OMPK_SHA256="
text t_k_ubin "UNIT_BIN_SHA256="
text t_k_ubytes "UNIT_BIN_BYTES="
text t_k_natc "NATIVE_C_SHA256="
text t_k_uobj "UNIT_OBJ_SHA256="
text t_k_root "CHAIN_ROOT_SHA256="

text t_id1 "omega-ident 1 unit="
text t_id2 " abi=2 profile=OM-2 src="
text t_id3 " omc="

text t_usage "usage: om_lock_gen emit-artifacts|generate|verify ...\n"
text t_ok_emit "OMEGA_TRACE_ARTIFACTS OK egp3=240 ompk="
text t_ok_gen "OMEGA_TRACE_LOCK GENERATED unit="
text t_ok_ver "OMEGA_TRACE_VERIFY PASS unit="
text t_s_root " chain_root="
text t_s_sem " semantic_id="
text t_err_pre "OMEGA_TRACE_VERIFY REFUSED code="
text t_err_mal " reason=LOCK_MALFORMED\n"
text t_err_src " reason=SOURCE_OM_DRIFT\n"
text t_err_omc " reason=OMC_COMPILER_DRIFT\n"
text t_err_egp3 " reason=EGP3_PROOF_DRIFT\n"
text t_err_lean " reason=LEAN_PROOF_DRIFT\n"
text t_err_sem " reason=SEMANTIC_ID_OR_OMPK_DRIFT\n"
text t_err_bin " reason=BINARY_OR_OBJECT_DRIFT\n"
text t_err_id " reason=OMEGA2_IDENT_DRIFT\n"
text t_err_root " reason=CHAIN_ROOT_DRIFT\n"

note Streaming SHA-256 state
global sk uint 72
global sw uint 64
global sv uint 8
global sh uint 8
global sbuf uchar 128
global sdig uchar 32
global shex uchar 64

note General I/O and scratch buffers
global chunk uchar 65536
global fbuf uchar 65536
global obuf uchar 65536
global pbuf uchar 4096
global uname uchar 256
global numbuf uchar 32

note Computed digests (64 lowercase hex chars each)
global h_src uchar 64
global h_omc uchar 64
global h_egp3 uchar 64
global h_lean uchar 64
global h_semid uchar 64
global h_ompk uchar 64
global h_ubin uchar 64
global h_natc uchar 64
global h_uobj uchar 64
global h_root uchar 64
global e_ident uchar 512

note Parsed lock fields (verify mode)
global l_uname uchar 256
global l_ident uchar 512
global l_src uchar 64
global l_omc uchar 64
global l_egp3 uchar 64
global l_lean uchar 64
global l_semid uchar 64
global l_ompk uchar 64
global l_ubin uchar 64
global l_natc uchar 64
global l_uobj uchar 64
global l_root uchar 64
global l_seen ulong 16

note Scalar state slots st[0..15]:
note 0=sha_inited 1=sha_total 2=sha_bl 3=plen 4=ulen 5=flen 6=olen
note 7=unit_bin_bytes 8=l_ulen 9=l_ilen 10=l_ubytes 11=e_ilen 12=root_off
global st ulong 16

note ---- output helpers ----

fn wtx fd int t view uchar * to void
n = len t
o = ulong 0
while lt o n bound 65537
k = write fd t o sub n o
if le k 0
ret
end
o = add o ulong k
end
end

fn wnum fd int v ulong to void
x = v
i = ulong 32
for j ulong 21
i = sub i 1
put numbuf i uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write fd numbuf i sub 32 i
end

fn wnl fd int to void
put numbuf 0 10
r = write fd numbuf 0 1
end

fn die_ver code int to void
wtx 2 t_err_pre
wnum 2 ulong code
if eq code 100
wtx 2 t_err_mal
end
if eq code 101
wtx 2 t_err_src
end
if eq code 102
wtx 2 t_err_omc
end
if eq code 103
wtx 2 t_err_egp3
end
if eq code 104
wtx 2 t_err_lean
end
if eq code 105
wtx 2 t_err_sem
end
if eq code 106
wtx 2 t_err_bin
end
if eq code 107
wtx 2 t_err_id
end
if eq code 108
wtx 2 t_err_root
end
exit code
end

note ---- obuf builders ----

fn ob_clr to void
put st 6 0
end

fn ob_ch c uchar to void
n = get st 6
if ge n 65536
exit 100
end
put obuf n c
put st 6 add n 1
end

fn ob_tx t view uchar * to void
m = len t
n = get st 6
if gt add n m 65536
exit 100
end
for i ulong m bound 4096
put obuf add n i get t i
end
put st 6 add n m
end

fn ob_u32le v ulong to void
ob_ch uchar and v 255
ob_ch uchar and shr v 8 255
ob_ch uchar and shr v 16 255
ob_ch uchar and shr v 24 255
end

fn ob_u64le v ulong to void
ob_u32le and v 4294967295
ob_u32le shr v 32
end

fn ob_num v ulong to void
x = v
i = ulong 32
for j ulong 21
i = sub i 1
put numbuf i uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
for q ulong sub 32 i bound 32
ob_ch get numbuf add i q
end
end

fn ob_hex64 which ulong to void
for j ulong 64
if eq which 0
ob_ch get h_src j
end
if eq which 1
ob_ch get h_omc j
end
if eq which 2
ob_ch get h_egp3 j
end
if eq which 3
ob_ch get h_lean j
end
if eq which 4
ob_ch get h_semid j
end
if eq which 5
ob_ch get h_ompk j
end
if eq which 6
ob_ch get h_ubin j
end
if eq which 7
ob_ch get h_natc j
end
if eq which 8
ob_ch get h_uobj j
end
if eq which 9
ob_ch get h_root j
end
end
end

note ---- streaming FIPS 180-4 SHA-256 ----

fn sha_init_k to void
if ne get st 0 0
ret
end
put st 0 1
p = ulong 0
for i ulong 72
v = ulong 0
while lt get t_kiv p 48 bound 8
p = add p 1
end
while ge get t_kiv p 48 bound 16
v = add mul v 10 ulong sub get t_kiv p 48
p = add p 1
if ge p len t_kiv
put sk i uint v
ret
end
end
put sk i uint v
end
end

fn sha_reset to void
sha_init_k
for j ulong 8
put sh j get sk add j 64
end
put st 1 0
put st 2 0
end

fn sha_s0 a uint to uint
ret xor xor rotr a 2 rotr a 13 rotr a 22
end

fn sha_s1 e uint to uint
ret xor xor rotr e 6 rotr e 11 rotr e 25
end

fn sha_g0 x uint to uint
ret xor xor rotr x 7 rotr x 18 shr x 3
end

fn sha_g1 x uint to uint
ret xor xor rotr x 17 rotr x 19 shr x 10
end

fn sha_maj a uint b uint c uint to uint
ret xor xor and a b and a c and b c
end

fn sha_rnd i ulong to void
e = get sv 4
t1 = add get sv 7 sha_s1 e
t1 = add t1 xor and e get sv 5 and not e get sv 6
t1 = add t1 add get sk i get sw i
a = get sv 0
t2 = add sha_s0 a sha_maj a get sv 1 get sv 2
put sv 7 get sv 6
put sv 6 get sv 5
put sv 5 e
put sv 4 add get sv 3 t1
put sv 3 get sv 2
put sv 2 get sv 1
put sv 1 a
put sv 0 add t1 t2
end

fn sha_blk off ulong to void
for t ulong 16
p = add off mul t 4
v = uint get sbuf p
v = or shl v 8 uint get sbuf add p 1
v = or shl v 8 uint get sbuf add p 2
v = or shl v 8 uint get sbuf add p 3
put sw t v
end
for t ulong 48
u = add t 16
x = add sha_g1 get sw sub u 2 get sw sub u 7
put sw u add x add sha_g0 get sw sub u 15 get sw sub u 16
end
for j ulong 8
put sv j get sh j
end
for i ulong 64
sha_rnd i
end
for j ulong 8
put sh j add get sh j get sv j
end
end

fn sha_push_chunk cnt ulong to void
i = ulong 0
while lt i cnt bound 65537
bl = get st 2
take = sub 64 bl
if lt sub cnt i take
take = sub cnt i
end
for j ulong take bound 65
put sbuf add bl j get chunk add i j
end
bl = add bl take
i = add i take
put st 1 add get st 1 take
if eq bl 64
sha_blk 0
put st 2 0
else
put st 2 bl
end
end
end

fn sha_push_fbuf off ulong cnt ulong to void
i = ulong 0
while lt i cnt bound 65537
bl = get st 2
take = sub 64 bl
if lt sub cnt i take
take = sub cnt i
end
for j ulong take bound 65
put sbuf add bl j get fbuf add off add i j
end
bl = add bl take
i = add i take
put st 1 add get st 1 take
if eq bl 64
sha_blk 0
put st 2 0
else
put st 2 bl
end
end
end

fn sha_push_obuf off ulong cnt ulong to void
i = ulong 0
while lt i cnt bound 65537
bl = get st 2
take = sub 64 bl
if lt sub cnt i take
take = sub cnt i
end
for j ulong take bound 65
put sbuf add bl j get obuf add off add i j
end
bl = add bl take
i = add i take
put st 1 add get st 1 take
if eq bl 64
sha_blk 0
put st 2 0
else
put st 2 bl
end
end
end

fn sha_finish to void
r = get st 2
tot = get st 1
for j ulong sub 128 r bound 129
put sbuf add r j 0
end
put sbuf r 128
e = ulong 64
if ge r 56
e = 128
end
bits = mul tot 8
for j ulong 8
put sbuf sub sub e 1 j uchar and shr bits mul j 8 255
end
sha_blk 0
if eq e 128
sha_blk 64
end
for j ulong 8
v = get sh j
for q ulong 4
s = uint mul sub 3 q 8
put sdig add mul j 4 q uchar and shr v s 255
end
end
for j ulong 32
b = get sdig j
put shex mul j 2 get t_hexd ulong shr b 4
put shex add mul j 2 1 get t_hexd ulong and b 15
end
end

note ---- file and arg helpers ----

fn load_arg_path idx ulong to bool
k = argread idx pbuf 0 4095
if lt k 1
ret false
end
put st 3 ulong k
ret true
end

fn pbuf_eq t view uchar * to bool
n = get st 3
if ne n len t
ret false
end
for i ulong n bound 4096
if ne get pbuf i get t i
ret false
end
end
ret true
end

fn sha_file_pbuf to bool
fd = fopen pbuf 0 get st 3 524288 0
if lt fd 0
ret false
end
sha_reset
ok = true
while true bound 9223372036854775807
k = read int fd chunk 0 65536
if lt k 0
ok = false
break
end
if eq k 0
break
end
sha_push_chunk ulong k
end
z = fclose int fd
if not ok
ret false
end
if eq get st 1 0
ret false
end
sha_finish
ret true
end

fn read_small_pbuf to bool
fd = fopen pbuf 0 get st 3 524288 0
if lt fd 0
ret false
end
tot = ulong 0
ok = true
while true bound 65537
if ge tot 65536
note check EOF so files > 65536 fail closed
k2 = read int fd chunk 0 1
if ne k2 0
ok = false
end
break
end
k = read int fd fbuf tot sub 65536 tot
if lt k 0
ok = false
break
end
if eq k 0
break
end
tot = add tot ulong k
end
z = fclose int fd
if not ok
ret false
end
put st 5 tot
ret gt tot 0
end

fn write_obuf_pbuf to bool
z0 = unlink pbuf 0 get st 3
fd = fopen pbuf 0 get st 3 524865 420
if lt fd 0
ret false
end
n = get st 6
o = ulong 0
ok = true
while lt o n bound 65537
k = write int fd obuf o sub n o
if le k 0
ok = false
break
end
o = add o ulong k
end
z1 = fclose int fd
ret ok
end

fn store_shex slot ulong to void
for j ulong 64
c = get shex j
if eq slot 0
put h_src j c
end
if eq slot 1
put h_omc j c
end
if eq slot 2
put h_egp3 j c
end
if eq slot 3
put h_lean j c
end
if eq slot 4
put h_semid j c
end
if eq slot 5
put h_ompk j c
end
if eq slot 6
put h_ubin j c
end
if eq slot 7
put h_natc j c
end
if eq slot 8
put h_uobj j c
end
if eq slot 9
put h_root j c
end
end
end

fn cmp_shex_lock slot ulong to bool
for j ulong 64
c = get shex j
if eq slot 0
if ne c get l_src j
ret false
end
end
if eq slot 1
if ne c get l_omc j
ret false
end
end
if eq slot 2
if ne c get l_egp3 j
ret false
end
end
if eq slot 3
if ne c get l_lean j
ret false
end
end
if eq slot 4
if ne c get l_semid j
ret false
end
end
if eq slot 5
if ne c get l_ompk j
ret false
end
end
if eq slot 6
if ne c get l_ubin j
ret false
end
end
if eq slot 7
if ne c get l_natc j
ret false
end
end
if eq slot 8
if ne c get l_uobj j
ret false
end
end
if eq slot 9
if ne c get l_root j
ret false
end
end
end
ret true
end

note ---- binary readers for EGP3 and OMPK ----

fn fb_u32le off ulong to ulong
b0 = ulong get fbuf off
b1 = shl ulong get fbuf add off 1 8
b2 = shl ulong get fbuf add off 2 16
b3 = shl ulong get fbuf add off 3 24
ret or or b0 b1 or b2 b3
end

note Validate EGP3 binary format in fbuf[0..flen) and hash full file into shex
fn validate_egp3_pbuf to bool
if not read_small_pbuf
ret false
end
n = get st 5
if lt n 36
ret false
end
if ne get fbuf 0 69
ret false
end
if ne get fbuf 1 71
ret false
end
if ne get fbuf 2 80
ret false
end
if ne get fbuf 3 51
ret false
end
cc = fb_u32le 4
if ne cc 1
ret false
end
wb = fb_u32le 16
if and ne wb 32 ne wb 64
ret false
end
nc = fb_u32le 20
if or eq nc 0 gt nc 4096
ret false
end
rb = fb_u32le 24
ra = fb_u32le 28
if or ge rb nc ge ra nc
ret false
end
tc = fb_u32le 32
if gt tc 8192
ret false
end
exp = add 36 add mul nc 32 mul tc 12
if ne n exp
ret false
end
sha_reset
sha_push_fbuf 0 n
sha_finish
ret true
end

note Validate OMPK v1 binary format in fbuf[0..flen), verify internal sem_id == SHA256(payload),
note store sem_id hex into h_semid, and hash full OMPK file into shex (and h_ompk).
fn validate_ompk_pbuf to bool
if not read_small_pbuf
ret false
end
n = get st 5
if lt n 128
ret false
end
if ne get fbuf 0 79
ret false
end
if ne get fbuf 1 77
ret false
end
if ne get fbuf 2 80
ret false
end
if ne get fbuf 3 75
ret false
end
ver = fb_u32le 4
if ne ver 1
ret false
end
imp = fb_u32le 120
irlen = fb_u32le 124
if gt imp 16
ret false
end
if or eq irlen 0 gt irlen 4096
ret false
end
pay_off = add 128 mul imp 32
if ne n add pay_off irlen
ret false
end
sha_reset
sha_push_fbuf pay_off irlen
sha_finish
for j ulong 32
if ne get sdig j get fbuf add 8 j
ret false
end
end
store_shex 4
sha_reset
sha_push_fbuf 0 n
sha_finish
store_shex 5
ret true
end

note ---- emit-artifacts mode ----

fn emit_egp3_node op ulong a ulong b ulong c ulong vlo ulong wid ulong to void
ob_u32le op
ob_u32le a
ob_u32le b
ob_u32le c
ob_u32le vlo
ob_u32le 0
ob_u32le wid
ob_u32le 0
end

fn build_egp3_buf to void
ob_clr
note Header: magic "EGP3", cert_count = 1
ob_ch 69
ob_ch 71
ob_ch 80
ob_ch 51
ob_u32le 1
note Cert header (28 bytes): fn=0 blk=0 width=64 nodes=6 root_before=4 root_after=5 traces=1
ob_u32le 0
ob_u32le 0
ob_u32le 64
ob_u32le 6
ob_u32le 4
ob_u32le 5
ob_u32le 1
note 6 nodes matching trace_fma_acc: add(mul(a,b), c) = fma(a,b,c) (Rule 1)
emit_egp3_node 2 0 0 0 0 64
emit_egp3_node 2 0 0 0 1 64
emit_egp3_node 2 0 0 0 2 64
emit_egp3_node 5 0 1 0 0 64
emit_egp3_node 3 3 2 0 0 64
emit_egp3_node 6 0 1 2 0 64
note 1 trace step: rule_id=1, lhs=4, rhs=5
ob_u32le 1
ob_u32le 4
ob_u32le 5
end

fn build_ompk_buf to void
n = get st 5
if or eq n 0 gt n 4096
exit 105
end
sha_reset
sha_push_fbuf 0 n
sha_finish
store_shex 4
ob_clr
note Header [0..3] magic "OMPK", [4..7] version 1
ob_ch 79
ob_ch 77
ob_ch 80
ob_ch 75
ob_u32le 1
note [8..39] sem_id (32 bytes)
for j ulong 32
ob_ch get sdig j
end
note [40..71] func_id (equals sem_id)
for j ulong 32
ob_ch get sdig j
end
note [72..119] 6x u64 LE TargetDesc contract (CPU AArch64, 0 smem, 16 regs, subgroup 1)
ob_u64le 1
ob_u64le 0
ob_u64le 16
ob_u64le 1
ob_u64le 0
ob_u64le 0
note [120..123] import_count = 0, [124..127] ir_len = n
ob_u32le 0
ob_u32le n
note [128..128+n) canonical source payload
for i ulong n bound 4097
ob_ch get fbuf i
end
end

fn cmd_emit to int
if ne argcnt 5
wtx 2 t_usage
ret 2
end
if not load_arg_path 2
ret 2
end
if not read_small_pbuf
exit 101
end
if gt get st 5 4096
exit 105
end
build_egp3_buf
if not load_arg_path 3
ret 2
end
if not write_obuf_pbuf
exit 103
end
build_ompk_buf
ompk_len = get st 6
if not load_arg_path 4
ret 2
end
if not write_obuf_pbuf
exit 105
end
wtx 1 t_ok_emit
wnum 1 ompk_len
wtx 1 t_s_sem
r = write 1 h_semid 0 64
wnl 1
ret 0
end

note ---- build expected omega2_ident ----

fn build_eident use_lock bool to void
o = ulong 0
for i ulong len t_id1 bound 64
put e_ident o get t_id1 i
o = add o 1
end
if use_lock
ul = get st 8
for i ulong ul bound 256
put e_ident o get l_uname i
o = add o 1
end
else
ul = get st 4
for i ulong ul bound 256
put e_ident o get uname i
o = add o 1
end
end
for i ulong len t_id2 bound 64
put e_ident o get t_id2 i
o = add o 1
end
for i ulong 64
put e_ident o get h_src i
o = add o 1
end
for i ulong len t_id3 bound 64
put e_ident o get t_id3 i
o = add o 1
end
for i ulong 64
put e_ident o get h_omc i
o = add o 1
end
put st 11 o
end

fn is_valid_uname_ch c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret eq c 95
end

fn is_lower_hex c uchar to bool
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end

note ---- generate mode ----

fn cmd_generate to int
if ne argcnt 12
wtx 2 t_usage
ret 2
end
note argv[3] = unit_name
k = argread 3 uname 0 255
if lt k 1
ret 2
end
ul = ulong k
for i ulong ul bound 256
if not is_valid_uname_ch get uname i
ret 2
end
end
put st 4 ul
note argv[4] = src_om
if not load_arg_path 4
ret 2
end
if not sha_file_pbuf
exit 101
end
store_shex 0
note argv[5] = omc_bin
if not load_arg_path 5
ret 2
end
if not sha_file_pbuf
exit 102
end
store_shex 1
note argv[6] = egp3_cert
if not load_arg_path 6
ret 2
end
if not validate_egp3_pbuf
exit 103
end
store_shex 2
note argv[7] = lean_src
if not load_arg_path 7
ret 2
end
if not sha_file_pbuf
exit 104
end
store_shex 3
note argv[8] = ompk_pkg
if not load_arg_path 8
ret 2
end
if not validate_ompk_pbuf
exit 105
end
note verify sem_id matches src_om SHA-256
for j ulong 64
if ne get h_semid j get h_src j
exit 105
end
end
note argv[9] = unit_bin
if not load_arg_path 9
ret 2
end
if not sha_file_pbuf
exit 106
end
put st 7 get st 1
store_shex 6
note argv[10] = native_c
if not load_arg_path 10
ret 2
end
if not sha_file_pbuf
exit 106
end
store_shex 7
note argv[11] = unit_obj
if not load_arg_path 11
ret 2
end
if not sha_file_pbuf
exit 106
end
store_shex 8
note Assemble canonical OMEGA_TRACE.lock body
build_eident false
ob_clr
ob_tx t_k_fmt
ob_tx t_v_fmt
ob_ch 10
ob_tx t_k_unit
for i ulong ul bound 256
ob_ch get uname i
end
ob_ch 10
ob_tx t_k_abi
ob_tx t_v_abi
ob_ch 10
ob_tx t_k_prof
ob_tx t_v_prof
ob_ch 10
ob_tx t_k_ident
for i ulong get st 11 bound 512
ob_ch get e_ident i
end
ob_ch 10
ob_tx t_k_src
ob_hex64 0
ob_ch 10
ob_tx t_k_omc
ob_hex64 1
ob_ch 10
ob_tx t_k_egp3
ob_hex64 2
ob_ch 10
ob_tx t_k_lean
ob_hex64 3
ob_ch 10
ob_tx t_k_semid
ob_hex64 4
ob_ch 10
ob_tx t_k_ompk
ob_hex64 5
ob_ch 10
ob_tx t_k_ubin
ob_hex64 6
ob_ch 10
ob_tx t_k_ubytes
ob_num get st 7
ob_ch 10
ob_tx t_k_natc
ob_hex64 7
ob_ch 10
ob_tx t_k_uobj
ob_hex64 8
ob_ch 10
body_len = get st 6
sha_reset
sha_push_obuf 0 body_len
sha_finish
store_shex 9
ob_tx t_k_root
ob_hex64 9
ob_ch 10
note Write lock file at argv[2]
if not load_arg_path 2
ret 2
end
if not write_obuf_pbuf
exit 100
end
wtx 1 t_ok_gen
r0 = write 1 uname 0 ul
wtx 1 t_s_root
r1 = write 1 h_root 0 64
wnl 1
ret 0
end

note ---- strict lockfile parser (verify mode) ----

fn fb_starts pos ulong endp ulong pref view uchar * to bool
m = len pref
if lt sub endp pos m
ret false
end
for i ulong m bound 64
if ne get fbuf add pos i get pref i
ret false
end
end
ret true
end

fn fb_eq_slice pos ulong endp ulong t view uchar * to bool
m = len t
if ne sub endp pos m
ret false
end
for i ulong m bound 64
if ne get fbuf add pos i get t i
ret false
end
end
ret true
end

fn parse_hex64 pos ulong endp ulong slot ulong to bool
if ne sub endp pos 64
ret false
end
for j ulong 64
c = get fbuf add pos j
if not is_lower_hex c
ret false
end
if eq slot 0
put l_src j c
end
if eq slot 1
put l_omc j c
end
if eq slot 2
put l_egp3 j c
end
if eq slot 3
put l_lean j c
end
if eq slot 4
put l_semid j c
end
if eq slot 5
put l_ompk j c
end
if eq slot 6
put l_ubin j c
end
if eq slot 7
put l_natc j c
end
if eq slot 8
put l_uobj j c
end
if eq slot 9
put l_root j c
end
end
ret true
end

fn parse_u64 pos ulong endp ulong to long
if eq pos endp
ret -1
end
if gt sub endp pos 19
ret -1
end
v = ulong 0
for i ulong sub endp pos bound 20
c = get fbuf add pos i
if or lt c 48 gt c 57
ret -1
end
v = add mul v 10 ulong sub c 48
end
if eq v 0
ret -1
end
ret long v
end

fn mark_seen idx ulong to bool
if ne get l_seen idx 0
ret false
end
put l_seen idx 1
ret true
end

fn parse_lock_line s ulong e ulong to bool
if fb_starts s e t_k_fmt
if not mark_seen 0
ret false
end
ret fb_eq_slice add s len t_k_fmt e t_v_fmt
end
if fb_starts s e t_k_unit
if not mark_seen 1
ret false
end
vs = add s len t_k_unit
vl = sub e vs
if or eq vl 0 gt vl 255
ret false
end
for i ulong vl bound 256
c = get fbuf add vs i
if not is_valid_uname_ch c
ret false
end
put l_uname i c
end
put st 8 vl
ret true
end
if fb_starts s e t_k_abi
if not mark_seen 2
ret false
end
ret fb_eq_slice add s len t_k_abi e t_v_abi
end
if fb_starts s e t_k_prof
if not mark_seen 3
ret false
end
ret fb_eq_slice add s len t_k_prof e t_v_prof
end
if fb_starts s e t_k_ident
if not mark_seen 4
ret false
end
vs = add s len t_k_ident
vl = sub e vs
if or eq vl 0 gt vl 511
ret false
end
for i ulong vl bound 512
put l_ident i get fbuf add vs i
end
put st 9 vl
ret true
end
if fb_starts s e t_k_src
if not mark_seen 5
ret false
end
ret parse_hex64 add s len t_k_src e 0
end
if fb_starts s e t_k_omc
if not mark_seen 6
ret false
end
ret parse_hex64 add s len t_k_omc e 1
end
if fb_starts s e t_k_egp3
if not mark_seen 7
ret false
end
ret parse_hex64 add s len t_k_egp3 e 2
end
if fb_starts s e t_k_lean
if not mark_seen 8
ret false
end
ret parse_hex64 add s len t_k_lean e 3
end
if fb_starts s e t_k_semid
if not mark_seen 9
ret false
end
ret parse_hex64 add s len t_k_semid e 4
end
if fb_starts s e t_k_ompk
if not mark_seen 10
ret false
end
ret parse_hex64 add s len t_k_ompk e 5
end
if fb_starts s e t_k_ubin
if not mark_seen 11
ret false
end
ret parse_hex64 add s len t_k_ubin e 6
end
if fb_starts s e t_k_ubytes
if not mark_seen 12
ret false
end
v = parse_u64 add s len t_k_ubytes e
if lt v 0
ret false
end
put st 10 ulong v
ret true
end
if fb_starts s e t_k_natc
if not mark_seen 13
ret false
end
ret parse_hex64 add s len t_k_natc e 7
end
if fb_starts s e t_k_uobj
if not mark_seen 14
ret false
end
ret parse_hex64 add s len t_k_uobj e 8
end
if fb_starts s e t_k_root
for j ulong 15
if ne get l_seen j 1
ret false
end
end
if not mark_seen 15
ret false
end
put st 12 s
ret parse_hex64 add s len t_k_root e 9
end
ret false
end

fn parse_lock_file to bool
for j ulong 16
put l_seen j 0
end
put st 12 0
n = get st 5
i = ulong 0
lines = ulong 0
while lt i n bound 128
e = i
while lt e n bound 2048
if eq get fbuf e 10
break
end
e = add e 1
end
if ge e n
ret false
end
if not parse_lock_line i e
ret false
end
lines = add lines 1
i = add e 1
end
if ne lines 16
ret false
end
for j ulong 16
if ne get l_seen j 1
ret false
end
end
note CHAIN_ROOT_SHA256 must be the final line
if eq get st 12 0
ret false
end
ret true
end

note ---- verify mode (fail-closed) ----

fn cmd_verify to int
if ne argcnt 11
wtx 2 t_usage
ret 2
end
note 1. Load and strictly parse OMEGA_TRACE.lock (argv[2])
if not load_arg_path 2
die_ver 100
end
if not read_small_pbuf
die_ver 100
end
if not parse_lock_file
die_ver 100
end
note 2. Verify CHAIN_ROOT_SHA256 over the exact prefix before CHAIN_ROOT_SHA256=
sha_reset
sha_push_fbuf 0 get st 12
sha_finish
if not cmp_shex_lock 9
die_ver 108
end
note 3. Verify SOURCE_OM_SHA256 (argv[3])
if not load_arg_path 3
die_ver 101
end
if not sha_file_pbuf
die_ver 101
end
store_shex 0
if not cmp_shex_lock 0
die_ver 101
end
note 4. Verify OMC_SHA256 (argv[4])
if not load_arg_path 4
die_ver 102
end
if not sha_file_pbuf
die_ver 102
end
store_shex 1
if not cmp_shex_lock 1
die_ver 102
end
note 5. Verify OMEGA2_IDENT binds unit_name + src_sha256 + omc_sha256
build_eident true
if ne get st 9 get st 11
die_ver 107
end
for i ulong get st 11 bound 512
if ne get l_ident i get e_ident i
die_ver 107
end
end
note 6. Verify EGP3 binary format + EGP3_SHA256 (argv[5])
if not load_arg_path 5
die_ver 103
end
if not validate_egp3_pbuf
die_ver 103
end
if not cmp_shex_lock 2
die_ver 103
end
note 7. Verify LEAN_PROOF_SHA256 (argv[6])
if not load_arg_path 6
die_ver 104
end
if not sha_file_pbuf
die_ver 104
end
if not cmp_shex_lock 3
die_ver 104
end
note 8. Verify OMPK v1 format + internal sem_id == SHA256(payload) == SOURCE_OM_SHA256 + OMPK_SHA256 (argv[7])
if not load_arg_path 7
die_ver 105
end
if not validate_ompk_pbuf
die_ver 105
end
for j ulong 64
if ne get h_semid j get l_semid j
die_ver 105
end
if ne get h_semid j get h_src j
die_ver 105
end
if ne get h_ompk j get l_ompk j
die_ver 105
end
end
note 9. Verify compiled unit machine-code .bin + length (argv[8]), ABI v2 .c (argv[9]), object .o (argv[10])
if not load_arg_path 8
die_ver 106
end
if not sha_file_pbuf
die_ver 106
end
if ne get st 1 get st 10
die_ver 106
end
if not cmp_shex_lock 6
die_ver 106
end
if not load_arg_path 9
die_ver 106
end
if not sha_file_pbuf
die_ver 106
end
if not cmp_shex_lock 7
die_ver 106
end
if not load_arg_path 10
die_ver 106
end
if not sha_file_pbuf
die_ver 106
end
if not cmp_shex_lock 8
die_ver 106
end
wtx 1 t_ok_ver
r0 = write 1 l_uname 0 get st 8
wtx 1 t_s_root
r1 = write 1 l_root 0 64
wnl 1
ret 0
end

fn main to int
if lt argcnt 2
wtx 2 t_usage
ret 2
end
if not load_arg_path 1
wtx 2 t_usage
ret 2
end
if pbuf_eq t_cmd_emit
ret cmd_emit
end
if pbuf_eq t_cmd_gen
ret cmd_generate
end
if pbuf_eq t_cmd_ver
ret cmd_verify
end
wtx 2 t_usage
ret 2
end

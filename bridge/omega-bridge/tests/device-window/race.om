note race.om: CPU-only control for the evidence-directory step of tools/run-device-window (the
note Omega program tools/run-device-window.om) and of its shell predecessor tools/run-device-window.sh
note (DRA-105 F5, omega-bridge #78; DRA-441). Opens no GPU and makes no spark-window call.
note
note Each trial starts two device-mode runs of the program with the same new ledger id at the
note same moment (both children block on one pipe until the parent writes). Exactly one may get
note past the directory step: the other must exit 2 with a REFUSE line. Neither may reach a
note window call: SPARK_WINDOW=NEGCTL-none skips the open, CUBIN_DIR names a missing directory so
note the run that got the directory stops at the cubin copy (exit 1) before the first row, and
note PATH=/usr/bin:/bin holds no spark-window at all. Then, on the same ledger id, a third
note device-mode run must refuse (exit 2) and leave rc.txt and window.txt as they were, and a
note dry-run must report EXISTS (exit 1).
note
note usage: race SCRIPT SCRATCH [TRIALS]
note   SCRIPT   the program to test. A name ending in ".sh" is copied to SCRATCH/tools/
note            run-device-window.sh and run with /bin/sh; any other name (the compiled
note            tools/run-device-window.om) is copied to SCRATCH/tools/run-device-window with
note            mode 0755 and run directly, so it finds SCRATCH as its tree from /proc/self/exe.
note   SCRATCH  a directory that must not exist yet; the caller removes it afterwards
note   TRIALS   default 100
note prints one summary line, then RACE PASS (exit 0) or RACE FAIL (exit 1); usage errors exit 2.
note compiler: the newest omega-mv main seed/out/omc; tests/device-window/README.md has the commands.
text tb "/usr/bin/env\nSPARK_WINDOW=NEGCTL-none\nPATH=/usr/bin:/bin\nCUBIN_DIR=\nCUDAPP=\n/bin/sh\n/tools/run-device-window.sh\n--ledger\nRACE-\n/evidence/device-window/\n/no-cubins\n/no-cudapp\n/logs/\n/rc.txt\n/window.txt\n/01-cubin-matmul.log\nREFUSE: \n/tools\n/logs\n.a\n.b\n--dry-run\nCUDA_VISIBLE_DEVICES=\nEXISTS  \n.c\n.d\nRACE trials=\n one_winner=\n both_proceeded=\n both_refused=\n seq_refused=\n dryrun_exists=\n evidence_ok=\nRACE PASS\nRACE FAIL\nFAIL trial=\n exits=\nusage: race SCRIPT SCRATCH [TRIALS]; SCRATCH must not exist\n bits=\n,\nMAXPY=/nonexistent/python\n/tools/run-device-window\n"
global ish ulong 1
global sb uchar 4096
global sn ulong 1
global ap uchar 1024
global an ulong 1
global pk uchar 4096
global pn ulong 2
global fb uchar 65536
global st uchar 4
global ends uchar 8
global stb uchar 128
global lg uchar 16384
global lgn ulong 1
global kp ulong 2
global tn ulong 1
global one uchar 2
global cnt ulong 8
global ex long 4
global sz long 2
note tbpos k: kp[0] = start, kp[1] = length of entry k of tb (entries end with a newline)
fn tbpos k ulong to void
i = ulong 0
e = ulong 0
c = true
while c bound 999999
if ge i len tb
c = false
else
if eq e k
c = false
else
if eq get tb i 10
e = add e 1
end
i = add i 1
end
end
end
put kp 0 i
j = i
d = true
while d bound 999999
if ge j len tb
d = false
else
if eq get tb j 10
d = false
else
j = add j 1
end
end
end
put kp 1 sub j i
end
fn sbclr to void
put sn 0 0
end
fn sbc b uchar to void
n = get sn 0
put sb n b
put sn 0 add n 1
end
fn sbk k ulong to void
tbpos k
s = get kp 0
m = get kp 1
for i ulong m
sbc get tb add s i
end
end
fn sbap to void
for i ulong get an 0
sbc get ap i
end
end
fn sbnum v ulong to void
d = new uchar 24 0
n = ulong 0
x = v
c = true
while c bound 30
put d n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
c = false
end
end
while gt n 0 bound 30
n = sub n 1
sbc get d n
end
end
fn flush to void
sbc 10
k = write 1 sb 0 get sn 0
sbclr
end
fn sayn k ulong v ulong to void
sbk k
sbnum v
end
note packet for execprog: u16 count, then records of u16 length and bytes (OMEGESE packed list)
fn pkbeg to void
put pn 0 2
put pn 1 0
end
fn pkrec to void
n = get sn 0
p = get pn 0
put pk p uchar and n 255
put pk add p 1 uchar shr n 8
for i ulong n
put pk add add p 2 i get sb i
end
put pn 0 add add p 2 n
put pn 1 add get pn 1 1
sbclr
end
fn pkk k ulong to void
sbk k
pkrec
end
fn pkend to void
c = get pn 1
put pk 0 uchar and c 255
put pk 1 uchar shr c 8
end
note pevid: sb = SCRATCH/evidence/device-window/RACE-<trial>
fn pevid to void
sbap
sbk 9
sbk 8
sbnum get tn 0
end
note plog tag: sb = SCRATCH/logs/RACE-<trial><tag>
fn plog tag ulong to void
sbap
sbk 12
sbk 8
sbnum get tn 0
sbk tag
end
note fsz: size of the file named by sb, -1 when stat fails; clears sb
fn fsz to long
r = stat sb 0 get sn 0 stb 0 128
sbclr
if lt r 0
ret -1
end
v = long 0
for i ulong 8
v = or shl v 8 long get stb sub 55 i
end
ret v
end
note fszp k: size of SCRATCH/evidence/device-window/RACE-<trial> + entry k
fn fszp k ulong to long
pevid
sbk k
ret fsz
end
note logrd tag: lg = the bytes of the run's log, lgn[0] = their count
fn logrd tag ulong to void
plog tag
f = fopen sb 0 get sn 0 0 0
sbclr
put lgn 0 0
if lt f 0
ret
end
n = ulong 0
c = true
while c bound 999999
if ge n 16384
c = false
else
k = read int f lg n sub 16384 n
if le k 0
c = false
else
n = add n ulong k
end
end
end
z = fclose int f
put lgn 0 n
end
fn hasat i ulong to bool
s = get kp 0
m = get kp 1
for j ulong m
if ne get lg add i j get tb add s j
ret false
end
end
ret true
end
note logfind tag k: does the run's log contain entry k of tb
fn logfind tag ulong k ulong to bool
logrd tag
tbpos k
m = get kp 1
n = get lgn 0
if lt n m
ret false
end
for i ulong add sub n m 1
if hasat i
ret true
end
end
ret false
end
fn fdat i ulong to int
v = uint 0
for j ulong 4
v = or v shl uint get ends add i j uint mul j 8
end
ret int v
end
note spawn mode tag: fork one run of the script (mode 0 device, 1 dry-run); its stdout and
note stderr go to SCRATCH/logs/RACE-<trial><tag>; it starts when the parent calls release
fn spawn mode ulong tag ulong to long
p = fork
if ne p 0
ret p
end
sbclr
rfd = fdat 0
k = read rfd one 0 1
plog tag
f = fopen sb 0 get sn 0 577 420
sbclr
if lt f 0
exit 121
end
a = dupfd int f 1 0
b = dupfd int f 2 0
pkbeg
pkk 0
if eq mode 1
pkk 22
pkk 40
else
pkk 1
end
pkk 2
sbk 3
sbap
sbk 10
pkrec
sbk 4
sbap
sbk 11
pkrec
if eq get ish 0 1
pkk 5
sbap
sbk 6
pkrec
else
sbap
sbk 41
pkrec
end
pkk 7
sbk 8
sbnum get tn 0
pkrec
if eq mode 1
pkk 21
end
pkend
x = execprog pk 0 get pn 0
exit 120
end
fn openp to void
r = pipefds ends 0 8 0
if ne r 0
exit 91
end
end
fn release to void
w = fdat 4
k = write w one 0 2
a = fclose fdat 0
b = fclose w
end
note wexit pid: exit status of the run, 1000 + signal when it was killed, -1 when wait failed
fn wexit p long to long
r = waitpid int p st 0 4 0
if lt r 0
ret -1
end
if ne get st 0 0
ret add 1000 long get st 0
end
ret long get st 1
end
note racep: the two concurrent runs; bit 1 exactly one winner (exit 1, no REFUSE) and one
note refusal (exit 2 with REFUSE), 2 both proceeded, 4 both refused
fn racep to ulong
openp
pa = spawn 0 19
pb = spawn 0 20
release
ea = wexit pa
eb = wexit pb
put ex 0 ea
put ex 1 eb
fa = logfind 19 16
fz = logfind 20 16
res = ulong 0
if and eq ea 2 eq eb 1
if and fa not fz
res = or res 1
end
end
if and eq ea 1 eq eb 2
if and fz not fa
res = or res 1
end
end
if and eq ea 1 eq eb 1
res = or res 2
end
if and eq ea 2 eq eb 2
res = or res 4
end
ret res
end
note shape: bit 32 when rc.txt is empty, window.txt was written and no row log exists
fn shape to ulong
w0 = fszp 14
r0 = fszp 13
put sz 0 w0
put sz 1 r0
m = fszp 15
if gt w0 0
if and eq r0 0 eq m -1
ret 32
end
end
ret 0
end
note seqp: bit 8 when a later run on the same ledger id refuses and changes nothing
fn seqp to ulong
openp
pc = spawn 0 24
release
ec = wexit pc
put ex 2 ec
fc = logfind 24 16
w1 = fszp 14
r1 = fszp 13
if and eq ec 2 fc
if and eq w1 get sz 0 eq r1 get sz 1
ret 8
end
end
ret 0
end
note dryp: bit 16 when a dry-run on the same ledger id reports EXISTS and exits 1
fn dryp to ulong
openp
pd = spawn 1 25
release
ed = wexit pd
put ex 3 ed
fx = logfind 25 23
if and eq ed 1 fx
ret 16
end
ret 0
end
fn sbex i ulong to void
v = get ex i
if lt v 0
sbnum 999
else
sbnum ulong v
end
end
note trial: the bits above; 57 = 1 + 8 + 16 + 32 is a pass
fn trial to ulong
a = racep
b = shape
c = seqp
d = dryp
res = or or or a b c d
if ne res 57
sayn 35 get tn 0
sbk 36
sbex 0
sbk 39
sbex 1
sbk 39
sbex 2
sbk 39
sbex 3
sayn 38 res
flush
end
ret res
end
fn bump i ulong to void
put cnt i add get cnt i 1
end
fn mkd to void
r = makedir sb 0 get sn 0 493
sbclr
if ne r 0
sbk 37
flush
exit 2
end
end
fn usage to void
sbk 37
flush
exit 2
end
note setup: SCRATCH from argument 2, its tools/ and logs/ directories, and the copy of SCRIPT
fn setup to void
r = argread 2 ap 0 1024
if le r 0
usage
end
put an 0 ulong r
sbap
mkd
sbap
sbk 17
mkd
sbap
sbk 18
mkd
q = argread 1 sb 0 4096
if le q 0
usage
end
put sn 0 ulong q
put ish 0 0
if ge q 3
u = ulong q
a = eq get sb sub u 3 46
b = eq get sb sub u 2 115
c = eq get sb sub u 1 104
if and and a b c
put ish 0 1
end
end
f = fopen sb 0 get sn 0 0 0
sbclr
if lt f 0
usage
end
sbap
if eq get ish 0 1
sbk 6
else
sbk 41
end
g = fopen sb 0 get sn 0 577 493
sbclr
if lt g 0
usage
end
go = true
while go bound 9223372036854775807
k = read int f fb 0 65536
if lt k 0
usage
end
if eq k 0
go = false
else
w = write int g fb 0 ulong k
if ne w k
usage
end
end
end
y = fclose int g
z = fclose int f
end
note ntrials c: argument 3 as a decimal count, 100 when absent
fn ntrials c long to ulong
if lt c 4
ret 100
end
y = argread 3 sb 0 32
if le y 0
usage
end
t = ulong 0
for i ulong ulong y
b = get sb i
if or lt b 48 gt b 57
usage
end
t = add mul t 10 ulong sub b 48
end
ret t
end
fn tally res ulong to void
for i ulong 6
if ne and res shl ulong 1 i 0
bump i
end
end
end
fn main to int
c = argcnt
if lt c 3
usage
end
setup
trials = ntrials c
for t ulong trials
put tn 0 add t 1
tally trial
end
sayn 26 trials
sayn 27 get cnt 0
sayn 28 get cnt 1
sayn 29 get cnt 2
sayn 30 get cnt 3
sayn 31 get cnt 4
sayn 32 get cnt 5
flush
ok = gt trials 0
for i ulong 6
if ne i 1
if ne i 2
if ne get cnt i trials
ok = false
end
end
end
end
if ok
sbk 33
flush
ret 0
end
sbk 34
flush
ret 1
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note omega-bridge cabi-1 gate, a seeded Omega driver (fork, pipefds, execprog and waitpid through tests/cabi/proc.om).
note Build: cat tests/cabi/proc.om tests/cabi/gate.om | "$OMEGA_SEEDED_OMC" > build/cabi-gate
note Run from the checkout root after tools/build.sh, with OMEGA_SEEDED_OMC set to the e5b32567 omc.
note ORACLE tools, test-only and never shipped: /usr/bin/cc, /usr/bin/nm, /usr/bin/readelf, /usr/bin/sha256sum, tests/cabi/caller.c.
global CbOm uchar 1024
global CbOn ulong 1
note CbExp is the exit status the next cb_bridge run must return; unsized views take two of the six parameter slots.
global CbExp ulong 1
text CbSeedK "OMEGA_SEEDED_OMC="
text CbNo "NOT_RUN: set OMEGA_SEEDED_OMC (omega-mv e5b32567 omc), run tools/build.sh, and start from the omega-bridge checkout root\n"
text CbFailP "CABI GATE FAIL: "
text CbNl "\n"
text CbPass "OMEGA-BRIDGE CABI GATE PASS\n"
text CbToc "src/toc.om"
text CbBr "build/bridge"
text CbDir "build/cabi"
text CbDa "build/cabi/ma"
text CbDb "build/cabi/mb"
text CbDc "build/cabi/mc"
text CbFix "tests/cabi/fixture.om"
text CbExtS "tests/cabi/ext.om"
text CbCall "tests/cabi/caller.c"
text CbGc "tests/cabi/golden/libombrfx.c"
text CbGh "tests/cabi/golden/ombrfx.h"
text CbGm "tests/cabi/golden/libombrfx.map"
text CbG1 "tests/cabi/golden/nvmlDeviceGetCount_v2.c"
text CbG2 "tests/cabi/golden/nvmlDeviceGetName.c"
text CbG3 "tests/cabi/golden/nvmlErrorString.c"
text CbOutC "build/cabi/libombrfx.c"
text CbOutH "build/cabi/ombrfx.h"
text CbOutM "build/cabi/libombrfx.map"
text CbAgain "build/cabi/again.c"
text CbExtC "build/cabi/ext.c"
text CbExtH "build/cabi/ext.h"
text CbSo "build/cabi/libombrfx.so.1"
text CbNm "build/cabi/nm.txt"
text CbRe "build/cabi/readelf.txt"
text CbHash "build/cabi/hash"
text CbRef "build/cabi/refuse.om"
text CbRefO "build/cabi/refuse.out"
text CbDin "build/cabi/direct.in"
text CbDout "build/cabi/direct.out"
text CbDsrc "build/cabi/direct.om"
text CbImp "build/cabi/imp.om"
text CbImpC "build/cabi/imp.c"
text CbImpO "build/cabi/imp.o"
text CbImpL "build/cabi/imp.log"
text CbSoN "/libombrfx.so.1"
text CbCN "/libombrfx.c"
text CbLogN "/cc.out"
text CbExN "/caller"
text CbOutN "/caller.out"
text CbLc "lib-c"
text CbLh "lib-h"
text CbLm "lib-map"
text CbC "c"
text CbH "h"
text CbEnv "/usr/bin/env"
text CbPath "PATH=/usr/bin:/bin"
text CbSh "/bin/sh"
text CbWrap "tools/bridge-seeded"
text CbSha "/usr/bin/sha256sum"
text CbCc "/usr/bin/cc"
text CbNmT "/usr/bin/nm"
text CbRel "/usr/bin/readelf"
text CbStd "-std=gnu11"
text CbO2 "-O2"
text CbPic "-fPIC"
text CbWall "-Wall"
text CbWext "-Wextra"
text CbWerr "-Werror"
text CbShare "-shared"
text CbCo "-c"
text CbInc "-include"
text CbStdi "stdint.h"
text CbIdir "-Ibuild/cabi"
text CbSoname "-Wl,-soname,libombrfx.so.1"
text CbVers "-Wl,--version-script=build/cabi/libombrfx.map"
text CbDefs "-Wl,-z,defs"
text CbRpath "-Wl,-rpath,$ORIGIN"
text CbDo "-o"
text CbPth "-lpthread"
text CbDyn "-D"
text CbDef "--defined-only"
text CbDd "-d"
text CbPa "/* GENERATED by omega-bridge cabi-1 from src/toc.om SHA256 "
text CbPb "; source SHA256 "
text CbPc ". */\n"
text CbClose "\n}\n"
text CbGen "GENERATED"
text CbErrW "error "
text CbT " T "
text CbOmega "omega_"
text CbSonam "Library soname: [libombrfx.so.1]"
text CbConf "conflicting types for"
text CbFxSum "omega_fx_sum"
text CbCpass "CALLER PASS checks=57 failures=0\n"
text CbCfail "CALLER FAIL checks="
text CbLost "lost=0\n"
text CbS1 "nvmlDeviceGetCount_v2"
text CbS2 "nvmlDeviceGetHandleByIndex_v2"
text CbS3 "nvmlDeviceGetName"
text CbS4 "nvmlDeviceGetMemoryInfo"
text CbS5 "nvmlDeviceGetComputeRunningProcesses_v2"
text CbS6 "nvmlErrorString"
text CbS7 "ombrFxBump"
text CbS8 "ombrFxSum"
text CbLdet "generation is deterministic"
text CbLprov "provenance line names the toc.om and source digests"
text CbLgold "artifact equals its golden after the provenance line"
text CbLfunc "exported wrapper equals its golden"
text CbLnm "nm -D --defined-only shows exactly the declared exports"
text CbLson "readelf shows the declared soname"
text CbLcall "caller ORACLE passes against the generated library"
text CbLproto "import declaration disagreeing with the external header is refused by cc"
text CbLonce "mutation text occurs exactly once"
text CbLhit "mutation text occurs"
text CbLdiag "refusal names the expected error"
text CbLemit "refusal emits no artifact"
text CbLgood "unmutated direct input generates"
text CbLmut "wrapper mutant is caught by the caller ORACLE"
text CbPgen "PASS generated C, header and version map: deterministic, provenance line and golden bytes\n"
text CbPfunc "PASS golden wrappers: nvmlDeviceGetCount_v2, nvmlDeviceGetName, nvmlErrorString\n"
text CbPnm "PASS ORACLE nm/readelf: 8 exports, no omega_ symbols, soname libombrfx.so.1\n"
text CbPcall "PASS ORACLE caller: 57 checks, nulls, out-params, handles, forged handles, stable strings, 8 threads x 2000 calls lost=0\n"
text CbPproto "PASS ORACLE cc refuses an import declaration that disagrees with the external unit's generated header\n"
text CbPref "PASS refused error "
text CbPsep ": "
text CbPdir "PASS direct build/bridge input: "
text CbPmut "PASS wrapper mutant caught: "
text CbXok "recomputed digests match; output equals the wrapper's (exit 0)\n"
text CbX52 "no provenance trailer refused (error 52)\n"
text CbX52z "all-zero digests refused (error 52)\n"
text CbX52t "zero generator digest refused (error 52)\n"
text CbX52w "wrong generator digest refused (error 52)\n"
text CbX52s "wrong source digest refused (error 52)\n"
text CbX52f "generator source withheld from descriptor 3 refused (error 52)\n"
text CbX51 "Omega global refused (error 51)\n"
text CbX51f "\nfn fx_init "
text CbX51t "\nglobal FxG ulong 1\n\nfn fx_init "
text CbImpF "span v 3 k value k"
text CbImpT "span v 3 k"
text CbAf1 "o_f[2]=deviceCount!=NULL;"
text CbAt1 "o_f[2]=1;"
text CbAf2 "(!deviceCount||"
text CbAt2 "("
text CbAw "FAIL count null out refused without commit\n"
text CbBf "*deviceCount=(unsigned int)o_f[3];"
text CbBt "(void)0;"
text CbBw "FAIL count published\n"
text CbCf1 "if(pthread_mutex_lock(&FxLock))return (nvmlReturn_t)999;\n  o_f[2]=value!=NULL;"
text CbCt1 "o_f[2]=value!=NULL;"
text CbCf2 "*value=(unsigned long long)o_f[3];\n  }\n  pthread_mutex_unlock(&FxLock);"
text CbCt2 "*value=(unsigned long long)o_f[3];\n  }"
text CbCw "FAIL no lost updates under concurrent calls\n"
text CbImpU "span v 2 k value k"
text CbDm "build/cabi/md"
text CbMsrc "build/cabi/md.om"
text CbMout "build/cabi/md.c"
text CbDw "FAIL import through omega_fx_sum with uchar and ulong spans\n"
text R40f " FxLock process mutex"
text R40t " FxLock process spin"
text R40l "malformed lock kind"
text R41f "note cabi export ombrFxBump fx_bump status"
text R41t "note cabi export nvmlDeviceGetName fx_bump status"
text R41l "duplicate export symbol"
text R42af "state FxSum ulong 1 process lock FxLock"
text R42at "state FxSum ulong 1 process lock FxLok"
text R42al "unknown lock"
text R42bf "bind nvmlDeviceGetCount_v2 st FxState"
text R42bt "bind nvmlDeviceGetCount_v2 st FxStat"
text R42bl "undeclared state"
text R42cf "export nvmlDeviceGetCount_v2 fx_count"
text R42ct "export nvmlDeviceGetCount_v2 fx_cnt"
text R42cl "export of a missing function"
text R42df "alias nvmlDeviceGetCount nvmlDeviceGetCount_v2"
text R42dt "alias nvmlDeviceGetCount nvmlDeviceGetCount_v3"
text R42dl "alias of a missing export"
text R43f "deviceCount nullable out uint32"
text R43t "deviceCount out uint32"
text R43l "wrong nullability"
text R44af "field nvmlMemory_t used uint64 16"
text R44at "field nvmlMemory_t used uint64 12"
text R44al "bad record offset"
text R44bf "nvmlMemory_st size 24"
text R44bt "nvmlMemory_st size 32"
text R44bl "bad record size"
text R45af "bind nvmlDeviceGetName b FxBytes"
text R45at "bind nvmlDeviceGetName b FxTexts"
text R45al "bind to state of the wrong extent"
text R45bf "nullable out nvmlProcessInfo_v2_t count infoCount commit 2"
text R45bt "nullable out nvmlProcessInfo_v2_t commit 2"
text R45bl "record array without count no longer matches the frame"
text R46af "export ombrFxBump fx_bump status nvmlReturn_t"
text R46at "export ombrFxBump fx_bump pointer nvmlReturn_t"
text R46al "raw pointer result"
text R46bf "arg ombrFxSum seed uint64"
text R46bt "arg ombrFxSum seed nvmlMemory_t"
text R46bl "raw pointer argument"
text R47f "name nullable out char length length commit 0"
text R47t "name nullable out char commit 0"
text R47l "out span without length"
text R48af "export nvmlErrorString fx_err cstr FxTexts"
text R48at "export nvmlErrorString fx_err cstr FxBytes"
text R48al "non-stable string storage"
text R48bf "cstr FxTexts slots 4 width 32"
text R48bt "cstr FxTexts slots 8 width 32"
text R48bl "cstr outside its storage"
text R49f "v view ulong 6 k ulong to ulong\nret 0"
text R49t "v view ulong 6 k ulong to ulong\nput r 0 1\nret 0"
text R49l "import stub with a body"
text R50f "\nfn fx_init "
text R50t "\nfn main to int\nret 0\nend\n\nfn fx_init "
text R50l "main in a library unit"

fn cb_say s view uchar * to void
hp_wpart 1 s 0 len s
end

fn cb_check ok bool label view uchar * to void
if not ok
hp_say CbFailP
hp_say label
hp_say CbNl
exit 1
end
end

fn cb_no to void
hp_say CbNo
exit 77
end

fn cb_env key view uchar * dst edit uchar * to ulong
b = new uchar 8192 0
for i ulong ulong envcnt
r = envread i b 0 len b
if ge r long len key
if hp_equal key b len key
n = sub ulong r len key
hp_require le n len dst
for j ulong n
put dst j get b add len key j
end
ret n
end
end
end
ret 0
end

fn cb_mkdir p view uchar * to void
r = makedir p 0 len p 493
if ne r -17
hp_require eq r 0
end
end

fn cb_config to void
b = new uchar 1024 0
on = cb_env CbSeedK b
if eq on 0
cb_no
end
if ne faccess b 0 on 1 0
cb_no
end
if ne faccess CbBr 0 len CbBr 1 0
cb_no
end
if ne faccess CbToc 0 len CbToc 4 0
cb_no
end
put CbOn 0 on
for i ulong on
put CbOm i get b i
end
cb_mkdir CbDir
cb_mkdir CbDa
cb_mkdir CbDb
cb_mkdir CbDc
cb_mkdir CbDm
end

fn cb_exec path view uchar * pn ulong code long to void
fd = hp_open path pn 524865 420
hp_exec -1 fd code
hp_close fd
end

note cc (ORACLE) runs under /usr/bin/env PATH=/usr/bin:/bin: execprog passes no environment, and
note collect2 finds ld through PATH.
fn cb_ccst to void
hp_start CbEnv len CbEnv
hp_arg CbPath len CbPath
hp_arg CbCc len CbCc
end

fn cb_bridge mode view uchar * unit view uchar * dest view uchar * to void
b = new uchar 2048 0
hp_start CbEnv len CbEnv
hp_arg CbPath len CbPath
for i ulong len CbSeedK
put b i get CbSeedK i
end
n = get CbOn 0
for i ulong n
put b add len CbSeedK i get CbOm i
end
hp_arg b add len CbSeedK n
hp_arg CbSh len CbSh
hp_arg CbWrap len CbWrap
hp_arg mode len mode
hp_arg unit len unit
cb_exec dest len dest long get CbExp 0
end

fn cb_hex v uchar to bool
if and ge v 48 le v 57
ret true
end
ret and ge v 97 le v 102
end

fn cb_hash path view uchar * dst edit uchar 64 to void
b = new uchar 2048 0
hp_start CbSha len CbSha
hp_arg path len path
cb_exec CbHash len CbHash 0
k = hp_read CbHash len CbHash b len b
hp_require ge k 65
for i ulong 64
v = get b i
hp_require cb_hex v
put dst i v
end
hp_require eq get b 64 32
end

fn cb_put dst edit uchar * pos ulong w view uchar * wn ulong to ulong
hp_require le wn len w
hp_require le pos len dst
hp_require le wn sub len dst pos
for i ulong wn
put dst add pos i get w i
end
ret add pos wn
end

fn cb_join dir view uchar * name view uchar * dst edit uchar 256 to ulong
n = cb_put dst 0 dir len dir
ret cb_put dst n name len name
end

fn cb_atn a view uchar * p ulong w view uchar * wn ulong to bool
if gt wn len a
ret false
end
if gt p sub len a wn
ret false
end
for i ulong wn
v = get a add p i
if ne v get w i
ret false
end
end
ret true
end

fn cb_count a view uchar * n ulong w view uchar * wn ulong to ulong
c = ulong 0
for p ulong n
if cb_atn a p w wn
c = add c 1
end
end
ret c
end

fn cb_has a view uchar * n ulong w view uchar * to bool
ret gt cb_count a n w len w 0
end

fn cb_find a view uchar * n ulong from ulong w view uchar * to ulong
p = from
while lt p n bound 999999
if cb_atn a p w len w
ret p
end
p = add p 1
end
ret n
end

note Source bytes end at the first NUL; the fixture and generated C hold none.
fn cb_sub a view uchar 131072 f view uchar * t view uchar * d edit uchar 131072 to ulong
o = ulong 0
p = ulong 0
hits = ulong 0
while lt p len a bound 999999
if eq get a p 0
break
end
if cb_atn a p f len f
o = cb_put d o t len t
p = add p len f
hits = add hits 1
else
hp_require lt o len d
put d o get a p
o = add o 1
p = add p 1
end
end
cb_check gt hits 0 CbLhit
hp_require lt o len d
ret o
end

fn cb_prov line edit uchar 256 to ulong
th = new uchar 64 0
sh = new uchar 64 0
cb_hash CbToc th
cb_hash CbFix sh
n = cb_put line 0 CbPa len CbPa
n = cb_put line n th 64
n = cb_put line n CbPb len CbPb
n = cb_put line n sh 64
ret cb_put line n CbPc len CbPc
end

fn cb_same a view uchar * off ulong g view uchar * k ulong to bool
hp_require le off len a
hp_require le k sub len a off
hp_require le k len g
for i ulong k
v = get a add off i
if ne v get g i
ret false
end
end
ret true
end

fn cb_golden path view uchar * line view uchar 256 ln ulong gold view uchar * to void
a = new uchar 131072 0
g = new uchar 131072 0
n = hp_read path len path a len a
hp_require lt n len a
cb_check gt n ln CbLprov
cb_check hp_equal a line ln CbLprov
k = hp_read gold len gold g len g
hp_require lt k len g
cb_check eq k sub n ln CbLgold
cb_check cb_same a ln g k CbLgold
end

fn cb_line a view uchar * p ulong to bool
if eq p 0
ret true
end
ret eq get a sub p 1 10
end

fn cb_func path view uchar * gold view uchar * to void
a = new uchar 131072 0
g = new uchar 8192 0
n = hp_read path len path a len a
hp_require lt n len a
k = hp_read gold len gold g len g
hp_require lt k len g
e = cb_find g k 0 CbNl
hp_require lt e k
kl = add e 1
hits = ulong 0
pos = ulong 0
for p ulong n
if cb_line a p
if cb_atn a p g kl
hits = add hits 1
pos = p
end
end
end
cb_check eq hits 1 CbLfunc
q = cb_find a n pos CbClose
cb_check lt q n CbLfunc
cb_check eq sub add q 3 pos k CbLfunc
cb_check cb_same a pos g k CbLfunc
end

fn cb_gen to void
line = new uchar 256 0
cb_bridge CbLc CbFix CbOutC
cb_bridge CbLc CbFix CbAgain
cb_check hp_cmp CbOutC len CbOutC CbAgain len CbAgain CbLdet
cb_bridge CbLh CbFix CbOutH
cb_bridge CbLm CbFix CbOutM
cb_bridge CbC CbExtS CbExtC
cb_bridge CbH CbExtS CbExtH
ln = cb_prov line
cb_golden CbOutC line ln CbGc
cb_golden CbOutH line ln CbGh
cb_golden CbOutM line ln CbGm
cb_say CbPgen
cb_func CbOutC CbG1
cb_func CbOutC CbG2
cb_func CbOutC CbG3
cb_say CbPfunc
end

fn cb_so dir view uchar * to void
so = new uchar 256 0
cs = new uchar 256 0
lg = new uchar 256 0
sn = cb_join dir CbSoN so
cn = cb_join dir CbCN cs
gn = cb_join dir CbLogN lg
cb_ccst
hp_arg CbStd len CbStd
hp_arg CbO2 len CbO2
hp_arg CbPic len CbPic
hp_arg CbWall len CbWall
hp_arg CbWext len CbWext
hp_arg CbWerr len CbWerr
hp_arg CbShare len CbShare
hp_arg CbInc len CbInc
hp_arg CbStdi len CbStdi
hp_arg CbInc len CbInc
hp_arg CbExtH len CbExtH
hp_arg CbSoname len CbSoname
hp_arg CbVers len CbVers
hp_arg CbDefs len CbDefs
hp_arg CbDo len CbDo
hp_arg so sn
hp_arg cs cn
hp_arg CbExtC len CbExtC
hp_arg CbPth len CbPth
cb_exec lg gn 0
end

fn cb_caller dir view uchar * code long to void
so = new uchar 256 0
ex = new uchar 256 0
lg = new uchar 256 0
ot = new uchar 256 0
sn = cb_join dir CbSoN so
xn = cb_join dir CbExN ex
gn = cb_join dir CbLogN lg
on = cb_join dir CbOutN ot
cb_ccst
hp_arg CbStd len CbStd
hp_arg CbO2 len CbO2
hp_arg CbWall len CbWall
hp_arg CbWext len CbWext
hp_arg CbWerr len CbWerr
hp_arg CbIdir len CbIdir
hp_arg CbDo len CbDo
hp_arg ex xn
hp_arg CbCall len CbCall
hp_arg so sn
hp_arg CbRpath len CbRpath
hp_arg CbPth len CbPth
cb_exec lg gn 0
hp_start ex xn
cb_exec ot on code
end

fn cb_output dir view uchar * b edit uchar 16384 to ulong
ot = new uchar 256 0
on = cb_join dir CbOutN ot
n = hp_read ot on b len b
hp_require lt n len b
ret n
end

fn cb_lib to void
b = new uchar 8192 0
cb_so CbDir
hp_start CbNmT len CbNmT
hp_arg CbDyn len CbDyn
hp_arg CbDef len CbDef
hp_arg CbSo len CbSo
cb_exec CbNm len CbNm 0
n = hp_read CbNm len CbNm b len b
hp_require lt n len b
cb_check eq cb_count b n CbNl 1 8 CbLnm
cb_sym b n CbS1
cb_sym b n CbS2
cb_sym b n CbS3
cb_sym b n CbS4
cb_sym b n CbS5
cb_sym b n CbS6
cb_sym b n CbS7
cb_sym b n CbS8
cb_check not cb_has b n CbOmega CbLnm
hp_start CbRel len CbRel
hp_arg CbDd len CbDd
hp_arg CbSo len CbSo
cb_exec CbRe len CbRe 0
k = hp_read CbRe len CbRe b len b
hp_require lt k len b
cb_check cb_has b k CbSonam CbLson
cb_say CbPnm
end

fn cb_sym b view uchar * n ulong s view uchar * to void
w = new uchar 128 0
k = cb_put w 0 CbT len CbT
k = cb_put w k s len s
k = cb_put w k CbNl 1
cb_check eq cb_count b n w k 1 CbLnm
end

fn cb_ends b view uchar * n ulong w view uchar * to bool
if lt n len w
ret false
end
ret cb_atn b sub n len w w len w
end

fn cb_call to void
b = new uchar 16384 0
cb_caller CbDir 0
n = cb_output CbDir b
cb_check cb_ends b n CbCpass CbLcall
cb_check cb_has b n CbLost CbLcall
cb_say CbPcall
end

fn cb_fixture a edit uchar 131072 to ulong
n = hp_read CbFix len CbFix a len a
hp_require lt n len a
ret n
end

fn cb_proto to void
a = new uchar 131072 0
d = new uchar 131072 0
b = new uchar 16384 0
n = cb_fixture a
hp_require gt n 0
m = cb_sub a CbImpF CbImpT d
hp_write CbImp len CbImp d m
cb_bridge CbLc CbImp CbImpC
cb_ccst
hp_arg CbStd len CbStd
hp_arg CbO2 len CbO2
hp_arg CbPic len CbPic
hp_arg CbWall len CbWall
hp_arg CbWext len CbWext
hp_arg CbWerr len CbWerr
hp_arg CbCo len CbCo
hp_arg CbInc len CbInc
hp_arg CbStdi len CbStdi
hp_arg CbInc len CbInc
hp_arg CbExtH len CbExtH
hp_arg CbDo len CbDo
hp_arg CbImpO len CbImpO
hp_arg CbImpC len CbImpC
put HMerge 0 1
cb_exec CbImpL len CbImpL 1
put HMerge 0 0
k = hp_read CbImpL len CbImpL b len b
hp_require lt k len b
cb_check cb_has b k CbConf CbLproto
cb_check cb_has b k CbFxSum CbLproto
cb_say CbPproto
end

fn cb_errw code long w edit uchar 64 to ulong
digits = new uchar 32 0
k = cb_put w 0 CbErrW len CbErrW
d = hp_num ulong code digits
k = cb_put w k digits d
ret cb_put w k CbNl 1
end

fn cb_refused b view uchar * k ulong code long to void
w = new uchar 64 0
wn = cb_errw code w
cb_check eq cb_count b k w wn 1 CbLdiag
cb_check not cb_has b k CbGen CbLemit
end

fn cb_refuse f view uchar * t view uchar * code long to void
a = new uchar 131072 0
d = new uchar 131072 0
b = new uchar 16384 0
digits = new uchar 32 0
n = cb_fixture a
cb_check eq cb_count a n f len f 1 CbLonce
m = cb_sub a f t d
hp_write CbRef len CbRef d m
put CbExp 0 ulong code
put HMerge 0 1
cb_bridge CbLc CbRef CbRefO
put HMerge 0 0
put CbExp 0 0
k = hp_read CbRefO len CbRefO b len b
hp_require lt k len b
cb_refused b k code
cb_say CbPref
dn = hp_num ulong code digits
hp_wpart 1 digits 0 dn
cb_say CbPsep
end

fn cb_tail label view uchar * to void
cb_say label
cb_say CbNl
end

fn cb_refusals to void
cb_refuse R40f R40t 40
cb_tail R40l
cb_refuse R41f R41t 41
cb_tail R41l
cb_refuse R42af R42at 42
cb_tail R42al
cb_refuse R42bf R42bt 42
cb_tail R42bl
cb_refuse R42cf R42ct 42
cb_tail R42cl
cb_refuse R42df R42dt 42
cb_tail R42dl
cb_refuse R43f R43t 43
cb_tail R43l
cb_refuse R44af R44at 44
cb_tail R44al
cb_refuse R44bf R44bt 44
cb_tail R44bl
cb_refuse R45af R45at 45
cb_tail R45al
cb_refuse R45bf R45bt 45
cb_tail R45bl
cb_refuse R46af R46at 46
cb_tail R46al
cb_refuse R46bf R46bt 46
cb_tail R46bl
cb_refuse R47f R47t 47
cb_tail R47l
cb_refuse R48af R48at 48
cb_tail R48al
cb_refuse R48bf R48bt 48
cb_tail R48bl
cb_refuse R49f R49t 49
cb_tail R49l
cb_refuse R50f R50t 50
cb_tail R50l
end

fn cb_nlen s view uchar 131072 to ulong
for i ulong len s
if eq get s i 0
ret i
end
end
ret len s
end

note cb_spoil: kind 0 keeps the digest, 1 makes it 64 zeros, 2 changes its first digit.
fn cb_spoil h edit uchar 64 kind ulong to void
if eq kind 1
for i ulong 64
put h i uchar 48
end
end
if eq kind 2
if eq get h 0 48
put h 0 uchar 49
else
put h 0 uchar 48
end
end
end

note cb_direct runs build/bridge without the wrapper. mode = toc kind + 3 * source kind (cb_spoil)
note + 9 when descriptor 3 is withheld + 27 when no trailer is appended. Digests come from the
note sha256sum ORACLE; the generator must recompute them itself and accept only exact matches.
fn cb_dfeed s view uchar 131072 mode ulong d edit uchar 140000 to ulong
th = new uchar 64 0
sh = new uchar 64 0
n = cb_nlen s
hp_write CbDsrc len CbDsrc s n
cb_hash CbToc th
cb_hash CbDsrc sh
cb_spoil th rem mode 3
cb_spoil sh rem div mode 3 3
put d 0 uchar 76
k = cb_put d 1 s n
if eq div mode 27 0
put d k uchar 10
k = cb_put d add k 1 th 64
put d k uchar 32
k = cb_put d add k 1 sh 64
put d k uchar 10
k = add k 1
end
ret k
end

fn cb_drun mode ulong code long to void
infd = hp_open CbDin len CbDin 524288 0
outfd = hp_open CbDout len CbDout 524865 420
tf = hp_open CbToc len CbToc 524288 0
hp_require gt tf 3
if eq rem div mode 9 3 0
put HFd3 0 add ulong tf 1
end
put HMerge 0 1
hp_start CbBr len CbBr
hp_exec infd outfd code
put HMerge 0 0
put HFd3 0 0
hp_close tf
hp_close infd
hp_close outfd
end

fn cb_direct s view uchar 131072 mode ulong code long label view uchar * to void
d = new uchar 140000 0
b = new uchar 131072 0
e = new uchar 131072 0
k = cb_dfeed s mode d
hp_write CbDin len CbDin d k
cb_drun mode code
m = hp_read CbDout len CbDout b len b
hp_require lt m len b
if eq code 0
en = cb_base e
cb_check eq m en CbLgood
cb_check hp_equal b e m CbLgood
else
cb_refused b m code
end
cb_say CbPdir
cb_say label
end

fn cb_dirs to void
a = new uchar 131072 0
d = new uchar 131072 0
n = cb_fixture a
hp_require gt n 0
cb_direct a 0 0 CbXok
cb_direct a 27 52 CbX52
cb_direct a 4 52 CbX52z
cb_direct a 1 52 CbX52t
cb_direct a 2 52 CbX52w
cb_direct a 6 52 CbX52s
cb_direct a 9 52 CbX52f
m = cb_sub a CbX51f CbX51t d
hp_require gt m n
cb_direct d 0 51 CbX51
end

fn cb_mrun dir view uchar * c view uchar 131072 n ulong want view uchar * to void
cs = new uchar 256 0
b = new uchar 16384 0
cn = cb_join dir CbCN cs
hp_write cs cn c n
cb_so dir
cb_caller dir 1
k = cb_output dir b
cb_check cb_has b k want CbLmut
cb_check cb_has b k CbCfail CbLmut
cb_say CbPmut
cb_say want
end

fn cb_base a edit uchar 131072 to ulong
n = hp_read CbOutC len CbOutC a len a
hp_require lt n len a
ret n
end

fn cb_muta to void
a = new uchar 131072 0
d = new uchar 131072 0
e = new uchar 131072 0
n = cb_base a
hp_require gt n 0
m = cb_sub a CbAf1 CbAt1 d
k = cb_sub d CbAf2 CbAt2 e
cb_mrun CbDa e k CbAw
end

fn cb_mutb to void
a = new uchar 131072 0
d = new uchar 131072 0
n = cb_base a
hp_require gt n 0
m = cb_sub a CbBf CbBt d
cb_mrun CbDb d m CbBw
end

fn cb_mutc to void
a = new uchar 131072 0
d = new uchar 131072 0
e = new uchar 131072 0
n = cb_base a
hp_require gt n 0
m = cb_sub a CbCf1 CbCt1 d
k = cb_sub d CbCf2 CbCt2 e
cb_mrun CbDc e k CbCw
end

note cb_mutd moves the ulong span of the omega_fx_sum import from element 3 to element 2 in the source;
note the bridge accepts it (the offset is in bounds) and only the caller ORACLE can see the wrong element.
fn cb_mutd to void
a = new uchar 131072 0
d = new uchar 131072 0
e = new uchar 131072 0
n = cb_fixture a
hp_require gt n 0
cb_check eq cb_count a n CbImpF len CbImpF 1 CbLonce
m = cb_sub a CbImpF CbImpU d
hp_write CbMsrc len CbMsrc d m
cb_bridge CbLc CbMsrc CbMout
k = hp_read CbMout len CbMout e len e
hp_require lt k len e
cb_mrun CbDm e k CbDw
end

fn cb_mutants to void
cb_muta
cb_mutb
cb_mutc
cb_mutd
end

fn main to int
cb_config
cb_gen
cb_lib
cb_call
cb_proto
cb_refusals
cb_dirs
cb_mutants
cb_say CbPass
ret 0
end

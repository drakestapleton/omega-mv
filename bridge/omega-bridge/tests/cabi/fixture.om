note omega-bridge cabi-1 fixture: an NVML-class library generated from seeded Omega by tools/bridge-seeded lib-c|lib-h|lib-map.
note cabi library libombrfx.so.1 header ombrfx.h
note cabi lock FxLock process mutex
note cabi status nvmlReturn_t nvmlReturn_enum int32 trap 999
note cabi value nvmlReturn_t NVML_SUCCESS 0
note cabi value nvmlReturn_t NVML_ERROR_INVALID_ARGUMENT 2
note cabi value nvmlReturn_t NVML_ERROR_INSUFFICIENT_SIZE 7
note cabi value nvmlReturn_t NVML_ERROR_UNKNOWN 999
note cabi define NVML_DEVICE_NAME_BUFFER_SIZE 64
note cabi aliasguard NVML_NO_UNVERSIONED_FUNC_DEFS
note cabi alias nvmlDeviceGetCount nvmlDeviceGetCount_v2
note cabi alias nvmlDeviceGetHandleByIndex nvmlDeviceGetHandleByIndex_v2
note cabi handle nvmlDevice_t nvmlDevice_st pool FxDevs count 4 lock FxLock
note cabi record nvmlMemory_t nvmlMemory_st size 24 align 8
note cabi field nvmlMemory_t total uint64 0
note cabi field nvmlMemory_t free uint64 8
note cabi field nvmlMemory_t used uint64 16
note cabi record nvmlProcessInfo_v2_t nvmlProcessInfo_v2_st size 24 align 8 alias nvmlProcessInfo_t
note cabi field nvmlProcessInfo_v2_t pid uint32 0
note cabi field nvmlProcessInfo_v2_t usedGpuMemory uint64 8
note cabi field nvmlProcessInfo_v2_t gpuInstanceId uint32 16
note cabi field nvmlProcessInfo_v2_t computeInstanceId uint32 20
note cabi state FxState ulong 8 process lock FxLock
note cabi state FxBytes uchar 512 process lock FxLock
note cabi state FxTexts uchar 128 process lock FxLock
note cabi state FxSum ulong 1 process lock FxLock
note cabi state FxW ulong 3 process lock FxLock
note cabi state FxV ulong 6 process lock FxLock
note cabi cstr FxTexts slots 4 width 32 fallback "Unknown Error" lock FxLock
note cabi export nvmlDeviceGetCount_v2 fx_count status nvmlReturn_t lock FxLock
note cabi bind nvmlDeviceGetCount_v2 st FxState
note cabi arg nvmlDeviceGetCount_v2 deviceCount nullable out uint32 commit 0
note cabi export nvmlDeviceGetHandleByIndex_v2 fx_handle status nvmlReturn_t lock FxLock
note cabi bind nvmlDeviceGetHandleByIndex_v2 st FxState
note cabi arg nvmlDeviceGetHandleByIndex_v2 index uint32
note cabi arg nvmlDeviceGetHandleByIndex_v2 device nullable out nvmlDevice_t commit 0
note cabi export nvmlDeviceGetName fx_name status nvmlReturn_t lock FxLock
note cabi bind nvmlDeviceGetName st FxState
note cabi bind nvmlDeviceGetName b FxBytes
note cabi arg nvmlDeviceGetName device nvmlDevice_t
note cabi arg nvmlDeviceGetName name nullable out char length length commit 0 data FxBytes 0
note cabi arg nvmlDeviceGetName length uint32
note cabi export nvmlDeviceGetMemoryInfo fx_mem status nvmlReturn_t lock FxLock
note cabi bind nvmlDeviceGetMemoryInfo st FxState
note cabi bind nvmlDeviceGetMemoryInfo b FxBytes
note cabi arg nvmlDeviceGetMemoryInfo device nvmlDevice_t
note cabi arg nvmlDeviceGetMemoryInfo memory nullable out nvmlMemory_t commit 0 data FxBytes 64
note cabi export nvmlDeviceGetComputeRunningProcesses_v2 fx_procs status nvmlReturn_t lock FxLock
note cabi bind nvmlDeviceGetComputeRunningProcesses_v2 st FxState
note cabi bind nvmlDeviceGetComputeRunningProcesses_v2 b FxBytes
note cabi arg nvmlDeviceGetComputeRunningProcesses_v2 device nvmlDevice_t
note cabi arg nvmlDeviceGetComputeRunningProcesses_v2 infoCount nullable inout uint32 commit 1
note cabi arg nvmlDeviceGetComputeRunningProcesses_v2 infos nullable out nvmlProcessInfo_v2_t count infoCount commit 2 data FxBytes 128
note cabi export nvmlErrorString fx_err cstr FxTexts lock FxLock
note cabi bind nvmlErrorString t FxTexts
note cabi bind nvmlErrorString st FxState
note cabi arg nvmlErrorString result nvmlReturn_t
note cabi export ombrFxBump fx_bump status nvmlReturn_t lock FxLock
note cabi bind ombrFxBump st FxState
note cabi arg ombrFxBump value nullable out uint64 commit 0
note cabi export ombrFxSum fx_sumx status nvmlReturn_t lock FxLock
note cabi bind ombrFxSum b FxBytes
note cabi bind ombrFxSum r FxSum
note cabi bind ombrFxSum w FxW
note cabi bind ombrFxSum v FxV
note cabi arg ombrFxSum seed uint64
note cabi arg ombrFxSum sum nullable out uint64 commit 0
note cabi import fx_ext omega_fx_sum result r span b 0 n value n span w 0 k span v 3 k value k

fn fx_ext r edit ulong 1 b view uchar 512 n ulong w edit ulong 3 v view ulong 6 k ulong to ulong
ret 0
end

note State words: 0 device count, 1 count calls, 3 bump counter, 6 texts ready, 7 initialised.
fn fx_init st edit ulong 8 to void
if eq get st 7 0
put st 0 2
put st 7 1
end
end

fn fx_count fr edit ulong 4 st edit ulong 8 to ulong
fx_init st
put st 1 add get st 1 1
if eq get fr 2 0
put fr 0 2
ret 0
end
put fr 3 get st 0
put fr 1 1
put fr 0 0
ret 0
end

fn fx_handle fr edit ulong 5 st edit ulong 8 to ulong
fx_init st
if eq get fr 3 0
put fr 0 2
ret 0
end
if ge get fr 2 get st 0
put fr 0 2
ret 0
end
put fr 4 get fr 2
put fr 1 1
put fr 0 0
ret 0
end

fn fx_gpu b edit uchar 512 d ulong to ulong
put b 0 uchar 79
put b 1 uchar 109
put b 2 uchar 101
put b 3 uchar 103
put b 4 uchar 97
put b 5 uchar 32
put b 6 uchar 70
put b 7 uchar 105
put b 8 uchar 120
put b 9 uchar 116
put b 10 uchar 117
put b 11 uchar 114
put b 12 uchar 101
put b 13 uchar 32
put b 14 uchar 71
put b 15 uchar 80
put b 16 uchar 85
put b 17 uchar 32
put b 18 uchar add 48 d
put b 19 uchar 0
ret 20
end

fn fx_name fr edit ulong 6 st edit ulong 8 b edit uchar 512 to ulong
fx_init st
if ge get fr 2 get st 0
put fr 0 2
ret 0
end
if eq get fr 3 0
put fr 0 2
ret 0
end
n = fx_gpu b get fr 2
if gt n get fr 5
put fr 0 7
ret 0
end
put fr 4 n
put fr 1 1
put fr 0 0
ret 0
end

fn fx_put64 b edit uchar 512 o ulong v ulong to void
w = v
for j ulong 8
put b add o j uchar and w 255
w = shr w 8
end
end

fn fx_put32 b edit uchar 512 o ulong v ulong to void
w = v
for j ulong 4
put b add o j uchar and w 255
w = shr w 8
end
end

fn fx_mem fr edit ulong 4 st edit ulong 8 b edit uchar 512 to ulong
fx_init st
if ge get fr 2 get st 0
put fr 0 2
ret 0
end
if eq get fr 3 0
put fr 0 2
ret 0
end
t = mul add get fr 2 1 1073741824
u = mul add get fr 2 1 4096
fx_put64 b 64 t
fx_put64 b 72 sub t u
fx_put64 b 80 u
put fr 1 1
put fr 0 0
ret 0
end

fn fx_proc b edit uchar 512 i ulong d ulong to void
o = add 128 mul i 24
for j ulong 24
put b add o j uchar 0
end
fx_put64 b o add 1000 add mul d 10 i
fx_put64 b add o 8 mul add i 1 1048576
fx_put32 b add o 16 7
fx_put32 b add o 20 9
end

fn fx_procs fr edit ulong 7 st edit ulong 8 b edit uchar 512 to ulong
fx_init st
if ge get fr 2 get st 0
put fr 0 2
ret 0
end
if eq get fr 3 0
put fr 0 2
ret 0
end
if lt get fr 4 2
put fr 4 2
put fr 1 2
put fr 0 7
ret 0
end
if eq get fr 5 0
put fr 0 2
ret 0
end
fx_proc b 0 get fr 2
fx_proc b 1 get fr 2
put fr 4 2
put fr 6 2
put fr 1 6
put fr 0 0
ret 0
end

fn fx_texts t edit uchar 128 to void
put t 0 uchar 83
put t 1 uchar 117
put t 2 uchar 99
put t 3 uchar 99
put t 4 uchar 101
put t 5 uchar 115
put t 6 uchar 115
put t 7 uchar 0
put t 32 uchar 73
put t 33 uchar 110
put t 34 uchar 118
put t 35 uchar 97
put t 36 uchar 108
put t 37 uchar 105
put t 38 uchar 100
put t 39 uchar 32
put t 40 uchar 65
put t 41 uchar 114
put t 42 uchar 103
put t 43 uchar 117
put t 44 uchar 109
put t 45 uchar 101
put t 46 uchar 110
put t 47 uchar 116
put t 48 uchar 0
put t 64 uchar 73
put t 65 uchar 110
put t 66 uchar 115
put t 67 uchar 117
put t 68 uchar 102
put t 69 uchar 102
put t 70 uchar 105
put t 71 uchar 99
put t 72 uchar 105
put t 73 uchar 101
put t 74 uchar 110
put t 75 uchar 116
put t 76 uchar 32
put t 77 uchar 83
put t 78 uchar 105
put t 79 uchar 122
put t 80 uchar 101
put t 81 uchar 0
end

fn fx_err fr edit ulong 3 t edit uchar 128 st edit ulong 8 to ulong
if eq get st 6 0
fx_texts t
put st 6 1
end
r = get fr 2
put fr 0 4
put fr 1 0
if eq r 0
put fr 0 0
put fr 1 7
end
if eq r 2
put fr 0 1
put fr 1 16
end
if eq r 7
put fr 0 2
put fr 1 17
end
ret 0
end

fn fx_bump fr edit ulong 4 st edit ulong 8 to ulong
if eq get fr 2 0
put fr 0 2
ret 0
end
v = get st 3
w = ulong 0
for j ulong 4096
w = add w j
end
put st 3 add v 1
put fr 3 add v 1
put fr 1 1
put fr 0 0
ret 0
end

fn fx_sumx fr edit ulong 5 b edit uchar 512 r edit ulong 1 w edit ulong 3 v edit ulong 6 to ulong
if eq get fr 3 0
put fr 0 2
ret 0
end
for j ulong 512
put b j uchar and j 255
end
for k ulong 6
put v k add k 1
end
put r 0 0
c = fx_ext r b 512 w v 3
if ne c 0
ret 1
end
s = add get fr 2 get r 0
s = add s get w 0
s = add s get w 1
s = add s get w 2
put fr 4 s
put fr 1 1
put fr 0 0
ret 0
end

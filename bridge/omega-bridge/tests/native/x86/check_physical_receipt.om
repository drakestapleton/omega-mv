text twpn "NATIVE-X86 FAIL x86 compiler pin"
text tmun "tools/native: x86 omc sha256"
fn fg i ulong to bool
ret eq get gv i 1
end
fn suitefx n long to void
if le n 0
ret
end
k = ulong n
if fsub 0 k temu
put gv FEMU 1
end
put gv LS 0
put gv LE 0
put gv FLAST 2
lscan k 0
s = get gv LS
e = get gv LE
if and fpre s e tnpass fsub s e tvnone
put gv FLAST 1
end
end
fn chklogs h long to void
l = objor dget long 0 tlogs
n0 = chklog l tlog0
suitefx n0
n1 = chklog l tlog1
if gt n1 0
lscan ulong n1 1
end
n2 = chklog l tlog2
if gt n2 0
if fsub 0 ulong n2 twpn
put gv FWRONG 1
end
end
n3 = chklog l tlog3
if gt n3 0
if fsub 0 ulong n3 tmun
put gv FMUT 1
end
end
chk tsl1 fg FLAST
chk tsl2 not fg FEMU
chk tsl3 fg FVIRT
chk tsl4 fg FHYP
chk tsl5 not fg FFAIL
chk tsl6 fg FCPU
chk tsl7 fg FKERN
chk tcl fg FCTRL
chk twp fg FWRONG
chk tmu fg FMUT
end
fn main to int
c = argcnt
if or lt c 2 gt c 3
w = write 2 tusage 0 len tusage
ret 2
end
rdarg 1
topth
if eq c 3
rdarg 2
toldr get gv NBN
else
rdarg 1
dfltdir
end
r = rdrcp
if ge r 0
ret r
end
put gv LN 0
ob = isobj 0
chk tobj ob
if not ob
ret finish
end
natpins
chktop
h = chkhost
chktools
chkcmds
mkexp h
chklogs h
ret finish
end

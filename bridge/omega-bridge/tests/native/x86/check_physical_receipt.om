om2
note check_physical_receipt.om: check a physical x86-64 receipt against docs/NATIVE-X86-PHYSICAL.md (DRA-104).
note usage: check_physical_receipt RECEIPT.json [LOGDIR], run from the repository root (it reads tools/native).
note LOGDIR defaults to the receipt path without its suffix (evidence/native-x86-physical-PIN8/).
note It reads only the receipt, its four logs and tools/native; it runs no compiler, caller or emulator.
note It refuses any receipt that is not a PHYSICAL NATIVE_PASS at the current x86 pin, including every
note EMULATED or VIRTUAL receipt, and any receipt whose logs do not show the suite's own NATIVE PASS line
note with virtualization=none and the hypervisor flag clear. Passing is a format and consistency check;
note it is not itself a run. Output: one PASS or FAIL line per check, then PHYSICAL-RECEIPT ACCEPTED (exit 0)
note or PHYSICAL-RECEIPT REJECTED (exit 1); a wrong argument count prints the usage line and exits 2.
note This program replaces check_physical_receipt.py (removed); the differences are listed in
note evidence/native-x86-physical-checker/README.md.
const PO ulong 0
const RL ulong 1
const NN ulong 2
const PU ulong 3
const SO ulong 4
const SL ulong 5
const NF ulong 6
const LN ulong 7
const FL ulong 8
const PL ulong 9
const DL ulong 10
const ABN ulong 11
const NBN ulong 12
const E1 ulong 13
const E2 ulong 14
const HX ulong 15
const HB ulong 16
const LS ulong 17
const LE ulong 18
const TL ulong 19
const FLAST ulong 20
const FEMU ulong 21
const FVIRT ulong 22
const FHYP ulong 23
const FFAIL ulong 24
const FCPU ulong 25
const FKERN ulong 26
const FCTRL ulong 27
const FWRONG ulong 28
const FMUT ulong 29
const OPN ulong 30
const BIGN ulong 31
const NODES ulong 524288
const RCAP ulong 900000
const FCAP ulong 16777215
const KNONE ulong 4294967295
global gv ulong 64
global rcp uchar 1048576
global pool uchar 1048576
global nty uchar 524288
global npa long 524288
global nko ulong 524288
global nkl ulong 524288
global nvo ulong 524288
global nvl ulong 524288
global nix ulong 524288
global fch long 524288
global nxs long 524288
global lch long 524288
global hfst ulong 524288
global hlst ulong 524288
global liv uchar 524288
global htab ulong 1048576
global fbuf uchar 16777216
global hexo uchar 64
global ln uchar 8388608
global fl uchar 8388608
global pth uchar 4096
global ldr uchar 4096
global ab uchar 4096
global nb uchar 4096
global opn uchar 8192
global xp uchar 2097152
global pinb uchar 128
note SHA-256 (FIPS 180-4) of fbuf[0..n), digest as 64 lowercase hex bytes in hexo[0..64).
note The schedule, round and padding code is copied from omega-mv e5b32567 om/sha256/sha256-om2.om
note (Apache-2.0), changed only to read the message from the global fbuf instead of an unsized view.
fn kinit k edit uint 64 to void
put k 0 0x428a2f98
put k 1 0x71374491
put k 2 0xb5c0fbcf
put k 3 0xe9b5dba5
put k 4 0x3956c25b
put k 5 0x59f111f1
put k 6 0x923f82a4
put k 7 0xab1c5ed5
put k 8 0xd807aa98
put k 9 0x12835b01
put k 10 0x243185be
put k 11 0x550c7dc3
put k 12 0x72be5d74
put k 13 0x80deb1fe
put k 14 0x9bdc06a7
put k 15 0xc19bf174
put k 16 0xe49b69c1
put k 17 0xefbe4786
put k 18 0x0fc19dc6
put k 19 0x240ca1cc
put k 20 0x2de92c6f
put k 21 0x4a7484aa
put k 22 0x5cb0a9dc
put k 23 0x76f988da
put k 24 0x983e5152
put k 25 0xa831c66d
put k 26 0xb00327c8
put k 27 0xbf597fc7
put k 28 0xc6e00bf3
put k 29 0xd5a79147
put k 30 0x06ca6351
put k 31 0x14292967
put k 32 0x27b70a85
put k 33 0x2e1b2138
put k 34 0x4d2c6dfc
put k 35 0x53380d13
put k 36 0x650a7354
put k 37 0x766a0abb
put k 38 0x81c2c92e
put k 39 0x92722c85
put k 40 0xa2bfe8a1
put k 41 0xa81a664b
put k 42 0xc24b8b70
put k 43 0xc76c51a3
put k 44 0xd192e819
put k 45 0xd6990624
put k 46 0xf40e3585
put k 47 0x106aa070
put k 48 0x19a4c116
put k 49 0x1e376c08
put k 50 0x2748774c
put k 51 0x34b0bcb5
put k 52 0x391c0cb3
put k 53 0x4ed8aa4a
put k 54 0x5b9cca4f
put k 55 0x682e6ff3
put k 56 0x748f82ee
put k 57 0x78a5636f
put k 58 0x84c87814
put k 59 0x8cc70208
put k 60 0x90befffa
put k 61 0xa4506ceb
put k 62 0xbef9a3f7
put k 63 0xc67178f2
end
fn iv s edit uint 8 to void
put s 0 0x6a09e667
put s 1 0xbb67ae85
put s 2 0x3c6ef372
put s 3 0xa54ff53a
put s 4 0x510e527f
put s 5 0x9b05688c
put s 6 0x1f83d9ab
put s 7 0x5be0cd19
end
fn sched w edit uint 64 o ulong to void
q = ulong 0
x = uint 0
y = uint 0
for i ulong 16 unroll
q = add o mul i 4
x = uint get fbuf q
x = or shl x 8 uint get fbuf add q 1
x = or shl x 8 uint get fbuf add q 2
put w i or shl x 8 uint get fbuf add q 3
end
for i ulong 48 unroll
x = get w add i 1
y = get w add i 14
x = add add get w i get w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
put w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
end
end
fn schedp w edit uint 64 p view uchar 128 o ulong to void
q = ulong 0
x = uint 0
y = uint 0
for i ulong 16 unroll
q = add o mul i 4
x = uint get p q
x = or shl x 8 uint get p add q 1
x = or shl x 8 uint get p add q 2
put w i or shl x 8 uint get p add q 3
end
for i ulong 48 unroll
x = get w add i 1
y = get w add i 14
x = add add get w i get w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
put w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
end
end
fn rounds s edit uint 8 w view uint 64 kt view uint 64 to void
a = get s 0
b = get s 1
c = get s 2
d = get s 3
e = get s 4
f = get s 5
g = get s 6
h = get s 7
t = uint 0
for i ulong 64 unroll
h = add h get kt i
h = add h get w i
t = xor rotr e 6 rotr e 11
t = xor t rotr e 25
h = add h t
h = add h xor g and e xor f g
d = add d h
t = xor rotr a 2 rotr a 13
t = xor t rotr a 22
h = add h t
t = and c or a b
h = add h or and a b t
t = h
h = g
g = f
f = e
e = d
d = c
c = b
b = a
a = t
end
put s 0 add get s 0 a
put s 1 add get s 1 b
put s 2 add get s 2 c
put s 3 add get s 3 d
put s 4 add get s 4 e
put s 5 add get s 5 f
put s 6 add get s 6 g
put s 7 add get s 7 h
end
text hexd "0123456789abcdef"
fn hexout s view uint 8 to void
for i ulong 8
v = get s i
for j2 ulong 8
sh = sub uint 28 mul uint j2 4
d = ulong and shr v sh 15
q = add mul i 8 j2
put hexo q get hexd d
end
end
end
fn tailblk s edit uint 8 w edit uint 64 kt view uint 64 n ulong to void
p = new uchar 128 0
off = shl shr n 6 6
k = sub n off
for i ulong k
put p i get fbuf add off i
end
put p k 0x80
e = ulong 64
if ge k 56
e = 128
end
bits = shl n 3
for i ulong 8 unroll
put p sub e add i 1 uchar and shr bits mul i 8 0xff
end
schedp w view p 0
rounds s view w kt
if eq e 128
schedp w view p 64
rounds s view w kt
end
end
fn shafbuf n ulong to void
s = new uint 8 0
w = new uint 64 0
kt = new uint 64 0
kinit kt
iv s
nbl = shr n 6
j = ulong 0
while lt j nbl bound 999999
sched w shl j 6
rounds s view w view kt
j = add j 1
end
tailblk s w view kt n
hexout view s
end

note ---- output: one check line is built in ln, then written as PASS/FAIL ----
text tpass "PASS "
text tfail "FAIL "
note a line longer than ln (only from a pathological receipt value) is cut there
fn lnb b uchar to void
n = get gv LN
if ge n 8388608
ret
end
put ln n b
put gv LN add n 1
end
fn lnt t view uchar * to void
for i ulong len t
lnb get t i
end
end
fn lnpool o ulong n ulong to void
for i ulong n
lnb get pool add o i
end
end
fn lndec v ulong to void
d = new uchar 24 0
k = ulong 0
x = v
go = true
while go bound 30
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
go = gt x 0
end
while gt k 0 bound 30
k = sub k 1
lnb get d k
end
end
fn lnhex v ulong nd ulong to void
k = nd
while gt k 0 bound 16
k = sub k 1
d = ulong and shr v mul k 4 15
lnb get hexd d
end
end
fn wln to void
n = get gv LN
o = ulong 0
while lt o n bound 999999
w = write 1 ln o sub n o
if le w 0
exit 3
end
o = add o ulong w
end
put gv LN 0
end
fn flkeep to void
f = get gv FL
if ge f 8388606
ret
end
if gt f 0
put fl f 59
put fl add f 1 32
f = add f 2
end
n = get gv LN
if gt n sub 8388608 f
n = sub 8388608 f
end
for i ulong n
put fl add f i get ln i
end
put gv FL add f n
end
fn emit ok bool to void
if ok
w = write 1 tpass 0 5
else
w2 = write 1 tfail 0 5
nf = get gv NF
if lt nf 4
flkeep
end
put gv NF add nf 1
end
lnb 10
wln
end
fn chk t view uchar * ok bool to void
lnt t
emit ok
end
text trej "PHYSICAL-RECEIPT REJECTED ("
text tfailed " failed: "
text tacc "PHYSICAL-RECEIPT ACCEPTED (format and log consistency only; not a run)\n"
fn finish to int
nf = get gv NF
if eq nf 0
w = write 1 tacc 0 len tacc
ret 0
end
put gv LN 0
lnt trej
lndec nf
lnt tfailed
f = get gv FL
for i ulong f
lnb get fl i
end
lnb 41
lnb 10
wln
ret 1
end

note ---- JSON (RFC 8259 as Python json.loads accepts it, without NaN/Infinity) into a node table ----
note node j: nty 1 object, 2 array, 3 string, 4 integer, 8 number with a fraction, 9 number with an
note exponent, 5 true, 6 false, 7 null; npa parent (-1 for the top value); nko/nkl the member key in pool
note (nkl KNONE for array elements, which carry their index in nix); nvo/nvl the decoded string or the
note number's text in pool. Every pass of each loop consumes at least one receipt byte (at most RCAP).
fn pk to long
p = get gv PO
if lt p get gv RL
ret long get rcp p
end
ret -1
end
fn adv to void
put gv PO add get gv PO 1
end
fn skipws to void
go = true
while go bound 999999
c = pk
go = or or eq c 32 eq c 9 or eq c 10 eq c 13
if go
adv
end
end
end
fn isdig c long to bool
ret and ge c 48 le c 57
end
fn hexv c long to long
if isdig c
ret sub c 48
end
if and ge c 97 le c 102
ret sub c 87
end
if and ge c 65 le c 70
ret sub c 55
end
ret -1
end
fn hex4 to long
v = long 0
for i ulong 4
h = hexv pk
if lt h 0
ret -1
end
v = add mul v 16 h
adv
end
ret v
end
fn pput b ulong to void
u = get gv PU
put pool u uchar b
put gv PU add u 1
end
fn putcp cp ulong to void
if lt cp 128
pput cp
ret
end
if lt cp 2048
pput or 192 shr cp 6
pput or 128 and cp 63
ret
end
if lt cp 65536
pput or 224 shr cp 12
pput or 128 and shr cp 6 63
pput or 128 and cp 63
ret
end
pput or 240 shr cp 18
pput or 128 and shr cp 12 63
pput or 128 and shr cp 6 63
pput or 128 and cp 63
end
fn lowsur v long to long
if or lt v 0xd800 ge v 0xdc00
ret v
end
p = get gv PO
if ne pk 92
ret v
end
adv
if ne pk 117
put gv PO p
ret v
end
adv
w = hex4
if and ge w 0xdc00 lt w 0xe000
ret add 0x10000 add shl sub v 0xd800 10 sub w 0xdc00
end
put gv PO p
ret v
end
fn pesc to bool
c = pk
if lt c 0
ret false
end
adv
if eq c 117
v = hex4
if lt v 0
ret false
end
v2 = lowsur v
putcp ulong v2
ret true
end
m = long -1
if or eq c 34 or eq c 92 eq c 47
m = c
end
if eq c 98
m = 8
end
if eq c 102
m = 12
end
if eq c 110
m = 10
end
if eq c 114
m = 13
end
if eq c 116
m = 9
end
if lt m 0
ret false
end
pput ulong m
ret true
end
fn pstr to bool
if ne pk 34
ret false
end
adv
put gv SO get gv PU
go = true
while go bound 999999
c = pk
if lt c 32
ret false
end
adv
if eq c 34
go = false
else
if eq c 92
ok = pesc
if not ok
ret false
end
else
pput ulong c
end
end
end
put gv SL sub get gv PU get gv SO
ret true
end
fn digs to ulong
k = ulong 0
while isdig pk bound 999999
adv
k = add k 1
end
ret k
end
fn pnum to long
s = get gv PO
if eq pk 45
adv
end
c = pk
if eq c 48
adv
else
if not isdig c
ret -1
end
d = digs
end
ty = long 4
if eq pk 46
adv
if eq digs 0
ret -1
end
ty = 8
end
c = pk
if or eq c 101 eq c 69
adv
c = pk
if or eq c 43 eq c 45
adv
end
if eq digs 0
ret -1
end
ty = 9
end
put gv SO get gv PU
e = get gv PO
while lt s e bound 999999
pput ulong get rcp s
s = add s 1
end
put gv SL sub get gv PU get gv SO
ret ty
end
fn plit t view uchar * to bool
for i ulong len t
if ne pk long get t i
ret false
end
adv
end
ret true
end
note ---- object members: a hash of (parent, key) finds the first member with that key (hfst) and the
note last one (hlst of the first), so lookups and Python dict order cost one probe, not a scan ----
fn hpool p long o ulong k ulong to ulong
h = ulong 0xcbf29ce484222325
h = xor h ulong add p 1
h = mul h 0x100000001b3
for i ulong k
h = xor h ulong get pool add o i
h = mul h 0x100000001b3
end
r = and h 1048575
ret r
end
fn htext p long t view uchar * to ulong
h = ulong 0xcbf29ce484222325
h = xor h ulong add p 1
h = mul h 0x100000001b3
for i ulong len t
h = xor h ulong get t i
h = mul h 0x100000001b3
end
r = and h 1048575
ret r
end
fn sibeq a ulong b ulong to bool
if ne get nkl a get nkl b
ret false
end
oa = get nko a
ob = get nko b
k = get nkl a
for i ulong k
x = get pool add oa i
if ne x get pool add ob i
ret false
end
end
ret true
end
note at most NODES entries in 1048576 slots, so a probe always reaches an empty slot
fn hput n ulong to void
p = get npa n
s = hpool p get nko n get nkl n
go = true
while go bound 999999
v = get htab s
if eq v 0
put htab s add n 1
put hfst n n
put hlst n n
ret
end
m = sub v 1
if eq get npa m p
if sibeq m n
put hfst n m
put hlst m n
ret
end
end
s = and add s 1 1048575
end
end
fn keyeq j ulong t view uchar * to bool
if ne get nkl j len t
ret false
end
o = get nko j
for i ulong len t
if ne get pool add o i get t i
ret false
end
end
ret true
end
fn dget par long t view uchar * to long
if lt par 0
ret -1
end
if ne get nty par 1
ret -1
end
s = htext par t
go = true
while go bound 999999
v = get htab s
if eq v 0
ret -1
end
m = sub v 1
if eq get npa m par
if keyeq m t
ret long get hlst m
end
end
s = and add s 1 1048575
end
ret -1
end
fn newnd ty uchar par long ko ulong kl ulong ix ulong to long
n = get gv NN
if ge n NODES
ret -1
end
put nty n ty
put npa n par
put nko n ko
put nkl n kl
put nix n ix
put nvo n get gv SO
put nvl n get gv SL
put fch n -1
put nxs n -1
put lch n -1
if ge par 0
l = get lch par
if lt l 0
put fch par long n
else
put nxs l long n
end
put lch par long n
end
if ne kl KNONE
hput n
end
put gv NN add n 1
ret long n
end
text ttrue "true"
text tfalse "false"
text tnull "null"
fn pobj par long ko ulong kl ulong ix ulong dep ulong to bool
n = newnd 1 par ko kl ix
if lt n 0
ret false
end
adv
skipws
if eq pk 125
adv
ret true
end
go = true
while go bound 999999
skipws
ok = pstr
if not ok
ret false
end
k0 = get gv SO
k1 = get gv SL
skipws
if ne pk 58
ret false
end
adv
ok2 = pval n k0 k1 0 add dep 1
if not ok2
ret false
end
skipws
c = pk
adv
if eq c 125
go = false
else
if ne c 44
ret false
end
end
end
ret true
end
fn parr par long ko ulong kl ulong ix ulong dep ulong to bool
n = newnd 2 par ko kl ix
if lt n 0
ret false
end
adv
skipws
if eq pk 93
adv
ret true
end
i = ulong 0
go = true
while go bound 999999
ok = pval n 0 KNONE i add dep 1
if not ok
ret false
end
i = add i 1
skipws
c = pk
adv
if eq c 93
go = false
else
if ne c 44
ret false
end
end
end
ret true
end
fn pscal par long ko ulong kl ulong ix ulong to bool
c = pk
ty = long 0
if eq c 34
ok = pstr
if not ok
ret false
end
ty = 3
end
if eq c 116
if not plit ttrue
ret false
end
ty = 5
end
if eq c 102
if not plit tfalse
ret false
end
ty = 6
end
if eq c 110
if not plit tnull
ret false
end
ty = 7
end
if or eq c 45 isdig c
ty = pnum
end
if le ty 0
ret false
end
n = newnd uchar ty par ko kl ix
ret ge n 0
end
fn pval par long ko ulong kl ulong ix ulong dep ulong to bool
if gt dep 900
ret false
end
skipws
c = pk
if eq c 123
ret pobj par ko kl ix dep
end
if eq c 91
ret parr par ko kl ix dep
end
ret pscal par ko kl ix
end

note ---- receipt bytes must be UTF-8 (Python read_text then json.loads) ----
fn cont p ulong lo ulong hi ulong to bool
if ge p get gv RL
ret false
end
b = ulong get rcp p
ret and ge b lo le b hi
end
fn u8len p ulong to ulong
b = ulong get rcp p
if lt b 0x80
ret 1
end
if and ge b 0xc2 le b 0xdf
if cont add p 1 0x80 0xbf
ret 2
end
ret 0
end
lo = ulong 0x80
hi = ulong 0xbf
if eq b 0xe0
lo = 0xa0
end
if eq b 0xed
hi = 0x9f
end
if and ge b 0xe0 le b 0xef
if and cont add p 1 lo hi cont add p 2 0x80 0xbf
ret 3
end
ret 0
end
if eq b 0xf0
lo = 0x90
end
if eq b 0xf4
hi = 0x8f
end
if and ge b 0xf0 le b 0xf4
if and cont add p 1 lo hi and cont add p 2 0x80 0xbf cont add p 3 0x80 0xbf
ret 4
end
end
ret 0
end
fn utf8ok to long
p = ulong 0
n = get gv RL
while lt p n bound 999999
k = u8len p
if eq k 0
ret long p
end
p = add p k
end
ret -1
end
note ---- node lookups (a repeated key: the last one wins, as in a Python dict) ----
fn isobj n long to bool
if lt n 0
ret false
end
ret eq get nty n 1
end
fn nch par long to ulong
if lt par 0
ret 0
end
if ne get nty par 2
ret 0
end
c = ulong 0
j = get fch par
while ge j 0 bound 999999
c = add c 1
j = get nxs j
end
ret c
end
fn aget par long i ulong to long
if lt par 0
ret -1
end
if ne get nty par 2
ret -1
end
j = get fch par
while ge j 0 bound 999999
if eq get nix j i
ret j
end
j = get nxs j
end
ret -1
end
note ---- value tests ----
fn peq o ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n
if ne get pool add o i get t i
ret false
end
end
ret true
end
fn vstr n long t view uchar * to bool
if lt n 0
ret false
end
if ne get nty n 3
ret false
end
ret peq get nvo n get nvl n t
end
fn psub o ulong n ulong t view uchar * to bool
m = len t
if lt n m
ret false
end
s = ulong 0
while le s sub n m bound 999999
if peq add o s m t
ret true
end
s = add s 1
end
ret false
end
fn vsub n long t view uchar * to bool
if lt n 0
ret false
end
if ne get nty n 3
ret false
end
ret psub get nvo n get nvl n t
end
note value == d for d 0 or 1 with exact decimal arithmetic: true is 1, false is 0, and a number is
note compared by its digits and exponent (-0, 1.0, 10e-1, 0e5 all count). Python compares the binary64
note rounding instead, so a number like 1.00000000000000001 that only rounds to 1 is refused here.
fn numcls n long to ulong
o = get nvo n
e = add o get nvl n
if eq get pool o 45
o = add o 1
end
ipe = e
st = ulong 0
nz = ulong 0
dig = ulong 0
pz = ulong 0
ex = long 0
while lt o e bound 999999
c = ulong get pool o
if or eq c 46 or eq c 101 eq c 69
if eq st 0
ipe = o
end
st = 1
if ne c 46
st = 2
end
else
if eq c 45
st = 3
else
if lt st 2
if and ne c 43 ne c 48
nz = add nz 1
dig = c
pz = o
end
else
if and ne c 43 lt ex 100000000
ex = add mul ex 10 long sub c 48
end
end
end
end
o = add o 1
end
if eq nz 0
ret 0
end
s0 = get nvo n
if eq get pool s0 45
ret 2
end
if or ne nz 1 ne dig 49
ret 2
end
if eq st 3
ex = neg ex
end
r = add long ipe ex
if lt pz ipe
r = sub r 1
end
if eq long pz r
ret 1
end
ret 2
end
fn numis n long d ulong to bool
if lt n 0
ret false
end
t = get nty n
if eq t 5
ret eq d 1
end
if eq t 6
ret eq d 0
end
if and and ne t 4 ne t 8 ne t 9
ret false
end
ret eq numcls n d
end
fn cplen o ulong to ulong
b = get pool o
if lt b 0x80
ret 1
end
if lt b 0xe0
ret 2
end
if lt b 0xf0
ret 3
end
ret 4
end
fn cpat o ulong to ulong
b = ulong get pool o
k = cplen o
if eq k 1
ret b
end
v = ulong and b 0x1f
if eq k 3
v = and b 0x0f
end
if eq k 4
v = and b 0x07
end
for i ulong sub k 1
v = or shl v 6 and ulong get pool add o add i 1 0x3f
end
ret v
end
fn isspc cp ulong to bool
if or and ge cp 9 le cp 13 and ge cp 28 le cp 32
ret true
end
if or or eq cp 0x85 eq cp 0xa0 or eq cp 0x1680 and ge cp 0x2000 le cp 0x200a
ret true
end
ret or or eq cp 0x2028 eq cp 0x2029 or or eq cp 0x202f eq cp 0x205f eq cp 0x3000
end
note text(v): a string that is not empty after Python str.strip()
fn vtext n long to bool
if lt n 0
ret false
end
if ne get nty n 3
ret false
end
o = get nvo n
e = add o get nvl n
while lt o e bound 999999
if not isspc cpat o
ret true
end
o = add o cplen o
end
ret false
end
fn ishexs n long k ulong to bool
if lt n 0
ret false
end
if ne get nty n 3
ret false
end
if ne get nvl n k
ret false
end
o = get nvo n
for i ulong k
c = long get pool add o i
if not or isdig c and ge c 97 le c 102
ret false
end
end
ret true
end

note ---- Python repr() and str() of a JSON value, appended to the check line ----
text tnone "None"
text ttru "True"
text tfls "False"
fn npr cp ulong to bool
if or le cp 0xa0 eq cp 0xad
ret true
end
if or and ge cp 0xd800 le cp 0xf8ff or eq cp 0x1680 and ge cp 0x2000 le cp 0x200f
ret true
end
if or and ge cp 0x2028 le cp 0x202f or eq cp 0x205f and ge cp 0x2060 le cp 0x206f
ret true
end
ret or or eq cp 0x3000 eq cp 0xfeff and ge cp 0xfff9 le cp 0xfffb
end
fn rpcp cp ulong q ulong o ulong k ulong to void
if or eq cp q eq cp 92
lnb 92
lnb uchar cp
ret
end
if eq cp 9
lnb 92
lnb 116
ret
end
if eq cp 10
lnb 92
lnb 110
ret
end
if eq cp 13
lnb 92
lnb 114
ret
end
if and ge cp 32 lt cp 127
lnb uchar cp
ret
end
if and lt cp 128 or lt cp 32 eq cp 127
lnb 92
lnb 120
lnhex cp 2
ret
end
if npr cp
lnb 92
if le cp 0xff
lnb 120
lnhex cp 2
else
lnb 117
lnhex cp 4
end
ret
end
lnpool o k
end
fn rpstr o ulong n ulong to void
sq = false
dq = false
for i ulong n
b = get pool add o i
if eq b 39
sq = true
end
if eq b 34
dq = true
end
end
q = ulong 39
if and sq not dq
q = 34
end
lnb uchar q
i = ulong 0
while lt i n bound 999999
p = add o i
k = cplen p
rpcp cpat p q p k
i = add i k
end
lnb uchar q
end
fn rpnum n long to void
o = get nvo n
k = get nvl n
if eq get nty n 4
if eq k 2
if and eq get pool o 45 eq get pool add o 1 48
lnb 48
ret
end
end
end
lnpool o k
end
fn rpobj n long to void
lnb 123
c = ulong 0
j = get fch n
while ge j 0 bound 999999
u = ulong j
if eq get hfst u u
if gt c 0
lnb 44
lnb 32
end
rpstr get nko u get nkl u
lnb 58
lnb 32
prep long get hlst u
c = add c 1
end
j = get nxs u
end
lnb 125
end
fn rparr n long to void
lnb 91
j = get fch n
while ge j 0 bound 999999
if ne j get fch n
lnb 44
lnb 32
end
prep j
j = get nxs j
end
lnb 93
end
fn prep n long to void
if lt n 0
lnt tnone
ret
end
t = get nty n
if eq t 3
rpstr get nvo n get nvl n
ret
end
if eq t 5
lnt ttru
ret
end
if eq t 6
lnt tfls
ret
end
if eq t 7
lnt tnone
ret
end
if eq t 1
rpobj n
ret
end
if eq t 2
rparr n
ret
end
rpnum n
end
fn pstrv n long to void
if ge n 0
if eq get nty n 3
lnpool get nvo n get nvl n
ret
end
end
prep n
end
note the receipt (its live members only, as json.dumps sees the dict) names EMULATED anywhere
text temu "EMULATED"
note live: the member json.dumps would see, i.e. no later sibling has its key and its parent is live;
note parents come before children in the node table, so one forward pass fills liv
fn sayemu to bool
k = get gv NN
for j ulong k
p = get npa j
ok = true
if ge p 0
ok = eq get liv p 1
end
if ne get nkl j KNONE
if ne get hlst get hfst j j
ok = false
end
end
put liv j 0
if ok
put liv j 1
if ne get nkl j KNONE
if psub get nko j get nkl j temu
ret true
end
end
if eq get nty j 3
if psub get nvo j get nvl j temu
ret true
end
end
end
end
ret false
end

note ---- paths: Python pathlib display (str(Path(arg))) and Path.with_suffix("") ----
fn nbb b uchar to void
k = get gv NBN
put nb k b
put gv NBN add k 1
end
note normalise ab[0..ABN) into nb: repeated slashes and "." parts dropped, "//" kept at the start
fn normp to void
n = get gv ABN
put gv NBN 0
pre = ulong 0
if gt n 0
if eq get ab 0 47
nbb 47
pre = 1
if gt n 1
if eq get ab 1 47
if or eq n 2 ne get ab 2 47
nbb 47
pre = 2
end
end
end
end
end
i = ulong 0
while lt i n bound 4097
if eq get ab i 47
i = add i 1
continue
end
j = i
while lt j n bound 4097
if eq get ab j 47
break
end
j = add j 1
end
dot = and eq sub j i 1 eq get ab i 46
if not dot
if gt get gv NBN pre
nbb 47
end
for k ulong sub j i
nbb get ab add i k
end
end
i = j
end
if eq get gv NBN 0
nbb 46
end
end
fn rdarg i ulong to void
r = argread i ab 0 4096
if lt r 0
exit 2
end
put gv ABN ulong r
normp
end
note start of the last path part of nb (the name); equal to NBN when the name is empty
fn namest to ulong
k = get gv NBN
if and eq k 1 eq get nb 0 46
ret 1
end
i = k
while gt i 0 bound 4097
if eq get nb sub i 1 47
ret i
end
i = sub i 1
end
ret 0
end
fn topth to void
k = get gv NBN
for i ulong k
put pth i get nb i
end
put gv PL k
end
fn toldr k ulong to void
for i ulong k
put ldr i get nb i
end
put gv DL k
end
note logdir default: the receipt path without its suffix (Python Path.suffix: 0 < rfind(".") < len-1)
fn dfltdir to void
k = get gv NBN
s = namest
c = k
i = k
while gt i s bound 4097
i = sub i 1
if eq get nb i 46
c = i
break
end
end
if or eq c k or eq c s eq c sub k 1
c = k
end
toldr c
end
note ---- tools/native pins: the first line exactly KEY= plus 64 lowercase hex ----
text tpin "PIN="
text tx86 "X86_PIN="
fn fhex p ulong to bool
c = long get fbuf p
ret or isdig c and ge c 97 le c 102
end
fn pinln s ulong e ulong t view uchar * to bool
k = len t
if ne sub e s add k 64
ret false
end
for i ulong k
if ne get fbuf add s i get t i
ret false
end
end
for i ulong 64
if not fhex add s add k i
ret false
end
end
ret true
end
text tnat "tools/native"
fn rdfile fd int to long
n = ulong 0
go = true
while go bound 999999
r = read fd fbuf n sub FCAP n
if lt r 0
ret r
end
if eq r 0
go = false
else
n = add n ulong r
if eq n FCAP
r2 = read fd fbuf n 1
if ne r2 0
ret -27
end
go = false
end
end
end
ret long n
end
fn natpins to void
put gv HX 0
put gv HB 0
fd = fopen tnat 0 len tnat 0 0
if lt fd 0
ret
end
n = rdfile int fd
c = fclose int fd
if lt n 0
ret
end
s = ulong 0
while lt s ulong n bound 999999
e = s
while lt e ulong n bound 999999
if eq get fbuf e 10
break
end
e = add e 1
end
if and eq get gv HX 0 pinln s e tx86
put gv HX 1
for i ulong 64
put pinb i get fbuf add s add 8 i
end
end
if and eq get gv HB 0 pinln s e tpin
put gv HB 1
for i ulong 64
put pinb add 64 i get fbuf add s add 4 i
end
end
s = add e 1
end
end
fn pineq n long base ulong to bool
if lt n 0
ret false
end
if ne get nty n 3
ret false
end
if ne get nvl n 64
ret false
end
o = get nvo n
for i ulong 64
if ne get pool add o i get pinb add base i
ret false
end
end
ret true
end
text tfpre "native-x86-physical-"
text tjson ".json"
fn fnameok to bool
k = get gv PL
s = k
while gt s 0 bound 4097
if eq get pth sub s 1 47
break
end
s = sub s 1
end
if eq k 1
if eq get pth 0 46
s = 1
end
end
if ne sub k s 33
ret false
end
for i ulong 20
if ne get pth add s i get tfpre i
ret false
end
end
for i ulong 8
if ne get pth add s add 20 i get pinb i
ret false
end
end
for i ulong 5
if ne get pth add s add 28 i get tjson i
ret false
end
end
ret true
end

note ---- logs: open LOGDIR/NAME, require a regular file (Path.is_file), read it into fbuf ----
text tlog0 "x86-native.log"
text tlog1 "x86-native-controls.log"
text tlog2 "x86-native-wrongpin.log"
text tlog3 "x86-native-mut.log"
fn opb b uchar to void
k = get gv OPN
put opn k b
put gv OPN add k 1
end
fn opnam t view uchar * to void
put gv OPN 0
k = get gv DL
for i ulong k
opb get ldr i
end
opb 47
for i ulong len t
opb get t i
end
end
note returns the byte count, -1 when the path is not a regular file, -2 when larger than FCAP
fn rdlog t view uchar * to long
opnam t
fd = fopen opn 0 get gv OPN 2048 0
if lt fd 0
ret -1
end
st = new uchar 128 0
r = fstat int fd st 0 128
m = or uint get st 16 shl uint get st 17 8
if or lt r 0 ne and m 0xf000 0x8000
c = fclose int fd
ret -1
end
n = rdfile int fd
c2 = fclose int fd
if lt n 0
ret -2
end
ret n
end
note ---- line scan with Python str.splitlines() terminators ----
fn lend s ulong n ulong to ulong
e = s
while lt e n bound 999999
b = get fbuf e
put gv TL 1
if or eq b 10 eq b 13
if eq b 13
if lt add e 1 n
if eq get fbuf add e 1 10
put gv TL 2
end
end
end
ret e
end
if or or eq b 11 eq b 12 and ge b 28 le b 30
ret e
end
if and eq b 0xc2 lt add e 1 n
if eq get fbuf add e 1 0x85
put gv TL 2
ret e
end
end
if and eq b 0xe2 lt add e 2 n
if eq get fbuf add e 1 0x80
c = get fbuf add e 2
if or eq c 0xa8 eq c 0xa9
put gv TL 3
ret e
end
end
end
e = add e 1
end
put gv TL 0
ret n
end
fn fpre s ulong e ulong t view uchar * to bool
k = len t
if lt sub e s k
ret false
end
for i ulong k
if ne get fbuf add s i get t i
ret false
end
end
ret true
end
fn feq s ulong e ulong t view uchar * to bool
if ne sub e s len t
ret false
end
ret fpre s e t
end
fn xeq s ulong e ulong o ulong k ulong to bool
if ne sub e s k
ret false
end
for i ulong k
if ne get fbuf add s i get xp add o i
ret false
end
end
ret true
end
note substring search of t in fbuf[s..e)
fn fsubc a ulong b ulong e ulong t view uchar * to bool
p = a
while lt p b bound 999999
if fpre p e t
ret true
end
p = add p 1
end
ret false
end
fn fsub s ulong e ulong t view uchar * to bool
m = len t
if lt sub e s m
ret false
end
lst = add sub e m 1
a = s
while lt a lst bound 999999
b = add a 900000
if gt b lst
b = lst
end
if fsubc a b e t
ret true
end
a = b
end
ret false
end
text tvirt "INFO virtualization=none"
text thyp "INFO cpu hypervisor flag=no"
text tfln "FAIL "
text tctl "NATIVE-X86 CONTROLS PASS (NATIVE"
text tnpass "NATIVE-X86 NATIVE PASS "
text tvnone "virtualization=none"
fn sline s ulong e ulong to void
put gv LS s
put gv LE e
if feq s e tvirt
put gv FVIRT 1
end
if feq s e thyp
put gv FHYP 1
end
if fpre s e tfln
put gv FFAIL 1
end
if xeq s e 0 get gv E1
put gv FCPU 1
end
if xeq s e 1048576 get gv E2
put gv FKERN 1
end
end
fn kline s ulong e ulong kind ulong to void
if eq kind 0
sline s e
else
if fpre s e tctl
put gv FCTRL 1
end
end
end
note one pass over at most 900000 lines from s; returns where it stopped
fn lchunk s ulong n ulong kind ulong to ulong
p = s
c = ulong 0
while and lt p n lt c 900000 bound 999999
e = lend p n
kline p e kind
p = add e get gv TL
if eq get gv TL 0
p = n
end
c = add c 1
end
ret p
end
fn lscan n ulong kind ulong to void
p = ulong 0
while lt p n bound 999999
p = lchunk p n kind
end
end

note ---- the checks, in the order and wording of the replaced Python checker ----
text tusage "usage: check_physical_receipt RECEIPT.json [LOGDIR]   (run from the repository root)\n"
text trdj "receipt is readable JSON ("
text terrno "open or read failed: errno "
text tbig "larger than 900000 bytes"
text tutf "not UTF-8 at byte "
text tbad "invalid JSON near byte "
text tobj "receipt is a JSON object"
fn rdfail t view uchar * v ulong hasv bool to int
put gv LN 0
lnt trdj
lnt t
if hasv
lndec v
end
lnb 41
emit false
ret finish
end
note returns -1 when the receipt parsed (node 0 is the top value), else the finish status
fn rdrcp to int
fd = fopen pth 0 get gv PL 0 0
if lt fd 0
ret rdfail terrno ulong neg fd true
end
n = ulong 0
go = true
while go bound 999999
r = read int fd rcp n sub 1048576 n
if lt r 0
c = fclose int fd
ret rdfail terrno ulong neg r true
end
if eq r 0
go = false
end
n = add n ulong r
if gt n RCAP
c2 = fclose int fd
ret rdfail tbig 0 false
end
end
c3 = fclose int fd
put gv RL n
u = utf8ok
if ge u 0
ret rdfail tutf ulong u true
end
put gv PO 0
ok = pval -1 0 KNONE 0 0
skipws
if or not ok ne get gv PO n
ret rdfail tbad get gv PO true
end
ret -1
end

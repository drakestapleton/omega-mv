text te10 "host-not-object"
text te11 "blank-fields"
text te12 "emulated-in-key"
text te13 "not-object"
note every case; the scratch copy must be fresh (setup) and the byte is appended last
fn allcases to bool
if not setup
ret false
end
g1 tg1 tr1
g1 tg2 tr2
g1 tg3 tr3
g1 tg4 taccj
g1 tg5 tr5
gedge te1
gedge te2
gedge te3
gedge te4
gedge te5
gedge te6
gedge te7
gedge te8
gedge te9
gedge te10
gedge te11
gedge te12
gedge te13
scratch
if not appendbyte
ret false
end
scratch2
ret true
end
note ---- checker mutants (negative controls) ----
text tsrc "tests/native/x86/check_physical_receipt.om"
text tm1a "if ne get pool add o i get hexo i\nok = false"
text tm1b "if ne get pool add o i get hexo i\nok = true"
text tm2a "chk tnoemu not sayemu"
text tm2b "chk tnoemu true"
text tm1 "m1.om"
text tm1x "m1"
text tm2 "m2.om"
text tm2x "m2"
fn atf p ulong t view uchar * n ulong to bool
if gt add p len t n
ret false
end
for i ulong len t
if ne get fbuf add p i get t i
ret false
end
end
ret true
end
fn putb o ulong b view uchar * to ulong
for i ulong len b
put eb add o i get b i
end
ret add o len b
end
note write the checker source with the one occurrence of a replaced by b to pa; false unless exactly one
fn subst a view uchar * b view uchar * n ulong to ulong
hits = ulong 0
o = ulong 0
p = ulong 0
while lt p n bound 999999
if atf p a n
hits = add hits 1
o = putb o b
p = add p len a
else
put eb o get fbuf p
o = add o 1
p = add p 1
end
end
if ne hits 1
ret 0
end
ret o
end
fn mutate a view uchar * b view uchar * to bool
pan = get gv PAN
put gv PBN pan
for i ulong pan
put pb i get pa i
end
r = rdinto tsrc
if lt r 0
ret false
end
o = subst a b ulong r
if eq o 0
ret false
end
for i ulong o
put fbuf i get eb i
end
pbn = get gv PBN
for i ulong pbn
put pa i get pb i
end
put gv PAN pbn
ret wrpa o
end

text tusage "usage: check_receipt_test OMC WORKDIR   (run from the repository root)\n"
text tpin "2c82480596bbdc50cda9626866209ef662d5834f278f839ff4ce0250c495029f"
text twrong "CHECK-RECEIPT-TEST FAIL omc sha256 is not the seeded omega-mv e5b32567 compiler 2c824805\n"
text tsetup "CHECK-RECEIPT-TEST FAIL setup: "
text tcpr "cpr"
text tccomp "compiling the checker"
text tmcomp "building a mutant"
text tscr "copying the scratch fixtures"
text tnc "FAIL mutant not caught: "
text tmc "MUTANT "
text tmby " caught by "
text tmcases " failing cases"
text tpass "CHECK-RECEIPT-TEST PASS (18 golden outputs, 7 scratch cases, 2 of 2 checker mutants caught)\n"
text tfail "CHECK-RECEIPT-TEST FAIL\n"
fn setupfail t view uchar * to int
say tsetup
sayln t
ret 2
end
fn rdarg i ulong which ulong to bool
if eq which 0
r = argread i omc 0 4096
put gv OMN ulong r
ret gt r 0
end
r2 = argread i wd 0 4096
put gv WDN ulong r2
ret gt r2 0
end
fn omcok to bool
put gv PAN 0
k = get gv OMN
for i ulong k
pab get omc i
end
n = rdpa
if lt n 0
ret false
end
shafbuf ulong n
for i ulong 64
if ne get hexo i get tpin i
ret false
end
end
ret true
end
note compile pb into WORKDIR/bin and make it the checker under test
fn build bin view uchar * to bool
wpath bin
if not compile
ret false
end
setcb
ret true
end
fn mutant src view uchar * bin view uchar * which ulong to int
wpath src
ok = false
if eq which 1
ok = mutate tm1a tm1b
else
ok = mutate tm2a tm2b
end
if not ok
ret 2
end
pbcopy
if not build bin
ret 2
end
put gv MUT 1
put gv BAD 0
if not allcases
ret 2
end
put gv MUT 0
if gt get gv BAD 0
say tmc
say src
say tmby
sayn get gv BAD
sayln tmcases
ret 1
end
say tnc
sayln src
ret 0
end
fn main to int
if ne argcnt 3
w = write 2 tusage 0 len tusage
ret 2
end
if not and rdarg 1 0 rdarg 2 1
w2 = write 2 tusage 0 len tusage
ret 2
end
if not omcok
say twrong
ret 65
end
put gv PAN 0
pat tsrc
pbcopy
if not build tcpr
ret setupfail tccomp
end
put gv BAD 0
if not allcases
ret setupfail tscr
end
cb1 = get gv BAD
m1 = mutant tm1 tm1x 1
m2 = mutant tm2 tm2x 2
if or eq m1 2 eq m2 2
ret setupfail tmcomp
end
if and eq cb1 0 and eq m1 1 eq m2 1
say tpass
ret 0
end
say tfail
ret 1
end

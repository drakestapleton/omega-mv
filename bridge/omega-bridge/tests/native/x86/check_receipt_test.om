om2
note check_receipt_test.om: the gate for tests/native/x86/check_physical_receipt.om (DRA-104).
note usage: check_receipt_test OMC WORKDIR, run from the repository root. OMC must be the seeded omc
note (omega-mv e5b32567, sha256 2c824805...); WORKDIR is an empty scratch directory this program fills.
note It compiles the checker with OMC, then runs it on every committed fixture and compares the whole
note output with tests/native/x86/receipt-fixtures/expected/NAME.out, which the replaced Python checker
note (git 6d5c0ddb, ORACLE, not shipped) produced; then runs the cases that need a scratch copy (one log
note byte appended, renamed receipt, missing receipt, argument counts) by exit status and one line.
note Negative controls: two mutants of the checker (the log sha256 comparison always passing, the
note EMULATED scan switched off) are compiled and must each fail at least one case.
note Output: CHECK-RECEIPT-TEST PASS (exit 0) or FAIL lines and CHECK-RECEIPT-TEST FAIL (exit 1);
note a wrong compiler hash exits 65, a usage or setup error exits 2.
global fbuf uchar 4194304
global hexo uchar 64
global eb uchar 1048576
global ob uchar 1048576
global pk uchar 4096
global wd uchar 4096
global omc uchar 4096
global pa uchar 4096
global pb uchar 4096
global cb uchar 4096
global gv ulong 16
const WDN ulong 0
const OMN ulong 1
const PKN ulong 2
const PAN ulong 3
const PBN ulong 4
const BAD ulong 5
const CAUGHT ulong 6
const CASES ulong 7
const FCAP ulong 4194304
const CBN ulong 8
const MUT ulong 9
const ON ulong 10
note SHA-256 (FIPS 180-4) of fbuf[0..n), digest as 64 lowercase hex bytes in hexo[0..64).
note The schedule, round and padding code is copied from omega-mv e5b32567 om/sha256/sha256-om2.om
note (Apache-2.0), changed only to read the message from the global fbuf instead of an unsized view.
fn kinit k edit uint 64 to void
put k 0 0x428a2f98
put k 1 0x71374491
put k 2 0xb5c0fbcf
put k 3 0xe9b5dba5
put k 4 0x3956c25b
put k 5 0x59f111f1
put k 6 0x923f82a4
put k 7 0xab1c5ed5
put k 8 0xd807aa98
put k 9 0x12835b01
put k 10 0x243185be
put k 11 0x550c7dc3
put k 12 0x72be5d74
put k 13 0x80deb1fe
put k 14 0x9bdc06a7
put k 15 0xc19bf174
put k 16 0xe49b69c1
put k 17 0xefbe4786
put k 18 0x0fc19dc6
put k 19 0x240ca1cc
put k 20 0x2de92c6f
put k 21 0x4a7484aa
put k 22 0x5cb0a9dc
put k 23 0x76f988da
put k 24 0x983e5152
put k 25 0xa831c66d
put k 26 0xb00327c8
put k 27 0xbf597fc7
put k 28 0xc6e00bf3
put k 29 0xd5a79147
put k 30 0x06ca6351
put k 31 0x14292967
put k 32 0x27b70a85
put k 33 0x2e1b2138
put k 34 0x4d2c6dfc
put k 35 0x53380d13
put k 36 0x650a7354
put k 37 0x766a0abb
put k 38 0x81c2c92e
put k 39 0x92722c85
put k 40 0xa2bfe8a1
put k 41 0xa81a664b
put k 42 0xc24b8b70
put k 43 0xc76c51a3
put k 44 0xd192e819
put k 45 0xd6990624
put k 46 0xf40e3585
put k 47 0x106aa070
put k 48 0x19a4c116
put k 49 0x1e376c08
put k 50 0x2748774c
put k 51 0x34b0bcb5
put k 52 0x391c0cb3
put k 53 0x4ed8aa4a
put k 54 0x5b9cca4f
put k 55 0x682e6ff3
put k 56 0x748f82ee
put k 57 0x78a5636f
put k 58 0x84c87814
put k 59 0x8cc70208
put k 60 0x90befffa
put k 61 0xa4506ceb
put k 62 0xbef9a3f7
put k 63 0xc67178f2
end
fn iv s edit uint 8 to void
put s 0 0x6a09e667
put s 1 0xbb67ae85
put s 2 0x3c6ef372
put s 3 0xa54ff53a
put s 4 0x510e527f
put s 5 0x9b05688c
put s 6 0x1f83d9ab
put s 7 0x5be0cd19
end
fn sched w edit uint 64 o ulong to void
q = ulong 0
x = uint 0
y = uint 0
for i ulong 16 unroll
q = add o mul i 4
x = uint get fbuf q
x = or shl x 8 uint get fbuf add q 1
x = or shl x 8 uint get fbuf add q 2
put w i or shl x 8 uint get fbuf add q 3
end
for i ulong 48 unroll
x = get w add i 1
y = get w add i 14
x = add add get w i get w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
put w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
end
end
fn schedp w edit uint 64 p view uchar 128 o ulong to void
q = ulong 0
x = uint 0
y = uint 0
for i ulong 16 unroll
q = add o mul i 4
x = uint get p q
x = or shl x 8 uint get p add q 1
x = or shl x 8 uint get p add q 2
put w i or shl x 8 uint get p add q 3
end
for i ulong 48 unroll
x = get w add i 1
y = get w add i 14
x = add add get w i get w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
put w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
end
end
fn rounds s edit uint 8 w view uint 64 kt view uint 64 to void
a = get s 0
b = get s 1
c = get s 2
d = get s 3
e = get s 4
f = get s 5
g = get s 6
h = get s 7
t = uint 0
for i ulong 64 unroll
h = add h get kt i
h = add h get w i
t = xor rotr e 6 rotr e 11
t = xor t rotr e 25
h = add h t
h = add h xor g and e xor f g
d = add d h
t = xor rotr a 2 rotr a 13
t = xor t rotr a 22
h = add h t
t = and c or a b
h = add h or and a b t
t = h
h = g
g = f
f = e
e = d
d = c
c = b
b = a
a = t
end
put s 0 add get s 0 a
put s 1 add get s 1 b
put s 2 add get s 2 c
put s 3 add get s 3 d
put s 4 add get s 4 e
put s 5 add get s 5 f
put s 6 add get s 6 g
put s 7 add get s 7 h
end
text hexd "0123456789abcdef"
fn hexout s view uint 8 to void
for i ulong 8
v = get s i
for j2 ulong 8
sh = sub uint 28 mul uint j2 4
d = ulong and shr v sh 15
q = add mul i 8 j2
put hexo q get hexd d
end
end
end
fn tailblk s edit uint 8 w edit uint 64 kt view uint 64 n ulong to void
p = new uchar 128 0
off = shl shr n 6 6
k = sub n off
for i ulong k
put p i get fbuf add off i
end
put p k 0x80
e = ulong 64
if ge k 56
e = 128
end
bits = shl n 3
for i ulong 8 unroll
put p sub e add i 1 uchar and shr bits mul i 8 0xff
end
schedp w view p 0
rounds s view w kt
if eq e 128
schedp w view p 64
rounds s view w kt
end
end
fn shafbuf n ulong to void
s = new uint 8 0
w = new uint 64 0
kt = new uint 64 0
kinit kt
iv s
nbl = shr n 6
j = ulong 0
while lt j nbl bound 999999
sched w shl j 6
rounds s view w view kt
j = add j 1
end
tailblk s w view kt n
hexout view s
end

text tline "\n"
fn say t view uchar * to void
w = write 1 t 0 len t
end
fn sayln t view uchar * to void
say t
say tline
end
note ---- path builder: pa = WORKDIR "/" name ----
fn pab b uchar to void
k = get gv PAN
put pa k b
put gv PAN add k 1
end
fn pat t view uchar * to void
for i ulong len t
pab get t i
end
end
fn wpath t view uchar * to void
put gv PAN 0
k = get gv WDN
for i ulong k
pab get wd i
end
pab 47
pat t
end
fn pbcopy to void
k = get gv PAN
for i ulong k
put pb i get pa i
end
put gv PBN k
end
note ---- packed argument list in pk: u16 count, then u16 length and bytes per argument ----
fn pkstart to void
put pk 0 0
put pk 1 0
put gv PKN 2
end
fn pkb b uchar to void
k = get gv PKN
put pk k b
put gv PKN add k 1
end
fn pkcnt to void
c = add ulong get pk 0 shl ulong get pk 1 8
c = add c 1
put pk 0 uchar and c 255
put pk 1 uchar shr c 8
end
fn pkt t view uchar * to void
pkcnt
n = len t
pkb uchar and n 255
pkb uchar shr n 8
for i ulong n
pkb get t i
end
end
fn pkpa to void
pkcnt
n = get gv PAN
pkb uchar and n 255
pkb uchar shr n 8
for i ulong n
pkb get pa i
end
end
note ---- files ----
fn rdinto t view uchar * to long
fd = fopen t 0 len t 0 0
if lt fd 0
ret fd
end
n = ulong 0
go = true
while go bound 999999
r = read int fd fbuf n sub FCAP n
if le r 0
go = false
else
n = add n ulong r
end
if eq n FCAP
go = false
end
end
c = fclose int fd
ret long n
end
fn rdpa to long
fd = fopen pa 0 get gv PAN 0 0
if lt fd 0
ret fd
end
n = ulong 0
go = true
while go bound 999999
r = read int fd fbuf n sub FCAP n
if le r 0
go = false
else
n = add n ulong r
end
if eq n FCAP
go = false
end
end
c = fclose int fd
ret long n
end
fn wrpa n ulong to bool
fd = fopen pa 0 get gv PAN 577 420
if lt fd 0
ret false
end
o = ulong 0
while lt o n bound 999999
w = write int fd fbuf o sub n o
if le w 0
c = fclose int fd
ret false
end
o = add o ulong w
end
c2 = fclose int fd
ret true
end
note copy file t (relative to the repository root) to pa
fn cpto t view uchar * to bool
n = rdinto t
if lt n 0
ret false
end
ret wrpa ulong n
end
note ---- child processes: stdin, stdout and stderr redirected, exit status returned ----
fn waitst pid long to long
st = new uchar 8 0
r = waitpid int pid st 0 8 0
if lt r 0
ret -1
end
s = ulong get st 0
if ne and s 127 0
ret long add 1000 and s 127
end
ret long get st 1
end
note run pk with stdin from pb (or /dev/null when PBN is 0) and stdout to pa; stderr to WORKDIR/err
text tnull "/dev/null"
text terr "err"
fn spawn to long
pid = fork
if lt pid 0
ret -1
end
if eq pid 0
i = int 0
if eq get gv PBN 0
i = int fopen tnull 0 len tnull 0 0
else
i = int fopen pb 0 get gv PBN 0 0
end
o = int fopen pa 0 get gv PAN 577 493
if or lt i 0 lt o 0
exit 120
end
d0 = dupfd i 0 0
d1 = dupfd o 1 0
wpath terr
e = int fopen pa 0 get gv PAN 577 420
d2 = dupfd e 2 0
x = execprog pk 0 get gv PKN
exit 121
end
ret waitst pid
end

fn pkbuf which ulong to void
pkcnt
n = get gv OMN
if eq which 1
n = get gv CBN
end
pkb uchar and n 255
pkb uchar shr n 8
for i ulong n
if eq which 1
pkb get cb i
else
pkb get omc i
end
end
end
note compile the source at pb into pa with the seeded compiler
fn compile to bool
pkstart
pkbuf 0
rc = spawn
ret eq rc 0
end
fn setcb to void
k = get gv PAN
for i ulong k
put cb i get pa i
end
put gv CBN k
end
note ---- one case: the checker's stdout is read into ob (ON bytes) ----
text tout "out"
fn runchk to long
put gv PBN 0
wpath tout
rc = spawn
n = rdpa
put gv ON 0
if ge n 0
for i ulong ulong n
put ob i get fbuf i
end
put gv ON ulong n
end
ret rc
end
text tfcase "FAIL case "
text tgotrc " exit "
fn bad name view uchar * rc long to void
put gv BAD add get gv BAD 1
if eq get gv MUT 0
say tfcase
say name
say tgotrc
v = ulong rc
if lt rc 0
v = 999
end
sayn v
say tline
end
end
fn sayn v ulong to void
d = new uchar 24 0
x = v
k = ulong 0
go = true
while go bound 30
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
go = gt x 0
end
while gt k 0 bound 30
k = sub k 1
w = write 1 d k 1
end
end
fn hasob t view uchar * to bool
n = get gv ON
m = len t
if lt n m
ret false
end
s = ulong 0
while le s sub n m bound 999999
ok = true
for i ulong m
if ok
if ne get ob add s i get t i
ok = false
end
end
end
if ok
ret true
end
s = add s 1
end
ret false
end
text tacc "PHYSICAL-RECEIPT ACCEPTED"
text texp "tests/native/x86/receipt-fixtures/expected/"
text tdotout ".out"
note compare the output with the golden file; its verdict line sets the expected exit status
fn golden name view uchar * to void
rc = runchk
put gv PAN 0
pat texp
pat name
pat tdotout
n = rdpa
if lt n 0
bad name -2
ret
end
k = ulong n
ok = eq k get gv ON
for i ulong k
put eb i get fbuf i
end
if ok
for i ulong k
if ne get eb i get ob i
ok = false
end
end
end
want = long 1
put gv ON k
for i ulong k
put ob i get eb i
end
if hasob tacc
want = 0
end
if or not ok ne rc want
bad name rc
end
end
fn pkchk to void
pkstart
pkbuf 1
end
text tfx "tests/native/x86/receipt-fixtures/"
text tev "evidence/"
text taccl "tests/native/x86/receipt-fixtures/accept/native-x86-physical-be8c5130"
fn g1 name view uchar * r view uchar * to void
pkchk
pkt r
golden name
end
text tedge "tests/native/x86/receipt-fixtures/edge/"
text tpj "/native-x86-physical-be8c5130.json"
text tedp "edge-"
fn gedge e view uchar * to void
pkchk
put gv PAN 0
pat tedge
pat e
pat tpj
pkpa
pkt taccl
put gv PAN 0
pat tedp
pat e
k = get gv PAN
for i ulong k
put pb i get pa i
end
put gv PBN k
gedge2 k
end
fn gedge2 k ulong to void
nm = new uchar 4096 0
for i ulong k
put nm i get pb i
end
golden part nm 0 k
end

note ---- scratch cases ----
text tapp "app"
text tappd "app/native-x86-physical-be8c5130"
text tappj "app/native-x86-physical-be8c5130.json"
text tappr "app/receipt.json"
text tnone "none.json"

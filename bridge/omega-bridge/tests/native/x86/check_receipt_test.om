fn cplog t view uchar * to bool
put gv PAN 0
pat taccl
pat tsl
pat t
n = rdpa
if lt n 0
ret false
end
wpath tappd
pat tsl
pat t
ret wrpa ulong n
end
fn expect name view uchar * want long line view uchar * to void
rc = runchk
if or ne rc want not hasob line
bad name rc
end
end
fn setup to bool
wpath tapp
m = makedir pa 0 get gv PAN 493
wpath tappd
m2 = makedir pa 0 get gv PAN 493
wpath tappj
if not cpto taccj
ret false
end
wpath tappr
if not cpto taccj
ret false
end
ok = and and cplog tl0 cplog tl1 and cplog tl2 cplog tl3
ret ok
end
fn pkw t view uchar * to void
wpath t
pkpa
end
fn appendbyte to bool
wpath tappd
pat tsl
pat tl3
n = rdpa
if lt n 0
ret false
end
put fbuf ulong n 120
ret wrpa add ulong n 1
end
fn scratch to void
pkchk
pkw tappj
expect tcopy 0 tacc
pkchk
pkw tappr
pkw tappd
expect tren 1 tvren
pkchk
pkw tnone
expect tmiss 1 tvmiss
pkchk
pkt tinvp
expect tinv 1 tvinv
pkchk
rc = runchk
if or ne rc 2 ne get gv ON 0
bad tu0 rc
end
pkchk
pkt tinvp
pkt tinvp
pkt tinvp
rc2 = runchk
if or ne rc2 2 ne get gv ON 0
bad tu3 rc2
end
end
fn scratch2 to void
pkchk
pkw tappj
expect tappc 1 tvapp
end
text tg1 "committed-be8c5130"
text tr1 "evidence/native-x86-be8c5130.json"
text tg2 "emulated-receipt"
text tr2 "evidence/native-x86-physical-checker/emulated-receipt.json"

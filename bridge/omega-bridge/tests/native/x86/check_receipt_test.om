text tu3 "usage-three-arguments"
text tvren "PHYSICAL-RECEIPT REJECTED (1 failed: file name carries the x86 pin prefix)\n"
text tvapp "PHYSICAL-RECEIPT REJECTED (1 failed: log x86-native-mut.log sha256 matches receipt)\n"

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note OM-3 function-mode mapping context run (omega-mv#1008 section 1). CPU memory only:
note anonymous maps, a PROT_NONE reservation and a memfd. No device, no GPU.
note Export names match the existing tests/native/v2/dev callers (context.c, cleanup.c).
om2
export fn anon to long
ret mapnew neg int 1 0 4096 3 34
end
export fn reserve addr ulong bytes ulong to long
ret maphold addr bytes
end
export fn attach h long fd long to long
ret mapbind h int fd 0 3
end
export fn address h long to ulong
ret mapaddr h
end
export fn drop h long to long
ret mapdrop h
end
export fn publish h long v ulong to long
p = new uchar 16 7
w = mapwrite h 16 p 0 16
cpufence
w = mapset h 8 8 v
w = mapset h 0 4 1
ret w
end
export fn fetch h long to long
p = new uchar 16 0
n = mapread h 16 p 0 16
v = mapget h 8 8
ret add long v long get p 15
end
export fn rd h long to ulong
ret mapget h 0 4
end
export fn store h long to long
ret mapset h 0 4 1
end

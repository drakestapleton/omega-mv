note Fake-device only: no NVIDIA device is opened. Linux ABI constants are checked against libc in dcall.c.
om2
export fn nread fd long to long
b = new uchar 4 0
r = devctl int fd uint 21531 b 0 4
if lt r 0
ret r
end
ret long or or or uint get b 0 shl uint get b 1 8 shl uint get b 2 16 shl uint get b 3 24
end
export fn ctl fd long to long
b = new uchar 48 0
ret devctl int fd uint 3224389163 b 0 48
end
export fn call fd long to long
h = new uchar 32 0
p = new uchar 16 0
ret devcall int fd uint 3223340587 h 0 32 p 0 16
end
export fn uvm fd long to long
b = new uchar 8 0
ret uvmctl int fd uint 75 b 0 8
end
export fn mapping fd long to long
ret mapnew int fd 0 4096 3 1
end
export fn anon to long
ret mapnew neg int 1 0 4096 3 34
end
export fn address h long to ulong
ret mapaddr h
end
export fn drop h long to long
ret mapdrop h
end
export fn publish h long v ulong to long
p = new uchar 16 7
w = mapwrite h 16 p 0 16
cpufence
w = mapset h 8 8 v
w = mapset h 0 4 1
ret w
end
export fn fetch h long to long
p = new uchar 16 0
n = mapread h 16 p 0 16
v = mapget h 8 8
ret add long v long get p 15
end
export fn rd h long to ulong
ret mapget h 0 4
end
export fn mono to long
ret monons
end
export fn wall to long
ret realns
end
export fn pause n long to long
ret sleepns n
end
export fn reserve addr ulong bytes ulong to long
ret maphold addr bytes
end
export fn attach h long fd long to long
ret mapbind h int fd 0 3
end

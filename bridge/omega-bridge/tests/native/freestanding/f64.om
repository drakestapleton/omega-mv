note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
fn average a f64 b f64 to f64
two = f64 2.0e+0
ret div add a b two
end
export fn fbits mode ulong abits ulong bbits ulong to ulong
a = bitcast f64 abits
b = bitcast f64 bbits
if eq mode 0
ret bitcast ulong add a b
end
if eq mode 1
ret bitcast ulong div a b
end
if eq mode 2
ret bitcast ulong neg a
end
ret bitcast ulong average a b
end

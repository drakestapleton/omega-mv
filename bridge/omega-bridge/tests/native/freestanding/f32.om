om2
fn mean32 a f32 b f32 to f32
two = f32 2.0e+0f32
ret div add a b two
end
export fn f32bits mode ulong abits ulong bbits ulong cbits ulong to ulong
a = bitcast f32 uint abits
b = bitcast f32 uint bbits
c = bitcast f32 uint cbits
if eq mode 0
ret ulong bitcast uint a
end
if eq mode 1
ret ulong bitcast uint add a b
end
if eq mode 2
ret ulong bitcast uint div a b
end
if eq mode 3
ret ulong bitcast uint neg a
end
if eq mode 4
ret ulong bitcast uint mean32 a b
end
if eq mode 5
p = mul a b
ret ulong bitcast uint add p c
end
flags = ulong 0
if eq a b
flags = or flags 1
end
if ne a b
flags = or flags 2
end
if lt a b
flags = or flags 4
end
if le a b
flags = or flags 8
end
if gt a b
flags = or flags 16
end
if ge a b
flags = or flags 32
end
ret flags
end

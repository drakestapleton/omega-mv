note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
note pathlen: bounded borrowed-byte length. Never reads past len a. The first 0 ends the scan.
note An empty view (len 0), including a NULL pointer, is length 0. A nonempty NULL is refused by the binding, not here.
export fn pathlen a view uchar * to ulong
ensures le result len a
n = len a
for i ulong n
b = get a i
if eq b 0
ret i
end
end
ret n
end

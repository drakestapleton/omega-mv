fn tbpos x ulong to void
i = ulong 0
e = ulong 0
c = true
while c bound 999999
if ge i len tb
c = false
else
if eq e x
c = false
else
if eq get tb i 10
e = add e 1
end
i = add i 1
end
end
end
put kp 0 i
j = i
d = true
while d bound 999999
if ge j len tb
d = false
else
if eq get tb j 10
d = false
else
j = add j 1
end
end
end
put kp 1 sub j i
end
fn sbclr to void
put sn 0 0
end
fn sbc b uchar to void
n = get sn 0
put sb n b
put sn 0 add n 1
end
fn sbk x ulong to void
tbpos x
s = get kp 0
m = get kp 1
for i ulong m
sbc get tb add s i
end
end
note sbnumw v wd: v in decimal, zero-padded to at least wd digits
fn sbnumw v ulong wd ulong to void
d = new uchar 24 0
n = ulong 0
x = v
c = true
while c bound 30
put d n uchar add 48 rem x 10
n = add n 1
x = div x 10
if and eq x 0 ge n wd
c = false
end
end
while gt n 0 bound 30
n = sub n 1
sbc get d n
end
end
fn sbnum v ulong to void
sbnumw v 1
end
note out fd: write sb and a newline to fd, then clear sb
fn out fd int to void
sbc 10
r = write fd sb 0 get sn 0
sbclr
end
note clgone: the closer is gone after a window was opened here, so nothing will close it: say so,
note naming the window, on stderr and at the end of window.txt (review N2)
fn clgone to void
sbclr
sbs sOut
sbk kWinTxt
e = fopen sb 0 get sn 0 1089 438
sbclr
for i ulong 53
sbc get tcg1 i
end
sbs sWid
for j ulong 70
sbc get tcg2 j
end
sbc 10
if ge e 0
x = write int e sb 0 get sn 0
y = fclose int e
end
r = write 2 sb 0 get sn 0
sbclr
end
note bail rc: every exit after the closer started goes through this. It closes the ends of the
note open's pipes it still holds, writes N (a window was opened here: close it now) or X (nothing
note to close) to the closer unless the closer has already exited (then there is no reader and a
note write would end this program by SIGPIPE), closes both pipe ends, waits for the closer, exits rc
fn bail rc ulong to void
if eq get g gHasCl 1
if ne get g gClI kNoFd
z1 = fclose int get g gClI
put g gClI kNoFd
end
if ne get g gClB kNoFd
z2 = fclose int get g gClB
put g gClB kNoFd
end
put one 0 88
if eq get g gOpened 1
put one 0 78
end
d = waitpid int get g gClPid st4 0 4 1
if eq d 0
wr = write int get g gClW one 0 1
end
if ne d 0
if eq get g gOpened 1
clgone
end
end
z = fclose int get g gClW
y = fclose int get g gClH
if eq d 0
r = waitpid int get g gClPid st4 0 4 0
end
put g gHasCl 0
put g gOpened 0
end
exit int rc
end
fn diek x ulong rc ulong to void
sbclr
sbk x
out 2
bail rc
end
note svset s: move sb into string slot s (4095 bytes at most: the Linux path limit)
fn svset s ulong to void
n = get sn 0
if gt n 4095
diek kTooLong 2
end
o = mul s 4096
for i ulong n
put sv add o i get sb i
end
put sl s n
sbclr
end
fn sbs s ulong to void
o = mul s 4096
for i ulong get sl s
sbc get sv add o i
end
end
fn svk s ulong x ulong to void
sbclr
sbk x
svset s
end
fn sbeqk x ulong to bool
tbpos x
a = get kp 0
m = get kp 1
if ne m get sn 0
ret false
end
for i ulong m
if ne get sb i get tb add a i
ret false
end
end
ret true
end
note execprog packet: u16 count, then records of u16 length and bytes
fn pkbeg to void
put pn 0 2
put pn 1 0
end
fn pkroom n ulong to void
if or gt add add get pn 0 2 n 65536 ge get pn 1 1024
diek kPkFull 3
end
end
fn pkrec to void
n = get sn 0
pkroom n
p = get pn 0
put pk p uchar and n 255
put pk add p 1 uchar shr n 8
for i ulong n
put pk add add p 2 i get sb i
end
put pn 0 add add p 2 n
put pn 1 add get pn 1 1
sbclr
end
fn pkeb n ulong to void
pkroom n
p = get pn 0
put pk p uchar and n 255
put pk add p 1 uchar shr n 8
for i ulong n
put pk add add p 2 i get eb i
end
put pn 0 add add p 2 n
put pn 1 add get pn 1 1
end
fn pkk x ulong to void
sbk x
pkrec
end
fn pks s ulong to void
sbs s
pkrec
end
fn pkend to void
c = get pn 1
put pk 0 uchar and c 255
put pk 1 uchar shr c 8
end
note envok l: the entry in eb (l bytes) is NAME=VALUE with a non-empty NAME
fn envok l ulong to bool
if eq l 0
ret false
end
if eq get eb 0 61
ret false
end
for i ulong l
if eq get eb i 61
ret true
end
end
ret false
end
note pkhead: /usr/bin/env -i -- <every NAME=VALUE environment entry>; the command follows
fn pkhead to void
pkbeg
pkk kEnv
pkk kDashI
pkk kDD
c = ulong envcnt
for i ulong c
l = envread i eb 0 65536
if lt l 0
diek kEnvLong 3
end
if envok ulong l
pkeb ulong l
end
end
end
note step arguments: records like the packet's, in ar
fn arbeg to void
put arn 0 0
put arn 1 0
end
fn arrec to void
n = get sn 0
p = get arn 0
if gt add add p 2 n 65536
diek kPkFull 3
end
put ar p uchar and n 255
put ar add p 1 uchar shr n 8
for i ulong n
put ar add add p 2 i get sb i
end
put arn 0 add add p 2 n
put arn 1 add get arn 1 1
sbclr
end
fn ark x ulong to void
sbk x
arrec
end
fn ars s ulong to void
sbs s
arrec
end
note arjoin: append the step arguments to sb, separated by spaces
fn arjoin to void
p = ulong 0
for r ulong get arn 1
if gt r 0
sbc 32
end
n = or ulong get ar p shl ulong get ar add p 1 8
for i ulong n
sbc get ar add add p 2 i
end
p = add add p 2 n
end
end
fn pkar to void
p = ulong 0
for r ulong get arn 1
n = or ulong get ar p shl ulong get ar add p 1 8
for i ulong n
sbc get ar add add p 2 i
end
pkrec
p = add add p 2 n
end
end
note envpre a m: the entry in eb starts with the m table bytes at a
fn envpre a ulong m ulong to bool
for j ulong m
if ne get eb j get tb add a j
ret false
end
end
ret true
end
note envval x: when NAME= (table entry x) is in the environment, the entry stays in eb and g
note gEvo/gEvl hold the offset and the length of its value (envscan has refused longer entries)
fn envval x ulong to bool
tbpos x
a = get kp 0
m = get kp 1
c = ulong envcnt
for i ulong c
l = envread i eb 0 65536
if ge l long m
if envpre a m
put g gEvo m
put g gEvl sub ulong l m
ret true
end
end
end
ret false
end
note outev fd: write sb and then the value envval found to fd (no length limit), clear sb
fn outev fd int to void
r = write fd sb 0 get sn 0
q = write fd eb get g gEvo get g gEvl
sbclr
end
note envget x s: when NAME= (table entry x) is in the environment, its value goes to slot s
fn envget x ulong s ulong to bool
if envval x
sbclr
o = get g gEvo
for q ulong get g gEvl
sbc get eb add o q
end
svset s
ret true
end
ret false
end
note envscan: refuse at once (exit 3) when an environment entry does not fit one execprog record;
note otherwise it would be skipped when a value is looked up and refused only at the first child
fn envscan to void
c = ulong envcnt
for i ulong c
l = envread i eb 0 65536
if lt l 0
diek kEnvLong 3
end
end
end
note envset x s: ${NAME:-} is non-empty, value in slot s
fn envset x ulong s ulong to bool
if envget x s
ret gt get sl s 0
end
ret false
end
note fexist: [ -e "$sb" ] (sb cleared)
fn fexist to bool
n = get sn 0
if or eq n 0 gt n 4095
sbclr
ret false
end
r = faccess sb 0 n 0
sbclr
ret eq r 0
end
fn fdat i ulong to int
v = uint 0
for j ulong 4
v = or v shl uint get ends add i j uint mul j 8
end
ret int v
end
note spawn o e: fork and exec the packet in pk; stdout to fd o and stderr to fd e when >= 0
fn spawn o int e int to long
p = fork
if ne p 0
ret p
end
if ge o 0
a = dupfd o 1 0
end
if ge e 0
b = dupfd e 2 0
end
if eq get g gHasCl 1
c = dupfd int get g gClH 0 0
end
x = execprog pk 0 get pn 0
sbclr
sbk kCannotExec
out 2
exit 127
end
note reap p: the shell's $? for the child: its exit code, or 128 + signal
fn reap p long to ulong
if lt p 0
ret 127
end
r = waitpid int p st4 0 4 0
if lt r 0
ret 127
end
s = and get st4 0 127
if ne s 0
ret add 128 ulong s
end
ret ulong get st4 1
end
fn devnull to int
tbpos kDevNull
f = fopen tb get kp 0 get kp 1 1 0
ret int f
end
note cbadd q: count the newlines of fb[0, q) into gNl and keep them in cb while there is room;
note a byte past the room sets gCo, and sbcap/sbcapall then refuse
fn cbadd q ulong to void
t = get g gCn
nl = get g gNl
for i ulong q
c = get fb i
if eq c 10
nl = add nl 1
end
if lt t 65536
put cb t c
t = add t 1
else
put g gCo 1
end
end
put g gCn t
put g gNl nl
end
note capture e: run the packet with stdout into cb (first 65536 bytes kept, gCo set past them;
note gNl newlines counted over the whole output) and stderr to fd e (< 0: inherited)
fn capture e int to ulong
put g gCn 0
put g gNl 0
put g gCo 0
r = pipefds ends 0 8 0
if ne r 0
ret 127
end
rf = fdat 0
wf = fdat 4
p = spawn wf e
r = fclose wf
go = true
while go bound 9223372036854775807
q = read rf fb 0 65536
if le q 0
go = false
else
cbadd ulong q
end
end
r = fclose rf
ret reap p
end
note sbcap: append the captured output without its trailing newlines, as $(...) does
fn sbcap to void
if eq get g gCo 1
diek kCapBig 3
end
t = get g gCn
c = true
while c bound 65537
if eq t 0
c = false
else
if ne get cb sub t 1 10
c = false
else
t = sub t 1
end
end
end
for i ulong t
sbc get cb i
end
end
note sbcapall: append the captured output as it is (a later word ends the $(...))
fn sbcapall to void
if eq get g gCo 1
diek kCapBig 3
end
for i ulong get g gCn
sbc get cb i
end
end
note time: civil date from days since 1970-01-01 (Hinnant's algorithm)
fn civ to void
a = get tm 0
r = rem a 86400
put tm 4 div r 3600
put tm 5 div rem r 3600 60
put tm 6 rem r 60
a = add div a 86400 719468
era = div a 146097
doe = sub a mul era 146097
t = sub doe div doe 1460
t = add t div doe 36524
t = sub t div doe 146096
a = div t 365
y = add a mul era 400
t = add mul 365 a div a 4
doe = sub doe sub t div a 100
mp = div add mul 5 doe 2 153
t = div add mul 153 mp 2 5
put tm 3 add sub doe t 1
m = add mp 3
if ge mp 10
m = sub mp 9
end
if le m 2
y = add y 1
end
put tm 1 y
put tm 2 m
end
note sbtime: date -u +%Y-%m-%dT%H:%M:%SZ
fn sbtime to void
put tm 0 div ulong realns 1000000000
civ
sbnum get tm 1
sbc 45
sbnumw get tm 2 2
sbc 45
sbnumw get tm 3 2
sbc 84
sbnumw get tm 4 2
sbc 58
sbnumw get tm 5 2
sbc 58
sbnumw get tm 6 2
sbc 90
end
note SHA-256 (FIPS 180-4), from aien-architecture-mv tools/zero-legacy/sha256.om, streamed
fn initk to void
put k 0 1116352408
put k 1 1899447441
put k 2 3049323471
put k 3 3921009573
put k 4 961987163
put k 5 1508970993
put k 6 2453635748
put k 7 2870763221
put k 8 3624381080
put k 9 310598401
put k 10 607225278
put k 11 1426881987
put k 12 1925078388
put k 13 2162078206
put k 14 2614888103
put k 15 3248222580
put k 16 3835390401
put k 17 4022224774
put k 18 264347078
put k 19 604807628
put k 20 770255983
put k 21 1249150122
put k 22 1555081692
put k 23 1996064986
put k 24 2554220882
put k 25 2821834349
put k 26 2952996808
put k 27 3210313671
put k 28 3336571891
put k 29 3584528711
put k 30 113926993
put k 31 338241895
put k 32 666307205
put k 33 773529912
put k 34 1294757372
put k 35 1396182291
put k 36 1695183700
put k 37 1986661051
put k 38 2177026350
put k 39 2456956037
put k 40 2730485921
put k 41 2820302411
put k 42 3259730800
put k 43 3345764771
put k 44 3516065817
put k 45 3600352804
put k 46 4094571909
put k 47 275423344
put k 48 430227734
put k 49 506948616
put k 50 659060556
put k 51 883997877
put k 52 958139571
put k 53 1322822218
put k 54 1537002063
put k 55 1747873779
put k 56 1955562222
put k 57 2024104815
put k 58 2227730452
put k 59 2361852424
put k 60 2428436474
put k 61 2756734187
put k 62 3204031479
put k 63 3329325298
end
fn inith to void
put h 0 1779033703
put h 1 3144134277
put h 2 1013904242
put h 3 2773480762
put h 4 1359893119
put h 5 2600822924
put h 6 528734635
put h 7 1541459225
put g gHn 0
put g gHt 0
end
fn rotr x ulong r ulong to ulong
ret and or shr x r shl x sub 32 r mask
end
fn bsig0 x ulong to ulong
ret xor rotr x 2 xor rotr x 13 rotr x 22
end
fn bsig1 x ulong to ulong
ret xor rotr x 6 xor rotr x 11 rotr x 25
end
fn ssig0 x ulong to ulong
ret xor rotr x 7 xor rotr x 18 shr x 3
end
fn ssig1 x ulong to ulong
ret xor rotr x 17 xor rotr x 19 shr x 10
end
fn ch x ulong y ulong z ulong to ulong
ret xor and x y and and not x mask z
end
fn maj x ulong y ulong z ulong to ulong
ret xor and x y xor and x z and y z
end
fn sched to void
for i ulong 16
o = mul i 4
v = ulong get hb o
v = or shl v 8 ulong get hb add o 1
v = or shl v 8 ulong get hb add o 2
v = or shl v 8 ulong get hb add o 3
put w i v
end
for j ulong 48
i = add j 16
s = add ssig1 get w sub i 2 get w sub i 7
s = add s ssig0 get w sub i 15
s = add s get w sub i 16
put w i and s mask
end
end
fn round i ulong to void
a = get hs 0
e = get hs 4
t1 = add get hs 7 bsig1 e
t1 = add t1 ch e get hs 5 get hs 6
t1 = add t1 get k i
t1 = and add t1 get w i mask
t2 = and add bsig0 a maj a get hs 1 get hs 2 mask
put hs 7 get hs 6
put hs 6 get hs 5
put hs 5 e
put hs 4 and add get hs 3 t1 mask
put hs 3 get hs 2
put hs 2 get hs 1
put hs 1 a
put hs 0 and add t1 t2 mask
end
fn block to void
sched
for i ulong 8
put hs i get h i
end
for i ulong 64
round i
end
for i ulong 8
put h i and add get h i get hs i mask
end
end
fn hbyte b uchar to void
f = get g gHn
put hb f b
f = add f 1
if eq f 64
block
f = 0
end
put g gHn f
end
fn hfin to void
bits = mul get g gHt 8
hbyte 128
while ne get g gHn 56 bound 128
hbyte 0
end
for i ulong 8
hbyte uchar and shr bits mul sub 7 i 8 255
end
for i ulong 8
v = get h i
for j ulong 8
d = and shr v mul sub 7 j 4 15
c = uchar add d 48
if ge d 10
c = uchar add d 87
end
put hx add mul i 8 j c
end
end
end
note shafile: SHA-256 of the file named in sb into hx; false when it cannot be opened or read
fn shafile to bool
n = get sn 0
if or eq n 0 gt n 4095
sbclr
ret false
end
f = fopen sb 0 n 0 0
sbclr
if lt f 0
ret false
end
inith
go = true
while go bound 9223372036854775807
r = read int f fb 0 65536
if lt r 0
z = fclose int f
ret false
end
if eq r 0
go = false
else
for i ulong ulong r
hbyte get fb i
end
put g gHt add get g gHt ulong r
end
end
y = fclose int f
hfin
ret true
end
fn sbhx to void
for i ulong 64
sbc get hx i
end
end
note directory iteration over getdents64 records (reclen u16 at 16, name from 19, NUL-ended)
fn dopen to bool
n = get sn 0
f = fopen sb 0 n 0 0
sbclr
put ds 0 f
put ds 1 0
put ds 2 0
ret ge f 0
end
fn dclose to void
if ge get ds 0 0
z = fclose int get ds 0
end
put ds 0 -1
end
fn dnext to bool
f = int get ds 0
if lt f 0
ret false
end
if ge get ds 1 get ds 2
r = getdnts f dbuf 0 32768
if le r 0
ret false
end
put ds 1 0
put ds 2 r
end
p = ulong get ds 1
rl = or ulong get dbuf add p 16 shl ulong get dbuf add p 17 8
n = ulong 0
c = true
while c bound 512
b = get dbuf add add p 19 n
if or eq b 0 ge add add p 19 n add p rl
c = false
else
put dn n b
n = add n 1
end
end
put g gDnl n
put ds 1 long add p rl
ret true
end
note dpre x: the entry name starts with table entry x; kStar matches every name not starting with "."
fn dpre x ulong to bool
m = get g gDnl
if eq x kStar
ret and gt m 0 ne get dn 0 46
end
tbpos x
a = get kp 0
l = get kp 1
if lt m l
ret false
end
for i ulong l
if ne get dn i get tb add a i
ret false
end
end
ret true
end
fn sbdn to void
for i ulong get g gDnl
sbc get dn i
end
end
note dncmp s: bytewise order of the entry name against slot s (-1, 0, 1)
fn dncmp s ulong to long
o = mul s 4096
m = get g gDnl
l = get sl s
i = ulong 0
while and lt i m lt i l bound 4097
a = get dn i
b = get sv add o i
if lt a b
ret -1
end
if gt a b
ret 1
end
i = add i 1
end
if lt m l
ret -1
end
if gt m l
ret 1
end
ret 0
end
fn sbquote s ulong to void
sbc 39
sbs s
sbc 39
end
note mkdirp: mkdir -p of the path in sb (it goes to slot sPath); true when it is a directory
fn mkdirp to bool
svset sPath
n = get sl sPath
o = mul sPath 4096
for i ulong n
if and gt i 0 eq get sv add o i 47
r = makedir sv o i 511
end
end
q = makedir sv o n 511
z = stat sv o n stb 0 128
if lt z 0
ret false
end
m = or ulong get stb 16 shl ulong get stb 17 8
ret eq and m 61440 16384
end
fn mkdirpd to void
if not mkdirp
sbk kMkFail
sbquote sPath
out 2
bail 1
end
end
note cpf: cp slot sSrc to slot sDst (a regular file; the target keeps cp's mode rules)
fn cpf to bool
o = mul sSrc 4096
n = get sl sSrc
z = stat sv o n stb 0 128
if lt z 0
ret false
end
m = or ulong get stb 16 shl ulong get stb 17 8
if eq and m 61440 16384
ret false
end
f = fopen sv o n 0 0
if lt f 0
ret false
end
d = fopen sv mul sDst 4096 get sl sDst 577 int and m 511
if lt d 0
y = fclose int f
ret false
end
ok = true
go = true
while go bound 9223372036854775807
r = read int f fb 0 65536
if le r 0
go = false
ok = eq r 0
else
x = write int d fb 0 ulong r
if ne x r
go = false
ok = false
end
end
end
a = fclose int f
b = fclose int d
ret ok
end
note cpglob x: copy every entry of slot sDir whose name starts with table entry x into slot sCand
fn cpglob x ulong to ulong
sbs sDir
c = ulong 0
if dopen
while dnext bound 9223372036854775807
if dpre x
sbs sDir
sbc 47
sbdn
svset sSrc
sbs sCand
sbc 47
sbdn
svset sDst
c = add c 1
if not cpf
dclose
sbk kCpFail
sbquote sSrc
sbk kTo
sbquote sDst
out 2
bail 1
end
end
end
dclose
end
ret c
end
note rmglob x: rm -f slot sCbuild/<table entry x>*
fn rmglob x ulong to void
sbs sCbuild
if dopen
while dnext bound 9223372036854775807
if dpre x
sbs sCbuild
sbc 47
sbdn
svset sSrc
r = unlink sv mul sSrc 4096 get sl sSrc
if lt r 0
dclose
sbk kRmFail
sbquote sSrc
out 2
bail 1
end
end
end
dclose
end
end
note shalist: (cd sDir && sha256sum -- *) > file named in sb, in bytewise name order
fn shalist to void
n = get sn 0
f = fopen sb 0 n 577 438
sbclr
if ge f 0
put sl sLast 0
have = false
more = true
while more bound 9223372036854775807
found = false
sbs sDir
if dopen
while dnext bound 9223372036854775807
if dpre kStar
if or not have gt dncmp sLast 0
if or not found lt dncmp sVal 0
sbdn
svset sVal
found = true
end
end
end
end
dclose
end
if found
sbs sVal
svset sLast
have = true
sbs sDir
sbc 47
sbs sLast
if shafile
sbhx
sbc 32
sbc 32
sbs sLast
sbc 10
r = write int f sb 0 get sn 0
sbclr
end
else
more = false
end
end
z = fclose int f
end
end
note lcomp s e: the last path component of slot s within [0, e) into cp2 (start, end)
fn lcomp s ulong e ulong to void
o = mul s 4096
t = e
c = true
while c bound 4097
if eq t 0
c = false
else
if ne get sv add o sub t 1 47
c = false
else
t = sub t 1
end
end
end
a = t
d = true
while d bound 4097
if eq a 0
d = false
else
if eq get sv add o sub a 1 47
d = false
else
a = sub a 1
end
end
end
put cp2 0 a
put cp2 1 t
end
note slash s e: e with the trailing slashes of slot s before it removed
fn slash s ulong e ulong to ulong
o = mul s 4096
t = e
c = true
while c bound 4097
if eq t 0
c = false
else
if ne get sv add o sub t 1 47
c = false
else
t = sub t 1
end
end
end
ret t
end
fn sbrange s ulong a ulong t ulong to void
o = add mul s 4096 a
for i ulong sub t a
sbc get sv add o i
end
end
note sbpb s: $(basename "$(dirname s)")/$(basename s)
fn sbpb s ulong to void
n = get sl s
lcomp s n
a = get cp2 0
t = get cp2 1
e = slash s a
if eq e 0
if and gt n 0 eq get sv mul s 4096 47
sbc 47
else
sbc 46
end
else
lcomp s e
sbrange s get cp2 0 get cp2 1
end
sbc 47
if eq a t
if gt n 0
sbc 47
end
else
sbrange s a t
end
end
note dirup s: slot s becomes its dirname (the root stays "/")
fn dirup s ulong to void
lcomp s get sl s
e = slash s get cp2 0
if eq e 0
e = 1
end
put sl s e
end
note teerc: echo the line in sb | tee -a "$out/rc.txt"
fn teerc to void
svset sTmp
sbs sOut
sbk kRcTxt
n = get sn 0
f = fopen sb 0 n 1089 438
sbclr
sbs sTmp
sbc 10
r = write 1 sb 0 get sn 0
if ge f 0
q = write int f sb 0 get sn 0
z = fclose int f
end
sbclr
end
note stepbeg: the step name is in sb; label = %02d-name
fn stepbeg to void
svset sTmp
n = add get g gStep 1
put g gStep n
sbnumw n 2
sbc 45
sbs sTmp
svset sLabel
end
note stepgo: dry-run prints the PLAN line; device mode runs spark-window run ARGS > NN-label.log 2>&1
fn stepgo to void
if eq get g gDry 1
sbk kPlan
sbs sLabel
sbk kPlanMid
arjoin
out 1
else
pkhead
pkk kSW
pkk kRun
pkar
pkend
if eq get g gDry 2
ret
end
sbs sOut
sbc 47
sbs sLabel
sbk kLogSuf
svset sPath
sbs sPath
f = fopen sb 0 get sn 0 577 438
sbclr
rc = ulong 2
if lt f 0
sbk kCannotOpen
sbs sPath
out 2
else
p = spawn int f int f
z = fclose int f
rc = reap p
end
sbs sLabel
sbk kRcEq
sbnum rc
teerc
if ne rc 0
put g gFail 1
end
end
end
fn probe to void
sbs sCudapp
sbk kProbeRel
arrec
end
note confstep: the step name is in sb; one conformance/run.sh --device row
fn confstep to void
stepbeg
dev = eq get g gDry 0
if dev
rmglob kOmegaPre
rmglob kMaxPre
end
arbeg
sbs sHere
sbk kConfRel
arrec
ark kDevice
stepgo
if dev
sbs sOut
sbc 47
sbs sLabel
sbk kOutSuf
svset sCand
sbs sCand
mkdirpd
sbs sCbuild
svset sDir
a = cpglob kOmegaPre
b = cpglob kMaxPre
sbs sCand
svset sDir
sbs sOut
sbc 47
sbs sLabel
sbk kShaSuf
shalist
end
end
fn plan to void
put g gStep 0
sbk kStMatmul
stepbeg
arbeg
probe
ars sMm
ark kMmFn
ark kN16
ark kN16
ark kN8
stepgo
sbk kStGqa
stepbeg
arbeg
probe
ark kLoadOnly
ars sGqa
ark kGqaFn
ark kN2
ark kN8
ark kN1
stepgo
sbk kStStale
stepbeg
arbeg
probe
ark kExpReject
ars sStale
ark kMmFn
ark kN16
ark kN16
ark kN8
stepgo
sbk kStConf
confstep
i = ulong 1
while le i get g gPairs bound 9223372036854775807
sbk kStPair
sbnum i
sbk kStPairSuf
confstep
i = add i 1
end
sbk kStTorch
stepbeg
arbeg
ark kEnvWord
sbk kETORCH
sbs sTorch
arrec
sbk kPyPath
sbs sHere
sbk kTorchDir
arrec
ars sPy
sbs sHere
sbk kTorchTest
arrec
sbs sOut
sbk kReceipt
arrec
stepgo
end
note need: [ -e path ] for the path in sb
fn need to void
svset sTmp
sbs sTmp
if fexist
sbk kOK
else
sbk kMissing
put g gMissing 1
end
sbs sTmp
out 1
end
note pkopen: the packet of spark-window open (the shell's open line)
fn pkopen to void
pkhead
pkk kSW
pkk kOpen
pks sName
pkk kLedger
pks sLedger
pkk kGb10
pkk kExcl
pkk kQuiet
pkk kNone
pkk kLease
pkk kN20
pkk kWait
pkend
end
note preflight: build every packet this run can pass to execprog (the open, each row of the plan,
note and the close with a window id of 4095 bytes) before anything is printed or opened, so an
note environment too large for the packet refuses at once (exit 3), never mid-plan or mid-window
fn preflight to void
pkopen
pkhead
pkk kSW
pkk kClose
pkroom 4095
d = get g gDry
put g gDry 2
plan
put g gDry d
put g gStep 0
end
fn dryrun to void
cv = envval kECVD
if or not cv gt get g gEvl 0
sbk kRefCvd
if cv
outev 2
else
sbk kUnset
end
sbk kQuoteParen
out 2
exit 3
end
if envval kESW
if gt get g gEvl 0
sbk kRefSw
outev 2
out 2
exit 3
end
end
preflight
sbk kDryHead
sbs sLedger
sbk kWinEq
sbs sName
sbk kPairsEq
sbs sPairs
sbk kOutEq
sbs sLedger
out 1
sbk kWould
sbs sName
sbk kWouldLedger
sbs sLedger
sbk kWouldTail
out 1
plan
sbk kInputs
out 1
put g gMissing 0
sbs sCudapp
sbk kProbeRel
need
sbs sMm
need
sbs sGqa
need
sbs sStale
need
sbs sHere
sbk kConfRel
need
sbs sHere
sbk kMaxRunner
need
sbs sHere
sbk kTorchTest
need
sbs sTorch
need
if envset kEMAXPY sVal
sbs sVal
else
if not envget kEHOME sVal
diek kHomeUnset 2
end
sbs sVal
sbk kMaxpyRel
end
need
sbs sCudapp
sbk kLibRel
need
pkhead
pks sPy
pkk kDashC
pkk kTorchProbe
pkend
d = devnull
p = spawn -1 d
if ge d 0
z = fclose d
end
if eq reap p 0
sbk kTorchOk
sbs sPy
else
sbk kTorchMiss
sbs sPy
sbk kTorchMissTail
put g gMissing 1
end
out 1
sbs sOut
if fexist
sbk kExists
sbs sOut
sbk kExistsTail
out 1
put g gMissing 1
end
sbk kRows
sbnum get g gStep
sbk kRowsMid
sbs sPairs
sbk kRowsTail
out 1
if eq get g gMissing 1
sbk kDryInc
out 1
exit 1
end
sbk kDryPass
out 1
exit 0
end
note clread f: read the closer pipe to its end into sb (the id, a newline, N on a normal exit)
fn clread f int to void
sbclr
go = true
while go bound 9223372036854775807
q = read f fb 0 65536
if le q 0
go = false
else
for i ulong ulong q
if lt get sn 0 65536
sbc get fb i
end
end
end
end
end
note cldrain f: read the hold pipe to its end: every child holding its write end has exited
fn cldrain f int to void
go = true
while go bound 9223372036854775807
q = read f fb 0 65536
if le q 0
go = false
end
end
end
note widok: the captured open output, without trailing newlines, is 1..4095 bytes of [A-Za-z0-9._-]
fn widok to bool
if eq get g gCo 1
ret false
end
t = get g gCn
c = true
while c bound 65537
if eq t 0
c = false
else
if ne get cb sub t 1 10
c = false
else
t = sub t 1
end
end
end
if or eq t 0 gt t 4095

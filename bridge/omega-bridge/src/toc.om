m = ulong 1
c = ulong 0
while and lt c n le mul m b 4294967295
m = mul m b
c = add c 1
end
t = fbmul o m
n = sub n c
end
end

note fbsub: one restoring-division step. If A >= D then A = A - D and 1, else A is kept and 0.
fn fbsub to ulong
r = ulong 2
i = ulong 40
while and gt i 0 eq r 2
i = sub i 1
a = get fbn i
d = get fbn add i 40
if lt a d
r = ulong 0
end
if gt a d
r = ulong 1
end
end
if eq r 0
ret 0
end
b = ulong 0
i = ulong 0
while lt i 40
v = sub sub get fbn i get fbn add i 40 b
put fbn i and v 4294967295
b = shr v 63
i = add i 1
end

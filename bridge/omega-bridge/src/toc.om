fn ab_sha sel ulong n ulong to void
ab_shainit
nblk = div add n 72 64
blk = ulong 0
while lt blk nblk
ab_sched sel n blk
for i ulong 8
put abv i get abh i
end
for r ulong 64
ab_round r
end
for q ulong 8
put abh q and add get abh q get abv q 4294967295
end
blk = add blk 1
end
end

fn ab_hexc v ulong to ulong
if lt v 10
ret add v 48
end
ret add v 87
end

note 1 when the 64 lowercase hex digits at src[pos] spell the digest in abh.
fn ab_dgeq pos ulong to ulong
for i ulong 32
v = get abh div i 4
sh = mul sub 3 rem i 4 8
bv = and shr v sh 255
o = add pos mul i 2
hc = ab_hexc shr bv 4
if ne ulong get src o hc
ret 0
end
lc = ab_hexc and bv 15
if ne ulong get src add o 1 lc
ret 0
end
end
ret 1
end

note The trailer digests must equal SHA-256 of the generator source on fd 3 (tools/bridge-seeded
note opens src/toc.om there) and of the source bytes before the trailer; anything else is error 52.
fn ab_provsum to void
ab_kinit
p = get abprov 0
off = ulong 0
go = ulong 1
while eq go 1
r = read 3 abtoc off sub 1048576 off
if lt r 0
fail 52
end
if eq r 0
go = 0
else
off = add off ulong r
if ge off 1048576
fail 52
end
end
end
if eq off 0
fail 52
end
ab_sha 1 off
if eq ab_dgeq add p 1 0
fail 52
end
ab_sha 0 sub p 1
if eq ab_dgeq add p 66 0
fail 52
end
end

fn ab_lib_main to void
if ne get hasmain 0 0
fail 50
end
if ne get ng 0 0
fail 51
end
ab_provsum
ab_scan
ab_resolve
end

put fbn 0 and get fnd 0 4294967295
put fbn 1 shr get fnd 0 32
put fbn 40 1
if gt p 0
fbpow 0 10 ulong p
else
fbpow 40 10 ulong sub 0 p
end
a = fbmul 0 1
d = fbmul 40 1
e = long 0
if lt a d
fbpow 0 2 sub d a
e = sub 0 long sub d a
else
fbpow 40 2 sub a d
e = long sub a d
end

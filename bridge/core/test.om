note SPDX-License-Identifier: Apache-2.0
note bridge/core/test.om: positive & negative control test suite for
note omega-bridge Native ABI v2 and ggml-omega tensor-bridge descriptor/op dispatch.
note Compose with: si/directives/om2.om bridge/core/abi_ggml.om bridge/core/test.om

text t_pass "PASS "
text t_fail "FAIL "
text t_nl "\n"

text t_c1 "abi_v2_param_slot_budget_and_overflow_controls"
text t_c2 "abi_v2_layout_bounds_and_field_disjointness"
text t_c3 "abi_v2_single_edit_aliasing_and_trap_status"
text t_c4 "ggml_row_bytes_and_q8_0_block_alignment"
text t_c5 "ggml_tensor_stride_validation_and_negative_controls"
text t_c6 "ggml_supports_op_dispatch_and_refusals"
text t_c7 "ggml_tile_plan_exact_reconstruction"
text t_done "PASS bridge-abi-ggml all 7 test suites passed\n"

fn report_case name view uchar * ok bool to int
if ok
w1 = br_write_all int 1 t_pass
w2 = br_write_all int 1 name
w3 = br_write_all int 1 t_nl
if and w1 and w2 w3
ret int 0
end
ret int 1
end
w4 = br_write_all int 1 t_fail
w5 = br_write_all int 1 name
w6 = br_write_all int 1 t_nl
if and w4 and w5 w6
ret int 1
end
ret int 1
end

fn test_slot_budget to bool
if ne br_check_param_slots ulong 2 ulong 0 ulong 2 BR_OK
ret false
end
if ne br_check_param_slots ulong 0 ulong 0 ulong 3 BR_OK
ret false
end
note Negative controls: 2 unsized views + 3 scalars = 7 slots (error 9 in omc)
if ne br_check_param_slots ulong 3 ulong 0 ulong 2 BR_ERR_SLOT_OVERFLOW
ret false
end
if ne br_check_param_slots ulong 7 ulong 0 ulong 0 BR_ERR_SLOT_OVERFLOW
ret false
end
ret true
end

fn test_layout_bounds to bool
if ne br_validate_layout_field ulong 64 ulong 0 ulong 8 ulong 4 BR_OK
ret false
end
if ne br_validate_layout_field ulong 64 ulong 32 ulong 4 ulong 8 BR_OK
ret false
end
note Negative controls: zero layout, >4096 layout, zero count, field OOB
if ne br_validate_layout_field ulong 0 ulong 0 ulong 4 ulong 1 BR_ERR_BAD_LAYOUT_SIZE
ret false
end
if ne br_validate_layout_field ulong 4097 ulong 0 ulong 4 ulong 1 BR_ERR_BAD_LAYOUT_SIZE
ret false
end
if ne br_validate_layout_field ulong 64 ulong 0 ulong 4 ulong 0 BR_ERR_BAD_FIELD_COUNT
ret false
end
if ne br_validate_layout_field ulong 64 ulong 60 ulong 8 ulong 1 BR_ERR_FIELD_OOB
ret false
end
if not br_spans_disjoint ulong 0 ulong 32 ulong 32 ulong 32
ret false
end
if br_spans_disjoint ulong 0 ulong 33 ulong 32 ulong 32
ret false
end
ret true
end

fn test_aliasing_and_traps to bool
if ne br_check_single_edit ulong 1000 ulong 64 ulong 1064 ulong 64 BR_OK
ret false
end
if ne br_check_single_edit ulong 1000 ulong 64 ulong 1032 ulong 64 BR_ERR_ALIAS_OVERLAP
ret false
end
if ne br_check_single_edit ulong 1000 ulong 64 ulong 1000 ulong 64 BR_ERR_ALIAS_OVERLAP
ret false
end
if ne br_check_exit_status ulong 0 BR_OK
ret false
end
if ne br_check_exit_status ulong 103 BR_ERR_OMEGA_TRAP
ret false
end
if ne br_check_exit_status ulong 114 BR_ERR_OMEGA_TRAP
ret false
end
if ne br_check_exit_status ulong 1 BR_ERR_HOST_FAILURE
ret false
end
ret true
end

fn test_ggml_row_bytes to bool
if ne ggml_row_bytes GGML_F32 ulong 128 ulong 512
ret false
end
if ne ggml_row_bytes GGML_F16 ulong 128 ulong 256
ret false
end
if ne ggml_row_bytes GGML_Q8_0 ulong 64 ulong 68
ret false
end
note Negative controls: misaligned Q8_0 (not multiple of 32), zero ne0, unknown dtype
if ne ggml_row_bytes GGML_Q8_0 ulong 33 ulong 0
ret false
end
if ne ggml_row_bytes GGML_F32 ulong 0 ulong 0
ret false
end
if ne ggml_row_bytes ulong 99 ulong 32 ulong 0
ret false
end
ret true
end

fn test_ggml_strides to bool
if ne ggml_validate_tensor GGML_F32 ulong 64 ulong 4 ulong 4 ulong 256 BR_OK
ret false
end
if ne ggml_validate_tensor GGML_Q8_0 ulong 64 ulong 4 ulong 34 ulong 68 BR_OK
ret false
end
note Negative controls: nb1 < row_bytes (overlapping rows!), nb0 < elem_size, misaligned Q8_0
if ne ggml_validate_tensor GGML_F32 ulong 64 ulong 4 ulong 4 ulong 200 BR_ERR_BAD_STRIDE
ret false
end
if ne ggml_validate_tensor GGML_F32 ulong 64 ulong 4 ulong 2 ulong 256 BR_ERR_BAD_STRIDE
ret false
end
if ne ggml_validate_tensor GGML_Q8_0 ulong 30 ulong 4 ulong 34 ulong 68 BR_ERR_BAD_BLOCK_ALIGN
ret false
end
if ne ggml_validate_tensor ulong 77 ulong 64 ulong 4 ulong 4 ulong 256 BR_ERR_BAD_DTYPE
ret false
end
ret true
end

fn test_ggml_ops to bool
if ne ggml_supports_op GGML_OP_ADD GGML_F32 GGML_F32 GGML_F32 ulong 64 BR_OK
ret false
end
if ne ggml_supports_op GGML_OP_MUL_MAT GGML_Q8_0 GGML_F32 GGML_F32 ulong 256 BR_OK
ret false
end
if ne ggml_supports_op GGML_OP_MUL_MAT GGML_F16 GGML_F32 GGML_F32 ulong 128 BR_OK
ret false
end
if ne ggml_supports_op GGML_OP_CPY GGML_Q8_0 GGML_F32 GGML_F32 ulong 64 BR_OK
ret false
end
note Negative controls: F16 ADD unsupported, CPY to Q8_0 unsupported, misaligned Q8_0 MUL_MAT, unknown op
if ne ggml_supports_op GGML_OP_ADD GGML_F16 GGML_F16 GGML_F16 ulong 64 BR_ERR_UNSUPPORTED_OP
ret false
end
if ne ggml_supports_op GGML_OP_CPY GGML_F32 GGML_F32 GGML_Q8_0 ulong 64 BR_ERR_UNSUPPORTED_OP
ret false
end
if ne ggml_supports_op GGML_OP_MUL_MAT GGML_Q8_0 GGML_F32 GGML_F32 ulong 30 BR_ERR_BAD_BLOCK_ALIGN
ret false
end
if ne ggml_supports_op ulong 99 GGML_F32 GGML_F32 GGML_F32 ulong 64 BR_ERR_UNSUPPORTED_OP
ret false
end
ret true
end

fn test_ggml_tiling to bool
plan = new ulong 2 0
if ne ggml_tile_plan ulong 100 ulong 32 plan BR_OK
ret false
end
if or ne get plan 0 ulong 3 ne get plan 1 ulong 4
ret false
end
if ne add mul get plan 0 ulong 32 get plan 1 ulong 100
ret false
end
if ne ggml_tile_plan ulong 100 ulong 0 plan BR_ERR_BAD_TILE
ret false
end
ret true
end

fn main to int
fail = int 0
fail = add fail report_case t_c1 test_slot_budget
fail = add fail report_case t_c2 test_layout_bounds
fail = add fail report_case t_c3 test_aliasing_and_traps
fail = add fail report_case t_c4 test_ggml_row_bytes
fail = add fail report_case t_c5 test_ggml_strides
fail = add fail report_case t_c6 test_ggml_ops
fail = add fail report_case t_c7 test_ggml_tiling
if ne fail int 0
ret int 1
end
ok = br_write_all int 1 t_done
if not ok
ret int 1
end
ret int 0
end

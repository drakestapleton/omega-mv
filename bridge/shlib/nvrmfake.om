note SPDX-License-Identifier: Apache-2.0
note bridge/shlib/nvrmfake.om: the test transport libomega-nvrm.so.1 (nvrmfake.tsv) behind the gate's
note libnvidia-ml.so.1: the three omega2_nvrm_* entry points of native/nvrm/transport.om, answered by the RM fake
note nvml_fake (bridge/shlib/rmfake.om, CUDApp's tests/nvml/rmfake.om unchanged) instead of /dev/nvidia*, plus
note fake_reset, fake_get and fake_trapped; the same functions and answers as CUDApp's tests/nvml/transport.c.
note Composed after rmfake.om. No device file is opened.
note States (frame words 8..11): FkS the fake's 64 words, FkH the request header, FkP the payload, FkT the
note violation count (0) and the result word copied out (1).
note A trap inside nvml_fake returns the TRAP value 1 (a transport refusal) at once, without the C's count of
note it as a violation: a path that is a bug in the fake.

const UMAX ulong 4294967295

extern fn memcpy d ulong s ulong n ulong to ulong

note fk_step: one fake step; a refusal (nonzero) counts as a violation and answers status 1; otherwise the
note fake's result goes to the caller's result word
fn fk_step st edit ulong 64 h edit uchar HN p edit uchar PN t edit ulong 8 fr view ulong 12 to uint
v = nvml_fake st h p
if ne v 0
put t 0 add get t 0 1
put st 13 add get st 13 1
ret 1
end
put t 1 get st 6
z = memcpy get fr 0 add get fr 11 8 8
ret 0
end

export fn omega2_nvrm_open_file fr view ulong 12 st edit ulong 64 h edit uchar HN p edit uchar PN t edit ulong 8 to uint
n = get fr 2
if or eq n 0 gt n PN
ret 32
end
z = memcpy get fr 10 get fr 1 n
put st 0 2
put st 7 n
ret fk_step st h p t fr
end

export fn omega2_nvrm_close_file fr view ulong 12 st edit ulong 64 h edit uchar HN p edit uchar PN t edit ulong 8 to uint
put st 0 3
put st 1 get fr 1
ret fk_step st h p t fr
end

note fault S: the transport itself refuses the GPU name control 0x20800110 (status 1)
fn fk_srefuse st view ulong 64 h view uchar HN fr view ulong 12 to bool
if or ne get st 5 83 ne get fr 2 42
ret false
end
if lt get fr 4 12
ret false
end
c = or or ulong get h 8 shl ulong get h 9 8 or shl ulong get h 10 16 shl ulong get h 11 24
ret eq c 545259792
end

export fn omega2_nvrm_ioctl fr view ulong 12 st edit ulong 64 h edit uchar HN p edit uchar PN t edit ulong 8 to uint
hl = get fr 4
pl = get fr 6
if or gt hl HN gt pl PN
ret 32
end
z = memcpy get fr 9 get fr 3 hl
if fk_srefuse st h fr
ret 1
end
z = memcpy get fr 10 get fr 5 pl
put st 0 1
put st 1 get fr 1
put st 2 get fr 2
put st 3 hl
put st 4 pl
r = fk_step st h p t fr
z = memcpy get fr 3 get fr 9 hl
z = memcpy get fr 5 get fr 10 pl
ret r
end

export fn fake_reset fr view ulong 12 st edit ulong 64 t edit ulong 8 to ulong
for i ulong 64
put st i 0
end
put st 5 and get fr 0 255
put t 0 0
ret 0
end

export fn fake_get fr view ulong 12 st edit ulong 64 to ulong
i = and get fr 0 UMAX
if lt i 64
ret get st i
end
ret 18446744073709551615
end

export fn fake_trapped fr view ulong 12 t edit ulong 8 to ulong
ret get t 0
end

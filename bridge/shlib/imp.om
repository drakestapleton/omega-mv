om2
note SPDX-License-Identifier: Apache-2.0
note bridge/shlib/imp.om: the unit of the gate's import library (imp.tsv): imports from the dependency library
note (dep.om) and the C library, frame exports over three states, and a lock (imp.tsv's lock row).
extern fn omega_dep_twice a ulong to ulong
extern fn omega_dep_dirty to int
extern fn omega_dep_sub a ulong b ulong to ulong
extern fn omega_dep_rd c view uint 1024 to uint
extern fn strlen s view uchar 4096 to ulong
note many values live across each import call: omc keeps them over the BL, the veneer keeps x7 and x30
export fn omega_imp_live fr view ulong 11 to ulong
a = get fr 0
b = add a 1
c = add a 2
d = add a 3
e = add a 4
f = add a 5
g = omega_dep_twice a
h = omega_dep_twice b
ret add add add add add add c d e f g h b
end
note a counter in state ImpS: 1, 2, 3 over the calls
export fn omega_imp_count fr view ulong 11 s edit ulong 8 to ulong
put s 0 add get s 0 1
ret get s 0
end
note a trap inside a frame export: the lock must be released on the trap path
export fn omega_imp_trap fr view ulong 11 to ulong
ret div get fr 0 get fr 1
end
note a dirty result imported as int: omc's int add traps without the veneer's sign extension
export fn omega_imp_dirty fr view ulong 11 to int
ret add omega_dep_dirty int 1
end
note the import row of omega_dep_sub swaps its arguments
export fn omega_imp_swap fr view ulong 11 to ulong
ret omega_dep_sub get fr 0 get fr 1
end
note the import row of omega_dep_rd moves the pointer by 8 bytes (two uints)
export fn omega_imp_off fr view ulong 11 t edit uint 1024 to uint
put t 2 uint get fr 0
ret omega_dep_rd t
end
note the C library's strlen over the text state ImpT
export fn omega_imp_strlen fr view ulong 11 t edit uchar 4096 to ulong
for i ulong get fr 0 bound 4095
put t i 97
end
put t get fr 0 0
ret strlen t
end
note the frame: the second C argument, and the state addresses (fr 8..10) are 64-byte aligned and distinct
export fn omega_imp_frame fr view ulong 11 to ulong
if ne and get fr 8 63 0
ret 1000
end
if eq get fr 8 get fr 9
ret 1001
end
ret get fr 1
end

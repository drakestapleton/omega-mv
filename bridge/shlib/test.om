om2
note SPDX-License-Identifier: Apache-2.0
note bridge/shlib/test.om: the unit of the bridge/shlib gate's test library (test.tsv). A constant, an int
note addition (its arguments arrive from C with undefined upper halves) and a division that traps on 0.
export fn omega_shlib_seven to int
ret 7
end
export fn omega_shlib_add a int b int to int
ret add a b
end
export fn omega_shlib_div a int b int to int
ret div a b
end
note pointer parameters: a sized edit or view is one C pointer
export fn omega_shlib_put c edit uint 2 v uint to int
put c 1 v
ret 0
end
export fn omega_shlib_get c view uint 2 to uint
ret get c 1
end
note a uint argument (omc needs it zero-extended) and a body with an 8 KiB local array (the wrapper probes
note its stack pages first)
export fn omega_shlib_hi a uint to uint
ret shr a 16
end
export fn omega_shlib_sum n uint to uint
a = new uint 2048 0
for i ulong 2048
put a i uint i
end
s = uint 0
for i ulong ulong n bound 2048
s = add s get a i
end
ret s
end
note a private function behind an export: the object carries a call record, and the export's stack need is
note settled through it
fn deep n uint to uint
a = new uint 4096 0
put a 4095 n
ret add get a 4095 1
end
export fn omega_shlib_deep n uint to uint
ret deep n
end

om2
note SPDX-License-Identifier: Apache-2.0
note bridge/shlib/test.om: the unit of the bridge/shlib gate's test library (test.tsv): a constant, an int
note addition and division (arguments from C with undefined upper halves; division traps on 0), a pointer write
note and read, a uint shift, two bodies that need stack (one through a private call), narrow arguments, and a
note trap inside a private callee.
export fn omega_shlib_seven to int
ret 7
end
export fn omega_shlib_add a int b int to int
ret add a b
end
export fn omega_shlib_div a int b int to int
ret div a b
end
note pointer parameters: a sized edit or view is one C pointer
export fn omega_shlib_put c edit uint 2 v uint to int
put c 1 v
ret 0
end
export fn omega_shlib_get c view uint 2 to uint
ret get c 1
end
note a uint argument (omc needs it zero-extended) and a body with an 8 KiB local array (the wrapper probes
note its stack pages first)
export fn omega_shlib_hi a uint to uint
ret shr a 16
end
export fn omega_shlib_sum n uint to uint
a = new uint 2048 0
for i ulong 2048
put a i uint i
end
s = uint 0
for i ulong ulong n bound 2048
s = add s get a i
end
ret s
end
note a private function behind an export: the object carries a call record, and the export's stack need is
note settled through it
fn deep n uint to uint
a = new uint 4096 0
put a 4095 n
ret add get a 4095 1
end
export fn omega_shlib_deep n uint to uint
ret deep n
end
note narrow arguments: omc takes a uchar, ushort, byte or short already extended to 64 bits
export fn omega_shlib_ub a uchar to uint
ret uint a
end
export fn omega_shlib_uh a ushort to uint
ret uint a
end
export fn omega_shlib_sb a byte to int
ret int a
end
export fn omega_shlib_sh a short to int
ret int a
end
note a trap inside a private callee: the context in x7 reaches it through omc's own call
fn pdiv a int b int to int
ret div a b
end
export fn omega_shlib_pdiv a int b int to int
ret pdiv a b
end
note a need one call cost past a page: edge's frame is 4080 bytes and the export's call adds its cost, so the
note probe covers ceil((4080 + cost + 16) / 4096) = 2 pages, 1 if the cost were dropped
fn edge n uint to uint
a = new uint 1020 0
put a 1019 n
ret add get a 1019 1
end
export fn omega_shlib_edge n uint to uint
ret edge n
end
note a float export, left out of test.tsv: the gate's float control adds it to a copy of the table, which the
note generator must refuse (omc passes floats in x registers, C in v registers)
export fn omega_shlib_fl a f64 to f64
ret a
end

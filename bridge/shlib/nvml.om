note SPDX-License-Identifier: Apache-2.0
note bridge/shlib/nvml.om: the 11 functions CUDApp's libnvidia-ml.so.1 exports (its libnvidia-ml.map) with
note the C signatures of its nvml.h, as real bodies: the shell of CUDApp's native/nvml/api.om and of the C
note glue its bridge generated (compat/nvml/libnvidia-ml.c), in Omega. Composed after
note gpu/nvidia/native/nvml/nvml.om, query.om, step.om and errstr.om (the request protocol, RM construction
note and error text, unchanged) into one object and built by bridge/shlib/shlib.om from nvml.tsv: every export
note is a frame export under the lock row's pthread mutex, and the transport is the three omega2_nvrm_*
note imports of libomega-nvrm.so.1 (native/nvrm/transport.om; in the gate the Omega RM fake, rmfake.om).
note States (nvml.tsv, frame words 8..13): NvS the 128-word step state, NvB the step buffer (request at 0,
note payload at PO, output at OO), NvR the transport's result word (0) and a copy word (1, 2), NvT the 32
note cached error strings of 64 bytes, then "Unknown Error" at 2048 and the 32 cache flags at 2112, NvH the 8
note device handles (a magic word and the index, 16 bytes each), NvLock the mutex.
note Every export answers as the C glue does: the body's code when it is an nvmlReturn_t value (0..30 or 999),
note else NVML_ERROR_UNKNOWN (999); outputs are written through C pointers (memcpy) only when the glue's checks
note pass (its o_ok), which holds for a body answering 999 with its outputs too.
note Differences from the C, all on a path the C reaches only by a bug: a trap anywhere in the unit (step,
note errstr or this shell) returns 999 at once (nvmlErrorString: NULL, not "Unknown Error"), without the
note C's put s 22 0 after a trap inside the step; a lock that cannot be taken returns the same.

const HMAG ulong 5723342196145933892
const UMAX ulong 4294967295
const WMAX ulong 18446744073709551615

extern fn omega2_nvrm_ioctl r ulong fd ulong nr ulong b ulong hl ulong pl ulong to uint
extern fn omega2_nvrm_open_file r ulong b ulong pn ulong to uint
extern fn omega2_nvrm_close_file r ulong fd ulong to uint
extern fn memcpy d ulong s ulong n ulong to ulong

note ap_put: the low n bytes of v to the C pointer d (through NvR word 1)
fn ap_put d ulong v ulong n ulong r edit ulong 8 fr view ulong 14 to void
put r 1 v
z = memcpy d add get fr 10 8 n
end

note ap_act: the action the step requested (1 ioctl, 2 open, 3 close), its result in s 14 and the transport
note status in s 15; 0 is a malformed request.
fn ap_act s edit ulong SN r edit ulong 8 fr view ulong 14 to ulong
k = get s 8
put r 0 0
st = ulong 0
if or eq k 0 gt k 3
ret 0
end
if eq k 1
hl = get s 11
pl = get s 12
if or gt hl 4608 gt pl 55888
ret 0
end
st = ulong omega2_nvrm_ioctl get fr 10 get s 9 get s 10 get fr 9 hl pl
end
if eq k 2
pn = get s 13
if or eq pn 0 gt pn 55888
ret 0
end
st = ulong omega2_nvrm_open_file get fr 10 get fr 9 pn
end
if eq k 3
st = ulong omega2_nvrm_close_file get fr 10 get s 9
end
put s 14 get r 0
put s 15 st
ret 1
end

note ap_run: step until the unit reports done (1) or the protocol fails (0), at most 4096 steps.
fn ap_run s edit ulong SN b edit uchar BN r edit ulong 8 fr view ulong 14 to ulong
ok = ulong 0
put s 22 0
for n ulong 4096
c = nvml_step s b
if ne c 0
break
end
if eq get s 8 0
ok = 1
break
end
if eq ap_act s r fr 0
break
end
end
put s 22 0
ret ok
end

note ap_fin: the copy bounds: at most cap output bytes, output only with a destination, a scalar only with a
note destination and below 2^32. 1 accepts the step's result.
fn ap_fin s edit ulong SN cap ulong dst ulong scl ulong to ulong
n = get s 7
if gt n cap
ret 0
end
if and ne n 0 eq dst 0
ret 0
end
if ne get s 27 0
if or eq scl 0 gt get s 5 UMAX
ret 0
end
end
ret 1
end

note ap_code: the step's status when it is an nvmlReturn_t value, else NVML_ERROR_UNKNOWN.
fn ap_code s edit ulong SN to ulong
v = get s 6
if or le v 30 eq v 999
ret v
end
ret 999
end

note ap_set: the operation and its four arguments in s 0..4.
fn ap_set s edit ulong SN op ulong a1 ulong a2 ulong a3 ulong to void
put s 0 op
put s 1 a1
put s 2 a2
put s 3 a3
put s 4 0
end

note ap_res: the export's answer: f 0 when it is an nvmlReturn_t value and f 1 holds no flag outside m
fn ap_res f edit ulong 8 m ulong to int
v = get f 0
if gt v 30
ret 999
end
if ne and get f 1 not m 0
ret 999
end
ret int v
end

note ap_ok: the glue's o_ok before its pointer checks: f 0 is an nvmlReturn_t value (0..30 or 999) and f 1 holds
note no flag outside m; a body answering NVML_ERROR_UNKNOWN (999) with outputs still has them written, as the C
fn ap_ok f edit ulong 8 m ulong to bool
v = get f 0
if and gt v 30 ne v 999
ret false
end
ret eq and get f 1 not m 0
end

note ap_hi: the pool index of the device handle d, or 2^64 - 1 when d is not one this library handed out
fn ap_hi d ulong h view ulong 16 fr view ulong 14 to ulong
a = get fr 12
if lt d a
ret WMAX
end
o = sub d a
if or ge o 128 ne rem o 16 0
ret WMAX
end
i = div o 16
m = get h mul i 2
x = get h add mul i 2 1
if and eq m HMAG eq x i
ret i
end
ret WMAX
end

note ap_nz: 1 when the C pointer v is not NULL
fn ap_nz v ulong to ulong
if eq v 0
ret 0
end
ret 1
end

note Init and Shutdown: no outputs.
fn ap_bare s edit ulong SN b edit uchar BN r edit ulong 8 fr view ulong 14 op ulong to int
f = new ulong 8 0
put f 0 999
ap_set s op 0 0 0
if ne ap_run s b r fr 0
if ne ap_fin s 0 0 0 0
put f 0 ap_code s
end
end
ret ap_res f 0
end

export fn nvmlInit_v2 fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 to int
ret ap_bare s b r fr 1
end

export fn nvmlShutdown fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 to int
ret ap_bare s b r fr 2
end

note Count: f 2 deviceCount present, f 3 the count.
export fn nvmlDeviceGetCount_v2 fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 to int
f = new ulong 8 0
put f 0 999
p = get fr 0
put f 2 ap_nz p
ap_set s 3 0 get f 2 0
if eq ap_run s b r fr 0
ret 999
end
if eq ap_fin s 0 0 get f 2 0
ret 999
end
if ne get s 27 0
put f 3 get s 5
put f 1 1
end
put f 0 ap_code s
c = ap_res f 1
if ne get f 1 0
if or eq p 0 gt get f 3 UMAX
ret 999
end
if not ap_ok f 1
ret c
end
ap_put p get f 3 4 r fr
end
ret c
end

note HandleByIndex: f 2 index, f 3 device present, f 4 the handle index (below the pool of 8).
export fn nvmlDeviceGetHandleByIndex_v2 fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 h edit ulong 16 to int
f = new ulong 8 0
put f 0 999
put f 2 and get fr 0 UMAX
p = get fr 1
put f 3 ap_nz p
ap_set s 4 get f 2 get f 3 0
if eq ap_run s b r fr 0
ret 999
end
if eq ap_fin s 0 0 1 0
ret 999
end
k = ap_code s
if eq k 0
v = ulong 0
if ne get s 27 0
v = get s 5
end
if ge v 8
ret 999
end
if ne get f 3 0
put f 4 v
put f 1 1
end
end
put f 0 k
c = ap_res f 1
if or not ap_ok f 1 eq get f 1 0
ret c
end
if or eq p 0 ge get f 4 8
ret 999
end
i = get f 4
put h mul i 2 HMAG
put h add mul i 2 1 i
ap_put p add get fr 12 mul i 16 8 r fr
ret c
end

note Name and UUID: f 2 device, f 3 buffer present, f 4 bytes written (with the NUL), f 5 length.
fn ap_str fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 h view ulong 16 op ulong to int
f = new ulong 8 0
put f 0 999
put f 2 ap_hi get fr 0 h fr
p = get fr 1
put f 3 ap_nz p
put f 5 and get fr 2 UMAX
ap_set s op get f 2 get f 3 get f 5
if eq ap_run s b r fr 0
ret 999
end
if eq ap_fin s get f 5 get f 3 0 0
ret 999
end
n = get s 7
if ne n 0
put f 4 n
put f 1 1
end
put f 0 ap_code s
c = ap_res f 1
if or not ap_ok f 1 eq get f 1 0
ret c
end
n = get f 4
if or eq p 0 eq n 0
ret 999
end
if or gt n get f 5 gt n 22800
ret 999
end
if ne get b add OO sub n 1 0
ret 999
end
z = memcpy p add get fr 9 OO n
ret c
end

export fn nvmlDeviceGetName fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 h edit ulong 16 to int
ret ap_str fr s b r h 5
end

export fn nvmlDeviceGetUUID fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 h edit ulong 16 to int
ret ap_str fr s b r h 6
end

note Temperature: f 2 device, f 3 sensor, f 4 temp present, f 5 the temperature.
export fn nvmlDeviceGetTemperature fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 h edit ulong 16 to int
f = new ulong 8 0
put f 0 999
put f 2 ap_hi get fr 0 h fr
put f 3 and get fr 1 UMAX
p = get fr 2
put f 4 ap_nz p
ap_set s 7 get f 2 get f 4 get f 3
if eq ap_run s b r fr 0
ret 999
end
if eq ap_fin s 0 0 get f 4 0
ret 999
end
if ne get s 27 0
put f 5 get s 5
put f 1 1
end
put f 0 ap_code s
c = ap_res f 1
if or not ap_ok f 1 eq get f 1 0
ret c
end
if or eq p 0 gt get f 5 UMAX
ret 999
end
ap_put p get f 5 4 r fr
ret c
end

note Memory (24 bytes) and utilization (8 bytes): f 2 device, f 3 record present.
fn ap_rec fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 h view ulong 16 op ulong to int
f = new ulong 8 0
put f 0 999
put f 2 ap_hi get fr 0 h fr
p = get fr 1
put f 3 ap_nz p
sz = ulong 24
if eq op 9
sz = 8
end
ap_set s op get f 2 get f 3 0
if eq ap_run s b r fr 0
ret 999
end
if eq ap_fin s sz get f 3 0 0
ret 999
end
n = get s 7
if ne n 0
if ne n sz
ret 999
end
put f 1 1
end
put f 0 ap_code s
c = ap_res f 1
if or not ap_ok f 1 eq get f 1 0
ret c
end
if eq p 0
ret 999
end
z = memcpy p add get fr 9 OO sz
ret c
end

export fn nvmlDeviceGetMemoryInfo fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 h edit ulong 16 to int
ret ap_rec fr s b r h 8
end

export fn nvmlDeviceGetUtilizationRates fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 h edit ulong 16 to int
ret ap_rec fr s b r h 9
end

note Processes: f 2 device, f 3 infoCount present, f 4 *infoCount, f 5 infos present, f 6 records written;
note the capacity is 24 bytes per requested entry; f 7 the caller's *infoCount.
export fn nvmlDeviceGetComputeRunningProcesses_v3 fr view ulong 14 s edit ulong SN b edit uchar BN r edit ulong 8 h edit ulong 16 to int
f = new ulong 8 0
put f 0 999
put f 2 ap_hi get fr 0 h fr
p = get fr 1
put f 3 ap_nz p
if ne p 0
put r 2 0
z = memcpy add get fr 10 16 p 4
put f 4 get r 2
end
put f 7 get f 4
put f 5 ap_nz get fr 2
c = ap_procs f s b r fr
if eq c 1000
ret 999
end
ap_pout f b r fr
ret c
end

note the body of GetComputeRunningProcesses_v3 (nv_procs) and the glue's checks; its answer, or 1000 when the
note glue's o_ok is false (the export answers 999 then and writes nothing)
fn ap_procs f edit ulong 8 s edit ulong SN b edit uchar BN r edit ulong 8 fr view ulong 14 to int
w = get f 4
put s 0 10
put s 1 get f 2
put s 2 get f 3
put s 3 w
put s 4 get f 5
if eq ap_run s b r fr 0
ret 1000
end
if eq ap_fin s mul w 24 get f 5 get f 3 0
ret 1000
end
m = ulong 0
n = get s 7
if ne n 0
if ne rem n 24 0
ret 1000
end
put f 6 div n 24
m = 4
end
if ne get s 27 0
put f 4 get s 5
m = add m 2
end
put f 1 m
put f 0 ap_code s
ret ap_pchk f fr
end

note the glue's checks for GetComputeRunningProcesses_v3: *infoCount below 2^32, at most the requested and
note at most 950 records, each output with its pointer; 1000 when one fails
fn ap_pchk f edit ulong 8 fr view ulong 14 to int
if not ap_ok f 6
ret 1000
end
c = ap_res f 6
m = get f 1
if ne and m 2 0
if or eq get fr 1 0 gt get f 4 UMAX
ret 1000
end
end
if eq and m 4 0
ret c
end
e = get f 6
if eq get fr 2 0
ret 1000
end
if or gt e get f 7 gt e 950
ret 1000
end
ret c
end

note the outputs of GetComputeRunningProcesses_v3: *infoCount, then each record field by field
fn ap_pout f edit ulong 8 b edit uchar BN r edit ulong 8 fr view ulong 14 to void
m = get f 1
if ne and m 2 0
ap_put get fr 1 get f 4 4 r fr
end
if eq and m 4 0
ret
end
d = get fr 2
o = add get fr 9 OO
for j ulong get f 6 bound 950
e = mul j 24
z = memcpy add d e add o e 4
z = memcpy add add d e 8 add add o e 8 8
z = memcpy add add d e 16 add add o e 16 4
z = memcpy add add d e 20 add add o e 20 4
end
end

note ErrorString: the code sign-extended from the C int; each cache slot is filled once, so a returned
note pointer stays valid and unchanged for the life of the process; anything else answers "Unknown Error"
note (the fallback at NvT 2048, written from errstr's own text).
export fn nvmlErrorString fr view ulong 14 t edit uchar 2144 to ulong
fb = add get fr 11 2048
k = ap_eslot t get fr 0
if ge k 32
ret fb
end
if ge ap_elen t mul k 64 64
ret fb
end
ret add get fr 11 mul k 64
end

note ap_eslot: the cache slot of the C int x (sign-extended), filled on first use; 32 when the text does not fit.
note Writes the fallback text at 2048 first, once.
fn ap_eslot t edit uchar 2144 x ulong to ulong
o = new uchar 64 0
if eq get t 2048 0
v = nvml_errstr 1000 o
ap_ecopy t 2048 o
end
code = and x UMAX
if ge code 2147483648
code = or code 18446744069414584320
end
v = nvml_errstr code o
n = and v 255
k = and shr v 8 255
if or ge n 64 ge k 32
ret 32
end
if eq ulong get t add 2112 k 0
ap_ecopy t mul k 64 o
put t add mul k 64 n uchar 0
put t add 2112 k uchar 1
end
ret k
end

fn ap_ecopy t edit uchar 2144 z ulong o view uchar 64 to void
for j ulong 64
put t add z j get o j
end
end

note ap_elen: the offset of the first NUL in the 64 bytes at z (64: none)
fn ap_elen t view uchar 2144 z ulong to ulong
for i ulong 64
if eq ulong get t add z i 0
ret i
end
end
ret 64
end

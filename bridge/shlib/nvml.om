om2
note SPDX-License-Identifier: Apache-2.0
note bridge/shlib/nvml.om: the 11 functions CUDApp's libnvidia-ml.so.1 exports (its libnvidia-ml.map), with
note the C signatures of its nvml.h, as stubs: every query answers NVML_ERROR_NOT_SUPPORTED (3) and writes
note nothing, nvmlErrorString answers NULL. A C pointer to a struct or buffer is a sized edit (one register);
note nvmlDevice_t is an opaque pointer, a ulong. Built into a library by bridge/shlib/shlib.om (nvml.tsv).
export fn nvmlInit_v2 to int
ret 3
end
export fn nvmlShutdown to int
ret 3
end
note const char *nvmlErrorString(nvmlReturn_t): the stub returns NULL (a function-mode unit has no data
note section to point into)
export fn nvmlErrorString r int to ulong
ret 0
end
export fn nvmlDeviceGetCount_v2 n edit uint 1 to int
ret 3
end
export fn nvmlDeviceGetHandleByIndex_v2 i uint d edit ulong 1 to int
ret 3
end
export fn nvmlDeviceGetName d ulong s edit uchar 1 n uint to int
ret 3
end
export fn nvmlDeviceGetUUID d ulong s edit uchar 1 n uint to int
ret 3
end
export fn nvmlDeviceGetTemperature d ulong t int v edit uint 1 to int
ret 3
end
export fn nvmlDeviceGetMemoryInfo d ulong m edit ulong 3 to int
ret 3
end
export fn nvmlDeviceGetUtilizationRates d ulong u edit uint 2 to int
ret 3
end
export fn nvmlDeviceGetComputeRunningProcesses_v3 d ulong n edit uint 1 p edit uchar 24 to int
ret 3
end

note SPDX-License-Identifier: Apache-2.0
note bridge/shlib/gate.om: OMEGA-SHLIB, the gate of bridge/shlib (shared libraries written by Omega alone), in
note seeded Omega (Linux AArch64). Build from the repository root (OM-2 program mode; seed/ng/sha256.om supplies
note sh_dat, sh_all, sh_dig, sh_hexd):
note   { printf 'om2\n'; cat seed/ng/sha256.om bridge/shlib/gate.om; } | seed/out/omc > shlib-gate
note   seed/out/omc < bridge/shlib/shlib.om > shlib
note Run from the repository root: shlib-gate OMC SHLIB SCRATCH
note OMC      the compiler; its sha256 must equal the first word of seed/out/omc.sha256, or nothing runs (exit 69)
note SHLIB    the generator built from bridge/shlib/shlib.om
note SCRATCH  a new directory (created 0700), at most 1024 bytes of path; an existing one is refused (exit 2)
note Checks, each an exact exit status: OMC compiles bridge/shlib/test.om and nvml.om in object mode (0); SHLIB
note writes each library and its probe (0); each probe, run by the system's dynamic loader, makes every call row
note of its table and gets the expected results with x19..x27 and sp preserved (0); a second build of the test
note library holds the same bytes.
note Controls, each must be caught with its exact status:
note   row      a malformed call row (EXPECT 7x) appended to test.tsv: SHLIB refuses it (1)
note   export   omega_shlib_div's export row and its call rows removed from the library's table, the probe
note            (built from the full table) still needs it: the loader refuses the probe (127)
note   hash     every .hash bucket of the test library zeroed: no symbol resolves (127)
note   expect   the first call's EXPECT changed from 7 to 8: the probe reports call 0 (1)
note   stack    the shared return's ADD SP, SP, #192 turned into ADD SP, SP, #208, so every call returns with
note            sp 16 bytes high: the probe's stack check reports it (250)
note Output: one line per check and control, then OMEGA-SHLIB PASS|FAIL checks=N controls=C caught=K.
note Exit 0 PASS, 1 FAIL, 2 bad usage or setup, 69 compiler digest refused.
global g_pin uchar 64
global g_hx uchar 64
global g_stb uchar 4
global g_n ulong 32
global g_pa uchar 4096
global g_scr uchar 4096
global g_omc uchar 4096
global g_gen uchar 4096
global g_av uchar 16384
global g_o uchar 8192
global g_b uchar 4194304
note g_n: 0 path length, 1 omc length, 2 scratch length (with '/'), 3 argv bytes, 4 argc, 5 output length,
note 6 buffer length, 7 generator length, 8 checks, 11 failures, 12 controls, 13 caught
text t_pin "seed/out/omc.sha256"
text t_null "/dev/null"
text t_ttab "bridge/shlib/test.tsv"
text t_tunit "bridge/shlib/test.om"
text t_ntab "bridge/shlib/nvml.tsv"
text t_nunit "bridge/shlib/nvml.om"
text t_obj "object\n"
text t_tsrc "test.src"
text t_tobj "test.obj"
text t_nsrc "nvml.src"
text t_nobj "nvml.obj"
text t_tlib "libomshlib.so.1"
text t_nlib "libnvidia-ml.so.1"
text t_tprb "probe"
text t_nprb "nvprobe"
text t_again "again.so"
text t_c1 "c1.tsv"
text t_c1so "c1.so"
text t_c2 "c2.tsv"
text t_d2 "c2"
text t_c2lib "c2/libomshlib.so.1"
text t_c2prb "c2/probe"
text t_d3 "c3"
text t_c3lib "c3/libomshlib.so.1"
text t_c3prb "c3/probe"
text t_c4 "c4.tsv"
text t_c4prb "probe4"
text t_d5 "c5"
text t_c5lib "c5/libomshlib.so.1"
text t_c5prb "c5/probe"
text t_lout "log.out"
text t_lerr "log.err"
text t_lib "lib"
text t_call "call"
text t_bad "call\tomega_shlib_seven\t7x\n"
text t_div "export\tomega_shlib_div\t999\n"
text t_divc "call\tomega_shlib_div\t"
text t_seven "call\tomega_shlib_seven\t7\n"
text t_k1 "compile test.om"
text t_k2 "compile nvml.om"
text t_k3 "lib test"
text t_k4 "probe test"
text t_k5 "run test probe"
text t_k6 "lib nvml"
text t_k7 "probe nvml"
text t_k8 "run nvml probe"
text t_k9 "lib test again"
text t_k10 "same bytes"
text t_x1 "row"
text t_x2 "export"
text t_x3 "hash"
text t_x4 "expect"
text t_x5 "stack"
text t_ok "ok "
text t_fail "FAIL "
text t_ctl "control "
text t_exit " exit="
text t_want " expected="
text t_caught " caught"
text t_esc " ESCAPED"
text t_setup " setup failed"
text t_sum "OMEGA-SHLIB "
text t_pass "PASS"
text t_fl "FAIL"
text t_sk " checks="
text t_sc " controls="
text t_scc " caught="
text t_usage "usage: shlib-gate OMC SHLIB SCRATCH (run from the omega-mv repository root)\n"
text t_refd "OMEGA-SHLIB REFUSED: compiler digest differs from seed/out/omc.sha256 (exit 69)\n"
text t_nopin "OMEGA-SHLIB INVALID: cannot read a 64-hex digest from seed/out/omc.sha256\n"
text t_noscr "OMEGA-SHLIB INVALID: SCRATCH exists or cannot be made\n"
text t_long "OMEGA-SHLIB INVALID: SCRATCH path longer than 1024 bytes\n"
note ---- output
fn oc c ulong to void
n = get g_n 5
if ge n len g_o
r = write 1 g_o 0 n
n = 0
end
put g_o n uchar c
put g_n 5 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn oflush to void
r = write 1 g_o 0 get g_n 5
put g_n 5 0
end
note ---- paths: g_pa[0, g_n 0)
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
put g_pa n uchar c
put g_n 0 add n 1
end
fn pt t view uchar * to void
for i ulong len t bound 4096
pc ulong get t i
end
end
note a file in SCRATCH
fn psc t view uchar * to void
pclr
for j ulong get g_n 2 bound 4096
pc ulong get g_scr j
end
pt t
end
note a path relative to the repository root
fn prp t view uchar * to void
pclr
pt t
end
note ---- files
fn fopn fl ulong mode ulong to int
r = fopen g_pa 0 get g_n 0 int fl int mode
if lt r 0
ret -1
end
ret int r
end
fn frd to int
ret fopn 524288 0
end
fn fwr to int
ret fopn 524865 420
end
fn fexe to int
r = unlink g_pa 0 get g_n 0
ret fopn 524865 448
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
note append the file at g_pa to g_b; false when unreadable or past the buffer
fn bload to bool
fd = frd
if lt fd 0
ret false
end
n = get g_n 6
ok = true
while true bound 4194306
x = read fd g_b n sub len g_b n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len g_b
ok = false
break
end
end
fclo fd
put g_n 6 n
ret ok
end
note write g_b[0, g_n 6) to the file at g_pa (0644, or 0700 when exe)
fn bsave exe bool to bool
fd = int -1
if exe
fd = fexe
else
fd = fwr
end
if lt fd 0
ret false
end
n = get g_n 6
o = ulong 0
ok = true
while lt o n bound 4194305
x = write fd g_b o sub n o
if le x 0
ok = false
break
end
o = add o ulong x
end
fclo fd
ret ok
end
note append text t to g_b
fn bapp t view uchar * to bool
n = get g_n 6
if gt add n len t len g_b
ret false
end
for i ulong len t bound 4096
put g_b add n i get t i
end
put g_n 6 add n len t
ret true
end
note the first offset of text t in g_b[0, g_n 6), or 2^63 when absent
fn bfind t view uchar * to ulong
n = get g_n 6
if lt n len t
ret shl ulong 1 63
end
for o ulong add sub n len t 1 bound 4194305
if bat o t
ret o
end
end
ret shl ulong 1 63
end
fn bat o ulong t view uchar * to bool
for i ulong len t bound 4096
if ne get g_b add o i get t i
ret false
end
end
ret true
end
note remove g_b[o, o + k)
fn bcut o ulong k ulong to void
n = get g_n 6
for i ulong sub sub n o k bound 4194305
put g_b add o i get g_b add add o k i
end
put g_n 6 sub n k
end
note the offset just past the newline at or after o in g_b (the buffer's end when there is none)
fn bnl o ulong to ulong
n = get g_n 6
for i ulong sub n o bound 4194305
if eq get g_b add o i 10
ret add add o i 1
end
end
ret n
end
note load the file named by the scratch text t into g_b alone; false when unreadable
fn sload t view uchar * to bool
put g_n 6 0
psc t
ret bload
end
fn rload t view uchar * to bool
put g_n 6 0
prp t
ret bload
end
note ---- the compiler digest
fn pinread to bool
if not rload t_pin
ret false
end
if lt get g_n 6 64
ret false
end
for j ulong 64
c = get g_b j
ok = or and ge c 48 le c 57 and ge c 97 le c 102
if not ok
ret false
end
put g_pin j c
end
ret true
end
fn pinok to bool
fd = frd
if lt fd 0
ret false
end
n = ulong 0
ok = true
while true bound 16777218
x = read fd sh_dat n sub len sh_dat n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len sh_dat
ok = false
break
end
end
fclo fd
if not ok
ret false
end
sh_all n
for j ulong 32
b = get sh_dig j
if ne get g_pin mul j 2 sh_hexd uint shr b 4
ret false
end
if ne get g_pin add mul j 2 1 sh_hexd uint and b 15
ret false
end
end
ret true
end
note ---- processes
fn aclr to void
put g_n 3 2
put g_n 4 0
put g_av 0 0
put g_av 1 0
end
note append g_pa as one argument
fn apa to void
p = get g_n 3
n = get g_n 0
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 3 add p add n 2
c = add get g_n 4 1
put g_n 4 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end
fn atx t view uchar * to void
prp t
apa
end
fn asc t view uchar * to void
psc t
apa
end
fn agen to void
pclr
for j ulong get g_n 7 bound 4096
pc ulong get g_gen j
end
apa
end
fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run the argument list with stdin fi and stdout, stderr in SCRATCH/log.out, log.err: the exit code,
note 256 + the signal, 512 when a file could not be opened, 1000 when the child passed the 600 s deadline
fn spawn fi int to ulong
psc t_lout
fo = fwr
psc t_lerr
fe = fwr
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
fclo fi
fclo fo
fclo fe
t0 = monons
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 600000000000
r = killpid int pid 9
r = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
q = sleepns 200000
end
exit 2
end
fn run to ulong
prp t_null
ret spawn frd
end
note OMC < SCRATCH/src > SCRATCH/obj, src being "object" then the unit u
fn mkobj u view uchar * src view uchar * obj view uchar * to ulong
put g_n 6 0
if not bapp t_obj
ret 512
end
prp u
if not bload
ret 512
end
psc src
if not bsave false
ret 512
end
psc src
fi = frd
aclr
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
apa
ret spawnto fi obj
end
note as spawn, but stdout into the scratch file obj
fn spawnto fi int obj view uchar * to ulong
psc obj
fo = fwr
psc t_lerr
fe = fwr
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
fclo fi
fclo fo
fclo fe
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 0
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
end
exit 2
end
note SHLIB lib TABLE OBJ OUT; tr is TABLE relative to the repository root, else to SCRATCH; OBJ is nvml.obj
note when nv, else test.obj
fn genlib tab view uchar * tr bool nv bool dst view uchar * to ulong
aclr
agen
atx t_lib
if tr
atx tab
else
asc tab
end
if nv
asc t_nobj
else
asc t_tobj
end
asc dst
ret run
end
fn gencall tab view uchar * tr bool dst view uchar * to ulong
aclr
agen
atx t_call
if tr
atx tab
else
asc tab
end
asc dst
ret run
end
fn runprb prb view uchar * to ulong
aclr
asc prb
ret run
end
note ---- results
fn check what view uchar * got ulong want ulong to void
put g_n 8 add get g_n 8 1
if eq got want
ot t_ok
else
put g_n 11 add get g_n 11 1
ot t_fail
end
ot what
ot t_exit
onum got
if ne got want
ot t_want
onum want
end
oc 10
end
fn ctl what view uchar * got ulong want ulong to void
put g_n 12 add get g_n 12 1
ot t_ctl
ot what
if eq got want
put g_n 13 add get g_n 13 1
ot t_caught
else
ot t_esc
end
ot t_exit
onum got
oc 10
end
note a control whose setup failed: counted, never caught
fn csetup what view uchar * to void
put g_n 12 add get g_n 12 1
ot t_ctl
ot what
ot t_setup
oc 10
end
fn mkd t view uchar * to bool
psc t
ret eq makedir g_pa 0 get g_n 0 448 0
end
note copy the scratch file a to the scratch file b (0700)
fn cpexe a view uchar * b view uchar * to bool
if not sload a
ret false
end
psc b
ret bsave true
end
note ---- the checks
fn checks to void
check t_k1 mkobj t_tunit t_tsrc t_tobj 0
check t_k2 mkobj t_nunit t_nsrc t_nobj 0
check t_k3 genlib t_ttab true false t_tlib 0
check t_k4 gencall t_ttab true t_tprb 0
check t_k5 runprb t_tprb 0
check t_k6 genlib t_ntab true true t_nlib 0
check t_k7 gencall t_ntab true t_nprb 0
check t_k8 runprb t_nprb 0
check t_k9 genlib t_ttab true false t_again 0
s = ulong 1
if same2 t_tlib t_again
s = 0
end
check t_k10 s 0
end
note the scratch files a and b hold the same bytes
fn same2 a view uchar * b view uchar * to bool
if not sload a
ret false
end
n = get g_n 6
psc b
if not bload
ret false
end
if ne sub get g_n 6 n n
ret false
end
for i ulong n bound 4194305
if ne get g_b i get g_b add n i
ret false
end
end
ret true
end
note ---- the controls
fn crow to void
if not rload t_ttab
csetup t_x1
ret
end
if not bapp t_bad
csetup t_x1
ret
end
psc t_c1
if not bsave false
csetup t_x1
ret
end
ctl t_x1 genlib t_c1 false false t_c1so 1
end
fn cexport to void
if not rload t_ttab
csetup t_x2
ret
end
o = bfind t_div
if ge o shl ulong 1 63
csetup t_x2
ret
end
bcut o len t_div
o = bfind t_divc
while lt o shl ulong 1 63 bound 4096
bcut o sub bnl o o
o = bfind t_divc
end
psc t_c2
ok = bsave false
ok = and ok mkd t_d2
ok = and ok eq genlib t_c2 false false t_c2lib 0
ok = and ok eq gencall t_ttab true t_c2prb 0
if not ok
csetup t_x2
ret
end
ctl t_x2 runprb t_c2prb 127
end
fn chash to void
ok = mkd t_d3
ok = and ok sload t_tlib
if not ok
csetup t_x3
ret
end
note SysV .hash at 288: nbucket (u32), nchain (u32), then the buckets
nb = or ulong get g_b 288 shl ulong get g_b 289 8
for i ulong mul nb 4 bound 65536
put g_b add 296 i 0
end
psc t_c3lib
ok = bsave false
ok = and ok cpexe t_tprb t_c3prb
if not ok
csetup t_x3
ret
end
ctl t_x3 runprb t_c3prb 127
end
fn cexpect to void
if not rload t_ttab
csetup t_x4
ret
end
o = bfind t_seven
if ge o shl ulong 1 63
csetup t_x4
ret
end
put g_b sub add o len t_seven 2 56
psc t_c4
ok = bsave false
ok = and ok eq gencall t_c4 false t_c4prb 0
if not ok
csetup t_x4
ret
end
ctl t_x4 runprb t_c4prb 1
end
fn cstack to void
ok = mkd t_d5
ok = and ok sload t_tlib
if not ok
csetup t_x5
ret
end
note the first ADD SP, SP, #192 (0x910303ff, bytes ff 03 03 91) is the shared return's; byte 1 0x43 makes
note the immediate 208
o = bfind4 255 3 3 145
if ge o shl ulong 1 63
csetup t_x5
ret
end
put g_b add o 1 67
psc t_c5lib
ok = bsave false
ok = and ok cpexe t_tprb t_c5prb
if not ok
csetup t_x5
ret
end
ctl t_x5 runprb t_c5prb 250
end
note g_b[o] is v
fn bis o ulong v ulong to bool
ret eq ulong get g_b o v
end
note the first 4-aligned offset of the bytes a b c d in g_b, or 2^63
fn bfind4 a ulong b ulong c ulong d ulong to ulong
n = div get g_n 6 4
for i ulong n bound 1048577
o = mul i 4
ok = and bis o a bis add o 1 b
ok = and ok and bis add o 2 c bis add o 3 d
if ok
ret o
end
end
ret shl ulong 1 63
end
note ---- main
fn ausage to int
r = write 2 t_usage 0 len t_usage
ret 2
end
fn main to int
if ne argcnt 4
ret ausage
end
r = argread 1 g_omc 0 4095
if lt r 1
ret ausage
end
put g_n 1 ulong r
if not pinread
r = write 2 t_nopin 0 len t_nopin
ret 2
end
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
if not pinok
r = write 2 t_refd 0 len t_refd
ret 69
end
r = argread 2 g_gen 0 4095
if lt r 1
ret ausage
end
put g_n 7 ulong r
r = argread 3 g_scr 0 4094
if lt r 1
ret ausage
end
if gt r 1024
r = write 2 t_long 0 len t_long
ret 2
end
n = ulong r
x = makedir g_scr 0 n 448
if ne x 0
r = write 2 t_noscr 0 len t_noscr
ret 2
end
put g_scr n 47
put g_n 2 add n 1
checks
crow
cexport
chash
cexpect
cstack
f = get g_n 11
ot t_sum
if eq f 0
ot t_pass
else
ot t_fl
end
ot t_sk
onum get g_n 8
ot t_sc
onum get g_n 12
ot t_scc
onum get g_n 13
oc 10
oflush
if ne f 0
ret 1
end
if ne get g_n 12 get g_n 13
ret 1
end
ret 0
end

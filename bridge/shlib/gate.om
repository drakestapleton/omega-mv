note SPDX-License-Identifier: Apache-2.0
note bridge/shlib/gate.om: OMEGA-SHLIB, the gate of bridge/shlib (shared libraries written by Omega alone), in
note seeded Omega (Linux AArch64). Build from the repository root (OM-2 program mode; seed/ng/sha256.om supplies
note sh_dat, sh_all, sh_dig, sh_hexd):
note   { printf 'om2\n'; cat seed/ng/sha256.om bridge/shlib/gate.om; } | seed/out/omc > shlib-gate
note   seed/out/omc < bridge/shlib/shlib.om > shlib
note Run from the repository root: shlib-gate OMC SHLIB SCRATCH
note OMC      the compiler; its sha256 must equal the first word of seed/out/omc.sha256, or nothing runs (exit 69)
note SHLIB    the generator built from bridge/shlib/shlib.om
note SCRATCH  a new directory (created 0700); an existing one is refused (exit 2), and so is a path too long to hold
note          its files within Linux's 4096-byte PATH_MAX
note Checks, each an exact exit status: OMC compiles bridge/shlib/test.om and nvml.om in object mode (0); SHLIB
note writes each library and its probe (0); each probe, run by the system's dynamic loader, makes every call row
note of its table and gets the expected results with x19..x27, x29, d8..d15 and sp preserved (0);
note /usr/bin/readelf -W -S -d --dyn-syms reads each library through its section headers without a warning,
note shows the table's soname and lists every export of its table (0; readelf is a read-only verification
note oracle); a second build of the test library from the same object holds the same bytes.
note Controls, each must be caught with its exact status (and, where named, its text in stderr):
note   row      a malformed call row (EXPECT 7x) appended to test.tsv: SHLIB refuses it (1, "malformed number")
note   export   omega_shlib_div's export row and its call rows removed from the library's table, the probe
note            (built from the full table) still needs it: the loader refuses the probe
note            (127, "undefined symbol: omega_shlib_div")
note   hash     every .hash bucket of the test library zeroed: no symbol resolves (127, "undefined symbol: ")
note   expect   the first call's EXPECT changed from 7 to 8: the probe reports call 0 (1)
note   stack    the shared return's ADD SP, SP, #192 turned into ADD SP, SP, #208, so every call returns with
note            sp 16 bytes high: the probe's stack check reports it (250)
note   extend   the wrappers' SXTW X0, W0 and SXTW X1, W1 turned into NOP: omc's int add finds the sum of -3 (zero
note            upper half) and 10 outside int and traps, so call 1 answers 999 for 7 (2)
note   uextend  every UXTW (UBFX X, X, #0, #32) turned into NOP: call 9 (a uint with a dirty upper half) fails (10)
note   nextend  every UXTB, UXTH, SXTB and SXTH turned into NOP: call 12 (a uchar with dirty upper bits) fails (13)
note   restore  the shared return's LDP X19, X20, [SP, #32] turned into [SP, #48]: x19 and x20 come back wrong (250)
note   runtime  one trap-entry load LDR X16, [X7, #16] in test.obj turned into [X7, #0], a runtime entry the
note            library does not provide: SHLIB refuses the object (1, "runtime entry")
note   need     the private function deep's frame in test.obj made 16 bytes smaller: the export's settled need
note            drops from 16400 to 16384 bytes, so its probe covers 4 pages, not 5: the stack probe check reports
note            it (1); the generator must accept the object
note   address  omega_shlib_seven's address in test.obj moved by 2 bytes: SHLIB refuses the object (1, "not an
note            OMOBJ001")
note   frestore the shared return's LDP D8, D9, [SP, #128] turned into [SP, #144]: d8 and d9 come back wrong (250)
note The stack probe check reads the test library's wrappers: exactly two probes, sum's covering 2 pages and
note deep's 5 (16400 bytes through its private call), in that order.
note The extend, uextend and nextend controls change only the wrappers' words, found through .dynsym.
note Output: one line per check and control, then OMEGA-SHLIB PASS|FAIL checks=N controls=C caught=K.
note Exit 0 PASS, 1 FAIL, 2 bad usage or setup, 69 compiler digest refused.
global g_pin uchar 64
global g_hx uchar 64
global g_stb uchar 4
global g_n ulong 32
global g_pa uchar 4096
global g_scr uchar 4096
global g_omc uchar 4096
global g_gen uchar 4096
global g_av uchar 16384
global g_o uchar 8192
global g_b uchar *
note g_n: 0 path length, 1 omc length, 2 scratch length (with '/'), 3 argv bytes, 4 argc, 5 output length,
note 6 buffer length, 7 generator length, 8 checks, 11 failures, 12 controls, 13 caught, 14 and 15 the
note wrappers' range, 16 probe loops found, 17 a probe loop with the wrong page count
text t_pin "seed/out/omc.sha256"
text t_null "/dev/null"
text t_ttab "bridge/shlib/test.tsv"
text t_tunit "bridge/shlib/test.om"
text t_ntab "bridge/shlib/nvml.tsv"
text t_nunit "bridge/shlib/nvml.om"
text t_obj "object\n"
text t_tsrc "test.src"
text t_tobj "test.obj"
text t_nsrc "nvml.src"
text t_nobj "nvml.obj"
text t_tlib "libomshlib.so.1"
text t_nlib "libnvidia-ml.so.1"
text t_tprb "probe"
text t_nprb "nvprobe"
text t_again "again.so"
text t_c1 "c1.tsv"
text t_c1so "c1.so"
text t_c2 "c2.tsv"
text t_d2 "c2"
text t_c2lib "c2/libomshlib.so.1"
text t_c2prb "c2/probe"
text t_d3 "c3"
text t_c3lib "c3/libomshlib.so.1"
text t_c3prb "c3/probe"
text t_c4 "c4.tsv"
text t_c4prb "probe4"
text t_d5 "c5"
text t_c5lib "c5/libomshlib.so.1"
text t_c5prb "c5/probe"
text t_d6 "c6"
text t_c6lib "c6/libomshlib.so.1"
text t_c6prb "c6/probe"
text t_d8 "c8"
text t_c8lib "c8/libomshlib.so.1"
text t_c8prb "c8/probe"
text t_d9 "c9"
text t_c9lib "c9/libomshlib.so.1"
text t_c9prb "c9/probe"
text t_c7obj "c7.obj"
text t_c7so "c7.so"
text t_relf "/usr/bin/readelf"
text t_aw "-W"
text t_as "-S"
text t_ad "--dyn-syms"
text t_add "-d"
text t_exp "export\t"
text t_son "soname\t"
text t_lsn "Library soname: ["
text t_mnum "malformed number"
text t_udiv "undefined symbol: omega_shlib_div"
text t_usym "undefined symbol: "
text t_mrt "runtime entry"
text t_mobj "not an OMOBJ001"
text t_fgl "FUNC    GLOBAL DEFAULT"
text t_c10obj "c10.obj"
text t_c10so "c10.so"
text t_c11obj "c11.obj"
text t_c11so "c11.so"
text t_d12 "c12"
text t_c12lib "c12/libomshlib.so.1"
text t_c12prb "c12/probe"
text t_d13 "c13"
text t_c13lib "c13/libomshlib.so.1"
text t_c13prb "c13/probe"
text t_lout "log.out"
text t_lerr "log.err"
text t_lib "lib"
text t_call "call"
text t_bad "call\tomega_shlib_seven\t7x\n"
text t_div "export\tomega_shlib_div\t999\n"
text t_divc "call\tomega_shlib_div\t"
text t_seven "call\tomega_shlib_seven\t7\n"
text t_k1 "compile test.om"
text t_k2 "compile nvml.om"
text t_k3 "lib test"
text t_k4 "probe test"
text t_k5 "run test probe"
text t_k6 "lib nvml"
text t_k7 "probe nvml"
text t_k8 "run nvml probe"
text t_k9 "lib test again"
text t_k10 "same bytes"
text t_k11 "readelf test"
text t_k12 "readelf nvml"
text t_k13 "stack probe words"
text t_x1 "row"
text t_x2 "export"
text t_x3 "hash"
text t_x4 "expect"
text t_x5 "stack"
text t_x6 "extend"
text t_x7 "runtime"
text t_x8 "uextend"
text t_x9 "restore"
text t_x10 "need"
text t_x11 "address"
text t_x12 "frestore"
text t_x13 "nextend"
text t_ok "ok "
text t_fail "FAIL "
text t_ctl "control "
text t_exit " exit="
text t_want " expected="
text t_caught " caught"
text t_esc " ESCAPED"
text t_setup " setup failed"
text t_sum "OMEGA-SHLIB "
text t_pass "PASS"
text t_fl "FAIL"
text t_sk " checks="
text t_sc " controls="
text t_scc " caught="
text t_usage "usage: shlib-gate OMC SHLIB SCRATCH (run from the omega-mv repository root)\n"
text t_refd "OMEGA-SHLIB REFUSED: compiler digest differs from seed/out/omc.sha256 (exit 69)\n"
text t_nopin "OMEGA-SHLIB INVALID: cannot read a 64-hex digest from seed/out/omc.sha256\n"
text t_noscr "OMEGA-SHLIB INVALID: SCRATCH exists or cannot be made\n"
text t_long "OMEGA-SHLIB INVALID: SCRATCH path too long for its files within PATH_MAX (4096 bytes)\n"
note ---- output
fn oc c ulong to void
n = get g_n 5
if ge n len g_o
r = write 1 g_o 0 n
n = 0
end
put g_o n uchar c
put g_n 5 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn oflush to void
r = write 1 g_o 0 get g_n 5
put g_n 5 0
end
note ---- paths: g_pa[0, g_n 0)
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
put g_pa n uchar c
put g_n 0 add n 1
end
fn pt t view uchar * to void
for i ulong len t bound 4096
pc ulong get t i
end
end
note a file in SCRATCH
fn psc t view uchar * to void
pclr
for j ulong get g_n 2 bound 4096
pc ulong get g_scr j
end
pt t
end
note a path relative to the repository root
fn prp t view uchar * to void
pclr
pt t
end
note ---- files
fn fopn fl ulong mode ulong to int
r = fopen g_pa 0 get g_n 0 int fl int mode
if lt r 0
ret -1
end
ret int r
end
fn frd to int
ret fopn 524288 0
end
fn fwr to int
ret fopn 524865 420
end
fn fexe to int
r = unlink g_pa 0 get g_n 0
ret fopn 524865 448
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
note g_b holds at least n bytes; false when the host refuses the growth
fn bgrow n ulong to bool
if le n len g_b
ret true
end
m = mul len g_b 2
if lt m n
m = n
end
r = enlarge g_b m
ret ge r 0
end
note append the file at g_pa to g_b; false when unreadable or the buffer cannot grow
fn bload to bool
fd = frd
if lt fd 0
ret false
end
n = get g_n 6
ok = true
while true bound 9223372036854775807
if not bgrow add n 65536
ok = false
break
end
x = read fd g_b n sub len g_b n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
end
fclo fd
put g_n 6 n
ret ok
end
note write g_b[0, g_n 6) to the file at g_pa (0644, or 0700 when exe)
fn bsave exe bool to bool
fd = int -1
if exe
fd = fexe
else
fd = fwr
end
if lt fd 0
ret false
end
n = get g_n 6
o = ulong 0
ok = true
while lt o n bound 9223372036854775807
x = write fd g_b o sub n o
if le x 0
ok = false
break
end
o = add o ulong x
end
fclo fd
ret ok
end
note append text t to g_b
fn bapp t view uchar * to bool
n = get g_n 6
if not bgrow add n len t
ret false
end
for i ulong len t bound 4096
put g_b add n i get t i
end
put g_n 6 add n len t
ret true
end
note the first offset of text t in g_b[0, g_n 6), or 2^63 when absent
fn bfind t view uchar * to ulong
n = get g_n 6
if lt n len t
ret shl ulong 1 63
end
for o ulong add sub n len t 1 bound 9223372036854775807
if bat o t
ret o
end
end
ret shl ulong 1 63
end
fn bat o ulong t view uchar * to bool
for i ulong len t bound 4096
if ne get g_b add o i get t i
ret false
end
end
ret true
end
note remove g_b[o, o + k)
fn bcut o ulong k ulong to void
n = get g_n 6
for i ulong sub sub n o k bound 9223372036854775807
put g_b add o i get g_b add add o k i
end
put g_n 6 sub n k
end
note the offset just past the newline at or after o in g_b (the buffer's end when there is none)
fn bnl o ulong to ulong
n = get g_n 6
for i ulong sub n o bound 9223372036854775807
if eq get g_b add o i 10
ret add add o i 1
end
end
ret n
end
note load the file named by the scratch text t into g_b alone; false when unreadable
fn sload t view uchar * to bool
put g_n 6 0
psc t
ret bload
end
fn rload t view uchar * to bool
put g_n 6 0
prp t
ret bload
end
note ---- the compiler digest
fn pinread to bool
if not rload t_pin
ret false
end
if lt get g_n 6 64
ret false
end
for j ulong 64
c = get g_b j
ok = or and ge c 48 le c 57 and ge c 97 le c 102
if not ok
ret false
end
put g_pin j c
end
ret true
end
note the sha256 of the file at g_pa, streamed through sh_dat in whole 64-byte blocks (no size limit), equals g_pin
fn pinok to bool
fd = frd
if lt fd 0
ret false
end
sh_init
for j ulong 8
put sh_h j get sh_k add j 64
end
t = ulong 0
r = ulong 0
ok = true
while true bound 9223372036854775807
x = read fd sh_dat r sub len sh_dat r
if lt x 0
ok = false
break
end
if eq x 0
break
end
t = add t ulong x
r = gblks add r ulong x
end
fclo fd
if not ok
ret false
end
gfin t r
for j ulong 32
b = get sh_dig j
if ne get g_pin mul j 2 sh_hexd uint shr b 4
ret false
end
if ne get g_pin add mul j 2 1 sh_hexd uint and b 15
ret false
end
end
ret true
end
note hash the whole blocks of sh_dat[0, m), move the rest to the front; its length
fn gblks m ulong to ulong
nb = div m 64
for b ulong nb bound 262144
sh_blk 0 mul b 64
end
r = rem m 64
o = mul nb 64
for j ulong r bound 64
put sh_dat j get sh_dat add o j
end
ret r
end
note the padding of FIPS 180-4 for a message of n bytes whose last r bytes are sh_dat[0, r); digest into sh_dig
fn gfin n ulong r ulong to void
for j ulong 128
put sh_pad j 0
end
for j ulong r bound 64
put sh_pad j get sh_dat j
end
put sh_pad r 128
e = ulong 64
if ge r 56
e = 128
end
bits = mul n 8
for j ulong 8
put sh_pad sub sub e 1 j uchar and shr bits mul j 8 255
end
sh_blk 1 0
if eq e 128
sh_blk 1 64
end
sh_out
end
note ---- processes
fn aclr to void
put g_n 3 2
put g_n 4 0
put g_av 0 0
put g_av 1 0
end
note append g_pa as one argument
fn apa to void
p = get g_n 3
n = get g_n 0
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 3 add p add n 2
c = add get g_n 4 1
put g_n 4 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end
fn atx t view uchar * to void
prp t
apa
end
fn asc t view uchar * to void
psc t
apa
end
fn agen to void
pclr
for j ulong get g_n 7 bound 4096
pc ulong get g_gen j
end
apa
end
fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run the argument list with stdin fi and stdout, stderr in SCRATCH/log.out, log.err: the exit code,
note 256 + the signal, 512 when a file could not be opened, 1000 when the child passed the 600 s deadline
fn spawn fi int to ulong
psc t_lout
fo = fwr
psc t_lerr
fe = fwr
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
fclo fi
fclo fo
fclo fe
ret reap pid
end
note wait for the child pid: its exit code, 256 + the signal, or 1000 after the 600 s deadline (killed)
fn reap pid long to ulong
t0 = monons
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 600000000000
r = killpid int pid 9
r = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
q = sleepns 200000
end
exit 2
end
fn run to ulong
prp t_null
ret spawn frd
end
note OMC < SCRATCH/src > SCRATCH/obj, src being "object" then the unit u
fn mkobj u view uchar * src view uchar * obj view uchar * to ulong
put g_n 6 0
if not bapp t_obj
ret 512
end
prp u
if not bload
ret 512
end
psc src
if not bsave false
ret 512
end
psc src
fi = frd
aclr
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
apa
ret spawnto fi obj
end
note as spawn, but stdout into the scratch file obj
fn spawnto fi int obj view uchar * to ulong
psc obj
fo = fwr
psc t_lerr
fe = fwr
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
fclo fi
fclo fo
fclo fe
ret reap pid
end
note SHLIB lib TABLE OBJ OUT; tr is TABLE relative to the repository root, else to SCRATCH; OBJ is test.obj
note when ob is 0, nvml.obj when 1, the controls' c7.obj (runtime), c10.obj (need) or c11.obj (address) for 2..4
fn genlib tab view uchar * tr bool ob ulong dst view uchar * to ulong
aclr
agen
atx t_lib
if tr
atx tab
else
asc tab
end
if eq ob 1
asc t_nobj
else
if eq ob 2
asc t_c7obj
else
if eq ob 3
asc t_c10obj
else
if eq ob 4
asc t_c11obj
else
asc t_tobj
end
end
end
end
asc dst
ret run
end
fn gencall tab view uchar * tr bool dst view uchar * to ulong
aclr
agen
atx t_call
if tr
atx tab
else
asc tab
end
asc dst
ret run
end
fn runprb prb view uchar * to ulong
aclr
asc prb
ret run
end
note ---- results
fn check what view uchar * got ulong want ulong to void
put g_n 8 add get g_n 8 1
if eq got want
ot t_ok
else
put g_n 11 add get g_n 11 1
ot t_fail
end
ot what
ot t_exit
onum got
if ne got want
ot t_want
onum want
end
oc 10
end
fn ctl what view uchar * got ulong want ulong to void
ctlx what got want eq got want
end
note a control caught when its status is want and the scratch log.err holds t
fn ctle what view uchar * got ulong want ulong t view uchar * to void
ok = and eq got want errhas t
ctlx what got want ok
end
fn errhas t view uchar * to bool
if not sload t_lerr
ret false
end
ret lt bfind t shl ulong 1 63
end
fn ctlx what view uchar * got ulong want ulong ok bool to void
put g_n 12 add get g_n 12 1
ot t_ctl
ot what
if ok
put g_n 13 add get g_n 13 1
ot t_caught
else
ot t_esc
end
ot t_exit
onum got
if ne got want
ot t_want
onum want
end
oc 10
end
note a control whose setup failed: counted, never caught
fn csetup what view uchar * to void
put g_n 12 add get g_n 12 1
ot t_ctl
ot what
ot t_setup
oc 10
end
fn mkd t view uchar * to bool
psc t
ret eq makedir g_pa 0 get g_n 0 448 0
end
note copy the scratch file a to the scratch file b (0700)
fn cpexe a view uchar * b view uchar * to bool
if not sload a
ret false
end
psc b
ret bsave true
end
note ---- the checks
fn checks to void
check t_k1 mkobj t_tunit t_tsrc t_tobj 0
check t_k2 mkobj t_nunit t_nsrc t_nobj 0
check t_k3 genlib t_ttab true 0 t_tlib 0
check t_k4 gencall t_ttab true t_tprb 0
check t_k5 runprb t_tprb 0
check t_k6 genlib t_ntab true 1 t_nlib 0
check t_k7 gencall t_ntab true t_nprb 0
check t_k8 runprb t_nprb 0
check t_k11 relf t_ttab t_tlib 0
check t_k12 relf t_ntab t_nlib 0
check t_k13 pchk t_tlib 0
check t_k9 genlib t_ttab true 0 t_again 0
s = ulong 1
if same2 t_tlib t_again
s = 0
end
check t_k10 s 0
end
note readelf -W -S --dyn-syms on the scratch library lib: 0 when it exits 0 with nothing on stderr and lists
note every export of the table tab; else its status, 300 (stderr not empty) or 301 (an export not listed)
fn relf tab view uchar * lib view uchar * to ulong
aclr
prp t_relf
apa
prp t_aw
apa
prp t_as
apa
prp t_ad
apa
prp t_add
apa
asc lib
r = run
if ne r 0
ret r
end
if not sload t_lerr
ret 300
end
if ne get g_n 6 0
ret 300
end
if not sload t_lout
ret 301
end
m = get g_n 6
prp tab
if not bload
ret 301
end
if not allexp m
ret 301
end
if not sonok m
ret 302
end
ret 0
end
note the table in g_b[m, g_n 6) has a "soname\tNAME" line and g_b[0, m) has "Library soname: [NAME]"
fn sonok m ulong to bool
o = m
while lt o get g_n 6 bound 9223372036854775807
e = bnl o
if bat o t_son
s = add o len t_son
l = ulong 0
while gt get g_b add s l 32 bound 9223372036854775807
l = add l 1
end
ret sfind s l m
end
o = e
end
ret false
end
fn sfind s ulong l ulong m ulong to bool
for i ulong m bound 9223372036854775807
if bat i t_lsn
a = add i len t_lsn
if and bsame a s l eq get g_b add a l 93
ret true
end
end
end
ret false
end
note every "export\tNAME\t" line of the table in g_b[m, g_n 6) has NAME then a newline in g_b[0, m)
fn allexp m ulong to bool
o = m
while lt o get g_n 6 bound 9223372036854775807
e = bnl o
if expat o
s = add o len t_exp
l = ulong 0
while ne get g_b add s l 9 bound 9223372036854775807
l = add l 1
end
if not bline s l m
ret false

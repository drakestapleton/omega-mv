note ---- output
fn oc c ulong to void
n = get g_n 5
if ge n len g_o
r = write 1 g_o 0 n
n = 0
end
put g_o n uchar c
put g_n 5 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn oflush to void
r = write 1 g_o 0 get g_n 5
put g_n 5 0
end
note ---- paths: g_pa[0, g_n 0)
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
put g_pa n uchar c
put g_n 0 add n 1
end
fn pt t view uchar * to void
for i ulong len t bound 4096
pc ulong get t i
end
end
note a file in SCRATCH
fn psc t view uchar * to void
pclr
for j ulong get g_n 2 bound 4096
pc ulong get g_scr j
end
pt t
end
note a path relative to the repository root
fn prp t view uchar * to void
pclr
pt t
end
note ---- files
fn fopn fl ulong mode ulong to int
r = fopen g_pa 0 get g_n 0 int fl int mode
if lt r 0
ret -1
end
ret int r
end
fn frd to int
ret fopn 524288 0
end
fn fwr to int
ret fopn 524865 420
end
fn fexe to int
r = unlink g_pa 0 get g_n 0
ret fopn 524865 448
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
note g_b holds at least n bytes; false when the host refuses the growth
fn bgrow n ulong to bool
if le n len g_b
ret true
end
m = mul len g_b 2
if lt m n
m = n
end
r = enlarge g_b m
ret ge r 0
end
note append the file at g_pa to g_b; false when unreadable or the buffer cannot grow
fn bload to bool
fd = frd
if lt fd 0
ret false
end
n = get g_n 6
ok = true
while true bound 9223372036854775807
if not bgrow add n 65536
ok = false
break
end
x = read fd g_b n sub len g_b n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
end
fclo fd
put g_n 6 n
ret ok
end
note write g_b[0, g_n 6) to the file at g_pa (0644, or 0700 when exe)
fn bsave exe bool to bool
fd = int -1
if exe
fd = fexe
else
fd = fwr
end
if lt fd 0
ret false
end
n = get g_n 6
o = ulong 0
ok = true
while lt o n bound 9223372036854775807
x = write fd g_b o sub n o
if le x 0
ok = false
break
end
o = add o ulong x
end
fclo fd
ret ok
end
note append text t to g_b
fn bapp t view uchar * to bool
n = get g_n 6
if not bgrow add n len t
ret false
end
for i ulong len t bound 4096
put g_b add n i get t i
end
put g_n 6 add n len t
ret true
end
note the first offset of text t in g_b[0, g_n 6), or 2^63 when absent
fn bfind t view uchar * to ulong
n = get g_n 6
if lt n len t
ret shl ulong 1 63
end
for o ulong add sub n len t 1 bound 9223372036854775807
if bat o t
ret o
end
end
ret shl ulong 1 63
end
fn bat o ulong t view uchar * to bool
for i ulong len t bound 4096
if ne get g_b add o i get t i
ret false
end
end
ret true
end
note remove g_b[o, o + k)
fn bcut o ulong k ulong to void
n = get g_n 6
for i ulong sub sub n o k bound 9223372036854775807
put g_b add o i get g_b add add o k i
end
put g_n 6 sub n k
end
note the offset just past the newline at or after o in g_b (the buffer's end when there is none)
fn bnl o ulong to ulong
n = get g_n 6
for i ulong sub n o bound 9223372036854775807
if eq get g_b add o i 10
ret add add o i 1
end
end
ret n
end
note load the file named by the scratch text t into g_b alone; false when unreadable
fn sload t view uchar * to bool
put g_n 6 0
psc t
ret bload
end
fn rload t view uchar * to bool
put g_n 6 0
prp t
ret bload
end
note ---- the compiler digest
fn pinread to bool
if not rload t_pin
ret false
end
if lt get g_n 6 64
ret false
end
for j ulong 64
c = get g_b j
ok = or and ge c 48 le c 57 and ge c 97 le c 102
if not ok
ret false
end
put g_pin j c
end
ret true
end
note the sha256 of the file at g_pa, streamed through sh_dat in whole 64-byte blocks (no size limit), equals g_pin
fn pinok to bool
fd = frd
if lt fd 0
ret false
end
sh_init
for j ulong 8
put sh_h j get sh_k add j 64
end
t = ulong 0
r = ulong 0
ok = true
while true bound 9223372036854775807
x = read fd sh_dat r sub len sh_dat r
if lt x 0
ok = false
break
end
if eq x 0
break
end
t = add t ulong x
r = gblks add r ulong x
end
fclo fd
if not ok
ret false
end
gfin t r
for j ulong 32
b = get sh_dig j
if ne get g_pin mul j 2 sh_hexd uint shr b 4
ret false
end
if ne get g_pin add mul j 2 1 sh_hexd uint and b 15
ret false
end
end
ret true
end
note hash the whole blocks of sh_dat[0, m), move the rest to the front; its length
fn gblks m ulong to ulong
nb = div m 64
for b ulong nb bound 262144
sh_blk 0 mul b 64
end
r = rem m 64
o = mul nb 64
for j ulong r bound 64
put sh_dat j get sh_dat add o j
end
ret r
end
note the padding of FIPS 180-4 for a message of n bytes whose last r bytes are sh_dat[0, r); digest into sh_dig
fn gfin n ulong r ulong to void
for j ulong 128
put sh_pad j 0
end
for j ulong r bound 64
put sh_pad j get sh_dat j
end
put sh_pad r 128
e = ulong 64
if ge r 56
e = 128
end
bits = mul n 8
for j ulong 8
put sh_pad sub sub e 1 j uchar and shr bits mul j 8 255
end
sh_blk 1 0
if eq e 128
sh_blk 1 64
end
sh_out
end
note ---- processes
fn aclr to void
put g_n 3 2
put g_n 4 0
put g_av 0 0
put g_av 1 0
end
note append g_pa as one argument
fn apa to void
p = get g_n 3
n = get g_n 0
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 3 add p add n 2
c = add get g_n 4 1
put g_n 4 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end
fn atx t view uchar * to void
prp t
apa
end
fn asc t view uchar * to void
psc t
apa
end
fn agen to void
pclr
for j ulong get g_n 7 bound 4096
pc ulong get g_gen j
end
apa
end
fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run the argument list with stdin fi and stdout, stderr in SCRATCH/log.out, log.err: the exit code,
note 256 + the signal, 512 when a file could not be opened, 1000 when the child passed the 600 s deadline
fn spawn fi int to ulong
psc t_lout
fo = fwr
psc t_lerr
fe = fwr
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
fclo fi
fclo fo
fclo fe
ret reap pid
end
note wait for the child pid: its exit code, 256 + the signal, or 1000 after the 600 s deadline (killed)
fn reap pid long to ulong
t0 = monons
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 600000000000
r = killpid int pid 9
r = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
q = sleepns 200000
end
exit 2
end
fn run to ulong
prp t_null
ret spawn frd
end
note OMC < SCRATCH/src > SCRATCH/obj, src being "object" then the unit u
fn mkobj u view uchar * src view uchar * obj view uchar * to ulong
put g_n 6 0
if not bapp t_obj
ret 512
end
prp u
if not bload
ret 512
end
psc src
if not bsave false
ret 512
end
ret omcsrc src obj
end
note OMC < SCRATCH/src > SCRATCH/obj
fn omcsrc src view uchar * obj view uchar * to ulong
psc src
fi = frd
aclr
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
apa
ret spawnto fi obj
end
note ---- composed units: g_c[0, g_n 19) is "object", "om2", then each unit in order
fn cstart to bool
put g_n 19 0
ok = cput t_obj
ret and ok cput t_om2
end
fn cbyte c ulong to bool
n = get g_n 19
if ge n len g_c
m = mul len g_c 2
if lt m 65536
m = 65536
end
r = enlarge g_c m
if lt r 0
ret false
end
end
put g_c n uchar c
put g_n 19 add n 1
ret true
end
fn cput t view uchar * to bool
for i ulong len t bound 4096
if not cbyte ulong get t i
ret false
end
end
ret true
end
note append the repository file u; with ren, its om2 view: in each line that is not a note, the whole-word token
note "at" (a parameter name in errstr.om, a reserved word of OM-2) becomes "at_"
fn cfile u view uchar * ren bool to bool
put g_n 6 0
prp u
if not bload
ret false
end
n = get g_n 6
i = ulong 0
isn = false
bol = true
while lt i n bound 9223372036854775807
if bol
isn = and le add i len t_note n bat i t_note
bol = false
end
c = ulong get g_b i
if and not isn attok i n
if not cput t_atu
ret false
end
i = add i 2
else
if not cbyte c
ret false
end
bol = eq c 10
i = add i 1
end
end
ret true
end
note g_b[i, i + 2) is "at" with a space, a newline or the buffer's edge on each side
fn attok i ulong n ulong to bool
if or ge add i 1 n or ne get g_b i 97 ne get g_b add i 1 116
ret false
end
if gt i 0
p = get g_b sub i 1
if and ne p 32 ne p 10
ret false
end
end
if lt add i 2 n
q = get g_b add i 2
if and ne q 32 ne q 10
ret false
end
end
ret true
end

note readelf -W -S -d --dyn-syms on the scratch library lib: 0 when it exits 0 with nothing on stderr, lists
note every export of the table tab (at least one), shows its soname and every needed library; else its status,
note 300 (stderr not empty), 301 (an export not listed), 302 (soname) or 303 (a needed library)
fn relf tab view uchar * lib view uchar * to ulong
aclr
prp t_relf
apa
prp t_aw
apa
prp t_as
apa
prp t_ad
apa
prp t_add
apa
asc lib
r = run
if ne r 0
ret r
end
if not sload t_lerr
ret 300
end
if ne get g_n 6 0
ret 300
end
if not sload t_lout
ret 301
end
m = get g_n 6
prp tab
if not bload
ret 301
end
if not allexp m
ret 301
end
if not sonok m
ret 302
end
if not needok m
ret 303
end
ret 0
end
note the table in g_b[m, g_n 6) has a "soname\tNAME" line and g_b[0, m) has "Library soname: [NAME]"
fn sonok m ulong to bool
o = m
while lt o get g_n 6 bound 9223372036854775807
e = bnl o
if bat o t_son
s = add o len t_son
l = ulong 0
while gt get g_b add s l 32 bound 9223372036854775807
l = add l 1
end
ret sfind s l m t_lsn
end
o = e
end
ret false
end
fn sfind s ulong l ulong m ulong p view uchar * to bool
for i ulong m bound 9223372036854775807
if bat i p
a = add i len p
if and bsame a s l eq get g_b add a l 93
ret true
end
end
end
ret false
end
note every "needed\tNAME" line of the table in g_b[m, g_n 6) has "Shared library: [NAME]" in g_b[0, m)
fn needok m ulong to bool
o = m
while lt o get g_n 6 bound 9223372036854775807
e = bnl o
if and le add o len t_need get g_n 6 bat o t_need
s = add o len t_need
l = ulong 0
while gt get g_b add s l 32 bound 9223372036854775807
l = add l 1
end
if not sfind s l m t_lsl
ret false
end
end
o = e
end
ret true
end
note every "export\tNAME\t" line of the table in g_b[m, g_n 6) has NAME then a newline in g_b[0, m), and there
note is at least one such line
fn allexp m ulong to bool
o = m
n = ulong 0
while lt o get g_n 6 bound 9223372036854775807
e = bnl o
if expat o
s = add o len t_exp
l = ulong 0
while ne get g_b add s l 9 bound 9223372036854775807
l = add l 1
end
if not bline s l m
ret false
end
n = add n 1
end
o = e
end
ret gt n 0
end
fn expat o ulong to bool
if gt add o len t_exp get g_n 6
ret false
end
ret bat o t_exp
end
note g_b[s, s + l) occurs in g_b[0, m) as a whole readelf symbol line's name: a space before it, a newline after
note it, and "FUNC    GLOBAL DEFAULT" earlier on its line
fn bline s ulong l ulong m ulong to bool
if lt m add l 2
ret false
end
for i ulong sub sub m l 1 bound 9223372036854775807
o = add i 1
if and bsame o s l eq get g_b add o l 10
if and eq get g_b i 32 fglob o
ret true
end
end
end
ret false
end
note the line holding g_b[o] has "FUNC    GLOBAL DEFAULT" before o
fn fglob o ulong to bool
a = o
while and gt a 0 ne get g_b sub a 1 10 bound 9223372036854775807
a = sub a 1
end
if lt sub o a len t_fgl
ret false
end
for i ulong add sub sub o a len t_fgl 1 bound 9223372036854775807
if bat add a i t_fgl
ret true
end
end
ret false
end
fn bsame a ulong s ulong l ulong to bool
for i ulong l bound 9223372036854775807
if ne get g_b add a i get g_b add s i
ret false
end
end
ret true
end
note the scratch files a and b hold the same bytes

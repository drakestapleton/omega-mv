note the wrappers' range of the library in g_b, from its .dynsym (the lowest symbol value, the highest value plus
note size) into g_n 14 and 15; false when there is no .dynsym
fn wrange to bool
so = bq 40
put g_n 14 shl ulong 1 63
put g_n 15 0
for i ulong bh 60 bound 65536
h = add so mul i 64
if eq bh add h 4 11
symr bq add h 24 bq add h 32
end
end
ret gt get g_n 15 0
end
fn symr o ulong n ulong to void
for k ulong div n 24 bound 9223372036854775807
e = add o mul k 24
v = bq add e 8
if ne v 0
if lt v get g_n 14
put g_n 14 v
end
if gt add v bq add e 16 get g_n 15
put g_n 15 add v bq add e 16
end
end
end
end
note the u64 and the u16 of g_b at o
fn bq o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get g_b add o i mul i 8
end
ret v
end
fn bh o ulong to ulong
ret or ulong get g_b o shl ulong get g_b add o 1 8
end
note turn every 4-aligned word w inside the wrappers into NOP (0xd503201f); how many
fn nopw w ulong to ulong
k = ulong 0
if not wrange
ret 0
end
for i ulong div sub get g_n 15 get g_n 14 4 bound 9223372036854775807
o = add get g_n 14 mul i 4
if eq bw o w
put g_b o 31
put g_b add o 1 32
put g_b add o 2 3
put g_b add o 3 213
k = add k 1
end
end
ret k
end
note save g_b as the scratch library lib, copy the probe to prb and run it: its status, or 512 on a setup failure
fn tsave lib view uchar * prb view uchar * to ulong

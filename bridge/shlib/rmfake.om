note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note rmfake.om: host-only stand-in for the NVIDIA resource manager behind compat/nvml. Pure unit
note nvml_fake, lowered by tests/nvml/gate.om and called by tests/nvml/transport.c in place of
note omega2_nvrm_open_file, omega2_nvrm_close_file and omega2_nvrm_ioctl. No device file is opened.
note Replies imitate a GB10 (one GPU, or two with fault 2); they are synthetic, not a hardware record.
note
note st (ulong 64): 0 kind (1 ioctl, 2 open, 3 close), 1 fd, 2 nr, 3 header bytes, 4 params bytes,
note 5 fault letter, 6 result (signed), 7 path bytes (open; the path is in p).
note Counters: 8 opens, 9 closes, 10 allocs, 11 frees, 12 controls, 13 violations (a request the real
note RM would refuse or a wrong layout), 14 open-fd mask (bit fd-10), 15 live objects, 16 root client.
note Objects: 32..47 live handles, 48+i device and 50+i subdevice of GPU i.
note Faults (st 5, ASCII): o a d  control open ENOENT, control open EACCES, device open ENXIO;
note P root alloc EPERM; A device alloc 0x1B; 0 no GPU; 9 nine GPUs; 2 two GPUs;
note c name 0x56; G name 0x0F; n name without zero; E empty name; g GID length 20;
note t thermal not executed; h negative reading; v no GPU-type target;
note z no framebuffer; x FB info 0x56; m free above total;
note w util 0x56; y util 0x1B; e empty ring; r tracker 72; Z newest timestamp 0; X gr.util 10001;
note k no compute class; l no PIDs; p 951 PIDs; b 250 PIDs; i PID 4242 info fails; j wrong pid echoed;
note f subdevice free 0x1F.
note Healthy replies: name NVIDIA GB10, GID fb8e53f0-3207-e89b-d02f-acdfe2695b59 (GPU 1 ends 5a),
note reading 40 (GPU 1 41), total 128000000 KiB, free 100000000 KiB, newest util sample (index 4 of
note tracker 5) gr 4200 fb 1300 while sample k holds gr 100k fb 50k, PIDs 68451 (351272960 bytes)
note and 4242 (pid*65536). Constants: evidence/NVML-2026-11-06/wolfram.txt.

const HN ulong 4608
const PN ulong 55888
const RT ulong 3251634177

fn hg h edit uchar HN o ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get h add o i mul i 8
end
ret v
end

fn hp h edit uchar HN o ulong v ulong to void
for i ulong 4
put h add o i uchar and shr v mul i 8 255
end
end

fn pn p edit uchar PN o ulong n ulong to ulong
v = ulong 0
for i ulong n
v = or v shl ulong get p add o i mul i 8
end
ret v
end

fn pg p edit uchar PN o ulong to ulong
ret pn p o 4
end

fn pp p edit uchar PN o ulong v ulong to void
for i ulong 4
put p add o i uchar and shr v mul i 8 255
end
end

fn pq p edit uchar PN o ulong v ulong to void
for i ulong 8
put p add o i uchar and shr v mul i 8 255
end
end

fn bad st edit ulong 64 to void
put st 13 add get st 13 1
end

fn flt st edit ulong 64 c ulong to bool
ret eq get st 5 c
end

note A request on fd with the given header and params bytes; anything else is a violation.
fn want st edit ulong 64 fd ulong hl ulong pl ulong to bool
if and eq get st 1 fd and eq get st 3 hl eq get st 4 pl
ret true
end
bad st
ret false
end

note A control with params bytes n on an acceptable object (ok); anything else is a violation.
fn need st edit ulong 64 n ulong ok bool to bool
if and ok eq get st 4 n
ret true
end
bad st
ret false
end

fn ngpu st edit ulong 64 to ulong
if flt st 50
ret 2
end
ret 1
end

fn isopen st edit ulong 64 fd ulong to bool
if or lt fd 10 gt fd 12
ret false
end
ret ne and shr get st 14 sub fd 10 1 0
end

fn slot st edit ulong 64 x ulong to ulong
for i ulong 16
if eq get st add 32 i x
ret add i 1
end
end
ret 0
end

fn keep st edit ulong 64 x ulong to void
i = slot st 0
if or eq x 0 or eq i 0 ne slot st x 0
bad st
ret
end
put st add 31 i x
put st 10 add get st 10 1
put st 15 add get st 15 1
end

fn gpu st edit ulong 64 x ulong to ulong
for i ulong 2
if and ne x 0 or eq get st add 48 i x eq get st add 50 i x
ret i
end
end
ret 9
end

fn isdev st edit ulong 64 x ulong to bool
ret and ne x 0 or eq get st 48 x eq get st 49 x
end

fn issub st edit ulong 64 x ulong to bool
ret and ne x 0 or eq get st 50 x eq get st 51 x
end

note Open: /dev/nvidiactl is fd 10, /dev/nvidia<m> is fd 11+m.
fn fkopen st edit ulong 64 p edit uchar PN to long
n = get st 7
fd = long neg long 2
if and eq n 14 and eq pn p 0 8 7599382571363165231 eq pn p 8 6 119247139334500
if flt st 111
ret neg long 2
end
if flt st 97
ret neg long 13
end
fd = long 10
end
if and eq n 12 and eq pn p 0 8 7599382571363165231 eq pn p 8 3 6383972
m = ulong get p 11
if and ge m 48 lt m add 48 ngpu st
if flt st 100
ret neg long 6
end
fd = long add 11 sub m 48
end
end
if lt fd 0
bad st
ret fd
end
if isopen st ulong fd
bad st
ret neg long 16
end
put st 14 or get st 14 shl 1 sub ulong fd 10
put st 8 add get st 8 1
ret fd
end

fn fkclose st edit ulong 64 to long
fd = get st 1
if not isopen st fd
bad st
ret neg long 9
end
put st 14 and get st 14 not shl 1 sub fd 10
put st 9 add get st 9 1
ret 0
end

note NV_ESC_CARD_INFO: entries of 72 bytes, valid 0, gpu_id 16 (256+i), minor_number 56 (i).
fn fkcard st edit ulong 64 h edit uchar HN to long
if not want st 10 HN 0
ret neg long 22
end
if not isopen st 10
bad st
ret neg long 22
end
for i ulong HN
put h i 0
end
n = ngpu st
if flt st 48
n = 0
end
if flt st 57
n = 9
end
for i ulong n
o = mul i 72
put h o 1
hp h add o 16 add 256 i
hp h add o 56 i
end
ret 0
end

fn fkreg st edit ulong 64 h edit uchar HN to long
fd = get st 1
if not want st fd 4 0
ret neg long 22
end
if or lt fd 11 or not isopen st fd ne hg h 0 10
bad st
ret neg long 22
end
ret 0
end

fn fkdev st edit ulong 64 h edit uchar HN p edit uchar PN to ulong
x = hg h 8
i = pg p 0
r = get st 16
if not need st 56 and eq hg h 4 r and eq pg p 4 r lt i ngpu st
ret 86
end
if ne get st add 48 i 0
bad st
ret 86
end
if flt st 65
ret 27
end
keep st x
put st add 48 i x
ret 0
end

fn fksub st edit ulong 64 h edit uchar HN to ulong
x = hg h 8
d = hg h 4
if not need st 4 isdev st d
ret 86
end
i = gpu st d
if ne get st add 50 i 0
bad st
ret 86
end
keep st x
put st add 50 i x
ret 0
end

note NV_ESC_RM_ALLOC: NVOS21 hRoot 0, parent 4, hObjectNew 8, hClass 12, status 28.
fn fkalloc st edit ulong 64 h edit uchar HN p edit uchar PN to long
if or ne get st 1 10 ne get st 3 32
bad st
ret neg long 22
end
c = hg h 12
v = ulong 86
if eq c 65
if flt st 80
ret neg long 1
end
if or ne get st 4 0 ne get st 16 0
bad st
else
if or ne hg h 0 0 ne hg h 4 0
bad st
else
hp h 8 RT
put st 16 RT
keep st RT
v = 0
end
end
hp h 28 v
ret 0
end
if ne hg h 0 get st 16
bad st
v = 86
else
if eq c 128
v = fkdev st h p
end
if eq c 8320
v = fksub st h
end
end
hp h 28 v
ret 0
end

fn unmap st edit ulong 64 x ulong to void
for i ulong 4
if eq get st add 48 i x
put st add 48 i 0
end
end
end

note NV_ESC_RM_FREE: NVOS00 hRoot 0, parent 4, hObjectOld 8, status 12. A freed parent must have no
note live child (the caller frees bottom-up).
fn fkfree st edit ulong 64 h edit uchar HN to long
if not want st 10 16 0
ret neg long 22
end
r = hg h 0
q = hg h 4
x = hg h 8
i = slot st x
ok = and ne i 0 eq r get st 16
if eq x r
ok = and ok and eq q r eq get st 15 1
end
if isdev st x
ok = and ok eq q r
if ne get st add 50 gpu st x 0
ok = false
end
end
if issub st x
if ne get st add 48 gpu st x q
ok = false
end
end
if not ok
bad st
hp h 12 86
ret 0
end
put st add 31 i 0
put st 11 add get st 11 1
put st 15 sub get st 15 1
if eq x r
put st 16 0
end
f = issub st x
unmap st x
v = ulong 0
if and f flt st 102
v = 31
end
hp h 12 v
ret 0
end

fn c517 st edit ulong 64 p edit uchar PN o ulong to ulong
i = sub pg p 0 256
if not need st 32 and eq o get st 16 lt i ngpu st
ret 86
end
pp p 8 i
ret 0
end

fn cclass st edit ulong 64 p edit uchar PN o ulong to ulong
if not need st 804 isdev st o
ret 86
end
pp p 0 3
pp p 4 41141
if flt st 107
pp p 8 50880
else
pp p 8 52928
end
pp p 12 51311
ret 0
end

fn cname st edit ulong 64 p edit uchar PN o ulong to ulong
if not need st 132 and issub st o eq pg p 0 0
ret 86
end
if flt st 99
ret 86
end
if flt st 71
ret 15
end
if flt st 69
ret 0
end
if flt st 110
for i ulong 128
put p add 4 i 65
end
ret 0
end
pq p 4 5125168158881699406
pp p 12 3158338
ret 0
end

fn cgid st edit ulong 64 p edit uchar PN o ulong to ulong
if not need st 268 and issub st o eq pg p 4 2
ret 86
end
if flt st 103
pp p 8 20
else
pp p 8 16
end
pq p 12 11234237185837469435
if eq gpu st o 1
pq p 20 6510914109430312912
else
pq p 20 6438856515392384976
end
ret 0
end

fn cthop st edit ulong 64 p edit uchar PN o ulong k ulong g ulong to bool
op = pg p add o 8
a = pg p add o 12
if or eq op 256 eq op 1280
pp p add o 12 1
ret true
end
if ne a 0
ret false
end
if eq op 257
if flt st 118
pp p add o 16 2
else
pp p add o 16 1
end
ret true
end
if eq op 1312
pp p add o 16 0
ret true
end
if eq op 5376
if flt st 104
pp p add o 16 4294967286
else
pp p add o 16 add 40 g
end
ret true
end
ret false
end

fn ctherm st edit ulong 64 p edit uchar PN o ulong to ulong
n = pg p 20
if not need st 1432 issub st o
ret 86
end
if or ne pg p 0 1 or ne pg p 8 44 gt n 32
bad st
ret 86
end
g = gpu st o
for k ulong n
q = add 24 mul k 44
if not cthop st p q k g
bad st
ret 86
end
pp p q 0
if and flt st 116 eq k 0
pp p add q 4 0
else
pp p add q 4 1
end
end
ret 0
end

fn cfb st edit ulong 64 p edit uchar PN o ulong to ulong
n = pg p 0
if not need st 1028 and issub st o le n 128
ret 86
end
if flt st 120
ret 86
end
for i ulong n
q = add 4 mul i 8
x = pg p q
v = ulong 0
if eq x 54
if flt st 122
v = 1
end
else
if eq x 8
v = 128000000
else
if eq x 22
if flt st 109
v = 200000000
else
v = 100000000
end
else
bad st
ret 86
end
end
end
pp p add q 4 v
end
ret 0
end

fn cutil st edit ulong 64 p edit uchar PN o ulong to ulong
if not need st PN issub st o
ret 86
end
if or ne get p 0 2 ne pg p 4 55872
bad st
ret 86
end
if flt st 119
ret 86
end
if flt st 121
ret 27
end
if flt st 101
pp p 8 0
else
pp p 8 72
end
if flt st 114
pp p 12 72
else
pp p 12 5
end
for k ulong 72
q = add 16 mul k 776
f = mul k 50
g = mul k 100
t = add 1000 k
if eq k 4
f = 1300
g = 4200
if flt st 88
g = 10001
end
if flt st 90
t = 0
end
end
pq p q t
pp p add q 8 f
pp p add q 136 g
end
ret 0
end

fn cpids st edit ulong 64 p edit uchar PN o ulong to ulong
if not need st 3812 issub st o
ret 86
end
if or ne pg p 0 0 ne pg p 4 52928
bad st
ret 86
end
n = ulong 2
if flt st 108
n = 0
end
if flt st 112
n = 951
end
if flt st 98
n = 250
end
pp p 8 n
if eq n 2
pp p 12 68451
pp p 16 4242
end
if eq n 250
for i ulong n
pp p add 12 mul i 4 add 1000 i
end
end
ret 0
end

fn cpinfo st edit ulong 64 p edit uchar PN o ulong to ulong
m = pg p 0
if not need st 14408 and issub st o le m 200
ret 86
end
for i ulong m
q = add 8 mul i 72
d = pg p q
if ne pg p add q 4 0
bad st
ret 86
end
r = ulong 0
v = mul d 65536
if eq d 68451
v = 351272960
end
if and flt st 105 eq d 4242
r = 1
v = 0
end
if and flt st 106 eq i 0
pp p q add d 1
end
pp p add q 8 r
pq p add q 16 v
end
ret 0
end

fn cdisp st edit ulong 64 p edit uchar PN o ulong c ulong to ulong
if eq c 517
ret c517 st p o
end
if eq c 8389266
ret cclass st p o
end
if eq c 545259792
ret cname st p o
end
if eq c 545259850
ret cgid st p o
end
if eq c 545260819
ret ctherm st p o
end
if eq c 545264387
ret cfb st p o
end
if eq c 545267862
ret cutil st p o
end
if eq c 545259917
ret cpids st p o
end
if eq c 545259918
ret cpinfo st p o
end
bad st
ret 86
end

note NV_ESC_RM_CONTROL: NVOS54 hClient 0, hObject 4, cmd 8, status 28.
fn fkctl st edit ulong 64 h edit uchar HN p edit uchar PN to long
if not want st 10 32 get st 4
ret neg long 22
end
if ne hg h 0 get st 16
bad st
ret neg long 22
end
o = hg h 4
if eq slot st o 0
bad st
hp h 28 86
ret 0
end
put st 12 add get st 12 1
hp h 28 cdisp st p o hg h 8
ret 0
end

fn fkioctl st edit ulong 64 h edit uchar HN p edit uchar PN to long
nr = get st 2
if eq nr 200
ret fkcard st h
end
if eq nr 201
ret fkreg st h
end
if eq nr 43
ret fkalloc st h p
end
if eq nr 41
ret fkfree st h
end
if eq nr 42
ret fkctl st h p
end
bad st
ret neg long 22
end

fn nvml_fake st edit ulong 64 h edit uchar HN p edit uchar PN to ulong
k = get st 0
r = neg long 22
if eq k 1
r = fkioctl st h p
end
if eq k 2
r = fkopen st p
end
if eq k 3
r = fkclose st
end
if or lt k 1 gt k 3
bad st
end
if lt r 0
put st 6 sub 18446744073709551615 ulong sub neg r 1
else
put st 6 ulong r
end
ret 0
end

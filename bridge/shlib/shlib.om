x = 200
end
wrmov add p 24 0 x 0
wrb add p 28 tx 335544320
ret add p 32
end
note CMP-equal check then exit 250 (B.EQ +12; MOVZ X0, #250; B exit) at p; the next offset
fn chk250 p ulong cmp ulong to ulong
w32 p cmp
w32 add p 4 1409286240
w32 add p 8 3531611968
wrb add p 12 get ly 5 335544320
ret add p 16
end

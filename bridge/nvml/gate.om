note SPDX-License-Identifier: Apache-2.0
note bridge/nvml/gate.om: BRIDGE-NVML, the gate of the NVML library slice (one slice of CUDApp compat/: compat/nvml).
note CUDApp stores compat/nvml/libnvidia-ml.c, nvml.h and libnvidia-ml.map; all three are omega-bridge cabi-1
note output of gpu/nvidia/native/nvml/api.om. This tree stores none of them: bridge/nvml/derived.tsv names each as
note derived (source, source digest, generator digest, output digest), and this gate makes them again.
note Seeded Omega (Linux AArch64, OM-2 program mode; seed/ng/sha256.om supplies sh_init, sh_blk, sh_out). Build from
note the repository root:
note   { printf 'om2\n'; cat seed/ng/sha256.om bridge/nvml/gate.om; } | seed/out/omc > gate
note Run from the repository root:
note   gate SCRATCH OMC TABLE [toc=TOC]... [cudapp=CUDAPP]...
note SCRATCH  a new directory (made 0700); an existing one is refused (exit 2).
note OMC      the compiler (seed/out/omc): it compiles the source (the frontend step of omega-bridge's bridge-seeded)
note          and the emitter.
note TABLE    bridge/nvml/derived.tsv, or a mutated copy for a control.
note TOC      an omega-bridge src/toc.om (the cabi-1 emitter). Its digest must be a generator column value of the
note          table. OMC compiles it; for every row of that generator the gate writes the request bridge-seeded
note          writes (the mode letter, the source, a newline, then the generator and source digests and a newline),
note          runs the emitter on it with TOC on descriptor 3, and requires the output to have the row's output digest.
note CUDAPP   a CUDApp checkout: each row that names a CUDApp file must find that file with the row's output digest.
note Descriptor 3: the emitter reads its own source on descriptor 3 and refuses (error 52) when that is not the
note generator it names. Omega's exec words close every descriptor above 2 (OMEGESE section 9, execprog), so the
note gate starts the emitter through /bin/sh -c 'exec "$0" 3<"$1"' EMITTER TOC; that one binding is all the shell
note does (bridge/nvml/README.md, section What is not in this tree, and why).
note Output: one line per check, then BRIDGE-NVML PASS|FAIL checks=N failed=F emitter=PASS|FAIL|NOT_RUN
note oracle=PASS|FAIL|NOT_RUN. Exit 0 PASS, 1 FAIL, 2 bad usage or setup.
note Sizes: files, the table, requests and outputs live in run-time pools sized from what is read (no size of their
note own). Paths are refused past 4095 bytes (Linux PATH_MAX, 4096 with its terminator); the argument packet of a
note child past 65536 bytes and its environment past 4096 bytes are refused with exit 2 (the exec words' packets).
const NOLIM ulong 9223372036854775807
const PMAX ulong 4095
global g_n ulong 32
global g_pa uchar 4096
global g_tmp uchar 4096
global g_av uchar 65536
global g_ev uchar 4096
global g_stb uchar 4
global g_h uchar 256
global A uchar *
global AO ulong *
global T uchar *
global R ulong *
global F uchar *
global S uchar *
global Q uchar *
global O uchar *
text t_usage "usage: gate SCRATCH OMC TABLE [toc=TOC]... [cudapp=CUDAPP]... (run from the omega-mv root)\n"
text t_noscr "BRIDGE-NVML INVALID: SCRATCH exists or cannot be made\n"
text t_nomem "BRIDGE-NVML INVALID: the host refused memory for a pool\n"
text t_path "BRIDGE-NVML INVALID: a path is longer than 4095 bytes (Linux PATH_MAX)\n"
text t_pack "BRIDGE-NVML INVALID: a child's argument packet is over 65536 bytes\n"
text t_fork "BRIDGE-NVML INVALID: fork or wait failed\n"
text a_toc "toc="
text a_cud "cudapp="
text d_derived "derived"
text d_libc "lib-c"
text d_libh "lib-h"
text d_libmap "lib-map"
text d_none "-"
text f_sh "/bin/sh"
text f_c "-c"
text f_launch "exec \"$0\" 3<\"$1\""
text f_front "/frontend"
text f_emit "/emitter"
text f_req "/request"
text f_out "/out"
text f_err ".err"
text e_path "PATH=/usr/bin:/bin"
text o_pass "PASS "
text o_fail "FAIL "
text o_table "table: "
text o_tablen " rows, each derived, a known mode, three 64-hex digests and eight tab-separated fields"
text o_tablef "table: a row is malformed (want derived, lib-c|lib-h|lib-map, eight tab-separated fields, 64-hex digests) or there is no row; rows "
text o_src "source "
text o_of " of "
text o_gen ", generator "
text o_srcm "): the file has the pinned digest "
text o_srcf "): unreadable or digest differs; got "
text o_front "frontend: "
text o_frontm " compiles with OMC (exit 0, a non-empty program)"
text o_rc " exit "
text o_emit "emitter "
text o_emitc ": compiled by OMC"
text o_emitn ": digest is not a generator in the table"
text o_emitu ": unreadable"
text o_der "derived "
text o_mode " ("
text o_from "): emitter "
text o_on " on "
text o_gives " gives the pinned digest "
text o_got " got "
text o_orc "oracle "
text o_orcm ": CUDApp's file has the derived digest of "
text o_orcn "oracle: no table row names a CUDApp file"
text o_sum "BRIDGE-NVML "
text o_spass "PASS"
text o_sfail "FAIL"
text o_checks " checks="
text o_failed " failed="
text o_emitter " emitter="
text o_oracle " oracle="
text o_notrun "NOT_RUN"
note g_n: 0 path length, 1 output line length, 2 checks, 3 failures, 4 arguments, 5 table length, 6 rows,
note 7 F length, 8 S length, 9 Q length, 10 argument packet length, 11 argument count, 12 environment length,
note 13 emitter state, 14 oracle state (0 NOT_RUN, 1 PASS, 2 FAIL), 15 bytes of A used.
note g_h: digest k as 64 lowercase hex at 64*k (0 computed, 1 source, 2 generator).
note AO: argument k at 2k (start in A) and 2k+1 (length); 0 SCRATCH, 1 OMC, 2 TABLE, 3.. toc= or cudapp=.
note R: row r field f at 16r+2f (start in T) and 16r+2f+1 (length); fields: 0 status, 1 file, 2 mode, 3 source,
note 4 source digest, 5 generator digest, 6 output digest, 7 the CUDApp file or -.
fn nomem to void
r = write 2 t_nomem 0 len t_nomem
exit 2
end
note ---- pool growth: to n elements at least, doubling
fn gsz have ulong n ulong to ulong
m = mul have 2
if lt m n
m = n
end
if lt m 4096
m = 4096
end
ret m
end
fn oen n ulong to void
if gt n len O
r = enlarge O gsz len O n
if ne r 0
nomem
end
end
end
fn fen n ulong to void
if gt n len F
r = enlarge F gsz len F n
if ne r 0
nomem
end
end
end
fn sen n ulong to void
if gt n len S
r = enlarge S gsz len S n
if ne r 0
nomem
end
end
end
fn qen n ulong to void
if gt n len Q
r = enlarge Q gsz len Q n
if ne r 0
nomem
end
end
end
fn aen n ulong to void
if gt n len A
r = enlarge A gsz len A n
if ne r 0
nomem
end
end
end
fn aoen n ulong to void
if gt n len AO
r = enlarge AO gsz len AO n
if ne r 0
nomem
end
end
end
fn ren n ulong to void
if gt n len R
r = enlarge R gsz len R n
if ne r 0
nomem
end
end
end
fn ten n ulong to void
if gt n len T
r = enlarge T gsz len T n
if ne r 0
nomem
end
end
end
note ---- output: one line in O, written to stdout by onl
fn oc c ulong to void
n = get g_n 1
oen add n 1
put O n uchar c
put g_n 1 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound NOLIM
oc ulong get t i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn ohx k ulong to void
for j ulong 64
oc ulong get g_h add mul k 64 j
end
end
fn ofl r ulong f ulong to void
s = get R add mul r 16 mul f 2
n = get R add add mul r 16 mul f 2 1
for j ulong n bound NOLIM
oc ulong get T add s j
end
end
fn oarg k ulong skip ulong to void
s = get AO mul k 2
n = get AO add mul k 2 1
for j ulong sub n skip bound NOLIM
oc ulong get A add add s skip j
end
end
fn onl to void
oc 10
n = get g_n 1
r = write 1 O 0 n
put g_n 1 0
end
fn ook ok bool to void
put g_n 2 add get g_n 2 1
if ok
ot o_pass
else
ot o_fail
put g_n 3 add get g_n 3 1
end
end
note tier state slot k: PASS unless a check of the tier failed
fn tier k ulong ok bool to void
if not ok
put g_n k 2
else
if eq get g_n k 0
put g_n k 1
end
end
end
note ---- paths in g_pa
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
if lt n PMAX
put g_pa n uchar c
end
put g_n 0 add n 1
end
fn pt t view uchar * to void
for i ulong len t bound NOLIM
pc ulong get t i
end
end
fn parg k ulong skip ulong to void
s = get AO mul k 2
n = get AO add mul k 2 1
for j ulong sub n skip bound NOLIM
pc ulong get A add add s skip j
end
end
fn pfl r ulong f ulong to void
s = get R add mul r 16 mul f 2
n = get R add add mul r 16 mul f 2 1
for j ulong n bound NOLIM
pc ulong get T add s j
end
end
note SCRATCH + t
fn psc t view uchar * to void
pclr
parg 0 0
pt t
end
fn plen to ulong
n = get g_n 0
if gt n PMAX
r = write 2 t_path 0 len t_path
exit 2
end
ret n
end
fn fopn fl ulong mode ulong to int
n = plen
r = fopen g_pa 0 n int fl int mode
if lt r 0
ret -1
end
ret int r
end
fn frd to int
ret fopn 524288 0
end
fn fwr mode ulong to int
ret fopn 524865 mode
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
note ---- files: g_pa into F (length g_n 7); Q to g_pa
fn fload to bool
put g_n 7 0
fd = frd
if lt fd 0
ret false
end
n = ulong 0
ok = true
while true bound NOLIM
if lt sub len F n 65536
fen add n 65536
end
x = read fd F n sub len F n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
end
fclo fd
put g_n 7 n
ret ok
end
fn qsave to bool
fd = fwr 420
if lt fd 0
ret false
end
n = get g_n 9
o = ulong 0
ok = true
while lt o n bound NOLIM
x = write fd Q o sub n o
if le x 0
ok = false
break
end
o = add o ulong x
end
fclo fd
ret ok
end
note ---- SHA-256 of F[0..g_n 7) into g_h slot k, block by block (seed/ng/sha256.om's sh_all, over a pool)
fn fblk to void
sh_init
for j ulong 8
put sh_h j get sh_k add j 64
end
nb = div get g_n 7 64
for b ulong nb bound NOLIM
for j ulong 64
put sh_pad j get F add mul b 64 j
end
sh_blk 1 0
end
end
fn ftail to void
n = get g_n 7
r = rem n 64
o = sub n r
for j ulong 128
put sh_pad j 0
end
for j ulong r bound 64
put sh_pad j get F add o j
end
put sh_pad r 128
e = ulong 64
if ge r 56
e = 128
end
bits = mul n 8
for j ulong 8
put sh_pad sub sub e 1 j uchar and shr bits mul j 8 255
end
sh_blk 1 0
if eq e 128
sh_blk 1 64
end
sh_out
end
fn fdig k ulong to void
fblk
ftail
for j ulong 32
c = get sh_dig j
put g_h add mul k 64 mul j 2 sh_hexd uint shr c 4
put g_h add add mul k 64 mul j 2 1 sh_hexd uint and c 15
end
end
note ---- table fields
fn flen r ulong f ulong to ulong
ret get R add add mul r 16 mul f 2 1
end
fn fat r ulong f ulong j ulong to uchar
ret get T add get R add mul r 16 mul f 2 j
end
fn feqt r ulong f ulong t view uchar * to bool
if ne flen r f len t
ret false
end
for j ulong len t bound NOLIM
if ne fat r f j get t j
ret false
end
end
ret true
end
fn feqh r ulong f ulong k ulong to bool
if ne flen r f 64
ret false
end
for j ulong 64
if ne fat r f j get g_h add mul k 64 j
ret false
end
end
ret true
end
fn fsame a ulong b ulong f ulong to bool
if ne flen a f flen b f
ret false
end
for j ulong flen a f bound NOLIM
if ne fat a f j fat b f j
ret false
end
end
ret true
end
fn fhex r ulong f ulong to bool
if ne flen r f 64
ret false
end
for j ulong 64
c = fat r f j
d = and ge c 48 le c 57
x = and ge c 97 le c 102
if not or d x
ret false
end
end
ret true
end
note the mode letter of bridge-seeded: lib-c L, lib-h M, lib-map V; 0 unknown
fn fmode r ulong to ulong
if feqt r 2 d_libc
ret 76
end
if feqt r 2 d_libh
ret 77
end
if feqt r 2 d_libmap
ret 86
end
ret 0
end
note fields of the line T[p..e) into row r of R; the field count
note g_n 16 the field count so far, g_n 17 where the field began
fn tcut r ulong i ulong to void
f = get g_n 16
s = get g_n 17
if lt f 8
x = add mul r 16 mul f 2
put R x s
put R add x 1 sub i s
end
put g_n 16 add f 1
put g_n 17 add i 1
end
fn tsplit p ulong e ulong r ulong to ulong
ren mul add r 1 16
put g_n 16 0
put g_n 17 p
i = p
while lt i e bound NOLIM
if eq get T i 9
tcut r i
end
i = add i 1
end
tcut r e
ret get g_n 16
end
fn tvalid r ulong f ulong to bool
if ne f 8
ret false
end
if not feqt r 0 d_derived
ret false
end
if eq fmode r 0
ret false
end
for k ulong 3
if not fhex r add 4 k
ret false
end
end
if or eq flen r 1 0 or eq flen r 3 0 eq flen r 7 0
ret false
end
ret true
end
note split T into rows; false when a row is malformed or there is none
fn tparse to bool
n = get g_n 5
p = ulong 0
rows = ulong 0
ok = true
while lt p n bound NOLIM
e = p
while lt e n bound NOLIM
if eq get T e 10
break
end
e = add e 1
end
if and gt e p ne get T p 35
f = tsplit p e rows
put g_n 6 add rows 1
if not tvalid rows f
ok = false
end
rows = add rows 1
end
p = add e 1
end
put g_n 6 rows
if eq rows 0
ok = false
end
ret ok
end
note ---- children: argument packet g_av, environment g_ev
fn aclr to void
put g_n 10 2
put g_n 11 0
end
fn apa to void
p = get g_n 10
n = plen
if gt add add p n 2 65536
r = write 2 t_pack 0 len t_pack
exit 2
end
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 10 add p add n 2
c = add get g_n 11 1
put g_n 11 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end
fn atx t view uchar * to void
pclr
pt t
apa
end
fn envset to void
put g_ev 0 1
put g_ev 1 0
put g_ev 2 uchar len e_path
put g_ev 3 0
for j ulong len e_path bound 64
put g_ev add 4 j get e_path j
end
put g_n 12 add 4 len e_path
end
fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run g_av with stdin fi, stdout fo, stderr fe (each closed here): the exit code, 256 + the signal, 512 when
note a descriptor could not be opened
fn spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
r = write 2 t_fork 0 len t_fork
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execenv g_av 0 get g_n 10 g_ev 0 get g_n 12
exit 127
end
fclo fi
fclo fo
fclo fe
while true bound NOLIM
r = waitpid int pid g_stb 0 len g_stb 0
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
r = write 2 t_fork 0 len t_fork
exit 2
end
end
exit 2
end
note OMC with stdin g_pa (already set by the caller through fi), stdout SCRATCH + o (mode md), stderr SCRATCH + o.err
fn omcrun fi int o view uchar * md ulong to ulong
psc o
fo = fwr md
psc o
pt f_err
fe = fwr 420
aclr
pclr
parg 1 0
apa
ret spawn fi fo fe
end
note ---- checks
fn srccheck r ulong to void
pclr
pfl r 3
ok = fload
if ok
fdig 0
ok = feqh r 4 0
end
ook ok
ot o_src
ofl r 3
ot o_of
ofl r 1
ot o_mode
ofl r 2
ot o_gen
ofl r 5
if ok
ot o_srcm
else
ot o_srcf
end
ohx 0
onl
end
fn frontend r ulong to void
pclr
pfl r 3
fi = frd
rc = omcrun fi f_front 420
psc f_front
ok = fload
ok = and ok and eq rc 0 gt get g_n 7 0
ook ok
ot o_front
ofl r 3
ot o_frontm
if ne rc 0
ot o_rc
onum rc
end
onl
end
note one emitter row: the request, the run with TOC (argument k) on descriptor 3, the output digest
fn emitrow r ulong k ulong to bool
pclr
pfl r 3
ok = fload
n = get g_n 7
fdig 1
sen n
for j ulong n bound NOLIM
put S j get F j
end
qen add n 132
put Q 0 uchar fmode r
for j ulong n bound NOLIM
put Q add 1 j get S j
end
p = add n 1
put Q p 10
for j ulong 64
put Q add add p 1 j get g_h add 128 j
end
put Q add p 65 32
for j ulong 64
put Q add add p 66 j get g_h add 64 j
end
put Q add p 130 10
put g_n 9 add p 131
psc f_req
ok = and ok qsave
psc f_req
fi = frd
psc f_out
fo = fwr 420
psc f_out
pt f_err
fe = fwr 420
aclr
atx f_sh
atx f_c
atx f_launch
psc f_emit
apa
pclr
parg k 4
apa
rc = spawn fi fo fe
psc f_out
ok = and ok fload
fdig 0
ok = and ok and eq rc 0 feqh r 6 0
ook ok
ot o_der
ofl r 1
ot o_mode
ofl r 2
ot o_from
ohx 2
ot o_on
ofl r 3
ot o_gives
ofl r 6
if not ok
ot o_rc
onum rc
ot o_got
ohx 0
end
onl
ret ok
end
fn emitter k ulong to void
pclr
parg k 4
ok = fload
if not ok
ook false
ot o_emit
oarg k 4
ot o_emitu
onl
tier 13 false
ret
end
fdig 2
m = ulong 0
for r ulong get g_n 6 bound NOLIM
if feqh r 5 2
m = add m 1
end
end
if eq m 0
ook false
ot o_emit
ohx 2
ot o_emitn
onl
tier 13 false
ret
end
pclr
parg k 4
fi = frd
rc = omcrun fi f_emit 448
psc f_emit
ok = fload
ok = and ok and eq rc 0 gt get g_n 7 0
ook ok
ot o_emit
ohx 2
ot o_emitc
if ne rc 0
ot o_rc
onum rc
end
onl
tier 13 ok
if not ok
ret
end
for r ulong get g_n 6 bound NOLIM
if feqh r 5 2
tier 13 emitrow r k
end
end
end
fn oracle k ulong to void
m = ulong 0
for r ulong get g_n 6 bound NOLIM
if not feqt r 7 d_none
m = add m 1
pclr
parg k 7
pc 47
pfl r 7
ok = fload
if ok
fdig 0
ok = feqh r 6 0
end
ook ok
ot o_orc
ofl r 7
ot o_orcm
ofl r 1
ot o_mode
ofl r 2
ot o_from
ofl r 5
if not ok
ot o_got
ohx 0
end
onl
tier 14 ok
end
end
if eq m 0
ook false
ot o_orcn
onl
tier 14 false
end
end
fn usage to void
r = write 2 t_usage 0 len t_usage
exit 2
end
note does argument k start with t (and say more)
fn apre k ulong t view uchar * to bool
s = get AO mul k 2
n = get AO add mul k 2 1
if le n len t
ret false
end
for j ulong len t bound NOLIM
if ne get A add s j get t j
ret false
end
end
ret true
end
fn main to int
argc = ulong argcnt
if lt argc 4
usage
end
na = sub argc 1
put g_n 4 na
aoen mul na 2
for k ulong na bound NOLIM
n = argread add k 1 g_tmp 0 4096
if or lt n 1 gt n 4095
usage
end
u = get g_n 15
aen add u ulong n
for j ulong ulong n bound 4096
put A add u j get g_tmp j
end
put AO mul k 2 u
put AO add mul k 2 1 ulong n
put g_n 15 add u ulong n
end
for k ulong sub na 3 bound NOLIM
q = add k 3
if not or apre q a_toc apre q a_cud
usage
end
end
pclr
parg 0 0
n = plen
r = makedir g_pa 0 n 448
if ne r 0
r = write 2 t_noscr 0 len t_noscr
exit 2
end
envset
pclr
parg 2 0
ok = fload
n = get g_n 7
ten n
for j ulong n bound NOLIM
put T j get F j
end
put g_n 5 n
ok = and ok tparse
ook ok
ot o_table
if ok
onum get g_n 6
ot o_tablen
else
ot o_tablef
onum get g_n 6
end
onl
if ok
rows = get g_n 6
for ri ulong rows bound NOLIM
srccheck ri
seen = false
for qi ulong ri bound NOLIM
if fsame qi ri 3
seen = true
end
end
if not seen
frontend ri
end
end
for k ulong sub na 3 bound NOLIM
q = add k 3
if apre q a_toc
emitter q
end
end
for k ulong sub na 3 bound NOLIM
q = add k 3
if apre q a_cud
oracle q
end
end
end
ot o_sum
fl = get g_n 3
if eq fl 0
ot o_spass
else
ot o_sfail
end
ot o_checks
onum get g_n 2
ot o_failed
onum fl
ot o_emitter
st = get g_n 13
if eq st 0
ot o_notrun
end
if eq st 1
ot o_spass
end
if eq st 2
ot o_sfail
end
ot o_oracle
st = get g_n 14
if eq st 0
ot o_notrun
end
if eq st 1
ot o_spass
end
if eq st 2
ot o_sfail
end
onl
if eq fl 0
ret 0
end
ret 1
end

note SPDX-License-Identifier: Apache-2.0
note bridge/cuda/fixture.om: the test inputs of the CUDA C0 admission check (bridge/cuda/c0_check.om), written in
note seeded Omega. It replaces three things CUDApp compat/cuda did with files and host tools: the committed PTX
note fixture (fixture/vadd_u32.ptx), the link-only stub libcuda.so.1 (build.sh: cc -shared -nostdlib with one
note -Wl,--defsym,cuX=0 per undefined cu* symbol) and, new here, an admission executable that carries exactly the
note dynamic surface the check reads, so the check can be exercised without a C toolchain.
note Build: seed/out/omc < bridge/cuda/fixture.om > fixture
note   fixture ptx OUT                       the PTX kernel vadd_u32, byte for byte the CUDApp fixture
note   fixture stub PROFILE OUT              a link-only ELF64 shared object: soname = the profile's
note                                         "needed NAME replacement" row, one absolute symbol (value 0) per
note                                         "import NAME cuda" row, machine from the "host ISA" row
note   fixture exe TABLE PROFILE full|nolib OUT
note                                         an ELF64 ET_DYN whose .dynsym/.gnu.version_r/.dynamic hold the
note                                         "import NAME global|weak", "verneed VERSION FILE" and "needed NAME"
note                                         rows of TABLE in TABLE order (TABLE is c0_check emit output);
note                                         nolib leaves out every import the profile classes "cuda" and every
note                                         needed library it marks "replacement" (the C link with
note                                         --unresolved-symbols=ignore-all and no libcuda.so.1)
note Neither ELF is ever run: the stub is a link-time placeholder, the executable a table the check reads.
note Exit 0 written, 1 a table without the rows the output needs, 2 usage, 3 an input unreadable or larger than
note the 16 MiB buffers, or an output that would be (every limit is a clean refusal, never a truncation).
om2
const BIG ulong 16777216
const ROWS ulong 2097152
global ib uchar 16777216
global ob uchar 16777216
global gs uchar 16777216
global ss uchar 128
global ag uchar 4096
global sy ulong 2097152
global sb ulong 2097152
global nd ulong 2097152
global vf ulong 2097152
global vc ulong 2097152
global va ulong 2097152
global hk ulong 2097152
global bk ulong 17
global fo ulong 8
global fl ulong 8
global nv ulong 64
note nv: 0 table end, 1 profile start, 2 profile end, 3 dynstr length, 4 symbols, 5 needed, 6 verneed groups,
note 7 verneed versions, 8 machine, 9 soname offset, 10 mode (0 exe, 1 stub), 11 fields, 12 output length,
note 13 offset and 14 length of the current group's file field, 15 nolib
text m_ptx "ptx"
text m_stub "stub"
text m_exe "exe"
text m_full "full"
text m_nolib "nolib"
text k_imp "import"
text k_ver "verneed"
text k_need "needed"
text k_host "host"
text k_cuda "cuda"
text k_repl "replacement"
text k_glob "global"
text k_weak "weak"
text k_a64 "aarch64"
text k_x64 "x86_64"
text n_dynstr ".dynstr"
text n_dynsym ".dynsym"
text n_hash ".hash"
text n_vr ".gnu.version_r"
text n_dyn ".dynamic"
text n_shs ".shstrtab"
text p01 "// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception\n"
text p02 "// CUDApp#184 C0 fixture kernel. Hand-authored from the public PTX ISA (PROVENANCE class A);\n"
text p03 "// this file is not compiler output. c[i] = a[i] + b[i] modulo 2^32 for i < n, nothing for i >= n.\n"
text p04 "// Parameters: three global-space byte addresses (u64) and the element count (u32).\n"
text p05 ".version 8.0\n"
text p06 ".target sm_80\n"
text p07 ".address_size 64\n"
text p08 "\n"
text p09 ".visible .entry vadd_u32(\n"
text p10 "\t.param .u64 vadd_u32_a,\n"
text p11 "\t.param .u64 vadd_u32_b,\n"
text p12 "\t.param .u64 vadd_u32_c,\n"
text p13 "\t.param .u32 vadd_u32_n\n"
text p14 ")\n"
text p15 "{\n"
text p16 "\t.reg .pred %p<2>;\n"
text p17 "\t.reg .b32 %r<8>;\n"
text p18 "\t.reg .b64 %rd<11>;\n"
text p19 "\n"
text p20 "\tld.param.u64 %rd1, [vadd_u32_a];\n"
text p21 "\tld.param.u64 %rd2, [vadd_u32_b];\n"
text p22 "\tld.param.u64 %rd3, [vadd_u32_c];\n"
text p23 "\tld.param.u32 %r1, [vadd_u32_n];\n"
text p24 "\tmov.u32 %r2, %ctaid.x;\n"
text p25 "\tmov.u32 %r3, %ntid.x;\n"
text p26 "\tmov.u32 %r4, %tid.x;\n"
text p27 "\tmad.lo.u32 %r5, %r2, %r3, %r4;\n"
text p28 "\tsetp.ge.u32 %p1, %r5, %r1;\n"
text p29 "\t@%p1 bra DONE;\n"
text p30 "\tcvta.to.global.u64 %rd4, %rd1;\n"
text p31 "\tcvta.to.global.u64 %rd5, %rd2;\n"
text p32 "\tcvta.to.global.u64 %rd6, %rd3;\n"
text p33 "\tmul.wide.u32 %rd7, %r5, 4;\n"
text p34 "\tadd.s64 %rd8, %rd4, %rd7;\n"
text p35 "\tadd.s64 %rd9, %rd5, %rd7;\n"
text p36 "\tadd.s64 %rd10, %rd6, %rd7;\n"
text p37 "\tld.global.u32 %r6, [%rd8];\n"
text p38 "\tld.global.u32 %r7, [%rd9];\n"
text p39 "\tadd.u32 %r6, %r6, %r7;\n"
text p40 "\tst.global.u32 [%rd10], %r6;\n"
text p41 "DONE:\n"
text p42 "\tret;\n"
text p43 "}\n"
note ---- small helpers
fn al8 x ulong to ulong
ret and add x 7 not ulong 7
end
fn w8 o ulong v ulong to void
put ob o uchar and v 255
end
fn w16 o ulong v ulong to void
w8 o v
w8 add o 1 shr v 8
end
fn w32 o ulong v ulong to void
w16 o and v 65535
w16 add o 2 shr v 16
end
fn w64 o ulong v ulong to void
w32 o and v 4294967295
w32 add o 4 shr v 32
end
note the argument ai as a path in ag; exit 2 when absent
fn arg ai ulong to ulong
r = argread ai ag 0 sub len ag 1
if le r 0
exit 2
end
ret ulong r
end
note the argument ai equals t
fn argis ai ulong t view uchar * to bool
r = argread ai ag 0 sub len ag 1
if ne r long len t
ret false
end
for i ulong len t bound 4096
if ne get ag i get t i
ret false
end
end
ret true
end
note load argument ai's file into ib from at; returns the end, exit 3 when unreadable or too large
fn ldf ai ulong from ulong to ulong
m = arg ai
fd = fopen ag 0 m int 524288 int 0
if lt fd 0
exit 3
end
n = from
while true bound 16777218
x = read int fd ib n sub BIG n
if lt x 0
exit 3
end
if eq x 0
break
end
n = add n ulong x
if ge n BIG
exit 3
end
end
r = fclose int fd
ret n
end
note write ob[0, n) to the path in argument ai; exit 3 when that fails
fn save ai ulong n ulong to void
m = arg ai
r = unlink ag 0 m
fd = fopen ag 0 m int 524865 int 420
if lt fd 0
exit 3
end
o = ulong 0
while lt o n bound 16777217
x = write int fd ob o sub n o
if le x 0
exit 3
end
o = add o ulong x
end
r = fclose int fd
end
note ---- rows: fields of one tab-separated line into fo/fl, count into nv 11; returns the next line
fn row o ulong e ulong to ulong
put nv 11 0
s = o
p = o
while lt p e bound 16777217
c = get ib p
if eq c 10
break
end
if eq c 9
k = get nv 11
if lt k 8
put fo k s
put fl k sub p s
end
put nv 11 add k 1
s = add p 1
end
p = add p 1
end
k = get nv 11
if lt k 8
put fo k s
put fl k sub p s
end
put nv 11 add k 1
if lt p e
p = add p 1
end
ret p
end
note field i of the current row equals t
fn ft i ulong t view uchar * to bool
if ge i get nv 11
ret false
end
if ne get fl i len t
ret false
end
o = get fo i
for j ulong len t bound 4096
if ne get ib add o j get t j
ret false
end
end
ret true
end
note ib[a, a+n) equals field i of the current row
fn fbytes i ulong a ulong n ulong to bool
if ge i get nv 11
ret false
end
if ne get fl i n
ret false
end
o = get fo i
for j ulong n bound 16777216
if ne get ib add o j get ib add a j
ret false
end
end
ret true
end
note append field i of the current row and a zero to .dynstr; its offset
fn sadd i ulong to ulong
s = get nv 3
n = get fl i
if ge add add s n 1 BIG
exit 3
end
o = get fo i
for j ulong n bound 16777216
put gs add s j get ib add o j
end
put gs add s n 0
put nv 3 add add s n 1
ret s
end
note SysV ELF hash of the .dynstr string at o
fn ehash o ulong to ulong
h = ulong 0
p = o
while ne get gs p 0 bound 16777216
h = and add shl h 4 ulong get gs p 4294967295
g = and h 4026531840
if ne g 0
h = xor h shr g 24
end
h = and h not g
p = add p 1
end
ret h
end
note the machine of a "host ISA" row; exit 1 for another ISA
fn mach to ulong
if ft 1 k_a64
ret 183
end
if ft 1 k_x64
ret 62
end
exit 1
end
note a slot in one of the row arrays; exit 3 past it
fn slot k ulong to void
if ge k ROWS
exit 3
end
end
note ---- profile queries for nolib (each walks the profile and leaves fo/fl on its last row)
note the profile classes import ib[a, a+n) as cuda
fn iscuda a ulong n ulong to bool
p = get nv 1
e = get nv 2
while lt p e bound 16777217
p = row p e
if ft 0 k_imp
if ft 2 k_cuda
if fbytes 1 a n
ret true
end
end
end
end
ret false
end
note the profile marks needed library ib[a, a+n) as replacement
fn isrepl a ulong n ulong to bool
p = get nv 1
e = get nv 2
while lt p e bound 16777217
p = row p e
if ft 0 k_need
if ft 2 k_repl
if fbytes 1 a n
ret true
end
end
end
end
ret false
end
note ---- the order GNU ld gives a --defsym stub's .dynsym, which the executable linked against it copies into
note its .dynstr (measured on this host's binutils: the gcc stub of CUDApp build.sh lists its 13 symbols by
note GNU hash bucket, then by slot in ld's 4051-slot symbol table; with another order the linked executable
note differs in .dynstr and in its build ID). The bucket count is ld's for a link without -O: the largest of
note 1 3 17 37 67 ... 32771 not above the symbol count.
fn nbk n ulong to ulong
put bk 0 1
put bk 1 3
put bk 2 17
put bk 3 37
put bk 4 67
put bk 5 97
put bk 6 131
put bk 7 197
put bk 8 263
put bk 9 521
put bk 10 1031
put bk 11 2053
put bk 12 4099
put bk 13 8209
put bk 14 16411
put bk 15 32771
best = ulong 1
for i ulong 16
best = get bk i
if lt i 15
if lt n get bk add i 1
ret best
end
end
end
ret best
end
note GNU hash (h = h*33 + c from 5381, 32 bits) of the .dynstr string at o
fn ghash o ulong to ulong
h = ulong 5381
p = o
while ne get gs p 0 bound 16777216
h = and add mul h 33 ulong get gs p 4294967295
p = add p 1
end
ret h
end
note the slot of the .dynstr string at o in ld's symbol table (bfd_hash_hash modulo 4051)
fn bslot o ulong to ulong
h = ulong 0
p = o
while ne get gs p 0 bound 16777216
c = ulong get gs p
h = add h add c shl c 17
h = xor h shr h 2
p = add p 1
end
n = sub p o
h = add h add n shl n 17
h = xor h shr h 2
ret rem h 4051
end
note sort the stub's symbols into ld's order (stable insertion sort on bucket, then slot)
fn ldorder to void
ns = get nv 4
nb = nbk ns
for i ulong ns bound 2097152
s = get sy i
put hk i add mul rem ghash s nb 4096 bslot s
end
for i ulong ns bound 2097152
k = get hk i
s = get sy i
j = i
while gt j 0 bound 2097152
if le get hk sub j 1 k
break
end
put hk j get hk sub j 1
put sy j get sy sub j 1
j = sub j 1
end
put hk j k
put sy j s
end
end
note ---- collect: stub rows from the profile ib[0, nv 0)
fn cstub to void
p = ulong 0
e = get nv 0
while lt p e bound 16777217
p = row p e
if ft 0 k_host
put nv 8 mach
end
if ft 0 k_need
if ft 2 k_repl
if eq get nv 9 0
put nv 9 sadd 1
end
end
end
if ft 0 k_imp
if ft 2 k_cuda
k = get nv 4
slot k
put sy k sadd 1
put sb k 1
put nv 4 add k 1
end
end
end
end
note append ib[a, a+n) and a zero to .dynstr; its offset
fn sadd_at a ulong n ulong to ulong
s = get nv 3
if ge add add s n 1 BIG
exit 3
end
for j ulong n bound 16777216
put gs add s j get ib add a j
end
put gs add s n 0
put nv 3 add add s n 1
ret s
end
note one table row into the symbol, needed or verneed arrays (exe)
fn cexe1 to void
if ft 0 k_host
put nv 8 mach
ret
end
nl = eq get nv 15 1
if ft 0 k_imp
b = ulong 0
if ft 2 k_glob
b = 1
end
if ft 2 k_weak
b = 2
end
if eq b 0
exit 1
end
a = get fo 1
n = get fl 1
keep = true
if nl
if iscuda a n
keep = false
end
end
if keep
k = get nv 4
slot k
put sy k sadd_at a n
put sb k b
put nv 4 add k 1
end
ret
end
if ft 0 k_need
a = get fo 1
n = get fl 1
keep = true
if nl
if isrepl a n
keep = false
end
end
if keep
k = get nv 5
slot k
put nd k sadd_at a n
put nv 5 add k 1
end
ret
end
if ft 0 k_ver
g = get nv 6
same = false
if gt g 0
if fbytes 2 get nv 13 get nv 14
same = true
end
end
if not same
slot g
put vf g sadd 2
put vc g 0
put nv 6 add g 1
put nv 13 get fo 2
put nv 14 get fl 2
end
g = sub get nv 6 1
put vc g add get vc g 1
k = get nv 7
slot k
put va k sadd 1
put nv 7 add k 1
end
end
note ---- collect: exe rows from the table ib[0, nv 0)
fn cexe to void
p = ulong 0
e = get nv 0
while lt p e bound 16777217
p = row p e
cexe1
end
end
note append t and a zero to .shstrtab at s; the new end
fn sname s ulong t view uchar * to ulong
for j ulong len t bound 64
put ss add s j get t j
end
put ss add s len t 0
ret add add s len t 1
end
note one section header at o
fn shdr o ulong nm ulong ty ulong fg ulong off ulong sz ulong to void
w32 o nm
w32 add o 4 ty
w64 add o 8 fg
w64 add o 24 off
w64 add o 32 sz
end
fn shad o ulong addr ulong lk ulong inf ulong ag8 ulong es ulong to void
w64 add o 16 addr
w32 add o 40 lk
w32 add o 44 inf
w64 add o 48 ag8
w64 add o 56 es
end
note one dynamic entry
fn dent o ulong t ulong v ulong to void
w64 o t
w64 add o 8 v
end
note the hash table for the stub at o
fn hashat o ulong ns ulong to void
w32 o 1
w32 add o 4 ns
if gt ns 1
w32 add o 8 1
end
for i ulong ns bound 2097153
nx = add i 1
if ge nx ns
nx = 0
end
if eq i 0
nx = 0
end
w32 add add o 12 mul i 4 nx
end
end
note the version needs at o
fn vrat o ulong to void
q = o
x = ulong 0
ng = get nv 6
for g ulong ng bound 2097152
c = get vc g
w16 q 1
w16 add q 2 c
w32 add q 4 get vf g
w32 add q 8 16
if lt add g 1 ng
w32 add q 12 add 16 mul c 16
end
q = add q 16
for k ulong c bound 2097152
s = get va x
w32 q ehash s
w16 add q 6 add x 2
w32 add q 8 s
if lt add k 1 c
w32 add q 12 16
end
q = add q 16
x = add x 1
end
end
end
note the symbols at o
fn symat o ulong to void
ns = get nv 4
for i ulong ns bound 2097152
e = add o mul add i 1 24
w32 e get sy i
w8 add e 4 shl get sb i 4
if eq get nv 10 1
w16 add e 6 65521
end
end
end
note ---- the image: header, two program headers, .dynstr, .dynsym, [.hash], [.gnu.version_r], .dynamic, .shstrtab
fn image to ulong
st = get nv 10
s = get nv 3
nsym = add get nv 4 1
osym = al8 add 176 s
p = add osym mul nsym 24
oh = p
if eq st 1
p = al8 add p mul 4 add 3 nsym
end
ovr = p
ng = get nv 6
if eq st 0
p = al8 add p mul 16 add ng get nv 7
end
odyn = p
nd8 = ulong 7
if eq st 0
nd8 = add get nv 5 5
if gt ng 0
nd8 = add nd8 2
end
end
oshs = add odyn mul nd8 16
put nv 20 osym
put nv 21 oh
put nv 22 ovr
put nv 23 odyn
put nv 24 nd8
put nv 25 oshs
z = image2
ret z
end
fn image2 to ulong
st = get nv 10
ng = get nv 6
l = ulong 1
put ss 0 0
put nv 30 l
l = sname l n_dynstr
put nv 31 l
l = sname l n_dynsym
put nv 32 l
l = sname l n_hash
put nv 33 l
l = sname l n_vr
put nv 34 l
l = sname l n_dyn
put nv 35 l
l = sname l n_shs
put nv 36 l
shn = ulong 5
if eq st 1
shn = 6
end
if eq st 0
if gt ng 0
shn = 6
end
end
osh = al8 add get nv 25 l
tot = add osh mul shn 64
if gt tot BIG
exit 3
end
put nv 26 osh
put nv 27 shn
put nv 28 l
put nv 12 tot
ehdr
body
sects
ret tot
end
fn ehdr to void
w32 0 1179403647
w8 4 2
w8 5 1
w8 6 1
w16 16 3
w16 18 get nv 8
w32 20 1
w64 32 64
w64 40 get nv 26
w16 52 64
w16 54 56
w16 56 2
w16 58 64
w16 60 get nv 27
w16 62 sub get nv 27 1
odyn = get nv 23
dz = mul get nv 24 16
w32 64 1
w32 68 6
w64 96 add odyn dz
w64 104 add odyn dz
w64 112 4096
w32 120 2
w32 124 6
w64 128 odyn
w64 136 odyn
w64 144 odyn
w64 152 dz
w64 160 dz
w64 168 8
end
fn body to void
s = get nv 3
for i ulong s bound 16777216
put ob add 176 i get gs i
end
symat get nv 20
st = get nv 10
nsym = add get nv 4 1
if eq st 1
hashat get nv 21 nsym
end
if eq st 0
vrat get nv 22
end
q = get nv 23
if eq st 1
dent q 14 get nv 9
dent add q 16 4 get nv 21
q = add q 32
end
if eq st 0
for i ulong get nv 5 bound 2097152
dent q 1 get nd i
q = add q 16
end
end
dent q 5 176
dent add q 16 6 get nv 20
dent add q 32 10 s
dent add q 48 11 24
q = add q 64
if eq st 0
if gt get nv 6 0
dent q 1879048190 get nv 22
dent add q 16 1879048191 get nv 6
q = add q 32
end
end
dent q 0 0
o = get nv 25
for i ulong get nv 28 bound 128
put ob add o i get ss i
end
end
fn sects to void
st = get nv 10
o = add get nv 26 64
shdr o get nv 30 3 2 176 get nv 3
shad o 176 0 0 1 0
o = add o 64
nsym = add get nv 4 1
shdr o get nv 31 11 2 get nv 20 mul nsym 24
shad o get nv 20 1 1 8 24
o = add o 64
if eq st 1
shdr o get nv 32 5 2 get nv 21 mul 4 add 3 nsym
shad o get nv 21 2 0 8 4
o = add o 64
end
ng = get nv 6
if eq st 0
if gt ng 0
shdr o get nv 33 1879048190 2 get nv 22 mul 16 add ng get nv 7
shad o get nv 22 1 ng 8 0
o = add o 64
end
end
dz = mul get nv 24 16
shdr o get nv 34 6 3 get nv 23 dz
shad o get nv 23 1 0 8 16
o = add o 64
shdr o get nv 35 3 0 get nv 25 get nv 28
shad o 0 0 0 1 0
end
note ---- the PTX fixture
note append t to the output image
fn pw t view uchar * to void
o = get nv 12
for j ulong len t bound 4096
put ob add o j get t j
end
put nv 12 add o len t
end
fn ptxout to void
pw p01
pw p02
pw p03
pw p04
pw p05
pw p06
pw p07
pw p08
pw p09
pw p10
pw p11
pw p12
pw p13
pw p14
pw p15
pw p16
pw p17
pw p18
pw p19
pw p20
pw p21
pw p22
pw p23
pw p24
pw p25
pw p26
pw p27
pw p28
pw p29
pw p30
pw p31
pw p32
pw p33
pw p34
pw p35
pw p36
pw p37
pw p38
pw p39
pw p40
pw p41
pw p42
pw p43
end
fn main to int
c = argcnt
note .dynstr starts with the empty name
put nv 3 1
if lt c 3
exit 2
end
if argis 1 m_ptx
if ne c 3
exit 2
end
ptxout
save 2 get nv 12
ret 0
end
if argis 1 m_stub
if ne c 4
exit 2
end
put nv 0 ldf 2 0
put nv 10 1
cstub
ldorder
if eq get nv 8 0
exit 1
end
if eq get nv 4 0
exit 1
end
if eq get nv 9 0
exit 1
end
save 3 image
ret 0
end
if argis 1 m_exe
if ne c 6
exit 2
end
if argis 4 m_nolib
put nv 15 1
else
if not argis 4 m_full
exit 2
end
end
n = ldf 2 0
put nv 0 n
put nv 1 n
put nv 2 ldf 3 n
cexe
if eq get nv 8 0
exit 1
end
save 5 image
ret 0
end
exit 2
end

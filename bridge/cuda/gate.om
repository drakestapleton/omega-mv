for j ulong n bound 16777216
put g_c j get g_b j
end
end
rows = ulong 0
bad = n
s = ulong 0
while and ok lt s n bound 16777216
e = s
while lt e n bound 16777216
if eq get g_c e 10
break
end
e = add e 1
end
if lt sub e s 66
ok = false
bad = s
break
end
if ne get g_c add s 64 9
ok = false
bad = s
break
end
pclr
if eq src 0
pt f_bc
else
pak 3
pt f_cc
end
j = add s 65
while lt j e bound 16777216
pc ulong get g_c j
j = add j 1
end
if hfile 6
for q ulong 64
hx = get g_h add 384 q
if ne hx get g_c add s q
ok = false
end
end
else
ok = false
end
if not ok
bad = s
break

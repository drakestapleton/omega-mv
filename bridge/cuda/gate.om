const BIG ulong 16777216
const CAP ulong 1048576
global g_pa uchar 4096
global g_ap uchar 32768
global g_av uchar 65536
global g_ev uchar 8192
global g_cw uchar 4096
global g_b uchar 16777216
global g_c uchar 16777216
global g_r uchar 1048576
global g_g uchar 1048576
global g_t uchar 1048576
global g_o uchar 1048576

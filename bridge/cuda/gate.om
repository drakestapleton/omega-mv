note g_n: 0 path length, 8 argv bytes, 9 argc, 10 env bytes, 11 g_b length, 12 g_c length, 13 g_r length,
note 14 g_g length, 15 g_t length, 16 g_o length, 17 failures, 18 checks, 40..43 pattern lengths, 22 cwd length,
note 23 tier-A failures, 24 transcript on, 25 names indexed, 27 import paths under SCRATCH/lim (ilimit),
note 30..36 argument path lengths
note g_ap: argument k at 4096*k (0 SCRATCH with '/', 1 C0CHECK, 2 FIXTURE, 3 CUDAPP, 4 OLDOMC, 5 CC_AARCH64,
note 6 CC_X86_64). g_h: digest k as 64 hex at 64*k (0 synthetic aarch64, 1 synthetic x86_64, 2 synthetic nolib,
note 3 ptx, 4 mutated ptx, 5 a digest read from a profile, 6 scratch).
note ---- output: a line in g_o, flushed to stdout and, while g_n 24 is 1, kept in the transcript g_t
fn oc c ulong to void
n = get g_n 16
if lt n CAP
put g_o n uchar c
put g_n 16 add n 1
end
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn ohx k ulong to void
for j ulong 64
oc ulong get g_h add mul k 64 j
end
end
fn onl to void
oc 10
n = get g_n 16
r = write 1 g_o 0 n
if eq get g_n 24 1
t = get g_n 15
for j ulong n bound 1048576
if lt add t j CAP
put g_t add t j get g_o j
end
end
put g_n 15 add t n
end
put g_n 16 0
end
fn ook ok bool to void
put g_n 18 add get g_n 18 1
if ok
ot o_pass
else
ot o_fail
put g_n 17 add get g_n 17 1
end
end
note ---- paths
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
if lt n 4096
put g_pa n uchar c
end
put g_n 0 add n 1
end
fn pt t view uchar * to void
for i ulong len t bound 4096
pc ulong get t i
end
end
fn pak k ulong to void
for j ulong get g_n add 30 k bound 4096
pc ulong get g_ap add mul k 4096 j
end
end
fn psc t view uchar * to void
pclr
pak 0
pt t
end
fn pss t view uchar * u view uchar * to void
psc t
pt u
end
fn fopn fl ulong mode ulong to int
if gt get g_n 0 4095
ret -1
end
r = fopen g_pa 0 get g_n 0 int fl int mode
if lt r 0
ret -1
end
ret int r
end
fn frd to int
ret fopn 524288 0
end
fn fwr to int
ret fopn 524865 420
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
note ---- g_b: load the file g_pa (true when whole and under 16 MiB), save it to g_pa
fn bload to bool
put g_n 11 0
fd = frd
if lt fd 0
ret false
end
n = ulong 0
ok = true
while true bound 16777218
x = read fd g_b n sub BIG n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n BIG
ok = false
break
end
end
fclo fd
put g_n 11 n
ret ok
end
fn bsave to bool
fd = fwr
if lt fd 0
ret false
end
n = get g_n 11
o = ulong 0
ok = true
while lt o n bound 16777217
x = write fd g_b o sub n o
if le x 0
ok = false
break
end
o = add o ulong x
end
fclo fd
ret ok
end
note g_b into g_r, g_g (false when over 1 MiB)
fn b2r to bool
n = get g_n 11
if ge n CAP
ret false
end
for j ulong n bound 1048576
put g_r j get g_b j
end
put g_n 13 n
ret true
end
fn b2g to bool
n = get g_n 11
if ge n CAP
ret false
end
for j ulong n bound 1048576
put g_g j get g_b j
end
put g_n 14 n
ret true
end
note digest of the file g_pa into slot k; false when unreadable
fn hfile k ulong to bool
if not bload
ret false
end
n = get g_n 11
for j ulong n bound 16777216
put sh_dat j get g_b j
end
sh_all n
for j ulong 32
b = get sh_dig j
put g_h add mul k 64 mul j 2 sh_hexd uint shr b 4
put g_h add add mul k 64 mul j 2 1 sh_hexd uint and b 15
end
ret true
end
fn heq a ulong b ulong to bool
for j ulong 64
if ne get g_h add mul a 64 j get g_h add mul b 64 j
ret false
end
end
ret true
end
note ---- edits of g_b
note does g_b hold digest slot a at offset i
fn hmat i ulong a ulong to bool
o = mul a 64
for j ulong 64
if ne get g_b add i j get g_h add o j
ret false
end
end
ret true
end
note replace every occurrence of digest slot a by digest slot b (same length, in place)
fn hsub a ulong b ulong to void
n = get g_n 11
if lt n 64
ret
end
o = mul b 64
for i ulong add sub n 64 1 bound 16777216
if hmat i a
for j ulong 64
put g_b add i j get g_h add o j
end
end
end
end
note digest in the field after the line prefix t (first such line) into slot 5; false when absent
fn hfind t view uchar * to bool
n = get g_n 11
s = ulong 0
while lt s n bound 16777216
m = le add add s len t 64 n
for j ulong len t bound 4096
if m
if ne get g_b add s j get t j
m = false
end
end
end
if m
for j ulong 64
put g_h add 320 j get g_b add add s len t j
end
ret true
end
while lt s n bound 16777216
c = get g_b s
s = add s 1
if eq c 10
break
end
end
end
ret false
end
fn bapp t view uchar * to bool
n = get g_n 11
if ge add n len t BIG
ret false
end
for j ulong len t bound 4096
put g_b add n j get t j
end
put g_n 11 add n len t
ret true
end
note patterns 0..3 at 4096*k, lengths in g_n 40..43
fn setp k ulong t view uchar * to void
for j ulong len t bound 4096
put g_pt add mul k 4096 j get t j
end
put g_n add 40 k len t
end
fn cput c uchar to void
n = get g_n 12
if lt n BIG
put g_c n c
end
put g_n 12 add n 1
end
fn cpat k ulong to void
for j ulong get g_n add 40 k bound 4096
cput get g_pt add mul k 4096 j
end
end
fn crng s ulong e ulong to void
j = s
while lt j e bound 16777216
cput get g_b j
j = add j 1
end
end
note does g_b[s,e) start with (w 0), equal (w 1) or end with (w 2) pattern k
fn lmat s ulong e ulong k ulong w ulong to bool
p = get g_n add 40 k
if gt p sub e s
ret false
end
if eq w 1
if ne p sub e s
ret false
end
end
b = s
if eq w 2
b = sub e p
end
ret pmat b k
end
note does g_b at b hold pattern k
fn pmat b ulong k ulong to bool
q = mul k 4096
for j ulong get g_n add 40 k bound 4096
x = get g_b add b j
if ne x get g_pt add q j
ret false
end
end
ret true
end
note rewrite g_b line by line through g_c, as sed or grep -v would:
note md 1 drop lines starting with pattern 0; md 2 lines starting with 0 get 1 in its place; md 3 a line equal to
note 0 becomes 1; md 4 the line 1 goes before each line equal to 0; md 5 a line starting with 0 and ending with 2
note (the two not overlapping) ends with 1 instead of 2. False when the result passes 16 MiB.
fn xl md ulong to bool
n = get g_n 11
put g_n 12 0
s = ulong 0
while lt s n bound 16777216
e = s
while lt e n bound 16777216
if eq get g_b e 10
break
end
e = add e 1
end
k = true
if eq md 1
k = not lmat s e 0 0
end
if eq md 2
if lmat s e 0 0
cpat 1
s = add s get g_n 40
end
end
if eq md 3
if lmat s e 0 1
cpat 1
s = e
end
end
if eq md 4
if lmat s e 0 1
cpat 1
cput 10
end
end
if eq md 5
if lmat s e 0 0
if lmat s e 2 2
if le add get g_n 40 get g_n 42 sub e s
crng s sub e get g_n 42
cpat 1
s = e
end
end
end
end
if k
crng s e
if lt e n
cput 10
end
end
s = add e 1
end
m = get g_n 12
if gt m BIG
ret false
end
for j ulong m bound 16777216
put g_b j get g_c j
end
put g_n 11 m
ret true
end
note ---- processes
fn aclr to void
put g_n 8 2
put g_n 9 0
end
fn apa to void
p = get g_n 8
n = get g_n 0
if gt add add p n 2 65536
exit 2
end
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 8 add p add n 2
c = add get g_n 9 1
put g_n 9 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end
fn atx t view uchar * to void
pclr
pt t
apa
end
fn ask k ulong to void
pclr
pak k
apa
end
fn ast t view uchar * to void
psc t
apa
end
note the environment: PATH, and OMEGA_OMC when the oracle runs
fn envset omc bool to void
put g_ev 0 1
put g_ev 1 0
p = ulong 2
put g_ev p uchar len e_path
put g_ev add p 1 0
for j ulong len e_path bound 64
put g_ev add add p 2 j get e_path j
end
p = add add p 2 len e_path
if omc
put g_ev 0 2
n = add len e_omc get g_n 34
put g_ev p uchar and n 255
put g_ev add p 1 uchar shr n 8
p = add p 2
for j ulong len e_omc bound 64
put g_ev add p j get e_omc j
end
p = add p len e_omc
for j ulong get g_n 34 bound 4096
put g_ev add p j get g_ap add 16384 j
end
p = add p get g_n 34
end
put g_n 10 p
end
fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run the argument list (in g_cw when g_n 22 is not 0), stdin /dev/null, stdout and stderr to SCRATCH/o.out
note and SCRATCH/o.err: the exit code, 256 + the signal, 512 when a file could not be opened, 1000 when killed at
note the 600 s deadline
fn runo o view uchar * to ulong
pclr
pt f_null
fi = frd
pss o s_out
fo = fwr
pss o s_err
fe = fwr
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
if ne get g_n 22 0
if ne chdir g_cw 0 get g_n 22 0
exit 127
end
end
r = execenv g_av 0 get g_n 8 g_ev 0 get g_n 10
exit 127
end
fclo fi
fclo fo
fclo fe
t0 = monons
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 600000000000
r = killpid int pid 9
r = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
q = sleepns 200000
end
exit 2
end
note SCRATCH/o.out into g_r; false when unreadable or over 1 MiB
fn rout o view uchar * to bool
pss o s_out
if not bload
ret false
end
ret b2r
end
note ---- C0CHECK
fn ck0 w view uchar * to void
aclr
ask 1
atx w
end
note is "REFUSED " + why inside g_r
fn rhas why view uchar * to bool
n = get g_n 13
w = add len m_refused len why
if lt n w
ret false
end
for i ulong add sub n w 1 bound 1048576
m = true
for j ulong w bound 8192
if m
c = get m_refused 0
if lt j len m_refused
c = get m_refused j
else
c = get why sub j len m_refused
end
if ne get g_r add i j c
m = false
end
end
end
if m
ret true
end
end
ret false
end
note g_r as the shell's $(cat file) (trailing newlines dropped) or tr '\n' ';' (sem true)
fn orr sem bool to void
n = get g_n 13

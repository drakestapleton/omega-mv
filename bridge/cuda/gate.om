fn usage to void
r = write 2 t_usage 0 len t_usage
exit 2
end
fn main to int
argc = ulong argcnt
if and ne argc 4 ne argc 8
usage
end
for k ulong 7
if lt k sub argc 1
n = argread add k 1 g_ap mul k 4096 4095
if or lt n 1 ge n 4095
usage
end
put g_n add 30 k ulong n
end
end
if and eq argc 8 ne get g_ap 0 47
usage
end
n = get g_n 30
if ne get g_ap sub n 1 47
put g_ap n 47
put g_n 30 add n 1
end
pclr
pak 0
r = makedir g_pa 0 sub get g_n 0 1 448
if ne r 0
r = write 2 t_noscr 0 len t_noscr
exit 2
end
pclr
pt f_gold
if not bload
r = write 2 t_nogold 0 len t_nogold
exit 2
end
if not b2g
r = write 2 t_nogold 0 len t_nogold
exit 2
end
envset false
tiera
note the transcript is complete; compare it
ok = tgold
ook ok
if ok
ot o_gold
else
ot o_goldf
end
onl
ilimit
copies 0
oracle = ulong 0
if eq argc 8
f0 = get g_n 17
tierb
copies 1
oracle = 1
if ne get g_n 17 f0
oracle = 2
end
end
ot o_sum
fl = get g_n 17
if eq fl 0
ot o_spass
else
ot o_sfail
end
ot o_checks
onum get g_n 18
ot o_failed
onum fl
ot o_oracle
if eq oracle 0
ot o_notrun
end
if eq oracle 1
ot o_spass
end
if eq oracle 2
ot o_sfail
end
ot o_hw
r = write 1 g_o 0 get g_n 16
put g_n 16 0
if eq fl 0
ret 0
end
ret 1
end

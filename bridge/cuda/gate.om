end
onl
end
note ---- the limit: SCRATCH/lim-v1.tsv is one cuInit row and pad bytes x, v2 and v3 the cuInit row alone
fn lfile v ulong pad ulong to bool
n = len m_row
for j ulong n bound 4096
put g_b j get m_row j
end
for j ulong pad bound 16777216
put g_b add n j 120
end
put g_n 11 add n pad
psc s_lim
pt f_v
pc add 49 v
pt f_tsv
ret bsave
end
fn lset pad ulong to bool
ok = lfile 0 pad
if ok
ok = lfile 1 0
end
if ok
ok = lfile 2 0
end
ret ok
end
note three versions of 16777215 bytes together must be read and compared, of 16777216 refused
fn ilimit to void

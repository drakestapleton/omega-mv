note ---- the import lists of v1, v2, v3 as multisets of names. The binding limit is g_b: the three versions of one
note ISA are read into it together and must hold under 16 MiB (checked by ilimit). The name table g_io/g_il cannot
note overflow under that limit: an indexed row is at least 12 bytes (import TAB, a name, TAB, cuda), and
note WolframLanguageEvaluator: Floor[16777216/12] -> 1398101, under the table's 2097152 entries. A put past the
note table would trap (exit 103), never overrun.
fn idx v ulong o ulong to void
n = get g_n 11
s = o
while lt s n bound 16777216
e = s
while lt e n bound 16777216
if eq get g_b e 10
break
end
e = add e 1
end
if lmat s e 3 0
f = add s len m_import
g = f
while lt g e bound 16777216
if eq get g_b g 9
break
end
g = add g 1
end
c = false
if lt g e
c = iscuda add g 1 e
end
if c
k = get g_n 25
put g_io k f
put g_il k sub g f
put g_n 25 add k 1
end
end
s = add e 1
end
put g_iv v get g_n 25
end
note is g_b[h, e) the field cuda (ending at e or at a tab)
fn iscuda h ulong e ulong to bool
if gt add h 4 e
ret false
end
if ne get g_b h 99
ret false
end
if ne get g_b add h 1 117
ret false
end
if ne get g_b add h 2 100
ret false
end
if ne get g_b add h 3 97
ret false
end
if lt add h 4 e
ret eq get g_b add h 4 9
end
ret true
end
fn ieq a ulong b ulong to bool
la = get g_il a
if ne la get g_il b
ret false
end
oa = get g_io a
ob = get g_io b
for j ulong la bound 16777216
x = get g_b add oa j
if ne x get g_b add ob j
ret false
end
end
ret true
end
note occurrences of name i among the names of version v
fn icnt i ulong v ulong to ulong
lo = ulong 0
if gt v 0
lo = get g_iv sub v 1
end
c = ulong 0
k = lo
while lt k get g_iv v bound 2097152
if ieq i k
c = add c 1
end
k = add k 1
end
ret c
end
fn isame a ulong b ulong to bool
la = ulong 0
if gt a 0
la = get g_iv sub a 1
end
lb = ulong 0
if gt b 0
lb = get g_iv sub b 1
end
if ne sub get g_iv a la sub get g_iv b lb
ret false
end
i = la
while lt i get g_iv a bound 2097152
if ne icnt i a icnt i b
ret false
end
i = add i 1
end
ret true
end
note load and compare the three versions; the path is bridge/cuda/profile-c0-ISA-vN.tsv, or SCRATCH/lim-vN.tsv
note while g_n 27 is 1 (ilimit)
fn iload isa view uchar * to bool
put g_n 25 0
setp 3 m_import
put g_n 11 0
ok = true
for v ulong 3
o = get g_n 11
if eq get g_n 27 1
psc s_lim
else
pclr
pt f_pfx
pt isa
end
pt f_v
pc add 49 v
pt f_tsv
fd = frd
if lt fd 0
ok = false
end
n = o
while ge fd 0 bound 16777218
x = read fd g_b n sub BIG n
if le x 0
if lt x 0
ok = false
end
break
end
n = add n ulong x
if ge n BIG
ok = false
break
end
end
fclo fd
put g_n 11 n
idx v o
end
if ok
ok = and isame 0 1 isame 1 2
end
ret ok
end
fn imports isa view uchar * to void
ok = iload isa

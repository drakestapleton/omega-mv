note bridge/abi-v2-spec/abi_v2_qual.om: Pure seeded OM-2 RM7 qualification unit for ABI v2.
note Covers all ABI v2 parameter classes, all 8 element types, void/ulong/long returns,
note every runtime trap and RM2 contract status (1..14), out-buffer rollback, and reentry spin.
note bridge c-type qhdr omega_qhdr_t
note bridge c-define OMEGA_QHDR_BYTES 24
om2
layout qhdr 24
field tag uint at 0 little
field val ulong at 8 little
field key uchar 8 at 16 little
end

note 1. Unsigned scalar arithmetic
export fn q_add a ulong b ulong to ulong
ret add a b
end

note 2. Signed scalar arithmetic (two's-complement long across ABI)
export fn q_sub_signed a long b long to long
ret sub a b
end

note 3. Unsized view ulong * (2 slots; tests empty n=0, 8-byte alignment, overflow checks)
export fn q_sum_view d view ulong * to ulong
s = ulong 0
n = len d
for i ulong n bound 65536
s = add s get d i
end
ret s
end

note 4. Unsized edit uint * + scalar (3 slots; tests 4-byte alignment, in-place mutation)
export fn q_scale_edit d edit uint * fac ulong to ulong
n = len d
s = ulong 0
f32v = uint fac
for i ulong n bound 65536
v = mul get d i f32v
put d i v
s = add s ulong v
end
ret s
end

note 5. Sized view uchar 8 + sized edit uchar 8 (2 slots; tests exact-length check & overlap refusal)
export fn q_sized_copy src view uchar 8 dst edit uchar 8 to ulong
s = ulong 0
for i ulong 8
b = get src i
put dst i xor b uchar 90
s = add s ulong b
end
ret s
end

note 6. All remaining narrow & signed element types: ushort *, short 4, byte 4, int 4 (5 slots)
export fn q_narrow_types a view ushort * b edit short 4 c view byte 4 d view int 4 to long
acc = long 0
na = len a
for i ulong na bound 1024
acc = add acc long get a i
end
for i ulong 4
bv = get b i
cv = get c i
dv = get d i
put b i add bv short 1
acc = add acc add add long bv long cv long dv
end
ret acc
end

note 7. Layout edit qhdr + view uchar * (3 slots, void return -> *result = 0 on OK)
export fn q_layout_edit hdr edit qhdr d view uchar * to void
t = get hdr tag
n = len d
for i ulong n bound 4096
t = add t uint get d i
end
put hdr tag t
put hdr val add get hdr val n
end

note 8. Layout view qhdr + out uchar 16 (2 slots; writes little-endian fields into out buffer)
export fn q_layout_out hdr view qhdr dst out uchar 16 to ulong
for i ulong 8
put dst i get hdr key i
end
t = get hdr tag
for i ulong 4
put dst add 8 i uchar and t uint 255
t = shr t uint 8
end
put dst 12 uchar 165
put dst 13 uchar 90
ret get hdr val
end

note 9. Out buffer allowed to overlap view parameter (memmove copy-back after return)
export fn q_out_overlap_view src view uchar * dst out uchar 8 to ulong
s = ulong 0
n = len src
for i ulong 8
b = uchar 0
if lt i n
b = get src i
end
put dst i xor b uchar 255
s = add s ulong b
end
ret s
end

note 10. Two out buffers (void return; proves out/out overlap returns OMEGA_BAD_ARG 32)
export fn q_two_out a out uchar 8 b out uchar 8 to void
for i ulong 8
put a i uchar add i 1
put b i uchar add i 17
end
end

note 11. Out buffer modified before trap (proves caller out buffer & result stay untouched on trap)
export fn q_out_trap fail ulong dst out uchar 8 to ulong
put dst 0 uchar 171
put dst 1 uchar 205
if ne fail 0
trap 9
end
ret 42
end

note 12. Trap 1: checked signed integer overflow
export fn q_trap1_ovf a long b long to long
ret add a b
end

note 13. Trap 2: division by zero
export fn q_trap2_div0 a ulong b ulong to ulong
ret div a b
end

note 14. Trap 3: array bounds out of range
export fn q_trap3_bounds d view uchar * idx ulong to ulong
ret ulong get d idx
end

note 15. Trap 4: loop bound exceeded
export fn q_trap4_loop n ulong to ulong
i = ulong 0
while lt i n bound 8
i = add i 1
end
ret i
end

note 16. Trap 5: checked narrowing cast overflow
export fn q_trap5_cast x ulong to ulong
b = uchar x
ret ulong b
end

note 17. Trap 7: invalid shift amount (>= 64)
export fn q_trap7_shift x ulong sh ulong to ulong
ret shl x sh
end

note 18. Trap 9: RM2 requires precondition failure
export fn q_req9 x ulong to ulong
requires gt x 0
ret add x 1
end

note 19. Trap 10: RM2 ensures postcondition failure
export fn q_ens10 x ulong to ulong
ensures gt result 10
ret x
end

note 20. Trap 10: RM2 loop invariant failure
export fn q_inv10 lim ulong to ulong
i = ulong 0
while lt i lim bound 64
invariant lt i 5
i = add i 1
end
ret i
end

note 21. Explicit traps 6, 8, 11, 12, 13, 14 (and 0 returns 0)
export fn q_trap_code code ulong to ulong
if eq code 6
trap 6
end
if eq code 8
trap 8
end
if eq code 11
trap 11
end
if eq code 12
trap 12
end
if eq code 13
trap 13
end
if eq code 14
trap 14
end
ret code
end

note 22. Bounded spin for live SIGUSR1 OMEGA_REENTRY (status 33) qualification
export fn q_spin outer ulong inner ulong to ulong
s = ulong 0
for i ulong outer bound 200000
for j ulong inner bound 200000
s = xor s add i j
end
end
ret s
end

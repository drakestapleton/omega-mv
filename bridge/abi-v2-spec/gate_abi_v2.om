om2
note bridge/abi-v2-spec/gate_abi_v2.om: Pure seeded OM-2 RM7 qualification verifier.
note Verifies:
note   1. Pinned seed/out/omc SHA-256 (exits 69 on mismatch, fail-closed).
note   2. Well-formed 4-column TSV results with zero FAIL rows and zero duplicate IDs.
note   3. All 32 mandatory RM7 cases (determinism, statuses 0/1..14/32/33, out atomicity,
note      all 6 host languages + C-BTI, link/ident negative controls, FR-7 shlib + dlvsym)
note      present and PASS.
note Usage: gate_abi_v2 <omc_path> <omc_sha256_file> <results_tsv_path>

text HEX "0123456789abcdef"
text SHX ""

text MAND "|build_2x_determinism|c_abi_v2_params|c_bti_abi_v2|status_0_ok|status_1_ovf|status_2_div0|status_3_bounds|status_4_loop|status_5_cast|status_6_oom|status_7_shift|status_8_rt|status_9_requires|status_10_ensures|status_10_invariant|status_11_arena|status_12_stale|status_13_pool|status_14_retired|status_32_bad_arg|status_33_reentry|out_atomicity_on_trap|cpp_abi_v2|rust_forbid_unsafe_abi_v2|zig_abi_v2|python_ctypes_abi_v2|go_cgo_abi_v2|neg_link_abi_mismatch|neg_python_ident_mismatch|fr7_shlib_om_dlopen|fr7_ver_so_dlvsym_v2_pass|fr7_ver_so_dlvsym_v1_refused|"

text S_PASS "PASS"
text S_FAIL "FAIL"
text S_NOTRUN "NOT_RUN"
text C_CTRL "control"
text C_LANG "lang"
text E_USAGE "usage: gate_abi_v2 <omc_path> <omc_sha256_file> <results_tsv>\n"
text E_OPEN "ABI_V2_GATE FAIL cannot_open_file\n"
text E_PIN "ABI_V2_GATE FAIL omc_pin_mismatch got="
text E_FMT "ABI_V2_GATE FAIL malformed_tsv_row\n"
text E_DUP "ABI_V2_GATE FAIL duplicate_case="
text E_CASE "ABI_V2_GATE FAIL failed_case="
text E_MISS "ABI_V2_GATE FAIL missing_mandatory="
text E_NRUN "ABI_V2_GATE FAIL not_run_count="
text P_OK "ABI_V2_GATE PASS omc_pin="
text P_CHK " checks="
text P_MAN " mandatory="
text P_CTL " controls="
text P_LNG " langs="
text P_HW " hardware=HOST_VERIFIED\n"
text P_NL "\n"
text P_SL "/"

global argbuf uchar 4096
global rbuf uchar 65536
global tsv uchar 131072
global shk ulong 72
global shw ulong 64
global shh ulong 8
global shv ulong 8
global shblk_buf uchar 64
global shhex uchar 64
global pinbuf uchar 256
global mand_seen ulong 64
global seen_off ulong 512
global seen_len ulong 512
global seen_cnt ulong 1
global fld_off ulong 8
global fld_len ulong 8
global decbuf uchar 32
global stats ulong 8

fn werr s view uchar * to void
r = write 2 s 0 len s
end

fn wout s view uchar * to void
r = write 1 s 0 len s
end

fn wdec fd int v ulong to void
x = v
n = ulong 0
put decbuf n uchar add rem x 10 48
n = add n 1
x = div x 10
while ne x 0 bound 24
put decbuf n uchar add rem x 10 48
n = add n 1
x = div x 10
end
i = ulong 0
while lt i div n 2 bound 24
j = sub sub n 1 i
t = get decbuf i
put decbuf i get decbuf j
put decbuf j t
i = add i 1
end
r = write fd decbuf 0 n
end

fn ror32 x ulong n ulong to ulong
a = shr x n
b = shl x sub 32 n
ret and or a b 4294967295
end

fn sh_init to void
for i ulong 72
v = ulong 0
for j ulong 8
c = ulong get SHX add mul i 8 j
if lt c 58
v = or shl v 4 sub c 48
else
v = or shl v 4 sub c 87
end
end
put shk i v
end
for i ulong 8
put shh i get shk add 64 i
end
end

fn sh_sched to void
for i ulong 16
j = mul i 4
v = shl ulong get shblk_buf j 24
v = or v shl ulong get shblk_buf add j 1 16
v = or v shl ulong get shblk_buf add j 2 8
v = or v ulong get shblk_buf add j 3
put shw i v
end
for i ulong 48
t = add i 16
x = get shw sub t 15
y = get shw sub t 2
s0 = xor xor ror32 x 7 ror32 x 18 shr x 3
s1 = xor xor ror32 y 17 ror32 y 19 shr y 10
a = add get shw sub t 16 s0
b = add get shw sub t 7 s1
put shw t and add a b 4294967295
end
end

fn sg0 a ulong to ulong
ret xor xor ror32 a 2 ror32 a 13 ror32 a 22
end

fn sg1 e ulong to ulong
ret xor xor ror32 e 6 ror32 e 11 ror32 e 25
end

fn chf e ulong f ulong g ulong to ulong
ret xor and e f and xor e 4294967295 g
end

fn mjf a ulong b ulong c ulong to ulong
ret xor xor and a b and a c and b c
end

fn sh_round i ulong to void
e = get shv 4
t1 = add add get shv 7 sg1 e chf e get shv 5 get shv 6
t1 = and add add t1 get shk i get shw i 4294967295
a = get shv 0
t2 = and add sg0 a mjf a get shv 1 get shv 2 4294967295
for j ulong 7
k = sub 7 j
put shv k get shv sub k 1
end
put shv 4 and add get shv 4 t1 4294967295
put shv 0 and add t1 t2 4294967295
end

fn sh_compress to void
sh_sched
for i ulong 8
put shv i get shh i
end
for i ulong 64
sh_round i
end
for i ulong 8
put shh i and add get shh i get shv i 4294967295
end
end

fn sh_feed un ulong blen_in ulong to ulong
blen = blen_in
for i ulong un bound 65536
put shblk_buf blen get rbuf i
blen = add blen 1
if eq blen 64
sh_compress
blen = 0
end
end
ret blen
end

fn sh_to_hex to void
for i ulong 8
w = get shh i
for j ulong 8
nib = and shr w sub 28 mul j 4 15
put shhex add mul i 8 j get HEX nib
end
end
end

fn sh_finish total ulong blen_in ulong to void
blen = blen_in
put shblk_buf blen uchar 128
blen = add blen 1
if gt blen 56
while lt blen 64 bound 64
put shblk_buf blen uchar 0
blen = add blen 1
end
sh_compress
blen = 0
end
while lt blen 56 bound 64
put shblk_buf blen uchar 0
blen = add blen 1
end
bits = mul total 8
for i ulong 8
put shblk_buf add 56 i uchar and shr bits mul sub 7 i 8 255
end
sh_compress
sh_to_hex
end

fn sha256_file path_len ulong to ulong
fd = fopen argbuf 0 path_len int 0 int 0
if lt fd 0
ret 1
end
sh_init
blen = ulong 0
total = ulong 0
done = ulong 0
while eq done 0 bound 1000000
n = read int fd rbuf 0 65536
if lt n 0
rc = fclose int fd
ret 1
end
if eq n 0
done = 1
else
total = add total ulong n
blen = sh_feed ulong n blen
end
end
rc = fclose int fd
sh_finish total blen
ret 0
end

fn is_lhex c uchar to ulong
if and ge c uchar 48 le c uchar 57
ret 1
end
if and ge c uchar 97 le c uchar 102
ret 1
end
ret 0
end

fn load_pin path_len ulong to ulong
fd = fopen argbuf 0 path_len int 0 int 0
if lt fd 0
ret 1
end
n = read int fd pinbuf 0 256
rc = fclose int fd
if lt n 64
ret 1
end
for i ulong 64
if eq is_lhex get pinbuf i 0
ret 1
end
end
ret 0
end

fn pin_matches to ulong
for i ulong 64
if ne get shhex i get pinbuf i
ret 0
end
end
ret 1
end

fn load_tsv path_len ulong to long
fd = fopen argbuf 0 path_len int 0 int 0
if lt fd 0
ret -1
end
tot = ulong 0
done = ulong 0
while eq done 0 bound 4096
rem_cap = sub len tsv tot
if eq rem_cap 0
rc = fclose int fd
ret -1
end
n = read int fd tsv tot rem_cap
if lt n 0
rc = fclose int fd
ret -1
end
if eq n 0
done = 1
else
tot = add tot ulong n
end
end
rc = fclose int fd
ret long tot
end

fn tsv_eq_txt off ulong n ulong t view uchar * to ulong
if ne n len t
ret 0
end
for i ulong n bound 256
if ne get tsv add off i get t i
ret 0
end
end
ret 1
end

fn tsv_eq_span o1 ulong n1 ulong o2 ulong n2 ulong to ulong
if ne n1 n2
ret 0
end
for i ulong n1 bound 256
if ne get tsv add o1 i get tsv add o2 i
ret 0
end
end
ret 1
end

fn record_seen off ulong n ulong to ulong
cnt = get seen_cnt 0
for i ulong cnt bound 512
if eq tsv_eq_span off n get seen_off i get seen_len i 1
ret 0
end
end
if ge cnt 512
ret 0
end
put seen_off cnt off
put seen_len cnt n
put seen_cnt 0 add cnt 1
ret 1
end

fn match_mand_at off ulong n ulong mo ulong mn ulong to ulong
if ne n mn
ret 0
end
for j ulong mn bound 128
if ne get tsv add off j get MAND add mo j
ret 0
end
end
ret 1
end

fn mark_mandatory off ulong n ulong to void
idx = ulong 0
i = ulong 1
ml = len MAND
while lt i ml bound 4096
j = i
while and lt j ml ne get MAND j uchar 124 bound 128
j = add j 1
end
if eq match_mand_at off n i sub j i 1
put mand_seen idx 1
ret
end
idx = add idx 1
i = add j 1
end
end

fn count_mand_total to ulong
idx = ulong 0
i = ulong 1
ml = len MAND
while lt i ml bound 4096
j = i
while and lt j ml ne get MAND j uchar 124 bound 128
j = add j 1
end
idx = add idx 1
i = add j 1
end
ret idx
end

fn emit_missing_mand idx_want ulong to void
idx = ulong 0
i = ulong 1
ml = len MAND
while lt i ml bound 4096
j = i
while and lt j ml ne get MAND j uchar 124 bound 128
j = add j 1
end
if eq idx idx_want
werr E_MISS
r = write 2 MAND i sub j i
werr P_NL
ret
end
idx = add idx 1
i = add j 1
end
end

fn split_fields s ulong e ulong to ulong
nf = ulong 0
p = s
cur = s
while lt p e bound 8192
if eq get tsv p uchar 9
if ge nf 7
ret 99
end
put fld_off nf cur
put fld_len nf sub p cur
nf = add nf 1
cur = add p 1
end
p = add p 1
end
put fld_off nf cur
put fld_len nf sub e cur
nf = add nf 1
ret nf
end

fn check_row s ulong e ulong to ulong
nf = split_fields s e
if ne nf 4
werr E_FMT
ret 1
end
if or eq get fld_len 0 0 eq get fld_len 1 0
werr E_FMT
ret 1
end
if eq record_seen get fld_off 0 get fld_len 0 0
werr E_DUP
r = write 2 tsv get fld_off 0 get fld_len 0
werr P_NL
ret 1
end
put stats 0 add get stats 0 1
if eq tsv_eq_txt get fld_off 2 get fld_len 2 S_PASS 1
mark_mandatory get fld_off 0 get fld_len 0
if eq tsv_eq_txt get fld_off 1 get fld_len 1 C_CTRL 1
put stats 3 add get stats 3 1
end
if eq tsv_eq_txt get fld_off 1 get fld_len 1 C_LANG 1
put stats 4 add get stats 4 1
end
ret 0
end
if eq tsv_eq_txt get fld_off 2 get fld_len 2 S_FAIL 1
werr E_CASE
r = write 2 tsv get fld_off 0 get fld_len 0
werr P_NL
put stats 1 add get stats 1 1
ret 0
end
if eq tsv_eq_txt get fld_off 2 get fld_len 2 S_NOTRUN 1
put stats 2 add get stats 2 1
ret 0
end
werr E_FMT
ret 1
end

fn parse_tsv_all tn ulong to ulong
pos = ulong 0
while lt pos tn bound 8192
e = pos
while and lt e tn ne get tsv e uchar 10 bound 8192
e = add e 1
end
le2 = e
if gt le2 pos
if eq get tsv sub le2 1 uchar 13
le2 = sub le2 1
end
end
if gt le2 pos
if ne get tsv pos uchar 35
if ne check_row pos le2 0
ret 1
end
end
end
pos = add e 1
end
ret 0
end

fn main to int
ac = ulong argcnt
if ne ac 4
werr E_USAGE
ret 2
end
a1 = argread 1 argbuf 0 4095
if le a1 0
werr E_USAGE
ret 2
end
if ne sha256_file ulong a1 0
werr E_OPEN
ret 1
end
a2 = argread 2 argbuf 0 4095
if le a2 0
werr E_USAGE
ret 2
end
if ne load_pin ulong a2 0
werr E_PIN
r = write 2 shhex 0 64
werr P_NL
ret 69
end
if eq pin_matches 0
werr E_PIN
r = write 2 shhex 0 64
werr P_NL
ret 69
end
a3 = argread 3 argbuf 0 4095
if le a3 0
werr E_USAGE
ret 2
end
tlen = load_tsv ulong a3
if lt tlen 0
werr E_OPEN
ret 1
end
if ne parse_tsv_all ulong tlen 0
ret 1
end
if gt get stats 1 0
ret 1
end
mtot = count_mand_total
for i ulong mtot bound 64
if eq get mand_seen i 0
emit_missing_mand i
ret 1
end
end
if gt get stats 2 0
werr E_NRUN
wdec int 2 get stats 2
werr P_NL
ret 1
end
wout P_OK
r = write 1 shhex 0 16
wout P_CHK
wdec int 1 get stats 0
wout P_MAN
wdec int 1 mtot
wout P_SL
wdec int 1 mtot
wout P_CTL
wdec int 1 get stats 3
wout P_LNG
wdec int 1 get stats 4
wout P_HW
ret 0
end

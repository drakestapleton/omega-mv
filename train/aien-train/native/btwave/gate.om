note SPDX-License-Identifier: AGPL-3.0-only
note BTWAVE-P0: Pure Seeded OM-2 Gate & Mutant Harness (native/btwave/gate.om).
note Concatenated after native/btwave/trit.om (reusing FIPS 180-4 SHA-256 primitives)
note and compiled with pinned omc:
note   cat native/btwave/trit.om native/btwave/gate.om | "$OMC" > /tmp/btwave-gate
note   chmod +x /tmp/btwave-gate
note   rm -rf /tmp/btwave-ev && cp -r evidence/BTWAVE-P0 /tmp/btwave-ev
note   /tmp/btwave-gate "$OMC" /tmp/btwave-ev
note Zero shell, Python, C, C++, or Rust implementation code.

global Gomc uchar 512
global Gomclen ulong 1
global Gout uchar 512
global Goutlen ulong 1

global Gsrc uchar 131072
global Gsrclen ulong 1
global Gmut uchar 131072
global Gmutlen ulong 1
global Gexp uchar 65536
global Gexplen ulong 1
global Gfile uchar 2097152
global Gfilelen ulong 1
global Gtsv uchar 131072
global Gtsvlen ulong 1

global Gtin uchar 128
global Gtinlen ulong 1
global Gtbin uchar 128
global Gtbinlen ulong 1
global Gtout uchar 128
global Gtoutlen ulong 1

global Gpkt uchar 4096
global Gpath uchar 1024

global Gbsha1 uchar 64
global Gbsha2 uchar 64
global Gssha uchar 64
global Gmsha uchar 64
global Gosha uchar 64

text Sdevnull "/dev/null"
text Sf1 "native/btwave/trit.om"
text Sf2 "native/btwave/ledger.om"
text Sf3 "native/btwave/wave_ipc.om"
text Sf4 "native/btwave/main.om"
text Sexpf "/expected-trace.out"
text Sipcf "/ipc.stdout"
text Srecf "/receipt.tsv"
text Stmpin "/tmp/btwave_g_in_"
text Stmpbin "/tmp/btwave_g_bin_"
text Stmpout "/tmp/btwave_g_out_"

text PinOmc "f4fa7951816bbd09c5eaaae6692852a70c3c305164b365027c5b683dec7d63e9"
text PinTrace "b0c6399a7ae894148e8e1678a272add68385bdf67d6221044ded82216fb73575"
text PinEmpty "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
text SipcPref "IPC PASS coreA=16 coreB=17 rounds=8 contrib=240 extract=180 odraft_refused=-10 elapsed_ns="

text Hc1 "case"
text Hc2 "build"
text Hc3 "source_sha256"
text Hc4 "compile_rc"
text Hc5 "binary_sha256"
text Hc6 "run_exit"
text Hc7 "stdout_sha256"
text Hc8 "verdict"

text Tdash "-"
text Torig "original"
text Tself "selftest"
text Ttrace "trace"
text Tipc "ipc"
text Tusage "usage"
text Tcomp "compile"
text Tovfb "overflow-backstop"
text Tovfp "ovf-probe"
text Ttrapt "trap-trit"
text Ttrapd "trap-dup"
text Ttrapr "trap-req"
text Tbadarg "unknown"
text Textra "extra"

text Tpass "PASS"
text Tscaught "SELFTEST_CAUGHT"
text Tsmiss "SELFTEST_MISSED"
text Tokilled "ORACLE_KILLED"
text Ttrap1 "TRAP1"
text Ttrap9 "TRAP9"
text Ttrap10 "TRAP10"
text Tcref7 "COMPILE_REFUSED_7"

text Tccor "comparator-corrupt-trace"
text Tcanone "cli-arg-none"
text Tcabad "cli-arg-bad"
text Tcatwo "cli-arg-two"
text Tptrit "probe-trap-trit"
text Tpdup "probe-trap-dup"
text Tpreq "probe-trap-req"
text Tpovf "probe-ovf-guarded"

text MsgUsage "BTWAVE FAIL usage: btwave-gate <omc_path> <outdir>\n"
text MsgNotRun "BTWAVE NOT_RUN omc sha256 does not match pinned seed/out/omc\n"
text MsgFail "BTWAVE FAIL gate check failed at step "
text MsgPass "BTWAVE PASS mutants_killed=23/23 type_swaps_refused=4/4 trace_sha256=b0c6399a7ae894148e8e1678a272add68385bdf67d6221044ded82216fb73575\n"

text M01id "m01-guard-opcode"
text M01t "if and ne op 1 ne op 2"
text M01r "if false"

text M02id "m02-guard-epoch"
text M02t "if ne ulong reqe add get Lstate 0 1"
text M02r "if false"

text M03id "m03-guard-give-work"
text M03t "if or or eq worku 0 gt worku WMAX ne takeu 0"
text M03r "if false"

text M04id "m04-guard-h16-tie"
text M04t "decs = h16dec build_rx sym mode"
text M04r "decs = long sym"

text M05id "m05-guard-active-power"
text M05t "if ne t32pow jw 32"
text M05r "if false"

text M06id "m06-guard-scale-zero"
text M06t "if or eq sc 0 or lt sc neg VMAX gt sc VMAX"
text M06r "if false"

text M07id "m07-guard-sha256-rcpt"
text M07t "if not rcpt_eq expr rxr"
text M07r "if false"

text M08id "m08-guard-take-bounds"
text M08t "if or or eq takeu 0 gt takeu WMAX ne worku 0"
text M08r "if false"

text M09id "m09-guard-give-first"
text M09t "if not cred_pos curc"
text M09r "if false"

text M10id "m10-guard-reciprocity"
text M10t "ret le add open g open req open c"
text M10r "ret true"

text M11id "m11-guard-chain-anchor"
text M11t "anc = xor anc 1"
text M11r "anc = anc"

text M12id "m12-trit-neg-ident"
text M12t "ret rotr a 32"
text M12r "ret a"

text M13id "m13-trit-dot-sum"
text M13t "ret sub pp nn"
text M13r "ret add pp nn"

text M14id "m14-bt6-dark-bias"
text M14t "z = ulong add u 364"
text M14r "z = ulong add u 365"

text M15id "m15-hc3-14of16-drop"
text M15t "if or lt u -7 gt u 8"
text M15r "if or lt u -6 gt u 7"

text M16id "m16-h16-allow-4flip-tie"
text M16t "if and le bestd 3 eq ties 1"
text M16r "if le bestd 4"

text M17id "m17-mutate-before-verdict"
text M17t "curg = GrantJmk get Lstate 2"
text M17r "put Lstate 2 add get Lstate 2 takeu|curg = GrantJmk sub get Lstate 2 takeu"

text M18id "m18-trap-trit-overlap"
text M18t "n = or shr as 32 and as M32"
text M18r "n = or p shr as 32"

text M19id "m19-trap-wavedup-holds"
text M19t "ret WaveDupmk or shl u 32 u"
text M19r "ret WaveDupmk or shl u 32 xor u 1"

text M20id "m20-trap-bt6-requires"
text M20t "u = sub long idx 364"
text M20r "u = sub long idx 363"

text M21id "m21-vmax-ceiling-blowup"
text M21t "const VMAX long 65536"
text M21r "const VMAX long 9000000000000000000"

text M22id "m22-coordinated-selftest-blind"
text M22t "rm = rem add mul mulk i addk 3"
text M22r "rm = rem add mul mulk i add addk 1 3"

text M23id "m23-ipc-peer-wrong-job"
text M23t "decs = h16dec rxw"
text M23r "decs = xor h16dec rxw 1"
text Tipcref "IPC_REFUSED_65"

text X1id "x1-swap-credit-for-grant"
text X1t "if not recip_ok curc curg reqg"
text X1r "if not recip_ok curc curc reqg"

text X2id "x2-swap-grant-for-credit"
text X2t "if not recip_ok curc curg reqg"
text X2r "if not recip_ok curg curg reqg"

text X3id "x3-raw-ulong-as-trit32"
text X3t "decs = h16dec build_rx sym mode"
text X3r "decs = h16dec sym"

text X4id "x4-swap-grant-as-wavedup"
text X4t "if not wdup_chk wd uint and reqep 0xffff"
text X4r "if not wdup_chk curg uint and reqep 0xffff"

fn hex_nibble v uint to uchar
if lt v 10
ret uchar add 48 v
end
ret uchar add 87 v
end

fn read_src_byte kind ulong idx ulong to uchar
if eq kind 0
ret get Gfile idx
end
if eq kind 1
ret get Gexp idx
end
if eq kind 2
ret get Gsrc idx
end
ret get Gmut idx
end

fn sha256_gosha_kind kind ulong n ulong to void
s = new uint 8 0
w = new uint 64 0
kt = new uint 64 0
blk = new uchar 64 0
pad = new uchar 128 0
dg = new uchar 32 0
wsiv s
wskinit kt
nb = shr n 6
for b ulong nb
base = shl b 6
for j ulong 64 unroll
put blk j read_src_byte kind add base j
end
wscomp s w kt view blk 0
end
remb = and n 63
rbase = shl nb 6
for i ulong remb
put pad i read_src_byte kind add rbase i
end
wsfin s w kt pad n
wsout dg s
for i ulong 32 unroll
bv = uint get dg i
put Gosha mul i 2 hex_nibble and shr bv 4 15
put Gosha add mul i 2 1 hex_nibble and bv 15
end
end

fn save_bsha1 to void
for i ulong 64 unroll
put Gbsha1 i get Gbsha2 i
end
end

fn save_bsha2 to void
for i ulong 64 unroll
put Gbsha2 i get Gosha i
end
end

fn save_ssha to void
for i ulong 64 unroll
put Gssha i get Gosha i
end
end

fn save_msha to void
for i ulong 64 unroll
put Gmsha i get Gosha i
end
end

fn bsha_eq_1_2 to bool
for i ulong 64
if ne get Gbsha1 i get Gbsha2 i
ret false
end
end
ret true
end

fn msha_eq_ssha to bool
for i ulong 64
if ne get Gmsha i get Gssha i
ret false
end
end
ret true
end

fn gosha_eq_pin pin view uchar * to bool
if ne len pin 64
ret false
end
for i ulong 64
if ne get Gosha i get pin i
ret false
end
end
ret true
end

fn gfile_eq_gexp to bool
n = get Gfilelen 0
if ne n get Gexplen 0
ret false
end
for i ulong n
if ne get Gfile i get Gexp i
ret false
end
end
ret true
end

fn gfile_has_pref pref view uchar * to bool
n = get Gfilelen 0
np = len pref
if lt n np
ret false
end
for i ulong np
if ne get Gfile i get pref i
ret false
end
end
ret true
end

fn tsv_putc c uchar to void
p = get Gtsvlen 0
put Gtsv p c
put Gtsvlen 0 add p 1
end

fn tsv_txt s view uchar * to void
for i ulong len s
tsv_putc get s i
end
end

fn tsv_tab to void
tsv_putc 9
end

fn tsv_nl to void
tsv_putc 10
end

fn tsv_u64 v ulong to void
dg = new uchar 24 0
if eq v 0
tsv_putc 48
ret
end
k = ulong 0
x = v
while gt x 0 bound 24
put dg k uchar add 48 and rem x 10 0xff
x = div x 10
k = add k 1
end
for i ulong k
tsv_putc get dg sub sub k 1 i
end
end

fn tsv_hdr to void
tsv_txt Hc1
tsv_tab
tsv_txt Hc2
tsv_tab
tsv_txt Hc3
tsv_tab
tsv_txt Hc4
tsv_tab
tsv_txt Hc5
tsv_tab
tsv_txt Hc6
tsv_tab
tsv_txt Hc7
tsv_tab
tsv_txt Hc8
tsv_nl
end

note ssel: 0=Gssha, 1=Gmsha, 2=Gosha
fn tsv_head cid view uchar * bld view uchar * ssel ulong crc long to void
tsv_txt cid
tsv_tab
tsv_txt bld
tsv_tab
for i ulong 64
if eq ssel 0
tsv_putc get Gssha i
else
if eq ssel 1
tsv_putc get Gmsha i
else
tsv_putc get Gosha i
end
end
end
tsv_tab
tsv_u64 ulong crc
tsv_tab
end

note bsel: 0=dash, 1=Gbsha1, 2=Gbsha2; osel: 0=dash, 1=Gosha
fn tsv_tail bsel ulong rexit long osel ulong verd view uchar * to void
if eq bsel 0
tsv_txt Tdash
else
for i ulong 64
if eq bsel 1
tsv_putc get Gbsha1 i
else
tsv_putc get Gbsha2 i
end
end
end
tsv_tab
if lt rexit 0
tsv_txt Tdash
else
tsv_u64 ulong rexit
end
tsv_tab
if eq osel 0
tsv_txt Tdash
else
for i ulong 64
tsv_putc get Gosha i
end
end
tsv_tab
tsv_txt verd
tsv_nl
end

fn write_txt fd int s view uchar * to long
off = ulong 0
n = len s
while lt off n bound 65536
nw = write fd s off sub n off
if le nw 0
ret -1
end
off = add off ulong nw
end
ret 0
end

fn write_tin use_mut bool to long
fd = int fopen Gtin 0 get Gtinlen 0 577 420
if lt fd 0
ret -1
end
off = ulong 0
n = get Gsrclen 0
if use_mut
n = get Gmutlen 0
end
while lt off n bound 65536
nw = long 0
if use_mut
nw = write fd Gmut off sub n off
else
nw = write fd Gsrc off sub n off
end
if le nw 0
x0 = fclose fd
ret -2
end
off = add off ulong nw
end
x1 = fclose fd
ret 0
end

fn write_gpath_from_gfile plen ulong to long
fd = int fopen Gpath 0 plen 577 420
if lt fd 0
ret -1
end
off = ulong 0
n = get Gfilelen 0
while lt off n bound 65536
nw = write fd Gfile off sub n off
if le nw 0
x0 = fclose fd
ret -2
end
off = add off ulong nw
end
x1 = fclose fd
ret 0
end

fn write_gpath_from_gtsv plen ulong to long
fd = int fopen Gpath 0 plen 577 420
if lt fd 0
ret -1
end
off = ulong 0
n = get Gtsvlen 0
while lt off n bound 65536
nw = write fd Gtsv off sub n off
if le nw 0
x0 = fclose fd
ret -2
end
off = add off ulong nw
end
x1 = fclose fd
ret 0
end

fn read_fd_to_gfile fd int to long
off = ulong 0
go = true
while go bound 65536
if ge off 2097152
x0 = fclose fd
ret -2
end
nr = read fd Gfile off sub 2097152 off
if lt nr 0
x1 = fclose fd
ret -3
end
if eq nr 0
go = false
else
off = add off ulong nr
end
end
x2 = fclose fd
put Gfilelen 0 off
ret long off
end

note pkind: 0=Gomc, 1=Gtbin, 2=Gtout, 3=Gpath(plen)
fn read_kind_to_gfile pkind ulong plen ulong to long
fd = int -1
if eq pkind 0
fd = int fopen Gomc 0 get Gomclen 0 0 0
end
if eq pkind 1
fd = int fopen Gtbin 0 get Gtbinlen 0 0 0
end
if eq pkind 2
fd = int fopen Gtout 0 get Gtoutlen 0 0 0
end
if eq pkind 3
fd = int fopen Gpath 0 plen 0 0
end
if lt fd 0
ret -1
end
ret read_fd_to_gfile fd
end

fn append_src_file path view uchar * to long
fd = int fopen path 0 len path 0 0
if lt fd 0
ret -1
end
nr = read_fd_to_gfile fd
if lt nr 0
ret -2
end
cur = get Gsrclen 0
n = ulong nr
if gt add cur n 131072
ret -3
end
for i ulong n
put Gsrc add cur i get Gfile i
end
put Gsrclen 0 add cur n
ret 0
end

fn build_out_path sfx view uchar * to ulong
ol = get Goutlen 0
sl = len sfx
for i ulong ol
put Gpath i get Gout i
end
for i ulong sl
put Gpath add ol i get sfx i
end
ret add ol sl
end

fn append_dec dst edit uchar 128 pos ulong v ulong to ulong
dg = new uchar 24 0
if eq v 0
put dst pos 48
ret add pos 1
end
k = ulong 0
x = v
while gt x 0 bound 24
put dg k uchar add 48 and rem x 10 0xff
x = div x 10
k = add k 1
end
p = pos
for i ulong k
put dst p get dg sub sub k 1 i
p = add p 1
end
ret p
end

fn init_tmp_paths to void
tmp = new uchar 128 0
pid = ulong getpid
for i ulong len Stmpin
put tmp i get Stmpin i
end
l1 = append_dec tmp len Stmpin pid
for i ulong l1
put Gtin i get tmp i
end
put Gtinlen 0 l1
for i ulong len Stmpbin
put tmp i get Stmpbin i
end
l2 = append_dec tmp len Stmpbin pid
for i ulong l2
put Gtbin i get tmp i
end
put Gtbinlen 0 l2
for i ulong len Stmpout
put tmp i get Stmpout i
end
l3 = append_dec tmp len Stmpout pid
for i ulong l3
put Gtout i get tmp i
end
put Gtoutlen 0 l3
end

fn cleanup_tmp to void
x1 = unlink Gtin 0 get Gtinlen 0
x2 = unlink Gtbin 0 get Gtbinlen 0
x3 = unlink Gtout 0 get Gtoutlen 0
end

fn pkt_put_u16 pos ulong v ulong to ulong
put Gpkt pos uchar and v 0xff
put Gpkt add pos 1 uchar and shr v 8 0xff
ret add pos 2
end

fn pkt_add_gomc pos ulong to ulong
n = get Gomclen 0
p = pkt_put_u16 pos n
for i ulong n
put Gpkt add p i get Gomc i
end
ret add p n
end

fn pkt_add_gtbin pos ulong to ulong
n = get Gtbinlen 0
p = pkt_put_u16 pos n
for i ulong n
put Gpkt add p i get Gtbin i
end
ret add p n
end

fn pkt_add_txt pos ulong s view uchar * to ulong
n = len s
p = pkt_put_u16 pos n
for i ulong n
put Gpkt add p i get s i
end
ret add p n
end

fn child_exec inkind ulong outkind ulong pktlen ulong to void
fdi = int -1
if eq inkind 1
fdi = int fopen Gtin 0 get Gtinlen 0 0 0
else
fdi = int fopen Sdevnull 0 len Sdevnull 0 0
end
if lt fdi 0
exit 125
end
fdo = int -1
if eq outkind 0
fdo = int fopen Gtbin 0 get Gtbinlen 0 577 493
else
fdo = int fopen Gtout 0 get Gtoutlen 0 577 420
end
if lt fdo 0
exit 126
end
fde = int fopen Sdevnull 0 len Sdevnull 1 0
if lt fde 0
exit 127
end
if ne fdi 0
d0 = dupfd fdi 0 0
end
if ne fdo 1
d1 = dupfd fdo 1 0
end
if ne fde 2
d2 = dupfd fde 2 0
end
r = execprog Gpkt 0 pktlen
exit 124
end

fn spawn_pkt inkind ulong outkind ulong pktlen ulong to long
wst = new uchar 4 0
pid = fork
if lt pid 0
ret -1
end
if eq pid 0
child_exec inkind outkind pktlen
end
wp = waitpid int pid wst 0 4 0
if lt wp 0
ret -2
end
st = rd32le view wst 0
if eq and st 0x7f 0
ret long and shr st 8 0xff
end
ret long add 128 and st 0x7f
end

fn compile_cur use_mut bool to long
if lt write_tin use_mut 0
ret -1
end
x0 = unlink Gtbin 0 get Gtbinlen 0
p = pkt_put_u16 0 1
plen = pkt_add_gomc p
rc = spawn_pkt 1 0 plen
if eq rc 0
fd = int fopen Gtbin 0 get Gtbinlen 0 0 0
if lt fd 0
ret -2
end
x1 = fchmod fd 493
x2 = fclose fd
nr = read_kind_to_gfile 1 0
if le nr 0
ret -3
end
sha256_gosha_kind 0 ulong nr
save_bsha2
end
ret rc
end

fn run_bin0 to long
p = pkt_put_u16 0 1
plen = pkt_add_gtbin p
rc = spawn_pkt 0 1 plen
nr = read_kind_to_gfile 2 0
if lt nr 0
ret -1
end
sha256_gosha_kind 0 ulong nr
ret rc
end

fn run_bin1 arg1 view uchar * to long
p = pkt_put_u16 0 2
p = pkt_add_gtbin p
plen = pkt_add_txt p arg1
rc = spawn_pkt 0 1 plen
nr = read_kind_to_gfile 2 0
if lt nr 0
ret -1
end
sha256_gosha_kind 0 ulong nr
ret rc
end

fn run_bin2 arg1 view uchar * arg2 view uchar * to long
p = pkt_put_u16 0 3
p = pkt_add_gtbin p
p = pkt_add_txt p arg1
plen = pkt_add_txt p arg2
rc = spawn_pkt 0 1 plen
nr = read_kind_to_gfile 2 0
if lt nr 0
ret -1
end
sha256_gosha_kind 0 ulong nr
ret rc
end

fn match_at pos ulong slen ulong tgt view uchar * tlen ulong to bool
if gt add pos tlen slen
ret false
end
for j ulong tlen
if ne get Gsrc add pos j get tgt j
ret false
end
end
ret true
end

fn emit_rep pos ulong rep view uchar * to ulong
o = pos
for k ulong len rep
ch = get rep k
if eq ch 124
put Gmut o 10
else
put Gmut o ch
end
o = add o 1
end
ret o
end

fn patch_src tgt view uchar * rep view uchar * to long
slen = get Gsrclen 0
tlen = len tgt
i = ulong 0
o = ulong 0
hits = long 0
while lt i slen bound 131072
if and eq hits 0 match_at i slen tgt tlen
o = emit_rep o rep
i = add i tlen
hits = add hits 1
else
put Gmut o get Gsrc i
o = add o 1
i = add i 1
end
end
put Gmutlen 0 o
ret hits
end

fn print_err_step step ulong to int
dg = new uchar 24 0
x0 = write_txt 2 MsgFail
k = ulong 0
v = step
while gt v 0 bound 24
put dg k uchar add 48 and rem v 10 0xff
v = div v 10
k = add k 1
end
for i ulong k
put Gpath i get dg sub sub k 1 i
end
put Gpath k 10
x1 = write 2 Gpath 0 add k 1
cleanup_tmp
ret 1
end

fn check_orig_3x to int
for r ulong 3
crc = compile_cur false
if ne crc 0
ret 10
end
if eq r 0
save_bsha1
else
if not bsha_eq_1_2
ret 11
end
end
rc1 = run_bin1 Tself
if or ne rc1 0 not gosha_eq_pin PinEmpty
ret 12
end
tsv_head Torig Tself 0 0
tsv_tail 1 0 1 Tpass
rc2 = run_bin1 Ttrace
if or ne rc2 0 not gosha_eq_pin PinTrace
ret 13
end
if not gfile_eq_gexp
ret 14
end
tsv_head Torig Ttrace 0 0
tsv_tail 1 0 1 Tpass
end
ret 0
end

fn check_ipc_and_controls to int
rci = run_bin1 Tipc
if or ne rci 0 not gfile_has_pref SipcPref
ret 20
end
ipcl = build_out_path Sipcf
if lt write_gpath_from_gfile ipcl 0
ret 21
end
tsv_head Torig Tipc 0 0
tsv_tail 1 0 0 Tpass
ep = build_out_path Sexpf
nr = read_kind_to_gfile 3 ep
if le nr 0
ret 22
end
put Gfile 0 uchar xor uint get Gfile 0 1
sha256_gosha_kind 0 ulong nr
if or gfile_eq_gexp gosha_eq_pin PinTrace
ret 23
end
tsv_head Tccor Ttrace 2 0
tsv_tail 0 -1 1 Tpass
rcn = run_bin0
if or ne rcn 2 not gosha_eq_pin PinEmpty
ret 24
end
tsv_head Tcanone Tusage 0 0
tsv_tail 1 rcn 1 Tpass
rcb = run_bin1 Tbadarg
if or ne rcb 2 not gosha_eq_pin PinEmpty
ret 25
end
tsv_head Tcabad Tusage 0 0
tsv_tail 1 rcb 1 Tpass
rct = run_bin2 Ttrace Textra
if or ne rct 2 not gosha_eq_pin PinEmpty
ret 26
end
tsv_head Tcatwo Tusage 0 0
tsv_tail 1 rct 1 Tpass
ret 0
end

fn check_trap_probes to int
r1 = run_bin1 Ttrapt
if ne r1 110
ret 30
end
tsv_head Tptrit Ttrapt 0 0
tsv_tail 1 r1 1 Ttrap10
r2 = run_bin1 Ttrapd
if ne r2 110
ret 31
end
tsv_head Tpdup Ttrapd 0 0
tsv_tail 1 r2 1 Ttrap10
r3 = run_bin1 Ttrapr
if ne r3 109
ret 32
end
tsv_head Tpreq Ttrapr 0 0
tsv_tail 1 r3 1 Ttrap9
r4 = run_bin1 Tovfp
if ne r4 0
ret 33
end
tsv_head Tpovf Tovfp 0 0
tsv_tail 1 r4 1 Tpass
ret 0
end

fn prep_mutant tgt view uchar * rep view uchar * to int
if ne patch_src tgt rep 1
ret 1
end
sha256_gosha_kind 3 get Gmutlen 0
save_msha
if msha_eq_ssha
ret 2
end
ret 0
end

fn exec_mutant mid view uchar * mode ulong ovfchk bool to int
crc = compile_cur true
if ne crc 0
ret 3
end
rcs = run_bin1 Tself
if eq mode 0
if eq rcs 0
ret 4
end
tsv_head mid Tself 1 0
tsv_tail 2 rcs 1 Tscaught
end
if eq mode 1
if ne rcs 110
ret 5
end
tsv_head mid Tself 1 0
tsv_tail 2 rcs 1 Ttrap10
end
if eq mode 2
if ne rcs 109
ret 6
end
tsv_head mid Tself 1 0
tsv_tail 2 rcs 1 Ttrap9
end
if eq mode 3
if ne rcs 0
ret 7
end
tsv_head mid Tself 1 0
tsv_tail 2 rcs 1 Tsmiss
end
rct = run_bin1 Ttrace
if and eq rct 0 gosha_eq_pin PinTrace
ret 8
end
tsv_head mid Ttrace 1 0
if eq rct 110
tsv_tail 2 rct 1 Ttrap10
else
if eq rct 109
tsv_tail 2 rct 1 Ttrap9
else
tsv_tail 2 rct 1 Tokilled
end
end
if ovfchk
rco = run_bin1 Tovfp
if ne rco 101
ret 9
end
tsv_head mid Tovfb 1 0
tsv_tail 2 rco 1 Ttrap1
end
ret 0
end

fn exec_type_swap xid view uchar * to int
crc = compile_cur true
if ne crc 7
ret 2
end
tsv_head xid Tcomp 1 crc
tsv_tail 0 -1 0 Tcref7
ret 0
end

note IPC mutant: node B decodes and returns a different job wave with a self-consistent
note receipt. Killed only when the host refuses it (btwave ipc exit 65, no stdout).
fn exec_ipc_mutant mid view uchar * to int
crc = compile_cur true
if ne crc 0
ret 3
end
rci = run_bin1 Tipc
if or ne rci 65 not gosha_eq_pin PinEmpty
ret 10
end
tsv_head mid Tipc 1 0
tsv_tail 2 rci 1 Tipcref
ret 0
end

fn run_all_mutants_a to int
if or ne prep_mutant M01t M01r 0 ne exec_mutant M01id 0 false 0
ret 101
end
if or ne prep_mutant M02t M02r 0 ne exec_mutant M02id 0 false 0
ret 102
end
if or ne prep_mutant M03t M03r 0 ne exec_mutant M03id 0 false 0
ret 103
end
if or ne prep_mutant M04t M04r 0 ne exec_mutant M04id 0 false 0
ret 104
end
if or ne prep_mutant M05t M05r 0 ne exec_mutant M05id 0 false 0
ret 105
end
if or ne prep_mutant M06t M06r 0 ne exec_mutant M06id 0 false 0
ret 106
end
if or ne prep_mutant M07t M07r 0 ne exec_mutant M07id 0 false 0
ret 107
end
if or ne prep_mutant M08t M08r 0 ne exec_mutant M08id 0 false 0
ret 108
end
if or ne prep_mutant M09t M09r 0 ne exec_mutant M09id 0 false 0
ret 109
end
if or ne prep_mutant M10t M10r 0 ne exec_mutant M10id 0 false 0
ret 110
end
if or ne prep_mutant M11t M11r 0 ne exec_mutant M11id 0 false 0
ret 111
end
ret 0
end

fn run_all_mutants_b to int
if or ne prep_mutant M12t M12r 0 ne exec_mutant M12id 0 false 0
ret 112
end
if or ne prep_mutant M13t M13r 0 ne exec_mutant M13id 0 false 0
ret 113
end
if or ne prep_mutant M14t M14r 0 ne exec_mutant M14id 0 false 0
ret 114
end
if or ne prep_mutant M15t M15r 0 ne exec_mutant M15id 0 false 0
ret 115
end
if or ne prep_mutant M16t M16r 0 ne exec_mutant M16id 0 false 0
ret 116
end
if or ne prep_mutant M17t M17r 0 ne exec_mutant M17id 0 false 0
ret 117
end
if or ne prep_mutant M18t M18r 0 ne exec_mutant M18id 1 false 0
ret 118
end
if or ne prep_mutant M19t M19r 0 ne exec_mutant M19id 1 false 0
ret 119
end
if or ne prep_mutant M20t M20r 0 ne exec_mutant M20id 2 false 0
ret 120
end
if or ne prep_mutant M21t M21r 0 ne exec_mutant M21id 0 true 0
ret 121
end
if or ne prep_mutant M22t M22r 0 ne exec_mutant M22id 3 false 0
ret 122
end
if or ne prep_mutant M23t M23r 0 ne exec_ipc_mutant M23id 0
ret 123
end
ret 0
end

fn run_all_swaps to int
if or ne prep_mutant X1t X1r 0 ne exec_type_swap X1id 0
ret 201
end
if or ne prep_mutant X2t X2r 0 ne exec_type_swap X2id 0
ret 202
end
if or ne prep_mutant X3t X3r 0 ne exec_type_swap X3id 0
ret 203
end
if or ne prep_mutant X4t X4r 0 ne exec_type_swap X4id 0
ret 204
end
ret 0
end

fn load_inputs to int
nr = read_kind_to_gfile 0 0
if le nr 0
ret 77
end
sha256_gosha_kind 0 ulong nr
if not gosha_eq_pin PinOmc
ret 77
end
ep = build_out_path Sexpf
en = read_kind_to_gfile 3 ep
if or le en 0 gt en 65536
ret 3
end
for i ulong ulong en
put Gexp i get Gfile i
end
put Gexplen 0 ulong en
sha256_gosha_kind 1 get Gexplen 0
if not gosha_eq_pin PinTrace
ret 4
end
put Gsrclen 0 0
if lt append_src_file Sf1 0
ret 5
end
if lt append_src_file Sf2 0
ret 6
end
if lt append_src_file Sf3 0
ret 7
end
if lt append_src_file Sf4 0
ret 8
end
sha256_gosha_kind 2 get Gsrclen 0
save_ssha
ret 0
end

fn main to int
if ne argcnt 3
x0 = write_txt 2 MsgUsage
ret 2
end
l1 = argread 1 Gomc 0 512
l2 = argread 2 Gout 0 512
if or le l1 0 le l2 0
x1 = write_txt 2 MsgUsage
ret 2
end
put Gomclen 0 ulong l1
put Goutlen 0 ulong l2
init_tmp_paths
lrc = load_inputs
if eq lrc 77
x2 = write_txt 2 MsgNotRun
cleanup_tmp
ret 77
end
if ne lrc 0
ret print_err_step ulong lrc
end
put Gtsvlen 0 0
tsv_hdr
rc = check_orig_3x
if ne rc 0
ret print_err_step ulong rc
end
rc = check_ipc_and_controls
if ne rc 0
ret print_err_step ulong rc
end
rc = check_trap_probes
if ne rc 0
ret print_err_step ulong rc
end
rc = run_all_mutants_a
if ne rc 0
ret print_err_step ulong rc
end
rc = run_all_mutants_b
if ne rc 0
ret print_err_step ulong rc
end
rc = run_all_swaps
if ne rc 0
ret print_err_step ulong rc
end
cleanup_tmp
rp = build_out_path Srecf
if lt write_gpath_from_gtsv rp 0
ret print_err_step 250
end
x3 = write_txt 1 MsgPass
ret 0
end

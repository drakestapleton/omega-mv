note SPDX-License-Identifier: AGPL-3.0-only
note BTWAVE-P0: Main Driver, Self-Test, Deterministic Trace, and CLI (native/btwave/main.om).

global Obuf uchar 65536
global Olen ulong 2

text Tbt6 "BT6 "
text Tbtall "BT6_ALL 729 "
text Tswar "SWAR32 "
text Thc3 "HC3 "
text Th16 "H16 "
text Tsha "SHA "
text Tldg "LDG "
text Tend "END "
text Tipc1 "IPC PASS coreA="
text Tipc2 " coreB="
text Tipc3 " rounds="
text Tipc4 " contrib="
text Tipc5 " extract="
text Tipc6 " odraft_refused="
text Tipc7 " elapsed_ns="
text Ctrace "trace"
text Cself "selftest"
text Cipc "ipc"
text Ctrapt "trap-trit"
text Ctrapd "trap-dup"
text Ctrapr "trap-req"
text Covf "ovf-probe"

fn oflush to void
n = get Olen 0
if gt n 0
x = write 1 Obuf 0 n
put Olen 0 0
end
end

fn oputc ch uchar to void
n = get Olen 0
if ge n 65500
oflush
n = 0
end
put Obuf n ch
put Olen 0 add n 1
end

fn ostr s view uchar * to void
for i ulong len s
oputc get s i
end
end

fn osp to void
oputc 32
end

fn onl to void
oputc 10
end

fn ou64 v ulong to void
dg = new uchar 24 0
if eq v 0
oputc 48
ret
end
k = ulong 0
x = v
while gt x 0 bound 24
put dg k uchar add 48 and rem x 10 0xff
x = div x 10
k = add k 1
end
for i ulong k
oputc get dg sub sub k 1 i
end
end

fn oi64 v long to void
if ge v 0
ou64 ulong v
ret
end
oputc 45
vp = neg add v 1
ou64 add ulong vp 1
end

fn eq_txt a view uchar * n ulong b view uchar * to bool
if ne n len b
ret false
end
for i ulong n
if ne get a i get b i
ret false
end
end
ret true
end

fn emit_bt6_one u long to void
w = bt6enc u
wa = open w
ostr Tbt6
oi64 u
osp
ou64 shr wa 32
osp
ou64 and wa M32
osp
oi64 bt6dec w
osp
oi64 bt6dec t32neg w
osp
oi64 t32pow w
onl
end

fn calc_bt6_stats st edit long 4 to void
bij = long 0
nsym = long 0
zcnt = long 0
tpow = long 0
for idx ulong 729
u = sub long idx 364
w = bt6enc u
if eq bt6dec w u
bij = add bij 1
end
if eq open bt6enc neg u open t32neg w
nsym = add nsym 1
end
pw = t32pow w
if eq pw 0
zcnt = add zcnt 1
end
tpow = add tpow pw
end
put st 0 bij
put st 1 nsym
put st 2 zcnt
put st 3 tpow
end

fn build_swar_vec mulk ulong addk ulong to Trit32
p = ulong 0
n = ulong 0
for i ulong 32
rm = rem add mul mulk i addk 3
ib = shl ulong 1 i
if eq rm 2
p = or p ib
else
if eq rm 0
n = or n ib
end
end
end
ret Trit32mk or shl p 32 n
end

fn emit_swar to long
wa = build_swar_vec 1 0
wb = build_swar_vec 2 1
ra = open wa
rb = open wb
dab = t32dot wa wb
daa = t32dot wa wa
dbb = t32dot wb wb
pab = t32pow t32mul wa wb
ostr Tswar
ou64 shr ra 32
osp
ou64 and ra M32
osp
ou64 shr rb 32
osp
ou64 and rb M32
osp
oi64 dab
osp
oi64 daa
osp
oi64 dbb
osp
oi64 pab
onl
if or ne dab 10 or ne daa 21 or ne dbb 21 ne pab 10
ret 1
end
ret 0
end

fn calc_hc3_ok to long
ok = long 0
for m ulong 16
if eq hc3dec hc3enc m m
ok = add ok 1
end
end
ret ok
end

fn emit_hc3 to long
ok = calc_hc3_ok
cf = open hc3enc 0
cz = open hc3enc 7
cl = open hc3enc 15
oob = hc3dec Trit32mk 7
ostr Thc3
oi64 ok
osp
ou64 shr cf 32
osp
ou64 and cf M32
osp
ou64 shr cz 32
osp
ou64 and cz M32
osp
ou64 shr cl 32
osp
ou64 and cl M32
osp
ou64 oob
onl
if or ne ok 16 ne oob 99
ret 1
end
ret 0
end

fn h16_ok01 st edit long 5 to void
ok0 = long 0
ok1 = long 0
for s ulong 32
w = h16enc s
if eq h16dec w long s
ok0 = add ok0 1
end
for c ulong 16
if eq h16dec t32flip w c long s
ok1 = add ok1 1
end
end
end
put st 0 ok0
put st 1 ok1
end

fn h16_ok2 st edit long 5 to void
ok2 = long 0
w5 = h16enc 5
w21 = h16enc 21
for c1 ulong 16
for c2 ulong 16
if lt c1 c2
if eq h16dec t32flip t32flip w5 c1 c2 5
ok2 = add ok2 1
end
if eq h16dec t32flip t32flip w21 c1 c2 21
ok2 = add ok2 1
end
if eq h16dec t32eras t32eras w5 c1 c2 5
ok2 = add ok2 1
end
end
end
end
put st 2 ok2
end

fn h16_ok3 st edit long 5 to void
ok3 = long 0
w13 = h16enc 13
for c1 ulong 16
for c2 ulong 16
if lt c1 c2
for c3 ulong 16
if lt c2 c3
if eq h16dec t32flip t32flip t32flip w13 c1 c2 c3 13
ok3 = add ok3 1
end
if eq h16dec t32eras t32eras t32eras w13 c1 c2 c3 13
ok3 = add ok3 1
end
end
end
end
end
end
put st 3 ok3
end

fn h16_ref4 st edit long 5 to void
rf = long 0
w0 = h16enc 0
for a ulong 8
for b ulong 8
if lt a b
for c ulong 8
if lt b c
for d ulong 8
if lt c d
rx = t32flip t32flip w0 add mul 2 a 1 add mul 2 b 1
rx = t32flip t32flip rx add mul 2 c 1 add mul 2 d 1
if eq h16dec rx -1
rf = add rf 1
end
end
end
end
end
end
end
end
put st 4 rf
end

fn sha_abc_hi64 to ulong
m = new uchar 3 0
dg = new uchar 32 0
put m 0 97
put m 1 98
put m 2 99
sha256_slice view m dg
ret rd64be view dg 0
end

fn run_ldg_suite emit bool to int
ev = new long 7 0
ldg_reset
init_cases
bad = int 0
for cid ulong 16
o = mul cid 7
for j ulong 7 unroll
put ev j get Lcases add o j
end
st = ldg_step ev
if ne st get Lexp cid
bad = 1
end
if gt get Lstate 2 get Lstate 1
bad = 2
end
if emit
ostr Tldg
ou64 cid
osp
oi64 st
osp
oi64 get Lresp 0
osp
ou64 get Lstate 0
osp
ou64 get Lstate 1
osp
ou64 get Lstate 2
osp
ou64 ldg_chid
onl
end
end
if emit
ostr Tend
ou64 get Lstate 3
osp
ou64 get Lstate 4
osp
ou64 get Lstate 5
osp
ou64 get Lstate 1
osp
ou64 get Lstate 2
onl
end
if or ne get Lstate 1 90 ne get Lstate 2 90
bad = 3
end
ret bad
end

fn cmd_trace to int
bs = new long 4 0
hs = new long 5 0
emit_bt6_one -364
emit_bt6_one -243
emit_bt6_one -40
emit_bt6_one -1
emit_bt6_one 0
emit_bt6_one 1
emit_bt6_one 40
emit_bt6_one 243
emit_bt6_one 364
calc_bt6_stats bs
ostr Tbtall
oi64 get bs 0
osp
oi64 get bs 1
osp
oi64 get bs 2
osp
oi64 get bs 3
onl
rc1 = emit_swar
rc2 = emit_hc3
h16_ok01 hs
h16_ok2 hs
h16_ok3 hs
h16_ref4 hs
ostr Th16
oi64 get hs 0
osp
oi64 get hs 1
osp
oi64 get hs 2
osp
oi64 get hs 3
osp
oi64 get hs 4
onl
ostr Tsha
ou64 sha_abc_hi64
onl
rc3 = run_ldg_suite true
oflush
ret int add add rc1 rc2 long rc3
end

fn cmd_selftest to int
bs = new long 4 0
hs = new long 5 0
calc_bt6_stats bs
if or ne get bs 0 729 or ne get bs 1 729 or ne get bs 2 1 ne get bs 3 2916
ret 10
end
if ne bt6tor 364 1 -364
ret 11
end
if ne calc_hc3_ok 16
ret 12
end
if ne hc3dec Trit32mk 7 99
ret 13
end
h16_ok01 hs
h16_ok2 hs
h16_ok3 hs
h16_ref4 hs
if or ne get hs 0 32 or ne get hs 1 512 or ne get hs 2 360 or ne get hs 3 1120 ne get hs 4 70
ret 14
end
if ne sha_abc_hi64 13436514500253700074
ret 15
end
if ne t32dot h16enc 0 h16enc 16 -16
ret 16
end
rc = run_ldg_suite false
if ne rc 0
ret add 20 rc
end
ret 0
end

fn cmd_ipc to int
rc = ipc_run
if ne rc 0
ret rc
end
ostr Tipc1
oi64 get IpcOut 0
ostr Tipc2
oi64 get IpcOut 1
ostr Tipc3
oi64 get IpcOut 2
ostr Tipc4
oi64 get IpcOut 3
ostr Tipc5
oi64 get IpcOut 4
ostr Tipc6
oi64 get IpcOut 5
ostr Tipc7
oi64 get IpcOut 6
onl
oflush
ret 0
end

fn cmd_ovf_probe to int
ev = new long 7 0
ldg_reset
put ev 0 1
put ev 1 1
put ev 2 10
put ev 3 0
put ev 4 4611686018427387904
put ev 5 0
put ev 6 0
st = ldg_step ev
if ne st -6
ret 41
end
ret 0
end

fn main to int
abuf = new uchar 64 0
ac = argcnt
if ne ac 2
ret 2
end
al = argread 1 abuf 0 64
if lt al 0
ret 2
end
nl = ulong al
if eq_txt view abuf nl Ctrace
ret cmd_trace
end
if eq_txt view abuf nl Cself
ret cmd_selftest
end
if eq_txt view abuf nl Cipc
ret cmd_ipc
end
if eq_txt view abuf nl Ctrapt
badt = Trit32mk 0x0000000100000001
ret int and open badt 1
end
if eq_txt view abuf nl Ctrapd
badd = WaveDupmk 0x0000000100000002
ret int and open badd 1
end
if eq_txt view abuf nl Ctrapr
badr = bt6enc 365
ret int and open badr 1
end
if eq_txt view abuf nl Covf
ret cmd_ovf_probe
end
ret 2
end

end
fn vgeof fd int to bool
st = new uchar 128 0
p = fseek fd 0 1
r = fstat fd st 0 128
if or lt p 0 ne r 0
vxfail 71
end
n = ulong 0
for i ulong 8
v = ulong get st add i 48
n = or n shl v mul i 8
end
ret eq ulong p n
end
fn vgkill m ulong expected ulong suffix view uchar * to void

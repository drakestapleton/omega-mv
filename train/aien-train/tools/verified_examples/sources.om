note SPDX-License-Identifier: AGPL-3.0-or-later
note Composed after examples.om with its main renamed to vxmodelmain by the gate/build command.
text vsprep "prep"
text vstaskdir "/tasks/"
text vsrefs "references"
text vsharness "harness"
text vstask "task"
text vsref "/reference."
text vsstmt "/statement.txt"
text vsslash "/"
text vssource ",\"source\":"
text vstaskkey "{\"task\":"
text vsprogram ",\"program\":"
text vscontract ",\"referee_contract\":"
text vscompiler ",\"omc_sha256\":"
text vsdigest ",\"task_set_sha256\":"
text vsreceipt ",\"referee_output_sha256\":"
text vsend "}\n"
text vsarchive "archive"
text vsformat "--format=tar"
text vshead "HEAD"
text vsgit "/usr/bin/git"
text vsc "-C"
text vsdiff "diff"
text vsquiet "--quiet"
text vsgate "/examples/gate.sh"
text vsbash "/usr/bin/bash"
text vstar "/harness.tar"
text vsreceiptfile "/harness-receipt.txt"
text vsreceiptbad "/harness-receipt.err"
text vsexpect ".expect"
text vssuffix ".om"
text vspass "PASS"
text vsexit "(exit"
text vslicence ",\"licence_position\":"
text vsreflic "reference source retains its original licence; verification is not a relicensing grant"
global vscompilerhash uchar 64
global vstaskhash uchar 64
fn vscapturehash k ulong which ulong to void
h = new uchar 64 0
vxhash k h
for i ulong 64
if eq which 0
put vscompilerhash i get h i
else
put vstaskhash i get h i
end
end
end
fn vswritehash which ulong to void
h = new uchar 64 0
for i ulong 64
if eq which 0
put h i get vscompilerhash i
else
put h i get vstaskhash i
end
end
vxquote h
end
fn vssetup to void
for i ulong 5
vxarg add i 1 i
end
vxenvinit
r = makedir vxp mul ulong 4 4096 get vxplen 4 448
if ne r 0
vxfail 3
end
vxcopy 5 1
vxadd 5 vxdriver
vxcopy 14 4
vxadd 14 vxt56
vxcopy 15 4
vxadd 15 vxt57
fd = vxopen 14 193
put vxion 1 ulong fd
vscapturehash 2 0
end
fn vsrecord name view uchar * rh view uchar 64 to void
b = new uchar 8 0
vxout vstaskkey
vxquote name
vxout vssource
if eq get vxcounts 10 1
vxquote vxrefsource
else
vxquote vxharsource
end
vxout vscontract
vxqfile 12
vxout vsprogram
vxqfile 10
vxout vscompiler
vswritehash 0
vxout vsdigest
vswritehash 1
vxout vsreceipt
vxquote rh
vxout vxt23
if eq get vxcounts 10 1
for i ulong get vxcounts 7
put b i get vxp add mul ulong 11 4096 i
end
vxquote part b 0 get vxcounts 7
else
vxquote vxt39
end
vxout vxt26
vxout vxarrnone
vxout vsend
end
fn vsrefone lang view uchar * task view uchar 16 idx ulong to void
h = new uchar 64 0
l = new uchar 8 0
for i ulong len lang
put l i get lang i
end
put vxcounts 7 len lang
vxset 11 lang
vxcopy 10 1
vxadd 10 vstaskdir
vxadd 10 part task 0 6
vxadd 10 vsref
vxadd 10 lang
vxcopy 12 1
vxadd 12 vstaskdir
vxadd 12 part task 0 6
vxadd 12 vsstmt
vxcopy 13 4
vxadd 13 vxt46
vxdecimal 13 get vxcounts 9
put vxcounts 9 add get vxcounts 9 1
r = vxreferee l task
if ne r 0
vxfail 17
end
vxcopy 6 13
vxadd 6 vxevalout
vxhash 6 h
vsrecord part task 0 6 h
put vxcounts idx add get vxcounts idx 1
put vxcounts 4 add get vxcounts 4 1
end
fn vsreferences to void
b = new uchar 16 0
h = new uchar 64 0
vxchecktasks
vxhash 2 h
if not vxequal h vxsha
vxfail 10
end
for i ulong 64
put vstaskhash i get vxtasks i
end
put vxcounts 10 1
for n ulong 20
for i ulong 4
put b i get vstask i
end
v = add n 1
put b 4 uchar add div v 10 48
put b 5 uchar add rem v 10 48
vsrefone vxt39 b 0
vsrefone vxt36 b 1
vsrefone vxt37 b 2
vsrefone vxt38 b 3
end
end
fn vsgitcmd cmd view uchar * tail view uchar * to ulong
vxset 6 vxnull
vxcopy 7 4
vxadd 7 vstar
vxcopy 8 4
vxadd 8 vsreceiptbad
vxpkinit
vxpk vsgit
vxpk vsc
vxpkpath 1
vxpk cmd
vxpk tail
vxpk vshead
ret vxspawn
end
fn vsharone line view uchar * to void
name = new uchar 4096 0
h = new uchar 64 0
n = vxword line 1 name
if lt n 4
vxfail 2
end
vxcopy 10 1
vxadd 10 vsslash
vxadd 10 part name 0 n
vxadd 10 vssuffix
vxcopy 12 1
vxadd 12 vsslash
vxadd 12 part name 0 n
vxadd 12 vsexpect
vxcopy 6 4
vxadd 6 vsreceiptfile
vxhash 6 h
vsrecord part name 0 n h
put vxcounts 0 add get vxcounts 0 1
put vxcounts 4 add get vxcounts 4 1
end
fn vsharvest to void
b = new uchar 4096 0
a = new uchar 4096 0
put vxcounts 10 2
r = vsgitcmd vsdiff vsquiet
if ne r 0
vxfail 18
end
r = vsgitcmd vsarchive vsformat
if ne r 0
vxfail 18
end
vxcopy 6 4
vxadd 6 vstar
vscapturehash 6 1
vxset 6 vxnull
vxcopy 7 4
vxadd 7 vsreceiptfile
vxcopy 8 4
vxadd 8 vsreceiptbad
vxcopy 5 1
vxadd 5 vsgate
vxpkinit
vxpk vsbash
vxpkpath 5
vxpkpath 2
r = vxspawn
if ne r 0
vxfail 19
end
fd = vxopen 7 0
while true bound 9223372036854775807
n = vxline fd b
if eq n 0
break
end
z = vxword part b 0 n 0 a
if vxequal part a 0 z vspass
z = vxword part b 0 n 2 a
if vxequal part a 0 z vsexit
vsharone part b 0 n
end
end
end
vxclose fd
end
fn vsmanifest to void
h = new uchar 64 0
vxflush
vxclose int get vxion 1
vxhash 14 h
fd = vxopen 15 193
put vxion 1 ulong fd
vxout vxt48
vxoutnum get vxcounts 4
vxout vxt49
vxoutnum get vxcounts 0
vxout vxt50
vxoutnum get vxcounts 1
vxout vxt51
vxoutnum get vxcounts 2
vxout vxt52
vxoutnum get vxcounts 3
vxout vxt53
vxoutnum get vxcounts 5
vxout vxt54
vxquote h
vxout vscompiler
vswritehash 0
vxout vsdigest
vswritehash 1
vxout vssource
if eq get vxcounts 10 1
vxquote vxrefsource
else
vxquote vxharsource
end
vxout vslicence
vxquote vsreflic
vxout vsend
vxflush
vxclose fd
end
fn main to int
b = new uchar 4096 0
if lt argcnt 7
vxfail 2
end
n = argread 1 b 0 len b
if lt n 0
vxfail 2
end
if vxequal part b 0 ulong n vsprep
put vxshift 0 1
ret vxmodelmain
end
if vxequal part b 0 ulong n vsrefs
vssetup
vsreferences
vsmanifest
ret 0
end
if vxequal part b 0 ulong n vsharness
vssetup
vsharvest
vsmanifest
ret 0
end
ret vxmodelmain
end

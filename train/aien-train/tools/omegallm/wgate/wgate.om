note gate names by index
fn wggname g ulong to void
if eq g 0
wgat wgtg0
end
if eq g 1
wgat wggn1
end
if eq g 2
wgat wggn2
end
if eq g 3
wgat wggn3
end
if eq g 4
wgat wggn4
end
if eq g 5
wgat wggn5
end
if eq g 6
wgat wgtg6
end
end

note two decimal digits of v onto the arena
fn wga2 v long to void
wgac add 48 ulong div v 10
wgac add 48 ulong rem v 10
end

note days since 1970-01-01 to civil y, m, d in wgtm 0..2 (proleptic Gregorian)
fn wgcivil days long to void
z = add days 719468
era = div z 146097
doe = sub z mul era 146097
yoe = div sub add sub doe div doe 1460 div doe 36524 div doe 146096 365
y = add yoe mul era 400
doy = sub doe sub add mul 365 yoe div yoe 4 div yoe 100
mp = div add mul 5 doy 2 153
d = add sub doy div add mul 153 mp 2 5 1
m = add mp 3
if ge mp 10
m = sub mp 9
end
if le m 2
y = add y 1
end
put wgtm 0 y
put wgtm 1 m
put wgtm 2 d
end

note UTC now as YYYY-MM-DDTHH:MM:SSZ onto the arena
fn wgutc to void
s = div realns 1000000000
r = rem s 86400
wgcivil div s 86400
wgadl get wgtm 0
wgac 45
wga2 get wgtm 1
wgac 45
wga2 get wgtm 2
wgac 84
wga2 div r 3600
wgac 58
wga2 div rem r 3600 60
wgac 58
wga2 rem r 60
wgac 90
end

note wdd as lowercase hex onto the arena
fn wgahex to void
for i ulong 32
b = ulong get wdd i
h = shr b 4
l = and b 15
if lt h 10
wgac add 48 h
else
wgac add 87 h
end
if lt l 10
wgac add 48 l
else
wgac add 87 l
end
end
end

note append arena [o, top) to OUT/gates.txt and drop it from the arena
fn wgstapp o ulong to void
wdpclr
wgpsl SOUT
wdpt wgtgst
fd = wgcreat true
wgwr fd o sub get wgan 0 o
c = fclose fd
put wgan 0 o
end

note "aux KEY VALUE" with an integer value v
fn wgaux t view uchar * v ulong to void
o = get wgan 0
wgat wgtaux
wgat t
wgac 32
wgad v
wgac 10
wgstapp o
end

note centiseconds as Python round(x, 2) repr (X.Y or X.YZ)
fn wgacs cs ulong to void
wgad div cs 100
wgac 46
f = rem cs 100
wgac add 48 div f 10
if ne rem f 10 0
wgac add 48 rem f 10
end
end

note "aux KEY X.YZ"
fn wgauxs t view uchar * cs ulong to void
o = get wgan 0
wgat wgtaux
wgat t
wgac 32
wgacs cs
wgac 10
wgstapp o
end

note record gate g: value is arena [vo, top); prints "NAME VALUE PASS|FAIL" and appends the gate line
fn wggate g ulong vo ulong ok bool to void
vn = sub get wgan 0 vo
o = get wgan 0
wggname g
wgac 32
wgacp vo vn
wgac 32
if ok
wgat wgtPASS
put wgg g 1
else
wgat wgtFAIL
put wgg g 2
end
wgac 10
wdoclr
for i ulong sub get wgan 0 o
wdoc ulong get wga add o i
end
wdoflush 1
o2 = get wgan 0
wgat wgtgate
wgacp o sub sub o2 o 1
wgac 32
wgasl SWIN
wgac 32
wgutc
wgac 10
wgstapp o2
put wgan 0 vo
end

note load ROUND40/data/NAME rows (stride 1); returns the row count
fn wgdata t view uchar * to ulong
wdpclr
wdpt wgtr40d
wdpt t
k = wgjfile
n = wgjrows k 1
ret n
end

note one probes() run; returns the pass count
fn wgprun lab view uchar * kd ulong n ulong to ulong
wgsett SLAB lab
put wgmd 2 kd
c = wgprobes n
ret c
end

note task 0: latency + copies (both checkpoints sample copy-final)
fn wgtlat to void
n = wgdata wgtdcopy
wgsett SCK wgtbase
t0 = monons
cb = wgprun wgtlb 0 n
bcs = ulong div add sub monons t0 5000000 10000000
put wgsl add mul SCK 2 0 wgso SCAND
put wgsl add mul SCK 2 1 wgsn SCAND
t1 = monons
cc = wgprun wgtlc 0 n
ccs = ulong div add sub monons t1 5000000 10000000
wgauxs wgtlbs bcs
wgauxs wgtlcs ccs
wgaux wgtlbp cb
wgaux wgtlcp cc
if eq bcs 0
wgdie wgtzero 70
end
vo = get wgan 0
wgratio ccs bcs
wggate 0 vo le mul ccs 100 mul bcs 102
vo2 = get wgan 0
wgad cc
wggate 1 vo2 eq cc 64
end

note round(c / b, 4) in Python float repr onto the arena (half up on the fifth digit)
fn wgratio c ulong b ulong to void
v = div add mul c 20000 b mul b 2
wgad div v 10000
wgac 46
f = rem v 10000
if eq f 0
wgac 48
ret
end
k = ulong 1000
while gt f 0 bound 8
wgac add 48 div f k
f = rem f k
k = div k 10
end
end

fn wgtscr to void
n = wgdata wgtdscr
put wgsl add mul SCK 2 0 wgso SCAND
put wgsl add mul SCK 2 1 wgsn SCAND
c = wgprun wgtlscr 1 n
vo = get wgan 0
wgad c
wggate 2 vo eq c 8
end

fn wgtreg to void
n = wgdata wgtdreg
put wgsl add mul SCK 2 0 wgso SCAND
put wgsl add mul SCK 2 1 wgsn SCAND
c = wgprun wgtlreg 0 n
vo = get wgan 0
wgad c
wggate 4 vo eq c 685
end

fn wgtsty to void
put wgsl add mul SCK 2 0 wgso SCAND
put wgsl add mul SCK 2 1 wgsn SCAND
wgsett SLOG wgtlsty
v = wgscore
vo = get wgan 0
wgad v
wggate 5 vo le mul v 10000 mul ulong 1190843 10025
end

note jobs over ROUND40/data/NAME under label lab; returns the job count
fn wgtjrun t view uchar * lab view uchar * to ulong
n = wgdata t
put wgsl add mul SCK 2 0 wgso SCAND
put wgsl add mul SCK 2 1 wgsn SCAND
wgsett SJL lab
put wgmd 2 2
wgjobs n
wgsett SLAB lab
wgjres n
ret n
end

note job i passes and its pair value equals job j's (same JSON type and text)
fn wgpaireq i ulong j ulong to bool
a = wgjget get wgdr i wgtpair
b = wgjget get wgdr j wgtpair
if or eq a 0 eq b 0
ret false
end
if ne get wgjt a get wgjt b
ret false
end
ret wgeq2 get wgjo a get wgjl a get wgjo b get wgjl b
end

fn wgtdev to void
n = wgtjrun wgtddev wgtldev
lg = ulong 0
ct = ulong 0
for i ulong n
if eq get wgjps i 1
if wgjis get wgdr i wgtfltk wgtlogic
lg = add lg 1
else
ct = add ct 1
end
end
end
pr = wgpairs n
vo = get wgan 0
wgat wgtvlog
wgad lg
wgat wgtvctl
wgad ct
wgat wgtvpr
wgad pr
wggate 3 vo and ge lg 72 and ge ct 12 ge pr 24
end

note distinct pair values whose jobs all pass
fn wgpairs n ulong to ulong
pr = ulong 0
for i ulong n
if eq wgjget get wgdr i wgtpair 0
continue
end
fst = true
alp = true
for j ulong n
if wgpaireq i j
if lt j i
fst = false
end
if ne get wgjps j 1
alp = false
end
end
end
if and fst alp
pr = add pr 1
end
end
ret pr
end

fn wgtret to void
n = wgtjrun wgtdret wgtlret
c = wgjpass n
vo = get wgan 0
wgad c
wggate 6 vo eq c 847
end

note read OUT/gates.txt: gate results into wgg, candidate sha checked against arena [ho, ho + 64)
fn wgstread ho ulong to void
wdpclr
wgpsl SOUT
wdpt wgtgst
if not wgexist
ret
end
o = wgload
e = get wgan 0
p = o
while lt p e bound 999999
q = wgeol p e
nx = get wgr 2
if wgsw p sub q p wgtcsha
if or ne sub q p 81 not wgeqa add p 17 ho 64
wgdie wgtcsm 5
end
end
if wgsw p sub q p wgtgate
wgstg add p 5 sub q add p 5
end
p = nx
end
put wgan 0 o
end

note "NAME VALUE PASS|FAIL ..." at (o, n): set wgg
fn wgstg o ulong n ulong to void
s1 = wgfindt o n wgtsp
if eq s1 WGNO
ret
end
for g ulong 7
m = get wgan 0
wggname g
gl = sub get wgan 0 m
eqn = wgeq2 o s1 m gl
put wgan 0 m
if eqn
r = add add o s1 1
rn = sub n add s1 1
s2 = wgfindt r rn wgtsp
if ne s2 WGNO
if wgsw add add r s2 1 sub rn add s2 1 wgtPASS
put wgg g 1
else
put wgg g 2
end
end
end
end
end

note estimate in seconds of task k (gates.py TASKS)
fn wgest k ulong to ulong
if eq k 0
ret 150
end
if eq k 1
ret 60
end
if eq k 2
ret 400
end
if eq k 3
ret 150
end
if eq k 4
ret 40
end
ret 700
end

note gate index that marks task k done (latency task records gates 0 and 1)
fn wgtg k ulong to ulong
if eq k 0
ret 1
end
if eq k 1
ret 2
end
if eq k 2
ret 3
end
if eq k 3
ret 4
end
if eq k 4
ret 5
end
ret 6
end

fn wgtask k ulong to void
if eq k 0
wgtlat
end
if eq k 1
wgtscr
end
if eq k 2
wgtdev
end
if eq k 3
wgtreg
end
if eq k 4
wgtsty
end
if eq k 5
wgtret
end
end

fn wganyf to bool
for g ulong 7
if eq get wgg g 2
ret true
end
end
ret false
end

note WSP_BUDGET seconds (default 1080; digits only)
fn wgbudget to ulong
if not wdenv wgtbud
ret 1080
end
n = get wdvn 0
if eq n 0
wgdie wgtbudb 2
end
v = ulong 0
for i ulong n
c = ulong get wdv i
if not wgdig c
wgdie wgtbudb 2
end
v = add mul v 10 sub c 48
end
ret v
end

fn wgrunm to int
t0 = monons
if ne ulong argcnt 4
wgdie wgtuse 2
end
wgrwin
bud = wgbudget
wgresk 3 SOUT
wgresk 2 SCAND
wgmkout
put wgmd 0 1
wgrhead
mk = get wgan 0
for k ulong 6
if wganyf
break
end
if ne get wgg wgtg k 0
continue
end
el = ulong div sub monons t0 1000000000
if gt add el wgest k bud
wdoclr
wdot wgtbudr
wdod el
wdoc 10
wdoflush 1
ret 10
end
put wgan 0 mk
put wgjn 0 0
wgtask k
end
wgrfin
ret 0
end

note SPARK_WINDOW into slot SWIN; exit 3 when it is missing or empty
fn wgrwin to void
if not wdenv wgtsw
wgdie wgtrefu 3
end
if eq get wdvn 0 0
wgdie wgtrefu 3
end
o = get wgan 0
for i ulong get wdvn 0
wgac ulong get wdv i
end
wgsetf SWIN o
end

note base and candidate sha256, resume state, and the header lines of gates.txt
fn wgrhead to void
wdpclr
wdpt wgtbase
if not wdfsha
wgdiep wgtfile 71
end
if not wdhexeq wgtbsha
wdpclr
wdpt wgtbase
wgdiep wgtbsm 4
end
wdpclr
wgpsl SCAND
if not wdfsha
wgdiep wgtfile 71
end
ho = get wgan 0
wgahex
wgstread ho
wdpclr
wgpsl SOUT
wdpt wgtgst
frs = not wgexist
o2 = get wgan 0
if frs
wgat wgtcand
wgasl SCAND
wgac 10
wgat wgtcsha
wgacp ho 64
wgac 10
wgat wgtstart
wgutc
wgac 10
end
wgat wgtwinl
wgasl SWIN
wgac 10
wgstapp o2
end

note the end line and the verdict (GATES_PASS when all 7 gates passed)
fn wgrfin to void
alp = true
for g ulong 7
if ne get wgg g 1
alp = false
end
end
o3 = get wgan 0
wgat wgtendl
wgutc
wgac 32
vo = get wgan 0
if alp
wgat wgtallp
else
wgat wgtnall
end
wgac 10
wdoclr
for j ulong sub get wgan 0 vo
wdoc ulong get wga add vo j
end
wdoflush 1
wgstapp o3
end

note ---------------------------------------------------------------- entry

text wgtrunm "run"
text wgtrlog "replaylog"
text wgtdryr "dryrun"

fn main to int
put wgan 0 0
put wgjn 0 0
put wgobf 0 1
put wgxr 0 WGABS
put wgxr 1 WGABS
if lt ulong argcnt 2
wgdie wgtuse 2
end
n = wdarg 1
o = get wgan 0
for j ulong n
wgac ulong get wdab j
end
put wgan 0 o
r = int 2
if wgeqt o n wgtrunm
r = wgrunm
ret r
end
if wgeqt o n wgtrply
r = wgreplay false
ret r
end
if wgeqt o n wgtrlog
r = wgreplay true
ret r
end
if wgeqt o n wgtdryr
r = wgdry
ret r
end
wgdie wgtuse 2
ret r
end

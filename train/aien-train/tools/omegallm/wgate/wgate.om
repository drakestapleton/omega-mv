om2
note SPDX-License-Identifier: AGPL-3.0-only
note wgate.om (DRA-187, lane wsp): the round40 retention gate runner in seeded Omega. It replaces the
note Python glue evidence/OMEGALLM/wsp-dra187-20261107/gates.py, which imported round41 lib.py,
note repair.py, checker.py and check_behavior.py. Composed after wbuild.om (its main renamed wbmain):
note   OMC=omc CORE=0 wbuild OUT/wgate tools/omegallm/wdrive/wbuild.om@wbmain tools/omegallm/wgate/wgate.om
note Usage (README.md has the full contract):
note   wgate run CANDIDATE.ck OUTDIR
note   wgate replay probe|first|jobs DATA.json RECORDED.json OUTDIR [STRIDE]
note   wgate replaylog probe|first|jobs DATA.json RECORDED.json LOGDIR LABEL OUTDIR [STRIDE]
note   wgate dryrun probe|jobs CK OUTDIR LABEL DATA.json
note Exits: 0 done (run: every task finished or stopped at a failed gate; replay: no mismatch),
note 1 replay mismatch, 2 usage, 3 refused (no SPARK_WINDOW), 4 base checkpoint sha256 mismatch,
note 5 OUTDIR belongs to another candidate, 10 window budget reached, 61 arena or table full,
note 70 host failure, 71 file operation failed, 72 text decode or encode error, 73 native command
note exit status not 0, 74 native command timeout, 75 sampler answer count mismatch, 76 compile or
note test timeout inside compile_test, 77 JSON nesting past the measured Python limit, 78 geval
note output unparsable, 79 unsupported JSON shape, 80 data or recorded file is not JSON.
note
note Every string lives in the arena wga as (offset, length); functions take offsets because a part of
note a global is refused (error 19). wgr carries extra results. Slots (wgsl) name arena strings.

const WGNO ulong 18446744073709551615
const WGREC ulong 18446744073709551614
const WGTMO long -1000000
const WGABS long -2000000
const WGMAXA ulong 16777216
const WGMAXJ ulong 2097152
const SOUT ulong 0
const SCAND ulong 1
const SCK ulong 2
const SLAB ulong 3
const SWIN ulong 4
const SFIX ulong 5
const SCL ulong 6
const SJL ulong 7
const SLOG ulong 8
const SBLD ulong 9
const SCB ulong 10
const SCT ulong 11
const SJF ulong 12
const SPL ulong 13

global wga uchar 16777216
global wgan ulong 1
global wgr ulong 8
global wgsl ulong 64
global wgjt uchar 2097152
global wgjo ulong 2097152
global wgjl ulong 2097152
global wgjc ulong 2097152
global wgjs ulong 2097152
global wgjn ulong 1
global wgks ulong 10000
global wgkl ulong 10000
global wgps ulong 8
global wgnd ulong 68
global wgsb uchar 128
global wgpo ulong 1024
global wgpl ulong 1024
global wgao ulong 1024
global wgal ulong 1024
global wgact ulong 1024
global wgdr ulong 1024
global wgrr ulong 1024
global wgok uchar 1024
global wgx long 4
global wgxr long 4
global wgmd ulong 4
global wgob uchar 65536
global wgobn ulong 1
global wgobf int 1
global wgg uchar 8
global wgtm long 4
global wgmis ulong 1
global wgjst uchar 1024
global wgjso ulong 1024
global wgjsn ulong 1024
global wgjoo ulong 1024
global wgjon ulong 1024
global wgjdn uchar 1024
global wgjps uchar 1024
global wgjvf uchar 1024
global wgjhv uchar 1024
global wgjer uchar 1024
global wgjtn ulong 1024
global wgtro ulong 7168
global wgtrl ulong 7168
global wgtst uchar 7168
global wgtto ulong 7168
global wgttn ulong 7168
global wgtth uchar 7168

text wgtomc "/home/drakestapleton/handoffs/omega-llm-20261101/omega-mv/seed/out/omc"
text wgtgpu "/tmp/gk/r10/ollm-gb10"
text wgtcpu "/home/drakestapleton/handoffs/weight-tuning-20261104/build/ollm"
text wgtmrg "/home/drakestapleton/handoffs/omega-llm-20261101/v1-data/merges4096.bin"
text wgtbs "/home/drakestapleton/handoffs/tool-omega-20261104/build/batch-sample"

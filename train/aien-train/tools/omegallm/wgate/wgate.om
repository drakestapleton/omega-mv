note ---------------------------------------------------------------- repair.jobs_run
note job states: 1 unread, 2 read, 3 missing, 4 checked, 5 failed, 6 edited

text wgts1 "unread"
text wgts2 "read"
text wgts3 "missing"
text wgts4 "checked"
text wgts5 "failed"
text wgts6 "edited"

fn wgstn s ulong to void
if eq s 1
wgat wgts1
end
if eq s 2
wgat wgts2
end
if eq s 3
wgat wgts3
end
if eq s 4
wgat wgts4
end
if eq s 5
wgat wgts5
end
if eq s 6
wgat wgts6
end
end

note state name of s equals the arena text (o, n)
fn wgsteq s ulong o ulong n ulong to bool
m = get wgan 0
wgstn s
r = wgeq2 m sub get wgan 0 m o n
put wgan 0 m
ret r
end

text wgtid "id"
text wgtstyl "style"
text wgtfault "fault"
text wgtbrok "broken"
text wgtka "a"
text wgtkk "k"
text wgtkn "n"
text wgtadd "add"
text wgtmul "mul"

fn wgjv ji ulong t view uchar * to long
ret wgjint wgjget get wgdr ji t
end

note OUT/fixtures/JL/id/program.om into wdp (dir only when pf is false)
text wgtfixs "/fixtures/"
text wgtprg "/program.om"
fn wgpjob ji ulong pf bool to void
wdpclr
wgpsl SOUT
wdpt wgtfixs
wgpsl SJL
wdpc 47
wgjsget get wgdr ji wgtid
wgpar get wgr 3 get wgr 4
if pf
wdpt wgtprg
end
end

text wgtg1 "calc starts with x and adds "
text wgtg2 " exactly "
text wgtg3 " times in a for loop. main calls calc with "
text wgtg4 "calc returns x "
text wgtplus "plus "
text wgttimes "times "
text wgtg5 ". main calls calc with "
text wgtp1 "Task: "
text wgtp2 "\nFile: "
text wgtp3 "\nGoal: "
text wgtp4 "\nState: "
text wgtp5 "Source:\n"
text wgtp6 "Tool result: "
text wgtp7 "Answer:\n"
text wgtdot "."

fn wggoal ji ulong to void
j = get wgdr ji
if wgjis j wgtkind wgtloop
wgat wgtg1
wgadl wgjv ji wgtkk
wgat wgtg2
wgadl wgjv ji wgtkn
wgat wgtg3
wgadl wgjv ji wgtka
wgat wgtdot
ret
end
wgat wgtg4
if wgjis j wgtkind wgtadd
wgat wgtplus
else
wgat wgttimes
end
wgadl wgjv ji wgtkk
wgat wgtg5
wgadl wgjv ji wgtka
wgat wgtdot
end

note repair.prompt for job ji in its current state, onto the arena; returns the offset
fn wgprm ji ulong to ulong
j = get wgdr ji
o = get wgan 0
wgat wgtp1
st = wgjv ji wgtstyl
if or lt st 0 gt st 50
wgdie wgtshp 79
end
wgsty ulong st
wgat wgtp2
wgjsget j wgtpath
wgacp get wgr 3 get wgr 4
wgat wgtp3
wggoal ji
wgat wgtp4
wgstn ulong get wgjst ji
wgat wgtnl
if gt get wgjsn ji 0
wgat wgtp5
wgacp get wgjso ji get wgjsn ji
end
if gt get wgjon ji 0
wgat wgtp6
wgacp get wgjoo ji get wgjon ji
wgat wgtnl
end
wgat wgtp7
ret o
end

fn wgobs ji ulong t view uchar * to void
o = get wgan 0
wgat t
put wgjoo ji o
put wgjon ji len t
end

text wgtrok "Read succeeded."
text wgtfnf "File not found."
text wgttp "Tests passed."
text wgtes "Edit saved."
text wgtref "Refused unsupported source."
text wgtrfm "Required functions missing."
text wgtmpi "main must preserve the requested input."
text wgtrlm "Required loop missing."
text wgtfci "fn calc x int to int"
text wgtrci "ret calc int "
text wgtfiu "for i ulong "
text wgttf1 "Test failed: calc("
text wgttf2 ") expected "
text wgttf3 ", got "
text wgtcto "ct.om"
text wgtcte "ct.err"
text wgtctr "ct.run"
text wgtchk2 "check-"

note Path.read_text() of the file named by wdp: ASCII (exit 72 otherwise), universal newlines
fn wgrtext to ulong
o = wgload
n = sub get wgan 0 o
wgasc o n
i = ulong 0
w = ulong 0
while lt i n bound 999999
c = get wga add o i
if eq c 13
c = 10
if lt add i 1 n
if eq get wga add o add i 1 10
i = add i 1
end
end
end
put wga add o w c
w = add w 1
i = add i 1
end
put wgan 0 add o w
ret o
end

note the main-preserve check: the stripped lines starting with "ret calc int " are exactly one, "ret calc int {a}"
fn wgmainok so ulong sn ulong a long to bool
wgstrip so sn
p = get wgr 0
e = add p get wgr 1
want = get wgan 0
wgat wgtrci
wgadl a
wn = sub get wgan 0 want
cnt = ulong 0
ok = false
while lt p e bound 999999
q = wgeol p e
nx = get wgr 2
if wgsw p sub q p wgtrci
cnt = add cnt 1
ok = wgeq2 p sub q p want wn
end
p = nx
end
put wgan 0 want
ret and eq cnt 1 ok
end

note expected(j, x)
fn wgwant ji ulong x long to long
j = get wgdr ji
k = wgjv ji wgtkk
if wgjis j wgtkind wgtadd
ret add x k
end
if wgjis j wgtkind wgtmul
ret mul x k
end
ret add x mul k wgjv ji wgtkn
end

note the stripped lines of [so, so + sn) all match repair.PATTERNS
fn wgrgram so ulong sn ulong to bool
wgstrip so sn
ret wglines get wgr 0 get wgr 1 1
end

note observation = stripped omc stderr (OUT/build/ct.err); ASCII or exit 72
fn wgcterr ji ulong to void
wgbload wgtcte
wgasc get wgr 5 get wgr 6
wgstrip get wgr 5 get wgr 6
put wgjoo ji get wgr 0
put wgjon ji get wgr 1
end

note one test of compile_test: 0 pass, 1 fail (observation set)
fn wgct1 so ulong sn ulong ji ulong a long to ulong
co = get wgan 0
i = ulong 0
while lt i sn bound 999999
if wgsw add so i sub sn i wgtrci
d = add i 13
if lt d sn
if wgdig ulong get wga add so d
wgat wgtrci
wgadl a
d = add d 1
if lt d sn
if wgdig ulong get wga add so d
d = add d 1
end
end
i = d
continue
end
end
end
wgac ulong get wga add so i
i = add i 1
end
cn = sub get wgan 0 co
wgpout wgtbld
wdpt wgtcto
wgwfile co cn
r = wgomc wgtcto wgtomo wgtcte
if eq r WGTMO
wgdie wgtctt 76
end
if ne r 0
wgcterr ji
ret 1
end
wgpout wgtbld
wdpt wgtchk2
wghash a
wgsetp SPL
wgplace wgtomo
v = wgrunx wgtctr
if eq v WGTMO
wgdie wgtctt 76
end
ret wgct2 ji a v
end

note compile_test tail: read the run output, compare with the wanted value
fn wgct2 ji ulong a long v long to ulong
wdpclr
wgpsl SPL
u = unlink wdp 0 get wdpn 0
wgbload wgtctr
so2 = get wgr 5
sn2 = get wgr 6
wgasc so2 sn2
want = wgwant ji a
if or ne v want gt sn2 0
o = get wgan 0
wgat wgttf1
wgadl a
wgat wgttf2
wgadl want
wgat wgttf3
wgadl v
wgat wgtdot
put wgjoo ji o
put wgjon ji sub get wgan 0 o
ret 1
end
ret 0
end

note sha256(slot SCT + str(a)) hex[:20] onto wdp
fn wghash a long to void
b = new uchar 4096 0
h = new uchar 32 0
o = get wgan 0
wgasl SCT
wgadl a
n = sub get wgan 0 o
if gt n 4096
wgdie wgtfull 61
end
for i ulong n
put b i get wga add o i
end
put wgan 0 o
sha256_hash part b 0 n h
for k ulong 10
v = ulong get h k
wdpc ulong get wdhex shr v 4
wdpc ulong get wdhex and v 15
end
end

note repair.compile_test(src, j, label=slot SCT): 0 ok, 1 not ok; observation into the job's obs
fn wgct so ulong sn ulong ji ulong to ulong
j = get wgdr ji
g = and gt sn 0 le sn 600
if g
g = wgrgram so sn
end
if not g
wgjsget j wgtbrok
if not wgeq2 so sn get wgr 3 get wgr 4
wgobs ji wgtref
ret 1
end
end
wgpout wgtbld
wdpt wgtcto
wgwfile so sn
r = wgomc wgtcto wgtomo wgtcte
if eq r WGTMO
wgdie wgtctt 76
end
if ne r 0
wgcterr ji
ret 1
end
if not wgrgram so sn
wgobs ji wgtref
ret 1
end
if or ne wgcntt so sn wgtfci 1 ne wgcntt so sn wgtfmain 1
wgobs ji wgtrfm
ret 1
end
a0 = wgjv ji wgtka
if not wgmainok so sn a0
wgobs ji wgtmpi
ret 1
end
if wgjis j wgtkind wgtloop
if eq wgfindt so sn wgtfiu WGNO
wgobs ji wgtrlm
ret 1
end
end
if ne wgct1 so sn ji a0 0
ret 1
end
for t ulong 3
av = wgtav t
if ne av a0
if ne wgct1 so sn ji av 0
ret 1
end
end
end
wgobs ji wgttp
ret 0
end

note the dedup order [a, 0, 3, 7]: test t of 0, 3, 7
fn wgtav t ulong to long
if eq t 0
ret 0
end
if eq t 1
ret 3
end
ret 7
end

text wgtold "old"
text wgtnew "new"
text wgtrpl "replace_text"

note repair.patch: the fixed source onto the arena (wgr 5, wgr 6), or false (ValueError)
fn wgpatch ji ulong d ulong to bool
if ne wgjnkey d 4
ret false
end
ov = wgjget d wgtold
nv = wgjget d wgtnew
if or eq ov 0 eq nv 0
ret false
end
if or ne get wgjt ov 5 ne get wgjt nv 5
ret false
end
oo = get wgjo ov
onn = get wgjl ov
if or eq onn 0 or gt wgcpl oo onn 40 gt wgcpl get wgjo nv get wgjl nv 40
ret false
end
so = get wgjso ji
sn = get wgjsn ji
if ne wgcnt so sn oo onn 1
ret false
end
i = wgfind so sn oo onn
r = get wgan 0
wgacp so i
wgacp get wgjo nv get wgjl nv
wgacp add so add i onn sub sn add i onn
rn = sub get wgan 0 r
if not wgrgram r rn
ret false
end
put wgr 5 r
put wgr 6 rn
ret true
end

note code points of UTF-8 text (bytes that are not continuation bytes)
fn wgcpl o ulong n ulong to ulong
c = ulong 0
for i ulong n
if ne and get wga add o i 192 128
c = add c 1
end
end
ret c
end

note one action; 0 ok, 1 error (ValueError/TypeError/KeyError)
fn wgact1 ji ulong d ulong t ulong to ulong
if eq d WGNO
ret 1
end
if ne get wgjt d 7
ret 1
end
j = get wgdr ji
pv = wgjget d wgtpath
if eq pv 0
ret 1
end
if ne get wgjt pv 5
ret 1
end
wgjsget j wgtpath
if not wgeq2 get wgjo pv get wgjl pv get wgr 3 get wgr 4
ret 1
end
st = get wgjst ji
nk = wgjnkey d
if and and eq nk 2 eq st 1 wgjis d wgttool wgtrdf
ret wgactr ji
end
if and and eq nk 2 or eq st 2 eq st 6 wgjis d wgttool wgtomck
ret wgactc ji t
end
if and eq st 5 wgjis d wgttool wgtrpl
ret wgactp ji d
end
ret 1
end

note read_file action
fn wgactr ji ulong to ulong
wgpjob ji true
if wgexist
o = wgrtext
put wgjso ji o
put wgjsn ji sub get wgan 0 o
put wgjst ji 2
wgobs ji wgtrok
else
put wgjst ji 3
wgobs ji wgtfnf
end
ret 0
end

note omc_check action
fn wgactc ji ulong t ulong to ulong
wgpjob ji true
o2 = wgrtext
n2 = sub get wgan 0 o2
o3 = get wgan 0
wgasl SJL
wgjsget get wgdr ji wgtid
wgacp get wgr 3 get wgr 4
wgad t
wgsetf SCT o3
v = wgct o2 n2 ji
wgactt ji t v
ret 0
end

note record the compile_test outcome of job ji at turn t
fn wgactt ji ulong t ulong v ulong to void
k = add mul ji 7 t
put wgtth k uchar sub 2 v
put wgtto k get wgjoo ji
put wgttn k get wgjon ji
put wgjst ji uchar add 4 v
put wgjvf ji wgb eq v 0
put wgjhv ji 1
end

note replace action
fn wgactp ji ulong d ulong to ulong
if not wgpatch ji d
ret 1
end
fo = get wgr 5
fn2 = get wgr 6
wgpjob ji true
wgwfile fo fn2
put wgjst ji 6
put wgjso ji fo
put wgjsn ji fn2
wgobs ji wgtes
put wgjvf ji 0
put wgjhv ji 1
ret 0
end

note one answer for job ji at turn t
fn wgstep ji ulong ro ulong rn ulong t ulong to void
wgasc ro rn
wgturn ji ro rn t
wgtext ro rn
so = get wgr 0
sn = get wgr 1
if wgeqt so sn wgttp
wgjtp ji
ret
end
if wgeqt so sn wgtfnf
put wgjps ji wgb eq get wgjst ji 3
put wgjdn ji 1
ret
end
wgstp2 ji so sn t
end

note record turn t of job ji (raw answer and state)
fn wgturn ji ulong ro ulong rn ulong t ulong to void
k = add mul ji 7 t
put wgtro k ro
put wgtrl k rn
put wgtst k get wgjst ji
put wgtth k 0
put wgjtn ji add t 1
end

note TASK_PASSED: pass iff state is verified-done with a passing verification
fn wgjtp ji ulong to void
st = get wgjst ji
hv = eq get wgjhv ji 1
put wgjps ji wgb and eq st 4 and hv eq get wgjvf ji 1
put wgjdn ji 1
end

note any other answer: parse and act
fn wgstp2 ji ulong so ulong sn ulong t ulong to void
mk = get wgjn 0
d = wgjparse so sn
r = wgact1 ji d t
put wgjn 0 mk
if ne r 0
put wgjdn ji 1
put wgjer ji 1
end
end

note set up nj jobs (wgdr) under label slot SJL: fixtures and initial state
fn wgjinit nj ulong to void
for i ulong nj
wgpjob i false
wgmkp
wgjzero i
wgjzer2 i
j = get wgdr i
if not wgjis j wgtfault wgts3
wgpjob i true
wgjsget j wgtbrok
wgwfile get wgr 3 get wgr 4
end
end
end

text wgtturn "-turn"

note jobs_run over nj jobs; answers come from wgsamp
fn wgjobs nj ulong to void
wgjinit nj
for t ulong 7
na = ulong 0
for i ulong nj
if eq get wgjdn i 0
put wgact na i
put wgpo na wgprm i
put wgpl na sub get wgan 0 get wgpo na
na = add na 1
end
end
if eq na 0
break
end
o = get wgan 0
wgasl SJL
wgat wgtturn
wgad t
wgsetf SLAB o
put wgmd 1 t
wgsamp na
for q ulong na
wgstep get wgact q get wgao q get wgal q t
end
end
end

fn wgjzero i ulong to void
put wgjst i 1
put wgjso i 0
put wgjsn i 0
put wgjoo i 0
put wgjon i 0
put wgjdn i 0
end

fn wgjzer2 i ulong to void
put wgjps i 0
put wgjvf i 0
put wgjhv i 0
put wgjer i 0
put wgjtn i 0
end

note ---------------------------------------------------------------- lib.run / sample / score
note wgmd: 0 mode (1 live, 2 replay, 3 replaylog), 1 current turn, 2 kind (0 probe, 1 first, 2 jobs)

text wgtrcps "/receipts/"
text wgtlog ".log"
text wgtcmds "/commands.txt"
text wgtrcw " rc="
text wgtwin " window="
text wgtargv " argv"
text wgtdats "/data/s"
text wgtdats2 "/data/s/"
text wgtbin ".bin"
text wgttok ".tok"
text wgtenc "-encode"
text wgtsmp "-sample"
text wgtbat "-batch"
text wgtbpe "bpeenc"
text wgt4096 "4096"
text wgt160 "160"
text wgtgev2 "geval"
text wgt256 "256"
text wgtraw "raw_output"
text wgtturns "turns"
text wgtprom "prompt"
text wgtrawk "raw"
text wgtstk "state"

note the packed argv list wdk joined by spaces onto the arena
fn wgkargs to void
c = get wdkn 0
p = ulong 2
for i ulong c
n = or ulong get wdk p shl ulong get wdk add p 1 8
if gt i 0
wgac 32
end
for j ulong n
wgac ulong get wdk add add p 2 j
end
p = add add p 2 n
end
end

note lib.run: argv in wdk, label in slot SLOG; stdout and stderr to OUT/receipts/LABEL.log; the
note command line goes to OUT/commands.txt after it ends (not on timeout). Returns the log offset
note (length in wgr 6) after universal newline translation; exit 73 when rc is not 0, 74 on timeout.
fn wgrun ns long to ulong
wdpclr
wgpsl SOUT
wdpt wgtrcps
wgpsl SLOG
wdpt wgtlog
wgsetp SPL
fd = wgcreat false
pid = wgspawn -1 fd fd WGNO
r = wgreap pid ns
c = fclose fd
if eq r WGTMO
wdpclr
wgpsl SLOG
wgdiep wgtcmdt 74
end
m = get wgan 0
wgasl SLOG
wgat wgtrcw
wgadl r
wgat wgtwin
wgasl SWIN
wgat wgtargv
wgac 32
wgkargs
wgac 10
wdpclr
wgpsl SOUT
wdpt wgtcmds
fd2 = wgcreat true
wgwr fd2 m sub get wgan 0 m
c2 = fclose fd2
put wgan 0 m
if ne r 0
wdpclr
wgpsl SLOG
wgdiep wgtcmdf 73
end
wdpclr
wgpsl SPL
o = wgrtext
put wgr 6 sub get wgan 0 o
ret o
end

note OUT/data/s/SBLD + suffix into wdp
fn wgpbld t view uchar * to void
wdpclr
wgpsl SOUT
wdpt wgtdats2
wgpsl SBLD
wdpt t
end

note the log (o, n) split on NUL into wgao/wgal from index b0 for cnt answers (exit 75 otherwise)
fn wgsplit o ulong n ulong b0 ulong cnt ulong to void
k = ulong 0
s = o
e = add o n
i = o
while lt i e bound 999999
if eq get wga i 0
if ge k cnt
wgdie wgtcnt 75
end
put wgao add b0 k s
put wgal add b0 k sub i s
k = add k 1
s = add i 1
end
i = add i 1
end
if or ne k cnt ne s e
wgdie wgtcnt 75
end
end

note one live batch: prompts [b0, b0 + cnt) of wgpo/wgpl under the batch label in slot SBLD
fn wglive b0 ulong cnt ulong to void
z = new uchar 1 0
wdpclr
wgpsl SOUT
wdpt wgtdats
wgmkp
wgpbld wgtbin
fd = wgcreat false
for q ulong cnt
wgwr fd get wgpo add b0 q get wgpl add b0 q
w = write fd z 0 1
end
c = fclose fd
m = get wgan 0
wgasl SBLD
wgat wgtenc
wgsetf SLOG m
wgkenc
lo = wgrun 1800000000000
m2 = get wgan 0
wgasl SBLD
wgat wgtsmp
wgsetf SLOG m2
wgksmp
lo2 = wgrun 900000000000
wgsplit lo2 get wgr 6 b0 cnt
wgpbld wgtbin
u = unlink wdp 0 get wdpn 0
wgpbld wgttok
u2 = unlink wdp 0 get wdpn 0
end

note encode argv [CPU, bpeenc, MERGES, 4096, pf, tf] into wdk
fn wgkenc to void
wdkclr
wdkt wgtcpu
wdkt wgtbpe
wdkt wgtmrg
wdkt wgt4096
wgpbld wgtbin
wdkp
wgpbld wgttok
wdkp
end

note sample argv [batch-sample, ck, tf, MERGES, 160] into wdk
fn wgksmp to void
wdkclr
wdkt wgtbs
wdpclr
wgpsl SCK
wdkp
wgpbld wgttok
wdkp
wdkt wgtmrg
wdkt wgt160
end

note geval argv [GPU, geval, ck, story-final.tok, 256, MERGES] into wdk
fn wgkgev to void
wdkclr
wdkt wgtgpu
wdkt wgtgev2
wdpclr
wgpsl SCK
wdkp
wdkt wgtstok
wdkt wgt256
wdkt wgtmrg
end

note one replaylog batch: LOGDIR/SBLD-sample.log
fn wglogb b0 ulong cnt ulong to void
wdpclr
wgpsl SLOG
wdpc 47
wgpsl SBLD
wdpt wgtsmp
wdpt wgtlog
o = wgrtext
wgsplit o sub get wgan 0 o b0 cnt
end

note the recorded raw for active answer q (probe row q, or turn of job wgact q); 0 when absent
fn wgrecraw q ulong to ulong
if ne get wgmd 2 2
v = wgjget get wgrr q wgtraw
ret v
end
ji = get wgact q
ts = wgjget get wgrr ji wgtturns
if eq ts 0
ret 0
end
tr = wgjat ts get wgmd 1
if eq tr 0
ret 0
end
ret tr
end

note sample(label=slot SLAB, prompts wgpo/wgpl[0..na)) into wgao/wgal[0..na)
fn wgsamp na ulong to void
md = get wgmd 0
if eq md 2
wgsrep na
ret
end
b = ulong 0
b0 = ulong 0
while lt b0 na bound 1024
cnt = sub na b0
if gt cnt 128
cnt = 128
end
o = get wgan 0
wgasl SLAB
wgat wgtbat
wgad b
wgsetf SBLD o
if eq md 1
wglive b0 cnt
else
wglogb b0 cnt
end
b0 = add b0 cnt
b = add b 1
end
if eq md 3
wgsrec na
end
end

note replay: answers are the recorded raws; prompts are compared with the recorded ones (jobs)
fn wgsrep na ulong to void
for q ulong na
r = wgrecraw q
if eq r 0
wgdie wgtdiv 81
end
v = r
if eq get wgmd 2 2
wgcprom q r
v = wgjget r wgtrawk
end
if eq v 0
wgdie wgtshp 79
end
if ne get wgjt v 5
wgdie wgtshp 79
end
put wgao q get wgjo v
put wgal q get wgjl v
end
end

note replaylog: the log answers are compared with the recorded raws
fn wgsrec na ulong to void
for q ulong na
r = wgrecraw q
if eq r 0
wgmism q wgtrawk
continue
end
v = r
if eq get wgmd 2 2
wgcprom q r
v = wgjget r wgtrawk
end
if eq v 0
wgmism q wgtrawk
continue
end
if not wgeq2 get wgao q get wgal q get wgjo v get wgjl v
wgmism q wgtrawk
end
end
end

note compare prompt q with the recorded turn r
fn wgcprom q ulong r ulong to void
v = wgjget r wgtprom
if eq v 0
wgmism q wgtprom
ret
end
if not wgeq2 get wgpo q get wgpl q get wgjo v get wgjl v
wgmism q wgtprom
end
end

text wgtmis "MISMATCH row="
text wgtfld " field="
text wgttrn " turn="

fn wgmism q ulong t view uchar * to void
put wgmis 0 add get wgmis 0 1
wdot wgtmis
r = q
if eq get wgmd 2 2
r = get wgact q
end
wdod r
if eq get wgmd 2 2
wdot wgttrn
wdod get wgmd 1
end
wdot wgtfld
wdot t
wdoc 10
end

note lib.score: geval on slot SCK with label slot SLOG; the third number of the one E row
fn wgscore to ulong
wgkgev
lo = wgrun 1800000000000
n = get wgr 6
e = add lo n
p = lo
found = ulong 0
val = ulong 0
while lt p e bound 999999
q = wgeol p e
nx = get wgr 2
if wgerow p sub q p
found = add found 1
val = ulong get wgtm 2
if ne get wgtm 1 256
found = 99
end
end
p = nx
end
if ne found 1
wgdie wgtgev 78
end
ret val
end

note line is "E d+ d+ d+ d+": the four numbers into wgtm
fn wgerow o ulong n ulong to bool
if lt n 9
ret false
end
if or ne get wga o 69 ne get wga add o 1 32
ret false
end
i = ulong 2
for f ulong 4
if gt f 0
if ge i n
ret false
end
if ne get wga add o i 32
ret false
end
i = add i 1
end
s = i
v = long 0
while lt i n bound 4096
if not wgdig ulong get wga add o i
break
end
if lt i add s 18
v = add mul v 10 long sub ulong get wga add o i 48
end
i = add i 1
end
if eq i s
ret false
end
put wgtm f v
end
ret eq i n
end

note ---------------------------------------------------------------- probes, results, replay comparison

text wgtpass "pass"
text wgtcrc "compile_rc"
text wgtrrc "run_rc"
text wgtPASS "PASS"
text wgtFAIL "FAIL"
text wgtres "/results/"
text wgttxt ".txt"
text wgttmp ".tmp"
text wgtcr " compile_rc="
text wgtrr " run_rc="
text wgtsts " state="
text wgttns " turns="
text wgterr " error"
text wgtver "verified"
text wgterrk "error"
text wgtsrc "src"
text wgtobs "obs"
text wgttres "tool_result"
text wgtobsk "observation"
text wgtok "ok"

note gates.py probes(): prompts of rows wgdr[0..nr), label slot SLAB; kind wgmd 2 (0 checker, 1 first)
fn wgprobes nr ulong to ulong
for i ulong nr
wgjsget get wgdr i wgtprom
put wgpo i get wgr 3
put wgpl i get wgr 4
end
wgsamp nr
cnt = ulong 0
for q ulong nr
ok = false
if eq get wgmd 2 1
put wgxr 0 WGABS
put wgxr 1 WGABS
ok = wgfirst get wgao q get wgal q get wgdr q
else
o = get wgan 0
wgasl SLAB
wgac 45
wgad q
wgsetf SCB o
ok = wgcheck get wgao q get wgal q get wgdr q
end
put wgok q wgb ok
if ok
cnt = add cnt 1
end
wgrline q
if ge get wgmd 0 2
wgpcmp q ok
end
end
wgresfin
ret cnt
end

note results buffer to OUT/results/SLAB.txt.tmp, opened by wgresop
fn wgresop to void
wdpclr
wgpsl SOUT
wdpt wgtres
wgpsl SLAB
wdpt wgttxt
wdpt wgttmp
fd = wgcreat false
put wgobf 0 fd
put wgobn 0 0
end

fn wgresfin to void
wgofl
c = fclose get wgobf 0
wdkclr
wdpclr
wgpsl SOUT
wdpt wgtres
wgpsl SLAB
wdpt wgttxt
wdpt wgttmp
wdkp
put wdpn 0 sub get wdpn 0 4
wdkp
wdrename
end

fn wgpf ok bool to void
if ok
wgot wgtPASS
else
wgot wgtFAIL
end
end

fn wgrline q ulong to void
if eq q 0
wgresop
end
wgod q
wgoc 32
wgpf eq get wgok q 1
if ne get wgxr 0 WGABS
wgot wgtcr
wgodl get wgxr 0
end
if ne get wgxr 1 WGABS
wgot wgtrr
wgodl get wgxr 1
end
wgoc 10
end

note recorded boolean under t equals b (absent: mismatch)
fn wgcbool q ulong r ulong t view uchar * b bool to void
v = wgjget r t
if eq v 0
wgmism q t
ret
end
ty = get wgjt v
if and ne ty 3 ne ty 2
wgmism q t
ret
end
if ne wgb eq ty 3 wgb b
wgmism q t
end
end

note recorded integer under t (absent when x is WGABS)
fn wgcint q ulong r ulong t view uchar * x long to void
v = wgjget r t
if eq v 0
if ne x WGABS
wgmism q t
end
ret
end
if eq x WGABS
wgmism q t
ret
end
if ne wgjint v x
wgmism q t
end
end

fn wgpcmp q ulong ok bool to void
r = get wgrr q
wgcbool q r wgtpass ok
if eq get wgmd 2 0
wgcint q r wgtcrc get wgxr 0
wgcint q r wgtrrc get wgxr 1
end
end

note recorded string under t equals (o, n); absent counts as empty when em is true
fn wgcstr q ulong r ulong t view uchar * o ulong n ulong to void
v = wgjget r t
if eq v 0
wgmism q t
ret
end
if ne get wgjt v 5
wgmism q t
ret
end
if not wgeq2 get wgjo v get wgjl v o n
wgmism q t
end
end

note compare job ji with recorded row wgrr ji (mismatch rows are job indexes)
fn wgjcmp ji ulong to void
r = get wgrr ji
put wgmd 1 0
wgcbool ji r wgtpass eq get wgjps ji 1
m = get wgan 0
wgstn ulong get wgjst ji
wgcstr ji r wgtstk m sub get wgan 0 m
put wgan 0 m
wgcstr ji r wgtsrc get wgjso ji get wgjsn ji
wgcstr ji r wgtobs get wgjoo ji get wgjon ji
vv = wgjget r wgtver
if ne eq vv 0 eq get wgjhv ji 0
wgmism ji wgtver
else
if ne vv 0
wgcbool ji r wgtver eq get wgjvf ji 1
end
end
if ne eq wgjget r wgterrk 0 eq get wgjer ji 0
wgmism ji wgterrk
end
ts = wgjget r wgtturns
if eq ts 0
wgmism ji wgtturns
ret
end
if ne get wgjo ts get wgjtn ji
wgmism ji wgtturns
ret
end
for t ulong get wgjtn ji
wgtcmp ji wgjat ts t t
end
end

fn wgtcmp ji ulong tr ulong t ulong to void
k = add mul ji 7 t
m = get wgan 0
wgstn ulong get wgtst k
wgcstr ji tr wgtstk m sub get wgan 0 m
put wgan 0 m
tv = wgjget tr wgttres
if ne eq tv 0 eq get wgtth k 0
wgmism ji wgttres
ret
end
if ne tv 0
wgcbool ji tv wgtok eq get wgtth k 2
wgcstr ji tv wgtobsk get wgtto k get wgttn k
end
end

note jobs results file: id PASS|FAIL state=S turns=T [error]
fn wgjres nj ulong to void
wgresop
for i ulong nj
wgjsget get wgdr i wgtid
wgoa get wgr 3 get wgr 4
wgoc 32
wgpf eq get wgjps i 1
wgot wgtsts
m = get wgan 0
wgstn ulong get wgjst i
wgoa m sub get wgan 0 m
put wgan 0 m
wgot wgttns
wgod get wgjtn i
if eq get wgjer i 1
wgot wgterr
end
wgoc 10
end
wgresfin
end

fn wgjpass nj ulong to ulong
c = ulong 0
for i ulong nj
if eq get wgjps i 1
c = add c 1
end
end
ret c
end

note ---------------------------------------------------------------- paths and arguments

note argument i into slot k
fn wgargs i ulong k ulong to void
n = wdarg i
o = get wgan 0
for j ulong n
wgac ulong get wdab j
end
wgsset k o n
end

text wgtpwd "PWD"
text wgtnopwd "wgate: relative path and no PWD\n"

note Path.resolve() made lexical: argument i, absolute (PWD prefix), with "." and ".." folded; slot k
fn wgresolv i ulong k ulong to void
n = wdarg i
o = get wgan 0
if or eq n 0 ne get wdab 0 47
if not wdenv wgtpwd
wgdie wgtnopwd 2
end
for j ulong get wdvn 0
wgac ulong get wdv j
end
wgac 47
end
for j2 ulong n
wgac ulong get wdab j2
end
e = get wgan 0
wgnorm o e
end

note fold the absolute path [o, e) into a fresh slot k copy at the arena top (written by wgnorm)
fn wgnorm o ulong e ulong to void
r = get wgan 0
p = o
while lt p e bound 4096
while lt p e bound 4096
if ne get wga p 47
break
end
p = add p 1
end
if ge p e
break
end
q = p
while lt q e bound 4096
if eq get wga q 47
break
end
q = add q 1
end
wgncmp r p sub q p
p = q
end
if eq get wgan 0 r
wgac 47
end
put wgr 7 r
end

note one path component [p, p + sl): "." is dropped, ".." pops, others are appended
fn wgncmp r ulong p ulong sl ulong to void
if wgisdot p sl 1
ret
end
if wgisdot p sl 2
wgpop r
ret
end
wgac 47
wgacp p sl
end

note component is k dots
fn wgisdot p ulong sl ulong k ulong to bool
if ne sl k
ret false
end
for i ulong k
if ne get wga add p i 46
ret false
end
end
ret true
end

note drop the last component of the path at r
fn wgpop r ulong to void
t = get wgan 0
while gt t r bound 4096
t = sub t 1
if eq get wga t 47
break
end
end
put wgan 0 t
end

fn wgresk i ulong k ulong to void
wgresolv i k
r = get wgr 7
wgsetf k r
end

note OUT subdirectories
text wgtsfix "/fixtures"
text wgtsrcp "/receipts"
text wgtsres "/results"
text wgtsdat "/data"
text wgtsbld "/build"

fn wgmkd t view uchar * to void
wdpclr
wgpsl SOUT
wdpt t
wgmkp
end

fn wgmkout to void
wdpclr
wgpsl SOUT
wgmkp
wgmkd wgtsfix
wgmkd wgtsrcp
wgmkd wgtsres
wgmkd wgtsdat
wgmkd wgtsbld
wdpclr
wgpsl SOUT
wdpt wgtsfix
wgsetp SFIX
end

note decimal argument i (absent: d)
fn wgargn i ulong d ulong to ulong
if ge i ulong argcnt
ret d
end
n = wdarg i
v = ulong 0
if eq n 0
wgdie wgtuse 2
end
for j ulong n
c = ulong get wdab j
if not wgdig c
wgdie wgtuse 2
end
v = add mul v 10 sub c 48
end
if eq v 0
wgdie wgtuse 2
end
ret v
end

note ---------------------------------------------------------------- replay and dryrun

text wgtprobe "probe"
text wgtfirst "first"
text wgtjobs "jobs"
text wgtrply "replay"
text wgtREP "REPLAY mode="
text wgtrows " rows="
text wgtpas " pass="
text wgtrpas " recorded_pass="
text wgtmms " mismatches="

note kind argument i: 0 probe, 1 first, 2 jobs
fn wgkind i ulong to ulong
n = wdarg i
o = get wgan 0
for j ulong n
wgac ulong get wdab j
end
put wgan 0 o
if wgeqt o n wgtprobe
ret 0
end
if wgeqt o n wgtfirst
ret 1
end
if wgeqt o n wgtjobs
ret 2
end
wgdie wgtuse 2
ret 0
end

note recorded passes of wgrr[0..n)
fn wgrpass n ulong to ulong
c = ulong 0
for i ulong n
v = wgjget get wgrr i wgtpass
if ne v 0
if eq get wgjt v 3
c = add c 1
end
end
end
ret c
end

note replay or replaylog (lg) with the argument layout of wgtuse
fn wgreplay lg bool to int
kd = wgkind 2
put wgmd 2 kd
oi = ulong 5
if lg
oi = 7
end
if lt ulong argcnt add oi 1
wgdie wgtuse 2
end
wgresk oi SOUT
wgmkout
if lg
wgresk 5 SLOG
wgargs 6 SLAB
put wgmd 0 3
else
wgsett SLAB wgtrply
put wgmd 0 2
end
st = wgargn add oi 1 1
wdpclr
wdpa 3
dk = wgjfile
nd = wgjrows dk st
wdpclr
wdpa 4
rk = wgjfile
nr = wgjrec rk
if ne nd nr
wdoclr
wdot wgtcnt
wdod nd
wdoc 32
wdod nr
wdoc 10
wdoflush 1
ret 1
end
p = ulong 0
if eq kd 2
wgsset SJL wgso SLAB wgsn SLAB
wgjobs nd
wgsset SLAB wgso SJL wgsn SJL
wgjres nd
for i ulong nd
wgjcmp i
end
p = wgjpass nd
else
p = wgprobes nd
end
wdot wgtREP
if eq kd 0
wdot wgtprobe
end
if eq kd 1
wdot wgtfirst
end
if eq kd 2
wdot wgtjobs
end
wdot wgtrows
wdod nd
wdot wgtpas
wdod p
wdot wgtrpas
wdod wgrpass nr
wdot wgtmms
wdod get wgmis 0
wdoc 10
wdoflush 1
if gt get wgmis 0 0
ret 1
end
ret 0
end

text wgtdry "DRYRUN NOT_RUN "
text wgtdenc "encode argv: "
text wgtdsmp "sample argv: "
text wgtdgev "geval argv: "
text wgtdpr "prompts="
text wgtdbt " batches="
text wgtdby " batch0_bytes="
text wgtdsh " batch0_sha256="
text wgtdnw "DRYRUN nothing was executed or written\n"

note SHA-256 of arena [o, o + n) into wdd
fn wgsha o ulong n ulong to void
b = new uchar 65536 0
c = new uchar 104 0
d = new uchar 32 0
sha256_init c
t = ulong 0
while lt t n bound 999999
k = sub n t
if gt k 65536
k = 65536
end
for i ulong k
put b i get wga add o add t i
end
sha256_update c part b 0 k
t = add t k
end
sha256_final c d
for j ulong 32
put wdd j get d j
end
end

fn wgdline t view uchar * to void
wdot wgtdry
wdot t
o = get wgan 0
wgkargs
wgpra o sub get wgan 0 o
put wgan 0 o
wdoc 10
end

note dryrun probe|jobs CK OUTDIR LABEL DATA: print what live mode would run for batch 0, run nothing
fn wgdry to int
if ne ulong argcnt 7
wgdie wgtuse 2
end
kd = wgkind 2
if eq kd 1
kd = 0
end
wgresk 3 SCK
wgresk 4 SOUT
wdpclr
wdpa 6
dk = wgjfile
nd = wgjrows dk 1
o = get wgan 0
for j ulong wdarg 5
wgac ulong get wdab j
end
if eq kd 2
wgsetf SJL o
o2 = get wgan 0
wgasl SJL
wgat wgtturn
wgac 48
wgsetf SLAB o2
for i ulong nd
put wgjst i 1
put wgjsn i 0
put wgjon i 0
put wgpo i wgprm i
put wgpl i sub get wgan 0 get wgpo i
end
else
wgsetf SLAB o
for i2 ulong nd
wgjsget get wgdr i2 wgtprom
put wgpo i2 get wgr 3
put wgpl i2 get wgr 4
end
end
o3 = get wgan 0
wgasl SLAB
wgat wgtbat
wgac 48
wgsetf SBLD o3
cnt = nd
if gt cnt 128
cnt = 128
end
bo = get wgan 0
for q ulong cnt
wgacp get wgpo q get wgpl q
wgac 0
end
bn = sub get wgan 0 bo
wgsha bo bn
wgkenc
wgdline wgtdenc
wgksmp
wgdline wgtdsmp
wdot wgtdry
wdot wgtdpr
wdod nd
wdot wgtdbt
wdod div add nd 127 128
wdot wgtdby
wdod bn
wdot wgtdsh
wdohex
wdoc 10
wgkgev
wgdline wgtdgev
wdot wgtdnw
wdoflush 1
ret 0
end


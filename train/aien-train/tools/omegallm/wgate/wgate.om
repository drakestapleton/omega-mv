text wgtstok "/home/drakestapleton/handoffs/tool-omega-20261104/round40/data/story-final.tok"
text wgtbase "/home/drakestapleton/.local/share/omega-tool-model/round40/model.ck"
text wgtbsha "7c7b5b5260f2d9453b6076b64e7f23e88341d96498584f2dfaa229c31ad2e346"
text wgtnull "/dev/null"
text wgtnl "\n"
text wgtsp " "

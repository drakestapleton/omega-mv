text wgtmend "fn main to int\nret inc int "
text wgtend "\nend"

note checker.check(raw, row, label=slot SCB); compile_rc/run_rc into wgxr 0, 1
fn wgcheck ro ulong rn ulong row ulong to bool
put wgxr 0 WGABS
put wgxr 1 WGABS
wgtext ro rn
tx = get wgr 0
tn = get wgr 1
xe = wgjget row wgtxex
if eq xe 0
ret wgprior tx tn row
end
hp = wgjis row wgtkind wgthelp
if hp
if or ne wgcntt tx tn wgtfinc 1 ne wgcntt tx tn wgtfmain 1
ret false
end
if eq wgfindt tx tn wgtrinc WGNO
ret false
end
end
if wgjis row wgtkind wgtloop
if not wglines tx tn 2
ret false
end
end
ex = wgjint xe
so = ulong 0
sn = ulong 0
xs = wgjget row wgtxso
if ne xs 0
if ne get wgjt xs 5
wgdie wgtshp 79
end
so = get wgjo xs
sn = get wgjl xs
end
o = get wgan 0
wgasl SCB
wgsetf SCL o
ok = wgexec tx tn ex so sn
put wgxr 0 get wgx 0
put wgxr 1 get wgx 1
if and ok hp
ret wghelp tx tn row
end
ret ok
end

note the three additional inputs of a helper row (every one runs, as the list comprehension does)
fn wghelp tx ulong tn ulong row ulong to bool
inc = wgjint wgjget row wgtinc
k = wgfindt tx tn wgtfmain
alp = true
a = long 0
while le a 10 bound 4
po = get wgan 0
wgacp tx k
wgat wgtmend
wgadl a
wgat wgtend
pn = sub get wgan 0 po
o = get wgan 0
wgasl SCB
wgat wgtarg
wgadl a
wgsetf SCL o
if not wgexec po pn add a inc 0 0
alp = false
end
a = add a 5
end
ret alp
end


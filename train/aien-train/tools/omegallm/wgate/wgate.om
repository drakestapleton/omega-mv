text wgtrcp "receipts/"
text wgtdom ".om"
text wgtomo "omc.out"
text wgtome "omc.err"
text wgtrun "run.out"

note rename OUT/build/f to the path in slot SPL and chmod it 0700
fn wgplace f view uchar * to void
wdkclr
wgpout wgtbld
wdpt f
wdkp
wdpclr
wgpsl SPL
wdkp
wdrename
wdpclr
wgpsl SPL
r = chmod wdp 0 get wdpn 0 448
if ne r 0
wgdiep wgtfile 71
end
end

note checker.execute(text, expected, stdout, label=slot SCL); compile_rc and run_rc into wgx 0, 1
fn wgexec o ulong n ulong ex long so ulong sn ulong to bool
put wgx 0 WGABS
put wgx 1 WGABS
if eq n 0
ret false
end
if not wglines o n 0
ret false
end
wgpout wgtrcp
wgpsl SCL
wdpt wgtdom
fd = wgcreat false
wgwr fd o n
wgwrt fd wgtnl
c = fclose fd
wgpout wgtrcp
wgpsl SCL
wdpt wgtdom
wgsetp SPL
r = wgomcp
if eq r WGTMO
ret false
end
if ne r 0
put wgx 0 r
ret false
end
wgpout wgtbld
wgpsl SCL
wgsetp SPL
wgplace wgtomo
q = wgrunx wgtrun
if eq q WGTMO
ret false
end
put wgx 0 0
put wgx 1 q
wgbload wgtrun
wgasc get wgr 5 get wgr 6
if ne q ex
ret false
end
ret wgeq2 get wgr 5 get wgr 6 so sn
end

note omc with stdin from the file in slot SPL, stdout OUT/build/omc.out, stderr OUT/build/omc.err
fn wgomcp to long
wdpclr
wgpsl SPL
fi = wgopen
wgpout wgtbld
wdpt wgtomo
fo = wgcreat false
wgpout wgtbld
wdpt wgtome
fe = wgcreat false
wdkclr
wdkt wgtomc
pid = wgspawn fi fo fe WGNO
r = wgreap pid 10000000000
c1 = fclose fi
c2 = fclose fo
c3 = fclose fe
ret r
end

text wgtxex "expected_exit"
text wgtxso "expected_stdout"
text wgtkind "kind"
text wgthelp "helper"
text wgtloop "loop"
text wgtinc "increment"
text wgtans "answer"
text wgtfinc "fn inc x int to int"
text wgtfmain "fn main to int"
text wgtrinc "ret inc int "

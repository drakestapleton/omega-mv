text wgtcsm "wgate: OUTDIR belongs to another candidate\n"
text wgtzero "wgate: latency base time is zero\n"
text wgtsw "SPARK_WINDOW"
text wgtbud "WSP_BUDGET"
text wgtbudb "wgate: WSP_BUDGET is not a decimal number\n"
text wgtdiv "wgate: replay has no recorded answer for this turn\n"

note ---------------------------------------------------------------- basics

fn wgdie t view uchar * c int to void
wdoflush 1
w = write 2 t 0 len t
exit c
end

fn wgdiep t view uchar * c int to void
wdoflush 1
w = write 2 t 0 len t
w2 = write 2 wdp 0 get wdpn 0
w3 = write 2 wgtnl 0 1
exit c
end

fn wgac c ulong to void
n = get wgan 0
if ge n WGMAXA
wgdie wgtfull 61
end
put wga n uchar c
put wgan 0 add n 1
end

fn wgat t view uchar * to void
for i ulong len t
wgac ulong get t i
end
end

fn wgacp o ulong n ulong to void
i = ulong 0
while lt i n bound 64
while lt i n bound 999999
wgac ulong get wga add o i
i = add i 1
end
end
end

fn wgad v ulong to void
k = wddec v
while gt k 0 bound 25
k = sub k 1
wgac ulong get wdt k
end
end

fn wgadl v long to void
if lt v 0
wgac 45
wgad ulong neg v
else
wgad ulong v
end
end

fn wgsset k ulong o ulong n ulong to void
put wgsl mul k 2 o
put wgsl add mul k 2 1 n
end

fn wgso k ulong to ulong
ret get wgsl mul k 2
end

fn wgsn k ulong to ulong
ret get wgsl add mul k 2 1
end

note append slot k to the arena
fn wgasl k ulong to void
wgacp wgso k wgsn k
end

note slot k = text t
fn wgsett k ulong t view uchar * to void
o = get wgan 0
wgat t
wgsset k o len t
end

note slot k = the path builder's bytes
fn wgsetp k ulong to void
o = get wgan 0
for i ulong get wdpn 0
wgac ulong get wdp i
end
wgsset k o get wdpn 0
end

note slot k = the arena from offset o to the top
fn wgsetf k ulong o ulong to void
wgsset k o sub get wgan 0 o
end

fn wgeqa a ulong b ulong n ulong to bool
i = ulong 0
while lt i n bound 999999
if ne get wga add a i get wga add b i
ret false
end
i = add i 1
end
ret true
end

fn wgeq2 a ulong an ulong b ulong bn ulong to bool
if ne an bn
ret false
end
ret wgeqa a b an
end

fn wgeqt o ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n
if ne get wga add o i get t i
ret false
end
end
ret true
end

fn wgsw o ulong n ulong t view uchar * to bool
if lt n len t
ret false
end
for i ulong len t
if ne get wga add o i get t i
ret false
end
end
ret true
end

note first index (relative) of arena pattern p in [o, o + n), or WGNO
fn wgfind o ulong n ulong p ulong pn ulong to ulong
if gt pn n
ret WGNO
end
lim = sub n pn
i = ulong 0
while le i lim bound 999999
if wgeqa add o i p pn
ret i
end
i = add i 1
end
ret WGNO
end

note as wgfind with a text pattern
fn wgfindt o ulong n ulong t view uchar * to ulong
pn = len t
if gt pn n
ret WGNO
end
lim = sub n pn
i = ulong 0
while le i lim bound 999999
if wgsw add o i sub n i t
ret i
end
i = add i 1
end
ret WGNO
end

note non-overlapping occurrences of arena pattern p (pn > 0), as str.count
fn wgcnt o ulong n ulong p ulong pn ulong to ulong
c = ulong 0
i = ulong 0
while le add i pn n bound 999999
if wgeqa add o i p pn
c = add c 1
i = add i pn
else
i = add i 1
end
end
ret c
end

fn wgcntt o ulong n ulong t view uchar * to ulong
c = ulong 0
i = ulong 0
pn = len t
while le add i pn n bound 999999
if wgsw add o i sub n i t
c = add c 1
i = add i pn
else
i = add i 1
end
end
ret c
end

note ---------------------------------------------------------------- results buffer (wgob to fd wgobf)

fn wgofl to void
n = get wgobn 0
t = ulong 0
while lt t n bound 999999
w = write get wgobf 0 wgob t sub n t
if le w 0
wgdie wgthost 70
end
t = add t ulong w
end
put wgobn 0 0
end

fn wgoc c ulong to void
n = get wgobn 0
if ge n 65536
wgofl
n = 0
end
put wgob n uchar c
put wgobn 0 add n 1
end

fn wgot t view uchar * to void
for i ulong len t
wgoc ulong get t i
end
end

fn wgoa o ulong n ulong to void
i = ulong 0
while lt i n bound 999999
wgoc ulong get wga add o i
i = add i 1
end
end

fn wgod v ulong to void
k = wddec v
while gt k 0 bound 25
k = sub k 1
wgoc ulong get wdt k
end
end

fn wgodl v long to void
if lt v 0
wgoc 45
wgod ulong neg v
else
wgod ulong v
end
end

note stdout helpers over wdo: arena range and signed decimal
fn wgpra o ulong n ulong to void
i = ulong 0
while lt i n bound 999999
wdoc ulong get wga add o i
i = add i 1
end
end

fn wgprl v long to void
if lt v 0
wdoc 45
wdod ulong neg v
else
wdod ulong v
end
end

note ---------------------------------------------------------------- text (model output is ASCII; wgasc refuses the rest)

note exit 72 unless every byte of [o, o + n) is ASCII
fn wgasc o ulong n ulong to void
i = ulong 0
while lt i n bound 64
while lt i n bound 999999
if gt get wga add o i 127
wgdie wgtdec 72
end
i = add i 1
end
end
end

note str.isspace on ASCII: 9..13 and 28..32
fn wgisws c ulong to bool
if and ge c 9 le c 13
ret true
end
ret and ge c 28 le c 32
end

note str.strip(): result in wgr 0, wgr 1
fn wgstrip o ulong n ulong to void
a = o
e = add o n
while lt a e bound 999999
if not wgisws ulong get wga a
break
end
a = add a 1
end
while gt e a bound 999999
if not wgisws ulong get wga sub e 1
break
end
e = sub e 1
end
put wgr 0 a
put wgr 1 sub e a
end

note text(raw) = raw.split('\nDone.')[0].strip(): result in wgr 0, wgr 1
text wgtdone "\nDone."
fn wgtext o ulong n ulong to void
k = wgfindt o n wgtdone
m = n
if ne k WGNO
m = k
end
wgstrip o m
end

note str.splitlines on ASCII: the line [p, result) ends at \n \r \r\n \v \f \x1c \x1d \x1e; next start in wgr 2
fn wgeol p ulong e ulong to ulong
q = p
while lt q e bound 999999
c = get wga q
if or or eq c 10 eq c 11 or eq c 12 eq c 28
put wgr 2 add q 1
ret q
end
if or eq c 29 eq c 30
put wgr 2 add q 1
ret q
end
if eq c 13
put wgr 2 add q 1
if lt add q 1 e
if eq get wga add q 1 10
put wgr 2 add q 2
end
end
ret q
end
q = add q 1
end
put wgr 2 e
ret e
end

fn wgdig c ulong to bool
ret and ge c 48 le c 57
end

note re.fullmatch of one line against a pattern in the wgate mini-language:
note @ = \d{1,3}, % = \d{1,2}, ^ = [1-5], ~ = [1-6], $ = [A-Za-z0-9 ]{0,80}. No literal of the
note patterns is a digit or a class member right after a run, so the greedy run is the regex result.
fn wgmatch o ulong n ulong t view uchar * to bool
i = ulong 0
j = ulong 0
while lt j len t bound 4096
pc = ulong get t j
j = add j 1
if or eq pc 64 eq pc 37
k = ulong 0
while lt add i k n bound 4096
if not wgdig ulong get wga add o add i k
break
end
k = add k 1
end
mx = ulong 3
if eq pc 37
mx = 2
end
if or eq k 0 gt k mx
ret false
end
i = add i k
continue
end
if or eq pc 94 eq pc 126
if ge i n
ret false
end
c = ulong get wga add o i
hi = ulong 53
if eq pc 126
hi = 54
end
if or lt c 49 gt c hi
ret false
end
i = add i 1
continue
end
if eq pc 36
k2 = ulong 0
while lt add i k2 n bound 4096
if not wgcls ulong get wga add o add i k2
break
end
k2 = add k2 1
end
if gt k2 80
ret false
end
i = add i k2
continue
end
if ge i n
ret false
end
if ne ulong get wga add o i pc
ret false
end
i = add i 1
end
ret eq i n
end

fn wgcls c ulong to bool
if wgdig c
ret true
end
if eq c 32
ret true
end
if and ge c 65 le c 90
ret true
end
ret and ge c 97 le c 122
end

note checker.patterns (check_behavior.safe_lines + checker additions)
text wgc00 "fn main to int"
text wgc01 "end"
text wgc02 "else"
text wgc03 "ret @"
text wgc04 "ret int @"
text wgc05 "ret add int @ int @"
text wgc06 "if gt int @ int @"
text wgc07 "text msg \"$\\n\""
text wgc08 "n = write int 1 msg ulong 0 len msg"
text wgc09 "if ne n long len msg"
text wgc10 "fn inc x int to int"
text wgc11 "ret add x int %"
text wgc12 "ret inc int %"
text wgc13 "s = int %"
text wgc14 "for i ulong ^"
text wgc15 "s = add s int ^"
text wgc16 "ret s"

fn wgckl o ulong n ulong to bool
if or or wgmatch o n wgc00 wgmatch o n wgc01 or wgmatch o n wgc02 wgmatch o n wgc03
ret true
end
if or or wgmatch o n wgc04 wgmatch o n wgc05 or wgmatch o n wgc06 wgmatch o n wgc07
ret true
end
if or or wgmatch o n wgc08 wgmatch o n wgc09 or wgmatch o n wgc10 wgmatch o n wgc11
ret true
end
if or or wgmatch o n wgc12 wgmatch o n wgc13 or wgmatch o n wgc14 wgmatch o n wgc15
ret true
end
ret wgmatch o n wgc16
end

note repair.PATTERNS
text wgr00 "fn calc x int to int"
text wgr01 "ret add x int ~"
text wgr02 "ret mul x int ~"
text wgr03 "ret sub x int ~"
text wgr04 "ret calc int %"
text wgr05 "s = x"
text wgr06 "for i ulong ~"
text wgr07 "s = add s int ~"

fn wgrpl o ulong n ulong to bool
if or or wgmatch o n wgr00 wgmatch o n wgc00 or wgmatch o n wgc01 wgmatch o n wgr01
ret true
end
if or or wgmatch o n wgr02 wgmatch o n wgr03 or wgmatch o n wgr04 wgmatch o n wgr05
ret true
end
if or or wgmatch o n wgr06 wgmatch o n wgr07 wgmatch o n wgc16
ret true
end
ret false
end

note every line of text.splitlines() matches: mode 0 checker, 1 repair, 2 the for-loop line only (any)
fn wglines o ulong n ulong md ulong to bool
p = o
e = add o n
hit = false
while lt p e bound 999999
q = wgeol p e
ln = sub q p
nx = get wgr 2
if eq md 2
if wgmatch p ln wgc14
hit = true
end
else
ok = false
if eq md 0
ok = wgckl p ln
else
ok = wgrpl p ln
end
if not ok
ret false
end
end
p = nx
end
if eq md 2
ret hit
end
ret true
end

note ---------------------------------------------------------------- JSON (CPython 3.12 json.loads on the subset wgate meets)
note Node kinds in wgjt: 1 null, 2 false, 3 true, 4 number, 5 string, 6 array, 7 object. A string's
note decoded bytes are (wgjo, wgjl) in the arena; a number keeps its source text there. Containers:
note first child wgjc, next sibling wgjs, count wgjo. Object children alternate key, value.
note Refused (exit 79): \u escapes naming surrogates, NaN, Infinity, nesting deeper than 512.
note A malformed text gives WGNO (the ValueError of json.loads).

fn wgjnew t ulong o ulong n ulong to ulong
k = get wgjn 0
if ge k WGMAXJ
wgdie wgtfull 61
end
put wgjt k uchar t
put wgjo k o
put wgjl k n
put wgjc k 0
put wgjs k 0
put wgjn 0 add k 1
ret k
end

fn wgjws p ulong e ulong to ulong
q = p
while lt q e bound 999999
c = get wga q
if and and ne c 32 ne c 9 and ne c 10 ne c 13
ret q
end
q = add q 1
end
ret q
end

fn wghex4 p ulong to ulong
v = ulong 0
for i ulong 4
c = ulong get wga add p i
d = WGNO
if and ge c 48 le c 57
d = sub c 48
end
if and ge c 97 le c 102
d = sub c 87
end
if and ge c 65 le c 70
d = sub c 55
end
if eq d WGNO
ret WGNO
end
v = or shl v 4 d
end
ret v
end

fn wgenc v ulong to void
if lt v 128
wgac v
ret
end
if lt v 2048
wgac or 192 shr v 6
wgac or 128 and v 63
ret
end
wgac or 224 shr v 12
wgac or 128 and shr v 6 63
wgac or 128 and v 63
end

note one escape; q is the byte after the backslash. New position or WGNO.
fn wgjesc q ulong e ulong to ulong
if ge q e
ret WGNO
end
d = ulong get wga q
if ne d 117
c = ulong 0
if or or eq d 34 eq d 92 eq d 47
c = d
end
if eq d 98
c = 8
end
if eq d 102
c = 12
end
if eq d 110
c = 10
end
if eq d 114
c = 13
end
if eq d 116
c = 9
end
if eq c 0
ret WGNO
end
wgac c
ret add q 1
end
h = add q 1
if ge add h 4 e
ret WGNO
end
v = wghex4 h
if eq v WGNO
ret WGNO
end
if and ge v 55296 le v 57343
wgdie wgtshp 79
end
wgenc v
ret add h 4
end

note string body from p (after the quote); decoded into the arena top (wgr 3, wgr 4); returns the index after the closing quote
fn wgjstr p ulong e ulong to ulong
o = get wgan 0
q = p
while lt q e bound 999999
c = ulong get wga q
if eq c 34
put wgr 3 o
put wgr 4 sub get wgan 0 o
ret add q 1
end
if lt c 32
ret WGNO
end
if eq c 92
q = wgjesc add q 1 e
if eq q WGNO
ret WGNO
end
else
wgac c
q = add q 1
end
end
ret WGNO
end

fn wgdgs i ulong e ulong to ulong
q = i
while lt q e bound 999999
if not wgdig ulong get wga q
ret q
end
q = add q 1
end
ret q
end

note _match_number_unicode: returns the end index or WGNO
fn wgjnum p ulong e ulong to ulong
ed = sub e 1
i = p
if eq get wga i 45
i = add i 1
if gt i ed
ret WGNO
end
end
c = ulong get wga i
if and ge c 49 le c 57
i = wgdgs add i 1 e
else
if ne c 48
ret WGNO
end
i = add i 1
end
nd = sub i p
if eq get wga p 45
nd = sub nd 1
end
isf = false
if lt i ed
if eq get wga i 46
if wgdig ulong get wga add i 1
isf = true
i = wgdgs add i 2 e
end
end
end
if lt i ed
c3 = get wga i
if or eq c3 101 eq c3 69
es = i
i = add i 1
if lt i ed
c4 = get wga i
if or eq c4 45 eq c4 43
i = add i 1
end
end
i = wgdgs i e
if wgdig ulong get wga sub i 1
isf = true
else
i = es
end
end
end
if not isf
if gt nd 4300
ret WGNO
end
end
ret i
end

note literal t at p (all of its bytes must exist)
fn wglit p ulong e ulong t view uchar * to bool
if gt add p len t e
ret false
end
ret wgsw p sub e p t
end

note attach node k to the open container (or make it the root)
fn wgjatt k ulong to void
d = get wgps 2
if eq d 0
put wgps 3 k
ret
end
top = get wgks sub d 1
last = get wgkl sub d 1
if eq last 0
put wgjc top k
else
put wgjs last k
end
put wgkl sub d 1 k
put wgjo top add get wgjo top 1
end

text wgtnul "null"
text wgttru "true"
text wgtfal "false"

note scalar value at p: returns the index after it or WGNO
fn wgjscal p ulong e ulong to ulong
c = get wga p
if eq c 34
q = wgjstr add p 1 e
if ne q WGNO
wgjatt wgjnew 5 get wgr 3 get wgr 4
end
ret q
end
if eq c 110
if wglit p e wgtnul
wgjatt wgjnew 1 0 0
ret add p 4
end
end
if eq c 116
if wglit p e wgttru
wgjatt wgjnew 3 0 0
ret add p 4
end
end
if eq c 102
if wglit p e wgtfal
wgjatt wgjnew 2 0 0
ret add p 5
end
end
if or eq c 78 eq c 73
wgdie wgtshp 79
end
q2 = wgjnum p e
if ne q2 WGNO
wgjatt wgjnew 4 p sub q2 p
end
ret q2
end

note state 0: a value is expected at wgps 0. Returns 0 go on (state in wgps 4), 2 error
fn wgjval to ulong
p = get wgps 0
e = get wgps 1
if ge p e
ret 2
end
c = get wga p
if or eq c 123 eq c 91
d = get wgps 2
if ge d 512
wgdie wgtrec 77
end
kd = ulong 6
cl = uchar 93
if eq c 123
kd = 7
cl = 125
end
k = wgjnew kd 0 0
wgjatt k
put wgks d k
put wgkl d 0
put wgps 2 add d 1
p = wgjws add p 1 e
put wgps 0 p
if lt p e
if eq get wga p cl
put wgps 0 add p 1
put wgps 2 d
put wgps 4 1
ret 0
end
end
put wgps 4 0
if eq kd 7
put wgps 4 2
end
ret 0
end
q = wgjscal p e
if eq q WGNO
ret 2
end
put wgps 0 q
put wgps 4 1
ret 0
end

note state 1: after a value. Returns 0 go on, 1 done, 2 error
fn wgjaft to ulong
e = get wgps 1
p = wgjws get wgps 0 e
d = get wgps 2
if eq d 0
if ne p e
ret 2
end
ret 1
end
top = get wgks sub d 1
cl = uchar 93
if eq get wgjt top 7
cl = 125
end
if ge p e
ret 2
end
c = get wga p
if eq c cl
put wgps 0 add p 1
put wgps 2 sub d 1
ret 0
end
if ne c 44
ret 2
end
put wgps 0 wgjws add p 1 e
put wgps 4 0
if eq cl 125
put wgps 4 2
end
ret 0
end

note state 2: an object key is expected. Returns 0 go on, 2 error
fn wgjkey to ulong
p = get wgps 0
e = get wgps 1
if ge p e
ret 2
end
if ne get wga p 34
ret 2
end
q = wgjstr add p 1 e
if eq q WGNO
ret 2
end
wgjatt wgjnew 5 get wgr 3 get wgr 4
q = wgjws q e
if ge q e
ret 2
end
if ne get wga q 58
ret 2
end
put wgps 0 wgjws add q 1 e
put wgps 4 0
ret 0
end

note json.loads of [o, o + n): the root node, or WGNO
fn wgbom o ulong n ulong to bool
if lt n 3
ret false
end
if ne get wga o 239
ret false
end
if ne get wga add o 1 187
ret false
end
ret eq get wga add o 2 191
end

fn wgjparse o ulong n ulong to ulong
e = add o n
if wgbom o n
ret WGNO
end
put wgps 0 wgjws o e
put wgps 1 e
put wgps 2 0
put wgps 3 0
put wgps 4 0
while true bound 64
while true bound 999999
st = get wgps 4
r = ulong 0
if eq st 0
r = wgjval
else
if eq st 1
r = wgjaft
else
r = wgjkey
end
end
if eq r 2
ret WGNO
end
if eq r 1
ret get wgps 3
end
end
end
ret WGNO
end

note load the file named by wdp into the arena and parse it; exit 80 when it is not JSON
fn wgjfile to ulong
o = wgload
k = wgjparse o sub get wgan 0 o
if eq k WGNO
wgdiep wgtnoj 80
end
ret k
end

note last value under key t in object k, or 0
fn wgjget k ulong t view uchar * to ulong
c = get wgjc k
r = ulong 0
while ne c 0 bound 999999
v = get wgjs c
if wgeqt get wgjo c get wgjl c t
r = v
end
c = get wgjs v
end
ret r
end

note last value under the arena key (o, n), or 0
fn wgjgeta k ulong o ulong n ulong to ulong
c = get wgjc k
r = ulong 0
while ne c 0 bound 999999
v = get wgjs c
if wgeq2 get wgjo c get wgjl c o n
r = v
end
c = get wgjs v
end
ret r
end

note an integer number node as long (exit 79 for any other node)
fn wgjint k ulong to long
if ne get wgjt k 4
wgdie wgtshp 79
end
o = get wgjo k
n = get wgjl k
ng = false
i = ulong 0
if eq get wga o 45
ng = true
i = 1
end
v = long 0
if gt sub n i 15
wgdie wgtshp 79
end
while lt i n bound 32
c = ulong get wga add o i
if not wgdig c
wgdie wgtshp 79
end
v = add mul v 10 long sub c 48
i = add i 1
end
if ng
ret neg v
end
ret v
end

note the string under key t of object k: (wgr 3, wgr 4); exit 79 when absent or not a string
fn wgjsget k ulong t view uchar * to void
v = wgjget k t
if eq v 0
wgdie wgtshp 79
end
if ne get wgjt v 5
wgdie wgtshp 79
end
put wgr 3 get wgjo v
put wgr 4 get wgjl v
end

note does the string under key t of object k equal text u (absent or non-string: false)
fn wgjis k ulong t view uchar * u view uchar * to bool
v = wgjget k t
if eq v 0
ret false
end
if ne get wgjt v 5
ret false
end
ret wgeqt get wgjo v get wgjl v u
end

note number of distinct keys of object k
fn wgjnkey k ulong to ulong
c = get wgjc k
r = ulong 0
while ne c 0 bound 999999
v = get wgjs c
if eq wgjgeta k get wgjo c get wgjl c v
r = add r 1
end
c = get wgjs v
end
ret r
end

note exit 79 unless k is an object whose values are all strings (the expected answers)
fn wgjflat k ulong to void
if ne get wgjt k 7
wgdie wgtshp 79
end
c = get wgjc k
while ne c 0 bound 999999
v = get wgjs c
if ne get wgjt v 5
wgdie wgtshp 79
end
c = get wgjs v
end
end

note text of nodes a and b equal
fn wgjeqn a ulong b ulong to bool
ao = get wgjo a
an = get wgjl a
ret wgeq2 ao an get wgjo b get wgjl b
end

note Python ==: model value d against flat expected object x
fn wgjeqx d ulong x ulong to bool
if ne get wgjt d 7
ret false
end
if ne wgjnkey d wgjnkey x
ret false
end
c = get wgjc x
while ne c 0 bound 999999
xv = wgjgeta x get wgjo c get wgjl c
dv = wgjgeta d get wgjo c get wgjl c
if eq dv 0
ret false
end
if ne get wgjt dv 5
ret false
end
if not wgjeqn dv xv
ret false
end
c = get wgjs get wgjs c
end
ret true
end

note array k into wgdr (data rows) with a stride; returns the count
fn wgjrows k ulong st ulong to ulong
if ne get wgjt k 6
wgdie wgtshp 79
end
c = get wgjc k
i = ulong 0
m = ulong 0
while ne c 0 bound 999999
if eq rem i st 0
if ge m 1024
wgdie wgtfull 61
end
put wgdr m c
m = add m 1
end
i = add i 1
c = get wgjs c
end
ret m
end

note array k into wgrr (recorded rows); returns the count
fn wgjrec k ulong to ulong
if ne get wgjt k 6
wgdie wgtshp 79
end
c = get wgjc k
m = ulong 0
while ne c 0 bound 999999
if ge m 1024
wgdie wgtfull 61
end
put wgrr m c
m = add m 1
c = get wgjs c
end
ret m
end

note element i of array k, or 0
fn wgjat k ulong i ulong to ulong
c = get wgjc k
j = ulong 0
while ne c 0 bound 999999
if eq j i
ret c
end
j = add j 1
c = get wgjs c
end
ret 0
end

note ---------------------------------------------------------------- paths, files, processes

note append slot k / arena range / OUT/t to the path builder
fn wgpsl k ulong to void
o = wgso k
n = wgsn k
for j ulong n
wdpc ulong get wga add o j
end
end

fn wgpar o ulong n ulong to void
for j ulong n
wdpc ulong get wga add o j
end
end

fn wgpout t view uchar * to void
wdpclr
wgpsl SOUT
wdpc 47
wdpt t
end

note the whole file named by wdp onto the arena top; returns its offset (exit 71 when unreadable)
fn wgload to ulong
fd = wdopen 0 0
if lt fd 0
wgdiep wgtfile 71
end
o = get wgan 0
fin = false
while not fin bound 999999
t = get wgan 0
if ge t WGMAXA
wgdie wgtfull 61
end
r = read fd wga t sub WGMAXA t
if lt r 0
wgdiep wgtfile 71
end
if eq r 0
fin = true
else
put wgan 0 add t ulong r
end
end
c = fclose fd
ret o
end

fn wgwr fd int o ulong n ulong to void
t = ulong 0
while lt t n bound 999999
w = write fd wga add o t sub n t
if le w 0
wgdie wgthost 70
end
t = add t ulong w
end
end

fn wgwrt fd int t view uchar * to void
w = write fd t 0 len t
if ne w long len t
wgdie wgthost 70
end
end

note open wdp for writing: truncate (ap false) or append (ap true); exit 71 on failure
fn wgcreat ap bool to int
fl = int 577
if ap
fl = 1089
end
fd = wdopen fl 438
if lt fd 0
wgdiep wgtfile 71
end
ret fd
end

note write [o, o + n) to the file wdp (Path.write_text / write_bytes)
fn wgwfile o ulong n ulong to void
fd = wgcreat false
wgwr fd o n
c = fclose fd
end

fn wgisdir to bool
r = stat wdp 0 get wdpn 0 wgsb 0 128
if ne r 0
ret false
end
m = or ulong get wgsb 16 shl ulong get wgsb 17 8
ret eq and m 61440 16384
end

fn wgexist to bool
r = stat wdp 0 get wdpn 0 wgsb 0 128
ret eq r 0
end

note mkdir of the first n bytes of wdp, exist_ok
fn wgmk1 n ulong to void
r = makedir wdp 0 n 511
if eq r 0
ret
end
if ne r -17
wgdiep wgtfile 71
end
s = stat wdp 0 n wgsb 0 128
if ne s 0
wgdiep wgtfile 71
end
m = or ulong get wgsb 16 shl ulong get wgsb 17 8
if ne and m 61440 16384
wgdiep wgtfile 71
end
end

note mkdir -p of the whole path builder (parents=True, exist_ok=True)
fn wgmkp to void
n = get wdpn 0
i = ulong 1
while lt i n bound 4096
if eq get wdp i 47
wgmk1 i
end
i = add i 1
end
if gt n 0
wgmk1 n
end
end

note fork; the child changes to slot cw (WGNO: stay), takes fi/fo/fe as 0/1/2 when not negative and
note runs the packed list wdk with an empty environment. Returns the pid.
fn wgspawn fi int fo int fe int cw ulong to long
pn = wdkfin
pid = fork
if lt pid 0
wgdie wgthost 70
end
if eq pid 0
if ne cw WGNO
o = wgso cw
r = chdir wga o wgsn cw
if ne r 0
exit 127
end
end
if ge fi 0
d0 = dupfd fi 0 0
end
if ge fo 0
d1 = dupfd fo 1 0
end
if ge fe 0
d2 = dupfd fe 2 0
end
x = execprog wdk 0 pn
exit 127
end
ret pid
end

fn wgstat to long
s = or ulong get wdst 0 shl ulong get wdst 1 8
if eq and s 127 0
ret long and shr s 8 255
end
ret neg long and s 127
end

note wait for pid at most ns nanoseconds: its returncode (minus the signal), or WGTMO after a kill
fn wgreap pid long ns long to long
dl = add monons ns
while true bound 999
while true bound 999999
r = waitpid int pid wdst 0 4 1
if eq r pid
ret wgstat
end
if eq r 0
if gt monons dl
k = killpid int pid 9
r2 = waitpid int pid wdst 0 4 0
while eq r2 -4 bound 1000
r2 = waitpid int pid wdst 0 4 0
end
ret WGTMO
end
z = sleepns 200000
else
if ne r -4
wgdie wgthost 70
end
end
end
end
ret WGTMO
end

fn wgopen to int
fd = wdopen 0 0
if lt fd 0
wgdiep wgtfile 71
end
ret fd
end

fn wgdevn to int
wdpclr
wdpt wgtnull
fd = wdopen 1 0
if lt fd 0
wgdiep wgtfile 71
end
ret fd
end

note omc with stdin from file OUT/build/si, stdout to OUT/build/so, stderr to OUT/build/se (fresh
note files); 10 s. Returns the returncode or WGTMO.
text wgtbld "build/"
fn wgomc si view uchar * so view uchar * se view uchar * to long
wgpout wgtbld
wdpt si
fi = wgopen
wgpout wgtbld
wdpt so
fo = wgcreat false
wgpout wgtbld
wdpt se
fe = wgcreat false
wdkclr
wdkt wgtomc
pid = wgspawn fi fo fe WGNO
r = wgreap pid 10000000000
c1 = fclose fi
c2 = fclose fo
c3 = fclose fe
ret r
end

note load OUT/build/t onto the arena: offset in wgr 5, length in wgr 6
fn wgbload t view uchar * to void
wgpout wgtbld
wdpt t
o = wgload
put wgr 5 o
put wgr 6 sub get wgan 0 o
end

note run the program named by slot SPL in OUT/fixtures, stdout to OUT/build/t, stderr /dev/null, 2 s
fn wgrunx t view uchar * to long
fe = wgdevn
wgpout wgtbld
wdpt t
fo = wgcreat false
wdkclr
wdpclr
wgpsl SPL
wdkp
pid = wgspawn -1 fo fe SFIX
r = wgreap pid 2000000000
c1 = fclose fo
c2 = fclose fe
ret r
end


text wgtlist "list"
text wgtchk "check"

note check_behavior.check for rows without expected_exit
fn wgprior tx ulong tn ulong row ulong to bool
if or or wgjis row wgtkind wgtread wgjis row wgtkind wgtlist wgjis row wgtkind wgtchk
ret wgdisp tx tn row
end
wgjsget row wgtans
ret wgeq2 tx tn get wgr 3 get wgr 4
end

text wgttool "tool"
text wgtpath "path"
text wgtrdf "read_file"
text wgtlsf "list_files"

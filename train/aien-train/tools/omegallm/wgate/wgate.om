text wgtonev "one"
text wgtprog "fn main to int\nret 0\nend\n"
text wgtfix "fixtures"

note check_behavior.dispatch, including its fixture side effects
fn wgdisp tx ulong tn ulong row ulong to bool
mk = get wgjn 0
d = wgjparse tx tn
if eq d WGNO
ret false
end
wgjsget row wgtans
x = wgjparse get wgr 3 get wgr 4
if eq x WGNO
wgdie wgtnoj 80
end
wgjflat x
if not wgjeqx d x
put wgjn 0 mk
ret false
end
wgjsget x wgtpath
po = get wgr 3
pn = get wgr 4
wdpclr
if or eq pn 0 ne get wga po 47
wgpsl SOUT
wdpc 47
wdpt wgtfix
wdpc 47
end
wgpar po pn
wgsetp SPL
sl = WGNO
i = ulong 0
while lt i get wdpn 0 bound 4096
if eq get wdp i 47
sl = i
end
i = add i 1
end
if ne sl WGNO
put wdpn 0 sl
wgmkp
end
if wgjis x wgttool wgtrdf
wdpclr
wgpsl SPL
fd = wgcreat false
wgwrt fd wgtfixc
c = fclose fd
o = wgload
put wgjn 0 mk
ret true
end
if wgjis x wgttool wgtlsf
wdpclr
wgpsl SPL
wgmk1 get wdpn 0
wdpt wgtone
fd2 = wgcreat false
wgwrt fd2 wgtonev
c2 = fclose fd2
put wgjn 0 mk
ret true
end
if wgjis x wgttool wgtomck
wdpclr
wgpsl SPL
fd3 = wgcreat false
wgwrt fd3 wgtprog
c3 = fclose fd3
r = wgomcp
if eq r WGTMO
wgdie wgtcmdt 74
end
if ne r 0
wgdie wgtcmdf 73
end
put wgjn 0 mk
ret true
end
wgdie wgtshp 79
ret false
end

note repair.check_answer
fn wgfirst ro ulong rn ulong row ulong to bool
wgtext ro rn
tx = get wgr 0
tn = get wgr 1
mk = get wgjn 0
wgjsget row wgtans
ao = get wgr 3
an = get wgr 4
d = wgjparse tx tn
if eq d WGNO
ret wgeq2 tx tn ao an
end
x = wgjparse ao an
if eq x WGNO
ret wgeq2 tx tn ao an
end
wgjflat x
r = wgjeqx d x
put wgjn 0 mk
ret r
end

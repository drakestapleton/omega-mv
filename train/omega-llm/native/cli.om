note SPDX-License-Identifier: AGPL-3.0-only
note omegallm cli.om (aien-train#52): the ollm commands (CONTRACT section 7). The platform unit
note (lio.om or eio.om) follows it and holds main.
note Command words are matched as little-endian u64 packings of their bytes (Wolfram
note FromDigits[Reverse[ToCharacterCode[w]],256]): prep 1885696624, init 1953066601,
note grad 1684107879, train 474214396532, eval 1818326629, base 1702060386, sample 111516417089907,
note gcheck 118074647274343, mathck 118074698391917, adamck 118074781033569; v1: bpefit
note 127996038312034, bpeenc 109325798699106, bpedec 109287127216226 (bpe.om); serve 435778905459
note (serve.om on aarch64, noserve.om elsewhere). Fine-tune: tune 1701737844.
note Exit codes: 0 ok; 2 usage; 10-15 checkpoint refusals (ckpt.om); 17 a looped checkpoint given
note to a command that does not run loops (grow and the specialist commands; init, train, eval,
note sample, grad, gcheck, tune, kvcmp, serve and the GB10 commands run them); 20 data file shorter than
note T + 1 bytes; 21 data over 2^25 bytes or OFFS not exactly 8 B bytes; 22 an OFFS offset with
note o + T >= N; 23 eval W = 0 or W T + 1 > M; 24 prep story over 999999 bytes; 40 gcheck over
note tolerance; 41 adamck over tolerance; 42 mathck over tolerance; 70 I/O.

fn ocmdw to ulong
r = oargr 1
if or le r 0 gt r 8
ret 0
end
v = ulong 0
for k ulong ulong r
v = or v shl ulong get oarg k mul k 8
end
ret v
end

fn ocmdlo to ulong
r = oargr 1
if or le r 8 gt r 16
ret 0
end
v = ulong 0
for k ulong 8
v = or v shl ulong get oarg k mul k 8
end
ret v
end

fn ocmdhi to ulong
r = oargr 1
if or le r 8 gt r 16
ret 0
end
v = ulong 0
n = sub ulong r 8
for k ulong n
v = or v shl ulong get oarg add 8 k mul k 8
end
ret v
end

note run the command named by argument 1; the platform main checks that it exists. ogcmd takes the
note GPU commands on the gb10 target (gpu/gg.om) and none elsewhere (nogpu.om).
fn ocmd to int
w = ocmdw
if ogcmd w
ret 0
end
if eq w 1885696624
cmdprep
ret 0
end
if eq w 127996038312034
cmdbpfit
ret 0
end
if eq w 109325798699106
cmdbpenc
ret 0
end
if eq w 109287127216226
cmdbpdec
ret 0
end
if eq w 1953066601
cmdinit
ret 0
end
if eq w 1684107879
cmdgrad
ret 0
end
if eq w 474214396532
cmdtrain
ret 0
end
if eq w 121398885512310
cmdvtrain
ret 0
end
if eq w 1818326629
cmdeval
ret 0
end
if eq w 465491617142
cmdveval
ret 0
end
if eq w 1702060386
cmdbase
ret 0
end
if eq w 111516417089907
cmdsamp
ret 0
end
if eq w 28548202775016302
cmdnsamp
ret 0
end
if eq w 118074647274343
cmdgchk
ret 0
end
if eq w 118074698391917
cmdmath
ret 0
end
if eq w 118074781033569
cmdadamck
ret 0
end
if eq w 435778905459
cmdserve
ret 0
end
if eq w 1701737844
cmdtune
ret 0
end
note grow: append initially silent residual layers and restart training.
if eq w 2003792487
cmdgrow
ret 0
end
note kvcmp (ham/ollm-speed) 482871572075
if eq w 482871572075
cmdkvcmp
ret 0
end
if eq w 112624400429684
cmdtrainf
ret 0
end
if eq w 30506458620916852
cmdttteval
ret 0
end
if eq w 7809653406635421540
cmddolaeval
ret 0
end
if eq w 31645462707860596
cmdtttsamp
ret 0
end
if eq w 500236120179
cmdspext
ret 0
end
if eq w 482921771123
cmdspapp
ret 0
end
if eq w 123615088701555
cmdspsamp
ret 0
end
if eq w 119165853986931
cmdspeval
ret 0
end
if eq w 111499018330982
cmdfcache
ret 0
end
if eq w 27978647094784628
cmdtrainfc
ret 0
end
if eq w 30792271479792486
cmdfcachem
ret 0
end
if eq w 28542713673379955
cmdspmerge
ret 0
end
if eq w 30227092724740211
cmdspstack
ret 0
end
if eq w 31369549780578919
cmdgrowpro
ret 0
end
if eq w 495773380723
cmdspens
ret 0
end
if eq w 123598092333171
cmdspclip
ret 0
end
if eq w 0
lo = ocmdlo
hi = ocmdhi
if and eq lo 7020664736201273459 eq hi 28784
cmdspchainapp
ret 0
end
if and eq lo 7308895112352985203 eq hi 7102838
cmdspchaineval
ret 0
end
if and eq lo 8317701428883976307 eq hi 7368033
cmdspchainsamp
ret 0
end
end
exit 2
end

note init CK V T D H F L B SEED TOTAL LRMICRO [G [LP LC NP]]; lr = f64(LRMICRO)/1000000.0. Without G
note the file is OLLMCK01 (G = 1); with G it is OLLMCK02 (CONTRACT-V1 section 6). LP LC NP make the
note LC layers from layer LP a core that runs NP times with the same weights (model.om, docs/LOOP.md):
note the file is then OLLMCK03. NP 1 is no loop and gives the OLLMCK02 file; NP 0 is exit 2; a core
note that is empty or does not fit in the L layers is exit 12.
fn cmdinit to void
na = oargc
if and and ne na 13 ne na 14 ne na 17
exit 2
end
for i ulong 7
put og i oargu add 3 i
end
put og 57 0
put og 58 0
put og 59 0
if eq na 17
oloopa
end
if not ogeom
exit 12
end
put og 40 oargu 10
tt = oargu 11
if gt tt 999999
exit 12
end
g = ulong 1
put og 46 1
if ge na 14
g = oargu 13
put og 46 2
end
if not ogok2 g
exit 12
end
put og 44 g
put og 42 tt
put og 43 bitcast ulong div f64 oargu 12 1000000.0
put og 41 0
oinit
ocksave 2
oputc 73
oputc 32
oputu get og 8
oputc 10
oflush
end

note the loop arguments LP LC NP of init (argv 14 .. 16) into og 57 .. 59; NP 1 leaves no loop
fn oloopa to void
np = oargu 16
if eq np 0
exit 2
end
if gt np 1
put og 57 oargu 14
put og 58 oargu 15
put og 59 np
end
end

note little-endian u64 at ochk[o..o+8)
fn ochk64 o ulong to ulong
v = ulong 0
for k ulong 8
x = ulong get ochk add o k
v = or v shl x mul k 8
end
ret v
end

note row b from offset ochk[b] (checked by ooffok)
fn ooffrow b ulong to void
obrow b ochk64 mul b 8
end

note exit 22 when any offset has o >= N - T (written so that an offset near 2^64 cannot wrap)
fn ooffok to void
n = get odn 0
tt = get og 1
for b ulong get og 6
if ge ochk64 mul b 8 sub n tt
exit 22
end
end
end

note grad CK DATA OFFS OUT: the gradient of CONTRACT-V1 section 5 (G blocks, K = 1)
fn cmdgrad to void
if ne oargc 6
exit 2
end
ockloop 2
odopen 3
ooffrd 4
ooffok
for b ulong get og 6
ooffrow b
end
ls = ograd
ogrsave 5
oputc 71
oputc 32
oputx bitcast ulong ls
oputc 32
oputl rmic ls
oputc 10
oflush
end

note train CK TRAIN UNTIL EVERY [K]: steps step .. min(UNTIL, TOTAL)-1; after step s, when
note (s+1) mod EVERY = 0 or s+1 is the end, save CK and print `T s+1 loss_micro(step s)`.
note K worker processes (CONTRACT-V1 section 5.1): K < 1, K > G or G mod K != 0 is exit 29.
fn cmdtrain to void
na = oargc
if and ne na 6 ne na 7
exit 2
end
ockloop 2
odopen 3
un = oargu 4
ev = oargu 5
if eq ev 0
exit 2
end
k = ulong 1
if eq na 7
k = oargu 6
end
gg = get og 44
if or eq k 0 gt k gg
exit 29
end
if ne rem gg k 0
exit 29
end
put og 45 k
en = get og 42
if lt un en
en = un
end
while lt get og 41 en bound 999999
ls = ostep
s1 = get og 41
if or eq rem s1 ev 0 eq s1 en
ocksave 2
oputc 84
oputc 32
oputu s1
oputc 32
oputl rmic ls
oputc 10
oflush
end
end
end

note vtrain CK TRAIN UNTIL EVERY NP_MIN NP_MAX: variable-NP looped-core training (COCONUT/recurrent-depth).
note Cycles cur_np across [NP_MIN .. NP_MAX] per step, preserving the base checkpoint's NP in the saved header.
fn cmdvtrain to void
if ne oargc 8
exit 2
end
ockloop 2
if eq get og 58 0
exit 17
end
odopen 3
un = oargu 4
ev = oargu 5
npmin = oargu 6
npmax = oargu 7
if or eq ev 0 or eq npmin 0 or gt npmin npmax gt npmax 6
exit 2
end
orig = get og 59
put og 59 npmax
if not ogeom
exit 12
end
put og 59 orig
x0 = ogeom
put og 45 1
en = get og 42
if lt un en
en = un
end
ovtloop orig en ev npmin npmax
end

fn ovtloop orig ulong en ulong ev ulong npmin ulong npmax ulong to void
span = add sub npmax npmin 1
while lt get og 41 en bound 999999
cnp = add npmin rem get og 41 span
put og 59 cnp
if not ogeom
exit 12
end
ls = ostep
s1 = get og 41
if or eq rem s1 ev 0 eq s1 en
put og 59 orig
x1 = ogeom
ocksave 2
ovtprint s1 cnp ls
end
end
put og 59 orig
x2 = ogeom
end

fn ovtprint s1 ulong cnp ulong ls f64 to void
oputc 86
oputc 84
oputc 32
oputu s1
oputc 32
oputu cnp
oputc 32
oputl rmic ls
oputc 10
oflush
end

note veval CK HELD W NP [MERGES]: evaluate a looped OLLMCK03 checkpoint at arbitrary loop count NP.
fn cmdveval to void
na = oargc
if and ne na 6 ne na 7
exit 2
end
ockloop 2
ww = oargu 4
np = oargu 5
if or eq np 0 gt np 6
exit 2
end
if gt get og 58 0
put og 59 np
if not ogeom
exit 12
end
end
v = get og 0
if gt v 256
if eq na 6
exit 2
end
obload 6 v
end
odopen 3
ovevrun ww np
end

fn ovevrun ww ulong np ulong to void
tt = get og 1
m = get odn 0
if or eq ww 0 gt ww div sub m 1 tt
exit 23
end
v = get og 0
ls = 0.0f64
nb = ulong 0
for w ulong ww
obrow 0 mul w tt
ls = add ls ofwd 0
if gt v 256
nb = add nb oevnb tt
end
end
lo = div ls f64 ww
bp = div lo 0.6931471805599453
if gt v 256
bp = div mul bp f64 mul ww tt f64 nb
end
oputc 86
oputc 69
oputc 32
oputu get og 41
oputc 32
oputu np
oputc 32
oputu ww
oputc 32
oputl rmic lo
oputc 32
oputl rmic bp
oputc 10
oflush
end

note eval CK HELD W [MERGES]: windows at 0, T, .., (W-1)T; prints `E step W loss_micro bpb_micro`.
note V > 256 needs MERGES (else exit 2); bpb = ((loss/ln2) f64(W T))/f64(nbytes) with nbytes the
note decoded length of the W T targets (CONTRACT-V1 section 7.1); V = 256 keeps loss/ln2.
fn cmdeval to void
na = oargc
if and ne na 5 ne na 6
exit 2
end
ockloop 2
ww = oargu 4
v = get og 0
if gt v 256
if eq na 5
exit 2
end
obload 5 v
end
odopen 3
tt = get og 1
m = get odn 0
note W T + 1 > N, tested as W > (N - 1) / T so that a huge W cannot wrap W T
if eq ww 0
exit 23
end
if gt ww div sub m 1 tt
exit 23
end
ls = 0.0f64
nb = ulong 0
for w ulong ww
obrow 0 mul w tt
ls = add ls ofwd 0
if gt v 256
nb = add nb oevnb tt
end
end
lo = div ls f64 ww
bp = div lo 0.6931471805599453
if gt v 256
bp = div mul bp f64 mul ww tt f64 nb
end
oputc 69
oputc 32
oputu get og 41
oputc 32
oputu ww
oputc 32
oputl rmic lo
oputc 32
oputl rmic bp
oputc 10
oflush
end

note decoded bytes of the targets oby[0 .. n)
fn oevnb n ulong to ulong
s = ulong 0
for t ulong n
s = add s obtlen get oby t
end
ret s
end

note append token c to the context window obx[0 .. CT), keeping the last T tokens
fn ocpush c ulong to void
cn = get og 9
tt = get og 1
if lt cn tt
put obx cn c
put og 9 add cn 1
else
for i ulong sub tt 1
put obx i get obx add i 1
end
put obx sub tt 1 c
end
end

note sample CK SEED N TEMPMILLI PROMPT [MERGES]. Context = token 0, then PROMPT (bytes when V = 256,
note its encoding when V > 256, CONTRACT-V1 section 7.2); the model reads the last T context tokens
note at positions 0..; the next token comes from the logits at the last position.
note TEMPMILLI 0: argmax (lowest index on ties), no draw. Otherwise softmax(logits/(TEMPMILLI/1000))
note and u = (splitmix64 stream out >> 11) 2^-53 with state = SEED, out = mix(state += GOLD);
note the token is the smallest c with u < p[0] + .. + p[c], else the last c with p[c] > 0.
note A generated token 0 ends the output and is not written; another writes its decoded bytes.
fn cmdsamp to void
na = oargc
if and ne na 7 ne na 8
exit 2
end
ockloop 2
st = oargu 3
nn = oargu 4
if gt nn 999999
exit 2
end
tm = oargu 5
v = get og 0
if gt v 256
if eq na 7
exit 2
end
obload 7 v
end
ochipup
osampleloaded st nn tm
end

note nsample CK SEED N TEMPMILLI PROMPT MERGES ADAPT_EXTRA THRESH_MILLI
fn cmdnsamp to void
if ne oargc 10
exit 2
end
ockloop 2
st = oargu 3
nn = oargu 4
if gt nn 999999
exit 2
end
tm = oargu 5
v = get og 0
if gt v 256
obload 7 v
end
onlreset
put onlc 4 oargu 8
put onlc 5 oargu 9
ochipup
osampleloaded st nn tm
onlreset
end

note Embedding entry: checkpoint and tokenizer already loaded; argument 6 supplies the prompt.
note The caller keeps exclusive ownership of the model pools until this returns.
fn osampleloaded seed ulong nn ulong tm ulong to void
if gt nn 999999
exit 2
end
st = seed
v = get og 0
put og 9 0
ocpush 0
if gt v 256
r = oargr 6
if or lt r 0 gt r 4000
exit 2
end
np = obprompt 6
for i ulong np
ocpush get obtk i
end
else
r = oargr 6
if or lt r 0 gt r 4096
exit 2
end
for i ulong ulong r
ocpush ulong get oarg i
end
end
for g ulong nn
c = osstep st tm
if ne tm 0
st = add st 11400714819323198485
end
if eq c 0
break
end
if gt v 256
obtput c
else
oputc c
end
note Flush each decoded token so interactive consumers see progress. Bytes and sampling stay unchanged.
oflush
ocpush c
end
oflush
end

note one sampling step (cmdsamp, serve.om): the next token from the logits at the last context
note position, argmax when TEMPMILLI tm is 0, else a draw with the splitmix64 stream state st.
fn osstep st ulong tm ulong to ulong
olastf
if eq tm 0
ret oargmax
end
ret odraw st div f64 tm 1000.0
end

note ogpu[0] = 1 when the per-token forward runs on the chip: gpu/gg.om's gserve and gsample set it
note before cmdserve or cmdsamp; nogpu.om's ogchip and oglast refuse with exit 2 on the CPU targets.
global ogpu ulong 1

note after the checkpoint loads: on the chip path, open the chip and upload the parameters once
note (gpu/gg.om plans one activation block per layer application, so a looped model runs there too).
fn ochipup to void
if ne get ogpu 0 0
ogchip
end
end

note forward of the context in obx row 0, then its last position's logits into TMP[0..V) (oa),
note on the chip when ogpu[0] = 1 (oglast), else on the CPU (ofwdi, model.om: only the rows past the
note prefix the previous call computed, then olast)
fn olastf to void
if ne get ogpu 0 0
oglast
ret
end
t0 = ofwdi
olast
if or ne get onlc 4 0 ne get onlc 10 0
onladapt
end
end

note kvcmp CK N PROMPT MERGES (ham/ollm-speed, V > 256, N V <= 2^20): ofwdi against ofwd 0. Pass 1:
note N greedy steps from token 0 then PROMPT's encoding with ofwdi then olast (the CPU decode), every
note step's V logits kept in okvr; prints `KI step ct t0 tok ns`. Pass 2: the same contexts again
note (pass 1's tokens pushed) with ofwd 0 then olast; prints `KF step ct tok ndiff ns`, ndiff = logits
note whose f64 bits differ from pass 1's. Before step N/2 of both passes the context token at CT - 5
note (when CT > 5) becomes its successor mod V, so ofwdi must find the changed prefix. Last line
note `KVCMP N ndiff inc_ns full_ns` (forward and logits time summed over the steps); exit 43 when
note ndiff > 0.
global okvr f64 1048576
global okvk ulong 4096
fn kvstart to void
put og 9 0
ocpush 0
np = obprompt 4
for i ulong np
ocpush get obtk i
end
end

fn kvpert s ulong nn ulong to void
ct = get og 9
if and eq s div nn 2 gt ct 5
i = sub ct 5
put obx i rem add get obx i 1 get og 0
end
end

fn kvline a ulong b ulong c ulong d ulong e long to void
oputc 32
oputu a
oputc 32
oputu b
oputc 32
oputu c
oputc 32
oputu d
oputc 32
oputl e
oputc 10
oflush
end

note kvcmp totals: okvs[0] pass 1 ns, [1] pass 2 ns, [2] differing logits
global okvs ulong 3
fn cmdkvcmp to void
if ne oargc 6
exit 2
end
ockloop 2
nn = oargu 3
v = get og 0
if or le v 256 or gt nn 4096 gt mul nn v 1048576
exit 2
end
obload 5 v
put okvs 0 0
put okvs 1 0
put okvs 2 0
kvstart
for s ulong nn
kvpert s nn
c = kvinc s
ocpush c
end
kvstart
for s2 ulong nn
kvpert s2 nn
kvfull s2
ocpush get okvk s2
end
oputc 75
oputc 86
oputc 67
oputc 77
oputc 80
oputc 32
oputu nn
oputc 32
oputu get okvs 2
oputc 32
oputu get okvs 0
oputc 32
oputu get okvs 1
oputc 10
oflush
if gt get okvs 2 0
exit 43
end
end

note pass 1 step s: ofwdi then olast, logits into okvr row s, KI line; returns the greedy token
fn kvinc s ulong to ulong
a = onsnow
t0 = ofwdi
olast
e = sub onsnow a
put okvs 0 add get okvs 0 e
c = oargmax
kvkeep s
put okvk s c
oputc 75
oputc 73
kvline s get og 9 t0 c long e
ret c
end

note okvr row s = the V logits in TMP
fn kvkeep s ulong to void
v = get og 0
tm = get og 27
o = mul s v
for j ulong v
x = get oa add tm j
put okvr add o j x
end
end

note the logits in TMP whose f64 bits differ from okvr row s
fn kvdiff s ulong to ulong
v = get og 0
tm = get og 27
o = mul s v
nd = ulong 0
for j ulong v
x = bitcast ulong get oa add tm j
y = bitcast ulong get okvr add o j
if ne x y
nd = add nd 1
end
end
ret nd
end

note pass 2 step s: ofwd 0 then olast, compared bit for bit with okvr row s, KF line
fn kvfull s ulong to void
a = onsnow
lf = ofwd 0
olast
e = sub onsnow a
put okvs 1 add get okvs 1 e
nd = kvdiff s
put okvs 2 add get okvs 2 nd
oputc 75
oputc 70
kvline s get og 9 oargmax nd long e
end

note logits of the last context position into TMP[0..V) (oa)
fn olast to void
d = get og 2
z = add get og 17 mul sub get og 9 1 d
klogit z get og 27 get og 0 d
end

fn oargmax to ulong
tm = get og 27
b = ulong 0
bv = get oa tm
for c ulong get og 0
if gt get oa add tm c bv
bv = get oa add tm c
b = c
end
end
ret b
end

fn odraw st ulong tau f64 to ulong
tm = get og 27
v = get og 0
m = bitcast f64 ulong 18442240474082181120
for c ulong v
x = div get oa add tm c tau
put oa add tm c x
m = fmax m x
end
sm = osoft tm v m
u = mul f64 shr smx st 11 1.1102230246251565e-16
acc = 0.0f64
la = ulong 0
for k ulong v
pk = get oa add tm k
acc = add acc pk
if lt u acc
ret k
end
if gt pk 0.0
la = k
end
end
ret la
end

note gcheck constants (derivation and Wolfram queries in docs/omegallm/README.md). GCH2 = GCH/4 is
note the retry step for an index whose difference at GCH crossed a ReLU kink.
const GCH f64 0.000001
const GCH2 f64 0.00000025
const GCFLOOR f64 0.000001
const GCTOL f64 0.001
note mathck: max relative error allowed against the correctly rounded reference
const MCTOL f64 0.000000000000001

note gcheck CK TRAIN: the hand gradient of the step loss for the batch of the header step is
note compared with central differences (L(p+h) - L(p-h))/((p+h) - (p-h)) at 4 indices of every
note tensor instance (wte, wpe, per layer g1 wq wk wv wo g2 w1 w2, gf), drawn by splitmix64.
note rel = |num - g| / max(|num|, |g|, GCFLOOR). An index with rel > GCTOL at GCH is measured
note again at GCH2 and keeps the smaller rel (a wrong hand gradient fails at both steps). Prints
note one `c index g_e12 num_e12` line per index (num of the kept step), then
note `C count maxrel_bits_hex maxrel_e9 worst_index retries`; exit 40 when maxrel > GCTOL.
fn cmdgchk to void
if ne oargc 4
exit 2
end
ockloop 2
odopen 3
obatch get og 41
ls = ograd
d = get og 2
cnt = ulong 0
put og 50 0
put og 51 0
put og 52 0
put og 53 0
ogcten 0 mul get og 0 d 0
ogcten get og 30 mul get og 1 d 1
for l ulong get og 5
ogcten opg1 l d 2
ogcten opwq l mul d d 3
ogcten opwk l mul d d 4
ogcten opwv l mul d d 5
ogcten opwo l mul d d 6
ogcten opg2 l d 7
ogcten opw1 l mul d get og 4 8
ogcten opw2 l mul d get og 4 9
end
ogcten get og 33 d 10
mx = bitcast f64 get og 51
oputc 67
oputc 32
oputu get og 50
oputc 32
oputx get og 51
oputc 32
oputl long mul mx 1000000000.0
oputc 32
oputu get og 52
oputc 32
oputu get og 53
oputc 10
oflush
if gt mx GCTOL
exit 40
end
end

note step-loss for the batch in obx/oby without touching the gradient
fn oloss to f64
ls = 0.0f64
for b ulong get og 6
ls = add ls ofwd b
end
ret div ls f64 get og 6
end

fn ogcten o ulong n ulong tag ulong to void
for j ulong 4
i = add o rem smx xor get og 40 add mul get og 50 4 j n
ogc1 i
end
end

note central difference (L(p+h) - L(p-h))/((p+h) - (p-h)) at parameter i; restores p
fn ogcnum i ulong h f64 to f64
p0 = owg i
pp = add p0 h
pm = sub p0 h
owp i pp
lp = oloss
owp i pm
lm = oloss
owp i p0
ret div sub lp lm sub pp pm
end

fn ogcrel num f64 g f64 to f64
den = fmax fmax fabs num fabs g GCFLOOR
ret div fabs sub num g den
end

note one gradient check at parameter i; updates og[50] count, og[51] max rel bits, og[52] worst
note index, og[53] retries at GCH2
fn ogc1 i ulong to void
g = ocsg i
num = ogcnum i GCH
rel = ogcrel num g
if gt rel GCTOL
put og 53 add get og 53 1
n2 = ogcnum i GCH2
r2 = ogcrel n2 g
if lt r2 rel
num = n2
rel = r2
end
end
oputc 99
oputc 32
oputu i
oputc 32
oputl long mul g 1000000000000.0
oputc 32
oputl long mul num 1000000000000.0
oputc 10
put og 50 add get og 50 1
if gt rel bitcast f64 get og 51
put og 51 bitcast ulong rel
put og 52 i
end
end

note mathck REF: REF lines are `e XBITS RBITS` or `l XBITS RBITS` (16 lowercase hex digits each,
note 36 bytes per line); RBITS is the correctly rounded Wolfram value of exp or log at the exact
note f64 XBITS. Prints `M e count max_ulp maxrel_bits_hex maxrel_e18` and the same for l;
note exit 42 when a special value (r = 0, inf or NaN) differs in bits, maxrel > MCTOL, or REF has
note no e line or no l line (a check that checked nothing fails).
fn cmdmath to void
if ne oargc 3
exit 2
end
n = odread 2
if ne rem n 36 0
exit 21
end
for k ulong 6
put og add 50 k 0
end
for i ulong div n 36
omline mul i 36
end
omprint 101 0
omprint 108 3
if or gt bitcast f64 get og 52 MCTOL gt bitcast f64 get og 55 MCTOL
exit 42
end
if or eq get og 50 0 eq get og 53 0
exit 42
end
end

fn ohex o ulong to ulong
v = ulong 0
for k ulong 16
c = odb add o k
if lt c 58
v = or shl v 4 sub c 48
else
v = or shl v 4 sub c 87
end
end
ret v
end

note og[50+b]: count, max ulp, max rel bits (b = 0 for exp, 3 for log)
fn omline o ulong to void
kd = odb o
x = bitcast f64 ohex add o 2
rb = ohex add o 19
b = ulong 0
y = 0.0f64
if eq kd 101
y = fexp x
else
b = ulong 3
y = flog x
end
yb = bitcast ulong y
put og add 50 b add get og add 50 b 1
r = bitcast f64 rb
if or or eq r 0.0 ne r r eq fabs r bitcast f64 ulong 9218868437227405312
if ne yb rb
exit 42
end
ret
end
ul = ulong 0
if gt yb rb
ul = sub yb rb
else
ul = sub rb yb
end
if gt ul get og add 51 b
put og add 51 b ul
end
rel = div fabs sub y r fabs r
if gt rel bitcast f64 get og add 52 b
put og add 52 b bitcast ulong rel
end
end

fn omprint c ulong b ulong to void
oputc 77
oputc 32
oputc c
oputc 32
oputu get og add 50 b
oputc 32
oputu get og add 51 b
oputc 32
oputx get og add 52 b
oputc 32
oputl long mul bitcast f64 get og add 52 b 1e18
oputc 10
oflush
end

note tune CK OUT TOTAL LRMICRO: fine-tune entry. Load CK (any checkpoint ckpt.om accepts), keep
note its shapes, G and weights, and start a new schedule on them: step 0, the given TOTAL and
note lr = f64(LRMICRO)/1000000.0, Adam moments m = v = 0 (so warmup and bias correction restart).
note Save to OUT with the loaded magic and print `U P`. train, gtrain and gtrainf then continue
note from OUT on any token file. TOTAL 0 or over 999999 exits 12; wrong argument count exits 2.
fn cmdtune to void
if ne oargc 6
exit 2
end
ockloop 2
tt = oargu 4
if or eq tt 0 gt tt 999999
exit 12
end
put og 41 0
put og 42 tt
put og 43 bitcast ulong div f64 oargu 5 1000000.0
ozerom mul 2 get og 8
ocksave 3
oputc 85
oputc 32
oputu get og 8
oputc 10
oflush
end


note grow CK OUT L TOTAL LRMICRO: keep embeddings, old layers and final gain byte for byte.
note Added layers use the own initializer with Wo and W2 zeroed, so both residual branches
note initially contribute zero. Their input projections remain initialized and trainable.
note The existing gradient cold store snapshots old weights while geometry changes; oinit
note writes parameters and moments only. Since P grows, new moments cannot alias the snapshot.
note Like tune, restart step and Adam, preserving seed, G, vocabulary and checkpoint format.
note OUT uses normal checkpoint save semantics (an existing path is replaced).
fn ogrowsnap n ulong to void
for q ulong ocn n
i = mul q OCH
ie = oce q n
while lt i ie bound 999999
v = owg i
note Reject non-finite source weights before attempting a growth operation.
if eq and shr bitcast ulong v 52 2047 2047
exit 54
end
ocsp i v
i = add i 1
end
end
end

fn ogrowcopy n ulong to void
for q ulong ocn n
i = mul q OCH
ie = oce q n
while lt i ie bound 999999
owp i ocsg i
i = add i 1
end
end
end

note Keep loop temporaries out of cmdgrow: every target must fit its register budget.
fn ogrowsilent first ulong to void
for j ulong sub get og 5 first
l = add first j
oiset opwo l mul get og 2 get og 2 0.0
oiset opw2 l mul get og 2 get og 4 0.0
end
end

fn cmdgrow to void
if ne oargc 7
exit 2
end
ockload 2
ll = oargu 4
tt = oargu 5
lr = oargu 6
if or le ll get og 5 or eq tt 0 gt tt 999999
exit 12
end
if eq lr 0
exit 12
end
oldl = get og 5
oldg = get og 33
ogrowsnap get og 8
put og 5 ll
if not ogeom
exit 12
end
put og 41 0
put og 42 tt
put og 43 bitcast ulong div f64 lr 1000000.0
oinit
ogrowcopy oldg
for j ulong get og 2
owp add get og 33 j ocsg add oldg j
end
ogrowsilent oldl
ocksave 3
oputc 71
oputc 32
oputu oldl
oputc 32
oputu ll
oputc 32
oputu get og 8
oputc 10
oflush
end

note SPDX-License-Identifier: AGPL-3.0-only
note Compose after wbuild.om with its main renamed to wbmain.
text ftusage "usage: wtrain cpu|gb10 OLLM BASE MERGES TRAIN_TEXT HELD_TEXT NEW_DIR STEPS LRMICRO WINDOWS\n"
text ftgpu "gb10"
text ftcpu "cpu"
text ftlock "AIEN_GB10_LOCK_HELD"
text ftwindow "SPARK_WINDOW"
text ftneed "gb10 training requires an exclusive spark-window run\n"
text ftoutfail "cannot create fresh run directory\n"
text ftbad "invalid checkpoint or numeric argument\n"
text fttrain "/train.tok"
text ftheld "/held.tok"
text ftck "/candidate.ck"
text ftlog "/run.log"
text ftencode "bpeenc"
text fttune "tune"
text fttr "train"
text ftgtr "gtrainf"
text ftev "eval"
text ftgev "geval"
text ftbase "baseline\n"
text ftafter "candidate\n"
text ftcomplete "TRAINING_COMPLETE\n"

fn ftfail msg view uchar * code int to void
wdwrall 2 msg len msg
exit code
end
fn ftmatch i ulong word view uchar * to bool
n = wdarg i
if ne n len word
ret false
end
for j ulong n
if ne get wdab j get word j
ret false
end
end
ret true
end
fn ftpositive i ulong to void
n = wdarg i
v = ulong 0
for j ulong n
c = ulong get wdab j
if or lt c 48 gt c 57
ftfail ftbad 2
end
d = sub c 48
if gt v div sub 18446744073709551615 d 10
ftfail ftbad 2
end
v = add mul v 10 d
end
if eq v 0
ftfail ftbad 2
end
end
fn ftpath suffix view uchar * to void
wdpclr
wdpa 7
wdpt suffix
end
fn ftpush suffix view uchar * to void
ftpath suffix
wdkp
end
fn ftstart cmd view uchar * to void
wdkclr
wdka 2
wdkt cmd
end
fn ftrun fd int to void
rc = wdwait wdspawn -1 fd fd
if ne rc 0
exit int rc
end
end
fn ftvocab to ulong
wdpclr
wdpa 3
fd = wdopen 0 0
if lt fd 0
ftfail ftbad 3
end
h = new uchar 16 0
n = read fd h 0 16
z = fclose fd
if ne n 16
ftfail ftbad 3
end
v = ulong 0
for i ulong 8
v = or v shl ulong get h add 8 i mul 8 i
end
ret v
end
fn ftdata src ulong suffix view uchar * vocab ulong logfd int to void
if eq vocab 256
wdpclr
wdpa src
fi = wdopen 0 0
ftpath suffix
fo = wdopen 193 384
if or lt fi 0 lt fo 0
exit 70
end
wdcopyfd fi fo
c1 = fclose fi
c2 = fclose fo
if or ne c1 0 ne c2 0
exit 70
end
else
ftstart ftencode
wdka 4
wdpclr
wdpd vocab
wdkp
wdka src
ftpush suffix
ftrun logfd
end
end
fn ftmeasure gpu bool trained bool vocab ulong fd int to void
if gpu
ftstart ftgev
else
ftstart ftev
end
if trained
wdwrall fd ftafter len ftafter
ftpush ftck
else
wdwrall fd ftbase len ftbase
wdka 3
end
ftpush ftheld
wdka 10
if gt vocab 256
wdka 4
end
ftrun fd
end
fn main to int
if ne argcnt 11
ftfail ftusage 2
end
gpu = ftmatch 1 ftgpu
if and not gpu not ftmatch 1 ftcpu
ftfail ftusage 2
end
if gpu
if not wdenv ftlock
ftfail ftneed 3
end
if or ne get wdvn 0 1 ne get wdv 0 49
ftfail ftneed 3
end
if not wdenv ftwindow
ftfail ftneed 3
end
end
ftpositive 8
ftpositive 9
ftpositive 10
v = ftvocab
wdpclr
wdpa 7
r = makedir wdp 0 get wdpn 0 448
if ne r 0
ftfail ftoutfail 3
end
ftpath ftlog
fd = wdopen 193 384
if lt fd 0
exit 70
end
ftdata 5 fttrain v fd
ftdata 6 ftheld v fd
ftmeasure gpu false v fd
ftstart fttune
wdka 3
ftpush ftck
wdka 8
wdka 9
ftrun fd
if gpu
ftstart ftgtr
else
ftstart fttr
end
ftpush ftck
ftpush fttrain
wdka 8
wdka 8
ftrun fd
ftmeasure gpu true v fd
wdwrall fd ftcomplete len ftcomplete
z = fclose fd
if ne z 0
exit 70
end
wdwrall 1 ftcomplete len ftcomplete
ret 0
end

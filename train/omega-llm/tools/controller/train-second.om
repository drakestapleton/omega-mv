note train-second RECORDS. Each pair of bytes contains a feature group and a catch label.
fn main to int
if ne argcnt 2
ret 2
end
wdpclr
wdpa 1
n = wdload
if or le n 0 ne rem ulong n 2 0
ret 72
end
for i ulong div ulong n 2
k = mul i 2
g = ulong get wdsrc k
y = ulong get wdsrc add k 1
if or gt g 7 gt y 1
ret 72
end
scvote g y
scvote add 8 and g 1 y
scvote 10 y
end
scsave
ret 0
end

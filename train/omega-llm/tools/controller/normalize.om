note normalize PROMPT [BODY]. Rewrite the signature or restore a generated body by identifier.
global cpwordstart ulong 16
global cpwordlen ulong 16
global cpwords ulong 1
global cpnames ulong 3
text nx "x"
text ny "y"
text na "a"
text nb "b"
text ni "items"
text nc "count"
text nd "data"
text nn "n"
fn cpfile arg ulong buf edit uchar * to ulong
wdpclr
wdpa arg
n = wdload
if or lt n 1 ge ulong n len buf
exit 72
end
for i ulong ulong n
put buf i get wdsrc i
end
ret ulong n
end
fn cpid c uchar to bool
ret or eq c 95 or and ge c 48 le c 57 or and ge c 65 le c 90 and ge c 97 le c 122
end
fn cpwordend buf view uchar * i ulong n ulong to ulong
while lt i n bound 8192
if not cpid get buf i
break
end
i = add i 1
end
ret i
end
fn samebytes a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a
if ne get a i get b i
ret false
end
end
ret true
end
global aliaslen ulong 2
fn setalias aliases edit uchar * k ulong v view uchar * to void
put aliaslen k len v
for j ulong len v
put aliases add mul k 32 j get v j
end
end
fn parsesig cprompt view uchar * n ulong to void
i = ulong 0
while lt i n bound 4096
if eq get cprompt i 10
break
end
i = add i 1
end
i = add i 1
k = ulong 0
while lt i n bound 4096
if cpid get cprompt i
s = i
i = cpwordend cprompt i n
if ge k 16
exit 72
end
put cpwordstart k s
put cpwordlen k sub i s
k = add k 1
else
i = add i 1
end
end
if and ne k 8 ne k 10
exit 72
end
put cpwords 0 k
put cpnames 0 2
put cpnames 1 sub k 4
end
fn choosealiases cprompt view uchar * aliases edit uchar * to void
k = get cpwords 0
second = false
if eq k 10
second = and samebytes part cprompt get cpwordstart get cpnames 0 get cpwordlen get cpnames 0 ni samebytes part cprompt get cpwordstart get cpnames 1 get cpwordlen get cpnames 1 nc
else
second = and samebytes part cprompt get cpwordstart get cpnames 0 get cpwordlen get cpnames 0 nx samebytes part cprompt get cpwordstart get cpnames 1 get cpwordlen get cpnames 1 ny
end
if eq k 10
if second
setalias aliases 0 nd
setalias aliases 1 nn
else
setalias aliases 0 ni
setalias aliases 1 nc
end
else
if second
setalias aliases 0 na
setalias aliases 1 nb
else
setalias aliases 0 nx
setalias aliases 1 ny
end
end
end
fn restoretoken cprompt view uchar 4096 aliases view uchar 64 v view uchar * to void
if samebytes v part aliases mul ulong 32 0 get aliaslen 0
wdot part cprompt get cpwordstart get cpnames 0 get cpwordlen get cpnames 0
else
if samebytes v part aliases mul ulong 32 1 get aliaslen 1
wdot part cprompt get cpwordstart get cpnames 1 get cpwordlen get cpnames 1
else
if or samebytes v part cprompt get cpwordstart get cpnames 0 get cpwordlen get cpnames 0 samebytes v part cprompt get cpwordstart get cpnames 1 get cpwordlen get cpnames 1
exit 75
end
wdot v
end
end
end
fn restorebody cprompt view uchar 4096 aliases view uchar 64 a view uchar * to void
i = ulong 0
while lt i len a bound 8192
if cpid get a i
s = i
i = cpwordend a i len a
restoretoken cprompt aliases part a s sub i s
else
wdoc ulong get a i
i = add i 1
end
end
end
fn main to int
if and ne argcnt 2 ne argcnt 3
ret 2
end
cprompt = new uchar 4096 0
aliases = new uchar 64 0
a = new uchar 8192 0
n = cpfile 1 cprompt
parsesig cprompt n
choosealiases cprompt aliases
if eq argcnt 3
an = cpfile 2 a
restorebody cprompt aliases part a 0 an
else
s = ulong 0
for j ulong 2
k = get cpnames j
off = get cpwordstart k
wdot part cprompt s sub off s
wdot part aliases mul ulong 32 j get aliaslen j
s = add off get cpwordlen k
end
wdot part cprompt s sub n s
end
wdoflush 1
ret 0
end

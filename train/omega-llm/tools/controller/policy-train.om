note train CALIBRATION_RECORDS. Each record is five bytes: features, public grades and private grades.
fn main to int
if ne argcnt 2
ret 2
end
wdpclr
wdpa 1
n = wdload
if or le n 0 ne rem ulong n 5 0
ret 72
end
for i ulong div ulong n 5
j = mul i 5
g = ulong get wdsrc j
if ge g 8
ret 72
end
for k ulong 4
if gt get wdsrc add add j 1 k 2
ret 72
end
end
cptrain j
end
cpdump
ret 0
end

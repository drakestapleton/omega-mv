note Learned risk of an incorrect first-pass body being rejected by the other caller example.
text scmagic "OSC2"
text sccond "if "
text scret "ret "
global scseen ulong 11
global sccaught ulong 11
fn scstarts a view uchar * off ulong key view uchar * to bool
if gt add off len key len a
ret false
end
for j ulong len key
if ne get a add off j get key j
ret false
end
end
ret true
end
fn scletter c uchar to bool
ret or eq c 95 or and ge c 65 le c 90 and ge c 97 le c 122
end
fn scsimple a view uchar * off ulong to bool
if ge off len a
ret false
end
if not scletter get a off
ret false
end
for j ulong sub len a off
c = get a add j off
if eq c 10
ret true
end
if not or scletter c and ge c 48 le c 57
ret false
end
end
ret true
end
fn scfeature p view uchar * a view uchar * to ulong
g = cpbit hastext p ctarray
line = true
for i ulong len a
if line
if scstarts a i sccond
g = or g 2
end
if scstarts a i scret
if scsimple a add i 4
g = or g 4
end
end
end
line = eq get a i 10
end
ret g
end
fn scvote k ulong y ulong to void
put scseen k add 1 get scseen k
put sccaught k add y get sccaught k
end
fn scdecision g ulong to bool
k = g
if lt get scseen k 6
k = add 8 and g 1
end
if lt get scseen k 6
k = 10
end
ret ge mul 12 get sccaught k get scseen k
end
fn scemit n ulong to void
for j ulong 4
wdoc and shr n mul j 8 255
end
end
fn scsave to void
wdot scmagic
for i ulong 11
scemit get scseen i
scemit get sccaught i
end
wdoflush 1
end
fn scu32 k ulong to ulong
v = ulong 0
for j ulong 4
v = or v shl ulong get wdsrc add k j mul 8 j
end
ret v
end
fn scload arg ulong to void
wdpclr
wdpa arg
if ne wdload 92
exit 72
end
for j ulong len scmagic
if ne get scmagic j get wdsrc j
exit 72
end
end
for i ulong 11
k = add 4 mul 8 i
n = scu32 k
y = scu32 add k 4
if gt y n
exit 72
end
put scseen i n
put sccaught i y
end
if eq get scseen 10 0
exit 72
end
end

note Resident local sampling adapter for the controller. gsample ENDPOINT 42 64 0 PROMPT MERGES.
note ENDPOINT is the decimal loopback port followed by the server's exact checkpoint model ID on its own line.
text rsstart "{\"temperature\":0,\"seed\":42,\"max_tokens\":64,\"model\":"
text rsprompt ",\"prompt\":"
text rsend "}"
text rsverb "POST"
text rspath "/v1/completions"
text rshost "Host"
text rsip "127.0.0.1"
text rsct "Content-Type"
text rsjson "application/json"
text rschoices "choices"
text rsmodel "model"
text rstext "text"
text rsgsample "gsample"
text rsseed "42"
text rslimit "64"
text rszero "0"
fn rsarg i ulong s view uchar * to bool
n = wdarg i
if ne n len s
ret false
end
for j ulong n
if ne get wdab j get s j
ret false
end
end
ret true
end
fn quoted v view uchar * to void
wdoc 34
for k ulong len v
c = get v k
if or eq c 34 eq c 92
wdoc 92
wdoc ulong c
else
if eq c 10
wdoc 92
wdoc 110
else
if eq c 9
wdoc 92
wdoc 116
else
if eq c 13
wdoc 92
wdoc 114
else
if lt c 32
exit 72
end
wdoc ulong c
end
end
end
end
end
wdoc 34
end
global rsmlen ulong 1
fn endpoint mid edit uchar * to ulong
wdpclr
wdpa 2
n = wdload
if lt n 4
exit 72
end
i = ulong 0
port = ulong 0
while and lt i ulong n ne get wdsrc i 10 bound 6
c = get wdsrc i
if or lt c 48 gt c 57
exit 72
end
port = add mul port 10 sub ulong c 48
i = add i 1
end
if or eq port 0 gt port 65535
exit 72
end
start = add i 1
if or le ulong n add start 1 ne get wdsrc sub ulong n 1 10
exit 72
end
lenid = sub sub ulong n start 1
if gt lenid len mid
exit 72
end
put rsmlen 0 lenid
for j ulong lenid
put mid j get wdsrc add start j
end
ret port
end
fn payload b edit uchar 32768 mid view uchar * to ulong
p = new uchar 4096 0
n = argread 6 p 0 4096
if or le n 0 ge n 4096
exit 72
end
wdot rsstart
quoted mid
wdot rsprompt
quoted part p 0 ulong n
wdot rsend
count = get wdon 0
if gt count len b
exit 72
end
for j ulong count
put b j get wdo j
end
wdoclr
ret count
end
fn rpost cs edit ulong 320 io edit uchar 65536 b view uchar * to long
r = hreqst cs io rsverb
r = hfe r hreqtg cs io rspath
r = hfe r hhname cs io rshost
r = hfe r hhval cs io rsip
r = hfe r hhname cs io rsct
r = hfe r hhval cs io rsjson
r = hfe r hhend cs io 0 len b
r = hfe r hput cs io b
r = hfe r hwfin cs io
if lt r 0
ret r
end
ret hrsprd cs io
end
fn rsfield src view uchar 32768 tape view uint 32768 obj ulong ky view uchar * to ulong
if eq obj jsnone
exit 74
end
k = js_first tape obj
while ne k jsnone bound 8192
if js_streq src js_off tape k ky
ret add k 1
end
k = js_mnext tape k
end
exit 74
end
fn extract src view uchar 32768 n ulong mid view uchar * to void
tape = new uint 32768 0
answerbuf = new uchar 8192 0
if lt js_init tape 32768 128 0
exit 74
end
if lt js_parse src tape n 0
exit 74
end
m = rsfield src tape 0 rsmodel
if not js_streq src js_off tape m mid
exit 74
end
a = rsfield src tape 0 rschoices
o = js_first tape a
f = rsfield src tape o rstext
k = js_sget src js_off tape f answerbuf
if lt k 0
exit 74
end
wdwrall 1 answerbuf ulong k
end
fn incoming cs edit ulong 320 io edit uchar 65536 mid view uchar * to void
b = new uchar 32768 0
chunk = new uchar 4096 0
n = ulong 0
while true bound 32769
m = hbodyrd cs io chunk
if lt m 0
exit 74
end
if eq m 0
break
end
if gt add n ulong m len b
exit 74
end
for j ulong ulong m
put b add n j get chunk j
end
n = add n ulong m
end
extract b n mid
end
fn main to int
cs = new ulong 320 0
io = new uchar 65536 0
a = new uchar 16 0
b = new uchar 32768 0
mid = new uchar 256 0
if ne argcnt 8
ret 2
end
if not and rsarg 1 rsgsample and rsarg 3 rsseed and rsarg 4 rslimit rsarg 5 rszero
ret 2
end
port = endpoint mid
n = payload b part mid 0 get rsmlen 0
r = haddr4 a 2130706433 port
fd = hdial a 5000000000
if lt fd 0
ret 73
end
r = hinit cs io int fd 0
hsettmo cs 10000000000 10000000000
if ne rpost cs io part b 0 n 200
ret 74
end
incoming cs io part mid 0 get rsmlen 0
r = hclose cs
ret 0
end

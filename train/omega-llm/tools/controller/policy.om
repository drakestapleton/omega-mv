note Seeded Omega supervised controller for initial tool choice and retry decisions.
note Model rows are five decision contexts by eight feature groups plus one pooled group.
text cpmagic "OCP1"
text ctarray " view "
text ctleft " left "
text ctdata " data "
text ctthen "then "
text cthalf "half "
text ctsquare "square "
text cttwice "twice "
text ctthree "three plus"
global cpvotes ulong 90
fn hastext p view uchar * needle view uchar * to bool
if lt len p len needle
ret false
end
for i ulong add 1 sub len p len needle
ok = true
for j ulong len needle
if ne get p add i j get needle j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end
fn cpfeatures p view uchar * to ulong
group = ulong 0
if hastext p ctarray
group = 1
end
if or hastext p ctleft hastext p ctdata
group = add group 2
end
if or hastext p ctthen or hastext p cthalf or hastext p ctsquare or hastext p cttwice hastext p ctthree
group = add group 4
end
ret group
end
fn cell stage ulong group ulong to ulong
ret mul 2 add group mul 9 stage
end
fn addvote stage ulong group ulong choice ulong to void
i = add cell stage group choice
put cpvotes i add 1 get cpvotes i
j = add cell stage 8 choice
put cpvotes j add 1 get cpvotes j
end
fn retryctx route ulong status ulong to ulong
ret add add 1 mul 2 route status
end
fn cpbit b bool to ulong
if b
ret 1
end
ret 0
end
fn cptrain j ulong to void
group = ulong get wdsrc j
dp = ulong get wdsrc add j 1
ap = ulong get wdsrc add j 2
dh = ulong get wdsrc add j 3
ah = ulong get wdsrc add j 4
d = and eq dp 2 eq dh 2
a = and eq ap 2 eq ah 2
if ne d a
if a
addvote 0 group 1
else
addvote 0 group 0
end
end
if lt dp 2
addvote retryctx 0 dp group cpbit a
end
if lt ap 2
addvote retryctx 1 ap group cpbit d
end
end
fn cppredict stage ulong group ulong to ulong
i = cell stage group
if lt add get cpvotes i get cpvotes add i 1 4
i = cell stage 8
end
other = get cpvotes add i 1
if ne stage 0
other = mul 4 other
end
ret cpbit gt other get cpvotes i
end
fn cpdump to void
wdot cpmagic
for i ulong len cpvotes
v = get cpvotes i
if gt v 65535
exit 72
end
wdoc and v 255
wdoc shr v 8
end
wdoflush 1
end
fn cprestore arg ulong to void
wdpclr
wdpa arg
n = wdload
if ne n 184
exit 72
end
for j ulong len cpmagic
if ne get wdsrc j get cpmagic j
exit 72
end
end
for i ulong len cpvotes
k = add 4 mul 2 i
put cpvotes i add ulong get wdsrc k shl ulong get wdsrc add k 1 8
end
end

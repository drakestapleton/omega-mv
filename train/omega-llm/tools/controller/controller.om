note controller PROMPT OMC SAMPLER MERGES CALLER_MAIN REASONER NORMALIZER POLICY [DIRECT_CACHE RESTORED_CACHE]
text cpnorm "normalized.om"
text cpraw "generation.om"
text cpbody "restored.om"
text cpattempt "attempt "
text cpnext " continued\n"
text cpstop " abstained\n"
text cpaccept " returned\n"
fn adapt restore bool to long
f = int 0
if restore
f = fdesc cpbody 577
else
f = fdesc cpnorm 577
end
wdkclr
wdka 7
wdka 1
if restore
wdkt cpraw
end
rc = wdwait wdspawn -1 f -1
closed2 = fclose f
ret rc
end
fn sampletext p view uchar * to void
f = fdesc cpraw 577
wdkclr
wdka 3
wdkt samplecmd
wdka 6
wdkt seedval
wdkt limitval
wdkt tempval
wdkt p
wdka 4
rc = wdwait wdspawn -1 f -1
cl = fclose f
if ne rc 0
exit 73
end
end
fn getproposal p view uchar 4096 a edit uchar 8192 route ulong to ulong
canon = new uchar 4096 0
if eq argcnt 11
ret pickload add 9 route a
end
if eq argcnt 14
ret pickload add 12 route a
end
if eq route 0
sampletext part p 0 get lengths 0
ret pickread fdesc cpraw 0 a
end
if ne adapt false 0
exit 74
end
n = pickread fdesc cpnorm 0 canon
sampletext part canon 0 n
an = pickread fdesc cpraw 0 a
if eq an 0
ret 0
end
rc = adapt true
if eq rc 75
ret 0
end
if ne rc 0
exit 74
end
ret pickread fdesc cpbody 0 a
end
global cpend ulong 1
fn checkproposal p view uchar 4096 a view uchar 8192 checker view uchar 65536 n ulong to ulong
for i ulong n
if terminates part a 0 n i
if eq compile p part a 0 add i 1 checker 0
r = strict
if or eq r 125 eq r 126
exit 70
end
if eq r 77
put cpend 0 add i 1
ret 2
end
ret 1
end
end
end
ret 0
end
fn logattempt route ulong status ulong nextstep view uchar * to void
wdot cpattempt
wdod route
wdot sep
wdod status
wdot nextstep
wdoflush 2
end
global scmode ulong 1
text sclearned "learned"
text scone "one"
text sctwo "two"
text scgateword "gate "
fn scmodeis key view uchar * to bool
n = wdarg 11
if ne n len key
ret false
end
for i ulong n
if ne get wdab i get key i
ret false
end
end
ret true
end
fn scsetup to void
if scmodeis sclearned
scload 10
put scmode 0 3
ret
end
if scmodeis scone
put scmode 0 1
ret
end
if scmodeis sctwo
put scmode 0 2
ret
end
exit 2
end
fn scverify p view uchar 4096 a view uchar 8192 c view uchar 65536 to ulong
if ne compile p part a 0 get cpend 0 c 0
exit 74
end
r = strict
if or eq r 125 eq r 126
exit 70
end
if eq r 77
ret 2
end
ret 1
end
fn scapply p view uchar 4096 a view uchar 8192 to ulong
c = new uchar 65536 0
mode = get scmode 0
if eq mode 0
ret 2
end
g = scfeature part p 0 get lengths 0 part a 0 get cpend 0
decision = or eq mode 2 and eq mode 3 scdecision g
verdict = ulong 0
if decision
saved = get lengths 2
put lengths 2 pickload 9 c
verdict = scverify p a c
put lengths 2 saved
end
wdot scgateword
wdod g
wdot sep
wdod verdict
wdoc 10
wdoflush 2
if eq verdict 1
ret 1
end
ret 2
end
fn main to int
if and and ne argcnt 9 ne argcnt 11 and ne argcnt 12 ne argcnt 14
ret 2
end
p = new uchar 4096 0
a = new uchar 8192 0
checker = new uchar 65536 0
put lengths 0 pickload 1 p
put lengths 2 pickload 5 checker
cprestore 8
if ge argcnt 12
scsetup
end
group = cpfeatures part p 0 get lengths 0
route = cppredict 0 group
for turn ulong 2
n = getproposal p a route
status = checkproposal p a checker n
if eq status 2
status = scapply p a
end
if eq status 2
logattempt route status cpaccept
wdwrall 1 a get cpend 0
wdwrall 1 lf 1
ret 0
end
if or eq turn 1 eq cppredict retryctx route status group 0
logattempt route status cpstop
ret 3
end
logattempt route status cpnext
route = sub 1 route
end
ret 70
end

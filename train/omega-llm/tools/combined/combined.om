note SPDX-License-Identifier: AGPL-3.0-only
note Linked with the existing benchmark path, process, and execpure grading primitives.
text formal "om_formalize"
text sk "om_sketch"
text sy "om_synth"
text neural "ollm"
text spec "input.spec"
text source "function.om"
text promptfile "prompt"
text logname "status"
text raw "answer"
text formcmd "formalize"
text solvecmd "solve"
text specsample "spsamp"
text r6 "r6.ck"
text r3 "r3.ck"
text r11 "r11.ck"
text fast "base.ck"
text traceck "trace.ck"
text merges "merges.bin"
text s1 "S1_arith.sp"
text s2 "S2_fold.sp"
text s3 "S3_rewrite.sp"
text s4 "S4_repair.sp"
text missform "FORMALIZE_ABSTAIN\n"
text misssk "SKETCH_FAIL\n"
text misssy "SYNTH_FAIL nodes="
text noStrand ""
text size64 "64"
text heat "700"
text badinput "combined: malformed prompt or numeric examples\n"
text failure "combined: component or file failed\n"
text absent "combined: no candidate passed the supplied examples\n"
text from "route "
text linefeed "\n"
text arity "arity "
text knobs "\ndepth 2\nconsts 0 1 2 3\n"
text cs "case"
text fs "fold"
text rs "rew"
text setarr "put arr "
text calcwords "add sub mul div rem and or xor shl shr eq ne lt le gt ge not true false if else end while for bound break continue ret put get new int uint ulong long uchar bool = acc sum tmp cnt idx best prev next ans val min max out res mask bit count carry found seen first last result"
global cfg ulong 8
note cfg: prompt size, signature start/end, shape, example count.
global cases ulong 1088

fn kfile t view uchar * to void
pclr
parg 1
pch 47
ptx t
end

fn kitarg t view uchar * to void
kfile t
kpath
end

fn workarg t view uchar * to void
wpath t
kpath
end

fn present t view uchar * to bool
kfile t
f = fopen pth 0 get st 3 0 0
if lt f 0
ret false
end
x = fclose int f
ret true
end

fn cbRun dest view uchar * to long
wpath dest
fo = popen true 384
pclr
ptx tnull
fi = popen false 0
p = spawn fi fo false
x = fclose fi
y = fclose fo
ret waitp p 60000
end

note Load a bounded regular file through one descriptor. Each input stays in its own mem range.
fn cbLoad limit ulong to ulong
fd = popen false 0
sz = fseek fd 0 2
if or lt sz 0 gt ulong sz limit
die badinput 65
end
if ne fseek fd 0 0 0
die failure 70
end
b = get st 6
e = add b ulong sz
grow = enlarge mem add e 1
if lt grow 0
die failure 70
end
p = b
while lt p e bound 65536
k = read fd mem p sub e p
if le k 0
die failure 70
end
p = add p ulong k
end
if ne read fd mem e 1 0
die failure 70
end
cl = fclose fd
put st 6 e
ret b
end

fn wload t view uchar * to ulong
wpath t
ret cbLoad 65535
end

fn resolved rc long miss view uchar * to bool
if eq rc 0
ret true
end
b = wload logname
if and eq rc 1 sw b get st 6 miss
ret false
end
die failure 70
ret false
end

fn readprompt to void
pclr
parg 4
b = cbLoad 4095
e = get st 6
if or lt e 18 gt e 4095
die badinput 65
end
p = lend 0 e
s = add p 1
q = lend s e
if or not sw 0 p gnote not sw s q gsolve
die badinput 65
end
if or le p len gnote gt e add q 1
die badinput 65
end
for i ulong e bound 4095
v = get mem i
if and lt v 32 ne v 10
die badinput 65
end
end
put cfg 0 q
put cfg 1 s
put cfg 2 q
put cfg 3 shapeof add s len gsolve q
put st 2 0
gmem 0 q
gc 10
wpath promptfile
fsave 384
end

fn canonical a ulong w ulong to ulong
v = dec a w
di = udec v
note Canonical decimal round trip also rejects unsigned overflow and leading zeroes.
if ne sub w a sub 24 di
die badinput 65
end
for z ulong sub w a bound 20
if ne get mem add a z get dg add di z
die badinput 65
end
end
ret v
end

fn readrow p ulong q ulong width ulong to void
a = skipsp p q
r = get cfg 4
if or ge r 64 ne nwords a q width
die badinput 65
end
for j ulong width bound 17
w = wordend a q
v = canonical a w
if and and ge get cfg 3 4 eq j 0 gt v 8
die badinput 65
end
put cases add mul r 17 j v
a = skipsp w q
end
put cfg 4 add r 1
end

fn readcases to void
pclr
parg 5
p = cbLoad 24576
e = get st 6
sh = get cfg 3
width = add sh 1
if eq sh 4
width = 10
end
if eq sh 5
width = 17
end
while lt p e bound 65
q = lend p e
readrow p q width
p = add q 1
end
if eq get cfg 4 0
die badinput 65
end
end

fn numberarg x ulong to void
gc 32
gu x
end

fn exampleSpec to void
sh = get cfg 3
put st 2 0
gtx arity
gu sh
gtx knobs
for i ulong get cfg 4 bound 64
if eq i 8
break
end
b = mul i 17
n = add sh 1
if le sh 3
gtx cs
else
if eq sh 5
gtx rs
n = 17
else
gtx fs
n = add get cases b 1
end
end
for j ulong n bound 17
numberarg get cases add b j
end
if eq sh 4
numberarg get cases add b 9
end
gc 10
end
wpath spec
fsave 384
end

note Only arithmetic, structured control, array operations and common local names enter execpure.
fn mathword p ulong q ulong to bool
if eq p q
ret false
end
a = p
c = get mem a
if and ge c 97 le c 122
a = add a 1
end
digits = true
for i ulong sub q a bound 65536
c = get mem add a i
if or lt c 48 gt c 57
digits = false
break
end
end
if digits
ret true
end
w = ulong 0
while lt w len calcwords bound 512
z = w
while lt z len calcwords bound 512
if eq get calcwords z 32
break
end
z = add z 1
end
if meq p q part calcwords w sub z w
ret true
end
w = add z 1
end
ret false
end

fn mathbody b ulong e ulong to bool
p = b
while lt p e bound 65536
q = lend p e
a = skipsp p q
while lt a q bound 65536
w = wordend a q
if not mathword a w
ret false
end
a = skipsp w q
end
p = add q 1
end
ret true
end

fn checkbody b ulong e ulong to bool
z = bodyend b e
if eq z 0
ret false
end
if or more sub z 1 e not mathbody b e
ret false
end
put st 2 0
gmem get cfg 1 sub get cfg 2 get cfg 1
gc 10
gmem b sub e b
gc 10
gtx gmain0
sh = get cfg 3
if ge sh 4
gtx garr0
end
for i ulong get cfg 4 bound 64
o = mul i 17
if le sh 3
gtx gifne
for j ulong sh bound 3
gtx gsul
gu get cases add o j
end
gtx gsul
gu get cases add o sh
gtx gfail
else
for j ulong 8
gtx setarr
gu j
numberarg get cases add add o 1 j
gc 10
end
if eq sh 4
gtx gifne
gtx garrul
gu get cases o
gtx gsul
gu get cases add o 9
gtx gfail
else
gtx gcall
gtx garrul
gu get cases o
gc 10
for j ulong 8
gtx gifget
gu j
gtx gsul
gu get cases add add o 9 j
gtx gfail
end
end
end
end
gtx gret77
rc = compile
if eq rc 127
die failure 70
end
if ne rc 0
ret false
end
ret eq runp false 77
end

fn emitbody b ulong e ulong route view uchar * to bool
if ge b e
ret false
end
if gt get cfg 4 0
if not checkbody b e
ret false
end
end
w = write 2 from 0 len from
w = write 2 route 0 len route
w = write 2 linefeed 0 1
p = b
while lt p e bound 65536
n = write 1 mem p sub e p
if le n 0
die failure 70
end
p = add p ulong n
end
ret true
end

fn symbol exe view uchar * miss view uchar * to bool
kclr
kitarg exe
ktx solvecmd
workarg spec
workarg source
if not resolved cbRun logname miss
ret false
end
b = wload source
e = get st 6
q = lend b e
if not mm b sub q b get cfg 1 sub get cfg 2 get cfg 1
ret false
end
body = add q 1
if ge body e
die failure 70
end
z = bodyend body e
if eq z 0
die failure 70
end
if more sub z 1 e
die failure 70
end
ret emitbody body e exe
end

fn solveSpec to bool
if symbol sk misssk
ret true
end
if le get cfg 3 4
ret symbol sy misssy
end
ret false
end

fn draw ck view uchar * strand view uchar * seed ulong to bool
kclr
kitarg neural
if eq len strand 0
ktx csample
kitarg ck
ktx a42
ktx a128
ktx a0
else
ktx specsample
kitarg ck
kitarg strand
ktx size64
ktx heat
end
put st 2 0
gmem 0 get cfg 0
if ne len strand 0
gc 10
end
kprog
if ne len strand 0
put st 2 0
gu seed
kprog
end
kitarg merges
if ne cbRun raw 0
die failure 70
end
b = wload raw
if eq len strand 0
ret emitbody b get st 6 ck
end
ret emitbody b get st 6 strand
end

fn strandDraw s view uchar * first ulong to bool
if not present s
ret false
end
for j ulong 4
if draw r3 s add first j
ret true
end
end
ret false
end

fn main to int
if and ne argcnt 5 ne argcnt 6
die badinput 2
end
put st 26 2
put st 27 3
readprompt
if eq argcnt 6
readcases
end
kclr
kitarg formal
ktx formcmd
workarg promptfile
workarg spec
if resolved cbRun logname missform
if solveSpec
ret 0
end
end
if eq argcnt 6
exampleSpec
if solveSpec
ret 0
end
end
if draw r6 noStrand 0
ret 0
end
if eq argcnt 5
die absent 1
end
if present r3
if draw r3 noStrand 0
ret 0
end
end
if present fast
if draw fast noStrand 0
ret 0
end
end
if present traceck
if draw traceck noStrand 0
ret 0
end
end
if present r11
if draw r11 noStrand 0
ret 0
end
end
if present r3
if strandDraw s1 1000
ret 0
end
if strandDraw s2 1100
ret 0
end
if strandDraw s3 1200
ret 0
end
if strandDraw s4 1300
ret 0
end
end
die absent 1
ret 1
end

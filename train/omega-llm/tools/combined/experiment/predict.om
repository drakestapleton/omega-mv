text tPrintLine "prl\n"
note Harness only. Usage: predict KIT SCRATCH OMC PROMPT BODY INPUTS.
note INPUTS contains arguments alone. Each run prints one result row per input in bench-out.
fn emitInput p ulong q ulong sh ulong to void
width = sh
if ge sh 4
width = 9
end
p = skipsp p q
if ne nwords p q width
die badinput 65
end
if le sh 3
gtx gprv
gtx gcall
for j ulong width
w = wordend p q
gtx gsul
gu canonical p w
p = skipsp w q
end
gc 10
else
w = wordend p q
n = canonical p w
if gt n 8
die badinput 65
end
p = skipsp w q
for j ulong 8
w = wordend p q
gtx setarr
gu j
numberarg canonical p w
gc 10
p = skipsp w q
end
if eq sh 4
gtx gprv
end
gtx gcall
gtx garrul
gu n
gc 10
if eq sh 5
gtx gpra
end
end
gtx tPrintLine
end


fn main to int
if ne argcnt 7
die badinput 2
end
put st 26 2
put st 27 3
readprompt
pclr
parg 5
b = cbLoad 65535
e = get st 6
z = bodyend b e
if eq z 0
ret 1
end
if or more sub z 1 e not mathbody b e
ret 1
end
put st 2 0
gmem get cfg 1 sub get cfg 2 get cfg 1
gc 10
gmem b sub e b
gc 10
gtx gpre
gtx gmain0
validateNames
sh = get cfg 3
if ge sh 4
gtx garr0
end
pclr
parg 6
p = cbLoad 65535
e = get st 6
while lt p e bound 65536
q = lend p e
emitInput p q sh
p = add q 1
end
gtx gmainz
rc = compile
if eq rc 127
die failure 70
end
if ne rc 0
ret 1
end
if ne runp true 0
ret 2
end
ret 0
end

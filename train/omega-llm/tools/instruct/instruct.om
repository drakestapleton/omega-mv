global mem uchar *
global st ulong 24
global gs uchar 65536
global pre uchar 16384
global ob uchar 65536
global dg uchar 24
global pth uchar 4096

note ======== stdout, stderr

fn oflush to void
n = get st 7
p = ulong 0
while lt p n bound 65536
w = write 1 ob p sub n p
if le w 0
exit 70
end
p = add p ulong w
end
put st 7 0
end

fn oc c ulong to void
n = get st 7
if ge n 65536
oflush
n = 0
end
put ob n uchar c
put st 7 add n 1
end

fn ot t view uchar * to void
for i ulong len t bound 65536
oc ulong get t i
end
end

fn omem o ulong n ulong to void
for i ulong n bound 9223372036854775807
oc ulong get mem add o i
end
end

note the string h on stdout
fn og h ulong to void
o = shr h 16
for i ulong and h 65535 bound 65536
oc ulong get gs add o i
end
end

note v in decimal into dg; the index of its first digit (digits end at 24)
fn udec v ulong to ulong
i = ulong 24
x = v
k = true
while k bound 24
i = sub i 1
put dg i uchar add 48 rem x 10
x = div x 10
if eq x 0
k = false
end
end
ret i
end

fn ou v ulong to void
i = udec v
while lt i 24 bound 24
oc ulong get dg i
i = add i 1
end
end

note message t on stderr, then exit c
fn die t view uchar * c int to void
oflush
w = write 2 t 0 len t
exit c
end

note ======== files and arguments

note argument i's file into mem at the fill; its offset (the length is the new fill minus it)
fn aload i ulong to ulong
r = argread i pth 0 4096
if le r 0
die weargs 2
end
fd = fopen pth 0 ulong r 0 0
if lt fd 0
die weio 70
end
sz = fseek int fd 0 2
if lt sz 0
die weio 70
end
z = fseek int fd 0 0
b = get st 6
e = add b ulong sz
g = enlarge mem add e 1
if lt g 0
die weio 70
end
o = b
while lt o e bound 9223372036854775807
k = read int fd mem o sub e o
if le k 0
die weio 70
end
o = add o ulong k
end
z = fclose int fd
put st 6 e
ret b
end

note argument i as a decimal number
fn anum i ulong to ulong
r = argread i pth 0 4096
if or le r 0 gt r 19
die weargs 2
end
v = ulong 0
for k ulong ulong r bound 19
c = ulong get pth k
if or lt c 48 gt c 57
die weargs 2
end
v = add mul v 10 sub c 48
end
ret v
end

note whether argument 1 is t
fn iscmd t view uchar * to bool
r = argread 1 pth 0 4096
if ne r long len t
ret false
end
for i ulong len t bound 4096
if ne get pth i get t i
ret false
end
end
ret true
end

note ======== random numbers (splitmix64)

fn rnd to ulong
x = add get st 0 0x9e3779b97f4a7c15
put st 0 x
z = mul xor x shr x 30 0xbf58476d1ce4e5b9
z = mul xor z shr z 27 0x94d049bb133111eb
ret xor z shr z 31
end

note a number below n
fn pick n ulong to ulong
ret rem rnd n
end

note ======== strings

fn sc c ulong to void
n = get st 8
if ge n 65536
die webig 5
end
put gs n uchar c
put st 8 add n 1
end

note the string h again at the end of the arena
fn sh h ulong to void
o = shr h 16
for i ulong and h 65535 bound 65536
sc ulong get gs add o i
end
end

fn su v ulong to void
i = udec v
while lt i 24 bound 24
sc ulong get dg i
i = add i 1
end
end

note a new string: t with @ replaced by the string x, % by the string y and # by k in decimal
fn tp t view uchar * x ulong y ulong k ulong to ulong
b = get st 8
for i ulong len t bound 65536
c = ulong get t i
if eq c 64
sh x
end
if eq c 37
sh y
end
if eq c 35
su k
end
if and and ne c 64 ne c 37 ne c 35
sc c
end
end
ret or shl b 16 sub get st 8 b
end

note the string h onto the statements
fn ph h ulong to void
o = shr h 16
for i ulong and h 65535 bound 65536
n = get st 9
if ge n 16384
die webig 5
end
put pre n get gs add o i
put st 9 add n 1
end
end

note the template t onto the statements
fn pt t view uchar * x ulong y ulong k ulong to void
ph tp t x y k
end

note a new temporary's name
fn tnew to ulong
k = add get st 1 1
put st 1 k
ret tp wtmp 0 0 k
end

fn res c ulong e ulong l ulong to void
put st 3 c
put st 4 e
put st 5 l
put st 22 0
end

note ======== values of the arguments

note how many names a value can use: the arguments of shapes 1 to 3, or inside an array loop
note (st 20 = 1) the item x and its index i
fn nv to ulong
if eq get st 20 1
ret 2
end
ret get st 2
end

note the name of argument k (inside an array loop: 0 the item, 1 its index)
fn gvn k ulong to ulong
if eq get st 20 1
if eq k 0
ret tp wvx 0 0 0
end
ret tp wvi 0 0 0
end
if eq k 0
ret tp wva 0 0 0
end
if eq k 1
ret tp wvb 0 0 0
end
ret tp wvc 0 0 0
end

note the wording of argument k
fn gve k ulong to ulong
if eq get st 20 1
if eq k 0
ret tp weitem 0 0 0
end
ret tp weidx 0 0 0
end
if eq get st 2 1
ret tp wearg 0 0 0
end
ret gvn k
end

note one argument. Inside an array loop it is the item; its index only as a second operand
note (st 21 = 1), so every value there is about the item.
fn gvar to void
k = pick nv
if eq get st 20 1
k = 0
q = pick 2
if and eq get st 21 1 eq q 0
k = 1
end
end
res gvn k gve k 3
end

note the number k as a value
fn gk k ulong to void
h = tp wnum 0 0 k
res h h 3
end

note the arguments taken together (shapes 2 and 3): their sum, product, larger, smaller, distance.
note Their wording is a noun phrase with no `and` in it (level 2).
fn gcoll to void
s = get st 2
k = pick 5
if and eq k 4 eq s 3
k = 0
end
if eq k 0
if eq s 2
res tp wcs2 0 0 0 tp wes2 0 0 0 2
ret
end
res tp wcs3 0 0 0 tp wes3 0 0 0 2
ret
end
if eq k 1
if eq s 2
res tp wcp2 0 0 0 tp wep2 0 0 0 2
ret
end
res tp wcp3 0 0 0 tp wep3 0 0 0 2
ret
end
h = tnew
if eq k 2
pt wpmx2 h 0 0
if eq s 3
pt wpmx3 h 0 0
res h tp wemx3 0 0 0 2
ret
end
res h tp wemx2 0 0 0 2
ret
end
if eq k 3
pt wpmn2 h 0 0
if eq s 3
pt wpmn3 h 0 0
res h tp wemn3 0 0 0 2
ret
end
res h tp wemn2 0 0 0 2
ret
end
pt wpds2 h 0 0
res h tp weds2 0 0 0 2
end

note a value with no parts: one argument, or the arguments taken together
fn gleaf to void
q = pick 4
if and and eq get st 20 0 ge get st 2 2 eq q 0
gcoll
ret
end
gvar
end

note whether the strings x and y are the same text
fn hsame x ulong y ulong to bool
n = and x 65535
if ne n and y 65535
ret false
end
a = shr x 16
b = shr y 16
for i ulong n bound 65536
if ne get gs add a i get gs add b i
ret false
end
end
ret true
end

note a second operand whose code differs from c: a value with no parts, or after four tries a
note number (a failed try is a single name and leaves no statement behind)
fn gother c ulong to void
put st 21 1
for i ulong 4
gleaf
if not hsame c get st 3
put st 21 0
ret
end
end
put st 21 0
gk add 2 pick 9
end

note the second operand of larger, smaller, distance and minus for the value with code c: a
note number, or a value with no parts that differs from it
fn gsec c ulong to void
q = pick 4
u = ulong 1
if eq nv 1
u = 3
end
if lt q u
v = add 1 pick 20
if eq v 20
v = 100
end
if eq v 19
v = 50
end
gk v
ret
end
gother c
end

note a value with d levels of parts whose wording has level m or more. A looser one is dropped
note with its strings and statements and made again; after six tries, a value with no parts.
note With m = 4 it wants what may stand before `plus`: level 2 or more, or `X times Y` (st 22).
fn gvl d ulong m ulong to void
a = get st 8
b = get st 9
t = get st 1
for i ulong 6
gval d
l = get st 5
if and eq m 4 or ge l 2 eq get st 22 1
ret
end
if and lt m 4 ge l m
ret
end
put st 8 a
put st 9 b
put st 1 t
end
gleaf
end

note the level of a closed phrase around the value just made: 2, or 1 when that holds an `and`
fn lv1 to ulong
if ge get st 5 2
ret 2
end
ret 1
end

note the square: a single name is written twice, anything longer goes through a temporary
fn nsq d ulong to void
gvl d 1
c = get st 3
e = get st 4
if eq get st 5 3
res tp wcsq c 0 0 tp wesq e 0 0 2
ret
end
l = ulong 1
h = tnew
pt wpset h c 0
res tp wcsq h 0 0 tp wesqo e 0 0 l
end

fn nmk d ulong to void
gvl d 1
c = get st 3
e = get st 4
l = lv1
k = add 2 pick 8
h = tp wcmk c 0 k
if eq k 2
res h tp wem2 e 0 0 l
ret
end
if eq k 3
res h tp wem3 e 0 0 l
ret
end
res h tp wemk e 0 k l
end

fn nak d ulong to void
gvl d 2
c = get st 3
e = get st 4
k = add 1 pick 13
if eq k 13
k = 100
end
h = tp wcak c 0 k
if eq k 1
res h tp wea1 e 0 0 0
ret
end
if eq k 2
res h tp wea2 e 0 0 0
ret
end
if eq k 3
res h tp wea3 e 0 0 0
ret
end
res h tp weak e 0 k 0
end

fn ndk d ulong to void
gvl d 2
c = get st 3
e = get st 4
k = add 2 pick 9
h = tp wcdk c 0 k
if and eq k 2 eq get st 5 3
res h tp wed2 e 0 0 0
ret
end
res h tp wedk e 0 k 0
end

fn nrk d ulong to void
gvl d 2
c = get st 3
e = get st 4
l = ulong 1
k = add 2 pick 10
if and and eq k 10 eq get st 5 3 lt pick 2 1
res tp wcrk c 0 k tp welast e 0 0 1
ret
end
res tp wcrk c 0 k tp werk e 0 k l
end

note a sum. Its operands are tight (level 2 or 3) or the first is `X times Y` (st 22), so `plus`
note reads one way; two names are sometimes said as `the sum of X and Y`.
fn nsum d ulong to void
gvl d 4
c = get st 3
e = get st 4
l = get st 5
gother c
h = tp wcadd c get st 3 0
q = pick 3
if and and eq l 3 eq get st 5 3 eq q 0
res h tp wesum e get st 4 0 1
ret
end
res h tp weplus e get st 4 0 0
end

note a product: two names are mostly `X times Y` (loose, but good before `plus`: st 22 = 1)
fn nprod d ulong to void
gvl d 2
c = get st 3
e = get st 4
l = get st 5
gother c
h = tp wcmul c get st 3 0
q = pick 10
if and and eq l 3 eq get st 5 3 lt q 6
res h tp wetimes e get st 4 0 0
put st 22 1
ret
end
res h tp weprod e get st 4 0 1
end

note the larger (mx) or the smaller of a value and a second operand, through a temporary
fn nmm d ulong mx bool to void
gvl d 2
c = get st 3
e = get st 4
gsec c
y = get st 3
h = tnew
pt wpset h c 0
if mx
pt wpifl h y 0
else
pt wpifg h y 0
end
pt wpsete h y 0
if mx
res h tp wemax e get st 4 0 1
ret
end
res h tp wemin e get st 4 0 1
end

fn ndist d ulong to void
gvl d 2
c = get st 3
e = get st 4
gsec c
y = get st 3
h = tnew
pt wpset h tp wcsub c y 0 0
pt wpif tp wclt c y 0 0 0
pt wpsete h tp wcsub y c 0 0
res h tp wedist e get st 4 0 1
end

note bits of two different arguments, or the low byte when there is one argument
fn nbit to void
s = nv
if eq s 1
gvar
res tp wclow get st 3 0 0 tp welow get st 4 0 0 1
ret
end
i = pick s
j = rem add add i 1 pick sub s 1 s
x = gvn i
y = gvn j
u = gve i
v = gve j
k = pick 3
if eq k 0
res tp wcand x y 0 tp weand u v 0 1
ret
end
if eq k 1
res tp wcor x y 0 tp webor u v 0 1
ret
end
res tp wcxor x y 0 tp wexor u v 0 1
end

fn nshift to void
gvar
c = get st 3
e = get st 4
k = add 1 pick 4
if lt pick 2 1
h = tp wcshl c 0 k
if eq k 1
res h tp wesl1 e 0 0 0
ret
end
res h tp weslk e 0 k 0
ret
end
h = tp wcshr c 0 k
if eq k 1
res h tp wesr1 e 0 0 0
ret
end
res h tp wesrk e 0 k 0
end

note a value with d levels of parts. Its code stays short: over 40 bytes it moves to a temporary,
note so no expression outgrows the compiler's registers however the parts nest.
fn gval d ulong to void
gval1 d
c = get st 3
if le and c 65535 40
ret
end
h = tnew
pt wpset h c 0
put st 3 h
end

fn gval1 d ulong to void
if eq d 0
gleaf
ret
end
k = pick 16
e = sub d 1
if lt k 2
nsq e
ret
end
if lt k 4
nmk e
ret
end
if lt k 6
nak e
ret
end
if lt k 7
ndk e
ret
end
if lt k 8
nrk e
ret
end
if lt k 10
nsum e
ret
end
if lt k 12
nprod e
ret
end
if lt k 13
nmm e true
ret
end
if lt k 14
nmm e false
ret
end
if lt k 15
ndist e
ret
end
if lt pick 2 1
nbit
ret
end
nshift
end

note ======== conditions on the arguments

note a condition on one value (code c, wording e): its test in st 3, its wording in st 4
fn gcu c ulong e ulong to void
k = pick 7
if eq k 0
res tp wq0 c 0 0 tp wf0 e 0 0 0
ret
end
if eq k 1
res tp wq1 c 0 0 tp wf1 e 0 0 0
ret
end
if eq k 2
res tp wq2 c 0 0 tp wf2 e 0 0 0
ret
end
if eq k 3
res tp wq3 c 0 0 tp wf3 e 0 0 0
ret
end
v = add 1 pick 12
if eq k 4
res tp wq4 c 0 v tp wf4 e 0 v 0
ret
end
if eq k 5
res tp wq5 c 0 v tp wf5 e 0 v 0
ret
end
v = add 3 pick 5
res tp wq6 c 0 v tp wf6 e 0 v 0
end

note one condition: on a value with no parts, or between two different arguments
fn gc1 to void
s = nv
q = pick 10
if and ge s 2 lt q 3
i = pick s
j = rem add add i 1 pick sub s 1 s
x = gvn i
y = gvn j
u = gve i
v = gve j
k = pick 3
if eq k 0
res tp wq7 x y 0 tp wf7 u v 0 0
ret
end
if eq k 1
res tp wq8 x y 0 tp wf8 u v 0 0
ret
end
res tp wq9 x y 0 tp wf9 u v 0 0
ret
end
d = pick 2
if eq nv 1
d = 1
end
gvl d 2
gcu get st 3 get st 4
end

note a condition; with two or three arguments, sometimes one on each of two different arguments
note joined by and or by or
fn gcond to void
s = nv
q = pick 4
if or eq s 1 ge q 1
gc1
ret
end
i = pick s
j = rem add add i 1 pick sub s 1 s
gcu gvn i gve i
c = get st 3
e = get st 4
gcu gvn j gve j
if lt pick 2 1
res tp wcand2 c get st 3 0 tp weand2 e get st 4 0 0
ret
end
res tp wcor2 c get st 3 0 tp weor2 e get st 4 0 0
end

note ======== scalar records: the last statements in st 3, the instruction in st 4

note return X when C, otherwise Y
fn gcv to void
gcond
c = get st 3
e = get st 4
gval pick 2
x = get st 3
y = get st 4
gval pick 2
if hsame x get st 3
gk add 2 pick 9
end
h = tp wewhen y e 0
f = tp wfif c x 0
res tp wfcat f get st 3 0 tp wcat h get st 4 0 0
end

fn gbool to void
gcond
res tp wfb1 get st 3 0 0 tp web1 get st 4 0 0 0
end

note X minus Y when X is at least Y, otherwise zero
fn gsat to void
gvl pick 2 2
c = get st 3
e = get st 4
gsec c
res tp wfsat c get st 3 0 tp wesat e get st 4 0 0
end

note how many of the arguments are even, above a number, and so on
fn gcount to void
s = get st 2
k = pick 7
v = add 1 pick 9
if eq k 6
v = add 2 pick 4
end
ph tp wpk0 0 0 0
for i ulong s
x = gvn i
if eq k 0
pt wpkif tp wq0 x 0 0 0 0
end
if eq k 1
pt wpkif tp wq1 x 0 0 0 0
end
if eq k 2
pt wpkif tp wq2 x 0 0 0 0
end
if eq k 3
pt wpkif tp wq3 x 0 0 0 0
end
if eq k 4
pt wpkif tp wq4 x 0 v 0 0
end
if eq k 5
pt wpkif tp wq5 x 0 v 0 0
end
if eq k 6
pt wpkif tp wq6 x 0 v 0 0
end
end
gcnt2 k v
end

note the wording and the last statement of gcount for kind k and number v
fn gcnt2 k ulong v ulong to void
h = tp wa0 0 0 0
if eq k 1
h = tp wa1 0 0 0
end
if eq k 2
h = tp wa2 0 0 0
end
if eq k 3
h = tp wa3 0 0 0
end
if eq k 4
h = tp wa4 0 0 v
end
if eq k 5
h = tp wa5 0 0 v
end
if eq k 6
h = tp wa6 0 0 v
end
if eq get st 2 2
res tp wfretk 0 0 0 tp wecnt2 h 0 0 0
ret
end
res tp wfretk 0 0 0 tp wecnt3 h 0 0 0
end

note one scalar record
fn gsc to void
k = pick 20
if lt k 11
d = add 2 pick 2
q = pick 20
if and lt q 2 ge get st 2 2
d = 1
end
gval d
res tp wfret get st 3 0 0 tp weret get st 4 0 0 0
ret
end
if lt k 15
gcv
ret
end
if lt k 18
gbool
ret
end
if or lt k 19 eq get st 2 1
gsat
ret
end
gcount
end

note ======== arrays

note what an item can be: the test in st 3, the wording for several in st 4, for one in st 5.
note Shape 5 leaves out the tests against the first item, which it may have changed; st 19 = 1
note leaves out the tests of the index (a scan for the first item at an even index says nothing).
fn gpred to void
k = pick 15
if and eq get st 2 5 and ge k 9 le k 11
k = sub k 9
end
if and eq get st 19 1 and ge k 12 le k 13
k = sub k 12
end
if eq k 0
h = tp wpp0 0 0 0
res tp wpc0 0 0 0 h h
ret
end
if eq k 1
h = tp wpp1 0 0 0
res tp wpc1 0 0 0 h h
ret
end
if eq k 2
h = tp wpp2 0 0 0
res tp wpc2 0 0 0 h h
ret
end
if eq k 3
h = tp wpp3 0 0 0
res tp wpc3 0 0 0 h h
ret
end
gpred2 k
end

fn gpred2 k ulong to void
v = add 1 pick 9
if eq k 4
h = tp wpp4 0 0 v
res tp wpc4 0 0 v h h
ret
end
if eq k 5
h = tp wpp5 0 0 v
res tp wpc5 0 0 v h h
ret
end
if eq k 6
v = add 2 pick 6
res tp wpc6 0 0 v tp wpp6 0 0 v tp wps6 0 0 v
ret
end
if eq k 7
res tp wpc7 0 0 0 tp wpp7 0 0 0 tp wps7 0 0 0
ret
end
if eq k 8
res tp wpc8 0 0 0 tp wpp8 0 0 0 tp wps8 0 0 0
ret
end
gpred3 k
end

fn gpred3 k ulong to void
if eq k 9
h = tp wpp9 0 0 0
res tp wpc9 0 0 0 h h
ret
end
if eq k 10
h = tp wpp10 0 0 0
res tp wpc10 0 0 0 h h
ret
end
if eq k 11
h = tp wpp11 0 0 0
res tp wpc11 0 0 0 h h
ret
end
if eq k 12
res tp wpc12 0 0 0 tp wpp12 0 0 0 tp wps12 0 0 0
ret
end
if eq k 13
res tp wpc13 0 0 0 tp wpp13 0 0 0 tp wps13 0 0 0
ret
end
v = pick 10
h = tp wpp14 0 0 v
res tp wpc14 0 0 v h h
end

note the sum of the items, of their squares or of the items times their index, of all or of
note those that pass a test, then perhaps a last step
fn gasum to void
f = pick 4
p = ulong 1
if lt pick 4 1
p = 0
end
c = ulong 0
e = ulong 0
if eq p 1
gpred
c = get st 3
e = get st 4
end
ph tp wrs0 0 0 0
if eq p 1
pt wrif c 0 0
end
h = tp wers 0 0 0
if lt f 2
pt wrsadd tp wfx 0 0 0 0 0
if eq p 1
h = tp wersp e 0 0
end
end
if eq f 2
pt wrsadd tp wfxx 0 0 0 0 0
h = tp wersq 0 0 0
if eq p 1
h = tp wersqp e 0 0
end
end
if eq f 3
pt wrsadd tp wfxi 0 0 0 0 0
h = tp wersi 0 0 0
if eq p 1
h = tp wersip e 0 0
end
end
if eq p 1
ph tp wrend 0 0 0
end
ph tp wrend 0 0 0
gapost h
end

note the last step of a sum whose wording is h
fn gapost h ulong to void
g = pick 10
if lt g 6
res tp wfrets 0 0 0 tp weret h 0 0 0
ret
end
if eq g 6
v = add 2 pick 9
res tp wfrem 0 0 v tp wgrem h 0 v 0
ret
end
if eq g 7
res tp wfmuln 0 0 0 tp wgmuln h 0 0 0
ret
end
if eq g 8
v = add 1 pick 9
res tp wfaddk 0 0 v tp wgaddk h 0 v 0
ret
end
res tp wftwo 0 0 0 tp wgtwo h 0 0 0
end

note the product of the items, of all or of those that pass a test
fn gaprod to void
if lt pick 6 1
ph tp wrp0 0 0 0
ph tp wrpmul 0 0 0
ph tp wrend 0 0 0
res tp wfrets 0 0 0 tp werp 0 0 0 0
ret
end
gpred
c = get st 3
e = get st 4
ph tp wrp0 0 0 0
pt wrif c 0 0
ph tp wrpmul 0 0 0
ph tp wrend 0 0 0
ph tp wrend 0 0 0
res tp wfrets 0 0 0 tp werpp e 0 0 0
end

note the largest of the items, of all or of those that pass a test
fn gamax to void
k = pick 8
if ge k 4
k = 0
end
if eq k 0
gpred
c = get st 3
e = get st 4
ph tp wrm0 0 0 0
pt wrmgp c 0 0
ph tp wrend 0 0 0
res tp wfretm 0 0 0 tp weret tp werlp e 0 0 0 0 0
ret
end
ph tp wrm0 0 0 0
ph tp wrmg 0 0 0
ph tp wrend 0 0 0
if eq k 1
res tp wfretm 0 0 0 tp weret tp werl 0 0 0 0 0 0
ret
end
if eq k 2
res tp wftwom 0 0 0 tp weret tp werl2 0 0 0 0 0 0
ret
end
res tp wfmulm 0 0 0 tp weret tp werln 0 0 0 0 0 0
end

note the smallest of the items, of all or of those that pass a test
fn gamin to void
k = pick 8
if ge k 4
k = 0
end
ph tp wrn0 0 0 0
if eq k 0
gpred
pt wrif get st 3 0 0
e = get st 4
ph tp wrnl 0 0 0
ph tp wrend 0 0 0
ph tp wrend 0 0 0
res tp wfretm 0 0 0 tp weret tp wernp e 0 0 0 0 0
ret
end
ph tp wrnl 0 0 0
ph tp wrend 0 0 0
if eq k 1
res tp wfretm 0 0 0 tp weret tp wern 0 0 0 0 0 0
ret
end
if eq k 2
res tp wftwom 0 0 0 tp weret tp wern2 0 0 0 0 0 0
ret
end
res tp wfmulm 0 0 0 tp weret tp wernn 0 0 0 0 0 0
end

note the first or the last item that passes a test, whether one does, whether all do
fn gascan to void
put st 19 1
gpred
put st 19 0
c = get st 3
e = get st 5
k = pick 5
if eq k 0
res tp wsc0 c 0 0 tp wse0 e 0 0 0
ret
end
if eq k 1
res tp wsc1 c 0 0 tp wse1 e 0 0 0
ret
end
if eq k 2
res tp wsc2 c 0 0 tp wse2 e 0 0 0
ret
end
if eq k 3
res tp wsc3 c 0 0 tp wse3 e 0 0 0
ret
end
res tp wsc4 c 0 0 tp wse4 e 0 0 0
end

note how many items are greater than, smaller than, equal to or different from the one before
fn ganb to void
k = pick 4
if eq k 0
res tp wnc tp wngt 0 0 0 0 0 tp wne tp wngte 0 0 0 0 0 0
ret
end
if eq k 1
res tp wnc tp wnlt 0 0 0 0 0 tp wne tp wnlte 0 0 0 0 0 0
ret
end
if eq k 2
res tp wnc tp wneq 0 0 0 0 0 tp wne tp wneqe 0 0 0 0 0 0
ret
end
res tp wnc tp wnne 0 0 0 0 0 tp wne tp wnnee 0 0 0 0 0 0
end

note the sum over the items, or over those that pass a test, of a value made from the item and
note its index; the value's temporaries land inside the loop, after x
fn gasumv to void
p = pick 2
c = ulong 0
e = ulong 0
if eq p 1
gpred
c = get st 3
e = get st 4
end
ph tp wrs0 0 0 0
if eq p 1
pt wrif c 0 0
end
put st 20 1
gval add 1 pick 2
put st 20 0
pt wrsadd get st 3 0 0
h = tp wersv get st 4 0 0
if eq p 1
ph tp wrend 0 0 0
h = tp wersvp get st 4 e 0
end
ph tp wrend 0 0 0
gapost h
end

note one record of shape 4
fn gar to void
k = pick 40
if lt k 6
gpred
res tp wr1c get st 3 0 0 tp wr1e get st 4 0 0 0
ret
end
if lt k 12
gasum
ret
end
if lt k 24
gasumv
ret
end
if lt k 26
gaprod
ret
end
if lt k 30
gamax
ret
end
if lt k 34
gamin
ret
end
if lt k 39
gascan
ret
end
ganb
end

note what an item becomes: its code in st 3, its wording in st 4, in st 5 1 when it reads f (the
note first item's original value), 2 when it does not read x
fn gf to void
k = pick 14
v = add 2 pick 8
if eq k 0
res tp wfc0 0 0 0 tp wfe0 0 0 0 0
ret
end
if eq k 1
h = tp wfc1 0 0 v
if eq v 2
res h tp wfe12 0 0 0 0
ret
end
if eq v 3
res h tp wfe13 0 0 0 0
ret
end
res h tp wfe1 0 0 v 0
ret
end
if eq k 2
v = add 1 pick 12
res tp wfc2 0 0 v tp wfe2 0 0 v 0
ret
end
if eq k 3
res tp wfc3 0 0 0 tp wfe3 0 0 0 2
ret
end
if eq k 4
res tp wfc4 0 0 0 tp wfe4 0 0 0 2
ret
end
gf2 k v
end

fn gf2 k ulong v ulong to void
if eq k 5
res tp wfc5 0 0 v tp wfe5 0 0 v 0
ret
end
if eq k 6
u = pick 13
if eq u 0
res tp wnum 0 0 0 tp wzero 0 0 0 2
ret
end
h = tp wnum 0 0 u
res h h 2
ret
end
if eq k 7
res tp wfc7 0 0 0 tp wfe7 0 0 0 0
ret
end
if eq k 8
res tp wfc8 0 0 0 tp wfe8 0 0 0 0
ret
end
if eq k 9
h = tp wfc9 0 0 v
if eq v 2
res h tp wfe92 0 0 0 0
ret
end
res h tp wfe9 0 0 v 0
ret
end
gf3 k v
end

fn gf3 k ulong v ulong to void
if eq k 10
res tp wfc10 0 0 v tp wfe10 0 0 v 2
ret
end
if eq k 11
h = tp wfc11 0 0 v
if eq v 2
res h tp wfe112 0 0 0 2
ret
end
res h tp wfe11 0 0 v 2
ret
end
if eq k 12
res tp wfc12 0 0 0 tp wfe12f 0 0 0 3
ret
end
res tp wfc13 0 0 0 tp wfe13f 0 0 0 1
end

note replace each item, or every item that passes a test, with what gf chose
fn gamap cond bool to void
gf
c = get st 3
e = get st 4
l = get st 5
if eq and l 1 1
ph tp wwf 0 0 0
end
if cond
gpred
pt wwif get st 3 c 0
res 0 tp wweif get st 5 e 0 0
ret
end
if eq and l 2 2
pt wwalln c 0 0
else
pt wwall c 0 0
end
res 0 tp wweall e 0 0 0
end

note each item becomes something of all items up to and including it
fn garun to void
k = pick 10
if eq k 0
ph tp wwx 0 0 0
res 0 tp wwex 0 0 0 0
ret
end
if eq k 1
ph tp wwo 0 0 0
res 0 tp wweo 0 0 0 0
ret
end
if eq k 2
ph tp wwp 0 0 0
res 0 tp wwep 0 0 0 0
ret
end
if eq k 3
ph tp wws 0 0 0
res 0 tp wwes 0 0 0 0
ret
end
if eq k 4
ph tp wwq 0 0 0
res 0 tp wweq 0 0 0 0
ret
end
gpred
pt wwk get st 3 0 0
res 0 tp wwek get st 4 0 0 0
end

note add to or multiply the items, said with the verb first
fn gaverb to void
k = pick 12
v = add 1 pick 9
if lt k 2
pt wwadd 0 0 v
res 0 tp wweadd 0 0 v 0
ret
end
if lt k 4
v = add 2 pick 8
pt wwmul 0 0 v
res 0 tp wwemul 0 0 v 0
ret
end
if lt k 11
gpred
pt wwaddp get st 3 0 v
res 0 tp wweaddp get st 5 0 v 0
ret
end
ph tp wwidx 0 0 0
res 0 tp wweidx 0 0 0 0
end

note replace each item, or every item that passes a test, with a value made from the item and
note its index; the value's temporaries land inside the loop, after x
fn gamapv to void
p = pick 2
e = ulong 0
ph tp wwv0 0 0 0
if eq p 1
gpred
pt wrif get st 3 0 0
e = get st 5
end
put st 20 1
gval add 1 pick 2
put st 20 0
if eq p 1
pt wwvputp get st 3 0 0
res 0 tp wweif e get st 4 0 0
ret
end
pt wwvput get st 3 0 0
res 0 tp wweall get st 4 0 0 0
end

note one record of shape 5
fn gaw to void
k = pick 20
if lt k 4
gamap false
ret
end
if lt k 8
gamap true
ret
end
if lt k 16
gamapv
ret
end
if lt k 18
garun
ret
end
gaverb
end

note ======== tasks

fn osig s ulong to void
if eq s 1
ot wsg1
end
if eq s 2
ot wsg2
end
if eq s 3
ot wsg3
end
if eq s 4
ot wsg4
end
if eq s 5
ot wsg5
end
end

note the statements gathered in pre
fn opre to void
for i ulong get st 9 bound 16384
oc ulong get pre i
end
end

note the shared input lines of the benchmark task file mem[b, e)
fn oinputs b ulong e ulong to void
p = b
while lt p e bound 9223372036854775807
q = p
while and lt q e ne get mem q 10 bound 9223372036854775807
q = add q 1
end
if or or or or sw p q wlin1 sw p q wlin2 sw p q wlin3 sw p q wlarr sw p q wlcnt
omem p sub q p
oc 10
end
p = add q 1
end
end

note whether mem[p, q) starts with t
fn sw p ulong q ulong t view uchar * to bool
n = len t
if gt n sub q p
ret false
end
for i ulong n bound 65536
if ne get mem add p i get t i
ret false
end
end
ret true
end

note task i of seed sd: one random record in the form bench.om reads
fn otask sd ulong i ulong to void
put st 1 0
put st 8 0
put st 9 0
s = add 1 pick 5
put st 2 s
if le s 3
gsc
end
if eq s 4
gar
end
if eq s 5
gaw
end
ot wltask
ou sd
oc 45
ou i
ot wlgen
og get st 4
ot wlfn
ou i
oc 32
osig s
oc 10
opre
og get st 3
ot wlend
end

fn cmdtasks to void
if ne argcnt 5
die weargs 2
end
b = aload 2
sd = anum 3
n = anum 4
oinputs b get st 6
put st 0 sd
for i ulong n bound 9223372036854775807
otask sd i
end
oflush
end

note ======== keep

note the end of the line that starts at p (its newline, or e)
fn lnend p ulong e ulong to ulong
q = p
while and lt q e ne get mem q 10 bound 9223372036854775807
q = add q 1
end
ret q
end

note the start of the text after the first space of mem[p, q), or q
fn tail p ulong q ulong to ulong
o = p
while and lt o q ne get mem o 32 bound 9223372036854775807
o = add o 1
end
if lt o q
ret add o 1
end
ret q
end

fn same a ulong n ulong b ulong m ulong to bool
if ne n m
ret false
end
for i ulong n bound 9223372036854775807
if ne get mem add a i get mem add b i
ret false
end
end
ret true
end

note whether the results mem[a, a + n) are the results of a row of EXPECT
fn inexp a ulong n ulong to bool
p = get st 11
e = get st 12
while lt p e bound 9223372036854775807
q = lnend p e
o = tail p q
if same a n o sub q o
ret true
end
p = add q 1
end
ret false
end

note the next row of ROWS: whether its results are in no row of EXPECT
fn rowok to bool
p = get st 13
e = get st 18
if ge p e
die wefmt 6
end
q = lnend p e
put st 13 add q 1
o = tail p q
ret not inexp o sub q o
end

note the record whose `fn t` line is mem[p, q) and whose body is mem[b, z)
fn orec p ulong q ulong b ulong z ulong to void
o = tail add p 3 q
oc 0
ot wrnote
omem get st 16 get st 17
ot wrsolve
omem o sub q o
oc 10
omem b sub z b
end

note the tasks of GEN mem[b, e), each with its row
fn keepall b ulong e ulong to void
p = b
while lt p e bound 9223372036854775807
q = lnend p e
if sw p q wlsay
put st 16 add p 9
put st 17 sub q add p 9
end
if sw p q wlfnt
z = add q 1
k = true
while k bound 9223372036854775807
if ge z e
die wefmt 6
end
y = lnend z e
if sw z y wleor
k = false
else
z = add y 1
end
end
if rowok
orec p q add q 1 z
put st 14 add get st 14 1
else
put st 15 add get st 15 1
end
q = lnend z e
end
p = add q 1
end
end

fn cmdkeep to void
if ne argcnt 5
die weargs 2
end
b = aload 2
e = get st 6
r = aload 3
put st 13 r
put st 18 get st 6
x = aload 4
put st 11 x
put st 12 get st 6
keepall b e
if lt get st 13 get st 18
die wefmt 6
end
oflush
put st 7 0
ot wmkeep
ou add get st 14 get st 15
ot wmkept
ou get st 14
ot wmdrop
ou get st 15
oc 10
w = write 2 ob 0 get st 7
end

fn main to int
if lt argcnt 2
die weargs 2
end
if iscmd wctasks
cmdtasks
ret 0
end
if iscmd wckeep
cmdkeep
ret 0
end
die weargs 2
ret 2
end

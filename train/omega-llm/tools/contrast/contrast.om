note Build after wbuild.om. Write adjacent contrasting records to standard output.
text ctl "fn "
text hint "note "
text spc " "
text nl "\n"
text fin "\nend\n"
text retprefix "ret "
text sig " ulong "
text viewarg " view ulong "
text tail " ulong to ulong\n"
text lefts "a|x|left|first|u|val|"
text rights "b|y|right|second|v|other|"
text arrays "a|items|data|buf|values|arr|"
text sizes "n|count|size|used|limit|length|"
text names "calc|apply|compute|measure|reduce|value|"
text verbs "return |compute |find |give |calculate |report |"
text tasks "the absolute difference|the sum|the smaller value|the larger value|the bitwise exclusive OR|the product|the XOR of the first entries|the sum of the first entries|the largest of the first entries|the number of zeros in the first entries|"
text other "the unsigned gap between the two operands|both values added together|the minimum of the two operands|the maximum of the two operands|the bitwise XOR of the operands|both values multiplied together|the bitwise exclusive OR of the prefix|the total across the prefix|the prefix maximum|the count of zeros in the prefix|"
text adds "add "
text muls "mul "
text xors "xor "
text subs "sub "
text less "if lt "
text greater "if gt "
text closeelse "\nend\nret "
text start "s = ulong 0\nfor i ulong "
text value "get "
text index " i"
text acc "\ns = "
text zero "\nif eq "
text maxcond "\nif gt "
text assign " s\ns = "
text incr " 0\ns = add s 1"
text finishloop "\nend\nret s"
text endinside "\nend"
text accum "s "
fn entry table view uchar * which ulong to void
k = ulong 0
for i ulong len table
v = get table i
if eq v 124
if eq k which
ret
end
k = add k 1
else
if eq k which
wdoc ulong v
end
end
end
exit 72
end
fn pair v ulong reverse bool to void
if reverse
entry rights v
wdot spc
entry lefts v
else
entry lefts v
wdot spc
entry rights v
end
end
fn readitem v ulong to void
wdot value
entry arrays v
wdot index
end
fn body op ulong v ulong to void
if lt op 6
if or eq op 0 or eq op 2 eq op 3
if eq op 3
wdot greater
else
wdot less
end
pair v false
wdot nl
wdot retprefix
if eq op 0
wdot subs
pair v true
wdot closeelse
wdot subs
pair v false
else
entry lefts v
wdot closeelse
entry rights v
end
else
wdot retprefix
if eq op 1
wdot adds
else
if eq op 4
wdot xors
else
wdot muls
end
end
pair v false
end
else
wdot start
entry sizes v
if lt op 8
wdot acc
if eq op 6
wdot xors
else
wdot adds
end
wdot accum
readitem v
else
if eq op 8
wdot maxcond
readitem v
wdot assign
readitem v
else
wdot zero
readitem v
wdot incr
end
wdot endinside
end
wdot finishloop
end
wdot fin
end
fn main to int
put wdofd 0 1
for g ulong 144
v = rem g 6
nam = rem add div g 6 rem g 6 6
verb = rem add div g 36 div g 6 6
for j ulong 10
op = rem add mul j 7 g 10
wdoc 0
wdot hint
entry verbs verb
if eq rem div g 6 2 0
entry tasks op
else
entry other op
end
wdot nl
wdot ctl
entry names nam
wdot spc
if lt op 6
entry lefts v
wdot sig
entry rights v
else
entry arrays v
wdot viewarg
wdod add 4 mul 4 rem div g 6 4
wdot spc
entry sizes v
end
wdot tail
body op v
end
end
wdoflush 1
ret 0
end

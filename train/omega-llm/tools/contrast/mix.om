om2
note Shuffle complete NUL-prefixed records from the two source files.
text old "old.om"
text newpath "contrast.om"
text target "mixed.om"
global corpus uchar *
global starts ulong *
global ids ulong *
fn append path view uchar * to void
fd = int fopen path 0 len path 0 0
if lt fd 0
exit 70
end
size = fseek fd 0 2
if le size 0
exit 72
end
if ne fseek fd 0 0 0
exit 70
end
base = len corpus
stop = add base ulong size
if le stop base
exit 70
end
rc = enlarge corpus stop
if lt rc 0
exit 70
end
off = base
for attempt ulong ulong size bound 9223372036854775807
n = read fd corpus off sub stop off
if le n 0
exit 70
end
off = add off ulong n
if eq off stop
break
end
end
if ne fclose fd 0
exit 70
end
if ne get corpus base 0
exit 72
end
end
fn makeindex to ulong
count = ulong 0
for i ulong len corpus bound 9223372036854775807
if eq get corpus i 0
count = add count 1
end
end
rc = enlarge starts add count 1
if lt rc 0
exit 70
end
rc = enlarge ids count
if lt rc 0
exit 70
end
k = ulong 0
for i ulong len corpus bound 9223372036854775807
if eq get corpus i 0
put starts k i
put ids k k
k = add k 1
end
end
put starts count len corpus
ret count
end
fn putrecord fd int k ulong to void
off = get starts k
stop = get starts add k 1
for attempt ulong sub stop off bound 9223372036854775807
r = write fd corpus off sub stop off
if le r 0
exit 70
end
off = add off ulong r
if eq off stop
ret
end
end
end
fn main to int
append old
append newpath
n = makeindex
seed = ulong 123456789
for i ulong sub n 1 bound 9223372036854775807
last = sub sub n i 1
seed = add mul seed 6364136223846793005 1442695040888963407
j = rem shr seed 16 add last 1
tmp = get ids last
put ids last get ids j
put ids j tmp
end
fd = int fopen target 0 len target 193 384
if lt fd 0
ret 70
end
for i ulong n bound 9223372036854775807
putrecord fd get ids i
end
ret int fclose fd
end

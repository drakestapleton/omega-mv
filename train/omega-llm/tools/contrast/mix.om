om2
note Mix the two NUL-separated source corpora. Each retained record is copied whole.
text old "old.om"
text newpath "contrast.om"
text target "mixed.om"
global starts ulong 16384
global widths ulong 16384
global origin ulong 16384
global counts ulong 1
fn loadfile path view uchar * buf edit uchar * to ulong
fd = fopen path 0 len path 0 0
if lt fd 0
exit 70
end
n = ulong 0
while lt n len buf bound 1048577
r = read int fd buf n sub len buf n
if lt r 0
exit 70
end
if eq r 0
break
end
n = add n ulong r
end
if eq n len buf
exit 70
end
rc = fclose int fd
ret n
end
fn scan buf view uchar * n ulong kind ulong to void
if or eq n 0 ne get buf 0 0
exit 72
end
for i ulong n
if eq get buf i 0
k = get counts 0
if ge k len starts
exit 72
end
put starts k i
put origin k kind
put widths k sub n i
if gt i 0
z = sub k 1
put widths z sub i get starts z
end
put counts 0 add k 1
end
end
end
fn putrecord fd int buf view uchar * k ulong to void
off = get starts k
n = get widths k
while gt n 0 bound 1048577
r = write fd buf off n
if le r 0
exit 70
end
off = add off ulong r
n = sub n ulong r
end
end
fn main to int
a = new uchar 1048576 0
b = new uchar 1048576 0
ids = new ulong 16384 0
na = loadfile old a
nb = loadfile newpath b
scan a na 0
for rep ulong 1
scan b nb 1
end
n = get counts 0
for i ulong n
put ids i i
end
seed = ulong 123456789
for i ulong sub n 1
last = sub sub n i 1
seed = add mul seed 6364136223846793005 1442695040888963407
j = rem shr seed 16 add last 1
tmp = get ids last
put ids last get ids j
put ids j tmp
end
fd = fopen target 0 len target 193 384
if lt fd 0
ret 70
end
for i ulong n
k = get ids i
if eq get origin k 0
putrecord int fd a k
else
putrecord int fd b k
end
end
ret int fclose int fd
end

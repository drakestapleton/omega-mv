note mean CONTROL TREATMENT NEW_OUTPUT. Link after the pinned native model source with main renamed.
global meanheader uchar 112
fn meaninputs to void
ockload 1
if ne get og 46 2
exit 12
end
if ne oprd 1 0 0 112 112
exit 10
end
for i ulong 112
put meanheader i get opw i
end
ockload 2
if ne get og 46 2
exit 12
end
if ne oprd 2 0 0 112 112
exit 10
end
for i ulong 112
if ne get meanheader i get opw i
exit 12
end
end
end
fn meanblock start ulong n ulong to void
nb = mul n 8
if ne oprd 1 add 120 mul start 8 0 nb nb
exit 10
end
for k ulong n
i = add start k
left = bitcast f64 opw8 mul k 8
right = owg i
owp i mul add left right 0.5f64
omvp add get og 11 i 0.0f64
omvp add get og 12 i 0.0f64
end
end
note Reserve a new file before writing. Publish its valid CK02 header only after the payload is complete.
fn meansave to void
pl = oargp 3
fd = int fopen oarg 0 pl 193 384
if lt fd 0
exit 73
end
put ocfd 0 fd
digest = ocbody 0 3 120
ochead 3616473253210246223 0
ocput8 104 get og 44
ocput8 112 digest
ocwput 0 120
if ne fsync fd 0
exit 70
end
if ne fclose fd 0
exit 70
end
end
fn main to int
if ne oargc 4
ret 2
end
pl = oargp 3
fd = fopen oarg 0 pl 0 0
if ge fd 0
cl = fclose int fd
ret 73
end
meaninputs
p = get og 8
i = ulong 0
while lt i p bound 999999
n = sub p i
if gt n OCKC
n = OCKC
end
meanblock i n
i = add i n
end
put og 41 0
meansave
ret 0
end

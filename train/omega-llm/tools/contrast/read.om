fn pickread fd int dest edit uchar * to ulong
if lt fd 0
exit 74
end
used = ulong 0
while lt used len dest bound 8193
n = read fd dest used sub len dest used
if lt n 0
exit 74
end
if eq n 0
break
end
used = add used ulong n
end
cl = fclose fd
if eq used len dest
exit 74
end
ret used
end
fn pickload a ulong dest edit uchar * to ulong
wdpclr
wdpa a
ret pickread wdopen 0 0 dest
end

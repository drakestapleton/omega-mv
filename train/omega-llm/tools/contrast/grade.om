note grade PANEL OMC [cached | GPU CK MERGES]. Fresh output directory for every invocation.
text fieldprompt "prompt"
text fieldmain "main"
text fieldref "reference"
text samplecmd "gsample"
text seedval "42"
text limitval "64"
text tempval "0"
text infile "input.om"
text binary "./app"
text nilfile "/dev/null"
text outname "answer-"
text sep " "
text lf "\n"
text cachedarg "cached"
fn argis i ulong val view uchar * to bool
n = wdarg i
if ne n len val
ret false
end
for k ulong n
if ne get wdab k get val k
ret false
end
end
ret true
end
fn fdesc path view uchar * flags int to int
wdpclr
wdpt path
fd = wdopen flags 448
if lt fd 0
exit 70
end
ret fd
end
fn jsontext src view uchar 262144 tape view uint 262144 obj ulong which ulong dst edit uchar * to ulong
k = js_first tape obj
while ne k jsnone bound 4294967295
off = js_off tape k
ok = false
if eq which 0
ok = js_streq src off fieldprompt
else
if eq which 1
ok = js_streq src off fieldmain
else
ok = js_streq src off fieldref
end
end
if ok
n = js_sget src js_off tape add k 1 dst
if lt n 0
exit 72
end
ret ulong n
end
k = js_mnext tape k
end
exit 72
end
fn sampleone prompt view uchar * fd int to void
wdkclr
wdka 3
wdkt samplecmd
wdka 4
wdkt seedval
wdkt limitval
wdkt tempval
wdkt prompt
wdka 5
if ne wdwait wdspawn -1 fd -1 0
exit 73
end
end
fn strict to long
wdkclr
wdkt binary
pn = wdkfin
pid = fork
if lt pid 0
exit 70
end
if eq pid 0
fd = fdesc nilfile 2
for i ulong 3
if ne dupfd fd int i 0 long i
exit 125
end
end
rc = execpure wdk 0 pn
exit 126
end
ret wdwait pid
end
global lengths ulong 3
fn compile prompt view uchar 4096 answer view uchar * checker view uchar 65536 to long
fd = fdesc infile 577
wdwrall fd prompt get lengths 0
wdwrall fd answer len answer
wdwrall fd lf 1
wdwrall fd checker get lengths 2
cc = fclose fd
fi = fdesc infile 0
fo = fdesc binary 577
fe = fdesc nilfile 1
wdkclr
wdka 2
rc = wdwait wdspawn fi fo fe
ca = fclose fi
cb = fclose fo
cd = fclose fe
if eq rc 127
exit 73
end
ret rc
end
fn terminates a view uchar * i ulong to bool
if lt i 2
ret false
end
if gt i 2
if ne get a sub i 3 10
ret false
end
end
if lt add i 1 len a
if ne get a add i 1 10
ret false
end
end
if ne get a sub i 2 101
ret false
end
if ne get a sub i 1 110
ret false
end
ret eq get a i 100
end
fn testanswer p view uchar 4096 ans view uchar 8192 checker view uchar 65536 to ulong
for i ulong get lengths 1
if terminates part ans 0 get lengths 1 i
rc = compile p part ans 0 add i 1 checker
if eq rc 0
r = strict
if or eq r 125 eq r 126
exit 70
end
if eq r 77
ret 2
end
ret 1
end
end
end
ret 0
end
fn pathfor j ulong to void
wdpclr
wdpt outname
wdpd j
end
fn readanswer j ulong ans edit uchar * to ulong
pathfor j
fi = wdopen 0 0
n = read fi ans 0 len ans
c2 = fclose fi
if or lt n 0 eq n long len ans
exit 72
end
ret ulong n
end
fn genrow src view uchar 262144 tape view uint 262144 obj ulong j ulong to void
p = new uchar 4096 0
ans = new uchar 8192 0
pn = jsontext src tape obj 0 p
pathfor j
fd = wdopen 193 384
if lt fd 0
exit 70
end
if eq argcnt 3
an = jsontext src tape obj 2 ans
wdwrall fd ans an
else
sampleone part p 0 pn fd
end
cl = fclose fd
end
fn checkrow p view uchar 4096 ans view uchar 8192 ck view uchar 65536 to ulong
ret testanswer p ans ck
end
fn testrow src view uchar 262144 tape view uint 262144 obj ulong j ulong to ulong
p = new uchar 4096 0
ck = new uchar 65536 0
ans = new uchar 8192 0
pn = jsontext src tape obj 0 p
cn = jsontext src tape obj 1 ck
n = readanswer j ans
put lengths 0 pn
put lengths 1 n
put lengths 2 cn
ret checkrow p ans ck
end
fn main to int
if and ne argcnt 4 and ne argcnt 3 ne argcnt 6
ret 2
end
if eq argcnt 4
if not argis 3 cachedarg
ret 2
end
end
src = new uchar 262144 0
tape = new uint 262144 0
wdpclr
wdpa 1
fd = wdopen 0 0
if lt fd 0
ret 70
end
n = read fd src 0 len src
if or lt n 1 eq n long len src
ret 72
end
if lt js_init tape 262144 128 0
ret 72
end
if lt js_parse src tape ulong n 0
ret 72
end
if ne js_type tape 0 jsarr
ret 72
end
obj = js_first tape 0
j = ulong 0
while ne obj jsnone bound 4294967295
if ne argcnt 4
genrow src tape obj j
end
res = testrow src tape obj j
wdod j
wdot sep
wdod res
wdot lf
wdoflush 1
if and eq argcnt 3 ne res 2
ret 1
end
j = add j 1
obj = js_enext tape obj
end
if eq j 0
ret 72
end
ret 0
end

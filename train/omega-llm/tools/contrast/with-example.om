note with-example PROMPT OMC SAMPLER MERGES EXAMPLE_MAIN CK [CK ...]
note EXAMPLE_MAIN defines a seeded main that returns 77 for success. Use a fresh working directory.
text genfile "sample.raw"
text okmsg "accepted checkpoint "
text none "no generated answer passed the example\n"
fn draw p view uchar * j ulong a edit uchar * to ulong
fd = fdesc genfile 577
wdkclr
wdka 3
wdkt samplecmd
wdka add 6 j
wdkt seedval
wdkt limitval
wdkt tempval
wdkt p
wdka 4
rc = wdwait wdspawn -1 fd -1
cl = fclose fd
if ne rc 0
exit 73
end
ret pickread fdesc genfile 0 a
end
fn accepted p view uchar 4096 a view uchar * n ulong c view uchar 65536 to bool
for i ulong n
if terminates part a 0 n i
if eq compile p part a 0 add i 1 c 0
r = strict
if or eq r 125 eq r 126
exit 70
end
if eq r 77
wdwrall 1 a add i 1
wdwrall 1 lf 1
ret true
end
break
end
end
end
ret false
end
fn main to int
if lt argcnt 7
ret 2
end
p = new uchar 4096 0
a = new uchar 8192 0
c = new uchar 65536 0
pn = pickload 1 p
put lengths 0 pn
put lengths 2 pickload 5 c
for j ulong sub ulong argcnt 6
n = draw part p 0 pn j a
if accepted p a n c
wdot okmsg
wdod add j 1
wdot lf
wdoflush 2
ret 0
end
end
wdwrall 2 none len none
ret 3
end

note select EXAMPLE_PANEL OMC FIRST_DIR SECOND_DIR THIRD_DIR [compile]. Each directory contains answer-N.
note Use a fresh working directory. Selected function bodies are written as answer-N for independent grading.
text slash "/"
text compilearg "compile"
fn copyanswer a ulong j ulong to void
wdpclr
wdpa a
wdpt slash
wdpt outname
wdpd j
fi = wdopen 0 0
if lt fi 0
exit 74
end
pathfor j
fo = wdopen 577 384
if lt fo 0
exit 74
end
wdcopyfd fi fo
ca = fclose fi
cb = fclose fo
end
fn choose src view uchar 262144 tape view uint 262144 obj ulong j ulong to ulong
for k ulong 3
copyanswer add k 3 j
grade = testrow src tape obj j
if or eq grade 2 and eq argcnt 7 eq grade 1
ret add k 1
end
end
pathfor j
empty = wdopen 577 384
if lt empty 0
exit 74
end
cl = fclose empty
ret 0
end
fn main to int
if and ne argcnt 6 ne argcnt 7
ret 2
end
if eq argcnt 7
if not argis 6 compilearg
ret 2
end
end
src = new uchar 262144 0
tape = new uint 262144 0
wdpclr
wdpa 1
fd = wdopen 0 0
if lt fd 0
ret 70
end
n = read fd src 0 len src
cl = fclose fd
if or lt n 1 eq n long len src
ret 72
end
if lt js_init tape 262144 128 0
ret 72
end
if lt js_parse src tape ulong n 0
ret 72
end
if ne js_type tape 0 jsarr
ret 72
end
obj = js_first tape 0
j = ulong 0
while ne obj jsnone bound 4294967295
chosen = choose src tape obj j
wdod j
wdot sep
wdod chosen
wdot lf
wdoflush 1
j = add j 1
obj = js_enext tape obj
end
if eq j 0
ret 72
end
ret 0
end

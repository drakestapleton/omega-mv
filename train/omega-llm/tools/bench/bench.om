if or ge a q meq a wordend a q lnote
ret
end
first = true
while lt a q bound 9223372036854775807
w = wordend a q
if not first
nc 32
end
first = false
nword a sub w a
a = skipsp w q
end
nc 10
end

fn nword a ulong n ulong to void
i = nmfind a n
if lt i get st 25
nc 118
d = udec i
while lt d 24 bound 24
nc ulong get dg d
d = add d 1
end
ret
end
for j ulong n bound 9223372036854775807
nc ulong get mem add a j
end
end


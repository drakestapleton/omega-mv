note ======== table and check

note build and run the table program; the table's offset in mem (it ends at the fill)
fn mktable to ulong
gtable
s = compile
if ne s 0
dien ecomp ulong s 1
end
s = runp true
if ne s 0
dien ecomp ulong s 1
end
wpath fpout
b = get st 6
if eq fload 18446744073709551615
die eio 70
end
ret b
end

fn cmdtable to void
if ne argcnt 5
die eargs 2
end
put st 27 3
put st 26 4
ltasks 2
b = mktable
omem b sub get st 6 b
oflush
end

note the fields in which the rows mem[a, ae) and mem[b, be) differ (both start after their id)
fn rowdiff a ulong ae ulong b ulong be ulong to ulong
n = ulong 0
p = skipsp a ae
q = skipsp b be
while and lt p ae lt q be bound 9223372036854775807
w = wordend p ae
x = wordend q be
if not mm p sub w p q sub x q
n = add n 1
end
p = skipsp w ae
q = skipsp x be
end
ret n
end

note the start of row i of the table at mem[b, e) (rows are lines), checking that it carries task
note i's id; the row's values start after the id
fn rowat b ulong e ulong i ulong to ulong
p = b
for j ulong i bound 9223372036854775807
p = add lend p e 1
end
if ge p e
dien eexp i 66
end
w = wordend p lend p e
if not mm p sub w p tfd i 0 tfd i 1
dien eexp i 66
end
ret w
end

note the smallest number of differing fields over every pair of tasks of one shape in the table at
note mem[b, e); each pair that does not differ at all is printed
fn minsep b ulong e ulong to ulong
m = ulong 18446744073709551615
nt = get st 0
for i ulong nt bound 9223372036854775807
a = rowat b e i
for j ulong i bound 9223372036854775807
if eq tfd i 10 tfd j 10
c = rowat b e j
d = rowdiff a lend a e c lend c e
if eq d 0
ot msame
omem tfd j 0 tfd j 1
oc 32
omem tfd i 0 tfd i 1
oc 10
end
if lt d m
m = d
end
end
end
end
ret m
end

fn cmdcheck to void
if ne argcnt 6
die eargs 2
end
put st 27 4
put st 26 5
ltasks 2
xb = aload 3
xe = get st 6
b = mktable
e = get st 6
ok = mm xb sub xe xb b sub e b
if not ok
ot mdiff
end
m = minsep b e
if eq m 0
ok = false
end
if ok
ot mpass
else
ot mfail
end
ou get st 0
ot mcase
ou get st 1
ot msep
ou m
oc 10
oflush
if not ok
exit 1
end
end


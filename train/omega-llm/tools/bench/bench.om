text gpre "fn prv v ulong to void\nd = new uchar 24 0\ni = ulong 24\nx = v\nk = true\nwhile k bound 24\ni = sub i 1\nput d i uchar add 48 rem x 10\nx = div x 10\nif eq x 0\nk = false\nend\nend\ni = sub i 1\nput d i 32\nw = write 1 d i sub 24 i\nend\nfn prl to void\nd = new uchar 1 10\nw = write 1 d 0 1\nend\nfn pra a view ulong 8 to void\nfor i ulong 8\nprv get a i\nend\nend\n"
text gfill0 "fn bench_fill a edit ulong 8 k ulong to void\n"

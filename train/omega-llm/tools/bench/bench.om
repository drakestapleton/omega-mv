note mem holds every file read (tasks, expectations, an answer, a corpus, a table) one after the
note other; st[6] is the fill. prog is the program or prompt being generated (st[2] bytes).
note tk has 16 words per task: 0 id, 1 its length, 2 family, 3 length, 4 instruction, 5 length,
note 6 params, 7 length, 8 body, 9 length (through the closing end, no newline), 10 shape, 11 the
note reference's name, 12 length, 13 normal form in nrm, 14 length, 15 verdict or seen mark.
note inp has 3 words per input line: kind (1 .. 3 scalar shapes, 4 arr, 5 cnt), text, length.
note nrm holds normal forms (st[24] bytes), nmt the (offset, length) names of the function being
note normalised (st[25] names).
note st: 0 tasks, 1 input lines, 2 prog bytes, 3 path bytes, 4 packet bytes, 5 stdout bytes, 6 mem
note fill, 7 packet records, 8 9 pending instruction, 10 11 pending id, 12 13 pending family, 14
note task pending, 15 arr lines, 16 cnt lines, 17 18 19 in1 in2 in3 lines, 26 WORK argument, 27 OMC
note argument, 28 29 the expectation cursor and its row end.
global mem uchar *
global prog uchar *
global tk ulong *
global inp ulong *
global nrm uchar *
global nmt ulong *
global st ulong 32
global pth uchar 4096
global pk uchar 65536
global wst uchar 4
global ob uchar 65536
global dg uchar 24

note ======== stdout, stderr

fn oflush to void
n = get st 5
if gt n 0
w = write 1 ob 0 n
put st 5 0
end
end

fn oc c ulong to void
n = get st 5
if ge n 65536
oflush
n = 0
end
put ob n uchar c
put st 5 add n 1
end

fn ot t view uchar * to void
for i ulong len t bound 9223372036854775807
oc ulong get t i
end
end

fn omem o ulong n ulong to void
for i ulong n bound 9223372036854775807
oc ulong get mem add o i
end
end

note v in decimal into dg; the index of its first digit (digits end at 24)
fn udec v ulong to ulong
i = ulong 24
x = v
k = true
while k bound 24
i = sub i 1
put dg i uchar add 48 rem x 10
x = div x 10
if eq x 0
k = false
end
end
ret i
end

fn ou v ulong to void
i = udec v
while lt i 24 bound 24
oc ulong get dg i
i = add i 1
end
end

note message t on stderr, then exit c
fn die t view uchar * c int to void
oflush
w = write 2 t 0 len t
exit c
end

note message t, the number v and a newline on stderr, then exit c
fn dien t view uchar * v ulong c int to void
oflush
w = write 2 t 0 len t
i = udec v
w = write 2 dg i sub 24 i
put dg 0 10
w = write 2 dg 0 1
exit c
end

note ======== paths and files

fn pclr to void
put st 3 0
end

fn pch c ulong to void
n = get st 3
if ge n 4096
die epath 64
end
put pth n uchar c
put st 3 add n 1
end

fn ptx t view uchar * to void
for i ulong len t
pch ulong get t i
end
end

note argument i onto the path
fn parg i ulong to void
n = get st 3
r = argread i pth n sub 4096 n
if lt r 0
die eargs 2
end
put st 3 add n ulong r
end

note the path WORK/t
fn wpath t view uchar * to void
pclr
parg get st 26
pch 47
ptx t
end

note the path WORK/t followed by task i's id
fn wpid t view uchar * i ulong to void
wpath t
o = tfd i 0
for j ulong tfd i 1 bound 4096
pch ulong get mem add o j
end
end

note the file at the path into mem at the fill; its length, or 2^64 - 1 when it cannot be opened
fn fload to ulong
fd = fopen pth 0 get st 3 0 0
if lt fd 0
ret 18446744073709551615
end
sz = fseek int fd 0 2
if lt sz 0
die eio 70
end
z = fseek int fd 0 0
b = get st 6
e = add b ulong sz
r = enlarge mem add e 1
if lt r 0
die eio 70
end
o = b
while lt o e bound 9223372036854775807
k = read int fd mem o sub e o
if le k 0
die eio 70
end
o = add o ulong k
end
z = fclose int fd
put st 6 e
ret ulong sz
end

note argument i's file into mem; its offset (the length is the new fill minus it)
fn aload i ulong to ulong
pclr
parg i
b = get st 6
if eq fload 18446744073709551615
die eio 70
end
ret b
end

note the path opened for reading, or created and emptied with mode md when wr
fn popen wr bool md int to int
r = long 0
if wr
r = fopen pth 0 get st 3 577 md
else
r = fopen pth 0 get st 3 0 0
end
if lt r 0
die eio 70
end
ret int r
end

note prog[0, st2) into the path, created with mode md
fn fsave md int to void
fd = popen true md
n = get st 2
o = ulong 0
while lt o n bound 9223372036854775807
k = write fd prog o sub n o
if le k 0
die eio 70
end
o = add o ulong k
end
z = fclose fd
end

note ======== the generated text

fn gc c ulong to void
n = get st 2
if ge n len prog
r = enlarge prog add mul n 2 4096
if lt r 0
die eio 70
end
end
put prog n uchar c
put st 2 add n 1
end

fn gtx t view uchar * to void
for i ulong len t bound 9223372036854775807
gc ulong get t i
end
end

fn gmem o ulong n ulong to void
for i ulong n bound 9223372036854775807
gc ulong get mem add o i
end
end

fn gu v ulong to void
i = udec v
while lt i 24 bound 24
gc ulong get dg i
i = add i 1
end
end

note ======== processes

fn kclr to void
put st 4 2
put st 7 0
end

fn kb c ulong to void
n = get st 4
if ge n 65536
die epack 64
end
put pk n uchar c
put st 4 add n 1
end

note start a record of n bytes
fn krec n ulong to void
if gt n 65535
die epack 64
end
kb and n 255
kb shr n 8
put st 7 add get st 7 1
end

note the path as the next record
fn kpath to void
n = get st 3
krec n
for i ulong n bound 4096
kb ulong get pth i
end
end

fn ktx t view uchar * to void
krec len t
for i ulong len t
kb ulong get t i
end
end

note argument i as the next record
fn karg i ulong to void
pclr
parg i
kpath
end

note prog[0, st2) as the next record
fn kprog to void
n = get st 2
krec n
for i ulong n bound 65536
kb ulong get prog i
end
end

fn kfin to void
n = get st 7
put pk 0 uchar and n 255
put pk 1 uchar shr n 8
end

note the child: fi is stdin, fo stdout, stderr /dev/null; pure runs the packet under execpure
fn child fi int fo int pure bool to void
r = dupfd fi 0 0
r = dupfd fo 1 0
fd = fopen tnull 0 len tnull 1 0
if ge fd 0
r = dupfd int fd 2 0
end
if pure
r = execpure pk 0 get st 4
else
r = execprog pk 0 get st 4
end
exit 127
end

fn spawn fi int fo int pure bool to long
kfin
pid = fork
if lt pid 0
die eio 70
end
if eq pid 0
child fi fo pure
end
ret pid
end

note wait for pid at most ms milliseconds: its exit status, 256 + the signal that ended it, or
note 1000 when the deadline passed and it was killed
fn waitp pid long ms ulong to long
dl = add ulong monons mul ms 1000000
w = long 0
while eq w 0 bound 9223372036854775807
w = waitpid int pid wst 0 4 1
if eq w 0
if ge ulong monons dl
r = killpid int pid 9
w = waitpid int pid wst 0 4 0
ret 1000
end
r = sleepns 500000
end
end
if lt w 0
die eio 70
end
sig = and ulong get wst 0 127
if ne sig 0
ret long add 256 sig
end
ret long get wst 1
end

note compile WORK/bench-p.om (prog, saved here) into WORK/bench-p; the compiler's status
fn compile to long
wpath fpsrc
fsave 420
fi = popen false 0
wpath fpbin
fo = popen true 493
kclr
karg get st 27
pid = spawn fi fo false
z = fclose fi
z = fclose fo
ret waitp pid 60000
end

note run WORK/bench-p under execpure, stdout into WORK/bench-out when tofile; its status
fn runp tofile bool to long
pclr
ptx tnull
fi = popen false 0
fo = int 0
if tofile
wpath fpout
fo = popen true 420
else
r = fopen pth 0 get st 3 1 0
if lt r 0
die eio 70
end
fo = int r
end
wpath fpbin
kclr
kpath
pid = spawn fi fo true
z = fclose fi
z = fclose fo
s = waitp pid 10000
if eq s 127
die esand 70
end
ret s
end

note ======== reading TASKS

note the newline that ends the line at p, or e
fn lend p ulong e ulong to ulong
q = p
while lt q e bound 9223372036854775807
if eq get mem q 10
ret q
end
q = add q 1
end
ret e
end

note the end of the word at p: the next space, tab or e
fn wordend p ulong e ulong to ulong
q = p
while lt q e bound 9223372036854775807
c = get mem q
if or eq c 32 eq c 9
ret q
end
q = add q 1
end
ret e
end

note p moved over spaces and tabs, not past e
fn skipsp p ulong e ulong to ulong
q = p
while lt q e bound 9223372036854775807
c = get mem q
if and ne c 32 ne c 9
ret q
end
q = add q 1
end
ret e
end

note whether mem[p, e) starts with t
fn sw p ulong e ulong t view uchar * to bool
n = len t
if gt add p n e
ret false
end
for i ulong n
if ne get mem add p i get t i
ret false
end
end
ret true
end

note whether mem[p, e) is exactly t
fn meq p ulong e ulong t view uchar * to bool
if ne sub e p len t
ret false
end
ret sw p e t
end

note whether mem[a, a + n) equals mem[b, b + m)
fn mm a ulong n ulong b ulong m ulong to bool
if ne n m
ret false
end
for i ulong n bound 9223372036854775807
if ne get mem add a i get mem add b i
ret false
end
end
ret true
end

fn bad p ulong to void
dien etask p 65
end

note the decimal number mem[p, e) (1 to 20 digits)
fn dec p ulong e ulong to ulong
if or ge p e gt sub e p 20
bad p
end
v = ulong 0
q = p
while lt q e bound 20
c = ulong get mem q
if or lt c 48 gt c 57
bad p
end
v = add mul v 10 sub c 48
q = add q 1
end
ret v
end

note the number of words in mem[p, e), each a decimal number
fn nwords p ulong e ulong to ulong
n = ulong 0
q = skipsp p e
while lt q e bound 9223372036854775807
w = wordend q e
x = dec q w
n = add n 1
q = skipsp w e
end
ret n
end

fn tfd i ulong k ulong to ulong
ret get tk add mul i 16 k
end

fn tput i ulong k ulong v ulong to void
put tk add mul i 16 k v
end

fn ifd r ulong k ulong to ulong
ret get inp add mul r 3 k
end

note an input line of kind k with text mem[o, e): its word count must fit the kind
fn addinp k ulong o ulong e ulong to void
want = k
if eq k 4
want = 8
end
if eq k 5
want = 1
end
if ne nwords o e want
bad o
end
n = get st 1
r = enlarge inp mul add n 1 3
if lt r 0
die eio 70
end
b = mul n 3
put inp b k
put inp add b 1 o
put inp add b 2 sub e o
put st 1 add n 1
if le k 3
put st add 16 k add get st add 16 k 1
end
if eq k 4
put st 15 add get st 15 1
end
if eq k 5
put st 16 add get st 16 1
end
end

note the record of the j-th input line of kind k
fn inth k ulong j ulong to ulong
c = ulong 0
for r ulong get st 1 bound 9223372036854775807
if eq ifd r 0 k
if eq c j
ret r
end
c = add c 1
end
end
die eio 70
ret 0
end

note the kind of the line mem[p, q): 1 .. 5 an input, 6 task, 7 say, 8 a function, 0 other
fn lkind p ulong q ulong to ulong
if sw p q lin1
ret 1
end
if sw p q lin2
ret 2
end
if sw p q lin3
ret 3
end
if sw p q larr
ret 4
end
if sw p q lcnt
ret 5
end
if sw p q ltask
ret 6
end
if sw p q lsay
ret 7
end
if sw p q lfn
ret 8
end
ret 0
end

note whether the first word of the line mem[p, q) is t
fn fw p ulong q ulong t view uchar * to bool
a = skipsp p q
ret meq a wordend a q t
end

note one past the line end of the `end` that closes the function whose body starts at b (so the
note result minus 1 is that line's newline, or e), 0 when it is not closed before e
fn bodyend b ulong e ulong to ulong
d = ulong 1
p = b
while lt p e bound 9223372036854775807
q = lend p e
if or fw p q twif or fw p q twwhile fw p q twfor
d = add d 1
end
if fw p q twend
d = sub d 1
if eq d 0
ret add q 1
end
end
p = add q 1
end
ret 0
end

note the shape of the params mem[o, q)
fn shapeof o ulong q ulong to ulong
if meq o q sg1
ret 1
end
if meq o q sg2
ret 2
end
if meq o q sg3
ret 3
end
if meq o q sg4
ret 4
end
if meq o q sg5
ret 5
end
bad o
ret 0
end

note `note task ID FAMILY` at mem[p, q)
fn ptask p ulong q ulong to void
w = wordend p q
if or eq w p ge add w 1 q
bad p
end
put st 10 p
put st 11 sub w p
put st 12 add w 1
put st 13 sub q add w 1
put st 14 1
put st 9 0
end

note the reference function whose `fn ` is at p, its line ending at q: a task; the newline (or
note e) that ends its closing end
fn pfn p ulong q ulong e ulong to ulong
if or eq get st 14 0 eq get st 9 0
bad p
end
nm = add p 3
w = wordend nm q
if or ge w q ne get mem nm 116
bad p
end
z = bodyend add q 1 e
if eq z 0
bad p
end
n = get st 0
r = enlarge tk mul add n 1 16
if lt r 0
die eio 70
end
pfn2 n nm w q
tput n 9 sub sub z 1 add q 1
put st 0 add n 1
put st 14 0
ret sub z 1
end

fn pfn2 n ulong nm ulong w ulong q ulong to void
tput n 0 get st 10
tput n 1 get st 11
tput n 2 get st 12
tput n 3 get st 13
tput n 4 get st 8
tput n 5 get st 9
tput n 6 add w 1
tput n 7 sub q add w 1
tput n 8 add q 1
tput n 10 shapeof add w 1 q
tput n 11 nm
tput n 12 sub w nm
tput n 15 0
end

note TASKS at mem[b, e) into tk and inp
fn parse b ulong e ulong to void
p = b
while lt p e bound 9223372036854775807
q = lend p e
k = lkind p q
if and ge k 1 le k 5
addinp k add p 9 q
end
if eq k 6
ptask add p 10 q
end
if eq k 7
put st 8 add p 9
put st 9 sub q add p 9
end
if eq k 8
q = pfn p q e
end
p = add q 1
end
if or eq get st 0 0 eq get st 14 1
bad e
end
end

note argument i as TASKS
fn ltasks i ulong to void
b = aload i
parse b get st 6
end

note the cases of shape sh
fn ncases sh ulong to ulong
if le sh 3
ret get st add 16 sh
end
ret mul get st 15 get st 16
end

note ======== generated programs

note ` ulong X` for every word X of mem[o, o + n)
fn gargs o ulong n ulong to void
e = add o n
p = skipsp o e
while lt p e bound 9223372036854775807
w = wordend p e
gtx gsul
gmem p sub w p
p = skipsp w e
end
end

note the eight puts of arr line mem[o, o + n)
fn gfillr o ulong n ulong to void
e = add o n
p = skipsp o e
for i ulong 8
w = wordend p e
gtx gputa
gu i
gc 32
gmem p sub w p
gc 10
p = skipsp w e
end
end

note bench_fill: array k of the arr lines into a
fn gfill to void
gtx gfill0
for j ulong get st 15 bound 9223372036854775807
r = inth 4 j
gtx gifk
gu j
gc 10
gfillr ifd r 1 ifd r 2
gtx gend
end
gtx gend
end

note the scalar rows of task i (shape sh) for the table
fn growsc i ulong sh ulong to void
for j ulong ncases sh bound 9223372036854775807
r = inth sh j
gtx gprv
gmem tfd i 11 tfd i 12
gargs ifd r 1 ifd r 2
gc 10
end
end

note one array case of task i for the table: arr line a, cnt record rc
fn growa1 i ulong sh ulong a ulong rc ulong to void
gtx gfillc
gu a
gc 10
if eq sh 4
gtx gprv
end
gmem tfd i 11 tfd i 12
gtx garrul
gmem ifd rc 1 ifd rc 2
gc 10
if eq sh 5
gtx gpra
end
end

fn growar i ulong sh ulong to void

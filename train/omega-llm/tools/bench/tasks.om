note ======== one argument

note task u-001 arith
note say return the argument squared plus one
fn t001 a ulong to ulong
ret add mul a a 1
end

note task u-002 arith
note say return the cube of the argument
fn t002 a ulong to ulong
ret mul a mul a a
end

note task u-003 arith
note say return three times the argument minus half the argument rounded down
fn t003 a ulong to ulong
ret sub mul 3 a div a 2
end

note task u-004 branch
note say return half the argument when it is even, otherwise three times the argument plus one
fn t004 a ulong to ulong
if eq rem a 2 0
ret div a 2
end
ret add mul 3 a 1
end

note task u-005 loop
note say return how many times the argument can be halved, rounding down, before it becomes zero
fn t005 a ulong to ulong
c = ulong 0
x = a
while gt x 0 bound 64
x = div x 2
c = add c 1
end
ret c
end

note task u-006 bits
note say return the number of one bits in the argument
fn t006 a ulong to ulong
c = ulong 0
x = a
while gt x 0 bound 64
c = add c rem x 2
x = div x 2
end
ret c
end

note task u-007 digits
note say return the sum of the decimal digits of the argument
fn t007 a ulong to ulong
s = ulong 0
x = a
while gt x 0 bound 20
s = add s rem x 10
x = div x 10
end
ret s
end

note task u-008 digits
note say return the number of decimal digits of the argument, counting zero as one digit
fn t008 a ulong to ulong
c = ulong 1
x = a
while ge x 10 bound 20
x = div x 10
c = add c 1
end
ret c
end

note task u-009 digits
note say return the argument with its decimal digits in reverse order
fn t009 a ulong to ulong
r = ulong 0
x = a
while gt x 0 bound 20
r = add mul r 10 rem x 10
x = div x 10
end
ret r
end

note task u-010 digits
note say return the leading decimal digit of the argument
fn t010 a ulong to ulong
x = a
while ge x 10 bound 20
x = div x 10
end
ret x
end

note task u-011 branch
note say return 1 when the argument is a multiple of 3 or of 5, otherwise 0
fn t011 a ulong to ulong
if eq rem a 3 0
ret 1
end
if eq rem a 5 0
ret 1
end
ret 0
end

note task u-012 arith
note say return the argument rounded down to a multiple of 10
fn t012 a ulong to ulong
ret mul div a 10 10
end

note task u-013 branch
note say return the distance between the argument and 100
fn t013 a ulong to ulong
if lt a 100
ret sub 100 a
end
ret sub a 100
end

note task u-014 bits
note say return the argument with its lowest one bit cleared
fn t014 a ulong to ulong
ret and a sub a 1
end

note task u-015 bits
note say return the lowest one bit of the argument, or zero for zero
fn t015 a ulong to ulong
ret and a sub 0 a
end

note task u-016 loop
note say return the number of zero bits below the lowest one bit of the argument, or 64 for zero
fn t016 a ulong to ulong
if eq a 0
ret 64
end
c = ulong 0
x = a
while eq rem x 2 0 bound 64
x = div x 2
c = add c 1
end
ret c
end

note task u-017 loop
note say return the largest power of two that is not above the argument, or zero for zero
fn t017 a ulong to ulong
if eq a 0
ret 0
end
p = ulong 1
while le mul p 2 a bound 64
p = mul p 2
end
ret p
end

note task u-018 loop
note say return the largest whole number whose square is not above the argument
fn t018 a ulong to ulong
r = ulong 0
while le mul add r 1 add r 1 a bound 4294967296
r = add r 1
end
ret r
end

note task u-019 loop
note say count the steps until the argument reaches 1 when an even value is halved and an odd value is tripled and increased by one; return zero for 0 and 1
fn t019 a ulong to ulong
c = ulong 0
x = a
while gt x 1 bound 100000
if eq rem x 2 0
x = div x 2
else
x = add mul 3 x 1
end
c = add c 1
end
ret c
end

note task u-020 loop
note say return the smallest divisor of the argument that is above 1, or the argument itself when it is below 2
fn t020 a ulong to ulong
if lt a 2
ret a
end
d = ulong 2
while le mul d d a bound 4294967296
if eq rem a d 0
ret d
end
d = add d 1
end
ret a
end

note task u-021 loop
note say return 1 when the argument is a prime number, otherwise 0
fn t021 a ulong to ulong
if lt a 2
ret 0
end
d = ulong 2
while le mul d d a bound 4294967296
if eq rem a d 0
ret 0
end
d = add d 1
end
ret 1
end

note task u-022 arith
note say return the remainder of the argument divided by 7, times its remainder divided by 11
fn t022 a ulong to ulong
ret mul rem a 7 rem a 11
end

note task u-023 bits
note say return the low two bytes of the argument with their order exchanged
fn t023 a ulong to ulong
ret or shl and a 255 8 and shr a 8 255
end

note task u-024 bits
note say return the low 16 bits of the argument with every one of them inverted
fn t024 a ulong to ulong
ret and xor a 65535 65535
end

note task u-025 loop
note say return the binary digits of the argument in reverse order, without leading zeros
fn t025 a ulong to ulong
r = ulong 0
x = a
while gt x 0 bound 64
r = add mul r 2 rem x 2
x = div x 2
end
ret r
end

note task u-026 digits
note say return 1 when the decimal digits of the argument read the same in both directions, otherwise 0
fn t026 a ulong to ulong
r = ulong 0
x = a
while gt x 0 bound 20
r = add mul r 10 rem x 10
x = div x 10
end
if eq r a
ret 1
end
ret 0
end

note task u-027 loop
note say return the factorial of the argument when it is below 13, otherwise 0
fn t027 a ulong to ulong
if ge a 13
ret 0
end
f = ulong 1
for i ulong a
f = mul f add i 1
end
ret f
end

note task u-028 loop
note say return the Fibonacci number with the argument as its index, where index 0 gives 0 and index 1 gives 1, or 0 when the argument is 50 or more
fn t028 a ulong to ulong
if ge a 50
ret 0
end
x = ulong 0
y = ulong 1
for i ulong a
t = add x y
x = y
y = t
end
ret x
end

note task u-029 branch
note say return 0 for arguments below 10, 1 for arguments below 100, 2 for arguments below 1000 and 3 otherwise
fn t029 a ulong to ulong
if lt a 10
ret 0
end
if lt a 100
ret 1
end
if lt a 1000
ret 2
end
ret 3
end

note task u-030 arith
note say return the smallest multiple of 8 that is not below the argument
fn t030 a ulong to ulong
ret mul div add a 7 8 8
end

note task u-031 digits
note say return the product of the decimal digits of the argument, with 1 for zero
fn t031 a ulong to ulong
p = ulong 1
x = a
while gt x 0 bound 20
p = mul p rem x 10
x = div x 10
end
ret p
end

note task u-032 bits
note say return 1 when the argument is a power of two, otherwise 0
fn t032 a ulong to ulong
if eq a 0
ret 0
end
if eq and a sub a 1 0
ret 1
end
ret 0
end

note task u-033 loop
note say return the greatest common divisor of the argument and 360
fn t033 a ulong to ulong
x = a
y = ulong 360
while ne y 0 bound 64
t = rem x y
x = y
y = t
end
ret x
end

note task u-034 digits
note say return the hundreds digit of the argument
fn t034 a ulong to ulong
ret rem div a 100 10
end

note task u-035 digits
note say return how many decimal digits of the argument are even, with none for zero
fn t035 a ulong to ulong
c = ulong 0
x = a
while gt x 0 bound 20
if eq rem rem x 10 2 0
c = add c 1
end
x = div x 10
end
ret c
end

note ======== two arguments

note task p-001 arith
note say return the product of the arguments plus their sum
fn t036 a ulong b ulong to ulong
ret add mul a b add a b
end

note task p-002 arith
note say return the square of the sum of the arguments
fn t037 a ulong b ulong to ulong
s = add a b
ret mul s s
end

note task p-003 branch
note say return the square of the distance between the arguments
fn t038 a ulong b ulong to ulong
d = sub a b
if lt a b
d = sub b a
end
ret mul d d
end

note task p-004 branch
note say return a divided by b rounded down, or zero when b is zero
fn t039 a ulong b ulong to ulong
if eq b 0
ret 0
end
ret div a b
end

note task p-005 branch
note say return the remainder of a divided by b, or a itself when b is zero
fn t040 a ulong b ulong to ulong
if eq b 0
ret a
end
ret rem a b
end

note task p-006 loop
note say return the greatest common divisor of the arguments, which is the other argument when one of them is zero
fn t041 a ulong b ulong to ulong
x = a
y = b
while ne y 0 bound 200
t = rem x y
x = y
y = t
end
ret x
end

note task p-007 arith
note say return the sum of the squares of the arguments
fn t042 a ulong b ulong to ulong
ret add mul a a mul b b
end

note task p-008 branch
note say return 1 when the arguments are equal, 2 when a is larger and 3 when b is larger
fn t043 a ulong b ulong to ulong
if eq a b
ret 1
end
if gt a b
ret 2
end
ret 3
end

note task p-009 bits
note say return the bits that are one in a and zero in b
fn t044 a ulong b ulong to ulong
ret sub a and a b
end

note task p-010 loop
note say return the number of bit positions in which the arguments differ
fn t045 a ulong b ulong to ulong
c = ulong 0
x = xor a b
while gt x 0 bound 64
c = add c rem x 2
x = div x 2
end
ret c
end

note task p-011 arith
note say return twice a plus three times b
fn t046 a ulong b ulong to ulong
ret add mul 2 a mul 3 b
end

note task p-012 branch
note say return the smaller argument times the last decimal digit of the larger argument
fn t047 a ulong b ulong to ulong
lo = a
hi = b
if gt a b
lo = b
hi = a
end
ret mul lo rem hi 10
end

note task p-013 loop
note say return a raised to the power b when b is below 5, otherwise 0
fn t048 a ulong b ulong to ulong
if ge b 5
ret 0
end
r = ulong 1
for i ulong b
r = mul r a
end
ret r
end

note task p-014 branch
note say return a divided by b rounded down but never more than 100, or zero when b is zero
fn t049 a ulong b ulong to ulong
if eq b 0
ret 0
end
q = div a b
if gt q 100
ret 100
end
ret q
end

note task p-015 arith
note say return the average of the arguments rounded down
fn t050 a ulong b ulong to ulong
ret div add a b 2
end

note task p-016 branch
note say return the argument that is closer to 50, and a when both are equally close
fn t051 a ulong b ulong to ulong
da = sub a 50
if lt a 50
da = sub 50 a
end
db = sub b 50
if lt b 50
db = sub 50 b
end
if lt db da
ret b
end
ret a
end

note task p-017 branch
note say return a when a is even and b when a is odd
fn t052 a ulong b ulong to ulong
if eq rem a 2 0
ret a
end
ret b
end

note task p-018 bits
note say return the bits that are one in both arguments, moved one position to the left
fn t053 a ulong b ulong to ulong
ret shl and a b 1
end

note task p-019 bits
note say return a 16-bit value whose high byte is the low byte of a and whose low byte is the low byte of b
fn t054 a ulong b ulong to ulong
ret or shl and a 255 8 and b 255
end

note task p-020 loop
note say return the least common multiple of the arguments, or zero when either is zero
fn t055 a ulong b ulong to ulong
if eq a 0
ret 0
end
if eq b 0
ret 0
end
x = a
y = b
while ne y 0 bound 200
t = rem x y
x = y
y = t
end
ret mul div a x b
end

note task p-021 branch
note say return the sum of the arguments when it is below 100, otherwise 100
fn t056 a ulong b ulong to ulong
s = add a b
if lt s 100
ret s
end
ret 100
end

note task p-022 branch
note say return a minus b when a is at least b, otherwise zero
fn t057 a ulong b ulong to ulong
if ge a b
ret sub a b
end
ret 0
end

note task p-023 digits
note say return the two-digit number made of the last decimal digit of a followed by the last decimal digit of b
fn t058 a ulong b ulong to ulong
ret add mul rem a 10 10 rem b 10
end

note task p-024 digits
note say return the sum of the decimal digits of both arguments
fn t059 a ulong b ulong to ulong
s = ulong 0
x = a
while gt x 0 bound 20
s = add s rem x 10
x = div x 10
end
x = b
while gt x 0 bound 20
s = add s rem x 10
x = div x 10
end
ret s
end

note task p-025 branch
note say return 1 when exactly one of the arguments is zero, otherwise 0
fn t060 a ulong b ulong to ulong
if eq a 0
if ne b 0
ret 1
end
ret 0
end
if eq b 0
ret 1
end
ret 0
end

note task p-026 branch
note say return 1 when a is not zero and b is a multiple of a, otherwise 0
fn t061 a ulong b ulong to ulong
if eq a 0
ret 0
end
if eq rem b a 0
ret 1
end
ret 0
end

note task p-027 branch
note say return the square of the larger argument minus the square of the smaller argument
fn t062 a ulong b ulong to ulong
x = mul a a
y = mul b b
if ge a b
ret sub x y
end
ret sub y x
end

note task p-028 bits
note say return the low four bits of the positions where exactly one argument has a one
fn t063 a ulong b ulong to ulong
ret and xor a b 15
end

note task p-029 branch
note say return the larger argument when both arguments are odd, otherwise the smaller argument
fn t064 a ulong b ulong to ulong
lo = a
hi = b
if gt a b
lo = b
hi = a
end
if eq rem a 2 1
if eq rem b 2 1
ret hi
end
end
ret lo
end

note task p-030 digits
note say return how many decimal digits the two arguments have together, counting zero as one digit
fn t065 a ulong b ulong to ulong
c = ulong 2
x = a
while ge x 10 bound 20
x = div x 10
c = add c 1
end
x = b
while ge x 10 bound 20
x = div x 10
c = add c 1
end
ret c
end

note task p-031 arith
note say return the remainder of the sum of the arguments divided by 9
fn t066 a ulong b ulong to ulong
ret rem add a b 9
end

note task p-032 branch
note say return the middle value of a, b and 10
fn t067 a ulong b ulong to ulong
lo = a
hi = b
if gt a b
lo = b
hi = a
end
if lt 10 lo
ret lo
end
if gt 10 hi
ret hi
end
ret 10
end

note task p-033 bits
note say return a with one more bit set: the bit whose number is the remainder of b divided by 8
fn t068 a ulong b ulong to ulong
ret or a shl 1 rem b 8
end

note task p-034 bits
note say return the bit of a whose number is the remainder of b divided by 8, as 0 or 1
fn t069 a ulong b ulong to ulong
ret and shr a rem b 8 1
end

note ======== three arguments

note task t-001 arith
note say return a times b plus c
fn t070 a ulong b ulong c ulong to ulong
ret add mul a b c
end

note task t-002 branch
note say return the largest of the three arguments
fn t071 a ulong b ulong c ulong to ulong
m = a
if gt b m
m = b
end
if gt c m
m = c
end
ret m
end

note task t-003 branch
note say return the smallest of the three arguments
fn t072 a ulong b ulong c ulong to ulong
m = a
if lt b m
m = b
end
if lt c m
m = c
end
ret m
end

note task t-004 branch
note say return the middle value of the three arguments
fn t073 a ulong b ulong c ulong to ulong
if gt a b
if gt b c
ret b
end
if gt a c
ret c
end
ret a
end
if gt a c
ret a
end
if gt b c
ret c
end
ret b
end

note task t-005 arith
note say return the sum of the three arguments
fn t074 a ulong b ulong c ulong to ulong
ret add add a b c
end

note task t-006 branch
note say return how many of the three arguments equal the first one, counting the first itself
fn t075 a ulong b ulong c ulong to ulong
k = ulong 1
if eq b a
k = add k 1
end
if eq c a
k = add k 1
end
ret k
end

note task t-007 branch
note say return 1 when a is not above b and b is not above c, otherwise 0
fn t076 a ulong b ulong c ulong to ulong
if gt a b
ret 0
end
if gt b c
ret 0
end
ret 1
end

note task t-008 branch
note say return a when c is zero, otherwise b
fn t077 a ulong b ulong c ulong to ulong
if eq c 0
ret a
end
ret b
end

note task t-009 branch
note say return the sum of the two largest arguments
fn t078 a ulong b ulong c ulong to ulong
m = a
if lt b m
m = b
end
if lt c m
m = c
end
ret sub add add a b c m
end

note task t-010 branch
note say return the largest argument minus the smallest argument
fn t079 a ulong b ulong c ulong to ulong
lo = a
hi = a
if lt b lo
lo = b
end
if lt c lo
lo = c
end
if gt b hi
hi = b
end
if gt c hi
hi = c
end
ret sub hi lo
end

note task t-011 branch
note say return b unchanged when a is above c; otherwise return a when b is below a, c when b is above c, and b in between
fn t080 a ulong b ulong c ulong to ulong
if gt a c
ret b
end
if lt b a
ret a
end
if gt b c
ret c
end
ret b
end

note task t-012 arith
note say return the product of the three arguments
fn t081 a ulong b ulong c ulong to ulong
ret mul mul a b c
end

note task t-013 branch
note say return the number of different values among the three arguments
fn t082 a ulong b ulong c ulong to ulong
if eq a b
if eq b c
ret 1
end
ret 2
end
if eq a c
ret 2
end
if eq b c
ret 2
end
ret 3
end

note task t-014 branch
note say return 1 when each argument is smaller than the sum of the other two, otherwise 0
fn t083 a ulong b ulong c ulong to ulong
if ge a add b c
ret 0
end
if ge b add a c
ret 0
end
if ge c add a b
ret 0
end
ret 1
end

note task t-015 branch
note say return a plus b when c is even and a times b when c is odd
fn t084 a ulong b ulong c ulong to ulong
if eq rem c 2 0
ret add a b
end
ret mul a b
end

note task t-016 arith
note say return b plus a times the remainder of c divided by 5
fn t085 a ulong b ulong c ulong to ulong
ret add b mul a rem c 5
end

note task t-017 arith
note say return how many of the three arguments are odd
fn t086 a ulong b ulong c ulong to ulong
ret add add rem a 2 rem b 2 rem c 2
end

note task t-018 bits
note say return the bits that are one in at least two of the three arguments
fn t087 a ulong b ulong c ulong to ulong
ret or or and a b and a c and b c
end

note task t-019 bits
note say return the bits that are one in an odd number of the three arguments
fn t088 a ulong b ulong c ulong to ulong
ret xor xor a b c
end

note task t-020 branch
note say return 1 when b lies strictly between a and c, whichever of them is larger, otherwise 0
fn t089 a ulong b ulong c ulong to ulong
if lt a b
if lt b c
ret 1
end
end
if gt a b
if gt b c
ret 1
end
end
ret 0
end

note task t-021 arith
note say return the average of the three arguments rounded down
fn t090 a ulong b ulong c ulong to ulong
ret div add add a b c 3
end

note task t-022 branch
note say return the value that occurs at least twice among the arguments, or zero when all three differ
fn t091 a ulong b ulong c ulong to ulong
if eq a b
ret a
end
if eq a c
ret a
end
if eq b c
ret b
end
ret 0
end

note task t-023 branch
note say return a squared plus b squared minus c, or zero when c is larger than a squared plus b squared
fn t092 a ulong b ulong c ulong to ulong
s = add mul a a mul b b
if gt c s
ret 0
end
ret sub s c
end

note task t-024 loop
note say return the greatest common divisor of the three arguments, ignoring arguments that are zero and returning zero when all are zero
fn t093 a ulong b ulong c ulong to ulong
x = a
y = b
while ne y 0 bound 200
t = rem x y
x = y
y = t
end
y = c
while ne y 0 bound 200
t = rem x y
x = y
y = t
end
ret x
end

note task t-025 branch
note say return c when a equals b, otherwise b when a equals c, otherwise a
fn t094 a ulong b ulong c ulong to ulong
if eq a b
ret c
end
if eq a c
ret b
end
ret a
end

note task t-026 arith
note say return a times 100 plus b times 10 plus c
fn t095 a ulong b ulong c ulong to ulong
ret add add mul a 100 mul b 10 c
end

note task t-027 branch
note say return the product of the two smallest arguments
fn t096 a ulong b ulong c ulong to ulong
hi = a
if gt b hi
hi = b
end
if gt c hi
hi = c
end
if eq hi a
ret mul b c
end
if eq hi b
ret mul a c
end
ret mul a b
end

note task t-028 branch
note say return how many of the three arguments are above 5
fn t097 a ulong b ulong c ulong to ulong
k = ulong 0
if gt a 5
k = add k 1
end
if gt b 5
k = add k 1
end
if gt c 5
k = add k 1
end
ret k
end

note task t-029 arith
note say return the last decimal digit of the sum of the three arguments
fn t098 a ulong b ulong c ulong to ulong
ret rem add add a b c 10
end

note task t-030 branch
note say return a when a is at least as large as both other arguments, otherwise the sum of b and c
fn t099 a ulong b ulong c ulong to ulong
if ge a b
if ge a c
ret a
end
end
ret add b c
end

note task t-031 bits
note say return, bit by bit, the bit of a where c has a one and the bit of b where c has a zero
fn t100 a ulong b ulong c ulong to ulong
ret or and a c and b xor c 18446744073709551615
end

note task t-032 branch
note say return zero when any argument is zero, otherwise the largest argument
fn t101 a ulong b ulong c ulong to ulong
if eq a 0
ret 0
end
if eq b 0
ret 0
end
if eq c 0
ret 0
end
m = a
if gt b m
m = b
end
if gt c m
m = c
end
ret m
end

note ======== the first n items of an array, read only

note task r-001 fold
note say return the product of the first n items, with 1 when n is zero
fn t102 a view ulong 8 n ulong to ulong
p = ulong 1
for i ulong n
p = mul p get a i
end
ret p
end

note task r-002 select
note say return the smallest of the first n items, or zero when n is zero
fn t103 a view ulong 8 n ulong to ulong
if eq n 0
ret 0
end
m = get a 0
for i ulong n
if lt get a i m
m = get a i
end
end
ret m
end

note task r-003 count
note say return how many of the first n items are odd
fn t104 a view ulong 8 n ulong to ulong
c = ulong 0
for i ulong n
c = add c rem get a i 2
end
ret c
end

note task r-004 count
note say return how many of the first n items are greater than 4
fn t105 a view ulong 8 n ulong to ulong
c = ulong 0
for i ulong n
if gt get a i 4
c = add c 1
end
end
ret c
end

note task r-005 scan
note say return the index of the first zero among the first n items, or n when none of them is zero
fn t106 a view ulong 8 n ulong to ulong
for i ulong n
if eq get a i 0
ret i
end
end
ret n
end

note task r-006 scan
note say return the index of the largest of the first n items, the lowest such index when it occurs more than once, or zero when n is zero
fn t107 a view ulong 8 n ulong to ulong
k = ulong 0
for i ulong n
if gt get a i get a k
k = i
end
end
ret k
end

note task r-007 fold
note say return the sum of the squares of the first n items
fn t108 a view ulong 8 n ulong to ulong
s = ulong 0
for i ulong n
x = get a i
s = add s mul x x
end
ret s
end

note task r-008 fold
note say return the sum of the items at even indexes among the first n items
fn t109 a view ulong 8 n ulong to ulong
s = ulong 0
for i ulong n
if eq rem i 2 0
s = add s get a i
end
end
ret s
end

note task r-009 fold
note say return the largest minus the smallest of the first n items, or zero when n is zero
fn t110 a view ulong 8 n ulong to ulong
if eq n 0
ret 0
end
lo = get a 0
hi = get a 0
for i ulong n
x = get a i
if lt x lo
lo = x
end
if gt x hi
hi = x
end
end
ret sub hi lo
end

note task r-010 count
note say return how many of the first n items are greater than the item just before them
fn t111 a view ulong 8 n ulong to ulong
c = ulong 0
for i ulong n
if gt i 0
if gt get a i get a sub i 1
c = add c 1
end
end
end
ret c
end

note task r-011 scan
note say return 1 when none of the first n items is smaller than the item just before it, otherwise 0
fn t112 a view ulong 8 n ulong to ulong
for i ulong n
if gt i 0
if lt get a i get a sub i 1
ret 0
end
end
end
ret 1
end

note task r-012 count
note say return how many of the first n items equal the first item, counting the first item itself
fn t113 a view ulong 8 n ulong to ulong
c = ulong 0
for i ulong n
if eq get a i get a 0
c = add c 1
end
end
ret c
end

note task r-013 fold
note say return the bits that are one in every one of the first n items, or zero when n is zero
fn t114 a view ulong 8 n ulong to ulong
if eq n 0
ret 0
end
x = get a 0
for i ulong n
x = and x get a i
end
ret x
end

note task r-014 select
note say return the item at index n minus one, or zero when n is zero
fn t115 a view ulong 8 n ulong to ulong
if eq n 0
ret 0
end
ret get a sub n 1
end

note task r-015 count
note say return the number of different values among the first n items
fn t116 a view ulong 8 n ulong to ulong
c = ulong 0
for i ulong n
old = false
for j ulong i
if eq get a j get a i
old = true
end
end
if not old
c = add c 1
end
end
ret c
end

note task r-016 fold
note say return the sum of the first n items after multiplying each by its index
fn t117 a view ulong 8 n ulong to ulong
s = ulong 0
for i ulong n
s = add s mul i get a i
end
ret s
end

note task r-017 scan
note say return the length of the longest run of equal neighbouring items among the first n items, or zero when n is zero
fn t118 a view ulong 8 n ulong to ulong
if eq n 0
ret 0
end
best = ulong 1
cur = ulong 1
for i ulong n
if gt i 0
if eq get a i get a sub i 1
cur = add cur 1
else
cur = 1
end
if gt cur best
best = cur
end
end
end
ret best
end

note task r-018 select
note say return the second largest of the first n items, which equals the largest when the largest occurs twice, or zero when n is below 2
fn t119 a view ulong 8 n ulong to ulong
if lt n 2
ret 0
end
m1 = get a 0
m2 = get a 1
if lt m1 m2
m1 = get a 1
m2 = get a 0
end
for i ulong n
if ge i 2
x = get a i
if gt x m1
m2 = m1
m1 = x
else
if gt x m2
m2 = x
end
end
end
end
ret m2
end

note task r-019 fold
note say return the first item minus the second plus the third and so on over the first n items, with wrapping arithmetic
fn t120 a view ulong 8 n ulong to ulong
s = ulong 0
for i ulong n
if eq rem i 2 0
s = add s get a i
else
s = sub s get a i
end
end
ret s
end

note task r-020 count
note say return how many of the first n items are smaller than the first item
fn t121 a view ulong 8 n ulong to ulong
c = ulong 0
for i ulong n
if lt get a i get a 0
c = add c 1
end
end
ret c
end

note task r-021 scan
note say return the index of the last odd item among the first n items, or n when none of them is odd
fn t122 a view ulong 8 n ulong to ulong
k = n
for i ulong n
if eq rem get a i 2 1
k = i
end
end
ret k
end

note task r-022 fold
note say return the sum of those of the first n items that are even
fn t123 a view ulong 8 n ulong to ulong
s = ulong 0
for i ulong n
x = get a i
if eq rem x 2 0
s = add s x
end
end
ret s
end

note task r-023 fold
note say return the largest sum of two neighbouring items among the first n items, or zero when n is below 2
fn t124 a view ulong 8 n ulong to ulong
m = ulong 0
for i ulong n
if gt i 0
s = add get a i get a sub i 1
if gt s m
m = s
end
end
end
ret m
end

note task r-024 scan
note say return 1 when some value occurs more than once among the first n items, otherwise 0
fn t125 a view ulong 8 n ulong to ulong
for i ulong n
for j ulong i
if eq get a j get a i
ret 1
end
end
end
ret 0
end

note task r-025 fold
note say return the remainder of the sum of the first n items divided by 7
fn t126 a view ulong 8 n ulong to ulong
s = ulong 0
for i ulong n
s = add s get a i
end
ret rem s 7
end

note task r-026 count
note say return how many of the first n items are equal to their own index
fn t127 a view ulong 8 n ulong to ulong
c = ulong 0
for i ulong n
if eq get a i i
c = add c 1
end
end
ret c
end

note task r-027 select
note say return the smallest item that is not zero among the first n items, or zero when all of them are zero
fn t128 a view ulong 8 n ulong to ulong
m = ulong 0
for i ulong n
x = get a i
if ne x 0
if eq m 0
m = x
end
if lt x m
m = x
end
end
end
ret m
end

note task r-028 fold
note say return the greatest common divisor of the first n items, ignoring zeros, or zero when there is nothing but zeros
fn t129 a view ulong 8 n ulong to ulong
g = ulong 0
for i ulong n
y = get a i
while ne y 0 bound 200
t = rem g y
g = y
y = t
end
end
ret g
end

note task r-029 count
note say return how many of the first n items are multiples of 3, zero included
fn t130 a view ulong 8 n ulong to ulong
c = ulong 0
for i ulong n
if eq rem get a i 3 0
c = add c 1
end
end
ret c
end

note task r-030 fold
note say return the sum of the items at even indexes minus the sum of the items at odd indexes among the first n items, or zero when the odd sum is larger
fn t131 a view ulong 8 n ulong to ulong
e = ulong 0
o = ulong 0
for i ulong n
if eq rem i 2 0
e = add e get a i
else
o = add o get a i
end
end
if gt o e
ret 0
end
ret sub e o
end

note task r-031 scan
note say return the first of the first n items that is greater than 5, or zero when none is
fn t132 a view ulong 8 n ulong to ulong
for i ulong n
if gt get a i 5
ret get a i
end
end
ret 0
end

note task r-032 fold
note say return the largest of the first n items multiplied by n
fn t133 a view ulong 8 n ulong to ulong
m = ulong 0
for i ulong n
if gt get a i m
m = get a i
end
end
ret mul m n
end

note ======== the first n items of an array, changed in place

note task w-001 rewrite
note say reverse the order of the first n items
fn t134 a edit ulong 8 n ulong to void
i = ulong 0
j = n
while lt add i 1 j bound 8
j = sub j 1
x = get a i
put a i get a j
put a j x
i = add i 1
end
end

note task w-002 rewrite
note say replace each of the first n items with its square
fn t135 a edit ulong 8 n ulong to void
for i ulong n
x = get a i
put a i mul x x
end
end

note task w-003 rewrite
note say replace each of the first n items with its index
fn t136 a edit ulong 8 n ulong to void
for i ulong n
put a i i
end
end

note task w-004 rewrite
note say replace each of the first n items with the sum of all items up to and including it
fn t137 a edit ulong 8 n ulong to void
s = ulong 0
for i ulong n
s = add s get a i
put a i s
end
end

note task w-005 rewrite
note say exchange the first item with the second, the third with the fourth and so on within the first n items, leaving an unpaired last item alone
fn t138 a edit ulong 8 n ulong to void
i = ulong 0
while lt add i 1 n bound 8
x = get a i
put a i get a add i 1
put a add i 1 x
i = add i 2
end
end

note task w-006 rewrite
note say replace every zero among the first n items with 9
fn t139 a edit ulong 8 n ulong to void
for i ulong n
if eq get a i 0
put a i 9
end
end
end

note task w-007 rewrite
note say sort the first n items into ascending order
fn t140 a edit ulong 8 n ulong to void
for i ulong n
for j ulong n
if gt j 0
x = get a sub j 1
y = get a j
if gt x y
put a sub j 1 y
put a j x
end
end
end
end
end

note task w-008 rewrite
note say move each of the first n items one place towards the front and put the first item at index n minus one
fn t141 a edit ulong 8 n ulong to void
if lt n 2
ret
end
f = get a 0
for i ulong n
if gt i 0
put a sub i 1 get a i
end
end
put a sub n 1 f
end

note task w-009 rewrite
note say move each of the first n items one place towards the back and put the item from index n minus one at the front
fn t142 a edit ulong 8 n ulong to void
if lt n 2
ret
end
l = get a sub n 1
i = sub n 1
while gt i 0 bound 8
put a i get a sub i 1
i = sub i 1
end
put a 0 l
end

note task w-010 rewrite
note say replace each of the first n items with the largest item from the start up to and including it
fn t143 a edit ulong 8 n ulong to void
m = ulong 0
for i ulong n
if gt get a i m
m = get a i
end
put a i m
end
end

note task w-011 rewrite
note say replace every odd item among the first n items with zero
fn t144 a edit ulong 8 n ulong to void
for i ulong n
if eq rem get a i 2 1
put a i 0
end
end
end

note task w-012 rewrite
note say replace each of the first n items except the first with itself minus the original value of the item before it, with wrapping arithmetic
fn t145 a edit ulong 8 n ulong to void
p = ulong 0
for i ulong n
x = get a i
if gt i 0
put a i sub x p
end
p = x
end
end

note task w-013 rewrite
note say set each of the first n items to the value of the first item
fn t146 a edit ulong 8 n ulong to void
for i ulong n
put a i get a 0
end
end

note task w-014 rewrite
note say replace each of the first n items with n minus its index
fn t147 a edit ulong 8 n ulong to void
for i ulong n
put a i sub n i
end
end

note task w-015 rewrite
note say halve every even item among the first n items and leave the odd items alone
fn t148 a edit ulong 8 n ulong to void
for i ulong n
x = get a i
if eq rem x 2 0
put a i div x 2
end
end
end

note task w-016 rewrite
note say replace every item above 5 among the first n items with 5
fn t149 a edit ulong 8 n ulong to void
for i ulong n
if gt get a i 5
put a i 5
end
end
end

note task w-017 rewrite
note say sort the first n items into descending order
fn t150 a edit ulong 8 n ulong to void
for i ulong n
for j ulong n
if gt j 0
x = get a sub j 1
y = get a j
if lt x y
put a sub j 1 y
put a j x
end
end
end
end
end

note task w-018 rewrite
note say move every zero among the first n items to the end of those n items, keeping the other items in their order
fn t151 a edit ulong 8 n ulong to void
k = ulong 0
for i ulong n
x = get a i
if ne x 0
put a k x
k = add k 1
end
end
while lt k n bound 8
put a k 0
k = add k 1
end
end

note task w-019 rewrite
note say replace each of the first n items with the number of items before it whose original value is smaller than its own
fn t152 a edit ulong 8 n ulong to void
i = n
while gt i 0 bound 8
i = sub i 1
c = ulong 0
for j ulong i
if lt get a j get a i
c = add c 1
end
end
put a i c
end
end

note task w-020 rewrite
note say copy the first item into every even index among the first n items
fn t153 a edit ulong 8 n ulong to void
for i ulong n
if eq rem i 2 0
put a i get a 0
end
end
end

note task w-021 rewrite
note say add its own index to each of the first n items
fn t154 a edit ulong 8 n ulong to void
for i ulong n
put a i add get a i i
end
end

note task w-022 rewrite
note say replace every item that is not zero among the first n items with 1
fn t155 a edit ulong 8 n ulong to void
for i ulong n
if ne get a i 0
put a i 1
end
end
end

note task w-023 rewrite
note say exchange the first item with the item at index n minus one and leave everything else alone
fn t156 a edit ulong 8 n ulong to void
if lt n 2
ret
end
x = get a 0
put a 0 get a sub n 1
put a sub n 1 x
end

note task w-024 rewrite
note say add to each of the first n items except the last of them the original value of the item after it
fn t157 a edit ulong 8 n ulong to void
for i ulong n
if lt add i 1 n
put a i add get a i get a add i 1
end
end
end

note task w-025 rewrite
note say multiply each of the first n items by the original value of the first item
fn t158 a edit ulong 8 n ulong to void
if eq n 0
ret
end
f = get a 0
for i ulong n
put a i mul get a i f
end
end

note task w-026 rewrite
note say replace each of the first n items with its remainder when divided by 4
fn t159 a edit ulong 8 n ulong to void
for i ulong n
put a i rem get a i 4
end
end

note task w-027 rewrite
note say replace each of the first n items with the smallest item from the start up to and including it
fn t160 a edit ulong 8 n ulong to void
if eq n 0
ret
end
m = get a 0
for i ulong n
if lt get a i m
m = get a i
end
put a i m
end
end

note task w-028 rewrite
note say set the first n items to 1, 2, 4, 8 and so on, each twice the one before
fn t161 a edit ulong 8 n ulong to void
p = ulong 1
for i ulong n
put a i p
p = mul p 2
end
end

note task w-029 rewrite
note say replace every item among the first n that is larger than the first item with the value of the first item
fn t162 a edit ulong 8 n ulong to void
if eq n 0
ret
end
f = get a 0
for i ulong n
if gt get a i f
put a i f
end
end
end

note task w-030 rewrite
note say replace each of the first n items with the number of items among the original first n that have the same value as it
fn t163 a edit ulong 8 n ulong to void
t = new ulong 8 0
for i ulong n
c = ulong 0
for j ulong n
if eq get a j get a i
c = add c 1
end
end
put t i c
end
for k ulong n
put a k get t k
end
end

note task w-031 rewrite
note say exchange the smallest and the largest of the first n items, taking the lowest index when a value occurs more than once
fn t164 a edit ulong 8 n ulong to void
if eq n 0
ret
end
lo = ulong 0
hi = ulong 0
for i ulong n
if lt get a i get a lo
lo = i
end
if gt get a i get a hi
hi = i
end
end
x = get a lo
put a lo get a hi
put a hi x
end

note task w-032 rewrite
note say add to each of the first n items the original value of the item mirrored across the middle of those n items, so the first gets the last, the second the one before the last, and a middle item is doubled
fn t165 a edit ulong 8 n ulong to void
i = ulong 0
j = n
while lt i j bound 8
j = sub j 1
s = add get a i get a j
put a i s
put a j s
i = add i 1
end
end

note SPDX-License-Identifier: Apache-2.0
note train/blas/om/blas_test.om: pure-Omega functional verification and negative controls for omega-blas (blas.om).
note Compose after train/blas/om/blas.om (which begins with om2).

text bt_pass "PASS omega-blas host verification (formats, gelu, pack/unpack, gemm, gemv, copy32, info)\n"
text bt_fail "FAIL omega-blas host verification\n"

fn bt_f32_near a uint b uint tol f32 to bool
fa = bitcast f32 a
fb = bitcast f32 b
d = fabs sub fa fb
ret le d tol
end

fn bt_test_formats to bool
note f16: 1.0 = 0x3c00, -2.0 = 0xc000, 0.5 = 0x3800, 0.0 = 0x0000
s16 = new ushort 4 0
put s16 0 ushort 0x3c00
put s16 1 ushort 0xc000
put s16 2 ushort 0x3800
put s16 3 ushort 0x0000
d32 = new uint 4 0
widen16 ulong 0 s16 d32
if ne get d32 0 bitcast uint 1.0f32
ret false
end
if ne get d32 1 bitcast uint -2.0f32
ret false
end
if ne get d32 2 bitcast uint 0.5f32
ret false
end
if ne get d32 3 bitcast uint 0.0f32
ret false
end
note round-trip narrow16 f16
r16 = new ushort 4 0
narrow16 ulong 0 d32 r16
for i ulong 4
if ne get r16 i get s16 i
ret false
end
end
note bf16: 1.0 = 0x3f80, -3.5 = 0xc060
put s16 0 ushort 0x3f80
put s16 1 ushort 0xc060
put s16 2 ushort 0x0000
put s16 3 ushort 0x3f00
widen16 ulong 1 s16 d32
if ne get d32 0 bitcast uint 1.0f32
ret false
end
if ne get d32 1 bitcast uint -3.5f32
ret false
end
if ne get d32 2 bitcast uint 0.0f32
ret false
end
if ne get d32 3 bitcast uint 0.5f32
ret false
end
narrow16 ulong 1 d32 r16
for i ulong 4
if ne get r16 i get s16 i
ret false
end
end
note fp8 e4m3: 1.0 = 0x38 (exp=7, bias=7, man=0), -2.0 = 0xc0 (sign=1, exp=8, man=0)
s8 = new uchar 2 0
put s8 0 uchar 0x38
put s8 1 uchar 0xc0
d8 = new uint 2 0
widen8 ulong 0 s8 d8
if ne get d8 0 bitcast uint 1.0f32
ret false
end
if ne get d8 1 bitcast uint -2.0f32
ret false
end
note fp8 e5m2: 1.0 = 0x3c (exp=15, bias=15, man=0), -2.0 = 0xc0 (sign=1, exp=16, man=0)
put s8 0 uchar 0x3c
put s8 1 uchar 0xc0
widen8 ulong 1 s8 d8
if ne get d8 0 bitcast uint 1.0f32
ret false
end
if ne get d8 1 bitcast uint -2.0f32
ret false
end
ret true
end

fn bt_test_gelu to bool
in_v = new uint 3 0
out_v = new uint 3 0
put in_v 0 bitcast uint 0.0f32
put in_v 1 bitcast uint 1.0f32
put in_v 2 bitcast uint -1.0f32
gelu32 in_v out_v
note gelu(0) = 0, gelu(1) ~= 0.841192, gelu(-1) ~= -0.158808
if not bt_f32_near get out_v 0 bitcast uint 0.0f32 0.0001f32
ret false
end
if not bt_f32_near get out_v 1 bitcast uint 0.841192f32 0.001f32
ret false
end
if not bt_f32_near get out_v 2 bitcast uint -0.158808f32 0.001f32
ret false
end
ret true
end

fn bt_test_gemm to bool
note 2x2 column-major A = [[1, 3], [2, 4]] -> [1, 2, 3, 4]
note 2x2 column-major B = [[5, 7], [6, 8]] -> [5, 6, 7, 8]
note A*B = [[1*5+3*6, 1*7+3*8], [2*5+4*6, 2*7+4*8]] = [[23, 31], [34, 46]] -> col-major [23, 34, 31, 46]
a = new uint 4 0
put a 0 bitcast uint 1.0f32
put a 1 bitcast uint 2.0f32
put a 2 bitcast uint 3.0f32
put a 3 bitcast uint 4.0f32
b = new uint 4 0
put b 0 bitcast uint 5.0f32
put b 1 bitcast uint 6.0f32
put b 2 bitcast uint 7.0f32
put b 3 bitcast uint 8.0f32
w = new uint 16 0
pka = new uchar 64 0
put pka 0 uchar 2
put pka 8 uchar 2
put pka 16 uchar 1
put pka 32 uchar 2
put pka 40 uchar 2
pack32 pka a w
note pack B^T (rows=n=2, cols=k=2, si=ld=2, sq=1, dst=4, w=2*2-2=2)
pkb = new uchar 64 0
put pkb 0 uchar 2
put pkb 8 uchar 2
put pkb 16 uchar 2
put pkb 32 uchar 1
put pkb 40 uchar 2
put pkb 48 uchar 4
pack32 pkb b w
note gemm_k: m=2, n=2, k=2, ldc=2, offc=0, alpha=1.0, beta=0.0, act=0, wsa=0, wsb=4, mp=1, np=1
c = new uint 4 0
gp_buf = new uchar 128 0
put gp_buf 0 uchar 2
put gp_buf 8 uchar 2
put gp_buf 16 uchar 2
put gp_buf 24 uchar 2
note alpha = 1.0f32 = 0x3f800000 little endian at offset 40
put gp_buf 40 uchar 0x00
put gp_buf 41 uchar 0x00
put gp_buf 42 uchar 0x80
put gp_buf 43 uchar 0x3f
note wsb = 4 at offset 64, mp = 1 at 80, np = 1 at 88
put gp_buf 64 uchar 4
put gp_buf 80 uchar 1
put gp_buf 88 uchar 1
gemm_k gp_buf w c
if not bt_f32_near get c 0 bitcast uint 23.0f32 0.001f32
ret false
end
if not bt_f32_near get c 1 bitcast uint 34.0f32 0.001f32
ret false
end
if not bt_f32_near get c 2 bitcast uint 31.0f32 0.001f32
ret false
end
if not bt_f32_near get c 3 bitcast uint 46.0f32 0.001f32
ret false
end
note Re-run with beta = 2.0f32 (0x40000000) and alpha = 1.0f32 -> 3 * C = [69, 102, 93, 138]
put gp_buf 44 uchar 0x00
put gp_buf 45 uchar 0x00
put gp_buf 46 uchar 0x00
put gp_buf 47 uchar 0x40
gemm_k gp_buf w c
if not bt_f32_near get c 0 bitcast uint 69.0f32 0.001f32
ret false
end
if not bt_f32_near get c 3 bitcast uint 138.0f32 0.001f32
ret false
end
ret true
end

fn bt_test_gemv_copy to bool
note 2x2 col-major A = [[1, 3], [2, 4]], x = [10, 20], y = [1, 2], alpha=1, beta=1
note y_new = [1 + 1*10 + 3*20, 2 + 2*10 + 4*20] = [71, 102]
a = new uint 4 0
put a 0 bitcast uint 1.0f32
put a 1 bitcast uint 2.0f32
put a 2 bitcast uint 3.0f32
put a 3 bitcast uint 4.0f32
w = new uint 8 0
put w 0 bitcast uint 10.0f32
put w 1 bitcast uint 20.0f32
put w 2 bitcast uint 1.0f32
put w 3 bitcast uint 2.0f32
gv_buf = new uchar 80 0
put gv_buf 0 uchar 2
put gv_buf 8 uchar 2
put gv_buf 16 uchar 2
note alpha = 1.0f32 at 40, beta = 1.0f32 at 44, wx=0 at 48, wy=2 at 56
put gv_buf 42 uchar 0x80
put gv_buf 43 uchar 0x3f
put gv_buf 46 uchar 0x80
put gv_buf 47 uchar 0x3f
put gv_buf 56 uchar 2
gemv_k gv_buf a w
if not bt_f32_near get w 2 bitcast uint 71.0f32 0.001f32
ret false
end
if not bt_f32_near get w 3 bitcast uint 102.0f32 0.001f32
ret false
end
note copy32 reverse stride: d[0..2] = a[2, 0]
d = new uint 2 0
cp_buf = new uchar 48 0
put cp_buf 0 uchar 2
put cp_buf 8 uchar 2
note is = -2 (0xfffffffffffffffe) at offset 16
put cp_buf 16 uchar 0xfe
for k ulong 7
put cp_buf add k ulong 17 uchar 0xff
end
note od = 0 at 24, id = 1 at 32
put cp_buf 32 uchar 1
copy32 cp_buf a d
if ne get d 0 get a 2
ret false
end
if ne get d 1 get a 0
ret false
end
ret true
end

fn bt_test_info to bool
note Valid gemm_info: ta='N'(78), tb='T'(84), m=4, n=4, k=4, lda=4, ldb=4, ldc=4 -> 0
ck_buf = new uchar 80 0
put ck_buf 0 uchar 78
put ck_buf 8 uchar 84
put ck_buf 16 uchar 4
put ck_buf 24 uchar 4
put ck_buf 32 uchar 4
put ck_buf 40 uchar 4
put ck_buf 48 uchar 4
put ck_buf 56 uchar 4
put ck_buf 64 uchar 1
put ck_buf 72 uchar 1
if ne gemm_info ck_buf ulong 0
ret false
end
note Negative control: bad ta='X'(88) -> info 1
put ck_buf 0 uchar 88
if ne gemm_info ck_buf ulong 1
ret false
end
note Restore ta='N', bad lda=2 < m=4 -> info 8
put ck_buf 0 uchar 78
put ck_buf 40 uchar 2
if ne gemm_info ck_buf ulong 8
ret false
end
note gemv_info: restore lda=4 -> 0; incx=0 -> info 8
put ck_buf 40 uchar 4
if ne gemv_info ck_buf ulong 0
ret false
end
put ck_buf 64 uchar 0
if ne gemv_info ck_buf ulong 8
ret false
end
ret true
end

fn main to int
ok = true
if not bt_test_formats
ok = false
end
if not bt_test_gelu
ok = false
end
if not bt_test_gemm
ok = false
end
if not bt_test_gemv_copy
ok = false
end
if not bt_test_info
ok = false
end
if not ok
k = write int 1 bt_fail ulong 0 len bt_fail
if lt k long 0
ret int 1
end
ret int 1
end
k = write int 1 bt_pass ulong 0 len bt_pass
if lt k long 0
ret int 1
end
ret int 0
end
